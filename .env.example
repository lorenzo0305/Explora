# =============================================================
# Modèle de configuration Explora — copier en .env et remplir.
# Le fichier .env ne doit jamais être commité dans Git.
# =============================================================

# --- MongoDB Atlas ---
# Identifiants du cluster Atlas (onglet Database Access > Add New Database User)
MONGO_USER=<votre_utilisateur_atlas>
MONGO_PASSWORD=<votre_mot_de_passe_atlas>

# Hôte du cluster (visible dans Atlas > Connect > Drivers)
MONGO_HOST=<cluster>.mongodb.net
MONGO_APP_NAME=datas

# Base et collection par défaut
MONGO_DB=explora
MONGO_COLLECTION=Auvergne
