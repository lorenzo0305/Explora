  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: der sehr herzliche und lächelnde Empfang, ein junges und dynamisches Team. Eine innovative und kreative Bäckerei"
    ],
    "en": [
      "You'll love the warm, smiling welcome and the young, dynamic team. An innovative and creative bakery"
    ],
    "it": [
      "Vi piacerà l'accoglienza calorosa e sorridente e il team giovane e dinamico. Una pasticceria innovativa e creativa"
    ],
    "fr": [
      "Vous aimerez : l'accueil très chaleureux et souriant, une équipe jeune et dynamique. Une boulangerie innovante et créative"
    ],
    "es": [
      "Le encantará la cálida y sonriente bienvenida y el equipo joven y dinámico. Una panadería innovadora y creativa"
    ],
    "nl": [
      "Je zult dol zijn op het warme, glimlachende onthaal en het jonge, dynamische team. Een innovatieve en creatieve bakkerij"
    ]
  },
