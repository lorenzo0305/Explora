  "rdfs:comment": {
    "de": [
      "Feuerwehrball, organisiert von der Amicale des pompiers de Fort-Mahon-Plage ab 17 Uhr.\n\nGetränke und Speisen sind vor Ort auf der Ebene der Esplanade möglich!\n\nFür alle geöffnet!"
    ],
    "en": [
      "Firemen's ball organized by the Amicale des pompiers de Fort-Mahon-Plage from 5pm.\n\nRefreshments and food available on the esplanade!\n\nOpen to all!"
    ],
    "it": [
      "Ballo dei pompieri organizzato dall'Amicale des pompiers de Fort-Mahon-Plage dalle 17.00.\n\nRinfreschi e cibo disponibili sulla spianata!\n\nAperto a tutti!"
    ],
    "fr": [
      "Bal des sapeurs pompiers organisé par l'Amicale des pompiers de Fort-Mahon-Plage à partir de 17h.\n\nBuvette et restauration possible sur place, au niveau de l'esplanade !\n\nOuvert à tous !"
    ],
    "nl": [
      "Brandweerbal georganiseerd door de Amicale des pompiers de Fort-Mahon-Plage vanaf 17.00 uur.\n\nVersnaperingen en eten verkrijgbaar op de esplanade!\n\nVoor iedereen toegankelijk!"
    ],
    "es": [
      "Baile de bomberos organizado por la Amicale des pompiers de Fort-Mahon-Plage a partir de las 17.00 horas.\n\nRefrescos y comida en la explanada\n\nAbierto a todos"
    ]
  },
