  "rdfs:comment": {
    "de": [
      "Der Belvédère de la falaise Sainte Colette bietet einen atemberaubenden Blick auf das Somme-Tal oberhalb der Teiche von Barrette in Corbie. Der Aussichtspunkt ist einen Stopp wert."
    ],
    "en": [
      "The Belvedere of the Sainte Colette cliff offers a breathtaking view of the Somme Valley above the Barrette à Corbie ponds. The viewpoint is worth a stop."
    ],
    "it": [
      "Il Belvedere della falesia di Sainte Colette offre una vista mozzafiato sulla Valle della Somme sopra gli stagni di Barrette a Corbie. Il punto panoramico merita una sosta."
    ],
    "fr": [
      "Le Belvédère de la falaise Sainte Colette offre un point de vue imprenable sur la Vallée de Somme au dessus des étangs de la Barrette à Corbie. Le point de vue mérite un arrêt."
    ],
    "es": [
      "El mirador del acantilado de Sainte Colette ofrece una vista impresionante del valle del Somme por encima de los estanques de la Barrette en Corbie. El mirador merece una parada."
    ],
    "nl": [
      "De Belvedère van de rots Sainte Colette biedt een adembenemend uitzicht op de vallei van de Somme boven de vijvers van Barrette in Corbie. Het uitzichtpunt is een stop waard."
    ]
  },
