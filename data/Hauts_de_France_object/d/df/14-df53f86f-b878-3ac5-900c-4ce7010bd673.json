  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1ed6eda3-3354-3c04-97c4-12eed898c275",
      "dc:description": {
        "de": [
          "Koh Lanta von 10:30 bis 12:00 Uhr,\nfür Kinder von 6 bis 12 Jahren.\n Anmeldung im Tourismusbüro erforderlich.\n 3 Euro pro Kind.\n Treffpunkt auf der Esplanade mit Trinkflasche."
        ],
        "en": [
          "Koh Lanta from 10:30am to 12pm,\nfor children aged 6 to 12.\n Registration essential at the Tourist Office.\n 3 euros per child.\n Meet at the esplanade with your water bottle."
        ],
        "it": [
          "Koh Lanta dalle 10.30 alle 12.00,\nper bambini dai 6 ai 12 anni.\n Registrazione obbligatoria presso l'Ufficio del Turismo.\n 3 euro a bambino.\n Appuntamento alla spianata con la borraccia."
        ],
        "fr": [
          "Koh Lanta de 10h30 à 12h, \npour les enfants de 6 à 12 ans.\n Inscription indispensable à l'Office de Tourisme.\n 3 euros par enfants.\n Rendez-vous à l'esplanade avec votre gourde."
        ],
        "nl": [
          "Koh Lanta van 10.30 tot 12.00 uur,\nvoor kinderen van 6 tot 12 jaar.\n Aanmelding noodzakelijk bij het toeristenbureau.\n 3 euro per kind.\n Verzamelen bij de esplanade met je waterfles."
        ],
        "es": [
          "Koh Lanta de 10.30 a 12 h,\npara niños de 6 a 12 años.\n Imprescindible inscribirse en la Oficina de Turismo.\n 3 euros por niño.\n Reúnase en la explanada con su botella de agua."
        ]
      },
