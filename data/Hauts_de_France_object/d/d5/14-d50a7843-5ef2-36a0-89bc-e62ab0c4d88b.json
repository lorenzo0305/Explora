  "rdfs:comment": {
    "de": [
      "Die Aufführung findet im Rahmen des Festivals Qu'est-ce-qu'on fabrique en famille? #12.\nErzählung mit Palmen - Lieber Ente als Schaf! Inspiriert von Andersens berühmtem Märchen \"Die hässliche kleine Ente\""
    ],
    "en": [
      "Programmed as part of the Festival Qu'est-ce-qu'on fabrique en famille? #12.\nRécit palmé - Rather duck than sheep! Inspired by Andersen's famous fairy tale, \"The Ugly Duckling\""
    ],
    "it": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #12.\nRécit palmé - Plutôt canard que mouton ! Ispirato alla famosa fiaba di Andersen \"Le Vilain Petit Canard\" (Il brutto anatroccolo)"
    ],
    "fr": [
      "Spectacle programmé dans le cadre du Festival Qu'est-ce-qu'on fabrique en famille ? #12.\nRécit palmé - Plutôt canard que mouton ! Inspirée du célèbre conte d’Andersen, « Le Vilain Petit Canard »"
    ],
    "es": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #12.\n¡Récit palmé - Plutôt canard que mouton ! Inspirado en el famoso cuento de Andersen, \"Le Vilain Petit Canard\" (El patito feo)"
    ],
    "nl": [
      "Onderdeel van het Festival Qu'est-ce-qu'on fabrique en famille? #12.\nPalmistisch verhaal - Liever canard dan mouton! Geïnspireerd op het beroemde verhaal van Andersen, \"Le Vilain Petit Canard\" (Het lelijke eendje)"
    ]
