  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9a44cfb7-1512-36dd-bbe2-aed5bce6f6cd",
      "dc:description": {
        "de": [
          "Elisabeth und Gérard GFELLER begrüßen Sie in ihrem Lokal in Houlle, das für seinen Genever berühmt ist, und bieten Ihnen eine vom Chef zubereitete Küche mit Produkten aus der Region."
        ],
        "en": [
          "Elisabeth and Gérard GFELLER welcome you to their establishment in Houlle, famous for its jenever, and offer you a cuisine prepared by the owner using local products."
        ],
        "it": [
          "Elisabeth e Gérard GFELLER vi accolgono nel loro locale di Houlle, famoso per il genever, e vi offrono una cucina preparata dal proprietario con prodotti locali."
        ],
        "fr": [
          "Elisabeth et Gérard GFELLER vous accueillent dans leur établissement à Houlle, célèbre pour son genièvre, et vous proposent une cuisine élaborée par le patron à base de produits de la région."
        ],
        "es": [
          "Elisabeth y Gérard GFELLER le dan la bienvenida a su establecimiento de Houlle, famoso por su ginebra, y le ofrecen una cocina preparada por el propietario con productos locales."
        ],
        "nl": [
          "Elisabeth en Gérard GFELLER heten u welkom in hun etablissement in Houlle, beroemd om zijn jenever, en bieden u een keuken die door de eigenaar wordt bereid met lokale producten."
        ]
      },
