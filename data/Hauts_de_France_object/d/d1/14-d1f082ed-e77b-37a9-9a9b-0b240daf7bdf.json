  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6b2191f-74e5-36c5-8aa0-409d97b35628",
      "dc:description": {
        "de": [
          "Philosophische Abende\nDienstag, 30. Juni 2025 von 18.30 bis 20.00 Uhr\nLycée Sainte-Austreberthe - Montreuil\n-----------------------------\nThema: Ist das Leben ein Spiel?\nSie finden alle zwei Wochen statt, in der Regel außerhalb der Schulferien.\nDer Zeitplan ist vorläufig und kann Änderungen unterliegen.\n\nEingang über das Rathaus - Place Gambetta\nInformationen per E-Mail: montreuil@philia-asso.fr\nCredit: Philia Asso"
        ],
        "en": [
          "Philosophy evenings\nTuesday, June 30, 2025 from 6:30 to 8 p.m\nLycée Sainte-Austreberthe - Montreuil\n-----------------------------\nTheme: Is Life a Game?\nThey take place every two weeks, generally outside school vacations.\nThe schedule is provisional and may be subject to change.\n\nEntrance via the Town Hall - Place Gambetta\nInformation by e-mail: montreuil@philia-asso.fr\nCredit: Philia Asso"
        ],
        "it": [
          "Serate di filosofia\nMartedì 30 giugno 2025 dalle 18.30 alle 20.00\nLiceo Sainte-Austreberthe - Montreuil\n-----------------------------\nTema: La vita è un gioco?\nSi svolgono ogni quindici giorni, generalmente al di fuori delle vacanze scolastiche.\nIl programma è provvisorio e può essere soggetto a modifiche.\n\nIngresso dal Municipio - Place Gambetta\nInformazioni via e-mail: montreuil@philia-asso.fr\nCredito: Philia Asso"
        ],
        "fr": [
          "Soirées Philosophie\nMardi 30 juin 2025 de 18h30 à 20h\nLycée Sainte-Austreberthe - Montreuil\n-----------------------------\nThème :  La Vie est-elle un Jeu ?\nElles ont lieu toutes les deux semaines, généralement, en dehors des vacances scolaires.\nLe calendrier est prévisionnel, il peut être sujet à modification.\n\nEntrée par la Mairie - Place Gambetta\nRenseignements par mail : montreuil@philia-asso.fr\nCrédit : Philia Asso"
        ],
        "es": [
          "Veladas filosóficas\nMartes 30 de junio de 2025 de 18h30 a 20h00\nLiceo Sainte-Austreberthe - Montreuil\n-----------------------------\nTema: ¿Es la vida un juego?\nTienen lugar cada quince días, generalmente fuera de las vacaciones escolares.\nEl calendario es provisional y puede sufrir modificaciones.\n\nEntrada por el Ayuntamiento - Place Gambetta\nInformación por correo electrónico: montreuil@philia-asso.fr\nCrédito: Philia Asso"
        ],
        "nl": [
          "Filosofie avonden\nDinsdag 30 juni 2025 van 18.30 tot 20.00 uur\nLycée Sainte-Austreberthe - Montreuil\n-----------------------------\nThema: Is het leven een spel?\nDeze vinden om de twee weken plaats, meestal buiten de schoolvakanties.\nHet schema is voorlopig en kan worden gewijzigd.\n\nIngang via het stadhuis - Place Gambetta\nInformatie via e-mail: montreuil@philia-asso.fr\nKrediet: Philia Asso"
        ]
      },
