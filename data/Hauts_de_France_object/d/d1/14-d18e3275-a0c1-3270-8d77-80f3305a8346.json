  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1cd97f02-025f-320d-bace-eae835e6ed71",
      "dc:description": {
        "de": [
          "Treffen von 2 Mini Cooper Clubs \"Mini club côte d'Opale\" und \"Not Nor Male\".\n110 Fahrzeuge werden erwartet.\nAnkunft der Fahrzeuge am Samstagnachmittag für eine Ausstellung auf dem Platz der Markthalle.\nAbfahrt der Fahrzeuge am Sonntag um 9.30 Uhr für ein Treffen auf den Stufen des Palais des Congrès."
        ],
        "en": [
          "Gathering of 2 Mini Cooper clubs \"Mini club côte d?Opale\" and \"Not Nor Male\".\n110 vehicles expected.\nArrival of vehicles on Saturday afternoon for an exhibition in the covered market square.\nDeparture of vehicles on Sunday at 9:30 a.m. for a rendezvous on the steps of the Palais des Congrès."
        ],
        "it": [
          "Raduno di 2 club Mini Cooper \"Mini club côte d'Opale\" e \"Not Nor Male\".\nsono attesi 110 veicoli.\nArrivo dei veicoli il sabato pomeriggio per un'esposizione nella piazza del mercato coperto.\nPartenza dei veicoli domenica alle 9.30 per un appuntamento sulla scalinata del Palazzo dei Congressi."
        ],
        "fr": [
          "Rassemblement de 2 clubs de Mini Cooper \"Mini club côte d’Opale\" et \"Not Nor Male\".\n110 véhicules attendus.\nArrivée des véhicules de samedi après-midi pour une exposition place du marché couvert.\nDépart des véhicules le dimanche à 9h30 pour un rendez-vous aux marches du Palais des Congrès."
        ],
        "es": [
          "Reunión de 2 clubes Mini Cooper \"Mini club côte d'Opale\" y \"Not Nor Male\".\nse esperan 110 vehículos.\nLlegada de los vehículos el sábado por la tarde para una exposición en la plaza del mercado cubierta.\nSalida de los vehículos el domingo a las 9.30 h para una cita en la escalinata del Palacio de Congresos."
        ],
        "nl": [
          "Bijeenkomst van 2 Mini Cooper clubs \"Mini club côte d'Opale\" en \"Not Nor Male\".\ner worden 110 voertuigen verwacht.\nAankomst van de voertuigen op zaterdagmiddag voor een tentoonstelling op het overdekte marktplein.\nVoertuigen vertrekken op zondag om 9.30 uur voor een rendez-vous op de trappen van het Palais des Congrès."
        ]
      },
