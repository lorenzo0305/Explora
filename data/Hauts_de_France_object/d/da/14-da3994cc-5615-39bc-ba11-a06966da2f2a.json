  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/89ce4d7b-ecb2-31c0-975d-1c9f24a80a38",
      "dc:description": {
        "de": [
          "Wir sind ein Wanderverein, der auf markierten Strecken (GR) zwischen 7 und 10 km in einem Umkreis von 25 km um Rang-du-Fliers wandert. Wir wandern jeden Mittwoch je nach günstigem Wetter."
        ],
        "en": [
          "We are a hiking club on marked circuits (GR) between 7 and 10 km in a radius of 25 km around Rang-du-Fliers. We walk every Wednesday depending on the weather."
        ],
        "it": [
          "Siamo un club di cammino con circuiti segnalati (GR) tra i 7 e i 10 km in un raggio di 25 km intorno a Rang-du-Fliers. Camminiamo ogni mercoledì, a seconda del tempo."
        ],
        "fr": [
          "Nous sommes un club de randonnées sur des circuits balisés (GR) entre 7 et 10 km dans un rayon de 25 km autour de Rang-du-Fliers. Nous marchons tous les mercredis selon la météo favorable."
        ],
        "nl": [
          "Wij zijn een wandelclub met gemarkeerde circuits (GR) tussen 7 en 10 km in een straal van 25 km rond Rang-du-Fliers. We wandelen elke woensdag, afhankelijk van het weer."
        ],
        "es": [
          "Somos un club de senderismo con circuitos marcados (GR) de entre 7 y 10 km en un radio de 25 km alrededor de Rang-du-Fliers. Caminamos todos los miércoles, dependiendo del tiempo."
        ]
      },
