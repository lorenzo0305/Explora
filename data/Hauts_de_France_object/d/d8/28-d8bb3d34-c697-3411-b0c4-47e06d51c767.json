  "rdfs:comment": {
    "de": [
      "Sie lieben Kanu, dann kommen Sie zu Actiloisirs und üben Sie es mit Ihren Kindern, mit der Familie, mit Freunden oder in der Gruppe aus und fahren Sie vom Maison du Canoë aus auf dem Canal de l'Ourcq."
    ],
    "en": [
      "You like canoeing, come and discover Actiloisirs, and practice with your children, with your family, friends or in group and sail on the Canal de l'Ourcq from the Maison du Canoë."
    ],
    "it": [
      "Se vi piace la canoa, venite a scoprire Actiloisirs, esercitatevi con i vostri bambini, in famiglia, con gli amici o in gruppo e navigate sul Canal de l'Ourcq partendo dalla Maison du Canoë."
    ],
    "fr": [
      "Vous aimez le canoë, venez découvrir Actiloisirs, et pratiquez avec vos enfants, en famille,  entre amis ou en groupe et voguez sur le Canal de l'Ourcq à partir de la Maison du Canoë."
    ],
    "es": [
      "Si le gusta el piragüismo, venga a descubrir Actiloisirs, y practique con sus hijos, en familia, con amigos o en grupo y navegue por el Canal de l'Ourcq desde la Maison du Canoë."
    ],
    "nl": [
      "Als u van kanoën houdt, kom dan Actiloisirs ontdekken en oefen met uw kinderen, als gezin, met vrienden of in een groep en vaar op het Canal de l'Ourcq vanuit het Maison du Canoë."
    ]
  },
  "rdfs:label": {
