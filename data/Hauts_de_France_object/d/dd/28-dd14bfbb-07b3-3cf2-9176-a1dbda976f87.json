  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ddecdd9c-8ff5-3fe1-b842-0910b4b9673f",
      "dc:description": {
        "de": [
          "1998 gegründeter Verein zur Bergung, Instandsetzung und zum Fliegen alter Flugzeuge bei Meetings, Paraden und historischen Reenactments. Überfliegen von historischen Stätten des Departements (Circuit du Souvenir, ...). Besichtigung der Sammlung. Bewahrung des Luftfahrterbes der Samariter und Frankreichs."
        ],
        "en": [
          "Association created in 1998 to recover, refurbish and fly vintage aircraft during meetings, parades, historical re-enactments. Fly over historical sites of the department (Circuit du Souvenir, ...). Visit of the collection. Safeguarding of the Samarian and French aeronautical heritage."
        ],
        "it": [
          "Associazione nata nel 1998 per recuperare, rimettere a nuovo e far volare gli aerei d'epoca in occasione di raduni, parate e rievocazioni storiche. Sorvolare i siti storici del dipartimento (Circuit du Souvenir, ...). Visita della collezione. Salvaguardia del patrimonio aeronautico francese e samaricano."
        ],
        "fr": [
          "Association créée en 1998 pour récupérer, remettre en état et faire voler des aéronefs anciens lors de meetings, défilés, reconstitutions historiques. Survol de sites historiques du département (Circuit du Souvenir, ...). Visite de la collection. Sauvegarde du patrimoine aéronautique samarien et français."
        ],
        "nl": [
          "Vereniging opgericht in 1998 om vintage vliegtuigen te herstellen, op te knappen en te laten vliegen tijdens bijeenkomsten, parades en historische re-enactments. Vliegen over historische plaatsen van het departement (Circuit du Souvenir, ...). Bezoek van de collectie. Bescherming van het Franse en Samariaanse luchtvaarterfgoed."
        ],
        "es": [
          "Asociación creada en 1998 para recuperar, restaurar y hacer volar aviones de época durante encuentros, desfiles y recreaciones históricas. Sobrevolar lugares históricos del departamento (Circuit du Souvenir, ...). Visita de la colección. Salvaguarda del patrimonio aeronáutico francés y samaritano."
        ]
      },
      "@type": [
        "Description"
      ],
