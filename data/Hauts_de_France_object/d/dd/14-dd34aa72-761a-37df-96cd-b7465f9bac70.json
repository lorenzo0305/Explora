  "rdfs:comment": {
    "de": [
      "Le vieux fusil ist der erste Film, der bei der ersten César-Zeremonie vor 50 Jahren triumphiert.\n Er gewann die Preise für den besten Film, den besten Schauspieler und die beste Musik und 1985 den César des César."
    ],
    "en": [
      "Le vieux fusil was the first film to triumph at the first César ceremony 50 years ago.\n It won Best Film, Best Actor and Best Score, and in 1985 the César des Césars."
    ],
    "it": [
      "Le vieux fusil è stato il primo film a trionfare alla prima cerimonia dei César, 50 anni fa.\n Ha vinto il premio per il miglior film, il miglior attore e la migliore colonna sonora, e nel 1985 il César dei César."
    ],
    "fr": [
      "Le vieux fusil est le premier film qui triomphe lors de la première cérémonie des Césars il y a 50 ans.\n Il remporte les prix du meilleur film, meilleur acteur et meilleure musique et en 1985 le César des César."
    ],
    "nl": [
      "Le vieux fusil was de eerste film die 50 jaar geleden zegevierde bij de eerste César-uitreiking.\n De film won Beste Film, Beste Acteur en Beste Score, en in 1985 de César des Césars."
    ],
    "es": [
      "Le vieux fusil fue la primera película que triunfó en la primera ceremonia de los César, hace 50 años.\n Ganó el premio a la mejor película, al mejor actor y a la mejor banda sonora, y en 1985 el César des Césars."
    ]
  },
  "rdfs:label": {
