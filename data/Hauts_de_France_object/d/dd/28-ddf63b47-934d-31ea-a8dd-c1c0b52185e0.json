  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b6d9f035-e7e9-31ef-934a-59acdf7d055c",
      "dc:description": {
        "de": [
          "Originelle Bar, deren Einrichtung an Asien erinnert.\n\n3 Ebenen: 2 Bars und 1 Raucherraum\n\nAperitif-Lounge ab 18 Uhr, Milchshakes, Smoothies, Weine und Cocktails\n\nSonntag und Montag Zen \"tchatchattitude\", Dienstag jazzig Soul 'n' Spirit, Mittwoch Lounge und Pop Rock, Donnerstag Retro House und Afterwork, Freitag und Samstag Lounge und Dancefloor\n\nZielgruppe: 25-35 Jahre\nMusikrichtung: Lounge"
        ],
        "en": [
          "An original bar with a decor reminiscent of Asia.\n\n3 levels: 2 bars and 1 smoking room\n\nApéro lounge from 6pm, milshakes, smoothies, wines and cocktails\n\nSundays and Mondays zen \"tchatchattitude\", Tuesdays jazzy soul 'n' spirit, Wednesdays lounge and pop rock, Thursdays retro house and afterwork and Fridays and Saturdays lounge and dancefloor\n\nClientele:25-35 years old\nType of music: lounge"
        ],
        "it": [
          "Un bar originale con un arredamento asiatico.\n\n3 livelli: 2 bar e 1 sala fumatori\n\nLounge aperitivo dalle 18:00, frullati, smoothies, vini e cocktail\n\nDomenica e lunedì zen \"tchatchattitude\", martedì jazzy soul 'n' spirit, mercoledì lounge e pop rock, giovedì retro house e afterwork, venerdì e sabato lounge e dancefloor\n\nTipo di clientela: 25-35 anni\nTipo di musica: lounge"
        ],
        "fr": [
          "Bar original, dont le décor rappelle l'Asie.\n\n3 niveaux: 2 bars et 1 fumoir\n\nApéro lounge dès 18h, milshakes, smoothies, vins et cocktails\n\nLes Dimanche et Lundi zen \"tchatchattitude\", le Mardi jazzy soul 'n' spirit, le Mercredi lounge et pop rock, le Jeudi rétro house et afterwork et les Vendredi et Samedi lounge et dancefloor\n\nType de clientèle:25-35 ans\nType de musique: lounge"
        ],
        "es": [
          "Un original bar con decoración asiática.\n\n3 niveles: 2 bares y 1 sala de fumadores\n\nSalón de aperitivos a partir de las 18 h, batidos, smoothies, vinos y cócteles\n\nDomingos y lunes zen \"tchatchattitude\", martes jazzy soul 'n' spirit, miércoles lounge y pop rock, jueves retro house y afterwork y viernes y sábados lounge y pista de baile\n\nTipo de clientela:25-35 años\nTipo de música: lounge"
        ],
        "nl": [
          "Een originele bar met een Aziatisch decor.\n\n3 verdiepingen: 2 bars en 1 rookruimte\n\nAperitieflounge vanaf 18u, milkshakes, smoothies, wijnen en cocktails\n\nZondag en maandag zen \"tchatchattitude\", dinsdag jazzy soul 'n' spirit, woensdag lounge en poprock, donderdag retro house en afterwork en vrijdag en zaterdag lounge en dansvloer\n\nSoort klanten:25-35 jaar\nSoort muziek: lounge"
        ]
      },
      "@type": [
        "Description"
      ],
