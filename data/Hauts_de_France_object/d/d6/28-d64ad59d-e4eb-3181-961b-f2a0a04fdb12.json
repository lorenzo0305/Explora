      "@id": "https://data.datatourisme.fr/80f94da8-b3d9-33b1-925d-9d8c482cd305",
      "dc:description": {
        "de": [
          "Fluss - 1. Kategorie\nDomäne von 6500 m²\nTagespreise:\nohne Stempel = 23 € + 10 €*\nmit Stempel = 17 € + 10 €*\n\n* wochenenden für den Fischbesatz\n\nAngeln in Outrebois am Samstag, Sonntag und an Feiertagen"
        ],
        "en": [
          "River - 1st category\nEstate of 6500 m² (6,500 sq. ft.)\nDay rates :\nno stamp = 23 € + 10 €**\nwith stamp = 17 € + 10 €*\n\n* stocking weekends\n\nFishing at Outrebois on Saturdays, Sundays and holidays"
        ],
        "it": [
          "Fiume - 1a categoria\nSuperficie di 6500 m²\nTariffe giornaliere :\nsenza timbro = 23 ? + 10 ?\ncon timbro = 17 ? + 10 ?\n\n* fine settimana di rifornimento\n\nPesca a Outrebois il sabato, la domenica e i giorni festivi"
        ],
        "fr": [
          "Rivière - 1ère catégorie\nDomaine de 6500 m²\nTarifs journée :\nsans timbre = 23 € + 10 €*\navec timbre = 17 € + 10 €*\n\n* les week-end de rempoissonnement \n\nPêcher à Outrebois le Samedi, le Dimanche et les jours fériés"
        ],
        "nl": [
          "Rivier - 1e categorie\nOppervlakte van 6500 m²\nDagtarieven :\nzonder zegel = 23 € + 10 €* met zegel\nmet zegel = 17 € + 10 €*\n\n* weekends van herbevoorrading\n\nVissen in Outrebois op zaterdag, zondag en feestdagen"
        ],
        "es": [
          "Río - 1ª categoría\nSuperficie de 6500 m²\nTarifas diarias :\nsin sello = 23 € + 10 € *\ncon sello = 17€ + 10€ *\n\n* fines de semana de reabastecimiento\n\nPesca en Outrebois los sábados, domingos y festivos"
        ]
      },
