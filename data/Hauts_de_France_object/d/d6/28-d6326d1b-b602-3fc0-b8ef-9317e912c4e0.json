  "rdfs:comment": {
    "de": [
      "Entlang der Ufer der Teiche von Commelles stehen Ihnen einige Picknicktische zur Verfügung, an denen Sie kleine Mahlzeiten mit der Familie, mit Freunden oder in trauter Zweisamkeit genießen können!"
    ],
    "en": [
      "Some picnic tables will welcome you along the banks of the ponds of Commelles to share small meals with family, friends or lovers!"
    ],
    "it": [
      "Alcuni tavoli da picnic vi accoglieranno lungo le rive degli stagni di Commelles per condividere piccoli pasti con la famiglia, gli amici o gli innamorati!"
    ],
    "fr": [
      "Quelques tables de pique-nique vous accueillerons le long des berges des étangs de Commelles pour partager des petits repas en famille , entre amis ou en amoureux !"
    ],
    "nl": [
      "Enkele picknicktafels verwelkomen u langs de oevers van de Commelles-vijvers om kleine maaltijden te delen met familie, vrienden of geliefden!"
    ],
    "es": [
      "Algunas mesas de picnic le acogerán a orillas de los estanques de Commelles para compartir pequeñas comidas con la familia, los amigos o los enamorados"
    ]
  },
