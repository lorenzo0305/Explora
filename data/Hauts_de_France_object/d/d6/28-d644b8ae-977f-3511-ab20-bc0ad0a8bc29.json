  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3878fd2e-69ae-3683-b7af-88d982dae541",
      "dc:description": {
        "de": [
          "Mieline ist Malika, eine Feinkosthändlerin aus Roubaix, die es sich zur Aufgabe gemacht hat, Sie zu verwöhnen! Malika hat eine Leidenschaft für die Küche der Welt und bietet Ihnen eine außergewöhnliche Küche, die Sie mit ihren traditionellen, orientalischen und asiatischen Einflüssen auf eine Reise mitnehmen wird. Ein Mosaik aus Aromen, die es zu entdecken gilt!"
        ],
        "en": [
          "Mieline is Malika, an artisan caterer based in Roubaix, whose vocation is to delight you! Passionate about world cuisine, Malika offers you a cuisine that's out of the ordinary, and that will take you on a journey with its traditional, oriental and Asian influences... A mosaic of flavors to discover!"
        ],
        "it": [
          "Mieline è Malika, una ristoratrice artigiana di Roubaix, la cui vocazione è quella di deliziarvi! Appassionata di cucina mondiale, Malika vi propone una cucina fuori dal comune che vi farà viaggiare con le sue influenze tradizionali, orientali e asiatiche... Un mosaico di sapori da scoprire!"
        ],
        "fr": [
          "Mieline c’est Malika, artisan traiteur sur Roubaix, dont la vocation est de vous régaler ! Passionnée par la cuisine du monde, Malika vous propose une cuisine qui sort de l'ordinaire et qui vous fera voyager de part ses influences traditionnelles, orientales, asiatiques ... Une mosaïque de saveurs à découvrir !"
        ],
        "nl": [
          "Mieline is Malika, een ambachtelijke traiteur gevestigd in Roubaix, wiens roeping het is om u te verrukken! Gepassioneerd door de wereldkeuken, biedt Malika u een keuken die anders is dan anders en die u meeneemt op reis met haar traditionele, oosterse en Aziatische invloeden... Een mozaïek van smaken om te ontdekken!"
        ],
        "es": [
          "Mieline es Malika, una restauradora artesana afincada en Roubaix, ¡cuya vocación es deleitarle! Apasionada de la cocina del mundo, Malika le propone una cocina fuera de lo común que le hará viajar con sus influencias tradicionales, orientales y asiáticas... ¡Un mosaico de sabores por descubrir!"
        ]
      },
