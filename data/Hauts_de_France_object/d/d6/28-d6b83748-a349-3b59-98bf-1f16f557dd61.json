  "rdfs:comment": {
    "de": [
      "In der Nähe von Amiens, in einem charmanten kleinen Dorf in der Picardie, eingebettet in der Nähe des Waldes von Creuse, können Sie das Schloss aus dem 18. Jahrhundert (als historisches Denkmal eingetragen), seinen Park und seine Gärten besichtigen."
    ],
    "en": [
      "Near Amiens, in a charming little Picardy village, nestled near the Creuse forest, come and visit the 18th century castle (listed as a historical monument) its park and gardens."
    ],
    "it": [
      "Vicino ad Amiens, in un incantevole paesino della Piccardia, immerso nella foresta della Creuse, venite a visitare il castello del XVIII secolo (classificato come monumento storico), il suo parco e i suoi giardini."
    ],
    "fr": [
      "Près d'Amiens, dans un charmant petit village picard, niché près de la forêt de Creuse, venez visiter le château du XVIIIème siècle (inscrit monument historique) son parc et ses jardins."
    ],
    "nl": [
      "In de buurt van Amiens, in een charmant Picardisch dorpje, genesteld in de buurt van het bos van Creuse, kunt u een bezoek brengen aan het kasteel uit de 18e eeuw (geklasseerd als historisch monument), het park en de tuinen."
    ],
    "es": [
      "Cerca de Amiens, en un encantador pueblecito de Picardía, enclavado cerca del bosque de Creuse, venga a visitar el castillo del siglo XVIII (catalogado como monumento histórico), su parque y sus jardines."
    ]
  },
