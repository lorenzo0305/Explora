  "rdfs:comment": {
    "de": [
      "Das Dix-Huit bietet Ihnen seine hausgemachten Gourmetgerichte aus frischen Produkten an, die Ihnen in einer freundlichen und gemütlichen Atmosphäre serviert werden."
    ],
    "en": [
      "Le Dix-Huit offers you its home-made gourmet dishes made from fresh products which will be served in a friendly and cosy atmosphere."
    ],
    "it": [
      "Le Dix-Huit offre piatti gourmet fatti in casa con prodotti freschi e serviti in un'atmosfera amichevole e accogliente."
    ],
    "fr": [
      "Le Dix-Huit vous propose ses plats gourmands faits maison à partir de produits frais qui vous seront servis dans une ambiance conviviale et cosy."
    ],
    "es": [
      "Le Dix-Huit ofrece platos gourmet caseros elaborados con productos frescos y servidos en un ambiente agradable y acogedor."
    ],
    "nl": [
      "Le Dix-Huit biedt huisgemaakte gastronomische gerechten van verse producten en wordt geserveerd in een vriendelijke en gezellige sfeer."
    ]
  },
