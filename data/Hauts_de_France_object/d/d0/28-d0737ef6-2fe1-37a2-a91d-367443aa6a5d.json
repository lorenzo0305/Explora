  "rdfs:comment": {
    "de": [
      "Dieses 140 Hektar große Gebiet in Eppe-Sauvage, das im Norden an Belgien grenzt und im Süden neben dem ValJoly liegt, ist aufgrund seiner vielfältigen Landschaften mit Wäldern, Hecken und Wasserflächen, aber auch wegen seines außergewöhnlich interessanten Blumenbestands und seines Vogelschutzgebiets einen Umweg wert."
    ],
    "en": [
      "Located in Eppe-Sauvage, on the border with Belgium to the north and next to ValJoly to the south, this 140-hectare site is well worth a visit for its diverse landscapes of forest, hedged farmland and lakes, as well as its exceptionally interesting floral heritage and its bird protection zone."
    ],
    "it": [
      "Situato a Eppe-Sauvage, al confine con il Belgio a nord e vicino alla Val Joly a sud, questo sito di 140 ettari merita una visita per la diversità dei suoi paesaggi, con foreste, campi coltivati a siepi e laghi, oltre che per il suo patrimonio floreale di eccezionale interesse e per la sua area di protezione degli uccelli."
    ],
    "fr": [
      "Situé à Eppe-Sauvage, en limite de frontière avec la Belgique au Nord et à côté du ValJoly au sud, ce site de 140 hectares, mérite un détour de par la diversité de ses paysages entre forêt, bocage et plans d'eau, mais aussi pour son patrimoine floral d'un intérêt exceptionnel et sa zone de protection des oiseaux."
    ],
    "es": [
      "Situado en Eppe-Sauvage, en la frontera con Bélgica al norte y junto al Val Joly al sur, este paraje de 140 hectáreas merece una visita por la diversidad de sus paisajes, con bosques, tierras de labranza cubiertas de setos y lagos, así como por su patrimonio floral de excepcional interés y su zona de protección de aves."
    ],
    "nl": [
      "Dit gebied van 140 hectare in Eppe-Sauvage, op de grens met België in het noorden en naast Val Joly in het zuiden, is zeker een bezoek waard vanwege de diversiteit van de landschappen, met bossen, omzoomde landbouwgronden en meren, maar ook vanwege het uitzonderlijk interessante bloemenerfgoed en het vogelbeschermingsgebied."
    ]
  },
  "rdfs:label": {
