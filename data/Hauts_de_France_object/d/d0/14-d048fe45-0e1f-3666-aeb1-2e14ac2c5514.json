  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/51041a67-8bbb-3cfb-b90c-54fa6c7352e5",
      "dc:description": {
        "de": [
          "\"Unser Restaurant \"\"le grand Bleu\"\" liegt direkt am Meer und wird mit seiner regionalen Küche (Fischspezialitäten, Meeresfrüchteplatten auf Bestellung) und seiner breiten Palette an Gerichten mit regionalem Geschmack auch die feinsten Gaumen erfreuen.\nFür alle geöffnet\nMenü"
        ],
        "en": [
          "\"Facing the sea, our restaurant \"\"le grand Bleu\"\" will delight the most discerning palates with its local cuisine (fish specialties, seafood platters to order) and its wide range of dishes with regional flavors.\nOpen to all\nMenu"
        ],
        "it": [
          "\"Di fronte al mare, il nostro ristorante \"le grand Bleu\" delizierà i palati più esigenti con la sua cucina locale (specialità di pesce, taglieri di frutti di mare su ordinazione) e la sua vasta gamma di piatti dai sapori regionali.\nAperto a tutti\nMenu"
        ],
        "fr": [
          "\"Face à la mer, notre restaurant \"\"le grand Bleu\"\" comblera les palais les plus fins avec sa cuisine de terroir (spécialité de poissons, plateaux de fruits de mer sur commannde) et sa large gamme de plats aux saveurs régionales. \nOuvert à tous\nMenu"
        ],
        "nl": [
          "\"Ons restaurant \"le grand Bleu\", met uitzicht op zee, zal de meest veeleisende fijnproevers verrukken met zijn lokale keuken (visspecialiteiten, zeevruchtenschotels op bestelling) en zijn ruime keuze aan gerechten met regionale smaken.\nVoor iedereen toegankelijk\nMenu"
        ],
        "es": [
          "\" Frente al mar, nuestro restaurante \"le grand Bleu\" deleitará a los paladares más exigentes con su cocina local (especialidades de pescado, platos de marisco por encargo) y su amplia gama de platos con sabores regionales.\nAbierto a todos\nMenú"
        ]
      },
      "@type": [
        "Description"
      ],
