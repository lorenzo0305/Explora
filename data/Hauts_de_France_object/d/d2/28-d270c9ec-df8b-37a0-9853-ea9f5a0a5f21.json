  "rdfs:comment": {
    "de": [
      "Die Boulangerie Louise befindet sich in Gouvieux und bietet Ihnen eine Auswahl an handwerklich hergestellten Broten, Viennoiserie und Patisserie, die täglich frisch zubereitet werden. Außerdem finden Sie hier verschiedene herzhafte Gerichte, wie Sandwiches und Snacks zum Mitnehmen, die sich ideal für ein Frühstück oder eine leckere Pause am Tag eignen."
    ],
    "en": [
      "Located in Gouvieux, Boulangerie Louise offers a selection of artisan breads, viennoiseries and pastries baked daily. You'll also find a range of savoury sandwiches and snacks to take away, ideal for breakfast or a gourmet break during the day."
    ],
    "it": [
      "Situata a Gouvieux, la Boulangerie Louise offre una selezione di pani artigianali, viennoiseries e dolci sfornati quotidianamente. Troverete anche una gamma di prodotti salati, come panini e snack da asporto, ideali per la colazione o per una pausa golosa durante la giornata."
    ],
    "fr": [
      "Située à Gouvieux, la Boulangerie Louise vous propose une sélection de pains artisanaux, viennoiseries et pâtisseries préparés chaque jour. Vous y trouverez également diverses préparations salées, telles que sandwichs et encas à emporter, idéales pour un petit‑déjeuner ou une pause gourmande dans la journée."
    ],
    "es": [
      "Situada en Gouvieux, la Boulangerie Louise ofrece una selección de panes artesanos, viennoiseries y bollería horneados a diario. También encontrará una gama de productos salados, como sándwiches y bocadillos para llevar, ideales para el desayuno o una pausa gourmet durante el día."
    ],
    "nl": [
      "Boulangerie Louise ligt in Gouvieux en biedt een selectie ambachtelijke broden, viennoiseries en gebakjes die dagelijks worden gebakken. Je vindt er ook een assortiment hartige producten, zoals sandwiches en meeneemsnacks, ideaal voor het ontbijt of een gastronomische pauze overdag."
    ]
  },
