  "rdfs:comment": {
    "de": [
      "Das Höllental hat nichts Höllisches an sich, ganz im Gegenteil\nDiese Route, die zwischen den Departements Oise und Somme verläuft, führt am Tal der Selle entlang und bietet von Belleuse aus wunderschöne Aussichtspunkte."
    ],
    "en": [
      "There's nothing hellish about Hell Valley, on the contrary\nThis itinerary, which runs between the departments of Oise and Somme, runs along the Selle valley and offers beautiful views from Belleuse."
    ],
    "it": [
      "La Vallée d'Enfer non ha nulla di infernale, al contrario\nQuesto percorso, che si snoda tra i dipartimenti dell'Oise e della Somme, segue la valle della Selle e offre splendidi panorami da Belleuse."
    ],
    "fr": [
      "La Vallée d'Enfer n'a rien d'infernal, bien au contraire. \nCet itinéraire qui chemine entre les départements de l'Oise et de la Somme longe la vallée de la Selle et offre de très beaux points de vue depuis Belleuse."
    ],
    "nl": [
      "Er is niets hels aan de Vallée d'Enfer, integendeel\nDeze route, die tussen de departementen Oise en Somme loopt, volgt het dal van de Selle en biedt prachtige uitzichten vanaf Belleuse."
    ],
    "es": [
      "El Valle de Enfer no tiene nada de infernal, sino todo lo contrario\nEsta ruta, que discurre entre los departamentos de Oise y Somme, sigue el valle de la Selle y ofrece hermosas vistas desde Belleuse."
    ]
  },
  "rdfs:label": {
