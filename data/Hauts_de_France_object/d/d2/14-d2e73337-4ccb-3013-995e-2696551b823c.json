  "rdfs:comment": {
    "de": [
      "Die Geschichte der Jugendlichen Theo und Lola, deren Leben durch ein Missverständnis aus den Fugen gerät. Ein starker Text von Rob Evans über die Übertragung von Ängsten der Erwachsenen auf die Welt der Kinder."
    ],
    "en": [
      "The story of young Theo and Lola, whose lives are turned upside down by a misunderstanding. A powerful text by Rob Evans about the transfer of adult fears into the world of children."
    ],
    "it": [
      "La storia dei giovani Theo e Lola, le cui vite vengono sconvolte da un malinteso. Un testo potente di Rob Evans sul trasferimento delle paure degli adulti al mondo dei bambini."
    ],
    "fr": [
      "L’histoire des jeunes Théo et Lola, dont la vie bascule sur fond de malentendu. Un texte fort de Rob Evans sur le transfert des peurs adultes dans le monde des enfants."
    ],
    "es": [
      "La historia de los jóvenes Theo y Lola, cuyas vidas dan un vuelco a causa de un malentendido. Un impactante texto de Rob Evans sobre el traslado de los miedos de los adultos al mundo de los niños."
    ],
    "nl": [
      "Het verhaal van de jonge Theo en Lola, wier levens op hun kop worden gezet door een misverstand. Een krachtige tekst van Rob Evans over de overdracht van volwassen angsten naar de wereld van kinderen."
    ]
  },
  "rdfs:label": {
    "fr": [
