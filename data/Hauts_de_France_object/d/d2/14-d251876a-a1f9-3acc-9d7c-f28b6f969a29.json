  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0d579ae6-2dcb-3a48-96e2-eabff1ccf696",
      "dc:description": {
        "de": [
          "Die Basilika ? Ein kommentierter Rundgang\nEingang der Basilika, Rue de Lille\n\nSamstag: 16 Uhr, 17 Uhr\nSonntag: 14h, 15h, 16h, 17h\nDauer: 45 Min\nEntdeckung des Gebäudes aus dem 19. Jahrhundert, das von Abbé Haffreingue entworfen wurde."
        ],
        "en": [
          "The Basilica ? Guided tour\nBasilica entrance, rue de Lille\n\nSaturday: 4pm, 5pm\nSunday: 2pm, 3pm, 4pm, 5pm\nDuration: 45 min\nDiscover the 19th-century building, the work of Abbé Haffreingue."
        ],
        "it": [
          "La Basilica? Visita guidata\nIngresso alla Basilica, rue de Lille\n\nSabato: ore 16.00, 17.00\nDomenica: 14.00, 15.00, 16.00, 17.00\nDurata: 45 minuti\nScoprite l'edificio del XIX secolo, opera dell'Abbé Haffreingue."
        ],
        "fr": [
          "La Basilique – Visite commentée\nEntrée de la basilique, rue de Lille\n\nSamedi : 16h, 17h\nDimanche : 14h, 15h, 16h, 17h\nDurée : 45 min\nDécouverte de l’édifice du XIXe siècle, œuvre de l’abbé Haffreingue."
        ],
        "es": [
          "La Basílica ? Visita guiada\nEntrada a la Basílica, rue de Lille\n\nSábado: 16:00 h, 17:00 h\nDomingo: 14:00 h, 15:00 h, 16:00 h, 17:00 h\nDuración: 45 minutos\nDescubra el edificio del siglo XIX, obra del abate Haffreingue."
        ],
        "nl": [
          "De basiliek ? Rondleiding\nIngang tot de Basiliek, rue de Lille\n\nZaterdag: 16u, 17u\nZondag: 14u, 15u, 16u, 17u\nDuur: 45 minuten\nOntdek het 19e-eeuwse gebouw, het werk van Abbé Haffreingue."
        ]
      },
