  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a7327db3-3e65-34f4-980a-52c2ea1ed240",
      "dc:description": {
        "de": [
          "Mediathek geöffnet am Dienstag, Donnerstag und Freitag von 13:00 bis 18:30 Uhr. Mittwoch von 9:30 bis 18:30 Uhr und Samstag von 9:30 bis 18:00 Uhr.\n\nAn Feiertagen ist die Bibliothek eine Stunde früher geschlossen!"
        ],
        "en": [
          "Media library open on Tuesday, Thursday and Friday from 1 to 6.30 pm. Wednesday from 9.30 am to 6.30 pm and Saturday from 9.30 am to 6 pm.\n\nClosed 1 hour earlier on holiday eve!"
        ],
        "it": [
          "Mediateca aperta martedì, giovedì e venerdì dalle 13.00 alle 18.30. Mercoledì dalle 9.30 alle 18.30 e sabato dalle 9.30 alle 18.00.\n\nChiusura anticipata di un'ora nei giorni festivi!"
        ],
        "fr": [
          "Médiathèque ouverte les mardi, jeudi et vendredi de 13h à 18h30. Mercredi de 9h30 à 18h30 et samedi de 9h30 à 18h.\n\nFermé 1 heure plus tôt les veilles de fêtes!"
        ],
        "nl": [
          "Mediatheek geopend op dinsdag, donderdag en vrijdag van 13.00 tot 18.30 uur. Woensdag van 9.30 tot 18.30 uur en zaterdag van 9.30 tot 18.00 uur.\n\n1 uur eerder gesloten op feestdagen!"
        ],
        "es": [
          "La mediateca abre los martes, jueves y viernes de 13 a 18.30 horas. Miércoles de 9.30 a 18.30 y sábado de 9.30 a 18.00.\n\nCerrado 1 hora antes en vísperas de festivo"
        ]
      },
