  "rdfs:comment": {
    "de": [
      "Pilates-Sitzung, um sich zu entspannen und sich etwas Gutes zu tun!\n\nBringen Sie Ihre Isomatte oder ein Handtuch mit\nRückzug in die Wassersportbasis bei schlechtem Wetter (Regenschauer, Wind)"
    ],
    "en": [
      "A pilates session to relax and feel good!\n\nBring your own mat or towel\nFallback to the nautical base in case of bad weather (rain showers, wind)"
    ],
    "it": [
      "Una sessione di pilates per rilassarsi e sentirsi bene!\n\nPortare il proprio tappetino o asciugamano\nRitorno alla base nautica in caso di maltempo (pioggia, vento)"
    ],
    "fr": [
      "Séance de pilates pour vous détendre et vous faire du bien !\n\nPrévoir son tapis de sol ou une serviette\nReplis à la base nautique en cas de mauvais temps (averse de pluie, vent)"
    ],
    "es": [
      "¡Una sesión de pilates para relajarse y sentirse bien!\n\nTrae tu propia esterilla o toalla\nRegreso a la base náutica en caso de mal tiempo (chubascos, viento)"
    ],
    "nl": [
      "Een pilatesessie om te ontspannen en je goed te voelen!\n\nNeem je eigen matje of handdoek mee\nTerugval naar de nautische basis in geval van slecht weer (regenbuien, wind)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "SPORT - Pilates stretch avec Méliké"
    ]
  },
