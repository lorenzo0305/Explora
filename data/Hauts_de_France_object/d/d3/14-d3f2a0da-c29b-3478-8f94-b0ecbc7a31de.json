  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3950f230-36a1-3465-af08-eb1249f92e15",
      "dc:description": {
        "de": [
          "Yvan Corbineau kommt, um Fragmente über Gärung und Verlangsamung zu schreiben: Degrowth, Autonomie, Tierleid, Circuit-Court, Eigenproduktion. Alle diese Fragmente werden der Stoff für seine nächste wandernde Dinnershow sein."
        ],
        "en": [
          "Yvan Corbineau comes to write fragments on fermentation and slowing down: degrowth, autonomy, animal suffering, circuit-court, self-production. All these fragments will be the subject of his next touring dinner-show."
        ],
        "it": [
          "Yvan Corbineau scriverà frammenti sulla fermentazione e sul rallentamento: decrescita, autonomia, sofferenza animale, cortocircuiti, autoproduzione. Tutti questi frammenti saranno il soggetto del suo prossimo dinner show itinerante."
        ],
        "fr": [
          "Yvan Corbineau vient écrire des fragments sur la fermentation et le ralentissement : décroissance, autonomie, souffrance animale, circuit-court, auto production. Tous ces fragments seront la matière de son prochain dîner-spectacle itinérant."
        ],
        "nl": [
          "Yvan Corbineau zal fragmenten schrijven over fermentatie en vertragen: degrowth, autonomie, dierenleed, kortsluiting, zelfproductie. Al deze fragmenten zullen het onderwerp zijn van zijn volgende reizende dinnershow."
        ],
        "es": [
          "Yvan Corbineau escribirá fragmentos sobre la fermentación y la ralentización: decrecimiento, autonomía, sufrimiento animal, cortocircuitos, autoproducción. Todos estos fragmentos serán el tema de su próxima cena-espectáculo itinerante."
        ]
      },
