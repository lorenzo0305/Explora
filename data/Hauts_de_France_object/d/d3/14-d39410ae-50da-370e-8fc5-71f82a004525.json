  "rdfs:comment": {
    "de": [
      "Nachdem sie eine Woche lang die Kohlen aus dem Feuer geholt haben, machen die Etincelles Platz für die Feux de la Sainte Barbe!"
    ],
    "en": [
      "After blowing on the embers for a week, the Sparks leave room for the St. Barbara's Fireworks!"
    ],
    "it": [
      "Dopo aver soffiato sulle braci per una settimana, le scintille lasciano il posto ai fuochi d'artificio di Santa Barbara!"
    ],
    "fr": [
      "Après avoir soufflé sur les braises pendant une semaine, les Etincelles laissent place aux Feux de la Sainte Barbe !"
    ],
    "nl": [
      "Na een week op de sintels geblazen te hebben, maken de Sparks plaats voor het Sint Barbara's Vuurwerk!"
    ],
    "es": [
      "Después de soplar las brasas durante una semana, las chispas dan paso a los fuegos artificiales de Santa Bárbara"
    ]
  },
