      "dc:description": {
        "de": [
          "Erstelle dein Ritterwappen, indem du dich von verschiedenen erhaltenen Wappen inspirieren lässt.\n\nDienstag, den 11. Februar um 10 Uhr. Preis: 3,50 Euro / Kind"
        ],
        "en": [
          "Create your own knight?s coat of arms, inspired by the various coats of arms that have been preserved.\n\nTuesday, February 11 at 10 a.m. Price: 3.50 euros / child"
        ],
        "it": [
          "Create il vostro stemma di cavaliere, ispirandovi ai vari stemmi conservati.\n\nMartedì 11 febbraio alle 10.00. Prezzo: 3,50 € / bambino"
        ],
        "fr": [
          "Crée ton blason de chevalier en t’inspirant des différentes armoiries conservées.\n\nMardi 11 février à 10h. Tarif : 3,50 euros / enfant"
        ],
        "nl": [
          "Maak je eigen ridderwapen, geïnspireerd op de verschillende wapenschilden die bewaard zijn gebleven.\n\nDinsdag 11 februari om 10.00 uur. Prijs: €3,50 / kind"
        ],
        "es": [
          "Crea tu propio escudo de caballero, inspirándote en los distintos escudos que se conservan.\n\nMartes 11 de febrero a las 10 h. Precio: 3,50 euros / niño"
        ]
      },
