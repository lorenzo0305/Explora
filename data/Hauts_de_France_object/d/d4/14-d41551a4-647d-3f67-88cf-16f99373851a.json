      "dc:description": {
        "de": [
          "La Table d'Ephélia, das Bistronomierestaurant in Nausicaá, bietet eine von den tropischen Inseln inspirierte Küche mit saisonalen Produkten und nachhaltigem Fischfang."
        ],
        "en": [
          "La Table d?Ephélia, Nausicaá?s bistronomic restaurant, offers cuisine inspired by tropical islands, with seasonal produce and sustainable fishing."
        ],
        "it": [
          "La Table d'Ephélia, il ristorante bistronomico di Nausicaá, offre una cucina ispirata alle isole tropicali, con prodotti di stagione e pesca sostenibile."
        ],
        "fr": [
          "La Table d’Ephélia, restaurant bistronomique de Nausicaá, propose une cuisine inspirée des îles tropicales, avec produits de saison et pêche durable."
        ],
        "nl": [
          "La Table d'Ephélia, het bistronomische restaurant van Nausicaá, biedt een keuken geïnspireerd door tropische eilanden, met seizoensproducten en duurzame visvangst."
        ],
        "es": [
          "La Table d'Ephélia, el restaurante bistronómico de Nausicaá, ofrece una cocina inspirada en las islas tropicales, con productos de temporada y pesca sostenible."
        ]
      },
