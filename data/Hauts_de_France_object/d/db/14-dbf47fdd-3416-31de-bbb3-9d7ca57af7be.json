      "dc:description": {
        "de": [
          "Wir treffen uns am Samstag, den 5. Juli in Ruisseauville bei der Association A Petits Pas\nGehen Sie im Rhythmus der Erde - Start um 9.30 Uhr bis 12.30 Uhr"
        ],
        "en": [
          "Rendezvous on Saturday July 5 in Ruisseauville at Association A Petits Pas\nCome and walk to the rhythm of the earth - departure at 9:30 a.m. to 12:30 p.m"
        ],
        "it": [
          "Appuntamento sabato 5 luglio a Ruisseauville presso l'Associazione A Petits Pas\nVenite a camminare al ritmo della terra - partenza alle 9.30 fino alle 12.30"
        ],
        "fr": [
          "Rendez-vous le samedi 5 juillet à Ruisseauville à l'Association A Petits Pas\nVenez marcher au rythme de la terre - départ à 9h30 jusque 12h30"
        ],
        "es": [
          "Cita el sábado 5 de julio en Ruisseauville, en la Asociación A Petits Pas\nVen a caminar al ritmo de la tierra - salida a las 9h30 hasta las 12h30"
        ],
        "nl": [
          "Afspraak op zaterdag 5 juli in Ruisseauville bij de Association A Petits Pas\nKom en wandel op het ritme van de aarde - vertrek om 9u30 tot 12u30"
        ]
      },
