  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00480f48-207a-3943-803d-12d326a0e4dd",
      "dc:description": {
        "de": [
          "Kein Wettlauf gegen die Zeit, sondern ein Bummel über die Halden, bei dem die ganze Familie spielerisch die Halden entdecken und sich dabei die Beine vertreten kann."
        ],
        "en": [
          "No race against the clock, but some brainstorming to discover the slag heaps in a playful way in family, while stretching the legs."
        ],
        "it": [
          "Nessuna corsa contro il tempo, ma un modo divertente per tutta la famiglia di scoprire i cumuli di scorie e sgranchirsi le gambe."
        ],
        "fr": [
          "Pas de course contre la montre, mais du remue méninge pour découvrir les terrils de façon ludique en famille, tout en se dégourdissant les jambes."
        ],
        "es": [
          "No se trata de una carrera contrarreloj, sino de una forma divertida de que toda la familia descubra los escoriales y estire las piernas."
        ],
        "nl": [
          "Geen race tegen de klok, maar een leuke manier voor het hele gezin om de terrils te ontdekken en de benen te strekken."
        ]
      },
