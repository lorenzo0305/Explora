      "dc:description": {
        "de": [
          "Begleiten Sie uns auf einer solidarischen Longe-côte-Taufe gegen Krebs anlässlich des Rosa Oktobers."
        ],
        "en": [
          "Join us for a longe-côte baptism in solidarity against cancer on the occasion of Pink October."
        ],
        "it": [
          "Unisciti a noi per un'esperienza di navigazione a costine a sostegno della lotta contro il cancro in occasione dell'Ottobre Rosa."
        ],
        "fr": [
          "Rejoignez-nous pour un baptême de longe-côte solidaire contre le cancer à l'occasion d'Octobre Rose."
        ],
        "es": [
          "Únase a nosotros para vivir una experiencia de navegación a vela en apoyo de la lucha contra el cáncer con motivo del Octubre Rosa."
        ],
        "nl": [
          "Doe mee aan een rib-sailing ervaring ter ondersteuning van de strijd tegen kanker om Pink October in te luiden."
        ]
      },
