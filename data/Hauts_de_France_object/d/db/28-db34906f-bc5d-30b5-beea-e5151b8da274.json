  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Geschichte und das Kulturerbe von Compiègne auf einem Rundgang, der speziell für die Erkundung der Schätze dieser Kaiserstadt konzipiert wurde. Dieser Rundgang führt Sie zu den unumgänglichen Orten und geheimen Winkeln des Stadtzentrums..."
    ],
    "en": [
      "Immerse yourself in the history and heritage of Compiègne with a tour specially designed to explore the treasures of this imperial city. This itinerary will guide you through the must-see sites and secret corners of the town center..."
    ],
    "it": [
      "Immergetevi nella storia e nel patrimonio di Compiègne con un tour appositamente studiato per esplorare i tesori di questa città imperiale. Questo tour vi guiderà attraverso i luoghi imperdibili e gli angoli segreti del centro città..."
    ],
    "fr": [
      "Plongez au cœur de l’histoire et du patrimoine de Compiègne à travers un circuit spécialement conçu pour explorer les trésors de cette ville impériale. Ce parcours vous guidera à travers les lieux incontournables et les recoins secrets du centre-ville..."
    ],
    "es": [
      "Sumérjase en la historia y el patrimonio de Compiègne en un recorrido especialmente diseñado para explorar los tesoros de esta ciudad imperial. Este recorrido le guiará por los lugares imprescindibles y los rincones secretos del centro de la ciudad...."
    ],
    "nl": [
      "Dompel jezelf onder in de geschiedenis en het erfgoed van Compiègne tijdens een tour die speciaal is ontworpen om de schatten van deze keizerlijke stad te ontdekken. Deze tour leidt je langs de must-see plekken en geheime hoekjes van het stadscentrum..."
    ]
  },
