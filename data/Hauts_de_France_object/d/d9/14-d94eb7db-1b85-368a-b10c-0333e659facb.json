  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab10dc0e-621a-327e-add3-899e6177a2c7",
      "dc:description": {
        "de": [
          "Unsere Neuheit !\nKommen Sie am 10. Juli mit der ganzen Familie zur Schnitzeljagd \"Die Geheimnisse der Zeit in Lebiez\"\nTreffpunkt am Rathaus von Lebiez um 14 Uhr"
        ],
        "en": [
          "Our new event!\nCome and share a family moment on July 10 for the \"Secrets of time in Lebiez\" treasure hunt\nMeet at Lebiez town hall at 2 p.m"
        ],
        "it": [
          "La nostra ultima attrazione!\nIl 10 luglio, per la caccia al tesoro \"I segreti del tempo a Lebiez\", venite a divertirvi in famiglia\nAppuntamento al municipio di Lebiez alle 14.00"
        ],
        "fr": [
          "Notre nouveauté ! \nVenez partager un moment en famille le 10 juillet pour le jeux de piste \"Les secrets du temps à Lebiez\"\nRendez-vous à la mairie de Lebiez à 14h"
        ],
        "es": [
          "¡Nuestra última atracción!\nVen a disfrutar en familia el 10 de julio de la búsqueda del tesoro \"Los secretos del tiempo en Lebiez\"\nCita en el ayuntamiento de Lebiez a las 14:00 horas"
        ],
        "nl": [
          "Onze nieuwste attractie!\nKom op 10 juli met het hele gezin genieten van de schattenjacht \"De geheimen van de tijd in Lebiez\"\nAfspraak aan het gemeentehuis van Lebiez om 14u"
        ]
      },
