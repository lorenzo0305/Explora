  "rdfs:comment": {
    "de": [
      "In der Nähe von Geschäften und Restaurants bietet dieser Seehafen 250 Anlegeplätze und kann Boote mit einer maximalen Länge von 16 Metern aufnehmen"
    ],
    "en": [
      "Close to shops and restaurants, this seaport has 250 berths and can accommodate boats with a maximum length of 16 meters!"
    ],
    "it": [
      "Vicino a negozi e ristoranti, questo porto marittimo dispone di 250 posti barca e può ospitare imbarcazioni fino a 16 metri di lunghezza!"
    ],
    "fr": [
      "Proche des commerces et restaurants, ce port maritime comprend 250 places d’amarrage et peut accueillir des bateaux ayant une longueur maximum de 16 mètres!"
    ],
