  "rdfs:comment": {
    "de": [
      "Der im 18. Jahrhundert auf dem Gelände einer ehemaligen Krankenstation angelegte Friedhof La Madeleine ist einer der schönsten romantischen Friedhöfe Frankreichs."
    ],
    "en": [
      "Created in the 18th century on the site of a former clumsy churchyard, the cemetery of the Madeleine is one of the most beautiful romantic cemeteries in France."
    ],
    "it": [
      "Creato nel XVIII secolo sul sito di un'antica infermeria, il cimitero della Madeleine è uno dei più bei cimiteri romantici di Francia."
    ],
    "fr": [
      "Créé au XVIIIe siècle sur le site d’une ancienne maladrerie, le cimetière de la Madeleine constitue l'un des plus beaux cimetières romantiques de France."
    ],
    "nl": [
      "De begraafplaats van Madeleine, die in de 18e eeuw werd aangelegd op de plaats van een voormalige ziekenboeg, is een van de mooiste romantische begraafplaatsen van Frankrijk."
    ],
    "es": [
      "Creado en el siglo XVIII en el emplazamiento de una antigua enfermería, el cementerio de la Madeleine es uno de los más bellos cementerios románticos de Francia."
    ]
  },
  "rdfs:label": {
