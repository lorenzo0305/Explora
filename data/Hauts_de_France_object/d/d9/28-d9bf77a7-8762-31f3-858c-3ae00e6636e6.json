      "@id": "https://data.datatourisme.fr/e00ab34b-d71d-3d37-8a19-f2376038f54d",
      "dc:description": {
        "de": [
          "Einer der schönsten romantischen Friedhöfe Frankreichs. Alte Grabdenkmäler (u. a. das Grab von Jules Verne) und uralte Bäume."
        ],
        "en": [
          "One of the most beautiful romantic cemeteries in France. Old funeral monuments (including the tomb of Jules Verne) and centuries-old trees."
        ],
        "it": [
          "Uno dei più bei cimiteri romantici di Francia. Antichi monumenti funerari (tra cui la tomba di Jules Verne) e alberi secolari."
        ],
        "fr": [
          "L'un des plus beaux cimetières romantiques de France. Vieux monuments funéraires (dont le tombeau de Jules Verne) et arbres séculaires."
        ],
        "es": [
          "Uno de los cementerios románticos más bellos de Francia. Antiguos monumentos funerarios (incluida la tumba de Julio Verne) y árboles centenarios."
        ],
        "nl": [
          "Een van de mooiste romantische begraafplaatsen in Frankrijk. Oude grafmonumenten (waaronder het graf van Jules Verne) en eeuwenoude bomen."
        ]
      },
