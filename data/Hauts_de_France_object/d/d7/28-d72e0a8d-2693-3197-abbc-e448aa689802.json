  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3c9c32d1-060c-36d0-874d-83116af38f9f",
      "dc:description": {
        "de": [
          "Lust auf eine Pizza zum Mitnehmen? Besuchen Sie den Pizzakiosk täglich von 11:30 bis 13:30 Uhr und von 18:00 bis 21:30 Uhr\n(Freitag, Samstag und Sonntag bis 22 Uhr, sonntags mittags geschlossen)"
        ],
        "en": [
          "Fancy a pizza to go? Go to the Pizza Kiosk every day from 11:30 a.m. to 1:30 p.m. and from 6:00 p.m. to 9:30 p.m\n(Friday, Saturday and Sunday until 10pm. Closed on Sunday lunchtime)"
        ],
        "it": [
          "Avete voglia di una pizza da portare via? Visitate il chiosco della pizza tutti i giorni dalle 11:30 alle 13:30 e dalle 18:00 alle 21:30\n(venerdì, sabato e domenica fino alle 22. Chiuso la domenica a pranzo)"
        ],
        "fr": [
          "Envie d'une pizza à emporter? Rendez-vous au Kiosque à pizzas tous les jours de 11h30 à 13h30 et de 18h à 21h30. \n(vendredi, samedi et dimanche jusqu'à 22h. Fermé les dimanches midis)"
        ],
        "es": [
          "¿Le apetece una pizza para llevar? Visite el quiosco de pizzas todos los días de 11:30 a 13:30 y de 18:00 a 21:30\n(Viernes, sábados y domingos hasta las 22 h. Cerrado los domingos para el almuerzo)"
        ],
        "nl": [
          "Zin in een pizza om mee te nemen? Bezoek de Pizza Kiosk elke dag van 11.30 tot 13.30 uur en van 18.00 tot 21.30 uur\n(Vrijdag, zaterdag en zondag tot 22.00 uur. Op zondag gesloten voor de lunch)"
        ]
      },
