  "rdfs:comment": {
    "de": [
      "Die Blaskapelle Viv'Long lädt Sie ein, am Weihnachtskonzert in der Kirche Saint Jean-Baptiste teilzunehmen. Erleben Sie den Zauber der Weihnacht beim Klang der Instrumente und der Lieder..."
    ],
    "en": [
      "The Viv'Long brass band invites you to take part in the Christmas concert at Saint Jean-Baptiste church. Come and experience the magic of Christmas to the sound of instruments and carols..."
    ],
    "it": [
      "La Viv'Long brass band vi invita a partecipare al concerto di Natale nella chiesa di Saint Jean-Baptiste. Venite a vivere la magia del Natale al suono di strumenti e canzoni..."
    ],
    "fr": [
      "La fanfare Viv'Long vous propose de participer au concert de Noël en l'église Saint Jean-Baptiste. Venez vivre la magie de Noël au son des instruments et des chants..."
    ],
    "es": [
      "La banda de música Viv'Long le invita a participar en el concierto de Navidad en la iglesia de Saint Jean-Baptiste. Ven a vivir la magia de la Navidad al son de instrumentos y canciones..."
    ],
    "nl": [
      "De fanfare Viv'Long nodigt je uit om deel te nemen aan het kerstconcert in de kerk Saint Jean-Baptiste. Kom en beleef de magie van Kerstmis op de klanken van instrumenten en liederen..."
    ]
  },
