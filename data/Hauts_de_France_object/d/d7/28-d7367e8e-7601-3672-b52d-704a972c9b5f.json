  "rdfs:comment": {
    "de": [
      "Der Bauernhof von Quennevières, enthüllt ein kleines Denkmal und zahlreiche an seinen Wänden angebrachte Tafeln, die an die Kämpfe von 1915 erinnern."
    ],
    "en": [
      "The Quennevières farm features a small memorial and numerous plaques on its walls recalling the fighting of 1915."
    ],
    "it": [
      "La fattoria di Quennevières ospita un piccolo monumento commemorativo e alcune targhe sui muri che ricordano i combattimenti del 1915."
    ],
    "fr": [
      "La ferme de Quennevières, dévoile un petit mémorial et de nombreuses plaques apposées sur ses murs rappelant les combats de 1915."
    ],
    "es": [
      "La granja de Quennevières cuenta con un pequeño monumento conmemorativo y varias placas en sus muros que recuerdan los combates de 1915."
    ],
    "nl": [
      "De boerderij van Quennevières heeft een klein gedenkteken en een aantal gedenkplaten op de muren die herinneren aan de gevechten in 1915."
    ]
  },
  "rdfs:label": {
