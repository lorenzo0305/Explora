      "@id": "https://data.datatourisme.fr/43ba8200-8620-347e-be4f-88493effd7cd",
      "dc:description": {
        "de": [
          "ULM-Taufe, Schnupperflug, Einführung in die Fliegerei, ULM-Patent.\nAb 12 Jahren und unter der Bedingung, dass Sie mindestens 1,20 m groß sind."
        ],
        "en": [
          "ULM baptisms, discovery flights, initiation to piloting, ULM certification.\nFrom age 12, minimum height 1m20."
        ],
        "it": [
          "Battesimo ULM, volo di scoperta, iniziazione al pilotaggio, certificato ULM.\nA partire dai 12 anni, a condizione di essere alti almeno 1m20."
        ],
        "fr": [
          "Baptême ULM, vol découverte, initiation au pilotage, brevet ULM.\nA partir de 12 ans et sous condition de mesurer minimum 1m20."
        ],
        "nl": [
          "ULM-doop, ontdekkingsvlucht, initiatie tot piloot, ULM-diploma.\nVanaf 12 jaar, op voorwaarde dat je minstens 1m20 lang bent."
        ],
        "es": [
          "Bautismo ULM, vuelo de descubrimiento, iniciación al pilotaje, certificado ULM.\nA partir de 12 años, siempre que midas al menos 1m20."
        ]
      },
