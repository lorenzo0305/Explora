  "rdfs:comment": {
    "de": [
      "Ein Konzertsaal auf einem ehemaligen Bergwerksgelände, das ist Le Métaphone® in Oignies auf der ehemaligen Zeche 9/9 bis. Der Klang der Gitarren hat nun den Lärm der Meißel der Bergleute ersetzt..."
    ],
    "en": [
      "A concert hall on a former mining site, it's Le Métaphone® in Oignies on the former carreau 9/9 bis. The sound of guitars has now replaced the noise of the miners' picks..."
    ],
    "it": [
      "Una sala concerti in un ex sito minerario: è Le Métaphone® a Oignies, sull'ex carreau 9/9 bis. Il suono delle chitarre ha sostituito il rumore dei picconi dei minatori..."
    ],
    "fr": [
      "Une salle de concert sur un ancien site minier, c'est Le Métaphone® à Oignies sur l'ancien carreau 9/9 bis. Le son des guitares a désormais remplacé le bruit des pic des mineurs..."
    ],
    "es": [
      "Una sala de conciertos en un antiguo emplazamiento minero, eso es Le Métaphone® en Oignies, en el antiguo carreau 9/9 bis. El sonido de las guitarras ha sustituido al ruido de las piquetas de los mineros..."
    ],
    "nl": [
      "Een concertzaal op een voormalige mijnsite, dat is Le Métaphone® in Oignies op het voormalige carreau 9/9 bis. Het geluid van gitaren heeft nu het lawaai van mijnwerkersplukken vervangen..."
    ]
  },
