  "rdfs:comment": {
    "de": [
      "Dieses Hotel befindet sich etwas außerhalb von Gouvieux, auf halber Strecke zwischen der A16 und der A1 und 5 Minuten vom Schloss Chantilly entfernt. Es befindet sich in einem schönen Haus am Rande der Oise mit einer Terrasse im Sommer am Ufer der Oise und einem Kamin im Winter. Die Zimmer sind geräumig und hell, die Küche ist gastronomisch und traditionell. Kostenloser Privatparkplatz."
    ],
    "en": [
      "Located away from Gouvieux, this hotel is halfway between the A16 and A1 motorways and 5 minutes from Chantilly Castle. It occupies a beautiful house on the banks of the river Oise with a terrace in the summer and a fireplace in the winter. The rooms are spacious and bright, the cuisine is gastronomic and traditional. Free private parking."
    ],
    "it": [
      "Situato a Gouvieux, questo hotel si trova a metà strada tra le autostrade A16 e A1 e a 5 minuti dal Castello di Chantilly. Occupa una bella casa sulle rive del fiume Oise con una terrazza in estate e un camino in inverno. Le camere sono ampie e luminose, la cucina è gastronomica e tradizionale. Parcheggio privato gratuito."
    ],
    "fr": [
      "Installé à l'écart de Gouvieux, cet hôtel est situé à mi-distance de l'A16  et de l'A1  et à 5 mn du Château de Chantilly. Il occupe une belle maison aux abords de l'Oise avec terrasse l'été sur les bords de l'Oise, et cheminée en hiver. Les chambres sont spacieuses et lumineuses, la cuisine gastronomique et traditionnelle. Parking privé gratuit."
    ],
    "es": [
      "Situado lejos de Gouvieux, este hotel está a medio camino entre las autopistas A16 y A1 y a 5 minutos del castillo de Chantilly. Ocupa una bonita casa a orillas del río Oise con terraza en verano y chimenea en invierno. Las habitaciones son amplias y luminosas, la cocina es gastronómica y tradicional. Aparcamiento privado gratuito."
    ],
    "nl": [
      "Dit hotel ligt op afstand van Gouvieux, halverwege de snelwegen A16 en A1 en op 5 minuten van het kasteel van Chantilly. Het is gevestigd in een prachtig huis aan de oevers van de Oise met een terras in de zomer en een open haard in de winter. De kamers zijn ruim en licht, de keuken is gastronomisch en traditioneel. Gratis privé parking."
    ]
  },
