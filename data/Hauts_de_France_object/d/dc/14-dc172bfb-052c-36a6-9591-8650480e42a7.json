  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5fd5f546-ae8c-307d-ad75-38d357b5e899",
      "dc:description": {
        "de": [
          "Samstag, den 13. Juli 2024\nUm 23 Uhr: Feuerwerk an der Strandpromenade.\nVon 22 Uhr bis 1 Uhr: Volkstanz auf dem Place Quentovic.\n\nSonntag, 14. Juli 2024\n9:30 Uhr: Vorbeizug der Truppen des Rettungs- und Feuerwehrzentrums von Etaples-sur-mer.\nAnschließend Parade durch die Stadt, Place Edouard VII."
        ],
        "en": [
          "Saturday July 13, 2024\n11pm: fireworks on the seafront.\n10pm to 1am: popular ball on Place Quentovic.\n\nSunday, July 14, 2024\n9:30am: review of troops from the Etaples-sur-mer fire and rescue center.\nFollowed by a parade through the town, Place Edouard VII."
        ],
        "it": [
          "Sabato 13 luglio 2024\nOre 23:00: spettacolo pirotecnico sul lungomare.\nDalle 22.00 all'1.00: ballo popolare in Place Quentovic.\n\nDomenica 14 luglio 2024\nore 9.30: rassegna delle truppe del centro antincendio e di soccorso di Etaples-sur-mer.\nA seguire sfilata in città, in Place Edouard VII."
        ],
        "fr": [
          "Samedi 13 juillet 2024\nA 23h : feu d'artifice sur le front de mer.\nDe 22h à 1h : bal populaire Place Quentovic. \n\nDimanche 14 juillet 2024\n9h30 : passage en revue des troupes du Centre de secours et d'incendie d'Etaples-sur-mer.\nSuivi d'un défilé en ville, Place Edouard VII."
        ],
        "nl": [
          "Zaterdag 13 juli 2024\n23.00 uur: vuurwerk op de boulevard.\nVan 22.00 tot 01.00 uur: volksdans op het Quentovicplein.\n\nZondag 14 juli 2024\n9.30 uur: troepenrevue van de brandweer- en reddingscentrale van Etaples-sur-mer.\nGevolgd door een parade door de stad, Place Edouard VII."
        ],
        "es": [
          "Sábado 13 de julio de 2024\nA las 23:00 h: Castillo de fuegos artificiales en el paseo marítimo.\nDe 22:00 a 01:00: baile popular en la plaza Quentovic.\n\nDomingo 14 de julio de 2024\n9.30 h: revista de los efectivos del centro de bomberos y salvamento de Etaples-sur-mer.\nA continuación, desfile por la ciudad, plaza Edouard VII."
        ]
      },
