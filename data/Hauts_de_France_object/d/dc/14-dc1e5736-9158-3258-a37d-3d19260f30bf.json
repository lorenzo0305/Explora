  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/29fac310-b2cb-3144-866f-c234c9ff2d51",
      "dc:description": {
        "de": [
          "22 April - Dunes du Mont St-Frieux - Die Geheimnisse des Teiches\n\nBeobachten wir Frösche, Kröten, Molche und andere Amphibien des Mont St-Frieux.\nRDV um 10 Uhr auf dem Parkplatz des Geländes, rue de la mer D940E2 in Dannes."
        ],
        "en": [
          "april 22 - Dunes du Mont St-Frieux - The secrets of the pond\n\nObserve the frogs, toads, newts and other amphibians of Mont Saint-Frieux.\nMeet at 10am at the site parking lot, rue de la mer D940E2, Dannes."
        ],
        "it": [
          "22 aprile - Dunes du Mont St-Frieux - I segreti dello stagno\n\nOsserva le rane, i rospi, i tritoni e gli altri anfibi del Mont Saint-Frieux.\nAppuntamento alle 10 al parcheggio del sito, rue de la mer D940E2 a Dannes."
        ],
        "fr": [
          "22 Avril - Dunes du Mont St-Frieux - Les secrets de la mare\n\nObservons grenouilles, crapauds, tritons et autres amphibiens du Mont Saint-Frieux.\nRDV à 10h sur le parking du site, rue de la mer D940E2 à Dannes."
        ],
        "es": [
          "22 de abril - Dunas del Monte St-Frieux - Los secretos del estanque\n\nObserve las ranas, sapos, tritones y otros anfibios del Monte Saint-Frieux.\nCita a las 10 h en el aparcamiento del sitio, rue de la mer D940E2 en Dannes."
        ],
        "nl": [
          "22 april - Duinen van de Mont St-Frieux - De geheimen van de vijver\n\nObserveer de kikkers, padden, salamanders en andere amfibieën van de Mont Saint-Frieux.\nVerzamelen om 10 uur op de parkeerplaats van de site, rue de la mer D940E2 in Dannes."
        ]
      },
