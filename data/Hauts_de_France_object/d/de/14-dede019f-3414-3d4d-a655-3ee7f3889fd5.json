  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/459c1966-b345-3b4b-9186-9d27f3156249",
      "dc:description": {
        "de": [
          "Die Nocturne Calotteroise\nFreitag, 20. März - Start 20:30 Uhr\nStart: Place de l'Eglise (Platz der Kirche)\n------------------------\nOrganisiert von Multi Extrem Passion\nStrecke von 35 kms\n\nAnmeldung vor Ort ab 10 Uhr\n-Verpflegung auf halber Strecke und am Ziel\n-Lichthelm, reflektierende Weste OBLIGATORISCH\n\nInformationen: 06 25 34 43 45\nCredit: Pixabay"
        ],
        "en": [
          "La Nocturne Calotteroise\nFriday, March 20 - Departure 8:30 pm\nStart : Place de l'Eglise\n------------------------\nOrganized by Multi Extrem Passion\n35 km course\n\nOn-site registration from 10am\n-Refreshments at mid-course and finish\n-Light helmet, reflective vest MANDATORY\n\nInformation: 06 25 34 43 45\nCredit : Pixabay"
        ],
        "it": [
          "La Nocturne Calotteroise\nVenerdì 20 marzo - Inizio alle 20.30\nInizio: Place de l'Eglise\n------------------------\nOrganizzato da Multi Extrem Passion\nPercorso di 35 chilometri\n\nIscrizioni sul posto dalle 10.00\n-Ristoro a metà percorso e all'arrivo\n-Casco leggero, gilet riflettente OBBLIGATORI\n\nInformazioni: 06 25 34 43 45\nCredito : Pixabay"
        ],
        "fr": [
          "La Nocturne Calotteroise\nVendredi 20 mars - Départ 20h30\nDépart : Place de l’Eglise\n------------------------\nOrganisé par Multi Extrem Passion\nParcours de 35 kms\n\nInscriptions sur place à partir de 10h\n-Ravitaillement à mi-parcours et à l’arrivée\n-Casque lumière, gilet réfléchissant OBLIGATOIRE\n\nRenseignements : 06 25 34 43 45\nCrédit : Pixabay"
        ],
        "es": [
          "La Nocturne Calotteroise\nViernes 20 de marzo - Inicio a las 20.30 h\nSalida : Place de l'Eglise\n------------------------\nOrganizado por Multi Extrem Passion\nRecorrido de 35 kilómetros\n\nInscripciones in situ a partir de las 10h\n-Avituallamiento a mitad de recorrido y en meta\n-Casco ligero, chaleco reflectante OBLIGATORIO\n\nInformación: 06 25 34 43 45\nCrédito : Pixabay"
        ],
        "nl": [
          "Calotteroise Nocturne\nVrijdag 20 maart - Aanvang: 20.30 uur\nStart: Place de l'Eglise\n------------------------\nGeorganiseerd door Multi Extrem Passion\nRoute van 35 kilometer\n\nInschrijving ter plaatse vanaf 10u\n-Versnaperingen halverwege het parcours en bij de finish\n-Lichthelm, reflecterend vest VERPLICHT\n\nInformatie: 06 25 34 43 45\nKrediet: Pixabay"
        ]
      },
