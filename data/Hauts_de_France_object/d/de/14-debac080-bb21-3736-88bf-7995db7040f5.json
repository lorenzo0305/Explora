  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c1cc847d-9561-33a3-a3fe-39ea8c79dd3e",
      "dc:description": {
        "de": [
          "Eine der ältesten Saurierfabriken mit familiärem Charakter und Unabhängigkeit? Jeden Tag bereiten etwa 20 Mitarbeiter Hering, Lachs, Makrele und Schellfisch nach alter Bouloner Tradition zu."
        ],
        "en": [
          "One of the oldest, independent, family-run saurisseries in France? Every day, some twenty people prepare herring, salmon, mackerel and haddock in the pure Boulonnaise tradition."
        ],
        "it": [
          "Uno dei più antichi salumifici indipendenti a conduzione familiare? Ogni giorno, una ventina di persone preparano aringhe, salmoni, sgombri ed eglefini secondo la pura tradizione boulonnaise."
        ],
        "fr": [
          "L’une des plus anciennes saurisseries à caractère familial et indépendant.\u2028 Chaque jour une vingtaine de personnes prépare hareng, saumon, maquereau et haddock dans la pure tradition Boulonnaise."
        ],
        "es": [
          "¿Una de las fábricas de salchichas más antiguas, independientes y familiares? Cada día, una veintena de personas preparan arenque, salmón, caballa y eglefino según la pura tradición boulonnaise."
        ],
        "nl": [
          "Een van de oudste onafhankelijke familieworstfabrieken? Elke dag bereiden zo'n twintig mensen haring, zalm, makreel en schelvis in de pure Boulonnaise traditie."
        ]
      },
