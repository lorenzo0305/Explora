  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a183b512-96fc-3bcf-a5a8-0bd1a32173f2",
      "dc:description": {
        "de": [
          "Die École de Surf du Nord bietet Ihnen zwei Einrichtungen, um die Strände des Boulonnais an der Côte d'Opale zu genießen: in Wimereux und Equihen-Plage.\nPreise für die Kurse:\n1 Kurs: 40 Euro\n2 Kurse: 75 Euro\n3 Kurse: 105 Euro\n4 Kurse: 135 Euro\n5 Kurse: 160 Euro"
        ],
        "en": [
          "L'École de Surf du Nord offers 2 locations to enjoy the beaches of the Boulonnais region on the Côte d'Opale: Wimereux and Equihen-Plage.\nPrices for lessons:\n1 lesson: 40 euros\n2 lessons: 75 euros\n3 lessons: 105 euros\n4 lessons : 135 euros\n5 classes: 160 euros"
        ],
        "it": [
          "L'École de Surf du Nord vi offre 2 luoghi per godervi le spiagge del Boulonnais sulla Côte d'Opale: Wimereux e Equihen-Plage.\nPrezzi delle lezioni:\n1 lezione: 40 euro\n2 lezioni: 75 euro\n3 lezioni: 105 euro\n4 lezioni: 135 euro\n5 lezioni: 160 euro"
        ],
        "fr": [
          "L'École de Surf du Nord vous propose 2 établissements pour profiter des plages du Boulonnais sur la Côte d'Opale : à Wimereux et Equihen-Plage.\nTarifs des cours: \n1 cours : 40 euros \n2 cours : 75 euros \n3 cours : 105 euros \n4 cours : 135 euros \n5 cours : 160 euros"
        ],
        "es": [
          "L'École de Surf du Nord te ofrece 2 lugares para disfrutar de las playas de la zona de Boulonnais en la Côte d'Opale: Wimereux y Equihen-Plage.\nPrecios de las clases:\n1 clase: 40 euros\n2 clases: 75 euros\n3 clases: 105 euros\n4 clases: 135 euros\n5 clases: 160 euros"
        ],
        "nl": [
          "L'École de Surf du Nord biedt je 2 plekken om te genieten van de stranden van de Boulonnais aan de Côte d'Opale: Wimereux en Equihen-Plage.\nPrijzen voor lessen:\n1 les: 40 euro\n2 lessen: 75 euro\n3 lessen: 105 euro\n4 lessen: 135 euro\n5 lessen: 160 euro"
        ]
      },
