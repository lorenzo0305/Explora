  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Restaurant de la Tabletterie in Meru und seine herzliche Atmosphäre. Angeführt von einem Oberkellner, der von seinem Beruf begeistert ist, wird unser Team dafür sorgen, dass Sie einen geselligen Moment bei hochwertigen Speisen verbringen."
    ],
    "en": [
      "Discover the restaurant of La Tabletterie in Méru and its warm atmosphere. Led by a maître d'hôtel who is passionate about his job, our team will make you spend a convivial moment around quality dishes."
    ],
    "it": [
      "Scoprite il ristorante Tabletterie di Méru e la sua calda atmosfera. Guidato da un maître appassionato del suo lavoro, il nostro team vi farà trascorrere un momento conviviale intorno a piatti di qualità."
    ],
    "fr": [
      "Découvrez le restaurant de la Tabletterie à Méru et son ambiance chaleureuse. Menée par un maître d'hôtel passionné par son métier, notre équipe saura vous faire passer un moment convivial autour de mets de qualité."
    ],
    "nl": [
      "Ontdek het restaurant Tabletterie in Méru en zijn warme sfeer. Onder leiding van een maître d' met passie voor zijn vak zal ons team u een gezellig moment bezorgen rond kwaliteitsgerechten."
    ],
    "es": [
      "Descubra el restaurante Tabletterie de Méru y su cálido ambiente. Dirigido por un maître apasionado por su trabajo, nuestro equipo le hará pasar un momento de convivencia en torno a platos de calidad."
    ]
  },
