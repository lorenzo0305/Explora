  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b77fafef-95a1-3ec6-93ce-4c3ca3118659",
      "dc:description": {
        "de": [
          "Genießen Sie einen Moment der Freizeit an den Angelteichen von Verchocq. Dieser perfekt ausgestattete Platz mit Unterstand und Sanitäranlagen lädt Sie zu einem Angeltag mit Freunden oder der Familie ein."
        ],
        "en": [
          "Enjoy a moment of leisure at the Verchocq fishing ponds. Perfectly equipped with shelter and sanitary facilities, this area welcomes you for fishing days with friends or family."
        ],
        "it": [
          "Godetevi un momento di svago negli stagni di pesca di Verchocq. Perfettamente attrezzata con un rifugio e servizi igienici, quest'area vi accoglie per giornate di pesca con gli amici o la famiglia."
        ],
        "fr": [
          "Profiter d'un instant de loisirs aux étangs de pêche de Verchocq. Parfaitement équipé avec abri et sanitaire, cet espace vous accueille pour des journées pêche entre amis ou en famille."
        ],
        "nl": [
          "Geniet van een moment van ontspanning aan de visvijvers van Verchocq. Perfect uitgerust met een schuilplaats en sanitaire voorzieningen, verwelkomt dit gebied je voor visdagen met vrienden of familie."
        ],
        "es": [
          "Disfrute de un momento de ocio en los estanques de pesca de Verchocq. Perfectamente equipado con un refugio e instalaciones sanitarias, este espacio le da la bienvenida para jornadas de pesca con amigos o en familia."
        ]
      },
      "@type": [
        "Description"
      ],
