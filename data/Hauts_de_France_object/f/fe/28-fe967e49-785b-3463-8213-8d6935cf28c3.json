  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: moderne, kreative, von der Natur inspirierte Küche in einem einfachen, gemütlichen Ambiente mitten im Herzen der Stadt"
    ],
    "en": [
      "You'll love: modern, creative cuisine inspired by nature in a simple, warm atmosphere in the heart of the city"
    ],
    "it": [
      "Vi piacerà: una cucina moderna e creativa ispirata alla natura, in un'atmosfera semplice e calorosa nel cuore della città"
    ],
    "fr": [
      "Vous aimerez : la cuisine moderne et créative inspirée de la nature dans une ambiance simple et chaleureuse en plein cœur de ville"
    ],
    "es": [
      "Te encantará: cocina moderna y creativa inspirada en la naturaleza en un ambiente sencillo y cálido en pleno centro de la ciudad"
    ],
    "nl": [
      "Je zult ervan houden: moderne, creatieve gerechten geïnspireerd door de natuur in een eenvoudige, warme sfeer in het hart van de stad"
