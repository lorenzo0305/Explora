  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/628aa253-cabe-3b70-85a8-bcfee688cbeb",
      "dc:description": {
        "de": [
          "Vortrag mit Diskussion, um die Herausforderungen von Präventivausgrabungen am Beispiel von Quadraparc zu verstehen: Warum wird ausgegraben? Was wird gefunden und wie werden die Funde analysiert?"
        ],
        "en": [
          "Conference-debate to understand the issues involved in preventive excavations, using Quadraparc as an example: why do we excavate? What do we find and how do we analyze what we find?"
        ],
        "it": [
          "Una conferenza-dibattito per comprendere le problematiche legate agli scavi preventivi, prendendo come esempio Quadraparc: perché scaviamo? Cosa troviamo e come analizziamo ciò che troviamo?"
        ],
        "fr": [
          "Conférence-débat pour comprendre les enjeux des fouilles préventives à travers l’exemple de Quadraparc : pourquoi fouille-t-on ? Que trouve-t-on  et comment analyser les découvertes ?"
        ],
        "nl": [
          "Een conferentie-debat om te begrijpen wat er allemaal komt kijken bij preventieve opgravingen, met Quadraparc als voorbeeld: waarom graven we op? Wat vinden we en hoe analyseren we wat we vinden?"
        ],
        "es": [
          "Conferencia-debate para comprender los problemas que plantean las excavaciones preventivas, tomando como ejemplo Quadraparc: ¿por qué excavamos? ¿Qué encontramos y cómo analizamos lo que encontramos?"
        ]
      },
