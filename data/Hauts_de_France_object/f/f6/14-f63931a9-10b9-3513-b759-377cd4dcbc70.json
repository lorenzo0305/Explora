  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2c2d75f9-c75f-3058-b843-6a9959cb1b62",
      "dc:description": {
        "de": [
          "Orientierungslauf für die ganze Familie von 10:30 bis 12:00 Uhr.\nFinden Sie die im Ort versteckten Markierungen.\nAnmeldung im Tourismusbüro erforderlich.\n3 Euro pro Person, Kinder unter 12 Jahren sind kostenlos.\nTreffpunkt auf der Esplanade mit Wanderschuhen und Wasser."
        ],
        "en": [
          "Family orienteering race from 10.30am to 12pm.\nFind the beacons hidden around the resort.\nRegistration essential at the Tourist Office.\n3 euros per person, free for children under 12.\nMeet at the esplanade with walking shoes and water."
        ],
        "it": [
          "Gara di orienteering per famiglie dalle 10.30 alle 12.00.\nTrovate i fari nascosti in tutta la località.\nIscrizione obbligatoria presso l'Ufficio del Turismo.\n3 euro a persona, gratis per i bambini sotto i 12 anni.\nRitrovo alla spianata con scarpe da trekking e acqua."
        ],
        "fr": [
          "Course d'orientation en famille de 10h30 à 12h. \nTrouvez les balises cachés dans la station. \nInscription indispensable à l'Office de Tourisme. \n3 euros par personne, gratuit pour les enfants de moins de 12 ans. \nRendez-vous à l'esplanade avec vos chaussures de marche et de l'eau."
        ],
        "nl": [
          "Oriëntatieloopwedstrijd voor gezinnen van 10.30 tot 12.00 uur.\nZoek de bakens die in het resort verborgen zijn.\nInschrijving verplicht bij het toeristenbureau.\n3 euro per persoon, gratis voor kinderen onder de 12 jaar.\nVerzamelen op de esplanade met wandelschoenen en water."
        ],
        "es": [
          "Carrera de orientación familiar de 10.30 a 12 h.\nEncuentra las balizas escondidas por la estación.\nInscripción obligatoria en la Oficina de Turismo.\n3 euros por persona, gratis para los menores de 12 años.\nPresentación en la explanada con calzado de senderismo y agua."
        ]
      },
      "@type": [
        "Description"
