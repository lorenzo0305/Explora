  "rdfs:comment": {
    "de": [
      "Experimentiere mit Farbtinten, indem du ein Porträt des Megalosaurus erstellst, dem symbolträchtigen Dinosaurier des Naturhistorischen Museums!  \n\\-----\nGestalte dein Dino-Porträt!  \nFreitag, 17. und 24. April, von 15 bis 16 Uhr\nDuo-Workshop Erwachsene/Kinder von 4 bis 6 Jahren"
    ],
    "en": [
      "Come and experiment with coloured inks by creating a portrait of the Megalosaurus, the emblematic dinosaur of the Natural History Museum!  \n\\-----\nCreate your own dino portrait!  \nFridays, April 17 & 24, 3pm to 4pm\nDuo workshop for adults and children aged 4 to 6"
    ],
    "it": [
      "Venite a cimentarvi con gli inchiostri colorati creando un ritratto del Megalosauro, il dinosauro emblematico del Museo di Storia Naturale!  \n\\-----\nCrea il tuo ritratto di dinosauro!  \nVenerdì 17 e 24 aprile, dalle 15.00 alle 16.00\nLaboratorio in duo per adulti e bambini dai 4 ai 6 anni"
    ],
    "fr": [
      "Viens expérimenter les encres de couleurs en créant le portrait du Mégalosaure, le dinosaure emblématique du Musée d’histoire naturelle !  \n\\-----  \nCrée ton portrait de dino !  \nLes vendredis 17 & 24 avril, de 15h à 16h  \nAtelier duo adulte/enfants de 4 à 6 ans"
    ],
    "es": [
      "Ven a probar tu destreza con las tintas de colores creando un retrato del Megalosaurus, el dinosaurio emblemático del Museo de Historia Natural  \n\\-----\n¡Crea tu propio retrato de dinosaurio!  \nViernes 17 y 24 de abril, de 15.00 a 16.00 h\nTaller dúo para adultos y niños de 4 a 6 años"
    ],
    "nl": [
      "Kom en probeer gekleurde inkt uit door een portret te maken van de Megalosaurus, de emblematische dinosaurus van het Natural History Museum!  \n\\-----\nMaak je eigen dino-portret!  \nVrijdag 17 & 24 april, 15.00-16.00 uur\nDuo workshop voor volwassenen en kinderen van 4 tot 6 jaar"
    ]
  },
