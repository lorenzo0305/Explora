  "rdfs:comment": {
    "de": [
      "Picknickplatz im Parc Jean-Jacques Rousseau (freier Eintritt) in der Nähe des Teichs.\n3 Tische, kostenloser Parkplatz in der Nähe\nFahrräder müssen am Eingang geparkt werden (Fahrradbügel)"
    ],
    "en": [
      "Picnic area in the Jean-Jacques Rousseau Park (free entrance) near the pond.\n3 tables, free parking nearby\nBicycles must be parked at the entrance of the site (hoops)"
    ],
    "it": [
      "Area picnic nel Parco Jean-Jacques Rousseau (ingresso gratuito) vicino al laghetto.\n3 tavoli, parcheggio gratuito nelle vicinanze\nLe biciclette devono essere parcheggiate all'ingresso del sito (rastrelliere)"
    ],
    "fr": [
      "Aire de pique-nique  dans le Parc Jean-Jacques Rousseau (entrée libre) à proximité de l'étang.\n3 tables,  parking gratuit à proximité\nLes vélos doivent être parqués à l'entrée du site (arceaux)"
    ],
    "es": [
      "Zona de picnic en el Parque Jean-Jacques Rousseau (entrada gratuita) cerca del estanque.\n3 mesas, aparcamiento gratuito en las inmediaciones\nLas bicicletas deben aparcarse en la entrada del recinto (aparcabicicletas)"
    ],
    "nl": [
      "Picknickplaats in het Parc Jean-Jacques Rousseau (gratis toegang) bij de vijver.\n3 tafels, gratis parkeren in de buurt\nFietsen moeten bij de ingang van het terrein worden gestald (fietsenrekken)"
    ]
