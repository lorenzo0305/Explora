      "dc:description": {
        "de": [
          "Sonntag, 28. September, in den Gymnasien der Oberschulen.\n\nTüröffnung um 12 Uhr, Beginn der Spiele um 14 Uhr.\n\nVerpflegung vor Ort.\n \nVon Aurélie moderiert.\nWeitere Informationen unter 06 82 18 66 29."
        ],
        "en": [
          "Sunday, September 28, at the high school gymnasiums.\n\nDoors open at 12pm, games start at 2pm.\n\nCatering on site.\n \nHosted by Aurélie.\nFurther information on 06 82 18 66 29."
        ],
        "it": [
          "Domenica 28 settembre, presso le palestre dei lycées.\n\nApertura porte alle 12.00, inizio partite alle 14.00.\n\nRistorazione in loco.\n \nOspitato da Aurélie.\nUlteriori informazioni al numero 06 82 18 66 29."
        ],
        "fr": [
          "Dimanche 28 septembre, au gymnases des lycées.\n\nOuverture des portes à 12h, début des jeux à 14h.\n\nRestauration sur place.\n \nAnimé par Aurélie. \nPlus d'informations au 06 82 18 66 29."
        ],
        "nl": [
          "Zondag 28 september, in de gymzalen van de lycea.\n\nDe deuren gaan open om 12.00 uur, de wedstrijden beginnen om 14.00 uur.\n\nCatering ter plaatse.\n \nGeorganiseerd door Aurélie.\nMeer informatie op 06 82 18 66 29."
        ],
        "es": [
          "Domingo 28 de septiembre, en los gimnasios de los liceos.\n\nApertura de puertas a las 12.00 y comienzo de los partidos a las 14.00.\n\nCatering in situ.\n \nOrganizado por Aurélie.\nMás información en el 06 82 18 66 29."
        ]
      },
