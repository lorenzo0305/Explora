      "dc:description": {
        "de": [
          "Produzent von Saisongemüse, Direktverkauf ab Hof über einen Verteiler und auf dem Markt in Montreuil-sur-Mer am Samstagmorgen."
        ],
        "en": [
          "Producer of seasonal vegetables, selling direct from the farm via a distributor and at the Montreuil-sur-Mer market on Saturday mornings."
        ],
        "it": [
          "Produttore di verdure di stagione, vende direttamente dalla fattoria tramite un distributore e al mercato di Montreuil-sur-Mer il sabato mattina."
        ],
        "fr": [
          "Producteur de légumes de saisons, vente directe à la ferme via un distributeur et sur le marché de Montreuil-sur-Mer le samedi matin."
        ],
        "es": [
          "Productor de verduras de temporada que vende directamente en la explotación a través de un distribuidor y en el mercado de Montreuil-sur-Mer los sábados por la mañana."
        ],
        "nl": [
          "Producent van seizoensgroenten, verkoopt rechtstreeks van de boerderij via een distributeur en op de markt van Montreuil-sur-Mer op zaterdagochtend."
        ]
      },
