      "dc:description": {
        "de": [
          "Treffpunkt am Freitagmittag Place Navarin\n(ausgesetzt bis zum Frühjahr 2021)\n\nFood Truck Frische & lokale Produkte Frische Pommes frites Privatleistung, Kostenvoranschlag auf Anfrage 0634771421"
        ],
        "en": [
          "Friday lunchtime at Place Navarin\n(suspended until spring 2021)\n\nFood Truck Fresh & local products Fresh French fries Private service, estimate on request 0634771421"
        ],
        "it": [
          "Appuntamento il venerdì a pranzo in Place Navarin\n(sospeso fino alla primavera 2021)\n\nFood Truck Prodotti freschi e locali Patatine fresche Servizio privato, preventivo su richiesta 0634771421"
        ],
        "fr": [
          "Rendez-vous le vendredi midi place Navarin\n(suspendu jusqu'au printemps 2021)\n\nFood Truck Produits frais & locaux Frites fraiches Prestation privée, devis sur demande 0634771421"
        ],
        "es": [
          "Cita los viernes al mediodía en la plaza Navarin\n(suspendido hasta la primavera de 2021)\n\nFood Truck Productos frescos y locales Patatas fritas frescas Servicio privado, presupuesto a petición 0634771421"
        ],
        "nl": [
          "Bijeenkomst op vrijdagmiddag bij Place Navarin\n(opgeschort tot voorjaar 2021)\n\nFood Truck Verse & lokale producten Verse friet Private service, offerte op aanvraag 0634771421"
        ]
      },
