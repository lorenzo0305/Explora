  "rdfs:comment": {
    "de": [
      "Die Cziffra-Stiftung präsentiert Ihnen ein Quartett aus dem Wiener Erbe mit Stücken von Mozart, Schubert und Beethoven. Gidon Kremer an der Violine, Maxim Rysanov an der Viola, Luka Coetzee am Violoncello und Mikhail Pletnev am Klavier."
    ],
    "en": [
      "The Cziffra Foundation presents a quartet from the Viennese heritage, with pieces by Mozart, Schubert and Beethoven. Gidon Kremer on violin, Maxim Rysanov on viola, Luka Coetzee on cello and Mikhail Pletnev on piano."
    ],
    "it": [
      "La Fondazione Cziffra propone un quartetto del patrimonio viennese con brani di Mozart, Schubert e Beethoven. Gidon Kremer al violino, Maxim Rysanov alla viola, Luka Coetzee al violoncello e Mikhaïl Pletnev al pianoforte."
    ],
    "fr": [
      "La Fondation Cziffra vous propose un quatuor de l'héritage Viennois avec des morceaux de Mozart, Schubert et Beethoven. Gidon Kremer au violon, Maxim Rysanov à l'alto, Luka Coetzee au violoncelle et Mikhaïl Pletnev au piano."
    ],
    "es": [
      "La Fundación Cziffra le ofrece un cuarteto de la herencia vienesa con piezas de Mozart, Schubert y Beethoven. Gidon Kremer al violín, Maxim Rysanov a la viola, Luka Coetzee al violonchelo y Mikhaïl Pletnev al piano."
    ],
    "nl": [
      "De Cziffra Foundation biedt je een kwartet uit het Weense erfgoed met stukken van Mozart, Schubert en Beethoven. Gidon Kremer op viool, Maxim Rysanov op altviool, Luka Coetzee op cello en Mikhaïl Pletnev op piano."
    ]
  },
