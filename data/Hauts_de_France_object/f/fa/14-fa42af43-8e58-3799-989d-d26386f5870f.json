  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/acd10f5e-df83-369f-bb6e-c6d5d3bfc1b2",
      "dc:description": {
        "de": [
          "Einfache und gute traditionelle Gerichte!\nHier finden Sie picardische Schnüre, Burger, Welsh, Lasagne und Salate in einer geselligen Atmosphäre! Besondere Erwähnung verdienen die hausgemachten und immer gut zubereiteten Tagesgerichte. Möglichkeit zum Mitnehmen."
        ],
        "en": [
          "Simple and good traditional dishes!\nFind ficelles picardes, burgers, welsh, lasagne, salads in a friendly atmosphere! Special mention for the home-made dishes of the day, always well prepared. Possibility of take-away."
        ],
        "it": [
          "Piatti tradizionali semplici e buoni!\nTrovate ficelles picardes, hamburger, welsh, lasagne, insalate in un'atmosfera amichevole! Menzione speciale per i piatti del giorno fatti in casa, sempre ben preparati. Possibilità di asporto."
        ],
        "fr": [
          "Des plats traditionnels simples et bons !\nRetrouvez ficelles picardes, burgers, welsh, lasagne, salades dans une ambiance conviviale ! Mention spéciale pour les plats du jour cuisinés maison et toujours bien préparés. Possibilité de vente à emporter."
        ],
        "es": [
          "¡Platos tradicionales sencillos y buenos!\n¡Encuentra ficelles picardes, hamburguesas, galesas, lasañas, ensaladas en un ambiente acogedor! Mención especial para los platos caseros del día, siempre bien preparados. Se ofrece comida para llevar."
        ],
        "nl": [
          "Eenvoudige en goede traditionele gerechten!\nVind ficelles picardes, burgers, welsh, lasagne, salades in een gezellige sfeer! Speciale vermelding voor de huisgemaakte gerechten van de dag, altijd goed bereid. Afhaalmaaltijden beschikbaar."
        ]
      },
      "@type": [
        "Description"
