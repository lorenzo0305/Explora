  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6151a34c-005a-33ec-a3bd-a72e513eec55",
      "dc:description": {
        "de": [
          "Wir treffen uns an der Kirche von Grugies alle zwei Wochen sonntags von 8:30 bis 12:30 Uhr zu einer Wanderung in der Umgebung des Dorfes.\nProgramm verfügbar auf der Seite: https://drive.google.com/file/d/1i06rgxcORl5JjczfATo9HFZ1uOmgZCnt/view?usp=sharing\n\nPraktische Informationen\n- Anmeldung: 10€ für ein Jahr als Einzelperson und 15€ für ein Paar."
        ],
        "en": [
          "Meeting at the Church of Grugies on Sundays every fortnight from 8.30am to 12.30pm for a walk around the village.\nProgram available on the page: https://drive.google.com/file/d/1i06rgxcORl5JjczfATo9HFZ1uOmgZCnt/view?usp=sharing\n\nPractical information\n- Registration: 10€ for the year for an individual and 15€ for a couple."
        ],
        "it": [
          "Incontro presso la Chiesa di Grugies ogni quindici giorni dalle 8.30 alle 12.30 per una passeggiata intorno al villaggio.\nProgramma disponibile alla pagina: https://drive.google.com/file/d/1i06rgxcORl5JjczfATo9HFZ1uOmgZCnt/view?usp=sharing\n\nInformazioni pratiche\n- Iscrizione: 10? per l'anno per i singoli e 15? per le coppie."
        ],
        "fr": [
          "Rendez-vous à l'Église de Grugies le dimanche tous les quinze jours de 8h30 à 12h30 pour une randonnée aux alentours du village.\nProgramme disponible sur la page : https://drive.google.com/file/d/1i06rgxcORl5JjczfATo9HFZ1uOmgZCnt/view?usp=sharing\n\nInformations pratiques: \n- Inscription : 10€ pour l'année en individuel et 15€ pour un couple."
        ],
        "es": [
          "Nos reunimos en la iglesia de Grugies cada quince días de 8.30 a 12.30 para dar un paseo por el pueblo.\nPrograma disponible en la página: https://drive.google.com/file/d/1i06rgxcORl5JjczfATo9HFZ1uOmgZCnt/view?usp=sharing\n\nInformación práctica\n- Matrícula: 10 euros al año para los particulares y 15 euros para las parejas."
        ],
        "nl": [
          "Kom elke twee weken van 8.30 tot 12.30 uur bijeen bij de kerk van Grugies voor een wandeling door het dorp.\nProgramma beschikbaar op de pagina: https://drive.google.com/file/d/1i06rgxcORl5JjczfATo9HFZ1uOmgZCnt/view?usp=sharing\n\nPraktische informatie\n- Inschrijving: 10€ voor het jaar voor individuen en 15€ voor een koppel."
        ]
      },
