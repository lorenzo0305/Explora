  "rdfs:comment": {
    "de": [
      "Entdecken und genießen Sie die marokkanischen Spezialitäten, Couscous, Tajines und Pastillas des Restaurants l'Arganier, wo Sie sich in die marokkanische Atmosphäre mit ihren warmen Farben und bunten Laternen entführen lassen können."
    ],
    "en": [
      "Discover and savor Moroccan specialties such as couscous, tajines and pastillas at the Arganier restaurant, where you'll be transported into the Moroccan atmosphere of warm colors and colorful lanterns."
    ],
    "it": [
      "Scoprite e assaporate le specialità marocchine come il couscous, le tajine e le pastillas al ristorante Arganier, dove sarete trasportati nell'atmosfera marocchina fatta di colori caldi e lanterne colorate."
    ],
    "fr": [
      "Découvrez et savourez les spécialités marocaines, couscous, tajines, pastillas du restaurant l'Arganier, où vous serez transportés dans l'ambiance marocaines aux couleurs chaudes et lanternes colorées."
    ],
    "nl": [
      "Ontdek en proef Marokkaanse specialiteiten zoals couscous, tajines en pastilla's in restaurant Arganier, waar je wordt meegevoerd in de Marokkaanse sfeer van warme kleuren en kleurrijke lantaarns."
    ],
    "es": [
      "Descubra y saboree especialidades marroquíes como el cuscús, los tajines y las pastillas en el restaurante Arganier, donde se transportará al ambiente marroquí de colores cálidos y farolillos de colores."
    ]
  },
