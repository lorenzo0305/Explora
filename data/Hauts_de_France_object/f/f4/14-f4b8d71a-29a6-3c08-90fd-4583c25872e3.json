  "rdfs:comment": {
    "de": [
      "Borderless ist ein Zirkus- und Tanzspektakel, das mit Klischees und Stereotypen spielt, um Grenzen zu sprengen und an ihrer Stelle einen Raum des Friedens zu schaffen."
    ],
    "en": [
      "A circus and dance show, Borderless plays with clichés and stereotypes to shatter borders and create, in their place, a space of peace."
    ],
    "it": [
      "Spettacolo di circo e danza, Borderless gioca sui luoghi comuni e sugli stereotipi per infrangere i confini e creare uno spazio di pace al loro posto."
    ],
    "fr": [
      "Spectacle de cirque et de danse, Borderless se joue des clichés et des stéréotypes pour faire voler en éclat les frontières, et créer, à leur place, un espace de paix."
    ],
    "es": [
      "Borderless, un espectáculo de circo y danza, juega con clichés y estereotipos para romper fronteras y crear un espacio de paz en su lugar."
    ],
    "nl": [
      "Borderless is een circus- en dansvoorstelling die speelt met clichés en stereotypen om grenzen te verbrijzelen en in plaats daarvan een ruimte van vrede te creëren."
    ]
  },
