  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d0866ed6-e9f0-3101-a313-1bc450972394",
      "dc:description": {
        "de": [
          "Gereifter Käse (Gourguechon, Tomme d'Opale), Frischkäse mit Knoblauch und Kräutern, Butter, Sahne, Rohmilch, Käsekuchen\nVerkauf an Gewerbetreibende."
        ],
        "en": [
          "Ripened cheeses (Gourguechon, Tomme d'Opale), fresh garlic and herbs cheeses, butter, fresh cream, raw milk, cheese tarts\nSale to professionals."
        ],
        "it": [
          "Formaggi stagionati (Gourguechon, Tomme d'Opale), formaggi freschi con aglio ed erbe, burro, panna fresca, latte crudo, crostate di formaggio\nVendite ai professionisti."
        ],
        "fr": [
          "Fromages affinés (Gourguechon, Tomme d'Opale), fromages frais ail et fines herbes, beurre, crème fraîche, lait cru, tartes au fromage. \nVente aux professionnels."
        ],
        "es": [
          "Quesos maduros (Gourguechon, Tomme d'Opale), quesos frescos con ajo y hierbas, mantequilla, nata fresca, leche cruda, tartas de queso\nVenta a profesionales."
        ],
        "nl": [
          "Gerijpte kazen (Gourguechon, Tomme d'Opale), verse kazen met knoflook en kruiden, boter, verse room, rauwe melk, kaastaarten\nVerkoop aan professionals."
        ]
      },
