      "dc:description": {
        "de": [
          "Genießen Sie dank Ihrer Pedaltritte einen leckeren Smoothie. Eine Animation für Sport, Ernährung, Gesundheit und nachhaltige Entwicklung."
        ],
        "en": [
          "Enjoy a delicious smoothie as you pedal. An event for sport, nutrition, health and sustainable development."
        ],
        "it": [
          "Gustate un delizioso frullato mentre pedalate. Un evento che promuove lo sport, la nutrizione, la salute e lo sviluppo sostenibile."
        ],
        "fr": [
          "Dégustez un délicieux smoothie grâce à vos coups de pédales. Une animation pour le sport, la nutrition, la santé et le développement durable."
        ],
        "nl": [
          "Geniet van een heerlijke smoothie terwijl je fietst. Een evenement ter promotie van sport, voeding, gezondheid en duurzame ontwikkeling."
        ],
        "es": [
          "Disfrute de un delicioso batido mientras pedalea. Un evento que promueve el deporte, la nutrición, la salud y el desarrollo sostenible."
        ]
      },
