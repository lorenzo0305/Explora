  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/70783680-6e71-3491-9ef5-979eb014e1f6",
      "dc:description": {
        "de": [
          "Tomatenbasis, Crème fraîche, Mozzarella oder spezielle Soßen - für jeden Geschmack und jede Farbe ist etwas dabei! Für Naschkatzen gibt es die Pizzen von La Nonna auch in einer süßen Version zum Teilen (oder auch nicht)!"
        ],
        "en": [
          "Tomato base, crème fraîche, mozzarella or special sauces, there's something for every taste and color! For those with a sweet tooth, Nonna's pizzas are also available in a sweet version to share (or not)!"
        ],
        "it": [
          "Base di pomodoro, crème fraîche, mozzarella o salse speciali, ce n'è per tutti i gusti e colori! Per i più golosi, le pizze de La Nonna sono disponibili anche in versione dolce da condividere (o meno)!"
        ],
        "fr": [
          "Base tomate, crème fraîche, mozzarella ou sauces spéciales, il y en a pour tous les goûts et toutes les couleurs ! Pour les gourmands, les pizzas de la Nonna se déclinent également en version sucrée à partager (ou pas) !"
        ],
        "nl": [
          "Tomatenbasis, crème fraîche, mozzarella of speciale sauzen, er is voor elke smaak en kleur wat wils! Voor de zoetekauwen zijn de pizza's van La Nonna er ook in een zoete versie om te delen (of niet)!"
        ],
        "es": [
          "A base de tomate, crème fraîche, mozzarella o salsas especiales, ¡hay para todos los gustos y colores! Para los más golosos, las pizzas de La Nonna también vienen en versión dulce para compartir (¡o no!)"
        ]
      },
