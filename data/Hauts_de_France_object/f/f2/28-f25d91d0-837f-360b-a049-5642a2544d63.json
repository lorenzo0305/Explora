  "rdfs:comment": {
    "de": [
      "Das Coyote Café ist ein gemütliches, auf mexikanisch-amerikanische Küche spezialisiertes Restaurant mit 120 Plätzen, das Sie von Montagmittag bis Samstagabend empfängt!"
    ],
    "en": [
      "The Coyote Café is a friendly, 120-seat restaurant specializing in Mexican-American cuisine, open from Monday lunchtime to Saturday evening!"
    ],
    "it": [
      "Il Coyote Café è un accogliente ristorante specializzato in cucina messicano-americana con 120 coperti, aperto dal lunedì a pranzo al sabato sera!"
    ],
    "fr": [
      "Le Coyote Café est un restaurant convivial spécialisé dans la cuisine mexicano-américaine de 120 couverts qui vous accueille du lundi midi au samedi soir !"
    ],
    "nl": [
      "Het Coyote Café is een gezellig restaurant gespecialiseerd in de Mexicaans-Amerikaanse keuken met 120 couverts, geopend van maandagmiddag tot zaterdagavond!"
