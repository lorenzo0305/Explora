  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c23bd2e1-a34c-3fa7-b65d-70410d71288f",
      "dc:description": {
        "de": [
          "Handwerkliche Herstellung von Pizzen, die vor Ort aus frischen Zutaten zubereitet werden.\n\nDer Teig wird 48 Stunden vor Gebrauch geknetet und gereift, von Hand geformt und über Holzfeuer gebacken.\n\nLieferung in einem Umkreis von 8 km um Ruminghem."
        ],
        "en": [
          "Homemade pizzas prepared on site from fresh ingredients.\n\nDough kneaded and matured 48 hours before use, shaped by hand and baked over a wood fire.\n\nDelivery within an 8 km radius of Ruminghem."
        ],
        "it": [
          "Pizze fatte in casa e preparate sul posto con ingredienti freschi.\n\nImpasto lavorato e maturato 48 ore prima dell'uso, modellato a mano e cotto a legna.\n\nConsegna nel raggio di 8 km da Ruminghem."
        ],
        "fr": [
          "Fabrication artisanale de pizzas préparées sur place à partir d'ingrédients frais.\n\nPâte pétrie et maturée 48h avant utilisation, façonnée à la main et cuite au feu de bois.\n\nEn livraison dans un rayon de 8 km autour de Ruminghem."
        ],
        "es": [
          "Pizzas caseras preparadas in situ con ingredientes frescos.\n\nMasa amasada y madurada 48 horas antes de su uso, moldeada a mano y horneada al fuego de leña.\n\nEntrega en un radio de 8 km de Ruminghem."
        ],
        "nl": [
          "Huisgemaakte pizza's ter plekke bereid met verse ingrediënten.\n\nDeeg 48 uur voor gebruik gekneed en gerijpt, met de hand gevormd en boven houtvuur gebakken.\n\nLevering binnen een straal van 8 km rond Ruminghem."
        ]
      },
      "@type": [
        "Description"
