    "it": [
      "4 km tra Saint-Martin-Longueau e Pont-Sainte-Maxence in bicicletta, a piedi o con i rollerblade!\nLungo il percorso attraverserete la foresta del Bois des Boursaults!"
    ],
    "fr": [
      "4 km entre Saint-Martin-Longueau, et Pont-Sainte-Maxence à faire à vélo, à pied ou à roller ! \nAu cours de cet itinéraire vous traverserez le bois des Boursaults !"
    ],
    "nl": [
      "4 km tussen Saint-Martin-Longueau en Pont-Sainte-Maxence op de fiets, te voet of op skeelers!\nOnderweg kom je door het bos van Bois des Boursaults!"
