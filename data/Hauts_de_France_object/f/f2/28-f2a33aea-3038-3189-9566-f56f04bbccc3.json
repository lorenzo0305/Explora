  "rdfs:comment": {
    "de": [
      "Als Spezialist für Paris-Brest stellen die Eichhörnchen ihre verschiedenen Pralinen selbst her, um diesen Klassiker in allen Nussarten und mit Produkten aus biologischem Anbau zu variieren."
    ],
    "en": [
      "Specialists in Paris-Brest, the Squirrels make their own pralines to give this classic a nutty twist, using organically grown products."
    ],
    "it": [
      "Specializzati in Paris-Brest, gli scoiattoli preparano le loro praline per dare a questo classico un tocco di nocciola, utilizzando prodotti biologici."
    ],
    "fr": [
      "Spécialistes du Paris-Brest, les écureuils fabriquent eux mêmes leurs différents pralinés pour décliner ce classique à toutes les noix, avec des produits issus de l'agriculture biologique."
    ],
    "es": [
      "Especialistas en París-Brest, las ardillas elaboran sus propios pralinés para dar a este clásico un toque de frutos secos, utilizando productos ecológicos."
    ],
    "nl": [
      "De eekhoorns zijn gespecialiseerd in Paris-Brest en maken hun eigen pralines om deze klassieker een nootachtige twist te geven, met biologische producten."
    ]
  },
