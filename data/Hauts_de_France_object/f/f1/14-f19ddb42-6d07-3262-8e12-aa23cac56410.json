  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/559939c6-c94a-3fb7-bda4-6a14dc63b97d",
      "dc:description": {
        "de": [
          "Einrichtung zur Verpflegung und Freizeitgestaltung\nPizzas, Crêpes, Eis, Chichis usw.\n1 beheizte Innenterrasse 1 Außenterrasse in Südlage\n1 18-Loch-Minigolfanlage\n1 Rennstrecke mit Elektroautos und -motorrädern für Kinder von 3 bis 12 Jahren."
        ],
        "en": [
          "Catering and leisure facilities\nPizzas, crêpes, ice creams, chichis, etc.\n1 heated indoor terrace 1 south-facing outdoor terrace\n1 18-hole mini-golf course\n1 electric car and motorcycle circuit for children aged 3 to 12."
        ],
        "it": [
          "Ristorazione e strutture per il tempo libero\nPizze, crêpes, gelati, chichis, ecc.\n1 terrazza interna riscaldata 1 terrazza esterna esposta a sud\n1 campo da minigolf a 18 buche\n1 circuito di auto e moto elettriche per bambini dai 3 ai 12 anni."
        ],
        "fr": [
          "Établissement de restauration et de loisirs\nPizzas, crêpes, glaces, chichis, etc. \n1 terrasse intérieure chauffée 1 terrasse extérieure plein sud \n1 mini-golf 18 trous \n1 circuit de voitures et motos électriques pour les enfants de 3 à 12 ans."
        ],
        "es": [
          "Restauración y ocio\nPizzas, crepes, helados, chichis, etc.\n1 terraza interior climatizada 1 terraza exterior orientada al sur\n1 campo de minigolf de 18 hoyos\n1 circuito de coches y motos eléctricas para niños de 3 a 12 años."
        ],
        "nl": [
          "Catering en vrijetijdsvoorzieningen\nPizza's, crêpes, ijs, chichis, enz.\n1 verwarmd overdekt terras 1 buitenterras op het zuiden\n1 midgetgolfbaan met 18 holes\n1 elektrisch auto- en motorcircuit voor kinderen van 3 tot 12 jaar."
        ]
      },
      "@type": [
        "Description"
      ],
