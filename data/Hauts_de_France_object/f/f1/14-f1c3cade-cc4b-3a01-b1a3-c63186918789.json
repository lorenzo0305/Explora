  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c9e196aa-c84c-3c30-a0b1-cbdcce33ba27",
      "dc:description": {
        "de": [
          "Entdecken Sie die Ausstellung \"Libération, résistance, Ch De Gaulle\", die von der Stadt Angres, der Association des Collectionneurs des Timbres de la Libération und dem lokalen Verein Histoire et Mémoire d'Angres organisiert wurde."
        ],
        "en": [
          "Discover the exhibition \"Liberation, resistance, Ch De Gaulle\", organized by the City of Angres, the association of Liberation Stamp Collectors and the local association History and Memory of Angres."
        ],
        "it": [
          "Scoprite la mostra \"Libération, résistance, Ch De Gaulle\", organizzata dalla città di Angres, dall'associazione dei collezionisti di francobolli della Liberazione e dall'associazione locale Histoire et Mémoire d'Angres."
        ],
        "fr": [
          "Découvrez l'exposition \"Libération, résistance, Ch De Gaulle\", organisée par la Ville d'Angres, l'association des Collectionneurs des Timbres de la Libération et l'association locale Histoire et Mémoire d'Angres."
        ],
        "nl": [
          "Ontdek de tentoonstelling \"Libération, résistance, Ch De Gaulle\", georganiseerd door de stad Angres, de vereniging van postzegelverzamelaars van de bevrijding en de plaatselijke vereniging Histoire et Mémoire d'Angres."
        ],
        "es": [
          "Descubra la exposición \"Libération, résistance, Ch De Gaulle\", organizada por la ciudad de Angres, la asociación de Coleccionistas de Sellos de la Liberación y la asociación local Histoire et Mémoire d'Angres."
        ]
      },
