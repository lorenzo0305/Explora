  "rdfs:comment": {
    "de": [
      "Entdecke die architektonischen Details des Art déco in Douaisis, um dich inspirieren zu lassen und in einem Workshop deinen Mosaikuntersetzer zu gestalten.\nAb 6 Jahren."
    ],
    "en": [
      "Discover the Art Deco architectural details of the Douais region and get inspired to create your own mosaic coaster during a workshop.\nAges 6 and up."
    ],
    "it": [
      "Scoprite i dettagli architettonici Art Déco della regione di Douais e lasciatevi ispirare per creare il vostro sottobicchiere a mosaico durante un laboratorio.\nPer bambini dai 6 anni in su."
    ],
    "fr": [
      "Découvrez les détails architecturaux Art déco du Douaisis pour vous inspirer et réaliser votre dessous de verre en mosaïque lors d'un atelier.\nA partir de 6 ans."
    ],
    "nl": [
      "Ontdek de Art Deco architecturale details van de Douais regio en laat je inspireren om je eigen mozaïek onderzetter te maken tijdens een workshop.\nVoor kinderen vanaf 6 jaar."
    ],
    "es": [
      "Descubra los detalles arquitectónicos Art Déco de la región de Douais e inspírese para crear su propio posavasos de mosaico durante un taller.\nPara niños a partir de 6 años."
    ]
  },
