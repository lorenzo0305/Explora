  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ad5b5801-dd22-3c8a-aac1-cdd93e159598",
      "dc:description": {
        "de": [
          "Atmen Sie auf, Ihr Hotel-Restaurant ibis Styles ist im Bahnhof von Amiens angekommen! Als Eingangstor zum kommerziellen Herzen der Stadt empfängt Sie unser gesamtes Team für Ihren Aufenthalt mit der Familie oder aus beruflichen Gründen. Entdecken Sie das kleine Venedig des Nordens, seine Kathedrale und alle Reichtümer der Hauptstadt der Picardie."
        ],
        "en": [
          "Your ibis Styles hotel and restaurant has arrived at Amiens station! As the gateway to the city's commercial heart, our team welcomes you for your family or business stay. Come and discover the little Venice of the North, its cathedral and all the treasures of the Picardy capital."
        ],
        "it": [
          "Fate un bel respiro, il vostro hotel e ristorante ibis Styles è arrivato alla stazione di Amiens! Come porta d'accesso al cuore commerciale della città, tutto il nostro team vi accoglie per i vostri soggiorni in famiglia o per affari. Venite a scoprire la piccola Venezia del Nord, la sua cattedrale e tutti i tesori della capitale della Piccardia."
        ],
        "fr": [
          "Respirez, votre hôtel restaurant ibis Styles est arrivé en gare d'Amiens ! Porte d'entrée du coeur commerçant de la ville, toute notre équipe vous accueille pour vos séjours en famille ou à titre professionnel. Venez découvrir la petite Venise du Nord, sa cathédrale et toutes les richesses de la capitale picarde."
        ],
        "es": [
          "Tome aire, ¡su hotel y restaurante ibis Styles ha llegado a la estación de Amiens! Como puerta de entrada al corazón comercial de la ciudad, todo nuestro equipo le da la bienvenida para sus estancias familiares o de negocios. Venga a descubrir la pequeña Venecia del Norte, su catedral y todos los tesoros de la capital de Picardía."
        ],
        "nl": [
          "Haal adem, uw ibis Styles hotel en restaurant is aangekomen in het station van Amiens! Als toegangspoort tot het commerciële hart van de stad heet ons hele team u van harte welkom voor uw familie- of zakenverblijf. Kom en ontdek het kleine Venetië van het Noorden, zijn kathedraal en alle schatten van de Picardische hoofdstad."
        ]
      },
      "@type": [
        "Description"
      ],
