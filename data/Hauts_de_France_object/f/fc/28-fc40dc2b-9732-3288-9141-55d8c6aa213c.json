  "rdfs:comment": {
    "de": [
      "Das Gourmet-Restaurant \"Etangs des Moines\" liegt im Herzen des Waldes, gegenüber dem Teich \"Guinguette\" und neben einem Spielplatz. Es bietet Ihnen eine traditionelle französische Küche sowie regionale Gerichte mit den Aromen der Region Avesnois-Thiérache."
    ],
    "en": [
      "Located in the heart of the forest, in front of the \"Guinguette\" pond, next to a playground, the gastronomic restaurant of the \"Etangs des Moines\", offers you a traditional French cuisine as well as local cuisine, with the flavors of the Avesnois-Thiérache."
    ],
    "it": [
      "Situato nel cuore della foresta, di fronte allo stagno \"Guinguette\", accanto a un parco giochi, il ristorante gastronomico degli \"Etangs des Moines\" offre una cucina tradizionale francese e piatti locali, con i sapori della regione Avesnois-Thiérache."
    ],
    "fr": [
      "Situé au cœur de la forêt, en face de l'étang de la \"Guinguette\", à côté d'une aire de jeux, le restaurant gastronomique des \"Etangs des Moines\", vous propose une cuisine française traditionnelle ainsi que du terroir, aux saveurs de l'Avesnois-Thiérache."
    ],
    "es": [
      "Situado en el corazón del bosque, frente al estanque \"Guinguette\", junto a un parque infantil, el restaurante gastronómico de los \"Etangs des Moines\" ofrece cocina tradicional francesa y platos locales, con los sabores de la región de Avesnois-Thiérache."
    ],
    "nl": [
      "Het gastronomische restaurant van de \"Etangs des Moines\", gelegen in het hart van het bos, tegenover de vijver \"Guinguette\", naast een speeltuin, biedt zowel traditionele Franse gerechten als streekgerechten, met de smaken van de regio Avesnois-Thiérache."
    ]
  },
  "rdfs:label": {
