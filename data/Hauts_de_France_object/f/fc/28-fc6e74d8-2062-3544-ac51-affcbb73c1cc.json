  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt Ham, nicht weit von der Abteikirche Saint-Pierre entfernt, liegt der Park Délicourt aus dem Jahr 1878 mit seinem Wasserloch, seinen Bäumen und seiner Fauna."
    ],
    "en": [
      "Located in the heart of the town of Ham, not far from the Abbey Church of Saint-Pierre, the Parc Délicourt dates back to 1878. With its water feature, trees and wildlife, it's a great place to relax and have fun, with its playground."
    ],
    "it": [
      "Situato nel cuore della città di Ham, non lontano dalla chiesa abbaziale di Saint-Pierre, il Parc Délicourt risale al 1878 e vanta uno specchio d'acqua, alberi e animali selvatici che lo rendono un luogo ideale per rilassarsi e divertirsi con la sua area giochi."
    ],
    "fr": [
      "Situé en plein cœur de la ville de Ham, non loin de l'abbatiale Saint-Pierre, le parc Délicourt datant de 1878 avec son point d'eau, ses arbres et sa faune, est un lieu propice à la détente et à l'amusement avec son aire de jeux."
    ],
    "es": [
      "Situado en el corazón de la ciudad de Ham, no lejos de la abadía de Saint-Pierre, el parque Délicourt data de 1878 y cuenta con una fuente, árboles y fauna que lo convierten en un lugar ideal para relajarse y divertirse con su zona de juegos."
    ],
    "nl": [
      "Het Parc Délicourt ligt in het hart van de stad Ham, niet ver van de abdijkerk Saint-Pierre. Het dateert uit 1878 en heeft een waterpartij, bomen en wilde dieren, waardoor het een geweldige plek is om te ontspannen en plezier te maken met de speeltuin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc Délicourt"
    ]
  },
