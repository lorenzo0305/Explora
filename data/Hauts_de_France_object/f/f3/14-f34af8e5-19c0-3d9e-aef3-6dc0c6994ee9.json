  "rdfs:comment": {
    "de": [
      "Sie denken einfach, dass Sie sich eine ganz normale Show ansehen wollen, aber Sie haben keine Ahnung, worauf Sie sich da einlassen? Willkommen im Paradies!"
    ],
    "en": [
      "You think you've just come to see a show like any other, but you've no idea what you're getting yourself into... Welcome to Paradise!"
    ],
    "it": [
      "Pensate di essere venuti a vedere uno spettacolo come tutti gli altri, ma non avete idea di quello in cui vi state cacciando... Benvenuti in Paradiso!"
    ],
    "fr": [
      "Vous pensez simplement venir voir un spectacle comme les autres, mais vous n’imaginez pas un seul instant où vous mettez les pieds... Bienvenue au Paradis !"
    ],
    "nl": [
      "Je denkt dat je gewoon naar een show als alle andere komt kijken, maar je hebt geen idee waar je aan begint... Welkom in het paradijs!"
    ],
    "es": [
      "Crees que has venido a ver un espectáculo como cualquier otro, pero no tienes ni idea de dónde te estás metiendo... ¡Bienvenido al Paraíso!"
    ]
  },
  "rdfs:label": {
