  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a70a0d72-843e-3b77-b7a4-cf42b6187a87",
      "dc:description": {
        "de": [
          "Eine wunderschöne Inszenierung von Tierplüschtieren, die teilweise animiert sind, in einer winterlichen Umgebung, die die Augen der Kleinsten, aber sicher auch der Großen zum Leuchten bringen wird!"
        ],
        "en": [
          "A magnificent display of animal plush toys, some animated, in a wintry setting that will make the eyes of the youngest shine, but certainly those of the oldest too!"
        ],
        "it": [
          "Una magnifica esposizione di peluche di animali, alcuni dei quali animati, su uno sfondo invernale che farà brillare gli occhi di grandi e piccini!"
        ],
        "fr": [
          "Une magnifique mise en scène de peluches d’animaux, parfois animées, dans un décor hivernal qui fera briller les yeux des plus petits mais certainement des grands aussi !"
        ],
        "es": [
          "Un magnífico despliegue de peluches de animales, algunos de ellos animados, sobre un fondo invernal que seguro hará brillar los ojos de grandes y pequeños"
        ],
        "nl": [
          "Een prachtige tentoonstelling van pluchen dieren, waarvan sommige geanimeerd, tegen een winterse achtergrond die zeker zal schitteren in de ogen van jong en oud!"
        ]
      },
