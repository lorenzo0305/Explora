  "rdfs:comment": {
    "de": [
      "Ein freundlicher Empfang, verschiedene Cocktails, Biere und Pizzas, die Spezialität dieses Café-Restaurants, die Füße im Sand und die Terrasse in der Saison... Hier können Sie eine gute Zeit verbringen!"
    ],
    "en": [
      "Smiling welcome, varieties of cocktails, beers and pizzas for the specialty of this café restaurant, feet in the sand, enjoy the terrace in season ... What to spend a good time!"
    ],
    "it": [
      "Accoglienza sorridente, varietà di cocktail, birre e pizze per la specialità di questo caffè ristorante, piedi nella sabbia, godere della terrazza in stagione... Cosa c'è da fare per passare un bel momento!"
    ],
    "fr": [
      "Accueil souriant, variétés de cocktail, de bières et des pizzas pour la spécialité de ce café restaurant, les pieds dans le sable, profitez de la terrasse en saison... De quoi passer un bon moment!"
    ],
    "es": [
      "Sonriente bienvenida, variedad de cócteles, cervezas y pizzas para la especialidad de este café restaurante, los pies en la arena, disfrutar de la terraza en temporada... ¡Qué pasar un buen rato!"
    ],
    "nl": [
      "Glimlachende ontvangst, verscheidenheid aan cocktails, bieren en pizza's voor de specialiteit van dit café-restaurant, voeten in het zand, genieten van het terras in het seizoen... Wat een leuke tijd!"
    ]
  },
