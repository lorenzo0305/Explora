  "rdfs:comment": {
    "de": [
      "Genießen Sie den Charme und die Ruhe des Hotels Face à la Mer. Unser Hotel liegt direkt am Strand und garantiert Ihnen einen atemberaubenden Blick, sei es auf die Nordsee oder den Leuchtturm von Gravelines. Sie werden während Ihres Aufenthalts den direkten Zugang zum Strand von Gravelines und die zahlreichen vor Ort verfügbaren Aktivitäten zu schätzen wissen."
    ],
    "en": [
      "Enjoy the charm and calm of the hotel Face à la Mer. Located on the beach, our establishment guarantees you an unobstructed view of the North Sea and the Gravelines lighthouse. You will appreciate, during your stay, the direct access to the beach of Gravelines and the numerous activities available on the spot."
    ],
    "it": [
      "Godetevi il fascino e la tranquillità dell'hotel Face à la Mer. Situato sulla spiaggia, il nostro hotel vi garantisce una vista mozzafiato sul Mare del Nord e sul faro di Gravelines. Durante il vostro soggiorno, apprezzerete l'accesso diretto alla spiaggia di Gravelines e le numerose attività disponibili in loco."
    ],
    "fr": [
      "Profitez du charme et du calme de l'hôtel Face à la Mer. Situé en bord de plage, notre établissement vous garantit une vue imprenable, que ce soit sur la Mer du Nord ou le Phare de Gravelines. Vous apprécierez, durant votre séjour, de l'accès direct à la plage de Gravelines et des nombreuses activités disponibles sur place."
    ],
    "nl": [
      "Geniet van de charme en de rust van het hotel Face à la Mer. Ons hotel ligt aan het strand en garandeert u een adembenemend uitzicht op de Noordzee en de vuurtoren van Gravelines. Tijdens uw verblijf zult u de directe toegang tot het strand van Gravelines en de talrijke activiteiten ter plaatse op prijs stellen."
    ],
    "es": [
      "Disfrute del encanto y la tranquilidad del hotel Face à la Mer. Situado en la playa, nuestro hotel le garantiza una vista impresionante del Mar del Norte y del faro de Gravelines. Durante su estancia, apreciará el acceso directo a la playa de Gravelines y las numerosas actividades disponibles in situ."
    ]
  },
