      "dc:description": {
        "de": [
          "Das Schloss stammt aus dem 18. Jahrhundert. Jahrhundert. Es zeugt in seiner grünen Umgebung von der aristokratischen Vergangenheit der Gemeinde."
        ],
        "en": [
          "This château dates from the 18th century. It bears witness to the commune's aristocratic past in its verdant setting."
        ],
        "it": [
          "Questo castello risale al XVIII secolo. Immerso nel verde, testimonia il passato aristocratico del comune."
        ],
        "fr": [
          "Ce château date du XVIIIème siècle. Il témoigne, dans son écrin de verdure, du passé aristocratique de la commune."
        ],
        "es": [
          "Este castillo data del siglo XVIII. En medio de una vegetación exuberante, es testigo del pasado aristocrático del municipio."
        ],
        "nl": [
          "Dit kasteel dateert uit de 18e eeuw. Het ligt midden in het groen en getuigt van het aristocratische verleden van de gemeente."
        ]
      },
