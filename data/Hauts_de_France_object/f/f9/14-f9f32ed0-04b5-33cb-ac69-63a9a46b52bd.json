  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3675a6b-8671-3d2b-817c-197608e18f56",
      "dc:description": {
        "de": [
          "Ferme de Florincthun wird von Franck BOULY geleitet und bietet eine breite Palette an Produkten vom Bauernhof: Rind- und Schweinefleisch, Geflügel, Kuchen, Gemüse und Milchprodukte. Eine lokale Produktion in einem kurzen Kreislauf, der das landwirtschaftliche Know-how und die Frische der Produkte hervorhebt.Bestellungen sind per Telefon, SMS und E-Mail möglich."
        ],
        "en": [
          "Ferme de Florincthun, managed by Franck BOULY, offers a wide range of farm products: beef, pork, poultry, pies, vegetables and dairy products. Local production in a short circuit, highlighting agricultural know-how and the freshness of the products."
        ],
        "it": [
          "La Ferme de Florincthun, gestita da Franck BOULY, offre un'ampia gamma di prodotti agricoli: manzo, maiale, pollame, torte, verdure e prodotti caseari. È possibile ordinare per telefono, SMS o e-mail."
        ],
        "fr": [
          "Ferme de Florincthun, gérée par Franck BOULY, propose une large gamme de produits fermiers : viande bovine, porc, volailles, tartes, légumes et produits laitiers. Une production locale en circuit court, mettant en valeur le savoir-faire agricole et la fraîcheur des produits.Commande possible par téléphone, SMS et mail."
        ],
        "es": [
          "La Ferme de Florincthun, dirigida por Franck BOULY, ofrece una amplia gama de productos de granja: carne de vacuno, cerdo, aves, pasteles, verduras y productos lácteos. Se pueden hacer pedidos por teléfono, SMS o correo electrónico."
        ],
        "nl": [
          "Ferme de Florincthun, gerund door Franck BOULY, biedt een breed scala aan boerderijproducten: rundvlees, varkensvlees, gevogelte, taarten, groenten en zuivelproducten. Je kunt bestellen per telefoon, sms of e-mail."
        ]
      },
      "@type": [
        "Description"
