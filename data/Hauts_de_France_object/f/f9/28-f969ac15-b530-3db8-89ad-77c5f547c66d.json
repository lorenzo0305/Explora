  "rdfs:comment": {
    "de": [
      "Einhörner, Drachen, Greife oder Tiere mit magischen Kräften? Das Mittelalter ist voll von seltsamen und faszinierenden Kreaturen! Entdecke auf spielerische Weise das mittelalterliche Bestiarium und erschaffe deine eigene Wunderkreatur.\nInklusive Museumsbesuch für alle und einem kleinen Snack. Von 6 bis 12 Jahren - ein Erwachsener muss anwesend sein."
    ],
    "en": [
      "Unicorns, dragons, griffins or animals with magical powers? The Middle Ages were full of strange and fascinating creatures! Playfully discover the medieval bestiary and create your own marvellous creature.\nIncludes a visit to the museum and a snack. Ages 6 to 12 - adult supervision required."
    ],
    "it": [
      "Unicorni, draghi, grifoni o animali con poteri magici? Il Medioevo era pieno di creature strane e affascinanti! Scoprite il bestiario medievale in modo divertente e create la vostra meravigliosa creatura.\nInclude una visita al museo per tutti e una merenda. Età compresa tra i 6 e i 12 anni - deve essere accompagnato da un adulto."
    ],
    "fr": [
      "Licornes, dragons, griffons ou animaux aux pouvoirs magiques… Le Moyen Âge regorge de créatures étranges et fascinantes ! Découvre de manière ludique le bestiaire médiéval et crée ta propre créature merveilleuse. \nInclus la visite du musée pour tous et un petit goûter. De 6 à 12 ans- présence d'un adulte obligatoire."
    ],
    "es": [
      "¿Unicornios, dragones, grifos o animales con poderes mágicos? La Edad Media estaba llena de criaturas extrañas y fascinantes Descubre el bestiario medieval de forma divertida y crea tu propia criatura maravillosa.\nIncluye una visita al museo para todos y un tentempié. De 6 a 12 años - deben ir acompañados de un adulto."
    ],
    "nl": [
      "Eenhoorns, draken, griffioenen of dieren met magische krachten? De middeleeuwen zaten vol met vreemde en fascinerende wezens! Ontdek op een leuke manier het middeleeuwse bestiarium en maak je eigen wonderlijke wezen.\nInclusief een bezoek aan het museum voor iedereen en een snack. Van 6 tot 12 jaar - onder begeleiding van een volwassene."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier \"Bestiaire médiéval et animaux fantastiques\""
    ]
  },
