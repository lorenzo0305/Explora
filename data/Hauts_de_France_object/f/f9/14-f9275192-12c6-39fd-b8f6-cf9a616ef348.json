  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/486ced44-1f21-3268-b347-737585842c8c",
      "dc:description": {
        "de": [
          "Tiere wurden oft als eine Manifestation des Göttlichen angesehen und spielten im alten Ägypten eine wichtige Rolle. Wir werfen einen Blick auf ihre Geschichte."
        ],
        "en": [
          "Often considered a manifestation of the divine, animals played an essential role in ancient Egypt. Here's a look back at their history."
        ],
        "it": [
          "Spesso visti come manifestazione del divino, gli animali hanno svolto un ruolo essenziale nell'antico Egitto. Ecco uno sguardo alla loro storia."
        ],
        "fr": [
          "Souvent considérés comme une manifestation du divin, les animaux occupent une place essentielle dans l’Égypte ancienne. Retour sur leur histoire."
        ],
        "nl": [
          "Dieren werden vaak gezien als een manifestatie van het goddelijke en speelden een essentiële rol in het oude Egypte. Hier volgt een terugblik op hun geschiedenis."
        ],
        "es": [
          "A menudo considerados como una manifestación de lo divino, los animales desempeñaron un papel esencial en el antiguo Egipto. He aquí un repaso a su historia."
        ]
      },
