  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4f141470-28f6-3db5-b5ca-b1c8470b1a3b",
      "dc:description": {
        "de": [
          "brasserie-bar auf fort mahon, 300m vom strand entfernt\ntäglich von 11:30 bis 14:30 Uhr ( außer Donnerstag geschlossen) und am Wochenende von 11:00 bis 14:30 Uhr und von 18:30 bis 21:00 Uhr ( außer Sonntag) geöffnet\nfisch, Fleisch, Burger, alle frischen Produkte und hausgemachte Pommes frites?"
        ],
        "en": [
          "brasserie-bar on fort mahon, 300m from the beach\nopen daily from 11:30 a.m. to 2:30 p.m. (except Thursdays) and weekends from 11 a.m. to 2:30 p.m. and 6:30 p.m. to 9 p.m. (except Sundays)\nfish, meat, burgers, fresh produce and home fries?"
        ],
        "it": [
          "brasserie-bar a fort mahon, a 300 m dalla spiaggia\naperto tutti i giorni dalle 11.30 alle 14.30 (tranne il giovedì) e nei fine settimana dalle 11.00 alle 14.30 e dalle 18.30 alle 21.00 (tranne la domenica)\npesce, carne, hamburger, tutti prodotti freschi e patatine fritte?"
        ],
        "fr": [
          "brasserie-bar sur fort mahon, à 300m de la plage\nouvert tous les jours de 11h30 à 14h30 ( sauf jeudi fermé) et le week-end de 11h à 14h30 et de 18h30 à 21h ( sauf dimanche)\npoissons, viandes, burgers, tout produits frais et frites maison 🏠"
        ],
        "nl": [
          "brasserie-bar op fort mahon, 300m van het strand\ndagelijks geopend van 11.30 tot 14.30 uur (behalve donderdag) en in het weekend van 11.00 tot 14.30 uur en van 18.30 tot 21.00 uur (behalve zondag)\nvis, vlees, hamburgers, verse producten en huisgemaakte frietjes?"
        ],
        "es": [
          "brasserie-bar en fort mahon, a 300 m de la playa\nabierto todos los días de 11.30 a 14.30 (excepto jueves) y los fines de semana de 11.00 a 14.30 y de 18.30 a 21.00 (excepto domingos)\npescado, carne, hamburguesas, todos los productos frescos y patatas fritas caseras?"
        ]
      },
