  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6a7ac8af-53b6-321d-9163-cc018132a95f",
      "dc:description": {
        "de": [
          "Erleben Sie eine einzigartige kulinarische Erfahrung in Dünkirchen. Auf dem Schiff \"Princess Elisabeth\", dem Wahrzeichen der Operation Dynamo im Jahr 1940, entdecken Sie eine raffinierte Tafel in einem außergewöhnlichen Rahmen!"
        ],
        "en": [
          "Enjoy a unique culinary experience in Dunkirk. On the \"Princess Elisabeth\" boat, emblem of Operation Dynamo in 1940, come and discover a refined table in an exceptional setting!"
        ],
        "it": [
          "Godetevi un'esperienza culinaria unica a Dunkerque. Sulla nave Princess Elisabeth, emblema dell'operazione Dynamo nel 1940, venite a scoprire una tavola raffinata in un ambiente eccezionale!"
        ],
        "fr": [
          "Vivez une expérience culinaire unique à Dunkerque. Sur le bateau \"Princess Elisabeth\", emblème de l'Opération Dynamo en 1940, venez découvrir une table raffinée dans un cadre exceptionnel !"
        ],
        "nl": [
          "Geniet van een unieke culinaire ervaring in Duinkerke. Kom op de Princess Elisabeth boot, embleem van Operatie Dynamo in 1940, een verfijnde tafel ontdekken in een uitzonderlijk kader!"
        ],
        "es": [
          "Disfrute de una experiencia culinaria única en Dunkerque. En el barco Princess Elisabeth, emblema de la Operación Dinamo en 1940, ¡venga a descubrir una mesa refinada en un marco excepcional!"
        ]
      },
