    "de": [
      "Eine echte Brasserie-Atmosphäre für Tee und Gebäck mitten im Herzen der Oberstadt, schick!\n(100 Gedecke und 30 auf der Terrasse / Haustiere erlaubt)"
    ],
    "en": [
      "A real brasserie atmosphere for tea and pastries in the heart of the chic upper town!\n(100 covers and 30 on the terrace / pets allowed)"
    ],
    "it": [
      "Un'atmosfera da vera brasserie per una tazza di tè e un pasticcino nel cuore della città alta chic!\n(100 coperti e 30 sulla terrazza / animali ammessi)"
    ],
    "fr": [
      "Une vraie ambiance brasserie pour prendre un thé et une pâtisserie en plein cœur de la ville haute, chic !\n(100 couverts et 30 en terrasse / animaux acceptés)"
