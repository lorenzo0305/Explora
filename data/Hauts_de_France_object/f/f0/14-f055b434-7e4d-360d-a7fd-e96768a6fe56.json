  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/12d5c8ce-e5cb-3eb1-a074-e05c89d46384",
      "dc:description": {
        "de": [
          "Jahrhunderts erbaut und steht an der Stelle, an der Saint-Josse im 7. Jahrhundert einem blinden Mädchen auf wundersame Weise das Augenlicht zurückgegeben haben soll."
        ],
        "en": [
          "Built at the beginning of the 19th century, the chapel was erected on the spot where Saint-Josse miraculously restored sight to a young blind woman in the 7th century."
        ],
        "it": [
          "Costruita all'inizio del XIX secolo, la cappella fu eretta nel luogo in cui si dice che San Giuseppe abbia miracolosamente restituito la vista a una giovane donna cieca nel VII secolo."
        ],
        "fr": [
          "Construite au début du XIXème siècle, la chapelle est érigée à l'endroit où Saint-Josse aurait miraculeusement rendu la vue à une jeune aveugle au VIIème siècle."
        ],
        "nl": [
          "De kapel werd gebouwd aan het begin van de 19e eeuw op de plaats waar St. Jozef in de 7e eeuw op wonderbaarlijke wijze het gezichtsvermogen van een jonge blinde vrouw zou hebben hersteld."
        ],
        "es": [
          "Construida a principios del siglo XIX, la capilla se levantó en el lugar donde se dice que San José devolvió milagrosamente la vista a una joven ciega en el siglo VII."
        ]
      },
