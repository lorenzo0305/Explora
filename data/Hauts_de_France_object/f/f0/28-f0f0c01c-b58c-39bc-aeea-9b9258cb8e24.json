  "rdfs:comment": {
    "de": [
      "Willkommen im Freizeitkomplex von Beauvais!\n\nDer Speed Park in Beauvais empfängt Sie in einer 10.000 m² großen Anlage, die ganz den Freizeitaktivitäten gewidmet ist. Hier können Sie mit Ihrer Familie bowlen, Ihre Kollegen zu einem Kart-Rennen herausfordern, sich mit Ihren Freunden im Lasertag messen und vieles mehr"
    ],
    "en": [
      "Welcome to the Beauvais leisure complex!\n\nSpeed Park Beauvais welcomes you to its 10,000m² leisure complex. Come and enjoy a game of bowling with your family, challenge your colleagues to a go-kart race, take on your friends at laser tag and much more?"
    ],
    "it": [
      "Benvenuti nel complesso ricreativo di Beauvais!\n\nSpeed Park Beauvais vi dà il benvenuto nel suo complesso ricreativo di 10.000 m². Venite a godervi una partita a bowling con la vostra famiglia, a sfidare i vostri colleghi in una gara di go-kart, a sfidare i vostri amici al laser tag e molto altro ancora?"
    ],
    "fr": [
      "Bienvenue au complexe de loisirs de Beauvais !\n\nLe Speed Park de Beauvais vous accueille au sein d’un établissement de 10 000m² entièrement dédié aux loisirs. Venez partager une partie de bowling en famille, défier vos collègues lors d’une course de karting, affronter vos amis au laser game et bien plus encore…"
    ],
    "nl": [
      "Welkom in het recreatiecomplex van Beauvais!\n\nSpeed Park Beauvais verwelkomt je in zijn recreatiecomplex van 10.000 m². Kom genieten van een partijtje bowling met het gezin, daag je collega's uit voor een kartwedstrijd, neem het op tegen je vrienden bij het lasergamen en nog veel meer?"
    ],
    "es": [
      "Bienvenido al complejo de ocio de Beauvais\n\nSpeed Park Beauvais le da la bienvenida a su complejo de ocio de 10.000 m². Disfrute de una partida de bolos en familia, desafíe a sus colegas a una carrera de karts, enfréntese a sus amigos en el láser tag y mucho más.."
    ]
  },
