  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/729c1d2e-b798-3328-a64f-e62cdfa281dc",
      "dc:description": {
        "de": [
          "Bei Murat\nKebab / Tacos Restaurant seit 2004\nWir bieten Ihnen Kebab / Sandwiches / Teller / Gegrilltes / Vegetarisches / Kindermenü / Burger / Salate und natürlich Tacos\n\nTäglich außer mittwochs geöffnet."
        ],
        "en": [
          "Chez Murat\nKebab / Tacos restaurant since 2004\nWe offer kebabs / sandwiches / plates / grills / vegetarian / children's menu / burgers / salads and of course Tacos\n\nOpen every day except Wednesday."
        ],
        "it": [
          "Chez Murat\nRistorante Kebab / Tacos dal 2004\nOffriamo kebab / panini / piatti / grigliate / menu vegetariano / menu per bambini / hamburger / insalate e naturalmente Tacos\n\nAperto tutti i giorni tranne il mercoledì."
        ],
        "fr": [
          "Chez Murat\nRestaurant Kebab / Tacos depuis 2004 \nNous vous proposons des kebabs / sandwichs/ assiettes/ grillades/ végétarien/ menu enfant/ burgers/salades et bien-sûr des Tacos\n\nOuvert tous les jours sauf le mercredi."
        ],
        "es": [
          "Chez Murat\nKebab / Tacos restaurante desde 2004\nOfrecemos kebabs / bocadillos / platos / parrillas / vegetariano / menú infantil / hamburguesas / ensaladas y por supuesto Tacos\n\nAbierto todos los días excepto miércoles."
        ],
        "nl": [
          "Chez Murat\nKebab / Taco restaurant sinds 2004\nWij bieden kebab / sandwiches / plates / grills / vegetarisch / kindermenu / burgers / salades en natuurlijk Taco's\n\nElke dag geopend behalve woensdag."
        ]
      },
