  "rdfs:comment": {
    "de": [
      "Restaurant und Gourmetküche\nKapazität :\n60 Gedecke\n\nGeöffnet von Dienstag bis Freitag und am Samstagabend\n\nBesteckaufnahme von 12:00 bis 14:00 Uhr und von 19:30 bis 22:00 Uhr.\n\nDurchschnittspreis à la carte (Vorspeise + Hauptgericht + Dessert, ohne Getränke): 39,50 ? (mini) - 78 ? (maxi)\nMenüs am Mittag und Abend: 39,50 ? (außer Samstagabend)\n\nGruppen (im Salon): 8 bis 60 Gedecke - 7 zu privatisierende Säle von 10 bis 180 Gedecken.\n\nMetro Linie 2: Station 'Mairie de Lille'.\n\n \n\n "
    ],
    "en": [
      "Restaurant and gourmet cuisine\nCapacity :\n60 covers\n\nOpen Tuesday to Friday and Saturday evenings\n\nOpen from 12pm to 2pm and from 7:30pm to 10pm.\n\nAverage à la carte price (starter + main course + dessert, excluding drinks): 39.50 ? (minimum) - 78 ? (maximum)\nLunch and dinner menus: 39.50 ? (except Saturday evening)\n\nGroups (in lounge): 8 to 60 covers - 7 private rooms from 10 to 180 covers.\n\nMetro Line 2: 'Mairie de Lille' station.\n\n \n\n "
    ],
    "it": [
      "Ristorante e cucina gourmet\nCapacità :\n60 coperti\n\nAperto dal martedì al venerdì e il sabato sera\n\nMenu fisso dalle 12.00 alle 14.00 e dalle 19.30 alle 22.00.\n\nPrezzo medio alla carta (antipasto + piatto principale + dessert, bevande escluse): 39,50 € (minimo) - 78,00 € (massimo)\nMenu per pranzo e cena: 39,50 € (tranne il sabato sera)\n\nGruppi (in sala): da 8 a 60 coperti - 7 sale private da 10 a 180 coperti.\n\nLinea 2 della metropolitana: stazione \"Mairie de Lille\".\n\n \n\n "
    ],
    "fr": [
      "Restaurant et cuisine gastronomique\nCapacité : \n60 couverts\n\nOuvert du mardi au vendredi et le samedi soir\n\nPrise de couverts de 12h à 14h et de 19h30 à 22h.\n\nPrix moyen à la carte (entrée + plat + dessert, hors boissons) : 39,50 € (mini) - 78 € (maxi)\nMenus le midi et le soir : 39,50 € (sauf samedi soir)\n\nGroupes (en salon) : 8 à 60 couverts - 7 salles à privatiser de 10 à 180 couverts.\n\nMétro Ligne 2 : station 'Mairie de Lille'.\n\n \n\n "
    ],
    "es": [
      "Restaurante y cocina gastronómica\nCapacidad :\n60 cubiertos\n\nAbierto de martes a viernes y sábados por la noche\n\nMenús de 12h a 14h y de 19h30 a 22h.\n\nPrecio medio a la carta (entrante + plato principal + postre, bebidas excluidas): 39,50 euros (mínimo) - 78,00 euros (máximo)\nMenús de almuerzo y cena: 39,50 euros (excepto sábados por la noche)\n\nGrupos (en el salón): de 8 a 60 cubiertos - 7 salas privadas de 10 a 180 cubiertos.\n\nLínea 2 de metro: estación \"Mairie de Lille\".\n\n \n\n "
    ],
    "nl": [
      "Restaurant en gastronomische keuken\nCapaciteit :\n60 couverts\n\nGeopend van dinsdag tot vrijdag en zaterdagavond\n\nMenu's van 12.00 tot 14.00 uur en van 19.30 tot 22.00 uur.\n\nGemiddelde prijs à la carte (voorgerecht + hoofdgerecht + dessert, exclusief drank): €39,50 (minimum) - €78,00 (maximum)\nLunch- en dinermenu's: €39,50 (behalve zaterdagavond)\n\nGroepen (in de lounge): 8 tot 60 couverts - 7 privézalen voor 10 tot 180 couverts.\n\nMetrolijn 2: station 'Mairie de Lille'.\n\n \n\n "
    ]
  },
