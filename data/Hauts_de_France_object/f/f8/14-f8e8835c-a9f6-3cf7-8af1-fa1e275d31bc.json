      "dc:description": {
        "de": [
          "Stéphane Leleu bietet in seinem Betrieb den Verkauf von Schweinefleisch in 10-kg-Kisten, 1/4 Schwein oder 1/2 Schwein, Verkauf auch von Chipolatas."
        ],
        "en": [
          "Stéphane Leleu offers in his farm the sale of pork meat in 10 kg, 1/4 pork or 1/2 pork boxes, sale also of chipolatas."
        ],
        "it": [
          "Stéphane Leleu vende carne di maiale in scatole da 10 kg, 1/4 di maiale o 1/2 di maiale, e anche chipolatas."
        ],
        "fr": [
          "Stéphane Leleu propose dans son exploitation de la vente de viande de porc en caissette de 10 kg, 1/4 de porc ou 1/2 porc, vente également de chipolatas."
        ],
        "nl": [
          "Stéphane Leleu verkoopt varkensvlees in dozen van 10 kg, 1/4 varkensvlees of 1/2 varkensvlees, en ook chipolata's."
        ],
        "es": [
          "Stéphane Leleu vende carne de cerdo en cajas de 10 kg, 1/4 de cerdo o 1/2 de cerdo, y también chipolatas."
        ]
