  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f1593c70-f749-3222-b038-4290a5895de8",
      "dc:description": {
        "de": [
          "Eine warme Küche nach dem Vorbild der italienischen Trattorien - Etablissement Qualité Tourisme\nIm Restaurant Il Siderno können Sie die gute italienische Küche genießen, wie z. B. Panzerotti, Lasagne oder auch einige seiner Spezialitäten wie Schnitzel Calabrese, Schnitzel Voldostana oder Schnitzel Siderno."
        ],
        "en": [
          "A warm cuisine in the image of the Italian trattoria - Quality Tourism Establishment\nThe restaurant Il Siderno proposes you to taste the good Italian cooking as for example the panzerotti, the lasagne or some of its specialities such as the escalope calabrese, the escalope voldostana or the escalope Siderno."
        ],
        "it": [
          "Una cucina calda a immagine e somiglianza della trattoria italiana - Struttura turistica di qualità\nIl ristorante Il Siderno vi offre la possibilità di gustare la buona cucina italiana, come ad esempio i panzerotti, le lasagne o alcune delle sue specialità come la scaloppina calabrese, la scaloppina voldostana o la scaloppina di Siderno."
        ],
        "fr": [
          "Une cuisine chaleureuse à l'image des trattoria italiennes - Etablissement Qualité Tourisme\nLe restaurant Il Siderno vous propose de déguster la bonne cuisine italienne comme par exemple les panzerotti, les lasagnes ou encore quelques unes de ses spécialités telles que l'escalope calabrese, l'escalope voldostana ou encore l'escalope Siderno."
        ],
        "es": [
          "Una cocina cálida a imagen de la trattoria italiana - Establecimiento turístico de calidad\nEl restaurante Il Siderno te ofrece degustar la buena cocina italiana como por ejemplo los panzerotti, la lasaña o algunas de sus especialidades como el escalope calabrese, el escalope voldostana o el escalope Siderno."
        ],
        "nl": [
          "Een warme keuken naar het beeld van de Italiaanse trattoria - Kwaliteit Toerisme Instelling\nIn restaurant Il Siderno kunt u de goede Italiaanse keuken proeven, zoals bijvoorbeeld de panzerotti, de lasagne of enkele van zijn specialiteiten zoals de escalope calabrese, de escalope voldostana of de escalope Siderno."
        ]
      },
