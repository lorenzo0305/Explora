  "rdfs:comment": {
    "de": [
      "Die Stätten der Erinnerung an den Bergbau werden zur Feier der Heiligen Barbara in Flammen aufgehen!\nVon den \"Gueules noires\" (Schwarze Gesichter)."
    ],
    "en": [
      "Mining memorabilia is set ablaze to celebrate Sainte Barbe!\nBy the Gueules noires."
    ],
    "it": [
      "I cimeli minerari saranno incendiati per celebrare Sainte Barbe!\nDalle Gueules noires."
    ],
    "fr": [
      "Les hauts lieux de la mémoire minière vont s’enflammer pour célébrer Sainte Barbe !\nPar les Gueules noires."
    ],
    "es": [
      "¡Se prenderá fuego a objetos mineros para celebrar Sainte Barbe!\nPor las Gueules noires."
    ],
    "nl": [
      "Mijnmemorabilia worden in brand gestoken om Sainte Barbe te vieren!\nBij de Gueules noires."
    ]
  },
