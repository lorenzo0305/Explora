  "rdfs:comment": {
    "de": [
      "Die Vokalgruppe \"Si on chantait\" bietet Ihnen ihre Aufführung \"un air de vacances\" an, um Sie für die Dauer eines Konzerts in den Sommer zu versetzen. Ein geselliger Moment, den Sie unter Freunden, zu zweit oder mit der Familie verbringen können."
    ],
    "en": [
      "The vocal group \"Si on chantait\" offers you its show \"un air de vacances\" to project you for the time of a concert in summer. A convivial moment to spend with friends, couples or family."
    ],
    "it": [
      "Il gruppo vocale \"Si on chantait\" si esibirà con il suo spettacolo \"un air de vacances\", per riportarvi indietro nel tempo per un concerto estivo. Un momento conviviale da trascorrere con gli amici, in coppia o in famiglia."
    ],
    "fr": [
      "Le groupe vocal  \"Si on chantait\"  vous propose  son spectacle \"un air de vacances\" pour vous projeter le temps d'un concert en été. Un moment convivial à passer entre amis, en couple ou en famille."
    ],
    "es": [
      "El grupo vocal \"Si on chantait\" presentará su espectáculo \"un air de vacances\", para trasladarle al pasado en un concierto de verano. Un momento de convivencia para pasar con amigos, en pareja o en familia."
    ],
    "nl": [
      "De zanggroep \"Si on chantait\" zal hun show \"un air de vacances\" opvoeren, om je mee terug te nemen in de tijd voor een zomerconcert. Een gezellig moment om door te brengen met vrienden, met z'n tweeën of met het hele gezin."
    ]
  },
  "rdfs:label": {
    "fr": [
