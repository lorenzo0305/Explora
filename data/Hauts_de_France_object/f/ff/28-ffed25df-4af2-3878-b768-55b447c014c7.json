  "rdfs:comment": {
    "de": [
      "Auf dem Bauernhof erzeugte Produkte\n> BIO-Ziegenkäse: Frischkäse natur, mit Schnittlauch, Pfeffer, Schalotten, Pempa, Knoblauch und Petersilie, Kräuter der Provence, gereift und Tomme de chèvre (je nach Saison)\n> BIO-Ziegenjoghurt: Natur\n> Kuhjoghurt: Natur und mit Früchten"
    ],
    "en": [
      "Products of the farm \n> Organic goat cheese: fresh, with chives, pepper, shallots, pempa, garlic and parsley, herbes de Provence, matured and goat tomme (depending on the season)\n> Organic goat yoghurt: plain\n> Cow's milk yoghurt: plain and with fruit"
    ],
    "it": [
      "Prodotti dell'azienda agricola \n> Formaggio di capra biologico: fresco, con erba cipollina, pepe, scalogno, pempa, aglio e prezzemolo, herbes de Provence, stagionato e tomme di capra (a seconda della stagione)\n> Yogurt di capra biologico: semplice\n> Yogurt di latte vaccino: semplice e con frutta"
    ],
    "fr": [
      "Produits de la ferme : \n> fromages de chèvre BIO : frais nature, à la ciboulette, au poivre, à l'échalote, pempa, ail et persil, herbes de Provence, affiné et tomme de chèvre (selon la saison) \n> Yaourts de chèvre BIO : nature\n> Yaourts de vache : nature et aux fruits"
    ],
    "es": [
      "Productos de la granja \n> Queso de cabra ecológico: fresco, con cebollino, pimienta, chalotas, pempa, ajo y perejil, hierbas de Provenza, madurado y tomme de cabra (según la temporada)\n> Yogur de cabra ecológico: natural\n> Yogur de leche de vaca: natural y con fruta"
    ],
    "nl": [
      "Producten van de boerderij \n> Biologische geitenkaas: vers, met bieslook, peper, sjalotten, pempa, knoflook en peterselie, herbes de Provence, gerijpt en geitentomme (afhankelijk van het seizoen)\n> Biologische geitenyoghurt: puur\n> yoghurt van koemelk: puur en met fruit"
    ]
  },
