  "rdfs:comment": {
    "de": [
      "Cuir hinterfragt die Beziehungen zwischen Dominanz und Zustimmung, indem es pluralistische Bilder von Männlichkeit zwischen Liebe, Zärtlichkeit und Gewalt zeigt."
    ],
    "en": [
      "Cuir explores relationships of domination and consent, offering a range of images of masculinity, from love and tenderness to violence."
    ],
    "it": [
      "Cuir esplora i rapporti di dominazione e consenso, presentando una serie di immagini della mascolinità, dall'amore e dalla tenerezza alla violenza."
    ],
    "fr": [
      "Cuir interroge les rapports de domination et consentement, en proposant des images de masculinités plurielles, entre amour, tendresse et violence."
    ],
    "nl": [
      "Cuir verkent relaties van dominantie en instemming en presenteert een reeks beelden van mannelijkheid, van liefde en tederheid tot geweld."
    ],
    "es": [
      "Cuir explora las relaciones de dominación y consentimiento, presentando un abanico de imágenes de la masculinidad, desde el amor y la ternura hasta la violencia."
    ]
  },
