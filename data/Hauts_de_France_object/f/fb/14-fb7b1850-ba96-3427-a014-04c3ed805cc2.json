  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c4bfe103-80ce-369e-b6cd-cfde18683a5f",
      "dc:description": {
        "de": [
          "Entdeckung und Besuch des Bauernhofs und seiner Produktion im Boulonnais, vom Feld bis auf den Teller mit den Geschmacksrichtungen der Milch in Eiscreme.\nEducational farm / Pädagogischer Bauernhof / Educatieve boerderij"
        ],
        "en": [
          "Discovery and visit of the farm and its productions in the Boulonnais, from field to plate with the flavours of milk in ice cream.\nEducational farm / Pädagogischer Bauernhof / Educatieve boerderij"
        ],
        "it": [
          "Scoprite e visitate la fattoria e le sue produzioni nella regione del Boulonnais, dal campo al piatto, con i sapori del latte nel gelato.\nFattoria didattica / Pädagogischer Bauernhof / Educatieve boerderij"
        ],
        "fr": [
          "Découverte et visite de la ferme et de ses productions dans le Boulonnais, du champ à l'assiette avec les saveurs du lait en crème glacée.\nEducational farm / Pädagogischer Bauernhof / Educatieve boerderij"
        ],
        "nl": [
          "Ontdek en bezoek de boerderij en haar producties in de Boulonnais, van het veld tot het bord, met de smaken van melk in ijs.\nEducatieve boerderij / Pädagogischer Bauernhof / Educatieve boerderij"
        ],
        "es": [
          "Descubra y visite la granja y sus producciones en la región de Boulonnais, del campo al plato, con los sabores de la leche en helado.\nGranja pedagógica / Pädagogischer Bauernhof / Educatieve boerderij"
        ]
      },
      "@type": [
        "Description"
