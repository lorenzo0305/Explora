  "rdfs:comment": {
    "de": [
      "La table du jardinier bietet Ihnen eine kreative Küche mit Produkten aus der Region, Pflanzen und Blumen aus dem Garten: Rosensorbet, Rosmarinbrot, Kürbiscreme....."
    ],
    "en": [
      "The gardener's table offers you a creative cuisine based on local products, plants and flowers from the garden: rose sorbet, rosemary bread, pumpkin cream...."
    ],
    "it": [
      "La table du jardinier propone una cucina creativa a base di prodotti locali, piante e fiori del giardino: sorbetto alla rosa, pane al rosmarino, crema di zucca...."
    ],
    "fr": [
      "La table du jardinier vous propose une cuisine créative à base de produits du terroir, des plantes et fleurs du jardin : sorbet à la rose, pain au romarin, crème de potiron...."
    ],
    "es": [
      "La table du jardinier ofrece una cocina creativa basada en productos locales, plantas y flores del jardín: sorbete de rosas, pan de romero, crema de calabaza...."
    ],
    "nl": [
      "La table du jardinier biedt creatieve gerechten op basis van lokale producten, planten en bloemen uit de tuin: rozensorbet, rozemarijnbrood, pompoencrème...."
    ]
