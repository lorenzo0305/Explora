  "rdfs:comment": {
    "de": [
      "Treffpunkt Donnerstag, den 21. Mai um 20 Uhr in der Grange à Musique für ein haarsträubendes Rockkonzert mit IMPARFAIT, die Worte wie Pflastersteine werfen: ohne Filter, ohne Umwege, mit klarer Wut und dem Geschmack des Realen im Mund."
    ],
    "en": [
      "Rendezvous Thursday May 21st at 8pm at the Grange à Musique for a hair-raising rock concert with IMPARFAIT, a band who throw words around like cobblestones: unfiltered, straightforward, with lucid rage and a taste for the real thing."
    ],
    "it": [
      "Giovedì 21 maggio, alle ore 20.00, alla Grange à Musique, vi aspetta un concerto rock da far accapponare la pelle con gli IMPARFAIT, che scagliano le parole come pietre da spianare: senza filtri, senza peli sulla lingua, con una rabbia lucida e un gusto per la realtà."
    ],
    "fr": [
      "Rdv Jeudi 21 mai à 20h à la Grange à Musique pour un concert Rock décoiffant avec IMPARFAIT qui pose les mots comme on jette des pavés : sans filtre, sans détour, avec une rage lucide et le goût du réel en bouche."
    ],
    "es": [
      "Únase a nosotros el jueves 21 de mayo a las 20:00 h en la Grange à Musique para asistir a un concierto de rock espeluznante con IMPARFAIT, que lanzan palabras como adoquines: sin filtros, sin rodeos, con una rabia lúcida y un gusto por lo auténtico."
    ],
    "nl": [
      "Kom op donderdag 21 mei om 20.00 uur naar de Grange à Musique voor een huiveringwekkend rockconcert met IMPARFAIT, die met woorden smijten als straatstenen: ongefilterd, recht door zee, met heldere woede en een voorliefde voor het echte werk."
    ]
  },
