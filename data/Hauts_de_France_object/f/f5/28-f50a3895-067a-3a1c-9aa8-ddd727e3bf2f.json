  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2db2224a-b3aa-3daa-a6f0-2782a51ca05f",
      "dc:description": {
        "de": [
          "Asiatisches Restaurant mit japanischer und thailändischer Küche. Die Spezialität des Restaurants sind Gua Bao, japanische Dampfbrote, die cremig und weich im Mund sind, oder Poké Bowls für noch mehr Frische.\nSie können vor Ort essen oder Ihre Speisen mitnehmen, um sie zu Hause oder im Büro zu genießen."
        ],
        "en": [
          "Asian restaurant offering Japanese and Thai cuisine, with the restaurant's specialty gua bao, Japanese steamed breads that are smooth and soft in the mouth, or poké bowls for even more freshness.\nYou can dine in or take away to enjoy at home or at the office."
        ],
        "it": [
          "Ristorante asiatico di cucina giapponese e tailandese, la cui specialità è il gua bao, pane giapponese al vapore morbido e soffice al palato, o le poké bowls per una maggiore freschezza.\nÈ possibile mangiare all'interno del locale o portarlo via per gustarlo a casa o in ufficio."
        ],
        "fr": [
          "Restaurant asiatique vous proposant une cuisine japonaise, thaïlandaise où vous retrouverez la spécialité du restaurant les gua bao, les pains japonais cuits à la vapeur, onctueux et moelleux en bouche ou alors les poké bowls pour avoir encore plus de fraîcheur.\nVous pouvez vous restaurez sur place ou alors prendre à emporter pour déguster vos plats chez vous ou au bureau."
        ],
        "es": [
          "Restaurante asiático de cocina japonesa y tailandesa, cuya especialidad son los gua bao, panes japoneses al vapor, suaves y blandos en la boca, o los poké bowls, aún más frescos.\nSe puede comer en el restaurante o llevar para disfrutar en casa o en la oficina."
        ],
        "nl": [
          "Aziatisch restaurant met Japanse en Thaise keuken, met als specialiteit gua bao, gestoomd Japans brood dat zacht is in de mond, of poké bowls voor nog meer versheid.\nJe kunt hier eten of meenemen om thuis of op kantoor van te genieten."
        ]
      },
      "@type": [
        "Description"
      ],
