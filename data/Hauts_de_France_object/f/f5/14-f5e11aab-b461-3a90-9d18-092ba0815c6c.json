  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dde99001-8c1f-3aa0-9b4b-ff947b28ed94",
      "dc:description": {
        "de": [
          "Das Estaminet La Clef des Champs, 7 km von Saint-Omer entfernt und in der Nähe von La Coupole gelegen, empfängt Sie in einer warmen und freundlichen Umgebung. Der Küchenchef bietet Ihnen eine qualitativ hochwertige Küche, die aus lokalen Produkten zubereitet wird."
        ],
        "en": [
          "L'estaminet la Clef des Champs, located 7 km from Saint-Omer and close to the Coupole, welcomes you in a warm and friendly setting. The chef offers you a quality cuisine prepared with local products."
        ],
        "it": [
          "L'estaminet la Clef des Champs, situato a 7 km da Saint-Omer e vicino alla Coupole, vi accoglie in un ambiente caldo e accogliente. Lo chef propone una cucina di qualità a base di prodotti locali."
        ],
        "fr": [
          "L'estaminet la Clef des Champs, situé à 7 km de Saint-Omer et à proximité de la Coupole, vous accueille dans un cadre chaleureux et convivial. Le chef vous propose une cuisine de qualité élaborée avec des produits locaux."
        ],
        "nl": [
          "Het estaminet la Clef des Champs, gelegen op 7 km van Saint-Omer en dicht bij de Coupole, verwelkomt u in een warme en vriendelijke omgeving. De chef biedt een kwaliteitskeuken gemaakt met lokale producten."
        ],
        "es": [
          "El estaminet la Clef des Champs, situado a 7 km de Saint-Omer y cerca de la Coupole, le da la bienvenida en un entorno cálido y acogedor. El chef ofrece una cocina de calidad elaborada con productos locales."
        ]
      },
