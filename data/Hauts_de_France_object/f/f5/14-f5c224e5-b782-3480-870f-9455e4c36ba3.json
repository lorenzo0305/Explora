  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3bd80439-73d1-3ea0-b8b6-945137b66ad3",
      "dc:description": {
        "de": [
          "Laden für Rennräder, Mountainbikes und Elektrofahrräder von Seb & Nico von Opale Marathon VTT. Verkauf, Test, Verleih und Reparatur. Scott & Schnurrbart sind im Angebot sowie verschiedene Textilmarken und Zubehör."
        ],
        "en": [
          "Road, MTB and electric bike store by Seb & Nico d?Opale Marathon VTT. Sales, testing, rentals and repairs. Scott & moustache are featured, as well as several brands of textiles and accessories."
        ],
        "it": [
          "Negozio di biciclette da strada, MTB ed elettriche di Seb & Nico d'Opale Marathon VTT. Vendita, test, noleggio e riparazioni. Scott & moustache sono presenti, così come diverse marche di tessuti e accessori."
        ],
        "fr": [
          "Magasin de Vélo route, VTT et électrique par Seb & Nico d’Opale Marathon VTT. Vente, test, location et réparation. Scott & moustache sont à l’honneur ainsi que plusieurs marques de textiles et accessoires."
        ],
        "es": [
          "Tienda de bicicletas de carretera, BTT y eléctricas de Seb & Nico d'Opale Marathon VTT. Venta, pruebas, alquiler y reparaciones. Scott & bigote se ofrecen, así como varias marcas de textiles y accesorios."
        ],
        "nl": [
          "Racefiets-, MTB- en elektrische fietsenwinkel van Seb & Nico d?Opale Marathon VTT. Verkoop, testen, verhuur en reparaties. Scott & moustache zijn vertegenwoordigd, evenals diverse merken textiel en accessoires."
        ]
      },
      "@type": [
        "Description"
