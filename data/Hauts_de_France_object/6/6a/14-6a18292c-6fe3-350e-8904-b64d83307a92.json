  "rdfs:comment": {
    "de": [
      "Eine geschlossene Gesellschaft, in der Theater und Therapie aufeinandertreffen, in der sich Emotionen verbreiten und anstecken und Monster sich in Luft auflösen. Eine radikal kathartische Erfahrung."
    ],
    "en": [
      "An enclosed space where theater and therapy meet, where emotions are diffused and contaminated, and monsters evaporate. A radically cathartic experience."
    ],
    "it": [
      "Uno spazio chiuso dove teatro e terapia si incontrano, dove le emozioni si diffondono e si contaminano e i mostri evaporano. Un'esperienza radicalmente catartica."
    ],
    "fr": [
      "Un huis-clos où théâtre et thérapie se rejoignent, où les émotions se diffusent et se contaminent, et les monstres s’évaporent. Une expérience radicalement cathartique."
    ],
    "es": [
      "Un espacio cerrado donde teatro y terapia se dan la mano, donde las emociones se difunden y contaminan, y los monstruos se evaporan. Una experiencia radicalmente catártica."
