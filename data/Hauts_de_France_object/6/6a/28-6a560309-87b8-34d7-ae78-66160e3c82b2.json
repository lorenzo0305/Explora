      "rdfs:comment": {
        "de": [
          "Seit 40 Jahren ist Michel Huyghe Landwirt und Erzeuger von Chicorée und Erdbeeren. Verkauf vor Ort von Montag bis Freitag von 9 bis 12.30 Uhr und von 13.30 bis 18 Uhr, samstags von 9 bis 12.30 Uhr und dienstags auf dem Markt in Hondeghem."
        ],
        "en": [
          "Michel Huyghe has been farming endives and strawberries for 40 years. On-site sales Monday to Friday, 9am to 12:30pm and 1:30pm to 6pm, Saturday 9am to 12:30pm, and at the Hondeghem market on Tuesdays."
        ],
        "it": [
          "Michel Huyghe coltiva indivia e fragole da 40 anni. Vendita in loco dal lunedì al venerdì, dalle 9 alle 12.30 e dalle 13.30 alle 18, il sabato dalle 9 alle 12.30 e al mercato di Hondeghem il martedì."
        ],
        "fr": [
          "Depuis 40 ans, Michel Huyghe est agriculteur et producteur d'endives et de fraises. Vente sur place du lundi au vendredi de 9h à 12h30 et de 13h30 à 18h, le samedi de 9h à 12h30, et sur le marché d'Hondeghem le mardi."
        ],
        "nl": [
          "Michel Huyghe kweekt al 40 jaar andijvie en aardbeien. Verkoop ter plaatse van maandag tot vrijdag van 9u tot 12u30 en van 13u30 tot 18u, op zaterdag van 9u tot 12u30 en op dinsdag op de markt van Hondeghem."
        ],
        "es": [
          "Michel Huyghe cultiva endibias y fresas desde hace 40 años. Venta in situ de lunes a viernes de 9.00 a 12.30 y de 13.30 a 18.00, sábados de 9.00 a 12.30 y los martes en el mercado de Hondeghem."
        ]
      },
