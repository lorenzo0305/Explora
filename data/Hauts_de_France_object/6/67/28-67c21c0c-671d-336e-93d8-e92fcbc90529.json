  "rdfs:comment": {
    "de": [
      "Entdecken Sie L?Atelier de Marius, ein Restaurant in Beauvais, das sich auf bretonische Galettes spezialisiert hat, die nach einem traditionellen Rezept zubereitet werden. Hier genießen Sie eine authentische Küche, die mit lokalen Produkten zubereitet wird, in einer herzlichen Atmosphäre."
    ],
    "en": [
      "Come and discover L'Atelier de Marius, a restaurant in Beauvais specializing in traditional Breton galettes. Enjoy authentic cuisine, prepared with local produce in a warm and welcoming atmosphere."
    ],
    "it": [
      "Venite a scoprire L'Atelier de Marius, un ristorante di Beauvais specializzato in galettes tradizionali bretoni. Qui potrete gustare una cucina autentica a base di prodotti locali in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Venez découvrir L’Atelier de Marius, un restaurant situé à Beauvais, spécialisé dans les galettes bretonnes préparées selon une recette traditionnelle. Vous y dégusterez une cuisine authentique, élaborée avec des produits locaux dans une ambiance chaleureuse."
    ],
    "nl": [
      "Kom en ontdek L'Atelier de Marius, een restaurant in Beauvais dat gespecialiseerd is in traditionele Bretonse galettes. Je geniet er van authentieke gerechten, bereid met lokale producten in een warme en vriendelijke sfeer."
    ],
    "es": [
      "Descubra L'Atelier de Marius, un restaurante de Beauvais especializado en las tradicionales galettes bretonas. Aquí podrá disfrutar de una cocina auténtica elaborada con productos locales en un ambiente cálido y acogedor."
    ]
  },
