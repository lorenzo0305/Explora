  "rdfs:comment": {
    "de": [
      "Das Hotel Campanile Cuincy ist 10 Minuten vom Stadtzentrum und dem Bahnhof Douai und 25 km vom Flughafen Lille-Lesquin entfernt.  Sie finden hier ein Restaurant und einen Seminarraum. Das Hotel eignet sich für Geschäfts- und Urlaubsreisen."
    ],
    "en": [
      "The Campanile Cuincy hotel is located 10 minutes from the city center and the train station of Douai, 25 km from Lille-Lesquin airport.  You will find a restaurant and a seminar room, this hotel is suitable for business or tourist stays."
    ],
    "it": [
      "L'hotel Campanile Cuincy si trova a 10 minuti dal centro città e dalla stazione ferroviaria di Douai, a 25 km dall'aeroporto di Lille-Lesquin.  Dotato di un ristorante e di una sala per seminari, questo hotel è adatto a soggiorni di lavoro o di turismo."
    ],
    "fr": [
      "L'hôtel Campanile Cuincy est est situé à  10 min du centre-ville et de la gare de Douai, à  25 km de l'aéroport Lille-Lesquin.  Vous y trouverez un restaurant et une salle de séminaire, cet hôtel convient aux séjours d'affaires ou touristiques."
    ],
    "nl": [
      "Het hotel Campanile Cuincy ligt op 10 minuten van het stadscentrum en het treinstation van Douai, op 25 km van de luchthaven Lille-Lesquin.  Met een restaurant en een seminarruimte is dit hotel geschikt voor een zakelijk of toeristisch verblijf."
    ],
    "es": [
      "El hotel Campanile Cuincy está situado a 10 minutos del centro de la ciudad y de la estación de tren de Douai, a 25 km del aeropuerto de Lille-Lesquin.  Con un restaurante y una sala de seminarios, este hotel es adecuado para estancias de negocios o turismo."
    ]
  },
