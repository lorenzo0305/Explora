  "rdfs:comment": {
    "de": [
      "Die Kapelle von Moyenpont wurde während des Ersten Weltkriegs zerstört und 1925 originalgetreu wieder aufgebaut. Sie glänzt mit beeindruckenden Fresken des örtlichen Künstlers Émile Flamant."
    ],
    "en": [
      "Destroyed during the First World War, then rebuilt identically in 1925, the Chapelle de Moyenpont boasts impressive frescoes by local artist Émile Flamant."
    ],
    "it": [
      "Distrutta durante la Prima Guerra Mondiale e poi ricostruita identica nel 1925, la Chapelle de Moyenpont vanta impressionanti affreschi dell'artista locale Émile Flamant."
    ],
    "fr": [
      "Détruite lors de la Première Guerre Mondiale, puis reconstruite à l'identique en 1925, la Chapelle de Moyenpont brille par ses impressionnantes fresques de l'artiste local Émile Flamant."
    ],
    "es": [
      "Destruida durante la Primera Guerra Mundial y reconstruida idénticamente en 1925, la Chapelle de Moyenpont cuenta con impresionantes frescos del artista local Émile Flamant."
    ],
    "nl": [
      "De Chapelle de Moyenpont, die tijdens de Eerste Wereldoorlog werd verwoest en in 1925 op identieke wijze werd herbouwd, heeft indrukwekkende fresco's van de plaatselijke kunstenaar Émile Flamant."
    ]
  },
