  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/746ce2fe-09ae-33ad-b231-8a748be6c22a",
      "dc:description": {
        "de": [
          "Aufführung von Patois-Tänzen und Sketchen: \"Ch'a sint l'musi\"\n\nDas Centre Sports et Loisirs de Longfossé lädt Sie zu zwei Aufführungen in der Salle Polyvalente in Samer ein:\n\nPreis: 10?\nInformationen und Reservierungen: 03.21.83.00.20 oder csl62240@orange.fr\n\nKommen Sie und teilen Sie einen geselligen Moment und entdecken Sie unser lokales Kulturerbe."
        ],
        "en": [
          "Show of dances and patois sketches: \"Ch'a sint l'musi\"\n\nThe Centre Sports et Loisirs de Longfossé invites you to two performances at the Salle Polyvalente in Samer:\n\nPrice: 10?\nInformation and bookings: 03.21.83.00.20 or csl62240@orange.fr\n\nCome and share a convivial moment and discover our local heritage."
        ],
        "it": [
          "Spettacolo di danze e sketch patoisches: \"Ch'a sint l'musi\"\n\nIl Centre Sports et Loisirs di Longfossé vi invita a due spettacoli presso la Salle Polyvalente di Samer:\n\nPrezzo: 10?\nInformazioni e prenotazioni: 03.21.83.00.20 o csl62240@orange.fr\n\nVenite a condividere un momento di convivialità e a scoprire il nostro patrimonio locale."
        ],
        "fr": [
          "Spectacle de danses et de sketches patoisants : \"Ch'a sint l'musi\"\n\nLe Centre Sports et Loisirs de Longfossé vous invite à deux représentations à la Salle Polyvalente de Samer :\n\nPrix : 10€\nRenseignements et réservations : 03.21.83.00.20 ou csl62240@orange.fr\n\nVenez partager un moment convivial et découvrir notre patrimoine local."
        ],
        "nl": [
          "Show van dansen en patois sketches: \"Ch'a sint l'musi\"\n\nHet Centre Sports et Loisirs de Longfossé nodigt je uit voor twee voorstellingen in de Salle Polyvalente in Samer:\n\nPrijs: 10?\nInformatie en reserveringen: 03.21.83.00.20 of csl62240@orange.fr\n\nKom en deel een gezellig moment en ontdek ons lokale erfgoed."
        ],
        "es": [
          "Espectáculo de bailes y sketches patois: \"Ch'a sint l'musi\"\n\nEl Centre Sports et Loisirs de Longfossé le invita a dos espectáculos en la Salle Polyvalente de Samer:\n\nPrecio: 10?\nInformación y reservas: 03.21.83.00.20 o csl62240@orange.fr\n\nVenga a compartir un momento de convivencia y a descubrir nuestro patrimonio local."
        ]
      },
