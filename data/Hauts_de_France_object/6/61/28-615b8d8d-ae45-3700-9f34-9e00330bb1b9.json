  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Atmosphäre von O?Shaka, Ihrer hawaiianischen Oase der Ruhe in Beauvais. Genießen Sie unsere personalisierten Pokebowls, exotischen warmen Gerichte und die Gyoza-Bar. Ein tägliches Erlebnis für Ihren Gaumen!"
    ],
    "en": [
      "Immerse yourself in the atmosphere of O'Shaka, your Hawaiian haven in Beauvais. Enjoy our personalized pokebowls, exotic hot dishes and gyozas bar. A guaranteed escape for your taste buds, every day!"
    ],
    "it": [
      "Immergetevi nell'atmosfera di O'Shaka, il vostro rifugio hawaiano a Beauvais. Godetevi i nostri pokebowl personalizzati, i piatti caldi esotici e il bar di gyozas. Una fuga garantita per le vostre papille gustative, ogni giorno!"
    ],
    "fr": [
      "Plongez dans l’ambiance de O’Shaka, votre havre de paix hawaïen à Beauvais. Savourez nos pokebowls personnalisés, plats chauds exotiques et bar à gyozas. Évasion garantie pour vos papilles, chaque jour !"
    ],
    "es": [
      "Sumérjase en el ambiente de O'Shaka, su refugio hawaiano en Beauvais. Disfrute de nuestros pokebowls personalizados, nuestros exóticos platos calientes y nuestro bar de gyozas. Una escapada garantizada para sus papilas gustativas, ¡todos los días!"
    ],
    "nl": [
      "Dompel jezelf onder in de sfeer van O'Shaka, jouw Hawaïaanse toevluchtsoord in Beauvais. Geniet van onze gepersonaliseerde pokebowls, exotische warme gerechten en gyozas bar. Een gegarandeerde ontsnapping voor uw smaakpapillen, elke dag!"
    ]
  },
