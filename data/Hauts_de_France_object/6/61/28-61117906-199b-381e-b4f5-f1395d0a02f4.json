  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ca5ba96a-62a5-39d3-afb5-ab64d4b2ee62",
      "dc:description": {
        "de": [
          "Diesen Monat läuft der Film \"Beetlejuice Beetlejuice\" (von Tim Burton, 2024) im Kino!\n\nEine Vorstellung der Communauté de Communes du Chemin des Dames in Zusammenarbeit mit CinéPop?\n\nWir treffen uns um 20 Uhr im Pavillon von Vauclair! (Dauer: ~ 2 Stunden / mit Reservierung / für alle Altersgruppen)"
        ],
        "en": [
          "This month, the film \"Beetlejuice Beetlejuice\" (by Tim Burton, 2024) is in theatres!\n\nPresented by the Communauté de Communes du Chemin des Dames in collaboration with CinéPop?\n\nRV at Pavillon de Vauclair at 8pm! (duration: ~ 2h / booking required / all audiences)"
        ],
        "it": [
          "Questo mese esce \"Beetlejuice Beetlejuice\" (di Tim Burton, 2024)!\n\nUna proiezione organizzata dalla Communauté de Communes du Chemin des Dames in associazione con CinéPop?\n\nCi vediamo al Pavillon de Vauclair alle 20.00! (durata: ~ 2 ore / prenotazione obbligatoria / aperto a tutti)"
        ],
        "fr": [
          "Ce mois-ci, retrouvez à l’affiche le film \"Beetlejuice Beetlejuice\" (de Tim Burton, 2024) !\n\nUne séance proposée par la Communauté de Communes du Chemin des Dames en collaboration avec CinéPop…\n\nRV au Pavillon de Vauclair à 20h ! (durée : ~ 2h / sur réservation / tout public)"
        ],
        "es": [
          "Este mes se estrena \"Beetlejuice Beetlejuice\" (de Tim Burton, 2024)\n\nProyección organizada por la Communauté de Communes du Chemin des Dames en asociación con CinéPop?\n\nNos vemos en el Pavillon de Vauclair a las 20:00 h (duración: ~ 2 horas / reserva obligatoria / abierto a todos)"
        ],
        "nl": [
          "Deze maand verschijnt \"Beetlejuice Beetlejuice\" (van Tim Burton, 2024)!\n\nEen voorstelling georganiseerd door de Communauté de Communes du Chemin des Dames in samenwerking met CinéPop?\n\nTot ziens in het Pavillon de Vauclair om 20u! (duur: ~ 2 uur / reserveren verplicht / open voor iedereen)"
        ]
      },
