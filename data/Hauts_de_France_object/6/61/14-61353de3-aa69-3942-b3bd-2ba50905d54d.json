  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/16041059-d733-3de7-a1fc-d78e1060dd96",
      "dc:description": {
        "de": [
          "Entdecken Sie diese Ausstellung zur Geschichte des Sports und des Olympismus in Pas-de-Calais auf dem Place de l'Hôtel de Ville (Rathausplatz).\n\nOrganisiert von den Archives Départementales du Pas-de-Calais"
        ],
        "en": [
          "Discover this exhibition dedicated to the history of sport and Olympism in Pas-de-Calais on the Place de l'Hôtel de Ville.\n\nOrganized by the Archives Départementales du Pas-de-Calais"
        ],
        "it": [
          "Scoprite questa mostra dedicata alla storia dello sport e dell'olimpismo nel Pas-de-Calais sulla Place de l'Hôtel de ville.\n\nOrganizzata dall'Archivio dipartimentale del Pas-de-Calais"
        ],
        "fr": [
          "Découvrez cette exposition consacrée à l'histoire du sport et l'olympisme dans le Pas-de-Calais sur la Place de l’Hôtel de ville.\n\nOrganisée par les Archives Départementales du Pas-de-Calais"
        ],
        "nl": [
          "Ontdek deze tentoonstelling gewijd aan de geschiedenis van sport en Olympisme in Pas-de-Calais op de Place de l'Hôtel de ville.\n\nGeorganiseerd door de departementale archieven van Pas-de-Calais"
        ],
        "es": [
          "Descubra esta exposición dedicada a la historia del deporte y del olimpismo en el Pas-de-Calais, en la plaza del Hôtel de Ville.\n\nOrganizada por los Archivos Departamentales de Pas-de-Calais"
        ]
      },
