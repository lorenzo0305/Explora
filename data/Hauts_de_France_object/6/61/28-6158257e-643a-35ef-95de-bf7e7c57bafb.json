  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00af0080-8201-3445-9ce5-46d530e78754",
      "dc:description": {
        "de": [
          "Zum Mittag- oder Abendessen können Sie das Restaurant Ihres Hotels Campanile Douai - Cuincy besuchen. Beginnen Sie Ihren Tag mit dem All-you-can-eat-Frühstücksbuffet und lassen Sie sich dann zum Mittag- und/oder Abendessen mit leckeren Gerichten verwöhnen. Bei schönem Wetter können Sie Ihr Essen auch auf unserer Terrasse genießen."
        ],
        "en": [
          "For lunch or dinner, discover the Restaurant of your hotel Campanile Douai - Cuincy. Start your day with our all-you-can-eat breakfast buffet, followed by a tasty lunch and/or dinner. You can also enjoy your meal on our terrace in fine weather."
        ],
        "it": [
          "Per il pranzo o la cena, scoprite il ristorante del vostro hotel Campanile Douai - Cuincy. Iniziate la giornata con la nostra colazione a buffet a volontà, seguita da un gustoso pranzo e/o cena. Quando il tempo lo permette, potete anche gustare i vostri pasti sulla nostra terrazza."
        ],
        "fr": [
          "Pour le déjeuner ou le dîner, découvrez le Restaurant de votre hôtel Campanile Douai - Cuincy. Commencez votre journée avec le buffet petit déjeuner à volonté puis enchaînez avec le déjeuner et/ou le dîner pour des plats savoureux. Vous pourrez également profiter de votre repas sur notre terrasse lors des beaux jours."
        ],
        "es": [
          "Para comer o cenar, descubra el Restaurante de su hotel Campanile Douai - Cuincy. Comience el día con nuestro desayuno buffet libre, seguido de un sabroso almuerzo y/o cena. También puede disfrutar de su comida en nuestra terraza cuando hace buen tiempo."
        ],
        "nl": [
          "Ontdek voor lunch of diner het restaurant van je hotel Campanile Douai - Cuincy. Begin je dag met ons all-you-can-eat ontbijtbuffet, gevolgd door een smakelijke lunch en/of diner. Bij mooi weer kunt u ook op ons terras genieten van uw maaltijd."
        ]
      },
      "@type": [
        "Description"
      ],
