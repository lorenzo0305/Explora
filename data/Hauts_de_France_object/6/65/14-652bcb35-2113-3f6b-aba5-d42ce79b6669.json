  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/13f5ea0d-5f64-3c3c-a8ae-e25a23226f08",
      "dc:description": {
        "de": [
          "Tauchen Sie ein in die Geschichte von Boulogne-sur-Mer! Erleben Sie die großen Momente unserer Stadt in einem grandiosen Spektakel, das in der wunderschönen Kathedrale inszeniert wird. Epochengerechte Kostüme, betörende Musik und Lichteffekte werden Sie durch die Jahrhunderte führen."
        ],
        "en": [
          "Immerse yourself in the history of Boulogne-sur-Mer! Relive the great moments of our city through a grandiose show staged in the magnificent cathedral. Period costumes, spellbinding music and lighting effects will transport you back through the centuries."
        ],
        "it": [
          "Immergetevi nella storia di Boulogne-sur-Mer! Rivivete i grandi momenti della nostra città attraverso un grandioso spettacolo allestito nella magnifica cattedrale. I costumi d'epoca, le musiche accattivanti e gli effetti di luce vi trasporteranno indietro nei secoli."
        ],
        "fr": [
          "Plongez au cœur de l'histoire de Boulogne-sur-Mer ! Revivez les grands moments de notre ville à travers un spectacle grandiose mis en scène dans la magnifique cathédrale. Costumes d'époque, musiques envoûtantes et jeux de lumière vous transporteront à travers les siècles."
        ],
        "es": [
          "¡Sumérjase en la historia de Boulogne-sur-Mer! Reviva los grandes momentos de nuestra ciudad a través de un grandioso espectáculo escenificado en la magnífica catedral. Trajes de época, música cautivadora y efectos de iluminación le transportarán a través de los siglos."
        ],
        "nl": [
          "Dompel jezelf onder in de geschiedenis van Boulogne-sur-Mer! Beleef de grote momenten van onze stad opnieuw in een grandioze show in de prachtige kathedraal. Periodieke kostuums, betoverende muziek en lichteffecten voeren je door de eeuwen heen."
        ]
      },
      "@type": [
        "Description"
      ],
