  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0a0d24ce-fba7-36ac-b1fd-3211ee34b6b0",
      "dc:description": {
        "de": [
          "Das Bully on Rocks hat sich zu einem wichtigen Festival der Rockszene in der Region Hauts de France entwickelt. Ein internationales Programm und eine freundliche Atmosphäre werden Ihren Abend zum Kochen bringen!"
        ],
        "en": [
          "Bully on Rocks has become an important festival on the Hauts de France rock scene. An international line-up and a friendly atmosphere that will set your evening alight!"
        ],
        "it": [
          "Il Bully on Rocks è diventato uno dei principali festival della scena rock degli Hauts de France. Con la sua line-up internazionale e l'atmosfera amichevole, è sicuro di infiammare la vostra serata!"
        ],
        "fr": [
          "Le Bully on Rocks est devenu un Festival important de la scène rock des Hauts de France. Une programmation internationale et une ambiance conviviale qui va enflammer votre soirée !"
        ],
        "es": [
          "Bully on Rocks se ha convertido en uno de los principales festivales de rock de los Altos de Francia. Con su cartel internacional y su ambiente acogedor, ¡seguro que la noche te va a encantar!"
        ],
        "nl": [
          "Bully on Rocks is uitgegroeid tot een belangrijk festival in de rockscene van de Hauts de France. Met zijn internationale line-up en gemoedelijke sfeer zal het je avond zeker in vuur en vlam zetten!"
        ]
      },
