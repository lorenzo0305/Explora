  "rdfs:comment": {
    "de": [
      "In einer grünen, ländlichen Umgebung am Rande des Thure-Tals, nur zwei Kilometer von der belgischen Grenze zu Grandrieux entfernt, befindet sich diese Einrichtung, die ein Café, ein Restaurant und ein Museum beherbergt."
    ],
    "en": [
      "In a green country setting on the edge of the Thure Valley, two steps from the Belgian border with Grandrieux, this establishment houses a café, a restaurant and a museum."
    ],
    "it": [
      "In un ambiente verde di campagna ai margini della Valle del Thure, a pochi passi dal confine belga con Grandrieux, questa struttura ospita un caffè, un ristorante e un museo."
    ],
    "fr": [
      "Dans un cadre champêtre verdoyant des abords de la Vallée de la Thure, à deux de là frontière Belge avec Grandrieux, cet établissement abrite un café, un restaurant et un musée."
    ],
    "nl": [
      "In een groene landelijke omgeving aan de rand van de Thurevallei, op een steenworp afstand van de Belgische grens met Grandrieux, herbergt dit etablissement een café, een restaurant en een museum."
    ],
    "es": [
      "En un entorno campestre y verde, al borde del valle del Thure, a dos pasos de la frontera belga con Grandrieux, este establecimiento alberga un café, un restaurante y un museo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Rando Nord - Restaurant du musée de la douane"
    ]
  },
