  "rdfs:comment": {
    "de": [
      "Das Instrument besteht aus 50 Glocken und wird automatisch oder durch die Fäuste des Glockenspielers zum Leben erweckt. Bis heute ist es eines der schönsten Glockenspiele Frankreichs."
    ],
    "en": [
      "With 50 bells, the instrument is animated automatically or under the fists of the carillonneur. To this day it is one of the most beautiful carillons in France."
    ],
    "it": [
      "Con 50 campane, lo strumento è animato automaticamente o dai pugni del carillonneur. Oggi è uno dei più bei carillon di Francia."
    ],
    "fr": [
      "Comportant 50 cloches, l'instrument s'anime automatiquement ou sous les poings du carillonneur. A ce jour il est l'un des plus beaux carillons de France."
    ],
    "nl": [
      "Met 50 klokken wordt het instrument automatisch of onder de vuisten van de beiaardier bespeeld. Tegenwoordig is het een van de mooiste beiaarden van Frankrijk."
    ],
    "es": [
      "Con 50 campanas, el instrumento se anima automáticamente o mediante los puños del carillonero. Hoy es uno de los carillones más bellos de Francia."
    ]
  },
