  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Tür dieses Estaminets mit seiner warmen und familiären Atmosphäre. Probieren Sie auf dem Land typische Gerichte der Region wie flämische Karbonade oder Welsh."
    ],
    "en": [
      "Push open the door of this estaminet with its warm, family atmosphere. In the countryside, enjoy typical regional dishes such as Flemish carbonade or Welsh."
    ],
    "it": [
      "Aprite la porta di questo estaminet dall'atmosfera calda e familiare. In campagna, gustate i piatti tipici regionali come la carbonade fiamminga o il gallese."
    ],
    "fr": [
      "Poussez la porte de cet estaminet à l'ambiance chaleureuse et familiale. À la campagne, dégustez des plats typiques de la région comme la carbonade flamande ou le Welsh."
    ],
    "nl": [
      "Duw de deur open van dit estaminet met zijn warme, familiale sfeer. Geniet op het platteland van typische streekgerechten zoals Vlaamse carbonade of Welsh."
    ],
    "es": [
      "Abra la puerta de este estaminet de ambiente cálido y familiar. En el campo, disfrute de platos típicos regionales como la carbonada flamenca o la galesa."
    ]
  },
