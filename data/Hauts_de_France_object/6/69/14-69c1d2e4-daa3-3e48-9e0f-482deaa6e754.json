      "dc:description": {
        "de": [
          "3-Sterne-Hotel, 50 Zimmer mit Seminarraum und traditionellem Restaurant, das ausschließlich frische, hausgemachte Produkte verwendet. Bar. Kostenlose unbegrenzte Breitband-Fibre für alle unsere Gäste."
        ],
        "en": [
          "3 star hotel, 50 rooms with seminar room and traditional restaurant only with fresh homemade products. Bar. Unlimited broadband fiber free for all our customers."
        ],
        "it": [
          "Hotel a 3 stelle, 50 camere con sala per seminari e ristorante tradizionale con prodotti freschi fatti in casa. Bar. Banda larga illimitata e gratuita per tutti i nostri ospiti."
        ],
        "fr": [
          "Hôtel 3 étoiles, 50 chambres avec salle de séminaire et restaurant traditionnel uniquement en produits frais fait maison. Bar. Fibre Haut Débit illimité gratuit pour tous nos clients."
        ],
        "es": [
          "Hotel de 3 estrellas, 50 habitaciones con sala de seminarios y restaurante tradicional con sólo productos caseros frescos. Bar. Banda ancha ilimitada y gratuita para todos nuestros huéspedes."
        ],
        "nl": [
          "3 sterren hotel, 50 kamers met seminarieruimte en traditioneel restaurant met uitsluitend verse huisgemaakte producten. Bar. Onbeperkt gratis breedband voor al onze gasten."
        ]
      },
