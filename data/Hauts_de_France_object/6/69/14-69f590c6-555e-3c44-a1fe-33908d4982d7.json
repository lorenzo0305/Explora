  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9376f647-0c7c-317f-a64d-7973a7780690",
      "dc:description": {
        "de": [
          "Das Komitee umfasst alle Kriegsveteranen, Kriegsgefangenen, Inhaber des Titels \"Titre de Reconnaissance de la Nation\", Witwen von verstorbenen Kriegsveteranen, Fahnenträger und Teilnehmer an Außenoperationen."
        ],
        "en": [
          "The committee brings together all veterans, prisoners of war, holders of the Titre de Reconnaissance de la Nation, widows of deceased veterans, flag bearers and participants in overseas operations."
        ],
        "it": [
          "Il comitato riunisce tutti i veterani, i prigionieri di guerra, i titolari del Titre de Reconnaissance de la Nation, le vedove dei veterani deceduti, i portabandiera e i partecipanti alle operazioni all'estero."
        ],
        "fr": [
          "Le comité regroupe tous les Anciens Combattants, Prisonniers de Guerre, les titulaires du Titre de Reconnaissance de la Nation, les Veuves d'anciens combattants décédés, les portes drapeaux, les participants aux Opérations Extérieures."
        ],
        "nl": [
          "Het comité brengt alle veteranen, krijgsgevangenen, houders van de Titre de Reconnaissance de la Nation, weduwen van overleden veteranen, vaandeldragers en deelnemers aan overzeese operaties samen."
        ],
        "es": [
          "El comité reúne a todos los veteranos, prisioneros de guerra, titulares del Titre de Reconnaissance de la Nation, viudas de veteranos fallecidos, abanderados y participantes en operaciones en el extranjero."
        ]
      },
      "@type": [
        "Description"
