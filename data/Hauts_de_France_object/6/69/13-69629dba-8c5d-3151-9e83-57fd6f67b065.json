  "rdfs:comment": {
    "de": [
      "Der älteste Teil ist der der Wirtschaftsgebäude mit einem Karrentor, das mit einem Wappen, einer Muschel und vor allem mit einem Datum versehen ist: 1695."
    ],
    "en": [
      "The oldest part is that of the outbuildings, with a carriage entrance featuring a coat of arms, a shell and, above all, a date: 1695."
    ],
    "it": [
      "La parte più antica è quella degli annessi, con un ingresso carrabile che reca uno stemma, una conchiglia e, soprattutto, una data: 1695."
    ],
    "fr": [
      "La partie la plus ancienne est celle des communs avec une porte charretière dotée d'un blason, d'une coquille et surtout d'une date : 1695."
    ],
    "es": [
      "La parte más antigua es la de las dependencias, con una entrada para carruajes que lleva un escudo, una concha y, sobre todo, una fecha: 1695."
    ],
    "nl": [
      "Het oudste deel is dat van de bijgebouwen, met een koetspoort met een wapenschild, een schelp en vooral een datum: 1695."
    ]
  },
