  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a55bd6ae-2e4f-3862-a3bd-22319dc10451",
      "dc:description": {
        "de": [
          "3-TAGES-KURSE\nKatamaran ab 10 Jahren + Optimist ab 8 Jahren + Windsurfen ab 13 Jahren für alle 3-Tages-Kurse entweder von Montag bis Mittwoch oder von Donnerstag bis Samstag\nKatamaran ab 14 Jahren und Erwachsene von Montag bis Mittwoch\nJolle ab 12 Jahren und Erwachsene von Donnerstag bis Samstag\n14 3-Tages-Kurse 5H/TAG je nach Gezeitenzeit"
        ],
        "en": [
          "3 DAY COURSES\nCatamaran from 10 years old + Optimist from 8 years old + Windsurf from 13 years old for all 3-day courses from Monday to Wednesday or from Thursday to Saturday\nCatamaran from 14 years and adults from Monday to Wednesday\nDinghy from 12 years and adults from Thursday to Saturday\n14 3-day courses 5H/DAY according to tide times"
        ],
        "it": [
          "CORSI DI 3 GIORNI\nCatamarano a partire da 10 anni + Optimist a partire da 8 anni + Windsurf a partire da 13 anni per tutti i corsi di 3 giorni dal lunedì al mercoledì o dal giovedì al sabato\nCatamarano da 14 anni e adulti da lunedì a mercoledì\nDinghy a partire da 12 anni e adulti da giovedì a sabato\n14 corsi di 3 giorni 5H/GIORNO a seconda degli orari delle maree"
        ],
        "fr": [
          "STAGES 3 JOURS\nCatamaran à partir de 10 ans + Optimist à partir de 8 ans + Planche à voile à partir de 13 ans pour tous les stages de 3 jours soit du lundi au mercredi soit du Jeudi au Samedi\nCatamaran à partir de 14 ans et adulte du lundi au mercredi\nDériveur à partir de 12 ans et adulte du jeudi au Samedi\n14 Stages de 3 jours 5H/JOUR suivant les heures de marée"
        ],
        "es": [
          "CURSOS DE 3 DÍAS\nCatamarán a partir de 10 años + Optimist a partir de 8 años + Windsurf a partir de 13 años para todos los cursos de 3 días de lunes a miércoles o de jueves a sábado\nCatamarán a partir de 14 años y adultos de lunes a miércoles\nVela ligera a partir de 12 años y adultos de jueves a sábado\n14 cursos de 3 días 5H/DÍA en función de las mareas"
        ],
        "nl": [
          "3 DAAGSE CURSUSSEN\nCatamaran vanaf 10 jaar + Optimist vanaf 8 jaar + Windsurf vanaf 13 jaar voor alle 3-daagse cursussen van maandag t/m woensdag of van donderdag t/m zaterdag\nCatamaran vanaf 14 jaar en volwassenen van maandag tot woensdag\nDinghy vanaf 12 jaar en volwassenen van donderdag tot zaterdag\n14 3-daagse cursussen 5u/dag afhankelijk van de getijden"
        ]
      },
