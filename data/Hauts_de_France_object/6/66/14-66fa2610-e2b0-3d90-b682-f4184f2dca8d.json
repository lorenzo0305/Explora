  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e7c318c0-b551-31ba-a3fb-9a5eda575db2",
      "dc:description": {
        "de": [
          "Marine SAS ist ein Unternehmen, das sich auf die Verarbeitung und Vermarktung von Meeresfrüchten spezialisiert hat. Es bietet frischen Fisch und Schalentiere von den Fischauktionen in Boulogne-sur-Mer mit anerkanntem lokalem Know-how an."
        ],
        "en": [
          "Marine SAS specializes in the processing and marketing of seafood products, offering fresh fish and shellfish from the Boulogne-sur-Mer auctions with recognized local know-how."
        ],
        "it": [
          "Marine SAS è un'azienda specializzata nella lavorazione e commercializzazione di prodotti ittici, che offre pesce fresco e crostacei provenienti dalle aste di Boulogne-sur-Mer con una riconosciuta esperienza locale."
        ],
        "fr": [
          "Marine SAS est une entreprise spécialisée dans la transformation et la commercialisation de produits de la mer, proposant poissons et crustacés frais issus des criées de Boulogne-sur-Mer avec un savoir-faire local reconnu."
        ],
        "nl": [
          "Marine SAS is een bedrijf dat gespecialiseerd is in de verwerking en marketing van vis-, schaal- en schelpdierproducten en biedt verse vis en schaaldieren van de veilingen van Boulogne-sur-Mer met erkende lokale expertise."
        ],
        "es": [
          "Marine SAS es una empresa especializada en la transformación y comercialización de productos del mar, que ofrece pescado y marisco fresco procedente de las lonjas de Boulogne-sur-Mer con una reconocida experiencia local."
        ]
      },
      "@type": [
        "Description"
