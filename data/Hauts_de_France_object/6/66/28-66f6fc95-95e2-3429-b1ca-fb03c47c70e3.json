  "rdfs:comment": {
    "de": [
      "Wanderung und Trail durch den Wald, vorbei an der Abtei, bei den Blockhäusern der Maginot-Linie und zurück durch die Gießereien von Sougland."
    ],
    "en": [
      "Hike and trail through the forest, past the abbey, near the Maginot Line blockhouses and back via the Sougland Foundries."
    ],
    "it": [
      "Escursione e percorso nella foresta, passando davanti all'abbazia, vicino ai blocchi della Linea Maginot e ritornando attraverso le fonderie Sougland."
    ],
    "fr": [
      "Randonnée et trail à travers la forêt, passage devant l'abbaye, près des blockhaus de la ligne Maginot et retour par les Fonderies de Sougland."
    ],
    "nl": [
      "Wandel en trek door het bos, langs de abdij, vlakbij de Maginotlinie-blockhouses en keer terug via de Sougland-gieterijen."
