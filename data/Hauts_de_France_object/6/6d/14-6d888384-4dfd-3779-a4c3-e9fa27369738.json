  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c19cd40f-a5cc-3496-b60d-3ec4492de080",
      "dc:description": {
        "de": [
          "Das Flobarts Conservatory beherbergt die Holzboote, von denen das älteste aus dem Jahr 1931 stammt und ausschließlich mit Segeln ausgestattet ist."
        ],
        "en": [
          "The flobarts conservatory houses wooden boats, the oldest of which dates back to 1931 and is exclusively sail-powered."
        ],
        "it": [
          "Il conservatorio dei flobarts ospita barche in legno, la più antica delle quali risale al 1931 ed è esclusivamente a vela."
        ],
        "fr": [
          "Le conservatoire des flobarts abrite les bateaux en bois dont le plus ancien date de 1931 et est exclusivement à voiles."
        ],
        "es": [
          "El conservatorio de flobarts alberga embarcaciones de madera, la más antigua de las cuales data de 1931 y está propulsada exclusivamente a vela."
        ],
        "nl": [
          "De flobarts serre herbergt houten boten, waarvan de oudste dateert uit 1931 en uitsluitend door zeilen wordt aangedreven."
        ]
      },
