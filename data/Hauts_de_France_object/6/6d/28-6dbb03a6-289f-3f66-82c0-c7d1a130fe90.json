  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e5c4d2d1-068a-3851-adad-55fa65db0c74",
      "dc:description": {
        "de": [
          "Förderung des Radsports\nAusbildung von jungen Radfahrern,\nEinführung, Training, Teilnahme und Organisation von Wettbewerben.\n- Minimes und Kadetten im Juni.\n- Cyclo-cross im November.\n- Marsch des Pokals der Region Hauts de France\n(Radsportschule, Jugend, Elite und Profis)"
        ],
        "en": [
          "Promotion of the sport of cycling\nTraining of young cyclists,\nInitiation, training, participation and organization of competitions.\n- Minimes and cadets in June.\n- Cyclo-cross in November.\n- Walk of the cup of Hauts de France\n(cycling school, youth, elite and professionals)"
        ],
        "it": [
          "Promozione dello sport del ciclismo\nFormazione di giovani ciclisti,\nAvvio, formazione, partecipazione e organizzazione di gare.\n? Minime e cadetti a giugno.\n? Ciclocross a novembre.\n? Passeggiata di Coppa degli Hauts de France\n(scuola di ciclismo, giovani, élite e professionisti)"
        ],
        "fr": [
          "Promotion du sport Cycliste\nFormation de jeunes cyclistes,\nInitiation, entrainement, participation et organisations de compétitions.\n– Minimes et cadets en juin.\n– Cyclo-cross en novembre.\n– Marche de la coupe des Hauts de France\n(école de vélo, jeunes, élite et professionnels)"
        ],
        "es": [
          "Promoción del deporte del ciclismo\nFormación de jóvenes ciclistas,\nIniciación, formación, participación y organización de competiciones.\n? Mínimos y cadetes en junio.\n? Ciclocross en noviembre.\n? Marcha de la Copa Hauts de France\n(escuela de ciclismo, jóvenes, élite y profesionales)"
        ],
        "nl": [
          "Bevordering van de wielersport\nOpleiding van jonge fietsers,\nInitiatie, opleiding, deelname en organisatie van wedstrijden.\n- Minimes en cadetten in juni.\n- Veldrijden in november.\n- Wandeling voor de Beker van de Hauts de France\n(wielerschool, jeugd, elite en professionals)"
        ]
      },
