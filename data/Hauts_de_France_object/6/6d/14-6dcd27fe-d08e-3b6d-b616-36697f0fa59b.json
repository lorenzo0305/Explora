  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/07d2fd46-5fbc-3529-8055-328af18f6e86",
      "dc:description": {
        "de": [
          "Fitnessbereich von 10:00 bis 12:00 Uhr\nTreffpunkt Salle des sports mit einem Handtuch und Wasser.\nAnmeldung im Tourismusbüro erforderlich.\n Ab 16 Jahren mit elterlicher Erlaubnis.\n3 Euro pro Person."
        ],
        "en": [
          "Fitness area from 10am to 12pm\nMeet at the Salle des Sports with towel and water.\nRegistration required at the Tourist Office.\n Over 16s with parental consent.\n3 euros per person."
        ],
        "it": [
          "Area fitness dalle 10.00 alle 12.00\nRitrovo nel Palazzetto dello Sport, portare un asciugamano e acqua.\nRegistrazione obbligatoria presso l'Ufficio del Turismo.\n Per i maggiori di 16 anni con autorizzazione dei genitori.\n3 euro a persona."
        ],
        "fr": [
          "Espace Fitness de 10h à 12h\nRendez-vous Salle des sports avec une serviette et de l'eau. \nInscription indispensable à l'Office de Tourisme.\n A partir de 16 ans avec autorisation parentale. \n3 euros par personne."
        ],
        "es": [
          "Área de fitness de 10:00 a 12:00\nCita en el polideportivo, llevar toalla y agua.\nImprescindible inscribirse en la Oficina de Turismo.\n Mayores de 16 años con autorización paterna.\n3 euros por persona."
        ],
        "nl": [
          "Fitnessruimte van 10.00 tot 12.00 uur\nVerzamelen in de sporthal, neem een handdoek en water mee.\nAanmelden is noodzakelijk bij het toeristenbureau.\n Ouder dan 16 jaar met toestemming van de ouders.\n3 euro per persoon."
        ]
      },
      "@type": [
        "Description"
