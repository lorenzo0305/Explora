  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5df49519-27c5-3c96-beb2-fe48812582a6",
      "dc:description": {
        "de": [
          "Diese Aufführung ist ein Repertoire an Geschichten \"speziell für Weihnachten\". Es enthält Geschichten aus kalten Ländern, die vom Schnee erzählen und manchmal sogar von einem gewissen Vater... Pssst, wir wollen nicht alles verraten."
        ],
        "en": [
          "This show is a repertoire of \"special Christmas\" tales. It's a collection of stories from cold countries, about snow and sometimes even a certain Father... Hush, we mustn't reveal everything."
        ],
        "it": [
          "Questo spettacolo è un repertorio di racconti \"speciali\" sul Natale. Riunisce storie di paesi freddi, sulla neve e a volte anche su un certo Padre... Silenzio, non dobbiamo rivelare tutto."
        ],
        "fr": [
          "Ce spectacle est un répertoire de contes « spécial noël ». Il regroupe des histoires venant de pays froids, parlant de la neige et évoquant même parfois un certain père... Chut, il ne faut pas tout révéler."
        ],
        "es": [
          "Este espectáculo es un repertorio de cuentos \"especiales de Navidad\". Reúne historias de países fríos, sobre la nieve y, a veces, incluso sobre un tal Padre... Silencio, no debemos revelarlo todo."
        ],
        "nl": [
          "Deze show is een repertoire van \"speciale kerstverhalen\". Het brengt verhalen uit koude landen, over sneeuw en soms zelfs een zekere Vader... Stil, we mogen niet alles verklappen."
        ]
      },
