      "@id": "https://data.datatourisme.fr/0f1e4c19-1914-3be1-bc92-cb639630f8b1",
      "dc:description": {
        "de": [
          "Das interkommunale Schwimmbad in Ecuires ist ein Wassersportzentrum mit Wellness- und Fitnessbereich:\n- schwimmen ;\n- wellness ;\n- fitness ;\n- krafttraining ;\n- sauna ;\n-  hammam;\n- wassergymnastik ;\n- aquabike."
        ],
        "en": [
          "The Ecuires intercommunal swimming pool is an aquatic center with a wellness and fitness area:\n- swimming ;\n- well-being ;\n- fitness ;\n- weight training ;\n- sauna ;\n-  steam room ;\n- aquagym ;\n- aquabike."
        ],
        "it": [
          "La piscina intercomunale Ecuires è un centro acquatico con area benessere e fitness:\n- nuoto ;\n- benessere ;\n- fitness ;\n- allenamento con i pesi ;\n- sauna\n-  bagno turco ;\n- acquagym ;\n- aquabike."
        ],
        "fr": [
          "La piscine intercommunale d'Ecuires est un centre aquatique avec espace bien-être et remise en forme : \n- natation ;\n- bien-être ; \n- fitness ;\n- musculation ;\n- sauna ;\n-  hammam ; \n- aquagym ;\n- aquabike."
        ],
        "es": [
          "La piscina intercomunal Ecuires es un centro acuático con zona de bienestar y fitness:\n- natación ;\n- bienestar ;\n- fitness ;\n- musculación ;\n- sauna\n-  sala de vapor ;\n- aquagym ;\n- aquabike."
        ],
        "nl": [
          "Het gemeenschappelijke zwembad Ecuires is een aquacentrum met een wellness- en fitnessruimte:\n- zwemmen ;\n- welzijn ;\n- fitness ;\n- krachttraining ;\n- sauna\n-  stoombad ;\n- aquagym ;\n- aquafiets."
        ]
      },
