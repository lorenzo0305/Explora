      "dc:description": {
        "de": [
          "Vortrag von Laurence Moignon\nMitglied des Centre d'Etudes Napoléoniennes\nMittwoch, den 5. Februar um 18.30 Uhr\nEmpfang ab 18 Uhr - Freier Eintritt - Mitgliedschaft vor Ort möglich"
        ],
        "en": [
          "Lecture by Laurence Moignon\nMember of the Centre d'Etudes Napoléoniennes\nWednesday, February 5 at 6:30 pm\nWelcome from 6pm - Free admission - Membership available on site"
        ],
        "it": [
          "Conferenza di Laurence Moignon\nMembro del Centro di studi napoleonici\nMercoledì 5 febbraio alle 18.30\nAccoglienza a partire dalle 18.00 - Ingresso libero - Iscrizione disponibile in loco"
        ],
        "fr": [
          "Conférence de Laurence Moignon \nMembre du Centre d'Etudes Napoléoniennes \nMercredi 5 février  à 18h30\nAccueil dès 18h - Entrée libre - Adhésion possible sur place"
        ],
        "nl": [
          "Lezing door Laurence Moignon\nLid van het Centrum voor Napoleontische Studies\nWoensdag 5 februari om 18.30 uur\nOntvangst vanaf 18u - Gratis toegang - Lidmaatschap ter plaatse verkrijgbaar"
        ],
        "es": [
          "Conferencia de Laurence Moignon\nMiembro del Centro de Estudios Napoleónicos\nMiércoles 5 de febrero a las 18.30 h\nRecepción a partir de las 18.00 h - Entrada gratuita - Membresía disponible in situ"
        ]
      },
