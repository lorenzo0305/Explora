      "@id": "https://data.datatourisme.fr/b2bc5da5-e190-31b7-9aaf-1b705ce20f79",
      "dc:description": {
        "de": [
          "Im Radisson Blu Grand Hotel & Spa Malo Les Bains empfängt Sie das Restaurant l'Opale mit schmackhafter lokaler Küche sowie einer großen Auswahl an Weinen und Bieren."
        ],
        "en": [
          "Inside the Radisson Blu Grand Hotel & Spa Malo Les Bains, the Opale restaurant serves tasty local cuisine and a wide variety of wines and beers."
        ],
        "it": [
          "All'interno del Radisson Blu Grand Hotel & Spa Malo Les Bains, il ristorante Opale serve una gustosa cucina locale e un'ampia scelta di vini e birre."
        ],
        "fr": [
          "A l’intérieur du Radisson Blu Grand Hotel & Spa Malo Les Bains, le restaurant l’Opale vous accueille pour une cuisine locale savoureuse ainsi qu'une grande variété de vins et de bières."
        ],
        "nl": [
          "In het Radisson Blu Grand Hotel & Spa Malo Les Bains serveert het restaurant Opale smakelijke lokale gerechten en een breed scala aan wijnen en bieren."
        ],
        "es": [
          "Dentro del Radisson Blu Grand Hotel & Spa Malo Les Bains, el restaurante Opale sirve sabrosa cocina local y una amplia gama de vinos y cervezas."
        ]
      },
