  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4d76b87a-34c8-30a2-8d82-cdeb47d2ea91",
      "dc:description": {
        "de": [
          "Die Bouillon de l'Impératrice Eugénie ist ein unumgänglicher Ort in der Geschichte von Roubaix. Das im Herzen des Stadtzentrums gelegene Brasserierestaurant bietet Ihnen die Möglichkeit, sich in einem eleganten Rahmen mit der Familie, Freunden oder Geschäftspartnern zu treffen und traditionelle, einfache, aber qualitativ hochwertige Gerichte zu genießen."
        ],
        "en": [
          "Le Bouillon de l'Impératrice Eugénie is a landmark in the history of Roubaix. Situated in the heart of the city center, the brasserie restaurant offers an elegant setting for families, friends or business meetings to enjoy traditional, simple yet high-quality cuisine."
        ],
        "it": [
          "Le Bouillon de l'Impératrice Eugénie è un punto di riferimento nella storia di Roubaix. Situato nel cuore del centro città, il ristorante brasserie offre un ambiente elegante per famiglie, amici o riunioni di lavoro per gustare una cucina tradizionale, semplice ma di alta qualità."
        ],
        "fr": [
          "Le Bouillon de l'Impératrice Eugénie est un lieu incontournable de l'Histoire de Roubaix. Situé en plein cœur du centre-ville, le restaurant brasserie vous propose de vous retrouver dans un cadre élégant, en famille, entre amis ou pour un rendez-vous d'affaire, autour d'une cuisine traditionnelle, simple mais de qualité."
        ],
        "nl": [
          "Le Bouillon de l'Impératrice Eugénie is een mijlpaal in de geschiedenis van Roubaix. Het brasserie-restaurant ligt in het hart van het stadscentrum en biedt een elegante omgeving voor families, vrienden of zakelijke bijeenkomsten om te genieten van traditionele, eenvoudige maar hoogwaardige gerechten."
        ],
        "es": [
          "Le Bouillon de l'Impératrice Eugénie es un hito en la historia de Roubaix. Situado en pleno centro de la ciudad, el restaurante brasserie ofrece un marco elegante para que familias, amigos o reuniones de negocios disfruten de una cocina tradicional, sencilla pero de gran calidad."
        ]
      },
