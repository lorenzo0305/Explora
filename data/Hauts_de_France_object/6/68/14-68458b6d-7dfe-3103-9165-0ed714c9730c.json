  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c18a5707-7d35-3c48-bbad-8f8bb730263f",
      "dc:description": {
        "de": [
          "Das Brot wird ohne chemische Behandlung über dem Holzfeuer gebacken.\nDie Bäckerei ist dienstags bis samstags von 6.00 bis 19.00 Uhr und sonntags von 6.00 bis 13.00 Uhr geöffnet."
        ],
        "en": [
          "The bread is baked over a wood fire without any chemical treatment.\nThe bakery is open Tuesday to Saturday from 6am to 7pm and Sunday from 6am to 1pm."
        ],
        "it": [
          "Il pane è cotto a legna senza alcun trattamento chimico.\nIl panificio è aperto dal martedì al sabato dalle 6.00 alle 19.00 e la domenica dalle 6.00 alle 13.00."
        ],
        "fr": [
          "Le pain est cuit au feu de bois sans aucun traitement chimique.\nLa boulangerie est ouverte du mardi au samedi de 6H à 19H et le dimanche de 6H à 13H."
        ],
        "nl": [
          "Het brood wordt gebakken boven een houtvuur zonder enige chemische behandeling.\nDe bakkerij is geopend van dinsdag tot en met zaterdag van 6.00 tot 19.00 uur en op zondag van 6.00 tot 13.00 uur."
        ],
        "es": [
          "El pan se cuece al fuego de leña sin ningún tratamiento químico.\nLa panadería abre de martes a sábado de 6:00 a 19:00 y los domingos de 6:00 a 13:00."
        ]
      },
