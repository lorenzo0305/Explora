  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c51af1ce-3945-30c8-acc4-ba3c700e7fac",
      "dc:description": {
        "de": [
          "Dieser Park beherbergt einen Kiosk, Spielplätze, Rasenflächen, die durch halbwegs stabile Wege aufgelockert werden, und eine Boulebahn. Dieser Garten genießt das Gütesiegel für behindertengerechten Zugang."
        ],
        "en": [
          "This park houses a kiosk, playgrounds, lawns embellished by semi-stabilized paths and a bowling alley. This garden bénéﬁcie of the label of accessibility for the disabled."
        ],
        "it": [
          "Il parco è dotato di un chiosco, aree gioco, prati con sentieri semi-stabilizzati e un campo da bocce. Il giardino ha ottenuto il marchio di accesso per i disabili."
        ],
        "fr": [
          "Ce parc abrite un kiosque, des aires de jeux, des pelouses agrémentées par des chemins semi-stabilisés et un boulodrome. Ce jardin bénéﬁcie du label d’accessibilité aux handicapés."
        ],
        "nl": [
          "Het park heeft een kiosk, speeltuinen, gazons met semi-gestabiliseerde paden en een jeu de boules baan. De tuin heeft het label voor toegankelijkheid voor gehandicapten gekregen."
        ],
        "es": [
          "El parque cuenta con un quiosco, zonas de juego, césped con caminos semiestabilizados y una bolera. El jardín ha recibido la etiqueta de acceso para discapacitados."
        ]
      },
      "@type": [
        "Description"
