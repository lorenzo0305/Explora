  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e1102efa-eab1-3a59-88ea-f6836f4fb7a3",
      "dc:description": {
        "de": [
          "Aquaterra lädt Sie in die Mediathek La Boussole in Montigny-en-Gohelle ein, um spielerisch die Wissenschaft zu entdecken. Wissenschaftliche Beobachtungen und Experimente in aller Sicherheit erwarten Sie in diesem Workshop."
        ],
        "en": [
          "Aquaterra invites you to the La Boussole media library in Montigny-en-Gohelle to have fun discovering science. Scientific observations and safe experiments await you during this workshop."
        ],
        "it": [
          "Aquaterra vi invita alla biblioteca multimediale La Boussole di Montigny-en-Gohelle per scoprire la scienza in modo divertente. Osservazioni scientifiche ed esperimenti in tutta sicurezza vi aspettano durante questo laboratorio."
        ],
        "fr": [
          "Aquaterra vous donne rendez-vous à la médiathèque la Boussole de Montigny-en-Gohelle pour découvrir les sciences en s’amusant. Des observations scientifiques et des expériences en toute sécurité vous attendent au cours de cet atelier."
        ],
        "nl": [
          "Aquaterra nodigt je uit in de mediatheek La Boussole in Montigny-en-Gohelle om op een leuke manier kennis te maken met wetenschap. Wetenschappelijke observaties en experimenten in alle veiligheid staan je te wachten tijdens deze workshop."
        ],
        "es": [
          "Aquaterra le invita a la biblioteca multimedia La Boussole de Montigny-en-Gohelle para descubrir la ciencia de forma lúdica. Observaciones científicas y experimentos con total seguridad te esperan durante este taller."
        ]
      },
