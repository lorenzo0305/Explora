  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e11c94ba-84ec-373a-b786-d4f87109c2c3",
      "dc:description": {
        "de": [
          "O Jardin Paisible ist ein 4000 m2 großer, englisch inspirierter Privatgarten am Ufer des Flusses Planquette in Fressin. Mehr als tausend verschiedene Pflanzen sind hier vergesellschaftet. Die Seele des Gartens liegt in den Bäumen. Eine friedliche Pause in der Nähe des Wasserspiegels lädt zur Ruhe ein. Dieser Ort ist von den Jardins Haut de France anerkannt und mit dem Label Qualité Tourisme ausgezeichnet."
        ],
        "en": [
          "O Jardin Paisible is a private garden of 4000 m2, of English inspiration, located on the banks of the Planquette in Fressin. More than a thousand different plants are associated with it. The soul of the garden rests on the trees. A peaceful break near the water invites you to relax. This site has been approved by the Jardins Haut de France and has been awarded the Qualité Tourisme label."
        ],
        "it": [
          "O Jardin Paisible è un giardino privato di 4000 m2, di ispirazione inglese, situato sulle rive della Planquette a Fressin. Vi sono associate più di mille piante diverse. L'anima del giardino è negli alberi. Una pausa di pace vicino al laghetto invita a rilassarsi. Questo sito è approvato dai Jardins Haut de France e ha ottenuto il marchio Qualité Tourisme."
        ],
        "fr": [
          "O Jardin Paisible est un jardin privé de 4000 m2, d'inspiration anglaise, situé sur les rives de la Planquette à Fressin. Plus d'un milliers de plantes différentes y sont associées. L'âme du jardin repose sur les arbres. Une pause paisible près du plan d'eau invite à la quiétude. Ce site est agrée par les Jardins Haut de France et labellisé Qualité Tourisme."
        ],
        "nl": [
          "O Jardin Paisible is een privétuin van 4000 m2, van Engelse inspiratie, gelegen aan de oevers van de Planquette in Fressin. Meer dan duizend verschillende planten zijn ermee verbonden. De ziel van de tuin ligt in de bomen. Een rustige pauze bij de vijver nodigt uit tot ontspanning. Deze site is erkend door de Jardins Haut de France en heeft het label Qualité Tourisme gekregen."
        ],
        "es": [
          "O Jardin Paisible es un jardín privado de 4000 m2, de inspiración inglesa, situado a orillas de la Planquette en Fressin. Más de mil plantas diferentes están asociadas a ella. El alma del jardín está en los árboles. Un descanso tranquilo cerca del lago le invita a relajarse. Este lugar está homologado por los Jardines Alto de Francia y cuenta con la etiqueta Qualité Tourisme."
        ]
      },
