  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/11d74922-4d63-3320-afb8-f59da36fd6b6",
      "dc:description": {
        "de": [
          "Kirche aus dem 16. Jahrhundert, die im Chor einen geschnitzten Glorienbalken beherbergt. Holzdecke des Kirchenschiffs in Form eines umgedrehten Schiffsrumpfes."
        ],
        "en": [
          "16th-century church featuring a carved rood beam in the choir. Wooden nave ceiling in the shape of an upturned ship's hull."
        ],
        "it": [
          "Chiesa del XVI secolo con una trave rodale intagliata nel coro. La navata centrale ha un soffitto in legno a forma di scafo di nave rovesciato."
        ],
        "fr": [
          "Eglise du XVIème siècle abritant dans le choeur une poutre de gloire sculptée. Plafond de la nef en bois en forme de coque de bateau retourné."
        ],
        "es": [
          "Iglesia del siglo XVI con una viga de madera tallada en el coro. La nave tiene un techo de madera en forma de casco de barco invertido."
        ],
        "nl": [
          "16e-eeuwse kerk met een gesneden doksaal in het koor. Het schip heeft een houten plafond in de vorm van een omgekeerde scheepsromp."
        ]
      },
