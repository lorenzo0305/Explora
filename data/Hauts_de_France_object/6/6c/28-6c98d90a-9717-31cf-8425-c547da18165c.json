  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0bf8396f-abcf-349f-ba74-1942b62ce6dc",
      "dc:description": {
        "de": [
          "Kommen Sie und genießen Sie in einem privilegierten Rahmen und treffen Sie sich zu einem geselligen Moment an einem guten Tisch.\nUnsere traditionelle Küche wird von uns mit frischen Qualitätsprodukten zubereitet."
        ],
        "en": [
          "Come and enjoy a privileged setting and meet up for a moment of conviviality around a good table.\nOur traditional cuisine, prepared by us with fresh quality produce."
        ],
        "it": [
          "Venite a godere di un ambiente privilegiato e a ritrovarvi per un momento di convivialità intorno a una buona tavola.\nLa nostra cucina tradizionale, preparata da noi con prodotti freschi e di qualità."
        ],
        "fr": [
          "Venez profiter dans un cadre privilégié et vous retrouver pour un moment de convivialité autour d'une bonne table.\nNotre cuisine traditionnelle, préparée par nos soins avec des produits frais de qualités."
        ],
        "es": [
          "Venga a disfrutar de un marco privilegiado y reúnase para un momento de convivencia en torno a una buena mesa.\nNuestra cocina tradicional, elaborada por nosotros con productos frescos de calidad."
        ],
        "nl": [
          "Kom genieten van een bevoorrechte omgeving en ontmoet elkaar voor een moment van gezelligheid rond een goede tafel.\nOnze traditionele keuken, door ons bereid met verse kwaliteitsproducten."
        ]
      },
