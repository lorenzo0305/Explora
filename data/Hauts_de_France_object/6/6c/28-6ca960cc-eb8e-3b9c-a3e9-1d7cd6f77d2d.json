  "rdfs:comment": {
    "de": [
      "Entspannung ... Nehmen Sie mit Freude und guter Laune an den verschiedenen Petanque-Cups teil, die im Boulodrome von Fort-Mahon-Plage vom Gemeindepersonal der Stadtverwaltung von Fort-Mahon-Plage organisiert werden."
    ],
    "en": [
      "Relaxation... Take part in the various pétanque competitions organized at the boulodrome in Fort-Mahon-Plage by the municipal staff of the Mairie de Fort-Mahon-Plage."
    ],
    "it": [
      "Relax... Partecipate alle varie gare di pétanque organizzate al boulodrome di Fort-Mahon-Plage dal personale comunale del municipio di Fort-Mahon-Plage."
    ],
    "fr": [
      "Détente... Participez dans la joie et la bonne humeur aux différentes coupes de pétanque organisées au boulodrome de Fort-Mahon-Plage par le personnel communal de la mairie de Fort-Mahon-Plage."
    ],
    "es": [
      "Relajación... Participe en las diferentes competiciones de petanca organizadas en el boulodrome de Fort-Mahon-Plage por el personal municipal del ayuntamiento de Fort-Mahon-Plage."
    ],
    "nl": [
      "Ontspanning... Doe mee aan de verschillende jeu-de-bouleswedstrijden die worden georganiseerd op het boulodrome in Fort-Mahon-Plage door het gemeentepersoneel van het gemeentehuis van Fort-Mahon-Plage."
    ]
  },
  "rdfs:label": {
