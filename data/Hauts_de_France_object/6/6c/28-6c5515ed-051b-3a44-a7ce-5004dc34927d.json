  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/905e768a-aefc-3118-bc26-a66530d6e113",
      "dc:description": {
        "de": [
          "Willkommen bei CÔTÉ COUR, wo jedes Gericht eine Geschichte von Authentizität und Geschmack erzählt. Lassen Sie sich von unserer raffinierten Küche und unseren einzigartigen Kreationen mitreißen, die mit Leidenschaft und Know-how aus lokalen Produkten zubereitet werden."
        ],
        "en": [
          "Welcome to CÔTÉ COUR, where every dish tells a story of authenticity and flavor. Let yourself be carried away by our refined cuisine and unique creations, crafted with passion and expertise from local produce."
        ],
        "it": [
          "Benvenuti al CÔTÉ COUR, dove ogni piatto racconta una storia di autenticità e sapore. Lasciatevi trasportare dalla nostra cucina raffinata e dalle nostre creazioni uniche, realizzate con passione e competenza con prodotti locali."
        ],
        "fr": [
          "Bienvenue chez CÔTÉ COUR, où chaque plat raconte une histoire d'authenticité et de saveurs. Laissez-vous emporter par notre cuisine raffinée et nos créations uniques, élaborées avec passion et savoir-faire à partir de produits locaux."
        ],
        "nl": [
          "Welkom bij CÔTÉ COUR, waar elk gerecht een verhaal van authenticiteit en smaak vertelt. Laat u meeslepen door onze verfijnde keuken en unieke creaties, met passie en expertise gemaakt van lokale producten."
        ],
        "es": [
          "Bienvenido a CÔTÉ COUR, donde cada plato cuenta una historia de autenticidad y sabor. Déjese llevar por nuestra cocina refinada y nuestras creaciones únicas, elaboradas con pasión y maestría a partir de productos locales."
        ]
      },
      "@type": [
        "Description"
