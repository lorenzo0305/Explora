  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c5538eee-8e62-3c27-9ff0-515eb7cfd825",
      "dc:description": {
        "de": [
          "Zu Fuß von Étaples aus führt dieser Pfad auf der Domaine Public Maritime an den Salzwiesen vorbei und erreicht das Naturschutzgebiet (Aussichtspunkt Boucle de Tadorne) und das Flussbett der La Canche. Entfernung: 1,6 km (Hinweg)."
        ],
        "en": [
          "On foot, from Étaples, this trail on the Domaine Public Maritime runs alongside the salt meadows and reaches the nature reserve (Tadorne Loop lookout) and the bed of La Canche. Distance: 1.6 km (one way)."
        ],
        "it": [
          "A piedi da Étaples, questo sentiero del demanio marittimo costeggia i prati salmastri e raggiunge la riserva naturale (punto di osservazione della Boucle de Tadorne) e il letto del fiume Canche. Distanza: 1,6 km (solo andata)."
        ],
        "fr": [
          "A pied, depuis Étaples, ce sentier sur le Domaine Public Maritime longe les prés salés et rejoint la réserve naturelle (belvédère de la Boucle de Tadorne) et le lit de La Canche. Distance : 1,6 km (aller)."
        ],
        "nl": [
          "Te voet vanuit Étaples loopt dit pad op het Openbare Maritieme Domein langs de zoutweiden en sluit het aan op het natuurreservaat (uitkijkpunt bij de Boucle de Tadorne) en de bedding van La Canche. Afstand: 1,6 km (enkele reis)."
        ],
        "es": [
          "A pie desde Étaples, este sendero del Dominio Público Marítimo bordea los prados salados y llega hasta la reserva natural (mirador del Boucle de Tadorne) y el cauce del río Canche. Distancia: 1,6 km (sólo ida)."
        ]
      },
      "@type": [
        "Description"
      ],
