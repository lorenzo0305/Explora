  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48d0bdbc-ec22-31fa-9236-727c71313e00",
      "dc:description": {
        "de": [
          "Samstag, 26. April\nFlash-Touren auf den Stadtmauern\nUhrzeit: zwischen 14:00 und 17:00 Uhr\nTreffpunkte: Porte des Dunes, Zugbrücke des Schlosses, Porte des Degrés\nKostenlos / keine Anmeldung erforderlich\nInformationen: Service Ville d'art et d'histoire - 03.91.90.02.95"
        ],
        "en": [
          "Saturday April 26\nFlash tours of the ramparts\nTimes: between 2 pm and 5 pm\nMeeting points: Porte des Dunes, château drawbridge, Porte des Degrés\nFree / no registration\nInformation Service Ville d?art et d?histoire - 03.91.90.02.95"
        ],
        "it": [
          "Sabato 26 aprile\nVisite lampo ai bastioni\nOrario: tra le 14.00 e le 17.00\nPunti di incontro: Porte des Dunes, ponte levatoio del Castello, Porte des Degrés\nGratuito / senza registrazione\nPer ulteriori informazioni, contattare Dipartimento Arte e Storia della Città - 03.91.90.02.95"
        ],
        "fr": [
          "Samedi 26 avril\nVisites flash sur les remparts \nHoraires : entre 14 h et 17 h \nPoints de rendez-vous : Porte des Dunes, Pont-levis du château, Porte des Degrés \nGratuit / pas d’inscription\nRenseignements : Service Ville d’art et d’histoire - 03.91.90.02.95"
        ],
        "nl": [
          "Zaterdag 26 april\nFlitsrondleidingen over de stadswallen\nTijden: tussen 14 en 17 uur\nOntmoetingspunten: Porte des Dunes, ophaalbrug kasteel, Porte des Degrés\nGratis / geen inschrijving\nVoor meer informatie, neem contact op met Gemeente Kunst en Geschiedenis - 03.91.90.02.95"
        ],
        "es": [
          "Sábado 26 de abril\nVisitas relámpago a las murallas\nHorario: de 14:00 a 17:00\nPuntos de encuentro: Puerta de las Dunas, Puente levadizo del Castillo, Puerta de los Grados\nGratuito / sin inscripción\nPara más información Departamento de Arte e Historia de la Ciudad - 03.91.90.02.95"
        ]
      },
