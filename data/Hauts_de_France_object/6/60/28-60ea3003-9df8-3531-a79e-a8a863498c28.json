  "rdfs:comment": {
    "de": [
      "Schattiger Picknicktisch im Park (frei zugänglich) auf der Rückseite des Rathauses.\nIn der Nähe: öffentliche Sanitäranlagen, Kinderspielplätze und öffentliches WLAN ."
    ],
    "en": [
      "Shaded picnic table located in the park (free access) behind the town hall.\nNearby: public toilets, children's playground and public wifi."
    ],
    "it": [
      "Tavolo da picnic ombreggiato nel parco (accesso libero) dietro il municipio.\nNelle vicinanze: servizi igienici pubblici, parchi giochi per bambini e wifi pubblico."
    ],
    "fr": [
      "Table de pique-nique ombragée située dans le parc (libre d'accès) à l'arrière de la mairie.\nA proximité : sanitaires publics, aires de jeux pour enfants et wifi public ."
    ],
    "nl": [
      "Schaduwrijke picknicktafel in het park (vrij toegankelijk) achter het gemeentehuis.\nIn de buurt: openbare toiletten, kinderspeelplaatsen en openbare wifi."
    ],
    "es": [
      "Mesa de picnic a la sombra situada en el parque (acceso libre) detrás del ayuntamiento.\nEn las inmediaciones: aseos públicos, parques infantiles y wifi público."
    ]
  },
