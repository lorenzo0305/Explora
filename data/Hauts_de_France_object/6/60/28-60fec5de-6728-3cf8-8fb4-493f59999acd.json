  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/61933161-55ad-38fb-831a-9f1b08f3e845",
      "dc:description": {
        "de": [
          "-Ausleihe von Büchern, CDs und Zeitschriften.\r\n-Zugang zum Internet, Textverarbeitung\r\n-Fotokopierer, Drucker stehen zur Verfügung\r\n-Märchenstunde (1 Mittwoch pro Monat)\r\n-Ständige Ausstellungen\r\n-Informationsstelle für Jugendliche\r\n-Freizeitzentrum\r\n-Musikschule"
        ],
        "en": [
          "-Loans of books, compact discs, periodicals.\r\n-Internet access, word processing\r\n-Photocopier, printer available\r\n-Story time (1 Wednesday per month)\r\n-Permanent Exhibitions\r\n-Youth Information Point\r\n-Lazarette Centre\r\n-School of Music"
        ],
        "it": [
          "-Prestito di libri, CD e periodici.\r\n-Accesso a Internet, elaborazione testi\r\n-Fotocopiatrice e stampante disponibili\r\n-Ora delle storie (1 mercoledì al mese)\r\n-Mostre permanenti\r\n-Punto di informazione per i giovani\r\n-Centro ricreativo\r\n-Scuola di musica"
        ],
        "fr": [
          "-Prêts de livres, de compacts disques, de périodiques.\r\n-Accés à Internet, traitement de texte\r\n-Photocopieur, imprimante à disposition\r\n-Heure du conte (1 mercredi par mois)\r\n-Expositions permanentes\r\n-Point Informations Jeunesse\r\n-Centre de losirs\r\n-Ecole de musique"
        ],
        "nl": [
          "-Uitlenen van boeken, cd's en tijdschriften.\r\n-Toegang tot internet, tekstverwerking\r\n-Fotokopieerapparaat, printer beschikbaar\r\n-Verhaaltijd (1 woensdag per maand)\r\n-Permanente tentoonstellingen\r\n-Jongeren Informatie Punt\r\n-Vrijetijdscentrum\r\n-Muziekschool"
        ],
        "es": [
          "-Préstamo de libros, CDs y publicaciones periódicas.\r\n-Acceso a Internet, tratamiento de textos\r\n-Fotocopiadora, impresora disponible\r\n-Hora del cuento (1 miércoles al mes)\r\n-Exposiciones permanentes\r\n-Punto de Información Juvenil\r\n-Centro de ocio\r\n-Escuela de música"
        ]
      },
