  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5e48d0fd-168a-3b3a-9b40-8a8910a8d5ac",
      "dc:description": {
        "de": [
          "Entdecken Sie die Authentizität der Guinguette en fête, einer Oase der Glückseligkeit am Ufer des Wassers. Tauchen Sie ein in eine gesellige Atmosphäre und lassen Sie sich von der Live-Musik mitreißen."
        ],
        "en": [
          "Discover the authenticity of the Guinguette en fête, a haven of happiness by the water. Immerse yourself in the friendly atmosphere and let the live music take you away."
        ],
        "it": [
          "Scoprite l'autenticità della Guinguette en fête, un'oasi di felicità in riva al mare. Immergetevi nell'atmosfera amichevole e godetevi la musica dal vivo."
        ],
        "fr": [
          "Découvrez l'authenticité de la Guinguette en fête, un havre de bonheur au bord de l'eau. Plongez dans une ambiance conviviale et laissez vous emporter par la musique live."
        ],
        "nl": [
          "Ontdek de authenticiteit van Guinguette en fête, een oase van geluk aan het water. Dompel je onder in de gezellige sfeer en geniet van de livemuziek."
        ],
        "es": [
          "Descubra la autenticidad de la Guinguette en fête, un remanso de felicidad junto al agua. Sumérjase en el ambiente acogedor y disfrute de la música en directo."
        ]
      },
