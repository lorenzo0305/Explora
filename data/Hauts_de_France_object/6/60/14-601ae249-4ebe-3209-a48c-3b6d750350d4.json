      "dc:description": {
        "de": [
          "Was gibt es Schöneres, als gutes Essen mit einem Panoramablick auf den Deich von Wimereux und das Meer zu genießen?"
        ],
        "en": [
          "What could be better than tasting good food with a panoramic view of the Wimereux breakwater and the sea?"
        ],
        "it": [
          "Cosa c'è di meglio che gustare un pasto delizioso con vista panoramica sul frangiflutti di Wimereux e sul mare?"
        ],
        "fr": [
          "Quoi de mieux que déguster de bons petits plats avec une vue panoramique sur la digue de Wimereux et la mer ?"
        ],
        "es": [
          "¿Qué puede haber mejor que disfrutar de una deliciosa comida con una vista panorámica del rompeolas de Wimereux y el mar?"
        ],
        "nl": [
          "Wat is er lekkerder dan genieten van een heerlijke maaltijd met een panoramisch uitzicht op de golfbreker van Wimereux en de zee?"
        ]
      },
