  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e5ec2e94-6782-3b16-9bf4-f6c656896b55",
      "dc:description": {
        "de": [
          "Die Ferme des Aigrettes ist ein Ort, der sich für Ausflüge mit der ganzen Familie eignet. Der Besuch des Anwesens bietet zahlreiche abwechslungsreiche Aktivitäten: Entdecken Sie die Tiere des Bauernhofs, reiten Sie auf Ponys und starten Sie zu einer Wanderung."
        ],
        "en": [
          "La Ferme des Aigrettes is a place suitable for family outings. The visit of the domain offers many varied activities: discovery of the farm animals, pony rides, and hiking departure."
        ],
        "it": [
          "La Ferme des Aigrettes è un luogo adatto alle gite in famiglia. La visita della tenuta offre molte attività varie: scoperta degli animali della fattoria, passeggiate con i pony e percorsi di trekking."
        ],
        "fr": [
          "La Ferme des Aigrettes est un lieu adapté aux balades en familles. La visite du domaine offre de nombreuses activités variées : découverte des animaux de la ferme, balades en poneys, et départ de randonnée pédestre."
        ],
        "es": [
          "La Ferme des Aigrettes es un lugar adecuado para los paseos familiares. La visita de la finca ofrece muchas actividades variadas: descubrimiento de los animales de la granja, paseos en poni y rutas de senderismo."
        ],
        "nl": [
          "De Ferme des Aigrettes is een plek die geschikt is voor gezinsuitstapjes. Het bezoek van het landgoed biedt vele gevarieerde activiteiten: ontdekking van de boerderijdieren, ponyritjes en wandelpaden."
        ]
      },
      "@type": [
        "Description"
