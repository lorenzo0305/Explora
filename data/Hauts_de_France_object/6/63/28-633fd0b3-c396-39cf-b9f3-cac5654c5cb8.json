  "rdfs:comment": {
    "de": [
      "You'll like: Die Dekoration erinnert an die bretonische Küste! Le Phare ist der perfekte Ort, um echte bretonische Crêpes in Amiens zu genießen!"
    ],
    "en": [
      "You'll love : The decor is reminiscent of the Breton coast! Le Phare is the perfect place to enjoy real Breton crepes in Amiens!"
    ],
    "it": [
      "Vi piacerà: L'arredamento ricorda la costa bretone! Le Phare è il luogo ideale per gustare le vere crepes bretoni ad Amiens!"
    ],
    "fr": [
      "Vous aimerez : La décoration rappelle les côtes bretonnes ! Le Phare est l'endroit parfait pour déguster de vraies crêpes bretonnes à Amiens !"
    ],
    "es": [
      "Te encantará : La decoración evoca la costa bretona Le Phare es el lugar ideal para degustar auténticas crepes bretonas en Amiens"
    ],
    "nl": [
      "Je zult het geweldig vinden: De inrichting doet denken aan de Bretonse kust! Le Phare is de perfecte plek om te genieten van echte Bretonse crêpes in Amiens!"
    ]
  },
