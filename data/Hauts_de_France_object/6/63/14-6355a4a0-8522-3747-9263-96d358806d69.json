  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ce509966-cb67-3839-8721-6360db601875",
      "dc:description": {
        "de": [
          "Brasserie mit Blick auf den Strand, traditionelle Küche und Brasserie, regionale Spezialitäten, Rum- und Cocktailbar, Happy Hours, ... alles ist darauf ausgerichtet, dass Sie eine gute Zeit in unserer Gesellschaft verbringen."
        ],
        "en": [
          "Brasserie in front of the beach, traditional and brasserie cuisine, regional specialities, rum and cocktail bar, happy hours, ... everything is done to make sure you have a good time with us."
        ],
        "it": [
          "Brasserie di fronte alla spiaggia, cucina tradizionale e brasserie, specialità regionali, rum bar e cocktail, happy hour, ... tutto è fatto per farvi trascorrere un buon momento in nostra compagnia."
        ],
        "fr": [
          "Brasserie face à la plage, cuisine traditionnelle et de brasserie, spécialités régionales, bar à rhum et cocktails, happy hours, ... tout est fait pour que vous passiez un bon moment en notre compagnie."
        ],
        "es": [
          "Brasserie frente a la playa, cocina tradicional y de brasserie, especialidades regionales, bar de ron y cócteles, happy hours, ... todo está hecho para que pase un buen rato en nuestra compañía."
        ],
        "nl": [
          "Brasserie aan het strand, traditionele en brasseriekeuken, regionale specialiteiten, rumbar en cocktails, happy hours, ... alles wordt in het werk gesteld om u een fijne tijd in ons gezelschap te bezorgen."
        ]
      },
