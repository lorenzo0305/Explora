  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit direktem Blick auf den Hafen und einem Saal im Obergeschoss mit Panoramablick auf die Baie de Somme. Die Speisekarte wird je nach Jahreszeit überarbeitet und bietet hausgemachte Gerichte von guter Qualität.\n\nWegen Bauarbeiten ab 12.11.24 geschlossen - Wiedereröffnung im Februar 2025"
    ],
    "en": [
      "Traditional restaurant overlooking the port, with an upstairs dining room offering panoramic views over the Baie de Somme. The menu changes with the seasons, offering high-quality home cooking.\n\nClosed for works from 12/11/24 - reopening February 2025"
    ],
    "it": [
      "Ristorante tradizionale affacciato sul porto, con una sala da pranzo al piano superiore che offre una vista panoramica sulla Baie de Somme. Il menu varia a seconda delle stagioni e offre una cucina casalinga di qualità.\n\nChiuso per lavori dal 12/11/24 - riapertura a febbraio 2025"
    ],
    "fr": [
      "Restaurant traditionnel donnant directement sur le port et disposant d’une salle à l’étage avec vue panoramique sur la Baie de Somme. Carte remaniée au fil des saisons qui propose une cuisine maison de bonne qualité.\n\nFermeture pour travaux à partir du 12/11/24 - réouverture en février 2025"
    ],
    "nl": [
      "Traditioneel restaurant met uitzicht op de haven en een eetzaal op de bovenverdieping met panoramisch uitzicht over de Baie de Somme. Het menu verandert met de seizoenen en biedt huisgemaakte gerechten van goede kwaliteit.\n\nGesloten voor werkzaamheden van 12/11/24 - heropening in februari 2025"
    ],
    "es": [
      "Restaurante tradicional con vistas al puerto, con un comedor en el piso superior que ofrece vistas panorámicas de la bahía de Somme. El menú cambia con las estaciones y ofrece cocina casera de buena calidad.\n\nCerrado por obras desde el 12/11/24 - reapertura en febrero de 2025"
    ]
  },
  "rdfs:label": {
