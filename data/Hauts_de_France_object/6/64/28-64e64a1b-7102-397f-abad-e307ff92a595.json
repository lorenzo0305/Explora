  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/66cb6e26-2148-3799-a106-e0e88412f6d3",
      "dc:description": {
        "de": [
          "Picknickbereich befindet sich am Ufer eines kleinen Wasserlaufs. Verschiedene Einrichtungen: Picknicktisch, Bouleplatz, Fußballplatz, Parkplatz und Mülleimer.\n\nMöglichkeit zum Angeln."
        ],
        "en": [
          "Picnic area is located on the edge of a small stream. Various equipment: picnic table, petanque ground, football pitch, parking and rubbish bins.\n\nPossibility of fishing."
        ],
        "it": [
          "L'area picnic si trova sulle rive di un piccolo torrente. Varie strutture: tavolo da picnic, campo da bocce, campo da calcio, parcheggio e cestini per i rifiuti.\n\nÈ possibile pescare."
        ],
        "fr": [
          "Aire de pique-nique se situe au bord d'un petit cours d'eau. Divers équipement : table de pique-nique, terrain de pétanque, terrain de football, parking et poubelles.\n\nPossibilité de pêcher."
        ],
        "es": [
          "La zona de picnic está situada a orillas de un pequeño arroyo. Diversas instalaciones: mesa de picnic, campo de petanca, campo de fútbol, aparcamiento y papeleras.\n\nLa pesca es posible."
        ],
        "nl": [
          "De picknickplaats ligt aan de oever van een klein beekje. Diverse voorzieningen: picknicktafel, petanquebaan, voetbalveld, parkeerplaats en afvalbakken.\n\nVissen is mogelijk."
        ]
      },
