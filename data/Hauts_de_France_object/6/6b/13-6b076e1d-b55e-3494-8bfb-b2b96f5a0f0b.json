  "rdfs:comment": {
    "de": [
      "In einer Wassermühle, deren Ursprünge bis ins Jahr 1466 zurückverfolgt werden können, erkunden Sie die Zeugnisse eines in der Region Avesnois geschätzten Handwerks: die Boissellerie."
    ],
    "en": [
      "In a water mill whose origins have been traced back to 1466, come and explore the testimonies of an esteemed craft in the Avesnois: the boissellerie."
    ],
    "it": [
      "In un mulino ad acqua le cui origini risalgono al 1466, venite a scoprire le testimonianze di un mestiere molto apprezzato nell'Avesnois: la boissellerie."
    ],
    "fr": [
      "Dans un moulin à eau dont les origines ont été retracées jusqu’en 1466, venez explorer les témoignages d’un artisanat estimé en Avesnois : la boissellerie."
    ],
    "nl": [
      "Kom in een watermolen, waarvan de oorsprong teruggaat tot 1466, de sporen ontdekken van een in de Avesnois gewaardeerd ambacht: de boissellerie."
    ],
    "es": [
      "En un molino de agua cuyos orígenes se remontan a 1466, venga a explorar los testimonios de un oficio valorado en el Avesnois: la boissellerie."
    ]
  },
