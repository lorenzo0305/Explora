      "@id": "https://data.datatourisme.fr/bb938298-82dd-3a91-988c-e0f7e943a58d",
      "dc:description": {
        "de": [
          "Verkleideter Halloween Zumba, organisiert von Mouv'Gym.\nBereiten Sie Ihre gruseligsten Kostüme für einen energiegeladenen Abend vor.\nOffen für alle."
        ],
        "en": [
          "Zumba Halloween in costume organized by Mouv'Gym.\nGet your scariest costumes ready for a high-energy evening.\nOpen to all."
        ],
        "it": [
          "Zumba di Halloween in maschera organizzata da Mouv'Gym.\nPreparate i vostri costumi più spaventosi per una serata ad alta energia.\nAperto a tutti."
        ],
        "fr": [
          "Zumba Halloween déguisée organisée par Mouv'Gym.\nPréparez vos costumes les plus effrayants pour une soirée pleine d'énergie.\nOuvert à tous."
        ],
        "nl": [
          "Verklede Halloween Zumba georganiseerd door Mouv'Gym.\nMaak je engste kostuums klaar voor een energieke avond.\nVoor iedereen toegankelijk."
        ],
        "es": [
          "Halloween Zumba disfrazado organizado por Mouv'Gym.\nPrepara tus disfraces más terroríficos para una tarde llena de energía.\nAbierto a todos."
        ]
      },
