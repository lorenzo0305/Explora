  "rdfs:comment": {
    "de": [
      "In Begleitung eines Führers können Sie die Halde Escarpelle erkunden, die heute ein Naturschutzgebiet mit einer ganz besonderen Flora ist. Auf angelegten Pfaden und vier Aussichtspunkten können Sie die Bergbaufolgelandschaft erkunden."
    ],
    "en": [
      "Accompanied by a guide, take on the challenge of the Escarpelle slag heap, now converted into a protected natural area with its own distinctive flora. A series of trails and four lookouts offer a glimpse of the mining landscape."
    ],
    "it": [
      "Accompagnati da una guida, si parte alla scoperta del cumulo di scorie di Escarpelle, oggi trasformato in un'area naturale protetta con una flora unica. Quattro punti di osservazione e una serie di sentieri ben curati vi permetteranno di conoscere il paesaggio minerario."
    ],
    "fr": [
      "Accompagné d'un guide, lancez-vous à l'assaut du terril de l'Escarpelle, reconverti aujourd’hui en une zone naturelle préservée avec sa flore si particulière. Des sentiers aménagés et quatre belvédères vous offriront une lecture du paysage minier."
    ],
    "nl": [
      "Ga onder begeleiding van een gids op verkenningstocht door de terril van Escarpelle, die nu is omgevormd tot een beschermd natuurgebied met zijn eigen unieke flora. Vier uitkijkpunten en een aantal goed onderhouden wandelpaden geven je inzicht in het mijnlandschap."
    ],
    "es": [
      "Acompañado por un guía, explore el escorial de Escarpelle, hoy convertido en un espacio natural protegido con una flora única. Cuatro miradores y varios senderos en buen estado le permitirán descubrir el paisaje minero."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rando-découverte - Le terril de l'Escarpelle"
    ]
  },
