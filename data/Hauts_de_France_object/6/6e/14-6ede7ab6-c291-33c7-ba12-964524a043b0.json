      "dc:description": {
        "de": [
          "Drei verschiedene körperliche Aktivitäten, die zu Musik in einer entspannten und geselligen Atmosphäre stattfinden.\nSanfte Gymnastik, Zumba, Muskelaufbau"
        ],
        "en": [
          "Three different physical activities performed to music in a relaxed, friendly atmosphere.\nGentle gymnastics, Zumba, muscle strengthening"
        ],
        "it": [
          "Tre diverse attività fisiche eseguite a ritmo di musica in un'atmosfera rilassata e amichevole.\nGinnastica dolce, Zumba, potenziamento muscolare"
        ],
        "fr": [
          "Trois activités physiques différentes qui se déroulent en musique dans une ambiance détendue et conviviale.\nGym douce, zumba, renforcement musculaire"
        ],
        "es": [
          "Tres actividades físicas diferentes realizadas al ritmo de la música en un ambiente relajado y agradable.\nGimnasia suave, Zumba, refuerzo muscular"
        ],
        "nl": [
          "Drie verschillende fysieke activiteiten op muziek in een ontspannen, vriendelijke sfeer.\nZachte gymnastiek, Zumba, spierversterking"
        ]
      },
