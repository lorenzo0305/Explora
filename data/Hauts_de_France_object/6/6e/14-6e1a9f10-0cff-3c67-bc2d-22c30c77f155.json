  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5edf7335-0f0e-3f98-a268-17d16449b9cc",
      "dc:description": {
        "de": [
          "Informationen :\n\nMenü: Frühstück (4.90) und Menüteller (13?) zum Mitnehmen.\n\nÖffnungszeiten:\nMontags von 11:30 bis 14:00 Uhr und von 16:00 bis 22:00 Uhr\nDienstag bis Freitag von 4:30 bis 9:30 Uhr, von 11:30 bis 14:00 Uhr und von 16:00 bis 22:00 Uhr\n\nSamstag und Sonntag geschlossen"
        ],
        "en": [
          "Information :\n\nMenu: breakfast (4?90) and packed lunch (13?) to take away.\n\nOpening days :\nMonday 11:30am to 2pm and 4pm to 10pm\nTuesday to Friday: 4:30am to 9:30am, 11:30am to 2pm and 4pm to 10pm\n\nClosed on Saturday and Sunday"
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu: colazione (4,90) e pranzo al sacco (13?) da asporto.\n\nOrari di apertura :\nLunedì: dalle 11.30 alle 14.00 e dalle 16.00 alle 22.00\nDa martedì a venerdì: dalle 4.30 alle 9.30, dalle 11.30 alle 14.00 e dalle 16.00 alle 22.00\n\nChiuso il sabato e la domenica"
        ],
        "fr": [
          "Informations :\n\nMenu: petit-déjeuner (4€90) et plateau repas (13€) à emporter. \n\nJours d'ouverture :\nLe lundi de 11h30 à 14h et de 16h à 22h \nDu mardi au vendredi de 4h30 à 9h30, de 11h30 à 14h et de 16h à 22h\n\nFermeture le samedi et le dimanche"
        ],
        "nl": [
          "Meer informatie :\n\nMenu: ontbijt (4?90) en lunchpakket (13?) om mee te nemen.\n\nOpeningstijden :\nMaandag van 11.30 tot 14.00 uur en van 16.00 tot 22.00 uur\nDinsdag t/m vrijdag: 4.30 tot 9.30 uur, 11.30 tot 14.00 uur en 16.00 tot 22.00 uur\n\nGesloten op zaterdag en zondag"
        ],
        "es": [
          "Más información :\n\nMenú: desayuno (4?90) y comida para llevar (13?).\n\nHorario de apertura :\nLunes: de 11.30 a 14.00 h. y de 16.00 a 22.00 h\nDe martes a viernes: de 4.30 a 9.30, de 11.30 a 14 y de 16 a 22 h\n\nSábados y domingos cerrado"
        ]
      },
