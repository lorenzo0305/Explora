  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum von Soissons bietet Ihnen Marjorie ihre Bagels, Salate und hausgemachten Suppen an. Für die Naschkatzen unter Ihnen entdecken Sie ihre Spezialitäten Cup-Cakes, Cookies, Muffins, Käsekuchen ... ein Fest für Augen und Gaumen!"
    ],
    "en": [
      "In downtown Soissons, Marjorie offers bagels, salads and homemade soups. For those with a sweet tooth, discover her cupcake, cookie, muffin and cheesecake specialties... a feast for the eyes and the taste buds!"
    ],
    "it": [
      "Nel centro di Soissons, Marjorie offre bagel, insalate e zuppe fatte in casa. Per i più golosi, scoprite le sue specialità di cupcake, biscotti, muffin e cheesecake... una festa per gli occhi e per le papille gustative!"
    ],
    "fr": [
      "Dans le centre ville de Soissons, Marjorie vous propose ses bagels, salades et soupes maison. Pour les plus gourmands, découvrez ses spécialités cup-cakes, cookies, muffins, cheesecake ... un régal des yeux et des papilles !"
    ],
    "nl": [
      "In het centrum van Soissons biedt Marjorie bagels, salades en huisgemaakte soepen. Voor zoetekauwen: ontdek haar cupcake-, koekjes-, muffin- en cheesecake-specialiteiten... een feest voor het oog en de smaakpapillen!"
    ],
    "es": [
      "En el centro de Soissons, Marjorie ofrece bagels, ensaladas y sopas caseras. Para los más golosos, descubra sus especialidades en magdalenas, galletas, muffins y tartas de queso... ¡un festín para la vista y el paladar!"
    ]
  },
