  "rdfs:comment": {
    "de": [
      "2,5 Stunden von Paris und Brüssel, 1 Stunde von Calais entfernt, entdecken Sie den Golfplatz Belle Dune und seinen 18-Loch-Platz, der perfekt in das schönste Dünenmassiv Europas integriert ist. Im Bar-Restaurant des Clubhauses herrscht eine warme und gemütliche Atmosphäre, und auf der Sonnenterrasse können Sie der Natur ins Auge blicken."
    ],
    "en": [
      "2h30 from Paris and Brussels, 1 hour from Calais, discover the Belle Dune Golf Course and its 18-hole course perfectly integrated into the most beautiful dune massif in Europe. Find a warm and cosy atmosphere at the Club House bar restaurant and enjoy its sunny terrace for a magical face to face with nature."
    ],
    "it": [
      "A 2h30 da Parigi e Bruxelles, a 1 ora da Calais, scoprite il Golf de Belle Dune e il suo campo a 18 buche perfettamente integrato nel più bel massiccio dunale d'Europa. Godetevi l'atmosfera calda e accogliente del bar-ristorante Club House e la sua terrazza soleggiata per un magico incontro a tu per tu con la natura."
    ],
    "fr": [
      "A 2h30 de Paris et de Bruxelles, à 1 heure de Calais, découvrez le Golf de Belle Dune et son parcours 18 trous parfaitement intégré au plus beau massif dunaire d'Europe. Retrouvez une ambiance chaleureuse et feutrée au bar restaurant du Club House et profitez de sa terrrasse ensoleillée pour un face à face magique avec la nature."
    ],
    "nl": [
      "Op 2u30 van Parijs en Brussel, op 1 uur van Calais, ontdek de Golf de Belle Dune en zijn 18-holes baan die perfect geïntegreerd is in het mooiste duinmassief van Europa. Geniet van de warme en gezellige sfeer van bar-restaurant Club House en het zonnige terras voor een magische ontmoeting met de natuur."
    ],
    "es": [
      "A 2h30 de París y Bruselas, a 1 hora de Calais, descubra el Golf de Belle Dune y su recorrido de 18 hoyos perfectamente integrado en el macizo dunar más bello de Europa. Disfrute del ambiente cálido y acogedor del bar-restaurante Club House y de su soleada terraza para un mágico encuentro cara a cara con la naturaleza."
    ]
  },
