  "rdfs:comment": {
    "de": [
      "Unser 2025 eröffneter Taproom mit seiner schönen Terrasse heißt Sie herzlich willkommen, um unsere Flaschen zu kaufen, aber auch um sich niederzulassen und unsere Biere vom Fass zu probieren, begleitet von biologischen und lokalen Produkten."
    ],
    "en": [
      "Opened in 2025, our taproom and its beautiful terrace welcome you to come and buy our bottles, but also to sit back and enjoy our draught beers, accompanied by organic and local produce."
    ],
    "it": [
      "Inaugurata nel 2025, la nostra taproom e la sua splendida terrazza vi accolgono per acquistare le nostre bottiglie o semplicemente per sedervi e gustare le nostre birre alla spina, accompagnate da prodotti biologici e locali."
    ],
    "fr": [
      "Ouvert en 2025, notre taproom et sa belle terrasse vous acceuille pour venir acheter nos bouteilles mais aussi vous poser afin de déguster nos bières en pression, accompagnées de produits Bio et locaux."
    ],
    "nl": [
      "Onze gelagkamer en het mooie terras werden geopend in 2025 en verwelkomen je om onze flessen te komen kopen of om gewoon achterover te leunen en te genieten van onze bieren van het vat, vergezeld van biologische en lokale producten."
    ],
    "es": [
      "Inaugurado en 2025, nuestro bar y su hermosa terraza le dan la bienvenida para que venga a comprar nuestras botellas o simplemente se siente y disfrute de nuestras cervezas de barril, acompañadas de productos ecológicos y locales."
    ]
  },
