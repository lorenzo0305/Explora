  "rdfs:comment": {
    "de": [
      "Ein neues Konzept für diese Marke: ein Lounge-Restaurant. Dieses Restaurant bietet Ihnen mittags und abends eine traditionelle und abwechslungsreiche Küche. Entspannen Sie sich in einer Lounge-Atmosphäre und genießen Sie außerdem eine umfangreiche Cocktailkarte bis 1 Uhr morgens!"
    ],
    "en": [
      "A new concept for this brand: a lounge restaurant. This restaurant offers a traditional and varied cuisine for lunch and dinner. Come and relax in a lounge atmosphere with a large cocktail menu until 1am!"
    ],
    "it": [
      "Un nuovo concetto per questo marchio: un ristorante lounge. Questo ristorante offre una cucina tradizionale e variegata a pranzo e la sera. Venite a rilassarvi in un'atmosfera lounge con una vasta gamma di cocktail fino all'una di notte!"
    ],
    "fr": [
      "Un nouveau concept pour cette enseigne : un restaurant lounge. Ce restaurant vous propose une cuisine traditionnelle et variée le midi et le soir. Venez vous détendre dans une ambiance lounge avec en plus une large carte de cocktails jusqu'a 1h du matin !"
    ],
    "es": [
      "Un nuevo concepto para esta marca: un restaurante lounge. Este restaurante ofrece una cocina tradicional y variada al mediodía y por la noche. Venga a relajarse en un ambiente lounge con una amplia gama de cócteles hasta la 1 de la madrugada"
    ],
    "nl": [
      "Een nieuw concept voor dit merk: een lounge restaurant. Dit restaurant biedt 's middags en 's avonds een traditionele en gevarieerde keuken. Kom ontspannen in een loungesfeer met een breed scala aan cocktails tot 1 uur 's nachts!"
    ]
  },
