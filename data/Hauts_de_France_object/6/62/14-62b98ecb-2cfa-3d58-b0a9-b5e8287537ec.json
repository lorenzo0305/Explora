      "dc:description": {
        "de": [
          "Butter, Milchprodukte, Kalb- und Färsenfleisch in Paketen oder im Einzelhandel. Produkte erhältlich am Verkaufsautomaten, 250 avenue Henri Mory in Samer."
        ],
        "en": [
          "Butter, dairy products, veal and heifer meat, packaged or retail. Products available from the vending machine, 250 avenue Henri Mory, Samer."
        ],
        "it": [
          "Burro, prodotti lattiero-caseari, vitello e vitellone in pacchi o al dettaglio. Prodotti disponibili presso il distributore automatico, 250 avenue Henri Mory, Samer."
        ],
        "fr": [
          "Beurre, produits laitiers, viande de veau, et génisse en colis ou au détail. Produits disponibles au distributeur automatique, 250 avenue Henri Mory à Samer."
        ],
        "es": [
          "Mantequilla, productos lácteos, ternera y vaquilla en paquetes o al por menor. Productos disponibles en la máquina expendedora, 250 avenue Henri Mory, Samer."
