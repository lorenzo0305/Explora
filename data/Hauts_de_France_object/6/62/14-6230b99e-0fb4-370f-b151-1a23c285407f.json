      "dc:description": {
        "de": [
          "Der Palais des Sports Damrémont, manchmal auch einfach Salle Damrémont genannt, ist ein Sportkomplex am Ufer des Flusses Liane."
        ],
        "en": [
          "The Damrémont Sports Palace, sometimes called simply Damrémont Hall, is a sports complex located on the banks of the Liane."
        ],
        "it": [
          "Il Palais des Sports Damrémont, talvolta noto semplicemente come Salle Damrémont, è un complesso sportivo situato sulle rive del fiume Liane."
        ],
        "fr": [
          "Le palais des sports Damrémont, parfois appelé simplement salle Damrémont, est un complexe sportif situé au bord de la Liane."
        ],
        "nl": [
          "Het Palais des Sports Damrémont, soms ook gewoon Salle Damrémont genoemd, is een sportcomplex aan de oevers van de rivier de Liane."
        ],
        "es": [
          "El Palais des Sports Damrémont, a veces conocido simplemente como la Salle Damrémont, es un complejo deportivo situado a orillas del río Liane."
        ]
