  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f2e0f070-499a-36f8-bd89-d8afc449e2a5",
      "dc:description": {
        "de": [
          "Treffen Sie sich zu einer Halloween-Party und einer großen Süßigkeitenjagd.\n\nGruselige Verkleidungen werden empfohlen.\n\nOffen für alle.\n\nAnmeldung empfohlen."
        ],
        "en": [
          "Join us for a Halloween Party and trick-or-treating.\n\nScary costumes recommended.\n\nOpen to all.\n\nRegistration recommended."
        ],
        "it": [
          "Unisciti a noi per una festa di Halloween e per fare \"dolcetto o scherzetto\".\n\nSi consigliano costumi spaventosi.\n\nAperto a tutti.\n\nSi raccomanda l'iscrizione."
        ],
        "fr": [
          "Rendez-vous pour une Halloween Party et une grande chasse aux bonbons. \n\nDéguisements terrifiants conseillés.\n\nOuvert à tous.\n\nInscription conseillée."
        ],
        "es": [
          "Únete a nosotros para una fiesta de Halloween y truco o trato.\n\nSe recomiendan disfraces terroríficos.\n\nAbierto a todos.\n\nSe recomienda inscribirse."
        ],
        "nl": [
          "Kom naar het Halloweenfeest en doe mee aan trick-or-treating.\n\nEnge kostuums aanbevolen.\n\nVoor iedereen toegankelijk.\n\nRegistratie aanbevolen."
        ]
      },
