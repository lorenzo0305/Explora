  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit folgenden Spezialitäten: Aubrac-Rind, Sarladaises-Äpfel, Laguiole-Wurst... Eine wahre Geschmacksreise, die Sie gerne wiederkommen lassen wird!"
    ],
    "en": [
      "Traditional restaurant with specialities such as aubrac beef, Sarlat apples, laguiole charcuterie... A real gustatory journey that will make you want to come back!"
    ],
    "it": [
      "Ristorante tradizionale con specialità come il manzo di Aubrac, le mele di Sarladaises, i salumi di Laguiole... Un vero e proprio viaggio gustativo che vi farà venire voglia di tornare!"
    ],
    "fr": [
      "Restaurant traditionnel avec comme spécialités : boeuf d'aubrac, pommes sarladaises, charcuterie de laguiole...Un vrai voyage gustatif qui vous donnera envie de revenir !"
    ],
    "nl": [
      "Traditioneel restaurant met specialiteiten zoals rundvlees uit aubrac, appels uit sarladaises, charcuterie uit laguiole... Een echte culinaire reis waar u graag terugkomt!"
    ],
    "es": [
      "Restaurante tradicional con especialidades como la ternera de aubrac, las manzanas de sarladaises, los embutidos de laguiole... ¡Un auténtico viaje gustativo que le hará desear volver!"
    ]
  },
