      "dc:description": {
        "de": [
          "Dieses City-Stadion ist ein eingezäunter Platz im Freien, auf dem Ballspiele oder andere Spiele gespielt werden können.\nDer Kunstrasenplatz sorgt für eine Lärmdämpfung."
        ],
        "en": [
          "This city stadium is a fenced-in outdoor pitch for ball games and other activities.\nThe synthetic pitch reduces noise."
        ],
        "it": [
          "Questo stadio cittadino è un campo recintato all'aperto per partite di pallone e altre attività.\nIl campo sintetico riduce il rumore."
        ],
        "fr": [
          "Ce city stade est un terrain de jeux de ballons ou autres, en extérieur et clôturé.\nLe terrain synthétique permet une atténuation du bruit."
        ],
        "es": [
          "Este estadio urbano es un campo al aire libre vallado para partidos de pelota y otras actividades.\nEl césped sintético reduce el ruido."
        ],
        "nl": [
          "Dit stadsstadion is een omheind buitenveld voor balspelen en andere activiteiten.\nHet synthetische veld vermindert het lawaai."
        ]
      },
