      "@id": "https://data.datatourisme.fr/709316ca-c071-357f-ac8b-654047e3da2b",
      "dc:description": {
        "de": [
          "Qualitätsgastronomie mit frischen regionalen Produkten an einem gemütlichen Ort, der eine außergewöhnliche Terrasse mit über 100 Plätzen in aller Sicherheit für Kinder anbietet."
        ],
        "en": [
          "Quality catering of fresh regional produce in a warm and welcoming setting, with a terrace seating over 100 people and a child-friendly environment."
        ],
        "it": [
          "Un ristorante di qualità che serve prodotti regionali freschi in un ambiente accogliente, con una terrazza che può ospitare oltre 100 persone ed è completamente sicura per i bambini."
        ],
        "fr": [
          "Restauration de qualité de produits frais régionaux dans un endroit chaleureux proposant une terrasse hors normes de plus de 100 places en toute sécurité pour les enfants."
        ],
        "es": [
          "Un restaurante de calidad que sirve productos frescos de la región en un entorno acogedor, con una terraza con capacidad para más de 100 comensales y totalmente segura para los niños."
        ],
        "nl": [
          "Een kwaliteitsrestaurant dat verse streekproducten serveert in een gezellige omgeving, met een terras dat plaats biedt aan meer dan 100 personen en volledig veilig is voor kinderen."
        ]
      },
