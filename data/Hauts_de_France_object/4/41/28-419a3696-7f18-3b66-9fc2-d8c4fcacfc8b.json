      "dc:description": {
        "de": [
          "BAR - TABAK - PRESSE.\n\nTäglich geöffnet - von 7 Uhr bis 22 Uhr.\n\nKundentyp: 18 bis 78 Jahre.\n\nArt der Musik: abwechslungsreich.\n\nGruppen bis zu 30 Personen zulässig."
        ],
        "en": [
          "BAR - TABAC - PRESSE.\n\nOpen every day - 7am to 10pm.\n\nClientele: 18 to 78 years old.\n\nType of music: varied.\n\nGroups of up to 30 people."
        ],
        "it": [
          "BAR - TABACCO - STAMPA.\n\nAperto tutti i giorni dalle 7 alle 22.\n\nClientela: dai 18 ai 78 anni.\n\nTipo di musica: varia.\n\nGruppi fino a 30 persone."
        ],
        "fr": [
          "BAR - TABAC - PRESSE.\n\nOuvert tous les jours - de 7h à 22h.\n\nType de clientèle : 18 à 78 ans.\n\nType de musique : variée.\n\nGroupes acceptés jusqu'à 30 personnes."
        ],
        "nl": [
          "BAR - TABAK - PERS.\n\nElke dag geopend van 7.00 tot 22.00 uur.\n\nKlantenkring: 18 tot 78 jaar.\n\nSoort muziek: gevarieerd.\n\nGroepen tot 30 personen."
        ],
        "es": [
          "BAR - TABACO - PRENSA.\n\nAbierto todos los días de 7.00 a 22.00 horas.\n\nClientela: de 18 a 78 años.\n\nTipo de música: variada.\n\nGrupos de hasta 30 personas."
        ]
