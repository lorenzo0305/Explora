      "@id": "https://data.datatourisme.fr/35a88ecf-97d3-30d3-972a-04067d37b1d0",
      "dc:description": {
        "de": [
          "My equidream bietet Ihnen Schnupperkurse, Ausritte.\nTageskurse, Arbeit mit dem Pferd, Wettkampfcoaching.\nVerleih von Ponys und Pferden und Pensionen."
        ],
        "en": [
          "My equidream offers discovery lessons and rides.\nDay courses, horse work, competition coaching.\nPony and horse rental and boarding."
        ],
        "it": [
          "My equidream offre lezioni di scoperta e passeggiate.\nCorsi diurni, lavoro a cavallo, coaching per le competizioni.\nNoleggio e pensione di pony e cavalli."
        ],
        "fr": [
          "My equidream vous propose des cours de découverte, des balades. \nDes stages à la journée, travail du cheval, coaching compétition.\nDe la location de poney et cheval et de la pension."
        ],
        "nl": [
          "My equidream biedt ontdekkingslessen en ritten aan.\nDagcursussen, paardenwerk, wedstrijdcoaching.\nPony- en paardenverhuur en pension."
        ],
        "es": [
          "Mi equidream ofrece lecciones de descubrimiento y paseos.\nCursos de un día, trabajo con caballos, entrenamiento para competiciones.\nAlquiler y pupilaje de ponis y caballos."
        ]
      },
