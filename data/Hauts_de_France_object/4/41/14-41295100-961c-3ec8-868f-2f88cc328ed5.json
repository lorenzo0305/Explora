      "@id": "https://data.datatourisme.fr/9df10257-145e-3282-acad-79e601c903e1",
      "dc:description": {
        "de": [
          "Escape Game und Spurensuche. Rätsel, die es zu lösen gilt, um sich mit der Familie oder mit Freunden zu amüsieren.\n\nTäglich von 10:00 bis 19:30 Uhr (Beginn der letzten Sitzung) geöffnet"
        ],
        "en": [
          "Escape Game and treasure hunt. Enigmas to solve to have fun with family or friends.\n\nOpen every day from 10am to 7.30pm (start of the last session)"
        ],
        "it": [
          "Giochi di fuga e cacce al tesoro. Enigmi da risolvere per divertirsi con la famiglia e gli amici.\n\nAperto tutti i giorni dalle 10.00 alle 19.30 (inizio dell'ultima sessione)"
        ],
        "fr": [
          "Escape Game et jeux de pistes. Des énigmes à résoudre pour s'amuser en famille ou entre amis.\n\nOuvert tous les jours de 10h à 19h30 (début de la dernière session)"
        ],
        "nl": [
          "Ontsnappingsspelletjes en schattenjachten. Enigma's om op te lossen voor het plezier met familie en vrienden.\n\nDagelijks geopend van 10.00 tot 19.30 uur (begin van de laatste sessie)"
        ],
        "es": [
          "Juego de escape y búsqueda del tesoro. Enigmas para resolver para divertirse con la familia y los amigos.\n\nAbierto todos los días de 10:00 a 19:30 (inicio de la última sesión)"
        ]
      },
