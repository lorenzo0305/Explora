  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bc04c7dc-daf9-3126-b811-640a9450d425",
      "dc:description": {
        "de": [
          "RDV um 15 Uhr an Montagen.\nVom Monument du Souvenir français bis zum Ostfriedhof: Entdecken Sie die Ausdrucksformen der Erinnerung an die Konflikte in Boulogne-sur-Mer.\nTreffpunkt vor dem Monument du Souvenir français.\nDauer: 1 Stunde 30 Minuten. Preis: 5? (kostenlos für Kinder unter 12 Jahren).\nOnline-Reservierung der Eintrittskarten erforderlich"
        ],
        "en": [
          "Mondays at 3pm.\nFrom the Monument du Souvenir français to the cimetière de l'Est, discover the expressions of the memory of conflicts in Boulogne-sur-Mer.\nMeet in front of the Monument du Souvenir français.\nDuration: 1H30. Price: 5? (free for children under 12).\nOnline ticket reservation required"
        ],
        "it": [
          "RDV alle 15.00 il lunedì.\nDal Monument du Souvenir français al cimetière de l'Est, scoprite le espressioni della memoria dei conflitti a Boulogne-sur-Mer.\nAppuntamento davanti al Monument du Souvenir français.\nDurata: 1H30. Ingresso: 5 euro (gratuito per i minori di 12 anni).\nI biglietti devono essere prenotati online"
        ],
        "fr": [
          "RDV à 15h les lundis.\nDu Monument du Souvenir français au cimetière de l'Est, découvrez les expressions de la mémoire des conflits à Boulogne-sur-Mer.\nRendez-vous devant le Monument du Souvenir français.\nDurée : 1H30. Tarif : 5€ (gratuit pour les moins de 12 ans).\nRéservation des billets en ligne obligatoire"
        ],
        "nl": [
          "RDV om 15u op maandag.\nVan het Monument du Souvenir français tot het cimetière de l'Est, ontdek de herinneringsuitingen aan de conflicten in Boulogne-sur-Mer.\nAfspraak voor het Monument du Souvenir français.\nDuur: 1H30. Toegangsprijs: €5 (gratis voor kinderen onder de 12 jaar).\nTickets moeten online worden gereserveerd"
        ],
        "es": [
          "RDV a las 15 h los lunes.\nDel Monument du Souvenir français a la cimetière de l'Est, descubra las expresiones de la memoria de los conflictos en Boulogne-sur-Mer.\nEncuentro frente al Monument du Souvenir français.\nDuración: 1H30. Entrada: 5 euros (gratuita para menores de 12 años).\nLas entradas deben reservarse en línea"
        ]
      },
      "@type": [
        "Description"
