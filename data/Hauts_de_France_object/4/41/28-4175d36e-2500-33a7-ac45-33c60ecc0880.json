  "rdfs:comment": {
    "de": [
      "Handwerkliche Rösterei vor Ort von Spezialitätenkaffee aus reinen Arabica-Bohnen ( Terroir, Micro-Lots, Bio-Kooperativen ) Verkostung\nVerkauf (lose Ware) und Verkostung von ca. 60 Bio-Tees (grüne, schwarze und weiße Tees), Rooibos, Früchte- und Kräutertees."
    ],
    "en": [
      "On-site artisan roasting of pure Arabica specialty coffees (terroir, micro-lots, organic cooperatives) Tasting\nSale (bulk) and tasting of around 60 organic teas (green, black and white), rooibos, fruit infusions and herbal teas."
    ],
    "it": [
      "Tostatura tradizionale in loco di caffè speciali di pura Arabica (locali, micro-lotti, cooperative biologiche) Degustazione\nVendita (sfusa) e degustazione di circa 60 tè biologici (verde, nero e bianco), rooibos, infusi di frutta e tisane."
    ],
    "fr": [
      "Torréfaction artisanale sur place de cafés de spécialités pur arabica ( terroir, micro-lots, coopératives bio ) Dégustation\nVente (vrac) et dégustation d'environ 60 Thés bio ( vert noir, blanc) Rooïbos, infusion de fruits, tisanes."
    ],
    "es": [
      "Tostado tradicional in situ de especialidades de café arábica puro (local, microlotes, cooperativas ecológicas) Degustación\nVenta (a granel) y degustación de unos 60 tés ecológicos (verde, negro y blanco), rooibos, infusiones de frutas y tisanas."
    ],
    "nl": [
      "Ter plaatse traditionele branding van zuivere Arabica-koffiespecialiteiten (lokale, micro-lots, biologische coöperaties) Proeverij\nVerkoop (los) en proeverij van ongeveer 60 biologische theesoorten (groen, zwart en wit), rooibos, vruchteninfusies en kruidenthee."
    ]
  },
