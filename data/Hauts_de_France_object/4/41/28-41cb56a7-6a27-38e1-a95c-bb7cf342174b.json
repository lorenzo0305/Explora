  "rdfs:comment": {
    "de": [
      "Dieser Triumphbogen, der an die gefallenen französischen Soldaten erinnert, wurde im September 1924 vom General, und Abgeordneten de Castelnau eingeweiht."
    ],
    "en": [
      "This triumphal arch, commemorating the memory of France's fallen soldiers, was inaugurated in September 1924 by General and Deputy de Castelnau."
    ],
    "it": [
      "Questo arco trionfale, che commemora la memoria dei soldati francesi caduti in battaglia, fu inaugurato nel settembre 1924 dal generale e deputato de Castelnau."
    ],
    "fr": [
      "Cet arc de triomphe, commémorant mémoire des soldats français tombés au combat, fut inauguré en septembre 1924 par le général, et député de Castelnau."
    ],
    "es": [
      "Este arco de triunfo, que conmemora la memoria de los soldados franceses caídos en combate, fue inaugurado en septiembre de 1924 por el General y Diputado de Castelnau."
    ],
    "nl": [
      "Deze triomfboog, ter nagedachtenis aan Franse soldaten die sneuvelden in de strijd, werd in september 1924 ingehuldigd door generaal en adjunct de Castelnau."
    ]
  },
