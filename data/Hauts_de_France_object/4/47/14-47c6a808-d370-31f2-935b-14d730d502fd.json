  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fb0e6da3-3cfe-3b21-9735-f76ede434759",
      "dc:description": {
        "de": [
          "Historische Rallye für Oldtimer, Start auf dem Rathausvorplatz.\nTreffpunkt um 8:00 Uhr, Abfahrt um 9:00 Uhr, Rückkehr um 19:00 Uhr.\nStart auf dem Rathausvorplatz, Ankunft im Restaurant l'Escale.\n30 Autos erwartet."
        ],
        "en": [
          "Historic rally for classic vehicles, departing from the town hall forecourt.\nMeeting at 8am, departure at 9am, return at 7pm.\nDeparture from the town hall forecourt, arrival at l'Escale restaurant.\n30 cars expected."
        ],
        "it": [
          "Raduno storico per veicoli d'epoca, con partenza dal piazzale del municipio.\nRitrovo alle 8.00, partenza alle 9.00, rientro alle 19.00.\nPartenza dal piazzale del municipio, arrivo al ristorante Escale.\nsono attese 30 auto."
        ],
        "fr": [
          "Rallye historique pour véhicules de collection, au départ du parvis de l'hôtel de ville.\nRendez-vous à 8h, départ à 9h, retour à 19h.\nDépart du parvis de l'hôtel de ville, arrivée au restaurant l'Escale.\n30 voitures attendues."
        ],
        "es": [
          "Rally histórico para vehículos clásicos, con salida desde la explanada del ayuntamiento.\nEncuentro a las 8h, salida a las 9h, regreso a las 19h.\nSalida de la explanada del ayuntamiento, llegada al restaurante Escale.\nse esperan 30 coches."
        ],
        "nl": [
          "Historische rally voor klassieke voertuigen, vertrek vanaf het voorplein van het stadhuis.\nSamenkomst om 8.00 uur, vertrek om 9.00 uur, terugkomst om 19.00 uur.\nVertrek vanaf het voorplein van het gemeentehuis, aankomst bij restaurant Escale.\ner worden 30 auto's verwacht."
        ]
      },
      "@type": [
        "Description"
      ],
