  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a28231ef-93ec-3898-b93d-b47d2a616f24",
      "dc:description": {
        "de": [
          "Parcours du Coeur 2024\nA 09h30 : Rdv Parc de la Chaumière - 09h45 : Aufwärmen mit Musik - 10h00 : Start der Märsche - Parcours N°1 ca. 3 km (zugänglich für Personen mit eingeschränkter Mobilität) -Parcours N°2 ca. 6 km (nicht zugänglich für Personen mit eingeschränkter Mobilität)\nKostenlos und ohne Anmeldung"
        ],
        "en": [
          "Parcours du Coeur 2024\nA 09h30 : Rdv Parc de la Chaumière - 09h45 : Warm-up with music - 10h00 : Start of the walks - Course N°1 about 3 km (accessible PMR) - Course N°2 about 6 km (not accessible PMR)\nFree and without registration"
        ],
        "it": [
          "Corso del Cuore 2024\nOre 09:30: Ritrovo Parc de la Chaumière - Ore 09:45: Riscaldamento con musica - Ore 10:00: Inizio delle passeggiate - Percorso N°1 circa 3 km (accessibile per PRM) - Percorso N°2 circa 6 km (non accessibile per PRM)\nGratuito e senza registrazione"
        ],
        "fr": [
          "Parcours du Coeur 2024\nA 09h30 : Rdv Parc de la Chaumière - 09h45 : Echauffement en musique - 10h00 : Départ des marches - Parcours N°1 environ 3 km (accessible PMR) -Parcours N°2 environ 6 km (non accessible PMR)\nGratuit et sans inscription"
        ],
        "nl": [
          "Cursus Coeur 2024\nOm 09:30: Trefpunt Parc de la Chaumière - 09:45: Warming-up met muziek - 10:00: Start van de wandelingen - Route N°1 ca. 3 km (toegankelijk voor PRM) - Route N°2 ca. 6 km (niet toegankelijk voor PRM)\nGratis en zonder inschrijving"
        ],
        "es": [
          "Curso del Corazón 2024\nA las 09:30: Punto de encuentro Parc de la Chaumière - 09:45: Calentamiento con música - 10:00: Inicio de las caminatas - Ruta N°1 aprox. 3 km (accesible para PMR) -Ruta N°2 aprox. 6 km (no accesible para PMR)\nGratuito y sin inscripción"
        ]
      },
