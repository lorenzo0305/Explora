      "@id": "https://data.datatourisme.fr/60628615-6f1a-329f-8577-724a2ade1128",
      "dc:description": {
        "de": [
          "Organisiert von der Boule Neuvilloise\nSamstag, 21. Februar 2026\nRue de la Chartreuse ? Neuville\n--------------------------\nOrt: auf dem Fußballplatz\nAls Triplette - Zielwurf: 14:30 Uhr\n \nGetränke und Sandwiches\nInformationen per E-Mail: simon.sergent@gmail.com oder labouleneuvilloise@gmail.com\n \nCredit: Pixabay"
        ],
        "en": [
          "Organized by Boule Neuvilloise\nSaturday, February 21, 2026\nRue de la Chartreuse ? Neuville\n--------------------------\nVenue: on the soccer pitch\nIn triples - Goal throw: 2:30 p.m\n \nRefreshment bar and sandwiches\nInformation by e-mail: simon.sergent@gmail.com or labouleneuvilloise@gmail.com\n \nCredit : Pixabay"
        ],
        "it": [
          "Organizzato dalla Boule Neuvilloise\nSabato 21 febbraio 2026\nRue de la Chartreuse ? Neuville\n--------------------------\nLuogo: sul campo di calcio\nTripletta - Tiro in porta: 14.30\n \nRinfresco e panini\nInformazioni via e-mail: simon.sergent@gmail.com o labouleneuvilloise@gmail.com\n \nCredito: Pixabay"
        ],
        "fr": [
          "Organisé par la Boule Neuvilloise\nSamedi 21 février 2026\nRue de la Chartreuse – Neuville\n--------------------------\nLieu : sur le terrain de foot\nEn triplette - Jet du but : 14h30\n \nBuvette et sandwichs\nInformations par mail : simon.sergent@gmail.com ou labouleneuvilloise@gmail.com\n \nCrédit : Pixabay"
        ],
        "es": [
          "Organizado por la Boule Neuvilloise\nSábado 21 de febrero de 2026\nRue de la Chartreuse ? Neuville\n--------------------------\nLugar: en el campo de fútbol\nTriples - Tiro a puerta: 14h30\n \nRefrescos y bocadillos\nInformación por correo electrónico: simon.sergent@gmail.com o labouleneuvilloise@gmail.com\n \nCrédito: Pixabay"
        ],
        "nl": [
          "Georganiseerd door de Boule Neuvilloise\nZaterdag 21 februari 2026\nRue de la Chartreuse ? Neuville\n--------------------------\nPlaats: op het voetbalveld\nTriples - Doelpunt: 14u30\n \nVersnaperingen en broodjes\nInformatie per e-mail: simon.sergent@gmail.com of labouleneuvilloise@gmail.com\n \nKrediet: Pixabay"
        ]
      },
