  "rdfs:comment": {
    "de": [
      "In einer grünen Umgebung können Sie sich in der Nähe der Côte Picarde und der Côte d'Opale erholen.\n15 Minuten von den Stränden und der Baie de Somme entfernt. 5 Minuten von den Gärten der Abtei von Valloires entfernt."
    ],
    "en": [
      "Come and recharge your batteries near the Côte Picarde and the Côte d'Opale.\n15 minutes from the beaches and Baie de Somme. 5 minutes from the gardens of Valloires Abbey."
    ],
    "it": [
      "Venite a fare il pieno di energia vicino alla Côte Picarde e alla Côte d'Opale.\nA 15 minuti dalle spiagge e dalla Baie de Somme. A 5 minuti dai giardini dell'Abbazia di Valloires."
    ],
    "fr": [
      "Dans un cadre de verdure, venez vous ressourcer proche de la Côte Picarde et de la Côte d'Opale.\nÀ 15 minutes des plages et de la Baie de Somme. À 5 minutes des jardins de l'Abbaye de Valloires."
    ],
    "es": [
      "Venga a reponer fuerzas cerca de la Côte Picarde y la Côte d'Opale.\nA 15 minutos de las playas y de la bahía de Somme. A 5 minutos de los jardines de la Abadía de Valloires."
    ],
    "nl": [
      "Kom nieuwe energie opdoen in de buurt van de Côte Picarde en de Côte d'Opale.\nOp 15 minuten van de stranden en de Baie de Somme. Op 5 minuten van de tuinen van de abdij van Valloires."
    ]
  },
