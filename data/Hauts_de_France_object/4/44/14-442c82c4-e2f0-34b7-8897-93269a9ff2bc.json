      "@id": "https://data.datatourisme.fr/cd3a991b-9ab2-3c43-b539-e516867e9711",
      "dc:description": {
        "de": [
          "Theaterstück mit Slam und Gitarre von der Compagnie L?embardée.\nUm 16 Uhr in der Mediathek.\nDauer der Vorstellung: 50 Minuten\nOrganisiert von der CA2BM.\nAb 14 Jahren.\nKostenlos mit Reservierung mediatheques.ca2bm.fr"
        ],
        "en": [
          "Play mixing Slam and guitar by the L?embardée company.\nAt 4pm at the mediatheque.\nRunning time: 50 minutes\nOrganized by the CA2BM.\nAges 14 and up.\nFree on reservation mediatheques.ca2bm.fr"
        ],
        "it": [
          "Spettacolo che unisce slam e chitarra della compagnia L'embardée.\nAlle 16.00 presso la biblioteca multimediale.\nDurata: 50 minuti\nOrganizzato dal CA2BM.\nDai 14 anni in su.\nGratuito con prenotazione mediatheques.ca2bm.fr"
        ],
        "fr": [
          "Pièce de théâtre mêlant Slam et guitare par la compagnie L’embardée.\nA 16h à la médiathèque. \nDurée du spectacle : 50 minutes\nOrganisé par la CA2BM.\nA partir de 14 ans. \nGratuit sur réservation mediatheques.ca2bm.fr"
        ],
        "es": [
          "Una obra que combina slam y guitarra a cargo de la compañía L'embardée.\nA las 16.00 h en la biblioteca multimedia.\nDuración: 50 minutos\nOrganizado por el CA2BM.\nA partir de 14 años.\nGratuito previa reserva mediatheques.ca2bm.fr"
        ],
        "nl": [
          "Een toneelstuk waarin slam en gitaar worden gecombineerd door het gezelschap L?embardée.\nOm 16.00 uur in de mediatheek.\nDuur: 50 minuten\nGeorganiseerd door CA2BM.\nVanaf 14 jaar.\nGratis na reservering mediatheques.ca2bm.fr"
        ]
      },
