      "@id": "https://data.datatourisme.fr/b7f868aa-e9e9-3148-96e7-e6872ec97a0d",
      "dc:description": {
        "de": [
          "Komm und lerne Djemben und afrikanische Percussion mit dem Verein Manifestaction kennen - Front de mer in Sainte Cécile - Anmeldung beim Office de Tourisme erforderlich - Ab 6 Jahren"
        ],
        "en": [
          "Come and try your hand at djembes and African percussion with the Manifestaction association - Seafront in Sainte Cécile - Registration essential at the Tourist Office - From 6 years upwards"
        ],
        "it": [
          "Venite a cimentarvi con i djembes e le percussioni africane con l'associazione Manifestaction - Lungomare di Sainte Cécile - Iscrizione obbligatoria presso l'Ufficio del Turismo - A partire da 6 anni"
        ],
        "fr": [
          "Viens d'initier aux djembés et aux percussions africaines avec l'association Manifestaction - Front de mer à Sainte Cécile - Inscription indispensable à l'Office de Tourisme - A partir de 6 ans"
        ],
        "es": [
          "Ven a probar el djembé y la percusión africana con la asociación Manifestaction - Paseo marítimo de Sainte Cécile - Inscripción obligatoria en la Oficina de Turismo - A partir de 6 años"
        ],
        "nl": [
          "Kom de djembes en Afrikaanse percussie uitproberen met de vereniging Manifestaction - Boulevard in Sainte Cécile - Inschrijving verplicht bij het toeristenbureau - Vanaf 6 jaar"
        ]
      },
