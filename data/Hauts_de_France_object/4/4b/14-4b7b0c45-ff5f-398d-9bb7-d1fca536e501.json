      "@id": "https://data.datatourisme.fr/e61ee963-cf76-33a2-9327-2f724ae446a8",
      "dc:description": {
        "de": [
          "Reime und Geschichten, gefolgt von einem Parcours zur Körperwahrnehmung.\nEin Moment der Verbundenheit, den man mit seinem Kind erleben kann."
        ],
        "en": [
          "Nursery rhymes and stories, followed by a physical awakening course.\nA moment of complicity to enjoy with your child."
        ],
        "it": [
          "Filastrocche e storie seguite da un percorso di attività fisica.\nUn momento di complicità da vivere con il proprio bambino."
        ],
        "fr": [
          "Comptines et histoires suivies d'un parcours d'éveil corporel.\nUn moment de complicité à vivre avec son enfant."
        ],
        "es": [
          "Rimas infantiles y cuentos seguidos de un recorrido de actividades físicas.\nUn momento de complicidad para disfrutar con su hijo."
        ],
        "nl": [
          "Kinderrijmpjes en verhaaltjes gevolgd door een bewegingsparcours.\nEen moment van medeplichtigheid om samen met je kind van te genieten."
        ]
      },
