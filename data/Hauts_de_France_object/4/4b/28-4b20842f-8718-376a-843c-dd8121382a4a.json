  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4ba26737-b707-3ee3-b16e-34aa2a4e6e72",
      "dc:description": {
        "de": [
          "Kommen Sie und genießen Sie gutes Grillfleisch in einem angenehmen Rahmen, Westernstimmung ist garantiert, mit Country-Musik, damit Sie während Ihres Essens diese schöne Zeit wieder aufleben lassen können."
        ],
        "en": [
          "Come and enjoy grilled meats in a pleasant setting, with a western atmosphere and country music to help you relive the good old days."
        ],
        "it": [
          "Venite a gustare la carne alla griglia in un ambiente piacevole, in un'atmosfera western garantita con musica country che vi aiuterà a rivivere questa meravigliosa epoca durante il vostro pasto."
        ],
        "fr": [
          "Venez déguster de bonnes grillades dans un cadre agréable, ambiance western assurée avec une musique country pour vous faire revivre le temps de votre repas cette belle époque."
        ],
        "es": [
          "Venga y disfrute de carnes a la parrilla en un entorno agradable, en un ambiente western garantizado y con música country que le ayudará a revivir esta maravillosa época durante su comida."
        ],
        "nl": [
          "Kom en geniet van gegrild vlees in een aangename omgeving, in een gegarandeerde westernsfeer met countrymuziek om je te helpen dit prachtige tijdperk opnieuw te beleven tijdens je maaltijd."
        ]
      },
