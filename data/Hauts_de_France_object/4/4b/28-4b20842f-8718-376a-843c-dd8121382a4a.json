  "rdfs:comment": {
    "de": [
      "Kommen Sie und genießen Sie gutes Grillfleisch in einer angenehmen Umgebung, Western-Atmosphäre mit Musik garantiert..."
    ],
    "en": [
      "Come and enjoy grilled meats in a pleasant setting, with a western atmosphere and live music..."
    ],
    "it": [
      "Venite a gustare un gustoso barbecue in un ambiente piacevole, con un'atmosfera western garantita e musica dal vivo..."
    ],
    "fr": [
      "Venez déguster de bonnes grillades dans un cadre agréable, ambiance western assurée avec une musique..."
    ],
    "es": [
      "Venga a disfrutar de una sabrosa barbacoa en un entorno agradable, con ambiente western garantizado y música en directo..."
    ],
    "nl": [
      "Kom genieten van een smakelijke barbecue in een aangenaam kader, met gegarandeerd een westernsfeer en livemuziek..."
