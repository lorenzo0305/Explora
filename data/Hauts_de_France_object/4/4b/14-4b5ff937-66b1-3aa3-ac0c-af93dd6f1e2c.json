  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/66b9b5a5-9463-3289-8c72-afe021f21d06",
      "dc:description": {
        "de": [
          "\"L'équilibre\" ist ein Restaurant mit einer Mischung aus modernen und traditionellen Geschmacksrichtungen.\nDie Speisekarte besteht aus 5 Vorspeisen, 5 Hauptgerichten und 5 Desserts.\nWeinbar mit Brettern zum Probieren mit Weinen im Glas."
        ],
        "en": [
          "\"L'équilibre\" is a restaurant with a mix of modern and traditional flavours.\nThe menu consists of 5 starters, 5 main courses and 5 desserts.\nWine bar with wine tasting boards with wines by the glass."
        ],
        "it": [
          "\"L'équilibre\" è un ristorante con un mix di sapori moderni e tradizionali.\nIl menu è composto da 5 antipasti, 5 piatti principali e 5 dessert.\nEnoteca con tavole da degustare con vini al bicchiere."
        ],
        "fr": [
          "\"L'équilibre est un restaurant au mélange de saveurs modernes et traditionnelles.\nLa carte se compose de 5 entrées, 5 plats et 5 desserts.\nBar à Vin avec planches à déguster avec vins au verre."
        ],
        "es": [
          "\"L'équilibre\" es un restaurante con una mezcla de sabores modernos y tradicionales.\nEl menú consta de 5 entrantes, 5 platos principales y 5 postres.\nBar de vinos con tablas para degustar con vinos por copa."
        ],
        "nl": [
          "\"L'équilibre is een restaurant met een mix van moderne en traditionele smaken.\nHet menu bestaat uit 5 voorgerechten, 5 hoofdgerechten en 5 desserts.\nWijnbar met borden om te proeven met wijnen per glas."
        ]
      },
