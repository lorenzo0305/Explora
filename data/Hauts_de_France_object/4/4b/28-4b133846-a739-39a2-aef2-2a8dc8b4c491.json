  "rdfs:comment": {
    "de": [
      "Das Sumpfgebiet Val de Vergne ist ein großes Feuchtgebiet im Tal der Schelde mit einer Fläche von fast 50 Hektar, das vom regionalen Naturpark gemeinsam mit der Gemeinde Hergnies verwaltet wird"
    ],
    "en": [
      "The Val de Vergne marsh is a vast wetland of almost 50 hectares in the Escaut valley, managed by the Regional Nature Park in conjunction with the commune of Hergnies"
    ],
    "it": [
      "La palude di Val de Vergne è una vasta area umida di quasi 50 ettari nella valle dell'Escaut, gestita dal Parco Naturale Regionale in collaborazione con il comune di Hergnies"
    ],
    "fr": [
      "Le marais du Val de Vergne est une vaste zone humide de la vallée de l'Escaut de près de 50 hectares gérée par le Parc naturel régional conjointement avec la commune d'Hergnies"
    ],
    "nl": [
      "Het moeras van Val de Vergne is een uitgestrekt waterrijk gebied van bijna 50 hectare in de Scheldevallei, dat wordt beheerd door het Regionaal Natuurpark in samenwerking met de gemeente Hergnies"
    ],
    "es": [
      "El pantano de Val de Vergne es una vasta zona húmeda de casi 50 hectáreas en el valle del Escaut, gestionada por el Parque Natural Regional en colaboración con el municipio de Hergnies"
    ]
  },
  "rdfs:label": {
