      "@id": "https://data.datatourisme.fr/b451ff27-603e-35aa-90d0-5059b90c72f7",
      "dc:description": {
        "de": [
          "Die Mediathek in Halloy-les-Pernois empfängt Sie :\n- dienstags von 16:00 bis 18:00 Uhr \n- am Mittwoch von 14 bis 17:30 Uhr \n- am Freitag von 16 bis 18 Uhr ;\n- am Samstag von 10:00 bis 12:30 Uhr."
        ],
        "en": [
          "The media library of Halloy-les-Pernois welcomes you:\n- tuesday from 16h to 18h\n- wednesday from 14h to 17h30\n- friday from 16h to 18h;\n- saturday from 10am to 12.30pm."
        ],
        "it": [
          "La mediateca di Halloy-les-Pernois vi dà il benvenuto:\n- il martedì dalle 16.00 alle 18.00\n- mercoledì dalle 14:00 alle 17:30\n- venerdì dalle 16:00 alle 18:00;\n- sabato dalle 10.00 alle 12.30."
        ],
        "fr": [
          "La médiathèque d'Halloy-les-Pernois vous accueille :\n- le mardi de 16h à 18h ; \n- le mercredi de 14h à 17h30 ; \n- le vendredi de 16h à 18h ;\n- le samedi de 10h à 12h30."
        ],
        "es": [
          "La mediateca de Halloy-les-Pernois le da la bienvenida:\n- los martes de 16 a 18 horas\n- los miércoles de 14 a 17:30 horas\n- viernes de 16 a 18 horas;\n- sábado de 10 a 12.30 horas."
        ],
        "nl": [
          "De mediatheek van Halloy-les-Pernois heet u welkom:\n- dinsdags van 16.00 tot 18.00 uur\n- woensdag van 14.00 tot 17.30 uur\n- vrijdag van 16.00 tot 18.00 uur;\n- zaterdag van 10.00 tot 12.30 uur."
        ]
      },
