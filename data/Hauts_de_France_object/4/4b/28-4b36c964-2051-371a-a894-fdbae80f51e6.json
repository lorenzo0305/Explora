  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c1462090-187f-3881-9970-8e5b61df58e9",
      "dc:description": {
        "de": [
          "Dieser englisch inspirierte Garten, der auf 2500 m2 angelegt wurde, enthüllt durch seine Beete mit Sträuchern, Stauden und alten Rosen einen großen botanischen Reichtum."
        ],
        "en": [
          "This English-inspired garden, laid out on 2500 m2, reveals a great botanical wealth through its shrub beds, perennials and old roses."
        ],
        "it": [
          "Questo giardino di ispirazione inglese, disposto su 2500 m2, rivela una grande ricchezza botanica attraverso le sue aiuole di arbusti, piante perenni e rose antiche."
        ],
        "fr": [
          "Ce jardin d'inspiration anglaise aménagé sur 2500 m2 dévoile à travers ses massifs d'arbustes, de vivaces et de roses anciennes une grande richesse botanique."
        ],
        "es": [
          "Este jardín de inspiración inglesa, distribuido en 2500 m2, revela una gran riqueza botánica a través de sus parterres de arbustos, plantas vivaces y rosales antiguos."
        ],
        "nl": [
          "Deze Engels geïnspireerde tuin, aangelegd op 2500 m2, onthult een grote botanische rijkdom door zijn heesterperken, vaste planten en oude rozen."
        ]
      },
      "@type": [
        "Description"
