      "dc:description": {
        "de": [
          "Bäckerei und Lebensmittelgeschäft, in dem Sie eine große Auswahl an Produkten finden: Brot, lokale Produkte, frische Produkte... Möglichkeit, vor Ort zu essen."
        ],
        "en": [
          "Bakery and grocery store offering a wide choice of products: bread, local produce, fresh products... On-site catering available."
        ],
        "it": [
          "Panificio e negozio di alimentari dove troverete un'ampia scelta di prodotti: pane, prodotti locali, prodotti freschi... Catering disponibile in loco."
        ],
        "fr": [
          "Boulangerie Epicerie où vous retrouverez un large de choix de produits : pain, produits locaux, produits frais... Possibilité de restauration sur place."
        ],
        "es": [
          "Panadería y tienda de comestibles donde encontrará una amplia selección de productos: pan, productos locales, productos frescos... Catering disponible in situ."
        ],
        "nl": [
          "Bakkerij en kruidenierswinkel waar je een ruime keuze aan producten vindt: brood, streekproducten, verse producten... Catering ter plaatse mogelijk."
        ]
