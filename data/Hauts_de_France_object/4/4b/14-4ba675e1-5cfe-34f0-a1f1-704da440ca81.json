  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c28fc9fb-7efd-3c8f-99cb-c4f42edb566e",
      "dc:description": {
        "de": [
          "In Montcavrel geborene und aufgezogene Tiere. Werden mit Produkten gefüttert, die hauptsächlich auf dem Hof angebaut werden, mit Leinsamen. Die Konserven werden mit ihrem Fleisch hergestellt.\n\nVerkauf vor Ort, Bestellungen per Telefon, Internet oder Facebook"
        ],
        "en": [
          "Animals born and raised in Montcavrel. Fed on produce grown mainly on the farm with linseed. Their meat is used to make preserves.\n\nSales on site, orders by phone, Internet or Facebook"
        ],
        "it": [
          "Animali nati e allevati a Montcavrel. Nutriti con prodotti coltivati principalmente in azienda e con semi di lino. La carne viene utilizzata per la preparazione delle conserve.\n\nVendita sul posto, ordini per telefono, Internet o Facebook"
        ],
        "fr": [
          "Animaux nés et élevés à Montcavrel. Nourris avec les produits essentiellement cultivés sur la ferme avec de la graine de lin. Les conserves sont élaborées avec leur viande.\n\nVente sur place, commande par téléphone, Internet ou Facebook"
        ],
        "nl": [
          "Dieren geboren en gefokt in Montcavrel. Gevoed met producten die voornamelijk op de boerderij worden verbouwd met lijnzaad. Het vlees wordt gebruikt voor de conserven.\n\nVerkoop ter plaatse, bestellingen via telefoon, internet of Facebook"
        ],
        "es": [
          "Animales nacidos y criados en Montcavrel. Alimentados con productos cultivados principalmente en la granja con semillas de lino. La carne se utiliza para elaborar las conservas.\n\nVenta in situ, pedidos por teléfono, Internet o Facebook"
        ]
      },
      "@type": [
        "Description"
      ],
