  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9ee26b99-08fe-3fa9-9835-0eb29ccec87f",
      "dc:description": {
        "de": [
          "Carl Herickson, ein großer amerikanischer Filmstar, bringt unbeabsichtigt das Leben eines Pariser Trios durcheinander: einen einflussreichen Chefredakteur, seine Lebensgefährtin, eine Theaterschauspielerin, und die beste Freundin des Paares, eine junge, ehrgeizige Journalistin."
        ],
        "en": [
          "American movie star Carl Herickson unwittingly turns the lives of a Parisian trio upside down: an influential editor, his girlfriend, a stage actress, and the couple's best friend, an ambitious young journalist."
        ],
        "it": [
          "Carl Herickson, una grande star del cinema americano, sconvolge involontariamente la vita di un trio parigino: un influente editore, la sua fidanzata, un'attrice di teatro, e il migliore amico della coppia, un giovane e ambizioso giornalista."
        ],
        "fr": [
          "Carl Herickson, grande vedette de cinéma américaine, va, sans le vouloir, chambouler la vie d’un trio parisien: un rédacteur en chef influent, sa compagne, une actrice de théâtre, et la meilleure amie du couple, une jeune journaliste ambitieuse."
        ],
        "es": [
          "Carl Herickson, una gran estrella del cine americano, pone patas arriba sin querer la vida de un trío parisino: un influyente editor, su novia, una actriz de teatro, y la mejor amiga de la pareja, una joven y ambiciosa periodista."
        ],
        "nl": [
          "Carl Herickson, een belangrijke Amerikaanse filmster, zet ongewild het leven van een Parijs trio op zijn kop: een invloedrijke redacteur, zijn vriendin, een theateractrice, en de beste vriend van het stel, een ambitieuze jonge journalist."
        ]
      },
