      "@id": "https://data.datatourisme.fr/3f0da06e-b75d-30d5-a8bc-26da3658862d",
      "dc:description": {
        "de": [
          "Bar-Brasserie am Wasser mit Terrasse: Teiche (Forellen, Weißfische, Karpfen, Raubfische), Minigolf, Boulespiel, saisonale Vermietungen (Mobilheime), private oder öffentliche Veranstaltungen"
        ],
        "en": [
          "Waterside bar-brasserie with terrace: ponds (trout, whitefish, carp, carnivorous fish), mini-golf, pétanque, seasonal rentals (mobile homes), private or public events"
        ],
        "it": [
          "Bar-brasserie sull'acqua con terrazza: laghetti (trote, coregoni, carpe, predatori), minigolf, bocce, affitti stagionali (case mobili), eventi privati o pubblici"
        ],
        "fr": [
          "Bar-brasserie au bord de l'eau avec terrasse: étangs (truites, blancs, carpes, carnassiers), mini-golf, pétanque, locations saisonnières (mobil-homes), journées événementielles privées ou publiques"
        ],
        "nl": [
          "Bar-brasserie aan het water met terras: vijvers (forel, witvis, karper, roofvissen), minigolf, petanque, seizoensverhuur (stacaravans), privé- of openbare evenementen"
        ],
        "es": [
          "Bar-brasserie a orillas del agua con terraza: estanques (trucha, pescado blanco, carpa, depredadores), minigolf, petanca, alquiler de temporada (casas móviles), eventos privados o públicos"
        ]
      },
