  "rdfs:comment": {
    "de": [
      "Das Dorf Faÿ wurde während der Schlachten an der Somme im Jahr 1916 völlig verwüstet. Heute sind die Überreste als Orte der Besinnung ein Symbol für diesen Konflikt."
    ],
    "en": [
      "The village of Faÿ was totally devastated during the battles of the Somme in 1916. Today, the remnants are a symbol of the conflict."
    ],
    "it": [
      "Il villaggio di Faÿ fu completamente devastato durante le battaglie della Somme nel 1916. Oggi i resti sono luoghi di memoria e simboleggiano il conflitto."
    ],
    "fr": [
      "Le village de Faÿ a été totalement dévasté lors des batailles de la Somme en 1916. Aujourd'hui, les vestiges, lieux de recueillement, sont le symbole de ce conflit."
    ],
    "nl": [
      "Het dorp Faÿ werd volledig verwoest tijdens de gevechten aan de Somme in 1916. Tegenwoordig zijn de overblijfselen herdenkingsplaatsen en symboliseren ze het conflict."
    ],
    "es": [
      "El pueblo de Faÿ fue totalmente devastado durante las batallas del Somme en 1916. Hoy en día, sus vestigios son lugares de recuerdo y simbolizan el conflicto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les vestiges de l'ancien village de Faÿ"
    ]
  },
