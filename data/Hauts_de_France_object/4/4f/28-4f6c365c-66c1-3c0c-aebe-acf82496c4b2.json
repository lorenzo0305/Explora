  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich ein Erlebnis, das Entdeckung, Natur, Sport und Spaß miteinander verbindet, indem Sie an einer Tour mit dem Elektroroller teilnehmen!\nJérôme nimmt Sie mit auf die Wege von G?ulzin und Cantin, auf Feldwege und entlang des kleinen Flusses Sensée... Eine erfrischende Fahrt!"
    ],
    "en": [
      "Treat yourself to an experience that combines discovery, nature, sport and fun on an electric scooter tour!\nJérôme will take you on a tour of the G?ulzin and Cantin roads, country paths and along the Petite Sensée... A refreshing ride!"
    ],
    "it": [
      "Regalatevi un'esperienza che unisce scoperta, natura, sport e divertimento con un tour in scooter elettrico!\nJérôme vi condurrà lungo le strade di Gölzin e Cantin, lungo i sentieri di campagna e lungo la Petite Sensée... Un giro rinfrescante!"
    ],
    "fr": [
      "Offrez-vous une expérience qui allie découverte, nature, sport et amusement en participant à une visite à trottinette électrique !\nJérôme vous emmène sur les chemins de Gœulzin et de Cantin, sur les sentiers de campagne, et le long de la petite Sensée... Une balade rafraîchissante !"
    ],
    "nl": [
      "Trakteer jezelf op een ervaring die ontdekking, natuur, sport en plezier combineert tijdens een elektrische scootertocht!\nJérôme neemt je mee over de wegen in Güllzin en Cantin, over landweggetjes en langs de Petite Sensée... Een verfrissende rit!"
    ],
    "es": [
      "Regálate una experiencia que combina descubrimiento, naturaleza, deporte y diversión en una excursión en scooter eléctrico\nJérôme le llevará por las carreteras de G?ulzin y Cantin, por caminos rurales y por la Petite Sensée... ¡Un paseo refrescante!"
    ]
  },
