  "rdfs:comment": {
    "de": [
      "Das Restaurant des Hotels Bonanite empfängt Sie von Montag bis Freitag und serviert Ihnen Menüs und Speisekarten im Speisesaal oder an schönen Tagen auf der schattigen Terrasse.\nFür Familien- oder Vereinsveranstaltungen am Wochenende steht Ihnen das private Restaurant zur Verfügung."
    ],
    "en": [
      "The Hotel Bonanite restaurant welcomes you from Monday to Friday to enjoy its menus and menus served in the dining room or on the shaded terrace in fine weather.\nFor family or association events at weekends, you can use the private restaurant."
    ],
    "it": [
      "Il ristorante dell'Hotel Bonanite è aperto dal lunedì al venerdì e serve menù e menu nella sala da pranzo o sulla terrazza ombreggiata nella bella stagione.\nPer eventi familiari o associativi nel fine settimana, è possibile utilizzare il ristorante privato."
    ],
    "fr": [
      "Le restaurant de l'hôtel Bonanite vous accueille du lundi au vendredi pour profiter de ses menus et cartes servis dans sa salle à manger ou en terrasse ombragée aux beaux jours. \nPour toutes manifestations familiales ou associatives le week-end, vous disposerez du restaurant privatisé."
    ],
    "nl": [
      "Het restaurant van Hotel Bonanite is open van maandag tot vrijdag en serveert menu's in de eetzaal of bij mooi weer op het schaduwrijke terras.\nVoor familie- of verenigingsevenementen in het weekend kunt u gebruik maken van het privérestaurant."
    ],
    "es": [
      "El restaurante del Hotel Bonanite está abierto de lunes a viernes y sirve menús y cartas en el comedor o en la terraza a la sombra cuando hace buen tiempo.\nPara eventos familiares o de asociaciones durante el fin de semana, puede utilizar el restaurante privado."
    ]
  },
  "rdfs:label": {
