  "rdfs:comment": {
    "de": [
      "Theater Nur noch wenige Wochen bis \"Der Vorname\"!\nIn weniger als einem Monat kommt die berühmte Komödie \"Der Vorname\" auf die Bühne in Noyelles-Godault, für einen Theaterabend, den man nicht verpassen sollte!"
    ],
    "en": [
      "Theater Only a few weeks to go until \"Le Prénom\"!\nIn less than a month, the famous comedy \"Le Prénom\" takes to the stage in Noyelles-Godault for an unmissable evening of theatre!"
    ],
    "it": [
      "Teatro Mancano poche settimane a \"Le Prénom\"!\nTra meno di un mese, la famosa commedia \"Le Prénom\" andrà in scena a Noyelles-Godault per un'imperdibile serata di teatro!"
    ],
    "fr": [
      "Théâtre Plus que quelques semaines avant \"Le Prénom\" !\nDans moins d’un mois, la célèbre comédie \"Le Prénom\" débarque sur scène, à Noyelles-Godault, pour une soirée théâtrale immanquable !"
    ],
    "nl": [
      "Theater Nog maar een paar weken te gaan tot \"Le Prénom\"!\nOver minder dan een maand staat de beroemde komedie \"Le Prénom\" op de planken van Noyelles-Godault voor een niet te missen theateravond!"
    ],
    "es": [
      "Teatro ¡Faltan pocas semanas para \"Le Prénom\"!\nEn menos de un mes, la famosa comedia \"Le Prénom\" subirá al escenario de Noyelles-Godault para una velada teatral ineludible"
    ]
  },
  "rdfs:label": {
    "fr": [
