  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/15ec9b93-cb6b-376b-a618-892834562747",
      "dc:description": {
        "de": [
          "Der Verein des Schlosses von Fressin lädt Sie zu seinem pyrotechnischen Spektakel \"Les Folles Nuts du Monde\" am 1. und 2. August 2025 ein. Die Türen öffnen sich ab 19.30 Uhr mit Getränken und Speisen vor Ort. Weitere Informationen finden Sie auf dem Plakat"
        ],
        "en": [
          "The Château de Fressin association invites you to its fireworks show \"Les Folles Nuts du Monde\" on August 1 and 2, 2025. Doors open at 7:30pm, with refreshments and food available on site. For more information, see the poster"
        ],
        "it": [
          "L'Associazione Château de Fressin vi invita allo spettacolo di fuochi d'artificio \"Les Folles Nuts du Monde\" l'1 e il 2 agosto 2025. Le porte si aprono alle 19.30, con rinfreschi e cibo disponibili sul posto. Per maggiori informazioni, consultare la locandina"
        ],
        "fr": [
          "L'association du château de Fressin vous invite à son spectacle pyrotechnique \"Les Folles Nuts du Monde\" les 1er et 2 août 2025, ouverture des portes à partir de 19h30 avec buvette et restauration sur place . Pour plus d'informations, voir l'affiche"
        ],
        "es": [
          "La Asociación Château de Fressin le invita a su espectáculo de fuegos artificiales \"Les Folles Nuts du Monde\" los días 1 y 2 de agosto de 2025. Las puertas se abren a las 19.30 h, con refrescos y comida disponibles in situ. Para más información, consulte el cartel"
        ],
        "nl": [
          "De vereniging Château de Fressin nodigt je uit voor haar vuurwerkshow \"Les Folles Nuts du Monde\" op 1 en 2 augustus 2025. De deuren gaan open om 19.30 uur, met versnaperingen en eten ter plaatse. Voor meer informatie, zie de poster"
        ]
      },
      "@type": [
        "Description"
