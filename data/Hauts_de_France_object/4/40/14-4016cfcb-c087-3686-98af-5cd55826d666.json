  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3e1aaaac-faf7-3085-a2d1-95ecb7f5e55f",
      "dc:description": {
        "de": [
          "Auf der einen Seite eine Friterie ...\nfinden Sie Amerikanisch, hausgemachte Hamburger...\nund auf der anderen Seite eine Brasserie ...\nfinden Sie Muscheln, Fleisch, Fisch, Welch."
        ],
        "en": [
          "On one side, a French fry shop...\nyou'll find American, homemade hamburger...\nand on the other, a brasserie...\nyou'll find mussels, meats, fish and welch."
        ],
        "it": [
          "Da un lato, un negozio di patatine...\ntroverete hamburger americani fatti in casa...\ne dall'altra una brasserie...\ntroverete cozze, carne, pesce e welch."
        ],
        "fr": [
          "D'un côté, une Friterie...\nvous trouverez Américain , hamburger maison...\net de l'autre une brasserie..\nvous trouverez moules, viandes , poissons, welch."
        ],
        "es": [
          "Por un lado, una tienda de papas fritas...\nencontrarás hamburguesas caseras americanas...\ny por el otro una brasserie...\nencontrarás mejillones, carne, pescado y welch."
        ],
        "nl": [
          "Aan de ene kant een friettent...\nvind je Amerikaanse, zelfgemaakte hamburger...\nen aan de andere kant een brasserie...\nje vindt er mosselen, vlees, vis en welch."
        ]
      },
