  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9258f54e-2eda-374a-8228-92574d59e678",
      "dc:description": {
        "de": [
          "Sie werden in diesem Restaurant eine traditionelle Küche, regionale Gerichte, Grillspezialitäten und eine außergewöhnliche Gastfreundschaft in einem warmen und zeitgemäßen Rahmen entdecken."
        ],
        "en": [
          "You will discover in this restaurant, a traditional cuisine, local dishes, grilled meats and an extraordinary conviviality in a warm and contemporary setting."
        ],
        "it": [
          "In questo ristorante scoprirete una cucina tradizionale, piatti locali, carni alla griglia e una straordinaria convivialità, il tutto in un ambiente caldo e contemporaneo."
        ],
        "fr": [
          "Vous découvrirez dans ce restaurant , une cuisine de tradition, des plats du terroir, des grillades et une convivialité hors du commun le tout dans un cadre chaleureux et contemporain."
        ],
        "nl": [
          "In dit restaurant ontdekt u de traditionele keuken, streekgerechten, gegrild vlees en een buitengewone gezelligheid, dit alles in een warm en eigentijds kader."
        ],
        "es": [
          "En este restaurante, descubrirá la cocina tradicional, los platos locales, las carnes a la brasa y una extraordinaria convivencia, todo ello en un ambiente cálido y contemporáneo."
        ]
      },
