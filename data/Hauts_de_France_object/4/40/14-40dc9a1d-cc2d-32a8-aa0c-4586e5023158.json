  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b6166a35-7d33-3e4f-980a-01cfaca487f9",
      "dc:description": {
        "de": [
          "Le Repère de Torcy und der Verein Le Baladin de Torcy organisieren ein Essenskonzert.\nDie Stimme von Béatrice und die Gitarre von Pascal nehmen Sie mit auf eine musikalische Reise"
        ],
        "en": [
          "Le Repère de Torcy and the association Le Baladin de Torcy are organizing a meal concert.\nBéatrice's voice and Pascal's guitar will take you on a musical journey"
        ],
        "it": [
          "Le Repère de Torcy e l'associazione Le Baladin de Torcy organizzano un pranzo e un concerto.\nLa voce di Béatrice e la chitarra di Pascal vi accompagneranno in un viaggio musicale"
        ],
        "fr": [
          "Le Repère de Torcy et l'association Le Baladin de Torcy organisent un repas concert.\nLa voix de Béatrice et la guitare de Pascal vous emmènent en voyage musical"
        ],
        "es": [
          "Le Repère de Torcy y la asociación Le Baladin de Torcy organizan una comida y un concierto.\nLa voz de Béatrice y la guitarra de Pascal le llevarán en un viaje musical"
        ],
        "nl": [
          "Le Repère de Torcy en de vereniging Le Baladin de Torcy organiseren een maaltijd en een concert.\nDe stem van Béatrice en de gitaar van Pascal nemen je mee op een muzikale reis"
        ]
      },
      "@type": [
