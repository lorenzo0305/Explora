  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5630c75d-db5c-3e47-b940-74b342b5d720",
      "dc:description": {
        "de": [
          "Nur wenige Schritte vom Rathaus in der Rue Renan in Saint-Quentin entfernt lädt Sie das Restaurant Chez Mario ein, Italien zu genießen!\nPizza und Pasta stehen auf der Speisekarte.\nIm Frühling und Sommer können Sie auch seine Terrasse genießen!"
        ],
        "en": [
          "A few steps from the Town Hall on rue Renan in Saint-Quentin, the restaurant Chez Mario invites you to come and savour Italy!\nPizzas and pastas will be on the menu.\nIn spring and summer you can also enjoy its terrace!"
        ],
        "it": [
          "A pochi passi dal Municipio, in rue Renan a Saint-Quentin, il ristorante Chez Mario vi invita a venire a godervi l'Italia!\nIl menu prevede anche pizze e paste.\nIn primavera e in estate si può anche godere della sua terrazza!"
        ],
        "fr": [
          "À quelques pas de l'Hôtel de Ville rue Renan à Saint-Quentin le restaurant Chez Mario vous invite à venir savourer l'Italie !\nPizzas et pâtes seront au menu.\nAu printemps et en été vous pourrez aussi profiter de sa terrasse !"
        ],
        "nl": [
          "Op een steenworp afstand van het stadhuis in de rue Renan in Saint-Quentin nodigt restaurant Chez Mario u uit om te komen genieten van Italië!\nPizza's en pasta's staan op het menu.\nIn het voorjaar en de zomer kunt u ook genieten van het terras!"
        ],
        "es": [
          "A pocos pasos del Ayuntamiento, en la calle Renan de Saint-Quentin, el restaurante Chez Mario le invita a venir a disfrutar de Italia\nEl menú incluirá pizzas y pastas.\nEn primavera y verano también puedes disfrutar de su terraza"
        ]
      },
      "@type": [
        "Description"
      ],
