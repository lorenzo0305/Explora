  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3fbb5187-d5ae-3771-ad77-aa50fc9a6bd7",
      "dc:description": {
        "de": [
          "Im Herzen von Château-Thierry gelegen, können Sie im La Marmite Afro afro-karibische Küche probieren!\n\nSie werden Ihre Geschmacksknospen und auch Ihre Augen voll...\n\nVerkauf zum Mitnehmen und vor Ort."
        ],
        "en": [
          "Located in the heart of Château-Thierry, come and enjoy Afro-Caribbean cuisine at La Marmite Afro!\n\nYou'll love it, and you'll love it...\n\nTakeaway and on-site sales."
        ],
        "it": [
          "La Marmite Afro, nel cuore di Château-Thierry, propone una cucina afro-caraibica!\n\nIl ristorante è in grado di soddisfare le vostre papille gustative e anche i vostri occhi...\n\nDa asporto e da mangiare."
        ],
        "fr": [
          "Situé en plein cœur de Château-Thierry, venez déguster à La Marmite Afro de la cuisine Afro Caraibeen ! \n\nVous en aurez plein les papilles, et, plein les yeux...\n\nVente à emporter et sur place."
        ],
        "nl": [
          "La Marmite Afro, in het hart van Château-Thierry, serveert Afro-Caribische gerechten!\n\nHet zal uw smaakpapillen en ook uw ogen zeker bevallen...\n\nAfhalen en eten."
        ],
        "es": [
          "La Marmite Afro, en el corazón de Château-Thierry, sirve cocina afrocaribeña\n\nLe encantará a su paladar y a sus ojos...\n\nPara llevar y para comer."
        ]
      },
