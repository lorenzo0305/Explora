  "rdfs:comment": {
    "de": [
      "Ein Halt an dieser Gedenkstätte des Chemin des Dames, die Sie sich nicht entgehen lassen sollten und die gerade von der UNESCO zum Weltkulturerbe erklärt wurde (September 2023), lohnt sich..."
    ],
    "en": [
      "A visit to this not-to-be-missed memorial site on the Chemin des Dames, which has just been declared a World Heritage Site by UNESCO (September 2023), is a must..."
    ],
    "it": [
      "Non perdetevi questo sito commemorativo sullo Chemin des Dames, che è stato appena inserito dall'UNESCO nella lista del Patrimonio dell'Umanità (settembre 2023)..."
    ],
    "fr": [
      "Une halte s'impose dans ce haut-lieu mémoriel du Chemin des Dames à ne pas rater et qui vient d'être inscrit au patrimoine mondial de l'humanité par l'UNESCO (septembre 2023)..."
    ],
    "es": [
      "No se pierda este lugar conmemorativo en el Chemin des Dames, que acaba de ser declarado Patrimonio de la Humanidad por la UNESCO (septiembre de 2023)..."
    ],
    "nl": [
      "Mis deze gedenkplaats op de Chemin des Dames niet, die onlangs door UNESCO op de Werelderfgoedlijst is geplaatst (september 2023)..."
    ]
  },
