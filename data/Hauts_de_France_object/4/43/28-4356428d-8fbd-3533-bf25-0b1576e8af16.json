  "rdfs:comment": {
    "de": [
      "Um 1770 errichtete Stanislas Desandrouin, Verwalter der Compagnie d'Anzin und Enkel von Jacques, einem der bekanntesten Köhler\r\nvon Jacques (Entdecker der Kohle), ließ mit den Gewinnen, die er aus dem Kohlebergbau erzielte, ein prächtiges Haus bauen. Dieser Garten ist das Vermächtnis des Unternehmens."
    ],
    "en": [
      "Around 1770, Stanislas Desandrouin, director of the Compagnie d?Anzin and grandson of Jacques\r\nof Jacques (discoverer of coal), had a sumptuous residence built with the profits he made from coal mining. This garden is his legacy."
    ],
    "it": [
      "Intorno al 1770, Stanislas Desandrouin, direttore della Compagnie d'Anzin e nipote di Jacques\r\n(scopritore del carbone), fece costruire una sontuosa residenza con i profitti ottenuti dall'estrazione del carbone. Questo giardino è la sua eredità."
    ],
    "fr": [
      "Vers 1770, Stanislas Desandrouin, administrateur de la Compagnie d’Anzin et petit-fils\r\nde Jacques (découvreur du charbon), fait construire une somptueuse demeure avec les profits qu’il tire de l’activité charbonnière. Ce jardin en est l'heritage."
    ],
    "nl": [
      "Rond 1770 liet Stanislas Desandrouin, administrateur van de Compagnie d'Anzin en kleinzoon van Jacques Desandrouin (ontdekker van de steenkool), een luxueuze woning bouwen met de winsten die hij uit de steenkoolwinning haalde\r\n(ontdekker van de steenkool), liet een weelderige woning bouwen met de winsten die hij maakte met de steenkoolwinning. Deze tuin is zijn nalatenschap."
    ],
    "es": [
      "Hacia 1770, Stanislas Desandrouin, director de la Compagnie d'Anzin y nieto de Jacques\r\n(descubridor del carbón), se hizo construir una suntuosa residencia con los beneficios que obtenía de la minería del carbón. Este jardín es su legado."
    ]
  },
  "rdfs:label": {
