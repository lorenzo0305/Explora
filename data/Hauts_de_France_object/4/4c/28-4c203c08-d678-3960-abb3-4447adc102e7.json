  "rdfs:comment": {
    "de": [
      "Der Country-Club Château de Bertichères befindet sich in einem Schloss aus dem 17. Jahrhundert inmitten eines Waldgebiets, nur 45 Minuten von Paris/La Défense über die A15 und vom Flughafen Roissy-CDG und 30 Minuten vom Flughafen Beauvais entfernt. Hier kann man Golf, Tennis und Reiten spielen. Die Preise für die Unterkunft beinhalten den Zugang zum Tennisplatz. Kostenloser Privatparkplatz."
    ],
    "en": [
      "The Country Club of Château de Bertichères, established in a 17th century castle in the heart of a wooded estate, is only 45 minutes from the Paris/La Défense districts via the A15 and the Roissy-CDG airport and 30 minutes from Beauvais airport. You can play golf, tennis, horse riding... Accommodation rates include access to tennis. Free private parking."
    ],
    "it": [
      "Il Country-Club du Château de Bertichères, situato in un castello del XVII secolo nel cuore di una tenuta boscosa, si trova a soli 45 minuti da Parigi/La Défense tramite la A15 e l'aeroporto di Roissy-CDG e a 30 minuti dall'aeroporto di Beauvais. Potrete giocare a golf, tennis ed equitazione e le tariffe includono l'accesso al campo da tennis. Parcheggio privato gratuito."
    ],
    "fr": [
      "Le Country-Club du Château de Bertichères, établi dans un château du XVIIè s. au coeur d'un domaine boisé, n'est qu'à 45 mn des quartiers Paris/La Défense par l'A15 et de l'aéroport Roissy-CDG et à 30 mn de celui de Beauvais. On peut y pratiquer le golf , le tennis , l’équitation  Les tarifs d'hébergement incluent l'accès au tennis. Parking privé gratuit."
    ],
    "es": [
      "El Country-Club du Château de Bertichères, establecido en un castillo del siglo XVII en el corazón de una finca arbolada, está a sólo 45 minutos de París/La Défense por la A15 y el aeropuerto Roissy-CDG y a 30 minutos del aeropuerto de Beauvais. Se puede jugar al golf, al tenis y a la equitación. Las tarifas del alojamiento incluyen el acceso a la pista de tenis. Aparcamiento privado gratuito."
    ],
    "nl": [
      "De Country-Club du Château de Bertichères, gevestigd in een 17e eeuws kasteel in het hart van een bosrijk domein, ligt op slechts 45 minuten van Parijs/La Défense via de snelweg A15 en van de luchthaven Roissy-CDG en op 30 minuten van de luchthaven Beauvais. U kunt golfen, tennissen en paardrijden. De tarieven van de accommodatie zijn inclusief toegang tot de tennisbaan. Gratis privé parking."
    ]
  },
