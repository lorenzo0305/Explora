  "rdfs:comment": {
    "de": [
      "Dieses Familienrestaurant liegt an einer Durchgangsstraße, ist leicht zugänglich und verfügt über einen Privatparkplatz. Mit einer Kapazität von 70 Gedecken im Speisesaal. Ein warmer und freundlicher Rahmen, ideal für ein traditionelles Mittagessen oder ein authentisches Abendessen."
    ],
    "en": [
      "Situated on a busy thoroughfare, this family-run restaurant is easily accessible and has private parking. With a capacity of 70 covers in the dining room. A warm and friendly setting, ideal for a traditional lunch or an authentic dinner."
    ],
    "it": [
      "Situato su una strada trafficata, questo ristorante a conduzione familiare è facilmente accessibile e dispone di un parcheggio privato. Ha una capacità di 70 coperti nella sala da pranzo. Un ambiente caldo e accogliente, ideale per un pranzo tradizionale o una cena autentica."
    ],
    "fr": [
      "Situé sur un axe passant, ce restaurant familial est facilement accessible et dispose d'un parking privé. Avec une capacité d'accueil de 70 couverts en salle. Un cadre chaleureux et convivial, idéal pour un déjeuner traditionnel ou un dîner authentique."
    ],
    "es": [
      "Situado en una carretera muy transitada, este restaurante familiar es de fácil acceso y dispone de aparcamiento privado. Con capacidad para 70 cubiertos en el comedor. Un entorno cálido y acogedor, ideal para un almuerzo tradicional o una cena auténtica."
    ],
    "nl": [
      "Dit familierestaurant ligt aan een drukke weg, is goed bereikbaar en heeft privéparkeergelegenheid. Met een capaciteit van 70 couverts in de eetzaal. Een warm en vriendelijk kader, ideaal voor een traditionele lunch of een authentiek diner."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Ô Gueul’Ton"
    ]
  },
