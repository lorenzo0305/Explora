      "dc:description": {
        "de": [
          "Guinguette-Abend auf dem Quentovic-Platz.\nAb 18 Uhr.\nKostenlose Unterhaltung.\n\nTanzabend mit musikalischer Darbietung.\nVerpflegung vor Ort."
        ],
        "en": [
          "Guinguette evening on Place Quentovic.\nFrom 6pm.\nFree entertainment.\n\nDance party with live music.\nCatering on site."
        ],
        "it": [
          "Serata Guinguette in Place Quentovic.\nDalle 18.00.\nIntrattenimento gratuito.\n\nFesta da ballo con musica.\nCatering in loco."
        ],
        "fr": [
          "Soirée guinguette sur la place Quentovic.\nA partir de 18h.\nAnimation gratuite.\n\nSoirée dansante avec prestation musicale.\nRestauration sur place."
        ],
        "es": [
          "Velada Guinguette en la plaza Quentovic.\nA partir de las 18.00 h.\nAnimación gratuita.\n\nFiesta de baile con música.\nCatering in situ."
        ],
        "nl": [
          "Guinguette-avond op het Quentovicplein.\nVanaf 18.00 uur.\nGratis entertainment.\n\nDansfeest met muziek.\nCatering ter plaatse."
        ]
      },
