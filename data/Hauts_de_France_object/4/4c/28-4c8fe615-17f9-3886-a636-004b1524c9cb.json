      "@id": "https://data.datatourisme.fr/3dddc9b8-d0d8-37ae-b8c2-89dfff519a46",
      "dc:description": {
        "de": [
          "Freier Eintritt\nGrusel und Spannung, Krimis und Thriller sowie kleine Monster und heilige Zauberer.\nSpezielle Halloween-Buchhandlung für Groß und Klein mit \"Studio-Livres\", Galerie le Saint-Michel. Halloween-Fotoecke, Animationen für die ganze Familie...  Workshops für Kinder (von 13:30 bis 17:00 Uhr)."
        ],
        "en": [
          "Free admission\nThrills and chills, thrillers and thrillers, monsters and wizards.\nSpecial Halloween bookshop for young and old, with \"Studio-Livres\", galerie le Saint-Michel. Halloween photo corner, entertainment for the whole family...  Children's workshops (1:30pm to 5pm)."
        ],
        "it": [
          "Ingresso libero\nBrividi e suggestioni, thriller e gialli, mostri e stregoni.\nLibreria speciale di Halloween per grandi e piccini, con \"Studio-Livres\", galerie le Saint-Michel. Angolo fotografico di Halloween, animazione per tutta la famiglia...  Laboratori per bambini (dalle 13.30 alle 17.00)."
        ],
        "fr": [
          "Entrée libre\nFrissons et suspense, polars et thriller, et petits monstres et sacrés sorciers.\nLibrairie spéciale Halloween pour petits et grands, avec \"Studio-Livres\", galerie le Saint-Michel. Corner photo d'Halloween, animations pour toute la famille...  Ateliers pour enfants (de 13h30 à 17h)."
        ],
        "nl": [
          "Gratis toegang\nSpanning en sensatie, spanning en sensatie, monsters en tovenaars.\nSpeciale Halloween-boekenwinkel voor jong en oud, met \"Studio-Livres\", galerie le Saint-Michel. Halloween-fotohoek, animatie voor het hele gezin...  Workshops voor kinderen (van 13.30 tot 17.00 uur)."
        ],
        "es": [
          "Entrada gratuita\nSuspense y escalofríos, suspense y suspense, monstruos y hechiceros.\nLibrería especial Halloween para grandes y pequeños, con \"Studio-Livres\", galerie le Saint-Michel. Rincón de fotos de Halloween, animaciones para toda la familia...  Talleres para niños (de 13.30 a 17.00 h)."
        ]
      },
