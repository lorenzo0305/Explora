  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: die Lage Amiens Sud (Stadtrand), unmittelbarer Zugang zum Gürtel der Umgehungsstraße und der A16, die kleine Terrasse, um draußen zu frühstücken."
    ],
    "en": [
      "You'll love: the Amiens Sud location (on the outskirts of town), immediate access to the ring road and A16 motorway, small terrace for outdoor lunches."
    ],
    "it": [
      "Vi piacerà: la posizione di Amiens Sud (alla periferia della città), l'accesso immediato alla tangenziale e all'autostrada A16, la piccola terrazza per pranzare all'aperto."
    ],
    "fr": [
      "Vous aimerez : la situation Amiens Sud (périphérie de ville), accès ceinture rocade et A16 immédiat, la petite terrasse pour déjeuner dehors."
    ],
    "nl": [
      "U zult genieten van: de locatie Amiens Sud (aan de rand van de stad), de directe toegang tot de ringweg en de snelweg A16, het kleine terras om buiten te lunchen."
    ],
    "es": [
      "Le encantará: la ubicación de Amiens Sud (en las afueras de la ciudad), el acceso inmediato a la circunvalación y a la autopista A16, la pequeña terraza para almorzar al aire libre."
    ]
  },
