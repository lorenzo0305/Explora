        ],
        "en": [
          "Aux plaisirs des papilles, offers its services for your family meals, baptism, communion, marriage ... at home or in a room."
        ],
        "it": [
          "Aux plaisirs des papilles vi offre i suoi servizi per i vostri pasti in famiglia - battesimo, comunione, matrimonio... a casa o in una sala."
        ],
        "fr": [
          "Aux plaisirs des papilles,vous propose ses services pour vos prestations repas famille-baptême,communion,mariage...à domicile ou dans une salle."
        ],
        "es": [
          "Aux plaisirs des papilles, le ofrece sus servicios para sus comidas familiares - bautismo, comunión, boda... en casa o en un salón."
        ],
