      "@id": "https://data.datatourisme.fr/a0b642d7-8068-3d7f-bd02-23d6574ea240",
      "dc:description": {
        "de": [
          "Harley Davidson Versammlung.\nMotorradparkplatz Boulevard de la Plage.\n\nAnkunft am Freitag, den 6. Juni ab 15:30 Uhr.\nAbfahrt Montag, 10. Juni, ca. 10:30 Uhr."
        ],
        "en": [
          "Harley Davidson Gathering.\nMotorcycle parking on Boulevard de la Plage.\n\nArrival Friday June 6 from 3:30pm.\nDeparture Monday June 10 around 10:30 am."
        ],
        "it": [
          "Raduno di Harley Davidson.\nParcheggio moto sul Boulevard de la Plage.\n\nArrivo venerdì 6 giugno dalle 15.30.\nPartenza lunedì 10 giugno intorno alle 10.30."
        ],
        "fr": [
          "Rassemblement Harley Davidson.\nParking motos Boulevard de la Plage.\n\nArrivée vendredi 6 juin à partir de 15h30.\nDépart lundi 10 juin aux alentours de 10h30."
        ],
        "nl": [
          "Harley Davidson bijeenkomst.\nMotorstalling op Boulevard de la Plage.\n\nAankomst op vrijdag 6 juni vanaf 15.30 uur.\nVertrek maandag 10 juni rond 10.30 uur."
        ],
        "es": [
          "Concentración Harley Davidson.\nAparcamiento de motos en el Boulevard de la Plage.\n\nLlegada el viernes 6 de junio a partir de las 15.30 h.\nSalida el lunes 10 de junio hacia las 10.30 h."
        ]
      },
