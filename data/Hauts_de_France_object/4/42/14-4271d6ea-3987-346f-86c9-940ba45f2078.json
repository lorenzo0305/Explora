  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1faea18b-d68b-3631-9f30-df8804990e0d",
      "dc:description": {
        "de": [
          "Natürlich können Sie während des gesamten Pfingstwochenendes (von Samstag bis Dienstag) auch die Fahrgeschäfte und Stände unserer traditionellen Ducasse nutzen."
        ],
        "en": [
          "Of course, during the Whitsun weekend (from Saturday to Tuesday), come and enjoy the rides and stalls of our traditional ducasse."
        ],
        "it": [
          "E naturalmente, durante il fine settimana di Pentecoste (da sabato a martedì), venite a divertirvi con le giostre e le bancarelle del nostro tradizionale luna park."
        ],
        "fr": [
          "Bien sûr, durant tout le week-end de la Pentecôte (du samedi au mardi), venez aussi profiter des manèges et stands de notre traditionnelle ducasse."
        ],
        "es": [
          "Y, por supuesto, durante todo el fin de semana de Pentecostés (de sábado a martes), venga a disfrutar de las atracciones y puestos de nuestro tradicional parque de atracciones."
        ],
        "nl": [
          "En natuurlijk kun je tijdens het Pinksterweekend (zaterdag tot en met dinsdag) genieten van de attracties en kraampjes op onze traditionele kermis."
        ]
      },
