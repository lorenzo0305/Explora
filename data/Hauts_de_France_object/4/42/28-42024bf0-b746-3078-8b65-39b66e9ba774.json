  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5cbccde3-884f-3283-b0f8-75295e63d87d",
      "dc:description": {
        "de": [
          "Asiatisches Restaurant, das auf japanische und chinesische Küche spezialisiert ist. Es liegt am Ortsausgang von Villers-Cotterêts in Richtung La Ferté-Milon. Genießen Sie raffinierte Spezialitäten, Woks, Grillgerichte, Sushi und koreanische Barbecues... Izakya grill empfängt Sie von Dienstag bis Sonntag in einem warmen und freundlichen Rahmen."
        ],
        "en": [
          "Asian restaurant specializing in Japanese and Chinese cuisine located at the exit of Villers-Cotterêts, in the direction of La Ferté-Milon. Come and taste refined specialities, woks, grills, sushis and Korean barbecues... Izakya grill welcomes you from Tuesday to Sunday, in a warm and friendly atmosphere."
        ],
        "it": [
          "Ristorante asiatico specializzato in cucina giapponese e cinese situato alla periferia di Villers-Cotterêts, in direzione di La Ferté-Milon. Venite a gustare specialità raffinate, wok, grigliate, sushis e barbecue coreani... Il grill Izakya vi accoglie dal martedì alla domenica, in un'atmosfera calda e accogliente."
        ],
        "fr": [
          "Restaurant asiatique spécialisé dans la cuisine japonaise et chinoise situé à la sortie de Villers-Cotterêts, en direction de la Ferté-Milon. Venez déguster des spécialités raffinées, woks, grillades, sushis et barbecues coréens... Izakya grill vous accueille du mardi au dimanche, dans un cadre chaleureux et convivial."
        ],
        "es": [
          "Restaurante asiático especializado en cocina japonesa y china situado en las afueras de Villers-Cotterêts, en dirección a La Ferté-Milon. Venga a degustar refinadas especialidades, woks, parrillas, sushis y barbacoas coreanas... El asador Izakya le da la bienvenida de martes a domingo, en un ambiente cálido y acogedor."
        ],
        "nl": [
          "Aziatisch restaurant gespecialiseerd in de Japanse en Chinese keuken gelegen aan de rand van Villers-Cotterêts, in de richting van La Ferté-Milon. Kom proeven van verfijnde specialiteiten, wokken, grillen, sushi's en Koreaanse barbecues... Izakya grill verwelkomt u van dinsdag tot zondag, in een warme en vriendelijke sfeer."
        ]
      },
