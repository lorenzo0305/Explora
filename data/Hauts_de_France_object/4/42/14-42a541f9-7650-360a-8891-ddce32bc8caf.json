  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aea0ddbb-964f-3fe0-88ba-5f5b0ec64e73",
      "dc:description": {
        "de": [
          "Reserviert für Skateboarding, Inlineskating, Bmx und Scootering. Ein Bereich für die Ausübung von Basketball ist erlaubt. Das Tragen eines Helms ist Pflicht. Der Zugang ist frei und für Personen ab 10 Jahren reserviert. Kinder unter 10 Jahren müssen von einer volljährigen Person begleitet werden."
        ],
        "en": [
          "Reserved for skateboarding, rollerblading, bmx and scootering. A basketball area is authorized. Helmets must be worn. Access is free and reserved for skaters aged 10 and over. Children under 10 must be accompanied by an adult."
        ],
        "it": [
          "Riservata a skateboard, rollerblade, bmx e monopattino. È autorizzata un'area per il basket. È obbligatorio indossare il casco. L'accesso è gratuito e riservato agli utenti a partire dai 10 anni. I bambini sotto i 10 anni devono essere accompagnati da un adulto."
        ],
        "fr": [
          "Réservé aux pratiques du skate, roller, bmx et trottinette. Une zone pour la pratique du basket est autorisée. Port du casque obligatoire. L'accès est libre et réservé aux pratiquants de plus de 10 ans. Les enfants de moins de 10 ans doivent obligatoirement être accompagnés d'une personne majeure."
        ],
        "es": [
          "Reservado para skate, patines, bmx y patinetes. Se autoriza una zona de baloncesto. Es obligatorio el uso del casco. El acceso es gratuito y está reservado a los usuarios mayores de 10 años. Los menores de 10 años deben ir acompañados de un adulto."
        ],
        "nl": [
          "Gereserveerd voor skateboarden, rolschaatsen, bmx en steppen. Een basketbalzone is toegestaan. Het dragen van een helm is verplicht. De toegang is gratis en gereserveerd voor gebruikers vanaf 10 jaar. Kinderen onder de 10 moeten worden begeleid door een volwassene."
        ]
      },
      "@type": [
