  "rdfs:comment": {
    "de": [
      "Das im Zentrum der Stadt Noyon gelegene Théâtre du chevalet bietet ein vielfältiges Programm an bildender Kunst und Aufführungen. Theater, Komödie, Tanz, Konzerte...es ist für jeden Geschmack etwas dabei."
    ],
    "en": [
      "Located in the center of Noyon, the Théâtre du Chevalet offers a varied program of visual arts and shows. Theater, comedy, dance, concerts... there's something for everyone."
    ],
    "it": [
      "Situato nel centro della città di Noyon, il Théâtre du Chevalet offre un programma vario di arte e intrattenimento. Teatro, commedia, danza, concerti... ce n'è per tutti i gusti."
    ],
    "fr": [
      "Situé au centre de la ville de Noyon, le théâtre du chevalet propose une programmation d'arts plastiques et de spectacles variés. Théâtre, comédie, danse, concerts...il y en a pour tous les goûts."
    ],
    "es": [
      "Situado en el centro de la ciudad de Noyon, el Théâtre du Chevalet ofrece un variado programa de artes y espectáculos. Teatro, comedia, danza, conciertos... hay para todos los gustos."
    ],
    "nl": [
      "Het Théâtre du Chevalet ligt in het centrum van de stad Noyon en biedt een gevarieerd kunst- en amusementsprogramma. Theater, komedie, dans, concerten... er is voor elk wat wils."
    ]
  },
