  "rdfs:comment": {
    "de": [
      "Am Fuße der Hügel von Rosne, nur 50 Minuten von Paris entfernt, bietet Le Clos des Vignes 13 Zimmer, darunter 9 Suiten, in einem 12 Hektar großen ländlichen Anwesen mit Parks, Wiesen und Teichen. Die Inneneinrichtung verbindet sich auf natürliche Weise mit Holz und Stein. Auf dem Gelände befinden sich Jacuzzi, Schwimmbad, Fitnessraum..."
    ],
    "en": [
      "At the foot of the hills of Rosne, only 50 minutes from Paris, the Clos des Vignes offers 13 rooms including 9 suites, in a rural estate of 12 hectares of parks, meadows and ponds. The interior decoration blends naturally with wood and stone. On site, jacuzzi, swimming pool, fitness room..."
    ],
    "it": [
      "Ai piedi delle Buttes de Rosne, a soli 50 minuti da Parigi, il Clos des Vignes offre 13 camere, di cui 9 suite, in una tenuta rurale di 12 ettari di parchi, prati e stagni. L'arredamento è un mix naturale di legno e pietra. In loco, jacuzzi, piscina, sala fitness..."
    ],
    "fr": [
      "Au pied des buttes de Rosne, à seulement 50 mn de Paris, le Clos des Vignes offre 13 chambres dont 9 suites, dans un domaine rural de 12 hectares de parcs, prairies et étangs. La décoration d'intérieure se marie avec naturel au bois et à la pierre. Sur place, jacuzzi, piscine, salle de fitness..."
    ],
    "es": [
      "Al pie de las Buttes de Rosne, a sólo 50 minutos de París, el Clos des Vignes ofrece 13 habitaciones, incluidas 9 suites, en una finca de 12 hectáreas de parques, prados y estanques. La decoración interior es una mezcla natural de madera y piedra. En el lugar, jacuzzi, piscina, sala de fitness..."
    ],
    "nl": [
      "Aan de voet van de Buttes de Rosne, op slechts 50 minuten van Parijs, biedt de Clos des Vignes 13 kamers, waarvan 9 suites, op een landelijk landgoed van 12 hectare met parken, weiden en vijvers. De inrichting is een natuurlijke mix van hout en steen. Ter plaatse, jacuzzi, zwembad, fitnessruimte..."
    ]
  },
