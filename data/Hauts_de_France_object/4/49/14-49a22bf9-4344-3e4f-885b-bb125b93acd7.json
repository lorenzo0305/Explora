  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/14511a17-d701-3868-9314-675a05dbee84",
      "dc:description": {
        "de": [
          "Der Verein Act'In Scene lädt Sie um 20 Uhr in den Festsaal zur Aufführung des Theaterstücks \"Je préfère que on reste amis\" ein.\nEintritt frei."
        ],
        "en": [
          "The Act'In Scene association invites you to the Salle des Fêtes at 8pm for a performance of the play \"Je préfère qu'on reste amis\".\nAdmission free."
        ],
        "it": [
          "L'associazione Act'In Scene vi invita alla Salle des Fêtes alle 20.00 per la rappresentazione dello spettacolo \"Je préfère qu'on reste amis\".\nIngresso libero."
        ],
        "fr": [
          "L'association Act'In Scene vous donne rendez-vous à 20 heures à la salle des fêtes pour la représentation de la pièce de théâtre \" Je préfère qu'on reste amis\".\nEntrée libre."
        ],
        "es": [
          "La asociación Act'In Scene le invita a la Salle des Fêtes a las 20.00 h para asistir a la representación de la obra \"Je préfère qu'on reste amis\".\nEntrada gratuita."
        ],
        "nl": [
          "De vereniging Act'In Scene nodigt je om 20.00 uur uit in de Salle des Fêtes voor een voorstelling van het toneelstuk \"Je préfère qu'on reste amis\".\nGratis toegang."
        ]
      },
