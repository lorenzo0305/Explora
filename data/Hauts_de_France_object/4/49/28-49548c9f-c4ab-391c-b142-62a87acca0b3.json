  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/88e2355b-e2b2-39e9-9672-38ae8e597dc0",
      "dc:description": {
        "de": [
          "Sie wurde im 12. Jahrhundert erbaut und nach dem Ersten Weltkrieg restauriert. Sie liegt oberhalb des Dorfes und beherbergt ein gut erhaltenes Taufbecken (12. Jh.) und interessante geschnitzte Kapitelle."
        ],
        "en": [
          "Built in the 12th century, it was restored after the First World War. Nestled above the village, it houses well-preserved baptismal fonts (12th century), and interesting sculpted capitals."
        ],
        "it": [
          "Costruito nel XII secolo, è stato restaurato dopo la prima guerra mondiale. Situato sopra il villaggio, ospita un fonte battesimale ben conservato (XII secolo) e interessanti capitelli scolpiti."
        ],
        "fr": [
          "Construite au XIIe, elle fut restaurée après la Première Guerre mondiale. Nichée en surplomb du village, elle abrite des fonts baptismaux bien conservés (XIIe), et d'intéressants chapiteaux sculptés."
        ],
        "nl": [
          "Gebouwd in de 12e eeuw, werd het gerestaureerd na de Eerste Wereldoorlog. Het ligt boven het dorp en herbergt een goed bewaarde doopvont (12e eeuw) en interessante gebeeldhouwde kapitelen."
        ],
        "es": [
          "Construido en el siglo XII, fue restaurado tras la Primera Guerra Mundial. Enclavada sobre el pueblo, alberga una pila bautismal bien conservada (siglo XII) e interesantes capiteles esculpidos."
        ]
      },
