  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cade2593-09b0-3e95-8aee-e84625487d3d",
      "dc:description": {
        "de": [
          "Spiel für die Zusammenarbeit.\nSuchen Sie nach Hinweisen, um das Rätsel der verlorenen Schnitzel zu lösen und so mit der ganzen Familie auf spielerische und angenehme Weise dieses atypische Gebäude zu entdecken.\n\nAb 6 Jahren, Dauer 60 Minuten, 30? / Gruppe nur mit telefonischer Reservierung.\nmaximal 6 Personen pro Gruppe."
        ],
        "en": [
          "Collaborative game.\nSearch for clues to solve the mystery of the lost cossettes and discover this unusual building in a fun, family-friendly way.\n\nFrom 6 years, duration 60 minutes, 30? / group by telephone booking only.\nmaximum 6 people / group."
        ],
        "it": [
          "Gioco collaborativo.\nTrovate gli indizi per risolvere il mistero delle cossette perdute e scoprite questo insolito edificio in modo divertente e familiare.\n\nA partire dai 6 anni, durata 60 minuti, 30? / gruppo solo su prenotazione telefonica.\nmassimo 6 persone/gruppo."
        ],
        "fr": [
          "Jeu collaboratif.\nCherchez les indices pour résoudre le mystère des cossettes perdues et découvrir ainsi en famille, de manière ludique et agréable, ce bâtiment atypique.\n\nDès 6 ans, durée 60 minutes, 30€ / groupe sur réservation par téléphone uniquement.\n6 personnes maxi / groupe."
        ],
        "es": [
          "Juego colaborativo.\nEncuentra las pistas para resolver el misterio de las cosetas perdidas y descubre este insólito edificio de una forma divertida y familiar.\n\nA partir de 6 años, duración 60 minutos, 30? / grupo previa reserva sólo por teléfono.\nmáximo 6 personas/grupo."
        ],
        "nl": [
          "Gezamenlijk spel.\nVind de aanwijzingen om het mysterie van de verloren cossettes op te lossen en ontdek dit bijzondere gebouw op een leuke, gezinsvriendelijke manier.\n\nVanaf 6 jaar, duur 60 minuten, 30? / groep alleen op telefonische reservering.\nmaximaal 6 personen/groep."
        ]
      },
