  "rdfs:comment": {
    "de": [
      "Die 5 km lange und etwa 60 m breite Allée des Beaux-Monts verbindet den Wald mit dem Schloss von Compiègne. Sie endet auf einer Anhöhe mit einer herrlichen Aussicht auf den Wald und das Schloss im Hintergrund."
    ],
    "en": [
      "The Beaux-Monts path, which is 5 kilometres long and about 60 metres wide, links the forest to Compiègne castle. It ends in a hillock with a splendid view of the forest and the castle in the background."
    ],
    "it": [
      "L'Allee des Beaux-Monts, lunga 5 chilometri e larga circa 60 metri, collega la foresta al Castello di Compiègne. Termina su una collinetta con una splendida vista sulla foresta e sul castello sullo sfondo."
    ],
    "fr": [
      "L'allée des Beaux-Monts, longue de 5 kilomètres sur environ 60 mètres de large, relie la forêt au château de Compiègne. Elle se termine par une butte avec une vue splendide sur la forêt et le château en arrière-plan."
    ],
    "es": [
      "La Allee des Beaux-Monts, de 5 kilómetros de largo y unos 60 metros de ancho, une el bosque con el castillo de Compiègne. Termina en una loma con una espléndida vista del bosque y del castillo al fondo."
    ],
    "nl": [
      "De Allee des Beaux-Monts, die 5 kilometer lang en ongeveer 60 meter breed is, verbindt het bos met het kasteel van Compiègne. Het eindigt op een heuvel met een prachtig uitzicht op het bos en het kasteel op de achtergrond."
    ]
  },
