  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0e585bd7-3e6f-3f89-89ca-bd745bbf20e3",
      "dc:description": {
        "de": [
          "Fort Boyard, Animation von 10:30 bis 12 Uhr, organisiert von der Sportabteilung der Stadt Camiers für Kinder von 6 bis 12 Jahren.\n Anmeldung im Office de Tourisme erforderlich.\n3 Euro pro Person.\nTreffpunkt auf der Esplanade mit Ihrer Trinkflasche."
        ],
        "en": [
          "Fort Boyard, activities from 10.30am to 12pm organized by the Camiers Sports Department for children aged 6 to 12.\n Registration essential at the Tourist Office.\n3 euros per person.\nMeet at the esplanade with your water bottle."
        ],
        "it": [
          "Fort Boyard, attività dalle 10.30 alle 12.00 organizzate dal Dipartimento dello Sport di Camiers per bambini dai 6 ai 12 anni.\n Iscrizione obbligatoria presso l'Ufficio del Turismo.\n3 euro a persona.\nAppuntamento alla spianata con la borraccia."
        ],
        "fr": [
          "Fort Boyard, animation de 10h30 à 12h organisées par le service des sports de la ville de Camiers pour les enfants de 6 à 12 ans.\n Inscription indispensable à l'Office de Tourisme. \n3 euros par personne. \nRendez-vous à l'esplanade avec votre gourde."
        ],
        "nl": [
          "Fort Boyard, activiteiten van 10.30 tot 12.00 uur georganiseerd door de sportafdeling van Camiers voor kinderen van 6 tot 12 jaar.\n Inschrijving verplicht bij het toeristenbureau.\n3 euro per persoon.\nVerzamelen op de esplanade met een fles water."
        ],
        "es": [
          "Fort Boyard, actividades de 10.30 a 12 h organizadas por el Departamento de Deportes de Camiers para niños de 6 a 12 años.\n Imprescindible inscribirse en la Oficina de Turismo.\n3 euros por persona.\nAcuda a la explanada con su botella de agua."
        ]
      },
      "@type": [
