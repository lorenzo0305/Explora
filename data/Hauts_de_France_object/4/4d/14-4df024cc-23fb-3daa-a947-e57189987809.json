  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3a92992d-25c5-3dcb-8cbe-3315f46c3bf7",
      "dc:description": {
        "de": [
          "Zwei Tage lang durchgehend kreative Workshops, Treffen mit Autoren und Designerinnen, Vorführungen und Entdeckung neuer Techniken, Flash-Workshops und ein Café-Treff, um über Kreativität zu sprechen! Außerdem stehen Buchhandlungen, Signierstunden und Verkaufsausstellungen auf dem Programm."
        ],
        "en": [
          "Two days of non-stop creative workshops, meetings with authors and designers, demonstrations & discoveries of new techniques, flash workshops and a café-rencontre to talk creativity! The program also includes a bookshop, book signings & sales-exhibitions."
        ],
        "it": [
          "Due giorni di laboratori creativi non-stop, incontri con autori e designer, dimostrazioni e scoperte di nuove tecniche, workshop flash e un café-rencontre per parlare di creatività! Il programma prevede anche un bookshop, firme di libri e mostre di vendita."
        ],
        "fr": [
          "Deux journées d’ateliers créatifs en continu, de rencontres avec les auteurs et créatrices, de démonstrations & découvertes de nouvelles techniques, d’ateliers-flash et un café-rencontre pour parler créativité ! Et toujours au programme librairie, dédicaces & expositions-vente."
        ],
        "nl": [
          "Twee dagen non-stop creatieve workshops, ontmoetingen met auteurs en ontwerpers, demonstraties en ontdekkingen van nieuwe technieken, flitsworkshops en een café-rencontre om over creativiteit te praten! Op het programma staan ook een boekwinkel, signeersessies en verkooptentoonstellingen."
        ],
        "es": [
          "Dos días de talleres creativos ininterrumpidos, encuentros con autores y diseñadores, demostraciones y descubrimientos de nuevas técnicas, talleres flash y un café-rencontre para hablar de creatividad El programa incluye también una librería, firmas de libros y exposiciones de venta."
        ]
      },
