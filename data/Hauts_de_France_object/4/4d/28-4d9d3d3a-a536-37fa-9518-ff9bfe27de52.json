  "rdfs:comment": {
    "de": [
      "Probieren Sie die authentischen Honige von Grégory Dussenne: leidenschaftlicher Imker in Valenciennes, Handwerker des Geschmacks und des lokalen Terroirs!\nMedaillengewinner bei der Landwirtschaftsmesse 2026."
    ],
    "en": [
      "Taste the authentic honeys of Grégory Dussenne: passionate beekeeper in Valenciennes, artisan of taste and local produce!\nWinner of a medal at the Salon de l'Agriculture 2026."
    ],
    "it": [
      "Assaggiate i mieli autentici di Grégory Dussenne: un appassionato apicoltore di Valenciennes, un artigiano del gusto e dei prodotti locali!\nVincitore di una medaglia al Salone dell'Agricoltura 2026."
    ],
    "fr": [
      "Goûtez les miels authentiques de Grégory Dussenne : apiculteur passionné à Valenciennes, artisan du goût et du terroir local !\nMédaillé au salon de l'Agriculture 2026."
    ],
    "nl": [
      "Proef de authentieke honing van Grégory Dussenne: een gepassioneerde imker uit Valenciennes, een vakman van smaak en lokale producten!\nWinnaar van een medaille op het Salon de l'Agriculture 2026."
    ],
    "es": [
      "Deguste las mieles auténticas de Grégory Dussenne: apicultor apasionado de Valenciennes, ¡artesano del sabor y de los productos locales!\nGanador de una medalla en el Salón de la Agricultura 2026."
    ]
  },
