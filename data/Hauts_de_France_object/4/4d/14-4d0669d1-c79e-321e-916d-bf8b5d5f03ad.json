  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/12bdd8c8-12c2-3c90-95fa-957b69b1fa82",
      "dc:description": {
        "de": [
          "Begeben Sie sich auf eine sensorische Tour und eine Landschaftslesung im Parc de la Glissoire, um zu verstehen, wie sich ein Abbaugebiet in ein Landschafts- und Freizeitgebiet verwandelt hat, ohne dabei seine Geschichte außer Acht zu lassen!"
        ],
        "en": [
          "Embark on a sensory visit and a reading of the landscape at the Glissoire park to understand how a mining site was transformed into a landscape and leisure area without ignoring its history!"
        ],
        "it": [
          "Fate un tour sensoriale del parco di Glissoire e scoprite come un sito di estrazione sia stato trasformato in un'area paesaggistica e ricreativa, senza dimenticare la sua storia!"
        ],
        "fr": [
          "Embarquez pour une visite sensorielle et une lecture de paysage au parc de la Glissoire pour comprendre comment un site d’extraction s’est transformé en un espace paysager et de loisirs sans faire abstraction de son histoire !"
        ],
        "nl": [
          "Maak een zintuiglijke rondleiding door het Glissoire-park en leer hoe een steengroeve werd omgevormd tot een landschaps- en recreatiegebied, zonder zijn geschiedenis te vergeten!"
        ],
        "es": [
          "Haga un recorrido sensorial por el parque de Glissoire y descubra cómo se transformó una cantera en un espacio paisajístico y de ocio, ¡sin olvidar su historia!"
        ]
      },
      "@type": [
        "Description"
