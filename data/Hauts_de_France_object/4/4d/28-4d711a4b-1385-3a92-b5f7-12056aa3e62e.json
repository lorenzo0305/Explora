  "rdfs:comment": {
    "de": [
      "Kommen Sie an Bord von Alexandras Kutsche für eine 1- bis 3-stündige Fahrt in Fort-Mahon-Plage. Entdecken Sie das alte Fort-Mahon, die Landschaft und die Umgebung der Baie d'Authie im Rhythmus des bezaubernden Schrittes von Mégane, einem majestätischen Friesenpferd..."
    ],
    "en": [
      "Come aboard Alexandra's horse-drawn carriage for a 1 to 3 hour ride in Fort-Mahon-Plage. Discover the old Fort-Mahon, the countryside and the Authie Bay at the rhythm of the enchanting steps of Megane, a majestic Friesian horse..."
    ],
    "it": [
      "Salite a bordo della carrozza trainata dai cavalli di Alexandra per un giro da 1 a 3 ore a Fort-Mahon-Plage. Scoprite l'antica Fort-Mahon, la campagna e le rive della baia di Authie al ritmo degli incantevoli passi di Megane, un maestoso cavallo frisone..."
    ],
    "fr": [
      "Embarquez à bord de la Calèche d'Alexandra pour une balade de 1h à 3h à Fort-Mahon-Plage. Découvrez le vieux Fort-Mahon, la campagne et les abords de la Baie d'Authie au rythme du pas enchanteur de Mégane, cheval frison majestueux..."
    ],
    "es": [
      "Suba a bordo del coche de caballos de Alexandra para un paseo de 1 a 3 horas en Fort-Mahon-Plage. Descubra el antiguo Fort-Mahon, el campo y las orillas de la bahía de Authie al ritmo de los encantadores pasos de Megane, un majestuoso caballo frisón..."
    ],
    "nl": [
      "Kom aan boord van Alexandra's paardenkoets voor een 1 tot 3 uur durende rit in Fort-Mahon-Plage. Ontdek het oude Fort-Mahon, het platteland en de oevers van de Authiebaai op het ritme van de betoverende stappen van Megane, een majestueus Fries paard..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Calèche le Frison d'Alex"
    ]
  },
