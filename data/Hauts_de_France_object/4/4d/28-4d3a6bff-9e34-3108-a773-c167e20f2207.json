  "rdfs:comment": {
    "de": [
      "La Flambée ist ein gemütliches und elegantes Restaurant, in dem die Kunst der französischen Küche aus frischen und lokalen Zutaten im Vordergrund steht.  Mélanie und Thibault empfangen Sie mit Sorgfalt, damit Sie einen geselligen und schmackhaften Moment verbringen können."
    ],
    "en": [
      "La Flambée is a warm and elegant restaurant that showcases the art of French cuisine using fresh, local ingredients.  Mélanie and Thibault welcome you with care to ensure you spend a convivial and tasty moment."
    ],
    "it": [
      "La Flambée è un ristorante accogliente ed elegante che mette in mostra l'arte della cucina francese con ingredienti freschi e locali.  Mélanie e Thibault vi accolgono con cura per farvi trascorrere un momento conviviale e gustoso."
    ],
    "fr": [
      "La Flambée  est un restaurant chaleureux et élégant qui met en avant l'art de la cuisine française à partir d'ingrédients frais et locaux.  Mélanie et Thibault vous accueille avec soin pour que vous passiez un moment convivial et savoureux."
    ],
    "nl": [
      "La Flambée is een warm en elegant restaurant dat de kunst van de Franse keuken toont met verse, lokale ingrediënten.  Mélanie en Thibault ontvangen je met zorg om je een gezellige en smakelijke tijd te bezorgen."
    ],
    "es": [
      "La Flambée es un restaurante cálido y elegante que muestra el arte de la cocina francesa con ingredientes frescos y locales.  Mélanie y Thibault le dan la bienvenida con esmero para que pase un rato agradable y sabroso."
    ]
  },
  "rdfs:label": {
    "fr": [
