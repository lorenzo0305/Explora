  "rdfs:comment": {
    "de": [
      "Entdecken Sie die sonnige und raffinierte Küche des Küchenchefs in einem warmen und intimen Rahmen. Die Gerichte werden aus frischen und streng ausgewählten Produkten zubereitet, die mit Leidenschaft und Kreativität verarbeitet werden."
    ],
    "en": [
      "Discover the chef's sunny, refined cuisine in a warm, intimate setting. Dishes are prepared using fresh, carefully selected ingredients, and are crafted with passion and creativity."
    ],
    "it": [
      "Scoprite la cucina solare e raffinata dello chef in un ambiente caldo e intimo. I piatti sono preparati con prodotti freschi e rigorosamente selezionati, lavorati con passione e creatività."
    ],
    "fr": [
      "Découvrez la cuisine ensoleillée et raffinée du chef dans un cadre chaleureux et intimiste. Les plats sont élaborés à partir de produits frais et rigoureusement sélectionnés, travaillés avec passion et créativité."
    ],
    "nl": [
      "Ontdek de zonnige, verfijnde keuken van de chef in een warme, intieme omgeving. De gerechten worden bereid met verse, streng geselecteerde producten, bewerkt met passie en creativiteit."
    ],
    "es": [
      "Descubra la cocina soleada y refinada del chef en un ambiente cálido e íntimo. Los platos se preparan con productos frescos y rigurosamente seleccionados, trabajados con pasión y creatividad."
    ]
  },
