  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/df5de9c8-4dde-3a5e-a933-64cbb4c2b7fd",
      "dc:description": {
        "de": [
          "Statue mit dem Namen \"Der letzte Gedanke des sterbenden Soldaten\".\nErinnerte Konflikte: 1914-1918, 1939-1945, Indochina-Korea, Nordafrika\nBaudatum: Endgültige Abnahme der Bauarbeiten am 3. Dezember 1922."
        ],
        "en": [
          "Statue named \"The Last Thought of the Dying Soldier\".\nConflicts Commemorated: 1914-1918, 1939-1945, Indochina Korea, North Africa\nDate of construction: Final acceptance of the work on December 3, 1922."
        ],
        "it": [
          "Statua intitolata \"L'ultimo pensiero del soldato morente\".\nConflitti commemorati: 1914-1918, 1939-1945, Indocina-Corea, Nord Africa\nData di costruzione: accettazione finale dell'opera il 3 dicembre 1922."
        ],
        "fr": [
          "Statue nommée « La dernière pensée du soldat mourant ».\nConflits commémorés : 1914-1918, 1939-1945, Indochine-Corée, Afrique du Nord\nDate de construction : Réception définitive des travaux le 3 décembre 1922."
        ],
        "nl": [
          "Standbeeld met de naam \"De laatste gedachte van de stervende soldaat\".\nGedenkwaardige conflicten: 1914-1918, 1939-1945, Indochina-Korea, Noord-Afrika\nBouwdatum: Definitieve oplevering van het werk op 3 december 1922."
        ],
        "es": [
          "Estatua denominada \"El último pensamiento del soldado moribundo\".\nConflictos conmemorados: 1914-1918, 1939-1945, Indochina-Corea, África del Norte\nFecha de construcción: Recepción definitiva de las obras el 3 de diciembre de 1922."
        ]
      },
