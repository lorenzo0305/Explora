  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5c28a96e-2245-359d-863f-95302cac2369",
      "dc:description": {
        "de": [
          "Treffpunkt: Base Nautique, 25, rue Laurent Gers in Saint-Laurent-Blangy\nSitzung im Kajak\nDauer: 1,5 Std\nvoller Preis: 16.50?\nPreis von 6* bis 18 Jahren: 14?\n* ab 6 Jahren in Begleitung eines Erwachsenen\n\nBedingungen für den Zugang:\n-Angemessene Kleidung, geschlossene Schuhe und Kleidung zum Wechseln mitbringen\n-Bescheinigung vor Ort zu unterschreiben\n-Entlastung für Kinder\n-Mindestens 25 m schwimmen können"
        ],
        "en": [
          "Meet at Base Nautique, 25, rue Laurent Gers, Saint-Laurent-Blangy\nKayak session\nDuration: 1h30\nfull price: 16.50?\n6* to 18 years old: 14?\n* from 6 years old accompanied by an adult\n\nConditions of access:\n-Please bring suitable clothing, closed shoes and a change of clothes\n-Certificate to be signed on site\n-Discharge for children\n-Must be able to swim at least 25m"
        ],
        "it": [
          "Ritrovo presso la Base Nautique, 25, rue Laurent Gers a Saint-Laurent-Blangy\nSessione di kayak\nDurata: 1h30\nprezzo intero: 16,50?\nDa 6* a 18 anni: 14?\n* da 6 anni accompagnati da un adulto\n\nCondizioni di accesso:\n-Portare un abbigliamento adeguato, scarpe chiuse e un cambio di vestiti\n-Certificato da firmare in loco\n-Scarico per i bambini\n-Devono essere in grado di nuotare per almeno 25 m"
        ],
        "fr": [
          "Rendez-vous à la Base Nautique, 25, rue Laurent Gers à Saint-Laurent-Blangy\nSéance de Kayak\nDurée : 1h30\narif plein : 16.50€\nTarif de 6* à 18 ans : 14€\n* à partir de 6 ans accompagné d'un adulte\n\nConditions d'accès:\n-Prévoir une tenue adaptée, des chaussures fermées et une tenue de rechange\n-Attestation à signer sur place \n-Décharge pour les enfants\n-Savoir nager au minimum 25m"
        ],
        "es": [
          "Cita en la Base Nautique, 25, rue Laurent Gers en Saint-Laurent-Blangy\nSesión de kayak\nDuración: 1h30\nprecio completo: 16,50?\nDe 6* a 18 años: 14?\n* a partir de 6 años acompañado de un adulto\n\nCondiciones de acceso:\n-Llevar ropa adecuada, calzado cerrado y una muda\n-Certificado a firmar in situ\n-Alta para niños\n-Saber nadar al menos 25 m"
        ],
        "nl": [
          "Afspraak bij de Nautische basis, 25, rue Laurent Gers in Saint-Laurent-Blangy\nKajaksessie\nDuur: 1u30\nvolle prijs: 16,50?\n6* tot 18 jaar: 14?\n* vanaf 6 jaar onder begeleiding van een volwassene\n\nToegangsvoorwaarden:\n-Breng geschikte kleding, dichte schoenen en een verandering van kleren\n-Ter plaatse te ondertekenen certificaat\n-Lossen voor kinderen\n-Ten minste 25 m kunnen zwemmen"
        ]
      },
