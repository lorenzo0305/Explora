  "rdfs:comment": {
    "de": [
      "Gehen wir auf Entdeckungsreise zu den Eiern in den Sammlungen des Museums und gestalten wir dann gemeinsam ein buntes Ei mit Hama-Perlen.\n\nPreis: 4 ?\nFür Kinder ab 7 Jahren.\nReservieren Sie unter der Nummer +33 (0)3 23 62 36 77 oder direkt an der Kasse des Espace Saint-Jacques, 14 rue de la Sellerie, 02100 Saint-Quentin."
    ],
    "en": [
      "Let's discover the eggs in the museum's collections, then create a colorful egg together using Hama beads.\n\nPrice: 4?\nAges 7 and up.\nBook on 03 23 62 36 77 or directly at the Espace Saint-Jacques box office, 14 rue de la Sellerie, 02100 Saint-Quentin."
    ],
    "it": [
      "Scoprite le uova delle collezioni del museo e create insieme un uovo colorato con le perline Hama.\n\nPrezzo: 4 euro\nPer bambini a partire dai 7 anni.\nPrenotazione al numero 03 23 62 36 77 o direttamente alla biglietteria dell'Espace Saint-Jacques, 14 rue de la Sellerie, 02100 Saint-Quentin."
    ],
    "fr": [
      "Partons à la découverte des oeufs présents dans les collections du musée, puis créons ensemble un oeuf coloré avec des perles Hama.\n\nPrix : 4€\nA partir de 7 ans.\nRéservez au 03 23 62 36 77 ou directement à la Billetterie de l'Espace Saint-Jacques, 14 rue de la Sellerie, 02100 Saint-Quentin."
    ],
    "nl": [
      "Ontdek de eieren in de collecties van het museum en maak dan samen een kleurrijk ei met Hama-kralen.\n\nPrijs: €4\nVoor kinderen vanaf 7 jaar.\nReserveren via 03 23 62 36 77 of rechtstreeks bij de kassa van Espace Saint-Jacques, 14 rue de la Sellerie, 02100 Saint-Quentin."
    ],
    "es": [
      "Descubra los huevos de las colecciones del museo y cree juntos un huevo de colores con cuentas Hama.\n\nPrecio: 4 euros\nPara niños a partir de 7 años.\nReserva llamando al 03 23 62 36 77 o directamente en la taquilla del Espace Saint-Jacques, 14 rue de la Sellerie, 02100 Saint-Quentin."
    ]
  },
  "rdfs:label": {
