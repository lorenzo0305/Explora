        "de": [
          "Entdeckung des Ponys und des Pferdes durch Taufen oder Ausritte von 15 bis 30 Minuten, alle in einer freundlichen Atmosphäre"
        ],
        "en": [
          "Discover pony and horse riding through baptisms or rides of 15 to 30 minutes, all in a friendly atmosphere"
        ],
        "it": [
          "Scoprite l'equitazione su pony e cavalli con lezioni introduttive o passeggiate da 15 a 30 minuti, il tutto in un'atmosfera amichevole"
        ],
        "fr": [
          "Découverte du poney et du cheval par des baptêmes ou balade de 15 à 30 minutes le tous dans une ambiance conviviale"
        ],
        "nl": [
          "Ontdek het pony- en paardrijden met kennismakingslessen of ritten van 15 tot 30 minuten, allemaal in een gezellige sfeer"
        ],
        "es": [
          "Descubra la equitación y el poni con clases de iniciación o paseos de 15 a 30 minutos, todo ello en un ambiente agradable"
        ]
