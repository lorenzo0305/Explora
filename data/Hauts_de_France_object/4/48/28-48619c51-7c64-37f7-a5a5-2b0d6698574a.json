  "rdfs:comment": {
    "de": [
      "Museum, das der Geschichte der Telekommunikation und des Radios gewidmet ist und mehr als 200 Jahre technische Entwicklung vom Telegrafen bis zu den ersten modernen Kommunikationsmitteln nachzeichnet."
    ],
    "en": [
      "Museum dedicated to the history of telecommunications and radio, tracing over 200 years of technical development from the telegraph to the first modern communications."
    ],
    "it": [
      "Un museo dedicato alla storia delle telecomunicazioni e della radio, che ripercorre oltre 200 anni di sviluppo tecnico dal telegrafo alle prime comunicazioni moderne."
    ],
    "fr": [
      "Musée dédié à l’histoire des télécommunications et de la radio, retraçant plus de 200 ans d’évolution des techniques depuis le télégraphe jusqu’aux premières communications modernes."
    ],
    "es": [
      "Un museo dedicado a la historia de las telecomunicaciones y la radio, que recorre más de 200 años de desarrollo técnico desde el telégrafo hasta las primeras comunicaciones modernas."
    ],
    "nl": [
      "Een museum gewijd aan de geschiedenis van telecommunicatie en radio, dat meer dan 200 jaar technische ontwikkeling volgt, van de telegraaf tot de eerste moderne communicatie."
    ]
  },
