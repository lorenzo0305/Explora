      "dc:description": {
        "de": [
          "Sitzung um 10 Uhr, Dauer 1,5 Stunden, im Freien am Strand oder drinnen? Ab 14 Jahren\nPreis: 15 ? pro Person\nOrganisiert von Juyogalie, Informationen und Reservierungen unter +33 (0)6 33 24 22 72 oder per E-Mail: juyogalie@gmail.com"
        ],
        "en": [
          "Session at 10am, duration 1h30, outdoors on the beach or indoors? Ages 14 and up\nPrice: 15? per person\nOrganized by Juyogalie, information and booking on +33 (0)6 33 24 22 72 or by e-mail: juyogalie@gmail.com"
        ],
        "it": [
          "Sessione alle 10, durata 1h30, all'aperto sulla spiaggia o al chiuso? A partire dai 14 anni\nPrezzo: 15? a persona\nOrganizzato da Juyogalie, informazioni e prenotazioni al +33 (0)6 33 24 22 72 o via e-mail: juyogalie@gmail.com"
        ],
        "fr": [
          "Séance à 10h, durée 1h30, en plein air sur la plage ou en intérieur – A partir de 14 ans\nTarif : 15€ par personne\nOrganisé par Juyogalie, informations et réservation au +33 (0)6 33 24 22 72 ou par mail : juyogalie@gmail.com"
        ],
        "nl": [
          "Sessie om 10 uur, duur 1u30, buiten op het strand of binnen? Leeftijd vanaf 14 jaar\nPrijs: 15? per persoon\nGeorganiseerd door Juyogalie, informatie en reserveren op +33 (0)6 33 24 22 72 of per e-mail: juyogalie@gmail.com"
        ],
        "es": [
          "Sesión a las 10h, duración 1h30, ¿al aire libre en la playa o en el interior? A partir de 14 años\nPrecio: 15? por persona\nOrganiza Juyogalie, información y reservas en el +33 (0)6 33 24 22 72 o por correo electrónico: juyogalie@gmail.com"
        ]
      },
