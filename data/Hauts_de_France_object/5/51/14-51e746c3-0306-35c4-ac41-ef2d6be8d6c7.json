  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b228efc-e64b-3c2c-b9cf-d687709a5353",
      "dc:description": {
        "de": [
          "Petit Jean hat seinen Ballon verloren, er ist unter das Zelt des Dorfzirkus gerollt..\nAls er sich auf die Suche nach ihm macht, entdeckt Petit Jean eine Welt voller Artisten, von denen einer überraschender ist als der andere..."
        ],
        "en": [
          "Little John lost his balloon, it rolled under the big top of the village circus..\nBy going in search of it, Petit Jean discovers a world full of artists, each one more surprising than the other..."
        ],
        "it": [
          "Petit Jean ha perso il suo palloncino ed è rotolato sotto il tendone del circo del villaggio?\nQuando va a cercarlo, Petit Jean scopre un mondo pieno di artisti, uno più sorprendente dell'altro..."
        ],
        "fr": [
          "Petit Jean a perdu son ballon, il a roulé sous le chapiteau du cirque du village…\nEn partant à sa recherche, Petit Jean découvre un monde rempli d’artistes, tous plus surprenants les uns que les autres..."
        ],
        "nl": [
          "Petit Jean heeft zijn ballon verloren, het is onder de dorpscircustent gerold?\nAls hij ernaar op zoek gaat, ontdekt Petit Jean een wereld vol kunstenaars, de een nog verrassender dan de ander..."
        ],
        "es": [
          "Petit Jean ha perdido su globo, ha rodado bajo la carpa del circo del pueblo..\nCuando va a buscarlo, Petit Jean descubre un mundo lleno de artistas, cada uno más sorprendente que el anterior..."
        ]
      },
