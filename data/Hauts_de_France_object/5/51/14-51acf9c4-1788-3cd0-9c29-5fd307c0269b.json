  "rdfs:comment": {
    "de": [
      "Anlässlich der Rendez-vous aux jardins und der Ausstellung Paysage - Fenster zur Natur schließen sich das Pays d'art et d'histoire de Lens-Liévin und der Louvre-Lens zusammen, um Ihnen eine ganz neue Besichtigung mit Skizzen anzubieten."
    ],
    "en": [
      "On the occasion of the Rendez-vous aux jardins and the Paysage - fenêtre sur la nature exhibition, the Pays d'art et d'histoire de Lens-Liévin and the Louvre-Lens are joining forces to offer you a unique sketch tour."
    ],
    "it": [
      "In occasione del Rendez-vous nei Giardini e della mostra Paysage - Finestra sulla Natura, il Pays d'art et d'histoire de Lens-Liévin e il Louvre-Lens uniscono le forze per offrirvi un tour di schizzi unico."
    ],
    "fr": [
      "A l'occasion des Rendez-vous aux jardins et de l'exposition Paysage - fenêtre sur la nature, le Pays d'art et d'histoire de Lens-Liévin et le Louvre-Lens s'associent pour vous proposer une visite-croquis inédite."
    ],
    "nl": [
      "Ter gelegenheid van de Rendez-vous in de Tuinen en de tentoonstelling Paysage - Window on Nature, bieden het Pays d'art et d'histoire de Lens-Liévin en het Louvre-Lens samen een unieke schetstocht aan."
    ],
    "es": [
      "Con motivo de la Cita en los Jardines y de la exposición Paysage - Ventana a la Naturaleza, el Pays d'art et d'histoire de Lens-Liévin y el Louvre-Lens se unen para ofrecerle un recorrido de bocetos único."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rendez-vous aux jardins 2023  « Paysage en mots » - Visite-croquis en plein air à deux voix"
    ]
  },
