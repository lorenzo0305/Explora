      "dc:description": {
        "de": [
          "Ausstellung des Ateliers Pastel d'Opale im Rathaus von St Léonard.\nGeöffnet von Montag bis Freitag von 8:15 bis 12:00 Uhr und von 13:45 bis 17:00 Uhr."
        ],
        "en": [
          "Pastel d'Opale exhibition at St Léonard town hall.\nOpen Monday to Friday, 8.15am to 12pm and 1.45pm to 5pm."
        ],
        "it": [
          "Mostra del laboratorio Pastel d'Opale presso il municipio di St Léonard.\nAperto dal lunedì al venerdì, dalle 8.15 alle 12.00 e dalle 13.45 alle 17.00."
        ],
        "fr": [
          "Exposition de l'atelier Pastel d'Opale à la mairie de St Léonard.\nOuvert du lundi au vendredi de 8H15 à 12H et de 13H45 à 17H."
        ],
        "nl": [
          "Tentoonstelling van het atelier Pastel d'Opale in het gemeentehuis van St Léonard.\nOpen van maandag tot vrijdag van 8.15 tot 12.00 uur en van 13.45 tot 17.00 uur."
        ],
        "es": [
          "Exposición del taller Pastel d'Opale en el ayuntamiento de St Léonard.\nAbierto de lunes a viernes, de 8.15 a 12.00 h. y de 13.45 a 17.00 h."
        ]
      },
