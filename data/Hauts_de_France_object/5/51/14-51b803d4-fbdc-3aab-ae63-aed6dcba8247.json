  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/403a50f1-aa60-3d4b-b463-9aec2b9ccb71",
      "dc:description": {
        "de": [
          "6. FESTIVAL DES POLIZISCHEN ROMANS POLARTIFICE\n\nTreffen Sie sich auf dem warmen Sand des Strandes von Le Touquet-Paris-Plage!\nBegegnungen, lebhafte Gesprächsrunden und Signierstunden mit den Füßen im Sand.\n\nOrganisiert von der Mediathek von Touquet-Paris-Plage."
        ],
        "en": [
          "6th FESTIVAL DU ROMAN POLICIER POLARTIFICE\n\nRendezvous on the warm sand of Le Touquet-Paris-Plage beach!\nMeetings, lively round tables and book signings with your feet in the sand.\n\nOrganized by the media library of Le Touquet-Paris-Plage."
        ],
        "it": [
          "6° FESTIVAL DU ROMAN POLICIER POLARTIFICE\n\nAppuntamento sulla calda sabbia della spiaggia di Le Touquet-Paris-Plage!\nIncontri, tavole rotonde e firme di libri con i piedi nella sabbia.\n\nOrganizzato dalla mediateca di Le Touquet-Paris-Plage."
        ],
        "fr": [
          "6ème FESTIVAL DU ROMAN POLICIER POLARTIFICE\n\nRendez-vous sur le sable chaud de la plage du Touquet-Paris-Plage !\nRencontres, tables rondes animées et dédicaces les pieds dans le sable.\n\nOrganisé par la médiathèque du Touquet-Paris-Plage."
        ],
        "nl": [
          "6e FESTIVAL DU ROMAN POLICIER POLARTIFICE\n\nAfspraak op het warme zand van het strand van Le Touquet-Paris-Plage!\nOntmoetingen, levendige ronde tafels en signeersessies met je voeten in het zand.\n\nGeorganiseerd door de mediatheek van Le Touquet-Paris-Plage."
        ],
        "es": [
          "6º FESTIVAL DU ROMAN POLICIER POLARTIFICE\n\n¡Cita en la cálida arena de la playa de Le Touquet-Paris-Plage!\nEncuentros, animadas mesas redondas y firmas de libros con los pies en la arena.\n\nOrganizado por la mediateca de Le Touquet-Paris-Plage."
        ]
      },
