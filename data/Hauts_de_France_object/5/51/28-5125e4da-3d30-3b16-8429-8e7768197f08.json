  "rdfs:comment": {
    "de": [
      "2026 geschlossen.\nÔ Resto in Valenciennes lässt Sie nach Italien eintauchen: Pizzen, italienische Gerichte, eine Terrasse und Shows sorgen für ein einzigartiges geselliges und kulinarisches Erlebnis."
    ],
    "en": [
      "Closing 2026.\nÔ Resto in Valenciennes plunges you into Italy: pizzas, Italian dishes, terrace and shows for a unique convivial and gourmet experience."
    ],
    "it": [
      "Chiusura 2026.\nÔ Resto in Valenciennes vi immerge in Italia: pizze, piatti italiani, terrazza e spettacoli per un'esperienza conviviale e gastronomica unica."
    ],
    "fr": [
      "Fermeture 2026. \nÔ Resto à Valenciennes vous plonge en Italie : pizzas, plats italiens, terrasse et spectacles pour une expérience conviviale et gourmande unique."
    ],
    "nl": [
      "Sluiting 2026.\nÔ Resto in Valenciennes dompelt u onder in Italië: pizza's, Italiaanse gerechten, terras en shows voor een unieke gezellige en gastronomische ervaring."
    ],
    "es": [
      "Cierre 2026.\nÔ Resto en Valenciennes le sumerge en Italia: pizzas, platos italianos, terraza y espectáculos para una experiencia gastronómica y de convivencia única."
    ]
  },
