      "dc:description": {
        "de": [
          "Öffnungszeiten:\nMontag bis Donnerstag von 11:30 bis 14:00 Uhr und von 18:30 bis 22:30 Uhr\nFreitag bis Sonntag von 11:30 bis 14:00 Uhr und von 19:00 bis 22:30 Uhr\nSonntagmittag geschlossen"
        ],
        "en": [
          "Opening hours:\nMonday to Thursday, 11:30am to 2pm and 6:30pm to 10:30pm\nFriday to Sunday, 11:30am to 2pm and 7pm to 10:30pm\nClosed Sunday lunchtime"
        ],
        "it": [
          "Orari di apertura:\nDal lunedì al giovedì, dalle 11.30 alle 14.00 e dalle 18.30 alle 22.30\nDa venerdì a domenica, dalle 11.30 alle 14.00 e dalle 19.00 alle 22.30\nChiuso la domenica a pranzo"
        ],
        "fr": [
          "Horaires : \nDu lundi au jeudi de 11h30 à 14h et de  18h30 à 22h30\nDu vendredi au dimanche de 11h30 à 14h et de 19h à 22h30\nFermé le dimanche midi"
        ],
        "nl": [
          "Openingstijden:\nMaandag t/m donderdag van 11.30 tot 14.00 uur en van 18.30 tot 22.30 uur\nVrijdag t/m zondag van 11.30 tot 14.00 uur en van 19.00 tot 22.30 uur\nZondagmiddag gesloten"
        ],
        "es": [
          "Horario de apertura:\nDe lunes a jueves, de 11.30 a 14.00 h. y de 18.30 a 22.30 h\nDe viernes a domingo, de 11.30 h a 14 h y de 19 h a 22.30 h\nCerrado el domingo al mediodía"
        ]
