  "rdfs:comment": {
    "de": [
      "Raphaël erwartet Sie in den Ecuries de Macquigny, um sein Wissen und seine Leidenschaft für Pferde und Ponys bei einem Ausritt mit Ihnen zu teilen."
    ],
    "en": [
      "Raphaël awaits you at Ecuries de Macquigny to share his knowledge and passion for horses and ponies during a ride."
    ],
    "it": [
      "Raphaël vi aspetta alle Ecuries de Macquigny per condividere le sue conoscenze e la sua passione per i cavalli e i pony durante una cavalcata."
    ],
    "fr": [
      "Raphaël vous attend aux Ecuries de Macquigny pour vous partager son savoir et sa passion pour les chevaux et poneys lors d'une balade."
    ],
    "nl": [
      "Raphaël wacht op je in de Ecuries de Macquigny om zijn kennis en passie voor paarden en pony's te delen tijdens een rit."
    ],
    "es": [
      "Raphaël le espera en las Ecuries de Macquigny para compartir sus conocimientos y su pasión por los caballos y ponis durante un paseo a caballo."
    ]
