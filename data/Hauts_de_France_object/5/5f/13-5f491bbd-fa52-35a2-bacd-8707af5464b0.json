  "rdfs:comment": {
    "de": [
      "Die Stadt Quesnoy war vier Jahre lang von den Deutschen besetzt und wurde am 4. November 1918 von der Rifle Brigade, einem neuseeländischen Kontingent, befreit. Das Denkmal der Neuseeländer, das sich in der Stadtmauer befindet, wurde 1923 von Marschall Joffre eingeweiht."
    ],
    "en": [
      "Occupied for 4 years by the Germans, the town of Quesnoy was liberated by the Rifle Brigade, a New Zealand contingent, on November 4, 1918. The New Zealand Memorial, located in the ramparts, was inaugurated in 1923 by Marshal Joffre."
    ],
    "it": [
      "Occupata per 4 anni dai tedeschi, la città di Quesnoy fu liberata dalla Rifle Brigade, un contingente neozelandese, il 4 novembre 1918. Il Memorial neozelandese, situato nei bastioni, fu inaugurato nel 1923 dal Maresciallo Joffre."
    ],
    "fr": [
      "Occupée depuis 4 ans par les allemands, la ville de Quesnoy a été libérée par la Rifle Brigade, contingent néo-Zélandais, le 4 novembre 1918, le Mémorial des Néo- Zélandais, situé dans les remparts, a été inauguré en 1923 par le Maréchal Joffre."
    ],
    "nl": [
      "Quesnoy was 4 jaar lang bezet door de Duitsers en werd op 4 november 1918 bevrijd door de Rifle Brigade, een Nieuw-Zeelands contingent. Het Nieuw-Zeelandse monument op de vestingmuren werd in 1923 ingehuldigd door maarschalk Joffre."
    ],
    "es": [
      "Ocupada durante 4 años por los alemanes, la ciudad de Quesnoy fue liberada por la Brigada de Fusileros, un contingente neozelandés, el 4 de noviembre de 1918. El monumento a los neozelandeses, situado en las murallas, fue inaugurado en 1923 por el mariscal Joffre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mémorial Néo-Zélandais"
    ]
  },
