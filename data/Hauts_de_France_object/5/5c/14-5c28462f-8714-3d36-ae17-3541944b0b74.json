  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30cf8e4a-b541-3fb2-869d-b655661490f1",
      "dc:description": {
        "de": [
          "Der Küchenchef bietet Ihnen eine traditionelle Küche, die vor Ort aus frischen und überwiegend lokalen Produkten zubereitet wird.\nSpezialitäten: Welsh, Potjevleesch\n\nMittwoch geschlossen\n\nNB: Geschlossen am 2,3,4,10,11,12,16,17 und 18 Januar 2023"
        ],
        "en": [
          "The chef offers traditional cuisine prepared on site using fresh, mostly local produce.\nSpecialities: Welsh, potjevleesch\n\nClosed on Wednesday\n\nNB: Closed on January 2,3,4,10,11,12,16,17 and 18, 2023"
        ],
        "it": [
          "Lo chef propone una cucina tradizionale preparata in loco con prodotti freschi e prevalentemente locali.\nSpecialità: gallese, potjevleesch\n\nChiuso il mercoledì\n\nNB: Chiuso il 2,3,4,10,11,12,16,17 e 18 gennaio 2023"
        ],
        "fr": [
          "Le chef vous propose une cuisine traditionnelle préparée sur place à base de produits frais et majoritairement locaux.\nSpécialités : Welsh, potjevleesch\n\nFermé le mercredi\n\nNB: Fermeture les 2,3,4,10,11,12,16,17 et 18 janvier 2023"
        ],
        "es": [
          "El chef ofrece cocina tradicional elaborada in situ con productos frescos, principalmente locales.\nEspecialidades: galés, potjevleesch\n\nCerrado los miércoles\n\nNB: Cerrado los días 2,3,4,10,11,12,16,17 y 18 de enero de 2023"
        ],
        "nl": [
          "De chef biedt traditionele gerechten die ter plekke worden bereid met verse, voornamelijk lokale producten.\nSpecialiteiten: Welsh, potjevleesch\n\nWoensdag gesloten\n\nNB: Gesloten op 2,3,4,10,11,12,16,17 en 18 januari 2023"
        ]
      },
