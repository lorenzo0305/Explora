  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/609faa29-b5b8-37ab-afd8-a450a53a5ee7",
      "dc:description": {
        "de": [
          "Auf dem Rundgang werden Ihnen die Orte vorgestellt, die mit der Bergbauvergangenheit in Verbindung stehen (Kokerei, Schwimmbad, Bergarbeiterstadt, Reiterhof). Der Rundgang endet in der Mediathek \"Le Trait d'union\"."
        ],
        "en": [
          "The tour presents the sites related to the mining past (coking plant, swimming pool, mining city, cavalryman), the visit ends at the media library \"Le Trait d'union\"."
        ],
        "it": [
          "Il tour conduce a siti legati al passato minerario (cokeria, piscina, città mineraria, cavalleria) e termina alla mediateca \"Le Trait d'union\"."
        ],
        "fr": [
          "Le parcours vous présente les sites en lien avec le passé minier (cokerie, piscine, cité minière, cavalier), la visite prend fin à la médiathèque « Le Trait d’union »."
        ],
        "es": [
          "El recorrido le lleva a sitios vinculados al pasado minero (coquería, piscina, pueblo minero, caballería) y termina en la mediateca \"Le Trait d'union\"."
        ],
        "nl": [
          "De rondleiding voert langs plaatsen die verband houden met het mijnverleden (cokesfabriek, zwembad, mijnstad, cavalerist) en eindigt bij de mediatheek \"Le Trait d'union\"."
        ]
      },
