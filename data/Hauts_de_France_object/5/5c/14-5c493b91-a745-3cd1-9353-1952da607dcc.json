  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/92a60aac-f5d7-32e4-9c93-998369f088dc",
      "dc:description": {
        "de": [
          "Samstag und Sonntag: 10-13 Uhr und 15-18 Uhr\n\nEintrittspreise: 1 ? ? kostenlos für Kinder unter 18 Jahren\n\nGeführte Besichtigung\n\nAlle 30 Minuten, begrenzte Besucherzahl ? ohne Reservierung.\nEhemaliges Fischerhaus aus dem 19. Jahrhundert. Neue Szenografie des Matrosenzimmers im 1. Stock.\nAchtung: Treppen ? nicht rollstuhlgerecht."
        ],
        "en": [
          "Saturday and Sunday: 10am-1pm and 3pm-6pm\n\nAdmission: 1 ? ? free for under-18s\n\nGuided tour\n\nEvery 30 minutes, limited capacity ? no reservation required.\nFormer 19th-century fisherman's house. New scenography of the \"matelote\" room on the 1st floor.\nPlease note: stairs ? not wheelchair accessible."
        ],
        "it": [
          "Sabato e domenica: 10.00-13.00 e 15.00-18.00\n\nIngresso: 1 ? ? gratuito per i minori di 18 anni\n\nVisita guidata\n\nOgni 30 minuti, capacità limitata, senza prenotazione.\nAntica casa di pescatori del XIX secolo. Nuova scenografia della sala \"matelote\" al 1° piano.\nNota bene: scale, non accessibili alle sedie a rotelle."
        ],
        "fr": [
          "Samedi et dimanche : 10h-13h et 15h-18h\n\nTarifs : 1 € – gratuit pour les moins de 18 ans\n\nVisite guidée\n\nToutes les 30 minutes, jauge limitée – sans réservation.\nAncienne maison de pêcheurs du XIXe siècle. Nouvelle scénographie de la pièce de la matelote au 1er étage.\nAttention : escaliers – non accessible en fauteuil roulant."
        ],
        "nl": [
          "Zaterdag en zondag: 10.00-13.00 uur en 15.00-18.00 uur\n\nToegang: 1 gratis voor kinderen onder de 18 jaar\n\nRondleiding\n\nElke 30 minuten, beperkte capaciteit, reserveren niet nodig.\nVoormalig vissershuis uit de 19e eeuw. Nieuwe scenografie van de \"matelote\" kamer op de 1e verdieping.\nOpmerking: trappen? Niet toegankelijk voor rolstoelgebruikers."
        ],
        "es": [
          "Sábado y domingo: de 10.00 a 13.00 h. y de 15.00 a 18.00 h\n\nEntrada: 1€ gratis para menores de 18 años\n\nVisita guiada\n\nCada 30 minutos, aforo limitado ? no es necesario reservar.\nAntigua casa de pescadores del siglo XIX. Nueva escenografía de la sala \"matelote\" del 1er piso.\nAtención: escaleras ? no accesible en silla de ruedas."
        ]
      },
