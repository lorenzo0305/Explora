  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f28abb54-a12e-39b8-9003-7cb2cd562bc7",
      "dc:description": {
        "de": [
          "Sonntag, 19. Juni 2022\n\nKartografische Balade für Oldtimer oder außergewöhnliche Autos.\nRundfahrt vom Place du Centenaire (Le Touquet) in die Stadt Rixensart (Belgien)\nZwischen 11:00 und 12:00 Uhr"
        ],
        "en": [
          "Sunday, June 19, 2022\n\nMap ride for vintage or exceptional cars.\nCircuit from the place du Centenaire (Le Touquet) to the city of Rixensart (Belgium)\nBetween 11h and 12h."
        ],
        "it": [
          "Domenica 19 giugno 2022\n\nGiro di mappa per auto d'epoca o eccezionali.\nCircuito dalla Place du Centenaire (Le Touquet) alla città di Rixensart (Belgio)\nTra le 11.00 e le 12.00."
        ],
        "fr": [
          "Dimanche 19 juin 2022\n\nBalade cartographique pour voitures anciennes ou d'exception.\nCircuit au départ de la place du Centenaire (Le Touquet) vers la ville de Rixensart (Belgique)\nEntre 11h et 12h."
        ],
        "nl": [
          "Zondag 19 juni 2022\n\nKaartrijden voor oldtimers of uitzonderlijke auto's.\nCircuit van de Place du Centenaire (Le Touquet) naar de stad Rixensart (België)\nTussen 11 en 12 uur."
        ],
        "es": [
          "Domingo 19 de junio de 2022\n\nMapa de paseo para coches de época o excepcionales.\nCircuito desde la Plaza del Centenario (Le Touquet) hasta la ciudad de Rixensart (Bélgica)\nEntre las 11 y las 12 horas."
        ]
      },
