  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/db21f395-1efa-398b-9dcf-9d23c23525e8",
      "dc:description": {
        "de": [
          "Finden Sie unter einem Dach (dem der PIAC!) zahlreiche Handwerkerinnen und Handwerker, die 100% Made in Hauts-de-France sind!\n\nSchönheit\nDekoration\nWohlbefinden\nAccessoires\nUnd noch viel mehr zu entdecken!"
        ],
        "en": [
          "You'll find a host of 100% Made in Hauts-de-France artisans and craftspeople under one roof (the PIAC!)!\n\nBeauty\nDecoration\nWell-being\nAccessories\nAnd much more to discover!"
        ],
        "it": [
          "Troverete una serie di artigiani 100% Made in Hauts-de-France sotto lo stesso tetto (il PIAC!)\n\nLa bellezza\nDecorazione\nBenessere\nAccessori\nE molto altro ancora da scoprire!"
        ],
        "fr": [
          "Retrouvez sous un même toit (celui de la PIAC !) de nombreux artisanes et artisans 100% Made in Hauts-de-France !\n\nBeauté\nDécoration\nBien-être\nAccessoires\nEt bien plus encore à découvrir !"
        ],
        "nl": [
          "Je vindt er een heleboel ambachtslieden die 100% Made in Hauts-de-France zijn onder één dak (het PIAC!)\n\nSchoonheid\nDecoratie\nWelzijn\nAccessoires\nEn nog veel meer om te ontdekken!"
        ],
        "es": [
          "Encontrará una multitud de artesanos 100% Made in Hauts-de-France bajo un mismo techo (¡el PIAC!)\n\nBelleza\nDecoración\nBienestar\nAccesorios\n¡Y mucho más por descubrir!"
        ]
      },
