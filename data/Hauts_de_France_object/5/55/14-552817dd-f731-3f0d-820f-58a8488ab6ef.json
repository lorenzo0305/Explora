      "dc:description": {
        "de": [
          "Öffnungszeiten :\n \n\nMontags von 11:30 bis 14:00 Uhr\n\nDienstag bis Donnerstag von 11:30 bis 14:00 Uhr und von 18:00 bis 22:00 Uhr\n\nFreitags und samstags von 11:30 bis 14:00 Uhr und von 18:00 bis 22:00 Uhr\nSonntags geschlossen,"
        ],
        "en": [
          "Opening hours :\n \n\nMondays from 11:30am to 2pm\n\nTuesday to Thursday, 11:30am to 2pm and 6pm to 10pm\n\nFridays and Saturdays 11:30am to 2pm and 6pm to 10pm\nClosed on Sundays,"
        ],
        "it": [
          "Orari di apertura :\n \n\nLunedì dalle 11.30 alle 14.00\n\nDa martedì a giovedì, dalle 11.30 alle 14.00 e dalle 18.00 alle 22.00\n\nVenerdì e sabato dalle 11.30 alle 14.00 e dalle 18.00 alle 22.00\nChiuso la domenica,"
        ],
        "fr": [
          "Horaires d'ouverture : \n \n\nLe lundi de 11h30 à 14h\n\nDu mardi au jeudi de 11h30 à 14h et de 18h à 22h   \n\nLes vendredis et samedis de 11h30 à 14h et de 18h à 22h\nFermé le dimanche,"
        ],
        "nl": [
          "Openingstijden :\n \n\nMaandag van 11.30 tot 14.00 uur\n\nDinsdag tot donderdag van 11u30 tot 14u en van 18u tot 22u\n\nVrijdag en zaterdag van 11.30 tot 14.00 uur en van 18.00 tot 22.00 uur\nGesloten op zondag,"
        ],
        "es": [
          "Horario de apertura :\n \n\nLunes de 11h30 a 14h00\n\nDe martes a jueves, de 11.30 a 14.00 h y de 18.00 a 22.00 h\n\nViernes y sábados de 11.30 h a 14 h y de 18 h a 22 h\nDomingos cerrado,"
        ]
      },
