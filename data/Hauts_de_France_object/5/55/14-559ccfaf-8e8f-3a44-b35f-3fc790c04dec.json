  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/83376bec-18e8-37f8-8699-0c6f10b4c79b",
      "dc:description": {
        "de": [
          "FUSSWEG VON 4 KM - 1 Std\nABFAHRT VOM RATHAUSPLATZ IN COLEMBERT\nNICHT MARKIERT - WANDERBUCH IM TOURISMUSBÜRO ERHÄLTLICH\n\nFinden Sie den Verlauf des Rundwegs auf der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "4 KM PEDESTRIAN TRAIL - 1h\nDEPARTS FROM COLEMBERT TOWN HALL SQUARE\nNOT SIGNPOSTED - HIKER'S BOOKLET AVAILABLE FROM THE TOURIST OFFICE\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "Percorso pedonale di 4 km - 1 ora\nPARTE DALLA PIAZZA DEL MUNICIPIO DI COLEMBERT\nNON SEGNALATO - LIBRETTO PER ESCURSIONISTI DISPONIBILE PRESSO L'UFFICIO DEL TURISMO\n\nTrovate il percorso sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 4 KM - 1h \nDEPART DE LA PLACE DE LA MAIRIE DE  COLEMBERT\nNON BALISEE - CARNET DU RANDONNEUR DISPONIBLE A L'OFFICE DE TOURISME\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "Sendero peatonal de 4 km - 1 hora\nSALE DE LA PLAZA DEL AYUNTAMIENTO DE COLEMBERT\nNO SEÑALIZADO - FOLLETO PARA EXCURSIONISTAS DISPONIBLE EN LA OFICINA DE TURISMO\n\nEncuentre la ruta en la aplicación de senderismo CIRKWI en su Smartphone."
        ],
        "nl": [
          "4 km wandelroute - 1 uur\nSTART VANAF HET STADHUISPLEIN IN COLEMBERT\nNIET BEWEGWIJZERD - WANDELBOEKJE VERKRIJGBAAR BIJ HET TOERISTENBUREAU\n\nVind de route op de CIRKWI wandelapplicatie op je Smartphone."
        ]
      },
