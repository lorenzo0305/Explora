  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage der Archäologie lädt Sie das Team des Mémorial 14-18 Notre-Dame de Lorette dazu ein, mehr über die Archäologie des Ersten Weltkriegs zu erfahren."
    ],
    "en": [
      "As part of the European Archaeology Days, the Notre-Dame de Lorette 14-18 Memorial team invites you to learn more about the archaeology of the Great War."
    ],
    "it": [
      "Nell'ambito delle Giornate Europee dell'Archeologia, l'équipe del Memoriale Notre-Dame de Lorette 14-18 vi invita a scoprire di più sull'archeologia della Grande Guerra."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes de l'archéologie, l'équipe du Mémorial 14-18 Notre-Dame de Lorette vous invite à en apprendre plus sur l'archéologie de la Grande Guerre."
    ],
    "nl": [
      "In het kader van de Europese Archeologiedagen nodigt het team van de Notre-Dame de Lorette 14-18 Memorial je uit om meer te weten te komen over de archeologie van de Grote Oorlog."
    ],
    "es": [
      "En el marco de las Jornadas Europeas de Arqueología, el equipo del Memorial Notre-Dame de Lorette 14-18 le invita a descubrir la arqueología de la Gran Guerra."
    ]
  },
  "rdfs:label": {
