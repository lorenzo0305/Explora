  "rdfs:comment": {
    "de": [
      "Diese Kirche wurde 1862 von Carron mit Skulpturen versehen. Sie besteht aus Backstein und Kalkstein."
    ],
    "en": [
      "This church was sculpted by Carron in 1862. It is made of brick and limestone."
    ],
    "it": [
      "Questa chiesa è stata scolpita da Carron nel 1862. È realizzata in mattoni e pietra calcarea."
    ],
    "fr": [
      "Cette église a été sculptée par Carron en 1862. Elle est faite de brique et de pierre calcaire."
    ],
    "es": [
      "Esta iglesia fue esculpida por Carron en 1862. Está hecha de ladrillo y piedra caliza."
    ],
    "nl": [
      "Deze kerk werd in 1862 gebeeldhouwd door Carron. Ze is gemaakt van baksteen en kalksteen."
    ]
  },
