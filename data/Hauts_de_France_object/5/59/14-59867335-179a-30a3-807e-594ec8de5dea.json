  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c9fe9d03-5ba5-3144-8a62-68ef734a6279",
      "dc:description": {
        "de": [
          "Treffpunkt um 9:30 Uhr am Rathaus von Camiers für ein Aufwärmen mit Musik - Start um 10:00 Uhr der 3,5 km langen Wanderung, die für Menschen mit Behinderungen zugänglich ist, und der 6,5 km langen Wanderung, die nicht für Menschen mit Behinderungen zugänglich ist - Kostenlos und ohne Anmeldung"
        ],
        "en": [
          "Meet at 9.30am at Camiers town hall for a warm-up with music - Start at 10am for the 3.5km walk accessible to PRM and the 6.5km walk not accessible to PRM - Free and no registration required"
        ],
        "it": [
          "Ritrovo alle 9.30 presso il municipio di Camiers per un riscaldamento con musica - Partenza alle 10.00 per la camminata di 3,5 km accessibile alle PMR e per quella di 6,5 km non accessibile alle PMR - Iscrizione gratuita e non necessaria"
        ],
        "fr": [
          "Rendez-vous à 9H30 à la mairie de Camiers pour un échauffement en musique - Départ à 10H des marches de 3.5 km accessible aux PMR et de 6.5km non accessible aux PMR - Gratuit et sans inscription"
        ],
        "nl": [
          "Verzamelen om 9.30 uur bij het gemeentehuis van Camiers voor een warming-up met muziek - Start om 10.00 uur voor de wandeling van 3,5 km die toegankelijk is voor mensen met beperkte mobiliteit en de wandeling van 6,5 km die niet toegankelijk is voor mensen met beperkte mobiliteit - Gratis en aanmelden niet nodig"
        ],
        "es": [
          "Encuentro a las 9h30 en el ayuntamiento de Camiers para un calentamiento con música - Salida a las 10h para la marcha de 3,5 km accesible a PMR y la marcha de 6,5 km no accesible a PMR - Gratuita y sin necesidad de inscripción"
        ]
      },
      "@type": [
