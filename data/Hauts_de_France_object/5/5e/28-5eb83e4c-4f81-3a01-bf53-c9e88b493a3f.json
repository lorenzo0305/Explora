  "rdfs:comment": {
    "de": [
      "Brasserie mit Terrasse mit Blick auf den Deich: Muscheln, regionale Gerichte, Eisdiele und Teesalon.\nFür Ihr Mittagessen oder eine süße Pause genießen Sie einen herrlichen Blick auf das Meer."
    ],
    "en": [
      "Brasserie with terrace overlooking the sea wall: mussels, regional dishes, ice cream and tea room.\nFor your lunch or a sweet break enjoy a magnificent view of the sea."
    ],
    "it": [
      "Brasserie con terrazza affacciata sul mare: cozze, piatti regionali, gelateria e sala da tè.\nPer il vostro pranzo o per una pausa dolce, godetevi la magnifica vista sul mare."
    ],
    "fr": [
      "Brasserie avec terrasse donnant sur la digue: moules, plats régionaux, glacier et salon de thé.\nPour votre déjeuner ou une pause sucrée profitez d'une magnifique vue sur la mer."
    ],
    "nl": [
      "Brasserie met terras met uitzicht op de zeedijk: mosselen, streekgerechten, ijssalon en theesalon.\nGeniet voor uw lunch of een zoete pauze van een prachtig uitzicht op zee."
    ],
    "es": [
      "Brasserie con terraza sobre el dique: mejillones, platos regionales, heladería y salón de té.\nPara su almuerzo o una pausa dulce, disfrute de una magnífica vista del mar."
    ]
  },
