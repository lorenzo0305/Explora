  "rdfs:comment": {
    "de": [
      "Die Einrichtung befindet sich im Herzen der Vauban-Mauern von Le Quesnoy mit herrlichem Panoramablick auf die Teiche von Pont Rouge in einer ruhigen und grünen Umgebung."
    ],
    "en": [
      "Establishment located in the heart of the Vauban ramparts of Le Quesnoy with a magnificent panoramic view on the ponds of the red bridge in a quiet and green setting."
    ],
    "it": [
      "L'hotel è situato nel cuore dei bastioni Vauban di Le Quesnoy, con una magnifica vista panoramica sugli stagni di Pont Rouge, in un ambiente tranquillo e verdeggiante."
    ],
    "fr": [
      "Établissement situé au cœur des remparts Vauban de Le Quesnoy avec magnifique vue panoramique sur les étangs du pont rouge dans un cadre calme et verdoyant."
    ],
    "nl": [
      "Het hotel ligt in het hart van de Vauban-wallen van Le Quesnoy met een prachtig panoramisch uitzicht op de vijvers van de Pont Rouge in een rustige en groene omgeving."
    ],
    "es": [
      "El hotel está situado en el corazón de las murallas Vauban de Le Quesnoy, con una magnífica vista panorámica de los estanques de Pont Rouge, en un entorno tranquilo y verde."
    ]
  },
