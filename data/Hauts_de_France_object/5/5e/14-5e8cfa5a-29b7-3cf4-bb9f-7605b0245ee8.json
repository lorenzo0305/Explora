  "rdfs:comment": {
    "de": [
      "In dieser ersten Augustwoche hebt der Louvre-Lens die Leistungen weiblicher Athleten hervor und empfängt Meisterinnen aus den Vereinen der Region."
    ],
    "en": [
      "This first week of August, the Louvre-Lens highlights the performances of female athletes and welcomes champions from clubs in the region."
    ],
    "it": [
      "Durante la prima settimana di agosto, il Louvre-Lens mette in mostra i risultati delle atlete e accoglie le campionesse dei club della regione."
    ],
    "fr": [
      "Cette première semaine d’août, le Louvre-Lens met en valeur les performances des athlètes féminines et accueille des championnes des clubs de la région."
    ],
    "nl": [
      "Tijdens de eerste week van augustus zet het Louvre-Lens de prestaties van vrouwelijke atleten in de kijker en verwelkomt het kampioenen van clubs uit de regio."
    ],
    "es": [
      "Durante la primera semana de agosto, el Louvre-Lens exalta los logros de las mujeres deportistas y recibe a las campeonas de los clubes de la región."
    ]
  },
