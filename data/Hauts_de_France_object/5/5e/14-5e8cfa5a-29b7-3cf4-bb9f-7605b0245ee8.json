      "dc:description": {
        "de": [
          "Sie sprechen und leiten Workshops, in denen sie in ihre Sportarten eingeführt werden: Handball, Volleyball, Fußball und Breakdance stehen auf dem Programm!"
        ],
        "en": [
          "They speak and lead workshops to introduce their sports: handball, volleyball, soccer, break dance are on the agenda!"
        ],
        "it": [
          "Parlano e tengono workshop introduttivi nei loro sport: pallamano, pallavolo, calcio e break dance sono tutti in programma!"
        ],
        "fr": [
          "Elles prennent la parole et animent des ateliers d’initiation à leurs sports : handball, volleyball, football, break dance sont au rendez-vous !"
        ],
        "nl": [
          "Ze doen hun zegje en geven kennismakingsworkshops in hun sport: handbal, volleybal, voetbal en breakdance staan allemaal op het programma!"
        ],
        "es": [
          "Hablan en voz alta y organizan talleres de iniciación a sus deportes: balonmano, voleibol, fútbol y break dance están todos en el programa"
        ]
      },
