  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c533b99f-e439-3c14-8a47-92a649ae43d9",
      "dc:description": {
        "de": [
          "Entdecken Sie den größten Spiel- und Freizeitbereich an der Côte d'Opale: 142 Spielautomaten, traditionelle Spiele, ein Restaurant, eine Bar, Animationen und Aufführungen.\n\nÖffnung der Spielautomaten täglich von 10:00 bis 3:00 Uhr.\nÖffnung der Tischspiele täglich von 20:00 bis 3:00 Uhr."
        ],
        "en": [
          "Discover the largest gaming and leisure area on the Opal Coast: 142 slot machines, traditional games, a restaurant, bar, entertainment and shows.\n\nSlot machines open daily from 10:00 am to 3:00 am.\nTable games open daily from 8pm to 3am."
        ],
        "it": [
          "Scoprite la più grande area di gioco e di svago della Côte d'Opale: 142 slot machine, giochi tradizionali, ristorante, bar, animazione e spettacoli.\n\nSlot machine aperte tutti i giorni dalle 10 alle 3 del mattino.\nI giochi da tavolo sono aperti tutti i giorni dalle 20.00 alle 3.00."
        ],
        "fr": [
          "Découvrez le plus grand espace de jeux et de loisirs de la Côte d'Opale : 142 machines à sous, jeux traditionnels, un restaurant, un bar, des animations et des spectacles.\n\nOuverture des machines à sous tous les jours de 10h00 à 3h00.\nOuverture des jeux de table tous les jours de 20h00 à 3h00."
        ],
        "nl": [
          "Ontdek het grootste speel- en recreatiegebied aan de Côte d'Opale: 142 speelautomaten, traditionele spellen, een restaurant, bar, entertainment en shows.\n\nSpeelautomaten dagelijks geopend van 10.00 tot 3.00 uur.\nDe tafelspelen zijn elke dag geopend van 20.00 tot 3.00 uur."
        ],
        "es": [
          "Descubra la mayor zona de juegos y ocio de la Costa de Ópalo: 142 máquinas tragaperras, juegos tradicionales, restaurante, bar, animación y espectáculos.\n\nLas máquinas tragaperras abren todos los días de 10.00 a 3.00 h.\nJuegos de mesa abiertos todos los días de 20.00 a 3.00 h."
        ]
      },
