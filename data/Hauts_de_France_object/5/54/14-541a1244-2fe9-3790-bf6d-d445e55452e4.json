      "@id": "https://data.datatourisme.fr/98d1e0f0-1d17-3d1c-9e9b-b9a6b467055a",
      "dc:description": {
        "de": [
          "Entdecke, wie du eine Windmühle bauen kannst, um deinen Garten zu schmücken - Treffpunkt: Salle du Bosquet - Rue du Bosquet in Camiers - Anmeldung im Office de Tourisme erforderlich - Von 14:30 bis 16:30 Uhr"
        ],
        "en": [
          "Discover how to build a windmill to decorate your garden - Meet at the Salle du Bosquet - Rue du Bosquet in Camiers - Registration required at the Tourist Office - From 2:30 to 4:30 pm"
        ],
        "it": [
          "Scoprite come costruire un mulino a vento per decorare il vostro giardino - Appuntamento alla Salle du Bosquet - Rue du Bosquet a Camiers - Iscrizione obbligatoria presso l'Ufficio del Turismo - 14.30-16.30"
        ],
        "fr": [
          "Découvre comment construire un moulin à vent pour décorer ton jardin - Rendez-vous à la salle du Bosquet - Rue du Bosquet à Camiers - Inscription indispensable à l'Office de Tourisme - De 14h30 à 16h30"
        ],
        "nl": [
          "Ontdek hoe je een windmolen bouwt om je tuin te versieren - Afspraak in de Salle du Bosquet - Rue du Bosquet in Camiers - Inschrijving verplicht bij het Office du Tourisme - 14u30-16u30"
        ],
        "es": [
          "Descubra cómo construir un molino de viento para decorar su jardín - Cita en la Salle du Bosquet - Rue du Bosquet en Camiers - Inscripción obligatoria en la Oficina de Turismo - 14h30 a 16h30"
        ]
      },
