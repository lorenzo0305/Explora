  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Brasserie und das Bistronomierestaurant und probieren Sie eine zeitgenössische und großzügige Küche in einem schlichten und gedämpften Ort im Herzen der Stadt."
    ],
    "en": [
      "Discover the brasserie and the bistronomic restaurant and taste a contemporary and generous cuisine in a sober and hushed place in the heart of the city."
    ],
    "it": [
      "Scoprite la brasserie e il ristorante bistronomico e assaggiate una cucina contemporanea e generosa in un luogo sobrio e accogliente nel cuore della città."
    ],
    "fr": [
      "Découvrez la brasserie et le restaurant bistronomique et goûtez une cuisine contemporaine et généreuse dans un lieu sobre et feutré en plein cœur de la ville."
    ],
    "nl": [
      "Ontdek de brasserie en het bistronomisch restaurant en proef een hedendaagse en genereuze keuken op een sobere en gezellige plek in het hart van de stad."
    ],
    "es": [
      "Descubra la brasserie y el restaurante bistronómico y deguste una cocina contemporánea y generosa en un lugar sobrio y acogedor en pleno centro de la ciudad."
    ]
  },
