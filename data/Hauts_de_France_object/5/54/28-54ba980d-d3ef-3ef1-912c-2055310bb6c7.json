  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen traditionelle Gerichte, aber auch Gerichte aus der Weltküche. Eine Einladung zu einer Reise (auf dem Teller!). Unsere Küche besteht ausschließlich aus frischen Zutaten, alles hausgemacht!"
    ],
    "en": [
      "The restaurant offers traditional dishes but also from the world cuisine. An invitation to travel (in the plate!). Our cuisine is composed only of fresh products, all homemade!"
    ],
    "it": [
      "Il ristorante offre piatti tradizionali ma anche piatti dal mondo. Un invito al viaggio (nel piatto!). La nostra cucina è composta solo da prodotti freschi, tutti fatti in casa!"
    ],
    "fr": [
      "Le restaurant vous propose des plats traditionnels mais aussi issus de la cuisine du monde. Une invitation au voyage (dans l'assiette!). Notre cuisine est composée uniquement de produits frais, le tout fait maison !"
    ],
    "nl": [
      "Het restaurant biedt u traditionele gerechten maar ook gerechten uit de wereld. Een uitnodiging om te reizen (in uw bord!). Onze keuken bestaat uitsluitend uit verse producten, allemaal huisgemaakt!"
    ],
    "es": [
      "El restaurante le ofrece platos tradicionales, pero también platos del mundo. Una invitación a viajar (¡en su plato!). Nuestra cocina se compone únicamente de productos frescos, ¡todos caseros!"
    ]
  },
