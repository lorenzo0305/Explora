  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b52d038e-2913-3306-bcdb-09bf0d72c355",
      "dc:description": {
        "de": [
          "Diese im Nordwesten zwischen Sains-en-Gohelle und Noeux-les-Mines gelegene Basis ist mit Minispielfeldern ausgestattet: synthetischer Basketball, synthetischer Tennisplatz, synthetischer Fußball und auf einer Grasebene, Kinderspiele, Spazierbereich."
        ],
        "en": [
          "Situated in the North-West between Sains-en-Gohelle and Noeux-les-Mines, this base is embellished with miniature pitches: synthetic basketball, synthetic tennis, synthetic football and on a grassy plain, children's games, walking area."
        ],
        "it": [
          "Situata a nord-ovest tra Sains-en-Gohelle e Noeux-les-Mines, questa base dispone di diversi mini campi: basket sintetico, tennis sintetico, calcio sintetico e in erba, giochi per bambini, area per passeggiate."
        ],
        "fr": [
          "Située au Nord-Ouest entre Sains-en-Gohelle et Noeux-les-Mines, cette base est agrémentée de mini-terrains : basket-ball synthétique, tennis synthétique, foot synthétique et sur plaine d’herbe, jeux pour enfants, espace de promenade."
        ],
        "es": [
          "Situada en el noroeste, entre Sains-en-Gohelle y Noeux-les-Mines, esta base dispone de varios minicampos: baloncesto sintético, tenis sintético, fútbol sintético y de hierba, juegos infantiles, zona de paseo."
        ],
        "nl": [
          "Deze basis, gelegen in het noordwesten tussen Sains-en-Gohelle en Noeux-les-Mines, beschikt over een aantal minigronden: synthetische basketbal, synthetische tennis, synthetische en grasvoetbal, kinderspelen, wandelgebied."
        ]
      },
      "@type": [
        "Description"
