  "rdfs:comment": {
    "de": [
      "Der Verein Eperon 132 aus Crouy organisiert seine 1. Militär-Antiquitätenbörse am Sonntag, den 29.03. in der Mehrzweckhalle von Crouy hinter dem Rathaus. Getränke und kleine Snacks sind vor Ort erhältlich."
    ],
    "en": [
      "The Eperon 132 association in Crouy is organizing its 1st military antiques fair on Sunday 29/03 at the Crouy multi-purpose hall behind the town hall. Refreshments and snacks on site."
    ],
    "it": [
      "L'associazione Eperon 132 di Crouy organizza la sua prima fiera dell'antiquariato militare domenica 29/03 presso la sala polivalente di Crouy, dietro il municipio. Sono disponibili rinfreschi e spuntini."
    ],
    "fr": [
      "L'association Eperon 132 de Crouy, organise sa 1ère bourse aux antiquités militaire le dimanche 29/03 à la salle polyvalente de Crouy derrière la mairie. Buvette et petite restauration sur place."
    ],
    "es": [
      "La asociación Eperon 132 de Crouy organiza su 1ª feria de antigüedades militares el domingo 29/03 en la sala polivalente de Crouy, detrás del ayuntamiento. Habrá refrescos y aperitivos."
    ],
    "nl": [
      "De vereniging Eperon 132 in Crouy organiseert haar 1ste militaire antiekbeurs op zondag 29/03 in de polyvalente zaal van Crouy achter het gemeentehuis. Versnaperingen en snacks zijn beschikbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "1ère Bourse aux antiquités militaires"
    ]
