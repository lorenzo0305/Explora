  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b8685a75-9d43-3440-ae9e-b5d6f67c9eb0",
      "dc:description": {
        "de": [
          "Am Ortseingang von Douai, hinter Gayant Expo, empfängt Sie dieses Wok-Buffet mit asiatischen Spezialitäten. Nutzen Sie das All-you-can-eat-Buffet, um Sushi, Maki, kantonesischen Reis zu probieren und sich Ihren Wok zusammenzustellen."
        ],
        "en": [
          "Located at the entrance to Douai, behind Gayant Expo, this buffet-wok of Asian specialties welcomes you. Take advantage of the all-you-can-eat buffet to sample sushi, maki, Cantonese rice and create your own wok."
        ],
        "it": [
          "Situato all'ingresso di Douai, dietro il Gayant Expo, questo buffet-wok di specialità asiatiche vi accoglie. Approfittate del buffet all-you-can-eat per provare sushi, maki, riso cantonese e creare il vostro wok."
        ],
        "fr": [
          "Situé à l'entrée de Douai, derrière Gayant Expo, ce buffet-wok de spécialités asiatiques vous accueille. Profitez du buffet à volonté pour déguster sushis, maki, riz cantonais et composer votre wok."
        ],
        "es": [
          "Situado a la entrada de Douai, detrás de Gayant Expo, este buffet-wok de especialidades asiáticas le da la bienvenida. Aproveche el buffet libre para probar sushi, maki, arroz cantonés y crear su propio wok."
        ],
        "nl": [
          "Gelegen aan de ingang van Douai, achter Gayant Expo, verwelkomt dit buffet-wok met Aziatische specialiteiten je. Profiteer van het all-you-can-eat buffet om sushi, maki, Kantonese rijst en je eigen wok te proberen."
        ]
      },
