  "rdfs:comment": {
    "de": [
      "Finden Sie eine Auswahl an Tees, Gebäck, Schokolade und Waffeln in dieser unumgänglichen Feinschmeckeradresse in Lille mit ihrem herzlichen und raffinierten Ambiente. Unumgängliche Feinschmeckeradresse in Lille in einem gemütlichen und raffinierten historischen Ort."
    ],
    "en": [
      "Enjoy a selection of teas, pastries, chocolates and waffles at this gourmet address in Lille, with its warm, refined atmosphere. A gourmet address not to be missed in Lille, in a warm and refined historic setting."
    ],
    "it": [
      "Scoprite una selezione di tè, pasticcini, cioccolatini e waffle in questo indirizzo gourmet di Lille, dall'atmosfera calda e raffinata. Un indirizzo gourmet da non perdere a Lille, in un ambiente storico caldo e raffinato."
    ],
    "fr": [
      "Retrouvez une sélection de thés, de pâtisseries, de chocolats et de gaufres dans cette adresse gourmande incontournable de Lille, à l'ambiance chaleureuse et raffinée. Adresse gourmande incontournable de Lille dans un lieu historique chaleureux et raffiné."
    ],
    "nl": [
      "Ontdek een selectie van thee, gebak, chocolade en wafels in dit gastronomische adres in Lille, met zijn warme en verfijnde sfeer. Een niet te missen gastronomisch adres in Lille, in een warm en verfijnd historisch kader."
    ],
    "es": [
      "Descubra una selección de tés, pasteles, chocolates y gofres en esta dirección gastronómica de Lille, de ambiente cálido y refinado. Una dirección gastronómica ineludible en Lille, en un marco histórico cálido y refinado."
    ]
  },
