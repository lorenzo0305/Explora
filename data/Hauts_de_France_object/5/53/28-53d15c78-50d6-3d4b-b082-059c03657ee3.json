  "rdfs:comment": {
    "de": [
      "Erkunden Sie eine Halde, die unter Unesco-Schutz steht, und erleben Sie eine immersive Yoga- und Meditationserfahrung, um Ihre Sinne zu wecken und sich wieder mit der Natur zu verbinden."
    ],
    "en": [
      "Explore a UNESCO-listed slag heap and enjoy an immersive yoga and meditation experience to awaken your senses and reconnect with nature."
    ],
    "it": [
      "Esplorate un cumulo di scorie classificato dall'UNESCO e godetevi un'esperienza immersiva di yoga e meditazione per risvegliare i vostri sensi e riconnettervi con la natura."
    ],
    "fr": [
      "Explorez un terril classé Unesco et vivez une expérience immersive de yoga et méditation pour éveiller vos sens et vous reconnecter à la nature."
    ],
    "nl": [
      "Verken een slakkenberg die op de UNESCO-lijst staat en geniet van een meeslepende yoga- en meditatie-ervaring om je zintuigen te ontwaken en weer contact te maken met de natuur."
    ],
    "es": [
      "Explore un escorial declarado Patrimonio de la Humanidad por la UNESCO y disfrute de una experiencia inmersiva de yoga y meditación para despertar sus sentidos y reconectar con la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Yoga sur le terril"
    ]
  },
