  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1104835d-fa8d-38e7-a716-b9d6e978ba8e",
      "dc:description": {
        "de": [
          "im Rahmen des Fahrradfestes an der Côte d'Opale\nTreffpunkt ab 8.45 Uhr am Eingang des Campingplatzes \"Chez Mireille\" für eine 30 km lange Familienstrecke\nAbfahrt um 9.00 Uhr\nPreis: kostenlos - offen für alle"
        ],
        "en": [
          "as part of the \"Fête du Vélo sur le Côte d'Opale\nMeet at 8:45 am at the entrance to the \"Chez Mireille\" campsite for a 30 km family ride\nDeparture at 9:00 am\nPrice: free - open to all"
        ],
        "it": [
          "nell'ambito della Fête du Vélo sulla Côte d'Opale\nRitrovo alle 8.45 all'ingresso del campeggio \"Chez Mireille\" per una pedalata familiare di 30 km\nPartenza alle 9.00\nPrezzo: gratuito - aperto a tutti"
        ],
        "fr": [
          "dans le cadre de la fête du Vélo sur le Côte d'Opale\nRendez-vous dés 8h45 à l'entrée du camping \"Chez Mireille\" pour un parcours familial de 30 km\nDépart à 9h00\nTarif : gratuit - ouvert à tout le monde"
        ],
        "nl": [
          "in het kader van het Fête du Vélo aan de Côte d'Opale\nVerzamelen om 8.45 uur bij de ingang van de camping \"Chez Mireille\" voor een gezinsrit van 30 km\nVertrek om 9.00 uur\nPrijs: gratis - open voor iedereen"
        ],
        "es": [
          "en el marco de la Fiesta del Vuelo en la Costa de Ópalo\nCita a las 8.45 h en la entrada del camping \"Chez Mireille\" para un recorrido familiar de 30 km\nSalida a las 9h00\nPrecio: gratuito - abierto a todos"
        ]
      },
      "@type": [
        "Description"
      ],
