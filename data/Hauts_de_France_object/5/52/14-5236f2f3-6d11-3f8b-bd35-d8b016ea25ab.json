  "rdfs:comment": {
    "de": [
      "In ?Grand Écart? lässt sich Kiyan Khoshoie von den Codes der One-Man-Show, des Stand-Ups und der Performance inspirieren, um ein hybrides Solo an der Schnittstelle zwischen Tanz und Theater zu schaffen."
    ],
    "en": [
      "With Grand Écart, Kiyan Khoshoie draws on the codes of the one-man show, stand-up comedy and performance art to create a hybrid solo at the crossroads of dance and theater."
    ],
    "it": [
      "In Grand Écart, Kiyan Khoshoie attinge ai codici del one-man show, dello stand-up e della performance per creare un assolo ibrido all'incrocio tra danza e teatro."
    ],
    "fr": [
      "Avec “Grand Écart”, Kiyan Khoshoie s’inspire des codes du one man show, du stand up et de la performance pour créer un solo hybride à la croisée de la danse et du théâtre."
    ],
    "nl": [
      "In Grand Écart maakt Kiyan Khoshoie gebruik van de codes van de one-man-show, stand-up en performance om een hybride solo te creëren op het kruispunt van dans en theater."
    ],
    "es": [
      "En Grand Écart, Kiyan Khoshoie recurre a los códigos del espectáculo unipersonal, el stand-up y la performance para crear un solo híbrido en la encrucijada de la danza y el teatro."
    ]
  },
