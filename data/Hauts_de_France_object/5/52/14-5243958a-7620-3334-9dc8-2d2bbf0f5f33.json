  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/35495059-3dbf-3614-b860-94a7128e2673",
      "dc:description": {
        "de": [
          "Die Brasserie Audomaroise befindet sich in einem alten Gebäude mit Gewölbekeller und zeigt Ihnen ihre Vorzüge. Baden Sie in einer nicht alltäglichen Atmosphäre und genießen Sie Gerichte, die mit originellen, vor Ort kreierten Bieren verfeinert werden."
        ],
        "en": [
          "Located in an old building with a vaulted cellar, the Brasserie Audomaroise reveals its assets. Bathe in an atmosphere that is out of the ordinary around dishes accompanied by original beers created on site."
        ],
        "it": [
          "Situata in un antico edificio con una cantina a volta, la Brasserie Audomaroise rivela i suoi pregi. Immergetevi in un'atmosfera fuori dal comune attorno a piatti arricchiti da birre originali create sul posto."
        ],
        "fr": [
          "Située dans une ancienne bâtisse avec cave voûtée, la Brasserie Audomaroise vous dévoile ses atouts. Baignez dans une atmosphère qui sort de l'ordinaire autour de plats agrémentés de bières originales créées sur place."
        ],
        "es": [
          "Situada en un antiguo edificio con una bodega abovedada, la Brasserie Audomaroise revela sus ventajas. Báñese en un ambiente fuera de lo común en torno a platos realzados por cervezas originales creadas en el momento."
        ],
        "nl": [
          "Gelegen in een oud gebouw met een gewelfde kelder onthult de Brasserie Audomaroise haar troeven. Geniet van een ongewone sfeer rond gerechten die worden verrijkt met originele bieren die ter plaatse worden gecreëerd."
        ]
      },
      "@type": [
        "Description"
      ],
