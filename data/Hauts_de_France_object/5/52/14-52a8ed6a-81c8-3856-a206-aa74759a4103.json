  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5a5cdee1-2b38-3476-a106-47aa6b016f91",
      "dc:description": {
        "de": [
          "Das gegenüber dem Rathaus gelegene La Charrette ist ein Restaurant in angenehmer Umgebung. Marie-Hélène und Eddy empfangen Sie in einer warmen und freundlichen Atmosphäre, in der Sie die Küche des Patrons und seine Spezialitäten genießen können."
        ],
        "en": [
          "Located opposite the town hall, La Charrette is a restaurant with a pleasant setting. Marie-Hélène and Eddy welcome you in a warm and friendly atmosphere where you can taste the owner's cuisine and his specialities."
        ],
        "it": [
          "Situato di fronte al municipio, La Charrette è un ristorante dall'ambiente piacevole. Marie-Hélène e Eddy vi accolgono in un'atmosfera calda e amichevole, dove potrete gustare la cucina e le specialità del proprietario."
        ],
        "fr": [
          "Situé face à l’hôtel de ville, La Charrette est un restaurant au cadre agréable. Marie-Hélène et Eddy vous accueillent dans une ambiance chaleureuse et conviviale où vous pourrez déguster la cuisine du patron et ses spécialités."
        ],
        "es": [
          "Situado frente al ayuntamiento, La Charrette es un restaurante con un ambiente agradable. Marie-Hélène y Eddy le dan la bienvenida en un ambiente cálido y acogedor donde podrá disfrutar de la cocina y las especialidades del propietario."
        ],
        "nl": [
          "La Charrette, gelegen tegenover het stadhuis, is een restaurant met een aangenaam kader. Marie-Hélène en Eddy verwelkomen u in een warme en vriendelijke sfeer waar u kunt genieten van de keuken en de specialiteiten van de eigenaar."
        ]
      },
      "@type": [
        "Description"
      ],
