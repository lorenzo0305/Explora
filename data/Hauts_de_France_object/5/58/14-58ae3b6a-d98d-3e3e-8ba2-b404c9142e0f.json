  "rdfs:comment": {
    "de": [
      "Verkauf auf den Märkten von Wissant (Mittwochmorgen und Freitagabend in der Saison), Boulogne-sur-Mer am Samstagmorgen, Le Channel in Calais am 2. und letzten Samstag jedes Monats)."
    ],
    "en": [
      "Sales at markets in Wissant (Wednesday mornings, and Friday evenings in season), Boulogne-sur-Mer on Saturday mornings, and at the Channel in Calais on the 2nd and last Saturday of each month)."
    ],
    "it": [
      "Vendite nei mercati di Wissant (mercoledì mattina e venerdì sera in stagione), di Boulogne-sur-Mer il sabato mattina e della Manica a Calais il secondo e l'ultimo sabato di ogni mese)."
    ],
    "fr": [
      "Vente sur les marchés de Wissant (mercredi matin, et vendredi soir en saison), de Boulogne-sur-Mer le samedi matin, au Channel à Calais le 2e et dernier samedi de chaque mois)."
    ],
    "nl": [
      "Verkoop op de markten in Wissant (woensdagochtend en vrijdagavond in het seizoen), Boulogne-sur-Mer op zaterdagochtend en het Kanaal in Calais op de 2e en laatste zaterdag van elke maand)."
    ],
    "es": [
      "Venta en los mercados de Wissant (los miércoles por la mañana y los viernes por la tarde en temporada), Boulogne-sur-Mer los sábados por la mañana y el Canal de Calais el segundo y el último sábado de cada mes)."
    ]
  },
