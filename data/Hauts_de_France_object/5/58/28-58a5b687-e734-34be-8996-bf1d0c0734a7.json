  "rdfs:comment": {
    "de": [
      "Dune Hôtel befindet sich in Grande-Synthe, in einer Gegend in der Nähe der Autobahn und der Einkaufsmöglichkeiten. Es ist ideal für Geschäftsreisende gelegen. Unser Hotel liegt 7 km vom Stadtzentrum von Dünkirchen entfernt. Wir bieten Ihnen komfortable Zimmer."
    ],
    "en": [
      "Dune Hotel is located in Grande-Synthe, in an area close to the highway and stores. Ideally located for business stays. Our hotel is located 7 kms from the city center of Dunkerque. We offer you comfortable rooms."
    ],
    "it": [
      "Il Dune Hotel si trova a Grande-Synthe, in una zona vicina all'autostrada e ai negozi. È un luogo ideale per soggiorni d'affari. Il nostro hotel si trova a 7 km dal centro di Dunkerque. Offriamo camere confortevoli."
    ],
    "fr": [
      "Dune Hôtel est situé à Grande-Synthe, dans une zone proche de l'autoroute et des magasins. Idéalalement placé pour les séjours professionnels. Notre hôtel se situe à7 kms du centre ville de Dunkerque. Nous vous proposons des chambres confortables."
    ],
    "es": [
      "El Hotel Dune está situado en Grande-Synthe, en una zona cercana a la autopista y a los comercios. Idealmente situado para estancias de negocios. Nuestro hotel se encuentra a 7 km del centro de Dunkerque. Ofrecemos habitaciones confortables."
    ],
    "nl": [
      "Dune Hotel is gelegen in Grande-Synthe, in een gebied dicht bij de snelweg en winkels. Ideaal gelegen voor een zakelijk verblijf. Ons hotel ligt op 7 km van het centrum van Duinkerke. Wij bieden comfortabele kamers."
    ]
  },
