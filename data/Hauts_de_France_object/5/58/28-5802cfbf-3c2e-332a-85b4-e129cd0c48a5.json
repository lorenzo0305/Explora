  "rdfs:comment": {
    "de": [
      "O?Charolais lädt Feinschmecker in ein zeitgemäßes und gemütliches Ambiente ein. Das Team steht Ihnen zu Diensten, damit Sie eine sehr gute Zeit verbringen können."
    ],
    "en": [
      "O?Charolais invites the gourmets in a contemporary and warm decoration. The team is at your service to allow you to spend a very good moment."
    ],
    "it": [
      "O?Charolais invita i buongustai in un ambiente contemporaneo e caldo. L'équipe è al vostro servizio per aiutarvi a divertirvi."
    ],
    "fr": [
      "O’Charolais invite les gourmands dans un décor contemporain et chaleureux. L’équipe est à votre service pour vous permettre de passer un très bon moment."
    ],
    "nl": [
      "O?Charolais nodigt fijnproevers uit in een eigentijds en warm decor. Het team staat voor u klaar om u een fijne tijd te bezorgen."
    ],
    "es": [
      "O?Charolais invita a los gourmets en una decoración contemporánea y cálida. El equipo está a su servicio para ayudarle a pasarlo en grande."
    ]
