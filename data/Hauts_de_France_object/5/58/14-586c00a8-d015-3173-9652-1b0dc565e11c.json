      "@id": "https://data.datatourisme.fr/d73320ed-3f5c-3fc7-94f7-de781305736c",
      "dc:description": {
        "de": [
          "Vereinigung von Sammlern von Sammlerfahrzeugen.\nSie bieten das ganze Jahr über eine ganze Agenda von Veranstaltungen und Treffen an."
        ],
        "en": [
          "Association of collectors of vintage vehicles.\nThey offer a full calendar of events and gatherings throughout the year."
        ],
        "it": [
          "Associazione di collezionisti di veicoli d'epoca.\nOffre un calendario completo di eventi e raduni durante tutto l'anno."
        ],
        "fr": [
          "Association de collectionneurs de véhicules de collection. \nIls proposent tout un agenda d'évènements, de rassemblement tout au long de l'année."
        ],
        "nl": [
          "Vereniging van verzamelaars van oldtimers.\nZe bieden een volledige kalender met evenementen en bijeenkomsten gedurende het hele jaar."
        ],
        "es": [
          "Asociación de coleccionistas de vehículos antiguos.\nOfrecen un completo calendario de eventos y reuniones a lo largo del año."
        ]
      },
