  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/964f2fd4-c441-3a0b-9a2f-f4c1c7d920cb",
      "dc:description": {
        "de": [
          "Cap Nature befindet sich in Cap-Gris-Nez\nOriginelles Konzept, bei dem regionale, handwerkliche und natürliche Produkte in allen Themenbereichen und auf über 300m² angeboten werden: von kulinarischen Spezialitäten über Kunsthandwerk bis hin zu Büchern und Spielen an einem außergewöhnlichen Ort"
        ],
        "en": [
          "Cap Nature is located at Cap-Gris-Nez\nAn original concept where regional, artisanal and natural products can be found in every theme and on more than 300m²: from culinary specialities to arts and crafts, books and games on an exceptional site"
        ],
        "it": [
          "Cap Nature è situato a Cap-Gris-Nez\nUn concetto originale in cui si possono trovare prodotti regionali, artigianali e naturali su tutti i temi e su oltre 300 m²: dalle specialità culinarie all'artigianato, dai libri ai giochi in un sito eccezionale"
        ],
        "fr": [
          "Cap Nature se situe au Cap-Gris-Nez\nConcept original où produits régionaux, artisanaux et naturels se déclinent ans toutes les thématiques et sur plus de 300m² : des spécialités culinaires à l'artisanat d'art en passant par les livres et les jeux sur un site exceptionnel"
        ],
        "es": [
          "Cap Nature se encuentra en Cap-Gris-Nez\nUn concepto original donde se pueden encontrar productos regionales, artesanales y naturales en todos los temas y en más de 300 m²: desde especialidades culinarias hasta artesanía, libros y juegos en un lugar excepcional"
        ],
        "nl": [
          "Cap Nature ligt in Cap-Gris-Nez\nEen origineel concept waar regionale, ambachtelijke en natuurlijke producten te vinden zijn op alle thema's en meer dan 300m²: van culinaire specialiteiten tot kunstnijverheid, boeken en spelletjes op een uitzonderlijke site"
        ]
      },
      "@type": [
        "Description"
      ],
