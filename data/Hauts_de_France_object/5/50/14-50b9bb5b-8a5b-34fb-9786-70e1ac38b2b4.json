  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4e15e924-9dbf-38bb-8858-db7f1c9a4247",
      "dc:description": {
        "de": [
          "Wir entwickeln die Kultur und die Praktiken des Öko-Bürgers in Cucq Trépied Stella-plage und darüber hinaus durch die Organisation eines Repair-Cafés, von kulturellen Veranstaltungen, Öko-Bürger-Workshops usw"
        ],
        "en": [
          "We develop culture and eco-citizen practices in Cucq Trépied Stella-plage and beyond by organizing a Repair café, cultural events, eco-citizen workshops, etc"
        ],
        "it": [
          "Sviluppiamo la cultura e le pratiche eco-cittadine a Cucq Trépied Stella-plage e oltre, organizzando un Repair café, eventi culturali, laboratori eco-cittadini, ecc"
        ],
        "fr": [
          "Nous développons la culture et les pratiques écocitoyennes sur Cucq Trépied Stella-plage et au-delà par l'organisation d'un Repair café, de manifestations culturelles, d'ateliers écocitoyens, etc"
        ],
        "nl": [
          "We ontwikkelen een eco-burger cultuur en praktijken in Cucq Trépied Stella-plage en daarbuiten door het organiseren van een Repair café, culturele evenementen, eco-burger workshops, enz"
        ],
        "es": [
          "Desarrollamos la cultura y las prácticas ecociudadanas en Cucq Trépied Stella-plage y más allá organizando un Repair café, actos culturales, talleres ecociudadanos, etc"
        ]
      },
