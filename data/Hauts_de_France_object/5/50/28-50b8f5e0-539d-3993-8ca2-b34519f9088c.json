  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fa6f695e-8b0d-349f-9085-79ebc0c5bb14",
      "dc:description": {
        "de": [
          "Die Mediathek in Vignacourt empfängt Sie :\n- am Dienstag von 14:00 bis 19:00 Uhr ;\n- am Mittwoch, Donnerstag und Freitag von 14:00 bis 18:00 Uhr ;\n- am Samstag von 9:00 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr."
        ],
        "en": [
          "The media library of Vignacourt welcomes you:\n- tuesday from 14:00 to 19:00;\n- wednesday, Thursday and Friday from 14h00 to 18h00;\n- saturday from 9h00 to 12h00 and from 14h00 to 17h00."
        ],
        "it": [
          "La mediateca di Vignacourt vi accoglie:\n- martedì dalle 14.00 alle 19.00;\n- mercoledì, giovedì e venerdì dalle 14.00 alle 18.00;\n- sabato dalle 9.00 alle 12.00 e dalle 14.00 alle 17.00."
        ],
        "fr": [
          "La médiathèque de Vignacourt vous accueille :\n- le mardi de 14h00 à 19h00 ;\n- les mercredi, jeudi et vendredi de 14h00 à 18h00 ;\n- le samedi de 9h00 à 12h00 et de 14h00 à 17h00."
        ],
        "es": [
          "La mediateca de Vignacourt le da la bienvenida:\n- martes de 14 a 19 horas;\n- miércoles, jueves y viernes de 14 a 18 horas;\n- los sábados de 9 a 12 y de 14 a 17 horas."
        ],
        "nl": [
          "De mediatheek van Vignacourt heet u welkom:\n- dinsdag van 14.00 tot 19.00 uur;\n- woensdag, donderdag en vrijdag van 14.00 tot 18.00 uur;\n- op zaterdag van 9 tot 12 uur en van 14 tot 17 uur."
        ]
      },
      "@type": [
