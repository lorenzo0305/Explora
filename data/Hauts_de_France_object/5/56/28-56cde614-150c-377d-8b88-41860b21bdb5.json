  "rdfs:comment": {
    "de": [
      "Das in einem ehemaligen Herrenhaus untergebrachte Hotel des Verriers ist ein Beispiel für das bemerkenswerte architektonische Erbe des Bol Vert, das mit der Geschichte der Glasindustrie des 19. Jahrhunderts und der Sanierung des Ortes durch den Verein La Maison des Enfants verbunden ist."
    ],
    "en": [
      "Installed in a former mansion, the Hotel des Verriers is an example of the remarkable architectural heritage of the Bol Vert, linked to the history of the glass industry of the 19th century and the rehabilitation of the site by the Association La Maison des Enfants."
    ],
    "it": [
      "Situato in un'antica dimora, l'Hôtel des Verriers è un esempio del notevole patrimonio architettonico del Bol Vert, legato alla storia dell'industria vetraria del XIX secolo e al recupero del sito da parte dell'Associazione La Maison des Enfants."
    ],
    "fr": [
      "Installée dans une ancienne maison de maîtres, l’hôtel des Verriers est un exemple du patrimoine architectural remarquable du Bol Vert, lié à l’histoire de l’industrie verrière du XIXème Siècle et à la réhabilitation du site par l’Association La Maison des Enfants."
    ],
    "es": [
      "Situado en una antigua mansión, el Hôtel des Verriers es un ejemplo del notable patrimonio arquitectónico del Bol Vert, vinculado a la historia de la industria del vidrio en el siglo XIX y a la rehabilitación del lugar por la Asociación La Maison des Enfants."
    ],
    "nl": [
      "Het Hôtel des Verriers, gevestigd in een voormalig herenhuis, is een voorbeeld van het opmerkelijke architecturale erfgoed van de Bol Vert, verbonden met de geschiedenis van de glasindustrie in de 19e eeuw en het herstel van de site door de vereniging La Maison des Enfants."
    ]
  },
