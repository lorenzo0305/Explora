  "rdfs:comment": {
    "de": [
      "Jedes Jahr findet im charmanten Badeort Wimereux der North Sea Cup statt, ein unumgängliches Sportereignis, das Fans, Athleten und Schaulustige aus ganz Europa zusammenbringt."
    ],
    "en": [
      "Every year, the charming seaside resort of Wimereux plays host to the North Sea Cup, an unmissable sporting event that brings together enthusiasts, athletes and curious onlookers from all over Europe."
    ],
    "it": [
      "Ogni anno, l'incantevole località balneare di Wimereux ospita la North Sea Cup, un evento sportivo imperdibile che riunisce appassionati, atleti e curiosi da tutta Europa."
    ],
    "fr": [
      "Chaque année, la charmante station balnéaire de Wimereux accueille la North Sea Cup, un événement sportif incontournable qui rassemble passionnés, athlètes et curieux venus de toute l’Europe."
    ],
    "nl": [
      "Elk jaar vindt in de charmante badplaats Wimereux de North Sea Cup plaats, een niet te missen sportevenement dat liefhebbers, atleten en nieuwsgierige toeschouwers uit heel Europa samenbrengt."
    ],
    "es": [
      "Cada año, la encantadora estación balnearia de Wimereux acoge la Copa del Mar del Norte, un acontecimiento deportivo ineludible que reúne a aficionados, atletas y curiosos de toda Europa."
