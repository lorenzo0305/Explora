  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e5338170-1623-3dec-a8a6-abdc4632fb3a",
      "dc:description": {
        "de": [
          "Saisonales Gemüse und alte Sorten aus dem Marschland, Kartoffeln, Kresse, Karotten aus Tilques, Artischocken Gros vert aus Laon, Chicorée aus dem Freiland, Porree, Salate, Tomaten, Paprika."
        ],
        "en": [
          "Seasonal vegetables and old varieties of marsh vegetables, potatoes, watercress, Tilques carrots, Gros vert de Laon artichokes, field endives, leeks, salads, tomatoes, peppers."
        ],
        "it": [
          "Verdure di stagione e vecchie varietà della palude, patate, crescione, carote Tilques, carciofi Gros Vert de Laon, indivia, porri, insalate, pomodori, peperoni."
        ],
        "fr": [
          "Légumes de saison et variétés anciennes du marais, pommes de terre, cresson, carottes de Tilques, artichauts Gros vert de Laon, endives de pleine terre, poireaux, salades, tomates, poivrons."
        ],
        "es": [
          "Verduras de temporada y variedades antiguas del pantano, patatas, berros, zanahorias de Tilques, alcachofas Gros Vert de Laon, endibias, puerros, ensaladas, tomates, pimientos."
        ],
        "nl": [
          "Seizoensgroenten en oude variëteiten uit het moeras, aardappelen, waterkers, Tilques wortelen, Gros Vert de Laon artisjokken, andijvie, prei, salades, tomaten, paprika's."
        ]
      },
