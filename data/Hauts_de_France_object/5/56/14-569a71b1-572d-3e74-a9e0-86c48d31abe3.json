      "dc:description": {
        "de": [
          "Soirée blanche um 21:30 Uhr organisiert vom Fremdenverkehrsamt auf der Esplanade - Alle in Weiß, um zu den besten Hits zu tanzen und zu singen - Esplanade de Sainte Cécile"
        ],
        "en": [
          "Soirée blanche at 9:30 p.m. organized by the Tourist Office on the esplanade - Everyone in white to dance and sing along to the greatest hits - Esplanade de Sainte Cécile"
        ],
        "it": [
          "Soirée blanche alle 21.30 organizzata dall'Ufficio del Turismo sulla spianata - Tutti in bianco per ballare e cantare i più grandi successi - Spianata di Sainte Cécile"
        ],
        "fr": [
          "Soirée blanche à 21h30 organisée par l'Office de Tourisme sur l'esplanade - Tous en blanc pour danser et chanter sur les meilleurs tubes - Esplanade de Sainte Cécile"
        ],
        "nl": [
          "Soirée blanche om 21u30 georganiseerd door het Office du Tourisme op de esplanade - Iedereen in het wit om te dansen en mee te zingen met de grootste hits - Esplanade de Sainte Cécile"
        ],
        "es": [
          "Soirée blanche a las 21.30 h organizada por la Oficina de Turismo en la explanada - Todos de blanco para bailar y cantar al ritmo de los grandes éxitos - Esplanade de Sainte Cécile"
        ]
      },
