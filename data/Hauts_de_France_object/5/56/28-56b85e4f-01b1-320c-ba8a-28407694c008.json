  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f36c4365-0800-3496-854d-6b9ef2928751",
      "dc:description": {
        "de": [
          "Die Mediathek in Saint-Léger-les-Domart empfängt Sie :\n- am Dienstag von 9:30 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr ;\n- am Mittwoch von 9:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr ;\n- am Freitag von 14:00 bis 19:00 Uhr ;\n- am Samstag von 9:30 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr."
        ],
        "en": [
          "The media library of Saint-Léger-les-Domart welcomes you:\n- tuesday from 9:30 to 12:00 and from 14:00 to 18:00;\n- wednesdays from 9:00 to 12:00 and from 14:00 to 18:00;\n- friday from 14:00 to 19:00;\n- saturday from 9:30 to 12:00 and from 14:00 to 17:00."
        ],
        "it": [
          "La mediateca di Saint-Léger-les-Domart vi dà il benvenuto:\n- martedì dalle 9.30 alle 12.00 e dalle 14.00 alle 18.00;\n- mercoledì dalle 9.00 alle 12.00 e dalle 14.00 alle 18.00;\n- venerdì dalle 14:00 alle 19:00;\n- sabato dalle 9.30 alle 12.00 e dalle 14.00 alle 17.00."
        ],
        "fr": [
          "La médiathèque de Saint-Léger-les-Domart vous accueille :\n- le mardi de 9h30 à 12h00 et de 14h00 à 18h00 ;\n- le mercredi de 9h00 à 12h00 et de 14h00 à 18h00 ;\n- le vendredi de 14h00 à 19h00 ;\n- le samedi de 9h30 à 12h00 et de 14h00 à 17h00."
        ],
        "es": [
          "La mediateca de Saint-Léger-les-Domart le da la bienvenida:\n- los martes de 9.30 a 12 y de 14 a 18 horas;\n- los miércoles de 9 a 12 y de 14 a 18 horas;\n- viernes de 14 a 19 horas;\n- sábado de 9.30 a 12 y de 14 a 17 horas."
        ],
        "nl": [
          "De mediatheek van Saint-Léger-les-Domart heet u welkom:\n- dinsdags van 9.30 tot 12 uur en van 14 tot 18 uur;\n- woensdag van 9 tot 12 uur en van 14 tot 18 uur;\n- vrijdag van 14.00 tot 19.00 uur;\n- zaterdag van 9.30 tot 12 uur en van 14 tot 17 uur."
        ]
      },
