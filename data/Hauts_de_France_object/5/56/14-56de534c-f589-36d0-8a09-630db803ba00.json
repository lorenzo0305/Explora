      "dc:description": {
        "de": [
          "Frau Ternisien stellt in dem schönen Dorf Lacres Papin-Torten (auch Libouli-Torte genannt), Quiches und Quatres-quarts her."
        ],
        "en": [
          "Mme Ternisien makes tartes au Papin (also known as tarte au libouli), quiches and quatres-quarts in the beautiful village of Lacres."
        ],
        "it": [
          "Mme Ternisien prepara tartes au Papin (note anche come tarte au libouli), quiche e quatres-quarts nel bellissimo villaggio di Lacres."
        ],
        "fr": [
          "Mme Ternisien fabrique des  tartes au Papin (dit aussi tarte au libouli), quiches et quatres-quarts dans le beau village de Lacres."
        ],
        "es": [
          "Mme Ternisien elabora tartes au Papin (también conocidas como tarte au libouli), quiches y quatres-quarts en el hermoso pueblo de Lacres."
        ],
        "nl": [
          "Mevrouw Ternisien maakt tartes au Papin (ook bekend als tarte au libouli), quiches en quatres-quarts in het prachtige dorp Lacres."
        ]
