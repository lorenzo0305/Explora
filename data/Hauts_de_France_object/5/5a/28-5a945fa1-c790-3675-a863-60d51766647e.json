      "@id": "https://data.datatourisme.fr/25afe113-db8d-3343-9184-934ef7b2700e",
      "dc:description": {
        "de": [
          "Probieren Sie die bistronomische Küche des Küchenchefs Jérôme Prévost, der lokale und saisonale Produkte in Wunder für Ihren Gaumen verwandelt!"
        ],
        "en": [
          "Come and sample the bistronomic cuisine of chef Jérôme Prévost, who transforms local, seasonal produce into a marvellous treat for your taste buds!"
        ],
        "it": [
          "Venite a gustare la cucina bistronomica dello chef Jérôme Prévost, che trasforma i prodotti locali e di stagione in delizie culinarie!"
        ],
        "fr": [
          "Venez gouter à la cuisine bistronomique du chef Jérôme Prévost, qui transforme les produits locaux et de saison en merveilles pour vos papilles !"
        ],
        "es": [
          "Venga a degustar la cocina bistronómica del chef Jérôme Prévost, que transforma los productos locales y de temporada en delicias culinarias"
        ],
        "nl": [
          "Kom proeven van de bistronomische keuken van chef-kok Jérôme Prévost, die lokale en seizoensgebonden producten omtovert tot culinaire hoogstandjes!"
        ]
      },
