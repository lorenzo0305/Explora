  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e7a7e12c-e5d3-38f4-a233-8e1a87c5a650",
      "dc:description": {
        "de": [
          "Im Herzen von Guise bietet Ihnen das Hôtel-Restaurant de la Ville seine orientalischen Spezialitäten und seine französische Küche an. Liebhaber von hausgemachtem Couscous sind hier genau richtig!"
        ],
        "en": [
          "In the heart of Guise, the Hôtel-Restaurant de la Ville offers oriental specialties and French cuisine. For lovers of homemade couscous, this is the place to be!"
        ],
        "it": [
          "Nel cuore di Guise, l'Hôtel-Restaurant de la Ville offre specialità orientali e cucina francese. Se amate il couscous fatto in casa, questo è il posto giusto!"
        ],
        "fr": [
          "Au coeur de Guise, l'Hôtel-Restaurant de la ville vous propose ses spécialités orientales et sa cuisine française. Amateurs de couscous maison, c'est ici que ça se passe !"
        ],
        "nl": [
          "In het hart van Guise biedt Hôtel-Restaurant de la Ville oosterse specialiteiten en de Franse keuken. Als je van zelfgemaakte couscous houdt, moet je hier zijn!"
        ],
        "es": [
          "En el corazón de Guise, el Hôtel-Restaurant de la Ville ofrece especialidades orientales y cocina francesa. Si le gusta el cuscús casero, ¡éste es su sitio!"
        ]
      },
