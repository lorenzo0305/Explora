  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d1c5cdb3-494f-3e80-886c-7fbe0ec7e82d",
      "dc:description": {
        "de": [
          "Grünfläche mit einer Fläche von 4300m2, die den Einwohnern für ein Picknick oder einen Spaziergang offen steht. Der Garten ist eine grüne und ruhige Insel im Herzen von Wazemmes. Geöffnet von Montag bis Sonntag von 9 bis 17 Uhr."
        ],
        "en": [
          "A 4300m2 green space open to residents for a picnic or stroll. The garden is an island of greenery and calm in the heart of Wazemmes. Open Monday to Sunday, 9am to 5pm."
        ],
        "it": [
          "Uno spazio verde di 4300 m2 aperto ai residenti per un picnic o una passeggiata. Il giardino è un'isola di verde e di calma nel cuore di Wazemmes. Aperto dal lunedì alla domenica, dalle 9.00 alle 17.00."
        ],
        "fr": [
          "Espace vert d'une surface de 4300m2 ouvert aux habitants pour un pique-nique ou promenade. Le jardin est un îlot de verdure et de calme en plein coeur de Wazemmes. Ouvert du lundi au dimanche de 9h à 17h."
        ],
        "es": [
          "Un espacio verde de 4300m2 abierto a los residentes para un picnic o un paseo. El jardín es una isla de verdor y calma en el corazón de Wazemmes. Abierto de lunes a domingo, de 9.00 a 17.00 horas."
        ],
        "nl": [
          "Een groene ruimte van 4300 m2 die openstaat voor bewoners voor een picknick of een wandeling. De tuin is een eiland van groen en rust in het hart van Wazemmes. Open van maandag tot zondag van 9 tot 17 uur."
        ]
      },
