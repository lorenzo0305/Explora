  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cdd66409-6f4f-38fc-837b-c346e57101e2",
      "dc:description": {
        "de": [
          "Entdeckung der Fotografien von Martine Franck und Jean-Pierre Gilson aus der Sammlung des Centre Régional de la Photographie CRP/. Vermittlung und gemeinsame Diskussion über die Werke, gefolgt von einem Einführungsworkshop in die Aquarellmalerei der Zwillingshalden des 11/19 mit dem Aquarellmaler Alain Riquier."
        ],
        "en": [
          "Discover photographs by Martine Franck and Jean-Pierre Gilson from the collection of the Centre Régional de la Photographie CRP/. Mediation and collective discussion of the works, followed by an introductory watercolor workshop on the twin slag heaps of 11/19 with watercolor painter Alain Riquier."
        ],
        "it": [
          "Scoperta di fotografie di Martine Franck e Jean-Pierre Gilson dalla collezione del Centre Régional de la Photographie CRP/. Mediazione e discussione di gruppo delle opere, seguita da un workshop introduttivo all'acquerello sui cumuli di scorie gemelle dell'11/19 con il pittore acquerellista Alain Riquier."
        ],
        "fr": [
          "Découverte des photographies de Martine Franck et de Jean-Pierre Gilson issues de la collection du Centre Régional de la Photographie CRP/. Médiation et discussion collective sur les oeuvres suivi d'un atelier d'initiation à l'aquarelle des terrils jumeaux du 11/19 avec le peintre aquarelliste Alain Riquier."
        ],
        "nl": [
          "Ontdekking van foto's van Martine Franck en Jean-Pierre Gilson uit de collectie van het Centre Régional de la Photographie CRP/. Bemiddeling en groepsdiscussie over de werken, gevolgd door een inleidende aquarelworkshop over de dubbele terrils van 11/19 met aquarelschilder Alain Riquier."
        ],
        "es": [
          "Descubrimiento de fotografías de Martine Franck y Jean-Pierre Gilson de la colección del Centre Régional de la Photographie CRP/. Mediación y debate en grupo sobre las obras, seguido de un taller de iniciación a la acuarela sobre los escoriales gemelos del 11/19 con el pintor acuarelista Alain Riquier."
        ]
      },
