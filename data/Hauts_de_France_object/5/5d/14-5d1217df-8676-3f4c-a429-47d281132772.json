  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4e8a7af8-941e-3a00-a630-8648c2f694ea",
      "dc:description": {
        "de": [
          "Select Opale ist ein Handelsunternehmen für Meeresfrüchte in Boulogne-sur-Mer, das sich auf den Verkauf von frischem, lebendem oder gekochtem Fisch, Schalentieren und Weichtieren aus lokalen Fischauktionen spezialisiert hat und professionellen und privaten Anbietern mit einem hohen Anspruch an Frische und Qualität angeboten wird"
        ],
        "en": [
          "Select Opale is a seafood trading company based in Boulogne-sur-Mer, specializing in the sale of fresh, live and cooked fish, shellfish and molluscs from local auctions, offered to professionals and private customers with the highest standards of freshness and quality"
        ],
        "it": [
          "Select Opale è una società di commercio di prodotti ittici con sede a Boulogne-sur-Mer, specializzata nella vendita di pesce fresco, vivo o cotto, crostacei e molluschi provenienti da aste locali a professionisti e privati, con particolare attenzione alla freschezza e alla qualità"
        ],
        "fr": [
          "Select Opale est une entreprise de négoce de produits de la mer à Boulogne‑sur‑Mer spécialisée dans la vente de poissons, crustacés et mollusques frais, vivants ou cuits, issus des criées locales et proposés aux professionnels et particuliers avec une exigence de fraîcheur et de qualité"
        ],
        "nl": [
          "Select Opale is een handelsbedrijf in vis, schaal- en schelpdieren uit Boulogne-sur-Mer, gespecialiseerd in de verkoop van verse, levende of gekookte vis, schaal- en schelpdieren van lokale veilingen aan professionals en particulieren, met de nadruk op versheid en kwaliteit"
        ],
        "es": [
          "Select Opale es una empresa de comercio de marisco con sede en Boulogne-sur-Mer especializada en la venta de pescado, crustáceos y moluscos frescos, vivos o cocidos, procedentes de subastas locales a profesionales y particulares, haciendo hincapié en la frescura y la calidad"
        ]
      },
      "@type": [
        "Description"
