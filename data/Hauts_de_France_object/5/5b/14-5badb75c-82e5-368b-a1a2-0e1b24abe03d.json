  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d51be256-925a-3a7d-b40d-62cc44116284",
      "dc:description": {
        "de": [
          "Verbringen Sie mit Freunden, der Familie oder Kollegen eine angenehme Zeit der Entspannung:<br>- 26 private Forellenangelstrecken<br>-Waldspaziergang (Quelle Saint-Kilien)"
        ],
        "en": [
          "Whether you're with friends, family or colleagues, you'll have a great time:<br>- 26 private trout fishing trails<br>-promenade in the forest (source Saint-Kilien)"
        ],
        "it": [
          "Che siate in compagnia di amici, familiari o colleghi, trascorrete dei momenti di relax insieme:<br>- 26 torrenti privati per la pesca alla trota<br>- passeggiate nella foresta (fonte Saint-Kilien)"
        ],
        "fr": [
          "Entre amis, en famille, ou entre collègues, passez un agréable moment de détente :<br>- 26 parcours privés de pêche à la truite<br>-promenade en forêt (source Saint-Kilien)"
        ],
        "es": [
          "Ya sea con amigos, familia o compañeros de trabajo, pasen juntos un rato de relax:<br>- 26 arroyos privados para pescar truchas<br>- paseos por el bosque (fuente Saint-Kilien)"
        ],
        "nl": [
          "Of u nu met vrienden, familie of collega's bent, breng samen wat ontspannende tijd door:<br>- 26 privéforelvisbeken<br>- boswandelingen (bron Saint-Kilien)"
        ]
      },
