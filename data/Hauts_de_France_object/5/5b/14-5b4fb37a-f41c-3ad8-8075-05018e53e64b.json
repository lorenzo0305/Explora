  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4ff1fbfb-86ec-32ac-a298-ace51abbda28",
      "dc:description": {
        "de": [
          "Essen auf Rädern - Unser Essenslieferservice bietet Ihnen die Möglichkeit, unsere kompletten Mahlzeiten direkt an Ihren Aufenthaltsort zu erhalten.\nFür weitere Informationen, Kontakte und Leistungen; besuchen Sie https://www.alphatransports.fr/index.html"
        ],
        "en": [
          "Portage de repas à domicile - Our meal delivery service offers you the possibility of receiving our complete meals directly at your place of residence.\nFor more information, contacts and services, visit https://www.alphatransports.fr/index.html"
        ],
        "it": [
          "Portage de repas à domicile - Il nostro servizio di consegna dei pasti vi offre la possibilità di ricevere i nostri pasti completi direttamente a casa vostra.\nPer maggiori informazioni, contatti e servizi, visitate il sito https://www.alphatransports.fr/index.html"
        ],
        "fr": [
          "Portage de repas à domicile - Notre service de livraison de repas vous offre la possibilité de recevoir nos repas complets directement sur votre lieu de séjour.\nPour plus d'informations, contacts et prestations ; rendez-vous sur https://www.alphatransports.fr/index.html"
        ],
        "nl": [
          "Portage de repas à domicile - Onze maaltijdbezorgservice biedt je de mogelijkheid om onze volledige maaltijden direct op je verblijfplaats te ontvangen.\nGa voor meer informatie, contactpersonen en diensten naar https://www.alphatransports.fr/index.html"
        ],
        "es": [
          "Portage de repas à domicile - Nuestro servicio de reparto de comidas le ofrece la posibilidad de recibir nuestras comidas completas directamente en su lugar de estancia.\nPara más información, contactos y servicios, visite https://www.alphatransports.fr/index.html"
        ]
      },
      "@type": [
        "Description"
