  "rdfs:comment": {
    "de": [
      "Das MusVerre, ein Muss für den Tourismus im Avesnois, ist sowohl ein Zeuge des vergangenen Glashandwerks als auch ein Schaufenster der zeitgenössischen Glaskunst."
    ],
    "en": [
      "The MusVerre, a must for tourism in the Avesnois, is both a witness to past glassmaking and a showcase for contemporary glass art."
    ],
    "it": [
      "Il MusVerre, tappa obbligata per il turismo nell'Avesnois, è sia una testimonianza della lavorazione del vetro del passato che una vetrina dell'arte vetraria contemporanea."
    ],
    "fr": [
      "Le MusVerre, incontournable du tourisme dans l’Avesnois, est à la fois un témoin de l’artisanat verrier passé et la vitrine de l’art verrier contemporain."
    ],
    "nl": [
      "Het MusVerre, een must voor het toerisme in de Avesnois, is zowel een getuige van het glasverleden als een uitstalkast voor hedendaagse glaskunst."
    ],
    "es": [
      "El MusVerre, una visita obligada para el turismo en el Avesnois, es a la vez un testigo de la fabricación de vidrio del pasado y un escaparate del arte contemporáneo del vidrio."
    ]
  },
