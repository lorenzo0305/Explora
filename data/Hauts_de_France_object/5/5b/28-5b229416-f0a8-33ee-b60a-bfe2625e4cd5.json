  "rdfs:comment": {
    "de": [
      "NEJ' enthüllt ihre IRREEL TOUR und verspricht eine Show wie sie selbst: intensiv, fesselnd und unvergesslich. Nach der Veröffentlichung ihres letzten Albums SOS IV sollten Sie sich die Gelegenheit nicht entgehen lassen, sie in ganz Frankreich, der Schweiz und Belgien live zu erleben."
    ],
    "en": [
      "NEJ' unveils her IRREEL TOUR and promises a show in her image: intense, spellbinding and unforgettable. Following the release of her latest album, SOS IV, don't miss the chance to see her live across France, Switzerland and Belgium."
    ],
    "it": [
      "NEJ' svela il suo IRREEL TOUR e promette uno spettacolo a sua immagine e somiglianza: intenso, ammaliante e indimenticabile. Dopo l'uscita del suo ultimo album, SOS IV, non perdete l'occasione di vederla dal vivo in Francia, Svizzera e Belgio."
    ],
    "fr": [
      "NEJ' dévoile son IRREEL TOUR et promet un show à son image : intense, envoûtant et inoubliable. Après la sortie de son dernier album SOS IV, ne manquez pas l’occasion de la voir en live partout en France, Suisse et Belgique."
    ],
    "nl": [
      "NEJ' onthult haar IRREEL TOUR en belooft een show naar haar evenbeeld: intens, betoverend en onvergetelijk. Na de release van haar laatste album, SOS IV, mag je de kans niet missen om haar live te zien in Frankrijk, Zwitserland en België."
    ],
    "es": [
      "NEJ' desvela su gira IRREEL TOUR y promete un espectáculo a su imagen y semejanza: intenso, hechizante e inolvidable. Tras el lanzamiento de su último álbum, SOS IV, no te pierdas la oportunidad de verla en directo por Francia, Suiza y Bélgica."
    ]
  },
