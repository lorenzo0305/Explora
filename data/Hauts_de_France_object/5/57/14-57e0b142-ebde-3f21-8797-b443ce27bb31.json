  "rdfs:comment": {
    "de": [
      "Dieses Hotel befindet sich gegenüber dem Bahnhof und im Obergeschoss einer Brasserie. Es ist der richtige Ort, um im Herzen von Arras eine Pause einzulegen."
    ],
    "en": [
      "Located opposite the station and on the floor of a brasserie, this hotel is the perfect place to take a break in the heart of Arras."
    ],
    "it": [
      "Situato di fronte alla stazione e al piano di una brasserie, questo hotel è il luogo ideale per una pausa nel cuore di Arras."
    ],
    "fr": [
      "Situé en face de la gare et à l'étage d'une brasserie,  cet hôtel est le bon endroit pour faire une pause au cœur d'Arras."
    ],
    "es": [
      "Situado frente a la estación y en la planta de una brasserie, este hotel es el lugar perfecto para hacer una pausa en el corazón de Arras."
    ],
    "nl": [
      "Dit hotel ligt tegenover het station en op de verdieping van een brasserie en is de perfecte plek voor een pauze in het hart van Arras."
    ]
  },
