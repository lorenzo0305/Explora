  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5f538d29-3f52-3949-887a-37b3a26b21e0",
      "dc:description": {
        "de": [
          "Eine kleine Süßigkeit vor oder nach dem Faulenzen im Sand? Begeben Sie sich zum Snack de la Plage, wo Getränke, Eis, Granita, Zuckerwatte, Popcorn... auf Sie warten."
        ],
        "en": [
          "A little treat before or after lounging in the sand? Go to the Beach Snack Bar where drinks, ice cream, granita, cotton candy, popcorn... are waiting for you."
        ],
        "it": [
          "Un po' di dolcezza prima o dopo essersi rilassati sulla sabbia? Andate allo Snack de la Plage dove vi attendono bevande, gelati, granite, zucchero filato, popcorn...."
        ],
        "fr": [
          "Une petite douceur avant ou après s'être prélassé sur le sable ? Rendez-vous au Snack de la Plage où vous attendent boissons, glaces, granités, barbe à papa, pop-corn..."
        ],
        "es": [
          "¿Un poco de dulzura antes o después de descansar en la arena? Diríjase al Snack de la Plage donde le esperan bebidas, helados, granizados, algodón de azúcar, palomitas..."
        ],
        "nl": [
          "Een beetje zoetigheid voor of na het luieren op het zand? Ga naar de Snack de la Plage waar drankjes, ijsjes, granita, suikerspinnen, popcorn... op u wachten."
        ]
      },
      "@type": [
        "Description"
