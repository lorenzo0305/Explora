  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a7cf0379-6e54-3584-a443-1021d09a8a1a",
      "dc:description": {
        "de": [
          "Gesellige Atmosphäre, traditionelle Küche, regionale und saisonale Gerichte\n\nAngebotene Gerichte: Tagesgericht, vegetarische Gerichte, Salate, Fisch, Muscheln, Grillspezialitäten, Crêpes, Welshes, Meeresfrüchteplatten, Kindermenü\n\nNachhaltige Ansätze: \"Null Plastik\", \"Null Abfall\", \"Nachhaltige Ernährung\" und \"Anti-Verschwendung\""
        ],
        "en": [
          "Friendly atmosphere, traditional cuisine, regional and seasonal dishes\n\nDaily specials, vegetarian dishes, salads, fish, mussels, grills, pancakes, welshes, seafood platters, children's menu\n\nSustainable approaches: \"zero plastic\", \"zero waste\", \"sustainable food\" and \"anti-gaspi\""
        ],
        "it": [
          "Atmosfera amichevole, cucina tradizionale, piatti regionali e stagionali\n\nPiatti offerti: piatto del giorno, piatti vegetariani, insalate, pesce, cozze, grigliate, frittelle, welsh, piatti di pesce, menu per bambini\n\nApprocci sostenibili: \"zero plastica\", \"zero rifiuti\", \"cibo sostenibile\" e \"anti-gaspi\""
        ],
        "fr": [
          "Ambiance conviviale, cuisine traditionelle, plats régionaux et de saisons\n\nPlats proposés : plat du jour, plats végétariens, salades, poissons, moules, grillades, crêpes, welshes, plateaux de fruits de mer, menu enfant\n\nDémarches durables : \"zéro plastique\", \"zéro déchet\", \"alimentation durable\" et \"anti-gaspi\""
        ],
        "nl": [
          "Vriendelijke sfeer, traditionele keuken, regionale en seizoensgebonden gerechten\n\nGerechtenaanbod: dagschotel, vegetarische gerechten, salades, vis, mosselen, grillgerechten, pannenkoeken, wafels, schalen met zeevruchten, kindermenu\n\nDuurzame aanpak: \"nul plastic\", \"nul afval\", \"duurzame voeding\" en \"antigaspi\""
        ],
        "es": [
          "Ambiente acogedor, cocina tradicional, platos regionales y de temporada\n\nPlatos ofrecidos: plato del día, platos vegetarianos, ensaladas, pescados, mejillones, parrilladas, tortitas, gulas, mariscadas, menú infantil\n\nEnfoques sostenibles: \"plástico cero\", \"residuos cero\", \"alimentos sostenibles\" y \"antigaspi\""
        ]
      },
