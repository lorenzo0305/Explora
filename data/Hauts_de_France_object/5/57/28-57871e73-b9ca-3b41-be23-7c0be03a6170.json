  "rdfs:comment": {
    "de": [
      "Sind Sie bereit für eine Runde Angeln mit den Füßen im Wasser am Meer? Sylvain empfängt Sie zu einer Surfcating-Session!"
    ],
    "en": [
      "Ready for a fishing trip with your feet in the water by the sea? Sylvain welcomes you for a surfcating session !"
    ],
    "it": [
      "Pronti per una battuta di pesca con i piedi nell'acqua in riva al mare? Sylvain vi accoglie per una sessione di surf!"
    ],
    "fr": [
      "Prêt pour une partie de pêche les pieds dans l'eau au bord de la mer ? Sylvain vous accueille pour une séance de surfcating !"
    ],
    "es": [
      "¿Listo para una salida de pesca con los pies en el agua junto al mar? Sylvain te da la bienvenida para una sesión de surf"
    ],
    "nl": [
      "Klaar voor een tochtje met de voeten in het water aan zee? Sylvain heet u welkom voor een surfsessie!"
    ]
  },
