  "rdfs:comment": {
    "de": [
      "La Chapelle ist der Kulturort, der in der ehemaligen Kapelle der Königlichen Spiegelmanufaktur eingerichtet wurde. Er soll für Ausstellungen und verschiedene Aufführungen genutzt werden."
    ],
    "en": [
      "The Chapel is the cultural place that was created in the former chapel of the Royal Manufacture of Mirrors. It is intended to host exhibitions and various shows."
    ],
    "it": [
      "La Chapelle è il luogo culturale creato nell'ex cappella della Vetreria Reale. È destinato a ospitare varie mostre e spettacoli."
    ],
    "fr": [
      "La Chapelle est le lieu culturel qui a été créé dans l’ancienne chapelle de la Manufacture royale des Glaces. Il a vocation à recevoir des expositions et des spectacles variés."
    ],
    "nl": [
      "La Chapelle is het culturele trefpunt dat werd gecreëerd in de voormalige kapel van de Koninklijke IJsfabriek. Het is de bedoeling dat er verschillende tentoonstellingen en voorstellingen worden gehouden."
    ],
    "es": [
      "La Chapelle es el espacio cultural creado en la antigua capilla de la Real Fábrica de Hielo. Está destinado a acoger diversas exposiciones y espectáculos."
