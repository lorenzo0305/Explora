  "rdfs:comment": {
    "de": [
      "Ein aus Blaustein und Ziegelsteinen errichteter Kalvarienberg mit einem Schieferdach.\r\nEr steht am Weg nach Bachant und gehört seit 1847 zur Gemeinde\r\nd'Eclaibes."
    ],
    "en": [
      "Calvary built of bluestone and brick, covered with a slate roof.\r\nLocated along the Chemin de Bachant, it belonged to the Commune d'Eclaibes in 1847\r\nof Eclaibes."
    ],
    "it": [
      "Calvario costruito in pietra blu e mattoni, con tetto in ardesia.\r\nSi trova lungo il Chemin de Bachant e nel 1847 apparteneva al Comune di Eclaibes\r\ndi Eclaibes."
    ],
    "fr": [
      "Calvaire construit en pierre bleue et brique, couvert d'un toit en ardoise.\r\nIl est situé le long du chemin de Bachant et appartient en 1847 à la Commune \r\nd’Eclaibes."
    ],
    "es": [
      "Calvario construido en piedra azul y ladrillo, con tejado de pizarra.\r\nEstá situado a lo largo del Chemin de Bachant y en 1847 pertenecía a la Comuna\r\nde Eclaibes."
    ],
    "nl": [
      "Calvarieberg gebouwd van arduin en baksteen, met een dak van leisteen.\r\nHet ligt langs de Chemin de Bachant en behoorde in 1847 tot de gemeente Eclaibes\r\nvan Eclaibes."
    ]
  },
  "rdfs:label": {
