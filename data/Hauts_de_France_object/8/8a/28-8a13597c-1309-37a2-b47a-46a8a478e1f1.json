  "rdfs:comment": {
    "de": [
      "Picknickplatz mit einem Tisch auf einer Rasenfläche gegenüber der Kirche. Parkplatz . Spielfeld für Petanque. Kinderspielplatz in der Nähe. Wanderweg in der Nähe."
    ],
    "en": [
      "Picnic area with a table on a grassy area in front of the church. Parking area. Petanque ground. Playground for children nearby. Hiking trail nearby."
    ],
    "it": [
      "Area picnic con tavolo su uno spazio erboso di fronte alla chiesa. Parcheggio. Campo da petanque. Parco giochi per bambini nelle vicinanze. Sentiero escursionistico nelle vicinanze."
    ],
    "fr": [
      "Aire de pique-nique aménagée d'une table sur un espace enherbé, face à l'église. Parking . Terrain de pétanque. Aire de jeux pour enfants à proximité. Chemin de randonnée à proximité."
    ],
    "es": [
      "Área de picnic con una mesa en una zona de césped frente a la iglesia. Aparcamiento. Campo de petanca. Parque infantil en las inmediaciones. Ruta de senderismo en las cercanías."
    ],
    "nl": [
      "Picknickplaats met een tafel op een grasveld voor de kerk. Parkeren. Petanque veld. Kinderspeelplaats in de buurt. Wandelpad in de buurt."
    ]
  },
