  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/220cb790-e3f6-3e33-a847-53e705126958",
      "dc:description": {
        "de": [
          "Start- und Landeplatz für den freien Flug in Auteuil (D 927, 60390). Ein idealer Spot für Gleitschirm- und Drachenflieger, der eine natürliche Umgebung bietet, die für sichere Flüge geeignet ist."
        ],
        "en": [
          "Take-off and landing site for hang-gliding at Auteuil (D 927, 60390). An ideal spot for paragliding and hang-gliding enthusiasts, offering a natural setting conducive to safe take-offs."
        ],
        "it": [
          "Il sito di decollo e atterraggio di Auteuil (D 927, 60390) è ideale per gli appassionati di parapendio e deltaplano, offrendo un ambiente naturale per decolli sicuri."
        ],
        "fr": [
          "Site de décollage et d’atterrissage pour le vol libre à Auteuil (D 927, 60390). Un spot idéal pour les amateurs de parapente et deltaplane, offrant un cadre naturel propice aux envols en toute sécurité."
        ],
        "es": [
          "El lugar de despegue y aterrizaje de Auteuil (D 927, 60390) es ideal para los aficionados al parapente y al ala delta, ya que ofrece un entorno natural para despegar con total seguridad."
        ],
        "nl": [
          "De start- en landingsplaats in Auteuil (D 927, 60390) is ideaal voor liefhebbers van paragliding en deltavliegen en biedt een natuurlijke omgeving voor veilig opstijgen."
        ]
      },
