  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/843d0e3e-3e00-318c-80c1-12f926f83458",
      "dc:description": {
        "de": [
          "Nutzen Sie unseren Hatha-Yoga-Workshop am Strand von Sainte-Cécile um 10 Uhr - Treffpunkt um 9:45 Uhr vor der Rettungsstation - Ab 12 Jahren -Matte oder Handtuch und Wasserflasche mitbringen"
        ],
        "en": [
          "Take advantage of our Hatha Yoga Workshop on the beach at Sainte-Cécile at 10am - RDV at 9:45am in front of the lifeguard station - From 12 years -Please bring mat or towel and bottle of water"
        ],
        "it": [
          "Approfittate del nostro workshop di Hatha Yoga sulla spiaggia di Sainte-Cécile alle 10.00 - Punto d'incontro alle 9.45 davanti alla stazione dei bagnini - A partire dai 12 anni - Portate un tappetino o un asciugamano e una bottiglia d'acqua"
        ],
        "fr": [
          "Profitez de notre Atelier Hatha Yoga sur la plage de Sainte-Cécile à 10h - RDV à 9h45 devant le poste de secours - A partir de 12 ans -Prévoir tapis ou serviette et bouteille d'eau"
        ],
        "nl": [
          "Doe mee met onze Hatha Yoga workshop op het strand van Sainte-Cécile om 10 uur - Verzamelpunt om 9.45 uur voor de strandwacht - Vanaf 12 jaar - Neem een matje of handdoek en een fles water mee"
        ],
        "es": [
          "Aprovecha nuestro taller de Hatha Yoga en la playa de Sainte-Cécile a las 10h - Punto de encuentro a las 9h45 delante del puesto de socorrismo - A partir de 12 años - Traer esterilla o toalla y botella de agua"
        ]
      },
