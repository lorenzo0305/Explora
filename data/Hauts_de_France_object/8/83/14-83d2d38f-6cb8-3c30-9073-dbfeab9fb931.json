      "@id": "https://data.datatourisme.fr/f4fa7030-2b4b-34d7-b8a2-8c5ffc941fd2",
      "dc:description": {
        "de": [
          "Zaubershow am Samstag, den 29. November um 15 Uhr - Festsaal in Crémarest.\n\nPreis: 7 Euro. Kostenlos für Kinder unter 3 Jahren.\n\nAuf Reservierung"
        ],
        "en": [
          "Magic show on Saturday November 29 at 3pm - Crémarest village hall.\n\nPrice: 7 euros. Free for children under 3.\n\nOn reservation"
        ],
        "it": [
          "Spettacolo di magia sabato 29 novembre alle 15.00 - sala del villaggio di Crémarest.\n\nPrezzo: 7 euro. Gratuito per i bambini sotto i 3 anni.\n\nSolo su prenotazione"
        ],
        "fr": [
          "Spectacle de magie le samedi 29 novembre à 15h - salle des fêtes de Crémarest.\n\nTarif : 7 euros. Gratuit pour les moins de 3 ans.\n\nSur réservation"
        ],
        "nl": [
          "Goochelshow op zaterdag 29 november om 15.00 uur - Crémarest dorpshuis.\n\nPrijs: €7. Gratis voor kinderen onder de 3 jaar.\n\nAlleen op reservering"
        ],
        "es": [
          "Espectáculo de magia el sábado 29 de noviembre a las 15.00 h. - Sala del pueblo de Crémarest.\n\nPrecio: 7 euros. Gratis para menores de 3 años.\n\nSólo con reserva"
        ]
      },
