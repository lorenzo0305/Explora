  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/684bd3d1-03e7-3739-9faa-ff8dfcb48168",
      "dc:description": {
        "de": [
          "Von Wolfgang Petersen\n\nDer zehnjährige Bastien ist ein begeisterter Leser von Abenteuerromanen. Eines Tages stiehlt er ein wunderbares Buch, das von außergewöhnlichen Kreaturen bevölkert ist. Er taucht fieberhaft in die fantastische Welt dieses Buches ein, das ihn fasziniert."
        ],
        "en": [
          "By Wolfgang Petersen\n\nTen-year-old Bastien has a passion for adventure novels. One day, he steals a marvelous book filled with extraordinary creatures. He plunges feverishly into the fantastic world of this book, which fascinates him."
        ],
        "it": [
          "Di Wolfgang Petersen\n\nBastien, dieci anni, ha una passione per i romanzi d'avventura. Un giorno ruba un libro meraviglioso pieno di creature straordinarie. Si immerge febbrilmente nel fantastico mondo di questo libro, che lo affascina."
        ],
        "fr": [
          "De Wolfgang Petersen\n\nBastien, dix ans, est un passionné de romans d'aventures. Un jour, il dérobe un ouvrage merveilleux peuplé d'extraordinaires créatures. Il s'enfonce fébrilement dans l'univers fantastique de ce livre qui le fascine."
        ],
        "es": [
          "Por Wolfgang Petersen\n\nA Bastien, un niño de diez años, le apasionan las novelas de aventuras. Un día, roba un libro maravilloso lleno de criaturas extraordinarias. Se sumerge febrilmente en el fantástico mundo de este libro, que le fascina."
        ],
        "nl": [
          "Door Wolfgang Petersen\n\nDe tienjarige Bastien heeft een passie voor avonturenromans. Op een dag steelt hij een prachtig boek vol bijzondere wezens. Hij duikt koortsachtig in de fantastische wereld van dit boek, dat hem fascineert."
        ]
      },
      "@type": [
        "Description"
