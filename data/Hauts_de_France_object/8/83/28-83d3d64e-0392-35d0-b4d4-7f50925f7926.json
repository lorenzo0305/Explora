  "rdfs:comment": {
    "de": [
      "Genießen Sie einen angenehmen Familienausflug auf dem 6,7 km langen Radweg von Cuise-la-Motte nach Courtieux (auf der ehemaligen Eisenbahnstrecke von Compiègne nach Soissons)! Am Rand des Radwegs in Couloisy steht Ihnen ein Picknicktisch aus Stein (mit einem Mülleimer) zur Verfügung."
    ],
    "en": [
      "Enjoy a pleasant family outing on the 6.7 km bike path from Cuise-la-Motte to Courtieux (on the old railroad line from Compiègne to Soissons)! A stone picnic table (with garbage can) is available at the edge of the cycle path in Couloisy."
    ],
    "it": [
      "Godetevi una piacevole gita in famiglia sui 6,7 km di pista ciclabile da Cuise-la-Motte a Courtieux (sulla vecchia linea ferroviaria da Compiègne a Soissons)! Un tavolo da picnic in pietra (con cestino) è disponibile ai margini della pista ciclabile a Couloisy."
    ],
    "fr": [
      "Profitez d’une balade agréable en famille sur les 6,7 km de pistes cyclables  de Cuise-la-Motte à Courtieux (sur l'ancienne voie ferrée de Compiègne à Soissons) ! Une table de pique-nique en pierre (avec une poubelle) est à votre disposition au bord de la piste cyclable à Couloisy."
    ],
    "nl": [
      "Geniet van een gezellig gezinsuitstapje op het 6,7 km lange fietspad van Cuise-la-Motte naar Courtieux (op de oude spoorlijn van Compiègne naar Soissons)! Een stenen picknicktafel (met afvalbak) is beschikbaar aan de rand van het fietspad in Couloisy."
    ],
    "es": [
      "Disfrute de un agradable paseo en familia por los 6,7 km de carril bici de Cuise-la-Motte a Courtieux (en la antigua línea ferroviaria de Compiègne a Soissons) Una mesa de picnic de piedra (con papelera) está disponible al borde del carril bici en Couloisy."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique-nique de Couloisy"
    ]
  },
