  "rdfs:comment": {
    "de": [
      "L?Emeraude in Fourmies bietet eine orientalische und traditionelle Küche in einer gemütlichen Atmosphäre mit Spezialitäten wie Couscous, Tajines und Gegrilltem zum Genießen vor Ort oder zum Mitnehmen"
    ],
    "en": [
      "L'Emeraude, located in Fourmies, offers traditional oriental cuisine in a warm atmosphere, with specialities such as couscous, tajines and grilled meats to enjoy on the spot or to take away"
    ],
    "it": [
      "L'Emeraude, situato a Fourmies, offre una cucina tradizionale orientale in un'atmosfera accogliente, con specialità come couscous, tajine e carni alla griglia da mangiare o da portare via"
    ],
    "fr": [
      "L’Emeraude, situé à Fourmies, propose une cuisine orientale et traditionnelle dans une ambiance chaleureuse, avec des spécialités couscous, tajines et grillades à savourer sur place ou à emporter"
    ],
    "es": [
      "L'Emeraude, situado en Fourmies, ofrece cocina tradicional oriental en un ambiente cálido, con especialidades como cuscús, tajines y carnes a la parrilla para comer en el restaurante o para llevar"
    ],
    "nl": [
      "L'Emeraude, gelegen in Fourmies, biedt traditionele oosterse gerechten in een warme sfeer, met specialiteiten zoals couscous, tajines en gegrild vlees om ter plekke te eten of mee te nemen"
    ]
  },
