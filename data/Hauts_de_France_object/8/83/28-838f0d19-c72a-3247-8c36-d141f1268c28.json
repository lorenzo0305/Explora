  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7e93ec80-8805-3179-8fbd-36c22554e4e8",
      "dc:description": {
        "de": [
          "Le Cooking, wenn Sie Lust auf frische hausgemachte Pommes frites sowie Burger, Sandwiches, Snacks und Pizzas haben!\nFastfood mit Qualitätsprodukten, ideal für ein Picknick am Strand!"
        ],
        "en": [
          "Le Cooking, for fresh home fries, burgers, sandwiches, snacks and pizzas!\nFast food with quality products, ideal for a beach picnic!"
        ],
        "it": [
          "Le Cooking, per patatine fresche, hamburger, panini, snack e pizze!\nCibo veloce con prodotti di qualità, ideale per un picnic in spiaggia!"
        ],
        "fr": [
          "Le Cooking, pour des envies de frites fraîches maison ainsi que des  burgers, sandwichs, du snack et des pizzas ! \nDe la restauration rapide avec des produits de qualité, idéale pour un pique nique à la plage !"
        ],
        "es": [
          "¡Le Cooking, para patatas fritas caseras frescas, hamburguesas, sándwiches, bocadillos y pizzas!\nComida rápida con productos de calidad, ¡ideal para un picnic en la playa!"
        ],
        "nl": [
          "Le Cooking, voor verse friet, hamburgers, sandwiches, snacks en pizza's!\nFast food met kwaliteitsproducten, ideaal voor een picknick op het strand!"
        ]
      },
