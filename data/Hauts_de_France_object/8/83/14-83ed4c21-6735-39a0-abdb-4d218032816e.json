  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ad0e98c5-49f6-3040-beaf-01453d3fecff",
      "dc:description": {
        "de": [
          "BAZILIC ist eine \"schicke\" Brasserie. Der Chefkoch bietet Ihnen eine authentische Küche mit saisonalen, frischen Produkten und mit französischem Fleisch. Das Restaurant ist am Sonntagabend und Montag ganztägig geschlossen (außer an Feiertagen)"
        ],
        "en": [
          "BAZILIC is a chic brasserie. The chef offers authentic cuisine using fresh seasonal produce and French meats. The restaurant is closed on Sunday evenings and all day Mondays (except public holidays)"
        ],
        "it": [
          "BAZILIC è un'elegante brasserie. Lo chef propone una cucina autentica a base di prodotti freschi di stagione e carni francesi. Il ristorante è chiuso la domenica sera e tutto il lunedì (tranne i giorni festivi)"
        ],
        "fr": [
          "BAZILIC est une brasserie \"chic\". Le Chef vous propose une cuisine authentique avec des produits de saison, frais et avec une viande française. Le restaurant est fermé le dimanche soir et le lundi toute la journée (sauf les jours fériés)"
        ],
        "nl": [
          "BAZILIC is een chique brasserie. De chef biedt een authentieke keuken met verse seizoensproducten en Frans vlees. Het restaurant is gesloten op zondagavond en maandag de hele dag (behalve op feestdagen)"
        ],
        "es": [
          "BAZILIC es una brasserie chic. El chef propone una cocina auténtica a base de productos frescos de temporada y carnes francesas. El restaurante cierra los domingos por la noche y los lunes todo el día (excepto festivos)"
        ]
      },
