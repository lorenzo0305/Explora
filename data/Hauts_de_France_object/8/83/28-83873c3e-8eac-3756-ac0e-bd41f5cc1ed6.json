  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dd760323-fec1-36a6-8036-5e01ddb9ff3c",
      "dc:description": {
        "de": [
          "Foodtruck mit festem Standort, der traditionelle Thai-Gerichte anbietet.\n\nGeöffnet von Ostern bis Weihnachten\nSommersaison: Mittwoch geschlossen\nWintersaison: Montag bis Mittwoch geschlossen\n\nWir können Gruppen von mehr als 10 Personen aufnehmen (unbegrenzt nach vorheriger Reservierung).\nWir bieten auch einen Veranstaltungsservice an (private oder öffentliche Veranstaltungen)."
        ],
        "en": [
          "Food truck with fixed location, offering traditional Thai dishes.\n\nOpen from Easter to Christmas\nSummer season: closed Wednesday\nWinter season: closed Monday to Wednesday\n\nWe can accept groups of more than 10 people (unlimited upon reservation).\nWe also offer an events service (private or public events)."
        ],
        "it": [
          "Food truck con sede fissa, che offre piatti tradizionali thailandesi.\n\nAperto da Pasqua a Natale\nStagione estiva: chiuso il mercoledì\nStagione invernale: chiuso dal lunedì al mercoledì\n\nPossiamo accettare gruppi di oltre 10 persone (illimitati su prenotazione).\nOffriamo anche un servizio di eventi (privati o pubblici)."
        ],
        "fr": [
          "Food truck à emplacement fixe, proposant des plats traditionnels Thai.\n\nOuvert de pâques à Noël \nSaison estivale : fermeture mercredi\nSaison hivernale : fermeture du lundi au mercredi\n\nNous pouvons accepter des groupes de plus de 10 personnes (illimité sur réservation).\nNous proposons également un service événementiel (événement privé ou public)."
        ],
        "nl": [
          "Foodtruck met een vaste locatie, met traditionele Thaise gerechten.\n\nGeopend van Pasen tot Kerstmis\nZomerseizoen: woensdag gesloten\nWinterseizoen: maandag tot woensdag gesloten\n\nWe kunnen groepen van meer dan 10 personen ontvangen (onbeperkt op reservering).\nWe bieden ook een evenementenservice (privé- of openbare evenementen)."
        ],
        "es": [
          "Food truck con ubicación fija, que ofrece platos tradicionales tailandeses.\n\nAbierto de Semana Santa a Navidad\nTemporada de verano: cerrado los miércoles\nTemporada de invierno: cerrado de lunes a miércoles\n\nPodemos aceptar grupos de más de 10 personas (ilimitados previa reserva).\nTambién ofrecemos un servicio de eventos (privados o públicos)."
        ]
      },
