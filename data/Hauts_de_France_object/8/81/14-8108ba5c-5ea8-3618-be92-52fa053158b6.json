  "rdfs:comment": {
    "de": [
      "Mentir lo Mínimo, das an der Grenze zwischen zeitgenössischem Zirkus, Theater und Musik angesiedelt ist, lässt sich von der minimalistischen Strömung inspirieren und bietet dem Publikum eine intime und schlichte Kreation."
    ],
    "en": [
      "On the borderline between contemporary circus, theater and music, Mentir lo Mínimo is inspired by the minimalist movement, offering audiences an intimate, uncluttered creation."
    ],
    "it": [
      "Al confine tra circo contemporaneo, teatro e musica, Mentir lo Mínimo si ispira al movimento minimalista e offre al pubblico una performance intima e senza fronzoli."
    ],
    "fr": [
      "À la frontière entre cirque contemporain, théâtre et musique, Mentir lo Mínimo s’inspire du courant minimaliste et propose au public une création intime et épurée."
    ],
    "nl": [
      "Op de grens tussen hedendaags circus, theater en muziek is Mentir lo Mínimo geïnspireerd door de minimalistische beweging en biedt het publiek een intieme, opgeruimde voorstelling."
    ],
    "es": [
      "En la frontera entre el circo contemporáneo, el teatro y la música, Mentir lo Mínimo se inspira en el movimiento minimalista y ofrece al público un espectáculo íntimo y depurado."
    ]
  },
