  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b10cdc6-41e4-35fd-bf50-0fdb0db08e84",
      "dc:description": {
        "de": [
          "Führungen durch das Schulmuseum\nKehren Sie auf die Schulbank zurück und entdecken Sie bei einer immersiven Führung die Klassenzimmer von früher\nFreitags im Juli und August um 14:30 Uhr"
        ],
        "en": [
          "Guided tours of the School Museum\nTake a trip back to school to discover the classrooms of yesteryear on an immersive tour\nFridays in July and August at 2.30pm"
        ],
        "it": [
          "Visite guidate al Museo della Scuola\nUn viaggio a ritroso nella scuola per scoprire le aule di un tempo in una visita coinvolgente\nI venerdì di luglio e agosto alle 14.30"
        ],
        "fr": [
          "Visites guidées de l'Ecole Musée\nRevenez sur les bancs de l'école pour découvrir les classes d'Autrefois grâce à une visite immersive\nLes vendredis en Juillet et Août à 14h30"
        ],
        "es": [
          "Visitas guiadas al Museo Escolar\nVuelva a la escuela para descubrir las aulas de antaño en una visita inmersiva\nLos viernes de julio y agosto a las 14.30 h"
        ],
        "nl": [
          "Rondleidingen door het schoolmuseum\nGa terug naar school en ontdek de klaslokalen van vroeger tijdens een meeslepende rondleiding\nVrijdag in juli en augustus om 14.30 uur"
        ]
      },
      "@type": [
