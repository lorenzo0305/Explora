  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2837402e-408d-3efb-94cf-bbe0753a3852",
      "dc:description": {
        "de": [
          "Gesamtkapazität: 100 Personen.\n\nBierbar: Große Auswahl an Bieren, darunter 20 Fassbiere und 40 Flaschenbiere.\n\nArt der Musik: Rock, Metal.\nArt der Kundschaft: 20 bis 50 Jahre.\n\nTäglich von 16 Uhr bis 3 Uhr geöffnet"
        ],
        "en": [
          "Total capacity: 100 people.\n\nBeer bar: large selection of beers, including 20 draught and 40 bottled.\n\nType of music: rock, metal.\nClientele: 20 to 50 years old.\n\nOpen daily from 4pm to 3am"
        ],
        "it": [
          "Capacità totale: 100 persone.\n\nBeer bar: ampia scelta di birre, tra cui 20 alla spina e 40 in bottiglia.\n\nTipo di musica: rock, metal.\nClientela: dai 20 ai 50 anni.\n\nAperto tutti i giorni dalle 16.00 alle 3.00"
        ],
        "fr": [
          "Capacité totale : 100 personnes.\n\nBar à bières : grand choix de bières, dont 20 pressions et 40 en bouteille.\n\nType de musique : rock, métal.\nType de clientèle : 20 à 50 ans.\n\nOuvert tous les jours de 16h à 3h"
        ],
        "nl": [
          "Totale capaciteit: 100 personen.\n\nBierbar: ruime keuze aan bieren, waaronder 20 tapbieren en 40 flessenbieren.\n\nSoort muziek: rock, metal.\nKlantenkring: 20 tot 50 jaar oud.\n\nElke dag geopend van 16.00 tot 3.00 uur"
        ],
        "es": [
          "Capacidad total: 100 personas.\n\nCervecería: amplia selección de cervezas, 20 de barril y 40 embotelladas.\n\nTipo de música: rock, metal.\nClientela: de 20 a 50 años.\n\nAbierto todos los días de 16.00 a 3.00"
        ]
      },
