      "@id": "https://data.datatourisme.fr/66bce8f0-8b18-3adb-9bf4-90224f17b63d",
      "dc:description": {
        "de": [
          "Zum 25. Geburtstag Jubiläumskonzert der Porteloiser Wämser mit den Stimmen opale lokale Gruppe Portelois Samstag, 29. November um 18.30 Uhr\nkostenloses Konzert\nsalle philippe noiret"
        ],
        "en": [
          "To mark the 25th anniversary of Les vareuses porteloises anniversary concert with local group Les voix opale Saturday, November 29 at 6:30 p.m\nfree concert\nsalle philippe noiret"
        ],
        "it": [
          "In occasione del 25° anniversario delle Vareuses Portelois, un concerto di anniversario con il gruppo locale Les Voix Opale sabato 29 novembre alle 18.30\nconcerto gratuito\nsala philippe noiret"
        ],
        "fr": [
          "Pour les 25 ans concert anniversaire des vareuses porteloises avec les voix opale groupe local Portelois samedi 29 novembre à 18h30 \nconcert gratuit \nsalle philippe noiret"
        ],
        "nl": [
          "Ter gelegenheid van het 25-jarig bestaan van de Portelois Vareuses, een jubileumconcert met de lokale groep Les Voix Opale zaterdag 29 november om 18.30 uur\ngratis concert\nsalon philippe noiret"
        ],
        "es": [
          "Con motivo del 25 aniversario de las Vareuses de Portelois, concierto de aniversario con el grupo local Les Voix Opale Sábado 29 de noviembre a las 18.30 h\nconcierto gratuito\nsala philippe noiret"
        ]
      },
