  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/859566d9-c261-317a-ad8c-642ba34de686",
      "dc:description": {
        "de": [
          "Neapolitanische ambulante Pizzeria auf Holzfeuer, frische und lokale Produkte.\n\nDie Pizzeria hält an verschiedenen Orten, z. B.: Montreuil - Étaples - Bréxent-Énocq - Rang-du-Fliers - Neuville-sous-Montreuil - Frencq"
        ],
        "en": [
          "Neapolitan wood-fired pizzeria, fresh local produce.\n\nThe pizzeria stops at several locations: Montreuil - Étaples - Bréxent-Énocq - Rang-du-Fliers - Neuville-sous-Montreuil - Frencq"
        ],
        "it": [
          "Pizzeria napoletana a legna con prodotti freschi locali.\n\nLa pizzeria si ferma in diverse località tra cui: Montreuil - Étaples - Bréxent-Énocq - Rang-du-Fliers - Neuville-sous-Montreuil - Frencq"
        ],
        "fr": [
          "Pizzeria napolitaine ambulante au feu de bois, produits frais et locaux.\n\nLa pizzeria s'arrête à plusieurs endroits tels que : Montreuil · Étaples · Bréxent-Énocq · Rang-du-Fliers · Neuville-sous-Montreuil · Frencq"
        ],
        "es": [
          "Pizzería napolitana de leña con productos locales frescos.\n\nLa pizzería se detiene en varios lugares, entre ellos: Montreuil - Étaples - Bréxent-Énocq - Rang-du-Fliers - Neuville-sous-Montreuil - Frencq"
        ],
        "nl": [
          "Napolitaanse houtgestookte pizzeria met verse lokale producten.\n\nDe pizzeria stopt op verschillende locaties, waaronder: Montreuil - Étaples - Bréxent-Énocq - Rang-du-Fliers - Neuville-sous-Montreuil - Frencq"
        ]
      },
