  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b20ea8dd-6b8f-3c41-a685-1982e2e3fb69",
      "dc:description": {
        "de": [
          "Eine Pizzeria mit italienischer Tradition in der Unterstadt von Laon, mit traditionellen Pizzen, die vor den Augen der Kunden mit hochwertigen Produkten hausgemacht werden.\nMan kann mittags oder abends auf der Terrasse mit einem umzäunten Garten in der Sommersaison oder im Speisesaal essen"
        ],
        "en": [
          "A traditional Italian pizzeria located in the lower town of Laon, with traditional pizzas made in front of the customer with quality products.\nYou can lunch or dine on the terrace with its enclosed garden in summer, or in the dining room"
        ],
        "it": [
          "Una tradizionale pizzeria italiana situata nella città bassa di Laon, che offre pizze tradizionali preparate davanti al cliente con prodotti di qualità.\nÈ possibile pranzare o cenare sulla terrazza con giardino recintato in estate, oppure nella sala ristorante"
        ],
        "fr": [
          "Une pizzeria de tradition italienne située en ville basse de Laon, avec des pizzas traditionnelles faites maison devant le client avec des produits de qualités.\nOn peut déjeuner ou diner en terrasse avec un jardin clos en saison estivale ou en salle de restaurant"
        ],
        "es": [
          "Pizzería tradicional italiana situada en la parte baja de la ciudad de Laon, que ofrece pizzas tradicionales elaboradas delante del cliente con productos de calidad.\nPuede comer o cenar en la terraza con jardín cerrado en verano, o en la sala del restaurante"
        ],
        "nl": [
          "Een traditionele Italiaanse pizzeria in de benedenstad van Laon, met traditionele pizza's die in het bijzijn van de klant worden gemaakt met kwaliteitsproducten.\nJe kunt lunchen of dineren op het terras met omheinde tuin in de zomer, of in de restaurantzaal"
        ]
      },
      "@type": [
        "Description"
      ],
