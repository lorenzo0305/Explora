  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f245b8d3-2f90-37bf-accb-ecbc8debb6cc",
      "dc:description": {
        "de": [
          "Das TRIBU ist ein Restaurant mit einer vibrierenden und gleichzeitig entspannten Atmosphäre, das den Geist des Reisens verkörpert.\n\nGenießen Sie eine einfallsreiche Küche mit Einflüssen aus aller Welt, die Sie auf eine kulinarische Reise mitnimmt, die von der Inspiration des Küchenchefs bestimmt wird."
        ],
        "en": [
          "Experience a vibrant yet relaxed atmosphere at TRIBU, a restaurant that embodies the spirit of travel.\n\nSavor inventive, world-influenced cuisine that will take you on a culinary experience inspired by the Chef."
        ],
        "it": [
          "Provate l'atmosfera vibrante e rilassata del TRIBU, un ristorante che incarna lo spirito del viaggio.\n\nAssaporate una cucina inventiva con influenze globali che vi porterà in un'esperienza culinaria ispirata dallo Chef."
        ],
        "fr": [
          "Retrouvez une ambiance à la fois vibrante et décontractée à TRIBU, un restaurant incarnant à merveille l’esprit du voyage. \n\nSavourez une cuisine inventive, aux influences du monde qui vous emportera pour une expérience culinaire selon l’inspiration du Chef."
        ],
        "nl": [
          "Ervaar een levendige maar ontspannen sfeer in TRIBU, een restaurant dat de reisgeest belichaamt.\n\nGeniet van de inventieve keuken met wereldwijde invloeden die je meeneemt op een culinaire ervaring geïnspireerd door de chef-kok."
        ],
        "es": [
          "Disfrute de un ambiente vibrante y relajado en TRIBU, un restaurante que personifica el espíritu viajero.\n\nSaboree una cocina inventiva con influencias globales que le llevará a una experiencia culinaria inspirada por el Chef."
        ]
      },
      "@type": [
        "Description"
