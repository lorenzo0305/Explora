  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4fdad213-dab7-3ae5-bc64-b8bff4b38180",
      "dc:description": {
        "de": [
          "Es ist Roberts erster Arbeitstag in der Mine als Maschinist! Wie fühlt er sich? Hat er Angst? Hat er es eilig? Ist er glücklich?  Erleben Sie den Tag eines Bergarbeiters auf dieser spielerischen Tour rund um die Emotionen."
        ],
        "en": [
          "It's Robert's first day at the mine as a machinist! How does he feel? Is he scared? In a hurry? Happy?  Relive the day of a miner through this playful tour of emotions."
        ],
        "it": [
          "È il primo giorno di lavoro di Robert in miniera come macchinista! Come si sente? Ha paura? Ha fretta? È felice?  Rivivete la giornata di un minatore in questo divertente tour basato sulle emozioni."
        ],
        "fr": [
          "C’est le premier jour de travail de Robert à la mine en tant que machiniste ! Comment se sent-il ? A-t-il peur ? Est-il pressé ? Heureux ?  Revivez la journée d’un mineur à travers cette visite ludique autour des émotions."
        ],
        "nl": [
          "Robert werkt voor het eerst in de mijn als machinist! Hoe voelt hij zich? Is hij bang? Heeft hij haast? Blij?  Beleef de dag van een mijnwerker opnieuw tijdens deze leuke rondleiding gebaseerd op emoties."
        ],
        "es": [
          "Es el primer día de trabajo de Robert en la mina como maquinista ¿Cómo se siente? ¿Tiene miedo? ¿Tiene prisa? ¿Está contento?  Revive el día de un minero en este divertido recorrido basado en las emociones."
        ]
      },
      "@type": [
        "Description"
