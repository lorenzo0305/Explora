  "rdfs:comment": {
    "de": [
      "Er befindet sich am Ende der Rue du Calvaire, in der Nähe der Chaussée Brunehaut. Der heutige Christus steht an der Stelle, an der 1746 ein erster Christus stand."
    ],
    "en": [
      "It is located at the end of rue du Calvaire, near the Chaussée Brunehaut. The present Christ occupies the place occupied by a 1st Christ in 1746."
    ],
    "it": [
      "Si trova alla fine della rue du Calvaire, vicino alla Chaussée Brunehaut. Il Cristo attuale occupa il posto occupato da un primo Cristo nel 1746."
    ],
    "fr": [
      "Il est situé au bout de la rue du Calvaire, près de la Chaussée Brunehaut. Le Christ actuel occupe la place qu’occupa un 1er Christ en 1746."
    ],
    "es": [
      "Se encuentra al final de la rue du Calvaire, cerca de la Chaussée Brunehaut. El Cristo actual ocupa el lugar que ocupaba un 1er Cristo en 1746."
    ],
    "nl": [
      "Het bevindt zich aan het einde van de rue du Calvaire, vlakbij de Chaussée Brunehaut. De huidige Christus neemt de plaats in die een 1e Christus in 1746 innam."
    ]
  },
  "rdfs:label": {
