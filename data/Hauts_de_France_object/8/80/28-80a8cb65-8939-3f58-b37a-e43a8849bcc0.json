  "rdfs:comment": {
    "de": [
      "Der Cirque Municipal wurde 1889 von Jules Verne eingeweiht und ist ein wichtiger Ort des kulturellen Lebens in Amién und ein bewundernswerter Anfang der Architektur des neuen Jahrhunderts (des 20. Jahrhunderts!), die Stein, Glas und Eisen miteinander verbindet!"
    ],
    "en": [
      "Inaugurated by Jules Verne in 1889, the Cirque municipal is a high place of Amiens' cultural life, and an admirable start of the architecture of the new century (the 20th!) combining stone, glass and iron!"
    ],
    "it": [
      "Inaugurato da Jules Verne nel 1889, il Circo Municipale è un punto culminante della vita culturale di Amiens e un mirabile inizio dell'architettura del nuovo secolo (il XX!) che unisce pietra, vetro e ferro!"
    ],
    "fr": [
      "Inauguré par Jules Verne en 1889, le Cirque municipal est un haut lieu de la vie Culturelle Amiénoise, et une admirable amorce de l'architecture du nouveau siècle (le XXe !) alliant le la pierre, le verre et le fer !"
    ],
    "es": [
      "Inaugurado por Julio Verne en 1889, el Circo Municipal es un punto álgido en la vida cultural de Amiens, y un admirable comienzo de la arquitectura del nuevo siglo (¡el XX!) que combina piedra, cristal y hierro"
    ],
    "nl": [
      "Het door Jules Verne in 1889 ingehuldigd Gemeentelijk Circus is een hoogtepunt in het culturele leven van Amiens, en een bewonderenswaardig begin van de architectuur van de nieuwe eeuw (de 20e!) met een combinatie van steen, glas en ijzer!"
    ]
  },
