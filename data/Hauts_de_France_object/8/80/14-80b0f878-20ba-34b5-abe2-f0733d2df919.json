  "rdfs:comment": {
    "de": [
      "Das Zentrum Pays d'art et d'histoire de Lens-Liévin lädt Sie zu einem entdeckungsreichen Spaziergang im Herzen des Parks an den Ufern der Souchez ein."
    ],
    "en": [
      "The Pays d?art et d?histoire de Lens-Liévin (Lens-Liévin Art and History Centre) invites you on a heritage walk through the park on the banks of the Souchez river."
    ],
    "it": [
      "Il centro Pays d'art et d'histoire di Lens-Liévin vi propone una passeggiata nel patrimonio ricca di scoperte nel cuore del parco, sulle rive del Souchez."
    ],
    "fr": [
      "Le pôle Pays d’art et d’histoire de Lens-Liévin vous propose une promenade patrimoniale riche en découvertes au cœur du parc des berges de la Souchez."
    ],
    "nl": [
      "Lens-Liévin's Pays d'art et d'histoire centrum biedt je een erfgoedwandeling vol ontdekkingen in het hart van het park aan de oevers van de Souchez."
    ],
    "es": [
      "El centro Pays d'art et d'histoire de Lens-Liévin le propone un paseo patrimonial lleno de descubrimientos en pleno corazón del parque, a orillas del Souchez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rando-visite Berges de la Souchez"
    ]
  },
