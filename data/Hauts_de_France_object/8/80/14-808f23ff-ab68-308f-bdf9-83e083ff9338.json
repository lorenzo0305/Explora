  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/829c7b0a-f2f7-36b8-a384-962451f1332c",
      "dc:description": {
        "de": [
          "Montag, 11. August, 20:30 Uhr - Klassisches Akkordeon- und Cellokonzert des Ensemble Improvisation, organisiert von Eric und Natalie Blin in der Kirche Notre Dame des sables - Auf dem Programm stehen Werke von Caccini, Vivaldi, Bach, ? - Freier Eintritt (Kostenbeteiligung erwünscht)"
        ],
        "en": [
          "Monday August 11 at 8:30pm - Classical accordion and cello concert by Ensemble Improvisation organized by Eric and Natalie Blin in the church of Notre Dame des sables - On the program ?works by Caccini, Vivaldi, Bach, ? - Free admission (please contribute to costs)"
        ],
        "it": [
          "Lunedì 11 agosto alle 20.30 - Concerto di fisarmonica classica e violoncello dell'Ensemble Improvisation organizzato da Eric e Natalie Blin nella chiesa di Notre Dame des sables - In programma: opere di Caccini, Vivaldi, Bach, ? - Ingresso libero (con contributo alle spese)"
        ],
        "fr": [
          "Lundi 11 août à 20h30 - Concert accordéon classique et violoncelle de l’Ensemble Improvisation organisé par Eric et Natalie Blin en l'église Notre Dame des sables - Au programme œuvres de Caccini, Vivaldi, Bach, … - Entrée libre (participation aux frais souhaitée)"
        ],
        "nl": [
          "Maandag 11 augustus om 20u30 - Klassiek accordeon- en celloconcert door Ensemble Improvisation georganiseerd door Eric en Natalie Blin in de kerk Notre Dame des sables - Op het programma: werken van Caccini, Vivaldi, Bach, ? - Gratis toegang (met een bijdrage voor de onkosten)"
        ],
        "es": [
          "Lunes 11 de agosto a las 20:30 h - Concierto clásico de acordeón y violonchelo del Ensemble Improvisation organizado por Eric y Natalie Blin en la iglesia de Notre Dame des sables - En el programa: obras de Caccini, Vivaldi, Bach, ? - Entrada gratuita (con contribución a los gastos)"
        ]
      },
