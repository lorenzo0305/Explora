  "rdfs:comment": {
    "de": [
      "Der Schwerpunkt des Espace Tourville in Gravelines liegt auf dem Bau der Jean Bart in Originalgröße, einem erstklassigen Schiff aus dem 17. Jahrhundert (57 m lang, 12 bis 17 m hoch, 6 m Tiefgang). In seinem Handwerkerdorf am Rande des historischen Hafens von Gravelines wird das Schiff von der Vereinigung nach denselben Methoden und mit denselben Materialien wie früher gebaut."
    ],
    "en": [
      "The Espace Tourville in Gravelines focuses on the full-scale construction of the Jean Bart, a 17th-century ship of the first rank (57 m long, 12 to 17 m high, 6 m draught). The ship, built by the Association using the same methods and materials as in the past, is housed in its craft village on the edge of the historic port of Gravelines."
    ],
    "it": [
      "L'Espace Tourville di Gravelines si concentra sulla costruzione in scala reale della Jean Bart, una nave del XVII secolo di primo rango (57 m di lunghezza, 12-17 m di altezza, 6 m di pescaggio). Nel suo villaggio artigianale ai margini del porto storico di Gravelines, la nave viene costruita dall'Associazione utilizzando gli stessi metodi e materiali del passato."
    ],
    "fr": [
      "L’Espace Tourville situé à Gravelines a pour centre d’intérêt la construction, à taille réelle, du Jean Bart, un vaisseau de premier rang du 17ème siècle (57 m de long, 12 à 17 m de haut, 6 m de tirant d’eau). Au sein de son village artisanal implanté en bordure du port historique de Gravelines, le navire, construit par l’Association en respectant les méthodes et les mêmes matériaux qu’autrefois."
    ],
    "es": [
      "El Espace Tourville de Gravelines se centra en la construcción a escala real del Jean Bart, un navío de primer rango del siglo XVII (57 m de eslora, 12 a 17 m de altura, 6 m de calado). En su villa artesanal, a orillas del puerto histórico de Gravelines, el barco es construido por la Asociación con los mismos métodos y materiales que antaño."
    ],
    "nl": [
      "De Espace Tourville in Gravelines richt zich op de bouw op ware grootte van de Jean Bart, een 17e-eeuws schip van de eerste rang (57 m lang, 12 tot 17 m hoog, 6 m diepgang). In het ambachtsdorp aan de rand van de historische haven van Gravelines wordt het schip door de vereniging gebouwd met dezelfde methoden en materialen als vroeger."
    ]
  },
