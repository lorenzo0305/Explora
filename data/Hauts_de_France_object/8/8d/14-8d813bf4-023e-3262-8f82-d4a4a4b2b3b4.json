      "dc:description": {
        "de": [
          "Die Stadtverwaltung und der Verein \"Les Amis d'Ambricourt\" laden Sie zum Ducasse-Essen ein\nTreffpunkt am Sonntag, den 29. Juni ab 12.00 Uhr"
        ],
        "en": [
          "The Municipality and the Association les \"Amis d'Ambricourt\" invite you to the ducasse meal\nSunday June 29 from 12:00 pm"
        ],
        "it": [
          "Il Comune e l'Associazione \"Les Amis d'Ambricourt\" vi invitano alla cena della ducassa\nDomenica 29 giugno dalle ore 12.00"
        ],
        "fr": [
          "La Municipalité et l'Association les \"Amis d'Ambricourt\" vous invitent au repas de la ducasse\nRendez-vous le dimanche 29 juin à partir de 12h00"
        ],
        "nl": [
          "Het gemeentebestuur en de vereniging \"Les Amis d'Ambricourt\" nodigen u uit voor het ducassediner\nZondag 29 juni vanaf 12.00 uur"
        ],
        "es": [
          "El Ayuntamiento y la Asociación \"Les Amis d'Ambricourt\" le invitan a la cena ducasse\nDomingo 29 de junio a partir de las 12.00 horas"
        ]
      },
