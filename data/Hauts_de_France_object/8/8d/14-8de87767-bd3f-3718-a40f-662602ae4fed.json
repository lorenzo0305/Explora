      "@id": "https://data.datatourisme.fr/f1df464e-b1ca-3e99-8447-025bd154c64e",
      "dc:description": {
        "de": [
          "Traditionelle Brasserie, gemütliche Atmosphäre und Dekoration, Muschelspezialität in Sauce, regionale Produkte, hausgemachte Pommes frites und Sirup (Veilchen, Kastanie, Klatschmohn,...)"
        ],
        "en": [
          "Traditional brewery, warm atmosphere and decor, speciality of mussels in sauce, regional products, home fries and syrups (violet, chestnut, poppy,...)"
        ],
        "it": [
          "Brasserie tradizionale, atmosfera e arredamento caldi, specialità di cozze in salsa, prodotti regionali, patatine fritte e sciroppi fatti in casa (violetta, castagna, papavero,...)"
        ],
        "fr": [
          "Brasserie traditionnelle, ambiance et décors chaleureux, spécialité de moules en sauce, produits régionaux, frites maison et sirops (violette, châtaigne, coquelicot,...)"
        ],
        "nl": [
          "Traditionele brasserie, warme sfeer en decor, specialiteit van mosselen in saus, regionale producten, huisgemaakte frieten en siropen (viooltje, kastanje, klaproos,...)"
        ],
        "es": [
          "Brasserie tradicional, ambiente y decoración cálidos, especialidad en mejillones en salsa, productos regionales, patatas fritas caseras y jarabes (violeta, castaña, amapola,...)"
        ]
      },
