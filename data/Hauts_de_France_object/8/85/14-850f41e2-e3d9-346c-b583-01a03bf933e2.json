  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f9c67d8b-f39f-3948-b88c-5af540d59e0f",
      "dc:description": {
        "de": [
          "Umfrage-Besuch \"CI-GIT A BOULOGNE\"\n\nErmitteln Sie ein mysteriöses Grab, bevor Sie es auf dem ältesten Friedhof der Stadt, dem Ostfriedhof, finden und sich von anderen Gräbern erzählen lassen\n\nDauer: 2 Stunden\n\nAchtung: ab 12 Jahren"
        ],
        "en": [
          "CI-GIT A BOULOGNE\" visit-survey\n\nIdentify a mystery grave by investigating, before finding it in the cemetery de l'Est, the city?s oldest, and hearing about other graves\n\nDuration: 2 hours\n\nWarning: from 12 years of age"
        ],
        "it": [
          "Sondaggio tra i visitatori \"CI-GIT A BOULOGNE\n\nIdentificare una tomba misteriosa indagando, prima di trovarla nel cimitero dell'Est, il più antico della città, e lasciarsi raccontare le altre tombe\n\nDurata: 2 ore\n\nAttenzione: a partire da 12 anni"
        ],
        "fr": [
          "Enquête-Visite « CI-GIT A BOULOGNE »\n\nIdentifiez une sépulture mystère en menant l’enquête, avant de la retrouver au cimetière de l’Est, le plus ancien de la ville, et de vous laisser conter d’autres tombes\n\nDurée : 2h\n\nAttention : à partir de 12 ans"
        ],
        "es": [
          "Encuesta a los visitantes \"CI-GIT A BOULOGNE\n\nIdentifique una tumba misteriosa investigando, antes de encontrarla en el cementerio del Este, el más antiguo de la ciudad, y déjese hablar de otras tumbas\n\nDuración: 2 horas\n\nAdvertencia: a partir de 12 años"
        ],
        "nl": [
          "Bezoekersenquête \"CI-GIT A BOULOGNE\n\nIdentificeer een mysterieus graf door het te onderzoeken, voordat je het vindt op de begraafplaats van het Oosten, de oudste van de stad, en laat je vertellen over andere graven\n\nDuur: 2 uur\n\nWaarschuwing: vanaf 12 jaar"
        ]
      },
