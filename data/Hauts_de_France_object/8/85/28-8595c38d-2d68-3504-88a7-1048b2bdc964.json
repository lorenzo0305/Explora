  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/45dc55be-176d-36ed-a02b-a4bed7eb13e5",
      "dc:description": {
        "de": [
          "In diesem Monat läuft der Film \"Ernest und Celestine im Winter\" (von Julien Chheng und Jean-Christophe Roger, 2017) im Kino!\n\nEine Veranstaltung der Communauté de Communes du Chemin des Dames in Zusammenarbeit mit CinéPop?\n\nTreffpunkt im Pavillon von Vauclair um 15:30 Uhr! (Dauer: ~ 0h45 / mit Reservierung / für alle Altersgruppen)"
        ],
        "en": [
          "This month, the film \"Ernest et Célestine en hiver\" (by Julien Chheng and Jean-Christophe Roger, 2017) is showing!\n\nPresented by the Communauté de Communes du Chemin des Dames in collaboration with CinéPop?\n\nRV at Pavillon de Vauclair at 3:30pm! (duration: ~ 0h45 / booking required / all audiences)"
        ],
        "it": [
          "Questo mese viene proiettato il film \"Ernest et Célestine en hiver\" (di Julien Chheng e Jean-Christophe Roger, 2017)!\n\nUna proiezione organizzata dalla Communauté de Communes du Chemin des Dames in associazione con CinéPop?\n\nCi vediamo al Pavillon de Vauclair alle 15.30! (durata: ~ 0h45 / prenotazione obbligatoria / aperta a tutti)"
        ],
        "fr": [
          "Ce mois-ci, retrouvez à l’affiche le film \"Ernest et Célestine en hiver\" (de Julien Chheng et Jean-Christophe Roger, 2017) !\n\nUne séance proposée par la Communauté de Communes du Chemin des Dames en collaboration avec CinéPop…\n\nRV au Pavillon de Vauclair à 15h30 ! (durée : ~ 0h45 / sur réservation / tout public)"
        ],
        "es": [
          "Este mes se proyecta la película \"Ernest et Célestine en hiver\" (de Julien Chheng y Jean-Christophe Roger, 2017)\n\nProyección organizada por la Communauté de Communes du Chemin des Dames en asociación con CinéPop?\n\nNos vemos en el Pavillon de Vauclair a las 15:30 (duración: ~ 0h45 / reserva obligatoria / abierto a todos)"
        ],
        "nl": [
          "Deze maand draait de film \"Ernest et Célestine en hiver\" (van Julien Chheng en Jean-Christophe Roger, 2017)!\n\nEen voorstelling georganiseerd door de Communauté de Communes du Chemin des Dames in samenwerking met CinéPop?\n\nTot ziens in het Pavillon de Vauclair om 15u30! (duur: ~ 0u45 / reserveren verplicht / open voor iedereen)"
        ]
      },
      "@type": [
        "Description"
      ],
