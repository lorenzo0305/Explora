  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dcd71855-b193-3af4-98a5-2ef4eb5de3a0",
      "dc:description": {
        "de": [
          "Claire bietet Ihnen Besuche der Bauernhoftiere und Animationen auf ihrem pädagogischen Bauernhof an, vom Huhn zum Küken und vom Weizen zum Brot. Nur für Gruppen nach Vereinbarung."
        ],
        "en": [
          "Claire offers tours of the farm's animals and activities on her educational farm, from hens to chicks and from wheat to bread. Groups by appointment only."
        ],
        "it": [
          "Claire offre visite agli animali della fattoria e attività nella sua fattoria didattica, dalle galline ai pulcini e dal grano al pane. Solo su appuntamento per i gruppi."
        ],
        "fr": [
          "Claire vous propose des visites des animaux de la ferme et animations dans sa ferme pédagogique, de la poule au poussin et du blé au pain. Uniquement pour les groupes sur rendez-vous."
        ],
        "es": [
          "Claire ofrece visitas a los animales de la granja y actividades en su granja educativa, desde gallinas a pollitos y desde trigo a pan. Solo con cita previa para grupos."
        ],
        "nl": [
          "Claire biedt bezoeken aan de boerderijdieren en activiteiten op haar educatieve boerderij, van kippen tot kuikens en van tarwe tot brood. Alleen op afspraak voor groepen."
        ]
      },
      "@type": [
        "Description"
