  "rdfs:comment": {
    "de": [
      "Das Le Scoop ist ein traditionelles französisches Restaurant. Hier wird Ihnen eine aus frischen und saisonalen Produkten zubereitete Küche in einer gemütlichen Atmosphäre angeboten.\n "
    ],
    "en": [
      "Le Scoop is a traditional French restaurant. Fresh, seasonal produce is the basis of its cuisine, which is served in a friendly atmosphere.\n "
    ],
    "it": [
      "Le Scoop è un ristorante francese tradizionale. Vi verranno serviti prodotti freschi e di stagione in un'atmosfera accogliente.\n "
    ],
    "fr": [
      "Le Scoop est un restaurant traditionnel français. Une cuisine élaborée à partir de produits frais et de saison vous y est proposée dans une ambiance conviviale.\n "
    ],
    "nl": [
      "Le Scoop is een traditioneel Frans restaurant. Je krijgt er verse, seizoensgebonden producten geserveerd in een vriendelijke sfeer.\n "
    ],
    "es": [
      "Le Scoop es un restaurante tradicional francés. Le servirán productos frescos de temporada en un ambiente acogedor.\n "
    ]
  },
