  "rdfs:comment": {
    "de": [
      "Le Vent de Bise ist ein Restaurant mit überschaubarer Größe, in dem behinderte Arbeitnehmer und Restaurantfachleute ihre Kompetenzen vereinen, um Ihnen Qualitätsprodukte von lokalen Erzeugern anzubieten."
    ],
    "en": [
      "Le Vent de Bise is a restaurant on a human scale where disabled workers and restaurant professionals combine their skills to offer you quality products from local producers."
    ],
    "it": [
      "Le Vent de Bise è un ristorante a misura d'uomo dove lavoratori disabili e professionisti della ristorazione uniscono le loro competenze per offrirvi prodotti di qualità provenienti da produttori locali."
    ],
    "fr": [
      "Le Vent de Bise est un restaurant à taille humaine où travailleurs handicapés et professionnels de la restauration associent leurs compétences pour vous proposer des produits de qualité, issus de producteurs locaux."
    ],
    "nl": [
      "Le Vent de Bise is een restaurant op mensenmaat waar gehandicapte werknemers en horecaprofessionals hun vaardigheden combineren om u kwaliteitsproducten van lokale producenten aan te bieden."
    ],
    "es": [
      "Le Vent de Bise es un restaurante a escala humana donde trabajadores discapacitados y profesionales de la restauración combinan sus habilidades para ofrecerle productos de calidad procedentes de productores locales."
    ]
  },
