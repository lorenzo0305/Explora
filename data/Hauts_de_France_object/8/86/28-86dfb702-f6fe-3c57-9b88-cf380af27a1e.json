      "@id": "https://data.datatourisme.fr/532b369e-c972-3c01-acfb-959e54c4eb53",
      "dc:description": {
        "de": [
          "Austernbar, frische Fruchtsäfte, Cocktails, Jazzkonzerte dienstags und donnerstags, ruhig, Terrasse mit schönem Panorama\nKundschaft: 30 bis 40 Jahre\nArt der Musik: Jazz und klassische Musik\n\n "
        ],
        "en": [
          "Oyster bar, fresh fruit juices, cocktails, jazz concerts on Tuesdays and Thursdays, quiet, terrace with beautiful panorama\nClientele: 30 to 40 years old\nType of music: jazz and classical\n\n "
        ],
        "it": [
          "Oyster bar, succhi di frutta freschi, cocktail, concerti jazz il martedì e il giovedì, tranquillo, terrazza con splendida vista\nTipo di clientela: 30-40 anni\nTipo di musica: jazz e classica\n\n "
        ],
        "fr": [
          "Bar à huîtres, jus de fruits frais, cocktails, concerts de jazz les Mardi et Jeudi, calme, terrasse avec beau panorama\nType de clientèle : de 30 à 40 ans \nType de musique: jazz et musique classique\n\n "
        ],
        "nl": [
          "Oesterbar, verse vruchtensappen, cocktails, jazzconcerten op dinsdag en donderdag, rustig, terras met prachtig uitzicht\nType klanten: 30 tot 40 jaar oud\nSoort muziek: jazz en klassiek\n\n "
        ],
        "es": [
          "Bar de ostras, zumos de fruta fresca, cócteles, conciertos de jazz los martes y jueves, tranquilo, terraza con bonitas vistas\nTipo de clientela: de 30 a 40 años\nTipo de música: jazz y clásica\n\n "
        ]
      },
