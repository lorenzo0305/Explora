  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/006bfd16-63e0-3568-b745-0fd58d42c59a",
      "dc:description": {
        "de": [
          "Die Wellness-Sitzungen\nAp(art)té\nGehen Sie ins Museum, um sich Zeit zu nehmen und die ungewöhnliche Begegnung zwischen einem Kunstwerk und einer geführten Meditation der fünf Sinne zu erleben.\nBringen Sie einen Teppich und eine Decke mit.\n? Donnerstag, 5. September um 18:00 Uhr\nKostenlos - Reservierung empfohlen"
        ],
        "en": [
          "Wellness sessions\nAp(art)té\nGo to the museum to take your time and experience the unusual encounter between a work of art and a guided meditation of the 5 senses.\nBring a mat and a blanket.\n? Thursday, September 5, 6:00 pm\nFree - Reservations recommended"
        ],
        "it": [
          "Sessioni di benessere\nAp(art)té\nAndate al museo per prendervi il vostro tempo e sperimentare l'insolito incontro tra un'opera d'arte e una meditazione guidata dei 5 sensi.\nPortate un tappetino e una coperta.\n? Giovedì 5 settembre alle 18.00\nGratuito - Si consiglia la prenotazione"
        ],
        "fr": [
          "Les séances bien-être\nAp(art)té\nAller au musée pour prendre le temps et expérimenter au sein du musée la rencontre insolite d’une œuvre d’art et d’une méditation guidée des 5 sens. \nSe munir d’un tapis et d’un plaid.\n→ Jeudi 5 septembre à 18h00\nGratuit - Réservation conseillée"
        ],
        "nl": [
          "Welzijnssessies\nAp(art)té\nGa naar het museum om de tijd te nemen en ervaar de ongewone ontmoeting tussen een kunstwerk en een geleide meditatie van de 5 zintuigen.\nNeem een matje en een deken mee.\n? Donderdag 5 september om 18.00 uur\nGratis - Reserveren aanbevolen"
        ],
        "es": [
          "Sesiones de bienestar\nAp(art)té\nAcuda al museo para tomarse su tiempo y experimentar el encuentro insólito entre una obra de arte y una meditación guiada de los 5 sentidos.\nTraiga una esterilla y una manta.\n? Jueves 5 de septiembre a las 18.00 h\nGratuito - Se recomienda reservar"
        ]
      },
