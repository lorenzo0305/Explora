  "rdfs:comment": {
    "de": [
      "Saisonale Küche aus frischen Produkten, unsere kurze Karte garantiert einwandfreie Frische, wir bieten Ihnen auch (vor Ort, aber auch zum Mitnehmen) eine Karte mit hausgemachten Hamburgern."
    ],
    "en": [
      "Seasonal cuisine made from fresh products, our short menu guarantees impeccable freshness, we also offer (on site but also to take away) a menu of homemade burgers."
    ],
    "it": [
      "Cucina stagionale a base di prodotti freschi, il nostro menu breve garantisce una freschezza impeccabile. Offriamo anche un menu di hamburger fatti in casa (sul posto o da asporto)."
    ],
    "fr": [
      "Cuisine de saison élaborée à partir de produits frais, notre carte courte garantit une fraîcheur irréprochable, nous vous proposons également (sur place mais aussi à emporter) une carte d'Hamburgers tout maison."
    ],
    "nl": [
      "Seizoensgebonden gerechten op basis van verse producten, onze korte kaart garandeert een onberispelijke versheid. Wij bieden ook een menu van huisgemaakte hamburgers (ter plaatse of om mee te nemen)."
    ],
    "es": [
      "Cocina de temporada elaborada con productos frescos, nuestra breve carta garantiza una frescura impecable. También ofrecemos una carta de hamburguesas caseras (en el local o para llevar)."
    ]
  },
