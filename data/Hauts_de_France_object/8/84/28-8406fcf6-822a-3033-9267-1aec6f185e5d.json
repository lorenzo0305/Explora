  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fcfa6790-af08-3f48-b791-db6354b954ba",
      "dc:description": {
        "de": [
          "Das Sacha ist ein Restaurant, das die kulinarischen Spezialitäten der Region anbietet. Genauer gesagt hat das Team des Sacha eine typische Speisekarte des Nordens mit Rezepten aus saisonalen Produkten zusammengestellt. Verbringen Sie einen geselligen Moment in dem rustikal eingerichteten Restaurant."
        ],
        "en": [
          "Le Sacha is a restaurant-estaminet offering culinary specialties from the region. To be more precise, the Sacha team has created a typical Northern menu filled with recipes concocted with seasonal produce. Come and spend a convivial moment in their rustic restaurant."
        ],
        "it": [
          "Le Sacha è un ristorante-ristorante che offre specialità culinarie della regione. Per essere più precisi, il team del Sacha ha creato un menu tipico del Nord della Francia, ricco di ricette preparate con prodotti di stagione. Venite a trascorrere un momento di convivialità nel loro ristorante rustico."
        ],
        "fr": [
          "Le Sacha est un restaurant-estaminet qui propose les spécialités culinaires de la région. Plus exactement, l’équipe du Sacha a créé une carte typique du Nord remplie de recettes concoctée avec des produits de saison. Venez passer un moment convivial dans leur restaurant au cadre rustique."
        ],
        "nl": [
          "Le Sacha is een restaurant-estaminet met culinaire specialiteiten uit de regio. Om precies te zijn heeft het team van Sacha een menu samengesteld dat typisch is voor Noord-Frankrijk, vol recepten die zijn samengesteld met seizoensproducten. Kom een gezellig moment doorbrengen in hun rustieke restaurant."
        ],
        "es": [
          "Le Sacha es un restaurante-estaminería que ofrece especialidades culinarias de la región. Para ser más precisos, el equipo de Le Sacha ha creado una carta típica del norte de Francia, repleta de recetas elaboradas con productos de temporada. Venga a pasar un momento agradable en su restaurante rústico."
        ]
      },
      "@type": [
        "Description"
      ],
