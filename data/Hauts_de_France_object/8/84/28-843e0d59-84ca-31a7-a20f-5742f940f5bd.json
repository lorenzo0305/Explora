  "rdfs:comment": {
    "de": [
      "Der Picknickplatz von Canly liegt an der Voie Verte de la Plaine d'Estrées, ist schattig und mit Tischen, Mülleimern und einem Parkplatz in der Nähe ausgestattet."
    ],
    "en": [
      "Located on the Green Way of the Plaine d'Estrées, the picnic area of Canly is shaded and equipped with tables, bins and a car park nearby."
    ],
    "it": [
      "Situata sulla Voie Verte de la Plaine d'Estrées, l'area picnic di Canly è ombreggiata e attrezzata con tavoli, cestini e un parcheggio vicino."
    ],
    "fr": [
      "Située sur la Voie Verte de la Plaine d'Estrées, l'aire de pique-nique de Canly est ombragée et équipée de tables, poubelles et d'un parking à proximité."
    ],
    "es": [
      "Situada en la Voie Verte de la Plaine d'Estrées, la zona de picnic de Canly tiene sombra y está equipada con mesas, papeleras y un aparcamiento cercano."
    ],
    "nl": [
      "De picknickplaats Canly, gelegen aan de Voie Verte de la Plaine d'Estrées, is schaduwrijk en voorzien van tafels, vuilnisbakken en een nabijgelegen parkeerplaats."
    ]
  },
