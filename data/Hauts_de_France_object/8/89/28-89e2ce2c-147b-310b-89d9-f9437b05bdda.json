  "rdfs:comment": {
    "de": [
      "Willkommen im Petit Vieux in der Altstadt von Lille?\n\nEntdecken Sie Le Petit Vieux, unsere gemütliche Bar am Place..."
    ],
    "en": [
      "Welcome to Au Petit Vieux in Old Lille?\n\nDiscover Le Petit Vieux, our friendly bar on the Place..."
    ],
    "it": [
      "Benvenuti a Au Petit Vieux nella Vieux Lille?\n\nScoprite Le Petit Vieux, il nostro accogliente bar in Place..."
    ],
    "fr": [
      "Bienvenue Au Petit Vieux dans le Vieux Lille… \n\nDécouvrez le Petit Vieux, notre bar chaleureux Place..."
    ],
    "nl": [
      "Welkom bij Au Petit Vieux in Vieux Lille?\n\nOntdek Le Petit Vieux, onze gezellige bar op de Place..."
    ],
