  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3a68f721-9cdc-3f2a-81be-69187e8bf954",
      "dc:description": {
        "de": [
          "Gemischte Yogakurse in kleinen Gruppen, zugänglich und ganzjährig geöffnet.\nAb einem Alter von 14 Jahren.\n1,5-stündige Sitzung.\nDie Kurse bieten eine große Vielfalt an Körperhaltungen, Bewegungen und Atemübungen: Yoga, Yogatherapie, Entspannung, Klangentspannung, traditionelle Massagen."
        ],
        "en": [
          "Mixed yoga classes in small groups, open all year round.\nAges 14 and up.\n1h30 session.\nClasses offer a wide variety of postures, movements and breaths: yoga, yogatherapy, relaxation, sound relaxation, traditional massages."
        ],
        "it": [
          "Corsi di yoga misti in piccoli gruppi, aperti tutto l'anno.\nEtà minima 14 anni.\nSessione di 1h30.\nLe lezioni offrono un'ampia varietà di posture, movimenti e respirazione: yoga, yogaterapia, rilassamento, rilassamento sonoro, massaggio tradizionale."
        ],
        "fr": [
          "Cours de yoga mixte en petit groupe, accessible et ouvert toute l'année. \nA partir de 14 ans.\nSéance de 1h30. \nLes cours proposent une grande variété de postures, de mouvements et de respirations : yoga, yogatherapie,  relaxation,  relaxation sonore, massages traditionnels."
        ],
        "nl": [
          "Gemengde yogalessen in kleine groepen, het hele jaar geopend.\nMinimum leeftijd 14 jaar.\nSessie van 1u30.\nDe lessen bieden een grote verscheidenheid aan houdingen, bewegingen en ademhaling: yoga, yogatherapie, ontspanning, klankrelaxatie, traditionele massage."
        ],
        "es": [
          "Clases de yoga mixtas en grupos reducidos, abiertas todo el año.\nEdad mínima 14 años.\nSesión de 1h30.\nLas clases ofrecen una amplia variedad de posturas, movimientos y técnicas de respiración: yoga, yogaterapia, relajación, relajación sonora, masaje tradicional."
        ]
      },
      "@type": [
        "Description"
