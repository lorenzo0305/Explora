  "rdfs:comment": {
    "de": [
      "Das Napoli, seit 1973 eine kulinarische Institution in Calais, lädt Sie zu einer geschmacklichen Reise ins Herz Italiens ein. Das familiengeführte Restaurant liegt nur wenige Schritte von der Place d'Armes entfernt und wird Sie mit seiner herzlichen Atmosphäre und seiner authentischen Küche begeistern."
    ],
    "en": [
      "Le Napoli, a culinary institution in Calais since 1973, invites you on a gustatory journey to the heart of Italy. Just a stone's throw from the Place d'Armes, this family-run restaurant will win you over with its warm atmosphere and authentic cuisine."
    ],
    "it": [
      "Le Napoli, un'istituzione culinaria a Calais dal 1973, vi invita a un viaggio gastronomico nel cuore dell'Italia. A due passi da Place d'Armes, questo ristorante a conduzione familiare vi conquisterà con la sua calda atmosfera e la sua cucina autentica."
    ],
    "fr": [
      "Le Napoli, une institution culinaire à Calais depuis 1973, vous invite à un voyage gustatif au cœur de l'Italie. Situé à deux pas de la Place d'Armes, ce restaurant familial vous séduira par son ambiance chaleureuse et sa cuisine authentique."
    ],
    "es": [
      "Le Napoli, una institución culinaria en Calais desde 1973, le invita a un viaje gastronómico al corazón de Italia. A dos pasos de la Place d'Armes, este restaurante familiar le conquistará por su ambiente acogedor y su cocina auténtica."
    ],
    "nl": [
      "Le Napoli, een culinair instituut in Calais sinds 1973, nodigt je uit voor een culinaire reis naar het hart van Italië. Op een steenworp afstand van de Place d'Armes zal dit familierestaurant je veroveren met zijn warme sfeer en authentieke keuken."
    ]
  },
  "rdfs:label": {
