  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/584cbfae-d0b2-303f-9b58-56e5094f10a4",
      "dc:description": {
        "de": [
          "Montag, 20. bis Freitag, 24. Februar 2023\n\nMuskulöse Ferien bei Axe Sport Santé!\n\nPraktikum für 6- bis 12-Jährige\n5 Tage Praktikum von 15:00 bis 17:00 Uhr\nBetreut von einem Boxlehrer und Sportpädagogen.\nErwachen zum Boxen; Motorik, Kardio-Zirkel, Faust- und Fußtechniken\n\n2 Gruppen: 6/9 Jahre und 10/12 Jahre.\nPreis: 100 ? pro Woche oder 20 ? pro Tag."
        ],
        "en": [
          "Monday, February 20 to Friday, February 24, 2023\n\nAxe Sport Santé's muscular vacation!\n\nCourse for 6-12 year olds\n5-day course from 3pm to 5pm\nSupervised by a boxing instructor & sports educator.\nIntroduction to boxing; motor skills, cardio circuit, fist & pedal techniques\n\n2 groups: 6/9 years and 10/12 years.\nPrice: 100 ? per week or 20 ? per day of individual training."
        ],
        "it": [
          "Da lunedì 20 a venerdì 24 febbraio 2023\n\nVacanze muscolari all'Axe Sport Santé!\n\nCorso per bambini dai 6 ai 12 anni\ncorso di 5 giorni dalle 15.00 alle 17.00\nSotto la supervisione di un istruttore di boxe e di un educatore sportivo.\nIntroduzione alla boxe; abilità motorie, circuito cardio, tecniche di pugno/pedale, ecc\n\n2 gruppi: 6/9 anni e 10/12 anni.\nPrezzo: 100 euro a settimana o 20 euro al giorno per i corsi individuali."
        ],
        "fr": [
          "Du lundi 20 au vendredi 24 février 2023\n\nVacances musclées chez Axe Sport Santé !\n\nStage pour les 6-12 ans\n5 jours de stage de 15h à 17h\nEncadré par un moniteur de boxe & éducateur sportif.\nEveil à la boxe; motricité, circuit cardio, techniques peds/poings\n\n2 groupes : 6/9 ans et 10/12 ans.\nTarif : 100 € la semaine ou 20 € par jour de stage à l'unité."
        ],
        "nl": [
          "Van maandag 20 tot vrijdag 24 februari 2023\n\nSpiervakantie bij Axe Sport Santé!\n\nCursus voor kinderen van 6-12 jaar\n5-daagse cursus van 15.00 tot 17.00 uur\nBegeleid door een boksinstructeur & sportleraar.\nKennismaking met boksen; motoriek, cardio-circuit, vuist-/pedaltechnieken, enz\n\n2 groepen: 6/9 jaar en 10/12 jaar.\nPrijs: 100 euro per week of 20 euro per dag voor individuele cursussen."
        ],
        "es": [
          "Del lunes 20 al viernes 24 de febrero de 2023\n\n¡Vacaciones musculares en Axe Sport Santé!\n\nCurso para niños de 6 a 12 años\ncurso de 5 días de 15h a 17h\nSupervisado por un instructor de boxeo y un educador deportivo.\nIniciación al boxeo; motricidad, circuito cardio, técnicas de puño/pedal, etc\n\n2 grupos: 6/9 años y 10/12 años.\nPrecio: 100 euros por semana o 20 euros por día para los cursos individuales."
        ]
      },
