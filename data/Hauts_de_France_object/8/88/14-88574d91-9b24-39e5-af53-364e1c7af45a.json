  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dfad40a1-1206-32c1-a19c-94698bc0e962",
      "dc:description": {
        "de": [
          "Walking Football in Fressin zugunsten des Vereins Avotra France\nWalking Football Turnier - Treffpunkt am Sonntag, den 17. August von 10:00 bis 19:00 Uhr\nMelden Sie Ihre Mannschaft unter 06 50 11 35 30 an\nErfrischungsstände, Essen und Trinken, Tombola vor Ort"
        ],
        "en": [
          "Walking Football in Fressin in aid of Avotra France\nWalking Football Tournament - Sunday August 17 from 10am to 7pm\nRegister your team on 06 50 11 35 30\nRefreshments, food and raffle on site"
        ],
        "it": [
          "Calcio a piedi a Fressin a favore di Avotra Francia\nTorneo di calcio a piedi - domenica 17 agosto dalle 10.00 alle 19.00\nIscrivete la vostra squadra al numero 06 50 11 35 30\nRinfresco, cibo e lotteria sul posto"
        ],
        "fr": [
          "Walking Football à Fressin au profit de l'Association Avotra France\nTournoi de football en marchant - Rendez-vous le dimanche 17 août de 10h à 19h\nInscrivez votre équipe au 06 50 11 35 30 \nBuvette, restauration, tombola sur place"
        ],
        "nl": [
          "Walking Football in Fressin ten voordele van Avotra Frankrijk\nWalking Football toernooi - zondag 17 augustus van 10.00 tot 19.00 uur\nSchrijf je team in op 06 50 11 35 30\nVersnaperingen, eten en verloting ter plaatse"
        ],
        "es": [
          "Fútbol a pie en Fressin a beneficio de Avotra France\nTorneo de fútbol a pie - Domingo 17 de agosto de 10h a 19h\nInscriba a su equipo en el 06 50 11 35 30\nRefrescos, comida y tómbola in situ"
        ]
      },
      "@type": [
        "Description"
      ],
