  "rdfs:comment": {
    "de": [
      "Inmitten eines der ältesten Gebäudekomplexe von Abbeville präsentiert das Le Beffroi Musée Boucher-Manessier seine Sammlungen: den Belfried von 1209 (einer der ältesten in Frankreich). Eine Reihe von Zeugnissen der reichen archäologischen Vergangenheit der Somme, bemerkenswerte Werke der mittelalterlichen Skulptur der Picardie"
    ],
    "en": [
      "In the heart of one of Abbeville's oldest ensembles, Le Beffroi Musée Boucher-Manessier presents its collections: the 1209 belfry (one of the oldest in France). Evidence of the Somme's rich archaeological past, remarkable works of medieval Picardy sculpture"
    ],
    "it": [
      "Nel cuore di uno degli edifici più antichi di Abbeville, Le Beffroi Musée Boucher-Manessier presenta le sue collezioni: il Campanile del 1209 (uno dei più antichi di Francia). Il museo testimonia il ricco passato archeologico della Somme e presenta notevoli opere di scultura medievale della Piccardia"
    ],
    "fr": [
      "C'est au cœur de l'un des plus vieux ensembles d'Abbeville que le Le Beffroi Musée Boucher-Manessier présente ses collections : le Beffroi de 1209 (l'un des plus anciens de France). Ensemble de témoignages du riche passé archéologique de la Somme, œuvres remarquables de sculpture picarde médiévale"
    ],
    "nl": [
      "In het hart van een van de oudste gebouwen van Abbeville presenteert Le Beffroi Musée Boucher-Manessier zijn collecties: het Belfort uit 1209 (een van de oudste in Frankrijk). Het museum getuigt van het rijke archeologische verleden van de Somme en heeft opmerkelijke beeldhouwwerken uit middeleeuws Picardië"
    ],
    "es": [
      "En el corazón de uno de los edificios más antiguos de Abbeville, Le Beffroi Musée Boucher-Manessier presenta sus colecciones: el Campanario de 1209 (uno de los más antiguos de Francia). El museo da testimonio del rico pasado arqueológico de la Somme y presenta notables obras de la escultura medieval picarda"
    ]
  },
  "rdfs:label": {
