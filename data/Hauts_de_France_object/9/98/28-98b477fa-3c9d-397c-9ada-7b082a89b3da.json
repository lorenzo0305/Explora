  "rdfs:comment": {
    "de": [
      "Das Konservatorium wollte bei Pierre-Yves Macé, einem Komponisten aus Amiens, der gerade von der Villa Medici in Rom zurückgekehrt war, ein Gemeinschaftswerk für die Klassen Trompete, Schlagzeug und den Chor S2TMD in Auftrag geben.\n\nDas Projekt basiert auf der Schaffung eines zeitgemäßen Werkes, das für und mit den Schülern erdacht wurde."
    ],
    "en": [
      "The Conservatoire commissioned Pierre-Yves Macé, a composer from Amiens who has just returned from the Villa Médicis in Rome, to write a collective work for the trumpet and percussion classes and the S2TMD choir.\n\nThe project is based on the creation of a contemporary work, conceived for and with the students."
    ],
    "it": [
      "Il Conservatorio ha commissionato a Pierre-Yves Macé, compositore di Amiens appena tornato da Villa Médicis a Roma, un'opera collettiva per le classi di tromba e percussioni e per il coro S2TMD.\n\nIl progetto si basa sulla creazione di un'opera contemporanea, concepita per e con gli studenti."
    ],
    "fr": [
      "Le Conservatoire a souhaité commander à Pierre-Yves Macé, compositeur amiénois de retour de la Villa Médicis à Rome, une œuvre collective pour les classes de trompette, de percussion et le chœur S2TMD.\n\nLe projet repose sur la création d'une œuvre d'aujourd'hui, pensée pour et avec les élèves."
    ],
    "nl": [
      "Het Conservatorium gaf Pierre-Yves Macé, een componist uit Amiens die net terug is van de Villa Médicis in Rome, de opdracht om een collectief werk te schrijven voor de trompet- en percussieklassen en het S2TMD-koor.\n\nHet project is gebaseerd op de creatie van een hedendaags werk, bedacht voor en met de studenten."
    ],
    "es": [
      "El Conservatorio encargó a Pierre-Yves Macé, compositor de Amiens que acaba de regresar de la Villa Médicis de Roma, una obra colectiva para las clases de trompeta y percusión y el coro S2TMD.\n\nEl proyecto se basa en la creación de una obra contemporánea, concebida para y con los alumnos."
    ]
  },
