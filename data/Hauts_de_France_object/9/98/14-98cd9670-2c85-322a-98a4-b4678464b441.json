      "dc:description": {
        "de": [
          "Organisiert von den Vikings Portelois\nVerkauf von Bulots und Garnelen vor Ort oder zum Mitnehmen\nVon 19.00 bis 22.00 Uhr beim Abstieg vom Strand"
        ],
        "en": [
          "Organized by the Vikings Portelois\nSale of whelks and shrimps to eat in or take away\nFrom 7:00 pm to 10:00 pm down the beach"
        ],
        "it": [
          "Organizzato dai Vichinghi Portelois\nVendita di buccini e gamberi da consumare o da portare via\nDalle 19.00 alle 22.00 lungo la spiaggia"
        ],
        "fr": [
          "Organisée par les Vikings Portelois\nVente de Bulots et crevettes sur place ou à emporter\nDe 19h00 à 22h00 en descente de la plage"
        ],
        "es": [
          "Organizado por los Vikingos Portelois\nVenta de buccinos y gambas para comer o llevar\nDe 19:00 a 22:00 en la playa"
        ],
        "nl": [
          "Georganiseerd door de Vikingen Portelois\nVerkoop van wulken en garnalen om te eten of mee te nemen\nVan 19.00 tot 22.00 uur op het strand"
        ]
      },
