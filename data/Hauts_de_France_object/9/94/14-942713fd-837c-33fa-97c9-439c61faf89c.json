  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bbe05a2d-9dce-32f1-b7e5-4f3e37c0b767",
      "dc:description": {
        "de": [
          "Hotelrestaurant, das Vorspeisen- und Dessertbuffets anbietet.\ntraditionelle französische Küche in einer freundlichen und familiären Umgebung. Das Restaurant ist an allen Tagen der Woche zum Mittag- und Abendessen geöffnet."
        ],
        "en": [
          "Hotel restaurant serving hors d'oeuvres and desserts.\ntraditional French cuisine in a friendly, family atmosphere. The restaurant is open every day of the week for lunch and dinner."
        ],
        "it": [
          "Ristorante dell'hotel che serve antipasti e dessert.\ncucina tradizionale francese in un'atmosfera amichevole e familiare. Il ristorante è aperto tutti i giorni della settimana per pranzo e cena."
        ],
        "fr": [
          "Restaurant d'hôtel proposant buffets de hors d'oeuvre et desserts.\ncuisine française traditionnelle dans un cadre convivial et familial. Le restaurant est ouvert tous les jours de la semaine pour le déjeuner et le dîner."
        ],
        "es": [
          "Restaurante del hotel que sirve entremeses y postres.\ncocina tradicional francesa en un ambiente familiar y acogedor. El restaurante está abierto todos los días de la semana para el almuerzo y la cena."
        ],
        "nl": [
          "Hotelrestaurant met hors d'oeuvres en desserts.\ntraditionele Franse keuken in een vriendelijke, familiale sfeer. Het restaurant is elke dag van de week geopend voor lunch en diner."
        ]
      },
