  "rdfs:comment": {
    "de": [
      "Willkommen bei plek Bailleul! Café, Lunch & Coworking. Hausgemacht & lokal. Gemütlicher Spot für Frühstück, Mittagessen und Gourmetpausen mit Spezialitätenkaffee und -tee, Gebäck und herzhaften Kuchen. Ein geselliger Ort, der lokale Aromen und eine entspannte Atmosphäre miteinander verbindet und den es in Bailleul zu entdecken gilt."
    ],
    "en": [
      "Welcome to plek Bailleul! Coffee, lunch & coworking. Home-made & local. Cosy spot for breakfast, lunch and gourmet breaks with specialty coffees and teas, pastries and savory tarts. A friendly place to discover in Bailleul, combining local flavors and a relaxed atmosphere."
    ],
    "it": [
      "Benvenuti al Plek Bailleul! Caffè, pranzo e coworking. Fatto in casa e locale. Un luogo accogliente per colazioni, pranzi e pause gourmet con caffè e tè speciali, dolci e torte salate. Un luogo accogliente che combina sapori locali e un'atmosfera rilassata da scoprire a Bailleul."
    ],
    "fr": [
      "Bienvenue chez plek Bailleul ! Café, lunch & coworking. Fait maison & local. Spot cosy pour petit‑déjeuner, déjeuner et pause gourmande avec cafés et thés de spécialité, pâtisseries et tartes salées. Un lieu convivial mêlant saveurs locales et ambiance détendue à découvrir à Bailleul."
    ],
    "es": [
      "¡Bienvenido a plek Bailleul! Café, comida y coworking. Casero y local. Un lugar acogedor para desayunar, comer y hacer pausas gourmet con especialidades de café y té, bollería y tartas saladas. Un lugar acogedor que combina sabores locales y un ambiente relajado para descubrir Bailleul."
    ],
    "nl": [
      "Welkom bij Plek Bailleul! Koffie, lunch & coworking. Huisgemaakt en lokaal. Een gezellige plek voor ontbijt, lunch en gastronomische pauzes met koffiespecialiteiten en thee, gebak en hartige taartjes. Een gezellige plek met lokale smaken en een ontspannen sfeer om Bailleul te ontdekken."
    ]
  },
