  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ad3cdd14-c4f5-3792-898d-0b047ab8c944",
      "dc:description": {
        "de": [
          "Haucourt ist ein Dorf 14 km südöstlich von Arras, auf der Nordseite der Straße Arras-Cambrai (N.39). Der Gemeindefriedhof befindet sich nordöstlich des Dorfes an der Straße D.9 in Richtung Rémy. Das Sammelgrab von drei britischen Fliegern befindet sich in der Nähe der nordöstlichen Ecke des Friedhofs."
        ],
        "en": [
          "Haucourt is a village located 14 kilometers southeast of Arras, on the north side of the Arras-Cambrai road (N.39). The communal cemetery lies to the northeast of the village, on the D.9 road towards Rémy. The collective grave of three British airmen is located near the north-east corner of the cemetery."
        ],
        "it": [
          "Haucourt è un villaggio a 14 chilometri a sud-est di Arras, sul lato nord della strada Arras-Cambrai (N.39). Il cimitero comunale si trova a nord-est del villaggio, sulla strada D.9 in direzione di Rémy. La tomba collettiva di tre aviatori britannici si trova vicino all'angolo nord-est del cimitero."
        ],
        "fr": [
          "Haucourt est un village situé à 14 kilomètres au sud-est d'Arras, du côté nord de la route Arras-Cambrai (N.39). Le cimetière communal se trouve au nord-est du village sur la route D.9 en direction de Rémy. La tombe collective de trois aviateurs britanniques se trouve à proximité du coin nord-est du cimetière."
        ],
        "nl": [
          "Haucourt is een dorp 14 kilometer ten zuidoosten van Arras, aan de noordkant van de weg Arras-Cambrai (N.39). De gemeentelijke begraafplaats ligt ten noordoosten van het dorp aan de weg D.9 richting Rémy. Het gezamenlijke graf van drie Britse vliegeniers ligt vlakbij de noordoostelijke hoek van de begraafplaats."
        ],
        "es": [
          "Haucourt es un pueblo situado a 14 kilómetros al sureste de Arras, en el lado norte de la carretera Arras-Cambrai (N.39). El cementerio comunal se encuentra al noreste del pueblo, en la carretera D.9 en dirección a Rémy. La tumba colectiva de tres aviadores británicos se encuentra cerca de la esquina noreste del cementerio."
        ]
      },
