  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a95e3311-06f6-31e6-8576-a9633fd42344",
      "dc:description": {
        "de": [
          "L'Oh à la Bouche (Brasserie - Restaurant)\n\"Das Restaurant l'Oh à la Bouche empfängt Sie von Februar bis Dezember in einem modernen und gemütlichen Rahmen. Große Terrasse im Freien.\nGenießen Sie unsere Muschel- und Fischspezialitäten\" Reservierungen sind möglich."
        ],
        "en": [
          "L'Oh à la Bouche (Brasserie - Restaurant)\n\"Le Restaurant l'Oh à la Bouche\" welcomes you from February to December in a modern and warm setting. Large outdoor terrace.\nCome and taste our specialities of mussels and fish.\" Reservations possible."
        ],
        "it": [
          "L'Oh à la Bouche (Brasserie - Ristorante)\n\"Il ristorante l'Oh à la Bouche vi accoglie da febbraio a dicembre in un ambiente moderno e caloroso. Ampia terrazza esterna.\nVenite a gustare le nostre cozze e le nostre specialità di pesce Possibilità di prenotazione."
        ],
        "fr": [
          "L'Oh à la Bouche (Brasserie - Restaurant) \n\"Le Restaurant l'Oh à la Bouche vous accueille de février à décembre dans un cadre moderne et chaleureux. Grande terrasse extérieure.\nVenez déguster nos spécialités de moules et de poissons.\" Réservations possible."
        ],
        "es": [
          "L'Oh à la Bouche (Brasserie - Restaurante)\n\"El Restaurante l'Oh à la Bouche le da la bienvenida de febrero a diciembre en un entorno moderno y cálido. Amplia terraza exterior.\nVenga a probar nuestras especialidades de mejillones y pescado Es posible reservar."
        ],
        "nl": [
          "L'Oh à la Bouche (Brasserie - Restaurant)\n\"Het Restaurant l'Oh à la Bouche ontvangt u van februari tot december in een modern en warm kader. Groot buitenterras.\nKom en proef onze mosselen en visspecialiteiten Reserveringen mogelijk."
        ]
      },
      "@type": [
        "Description"
      ],
