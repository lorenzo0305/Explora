  "rdfs:comment": {
    "de": [
      "Das Hotel liegt 25 km von Arras und Cambrai entfernt.\nKomfortables, gemütlich eingerichtetes Hotel\n\nEine kleine Geste für den Planeten Ihr Wasser wird von der Sonne erwärmt"
    ],
    "en": [
      "Located 25 kms from Arras and Cambrai.\nHotel any comfort, warmly decorated\n\nA small gesture for the planet your water is heated by the sun"
    ],
    "it": [
      "Situato a 25 km da Arras e Cambrai.\nHotel confortevole, arredato in modo accogliente\n\nUn piccolo gesto per il pianeta La vostra acqua è riscaldata dal Sole"
    ],
    "fr": [
      "Situé à 25 kms d'Arras et de Cambrai.\nHôtel tout confort, décoré chaleureusement\n\nUn petit geste pour la planéte votre eau est chauffée par le Soleil"
    ],
    "es": [
      "Situado a 25 km de Arras y Cambrai.\nHotel confortable, con una decoración cálida\n\nUn pequeño gesto para el planeta su agua es calentada por el Sol"
    ],
    "nl": [
      "Gelegen op 25 km van Arras en Cambrai.\nComfortabel hotel, warm ingericht\n\nEen klein gebaar voor de planeet uw water wordt verwarmd door de zon"
