  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ddce50ce-a168-3d05-84ec-3364c38970a0",
      "dc:description": {
        "de": [
          "Mit den Gesangs- und Chorschülern des Conservatoire du Boulonnais.\nSamstag, 13. Dezember 2025 um 17H und 18H\nDauer: 30 Minuten und Imbiss.\n\nSonntag, 14. Dezember 2025 um 16H\nUmzug über den Weihnachtsmarkt am Parkplatz Enclos de l'Evêché.\nDauer: 40 Minuten\nKostenlos\nSpendenaufruf für den Telethon, der dem Publikum zur freien Verfügung überlassen wird."
        ],
        "en": [
          "With student singers and choristers from the Conservatoire du Boulonnais.\nSaturday, December 13, 2025 at 5pm and 6pm\nDuration: 30 minutes and snack.\n\nSunday, December 14, 2025 at 4pm\nChristmas market stroll in the Enclos de l'Evêché parking lot.\nDuration: 40 minutes\nFree\nCall for donations to the Telethon open to the public."
        ],
        "it": [
          "Con studenti cantanti e coristi del Conservatorio del Boulonnais.\nSabato 13 dicembre 2025 alle 17.00 e alle 18.00\nDurata: 30 minuti e merenda.\n\nDomenica 14 dicembre 2025 alle 16.00\nPasseggiata intorno al mercatino di Natale nel parcheggio dell'Enclos de l'Evêché.\nDurata: 40 minuti\nGratuito\nAppello alle donazioni per Telethon aperto al pubblico."
        ],
        "fr": [
          "Avec les élèves chanteurs et choristes du Conservatoire du Boulonnais.\nSamedi 13 décembre 2025 à 17H et  18H\nDurée : 30 minutes et goûter.\n\nDimanche 14 décembre 2025 à 16H\nDéambulation sur le marché de Noël au parking de l'Enclos de l'Evêché.\nDurée : 40 minutes\nGratuit \nAppel aux dons pour le Téléthon laissé à la libre appréciation du public."
        ],
        "nl": [
          "Met studenten zangers en koorzangers van het Conservatoire du Boulonnais.\nZaterdag 13 december 2025 om 17.00 en 18.00 uur\nDuur: 30 minuten en snack.\n\nZondag 14 december 2025 om 16.00 uur\nWandeling over de kerstmarkt op de parkeerplaats van Enclos de l'Evêché.\nDuur: 40 minuten\nGratis\nOproep voor donaties voor de Telethon open voor het publiek."
        ],
        "es": [
          "Con estudiantes de canto y coro del Conservatorio de Boulonnais.\nSábado 13 de diciembre de 2025 a las 17.00 y 18.00 horas\nDuración: 30 minutos y merienda.\n\nDomingo 14 de diciembre de 2025 a las 16.00 h\nPaseo por el mercado de Navidad en el aparcamiento del Enclos de l'Evêché.\nDuración: 40 minutos\nGratis\nConvocatoria de donativos para el Telemaratón abierta al público."
        ]
      },
