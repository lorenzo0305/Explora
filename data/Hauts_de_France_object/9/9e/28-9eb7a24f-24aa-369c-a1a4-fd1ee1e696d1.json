      "dc:description": {
        "de": [
          "Ihr Campingplatz bietet Ihnen auch den Verleih von klassischen Fahrrädern an.\n6 klassische Fahrräder.\nZubehör zur Verfügung: Kindersitz, Helm, Fahrradschloss."
        ],
        "en": [
          "Your campsite also offers classic bike hire.\n6 classic bikes.\nAccessories available: baby seat, helmet, anti-theft device."
        ],
        "it": [
          "Il vostro campeggio offre anche biciclette classiche a noleggio.\n6 biciclette classiche.\nAccessori disponibili: seggiolino, casco, lucchetto."
        ],
        "fr": [
          "Votre camping vous propose également de la location de vélos classiques.\n6 vélos classiques.\nAccessoires à disposition : siège bébé, casque, antivol."
        ],
        "nl": [
          "Op uw camping kunt u ook klassieke fietsen huren.\n6 klassieke fietsen.\nBeschikbare accessoires: babyzitje, helm, slot."
        ],
        "es": [
          "El camping también ofrece el alquiler de bicicletas clásicas.\n6 motos clásicas.\nAccesorios disponibles: silla de bebé, casco, candado."
        ]
      },
