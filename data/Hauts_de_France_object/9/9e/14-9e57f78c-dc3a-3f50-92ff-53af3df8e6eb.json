  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fc40fbf9-5f31-3722-86ed-0d71b83eba9e",
      "dc:description": {
        "de": [
          "Moderner Tanz, Mitglied der FFDanse.\nTarife: 110/E - 140/A - 19/Lizenz.\nKurstage in der Maison du Temps Libre von Stella Plage:\nDienstag: Junioren --> 17.45 Uhr / Inters --> 18.30 Uhr / Erwachsene 1 --> 19.15 Uhr.\nMittwoch: Anfänger --> 17.45 Uhr.\nSamstag: Teenager --> 10.00 Uhr / Erwachsene 2 --> 10.45 Uhr.\nEinschreibungen im Juni auf Warteliste.\nHauptsitz: Résidence Géo Ana, Appt 2, Erdgeschoss, 1508 Boulevard Labrasse 62780 Stella Plage."
        ],
        "en": [
          "Modern dance, affiliated with FFDanse.\nFees: 110?/E -140?/A - 19? license.\nDays of classes at Maison du Temps Libre de Stella Plage :\nTuesday: juniors --> 17h45 / inters --> 18h30 / adults 1 --> 19h15.\nWednesday: beginners --> 17h45.\nSaturday: teens --> 10:00 am / adults 2 --> 10:45 am.\nRegistration in June on waiting list.\nHead office: Résidence Géo Ana, Appt 2, RDC, 1508 Boulevard Labrasse 62780 Stella Plage."
        ],
        "it": [
          "Danza moderna, affiliata alla FFDanse.\nQuote: 110€/E - 140€/A - 19€ di licenza.\nGiorni di lezione alla Maison du Temps Libre di Stella Plage:\nMartedì: juniores --> 17h45 / inters --> 18h30 / adulti 1 --> 19h15.\nMercoledì: principianti --> 17h45.\nSabato: adolescenti --> 10.00 / adulti 2 --> 10.45.\nIscrizioni a giugno in lista d'attesa.\nSede: Résidence Géo Ana, Appt 2, RDC, 1508 Boulevard Labrasse 62780 Stella Plage."
        ],
        "fr": [
          "Danse moderne, affilié à la FFDanse.\nTarifs : 110€/E -140€/A - 19€ la licence. \nJours des cours pratiqués à la Maison du Temps Libre de Stella Plage :\nMardi :  juniors --> 17h45 / inters --> 18h30 / adultes 1 --> 19h15. \nMercredi : débutants --> 17h45. \nSamedi : ados --> 10h00 / adultes 2 --> 10h45.\nInscriptions en Juin sur liste d'attente.\nSiège social : Résidence Géo Ana, Appt 2, RDC, 1508 Boulevard Labrasse 62780 Stella Plage."
        ],
        "nl": [
          "Moderne dans, aangesloten bij de FFDanse.\nKosten: 110€/E - 140€/A - 19€ licentie.\nLesdagen in het Maison du Temps Libre de Stella Plage :\nDinsdag: juniors --> 17u45 / inters --> 18u30 / volwassenen 1 --> 19u15.\nWoensdag: beginners --> 17h45.\nZaterdag: tieners --> 10u00 / volwassenen 2 --> 10u45.\nInschrijving in juni op wachtlijst.\nHoofdkantoor: Résidence Géo Ana, Appt 2, RDC, 1508 Boulevard Labrasse 62780 Stella Plage."
        ],
        "es": [
          "Baile moderno, afiliado a la FFDanse.\nPrecios: 110€/E - 140€/A - 19€ licencia.\nDías de clases en la Maison du Temps Libre de Stella Plage :\nMartes: juniors --> 17h45 / inters --> 18h30 / adultos 1 --> 19h15.\nMiércoles: principiantes --> 17h45.\nSábado: adolescentes --> 10h00 / adultos 2 --> 10h45.\nInscripción en junio en lista de espera.\nSede: Résidence Géo Ana, Appt 2, RDC, 1508 Boulevard Labrasse 62780 Stella Plage."
        ]
      },
