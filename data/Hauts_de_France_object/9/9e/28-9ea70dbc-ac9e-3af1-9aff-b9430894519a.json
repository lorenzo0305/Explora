  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5e50da06-bbfe-369d-9df6-7f72ef5e4cdb",
      "dc:description": {
        "de": [
          "An lokalen und regionalen Festen teilnehmen. Die Feldarbeit und die Traditionen auf althergebrachte Weise fortführen. Kutschfahrten im Rahmen der Entdeckung des lokalen Erbes organisieren"
        ],
        "en": [
          "Participate in local and regional festivals. Perpetuate old-fashioned field work and traditions. Organize horse-drawn carriage rides to discover the local heritage"
        ],
        "it": [
          "Partecipare a feste locali e regionali. Mantenere il lavoro nei campi e le tradizioni di un tempo. Organizzare gite in carrozza per scoprire il patrimonio locale"
        ],
        "fr": [
          "Participer aux fêtes locales et régionales. Perpétuer les travaux des champs et les traditions à l'ancienne. Organiser des balades en calèche dans le cadre de la découverte du patrimoine local"
        ],
        "es": [
          "Participar en fiestas locales y regionales. Perpetuar las labores del campo y las tradiciones de antaño. Organizar paseos en coche de caballos para descubrir el patrimonio local"
        ],
        "nl": [
          "Deelnemen aan lokale en regionale festivals. Ouderwets werk op het land en tradities in ere houden. Paardenkoetsritten organiseren om het lokale erfgoed te ontdekken"
        ]
      },
