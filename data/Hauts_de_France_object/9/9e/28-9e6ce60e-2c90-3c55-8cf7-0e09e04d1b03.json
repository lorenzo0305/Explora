  "rdfs:comment": {
    "de": [
      "EVENEMENT\nIn Zusammenarbeit mit dem Ciné St-Leu wird Ihnen unser Reiseleiter die Art-Deco-Einflüsse vorstellen, die in diesem Film von Marcel L'Herbier zu finden sind, der in einer restaurierten Fassung gezeigt wird!"
    ],
    "en": [
      "EVENT\nIn partnership with Ciné St-Leu, our guide will introduce you to the Art Deco influences present in this film directed by Marcel L'Herbier and shown in its restored version!"
    ],
    "it": [
      "EVENTO\nIn collaborazione con Ciné St-Leu, la nostra guida vi mostrerà le influenze Art Déco presenti in questo film diretto da Marcel L'Herbier e presentato in versione restaurata!"
    ],
    "fr": [
      "ÉVENEMENT\nEn partenariat avec le Ciné St-Leu, notre guide vous présentera les influences Art déco présentes dans ce film réalisé par Marcel L'Herbier et diffusé en version restaurée !"
    ],
    "nl": [
      "EVENT\nIn samenwerking met Ciné St-Leu laat onze gids je de Art Deco invloeden zien die aanwezig zijn in deze film geregisseerd door Marcel L'Herbier en vertoond in een gerestaureerde versie!"
    ],
    "es": [
      "EVENTO\nEn colaboración con Ciné St-Leu, nuestro guía le mostrará las influencias Art Déco presentes en esta película dirigida por Marcel L'Herbier y proyectada en versión restaurada"
    ]
  },
  "rdfs:label": {
