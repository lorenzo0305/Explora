  "rdfs:comment": {
    "de": [
      "Der Verein Sud Oise Rando bietet im Rahmen des Gemeindefestes von Cramoisy am Sonntag, dem 26. April 2026, eine Wanderung ab dem Festsaal an, bei der Sie selbstständig 3 ausgeschilderte Strecken von 8, 11, 15 oder 18 km zurücklegen können. Anmeldung von 8.00 bis 10.30 Uhr vor Ort."
    ],
    "en": [
      "The Sud Oise Rando association is organizing a hike starting from the Salle des Fêtes on Sunday, April 26, 2026, as part of the Cramoisy town festival. 3 signposted routes of 8, 11, 15 or 18 KM. Registration from 8:00 to 10:30 a.m. on site."
    ],
    "it": [
      "L'associazione Sud Oise Rando organizza un'escursione nell'ambito della festa locale di Cramoisy, con partenza dalla Salle des Fêtes, domenica 26 aprile 2026, con 3 percorsi segnalati di 8, 11, 15 o 18 km. Iscrizioni dalle 8.00 alle 10.30 sul posto."
    ],
    "fr": [
      "L'association Sud Oise Rando propose dans le cadre de la Fête communale de Cramoisy une randonnée pédestre au départ de la salle des Fêtes  Dimanche 26 avril 2026.Randonnée en autonomie avec 3 Parcours fléchés de 8, 11 ou 15 ou 18 KM. Inscriptions de 8h00 à 10h30 sur place."
    ],
    "es": [
      "La asociación Sud Oise Rando organiza una excursión en el marco de las fiestas patronales de Cramoisy, con salida de la Salle des Fêtes el domingo 26 de abril de 2026, con 3 recorridos señalizados de 8, 11, 15 o 18 km. Inscripciones de 8.00 a 10.30 h in situ."
    ],
    "nl": [
      "De vereniging Sud Oise Rando organiseert een wandeltocht in het kader van het lokale feest van Cramoisy, met vertrek op zondag 26 april 2026 vanaf de Salle des Fêtes, met 3 bewegwijzerde routes van 8, 11, 15 of 18 km. Inschrijving van 8.00 tot 10.30 uur ter plaatse."
    ]
  },
