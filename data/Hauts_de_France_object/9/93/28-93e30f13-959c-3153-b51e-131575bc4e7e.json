  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen traditionelle Gerichte mit frischen Zutaten. Sie können auch Familien- oder Geschäftsessen mit unserem kleinen Salon, der sich im Obergeschoss befindet, organisieren."
    ],
    "en": [
      "We serve traditional dishes made with fresh produce. You can also organize family or business meals in our small lounge upstairs."
    ],
    "it": [
      "Serviamo piatti tradizionali preparati con prodotti freschi. È inoltre possibile organizzare cene di famiglia o di lavoro nel nostro piccolo salone al piano superiore."
    ],
    "fr": [
      "Nous vous proposons des plats traditionnels avec des produits frais. Vous pouvez également organiser des repas familiaux ou d'affaires avec notre petit salon qui se trouve à l'étage."
    ],
    "nl": [
      "We serveren traditionele gerechten met verse producten. Je kunt ook familie- of zakendiners organiseren in onze kleine lounge boven."
    ],
    "es": [
      "Servimos platos tradicionales elaborados con productos frescos. También puede organizar comidas familiares o de negocios en nuestro pequeño salón de arriba."
