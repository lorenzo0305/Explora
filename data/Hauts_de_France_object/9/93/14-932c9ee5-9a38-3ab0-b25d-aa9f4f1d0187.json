      "dc:description": {
        "de": [
          "Der verlockende Geruch von frisch gebackenen Pommes frites, Amerikanern, Faluches, Sandwiches... entdecken Sie die Friterie Hélène"
        ],
        "en": [
          "The tempting smell of freshly-cooked French fries, Americans, faluches, sandwiches... come and discover Friterie Hélène"
        ],
        "it": [
          "Il profumo invitante delle patatine appena sfornate, degli americani, delle faluches, dei panini... venite a scoprire la Friterie Hélène"
        ],
        "fr": [
          "L'odeur alléchante des frites fraîchement cuites, américains, faluches, sandwichs... venez découvrir la Friterie Hélène"
        ],
        "es": [
          "El tentador olor a patatas fritas recién hechas, americanos, faluches, sándwiches... venga a descubrir Friterie Hélène"
        ],
        "nl": [
          "De verleidelijke geur van versgebakken friet, Amerikanen, faluches, sandwiches... kom Friterie Hélène ontdekken"
        ]
      },
