  "rdfs:comment": {
    "de": [
      "\"Die Legende von Ashitaka, das Universum von Hayao Miyazaki\"\n\nLeitung und Regie: Emmanuel Boulanger und das Octuor de Violoncelles de Champagne\nShigeko Hata - Gesang\nAnne-Lise Branquet , Alexandre Soumagne, Jean-Paul Dealet, Laurent Rannou - Violoncelli\nMit der Teilnahme von Schülern des CRR Amiens und des CRD du Beauvaisis\nJapanische Kalligraphie\nProgramm: Musik aus Animes von Hayao Miyazaki"
    ],
    "en": [
      "\"The Legend of Ashitaka, Hayao Miyazaki's universe\n\nDirected and produced by Emmanuel Boulanger and the Champagne Cello Octuor\nShigeko Hata - vocals\nAnne-Lise Branquet , Alexandre Soumagne, Jean-Paul Dealet, Laurent Rannou - cellos\nWith the participation of students from CRR d'Amiens and CRD du Beauvaisis\nJapanese calligraphy\nProgram: music from Hayao Miyazaki animated films"
    ],
    "it": [
      "\"La leggenda di Ashitaka\", l'universo di Hayao Miyazaki\n\nDiretto e prodotto da Emmanuel Boulanger e dallo Champagne Cello Octuor\nShigeko Hata - voce\nAnne-Lise Branquet , Alexandre Soumagne, Jean-Paul Dealet, Laurent Rannou - violoncelli\nCon la partecipazione di studenti del CRR d'Amiens e del CRD di Beauvaisis\nCalligrafia giapponese\nProgramma: musiche dei film d'animazione di Hayao Miyazaki"
    ],
    "fr": [
      "\" La Légende d'Ashitaka, l'Univers d'Hayao Miyazaki\"\n\nDirection et réalisation : Emmanuel Boulanger et l'Octuor de Violoncelles de Champagne  \nShigeko Hata - chant\nAnne-Lise Branquet , Alexandre Soumagne, Jean-Paul Dealet, Laurent Rannou - Violoncelles\nAvec la participation des élèves du CRR d'Amiens et du CRD du Beauvaisis\nCalligraphie Japonaise\nProgramme : musiques d’animés de Hayao Miyazaki"
    ],
    "es": [
      "\"La leyenda de Ashitaka\", el universo de Hayao Miyazaki\n\nDirigido y producido por Emmanuel Boulanger y el Champagne Cello Octuor\nShigeko Hata - voz\nAnne-Lise Branquet , Alexandre Soumagne, Jean-Paul Dealet, Laurent Rannou - violonchelos\nCon la participación de alumnos del CRR d'Amiens y del CRD du Beauvaisis\nCaligrafía japonesa\nPrograma: música de las películas de animación de Hayao Miyazaki"
    ],
    "nl": [
      "\"De legende van Ashitaka, Hayao Miyazaki's universum\n\nGeregisseerd en geproduceerd door Emmanuel Boulanger en het Champagne Cello Octuor\nShigeko Hata - zang\nAnne-Lise Branquet , Alexandre Soumagne, Jean-Paul Dealet, Laurent Rannou - cello's\nMet medewerking van studenten van de CRR d'Amiens en het CRD du Beauvaisis\nJapanse kalligrafie\nProgramma: muziek uit de animatiefilms van Hayao Miyazaki"
    ]
  },
