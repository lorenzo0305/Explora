  "rdfs:comment": {
    "de": [
      "Gemütliches Restaurant mit musikalischer Jazz/Blues-Atmosphäre. Die Küche wird mit frischen Produkten zubereitet, die Gerichte sind Minutengerichte: Welsh, Entenbrust, Lamm-Parmentier, Fisch...\nZweimal im Monat werden Konzerte veranstaltet."
    ],
    "en": [
      "Cosy restaurant with a jazz / blues musical atmosphere. The kitchen is prepared with fresh products, the dishes are minutes: welsh, duck breast, lamb parmentier, fish ...\nConcerts are organized twice a month."
    ],
    "it": [
      "Ristorante accogliente con atmosfera musicale jazz/blues. La cucina è preparata con prodotti freschi, i piatti sono minuti: gallese, petto d'anatra, parmentier d'agnello, pesce...\nDue volte al mese vengono organizzati concerti."
    ],
    "fr": [
      "Restaurant cosy à l'ambiance musicale jazz / blues. La cuisine est préparée avec des produits frais, les plats sont minutes : welsh, magret de canard, parmentier d'agneau, poissons... \nDes concerts sont organisés 2 fois par mois."
    ],
    "es": [
      "Restaurante acogedor con un ambiente musical de jazz/blues. La cocina se elabora con productos frescos, los platos son minuciosos: galés, magret de pato, parmentier de cordero, pescado...\nSe organizan conciertos dos veces al mes."
    ],
    "nl": [
      "Gezellig restaurant met een jazz/blues muzikale sfeer. De keuken wordt bereid met verse producten, de gerechten zijn minuut: welsh, eendenborst, lamsparmentier, vis...\nTwee keer per maand worden concerten georganiseerd."
    ]
  },
