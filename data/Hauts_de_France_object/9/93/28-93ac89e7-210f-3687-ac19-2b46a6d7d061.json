  "rdfs:comment": {
    "de": [
      "Direkt unter Ihren Füßen befindet sich einer der Reichtümer von Saint-Quentin: sein unterirdisches Kulturerbe.\nTauchen Sie in Begleitung eines Fremdenführers 1,5 Stunden lang in die Eingeweide der Stadt ein."
    ],
    "en": [
      "Right beneath your feet lies one of Saint-Quentin's greatest treasures... its underground heritage.\nDive into the bowels of the city with a guide for 1h30."
    ],
    "it": [
      "Sotto i vostri piedi si nasconde uno dei più grandi tesori di Saint-Quentin... il suo patrimonio sotterraneo.\nImmergetevi nelle viscere della città con una guida per 1 ora."
    ],
    "fr": [
      "Juste sous vos pieds, se trouve une des richesses de Saint-Quentin... son patrimoine souterrain.\nPlongez dans les entrailles de la ville accompagné d'un guide conférencier pendant 1h30."
    ],
    "nl": [
      "Vlak onder je voeten ligt een van de grootste schatten van Saint-Quentin... het ondergrondse erfgoed.\nDuik in de ingewanden van de stad met een gids gedurende 1 uur."
    ],
    "es": [
      "Bajo sus pies se esconde uno de los mayores tesoros de Saint-Quentin: su patrimonio subterráneo.\nSumérjase en las entrañas de la ciudad con un guía durante una hora y media."
    ]
  },
  "rdfs:label": {
