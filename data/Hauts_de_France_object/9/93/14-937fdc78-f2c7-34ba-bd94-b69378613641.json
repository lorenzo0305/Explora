  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a482b0a0-0a9e-3ec4-a975-36eb2b9fbf2d",
      "dc:description": {
        "de": [
          "Das Denkmal ist aus belgischem Granit und hat die Form eines Obelisken, auf dem einige Grab- und patriotische Symbole abgebildet sind. Der Autor ist Edmond Maréchal, Marmorierer in Boulogne sur mer."
        ],
        "en": [
          "The monument is made of Belgian granite and is shaped like an obelisk where some funerary and patriotic symbols are represented. The author is Edmond Maréchal, marble maker in Boulogne sur mer."
        ],
        "it": [
          "Il monumento è realizzato in granito belga e ha la forma di un obelisco in cui sono rappresentati alcuni simboli funerari e patriottici. L'autore è Edmond Maréchal, marmista a Boulogne sur mer."
        ],
        "fr": [
          "Le monument est en granit belge et en forme d'obélisque où quelques symboles funéraires et patriotiques sont représentés. L'auteur est Edmond Maréchal, marbrier à Boulogne sur mer."
        ],
        "nl": [
          "Het monument is gemaakt van Belgisch graniet en heeft de vorm van een obelisk waarop enkele funeraire en patriottische symbolen zijn afgebeeld. De auteur is Edmond Maréchal, marmerbewerker in Boulogne sur mer."
        ],
        "es": [
          "El monumento es de granito belga y tiene forma de obelisco donde se representan algunos símbolos funerarios y patrióticos. El autor es Edmond Maréchal, marmolista en Boulogne sur mer."
        ]
      },
