  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/31fe40b0-9344-33a6-90f5-5fa3ff146666",
      "dc:description": {
        "de": [
          "Begeben Sie sich mit einem Führer und unter dem Blick und der Feder von Christophe Moyer, Autor, Schauspieler und Regisseur, auf einen Spaziergang. Begeben Sie sich auf eine historische und theatralische Reise durch die bukolischen Landschaften von Carency und der Umgebung."
        ],
        "en": [
          "Take a guided tour under the watchful eye of author, actor and director Christophe Moyer. Take a historical and theatrical journey through the bucolic landscapes of Carency and the surrounding area."
        ],
        "it": [
          "Passeggiate con una guida, sotto l'occhio e la penna di Christophe Moyer, autore, attore e regista. Un viaggio storico e teatrale attraverso i paesaggi bucolici di Carency e dintorni."
        ],
        "fr": [
          "Partez en balade avec un guide et sous le regard et la plume de Christophe Moyer, auteur, comédien et metteur en scène. Partez pour une traversée historique et théâtrale des paysages bucoliques de Carency et des alentours."
        ],
        "es": [
          "Pasee con un guía, bajo la atenta mirada y la pluma de Christophe Moyer, autor, actor y director. Haga un recorrido histórico y teatral por los bucólicos paisajes de Carency y sus alrededores."
        ],
        "nl": [
          "Maak een wandeling met een gids, onder het toeziend oog en de pen van Christophe Moyer, auteur, acteur en regisseur. Maak een historische en theatrale reis door de bucolische landschappen van Carency en omgeving."
        ]
      },
