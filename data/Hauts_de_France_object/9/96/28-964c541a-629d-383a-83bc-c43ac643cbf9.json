  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/41a846cb-12f2-303c-b8dd-cca8f271a160",
      "dc:description": {
        "de": [
          "In einem neu renovierten und geschmackvoll eingerichteten Speisesaal freuen sich Emmanuel und Nicolas darauf, Sie bestmöglich zu empfangen, damit Sie einen tollen Moment bei einem guten Crêpe verbringen können."
        ],
        "en": [
          "In a dining room redone and decorated with taste, Emmanuel and Nicolas will have the pleasure to receive you at best so that you spend an excellent moment around a good pancake."
        ],
        "it": [
          "Emmanuel e Nicolas saranno lieti di accogliervi in una sala da pranzo arredata con gusto per farvi trascorrere un ottimo momento intorno a un buon pancake."
        ],
        "fr": [
          "Dans une salle de restauration refaite à neuf et décorée avec goût, Emmanuel et Nicolas auront le plaisir de vous recevoir au mieux afin que vous passiez un excellent moment autour d'une bonne crêpe."
        ],
        "es": [
          "Emmanuel y Nicolas estarán encantados de recibirle en un comedor decorado con gusto para que pueda pasar un buen rato en torno a una buena tortita."
        ],
        "nl": [
          "Emmanuel en Nicolas ontvangen u graag in een smaakvol ingerichte eetkamer zodat u een uitstekend moment kunt doorbrengen rond een goede pannenkoek."
        ]
      },
