  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Öko-Dorfes Belle Dune von Pierre et Vacances. Zwischen Meer, Dünen und See in der Baie de Somme ... Restaurant mit Veranda und Blick auf den See. Traditionelle und lokale Küche. Buffets zu verschiedenen Themen. Kindermenüs."
    ],
    "en": [
      "Restaurant in the heart of the eco-village Belle Dune de Pierre et Vacances. Between sea, dunes and lake in Baie de Somme ... Restaurant with veranda and view on the lake. Traditional and local cuisine. Theme buffets. Children's menu."
    ],
    "it": [
      "Ristorante nel cuore dell'ecovillaggio Belle Dune di Pierre et Vacances. Tra mare, dune e lago nella Baie de Somme. Ristorante con veranda e vista sul lago. Cucina tradizionale e locale. Buffet a tema. Menu per bambini."
    ],
    "fr": [
      "Restaurant au coeur de l'éco-village Belle Dune de Pierre et Vacances. Entre mer, dunes et lac en Baie de Somme .. Restaurant avec véranda et vue sur le lac. Cuisine traditionnelle et locale. Buffets à thème. Menus enfants."
    ],
    "es": [
      "Restaurante en el corazón de la villa ecológica Belle Dune de Pierre et Vacances. Entre mar, dunas y lago en la Bahía de Somme. Restaurante con veranda y vista al lago. Cocina tradicional y local. Bufetes temáticos. Menús para niños."
    ],
    "nl": [
      "Restaurant in het hart van Pierre et Vacances' Belle Dune eco-dorp. Tussen zee, duinen en meer in de Baie de Somme. Restaurant met veranda en uitzicht op het meer. Traditionele en lokale gerechten. Thema buffetten. Kindermenu's."
    ]
  },
