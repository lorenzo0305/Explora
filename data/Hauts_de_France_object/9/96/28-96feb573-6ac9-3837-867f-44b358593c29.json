  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a5ecf917-4f79-339f-8691-1179790befd4",
      "dc:description": {
        "de": [
          "Éric hat sich auf 1 ha Apfelweinbäumen niedergelassen und verarbeitet seine Äpfel zu natürlichem Cidre (nicht pasteurisiert oder mit Kohlensäure versetzt) und Apfelsaft.\n\nDie von Éric verarbeiteten Produkte haben ihren Namen von dieser geschichtsträchtigen Gegend."
        ],
        "en": [
          "Installed on 1 ha of cider apple trees, Éric transforms his apples into natural cider (not pasteurized or carbonated) and apple juice.\n\nLocated in Saint Gratien, in the heart of the Coudriers' country, the products processed by Éric take their name from this territory rich in history."
        ],
        "it": [
          "Éric possiede 1 ettaro di meli da sidro e trasforma le sue mele in sidro naturale (non pastorizzato o gassato) e in succo di mela.\n\nSituati a Saint Gratien, nel cuore della regione dei Coudriers, i prodotti che Éric trasforma prendono il nome da questo territorio ricco di storia."
        ],
        "fr": [
          "Installé sur 1 ha de pommiers à cidre, Éric transforme ses pommes en cidre naturel (non pasteurisé ni gazéifié) et en jus de pomme.\n\nSitué à Saint Gratien, au sein du pays des Coudriers, les produits transformés par Éric tire leur nom de ce territoire riche en histoire."
        ],
        "es": [
          "Éric tiene 1 hectárea de manzanos de sidra y transforma sus manzanas en sidra natural (no pasteurizada ni carbonatada) y zumo de manzana.\n\nSituados en Saint Gratien, en el corazón de la región de Coudriers, los productos que Éric transforma toman su nombre de este territorio rico en historia."
        ],
        "nl": [
          "Éric heeft 1 hectare ciderappelbomen en verwerkt zijn appels tot natuurlijke cider (niet gepasteuriseerd of koolzuurhoudend) en appelsap.\n\nGelegen in Saint Gratien, in het hart van de Coudriers, ontlenen de producten die Éric bewerkt hun naam aan dit gebied met een rijke geschiedenis."
        ]
      },
      "@type": [
        "Description"
      ],
