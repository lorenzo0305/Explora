  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0317596e-b036-3b92-a04b-a4bf461da716",
      "dc:description": {
        "de": [
          "Informationen :\n\nMenü :\nBesuchen Sie die Facebook-Seite\n\nÖffnungszeiten: In Beaurains, auf dem Parkplatz des Baumarkts Brico Dépôt\nMontag bis Freitag: 11.30-14 Uhr\n\nSamstags, sonntags und an Feiertagen geschlossen\n\n \n\nBestellung:\nBestellung per Telefon unter 06 74 51 17 20 ab 17 Uhr möglich\n\n "
        ],
        "en": [
          "Information :\n\nMenu :\nVisit our Facebook page\n\nOpening days: in Beaurains, in the parking lot of the Brico Dépôt store\nMonday to Friday: 11:30am-2pm\n\nClosed on Saturdays, Sundays and public holidays\n\n \n\nOrdering:\nOrders can be placed by telephone on 06 74 51 17 20 from 5pm\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nVisita la pagina Facebook\n\nGiorni di apertura: a Beaurains, nel parcheggio del negozio Brico Dépôt\nDa lunedì a venerdì: 11.30-14.00\n\nChiuso il sabato, la domenica e i giorni festivi\n\n \n\nCome ordinare :\nLe ordinazioni possono essere effettuate telefonicamente al numero 06 74 51 17 20 dalle ore 17.00\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu : \nConsultez la page Facebook\n\nJours d'ouverture : à Beaurains, sur le parking du magasin Brico Dépôt\nDu lundi au vendredi: 11h30-14h\n\nFermeture le samedi, dimanche et jours fériés\n\n \n\nCommande :\nPossibilité de commander par téléphone au 06 74 51 17 20 à partir de 17h\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nBezoek de Facebook pagina\n\nOpeningsdagen: in Beaurains, op de parking van de Brico Dépôt winkel\nMaandag tot vrijdag: 11.30u-2u\n\nGesloten op zaterdag, zondag en feestdagen\n\n \n\nHoe te bestellen :\nBestellingen kunnen telefonisch worden doorgegeven op 06 74 51 17 20 vanaf 17.00 uur\n\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nVisite la página de Facebook\n\nDías de apertura: en Beaurains, en el aparcamiento de la tienda Brico Dépôt\nDe lunes a viernes: de 11.30 a 14.00 h\n\nCerrado los sábados, domingos y festivos\n\n \n\nCómo hacer un pedido :\nLos pedidos pueden hacerse por teléfono llamando al 06 74 51 17 20 a partir de las 17.00 horas\n\n "
        ]
      },
