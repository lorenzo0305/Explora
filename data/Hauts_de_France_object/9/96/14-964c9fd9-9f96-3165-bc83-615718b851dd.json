      "@id": "https://data.datatourisme.fr/2c418d53-2ce7-37b2-9471-f61358515790",
      "dc:description": {
        "de": [
          "Pizza, Panini, Bruschetta. Verkauf vor Ort oder zum Mitnehmen. Genießen Sie bei schönem Wetter eine schöne Terrasse, die vor Blicken geschützt ist."
        ],
        "en": [
          "Pizza, panini, bruschetta. On-site or takeaway sales. Enjoy a lovely terrace out of sight as soon as the sun comes out."
        ],
        "it": [
          "Pizza, panini, bruschette. Sul posto o da asporto. Godetevi una bella terrazza all'aperto non appena arriva il bel tempo."
        ],
        "fr": [
          "Pizza, panini, bruschetta. Vente sur place ou à emporter. Profitez d'une jolie terrasse à l'abri des regards dès l'arrivée des beaux jours."
        ],
        "nl": [
          "Pizza, panini, bruschetta. Ter plekke of afhalen. Geniet op een mooi terras uit het zicht zodra het mooi weer wordt."
        ],
        "es": [
          "Pizza, panini, bruschetta. En el momento o para llevar. Disfrute de una bonita terraza fuera de la vista en cuanto llegue el buen tiempo."
        ]
      },
