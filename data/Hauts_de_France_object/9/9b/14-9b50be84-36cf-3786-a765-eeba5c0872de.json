      "dc:description": {
        "de": [
          "Das Les Étangs des Couartes empfängt Sie 3 km vom Stadtzentrum von Saint-Josse und 6 km vom Meer entfernt.\n3 Teiche und ein Restaurant\nWiedereröffnung im Februar"
        ],
        "en": [
          "Les Étangs des Couartes welcomes you 3 km from Saint-Josse town center and 6 km from the sea.\n3 ponds and a restaurant\nReopening in February"
        ],
        "it": [
          "Les Étangs des Couartes vi accoglie a 3 km dal centro di Saint-Josse e a 6 km dal mare.\n3 laghetti e un ristorante\nRiapertura a febbraio"
        ],
        "fr": [
          "Les Étangs des Couartes vous accueille à 3 km du centre-ville de Saint-Josse et à 6 km de la mer. \n3 étangs et un restaurant\nRéouverture en Février"
        ],
        "nl": [
          "Les Étangs des Couartes verwelkomt je op 3 km van het centrum van Saint-Josse en op 6 km van de zee.\n3 vijvers en een restaurant\nHeropening in februari"
