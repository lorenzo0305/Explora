  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bc7cde7b-db67-3174-945a-1b1ecae43d7b",
      "dc:description": {
        "de": [
          "Bei diesem kreativen Workshop, der für Groß und Klein offen ist, können Sie mit Kohle malen und so eine einzigartige Landschaft erschaffen. Eine originelle Erfahrung, die Sie mit der ganzen Familie teilen können."
        ],
        "en": [
          "This creative workshop is open to all, young and old, and lets you paint with charcoal to create a unique landscape. An original experience to share with the whole family."
        ],
        "it": [
          "Questo laboratorio creativo è aperto a tutti, grandi e piccini, e permette di dipingere con il carboncino per creare un paesaggio unico. Un'esperienza originale da condividere con tutta la famiglia."
        ],
        "fr": [
          "Cet atelier créatif ouvert à tous, petits et grands, vous permettra de peindre avec du charbon pour créer un paysage unique. Une expérience originale à partager en famille."
        ],
        "es": [
          "Este taller creativo está abierto a todos, pequeños y mayores, y te permite pintar con carboncillo para crear un paisaje único. Una experiencia original para compartir con toda la familia."
        ],
        "nl": [
          "Deze creatieve workshop is toegankelijk voor iedereen, jong en oud, en laat je schilderen met houtskool om een uniek landschap te creëren. Een originele ervaring om met het hele gezin te delen."
        ]
      },
