  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4b08ccae-09f0-32cc-b029-89bb314d470b",
      "dc:description": {
        "de": [
          "Eine Indoor-Fläche von 1400 m², die vollständig aus Holz besteht, steht Ihnen zur Verfügung, damit Sie Ihrer Fantasie freien Lauf lassen können. Skateboarding, Inlineskating, BMX und Scootering."
        ],
        "en": [
          "An indoor area of 1400 m² entirely in wood at your disposal to give free rein to your imagination. Skateboarding, rollerblading, BMX and scooter practice."
        ],
        "it": [
          "Una superficie interna di 1400 m² interamente in legno a vostra disposizione per dare libero sfogo alla vostra immaginazione. Skateboard, rollerblade, BMX e monopattino."
        ],
        "fr": [
          "Une surface indoor  de 1400 m² entièrement en bois à votre disposition pour donner libre cours à votre imagination. Pratique du skate, du roller du BMX et de la trotinette."
        ],
        "es": [
          "Una superficie interior de 1400 m² enteramente de madera a su disposición para dar rienda suelta a su imaginación. Montar en monopatín, patines, BMX y patinete."
        ],
        "nl": [
          "Een binnenoppervlakte van 1400 m² geheel in hout uitgevoerd staat tot uw beschikking om uw fantasie de vrije loop te laten. Skateboarden, rolschaatsen, BMX en steppen."
        ]
      },
