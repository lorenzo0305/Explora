  "rdfs:comment": {
    "de": [
      "Nachdem Nolwenn Ferry und Pauline Sonnic in ihrem ersten Stück Tsef Zon(e) den Fest-Noz erforscht hatten, suchten sie nach einer anderen Entität, die die Bevölkerung am Leben hält und sie zueinander finden lässt."
    ],
    "en": [
      "After exploring Fest-Noz in their first play, Tsef Zon(e), Nolwenn Ferry and Pauline Sonnic set out to find out what other entity brings people to life and brings them together."
    ],
    "it": [
      "Dopo aver esplorato il Fest-Noz nella loro prima opera, Tsef Zon(e), Nolwenn Ferry e Pauline Sonnic si sono messe alla ricerca di quali altre entità danno vita alle persone e le uniscono."
    ],
    "fr": [
      "Après avoir exploré le Fest-Noz dans leur première pièce Tsef Zon(e), Nolwenn Ferry et Pauline Sonnic ont cherché quelle autre entité fait vivre la population, la fait se retrouver."
    ],
    "es": [
      "Tras explorar Fest-Noz en su primera obra, Tsef Zon(e), Nolwenn Ferry y Pauline Sonnic se propusieron averiguar qué otra entidad da vida a las personas y las une."
    ],
    "nl": [
      "Na het verkennen van Fest-Noz in hun eerste toneelstuk, Tsef Zon(e), gingen Nolwenn Ferry en Pauline Sonnic op zoek naar welke andere entiteit mensen tot leven brengt en samenbrengt."
    ]
  },
