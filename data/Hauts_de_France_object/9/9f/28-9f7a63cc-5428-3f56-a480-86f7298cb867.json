  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: eine authentische Küche mit einer begrenzten Auswahl an Gerichten und einer begrenzten Anzahl an Gedecken, die es Ihnen ermöglicht, einen schönen Moment mit der Familie oder zu zweit zu verbringen!"
    ],
    "en": [
      "You'll love: authentic cuisine with a limited choice of dishes and a limited number of place settings, making it easy to enjoy with the whole family or just the 2 of you!"
    ],
    "it": [
      "Vi piacerà: cucina autentica con una scelta limitata di piatti e un numero limitato di coperti, per divertirvi con la vostra famiglia o il vostro partner!"
    ],
    "fr": [
      "Vous aimerez : une cuisine vraie avec un choix limité de plats, un nombre de couverts limité permettant de passer un bon moment en famille ou à 2!"
    ],
    "es": [
      "Te encantará: cocina auténtica con una selección limitada de platos y un número limitado de cubiertos, ¡para que puedas pasarlo en grande con tu familia o tu pareja!"
    ],
    "nl": [
      "Je zult ervan houden: authentieke keuken met een beperkte keuze aan gerechten en een beperkt aantal couverts, zodat je een geweldige tijd kunt hebben met je gezin of je partner!"
    ]
  },
