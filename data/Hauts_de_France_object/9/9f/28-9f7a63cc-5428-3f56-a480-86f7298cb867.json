  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/59d6ede9-b917-3aaf-b189-07b94ab214ea",
      "dc:description": {
        "de": [
          "Landgasthof im Authie-Tal in der Nähe der Gärten und der Abtei von Valloires. Klassische und schmackhafte Küche. Ein kleiner, geselliger und diskreter Saal."
        ],
        "en": [
          "Country inn located in the Authie Valley near the gardens and the Abbey of Valloires. Classic and tasty cuisine. A small, friendly and discreet room."
        ],
        "it": [
          "Locanda di campagna situata nella valle dell'Authie, vicino ai giardini e all'abbazia di Valloires. Cucina classica e gustosa. Un locale piccolo, accogliente e discreto."
        ],
        "fr": [
          "Auberge de campagne située dans la Vallée d'Authie à proximité des jardins et de l'Abbaye de Valloires. Cuisine classique et gouteuse. Une petite salle conviviale et discrète."
        ],
        "es": [
          "Posada rural situada en el valle de Authie, cerca de los jardines y de la abadía de Valloires. Cocina clásica y sabrosa. Una sala pequeña, acogedora y discreta."
        ],
        "nl": [
          "Landelijke herberg gelegen in de Authie-vallei nabij de tuinen en de abdij van Valloires. Klassieke en smakelijke keuken. Een kleine, vriendelijke en discrete kamer."
        ]
      },
