  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f39c3cd2-3871-3c04-a4ba-99fbebf436dd",
      "dc:description": {
        "de": [
          "Das Familienrestaurant Le petit Mousse in Sainte Cécile befindet sich in einer außergewöhnlichen Umgebung.\nhier finden Sie Gourmetgerichte, frische Aromen und eine entspannte Atmosphäre."
        ],
        "en": [
          "Family restaurant Le petit Mousse in Sainte Cécile, in an exceptional setting.\nenjoy gourmet dishes, fresh flavors and a relaxed atmosphere."
        ],
        "it": [
          "Le petit Mousse è un ristorante familiare situato a Sainte Cécile, in un ambiente eccezionale.\ngodetevi piatti gourmet, sapori freschi e un'atmosfera rilassata."
        ],
        "fr": [
          "Restaurant familiale Le petit Mousse situé à Sainte Cécile, est situé dans un cadre exceptionnel.\nretrouvez des plats gourmand, des saveurs fraîches et ambiance décontractée."
        ],
        "nl": [
          "Le petit Mousse is een familierestaurant in Sainte Cécile, in een uitzonderlijke omgeving.\ngeniet van gastronomische gerechten, verse smaken en een ontspannen sfeer."
        ],
        "es": [
          "Le petit Mousse es un restaurante familiar situado en Sainte Cécile, en un marco excepcional.\ndisfrute de platos gourmet, sabores frescos y un ambiente relajado."
        ]
      },
