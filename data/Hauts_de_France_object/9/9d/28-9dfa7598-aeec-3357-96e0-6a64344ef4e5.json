  "rdfs:comment": {
    "de": [
      "Der Parc du Cam ist der ideale Ort für einen Spaziergang in einer Grünanlage im Stadtzentrum von Péronne. Der dort gelegene Étang du Cam ist perfekt für einen entspannten Spaziergang."
    ],
    "en": [
      "The Parc du Cam is the ideal place for a green stroll in the heart of downtown Péronne. The Etang du Cam is perfect for a leisurely stroll."
    ],
    "it": [
      "Il Parc du Cam è il luogo ideale per una passeggiata in un ambiente verde proprio nel centro di Péronne. L'Etang du Cam è perfetto per una piacevole passeggiata."
    ],
    "fr": [
      "Le parc du Cam est le lieu idéal pour une balade dans un lieu vert localisé en plein centre-ville de Péronne. L'étang du Cam, qui s'y trouve est parfait pour une balade nonchalante."
    ],
    "nl": [
      "Het Parc du Cam is de ideale plek voor een wandeling in een groene omgeving midden in het centrum van Péronne. Het Etang du Cam is perfect voor een ontspannen wandeling."
    ],
    "es": [
      "El Parc du Cam es el lugar ideal para pasear en un entorno verde en pleno centro de Péronne. El Etang du Cam es perfecto para pasear tranquilamente."
    ]
  },
