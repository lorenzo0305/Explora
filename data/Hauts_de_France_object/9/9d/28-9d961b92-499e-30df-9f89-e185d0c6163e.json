  "rdfs:comment": {
    "de": [
      "Ihr werdet es mögen: die hausgemachte Küche, die ausschließlich auf frischen und saisonalen Produkten basiert,wobei lokale Produzenten und Handwerker bevorzugt werden."
    ],
    "en": [
      "You'll love our home cooking, based exclusively on fresh, seasonal produce, with a focus on local producers and craftsmen."
    ],
    "it": [
      "Vi piacerà la cucina casalinga, che utilizza solo i prodotti più freschi di stagione, con particolare attenzione ai produttori e agli artigiani locali."
    ],
    "fr": [
      "Vous aimerez : la cuisine maison, uniquement à base de produits frais et de saison,privilégiant les producteurs et artisans locaux."
    ],
    "es": [
      "Le encantará la cocina casera, elaborada con los productos más frescos de temporada y centrada en los productores y artesanos locales."
    ],
    "nl": [
      "Je zult genieten van de huiselijke keuken, waarbij alleen de meest verse seizoensproducten worden gebruikt en de nadruk ligt op lokale producenten en ambachtslieden."
    ]
  },
