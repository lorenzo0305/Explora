  "rdfs:comment": {
    "de": [
      "Restaurant am Strand mit traditioneller Küche, das zwei schöne Terrassen auf dem Deich von Malo Les Bains bietet. Alle Gerichte sind hausgemacht und werden mit frischen Produkten aus der Region zubereitet."
    ],
    "en": [
      "Restaurant on the beach with traditional cuisine offering two beautiful terraces on the sea wall of Malo Les Bains. All the dishes are home-made and elaborated with fresh products and using the maximum of the local circuits."
    ],
    "it": [
      "Ristorante sulla spiaggia con cucina tradizionale che offre due belle terrazze sulla spiaggia di Malo Les Bains. Tutti i piatti sono fatti in casa e preparati con prodotti freschi e utilizzando il più possibile canali locali."
    ],
    "fr": [
      "Restaurant de bord de plage à la cuisine traditionnelle offrant deux belles terrasses sur la Digue de Malo Les Bains. Tous les plats sont faits Maison et élaborés à base de produits frais et utilisant au maximum les circuits locaux."
    ],
    "es": [
      "Restaurante junto a la playa con cocina tradicional que ofrece dos hermosas terrazas en la playa de Malo Les Bains. Todos los platos son caseros y se preparan con productos frescos y utilizando canales locales en la medida de lo posible."
    ],
    "nl": [
      "Restaurant aan het strand met een traditionele keuken en twee prachtige terrassen aan het strand van Malo Les Bains. Alle gerechten zijn huisgemaakt en bereid met verse producten en zoveel mogelijk met gebruikmaking van lokale kanalen."
    ]
  },
