  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dac0aa1a-0335-3a81-ab0e-54982b3fc252",
      "dc:description": {
        "de": [
          "Das Denkmal aus belgischem Granit stammt aus dem Jahr 1922 und besteht aus einem Obelisken auf einem Podest, der von einer Büste eines Poilus mit Fahne aus Gusseisen gekrönt wird. Es wurde von dem Marmorhändler Dechamps aus Montreuil entworfen."
        ],
        "en": [
          "Dated 1922, the monument, in Belgian granite, is composed of an obelisk on a pedestal, topped by a bust of a poilu with a flag, in cast iron. It was made by the marble maker Dechamps of Montreuil."
        ],
        "it": [
          "Datato 1922, il monumento, in granito belga, è composto da un obelisco su un piedistallo, sormontato da un busto di poilu con bandiera, in ghisa. È stato progettato dal marmista Dechamps di Montreuil."
        ],
        "fr": [
          "Daté de 1922, le monument, en granit belge est composé d'un obélisque sur un piédestal, le tout surmonté d'un buste de poilu avec drapeau, en fer de fonte. Il a été concç par le marbrier Dechamps de Montreuil."
        ],
        "nl": [
          "Het monument in Belgisch graniet, gedateerd 1922, bestaat uit een obelisk op een sokkel, met daarop een buste van een poilu met een vlag, in gietijzer. Het werd ontworpen door de marmerfabrikant Dechamps uit Montreuil."
        ],
        "es": [
          "Fechado en 1922, el monumento, de granito belga, está compuesto por un obelisco sobre un pedestal, rematado por un busto de un poilu con una bandera, de hierro fundido. Fue diseñado por el marmolista Dechamps de Montreuil."
        ]
      },
      "@type": [
        "Description"
      ],
