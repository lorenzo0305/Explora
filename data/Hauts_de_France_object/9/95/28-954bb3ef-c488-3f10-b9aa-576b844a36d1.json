  "rdfs:comment": {
    "de": [
      "Die erste Kapelle Saint-Roch wurde 1545 erbaut; sie war ein Nebengebäude des Krankenhauses und des Friedhofs für Pestkranke."
    ],
    "en": [
      "The first Saint-Roch chapel was built in 1545 as an annex to the hospital and the plague cemetery."
    ],
    "it": [
      "La prima cappella di Saint-Roch fu costruita nel 1545 come annesso all'ospedale e al cimitero degli appestati."
    ],
    "fr": [
      "La première chapelle Saint-Roch est construite en 1545 ; c'était une annexe de l'hôpital et du cimetière des pestiférés."
    ],
    "es": [
      "La primera capilla de Saint-Roch se construyó en 1545 como anexo al hospital y al cementerio de la peste."
    ],
    "nl": [
      "De eerste kapel van Saint-Roch werd in 1545 gebouwd als bijgebouw bij het ziekenhuis en het pestkerkhof."
    ]
  },
