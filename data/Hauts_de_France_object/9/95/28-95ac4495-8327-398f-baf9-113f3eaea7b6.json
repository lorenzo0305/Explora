  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt an der RN 31 im Stadtzentrum von Braine gegenüber einem großen Parkplatz, in der Nähe des Rathauses, der Kirche Saint-Yved und des Fachwerkhauses. Gemütliches Restaurant mit Spezialitäten wie heißen Kartoffeln, traditionellen Gerichten, Tagesgerichten und Pizzas (vor Ort oder zum Mitnehmen). Mittagsformel mit All-you-can-eat-Buffet."
    ],
    "en": [
      "Located on the RN 31 in the center of Braine, opposite a large parking lot, near the town hall, the Saint-Yved church and the Maison à Colombages. Friendly restaurant specializing in Patates Chaudes, traditional dishes, Plat du Jour and pizzas (eat-in or takeaway). All-you-can-eat buffet at lunchtime."
    ],
    "it": [
      "Situato sulla RN 31 nel centro di Braine, di fronte a un ampio parcheggio, vicino al municipio, alla chiesa Saint-Yved e alla Maison à Colombages. Ristorante accogliente specializzato in patate calde, piatti tradizionali, piatti del giorno e pizze (da mangiare o da portare via). Pranzo a buffet a volontà."
    ],
    "fr": [
      "Situé sur la RN 31 au centre ville de Braine face à un grand parking, à proximité de la Mairie, de l'église Saint-Yved et de la Maison à Colombages. Restaurant convivial avec spécialité de Patates Chaudes, plats traditionnels, Plat du Jour  et pizzas (sur place ou à emporter. Formule du midi avec buffet à volonté."
    ],
    "es": [
      "Situado en la RN 31, en el centro de Braine, frente a un gran aparcamiento, cerca del Ayuntamiento, de la iglesia de Saint-Yved y de la Maison à Colombages. Restaurante acogedor especializado en patatas calientes, platos tradicionales, platos del día y pizzas (para comer o llevar). Almuerzo buffet libre."
    ],
    "nl": [
      "Gelegen aan de RN 31 in het centrum van Braine tegenover een grote parkeerplaats, dicht bij het stadhuis, de Saint-Yved kerk en het Maison à Colombages. Gezellig restaurant gespecialiseerd in warme aardappelen, traditionele gerechten, dagschotels en pizza's (ter plaatse te eten of om mee te nemen). All-you-can-eat lunchbuffet."
    ]
  },
