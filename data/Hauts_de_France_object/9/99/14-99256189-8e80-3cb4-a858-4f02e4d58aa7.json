  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c339aeab-6ec7-3106-bcdf-60377a921958",
      "dc:description": {
        "de": [
          "Von Tom Fischer, Doktorand, Laboratoire d'Étude sur les Monothéismes, CNRS (Nationales Zentrum für wissenschaftliche Forschung)\nDie westliche Alchemie verspricht ihren Anhängern Reichtum und ein langes Leben und hat einige der wildesten Träume der Menschheit genährt. Doch was war sie wirklich?"
        ],
        "en": [
          "By Tom Fischer, PhD student, Laboratoire d?Étude sur les Monothéismes, CNRS\nPromising its followers wealth and longevity, Western alchemy has nurtured some of mankind?s wildest dreams. But what was it really?"
        ],
        "it": [
          "Di Tom Fischer, dottorando, Laboratoire d'Étude sur les Monothéismes, CNRS\nPromettendo ai suoi adepti ricchezza e longevità, l'alchimia occidentale ha alimentato alcuni dei sogni più sfrenati dell'umanità. Ma cos'era veramente?"
        ],
        "fr": [
          "Par Tom Fischer, doctorant, Laboratoire d’Étude sur les Monothéismes, CNRS\nPromettant à ses adeptes richesses et longévité, l’alchimie occidentale a nourri certains des rêves les plus fous de l’Humanité. Mais que fût-t-elle vraiment ?"
        ],
        "es": [
          "Por Tom Fischer, estudiante de doctorado, Laboratoire d'Étude sur les Monothéismes, CNRS\nPrometiendo a sus seguidores riqueza y longevidad, la alquimia occidental ha alimentado algunos de los sueños más salvajes de la humanidad. Pero, ¿qué era en realidad?"
        ],
        "nl": [
          "Door Tom Fischer, promovendus, Laboratoire d'Étude sur les Monothéismes, CNRS\nDe westerse alchemie beloofde haar volgelingen rijkdom en een lang leven en heeft een aantal van de wildste dromen van de mensheid gevoed. Maar wat was het echt?"
        ]
      },
      "@type": [
        "Description"
      ],
