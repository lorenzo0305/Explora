  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c608b6d3-124f-3c48-9a50-faa9a19d39a3",
      "dc:description": {
        "de": [
          "Die 1704 erbaute Kirche wurde zehn Jahre später geweiht. Sie zeichnet sich durch die schöne graue Farbe ihres Daches, ihre Fassaden aus Kreide und ihren Glockenturm aus Fachwerk aus."
        ],
        "en": [
          "Built in 1704, it was consecrated 10 years later. Its distinctive features include a beautiful grey roof, chalk facades and timber-framed bell tower."
        ],
        "it": [
          "Costruita nel 1704, fu consacrata 10 anni dopo. Si distingue per il bel colore grigio del tetto, le facciate in gesso e il campanile a graticcio."
        ],
        "fr": [
          "Construite en 1704, elle est consacrée 10 ans plus tard. Elle se distingue par la belle couleur grise de son toit, ses façades en craie et son clocher en charpente."
        ],
        "nl": [
          "Het werd gebouwd in 1704 en 10 jaar later ingewijd. Het valt op door de mooie grijze kleur van het dak, de krijtgevels en de klokkentoren in vakwerk."
        ],
        "es": [
          "Construida en 1704, fue consagrada 10 años más tarde. Se distingue por el bello color gris de su tejado, sus fachadas de tiza y su campanario con entramado de madera."
        ]
      },
      "@type": [
        "Description"
