  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5256d634-0a70-3b63-b4e2-05fcda2ac75e",
      "dc:description": {
        "de": [
          "JP Marée ist ein Unternehmen, das sich auf den Maschenhandel und den Vertrieb von frischem Fisch und Meeresfrüchten spezialisiert hat. Es garantiert Qualität, Frische und lokales Know-how in Boulogne-sur-Mer. Es besteht die Möglichkeit, telefonisch zu bestellen und die Bestellung vor Ort abzuholen."
        ],
        "en": [
          "JP Marée specializes in the trade and distribution of fresh fish and seafood, guaranteeing quality, freshness and local know-how in Boulogne-sur-Mer. Orders can be placed by telephone or picked up on site."
        ],
        "it": [
          "JP Marée è specializzato nella vendita e distribuzione di pesce e frutti di mare freschi, garantendo qualità, freschezza e know-how locale a Boulogne-sur-Mer. È possibile ordinare per telefono e ritirare l'ordine in loco."
        ],
        "fr": [
          "JP Marée est une entreprise spécialisée dans le mareyage et la distribution de poissons et fruits de mer frais, garantissant qualité, fraîcheur et savoir-faire local à Boulogne-sur-Mer. Possibilité de commander par téléphone et de venir retirer sa commande sur place."
        ],
        "nl": [
          "JP Marée is gespecialiseerd in de handel en distributie van verse vis en zeevruchten en staat garant voor kwaliteit, versheid en lokale knowhow in Boulogne-sur-Mer. Je kunt telefonisch bestellen en je bestelling ter plaatse afhalen."
        ],
        "es": [
          "JP Marée es una empresa especializada en la venta y distribución de pescado y marisco fresco, garantía de calidad, frescura y saber hacer local en Boulogne-sur-Mer. Puede hacer su pedido por teléfono y recogerlo in situ."
        ]
      },
      "@type": [
        "Description"
      ],
