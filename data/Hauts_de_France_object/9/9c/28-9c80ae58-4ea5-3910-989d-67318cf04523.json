  "rdfs:comment": {
    "de": [
      "Anbau von Bio-Gemüse und Bio-Beerenobst. Automat 7 Tage die Woche im Hof der Farm: Erdbeeren, Biogemüse der Saison.\nHofladen und Online-Shop."
    ],
    "en": [
      "Production of organic vegetables and red fruits. Vending machine 7 days a week in the farmyard: strawberries, organic vegetables in season.\nStore at the farm and online store."
    ],
    "it": [
      "Produzione di ortaggi e frutti rossi biologici. Distributore automatico 7 giorni su 7 nell'aia: fragole, verdure biologiche di stagione.\nNegozio in fattoria e negozio online."
    ],
    "fr": [
      "Production de légumes et de fruits rouges Bio. Distributeur automatique 7j/7 dans la cour de la ferme: fraises, légumes de saison bio.\nMagasin à la ferme et Boutique en ligne."
    ],
    "nl": [
      "Productie van biologische groenten en rood fruit. Verkoopautomaat 7 dagen per week op het erf: aardbeien, biologische seizoensgroenten.\nWinkel op de boerderij en online winkel."
    ],
    "es": [
      "Producción de verduras y frutos rojos ecológicos. Máquina expendedora 7 días a la semana en el corral: fresas, verduras ecológicas de temporada.\nTienda en la granja y tienda en línea."
    ]
  },
