  "rdfs:comment": {
    "de": [
      "In der Zac du Mont Renaud in Noyon empfängt Sie Sensations Bowling von Dienstag bis Sonntag. Ob mit der Familie oder mit Freunden, für einen Moment der Entspannung bietet Ihnen Sensations Bowling 8 Bowlingbahnen, einen Spiel- und Billardbereich, aber auch eine Lounge-Bar. Sie können auch Familien- oder Freundschaftsanlässe organisieren."
    ],
    "en": [
      "Zac du Mont Renaud in Noyon, Sensations Bowling welcomes you from Tuesday to Sunday. With family or friends, for a moment of relaxation, Sensations Bowling offers you 8 bowling lanes, a games and billiards area as well as a lounge bar. You can also organize family or friendly events."
    ],
    "it": [
      "Il Sensations Bowling vi accoglie dal martedì alla domenica. Con la famiglia o gli amici, per un momento di relax, il Sensations Bowling vi offre 8 piste da bowling, un'area giochi e biliardo e un lounge bar. È inoltre possibile organizzare eventi familiari o amichevoli."
    ],
    "fr": [
      "Zac du Mont Renaud à Noyon, Sensations Bowling vous accueille du mardi au dimanche. En famille ou entre amis, pour un moment de détente, Sensations Bowling vous propose 8 pistes de bowling, un espace de jeux et de billards mais aussi un bar Lounge. Vous pouvez également organiser des événements familiaux ou amicaux."
    ],
    "nl": [
      "Sensations Bowling verwelkomt u van dinsdag tot en met zondag. Voor een ontspannen moment met familie of vrienden biedt Sensations Bowling 8 bowlingbanen, een speel- en biljartruimte en een loungebar. U kunt ook familie- of vriendschappelijke evenementen organiseren."
    ],
    "es": [
      "La bolera Sensations le da la bienvenida de martes a domingo. En familia o con amigos, para un momento de relajación, Sensations Bowling le ofrece 8 pistas de bolos, una zona de juegos y billar, así como un bar lounge. También puede organizar eventos familiares o amistosos."
    ]
  },
