  "rdfs:comment": {
    "de": [
      "Die 2019 gegründete Compagnie Chamane baut ihre Identität um das Theater herum auf, das sie zeitgenössisch, populär und zugänglich machen möchte, sowie um die neue Magie als aktuelle Sprache und Schwerpunkt der künstlerischen Forschung."
    ],
    "en": [
      "Founded in 2019, the Compagnie Chamane has built its identity around contemporary, popular and accessible theater, and new magic as a current language and a focus for artistic research."
    ],
    "it": [
      "Fondata nel 2019, la Compagnie Chamane sta costruendo la propria identità intorno al teatro, che vuole essere contemporaneo, popolare e accessibile, e alla nuova magia, come linguaggio attuale e fulcro della ricerca artistica."
    ],
    "fr": [
      "Fondée en 2019, la Compagnie Chamane construit son identité autour du théâtre, qu’elle souhaite contemporain, populaire et accessible, et de la magie nouvelle, comme langage actuel et axe de recherche artistique."
    ],
    "es": [
      "Fundada en 2019, la Compagnie Chamane construye su identidad en torno al teatro, que quiere contemporáneo, popular y accesible, y la nueva magia, como lenguaje actual y foco de investigación artística."
    ],
    "nl": [
      "De Compagnie Chamane werd opgericht in 2019 en bouwt aan haar identiteit rond theater, dat ze eigentijds, populair en toegankelijk wil maken, en nieuwe magie, als een actuele taal en een focus voor artistiek onderzoek."
    ]
  },
  "rdfs:label": {
