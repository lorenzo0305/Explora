  "rdfs:comment": {
    "de": [
      "Im Herzen von Calais, nur wenige Schritte von der belebten Innenstadt entfernt, befindet sich ein Restaurant, das die Seele der alten Pariser Bistros bewahrt hat: \"Au Vieux Fourneau\"."
    ],
    "en": [
      "In the heart of Calais, just a stone's throw from the bustling city center, nestles a restaurant that has retained the soul of the Parisian bistros of yesteryear: \"Au Vieux Fourneau\"."
    ],
    "it": [
      "Nel cuore di Calais, a due passi dal trambusto del centro, si trova un ristorante che ha conservato l'anima dei bistrot parigini di un tempo: \"Au Vieux Fourneau\"."
    ],
    "fr": [
      "Au cœur de Calais, à quelques pas de l'animation du centre-ville, se niche un restaurant qui a su conserver l'âme des bistrots parisiens d'antan : « Au Vieux Fourneau »."
    ],
    "nl": [
      "In het hart van Calais, op een steenworp afstand van de drukte van het stadscentrum, ligt een restaurant dat de ziel van de Parijse bistro's van weleer heeft behouden: \"Au Vieux Fourneau\"."
    ],
    "es": [
      "En el corazón de Calais, a dos pasos del bullicio del centro de la ciudad, se encuentra un restaurante que conserva el alma de los bistrós parisinos de antaño: \"Au Vieux Fourneau\"."
    ]
  },
