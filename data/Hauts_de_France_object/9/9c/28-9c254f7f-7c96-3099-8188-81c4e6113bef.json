      "dc:description": {
        "de": [
          "Am Ufer der Epte gelegener Picknickplatz für ein ruhiges, angenehmes und erholsames Picknick.\nVerfügbare Dienstleistungen: Picknicktische, Mülleimer"
        ],
        "en": [
          "Picnic area located at the edge of the Epte for a calm, pleasant and restful picnic.\nServices available: picnic tables, garbage can"
        ],
        "it": [
          "Area picnic situata sulle rive dell'Epte per un picnic tranquillo, piacevole e rilassante.\nServizi disponibili: tavoli da picnic, cestino per i rifiuti"
        ],
        "fr": [
          "Aire de pique-nique située au bord de l'Epte pour un pique-nique calme, agréable et reposant.\nServices disponibles :  tables de pique-nique, poubelle"
        ],
        "es": [
          "Área de picnic situada a orillas del Epte para un picnic tranquilo, agradable y relajante.\nServicios disponibles: mesas de picnic, papelera"
        ],
        "nl": [
          "Picknickplaats gelegen aan de oevers van de Epte voor een rustige, aangename en ontspannende picknick.\nBeschikbare diensten: picknicktafels, vuilnisbak"
        ]
