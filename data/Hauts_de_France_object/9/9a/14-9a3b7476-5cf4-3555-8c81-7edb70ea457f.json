  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/940b1b37-0eba-3c50-a744-ef2d1173dd3b",
      "dc:description": {
        "de": [
          "Die Association des Pêcheurs à la Ligne du Boulonnais untersteht dem Departementsverband Fédération du Pas-de-Calais pour la Pêche et la Protection du Milieu Aquatique (Verband des Departements Pas-de-Calais für die Fischerei und den Schutz der aquatischen Umwelt). Für Informationen über die Ausübung des Angelns in den Wasserläufen."
        ],
        "en": [
          "The Boulonnais Angling Association is a member of the Pas-de-Calais Federation for Fishing and Protection of the Aquatic Environment. For information on fishing in rivers and streams."
        ],
        "it": [
          "L'Associazione di pesca sportiva del Boulonnais è membro della Federazione della pesca e della protezione dell'ambiente acquatico del Pas-de-Calais. Per tutte le informazioni sulla pesca nei fiumi."
        ],
        "fr": [
          "L'association des Pêcheurs à la Ligne du Boulonnais dépend de la fédération départementale Fédération du Pas-de-Calais pour la Pêche et la Protection du Milieu Aquatique. Pour toute information concernant la pratique de la pêche dans les cours d'eau."
        ],
        "es": [
          "La Asociación de Pesca con Caña del Boulonnais es miembro de la Federación de Pesca y Protección del Medio Acuático del Pas-de-Calais. Para toda la información sobre la pesca en ríos."
        ],
        "nl": [
          "De hengelsportvereniging van Boulonnais is lid van de Fédération Pas-de-Calais pour la Pêche et la Protection de l'Environnement aquatique. Voor alle informatie over vissen in rivieren."
        ]
      },
      "@type": [
        "Description"
      ],
