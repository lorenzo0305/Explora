  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f5456196-0c7f-3598-9af2-42bd8ffc6a5c",
      "dc:description": {
        "de": [
          "Strandsegeln,\nVon 9.00 bis 11.00 Uhr an der Freizeitanlage,\nFür Kinder zwischen 10 und 14 Jahren.\nAngemessene Kleidung und Turnschuhe mitbringen.\nbegrenzte Anzahl von Plätzen.\nKostenlos,\nnach Anmeldung"
        ],
        "en": [
          "Sand yachting,\n9am to 11am at the leisure center,\nFor children aged 10 to 14.\nPlease bring suitable clothing and sneakers.\nplaces limited.\nFree admission,\non registration"
        ],
        "it": [
          "Sand yachting,\nDalle 9.00 alle 11.00 presso il centro ricreativo,\nPer bambini dai 10 ai 14 anni.\nPortare abbigliamento adatto e scarpe da ginnastica.\ni posti sono limitati.\nIngresso libero,\nsu iscrizione"
        ],
        "fr": [
          "Char à voile, \nDe 9h à 11h à la base de loisirs,\nPour les enfants de 10 à 14 ans.\nPrévoir une tenue adaptée et des baskets. \nplaces limitées.\nGratuit, \nsur inscription"
        ],
        "es": [
          "Vela de arena,\nDe 9h a 11h en el centro de ocio,\nPara niños de 10 a 14 años.\nTraer ropa adecuada y zapatillas de deporte.\nplazas limitadas.\nEntrada gratuita,\nprevia inscripción"
        ],
        "nl": [
          "Strandzeilen,\nVan 9 tot 11 uur in het recreatiecentrum,\nVoor kinderen van 10 tot 14 jaar.\nBreng geschikte kleding en sportschoenen mee.\nplaatsen zijn beperkt.\nGratis toegang,\nop inschrijving"
        ]
      },
