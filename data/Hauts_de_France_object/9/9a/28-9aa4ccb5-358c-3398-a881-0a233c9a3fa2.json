  "rdfs:comment": {
    "de": [
      "Der 20 ha große Park besteht aus Rasen und Blumen, Teich und Wald, Gewächshäusern und einem Waschhaus. Wunderschöne 120 m lange Gewächshäuser, die vollständig mit Blumen geschmückt sind. Der Park ist seit 1944 im Zusatzinventar der historischen Monumente eingetragen."
    ],
    "en": [
      "The 20 ha park consists of lawn and flowers, pond and woods, greenhouses and a wash-house. Magnificent 120 m long greenhouses with flowers. The park has been listed in the supplementary inventory of Historic Monuments since 1944."
    ],
    "it": [
      "Il parco di 20 ettari è composto da prati e fiori, laghetti e boschi, serre e un lavatoio. Magnifiche serre di 120 m di lunghezza con fiori. Il parco è stato inserito nell'inventario supplementare dei monumenti storici dal 1944."
    ],
    "fr": [
      "Le parc de 20 ha se compose de pelouse et fleurs, d'étang et de bois, de serres et d'un lavoir. Magnifique serres de 120 m de long entièrement fleuries. Le parc est inscrit à l'inventaire supplémentaire des Monuments historiques depuis 1944."
    ],
    "nl": [
      "Het park van 20 ha bestaat uit gazons en bloemen, vijver en bos, kassen en een wasplaats. Prachtige 120 m lange kassen met bloemen. Het park is sinds 1944 opgenomen in de aanvullende inventaris van historische monumenten."
    ],
    "es": [
      "El parque de 20 hectáreas consta de césped y flores, estanque y bosques, invernaderos y un lavadero. Magníficos invernaderos de 120 m de largo con flores. El parque está incluido en el inventario suplementario de monumentos históricos desde 1944."
    ]
  },
