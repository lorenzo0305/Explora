  "rdfs:comment": {
    "de": [
      "Im Herzen eines friedlichen Dorfes auf dem Land gelegen, in einer ehemaligen Pferderaststätte aus dem 17. Jahrhundert erbaut. Jahrhundert. Raffinierte und ausgesuchte Küche mit regionalen Produkten, die auf den neuesten Stand gebracht werden, und den süßen Aromen, die uns die französische Gastronomie zu bieten hat."
    ],
    "en": [
      "Situated in the heart of a peaceful village in the countryside, built in an old 17th-century coaching inn. Sophisticated cuisine using local produce and the sweet flavors of French gastronomy."
    ],
    "it": [
      "Situato nel cuore di un tranquillo villaggio, in piena campagna, ricavato da un'antica locanda del XVII secolo. Una cucina raffinata e sofisticata che utilizza prodotti locali aggiornati e i dolci sapori che la gastronomia francese sa offrire."
    ],
    "fr": [
      "Située au coeur d'un paisible village, en pleine campagne, bâtie dans un ancien relais à chevaux du XVIIème siècle. Cuisine raffinée et recherchée avec les produits du terroir mis au goût du jour et les douces saveurs que peut nous offrir la gastronomie française."
    ],
    "es": [
      "Situado en el corazón de un pueblo tranquilo, en plena campiña, construido en una antigua posada del siglo XVII. Cocina refinada y sofisticada con productos locales actualizados y los dulces sabores que ofrece la gastronomía francesa."
    ],
    "nl": [
      "Gelegen in het hart van een rustig dorp, midden op het platteland, in een voormalige 17e-eeuwse herberg. Verfijnde, verfijnde keuken met up-to-date streekproducten en de zoete smaken die de Franse gastronomie te bieden heeft."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge du Bois Doré"
    ]
  },
