      "dc:description": {
        "de": [
          "Ich habe einen Berufsausweis als Sportpädagoge und biete Sportkurse zu Hause oder im Freien an, für Einzelpersonen oder Gruppen (Fitness, Fitness, Muskelaufbau, etc.)."
        ],
        "en": [
          "Holder of a professional sports educator's card, I offer sport lessons at home or outside, for individuals or groups (fitness, muscle strengthening, etc)."
        ],
        "it": [
          "Ho il tesserino di educatore sportivo professionista e offro lezioni di sport a domicilio o all'esterno, per singoli o gruppi (fitness, ginnastica, potenziamento muscolare, ecc.)."
        ],
        "fr": [
          "Titulaire de la carte professionnelle d'éducateur sportif, je propose des cours de sport à domicile ou en extérieur, pour individuels ou en groupe (fitness, remise en forme, renforcement musculaire, etc)."
        ],
        "es": [
          "Tengo el carné de educador deportivo profesional y ofrezco clases de deporte a domicilio o al aire libre, para particulares o grupos (fitness, acondicionamiento físico, fortalecimiento muscular, etc.)."
        ],
        "nl": [
          "Ik heb een professionele sportlerarenkaart en geef sportlessen aan huis of buiten, voor individuen of groepen (fitness, conditie, spierversterking, enz.)."
        ]
      },
