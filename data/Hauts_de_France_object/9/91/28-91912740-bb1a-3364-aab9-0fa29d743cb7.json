  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f459b15a-9ad3-3bc1-80dc-3a62d83ba71a",
      "dc:description": {
        "de": [
          "In einer gemütlichen Atmosphäre am Kamin bietet Ihnen der Chefkoch sein saisonales Schiefertafelmenü an, eine traditionelle, hausgemachte Küche, die täglich erneuert wird."
        ],
        "en": [
          "In a warm atmosphere near the fireplace, the chef offers you his seasonal menu on the slate, a traditional home-made cuisine, renewed daily."
        ],
        "it": [
          "In una calda atmosfera accanto al camino, lo chef vi propone un menu stagionale sulla lavagna, una cucina tradizionale e casalinga, rinnovata ogni giorno."
        ],
        "fr": [
          "Dans une ambiance chaleureuse près de la cheminée, le chef vous propose son menu de saison à l'ardoise, une cuisine traditionnelle, faite maison, renouvelée quotidiennement."
        ],
        "nl": [
          "In een warme sfeer bij de open haard biedt de chef u een seizoensgebonden menu op de lei, een traditionele, huisgemaakte keuken, dagelijks vernieuwd."
        ],
        "es": [
          "En un ambiente cálido junto a la chimenea, el chef le ofrece un menú de temporada en la pizarra, una cocina tradicional y casera, renovada diariamente."
        ]
      },
