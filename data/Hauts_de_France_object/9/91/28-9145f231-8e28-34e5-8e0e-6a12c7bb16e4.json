  "rdfs:comment": {
    "de": [
      "Sie werden in einer gedämpften Atmosphäre und einem gemütlichen Rahmen empfangen. Eine raffinierte Küche wird Ihnen vom Chefkoch angeboten."
    ],
    "en": [
      "You will be welcomed in a cosy atmosphere and a warm setting. A refined cuisine is offered by the chef."
    ],
    "it": [
      "Sarete accolti in un'atmosfera accogliente e in un ambiente caldo. Lo chef propone una cucina raffinata."
    ],
    "fr": [
      "Vous serez accueillis dans une ambiance feutrée et un cadre chaleureux. Une cuisine raffinée vous est proposée par le chef."
    ],
    "nl": [
      "U wordt ontvangen in een gezellige sfeer en een warm kader. De chef biedt u een verfijnde keuken."
    ],
    "es": [
      "Le acogerán en un ambiente acogedor y un entorno cálido. El chef ofrece una cocina refinada."
    ]
  },
