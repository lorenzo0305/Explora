  "rdfs:comment": {
    "de": [
      "Die Kirche stammt zum Teil aus dem 17. Jahrhundert, wie die Jahreszahl 1634 auf dem mit der Fassade verbundenen Torbogen zeigt."
    ],
    "en": [
      "Part of the church dates back to the 17th century, as indicated by the 1634 date on the arcade attached to the façade."
    ],
    "it": [
      "Una parte della chiesa risale al XVII secolo, come testimonia la data 1634 sul porticato annesso alla facciata."
    ],
    "fr": [
      "L'église date en partie du XVIIème siècle, comme l'indique le millésime 1634, présent sur l'arcade reliée à la façade."
    ],
    "es": [
      "Parte de la iglesia data del siglo XVII, como demuestra la fecha de 1634 que figura en la arcada adosada a la fachada."
    ],
    "nl": [
      "Een deel van de kerk dateert uit de 17e eeuw, zoals te zien is aan het jaartal 1634 op de arcade aan de gevel."
    ]
  },
