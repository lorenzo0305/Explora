  "rdfs:comment": {
    "de": [
      "Eine Öko-Weide? Eine neue Modeidee oder eine alte Tradition, die wiederbelebt wird? Ich schlage vor, dass Sie mich begleiten, um diese Bewirtschaftungsmethode und vor allem die im Park lebenden Tiere kennenzulernen."
    ],
    "en": [
      "Eco-grazing? A trendy new idea or an old tradition revived? I invite you to join me in discovering this management method, and above all the animals present at the Park."
    ],
    "it": [
      "Eco-pasticceria? Si tratta di una nuova idea di tendenza o di una vecchia tradizione che viene ripresa? Venite con me a scoprire di più su questo metodo di gestione e soprattutto sugli animali che vivono nel Parco."
    ],
    "fr": [
      "Un éco-pâturage ? Une nouvelle idée à la mode ou une vieille tradition remise au goût du jour ? Je vous propose de m’accompagner pour découvrir cette méthode de gestion, et surtout les animaux présents au Parc."
    ],
    "es": [
      "¿Pastoreo ecológico? ¿Es una nueva idea de moda o una vieja tradición que se recupera? Acompáñame y descubre más cosas sobre este método de gestión y, sobre todo, sobre los animales que viven en el Parque."
    ],
    "nl": [
      "Ecopastureren? Is het een trendy nieuw idee of een oude traditie die nieuw leven wordt ingeblazen? Ga met me mee en kom meer te weten over deze beheermethode en vooral over de dieren die in het park leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : l’éco-pâturage ? Mais à quoi ça sert ?"
    ]
  },
