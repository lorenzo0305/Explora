      "dc:description": {
        "de": [
          "Tanzen Sie auf dem Dancefloor bei der Fluo-Party, die vom Campingplatz La Sensation in Matringhem organisiert wird\nTreffpunkt am Samstag, den 31. Mai um 21:30 Uhr"
        ],
        "en": [
          "Come and dance on the dancefloor at the fluo party organized by La Sensation campsite in Matringhem\nSee you on Saturday May 31st at 9.30pm"
        ],
        "it": [
          "Venite a ballare sulla pista da ballo alla serata fluorescente organizzata dal campeggio La Sensation di Matringhem\nSabato 31 maggio alle 21.30"
        ],
        "fr": [
          "Venez danser sur dancefloor lors de la soirée fluo organisée par le camping La Sensation à Matringhem\nRendez-vous le samedi 31 mai à 21h30"
        ],
        "es": [
          "Ven a bailar a la pista en la velada fluorescente organizada por el camping La Sensation de Matringhem\nSábado 31 de mayo a las 21.30 h"
        ],
        "nl": [
          "Kom dansen op de dansvloer tijdens de fluorescerende avond georganiseerd door camping La Sensation in Matringhem\nZaterdag 31 mei om 21.30 uur"
        ]
      },
