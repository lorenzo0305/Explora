  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/af02a2ce-d4aa-3710-8a2c-d75cc7b38357",
      "dc:description": {
        "de": [
          "Dieser Picknickplatz befindet sich in der charmanten Gemeinde Lormaison. Verschiedene Einrichtungen: Spielplatz und Mülleimer.\nDieser Picknickplatz befindet sich auf der Route \"Des deux Vexin au Pays de Nacre\"."
        ],
        "en": [
          "Picnic area located in the charming village of Lormaison. Various equipment : playground and garbage garbage cans.\nThis picnic area is located on the itinerary \"Des deux Vexin au Pays de Nacre\"."
        ],
        "it": [
          "Area picnic situata nell'incantevole villaggio di Lormaison. Varie strutture: parco giochi e cestini per i rifiuti.\nQuest'area picnic si trova sul percorso \"Dai due Vexin al Pays de Nacre\"."
        ],
        "fr": [
          "Aire de pique-nique se situant dans la charmante commune de Lormaison. Divers équipement : aire de jeux et poubelles.\nCette aire de pique-nique se situe sur l'itinéraire \"Des deux Vexin au Pays de Nacre\"."
        ],
        "nl": [
          "Picknickplaats gelegen in het charmante dorpje Lormaison. Diverse voorzieningen: speeltuin en afvalbakken.\nDeze picknickplaats ligt op de route \"Van de twee Vexins naar het Pays de Nacre\"."
        ],
        "es": [
          "Merendero situado en el encantador pueblo de Lormaison. Instalaciones diversas: parque infantil y papeleras.\nEste merendero se encuentra en la ruta \"De los dos Vexins al Pays de Nacre\"."
        ]
      },
      "@type": [
        "Description"
