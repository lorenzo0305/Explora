      "@id": "https://data.datatourisme.fr/b4a3ad45-44e1-3fbe-a505-7da0066155cd",
      "dc:description": {
        "de": [
          "Das Foucrêpe?s, eine gemütliche Crêperie am Place des Héros in Arras, serviert salzige Galettes & süße Crêpes nach bretonischer Art, mit vegetarischen Optionen."
        ],
        "en": [
          "Le Foucrêpe?s, a cosy crêperie on the Place des Héros in Arras, serves savoury galettes & sweet crêpes in Breton style, with vegetarian options."
        ],
        "it": [
          "Le Foucrêpe, un'accogliente crêperie in Place des Héros ad Arras, serve galettes salate e crêpes dolci in stile bretone, con opzioni vegetariane."
        ],
        "fr": [
          "Le Foucrêpe’s, crêperie chaleureuse sur la place des Héros à Arras, sert galettes salées & crêpes sucrées version bretonne, avec options végétariennes."
        ],
        "es": [
          "Le Foucrêpe?s, una acogedora crêperie situada en la Place des Héros de Arras, sirve galettes saladas y crêpes dulces al estilo bretón, con opciones vegetarianas."
        ],
        "nl": [
          "Le Foucrêpe?s, een gezellige crêperie op de Place des Héros in Arras, serveert hartige galettes en zoete crêpes in Bretonse stijl, met vegetarische opties."
        ]
      },
