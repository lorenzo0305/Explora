  "rdfs:comment": {
    "de": [
      "Entdecken Sie 50 Jahre Militärgeschichte auf dem Gelände der Wolfsschlucht II oder Ravin du Loup 2 (ehemaliges Militärlager von Margival, Laffaux und Neuville sur Margival) und insbesondere den Bunker Nr. 2 \"Zucarello\" und seine Nebengebäude."
    ],
    "en": [
      "Come and discover 50 years of military history on the site of Wolfsschlucht II or Ravin du Loup 2 (former military camp of Margival, Laffaux and Neuville sur Margival) and more particularly the bunker n°2 \"Zucarello\" and its dependencies."
    ],
    "it": [
      "Venite a scoprire 50 anni di storia militare sul sito di Wolfsschlucht II o Ravin du Loup 2 (ex campo militare di Margival, Laffaux e Neuville sur Margival) e in particolare il bunker n°2 \"Zucarello\" e le sue dipendenze."
    ],
    "fr": [
      "Venez découvrir 50 ans d'histoire militaire sur le site du Wolfsschlucht II ou Ravin du Loup 2 (ancien camp militaire de Margival, Laffaux et Neuville sur Margival) et plus particulièrement le bunker n°2 \"Zucarello\" et ses dépendances."
    ],
    "es": [
      "Venga a descubrir 50 años de historia militar en el emplazamiento de Wolfsschlucht II o Ravin du Loup 2 (antiguo campamento militar de Margival, Laffaux y Neuville sur Margival) y más concretamente el búnker n°2 \"Zucarello\" y sus dependencias."
    ],
    "nl": [
      "Kom en ontdek 50 jaar militaire geschiedenis op het terrein van Wolfsschlucht II of Ravin du Loup 2 (voormalig militair kamp van Margival, Laffaux en Neuville sur Margival) en meer bepaald de bunker n°2 \"Zucarello\" en zijn bijgebouwen."
    ]
  },
