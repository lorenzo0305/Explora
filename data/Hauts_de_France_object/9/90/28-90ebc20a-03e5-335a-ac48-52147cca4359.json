  "rdfs:comment": {
    "de": [
      "Picknickplatz mit einem Tisch auf einer Rasenfläche gegenüber der Kirche. Parkplatz + Mülleimer. Spielplatz für Kinder. Wanderweg in der Nähe."
    ],
    "en": [
      "Picnic area with a table on a grassy area, facing the church. Car park + rubbish bin. Playground for children. Hiking trail nearby."
    ],
    "it": [
      "Area picnic con tavolo su un'area erbosa, di fronte alla chiesa. Parcheggio + cestino dei rifiuti. Parco giochi per bambini. Sentiero escursionistico nelle vicinanze."
    ],
    "fr": [
      "Aire de pique-nique aménagée d'une table sur un espace enherbé, face à l'église. Parking + poubelle. Aire de jeux pour enfants. Chemin de randonnée à proximité."
    ],
    "es": [
      "Área de picnic con una mesa en una zona de césped, frente a la iglesia. Aparcamiento + cubo de basura. Zona de juegos para niños. Ruta de senderismo en las cercanías."
    ],
    "nl": [
      "Picknickplaats met tafel op een grasveld, tegenover de kerk. Parkeerplaats + vuilnisbak. Speeltuin voor kinderen. Wandelpad in de buurt."
    ]
  },
