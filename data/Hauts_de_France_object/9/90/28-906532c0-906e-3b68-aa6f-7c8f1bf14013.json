  "rdfs:comment": {
    "de": [
      "Die Überreste dieses Schlosses aus dem 12. Jahrhundert, das einst die Grafschaft Senlis beherrschte, zeugen von einer glanzvollen mittelalterlichen Vergangenheit!"
    ],
    "en": [
      "The remains of this 12th century castle, which once dominated the county of Senlis, bear witness to a prestigious medieval past!"
    ],
    "it": [
      "I resti di questo castello del XII secolo, che un tempo dominava la contea di Senlis, testimoniano un prestigioso passato medievale!"
    ],
    "fr": [
      "Les vestiges de ce Château du XIIème siècle qui dominait, d'antan, le comté de Senlis, sont le témoignage d'un passé médiéval prestigieux !"
    ],
    "es": [
      "Los restos de este castillo del siglo XII, que antaño dominaba el condado de Senlis, son testigos de un prestigioso pasado medieval"
    ],
    "nl": [
      "De overblijfselen van dit kasteel uit de 12e eeuw, dat ooit het graafschap Senlis domineerde, getuigen van een prestigieus middeleeuws verleden!"
    ]
  },
