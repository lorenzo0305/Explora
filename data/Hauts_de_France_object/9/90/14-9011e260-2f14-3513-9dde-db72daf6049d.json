  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2c0faee9-451a-30c1-9287-4d04a93b8bdc",
      "dc:description": {
        "de": [
          "Organisiert von den Spatzen der Calotterie\nFreitag, den 20. Februar 2026\nGemeindesaal - Rue de la Gare in Beutin\n-------------------------\nZu gewinnen gibt es zahlreiche Preise: Tablet, Fernseher....) - Begrenzt auf 30 Teams\n\nSenden Sie die Namen der Spieler per SMS: 06 66 87 88 05\nAnmeldung der Teams vor Ort ab 18:30 Uhr\n\nBeginn des Wettbewerbs um 19 Uhr mit 1 Nahkampfspiel und 3 Paarspielen\nTeilnahme: 10 ? /Spieler - Ein Preis pro Teilnehmer\nGetränke und Speisen vor Ort\n\nCredit: Pixabay"
        ],
        "en": [
          "Organized by Les Moineaux de la Caloterie\nFriday, February 20, 2026\nSalle communale - Rue de la Gare, Beutin\n-------------------------\nLots to be won: tablet, TV....) - Limited to 30 teams\n\nText players' names to: 06 66 87 88 05\nTeam registration on site from 6:30 p.m\n\nCompetition starts at 7pm, with 1 scrum game and 3 pairs games\nEntry fee: 10? per player - One prize per participant\nRefreshments and catering on site\n\nCredit : Pixabay"
        ],
        "it": [
          "Organizzato da Les Moineaux de la Caloterie\nVenerdì 20 febbraio 2026\nSalle communale - Rue de la Gare, Beutin\n-------------------------\nNumerosi premi in palio: tablet, TV....) - Limitato a 30 squadre\n\nScrivere i nomi dei giocatori al numero 06 66 87 88 05\nRegistrazione delle squadre in loco dalle 18.30\n\nLa competizione inizia alle 19.00 con 1 partita di scramble e 3 partite a coppie\nQuota di iscrizione: 10 € per giocatore - Un premio per partecipante\nRinfresco e ristorazione in loco\n\nCredito : Pixabay"
        ],
        "fr": [
          "Organisé par les Moineaux de la Caloterie\nVendredi 20 février 2026\nSalle communale - Rue de la Gare à Beutin\n-------------------------\nA gagner de nombreux lots : tablette, télé....) - Limité à 30 équipes\n\nEnvoyez le nom des joueurs par SMS : 06 66 87 88 05\nInscriptions des équipes sur place à partir de 18h30\n\nDébut du concours à 19h avec 1 partie à la mêlée et 3 parties en binôme\nParticipation : 10€ /joueur - Un lot par participant\nBuvette et restauration sur place\n\nCrédit : Pixabay"
        ],
        "es": [
          "Organizado por Les Moineaux de la Caloterie\nViernes 20 de febrero de 2026\nSalle communale - Rue de la Gare, Beutin\n-------------------------\nNumerosos premios: tablet, TV....) - Limitado a 30 equipos\n\nEnvía los nombres de los jugadores al 06 66 87 88 05\nInscripción de equipos in situ a partir de las 18.30\n\nLa competición comienza a las 19:00, con 1 partido en scrum y 3 partidos por parejas\nInscripción: 10 euros por jugador - Un premio por participante\nRefrescos y catering in situ\n\nCrédito: Pixabay"
        ],
        "nl": [
          "Georganiseerd door Les Moineaux de la Caloterie\nVrijdag 20 februari 2026\nGemeentelijke zaal - Rue de la Gare, Beutin\n-------------------------\nTal van prijzen te winnen: tablet, TV ....) - Beperkt tot 30 teams\n\nSms de namen van de spelers naar 06 66 87 88 05\nTeamregistratie ter plaatse vanaf 18.30 uur\n\nCompetitie begint om 19.00 uur met 1 spelletje scramble en 3 spelletjes in paren\nInschrijfgeld: €10 per speler - Eén prijs per deelnemer\nVersnaperingen en catering ter plaatse\n\nKrediet: Pixabay"
        ]
      },
