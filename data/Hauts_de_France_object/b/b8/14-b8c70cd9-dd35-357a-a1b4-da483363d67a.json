  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b7b7a344-cfbb-39a7-a2d1-f5decb439e8b",
      "dc:description": {
        "de": [
          "Stellen Sie sich eine Gitarre vor, die Geheimnisse flüstert, ein Cajon, das im Rhythmus Ihres Herzschlags tanzt, und eine Geige, die magische Melodien webt. Genau das ist La Fille d'en Bas."
        ],
        "en": [
          "Imagine a guitar whispering secrets, a cajon dancing to the beat of your heart and a violin weaving magical melodies. That's La Fille d'en Bas."
        ],
        "it": [
          "Immaginate una chitarra che sussurra segreti, un cajon che balla al ritmo del vostro cuore e un violino che tesse magiche melodie. Questa è La Fille d'en Bas."
        ],
        "fr": [
          "Imaginez une guitare qui murmure des secrets, un cajon qui danse au rythme de vos battements de cœur et un violon qui tisse des mélodies magiques. C'est ça La Fille d'en Bas."
        ],
        "nl": [
          "Stel je een gitaar voor die geheimen fluistert, een cajon die danst op de maat van je hart en een viool die magische melodieën weeft. Dat is La Fille d'en Bas."
        ],
        "es": [
          "Imagina una guitarra susurrando secretos, un cajón bailando al ritmo de tu corazón y un violín tejiendo melodías mágicas. Eso es La Fille d'en Bas."
        ]
      },
