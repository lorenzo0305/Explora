  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Didier de Chaulnes entstand im Zuge des Wiederaufbaus und weist eine Architektur auf, die Ziegel und Beton im reinsten Art-déco-Stil in den Vordergrund stellt."
    ],
    "en": [
      "A product of the Reconstruction era, Saint-Didier de Chaulnes church features brick and concrete architecture in the purest Art Deco style."
    ],
    "it": [
      "Prodotto del periodo della Ricostruzione, l'architettura di Saint-Didier de Chaulnes è caratterizzata da mattoni e cemento nel più puro stile Art Déco."
    ],
    "fr": [
      "Issue de la Reconstruction, l'église Saint-Didier de Chaulnes affiche une architecture mettant en avant la brique et le béton dans le plus pur style Art déco."
    ],
    "es": [
      "Producto del periodo de Reconstrucción, la arquitectura de Saint-Didier de Chaulnes se caracteriza por el ladrillo y el hormigón al más puro estilo Art Déco."
    ],
    "nl": [
      "De architectuur van Saint-Didier de Chaulnes, een product van de wederopbouwperiode, bestaat uit baksteen en beton in de zuiverste art-decostijl."
    ]
  },
