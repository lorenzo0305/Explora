  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/53d6bffd-2eae-31c2-84af-efd484fd801f",
      "dc:description": {
        "de": [
          "Gourmet d'Asie ist ein All-you-can-eat-Buffetrestaurant mit grundsätzlich asiatischen und europäischen Gerichten. Dazu gehören kalte Vorspeisen, warme Vorspeisen, Sushi Maki, warme Gerichte, Wok-Grillgerichte und Desserts. Herzlicher Empfang, abwechslungsreiche Gerichte, gemütlicher Raum, Spielplatz für Kinder."
        ],
        "en": [
          "Gourmet d'Asie is an all-you-can-eat buffet restaurant, with Asian dishes in principle and European dishes. Including cold starters, hot starters, sushi maki, hot dishes, wok grilled, and desserts. Warm welcome, varied dishes, comfortable room, playground for children."
        ],
        "it": [
          "Il Gourmet d'Asie è un ristorante a buffet con piatti asiatici ed europei. Tra cui antipasti freddi, antipasti caldi, sushi maki, piatti caldi, grigliate wok e dessert. Accoglienza calorosa, piatti variegati, sala confortevole, parco giochi per bambini."
        ],
        "fr": [
          "Gourmet d’Asie est un restaurant buffet à volonté, avec des plats asiatiques en principe et des plats européens. Y compris les entrées froides, les entrées chaudes, les sushis makis, les plats chauds, les wok grillades, et les desserts. Accueil chaleureux, des plats variés, la salle confortable, L’air de jeux pour les enfants."
        ],
        "nl": [
          "Gourmet d'Asie is een all-you-can-eat buffetrestaurant, met voornamelijk Aziatische en Europese gerechten. Inclusief koude voorgerechten, warme voorgerechten, sushi maki's, warme gerechten, wokgrillen en desserts. Warm onthaal, gevarieerde gerechten, comfortabele kamer, speeltuin voor kinderen."
        ],
        "es": [
          "El Gourmet d'Asie es un restaurante buffet con todo lo que puedas comer, con platos principalmente asiáticos y europeos. Incluye entrantes fríos, entrantes calientes, makis de sushi, platos calientes, parrilladas al wok y postres. Cálida acogida, platos variados, habitación confortable, zona de juegos para los niños."
        ]
      },
