  "rdfs:comment": {
    "de": [
      "Herstellung von Apfelsaft aus lokalen und traditionellen Apfelsorten, die aus unbehandelten Hochstamm-Obstgärten stammen, mit der Marke \"Produit du Parc naturel régional de l'Avesnois\" (Produkt des regionalen Naturparks Avesnois)."
    ],
    "en": [
      "Production of apple juice made from local and traditional apple varieties, from untreated tall orchards, benefiting from the \"Product of the Avesnois Regional Nature Park\" brand."
    ],
    "it": [
      "Produzione di succo di mela di varietà locali e tradizionali, provenienti da frutteti ad alto fusto non trattati, con il marchio \"Produit du Parc naturel régional de l'Avesnois\"."
    ],
    "fr": [
      "Production de jus de pomme élaboré à partir de variétés de pommes locales et traditionnelles, issues de vergers hautes tiges non traités, bénéficiant de la marque \"Produit du Parc naturel régional de l'Avesnois\"."
    ],
    "nl": [
      "Productie van appelsap op basis van lokale en traditionele appelsoorten, afkomstig van onbehandelde hoogstamboomgaarden, met het label \"Produit du Parc naturel régional de l'Avesnois\"."
    ],
    "es": [
      "Producción de zumo de manzana a partir de variedades locales y tradicionales, procedentes de huertos de tallo alto no tratados, con la etiqueta \"Produit du Parc naturel régional de l'Avesnois\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jus de pommes de Monsieur Thierry Meurant"
    ]
  },
