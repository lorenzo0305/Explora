  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/07a02ca0-e1d4-3022-b245-861d7c138afd",
      "dc:description": {
        "de": [
          "Bistronomisches Restaurant.\nFeine, saisonale Küche, die in einem romantischen und gemütlichen Rahmen serviert wird.\nSaisonale Produkte, Hausgemacht, Frische Produkte.\n\nTäglich außer dienstags von 19:00 bis 21:00 Uhr geöffnet.\nSamstag und Sonntag von 12:00 bis 14:00 Uhr und von 19:00 bis 21:00 Uhr."
        ],
        "en": [
          "Bistronomic restaurant.\nFine, seasonal cuisine served in a warm, romantic setting.\nSeasonal products, homemade, fresh produce.\n\nOpen every day except Tuesday from 7pm to 9pm.\nSaturday and Sunday from 12pm to 2pm and from 7pm to 9pm."
        ],
        "it": [
          "Ristorante bistronomico.\nCucina raffinata e stagionale servita in un ambiente caldo e romantico.\nProdotti di stagione, prodotti fatti in casa e freschi.\n\nAperto tutti i giorni, tranne il martedì, dalle 19.00 alle 21.00.\nSabato e domenica dalle 12.00 alle 14.00 e dalle 19.00 alle 21.00."
        ],
        "fr": [
          "Restaurant bistronomique.\nCuisine fine et de saison servie dans un cadre romantique et chaleureux.\nProduits de saison, Fait maison, Produits frais.\n\nOuvert tous les jours sauf le mardi de 19h à 21h.\nSamedi et dimanche de 12h à 14h et de 19h à 21h."
        ],
        "es": [
          "Restaurante bistronómico.\nCocina refinada de temporada servida en un ambiente cálido y romántico.\nProductos de temporada, caseros y frescos.\n\nAbierto todos los días excepto el martes de 19:00 a 21:00 h.\nSábados y domingos de 12h a 14h y de 19h a 21h."
        ],
        "nl": [
          "Bistronomisch restaurant.\nFijne, seizoensgebonden keuken geserveerd in een warme, romantische omgeving.\nSeizoensproducten, huisgemaakte, verse producten.\n\nDagelijks geopend behalve dinsdag van 19.00 tot 21.00 uur.\nZaterdag en zondag van 12 tot 14 uur en van 19 tot 21 uur."
        ]
      },
