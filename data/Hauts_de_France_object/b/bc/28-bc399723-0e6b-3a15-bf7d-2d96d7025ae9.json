  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/72d7722f-11f6-35e1-8258-3f3a08419882",
      "dc:description": {
        "de": [
          "Le Petit Troquet in Fargniers ( Tergnier) ist die Definition eines Trofos: ein atypischer Raum, eine malerische Sehenswürdigkeit, ein Muss! Bietet sogar einen kompletten Konzertkalender an!"
        ],
        "en": [
          "The Petit Troquet in Fargniers (Tergnier) is the definition of a troquet: an atypical space, a picturesque curiosity, a must-see in short! It even offers a complete agenda of concerts!"
        ],
        "it": [
          "Il Petit Troquet di Fargniers (Tergnier) è la definizione stessa di troquet: uno spazio atipico, una curiosità pittoresca, insomma un luogo da non perdere! Ha anche un programma completo di concerti!"
        ],
        "fr": [
          "Le Petit Troquet à  Fargniers ( Tergnier) est à lui seul la définition du troquet : un espace atypique, une curiosité pittoresque, un incontournable en somme ! Propose même un agenda complet de concerts !"
        ],
        "nl": [
          "Het Petit Troquet in Fargniers (Tergnier) is de definitie van een troquet: een atypische ruimte, een pittoreske bezienswaardigheid, een must-see kortom! Het heeft zelfs een volledig schema van concerten!"
        ],
        "es": [
          "El Petit Troquet de Fargniers (Tergnier) es la definición misma de un troquet: un espacio atípico, una curiosidad pintoresca, ¡una visita obligada en definitiva! Incluso cuenta con una completa agenda de conciertos"
        ]
      },
      "@type": [
        "Description"
