  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1ed78875-a6bf-33aa-b635-3a42088af8e9",
      "dc:description": {
        "de": [
          "Das Komitee Miss Côte d'Opale Miss Euroregion hat als satzungsgemäßes Ziel, die Wahl zur Miss Côte d'Opale durchzuführen, um Schülerinnen als Botschafterinnen Ihrer Region Hauts de France auf dem europäischen Kontinent zu fördern.\n\nDurchführung des Schönheitswettbewerbs im Wechsel mit einer Varieté-Show."
        ],
        "en": [
          "The statutory aim of the Miss Euroregion Miss Côte d?Opale Committee is to organize the Miss Côte d?Opale election in order to promote student ambassadors for your Hauts de France region on the European continent.\n\nThe beauty pageant alternates with a variety show."
        ],
        "it": [
          "Lo scopo statutario del Comitato Miss Euroregione Miss Côte d'Opale è quello di organizzare l'elezione di Miss Côte d'Opale al fine di promuovere le studentesse ambasciatrici della vostra regione Hauts de France sul continente europeo.\n\nIl concorso di bellezza si alterna a uno spettacolo di varietà."
        ],
        "fr": [
          "Le Comité Miss Côte d’Opale Miss Eurorégion a pour objectif statutaire de réaliser l’élection Miss Côte d’Opale afin de promouvoir des élèves ambassadrices de votre région Hauts de France sur le continent européen.\n\nRéalise le concours de beauté en alternance avec un spectacle de variétés."
        ],
        "nl": [
          "Het statutaire doel van het Miss Euroregion Miss Côte d'Opale comité is het organiseren van de Miss Côte d'Opale verkiezing om studentenambassadeurs voor uw regio Hauts de France op het Europese continent te promoten.\n\nDe schoonheidswedstrijd wordt afgewisseld met een variétéshow."
        ],
        "es": [
          "El objetivo estatutario del Comité Miss Euroregion Miss Côte d'Opale es organizar la elección de Miss Côte d'Opale con el fin de promover estudiantes embajadoras de su región Hauts de France en el continente europeo.\n\nEl concurso de belleza se alterna con un espectáculo de variedades."
        ]
      },
