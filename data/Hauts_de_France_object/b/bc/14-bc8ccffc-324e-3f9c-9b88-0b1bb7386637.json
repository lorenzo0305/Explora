  "rdfs:comment": {
    "de": [
      "Von Anne Besson, Professorin für vergleichende Literaturwissenschaft an der Universität Artois (Arras), William Blanc, Historiker, der sich auf Fantasy und ihre zeitgenössischen Verwendungen spezialisiert hat, und Hélène Bouillon, Kuratorin der Ausstellung Animaux fantastiques."
    ],
    "en": [
      "By Anne Besson, professor of comparative literature at the University of Artois (Arras), William Blanc, historian specializing in fantasy and its contemporary uses, and Hélène Bouillon, curator of the Fantastic Animals exhibition."
    ],
    "it": [
      "A cura di Anne Besson, docente di letteratura comparata presso l'Università di Artois (Arras), William Blanc, storico specializzato nel fantasy e nei suoi usi contemporanei, e Hélène Bouillon, curatrice della mostra Animali fantastici."
    ],
    "fr": [
      "Par Anne Besson, professeure de littérature comparée à l’université d’Artois (Arras), William Blanc, historien spécialiste de la fantasy et des usages contemporains et Hélène Bouillon, commissaire de l’exposition Animaux fantastiques."
    ],
    "es": [
      "Por Anne Besson, profesora de literatura comparada en la Universidad de Artois (Arras), William Blanc, historiador especializado en la fantasía y sus usos contemporáneos, y Hélène Bouillon, comisaria de la exposición Animales fantásticos."
    ],
    "nl": [
      "Door Anne Besson, hoogleraar vergelijkende literatuurwetenschap aan de Universiteit van Artois (Arras), William Blanc, historicus gespecialiseerd in fantasy en het hedendaagse gebruik ervan, en Hélène Bouillon, curator van de tentoonstelling Fantastische dieren."
    ]
  },
  "rdfs:label": {
