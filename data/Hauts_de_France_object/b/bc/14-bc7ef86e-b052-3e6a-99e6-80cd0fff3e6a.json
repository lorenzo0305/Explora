  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/062638b9-192c-3329-8165-e7bb573d617e",
      "dc:description": {
        "de": [
          "Improvisation für alle ab 16 Jahren\nVon Samstag, den 11. bis Sonntag, den 12. Oktober von 14:00 bis 17:30 Uhr\nOrt: La Maison des Faiseurs ? Montreuil\n----------------------------\nWochenendpraktikum in Improvisationstheater.\n\nEine Reservierung ist erforderlich\nGebühr: 25 € Wochenendpraktikum in bar, mit EC-Karte oder Scheck.\n\nTreffpunkt: 5 Place de la Gare\nKredit: La Maison des Faiseurs"
        ],
        "en": [
          "Improvisation for ages 16 and up\nSaturday, October 11 to Sunday, October 12, 2pm to 5:30pm\nLocation: La Maison des Faiseurs ? Montreuil\n----------------------------\nWeekend course in theater improvisation.\n\nReservations required\nFee: 25? weekend course by credit card, cash or cheque.\n\nMeeting point: 5 Place de la Gare\nCredit : La Maison des Faiseurs"
        ],
        "it": [
          "Improvvisazione per adulti dai 16 anni in su\nSabato 11 e domenica 12 ottobre, dalle 14.00 alle 17.30\nSede: La Maison des Faiseurs? Montreuil\n----------------------------\nCorso di improvvisazione teatrale per un fine settimana.\n\nPrenotazione obbligatoria\nPrezzo: 25? corso di fine settimana tramite bonifico bancario, contanti o assegno.\n\nPunto d'incontro: 5 Place de la Gare\nCredito: La Maison des Faiseurs"
        ],
        "fr": [
          "Improvisation pour les 16 ans et plus\nDu samedi 11 au dimanche 12 octobre de 14h à 17h30\nLieu : La Maison des Faiseurs – Montreuil\n----------------------------\nStage week-end en improvisation théâtre.\n\nRéservation nécessaire\nTarif : 25€ stage week-end en CB, espèces ou chèque.\n\nRendez-vous : 5 Place de la Gare \nCrédit : La Maison des Faiseurs"
        ],
        "nl": [
          "Improvisatie voor 16 jaar en ouder\nZaterdag 11 en zondag 12 oktober, 14.00 tot 17.30 uur\nPlaats: La Maison des Faiseurs ? Montreuil\n----------------------------\nWeekendcursus theaterimprovisatie.\n\nReservering verplicht\nPrijs: 25? weekendcursus via overschrijving, contant of per cheque.\n\nTrefpunt: 5 Place de la Gare\nKrediet: La Maison des Faiseurs"
        ],
        "es": [
          "Improvisación para mayores de 16 años\nSábado 11 y domingo 12 de octubre, de 14:00 a 17:30 horas\nLugar: La Maison des Faiseurs ? Montreuil\n----------------------------\nCurso de fin de semana de improvisación teatral.\n\nReserva obligatoria\nPrecio: 25? curso de fin de semana por transferencia bancaria, efectivo o cheque.\n\nPunto de encuentro: 5 Place de la Gare\nCrédito: La Maison des Faiseurs"
        ]
      },
