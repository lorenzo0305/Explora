  "rdfs:comment": {
    "de": [
      "Le Moulin bietet Ihnen eine raffinierte Küche in einer gemütlichen und warmen Atmosphäre mit einer abwechslungsreichen Speisekarte, Gerichten aus frischen Zutaten und wöchentlich neuen Vorschlägen."
    ],
    "en": [
      "Le Moulin offers refined cuisine in a cosy and warm atmosphere with a varied menu, dishes concocted from fresh products and new suggestions every week."
    ],
    "it": [
      "Il Moulin offre una cucina raffinata in un'atmosfera accogliente e calorosa con un menu vario, piatti a base di prodotti freschi e nuove proposte ogni settimana."
    ],
    "fr": [
      "Le Moulin vous propose une cuisine raffinée dans une ambiance cosy et chaleureuse avec une carte variée, des plats concoctés à partir de produits frais et de nouvelles suggestions chaque semaine."
    ],
    "es": [
      "El Moulin ofrece una cocina refinada en un ambiente acogedor y cálido, con una carta variada, platos elaborados con productos frescos y nuevas sugerencias cada semana."
    ],
    "nl": [
      "De Moulin biedt een verfijnde keuken in een gezellige en warme sfeer met een gevarieerde kaart, gerechten op basis van verse producten en elke week nieuwe suggesties."
    ]
  },
