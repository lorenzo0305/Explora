  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/be450a88-abb0-3abf-bf3c-29063ffc5a1a",
      "dc:description": {
        "de": [
          "Herzliche Erfahrung, hausgemachte Küche, regionale Gerichte und italienische Küche im Dauerbetrieb.\n\nAnti-Gaspi und kurze Wege."
        ],
        "en": [
          "Warm experience, homemade cuisine, regional dishes and Italian cuisine in continuous service.\n\nAnti-gasppi and short circuits."
        ],
        "it": [
          "Un'esperienza calda e accogliente, cucina casalinga, piatti regionali e cucina italiana a ciclo continuo.\n\nAnti-gasppi e cortocircuiti."
        ],
        "fr": [
          "Expérience chaleureuse, cuisine fait maison, plats régionaux et cuisine Italienne en service continu. \n\nAnti gaspi et circuits courts."
        ],
        "es": [
          "Una experiencia cálida y acogedora, cocina casera, platos regionales y cocina italiana de forma continua.\n\nAntigasppi e cortocircuiti."
        ],
        "nl": [
          "Een warme en gastvrije ervaring, huiselijke keuken, regionale gerechten en Italiaanse keuken op een continue basis.\n\nAnti-gasppi en kortsluiting."
        ]
      },
