  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dc98be7a-6fd0-3b08-97e9-3ef350595d18",
      "dc:description": {
        "de": [
          "Das Reservat besteht aus einer Abfolge von großen ökologischen Einheiten. Die Dünen der Bucht von Canche bieten ein außergewöhnliches Panorama über Hunderte von Hektar wilder Natur."
        ],
        "en": [
          "The reserve is composed of a succession of large ecological units. The Dunes of the Bay of Canche offer an exceptional panorama of hundreds of hectares of wild nature."
        ],
        "it": [
          "La riserva è composta da una successione di grandi unità ecologiche. Le dune della baia di Canche offrono un panorama eccezionale su centinaia di ettari di natura selvaggia."
        ],
        "fr": [
          "La réserve se compose d'une succession de grandes unités écologiques. Les Dunes de la Baie de Canche offrent un panorama exceptionnel sur des centaines d'hectares de nature sauvage."
        ],
        "es": [
          "La reserva está compuesta por una sucesión de grandes unidades ecológicas. Las Dunas de la Bahía de Canche ofrecen un panorama excepcional de cientos de hectáreas de naturaleza salvaje."
        ],
        "nl": [
          "Het reservaat bestaat uit een opeenvolging van grote ecologische eenheden. De duinen van de baai van Canche bieden een uitzonderlijk panorama van honderden hectaren wilde natuur."
        ]
      },
