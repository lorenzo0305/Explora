  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/20ce4904-97ae-3bf4-9c07-706e43f98bcb",
      "dc:description": {
        "de": [
          "Biblio-Thé\nSie haben eine Leidenschaft für das Lesen, das Kino, die Musik... oder Sie unterhalten sich einfach nur gerne?\nKommen Sie und teilen Sie Ihre Lieblingsromane, Comics, Filme, Mangas... bei einem leckeren Tee!\n\nFreier Eintritt"
        ],
        "en": [
          "Biblio-Thé\nDo you have a passion for reading, cinema, music... or do you just like to chat?\nCome and share your favorite novels, comics, films, mangas... over a delicious cup of tea!\n\nFree admission"
        ],
        "it": [
          "Biblio-Thé\nAvete la passione per la lettura, il cinema, la musica... o semplicemente vi piace chiacchierare?\nVenite a condividere i vostri romanzi, fumetti, film, manga... davanti a una deliziosa tazza di tè!\n\nIngresso libero"
        ],
        "fr": [
          "Biblio-Thé\nVous avez une passion pour la lecture, le cinéma, la musique... ou vous aimez juste discuter ?\nVenez partager vos coups de coeur romans, BD, films, mangas... autour d'un thé gourmand !\n\nEntrée libre et gratuite"
        ],
        "es": [
          "Biblio-Thé\n¿Te apasiona la lectura, el cine, la música... o simplemente te gusta charlar?\nVen a compartir tus novelas favoritas, cómics, películas, manga... ¡tomando una deliciosa taza de té!\n\nEntrada gratuita"
        ],
        "nl": [
          "Biblio-Thé\nHeb je een passie voor lezen, film, muziek... of praat je gewoon graag?\nKom en deel je favoriete romans, strips, films, manga... onder het genot van een heerlijk kopje thee!\n\nGratis toegang"
        ]
      },
      "@type": [
        "Description"
