  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/88c2b325-de85-322c-af0a-1107a8948ad0",
      "dc:description": {
        "de": [
          "Sandstrand auf Le Grand Site de France des Deux-Caps. Am Fuße des Cap Gris-nez befinden sich auf der einen Seite die Dünen und auf der anderen die Sandstein- und Tonklippen."
        ],
        "en": [
          "Sandy beach on the Deux-Caps Grand Site de France. At the foot of Cap Gris-nez, dunes on one side and sandstone and clay cliffs on the other."
        ],
        "it": [
          "Spiaggia sabbiosa del Grand Site de France Deux-Caps. Ai piedi di Cap Gris-nez, dune da un lato e scogliere di arenaria e argilla dall'altro."
        ],
        "fr": [
          "Plage de sable sur Le Grand Site de France des Deux-Caps. Au pied du Cap Gris-nez, d'un côté les dunes et de l'autre les falaises de grès et d'argile."
        ],
        "nl": [
          "Zandstrand op de Grand Site de France van de Deux-Caps. Aan de voet van Cap Gris-nez, duinen aan de ene kant en zandsteen- en kleikliffen aan de andere."
        ],
        "es": [
          "Playa de arena en el Deux-Caps Grand Site de France. A los pies del Cap Gris-nez, dunas a un lado y acantilados de arenisca y arcilla al otro."
        ]
      },
