  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bfbe1ab3-c824-30e8-9643-e66d9dc54c6f",
      "dc:description": {
        "de": [
          "Vom 23. Oktober bis zum 7. November 2021\n\nAmüsieren Sie sich auf dem Halloween-Parcours und genießen Sie jeden Tag von 15:00 bis 17:30 Uhr den Halloween-Snack. Auf dem Programm stehen unter anderem ein Luftballonschnitzer und der Zauberer \"Magic com' Eddy\"."
        ],
        "en": [
          "From October 23 to November 7, 2021\n\nCome and have fun around the Halloween Trail, and every day, from 3pm to 5:30pm, enjoy the Halloween snack formula, on the program: balloon sculptor and magician \"Magic com' Eddy\"."
        ],
        "it": [
          "Dal 23 ottobre al 7 novembre 2021\n\nVenite a divertirvi lungo il Percorso di Halloween e ogni giorno, dalle 15.00 alle 17.30, godetevi la formula della merenda di Halloween, in programma: scultore di palloncini e mago \"Magic com? Eddy\"."
        ],
        "fr": [
          "Du 23 octobre au  7 novembre 2021\n\nVenez vous amuser autour du Parcours d’Halloween, et chaque jour, de 15h à 17h30 profitez de la formule goûter d’Halloween, au programme : sculpteur de ballons et magicien « Magic com’ Eddy »."
        ],
        "nl": [
          "Van 23 oktober tot 7 november 2021\n\nKom en vermaak je op het Halloweenpad, en geniet elke dag van 15.00 tot 17.30 uur van de Halloween-snackformule, op het programma: ballonsculpturist en goochelaar \"Magic com? Eddy\"."
        ],
        "es": [
          "Del 23 de octubre al 7 de noviembre de 2021\n\nVenga a divertirse por el Sendero de Halloween, y todos los días, de 15:00 a 17:30, disfrute de la fórmula de la merienda de Halloween, en el programa: escultor de globos y mago \"Magic com? Eddy\"."
        ]
      },
