  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3dbb2ef3-8a82-3030-a89d-13a956c6caee",
      "dc:description": {
        "de": [
          "Gehen Sie während einer Wanderung zum Kulturerbe an den Ufern der Deûle entlang. Entdecken Sie die Geschichte und Gegenwart dieses Wasserlaufs!"
        ],
        "en": [
          "Walk along the banks of the Deûle during a heritage walk. Discover the history and the present of this waterway!"
        ],
        "it": [
          "Passeggiate lungo le rive della Deûle. Scoprite la storia e il presente di questo corso d'acqua!"
        ],
        "fr": [
          "Longez les bords de Deûle pendant une randonnée patrimoniale. Partez à la découverte de l’histoire et du présent de ce cours d’eau !"
        ],
        "nl": [
          "Maak een erfgoedwandeling langs de oevers van de Deûle. Ontdek de geschiedenis en het heden van deze waterweg!"
        ],
        "es": [
          "Dé un paseo patrimonial por las orillas del Deûle. Descubra la historia y el presente de esta vía fluvial"
        ]
      },
