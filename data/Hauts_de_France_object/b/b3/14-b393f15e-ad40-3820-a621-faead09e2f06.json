  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/32b1700b-02e0-3c85-ae3b-61df1c88a9bf",
      "dc:description": {
        "de": [
          "Ausstellung mehrerer Art-déco-Details, die in Zusammenarbeit mit der Architektin und Illustratorin Anne Vanrapenbusch (Illustration_patrimoine) und den Partnergebieten des Art-Deco-Frühlings erstellt wurde\ndéco zusammengestellt wurden.\nFreier Zugang während der Öffnungszeiten des Jardin de la Villa Huguet am 115 Boulevard Eurvin."
        ],
        "en": [
          "An exhibition of Art Deco details, created in collaboration with architect and illustrator Anne Vanrapenbusch (Illustration_patrimoine) and Printemps de l?Art\ndeco.\nFree access during opening hours of the Jardin de la Villa Huguet, 115 Boulevard Eurvin."
        ],
        "it": [
          "Una mostra di dettagli Art Déco, realizzata in collaborazione con l'architetto e illustratrice Anne Vanrapenbusch (Illustration_patrimoine) e il Printemps de l'Art Déco\ndeco.\nAccesso gratuito durante gli orari di apertura del Jardin de la Villa Huguet al 115 di Boulevard Eurvin."
        ],
        "fr": [
          "Exposition de plusieurs détails Art déco, réalisée en collaboration avec l’architecte et illustratrice Anne Vanrapenbusch (Illustration_patrimoine) et les territoires partenaires du Printemps de l’Art\ndéco.\nEn accès libre aux heures d’ouverture du Jardin de la Villa Huguet au 115 Boulevard Eurvin."
        ],
        "es": [
          "Una exposición de detalles Art Déco, realizada en colaboración con la arquitecta e ilustradora Anne Vanrapenbusch (Illustration_patrimoine) y el Printemps de l'Art\ndeco.\nAcceso gratuito durante las horas de apertura del Jardin de la Villa Huguet, en el 115 del Boulevard Eurvin."
        ],
        "nl": [
          "Een tentoonstelling van Art Deco details, gemaakt in samenwerking met architect en illustrator Anne Vanrapenbusch (Illustration_patrimoine) en de Printemps de l'Art\ndeco.\nGratis toegang tijdens de openingsuren van de Jardin de la Villa Huguet aan de Eurvinlaan 115."
        ]
      },
