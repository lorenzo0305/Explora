  "rdfs:comment": {
    "de": [
      "Blicken Sie hinter die Kulissen der Geschichte und lassen Sie sich überraschen: Im Zeichen der Comédie-Française erwacht das Theater im Louvre?Lens zum Leben."
    ],
    "en": [
      "Step behind the scenes of history and be amazed: under the sign of the Comédie-Française, theater comes to life at the Louvre-Lens."
    ],
    "it": [
      "Andate dietro le quinte della storia e lasciatevi stupire: sotto l'egida della Comédie-Française, il teatro prende vita al Louvre?Lens."
    ],
    "fr": [
      "Entrez dans les coulisses de l’Histoire et laissez-vous surprendre : sous le signe de la Comédie-Française, le théâtre prend vie au Louvre‑Lens."
    ],
    "nl": [
      "Ga achter de schermen van de geschiedenis en laat je verbazen: onder auspiciën van de Comédie-Française komt theater tot leven in het Louvre?Lens."
    ],
    "es": [
      "Déjese sorprender por la historia: bajo los auspicios de la Comédie-Française, el teatro cobra vida en el Louvre de Lens."
    ]
  },
