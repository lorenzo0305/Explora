  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich darauf vor, in die Vergangenheit zu reisen und im Rhythmus alter Motoren zu vibrieren, wenn Tracteurs en Fête in Créquy stattfindet!"
    ],
    "en": [
      "Get ready to step back in time and vibrate to the rhythm of vintage engines at Tracteurs en Fête in Créquy!"
    ],
    "it": [
      "Preparatevi a tornare indietro nel tempo e ad emozionarvi al suono dei motori d'epoca ai Tracteurs en Fête di Créquy!"
    ],
    "fr": [
      "Préparez-vous à remonter le temps et à vibrer au rythme des moteurs anciens lors de Tracteurs en Fête à Créquy !"
    ],
    "es": [
      "Prepárese para retroceder en el tiempo y emocionarse con el sonido de los motores de época en Tracteurs en Fête, en Créquy"
    ],
    "nl": [
      "Ga terug in de tijd en geniet van het geluid van oldtimermotoren bij Tracteurs en Fête in Créquy!"
    ]
  },
