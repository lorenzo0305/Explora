  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5fe15f64-c108-3601-aafb-d388fad974f4",
      "dc:description": {
        "de": [
          "Wir laden Sie ein, unsere Trattoria zu entdecken, die sich im Stadtzentrum von Wimereux befindet.\nOb Pizza, Pasta, Schnitzel Milanese oder Rindercarpaccio - wir arbeiten mit frischen und hochwertigen Produkten!\nKommen Sie und entspannen Sie sich in einer warmen und freundlichen Atmosphäre."
        ],
        "en": [
          "We invite you to discover our Trattoria in the center of Wimereux.\nPizzas, pastas, escalope Milanaise or beef carpaccio, we work with fresh, quality produce!\nCome and relax in a warm and friendly atmosphere."
        ],
        "it": [
          "Vi invitiamo a scoprire la nostra Trattoria nel centro di Wimereux.\nPizze, pasta, cotoletta alla milanese o carpaccio di manzo, lavoriamo con prodotti freschi e di qualità!\nVenite a rilassarvi in un'atmosfera calda e accogliente."
        ],
        "fr": [
          "Nous vous invitons à découvrir notre Trattoria située en centre ville de Wimereux. \nPizzas, pâtes, escalope milanaise ou carpaccio de bœuf, nous travaillons avec des produits frais et de qualité ! \nVenez vous détendre dans une atmosphère chaleureuse et conviviale."
        ],
        "nl": [
          "We nodigen je uit om onze Trattoria in het centrum van Wimereux te komen ontdekken.\nPizza's, pasta's, Milanese schnitzel of carpaccio van rundsvlees, wij werken met verse kwaliteitsproducten!\nKom ontspannen in een warme en vriendelijke sfeer."
        ],
        "es": [
          "Le invitamos a descubrir nuestra Trattoria en el centro de Wimereux.\nPizzas, pasta, milanesa o carpaccio de ternera, ¡trabajamos con productos frescos y de calidad!\nVenga a relajarse en un ambiente cálido y acogedor."
        ]
      },
      "@type": [
        "Description"
      ],
