  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, das eine großzügige Küche ab 14,90 Euro anbietet und Pizzen vor Ort oder zum Mitnehmen serviert. Regelmäßige Veranstaltungen (Konzerte, Spiele, Karaoke...) Möglichkeit, einen Teil des großen Saals für Gruppen zu privatisieren."
    ],
    "en": [
      "Traditional restaurant offering generous cuisine from 14.90? and pizzas to eat in or take away. Regular entertainment (concerts, games, karaoke, etc.) Part of the large dining room can be reserved for groups."
    ],
    "it": [
      "Ristorante tradizionale che offre una cucina generosa a partire da 14,90? e pizze da mangiare o da portare via. Una parte dell'ampia sala da pranzo può essere resa privata per i gruppi."
    ],
    "fr": [
      "Restaurant traditionnel offrant une cuisine généreuse à partir de 14,90€ et des pizzas sur place ou à emporter. Présence d'animations régulières (concerts, jeux, karaokés..) Possibilités de privatiser une partie de la grande salle pour des groupes."
    ],
    "nl": [
      "Traditioneel restaurant met een royale keuken vanaf 14,90 € en pizza's om te eten of mee te nemen. Regelmatig entertainment (concerten, spelletjes, karaoke, enz.) Een deel van de grote eetzaal kan privé worden gemaakt voor groepen."
    ],
    "es": [
      "Restaurante tradicional que ofrece una cocina generosa a partir de 14,90? y pizzas para comer en el restaurante o para llevar. Animación regular (conciertos, juegos, karaoke, etc.) Parte del amplio comedor puede hacerse privado para grupos."
    ]
  },
