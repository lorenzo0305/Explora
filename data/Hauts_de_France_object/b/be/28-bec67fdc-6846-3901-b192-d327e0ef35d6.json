  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0dbc7a95-24ee-3e19-a00b-0a8af1a7cc33",
      "dc:description": {
        "de": [
          "Die Ecole Municipale des Sports de Pleine Nature (E.M.S.P.N) steht Jugendlichen zwischen 8 und 17 Jahren offen und bietet das ganze Jahr über 19 verschiedene Sportarten an (Reiten, Golf, Klettern, Bogenschießen usw.)."
        ],
        "en": [
          "The Municipal School of Outdoor Sports (E.M.S.P.N) open to young people from 8 to 17 years old, operates all year round with a panel of 19 sports disciplines (horse riding, golf, climbing, archery etc, ...), each discipline is presented in the form of a pedagogical cycle consisting of five to six sessions."
        ],
        "it": [
          "La Scuola Comunale di Sport all'Aperto (E.M.S.P.N) è aperta ai giovani dagli 8 ai 17 anni e opera tutto l'anno con una gamma di 19 sport (equitazione, golf, arrampicata, tiro con l'arco, ecc.), ogni disciplina viene presentata sotto forma di un ciclo didattico composto da cinque o sei sessioni."
        ],
        "fr": [
          "L'école Municipale des Sports de Pleine Nature (E.M.S.P.N) ouverte aux jeunes de 8 à 17 ans, fonctionne toute l'année avec un panel de 19 disciplines sportives (équitations, golf, escalade, tir à l'arc etc,...), chaque discipline se présente sous la forme d'un cycle pédagogique composé de cinq à six séances."
        ],
        "es": [
          "La Escuela Municipal de Deportes al Aire Libre (E.M.S.P.N) está abierta a jóvenes de 8 a 17 años y funciona durante todo el año con una oferta de 19 deportes (equitación, golf, escalada, tiro con arco, etc.), presentándose cada disciplina en forma de un ciclo educativo que consta de cinco a seis sesiones."
        ],
        "nl": [
          "De Gemeentelijke Buitensportschool (E.M.S.P.N) staat open voor jongeren van 8 tot 17 jaar en is het hele jaar actief met een aanbod van 19 sporten (paardrijden, golf, klimmen, boogschieten, enz.), waarbij elke discipline wordt gepresenteerd in de vorm van een educatieve cyclus van vijf tot zes sessies."
        ]
      },
