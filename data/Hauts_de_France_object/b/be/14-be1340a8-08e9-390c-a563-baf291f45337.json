  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/564fee2f-8091-38ec-b0de-1e045cffb0fc",
      "dc:description": {
        "de": [
          "Tarife für den Verleih von EAV-Fahrrädern Granville Summerside verfügbar (derzeit 5 Fahrräder verfügbar).\n\n1h : 17 ?\n2h : 23 ?\n1/2 Tag: 25 ?\n1 Tag: 40 ?\n2 Tage: 70 ?\nPersonalausweis erforderlich\nKaution: 1000 ?\n\nTäglich (außer dienstags und mittwochs) von 10:00 bis 12:30 Uhr und von 14:30 bis 19:00 Uhr geöffnet.\nSonntags um 18 Uhr geschlossen."
        ],
        "en": [
          "Granville Summerside VAE bike rental rates available (5 bikes currently available).\n\n1h : 17 ?\n2h : 23 ?\n1/2 day : 25 ?\n1 day : 40 ?\n2 days : 70 ?\nIdentity card required\nDeposit : 1000 ?\n\nOpen daily (except Tuesdays and Wednesdays) from 10am to 12:30pm and from 2:30pm to 7pm.\nCloses at 6pm on Sundays."
        ],
        "it": [
          "Tariffe di noleggio biciclette Granville Summerside VAE disponibili (5 biciclette disponibili al momento).\n\n1h : 17 ?\n2h : 23 ?\n1/2 giornata: 25 ?\n1 giorno: 40 ?\n2 giorni: 70 ?\nCarta d'identità richiesta\nDeposito : 1000 ?\n\nAperto tutti i giorni (tranne martedì e mercoledì) dalle 10.00 alle 12.30 e dalle 14.30 alle 19.00.\nLa domenica chiude alle 18:00."
        ],
        "fr": [
          "Tarif locations vélos VAE Granville Summerside disponible (5 vélos disponibles pour le moment).\n\n1h : 17 €\n2h : 23 €\n1/2 Journée : 25 € \n1 jour : 40 €\n2 jours : 70 €\nCarte d'identité obligatoire\nCaution : 1000 €\n\nOuvert tous les jours (sauf mardi et mercredi) de 10h à 12h30 et de 14h30 à 19h.\nFermeture à 18h le dimanche."
        ],
        "es": [
          "Granville Summerside VAE tarifas de alquiler de bicicletas disponibles (5 bicicletas disponibles en este momento).\n\n1h : 17 ?\n2h : 23 ?\n1/2 día: 25 ?\n1 día: 40 ?\n2 días: 70\nDocumento de identidad obligatorio\nFianza : 1000 €\n\nAbierto todos los días (excepto martes y miércoles) de 10h a 12h30 y de 14h30 a 19h.\nLos domingos cierra a las 18h."
        ],
        "nl": [
          "Granville Summerside VAE fietsverhuur tarieven beschikbaar (5 fietsen beschikbaar op dit moment).\n\n1h : 17 ?\n2h : 23 ?\n1/2 dag: 25 ?\n1 dag: 40 ?\n2 dagen: 70 ?\nIdentiteitskaart verplicht\nBorg : 1000 ?\n\nDagelijks geopend (behalve dinsdag en woensdag) van 10.00 tot 12.30 uur en van 14.30 tot 19.00 uur.\nSluit om 18u op zondag."
        ]
      },
