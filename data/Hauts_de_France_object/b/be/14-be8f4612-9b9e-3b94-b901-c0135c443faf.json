      "dc:description": {
        "de": [
          "Die Gruppe TELEPHOME ist der Tribute TELEPHONE von Reference.\n\nMit über 200 Konzerten im Rücken huldigt TELEPHOMME seit 12 Jahren der Gruppe TELEPHONE."
        ],
        "en": [
          "The TÉLÉPHOMME group is the TÉLÉPHONE de Référence tribute.\n\nWith over 200 concerts to its credit, TELEPHOMME has been paying tribute to TELEPHONE for 12 years."
        ],
        "it": [
          "Il gruppo TELEPHOMME è il tributo TELEFONICO di riferimento.\n\nCon oltre 200 concerti all'attivo, i TELEPHOMME rendono omaggio al gruppo TELEPHONE da 12 anni."
        ],
        "fr": [
          "Le groupe TÉLÉPHOMME est le tribute TÉLÉPHONE de Référence.\n\nAvec plus de 200 concerts à son actif, TELEPHOMME rend hommage au groupe TELEPHONE depuis 12 ans."
        ],
        "es": [
          "El grupo TELEPHOMME es el tributo TELEPHONE de referencia.\n\nCon más de 200 conciertos en su haber, TELEPHOMME lleva 12 años rindiendo tributo al grupo TELEPHONE."
        ],
        "nl": [
          "De TELEPHOMME groep is de referentie TELEPHONE tribute.\n\nMet meer dan 200 concerten op zijn naam brengt TELEPHOMME al 12 jaar hulde aan de groep TELEPHONE."
        ]
