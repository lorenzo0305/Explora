  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/36c43211-e1be-3b7c-913a-ab22b2e5af42",
      "dc:description": {
        "de": [
          "Tipps teilen, Emotionen: ein sensibler, praktischer, partizipativer und manchmal lustiger Moment.\n\nEin positiver Abend, eine Wiederverbindung mit sich selbst für ein besseres Morgen."
        ],
        "en": [
          "Sharing tips, emotions: a sensitive, practical, participative and sometimes funny moment.\n\nA positive evening, reconnecting with yourself for a brighter tomorrow."
        ],
        "it": [
          "Condividere consigli, emozioni: un momento delicato, pratico, partecipativo e a volte divertente.\n\nUna serata positiva, per riconnettersi con se stessi per un domani più luminoso."
        ],
        "fr": [
          "Conseils partage, émotions : un moment sensible, pratique, participatif et parfois drôle.\n\nUne soirée positive, une reconnexion avec vous-même pour des lendemains qui chantent."
        ],
        "es": [
          "Compartir consejos, emociones: un momento sensible, práctico, participativo y a veces divertido.\n\nUna velada positiva, de reencuentro con uno mismo para un mañana mejor."
        ],
        "nl": [
          "Advies en emoties delen: een gevoelig, praktisch, participatief en soms grappig moment.\n\nEen positieve avond, opnieuw contact maken met jezelf voor een betere toekomst."
        ]
      },
