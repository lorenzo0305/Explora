  "rdfs:comment": {
    "de": [
      "Gemütliches Restaurant im Stadtzentrum, das Ihnen italienische Spezialitäten anbietet: Pasta, Pizza, Salate...\nNur wenige Schritte vom Hauptplatz entfernt, wo die Statue von Alexandre Dumas dominiert, und in der Nähe der Cité internationale de la langue française - Schloss Villers-Cotterêts"
    ],
    "en": [
      "Cosy restaurant in the center of town, offering Italian specialties: pasta, pizzas, salads...\nA stone's throw from the main square, dominated by the statue of Alexandre Dumas, and close to the Cité internationale de la langue française - château de Villers-Cotterêts"
    ],
    "it": [
      "Accogliente ristorante situato nel centro della città, che offre specialità italiane: pasta, pizza, insalate, ecc.\nA pochi passi dalla piazza principale, dominata dalla statua di Alexandre Dumas, e vicino alla Cité Internationale de la Langue Française - Château de Villers-Cotterêts"
    ],
    "fr": [
      "Restaurant chaleureux situé en centre ville, qui vous propose des spécialités italiennes : pâtes, pizzas, salades.. \nA deux pas de la place principale où domine la statue d'Alexandre Dumas et à proximité de la Cité internationale de la langue française - château de Villers-Cotterêts"
    ],
    "nl": [
      "Gezellig restaurant in het stadscentrum met Italiaanse specialiteiten: pasta's, pizza's, salades, enz.\nOp een steenworp afstand van het centrale plein, gedomineerd door het standbeeld van Alexandre Dumas, en vlakbij de Cité Internationale de la Langue Française - Château de Villers-Cotterêts"
    ],
    "es": [
      "Acogedor restaurante situado en el centro de la ciudad, que ofrece especialidades italianas: pasta, pizzas, ensaladas, etc.\nA dos pasos de la plaza principal, dominada por la estatua de Alexandre Dumas, y cerca de la Cité Internationale de la Langue Française - Château de Villers-Cotterêts"
    ]
  },
  "rdfs:label": {
