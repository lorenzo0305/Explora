  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d44c2d21-46ad-3cd5-a2d7-2757806367bd",
      "dc:description": {
        "de": [
          "Die Mühle Caron in der Nähe des kleinen Platzes, auf dem sich das bekannte Restaurant Le Lignier befindet, war bis vor wenigen Jahren noch in Betrieb. Mühlen in Zérables und Engoudsent."
        ],
        "en": [
          "The Caron mill, near the small square where the well-known restaurant Le Lignier is located, was still in operation until the last few years. Mills at Zérables and Engoudsent."
        ],
        "it": [
          "Il mulino Caron, vicino alla piazzetta dove si trova il noto ristorante Le Lignier, era ancora in funzione fino ad anni recenti. Mulini a Zérables e Engoudsent."
        ],
        "fr": [
          "Le moulin Caron, près de la petite place où se trouve le restaurant Le Lignier, bien connu, était encore en activité jusqu’à ces dernières années. Moulins à  Zérables et Engoudsent."
        ],
        "es": [
          "El molino de Caron, cerca de la pequeña plaza donde se encuentra el conocido restaurante Le Lignier, seguía en funcionamiento hasta hace pocos años. Molinos en Zérables y Engoudsent."
        ],
        "nl": [
          "De molen van Caron, vlakbij het pleintje waar het bekende restaurant Le Lignier is gevestigd, was tot voor kort nog in bedrijf. Molens in Zérables en Engoudsent."
        ]
      },
