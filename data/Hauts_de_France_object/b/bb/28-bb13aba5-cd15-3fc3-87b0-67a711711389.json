  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48823b45-8616-35fd-b92d-70fc23ad2095",
      "dc:description": {
        "de": [
          "Im Geburtsort des Fliegers zeigt das Museum Fotografien, Korrespondenzen, Zeitungen aus der damaligen Zeit, Poster, Modelle, persönliche Gegenstände und Medaillen. Besichtigung nur nach vorheriger Anmeldung möglich."
        ],
        "en": [
          "In the aviator's native village, the museum displays photographs, correspondence, newspapers of the period, posters, models, personal objects and medals. Visits by appointment only."
        ],
        "it": [
          "Nel villaggio in cui nacque l'aviatore, il museo espone fotografie, corrispondenza, giornali dell'epoca, manifesti, modelli, oggetti personali e medaglie. Visite solo su appuntamento."
        ],
        "fr": [
          "Dans le village natal de l'aviateur, le musée présente des photographies, correspondances, journaux de l'époque, affiches, maquettes, objets personnels et médailles. Visite possible uniquement sur rendez-vous."
        ],
        "nl": [
          "In het geboortedorp van de vliegenier toont het museum foto's, correspondentie, kranten uit die tijd, posters, modellen, persoonlijke voorwerpen en medailles. Bezoek alleen op afspraak."
        ],
        "es": [
          "En el pueblo natal del aviador, el museo expone fotografías, correspondencia, periódicos de la época, carteles, maquetas, objetos personales y medallas. Visitas con cita previa."
        ]
      },
