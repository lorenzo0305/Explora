  "rdfs:comment": {
    "de": [
      "Die Ferme des Coudriers ist auf die Ernte von Weizen spezialisiert, aus dem sie verschiedene Arten von Gebäck mit einer großen Auswahl an Keksen herstellt. Ideal für Feinschmecker, die auf der Suche nach den Aromen der Region sind!"
    ],
    "en": [
      "The Coudriers farm specializes in harvesting wheat with which it makes several types of pastries with a wide range of biscuits. Ideal for gourmets in search of local flavours!"
    ],
    "it": [
      "L'azienda agricola Coudriers è specializzata nella raccolta del grano, con il quale produce diversi tipi di pasticceria con una vasta gamma di biscotti. Ideale per i buongustai alla ricerca dei sapori locali!"
    ],
    "fr": [
      "La ferme des Coudriers est spécialisée dans la récolte du blé avec lequel elle fabrique plusieurs types de pâtisseries avec un grand choix de biscuits. Idéal pour les gourmands à la recherche des saveurs du terroir !"
    ],
    "es": [
      "La granja Coudriers está especializada en la recolección de trigo, con el que elabora varios tipos de pastas con una amplia gama de galletas. Ideal para los gourmets en busca de sabores locales"
    ],
    "nl": [
      "De boerderij Coudriers is gespecialiseerd in het oogsten van tarwe, waarmee het verschillende soorten gebak met een breed scala aan koekjes maakt. Ideaal voor fijnproevers op zoek naar lokale smaken!"
    ]
  },
  "rdfs:label": {
