  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8a6996e7-f7dc-3028-9c90-f4e77dc21067",
      "dc:description": {
        "de": [
          "Entdecken Sie den Charme der traditionellen Bauernhöfe der 7 Vallées.\nDie passionierten Franck und Cécile lassen Sie an ihrer Leidenschaft für die Zucht von Rindern teilhaben, die auf ihrem Hof geboren und aufgezogen wurden. Ein Tag auf dem Bauernhof, der nicht wie jeder andere ist!"
        ],
        "en": [
          "Discover the charm of the traditional farms of the 7 Valleys.\nEnthusiasts Franck and Cécile will share their passion for raising cattle born and bred on their farm. A day on the farm like no other!"
        ],
        "it": [
          "Scoprite il fascino delle fattorie tradizionali delle 7 Valli.\nGli appassionati Franck e Cécile condivideranno la loro passione per l'allevamento di bovini nati e cresciuti nella loro fattoria. Una giornata in fattoria come poche!"
        ],
        "fr": [
          "Découvrez le charme des fermes traditionnelles des 7 Vallées. \nFranck et Cécile, des passionnés, vous feront partager leur passion de l'élevage de bovins nés et élevés dans leur exploitation. Un jour à la ferme pas comme les autres !"
        ],
        "nl": [
          "Ontdek de charme van de traditionele boerderijen van de 7 Valleien.\nLiefhebbers Franck en Cécile delen hun passie voor het houden van vee dat op hun boerderij geboren en gefokt is. Een dag op de boerderij als geen ander!"
        ],
        "es": [
          "Descubra el encanto de las granjas tradicionales de los 7 Valles.\nLos entusiastas Franck y Cécile compartirán su pasión por la cría de ganado nacido y criado en su granja. ¡Un día en la granja como ningún otro!"
        ]
      },
      "@type": [
        "Description"
      ],
