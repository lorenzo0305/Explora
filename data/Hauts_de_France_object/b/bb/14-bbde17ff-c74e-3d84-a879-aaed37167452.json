  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f20d3d0f-5de5-315d-b304-d3bebeff5b0a",
      "dc:description": {
        "de": [
          "Ziehen Sie sich einen Imkeranzug an, zünden Sie den Räucherofen an und begeben Sie sich zum Lehrbienenstand von Aquaterra, um unsere Freunde, die Bienen, aus nächster Nähe zu entdecken."
        ],
        "en": [
          "Put on your beekeeping suit, light the smoker and head to Aquaterra?s educational apiary for a close-up look at our friends the bees."
        ],
        "it": [
          "Indossate la vostra tuta da apicoltore, accendete il fumogeno e recatevi all'apiario didattico di Aquaterra per osservare da vicino le nostre amiche api."
        ],
        "fr": [
          "Enfilons notre combinaison d’apiculture, allumons l’enfumoir et dirigeons-nous vers le rucher pédagogique d’Aquaterra pour une découverte, au plus près, de nos amies les abeilles."
        ],
        "nl": [
          "Trek je imkerpak aan, steek de rookoven aan en ga naar de educatieve bijenstal van Aquaterra om onze vrienden de bijen van dichtbij te bekijken."
        ],
        "es": [
          "Póngase el traje de apicultor, encienda el ahumador y diríjase al colmenar educativo de Aquaterra para ver de cerca a nuestras amigas las abejas."
        ]
      },
