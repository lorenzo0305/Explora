  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/16207221-03b1-371b-803b-128a5a51e147",
      "dc:description": {
        "de": [
          "Urban Berck Wave-Konzert auf dem Place de l'Entonnoir am Samstag, den 9. August um 20 Uhr ? Kostenloser Tarif\n\nDas Urban Berck Waves kehrt für eine dritte Ausgabe unter freiem Himmel zurück, die kostenlos und überdreht ist! Prägnanter Rap, festlicher Electro und immersive Bühnenperformances werden den Rhythmus dieses großen Abends am Meer bestimmen."
        ],
        "en": [
          "Urban Berck Wave concert on the Place de l?Entonnoir on Saturday August 9th at 8pm ? Free admission\n\nUrban Berck Waves returns for a 3rd edition of free, over-the-top, open-air concerts! Incisive rap, festive electro and immersive stage performances will punctuate this great evening overlooking the sea."
        ],
        "it": [
          "Concerto di Urban Berck Wave in Place de l'Entonnoir sabato 9 agosto alle 20.00? Ingresso libero\n\nUrban Berck Waves torna per la terza volta con un evento gratuito e all'aperto! Rap incisivo, electro festosa e performance coinvolgenti scandiranno questa grande serata di fronte al mare."
        ],
        "fr": [
          "Concert Urban Berck Wave sur la place de l’Entonnoir le samedi 9 août à 20h   – Tarif Gratuit \n\nL'Urban Berck Waves revient pour une 3ème édition en plein air, gratuite et survoltée ! Rap incisif, éléctro festive et performances scéniques immersives rythmeront cette grande soirée face à la mer."
        ],
        "nl": [
          "Urban Berck Wave concert op de Place de l?Entonnoir op zaterdag 9 augustus om 20u ? Gratis toegang\n\nUrban Berck Waves is terug voor een 3e gratis openluchtevenement! Indringende rap, feestelijke electro en meeslepende podiumoptredens bepalen het ritme van deze geweldige avond met uitzicht op zee."
        ],
        "es": [
          "Concierto de Urban Berck Wave en la plaza de l'Entonnoir el sábado 9 de agosto a las 20.00 horas ? Entrada gratuita\n\nUrban Berck Waves vuelve por tercera vez al aire libre y de forma gratuita Rap incisivo, electro festivo y espectáculos envolventes marcarán el ritmo de esta gran velada frente al mar."
        ]
      },
