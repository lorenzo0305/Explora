  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/67606b9d-5e8e-34e7-97c3-d97091c737f9",
      "dc:description": {
        "de": [
          "Die Fabrik&co empfängt Sie in einer entspannten und herzlichen Atmosphäre und bietet Ihnen eine 100% hausgemachte Küche zwischen Frankreich und Italien.\nUnd an einem Freitag im Monat gibt es ein Dinner-Konzert!"
        ],
        "en": [
          "Fabrik&co welcomes you in a warm and relaxed atmosphere, offering 100% homemade cuisine from France and Italy.\nAnd one Friday a month, enjoy the sounds of a dinner concert!"
        ],
        "it": [
          "Fabrik&co offre un'atmosfera calda e rilassata e una cucina francese e italiana fatta al 100% in casa.\nE un venerdì al mese, venite a godervi il suono di una cena concerto!"
        ],
        "fr": [
          "La Fabrik&co vous accueille dans une ambiance décontractée et chaleureuse et vous propose une cuisine 100% fait maison entre la France et l'Italie.\nEt un vendredi par mois venez vibrer au son d'un dîner-concert !"
        ],
        "es": [
          "Fabrik&co ofrece un ambiente cálido y relajado y cocina francesa e italiana 100% casera.\nY un viernes al mes, ¡ven a disfrutar de los sonidos de una cena-concierto!"
        ],
        "nl": [
          "Fabrik&co biedt een warme, ontspannen sfeer en 100% huisgemaakte Franse en Italiaanse gerechten.\nEn één vrijdag per maand kun je genieten van de klanken van een dinerconcert!"
        ]
      },
      "@type": [
        "Description"
      ],
