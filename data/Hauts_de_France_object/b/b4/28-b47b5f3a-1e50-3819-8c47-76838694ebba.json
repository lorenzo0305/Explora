  "rdfs:comment": {
    "de": [
      "Les Frangines, eine unumgängliche Adresse im Stadtzentrum von Dünkirchen in einer Straße, die nur wenige Schritte vom Belfried von Saint Eloi entfernt ist. Dieses traditionelle Restaurant lädt Sie ein, seine Spezialitäten zu probieren: Rippchen am Knochen, Pfeffersteak, Kutteln und gegrillte Schweinefüße, Kalbsleber und Potjevlesch..."
    ],
    "en": [
      "Les Frangines, an address not to be missed in the city center of Dunkerque in a street close to the Belfry of Saint Eloi. This traditional restaurant proposes you to taste its specialities: ribs with the bone, paved with pepper, tripe and grilled pig's feet, calf's liver and potjevlesch..."
    ],
    "it": [
      "Les Frangines, un indirizzo da non perdere nel centro di Dunkerque, in una strada a due passi dal Campanile di Saint Eloi. Questo ristorante tradizionale vi propone di assaggiare le sue specialità: costine con l'osso, pavé au poivre, trippa e zampe di maiale alla griglia, fegato di vitello e potjevlesch..."
    ],
    "fr": [
      "Les Frangines, une adresse incontournable au centre ville de Dunkerque dans une rue à deux pas du Beffroi de Saint Eloi. Ce restaurant traditionnel vous propose de déguster ses spécialités : côtes à l'os, pavé au poivre, tripes et pieds de porc grillés, foie de veau et potjevlesch..."
    ],
    "es": [
      "Les Frangines, una dirección ineludible en el centro de Dunkerque, en una calle a dos pasos del campanario de Saint Eloi. Este restaurante tradicional le propone degustar sus especialidades: costillas con hueso, pavé au poivre, callos y patas de cerdo a la parrilla, hígado de ternera y potjevlesch..."
    ],
    "nl": [
      "Les Frangines, een niet te missen adres in het centrum van Duinkerke, in een straat op een steenworp afstand van het Belfort van Saint Eloi. In dit traditionele restaurant kunt u zijn specialiteiten proeven: beenribben, pavé au poivre, pens en gegrilde varkenspoten, kalfslever en potjevlesch..."
    ]
  },
