  "rdfs:comment": {
    "de": [
      "\"Treffen Sie am 18. und 19. April 2026 in der Halle Michel Carpentier in Hirson Handwerker, Fachleute, Vereine und Künstler, die sich auf die Welt des Mittelalters und der Fantasy spezialisiert haben. Eintritt frei und Verpflegung vor Ort möglich. Für die Kleinsten und die Größten sind Animationen vorgesehen. Weitere Informationen: 07 86 87 55 18\""
    ],
    "en": [
      "\"On April 18 and 19, 2026, at the Salle Michel Carpentier in Hirson, come and meet craftsmen, professionals, associations and artists specializing in the medieval and fantasy worlds. Free admission and on-site catering available. Activities are planned for young and old alike. Further information: 07 86 87 55 18\""
    ],
    "it": [
      "\"Il 18 e 19 aprile 2026, presso la Salle Michel Carpentier di Hirson, venite a incontrare artigiani, professionisti, associazioni e artisti specializzati nel mondo medievale e fantasy. Ingresso gratuito e ristorazione in loco. Non mancherà l'intrattenimento per grandi e piccini. Per ulteriori informazioni: 07 86 87 55 18\""
    ],
    "fr": [
      "\"Les 18 et 19 avril 2026, à la salle Michel Carpentier, à Hirson, venez à la rencontre d'artisans, de professionnels, d'associations et d'artistes spécialisés dans l'univers médiéval et fantastique. Entrée gratuite et restauration sur place possible. Des animations sont prévues pour les plus petits et les plus grands. Informations complémentaires : 07 86 87 55 18\""
    ],
    "nl": [
      "\"Kom op 18 en 19 april 2026 in de Salle Michel Carpentier in Hirson kennismaken met ambachtslieden, professionals, verenigingen en kunstenaars die gespecialiseerd zijn in de middeleeuwse en fantasiewereld. Gratis toegang en catering ter plaatse. Er is animatie voor jong en oud. Meer informatie: 07 86 87 55 18\""
    ],
    "es": [
      "\" Los días 18 y 19 de abril de 2026, en la Sala Michel Carpentier de Hirson, venga al encuentro de artesanos, profesionales, asociaciones y artistas especializados en el mundo medieval y fantástico. Entrada gratuita y restauración in situ. Habrá animaciones para grandes y pequeños. Más información: 07 86 87 55 18\""
    ]
  },
