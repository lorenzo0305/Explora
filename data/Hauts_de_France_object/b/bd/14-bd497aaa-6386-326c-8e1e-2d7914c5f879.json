  "rdfs:comment": {
    "de": [
      "La vie en vrai?erzählt, wie das poetische und politische Erbe von Anne Sylvestre in den Lebensläufen zweier Künstler in ihren Dreißigern in den 2020er Jahren nachhallt."
    ],
    "en": [
      "La vie en vrai?tells the story of how Anne Sylvestre?s poetic and political legacy resonates in the careers of two thirty-something artists of the 2020s."
    ],
    "it": [
      "La vie en vrai racconta come l'eredità poetica e politica di Anne Sylvestre risuoni nelle carriere di due artisti trentenni del 2020."
    ],
    "fr": [
      "La vie en vrai raconte la façon dont l’héritage poétique et politique d’Anne Sylvestre résonne dans le parcours de deux artistes trentenaires des années 2020."
