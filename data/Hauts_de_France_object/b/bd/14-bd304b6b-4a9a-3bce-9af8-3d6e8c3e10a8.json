  "rdfs:comment": {
    "de": [
      "Die Ayoms sind musikalische Seefahrer, die den Atlantik von Brasilien über Angola und die Kapverden bis zum Mittelmeer überqueren."
    ],
    "en": [
      "Ayom are musical navigators who cross the Atlantic, from Brazil to Angola and Cape Verde, all the way to the Mediterranean."
    ],
    "it": [
      "Gli Ayom sono navigatori musicali che attraversano l'Atlantico, dal Brasile all'Angola e a Capo Verde, fino al Mediterraneo."
    ],
    "fr": [
      "Les Ayom sont des navigateurs musicaux qui traversent l'Atlantique, du Brésil à l'Angola et au Cap Vert, jusqu'à la Méditerranée."
    ],
    "es": [
      "Los ayom son navegantes musicales que cruzan el Atlántico, desde Brasil a Angola y Cabo Verde, hasta el Mediterráneo."
    ],
    "nl": [
      "Ayom zijn muzikale navigators die de Atlantische Oceaan oversteken, van Brazilië naar Angola en Kaapverdië, helemaal tot aan de Middellandse Zee."
    ]
  },
