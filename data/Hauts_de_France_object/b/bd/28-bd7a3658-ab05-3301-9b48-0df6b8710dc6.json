  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Haus von Abbé Lemire, in dem er 28 Jahre lang lebte. Sein Leben und sein Werk sind hier ausgestellt. Möbel aus dem frühen 20. Jahrhundert. Jahrhunderts. 6 thematische Rundgänge möglich."
    ],
    "en": [
      "Discover Abbé Lemire's home, where he lived for 28 years. His life and work are on display. Early 20th-century furniture. Office preserved in its original state. 6 thematic tours available."
    ],
    "it": [
      "Scoprite la casa in cui l'Abbé Lemire ha vissuto per 28 anni. La sua vita e le sue opere sono esposte. Mobili dell'inizio del XX secolo. Lo studio è stato conservato nel suo stato originale. Sono possibili 6 visite guidate a tema."
    ],
    "fr": [
      "Découvrez la maison de l'Abbé Lemire où il y vécut 28 ans. Sa vie et son œuvre y sont exposées. Mobilier du début du xx° siècle. Bureau conservé en l'état. 6 parcours thématiques sont possibles."
    ],
    "nl": [
      "Ontdek het huis waar Abbé Lemire 28 jaar heeft gewoond. Zijn leven en werk worden tentoongesteld. Meubels uit het begin van de 20e eeuw. De werkkamer is in originele staat bewaard gebleven. Er zijn 6 themarondleidingen mogelijk."
    ],
    "es": [
      "Descubra la casa donde vivió el abate Lemire durante 28 años. Se exponen su vida y su obra. Muebles de principios del siglo XX. El estudio se ha conservado en su estado original. Hay 6 posibles visitas temáticas."
    ]
  },
