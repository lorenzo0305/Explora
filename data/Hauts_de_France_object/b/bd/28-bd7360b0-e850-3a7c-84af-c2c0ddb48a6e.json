  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/88a9039e-9398-3b0f-832f-0219a00f5a70",
      "dc:description": {
        "de": [
          "Bar, Restaurant und Konzertsaal.\n\t\nDie Bar :\nSmarter, gemütlicher Rahmen und entspannte Atmosphäre. Sehr große Auswahl an Cocktails\n\t\nDas Restaurant :\nDas Restaurant verfügt über eine Panoramafensterfront mit Blick auf die Stadt. Lounge-Ambiente.\n\t\nEs besteht die Möglichkeit, die Bar und das Restaurant zu privatisieren.\nCocktail-Dinner."
        ],
        "en": [
          "Bar, restaurant and concert hall.\n\t\nThe Bar:\nSmart, cosy setting and relaxing atmosphere. Wide choice of cocktails\n\t\nRestaurant:\nThe restaurant features a panoramic bay window overlooking the city. Lounge atmosphere.\n\t\nThe bar and restaurant can be privatized.\nCocktail reception."
        ],
        "it": [
          "Bar, ristorante e sala concerti.\n\t\nIl Bar :\nAmbiente elegante e accogliente e atmosfera rilassante. Ampia scelta di cocktail\n\t\nIl ristorante :\nIl ristorante dispone di una finestra panoramica con vista sulla città. Atmosfera lounge.\n\t\nIl bar e il ristorante possono essere resi privati.\nCocktail di benvenuto."
        ],
        "fr": [
          "Bar, restaurant et salle de concert.\n\t\nLe Bar :\nCadre smart, cosy et ambiance détente. Très grand choix de cocktails\n\t\nLe Restaurant :\nLe restaurant dispose d'une baie vitrée panoramique qui donne sur la ville. Ambiance lounge.\n\t\nPossibilité de privatiser le bar et le restaurant.\nCocktail dinatoire."
        ],
        "es": [
          "Bar, restaurante y sala de conciertos.\n\t\nEl Bar :\nAmbiente elegante, acogedor y relajante. Amplia selección de cócteles\n\t\nEl Restaurante :\nEl restaurante tiene un ventanal panorámico con vistas a la ciudad. Ambiente de salón.\n\t\nEl bar y el restaurante pueden hacerse privados.\nRecepción con cócteles."
        ],
        "nl": [
          "Bar, restaurant en concertzaal.\n\t\nDe Bar :\nSlim, gezellig kader en ontspannen sfeer. Ruime keuze aan cocktails\n\t\nHet Restaurant :\nHet restaurant heeft een panoramische erker met uitzicht over de stad. Lounge sfeer.\n\t\nDe bar en het restaurant kunnen privé worden gemaakt.\nCocktailreceptie."
        ]
      },
