      "dc:description": {
        "de": [
          "Drei Zeugen teilen ihre Geschichte, Zuschauer werden zu Fährmännern und es bildet sich eine Kette, zerbrechlich und sensibel."
        ],
        "en": [
          "Three witnesses share their stories, spectators become passers-by, and a fragile, sensitive chain is formed."
        ],
        "it": [
          "Tre testimoni condividono le loro storie, gli spettatori diventano intermediari e si forma una catena fragile e sensibile."
        ],
        "fr": [
          "Trois témoins partagent leur histoire, des spectateurs deviennent passeurs et une chaîne se forme, fragile et sensible."
        ],
        "es": [
          "Tres testigos comparten sus historias, los espectadores se convierten en intermediarios y se forma una cadena frágil y sensible."
        ],
        "nl": [
          "Drie getuigen delen hun verhaal, toeschouwers worden tussenpersonen en er ontstaat een fragiele, gevoelige ketting."
        ]
      },
