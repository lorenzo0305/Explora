      "dc:description": {
        "de": [
          "Tage der Öffnung :\nMittwoch bis Samstag von 18:30 bis 21:30 Uhr\n\nReservierungen:\nPer SMS an 06 28 92 71 70 von 10:00 bis 16:00 Uhr,\nper Telefon unter 09 83 31 53 86 ab 17 Uhr"
        ],
        "en": [
          "Opening days :\nWednesday to Saturday, 6:30 pm to 9:30 pm\n\nReservations :\nBy sms to 06 28 92 71 70 from 10am to 4pm,\nby telephone on 09 83 31 53 86 from 5pm onwards"
        ],
        "it": [
          "Orari di apertura :\nDa mercoledì a sabato, dalle 18.30 alle 21.30\n\nPrenotazioni :\nPer SMS al numero 06 28 92 71 70 dalle 10.00 alle 16.00,\nper telefono al numero 09 83 31 53 86 dalle ore 17.00"
        ],
        "fr": [
          "Jours d'ouverture : \nDu mercredi au samedi de 18h30 à 21h30\n\nReservation :\nPar sms au 06 28 92 71 70 de 10h à 16h,\npar téléphone au 09 83 31 53 86 à partir de 17h"
        ],
        "nl": [
          "Openingstijden :\nWoensdag tot zaterdag, 18.30 tot 21.30 uur\n\nReserveringen :\nPer sms op 06 28 92 71 70 van 10 tot 16 uur,\ntelefonisch op 09 83 31 53 86 vanaf 17.00 uur"
        ],
        "es": [
          "Horario de apertura :\nDe miércoles a sábado, de 18.30 h a 21.30 h\n\nReservas :\nPor SMS al 06 28 92 71 70 de 10.00 a 16.00 h,\npor teléfono al 09 83 31 53 86 a partir de las 17.00 horas"
        ]
      },
