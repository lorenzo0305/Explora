  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/26a997c2-ee56-32e1-b937-8181f4e40bd1",
      "dc:description": {
        "de": [
          "Verbringen Sie eine gute Zeit in der Gorilla Bar Lounge, die gelegentlich Themenabende veranstaltet.\nHier können Sie Feinschmeckerbretter oder auch Obstspieße zum Nachtisch genießen"
        ],
        "en": [
          "Come and have a good time at the Gorilla Bar lounge, which organizes themed evenings from time to time.\nEnjoy gourmet platters or fruit brochettes for dessert"
        ],
        "it": [
          "Venite a divertirvi nella lounge del Gorilla Bar, che di tanto in tanto organizza serate a tema.\nPotrete gustare piatti gourmet o brochette di frutta come dessert"
        ],
        "fr": [
          "Venez passer un bon moment au Gorilla Bar lounge qui organise ponctuellement des soirées thématiques.\nVous pourrez y déguster des planches gourmandes ou encore des brochettes de fruits pour le dessert"
        ],
        "es": [
          "Venga a divertirse al salón Gorilla Bar, que organiza veladas temáticas de vez en cuando.\nPodrá degustar platos gastronómicos o brochetas de frutas de postre"
        ],
        "nl": [
          "Kom en vermaak je in de lounge van de Gorilla Bar, die van tijd tot tijd thema-avonden organiseert.\nJe kunt genieten van gastronomische schotels of fruitbrochettes als dessert"
        ]
      },
