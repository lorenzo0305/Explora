  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9326bd02-c67c-31ac-ab41-0a764c7e6efe",
      "dc:description": {
        "de": [
          "Nutzen Sie die Gärten von Nausicaá zum Flanieren, aber auch, um in einer schattigen und grünen Umgebung Minigolf zu üben\nPreise: 6/Erwachsener und 5/Kind"
        ],
        "en": [
          "Take a stroll through the Jardins de Nausicaá and play mini-golf in a shady, leafy setting\nRates: 6/adult and 5/child"
        ],
        "it": [
          "Approfittate dei Jardins de Nausicaá per passeggiare e giocare a minigolf in un ambiente ombreggiato e verdeggiante\nPrezzi: 6€/adulto e 5€/bambino"
        ],
        "fr": [
          "Profitez des Jardins de Nausicaá pour flâner mais également pour exercer au mini-golf dans un cadre ombragé et verdoyant\nTarifs : 6€/adulte et 5€/enfant"
        ],
        "nl": [
          "Maak gebruik van de Jardins de Nausicaá om rond te wandelen en minigolf te spelen in een schaduwrijke, groene omgeving\nPrijzen: 6€/volwassene en 5€/kind"
        ],
        "es": [
          "Aproveche los Jardines de Nausicaá para pasear y jugar al minigolf en un entorno sombreado y frondoso\nPrecios: 6€/adulto y 5€/niño"
        ]
      },
