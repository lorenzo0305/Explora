  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/823a9cbf-81a7-36e2-8d7a-76b759d7665a",
      "dc:description": {
        "de": [
          "Jonglieren, Akrobatik, Balancieren auf Objekten?\nLassen Sie sich in die Zirkuskünste einführen und sehen Sie sich Vorführungen der Zirkusschule Cirqu?en Cavale an."
        ],
        "en": [
          "Juggling, acrobatics, balancing on objects?\nCome and discover the circus arts and watch demonstrations by the Cirqu?en Cavale circus school."
        ],
        "it": [
          "Giocoleria, acrobazie, equilibrismo su oggetti?\nVenite a cimentarvi nelle arti circensi e assistete alle dimostrazioni della scuola di circo Cirqu?en Cavale."
        ],
        "fr": [
          "Jonglerie, acrobaties, équilibre sur objets…\nVenez vous initier aux arts du cirque et assister à des démonstrations par l’école de cirque Cirqu’en Cavale."
        ],
        "es": [
          "¿Malabares, acrobacias, equilibrios sobre objetos?\nVenga a probar las artes circenses y asista a las demostraciones de la escuela de circo Cirqu'en Cavale."
        ],
        "nl": [
          "Jongleren, acrobatiek, balanceren op voorwerpen?\nKom de circuskunsten uitproberen en bekijk demonstraties van de circusschool Cirqu?en Cavale."
        ]
      },
