  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c227bb0a-80eb-32b5-aeb0-af2fd44f9060",
      "dc:description": {
        "de": [
          "\"Geselliger Ort, an dem unsere Gäste eine gute Zeit verbringen werden!\"\nAlle Arten von Musik.\n\n1 großer Saal mit Platz für 40 Sitz- oder 100 Stehplätze.\nKleine Snacks: Wurst (glutenfrei von Le Fouet), Bio- und glutenfreies Bier, Brettchen und Terrinen."
        ],
        "en": [
          "\"Friendly place where our customers will have a great time!\"\nAll types of music.\n\n1 large room with seating for 40 or standing room for 100.\nSnacks: sausage (gluten-free from Le Fouet), organic and gluten-free beer, boards and terrines."
        ],
        "it": [
          "\"Un luogo amichevole dove i nostri clienti si divertiranno un mondo!\"\nTutti i tipi di musica.\n\n1 grande sala con 40 posti a sedere o 100 in piedi.\nSpuntini: salsiccia (senza glutine di Le Fouet), birra biologica e senza glutine, taglieri e terrine."
        ],
        "fr": [
          "\"Lieu convivial où nos clients passeront un bon moment !\"\nTous types de musique.\n\n1 grande salle pouvant accueillir 40 places assises ou 100 places debout.\nPetite restauration : saucisson (sans gluten du Fouet), bière bio et sans gluten, planches et terrines."
        ],
        "es": [
          "\"¡Un lugar acogedor donde nuestros clientes se lo pasarán en grande!\"\nTodo tipo de música.\n\n1 gran sala con capacidad para 40 personas sentadas o 100 de pie.\nAperitivos: salchichas (sin gluten de Le Fouet), cerveza ecológica y sin gluten, tablas y terrinas."
        ],
        "nl": [
          "\"Vriendelijke plek waar onze klanten een geweldige tijd zullen hebben!\"\nAlle soorten muziek.\n\n1 grote zaal met 40 zitplaatsen of 100 staanplaatsen.\nSnacks: worst (glutenvrij van Le Fouet), biologisch en glutenvrij bier, planken en terrines."
        ]
      },
      "@type": [
        "Description"
      ],
