      "dc:description": {
        "de": [
          "Komm und entdecke diesen Sport, der mit einer Scheibe namens Frisbee ausgeübt wird - Ab 6 Jahren - Anmeldung im Office de Tourisme erforderlich - Treffpunkt an der Strandpromenade in Sainte Cécile"
        ],
        "en": [
          "Come and discover this sport played with a disc called Frisbee - From 6 years old - Registration required at the Tourist Office - Meeting point on the seafront in Sainte Cécile"
        ],
        "it": [
          "Venite a scoprire questo sport che si pratica con un disco chiamato frisbee - A partire dai 6 anni - Iscrizione obbligatoria presso l'Ufficio del Turismo - Punto d'incontro sul lungomare di Sainte Cécile"
        ],
        "fr": [
          "Viens découvrir ce sport qui se pratique avec un disque appelé Frisbee - A partir de 6 ans - Inscription indispensable à l'Office de Tourisme - RDV sur le front de mer à Sainte Cécile"
        ],
        "es": [
          "Venga a descubrir este deporte que se practica con un disco llamado frisbee - A partir de 6 años - Inscripción obligatoria en la Oficina de Turismo - Punto de encuentro en el paseo marítimo de Sainte Cécile"
        ],
        "nl": [
          "Kom en ontdek deze sport die wordt gespeeld met een schijf die frisbee wordt genoemd - Vanaf 6 jaar - Inschrijving verplicht bij het VVV-kantoor - Trefpunt aan de kust in Sainte Cécile"
        ]
      },
