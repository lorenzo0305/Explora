  "rdfs:comment": {
    "de": [
      "Wir laden Sie ein, unsere warme, freundliche Umgebung zu entdecken und unsere Familiengerichte mit reichem und vielfältigem Geschmack in unserem Restaurant im Herzen der historischen Stadt Bouchain, einer Etappenstadt von Santiago de Compostela, mit Blick auf den Turm von Ostrevant zu probieren."
    ],
    "en": [
      "We invite you to come and discover our warm and friendly setting and taste our family dishes with rich and varied tastes in our restaurant located in the heart of the historic town of Bouchain, a stopover town of Saint Jacques de Compostelle, with a view of the Ostrevant tower."
    ],
    "it": [
      "Vi invitiamo a scoprire il nostro ambiente caldo e accogliente e a gustare i nostri ricchi e variegati piatti familiari nel nostro ristorante situato nel cuore del centro storico di Bouchain, città di tappa di Santiago de Compostela, con vista sulla torre Ostrevant."
    ],
    "fr": [
      "Nous vous invitons à venir découvrir notre cadre chaleureux, convivial et déguster nos plats familiaux aux goûts riches et variés dans notre restaurant situé au cœur de la ville historique de Bouchain, ville étape de Saint Jacques de Compostelle, avec vue sur la tour d’Ostrevant."
    ],
    "nl": [
      "Wij nodigen u uit om onze warme en vriendelijke omgeving te komen ontdekken en onze rijke en gevarieerde familie gerechten te proeven in ons restaurant gelegen in het hart van de historische stad Bouchain, een tussenstop voor Santiago de Compostela, met uitzicht op de Ostrevant toren."
    ],
    "es": [
      "Le invitamos a descubrir nuestro ambiente cálido y acogedor y a degustar nuestros ricos y variados platos familiares en nuestro restaurante situado en el corazón de la histórica ciudad de Bouchain, ciudad de paso hacia Santiago de Compostela, con vistas a la torre de Ostrevant."
    ]
  },
