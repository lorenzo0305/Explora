  "rdfs:comment": {
    "de": [
      "Große Auswahl an Galettes und Crêpes, knusprig wie in der Südbretagne, weich und geschmeidig wie in der Côtes d'Armor.\nGrillen Sie von Juni bis September in den Gärten."
    ],
    "en": [
      "Wide choice of pancakes and crêpes, crispy as in South Brittany, soft and supple as in Côtes d'Armor.\nBarbecues from June to September in the gardens."
    ],
    "it": [
      "Ampia scelta di galettes e crêpes, croccanti come nel sud della Bretagna, morbide e soffici come nelle Côtes d'Armor.\nGrigliate da giugno a settembre nei giardini."
    ],
    "fr": [
      "Larges choix de galettes et de crêpes, croustillantes comme en Bretagne du Sud, moelleuses et souples comme en Côtes d'Armor.\nGrillades de Juin à Septembre dans les jardins."
    ],
    "nl": [
      "Ruime keuze aan galettes en crêpes, knapperig zoals in Zuid-Bretagne, zacht en soepel zoals in Côtes d'Armor.\nGegrilde gerechten van juni tot september in de tuinen."
    ],
    "es": [
      "Amplia selección de galettes y crêpes, crujientes como en el sur de Bretaña, suaves y blandas como en Côtes d'Armor.\nComida a la parrilla de junio a septiembre en los jardines."
    ]
  },
