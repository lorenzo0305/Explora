  "rdfs:comment": {
    "de": [
      "Mit Blick auf das Meer bietet Ihnen Rest'o Soleil eine traditionelle Qualitätsküche, Fish & Chips, Kabeljau-Rücken mit Chorizo, Gambas mit Knoblauch und Chili und natürlich die Muscheln aus Dünkirchen! Das Ganze in einem warmen und einladenden Rahmen."
    ],
    "en": [
      "With a view on the sea, Rest'o Soleil offers you a traditional cuisine of quality, fish & chips, cod with chorizo, gambas with garlic and pepper and of course the mussels of Dunkerque! All this in a warm and welcoming setting."
    ],
    "it": [
      "Con vista sul mare, Rest'o Soleil offre una cucina tradizionale di qualità, fish and chips, merluzzo con chorizo, gamberi con aglio e peperoncino e, naturalmente, cozze di Dunkerque! Il tutto in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Avec vue sur la mer, Rest'o Soleil vous propose une cuisine traditionnelle de qualité, Fish & chips, dos de cabillaud au chorizo, gambas à l'ail et piment et bien sur les moules de Dunkerque ! Le tout dans un cadre chaleureux et accueillant."
    ],
    "nl": [
      "Met uitzicht op zee biedt Rest'o Soleil een traditionele kwaliteitskeuken, fish and chips, kabeljauw met chorizo, garnalen met knoflook en chili en natuurlijk Duinkerke mosselen! Dit alles in een warm en gastvrij kader."
    ],
    "es": [
      "Con vistas al mar, Rest'o Soleil ofrece cocina tradicional de calidad, fish and chips, bacalao con chorizo, gambas al ajillo y guindilla y, por supuesto, mejillones de Dunkerque Todo ello en un ambiente cálido y acogedor."
    ]
  },
