  "rdfs:comment": {
    "de": [
      "La Meute liefert ein tragikomisches Kabarett von großer kommunikativer Energie, eine witzige und absurde Feier der Stärke des menschlichen Geistes im Angesicht von Widrigkeiten."
    ],
    "en": [
      "La Meute delivers a tragi-comic cabaret of great communicative energy, a funny and absurd celebration of the strength of the human spirit in the face of adversity."
    ],
    "it": [
      "La Meute offre un cabaret tragicomico di grande energia comunicativa, una celebrazione divertente e assurda della forza dello spirito umano di fronte alle avversità."
    ],
    "fr": [
      "La Meute livre un cabaret tragi-comique d’une grande énergie communicative, une célébration drôle et absurde de la force de l’esprit humain face à l’adversité."
    ],
    "es": [
