  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt in einer angenehmen Umgebung gelegen, genießen Sie in unserer Pataterie La Fringale eine traditionelle Küche mit einem ausgezeichneten Preis-Leistungs-Verhältnis.\n\nSamstagmittag, Sonntagabend und Montag geschlossen."
    ],
    "en": [
      "Located in the heart of the city in a pleasant setting, come and enjoy traditional cuisine with excellent value for money in our Pataterie La Fringale.\n\nClosed Saturday lunch, Sunday evening and Monday."
    ],
    "it": [
      "Nel cuore della città, in un ambiente piacevole, venite a gustare la cucina tradizionale con un ottimo rapporto qualità-prezzo nella nostra Patateria La Fringale.\n\nChiuso il sabato a pranzo, la domenica sera e il lunedì."
    ],
    "fr": [
      "Situé au cœur de la ville dans un cadre agréable, venez déguster une cuisine traditionnelle avec un excellent rapport qualité prix dans notre Pataterie La Fringale.\n\nFermé le samedi midi, le dimanche soir et le lundi."
    ],
    "es": [
      "Situada en el corazón de la ciudad en un entorno agradable, venga a disfrutar de la cocina tradicional con una excelente relación calidad-precio en nuestra Pataterie La Fringale.\n\nCerrado el sábado al mediodía, el domingo por la noche y el lunes."
    ],
    "nl": [
      "Gelegen in het hart van de stad in een aangename omgeving, kunt u in onze Pataterie La Fringale genieten van een traditionele keuken met een uitstekende prijs-kwaliteitverhouding.\n\nGesloten op zaterdagmiddag, zondagavond en maandag."
    ]
  },
  "rdfs:label": {
