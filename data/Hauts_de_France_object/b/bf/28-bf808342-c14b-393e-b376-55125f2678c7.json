  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/51274125-b586-326a-8de5-747c7fd52a0b",
      "dc:description": {
        "de": [
          "Freuen Sie sich auf eine abwechslungsreiche Speisekarte mit leckeren Gerichten wie Wokgerichten, Gegrilltem, Fondue Chinoise und sogar Sushi."
        ],
        "en": [
          "Come and discover a varied menu with tasty dishes such as wok cuisine, grilled meats, Chinese fondue and even sushi."
        ],
        "it": [
          "Venite a scoprire un menu vario con piatti gustosi come la cucina wok, le carni alla griglia, la fonduta cinese e persino il sushi."
        ],
        "fr": [
          "Venez découvrir une carte variée avec des plats savoureux tels que de la cuisine au wok, des grillades, de la fondue chinoise et même des sushis."
        ],
        "es": [
          "Venga y descubra un menú variado con sabrosos platos como cocina wok, carnes a la parrilla, fondue china e incluso sushi."
        ],
        "nl": [
          "Kom en ontdek een gevarieerd menu met smakelijke gerechten zoals wokgerechten, gegrild vlees, Chinese fondue en zelfs sushi."
        ]
      },
