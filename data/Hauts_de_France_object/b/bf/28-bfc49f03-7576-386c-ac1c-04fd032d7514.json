  "rdfs:comment": {
    "de": [
      "Die Zucht im Sumpfgebiet von Clastres ist ein pädagogischer Bauernhof, auf dem Kinder aller Niveaus mit Tieren in Kontakt kommen können, insbesondere mit den ungewöhnlichen und seltenen Anden-Alpakas, aber auch mit Eseln, Kaninchen oder Ziegen."
    ],
    "en": [
      "The breeding of the marsh of Clastres is an educational farm which allows children of all levels to meet animals, and in particular the unusual and rare Alpacas of the Andes, but also donkeys, rabbits or goats."
    ],
    "it": [
      "La Fattoria della Palude di Clastres è una fattoria didattica che permette ai bambini di ogni livello di incontrare gli animali, in particolare gli insoliti e rari alpaca andini, ma anche asini, conigli o capre."
    ],
    "fr": [
      "L'élevage du marais de Clastres est une ferme pédagogique qui permet aux enfants de tous niveaux de partir à la rencontre des animaux, et notamment des insolites et rares Alpagas des Andes, mais aussi des ânes, lapins ou des chêvres."
    ],
    "es": [
      "La Granja del Pantano de Clastres es una granja educativa que permite a los niños de todos los niveles conocer animales, en particular las insólitas y raras alpacas andinas, pero también burros, conejos o cabras."
    ],
    "nl": [
      "De Clastres Marsh Farm is een educatieve boerderij waar kinderen van alle niveaus dieren kunnen ontmoeten, met name de bijzondere en zeldzame Andes-alpaca's, maar ook ezels, konijnen of geiten."
    ]
  },
  "rdfs:label": {
    "fr": [
