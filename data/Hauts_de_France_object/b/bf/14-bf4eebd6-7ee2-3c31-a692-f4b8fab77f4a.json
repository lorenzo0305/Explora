  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08dda48d-15d2-3972-b4b9-b8d57681e4d0",
      "dc:description": {
        "de": [
          "Die Fermette des Trois Tilleuls in Bezinghem bietet Wandertouren für die ganze Familie im Rhythmus der Alpakas an. Eine einzigartige und authentische Wanderung zur Freude von Groß und Klein."
        ],
        "en": [
          "La Fermette des Trois Tilleuls in Bezinghem offers family hikes to the rhythm of the alpacas. A unique and authentic walk for young and old alike."
        ],
        "it": [
          "La Fermette des Trois Tilleuls di Bezinghem propone passeggiate per famiglie al ritmo degli alpaca. Una passeggiata unica e autentica che farà la gioia di grandi e piccini."
        ],
        "fr": [
          "La Fermette des Trois Tilleuls à Bezinghem vous propose des randonnées pédestres en famille, au rythme des alpagas. Une promenade unique et authentique pour le plaisir des petits et grands."
        ],
        "es": [
          "La Fermette des Trois Tilleuls, en Bezinghem, ofrece paseos familiares al ritmo de las alpacas. Un paseo único y auténtico que hará las delicias de grandes y pequeños."
        ],
        "nl": [
          "La Fermette des Trois Tilleuls in Bezinghem biedt gezinswandelingen op het ritme van de alpaca's. Een unieke en authentieke wandeling voor groot en klein."
        ]
      },
