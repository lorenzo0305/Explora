      "@id": "https://data.datatourisme.fr/ffcec22d-c949-338a-adbd-96301cdeafb3",
      "dc:description": {
        "de": [
          "Beachsoccer-Turnier ab 18 Uhr im Stade de Plage.\nOrganisiert von der Sportabteilung des Rathauses von Camiers.\nRDV vor Ort um 18 Uhr.\nKostenlos."
        ],
        "en": [
          "Beach soccer tournament from 6pm at the Stade de Plage.\nOrganized by the Camiers Town Hall Sports Department.\nMeeting point at 6pm.\nFree admission."
        ],
        "it": [
          "Torneo di beach soccer dalle 18:00 allo Stade de Plage.\nOrganizzato dal Dipartimento dello Sport del Comune di Camiers.\nRitrovo alle 18:00.\nIngresso libero."
        ],
        "fr": [
          "Tournoi de beach soccer à partir de 18h au Stade de Plage.\nOrganisé par le service des sports de la Mairie de Camiers.\nRDV sur place à 18h.\nGratuit."
        ],
        "es": [
          "Torneo de fútbol playa a partir de las 18.00 h en el Stade de Plage.\nOrganizado por la Concejalía de Deportes del Ayuntamiento de Camiers.\nPunto de encuentro a las 18.00 horas.\nEntrada gratuita."
        ],
        "nl": [
          "Strandvoetbaltoernooi vanaf 18.00 uur in het Stade de Plage.\nGeorganiseerd door de sportafdeling van de gemeente Camiers.\nVerzamelpunt om 18.00 uur.\nGratis toegang."
        ]
      },
