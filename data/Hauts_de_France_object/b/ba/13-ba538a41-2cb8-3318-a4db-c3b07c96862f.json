  "rdfs:comment": {
    "de": [
      "Das Matisse-Museum wurde 1952 von Matisse selbst in der Stadt gegründet, in der er am 31. Dezember 1869 geboren wurde. Der Maler schenkte seinen Mitbürgern von Cateau-Cambrésis 82 Werke, die er im Renaissance-Rathaus aufstellte."
    ],
    "en": [
      "The Matisse Museum was created in 1952 by Matisse himself, in the town where he was born on December 31, 1869. The painter offered his fellow citizens of Cateau-Cambrésis 82 works that he installed in the Renaissance Town Hall."
    ],
    "it": [
      "Il Museo Matisse è stato creato nel 1952 dallo stesso Matisse, nella città in cui era nato il 31 dicembre 1869. Il pittore offrì ai suoi concittadini di Cateau-Cambrésis 82 opere che installò nel municipio rinascimentale."
    ],
    "fr": [
      "Le musée Matisse a été créé en 1952 par Matisse lui-même, dans la ville où il est né le 31 décembre 1869. Le peintre offre à ses concitoyens du Cateau-Cambrésis 82 œuvres qu’il installe dans l’Hôtel de Ville Renaissance."
    ],
    "nl": [
      "Het Matisse Museum werd in 1952 door Matisse zelf opgericht, in de stad waar hij op 31 december 1869 werd geboren. De schilder bood zijn medeburgers van Cateau-Cambrésis 82 werken aan die hij installeerde in het Renaissance stadhuis."
    ],
    "es": [
      "El Museo Matisse fue creado en 1952 por el propio Matisse, en la ciudad donde nació el 31 de diciembre de 1869. El pintor ofreció a sus conciudadanos de Cateau-Cambrésis 82 obras que instaló en el Ayuntamiento renacentista."
    ]
  },
