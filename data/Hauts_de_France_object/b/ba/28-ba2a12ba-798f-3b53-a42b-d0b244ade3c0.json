  "rdfs:comment": {
    "de": [
      "Einige Kilometer im Wald von Retz mit dem Verein AFORETZ.\nWir treffen uns auf dem Parkplatz des Bahnhofs von Villers-Cotterêts und starten um 13:30 Uhr."
    ],
    "en": [
      "A few kilometers in the Retz forest with the AFORETZ association.\nMeet at the Villers-Cotterêts station parking lot for a 1.30pm departure."
    ],
    "it": [
      "Alcuni chilometri nella foresta di Retz con l'associazione AFORETZ.\nRitrovo al parcheggio della stazione di Villers-Cotterêts per la partenza alle 13.30."
    ],
    "fr": [
      "Quelques kilomètres en forêt de Retz avec l’association AFORETZ. \nRendez-vous sur le parking de la gare de Villers-Cotterêts pour un départ à 13h30."
    ],
    "es": [
      "Unos kilómetros por el bosque de Retz con la asociación AFORETZ.\nCita en el aparcamiento de la estación de Villers-Cotterêts para la salida a las 13:30."
    ],
    "nl": [
      "Enkele kilometers in het bos van Retz met de vereniging AFORETZ.\nVerzamelen op de parkeerplaats van het station van Villers-Cotterêts voor een vertrek om 13.30 uur."
    ]
  },
