  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/42a864d0-70f6-3350-8ee9-542adef79f9e",
      "dc:description": {
        "de": [
          "Die Gemeinde Verchocq organisiert einen Trail oder eine Wanderung im Rahmen des Rosa Oktobers (Kampf gegen Brustkrebs).\nTreffpunkt ist ab 9 Uhr an der Schule von Verchocq.\nErfrischungsgetränke vor Ort."
        ],
        "en": [
          "The commune of Verchocq is organizing a trail or walk as part of the fight against breast cancer.\nMeet at Verchocq school from 9am.\nRefreshments on site."
        ],
        "it": [
          "Il comune di Verchocq organizza un percorso o una passeggiata nell'ambito della lotta contro il cancro al seno.\nRitrovo alla scuola di Verchocq dalle 9.00.\nRistoro sul posto."
        ],
        "fr": [
          "La commune de Verchocq organise un trail ou une marche dans le cadre d'octobre rose (lutte contre le cancer du sein).\nRendez-vous à l'école de Verchocq dès 9h.\nBuvette sur place."
        ],
        "es": [
          "El municipio de Verchocq organiza un recorrido a pie para luchar contra el cáncer de mama.\nEncuentro en la escuela de Verchocq a partir de las 9h.\nRefrescos in situ."
        ],
        "nl": [
          "De gemeente Verchocq organiseert een wandeling in het kader van de strijd tegen borstkanker.\nVerzamelen bij de school van Verchocq vanaf 9 uur.\nVersnaperingen ter plaatse."
        ]
      },
