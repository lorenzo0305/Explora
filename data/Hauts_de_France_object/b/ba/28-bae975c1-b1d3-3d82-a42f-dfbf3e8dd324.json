  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ee7f1e5f-1480-364c-badd-08ed6d4a6534",
      "dc:description": {
        "de": [
          "Das Couvent de la Visitation ist ein ungewöhnlicher Ort, an dem leidenschaftliches und umweltbewusstes Streetfood, Eintagsfliegen, Konzerte, Theater, Vintage- und Designermärkte, Partys, Workshops und ständige Kurse angeboten werden."
        ],
        "en": [
          "Le Couvent de la Visitation is an atypical living space designed around passionate, eco-friendly street food, ephemeral boutiques, concerts, theater, vintage and designer markets, evening events, workshops and permanent courses."
        ],
        "it": [
          "Il Couvent de la Visitation è un luogo di vita insolito, costruito attorno a uno street food appassionato ed ecologico, boutique effimere, concerti, teatro, mercatini vintage e di design, eventi serali, laboratori e corsi permanenti."
        ],
        "fr": [
          "Le Couvent de la Visitation est un lieu de vie atypique pensé autour d'une street food passionnée et eco responsable de boutiques éphèmères, concerts, théâtre, marchés vintages et créateurs, soirées, ateliers, cours permanents."
        ],
        "nl": [
          "Het Couvent de la Visitation is een ongewone plek om te wonen, gebouwd rond gepassioneerd, milieuvriendelijk straatvoedsel, kortstondige boetiekjes, concerten, theater, vintage- en designermarkten, avondevenementen, workshops en permanente cursussen."
        ],
        "es": [
          "El Couvent de la Visitation es un lugar insólito para vivir, construido en torno a la comida callejera apasionada y ecológica, las boutiques efímeras, los conciertos, el teatro, los mercadillos vintage y de diseño, los eventos nocturnos, los talleres y los cursos permanentes."
        ]
      },
