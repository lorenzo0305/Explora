  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a7d77db8-ec74-32ad-b9fe-fda1105f1562",
      "dc:description": {
        "de": [
          "Bereiten Sie sich auf eine tolle Zeit vor, indem Sie PICKLEBALL entdecken!\nJeden Donnerstagabend vom 19/07/2025 bis zum 16/08/2025.\nEs macht Spaß, ist für alle zugänglich und generationsübergreifend. Kommen Sie zahlreich!\n\nKostenlose Unterhaltung, Croque Monsieur, Barbecue vor Ort!\n18:00 - 19:30 Uhr"
        ],
        "en": [
          "Get ready to have a great time discovering PICKLEBALL!\nEvery Thursday evening from 19/07/2025 to 16/08/2025.\nFun, accessible to all and intergenerational, come one, come all!\n\nFree entertainment, croque monsieur, barbecue on site!\n6pm - 7:30pm"
        ],
        "it": [
          "Preparatevi a divertirvi alla scoperta del PICKLEBALL!\nOgni giovedì sera dal 19/07/2025 al 16/08/2025.\nGiocoso, accessibile a tutti e intergenerazionale, venite tutti!\n\nAnimazione gratuita, croque monsieur e barbecue in loco!\n18:00 - 19:30"
        ],
        "fr": [
          "Préparez-vous a passer de bons moments en découvrant le PICKLEBALL !\nTous les jeudis soir du 19/07/2025 au 16/08/2025.\nLudique, acessible à tous et intergénérationnel, venez nombreux !\n\nAnimation gratuite, croque monsieur, Barbecue sur place !\n18h - 19h30"
        ],
        "es": [
          "¡Prepárate para pasarlo en grande descubriendo el PICKLEBALL!\nTodos los jueves por la tarde del 19/07/2025 al 16/08/2025.\nLúdico, accesible a todos e intergeneracional, ¡vengan todos!\n\nAnimación gratuita, croque monsieur y barbacoa in situ\n18.00 - 19.30 h"
        ],
        "nl": [
          "Bereid je voor op een geweldige ontdekking van PICKLEBALL!\nElke donderdagavond van 19/07/2025 tot 16/08/2025.\nSpeels, toegankelijk voor iedereen en intergenerationeel, kom allen!\n\nGratis animatie, croque monsieur en barbecue ter plaatse!\n18.00 - 19.30 uur"
        ]
      },
