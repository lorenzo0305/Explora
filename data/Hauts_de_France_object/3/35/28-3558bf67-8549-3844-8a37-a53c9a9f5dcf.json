  "rdfs:comment": {
    "de": [
      "Lassen Sie es sich schmecken und wärmen Sie sich am Kamin auf! Die regionalen Gerichte werden mit frischen und lokalen Produkten hausgemacht."
    ],
    "en": [
      "Come and enjoy a delicious meal and warm up by the fireplace! The local dishes are home made with fresh and local products."
    ],
    "it": [
      "Venite a gustare un pasto delizioso e a riscaldarvi accanto al camino! I piatti locali sono fatti in casa con prodotti freschi e locali."
    ],
    "fr": [
      "Venez vous régaler et vous réchauffer près de la cheminée ! Les plats du terroir sont fait maison avec des produits frais et locaux."
    ],
    "es": [
      "Venga a disfrutar de una deliciosa comida y a calentarse junto a la chimenea Los platos locales son caseros y se elaboran con productos frescos y locales."
    ],
    "nl": [
      "Kom genieten van een heerlijke maaltijd en warm je op bij de open haard! De streekgerechten zijn huisgemaakt met verse en lokale producten."
    ]
  },
