  "rdfs:comment": {
    "de": [
      "Die kleine Kapelle unterhalb der Kirche wurde für die Dreharbeiten zu Claude Berris Germinal errichtet, einem Kultfilm, der der Mine und den Bergarbeitern huldigt. Mehrere Szenen wurden im Dorf Artres gedreht."
    ],
    "en": [
      "The little chapel below the church was built for the filming of Claude Berri's Germinal, a cult film in homage to mining and miners. Several scenes are shot in the village of Artres."
    ],
    "it": [
      "La piccola cappella sotto la chiesa è stata costruita per le riprese di Germinal di Claude Berri, un film cult che rende omaggio alle miniere e ai minatori. Alcune scene sono state girate nel villaggio di Artres."
    ],
    "fr": [
      "La petite chapelle en contrebas de l'église a été bâtie pour le tournage de Germinal de Claude Berri; film culte en hommage à la mine et aux mineurs. Plusieurs scènes sont réalisées dans le village d'Artres."
    ],
    "es": [
      "La pequeña capilla situada bajo la iglesia se construyó para el rodaje de Germinal, de Claude Berri, película de culto que rinde homenaje a las minas y a los mineros. Varias escenas se rodaron en el pueblo de Artres."
    ],
    "nl": [
      "De kleine kapel onder de kerk werd gebouwd voor de opnames van Claude Berri's Germinal, een cultfilm die een eerbetoon is aan de mijnen en mijnwerkers. Verschillende scènes werden opgenomen in het dorp Artres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vestiges du tournage de Germinal de Claude Berri"
    ]
  },
