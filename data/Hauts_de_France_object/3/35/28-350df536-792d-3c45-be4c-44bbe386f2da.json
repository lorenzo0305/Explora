  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bbfb25e7-1f43-384d-b0be-ecb706f1dbd0",
      "dc:description": {
        "de": [
          "Entdecken Sie eine authentische asiatische Küche und bewundern Sie die vom Fernen Osten inspirierte Dekoration. Die Atmosphäre ist herzlich und kümmert sich darum, dass Sie sich verwöhnen lassen."
        ],
        "en": [
          "Come and discover authentic Asian cuisine and admire the Far East-inspired decor. The atmosphere is warm and friendly, and you'll be pampered."
        ],
        "it": [
          "Venite a scoprire l'autentica cucina asiatica e ad ammirare l'arredamento ispirato all'Estremo Oriente. L'atmosfera è calda e invitante e non c'è che l'imbarazzo della scelta."
        ],
        "fr": [
          "Venez découvrir une cuisine asiatique authentique et admirer une décoration inspirée d'Extrême-Orient. L'ambiance est chaleureuse et aux petits soins pour vous régaler."
        ],
        "es": [
          "Venga a descubrir la auténtica cocina asiática y admire la decoración inspirada en el Lejano Oriente. El ambiente es cálido y acogedor, y no le faltará donde elegir."
        ],
        "nl": [
          "Kom en ontdek de authentieke Aziatische keuken en bewonder de op het Verre Oosten geïnspireerde inrichting. De sfeer is warm en uitnodigend en u zult keuze te over hebben."
        ]
      },
