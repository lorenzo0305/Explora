  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f347fadd-c117-3384-8230-a8a2ba7c9a71",
      "dc:description": {
        "de": [
          "Kollektiver Spielplatz für Kinder, der sich im Freien befindet.\nDie Gelegenheit für Kinder, sich auszutoben, gemeinsam zu spielen und die frische Luft in vollen Zügen zu genießen."
        ],
        "en": [
          "Collective outdoor play area for children.\nAn opportunity for children to let off steam, play together and enjoy the great outdoors."
        ],
        "it": [
          "Area giochi collettiva all'aperto per bambini.\nUn'opportunità per i bambini di sfogarsi, giocare insieme e sfruttare al meglio l'aria aperta."
        ],
        "fr": [
          "Aire collective de jeux pour enfants située en extérieur.\nL'occasion pour les enfants de se défouler, de jouer ensemble et de profiter pleinement du grand air."
        ],
        "es": [
          "Zona de juegos colectivos al aire libre para niños.\nUna oportunidad para que los niños se desahoguen, jueguen juntos y aprovechen al máximo el aire libre."
        ],
        "nl": [
          "Collectieve buitenspeelruimte voor kinderen.\nEen kans voor kinderen om stoom af te blazen, samen te spelen en te genieten van de buitenlucht."
        ]
      },
