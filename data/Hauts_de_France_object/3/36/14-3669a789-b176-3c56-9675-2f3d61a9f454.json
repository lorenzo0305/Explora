  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48043f97-f4c6-390d-a30c-8de261277a17",
      "dc:description": {
        "de": [
          "Verein nach dem Gesetz von 1901, gegründet am 1.6.1936.\nZweck: Förderung und Entwicklung der Ausübung von Tennis, Padel und Beach Tennis.\nOrganisation von Unterricht und Durchführung von Wettkämpfen und Sportveranstaltungen."
        ],
        "en": [
          "Association under the law of 1901, founded on 1/06/1936.\nPurpose: to promote and develop tennis, padel and beach tennis.\nOrganize teaching and host all competitions and sporting events."
        ],
        "it": [
          "Associazione ai sensi della legge del 1901, fondata il 1/06/1936.\nScopo: promuovere e sviluppare il tennis, il padel e il beach tennis.\nOrganizzare l'insegnamento e gestire tutte le competizioni e gli eventi sportivi."
        ],
        "fr": [
          "Association loi 1901, fondée le 1er/06/1936. \nObjet : favoriser et développer la pratique du tennis, du padel, du beach tennis. \nOrganiser l’enseignement et animer toutes les compétitions et manifestations sportives."
        ],
        "nl": [
          "Vereniging onder de wet van 1901, opgericht op 1/06/1936.\nDoel: tennis, padel en strandtennis bevorderen en ontwikkelen.\nHet organiseren van lessen en het leiden van alle competities en sportevenementen."
        ],
        "es": [
          "Asociación conforme a la ley de 1901, fundada el 1/06/1936.\nObjeto: promover y desarrollar el tenis, el pádel y el tenis de playa.\nOrganizar la enseñanza y dirigir todas las competiciones y acontecimientos deportivos."
        ]
      },
