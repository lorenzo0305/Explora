  "rdfs:comment": {
    "de": [
      "Estaminet - Brasserie - Traditionelle und regionale Küche\nEntdecken Sie das kleine Gasthaus für eine gesellige Mahlzeit.\nFranzösische Küche, 100% hausgemacht! Restauration vor Ort oder zum Mitnehmen!\nBestellungen zum Mitnehmen bitte per Mail oder Telefon aufgeben!\n\nKommentar des Restaurateurs: \"Travail uniquement en produit frais\" (Nur mit frischen Produkten arbeiten)\n\nAnimationen: Themenabende\n\nAkzeptierte Gruppen von 6 bis 22 Gedecken - 1 zu privatisierender Saal mit 10 Gedecken"
    ],
    "en": [
      "Estaminet - Brasserie - Traditional and regional cuisine\nDiscover the little inn for a convivial meal.\nFrench cuisine, 100% homemade! Catering on site or to take away!\nTakeaway orders by mail or phone!\n\nRestaurant owner's comment: \"We only work with fresh produce\"\n\nEntertainment: themed evenings\n\nGroups accepted from 6 to 22 covers - 1 private room for 10 covers"
    ],
    "it": [
      "Estaminet - Brasserie - Cucina tradizionale e regionale\nScoprite la piccola locanda per un pasto conviviale.\nCucina francese, 100% fatta in casa! Da mangiare o da portare via!\nOrdini da asporto per e-mail o per telefono!\n\nCommento del ristoratore: \"Lavoriamo solo con prodotti freschi\"\n\nIntrattenimento: serate a tema\n\nSi accettano gruppi da 6 a 22 coperti - 1 sala privata per 10 coperti"
    ],
    "fr": [
      "Estaminet - Brasserie - Cuisine traditionnelle et régionale \nDécouvrez la petite auberge pour un repas convivial. \nCuisine française, 100% maison ! Restauration sur place ou à emporter ! \nCommandes à emporter à passer par mail ou téléphone !\n\nCommentaire du restaurateur : \"Travail uniquement en produit frais\"\n\nAnimations : soirées à thèmes\n\nGroupes acceptés de 6 à 22 couverts - 1 salle à privatiser de 10 couverts"
    ],
    "nl": [
      "Estaminet - Brasserie - Traditionele en regionale keuken\nOntdek de kleine herberg voor een gezellige maaltijd.\nFranse keuken, 100% huisgemaakt! Eten of afhalen!\nAfhaalbestellingen per e-mail of telefoon!\n\nCommentaar van de restauranteigenaar: \"Wij werken alleen met verse producten\"\n\nEntertainment: thema-avonden\n\nGroepen van 6 tot 22 personen - 1 privézaal voor 10 personen"
    ],
    "es": [
      "Estaminet - Brasserie - Cocina tradicional y regional\nDescubra el pequeño mesón para una comida de convivencia.\nCocina francesa 100% casera Para comer o para llevar\nPedidos para llevar por correo electrónico o teléfono\n\nComentario del restaurador: \"Sólo trabajamos con productos frescos\"\n\nEntretenimiento: noches temáticas\n\nSe aceptan grupos de 6 a 22 cubiertos - 1 sala privada para 10 cubiertos"
    ]
  },
