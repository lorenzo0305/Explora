  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b141991c-b10b-3b19-a215-688f5b2ca412",
      "dc:description": {
        "de": [
          "Für Kinder von 3-7 Jahren\nSonntag, 15. März - Uhrzeit auf Anfrage\nAm Strand von Berck-sur-Mer\n----------------------------------\nOrganisiert von der Ferme de mon Enfance in Wailly-Beaucamp\n\nSpaziergang an der Hand am Strand von Berck mit unseren Ponys, die von unserer Reitlehrerin begleitet werden.\n\nBegrenzte Plätze - Auf Reservierung mit 50% Anzahlung\nAuskunft/Reservierung: 06 11 01 84 93\n\nCredit: Pixabay"
        ],
        "en": [
          "For ages 3-7\nSunday, March 15 - Schedule on request\nOn the beach at Berck-sur-Mer\n----------------------------------\nOrganized by Ferme de mon Enfance de Wailly-Beaucamp\n\nHand-held rides on Berck beach with our ponies accompanied by our instructor.\n\nLimited places - On reservation with 50% deposit\nInformation/Reservations: 06 11 01 84 93\n\nCredit : Pixabay"
        ],
        "it": [
          "Per bambini dai 3 ai 7 anni\nDomenica 15 marzo - Orario su richiesta\nSulla spiaggia di Berck-sur-Mer\n----------------------------------\nOrganizzato dalla Ferme de mon Enfance di Wailly-Beaucamp\n\nCavalcata sulla spiaggia di Berck con i nostri pony accompagnati dal nostro istruttore.\n\nPosti limitati - Su prenotazione con acconto del 50%\nInformazioni/Prenotazione: 06 11 01 84 93\n\nCredito : Pixabay"
        ],
        "fr": [
          "Pour les 3-7 ans\nDimanche 15 mars - Horaires sur demande\nSur la plage de Berck-sur-Mer\n----------------------------------\nOrganisé par la Ferme de mon Enfance de Wailly-Beaucamp\n\nPromenade en main sur la plage de Berck avec nos poneys accompagnés par notre monitrice.\n\nPlaces limitées - Sur réservation avec acompte de 50%\nRenseignements/Réservations : 06 11 01 84 93\n\nCrédit : Pixabay"
        ],
        "nl": [
          "Voor kinderen van 3-7 jaar\nZondag 15 maart - Tijdschema op aanvraag\nOp het strand van Berck-sur-Mer\n----------------------------------\nGeorganiseerd door de Ferme de mon Enfance in Wailly-Beaucamp\n\nRit op het strand van Berck met onze pony's onder begeleiding van onze instructeur.\n\nBeperkte plaatsen - Op reservering met 50% aanbetaling\nInformatie/reservering: 06 11 01 84 93\n\nKrediet : Pixabay"
        ],
        "es": [
          "Para niños de 3 a 7 años\nDomingo 15 de marzo - Horario a petición\nEn la playa de Berck-sur-Mer\n----------------------------------\nOrganizado por la Ferme de mon Enfance de Wailly-Beaucamp\n\nPaseo por la playa de Berck con nuestros ponis acompañados por nuestro monitor.\n\nPlazas limitadas - Previa reserva con un anticipo del 50\nInformación/Reserva: 06 11 01 84 93\n\nCrédito : Pixabay"
        ]
      },
