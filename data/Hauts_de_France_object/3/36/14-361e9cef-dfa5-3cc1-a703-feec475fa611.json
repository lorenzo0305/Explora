  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5254beca-a7a6-3c0f-b4e9-c8f98eb347c9",
      "dc:description": {
        "de": [
          "\"Spielautomaten, elektronisches englisches Roulette, Blackjack-Tische \"\"Le Brassi Restaurant\"\" und Bar.\n\n*Der Zugang zum Kasino ist nur volljährigen Personen vorbehalten, denen das Glücksspiel nicht verboten ist, und unterliegt der Vorlage eines gültigen Personalausweises. \""
        ],
        "en": [
          "\"Slot machines, electronic roulette wheels, \"Le Brassi Restaurant\" blackjack tables and bar.\n\n*Access to the casino is reserved for adults only, and is subject to presentation of a valid form of identification. \""
        ],
        "it": [
          "\"Slot machine, roulette elettronica inglese, tavoli da blackjack \"Ristorante Le Brassi\" e Bar.\n\n*L'accesso al casinò è riservato esclusivamente ai maggiorenni ai quali non è stato vietato il gioco d'azzardo, previa presentazione di un documento d'identità valido. \""
        ],
        "fr": [
          "\"Machines à sous, roulettes anglaises électroniques, tables de blackjack \"\"Le Brassi Restaurant\"\" et Bar.\n\n*L'accès au casino est réservé uniquement aux personnes majeures et non interdites de jeu, soumis à la présentation d'une pièce d'identité en cours de validité. \""
        ],
        "nl": [
          "\"Speelautomaten, elektronische Engelse roulettewielen, blackjacktafels \"Le Brassi Restaurant\" en Bar.\n\n*Toegang tot het casino is uitsluitend voorbehouden aan volwassenen die geen gokverbod hebben, op vertoon van een geldig legitimatiebewijs. \""
        ],
        "es": [
          "\" Máquinas tragaperras, ruletas electrónicas inglesas, mesas de blackjack \"Le Brassi Restaurant\" y Bar.\n\n*El acceso al casino está reservado exclusivamente a los adultos que no tengan prohibido el juego, previa presentación de un documento de identidad válido. \""
        ]
      },
      "@type": [
        "Description"
      ],
