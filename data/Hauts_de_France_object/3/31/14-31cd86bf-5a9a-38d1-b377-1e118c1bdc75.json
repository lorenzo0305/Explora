  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/433f078f-bae9-36a9-97d9-35c85e151ed9",
      "dc:description": {
        "de": [
          "Das Fest des Hundes\nAb 10.00 Uhr - Rathausplatz\nLeckerlis, Zubehör, Toilettenartikel,\nZeremonie\num 11.30 Uhr\nDenkmal für die Gefallenen von Nesles\nEhrung der wichtigen Rolle, die der Hundeführer und der Hund bei verschiedenen Konflikten und Katastrophen gespielt haben.\nHundeausflüge mit Erziehern\nAbfahrt vom Rathausplatz 10.30 Uhr und 14.30 Uhr\nKostenlose Anmeldungen vor Ort\nVorführungen im Laufe des Tages\nPlatz des Rathauses\nKynophile Brigade\nPrävention\nGehorsam\nErzieher"
        ],
        "en": [
          "The Dog Festival\nFrom 10:00 am - Place de la Mairie\nTreats, accessories, groomers,\nCeremony\nat 11:30 a.m\nNesles War Memorial\nTribute to the important role played by dog handlers and dogs in various conflicts and disasters.\nDog walks with dog trainers\nDeparture from Place de la Mairie 10:30 a.m. and 2:30 p.m\nFree registration on site\nDemonstrations throughout the day\nPlace de la Mairie\nDog Brigade\nPrevention\nObedience\nEducators"
        ],
        "it": [
          "Il Festival del cane\nDalle ore 10.00 - Piazza della Mairie\nTrattamenti, accessori, toelettatori,\nCerimonia\nalle 11.30\nMonumento ai caduti di Nesles\nOmaggio all'importante ruolo svolto dai cinofili e dai cani in vari conflitti e disastri.\nPasseggiate con gli addestratori di cani\nPartenza da Place de la Mairie alle 10.30 e alle 14.30\nIscrizione gratuita sul posto\nDimostrazioni durante tutta la giornata\nPiazza della Mairie\nBrigata cinofila\nPrevenzione\nObbedienza\nEducatori"
        ],
        "fr": [
          "La fête du Chien\nDès 10h00 - place de la Mairie\nFriandises, accessoires, toiletteuses,\nCérémonie\nà 11h30\nMonument aux morts de Nesles\nHommage au rôle important joué par le maître chien et le chien lors des différents conflits et catastrophes.\nBalades canines avec éducateurs \nDépart de la place de la Mairie 10h30 et 14h30\nInscriptions gratuites sur place\nDémonstrations au fil de la journée\nPlace de la Mairie\nBrigade cynophile\nPrévention\nObéissance\nEducateurs"
        ],
        "nl": [
          "Hondenfeest\nVanaf 10.00 uur - Place de la Mairie\nTraktaties, accessoires, trimsalon,\nCeremonie\nom 11.30 uur\nOorlogsmonument Nesles\nEerbetoon aan de belangrijke rol die hondengeleiders en honden hebben gespeeld in verschillende conflicten en rampen.\nHondenwandelingen met hondentrainers\nVertrek vanaf de Place de la Mairie om 10.30 en 14.30 uur\nGratis inschrijving ter plaatse\nDemonstraties gedurende de hele dag\nPlace de la Mairie\nHondenbrigade\nPreventie\nGehoorzaamheid\nOpvoeders"
        ],
        "es": [
          "Fiesta del Perro\nA partir de las 10.00 h - Place de la Mairie\nGolosinas, accesorios, peluqueros,\nCeremonia\na las 11.30 h\nMonumento a la Guerra de Nesles\nHomenaje al importante papel desempeñado por los adiestradores de perros y los perros en diversos conflictos y catástrofes.\nPaseos con adiestradores de perros\nSalida de la Place de la Mairie 10.30 h y 14.30 h\nInscripción gratuita in situ\nDemostraciones durante todo el día\nPlaza de la Mairie\nBrigada canina\nPrevención\nObediencia\nEducadores"
        ]
      },
