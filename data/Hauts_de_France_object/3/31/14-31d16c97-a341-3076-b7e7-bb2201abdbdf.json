  "rdfs:comment": {
    "de": [
      "Am Fluss Souchez, in einer alten Mühle, entdecken Sie eine authentische italienische Küche in einem gemütlichen und sorgfältig dekorierten Rahmen."
    ],
    "en": [
      "On the Souchez river, in a former mill, come and discover authentic Italian cuisine in a warm and carefully decorated setting."
    ],
    "it": [
      "Sul Souchez, in un ex mulino, venite a scoprire l'autentica cucina italiana in un ambiente accogliente e decorato con cura."
    ],
    "fr": [
      "Sur la Souchez, dans un ancien moulin, venez découvrir une authentique cuisine italienne dans un cadre chaleureux et soigneusement décoré."
    ],
    "nl": [
      "Op de Souchez, in een voormalige molen, ontdek je de authentieke Italiaanse keuken in een warme en zorgvuldig ingerichte omgeving."
    ],
    "es": [
      "En la Souchez, en un antiguo molino, venga a descubrir la auténtica cocina italiana en un marco cálido y cuidadosamente decorado."
    ]
