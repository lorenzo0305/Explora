      "dc:description": {
        "de": [
          "Der Verein schlägt Ihnen vor, an einem Wettbewerb im Doppelpack teilzunehmen, der zugunsten des Telethons ausgetragen wird und allen Spaß macht.\nOffen für alle."
        ],
        "en": [
          "The association invites you to take part in a double-team competition to raise funds for the Telethon.\nOpen to all."
        ],
        "it": [
          "L'associazione vi invita a partecipare a una gara a due a favore di Telethon per il divertimento di tutti.\nAperto a tutti."
        ],
        "fr": [
          "L'association vous propose de participer à un concours en doublette formée au profit du téléthon pour le plaisir de tous.\nOuvert à tous."
        ],
        "es": [
          "La asociación le invita a participar en un concurso de dos personas a beneficio del Teletón para el disfrute de todos.\nAbierto a todos."
        ],
        "nl": [
          "De vereniging nodigt je uit om deel te nemen aan een wedstrijd voor twee personen ter ondersteuning van de Telethon, voor het plezier van iedereen.\nVoor iedereen toegankelijk."
        ]
      },
