  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum, direkt gegenüber einem imposanten Bauwerk: der Abteikirche St. Pierre, empfangen Sie Stephanie und ihr Team in einem modernen, kürzlich renovierten Rahmen. Küche mit frischen Produkten und Schiefertafel."
    ],
    "en": [
      "In the town centre, just opposite an imposing monument: the Abbey Church of Saint Peter, Stéphanie and her team will welcome you in a modern, recently renovated setting. Kitchen based on fresh products and slate proposal."
    ],
    "it": [
      "Nel centro della città, proprio di fronte a un imponente monumento: la chiesa abbaziale di San Pietro, Stéphanie e il suo team vi accoglieranno in un ambiente moderno e recentemente rinnovato. La cucina si basa su prodotti freschi e viene offerta su base di pesce."
    ],
    "fr": [
      "En centre ville, juste en face d'un monument imposant : l'église Abbatiale saint Pierre, Stéphanie et son équipe vous accueilleront dans un cadre moderne, récemment rénové. Cuisine à base de produits frais et proposition à l'ardoise."
    ],
    "nl": [
      "In het stadscentrum, tegenover een imposant monument: de abdijkerk van Sint-Pieter, ontvangen Stéphanie en haar team u in een modern, onlangs gerenoveerd kader. De keuken is gebaseerd op verse producten en wordt op de lei aangeboden."
    ],
    "es": [
      "En el centro de la ciudad, justo enfrente de un imponente monumento: la iglesia abacial de San Pedro, Stéphanie y su equipo le darán la bienvenida en un entorno moderno y recientemente renovado. La cocina se basa en productos frescos y se ofrece a base de pizarra."
    ]
  },
