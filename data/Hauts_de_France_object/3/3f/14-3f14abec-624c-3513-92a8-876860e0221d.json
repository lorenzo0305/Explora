  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4f006888-bd0e-3cb4-b1f9-f34aad969b4f",
      "dc:description": {
        "de": [
          "Zusammenschluss der Vereine des Departements, um die Aktivitäten des Drachenfliegens (Gleitschirmfliegen, Deltasegeln, starre PUL, Drachen in allen Formen) im Pas-de-Calais zu vertreten, zu fördern und zu entwickeln"
        ],
        "en": [
          "Regroups the clubs of the department to represent, promote and develop the activities of Free Flight (paragliding, hang gliding, rigid PUL, kite in all its forms) in the Pas-de-Calais"
        ],
        "it": [
          "Riunisce i club del dipartimento per rappresentare, promuovere e sviluppare le attività di volo libero (parapendio, deltaplano, PUL rigido, tutte le forme di aquilonismo) nel Pas-de-Calais"
        ],
        "fr": [
          "Regroupe les clubs du Département pour représenter, promouvoir et développer les activités du Vol Libre (parapente, delta, PUL rigide, cerf-volant sous toutes ses formes) dans le Pas-de-Calais"
        ],
        "nl": [
          "Verenigt de clubs van het departement om vrije vluchtactiviteiten (parapente, deltavliegen, stijve PUL, alle vormen van vliegeren) in Pas-de-Calais te vertegenwoordigen, promoten en ontwikkelen"
        ],
        "es": [
          "Reúne a los clubes del departamento para representar, promover y desarrollar las actividades de vuelo libre (parapente, ala delta, PUL rígido, vuelo de cometas en todas sus formas) en el Pas-de-Calais"
        ]
      },
