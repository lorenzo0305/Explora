  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4b9a8572-dd69-3a24-a212-fb985cfa3416",
      "dc:description": {
        "de": [
          "Geben Sie maximal 5 Bücher in gutem Zustand in den 15 Tagen vor dem \"Bücher-Tausch\" ab oder kommen Sie am selben Tag und nehmen Sie die Bücher mit, die Sie interessieren."
        ],
        "en": [
          "Drop off a maximum of 5 books, in good condition, in the 15 days prior to the \"Book Swap\", or come along on the day and leave with the books you're interested in."
        ],
        "it": [
          "Lasciate un massimo di 5 libri in buone condizioni nei 15 giorni precedenti lo Scambio di libri, oppure venite il giorno stesso e portate via i libri che volete."
        ],
        "fr": [
          "Déposez 5 livres maximum, en bon état, dans les 15 jours qui précèdent le « Troc-Livres » ou venez le jour même et repartez avec les livres qui vous intéressent."
        ],
        "nl": [
          "Geef maximaal 5 boeken in goede staat af in de 15 dagen voorafgaand aan de Book Swap, of kom op de dag zelf langs en neem de boeken mee die je wilt hebben."
        ],
        "es": [
          "Entregue un máximo de 5 libros en buen estado durante los 15 días previos al intercambio o venga el día del intercambio y llévese los libros que desee."
        ]
      },
