      "dc:description": {
        "de": [
          "ECnou lädt Sie ein, einen Dokumentarfilm zu sehen, gefolgt von einer Debatte über die Unterstützung von Migranten,\nWir treffen uns um 20 Uhr im Kulturzentrum Francis Sagot in Fruges.\nEintritt 4.80?"
        ],
        "en": [
          "ECnou invites you to discover a documentary film followed by a debate on support for migrants,\n8pm at the Francis Sagot cultural center in Fruges.\nAdmission 4.80?"
        ],
        "it": [
          "ECnou vi invita a scoprire un film documentario seguito da un dibattito sul sostegno ai migranti,\nAlle 20:00 presso il centro culturale Francis Sagot di Fruges.\nIngresso 4,80?"
        ],
        "fr": [
          "ECnou vous invite à découvrir un film documentaire suivi d'un débat sur le soutien aux migrants, \nRDV à 20h à l'espace culturel Francis Sagot à Fruges.\nEntrée 4.80€"
        ],
        "nl": [
          "ECnou nodigt je uit voor een documentairefilm gevolgd door een debat over steun aan migranten,\n20u in het cultureel centrum Francis Sagot in Fruges.\nToegangsprijs 4,80?"
        ],
        "es": [
          "ECnou le invita a descubrir un documental seguido de un debate sobre el apoyo a los inmigrantes,\n20h en el centro cultural Francis Sagot de Fruges.\nEntrada 4,80?"
        ]
      },
