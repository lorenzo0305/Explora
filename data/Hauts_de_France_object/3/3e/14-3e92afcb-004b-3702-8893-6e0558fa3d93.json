      "@id": "https://data.datatourisme.fr/4e8f9b0f-f3ca-3cdf-b030-eb9ae45a9d7a",
      "dc:description": {
        "de": [
          "Treffpunkt am 9. und 10. August in Matringhem für seine Ducasse und seinen Brocante\nReservierung Mahlzeiten bis zum 5. August unter 07 82 88 43 33 / 06 83 35 16 71 / 06 59 39 34 22"
        ],
        "en": [
          "See you on August 9 and 10 in Matringhem for its ducasse and flea market\nMeal reservations until August 5 on 07 82 88 43 33 / 06 83 35 16 71 / 06 59 39 34 22"
        ],
        "it": [
          "Ci vediamo il 9 e 10 agosto a Matringhem per la ducassa e il mercato delle pulci\nPrenotazioni pasti fino al 5 agosto allo 07 82 88 43 33 / 06 83 35 16 71 / 06 59 39 34 22"
        ],
        "fr": [
          "Rendez-vous le 9 et 10 août à Matringhem pour sa ducasse et sa brocante\nRéservation repas jusqu'au 5 août au 07 82 88 43 33 / 06 83 35 16 71 / 06 59 39 34 22"
        ],
        "nl": [
          "Tot ziens op 9 en 10 augustus in Matringhem voor de ducasse en rommelmarkt\nMaaltijdreserveringen tot 5 augustus op 07 82 88 43 33 / 06 83 35 16 71 / 06 59 39 34 22"
        ],
        "es": [
          "Nos vemos los días 9 y 10 de agosto en Matringhem con motivo de su ducasse y mercadillo\nReservas de comidas hasta el 5 de agosto en el 07 82 88 43 33 / 06 83 35 16 71 / 06 59 39 34 22"
        ]
      },
