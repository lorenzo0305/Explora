  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7e283430-1d35-3d2a-bb1a-f84ad034db7d",
      "dc:description": {
        "de": [
          "12 KM LANGER WANDERWEG - 3 STUNDEN\nABFAHRT VOM PLACE FOCH IN SAMER\nPAS DE BALISAGE - Carnet du randonneur erhältlich im Office de Tourisme\n\nFinden Sie den Verlauf des Rundwegs auf der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "12 KM WALKING TRAIL - 3 H\nDEPARTURE FROM PLACE FOCH IN SAMER\nNO MARKING - Hiker's booklet available from the Tourist Office\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO A PIEDI DI 12 KM - 3 H\nPARTENZA DA PLACE FOCH A SAMER\nNON SONO PREVISTI MARCATORI - Il libretto dell'escursionista è disponibile presso l'Ufficio del Turismo\n\nIl percorso è disponibile sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 12 KM - 3 H \nDEPART DE LA PLACE FOCH DE SAMER\nPAS DE BALISAGE - Carnet du randonneur disponible à l'Office de Tourisme\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA A PIE DE 12 KM - 3 H\nSALIDA DE LA PLAZA FOCH EN SAMER\nSIN MARCAR - Folleto del senderista disponible en la Oficina de Turismo\n\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su Smartphone."
        ],
        "nl": [
          "12 KM WANDELROUTE - 3 U\nVERTREK VANAF PLACE FOCH IN SAMER\nGEEN MARKERING - Wandelboekje verkrijgbaar bij de Dienst voor Toerisme\n\nJe kunt de route vinden op de CIRKWI wandelapplicatie op je Smartphone."
        ]
      },
