    "de": [
      "Das wird Ihnen gefallen: die gemütliche und gedämpfte Atmosphäre, die italienischen Gerichte, die alle köstlich sind. Ein echtes italienisches Restaurant..."
    ],
    "en": [
      "You'll love the cozy, hushed atmosphere and the delicious Italian dishes. A true Italian restaurant..."
    ],
    "it": [
      "Vi piacerà l'atmosfera accogliente e silenziosa e i deliziosi piatti italiani. Un vero ristorante italiano..."
    ],
    "fr": [
      "Vous aimerez : l'ambiance cosy et feutrée, les mets italiens tous délicieux. Un vrai restaurant italien..."
    ],
    "nl": [
      "U zult dol zijn op de gezellige, verstilde sfeer en de heerlijke Italiaanse gerechten. Een echt Italiaans restaurant..."
    ],
