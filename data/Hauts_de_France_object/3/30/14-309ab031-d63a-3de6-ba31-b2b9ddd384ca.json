  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ba212b2e-c172-3aa0-acab-9d748e148f03",
      "dc:description": {
        "de": [
          "Öffnungszeiten :\n\nDienstag bis Donnerstag von 11:30 bis 14:00 Uhr\nFreitags von 11:30 bis 14:00 Uhr und von 18:30 bis 21:30 Uhr\nSamstags bis sonntags von 18:30 bis 21:30 Uhr\nMontags geschlossen.\n \n Bestellung :\n\nBestellmöglichkeit und sogar Beratung per Telefon unter 06 48 40 97 08\n\n "
        ],
        "en": [
          "Opening hours :\n\nTuesday to Thursday, 11:30am to 2pm\nFriday, 11:30am to 2pm and 6:30pm to 9:30pm\nSaturday to Sunday, 6:30 pm to 9:30 pm\nClosed on Mondays.\n \n How to order :\n\nOrders can be placed and advice given by telephone on 06 48 40 97 08\n\n "
        ],
        "it": [
          "Orari di apertura :\n\nDa martedì a giovedì, dalle 11.30 alle 14.00\nVenerdì dalle 11.30 alle 14.00 e dalle 18.30 alle 21.30\nDa sabato a domenica, dalle 18.30 alle 21.30\nChiuso il lunedì.\n \n Come ordinare\n\nLe ordinazioni e i consigli possono essere effettuati telefonicamente al numero 06 48 40 97 08\n\n "
        ],
        "fr": [
          "Horaires d'ouverture : \n\nDu mardi au jeudi de 11h30 à 14h\nLe vendredi de 11h30 à 14h et de 18h30 à 21h30\nDu samedi au dimanche de 18h30 à 21h30\nFermé le lundi.\n \n Commande : \n\nPossibilité de commander et même conseillée par téléphone au 06 48 40 97 08\n\n "
        ],
        "nl": [
          "Openingstijden :\n\nDinsdag tot donderdag van 11.30 tot 14.00 uur\nVrijdag van 11.30 tot 14.00 uur en van 18.30 tot 21.30 uur\nZaterdag tot zondag van 18.30 tot 21.30 uur\nGesloten op maandag.\n \n Hoe te bestellen\n\nBestellingen en advies kunnen telefonisch worden doorgegeven op 06 48 40 97 08\n\n "
        ],
        "es": [
          "Horario de apertura :\n\nDe martes a jueves, de 11.30 h a 14 h\nViernes de 11h30 a 14h00 y de 18h30 a 21h30\nDe sábado a domingo, de 18.30 a 21.30 h\nLunes cerrado.\n \n Cómo hacer un pedido\n\nSe pueden hacer pedidos y recibir asesoramiento por teléfono llamando al 06 48 40 97 08\n\n "
        ]
      },
