  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4790550f-f1e4-35c7-8d06-a73efdfc8ebf",
      "dc:description": {
        "de": [
          "Naturwanderung mit Eden 62 - Die Ungeliebten und ihre Wohltaten - Réserve Naturelle de la Baie de Canche - Um 14:30 Uhr - Machen Sie sich auf den Weg, um Efeu, Schnecken und viele andere Ungeliebte kennenzulernen - Treffpunkt um 14:30 Uhr auf dem Parkplatz des britischen Friedhofs von Etaples sur Mer - Gratis"
        ],
        "en": [
          "Nature walk with Eden 62 - The unloved and their benefits - Nature Reserve of the Bay of Canche - At 2:30 pm - Meet the ivy, the snails and many other unloved ones - meeting at 2:30 pm on the parking lot of the British cemetery of Etaples sur Mer - Free"
        ],
        "it": [
          "Passeggiata naturalistica con Eden 62 - I non amati e i loro benefici - Riserva naturale della Baie de Canche - Alle 14.30 - Incontro con l'edera, le lumache e molti altri non amati - ritrovo alle 14.30 sul parcheggio del cimitero britannico di Etaples sur Mer - Gratis"
        ],
        "fr": [
          "Balade nature avec Eden 62 - Les mal-aimés et leurs bienfaits - Réserve Naturelle de la Baie de Canche - A 14h30 - Partez à la rencontre du lierre, des escargots et de bien d'autres mal-aimés - rendez-vous à 14h30 sur le parking du cimetière britannique d'Etaples sur Mer - Gratui"
        ],
        "es": [
          "Paseo por la naturaleza con Eden 62 - Los no queridos y sus beneficios - Reserva Natural de la Bahía de Canche - A las 14.30 horas - Conozca la hiedra, los caracoles y muchos otros no queridos - encuentro a las 14.30 horas en el aparcamiento del cementerio británico de Etaples sur Mer - Gratis"
        ],
        "nl": [
          "Natuurwandeling met Eden 62 - De onbeminden en hun voordelen - Natuurreservaat Baie de Canche - Om 14.30 uur - Maak kennis met de klimop, de slakken en vele andere onbeminden - bijeenkomst om 14.30 uur op de parkeerplaats van de Britse begraafplaats van Etaples sur Mer - Gratis"
        ]
      },
