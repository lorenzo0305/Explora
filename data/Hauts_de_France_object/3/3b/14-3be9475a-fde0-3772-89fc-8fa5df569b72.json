  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2f145236-8a94-36a3-922d-8062bd4feaef",
      "dc:description": {
        "de": [
          "Am Heiligabend singt der Chor während der Messe die schönsten lyrischen und klassischen Lieder, um diese wunderbare Tradition zu feiern."
        ],
        "en": [
          "On Christmas Eve, the choir performs the most beautiful lyrical and classical songs at mass to celebrate this wonderful tradition."
        ],
        "it": [
          "La vigilia di Natale, il coro eseguirà le più belle canzoni liriche e classiche durante la messa per celebrare questa meravigliosa tradizione."
        ],
        "fr": [
          "Le soir du réveillon de Noël, la chorale vous interprète les plus beaux chants lyriques et classiques lors de la messe pour fêter cette merveilleuse tradition."
        ],
        "nl": [
          "Op kerstavond zal het koor de mooiste lyrische en klassieke liederen ten gehore brengen tijdens de mis om deze prachtige traditie te vieren."
        ],
        "es": [
          "En Nochebuena, el coro interpretará en misa las más bellas canciones líricas y clásicas para celebrar esta maravillosa tradición."
        ]
      },
