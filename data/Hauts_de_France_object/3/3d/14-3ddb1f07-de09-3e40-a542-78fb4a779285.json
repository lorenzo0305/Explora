  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00978106-0395-3091-8c79-4727bfbd3b47",
      "dc:description": {
        "de": [
          "Die Bäckerei und Konditorei Au coeur chaud empfängt Sie mit einer großen Auswahl an Spezialbroten, Konditoreiwaren, 100% hausgemachtem Gebäck, aber auch mit einer großen Auswahl an Sandwiches und kleinen herzhaften Gerichten für die Mittagspause"
        ],
        "en": [
          "The Au coeur chaud bakery welcomes you with its wide variety of special breads, pastries and 100% homemade viennoiseries, as well as a wide selection of sandwiches and savoury dishes for your lunch break"
        ],
        "it": [
          "La panetteria Au coeur chaud offre una vasta gamma di specialità di pane, pasticceria e dolci viennesi 100% fatti in casa, oltre a un'ampia scelta di panini e piatti salati per la pausa pranzo"
        ],
        "fr": [
          "La boulangerie Pâtisserie Au coeur chaud vous accueille avec sa grande variété de pains spéciaux, de pâtisseries, de viennoiseries 100% fait maison mais également un large choix de sandwichs et de petits plats salés pour la pause du déjeuner"
        ],
        "es": [
          "La panadería Au coeur chaud ofrece una amplia gama de especialidades de pan, bollería y pastelería 100% casera, así como una amplia selección de sándwiches y platos salados para la hora del almuerzo"
        ],
        "nl": [
          "De bakkerij Au coeur chaud biedt een breed scala aan broodspecialiteiten, gebak en 100% huisgemaakt Weens gebak, evenals een ruime keuze aan sandwiches en hartige gerechten voor je lunchpauze"
        ]
      },
      "@type": [
        "Description"
