      "@id": "https://data.datatourisme.fr/e29dc61c-41d0-35e2-a7e2-89a833177a5e",
      "dc:description": {
        "de": [
          "Dieses sympathische Café Rando mit seiner typisch flämischen Fassade ist das einzige Geschäft im Dorf und bietet Lebensmittel, Tabakwaren, Süßwaren, Brot, Zeitungen... an."
        ],
        "en": [
          "This friendly Café Rando with its typical Flemish shop front is the only shop in the village, offering groceries, tobacco, confectionery, bread, newspapers..."
        ],
        "it": [
          "L'accogliente Café Rando, con la sua tipica facciata fiamminga, è l'unico negozio del villaggio e offre generi alimentari, tabacco, dolciumi, pane, giornali, ecc."
        ],
        "fr": [
          "Ce sympathique Café Rando à la devanture typiquement flamande, unique commerce du village, propose des produits d'épicerie, tabac, confiseries, dépôt de pain, presse..."
        ],
        "es": [
          "Este acogedor Café Rando, con su típica fachada flamenca, es la única tienda del pueblo y ofrece comestibles, tabaco, dulces, pan, periódicos, etc."
        ],
        "nl": [
          "Dit gezellige Café Rando met zijn typisch Vlaamse winkelpui is de enige winkel in het dorp, met kruidenierswaren, tabak, snoepgoed, brood, kranten, enz."
        ]
      },
