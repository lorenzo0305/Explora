  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/23cb3321-4bd1-31ef-bbdb-61f4b99095d3",
      "dc:description": {
        "de": [
          "Erstellt und geleitet von Karim Affringue.\n\nDas OST ist ein professionelles Orchester, das aus 50 Musikern besteht. Das Orchester bietet jedes Jahr eine Konzertsaison an.\n\nKlassische Musik."
        ],
        "en": [
          "Created and directed by Karim Affringue.\n\nThe OST is a professional orchestra of 50 musicians. The orchestra offers a season of concerts every year.\n\nClassical music."
        ],
        "it": [
          "Creato e diretto da Karim Affringue.\n\nL'OST è un'orchestra professionale composta da 50 musicisti. L'orchestra offre una stagione di concerti ogni anno.\n\nMusica classica."
        ],
        "fr": [
          "Créé et dirigé par Karim Affringue.\n\nL’OST est un orchestre professionnel composé de 50 musiciens. L’orchestre propose chaque année une saison de concerts.\n\nMusique classique."
        ],
        "nl": [
          "Gemaakt en geregisseerd door Karim Affringue.\n\nHet OST is een professioneel orkest dat bestaat uit 50 muzikanten. Het orkest biedt elk jaar een seizoen van concerten aan.\n\nKlassieke muziek."
        ],
        "es": [
          "Creado y dirigido por Karim Affringue.\n\nLa OST es una orquesta profesional compuesta por 50 músicos. La orquesta ofrece cada año una temporada de conciertos.\n\nMúsica clásica."
        ]
      },
