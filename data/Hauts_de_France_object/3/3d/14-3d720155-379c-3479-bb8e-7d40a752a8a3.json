  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Aufführungen der Fadenpuppen des Théâtre Mariska in Lens!\nDas Théâtre Mariska, das sind Millionen von Lächeln, Händeklatschen und guten Momenten, die wir seit 1984 mit Ihnen teilen."
    ],
    "en": [
      "Discover Théâtre Mariska's string puppet shows in Lens!\nThéâtre Mariska has been sharing millions of smiles, hand-claps and good times with you since 1984."
    ],
    "it": [
      "Scoprite gli spettacoli di marionette a filo di Théâtre Mariska a Lens!\nDal 1984, il Théâtre Mariska ha condiviso con voi milioni di sorrisi, applausi e divertimento."
    ],
    "fr": [
      "Découvrez les spectacles de Marionnettes à fils du Théâtre Mariska à Lens !\nLe Théâtre Mariska, ce sont des millions de sourires, de clappements de mains et de bons moments que nous partageons avec vous depuis 1984."
    ],
    "es": [
      "¡Descubra los espectáculos de marionetas de hilo de Théâtre Mariska en Lens!\nDesde 1984, el Théâtre Mariska comparte con usted millones de sonrisas, aplausos y buenos momentos."
    ],
    "nl": [
      "Ontdek de marionettenvoorstellingen van Théâtre Mariska in Lens!\nThéâtre Mariska deelt al sinds 1984 miljoenen glimlachen, klappen en pleziertjes met jou."
    ]
  },
