      "dc:description": {
        "de": [
          "Bar-Brasserie-Live-Musik\n\nEin gemütlicher Ort, um sich zu entspannen, einen guten Kaffee zu genießen und sich mit leckeren Häppchen verwöhnen zu lassen."
        ],
        "en": [
          "Bar-brewery-live music\n\nA comfortable place to relax, enjoy a good cup of coffee and indulge in delicious bites."
        ],
        "it": [
          "Bar-brasserie-musica dal vivo\n\nUn luogo accogliente dove rilassarsi, gustare una buona tazza di caffè e assaporare deliziosi bocconcini."
        ],
        "fr": [
          "Bar-brasserie-live music\n\nUn endroit confortable pour se détendre, savourer un bon café et se laisser tenter par de délicieuses bouchées."
        ],
        "es": [
          "Bar-brasserie-música en directo\n\nUn lugar acogedor para relajarse, disfrutar de una buena taza de café y deleitarse con deliciosos bocados."
