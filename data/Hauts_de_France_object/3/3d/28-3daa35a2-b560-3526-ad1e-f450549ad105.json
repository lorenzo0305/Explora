  "rdfs:comment": {
    "de": [
      "Das Gasthaus Dikke Buuk ist eine flämische Kneipe, in der eine gemütliche Atmosphäre herrscht.\nIm Herzen von Bailleul gelegen, bieten wir Ihnen typisch flämische Gerichte und Gaumenfreuden!"
    ],
    "en": [
      "The Dikke Buuk Inn is a Flemish restaurant with a friendly atmosphere.\nLocated in the heart of Bailleul, we offer you typical Flemish and gourmet dishes!"
    ],
    "it": [
      "Il Dikke Buuk Inn è un ristorante fiammingo dall'atmosfera accogliente.\nSituato nel cuore di Bailleul, vi offre piatti tipici fiamminghi e gourmet!"
    ],
    "fr": [
      "L’auberge du Dikke Buuk est un estaminet flamand où règne une ambiance conviviale.\nSitué au cœur de Bailleul, nous vous proposons des plats typiquement flamands et gourmands!"
    ],
    "es": [
      "La posada Dikke Buuk es un restaurante flamenco de ambiente acogedor.\nSituado en el corazón de Bailleul, ¡le ofrecemos platos típicos flamencos y gourmet!"
    ],
    "nl": [
      "De Dikke Buuk Inn is een Vlaams restaurant met een gezellige sfeer.\nGelegen in het hartje van Bailleul bieden wij u typisch Vlaamse en gastronomische gerechten aan!"
    ]
  },
