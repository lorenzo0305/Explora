      "@id": "https://data.datatourisme.fr/cdeb5732-f8ca-34a5-b79a-98faf713bde6",
      "dc:description": {
        "de": [
          "Eine hausgemachte Küche, verbunden mit der Einfachheit frischer Produkte, aber auch mit der kulinarischen Vielfalt, die uns die verschiedenen Jahreszeiten bieten."
        ],
        "en": [
          "Homemade cooking, combined with the simplicity of fresh produce and the culinary diversity that the different seasons offer."
        ],
        "it": [
          "La cucina casalinga, unita alla semplicità dei prodotti freschi e alla diversità culinaria offerta dalle diverse stagioni."
        ],
        "fr": [
          "Une cuisine faite maison, associée à la simplicité des produits frais mais aussi à la diversité culinaire que les différentes saisons nous offre."
        ],
        "es": [
          "La cocina casera, combinada con la sencillez de los productos frescos y la diversidad culinaria que ofrecen las distintas estaciones."
        ],
        "nl": [
          "Huisgemaakte gerechten, gecombineerd met de eenvoud van verse producten en de culinaire diversiteit die de verschillende seizoenen bieden."
        ]
      },
