  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich ein Erlebnis, das Entdeckung, Natur, Sport und Spaß miteinander verbindet, indem Sie an einer Tour mit dem Elektroroller teilnehmen!\nFahren Sie mit Jérome, Ihrem Guide, den Scarpe-Kanal entlang. Er führt Sie entlang des Treidelpfades, Sie kommen am Museumspark Arkéos vorbei und erleben viele weitere Überraschungen."
    ],
    "en": [
      "Treat yourself to an experience that combines discovery, nature, sport and fun on an electric scooter tour!\nRide along the Scarpe Canal with Jérome, your guide. He'll take you along the towpath, past the Arkéos museum-park and many other surprises."
    ],
    "it": [
      "Regalatevi un'esperienza che unisce scoperta, natura, sport e divertimento con un tour in scooter elettrico!\nPercorrete il Canale delle Scarpe con Jérome, la vostra guida. Vi condurrà lungo l'alzaia, passando per il parco-museo Arkéos e molte altre sorprese."
    ],
    "fr": [
      "Offrez-vous une expérience qui allie découverte, nature, sport et amusement en participant à une visite à trottinette électrique !\nLongez le canal de la Scarpe avec Jérome, votre guide. Il vous emmène le long du chemin du halage, vous passerez devant le musée-parc Arkéos et bien d'autres surprises."
    ],
    "nl": [
      "Trakteer jezelf op een ervaring die ontdekking, natuur, sport en plezier combineert tijdens een tocht op een elektrische scooter!\nRijd langs het Scarpe-kanaal met Jérome, je gids. Hij neemt je mee over het jaagpad, langs het Arkéos museum-park en vele andere verrassingen."
    ],
    "es": [
      "Regálese una experiencia que combina descubrimiento, naturaleza, deporte y diversión en una excursión en patinete eléctrico\nRecorra el Canal de Scarpe con Jérome, su guía. Te llevará por el camino de sirga, pasando por el parque-museo Arkéos y muchas otras sorpresas."
    ]
  },
