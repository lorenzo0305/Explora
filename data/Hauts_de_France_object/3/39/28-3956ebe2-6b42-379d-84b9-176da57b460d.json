  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7ecaf130-e562-3258-81b6-aaf0353c2f19",
      "dc:description": {
        "de": [
          "Das Noisette Coffee House ist ein gemütlicher Raum, in dem Sie heiße Getränke mit Keksen, Muffins oder leckeren Donuts genießen können, ideal für den Abend nach einem anstrengenden Arbeitstag (oder für einen guten Start in den Tag).\n\nDas Café bietet auch Mittagsgerichte an."
        ],
        "en": [
          "The Noisette Coffee House is a cosy space where you can enjoy hot drinks accompanied by cookies, muffins or tasty doughnuts, ideal in the evening after a hard day's work (or to get your day off to a good start).\n\nThe café also serves fast food at lunchtime."
        ],
        "it": [
          "Il Noisette Coffee House è un luogo accogliente dove si possono gustare bevande calde accompagnate da biscotti, muffin o gustose ciambelle, ideali la sera dopo una dura giornata di lavoro (o per iniziare bene la giornata).\n\nIl caffè serve anche piatti veloci a pranzo."
        ],
        "fr": [
          "Le café Noisette Coffee House est un espace cosy qui vous permet de venir déguster des boissons chaudes accompagnées de cookies, muffins ou encore de savoureux donuts , idéal le soir après une dure journée de travail (ou pour bien commencer sa journée). \n\nLe café propose également de la restauration rapide le midi."
        ],
        "es": [
          "La cafetería Noisette es un lugar acogedor donde podrá disfrutar de bebidas calientes acompañadas de galletas, magdalenas o sabrosos donuts, ideal por la tarde después de un duro día de trabajo (o para empezar bien el día).\n\nLa cafetería también sirve comida rápida al mediodía."
        ],
        "nl": [
          "Het Noisette Coffee House is een gezellige plek waar je kunt genieten van warme dranken met koekjes, muffins of lekkere donuts, ideaal voor 's avonds na een dag hard werken (of om je dag goed te beginnen).\n\nHet café serveert ook fastfood tijdens de lunch."
        ]
      },
      "@type": [
        "Description"
      ],
