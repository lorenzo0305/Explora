  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/36712421-b57d-38d7-a592-9f5f02737ed0",
      "dc:description": {
        "de": [
          "Kieselstrand an der Grand Site de France des Deux-Caps. Zwischen Audresselles und dem Gris-Nez ist die Steilküste sehr wild geblieben und wird von einer Reihe von Cran (Cran poulet, cran aux oeufs etc.) gesäumt"
        ],
        "en": [
          "Pebble beach on the Deux-Caps Grand Site de France. Between Audresselles and the Gris-Nez, the cliff is still very wild, lined with a succession of notches (Cran poulet, Cran aux oeufs etc.)"
        ],
        "it": [
          "Spiaggia di ciottoli sul Grand Site de France delle Deux-Caps. Tra Audresselles e il Gris-Nez, la falesia è rimasta molto selvaggia, delimitata da una successione di tacche (Cran poulet, Cran aux oeufs, ecc.)"
        ],
        "fr": [
          "Plage de galets sur le Grand Site de France des Deux-Caps. Entre Audresselles et le Gris-Nez la falaise est restée très sauvage, bordée par une succession de crans (Cran poulet, cran aux oeufs etc.)"
        ],
        "es": [
          "Playa de guijarros en el Deux-Caps Grand Site de France. Entre Audresselles y el Gris-Nez, el acantilado ha permanecido muy salvaje, bordeado por una sucesión de muescas (Cran poulet, Cran aux oeufs etc.)"
        ],
        "nl": [
          "Kiezelstrand op de Grand Site de France van de Deux-Caps. Tussen Audresselles en de Gris-Nez is de klif erg wild gebleven, begrensd door een opeenvolging van inkepingen (Cran poulet, Cran aux oeufs enz.)"
        ]
      },
      "@type": [
        "Description"
