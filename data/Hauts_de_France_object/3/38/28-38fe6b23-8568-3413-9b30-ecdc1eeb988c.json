  "rdfs:comment": {
    "de": [
      "Der Künstler CAAME wird uns in die Kunst des Video Jocking (VJ) einführen. Die Kunst der Manipulation von Live-Bildern, oft synchron mit Musik, um audiovisuelle Live-Performances zu schaffen (Festivals, Clubs, Vorführungen, etc.). Er wird einen kollektiven VJing-Workshop leiten, um mit dieser Praxis zu experimentieren."
    ],
    "en": [
      "Artist CAAME will introduce us to the art of Video Jocking (VJ). The art of manipulating live images, often in synchronization with music, to create live audiovisual performances (festivals, clubs, screenings, etc.). He will be leading a collective VJing workshop to experiment with this practice."
    ],
    "it": [
      "L'artista CAAME ci introdurrà all'arte del Video Jocking (VJ). L'arte di manipolare immagini dal vivo, spesso in sincronizzazione con la musica, per creare performance audiovisive dal vivo (festival, club, proiezioni, ecc.). Condurrà un workshop collettivo di VJing per sperimentare questa pratica."
    ],
    "fr": [
      "L’artiste CAAME nous fera découvrir l’art du Video Jocking (VJ). L’art de la manipulation d’images en direct, souvent en synchronisation avec de la musique, pour créer des performances audiovisuelles live (festivals, clubs, projections, etc.). Il animera un atelier collectif de VJing pour expérimenter cette pratique."
    ],
    "nl": [
      "Kunstenaar CAAME laat ons kennismaken met de kunst van Video Jocking (VJ). De kunst van het manipuleren van live beelden, vaak synchroon met muziek, om live audiovisuele performances te creëren (festivals, clubs, screenings, enz.). Hij zal een collectieve VJing workshop leiden om met deze praktijk te experimenteren."
    ],
    "es": [
      "El artista CAAME nos introducirá en el arte del Video Jocking (VJ). El arte de manipular imágenes en directo, a menudo en sincronía con la música, para crear espectáculos audiovisuales en directo (festivales, clubes, proyecciones, etc.). Dirigirá un taller colectivo de VJing para experimentar con esta práctica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Rencontres Pro - CAAME -Louis Garcia - Artiste VJ (vidéo-jockey)"
    ]
  },
