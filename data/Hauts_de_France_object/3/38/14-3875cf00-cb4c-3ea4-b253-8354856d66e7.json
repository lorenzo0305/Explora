  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b9adffe7-f155-3a18-bcc3-74056b7b4aa3",
      "dc:description": {
        "de": [
          "Das Restaurant Chez Legris in Tincques lädt Sie ein, traditionelle Küche in einer familiären und herzlichen Atmosphäre zu entdecken. Das Lokal befindet sich gegenüber dem Industriegebiet Écopolis und bietet ein Tagesmenü zu einem erschwinglichen Preis."
        ],
        "en": [
          "The Chez Legris restaurant in Tincques invites you to discover traditional cuisine in a warm, family atmosphere. Located opposite the Écopolis industrial zone, this establishment offers a daily menu at an affordable price."
        ],
        "it": [
          "Il ristorante Chez Legris di Tincques vi invita a scoprire la cucina tradizionale in un'atmosfera calda e familiare. Situato di fronte alla zona industriale di Écopolis, il ristorante offre un menu giornaliero a un prezzo accessibile."
        ],
        "fr": [
          "Le restaurant Chez Legris à Tincques vous invite à découvrir une cuisine traditionnelle dans une ambiance familiale et chaleureuse. Situé en face de la zone industrielle Écopolis, cet établissement propose un menu du jour à un prix abordable."
        ],
        "nl": [
          "Het restaurant Chez Legris in Tincques nodigt u uit om de traditionele keuken te ontdekken in een warme, familiale sfeer. Het restaurant ligt tegenover het industrieterrein Écopolis en biedt een dagmenu tegen een betaalbare prijs."
        ],
        "es": [
          "El restaurante Chez Legris de Tincques le invita a descubrir la cocina tradicional en un ambiente cálido y familiar. Situado frente al polígono industrial Écopolis, el restaurante ofrece un menú diario a un precio asequible."
        ]
      },
