      "dc:description": {
        "de": [
          "Traditionelles Brot aus dem Holzofen, Brioches, Kuchen, Pizzas...\nLaden täglich außer am Sonntag von 6:30 bis 20:00 Uhr geöffnet."
        ],
        "en": [
          "Traditional wood-fired bread, brioches, cakes, pizzas...\nStore open every day except Monday from 6.30am to 8pm."
        ],
        "it": [
          "Pane tradizionale cotto a legna, brioches, torte, pizze...\nNegozio aperto tutti i giorni, tranne il lunedì, dalle 6.30 alle 20.00."
        ],
        "fr": [
          "Pain traditionnel cuit au feu de bois, brioches, gâteaux, pizzas...\nMagasin ouvert tous les jours sauf le undi de 6h30 à 20h."
        ],
        "nl": [
          "Traditioneel brood gebakken op houtvuur, brioches, taarten, pizza's...\nWinkel elke dag geopend behalve maandag van 6.30 tot 20.00 uur."
        ],
        "es": [
          "Pan tradicional cocido al fuego de leña, brioches, pasteles, pizzas...\nTienda abierta todos los días excepto el lunes de 6.30 a 20.00 h."
        ]
      },
