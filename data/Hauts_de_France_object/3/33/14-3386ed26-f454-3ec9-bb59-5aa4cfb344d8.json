  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/01e46616-063b-3571-8e48-294ff0d670df",
      "dc:description": {
        "de": [
          "Les Terrasses du Green bietet Ihnen zwei Terrassen, eine davon nach Süden, Themenabende und eine gesellige und traditionelle Küche. Verkauf zum Mitnehmen\nAuthentizität und Gastfreundschaft sind unsere Schlüsselwörter"
        ],
        "en": [
          "Les Terrasses du Green offers two terraces, one of which faces south, themed evenings and traditional, convivial cuisine. Takeaway sales\nAuthenticity and conviviality are our watchwords"
        ],
        "it": [
          "Les Terrasses du Green offre due terrazze, di cui una esposta a sud, serate a tema e una cucina tradizionale e cordiale. Vendite da asporto\nAutenticità e convivialità sono le nostre parole d'ordine"
        ],
        "fr": [
          "Les Terrasses du Green vous propose deux terrasses, dont une plein sud, des soirées à thèmes ,une cuisine convivial et traditionnelle. Vente à emporter\nAuthencité , convivialité sont nos maitres mots"
        ],
        "es": [
          "Les Terrasses du Green ofrece dos terrazas, una de ellas orientada al sur, veladas temáticas y una cocina acogedora y tradicional. Venta para llevar\nAutenticidad y convivialidad son nuestras consignas"
        ],
        "nl": [
          "Les Terrasses du Green biedt twee terrassen, waarvan een op het zuiden, thema-avonden en een vriendelijke, traditionele keuken. Afhaalmaaltijden\nAuthenticiteit en gezelligheid zijn onze sleutelwoorden"
        ]
      },
      "@type": [
        "Description"
      ],
