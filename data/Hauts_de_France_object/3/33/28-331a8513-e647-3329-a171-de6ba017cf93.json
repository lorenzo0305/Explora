  "rdfs:comment": {
    "de": [
      "Das Musée Jeanne d'Aboville in La Fère zählt zu den Juwelen der Kunst in Axon und zeigt eine außergewöhnliche Gemäldesammlung, die von einer Gräfin im 19. Jahrhundert zusammengetragen und ihrer Heimatstadt geschenkt wurde."
    ],
    "en": [
      "One of the jewels of Aix-en-Provence art, the Musée Jeanne d?Aboville in La Fère presents an exceptional collection of paintings assembled by a 19th-century countess and donated to her home town."
    ],
    "it": [
      "Uno dei gioielli dell'arte dell'Aube, il Musée Jeanne d'Aboville di La Fère presenta un'eccezionale collezione di dipinti raccolti da una contessa del XIX secolo e donati alla sua città natale."
    ],
    "fr": [
      "Figurant parmi les joyaux de l’art axonais, le musée Jeanne d’Aboville de La Fère présente une collection de peinture exceptionnelle rassemblée par une comtesse du XIXe siècle et offerte à sa ville natale."
    ],
    "nl": [
      "Het Musée Jeanne d'Aboville in La Fère, een van de juweeltjes van de kunst in de Aube, toont een uitzonderlijke verzameling schilderijen die door een 19e-eeuwse gravin zijn verzameld en aan haar geboortestad geschonken."
    ],
    "es": [
      "El Museo Jeanne d'Aboville de La Fère, una de las joyas del arte de Aube, exhibe una excepcional colección de pinturas reunidas por una condesa del siglo XIX y donadas a su ciudad natal."
    ]
  },
