  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a210efd2-7b48-3bcf-9c73-911824901735",
      "dc:description": {
        "de": [
          "Während der Februarferien von Montag bis Freitag von 14:30 bis 16:00 Uhr\nMulti-Sport-Kid-Kurs Im Freien oder in der Halle\nFür die 09- bis 12-Jährigen\n50 ? pro Kurs\nAnmeldung auf kmco-hardelot.fr\nOder an der Rezeption der Base de Glisse Georges Pernoud"
        ],
        "en": [
          "During the February vacations from Monday to Friday from 2.30 to 4.00 pm\nKid multi-sports course Outdoor or indoor\nFor 09 - 12 year olds\n50 ? per course\nRegistration on kmco-hardelot.fr\nOr at the reception desk of the Georges Pernoud Snow Sports Center"
        ],
        "it": [
          "Durante le vacanze di febbraio dal lunedì al venerdì dalle 14.30 alle 16.00\nCorso multisport per bambini All'aperto o al coperto\nPer ragazzi dai 09 ai 12 anni\n50 ? per corso\nIscrizioni su kmco-hardelot.fr\nO presso la reception del centro di sport sulla neve Georges Pernoud"
        ],
        "fr": [
          "Durant les vacances de Février du Lundi au Vendredi de 14H30 à 16H00\nStage Kid multi-sports En extérieur ou en salle\nPour le 09 - 12 ans\n50 € le stage \nInscription sur kmco-hardelot.fr\nOu à l'accueil de la base de Glisse Georges Pernoud"
        ],
        "nl": [
          "Tijdens de februarivakantie van maandag tot vrijdag van 14H30 tot 16H00\nKid multi-sportcursus Buiten of binnen\nVoor kinderen van 09-12 jaar\n50 per cursus\nInschrijven op kmco-hardelot.fr\nOf bij de receptie van het Georges Pernoud sneeuwsportcentrum"
        ],
        "es": [
          "Durante las vacaciones de febrero de lunes a viernes de 14H30 a 16H00\nCurso multideporte para niños Al aire libre o en interior\nPara niños de 09 a 12 años\n50€ por curso\nInscripciones en kmco-hardelot.fr\nO en la recepción del centro de deportes de nieve Georges Pernoud"
        ]
      },
