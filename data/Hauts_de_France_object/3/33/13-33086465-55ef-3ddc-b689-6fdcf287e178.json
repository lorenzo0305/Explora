  "rdfs:comment": {
    "de": [
      "Diese Kapelle aus Ziegelstein mit abgeschrägtem Grundriss wurde 1673 erbaut, um eine andere zu ersetzen. Sie besitzt ein Glockentürmchen mit Schalldämpfer."
    ],
    "en": [
      "This brick chapel was built in 1673 to replace another one. It has a bell tower with a bell shade."
    ],
    "it": [
      "Questa cappella in mattoni fu costruita nel 1673 per sostituirne un'altra. Ha un campanile con campana a vela."
    ],
    "fr": [
      "Chapelle en brique de plan à pans coupés bâtie en 1673 en remplacement d’une autre. Elle possède un clocheton à abat-son."
    ],
    "es": [
      "Esta capilla de ladrillo se construyó en 1673 para sustituir a otra. Tiene un campanario con sombra de campana."
    ],
    "nl": [
      "Deze bakstenen kapel werd in 1673 gebouwd ter vervanging van een andere. Het heeft een klokkentoren met een kap."
    ]
