  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/be6b356a-5174-3923-9a98-9de90dab3566",
      "dc:description": {
        "de": [
          "Die Kirche Saint-Antoine in Coupelle-Neuve wurde im 18. Jahrhundert aus Stein erbaut. Der Glockenturm wurde um 1864 vom Architekten Bonnard wieder aufgebaut. Die Bronzeglocke stammt aus dieser Zeit."
        ],
        "en": [
          "The church of Saint-Antoine de Coupelle-Neuve was built in stone in the 18th century. The bell tower was rebuilt around 1864 by the architect Bonnard. The bronze bell dates from this period."
        ],
        "it": [
          "La chiesa di Saint-Antoine de Coupelle-Neuve è stata costruita in pietra nel XVIII secolo. Il campanile fu ricostruito intorno al 1864 dall'architetto Bonnard. La campana di bronzo risale a questo periodo."
        ],
        "fr": [
          "L'église Saint-Antoine de Coupelle-Neuve a été bâtie en pierre au XVIIIe siècle. Le clocher a été reconstruit vers 1864 par l'architecte Bonnard. La cloche en bronze date de cette époque."
        ],
        "es": [
          "La iglesia de Saint-Antoine de Coupelle-Neuve fue construida en piedra en el siglo XVIII. El campanario fue reconstruido hacia 1864 por el arquitecto Bonnard. La campana de bronce data de esta época."
        ],
        "nl": [
          "De kerk Saint-Antoine de Coupelle-Neuve werd in de 18e eeuw in steen opgetrokken. De klokkentoren werd rond 1864 herbouwd door de architect Bonnard. De bronzen bel dateert uit deze periode."
        ]
      },
