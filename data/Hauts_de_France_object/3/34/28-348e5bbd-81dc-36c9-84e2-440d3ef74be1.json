      "dc:description": {
        "de": [
          "Bar, die sich in einem Gewölbekeller befindet. Große Auswahl an frisch gezapften Bieren und Cocktails\nBeliebte Bar bei Studenten und jungen Führungskräften\nMusikrichtung: Rock, Elektronik (Trip Hop, Jungle, Dub, Reggae)"
        ],
        "en": [
          "Bar located in a vaulted cellar. Wide selection of draught beers and cocktails\nVery popular with students and young executives\nMusic: rock, electronic (trip hop, jungle, dub, reggae)"
        ],
        "it": [
          "Bar situato in una cantina a volta. Ampia scelta di birre alla spina e di cocktail\nBar molto frequentato da studenti e giovani dirigenti\nTipo di musica: rock, elettronica (trip hop, jungle, dub, reggae)"
        ],
        "fr": [
          "Bar situé dans une cave voûtée. Grand choix de bières pression et de cocktail\nBar très prisé des étudiants et des jeunes cadres\nType de musique: rock,électronique (trip hop,jungle,dub,reggae)"
        ],
        "es": [
          "Bar situado en una bodega abovedada. Amplia selección de cervezas de barril y cócteles\nBar muy frecuentado por estudiantes y jóvenes ejecutivos\nTipo de música: rock, electrónica (trip hop, jungle, dub, reggae)"
        ],
        "nl": [
          "Bar in een gewelfde kelder. Ruime keuze aan tapbieren en cocktails\nZeer populaire bar bij studenten en jonge kaderleden\nSoort muziek: rock, elektronisch (trip hop, jungle, dub, reggae)"
        ]
      },
