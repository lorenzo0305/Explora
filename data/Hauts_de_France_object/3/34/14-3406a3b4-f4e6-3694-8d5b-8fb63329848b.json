  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/04caa491-2c1a-3b9d-a5a0-28fdf784a979",
      "dc:description": {
        "de": [
          "Neue Konditorei-Schokoladenfabrik am 1073 Boulevard Labrasse in Stella-plage.\n\nEntdecken Sie die Welt von Annabelle und Alexandre mit 100% hausgemachten Konditoreiwaren, Schokoladen, Süßwaren, Gebäck und herzhaften Gerichten. Frische, lokale und saisonale Produkte.\n\nMittwoch bis Samstag von 8:00 bis 19:00 Uhr geöffnet\nSonntags von 8.00 bis 18.00 Uhr\nMontags und dienstags geschlossen"
        ],
        "en": [
          "New patisserie-chocolaterie at 1073 boulevard Labrasse, Stella-plage.\n\nDiscover Annabelle and Alexandre's world of 100% homemade pastries, chocolates, confectionery, viennoiseries and savoury dishes. Fresh, local and seasonal products.\n\nOpen Wednesday to Saturday, 8h00 to 19h00\nSunday from 8h00 to 18h00\nClosed Monday and Tuesday"
        ],
        "it": [
          "Nuova patisserie-chocolaterie situata al 1073 di boulevard Labrasse a Stella-plage.\n\nScoprite il mondo di Annabelle e Alexandre fatto di pasticcini, cioccolatini, dolciumi, pasticceria viennese e piatti salati 100% fatti in casa. Prodotti freschi, locali e di stagione.\n\nAperto da mercoledì a sabato, dalle 8.00 alle 19.00\nDomenica dalle 8.00 alle 18.00\nChiuso il lunedì e il martedì"
        ],
        "fr": [
          "Nouvelle pâtisserie-chocolaterie située au 1073 boulevard Labrasse de Stella-plage.\n\nDécouvrez l'univers d'Annabelle et Alexandre au travers de pâtisseries, chocolats, confiseries, viennoiseries et mets salés, 100% maison. Des produits frais, locaux et respectant la saisonnalité.\n\nOuvert du mercredi au samedi de 8h00 à 19h00\nLe dimanche de 8h00 à 18h00\nFermé le lundi et le mardi"
        ],
        "es": [
          "Nueva pastelería-chocolatería situada en el 1073 del bulevar Labrasse, en Stella-plage.\n\nDescubra el universo de Annabelle y Alexandre de bollería, chocolates, confitería, bollería vienesa y platos salados 100% caseros. Productos frescos, locales y de temporada.\n\nAbierto de miércoles a sábado de 8.00 a 19.00 h\nDomingo de 8h a 18h\nCerrado lunes y martes"
        ],
        "nl": [
          "Nieuwe patisserie-chocolaterie op 1073 boulevard Labrasse in Stella-plage.\n\nOntdek Annabelle en Alexandre's wereld van 100% huisgemaakt gebak, chocolade, snoepgoed, Weens gebak en hartige gerechten. Verse, lokale en seizoensgebonden producten.\n\nGeopend van woensdag tot zaterdag van 8 tot 19 uur\nZondag van 8 tot 18 uur\nGesloten op maandag en dinsdag"
        ]
      },
