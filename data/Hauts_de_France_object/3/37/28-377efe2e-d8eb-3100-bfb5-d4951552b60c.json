  "rdfs:comment": {
    "de": [
      "In Bourg-et-Comin, in der Nähe des Chemin des Dames, finden Sie in Rêves d'eau ein Spa (Hammam, Sauna, Jacuzzi, Ruheraum), aber auch einen Loungebereich mit Teesalon und Bistroküche und nicht zu vergessen einen Bereich für Modellage!\nKurzum, ein Ort, der ganz der Entspannung und dem Wohlbefinden gewidmet ist!"
    ],
    "en": [
      "Located in Bourg-et-Comin, near the Chemin des Dames, you will find at Rêves d'eau a Spa (hammam, sauna, jacuzzi, rest room), but also a lounge area with a tea room and a bistro kitchen, without forgetting a modelling area!\nIn short, a place entirely dedicated to relaxation and well-being!"
    ],
    "it": [
      "Situato a Bourg-et-Comin, vicino al Chemin des Dames, Rêves d'eau offre una Spa (hammam, sauna, jacuzzi, sala relax), ma anche un'area lounge con sala da tè e cucina bistrot, senza dimenticare un'area massaggi!\nInsomma, un ambiente interamente dedicato al relax e al benessere!"
    ],
    "fr": [
      "Situé à Bourg-et-Comin, à proximité du Chemin des Dames, vous trouverez à Rêves d'eau un Spa (hammam, sauna, jacuzzi, salle de repos), mais aussi un espace lounge avec salon de thé et cuisine bistrot, sans oublier un espace de modelage !\nBref, un écrin entièrement dédié à la détente et au bien-être !"
    ],
    "es": [
      "Situado en Bourg-et-Comin, cerca del Chemin des Dames, en Rêves d'eau encontrará un Spa (hammam, sauna, jacuzzi, sala de descanso), pero también una zona de descanso con salón de té y cocina bistró, ¡sin olvidar una zona de modelismo!\nEn definitiva, un entorno totalmente dedicado a la relajación y el bienestar"
    ],
    "nl": [
      "Gelegen in Bourg-et-Comin, vlakbij de Chemin des Dames, vindt u bij Rêves d'eau een Spa (hammam, sauna, jacuzzi, rustruimte), maar ook een loungeruimte met een theesalon en een bistrokeuken, zonder een boetseerruimte te vergeten!\nKortom, een omgeving die volledig gewijd is aan ontspanning en welzijn!"
    ]
  },
  "rdfs:label": {
