      "dc:description": {
        "de": [
          "Teestube, auch an bestimmten Sonn- und Feiertagen geöffnet\nSehr verschiedene Getränke, Crêpes, Waffeln, Gebäck, Viennoiserie, Gerichte zum Mittagessen."
        ],
        "en": [
          "Tearoom, also open on Sundays and holidays\nA wide variety of drinks, pancakes, waffles, pastries, pastries, lunch dishes..."
        ],
        "it": [
          "Sala da tè, aperta anche alcune domeniche e giorni festivi\nUn'ampia varietà di bevande, pancake, waffle, pasticcini, dolci, piatti per il pranzo."
        ],
        "fr": [
          "Salon de thé, ouvert également certains dimanche et jours fériés\nBoissons très variées, crêpes, gaufres, pâtisseries, viennoiseries, plats pour déjeuner.."
        ],
        "nl": [
          "Theesalon, ook open op sommige zon- en feestdagen\nEen grote verscheidenheid aan dranken, pannenkoeken, wafels, gebak, lunchgerechten."
        ],
        "es": [
          "Salón de té, abierto también algunos domingos y días festivos\nUna gran variedad de bebidas, crepes, gofres, pasteles, bollería, platos para el almuerzo."
        ]
      },
