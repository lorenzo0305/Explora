  "rdfs:comment": {
    "de": [
      "Der Wahnsinn? Psychiatrische Krankheit?\n\nMithilfe von Mitarbeitern des Krankenhauszentrums zeigt das Museum die Entwicklung der Behandlungen in der Psychiatrie von früher bis heute und entmystifiziert so das Tabu, das noch immer auf psychischen Krankheiten lastet."
    ],
    "en": [
      "Madness? Psychiatric illness?\n\nThanks to employees of the Hospital Center, the museum presents the evolution of psychiatric treatments from yesterday to today and thus demystifies the taboo that still hangs over mental illness."
    ],
    "it": [
      "Follia? Malattia psichiatrica?\n\nGrazie ai dipendenti dell'ospedale, il museo presenta l'evoluzione del trattamento psichiatrico dal passato ai giorni nostri, demistificando così il tabù che ancora grava sulla malattia mentale."
    ],
    "fr": [
      "La folie ? La maladie psychiatrique ? \n\nGrâce à des employés du Centre Hospitalier, le musée présente l'évolution des traitements en psychiatrie d'hier à nos jours et démystifie ainsi le tabou qui pèse encore sur les maladies mentales."
    ],
    "es": [
      "¿Locura? ¿Enfermedad psiquiátrica?\n\nGracias a los empleados del Centro Hospitalario, el museo presenta la evolución de los tratamientos psiquiátricos desde el pasado hasta la actualidad y desmitifica así el tabú que aún pesa sobre las enfermedades mentales."
    ],
    "nl": [
      "Waanzin? Psychiatrische ziekte?\n\nDankzij medewerkers van het ziekenhuis presenteert het museum de evolutie van de psychiatrische behandeling van vroeger tot nu en ontmaskert zo het taboe dat nog steeds op geestesziekten rust."
    ]
  },
