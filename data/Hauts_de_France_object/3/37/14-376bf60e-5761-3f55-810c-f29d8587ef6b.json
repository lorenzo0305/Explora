  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/56a4a47e-3c31-33eb-b79d-bcbd555d33cd",
      "dc:description": {
        "de": [
          "Diese kleine Kapelle im neoklassizistischen Stil wurde 1832 aus Ziegelsteinen und Kreide erbaut und hat ein konisches Schieferdach."
        ],
        "en": [
          "Made of brick and chalk, topped by a conical slate roof, this small neo-classical style chapel was built in 1832."
        ],
        "it": [
          "Realizzata in mattoni e gesso, sormontata da un tetto conico in ardesia, questa piccola cappella neoclassica fu costruita nel 1832."
        ],
        "fr": [
          "Constituée de briques et de craie, surmontée d'un toit conique en ardoise, cette petite chapelle de style néo-classique fut construite en 1832."
        ],
        "nl": [
          "Deze kleine neoklassieke kapel van baksteen en kalk, met een kegelvormig leien dak, werd gebouwd in 1832."
        ],
        "es": [
          "De ladrillo y tiza, rematada con un tejado cónico de pizarra, esta pequeña capilla neoclásica fue construida en 1832."
        ]
      },
