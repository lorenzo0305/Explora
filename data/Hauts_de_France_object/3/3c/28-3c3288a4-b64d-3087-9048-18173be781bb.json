  "rdfs:comment": {
    "de": [
      "Entspannen Sie sich und tun Sie sich etwas Gutes während einer sanften Gymnastikstunde mit Emma am Strand.\n\nRDV Plage Anima'Pôle - Handtuch oder Matte und eine Flasche Wasser mitbringen.\n\nBei schlechtem Wetter Rückzug in die Wassersportbasis."
    ],
    "en": [
      "Come and relax and feel good during a gentle gym session with Emma on the beach.\n\nRDV Plage Anima'Pôle - Bring towel or mat and bottle of water.\n\nFallback to the nautical base in case of bad weather."
    ],
    "it": [
      "Venite a rilassarvi e a sentirvi bene durante una sessione di ginnastica dolce con Emma sulla spiaggia.\n\nRitrovo alla spiaggia di Anima'Pôle - Portate un asciugamano o un tappetino e una bottiglia d'acqua.\n\nIn caso di maltempo si può tornare alla base nautica."
    ],
    "fr": [
      "Venez vous détendre et vous faire du bien  le temps d'une séance de gym douce avec Emma sur la plage.\n\nRDV Plage Anima'Pôle - Prévoir serviette ou tapis de sol et une bouteille d'eau.\n\nReplis à la base nautique en cas de mauvais temps."
    ],
    "es": [
      "Ven a relajarte y a sentirte bien durante una suave sesión de gimnasia con Emma en la playa.\n\nCita en la playa de Anima'Pôle - Trae una toalla o esterilla y una botella de agua.\n\nRegreso a la base náutica en caso de mal tiempo."
    ],
    "nl": [
      "Kom ontspannen en je goed voelen tijdens een rustige gymnastieksessie met Emma op het strand.\n\nAfspraak op het strand van Anima'Pôle - Neem een handdoek of matje en een fles water mee.\n\nTerugval naar de nautische basis in geval van slecht weer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "SPORT : Gym douce"
    ]
  },
  "creationDate": "2023-06-12",
