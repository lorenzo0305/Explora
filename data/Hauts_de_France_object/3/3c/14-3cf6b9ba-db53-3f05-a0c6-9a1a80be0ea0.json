  "rdfs:comment": {
    "de": [
      "Ein Bergfried, der nicht wie alle anderen ist. Ein mittelalterliches Festungshaus, das in einem grünen Tal verloren ist. Es ist einzigartig in seiner Art und kann mit einem Führer besichtigt werden, um die Geheimnisse des herrschaftlichen Lebens zu entdecken und in das Mittelalter einzutauchen."
    ],
    "en": [
      "A dungeon like no other. A medieval stronghold lost in a green valley. It's one of a kind, and can be visited with a guide to discover the secrets of seigneurial life, immersed in the Middle Ages."
    ],
    "it": [
      "Un torrione come nessun altro. Una roccaforte medievale, persa in una valle verde. È unico nel suo genere e può essere visitato con una guida per scoprire i segreti della vita signorile, immersi nel Medioevo."
    ],
    "fr": [
      "Un donjon pas comme les autres. Une maison forte médiévale, perdue dans une vallée verdoyante. Elle est unique en son genre et se visite avec un guide pour découvrir les secrets de la vie seigneuriale, en immersion au Moyen Âge."
    ],
    "es": [
      "Un torreón como ningún otro. Una fortaleza medieval, perdida en un valle verde. Es único en su género y se puede visitar con un guía para descubrir los secretos de la vida señorial, inmersa en la Edad Media."
    ],
    "nl": [
      "Een wachttoren als geen ander. Een middeleeuwse burcht, verloren in een groene vallei. Het is uniek en kan worden bezocht met een gids om de geheimen van het landsheerlijke leven te ontdekken, ondergedompeld in de Middeleeuwen."
    ]
  },
