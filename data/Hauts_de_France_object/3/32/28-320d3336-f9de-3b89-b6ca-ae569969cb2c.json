  "rdfs:comment": {
    "de": [
      "Voll ausgestattete Aparthotels im Stadtzentrum auf dem Grand-Place, gegenüber dem Abteiturm und in der Nähe der Geschäfte. Restaurants und Bar im Erdgeschoss."
    ],
    "en": [
      "Fully-equipped aparthotels located in the heart of the city on the Grand Place, opposite the Abbey Tower and close to shops. Restaurants and bar on the first floor."
    ],
    "it": [
      "Hotel di appartamenti completamente attrezzati situato nel centro della città, sulla Grand Place, di fronte alla Torre dell'Abbazia e vicino ai negozi. Ristoranti e bar al piano terra."
    ],
    "fr": [
      "Appart Hotels tout équipés  situés  en plein centre-ville sur la Grand-place, face à la Tour Abbatiale et à proximité des commerces. Restaurants et bar au rez-de-chaussée."
    ],
    "nl": [
      "Volledig uitgeruste appartementenhotels gelegen in het stadscentrum op de Grote Markt, tegenover de Abdijtoren en dicht bij de winkels. Restaurants en bar op de begane grond."
    ],
    "es": [
      "Aparthoteles totalmente equipados situados en el centro de la ciudad, en la Grand Place, frente a la Torre de la Abadía y cerca de las tiendas. Restaurantes y bar en la planta baja."
    ]
  },
