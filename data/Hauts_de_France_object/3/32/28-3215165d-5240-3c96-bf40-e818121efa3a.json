  "rdfs:comment": {
    "de": [
      "Ein erzähltes, sensorisches und interaktives Abenteuer für die ganze Familie auf der Suche nach dem Reh. Wir entdecken sein Leben, bringen die Wälder zum Singen, kreieren einen vergänglichen Duft, machen ein Waldmemory und finden seinen Baum? Inklusive Snack."
    ],
    "en": [
      "A storytelling, sensory and interactive family adventure in search of the deer. We'll discover its life, make the woods sing, create an ephemeral perfume, play a forest memory game, find its tree.... Snack included."
    ],
    "it": [
      "Un'avventura familiare narrativa, sensoriale e interattiva alla ricerca del capriolo. Scopriremo la vita del capriolo, faremo cantare il bosco, creeremo un profumo effimero, faremo un gioco di memoria nel bosco, troveremo l'albero del capriolo, ecc. Merenda inclusa."
    ],
    "fr": [
      "Une aventure contée, sensorielle et interactive en famille à la recherche du chevreuil. Nous découvrirons sa vie, nous ferons chanter les bois, créerons un parfum éphémère, ferons un memory de la forêt, retrouverons son arbre…. Goûter Inclus."
    ],
    "es": [
      "Una aventura familiar cuentacuentos, sensorial e interactiva en busca del corzo. Descubriremos la vida del corzo, haremos cantar el bosque, crearemos un perfume efímero, jugaremos a recordar el bosque, encontraremos el árbol del corzo, etc. Merienda incluida."
    ],
    "nl": [
      "Een verhalend, zintuiglijk en interactief familieavontuur op zoek naar de ree. We ontdekken het leven van het hert, laten het bos zingen, creëren een vluchtig parfum, spelen een geheugenspel, vinden de boom van het hert, enz. Snack inbegrepen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sur les pas du chevreuil aux bois d’argent"
    ]
  },
