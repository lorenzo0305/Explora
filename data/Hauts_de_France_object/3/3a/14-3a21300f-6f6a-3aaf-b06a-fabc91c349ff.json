      "dc:description": {
        "de": [
          "Die Auberge d'Hucqueliers organisiert am Freitag, den 8. und Samstag, den 9. August ein Essen im Festzelt\nTreffpunkt am Abend ab 19 Uhr - Keine Reservierungen"
        ],
        "en": [
          "The Auberge d'Hucqueliers is organizing a dinner under a big top on Friday August 8 and Saturday August 9\nMeet in the evening from 7pm - No reservations"
        ],
        "it": [
          "L'Auberge d'Hucqueliers organizza un pranzo sotto il tendone venerdì 8 e sabato 9 agosto\nAppuntamento la sera a partire dalle 19:00 - Non si accettano prenotazioni"
        ],
        "fr": [
          "L'Auberge d'Hucqueliers organise un repas sous chapiteau le vendredi 8 et samedi 9 août\nRendez-vous le soir dès 19h - Aucunes réservations"
        ],
        "es": [
          "El Auberge d'Hucqueliers organiza una comida bajo carpa el viernes 8 y el sábado 9 de agosto\nCita por la tarde a partir de las 19.00 h - Sin reservas"
        ],
        "nl": [
          "De Auberge d'Hucqueliers organiseert een maaltijd onder een tent op vrijdag 8 en zaterdag 9 augustus\nAfspraak 's avonds vanaf 19u - Geen reserveringen"
        ]
      },
