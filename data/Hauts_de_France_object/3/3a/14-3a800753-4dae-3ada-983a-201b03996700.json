  "rdfs:comment": {
    "de": [
      "Ein Eintauchen in das Weiß für ein sehr junges Publikum, um dem Lebendigen in den Falten und Faltungen des Papiers seine Bedeutung zurückzugeben."
    ],
    "en": [
      "A plunge into white for very young audiences, to restore the importance of life in the folds and folds of paper."
    ],
    "it": [
      "Un tuffo nel bianco per un pubblico di giovanissimi, che restituisce l'importanza della vita nelle pieghe e nei fogli di carta."
    ],
    "fr": [
      "Une plongée dans le blanc à destination du très jeune public pour redonner son importance au vivant dans les plis et déplis du papier."
    ],
    "es": [
      "Una zambullida en el blanco para un público muy joven, que restituye la importancia de la vida en los pliegues y dobleces del papel."
    ],
    "nl": [
      "Een duik in het wit voor een heel jong publiek, waarbij het belang van het leven in de vouwen en plooien van papier wordt hersteld."
    ]
