  "rdfs:comment": {
    "de": [
      "Sie wurde aus Blaustein und Ziegelsteinen errichtet und befindet sich in der Mitte der Grand Rue, die nichts anderes als die römische Chaussée von Bavay nach Reims ist,"
    ],
    "en": [
      "Built of bluestone and brick, it stands in the middle of the Grand Rue, the Roman road from Bavay to Reims,"
    ],
    "it": [
      "Costruita in pietra blu e mattoni, si trova al centro della Grand Rue, che non è altro che la strada romana che collega Bavay a Reims,"
    ],
    "fr": [
      "Elevée en pierres bleues et briques, elle se trouve au milieu de la Grand Rue qui n’est autre que la chaussée romaine de Bavay à Reims,"
    ],
    "nl": [
      "Het is gebouwd van arduin en baksteen en staat midden in de Grand Rue, de Romeinse weg van Bavay naar Reims,"
    ],
    "es": [
      "Construido en piedra azul y ladrillo, se alza en medio de la Grand Rue, que no es otra cosa que la calzada romana de Bavay a Reims,"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tour de guet"
    ]
  },
