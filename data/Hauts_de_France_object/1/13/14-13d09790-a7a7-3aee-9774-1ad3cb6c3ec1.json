  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73ed31ed-248e-34be-b984-e072fba5c1c3",
      "dc:description": {
        "de": [
          "Origineller und einzigartiger Freizeitraum mit fluoreszierendem Minigolfplatz und Cafeteria / Bar.\nDer originellste Minigolfplatz an der Opalküste. 280 m2 Wandfresken und 12 handgemalte Statuen ohne Vorlage.\nImmersives und beruhigendes Universum mit dem Thema Dschungel."
        ],
        "en": [
          "Unique, original leisure facility with fluorescent mini golf course and cafeteria/bar.\nThe most original mini golf course on the Opal Coast. 280 m2 of murals and 12 hand-painted statues.\nImmersive, soothing jungle-themed universe."
        ],
        "it": [
          "Centro ricreativo originale e unico, con campo da minigolf fluorescente e caffetteria/bar.\nIl campo da minigolf più originale della Costa d'Opale. 280 m2 di murales e 12 statue dipinte a mano.\nUn universo immersivo e rilassante a tema giungla."
        ],
        "fr": [
          "Salle de loisirs originale et unique avec parcours de mini golf fluorescent et cafétaria / bar.\nMini Golf le plus original de la cote d'Opale. 280 m2 de fresque murale et 12 statues peintes à la main et sans modèle. \nUnivers immersif et apaisant sur le thème de la jungle."
        ],
        "nl": [
          "Origineel en uniek recreatiecentrum met fluorescerende minigolfbaan en cafetaria/bar.\nDe origineelste minigolfbaan aan de Opaalkust. 280 m2 muurschilderingen en 12 handgeschilderde beelden.\nEen meeslepend en rustgevend universum met junglethema."
        ],
        "es": [
          "Original y único centro de ocio con campo de minigolf fluorescente y cafetería/bar.\nEl minigolf más original de la Costa de Ópalo. 280 m2 de murales y 12 estatuas pintadas a mano.\nUn universo inmersivo y relajante de temática selvática."
        ]
      },
      "@type": [
        "Description"
      ],
