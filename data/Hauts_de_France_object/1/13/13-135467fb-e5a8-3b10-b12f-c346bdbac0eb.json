  "rdfs:comment": {
    "de": [
      "Biologischer Produzent von Lammfleisch und Rindfleisch.\r\nDirektverkauf jedes Wochenende auf den Märkten im Avesnois und Umgebung.\r\nFleisch wird im Einzelhandel oder in Paketen angeboten."
    ],
    "en": [
      "Organic producer of lamb and beef.\r\nDirect sales every weekend at markets in and around the Avesnois region.\r\nMeat sold retail or in packages."
    ],
    "it": [
      "Produttore biologico di carne di agnello e di manzo.\r\nVendita diretta ogni fine settimana nei mercati dell'Avesnois e dintorni.\r\nCarne venduta al dettaglio o in pacchi."
    ],
    "fr": [
      "Producteur bio de viande d'agneau et de viande bovine.\r\nVente directe chaque weekend sur les marchés de l'Avesnois et alentours.\r\nViande proposée au détail ou en colis."
    ],
    "es": [
      "Productor ecológico de carne de cordero y vacuno.\r\nVenta directa todos los fines de semana en los mercados del Avesnois y sus alrededores.\r\nVenta de carne al por menor o en paquetes."
    ],
    "nl": [
      "Biologische producent van lams- en rundvlees.\r\nDirecte verkoop elk weekend op markten in en rond de Avesnois.\r\nVlees wordt verkocht in de detailhandel of in pakketten."
    ]
  },
  "rdfs:label": {
