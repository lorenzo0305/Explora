  "rdfs:comment": {
    "de": [
      "Das Denkmal für die Marne-Taxis befindet sich in Nanteuil-le-Haudouin an der Stelle, an der am 7. September 1914 die von General Gallieni requirierten Pariser Taxis die Verstärkungen brachten, mit denen die französische Armee den Sieg an der Marne erringen konnte."
    ],
    "en": [
      "The Taxis de la Marne monument stands in Nanteuil-le-Haudouin, on the very spot where, on September 7, 1914, Parisian cabs requisitioned by General Gallieni brought the reinforcements that enabled the French army to win the Marne victory."
    ],
    "it": [
      "Il monumento ai taxi della Marna si trova a Nanteuil-le-Haudouin, proprio nel luogo in cui, il 7 settembre 1914, i taxi parigini requisiti dal generale Gallieni portarono i rinforzi che permisero all'esercito francese di vincere la Marna."
    ],
    "fr": [
      "Le monument aux Taxis de la Marne se trouve à Nanteuil-le-Haudouin, à l'endroit même où, le 7 septembre 1914, les taxis parisiens réquisitionnés par le général Gallieni ont amené les renforts qui ont permis à l'armée française de remporter la victoire de la Marne."
    ],
    "nl": [
      "Het monument voor de taxi's van de Marne staat in Nanteuil-le-Haudouin, op de plek waar op 7 september 1914 de Parijse taxi's, gevorderd door generaal Gallieni, de versterkingen brachten die het Franse leger in staat stelden de overwinning op de Marne te behalen."
    ],
    "es": [
      "El monumento a los Taxis del Marne se encuentra en Nanteuil-le-Haudouin, en el mismo lugar donde, el 7 de septiembre de 1914, los taxis parisinos requisados por el general Gallieni trajeron los refuerzos que permitieron al ejército francés obtener la victoria del Marne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Monument aux Taxis de la Marne"
    ]
  },
