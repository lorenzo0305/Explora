      "dc:description": {
        "de": [
          "Das Office de Tourisme Haut Pays Côte d'Opale präsentiert :\nLa Marnière, eine 32 km lange Mountainbike-Tour.\nDauer: 3,5 Stunden | Start: Hucqueliers"
        ],
        "en": [
          "The Haut Pays Côte d'Opale Tourist Office presents :\nLa Marnière, a 32km mountain bike trail.\nDuration : 3h30 | Departure : From Hucqueliers"
        ],
        "it": [
          "L'Ufficio del Turismo dell'Haut Pays Côte d'Opale presenta :\nLa Marnière, un percorso di 32 km in mountain bike.\nDurata: da 3h30 | Partenza: da Hucqueliers"
        ],
        "fr": [
          "L'Office de Tourisme Haut Pays Côte d'Opale présente :\nLa Marnière,  une randonnée à faire en VTT de 32km.\nDurée : De 3h30 | Départ : De Hucqueliers"
        ],
        "es": [
          "La Oficina de Turismo de Haut Pays Côte d'Opale presenta :\nLa Marnière, un recorrido de 32 km en bicicleta de montaña.\nDuración: A partir de 3h30 | Salida: Desde Hucqueliers"
        ],
        "nl": [
          "Het VVV-kantoor van Haut Pays Côte d'Opale presenteert :\nLa Marnière, een mountainbiketocht van 32 km.\nDuur: vanaf 3u30 | Vertrek: vanuit Hucqueliers"
        ]
      },
