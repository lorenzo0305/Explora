  "rdfs:comment": {
    "de": [
      "Familienbetrieb, der seit 1912 geführt wird. Traditionelle und elsässische Küche, die in einem gemütlichen und 2017 vollständig renovierten Rahmen serviert wird. Ein privater Saal von 40m² bietet Platz für Familienfeiern und Geschäftstreffen."
    ],
    "en": [
      "Family establishment held since 1912, traditional and Alsatian cuisine served in a warm setting and completely renovated in 2017. A private room of 40m ² can accommodate family events and business meetings."
    ],
    "it": [
      "Struttura a conduzione familiare dal 1912, cucina tradizionale e alsaziana servita in un ambiente accogliente e interamente rinnovata nel 2017. Una sala privata di 40 m² è disponibile per eventi familiari e riunioni di lavoro."
    ],
    "fr": [
      "Établissement familial tenu depuis 1912, cuisine traditionnelle et alsacienne servie dans un cadre chaleureux et entièrement rénové en 2017. Une salle privative de 40m² permet d'accueillir les évènements familiaux et les réunions d'affaires."
    ],
    "nl": [
      "Familiebedrijf sinds 1912, traditionele en Elzasser keuken geserveerd in een warm kader en volledig gerenoveerd in 2017. Een privéruimte van 40m² is beschikbaar voor familiebijeenkomsten en zakelijke bijeenkomsten."
    ],
    "es": [
      "Establecimiento familiar desde 1912, cocina tradicional y alsaciana servida en un entorno cálido y totalmente renovado en 2017. Una sala privada de 40m² está disponible para eventos familiares y reuniones de negocios."
    ]
  },
