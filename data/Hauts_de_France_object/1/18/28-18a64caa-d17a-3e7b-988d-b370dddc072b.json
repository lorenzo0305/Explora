  "rdfs:comment": {
    "de": [
      "Seit 1968 familiengeführtes Restaurant, das am Wasser vor den Toren der Festungsmauern von Bergues und mitten in der Natur liegt. Ein Ort, den Sie unbedingt besuchen sollten, wenn Sie in der Gegend sind!"
    ],
    "en": [
      "A family-run restaurant since 1968, nestled on the waterfront at the gateway to the fortifications of Bergues and surrounded by nature. A must if you're in the area!"
    ],
    "it": [
      "Ristorante a conduzione familiare dal 1968, situato sul lungomare alle porte delle fortificazioni di Bergues e circondato dalla natura. Una tappa obbligata se vi trovate in zona!"
    ],
    "fr": [
      "Restaurant familial depuis 1968 niché au bord de l'eau aux portes des remparts des fortifications de Bergues et au milieu de la nature. Un endroit incontournable si vous êtes dans le coin !"
    ],
    "es": [
      "Restaurante familiar desde 1968, situado frente al mar, a las puertas de las fortificaciones de Bergues y rodeado de naturaleza. Una visita obligada si se encuentra en la zona"
    ],
    "nl": [
      "Een familierestaurant sinds 1968, genesteld aan de waterkant aan de poort van de vestingwerken van Bergues en omgeven door natuur. Een must als je in de buurt bent!"
    ]
  },
