      "openingDetails": {
        "de": [
          "Montag bis Freitag von 13:30 bis 19:30 Uhr und an Wochenenden von 11:00 bis 20:00 Uhr (außer Freitag, den 14. Juli von 11:00 bis 20:00 Uhr und Samstag, den 22. Juli von 11:00 bis Mitternacht für die Abschlussparty)"
        ],
        "en": [
          "Monday to Friday, 1:30 to 7:30 p.m. and weekends, 11 a.m. to 8 p.m. (except Friday, July 14, 11 a.m. to 8 p.m. and Saturday, July 22, 11 a.m. to midnight for the closing party)"
        ],
        "it": [
          "Dal lunedì al venerdì dalle 13.30 alle 19.30 e nei fine settimana dalle 11.00 alle 20.00 (tranne venerdì 14 luglio dalle 11.00 alle 20.00 e sabato 22 luglio dalle 11.00 alle 24.00 per la festa di chiusura)"
        ],
        "fr": [
          "Du lundi au vendredi de 13h30 à 19h30 et les week-ends de 11h à 20h (sauf vendredi 14 juillet de 11h à 20h et samedi 22 juillet de 11h à minuit pour la fête de clôture)"
        ],
        "nl": [
          "Maandag t/m vrijdag van 13.30 tot 19.30 uur en in het weekend van 11.00 tot 20.00 uur (behalve vrijdag 14 juli van 11.00 tot 20.00 uur en zaterdag 22 juli van 11.00 tot middernacht voor het slotfeest)"
        ],
        "es": [
          "De lunes a viernes de 13.30 a 19.30 h y los fines de semana de 11.00 a 20.00 h (excepto el viernes 14 de julio de 11.00 a 20.00 h y el sábado 22 de julio de 11.00 a 24.00 h para la fiesta de clausura)"
