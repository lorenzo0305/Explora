      "@id": "https://data.datatourisme.fr/3c4151d7-a4c8-3aa3-a583-3d424abdecc2",
      "dc:description": {
        "de": [
          "\"Die magische Schürze\": Eine Schürze mit Geschichten, Reimen und Fingerspielen voller Überraschungen, die Sie mit Ihren Kleinsten entdecken können"
        ],
        "en": [
          "\"Le tablier magique\": an apron of stories, rhymes and fingerplays full of surprises to discover with your little ones"
        ],
        "it": [
          "\"Le tablier magique\": un grembiule ricco di storie, filastrocche e giochi con le dita pieno di sorprese da scoprire con i più piccoli"
        ],
        "fr": [
          "« Le tablier magique » : un tablier d'histoires, de comptines et de jeux de doigts plein de surprises à découvrir avec vos tout-petits"
        ],
        "es": [
          "\"Le tablier magique\": un delantal lleno de cuentos, canciones infantiles y juegos de dedos repletos de sorpresas para descubrir con los más pequeños"
        ],
        "nl": [
          "\"Le tablier magique\": een schort vol verhaaltjes, kinderliedjes en vingerspelletjes vol verrassingen om samen met je kleintjes te ontdekken"
        ]
      },
