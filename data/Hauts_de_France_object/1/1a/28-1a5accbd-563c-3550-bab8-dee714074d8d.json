  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8161e497-6db3-3fed-ad45-332e227f9b25",
      "dc:description": {
        "de": [
          "Verkäufe: große Auswahl an LEGO-Sets\nNINJALUDO-Club, für 10 € haben Sie eine Stunde Spielvergnügen mit allen unseren LEGO-Sets\nAbonnement für ein ganzes Jahr\nGeburtstag bei LUDOMANIA: Spaß, den man mit Freunden und Freundinnen teilen kann, 10 € pro Teilnehmer für mindestens 10 Kinder\nAbendliche Animationen"
        ],
        "en": [
          "Sales: wide range of LEGO sets\nClub NINJALUDO, for 10 € you have one hour of fun to play with all our LEGO sets\nYearly subscription\nBirthday at LUDOMANIA: Fun to share with friends, 10 € per participant for 10 children minimum\nEvening entertainment"
        ],
        "it": [
          "Vendite: ampia gamma di set LEGO\nNINJALUDO Club, per 10 € un'ora di divertimento con tutti i nostri set LEGO\nAbbonamento annuale\nFesta di compleanno alla LUDOMANIA: divertimento da condividere con gli amici, 10 ? per partecipante per 10 bambini minimo\nIntrattenimento serale"
        ],
        "fr": [
          "Ventes : large gamme de sets LEGO\nClub NINJALUDO, pour 10 € vous avez une heure de plaisir pour jouer avec tous nos sets LEGO\nAbonnement à l'année\nAnniversaire chez LUDOMANIA  : Amusement à partager avec les copains et copines, 10 € par participant pour 10 enfants minimum\nAnimations soirées"
        ],
        "nl": [
          "Verkoop : breed assortiment LEGO sets\nClub NINJALUDO, voor 10 € heb je een uur speelplezier met al onze LEGO sets\nJaarabonnement\nVerjaardagsfeestje bij LUDOMANIA: plezier om te delen met vrienden, 10 € per deelnemer voor minimaal 10 kinderen\nAvond entertainment"
        ],
        "es": [
          "Ventas: amplia gama de sets de LEGO\nClub NINJALUDO, por 10€ tienes una hora de diversión para jugar con todos nuestros sets de LEGO\nSuscripción anual\nFiesta de cumpleaños en LUDOMANIA: Diversión para compartir con amigos, 10€ por participante para 10 niños mínimo\nEntretenimiento nocturno"
        ]
      },
