  "rdfs:comment": {
    "de": [
      "Inmitten von über 300 Hektar Sumpfgebiet, von denen etwa 100 Hektar dem Département gehören, können Sie auf einem intimen Rundgang, der vom Treidelpfad der Schelde aus zugänglich ist, die Sumpfgebiete der Sensée entdecken."
    ],
    "en": [
      "In the heart of more than 300 hectares of marshland, of which around a hundred are owned by the Département, an intimate trail, accessible from the Scheldt towpath, takes you through the Sensée marshes."
    ],
    "it": [
      "Nel cuore di oltre 300 ettari di palude, di cui un centinaio di proprietà del Dipartimento, è possibile esplorare le paludi di Sensée su un sentiero intimo accessibile dall'alzaia della Schelda."
    ],
    "fr": [
      "Au cœur de plus de 300 ha de Marais, dont une centaine en propriété du Département, un parcours intimiste accessible depuis le chemin de halage de l'Escaut vous est proposé pour découvrir les marais de la Sensée."
    ],
    "nl": [
      "In het hart van meer dan 300 hectare moerasgebied, waarvan een honderdtal eigendom is van het departement, kunt u de moerassen van Sensée verkennen via een intiem wandelpad dat toegankelijk is vanaf het Scheldejaagpad."
    ],
    "es": [
      "En el corazón de más de 300 hectáreas de marismas, de las que un centenar son propiedad del Departamento, podrá explorar las marismas de Sensée por un sendero íntimo accesible desde el camino de sirga del Escalda."
    ]
  },
  "rdfs:label": {
