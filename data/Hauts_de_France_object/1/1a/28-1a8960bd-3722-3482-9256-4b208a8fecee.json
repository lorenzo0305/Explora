  "rdfs:comment": {
    "de": [
      "Das Chicorée ist eine historische Brasserie im Herzen von Lille, die 7 Tage die Woche, Tag und Nacht geöffnet ist. Sie bietet authentische und regionale Küche."
    ],
    "en": [
      "A historic brasserie in the heart of Lille, open 7 days a week, day and night, La Chicorée offers authentic regional cuisine."
    ],
    "it": [
      "Una brasserie storica nel cuore di Lille, aperta 7 giorni su 7, giorno e notte, La Chicorée serve un'autentica cucina regionale."
    ],
    "fr": [
      "Brasserie Historique située au cœur de Lille, ouverte 7j/7, de jour comme de nuit, la Chicorée propose une cuisine authentique et régionale."
    ],
    "es": [
      "Una brasserie histórica en el corazón de Lille, abierta 7 días a la semana, día y noche, La Chicorée sirve auténtica cocina regional."
    ],
    "nl": [
      "La Chicorée, een historische brasserie in het hart van Lille, is 7 dagen per week, dag en nacht geopend en serveert authentieke regionale gerechten."
    ]
  },
