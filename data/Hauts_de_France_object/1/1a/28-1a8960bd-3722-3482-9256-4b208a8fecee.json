  "COVID19SpecialMeasures": {
    "de": [
      "La Chicorée ist eine historische Brasserie im Herzen von Lille, die Tag und Nacht geöffnet ist. Sie bietet authentische und regionale Küche. Sie empfängt Ihre Gruppen, Geschäftsessen und Seminare in einem ihrer 5 Säle mit freundlicher Atmosphäre (10 bis 50 Personen).\n240 Gedecke"
    ],
    "en": [
      "A historic brasserie in the heart of Lille, open 7 days a week, day and night, La Chicorée offers authentic regional cuisine. We welcome groups, business lunches and seminars in one of our 5 convivial rooms (10 to 50 people).\n240 place settings"
    ],
    "it": [
      "Storica brasserie nel cuore di Lille, aperta 7 giorni su 7, giorno e notte, La Chicorée propone un'autentica cucina regionale. Accoglie gruppi, pranzi di lavoro e seminari in una delle sue 5 sale (da 10 a 50 persone).\n240 coperti"
    ],
    "fr": [
      "Brasserie historique située au cœur de Lille, ouverte 7J/7 de jour comme de nuit, La Chicorée propose une cuisine authentique et régionale. Elle accueille vos groupes, repas d’affaires et séminaires dans l’une de ses 5 salles à l’ambiance conviviale (de 10 à 50 personnes).\n240 couverts"
    ],
    "nl": [
      "La Chicorée, een historische brasserie in het hart van Lille, is 7 dagen per week, dag en nacht geopend en serveert authentieke regionale gerechten. Groepen, zakenlunches en seminars zijn welkom in een van de 5 zalen (10 tot 50 personen).\n240 couverts"
    ],
    "es": [
      "Histórica brasserie en el corazón de Lille, abierta 7 días a la semana, de día y de noche, La Chicorée sirve auténtica cocina regional. Acoge a grupos, comidas de negocios y seminarios en una de sus 5 salas (de 10 a 50 personas).\n240 cubiertos"
    ]
  },
