  "rdfs:comment": {
    "de": [
      "Das L'Essentiel ist ein Ort, der mit seiner Terrasse und dem Bouleplatz ruhig und entspannt ist. Es bietet eine abwechslungsreiche Speisekarte. Die Gerichte werden hausgemacht und aus frischen, saisonalen Produkten zubereitet."
    ],
    "en": [
      "L'Essentiel is a calm and relaxed place with its terrace and its petanque court. It offers a varied menu. The dishes are home-made from fresh and seasonal products."
    ],
    "it": [
      "L'Essentiel è un locale tranquillo e rilassato con una terrazza e un campo da bocce. Offre un menù vario. I piatti sono fatti in casa con prodotti freschi e di stagione."
    ],
    "fr": [
      "L'Essentiel est un lieu qui calme et décontracté avec sa terrasse et son terrain de pétanque. Il propose une carte variée. Les plats sont faits maison à partir de produits frais et de saison."
    ],
    "nl": [
      "L'Essentiel is een rustige en ontspannen plek met een terras en een petanquebaan. Het biedt een gevarieerd menu. De gerechten zijn huisgemaakt van verse en seizoensgebonden producten."
    ],
    "es": [
      "L'Essentiel es un lugar tranquilo y relajado con terraza y pista de petanca. Ofrece un menú variado. Los platos son caseros a base de productos frescos y de temporada."
    ]
  },
