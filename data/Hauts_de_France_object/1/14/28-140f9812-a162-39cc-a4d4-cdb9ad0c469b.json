        "de": [
          "Zumba\n\nPreise:\nStep: 45 € pro Jahr\n\nTrainingseinheiten:\nKurse in der Verwaltungshalle\nStep (ab 16 Jahren): donnerstags von 19:15 bis 20:15 Uhr."
        ],
        "en": [
          "Zumba\n\nFees :\nStep : 45 € per year\n\nTraining sessions :\nClasses in the administrative room\nStep (from 16 years old) : Thursday, from 7.15 pm to 8.15 pm."
        ],
        "it": [
          "Zumba\n\nPrezzi :\nPasso : 45 ? all'anno\n\nSessioni di formazione :\nLezioni nella sala amministrativa\nStep (dai 16 anni): giovedì, dalle 19.15 alle 20.15."
        ],
        "fr": [
          "Zumba\n\nTarifs :\nStep : 45 € l’année  \n\nEntraînements :\nCours à la salle administrative\nStep (à partir de 16 ans) : le jeudi, de 19h15 à 20h15."
        ],
        "nl": [
          "Zumba\n\nVergoedingen :\nStap: 45 € per jaar\n\nTrainingen :\nLessen in de administratiekamer\nStep (vanaf 16 jaar): donderdag, van 19.15 tot 20.15 uur."
        ],
        "es": [
          "Zumba\n\nPrecios :\nPaso : 45€ al año\n\nSesiones de formación :\nClases en la sala de administración\nStep (a partir de 16 años) : jueves, de 19:15 a 20:15 horas."
