  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b669af3f-6dbd-3078-b2e6-13cdab51bd86",
      "dc:description": {
        "de": [
          "Die große Reise von Anoki beginnt! Wie jedes Jahr werden die Kinder des Indianerstamms der Wakicuza die Prüfungen der Emotionen bestehen müssen. Kommen Sie mit und erleben Sie dieses neue Abenteuer.."
        ],
        "en": [
          "The great journey of Anoki is about to begin! Like every year, the children of the Wakicuza Indian tribe will have to pass the tests of emotions. Come and discover this new adventure.."
        ],
        "it": [
          "Il grande viaggio di Anoki sta per iniziare! Come ogni anno, i bambini della tribù indiana Wakicuza dovranno superare le prove emotive. Venite a scoprire questa nuova avventura?"
        ],
        "fr": [
          "Le grand voyage d’Anoki va débuter ! Comme chaque année, les enfants de la tribu indienne des Wakicuza vont devoir passer les épreuves des émotions. Venez découvrir cette nouvelle aventure…"
        ],
        "es": [
          "¡El gran viaje de Anoki está a punto de comenzar! Como cada año, los niños de la tribu india Wakicuza tendrán que pasar las pruebas emocionales. Venga a descubrir esta nueva aventura?"
        ],
        "nl": [
          "De grote reis van Anoki gaat beginnen! Zoals elk jaar zullen de kinderen van de Wakicuza indianenstam de emotionele tests moeten doorstaan. Kom je dit nieuwe avontuur ontdekken?"
        ]
      },
