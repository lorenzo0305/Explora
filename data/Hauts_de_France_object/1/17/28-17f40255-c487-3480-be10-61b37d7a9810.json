  "rdfs:comment": {
    "de": [
      "Später Nachmittag und Abend rund um das Maison du Bois Hariez auf der Route du Faîte :\nTageswanderung Abfahrt um 16 Uhr\nPicknick ab 19.30 Uhr\nNachtrundgang ab 22 Uhr."
    ],
    "en": [
      "Late afternoon and evening around the Maison du Bois Hariez on the Route du Faîte:\nDaytime walk departing at 4pm\nPicnic from 7.30pm\nNight walk from 10pm."
    ],
    "it": [
      "Tardo pomeriggio e sera intorno alla Maison du Bois Hariez sulla Route du Faîte:\nPasseggiata diurna con partenza alle 16.00\nPicnic dalle 19.30\nPasseggiata notturna dalle 22.00."
    ],
    "fr": [
      "Fin d'après-midi et soirée autour de la Maison du Bois Hariez sur la route du Faîte : \nBalade de jour départ à 16h\nPique-nique à partir de 19h30\nRonde de nuit dès 22h."
    ],
    "es": [
      "Tarde y noche alrededor de la Maison du Bois Hariez en la Route du Faîte:\nPaseo diurno con salida a las 16 h\nPicnic a partir de las 19.30 h\nPaseo nocturno a partir de las 22 h."
    ],
    "nl": [
      "Late namiddag en avond rond het Maison du Bois Hariez op de Route du Faîte:\nWandeling overdag met vertrek om 16 uur\nPicknick vanaf 19.30 uur\nNachtwandeling vanaf 22u."
    ]
  },
