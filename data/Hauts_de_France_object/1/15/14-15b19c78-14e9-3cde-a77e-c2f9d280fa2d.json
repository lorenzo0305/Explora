  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d499300c-8c5e-3eac-806a-021a4ed9c3e1",
      "dc:description": {
        "de": [
          "Verkauf von verschiedenen Gegenständen, die dem Verein der Freunde der Kirche der Unbefleckten Empfängnis in Wimereux gespendet wurden, zugunsten der Restaurierung der Kirche. Der Verkauf wird von den Freiwilligen des Vereins durchgeführt."
        ],
        "en": [
          "Sale to benefit the restoration of the church of various objects donated to the association of Friends of the Church of the Immaculate Conception in Wimereux. The sale will be run by volunteers from the association."
        ],
        "it": [
          "Vendita di vari oggetti donati agli Amici della Chiesa dell'Immacolata Concezione di Wimereux, a favore del restauro della chiesa. La vendita sarà gestita dai volontari dell'associazione."
        ],
        "fr": [
          "Vente au profit de la restauration de l’église d’objets divers et variés donnés à l’association des Amis de l’Eglise de l’Immaculée Conception de Wimereux. Cette vente sera assurée par les bénévoles de l’association."
        ],
        "nl": [
          "Verkoop van verschillende voorwerpen geschonken aan de Vrienden van de kerk van de Onbevlekte Ontvangenis in Wimereux, ten voordele van de restauratie van de kerk. De verkoop wordt geleid door vrijwilligers van de vereniging."
        ],
        "es": [
          "Venta de diversos artículos donados a los Amigos de la Iglesia de la Inmaculada Concepción de Wimereux, en ayuda de la restauración de la iglesia. La venta estará a cargo de voluntarios de la asociación."
        ]
      },
