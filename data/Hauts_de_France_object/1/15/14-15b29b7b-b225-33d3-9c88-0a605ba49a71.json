        "de": [
          "Herr und Frau Cazin bieten Ihnen ganzes oder zerlegtes Freilandgeflügel von ihrem Bauernhof in Colembert an."
        ],
        "en": [
          "Mr and Mrs Cazin offer you whole or cut farm poultry from their farm in Colembert."
        ],
        "it": [
          "I signori Cazin vi offrono pollame d'allevamento intero o tagliato, proveniente dalla loro azienda agricola di Colembert."
        ],
        "fr": [
          "Mr et Mme Cazin vous propose des Volailles fermières entières ou découpées issu de leur ferme à Colembert."
        ],
        "es": [
          "El Sr. y la Sra. Cazin le ofrecen aves de corral enteras o despiezadas de su granja de Colembert."
        ],
        "nl": [
          "De heer en mevrouw Cazin bieden u heel of versneden hoevepluimvee van hun boerderij in Colembert."
        ]
