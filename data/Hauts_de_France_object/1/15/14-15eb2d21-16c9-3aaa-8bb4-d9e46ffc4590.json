      "dc:description": {
        "de": [
          "Animation Tischtennis organisiert von der Vereinigung les ch'tites raquettes\nDie Animation wird mit einem Turnier in der Sporthalle von Camiers von 18:30 bis 22:30 Uhr fortgesetzt"
        ],
        "en": [
          "Table tennis activities organized by the association les ch'tites raquettes\nThe event continues with a tournament at the Camiers sports hall from 6:30pm to 10:30pm"
        ],
        "it": [
          "Attività di tennis da tavolo organizzate dall'associazione les ch'tites raquettes\nL'evento prosegue con un torneo presso il palazzetto dello sport di Camiers dalle 18.30 alle 22.30"
        ],
        "fr": [
          "Animation Tennis de table organisé par l'association les ch'tites raquettes\nL'animation se poursuit par un tournoi à la salle des sports de Camiers de 18h30 à 22h30"
        ],
        "nl": [
          "Tafeltennisactiviteiten georganiseerd door de vereniging les ch'tites raquettes\nHet evenement gaat verder met een toernooi in de sporthal van Camiers van 18.30 tot 22.30 uur"
        ],
        "es": [
          "Actividades de tenis de mesa organizadas por la asociación les ch'tites raquettes\nEl evento continúa con un torneo en el pabellón polideportivo de Camiers de 18.30 a 22.30 h"
        ]
