      "dc:description": {
        "de": [
          "Die Brasserie la Marinière bietet Ihnen eine große Auswahl an Muscheln mit Pommes frites.\nAuf der Speisekarte: Vorspeisen, Fleisch, Fisch, Desserts"
        ],
        "en": [
          "La Brasserie la Marinière offers you a wide choice of fried mussels.\nOn the Menu : Starters, Meat, Fish, Desserts"
        ],
        "it": [
          "La Brasserie la Marinière offre un'ampia scelta di cozze fritte.\nNel menu: Antipasti, Carne, Pesce, Dessert"
        ],
        "fr": [
          "La Brasserie la Marinière vous propose un large choix de moules frites.\nAu Menu : Entrées, Viandes, Poissons, Desserts"
        ],
        "es": [
          "La Brasserie la Marinière le ofrece una amplia selección de mejillones fritos.\nEn el menú: Entrantes, Carnes, Pescados, Postres"
        ],
        "nl": [
          "De Brasserie la Marinière biedt u een ruime keuze aan gebakken mosselen.\nOp het menu: Voorgerechten, Vlees, Vis, Desserts"
        ]
