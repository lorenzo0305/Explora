  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8b635923-ebc4-3211-a192-e51e2f519ed5",
      "dc:description": {
        "de": [
          "Lieder, Reime, Gestenlieder, Fingerspiele, der Umgang mit kleinen Percussioninstrumenten oder die Erforschung von Klängen ermöglichen ihnen, sich spielerisch zu entfalten."
        ],
        "en": [
          "Songs, nursery rhymes, songs with gestures, fingerplays, small percussion instruments and sound exploration are just some of the fun ways in which they can develop."
        ],
        "it": [
          "Canzoni, filastrocche, canzoni con gesti, giochi di dita, manipolazione di piccoli strumenti a percussione ed esplorazione del suono sono tutti modi divertenti per svilupparsi."
        ],
        "fr": [
          "Chants, comptines, chansons à gestes, jeux de doigts, manipulation de petites percussions ou exploration sonore, leur permettent de s'épanouir de manière ludique."
        ],
        "nl": [
          "Liedjes, kinderliedjes, liedjes met gebaren, vingerspelletjes, manipulatie van kleine percussie-instrumenten en het verkennen van geluiden zijn allemaal leuke manieren voor hen om zich te ontwikkelen."
        ],
        "es": [
          "Canciones, canciones infantiles, canciones con gestos, juegos con los dedos, manipulación de pequeños instrumentos de percusión y exploración de sonidos son formas divertidas de que se desarrollen."
        ]
      },
