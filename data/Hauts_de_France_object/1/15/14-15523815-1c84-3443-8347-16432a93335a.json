      "dc:description": {
        "de": [
          "Die étincelles wingloises bieten eine Aufführung zum Thema Mine an, die Humor und Lieder von Patrick Collon um ein Feuerzeug zum Teilen vermischt."
        ],
        "en": [
          "Les étincelles wingloises put on a show on the theme of mining, combining humor and songs by Patrick Collon with a lighter to share."
        ],
        "it": [
          "Les étincelles wingloises presentano uno spettacolo sul tema delle miniere, combinando l'umorismo e le canzoni di Patrick Collon con un accendino da condividere."
        ],
        "fr": [
          "Les étincelles wingloises proposent un spectacle sur le thème de la mine mêlant humour et chansons de Patrick Collon autour d'un briquet à partager."
        ],
        "nl": [
          "Les étincelles wingloises presenteren een show over het thema mijnbouw, waarbij humor en liedjes van Patrick Collon worden gecombineerd met een aansteker om te delen."
        ],
        "es": [
          "Les étincelles wingloises presentan un espectáculo sobre el tema de la minería, combinando humor y canciones de Patrick Collon con un encendedor para compartir."
        ]
      },
