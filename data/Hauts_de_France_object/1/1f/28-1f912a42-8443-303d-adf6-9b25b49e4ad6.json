  "rdfs:comment": {
    "de": [
      "Treffpunkt am Fuße des Belfrieds ? Platz an der Schnur.\nBezahlung bei der Bereitschaftssekretärin.7\n\nAchtung: Aus Sicherheitsgründen,\nist die Terrasse des Belfrieds bei schlechtem Wetter unzugänglich\nregenwetter"
    ],
    "en": [
      "Rendezvous at the foot of the belfry ? Place au fil.\nPayment to be made to the duty worker.7\n\nPlease note: for safety reasons,\nthe terrace of the belfry is inaccessible\nrainy weather"
    ],
    "it": [
      "Appuntamento ai piedi del campanile? Place au fil.\nPagamento da effettuare all'agente temporaneo di turno.7\n\nNota bene: per motivi di sicurezza\nla terrazza della torre campanaria è inaccessibile\ntempo piovoso"
    ],
    "fr": [
      "Rdv au pied du beffroi – Place au fil. \nPaiement auprès du vacataire de permanence.7\n\nAttention : pour des raisons de sécurité,\nla terrasse du beffroi est inaccessible par\ntemps de pluie"
    ],
    "es": [
      "Cita al pie del campanario ? Place au fil.\nPago al agente temporal de guardia.7\n\nAtención: por razones de seguridad\nla terraza del campanario es inaccesible\ntiempo lluvioso"
    ],
    "nl": [
      "Afspraak aan de voet van het belfort? Place au fil.\nBetaling aan de tijdelijke functionaris van dienst.7\n\nLet op: om veiligheidsredenen\nis het terras van het belfort ontoegankelijk\nregenachtig weer"
    ]
  },
  "rdfs:label": {
    "fr": [
