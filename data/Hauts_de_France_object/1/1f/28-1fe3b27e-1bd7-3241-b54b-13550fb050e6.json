  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/847cdf43-f6d0-38b8-b797-4a101b5e6f40",
      "dc:description": {
        "de": [
          "Jahrhunderts von dem Architekten Vanderbergh Emile erbaut und später originalgetreu wieder aufgebaut."
        ],
        "en": [
          "Built by architect Vanderbergh Emile at the end of the 19th century, then rebuilt identically, this store sold Mahieu fabric."
        ],
        "it": [
          "Costruito dall'architetto Vanderbergh Emile alla fine del XIX secolo, e poi ricostruito in modo identico, questo negozio è stato concepito per vendere i tessuti prodotti da Mahieu."
        ],
        "fr": [
          "Construit par l'architecte Vanderbergh Emile à la fin du XiXème siècle, puis reconstruit à l'identique, ce magasin avait pour vocation de vendre les toiles de tissu fabriqués par Mahieu."
        ],
        "nl": [
          "Deze winkel werd gebouwd door de architect Vanderbergh Emile aan het einde van de 19e eeuw en vervolgens op identieke wijze herbouwd. De winkel was bedoeld om de stoffen te verkopen die door Mahieu werden gemaakt."
        ],
        "es": [
          "Construida por el arquitecto Vanderbergh Emile a finales del siglo XIX, y luego reconstruida de forma idéntica, esta tienda estaba destinada a la venta de las telas fabricadas por Mahieu."
        ]
      },
