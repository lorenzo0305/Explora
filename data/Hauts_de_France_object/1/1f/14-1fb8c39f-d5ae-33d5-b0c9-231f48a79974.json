  "rdfs:comment": {
    "de": [
      "Die Kinder begeben sich auf eine Entdeckungsreise durch das Leben der Soldaten in den Schützengräben während der Weihnachtszeit und des Neujahrsfestes."
    ],
    "en": [
      "Children discover what life was like for soldiers in the trenches over Christmas and the New Year."
    ],
    "it": [
      "I bambini scoprono com'era la vita dei soldati in trincea durante il Natale e il Capodanno."
    ],
    "fr": [
      "Les enfants partent à la découverte de la vie des soldats dans les tranchées durant la période de Noël et de la nouvelle année."
    ],
    "es": [
      "Los niños descubren cómo era la vida de los soldados en las trincheras durante las Navidades y el Año Nuevo."
    ],
    "nl": [
      "Kinderen ontdekken hoe het leven was voor soldaten in de loopgraven tijdens Kerstmis en Nieuwjaar."
    ]
