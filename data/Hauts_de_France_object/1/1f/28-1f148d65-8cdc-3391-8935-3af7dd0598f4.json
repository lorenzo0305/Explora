  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der Strandpromenade entfernt und gegenüber dem Kongresszentrum Kursaal gelegen, bietet das DKlé eine zeitgenössische Küche in einem gemütlichen Ambiente.\nAlle kulinarischen Zubereitungen werden vor Ort aus frischen Produkten hergestellt. An schönen Tagen steht eine sonnige Innenterrasse zur Verfügung."
    ],
    "en": [
      "Just a step from the seaside and located in front of the Palais des Congrès le Kursaal, the DKlé offers a contemporary cuisine in a cosy atmosphere.\nAll culinary preparations are made on the spot with fresh products. A sunny indoor terrace is available for sunny days."
    ],
    "it": [
      "A pochi passi dal lungomare e situato di fronte al Palais des Congrès le Kursaal, il DKlé offre una cucina contemporanea in un'atmosfera accogliente.\nTutti i piatti sono preparati in loco con prodotti freschi. Per le giornate di sole è disponibile una terrazza interna."
    ],
    "fr": [
      "A deux pas du bord de mer et situé face au Palais des Congrès le Kursaal, le DKlé propose une cuisine contemporaine dans une ambiance cosy.\nToutes les préparations culinaires sont faites sur place avec des produits frais. Une terrasse intérieure bien ensoleillée est à disposition pour les beaux jours."
    ],
    "nl": [
      "Op een steenworp afstand van de kust en gelegen tegenover het Palais des Congrès le Kursaal, biedt het DKlé een eigentijdse keuken in een gezellige sfeer.\nAlle gerechten worden ter plaatse bereid met verse producten. Voor zonnige dagen is er een zonnig binnenterras beschikbaar."
    ],
    "es": [
      "A dos pasos del paseo marítimo y situado frente al Palacio de Congresos le Kursaal, el DKlé ofrece cocina contemporánea en un ambiente acogedor.\nTodos los platos se preparan in situ con productos frescos. Para los días soleados, dispone de una soleada terraza cubierta."
    ]
  },
