  "rdfs:comment": {
    "de": [
      "Vom 26. bis 28. Juli\nLokales Fest in Bouillancourt-en-Séry - Festkomitee\nAuf dem Programm stehen:\n- Samstag, 26:\nTrödelmarkt von 8.00 bis 16.30 Uhr ? 70 Aussteller werden ihre Stände im Herzen der Grande rue aufstellen - Kostenloser Standplatz\nAnmeldung erforderlich beim Comité des Fêtes - Emilie FOLLAIN - 06 03 65 57 41\nEssen und Trinken im Festsaal\nRadrennen\n- Sonntag, 27.: Straßenunterhaltung - Feuerwerk\nKirmesattraktionen an allen drei Tagen\nWeitere Informationen: 06 46 38 70 39"
    ],
    "en": [
      "From July 26th to 28th\nBouillancourt-en-Séry local festival - Comité des fêtes\nProgram:\n- Saturday 26th :\nBrocante from 8.00 am to 4.30 pm ? 70 exhibitors will set up their stalls in the heart of the Grande rue - Free space\nRegistration required with the Comité des Fêtes - Emilie FOLLAIN - 06 03 65 57 41\nCatering and refreshments in the village hall\nCycle race\n- Sunday 27: Street entertainment - Fireworks display\nFairground attractions on all 3 days\nFurther information: 06 46 38 70 39"
    ],
    "it": [
      "Dal 26 al 28 luglio\nFesta locale a Bouillancourt-en-Séry - Comitato delle feste\nIn programma:\n- Sabato 26:\nMercatino delle pulci dalle ore 8.00 alle 16.30 ? 70 espositori allestiranno le loro bancarelle nel cuore della Grande Rue - Spazio gratuito\nIscrizione obbligatoria presso il Comitato delle Feste - Emilie FOLLAIN - 06 03 65 57 41\nCatering e rinfreschi nella sala del villaggio\nGara ciclistica\n- Domenica 27: Animazione di strada - Spettacolo pirotecnico\nAttrazioni del luna park per tutti e 3 i giorni\nUlteriori informazioni: 06 46 38 70 39"
    ],
    "fr": [
      "Du 26 au 28 Juillet\nFête locale de Bouillancourt-en-Séry - Comité des fêtes\nAu programme : \n- Samedi 26 : \nBrocante de 8h00 à 16h30 – 70 exposants tiendront leurs stands au cœur de la Grande rue - Emplacement gratuit\nInscriptions obligatoire auprès du Comité des Fêtes - Emilie FOLLAIN -  06 03 65 57 41\nRestauration et buvette à la salle des fêtes\nCourse cycliste\n- Dimanche 27 : Animations de rues - Feu d’artifice\nAttraction foraine sur les 3 jours\nInfos supplémentaires : 06 46 38 70 39"
    ],
    "nl": [
      "Van 26 tot 28 juli\nLokaal feest in Bouillancourt-en-Séry - Comité des fêtes\nOp het programma:\n- Zaterdag 26 :\nVlooienmarkt van 8u00 tot 16u30 ? 70 marktkramers zullen hun kraampjes opstellen in het hart van de Grande Rue - Gratis plaats\nInschrijving verplicht bij het Comité des Fêtes - Emilie FOLLAIN - 06 03 65 57 41\nCatering en versnaperingen in het dorpshuis\nWielerwedstrijd\n- Zondag 27: Straatanimatie - Vuurwerk\nKermisattracties op alle 3 de dagen\nMeer informatie: 06 46 38 70 39"
    ],
    "es": [
      "Del 26 al 28 de julio\nFiesta local en Bouillancourt-en-Séry - Comité des fêtes\nEn el programa:\n- Sábado 26 :\nRastro de 8.00 a 16.30 h ? 70 expositores instalarán sus puestos en el corazón de la Grande Rue - Espacio libre\nInscripción obligatoria en el Comité des Fêtes - Emilie FOLLAIN - 06 03 65 57 41\nCatering y refrescos en la sala del pueblo\nCarrera ciclista\n- Domingo 27: Animación de calle - Fuegos artificiales\nAtracciones de feria los 3 días\nMás información: 06 46 38 70 39"
    ]
  },
