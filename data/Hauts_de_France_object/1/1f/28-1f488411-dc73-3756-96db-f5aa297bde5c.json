  "rdfs:comment": {
    "de": [
      "Kostenlos - Reservierung erforderlich\nBitte kommen Sie verkleidet.\nKonzert von Marianne & JC Acoustic Band - DJ Nixord für den zweiten Teil des Abends.\nSnacks und Getränke vor Ort.\nOrganisiert von den Feuerwehrleuten von Saint-Quentin-Lamotte."
    ],
    "en": [
      "Free - Reservation required\nCome in costume.\nConcert by Marianne & JC Acoustic Band - DJ Nixord for the second half of the evening.\nSnacks and drinks on site.\nOrganized by the Saint-Quentin-Lamotte Fire Brigade."
    ],
    "it": [
      "Gratuito - Prenotazione obbligatoria\nVieni vestito elegantemente.\nConcerto di Marianne & JC Acoustic Band - DJ Nixord per la seconda parte della serata.\nSpuntini e bevande sul posto.\nOrganizzato dai Vigili del Fuoco di Saint-Quentin-Lamotte."
    ],
    "fr": [
      "Gratuit - Réservation obligatoire\nVenez déguisés.\nConcert de Marianne & JC Acoustic Band - DJ Nixord pour la deuxième partie de la soirée.\nSnacking et boissons sur place.\nOrganisée par les Sapeurs-Pompiers de Saint-Quentin-Lamotte."
    ],
    "es": [
      "Gratuito - Reserva obligatoria\nVen disfrazado.\nConcierto de Marianne & JC Acoustic Band. DJ Nixord en la segunda parte de la velada.\nAperitivos y bebidas in situ.\nOrganizado por el Cuerpo de Bomberos de Saint-Quentin-Lamotte."
    ],
    "nl": [
      "Gratis - Reserveren verplicht\nKom verkleed.\nConcert door Marianne & JC Acoustic Band - DJ Nixord voor de tweede helft van de avond.\nHapjes en drankjes ter plaatse.\nGeorganiseerd door de brandweer van Saint-Quentin-Lamotte."
    ]
  },
