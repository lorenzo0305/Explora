      "dc:description": {
        "de": [
          "ALAIN SOUCHON\n\nL'EMBARCADERE - GROSSER SAAL\n\nGenre: VARIETE UND FRANZÖSISCHER CHANSON\nAb 50 ?\n\n(So können Sie Ihre Karten bequem von zu Hause aus ausdrucken, haben sie auf Ihrem Smartphone oder holen sie direkt im Geschäft ab.)"
        ],
        "en": [
          "ALAIN SOUCHON\n\nL'EMBARCADERE - GRANDE SALLE\n\nGenre: VARIETE ET CHANSON FRANCAISE\nFrom ? 50.\n\n(You can print your tickets from home, have them on your smartphone or collect them directly from the store)"
        ],
        "it": [
          "ALAIN SOUCHON\n\nL'EMBARCADERE - GRANDE SALA\n\nGenere: VARIETE ET CHANSON FRANCAISE\nDa ? 50.\n\n(Potete stampare i vostri biglietti da casa, averli sul vostro smartphone o ritirarli direttamente in negozio)"
        ],
        "fr": [
          "ALAIN SOUCHON\n\nL'EMBARCADERE - GRANDE SALLE\n\nGenre : VARIETE ET CHANSON FRANCAISE\nÀ partir de 50 €.\n\n(Vous pourrez ainsi imprimer vos billets depuis votre domicile, les avoir sur votre smartphone ou les retirer directement au magasin)"
        ],
        "nl": [
          "ALAIN SOUCHON\n\nL'EMBARCADERE - GROTE ZAAL\n\nGenre: VARIETE ET CHANSON FRANCAISE\nVanaf ? 50.\n\n(Je kunt je kaartjes thuis afdrukken, op je smartphone zetten of direct in de winkel afhalen)"
        ],
        "es": [
          "ALAIN SOUCHON\n\nL'EMBARCADERE - GRANDE SALLE\n\nGénero: VARIETE ET CHANSON FRANCAISE\nA partir de ? 50.\n\n(Puedes imprimir tus entradas desde casa, tenerlas en tu smartphone o recogerlas directamente en la tienda)"
        ]
      },
