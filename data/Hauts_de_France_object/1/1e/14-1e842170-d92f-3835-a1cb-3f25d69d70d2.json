      "@id": "https://data.datatourisme.fr/360d08e6-4126-37b3-b433-ebb4d2462297",
      "dc:description": {
        "de": [
          "Schnellrestaurants, Pommes frites. Die Pommesbude wurde 2020 zum drittbesten Restaurant Frankreichs gekürt Eine schöne Belohnung für die Chefin Sylvia."
        ],
        "en": [
          "Fast food, chip shop. The chip shop has just been classified in 2020 third best in France! A great reward for the boss Sylvia."
        ],
        "it": [
          "Fast food, negozio di patatine fritte. Il negozio di patatine fritte è stato appena classificato come il terzo migliore in Francia nel 2020! Una grande ricompensa per la proprietaria Sylvia."
        ],
        "fr": [
          "Restauration rapide, friterie. La friterie vient d’être classée en 2020 troisième meilleure de France! Une belle récompense pour la patronne Sylvia."
        ],
        "nl": [
          "Fast food, frituur. De friettent is zojuist uitgeroepen tot derde beste van Frankrijk in 2020! Een mooie beloning voor de eigenaresse Sylvia."
        ],
        "es": [
          "Comida rápida, tienda de patatas fritas. La tienda de patatas fritas acaba de ser clasificada como la tercera mejor de Francia en 2020 Una gran recompensa para la propietaria Sylvia."
        ]
      },
