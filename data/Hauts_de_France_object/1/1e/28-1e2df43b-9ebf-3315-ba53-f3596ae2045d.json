  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4cce5a86-daa1-38f8-a39e-1d692d943e97",
      "dc:description": {
        "de": [
          "Die Gemeindebibliothek von Brissay-Choigny verfügt über einen Bestand, der hauptsächlich aus Buchkäufen besteht. Die ehrenamtlichen Mitarbeiter informieren Sie über Neuerscheinungen und stehen Ihnen für Auskünfte zur Verfügung."
        ],
        "en": [
          "The Municipal Library of Brissay-Choigny has a collection mainly made up of book purchases. Volunteers keep you informed of new books and are at your disposal for any information."
        ],
        "it": [
          "La Biblioteca comunale di Brissay-Choigny possiede una collezione di libri, principalmente acquistati. I volontari vi tengono informati sulle novità librarie e sono a vostra disposizione per qualsiasi informazione."
        ],
        "fr": [
          "La Bibliothèque Municipale de Brissay-Choigny dispose d'un fonds constitué principalement d'achats de livre. Les bénévoles vous informent des nouveautés et sont à votre disposition pour tout renseignement."
        ],
        "es": [
          "La Biblioteca Municipal de Brissay-Choigny cuenta con una colección de libros, principalmente comprados. Los voluntarios le mantienen informado de los nuevos libros y están a su disposición para cualquier información."
        ],
        "nl": [
          "De gemeentelijke bibliotheek van Brissay-Choigny heeft een collectie boeken, voornamelijk gekocht. De vrijwilligers houden u op de hoogte van nieuwe boeken en staan tot uw beschikking voor alle informatie."
        ]
      },
