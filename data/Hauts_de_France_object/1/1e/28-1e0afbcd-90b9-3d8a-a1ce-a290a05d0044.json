  "rdfs:comment": {
    "de": [
      "\"Haben Sie Lust auf ein Essen, das Ihre Geschmacksknospen reizt?\nRosine & Antoine erzählen Ihnen keine Salate und bieten seit 2008 eine Küche mit frischen Produkten im Einklang mit den Jahreszeiten an. Die Karte ist bewusst kurz gehalten und wird sechsmal im Jahr erneuert, um sich den Produkten und den Erwartungen aller anzupassen!\""
    ],
    "en": [
      "\"Fancy a gourmet meal to tantalize your taste buds?\nSince 2008, Rosine & Antoine haven't been talking salads, offering a cuisine based on fresh seasonal produce, a deliberately short menu, renewed 6 times a year to adapt to the products and expectations of all!\""
    ],
    "it": [
      "\"Avete voglia di un pasto gustoso che stuzzichi le vostre papille gustative?\nDal 2008, Rosine & Antoine propongono una cucina basata su prodotti freschi di stagione, con un menu volutamente breve, cambiato 6 volte all'anno per adattarsi ai prodotti e alle aspettative di tutti!\""
    ],
    "fr": [
      "\"Envie d'un repas aux petits oignons qui émoustille vos papilles ? \nRosine & Antoine ne vous racontent pas de salades et proposent depuis 2008, une cuisine à base de produits frais au fil des saisons, une carte volontairement courte, renouvelée 6 fois dans l'année pour s'adapter aux produits et aux attentes de tous !\""
    ],
    "es": [
      "\"¿Le apetece una comida sabrosa para deleitar su paladar?\nDesde 2008, Rosine & Antoine sirven una cocina basada en productos frescos de temporada, con una carta deliberadamente corta, ¡que cambia 6 veces al año para adaptarse a los productos y a las expectativas de todos!\""
    ],
    "nl": [
      "\"Zin in een smakelijke maaltijd die je smaakpapillen zal prikkelen?\nSinds 2008 serveren Rosine & Antoine een keuken gebaseerd op verse seizoensproducten, met een bewust kort menu dat 6 keer per jaar wordt gewijzigd om zich aan te passen aan de producten en verwachtingen van iedereen!\""
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Temps Gourmands"
    ]
  },
