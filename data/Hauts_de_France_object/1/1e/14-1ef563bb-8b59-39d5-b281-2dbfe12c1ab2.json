  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0fdff2e4-4a2c-3c13-b838-700e3ed60827",
      "dc:description": {
        "de": [
          "Die Theatergruppe La Fabrique wird von einem professionellen Regisseur betreut.\nJedes Jahr wählen wir ein oder zwei Stücke aus, um sie in mehreren Gemeinden der Ca2bm aufzuführen."
        ],
        "en": [
          "The La Fabrique theater troupe is supervised by a professional director.\nEach year, we choose one or two plays to perform in several communes of the Ca2bm."
        ],
        "it": [
          "La compagnia teatrale La Fabrique è diretta da un regista professionista.\nOgni anno scegliamo uno o due spettacoli da rappresentare in diversi comuni del Ca2bm."
        ],
        "fr": [
          "La troupe de théâtre la Fabrique est encadrée par un metteur en scène professionnel.\nChaque année, nous choisissons une ou deux pièce afin de les jouer sur plusieurs communes de la Ca2bm."
        ],
        "es": [
          "La compañía de teatro La Fabrique está dirigida por un director profesional.\nCada año elegimos una o dos obras para representarlas en varios municipios de la Ca2bm."
        ],
        "nl": [
          "Het theatergezelschap La Fabrique wordt geleid door een professionele regisseur.\nElk jaar kiezen we een of twee toneelstukken om op te voeren in verschillende gemeenten van de Ca2bm."
        ]
      },
