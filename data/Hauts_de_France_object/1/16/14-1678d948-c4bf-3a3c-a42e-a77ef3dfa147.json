  "rdfs:comment": {
    "de": [
      "Öffnen Sie eine Klammer des Wohlbefindens im Kokon \"côté spa\" der Gîtes de l'école buissonnière und tanken Sie auf!"
    ],
    "en": [
      "Open a wellness parenthesis in the spa-like cocoon of the Gîtes de l'école buissonnière and recharge your batteries!"
    ],
    "it": [
      "Fate una pausa e ricaricate le batterie nel bozzolo termale dei Gîtes de l'école buissonnière!"
    ],
    "fr": [
      "Ouvrez une parenthèse de bien-être dans le cocon \"côté spa\" des Gîtes de l'école buissonnière et ressourcez-vous !"
    ],
    "es": [
      "Tómese un respiro y recargue las pilas en el capullo balneario de las Gîtes de l'école buissonnière"
    ],
    "nl": [
      "Neem een pauze en doe nieuwe energie op in de cocon van de Gîtes de l'école buissonnière!"
    ]
  },
