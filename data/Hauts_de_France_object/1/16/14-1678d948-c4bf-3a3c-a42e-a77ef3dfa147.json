  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f6721ffc-f421-340a-9dd9-6feeb0a87c43",
      "dc:description": {
        "de": [
          "Das Spa ist in einer umweltfreundlichen Lodge untergebracht. Die Inneneinrichtung ist aus Holz und sorgt für eine intime und gemütliche Atmosphäre. Die Isolierung des Spa-Kokons wurde mit Wolle vorgenommen, um einen optimalen Komfort zu gewährleisten."
        ],
        "en": [
          "The spa is housed in an eco-friendly lodge. The wooden interior creates a cosy, intimate atmosphere. The spa cocoon is insulated with wool for optimum comfort."
        ],
        "it": [
          "La spa è ospitata in un lodge eco-responsabile. Gli interni in legno creano un'atmosfera intima e accogliente. Il bozzolo della spa è isolato con lana per un comfort ottimale."
        ],
        "fr": [
          "Le spa est aménagé dans un loge éco-responsable. L'intérieur est en bois et procure une ambiance intimiste et cosy. L'isolation du cocon spa a été faite avec de la laine, pour un confort optimal."
        ],
        "es": [
          "El balneario se encuentra en una cabaña respetuosa con el medio ambiente. El interior de madera crea un ambiente íntimo y acogedor. El capullo del spa está aislado con lana para un confort óptimo."
        ],
        "nl": [
          "De spa is gevestigd in een ecologisch verantwoorde lodge. Het houten interieur creëert een gezellige, intieme sfeer. De cocon van de spa is geïsoleerd met wol voor optimaal comfort."
        ]
      },
