  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/983c33a1-1bb5-3164-8b1e-eeaee42f8bd4",
      "dc:description": {
        "de": [
          "Sabine und David begrüßen Sie in einem ehemaligen Schlachthof Metzgerei, in ein Restaurant und Laden mit regionalen Produkten umgewandelt, wo Sie flämische Gerichte und Biere genießen können..."
        ],
        "en": [
          "Sabine and David welcome you in a former slaughterhouse, transformed into a small restaurant and store of regional products, where you can taste Flemish dishes and beers..."
        ],
        "it": [
          "Sabine e David vi accolgono in un ex mattatoio, trasformato in estaminet e negozio di prodotti regionali, dove potrete gustare piatti e birre fiamminghe..."
        ],
        "fr": [
          "Sabine et David vous accueille dans un ancien abattoir boucherie, transformé en estaminet et magasin de produit régionaux ,ou vous pourrez déguster des plats flamands et des bières..."
        ],
        "es": [
          "Sabine y David le dan la bienvenida en un antiguo matadero, transformado en estaminet y tienda de productos regionales, donde podrá degustar platos flamencos y cervezas..."
        ],
        "nl": [
          "Sabine en David verwelkomen u in een voormalig slachthuis, omgebouwd tot estaminet en winkel van streekproducten, waar u Vlaamse gerechten en bieren kunt proeven..."
        ]
      },
