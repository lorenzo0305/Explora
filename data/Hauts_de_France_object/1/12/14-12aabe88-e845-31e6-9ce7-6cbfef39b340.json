  "rdfs:comment": {
    "de": [
      "Le Passe Temps ist eine praktische und zugleich liebenswerte Adresse: eine traditionelle Brasserie gegenüber dem Bahnhof, mit guter regionaler Küche, einem ausgezeichneten Preis-Leistungs-Verhältnis und einem sehr freundlichen Service. Das dazugehörige Hotel ist einfach, aber effizient, perfekt für einen Zwischenstopp in Arras."
    ],
    "en": [
      "Le Passe Temps is both a practical and appealing address: a traditional brasserie facing the station, with good regional cuisine, excellent value for money, and very friendly service. The associated hotel is simple but efficient, perfect for a stopover in Arras."
    ],
    "it": [
      "Le Passe Temps è un indirizzo pratico e accattivante: una brasserie tradizionale di fronte alla stazione, con una buona cucina regionale, un ottimo rapporto qualità-prezzo e un servizio molto cordiale. L'hotel associato è semplice ma efficiente, perfetto per una sosta ad Arras."
    ],
    "fr": [
      "Le Passe Temps est une adresse à la fois pratique et attachante : une brasserie traditionnelle face à la gare, avec une bonne cuisine régionale, un excellent rapport qualité-prix, et un service très sympathique. L’hôtel associé est simple mais efficace, parfait pour une halte à Arras."
    ],
    "nl": [
      "Le Passe Temps is een adres dat zowel praktisch als aantrekkelijk is: een traditionele brasserie tegenover het station, met een goede regionale keuken, een uitstekende prijs-kwaliteitverhouding en een zeer vriendelijke bediening. Het bijbehorende hotel is eenvoudig maar efficiënt, perfect voor een tussenstop in Arras."
    ],
    "es": [
      "Le Passe Temps es una dirección a la vez práctica y atractiva: una brasserie tradicional frente a la estación, con buena cocina regional, excelente relación calidad-precio y un servicio muy amable. El hotel asociado es sencillo pero eficiente, perfecto para una parada en Arras."
    ]
  },
  "rdfs:label": {
