  "rdfs:comment": {
    "de": [
      "Der Square Pierre Catteau, eine kleine grüne Insel, die von dem Landschaftsarchitekten Georges Aumont entworfen wurde, wurde 1890 von der Stadt von den Erben eines reichen Textilfabrikanten gekauft.\r\nDer Justizpalast, ein majestätisches Bauwerk aus dem 19. Jahrhundert, überragt diesen 13500 m2 großen bukolischen Garten."
    ],
    "en": [
      "Square Pierre Catteau, a small island of greenery designed by landscape architect Georges Aumont, was purchased by the town in 1890 from the heirs of a wealthy textile industrialist.\r\nThe Palais de Justice, a majestic 19th-century building, overlooks this 13500 m2 bucolic garden."
    ],
    "it": [
      "Square Pierre Catteau, una piccola isola di verde progettata dall'architetto paesaggista Georges Aumont, fu acquistata dalla città nel 1890 dagli eredi di un ricco industriale tessile.\r\nIl Palazzo di Giustizia, un maestoso edificio del XIX secolo, si affaccia su questo giardino bucolico di 13500 m2."
    ],
    "fr": [
      "Le Square Pierre Catteau, petit îlot de verdure dessiné par le paysagiste Georges Aumont, fut acheté par la ville en 1890 aux héritiers d’un riche industriel du textile.\r\nLe Palais de justice, majestueuse construction du XIXème siècle,  surplombe ce jardin bucolique de 13500 m2."
    ],
    "nl": [
      "Square Pierre Catteau, een klein eiland van groen ontworpen door landschapsarchitect Georges Aumont, werd in 1890 door de stad gekocht van de erfgenamen van een rijke textielindustrieel.\r\nHet Palais de Justice, een majestueus gebouw uit de 19e eeuw, kijkt uit over deze bucolische tuin van 13500 m2."
    ],
    "es": [
      "La plaza Pierre Catteau, una pequeña isla de verdor diseñada por el paisajista Georges Aumont, fue adquirida por la ciudad en 1890 a los herederos de un rico industrial textil.\r\nEl Palacio de Justicia, majestuoso edificio del siglo XIX, domina este bucólico jardín de 13500 m2."
    ]
  },
