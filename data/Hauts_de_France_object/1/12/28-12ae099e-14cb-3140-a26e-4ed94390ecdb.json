  "rdfs:comment": {
    "de": [
      "Handwerkliche Bäckerei, in der das Hausgemachte im Vordergrund steht: knusprige Brote, großzügiges Gebäck und leckere Süßigkeiten, die jeden Tag mit Leidenschaft und sorgfältig ausgewählten Zutaten zubereitet werden."
    ],
    "en": [
      "An artisan bakery where homemade products take pride of place: crusty breads, generous viennoiseries and gourmet sweets, prepared daily with passion and carefully selected ingredients."
    ],
    "it": [
      "Una panetteria artigianale dove i prodotti fatti in casa sono al primo posto: pani croccanti, generose viennoiseries e deliziosi dolci, preparati ogni giorno con passione e ingredienti accuratamente selezionati."
    ],
    "fr": [
      "Boulangerie artisanale où le fait maison est à l’honneur : pains croustillants, viennoiseries généreuses et douceurs gourmandes, préparés chaque jour avec passion et des ingrédients soigneusement sélectionnés."
    ],
    "es": [
      "Una panadería artesanal donde los productos caseros ocupan un lugar de honor: panes crujientes, generosas viennoiseries y deliciosos dulces, preparados cada día con pasión e ingredientes cuidadosamente seleccionados."
    ],
    "nl": [
      "Een ambachtelijke bakkerij waar huisgemaakte producten de boventoon voeren: knapperige broden, royale viennoiseries en heerlijke zoetigheden, elke dag met passie bereid en met zorgvuldig geselecteerde ingrediënten."
    ]
  },
