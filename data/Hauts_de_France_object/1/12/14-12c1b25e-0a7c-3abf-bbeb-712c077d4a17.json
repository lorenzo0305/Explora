  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/56061cc8-10ed-3b62-80ba-cf210adcbfc2",
      "dc:description": {
        "de": [
          "Mickaël empfängt Sie mit einem Lächeln und einem Sinn für Beratung in seinem Feinkostladen. Eine Vielzahl an süßen und herzhaften Produkten wird Sie verwöhnen."
        ],
        "en": [
          "Mickaël welcomes you with a smile and a sense of advice to his delicatessen. A multitude of sweet and savoury products to delight you."
        ],
        "it": [
          "Mickaël vi accoglie nella sua gastronomia con un sorriso e un occhio attento ai consigli. Una moltitudine di prodotti dolci e salati per deliziarvi."
        ],
        "fr": [
          "Mickaël vous accueille avec le sourire et le sens du conseil dans son épicerie fine. Une multitude de produits sucrés et salés pour vous régaler."
        ],
        "nl": [
          "Mickaël verwelkomt je in zijn delicatessenzaak met een glimlach en een scherp oog voor advies. Een overvloed aan zoete en hartige producten om je te plezieren."
        ],
        "es": [
          "Mickaël le recibe en su charcutería con una sonrisa y buen ojo para aconsejarle. Una multitud de productos dulces y salados para deleitarle."
        ]
      },
