      "@id": "https://data.datatourisme.fr/e234e93c-6657-3cac-8bd7-2c43194e57b5",
      "dc:description": {
        "de": [
          "Willkommen im Land des Chicorées!\nEntdecken Sie diese originalgetreu restaurierte ehemalige Zichorientrocknerei sowie den Skulpturengarten"
        ],
        "en": [
          "Welcome to Chicory Country!\nDiscover this faithfully restored former chicory drying plant and the Sculpture Garden"
        ],
        "it": [
          "Benvenuti nel Paese della Cicoria!\nScoprite questo antico essiccatoio di cicoria, riportato alle condizioni originali, e il Giardino delle Sculture"
        ],
        "fr": [
          "Bienvenue au Pays de la Chicorée !\nDécouvrez cette ancienne sécherie de chicorée restaurée à l'identique ainsi que le Jardin des Sculptures"
        ],
        "es": [
          "¡Bienvenido al País de la Achicoria!\nDescubra este antiguo secadero de achicoria, restaurado a su estado original, y el Jardín de Esculturas"
        ],
        "nl": [
          "Welkom in Witlofland!\nOntdek deze voormalige cichoreidrogerij, die in zijn oorspronkelijke staat is hersteld, en de Beeldentuin"
        ]
      },
