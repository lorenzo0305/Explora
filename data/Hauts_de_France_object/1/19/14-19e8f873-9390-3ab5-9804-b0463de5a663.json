      "dc:description": {
        "de": [
          "Herr und Frau Lecomte bieten Ihnen ihre handwerklich hergestellten, gefüllten Waffeln und Etrennes-Waffeln an. Verkauf im Geschäft Vert de Terre."
        ],
        "en": [
          "Mr and Mrs Lecomte offer you their home-made filled waffles and Christmas waffles. On sale in the Vert de Terre store."
        ],
        "it": [
          "I coniugi Lecomte vi offrono le loro cialde ripiene fatte in casa e le cialde di Natale. In vendita nel negozio Vert de Terre."
        ],
        "fr": [
          "Mr et Mme Lecomte vous propose leurs Gaufres artisanales fourrées et gaufres d'étrennes. Vente au magasin Vert de Terre."
        ],
        "nl": [
          "Meneer en mevrouw Lecomte bieden je hun zelfgemaakte gevulde wafels en kerstwafels aan. Te koop in de winkel Vert de Terre."
        ],
        "es": [
          "El Sr. y la Sra. Lecomte le ofrecen sus gofres rellenos caseros y sus gofres de Navidad. A la venta en la tienda Vert de Terre."
        ]
      },
