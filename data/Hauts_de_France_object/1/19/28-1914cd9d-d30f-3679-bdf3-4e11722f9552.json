  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8d1f0e8e-26b9-32ad-a311-32e09aa8caf3",
      "dc:description": {
        "de": [
          "Estaminet \"Maître Restaurateur\" (Meisterkoch)\n\nMittagessen: 12h-14h\nAbendessen: 19:00-22:00 Uhr\n\nGericht à la carte: 17 ? mini - 25 ? maxi\n\nGruppen ab 15 Personen\n3 Säle mit 20 - 50 - 60 Gedecken, die privatisiert werden können.\n\nMetrolinie 1: Station 'Rihour'\n\n "
        ],
        "en": [
          "Estaminet \"Maître Restaurateur\n\nLunch : 12h-14h\nDinner: 7-10pm\n\nA la carte dishes: 17 ? mini - 25 ? maxi\n\nGroups of 15 or more\n3 private rooms for 20 - 50 - 60 covers.\n\nMetro line 1 : 'Rihour' station\n\n "
        ],
        "it": [
          "Estaminet \"Maître Restaurateur\n\nPranzo: 12.00-14.00\nCena: 19.00-22.00\n\nPiatti alla carta: 17 ? minimo - 25 ? massimo\n\nGruppi di 15 o più persone\n3 sale private per 20, 50 o 60 coperti.\n\nLinea 1 della metropolitana: stazione \"Rihour\n\n "
        ],
        "fr": [
          "Estaminet \"Maître Restaurateur\"\n\nDéjeuner : 12h-14h\nDiner : 19h-22h\n\nPlat à la carte  : 17 € mini - 25 € maxi\n\nGroupes à partir de 15 personnes\n3 salles à privatiser de 20 - 50 - 60 couverts.\n\nMétro ligne 1 : station 'Rihour'\n\n "
        ],
        "nl": [
          "Estaminet \"Restaurateur\n\nLunch: 12u-20u\nDiner: 19.00-10.00\n\nA la carte gerechten: 17 ? minimum - 25 ? maximum\n\nGroepen van 15 of meer\n3 privézalen voor 20, 50 of 60 couverts.\n\nMetrolijn 1: station 'Rihour\n\n "
        ],
        "es": [
          "Estaminet \"Maître Restaurateur\n\nAlmuerzo: 12h-14h\nCena: de 19:00 a 22:00\n\nPlatos a la carta: 17€ mínimo - 25€ máximo\n\nGrupos a partir de 15 personas\n3 salones privados para 20, 50 o 60 cubiertos.\n\nMetro línea 1: estación \"Rihour\n\n "
        ]
      },
