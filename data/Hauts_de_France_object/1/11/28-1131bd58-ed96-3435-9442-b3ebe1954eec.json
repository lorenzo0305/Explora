  "rdfs:comment": {
    "de": [
      "Genießen Sie den schönsten Panoramablick auf die Stadt Lille bei einem Cocktail im Herzen von Lille über dem Carlton Hotel.\n\n* Ohne Reservierung *"
    ],
    "en": [
      "Enjoy a cocktail in the heart of Lille, above the Carlton Hotel, with the most beautiful panoramic view of the city.\n\n* No reservation required *"
    ],
    "it": [
      "Godetevi la più bella vista panoramica della città di Lille con un cocktail nel cuore di Lille, sopra l'Hôtel Carlton.\n\n* Non è necessaria la prenotazione *"
    ],
    "fr": [
      "Bénéficiez du plus beau panorama sur la ville de Lille en vous offrant un cocktail au cœur de Lille, au dessus de l'Hôtel Carlton.\n\n* Sans réservation *"
    ],
    "nl": [
      "Geniet van het mooiste panoramische uitzicht over de stad Lille met een cocktail in het hart van Lille, boven het Hôtel Carlton.\n\n* Reserveren is niet nodig *"
    ],
    "es": [
      "Disfrute de la vista panorámica más hermosa de la ciudad de Lille con un cóctel en pleno centro de Lille, encima del Hôtel Carlton.\n\n* No es necesario reservar *"
    ]
  },
