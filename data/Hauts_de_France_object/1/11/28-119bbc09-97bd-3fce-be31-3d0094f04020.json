  "rdfs:comment": {
    "de": [
      "Tauchen Sie in die Geschichte von Arras ein und übernachten Sie in diesem außergewöhnlichen Boutique-Hotel, das sich an den wunderschönen Grand-Place schmiegt, der zum UNESCO-Weltkulturerbe gehört. Das Grand Place Hôtel bietet Ihnen ein einzigartiges Erlebnis, das den Charme vergangener Zeiten mit modernem Komfort verbindet."
    ],
    "en": [
      "Immerse yourself in the history of Arras by staying at this exceptional boutique hotel, nestled on the magnificent Grand Place, a UNESCO World Heritage site. Le Grand Place Hôtel offers a unique experience combining old-world charm and modern comfort."
    ],
    "it": [
      "Immergetevi nella storia di Arras soggiornando in questo eccezionale boutique hotel, situato nella magnifica Grand Place, patrimonio mondiale dell'UNESCO. Il Grand Place Hôtel offre un'esperienza unica che combina il fascino di un tempo con i comfort moderni."
    ],
    "fr": [
      "Immergez-vous dans l'histoire d'Arras en séjournant dans ce boutique hôtel d'exception, niché sur la magnifique Grand-Place, classée au patrimoine mondial de l'UNESCO. Le Grand Place Hôtel vous propose une expérience unique alliant charme d'antan et confort moderne."
    ],
    "es": [
      "Sumérjase en la historia de Arras alojándose en este excepcional hotel boutique, situado en la magnífica Grand Place, declarada Patrimonio de la Humanidad por la UNESCO. El Grand Place Hôtel ofrece una experiencia única que combina el encanto de antaño con las comodidades modernas."
    ],
    "nl": [
      "Dompel jezelf onder in de geschiedenis van Arras door te verblijven in dit uitzonderlijke boetiekhotel, genesteld op de prachtige Grand Place, een UNESCO Werelderfgoedlocatie. Het Grand Place Hôtel biedt een unieke ervaring die de charme van weleer combineert met modern comfort."
    ]
  },
