  "rdfs:comment": {
    "de": [
      "Ein Entspannungsbereich im Freien im Herzen der Altstadt von Lille im Hotel Mercure Lille Centre Vieux-Lille, wo Sie ein lokales Bier oder ein Glas Wein an einem schönen Probierbrett genießen können."
    ],
    "en": [
      "An outdoor relaxation area in the heart of Vieux Lille at the Mercure Lille Centre Vieux-Lille hotel, where you can enjoy a local beer or a glass of wine around a beautiful tasting board."
    ],
    "it": [
      "Un'area relax all'aperto nel cuore di Vieux Lille, nell'hotel Mercure Lille Centre Vieux-Lille, dove potrete gustare una birra locale o un bicchiere di vino attorno a un simpatico tagliere di degustazione."
    ],
    "fr": [
      "Un espace détente en extérieur au cœur du Vieux Lille dans l'hôtel Mercure Lille Centre Vieux-Lille, où vous pourrez déguster une bière locale ou un verre de vin autour d'une belle planche de dégustation."
    ],
    "es": [
      "Una zona de descanso al aire libre en el corazón del Vieux Lille, en el hotel Mercure Lille Centre Vieux-Lille, donde podrá disfrutar de una cerveza local o una copa de vino en torno a una bonita tabla de degustación."
    ],
    "nl": [
      "Een ontspanningsruimte in de open lucht in het hart van Vieux Lille in het Mercure Lille Centre Vieux-Lille hotel, waar je kunt genieten van een lokaal biertje of een glas wijn rond een mooi proefbord."
    ]
  },
