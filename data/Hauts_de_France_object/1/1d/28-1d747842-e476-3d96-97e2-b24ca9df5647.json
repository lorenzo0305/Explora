  "rdfs:comment": {
    "de": [
      "Probieren Sie indische Spezialitäten mit herrlich duftenden Noten in einer gemütlichen Umgebung.\nVon Naans über Chicken Korma ist für jeden Gaumen etwas dabei."
    ],
    "en": [
      "Come and taste Indian specialties with deliciously fragrant notes in a warm and welcoming setting.\nFrom naans to chicken korma, there's something for every palate."
    ],
    "it": [
      "Venite a gustare le deliziose e profumate specialità indiane in un ambiente accogliente.\nDai naan al pollo korma, ce n'è per tutti i palati."
    ],
    "fr": [
      "Venez déguster les spécialités indiennes aux notes délicieusement parfumées dans un cadre chaleureux.\nDes naans en passant par le poulet korma il y en a pour tous les palais."
    ],
    "es": [
      "Venga a degustar las deliciosamente fragantes especialidades indias en un ambiente acogedor.\nDesde naans hasta pollo korma, hay algo para todos los paladares."
    ],
    "nl": [
      "Kom en proef de heerlijk geurende Indiase specialiteiten in een gezellige omgeving.\nVan naans tot kip korma, er is voor elk wat wils."
    ]
  },
