  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f72f191e-7109-3467-9de9-6235efad7ace",
      "dc:description": {
        "de": [
          "Le nid d'Ibou : Themenbar\nIm Nid d'Ibou wird gesungen, gelacht und angestoßen! Konzerte, offene Bühnen, Karaoke? Eine lebendige und festliche Bar im Herzen von Arras. In der Rue Saint-Aubert 68 geht es rund!"
        ],
        "en": [
          "Le nid d'Ibou: theme bar\nAt Le Nid d?Ibou, we sing, we laugh, we toast! Concerts, open stages, karaoke? A lively, festive bar in the heart of Arras. Come and vibrate at 68 rue Saint-Aubert!"
        ],
        "it": [
          "Le nid d'Ibou: bar a tema\nA Le Nid d'Ibou si canta, si ride e si brinda! Concerti, palchi aperti, karaoke? Un bar vivace e festoso nel cuore di Arras. Venite a vibrare al 68 di rue Saint-Aubert!"
        ],
        "fr": [
          "Le nid d'Ibou : bar à thème\nAu Nid d’Ibou, on chante, on rit, on trinque ! Concerts, scènes ouvertes, karaokés… Un bar vivant et festif au cœur d’Arras. Viens vibrer au 68 rue Saint-Aubert !"
        ],
        "nl": [
          "Le nid d'Ibou : thema bar\nBij Le Nid d'Ibou zingen we, lachen we en proosten we! Concerten, open podia, karaoke? Een levendige, feestelijke bar in het hart van Arras. Kom vibreren op 68 rue Saint-Aubert!"
        ],
        "es": [
          "Le nid d'Ibou : bar temático\nEn Le Nid d'Ibou, ¡cantamos, reímos y brindamos! Conciertos, escenarios abiertos, karaoke? Un bar animado y festivo en el corazón de Arras. ¡Venga a vibrar al 68 rue Saint-Aubert!"
        ]
      },
      "@type": [
        "Description"
