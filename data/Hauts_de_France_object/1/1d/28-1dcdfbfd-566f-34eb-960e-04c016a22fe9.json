  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/11ab887e-57c1-3bc7-8f6f-bc3d5bc73279",
      "dc:description": {
        "de": [
          "Öffnen Sie die Türen unseres gemütlichen Familienrestaurants, wo die Teller Ihren Gaumen, Ihre Augen sowie Ihren Appetit erfreuen werden, und das alles in einem gemütlichen Rahmen."
        ],
        "en": [
          "Push the doors of our warm and family restaurant where the dishes will delight your taste buds, your eyes as well as your appetite, all in a cosy setting."
        ],
        "it": [
          "Spingete le porte del nostro ristorante caldo e familiare dove i piatti delizieranno le vostre papille gustative, i vostri occhi e il vostro appetito, il tutto in un ambiente accogliente."
        ],
        "fr": [
          "Poussez les portes de notre restaurant familial et chaleureux où les assiettes raviront vos papilles, vos yeux ainsi que votre appétit, le tout dans un cadre cosy."
        ],
        "nl": [
          "Stap binnen in ons warme en familiale restaurant waar de gerechten uw smaakpapillen, uw ogen en uw eetlust zullen verrukken, en dit alles in een gezellig kader."
        ],
        "es": [
          "Empuje las puertas de nuestro cálido y familiar restaurante, donde los platos deleitarán su paladar, su vista y su apetito, todo ello en un entorno acogedor."
        ]
      },
