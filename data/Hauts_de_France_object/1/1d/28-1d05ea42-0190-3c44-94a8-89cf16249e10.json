  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0342a800-4fdb-3944-85f4-5653601d4304",
      "dc:description": {
        "de": [
          "Wählen Sie aus den vielen hausgemachten marokkanischen Rezepten und lassen Sie sich während einer Pause von den orientalischen Gebäckstücken oder den frischen Broten verführen."
        ],
        "en": [
          "Choose from a wide range of homemade Moroccan recipes, and take a break to indulge in oriental pastries or freshly baked breads."
        ],
        "it": [
          "Scegliete tra un'ampia gamma di ricette marocchine fatte in casa e fate una pausa per provare i dolci orientali o il pane appena sfornato."
        ],
        "fr": [
          "Choisissez parmi les nombreuses recettes marocaines faites maison et laissez-vous tenter le temps d’une pause par les pâtisseries orientales ou par less pains frais."
        ],
        "nl": [
          "Kies uit een breed scala aan zelfgemaakte Marokkaanse recepten en neem een pauze om het oosterse gebak of de versgebakken broden te proberen."
        ],
        "es": [
          "Elija entre una amplia gama de recetas marroquíes caseras y tómese un descanso para probar la repostería oriental o los panes recién horneados."
        ]
      },
