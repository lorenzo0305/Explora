  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a76e80a1-3297-3e70-bd42-75e805651dc3",
      "dc:description": {
        "de": [
          "Picknickbereich, der sich auf dem Place de la Mairie befindet. Verschiedene Ausstattungen: 4 Picknicktische, Parkplatz, Spielplatz und Mülleimer\n\nIn der Nähe: Geschäfte (Bäckerei/Imbiss), City-Stadion und Bouleplatz."
        ],
        "en": [
          "Picnic area located in the Place de la Mairie. Various equipment: 4 picnic tables, car park, playground and rubbish bins\n\nNearby: shops (bakery/snack), city stadium and petanque ground."
        ],
        "it": [
          "Area picnic in Place de la Mairie. Varie strutture: 4 tavoli da picnic, parcheggio, parco giochi e cestini per i rifiuti\n\nNelle vicinanze: negozi (panetteria/snack bar), stadio cittadino e campo da bocce."
        ],
        "fr": [
          "Aire de pique-nique se situant Place de la Mairie. Divers équipement : 4 tables de pique-nique, parking, aire de jeux et poubelles. \n\nA proximité : commerces (boulangerie/snack), city stade et terrain de pétanque."
        ],
        "es": [
          "Zona de picnic en la Place de la Mairie. Diversas instalaciones: 4 mesas de picnic, aparcamiento, parque infantil y papeleras\n\nCerca: tiendas (panadería/bar), estadio municipal y campo de petanca."
        ],
        "nl": [
          "Picknickplaats op de Place de la Mairie. Diverse voorzieningen: 4 picknicktafels, parkeerplaats, speeltuin en afvalbakken\n\nIn de buurt: winkels (bakker/snackbar), stadsstadion en petanqueveld."
        ]
      },
