  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7799fedd-8f1a-31a1-99cb-c08a063c9ad4",
      "dc:description": {
        "de": [
          "Du bist Läufer, Walker, Trailrunner oder einfach nur gerne in bewaldeten Parks und auf Halden unterwegs, dann nimm am Polonia run teil."
        ],
        "en": [
          "If you're a runner, walker, traileur or just like to stroll through wooded parks and slag heaps, then take part in the Polonia run."
        ],
        "it": [
          "Se siete corridori, camminatori, traileur o semplicemente vi piace passeggiare tra parchi boscosi e cumuli di scorie, partecipate alla Polonia run."
        ],
        "fr": [
          "Tu es coureur, marcheur, traileur ou tout simplement tu aimes te balader dans les parcs boisés et les terrils alors participe à la Polonia run."
        ],
        "es": [
          "Si es usted corredor, senderista, traileur o simplemente le gusta pasear por parques arbolados y escoriales, participe en la carrera Polonia."
        ],
        "nl": [
          "Als je een hardloper, wandelaar, traileur of gewoon een liefhebber van wandelen door beboste parken en terrils bent, doe dan mee aan de Polonia Run."
        ]
      },
