      "dc:description": {
        "de": [
          "Beispiel der Picardischen Flamboyant-Gotik, bemerkenswert wegen des Reichtums an Dekor und Formen der Gewölbeschlüssel, die manchmal über 1,20 m überragen."
        ],
        "en": [
          "Example of the Picardy flamboyant Gothic, remarkable for the richness of the decoration and the shapes of the keystones, sometimes exceeding 1m20."
        ],
        "it": [
          "Un esempio di stile gotico fiammeggiante piceno, notevole per la ricchezza della decorazione e le forme delle chiavi di volta, che talvolta superano 1m20."
        ],
        "fr": [
          "Exemple du gothique flamboyant Picard, remarquable pour la richesse du décor et des formes des clés de voûtes, dépassant parfois plus de 1m20."
        ],
        "es": [
          "Un ejemplo del estilo gótico flamígero de Picard, notable por la riqueza de la decoración y las formas de las claves, que a veces superan 1m20."
        ],
        "nl": [
          "Een voorbeeld van de Picardische flamboyante gotische stijl, opmerkelijk door de rijkdom van de versiering en de vormen van de sluitstenen, soms meer dan 1m20."
        ]
      },
