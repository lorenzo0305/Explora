  "rdfs:comment": {
    "de": [
      "Sie ist ein wunderbares Beispiel für die Flamboyant-Gotik. Sie hat ein wunderschönes geschnitztes Portal und reich verzierte Gewölbe."
    ],
    "en": [
      "It is a magnificent example of the Flamboyant Gothic style. It has a superb carved portal and richly decorated vaults."
    ],
    "it": [
      "È un magnifico esempio di stile gotico fiammeggiante. Ha un bel portale intagliato e volte riccamente decorate."
    ],
    "fr": [
      "C'est un magnifique exemple des style gothique flamboyant. Elle présente un superbe portail sculpté et des voûtes richement décorées."
    ],
    "nl": [
      "Het is een prachtig voorbeeld van de flamboyante gotische stijl. Het heeft een prachtig gebeeldhouwd portaal en rijk versierde gewelven."
    ],
    "es": [
      "Es un magnífico ejemplo del estilo gótico flamígero. Tiene un hermoso portal tallado y bóvedas ricamente decoradas."
    ]
  },
