  "COVID19SpecialMeasures": {
    "de": [
      "Entdecken Sie einen Raum, der der Entspannung und der Schönheit gewidmet ist. Genießen Sie Behandlungen und Produkte auf der Basis von Pflanzen und ätherischen Ölen, die von einem Team anerkannter Fachleute verwöhnt werden."
    ],
    "en": [
      "Discover a space dedicated to relaxation and beauty. Enjoy treatments and products based on plants and essential oils, pampered by a team of renowned professionals."
    ],
    "it": [
      "Scoprite uno spazio dedicato al relax e alla bellezza. Godetevi i trattamenti e i prodotti a base di piante e oli essenziali, coccolati da un team di professionisti rinomati."
    ],
    "fr": [
      "Découvrez un espace dédié à la relaxation et à la beauté. Vous apprécierez des soins et des produits à base de plantes et d’huiles essentielles, choyé par une équipe de professionnels reconnus."
    ],
    "nl": [
      "Ontdek een ruimte gewijd aan ontspanning en schoonheid. Geniet van behandelingen en producten op basis van planten en essentiële oliën, verwend door een team van gerenommeerde professionals."
    ],
    "es": [
      "Descubra un espacio dedicado a la relajación y la belleza. Disfrute de tratamientos y productos a base de plantas y aceites esenciales, mimados por un equipo de profesionales de renombre."
    ]
  },
