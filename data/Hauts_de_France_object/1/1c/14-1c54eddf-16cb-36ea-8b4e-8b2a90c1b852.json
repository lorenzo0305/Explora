      "dc:description": {
        "de": [
          "-Offene Türen von 19.00 bis 23.00 Uhr ? Kostenlos für alle\n09. Mai 2026 - Europäische Nacht der Kathedralen\n23. Mai 2026 - Europäische Nacht der Museen\nEin originelles Programm ermöglicht es jedem, die ständigen Sammlungen, die Ausstellungen, das Grafenschloss und die Maßnahme La classe l'uvre (neu) zu entdecken!"
        ],
        "en": [
          "-Open house from 7pm to 11pm ? Free for all\nmay 09, 2026 - European Cathedral Night\nmay 23, 2026 - European Museum Night\nAn original program will enable everyone to (re)discover the permanent collections, the exhibitions, the château comtal, and the \"La classe l? uvre!"
        ],
        "it": [
          "-Apertura dalle 19.00 alle 23.00? Gratuito per tutti\n09 maggio 2026 - Notte europea delle cattedrali\n23 maggio 2026 - Notte europea dei musei\nUn programma originale permetterà a tutti di (ri)scoprire le collezioni permanenti, le mostre, lo Château Comtal e \"La classe l? uvre!"
        ],
        "fr": [
          "-Portes ouvertes de 19h00 à 23h00 – Gratuit pour tous\n09 Mai 2026 - Nuit européenne des Cathédrales\n23 Mai 2026 - Nuit européenne des Musées \nUne programmation originale permettra à chacun de (re)découvrir les collections permanentes, les expositions, le château comtal, et le dispositif La classe l’œuvre !"
        ],
        "nl": [
          "-Open huis van 19.00 tot 23.00 uur ? Gratis voor iedereen\n09 mei 2026 - Europese kathedraalnacht\n23 mei 2026 - Europese Nacht van het Museum\nEen origineel programma zal iedereen in staat stellen om de permanente collecties, de tentoonstellingen, het Château Comtal en de \"La classe l? uvre!"
        ],
        "es": [
          "-Jornada de puertas abiertas de 19.00 a 23.00 horas ? Gratis para todos\n09 de mayo de 2026 - Noche Europea de las Catedrales\n23 de mayo de 2026 - Noche Europea de los Museos\nUn programa original permitirá a todos (re)descubrir las colecciones permanentes, las exposiciones, el Château Comtal y \"¡La classe l? uvre!"
        ]
      },
