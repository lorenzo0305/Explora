      "dc:description": {
        "de": [
          "Multisammlungsbörse: Spielzeug, Postkarten, Schallplatten, Bücher, Museen, Miniaturen, Briefmarken und alle anderen Sammlerobjekte\n50 Aussteller\nBar-Sandwiches\nPrivate und gewerbliche Aussteller"
        ],
        "en": [
          "Multi-collection fair: toys, postcards, records, books, corsets, miniatures, stamps and other collectibles\n50 exhibitors\nBar-Sandwiches\nIndividual and professional exhibitors"
        ],
        "it": [
          "Fiera multi collezionistica: giocattoli, cartoline, dischi, libri, corsetti, miniature, francobolli e tutti gli oggetti da collezione\n50 espositori\nBar-panini\nEspositori privati e professionali"
        ],
        "fr": [
          "Bourse multi-collections: jouets, cartes postales, disques, livres, muselets, miniatures, timbres et tout objet de collection\n50 exposants \nBar-Sandwiches\nExposants particuliers et professionnels"
        ],
        "nl": [
          "Multi-verzamelbeurs: speelgoed, ansichtkaarten, platen, boeken, korsetten, miniaturen, postzegels en alle verzamelobjecten\n50 exposanten\nBar-Sandwiches\nParticuliere en professionele exposanten"
        ],
        "es": [
          "Feria multicolección: juguetes, postales, discos, libros, corsés, miniaturas, sellos y todos los objetos de colección\n50 expositores\nBar-Sandwiches\nExpositores privados y profesionales"
        ]
