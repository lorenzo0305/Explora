  "rdfs:comment": {
    "de": [
      "An einem Abend lädt Sie das Team des 9-9bis dazu ein, alle musikalischen, theatralischen, denkmalpflegerischen und transversalen Angebote zu entdecken, die in diesem Halbjahr aufgenommen werden."
    ],
    "en": [
      "Over the course of an evening, the 9-9bis team invites you to discover the full range of musical, theatrical, heritage and cross-disciplinary events scheduled for this semester."
    ],
    "it": [
      "Nel corso di una serata, il team di 9-9bis vi invita a scoprire tutti gli eventi musicali, teatrali, patrimoniali e interdisciplinari che si svolgeranno nei prossimi sei mesi."
    ],
    "fr": [
      "Le temps d’une soirée, l’équipe du 9-9bis vous invite à découvrir l’ensemble des propositions musicales, théâtrales, patrimoniales et transversales qui seront accueillies ce semestre."
    ],
    "nl": [
      "Tijdens een avond nodigt het 9-9bis team je uit om alle muzikale, theatrale, erfgoed- en crossdisciplinaire evenementen te ontdekken die de komende zes maanden zullen plaatsvinden."
    ],
    "es": [
      "A lo largo de una velada, el equipo de 9-9bis le invita a descubrir todas las manifestaciones musicales, teatrales, patrimoniales e interdisciplinarias que tendrán lugar durante los próximos seis meses."
    ]
  },
  "rdfs:label": {
    "fr": [
