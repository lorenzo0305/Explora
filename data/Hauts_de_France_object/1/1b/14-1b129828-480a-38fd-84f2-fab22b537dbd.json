      "@id": "https://data.datatourisme.fr/3b873faf-c101-31c0-a881-09e94a168590",
      "dc:description": {
        "de": [
          "Das Centre Audrey Bartier organisiert einen Nachmittag mit Animation und Informationen für Familien in Wimereux.\n\nRDV um 16 Uhr\n\nWir erwarten Sie zahlreich."
        ],
        "en": [
          "The Centre Audrey Bartier is organizing an afternoon of entertainment and information for families in Wimereux.\n\nMeet at 4pm\n\nWe look forward to seeing many of you."
        ],
        "it": [
          "Il Centro Audrey Bartier organizza un pomeriggio di attività e informazioni per le famiglie di Wimereux.\n\nAppuntamento alle 16.00\n\nCi auguriamo di vedervi numerosi."
        ],
        "fr": [
          "Le Centre Audrey Bartier  organise une après-midi d'animation et d'information à destination des familles de Wimereux.\n\nRDV à 16h \n\nOn vous attend nombreux et nombreuse."
        ],
        "nl": [
          "Het Centre Audrey Bartier organiseert een activiteiten- en informatiemiddag voor gezinnen in Wimereux.\n\nBijeenkomst om 16 uur\n\nWe hopen velen van jullie daar te zien."
        ],
        "es": [
          "El Centro Audrey Bartier organiza una tarde de actividades e información para las familias de Wimereux.\n\nCita a las 16.00 h\n\nEsperamos ver a muchos de ustedes."
        ]
      },
