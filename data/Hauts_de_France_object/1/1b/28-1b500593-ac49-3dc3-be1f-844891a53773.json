  "rdfs:comment": {
    "de": [
      "Die Gemeinde Proville hat im Bois Chenu eine Arbeit zur Rückeroberung des Naturraums durchgeführt. Dieser Standort ist bemerkenswert, da er ein echtes Feuchtgebiet darstellt"
    ],
    "en": [
      "The municipality of Proville has carried out a work of reclaiming the natural space in the Bois Chenu. This site is remarkable, it constitutes a real wetland"
    ],
    "it": [
      "Il comune di Proville ha lavorato per recuperare l'area naturale del Bois Chenu. Si tratta di un sito notevole, una vera e propria zona umida"
    ],
    "fr": [
      "La commune de Proville a mené dans le Bois Chenu un travail de reconquête de l'espace naturel. Ce site est remarquable, il constitue une véritable zone humide"
    ],
    "es": [
      "El municipio de Proville trabaja para recuperar el espacio natural del Bois Chenu. Se trata de un lugar excepcional, un verdadero humedal"
    ],
    "nl": [
      "De gemeente Proville heeft werkzaamheden uitgevoerd om het natuurgebied van het Bois Chenu te herstellen. Dit is een opmerkelijke site, een echt moerasgebied"
    ]
  },
