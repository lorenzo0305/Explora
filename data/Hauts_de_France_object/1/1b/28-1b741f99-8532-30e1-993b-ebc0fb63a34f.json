  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Hotel Château Héloïse, in dem jedes Detail sorgfältig durchdacht und orchestriert ist, um unvergessliche Erinnerungen zu schaffen. Bestehend aus 14 luxuriösen Zimmern, einem\nprächtigen Park, Entspannungsräumen und Jacuzzi, gönnen Sie sich ein Erlebnis\nvöllig außerhalb der Zeit, das Charme, Unterhaltung und Natur miteinander verbindet."
    ],
    "en": [
      "Discover the Château Héloïse hotel, where every detail is carefully thought out and orchestrated to create unforgettable memories. With 14 luxury rooms, sumptuous grounds\npark, relaxation rooms and Jacuzzi, treat yourself to a completely\na timeless experience of charm, entertainment and nature."
    ],
    "it": [
      "Scoprite l'hotel Château Héloïse, dove ogni dettaglio è stato pensato e orchestrato con cura per creare ricordi indimenticabili. Con 14 camere di lusso, un parco sontuoso\nparco, sale relax e jacuzzi, regalatevi un'esperienza completamente\nun'esperienza che unisce fascino, divertimento e natura."
    ],
    "fr": [
      "Découvrez l'hôtel Château Héloïse, où chaque détail est soigneusement pensé et orchestré pour créer des souvenirs inoubliables. Composé de 14 chambres de luxe, d'un\nsomptueux parc, de salles de détente et de jacuzzi, offrez vous une expérience\ncomplètement hors du temps mêlant charme, divertissement et nature."
    ],
    "nl": [
      "Ontdek het Château Héloïse hotel, waar elk detail zorgvuldig is uitgedacht en georkestreerd om onvergetelijke herinneringen te creëren. Met 14 luxe kamers, een weelderig\npark, ontspanningsruimtes en jacuzzi, trakteer uzelf op een volledige\nervaring die charme, entertainment en natuur combineert."
    ],
    "es": [
      "Descubra el hotel Château Héloïse, donde cada detalle está cuidadosamente pensado y orquestado para crear recuerdos inolvidables. Con 14 habitaciones de lujo, suntuosos jardines\nparque, salas de relajación y jacuzzi, regálese una experiencia totalmente\nexperiencia que combina encanto, entretenimiento y naturaleza."
    ]
  },
