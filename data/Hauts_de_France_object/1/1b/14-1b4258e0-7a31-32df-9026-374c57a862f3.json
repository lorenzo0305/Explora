  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e7611c4c-286a-3e82-956d-9979fc3eac49",
      "dc:description": {
        "de": [
          "Der Food Truck des 7 vallées bietet Ihnen Fastfood: Hamburger, Sandwiches, Pommes frites, Kindermenü ... Diese ambulante Pommesbude fährt von Montag bis Sonntag in verschiedene Gemeinden der 7 Vallées und des Montreuillois."
        ],
        "en": [
          "The Food Truck des 7 vallées offers fast food: hamburgers, sandwiches, fries, children's menu... This mobile chip shop travels to different towns in the 7 valleys and Montreuillois from Monday to Sunday."
        ],
        "it": [
          "Il food truck delle 7 valli offre cibo veloce: hamburger, panini, patatine, menù per bambini... Questo negozio mobile di patatine fritte si reca in varie città delle 7 valli e del Montreuillois dal lunedì alla domenica."
        ],
        "fr": [
          "Le Food Truck des 7 vallées vous propose une restauration rapide : hamburgers, sandwichs, frites, menu enfant... Cette friterie ambulante se déplace dans différentes communes des 7 vallées et du Montreuillois du lundi au dimanche."
        ],
        "es": [
          "El food truck 7 valles ofrece comida rápida: hamburguesas, sándwiches, patatas fritas, menú infantil... Esta tienda móvil de patatas fritas recorre de lunes a domingo varias localidades de los 7 valles y la zona de Montreuillois."
        ],
        "nl": [
          "De 7 valleien food truck biedt fast food: hamburgers, broodjes, friet, kindermenu... Deze mobiele friettent reist van maandag tot zondag naar verschillende steden in de 7 valleien en de Montreuillois."
        ]
      },
