  "rdfs:comment": {
    "de": [
      "Zukünftige Akrobaten, Jongleure und Trapezkünstler, ob angehende oder bereits erfahrene, hier sind die Workshops, die wir für jeden von euch anbieten."
    ],
    "en": [
      "Future acrobats, jugglers and trapeze artists in the making or already experienced, here are the workshops we offer for each of you."
    ],
    "it": [
      "Aspiranti acrobati, giocolieri e trapezisti, che siate alle prime armi o che vi siate già fatti un nome, ecco i laboratori che proponiamo per ognuno di voi."
    ],
    "fr": [
      "Future acrobates, jongleurs et trapézistes en herbes ou déjà confirmés, voici pour chacun d’entre vous les ateliers que nous vous proposons."
    ],
    "es": [
      "Aspirantes a acróbatas, malabaristas y trapecistas, tanto si estáis empezando como si ya os habéis hecho un nombre, aquí tenéis los talleres que ofrecemos para cada uno de vosotros."
    ],
    "nl": [
      "Aspirant acrobaten, jongleurs en trapezeartiesten, of je nu net begint of al naam hebt gemaakt, hier zijn de workshops die we voor elk van jullie aanbieden."
    ]
