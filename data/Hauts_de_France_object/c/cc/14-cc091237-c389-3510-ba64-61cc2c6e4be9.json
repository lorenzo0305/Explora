  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6678704c-814a-3d1a-99b3-053e05da6425",
      "dc:description": {
        "de": [
          "Dieses Hotel liegt gegenüber dem Bahnhof von Béthune, nur wenige Gehminuten vom Stadtzentrum entfernt, und empfängt Sie in einer modernen Designumgebung. Die Zimmer sind einfach, aber geschmackvoll eingerichtet."
        ],
        "en": [
          "Located opposite the Béthune train station, just a few minutes' walk from the town center, this hotel welcomes you in a modern, designer setting. Rooms are simply but tastefully decorated."
        ],
        "it": [
          "Situato di fronte alla stazione ferroviaria di Béthune, a pochi minuti a piedi dal centro città, questo hotel vi accoglie in un ambiente moderno ed elegante. Le camere sono arredate in modo semplice ma con gusto."
        ],
        "fr": [
          "Situé, face à la gare de Béthune, à quelques minutes à pied du centre-ville, cet hôtel vous accueille dans un cadre moderne et design. Les chambres sont décorées simplement mais avec goût."
        ],
        "es": [
          "Situado frente a la estación de tren de Béthune, a pocos minutos a pie del centro de la ciudad, este hotel le da la bienvenida en un ambiente moderno y elegante. Las habitaciones están decoradas con sencillez y buen gusto."
        ],
        "nl": [
          "Dit hotel ligt tegenover het treinstation van Béthune, op slechts een paar minuten lopen van het stadscentrum, en verwelkomt je in een moderne en stijlvolle omgeving. De kamers zijn eenvoudig maar smaakvol ingericht."
        ]
      },
