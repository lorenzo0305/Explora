  "rdfs:comment": {
    "de": [
      "In einer grünen Umgebung bietet Ihnen Le Hututu von März bis Oktober die Möglichkeit, in seinem Gewässer Forellen zu angeln und auch vor Ort in seiner Brasserie zu essen."
    ],
    "en": [
      "In a green setting, the Hututu offers you trout fishing on its lake from March to October and also to eat in its brasserie."
    ],
    "it": [
      "Immerso nel verde, l'Hututu offre la possibilità di pescare trote nel suo laghetto da marzo a ottobre e di cenare in loco nella sua brasserie."
    ],
    "fr": [
      "Dans un cadre verdoyant, le Hututu vous propose de pêcher la truite sur son plan d'eau de mars à octobre et également de vous restaurer sur place dans sa brasserie."
    ],
    "nl": [
      "In een groene omgeving biedt de Hututu van maart tot oktober vissen op forel in zijn vijver en biedt ook een diner ter plaatse in zijn brasserie."
    ],
    "es": [
      "En un entorno verde, el Hututu ofrece pesca de truchas en su estanque de marzo a octubre y también ofrece cenas en su brasserie."
    ]
  },
  "rdfs:label": {
