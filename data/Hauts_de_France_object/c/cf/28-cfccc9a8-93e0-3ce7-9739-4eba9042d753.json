  "rdfs:comment": {
    "de": [
      "Der Polo Nations Cup wird vom 12. bis 27. Juni 2026 in einem Turnier mit 12 Toren zwischen Mannschaften aus der ganzen Welt ausgetragen:\nEin 12-Tore-Wettbewerb mit 10 Mannschaften und 5 Nationen, die für Eleganz und Sportlichkeit stehen, erwartet Sie für 10 Tage großen Sport!"
    ],
    "en": [
      "The Polo Nations Cup will pit teams from all over the world against each other in a 12-goal tournament from June 12 to 27, 2026:\nA 12-goal competition featuring 10 teams and 5 nations, a symbol of elegance and sportsmanship, awaits you for 10 days of great sport!"
    ],
    "it": [
      "La Polo Nations Cup metterà a confronto squadre di tutto il mondo in un torneo a 12 porte dal 12 al 27 giugno 2026:\nUna competizione a 12 goal che riunisce 10 squadre e 5 nazioni, simbolo di eleganza e sportività, vi aspetta per 10 giorni di grande sport!"
    ],
    "fr": [
      "La Polo Nations Cup opposera des équipes venues du monde entier au cours d'un tournoi à 12 buts du 12 au 27 juin 2026 : \nUne compétition 12 goals réunissant 10 équipes et 5 nations, symbole d’élégance et de sportivité, vous attendent pour 10 jours de grand sport !"
    ],
    "es": [
      "La Copa de Naciones de Polo enfrentará a equipos de todo el mundo en un torneo de 12 goles del 12 al 27 de junio de 2026:\nUna competición a 12 goles que reúne a 10 equipos y 5 naciones, símbolo de elegancia y deportividad, ¡te espera para 10 días de gran deporte!"
    ],
    "nl": [
      "De Polo Nations Cup zal teams van over de hele wereld tegen elkaar laten strijden in een toernooi met 12 doelpunten van 12 tot 27 juni 2026:\nEen wedstrijd met 12 doelpunten waaraan 10 teams en 5 landen deelnemen, een symbool van elegantie en sportiviteit, wacht op u voor 10 dagen topsport!"
    ]
  },
