  "rdfs:comment": {
    "de": [
      "Jahrhundert und ist eines der ältesten in Nordfrankreich. Es symbolisiert die kommunalen Freiheiten, die bereits 1202 erlangt wurden. Jeanne d'Arc verbrachte hier ihre Gefangenschaft und Ludwig XI. soll hier 1464 das Postedikt unterzeichnet haben."
    ],
    "en": [
      "Dating from the 14th century and one of the oldest in Northern France, it symbolizes the communal freedoms obtained as early as 1202. Joan of Arc was imprisoned here, and Louis XI is said to have signed the Edict of the Post Office in 1464."
    ],
    "it": [
      "Risalente al XIV secolo e uno dei più antichi del nord della Francia, simboleggia le libertà comunali ottenute già nel 1202. Qui fu imprigionata Giovanna d'Arco e si dice che Luigi XI abbia firmato qui l'Editto della Posta nel 1464."
    ],
    "fr": [
      "Datant du XIVème siècle et étant l'un des plus anciens du Nord de la France, il symbolise les libertés communales obtenues dès 1202. Jeanne d'Arc y passa lors de sa détention et Louis XI y aurait signé l'Édit des Postes en 1464."
    ],
    "nl": [
      "Het dateert uit de 14e eeuw en is een van de oudste in Noord-Frankrijk. Het symboliseert de gemeentelijke vrijheden die al in 1202 werden verkregen. Jeanne d'Arc zat hier gevangen en Lodewijk XI zou hier in 1464 het Edict van de Post hebben ondertekend."
    ],
    "es": [
      "Data del siglo XIV y es una de las más antiguas del norte de Francia. Simboliza las libertades comunales obtenidas ya en 1202. Juana de Arco fue encarcelada aquí, y se dice que Luis XI firmó aquí el Edicto de Correos en 1464."
    ]
  },
