  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/76e9f2e0-8a19-3063-a43c-f05fd0c23e78",
      "dc:description": {
        "de": [
          "Durchquerung von Le Touquet um 15:00/15:30 Uhr ? Ankunft über die Avenue du Général de Gaulle zur Avenue du Golf ? Avenue des Canadiens ? Kreisverkehr der Befreiung ? Rückfahrt zur Pont Rose über den Kreisverkehr des Museums.\nAnkunft in Etaples zwischen 16:30 und 16:45 Uhr auf dem Platz bis 19:00 Uhr zur Befreiung der Gemeinde Durchquerung von Camiers auf dem Rückweg"
        ],
        "en": [
          "Crossing Le Touquet around 3:00 pm / 3:30 pm ? arrival via avenue du Général de Gaulle to avenue du Golf ? avenue des Canadiens ? libération traffic circle ? return to pont rose via musée traffic circle.\nArrival in Etaples between 4.30pm and 4.45pm on the square until 7pm for the liberation of the town. Crossing of Camiers on the way back"
        ],
        "it": [
          "Attraversamento di Le Touquet verso le 15.00 / 15.30? Arrivo attraverso l'Avenue du Général de Gaulle fino all'Avenue du Golf? Avenue des Canadiens? Rotatoria della Liberazione? Ritorno a Pont Rose attraverso la rotatoria del Museo.\nArrivo a Etaples tra le 16.30 e le 16.45 in piazza fino alle 19.00 per la liberazione della città attraverso Camiers sulla via del ritorno"
        ],
        "fr": [
          "Traversée du Touquet vers 15h/15h30 – arrivée par l’avenue du Général de Gaulle vers l’avenue du Golf – avenue des Canadiens – rond-point de la libération – retour vers le pont rose par le rond-point du musée.\nArrivée à Etaples entre 16h30 et 16h45 sur la place jusque 19h pour la libération de la commun Traversée de Camiers au retour"
        ],
        "es": [
          "Travesía de Le Touquet hacia las 15h00 / 15h30 Llegada por la Avenue du Général de Gaulle hasta la Avenue du Golf ? Avenue des Canadiens ? rotonda de la Liberación ? regreso a Pont Rose por la rotonda del Museo.\nLlegada a Etaples entre las 16h30 y las 16h45 en la plaza hasta las 19h00 para la liberación de la ciudad por Camiers a la vuelta"
        ],
        "nl": [
          "Doorsteek Le Touquet rond 15.00 / 15.30 uur ? aankomst via Avenue du Général de Gaulle naar Avenue du Golf ? Avenue des Canadiens ? Liberation rotonde ? terugkeer naar Pont Rose via de Museum rotonde.\nAankomst in Etaples tussen 16.30 en 16.45 uur op het plein tot 19.00 uur voor de bevrijding van de stad via Camiers op de terugweg"
        ]
      },
