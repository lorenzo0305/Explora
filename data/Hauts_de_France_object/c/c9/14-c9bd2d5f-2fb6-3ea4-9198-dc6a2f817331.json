  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/14e99d00-53b8-3496-84ed-6311a70370fd",
      "dc:description": {
        "de": [
          "Schweinefleisch, Ziegenkäse, Quark oder Ziegenmilch;\nVerkauf vor Ort auf Reservierung und im Laden \"vert de terre\"."
        ],
        "en": [
          "Pork, goat's cheese, cottage cheese or goat's milk;\nOn-site sales on reservation and at the vert de terre store."
        ],
        "it": [
          "Carne di maiale, formaggio di capra, ricotta e latte di capra;\nVendita in loco su prenotazione e presso il negozio vert de terre."
        ],
        "fr": [
          "Porc, fromages de chèvre, fromage blanc ou lait de chèvre;\nVente sur place sur réservation et au magasin vert de terre."
        ],
        "nl": [
          "Varkensvlees, geitenkaas, kwark en geitenmelk;\nVerkoop ter plaatse op afspraak en in de winkel Vert de Terre."
        ],
        "es": [
          "Carne de cerdo, queso de cabra, requesón y leche de cabra;\nVenta in situ con cita previa y en la tienda vert de terre."
        ]
      },
