  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0948ca71-a7cb-3995-80ba-e594cc12dc54",
      "dc:description": {
        "de": [
          "Die Ferme du Coq aux Ânes ist ein pädagogischer Bauernhof in Zutkerque, im Herzen des Dreiecks Calais, Dünkirchen, Saint-Omer.\nEntdecken Sie mit uns die Tiere des Bauernhofs, beginnend mit dem Hahn und endend mit dem Esel!"
        ],
        "en": [
          "The Ferme du Coq aux Ânes is an educational farm located in Zutkerque, in the heart of the Calais, Dunkerque, Saint-Omer triangle.\nCome with us to discover the farm animals, starting with the Rooster and ending with the Donkey!"
        ],
        "it": [
          "La Ferme du Coq aux Ânes è una fattoria didattica situata a Zutkerque, nel cuore del triangolo Calais, Dunkerque, Saint-Omer.\nVenite a scoprire con noi gli animali della fattoria, a partire dal gallo fino all'asino!"
        ],
        "fr": [
          "La Ferme du Coq aux Ânes est une ferme pédagogique située à Zutkerque, au coeur du triangle Calais, Dunkerque, Saint-Omer.\nPartez avec nous à la découverte des animaux de la ferme, en commençant par le Coq pour finir par l’Âne !"
        ],
        "es": [
          "La Ferme du Coq aux Ânes es una granja educativa situada en Zutkerque, en el corazón del triángulo de Calais, Dunkerque y Saint-Omer.\nVenga a descubrir con nosotros los animales de la granja, ¡empezando por el Gallo y terminando por el Asno!"
        ],
        "nl": [
          "De Ferme du Coq aux Ânes is een educatieve boerderij gelegen in Zutkerque, in het hart van de driehoek Calais, Duinkerken en Saint-Omer.\nKom samen met ons de dieren van de boerderij ontdekken, van de haan tot de ezel!"
        ]
      },
      "@type": [
        "Description"
      ],
