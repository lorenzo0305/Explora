  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/197e5471-12f4-397a-af0b-355f0e6ca644",
      "dc:description": {
        "de": [
          "Das Kulturzentrum Camille Claudel umfasst eine Mediathek, ein Multimediazentrum, Ateliers für bildende Kunst, eine gemeindeübergreifende Musikschule, ein Theateratelier, Modern-Jazz-Tanzkurse und wechselnde Ausstellungen.\nEntdecken Sie!"
        ],
        "en": [
          "The Centre Culturel Camille Claudel includes a media library, multimedia center, visual arts workshops, intercommunal music school, theater workshop, modern jazz dance classes and temporary exhibitions.\nDiscover it for yourself!"
        ],
        "it": [
          "Il Centro culturale Camille Claudel ospita una mediateca, un centro multimediale, laboratori di arti visive, una scuola di musica intercomunale, un laboratorio teatrale, corsi di danza jazz moderna e mostre temporanee.\nScopritelo voi stessi!"
        ],
        "fr": [
          "Le Centre Culturel Camille Claudel regroupe une médiathèque, un pôle multimédia, des ateliers d'arts plastiques, une école de musique intercommunale, un atelier théâtre, des cours de danse Modern Jazz, des expositions temporaires.\nA découvrir!"
        ],
        "nl": [
          "Het Cultureel Centrum Camille Claudel huisvest een mediatheek, een multimediacentrum, workshops beeldende kunst, een intercommunale muziekschool, een theaterworkshop, moderne jazzdanslessen en tijdelijke tentoonstellingen.\nOntdek het zelf!"
        ],
        "es": [
          "El Centro Cultural Camille Claudel alberga una mediateca, un centro multimedia, talleres de artes visuales, una escuela de música intercomunal, un taller de teatro, clases de danza jazz moderna y exposiciones temporales.\nDescúbralo usted mismo"
        ]
      },
