  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/66045e0f-836c-3aca-b004-2ecfbd486fdd",
      "dc:description": {
        "de": [
          "Picknickbereich, der sich auf der Avenue Verte London-Paris an der Kreuzung mit der Trans'Oise zwischen Rainvillers und Auneuil befindet. Verschiedene Ausstattungen: 2 Picknicktische, 1 Bank und 2 Fahrradbügel."
        ],
        "en": [
          "Picnic area located on the Avenue Verte London-Paris at the intersection with the Trans'Oise between Rainvillers and Auneuil. Facilities: 2 picnic tables, 1 bench and 2 bicycle racks."
        ],
        "it": [
          "Area picnic situata sull'Avenue Verte London-Paris all'incrocio con la Trans'Oise tra Rainvillers e Auneuil. Servizi: 2 tavoli da picnic, 1 panchina e 2 rastrelliere per biciclette."
        ],
        "fr": [
          "Aire de pique-nique se situant sur l'Avenue Verte London-Paris à l'intersection avec la Trans'Oise entre Rainvillers et Auneuil. Divers équipement : 2 tables de pique-nique,  1 banc et 2 arceaux vélos."
        ],
        "es": [
          "Área de picnic situada en la Avenue Verte London-Paris en la intersección con la Trans'Oise entre Rainvillers y Auneuil. Instalaciones: 2 mesas de picnic, 1 banco y 2 aparcabicicletas."
        ],
        "nl": [
          "Picknickplaats gelegen aan de Avenue Verte London-Paris op de kruising met de Trans'Oise tussen Rainvillers en Auneuil. Voorzieningen: 2 picknicktafels, 1 bank en 2 fietsenrekken."
        ]
      },
