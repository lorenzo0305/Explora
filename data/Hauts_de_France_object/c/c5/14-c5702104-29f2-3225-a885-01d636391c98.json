      "dc:description": {
        "de": [
          "Der Parc Germinal bietet verschiedene Aktivitäten :\n- Eine grüne Umgebung, die ideal zum Entspannen ist\n- Ein Javelin-Club\n- Bouleplätze\n- Ein Empfangsraum"
        ],
        "en": [
          "Parc Germinal offers a wide range of activities:\n- A green setting ideal for relaxation\n- Javelin club\n- Boules courts\n- A reception hall"
        ],
        "it": [
          "Il Parc Germinal offre una serie di attività:\n- Un ambiente verde ideale per il relax\n- Club del giavellotto\n- Campi da bocce\n- Una sala di accoglienza"
        ],
        "fr": [
          "Le Parc Germinal offre diverses activités :\n- Un cadre verdoyant idéal pour la détente\n- Un club de Javelot\n- Des terrains de boules\n- Une salle de réception"
        ],
        "es": [
          "Parc Germinal ofrece diversas actividades:\n- Un entorno verde ideal para relajarse\n- Club de jabalina\n- Campos de petanca\n- Un salón de recepciones"
        ],
        "nl": [
          "Parc Germinal biedt een scala aan activiteiten:\n- Een groene omgeving ideaal voor ontspanning\n- Speerwerpen club\n- Jeu de boules banen\n- Een ontvangsthal"
        ]
      },
