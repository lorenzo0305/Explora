      "dc:description": {
        "de": [
          "Charmantes kleines Geschäft in der Nähe des Stadtzentrums von Boulogne sur Mer.<br> Hier finden Sie alle Spezialitäten aus Boulogne, die von leidenschaftlichen Produzenten stammen..."
        ],
        "en": [
          "Charming little store located 2 steps from Boulogne sur Mer town center.<br>You'll find all the Boulonnais specialties from passionate producers..."
        ],
        "it": [
          "Piccolo negozio di charme situato a soli 2 minuti dal centro di Boulogne sur Mer, dove troverete tutte le specialità di Boulogne di produttori appassionati..."
        ],
        "fr": [
          "Charmante petite boutique située à 2 pas du centre ville de Boulogne sur Mer.<br>Vous y trouverez toutes les spécialités boulonnaises venues de producteurs passionnés..."
        ],
        "es": [
          "Pequeña tienda con encanto situada a 2 minutos del centro de Boulogne sur Mer, donde encontrará todas las especialidades de Boulogne de productores apasionados..."
        ],
        "nl": [
          "Charmant winkeltje op slechts 2 minuten van het centrum van Boulogne sur Mer, waar u alle specialiteiten van Boulogne van gepassioneerde producenten..."
        ]
