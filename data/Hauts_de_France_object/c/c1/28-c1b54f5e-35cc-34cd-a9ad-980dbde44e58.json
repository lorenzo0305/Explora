  "rdfs:comment": {
    "de": [
      "Kino ganzjährig 7 Tage die Woche von 10:00 bis 23:00 Uhr geöffnet, auch an Feiertagen.\n\nBehindertengerechter Zugang / Kostenloser Parkplatz 650 Plätze\n\nAlle unsere Kinosäle sind mit digitalen Projektoren ausgestattet."
    ],
    "en": [
      "Cinema open 7 days a week all year round from 10am to 11pm, including public holidays.\n\nDisabled access / Free parking 650 spaces\n\nAll our rooms are equipped with digital projectors."
    ],
    "it": [
      "Cinema aperto 7 giorni su 7 tutto l'anno dalle 10 alle 23, compresi i giorni festivi.\n\nAccesso per disabili / Parcheggio gratuito 650 posti\n\nTutti i nostri cinema sono dotati di proiettori digitali."
    ],
    "fr": [
      "Cinéma ouvert 7j/7 toute l'année de 10h à 23h, y compris jours fériés.\n\nAccès handicapés / Parking gratuit 650 places \n\nToutes nos salles sont équipées en projecteurs numériques."
    ],
    "es": [
      "Cine abierto los 7 días de la semana, de 10 a 23 horas, incluidos los días festivos.\n\nAcceso para discapacitados / Aparcamiento gratuito 650 plazas\n\nTodas nuestras salas están equipadas con proyectores digitales."
    ],
    "nl": [
      "Bioscoop het hele jaar door 7 dagen per week geopend van 10.00 tot 23.00 uur, inclusief feestdagen.\n\nToegang voor gehandicapten / Gratis parkeren 650 plaatsen\n\nAl onze bioscopen zijn uitgerust met digitale projectoren."
    ]
  },
