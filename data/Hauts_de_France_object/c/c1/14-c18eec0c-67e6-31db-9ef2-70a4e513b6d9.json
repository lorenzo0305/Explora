  "rdfs:comment": {
    "de": [
      "Die Aufführung findet im Rahmen des Festivals Qu'est-ce-qu'on fabrique en famille? #9.\nWas wäre, wenn man sich die Fähigkeit, seine eigene Sprache zu schmieden und sie immer wieder neu zu erfinden, ein Leben lang bewahren könnte?"
    ],
    "en": [
      "Show programmed as part of the Festival Qu'est-ce-qu'on fabrique en famille? #9.\nWhat if we could keep this ability to forge our own language, to constantly reinvent it, for the rest of our lives?"
    ],
    "it": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #9.\nE se potessimo conservare questa capacità di forgiare il nostro linguaggio, di reinventarlo costantemente, per il resto della nostra vita?"
    ],
    "fr": [
      "Spectacle programmé dans le cadre du Festival Qu'est-ce-qu'on fabrique en famille ? #9.\nEt si on pouvait garder toute la vie cette capacité à forger sa propre langue, à la réinventer sans cesse ?"
    ],
    "es": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #9.\n¿Y si pudiéramos conservar esta capacidad de forjar nuestro propio lenguaje, de reinventarlo constantemente, durante el resto de nuestras vidas?"
    ],
    "nl": [
      "Onderdeel van het Festival Qu'est-ce-qu'on fabrique en famille? #9.\nWat als we dit vermogen om onze eigen taal te smeden, voortdurend opnieuw uit te vinden, voor de rest van ons leven zouden kunnen behouden?"
    ]
  },
