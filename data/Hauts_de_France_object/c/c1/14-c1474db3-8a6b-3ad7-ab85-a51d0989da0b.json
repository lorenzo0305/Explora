  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/503af8a1-723e-3578-9ac9-e9c55eb8f6d9",
      "dc:description": {
        "de": [
          "\"LA CAZE\" lädt Sie zu einem Tapetenwechsel für die Dauer eines Mittagessens oder eines Aperitifs mit Abendessen in einer kreolischen Umgebung auf La Réunion ein, begleitet von den Klängen von Zouk und Maloya."
        ],
        "en": [
          "\"LA CAZE\" invites you to a change of scenery during a lunch, a dinner aperitif, in a Creole Reunionese setting to the sound of Zouk and Maloya."
        ],
        "it": [
          "\"LA CAZE\" vi invita a cambiare scenario per un pranzo o un aperitivo in un ambiente creolo a Reunion, al suono di Zouk e Maloya."
        ],
        "fr": [
          "\"LA CAZE\" vous invite à un dépaysement  le temps d'un déjeuner,  d'un apéritif dînatoire, dans un cadre créole réunionnais au son du Zouk et du Maloya."
        ],
        "nl": [
          "\"LA CAZE\" nodigt u uit voor een lunch of een aperitief in een Creools kader in Réunion, op de klanken van Zouk en Maloya."
        ],
        "es": [
          "\"LA CAZE\" le invita a un cambio de aires para un almuerzo o un aperitivo en un entorno criollo de La Reunión, al son del Zouk y la Maloya."
        ]
      },
      "@type": [
        "Description"
