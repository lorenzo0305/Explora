  "rdfs:comment": {
    "de": [
      "Das Belvacus Restaurant empfängt Sie im Herzen des historischen Zentrums und bietet Ihnen eine bistronomische Küche, die Saisonalität und lokale Produkte miteinander verbindet.\n\nAnzahl der Gedecke : 59 Gedecke\nEmpfang von Gruppen: 100 Personen\nLetzter Service: 13:45 Uhr und 21:30 Uhr"
    ],
    "en": [
      "The Belvacus Restaurant welcomes you to the heart of the historic center for bistronomic cuisine combining seasonal and local produce.\n\nNumber of seats: 59\nGroups: 100 people\nLast services: 1:45pm and 9:30pm"
    ],
    "it": [
      "Il ristorante Belvacus vi accoglie nel cuore del centro storico per una cucina bistronomica che combina prodotti stagionali e locali.\n\nNumero di coperti: 59 coperti\nGruppi: 100 persone\nUltimi servizi: 13:45 e 21:30"
    ],
    "fr": [
      "Le Belvacus Restaurant vous accueille au cœur du centre historique pour une cuisine bistronomique qui associe saisonnalité et produits locaux.\n\nNombre de couverts : 59 couverts\nAccueil groupes : 100 personnes \nDerniers services : 13h45 et 21h30"
    ],
    "nl": [
      "Restaurant Belvacus verwelkomt je in het hart van het historische centrum voor een bistronomische keuken met seizoensgebonden en lokale producten.\n\nAantal couverts: 59 couverts\nGroepen: 100 personen\nLaatste diensten: 13.45 uur en 21.30 uur"
    ],
    "es": [
      "El restaurante Belvacus le recibe en pleno centro histórico para ofrecerle una cocina bistronómica que combina productos de temporada y locales.\n\nNúmero de cubiertos: 59 cubiertos\nGrupos: 100 personas\nÚltimos servicios: 13:45 y 21:30"
    ]
  },
