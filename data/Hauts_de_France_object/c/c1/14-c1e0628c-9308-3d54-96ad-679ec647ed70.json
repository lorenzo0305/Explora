  "rdfs:comment": {
    "de": [
      "Das zwischen Calais und Saint-Omer gelegene Relais des Attaques ist viel mehr als nur ein Restaurant. Es ist eine echte Einladung zur Entdeckung der lokalen Geschmäcker in einer warmen und freundlichen Atmosphäre."
    ],
    "en": [
      "Located between Calais and Saint-Omer, the Relais des Attaques is much more than just a restaurant. It's a real invitation to discover local flavors, in a warm and friendly atmosphere."
    ],
    "it": [
      "Situato tra Calais e Saint-Omer, il Relais des Attaques è molto più di un semplice ristorante. È un vero e proprio invito a scoprire i sapori locali, in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Situé entre Calais et Saint-Omer, le Relais des Attaques est bien plus qu'un simple restaurant. C'est une véritable invitation à la découverte des saveurs locales, dans une ambiance chaleureuse et conviviale."
    ],
    "es": [
      "Situado entre Calais y Saint-Omer, el Relais des Attaques es mucho más que un restaurante. Es una auténtica invitación a descubrir los sabores locales, en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Relais des Attaques ligt tussen Calais en Saint-Omer en is veel meer dan een restaurant. Het is een echte uitnodiging om lokale smaken te ontdekken, in een warme en vriendelijke sfeer."
    ]
  },
