  "rdfs:comment": {
    "de": [
      "Als Familienunternehmen im Herzen der Region Avesnois bietet das Unternehmen Contesse eine breite Palette an Produkten auf der Grundlage seiner Hauptfrucht, dem Apfel, an."
    ],
    "en": [
      "A family business located in the heart of the Avesnois region, Contesse offers a wide range of products based on its flagship fruit: the apple."
    ],
    "it": [
      "Azienda familiare situata nel cuore della regione dell'Avesnois, Contesse offre un'ampia gamma di prodotti basati sul suo frutto di punta: la mela."
    ],
    "fr": [
      "Entreprise familiale située au coeur de l’Avesnois, les établissements Contesse proposent une large gamme de produits à base de leur fruit phare : la pomme."
    ],
    "es": [
      "Empresa familiar situada en el corazón de la región de Avesnois, Contesse ofrece una amplia gama de productos basados en su fruta estrella: la manzana."
    ],
    "nl": [
      "Contesse is een familiebedrijf in het hart van de Avesnois-streek dat een breed assortiment producten aanbiedt op basis van zijn paradepaardje: de appel."
    ]
