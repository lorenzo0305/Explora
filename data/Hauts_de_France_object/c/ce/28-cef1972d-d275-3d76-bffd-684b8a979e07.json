  "rdfs:comment": {
    "de": [
      "Geschmack des Mittelmeers: Spanien, Provinz, Italien, Griechenland...\nTapas, Mezze, Antipasti, Pasta, kretische Küche stehen mittags, abends und bis spät in die Nacht auf der Speisekarte.\nTapas-Restaurant / Osteria / Weinbar.\nWeine von Erzeugern, AOC-Produkte und Direktimporte, Cocktails mit oder ohne Alkohol.\nZahlreiche Themenabende, Einführung in Salsa, Tango und südamerikanische Musik.\nDestination Soleil"
    ],
    "en": [
      "Flavours of the Mediterranean: Spain, Province, Italy, Greece...\nTapas, mezze, antipasti, pasta, Cretan cuisine are on the menu, at lunch, in the evening and until late at night.\nTapas restaurant / osteria / wine bar.\nWines from producers, AOC and direct import products, cocktails with or without alcohol.\nNumerous theme evenings, initiation to salsa, tango, South American music.\nDestination Soleil"
    ],
    "it": [
      "Sapori del Mediterraneo: Spagna, provincia, Italia, Grecia...\nTapas, mezze, antipasti, pasta, cucina cretese sono nel menu, a pranzo, la sera e fino a tarda notte.\nRistorante di tapas / Osteria / Wine bar.\nVini di produttori, prodotti AOC e importazioni dirette, cocktail con o senza alcol.\nNumerose serate a tema, introduzione alla salsa, al tango e alla musica sudamericana.\nDestinazione Soleil"
    ],
    "fr": [
      "Saveurs de la Méditerrannée : Espagne, Province, Italie, Grèce...\nTapas, mezze, antipasti, pasta, cuisine crétoise sont au menu, le midi, le soir et jusque tard dans la nuit.\nRestaurant tapas / osteria / Bar à vins.\nVins de producteurs, produits AOC et import direct, cocktails avec ou sans alcool.\nNombreuses soirées à thème, initiation à la salsa, au tango, aux musiques sud-américaines.\nDestination Soleil"
    ],
    "nl": [
      "Smaken van de Middellandse Zee: Spanje, Provincie, Italië, Griekenland...\nTapas, mezze, antipasti, pasta, Kretenzische gerechten staan op het menu, 's middags, 's avonds en tot laat in de avond.\nTapas restaurant / osteria / wijnbar.\nWijnen van producenten, AOC-producten en rechtstreekse invoer, cocktails met of zonder alcohol.\nTalrijke thema-avonden, kennismaking met salsa, tango en Zuid-Amerikaanse muziek.\nBestemming Soleil"
    ],
    "es": [
      "Sabores del Mediterráneo: España, Provincia, Italia, Grecia...\nTapas, mezze, antipasti, pasta, cocina cretense están en el menú, al mediodía, por la tarde y hasta altas horas de la noche.\nRestaurante de tapas / Osteria / Bar de vinos.\nVinos de productores, productos AOC e importaciones directas, cócteles con o sin alcohol.\nNumerosas veladas temáticas, introducción a la salsa, el tango y la música sudamericana.\nDestino Soleil"
    ]
  },
