  "rdfs:comment": {
    "de": [
      "Die Auberge du Bon Fermier, ein Juwel aus dem 16. Jahrhundert in Valenciennes, bietet ein authentisches Gourmet-Erlebnis zwischen Geschichte, Bodenständigkeit und der Wärme vergangener Zeiten."
    ],
    "en": [
      "The Auberge du Bon Fermier, a 16th-century gem in Valenciennes, offers an authentic gourmet experience combining history, terroir and the warmth of yesteryear."
    ],
    "it": [
      "L'Auberge du Bon Fermier, gioiello del XVI secolo a Valenciennes, offre un'autentica esperienza gastronomica che unisce storia, prodotti locali e il calore di un tempo."
    ],
    "fr": [
      "L’Auberge du Bon Fermier, joyau du 16e siècle à Valenciennes, offre une expérience gourmande et authentique entre histoire, terroir et chaleur d’antan."
    ],
    "es": [
      "El Auberge du Bon Fermier, una joya del siglo XVI en Valenciennes, ofrece una auténtica experiencia gastronómica que combina historia, productos locales y el calor de antaño."
    ],
    "nl": [
      "De Auberge du Bon Fermier, een 16e-eeuws juweeltje in Valenciennes, biedt een authentieke gastronomische ervaring die geschiedenis, lokale producten en de warmte van weleer combineert."
    ]
  },
