  "rdfs:comment": {
    "de": [
      "An einem Abend enthüllt das Team von 9-9bis die musikalischen, theatralischen und kulturellen Angebote und natürlich die neun Höhepunkte, die uns dieses Jahr zusammenbringen werden."
    ],
    "en": [
      "Over the course of an evening, the 9-9bis team reveals the musical, theatrical and heritage offerings, not forgetting of course the nine highlights that will bring us together this year."
    ],
    "it": [
      "Nel corso di una serata, il team di 9-9bis svelerà le offerte musicali, teatrali e patrimoniali, senza dimenticare naturalmente i nove punti salienti che ci riuniranno quest'anno."
    ],
    "fr": [
      "Le temps d’une soirée, l’équipe du 9-9bis vous révèle les propositions musicales, théâtrales, patrimoniales, sans oublier bien sûr les neuf temps forts qui nous rassembleront cette année."
    ],
    "nl": [
      "Tijdens een avond onthult het 9-9bis team het muzikale, theatrale en erfgoedaanbod, zonder natuurlijk de negen hoogtepunten te vergeten die ons dit jaar samenbrengen."
    ],
    "es": [
      "A lo largo de una velada, el equipo 9-9bis desvelará la oferta musical, teatral y patrimonial, sin olvidar, por supuesto, los nueve platos fuertes que nos reunirán este año."
    ]
  },
  "rdfs:label": {
    "fr": [
