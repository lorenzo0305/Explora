  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Un moment chez Bacchus\" legt bei der Zusammenstellung seiner Speisekarte Wert auf saisonale Produkte. Der Küchenchef arbeitet mit frischen Produkten aus dem kurzen Vertriebsweg."
    ],
    "en": [
      "The restaurant \"Un moment chez Bacchus\" favors seasonal products to compose its menu. The chef works with fresh products and in short circuit."
    ],
    "it": [
      "Il ristorante \"Un moment chez Bacchus\" privilegia i prodotti di stagione per comporre il suo menu. Lo chef lavora con prodotti freschi e cortocircuiti."
    ],
    "fr": [
      "Le restaurant «Un moment chez Bacchus» privilégie les produits de saison pour composer sa carte. Le chef travaille avec des produits frais et en circuit court."
    ],
    "nl": [
      "Het restaurant \"Un moment chez Bacchus\" geeft de voorkeur aan seizoensproducten om zijn menu samen te stellen. De chef werkt met verse producten en korte circuits."
    ],
    "es": [
      "El restaurante \"Un moment chez Bacchus\" privilegia los productos de temporada para componer su carta. El chef trabaja con productos frescos y circuitos cortos."
    ]
  },
