  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c313df59-2c5d-3fda-a23d-33f31b56497a",
      "dc:description": {
        "de": [
          "Dienstags in Cucq\nParkplatz Habitat Concept\n\nAm Mittwoch in Dominois\nIn der Nähe des städtischen Campingplatzes\n\nAm Donnerstag in Merlimont\nParkplatz der Apotheke\n\nAm Freitag in Groffliers\nGegenüber dem Rathaus\n\nAm Samstag in Verton\n8 all. Les Allées\n\nFoto: La Mezz'Ora"
        ],
        "en": [
          "Tuesdays in Cucq\nHabitat Concept parking lot\n\nWednesday in Dominois\nNear the municipal campsite\n\nThursday, Merlimont\nPharmacy parking lot\n\nFridays in Groffliers\nOpposite the town hall\n\nSaturday in Verton\n8 all. Les Allées\n\nPhoto : La Mezz'Ora"
        ],
        "it": [
          "Martedì al Cucq\nParcheggio Habitat Concept\n\nMercoledì a Dominois\nVicino al campeggio comunale\n\nGiovedì a Merlimont\nParcheggio della farmacia\n\nVenerdì a Groffliers\nDi fronte al Municipio\n\nSabato a Verton\n8 tutti. Le vie del paese\n\nFoto : La Mezz'Ora"
        ],
        "fr": [
          "Le mardi à Cucq\nParking Habitat Concept\n\nLe mercredi à Dominois\nPrès du camping municipal\n\nLe jeudi à Merlimont\nParking de la pharmacie\n\nLe vendredi à Groffliers\nFace à la Mairie\n\nLe samedi à Verton\n8 all. Les Allées\n\nPhoto : La Mezz'Ora"
        ],
        "es": [
          "Los martes en el Cucq\nAparcamiento Habitat Concept\n\nMiércoles en Dominois\nCerca del camping municipal\n\nJueves en Merlimont\nAparcamiento de la farmacia\n\nViernes en Groffliers\nFrente al Ayuntamiento\n\nSábado en Verton\n8 todos. Les Allées\n\nFoto : La Mezz'Ora"
        ],
        "nl": [
          "Dinsdag bij Cucq\nParkeergarage Habitat Concept\n\nWoensdag bij Dominois\nBij de gemeentelijke camping\n\nDonderdag in Merlimont\nParking apotheek\n\nVrijdag bij Groffliers\nTegenover het stadhuis\n\nZaterdag bij Verton\n8 allen. Les Allées\n\nFoto : La Mezz'Ora"
        ]
      },
