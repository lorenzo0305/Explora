  "rdfs:comment": {
    "de": [
      "Im Café Augustin finden Sie kleine Freuden, Geschichten, geteilte Momente, herzerwärmende, schöne und gute Gerichte, die nach dem Echten schmecken."
    ],
    "en": [
      "At Café Augustin you'll find small pleasures, stories, shared moments, comforting dishes that are beautiful, good and taste like the real thing."
    ],
    "it": [
      "Al Café Augustin troverete piccoli piaceri, storie, momenti condivisi, piatti confortanti, belli, buoni e dal sapore autentico."
    ],
    "fr": [
      "Au Café Augustin vous trouvez les petits plaisirs, les histoires, les moments partagés, les plats réconfortants, beaux, bons, qui ont le gout du vrai."
    ],
    "es": [
      "En el Café Augustin encontrará pequeños placeres, historias, momentos compartidos, platos reconfortantes que son bonitos, buenos y saben a verdad."
    ],
    "nl": [
      "Bij Café Augustin vind je kleine geneugten, verhalen, gedeelde momenten, troostrijke gerechten die mooi en goed zijn en smaken naar het echte werk."
    ]
  },
