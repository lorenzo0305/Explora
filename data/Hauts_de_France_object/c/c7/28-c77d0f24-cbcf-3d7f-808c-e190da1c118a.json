  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/76181e66-aff4-3aee-be78-e8bb7649460d",
      "dc:description": {
        "de": [
          "Das Kino in Vervins mit dem Namen Piccoli Piccolo empfängt Sie donnerstags, freitags, samstags und sonntags.\nEs gibt einen Saal mit 144 Sitzen und Zugang für Menschen mit eingeschränkter Mobilität."
        ],
        "en": [
          "The Cinema of Vervins called Piccoli Piccolo welcomes you on Thursday, Friday, Saturday and Sunday.\nA room with 144 seats awaits you as well as access for people with reduced mobility."
        ],
        "it": [
          "Il cinema di Vervins Piccoli Piccolo vi accoglie giovedì, venerdì, sabato e domenica.\nVi attende una sala da 144 posti e un accesso per le persone a mobilità ridotta."
        ],
        "fr": [
          "Le Cinéma de Vervins appelé Piccoli Piccolo vous accueille Les jeudi, Vendredi, Samedi et Dimanche.\nUne salle de 144 fauteuils vous attend ainsi que l’accès aux personnes à mobilité réduite."
        ],
        "es": [
          "El Cine de Vervins, llamado Piccoli Piccolo, le da la bienvenida el jueves, viernes, sábado y domingo.\nLe espera una sala con 144 plazas y acceso para personas con movilidad reducida."
        ],
        "nl": [
          "De bioscoop van Vervins genaamd Piccoli Piccolo verwelkomt u op donderdag, vrijdag, zaterdag en zondag.\nEen zaal met 144 plaatsen wacht op u, evenals de toegang voor personen met beperkte mobiliteit."
        ]
      },
