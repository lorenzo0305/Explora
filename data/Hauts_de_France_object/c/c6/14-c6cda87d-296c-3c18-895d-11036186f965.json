  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e5599ce4-3220-3fe9-83db-a4e404001826",
      "dc:description": {
        "de": [
          "Genießen Sie in der Nähe des Deiches eine einzigartige Umgebung mit einem Gewölbesaal aus Stein und einer Terrasse mit Meerblick."
        ],
        "en": [
          "Close to the sea wall, enjoy a unique setting with its vaulted stone room and terrace overlooking the sea."
        ],
        "it": [
          "Vicino al muro di cinta del mare, gode di un ambiente unico con la sua sala a volta in pietra e la sua terrazza con vista sul mare."
        ],
        "fr": [
          "A proximité de la digue, profitez d'un cadre unique avec sa salle voûtée en pierres et sa terrasse avec vue sur la mer."
        ],
        "nl": [
          "Dicht bij de zeemuur, geniet van een unieke omgeving met zijn gewelfde stenen kamer en terras met uitzicht op zee."
        ],
        "es": [
          "Cerca del dique, disfrute de un entorno único con su sala abovedada de piedra y su terraza con vistas al mar."
        ]
      },
