  "rdfs:comment": {
    "de": [
      "**Porträt mit Kohle!**\n------------------------\n\n**Erlernen Sie das Spiel mit Kontrasten und Volumen, indem Sie die ganze Palette der Kohletechniken in Verbindung mit dem Thema Porträt ausprobieren\n  \n? Frühjahrssession: Dienstag, 24/03, 31/03 und 7/04/2026"
    ],
    "en": [
      "**Charcoal portrait !\n------------------------\n\n**Discover the play of contrasts and volumes by experimenting with the full range of charcoal techniques associated with the theme of portraiture**\n  \n? Spring session: Tuesdays 03/24, 03/31 and 04/7/2026"
    ],
    "it": [
      "**Ritratto in carbone!\n------------------------\n\n**Scoprire il gioco dei contrasti e dei volumi sperimentando l'intera gamma di tecniche a carboncino associate al tema del ritratto**\n  \n? Sessione primaverile: martedì 24/03, 31/03 e 7/04/2026"
    ],
    "fr": [
      "**Portrait au fusain !**\n------------------------\n\n**Griser, estomper, évider… initiez-vous aux jeux des contrastes et des volumes en expérimentant toute la palette des techniques du fusain associée au thème du portrait.**  \n  \n→ Session de printemps : les mardis 24/03, 31/03 et 7/04/2026"
    ],
    "es": [
      "**¡Retrato al carbón!\n------------------------\n\n**Sombrear, difuminar, ahuecar... descubra el juego de contrastes y volúmenes experimentando toda la gama de técnicas del carboncillo asociadas al tema del retrato**\n  \n? Sesión de primavera: martes 24/03, 31/03 y 7/04/2026"
    ],
    "nl": [
      "**Koolportret !\n------------------------\n\n**Schaduwen, vervagen, uithollen? Ontdek het spel van contrasten en volumes door te experimenteren met alle houtskooltechnieken die bij het thema portret horen**\n  \n? Lentesessie: dinsdag 24/03, 31/03 en 7/04/2026"
    ]
  },
