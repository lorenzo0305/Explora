  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dee628a3-3466-3708-bb27-3aa73a8ff83d",
      "dc:description": {
        "de": [
          "Das Manoir Beach Ressort empfängt Sie für alle Ihre Veranstaltungen, Seminare, Hochzeiten, Betriebsräte, Taufen, Kommunionen, aber auch um mittags und abends zu essen und auch um ein Glas auf der Terrasse oder im Saal zu trinken."
        ],
        "en": [
          "Le Manoir Beach Ressort welcomes you for all your events: seminars, weddings, works councils, christenings, communions, as well as for lunch, dinner and a drink on the terrace or in the dining room."
        ],
        "it": [
          "Le Manoir Beach Ressort vi accoglie per tutti i vostri eventi, seminari, matrimoni, consigli di fabbrica, battesimi e comunioni, nonché per pranzi e cene e bevande sulla terrazza o nella sala da pranzo."
        ],
        "fr": [
          "Le Manoir Beach Ressort vous accueille pour tous vos événements, séminaire, mariage, comité d'entreprise, baptême, communion, mais aussi pour vous restaurer midi, soir et également boire un verre en terrasse ou en salle."
        ],
        "nl": [
          "Le Manoir Beach Ressort verwelkomt u voor al uw evenementen, seminars, bruiloften, ondernemingsraden, doopfeesten en communies, maar ook voor lunch en diner en drankjes op het terras of in de eetzaal."
        ],
        "es": [
          "Le Manoir Beach Ressort le da la bienvenida para todos sus eventos, seminarios, bodas, comités de empresa, bautizos y comuniones, así como para almuerzos y cenas y copas en la terraza o en el comedor."
        ]
      },
