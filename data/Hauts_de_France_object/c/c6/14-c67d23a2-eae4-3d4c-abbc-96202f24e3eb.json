  "rdfs:comment": {
    "de": [
      "In dieser 9. Ausgabe schlägt La Constellation Imaginaire vor, sich im öffentlichen Raum zu treffen, zu erzählen, teilzunehmen und sich um gemeinsame Herausforderungen zu versammeln!"
    ],
    "en": [
      "For this 9th edition, La Constellation Imaginaire invites you to gather in the public space, to tell your stories, to participate and to rally around common issues!"
    ],
    "it": [
      "Per questa nona edizione, La Constellation Imaginaire invita le persone a riunirsi nello spazio pubblico, a raccontare le loro storie, a partecipare e a riunirsi intorno a temi comuni!"
    ],
    "fr": [
      "Pour cette 9ème édition, La Constellation Imaginaire propose de se retrouver dans l'espace public, de se raconter, de participer et de se rassembler autour d'enjeux communs !"
    ],
    "nl": [
      "Voor deze 9e editie nodigt La Constellation Imaginaire mensen uit om samen te komen in de openbare ruimte, hun verhalen te vertellen, deel te nemen en zich te verenigen rond gemeenschappelijke thema's!"
    ],
    "es": [
      "Para esta 9ª edición, La Constellation Imaginaire invita a la gente a reunirse en el espacio público, a contar sus historias, a participar y a unirse en torno a temas comunes"
    ]
  },
