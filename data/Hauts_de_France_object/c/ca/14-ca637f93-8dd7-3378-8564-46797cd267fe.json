  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7ca942e4-ce62-37e0-8714-ed89132be36b",
      "dc:description": {
        "de": [
          "Werde für die Dauer eines spannenden Workshops zu einem echten Biologen. Beobachte und manipuliere Schädel aller Art, um herauszufinden, zu welchem Tier er gehörte und welche Nahrung er zu sich nahm."
        ],
        "en": [
          "Become a real biologist in this exciting workshop. Observe and manipulate skulls of all kinds to determine which animal it belonged to and what its diet was."
        ],
        "it": [
          "Diventate dei veri biologi in questo affascinante laboratorio. Osservate e maneggiate crani di ogni tipo per scoprire a quale animale apparteneva e qual era la sua dieta."
        ],
        "fr": [
          "Deviens un véritable biologiste le temps d’un atelier passionnant. Observe et manipule des crânes de tout genre pour déterminer à quel animal il appartenait et son régime alimentaire."
        ],
        "nl": [
          "Word een echte bioloog in deze fascinerende workshop. Observeer en hanteer schedels van allerlei soorten om erachter te komen van welk dier ze waren en wat hun dieet was."
        ],
        "es": [
          "Conviértete en un auténtico biólogo en este fascinante taller. Observa y manipula cráneos de todo tipo para averiguar a qué animal pertenecía y cuál era su dieta."
        ]
      },
      "@type": [
        "Description"
