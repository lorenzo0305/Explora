  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d989a129-5a4c-3f57-a165-fccccfce604e",
      "dc:description": {
        "de": [
          "\"La Saint-Gillet fait son cinéma!\", das am 25. und 26. August 2024 in Fruges stattfindet.\n\nProgramm :\n\n- Große Parade zur Hundertjahrfeier am 25. August um 15 Uhr\n- Kinoabend unter freiem Himmel am 25. August\n- Ausstellung von Fotos und Filmplakaten\n- Workshops für Kinder\n- Begegnungen mit Filmschaffenden."
        ],
        "en": [
          "\"La Saint-Gillet fait son cinéma!\" will take place on August 25 and 26, 2024 in Fruges.\n\nProgram :\n\n- Centenary parade on August 25 at 3pm\n- Open-air cinema evening on August 25\n- Exhibition of photos and movie posters\n- Workshops for children\n- Meetings with film professionals."
        ],
        "it": [
          "\"La Saint-Gillet fait son cinéma\", che si terrà il 25 e 26 agosto 2024 a Fruges.\n\nProgramma :\n\n- Sfilata del centenario il 25 agosto alle 15:00\n- Serata di cinema all'aperto il 25 agosto\n- Mostra di foto e manifesti cinematografici\n- Laboratori per bambini\n- Incontri con professionisti del cinema."
        ],
        "fr": [
          "\"La Saint-Gillet fait son cinéma !\" qui se déroulera les 25 et 26 août 2024 à Fruges.\n\nProgramme :\n\n- Grand défilé du centenaire le 25 août à 15h\n- Soirée cinéma en plein air le 25 août\n- Exposition de photos et d'affiches de cinéma\n- Ateliers pour enfants\n- Rencontres avec des professionnels du cinéma."
        ],
        "es": [
          "\"La Saint-Gillet fait son cinéma\", que tendrá lugar los días 25 y 26 de agosto de 2024 en Fruges.\n\nPrograma :\n\n- Desfile del centenario el 25 de agosto a las 15.00 horas\n- Noche de cine al aire libre el 25 de agosto\n- Exposición de fotos y carteles de cine\n- Talleres para niños\n- Encuentros con profesionales del cine"
        ],
        "nl": [
          "\"La Saint-Gillet fait son cinéma\", dat op 25 en 26 augustus 2024 in Fruges plaatsvindt.\n\nProgramma :\n\n- Eeuwfeestparade op 25 augustus om 15 uur\n- Bioscoopavond in openlucht op 25 augustus\n- Tentoonstelling van foto's en filmposters\n- Workshops voor kinderen\n- Ontmoetingen met bioscoopprofessionals."
        ]
      },
      "@type": [
        "Description"
      ],
