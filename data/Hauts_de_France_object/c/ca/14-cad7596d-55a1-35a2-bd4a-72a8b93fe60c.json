  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2ebc74a9-0406-3910-96e4-17f84a706849",
      "dc:description": {
        "de": [
          "Hausgemachte Gerichte aus frischen und saisonalen Produkten. Das Toc'Toque-Team bietet Ihnen ein komplettes Menü mit Vorspeise, Hauptgericht und Nachtisch für 13,90 € an, das zu Ihnen nach Hause oder an Ihren Arbeitsplatz geliefert wird."
        ],
        "en": [
          "Home-cooked meals made from fresh, seasonal produce. The Toc'Toque team offers you a complete formula Starter/Dish/Dessert at 13€90 delivered at your home or at your work."
        ],
        "it": [
          "Piatti fatti in casa con prodotti freschi e di stagione. Il team di Toc'Toque vi offre un menu completo di antipasto/portata principale/dessert a 13,90€ con consegna a casa o in ufficio."
        ],
        "fr": [
          "Des plats cuisinés maison à partir de produits frais et de saison. L’équipe Toc’Toque vous propose une formule complète Entrée /Plat/Dessert à 13€90 livré chez vous ou à votre travail."
        ],
        "es": [
          "Platos caseros con productos frescos y de temporada. El equipo de Toc'Toque te ofrece un menú completo de entrante/plato principal/postre por 13,90€ entregado en tu casa u oficina."
        ],
        "nl": [
          "Huisgemaakte gerechten van verse en seizoensgebonden producten. Het team van Toc'Toque biedt u een compleet voor-/hoofdgerecht/dessertmenu voor 13,90 euro dat bij u thuis of op kantoor wordt bezorgd."
        ]
      },
