  "rdfs:comment": {
    "de": [
      "Der Caterer, der Ihren Gaumen täglich mit Mittagessen, aber auch mit kleinen und großen Anlässen verwöhnt."
    ],
    "en": [
      "The caterer who delights your taste buds every day for your lunches but also for small and big occasions."
    ],
    "it": [
      "Il catering che cura il vostro palato ogni giorno per i vostri pranzi ma anche per le piccole e grandi occasioni."
    ],
    "fr": [
      "Le traiteur qui régale vos papilles au quotidien pour vos déjeuners mais aussi pour les petites et grandes occasions."
    ],
    "es": [
      "El servicio de catering que deleita su paladar todos los días para sus almuerzos, pero también para las pequeñas y grandes ocasiones."
    ],
    "nl": [
      "De traiteur die dagelijks uw smaakpapillen verwent voor uw lunches maar ook voor kleine en grote gelegenheden."
