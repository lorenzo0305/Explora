  "rdfs:comment": {
    "de": [
      "Im Rahmen des Next festival logo\n\nSeien auch Sie neugierig und folgen Sie drei schwer kranken Tonkünstlern bei ihrer wöchentlichen Gruppentherapie, die entfernt an ein Treffen der Anonymen Alkoholiker erinnert."
    ],
    "en": [
      "As part of the Next festival logo\n\nGet curious, too, and follow three sound freaks for their weekly group therapy, which vaguely resembles an Alcoholics Anonymous meeting."
    ],
    "it": [
      "Come parte del logo del festival Next\n\nIncuriositevi anche voi e seguite tre fanatici del suono nella loro terapia di gruppo settimanale, che assomiglia vagamente a una riunione degli Alcolisti Anonimi."
    ],
    "fr": [
      "Dans le cadre du Next festival logo \n\nSoyez curieux vous aussi et suivez trois grands malades de son pour leur thérapie de groupe hebdomadaire qui ressemble vaguement à une réunion des Alcooliques Anonymes."
    ],
    "es": [
      "Como parte del logotipo del festival Next\n\nPóngase también curioso y siga a tres locos del sonido en su terapia de grupo semanal, que recuerda vagamente a una reunión de Alcohólicos Anónimos."
    ],
    "nl": [
      "Als onderdeel van het Next festivallogo\n\nWord ook nieuwsgierig en volg drie geluidsfreaks voor hun wekelijkse groepstherapie, die vaag lijkt op een bijeenkomst van Alcoholics Anonymous."
    ]
  },
  "rdfs:label": {
