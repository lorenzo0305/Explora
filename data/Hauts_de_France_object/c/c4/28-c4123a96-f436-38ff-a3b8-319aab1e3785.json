  "rdfs:comment": {
    "de": [
      "Der im März 2009 anlässlich von Europe XXL eröffnete Gare Saint Sauveur, ein ehemaliger Güterbahnhof, wurde von der Stadt Lille saniert, um das ganze Jahr über kulturelle Veranstaltungen, Freizeitbereiche sowie ein Bar-Restaurant und einen saisonal belebten städtischen Bauernhof anzubieten."
    ],
    "en": [
      "Opened in March 2009 to coincide with Europe XXL, the Gare Saint Sauveur, formerly a goods station, has been refurbished by the City of Lille to offer year-round cultural events, leisure facilities, a bar-restaurant and a seasonally animated urban farm."
    ],
    "it": [
      "Inaugurata nel marzo 2009 in occasione di Europa XXL, la Gare Saint Sauveur, ex stazione merci, è stata ristrutturata dalla città di Lille per offrire eventi culturali e strutture per il tempo libero durante tutto l'anno, oltre a un bar-ristorante e a una fattoria urbana con attività stagionali."
    ],
    "fr": [
      "Ouverte en mars 2009 à l'occasion d'Europe XXL, la Gare Saint Sauveur, autrefois gare de marchandises, a été réhabilitée par la Ville de Lille pour proposer tout au long de l'année des événements culturels, des espaces de loisirs, ainsi qu'un bar restaurant et une ferme urbaine animée de façon saisonnière."
    ],
    "es": [
      "Inaugurada en marzo de 2009 con motivo de Europa XXL, la Gare Saint Sauveur, antigua estación de mercancías, ha sido renovada por el Ayuntamiento de Lille para ofrecer eventos culturales e instalaciones de ocio durante todo el año, así como un bar-restaurante y una granja urbana con actividades de temporada."
    ],
    "nl": [
      "Het Gare Saint Sauveur, vroeger een goederenstation, werd in maart 2009 geopend ter gelegenheid van Europa XXL en werd door de stad Lille gerenoveerd om het hele jaar door culturele evenementen en vrijetijdsvoorzieningen aan te bieden, evenals een bar-restaurant en een stadsboerderij met seizoensgebonden activiteiten."
    ]
  },
