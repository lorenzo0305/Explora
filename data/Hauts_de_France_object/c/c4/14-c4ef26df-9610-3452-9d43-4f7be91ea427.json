  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/06d50c9b-e88b-3069-9584-41751d79638b",
      "dc:description": {
        "de": [
          "Sonntag, 25. Mai 2025\n\n16:00 Uhr - Ravel-Saal - Kongresszentrum.\n\nDANY BOON\nBOON WIRD ES BESSER MACHEN!\n\nBoon wird es besser machen! Nach sieben Jahren abseits der Bühne und der verrückten Lust, andere zum Lachen zu bringen, kehrt Dany Boon mit einer brandneuen One-Man-Show zu seinem Kindheitstraum zurück."
        ],
        "en": [
          "Sunday, May 25, 2025\n\n4pm - Salle Ravel - Palais des Congrès.\n\nDANY BOON\nBOON WILL DO BETTER!\n\nBoon will do it better! After 7 years away from the stage, Dany Boon returns to his childhood dream with a brand new one-man show."
        ],
        "it": [
          "Domenica 25 maggio 2025\n\nore 16.00 - Salle Ravel - Palazzo dei Congressi.\n\nDANY BOON\nBOON FARÀ MEGLIO!\n\nBoon farà di meglio! Dopo 7 anni di assenza dal palcoscenico, Dany Boon torna al suo sogno d'infanzia con un nuovo one-man show."
        ],
        "fr": [
          "Dimanche 25 mai 2025\n\n16h - Salle Ravel - Palais des Congrès.\n\nDANY BOON\nBOON VA MIEUX FAIRE !\n\nBoon va mieux faire ! Après 7 ans loin de la scène et la folle envie de faire rire, Dany Boon revient à son rêve d’enfant avec un tout nouveau one man show."
        ],
        "nl": [
          "Zondag 25 mei 2025\n\n16.00 uur - Salle Ravel - Palais des Congrès.\n\nDANY BOON\nBOON ZAL HET BETER DOEN!\n\nBoon gaat het beter doen! Na 7 jaar afwezigheid van het podium, keert Dany Boon terug naar zijn jeugddroom met een gloednieuwe one-man show."
        ],
        "es": [
          "Domingo 25 de mayo de 2025\n\n16.00 h - Sala Ravel - Palacio de Congresos.\n\nDANY BOON\n¡BOON LO HARÁ MEJOR!\n\n¡Boon lo hará mejor! Tras 7 años alejado de los escenarios, Dany Boon retoma su sueño de la infancia con un nuevo espectáculo unipersonal."
        ]
      },
