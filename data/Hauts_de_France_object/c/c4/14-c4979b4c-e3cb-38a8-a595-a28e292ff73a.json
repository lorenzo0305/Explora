  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f99db14a-2984-39d1-a39b-161aa0459ac1",
      "dc:description": {
        "de": [
          "Rad- und Wandertouren\nSonntag, den 8. März 2026\nStart an der Zitadelle - Montreuil\n-------------------------\nOrganisiert vom Club Cyclo Montreuillois\n\n-Radtouren von 30, 56 und 80 km\n-V.T.T. 25, 43 und 52 km\nmit einem Start zwischen 7:30 und 9:00 Uhr\n\n-Wanderung von 10 km\nStart um 9 Uhr und ein Abschluss der Wanderung gegen 13 Uhr\n\nInformationen: cyclomontreuil@orange.fr oder telefonisch: 06 45 77 53 57\n\nKredit: Stadt Montreuil-sur-Mer"
        ],
        "en": [
          "Cycling and walking circuits\nSunday, March 8, 2026\nDeparture from La Citadelle - Montreuil\n-------------------------\nOrganized by Club Cyclo Montreuillois\n\n-Cyclo circuits of 30, 56 and 80km\n-Mountain bike 25, 43 and 52 km\ndeparting between 7:30 and 9 a.m\n\n-10 km walk\nStart at 9 a.m. and finish around 1 p.m\n\nInformation: cyclomontreuil@orange.fr or by telephone: 06 45 77 53 57\n\nCredit: Ville de Montreuil-sur-Mer"
        ],
        "it": [
          "Percorsi ciclistici e pedonali\nDomenica 8 marzo 2026\nPartenza dalla Citadelle - Montreuil\n-------------------------\nOrganizzato dal Club Cyclo Montreuillois\n\n-Circuiti ciclistici di 30, 56 e 80 km\n-Circuiti per mountain bike di 25, 43 e 52 km\npartenza tra le 7.30 e le 9.00\n\n-Camminata di 10 km\nInizia alle 9.00 e termina intorno alle 13.00\n\nInformazioni: cyclomontreuil@orange.fr o per telefono: 06 45 77 53 57\n\nCrediti: Città di Montreuil-sur-Mer"
        ],
        "fr": [
          "Circuits cyclo et marche\nDimanche 8 mars 2026\nDépart de la Citadelle - Montreuil\n-------------------------\nOrganisé par le Club Cyclo Montreuillois\n\n-Circuits cyclo de 30, 56 et 80km\n-V.T.T. 25, 43 et 52 km\navec un départ entre 7h30 et 9h\n\n-Marche de 10 km \nDépart à 9h et une clôture de la randonnée autour de 13h\n\nRenseignements : cyclomontreuil@orange.fr ou par téléphone : 06 45 77 53 57\n\nCrédit : Ville de Montreuil-sur-Mer"
        ],
        "es": [
          "Rutas en bicicleta y a pie\nDomingo 8 de marzo de 2026\nSalida de la Citadelle - Montreuil\n-------------------------\nOrganizado por el Club Cyclo Montreuillois\n\n-Circuitos ciclistas de 30, 56 y 80 km\n-Circuitos de bicicleta de montaña de 25, 43 y 52 km\nsalidas entre las 7h30 y las 9h00\n\n-10 km a pie\nSalida a las 9.00 h y llegada en torno a las 13.00 h\n\nInformación: cyclomontreuil@orange.fr o por teléfono: 06 45 77 53 57\n\nCrédito: Ayuntamiento de Montreuil-sur-Mer"
        ],
        "nl": [
          "Fiets- en wandelroutes\nZondag 8 maart 2026\nVertrek vanaf de Citadel - Montreuil\n-------------------------\nGeorganiseerd door Club Cyclo Montreuillois\n\n-Fietscircuits van 30, 56 en 80 km\n-Mountainbike circuits van 25, 43 en 52 km\nvertrek tussen 7.30 en 9.00 uur\n\n-10 km lopen\nStart om 9.00 uur en finish rond 13.00 uur\n\nInformatie: cyclomontreuil@orange.fr of telefonisch: 06 45 77 53 57\n\nKrediet: Gemeente Montreuil-sur-Mer"
        ]
      },
