  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ab829b3-9426-36d1-a820-cb1b711723b9",
      "dc:description": {
        "de": [
          "Tacos, Burger, Sandwiches, Paninis, indische Spezialitäten, salzige und süße Crêpes, Salate, Studenten- und Kindermenüs und vieles mehr erwarten Sie bei EatBuzz! In Ihrem Restaurant wartet eine Treuekarte auf Sie."
        ],
        "en": [
          "Tacos, burgers, sandwiches, paninis, Indian specialities, sweet and savoury crepes, salads, student and children's menus and much more await you at EatBuzz! A loyalty card awaits you in your restaurant."
        ],
        "it": [
          "Tacos, hamburger, panini, panini, specialità indiane, crepes dolci e salate, insalate, menu per studenti e bambini e molto altro ancora vi aspettano da EatBuzz! Una carta fedeltà vi aspetta al ristorante."
        ],
        "fr": [
          "Tacos, burgers, sandwichs, paninis, spécialités indiennes, crêpes salées, sucrées, salades, menus étudiants et enfants et bien d'autres vous attendent chez EatBuzz ! Une carte de fidélité vous attends dans votre restaurant."
        ],
        "es": [
          "Tacos, hamburguesas, sándwiches, paninis, especialidades indias, crepes dulces y saladas, ensaladas, menús para estudiantes y niños y mucho más te esperan en EatBuzz Una tarjeta de fidelidad le espera en su restaurante."
        ],
        "nl": [
          "Taco's, burgers, sandwiches, panini's, Indiase specialiteiten, zoete en hartige crêpes, salades, studenten- en kindermenu's en nog veel meer wachten op je bij EatBuzz! Een klantenkaart wacht op u in het restaurant."
        ]
      },
