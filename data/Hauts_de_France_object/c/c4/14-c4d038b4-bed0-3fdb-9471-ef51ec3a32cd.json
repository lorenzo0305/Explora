      "dc:description": {
        "de": [
          "Café, Bar, Tabakladen, PMU neben dem großen Platz von Etaples gelegen, freundliche Atmosphäre.\nSpielübertragungen und Abendveranstaltungen."
        ],
        "en": [
          "Café, bar, Tabac, PMU located next to the main square in Etaples, friendly atmosphere.\nGame broadcasts and evening entertainment."
        ],
        "it": [
          "Caffè, bar, tabaccheria, PMU situato vicino alla piazza principale di Etaples, atmosfera amichevole.\nTrasmissione di partite e serate animate."
        ],
        "fr": [
          "Café, bar, Tabac, PMU situé à côté de la grande place d'Etaples, ambiance conviviale.\nDiffusion de match et soirées animées."
        ],
        "nl": [
          "Café, bar, tabakswinkel, PMU gelegen naast het centrale plein in Etaples, vriendelijke sfeer.\nUitzending van wedstrijden en levendige avonden."
        ],
        "es": [
          "Café, bar, estanco, PMU situado junto a la plaza principal de Etaples, ambiente agradable.\nRetransmisión de partidos y veladas animadas."
        ]
