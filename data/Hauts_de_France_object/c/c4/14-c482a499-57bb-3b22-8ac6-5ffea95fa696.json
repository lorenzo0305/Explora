        "de": [
          "Le P'tit Bouchon in Sainte Cécile ist eine Gourmet-Bar, die Bretter, Salate, Crêpes, Kleinigkeiten zum Essen und Mitnehmen anbietet"
        ],
        "en": [
          "Le P'tit Bouchon located in Sainte Cécile is a gourmet bar offering platters, salads, crepes, snacks and takeaways"
        ],
        "it": [
          "Le P'tit Bouchon a Sainte Cécile è un bar gourmet che offre piatti, insalate, frittelle, snack e piatti da asporto"
        ],
        "fr": [
          "Le P'tit Bouchon situé à Sainte Cécile est un Bar Gourmand proposant des planches, des salades, des crêpes, de la p'tit restauration, de la vente à emporter"
        ],
        "es": [
          "Le P'tit Bouchon, en Sainte Cécile, es un bar gastronómico que sirve platos, ensaladas, tortitas, bocadillos y comida para llevar"
