  "rdfs:comment": {
    "de": [
      "Les Paniers de Gillou ist vor allem eine Gemüsebäuerin und ein Frühblüher, die sich zusammenschließen, um ein schönes Familienabenteuer ins Leben zu rufen."
    ],
    "en": [
      "Les Paniers de Gillou is above all a market gardener and a greengrocer who have joined forces to create a wonderful family adventure."
    ],
    "it": [
      "Les Paniers de Gillou sono prima di tutto un ortolano e un fruttivendolo che hanno unito le loro forze per creare una meravigliosa avventura familiare."
    ],
    "fr": [
      "Les Paniers de Gillou, c'est avant tout une maraichère et un primeur qui s'associent pour donner naissance à une belle aventure familiale."
    ],
    "nl": [
      "Les Paniers de Gillou is in de eerste plaats een tuinder en een groenteboer die hun krachten hebben gebundeld om een prachtig familieavontuur te creëren."
    ],
    "es": [
      "Les Paniers de Gillou es ante todo un hortelano y un verdulero que han unido sus fuerzas para crear una maravillosa aventura familiar."
    ]
  },
