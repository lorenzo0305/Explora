  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6192b394-afb0-3c56-a535-ddf3ad0e6765",
      "dc:description": {
        "de": [
          "Neuer Pump Track in Camiers - Sainte-Cécile!  \n\nGeeignet für BMX-Räder, Roller, Inlineskates und Skateboards, bietet er einen perfekten Spiel- und Trainingsplatz für Groß und Klein.\n\nDie Anlage befindet sich im Parc de la Chaumière in Sainte-Cécile und ist frei zugänglich: Entdecken und genießen Sie sie jetzt!"
        ],
        "en": [
          "New Pump Track in Camiers - Sainte-Cécile!  \n\nSuitable for BMX, scooters, rollerblades and skateboards, it offers the perfect playground and training ground for young and old alike.\n\nLocated in the Parc de la Chaumière in Sainte-Cécile, it's open to all: come and enjoy it today!"
        ],
        "it": [
          "Nuova pista di pompaggio a Camiers - Sainte-Cécile!  \n\nAdatta a biciclette BMX, monopattini, rollerblade e skateboard, è il campo di gioco e di allenamento perfetto per grandi e piccini.\n\nSituata nel Parc de la Chaumière di Sainte-Cécile, è aperta a tutti, quindi venite a scoprirla di persona!"
        ],
        "fr": [
          "Nouveau Pump Track à Camiers - Sainte-Cécile !  \n\nAdapté aux BMX, trottinettes, rollers et skateboards, il offre un parfait terrain de jeu et d’entraînement pour petits et grands.\n\nSitué au Parc de la Chaumière à Sainte-Cécile, il est en accès libre : venez le découvrir et en profiter dès maintenant !"
        ],
        "es": [
          "¡Nueva pista de Pump Track en Camiers - Sainte-Cécile!  \n\nApta para bicicletas BMX, patinetes, patines y monopatines, es el terreno de juego y entrenamiento perfecto para grandes y pequeños.\n\nSituada en el Parque de la Chaumière de Sainte-Cécile, está abierta a todos, ¡ven a descubrirla!"
        ],
        "nl": [
          "Nieuwe pompbaan in Camiers - Sainte-Cécile!  \n\nGeschikt voor BMX-fietsen, steps, skeelers en skateboards. De perfecte speel- en trainingsbaan voor jong en oud.\n\nGelegen in het Parc de la Chaumière in Sainte-Cécile is het voor iedereen toegankelijk, dus kom het zelf ontdekken!"
        ]
      },
