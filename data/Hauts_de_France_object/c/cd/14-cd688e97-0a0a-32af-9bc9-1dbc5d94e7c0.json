  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bcff4a80-fb08-371d-bd4f-71f54fc0076a",
      "dc:description": {
        "de": [
          "Weihnachtsmarkt in Crémarest\n\nTreffpunkt von 10 bis 18 Uhr in der Biscopem-Halle für einen Tag voller Magie und Gemütlichkeit!\n Um 16 Uhr: Der Weihnachtsmann kommt, um Groß und Klein in Staunen zu versetzen.\n\nFeiern Sie mit uns den Zauber von Weihnachten!"
        ],
        "en": [
          "Crémarest Christmas Market\n\nFrom 10 a.m. to 6 p.m. at the Salle Biscopem, you'll enjoy a day of magic and conviviality!\n At 4 p.m.: Santa Claus arrives to delight young and old alike.\n\nCome and celebrate the magic of Christmas with us!"
        ],
        "it": [
          "Mercatino di Natale di Crémarest\n\nUnitevi a noi dalle 10 alle 18 presso la Salle Biscopem per una giornata piena di magia e divertimento!\n Alle 16, Babbo Natale sarà a disposizione per deliziare grandi e piccini.\n\nVenite a festeggiare la magia del Natale con noi!"
        ],
        "fr": [
          "Marché de Noël de Crémarest\n\nRendez-vous de 10h à 18h à la salle Biscopem pour une journée pleine de magie et de convivialité !\n À 16h : venue du Père Noël pour émerveiller petits et grands.\n\nVenez célébrer la magie de Noël avec nous !"
        ],
        "es": [
          "Mercado de Navidad de Crémarest\n\nÚnase a nosotros de 10:00 a 18:00 en la Salle Biscopem para disfrutar de un día lleno de magia y diversión\n A las 16 h, Papá Noel hará las delicias de grandes y pequeños.\n\nVenga a celebrar con nosotros la magia de la Navidad"
        ],
        "nl": [
          "Kerstmarkt Crémarest\n\nKom van 10 tot 18 uur naar de Salle Biscopem voor een dag vol magie en plezier!\n Om 16.00 uur zal de kerstman jong en oud verrukken.\n\nKom en vier de magie van Kerstmis met ons!"
        ]
      },
      "@type": [
        "Description"
      ],
