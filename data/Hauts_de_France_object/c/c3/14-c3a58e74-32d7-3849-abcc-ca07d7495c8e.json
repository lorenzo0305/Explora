  "rdfs:comment": {
    "de": [
      "Die Ensembleklassen des Städtischen Musikkonservatoriums freuen sich, Sie zur zweiten Ausgabe des \"Konzerts bei Kerzenschein\" begrüßen zu dürfen. Ein Spektakel, das Sie sich nicht entgehen lassen sollten."
    ],
    "en": [
      "The ensemble classes of the Conservatoire Municipal de Musique are delighted to welcome you to the second edition of the \"Concert à la bougie\". A show not to be missed."
    ],
    "it": [
      "Le classi dell'ensemble del Conservatoire Municipal de Musique sono liete di darvi il benvenuto alla seconda edizione del \"Concert à la bougie\". Uno spettacolo da non perdere."
    ],
    "fr": [
      "Les classes d’ensemble du Conservatoire Municipal de Musique ont le plaisir de vous accueillir à la deuxième édition du « Concert à la bougie ». Un spectacle à ne pas rater."
    ],
    "es": [
      "Las clases de conjunto del Conservatorio Municipal de Música se complacen en darle la bienvenida a la segunda edición del \"Concert à la bougie\". Un espectáculo que no debe perderse."
    ],
    "nl": [
      "De ensembleklassen van het Conservatoire Municipal de Musique heten je van harte welkom op de tweede editie van het \"Concert à la bougie\". Een optreden dat je niet mag missen."
    ]
  },
