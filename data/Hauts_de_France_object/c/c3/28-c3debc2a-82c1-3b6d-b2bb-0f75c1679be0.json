  "rdfs:comment": {
    "de": [
      "Anhand seiner zahlreichen Objekte lädt das Musée du Noyonnais im ehemaligen Bischofspalast den Besucher dazu ein, die Stadt seit der gallo-römischen Zeit zu entdecken\nEin Besuch, den Sie sich nicht entgehen lassen sollten!"
    ],
    "en": [
      "Through its many objects, the Musée du Noyonnais invites the visitor to discover the city since the Gallo-Roman era, in the former bishop's palace\nA visit not to be missed!"
    ],
    "it": [
      "Attraverso i suoi numerosi oggetti, il Museo di Noyonnais invita i visitatori a scoprire la città fin dall'epoca gallo-romana, all'interno dell'antico palazzo episcopale\nUna visita da non perdere!"
    ],
    "fr": [
      "A travers ses nombreux objets, le musée du Noyonnais invite le visiteur à découvrir la ville depuis l'ère gallo-romaine, au sein de l'ancien palais épiscopal. \nUne visite à ne pas manquer !"
    ],
    "nl": [
      "Het museum van Noyonnais nodigt u uit om aan de hand van talrijke voorwerpen de stad sinds de Gallo-Romeinse tijd te ontdekken, in het voormalige bisschoppelijk paleis\nEen niet te missen bezoek!"
    ],
    "es": [
      "A través de sus numerosos objetos, el Museo de Noyonnais invita a los visitantes a descubrir la ciudad desde la época galorromana, dentro del antiguo palacio episcopal\nUna visita que no debe perderse"
    ]
  },
