  "rdfs:comment": {
    "de": [
      "Erkunden Sie einen einzigartigen 1700 m² großen Garten im Herzen der Stadt, der über 400 Arten beherbergt und der Natur, der Pädagogik und der nachhaltigen Entwicklung gewidmet ist."
    ],
    "en": [
      "Explore a unique 1700 m² garden in the heart of the city, home to over 400 species and dedicated to nature, education and sustainable development."
    ],
    "it": [
      "Esplorate un giardino unico di 1.700 m² nel cuore della città, che ospita oltre 400 specie e che è dedicato alla natura, all'educazione e allo sviluppo sostenibile."
    ],
    "fr": [
      "Explorez un jardin unique de 1700 m² au cœur de la ville, abritant plus de 400 espèces et dédié à la nature, la pédagogie et au développement durable."
    ],
    "nl": [
      "Verken een unieke tuin van 1.700 m² in het hart van de stad, waar meer dan 400 soorten leven en die gewijd is aan natuur, educatie en duurzame ontwikkeling."
    ],
    "es": [
      "Explore un jardín único de 1.700 m² en el corazón de la ciudad, hogar de más de 400 especies y dedicado a la naturaleza, la educación y el desarrollo sostenible."
    ]
  },
