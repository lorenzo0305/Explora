  "rdfs:comment": {
    "de": [
      "Kommentierte Spaziergänge, Spiele in Naturgröße (Schnitzeljagd in natürlichen Umgebungen), Workshops zum Thema \"Basteln mit der Natur\", Veranstaltungen in Schulen und im Rahmen des Gesetzes"
    ],
    "en": [
      "Guided walks, nature-size games (treasure hunts in natural environments), natural crafts workshops, school and law school activities"
    ],
    "it": [
      "Passeggiate guidate, giochi a misura di natura (cacce al tesoro in ambienti naturali), laboratori di bricolage naturalistico, attività nelle scuole e per il grande pubblico"
    ],
    "fr": [
      "Balades commentées, jeux grandeurs nature (jeux de piste en milieux naturels), ateliers bricolage au naturel, animations en milieux scolaires et accueils de Loi"
    ],
    "es": [
      "Paseos guiados, juegos en la naturaleza (búsquedas del tesoro en entornos naturales), talleres de bricolaje en la naturaleza, actividades en colegios y para el público en general"
    ],
    "nl": [
      "Begeleide wandelingen, spelletjes op natuurformaat (speurtochten in natuurlijke omgevingen), doe-het-zelf-workshops op natuurbasis, activiteiten op scholen en voor het grote publiek"
    ]
  },
