  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/82c1cd5e-0c7d-3bd9-a1a8-90112931ea85",
      "dc:description": {
        "de": [
          "Feuershow für jedes Publikum mit dem Ensemble Unicorn Legends und seinen emblematischen Kreaturen, die Groß und Klein zum Staunen bringen! Stelzenläufer, Feuerspucker, Jonglieren. Zu entdecken ab 21 Uhr auf der Esplanade."
        ],
        "en": [
          "Fire show for all audiences with the Unicorn Legends company and its emblematic creatures that amaze young and old alike! Stilt-walkers, fire-eaters, jugglers. To be discovered from 9pm on the Esplanade."
        ],
        "it": [
          "Uno spettacolo di fuoco per tutte le età con la compagnia Unicorn Legends e le sue creature emblematiche che stupiranno grandi e piccini! Trampolieri, mangiafuoco e giocolieri. Dalle 21.00 in poi sull'Esplanade."
        ],
        "fr": [
          "Spectacle de feu pour tout public avec la compagnie Unicorn Legends et ses créatures emblématiques qui émerveillent petits et grands ! Echassiers, cracheurs de feu, jonglerie. A découvrir dès 21h sur l'Esplanade."
        ],
        "es": [
          "Un espectáculo de fuego para todas las edades con la compañía Unicorn Legends y sus emblemáticas criaturas que asombrarán a grandes y pequeños Zancudos, tragafuegos y malabaristas. A partir de las 21:00 h en la Explanada."
        ],
        "nl": [
          "Een vuurshow voor alle leeftijden met het gezelschap Unicorn Legends en zijn emblematische wezens die jong en oud versteld zullen doen staan! Steltenlopers, vuurspuwers en jongleurs. Vanaf 21.00 uur op de Esplanade."
        ]
      },
