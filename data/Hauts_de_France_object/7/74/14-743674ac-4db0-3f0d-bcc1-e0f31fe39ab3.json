  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/03f781b9-7e48-37cc-8113-f11f33676bb5",
      "dc:description": {
        "de": [
          "Nicole, 2 rue Thiers in Boulogne. Geöffnet montags von 13:30 bis 19:00 Uhr, dienstags von 10:30 bis 19:00 Uhr, mittwochs von 9:30 bis 19:00 Uhr, donnerstags von 10:30 bis 19:00 Uhr, freitags von 10:30 bis 22:00 Uhr, samstags von 9:30 bis 22:00 Uhr und sonntags von 10:30 bis 18:00 Uhr. Eis eine Kugel zu 3?, zwei Kugeln zu 5?, drei Kugeln zu 6,50?"
        ],
        "en": [
          "Nicole, 2 rue Thiers, Boulogne. Open Mondays 1:30 pm to 7 pm, Tuesdays 10:30 am to 7 pm, Wednesdays 9:30 am to 7 pm, Thursdays 10:30 am to 7 pm, Fridays 10:30 am to 10 pm, Saturdays 9:30 am to 10 pm and Sundays 10:30 am to 6 pm. Ice cream one scoop at 3 ?, two scoops at 5 ?, three scoops at 6.50 ?."
        ],
        "it": [
          "Nicole, 2 rue Thiers, Boulogne. Aperto il lunedì dalle 13.30 alle 19.00, il martedì dalle 10.30 alle 19.00, il mercoledì dalle 9.30 alle 19.00, il giovedì dalle 10.30 alle 19.00, il venerdì dalle 10.30 alle 22.00, il sabato dalle 9.30 alle 22.00 e la domenica dalle 10.30 alle 18.00. Gelato una pallina a 3?, due palline a 5?, tre palline a 6,50?"
        ],
        "fr": [
          "Nicole, 2 rue Thiers à Boulogne. Ouvert le lundi de 13 h 30 à 19 h, le mardi de 10 h 30 à 19 h, le mercredi de 9 h 30 à 19 h, le jeudi de 10 30 à 19h, le vendredi de 10 h 30 à 22 h, le samedi de 9 h 30 à 22 h et le dimanche de 10 h 30 à 18 h. Glace une boule à 3 €, deux boules à 5 €, trois boules à 6,50 €."
        ],
        "nl": [
          "Nicole, 2 rue Thiers, Boulogne. Geopend op maandag van 13.30 tot 19.00 uur, op dinsdag van 10.30 tot 19.00 uur, op woensdag van 9.30 tot 19.00 uur, op donderdag van 10.30 tot 19.00 uur, op vrijdag van 10.30 tot 22.00 uur, op zaterdag van 9.30 tot 22.00 uur en op zondag van 10.30 tot 18.00 uur. IJs één bolletje voor 3?, twee bolletjes voor 5?, drie bolletjes voor 6,50?"
        ],
        "es": [
          "Nicole, 2 rue Thiers, Boulogne. Abierto los lunes de 13.30 h a 19 h, los martes de 10.30 h a 19 h, los miércoles de 9.30 h a 19 h, los jueves de 10.30 h a 19 h, los viernes de 10.30 h a 22 h, los sábados de 9.30 h a 22 h y los domingos de 10.30 h a 18 h. Helado: una bola a 3 ¤, dos bolas a 5 ¤, tres bolas a 6,50 ¤."
        ]
      },
