  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9ddc3748-6596-309d-b656-552b0fe83be3",
      "dc:description": {
        "de": [
          "Animierter Spielfilm von Wes Anderson\nMr. Fox, seine Frau, sein Sohn, ein Cousin und alle anderen Tiere des Waldes fordern drei abscheuliche Bauern heraus. Sie erleben ein großes Abenteuer."
        ],
        "en": [
          "Animated feature film by Wes Anderson\nMr. Fox, his wife, his son, a cousin and all the other animals of the forest challenge three obnoxious farmers. They're in for a great adventure."
        ],
        "it": [
          "Film d'animazione di Wes Anderson\nIl signor Fox, sua moglie, suo figlio, un cugino e tutti gli altri animali della foresta sfidano tre odiosi contadini. Li attende una grande avventura."
        ],
        "fr": [
          "Long-métrage d'animation de Wes Anderson\nM. Fox, sa femme, son fils, un cousin et tous les autres animaux de la forêt défient trois odieux fermiers. Ils vont vivre une grande aventure."
        ],
        "es": [
          "Largometraje de animación de Wes Anderson\nEl Sr. Fox, su mujer, su hijo, un primo y todos los demás animales del bosque desafían a tres odiosos granjeros. Les espera una gran aventura."
        ],
        "nl": [
          "Animatiefilm van Wes Anderson\nMr Fox, zijn vrouw, zijn zoon, een neef en alle andere dieren uit het bos trotseren drie onhebbelijke boeren. Er staat hen een groot avontuur te wachten."
        ]
      },
