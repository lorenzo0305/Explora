      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\nTäglich von 18:00 bis 21:30 Uhr\n\nAbholung:\nZu den Öffnungszeiten\n\nLieferung:\nLieferung über die Essenslieferungs-Apps UberEats und Deliveroo möglich\n\nBestellung:\nTelefonisch unter 06 45 42 94 63\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nEvery day from 6 pm to 9:30 pm\n\nCollection:\nDuring opening hours\n\nDelivery:\nDelivery possible via meal delivery apps UberEats and Deliveroo\n\nOrdering:\nBy telephone on 06 45 42 94 63\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrari di apertura :\nTutti i giorni dalle 18.00 alle 21.30\n\nRaccolta:\nDurante gli orari di apertura\n\nConsegna:\nConsegna possibile tramite le app di consegna pasti UberEats e Deliveroo\n\nOrdini:\nPer telefono al numero 06 45 42 94 63\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nTous les jours de 18h à 21h30\n\nRetrait :\nAux horaires d'ouvertures\n\nLivraison : \nLivraison possible via applications de livraison de repas UberEats et Deliveroo\n\nCommande : \nPar téléphone au 06 45 42 94 63\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningstijden :\nElke dag van 18u tot 21u30\n\nOphalen:\nTijdens openingstijden\n\nBezorging:\nBezorging mogelijk via maaltijdbezorgapps UberEats en Deliveroo\n\nBestellen:\nTelefonisch via 06 45 42 94 63\n "
        ],
        "es": [
          "Más información :\n\nHorarios de apertura :\nTodos los días de 18h a 21h30\n\nRecogida:\nDurante las horas de apertura\n\nEntrega a domicilio:\nEntrega posible a través de las apps de reparto de comida UberEats y Deliveroo\n\nPedidos:\nPor teléfono: 06 45 42 94 63\n "
        ]
      },
