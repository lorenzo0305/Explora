  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/33ce369e-fbbe-31d9-944b-3bedba1110aa",
      "dc:description": {
        "de": [
          "Sonntag, 5. März 2023\n\nAusdauer-Mountainbike-Rennen für Einzelpersonen oder Teams im Polowald für Lizenzinhaber und Nicht-Lizenzinhaber auf einer 7km500 langen Strecke.\nStart: 9:30 Uhr, ehemaliger Poloplatz und allée des Pâquerettes."
        ],
        "en": [
          "Sunday, March 5, 2023\n\nEndurance mountain bike race, solo or in teams, in the Polo woods, for licensed and non-licensed riders on a 7km500 circuit.\nStart at 9:30 a.m. at the former Polo field and allée des Pâquerettes."
        ],
        "it": [
          "Domenica 5 marzo 2023\n\nGara di endurance in mountain bike, in solitaria o a squadre, nel bosco del Polo, per titolari e non titolari di licenza, su un circuito di 7 km e 500 metri.\nPartenza alle 9.30 presso l'ex campo di Polo e l'allée des Pâquerettes."
        ],
        "fr": [
          "Dimanche 5 mars 2023\n\nCourse VTT d’endurance en solo ou par équipe dans le bois du polo pour les licenciés et non licenciés sur un circuit qui développe 7km500.\nDépart 9h30 ancien terrain du Polo et allée des Pâquerettes."
        ],
        "nl": [
          "Zondag 5 maart 2023\n\nSolo of team endurance mountainbikewedstrijd in het Polo-bos voor licentiehouders en niet-licentiehouders over een parcours van 7 km 500.\nStart om 9.30 uur op het voormalige Polo terrein en allée des Pâquerettes."
        ],
        "es": [
          "Domingo 5 de marzo de 2023\n\nCarrera de resistencia en bicicleta de montaña en solitario o por equipos en el bosque de Polo para titulares de licencia y no titulares de licencia en un circuito de 7km500.\nSalida a las 9.30 h en el antiguo campo de Polo y allée des Pâquerettes."
        ]
      },
      "@type": [
        "Description"
      ],
