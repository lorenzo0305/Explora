  "rdfs:comment": {
    "de": [
      "8. Frühjahrsmesse (2. Ausgabe in Breilly) des Vereins Vital Fitness.\nGESUNDHEIT, SCHÖNHEIT UND WOHLBEFINDEN\n\nFast 40 Aussteller rund um das Thema Schönheit, Gesundheit und Wohlbefinden\n\nAuf Anmeldung: Essen, Massage, Workshops und Animationen ab 1?\nGetränke und kleine Snacks vor Ort (Croque Monsieur, Crêpes, Waffeln)\n\nFreitag, den 27. ab 18.30 Uhr\nSamstag von 10 bis 19 Uhr\nSonntag von 10 bis 17 Uhr"
    ],
    "en": [
      "8th Spring Show (2nd edition in Breilly) of the Vital Fitness Association.\nHEALTH, BEAUTY AND WELL-BEING\n\nNearly 40 exhibitors on the theme of beauty, health and well-being\n\nRegistration required: catering, massage, workshops and entertainment from 1?\nRefreshments and snacks on site (croque-monsieur, crêpes, waffles)\n\nFriday 27 from 6:30pm\nSaturday from 10am to 7pm\nSunday from 10am to 5pm"
    ],
    "it": [
      "8° Salone di Primavera (2° edizione a Breilly) dell'Associazione Vital Fitness.\nSALUTE, BELLEZZA E BENESSERE\n\nQuasi 40 espositori sul tema della bellezza, della salute e del benessere\n\nIscrizione obbligatoria: catering, massaggi, workshop e intrattenimento a partire da 1 euro\nRinfreschi e spuntini in loco (panini, crêpes, cialde)\n\nVenerdì 27 dalle 18.30\nSabato dalle 10.00 alle 19.00\nDomenica dalle 10.00 alle 17.00"
    ],
    "fr": [
      "8ème Salon de Printemps (2ème édition à Breilly) de l'Association Vital Fitness.\nSANTÉ, BEAUTÉ ET BIEN ÊTRE\n\nPrès de 40 exposants sur le thème de la beauté, santé et du bien-être\n\nSur inscription : restauration, massage, ateliers et animations à partir de 1€\nBuvette et petite restauration sur place (croque-monsieur, crêpes, gaufres)\n\nVendredi 27 à partir de 18h30\nSamedi de 10h à 19h\nDimanche de 10h à 17h"
    ],
    "nl": [
      "8e voorjaarsbeurs (2e editie in Breilly) van de Vital Fitness Association.\nGEZONDHEID, SCHOONHEID EN WELZIJN\n\nBijna 40 exposanten rond het thema schoonheid, gezondheid en welzijn\n\nRegistratie verplicht: catering, massage, workshops en entertainment vanaf € 1\nVersnaperingen en snacks ter plaatse (sandwiches, crêpes, wafels)\n\nVrijdag 27 vanaf 18.30 uur\nZaterdag van 10 tot 19 uur\nZondag van 10u tot 17u"
    ],
    "es": [
      "8º Salón de Primavera (2ª edición en Breilly) de la Asociación Vital Fitness.\nSALUD, BELLEZA Y BIENESTAR\n\nCerca de 40 expositores sobre el tema de la belleza, la salud y el bienestar\n\nInscripción obligatoria: restauración, masajes, talleres y animaciones a partir de 1 euro\nRefrigerios y tentempiés in situ (bocadillos, crêpes, gofres)\n\nViernes 27 a partir de las 18.30 h\nSábado de 10.00 a 19.00 h\nDomingo de 10.00 a 17.00 h"
    ]
  },
