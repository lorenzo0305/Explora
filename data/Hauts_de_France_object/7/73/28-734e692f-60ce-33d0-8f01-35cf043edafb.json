  "rdfs:comment": {
    "de": [
      "10 Minuten von der Somme-Bucht entfernt, einzigartiges Hotel-Restaurant auf dem Flugplatz von Abbeville, Blick auf die Pisten, schmackhafte Brasserie, 15 Zimmer, großer Parkplatz."
    ],
    "en": [
      "10 min from the Baie de Somme, unique hotel-restaurant on the Abbeville airfield, view of the runways, tasty brasserie, 15 rooms, ample parking."
    ],
    "it": [
      "A 10 minuti dalla Baie de Somme, hotel-ristorante unico sul campo d'aviazione di Abbeville, vista sulle piste, gustosa brasserie, 15 camere, ampio parcheggio."
    ],
    "fr": [
      "A 10 min de la Baie de Somme, Hôtel-Restaurant unique sur l'Aérodrome d'Abbeville, vue sur les pistes, brasserie savoureuse, 15 chambres, grand parking."
    ],
    "nl": [
      "Op 10 minuten van de Baie de Somme, uniek hotel-restaurant op het vliegveld van Abbeville, uitzicht op de landingsbanen, lekkere brasserie, 15 kamers, grote parkeerplaats."
    ],
    "es": [
      "A 10 minutos de la bahía de Somme, hotel-restaurante único en el aeródromo de Abbeville, vistas a las pistas, sabrosa brasserie, 15 habitaciones, amplio aparcamiento."
    ]
