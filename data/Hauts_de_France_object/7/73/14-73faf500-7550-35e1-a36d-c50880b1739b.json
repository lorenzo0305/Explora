  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/43517aa5-acd4-32a5-b06b-a9ff527de962",
      "dc:description": {
        "de": [
          "Marie-Louise Monier bietet Miesmuscheln aus der Fußfischerei an, die im Rhythmus der Gezeiten und mit Respekt für die natürliche Umwelt geerntet werden.\nFrische und lokale Produkte, direkt von der Küste auf Ihren Tisch."
        ],
        "en": [
          "Marie-Louise Monier offers mussels caught on foot, harvested according to the rhythm of the tides and with respect for the natural environment.\nFresh, local produce, straight from the coast to your table."
        ],
        "it": [
          "Marie-Louise Monier propone cozze pescate a piedi, raccolte seguendo il ritmo delle maree e rispettando l'ambiente naturale.\nProdotti freschi e locali, direttamente dalla costa alla vostra tavola."
        ],
        "fr": [
          "Marie-Louise Monier propose des moules issues de la pêche à pied, récoltées au rythme des marées et dans le respect du milieu naturel. \nDes produits frais et locaux, directement du littoral à votre table."
        ],
        "es": [
          "Marie-Louise Monier ofrece mejillones pescados a pie, recolectados al ritmo de las mareas y respetando el entorno natural.\nProductos frescos y locales, directamente de la costa a su mesa."
        ],
        "nl": [
          "Marie-Louise Monier biedt mosselen die te voet worden gevangen, geoogst op het ritme van de getijden en met respect voor de natuurlijke omgeving.\nVerse, lokale producten, rechtstreeks van de kust naar uw tafel."
        ]
      },
      "@type": [
        "Description"
      ],
