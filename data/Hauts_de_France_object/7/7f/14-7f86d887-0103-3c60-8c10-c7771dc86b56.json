      "openingDetails": {
        "de": [
          "Animation 1001 pattes des Parc du Louvre-Lens :\nAusgestattet mit Lupendosen, Mähnetzen, japanischen Regenschirmen und unseren Augen durchstreifen wir den Park, um diese so unauffällige und doch so nützliche Fauna zu sammeln, dann zu beobachten und schließlich zu zeichnen."
        ],
        "en": [
          "Animation 1001 pattes du Parc du Louvre-Lens :\nEquipped with cup boxes, swath nets, Japanese umbrellas and our eyes, we wander through the park to collect, observe and draw this discreet yet useful fauna."
        ],
        "it": [
          "1001 pattes du Parc du Louvre-Lens:\nArmati di scatole a coppa, reti a strisce, ombrelli giapponesi e i nostri occhi, andremo in giro per il parco per raccogliere, osservare e infine disegnare questa fauna discreta ma utile."
        ],
        "fr": [
          "Animation 1001 pattes du Parc du Louvre-Lens :\nMunis de boîtes-loupe, de filets fauchoir, de parapluies japonais et de nos yeux, nous parcourons le parc pour récolter puis observer et enfin dessiner cette faune si discrète et pourtant si utile."
        ],
        "nl": [
          "1001 pattes du Parc du Louvre-Lens :\nUitgerust met bekerdoosjes, zwaddernetten, Japanse paraplu's en onze ogen zullen we door het park zwerven om deze discrete maar nuttige fauna te verzamelen, te observeren en uiteindelijk te tekenen."
        ],
        "es": [
          "1001 pattes du Parc du Louvre-Lens :\nEquipados con cajas para tazas, redes para hileras, sombrillas japonesas y nuestros ojos, recorreremos el parque para recoger, observar y finalmente dibujar esta fauna discreta pero útil."
        ]
      },
      "startDate": "2025-08-01"
    }
  ]
