  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f4f0dbe2-363d-397d-aa85-dca1a12c464b",
      "dc:description": {
        "de": [
          "Das Restaurant liegt im Herzen der Place d'Armes, nur wenige Minuten vom Hafen entfernt. Restaurant mit gepflegter bürgerlicher Einrichtung, Steinmauern, Balken und Böden."
        ],
        "en": [
          "Located in the heart of the Place d'Armes, a few minutes from the port. Restaurant with neat bourgeois decor, stone walls, beams and floors."
        ],
        "it": [
          "Situato nel cuore di Place d'Armes, a pochi minuti dal porto. Ristorante dall'arredamento borghese e curato, con pareti, travi e pavimenti in pietra."
        ],
        "fr": [
          "Situé au coeur de la place d'Armes, à quelques minutes du port. Restaurant au décor bourgeois soigné, murs de pierres, poutres et planchers."
        ],
        "es": [
          "Situado en el corazón de la Place d'Armes, a pocos minutos del puerto. Restaurante con una cuidada decoración burguesa, paredes, vigas y suelos de piedra."
        ],
        "nl": [
          "Gelegen in het hart van de Place d'Armes, op enkele minuten van de haven. Restaurant met een nette burgerlijke inrichting, stenen muren, balken en vloeren."
        ]
      },
