  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b8a5211b-d831-3f47-a8ce-45aeb5e41a18",
      "dc:description": {
        "de": [
          "Zwei Stunden lang müssen die Kinder Herausforderungen meistern, um möglichst viele Punkte zu sammeln und ihr Zertifikat als zukünftige Archäologen zu erhalten."
        ],
        "en": [
          "Over the course of two hours, children are invited to take up challenges to win as many points as possible and obtain their future archaeologist's certificate."
        ],
        "it": [
          "Nel corso di due ore, i bambini sono invitati a raccogliere sfide per vincere il maggior numero di punti possibile e ottenere il loro futuro certificato di archeologo."
        ],
        "fr": [
          "Durant deux heures, les enfants sont invités à relever des défis afin de gagner le maximum de points et obtenir leur certificat de futur archéologue."
        ],
        "nl": [
          "In de loop van twee uur worden kinderen uitgenodigd om uitdagingen aan te gaan om zoveel mogelijk punten te winnen en hun toekomstige archeologendiploma te behalen."
        ],
        "es": [
          "A lo largo de dos horas, se invita a los niños a enfrentarse a retos para ganar el mayor número posible de puntos y obtener su futuro certificado de arqueólogo."
        ]
      },
