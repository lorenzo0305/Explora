  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4a6c5f39-cf79-39d9-9748-f14230707b3e",
      "dc:description": {
        "de": [
          "Start: Montreuil (Esplanade de la Citadelle)\n15 km - 4 Std\nDieser Rundweg hat seinen Namen von einer geschützten Pflanze, die man im Sorrus-Wald findet: die Pyrole, auch Juli-Maiglöckchen genannt. Sie können sie auf den Wegen bewundern."
        ],
        "en": [
          "Start : Montreuil (Esplanade de la Citadelle)\n15km - 4h\nThis trail takes its name from a protected plant found in the Sorrus woods: the pyrole, also known as the July lily of the valley. You'll be able to admire it as you stroll along the trails."
        ],
        "it": [
          "Partenza : Montreuil (Esplanade de la Citadelle)\n15 km - 4 ore\nQuesto percorso prende il nome da una pianta protetta che si trova nei boschi di Sorrus: la pirolea, nota anche come mughetto di luglio. Potrete ammirarla passeggiando lungo i sentieri."
        ],
        "fr": [
          "Départ : Montreuil (Esplanade de la Citadelle)\n15km - 4h\nCe circuit tire son nom d'une plante protégée, que l'on trouve dans le bois de Sorrus : la pyrole, aussi appelée muguet de juillet. Vous pourrez l'admirer au détour des sentiers."
        ],
        "nl": [
          "Start : Montreuil (Esplanade de la Citadelle)\n15 km - 4 uur\nDit pad ontleent zijn naam aan een beschermde plant die in de bossen van Sorrus te vinden is: de pyrolea, ook wel bekend als de julilelie van de vallei. Je kunt hem bewonderen terwijl je over de paden wandelt."
        ],
        "es": [
          "Salida : Montreuil (Esplanade de la Citadelle)\n15 km - 4 horas\nEste sendero toma su nombre de una planta protegida que se encuentra en el bosque de Sorrus: el pirol, también conocido como lirio de julio del valle. Podrá admirarla mientras pasea por los senderos."
        ]
      },
