      "dc:description": {
        "de": [
          "Aufwertung und Entwicklung des Allgemeinwissens durch das Spielen des Spiels \"Questions for a Champion\" unter Beachtung des Geistes, des Niveaus und der Regeln."
        ],
        "en": [
          "Revaluation and development of general knowledge through the practice of the game \"Questions for a champion\" respecting the spirit, the level and the rules."
        ],
        "it": [
          "Rivalutazione e sviluppo delle conoscenze generali attraverso la pratica del gioco \"Domande per un campione\", rispettando lo spirito, il livello e le regole."
        ],
        "fr": [
          "Revalorisation et développement des connaissances générales par la pratique du jeu \"Questions pour un champion\" en respectant l'esprit, le niveau et les règles."
        ],
        "es": [
          "Revalorización y desarrollo de conocimientos generales a través de la práctica del juego \"Preguntas para un campeón\", respetando el espíritu, el nivel y las reglas."
        ],
        "nl": [
          "Herwaardering en ontwikkeling van de algemene kennis door de beoefening van het spel \"Vragen voor een kampioen\", met inachtneming van de geest, het niveau en de regels."
        ]
      },
