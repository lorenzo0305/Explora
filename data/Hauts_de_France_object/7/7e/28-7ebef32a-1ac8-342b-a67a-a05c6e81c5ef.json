  "rdfs:comment": {
    "de": [
      "Das Hauts de Lille befindet sich im ersten Stock des Hôtel Barrière Lille und bringt Sie geschmacklich auf einen neuen Höhepunkt.\nGenießen Sie den Blick auf die Stadt bei einer Gourmetküche, die je nach Jahreszeit und Inspiration der Küchenchefs zubereitet wird."
    ],
    "en": [
      "Located on the 1st floor of the Hôtel Barrière Lille, Les Hauts de Lille takes taste to new heights.\nTake in the view of the city while savoring gourmet cuisine prepared according to the seasons and the inspiration of our Chefs."
    ],
    "it": [
      "Situato al 1° piano dell'Hôtel Barrière Lille, Les Hauts de Lille porterà le vostre papille gustative a nuovi livelli.\nGodetevi la vista sulla città mentre assaporate la cucina gourmet preparata in base alle stagioni e all'ispirazione degli chef."
    ],
    "fr": [
      "Situé au 1er étage de l'Hôtel Barrière Lille, les Hauts de Lille, vous font atteindre des sommets en matière de goût.\nProfitez de la vue sur la ville en savourant une cuisine gastronomique élaborée au fil des saisons, selon l'inspiration des Chefs."
    ],
    "es": [
      "Situado en la 1ª planta del Hôtel Barrière Lille, Les Hauts de Lille llevará sus papilas gustativas a nuevas cotas.\nDisfrute de las vistas de la ciudad mientras saborea la cocina gourmet preparada según las estaciones y la inspiración de los Chefs."
    ],
    "nl": [
      "Les Hauts de Lille, gelegen op de 1e verdieping van Hôtel Barrière Lille, brengt uw smaakpapillen naar nieuwe hoogten.\nGeniet van het uitzicht over de stad terwijl je smult van gastronomische gerechten bereid volgens de seizoenen en de inspiratie van de chef-koks."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Hauts de Lille"
    ]
  },
  "COVID19SpecialMeasures": {
    "de": [
      "In einem zeitgenössischen Ambiente, das durch große Fensterfronten erhellt wird, stellen sich der Chefkoch & sein Team eine kühne Küche vor. Genießen Sie die Authentizität durch lokale und saisonale Produkte."
    ],
    "en": [
      "In a contemporary setting, illuminated by large bay windows, the Chef & his team create a daring cuisine. Savor the authenticity of local, seasonal produce."
    ],
    "it": [
      "In un ambiente contemporaneo, illuminato da grandi vetrate, lo chef e il suo team creano una cucina audace. Assaporate l'autenticità dei prodotti locali e di stagione."
    ],
    "fr": [
      "Dans une ambiance contemporaine, éclairée par de larges baies vitrées, le Chef & son équipe imaginent une cuisine audacieuse. Savourerez l'authenticité à travers des produits locaux et de saison."
    ],
    "nl": [
      "In een eigentijdse omgeving, verlicht door grote erkers, creëren de chef-kok en zijn team een gedurfde keuken. Geniet van de authenticiteit van lokale, seizoensgebonden producten."
    ],
    "es": [
      "En un ambiente contemporáneo, iluminado por grandes ventanales, el Chef y su equipo crean una cocina audaz. Saboree la autenticidad de los productos locales de temporada."
    ]
  },
