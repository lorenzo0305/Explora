  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/525adacf-b2e3-35e3-8f6a-6a4adcf1757c",
      "dc:description": {
        "de": [
          "Picknickplatz, der sich im Bois Bourdon befindet. Verschiedene Ausstattungen: 3 Picknicktische, Parkplatz, Spielplatz und Mülleimer.\nGroßer Bereich auf Rasen und Kiesweg.\n\nFür Behinderte zugänglich."
        ],
        "en": [
          "Picnic area located at the Bois Bourdon. Various equipment: 3 picnic tables, parking, playground and garbage cans.\nLarge space on lawn and gravel path.\n\nAccessible area for disabled people."
        ],
        "it": [
          "Area picnic situata nel Bois Bourdon. Varie strutture: 3 tavoli da picnic, parcheggio, area giochi e cestini per i rifiuti.\nAmpio spazio erboso e sentiero in ghiaia.\n\nAccessibile ai disabili."
        ],
        "fr": [
          "Aire de pique-nique se situant au Bois Bourdon. Divers équipement : 3 tables de pique-nique, parking, aire de jeux et poubelles.\nGrand espace sur pelouse et chemin en gravier.\n\nAire accessible aux personnes handicapés."
        ],
        "es": [
          "Zona de picnic situada en Bois Bourdon. Diversas instalaciones: 3 mesas de picnic, aparcamiento, zona de juegos y papeleras.\nAmplia zona de césped y camino de grava.\n\nAccesible para las personas con discapacidad."
        ],
        "nl": [
          "Picknickplaats gelegen in Bois Bourdon. Diverse voorzieningen: 3 picknicktafels, parkeerplaats, speelterrein en afvalbakken.\nGroot grasveld en grindpad.\n\nToegankelijk voor gehandicapten."
        ]
      },
      "@type": [
        "Description"
      ],
