  "rdfs:comment": {
    "de": [
      "Die aus Buysscheure stammende Isabelle Wylleman führt das Café Rando, das sich gegenüber der Kirche befindet. Um zu verdeutlichen, dass das Café noch immer existiert, hat sie den Namen des Mannes der früheren Besitzerin, Marcel, beibehalten und ihren Vornamen hinzugefügt."
    ],
    "en": [
      "A native of Buysscheure, Isabelle Wylleman runs the Café Rando opposite the church. To show that the sign is still alive, she has kept the name of the former owner's husband, Marcel, to which she has added her first name."
    ],
    "it": [
      "Originaria di Buysscheure, Isabelle Wylleman gestisce il Café Rando di fronte alla chiesa. Per dimostrare che l'insegna è ancora viva, ha mantenuto il nome del marito della precedente proprietaria, Marcel, a cui ha aggiunto il suo nome di battesimo."
    ],
    "fr": [
      "Native de Buysscheure, Isabelle Wylleman, tient le Café Rando situé en face de l'église. Pour signifier que l'enseigne est toujours vivante, elle a conservé le nom du mari de l'ancienne propriétaire, Marcel, auquel elle a rajouté son prénom."
    ],
    "es": [
      "Isabelle Wylleman, natural de Buysscheure, regenta el Café Rando, frente a la iglesia. Para demostrar que el rótulo sigue vivo, ha conservado el nombre del marido de la antigua propietaria, Marcel, al que ha añadido su nombre de pila."
    ],
    "nl": [
      "Isabelle Wylleman komt uit Buysscheure en runt Café Rando tegenover de kerk. Om te laten zien dat het uithangbord nog steeds leeft, heeft ze de naam van de man van de vorige eigenaar, Marcel, behouden, waaraan ze haar voornaam heeft toegevoegd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Marcel \"chez Isabelle\""
    ]
  },
