  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9ff7d80a-90e5-39d9-bf21-0ae1c8e0060e",
      "dc:description": {
        "de": [
          "Um Menschen mit Albinismus durch Veranstaltungen zugunsten der Genforschung zu begleiten.\nJährliches Treffen in verschiedenen Abteilungen, Konzerte usw."
        ],
        "en": [
          "To support people with albinism through events benefiting genetic research.\nAnnual meetings in different departments, concerts, etc."
        ],
        "it": [
          "Sostenere le persone affette da albinismo attraverso eventi a favore della ricerca genetica.\nIncontri annuali in diversi dipartimenti, concerti, ecc."
        ],
        "fr": [
          "Pour accompagner les personnes atteintes d’albinisme par des manifestations au profit de la recherche génétique.\nRencontre annuelle dans les départements différents, des concerts, etc."
        ],
        "nl": [
          "Mensen met albinisme ondersteunen door middel van evenementen ter ondersteuning van genetisch onderzoek.\nJaarlijkse bijeenkomsten in verschillende afdelingen, concerten, enz."
        ],
        "es": [
          "Apoyar a las personas con albinismo mediante actos en favor de la investigación genética.\nReuniones anuales en distintos departamentos, conciertos, etc."
        ]
      },
