  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1d55200a-4a43-3768-a7ee-3e030e62b405",
      "dc:description": {
        "de": [
          "Ziel des Vereins ist es, Bürgerinnen und Bürger zusammenzubringen, um sich zu informieren, zu diskutieren und im Zusammenhang mit gesellschaftlichen Themen bürgerschaftlich und solidarisch zu handeln."
        ],
        "en": [
          "The aim of the association is to bring citizens together to inform themselves, debate and act in a spirit of citizenship and solidarity in relation to social issues."
        ],
        "it": [
          "L'obiettivo dell'associazione è quello di riunire i cittadini per informarsi, discutere e agire in uno spirito di cittadinanza e solidarietà in relazione alle questioni sociali."
        ],
        "fr": [
          "Le but de l'association est de réunir des citoyens pour s'informer, débattre et agir dans une optique citoyenne et solidaire en relation avec des sujets de société."
        ],
        "nl": [
          "Het doel van de vereniging is om burgers samen te brengen om zichzelf te informeren, te debatteren en te handelen in een geest van burgerschap en solidariteit met betrekking tot sociale kwesties."
        ],
        "es": [
          "El objetivo de la asociación es reunir a los ciudadanos para que se informen, debatan y actúen con espíritu de ciudadanía y solidaridad en relación con las cuestiones sociales."
        ]
      },
      "@type": [
