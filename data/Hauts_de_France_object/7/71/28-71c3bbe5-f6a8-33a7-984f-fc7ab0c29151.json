  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05003844-05f5-3bae-9f55-d8a83b2efa6e",
      "dc:description": {
        "de": [
          "Ein guter Cocktail und ab geht's zu einem gemütlichen Moment mit Freunden oder der Familie in der Bar Modjo am Ufer der Aisne in der Halte Fluviale bis zum Ende dieses Sommers, d. h. bis zum 28. September."
        ],
        "en": [
          "A good cocktail and off you go for a convivial moment with friends or family at the Halte Fluviale in the Bar Modjo on the banks of the Aisne until the end of this summer, on September 28."
        ],
        "it": [
          "Un buon cocktail e via per un momento di convivialità con gli amici o la famiglia all'Halte Fluviale del Bar Modjo sulle rive dell'Aisne fino alla fine dell'estate, il 28 settembre."
        ],
        "fr": [
          "Un bon cocktail et c’est parti pour un moment convivial entre amis ou en famille à la Halte Fluviale au Bar Modjo sur les berges de l'Aisne jusqu'à la fin de cet été, soit le 28 septembre."
        ],
        "es": [
          "Un buen cóctel y a pasar un rato agradable con los amigos o la familia en la Halte Fluviale del Bar Modjo, a orillas del Aisne, hasta el final del verano, el 28 de septiembre."
        ],
        "nl": [
          "Een goede cocktail en je bent vertrokken voor een gezellig moment met vrienden of familie in de Halte Fluviale in de Bar Modjo aan de oevers van de Aisne tot het einde van de zomer, op 28 september."
        ]
      },
