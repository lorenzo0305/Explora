  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/042f98f3-0d5d-33bb-b1ff-f21a13933869",
      "dc:description": {
        "de": [
          "Marc, Claire und Sylvain haben die Angewohnheit, jedes Jahr ein Theaterstück aufzuführen. Dieses Jahr ist \"Mais ne te promène donc pas toute nue\" (Aber geh doch nicht nackt spazieren) in Planung. Die Zutaten für eine rhythmische Komödie, die von vier energiegeladenen Schauspielern angeführt wird, sind vorhanden."
        ],
        "en": [
          "Marc, Claire and Sylvain have the habit of putting on a show every year. This year \"Mais ne te promène donc pas toute nue\" is in the works. The ingredients are there for a rhythmic comedy, led by 4 actors full of energy."
        ],
        "it": [
          "Marc, Claire e Sylvain organizzano ogni anno uno spettacolo. Quest'anno hanno in programma \"Mais ne te promène donc pas toute nue\". Ci sono gli ingredienti per una commedia dal ritmo incalzante, condotta da 4 attori energici."
        ],
        "fr": [
          "Marc, Claire et Sylvain ont l'habitude de monter un spectacle tous les ans. Cette année \"Mais ne te promène donc pas toute nue\" est en projet. Les ingrédients sont réunis pour une comédie rythmée, menée par 4 comédiens plein d'énergie."
        ],
        "es": [
          "Marc, Claire y Sylvain montan un espectáculo cada año. Este año tienen previsto \"Mais ne te promène donc pas toute nue\". Se trata de una comedia trepidante protagonizada por 4 actores llenos de energía."
        ],
        "nl": [
          "Marc, Claire en Sylvain geven elk jaar een show. Dit jaar staat \"Mais ne te promène donc pas toute nue\" op het programma. De ingrediënten zijn aanwezig voor een snelle komedie, geleid door 4 energieke acteurs."
        ]
      },
