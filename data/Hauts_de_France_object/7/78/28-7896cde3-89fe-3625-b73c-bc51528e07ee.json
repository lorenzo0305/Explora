      "rdfs:comment": {
        "de": [
          "In seinem Betrieb produziert und vermarktet Michel Courtois Obst und Gemüse, darunter drei verschiedene Kartoffelsorten, und das alles ohne Konservierungsmittel."
        ],
        "en": [
          "On his farm, Michel Courtois produces and sells fruit and vegetables, including 3 varieties of potato, all without preservatives."
        ],
        "it": [
          "Nella sua azienda agricola, Michel Courtois produce e vende frutta e verdura, tra cui 3 varietà di patate, tutte senza conservanti."
        ],
        "fr": [
          "Dans son exploitation, Michel Courtois produits et vent fruits et légumes, et notamment 3 variété de pommes de terre, le tout sans traitement de conservation."
        ],
        "nl": [
          "Op zijn boerderij produceert en verkoopt Michel Courtois groenten en fruit, waaronder 3 soorten aardappelen, allemaal zonder conserveringsmiddelen."
        ],
        "es": [
          "En su granja, Michel Courtois produce y vende frutas y verduras, incluidas 3 variedades de patata, todas sin conservantes."
        ]
      },
