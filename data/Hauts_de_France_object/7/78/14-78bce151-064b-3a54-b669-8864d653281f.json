  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30ff91dd-efe0-32eb-99a9-5fd717ec3583",
      "dc:description": {
        "de": [
          "Messe der Maler\nVon Samstag, den 4. bis Montag, den 6. April\nChemin du Petit Capelle (Weg der kleinen Capelle)\n-----------------------\nOrganisiert von der Association Loisirs, Cultures, Fêtes et Sports à Saint-Josse (Verein für Freizeit, Kultur, Feste und Sport in Saint-Josse)\n\nVon 10.30 bis 18 Uhr - Freier Eintritt\n\nKontakt: 06 68 42 55 81 oder 06 85 11 16 17\nPer E-Mail: lfs.stjosse@free.fr\nKredit: Comité des Fêtes - St Josse"
        ],
        "en": [
          "Painters' Show\nSaturday April 4 to Monday April 6\nChemin du Petit Capelle\n-----------------------\nOrganized by the Association Loisirs, Cultures, Fêtes et Sports à Saint-Josse\n\n10:30 a.m. to 6 p.m. - Free admission\n\nContacts : 06 68 42 55 81 or 06 85 11 16 17\nBy e-mail : lfs.stjosse@free.fr\nCredit : Comité des Fêtes - St Josse"
        ],
        "it": [
          "Mostra dei pittori\nDa sabato 4 a lunedì 6 aprile\nChemin du Petit Capelle\n-----------------------\nA cura dell'Associazione Loisirs, Cultures, Fêtes et Sports à Saint-Josse\n\nDalle 10.30 alle 18.00 - Ingresso libero\n\nContatti: 06 68 42 55 81 o 06 85 11 16 17\nPer e-mail: lfs.stjosse@free.fr\nCredito: Comitato delle Feste - St Josse"
        ],
        "fr": [
          "Salon des Peintres\nDu samedi 4 au lundi 6 avril \nChemin du Petit Capelle\n-----------------------\nOrganisé par l’Association Loisirs, Cultures, Fêtes et Sports à Saint-Josse\n\nDe 10h30 à 18h - Entrée gratuite\n\nContacts : 06 68 42 55 81 ou 06 85 11 16 17\nPar mail : lfs.stjosse@free.fr \nCrédit : Comité des Fêtes - St Josse"
        ],
        "nl": [
          "Schilders tentoonstelling\nVan zaterdag 4 tot maandag 6 april\nKleine Capelle\n-----------------------\nGeorganiseerd door de vereniging Loisirs, Cultures, Fêtes et Sports à Saint-Josse\n\nVan 10u30 tot 18u - Gratis toegang\n\nContacten: 06 68 42 55 81 of 06 85 11 16 17\nPer e-mail: lfs.stjosse@free.fr\nKrediet: Comité des Fêtes - St Josse"
        ],
        "es": [
          "Salón de Pintores\nDel sábado 4 al lunes 6 de abril\nCamino del Petit Capelle\n-----------------------\nOrganizado por la Association Loisirs, Cultures, Fêtes et Sports à Saint-Josse\n\nDe 10.30 a 18.00 h - Entrada gratuita\n\nContactos: 06 68 42 55 81 o 06 85 11 16 17\nPor correo electrónico: lfs.stjosse@free.fr\nCrédito: Comité des Fêtes - St Josse"
        ]
      },
