  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5fcf8d7c-b221-3f6f-ba22-4c485bb69973",
      "dc:description": {
        "de": [
          "Komitee für Feste und Feiern.\nSie suchen nach Spaß und möchten neue Leute kennenlernen? Die Gais Lurons öffnen ihre Türen für Sie! Entdecken Sie unser vielfältiges Animationsprogramm und nehmen Sie am Leben unserer Gemeinde teil"
        ],
        "en": [
          "Comité des fêtes.\nLooking to have fun and meet new people? Les Gais Lurons opens its doors to you! Discover our varied program of events and take part in the life of our community"
        ],
        "it": [
          "Comitato delle feste.\nVolete divertirvi e conoscere nuove persone? I Gais Lurons sono aperti per voi! Scoprite il nostro variegato programma di eventi e partecipate alla vita della nostra comunità"
        ],
        "fr": [
          "Comité des fêtes.\nVous cherchez à vous amuser et à rencontrer de nouvelles personnes ? Les Gais Lurons vous ouvrent leurs portes ! Découvrez notre programme d'animations variées et participez à la vie de notre commune"
        ],
        "nl": [
          "Comité des fêtes.\nWil je plezier maken en nieuwe mensen ontmoeten? De Gais Lurons staan voor je open! Ontdek ons gevarieerde evenementenprogramma en neem deel aan het leven in onze gemeenschap"
        ],
        "es": [
          "Comité de fiestas.\n¿Quieres divertirte y conocer gente nueva? Los Gais Lurons están abiertos para ti Descubra nuestro variado programa de actos y participe en la vida de nuestra comunidad"
        ]
      },
      "@type": [
        "Description"
      ],
