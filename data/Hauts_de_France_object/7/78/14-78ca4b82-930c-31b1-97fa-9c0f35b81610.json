  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a8b1b58e-20f4-361a-aa82-087f8967d57f",
      "dc:description": {
        "de": [
          "Folgen Sie Henri Dudzinski, Journalist, Diplomat, Experte des Europarats für die Länder Mittel- und Osteuropas und des Kaukasus sowie Vizepräsident des ICEP. Er wird Ihnen wie kein anderer das Schicksal der Polen während des Ersten und Zweiten Weltkriegs schildern."
        ],
        "en": [
          "Follow Henri Dudzinski, journalist, diplomat, Council of Europe expert on Central and Eastern Europe and the Caucasus, and Vice-President of ICEP. He will tell you about the fate of the Poles during the First and Second World Wars, like no one else."
        ],
        "it": [
          "Seguite Henri Dudzinski, giornalista, diplomatico, esperto del Consiglio d'Europa sui Paesi dell'Europa centrale e orientale e del Caucaso e vicepresidente dell'ICEP. Vi racconterà il destino dei polacchi durante la Prima e la Seconda guerra mondiale, come nessun altro."
        ],
        "fr": [
          "Suivez Henri Dudzinski, journaliste, diplomate, expert au Conseil de l’Europe dans les pays d’Europe centrale et orientale, et dans le Caucase et vice-président de l’ICEP. Il vous contera la destinée des Polonais durant la Première et la Seconde Guerre mondiale, comme personne."
        ],
        "nl": [
          "Volg Henri Dudzinski, journalist, diplomaat, deskundige van de Raad van Europa over de landen van Midden- en Oost-Europa en de Kaukasus, en vicevoorzitter van het ICEP. Hij zal je als geen ander vertellen over het lot van de Polen tijdens de Eerste en Tweede Wereldoorlog."
        ],
        "es": [
          "Siga a Henri Dudzinski, periodista, diplomático, experto del Consejo de Europa en los países de Europa Central y Oriental y del Cáucaso, y Vicepresidente del ICEP. Le contará como nadie el destino de los polacos durante la Primera y la Segunda Guerras Mundiales."
        ]
      },
      "@type": [
        "Description"
      ],
