  "rdfs:comment": {
    "de": [
      "Dieser Rundweg beginnt in Lachapelle aux Pots, wo Sie das Töpferei-Museum besuchen können.\nDieser Rundweg führt durch die Ortschaft Blacourt, wo Sie einen Deko- und Trödelladen finden."
    ],
    "en": [
      "This tour starts from Lachapelle aux Pots where you can visit the pottery museum.\nThis loop goes through the village of Blacourt where you will find a shop of decoration and decoration."
    ],
    "it": [
      "Questo circuito inizia a Lachapelle aux Pots, dove si può visitare il museo della ceramica.\nL'anello passa per il villaggio di Blacourt, dove si trova un negozio di oggetti decorativi."
    ],
    "fr": [
      "Ce circuit est au départ de Lachapelle aux Pots ou vous pourrez visiter le musée de la poterie.\nCette boucle passe par le bourg de Blacourt ou vous trouverez une boutique de déco-brocante."
    ],
    "es": [
      "Este circuito comienza en Lachapelle aux Pots, donde podrá visitar el museo de la cerámica.\nEste bucle pasa por el pueblo de Blacourt, donde encontrará una tienda de artículos de decoración."
    ],
    "nl": [
      "Dit circuit begint in Lachapelle aux Pots, waar u het aardewerkmuseum kunt bezoeken.\nDeze lus loopt door het dorp Blacourt waar u een winkel met decoratieve artikelen vindt."
    ]
  },
