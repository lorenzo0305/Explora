      "dc:description": {
        "de": [
          "79, avenue Jean-Jaurès - 01 48 89 34 80\n\nDas Becken ist 25 m lang und 10 m breit und hat einen 3,75 m breiten Schwimmkorridor - Wassertemperatur durchschnittlich 29 bis 30 °C."
        ],
        "en": [
          "79, avenue Jean-Jaurès - +33 (0)1 48 89 34 80\n\nThe pool is 25 m long and 10 m wide and includes a 3.75 m wide swimming corridor - water temperature of 29 to 30°C on average."
        ],
        "it": [
          "79, avenue Jean-Jaurès - 01 48 89 34 80\n\nLa piscina è lunga 25 m e larga 10 m e comprende un corridoio per nuotare largo 3,75 m - temperatura media dell'acqua di 29-30°C."
        ],
        "fr": [
          "79, avenue Jean-Jaurès - 01 48 89 34 80\n\nLe bassin fait 25 m de long sur 10 m de large et comprend un couloir de nage de 3,75 m de large - température de l'eau de 29 à 30°C en moyenne."
        ],
        "es": [
          "79, avenue Jean-Jaurès - 01 48 89 34 80\n\nLa piscina tiene 25 m de largo y 10 m de ancho e incluye un pasillo de natación de 3,75 m de ancho - temperatura media del agua de 29 a 30°C."
        ],
        "nl": [
          "79, avenue Jean-Jaurès - 01 48 89 34 80\n\nHet zwembad is 25 m lang en 10 m breed en bevat een 3,75 m brede zwemgang - gemiddelde watertemperatuur van 29 tot 30°C."
        ]
      },
