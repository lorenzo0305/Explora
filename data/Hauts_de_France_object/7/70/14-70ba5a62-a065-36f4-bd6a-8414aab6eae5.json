  "rdfs:comment": {
    "de": [
      "Anlässlich der Europäischen Tage des Denkmals können Sie an einer Konferenz zum Thema \"Architektur im Dienste der Erinnerung\" teilnehmen, die von Philippe Prost, dem Architekten des \"Anneau de la mémoire\", geleitet wird."
    ],
    "en": [
      "On the occasion of the European Heritage Days, join Philippe Prost, architect of the Anneau de la Mémoire, for a lecture entitled \"Architecture in the service of Memory\"."
    ],
    "it": [
      "Nell'ambito delle Giornate Europee del Patrimonio, partecipate alla conferenza \"L'architettura al servizio della memoria\" di Philippe Prost, architetto dell'Anneau de la Mémoire."
    ],
    "fr": [
      "À l’occasion des Journées Européennes du Patrimoine, assistez à une conférence intitulée « l’Architecture au service de la Mémoire » animée par Philippe Prost, architecte de l’Anneau de la mémoire."
    ],
    "nl": [
      "Woon in het kader van de Europese Erfgoeddagen een lezing bij over \"Architectuur in dienst van het gedenken\" door Philippe Prost, architect van de Anneau de la Mémoire."
    ],
    "es": [
      "En el marco de las Jornadas Europeas del Patrimonio, asista a una conferencia titulada \"La arquitectura al servicio del recuerdo\", a cargo de Philippe Prost, arquitecto del Anneau de la Mémoire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence Architectes au service de la mémoire - Journées Européennes du Patrimoine"
    ]
  },
