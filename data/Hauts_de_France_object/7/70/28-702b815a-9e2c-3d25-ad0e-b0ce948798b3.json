  "rdfs:comment": {
    "de": [
      "Outre-Scarpe, der Vorort von Béthune entwickelte sich rund um seine reich verzierten Schulen. Das Art déco eroberte das Viertel, die Stile vermischten sich, die Straßen erhielten ländliche Namen."
    ],
    "en": [
      "Across the river, the faubourg de Béthune grew up around its richly decorated schools. Art Deco took hold of the area, styles blended and streets took on pastoral names."
    ],
    "it": [
      "Dall'altra parte del Carpe, il Faubourg de Béthune è cresciuto intorno alle sue scuole riccamente decorate. L'Art déco si impadronì della zona, gli stili si mescolarono e le strade assunsero nomi di paesi."
    ],
    "fr": [
      "Outre-Scarpe, le faubourg de Béthune se développe autour de ses écoles richement décorées. L’Art déco s’empare du quartier, les styles se mélangent, les rues prennent des noms champêtres."
    ],
    "es": [
      "Al otro lado del Carpe, el Faubourg de Béthune creció en torno a sus escuelas ricamente decoradas. El art déco se apoderó de la zona, los estilos se mezclaron y las calles adoptaron nombres campestres."
    ],
    "nl": [
      "Aan de overkant van de Carpe groeide de Faubourg de Béthune op rond de rijkelijk versierde scholen. Art deco nam bezit van de wijk, stijlen vermengden zich en straten namen landelijke namen aan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Art déco des faubourgs"
    ]
  },
