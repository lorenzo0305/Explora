  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1f9e5a9a-f91e-3c34-9271-6889bcf75711",
      "dc:description": {
        "de": [
          "Das Hotel Saint-Sébastien ist ein ehemaliges Relais de Diligence und befindet sich auf dem Platz von Blendecques, gegenüber seiner wunderschönen Kirche. Es verfügt über ein gemütliches Restaurant, in dem Frau Duhamel Sie in einer herzlichen Atmosphäre empfängt."
        ],
        "en": [
          "The Hotel Saint-Sébastien is a former Relais de Diligence, located on the Place de Blendecques, opposite its magnificent church, with a friendly restaurant where Mrs Duhamel will welcome you in a warm atmosphere."
        ],
        "it": [
          "L'Hotel Saint-Sébastien è un ex Relais de Diligence, situato sulla piazza di Blendecques, di fronte alla sua magnifica chiesa, con un ristorante accogliente dove la signora Duhamel vi accoglierà in una calda atmosfera."
        ],
        "fr": [
          "L'hôtel Saint-Sébastien est un ancien Relais de Diligence, situé sur la place de Blendecques,  en face de sa magnifique église, avec un restaurant convivial où Mme Duhamel vous accueillera dans une ambiance chaleureuse."
        ],
        "nl": [
          "Hotel Saint-Sébastien is een voormalig Relais de Diligence, gelegen aan het plein van Blendecques, tegenover de prachtige kerk, met een gezellig restaurant waar mevrouw Duhamel u in een warme sfeer zal ontvangen."
        ],
        "es": [
          "El hotel Saint-Sébastien es un antiguo Relais de Diligence, situado en la plaza de Blendecques, frente a su magnífica iglesia, con un acogedor restaurante donde la Sra. Duhamel le dará la bienvenida en un ambiente cálido."
        ]
      },
