  "rdfs:comment": {
    "de": [
      "Dieses schöne flämische Gebäude, das sich zwischen Bäumen an den Hang des Katenbergs schmiegt, bietet Ihnen nicht nur eine außergewöhnliche Aussicht, sondern auch einen schönen Spaziergang durch die flämische Gastronomie."
    ],
    "en": [
      "Nestled among the trees, this beautiful Flemish building on the slopes of the Mont des Cats offers not only an exceptional view, but also a delightful stroll through Flemish gastronomy."
    ],
    "it": [
      "Immerso tra gli alberi, questo splendido edificio fiammingo alle pendici del Mont des Cats offre non solo una vista eccezionale, ma anche una deliziosa passeggiata nella gastronomia fiamminga."
    ],
    "fr": [
      "Nichée entre les arbres, cette belle bâtisse flamande adossée à la pente du Mont des Cats vous offrira, en plus d'une vue exceptionnelle, une jolie balade dans la gastronomie flamande."
    ],
    "es": [
      "Enclavado entre los árboles, este bello edificio flamenco situado en la ladera del Mont des Cats ofrece no sólo una vista excepcional, sino también un delicioso paseo por la gastronomía flamenca."
    ],
    "nl": [
      "Dit prachtige Vlaamse gebouw op de hellingen van de Mont des Cats ligt verscholen tussen de bomen en biedt niet alleen een uitzonderlijk uitzicht, maar ook een heerlijke wandeling door de Vlaamse gastronomie."
    ]
  },
