  "rdfs:comment": {
    "de": [
      "Das Meisterwerk von Reginald Rose, das bei den Crystal Globes 2018 als bestes Theaterstück ausgezeichnet wurde, kehrt für eine neue Saison zurück. Ein unter Hochspannung stehendes Verlies, das bereits mehr als 250.000 Zuschauer begeistert hat."
    ],
    "en": [
      "Reginald Rose's masterpiece, Best Play at the 2018 Crystal Globes, returns for a new season. A high-tension behind-closed-doors drama that has already seduced more than 250,000 spectators."
    ],
    "it": [
      "Il capolavoro di Reginald Rose, miglior spettacolo ai Crystal Globes 2018, torna per una nuova stagione. Un thriller ad alta tensione a porte chiuse che ha già sedotto più di 250.000 spettatori."
    ],
    "fr": [
      "Le chef-d'oeuvre de Reginald Rose, Meilleure pièce de théâtre des Globes de Cristal 2018, revient pour une nouvelle saison. Un huis clos sous haute tension qui a déjà séduit plus de 250 000 spectateurs."
    ],
    "es": [
      "La obra maestra de Reginald Rose, Mejor Obra de Teatro en los Globos de Cristal 2018, regresa para una nueva temporada. Un thriller de alta tensión a puerta cerrada que ya ha seducido a más de 250.000 espectadores."
    ],
    "nl": [
      "Het meesterwerk van Reginald Rose, Best Play bij de 2018 Crystal Globes, keert terug voor een nieuw seizoen. Een spannende thriller achter gesloten deuren die al meer dan 250.000 toeschouwers heeft verleid."
    ]
  },
