  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5eee317e-e2db-38be-915c-4a8a74fa6b0a",
      "dc:description": {
        "de": [
          "Die Mediathek von Saint-Ouen empfängt Sie :\n- am Montag von 14:00 bis 18:00 Uhr ;\n- dienstags von 14:00 bis 19:00 Uhr ;\n- mittwoch von 10:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr ;\n- freitags von 10:00 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr ;\n- samstags von 9:00 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr.\n\nInoformatische Schulungen"
        ],
        "en": [
          "The media library of Saint-Ouen welcomes you:\n- monday from 14h00 to 18h00;\n- tuesday from 14h00 to 19h00;\n- wednesdays from 10:00 to 12:00 and from 14:00 to 18:00;\n- friday from 10:00 to 12:30 and from 14:00 to 19:00;\n- saturday from 9:00 to 12:00 and from 14:00 to 17:00.\n\nFormations inoformatique"
        ],
        "it": [
          "La mediateca di Saint-Ouen vi dà il benvenuto:\n- lunedì dalle 14:00 alle 18:00;\n- martedì dalle 14.00 alle 19.00;\n- mercoledì dalle 10.00 alle 12.00 e dalle 14.00 alle 18.00;\n- venerdì dalle 10.00 alle 12.30 e dalle 14.00 alle 19.00;\n- sabato dalle 9.00 alle 12.00 e dalle 14.00 alle 17.00.\n\nCorsi di formazione"
        ],
        "fr": [
          "La médiathèque de Saint-Ouen vous accueille :\n- le lundi de 14h00 à 18h00 ;\n- le mardi de 14h00 à 19h00 ;\n- le mercredi de 10h00 à 12h00 et de 14h00 à 18h00 ;\n- le vendredi de 10h00 à 12h30 et de 14h00 à 19h00 ;\n- le samedi de 9h00 à 12h00 et de 14h00 à 17h00.\n\nFormations inoformatique"
        ],
        "es": [
          "La mediateca de Saint-Ouen le da la bienvenida :\n- lunes de 14 a 18 horas;\n- martes de 14 a 19 horas;\n- miércoles de 10 a 12 y de 14 a 18 horas;\n- viernes de 10:00 a 12:30 y de 14:00 a 19:00;\n- sábado de 9 a 12 y de 14 a 17 horas.\n\nCursos de formación"
        ],
        "nl": [
          "De mediatheek van Saint-Ouen heet u welkom:\n- maandag van 14.00 tot 18.00 uur;\n- dinsdag van 14.00 tot 19.00 uur;\n- woensdag van 10 tot 12 uur en van 14 tot 18 uur;\n- vrijdag van 10.00 tot 12.30 uur en van 14.00 tot 19.00 uur;\n- zaterdag van 9 tot 12 uur en van 14 tot 17 uur.\n\nOpleidingen"
        ]
      },
