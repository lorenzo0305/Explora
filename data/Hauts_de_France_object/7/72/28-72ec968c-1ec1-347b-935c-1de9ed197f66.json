  "rdfs:comment": {
    "de": [
      "Lilisushi ist ein asiatisches Restaurant, das seinen Gästen eine große Auswahl an Gerichten aus hochwertigen Zutaten anbietet. Es gibt japanische und thailändische Gerichte, die Sie nach Belieben genießen können."
    ],
    "en": [
      "Lilisushi is an Asian restaurant offering its customers a wide variety of dishes made with high-quality ingredients. You'll find Japanese and Thai dishes to enjoy on an all-you-can-eat basis."
    ],
    "it": [
      "Lilisushi è un ristorante asiatico che offre ai suoi clienti un'ampia varietà di piatti preparati con ingredienti di alta qualità. I piatti giapponesi e thailandesi sono disponibili a volontà."
    ],
    "fr": [
      "Lilisushi est un restaurant asiatique qui propose à sa clientèle une grande variété de plat confectionné avec  des ingrédients de haute qualité. Vous pourrez y retrouver des plats japonais et thaïlandais à déguster en formule à volonté."
    ],
    "nl": [
      "Lilisushi is een Aziatisch restaurant dat zijn klanten een grote verscheidenheid aan gerechten biedt, gemaakt met ingrediënten van hoge kwaliteit. Japanse en Thaise gerechten zijn verkrijgbaar op basis van all-you-can-eat."
    ],
    "es": [
      "Lilisushi es un restaurante asiático que ofrece a sus clientes una amplia variedad de platos elaborados con ingredientes de alta calidad. Los platos japoneses y tailandeses están disponibles en la modalidad \"todo lo que puedas comer\"."
    ]
  },
