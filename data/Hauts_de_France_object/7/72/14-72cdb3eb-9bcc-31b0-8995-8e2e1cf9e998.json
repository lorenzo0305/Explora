  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/17693fee-3eea-3518-b1bf-65c663a8c496",
      "dc:description": {
        "de": [
          "Unsere Schließfächer bieten das Beste aus bäuerlichen und lokalen Produkten.\nGute Produkte aus der Gegend, direkt von den Erzeugern, verfügbar, wann immer Sie wollen. Einfach, gut, wahr."
        ],
        "en": [
          "Our crates offer the best of local farm produce.\nGood local produce, direct from the producers, available when you want it. Simple, good, true."
        ],
        "it": [
          "Le nostre casse offrono il meglio dei prodotti agricoli locali.\nBuoni prodotti locali, direttamente dai produttori, disponibili quando li volete. Semplice, buono, vero."
        ],
        "fr": [
          "Nos casiers proposent le meilleur des produits fermiers et locaux. \nDes bons produits du coin, en direct des producteurs, disponibles quand vous voulez. Simple, bon, vrai."
        ],
        "nl": [
          "Onze kratten bieden het beste van lokale boerderijproducten.\nGoede lokale producten, rechtstreeks van de producenten, beschikbaar wanneer jij het wilt. Eenvoudig, goed, echt."
        ],
        "es": [
          "Nuestras cajas ofrecen lo mejor de los productos agrícolas locales.\nBuenos productos locales, directamente de los productores, disponibles cuando los desee. Sencillo, bueno, verdadero."
        ]
      },
