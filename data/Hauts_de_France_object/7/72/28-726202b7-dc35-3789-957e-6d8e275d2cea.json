  "rdfs:comment": {
    "de": [
      "Das Museum befindet sich in den alten Gewölbekellern des Schlosses von Flers. Es hebt die Archäologie, die lokale Geschichte und die regionale Ethnografie hervor und lädt Sie zu einem Spaziergang durch seine Sonderausstellungen ein."
    ],
    "en": [
      "Located in the former vaulted cellars of the Château de Flers, the museum showcases archaeology, local history and regional ethnography, and invites you to wander through its temporary exhibitions."
    ],
    "it": [
      "Situato nelle antiche cantine a volta dello Château de Flers, il museo presenta archeologia, storia locale ed etnografia regionale e invita a visitare le sue mostre temporanee."
    ],
    "fr": [
      "Situé dans les anciennes caves voûtées du Château de Flers, le musée met en valeur l'archéologie, l'histoire locale et l'ethnographie régionale et vous invite à la déambulation dans ses expositions temporaires."
    ],
    "es": [
      "Situado en las antiguas bodegas abovedadas del castillo de Flers, el museo presenta arqueología, historia local y etnografía regional, y le invita a pasear por sus exposiciones temporales."
    ],
    "nl": [
      "Het museum is gevestigd in de voormalige gewelfde kelders van het Château de Flers en laat archeologie, lokale geschiedenis en regionale etnografie zien. Het nodigt je uit om door de tijdelijke tentoonstellingen te wandelen."
    ]
  },
