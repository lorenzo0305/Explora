  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3ae65d10-a969-3e7d-892e-aad33bfc908c",
      "dc:description": {
        "de": [
          "Es ist Sommer, Zeit für Siesta und Faulenzen! Machen Sie mit uns eine musikalische Siesta mit dem Künstler Jérôme Bailly, basteln Sie mit der ganzen Familie eine Postkarte aus Ton oder erklimmen Sie die Halde mit einem Naturpädagogen von Aquaterra."
        ],
        "en": [
          "It's summertime, time for a siesta and a bit of idleness! Join us for a musical siesta with artist Jérôme Bailly, make a clay postcard as a family or climb the terril with an Aquaterra nature guide."
        ],
        "it": [
          "È estate, è tempo di una siesta e di un po' di relax! Unitevi a noi per una siesta musicale con l'artista Jérôme Bailly, realizzate una cartolina di argilla in famiglia o salite sul terril con una guida naturalistica di Aquaterra."
        ],
        "fr": [
          "C’est l’été, l’heure est à la sieste et au farniente ! Venez nous rejoindre pour une sieste musicale en compagnie de l’artiste Jérôme Bailly, réaliser une carte postale en argile en famille ou encore partir à l’ascension du terril en compagnie d’un animateur nature d’Aquaterra."
        ],
        "nl": [
          "Het is zomer, tijd voor een siësta en een beetje ontspanning! Kom bij ons voor een muzikale siësta met kunstenaar Jérôme Bailly, maak met het gezin een ansichtkaart van klei of beklim de terril met een Aquaterra natuurgids."
        ],
        "es": [
          "Es verano, ¡tiempo de siesta y un poco de relax! Acompáñenos en una siesta musical con el artista Jérôme Bailly, haga una postal de arcilla en familia o suba al terril con un guía de naturaleza de Aquaterra."
        ]
      },
      "@type": [
        "Description"
      ],
