    "de": [
      "Entdecken Sie anlässlich der Europäischen Tage des Denkmals Geschichten, die mit den Werken des Museums in Verbindung stehen."
    ],
    "en": [
      "On the occasion of the European Heritage Days, come and discover stories linked to the museum's works."
    ],
    "it": [
      "In occasione delle Giornate Europee del Patrimonio, venite a scoprire le storie legate alle opere del museo."
    ],
    "fr": [
      "A l'occasion des Journées européennes du patrimoine, venez découvrir des histoires en lien avec les œuvres du musée."
    ],
    "nl": [
