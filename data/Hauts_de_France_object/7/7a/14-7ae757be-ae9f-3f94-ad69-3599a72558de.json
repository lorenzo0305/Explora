      "dc:description": {
        "de": [
          "Der Verein organisiert eine Fahrradtour auf den Straßen von Montreuil-sur-Mer. Etwa 150 bis 200 Teilnehmer werden drei Strecken von 30, 60 und 90 km zurücklegen."
        ],
        "en": [
          "The association is organizing a cycle tour on the roads of Montreuil-sur-mer. Around 150 to 200 participants will cover 3 routes of 30, 60 and 90 km."
        ],
        "it": [
          "L'associazione organizza un tour ciclistico sulle strade di Montreuil-sur-mer. Circa 150-200 partecipanti percorreranno 3 percorsi di 30, 60 e 90 km."
        ],
        "fr": [
          "L’association organise une randonnée cyclotouriste sur les routes de Montreuil-sur-mer. Environ 150 à 200 participants arpenteront 3 parcours de 30, 60 et 90 km."
        ],
        "es": [
          "La asociación organiza una vuelta ciclista por las carreteras de Montreuil-sur-mer. Entre 150 y 200 participantes recorrerán 3 rutas de 30, 60 y 90 km."
        ],
        "nl": [
          "De vereniging organiseert een fietstocht over de wegen van Montreuil-sur-mer. Ongeveer 150 tot 200 deelnemers zullen 3 routes van 30, 60 en 90 km afleggen."
        ]
      },
