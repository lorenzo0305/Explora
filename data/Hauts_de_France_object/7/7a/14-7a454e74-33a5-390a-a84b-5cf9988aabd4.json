  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1a50023e-c4c1-3a9d-a5a0-47eaea00589f",
      "dc:description": {
        "de": [
          "Das Atelier Théâtre du Fliers ist eine Amateurtheatergruppe mit Sitz in Rang-du-Fliers. In 40 Jahren hat sie 17 Stücke aufgeführt und am 9., 10. und 11. Juni 2023 ein Festival organisiert."
        ],
        "en": [
          "L'Atelier Théâtre du Fliers is an amateur theater company based in Rang-du-Fliers. In 40 years, it has performed 17 plays and organized a festival on June 9, 10 and 11, 2023."
        ],
        "it": [
          "L'Atelier Théâtre du Fliers è una compagnia teatrale amatoriale con sede a Rang-du-Fliers. In 40 anni ha rappresentato 17 spettacoli e ha organizzato un festival il 9, 10 e 11 giugno 2023."
        ],
        "fr": [
          "L'Atelier Théâtre du Fliers est une compagnie de théâtre amateur basée à Rang-du-Fliers. En 40 ans, elle a joué 17 pièces et organisé un festival les 9, 10 et 11 juin 2023."
        ],
        "nl": [
          "Het Atelier Théâtre du Fliers is een amateurtheatergezelschap uit Rang-du-Fliers. In 40 jaar heeft het 17 toneelstukken opgevoerd en een festival georganiseerd op 9, 10 en 11 juni 2023."
        ],
        "es": [
          "El Atelier Théâtre du Fliers es una compañía de teatro aficionado con sede en Rang-du-Fliers. En 40 años ha representado 17 obras y ha organizado un festival los días 9, 10 y 11 de junio de 2023."
        ]
      },
