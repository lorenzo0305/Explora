      "@id": "https://data.datatourisme.fr/dd031371-31ef-30f4-89e2-a97cffa8dd20",
      "dc:description": {
        "de": [
          "Handwerkliche Herstellung von Konfitüren und Sirupen, ohne Farb- und Konservierungsstoffe. Die Früchte werden von Hand gepflückt und verarbeitet."
        ],
        "en": [
          "Artisanal manufacture of jams and syrups, without coloring nor conservative. The fruits are picked and worked by hand."
        ],
        "it": [
          "Produzione artigianale di marmellate e sciroppi, senza coloranti né conservanti. La frutta viene raccolta e lavorata a mano."
        ],
        "fr": [
          "Fabrication artisanale de confitures et sirops, sans colorant ni conservateur. Les fruits sont cueillis et travaillés à la main."
        ],
        "es": [
          "Producción artesanal de mermeladas y jarabes, sin colorantes ni conservantes. La fruta se recoge y procesa a mano."
        ],
        "nl": [
          "Ambachtelijke productie van jams en siropen, zonder kleurstoffen of bewaarmiddelen. Het fruit wordt met de hand geplukt en verwerkt."
        ]
      },
