  "rdfs:comment": {
    "de": [
      "Ein musikalisches Duo, das Sie zur Feier des Tages der Frauenrechte wiedersehen werden. Während dieses Abends wird Ihnen Bardot mit Freiheit, Unbeschwertheit und Glück erzählt!"
    ],
    "en": [
      "A musical duo you'll have the pleasure of meeting again to celebrate Women's Rights Day. During this evening, Bardot will be told to you with freedom, carefreeness and happiness!"
    ],
    "it": [
      "Un duo musicale che sarete felici di incontrare di nuovo per celebrare la Giornata dei Diritti della Donna. Durante questa serata, la Bardot vi sarà raccontata con libertà, spensieratezza e allegria!"
    ],
    "fr": [
      "Un duo musical que vous aurez le plaisir de retrouver pour célébrer la journée des droits des Femmes. Durant cette soirée, Bardot vous sera contée avec liberté, insouciance et bonheur !"
    ],
    "es": [
      "Un dúo musical con el que estará encantada de reencontrarse para celebrar el Día de los Derechos de la Mujer. ¡Durante esta velada, Bardot te será relatada con libertad, despreocupación y alegría!"
    ],
    "nl": [
      "Een muzikaal duo dat je graag weer zult ontmoeten om de Dag van de Rechten van de Vrouw te vieren. Tijdens deze avond zal Bardot je worden voorgelezen met vrijheid, zorgeloosheid en geluk!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "B+B= BB, si Brigitte Bardot m'était contée !"
    ]
  },
