  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f03cb2b9-6c2d-3506-bb8a-ff8422c736cf",
      "dc:description": {
        "de": [
          "Vortragsreihe \"Montreuillois en Côte d?Opale\"\nSamstag, den 28. März um 17 Uhr\nFremdenverkehrsamt von Montreuil-sur-Mer\n---------------------------\nThema: Einrichtung des Großen Britischen Hauptquartiers\nVon Gérard Robette-Papet\n\nDauer: 1 Std. - Kostenlos - Zusammenarbeit mit der Abteilung für Kulturerbe des OTMCO mit Herrn Robette-Papet\n\nReservierung wird empfohlen: 03 21 06 04 27\nPer E-Mail: accueil@destinationmontreuilsurmer.com\nAuf der Website: www.destinationmontreuilloisencotedopale.com\n\nBildnachweis: Service Patrimoine/IWM"
        ],
        "en": [
          "Cycle de Conférences du Montreuillois en Côte d?Opale\nSaturday March 28th at 5pm\nMontreuil-sur-Mer Tourist Office\n---------------------------\nTopic: Installation of the Great British Headquarters\nBy Gérard Robette-Papet\n\nDuration: 1h - Free - Collaboration with the OTMCO Heritage Department with Mr. Robette-Papet\n\nReservations recommended: 03 21 06 04 27\nBy e-mail: accueil@destinationmontreuilsurmer.com\nOn site: www.destinationmontreuilloisencotedopale.com\n\nPhoto credit: Service Patrimoine/IWM"
        ],
        "it": [
          "Ciclo di conferenze del Montreuillois in Costa d'Opale\nSabato 28 marzo alle 17.00\nUfficio del Turismo di Montreuil-sur-Mer\n---------------------------\nArgomento: Installazione della Grande Sede Britannica\nDi Gérard Robette-Papet\n\nDurata: 1 ora - Gratuito - In collaborazione con il Dipartimento del Patrimonio dell'OTMCO e il sig. Robette-Papet\n\nPrenotazione consigliata: 03 21 06 04 27\nPer e-mail: accueil@destinationmontreuilsurmer.com\nSul posto: www.destinationmontreuilloisencotedopale.com\n\nCrediti fotografici: Servizio Patrimonio/IWM"
        ],
        "fr": [
          "Cycle de Conférences du Montreuillois en Côte d’Opale\nSamedi 28 mars à 17h \nOffice de Tourisme de Montreuil-sur-Mer\n---------------------------\nSujet : Installation du Grand Quartier Général Britannique\nPar Gérard Robette-Papet\n\nDurée : 1h - Gratuit - Collaboration avec le Service Patrimoine de l’OTMCO avec M. Robette-Papet\n\nRéservation conseillée : 03 21 06 04 27\nPar mail : accueil@destinationmontreuilsurmer.com\nSur site : www.destinationmontreuilloisencotedopale.com\n\nCrédit photo : Service Patrimoine/IWM"
        ],
        "nl": [
          "Conferentiecyclus van de Montreuillois en Opaalkust\nZaterdag 28 maart om 17 uur\nToeristische dienst Montreuil-sur-Mer\n---------------------------\nOnderwerp: Installatie van het Britse hoofdkwartier\nDoor Gérard Robette-Papet\n\nDuur: 1 uur - Gratis - In samenwerking met de afdeling Erfgoed van OTMCO en de heer Robette-Papet\n\nReservering aanbevolen: 03 21 06 04 27\nPer e-mail: accueil@destinationmontreuilsurmer.com\nTer plaatse: www.destinationmontreuilloisencotedopale.com\n\nFoto krediet: Service Patrimoine/IWM"
        ],
        "es": [
          "Ciclo de Conferencias de Montreuillois en Côte d'Opale\nSábado 28 de marzo a las 17.00 horas\nOficina de Turismo de Montreuil-sur-Mer\n---------------------------\nTema: Instalación del Gran Cuartel General Británico\nPor Gérard Robette-Papet\n\nDuración: 1 hora - Gratuito - En colaboración con el Departamento de Patrimonio de la OTMCO y el Sr. Robette-Papet\n\nReserva recomendada: 03 21 06 04 27\nPor correo electrónico: accueil@destinationmontreuilsurmer.com\nIn situ: www.destinationmontreuilloisencotedopale.com\n\nCrédito de la foto: Service Patrimoine/IWM"
        ]
      },
