  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ac40cadd-688d-30a6-9869-32212b43170b",
      "dc:description": {
        "de": [
          "Genießen Sie die ruhige und gemütliche Atmosphäre des Restaurants L?Orangerie. Das Restaurant des Hôtel du Parc bietet Ihnen traditionelle Küche und Gerichte aus dem Boulonnais, die Sie in einer angenehmen Atmosphäre genießen können.\n\nDie Speisekarte mit regionalen und maritimen Gerichten wird aus sorgfältig ausgewählten frischen Produkten zubereitet."
        ],
        "en": [
          "Sit down in the calm and warm decor of the restaurant L?Orangerie. The restaurant of the Hotel du Parc offers you a traditional and local cuisine to be savored in a pleasant atmosphere.\n\nIts menu features local and seafood flavors and is prepared with carefully selected fresh products."
        ],
        "it": [
          "Accomodatevi e rilassatevi nell'arredamento calmo e accogliente del ristorante L'Orangerie. Il ristorante dell'Hôtel du Parc offre una cucina tradizionale e locale in un'atmosfera piacevole.\n\nIl menu è caratterizzato da sapori locali e di mare e da prodotti freschi accuratamente selezionati."
        ],
        "fr": [
          "Attablez-vous dans le décor calme et chaleureux du restaurant L’Orangerie. Le restaurant de l’Hôtel du Parc vous propose une cuisine traditionnelle et du boulonnais à savourer dans une ambiance agréable.\n\nSa carte déclinant les saveurs du terroir et de la mer est élaborée à partir de produits frais sélectionnés avec soin."
        ],
        "es": [
          "Siéntese y relájese en la tranquila y cálida decoración del restaurante L'Orangerie. El restaurante del Hôtel du Parc ofrece cocina tradicional y local en un ambiente agradable.\n\nEl menú se caracteriza por los sabores locales y marinos y se elabora con productos frescos cuidadosamente seleccionados."
        ],
        "nl": [
          "Leun achterover en ontspan in de rustige en warme inrichting van restaurant L'Orangerie. Het restaurant van Hôtel du Parc biedt traditionele en lokale gerechten in een aangename sfeer.\n\nHet menu bevat lokale smaken en zeevruchten en is samengesteld uit zorgvuldig geselecteerde verse producten."
        ]
      },
