  "rdfs:comment": {
    "de": [
      "Genießen Sie im Winter die knisternden Flammen am Kamin oder im Sommer den Blick auf den Garten, wenn Sie es sich auf der Terrasse im Schatten gemütlich machen. Sie haben die Wahl!"
    ],
    "en": [
      "Enjoy the crackling flames by the fireplace in the winter, or the view of the garden from the terrace in the summer. The choice is yours!"
    ],
    "it": [
      "Godetevi le fiamme scoppiettanti del camino in inverno o la vista sul giardino dalla terrazza in estate. A voi la scelta!"
    ],
    "fr": [
      "Profitez des flammes crépitantes au coin de la cheminée, l'hiver, ou de la vue sur le jardin, installé confortablement à l'ombre sur la terrasse, l'été. A vous de choisir!"
    ],
    "nl": [
      "Geniet in de winter van de knisperende vlammen bij de open haard of in de zomer van het uitzicht op de tuin vanaf het terras. De keuze is aan u!"
    ],
    "es": [
      "Disfrute del crepitar de las llamas junto a la chimenea en invierno o de las vistas al jardín desde la terraza en verano. ¡Tú eliges!"
    ]
  },
