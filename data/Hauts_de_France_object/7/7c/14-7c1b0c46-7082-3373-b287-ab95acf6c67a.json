  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6b4e8350-df2a-32e5-91bb-e503289932b4",
      "dc:description": {
        "de": [
          "Anne Ducros, die Jazzsängerin, um die uns Amerika beneidet, interpretiert die berühmtesten Themen der Soundtracks des französischen und internationalen Kinos, von Michel Legrand bis Eric Clapton, von Joni Mitchell bis Jeanne Moreau."
        ],
        "en": [
          "Anne Ducros, the jazz singer America envies, performs the most famous themes from French and international film soundtracks, from Michel Legrand to Eric Clapton, from Joni Mitchell to Jeanne Moreau."
        ],
        "it": [
          "Anne Ducros, la cantante jazz che l'America ci invidia, interpreta i temi più famosi delle colonne sonore di film francesi e internazionali, da Michel Legrand a Eric Clapton, da Joni Mitchell a Jeanne Moreau."
        ],
        "fr": [
          "Anne Ducros, la chanteuse de jazz que nous envie l’Amérique, interprète les thèmes les plus célèbres des bandes originales du cinéma français et international, de Michel Legrand à Eric Clapton, de Joni Mitchell à Jeanne Moreau."
        ],
        "es": [
          "Anne Ducros, la cantante de jazz que América envidia, interpreta los temas más famosos de las bandas sonoras de películas francesas e internacionales, de Michel Legrand a Eric Clapton, de Joni Mitchell a Jeanne Moreau."
        ],
        "nl": [
          "Anne Ducros, de jazz-zangeres die Amerika benijdt, vertolkt de beroemdste thema's van Franse en internationale soundtracks, van Michel Legrand tot Eric Clapton, van Joni Mitchell tot Jeanne Moreau."
        ]
      },
