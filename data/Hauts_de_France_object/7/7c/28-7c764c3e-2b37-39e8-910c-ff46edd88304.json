  "rdfs:comment": {
    "de": [
      "Ideal gelegen zwischen Calais und Dünkirchen und nur wenige Schritte von der Transmanche entfernt, ist unser Première Classe Hotel von der A16 aus leicht zu erreichen.\nEin idealer Zwischenstopp für einen erholsamen Aufenthalt."
    ],
    "en": [
      "Ideally located between Calais and Dunkerque and close to the trans-channel road, our Première Classe hotel is easily accessible from the A16.\nAn ideal stopover for a relaxing stay."
    ],
    "it": [
      "Situato in posizione ideale tra Calais e Dunkerque e a due passi dalla Manica, il nostro hotel Première Classe è facilmente raggiungibile dalla A16.\nUna tappa ideale per un soggiorno rilassante."
    ],
    "fr": [
      "Idéalement situé entre Calais et Dunkerque et à deux pas du trans-manche, notre hôtel Première Classe est facilement accessible de l'A16. \nUne étape idéale pour un séjour de détente."
    ],
    "nl": [
      "Ons Première Classe hotel is ideaal gelegen tussen Calais en Duinkerken en op een steenworp afstand van het trans-kanaal en is gemakkelijk bereikbaar vanaf de A16.\nEen ideale tussenstop voor een ontspannen verblijf."
    ],
    "es": [
      "Idealmente situado entre Calais y Dunkerque y a dos pasos del Canal de la Mancha, nuestro hotel Première Classe es fácilmente accesible desde la A16.\nUna parada ideal para una estancia relajante."
    ]
  },
