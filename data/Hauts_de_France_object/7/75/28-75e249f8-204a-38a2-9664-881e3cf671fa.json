  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration in einem gemütlichen Rahmen mit hausgemachten Gerichten.\nZusätzlich zur saisonal wechselnden Speisekarte bieten wir täglich wechselnde Gerichte und Desserts auf der Schiefertafel an"
    ],
    "en": [
      "Traditional restoration in a warm setting, home-made dishes.\nIn addition to the menu, which changes according to the season, we offer dishes and desserts on the slate that are different every day"
    ],
    "it": [
      "Ristorante tradizionale in un ambiente accogliente, con piatti fatti in casa.\nOltre al menu, che cambia a seconda della stagione, offriamo ogni giorno piatti e dessert diversi"
    ],
    "fr": [
      "Restauration traditionnelle dans un cadre chaleureux , plats faits maison. \nEn plus de la carte changeant suivant la saison nous proposons plats et desserts à l'ardoise différents chaque jour"
    ],
    "nl": [
      "Traditioneel restaurant in een warme omgeving, met huisgemaakte gerechten.\nNaast het menu, dat afhankelijk van het seizoen verandert, bieden we elke dag andere gerechten en desserts"
    ],
    "es": [
      "Restaurante tradicional en un ambiente cálido, con platos caseros.\nAdemás de la carta, que cambia según la temporada, ofrecemos platos y postres diferentes cada día"
    ]
  },
