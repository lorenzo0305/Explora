  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a82ce9ba-7025-35c2-84e8-e36782147a77",
      "dc:description": {
        "de": [
          "Eine Harfe, auf der man Pop, Rock, Coverversionen von Bowie, Muse, Red Hot und\nBjörk! Das ist die akustische Zauberformel, die immer funktioniert! Und für noch mehr Originalität fügen wir zeitgenössische Trip-Hop-Kompositionen, Elektro, Kicks und schwere Bässe hinzu!"
        ],
        "en": [
          "Harp to play pop, rock, covers of Bowie, Muse, Red Hot, Björk!\nBjörk! That's the magic acoustic formula that works! And for added originality, we add contemporary trip-hop compo, electro, kicks and heavy bass!"
        ],
        "it": [
          "L'arpa per suonare pop, rock, cover di Bowie, Muse, Red Hot, Björk!\nBjörk! Questa è la formula acustica magica che funziona! E per una maggiore originalità, aggiungiamo trip-hop contemporaneo, electro, kick e bassi pesanti!"
        ],
        "fr": [
          "De la harpe pour jouer de la pop, du rock, des reprises de Bowie, de Muse, des Red Hot, de\nBjörk! Ça, c’est la formule magique acoustique qui marche bien! Et pour plus d’originalité, on y ajoute des compo trip-hop contemporaines, de l’électro, des kicks et des basses bien lourdes!"
        ],
        "es": [
          "El arpa para tocar pop, rock, versiones de Bowie, Muse, los Red Hot, ¡Björk!\n¡Björk! ¡Esa es la fórmula acústica mágica que funciona! Y para mayor originalidad, ¡añadimos trip-hop contemporáneo, electro, kicks y bajos pesados!"
        ],
        "nl": [
          "De harp om pop, rock, covers van Bowie, Muse, the Red Hot, Björk!\nBjörk! Dat is de magische akoestische formule die werkt! En voor extra originaliteit voegen we hedendaagse trip-hop, electro, kicks en zware bas toe!"
        ]
      },
