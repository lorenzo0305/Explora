  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ef83d134-3cf7-3fa9-870a-f851613db653",
      "dc:description": {
        "de": [
          "Organisation von Workshops zur Herstellung von Bleien, Montage und Köderernte sowie von Angelwettbewerben am Meer. Die Mitglieder des Vereins treffen sich jeden Freitag von 18:30 bis 20:00 Uhr im Noémie-Dufour-Saal."
        ],
        "en": [
          "Organization of lead making workshops, assembly, bait collection and seaside fishing competitions. The members of the association meet every Friday from 6.30 pm to 8 pm in the Noémie Dufour room."
        ],
        "it": [
          "Organizzazione di laboratori per la realizzazione di pesi, assemblaggio, raccolta di esche e gare di pesca in riva al mare. I membri dell'associazione si riuniscono ogni venerdì dalle 18.30 alle 20.00 nella sala Noémie Dufour."
        ],
        "fr": [
          "Organisation d'ateliers de confection de plombs, montage, récolte des appats et de concours de pêche en bord de mer. Les membres de l'association se réunissent chaque vendredi de 18h30 à 20h salle Noémie Dufour."
        ],
        "es": [
          "Organización de talleres de fabricación de plomos, montaje, recogida de cebos y concursos de pesca en el mar. Los miembros de la asociación se reúnen todos los viernes de 18.30 a 20.00 horas en la sala Noémie Dufour."
        ],
        "nl": [
          "Organisatie van workshops voor het maken van gewichten, montage, verzamelen van aas en viswedstrijden aan zee. De leden van de vereniging komen elke vrijdag van 18.30 tot 20.00 uur bijeen in de zaal Noémie Dufour."
        ]
      },
