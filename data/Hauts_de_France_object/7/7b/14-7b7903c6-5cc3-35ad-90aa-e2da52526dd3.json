  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7fd954d1-cb59-31c5-a976-58017862c63e",
      "dc:description": {
        "de": [
          "Die künstlerischen Stunden - L'homme V\nL'homme V ist eine akrobatische Tanzshow in Solo-BMX und Live-Cello. Hebungen, Würfe und Ungleichgewichte reihen sich mit Vincent Warin und seinem Cellisten aneinander. Was für eine Überraschung! Treffpunkt um 19.30 Uhr auf der Esplanade."
        ],
        "en": [
          "Artistic hours - L'homme V\nL'homme V is a solo BMX acrobatic dance performance with live cello. Carries, throws and imbalances follow one another with Vincent Warin and his cellist. Surprising! See you at 7.30pm on the esplanade."
        ],
        "it": [
          "Orario artistico - L'homme V\nL'homme V è una performance acrobatica di danza BMX in solitaria con violoncello dal vivo. Vincent Warin e il suo violoncellista eseguono una serie di sollevamenti, lanci e sbilanciamenti. Sorprendente! Ci vediamo alle 19.30 sulla spianata."
        ],
        "fr": [
          "Les heures artistiques - L'homme V\nL'homme V est un spectacle acrobatique dansé en solo BMX et violoncelle live. Portés, lancers et déséquilibres s'enchaînent avec Vincent Warin et son violoncelliste. Surprenant ! Rendez-vous à 19h30 sur l'esplanade."
        ],
        "es": [
          "Horas artísticas - L'homme V\nL'homme V es un espectáculo acrobático de danza BMX en solitario con violonchelo en directo. Vincent Warin y su violonchelista realizan una serie de elevaciones, lanzamientos y desequilibrios. ¡Sorprendente! Nos vemos a las 19.30 h en la explanada."
        ],
        "nl": [
          "Artistieke uren - L'homme V\nL'homme V is een acrobatische solo BMX dansvoorstelling met live cello. Vincent Warin en zijn cellist voeren een reeks lifts, worpen en onevenwichtigheden uit. Verrassend! Tot 19.30 uur op de esplanade."
        ]
      },
