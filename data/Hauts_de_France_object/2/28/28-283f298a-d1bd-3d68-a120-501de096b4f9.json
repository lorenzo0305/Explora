  "rdfs:comment": {
    "de": [
      "Michel führt Sie auf Tages- oder Mehrtagesausflügen, um die Somme zu Pferd zu entdecken!"
    ],
    "en": [
      "Michel will guide you for day or multi-day rides to discover the Somme on horseback!"
    ],
    "it": [
      "Michel vi guiderà in passeggiate di un giorno o di più giorni per scoprire la Somme a cavallo!"
    ],
    "fr": [
      "Michel vous guide pour des randonnées à la journée ou sur plusieurs jours à la découverte de la Somme à cheval !"
    ],
    "es": [
      "Michel le guiará en excursiones de un día o de varios días para descubrir el Somme a caballo"
    ],
    "nl": [
      "Michel begeleidt u op dag- of meerdaagse tochten om de Somme te paard te ontdekken!"
