  "rdfs:comment": {
    "de": [
      "An diesem Tag können Sie das Konservatorium durch offene Klassen und Minikonzerte frei entdecken.\nDie Teams des Konservatoriums stehen Ihnen zur Verfügung, um Sie über die Studiengänge und die Einschreibungen für das Jahr 2026-2027 zu informieren.\nFreier Eintritt ohne Reservierung."
    ],
    "en": [
      "Come and discover the Conservatoire through open classes and mini-concerts.\nConservatory staff will be on hand to provide information on courses and registrations for 2026-2027.\nFree admission without reservation."
    ],
    "it": [
      "Durante la giornata, venite a scoprire il Conservatorio attraverso lezioni aperte e mini concerti.\nIl personale del Conservatorio sarà a disposizione per fornire informazioni sui corsi e sulle iscrizioni per il 2026-2027.\nL'ingresso è gratuito senza prenotazione."
    ],
    "fr": [
      "Durant cette journée, venez découvrir librement le Conservatoire à travers des classes ouvertes et des mini concerts.\nLes équipes du Conservatoire seront à votre disposition pour vous renseigner sur les parcours et les inscriptions pour l'année 2026-2027.\nEntrée libre sans réservation."
    ],
    "nl": [
      "Overdag kun je het Conservatorium ontdekken door middel van open lessen en miniconcerten.\nDe medewerkers van het Conservatorium zijn aanwezig om je informatie te geven over cursussen en inschrijvingen voor 2026-2027.\nZonder reservering is de toegang gratis."
    ],
    "es": [
      "Durante el día, venga a descubrir el Conservatorio a través de clases abiertas y mini conciertos.\nEl personal del Conservatorio estará a su disposición para informarle sobre los cursos y las inscripciones para 2026-2027.\nLa entrada es gratuita sin reserva previa."
    ]
  },
  "rdfs:label": {
