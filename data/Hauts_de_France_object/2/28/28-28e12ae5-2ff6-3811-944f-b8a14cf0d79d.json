  "rdfs:comment": {
    "de": [
      "John Doe bietet Ihnen :\n     - 6 Räume mit Escape Games zu 4 Themen: Blue Castle Prison, Black Rock Mine, The Magnifico of Las Vegas, Temple of Infinity.\n     - Ungewöhnliche Besichtigung von Lille: Ein Outdoor-Escape-Game in Form einer geolokalisierten App\n     - Murder Party\n\nMöglichkeit der Vermietung für private Feiern (Junggesellenabschied etc.)"
    ],
    "en": [
      "John Doe offers :\n     - 6 escape game rooms on 4 themes: Blue Castle Prison, Black Rock Mine, Las Vegas Magnifico, Temple of Infinity.\n     - Unusual visit to Lille: an outdoor escape game in the form of a geolocated application\n     - Murder Party\n\nRentals available for private parties (bachelor parties, etc.)"
    ],
    "it": [
      "John Doe vi offre :\n     - 6 sale di fuga su 4 temi: Prigione del Castello Blu, Miniera di Roccia Nera, Las Vegas Magnifico, Tempio dell'Infinito.\n     - Una visita insolita a Lille: un gioco di fuga all'aperto sotto forma di applicazione geolocalizzata\n     - Festa dell'omicidio\n\nPossibilità di noleggio per feste private (addio al celibato, ecc.)"
    ],
    "fr": [
      "John Doe vous propose :\n     - 6 salles d’escape game sur 4 thématiques : Prison de Blue Castle, Mine de Black Rock, le Magnifico de Las Vegas, le Temple de l’Infini.\n     - Visite insolite de Lille : un escape game outdoor sous forme d’application géolocalisée\n     - Murder Party\n\nPossibilité de location pour soirées privées (enterrement de vie de célibataire, etc. )"
    ],
    "es": [
      "John Doe le ofrece :\n     - 6 salas de juegos de escape en 4 temas: Prisión del Castillo Azul, Mina de Roca Negra, Las Vegas Magnífico, Templo del Infinito.\n     - Visita insólita a Lille: un juego de escape al aire libre en forma de aplicación geolocalizada\n     - Murder Party\n\nAlquiler disponible para fiestas privadas (despedidas de soltero, etc.)"
    ],
    "nl": [
      "John Doe biedt je :\n     - 6 escape game rooms op 4 thema's: Blue Castle Prison, Black Rock Mine, Las Vegas Magnifico, Temple of Infinity.\n     - Ongewoon bezoek aan Lille: een ontsnappingsspel in de buitenlucht in de vorm van een geolokaliseerde toepassing\n     - Moordfeest\n\nVerhuur beschikbaar voor privéfeesten (vrijgezellenfeesten, enz.)"
    ]
  },
