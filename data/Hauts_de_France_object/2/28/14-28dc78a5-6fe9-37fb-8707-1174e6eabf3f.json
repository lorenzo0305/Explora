  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08dcb386-6c0c-3221-b0b2-314c1779499b",
      "dc:description": {
        "de": [
          "Im Juli und August. Offen für Kinder von 3 bis 5 Jahren, montags bis freitags von 10:00 bis 12:00 Uhr.\nAnmeldung im Office de Tourisme Camiers - Sainte-Cécile auf der Esplanade."
        ],
        "en": [
          "July and August. Open to children aged 3 to 5, Monday to Friday, 10am to 12pm.\nRegistration at the Camiers - Sainte-Cécile Tourist Office on the Esplanade."
        ],
        "it": [
          "Luglio e agosto. Aperto ai bambini dai 3 ai 5 anni, dal lunedì al venerdì, dalle 10.00 alle 12.00.\nIscrizioni presso l'Ufficio del Turismo di Camiers - Sainte-Cécile sull'Esplanade."
        ],
        "fr": [
          "En juillet et août. Ouvert aux enfants de 3 à 5 ans, du lundi au vendredi de 10h à 12h.\nInscription à l'Office de Tourisme Camiers - Sainte-Cécile sur l'Esplanade."
        ],
        "es": [
          "Julio y agosto. Abierto a niños de 3 a 5 años, de lunes a viernes, de 10.00 a 12.00 horas.\nInscripciones en la Oficina de Turismo de Camiers - Sainte-Cécile, en la explanada."
        ],
        "nl": [
          "Juli en augustus. Open voor kinderen van 3 tot 5 jaar, maandag t/m vrijdag van 10.00 tot 12.00 uur.\nInschrijving bij het toeristenbureau van Camiers - Sainte-Cécile op de Esplanade."
        ]
      },
