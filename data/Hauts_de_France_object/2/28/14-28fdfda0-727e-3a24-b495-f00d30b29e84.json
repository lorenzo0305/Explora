      "@id": "https://data.datatourisme.fr/8d9db7d8-8157-375f-a976-6af490b61997",
      "dc:description": {
        "de": [
          "Restaurant am Fuße des Grand'Place Hôtel\nEntdecken Sie ein stilvolles Ambiente und genießen Sie im Josper-Ofen gegartes Fleisch von Rassetieren und reifem Fleisch."
        ],
        "en": [
          "Restaurant at the foot of the Grand'Place Hotel\nDiscover a chic ambience, and enjoy purebred and mature meats cooked in the Josper oven."
        ],
        "it": [
          "Ristorante ai piedi dell'hotel Grand'Place\nScoprite un'atmosfera chic e assaporate carni di razza e mature cotte nel forno Josper."
        ],
        "fr": [
          "Restaurant au pied du Grand'Place Hôtel\nDécouvrez une ambiance chic, dégustez des viandes de race et matures cuites au four Josper."
        ],
        "es": [
          "Restaurante al pie del hotel Grand'Place\nDescubra un ambiente chic y saboree las carnes de pura raza y maduradas cocinadas en el horno Josper."
        ],
        "nl": [
          "Restaurant aan de voet van het Grand'Place Hotel\nOntdek een chique sfeer en geniet van raszuiver en gerijpt vlees bereid in de Josper-oven."
        ]
      },
