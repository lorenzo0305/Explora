  "rdfs:comment": {
    "de": [
      "Das Restaurant empfängt Sie in einem warmen und entspannten Rahmen. Hausgemachte Speisen gehören zum guten Ton, Gourmetküche verbindet sich mit Einfachheit."
    ],
    "en": [
      "The restaurant welcomes you in a warm and relaxed setting. The home-made cuisine is the order of the day, gastronomy is combined with simplicity."
    ],
    "it": [
      "Il ristorante vi accoglie in un ambiente caldo e rilassato. La cucina casalinga è all'ordine del giorno, la gastronomia si unisce alla semplicità."
    ],
    "fr": [
      "Le restaurant vous accueille dans un cadre chaleureux et décontracté. La cuisine faite maison va de mise, le gastronomique s'allie à la simplicité."
    ],
    "nl": [
      "Het restaurant ontvangt u in een warm en ontspannen kader. Huisgemaakte gerechten zijn aan de orde van de dag, gastronomie wordt gecombineerd met eenvoud."
    ],
    "es": [
      "El restaurante le da la bienvenida en un ambiente cálido y relajado. La cocina casera está a la orden del día, la gastronomía se combina con la sencillez."
    ]
  },
