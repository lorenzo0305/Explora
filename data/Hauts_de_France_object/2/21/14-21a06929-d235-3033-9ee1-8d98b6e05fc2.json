  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9a93008d-f6c3-3d8b-bc27-0b33b27250df",
      "dc:description": {
        "de": [
          "Bauernhof mit Geflügelzucht (Hühner, Perlhühner, Poularden) mit Direktverkauf und Milchkühen in Hénoville an der Straße, die die Metropole Lille mit der Côte d'Opale verbindet."
        ],
        "en": [
          "Direct-sale poultry farm (chickens, guinea fowl, poulardes) and dairy cow farm, located in Hénoville, on the road between Lille and the Côte d'Opale."
        ],
        "it": [
          "Azienda di vendita diretta di pollame (polli, faraone, galline) e di vacche da latte, situata a Hénoville, sulla strada tra Lille e la Côte d'Opale."
        ],
        "fr": [
          "Ferme d'élevage de volailles (poulets, pintades, poulardes) en vente directe et de vaches laitières, située à Hénoville, sur la route reliant la métropole lilloise à la Côte d'Opale."
        ],
        "nl": [
          "Pluimveebedrijf (kippen, parelhoenders, hennen) en melkkoeienbedrijf in directe verkoop, gelegen in Hénoville, op de weg tussen Lille en de Côte d'Opale."
        ],
        "es": [
          "Granja de venta directa de aves de corral (pollos, pintadas, gallinas) y vacas lecheras, situada en Hénoville, en la carretera entre Lille y la Côte d'Opale."
        ]
      },
