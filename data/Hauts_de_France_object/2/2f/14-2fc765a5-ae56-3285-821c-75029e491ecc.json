      "dc:description": {
        "de": [
          "Um das Jahr 2025 gut zu beginnen, lädt die Stadtverwaltung Sie zu einem Moment der Entspannung und guten Laune mit der One-Woman-Show von Antonia de Rendinger ein!"
        ],
        "en": [
          "To get 2025 off to a good start, the Municipality invites you to enjoy a moment of relaxation and good humor with Antonia de Rendinger's one-woman show!"
        ],
        "it": [
          "Per iniziare bene il 2025, il Municipio vi invita a rilassarvi e a godervi lo spettacolo di Antonia de Rendinger!"
        ],
        "fr": [
          "Pour bien commencer 2025, la Municipalité vous invite à un moment de détente et de bonne humeur avec le one-woman show d'Antonia de Rendinger !"
        ],
        "es": [
          "Para empezar bien el año 2025, el Ayuntamiento le invita a relajarse y disfrutar del espectáculo en solitario de Antonia de Rendinger"
        ],
        "nl": [
          "Om 2025 goed te beginnen, nodigt het stadhuis je uit om te ontspannen en te genieten van de one woman show van Antonia de Rendinger!"
        ]
      },
