  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c347a01f-ba38-3544-ab9e-b18bd989e8c7",
      "dc:description": {
        "de": [
          "Entdecken Sie das Gebiet der Communauté de Communes de la Région d?Audruicq und kombinieren Sie die Entdeckung des Elektrofahrrads (Ausleihe auf Anfrage möglich) mit einer Gourmetpause im Restaurant am Mittag!"
        ],
        "en": [
          "Come and discover the territory of the Communauté de Communes de la Région d?Audruicq by combining the discovery of the Electric-Assisted Bicycle (loan available on request) with a gourmet lunch break at the restaurant!"
        ],
        "it": [
          "Venite a scoprire la Comunità dei Comuni della Regione dell'Audruicq combinando la scoperta della bicicletta a pedalata assistita (prestito su richiesta) con una pausa gastronomica nel ristorante all'ora di pranzo!"
        ],
        "fr": [
          "Venez découvrir le territoire de la Communauté de Communes de la Région d’Audruicq en alliant la découverte du Vélo à Assistance Electrique (prêt possible sur demande) et une pause gourmande au restaurant le midi !"
        ],
        "es": [
          "Venga a descubrir la Comunidad de Municipios de la Región de Audruicq combinando el descubrimiento de la Bicicleta Eléctrica Asistida (préstamo disponible previa petición) con una pausa gastronómica en el restaurante a la hora de comer"
        ],
        "nl": [
          "Kom de Communauté des communes van de Audruicq ontdekken en combineer de ontdekking van de elektrisch ondersteunde fiets (uitleen mogelijk op aanvraag) met een gastronomische pauze in het restaurant tijdens de lunch!"
        ]
      },
