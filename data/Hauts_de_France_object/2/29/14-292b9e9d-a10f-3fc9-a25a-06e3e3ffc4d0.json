  "rdfs:comment": {
    "de": [
      "Die ersten Sekunden von Dare, dem neuen Album des Trios Meule aus Tours, sind geprägt von einem seltsamen Gefühl, das sich aus Dringlichkeit und Jubel mischt."
    ],
    "en": [
      "A curious feeling of urgency and jubilation, that's what grips us from the very first seconds of Dare, the new album by the Touraine trio, Meule."
    ],
    "it": [
      "Una strana miscela di urgenza ed esultanza è ciò che ci attanaglia fin dai primi secondi di Dare, il nuovo album dei Meule, un trio di Tours."
    ],
    "fr": [
      "Un curieux sentiment mêlé d’urgence et de jubilation, c’est ce qui nous étreint dès les premières secondes de Dare, le nouvel album du trio tourangeau, Meule."
    ],
    "es": [
      "Una extraña mezcla de urgencia y júbilo es lo que nos atrapa desde los primeros segundos de Dare, el nuevo álbum de Meule, un trío de Tours."
    ],
    "nl": [
      "Een vreemde mengeling van urgentie en jubelstemming is wat ons vanaf de eerste seconden van Dare, het nieuwe album van Meule, een trio uit Tours, in zijn greep houdt."
    ]
  },
