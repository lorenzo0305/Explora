  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b8c51fe0-5ce5-32e7-89f5-fe878201eb1b",
      "dc:description": {
        "de": [
          "Im Holzofen gebackene Pizzas, die mit frischen Produkten belegt werden.\nKleiner Lebensmittelladen mit italienischen Produkten (Bier, Wein, Grissini...)\nVerkauf nur zum Mitnehmen\nÖffnungszeiten: 11:30 bis 22:00 Uhr (im Juli und August) von Montag bis Sonntag"
        ],
        "en": [
          "Pizzas cooked on wood fire, topped with fresh products.\nSmall grocery store of Italian products (beer, wine, breadsticks...)\nTake away only\nOpening hours : 11h30 to 22h (in July and August) from Monday to Sunday"
        ],
        "it": [
          "Pizze cotte a legna, condite con prodotti freschi.\nPiccolo negozio di alimentari con prodotti italiani (birra, vino, grissini...)\nSolo da asporto\nOrari di apertura: dalle 11.30 alle 22.00 (in luglio e agosto), dal lunedì alla domenica"
        ],
        "fr": [
          "Pizzas cuites au feu de bois, garnies de produits frais.\nPetite épicerie de produits italiens (bière, vin, gressin...)\nVente à emporter uniquement\nHoraires d'ouverture : 11h30 à 22h (en juillet et août) du lundi au dimanche"
        ],
        "es": [
          "Pizzas cocinadas a fuego de leña, cubiertas con productos frescos.\nPequeña tienda de comestibles con productos italianos (cerveza, vino, palitos de pan...)\nSólo para llevar\nHorario: de 11:30 a 22:00 (en julio y agosto) de lunes a domingo"
        ],
        "nl": [
          "Pizza's gebakken op houtvuur, belegd met verse producten.\nKleine kruidenierswinkel met Italiaanse producten (bier, wijn, broodstengels...)\nAlleen afhaalmaaltijden\nOpeningstijden: 11.30 tot 22.00 uur (in juli en augustus) van maandag tot zondag"
        ]
      },
      "@type": [
        "Description"
