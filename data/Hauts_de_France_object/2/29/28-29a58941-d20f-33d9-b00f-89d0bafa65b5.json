  "rdfs:comment": {
    "de": [
      "Der Parc Marcel Dassault ist ein Ort, an dem man gut spazieren gehen kann. Hier findet man eine beeindruckende Vielfalt an Pflanzen und Blumen sowie eine Vielzahl an Tieren..."
    ],
    "en": [
      "Parc Marcel Dassault is a great place to take a stroll. There is an impressive variety of plants and flowers as well as a multitude of animals..."
    ],
    "it": [
      "Il Parco Marcel Dassault è un luogo ideale per fare una passeggiata. Vanta un'impressionante varietà di piante e fiori, oltre a una moltitudine di animali..."
    ],
    "fr": [
      "Le Parc Marcel Dassault est un endroit où il fait bon se promener. On y trouve une variété impressionnante de plantes et de fleurs ainsi qu'une multitude d'animaux..."
    ],
    "nl": [
      "Het Parc Marcel Dassault is een geweldige plek om te wandelen. Het heeft een indrukwekkende verscheidenheid aan planten en bloemen, evenals een veelheid aan dieren..."
    ],
    "es": [
      "El Parque Marcel Dassault es un lugar ideal para pasear. Cuenta con una impresionante variedad de plantas y flores, así como con multitud de animales..."
    ]
  },
