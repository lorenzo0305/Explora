  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3951006-3c1c-3dfd-b6a3-2920d5e10055",
      "dc:description": {
        "de": [
          "Brasserie vor Nausicáa, direkt am Meer gelegen.\nSpezialitäten: Fisch, Muscheln mit Pommes frites und Meeresfrüchte.\nFamiliäre Atmosphäre und große Sonnenterrasse."
        ],
        "en": [
          "Brewery located in front of Nausicáa, facing the sea.\nSpecialities fish, fried mussels and seafood.\nFamily atmosphere and large sunny terrace."
        ],
        "it": [
          "Brasserie situata di fronte a Nausicáa, di fronte al mare.\nSpecialità: pesce, cozze fritte e frutti di mare.\nAtmosfera familiare e ampia terrazza soleggiata."
        ],
        "fr": [
          "Brasserie située devant Nausicáa, face à la mer.\nSpécialités poisson, moules frites et fruits de mer.\nAmbiance familiale et grande terrasse ensoleillée."
        ],
        "es": [
          "Brasserie situada frente a Nausicáa, frente al mar.\nEspecialidades: pescado, mejillones fritos y marisco.\nAmbiente familiar y gran terraza soleada."
        ],
        "nl": [
          "Brasserie gelegen voor Nausicáa, met uitzicht op zee.\nSpecialiteiten: vis, gebakken mosselen en zeevruchten.\nFamiliale sfeer en groot zonnig terras."
        ]
      },
