  "rdfs:comment": {
    "de": [
      "Die Gärten von Rully bieten Ihnen köstliche Erdbeeren, erfrischende Sorbets, hausgemachte Marmeladen, Chutneys und hausgemachte Suppen.\n\nShop vor Ort, Verkauf von Gemüse aus dem eigenen Garten."
    ],
    "en": [
      "Rully's gardens offer you succulent strawberries, refreshing sorbets, homemade jams, chutneys and homemade soups.\n\nShop on site, sale of vegetables from our garden."
    ],
    "it": [
      "I giardini di Rully offrono fragole succulente, sorbetti rinfrescanti, marmellate fatte in casa, chutney e zuppe fatte in casa.\n\nNegozio in loco, vendita di verdure del nostro orto."
    ],
    "fr": [
      "Les jardins de Rully vous proposent de succulentes fraises, des sorbets rafraîchissants, des confitures maison, des chutneys, des soupes maison.\n\nBoutique sur place, vente de légumes de notre jardin."
    ],
    "es": [
      "Los jardines de Rully ofrecen suculentas fresas, refrescantes sorbetes, mermeladas caseras, chutneys y sopas caseras.\n\nTienda in situ, venta de verduras de nuestro huerto."
    ],
    "nl": [
      "De tuinen van Rully bieden sappige aardbeien, verfrissende sorbets, zelfgemaakte jam, chutneys en zelfgemaakte soepen.\n\nWinkel ter plaatse, verkoop van groenten uit onze tuin."
    ]
  },
  "rdfs:label": {
