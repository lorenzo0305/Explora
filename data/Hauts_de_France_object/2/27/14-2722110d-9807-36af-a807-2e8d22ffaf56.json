  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08c7856d-305b-3376-9269-dd2e19e33c00",
      "dc:description": {
        "de": [
          "6,4 KM LANGER WANDER- UND MOUNTAINBIKEWEG - 1 STUNDE 30 MINUTEN\nSTART AM RATHAUS VON QUESQUES\nKEINE MARKIERUNG - Verlauf im Wanderbuch, das im Fremdenverkehrsamt erhältlich ist\n\nFinden Sie den Verlauf des Rundwegs in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "6.4KM PEDESTRIAN AND MOUNTAIN BIKE TRAIL - 1 H 30\nDEPARTURE FROM QUESQUES TOWN HALL\nNO MARKING - Traced in the hiker's booklet available from the Tourist Office\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO PEDONALE E PER MOUNTAIN BIKE DI 6,4 KM - 1 H 30\nPARTENZA DAL MUNICIPIO DI QUESQUES\nNON SONO SEGNALATI - L'itinerario è riportato nell'opuscolo dell'escursionista disponibile presso l'Ufficio del Turismo\n\nIl percorso è disponibile sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE ET VTT DE 6.4KM - 1 H 30\nDEPART DE LA MAIRIE DE QUESQUES\nPAS DE BALISAGE -  Tracé dans le carnet du randonneur disponible à l'Office de Tourisme\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RECORRIDO PEATONAL Y EN BICICLETA DE MONTAÑA DE 6,4 KM - 1 H 30\nSALIDA DESDE EL AYUNTAMIENTO DE QUESQUES\nSIN SEÑALIZACIÓN - Itinerario en el folleto del excursionista disponible en la Oficina de Turismo\n\nEncuentre la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "6,4 KM WANDEL- EN MOUNTAINBIKEROUTE - 1 U 30\nSTART VANAF HET GEMEENTEHUIS VAN QUESQUES\nGEEN MARKERING - Route in het wandelboekje verkrijgbaar bij het toeristenbureau\n\nJe kunt de route vinden op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
