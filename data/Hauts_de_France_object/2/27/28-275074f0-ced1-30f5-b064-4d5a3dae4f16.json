  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: die Lage im Herzen von Albert gegenüber der wunderschönen Basilika, der familiäre Geist und die traditionelle Küche mit lokalen Produkten."
    ],
    "en": [
      "You'll love the location in the heart of Albert, opposite the magnificent Basilica, the family atmosphere and the traditional cuisine based on local produce."
    ],
    "it": [
      "Vi piacerà la posizione nel cuore di Albert, di fronte alla magnifica Basilica, l'atmosfera familiare e la cucina tradizionale a base di prodotti locali."
    ],
    "fr": [
      "Vous aimerez : la situation au cœur d'Albert face à la magnifique Basilique, l'esprit familial et la cuisine traditionnelle à base de produits locaux."
    ],
    "es": [
      "Le encantará su ubicación en el corazón de Alberto, frente a la magnífica Basílica, su ambiente familiar y su cocina tradicional basada en productos locales."
    ],
    "nl": [
      "Je zult dol zijn op de locatie in het hart van Albert tegenover de prachtige basiliek, de familiale sfeer en de traditionele keuken op basis van lokale producten."
    ]
  },
