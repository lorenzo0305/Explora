  "rdfs:comment": {
    "de": [
      "Das Aux berges de Sambre ist das Geburtshaus des Malers Félix Del Marle. Das hübsch dekorierte Restaurant bietet Ihnen eine hausgemachte Gourmetküche."
    ],
    "en": [
      "Aux berges de Sambre is the birthplace of the painter Felix Del Marle. The nicely decorated restaurant offers you a gourmet and home-made cuisine."
    ],
    "it": [
      "Aux berges de Sambre è il luogo di nascita del pittore Félix Del Marle. Il ristorante, ben arredato, offre una cucina gourmet e casalinga."
    ],
    "fr": [
      "L’établissement Aux berges de Sambre est la maison natale du peintre Félix Del Marle. Le restaurant joliment décoré vous  propose une cuisine gourmande et faite maison."
    ],
    "nl": [
      "Aux berges de Sambre is het geboortehuis van de schilder Félix Del Marle. Het mooi ingerichte restaurant biedt een gastronomische en huisgemaakte keuken."
    ],
    "es": [
      "Aux berges de Sambre es la casa natal del pintor Félix Del Marle. El restaurante, muy bien decorado, ofrece una cocina gourmet y casera."
    ]
