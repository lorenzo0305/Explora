  "rdfs:comment": {
    "de": [
      "Carole schlägt Ihnen vor, sich auf die Spuren der Soldaten zu begeben und die Spuren Ihrer Vorfahren zu finden: Besuche des Circuit du Souvenir, Besuche australischer Stätten!"
    ],
    "en": [
      "Carole suggests that you follow in the footsteps of the soldiers, to find the traces of your ancestors: visits to the Circuit of Remembrance, visits to Australian sites!"
    ],
    "it": [
      "Carole vi suggerisce di seguire le orme dei soldati, per trovare le tracce dei vostri antenati: visite al Circuito della Memoria, visite ai siti australiani!"
    ],
    "fr": [
      "Carole vous propose de partir sur les traces des soldats, de retrouver les traces de vos aïeux : visites du Circuit du Souvenir, visites des sites australiens !"
    ],
    "nl": [
      "Carole stelt voor om in de voetsporen van de soldaten te treden, om de sporen van uw voorouders te vinden: bezoeken aan het Circuit of Remembrance, bezoeken aan Australische sites!"
    ],
    "es": [
      "Carole le sugiere que siga las huellas de los soldados, para encontrar los rastros de sus antepasados: visitas al Circuito del Recuerdo, ¡visitas a yacimientos australianos!"
    ]
  },
