  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e8d86b91-6569-302f-b63b-95e4a49c8b26",
      "dc:description": {
        "de": [
          "Von Sung-ah Min, Miyoung Baek\nEine Sammlung von sechs poetischen und sensiblen Animationsfilmen, in denen das Talent von zwei jungen südkoreanischen Regisseurinnen, Baek Miyoung und Min Sung-Ah, Welten in warmen Pastellfarben entfaltet. Kleine Vögel sind das Bindeglied zwischen den Filmen, in denen man Momente der Zärtlichkeit und des Humors teilt."
        ],
        "en": [
          "By Sung-ah Min, Miyoung Baek\nA collection of 6 poetic, sensitive animated films in which the talent of 2 young South Korean directors, Baek Miyoung and Min Sung-Ah, unveils a world of warm, pastel colors. Little birds weave the link between these films, in which we share moments of tenderness and humor."
        ],
        "it": [
          "Di Sung-ah Min, Miyoung Baek\nUna raccolta di 6 film d'animazione poetici e sensibili in cui il talento di due giovani registi sudcoreani, Baek Miyoung e Min Sung-Ah, rivela un mondo di caldi colori pastello. Gli uccellini fanno da collegamento tra questi film, in cui condividiamo momenti di tenerezza e umorismo."
        ],
        "fr": [
          "De Sung-ah Min, Miyoung Baek\nUn ensemble de 6 films d’animation poétiques et sensibles où le talent de 2 de jeunes réalisatrices sud coréennes, Baek Miyoung et Min Sung-Ah, dévoile des univers aux couleurs pastel et chaleureuses. Des petits oiseaux tissent le lien entre ces films, dans lesquels on partage des instants de tendresse et d’humour."
        ],
        "es": [
          "Por Sung-ah Min, Miyoung Baek\nUna colección de 6 poéticas y sensibles películas de animación en las que el talento de 2 jóvenes directores surcoreanos, Baek Miyoung y Min Sung-Ah, nos descubre un mundo de cálidos colores pastel. Pequeños pájaros tejen el vínculo entre estas películas, en las que compartimos momentos de ternura y humor."
        ],
        "nl": [
          "Door Sung-ah Min, Miyoung Baek\nEen verzameling van 6 poëtische en gevoelige animatiefilms waarin het talent van 2 jonge Zuid-Koreaanse regisseurs, Baek Miyoung en Min Sung-Ah, een wereld van warme pastelkleuren onthult. Vogeltjes weven de link tussen deze films, waarin we momenten van tederheid en humor delen."
        ]
      },
