  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: Das Obst und Gemüse wird so weit wie möglich in kurzen Kreisläufen ausgewählt. Eine Auswahl an kleinen Erzeugern, Bio- und lokalen Gemüsebauern."
    ],
    "en": [
      "You'll love: the fruit and vegetables are selected as far as possible from short circuits. A selection of small producers, organic and local market gardeners."
    ],
    "it": [
      "Vi piacerà: la frutta e la verdura sono selezionate il più possibile dai canali di distribuzione brevi. Una selezione di piccoli produttori, biologici e ortolani locali."
    ],
    "fr": [
      "Vous aimerez : les Fruits et légumes sont sélectionnés au maximum en circuit court. Une sélection de petits producteurs, de maraîchers bio et locaux."
    ],
    "es": [
      "Le encantará: las frutas y hortalizas se seleccionan en la medida de lo posible de los canales cortos de distribución. Una selección de pequeños productores, ecológicos y horticultores locales."
    ],
    "nl": [
      "Je zult ervan houden: het fruit en de groenten worden zoveel mogelijk uit korte distributiekanalen geselecteerd. Een selectie van kleine producenten, biologische en lokale tuinders."
    ]
  },
