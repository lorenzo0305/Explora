  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6833cd63-fb5c-3f40-a2b7-c98c97ffc0d9",
      "dc:description": {
        "de": [
          "Mealk ist eine Käserei, ein Lebensmittelgeschäft und ein Restaurant. Er bietet Ihnen eine traditionelle Küche mit hausgemachten und vor Ort zubereiteten Gerichten aus frischen, lokalen und biologischen Produkten."
        ],
        "en": [
          "Mealk is a cheese shop, grocery store and restaurant. It offers a traditional cuisine composed of homemade dishes cooked on the spot, using fresh, local and organic products."
        ],
        "it": [
          "Mealk è un negozio di formaggi, alimentari e ristoranti. Offre una cucina tradizionale con piatti fatti in casa e cucinati sul posto, utilizzando prodotti freschi, locali e biologici."
        ],
        "fr": [
          "Mealk est une fromagerie, épicerie et restaurant. Il vous propose une cuisine traditionnelle composé de plats faits maison et cuisinés sur place, à base de produits frais, locaux et bio."
        ],
        "nl": [
          "Mealk is een kaaswinkel, kruidenier en restaurant. Het biedt een traditionele keuken met huisgemaakte gerechten die ter plaatse worden bereid met verse, lokale en biologische producten."
        ],
        "es": [
          "Mealk es una tienda de quesos, una tienda de comestibles y un restaurante. Ofrece una cocina tradicional con platos caseros cocinados al momento, con productos frescos, locales y ecológicos."
        ]
      },
