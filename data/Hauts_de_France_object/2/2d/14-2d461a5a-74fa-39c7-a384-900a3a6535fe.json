  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fdf859d1-f538-3fae-ac52-a2cf2c21007e",
      "dc:description": {
        "de": [
          "Die Freiwilligen des Vereins erwarten Sie zahlreich, um die Ufer der Canche zu säubern und so die wunderschönen Landschaften der Flussmündung zu erhalten."
        ],
        "en": [
          "The association's volunteers look forward to seeing you there to clean up the banks of the Canche and preserve the estuary's magnificent landscapes."
        ],
        "it": [
          "I volontari dell'associazione si augurano di vedervi numerosi per aiutare a ripulire le rive del Canche e a preservare i magnifici paesaggi dell'estuario."
        ],
        "fr": [
          "Les bénévoles de l'association vous attendent nombreux afin de nettoyer les bords de la Canche et ainsi préserver les magnifiques paysages de l'estuaire."
        ],
        "es": [
          "Los voluntarios de la asociación esperan ver a muchos de ustedes allí para ayudar a limpiar las orillas del Canche y preservar los magníficos paisajes del estuario."
        ],
        "nl": [
          "De vrijwilligers van de vereniging hopen velen van jullie daar te zien om te helpen de oevers van de Canche schoon te maken en de prachtige landschappen van de riviermonding te behouden."
        ]
      },
