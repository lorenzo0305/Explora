  "rdfs:comment": {
    "de": [
      "Probieren Sie die Qualität der Schweine, die von Didier Masson auf dem Bauernhof aufgezogen und mit Weizen und Gerste gefüttert werden. Spezialitäten: Trockenwurst vom Bauernhof, Landterrine, Frischfleischkiste."
    ],
    "en": [
      "Taste the quality of the pigs raised on the farm by Didier Masson, fed on wheat and barley. Specialities of dry farm sausage, country terrine, fresh meat box."
    ],
    "it": [
      "Assaggiate la qualità dei maiali allevati nella fattoria di Didier Masson, nutriti con grano e orzo. Specialità di salsiccia secca di fattoria, terrina di campagna, box di carne fresca."
    ],
    "fr": [
      "Goûtez à la qualité des porcs élevés à la ferme par Didier Masson, nourris à base de blé et d’orge. Spécialités de saucisson sec fermier, terrine de campagne, caissette de viande fraîche."
    ],
    "es": [
      "Pruebe la calidad de los cerdos criados en la granja por Didier Masson, alimentados con trigo y cebada. Especialidades de embutido de granja seco, terrina de campo, caja de carne fresca."
    ],
    "nl": [
      "Proef de kwaliteit van de door Didier Masson op de boerderij gefokte varkens, gevoed met tarwe en gerst. Specialiteiten van droge boerenworst, boeren terrine, vers vlees doos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des Fontaines"
    ]
  },
