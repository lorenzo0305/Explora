  "rdfs:comment": {
    "de": [
      "Von 1928 bis 1934 wiederaufgebaute Kirche im römisch-byzantinischen Stil, die sich durch ihre flamboyanten Glasfenster, ihren als MH klassifizierten Altaraufsatz aus dem 17. Jahrhundert und das Gisant von Saint Martin auszeichnet."
    ],
    "en": [
      "Church rebuilt from 1928 to 1934, Romano-Byzantine style, characterized by its flamboyant stained glass windows, its 17th century altarpiece classified MH and the lying of Saint Martin."
    ],
    "it": [
      "Chiesa ricostruita dal 1928 al 1934, in stile romano-bizantino, caratterizzata da vetrate sgargianti, dalla pala d'altare del XVII secolo classificata come monumento storico e dalla statua reclinata di San Martino."
    ],
    "fr": [
      "Eglise reconstruite de 1928 à 1934, de style Romano-byzantin, caractérisée par ses vitraux flamboyants, son retable du XVIIe siècle classé MH et le gisant de Saint Martin."
    ],
    "nl": [
      "Kerk herbouwd van 1928 tot 1934, in Romaans-Byzantijnse stijl, gekenmerkt door de flamboyante glas-in-loodramen, het als historisch monument geclassificeerde altaarstuk uit de 17e eeuw en het liggende beeld van Sint-Maarten."
    ],
    "es": [
      "Iglesia reconstruida de 1928 a 1934, de estilo romano-bizantino, caracterizada por sus flamantes vidrieras, su retablo del siglo XVII clasificado como monumento histórico y la estatua yacente de San Martín."
    ]
  },
