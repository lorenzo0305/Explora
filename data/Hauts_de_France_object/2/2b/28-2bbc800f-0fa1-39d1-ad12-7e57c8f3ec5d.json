  "rdfs:comment": {
    "de": [
      "Die Marke Pizza Tasty konzentriert ihre Entwicklung ausschließlich auf das französische Staatsgebiet.\nWir bieten unseren Kunden durchschnittlich 30 Pizzen in verschiedenen Kategorien an, um alle Geschmäcker zu befriedigen, aber auch eine Vielfalt an Vorspeisen, Paninis, Desserts und Getränken.\nDie Lieferung erfolgt in einem Umkreis von 10 km."
    ],
    "en": [
      "The Pizza Tasty brand focuses its development only on the French territory.\nWe offer our customers an average of 30 pizzas divided into several categories to satisfy all tastes, but also a variety of starters, paninis, desserts and drinks.\nDelivery within a 10km radius."
    ],
    "it": [
      "Il marchio Pizza Tasty sta concentrando il suo sviluppo esclusivamente sul territorio francese.\nOffriamo ai nostri clienti una media di 30 pizze suddivise in diverse categorie per soddisfare tutti i gusti, oltre a una varietà di antipasti, panini, dolci e bevande.\nConsegna nel raggio di 10 km."
    ],
    "fr": [
      "L'enseigne Pizza Tasty concentre son développement uniquement sur le territoire français.\nNous proposons à notre clientèle 30 pizzas en moyenne réparties dans plusieurs catégories pour satisfaire tous les goûts mais également une diversité d'entrées, paninis, desserts et boissons.\nLivraison dans un rayon de 10km."
    ],
    "es": [
      "La marca Pizza Tasty centra su desarrollo únicamente en el territorio francés.\nOfrecemos a nuestros clientes una media de 30 pizzas divididas en varias categorías para satisfacer todos los gustos, así como una variedad de entrantes, paninis, postres y bebidas.\nEntrega en un radio de 10 km."
    ],
    "nl": [
      "Het merk Pizza Tasty richt zijn ontwikkeling uitsluitend op het Franse grondgebied.\nWij bieden onze klanten gemiddeld 30 pizza's verdeeld over verschillende categorieën om aan alle smaken te voldoen, evenals een verscheidenheid aan voorgerechten, panini's, desserts en dranken.\nLevering binnen een straal van 10 km."
    ]
  },
