      "dc:description": {
        "de": [
          "Maskottchen-Nachmittag mit Planète sucrée ab 15 Uhr auf dem Mini-Golfplatz, gefolgt von einem Transformatorenabend mit Diana Show ab 19:30 Uhr."
        ],
        "en": [
          "Mascot afternoon with Planète sucrée from 3pm at the Mini-Golf, followed at 7:30pm by the transformist evening with Diana Show from 7:30pm."
        ],
        "it": [
          "Pomeriggio mascotte con Planète sucrée dalle 15.00 al Mini-Golf, seguito alle 19.30 dalla serata trasformista con Diana Show."
        ],
        "fr": [
          "Après-midi Mascottes avec Planète sucrée dès 15h au Mini-Golf, suivie à 19h30 de la soirée transformiste avec Diana Show dès 19h30."
        ],
        "es": [
          "Tarde de mascotas con Planète sucrée a partir de las 15:00 h en el minigolf, seguida a las 19:30 h de la velada transformista con Diana Show."
        ],
        "nl": [
          "Mascottemiddag met Planète sucrée vanaf 15u op de Mini-Golf, gevolgd om 19u30 door de transformistische avond met Diana Show."
        ]
