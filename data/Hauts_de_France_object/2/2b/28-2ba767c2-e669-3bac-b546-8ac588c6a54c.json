  "rdfs:comment": {
    "de": [
      "Ein zugänglicher und einladender Raum für vielfältige Aktivitäten, der mehr als 1000 Meisterwerke von 12 nationalen und internationalen Institutionen und Museen vereint. Diese digitale Kunstgalerie ist ein völlig neues Kulturangebot."
    ],
    "en": [
      "A warm, accessible multi-purpose space featuring over 1,000 masterpieces from 12 national and international museums and institutions. This digital art gallery is a unique cultural offering."
    ],
    "it": [
      "Uno spazio polifunzionale accogliente e accessibile che riunisce oltre 1.000 capolavori provenienti da 12 musei e istituzioni nazionali e internazionali. Questa galleria d'arte digitale è un'offerta culturale unica."
    ],
    "fr": [
      "Espace multiple d’activités accessible et chaleureux réunissant plus de 1000 chefs-d'oeuvre de 12 institutions et musées, nationaux et internationaux. Cette galerie d'art numérique est une offre culturelle inédite."
    ],
    "es": [
      "Un espacio polivalente, cálido y accesible que reúne más de 1.000 obras maestras de 12 museos e instituciones nacionales e internacionales. Esta galería de arte digital es una oferta cultural única."
    ],
    "nl": [
      "Een warme en toegankelijke multifunctionele ruimte die meer dan 1000 meesterwerken uit 12 nationale en internationale musea en instellingen samenbrengt. Deze digitale kunstgalerie is een uniek cultureel aanbod."
    ]
  },
