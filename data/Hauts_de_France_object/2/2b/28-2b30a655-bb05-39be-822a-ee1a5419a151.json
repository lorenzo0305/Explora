  "rdfs:comment": {
    "de": [
      "Aufwertung des lokalen materiellen und immateriellen Kulturerbes, Bewahrung des Ortsgedächtnisses, Aufwertung und Beleuchtung der Traditionen und des Alltagslebens zur Zeit des Aufschwungs des Badeortes und später im Laufe der Epochen... Zeitzeugenberichte, Objekte, beschreibende Tafeln, Postkarten"
    ],
    "en": [
      "Promoting local tangible and intangible heritage, preserving the memory of the place, highlighting traditions and daily life at the time of the development of the seaside resort and through the ages... Testimonials, objects, descriptive panels, postcards"
    ],
    "it": [
      "Promuovere il patrimonio locale materiale e immateriale, conservare la memoria del luogo, promuovere e valorizzare le tradizioni e la vita quotidiana all'epoca dello sviluppo della località balneare e nel corso dei secoli... Testimonianze, oggetti, pannelli descrittivi, cartoline, ecc"
    ],
    "fr": [
      "Valorisation du patrimoine matériel et immatériel local, préservation de la mémoire des lieux, valorisation et mise en lumière des traditions et de la vie quotidienne au moment de l'essor de la station balnéaire puis à travers les époques... Témoignages, objets, panneaux descriptifs, cartes postales"
    ],
    "es": [
      "Promover el patrimonio local material e inmaterial, preservar la memoria del lugar, promover y poner de relieve las tradiciones y la vida cotidiana en la época del desarrollo de la estación balnearia y a través de los tiempos... Testimonios, objetos, paneles descriptivos, postales, etc"
    ],
    "nl": [
      "Plaatselijk materieel en immaterieel erfgoed promoten, het geheugen van de plaats bewaren, tradities en het dagelijkse leven ten tijde van de ontwikkeling van de badplaats en door de eeuwen heen promoten en belichten... Getuigenissen, voorwerpen, beschrijvende panelen, ansichtkaarten, enz"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ault - Le petit musée"
    ]
  },
