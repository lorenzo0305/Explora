  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, unsere Leidenschaft für die \"hausgemachte\" Küche und unsere traditionellen Wurstspezialitäten, die vom Chefkoch und gelernten Metzger hergestellt werden, und die Patisserie vom Sohn (4. bester Lehrling Frankreichs), werden Ihre Wünsche erfüllen."
    ],
    "en": [
      "Traditional restaurant, our passion for home cooking and our traditional delicatessen specialties made by the chef and the pastry by the son (4th best apprentice in France) will satisfy your desires."
    ],
    "it": [
      "Il ristorante tradizionale, la nostra passione per la cucina casalinga e le nostre specialità di salumi tradizionali preparate dallo chef, salumiere di professione, e la pasticceria del figlio (4° miglior apprendista di Francia) soddisferanno i vostri desideri."
    ],
    "fr": [
      "Restaurant traditionnel, notre passion pour la cuisine \"maison\" et nos spécialités de charcuterie traditionnelles réalisées par le chef charcutier de métier et la pâtisserie par le fils (4ème meilleur apprenti de France) sauront satisfaire vos envies."
    ],
    "es": [
      "Restaurante tradicional, nuestra pasión por la cocina casera y nuestras especialidades de charcutería tradicional elaboradas por el chef, charcutero de profesión, y la pastelería del hijo (4º mejor aprendiz de Francia) satisfarán sus deseos."
    ],
    "nl": [
      "Het traditionele restaurant, onze passie voor de thuiskeuken en onze traditionele vleeswaren van de chef, een vleeshouwer van beroep, en het gebak van de zoon (4e beste leerling van Frankrijk) zullen aan uw wensen voldoen."
    ]
  },
