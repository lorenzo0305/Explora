  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3a053e07-2e3f-323c-8862-77183f42b608",
      "dc:description": {
        "de": [
          "Diese Lesewerkstatt wird je nach Alter der Teilnehmer ausgewählt und angepasst, also kommen Sie an einem der beiden Tage in den Genuss unserer schönen Bücher."
        ],
        "en": [
          "This reading workshop is chosen and adapted according to the age of the participants, so come and enjoy our beautiful books on one of the two days."
        ],
        "it": [
          "Questo laboratorio di lettura viene scelto e adattato in base all'età dei partecipanti, quindi venite a godervi i nostri bellissimi libri in uno dei due giorni."
        ],
        "fr": [
          "Cet atelier de lecture est choisi et adapté en fonction de l'âge des participants, alors venez profiter sur l'un des deux jours de nos beaux livres."
        ],
        "es": [
          "Este taller de lectura se elige y adapta en función de la edad de los participantes, así que ven a disfrutar de nuestros hermosos libros uno de los dos días."
        ],
        "nl": [
          "Deze leesworkshop wordt gekozen en aangepast aan de leeftijd van de deelnemers, dus kom en geniet van onze prachtige boeken op een van de twee dagen."
        ]
      },
