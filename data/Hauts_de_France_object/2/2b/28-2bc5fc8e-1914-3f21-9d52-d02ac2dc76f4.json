  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eac3ae21-3225-31a4-9f83-a9caf44ff631",
      "dc:description": {
        "de": [
          "Ein echtes Museum, das die Arbeit der Reben und des Weins nachzeichnet, eine Videoprojektion in einem Weinkeller aus dem 19. Jahrhundert, ein unumgänglicher Entdeckungsworkshop rund um die Sinne, mit oder ohne Verkostung."
        ],
        "en": [
          "A veritable museum retracing the work of vines and wine, a video projected in a 19th-century cellar, and an essential sensory discovery workshop, with or without tasting."
        ],
        "it": [
          "Un vero e proprio museo che ripercorre il lavoro della vite e del vino, un video proiettato in una cantina del XIX secolo e un laboratorio di scoperta sensoriale essenziale, con o senza degustazione."
        ],
        "fr": [
          "Un véritable musée retraçant le travail de la vigne et du vin, une vidéo projetée dans un caveau du XIXè siècle, un incontournable atelier découverte autour des sens, avec ou sans dégustation."
        ],
        "es": [
          "Un auténtico museo que recorre el trabajo de la vid y el vino, un vídeo proyectado en una bodega del siglo XIX y un taller de descubrimiento sensorial imprescindible, con o sin degustación."
        ],
        "nl": [
          "Een echt museum over het werk van de wijnstok en de wijn, een video geprojecteerd in een 19e-eeuwse kelder en een essentiële sensoriële ontdekkingsworkshop, met of zonder proeverij."
        ]
      },
      "@type": [
        "Description"
