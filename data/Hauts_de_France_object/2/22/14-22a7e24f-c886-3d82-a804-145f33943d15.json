  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3e9d6307-b8dd-3679-82da-f309193097fb",
      "dc:description": {
        "de": [
          "Rock, Hits, Talente, Ausgeschlossene: der ideale Cocktail, um sich in Ihrer Nähe auszutoben! Erleben Sie diesen außergewöhnlichen Moment mit dynamischen Künstlern, die Sie sicherlich überraschen werden!"
        ],
        "en": [
          "Rock, hits, talent and exclusivity: the perfect cocktail to let off steam near you! Come and experience this exceptional moment with dynamic artists who are sure to surprise you!"
        ],
        "it": [
          "Rock, hit, talento ed emarginati: il cocktail perfetto per sfogarsi vicino a voi! Venite a vivere questo momento eccezionale con artisti dinamici che sicuramente vi sorprenderanno!"
        ],
        "fr": [
          "Du rock, des tubes, du talent, des exclus : le cocktail idéal pour se défouler près de chez vous ! Venez vivre ce moment d’exception avec des artistes dynamiques qui ne manqueront pas de vous surprendre !"
        ],
        "nl": [
          "Rock, hits, talent en outcasts: de perfecte cocktail om stoom af te blazen bij jou in de buurt! Kom en beleef dit uitzonderlijke moment met dynamische artiesten die je zeker zullen verrassen!"
        ],
        "es": [
          "Rock, éxitos, talento y marginados: ¡el cóctel perfecto para desahogarse cerca de ti! ¡Ven a disfrutar de este evento excepcional con artistas dinámicos que seguro te sorprenderán!"
        ]
      },
