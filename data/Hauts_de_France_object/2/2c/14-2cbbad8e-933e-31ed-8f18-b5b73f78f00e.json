  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/18cedd0a-5543-3860-a1cb-04a278c9be96",
      "dc:description": {
        "de": [
          "Mögen Sie Pizza?? Bier? Und das Reisen? Dann kommen Sie und entdecken Sie die Pizzeria Le Baroudeur. Ein familiärer Ort, der mitten im Dorfzentrum von Conteville les Boulogne wieder zum Leben erweckt wurde."
        ],
        "en": [
          "Do you like pizza??? How about beer? And travel? Come and discover Le Baroudeur pizzeria. A family-run place brought up to date right in the center of the village of Conteville les Boulogne."
        ],
        "it": [
          "Vi piace la pizza? Ti piace la birra? E viaggiare? Venite a scoprire la pizzeria Le Baroudeur. Un locale a conduzione familiare aggiornato proprio nel centro del villaggio di Conteville les Boulogne."
        ],
        "fr": [
          "Vous aimez les pizzas ??? La bière ? Et les voyages ? Venez découvrir la pizzeria Le Baroudeur. Un lieu familial remis au goût du jour en plein centre du village de Conteville les Boulogne."
        ],
        "es": [
          "¿Le gusta la pizza? ¿Te gusta la cerveza? ¿Y viajar? Venga a descubrir la pizzería Le Baroudeur. Un local familiar puesto al día en pleno centro del pueblo de Conteville les Boulogne."
        ],
        "nl": [
          "Hou je van pizza? Hou je van bier? En van reizen? Kom dan pizzeria Le Baroudeur ontdekken. Een modern familiehuis in het centrum van Conteville les Boulogne."
        ]
      },
