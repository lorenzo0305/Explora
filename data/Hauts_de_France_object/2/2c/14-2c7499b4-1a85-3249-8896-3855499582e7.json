      "dc:description": {
        "de": [
          "Samstag, 11. April 2026\n\nAutomobile - Rallye der jungen Eleganten\nOrganisiert von der Association le Touquet Automobiles de Collection\nAbfahrt 8 Uhr und Rückkehr 17.30 Uhr am Centre Léonce Deprez"
        ],
        "en": [
          "Saturday, April 11, 2026\n\nAutomobile - Rallye des Jeunes Elégants\nOrganized by the Association le Touquet Automobiles de Collection\nDeparture 8am and return 5.30pm at the Centre Léonce Deprez"
        ],
        "it": [
          "Sabato 11 aprile 2026\n\nAutomobile - Rally dei giovani emergenti\nOrganizzato dall'Associazione le Touquet Automobiles de Collection\nPartenza alle 8.00 e ritorno alle 17.30 presso il Centro Léonce Deprez"
        ],
        "fr": [
          "Samedi 11 avril 2026\n\nAutomobile - Rallye des Jeunes Elégants\nOrganisé par l'Association le Touquet Automobiles de Collection\nDépart 8h et retour 17h30 au Centre Léonce Deprez"
        ],
        "nl": [
          "Zaterdag 11 april 2026\n\nAuto - Rallye des Jeunes Elégants\nGeorganiseerd door de Association le Touquet Automobiles de Collection\nVertrek 8 uur en terugkomst 17.30 uur bij het Centre Léonce Deprez"
        ],
        "es": [
          "Sábado 11 de abril de 2026\n\nAutomóvil - Rallye des Jeunes Elégants\nOrganizado por la Association le Touquet Automobiles de Collection\nSalida a las 8h y regreso a las 17h30 en el Centro Léonce Deprez"
        ]
      },
