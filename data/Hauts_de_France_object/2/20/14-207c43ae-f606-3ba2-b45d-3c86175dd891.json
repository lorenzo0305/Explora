  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f7299ef7-8e2f-33c6-919a-c714824490f4",
      "dc:description": {
        "de": [
          "Das Hotel Désandrouin beherbergte dreimal den Kaiser (1803, 1810 und 1811). Drei Blitzbesuche reichten aus, um das prächtige Herrenhaus aus dem späten 18. Jahrhundert in \"Palais Impérial\" umzubenennen"
        ],
        "en": [
          "The Hôtel Désandrouin played host to the Emperor on three occasions (1803, 1810 and 1811). The three visits were enough to rename this magnificent late 18th-century mansion the \"Imperial Palace\""
        ],
        "it": [
          "L'Hôtel Désandrouin ospitò l'imperatore in tre occasioni (1803, 1810 e 1811). Queste tre brevi visite furono sufficienti per ribattezzare questa magnifica casa di città della fine del XVIII secolo come \"Palazzo Imperiale\""
        ],
        "fr": [
          "L’hôtel Désandrouin a accueilli à trois reprises l’empereur (1803, 1810 et 1811). Trois passages éclair qui ont suffi à rebaptiser ce magnifique hôtel particulier de la fin du XVIIIe siècle en « Palais Impérial\""
        ],
        "nl": [
          "Het Hôtel Désandrouin was drie keer gastheer van de keizer (1803, 1810 en 1811). Deze drie korte bezoeken waren voldoende om dit prachtige herenhuis uit het einde van de 18e eeuw om te dopen tot \"keizerlijk paleis\""
        ],
        "es": [
          "El Hôtel Désandrouin acogió al Emperador en tres ocasiones (1803, 1810 y 1811). Estas tres breves visitas bastaron para rebautizar este magnífico palacete de finales del siglo XVIII con el nombre de \"Palacio Imperial\""
        ]
      },
      "@type": [
        "Description"
      ],
