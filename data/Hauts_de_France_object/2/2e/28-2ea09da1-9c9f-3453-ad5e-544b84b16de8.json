  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fda785b3-cb71-3c1e-9f50-8862645baee4",
      "dc:description": {
        "de": [
          "Die Marke Le Comptoir du Malt - deren Credo die volkstümliche und lokale Brauküche ist, die mit dem kulturellen Erbe der Regionen des Nordens und des Ostens verbunden ist - hat sich in Chambry, ganz in der Nähe von Laon, niedergelassen!"
        ],
        "en": [
          "The Comptoir du Malt brand - whose credo is popular, local brewery cuisine in keeping with the cultural heritage of the northern and eastern regions of France - has set up shop in Chambry, just outside Laon!"
        ],
        "it": [
          "Il marchio Comptoir du Malt - il cui credo è una cucina popolare e locale basata sul patrimonio culturale del Nord e dell'Est della Francia - ha aperto un negozio a Chambry, alle porte di Laon!"
        ],
        "fr": [
          "L'enseigne du Comptoir du Malt - dont le credo est la cuisine brassicole, populaire et locale, en lien avec l’héritage culturel des régions du Nord et de l’Est - s'est installée à Chambry, tout près de Laon !"
        ],
        "es": [
          "La marca Comptoir du Malt -cuyo credo es la cocina cervecera popular y local basada en el patrimonio cultural del norte y el este de Francia- se ha instalado en Chambry, a las afueras de Laon"
        ],
        "nl": [
          "Het merk Comptoir du Malt - met als credo populaire, lokale brouwerijkeuken gebaseerd op het culturele erfgoed van het noorden en oosten van Frankrijk - heeft zich gevestigd in Chambry, net buiten Laon!"
        ]
      },
