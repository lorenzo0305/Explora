  "rdfs:comment": {
    "de": [
      "Das Restaurant \"la cascade\" empfängt Sie in einem hellen und geräumigen Rahmen.Raffinierte Küche, die mit Sorgfalt aus frischen Qualitätsprodukten zubereitet wird."
    ],
    "en": [
      "The restaurant \"La Cascade\" welcomes you in a bright and spacious setting."
    ],
    "it": [
      "Il ristorante \"La Cascade\" vi accoglie in un ambiente luminoso e spazioso, dove potrete gustare una cucina raffinata, preparata con cura e con prodotti freschi e di qualità."
    ],
    "fr": [
      "Le restaurant \" la cascade\" vous accueille dans un cadre lumineux et spacieux.Cuisine raffinée, élaborée avec soin avec des produits frais de qualité."
    ],
    "nl": [
      "Het restaurant \"La Cascade\" verwelkomt u in een lichte en ruime omgeving, waar u kunt genieten van verfijnde gerechten, zorgvuldig bereid met verse kwaliteitsproducten."
    ],
    "es": [
      "El restaurante \"La Cascade\" le da la bienvenida en un ambiente luminoso y espacioso, donde podrá degustar una cocina refinada, cuidadosamente elaborada con productos frescos de calidad."
    ]
  },
