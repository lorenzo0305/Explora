  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2ee01efb-db44-332f-9325-93a6a326125c",
      "dc:description": {
        "de": [
          "Das Anbaugebiet der Erdbeere von Samer erstreckt sich über das gesamte Gebiet und wird seit über einem Jahrhundert angebaut.\nHerr Dumont ist einer der Erdbeerproduzenten von Samer."
        ],
        "en": [
          "The Samer strawberry-growing area extends over the whole territory, and has been cultivated for over a century.\nMr Dumont is one of the Samer strawberry growers."
        ],
        "it": [
          "La zona di coltivazione delle fragole di Samer copre l'intera regione e viene coltivata da oltre un secolo.\nIl signor Dumont è uno dei coltivatori di fragole di Samer."
        ],
        "fr": [
          "La zone de culture de la fraise de Samer s'étend sur tout le territoire, elle est cultivée depuis plus d'un siècle. \nMr Dumont fait parti des Producteur de fraises de Samer."
        ],
        "es": [
          "La zona fresera de Samer abarca toda la región y se cultiva desde hace más de un siglo.\nEl Sr. Dumont es uno de los cultivadores de fresas de Samer."
        ],
        "nl": [
          "Het aardbeigebied van Samer strekt zich uit over de hele regio en wordt al meer dan een eeuw geteeld.\nMeneer Dumont is een van de aardbeientelers van Samer."
        ]
      },
