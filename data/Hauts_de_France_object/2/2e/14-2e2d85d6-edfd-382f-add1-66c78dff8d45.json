      "@id": "https://data.datatourisme.fr/0907d427-4249-3c5b-87b8-0a249cfba32b",
      "dc:description": {
        "de": [
          "19 KM LANGER WANDERWEG - 5 STUNDEN\nABFAHRT VOM KERAMIKMUSEUM IN DESVRES\nGELB MARKIERTER RUNDWEG - UMLEITUNG WÄHREND DER JAGDSAISON VORGESEHEN\nFinden Sie den Verlauf des Rundwegs auf der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "19 KM WALKING TRAIL - 5H\nDEPARTURE FROM THE DESVRES CERAMICS MUSEUM\nCIRCUIT MARKED IN YELLOW - DEVIATION PLANNED DURING THE HUNTING SEASON\nFind the route of the circuit on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO A PIEDI DI 19 KM - 5 ORE\nPARTE DAL MUSEO DELLA CERAMICA DI DESVRES\nPERCORSO SEGNATO IN GIALLO - DEVIAZIONE PREVISTA DURANTE LA STAGIONE DI CACCIA\nIl percorso è disponibile sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 19 KM - 5H\nDEPART DU MUSEE DE LA CERAMIQUE DE DESVRES\nCIRCUIT BALISEE EN JAUNE - DEVIATION PREVUE PENDANT LA SAISON DE CHASSE\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA A PIE DE 19 KM - 5 HORAS\nSALIDA DESDE EL MUSEO DE LA CERÁMICA DE DESVRES\nRUTA MARCADA EN AMARILLO - DESVÍO PREVISTO DURANTE LA TEMPORADA DE CAZA\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su Smartphone."
        ],
        "nl": [
          "19 KM WANDELROUTE - 5 UUR\nVERTREK AAN HET KERAMIEKMUSEUM DESVRES\nROUTE GEEL GEMARKEERD - AFWIJKING GEPLAND TIJDENS HET JACHTSEIZOEN\nJe vindt de route op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
