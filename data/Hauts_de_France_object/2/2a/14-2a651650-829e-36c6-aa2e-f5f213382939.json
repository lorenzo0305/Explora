  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bfbdb4fc-cd4f-30ff-8ef4-5051009f19fa",
      "dc:description": {
        "de": [
          "Reiten vor Ort:<br> Reitunterricht für Erwachsene und Kinder ab 3 Jahren auf Pferden oder Ponys.    Sie können mit dem Reiten beginnen und als Fortgeschrittener von einem Gruppenkurs oder einem Ausritt in der schönen Jahreszeit profitieren.25 Reiter <br>(auf Reservierung)."
        ],
        "en": [
          "On-site horseback riding:<br>We offer lessons for adults and children aged 3 and over on horses and ponies.    You can learn to ride and, if you are more experienced, enjoy a group lesson or a ride in summer.25?/rider <br>(booking required)."
        ],
        "it": [
          "Equitazione in loco:<br> Sono disponibili lezioni per adulti e bambini dai 3 anni in su su cavalli e pony.    È possibile imparare a cavalcare e, se si è più esperti, godersi una lezione di gruppo o una cavalcata nei mesi estivi al costo di 25€ a cavaliere (su prenotazione)."
        ],
        "fr": [
          "Equitation sur place :<br>Possibilités de leçons, adultes ou enfants, à partir de 3 ans sur chevaux ou poneys.    Vous pourrez vous initier à l’équitation et si vous êtes confirmé  profiter d’un cours collectif ou d’une promenade à la belle saison.Compter 25€/ cavalier <br>(sur réservation)."
        ],
        "nl": [
          "Paardrijden op het terrein:<br> Er zijn lessen op paarden en pony's voor volwassenen en kinderen vanaf 3 jaar.    U kunt leren paardrijden en, als u meer ervaren bent, genieten van een groepsles of een ritje in de zomermaanden voor 25€ per ruiter (reserveren verplicht)."
        ],
        "es": [
          "Equitación in situ:<br> Se imparten clases de equitación para adultos y niños a partir de 3 años.    Puede aprender a montar y, si tiene más experiencia, disfrutar de una clase en grupo o de un paseo en los meses de verano a un precio de 25 € por jinete (es necesario reservar)."
        ]
      },
      "@type": [
