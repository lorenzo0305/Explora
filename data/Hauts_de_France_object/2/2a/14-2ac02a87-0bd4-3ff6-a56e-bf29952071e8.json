  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4a97c2f9-ccc9-3dc6-9a45-8b1e570ff278",
      "dc:description": {
        "de": [
          "Dieses historische Hotel empfängt Sie auf dem Grand Place und bietet einen atemberaubenden Blick auf den UNESCO-geschützten Belfried. Komfortable Zimmer, ein gemütliches Restaurant und eine trendige Bar versprechen Ihnen einen unvergesslichen Aufenthalt."
        ],
        "en": [
          "This historic hotel welcomes you on the Grand-Place, with a breathtaking view of the UNESCO-listed belfry. Comfortable rooms, a warm restaurant and a trendy bar promise an unforgettable stay."
        ],
        "it": [
          "Questo storico hotel vi accoglie sulla Grand-Place, con una vista mozzafiato sul campanile dell'UNESCO. Camere confortevoli, un ristorante accogliente e un bar alla moda promettono un soggiorno indimenticabile."
        ],
        "fr": [
          "Cet hôtel historique vous accueille sur la Grand-Place, offrant une vue imprenable sur le beffroi classé à l'UNESCO. Chambres confortables, restaurant chaleureux et bar tendance vous promettent un séjour inoubliable."
        ],
        "es": [
          "Este histórico hotel le da la bienvenida en la Grand-Place, con una impresionante vista del campanario declarado Patrimonio de la Humanidad por la UNESCO. Habitaciones confortables, un restaurante acogedor y un bar de moda prometen una estancia inolvidable."
        ],
        "nl": [
          "Dit historische hotel verwelkomt je op de Grote Markt, met een adembenemend uitzicht op het in de UNESCO-lijst opgenomen belfort. Comfortabele kamers, een gezellig restaurant en een trendy bar beloven een onvergetelijk verblijf."
        ]
      },
      "@type": [
        "Description"
      ],
