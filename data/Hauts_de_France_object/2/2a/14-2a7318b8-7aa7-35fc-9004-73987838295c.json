      "dc:description": {
        "de": [
          "Gemischter Chor unter der Leitung von Alain Kostek ist Teil von Multiphonie.\nTreffpunkt ist Donnerstagabend von 20:15 bis 22:30 Uhr. Praktizieren von Chorgesang"
        ],
        "en": [
          "Mixed choir directed by Alain Kostek is part of Multiphonie.\nThursday evenings from 8:15 to 10:30 pm. Choral singing practice"
        ],
        "it": [
          "Il coro misto diretto da Alain Kostek fa parte di Multiphonie.\nIl coro si riunisce il giovedì sera dalle 20.15 alle 22.30. Canto corale"
        ],
        "fr": [
          "Chorale mixte dirigée par Alain Kostek fait partie de Multiphonie.\nRendez-vous le jeudi soir de 20h15 à 22h30. Pratique du chant choral"
        ],
        "nl": [
          "Gemengd koor onder leiding van Alain Kostek maakt deel uit van Multiphonie.\nHet koor komt samen op donderdagavond van 20.15 tot 22.30 uur. Koorzang"
        ],
        "es": [
          "El coro mixto dirigido por Alain Kostek forma parte de la Multifonía.\nEl coro se reúne los jueves por la tarde de 20.15 a 22.30. Canto coral"
        ]
      },
