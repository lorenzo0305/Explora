      "dc:description": {
        "de": [
          "Möchten Sie ein Spezialagent werden? Melden Sie sich an und entdecken Sie die Geheimnisse des Gartens und seiner Bewohner in einer spannenden Ermittlung."
        ],
        "en": [
          "Would you like to become a special agent? Sign up to discover the mysteries of the garden and its inhabitants, through an investigation full of twists and turns."
        ],
        "it": [
          "Volete diventare un agente speciale? Iscriviti per scoprire i misteri del giardino e dei suoi abitanti, attraverso un'indagine ricca di colpi di scena."
        ],
        "fr": [
          "Voulez-vous devenir des agents spéciaux? Inscrivez-vous pour découvrir les mystères du jardin et ses habitants, à travers une enquête riche en rebondissement."
        ],
        "es": [
          "¿Quieres convertirte en un agente especial? Apúntate para descubrir los misterios del jardín y sus habitantes, a través de una investigación llena de giros y sorpresas."
        ],
        "nl": [
          "Wil jij een special agent worden? Meld je aan om de mysteries van de tuin en zijn bewoners te ontdekken door middel van een onderzoek vol wendingen."
        ]
      },
