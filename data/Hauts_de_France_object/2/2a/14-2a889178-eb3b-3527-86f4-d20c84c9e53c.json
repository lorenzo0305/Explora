  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/375c0024-9956-35b1-9657-7af31d8ccc82",
      "dc:description": {
        "de": [
          "Rundgang an den Stränden\nVon 14.00 bis 17.00 Uhr in der Talfahrt.\nEs erwarten Sie zahlreiche Animationen: DJ, Basketball-Einführungen, Fotostand mit dem Maskottchen, Partnerstände, ESSM-Shop... für einzigartige Momente, die Sie mit der Familie oder mit Freunden teilen können"
        ],
        "en": [
          "Beach tour\nFrom 2:00 pm to 5:00 pm on the beach.\nLots of entertainment awaits you: DJ, basketball initiations, photo booth with the mascot, partner booths, ESSM boutique... for unique moments to share with family and friends"
        ],
        "it": [
          "Giro della spiaggia\nDalle 14.00 alle 17.00 lungo la spiaggia.\nTanti intrattenimenti vi aspettano: DJ, iniziazioni al basket, stand fotografico con la mascotte, stand di partner, negozio ESSM... per momenti unici da condividere con la famiglia e gli amici"
        ],
        "fr": [
          "Tournée des plages\nDe 14h00 à 17h00 en descente de palge.\nDe nombreuses animations vous attendent : DJ, inititations au basket, stand photo avec la mascotte, stands partenaires, boutique de l'ESSM... pour des moments uniques à partager en famille ou entre amis"
        ],
        "nl": [
          "Strandtour\nVan 14.00 tot 17.00 uur over het strand.\nEr staat je veel entertainment te wachten: DJ, basketbalinitiatie, fotostand met de mascotte, partnerstands, ESSM-winkel... voor unieke momenten om te delen met familie en vrienden"
        ],
        "es": [
          "Recorrido por la playa\nDe 14.00 a 17.00 h. por la playa.\nTe esperan muchas animaciones: DJ, iniciaciones al baloncesto, stand de fotos con la mascota, stands de socios, tienda ESSM... para vivir momentos únicos que compartir con la familia y los amigos"
        ]
      },
      "@type": [
        "Description"
      ],
