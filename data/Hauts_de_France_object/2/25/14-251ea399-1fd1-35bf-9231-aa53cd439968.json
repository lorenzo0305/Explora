      "@id": "https://data.datatourisme.fr/424b210a-5621-3661-977b-88b1bb98132a",
      "dc:description": {
        "de": [
          "Unsere Tiere werden hauptsächlich mit auf dem Hof angebautem Futter aufgezogen. Von unserer Zucht bis zu Ihrem Tisch. Direktverkauf."
        ],
        "en": [
          "Our animals are raised mainly on feed grown on the farm. From our farm to your table. Direct sales."
        ],
        "it": [
          "I nostri animali sono allevati principalmente con mangimi coltivati in azienda. Dalla nostra fattoria alla vostra tavola. Vendita diretta."
        ],
        "fr": [
          "Nos animaux sont élevés principalement avec les aliments cultivés à la ferme. De notre élevage à votre table. Vente directe."
        ],
        "nl": [
          "Onze dieren worden voornamelijk gefokt met voer dat op de boerderij wordt verbouwd. Van onze boerderij naar uw tafel. Directe verkoop."
        ],
        "es": [
          "Nuestros animales se crían principalmente con piensos cultivados en la granja. De nuestra granja a su mesa. Venta directa."
        ]
      },
