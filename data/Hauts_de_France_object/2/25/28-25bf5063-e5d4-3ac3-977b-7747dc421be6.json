  "rdfs:comment": {
    "de": [
      "Restauration im traditionellen Stil, 60 Gedecke innen und 24 außen in einer angenehmen Umgebung.\nIn der Nähe der Abtei von Longpont, die zwischen Juni und September zur Besichtigung geöffnet ist."
    ],
    "en": [
      "Traditional restaurant, 60 covers inside and 24 outside in pleasant surroundings.\nNear Longpont Abbey, open to visitors between June and September."
    ],
    "it": [
      "Ristorante tradizionale, 60 coperti all'interno e 24 all'esterno in un ambiente piacevole.\nVicino all'Abbazia di Longpont, aperto ai visitatori tra giugno e settembre."
    ],
    "fr": [
      "Restauration de type traditionnel, 60 couverts en intérieur et 24 en extérieur dans un cadre agréable. \nA proximité de l'abbaye de Longpont, ouverte à la visite entre juin et septembre."
    ],
    "nl": [
      "Traditioneel restaurant, 60 couverts binnen en 24 buiten in een aangename omgeving.\nVlakbij Longpont Abbey, open voor bezoekers tussen juni en september."
    ],
    "es": [
      "Restaurante tradicional, 60 cubiertos en el interior y 24 en el exterior en un entorno agradable.\nCerca de la abadía de Longpont, abierto a los visitantes entre junio y septiembre."
    ]
  },
