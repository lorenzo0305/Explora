  "rdfs:comment": {
    "de": [
      "Ein Besuch, bei dem Sie einen atemberaubenden Blick auf die Chroma-Show der Kathedrale genießen können...\n\nReservierung erforderlich: bit.ly/resaAMAH\noder 03 22 22 58 90\n\nTreffpunkt am Fuße des Belfrieds? Platz am Faden.\nBezahlung beim Fremdenführer.\nDauer: 1h/1h15"
    ],
    "en": [
      "A visit where you can enjoy a breathtaking view of the Cathedral's Chroma show...\n\nReservations required: bit.ly/resaAMAH\nor 03 22 22 58 90\n\nMeet at the foot of the belfry ? Place au fil.\nPayment with the guide.\nDuration: 1h/1h15"
    ],
    "it": [
      "Una visita in cui si può godere di una vista mozzafiato sullo spettacolo Chroma della Cattedrale...\n\nPrenotazione obbligatoria: bit.ly/resaAMAH\no 03 22 22 58 90\n\nAppuntamento ai piedi del campanile? Place au fil.\nPagamento con la guida.\nDurata: 1h/1h15"
    ],
    "fr": [
      "Une visite où vous pourrez profiter d'une vue imprenable sur le spectacle Chroma de la Cathédrale...\n\nRéservation obligatoire : bit.ly/resaAMAH\nou 03 22 22 58 90\n\nRdv au pied du beffroi – Place au fil. \nPaiement auprès du guide.\nDurée : 1h/1h15"
    ],
    "es": [
      "Una visita en la que podrá disfrutar de una impresionante vista del espectáculo Chroma de la Catedral...\n\nImprescindible reservar: bit.ly/resaAMAH\no 03 22 22 58 90\n\nEncuentro al pie del campanario ? Place au fil.\nPago con el guía.\nDuración: 1h/1h15"
    ],
    "nl": [
      "Een bezoek waar je kunt genieten van een adembenemend uitzicht op de Chroma show van de kathedraal...\n\nReserveren noodzakelijk: bit.ly/resaAMAH\nof 03 22 22 58 90\n\nAfspraak aan de voet van het belfort ? Place au fil.\nBetaling met de gids.\nDuur: 1u/1u15"
    ]
  },
