  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f6cb3d5d-4397-35dc-bcaa-95835dd425f9",
      "dc:description": {
        "de": [
          "In Wimille bietet Le Potager de mon Bio Coin saisonales Obst und Gemüse aus lokaler Produktion an, das die natürlichen Kreisläufe respektiert.\nFrische, reif geerntete Produkte für eine gesunde und schmackhafte Ernährung auf kurzem Wege."
        ],
        "en": [
          "In Wimille, Le Potager de mon Bio Coin offers seasonal fruit and vegetables grown locally and respecting natural cycles.\nFresh produce, picked when ripe, for a healthy, tasty diet in a short supply chain."
        ],
        "it": [
          "A Wimille, Le Potager de mon Bio Coin offre frutta e verdura di stagione coltivata in loco e nel rispetto dei cicli naturali.\nProdotti freschi, raccolti al momento giusto, per un'alimentazione sana e gustosa a filiera corta."
        ],
        "fr": [
          "À Wimille, Le Potager de mon Bio Coin propose des fruits et légumes de saison issus d’une production locale et respectueuse des cycles naturels.\nDes produits frais, cueillis à maturité, pour une alimentation saine et savoureuse en circuit court."
        ],
        "nl": [
          "In Wimille biedt Le Potager de mon Bio Coin seizoensfruit en -groenten die lokaal zijn geteeld en de natuurlijke cycli respecteren.\nVerse producten, geplukt wanneer ze rijp zijn, voor gezond en lekker eten in een korte toeleveringsketen."
        ],
        "es": [
          "En Wimille, Le Potager de mon Bio Coin ofrece frutas y verduras de temporada cultivadas localmente y respetando los ciclos naturales.\nProductos frescos, recogidos cuando están maduros, para una alimentación sana y sabrosa en una cadena de suministro corta."
        ]
      },
      "@type": [
        "Description"
      ],
