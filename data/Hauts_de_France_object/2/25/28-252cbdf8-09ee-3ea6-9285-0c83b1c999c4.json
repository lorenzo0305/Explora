  "rdfs:comment": {
    "de": [
      "Traditionelle Brasserie. Vorschläge auf Schiefertafel, große Auswahl an Weinen. Terrasse mit 60 Plätzen.\n\nAnzahl der Gedecke: 80\nEmpfang von Gruppen: 40 Personen\nLetzte Mahlzeit: 15:00 Uhr und 21:30 Uhr\nSonntagabend geschlossen."
    ],
    "en": [
      "Traditional brasserie. Suggestions on slate, wide choice of wines. Terrace seating for 60.\n\nNumber of seats: 80\nGroups: 40 people\nLast services: 3:00 pm and 9:30 pm\nClosed Sunday evenings."
    ],
    "it": [
      "Brasserie tradizionale. Suggerimenti su ardesia, ampia scelta di vini. Terrazza con 60 posti a sedere.\n\nNumero di coperti: 80\nGruppi: 40 persone\nUltimi servizi: 15:00 e 21:30\nChiuso la domenica sera."
    ],
    "fr": [
      "Brasserie traditionnelle. Suggestions sur ardoise, grand choix de vins. Terrasse 60 couverts.\n\nNombre de couverts: 80\nAccueil groupes: 40 personnes \nDerniers services: 15h00 et 21h30\nFermé les dimanches soirs."
    ],
    "nl": [
      "Traditionele brasserie. Suggesties op leisteen, ruime keuze aan wijnen. Terras met 60 zitplaatsen.\n\nAantal couverts: 80\nGroepen: 40 personen\nLaatste diensten: 15:00 en 21:30\nGesloten op zondagavond."
    ],
    "es": [
      "Brasería tradicional. Sugerencias en pizarra, amplia selección de vinos. Terraza para 60 comensales.\n\nNúmero de cubiertos: 80\nGrupos: 40 personas\nÚltimos servicios: 15:00 y 21:30\nCerrado los domingos por la noche."
    ]
  },
