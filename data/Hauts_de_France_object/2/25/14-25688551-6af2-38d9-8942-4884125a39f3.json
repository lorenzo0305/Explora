  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b9a0ae75-49ad-354b-9752-df1ca325da59",
      "dc:description": {
        "de": [
          "Die Schule ist für Gruppenkurse geöffnet: mittwochs von 13:30 bis 17:30 Uhr und samstags von 10:00 bis 12:00 Uhr. Einschreibungen: Einwohner der Gemeinde 50? für das Schuljahr. Außerhalb der Gemeinde 70? Gitarre, Synthesizer, Klavier, Orgel, Perkussion, Blasinstrumente (Kinder und Erwachsene). Einführung ab dem Alter von 5 Jahren. Solfeggio und Computerspiele. Die Schule ist während der Schulferien geschlossen."
        ],
        "en": [
          "School open for group lessons: Wednesdays from 1:30pm to 5:30pm and Saturdays from 10am to 12pm. Registration: commune residents 50? for the school year. Outside commune 70? Guitar, synthesizer, piano, organ, percussion, wind instruments (children and adults). Beginners from age 5. Solfeggio and computer games. School closed during school vacations."
        ],
        "it": [
          "Scuola aperta per lezioni di gruppo: mercoledì dalle 13.30 alle 17.30 e sabato dalle 10.00 alle 12.00. Iscrizione: residenti nel comune: 50 euro per l'anno scolastico. Fuori dal comune 70? Chitarra, sintetizzatore, pianoforte, organo, percussioni, strumenti a fiato (bambini e adulti). Principianti a partire dai 5 anni. Teoria musicale e giochi al computer. Scuola chiusa durante le vacanze scolastiche."
        ],
        "fr": [
          "École ouverte pour des cours collectifs : le mercredi de 13h30 à 17h30 et le samedi de 10h à 12h. Inscriptions : habitants de la commune 50€ pour l’année scolaire. Hors commune 70€. Guitare, synthétiseur, piano, orgue, percussions, instruments à vent (enfants et adultes). Initiation dès l’âge de 5 ans. Solfège et jeux sur ordinateur. École fermée pendant les vacances scolaires."
        ],
        "nl": [
          "School open voor groepslessen: woensdag van 13.30 tot 17.30 uur en zaterdag van 10.00 tot 12.00 uur. Inschrijving: buurtbewoners: 50 euro voor het schooljaar. Buiten de gemeente 70? Gitaar, synthesizer, piano, orgel, slagwerk, blaasinstrumenten (kinderen en volwassenen). Beginners vanaf 5 jaar. Muziektheorie en computerspelletjes. School gesloten tijdens schoolvakanties."
        ],
        "es": [
          "Escuela abierta para clases colectivas: miércoles de 13.30 a 17.30 h y sábados de 10 a 12 h. Matrícula: residentes locales: 50? para el curso escolar. Fuera del municipio: 70? Guitarra, sintetizador, piano, órgano, percusión, instrumentos de viento (niños y adultos). Principiantes a partir de 5 años. Teoría de la música y juegos de ordenador. Escuela cerrada durante las vacaciones escolares."
        ]
      },
