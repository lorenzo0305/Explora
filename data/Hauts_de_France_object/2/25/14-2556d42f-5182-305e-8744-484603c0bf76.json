  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/928533f6-343b-3aa7-86e2-be82ecbd4c8f",
      "dc:description": {
        "de": [
          "Die Hexenjagd\nSamstag, 22. November von 11 bis 14 Uhr\nRue de la Vendée - Attin\n----------------------------\nAuf dem Programm stehen:\n- Kürbissuppe und gruselige Geschichten!\n\nAb 6 Jahren - Animation vorgeschlagen von Sarah & Françoise\nProbieren Sie die Hexensuppe mit uns! Formel Suppe + Brot zum Preis von 3?\nReservieren Sie Ihre Formel per SMS unter 06 87 32 26 96\n\nKredit: La Plume à Loup"
        ],
        "en": [
          "Witch Hunt\nSaturday November 22nd from 11am to 2pm\nRue de la Vendée - Attin\n----------------------------\nOn the program:\n- Pumpkin soup and scary stories!\n\nAges 6 and up - Presented by Sarah & Françoise\nCome and enjoy the witches' soup with us! Soup + bread for 3?\nBook your package by SMS to 06 87 32 26 96\n\nCredit: La Plume à Loup"
        ],
        "it": [
          "Caccia alle streghe\nSabato 22 novembre dalle 11.00 alle 14.00\nRue de la Vendée - Attin\n----------------------------\nIn programma:\n- Zuppa di zucca e storie di paura!\n\nPer bambini dai 6 anni in su - a cura di Sarah & Françoise\nVenite a gustare con noi la zuppa delle streghe! Zuppa + pane per 3 persone?\nPrenotate il vostro pacchetto via SMS al numero 06 87 32 26 96\n\nCredito: La Plume à Loup"
        ],
        "fr": [
          "La Chasse aux Sorcières\nSamedi 22 novembre de 11h à 14h\nRue de la Vendée - Attin\n----------------------------\nAu programme : \n- Une soupe à la citrouille et des histoires effrayantes !\n\nA partir de 6 ans - Animation proposée par Sarah & Françoise\nRestez déguster la soupe des sorcières avec nous ! Formule soupe + pain au tarif de 3€\nRéservez votre formule par SMS au 06 87 32 26 96\n\nCrédit : La Plume à Loup"
        ],
        "es": [
          "La caza de brujas\nSábado 22 de noviembre de 11:00 a 14:00\nRue de la Vendée - Attin\n----------------------------\nEn el programa:\n- Sopa de calabaza e historias de miedo\n\nPara niños a partir de 6 años - organizado por Sarah & Françoise\n¡Ven a disfrutar con nosotros de la sopa de brujas! ¿Sopa + pan para 3?\nReserve su paquete por SMS al 06 87 32 26 96\n\nCrédito: La Plume à Loup"
        ],
        "nl": [
          "De heksenjacht\nZaterdag 22 november van 11 tot 14 uur\nRue de la Vendée - Attin\n----------------------------\nOp het programma:\n- Pompoensoep en enge verhalen!\n\nVoor kinderen vanaf 6 jaar - georganiseerd door Sarah & Françoise\nKom samen met ons genieten van de heksensoep! Soep + brood voor 3?\nReserveer je pakket via sms naar 06 87 32 26 96\n\nKrediet: La Plume à Loup"
        ]
      },
      "@type": [
        "Description"
      ],
