  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf die Suche nach einer authentischen und lokalen Küche in einem originellen Rahmen und einer gemütlichen Atmosphäre. Ma Reine ist eine Brasserie, die mit frischen und abwechslungsreichen Produkten arbeitet. Die Speisekarte variiert je nach Jahreszeit und verbindet eine einfache und leckere Küche."
    ],
    "en": [
      "Enjoy authentic, local cuisine in an original setting and cosy atmosphere. Ma Reine is a brasserie that works with a variety of fresh produce. The menu varies with the seasons, combining simple, gourmet cuisine."
    ],
    "it": [
      "Gustate l'autentica cucina locale in un ambiente originale e in un'atmosfera accogliente. Ma Reine è una brasserie che lavora con una varietà di prodotti freschi. Il menu varia a seconda della stagione e offre una cucina semplice e gourmet."
    ],
    "fr": [
      "Partez à la rencontre d'une cuisine authentique et locale dans un cadre original et une atmosphère cosy. Ma Reine est une brasserie qui travaille avec des produits frais et variés. La carte varie selon les saisons alliant une cuisine simple et gourmande."
    ],
    "nl": [
      "Geniet van authentieke, lokale gerechten in een origineel kader en gezellige sfeer. Ma Reine is een brasserie die werkt met een verscheidenheid aan verse producten. Het menu varieert naargelang het seizoen en biedt eenvoudige, gastronomische gerechten."
    ],
    "es": [
      "Disfrute de la auténtica cocina local en un marco original y un ambiente acogedor. Ma Reine es una brasserie que trabaja con una gran variedad de productos frescos. El menú varía según la temporada, ofreciendo una cocina sencilla y gourmet."
    ]
  },
