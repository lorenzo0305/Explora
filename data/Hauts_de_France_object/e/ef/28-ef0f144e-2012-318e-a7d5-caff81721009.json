  "rdfs:comment": {
    "de": [
      "Rdv Freitag, den 29. Mai um 20 Uhr in der Grange à Musique für ein schräges Popkonzert mit \"Forever Pavot\" und seinem Automaten Melchior und dem Duo \"Angle Mou\"."
    ],
    "en": [
      "Join us on Friday May 29 at 8pm at the Grange à Musique for a quirky pop concert featuring \"Forever Pavot\" and his automaton Melchior, and the duo \"Angle Mou\"."
    ],
    "it": [
      "Unitevi a noi venerdì 29 maggio alle 20.00 alla Grange à Musique per un concerto pop eccentrico con \"Forever Pavot\" e il suo automa Melchior, e il duo \"Angle Mou\"."
    ],
    "fr": [
      "Rdv Vendredi 29 mai à 20h à la Grange à Musique pour un concert Pop décalé avec \"Forever Pavot\" et son automate Melchior et le duo \"Angle Mou\"."
    ],
    "es": [
      "Únase a nosotros el viernes 29 de mayo a las 20:00 h en la Grange à Musique para asistir a un concierto de pop estrafalario en el que intervendrán \"Forever Pavot\" y su autómata Melchior, y el dúo \"Angle Mou\"."
    ],
    "nl": [
      "Kom op vrijdag 29 mei om 20.00 uur naar de Grange à Musique voor een eigenzinnig popconcert met \"Forever Pavot\" en zijn automaat Melchior, en het duo \"Angle Mou\"."
    ]
  },
