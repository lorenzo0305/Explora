  "rdfs:comment": {
    "de": [
      "Eingebettet in das wunderschöne Gehege der Abtei, angrenzend an die Sporthalle und die zukünftige Mediathek, empfängt Sie Ihr Schwimmbad in einem angenehmen und geschützten Rahmen."
    ],
    "en": [
      "Nestled in the magnificent enclosure of the Abbey, next to the gymnasium and the future media library, your swimming pool welcomes you in a pleasant and protected setting."
    ],
    "it": [
      "Immersa nel magnifico recinto dell'Abbazia, accanto alla palestra e alla futura mediateca, la vostra piscina vi accoglie in un ambiente piacevole e protetto."
    ],
    "fr": [
      "Nichée au sein du magnifique enclos de l'Abbaye, jouxtant le gymnase et la future médiathèque, votre piscine vous accueille dans un cadre agréable et protégé."
    ],
    "nl": [
      "Genesteld in de prachtige omheining van de Abdij, naast de gymzaal en de toekomstige mediatheek, verwelkomt uw zwembad u in een aangename en beschermde omgeving."
    ],
    "es": [
      "Enclavada en el magnífico recinto de la Abadía, junto al gimnasio y la futura mediateca, su piscina le da la bienvenida en un entorno agradable y protegido."
    ]
  },
