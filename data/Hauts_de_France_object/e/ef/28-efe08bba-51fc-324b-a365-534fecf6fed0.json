  "rdfs:comment": {
    "de": [
      "Seit über 15 Jahren heißen wir Sie willkommen, um eine authentische, hausgemachte Küche zu genießen, die mit Produkten aus der Region zubereitet wird."
    ],
    "en": [
      "For over 15 years, we've been welcoming you to enjoy authentic, homemade cuisine prepared with local produce."
    ],
    "it": [
      "Da oltre 15 anni, vi accogliamo per farvi gustare un'autentica cucina casalinga preparata con prodotti locali."
    ],
    "fr": [
      "Depuis plus de 15 ans, nous vous accueillons pour déguster une cuisine authentique, faite maison, et préparée avec des produits du terroir."
    ],
    "es": [
      "Desde hace más de 15 años, te damos la bienvenida para que disfrutes de auténtica comida casera elaborada con productos locales."
    ],
    "nl": [
      "Al meer dan 15 jaar verwelkomen we je om te genieten van authentiek, huisgemaakt eten bereid met lokale producten."
    ]
  },
