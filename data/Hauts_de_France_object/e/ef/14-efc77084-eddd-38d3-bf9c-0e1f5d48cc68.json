  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/25707d54-6ac9-3ead-b010-c450e7876386",
      "dc:description": {
        "de": [
          "Die Schlüssel zum Schloss - Begleiteter Rundgang\nDas Museum öffnet die Türen zum gräflichen Schloss, dem ersten Objekt der Sammlung. Betreten Sie die niedrigen Säle und Wehrgänge und entdecken Sie die mittelalterliche Burg und ihre Entwicklungen.\n\nKostenlos - Reservierung empfohlen - Begrenzte Teilnehmerzahl"
        ],
        "en": [
          "Les clefs du château - Guided tour\nThe museum opens its doors on the château comtal, the first object in the collection. Enter the lower rooms and walkways and discover the medieval castle and its evolution.\n\nFree - Reservations recommended - Limited capacity"
        ],
        "it": [
          "Le chiavi del castello - Visita guidata\nIl museo apre le porte al castello comtale, primo oggetto della collezione. Entrate nelle sale inferiori e nei camminamenti e scoprite il castello medievale e la sua evoluzione.\n\nGratuito - Si consiglia la prenotazione - Capacità limitata"
        ],
        "fr": [
          "Les clefs du château - Visite accompagnée\nLe musée ouvre les portes sur le château comtal, premier objet de la collection. Accédez aux salles basses et chemins de ronde et découvrez le château médiéval et ses évolutions. \n\nGratuit - Réservation conseillée - Jauge limitée"
        ],
        "es": [
          "Las llaves del castillo - Visita guiada\nEl museo abre sus puertas al château comtal, primer objeto de la colección. Acceda a las salas inferiores y a los pasillos y descubra el castillo medieval y su evolución.\n\nGratuito - Se recomienda reservar - Aforo limitado"
        ],
        "nl": [
          "De sleutels van het kasteel - Rondleiding\nHet museum opent zijn deuren voor het kasteel Comtal, het eerste object in de collectie. Betreed de lager gelegen kamers en gangen en ontdek het middeleeuwse kasteel en zijn evolutie.\n\nGratis - Reserveren aanbevolen - Beperkte capaciteit"
        ]
      },
      "@type": [
        "Description"
      ],
