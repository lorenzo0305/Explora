  "rdfs:comment": {
    "de": [
      "Atlantis ist ein asiatisches Restaurant, das ein All-you-can-eat-Buffet zu günstigen Preisen anbietet! Sie können chinesische und japanische Spezialitäten probieren, aber auch eine große Auswahl an Desserts!\nVerkauf zum Mitnehmen."
    ],
    "en": [
      "Atlantis is an Asian restaurant offering an all-you-can-eat buffet at low prices! You can enjoy Chinese and Japanese specialties, as well as a wide choice of desserts!\nTakeaway sales."
    ],
    "it": [
      "Atlantis è un ristorante asiatico che offre un buffet all-you-can-eat a prezzi bassi! Potrete gustare specialità cinesi e giapponesi e un'ampia scelta di dessert!\nVendite da asporto."
    ],
    "fr": [
      "Atlantis est restaurant asiatique qui propose un buffet à volonté à petits prix! Vous pouvez déguster spécialités chinoises et japonaises mais également un large choix de desserts!\nVente à emporter."
    ],
    "nl": [
      "Atlantis is een Aziatisch restaurant met een all-you-can-eat buffet tegen lage prijzen! Je kunt er genieten van Chinese en Japanse specialiteiten en een ruime keuze aan desserts!\nAfhaalmaaltijden."
    ],
    "es": [
      "Atlantis es un restaurante asiático que ofrece un bufé libre a precios económicos Podrá degustar especialidades chinas y japonesas, así como una amplia selección de postres\nVenta para llevar."
    ]
  },
