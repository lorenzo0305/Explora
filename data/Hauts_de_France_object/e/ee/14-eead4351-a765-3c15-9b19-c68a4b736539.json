  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3b7d30d5-20fa-34eb-9c0b-d8a90d6688f5",
      "dc:description": {
        "de": [
          "Unsere jungen Besucher sollen sich Herausforderungen stellen, um möglichst viele Punkte zu erreichen und ihr Zertifikat als zukünftige Archäologen zu erhalten."
        ],
        "en": [
          "Our young visitors are invited to take up challenges in order to score as many points as possible and obtain their future archaeologist's certificate."
        ],
        "it": [
          "I nostri giovani visitatori sono invitati a raccogliere le sfide per totalizzare il maggior numero di punti possibile e ottenere il loro futuro certificato di archeologo."
        ],
        "fr": [
          "Nos jeunes visiteurs sont invités à relever des défis afin d'obtenir le maximum de points et obtenir leur certificat de futur archéologue."
        ],
        "nl": [
          "Onze jonge bezoekers worden uitgenodigd om uitdagingen aan te gaan om zoveel mogelijk punten te scoren en hun toekomstige archeologendiploma te behalen."
        ],
        "es": [
          "Nuestros jóvenes visitantes están invitados a enfrentarse a retos para conseguir el mayor número de puntos posible y obtener su futuro certificado de arqueólogo."
        ]
      },
