  "rdfs:comment": {
    "de": [
      "Familiäres und freundliches Restaurant. Unsere Spezialität ist vor allem Fisch.\nWir arbeiten mit einer Küche mit frischen Zutaten und Produkten aus unserer Region."
    ],
    "en": [
      "Family and friendly restaurant. Our specialty is mainly fish.\nWe work with fresh products and products of our soil."
    ],
    "it": [
      "Ristorante familiare e accogliente. La nostra specialità è principalmente il pesce.\nLavoriamo con prodotti freschi e locali."
    ],
    "fr": [
      "Restaurant familiale et conviviale. Notre spécialité est principalement le poisson.\nNous travaillons une cuisine avec des produits frais et des produits de notre terroir."
    ],
    "es": [
      "Restaurante familiar y acogedor. Nuestra especialidad es principalmente el pescado.\nTrabajamos con productos frescos y de la tierra."
    ],
    "nl": [
      "Familiaal en vriendelijk restaurant. Onze specialiteit is voornamelijk vis.\nWij werken met verse producten en streekproducten."
    ]
