  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0eed94bb-1c48-36e1-9ba5-4e2b814d1bde",
      "dc:description": {
        "de": [
          "Willkommen in Quérénaing!\nAuf geht's zu einer Wanderung, bei der Sie das Dorf und seine Umgebung erkunden werden... Auf dem Programm stehen schöne Aussichten, lokale Produkte und die Pflastersteine von Paris-Roubaix!"
        ],
        "en": [
          "Welcome to Quérénaing!\nLet's set off for a hike that will take you to discover the village and its surroundings... On the program: beautiful panoramas, local produce and the cobblestones of Paris-Roubaix!"
        ],
        "it": [
          "Benvenuti a Quérénaing!\nPartiamo per una passeggiata che vi porterà alla scoperta del villaggio e dei suoi dintorni... In programma: bei panorami, prodotti locali e il pavé della Parigi-Roubaix!"
        ],
        "fr": [
          "Bienvenu à  Quérénaing!\nC'est parti pou rune randonnée qui vous emmènera à la découverte du village et de ses alentours...Au programme, de jolis panoramas, des produits locaux et les pavés du Paris-Roubaix!"
        ],
        "es": [
          "¡Bienvenido a Quérénaing!\nVamos a dar un paseo por el pueblo y sus alrededores... En el programa: hermosas vistas, productos locales y los adoquines de la París-Roubaix"
        ],
        "nl": [
          "Welkom in Quérénaing!\nLaten we op pad gaan voor een wandeling door het dorp en de omgeving... Op het programma: prachtige uitzichten, lokale producten en de kasseien van Parijs-Roubaix!"
        ]
      },
