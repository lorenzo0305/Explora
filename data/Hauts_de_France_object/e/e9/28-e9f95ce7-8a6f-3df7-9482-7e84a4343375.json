  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7deee53d-5546-39c1-83ff-a6d0668fa162",
      "dc:description": {
        "de": [
          "Auf der Speisekarte stehen einfache, beliebte und großzügige Gerichte aus saisonalen Produkten, die direkt von den besten italienischen Produzenten stammen. Alles ist zu 100% hausgemacht, vom frischen Teig bis zur neapolitanischen Pizza"
        ],
        "en": [
          "The à la carte menu features simple, popular and generous dishes based on seasonal produce sourced directly from the best Italian producers. Everything is 100% homemade, from the fresh dough to the Neapolitan pizza"
        ],
        "it": [
          "Nel menu, piatti semplici, popolari e generosi a base di prodotti di stagione provenienti direttamente dai migliori produttori italiani. Tutto è fatto in casa al 100%, dall'impasto fresco alla pizza napoletana"
        ],
        "fr": [
          "À la carte, plats simples, populaires et généreux à base de produits de saison en provenance direct des meilleurs producteurs Italiens. Le tout, 100% fait maison, de la pâte fraîche réalisée à la pizza napolitaine"
        ],
        "nl": [
          "Op het menu staan eenvoudige, populaire en royale gerechten op basis van seizoensproducten die rechtstreeks van de beste Italiaanse producenten worden betrokken. Alles is 100% huisgemaakt, van het verse deeg tot de Napolitaanse pizza"
        ],
        "es": [
          "En la carta, platos sencillos, populares y generosos a base de productos de temporada obtenidos directamente de los mejores productores italianos. Todo es 100% casero, desde la masa fresca hasta la pizza napolitana"
        ]
      },
