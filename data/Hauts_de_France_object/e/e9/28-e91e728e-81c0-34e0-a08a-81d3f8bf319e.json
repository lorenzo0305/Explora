  "rdfs:comment": {
    "de": [
      "La Voile Bleue empfängt Sie in einer gemütlichen Umgebung nur wenige Schritte vom Strand entfernt und bietet Ihnen Fischgerichte und Meeresfrüchte an. Genießen Sie Ihr Mittag- oder Abendessen auf der überdachten Terrasse und lassen Sie sich von der Aussicht auf das Meer verzaubern."
    ],
    "en": [
      "La Voile Bleue welcomes you in a warm setting a few steps from the beach and offers you fish and seafood dishes. Enjoy lunch or dinner on the covered terrace and appreciate the sea view."
    ],
    "it": [
      "La Voile Bleue vi accoglie in un ambiente accogliente a pochi passi dalla spiaggia e vi offre piatti a base di pesce e frutti di mare. Potrete pranzare o cenare sulla terrazza coperta e godervi la vista sul mare."
    ],
    "fr": [
      "La Voile Bleue vous accueille dans un cadre chaleureux à quelques pas de la plage et vous propose des plats de poissons et fruits de mer. Profitez de déjeuner ou dîner en terrasse couverte et appréciez la vue sur mer."
    ],
    "nl": [
      "La Voile Bleue verwelkomt u in een warme omgeving op een steenworp afstand van het strand en biedt u vis- en zeevruchtengerechten. Geniet van een lunch of diner op het overdekte terras en geniet van het uitzicht op zee."
    ],
    "es": [
      "La Voile Bleue le da la bienvenida en un ambiente cálido a pocos pasos de la playa y le ofrece platos de pescado y marisco. Disfrute del almuerzo o la cena en la terraza cubierta y disfrute de las vistas al mar."
    ]
  },
