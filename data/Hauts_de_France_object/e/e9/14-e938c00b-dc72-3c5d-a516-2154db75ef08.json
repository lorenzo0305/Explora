  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3f5a0478-a330-3eee-a955-b9dab61988f9",
      "dc:description": {
        "de": [
          "Sie müssen sich entspannen, loslassen, gönnen Sie sich einen Moment der Ruhe und Gelassenheit.\n\nZielgruppe: Erwachsene und Jugendliche ab 15 Jahren.\n\nDie genaue Adresse wird bei der Anmeldung angegeben."
        ],
        "en": [
          "If you need to relax and let go, treat yourself to a moment of relaxation and serenity.\n\nPublic: adults and teenagers over 15.\n\nPrecise address given on registration."
        ],
        "it": [
          "Se avete bisogno di rilassarvi e lasciarvi andare, concedetevi un momento di relax e serenità.\n\nPubblico: adulti e ragazzi sopra i 15 anni.\n\nIndirizzo preciso fornito al momento dell'iscrizione."
        ],
        "fr": [
          "Vous avez besoin de vous détendre, de lâcher prise, offrez-vous un moment de détente et de sérénité.\n\nPublic: adultes et ados + 15 ans.\n\nAdresse précise donnée à l'inscription."
        ],
        "es": [
          "Si necesita relajarse y dejarse llevar, regálese un momento de relajación y serenidad.\n\nPúblico: adultos y adolescentes mayores de 15 años.\n\nDirección exacta al inscribirse."
        ],
        "nl": [
          "Als je moet ontspannen en loslaten, trakteer jezelf dan op een moment van ontspanning en sereniteit.\n\nPubliek: volwassenen en tieners vanaf 15 jaar.\n\nPrecieze adres bij inschrijving."
        ]
      },
