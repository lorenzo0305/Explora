  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ed46fc1e-e33b-34ce-b75c-f239fdfd1bb6",
      "dc:description": {
        "de": [
          "SAMSTAG, 12. AUGUST\nVon 15 Uhr bis Mitternacht - Große Sommertour mit TV Avantages, organisiert vom Fremdenverkehrsamt\nVon 15 bis 18 Uhr - Quiz und elektrische Gokarts\nVon 20 Uhr bis 21.30 Uhr - Konzert\nVon 21.30 bis 24.00 Uhr - DJ-Abend"
        ],
        "en": [
          "SATURDAY AUGUST 12\n3pm to midnight - Grande Tournée d?été with TV Avantages organized by the Tourist Office\n3pm to 6pm - Quizzes and electric go-karts\n8pm to 9:30pm - Concert\n9:30 pm to midnight - DJ night"
        ],
        "it": [
          "SABATO 12 AGOSTO\nDalle 15.00 alle 24.00 - Grande Tournée d'été con TV Avantages, organizzata dall'Ufficio del Turismo\nDalle 15.00 alle 18.00 - Quiz e go-kart elettrici\nDalle 20.00 alle 21.30 - Concerto\nDalle 21.30 a mezzanotte - Serata DJ"
        ],
        "fr": [
          "SAMEDI 12 AOÛT\nDe 15h à minuit - Grande Tournée d’été avec TV Avantages organisée par l’Office de Tourisme\nDe 15h à 18h - Animations Quizz et karting électrique\nDe 20h à 21h30 - Concert\nDe 21h30 à minuit - Soirée DJ"
        ],
        "nl": [
          "ZATERDAG 12 AUGUSTUS\n15u tot middernacht - Grande Tournée d'été met TV Avantages georganiseerd door het Office du Tourisme\nVan 15.00 tot 18.00 uur - Quizzen en elektrische skelters\n20.00 tot 21.30 uur - Concert\n21.30 tot middernacht - DJ-avond"
        ],
        "es": [
          "SÁBADO 12 DE AGOSTO\nDe 15:00 a 24:00 h - Gran Torneo de verano con TV Avantages organizado por la Oficina de Turismo\nDe 15.00 a 18.00 h - Concursos y karts eléctricos\nDe 20.00 h. a 21.30 h. - Concierto\nDe 21.30 h. a 24.00 h. - Noche de DJ"
        ]
      },
