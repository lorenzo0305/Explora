  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/96f6755d-dff1-382e-870f-5b766ec73415",
      "dc:description": {
        "de": [
          "Genießen Sie während der Happy Hour Bier mit leckeren Brettern oder hausgemachte Burger, Flammkuchen oder Tagesgerichte für Ihr Mittag- oder Abendessen.\nGesellige Atmosphäre garantiert!"
        ],
        "en": [
          "Come and enjoy happy hour beers accompanied by tasty boards, or home-made burgers, tarts flambées or daily specials for lunch or dinner.\nA friendly atmosphere guaranteed!"
        ],
        "it": [
          "Venite a gustare le nostre birre per l'happy hour accompagnate da gustosi taglieri o hamburger fatti in casa, crostate flambées o specialità del giorno per pranzo o cena.\nUn'atmosfera amichevole garantita!"
        ],
        "fr": [
          "Venez savourer lors de l'happy hour des bières accompagnées de planches savoureuses ou des burgers maison, tartes flambées ou plat du jour pour votre déjeuner ou votre dîner.\nAmbiance conviviale garantie !"
        ],
        "es": [
          "Venga a disfrutar de las cervezas de la hora feliz acompañadas de sabrosas tablas o hamburguesas caseras, tartas flambeadas o platos del día para el almuerzo o la cena.\n¡Un ambiente agradable garantizado!"
        ],
        "nl": [
          "Kom genieten van happy hour-biertjes vergezeld van smakelijke plankjes of huisgemaakte hamburgers, flammkuchen of dagschotels voor lunch of diner.\nEen gezellige sfeer gegarandeerd!"
        ]
      },
      "@type": [
        "Description"
