      "dc:description": {
        "de": [
          "Der deutsche Soldatenfriedhof Selvigny ist ein deutscher Soldatenfriedhof aus dem Ersten Weltkrieg in Walincourt-Selvigny im Département Nord in der Region Hauts-de-France.\nwww.cwgc.org/"
        ],
        "en": [
          "Selvigny German Military Cemetery is a First World War German military cemetery located in Walincourt-Selvigny, in the Nord department of Hauts-de-France.\nwww.cwgc.org/"
        ],
        "it": [
          "Il cimitero militare tedesco di Selvigny è un cimitero militare tedesco della Prima Guerra Mondiale situato a Walincourt-Selvigny, nel dipartimento Nord di Hauts-de-France.\nwww.cwgc.org/"
        ],
        "fr": [
          "Le cimetière militaire allemand de Selvigny est un cimetière militaire allemand de la Première Guerre mondiale situé à Walincourt-Selvigny, dans le département du Nord, dans les Hauts-de-France.\nwww.cwgc.org/"
        ],
        "nl": [
          "Selvigny German Military Cemetery is een Duitse militaire begraafplaats uit de Eerste Wereldoorlog in Walincourt-Selvigny, in het departement Nord in de Hauts-de-France.\nwww.cwgc.org/"
        ],
        "es": [
          "El Cementerio Militar Alemán de Selvigny es un cementerio militar alemán de la Primera Guerra Mundial situado en Walincourt-Selvigny, en el departamento del Norte de Hauts-de-France.\nwww.cwgc.org/"
        ]
      },
