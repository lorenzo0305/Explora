      "dc:description": {
        "de": [
          "Kultureller Spaziergang durch den Bois de Rombly. Jean Christophe Macquet, Leiter der Mediathek und Schriftsteller, hat für diesen Rundgang das Thema gewählt: \"Victor Hugo, Georges Sand und Etaples...\""
        ],
        "en": [
          "Cultural walk in the Rombly woods. Jean Christophe Macquet, head of the media library and writer, chose \"Victor Hugo, Georges Sand and Etaples...\" as the theme for this visit"
        ],
        "it": [
          "Una passeggiata culturale nei boschi di Rombly. Jean Christophe Macquet, responsabile della mediateca e scrittore, ha scelto il tema di questa visita: \"Victor Hugo, Georges Sand e Etaples...\""
        ],
        "fr": [
          "Promenade culturelle dans le bois de Rombly. Jean Christophe Macquet, responsable de la médiathèque et écrivain a choisi pour cette visite le thème : \"Victor Hugo, Georges Sand et Etaples...\""
        ],
        "es": [
          "Un paseo cultural por el bosque de Rombly. Jean Christophe Macquet, responsable de la mediateca y escritor, eligió el tema de esta visita: \"Victor Hugo, Georges Sand y Etaples...\""
        ],
        "nl": [
          "Een culturele wandeling in de bossen van Rombly. Jean Christophe Macquet, hoofd van de mediatheek en schrijver, koos het thema van dit bezoek: \"Victor Hugo, Georges Sand en Etaples...\""
        ]
      },
