      "@id": "https://data.datatourisme.fr/0b94664a-a203-3518-91e3-bf0c77af3f08",
      "dc:description": {
        "de": [
          "Sonntag, 21. Juli 2024\n\nWassersportzentrum in der Bucht der Canche.\nVon 11:30 bis 14:15 Uhr.\n\nOrganisiert von der Association Baie de Canche mit dem Cercle Nautique du Touquet-Paris-Plage und dem Club Nautique d'Etaples-sur-mer."
        ],
        "en": [
          "Sunday, July 21, 2024\n\nCenter Nautique de la Baie de Canche.\nFrom 11:30 a.m. to 2:15 p.m.\n\nOrganized by Association Baie de Canche with Cercle Nautique du Touquet-Paris-Plage and Club Nautique d'Etaples-sur-mer."
        ],
        "it": [
          "Domenica 21 luglio 2024\n\nCentro nautico della Baia di Canche.\nDalle 11.30 alle 14.15.\n\nOrganizzato dall'Associazione Baie de Canche con il Cercle Nautique du Touquet-Paris-Plage e il Club Nautique d'Etaples-sur-mer."
        ],
        "fr": [
          "Dimanche 21 juillet 2024\n\nCentre Nautique de la Baie de Canche. \nDe11h30 à 14h15.\n\nOrganisé par l'Association Baie de Canche avec le Cercle Nautique du Touquet-Paris-Plage et le Club Nautique d'Etaples-sur-mer."
        ],
        "nl": [
          "Zondag 21 juli 2024\n\nNautisch centrum van de Baie de Canche.\nVan 11.30 tot 14.15 uur.\n\nGeorganiseerd door de Association Baie de Canche met de Cercle Nautique du Touquet-Paris-Plage en de Club Nautique d'Etaples-sur-mer."
        ],
        "es": [
          "Domingo 21 de julio de 2024\n\nCentro Náutico de la Bahía de Canche.\nDe 11.30 a 14.15 h.\n\nOrganizado por la Association Baie de Canche con el Cercle Nautique du Touquet-Paris-Plage y el Club Nautique d'Etaples-sur-mer."
        ]
      },
