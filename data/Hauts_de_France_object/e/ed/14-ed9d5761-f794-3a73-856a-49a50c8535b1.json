      "@id": "https://data.datatourisme.fr/741bbe78-a5fd-3a00-b24f-eea7ca791a2c",
      "dc:description": {
        "de": [
          "Das Restaurant liegt nur wenige Schritte von der Kapelle Sainte Godeleine entfernt und bietet Ihnen eine traditionelle und raffinierte Küche, Saalvermietung und Cateringservice."
        ],
        "en": [
          "Located 2 steps from the Sainte Godeleine chapel, the restaurant offers traditional, refined cuisine, room hire and catering services."
        ],
        "it": [
          "Situato a 2 passi dalla cappella di Sainte Godeleine, il ristorante offre una cucina tradizionale e raffinata, noleggio di camere e servizi di catering."
        ],
        "fr": [
          "Situé à 2 pas de la chapelle Sainte Godeleine, le restaurant vous propose une cuisine traditionnelle et raffinée, la location de salle et service traiteur."
        ],
        "es": [
          "Situado a 2 pasos de la capilla Sainte Godeleine, el restaurante ofrece cocina tradicional y refinada, alquiler de salas y servicios de catering."
        ],
        "nl": [
          "Het restaurant ligt op 2 stappen van de Sainte Godeleine kapel en biedt een traditionele, verfijnde keuken, zaalverhuur en traiteurdienst."
        ]
      },
