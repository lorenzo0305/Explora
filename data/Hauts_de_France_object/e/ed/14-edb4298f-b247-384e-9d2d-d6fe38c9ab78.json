  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b92e5389-6e51-3734-86e3-b6af9cbafc0f",
      "dc:description": {
        "de": [
          "Start: Montreuil (Avenue des Garennes)\n17 km - 2,5 Std. -| Schwierigkeitsgrad: mittelschwer\nEine Reittour, die man wegen der Schönheit der Augen, der Aussicht auf die Zitadelle und die umliegenden Dörfer, die Umgebung der Stadtmauern und der Canche sowie die Sümpfe machen sollte.\nRundgang im Fremdenverkehrsamt erhältlich."
        ],
        "en": [
          "Start: Montreuil (Avenue des Garennes)\n17km - 2h30 -| Difficulty: medium\nA horse-riding tour to be enjoyed for the beauty of the eyes, the views of the Citadel and surrounding villages, the surroundings of the ramparts and the Canche, and the marshes.\nAvailable from the Tourist Office."
        ],
        "it": [
          "Partenza: Montreuil (Avenue des Garennes)\n17 km - 2h30 -| Difficoltà: moderata\nUna passeggiata a cavallo da apprezzare per la bellezza dei panorami sulla Cittadella e i villaggi circostanti, i dintorni dei bastioni e della Canche e le paludi.\nItinerario disponibile presso l'Ufficio del Turismo."
        ],
        "fr": [
          "Départ : Montreuil (Avenue des Garennes)\n17km - 2h30 -| Difficulté : moyenne\nUne randonnée équestre à faire pour la beauté des yeux, les vues sur la Citadelle et les villages environnants, les alentours des remparts et de la Canche, les marais. \nCircuit disponible à l'Office de Tourisme."
        ],
        "nl": [
          "Start: Montreuil (Avenue des Garennes)\n17 km - 2u30 - Moeilijkheidsgraad: matig\nEen ruiterwandeling om te genieten van het prachtige uitzicht over de Citadel en de omliggende dorpen, de omgeving van de vestingmuren en de Canche, en de moerassen.\nRoute verkrijgbaar bij het toeristenbureau."
        ],
        "es": [
          "Salida: Montreuil (Avenue des Garennes)\n17km - 2h30 -| Dificultad: moderada\nUn paseo ecuestre para disfrutar de la belleza de las vistas sobre la Ciudadela y los pueblos de los alrededores, los alrededores de las murallas y la Canche, y las marismas.\nItinerario disponible en la Oficina de Turismo."
        ]
      },
