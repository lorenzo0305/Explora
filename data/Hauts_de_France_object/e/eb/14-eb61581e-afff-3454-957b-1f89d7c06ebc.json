      "dc:description": {
        "de": [
          "Pferdezucht, -pension und -rekonvaleszenz in einer grünen Umgebung. Freie Besichtigung für Einzelpersonen und Führungen für Schulklassen auf Anfrage."
        ],
        "en": [
          "Breeding, boarding and convalescence of horses in a green setting. Self-guided tours for individuals and guided tours for schools on request."
        ],
        "it": [
          "Allevamento, pensione e convalescenza di cavalli in un ambiente verde. Visite autogestite per singoli e visite guidate per le scuole su richiesta."
        ],
        "fr": [
          "Elevage, pension et convalescence de chevaux dans un cadre verdoyant. Visite libre pour les individuels et Visite guidée pour les scolaires sur demande."
        ],
        "nl": [
          "Fokkerij, pensionstalling en herstel van paarden in een groene omgeving. Rondleidingen voor individuen en rondleidingen voor scholen op aanvraag."
        ],
        "es": [
          "Cría, pupilaje y convalecencia de caballos en un entorno verde. Visitas autoguiadas para particulares y visitas guiadas para colegios previa solicitud."
        ]
      },
