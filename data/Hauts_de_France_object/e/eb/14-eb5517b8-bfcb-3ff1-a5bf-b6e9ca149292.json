      "dc:description": {
        "de": [
          "Die städtische Bibiothek in Wailly-Beaucamp ist mittwochs von 15:00 bis 17:00 Uhr und samstags von 10:00 bis 12:00 Uhr geöffnet.\n\nÖffnungszeiten nicht bekannt gegeben."
        ],
        "en": [
          "Wailly-Beaucamp municipal library open Wednesdays from 3:00 pm to 5:00 pm and Saturdays from 10:00 am to 12:00 pm.\n\nOpening hours not communicated."
        ],
        "it": [
          "La biblioteca comunale di Wailly-Beaucamp è aperta il mercoledì dalle 15.00 alle 17.00 e il sabato dalle 10.00 alle 12.00.\n\nGli orari di apertura non sono indicati."
        ],
        "fr": [
          "Bibiothèque municipale de Wailly-Beaucamp ouverte le mercredi de 15h00 à 17h00 et le samedi de 10h00 à 12h00.\n\nHoraires non communiqués."
        ],
        "es": [
          "La biblioteca municipal de Wailly-Beaucamp abre los miércoles de 15.00 a 17.00 horas y los sábados de 10.00 a 12.00 horas.\n\nNo se indican los horarios de apertura."
        ],
        "nl": [
          "De gemeentelijke bibliotheek van Wailly-Beaucamp is geopend op woensdag van 15.00 tot 17.00 uur en op zaterdag van 10.00 tot 12.00 uur.\n\nEr worden geen openingstijden gegeven."
        ]
      },
