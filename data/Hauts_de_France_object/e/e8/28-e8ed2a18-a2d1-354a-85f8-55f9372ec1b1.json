  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2bf7f1d5-38d2-3cb1-adf6-2c36af35f1f0",
      "dc:description": {
        "de": [
          "Das Kino befindet sich in den Räumlichkeiten des Kulturzentrums und hat eine Kapazität von 480 Plätzen, die in zwei Säle aufgeteilt sind.\nEs wurde gerade digitalisiert und ist für 3D zugänglich.\nProgramm auf der Website verfügbar"
        ],
        "en": [
          "Located in the premises of the Cultural Center, the cinema has a capacity of 480 seats shared in two rooms.\nIt has just been digitized and is accessible in 3D.\nProgram available on the website"
        ],
        "it": [
          "Situato nel Centro Culturale, il cinema ha una capacità di 480 posti a sedere suddivisi in due sale.\nÈ stato appena digitalizzato ed è accessibile in 3D.\nProgramma disponibile sul sito web"
        ],
        "fr": [
          "Situé dans les locaux du Centre Culturel, le cinéma a une capacité de 480 places partagées en deux salles.\nIl vient d'être numérisé et est accessible à la 3D.\nProgrammation disponible sur le site internet"
        ],
        "es": [
          "Situado en el Centro Cultural, el cine tiene una capacidad de 480 asientos divididos en dos salas.\nSe acaba de digitalizar y es accesible en 3D.\nPrograma disponible en el sitio web"
        ],
        "nl": [
          "De bioscoop bevindt zich in het Cultureel Centrum en heeft een capaciteit van 480 zitplaatsen, verdeeld over twee zalen.\nHet is zojuist gedigitaliseerd en toegankelijk in 3D.\nProgramma beschikbaar op de website"
        ]
      },
