  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05c263d7-6b58-32b0-8460-ae019a3034fc",
      "dc:description": {
        "de": [
          "Nehmen Sie mit Ihrer Familie an unserem Workshop-Besuch im Herzen der Gedenkstätte 14-18 teil: Entdecken Sie das Art déco anhand der Mosaiken in der Basilika Notre Dame de Lorette und im Laternenturm. Nach einer sorgfältigen Beobachtung werden die Kinder im Atelier des Geschichtszentrums in die Kunst des Mosaiklegens eingeführt."
        ],
        "en": [
          "Take part with your family in our visit-workshop in the heart of the Memorial 14-18: discover the Art Deco through the mosaics of the Basilica of Notre Dame de Lorette and the lantern tower. After a meticulous observation, the children will be introduced to mosaics in the workshop of the History Center."
        ],
        "it": [
          "Concedete a tutta la famiglia una visita laboratoriale nel cuore del Memoriale 14-18: scoprite l'Art Déco attraverso i mosaici della Basilica di Notre Dame de Lorette e della Torre delle Lanterne. Dopo un'attenta osservazione, i bambini saranno introdotti ai mosaici nel laboratorio del Centro di Storia."
        ],
        "fr": [
          "Participez en famille à notre visite-atelier au cœur du Mémorial 14-18 : découvrez l’Art déco à travers les mosaïques de la Basilique Notre Dame de Lorette et de la tour-lanterne. Après une observation minutieuse, les enfants s’initient à la mosaïque, dans l’atelier du Centre d’histoire."
        ],
        "nl": [
          "Neem het hele gezin mee op een workshop in het hart van het 14-18 Memorial: ontdek Art Deco via de mozaïeken van de Basiliek Notre Dame de Lorette en de Lantaarntoren. Na een zorgvuldige observatie zullen de kinderen kennismaken met mozaïeken in het atelier van het Geschiedeniscentrum."
        ],
        "es": [
          "Lleve a toda la familia a una visita taller al corazón del Memorial 14-18: descubra el Art Déco a través de los mosaicos de la basílica de Notre Dame de Lorette y de la Torre de los Faroles. Tras una atenta observación, los niños se iniciarán en los mosaicos en el taller del Centro de Historia."
        ]
      },
