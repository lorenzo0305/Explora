  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3c9acbf3-29ed-3623-bb5c-6ffa19596ac1",
      "dc:description": {
        "de": [
          "Weihnachtsmarkt im Festsaal von Zoteux, der von den Lehrerinnen und Eltern organisiert wird\nVerkauf von Weihnachtsartikeln und Hyazinthen\nBesuch des Weihnachtsmanns\nKleine Speisen"
        ],
        "en": [
          "Christmas market organized by teachers and parents at the Zoteux village hall\nSales of Christmas items and hyacinths\nVisit from Santa Claus\nLight refreshments"
        ],
        "it": [
          "Mercatino di Natale nella sala del villaggio di Zoteux organizzato da insegnanti e genitori\nVendita di articoli natalizi e giacinti\nVisita di Babbo Natale\nRinfresco leggero"
        ],
        "fr": [
          "Marché de Noël à la salle des fêtes de Zoteux organisé par les enseignantes et les parents d'élèves \nVentes d'objets de Noël et de jacinthes \nVisite du Père Noël \nPetite restauration"
        ],
        "es": [
          "Mercadillo de Navidad en el ayuntamiento de Zoteux organizado por profesores y padres\nVenta de artículos navideños y jacintos\nVisita de Papá Noel\nRefrescos ligeros"
        ],
        "nl": [
          "Kerstmarkt in het dorpshuis van Zoteux, georganiseerd door leerkrachten en ouders\nVerkoop van kerstartikelen en hyacinten\nBezoek van de kerstman\nLichte versnaperingen"
        ]
      },
