  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c3694883-6cdf-3a97-8a42-67a041da5ce5",
      "dc:description": {
        "de": [
          "Stretching von 11:00 bis 12:00 Uhr.\nAb 16 Jahren mit elterlicher Erlaubnis.\nTreffpunkt: an der Strandhütte,\nvergessen Sie nicht Ihr Handtuch oder Ihre Matte und Wasser."
        ],
        "en": [
          "Stretching from 11am to 12pm.\nAges 16 and over with parental consent.\nMeet at the beach chalet,\ndon't forget your towel or mat and water."
        ],
        "it": [
          "Dalle 11.00 alle 12.00.\nA partire da 16 anni con autorizzazione dei genitori.\nRitrovo presso lo chalet della spiaggia,\nnon dimenticate l'asciugamano o il tappetino e l'acqua."
        ],
        "fr": [
          "Stretching de 11h à 12h. \nA partir de 16 ans avec autorisation parentale. \nRendez-vous au chalet de plage, \nn'oubliez pas votre serviette ou votre tapis et de l'eau."
        ],
        "nl": [
          "Van 11.00 tot 12.00 uur.\nVanaf 16 jaar met toestemming van de ouders.\nVerzamelen bij het strandchalet,\nvergeet je handdoek of matje en water niet."
        ],
        "es": [
          "De 11h a 12h.\nA partir de 16 años con autorización paterna.\nEncuentro en el chalet de la playa,\nno olvides tu toalla o esterilla y agua."
        ]
      },
