  "rdfs:comment": {
    "de": [
      "Entspannen Sie sich in Begleitung von Emma oder Jonathan bei einem kleinen Spaziergang am Wasser.\nKOSTENLOS - Kinder in Begleitung eines Erwachsenen - Barfuß oder mit Wasserschuhen.\nRDV Strand Anima'Pôle"
    ],
    "en": [
      "Come and relax with Emma or Jonathan for a short walk along the water's edge.\nFREE - Children accompanied by an adult - Barefoot or with water shoes.\nRDV Anima'Pôle Beach"
    ],
    "it": [
      "Venite a rilassarvi con Emma o Jonathan per una breve passeggiata in riva al mare.\nGRATUITO - Bambini accompagnati da un adulto - A piedi nudi o con scarpe da acqua.\nSpiaggia RDV Anima'Pôle"
    ],
    "fr": [
      "Venez vous détendre en compagnie d'Emma ou de Jonathan  le temps d'une petite marche au bord de l'eau.\nGRATUIT - Enfant accompagné d'un adulte - A pied nus ou avec chaussure d'eau.\nRDV Plage Anima'Pôle"
    ],
    "es": [
      "Ven a relajarte con Emma o Jonathan dando un corto paseo junto al agua.\nGRATIS - Niños acompañados de un adulto - Descalzos o con zapatos de agua.\nRDV Anima'Pôle Playa"
    ],
    "nl": [
      "Kom ontspannen met Emma of Jonathan voor een korte wandeling langs het water.\nGRATIS - Kinderen onder begeleiding van een volwassene - Blootsvoets of met waterschoenen.\nRDV Strand Anima'Pôle"
    ]
  },
  "rdfs:label": {
