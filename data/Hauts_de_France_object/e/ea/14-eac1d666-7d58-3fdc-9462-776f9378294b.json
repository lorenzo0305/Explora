  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2ef2ad37-b894-3077-ae0d-5a0dc891ecbe",
      "dc:description": {
        "de": [
          "Um das Kanu- und Kajakfahren zu erlernen.\nUm einen Moment außerhalb der Zeit zu erleben und die Gegend aus einem anderen Blickwinkel zu entdecken... oder, wenn Sie es sportlich mögen, erleben Sie die Souchez im Kanu."
        ],
        "en": [
          "An introduction to canoeing and kayaking.\nTo experience a moment out of time and discover the area from a different angle... or for sports enthusiasts, experience the Souchez River in a canoe."
        ],
        "it": [
          "Per un'introduzione alla canoa e al kayak.\nPer un momento fuori dal tempo e per scoprire il territorio da una prospettiva diversa... o per gli amanti dello sport, vivere il Souchez in canoa."
        ],
        "fr": [
          "Pour s'initier au canoë kayak.\nPour vivre un moment un peu hors du temps et découvrir le territoire sous un autre angle... ou alors pour les amateurs de sport, faîtes l'expérience de la Souchez en canoë."
        ],
        "nl": [
          "Voor een kennismaking met kanoën en kajakken.\nVoor een moment buiten de tijd en om het gebied vanuit een andere hoek te ontdekken... of voor sportievelingen, ervaar de Souchez in een kano."
        ],
        "es": [
          "Para iniciarse en el piragüismo y el kayak.\nPara un momento fuera del tiempo y descubrir la zona desde otro ángulo... o para los amantes del deporte, vivir la Souchez en canoa."
        ]
      },
