      "dc:description": {
        "de": [
          "Ein Familienraid, 2 Wettkampfstrecken (10 km) und Familienstrecken (5 km), Laufen oder Walken und 5 Aktivitäten sowie ein Sportdorf von 10 bis 16 Uhr mit mehr als 20 Aktivitäten."
        ],
        "en": [
          "A family raid, 2 competition courses (10 km) and a family course (5 km), running or walking and 5 activities, plus a sports village from 10am to 4pm with over 20 activities."
        ],
        "it": [
          "Un raid per famiglie, 2 percorsi di gara (10 km) e un percorso per famiglie (5 km), corsa o camminata e 5 attività, oltre a un villaggio sportivo dalle 10 alle 16 con oltre 20 attività."
        ],
        "fr": [
          "Un raid familial, 2 parcours compétition (10 km) et famille (5 km), course ou marche et 5 activités ainsi qu'un village sportif de 10h à 16h avec plus de 20 activités."
        ],
        "es": [
          "Un raid familiar, 2 recorridos de competición (10 km) y un recorrido familiar (5 km), corriendo o andando y 5 actividades, así como un village deportivo de 10 a 16 h con más de 20 actividades."
        ],
        "nl": [
          "Een inval voor het hele gezin, 2 wedstrijdparcoursen (10 km) en een familieparcours (5 km), hardlopen of wandelen en 5 activiteiten, evenals een sportdorp van 10.00 tot 16.00 uur met meer dan 20 activiteiten."
        ]
      },
