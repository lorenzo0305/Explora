  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0ab2dca5-35c1-3e57-9684-13e7f170b471",
      "dc:description": {
        "de": [
          "Weinbar und Weinkeller für alle Getränke auf dem großen Platz von Cassel, Cosy und Cocooning Ort, der vor Ort oder zum Mitnehmen eine ganze Reihe von Vins de Propriétaire für Privat- oder Geschäftskunden anbietet."
        ],
        "en": [
          "Cosy, cocooning wine bar and all-beverage cellar on Cassel's main square, offering a full range of proprietary wines for private and professional customers, either on the premises or to take away."
        ],
        "it": [
          "Enoteca e cantina per tutti i tipi di bevande nella piazza principale di Cassel, un locale accogliente che offre un'intera gamma di vini di proprietà per privati o professionisti, in loco o da asporto."
        ],
        "fr": [
          "Bar à vin et Cave toutes boissons sur la grande place de Cassel, endroit Cosy et cocooning proposant sur place ou à emporter toute une gamme de Vins de Propriétaire pour les particuliers ou les professionnels."
        ],
        "nl": [
          "Wijnbar en wijnkelder op het hoofdplein van Cassel, een gezellige, knusse plek met een heel assortiment eigen wijnen voor particulieren of professionals, ter plaatse of om mee te nemen."
        ],
        "es": [
          "Vinoteca y bodega de copas en la plaza de Cassel, un lugar acogedor que ofrece toda una gama de Vinos de Autor para particulares y profesionales, en el mismo local o para llevar."
        ]
      },
