      "dc:description": {
        "de": [
          "Frische und abwechslungsreiche Gerichte, eine saisonal wechselnde Speisekarte, eine gemütliche Atmosphäre, eine Terrasse für die schönen Tage und Darts, um sich jeden Tag zu amüsieren"
        ],
        "en": [
          "Fresh, varied dishes, a menu that changes with the seasons, a cosy atmosphere, a terrace for sunny days and darts for daily fun"
        ],
        "it": [
          "Piatti freschi e variegati, un menu che cambia con le stagioni, un'atmosfera accogliente, una terrazza per le giornate di sole e freccette per il divertimento quotidiano"
        ],
        "fr": [
          "Des plats frais et variés, une carte qui se renouvelle au fil des saisons, une ambiance cosy, une terrasse pour les beaux jours et des fléchettes pour s’amuser tous les jours"
        ],
        "nl": [
          "Verse, gevarieerde gerechten, een menu dat met de seizoenen mee verandert, een gezellige sfeer, een terras voor zonnige dagen en darts voor dagelijks plezier"
        ],
        "es": [
          "Platos frescos y variados, una carta que cambia con las estaciones, un ambiente acogedor, una terraza para los días soleados y dardos para divertirse a diario"
        ]
      },
