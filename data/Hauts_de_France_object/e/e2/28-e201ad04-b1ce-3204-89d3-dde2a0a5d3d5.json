  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05921a7f-9084-305e-8428-35c0c77a7858",
      "dc:description": {
        "de": [
          "Louis Deprez, Industrieller und Bürgermeister von Marquette, beschließt 1874, sich ein Schloss bauen zu lassen. Während des Ersten Weltkriegs beherbergt das Gebäude ein Militärhospital. Im Jahr 1930 kaufte der Bürgermeister das Schloss, um dort sein Rathaus einzurichten."
        ],
        "en": [
          "Louis Deprez, industrialist and mayor of Marquette, decided to build a château in 1874. During the First World War, the building was used as a military hospital. In 1930, the mayor bought the château to house the town hall."
        ],
        "it": [
          "Louis Deprez, industriale e sindaco di Marquette, decise di farsi costruire un castello nel 1874. Durante la Prima Guerra Mondiale, l'edificio fu utilizzato come ospedale militare. Nel 1930, il sindaco acquistò il castello per ospitare il municipio."
        ],
        "fr": [
          "Louis Deprez, industriel et maire de Marquette,  décide de se faire construire un château en 1874. Durant la Première Guerre mondiale, le bâtiment accueille un hôpital militaire. En 1930, le maire rachète le château pour y installer sa mairie."
        ],
        "es": [
          "Louis Deprez, industrial y alcalde de Marquette, decidió construirse un castillo en 1874. Durante la Primera Guerra Mundial, el edificio se utilizó como hospital militar. En 1930, el alcalde compró el castillo para albergar el ayuntamiento."
        ],
        "nl": [
          "Louis Deprez, een industrieel en burgemeester van Marquette, besloot in 1874 een kasteel voor zichzelf te laten bouwen. Tijdens de Eerste Wereldoorlog werd het gebouw gebruikt als militair hospitaal. In 1930 kocht de burgemeester het kasteel om er het gemeentehuis in onder te brengen."
        ]
      },
      "@type": [
        "Description"
