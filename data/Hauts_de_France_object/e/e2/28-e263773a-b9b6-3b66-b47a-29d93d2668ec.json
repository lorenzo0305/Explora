  "rdfs:comment": {
    "de": [
      "Die Saurisserie Jannin in Grand Fort Philippe führt eine jahrhundertealte Tradition fort: das handwerkliche Räuchern von Fisch. Nach einer Vorstellung seiner Werkstatt bietet Ihnen der Besitzer eine Verkostung seiner Produkte an. Entdecken Sie den wahren Geschmack von geräuchertem Fisch!"
    ],
    "en": [
      "La saurisserie Jannin in Grand Fort Philippe perpetuates an age-old tradition: artisanal fish smoking. After a presentation of his workshop, the owner will offer you a tasting of his products. Rediscover the true taste of smoked fish!"
    ],
    "it": [
      "La Saurisserie Jannin di Grand Fort Philippe porta avanti una tradizione secolare: l'affumicatura tradizionale del pesce. Dopo una presentazione del suo laboratorio, il proprietario vi offrirà una degustazione dei suoi prodotti. Riscoprite il vero gusto del pesce affumicato!"
    ],
    "fr": [
      "La saurisserie Jannin à Grand Fort Philippe perpétue une tradition séculaire : le fumage artisanal de poisson. Après une présentation de son atelier, le propriétaire vous proposera une dégustation de ses produits. Retrouvez le vrai goût du poisson fumé !"
    ],
    "es": [
      "La Saurisserie Jannin, en Grand Fort Philippe, perpetúa una tradición milenaria: el ahumado tradicional del pescado. Tras una presentación de su taller, el propietario le ofrecerá una degustación de sus productos. ¡Redescubra el auténtico sabor del pescado ahumado!"
    ],
    "nl": [
      "De Jannin Saurisserie in Grand Fort Philippe zet een eeuwenoude traditie voort: het ambachtelijk roken van vis. Na een presentatie van zijn atelier zal de eigenaar je zijn producten laten proeven. Herontdek de echte smaak van gerookte vis!"
    ]
  },
