      "dc:description": {
        "de": [
          "Große Eiersuche\nKomm mit deinem Korb!\nSonntag 05. April 2026 Espace Malraux von 10.00 bis 12.00 Uhr - Einschreibungen unter 03 21 99 94 94\nMontag 06. April 2026 Kindergarten von 10:00 bis 12:00 Uhr - Einschreibungen unter 03 21 83 51 02\nKostenlos (ab 02 Jahren)\nAchtung begrenzte Plätze, Anmeldungen erforderlich"
        ],
        "en": [
          "Big egg hunts\nBring your basket!\nSunday 05 April 2026 Espace Malraux from 10.00 am to 12.00 pm - Registration on 03 21 99 94 94\nMonday 06 April 2026 - Jardin des enfants from 10:00 am to 12:00 pm - Registration on 03 21 83 51 02\nFree (from 02 years old)\nPlaces are limited, please register"
        ],
        "it": [
          "Caccia alle uova grandi\nPortate il vostro cestino!\nDomenica 05 aprile 2026 Espace Malraux dalle 10.00 alle 12.00 - Iscrizioni allo 03 21 99 94 94\nLunedì 06 aprile 2026 - Jardin des enfants dalle 10.00 alle 12.00 - Iscrizioni allo 03 21 83 51 02\nGratuito (a partire da 02 anni)\nI posti sono limitati, è necessaria l'iscrizione"
        ],
        "fr": [
          "Grandes chasses aux oeufs \nViens avec ton panier !\nDimanche 05 Avril  2026 Espace Malraux de 10h00 à 12h00  -   Inscriptions au 03 21 99 94 94 \nLundi 06 Avril 2026  - Jardin des enfants de 10h00 à 12h00 -  Inscriptions au 03 21 83 51 02\nGratuit (à partir de 02 ans)\nAttention places limitées, inscriptions obligatoires"
        ],
        "nl": [
          "Grote eierzoektochten\nBreng je mand mee!\nZondag 05 april 2026 Espace Malraux van 10u tot 12u - Inschrijving op 03 21 99 94 94\nMaandag 06 april 2026 - Jardin des enfants van 10u tot 12u - Inschrijving op 03 21 83 51 02\nGratis (vanaf 02 jaar)\nPlaatsen zijn beperkt, inschrijving verplicht"
        ],
        "es": [
          "Gran caza del huevo\n¡Trae tu cesta!\nDomingo 05 abril 2026 Espace Malraux de 10h a 12h - Inscripción al 03 21 99 94 94\nLunes 06 abril 2026 - Jardin des enfants de 10h a 12h - Inscripción al 03 21 83 51 02\nGratuito (a partir de 02 años)\nPlazas limitadas, inscripción obligatoria"
        ]
      },
