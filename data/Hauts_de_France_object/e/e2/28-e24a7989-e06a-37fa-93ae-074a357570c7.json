  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6c24c9e8-1405-3830-a19b-c475245edbc9",
      "dc:description": {
        "de": [
          "Eine Brasserie, in der nur frische Produkte verarbeitet werden, mit hausgemachter Küche und lokalen Produkten. Die Speisekarte variiert und entwickelt sich je nach Jahreszeit!"
        ],
        "en": [
          "A brasserie where only the freshest produce is used, with homemade cooking and local produce, the menu changing and evolving with the seasons!"
        ],
        "it": [
          "Una brasserie in cui vengono utilizzati solo prodotti freschissimi, con cucina casalinga e prodotti locali, e un menu che cambia con le stagioni!"
        ],
        "fr": [
          "Une brasserie où l'on ne travaille que des produits frais avec une cuisine faite maison et des produits locaux, la carte variant et évoluant en fonction des saisons !"
        ],
        "es": [
          "Una brasserie en la que sólo se utilizan los productos más frescos, con cocina casera y productos locales, ¡y una carta que cambia con las estaciones!"
        ],
        "nl": [
          "Een brasserie waar alleen de meest verse producten worden gebruikt, met huisgemaakte gerechten en lokale producten, en een menu dat met de seizoenen mee verandert!"
        ]
      },
