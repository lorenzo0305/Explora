      "dc:description": {
        "de": [
          "Platz für Spiele\n\nTesten Sie sich, amüsieren Sie sich, fordern Sie sich bei Gesellschaftsspielen heraus, warum nicht mit der ganzen Familie!\n\nAuf Anmeldung"
        ],
        "en": [
          "Place aux jeux\n\nCome and test your skills, have fun and challenge yourselves with board games - and why not with the whole family!\n\nRegistration required"
        ],
        "it": [
          "Piazza dei giochi\n\nVenite a mettere alla prova le vostre abilità, a divertirvi e a sfidarvi con i giochi da tavolo e, perché no, a portare tutta la famiglia!\n\nRegistrazione obbligatoria"
        ],
        "fr": [
          "Place aux jeux\n\nVenez vous tester, vous amuser, vous challenger autour de jeux de société, pourquoi pas en famille !\n\nSur inscription"
        ],
        "nl": [
          "Speelplein\n\nKom en test je vaardigheden, maak plezier en daag jezelf uit met bordspellen, en waarom niet het hele gezin meenemen!\n\nRegistratie verplicht"
        ],
        "es": [
          "Plaza de juegos\n\nVenga a poner a prueba sus habilidades, a divertirse y a desafiarse con los juegos de mesa, ¡y por qué no traer a toda la familia!\n\nInscripción obligatoria"
        ]
      },
