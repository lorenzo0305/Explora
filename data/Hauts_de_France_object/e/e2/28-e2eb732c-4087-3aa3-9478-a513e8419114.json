      "dc:description": {
        "de": [
          "Auf dem Friedhof gibt es ein Denkmal für 19 britische Soldaten, zwei chinesische Wissenschaftler und britische sowie neuseeländische Gräber."
        ],
        "en": [
          "The cemetery features a memorial to 19 British soldiers, two Chinese scientists and graves of British and New Zealand soldiers."
        ],
        "it": [
          "Il cimitero comprende un monumento commemorativo per 19 soldati britannici, due scienziati cinesi e tombe di soldati britannici e neozelandesi."
        ],
        "fr": [
          "Au sein de ce cimetière nous pouvons retrouver un mémorial rendant hommage à 19 soldats britanniques, deux scientifiques chinois et  des tombes britanniques ainsi que néo-zélandaises."
        ],
        "es": [
          "El cementerio incluye un monumento en memoria de 19 soldados británicos, dos científicos chinos y tumbas de soldados británicos y neozelandeses."
        ],
        "nl": [
          "De begraafplaats bevat een gedenkteken voor 19 Britse soldaten, twee Chinese wetenschappers en graven van Britse en Nieuw-Zeelandse soldaten."
        ]
      },
