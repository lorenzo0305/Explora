  "rdfs:comment": {
    "de": [
      "Der Garten der Abteikirche liegt in der Nähe der Abteikirche Saint-Nicolas im Herzen der Stadt. Er bietet einen schönen Blick auf das Gebäude und ein Panorama der Stadt, die sich zu seinen Füßen erstreckt."
    ],
    "en": [
      "Located near the Saint-Nicolas Abbey, in the heart of the city, the garden of the Abbey offers a beautiful view of the building and a panorama of the city that stretches out at its foot."
    ],
    "it": [
      "Situato vicino alla chiesa abbaziale di San Nicola, nel cuore della città, il Giardino dell'Abbazia offre una splendida vista sull'edificio e un panorama della città sottostante."
    ],
    "fr": [
      "Situé à proximité de l’Abbatiale Saint-Nicolas, en plein cœur de la ville, le jardin de l’Abbatiale offre une jolie vue sur l’édifice et un panorama sur la ville qui s'étend au pied."
    ],
    "es": [
      "Situado cerca de la iglesia abacial de San Nicolás, en el corazón de la ciudad, el Jardín de la Abadía ofrece una hermosa vista del edificio y una panorámica de la ciudad."
    ],
    "nl": [
      "De Abdijtuin ligt bij de abdijkerk van St. Nicolaas, in het hart van de stad."
    ]
  },
  "rdfs:label": {
    "fr": [
