  "rdfs:comment": {
    "de": [
      "Die Kirche von Ablain Saint-Nazaire und die Abtei von Mont-Saint-Eloi wurden größtenteils zerstört und zeugen von der Intensität der Kämpfe zwischen 1914 und 1918."
    ],
    "en": [
      "Witness to the intensity of the fighting between 1914 and 1918, the church of Ablain Saint-Nazaire and the abbey of Mont-Saint-Eloi were largely destroyed."
    ],
    "it": [
      "A testimonianza dell'intensità dei combattimenti tra il 1914 e il 1918, la chiesa di Ablain Saint-Nazaire e l'abbazia di Mont-Saint-Eloi furono in gran parte distrutte."
    ],
    "fr": [
      "Témoins de l’intensité des combats entre 1914 et 1918, l’église d’Ablain Saint-Nazaire et l’abbaye du Mont-Saint-Eloi ont été, en grande partie, détruites."
    ],
    "es": [
      "Testigos de la intensidad de los combates entre 1914 y 1918, la iglesia de Ablain Saint-Nazaire y la abadía de Mont-Saint-Eloi fueron destruidas en gran parte."
    ],
    "nl": [
      "Getuige van de hevige gevechten tussen 1914 en 1918 werden de kerk van Ablain Saint-Nazaire en de abdij van Mont-Saint-Eloi grotendeels verwoest."
    ]
  },
  "rdfs:label": {
    "fr": [
