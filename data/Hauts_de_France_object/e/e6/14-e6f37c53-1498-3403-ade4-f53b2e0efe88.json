  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/651f1576-ef21-3f7d-b370-292828ceb9ea",
      "dc:description": {
        "de": [
          "Wanderung in Groffliers\nDauer: 3 Stunden\nRundgang im Fremdenverkehrsamt erhältlich\nEntdecken Sie ab dem kleinen Hafen von La Madelon die außergewöhnlichen Panoramen und Lichter der Baie d'Authie. Dann führt der Weg in die Dünenmassive, in den Schatten der Strandkiefern und weiter durch die niedrigen Felder, um das Dorf zu umrunden."
        ],
        "en": [
          "Hiking in Groffliers\nDuration: 3 hours\nTour available from the Tourist Office\nFrom the little port of La Madelon, discover the exceptional panoramas and light of the Baie d'Authie. The path then winds its way through the dune massifs, shaded by maritime pines, and continues through low-lying fields to skirt the village."
        ],
        "it": [
          "Passeggiata a Groffliers\nDurata: 3 ore\nItinerario disponibile presso l'Ufficio del Turismo\nPartendo dal porticciolo di La Madelon, scoprite gli eccezionali panorami e la luce della Baie d'Authie. Il sentiero si inoltra poi nelle dune, all'ombra dei pini marittimi, e prosegue attraverso i campi bassi fino a costeggiare il villaggio."
        ],
        "fr": [
          "Randonnée à Groffliers\nDurée : 3 heures\nCircuit disponible à l'Office de Tourisme \nA partir du petit port de la Madelon, découvrez les panoramas et les lumières exceptionnels de la Baie d'Authie. Puis le chemin s'en va dans les massifs dunaires, à l'ombre des pins maritimes et continue dans les bas champs pour contourner le village."
        ],
        "nl": [
          "Wandelen in Groffliers\nDuur: 3 uur\nRoute verkrijgbaar bij het toeristenbureau\nOntdek vanaf het haventje van La Madelon het uitzonderlijke panorama en het licht van de Baie d'Authie. Het pad loopt vervolgens de duinen in, in de schaduw van zeedennen, en gaat verder door laaggelegen velden om het dorp te omzeilen."
        ],
        "es": [
          "Senderismo en Groffliers\nDuración: 3 horas\nItinerario disponible en la Oficina de Turismo\nPartiendo del pequeño puerto de La Madelon, descubra los excepcionales panoramas y la luz de la bahía de Authie. A continuación, el sendero se adentra en las dunas, a la sombra de los pinos marítimos, y continúa por campos bajos para bordear el pueblo."
        ]
      },
