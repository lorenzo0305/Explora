  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/873ac439-0a91-3bf3-9d7e-d1d54e0d457d",
      "dc:description": {
        "de": [
          "Verein, der mehrere Clubs für Stadionrennen, Gymnastik, Nordic Walking, Mountainbiking, Radfahren, Schiffsmodellbau und Petanque vereint. Brocante de la Calotterie Ende April, Trail Blanc Pignon Ende Februar"
        ],
        "en": [
          "Association regrouping several clubs of races out of stage, soft gym, Nordic walking, VTT, cyclo, model ship and petanque. Brocante de la Calotterie end of April, Trail Blanc Pignon end of February"
        ],
        "it": [
          "Associazione di diversi club di corsa fuori pista, palestra, nordic walking, mountain bike, ciclismo, modellismo navale e bocce. Brocante de la Calotterie fine aprile, Trail Blanc Pignon fine febbraio"
        ],
        "fr": [
          "Association regroupant plusieurs clubs de courses hors stade, gym douce, marche nordique, VTT, cyclo, modélisé naval et pétanque. Brocante de la Calotterie fin Avril, Trail Blanc Pignon fin Février"
        ],
        "nl": [
          "Vereniging van verschillende clubs voor off-stage running, gym, nordic walking, mountainbiken, fietsen, modelscheepsbouw en petanque. Brocante de la Calotterie eind april, Trail Blanc Pignon eind februari"
        ],
        "es": [
          "Asociación de varios clubes de carrera a pie, gimnasia, marcha nórdica, bicicleta de montaña, ciclismo, aeromodelismo y petanca. Brocante de la Calotterie a finales de abril, Trail Blanc Pignon a finales de febrero"
        ]
      },
