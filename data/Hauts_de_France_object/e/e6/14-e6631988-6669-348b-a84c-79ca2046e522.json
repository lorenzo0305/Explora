      "dc:description": {
        "de": [
          "Angebote das ganze Jahr über! Mama's Pizza: Geschmack und Qualität... Für Ihren Genuss!\nPizzas und Gerichte zum Mitnehmen oder als Lieferung nach Hause."
        ],
        "en": [
          "Offers all year round! Mama's Pizza: taste and quality... For your pleasure!\nPizzas and take-out or home delivery."
        ],
        "it": [
          "Offerte tutto l'anno! Mama's Pizza: gusto e qualità? Per il vostro piacere!\nPizze e piatti da asporto o da consegnare a domicilio."
        ],
        "fr": [
          "Des offres toute l’année ! Mama’s Pizza : le goût et la qualité… Pour votre plaisir !\nPizzas et plats à emporter ou en livraison à domicile."
        ],
        "es": [
          "¡Ofertas todo el año! Mama's Pizza: ¿sabor y calidad? Para que lo disfrutes\nPizzas y platos para llevar o para entregar a domicilio."
        ],
        "nl": [
          "Aanbiedingen het hele jaar door! Mama's Pizza: smaak en kwaliteit? Voor uw plezier!\nPizza's en gerechten om mee te nemen of om thuis te laten bezorgen."
        ]
      },
