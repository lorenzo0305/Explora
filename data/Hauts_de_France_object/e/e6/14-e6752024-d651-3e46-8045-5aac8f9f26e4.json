  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d7d94f4b-38bb-3f38-97e7-cdb55e5f0294",
      "dc:description": {
        "de": [
          "L'atelier de Marie ist ein Catering-Service zum Mitnehmen und für Veranstaltungen (Essen, Hochzeiten, Geburtstage) sowie ein Feinkostladen mit regionalen Produkten.\n\nGeschlossen vom 21. August bis zum 4. September 2023"
        ],
        "en": [
          "L'atelier de Marie is a takeaway and event caterer (meals, weddings, birthdays) and a delicatessen selling regional produce.\n\nClosed from August 21 to September 4, 2023"
        ],
        "it": [
          "L'atelier de Marie è un'azienda di catering da asporto e per eventi (pasti, matrimoni, compleanni) e una gastronomia che vende prodotti regionali.\n\nChiuso dal 21 agosto al 4 settembre 2023"
        ],
        "fr": [
          "L’atelier de Marie est un traiteur à emporter et événementiel (repas, mariage, anniversaire) et une épicerie fine de produits régionaux.\n\nFermé du 21 août au 4 septembre 2023"
        ],
        "nl": [
          "L'atelier de Marie is een traiteur voor afhaalmaaltijden en evenementen (maaltijden, bruiloften, verjaardagen) en een delicatessenwinkel met regionale producten.\n\nGesloten van 21 augustus tot 4 september 2023"
        ],
        "es": [
          "L'atelier de Marie es un establecimiento de comida para llevar y catering para eventos (comidas, bodas, cumpleaños) y una charcutería que vende productos regionales.\n\nCerrado del 21 de agosto al 4 de septiembre de 2023"
        ]
      },
