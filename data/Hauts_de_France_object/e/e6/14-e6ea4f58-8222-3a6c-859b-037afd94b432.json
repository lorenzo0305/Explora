  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cff9e1c9-af9c-38c6-9b07-f5be9cd60bda",
      "dc:description": {
        "de": [
          "Erklimmen Sie einen Gipfel der Emotionen!  \nDie Bergleute hatten Herz, die Künstler erinnern Sie mit ihren Liedern daran!"
        ],
        "en": [
          "Come and climb a summit of emotions!  \nThe miners had heart, and the artists remind you of it in song!"
        ],
        "it": [
          "Venite a scalare una montagna di emozioni!  \nI minatori avevano il cuore al posto giusto e gli artisti sono lì per ricordarvelo con le loro canzoni!"
        ],
        "fr": [
          "Venez gravir un sommet d’émotions !  \nLes mineurs avaient du cœur, les artistes vous le rappellent en chansons !"
        ],
        "es": [
          "¡Venga y escale una montaña emocional!  \nLos mineros tenían el corazón en su sitio, y los artistas están ahí para recordárselo con canciones"
        ],
        "nl": [
          "Kom en beklim een emotionele berg!  \nDe mijnwerkers hadden hun hart op de juiste plaats en de artiesten zijn er om je daar in liedjes aan te herinneren!"
        ]
      },
