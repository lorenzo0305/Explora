  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/67e76a14-dcb2-3102-b751-e0289cc06f0f",
      "dc:description": {
        "de": [
          "In französischer oder picardischer Sprache nimmt Jean-Marie Sie mit auf eine Entdeckungsreise durch unsere schöne Region Picardie. Erzählter Naturspaziergang durch die Legenden und das mündliche Erbe der picardischen Pfade ..."
        ],
        "en": [
          "In French or Picardy, Jean-Marie will take you on a discovery tour of our beautiful Picardy region. A nature walk with stories about the legendary and oral heritage of the Picardy trails ..."
        ],
        "it": [
          "In francese o in piccardo, Jean-Marie vi accompagnerà alla scoperta della nostra bella regione della Piccardia. Una passeggiata nella natura con i racconti delle leggende e del patrimonio orale dei sentieri della Piccardia..."
        ],
        "fr": [
          "En langue française ou en langue picarde, Jean-Marie vous emmène à la découverte de notre belle région picarde. balade nature contée du légendaire et du patrimoine oral des sentiers picards ..."
        ],
        "nl": [
          "In het Frans of in Picardië, Jean-Marie neemt u mee op ontdekking van onze mooie regio Picardië. Een natuurwandeling met verhalen over de legenden en het mondelinge erfgoed van de Picardische paden ..."
        ],
        "es": [
          "En francés o en picardía, Jean-Marie le llevará a descubrir nuestra hermosa región de Picardía. Un paseo por la naturaleza con relatos de las leyendas y el patrimonio oral de los caminos de Picardía..."
        ]
      },
      "@type": [
        "Description"
      ],
