      "dc:description": {
        "de": [
          "Der Minigolfplatz in Wimereux ist momentan geschlossen.\nEr wird in neuem Glanz erstrahlen.\nBis bald\nVielen Dank für Ihr Verständnis"
        ],
        "en": [
          "The Wimereux mini-golf course is currently closed.\nIt will be given a facelift.\nSee you soon\nThank you for your understanding"
        ],
        "it": [
          "Il campo da minigolf di Wimereux è attualmente chiuso.\nVerrà rinnovato.\nA presto\nGrazie per la vostra comprensione"
        ],
        "fr": [
          "Le mini-golf de Wimereux est pour le moment fermé.\nIl va se refaire une beauté.\nA très vite \nMerci de votre compréhension"
        ],
        "es": [
          "El minigolf de Wimereux está cerrado.\nSe va a renovar.\nHasta pronto\nGracias por su comprensión"
        ],
