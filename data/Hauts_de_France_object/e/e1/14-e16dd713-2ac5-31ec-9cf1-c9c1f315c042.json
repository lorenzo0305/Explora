  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/482685be-f26e-3147-95d9-5617159c5cd0",
      "dc:description": {
        "de": [
          "Genießen Sie die Schnecke das ganze Jahr über auf dem Land in einem schönen Garten mit Bäumen, in dem die Schneckenparks angelegt sind.<br>*Verkauf vor Ort.<br>"
        ],
        "en": [
          "Taste the snail all year round, in the countryside, in a pretty garden planted with trees where the snail parks are installed.<br>*Sell on the spot.<br>"
        ],
        "it": [
          "Godetevi le lumache tutto l'anno, in campagna, in un grazioso giardino alberato in cui sono allestiti i parchi di lumache.<br>*Vendita in loco.<br>"
        ],
        "fr": [
          "Dégustez l'escargot toute l'année, à la campagne, dans un joli jardin arboré dans lequel sont installés les parcs d'escargots.<br>*Vente sur place.<br>"
        ],
        "nl": [
          "Geniet het hele jaar door van slakken, op het platteland, in een mooie tuin met bomen waarin de slakkenparken zijn ingericht.<br>*Verkoop ter plaatse.<br>"
        ],
        "es": [
          "Disfrute de los caracoles durante todo el año, en el campo, en un bonito jardín con árboles en el que se instalan los parques de caracoles.<br>*Venta in situ.<br>"
        ]
      },
