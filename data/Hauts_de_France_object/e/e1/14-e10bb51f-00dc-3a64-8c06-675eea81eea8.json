  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/758017c6-bc38-31f2-aa64-9e5033f66c48",
      "dc:description": {
        "de": [
          "Nach mehr als 15 Jahren Abwesenheit kehrt #LaFriteSensas nach Lens zurück! Besuchen Sie unsere Pommesbude in der 61 route de la Bassée, um die authentischen und schmackhaften Sensas-Frites zu probieren, die seit 1969 berühmt sind!"
        ],
        "en": [
          "After an absence of over 15 years, #LaFriteSensas is back in Lens! Visit our French fry shop at 61 route de la Bassée to taste the authentic and tasty Sensas Frites, renowned since 1969!"
        ],
        "it": [
          "Dopo oltre 15 anni di assenza, #LaFriteSensas torna a Lens! Visitate il nostro negozio di patatine fritte al 61 di route de la Bassée per assaggiare le autentiche e gustose Sensas Frites, rinomate dal 1969!"
        ],
        "fr": [
          "Après plus de 15 ans d’absence, #LaFriteSensas fait son retour à Lens ! Rendez-vous dans notre friterie située au 61 route de la Bassée pour déguster l’authentique et la savoureuse Frite de chez Sensas, réputée de puis 1969 !"
        ],
        "es": [
          "Tras más de 15 años de ausencia, #LaFriteSensas vuelve a Lens Visite nuestra tienda de patatas fritas en el 61 route de la Bassée para degustar las auténticas y sabrosas Sensas Frites, ¡reconocidas desde 1969!"
        ],
        "nl": [
          "Na een afwezigheid van meer dan 15 jaar is #LaFriteSensas terug in Lens! Bezoek onze friettent op 61 route de la Bassée om de authentieke en lekkere Sensas Frites te proeven, bekend sinds 1969!"
        ]
      },
