      "openingDetails": {
        "de": [
          "Einführung in die Korbflechterei :\nDie Handwerker des Coron des arts bieten Ihnen an, die Korbflechterei zu entdecken und ein Futterhäuschen für Vögel herzustellen!"
        ],
        "en": [
          "Introduction to basketry:\nThe artisans at Coron des arts invite you to discover basketry and create a bird feeder!"
        ],
        "it": [
          "Introduzione alla cesteria:\nGli artigiani di Coron des arts vi invitano a scoprire la cesteria e a creare una mangiatoia per uccelli!"
        ],
        "fr": [
          "Initiation à la vannerie :\nLes artisans du Coron des arts vous proposent de découvrir la vannerie et de créer une mangeoire pour les oiseaux !"
        ],
        "nl": [
          "Kennismaking met mandenvlechten:\nDe ambachtslieden van Coron nodigen je uit om het mandenvlechten te ontdekken en een vogelvoederhuisje te maken!"
        ],
        "es": [
          "Iniciación a la cestería:\nLos artesanos de Coron des arts le invitan a descubrir la cestería y a crear un comedero para pájaros"
        ]
