  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d9950f2b-002b-33cd-a3db-8cbd183ad73d",
      "dc:description": {
        "de": [
          "Ein authentisches, leckeres und gemütliches Restaurant.\nHier werden Sie jeden Mittag von Montag bis Freitag empfangen, um eine großzügige und schmackhafte Küche zu entdecken."
        ],
        "en": [
          "Authentic, gourmet and friendly restaurant.\nYou'll be welcomed every lunchtime, Monday to Friday, to discover a generous and tasty cuisine."
        ],
        "it": [
          "Un ristorante autentico, gourmet e accogliente.\nSarete accolti ogni ora di pranzo, dal lunedì al venerdì, per scoprire una cucina generosa e gustosa."
        ],
        "fr": [
          "Restaurant authentique, gourmand et convivial.\nVous y serez accueillis, tous les midis, du lundi au vendredi, pour y découvrir une cuisine généreuse et savoureuse."
        ],
        "es": [
          "Un restaurante auténtico, gastronómico y acogedor.\nLe recibirán cada mediodía, de lunes a viernes, para descubrir una cocina generosa y sabrosa."
        ],
        "nl": [
          "Een authentiek, gastronomisch en gezellig restaurant.\nJe wordt er elke middag verwelkomd, van maandag tot vrijdag, om een gulle en smakelijke keuken te ontdekken."
        ]
      },
