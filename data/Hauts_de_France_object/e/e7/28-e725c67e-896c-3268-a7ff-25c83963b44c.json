  "rdfs:comment": {
    "de": [
      "Das 1985 eröffnete Restaurant Aux Magots bietet eine große Auswahl an handwerklich hergestellten Pizzen aus dem Holzofen, die Sie in einer gemütlichen Atmosphäre genießen können. Entdecken Sie auch die Speisekarte mit regionalen Gerichten."
    ],
    "en": [
      "The Aux Magots restaurant, open since 1985, offers a wide choice of artisan pizzas baked over a wood fire, to be enjoyed in a warm and welcoming setting. Discover also the menu of regional dishes."
    ],
    "it": [
      "Il ristorante Aux Magots, aperto dal 1985, offre un'ampia scelta di pizze fatte in casa cotte sul fuoco a legna, da gustare in un ambiente accogliente. È inoltre possibile scegliere tra un menu di piatti regionali."
    ],
    "fr": [
      "Le restaurant Aux Magots ouvert depuis 1985 propose un large choix de pizzas artisanales cuites au feu de bois à déguster dans un cadre chaleureux. Découvrez aussi la carte des plats régionaux."
    ],
    "nl": [
      "Het restaurant Aux Magots, geopend sinds 1985, biedt een ruime keuze aan huisgemaakte pizza's bereid boven een houtvuur, om van te genieten in een gezellige omgeving. Je kunt ook kiezen uit een menu met regionale gerechten."
    ],
    "es": [
      "El restaurante Aux Magots, abierto desde 1985, ofrece una amplia selección de pizzas caseras cocinadas al fuego de leña, para degustar en un ambiente acogedor. También puede elegir entre una carta de platos regionales."
    ]
  },
