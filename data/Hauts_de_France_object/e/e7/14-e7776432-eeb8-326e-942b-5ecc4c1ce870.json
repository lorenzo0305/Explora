      "dc:description": {
        "de": [
          "Ruhiges und komfortables Hotel, 300 Meter vom Strand entfernt; 10 Minuten vom Ärmelkanaltunnel und dem Fährterminal entfernt, mit einem gemütlichen Restaurant\n\nGEÖFFNET von Januar bis Dezember"
        ],
        "en": [
          "Quiet and comfortable hotel located 300 metres from the beach; 10 minutes from the Channel Tunnel and the ferry terminal, with a pleasant restaurant\n\nOPEN from January to December"
        ],
        "it": [
          "Hotel tranquillo e confortevole situato a 300 metri dalla spiaggia; a 10 minuti dal tunnel della Manica e dal terminal dei traghetti, con un piacevole ristorante\n\nAPERTO da gennaio a dicembre"
        ],
        "fr": [
          "Hôtel calme et confortable situé à 300 mètres de la plage ; 10 minutes du tunnel sous la manche et du terminal ferry, disposant d'un restaurant agréable\n\nOUVERT de Janvier à Décembre"
        ],
        "nl": [
          "Rustig en comfortabel hotel op 300 meter van het strand; 10 minuten van de Kanaaltunnel en de veerbootterminal, met een aangenaam restaurant\n\nOPEN van januari tot december"
        ],
        "es": [
          "Hotel tranquilo y confortable situado a 300 metros de la playa; a 10 minutos del túnel del Canal de la Mancha y de la terminal del ferry, con un agradable restaurante\n\nAbierto de enero a diciembre"
        ]
      },
