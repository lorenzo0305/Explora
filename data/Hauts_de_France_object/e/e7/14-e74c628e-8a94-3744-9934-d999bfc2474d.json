  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fd3ecd0f-dccb-3539-828a-121ca2cd744e",
      "dc:description": {
        "de": [
          "In der Nähe des Audomarois und der Côte d'Opale (20 Min.) können Sie sich in unserem Estaminet eine Gourmetpause gönnen! Genießen Sie unsere regionalen Spezialitäten und unsere \"hausgemachten\" Menüs in einer herzlichen und familiären Atmosphäre."
        ],
        "en": [
          "Close to the Audomarois and the Opal Coast (20 min), treat yourself to a gourmet break in our estaminet! Come and savour our regional specialities and our \"home-made\" menus, all in a warm and family atmosphere."
        ],
        "it": [
          "Vicino all'Audomarois e alla Costa d'Opale (20 min), concedetevi una pausa golosa nel nostro estaminet! Venite a gustare le nostre specialità regionali e i nostri menu \"fatti in casa\", il tutto in un'atmosfera calda e familiare."
        ],
        "fr": [
          "Proche de l 'Audomarois et de la Côte d'Opale (20 min), offrez vous une pause gourmande dans notre estaminet ! Venez savourer nos spécialités régionales et nos menus «faits maison», le tout dans une ambiance chaleureuse et familiale."
        ],
        "nl": [
          "Dicht bij de Audomarois en de Opaalkust (20 min), biedt u zelf een gastronomische pauze aan in ons estaminet! Kom genieten van onze regionale specialiteiten en onze \"huisgemaakte\" menu's, dit alles in een warme en familiale sfeer."
        ],
        "es": [
          "Cerca del Audomarois y de la Costa de Ópalo (20 min.), ofrézcase una pausa gastronómica en nuestro estaminet Venga a disfrutar de nuestras especialidades regionales y de nuestros menús \"caseros\", todo ello en un ambiente cálido y familiar."
        ]
      },
      "@type": [
        "Description"
      ],
