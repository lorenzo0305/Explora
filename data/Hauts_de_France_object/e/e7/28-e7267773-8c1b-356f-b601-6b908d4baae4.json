  "rdfs:comment": {
    "de": [
      "Produkte vom Bauernhof, je nach Saison: Zucchini, Tomaten, Paprika, weiße und gelbe Zwiebeln, Kartoffeln, Karotten, Lauch, Kürbisse, Bohnen, Erbsen, Kräuter Erdbeeren, Himbeeren\n- andere Produkte: Linsen, Mehl, Honig, Säfte ..."
    ],
    "en": [
      "Seasonal farm products: Zucchini, tomatoes, peppers, white and yellow onions, potatoes, carrots, leeks, squash, beans, peas, aromatic herbs, strawberries, raspberries\n- other products: Lentils, flour, honey, juice ..."
    ],
    "it": [
      "Prodotti della fattoria, secondo la stagione: zucchine, pomodori, peperoni, cipolle bianche e gialle, patate, carote, porri, zucche, fagioli, piselli, erbe aromatiche, fragole, lamponi\n- altri prodotti: lenticchie, farina, miele, succhi di frutta ..."
    ],
    "fr": [
      "Produits de la ferme, suivant les saisons : Courgettes, tomates, poivrons, oignons blancs et jaunes, pommes de terre, carottes, poireaux, courges, haricots, pois, herbes aromatiques Fraises, framboises \n- autres produits : Lentilles, farine, miel, jus .."
    ],
    "es": [
      "Productos de la granja, según la temporada: Calabacines, tomates, pimientos, cebollas blancas y amarillas, patatas, zanahorias, puerros, calabazas, judías, guisantes, hierbas aromáticas, fresas, frambuesas\n- otros productos: Lentejas, harina, miel, zumo..."
    ],
    "nl": [
      "Producten van de boerderij, volgens het seizoen: Courgettes, tomaten, paprika's, witte en gele uien, aardappelen, wortelen, prei, pompoen, bonen, erwten, aromatische kruiden, aardbeien, frambozen\n- andere producten: linzen, meel, honing, sap ..."
    ]
