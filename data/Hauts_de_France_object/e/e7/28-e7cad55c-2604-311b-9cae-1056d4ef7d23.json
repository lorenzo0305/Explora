  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/35ed567f-a8e4-3187-b17f-407506b4440b",
      "dc:description": {
        "de": [
          "Das Restaurant Le Métropolitain ist eine Brasserie mit einfacher, hausgemachter Küche. Hier finden Sie gute Gerichte wie Lasagne, Rindfleischspieße oder ein Rahmschnitzel mit einem gemischten Salat oder Pommes frites! Köstliche Desserts warten geduldig darauf, Ihren Gaumen zu verwöhnen - Sie werden nicht enttäuscht sein!"
        ],
        "en": [
          "Le Métropolitain is a brasserie with simple, homemade cuisine. You'll find great dishes like lasagne, beef brochettes or a creamy escalope accompanied by a mixed salad or fries! Delicious desserts are waiting patiently to tantalize your taste buds - you won't be disappointed!"
        ],
        "it": [
          "Le Métropolitain è una brasserie con cucina semplice e casalinga. Troverete ottimi piatti come lasagne, spiedini di manzo o una scaloppina cremosa accompagnata da un'insalata mista o da patatine fritte! Deliziosi dessert attendono pazientemente di stuzzicare le vostre papille gustative: non rimarrete delusi!"
        ],
        "fr": [
          "Le restaurant Le Métropolitain est une brasserie à la cuisine simple et faite maison. Vous y trouverez de bons plats comme des lasagnes, des brochettes de bœuf ou une escalope à la crème accompagnée d'une salade composée ou de frites ! De délicieux desserts attendent patiemment de régaler vos papilles, vous ne serez pas déçus !"
        ],
        "nl": [
          "Le Métropolitain is een brasserie met eenvoudige, huisgemaakte gerechten. Je vindt er heerlijke gerechten zoals lasagne, runderkebab of een romige escalope, vergezeld van een gemengde salade of frietjes! Heerlijke desserts wachten geduldig om je smaakpapillen te prikkelen - je zult niet teleurgesteld zijn!"
        ],
        "es": [
          "Le Métropolitain es una brasserie de comida sencilla y casera. Encontrará grandes platos como lasaña, brochetas de ternera o un escalope cremoso acompañado de una ensalada mixta o patatas fritas Los deliciosos postres esperan pacientemente para deleitar su paladar, ¡no le decepcionarán!"
        ]
      },
      "@type": [
        "Description"
      ],
