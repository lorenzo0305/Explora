      "dc:description": {
        "de": [
          "Versuchen Sie auf einer 15 km langen Strecke im Hinterland, die nächtliche Tierwelt in der Landschaft von Etaploise zu erspähen."
        ],
        "en": [
          "Along a 15km route in the hinterland, try to catch a glimpse of the nocturnal fauna present in the Etaploise countryside."
        ],
        "it": [
          "Lungo un percorso di 15 km nell'entroterra, cercate di scorgere la fauna notturna presente nella campagna di Etaplois."
        ],
        "fr": [
          "Le long d’un parcours de 15 km dans l’arrière-pays, tentez de surprendre la faune nocturne présente dans la campagne étaploise."
        ],
        "nl": [
          "Probeer langs een route van 15 km in het achterland een glimp op te vangen van de nachtelijke fauna op het platteland van Etaplois."
        ],
        "es": [
          "A lo largo de un recorrido de 15 km por el interior, intente vislumbrar la fauna nocturna presente en la campiña de Etaplois."
        ]
      },
