  "rdfs:comment": {
    "de": [
      "Die Verehrung von SAINT ANTOINE DE PADOUE war im 19. Jahrhundert in Poix du Nord weit verbreitet (wir finden in vielen alten Häusern Almanache und andere Zeitschriften, die sich auf diesen Heiligen beziehen)."
    ],
    "en": [
      "Devotion to SAINT ANTOINE DE PADOUE was widespread in Poix du Nord in the 19th century (many old houses contain almanacs and other magazines about this saint)."
    ],
    "it": [
      "La devozione a SAINT ANTOINE DE PADOUE era molto diffusa nel Poix du Nord nel XIX secolo (in molte case antiche si trovano almanacchi e altre riviste su questo santo)."
    ],
    "fr": [
      "La dévotion à SAINT ANTOINE DE PADOUE était répandue à Poix du Nord au XIXème (nous trouvons dans nombre de maisons anciennes almanachs et autres revues concernant ce Saint)."
    ],
    "es": [
      "La devoción a SAINT ANTOINE DE PADOUE estaba muy extendida en Poix du Nord en el siglo XIX (muchas casas antiguas contienen almanaques y otras revistas sobre este santo)."
    ],
    "nl": [
      "De devotie tot SAINT ANTOINE DE PADOUE was wijdverspreid in Poix du Nord in de 19e eeuw (veel oude huizen bevatten almanakken en andere tijdschriften over deze heilige)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Saint Antoine de Padoue"
    ]
  },
