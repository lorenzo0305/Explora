      "dc:description": {
        "de": [
          "Vide-Grenier auf dem Place du Général de Gaulle, organisiert vom Comité des Fêtes d'Audruicq.\nIm Saal der Kastanienbäume: Trödelmarkt, organisiert von Art et Gaieté\n8h-17h"
        ],
        "en": [
          "Garage sale in the Place du Général de Gaulle organized by the Comité des Fêtes d'Audruicq.\nIn the Salle des Marronniers: flea market organized by Art et Gaieté\n8am-5pm"
        ],
        "it": [
          "Vendita di garage in Place du Général de Gaulle organizzata dal Comité des Fêtes d'Audruicq.\nNella Salle des Marronniers: mercatino delle pulci organizzato da Art et Gaieté\ndalle 8.00 alle 17.00"
        ],
        "fr": [
          "Vide-Grenier sur la place du Général de Gaulle organisé par le Comité des Fêtes d'Audruicq.\nDans la salle des marronniers : brocante organisé par Art et Gaieté\n8h-17h"
        ],
        "es": [
          "Venta de garaje en la Place du Général de Gaulle organizada por el Comité des Fêtes d'Audruicq.\nEn la Salle des Marronniers: mercadillo organizado por Art et Gaieté\nde 8.00 a 17.00 h"
        ],
        "nl": [
          "Garageverkoop op de Place du Général de Gaulle georganiseerd door het Comité des Fêtes d'Audruicq.\nIn de Salle des Marronniers: rommelmarkt georganiseerd door Art et Gaieté\n8.00 - 17.00 uur"
        ]
      },
