  "rdfs:comment": {
    "de": [
      "Der Bauernhof des Zoos und sein Obstgarten befinden sich nur wenige Schritte vom Zentrum entfernt, und doch herrscht hier das Gefühl vor, auf dem Land zu sein..."
    ],
    "en": [
      "The zoo's farm and conservatory orchard are just a stone's throw from the center, and yet it's the feeling of being in the countryside that prevails..."
    ],
    "it": [
      "La fattoria e il giardino d'inverno dello zoo sono a due passi dal centro, eppure l'impressione di essere in campagna prevale..."
    ],
    "fr": [
      "La ferme du zoo et son verger conservatoire sont situés à deux pas du centre et pourtant, c'est bel et bien l'impression d'être à la campagne qui prédomine..."
    ],
    "es": [
      "La granja del zoo y el huerto conservatorio están a tiro de piedra del centro, y sin embargo prevalece la impresión de estar en el campo..."
    ],
    "nl": [
      "De boerderij van de dierentuin en de boomgaard van de serre liggen op een steenworp afstand van het centrum, maar toch overheerst de indruk dat u op het platteland bent..."
    ]
  },
  "rdfs:label": {
