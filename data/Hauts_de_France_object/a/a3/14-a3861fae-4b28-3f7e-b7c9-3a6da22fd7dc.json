  "rdfs:comment": {
    "de": [
      "Kommen Sie allein, mit Freunden oder der Familie und durchstreifen Sie die Stadt auf der Suche nach Hinweisen, um das geheimnisvolle Wort zu finden und spielerisch das Kulturerbe zu entdecken!"
    ],
    "en": [
      "Come alone, with friends or with your family, and explore the city in search of clues to find the mystery word and discover the heritage while having fun!"
    ],
    "it": [
      "Venite da soli, con gli amici o in famiglia, esplorate la città alla ricerca di indizi per trovare la parola misteriosa e divertitevi a scoprire il nostro patrimonio!"
    ],
    "fr": [
      "Venez seul, entre amis ou en famille, sillonner la ville à la recherche d’indices pour retrouver le mot mystère et découvrir le patrimoine en s’amusant !"
    ],
    "es": [
      "Ven solo, con amigos o con toda la familia y explora la ciudad en busca de pistas para encontrar la palabra misteriosa, ¡y diviértete descubriendo nuestro patrimonio!"
    ],
    "nl": [
      "Kom alleen, met vrienden of met het hele gezin en verken de stad op zoek naar aanwijzingen om het mysterieuze woord te vinden, en beleef veel plezier aan het ontdekken van ons erfgoed!"
    ]
  },
  "rdfs:label": {
    "fr": [
