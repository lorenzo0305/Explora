  "rdfs:comment": {
    "de": [
      "Das S&L Haus bietet Ihnen eine sensationelle Reise durch die Meisterschaft außergewöhnlicher Produkte, während Sie die Liebe zur hausgemachten Küche teilen."
    ],
    "en": [
      "La Maison S&L offers you a sensational journey through the mastery of exceptional products, while sharing the love of homemade cooking."
    ],
    "it": [
      "La Maison S&L vi offre un viaggio sensazionale attraverso la maestria di prodotti eccezionali, condividendo l'amore per la cucina di casa."
    ],
    "fr": [
      "La Maison S&L vous propose un voyage sensationnel au travers de la maitrise de produits d'exception tout en partageant l'amour de la cuisine faite maison."
    ],
    "es": [
      "La Maison S&L le propone un viaje sensacional a través del dominio de productos excepcionales, compartiendo al mismo tiempo el amor por la cocina casera."
    ],
    "nl": [
      "La Maison S&L biedt u een sensationele reis door de beheersing van uitzonderlijke producten, terwijl u de liefde voor thuis koken deelt."
    ]
  },
