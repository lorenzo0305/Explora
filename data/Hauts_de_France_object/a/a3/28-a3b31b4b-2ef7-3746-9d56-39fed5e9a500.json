  "rdfs:comment": {
    "de": [
      "La Rotonde empfängt Sie jeden Mittag von Montag bis Samstag und bietet Ihnen sein Tagesmenü an, das Sie vor Ort entdecken oder mitnehmen können."
    ],
    "en": [
      "La Rotonde welcomes you every lunchtime from Monday to Saturday and offers you its menu of the day, to be discovered on the spot or to take away."
    ],
    "it": [
      "La Rotonde vi accoglie ogni giorno a pranzo dal lunedì al sabato e vi propone il suo menu del giorno, da scoprire sul posto o da portare via."
    ],
    "fr": [
      "La Rotonde vous accueille tous les midis du lundi au samedi et vous propose son menu du jour, à venir découvrir sur place ou à emporter."
    ],
    "nl": [
      "La Rotonde ontvangt u elke middag van maandag tot zaterdag en biedt u zijn dagmenu aan, om ter plaatse te ontdekken of om mee te nemen."
    ],
    "es": [
      "La Rotonde le acoge cada mediodía de lunes a sábado y le ofrece su menú del día, para descubrirlo in situ o para llevar."
    ]
  },
