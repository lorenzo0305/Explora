  "rdfs:comment": {
    "de": [
      "Traditionelle Friterie - Spezialität sind frische Pommes frites, hausgemachte Kroketten, Fish & Chips..."
    ],
    "en": [
      "Traditional French fry shop - Specializing in fresh French fries, homemade croquettes, fish & chips..."
    ],
    "it": [
      "Negozio tradizionale di patatine fritte - Specializzato in patatine fritte fresche, crocchette fatte in casa, fish & chips..."
    ],
    "fr": [
      "Friterie traditionnelle - Spécialité de frites fraîches, croquettes maison, fish & chips..."
    ],
    "nl": [
      "Traditionele friettent - Gespecialiseerd in verse friet, huisgemaakte kroketten, fish & chips..."
    ],
    "es": [
      "Chiringuito tradicional - Especializado en patatas fritas frescas, croquetas caseras, fish & chips..."
    ]
