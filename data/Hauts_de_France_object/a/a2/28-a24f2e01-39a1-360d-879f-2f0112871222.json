  "rdfs:comment": {
    "de": [
      "Im Les Accordailles in Compiègne, in der Nähe des Schlosses und des Théâtre Impérial, können Sie traditionelle französische Küche genießen, die durch einen Bio-Weinkeller ergänzt wird, sowie zarte Leckereien wie unsere hausgemachten Macarons."
    ],
    "en": [
      "At the Accordailles in Compiègne, near the Castle and the Imperial Theater, you can enjoy traditional French cuisine with an organic wine cellar as well as tender delicacies such as our homemade macaroons."
    ],
    "it": [
      "Al Les Accordailles di Compiègne, vicino al Castello e al Teatro Imperiale, potrete gustare la cucina tradizionale francese con una cantina di vini biologici e dolci come gli amaretti fatti in casa."
    ],
    "fr": [
      "Aux Accordailles à Compiègne, à proximité du Château et du Théâtre Impérial, vous pourrez déguster une cuisine française traditionnelle agrémentée d'une cave à vin bio ainsi que de tendres gourmandises tels que nos macarons faits maison."
    ],
    "nl": [
      "In Les Accordailles in Compiègne, dicht bij het kasteel en het keizerlijk theater, kunt u genieten van een traditionele Franse keuken met een biologische wijnkelder en zoete lekkernijen zoals onze zelfgemaakte bitterkoekjes."
    ],
    "es": [
      "En Les Accordailles, en Compiègne, cerca del Castillo y del Teatro Imperial, podrá disfrutar de la cocina tradicional francesa con una bodega de vinos ecológicos, así como de delicias dulces como nuestros macarrones caseros."
    ]
  },
