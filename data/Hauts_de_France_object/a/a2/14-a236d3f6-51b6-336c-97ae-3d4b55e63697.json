      "dc:description": {
        "de": [
          "Les 3 Brasseurs ist ein französisches Catering-Unternehmen, das sich auf Mikrobrauereien at spezialisiert hat und sein eigenes gleichnamiges Bier vor Ort herstellt."
        ],
        "en": [
          "Les 3 Brasseurs is a French catering company specializing in microbrewery and which produces its own beer of the same name on site."
        ],
        "it": [
          "Les 3 Brasseurs è un'azienda di ristorazione francese specializzata in microbirrifici e che produce l'omonima birra in loco."
        ],
        "fr": [
          "Les 3 Brasseurs est une entreprise de restauration française spécialisée dans la microbrasserie at qui fabrique sur place sa propre bière du même nom."
        ],
        "nl": [
          "Les 3 Brasseurs is een Frans horecabedrijf dat gespecialiseerd is in microbrouwen en ter plaatse zijn eigen bier met dezelfde naam produceert."
        ],
        "es": [
          "Les 3 Brasseurs es una empresa francesa de restauración especializada en microcervecerías que produce su propia cerveza del mismo nombre in situ."
        ]
