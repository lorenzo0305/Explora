  "rdfs:comment": {
    "de": [
      "Genießen Sie eine köstliche Mahlzeit in einer modernen und natürlichen Umgebung in absoluter Privatsphäre in einem Mikro-Restaurant, das von Ecocert als \"Biologisches Restaurant\" zertifiziert wurde."
    ],
    "en": [
      "Enjoy a delicious meal in a modern and natural setting in a micro-restaurant certified \"Organic Restaurant\" by Ecocert."
    ],
    "it": [
      "Gustate un pasto delizioso in un ambiente moderno e naturale in un micro-ristorante certificato \"Ristorante biologico\" da Ecocert."
    ],
    "fr": [
      "Dégustez un délicieux repas dans un cadre moderne et naturel en toute intimité dans un micro-restaurant certifié “Restaurant Biologique” par Ecocert."
    ],
    "nl": [
      "Geniet van een heerlijke maaltijd in een moderne en natuurlijke omgeving in volledige privacy in een micro-restaurant dat door Ecocert is gecertificeerd als \"Biologisch Restaurant\"."
    ],
    "es": [
      "Disfrute de una deliciosa comida en un entorno moderno y natural en un microrrestaurante certificado como \"Restaurante Ecológico\" por Ecocert."
    ]
  },
