  "rdfs:comment": {
    "de": [
      "Die Heilige Barbara wird nur ein einziges Mal gefeiert. Der Förderturm von 1-bis ist bereit, anlässlich der Einweihung seiner Sanierung in tausend Lichtern zu erstrahlen."
    ],
    "en": [
      "It?s a Saint Barbara?s Day you?ll only experience once. The 1-bis headframe is ready to shine for the inauguration of its rehabilitation."
    ],
    "it": [
      "È un giorno di Santa Barbara che si vive una volta sola. La testata 1-bis è pronta a brillare di mille luci per l'inaugurazione della sua riabilitazione."
    ],
    "fr": [
      "C’est une Sainte-Barbe qu’on ne vivra qu’une fois. Le chevalement du 1-bis est prêt à briller de mille feux pour l’inauguration de sa réhabilitation."
    ],
    "nl": [
      "Sint-Barbara's dag beleef je maar één keer. Het 1-bis casco is klaar om te schitteren met duizend lichtjes voor de inhuldiging van zijn rehabilitatie."
    ],
    "es": [
      "Es un día de Santa Bárbara que sólo se vive una vez. La cabecera del 1-bis está lista para brillar con mil luces con motivo de la inauguración de su rehabilitación."
    ]
  },
  "rdfs:label": {
