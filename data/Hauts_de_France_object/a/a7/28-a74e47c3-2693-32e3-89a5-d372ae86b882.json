  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/25279611-e48b-3fef-9075-b0251626911b",
      "dc:description": {
        "de": [
          "Dieses mit einem Gütesiegel versehene Estaminet befindet sich im Herzen des Grand-Place von Kassel. Hier können Sie flämische Spezialitäten und lokale handwerklich gebraute Biere in einer freundlichen und authentischen Atmosphäre genießen."
        ],
        "en": [
          "This labellized estaminet is located in the heart of the Grand-Place of Cassel. You can taste Flemish specialties and local craft beers in a friendly and authentic atmosphere."
        ],
        "it": [
          "Questo estaminet certificato si trova nel cuore della Grand-Place di Cassel. Potrete gustare specialità fiamminghe e birre artigianali locali in un'atmosfera amichevole e autentica."
        ],
        "fr": [
          "Cet estaminet labellisé se trouve au cœur de la Grand-Place de Cassel. Vous pourrez déguster les spécialités flamandes et des bières artisanales locales dans une ambiance conviviale et authentique."
        ],
        "es": [
          "Este estaminet certificado está situado en el corazón de la Grand-Place de Cassel. Podrá degustar especialidades flamencas y cervezas artesanales locales en un ambiente acogedor y auténtico."
        ],
        "nl": [
          "Dit gecertificeerde estaminet ligt in het hart van de Grote Markt van Cassel. U kunt er genieten van Vlaamse specialiteiten en lokale ambachtelijke bieren in een vriendelijke en authentieke sfeer."
        ]
      },
