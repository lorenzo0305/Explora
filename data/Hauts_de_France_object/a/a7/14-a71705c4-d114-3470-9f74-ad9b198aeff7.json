  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2b955660-c794-3d16-b7a2-d891440aeb4d",
      "dc:description": {
        "de": [
          "Historischer Verein, der im Oktober 1933 gegründet wurde und Piloten und Flugschüler zusammenbringt.\nMöglichkeit von Lufttaufen in der Umgebung (Privatpersonen oder Unternehmen)"
        ],
        "en": [
          "Historic association created in October 1933, bringing together pilots and student pilots.\nPossibility of first flights in the surrounding area (individuals or companies)"
        ],
        "it": [
          "Associazione storica creata nell'ottobre 1933, che riunisce piloti e allievi piloti.\nPossibilità di effettuare primi voli nei dintorni (privati o aziende)"
        ],
        "fr": [
          "Association historique créé en octobre 1933, réunissant des pilotes et élèves pilotes. \nPossibilité de baptêmes de l’air dans les environs (particuliers ou entreprises)"
        ],
        "nl": [
          "Historische vereniging opgericht in oktober 1933, die piloten en leerling-piloten samenbrengt.\nMogelijkheid tot eerste vluchten in de omgeving (particulieren of bedrijven)"
        ],
        "es": [
          "Asociación histórica creada en octubre de 1933, que agrupa a pilotos y alumnos pilotos.\nPosibilidad de realizar primeros vuelos en los alrededores (particulares o empresas)"
        ]
      },
