  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0fbd0a1d-c42f-3e27-9931-09a02ac55092",
      "dc:description": {
        "de": [
          "Geführte Besichtigung des Muschelparks von Saint Frieux und des Hafens von Boulogne sur Mer, Spaziergang bei Sonnenuntergang, Einführung in Wassersportarten, Vortrag über die Erosion der Dünen usw."
        ],
        "en": [
          "Guided tour of the Saint Frieux mussel park and the port of Boulogne sur mer, sunset stroll, introduction to water sports, lecture on dune erosion, etc."
        ],
        "it": [
          "Visita guidata del parco delle cozze di Saint Frieux e del porto di Boulogne sur mer, passeggiata al tramonto, introduzione agli sport acquatici, lezione sull'erosione delle dune, ecc."
        ],
        "fr": [
          "Visite guidée du parc mytilicole de Saint Frieux et du port de Boulogne sur mer, balade au coucher du soleil, initiation aux sports nautiques, conférence sur l'érosion des dunes etc."
        ],
        "es": [
          "Visita guiada al parque de mejillones de Saint Frieux y al puerto de Boulogne sur mer, paseo al atardecer, iniciación a los deportes náuticos, conferencia sobre la erosión de las dunas, etc."
        ],
        "nl": [
          "Rondleiding door het mosselpark Saint-Frieux en de haven van Boulogne sur mer, wandeling bij zonsondergang, kennismaking met watersporten, lezing over duinerosie, enz."
        ]
      },
