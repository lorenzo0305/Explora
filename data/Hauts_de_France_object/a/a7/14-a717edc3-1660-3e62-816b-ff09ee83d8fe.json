  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/41d4cc37-e150-3dc4-954f-5e9f8ffef9b4",
      "dc:description": {
        "de": [
          "Wir sind ein in der Föderation eingetragener Pétanque-Verein und haben jeden Sonntagmorgen von 9 bis 12.30 Uhr und am Mittwoch von 14.30 bis 18 Uhr geöffnet."
        ],
        "en": [
          "We are a federation-registered pétanque association, open every Sunday morning from 9am to 12:30pm and on Wednesdays from 2:30pm to 6pm."
        ],
        "it": [
          "Siamo un'associazione di pétanque registrata, aperta tutte le domeniche mattina dalle 9.00 alle 12.30 e il mercoledì dalle 14.30 alle 18.00."
        ],
        "fr": [
          "Nous sommes une association de pétanque inscrite en fédération, nous sommes ouverts tous les dimanches matin de 9h à 12h30 et le mercredi de 14h30 à 18h."
        ],
        "nl": [
          "We zijn een geregistreerde jeu-de-boulesvereniging, elke zondagochtend geopend van 9.00 tot 12.30 uur en op woensdag van 14.30 tot 18.00 uur."
        ],
        "es": [
          "Somos una asociación de petanca registrada, abierta todos los domingos por la mañana de 9.00 a 12.30 y los miércoles de 14.30 a 18.00."
        ]
      },
