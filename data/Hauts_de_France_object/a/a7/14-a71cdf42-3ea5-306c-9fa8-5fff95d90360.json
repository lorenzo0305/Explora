  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6002883c-02f8-39bb-a71b-313133fc5089",
      "dc:description": {
        "de": [
          "Feinkostladen im alten Stil mit einer strengen Auswahl an regionalen Produkten (Suppen, Nudeln, Fertiggerichte, Tees, Süßwaren ...). Herstellung von garnierten Körben nach Ihrem Wunsch."
        ],
        "en": [
          "Old-fashioned delicatessen offering a rigorous selection of regional products (soups, pasta, ready meals, teas, sweets...). Realization of baskets filled at your convenience."
        ],
        "it": [
          "Una gastronomia d'altri tempi che offre una rigorosa selezione di prodotti regionali (zuppe, pasta, piatti cucinati, tè, dolci, ecc.). Cestini riempiti a piacere."
        ],
        "fr": [
          "Épicerie fine à l'ancienne qui propose une rigoureuse sélection de produits régionaux (soupes, pâtes, plats cuisinés, thés, confiseries...). Réalisation de corbeilles garnies à votre convenance."
        ],
        "es": [
          "Una charcutería a la antigua usanza que ofrece una rigurosa selección de productos regionales (sopas, pastas, platos cocinados, tés, dulces, etc.). Cestas rellenas a su gusto."
        ],
        "nl": [
          "Een ouderwetse delicatessenwinkel met een strenge selectie van regionale producten (soepen, pasta, gerechten, thee, snoep, enz.). Manden naar wens gevuld."
        ]
      },
