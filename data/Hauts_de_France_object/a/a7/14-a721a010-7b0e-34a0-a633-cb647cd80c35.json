  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c4f88335-c1fa-354d-b60d-17525d1d124e",
      "dc:description": {
        "de": [
          "Komm und entdecke kostenlos Tischtennis mit dem Tischtennisverein von Camièrois (les Ch'tites Raquettes) am Mittwoch, den 23. August von 14:30 bis 16:30 Uhr auf der Esplanade de Sainte Cécile"
        ],
        "en": [
          "Come and discover table tennis for free with the Camièrois table tennis club (Les Ch'tites Raquettes) on Wednesday August 23 from 2.30 to 4.30 pm on the Esplanade de Sainte Cécile"
        ],
        "it": [
          "Venite a scoprire gratuitamente il tennis da tavolo con il club di tennis da tavolo Camièrois (les Ch'tites Raquettes) mercoledì 23 agosto dalle 14.30 alle 16.30 sull'Esplanade de Sainte Cécile"
        ],
        "fr": [
          "Viens découvrir le tennis de table gratuitement avec le club Camièrois de tennis de table (les Ch'tites Raquettes) ce mercredi 23 aout de 14h30 à 16h30 sur l'Esplanade de Sainte Cécile"
        ],
        "es": [
          "Venga a descubrir gratuitamente el tenis de mesa con el club de tenis de mesa de Camièrois (les Ch'tites Raquettes) el miércoles 23 de agosto de 14:30 a 16:30 en la explanada de Sainte Cécile"
        ],
        "nl": [
          "Kom gratis kennismaken met tafeltennis bij de tafeltennisclub van Camièrois (les Ch'tites Raquettes) op woensdag 23 augustus van 14.30 tot 16.30 uur op de Esplanade de Sainte Cécile"
        ]
      },
