  "rdfs:comment": {
    "de": [
      "Das unter Denkmalschutz stehende Schloss wird durch spielerische Führungen rund um die Erbauer und das Alltagsleben im 14. Jahrhundert belebt."
    ],
    "en": [
      "Listed as a Historic Monument, the castle is enlivened by playful visits around the builders and daily life in the 14th century."
    ],
    "it": [
      "Classificato come Monumento Storico, il castello è animato da visite divertenti sui costruttori e sulla vita quotidiana nel XIV secolo."
    ],
    "fr": [
      "Inscrit aux Monuments Historiques, le château est animé par des visites ludiques autour des bâtisseurs et de la vie quotidienne au XIVe siècle."
    ],
    "nl": [
      "Het kasteel staat op de monumentenlijst en wordt geanimeerd door onderhoudende rondleidingen over de bouwers en het dagelijks leven in de 14e eeuw."
    ],
    "es": [
      "Catalogado como Monumento Histórico, el castillo está animado por visitas entretenidas sobre los constructores y la vida cotidiana en el siglo XIV."
