  "rdfs:comment": {
    "de": [
      "A Laon Bike wurde 1974 gegründet und ist ein Mountainbike-Sportverein, der an mehreren Organisationen beteiligt ist, z. B. an Wanderungen, mehrtägigen Fortgeschrittenenkursen, Einführungen für Kinder, Sporttagen etc"
    ],
    "en": [
      "Created in 1974, A Laon Bike is a mountain bike sports association, involved in several organisations such as hikes, training courses over several days, children's initiations, sports days etc.."
    ],
    "it": [
      "Creata nel 1974, A Laon Bike è un'associazione sportiva di mountain bike, coinvolta in diverse organizzazioni come corse, corsi di formazione di più giorni, iniziazioni per bambini, giornate sportive ecc"
    ],
    "fr": [
      "Créée en 1974, A Laon Bike est une association sportive VTT, impliquée dans plusieurs organisations telles que des randonnées, stages de perfectionnement sur plusieurs jours, des initiations enfants, des journées sportives etc…"
    ],
    "es": [
      "Creada en 1974, A Laon Bike es una asociación deportiva de ciclismo de montaña, que participa en varias organizaciones como paseos, cursos de formación de varios días, iniciaciones infantiles, jornadas deportivas, etc"
    ],
    "nl": [
      "A Laon Bike, opgericht in 1974, is een sportvereniging voor mountainbikes, die betrokken is bij verschillende organisaties zoals ritten, meerdaagse trainingen, initiaties voor kinderen, sportdagen enz.."
    ]
  },
