  "rdfs:comment": {
    "de": [
      "Schlendern Sie unter den bunten Wimpeln, lassen Sie sich von den Akkordeonklängen mitreißen und genießen Sie die festliche Atmosphäre für die ganze Familie!"
    ],
    "en": [
      "Stroll under the colorful pennants, let yourself be carried away by the accordion tunes, and enjoy a festive atmosphere for the whole family!"
    ],
    "it": [
      "Passeggiate sotto i gagliardetti colorati, lasciatevi trasportare dalle melodie della fisarmonica e godetevi l'atmosfera di festa per tutta la famiglia!"
    ],
    "fr": [
      "Flânez sous les fanions colorés, laissez-vous emporter par les airs d’accordéon, et profitez d’une ambiance festive pour toute la famille !"
    ],
    "nl": [
      "Wandel onder de kleurrijke wimpels, laat je meeslepen door de accordeonmuziek en geniet van een feestelijke sfeer voor het hele gezin!"
    ],
    "es": [
      "Pasee bajo los banderines de colores, déjese llevar por las melodías de acordeón y disfrute de un ambiente festivo para toda la familia"
    ]
  },
