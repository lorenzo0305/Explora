  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/49fbac8b-3ad9-3ce5-9412-3efa38f4690a",
      "dc:description": {
        "de": [
          "Illuminationen - Beleuchtetes Tal, belebte Dörfer!\n\nProgramm :\n\n- Illuminationen des Tals: Die Dörfer des Tals werden mit tausend Lichtern beleuchtet und schaffen eine märchenhafte Atmosphäre.\n- Belebte Dörfer: In den Dörfern des Tals werden Animationen und Aufführungen organisiert."
        ],
        "en": [
          "Illuminations - Valley lit up, villages alive!\n\nProgram :\n\n- Valley illuminations: The villages of the valley will be illuminated with a thousand lights, creating a magical atmosphere.\n- Animated villages: entertainment and shows will be organized in the valley's villages."
        ],
        "it": [
          "Illuminazioni - Valle illuminata, villaggi vivi!\n\nProgramma :\n\n- Illuminazione della valle: i villaggi della valle saranno illuminati da mille luci, creando un'atmosfera magica.\n- Villaggi animati: nei villaggi della valle saranno organizzati spettacoli e intrattenimenti."
        ],
        "fr": [
          "Illuminations - Vallée illuminée, villages animés !\n\nProgramme :\n\n- Illuminations de la vallée : Les villages de la vallée seront illuminés de mille feux, créant une ambiance féerique.\n- Villages animés : Des animations et des spectacles seront organisés dans les villages de la vallée."
        ],
        "es": [
          "Iluminaciones - ¡Valle iluminado, pueblos vivos!\n\nPrograma :\n\n- Iluminaciones en el valle: Los pueblos del valle se iluminarán con mil luces, creando un ambiente mágico.\n- Pueblos animados: Se organizarán entretenimientos y espectáculos en los pueblos del valle."
        ],
        "nl": [
          "Illuminations - Vallei verlicht, dorpen tot leven!\n\nProgramma :\n\n- Illuminaties in de vallei: De dorpen in de vallei worden verlicht met duizend lichtjes die een magische sfeer creëren.\n- Levendige dorpen: In de dorpen van de vallei worden animaties en voorstellingen georganiseerd."
        ]
      },
      "@type": [
        "Description"
      ],
