      "@id": "https://data.datatourisme.fr/fc79c690-6b2a-3816-bb1f-8f3298b7ca3b",
      "dc:description": {
        "de": [
          "Besuchen Sie in Begleitung eines Vermittlers die Seefischerei und entdecken Sie sie in Form eines Workshops, der auch für die Kleinsten geeignet ist."
        ],
        "en": [
          "Accompanied by a mediator, visit and discover sea fishing in the form of a workshop adapted to the youngest visitors."
        ],
        "it": [
          "Accompagnati da un mediatore, visitate e scoprite la pesca in mare sotto forma di laboratorio adattato ai visitatori più giovani."
        ],
        "fr": [
          "Accompagné d'un médiateur, visitez et découvrez la pêche en mer sous la forme d'un atelier adapté aus plus petits."
        ],
        "nl": [
          "Bezoek en ontdek, onder begeleiding van een mediator, de zeevisserij in de vorm van een workshop aangepast aan de jongste bezoekers."
        ],
        "es": [
          "Acompañado por un mediador, visite y descubra la pesca marítima en forma de taller adaptado a los más pequeños."
        ]
      },
