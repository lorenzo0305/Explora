  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: der gemütliche Chic, die Umgebung am Wasser und die qualitative Küche mit frischen, lokalen Produkten der Saison"
    ],
    "en": [
      "You'll love its cosy-chic feel, waterside setting and high-quality cuisine based on fresh, local seasonal produce"
    ],
    "it": [
      "Vi piacerà la sua atmosfera accogliente e chic, l'ambientazione in riva al mare e la cucina di alta qualità a base di prodotti freschi e locali di stagione"
    ],
    "fr": [
      "Vous aimerez : son esprit cosy chic, son cadre au bord de l'eau et sa cuisine qualitative à base de produits de saison frais et locaux"
    ],
    "nl": [
      "U zult dol zijn op de gezellige, chique sfeer, de ligging aan het water en de hoogwaardige keuken op basis van verse, lokale seizoensproducten"
    ],
    "es": [
      "Le encantará su ambiente acogedor y elegante, su ubicación junto al agua y su cocina de alta calidad basada en productos locales frescos de temporada"
    ]
  },
