  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f210c229-03ed-32be-8ca9-3cc53744820f",
      "dc:description": {
        "de": [
          "Bar-Brasserie mit gepflegtem Look, schöne Salate, hausgemachte Burger empfehlenswert.\n\nAngenehme Terrasse in der Fußgängerzone, im Stadtzentrum, angelehnt an den Square René Goblet."
        ],
        "en": [
          "Bar-brewery with a neat look, nice salads, home made burger recommended.\n\nPleasant terrace in the pedestrian zone, in the city centre, leaning against the René Goblet square."
        ],
        "it": [
          "Bar/birreria dall'aspetto curato, belle insalate, consigliato l'hamburger della casa.\n\nPiacevole terrazza nella zona pedonale, nel centro della città, accanto alla piazza René Goblet."
        ],
        "fr": [
          "Bar-brasserie au look soigné, belles salades, burger maison recommandé.\n\nTerrasse agréable en zone piétonne, en centre-ville, adossée au square René Goblet."
        ],
        "nl": [
          "Nette bar/brouwerij, lekkere salades, hamburger van het huis aanbevolen.\n\nAangenaam terras in de voetgangerszone, in het stadscentrum, naast het René Gobletplein."
        ],
        "es": [
          "Bar/cervecería de aspecto cuidado, buenas ensaladas, hamburguesa de la casa recomendada.\n\nAgradable terraza en la zona peatonal, en el centro de la ciudad, junto a la plaza René Goblet."
        ]
      },
