      "@id": "https://data.datatourisme.fr/b325608b-8be6-3da8-8fef-c8c9ca431742",
      "dc:description": {
        "de": [
          "Das Office Municipal d'Animation bietet am Samstag, den 20. Dezember, einen Weihnachtskabarettabend an.\nShow-Essen (englischer Teller oder Paella), Käse, Dessert und Kaffee."
        ],
        "en": [
          "The Office Municipal d'Animation offers a Christmas cabaret evening on Saturday December 20.\nDinner and show (English plate or paella), cheese, dessert and coffee."
        ],
        "it": [
          "L'Office Municipal d'Animation organizza una serata di cabaret natalizio sabato 20 dicembre.\nCena e spettacolo (piatto inglese o paella), formaggio, dessert e caffè."
        ],
        "fr": [
          "L'office Municipal d'Animation propose la soirée cabaret de Noël le samedi 20 décembre.\nRepas-spectacle (assiette anglaise ou paella), fromage, dessert et café."
        ],
        "es": [
          "La Oficina Municipal de Animación organiza una velada de cabaret navideño el sábado 20 de diciembre.\nCena y espectáculo (plato inglés o paella), queso, postre y café."
        ],
        "nl": [
          "Het Office Municipal d'Animation organiseert een kerstcabaretavond op zaterdag 20 december.\nDiner en show (Engelse schotel of paella), kaas, dessert en koffie."
        ]
      },
