      "dc:description": {
        "de": [
          "Genießen Sie die frische Luft bei einem Spaziergang durch die Erdbeerfelder, die Sie selbst pflücken können!"
        ],
        "en": [
          "Enjoy the fresh air by walking through the strawberry fields that you can pick yourself!"
        ],
        "it": [
          "Godetevi l'aria fresca passeggiando tra i campi di fragole, che potrete raccogliere voi stessi!"
        ],
        "fr": [
          "Profitez du grand air en vous baladant dans les champs de fraises que vous pourrez cueillir vous même !"
        ],
        "nl": [
          "Geniet van de frisse lucht door te wandelen door de aardbeienvelden, die je zelf kunt plukken!"
        ],
        "es": [
          "Disfrute del aire fresco paseando por los campos de fresas, que podrá recoger usted mismo"
        ]
      },
