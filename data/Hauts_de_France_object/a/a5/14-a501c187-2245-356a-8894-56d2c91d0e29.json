      "@id": "https://data.datatourisme.fr/e2a09a25-c950-34b5-8000-e4f9118b18e5",
      "dc:description": {
        "de": [
          "25. Juli: Patricia MAC DYWER WENDESKI \"Die gelebte Brüderlichkeit mit den Migranten in Calais\".\n1. August: Olivier JONCQUEZ Kardinal John Henri Newman \"Leitfaden für ein Leben in der Hoffnung\".\n8. August: Venceslas DEBLOCK \"Die Aufnahme Mariens in den Himmel in der Kunst\"."
        ],
        "en": [
          "july 25: Patricia MAC DYWER WENDESKI \"Fraternity lived with migrants in Calais\".\naugust 1: Olivier JONCQUEZ Cardinal John Henry Newman \"Guide to a life of hope\".\naugust 8: Wenceslas DEBLOCK \"The Assumption of Mary in art\"."
        ],
        "it": [
          "25 luglio: Patricia MAC DYWER WENDESKI \"La fraternità vissuta con i migranti a Calais\".\n1° agosto: Olivier JONCQUEZ Il cardinale John Henry Newman \"Guida a una vita di speranza\".\n8 agosto: Venceslas DEBLOCK \"L'Assunzione di Maria nell'arte\"."
        ],
        "fr": [
          "25 juillet : Patricia MAC DYWER WENDESKI \"La fraternité vécue avec les migrants à Calais\". \n1er août : Olivier JONCQUEZ le cardinal John Henri Newman \"Guide pour une vie dans l’espérance\".\n8 août : Venceslas DEBLOCK \"L’assomption de Marie dans l’art\"."
        ],
        "nl": [
          "25 juli: Patricia MAC DYWER WENDESKI \"Broederschap met migranten in Calais\".\n1 augustus: Olivier JONCQUEZ Kardinaal John Henry Newman \"Gids voor een leven vol hoop\".\n8 augustus: Venceslas DEBLOCK \"Maria Hemelvaart in de kunst\"."
        ],
        "es": [
          "25 de julio: Patricia MAC DYWER WENDESKI \"Fraternidad vivida con los migrantes en Calais\".\n1 de agosto: Olivier JONCQUEZ Cardenal John Henry Newman \"Guía para una vida de esperanza\".\n8 de agosto: Venceslas DEBLOCK \"La Asunción de María en el arte\"."
        ]
      },
