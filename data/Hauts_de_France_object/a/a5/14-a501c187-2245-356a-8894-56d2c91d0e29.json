  "rdfs:comment": {
    "de": [
      "Der Verein hat sich zum Ziel gesetzt, den Besuchern und Einwohnern der Côte d'Opale Vorschläge zu machen, indem er Veranstaltungen rund um das religiöse Erbe organisiert: Vorträge, Ausstellungen, Besichtigungen, Wanderungen?"
    ],
    "en": [
      "The aim of the association is to make proposals to visitors and inhabitants of the Opal Coast by organizing events around religious heritage: conferences, exhibitions, visits, walks?"
    ],
    "it": [
      "L'obiettivo dell'associazione è quello di dare suggerimenti ai visitatori e ai residenti della Costa d'Opale organizzando eventi intorno al patrimonio religioso: conferenze, mostre, visite, passeggiate, ecc"
    ],
    "fr": [
      "L’association a pour but de faire des propositions en direction des visiteurs et des habitants de la Côte d’Opale en organisant des manifestations autour du patrimoine religieux : conférences, expositions, visites, marches…"
    ],
    "nl": [
      "Het doel van de vereniging is suggesties te doen aan bezoekers en bewoners van de Opaalkust door evenementen te organiseren rond religieus erfgoed: conferenties, tentoonstellingen, bezoeken, wandelingen, enz"
    ],
    "es": [
      "El objetivo de la asociación es hacer propuestas a los visitantes y residentes de la Costa de Ópalo organizando actos en torno al patrimonio religioso: conferencias, exposiciones, visitas, paseos, etc"
    ]
  },
