  "rdfs:comment": {
    "de": [
      "Während du eine Untersuchung zur Rettung von König Karl VI. löst, entdeckst du die Außenanlagen des Gallé-Juillet-Museums. Auf die Turnschuhe, die Zukunft des Königreichs hängt von dir ab!"
    ],
    "en": [
      "While solving an investigation to save King Charles VI, you'll discover the outdoor areas of the Musée Gallé-Juillet. On your sneakers, the future of the kingdom depends on you!"
    ],
    "it": [
      "Mentre risolvete un'indagine per salvare il re Carlo VI, scoprirete le aree esterne del Musée Gallé-Juillet. Indossate le vostre scarpe da ginnastica, il futuro del regno dipende da voi!"
    ],
    "fr": [
      "Tout en résolvant une enquête pour sauver le roi Charles VI, vous découvrirez les espaces extérieurs du Musée Gallé-Juillet. A vos baskets, l'avenir du royaume dépend de vous !"
    ],
    "nl": [
      "Terwijl je een onderzoek oplost om Koning Karel VI te redden, ontdek je de buitenruimtes van het Musée Gallé-Juillet. Trek je sportschoenen aan, de toekomst van het koninkrijk hangt van jou af!"
    ],
    "es": [
      "Mientras resuelves una investigación para salvar al rey Carlos VI, descubrirás las zonas exteriores del Musée Gallé-Juillet. Ponte las zapatillas, ¡el futuro del reino depende de ti!"
    ]
  },
