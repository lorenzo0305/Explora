      "dc:description": {
        "de": [
          "Die Gesangsklasse des Konservatoriums, die von Jimmy VANDEVILLE geleitet und von Samuel PRETE begleitet wird, wird das musikalische Repertoire während des Ersten Weltkriegs neu beleuchten."
        ],
        "en": [
          "The Conservatoire's singing class, directed by Jimmy VANDEVILLE and accompanied by Samuel PRETE, will revisit the musical repertoire of the First World War."
        ],
        "it": [
          "La classe di canto del Conservatorio, guidata da Jimmy VANDEVILLE e accompagnata da Samuel PRETE, rivisiterà il repertorio musicale della Prima guerra mondiale."
        ],
        "fr": [
          "La classe de chant du conservatoire, dirigée par Jimmy VANDEVILLE et accompagnée par Samuel PRETE, revisitera le répertoire musical durant la première guerre mondiale."
        ],
        "es": [
          "La clase de canto del Conservatorio, dirigida por Jimmy VANDEVILLE y acompañada por Samuel PRETE, revisará el repertorio musical de la Primera Guerra Mundial."
        ],
        "nl": [
          "De zangklas van het Conservatorium, geleid door Jimmy VANDEVILLE en begeleid door Samuel PRETE, zal het muzikale repertoire van de Eerste Wereldoorlog opnieuw bekijken."
        ]
      },
