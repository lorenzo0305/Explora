  "rdfs:comment": {
    "de": [
      "Laurence und Hervé bieten Ihnen eine geschmackvolle traditionelle Küche und einen herzlichen Empfang in einem Rahmen, dessen Dekoration sich dank des Themas der Maler alle drei Monate ändert. Besuchen Sie uns in Le Lautrec, 5 km von Maroilles entfernt!"
    ],
    "en": [
      "Laurence and Hervé propose you a traditional cooking of good taste, and a warm welcome in a setting whose decoration changes every 3 months, thanks to the theme of the painters. Come to see us in Lautrec, 5km from Maroilles !"
    ],
    "it": [
      "Laurence e Hervé vi propongono una cucina tradizionale di buon gusto e un'accoglienza calorosa in un ambiente la cui decorazione cambia ogni 3 mesi, grazie al tema dei pittori. Venite a trovarci a Lautrec, a 5 km da Maroilles!"
    ],
    "fr": [
      "Laurence et Hervé vous proposent une cuisine traditionnelle de bon goût, et un accueil chaleureux dans un cadre dont la déco change tous les 3 mois, grâce au thème des peintres. venez nous voir au Lautrec, à 5km de Maroilles !"
    ],
    "es": [
      "Laurence y Hervé le ofrecen una cocina tradicional de buen gusto y una cálida acogida en un marco cuya decoración cambia cada 3 meses, gracias a la temática de los pintores ¡Venga a vernos a Lautrec, a 5 km de Maroilles!"
    ],
    "nl": [
      "Laurence en Hervé bieden u een traditionele keuken van goede smaak, en een warm onthaal in een decor dat om de 3 maanden verandert, dankzij het thema van de schilders. Kom ons opzoeken in Lautrec, op 5 km van Maroilles!"
    ]
  },
