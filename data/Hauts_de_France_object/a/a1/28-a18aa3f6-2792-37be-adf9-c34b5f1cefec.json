  "rdfs:comment": {
    "de": [
      "Kreative, hausgemachte Küche mit lokalen Produkten, Biogemüse. Tagesmenü unter der Woche, à la carte am Freitagabend und Samstag. Vegetarier sind willkommen. Spezialität: Desserts."
    ],
    "en": [
      "Creative home-made cooking with local products, organic vegetables. Daily menu during the week, à la carte on Friday evening and Saturday. Vegetarians welcome. Speciality: desserts."
    ],
    "it": [
      "Cucina creativa fatta in casa con prodotti locali e verdure biologiche. Menu giornaliero durante la settimana, à la carte il venerdì sera e il sabato. I vegetariani sono i benvenuti. Specialità: dessert."
    ],
    "fr": [
      "Cuisine créative faite maison avec des produits locaux, légumes bio. Menu du jour en semaine, à la carte le vendredi soir et samedi. Végétariens bienvenus. Spécialité : desserts."
    ],
    "nl": [
      "Creatieve huisgemaakte keuken met lokale producten, biologische groenten. Dagmenu tijdens de week, à la carte op vrijdagavond en zaterdag. Vegetariërs welkom. Specialiteit: desserts."
    ],
    "es": [
      "Cocina casera y creativa con productos locales, verduras ecológicas. Menú diario durante la semana, a la carta el viernes por la noche y el sábado. Los vegetarianos son bienvenidos. Especialidad: postres."
    ]
  },
  "rdfs:label": {
