      "@id": "https://data.datatourisme.fr/bac7d49b-5a72-3766-9333-ff55e1aea8ea",
      "dc:description": {
        "de": [
          "Ferien-Volleyball 2022 an den Standorten Merlimont und Stella-plage: Erleben Sie Spaß auf den Beachvolleyballfeldern an jedem Tag der Woche ab 10 Uhr und am Wochenende ab 14.30 Uhr."
        ],
        "en": [
          "Volley vacances 2022 on the Merlimont and Stella-plage sites: come and have fun on the beach volleyball courts every day of the week from 10am and at weekends from 2.30pm."
        ],
        "it": [
          "Vacanze volley 2022 a Merlimont e Stella-plage: venite a divertirvi sui campi da beach volley tutti i giorni della settimana dalle 10.00 e nei weekend dalle 14.30."
        ],
        "fr": [
          "Volley vacances 2022 sur les sites de Merlimont et Stella-plage : venez vous amuser sur les terrains de volley de plage tous les jours de la semaine à partir de 10h et le week-end à partir de 14h30."
        ],
        "nl": [
          "Volleybalvakantie 2022 in Merlimont en Stella-plage: kom elke dag van de week vanaf 10 uur en in het weekend vanaf 14.30 uur plezier maken op de beachvolleybalvelden."
        ],
        "es": [
          "Vacaciones de voleibol 2022 en Merlimont y Stella-plage: venga a divertirse a las pistas de voleibol playa todos los días de la semana a partir de las 10h y los fines de semana a partir de las 14h30."
        ]
      },
