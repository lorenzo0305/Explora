  "rdfs:comment": {
    "de": [
      "Traiteur-Restaurant- Couscous, Tajines, Gegrilltes, Salate, Pasta und Pizzas-\nDienstag bis Sonntagmittag geöffnet - Montag geschlossen\n\nAnimationen: Abendunterhaltung mit einer Bauchtänzerin\n\nMetrolinie 2: Haltestelle \"Mairie de Mons\" gegenüber der Metro.\n "
    ],
    "en": [
      "Restaurant Caterer- Couscous, tajines, grilled meats, salads, pasta and pizzas-\nOpen Tuesday to Sunday lunchtime - Closed on Mondays\n\nEntertainment: lively evenings with an Oriental dancer-\n\nMetro line 2: station 'Mairie de Mons' opposite the Metro.\n "
    ],
    "it": [
      "Ristorante con servizio di catering - Couscous, tajine, carne alla griglia, insalate, pasta e pizze\nAperto dal martedì alla domenica a pranzo - Chiuso il lunedì\n\nIntrattenimento: serate vivaci con una ballerina orientale\n\nLinea 2 della metropolitana: stazione \"Mairie de Mons\" di fronte alla stazione della metropolitana.\n "
    ],
    "fr": [
      "Restaurant Traiteur- Couscous, tajines, grillades, salades, pâtes et pizzas-\nOuvert du mardi au dimanche midi - Fermeture le lundi\n\nAnimations: soirées animées avec une danseuse orientale-\n\nMétro ligne 2 : station 'Mairie de Mons' face au Métro.\n "
    ],
    "es": [
      "Restaurante con servicio de catering - Cuscús, tajines, carnes a la parrilla, ensaladas, pasta y pizzas-\nAbierto de martes a domingo al mediodía - Lunes cerrado\n\nAnimación: veladas animadas con una bailarina oriental\n\nMetro línea 2: estación \"Mairie de Mons\" frente a la estación de metro.\n "
    ],
    "nl": [
      "Cateringrestaurant - Couscous, tajines, gegrild vlees, salades, pasta's en pizza's-..\nGeopend van dinsdag tot zondag lunchtijd - Maandag gesloten\n\nEntertainment: levendige avonden met een oosterse danseres\n\nMetrolijn 2: station 'Mairie de Mons' tegenover het metrostation.\n "
    ]
  },
