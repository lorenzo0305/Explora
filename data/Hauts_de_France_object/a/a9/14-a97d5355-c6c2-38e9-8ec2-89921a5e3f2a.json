  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f3df65b2-a2b3-393c-8b7b-35d635b621de",
      "dc:description": {
        "de": [
          "RDV um 21 Uhr an Donnerstagen.\nWenn die Nacht hereinbricht, durchstreifen Sie die Straßen der Oberstadt mit ihren Geheimnissen, dank einer Führung im Patois Boulonnais!\nTreffpunkt vor dem Schloss, Rue de Bernet.\nDauer: 1 Stunde 30 Minuten. Preis: 5? (kostenlos für Kinder unter 12 Jahren).\nOnline-Reservierung der Eintrittskarten erforderlich auf der Website"
        ],
        "en": [
          "RDV at 9pm on Thursdays.\nWhen night falls, discover the secrets of the upper town's streets with a tour in Boulonnais patois!\nMeet in front of the château, rue de Bernet.\nDuration: 1H30. Price: 5? (free for children under 12).\nTickets must be booked online at"
        ],
        "it": [
          "RDV alle 21.00 del giovedì.\nQuando cala la notte, esplorate le strade della città alta e scopritene i segreti, grazie a un tour in patois boulonnais!\nAppuntamento davanti al castello, rue de Bernet.\nDurata: 1H30. Prezzo: 5 € (gratuito per i minori di 12 anni).\nI biglietti devono essere prenotati online su"
        ],
        "fr": [
          "RDV à 21h les jeudis.\nQuand la nuit tombe, parcourez les rues de la ville haute à travers ses secrets, grâce à une visite en patois boulonnais !.\nRendez-vous devant le château, rue de Bernet.\nDurée : 1H30. Tarif : 5€ (gratuit pour les moins de 12 ans).\nRéservation des billets en ligne obligatoire sur le site"
        ],
        "nl": [
          "RDV om 21u op donderdag.\nVerken bij het vallen van de avond de straten van de bovenstad en ontdek haar geheimen dankzij een rondleiding in Boulonnais patois!\nAfspraak voor het kasteel, rue de Bernet.\nDuur: 1H30. Prijs: €5 (gratis voor kinderen onder de 12 jaar).\nTickets moeten online worden gereserveerd op"
        ],
        "es": [
          "RDV a las 21 h los jueves.\nAl caer la noche, explore las calles de la parte alta de la ciudad y descubra sus secretos, gracias a un recorrido en patois boulonnais.\nEncuentro frente al castillo, rue de Bernet.\nDuración: 1H30. Precio: 5 euros (gratis para menores de 12 años).\nLas entradas deben reservarse en línea en"
        ]
      },
