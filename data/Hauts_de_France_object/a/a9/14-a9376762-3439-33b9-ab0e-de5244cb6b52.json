      "dc:description": {
        "de": [
          "Sonntag, den 19. April 2026\nWanderung der 4 Jahreszeiten\n3 Strecken von 30 km, 60 km und 90 km\nStart zwischen 7:00 und 10:00 Uhr avenue de l'Hippodrome\n\nOrganisiert von TAC Cyclotourisme"
        ],
        "en": [
          "Sunday April 19, 2026\n4 Seasons Ride\n3 routes of 30km, 60km and 90km\nDeparture between 7am and 10am avenue de l'Hippodrome\n\nOrganized by TAC Cyclotourisme"
        ],
        "it": [
          "Domenica 19 aprile 2026\nGiro delle 4 stagioni\n3 percorsi di 30 km, 60 km e 90 km\nPartenza tra le 7.00 e le 10.00 dall'avenue de l'Hippodrome\n\nOrganizzato da TAC Cyclotourisme"
        ],
        "fr": [
          "Dimanche 19 avril 2026\nRandonnée des 4 saisons\n3 parcours de 30km, 60km et 90km\nDépart entre 7h et 10h avenue de l'Hippodrome\n\nOrganisée par le TAC Cyclotourisme"
        ],
        "nl": [
          "Zondag 19 april 2026\n4 seizoenen rit\n3 routes van 30km, 60km en 90km\nVertrek tussen 7 en 10 uur vanaf de Hippodroomlaan\n\nGeorganiseerd door TAC Cyclotourisme"
        ],
        "es": [
          "Domingo 19 de abril de 2026\n4 estaciones\n3 recorridos de 30km, 60km y 90km\nSalida entre las 7h y las 10h de la avenida del Hipódromo\n\nOrganizado por TAC Cyclotourisme"
