  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/43f1a472-e4eb-3270-be1b-70ce53f17d6d",
      "dc:description": {
        "de": [
          "Das größte gravierte Denkmal der Welt gibt auf fast 300 Metern die Namen der 580.000 Soldaten, Krankenschwestern und Hilfsarbeiter aller Nationalitäten wieder, die während des Ersten Weltkriegs in Flandern und im Artois gefallen sind."
        ],
        "en": [
          "The world's largest engraved memorial, covering almost 300 meters, lists the names of the 580,000 soldiers, nurses and auxiliary workers of all nationalities who fell in Flanders and Artois during the First World War."
        ],
        "it": [
          "Il più grande memoriale inciso del mondo, che si estende per quasi 300 metri, elenca i nomi dei 580.000 soldati, infermieri e lavoratori ausiliari di tutte le nazionalità caduti nelle Fiandre e nell'Artois durante la Prima Guerra Mondiale."
        ],
        "fr": [
          "Le plus grand mémorial gravé au monde reprend sur près de 300 mètres, les noms des 580 000 soldats, infirmières, travailleurs auxiliaires, de toutes nationalités, tombés en Flandres et en Artois pendant la Première Guerre mondiale."
        ],
        "nl": [
          "Het grootste gegraveerde monument ter wereld, dat bijna 300 meter beslaat, somt de namen op van de 580.000 soldaten, verpleegsters en hulpverleners van alle nationaliteiten die tijdens de Eerste Wereldoorlog in Vlaanderen en Artois zijn gesneuveld."
        ],
        "es": [
          "El monumento grabado más grande del mundo, con casi 300 metros de extensión, recoge los nombres de los 580.000 soldados, enfermeros y auxiliares de todas las nacionalidades que cayeron en Flandes y Artois durante la Primera Guerra Mundial."
        ]
      },
      "@type": [
        "Description"
      ],
