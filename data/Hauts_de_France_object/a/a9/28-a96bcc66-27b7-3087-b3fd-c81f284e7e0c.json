  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Christophe in Tourcoing ist ein symbolträchtiges Gebäude, das gotische und neugotische Stilelemente miteinander verbindet und durch sein großes Kirchenschiff und seine Glasmalereien auffällt. Ein unumgänglicher Ort des architektonischen Erbes der Stadt."
    ],
    "en": [
      "Tourcoing?s Saint-Christophe church is an emblematic building combining Gothic and Neo-Gothic styles, remarkable for its large nave and stained glass windows. An essential part of the town's architectural heritage."
    ],
    "it": [
      "La chiesa Saint-Christophe di Tourcoing è un edificio simbolo che combina gli stili gotico e neogotico, notevole per la sua grande navata e le sue vetrate. È una parte essenziale del patrimonio architettonico della città."
    ],
    "fr": [
      "L’église Saint-Christophe de Tourcoing est un édifice emblématique mêlant styles gothique et néogothique, remarquable par sa grande nef et ses vitraux. Un lieu incontournable du patrimoine architectural de la ville."
    ],
    "es": [
      "La iglesia Saint-Christophe de Tourcoing es un edificio emblemático que combina los estilos gótico y neogótico y destaca por su gran nave y sus vidrieras. Forma parte esencial del patrimonio arquitectónico de la ciudad."
    ],
    "nl": [
      "De Saint-Christophe kerk van Tourcoing is een monumentaal gebouw dat gotische en neogotische stijlen combineert en opmerkelijk is vanwege het grote schip en de gebrandschilderde ramen. Een essentieel onderdeel van het architecturale erfgoed van de stad."
    ]
  },
