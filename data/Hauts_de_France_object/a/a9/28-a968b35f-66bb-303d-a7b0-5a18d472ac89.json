      "dc:description": {
        "de": [
          "Eine Art-Déco-Fassade, 4 klimatisierte Säle empfangen Sie für einen Moment der Entspannung. Popcorn in der Hand, entdecken Sie die Neuheiten der 7. Kunst!"
        ],
        "en": [
          "An art deco facade, 4 air-conditioned rooms welcome you for a moment of relaxation. Popcorn in hand, discover the latest in 7th art!"
        ],
        "it": [
          "Con una facciata art déco, 4 camere climatizzate vi accolgono per un momento di relax. Popcorn alla mano, scoprite le nuove uscite della settima arte!"
        ],
        "fr": [
          "Une façade art déco, 4 salles climatisées vous accueillent pour un moment de détente. Pop-corn en main, découvrez les nouveautés du 7ème art !"
        ],
        "es": [
          "Una fachada art decó, 4 habitaciones con aire acondicionado le dan la bienvenida para un momento de relajación. Palomitas en mano, ¡descubre las novedades del séptimo arte!"
        ],
        "nl": [
          "Een art deco gevel, 4 kamers met airconditioning verwelkomen u voor een moment van ontspanning. Popcorn in de hand, ontdek de nieuwe releases van de 7e kunst!"
        ]
