  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9355ebfc-a31b-38ba-88a6-fc1b185425c0",
      "dc:description": {
        "de": [
          "Das neue Restaurant Papi Henri ist während der Sperrzeit dienstags bis samstags von 12 bis 14 Uhr und von 18.30 bis 20.30 Uhr für den Verkauf zum Mitnehmen geöffnet.\nBestellungen können Sie entweder telefonisch unter 09 86 33 97 66 ( ab 10 Uhr ab morgen ) oder auf der Facebook-Seite von Papi Henri aufgeben."
        ],
        "en": [
          "The new restaurant Papi Henri is open for take away sale during the confinement from Tuesday to Saturday from 12 to 2 pm and from 6.30 to 8.30 pm.\nOrders are to be placed either by phone at 09 86 33 97 66 (from 10am tomorrow) or on the Facebook page of Papi Henri."
        ],
        "it": [
          "Il nuovo ristorante Papi Henri è aperto per l'asporto durante la chiusura dal martedì al sabato dalle 12:00 alle 14:00 e dalle 18:30 alle 20:30.\nLe ordinazioni possono essere effettuate telefonicamente al numero 09 86 33 97 66 (da domani alle 10) o sulla pagina Facebook di Papi Henri."
        ],
        "fr": [
          "Le nouveau restaurant Papi Henri est ouvert en vente à emporter pendant le confinement du mardi au samedi de 12h à 14h et de 18h30 à 20h30.\nLes commandes sont à passer soit par téléphone au 09 86 33 97 66 ( à partir de 10h dès demain ) ou sur la page Facebook de Papi Henri."
        ],
        "nl": [
          "Het nieuwe restaurant Papi Henri is tijdens de afsluiting geopend voor afhaalmaaltijden van dinsdag tot en met zaterdag van 12.00 tot 14.00 uur en van 18.30 tot 20.30 uur.\nBestellen kan telefonisch op 09 86 33 97 66 (vanaf morgen 10 uur) of via de Facebookpagina van Papi Henri."
        ],
        "es": [
          "El nuevo restaurante Papi Henri está abierto para llevar durante el cierre de martes a sábado de 12 a 14 horas y de 18.30 a 20.30 horas.\nLos pedidos pueden hacerse por teléfono en el 09 86 33 97 66 (a partir de mañana a las 10:00 horas) o en la página de Facebook de Papi Henri."
        ]
      },
