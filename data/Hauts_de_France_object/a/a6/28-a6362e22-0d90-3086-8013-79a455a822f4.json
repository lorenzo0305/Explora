  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Sammlung Jacquemart André, die aus mehr als 6000 Kunstwerken, Möbeln, Gemälden, Skulpturen, ... besteht, und die Sammlung Jean-Jacques Rousseau, eine der bedeutendsten Sammlungen über den französischen Philosophen.\n\nEin historischer, künstlerischer und natürlicher Besuch!"
    ],
    "en": [
      "Discover the Jacquemart André Collection composed of more than 6000 works of art, furniture, paintings, sculptures, ... and the Jean-Jacques Rousseau Collection, one of the most important collections on the French philosopher.\n\nA historical, artistic and natural visit!"
    ],
    "it": [
      "Scoprite la Collezione Jacquemart André, composta da oltre 6.000 opere d'arte, mobili, dipinti, sculture, ecc. e la Collezione Jean-Jacques Rousseau, una delle più importanti collezioni sul filosofo francese.\n\nUna visita storica, artistica e naturale!"
    ],
    "fr": [
      "Découvrez la Collection Jacquemart André composée de plus de 6000 oeuvres d'art, mobilier, peintures, sculptures, ... et la Collection Jean-Jacques Rousseau, l'une des plus importantes collections sur le philosophe français.\n\nUne visite historique, artistique et naturelle !"
    ],
    "nl": [
      "Ontdek de Collectie Jacquemart André, bestaande uit meer dan 6000 kunstwerken, meubels, schilderijen, beelden, enz. en de Collectie Jean-Jacques Rousseau, een van de belangrijkste collecties over de Franse filosoof.\n\nEen historisch, artistiek en natuurlijk bezoek!"
    ],
    "es": [
      "Descubra la Colección Jacquemart André, compuesta por más de 6.000 obras de arte, muebles, pinturas, esculturas, etc., y la Colección Jean-Jacques Rousseau, una de las más importantes sobre el filósofo francés.\n\nUna visita histórica, artística y natural"
    ]
  },
