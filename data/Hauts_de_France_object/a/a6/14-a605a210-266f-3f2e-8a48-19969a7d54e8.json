        "de": [
          "Ganzes Geflügel, Geflügelteilstücke, gebratenes Geflügel, Eier<br> Denken Sie daran, Ihren Besuch anzukündigen!"
        ],
        "en": [
          "Whole poultry, poultry cuts, roast poultry, eggs<br>Please remember to warn of your visit!"
        ],
        "it": [
          "Pollame intero, tagli di pollame, pollame arrosto, uova<br>Per favore, fateci sapere quando venite!"
        ],
        "fr": [
          "Volaille entière, découpe de volaille, volaille rôtie, oeufs<br>Pensez à prévenir de votre visite !"
        ],
        "nl": [
          "Geheel gevogelte, stukken gevogelte, gebraden gevogelte, eieren<br>Laat ons weten wanneer u komt!"
        ],
        "es": [
          "Aves enteras, cortes de aves, aves asadas, huevos<br>¡Por favor, avísanos cuando vengas!"
        ]
