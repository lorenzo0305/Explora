  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eeb9b211-908f-30d8-85e5-be3e16a87719",
      "dc:description": {
        "de": [
          "Fahren Sie mit unseren Fahrrädern mit elektrischer Unterstützung oder testen Sie unser Tandem, indem Sie unsere Fahrradrouten oder die Vélomaritime nutzen! Unsere Routen finden Sie unter www.lesdeuxcaps.fr."
        ],
        "en": [
          "Take a ride on our electrically-assisted bicycles or try out our tandem bikes on our cyclos or Vélomaritime itineraries! See our itineraries at www.lesdeuxcaps.fr."
        ],
        "it": [
          "Fate un giro sulle nostre biciclette a pedalata assistita o provate il nostro tandem percorrendo i nostri itinerari ciclistici o Vélomaritime! Per saperne di più sui nostri percorsi, visitate il sito www.lesdeuxcaps.fr."
        ],
        "fr": [
          "Baladez vous avec nos vélos à Assistance électrique ou testez notre tandem en empruntant nos itinéraires cyclos ou la Vélomaritime ! Retrouvez nos itinéraires sur www.lesdeuxcaps.fr."
        ],
        "nl": [
          "Maak een ritje op onze elektrisch ondersteunde fietsen of probeer onze tandem uit door onze cyclos of Vélomaritime routes te nemen! Ontdek meer over onze routes op www.lesdeuxcaps.fr."
        ],
        "es": [
          "Dé un paseo en nuestras bicicletas con asistencia eléctrica o pruebe nuestro tándem realizando una de nuestras rutas ciclistas o Vélomaritime Más información sobre nuestras rutas en www.lesdeuxcaps.fr."
        ]
      },
