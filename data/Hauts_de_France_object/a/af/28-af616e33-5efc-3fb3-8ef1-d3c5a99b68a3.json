  "rdfs:comment": {
    "de": [
      "Gefiel: Die außergewöhnliche Aussicht vom Panoramarestaurant auf die Rennstrecke und die Kathedrale von Amiens."
    ],
    "en": [
      "You'll love the panoramic restaurant's exceptional view of the runway and Amiens Cathedral."
    ],
    "it": [
      "Il ristorante panoramico vi regalerà una vista eccezionale sulla pista e sulla cattedrale di Amiens."
    ],
    "fr": [
      "Vous aimerez : la vue exceptionnelle sur la piste et la Cathédrale d’Amiens depuis le restaurant panoramique."
    ],
    "es": [
      "Le encantará la excepcional vista de la pista y de la catedral de Amiens desde el restaurante panorámico."
    ],
    "nl": [
      "Je zult dol zijn op het uitzonderlijke uitzicht op de landingsbaan en de kathedraal van Amiens vanuit het panoramische restaurant."
