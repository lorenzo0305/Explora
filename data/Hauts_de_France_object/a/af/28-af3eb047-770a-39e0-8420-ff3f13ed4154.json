  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet eine hausgemachte Küche mit frischen Zutaten.\nDie Getreidebörse bietet Ihnen Themenabende oder Leinwandübertragungen von Sportereignissen."
    ],
    "en": [
      "The restaurant offers home cooking using fresh produce.\nLa Bourse aux grains offers themed evenings and screenings of sporting events."
    ],
    "it": [
      "Il ristorante propone una cucina casalinga a base di prodotti freschi.\nLa Bourse aux grains propone serate a tema e proiezioni di eventi sportivi."
    ],
    "fr": [
      "Le restaurant propose une cuisine maison avec des produits frais.\nLa Bourse aux grains vous propose des soirées à thème ou des retransmissions sur écran d'événements sportifs."
    ],
    "nl": [
      "Het restaurant serveert huisgemaakte gerechten met verse producten.\nLa Bourse aux grains biedt thema-avonden en vertoningen van sportevenementen."
    ],
    "es": [
      "El restaurante sirve cocina casera elaborada con productos frescos.\nLa Bourse aux grains ofrece veladas temáticas y proyecciones de eventos deportivos."
    ]
  },
