  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/813a2ebf-62d0-3e5b-b03b-ff516323cebb",
      "dc:description": {
        "de": [
          "Kommen Sie und probieren Sie unsere Spezialität: \"La pavé crémeux\"\nÖffnungszeiten:\n- Montag bis Samstag: 6:45-12:30 Uhr und 16:00-19:30 Uhr\n- sonntag: 6:45-13:00 Uhr und 16:00-19:30 Uhr\nMittwoch geschlossen"
        ],
        "en": [
          "Come and taste our speciality: \"La pavé crémeux\"\nOpening hours:\n- Monday to Saturday: 6h45-12h30 and 16h-19h30\n- sunday: 6h45-13h and 16h-19h30\nClosed on Wednesday"
        ],
        "it": [
          "Venite a provare la nostra specialità: \"La pavé crémeux\"\nOrari di apertura :\n- Dal lunedì al sabato: dalle 6.45 alle 12.30 e dalle 16.00 alle 19.30\n- domenica: 6.45-13.00 e 16.00-19.30\nChiuso il mercoledì"
        ],
        "fr": [
          "Venez goûter notre spécialité : \"La pavé crémeux\"\nHoraire : \n- Du lundi au samedi : 6h45-12h30 et de 16h-19h30\n- le dimanche: 6h45-13h et de 16h-19h30\nFermé le mercredi"
        ],
        "es": [
          "Venga a probar nuestra especialidad: \"La pavé crémeux\" (adoquines cremosos)\nHorario de apertura :\n- De lunes a sábado: de 6h45 a 12h30 y de 16h00 a 19h30\n- domingo: de 6h45 a 13h00 y de 16h00 a 19h30\nMiércoles cerrado"
        ],
        "nl": [
          "Kom en probeer onze specialiteit: \"La pavé crémeux\" (romige kasseien)\nOpeningstijden :\n- Maandag tot zaterdag: 6u45-12u30 en 16u-19u30\n- zondag: 18.45-13.00 en 16.00-19.30\nGesloten op woensdag"
        ]
      },
