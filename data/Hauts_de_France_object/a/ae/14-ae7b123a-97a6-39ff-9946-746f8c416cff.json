  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/92fdff35-d5f9-31a9-97f4-89ce772013b2",
      "dc:description": {
        "de": [
          "Divernia Festival\nFreitag um 20 Uhr & Samstag, 4. April um 19 Uhr\nSaal Raymond Dufour, Desvres\nFreier Eintritt\n\nGenießen Sie zwei Abende voller Musik und guter Stimmung! Lassen Sie sich das nicht entgehen!\n\n,"
        ],
        "en": [
          "Divernia Festival\nFriday, 8pm & Saturday, April 4, 7pm\nSalle Raymond Dufour, Desvres\nFree admission\n\nCome and enjoy two evenings of music and fun! Don't miss out!\n\n,"
        ],
        "it": [
          "Divernia Festival\nVenerdì 20.00 e sabato 4 aprile 19.00\nSala Raymond Dufour, Desvres\nIngresso libero\n\nVenite a godervi due serate di musica e divertimento! Non mancate!\n\n,"
        ],
        "fr": [
          "Divernia Festival\nVendredi à 20h & Samedi 4 avril à 19h\nSalle Raymond Dufour, Desvres\nEntrée gratuite\n\nVenez profiter de deux soirées de musique et de bonne ambiance ! Ne manquez pas ça !\n\n,"
        ],
        "es": [
          "Festival Divernia\nViernes 20.00 h y sábado 4 de abril 19.00 h\nSala Raymond Dufour, Desvres\nEntrada gratuita\n\nVenga a disfrutar de dos veladas de música y diversión ¡No se lo pierda!\n\n,"
        ],
        "nl": [
          "Divernia Festival\nVrijdag 20.00 uur & zaterdag 4 april 19.00 uur\nZaal Raymond Dufour, Desvres\nGratis toegang\n\nKom twee avonden genieten van muziek en plezier! Mis het niet!\n\n,"
        ]
      },
