  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9f52f901-e792-3a4a-8e20-2167b9e8e531",
      "dc:description": {
        "de": [
          "7 Forellenangelstrecken 3 gemeinsame Teiche plus 4 für Ihre Familienreservierungen<br>Empfang Betriebsrat Gruppen, Freundschaften.<br>Tische und Grill zur Verfügung.<br>"
        ],
        "en": [
          "7 trout fishing runs 3 shared ponds plus 4 for your family reservations<br>Works council, groups and associations welcome.<br>Tables and barbecue available.<br>"
        ],
        "it": [
          "7 percorsi di pesca alla trota 3 laghetti condivisi più 4 per prenotazioni familiari<br>Consiglio di lavoro, gruppi e associazioni benvenuti <br>Tavoli e barbecue a disposizione.<br>"
        ],
        "fr": [
          "7 parcours de pêche à la truites 3 étangs en commun plus 4 pour vos réservations en famille<br>Accueil Comité d’entreprise groupes, amicales.<br>Tables et barbecue à disposition.<br>"
        ],
        "nl": [
          "7 forelviscursussen 3 gedeelde vijvers plus 4 voor familieboekingen<br>Werkgroepen, groepen en verenigingen welkom <br>Tafels en barbecue beschikbaar.<br>"
        ],
        "es": [
          "7 cursos de pesca de truchas 3 estanques compartidos más 4 para reservas familiares<br>Consejo de obras, grupos y asociaciones bienvenidos<br>Mesas y barbacoa disponibles.<br>"
        ]
      },
