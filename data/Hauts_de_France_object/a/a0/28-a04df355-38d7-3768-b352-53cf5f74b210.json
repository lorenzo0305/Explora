  "rdfs:comment": {
    "de": [
      "Da das Spahi-Regiment 30 Jahre lang in Senlis Garnison gehalten hat, gibt es keine bessere Stadt, um das Leben der Spahis, der einheimischen Kavallerietruppen der französischen Armee, zu entdecken."
    ],
    "en": [
      "The Spahis regiment having been garrisoned for 30 years in Senlis, what better city to discover the life of the Spahis, these indigenous cavalry troops of the French army."
    ],
    "it": [
      "Poiché il reggimento Spahis è stato presidiato per 30 anni a Senlis, quale città migliore per scoprire la vita degli Spahis, le truppe di cavalleria indigene dell'esercito francese."
    ],
    "fr": [
      "Le régiment des Spahis ayant tenu garnison pendant 30 ans à Senlis, quelle meilleure ville pour découvrir la vie des Spahis, ces troupes de cavalerie indigène de l'armée française."
    ],
    "es": [
      "Como el regimiento Spahis estuvo de guarnición durante 30 años en Senlis, qué mejor ciudad para descubrir la vida de los Spahis, las tropas de caballería autóctonas del ejército francés."
    ],
    "nl": [
      "Aangezien het regiment Spahis 30 jaar lang in Senlis was gelegerd, is er geen betere stad om het leven van de Spahis, de inheemse cavalerietroepen van het Franse leger, te ontdekken."
    ]
  },
