  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/be5d41ca-a1c4-3096-a711-08d9c8e4e1f1",
      "dc:description": {
        "de": [
          "Die Stadt Hénin-Beaumont lädt Sie im Februar 2025 zur 8. Ausgabe des Hénin Rock ein! Am ersten Abend des Hénin Rock Festival 2025 finden Sie die Tribute von Green Day und Fall Out Boy."
        ],
        "en": [
          "The town of Hénin-Beaumont looks forward to seeing you in February 2025 for the 8th edition of Hénin Rock! The first evening of the Hénin Rock Festival 2025 will feature tributes from Green Day and Fall Out Boy."
        ],
        "it": [
          "La città di Hénin-Beaumont vi aspetta nel febbraio 2025 per l'ottava edizione di Hénin Rock! La prima serata dell'Hénin Rock Festival 2025 sarà caratterizzata dai tributi dei Green Day e dei Fall Out Boy."
        ],
        "fr": [
          "La ville d'Hénin-Beaumont vous donne rendez-vous en février 2025 pour la 8ème édition du Hénin Rock ! Pour la première soirée du Hénin Rock Festival 2025, retrouvez les tributes de Green Day et Fall Out Boy."
        ],
        "es": [
          "La ciudad de Hénin-Beaumont te espera en febrero de 2025 para la 8ª edición del Hénin Rock La primera noche del Festival Hénin Rock 2025 contará con los tributos de Green Day y Fall Out Boy."
        ],
        "nl": [
          "De stad Hénin-Beaumont kijkt uit naar jullie komst in februari 2025 voor de 8e editie van Hénin Rock! Op de eerste avond van het Hénin Rock Festival 2025 staan hommages van Green Day en Fall Out Boy op het programma."
        ]
      },
