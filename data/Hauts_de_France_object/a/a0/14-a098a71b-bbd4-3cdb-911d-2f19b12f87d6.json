      "dc:description": {
        "de": [
          "Bäckerei, Konditorei und Teestube montags bis samstags außer mittwochs von 7:30 bis 13:00 Uhr und von 15:00 bis 19:30 Uhr und sonntags von 7:30 bis 13:00 Uhr geöffnet."
        ],
        "en": [
          "Bakery, patisserie and tearoom open Monday to Saturday except Wednesday, 7.30am to 1pm and 3pm to 7.30pm and Sunday 7.30am to 1pm."
        ],
        "it": [
          "Panetteria, pasticceria e sala da tè aperte dal lunedì al sabato, tranne il mercoledì, dalle 7.30 alle 13.00 e dalle 15.00 alle 19.30 e la domenica dalle 7.30 alle 13.00."
        ],
        "fr": [
          "Boulangerie, pâtisserie et salon de thé ouvert du lundi au samedi sauf le mercredi de 7h30 à 13h et de 15h à 19h30 et le dimanche de 7h30 à 13h."
        ],
        "es": [
          "Panadería, pastelería y salón de té abierto de lunes a sábado, excepto los miércoles, de 7.30 a 13.00 y de 15.00 a 19.30, y los domingos de 7.30 a 13.00."
        ],
        "nl": [
          "Bakkerij, patisserie en tearoom geopend van maandag tot zaterdag behalve woensdag, 7.30 tot 13.00 en 15.00 tot 19.30 en zondag 7.30 tot 13.00."
        ]
      },
