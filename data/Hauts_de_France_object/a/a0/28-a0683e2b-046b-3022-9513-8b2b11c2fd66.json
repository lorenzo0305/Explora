      "dc:description": {
        "de": [
          "Kommen Sie in das Estaminet de Marc in Marly-Gomont und entdecken Sie ein vielfältiges und geselliges Musikprogramm!\n\nAm 19. September findet um 21 Uhr ein Konzert von Rosedale statt!"
        ],
        "en": [
          "Come to Marc?s Estaminet in Marly-Gomont to discover a varied and convivial musical program!\n\nOn September 19, join us at 9pm for a concert by Rosedale!"
        ],
        "it": [
          "Venite al Marc's Estaminet di Marly-Gomont per un programma di musica vario e amichevole!\n\nIl 19 settembre, alle ore 21.00, unisciti a noi per un concerto di Rosedale!"
        ],
        "fr": [
          "Venez à l’Estaminet de Marc à Marly-Gomont pour découvrir une programmation musicale variée et conviviale !\n\nLe 19 septembre , rendez-vous à 21h pour assister au concert de Rosedale !"
        ],
        "es": [
          "Venga al Estaminet Marc de Marly-Gomont y disfrute de un programa musical variado y agradable\n\nEl 19 de septiembre, a las 21:00 h, concierto de Rosedale"
        ],
        "nl": [
          "Kom naar Marc's Estaminet in Marly-Gomont voor een gevarieerd en gezellig muziekprogramma!\n\nKom op 19 september om 21u naar een concert van Rosedale!"
        ]
      },
