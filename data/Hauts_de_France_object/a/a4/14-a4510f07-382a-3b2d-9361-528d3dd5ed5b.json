  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8ac5f0b4-51c5-3be5-bc75-a8d1cef562ec",
      "dc:description": {
        "de": [
          "In einer gemütlichen Umgebung am Fuße der Artois-Hügel bietet das Relais Campagnard ein Restaurant mit hausgemachten Gerichten und Vorspeisen aus Qualitätsprodukten und Fleisch aus Frankreich!"
        ],
        "en": [
          "In a warm setting at the foot of the Artois hills, the relais campagnard is a restaurant offering home-made dishes and starters made with quality produce and meats of French origin!"
        ],
        "it": [
          "In un ambiente accogliente ai piedi delle colline dell'Artois, il Relais Campagnard è un ristorante che serve piatti e antipasti fatti in casa con prodotti e carni di qualità provenienti dalla Francia!"
        ],
        "fr": [
          "Dans un cadre chaleureux au pied des collines d'Artois, le relais campagnard est un restaurant proposant des plats et entrées fais maison avec des produits de qualité et des viandes d’origine française !"
        ],
        "nl": [
          "In een warme omgeving aan de voet van de heuvels van de Artois serveert Relais Campagnard huisgemaakte gerechten en voorgerechten met kwaliteitsproducten en vlees uit Frankrijk!"
        ],
        "es": [
          "En un cálido entorno a los pies de las colinas de Artois, el Relais Campagnard es un restaurante que sirve platos caseros y entrantes elaborados con productos de calidad y carnes de Francia"
        ]
      },
