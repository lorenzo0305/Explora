  "rdfs:comment": {
    "de": [
      "Eine entspannte Atmosphäre, eine kleine Tapas- und Cocktailbar, in der man sich wohlfühlt.\r\nEine Dekoration im Vintage- und Berg-Stil mit einem Hauch von Kitsch, geblümten Teppichen und bequemen Clubsofas."
    ],
    "en": [
      "A relaxed atmosphere, a small tapas and cocktail bar where you feel good. \r\nA vintage & mountain decoration with kitsch touches with floral carpeting and comfortable club sofas."
    ],
    "it": [
      "Un'atmosfera rilassata, un piccolo tapas e cocktail bar dove ci si sente bene. \r\nUna decorazione vintage e montana con tocchi kitsch, tappeti fioriti e comodi divani club."
    ],
    "fr": [
      "Une atmosphère décontractée, un petit bar à tapas et cocktails où l’on s’y sent bien. \r\nUne décoration vintage & montagnarde aux touches kitsch assumées avec de la moquette fleurie et des confortables canapés club."
    ],
    "es": [
      "Un ambiente relajado, un pequeño bar de tapas y cócteles donde uno se siente como en casa.\r\nDecoración vintage y montañesa con un toque kitsch, alfombras florales y cómodos sofás club."
    ],
    "nl": [
      "Een ontspannen sfeer, een kleine tapas- en cocktailbar waar je je meteen thuis voelt.\r\nVintage en bergdecor met een vleugje kitsch, bloementapijten en comfortabele clubbanken."
    ]
  },
