  "rdfs:comment": {
    "de": [
      "Vom Dorf Les Gets aus, am unteren Ende der Cabri-Piste, folgen Sie der Route bis zum Gipfel des Mont Chéry, wo Sie einen herrlichen Blick auf die Mont-Blanc-Kette genießen können."
    ],
    "en": [
      "From the village of Les Gets, at the bottom of the Cabri piste, follow the route to the summit of Mont Chéry, where you can enjoy breathtaking views of the Mont Blanc range."
    ],
    "it": [
      "Dal villaggio di Les Gets, in fondo alla pista Cabri, si segue l'itinerario fino alla cima del Mont Chéry, da cui si gode di una vista mozzafiato sulla catena del Monte Bianco."
    ],
    "fr": [
      "En partant du village des Gets, au bas de la piste Cabri, suivez l’itinéraire jusqu’au sommet du Mont Chéry, où vous profiterez d’une vue imprenable sur la chaîne du Mont Blanc."
    ],
    "nl": [
      "Vanuit het dorp Les Gets, onderaan de Cabri piste, volg je de route naar de top van de Mont Chéry, waar je kunt genieten van een adembenemend uitzicht op de Mont Blanc bergketen."
    ],
    "es": [
      "Desde el pueblo de Les Gets, al pie de la pista Cabri, siga el itinerario hasta la cima del Mont Chéry, donde podrá disfrutar de unas vistas impresionantes del macizo del Mont Blanc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Montée du Chéry"
    ]
  },
