  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant - Pizzeria vor Ort und zum Mitnehmen (Pizza nur abends).\r\nEmpfang und Qualität für das Vergnügen, an einem geselligen und lokalen Ort zu essen.\r\nPizza aus dem Holzofen, Hamburger, Tagesmenü und Vorschläge des Küchenchefs."
    ],
    "en": [
      "Traditional Restaurant - Pizzeria on site and to take away (pizza only in the evening).\r\nWelcome and quality for the pleasure of eating in a friendly and local place.\r\nWood-fired pizza, Hamburger, daily menu and chef's suggestions.\r\nOur carefully chosen wine list awaits you to properly accompany your dishes.\r\nPleased to welcome you."
    ],
    "it": [
      "Ristorante tradizionale - Pizzeria da mangiare o da portare via (pizza solo la sera).\r\nAccoglienza e qualità per il piacere di mangiare in un luogo accogliente e locale.\r\nPizza cotta a legna, Hamburger, Menu del giorno e proposte dello chef."
    ],
    "fr": [
      "Restaurant Traditionnel - Pizzeria sur place et à emporter (pizza uniquement le soir).\r\nAccueil et qualité pour le plaisir de manger dans un lieu convivial et local.\r\nPizza au feu de bois, Hamburger, Menu du jour et suggestions du chef."
    ],
    "nl": [
      "Traditioneel restaurant - Pizzeria om te eten of af te halen (pizza alleen 's avonds).\r\nWelkom en kwaliteit voor het plezier van eten in een vriendelijke, lokale plaats.\r\nHoutgestookte pizza, hamburger, dagmenu en suggesties van de chef."
    ],
    "es": [
      "Restaurante tradicional - Pizzería para comer en el restaurante o para llevar (pizza sólo por la noche).\r\nAcogida y calidad por el placer de comer en un lugar acogedor y local.\r\nPizza a la leña, Hamburguesa, Menú del día y sugerencias del chef."
    ]
  },
  "rdfs:label": {
