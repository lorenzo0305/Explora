  "rdfs:comment": {
    "de": [
      "Keramikerinnen, Malerinnen, Textil- und Papiergestalterinnen haben beschlossen, ihre Werke und ihr Wissen zusammenzubringen, um Kunst und Handwerk zu fördern."
    ],
    "en": [
      "Ceramists, painters, textile and paper designers have decided to pool their work and knowledge to promote arts and crafts."
    ],
    "it": [
      "Ceramisti, pittori, designer di tessuti e carta hanno deciso di unire il loro lavoro e le loro conoscenze per promuovere l'artigianato artistico."
    ],
    "fr": [
      "Céramistes, peintres, créatrices textile et papier ont décidé de rassembler leurs œuvres et leurs connaissances pour promouvoir l’art et l’artisanat."
    ],
    "nl": [
      "Keramisten, schilders, textiel- en papierontwerpers hebben besloten hun werk en kennis te bundelen om kunst en ambacht te promoten."
    ],
    "es": [
      "Ceramistas, pintores, diseñadores textiles y de papel han decidido poner en común su trabajo y sus conocimientos para promover el arte y la artesanía."
    ]
  },
  "rdfs:label": {
