  "rdfs:comment": {
    "de": [
      "Wir sind zwei Partner, ein Paar, und haben uns entschieden, Züchter/Verarbeiter zu sein. Um uns beruflich zu entfalten, haben wir uns für die biologische Landwirtschaft entschieden. Entdecken Sie unseren Hof bei Besichtigungen und alle unsere Milchprodukte."
    ],
    "en": [
      "We are 2 partners, a couple, who have decided to be breeders/processors. In order to fulfill our professional potential, we have opted for organic farming. Come and discover our farm and all our dairy products."
    ],
    "it": [
      "Siamo due soci, una coppia, e abbiamo deciso di fare gli allevatori/trasformatori. Per realizzare il nostro potenziale professionale, abbiamo optato per l'agricoltura biologica. Venite a scoprire la nostra azienda e tutti i nostri prodotti caseari."
    ],
    "fr": [
      "Nous sommes 2 associés, en couple, nous avons décidés d'être éleveurs / transformateurs, afin de nous épanouir professionnellement, nous avons opté pour l'agriculture biologique. Venez découvrir notre ferme lors des visites et tous nos produits laitiers."
    ],
    "nl": [
      "We zijn 2 partners, een koppel, en we hebben besloten om fokkers/verwerkers te worden. Om ons professionele potentieel te vervullen, hebben we gekozen voor biologische landbouw. Kom en ontdek onze boerderij en al onze zuivelproducten."
    ],
    "es": [
      "Somos 2 socios, una pareja, y hemos decidido ser ganaderos/transformadores. Para realizar nuestro potencial profesional, hemos optado por la agricultura ecológica. Venga a descubrir nuestra granja y todos nuestros productos lácteos."
    ]
  },
  "rdfs:label": {
