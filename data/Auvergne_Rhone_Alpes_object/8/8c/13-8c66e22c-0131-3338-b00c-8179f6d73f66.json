  "rdfs:comment": {
    "de": [
      "Das 11 ha große Weingut wird seit vier Generationen von der Familie AUJOGUE bewirtschaftet. Es befindet sich in Jarnioux und gehört zum Schloss. Der Weinkeller ist 300 m vom Schloss entfernt mit einer wunderbaren Umgebung, ganz aus goldenen Steinen."
    ],
    "en": [
      "The 11 ha estate has been run for 4 generations by the AUJOGUE family. It is located in Jarnioux and belongs to the Château. The winery is 300 m from the castle with a wonderful setting, all in golden stones."
    ],
    "it": [
      "La tenuta di 11 ettari, gestita da 4 generazioni dalla famiglia AUJOGUE, si trova a Jarnioux e appartiene allo Château. La cantina si trova a 300 m dallo château e ha una splendida cornice, tutta in pietra dorata."
    ],
    "fr": [
      "Le domaine de 11 ha est exploité depuis 4 générations par la famille AUJOGUE, elle se situe à Jarnioux et appartient au Château. Le cuvage est à 300 m du château avec un cadre merveilleux, tout en pierres dorées."
    ],
    "nl": [
      "Het landgoed van 11 hectare wordt al 4 generaties gerund door de familie AUJOGUE, het ligt in Jarnioux en behoort tot het Château. Het wijnhuis ligt op 300 m van het château en heeft een prachtige omgeving, helemaal in goudkleurige steen."
    ],
    "es": [
      "Esta finca de 11 hectáreas, gestionada desde hace 4 generaciones por la familia AUJOGUE, está situada en Jarnioux y pertenece al Château. La bodega se encuentra a 300 m del château y tiene un entorno maravilloso, todo en piedra dorada."
    ]
  },
