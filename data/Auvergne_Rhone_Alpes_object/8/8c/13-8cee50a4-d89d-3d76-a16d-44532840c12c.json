  "rdfs:comment": {
    "de": [
      "16.00-17.45 Uhr: Spaziergang mit Lesungen von John Berger, ausgewählt von M. Desbiolles und getragen von C. Buès. Wanderung 45 Minuten. 10?\r\n21h: Lesung zum Thema Pastoralismus mit Violaine Bérot und Elsa Sanial, Autorinnen und Viehzüchterinnen. 15?; 7.50?."
    ],
    "en": [
      "16h-17h45: Walk punctuated by readings by John Berger, chosen by M. Desbiolles and carried by C. Buès. Walk 45min. 10?\r\n9pm: Pastoral readings with Violaine Bérot and Elsa Sanial, authors and breeders. 15?; 7.50?."
    ],
    "it": [
      "16h-17h45: passeggiata scandita da letture di John Berger, scelte da M. Desbiolles e guidate da C. Buès. Passeggiata di 45 minuti. 10?\r\n21.00: Letture sulla pastorizia con Violaine Bérot ed Elsa Sanial, autrici e allevatrici. 15?; 7.50?."
    ],
    "fr": [
      "16h-17h45 : Balade ponctuée par des lectures de John Berger, choisies par M. Desbiolles et portées par C. Buès. Marche 45min. 10€\r\n21h : Lecture autour du pastoralisme avec Violaine Bérot et Elsa Sanial, autrices et éleveuses. 15€; 7.50€."
    ],
    "nl": [
      "16u-17u45: Wandeling onderbroken door lezingen van John Berger, gekozen door M. Desbiolles en geleid door C. Buès. Wandeling van 45 minuten. 10?\r\n21u: Lezingen over herderschap met Violaine Bérot en Elsa Sanial, auteurs en fokkers. 15?; 7.50?."
    ],
    "es": [
      "16h-17h45: Paseo jalonado por lecturas de John Berger, elegidas por M. Desbiolles y dirigidas por C. Buès. Paseo de 45 minutos. 10?\r\n21h: Lecturas sobre pastoralismo con Violaine Bérot y Elsa Sanial, autoras y ganaderas. 15?; 7.50?."
    ]
  },
