  "rdfs:comment": {
    "de": [
      "Real Mexican Street Food im Herzen der Stadt Annecy, testen Sie echte mexikanische Tacos, unsere köstlichen Big Burritos und die besten Quesadillas, hausgemacht und hecho con amor."
    ],
    "en": [
      "Real Mexican Street Food in the heart of Annecy, come and try real Mexican tacos, our delicious big Burritos and the best quesadillas, home made and hecho con amor."
    ],
    "it": [
      "Il vero street food messicano nel cuore di Annecy, venite a provare i nostri veri tacos messicani, i nostri deliziosi burritos e le migliori quesadillas, fatte in casa e hecho con amor."
    ],
    "fr": [
      "Real Mexican Street Food au cœur de la ville d’Annecy, venez tester des veritables tacos mexicains, nos délicieux big Burritos et les meilleures quesadillas, fait maison et hecho con amor."
    ],
    "nl": [
      "Real Mexican Street Food in het hart van de stad Annecy, kom en probeer echte Mexicaanse taco's, onze heerlijke grote Burritos en de beste quesadillas, huisgemaakt en hecho con amor."
    ],
    "es": [
      "Auténtica comida callejera mexicana en el corazón de Annecy, ven a probar nuestros auténticos tacos mexicanos, nuestros deliciosos y grandes Burritos y las mejores quesadillas, caseras y hechas con amor."
    ]
  },
