  "rdfs:comment": {
    "de": [
      "Das CCAS und die Association Culturelle & Sociale de Chanteuges bieten 10 Sitzungen zur Gedächtnisarbeit an, die für alle offen sind.  Die Anzahl der Teilnehmer ist begrenzt. Kostenlos für Chanteugeois."
    ],
    "en": [
      "The CCAS and the Association Culturelle & Sociale de Chanteuges are offering 10 memory work sessions, open to all.  The number of participants is limited. Free for Chanteuges residents."
    ],
    "it": [
      "Il CCAS e l'Association Culturelle & Sociale de Chanteuges propongono 10 sessioni sulla memoria, aperte a tutti.  Il numero di partecipanti è limitato. Gratuite per i residenti di Chanteuges."
    ],
    "fr": [
      "Le CCAS et l'Association Culturelle & Sociale de Chanteuges proposent 10 séances de travail sur la mémoire, ouvertes à tous.  Le nombre de participants est limité. Gratuit pour les chanteugeois."
    ],
    "es": [
      "La CCAS y la Association Culturelle & Sociale de Chanteuges proponen 10 sesiones sobre la memoria, abiertas a todos.  El número de participantes es limitado. Gratuito para los residentes en Chanteuges."
    ],
    "nl": [
      "Het CCAS en de Association Culturelle & Sociale de Chanteuges bieden 10 sessies over het geheugen, voor iedereen toegankelijk.  Het aantal deelnemers is beperkt. Gratis voor inwoners van Chanteuges."
    ]
