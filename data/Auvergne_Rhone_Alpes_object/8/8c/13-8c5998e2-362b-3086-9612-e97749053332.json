  "rdfs:comment": {
    "de": [
      "In der Bresse, nur zwei Schritte von Burgund entfernt, in der Nähe von Mâcon, bietet Ihnen La Huchette eine charmante Schlemmerpause, nur 3 Stunden von Paris oder Orange und 1 Stunde von Genf entfernt."
    ],
    "en": [
      "In Bresse, 2 steps from Burgundy, near Mâcon, La Huchette offers a charming stop just 3 hours from Paris or Orange and 1 hour from Geneva."
    ],
    "it": [
      "Nella Bresse, vicino alla Borgogna, nei pressi di Mâcon, La Huchette vi offre una sosta gastronomica ricca di fascino a sole 3 ore da Parigi o Orange e a 1 ora da Ginevra."
    ],
    "fr": [
      "En Bresse, à 2 pas de la Bourgogne, près de Mâcon, La Huchette vous propose une halte gourmande et pleine de charme à seulement 3h de Paris ou d'Orange et à 1h  de Genève."
    ],
    "nl": [
      "In Bresse, op een steenworp van Bourgondië, vlakbij Mâcon, biedt La Huchette een gastronomische tussenstop vol charme, op slechts 3 uur van Parijs of Orange en 1 uur van Genève."
    ],
    "es": [
      "En Bresse, cerca de Borgoña, cerca de Mâcon, La Huchette le ofrece una escala gastronómica llena de encanto a sólo 3 horas de París u Orange y 1 hora de Ginebra."
    ]
  },
