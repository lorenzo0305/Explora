  "rdfs:comment": {
    "de": [
      "Charles und Ninon treffen sich im Stadtzentrum von Bonneville, um auf spielerische Weise einen wichtigen Platz zu entdecken: den Rathausplatz. Diese Schnitzeljagd ist für die Kleinsten konzipiert: ab 4 Jahren."
    ],
    "en": [
      "Play with Charles and Ninon in the city center of Bonneville to discover an important place : the City Center square. This paper chase is for the youngest : 4 years old"
    ],
    "it": [
      "Unitevi a Charles & Ninon nel centro di Bonneville per scoprire in modo giocoso un luogo importante: la Place de l'Hôtel de ville. Questa caccia al tesoro è pensata per i bambini a partire dai 4 anni."
    ],
    "fr": [
      "Retrouvez Charles & Ninon au centre ville de Bonneville pour une découverte ludique d'une place importante: la Place de l'Hôtel de ville. Ce jeu de piste est conçu pour les plus petits : à parti de 4 ans."
    ],
    "nl": [
      "Vergezel Charles & Ninon in het centrum van Bonneville voor een ludieke ontdekking van een belangrijke plaats: het Place de l'Hôtel de ville. Deze speurtocht is bedoeld voor kinderen vanaf 4 jaar."
    ],
    "es": [
      "Acompañe a Charles & Ninon en el centro de Bonneville para descubrir de forma lúdica un lugar importante: la plaza del hotel de la ciudad. Esta búsqueda del tesoro está diseñada para niños a partir de 4 años."
    ]
  },
  "rdfs:label": {
    "en": [
      "Paper chase with Charles and Ninon"
    ],
    "fr": [
      "Jeu de piste : \"Autour de la place de l'Hôtel de ville avec Charles et Ninon\""
    ]
  },
