  "rdfs:comment": {
    "de": [
      "Eine Mediathek ist eine kulturelle Einrichtung, die eine Sammlung von Dokumenten aufbewahrt und der Öffentlichkeit zur Verfügung stellt, die sich auf verschiedenen Trägern befinden (Bücher aller Art, Schallplatten, Zeitschriften...)"
    ],
    "en": [
      "A media library is a cultural establishment that preserves and makes available to the public a collection of documents in a variety of formats (books of all kinds, records, magazines, etc.)"
    ],
    "it": [
      "Una mediateca è un istituto culturale che conserva e mette a disposizione del pubblico una raccolta di documenti in diversi formati (libri di ogni genere, dischi, riviste, ecc.)"
    ],
    "fr": [
      "Une médiathèque est un établissement culturel qui conserve et met à la disposition du public une collection de documents qui figurent sur des supports variés (livres en tout genre, disque, revue...)"
    ],
    "es": [
      "Una mediateca es un establecimiento cultural que conserva y pone a disposición del público una colección de documentos en diversos formatos (libros de todo tipo, discos, revistas, etc.)"
    ],
    "nl": [
      "Een mediatheek is een culturele instelling die een verzameling documenten in verschillende formaten (allerlei soorten boeken, platen, tijdschriften, enz.) bewaart en ter beschikking stelt van het publiek"
    ]
  },
