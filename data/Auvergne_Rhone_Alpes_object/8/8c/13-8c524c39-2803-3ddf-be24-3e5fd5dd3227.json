  "rdfs:comment": {
    "de": [
      "La ferme de Gaston ist ein familiengeführter Bio-Bauernhof, auf dem Sie eine Freiland-Schweinezucht sowie Kaninchen und Bienen finden - eine wahre Oase der Ruhe!"
    ],
    "en": [
      "La ferme de Gaston is a family-run, organic farm where you'll find free-range pork, rabbits and bees - a true haven of peace!"
    ],
    "it": [
      "La fattoria di Gaston è un'azienda agricola biologica a conduzione familiare, dove troverete maiali, conigli e api all'aperto: un'oasi di pace!"
    ],
    "fr": [
      "La ferme de Gaston est une ferme familiale et biologique où vous y retrouverez un élevage de porc en plein air, ainsi que des lapins et des abeilles, c'est un véritable havre de paix !"
    ],
    "es": [
      "La granja de Gastón es una granja ecológica familiar donde encontrarás cerdos, conejos y abejas criados en libertad: ¡es un remanso de paz!"
    ],
    "nl": [
      "Gaston's boerderij is een biologisch familiebedrijf waar je scharrelvarkens, konijnen en bijen vindt - een oase van rust!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de Gaston"
    ]
  },
