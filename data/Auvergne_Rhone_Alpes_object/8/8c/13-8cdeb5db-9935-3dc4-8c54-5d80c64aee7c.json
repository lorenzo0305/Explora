  "rdfs:comment": {
    "de": [
      "Die Wand von Mont-Blanc Escalade, das sind 100 Routen, von 4 bis 8b, mit mehr als 15 neuen Routen jeden Monat.\r\nMaterialverleih - Einführungskurse für Kinder und Erwachsene - Privatunterricht"
    ],
    "en": [
      "Mont-Blanc Escalade has 100 routes, ranging from 4 to 8b, with over 15 new routes every month.\r\nEquipment rental - Introductory courses for children and adults - Private lessons"
    ],
    "it": [
      "Mont-Blanc Escalade offre 100 percorsi, dal 4 all'8b, con più di 15 nuovi percorsi ogni mese.\r\nNoleggio attrezzatura - Lezioni introduttive per bambini e adulti - Lezioni private"
    ],
    "fr": [
      "Le mur de Mont-Blanc Escalade, ce sont 100 voies, allant du 4 au 8b, avec plus de 15 nouveaux tracés chaque mois.\r\nLocation de matériel - Cours initiation enfant et adulte - Cours privés"
    ],
    "es": [
      "Mont-Blanc Escalade cuenta con 100 rutas, de 4 a 8b, con más de 15 rutas nuevas cada mes.\r\nAlquiler de material - Clases de iniciación para niños y adultos - Clases particulares."
    ],
    "nl": [
      "De Mont-Blanc Escalade wand heeft 100 routes, van 4 tot 8b, met elke maand meer dan 15 nieuwe routes.\r\nVerhuur van materiaal - Initiatiecursussen voor kinderen en volwassenen - Privélessen"
    ]
  },
