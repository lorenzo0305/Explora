  "rdfs:comment": {
    "de": [
      "Gourmetküche und intime Atmosphäre, nur wenige Schritte von der Cité judiciaire in Clermont-Ferrand entfernt.\r\nEine Adresse, die seit 2013 mit dem Michelin Bib Gourmand ausgezeichnet ist!"
    ],
    "en": [
      "Gourmet cuisine and intimate atmosphere, close to the judicial city of Clermont-Ferrand.\r\nAn address with the Bib Gourmand Michelin award since 2013!"
    ],
    "it": [
      "Cucina gourmet e atmosfera intima, a due passi dal distretto giudiziario di Clermont-Ferrand.\r\nUn indirizzo premiato con il Bib Gourmand Michelin dal 2013!"
    ],
    "fr": [
      "Cuisine gourmande et ambiance intimiste, à deux pas de la cité judiciaire de Clermont-Ferrand.\r\nUne adresse au palmarès Bib Gourmand Michelin depuis 2013 !"
    ],
    "nl": [
      "Een gastronomische keuken en een intieme sfeer, op een steenworp afstand van het gerechtelijk arrondissement van Clermont-Ferrand.\r\nEen adres dat sinds 2013 bekroond is met de Michelin Bib Gourmand!"
    ],
    "es": [
      "Cocina gastronómica y ambiente íntimo, a un paso del distrito judicial de Clermont-Ferrand.\r\n¡Una dirección que ha sido galardonada con el Michelin Bib Gourmand desde 2013!"
    ]
  },
