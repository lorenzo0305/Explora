  "rdfs:comment": {
    "de": [
      "Ein Restaurant im Herzen der Vulkane, regionale und traditionelle Küche.\r\nZwei Optionen stehen zur Verfügung: Selbstbedienung zum Mittagessen (Salate, regionale Gerichte) für Einzelpersonen oder Tischservice für Gruppen nach Voranmeldung (Mittag- und Abendessen)."
    ],
    "en": [
      "Regional and traditional cuisine."
    ],
    "it": [
      "Ristorante nel cuore dei vulcani, con cucina regionale e tradizionale.\r\nSelf-service a pranzo (insalate, piatti regionali) per singoli o servizio al tavolo per gruppi su prenotazione (pranzo e cena)."
    ],
    "fr": [
      "Un restaurant au cœur des volcans, cuisine régionale et traditionnelle. \r\nLibre-service le midi (salades, plats régionaux) pour les individuels ou service sur table pour les groupes sur réservation (midi et soir)."
    ],
    "es": [
      "Restaurante en el corazón de los volcanes, con cocina regional y tradicional.\r\nAutoservicio al mediodía (ensaladas, platos regionales) para particulares o servicio de mesa para grupos previa reserva (almuerzo y cena)."
    ],
    "nl": [
      "Een restaurant in het hart van de vulkanen, met een regionale en traditionele keuken.\r\nZelfbediening tijdens de lunch (salades, regionale gerechten) voor individuen of bediening aan tafel voor groepen op afspraak (lunch en diner)."
    ]
  },
  "rdfs:label": {
