  "rdfs:comment": {
    "de": [
      "Gemüse, das in Permakultur angebaut wird, ohne zu pflügen oder zu bewässern, aus alten und reproduzierbaren Samen. Eine seltene Produktion, die Sie im Direktverkauf oder auf dem Markt in Vals am Sonntag entdecken können."
    ],
    "en": [
      "Vegetables grown using permaculture methods, without ploughing or watering, from ancient, reproducible seeds. A rare production to be discovered by direct sale or at the Vals market on Sundays."
    ],
    "it": [
      "Ortaggi coltivati con metodi di permacultura, senza aratura né irrigazione, da semi antichi e riproducibili. Questi prodotti rari possono essere acquistati direttamente o al mercato di Vals la domenica."
    ],
    "fr": [
      "Des légumes cultivés en permaculture, sans labour ni arrosage, à partir de graines anciennes et reproductibles. Une production rare à découvrir en vente directe ou au marché de Vals, le dimanche."
    ],
    "es": [
      "Hortalizas cultivadas con métodos de permacultura, sin arar ni regar, a partir de semillas antiguas y reproducibles. Estos productos poco comunes pueden comprarse directamente o en el mercado de Vals los domingos."
    ],
    "nl": [
      "Groenten geteeld met permacultuurmethoden, zonder ploegen of water geven, van oude, reproduceerbare zaden. Deze zeldzame producten kunnen rechtstreeks worden gekocht of op de markt van Vals op zondag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Paradis de la Permaculture"
    ]
  },
