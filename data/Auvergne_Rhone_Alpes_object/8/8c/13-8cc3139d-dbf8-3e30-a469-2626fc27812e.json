  "rdfs:comment": {
    "de": [
      "Der neue Salle de la Mémoire bietet einen Raum, der der Ausstellung von historischen Archiven, Zeugnissen und Erzählungen gewidmet ist. Diese illustrieren die prägenden Ereignisse, die Malleval en Vercors und seine Umgebung geprägt haben."
    ],
    "en": [
      "The new Salle de la Mémoire offers a space dedicated to exhibiting historical archives, testimonials and stories, illustrating the key events that have shaped Malleval en Vercors and the surrounding area."
    ],
    "it": [
      "La nuova Salle de la Mémoire è uno spazio dedicato all'esposizione di archivi storici, testimonianze e storie che illustrano gli eventi chiave che hanno caratterizzato Malleval en Vercors e la zona circostante."
    ],
    "fr": [
      "La nouvelle Salle de la Mémoire offre un espace dédié à l'exposition d'archives historiques, de témoignages et de récits, illustrant les événements marquants qui ont façonné Malleval en Vercors et ses environs."
    ],
    "es": [
      "La nueva Salle de la Mémoire es un espacio dedicado a la exposición de archivos históricos, testimonios y relatos que ilustran los acontecimientos clave que dieron forma a Malleval en Vercors y sus alrededores."
    ],
    "nl": [
      "De nieuwe Salle de la Mémoire is een ruimte gewijd aan het tentoonstellen van historische archieven, ooggetuigenverslagen en verhalen die de belangrijkste gebeurtenissen in Malleval en Vercors en omgeving illustreren."
    ]
  },
