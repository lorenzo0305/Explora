  "rdfs:comment": {
    "de": [
      "Familienrestaurant seit 1989, Für den Sommer schöne Terrasse mit Springbrunnen, für den Winter großer Saal mit sonniger Veranda, aufrichtige Küche mit dem Einfallsreichtum von 3 Generationen, frische Produkte, kurze Wege, Niedertemperaturgaren"
    ],
    "en": [
      "Nice terrace, fountain, large sunny veranda, authentic cuisine with the inventiveness of 3 generations. Fresh and local products. Slow   cooking, catering service and groups, birthday cakes and a large choice of dishes to take away or being delivered."
    ],
    "it": [
      "Ristorante a conduzione familiare dal 1989, per l'estate bella terrazza con fontana, per l'inverno ampia sala con veranda soleggiata, cucina sincera con l'inventiva di 3 generazioni, prodotti freschi, cortocircuiti, cottura a bassa temperatura"
    ],
    "fr": [
      "Restaurant familiale depuis 1989, Pour l'été jolie terrasse avec fontaine, pour l'hiver grande salle avec véranda ensoleillée, cuisine sincère avec l'inventivité de 3 générations, produits frais,  circuits courts, cuisson basse température"
    ],
    "es": [
      "Restaurante familiar desde 1989, para el verano agradable terraza con fuente, para el invierno gran sala con veranda soleada, cocina sincera con la inventiva de 3 generaciones, productos frescos, circuitos cortos, cocina a baja temperatura"
    ],
    "nl": [
      "Mooi terras, fontein, grote zonnige veranda, eerlijke keuken met de creativiteit van 3 generaties, verse producten met directe verkoop, op lage temperaturen bereid, cateringservice, ontvangst van groepen, verjaardagstaarten, ruime keuze uit maaltijden die bezorgd of afgehaald kunnen worden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge du Petit Bistrot"
    ],
    "fr": [
