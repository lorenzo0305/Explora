  "rdfs:comment": {
    "de": [
      "Der Ausstellungsraum ist ein Ort der Begegnung zwischen Künstlern und Besuchern und bietet Amateuren und Profis die Möglichkeit, ihre Gefühle und ihr Talent mit dem Publikum zu teilen."
    ],
    "en": [
      "Exhibitions, touchpad, model, movies, so many possibilities to make you discover Taninges."
    ],
    "it": [
      "Luogo di incontro tra artisti e visitatori, la sala espositiva permette a dilettanti e professionisti di condividere con il pubblico le proprie emozioni e il proprio talento."
    ],
    "fr": [
      "Lieu de rencontre entre artiste et visiteurs, la salle d’exposition permet aux amateurs et aux professionnels de partager leurs émotions et leur talent avec le public."
    ],
    "es": [
      "Lugar de encuentro de artistas y visitantes, la sala de exposiciones permite a aficionados y profesionales compartir con el público sus emociones y su talento."
    ],
    "nl": [
      "De tentoonstellingsruimte is een ontmoetingsplaats voor kunstenaars en bezoekers en biedt amateurs en professionals de mogelijkheid om hun emoties en talent met het publiek te delen."
    ]
  },
