  "rdfs:comment": {
    "de": [
      "Die Ferme du Becadou bietet Ihnen: Tomme fermière, Käse aus Mégevette, Raclette, Tomme blanche, Serac.\r\nAber auch Fleischpakete von Färsen und Milchkälbern. Honig und Eier.\r\nWurstwaren von Kühen und Trockenfleisch"
    ],
    "en": [
      "La Ferme du Becadou offers: farmhouse tomme cheese, Mégevette cheese, raclette cheese, white tomme cheese, serac cheese.\r\nBut also packages of meat from heifers and milk-fed calves. Honey and eggs.\r\nCow sausages and dried meat."
    ],
    "it": [
      "La Ferme du Becadou offre tomme di fattoria, formaggio Mégevette, raclette, tomme bianco e serac.\r\nPacchetti di carne di giovenca e vitelli da latte. Miele e uova.\r\nSalsicce di mucca e carne secca"
    ],
    "fr": [
      "La Ferme du Becadou vous propose : tomme fermière, fromage de Mégevette, raclette, tomme blanche, serac.\r\nMais aussi des colis de viande de génisses et veaux de lait. Miels et oeufs.\r\nSaucissons de vaches et viande sechee"
    ],
    "es": [
      "La Ferme du Becadou ofrece tomme de granja, queso Mégevette, raclette, tomme blanc y serac.\r\nPaquetes de carne de ternera y terneros lechales. Miel y huevos.\r\nEmbutidos de vaca y carne seca"
    ],
    "nl": [
      "La Ferme du Becadou biedt boerderij tomme, Mégevette kaas, raclette, witte tomme en serac.\r\nPakketten met vlees van vaarzen en met melk gevoede kalveren. Honing en eieren.\r\nWorst van de koe en gedroogd vlees"
    ]
  },
