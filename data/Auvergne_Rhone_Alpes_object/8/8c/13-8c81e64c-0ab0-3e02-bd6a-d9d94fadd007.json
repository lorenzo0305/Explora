  "rdfs:comment": {
    "de": [
      "Adam Pasquier hat sich in einer alten traditionellen Scheune in der Auvergne niedergelassen und bereitet eine einfache Küche mit lokalen Produkten aus dem kurzen Kreislauf der Saison zu."
    ],
    "en": [
      "Housed in an old traditional Auvergne barn, Adam Pasquier concocts a simple cuisine using local, seasonal produce."
    ],
    "it": [
      "In un vecchio fienile tradizionale dell'Alvernia, Adam Pasquier prepara una cucina semplice con prodotti locali del circuito breve e di stagione."
    ],
    "fr": [
      "Installée dans une ancienne grange traditionnelle auvergnate, Adam Pasquier vous concocte une cuisine simple avec des produits locaux issus du circuit court et de saison."
    ],
