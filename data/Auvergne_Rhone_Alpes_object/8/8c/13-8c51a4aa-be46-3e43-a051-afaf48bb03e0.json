  "rdfs:comment": {
    "de": [
      "Das 155 Steakhouse im Herzen von Avoriaz ist ein Restaurant für Fleischliebhaber. Entdecken Sie hier fein ausgewählte Stücke, leckere Beilagen und eine gepflegte Weinbar. Südterrasse und gemütliches Ambiente ."
    ],
    "en": [
      "155 Steakhouse, in the heart of Avoriaz, is the go-to restaurant for meat lovers. Enjoy finely selected cuts, gourmet sides, and a refined wine bar. With a sunny south-facing terrace and a warm atmosphere, it’s the perfect spot for an unforgettable meal in the mountains."
    ],
    "it": [
      "155 Steakhouse, nel cuore di Avoriaz, è il ristorante per gli amanti della carne. Scoprite tagli di carne finemente selezionati, contorni gourmet e un'enoteca ben fornita. Terrazza esposta a sud e atmosfera accogliente."
    ],
    "fr": [
      "Le 155 Steakhouse, en plein cœur d’Avoriaz, est le restaurant dédié aux amateurs de viande. Découvrez des pièces finement sélectionnées, des accompagnements gourmands et un bar à vin soigné. Terrasse plein sud et ambiance chaleureuse ."
    ],
    "nl": [
      "155 Steakhouse, midden in het hart van Avoriaz, is het restaurant voor echte vleesliefhebbers. Ontdek zorgvuldig geselecteerde stukken vlees, heerlijke bijgerechten en een verzorgde wijnbar. Geniet op het zuidelijke terras in een warme sfeer van een onvergetelijke maaltijd in de bergen."
    ],
    "es": [
      "155 Steakhouse, en el corazón de Avoriaz, es el restaurante para los amantes de la carne. Descubra cortes de carne finamente seleccionados, guarniciones gourmet y una vinoteca bien surtida. Terraza orientada al sur y ambiente acogedor."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le 155 Steakhouse Restaurant"
    ],
    "fr": [
      "Restaurant Le 155 Steakhouse"
    ],
    "nl": [
      "Restaurant Le 155 Steakhouse"
    ]
  },
