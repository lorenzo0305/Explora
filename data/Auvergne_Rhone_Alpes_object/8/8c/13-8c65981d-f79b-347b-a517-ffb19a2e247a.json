  "rdfs:comment": {
    "de": [
      "Weinbar in einem gemütlichen Raum, wo Sie, umgeben von Flaschen, Bretter mit lokalen Produkten zusammen mit einer Auswahl an Weinen im Glas, alkoholfreien Getränken, Tee oder Kaffee genießen können."
    ],
    "en": [
      "Wine bar in a convivial space, where, surrounded by bottles, you can enjoy boards of local produce accompanied by a selection of wines by the glass, soft drinks, tea or coffee."
    ],
    "it": [
      "Un'accogliente enoteca dove gustare una selezione di prodotti locali, vino al bicchiere, bibite, tè o caffè, circondati da bottiglie."
    ],
    "fr": [
      "Bar à vin dans un espace convivial, où, entourés de bouteilles, vous pouvez savourer des planches de produits locaux accompagnés d’une sélection de vins au verre, de boissons non-alcoolisées, de thé ou de café."
    ],
    "es": [
      "Un agradable bar de vinos donde podrá disfrutar de una selección de productos locales, vino por copas, refrescos, té o café, rodeado de botellas."
    ],
    "nl": [
      "Een gezellige wijnbar waar je kunt genieten van een selectie lokale producten, wijn per glas, frisdrank, thee of koffie, omringd door flessen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Autour d'un verre bar à vin"
    ]
  },
