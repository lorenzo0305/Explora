  "rdfs:comment": {
    "de": [
      "Chatuzange le Goubet liegt zwischen den Alpen und dem Mittelmeer, 20 km von Valence (Tor zur Provence) entfernt und am Fuße des Regionalparks Vercors. Chatuzange le Goubet besteht aus vier Weilern: Pizançon, Papelissier, le Goubet und Chatuzange."
    ],
    "en": [
      "Situated between the Alps and the Mediterranean, 20km from Valence (gateway to Provence) and at the foot of the Vercors Regional Park, Chatuzange le Goubet is made up of 4 hamlets: Pizançon, Papelissier, le Goubet and Chatuzange."
    ],
    "it": [
      "Situata tra le Alpi e il Mediterraneo, a 20 km da Valence (porta della Provenza) e ai piedi del Parco Regionale del Vercors, Chatuzange le Goubet è composta da 4 frazioni: Pizançon, Papelissier, le Goubet e Chatuzange."
    ],
    "fr": [
      "Située entre Alpes et Méditerranée, à 20km de Valence (porte de Provence) et au pied du Parc Régional du Vercors, Chatuzange le Goubet est composé de 4 hameaux : Pizançon, Papelissier, le Goubet et Chatuzange."
    ],
    "es": [
      "Situado entre los Alpes y el Mediterráneo, a 20 km de Valence (puerta de la Provenza) y a los pies del Parque Regional de Vercors, Chatuzange le Goubet se compone de 4 aldeas: Pizançon, Papelissier, le Goubet y Chatuzange"
    ],
    "nl": [
      "Chatuzange le Goubet ligt tussen de Alpen en de Middellandse Zee, op 20 km van Valence (toegangspoort tot de Provence) en aan de voet van het regionale park Vercors. Het bestaat uit 4 gehuchten: Pizançon, Papelissier, le Goubet en Chatuzange."
    ]
  },
