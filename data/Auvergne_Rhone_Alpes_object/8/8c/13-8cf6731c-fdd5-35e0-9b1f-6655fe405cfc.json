  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Kirche aus dem 11. und 12. Jahrhundert. Ihr Glockenturm ist quadratisch mit einem Bündel von Säulchen, die für den Beginn des 13. Jahrhunderts charakteristisch sind."
    ],
    "en": [
      "Free visit of the 11th and 12th century church. Its bell tower is square with a cluster of columns characteristic of the early 13th century."
    ],
    "it": [
      "Visita gratuita della chiesa dell'XI e XII secolo. Il suo campanile è a pianta quadrata con un gruppo di colonne caratteristiche dell'inizio del XIII secolo."
    ],
    "fr": [
      "Visite libre de l'église du XIe et XIIe siècles. Son clocher est carré avec un faisceau de colonnettes caractéristiques du début du XIIIe siècle."
    ],
    "es": [
      "Visita gratuita a la iglesia de los siglos XI y XII. Su campanario es cuadrado con un conjunto de columnas característico de principios del siglo XIII."
    ],
    "nl": [
      "Gratis bezoek aan de 11e en 12e eeuwse kerk. De klokkentoren is vierkant met een cluster van zuilen die kenmerkend zijn voor het begin van de 13e eeuw."
    ]
  },
  "rdfs:label": {
