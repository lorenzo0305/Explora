  "rdfs:comment": {
    "de": [
      "Die Bibliothèque de Lyon, ein Netzwerk von 15 Bibliotheken in den 9 Arrondissements der Stadt Lyon, stellt Ihnen fast 3 Millionen Dokumente zur Verfügung. Der Eintritt ist frei und kostenlos. Zum Ausleihen von Dokumenten ist ein Abonnement erforderlich."
    ],
    "en": [
      "The Bibliothèque de Lyon, a network of 15 libraries spread across the City of Lyon's 9 arrondissements, has a collection of nearly 3 million documents. Free admission. Registration required to borrow documents."
    ],
    "it": [
      "La Biblioteca di Lione, una rete di 15 biblioteche distribuite nei 9 distretti della città di Lione, mette a disposizione quasi 3 milioni di documenti. L'ingresso è gratuito. Per prendere in prestito i documenti è necessario un abbonamento."
    ],
    "fr": [
      "La Bibliothèque de Lyon, un réseau de 15 bibliothèques réparties sur les 9 arrondissements de la Ville de Lyon met à votre disposition près de 3 millions de documents. Entrée libre et gratuite. L'abonnement est nécessaire pour emprunter des documents."
    ],
    "es": [
      "La Biblioteca de Lyon, una red de 15 bibliotecas repartidas por los 9 distritos de la ciudad de Lyon, pone a su disposición cerca de 3 millones de documentos. La entrada es gratuita. Se requiere una suscripción para tomar prestados los documentos."
    ],
    "nl": [
      "De Bibliotheek van Lyon, een netwerk van 15 bibliotheken verspreid over de 9 wijken van de stad Lyon, beschikt over bijna 3 miljoen documenten. De toegang is gratis. Voor het lenen van documenten is een abonnement vereist."
    ]
  },
