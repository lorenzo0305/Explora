  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cbd7174e-b03c-3312-9e38-fddc4558fbb3",
      "dc:description": {
        "de": [
          "Service für Unternehmen\nBNI ist ein professionelles Geschäftsnetzwerk, das auf gegenseitiger Empfehlung beruht. Wir verändern die Art und Weise, wie die Welt Geschäfte macht®!\n\nmontag bis Freitag: 9.00-12.00 Uhr / 14.00-17.00 Uhr"
        ],
        "en": [
          "Business services\nBNI is a professional business network, based on mutual recommendation. We're changing the way the world does business®!\n\nmonday to Friday: 9H00-12H00 / 14H00-17H00"
        ],
        "it": [
          "Servizi alle imprese\nBNI è una rete professionale d'affari, basata sulla raccomandazione reciproca. Stiamo cambiando il modo in cui il mondo fa affari®!\n\nda lunedì a venerdì: 9H00-12H00 / 14H00-17H00"
        ],
        "fr": [
          "Service aux entreprises\nBNI est un réseau d'affaires professionnel, basé sur la recommandation mutuelle. Nous changeons la manière dont le monde fait des affaires®!\n\ndu lundi au vendredi : 9H00-12H00 / 14H00-17H00"
        ],
        "nl": [
          "Zakelijke diensten\nBNI is een professioneel zakelijk netwerk, gebaseerd op wederzijdse aanbeveling. Wij veranderen de manier waarop de wereld zaken doet®!\n\nmaandag tot vrijdag: 9H00-12H00 / 14H00-17H00"
        ],
        "es": [
          "Servicios empresariales\nBNI es una red profesional de negocios basada en la recomendación mutua. ¡Estamos cambiando la forma en que el mundo hace negocios®!\n\nde lunes a viernes: 9H00-12H00 / 14H00-17H00"
        ]
      },
      "@type": [
        "Description"
      ],
