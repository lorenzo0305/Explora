  "rdfs:comment": {
    "de": [
      "Auf dieser Rundreise werden Sie dem Charme der malerischen Dörfer und der von Weinbergen, Obstgärten und Ackerbau geformten Landschaften verfallen."
    ],
    "en": [
      "Along the way, you'll fall under the spell of picturesque villages and landscapes sculpted by vineyards, orchards and crops."
    ],
    "it": [
      "Lungo il percorso, vi lascerete incantare da villaggi pittoreschi e paesaggi scolpiti da vigneti, frutteti e coltivazioni."
    ],
    "fr": [
      "Au fil de ce circuit vous tomberez sous le charme des villages pittoresques et des paysages sculptés par les vignobles, les vergers et les cultures."
    ],
    "es": [
      "Por el camino, caerá bajo el hechizo de pintorescos pueblos y paisajes esculpidos por viñedos, huertos y cultivos."
    ],
    "nl": [
      "Onderweg raak je in de ban van pittoreske dorpjes en landschappen met wijngaarden, boomgaarden en gewassen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit thématique - Vins et saveurs"
