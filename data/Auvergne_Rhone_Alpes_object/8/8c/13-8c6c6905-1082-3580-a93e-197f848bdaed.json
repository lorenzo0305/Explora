  "rdfs:comment": {
    "de": [
      "Kleiner, biologisch geführter Betrieb mit Beerenfrüchten und Wildsammlungen.\r\nLatitepaysanne bietet eine Reihe farbenfroher und fruchtiger Vollfruchtsorbets an.\r\nVerkostung während des Verkaufs auf dem Bauernhof von Mai bis Oktober möglich."
    ],
    "en": [
      "Small organic farm with red fruit and wild harvest.\r\nLatitepaysanne offers a range of colorful, fruity full-fruit sorbets.\r\nTastings available at farm sales from May to October."
    ],
    "it": [
      "Una piccola azienda agricola biologica che produce frutti rossi e frutti selvatici.\r\nLatitepaysanne offre una gamma di sorbetti colorati e fruttati a tutto frutto.\r\nDisponibili per la degustazione presso la fattoria da maggio a ottobre."
    ],
    "fr": [
      "Petite exploitation conduite en agriculture biologique avec production de fruits rouges et récoltes sauvages.\r\nLatitepaysanne propose une gamme de sorbet pleins fruits, coloré et fruité.\r\nDégustation possible lors de la vente à la ferme de mai à octobre."
    ],
    "es": [
      "Pequeña explotación ecológica que produce frutos rojos y silvestres.\r\nLatitepaysanne ofrece una gama de sorbetes llenos de color y fruta.\r\nSe pueden degustar en la granja de mayo a octubre."
    ],
    "nl": [
      "Een kleine biologische boerderij die rood fruit en wild fruit produceert.\r\nLatitepaysanne biedt een assortiment kleurrijke, fruitige sorbets met volle vruchten.\r\nTe proeven op de boerderij van mei tot oktober."
    ]
  },
  "rdfs:label": {
