  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Coinche-Wettbewerb teil, der vom Seniorenclub organisiert wird! Begleiten Sie uns ab 14 Uhr zu einem geselligen Nachmittag.  Melden Sie sich vor Ort an (9?) und versuchen Sie, Preise zu gewinnen, während Sie sich amüsieren!"
    ],
    "en": [
      "Join in the coinche competition organized by the Seniors' Club! Join us at 2pm for a convivial afternoon.  Register on site (9?) and try to win prizes while having fun!"
    ],
    "it": [
      "Partecipa alla gara di monete organizzata dal club degli anziani! Unisciti a noi alle 14:00 per un pomeriggio di amicizia.  Registratevi sul posto (9?) e provate a vincere dei premi divertendovi!"
    ],
    "fr": [
      "Participez au concours de coinche organisé par le club des aînés ! Rejoignez-nous dès 14h pour une après-midi conviviale.  Inscrivez-vous sur place (9€) et tentez de remporter des prix tout en vous amusant !"
    ],
    "es": [
      "¡Participa en el concurso de coinche organizado por el club de mayores! Únete a nosotros a las 14:00 para pasar una tarde amistosa.  ¡Inscríbete in situ (9?) e intenta ganar premios mientras te diviertes!"
    ],
    "nl": [
      "Doe mee aan de coinche competitie georganiseerd door de seniorenclub! Kom om 14.00 uur voor een gezellige middag.  Schrijf je ter plekke in (9?) en probeer prijzen te winnen terwijl je plezier hebt!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concours de coinche"
    ]
  },
