  "rdfs:comment": {
    "de": [
      "Regionale Gerichte (Fondues, Raclettes, Tartiflettes usw.), Diots-Spezialitäten mit Polenta und Spetzatine mit 7 Kräutern (Familienrezept).\r\nSaal und Terrasse mit Blick auf den See von Mont Cenis. Mittag- und Abendservice."
    ],
    "en": [
      "Regional dishes (fondues, raclettes, tartiflettes...), specialities of diots with polenta and spetzatine.\r\nDining room and terrace overlooking Lake Mont Cenis. Lunch and dinner service."
    ],
    "it": [
      "Piatti regionali (fondute, raclettes, tartiflettes...), specialità diots con polenta e spetzatine.\r\nSala da pranzo e terrazza con vista sul lago di Mont Cenis. Servizio a pranzo e a cena."
    ],
    "fr": [
      "Plats régionaux (fondues, raclettes, tartiflettes…), spécialités de diots à la polenta et spetzatine aux 7 herbes (recette familiale). \r\nSalle et terrasse avec vue sur le lac du Mont Cenis. Service midi et soir."
    ],
    "nl": [
      "Regionale gerechten (fondues, raclettes, tartiflettes...), specialiteiten van diots met polenta en spetzatine.\r\nEetzaal en terras met uitzicht op het meer van Mont Cenis. Lunch en diner service."
    ],
    "es": [
      "Platos regionales (fondues, raclettes, tartiflettes...), especialidades de diots con polenta y spetzatine con 7 hierbas (receta familiar).\r\nComedor y terraza con vistas al lago de Mont Cenis. Servicio de comidas y cenas."
    ]
  },
