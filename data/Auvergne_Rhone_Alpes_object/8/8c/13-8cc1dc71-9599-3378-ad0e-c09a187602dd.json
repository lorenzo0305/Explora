  "rdfs:comment": {
    "de": [
      "Das Schwimmbad Serge Buttet ist das sportlichste Schwimmbad der Region und wurde für Wettkämpfe konzipiert. Es ist mit zwei Becken ausgestattet und kann alle Arten von Besuchern empfangen: Familien, Schulen und sogar Vereine!"
    ],
    "en": [
      "Piscine Caneton: The swimming pool is 25 m long and its large bay windows open onto a landscaped park. Sports and games activities in summer."
    ],
    "it": [
      "Progettata per la competizione, la piscina Serge Buttet è la più sportiva della zona. Dotato di 2 piscine, può ospitare tutti i tipi di pubblico: famiglie, scuole e persino club!"
    ],
    "fr": [
      "Taillée pour la compétition, la piscine Serge Buttet est la piscine la plus sportive du territoire. Équipée de 2 bassins, elle peut accueillir tout type de public : familles, scolaires et même les clubs !"
    ],
    "nl": [
      "Het zwembad heeft een 25 m bad en een grote schuifpui op een mooi park. Sport en ludieke activiteiten in de zomer."
    ],
    "es": [
      "Diseñada para la competición, la piscina Serge Buttet es la más deportiva de la zona. Equipado con 2 piscinas, puede acoger a todo tipo de público: familias, colegios e incluso clubes"
    ]
  },
