  "rdfs:comment": {
    "de": [
      "Verkauf vor Ort in unserem Geschäft, aber auch über unsere Website mit Click-and-Collect möglich. Sie können eine große Auswahl an Kerzen, Raumdüften und Duftschmelzen mit über 50 angebotenen Düften entdecken!"
    ],
    "en": [
      "On-site sales in our boutique, as well as via our website with click-and-collect. You'll discover a wide range of candles, home fragrances and scented melts, with over 50 scents to choose from!"
    ],
    "it": [
      "Potete acquistare i nostri prodotti nella nostra boutique o tramite il nostro sito web con la formula \"click-and-collect\". Potrete scoprire un'ampia gamma di candele, profumi per la casa e fondenti profumati, con oltre 50 fragranze in offerta!"
    ],
    "fr": [
      "Vente sur place dans notre boutique mais également via notre site internet avec click-and-collect possible. Vous pourrez découvrir une large gamme de bougies, parfums d'ambiance et fondants parfumés avec plus de 50 parfums proposés !"
    ],
    "es": [
      "Puede comprar nuestros productos en nuestra boutique o a través de nuestro sitio web con la opción de recogida en tienda. Podrá descubrir una amplia gama de velas, fragancias para el hogar y fondants perfumados, ¡con más de 50 fragancias en oferta!"
    ],
    "nl": [
      "Je kunt onze producten kopen in onze boetiek of via onze website met click-and-collect. Je vindt er een ruim assortiment kaarsen, huisparfums en geurende fondants, met meer dan 50 geuren in de aanbieding!"
    ]
  },
