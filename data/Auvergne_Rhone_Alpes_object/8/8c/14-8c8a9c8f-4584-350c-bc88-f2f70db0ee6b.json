  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/afa8c293-0cda-3357-b5a8-a54577fb316c",
      "dc:description": {
        "de": [
          "Au Bureau, Ihre Pub Brasserie im angelsächsischen Stil, ist der perfekte Ort für Mittagessen, Aperitifs, Abendessen oder Abende mit Freunden!\nKommen Sie und teilen Sie einzigartige und gesellige Momente in Ihrem Restaurant, Au Bureau!"
        ],
        "en": [
          "Au Bureau, your Anglo-Saxon-style pub-brasserie, is the perfect place for your lunches, aperitifs, dinners or evenings out with friends!\nCome and share unique and convivial moments in your restaurant, Au Bureau!"
        ],
        "it": [
          "Au Bureau, il vostro pub brasserie in stile anglosassone, è il luogo perfetto per i vostri pranzi, aperitivi, cene o serate tra amici!\nVenite a condividere momenti unici e conviviali nel vostro ristorante, Au Bureau!"
        ],
        "fr": [
          "Au Bureau, votre pub brasserie de style anglosaxon, est le lieu parfait pour vos déjeuners, apéros, diners ou soirées entre amis !\nVenez partager des moments uniques et conviviaux dans votre restaurant, Au Bureau !"
        ],
        "nl": [
          "Au Bureau, uw brasserie in Angelsaksische stijl, is de perfecte plek voor uw lunches, aperitieven, diners of avondjes uit met vrienden!\nKom unieke en gezellige momenten delen in uw restaurant, Au Bureau!"
        ],
        "es": [
          "Au Bureau, su pub brasserie de estilo anglosajón, es el lugar perfecto para sus almuerzos, aperitivos, cenas o veladas entre amigos\n¡Venga a compartir momentos únicos y de convivencia en su restaurante, Au Bureau!"
        ]
      },
      "@type": [
        "Description"
