  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der Blutspendeaktion teil, die von der Association pour le Don du Sang Bénévole (Verein für ehrenamtliche Blutspende) organisiert wird. Treffen Sie sich von 16:00 bis 19:00 Uhr im Vereinszentrum, um eine Geste der Solidarität zu schenken und Leben zu retten."
    ],
    "en": [
      "Take part in the blood drive organized by the Association pour le Don du Sang Bénévole. Join us from 4pm to 7pm at the Pôle Associatif to offer a gesture of solidarity and save lives."
    ],
    "it": [
      "Partecipate alla raccolta di sangue organizzata dall'Association pour le Don du Sang Bénévole. Venite dalle 16.00 alle 19.00 al centro comunitario per fare un gesto di solidarietà e salvare vite umane."
    ],
    "fr": [
      "Participez à la collecte de sang organisée par l'Association pour le Don du Sang Bénévole. Rendez-vous de 16h à 19h au pôle associatif pour offrir un geste de solidarité et sauver des vies."
    ],
    "es": [
      "Participe en la campaña de donación de sangre organizada por la Association pour le Don du Sang Bénévole. Acude de 16:00 a 19:00 al centro comunitario y haz un gesto de solidaridad y salva vidas."
    ],
    "nl": [
      "Neem deel aan de bloedinzameling georganiseerd door de Association pour le Don du Sang Bénévole. Kom van 16.00 tot 19.00 uur naar het gemeenschapscentrum en maak een gebaar van solidariteit en red levens."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Don du sang"
    ]
  },
