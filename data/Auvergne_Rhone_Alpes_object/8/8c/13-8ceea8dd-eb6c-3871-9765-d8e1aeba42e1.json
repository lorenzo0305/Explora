  "rdfs:comment": {
    "de": [
      "Entfliehen Sie aufs Land und verbringen Sie schöne Stunden mit der Familie oder mit Freunden.\r\nDiese Workshops werden Groß und Klein begeistern!"
    ],
    "en": [
      "Escape to the countryside to spend some quality time with family and friends.\r\nWorkshops that will delight young and old!"
    ],
    "it": [
      "Scappate in campagna per trascorrere del tempo di qualità con la famiglia e gli amici.\r\nLaboratori che faranno la gioia di grandi e piccini!"
    ],
    "fr": [
      "Evadez vous à la campagne pour passer de bons moments en famille ou entre amis.\r\nDes ateliers qui raviront petits et grands!"
    ],
    "nl": [
