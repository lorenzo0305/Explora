  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f7f7253b-a428-3cac-a8f3-d95e76bb3720",
      "dc:description": {
        "de": [
          "Show\nKingston By Bus kommt aus verschiedenen Reggae-Bands (B-Siders Backing Band, Classics Backing Band, Reggae Warriors Band, Hope Road) und spielt die größten Songs des jamaikanischen Stars neu auf und wird Sie garantiert auf eine Reise in die Karibik mitnehmen.\n\nZuschauerzahl: 65% der Gesamtkapazität des Saals."
        ],
        "en": [
          "Show\nComing from different Reggae bands ( B-Siders Backing Band, Classics Backing band, Reggae Warriors Band, Hope Road), Kingston By Bus revisits the greatest titles of the Jamaican star and will surely take you on a trip to the Caribbean.\n\nCapacity: 65% of the total capacity of the hall."
        ],
        "it": [
          "Spettacolo\nProveniente da diversi gruppi reggae (B-Siders Backing Band, Classics Backing Band, Reggae Warriors Band, Hope Road), Kingston By Bus rivisita i più grandi successi della star giamaicana e vi porterà sicuramente in un viaggio nei Caraibi.\n\nCapacità: 65% della capacità totale del locale."
        ],
        "fr": [
          "Spectacle\nVenants de groupes Reggae différents ( B-Siders Backing Band, Classics Backing band, Reggae Warriors Band, Hope Road), Kingston By Bus revisite les plus grands titres de la star jamaïcaine et vous emmènera à coup sûr dans un voyage aux Caraïbes.\n\nJauge : 65% de la capacité totale de la salle."
        ],
        "nl": [
          "Toon\nAfkomstig van verschillende reggaegroepen (B-Siders Backing Band, Classics Backing Band, Reggae Warriors Band, Hope Road), brengt Kingston By Bus de grootste hits van de Jamaicaanse ster opnieuw en neemt je zeker mee op een reis naar het Caribisch gebied.\n\nCapaciteit: 65% van de totale zaalcapaciteit."
        ],
        "es": [
          "Mostrar\nProvenientes de diferentes bandas de reggae (B-Siders Backing Band, Classics Backing Band, Reggae Warriors Band, Hope Road), Kingston By Bus repasa los grandes éxitos de la estrella jamaicana y seguro que te lleva de viaje al Caribe.\n\nAforo: 65% del aforo total del recinto."
        ]
      },
