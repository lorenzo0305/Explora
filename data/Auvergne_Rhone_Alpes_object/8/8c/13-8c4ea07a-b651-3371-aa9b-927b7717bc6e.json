  "rdfs:comment": {
    "de": [
      "Die Auberge de Freyssenet liegt zwischen Darbres und Privas auf dem Plateau du Coiron in 800 m Höhe. Sie ist ein gemütlicher und lebendiger Ort, an dem die Ardèche mit Aufrichtigkeit gekocht wird.\nFrische, lokale und saisonale Produkte."
    ],
    "en": [
      "Situated between Darbres and Privas on the Plateau du Coiron, at an altitude of 800m, enjoy the coolness in summer and the snow in winter.\r\nOur home-cooked cuisine is traditional and local, using fresh seasonal produce. Don't forget to book!"
    ],
    "it": [
      "Situato tra Darbres e Privas, sul Plateau du Coiron, a 800 metri di altitudine, l'Auberge de Freyssenet è un luogo caldo e vivace dove l'Ardèche viene cucinata con sincerità.\nProdotti freschi, locali e di stagione."
    ],
    "fr": [
      "Située entre Darbres et Privas sur le Plateau du Coiron, à 800m d'altitude, l’Auberge de Freyssenet est un lieu chaleureux et vivant où l’on cuisine l'Ardèche avec sincérité.\nProduits frais, locaux et de saison."
    ],
    "es": [
      "Situado entre Darbres y Privas, en el Plateau du Coiron, a 800 m de altitud, el Auberge de Freyssenet es un lugar cálido y animado donde la Ardèche se cocina con sinceridad.\nProductos frescos, locales y de temporada."
    ],
    "nl": [
      "Gelegen tussen Darbres en Privas op het Plateau du Coiron, op 800m hoogte, is de Auberge de Freyssenet een warme en levendige plek waar de Ardèche met oprechtheid wordt gekookt.\nVerse, lokale en seizoensgebonden producten."
    ]
  },
