  "rdfs:comment": {
    "de": [
      "Erzeuger, Verarbeiter, Wild- und Beerenfrüchte, Gewürz- und Heilpflanzen. \r\nDirektverkauf von Konfitüren, Sirupen, Pürees, Kräuteraperitifs, Kompotten.\r\nBetrieb betreibt seit 1993 biologische Landwirtschaft."
    ],
    "en": [
      "Producers, processors, wild fruits and berries, aromatic and medicinal plants.\r\nDirect sales of jams, syrups, coulis, herbal aperitifs and compotes. Organic farming since 1993."
    ],
    "it": [
      "Agricoltori, trasformatori, frutta e bacche selvatiche, piante aromatiche e medicinali.\r\nVendita diretta di marmellate, sciroppi, coulis, aperitivi alle erbe, composte e mieli.\r\nAgricoltura biologica dal 1993."
    ],
    "fr": [
      "Agriculteurs, transformateurs, fruits sauvages et petits fruits, plantes aromatiques et médicinales. \r\nVente direct de confitures, sirops, coulis, apéritifs aux plantes, compotes, Miels.\r\nExploitation en agriculture biologique depuis 1993."
    ],
    "nl": [
      "Boeren, verwerkers, wild fruit en bessen, aromatische en medicinale planten.\r\nDirecte verkoop van jam, siroop, coulis, kruidenaperitief, compote en honing.\r\nBiologische landbouw sinds 1993."
    ],
    "es": [
      "Agricultores, transformadores, frutas y bayas silvestres, plantas aromáticas y medicinales.\r\nVenta directa de mermeladas, siropes, coulis, aperitivos de hierbas, compotas y mieles.\r\nAgricultura ecológica desde 1993."
    ]
  },
