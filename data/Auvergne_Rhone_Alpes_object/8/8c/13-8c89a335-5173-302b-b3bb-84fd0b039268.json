  "rdfs:comment": {
    "de": [
      "Snackbar, Brot und Gebäck. Pizzas aus eigener Herstellung. Burger. Salate, Quiches und salzige Tartes. Ravioligratins. Desserts aus eigener Herstellung. Nur abends und nur mit Reservierung."
    ],
    "en": [
      "Snack bar, bread and pastries. Homemade pizzas. Burgers. Salads, quiches and savoury tarts. Ravioli gratins. Home-made desserts. Evenings only and by reservation only."
    ],
    "it": [
      "Snack bar, pane e dolci. Pizze fatte in casa. Hamburger. Insalate, quiche e torte salate. Ravioli gratinati. Dolci fatti in casa. Solo la sera e su prenotazione."
    ],
    "fr": [
      "Snack-bar, pain et viennoiseries. Pizzas maison. Burgers. Salades, quiches et tartes salées. gratins de ravioles. Desserts maison. Uniquement le soir et uniquement sur réservation."
    ],
    "nl": [
      "Snackbar, brood en gebak. Huisgemaakte pizza's. Burgers. Salades, quiches en hartige taartjes. Ravioli gratins. Huisgemaakte desserts. Alleen 's avonds en alleen op reservering."
    ],
    "es": [
      "Cafetería, pan y bollería. Pizzas caseras. Hamburguesas. Ensaladas, quiches y tartas saladas. Raviolis gratinados. Postres caseros. Sólo por la noche y con reserva previa."
    ]
  },
  "rdfs:label": {
