  "rdfs:comment": {
    "de": [
      "Ein Schwimmbad mit Spiel- und Spaßbereichen, einem Entspannungsbecken und einem Wellnessbereich. Ein versenkbares Dach passt sich den Wetterbedingungen an, und zu den Außenanlagen gehört ein Bojenfluss, der allen Spaß macht."
    ],
    "en": [
      "Swimming pool with play areas and games, a relaxation pool and well-being area. Foldaway roof to suit the weather, outdoor water games and a river with rubber rings."
    ],
    "it": [
      "Una piscina con aree gioco e attività, una piscina relax e un'area benessere. Un tetto retrattile si adatta alle condizioni atmosferiche e le strutture esterne comprendono un fiume di boe per il divertimento di tutti."
    ],
    "fr": [
      "Une piscine avec des aires de jeux et d'activités ludiques, un bassin de relaxation et un espace bien-être. Un toit rétractable s'ajuste aux conditions météo, et des installations extérieures incluent une rivière à bouées pour le plaisir de tous."
    ],
    "es": [
      "Una piscina con zonas de juego y actividades, una piscina de relajación y una zona de bienestar. Un techo retráctil se ajusta a las condiciones meteorológicas, y las instalaciones exteriores incluyen un río de boyas para disfrute de todos."
    ],
    "nl": [
      "Een zwembad met speel- en activiteitenruimtes, een ontspanningsbad en een wellnessruimte. Een uitschuifbaar dak past zich aan het weer aan en de buitenfaciliteiten omvatten een rivier van boeien waar iedereen van kan genieten."
    ]
  },
  "rdfs:label": {
    "en": [
