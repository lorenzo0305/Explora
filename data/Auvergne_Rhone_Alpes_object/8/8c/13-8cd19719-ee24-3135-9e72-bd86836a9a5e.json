  "rdfs:comment": {
    "de": [
      "Produzent von handwerklich hergestellten Bieren. Unsere Biere sind in den örtlichen Geschäften oder vor Ort in unserer Brauerei erhältlich.\r\nKonzert oder Event 1 Samstagabend pro Monat mit kleinen Snacks vor Ort."
    ],
    "en": [
      "Producer of artisanal beers. Our beers are on sale in local shops or in our brewery.\r\nConcerts or events 1 Saturday evening a month, with light refreshments on site."
    ],
    "it": [
      "Produttore di birre artigianali. Le nostre birre sono in vendita nei negozi locali o nel nostro birrificio.\r\nConcerti o eventi 1 sabato sera al mese con spuntini in loco."
    ],
    "fr": [
      "Producteur de bières artisanales. Nos bières sont en vente dans les commerces locaux ou sur place dans notre brasserie.\r\nConcert ou Evènement 1 samedi soir par mois avec petite restauration sur place."
    ],
    "es": [
      "Productor de cervezas artesanales. Nuestras cervezas están a la venta en tiendas locales o en nuestra fábrica.\r\nConciertos o eventos 1 sábado al mes por la noche con aperitivos in situ."
    ],
    "nl": [
      "Producent van ambachtelijke bieren. Onze bieren zijn te koop in plaatselijke winkels of in onze brouwerij.\r\nConcerten of evenementen 1 zaterdagavond per maand met hapjes ter plaatse."
    ]
  },
  "rdfs:label": {
