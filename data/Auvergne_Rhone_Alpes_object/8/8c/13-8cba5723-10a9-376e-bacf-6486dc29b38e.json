  "rdfs:comment": {
    "de": [
      "Scène conventionnée d'intérêt national Art et Création, in der Peripherie von Clermont-Ferrand gelegen.\r\nReichhaltiges und abwechslungsreiches Programm, u. a. mit dem Festival Sémaphore en Chanson, bei dem große Namen und junge Hoffnungsträger des französischen Chansons auftreten."
    ],
    "en": [
      "Scène conventionnée d'intérêt national Art et Création, located on the outskirts of Clermont-Ferrand.\r\nA rich and varied program includes the Sémaphore en Chanson festival, which brings together big names and young hopefuls of French chanson."
    ],
    "it": [
      "Scène conventionnée d'intérêt national Art et Création, situata alla periferia di Clermont-Ferrand.\r\nUn programma ricco e variegato, tra cui il festival Sémaphore en Chanson, che riunisce alcuni dei più grandi nomi e talenti emergenti della chanson francese."
    ],
    "fr": [
      "Scène conventionnée d'intérêt national Art et Création, située dans la périphérie de Clermont-Ferrand.\r\nProgrammation riche et variée avec notamment le festival Sémaphore en Chanson qui réunit des grands noms et de jeunes espoirs de la chanson française."
    ],
    "es": [
      "Scène conventionnée d'intérêt national Art et Création, situado en las afueras de Clermont-Ferrand.\r\nUna programación rica y variada, que incluye el festival Sémaphore en Chanson, que reúne a grandes nombres y jóvenes promesas de la chanson francesa."
    ],
    "nl": [
      "Scène conventionnée d'intérêt national Art et Création, gelegen aan de rand van Clermont-Ferrand.\r\nEen rijk en gevarieerd programma, waaronder het Sémaphore en Chanson festival, dat enkele van de grootste namen en opkomende talenten in het Franse chanson samenbrengt."
    ]
  },
