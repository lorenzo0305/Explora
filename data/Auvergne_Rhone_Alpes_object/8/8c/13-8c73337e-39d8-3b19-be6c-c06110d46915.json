  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Skigebiet von La Plagne auf einem unvergesslichen Ausflug mit Freunden oder der Familie, mit den Pionieren der Schneemobiltouren, die seit 1987 im Skigebiet sind."
    ],
    "en": [
      "Come and discover the La Plagne area during an unforgettable tour with friends or family, with the snowmobile tour pioneers, in the resort since 1987."
    ],
    "it": [
      "Venite a scoprire La Plagne per una gita indimenticabile con gli amici o la famiglia, con i pionieri delle gite in motoslitta, presenti nella località dal 1987."
    ],
    "fr": [
      "Venez découvrir le domaine de La Plagne lors d’une sortie inoubliable entre copains ou en famille, avec les pionniers des sorties motoneige, sur la station depuis 1987."
    ],
    "es": [
      "Venga a descubrir La Plagne para una excursión inolvidable con amigos o en familia, con los pioneros de las excursiones en moto de nieve, presentes en la estación desde 1987."
    ],
    "nl": [
      "Kom en ontdek La Plagne voor een onvergetelijk uitje met vrienden of familie, met de pioniers van sneeuwscooter uitjes, die sinds 1987 in het resort aanwezig zijn."
    ]
  },
