  "rdfs:comment": {
    "de": [
      "Auf den Spuren von Rözo I. führt Sie dieser Gnolu Grand Chef der geschützten Räume über 3,5 km nacheinander ins Herz der Butterinsel und durch die Weinberge bis nach Semons mit einem Panoramablick auf die Rhône."
    ],
    "en": [
      "Following in the footsteps of Rözo 1st, this Gnolu Grand Chef of preserved areas will take you 3.5 km successively to the heart of the Isle du Beurre and through the vineyards to Semons with a panoramic view of the Rhône."
    ],
    "it": [
      "Seguendo le orme di Rözo I, questo Gnolu Grand Chef dei territori incontaminati vi condurrà per 3,5 km nel cuore dell'Isola del Burro e attraverso i vigneti fino a Semons con una vista panoramica sul Rodano."
    ],
    "fr": [
      "Sur les pas de Rözo 1er, ce Gnolu Grand Chef des espaces préservés vous entrainera sur 3.5 km successivement au cœur de l’ile du Beurre et au travers des vignes jusqu’à Semons avec une vue panoramique sur le Rhône."
    ],
    "es": [
      "Siguiendo los pasos de Rözo I, este Grand Chef Gnolu de zonas vírgenes le llevará en un viaje de 3,5 km sucesivamente al corazón de la Isla de la Mantequilla y a través de los viñedos hasta Semons con una vista panorámica del Ródano."
    ],
    "nl": [
      "In de voetsporen van Rözo I neemt deze Gnolu Grand Chef van ongerepte gebieden je mee op een tocht van 3,5 km achtereenvolgens naar het hart van het Botereiland en door de wijngaarden naar Semons met een panoramisch uitzicht op de Rhône."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Alône in Côte Rôtie"
    ]
  },
