  "rdfs:comment": {
    "de": [
      "In einem warmen und geselligen Rahmen bietet Ihnen die Brasserie-Pub im Stadtzentrum von Faverges 7 Tage die Woche traditionelle Speisen und Getränke. Extras: Schnellrestaurants, Terrasse, Themenabende auf Reservierung."
    ],
    "en": [
      "In a friendly atmosphere, the brasserie/pub located in Faverges town centre offers a traditional cuisine 7 days a week. The perks: fast food, patio, themed evenings by reservation."
    ],
    "it": [
      "In un ambiente caldo e accogliente, la brasserie-pub situata nel centro di Faverges offre una cucina tradizionale 7 giorni alla settimana. In più: fast food, terrazza, serate a tema su prenotazione."
    ],
    "fr": [
      "Dans un cadre chaleureux et convivial, la brasserie-pub située dans le centre ville de Faverges vous propose une restauration traditionnelle 7j/7. Les plus : restauration rapide, terrasse, soirées à thèmes sur réservation."
    ],
    "nl": [
      "In een warm en vriendelijk kader biedt de brasserie-pub in het centrum van Faverges 7 dagen per week traditionele gerechten. Plus: fastfood, terras, thema-avonden op reservering."
    ],
    "es": [
      "En un ambiente cálido y acogedor, la brasserie-pub situada en el centro de Faverges ofrece comida tradicional los 7 días de la semana. Además: comida rápida, terraza, noches temáticas bajo reserva."
    ]
  },
  "rdfs:label": {
    "en": [
