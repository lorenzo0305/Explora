  "rdfs:comment": {
    "de": [
      "Aus dieser Leidenschaft für Heilpflanzen, die ihm von seiner Großmutter Marguerite vermittelt wurde, hat Emmanuel seinen Beruf gemacht. Er lädt Sie in sein Atelier der Pflanzen ein : Les Infusions des Arves."
    ],
    "en": [
      "His grandmother was passionate with medecinal plants and she passed it on to Emmanuel, who made a living out of it. He welcomes you into his plants workshop : Les Infusions des Arves."
    ],
    "it": [
      "Questa passione per le piante medicinali, trasmessa dalla nonna Marguerite, è diventata la professione di Emmanuel. Vi invita a partecipare al suo laboratorio di piante: Les Infusions des Arves."
    ],
    "fr": [
      "De cette passion pour les plantes médicinales transmise par sa grand-mère Marguerite, Emmanuel en a fait son métier. Il vous invite dans son atelier des plantes : Les Infusions des Arves."
    ],
    "es": [
      "Esta pasión por las plantas medicinales, transmitida por su abuela Marguerite, se ha convertido en la profesión de Emmanuel. Le invita a su taller de plantas: Les Infusions des Arves."
    ],
    "nl": [
      "Emmanuel heeft zijn beroep gemaakt van de kennis over medicinale planten en kruiden die zijn grootmoeder hem heeft bij gebracht. Je kan zijn werkplaats bezoeken: De Extracten van de Arves"
    ]
  },
  "rdfs:label": {
    "en": [
      "Organic medicinal plants from Infusions des Aiguilles d'Arves"
    ],
    "fr": [
      "Plantes officinales bio des Infusions des Aiguilles d'Arves"
    ],
    "nl": [
      "Biologische geneeskrachtige planten van Infusions des Aiguilles d'Arves"
    ]
  },
