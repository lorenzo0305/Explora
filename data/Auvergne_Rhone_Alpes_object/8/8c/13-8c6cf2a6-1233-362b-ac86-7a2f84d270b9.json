  "rdfs:comment": {
    "de": [
      "Haben Sie sich schon einmal gefragt, wie die Zusammenarbeit in einem Orchester abläuft? Der Regisseur von Wir im Orchester hat sich zwischen die Notenpulte eingeschlichen, um diese Frage zu beantworten!"
    ],
    "en": [
      "Have you ever wondered what it's like to work together in an orchestra? The director of Nous l'orchestre went undercover to find out!"
    ],
    "it": [
      "Vi siete mai chiesti cosa significhi lavorare insieme in un'orchestra? Il direttore di Nous l'orchestre è andato sotto copertura per scoprirlo!"
    ],
    "fr": [
      "Vous êtes-vous déjà demandé comment se passe la collaboration au sein d'un orchestre ? Le réalisateur de Nous l'orchestre s'est infiltré entre les pupitres pour répondre à cette question !"
    ],
    "es": [
      "¿Se ha preguntado alguna vez cómo es trabajar juntos en una orquesta? El director de Nous l'orchestre se ha infiltrado para averiguarlo"
    ],
    "nl": [
      "Heb je je ooit afgevraagd hoe het is om samen te werken in een orkest? De regisseur van Nous l'orchestre ging undercover om erachter te komen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nous l'orchestre - Printemps Documentaire"
    ]
  },
