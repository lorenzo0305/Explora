  "rdfs:comment": {
    "de": [
      "Spiel um die Flucht - Escape Game.\r\nIn Teams von 2 bis 6 Spielern, die in einem Raum eingesperrt sind, haben Sie 60 Minuten Zeit, um zu fliehen.\r\nZuvor müssen Sie Hinweise sammeln und unsere Rätsel lösen!"
    ],
    "en": [
      "Escape game.\r\nIn teams of 2 to 6 players, locked in a room, you have 60 minutes to escape.\r\nBefore doing so, you'll need to gather clues and solve our riddles!"
    ],
    "it": [
      "- Gioco di fuga - Escape Game Valence.\r\nIn squadre da 2 a 6 giocatori, chiusi in una stanza, avete 60 minuti per fuggire.\r\nPrima di farlo, dovrete raccogliere indizi e risolvere i nostri enigmi!"
    ],
    "fr": [
      "- Jeu d'évasion - Escape Game Valence. \r\nEn équipe de 2 à 6 joueurs, enfermés dans une pièce, vous avez 60 min pour vous échapper. \r\nVous devrez auparavant rassembler les indices et résoudre nos énigmes !"
    ],
    "nl": [
      "Ontsnappingsspel - Escape Game.\r\nIn teams van 2 tot 6 spelers, opgesloten in een kamer, heb je 60 minuten om te ontsnappen.\r\nDaarvoor moet je aanwijzingen verzamelen en onze raadsels oplossen!"
    ],
    "es": [
      "- Juego de escape - Escape Game Valence.\r\nEn equipos de 2 a 6 jugadores, encerrados en una habitación, tenéis 60 minutos para escapar.\r\nAntes de hacerlo, tendréis que reunir pistas y resolver nuestros acertijos"
    ]
  },
