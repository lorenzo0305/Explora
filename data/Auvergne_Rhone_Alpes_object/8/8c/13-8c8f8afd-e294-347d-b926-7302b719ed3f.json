  "rdfs:comment": {
    "de": [
      "\"La Chapelle\", das Gourmetrestaurant des Château Saint-Jean unter der Leitung von Sternekoch Olivier VALADE, bietet traditionelle, einfallsreiche und raffinierte Küche in der vollständig restaurierten romanischen Kapelle aus dem 12. Jahrhundert."
    ],
    "en": [
      "\"La Chapelle\", Château Saint-Jean's gourmet restaurant run by Michelin-starred chef Olivier VALADE, offers traditional, inventive and refined cuisine in the fully restored 12th-century Romanesque chapel."
    ],
    "it": [
      "\"La Chapelle\", il ristorante gastronomico dello Château Saint-Jean gestito dallo chef stellato Olivier VALADE, offre una cucina tradizionale, inventiva e raffinata nella cappella romanica del XII secolo completamente restaurata."
    ],
    "fr": [
      "\"La Chapelle\", restaurant gastronomique du Château Saint-Jean dirigé par le chef étoilé Olivier VALADE, propose une cuisine traditionnelle, inventive et raffinée dans la chapelle romane du XIIème siècle entièrement restaurée."
    ],
    "es": [
      "\"La Chapelle\", el restaurante gastronómico del Château Saint-Jean dirigido por el chef Olivier VALADE, galardonado con una estrella Michelin, ofrece una cocina tradicional, inventiva y refinada en la capilla románica del siglo XII totalmente restaurada."
    ],
    "nl": [
      "\"La Chapelle, het gastronomische restaurant op Château Saint-Jean van de met een Michelin-ster bekroonde chef-kok Olivier VALADE, biedt een traditionele, inventieve en verfijnde keuken in de volledig gerestaureerde Romaanse kapel uit de 12e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Chapelle du Château Saint-Jean"
    ]
  },
