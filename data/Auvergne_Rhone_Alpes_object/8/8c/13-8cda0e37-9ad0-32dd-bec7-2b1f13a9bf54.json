  "rdfs:comment": {
    "de": [
      "Ecoravie ist ein partizipatives Wohnprojekt in der Gemeinde Dieulefit. : 3 Gebäude und ein Gemeinschaftshaus. Das 2. Gebäude mit 6 Wohnungen für 3 Familien und 3 Singles ist fertiggestellt: es wird seit Januar 2019 bewohnt."
    ],
    "en": [
      "Ecoravie is a participative housing project in the commune of Dieulefit. It comprises 3 buildings and a communal house. The 2nd building with 6 dwellings for 3 families and 3 singles has been completed: it has been inhabited since January 2019."
    ],
    "it": [
      "Ecoravie è un progetto di edilizia partecipativa nel comune di Dieulefit. si compone di 3 edifici e di una casa comune. Il secondo edificio con 6 abitazioni per 3 famiglie e 3 singoli è terminato: è abitato da gennaio 2019."
    ],
    "fr": [
      "Ecoravie est un projet d'habitat participatif sur la commune de Dieulefit. : 3 bâtiments et une maison commune. Le 2e bâtiment avec 6 logements pour 3 familles et 3 célibataires est terminé : il est habité depuis janvier 2019."
    ],
    "nl": [
      "Ecoravie is een participatief huisvestingsproject in de gemeente Dieulefit. Het bestaat uit 3 gebouwen en een gemeenschappelijk huis. Het 2e gebouw, met 6 woningen voor 3 gezinnen en 3 alleenstaanden, is opgeleverd en wordt sinds januari 2019 bewoond."
    ],
    "es": [
      "Ecoravie es un proyecto de vivienda participativa en la comuna de Dieulefit. consta de 3 edificios y una casa común. El 2º edificio con 6 viviendas para 3 familias y 3 individuales está terminado: está habitado desde enero de 2019."
    ]
  },
