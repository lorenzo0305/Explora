  "rdfs:comment": {
    "de": [
      "Ein großer Erholungs- und Freizeitbereich für alle in Largentière: Spielplatz, Seilbahn, Pumptrack, Boulespiel, Tischtennis, Fitness, Ladestation? Ideal für einen Moment mit der Familie oder mit Freunden!"
    ],
    "en": [
      "A large leisure and relaxation area in Largentière: playground, zip line, pumptrack, pétanque, table tennis, fitness, recharging point? Ideal for a moment with family or friends!"
    ],
    "it": [
      "Una grande area di svago e ricreazione per tutti a Largentière: parco giochi, zip line, pumptrack, pétanque, ping pong, fitness, punto di ricarica? Ideale per trascorrere del tempo con la famiglia e gli amici!"
    ],
    "fr": [
      "Un grand espace de détente et de loisirs pour tous à Largentière : aire de jeux, tyrolienne, pumptrack, pétanque, ping-pong, fitness, borne de recharge… Idéal pour un moment en famille ou entre amis !"
    ],
    "es": [
      "Un gran espacio de ocio y recreo para todos en Largentière: parque infantil, tirolina, pumptrack, petanca, ping-pong, fitness, punto de recarga.. Ideal para pasar tiempo con la familia y los amigos"
    ],
    "nl": [
      "Een groot vrijetijds- en recreatiegebied voor iedereen in Largentière: speeltuin, tokkelbaan, pumptrack, petanque, tafeltennis, fitness, oplaadpunt? Ideaal om tijd door te brengen met familie en vrienden!"
    ]
  },
  "rdfs:label": {
