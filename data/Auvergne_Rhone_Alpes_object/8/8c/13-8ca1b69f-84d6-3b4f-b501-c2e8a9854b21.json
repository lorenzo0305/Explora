  "rdfs:comment": {
    "de": [
      "Die 54. Ausgabe des Internationalen Osterturniers ist wieder da!\r\ndrei Tage voller Spiele in allen Hallen Montbrisons, voller Austausch und Spannung! Wer wird das Turnier gewinnen?\r\nUnterstützen Sie die Spieler des BCM und lernen Sie die anderen Teams kennen!"
    ],
    "en": [
      "The 54th International Easter Tournament is back!\r\n3 days of matches in all the Montbrisonnais halls, exchanges and suspense! Who will win this year's event?\r\nCome and support the BCM players and meet the other teams!"
    ],
    "it": [
      "Torna il 54° Torneo Internazionale di Pasqua!\r\n3 giorni di partite in tutte le sale di Montbris, scambi e suspense! Chi vincerà il torneo?\r\nVenite a sostenere i giocatori del BCM e a conoscere le altre squadre!"
    ],
    "fr": [
      "La 54e édition du Tournoi international de Pâques revient!\r\n3 jours de matchs dans toutes les salles montbrisonnaises, d'échanges et de suspense! Qui remportera l'édition?\r\nVenez supporter les joueurs du BCM et rencontrer les autres équipes !"
    ],
    "es": [
      "¡Vuelve el 54º Torneo Internacional de Pascua!\r\n3 días de partidos en todos los pabellones de Montbris, ¡intercambios y suspense! ¿Quién ganará el torneo?\r\n¡Ven a apoyar a los jugadores de BCM y a conocer a los demás equipos!"
    ],
    "nl": [
      "Het 54e internationale paastoernooi is terug!\r\n3 dagen vol wedstrijden in alle zalen van Montbris, uitwisselingen en spanning! Wie zal het toernooi winnen?\r\nKom de BCM spelers steunen en ontmoet de andere teams!"
    ]
  },
