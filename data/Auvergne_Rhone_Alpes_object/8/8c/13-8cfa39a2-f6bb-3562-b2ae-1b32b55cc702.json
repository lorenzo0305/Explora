  "rdfs:comment": {
    "de": [
      "Zwei Tennisplätze, die für Anhänger des gelben Balles zugänglich sind. Sie können entweder Mitglied im Club werden oder die Plätze stundenweise im Tourismusbüro mieten."
    ],
    "en": [
      "Two tennis courts are available for those who love the yellow ball. You can either join the club or rent the courts by the hour from the Tourist Office."
    ],
    "it": [
      "Due campi da tennis sono a disposizione di tutti coloro che amano giocare con la palla. È possibile accedervi iscrivendosi al club o affittando i campi a ore presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Deux courts de tennis accessibles aux adeptes de la balle jaune. Vous pouvez y accéder soit en adhérant au club, soit en louant les courts à l'heure à l'Office de Tourisme."
    ],
    "es": [
      "Hay dos pistas de tenis a disposición de todos los que les guste jugar a la pelota. Puede acceder a ellas haciéndose socio del club o alquilando las pistas por horas en la Oficina de Turismo."
    ],
    "nl": [
      "Er zijn twee tennisbanen beschikbaar voor iedereen die van de gele bal houdt. Je kunt lid worden van de club of de banen per uur huren bij het VVV-kantoor."
    ]
  },
