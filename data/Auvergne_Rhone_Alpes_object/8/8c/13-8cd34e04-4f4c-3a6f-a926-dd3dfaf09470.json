  "rdfs:comment": {
    "de": [
      "Herstellung von Schmiedeeisen im alten Stil, Pergolen, Gartenlauben, Brüstungsgeländern, Schutzgittern, Toren, Pforten, Glasdächern, Glastüren, Treppen, Treppengeländern... Maßarbeit."
    ],
    "en": [
      "Creation of old-fashioned wrought iron, pergolas, arbors, railings, gates, wicket doors, workshop glass, glass doors, staircases, stair railings... \r\nMade-to-measure work."
    ],
    "it": [
      "Sono lieto di offrirvi la mia esperienza nell'abbellire i vostri interni ed esterni con il ferro battuto in acciaio, tradizionale o contemporaneo.\r\nStudio del progetto personalizzato, progettazione 3D, creazioni su misura."
    ],
    "fr": [
      "J’ai le plaisir de vous proposer mon savoir-faire pour l’embellissement de votre intérieur et extérieur en acier, des ouvrages de types fer forgés traditionnels ou contemporains.\r\nÉtude de projet personnalisé, conception 3D, créations sur mesures."
    ],
    "es": [
      "Me complace ofrecerle mi experiencia para embellecer su interior y exterior con hierro forjado de acero, tradicional o contemporáneo.\r\nEstudio personalizado del proyecto, diseño en 3D, creaciones a medida."
    ],
    "nl": [
      "Creatie van ouderwets smeedijzer, pergola's, priëlen, balustrades, poorten, loopdeuren, werkplaatsglas, glazen deuren, trappen, trapleuningen... \r\nOp maat gemaakt."
    ]
  },
