  "rdfs:comment": {
    "de": [
      "Timmy Willy ist ein bildender Künstler und Illustrator, der sich auf Holzschnitte spezialisiert hat und beim Maison des Artistes angemeldet ist.\r\nNehmen Sie an seinen kreativen Workshops teil und lassen Sie sich von seinen Holzschnitzereien verführen!"
    ],
    "en": [
      "Timmy Willy is a visual artist and illustrator from Clermont-Ferrand, specializing in wood engraving and registered with the Maison des Artistes in Paris.\r\nDiscover his creative workshops and wood creations by visiting his studio!"
    ],
    "it": [
      "Timmy Willy è un artista visivo e illustratore specializzato nell'incisione su legno e iscritto alla Maison des Artistes.\r\nPartecipate ai suoi laboratori creativi e lasciatevi tentare dalle sue creazioni in legno!"
    ],
    "fr": [
      "Timmy Willy est un artiste plasticien, illustrateur, spécialisé dans la gravure sur bois et déclaré à la Maison des Artistes.\r\nParticipez à ses ateliers créatifs et laissez-vous tenter par ses créations sur bois !"
    ],
    "nl": [
      "Timmy Willy is een beeldend kunstenaar en illustrator die gespecialiseerd is in houtgravure en geregistreerd is bij het Maison des Artistes.\r\nNeem deel aan zijn creatieve workshops en laat je verleiden door zijn houtcreaties!"
    ],
    "es": [
      "Timmy Willy es un artista plástico e ilustrador especializado en el grabado en madera e inscrito en la Maison des Artistes.\r\nParticipa en sus talleres creativos y déjate tentar por sus creaciones en madera"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Timmy Willy - Artiste spécialisé dans l'art du bois"
    ]
  },
