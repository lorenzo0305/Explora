  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Diese Abteikirche ist ein bemerkenswertes Beispiel für die burgundische Romanik und wurde im 12. Jh. über dem Grab eines bretonischen Bischofs, Menoux, errichtet. MH."
    ],
    "en": [
      "Free visit with document. A remarkable example of Burgundian Romanesque art, this abbey church was built in the 12th century on the tomb of a Breton bishop, Menoux. MH."
    ],
    "it": [
      "Visita autoguidata con documentazione. Notevole esempio di arte romanica borgognona, questa chiesa abbaziale fu costruita nel XII secolo sulla tomba di un vescovo bretone, Menoux. MH."
    ],
    "fr": [
      "Visite libre avec document. Remarquable exemple d'art roman bourguignon, cette église abbatiale a été édifiée au XIIe sur la tombe d'un évêque breton, Menoux. MH."
    ],
    "nl": [
      "Zelf rondleiding met documentatie. Deze abdijkerk, een opmerkelijk voorbeeld van Bourgondische Romaanse kunst, werd in de 12e eeuw gebouwd op het graf van een Bretonse bisschop, Menoux. MH."
    ],
    "es": [
      "Visita autoguiada con documentación. Ejemplo notable del arte románico borgoñón, esta iglesia abacial fue construida en el siglo XII sobre la tumba de un obispo bretón, Menoux. MH."
    ]
  },
