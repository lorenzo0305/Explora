  "rdfs:comment": {
    "de": [
      "Ein französisches Restaurant mit einem herzlichen Empfang in aller Einfachheit, reichhaltigen und raffinierten Gerichten. Probieren Sie die traditionellen Froschschenkel!"
    ],
    "en": [
      "French restaurant with a warm welcome in all simplicity, copious and refined dishes. Come and taste their traditional frog's legs!"
    ],
    "it": [
      "Ristorante francese con un'accoglienza calorosa e piatti semplici, sostanziosi e raffinati. Venite ad assaggiare le loro tradizionali cosce di rana!"
    ],
    "fr": [
      "Restaurant français avec un accueil chaleureux en toute simplicité , des plats copieux et raffinés. Venez déguster leur traditionnelles cuisses de grenouilles!"
    ],
    "es": [
      "Restaurante francés con una cálida acogida y platos sencillos, abundantes y refinados. Venga a probar sus tradicionales ancas de rana"
    ],
    "nl": [
      "Frans restaurant met een warm onthaal en eenvoudige, stevige en verfijnde gerechten. Kom en proef hun traditionele kikkerbilletjes!"
    ]
  },
