  "rdfs:comment": {
    "de": [
      "Atelier für handwerkliche Töpferei im Herzen des Dorfes. Gebrauchskreationen aus Steingut mit klaren und feinen Formen: Schalen, Tassen, Salatschüsseln... aber auch geschnitzte Dosen, Brenner für ätherische Öle, Pflanzentöpfe..."
    ],
    "en": [
      "Artisanal pottery workshop at the heart of the village. Our functional stoneware pots are crafted with refined and simple designs : bowls, cups, salad bowls…but sculpted boxes, essential oils burners and potted plants..."
    ],
    "it": [
      "Laboratorio artigianale di ceramica nel cuore del paese. Creazioni utilitarie in gres dalle forme pure e raffinate: ciotole, tazze, insalatiere... ma anche scatole scolpite, bruciatori di oli essenziali, vasi per piante... Siamo spiacenti, non ci sono corsi"
    ],
    "fr": [
      "Atelier de poterie artisanale au cœur du village. Créations utilitaires en grès avec des formes épurées et fines : bols, tasses, saladiers... mais aussi boîtes sculptées, brûleurs d'huiles essentielles, des pots de plantes...Désolée, pas de stages"
    ],
    "es": [
      "Taller de alfarería artesanal en el corazón del pueblo. Creaciones utilitarias en gres de formas puras y finas: cuencos, tazas, ensaladeras... pero también cajas esculpidas, quemadores de aceites esenciales, macetas... Lo sentimos, no hay cursos"
    ],
    "nl": [
      "Ambachtelijke pottenbakkerij in het centrum van het dorp. Gebruiksvoorwerpen van aardewerk in eenvoudige vormen met zuivere lijnen: kommen, kopjes, slakommen, maar ook bewerkte doosjes, geurbranders, plantenpotten."
    ]
  },
