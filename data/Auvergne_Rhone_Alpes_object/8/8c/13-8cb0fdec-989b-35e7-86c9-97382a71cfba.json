  "rdfs:comment": {
    "de": [
      "Bäckerei, Teestube, kleine Restaurants. Herstellung und Verkauf von Bio-Brot, Gebäck, Patisserie, Quiches, Pizzas...  Kommen Sie und genießen Sie Ihr Frühstück oder andere Mahlzeiten auf der Terrasse."
    ],
    "en": [
      "Bakery, tea room, snack bar. Production and sale of organic breads, pastries, quiches, pizzas...  Enjoy your breakfast or other meal on the terrace."
    ],
    "it": [
      "Panificio, sala da tè, snack bar. Produzione e vendita di pane biologico, pasticceria viennese, dolci, quiche, pizze...  Venite a gustare la vostra colazione o altri pasti sulla terrazza."
    ],
    "fr": [
      "Boulangerie, salon de thé, petite restauration. Fabrication et vente de pains bio, viennoiseries, pâtisseries, quiches, pizzas...  Venez prendre votre petit-déjeuner ou autre en terasse."
    ],
    "es": [
      "Panadería, salón de té, snack bar. Elaboración y venta de pan ecológico, bollería, pasteles, quiches, pizzas...  Venga a disfrutar de su desayuno u otra comida en la terraza."
    ],
    "nl": [
      "Bakkerij, tearoom, snackbar. Productie en verkoop van biologisch brood, Weens gebak, pasteitjes, quiches, pizza's...  Kom genieten van je ontbijt of andere maaltijd op het terras."
    ]
  },
