  "rdfs:comment": {
    "de": [
      "Inmitten eines Parks mit Bäumen beherbergen 3 Pavillons 15 Zimmer mit allem Komfort, die sich zur Natur hin öffnen und Ihnen einen Moment der Entspannung und Gelassenheit schenken."
    ],
    "en": [
      "Situated in a large 1-hectare garden planted with cedar trees, 15 rooms with all the comfort you need"
    ],
    "it": [
      "Nel cuore di un parco alberato, 3 padiglioni ospitano 15 camere con tutti i comfort su un unico livello, aprendosi alla natura per un momento di relax e serenità."
    ],
    "fr": [
      "Au coeur d'un parc arboré, 3 pavillons abritent 15 chambres tout confort de plein pied s'ouvrant sur la nature pour un moment de détente et de sérénité."
    ],
    "nl": [
      "In het hart van een bosrijk park herbergen 3 paviljoenen 15 kamers met alle comfort op één niveau, met uitzicht op de natuur voor een moment van ontspanning en sereniteit."
    ],
    "es": [
      "En el corazón de un parque arbolado, 3 pabellones albergan 15 habitaciones con todas las comodidades en una sola planta, que se abren a la naturaleza para un momento de relajación y serenidad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel \"Les Cèdres Bleus\""
    ],
    "fr": [
      "Hôtel Les Cèdres Bleus"
    ]
  },
