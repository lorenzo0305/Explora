  "rdfs:comment": {
    "de": [
      "Die bezauberndste der kleinen Kirchen in der Ebene von Issoire, Notre-Dame-de-Mailhat, wurde Ende des 12. Jahrhunderts hauptsächlich aus Arkose gebaut und wird von Liebhabern der romanischen Kunst geschätzt, da sie zahlreiche geschnitzte Kapitelle und Modillons besitzt."
    ],
    "en": [
      "This is a beautiful church famous for the quality and diversity of its sculptures on the porch, the apse and the choir."
    ],
    "it": [
      "La più affascinante delle piccole chiese della pianura dell'Issoire, Notre-Dame-de-Mailhat fu costruita alla fine del XII secolo, principalmente in arkose, ed è una delle preferite dagli amanti dell'arte romanica, con i suoi numerosi capitelli e modiglioni scolpiti."
    ],
    "fr": [
      "La plus charmante des petites églises de la plaine d’Issoire, Notre-Dame-de-Mailhat construite à la fin du XIIè siècle principalement en arkose, est prisée par les amateurs d’art roman car elle possède de nombreux chapiteaux et modillons sculptés."
    ],
    "es": [
      "Notre-Dame-de-Mailhat, la más encantadora de las pequeñas iglesias de la llanura del Issoire, fue construida a finales del siglo XII, principalmente en arcosa, y es una de las favoritas de los amantes del arte románico, con sus numerosos capiteles y modillones esculpidos."
    ],
    "nl": [
      "Notre-Dame-de-Mailhat, de meest charmante van de kleine kerken op de vlakte van Issoire, werd gebouwd aan het einde van de 12e eeuw, voornamelijk in arkose, en is favoriet bij liefhebbers van Romaanse kunst, met zijn vele gebeeldhouwde kapitelen en modillions."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Church Notre Dame De Mailhat"
    ],
    "fr": [
