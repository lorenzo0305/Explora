      "@id": "https://data.datatourisme.fr/f7119d84-6d0e-3833-9039-41fbde2d5eeb",
      "dc:description": {
        "de": [
          "Am Samstag, den 06. und 07. September 2025, treffen sich die Hardelot Vintage Cars auf dem Place de la Concorde.\nTreffen von Vintage-Sport-, Prestige- und Sammlerautos."
        ],
        "en": [
          "On Saturday 06 and 07 September 2025, Hardelot Vintage Cars will be on the Place de la Concorde.\nGathering of vintage sport, prestige and collection cars."
        ],
        "it": [
          "Sabato 06 e 07 settembre 2025, Hardelot Vintage Cars sarà presente in Place de la Concorde.\nUn raduno di auto sportive, di prestigio e da collezione d'epoca."
        ],
        "fr": [
          "Le samedi 06  et  07 septembre 2025, rendez-vous pour les Hardelot Vintage Cars sur la Place de la Concorde.\nRassemblement de voitures vintage sport, prestige et collection."
        ],
        "nl": [
          "Op zaterdag 06 en 07 september 2025 staat Hardelot Vintage Cars op de Place de la Concorde.\nEen samenkomst van vintage sport-, prestige- en verzamelauto's."
        ],
        "es": [
          "El sábado 06 y 07 de septiembre de 2025, Hardelot Vintage Cars estará en la Place de la Concorde.\nUn encuentro de coches antiguos deportivos, de prestigio y de colección."
        ]
      },
