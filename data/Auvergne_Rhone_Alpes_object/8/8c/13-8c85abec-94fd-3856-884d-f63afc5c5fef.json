  "rdfs:comment": {
    "de": [
      "6 km von Valence entfernt bietet Ihnen das Restaurant l'Echappée Belle einen ländlichen und raffinierten Rahmen, um eine traditionelle Küche zu genießen, die von unserem Küchenchef Patrick Plasse mit Talent neu interpretiert wird."
    ],
    "en": [
      "Located 6 km from Valence, the Echappée Belle restaurant offers a refined country setting for traditional cuisine revisited with talent by our chef Patrick Plasse."
    ],
    "it": [
      "A 6 km da Valence, il ristorante Echappée Belle offre un raffinato ambiente di campagna in cui gustare una cucina tradizionale e conviviale"
    ],
    "fr": [
      "A 6 km de Valence, le restaurant l’Echappée Belle vous propose un cadre champêtre et raffiné pour déguster une cuisine traditionnelle et conviviale"
    ],
    "nl": [
      "Op slechts 6 km van Valence biedt het restaurant Echappée Belle een verfijnde landelijke omgeving waar u kunt genieten van traditionele gerechten die met talent zijn geherinterpreteerd door onze chef-kok Patrick Plasse."
    ],
    "es": [
      "A 6 km de Valence, el restaurante Echappée Belle ofrece un refinado marco campestre para degustar una cocina tradicional y acogedora"
    ]
  },
