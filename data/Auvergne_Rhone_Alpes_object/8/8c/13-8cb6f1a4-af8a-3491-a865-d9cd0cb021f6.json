  "rdfs:comment": {
    "de": [
      "Erleben Sie einen außergewöhnlichen Aufenthalt, eingetaucht in die Magie des argentinischen Tangos mit Eric & Arlette.\r\nSie werden in den Tanz der Eleganz, der Sinnlichkeit und der Komplizenschaft eintreten."
    ],
    "en": [
      "Come and experience an exceptional stay, immersed in the magic of Argentine Tango with Eric & Arlette.\r\nYou'll enter a dance of elegance, sensuality and complicity."
    ],
    "it": [
      "Venite a vivere un soggiorno eccezionale, immersi nella magia del tango argentino con Eric & Arlette.\r\nEntrerete in una danza di eleganza, sensualità e complicità."
    ],
    "fr": [
      "Venez vivre un séjour d'exception, immergés dans la magie du Tango Argentin avec Eric & Arlette. \r\nVous entrerez dans la danse de l'élégance, de la sensualité et de la complicité."
    ],
    "es": [
      "Venga a vivir una estancia excepcional, inmerso en la magia del Tango Argentino con Eric & Arlette.\r\nEntrarás en una danza de elegancia, sensualidad y complicidad."
    ],
    "nl": [
      "Kom en beleef een uitzonderlijk verblijf, ondergedompeld in de magie van de Argentijnse Tango met Eric & Arlette.\r\nJe treedt binnen in een dans van elegantie, sensualiteit en medeplichtigheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de Tango Argentin - niveau intermédiaire et avancé"
    ]
  },
