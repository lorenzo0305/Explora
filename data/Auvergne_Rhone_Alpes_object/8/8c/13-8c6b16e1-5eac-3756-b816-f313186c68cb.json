  "rdfs:comment": {
    "de": [
      "Der Bauernhof von \"Cocotte et compagnie\" im Herzen der Bocage Bourbonnais betreibt Freilandhaltung von Geflügel und Legehennen."
    ],
    "en": [
      "The \"Cocotte et compagnie\" farm in the heart of the Bourbonnais bocage, raises free-range poultry and laying hens."
    ],
    "it": [
      "L'azienda agricola \"Cocotte et compagnie\", nel cuore del bocage di Bourbonnais, alleva pollame e galline ovaiole all'aperto."
    ],
    "fr": [
      "La ferme de \"Cocotte et compagnie\" au coeur du bocage bourbonnais, fait l'élevage de volailles et de poules pondeuses en plein air."
    ],
    "es": [
      "La granja \"Cocotte et compagnie\", en el corazón del bocage de Bourbonnais, cría aves de corral y gallinas ponedoras al aire libre."
    ],
    "nl": [
      "De boerderij \"Cocotte et compagnie\" in het hart van de bocage van Bourbonnais kweekt pluimvee en legkippen in de open lucht."
