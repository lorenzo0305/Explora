  "rdfs:comment": {
    "de": [
      "Obst- und Gemüseladen mit frischen Produkten, Käse, Wurstwaren, Metzgerei, Wein, Bier und anderen lokalen Spezialitäten. Hier finden Sie saisonale Gerichte, regionale Produkte und individuell gestaltete Bretter für Ihre Gaumenfreuden."
    ],
    "en": [
      "Fruit and vegetable shop offering fresh produce, cheese, charcuterie, butcher's, wine, beer and other local specialities. You'll find seasonal flavors, local produce and personalized boards for your gourmet cravings."
    ],
    "it": [
      "Negozio di frutta e verdura che vende prodotti freschi, formaggi, salumi, macelleria, vino, birra e altre specialità locali. Troverete sapori di stagione, prodotti locali e taglieri personalizzati per tutti i vostri gusti gastronomici."
    ],
    "fr": [
      "Commerce de fruits et légumes proposant produits frais, fromages, charcuterie, boucherie, vin, bières t autres spécialités locales. Vous y trouverez des saveurs de saison, des produits du terroir et des planches personnalisées pour vos envies gourmandes."
    ],
    "es": [
      "Frutería con productos frescos, quesos, charcutería, carnicería, vinos, cervezas y otras especialidades locales. Encontrará sabores de temporada, productos locales y bandejas personalizadas para sus antojos gourmet."
    ],
    "nl": [
      "Fruit- en groentewinkel met verse producten, kazen, vleeswaren, slagers, wijn, bier en andere lokale specialiteiten. Je vindt er seizoensgebonden smaken, lokale producten en gepersonaliseerde schotels voor je lekkere trek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au panier primeur"
    ]
  },
