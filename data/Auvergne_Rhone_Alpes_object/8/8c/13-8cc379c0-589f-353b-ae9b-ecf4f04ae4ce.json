  "rdfs:comment": {
    "de": [
      "Im Herzen des Stadtzentrums von Le Puy-en-Velay, 5 Minuten zu Fuß vom SNCF- und Busbahnhof entfernt, verfügt das Hotel über ein Restaurant \"La Taverne\", direkter Zugang, täglich."
    ],
    "en": [
      "In the heart of the town centre of Le Puy-en-Velay, 5 minutes walk from the train and bus station, the hotel has a restaurant \"La Taverne\", direct access, every day."
    ],
    "it": [
      "Nel cuore del centro di Le Puy-en-Velay, a 5 minuti a piedi dalla stazione ferroviaria e degli autobus, l'hotel dispone di un ristorante \"La Taverne\", con accesso diretto, tutti i giorni."
    ],
    "fr": [
      "En plein coeur du centre ville du Puy-en-Velay, à 5 minutes à pied de la gare SNCF et routière, l'hôtel dispose d'un restaurant \"La Taverne\", accès direct, tous les jours."
    ],
    "nl": [
      "In het hart van het stadscentrum van Le Puy-en-Velay, op 5 minuten lopen van het trein- en busstation, beschikt het hotel over een restaurant \"La Taverne\", elke dag direct toegankelijk."
    ],
    "es": [
      "En el corazón del centro de la ciudad de Le Puy-en-Velay, a 5 minutos a pie de la estación de trenes y autobuses, el hotel dispone de un restaurante \"La Taverne\", de acceso directo, todos los días."
    ]
  },
