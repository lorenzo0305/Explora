  "rdfs:comment": {
    "de": [
      "Ein 300 m2 großer Wasserspielplatz im Freien erwartet Sie, um die Kleinen in Staunen zu versetzen und ihnen Freude zu bereiten. Kinder haben im Wasserpark von Le Palais ihr eigenes Paradies!"
    ],
    "en": [
      "A 300m2 outdoor water playground awaits you, to the delight and amazement of the little ones. The Palais aquatic centre is a children's paradise!"
    ],
    "it": [
      "Un parco giochi acquatico esterno di 300m2 vi aspetta per la meraviglia e la gioia dei più piccoli. I bambini hanno il loro paradiso nell'area acquatica del Palais!"
    ],
    "fr": [
      "Une plaine de jeux aqualudiques extérieure de 300m2 vous attend pour l’émerveillement et la joie des petits. Les enfants ont leur paradis à l'espace aquatique du Palais !"
    ],
    "es": [
      "Un parque acuático exterior de 300 m2 le espera, para deleite y asombro de los más pequeños. El centro acuático del Palais es el paraíso de los niños"
    ],
    "nl": [
      "Een waterspeeltuin van 300 m2 buiten wacht op je, tot grote vreugde en verbazing van de kleintjes. Het Palais aquatic centre is een paradijs voor kinderen!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Watergames for chidren"
    ],
    "it": [
      "Parco giochi acquatico"
    ],
    "fr": [
      "Plaine de jeux aqualudique"
    ]
  },
