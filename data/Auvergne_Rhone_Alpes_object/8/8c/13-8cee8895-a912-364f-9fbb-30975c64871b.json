  "rdfs:comment": {
    "de": [
      "Restaurant in der Stadt. Art-Déco-Dekor, gastronomische und kreative Küche.\r\nFrische und biologische Produkte. Restaurant mit Meeresprodukten im Angebot. Fisch.\r\nChefkoch mit Werdegang bei Sterneköchen.\r\nTerrasse mit Blick auf Sacré C?ur."
    ],
    "en": [
      "City restaurant. Art deco decor, gastronomic and creative cuisine.\r\nFresh and organic products. Restaurant offering seafood products. Fish\r\nChef with a career with starred chefs.\r\nTerrace overlooking the Sacré Coeur."
    ],
    "it": [
      "Ristorante cittadino. Arredamento Art déco, cucina gastronomica e creativa.\r\nProdotti freschi e biologici. Ristorante di pesce. Pesce.\r\nChef con un passato da chef stellato.\r\nTerrazza con vista sul Sacro Cuore."
    ],
    "fr": [
      "Restaurant de ville. Décor art déco, cuisine gastronomique et créative.\r\nProduits frais et bio. Restaurant proposant produits de la mer. Poisson. \r\nChef avec un parcours chez des chefs étoilés.\r\nTerrasse avec vue sur le Sacré Cœur."
    ],
    "nl": [
      "Stadsrestaurant. Art deco decor, gastronomische en creatieve keuken.\r\nVerse en biologische producten. Restaurant met zeevruchten. Vis.\r\nChef-kok met een achtergrond in sterren.\r\nTerras met uitzicht op de Sacré C?ur."
    ],
    "es": [
      "Restaurante urbano. Decoración art déco, cocina gastronómica y creativa.\r\nProductos frescos y ecológicos. Restaurante que ofrece marisco. Pescado.\r\nChef con experiencia en cocinas con estrella.\r\nTerraza con vistas al Sacré Cœur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Bulle d'Air"
    ]
  },
