  "rdfs:comment": {
    "de": [
      "Um unsere Leidenschaft für alte Maschinen zu teilen, haben wir eine Ausstellung mit freiem Eintritt eröffnet, die den Traktoren und Motorrädern aus vergangenen Zeiten gewidmet ist."
    ],
    "en": [
      "To share our passion for old mechanics, we have opened a free exhibition dedicated to tractors and motorbikes from days gone by."
    ],
    "it": [
      "Per condividere la nostra passione per i vecchi tempi, abbiamo aperto una mostra gratuita dedicata ai trattori e alle moto di un tempo."
    ],
    "fr": [
      "Afin de faire partager notre passion pour les vieilles mécaniques , nous avons ouvert  une exposition à entrée libre dédié aux tracteurs et aux motos du temps jadis."
    ],
    "es": [
      "Para compartir nuestra pasión por los viejos tiempos, hemos inaugurado una exposición gratuita dedicada a tractores y motos de antaño."
    ],
    "nl": [
      "Om onze passie voor oldtimers te delen, hebben we een gratis tentoonstelling geopend over tractoren en motoren uit vervlogen tijden."
