  "rdfs:comment": {
    "de": [
      "Ein schöner Spielplatz für Kinder von 1 bis 12 Jahren am Ufer des Flusses unter dem Blick des Felsens St Julien. Zahlreiche Installationen, schattige und blumengeschmückte Bereiche laden dazu ein, eine schöne Zeit mit der Familie zu verbringen."
    ],
    "en": [
      "A beautiful play area for children aged 1 to 12, on the banks of the river, overlooked by the St Julien rock. Numerous facilities, shaded areas and flowers to spend a good time with the family."
    ],
    "it": [
      "Una grande area giochi per bambini da 1 a 12 anni sulle rive del fiume, sovrastata dalla roccia di St Julien. Numerosi servizi, aree ombreggiate e fiori per il divertimento di tutta la famiglia."
    ],
    "fr": [
      "Un bel espace de jeux pour les enfants de 1 à 12 ans au bord de la rivière sous le regard su rocher St Julien. De nombreuses installations, des espaces ombragés et fleuris pour passer un bon moment en famille."
    ],
    "es": [
      "Una estupenda zona de juegos para niños de 1 a 12 años a orillas del río, dominada por la roca de St Julien. Muchas instalaciones, zonas de sombra y flores para toda la familia."
    ],
    "nl": [
      "Een geweldige speelplek voor kinderen van 1 tot 12 jaar aan de oever van de rivier, met uitzicht op de rots St Julien. Genoeg faciliteiten, schaduwplekken en bloemen waar het hele gezin van kan genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux pour enfants"
    ]
  },
