  "rdfs:comment": {
    "de": [
      "Das Café de Bellevaux befindet sich in der Gemeinde Ecole en Bauges, inmitten einer wunderschönen Landschaft in Savoyen."
    ],
    "en": [
      "Some specialties to discover: Reblochonnade, sandwiches but also tajines and for the dessert homemade ice cream, creme brulee with blueberries and other tarts. Many events are organized throughout the year."
    ],
    "it": [
      "Il caffè Bellevaux si trova nel comune di Ecole en Bauges, nel cuore di un magnifico paesaggio sabaudo."
    ],
    "fr": [
      "Le café de Bellevaux est implanté sur la commune d'Ecole en Bauges, au cœur d'un magnifique paysage de Savoie."
    ],
    "nl": [
