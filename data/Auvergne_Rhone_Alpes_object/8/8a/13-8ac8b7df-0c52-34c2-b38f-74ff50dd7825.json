  "rdfs:comment": {
    "de": [
      "Fordern Sie Ihre Lieben, Familie oder Freunde im Herzen des Stadtgartens von Voiron mit diesem einfachen Orientierungslaufkurs heraus. Nehmen Sie die Herausforderung an und finden Sie die 23 Leuchtfeuer. Schauen Sie sich die Karte und Ihre Umgebung genau an, um erfolgreich zu sein."
    ],
    "en": [
      "An orienteering course in the heart of the city garden! Ideal for children, this nature trail invites you to discover 23 markers cleverly hidden throughout the area, allowing you to exercise and have fun in complete safety."
    ],
    "it": [
      "Percorso di orienteering nel cuore del giardino cittadino! Ideale per i bambini, questo percorso naturalistico invita a scovare 23 marcatori abilmente nascosti nell'ambiente, per fare esercizio e divertirsi in tutta sicurezza."
    ],
    "fr": [
      "Parcours d'orientation au cœur du jardin de ville ! Idéal pour les enfants, ce parcours en pleine nature propose de dénicher les 23 balises intelligemment cachées dans l'environnement pour se dépenser et s'amuser en toute sécurité."
    ],
    "es": [
      "¡Recorrido de orientación en pleno jardín de la ciudad! Ideal para los niños, este recorrido natural invita a desenterrar 23 balizas ingeniosamente escondidas en el entorno, para hacer ejercicio y divertirse con total seguridad."
    ],
    "nl": [
      "Oriëntatieloop in het hart van de stadstuin! Dit natuurparcours is ideaal voor kinderen en nodigt je uit om 23 slim verborgen markers in de omgeving op te sporen, voor beweging en plezier in alle veiligheid."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslaufkurs im Stadtgarten von Voiron"
    ],
    "en": [
      "Voiron city garden orienteering course"
    ],
    "fr": [
      "Parcours d'orientation jardin de ville de Voiron"
    ]
  },
