  "rdfs:comment": {
    "de": [
      "Handwerkliche Brauerei / Bierherstellung: Außer-Haus-Verkauf, Bierbar. Brewpub NK: Bar zum Probieren von Bieren aus unserer Brauerei und anderen alkoholfreien Getränken. Also kommen Sie und genießen Sie unsere Panoramaterrasse!"
    ],
    "en": [
      "Artisanal brewery / Beer production: take-away sale, beer bar. Brewpub NK: bar to taste beers from our Brewery and other non-alcoholic drinks. So come and enjoy our panoramic terrace!"
    ],
    "it": [
      "Birrificio artigianale tra Limagne e Volcans d'Auvergne. Venite a scoprire il nostro brewpub, dove potrete degustare le nostre birre prodotte in loco, e il nostro negozio da asporto."
    ],
    "fr": [
      "Brasserie artisanale entre Limagne et Volcans d'Auvergne. Venez découvrir notre brewpub où déguster nos bière brassées sur place ainsi que notre shop pour la vente à emporter."
    ],
    "es": [
      "Cervecería artesanal entre Limagne y Volcans d'Auvergne. Venga a descubrir nuestro brewpub, donde podrá degustar nuestras cervezas elaboradas in situ, y nuestra tienda de comida para llevar."
    ],
    "nl": [
      "Ambachtelijke brouwerij tussen Limagne en Volcans d'Auvergne. Kom en ontdek onze brouwerij, waar je onze ter plaatse gebrouwen bieren kunt proeven, en onze meeneemwinkel."
    ]
  },
