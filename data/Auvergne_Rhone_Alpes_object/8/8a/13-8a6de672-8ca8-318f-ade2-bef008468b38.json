  "rdfs:comment": {
    "de": [
      "Le Numéro 3 ist ein italienisches Restaurant, das in Clermont-Ferrand mitten im Stadtzentrum angesiedelt ist\r\nEs ist auf handgemachte Pizza und hausgemachte frische Pasta spezialisiert, die mit frischen Produkten serviert wird.\r\n\r\n"
    ],
    "en": [
      "Le Numéro 3 is an Italian restaurant located in Clermont-Ferrand in the city center\r\nSpecialized in home-made pizza and fresh home-made pasta, accompanied by fresh products.\r\n\r\n"
    ],
    "it": [
      "Le Numéro 3 è un ristorante italiano situato a Clermont-Ferrand, nel centro della città\r\nSpecializzato in pizza e pasta fresca fatte in casa, accompagnate da prodotti freschi.\r\n\r\n??"
    ],
    "fr": [
      "Le Numéro 3 est un restaurant italien installé à Clermont-Ferrand en plein centre-ville. \r\nSpécialiste de la pizza artisanale et des pâtes fraiches maison, accompagnées de produits frais.\r\n\r\n​​"
    ],
    "nl": [
      "Le Numéro 3 is een Italiaans restaurant in Clermont-Ferrand in het stadscentrum\r\nGespecialiseerd in huisgemaakte pizza en verse huisgemaakte pasta, vergezeld van verse producten.\r\n\r\n"
    ],
    "es": [
      "Le Numéro 3 es un restaurante italiano situado en Clermont-Ferrand, en el centro de la ciudad\r\nEspecializado en pizza casera y pasta fresca casera, acompañada de productos frescos.\r\n\r\n??"
    ]
  },
