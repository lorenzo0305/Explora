  "rdfs:comment": {
    "de": [
      "Cabrettes sind hölzerne Überbleibsel, durch die die Heuseile geführt wurden, um die Heuhaufen herunterzulassen. Sie stammen aus dem 19."
    ],
    "en": [
      "The \"cabrettes\" are wooden vestiges that used to be used to run the hay ropes down the hay bales. They date from the 19th century."
    ],
    "it": [
      "Le cabrette sono vestigia in legno che consentivano il passaggio delle corde per abbassare i barili di fieno. Risalgono al XIX secolo."
    ],
    "fr": [
      "Les cabrettes sont des vestiges de bois qui permettaient le passage des câbles à foin pour descendre les barillons de foin. Elles datent du 19e siècle."
    ],
    "es": [
      "Las cabrettes son vestigios de madera que permitían el paso de las cuerdas de heno para bajar los barriles de heno. Datan del siglo XIX."
    ],
    "nl": [
      "De \"cabrettes\" zijn houten overblijfselen die vroeger werden gebruikt om de hooitouwen langs de hooibalen naar beneden te laten lopen. Ze dateren uit de 19e eeuw."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Villarembert Cabrettes"
    ],
    "fr": [
      "Cabrettes de Villarembert"
    ],
    "nl": [
      "Cabrettes van Villarembert"
    ]
  },
