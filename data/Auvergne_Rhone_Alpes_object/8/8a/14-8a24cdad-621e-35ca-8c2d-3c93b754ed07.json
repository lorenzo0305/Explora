  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4dd9eeeb-e7e9-3cbd-96c5-9e4d07108d4a",
      "dc:description": {
        "de": [
          "DETAILS\nSONNTAG, DEN 14. MAI 2023\n15 Uhr: Espace Malahieude (Bucht Saint-Jean bei schlechtem Wetter)\n\nEin großes Konzert, bei dem 4 Harmonien aus der Region zusammenkommen: Etaples sur mer, Dannes, Pont de briques und Wimereux. Sie werden unter dem Motto \"Rock\" auftreten.\n\nKostenloses Konzert.\n\nAuskunft: Harmonie Municipale 06 50 07 79 84"
        ],
        "en": [
          "DETAILS\nSUNDAY MAY 14, 2023\n3pm: Espace Malahieude (Baie Saint-Jean in case of bad weather)\n\nA major concert featuring 4 regional bands: Etaples sur mer, Dannes, Pont de briques and Wimereux. They will perform on the theme of rock.\n\nFree concert.\n\nInformation: Harmonie Municipale 06 50 07 79 84"
        ],
        "it": [
          "DETTAGLI\nDOMENICA 14 MAGGIO 2023\n15:00: Espace Malahieude (Baie Saint-Jean in caso di maltempo)\n\nUn grande concerto con 4 gruppi locali: Etaples sur mer, Dannes, Pont de briques e Wimereux. Si esibiranno sul tema del rock.\n\nConcerto gratuito.\n\nInformazioni: Harmonie Municipale 06 50 07 79 84"
        ],
        "fr": [
          "DÉTAILS\nDIMANCHE 14 MAI 2023\n15h : Espace Malahieude (baie Saint-Jean si mauvais temps)\n\nUn grand concert regroupant 4 harmonies de la Région : Etaples sur mer, Dannes, Pont de briques et Wimereux. Elles se produiront sur le thème du rock.\n\nConcert gratuit.\n\nRens. :  Harmonie Municipale 06 50 07 79 84"
        ],
        "es": [
          "DETALLES\nDOMINGO 14 DE MAYO DE 2023\n15.00 h: Espace Malahieude (Baie Saint-Jean si hace mal tiempo)\n\nGran concierto de 4 grupos locales: Etaples sur mer, Dannes, Pont de briques y Wimereux. Actuarán sobre el tema del rock.\n\nConcierto gratuito.\n\nInformación: Harmonie Municipale 06 50 07 79 84"
        ],
        "nl": [
          "DETAILS\nZONDAG 14 MEI 2023\n15.00 uur: Espace Malahieude (Baie Saint-Jean bij slecht weer)\n\nEen groot concert met 4 lokale bands: Etaples sur mer, Dannes, Pont de briques en Wimereux. Ze zullen optreden rond het thema rock.\n\nGratis concert.\n\nInformatie: Harmonie Municipale 06 50 07 79 84"
        ]
      },
