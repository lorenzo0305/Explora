  "rdfs:comment": {
    "de": [
      "Ein Tisch für Viandards. Sie lieben Fleisch, das echte. Das, das schmeckt, Zeit hat und eine Geschichte erzählt. Bei B.L.O. wird jedes Stück Fleisch mit Sorgfalt ausgewählt, zubereitet und serviert. Sie kommen, um gut zu essen, bei B.L.O. werden Sie richtig bewirtet."
    ],
    "en": [
      "A table for true meat lovers. You love real meat — the kind with flavor, depth, and a story to tell. At B.L.O, every cut is carefully selected, prepared, and served with intention. You come for a great meal, and we make sure you're welcomed just right."
    ],
    "it": [
      "Una tavola per gli amanti della carne. Vi piace la carne vera. Quella che ha sapore, tempo e storia. Al B.L.O, ogni pezzo di carne è selezionato, preparato e servito con cura. Se siete venuti per gustare un buon pasto, B.L.O. vi darà un caloroso benvenuto."
    ],
    "fr": [
      "Une table pour viandards. Vous aimez la viande, la vraie. Celle qui a du goût, du temps, et une histoire. Chez B.L.O, chaque pièce est choisie, préparée et servie avec soin. Vous venez pour bien manger, B.L.O vous accueille comme il faut."
    ],
    "es": [
      "Una mesa para amantes de la carne. A los que les gusta la carne de verdad. De la que tiene sabor, tiempo e historia. En B.L.O., cada pieza de carne se selecciona, prepara y sirve cuidadosamente. Si ha venido a disfrutar de una buena comida, B.L.O. le dará una cálida bienvenida."
    ],
    "nl": [
      "Een tafel voor vleesliefhebbers. Je houdt van echt vlees. Het soort dat smaak, tijd en geschiedenis heeft. Bij B.L.O. wordt elk stuk vlees zorgvuldig geselecteerd, bereid en geserveerd. Als je komt om te genieten van een goede maaltijd, heet B.L.O. je van harte welkom."
    ]
  },
