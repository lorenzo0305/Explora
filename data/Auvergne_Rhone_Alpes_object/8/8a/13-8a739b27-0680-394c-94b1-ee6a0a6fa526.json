  "rdfs:comment": {
    "de": [
      "Eine magische Reise auf der Sioule! Zu Ihrem Vergnügen können Sie bei uns einfache oder doppelte Kanu-Kajaks mieten, um die Schluchten der Sioule hinunterzufahren. Nervenkitzel während der Abfahrt garantiert!"
    ],
    "en": [
      "A magical trip down the Sioule! For your greater pleasure, we offer single or double canoe-kayak hire for a trip down the Sioule gorges. Thrills and spills guaranteed!"
    ],
    "it": [
      "Un viaggio magico lungo la Sioule! Per il vostro piacere, vi proponiamo il noleggio di canoe-kayak singole o doppie per una gita lungo le gole della Sioule. Emozioni e cadute garantite!"
    ],
    "fr": [
      "Un voyage magique sur la Sioule ! Pour votre plus grand plaisir, nous vous proposons  la location de canoës-kayaks simples ou doubles pour descendre les gorges de la Sioule. Sensations fortes garanties pendant la descente !"
    ],
    "es": [
      "Un viaje mágico por el Sioule Para su mayor placer, le proponemos el alquiler de canoas y kayaks individuales o dobles para descender las gargantas del Sioule. Emociones garantizadas"
    ],
    "nl": [
      "Kano's / fietsen met een elektrische ondersteuning"
    ]
  },
