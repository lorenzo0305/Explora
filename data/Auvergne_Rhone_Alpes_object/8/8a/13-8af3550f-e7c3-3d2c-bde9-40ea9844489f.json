  "rdfs:comment": {
    "de": [
      "Die Ferme des Supeyres liegt auf den Höhen von Ambert, in der Nähe des Col des Supeyres und der weiten Flächen der Hautes Chaumes du Forez. Herstellung und Verkauf von Kuhmilchkäse aus Rohmilch: Fourme d'Ambert AOP und Tomme de montagne"
    ],
    "en": [
      "Salers cattle for meat and Abondances cattle for milk. Milking in the mountain pastures in the summer. All milk produced is made into farm-fresh raw milk  cheeses: AOP Fourme d’Ambert and  Tomme. The cheeses are sold at the farm or at the Ambert Market."
    ],
    "it": [
      "La Ferme des Supeyres si trova sulle alture di Ambert, vicino al Col des Supeyres e alle vaste distese delle Hautes Chaumes du Forez. Produzione e vendita di formaggi vaccini a latte crudo: Fourme d'Ambert DOP e Tomme de Montagne"
    ],
    "fr": [
      "La Ferme des Supeyres est située sur les hauteurs d'Ambert, à proximité du Col des Supeyres et des vastes étendues des Hautes Chaumes du Forez. Fabrication et vente de fromages de vache au lait cru : fourme d'Ambert AOP et tomme de montagne"
    ],
    "es": [
      "La Ferme des Supeyres está situada en las alturas de Ambert, cerca del Col des Supeyres y de las vastas extensiones de las Hautes Chaumes du Forez. Producción y venta de quesos de leche cruda de vaca: Fourme d'Ambert DOP y Tomme de Montagne"
    ],
    "nl": [
      "Ferme des Supeyres ligt op de hoogten van Ambert, vlakbij de Col des Supeyres en de uitgestrekte vlakten van de Hautes Chaumes du Forez. Productie en verkoop van rauwe koeienmelkse kazen: Fourme d'Ambert BOB en Tomme de Montagne"
    ]
  },
