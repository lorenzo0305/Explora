  "rdfs:comment": {
    "de": [
      "Familiengeführte Keksmanufaktur in Ribes. Bei Minute Papillon bieten wir Ihnen 100% bio Handwerkskekse. Eine süße Auswahl und eine herzhafte Auswahl... um bei Ihnen vom Snack bis zum Aperitif zu sein!"
    ],
    "en": [
      "Here, in our family  biscuits factory, we bake our biscuits with love. We only use organic products.\r\nYou suggest you crakers and cookies, to enjoy our products from snack to aperitif!"
    ],
    "it": [
      "Biscottificio a conduzione familiare con sede a Ribes. Minute Papillon offre biscotti 100% biologici fatti in casa. Granella, biscotti dolci e salati per accompagnarvi dalla colazione all'aperitivo!"
    ],
    "fr": [
      "Biscuiterie familiale implantée à Ribes. Chez Minute Papillon, nous vous proposons des biscuits artisanaux 100 % bio. Du granola, des biscuits sucrés et salés pour être avec vous du petit déjeuner à l'apéritif !"
    ],
    "nl": [
      "Koekjesfabriek in Ribes, een familiebedrijf. Bij Minute Papillon bieden we 100% biologische huisgemaakte koekjes aan. Granola, zoete en hartige koekjes voor bij het ontbijt tot het aperitief!"
    ],
    "es": [
      "Fábrica familiar de galletas situada en Ribes. En Minute Papillon, le ofrecemos galletas caseras 100% ecológicas. ¡Galletas de granola, dulces y saladas para acompañarle desde el desayuno hasta el aperitivo!"
    ]
  },
