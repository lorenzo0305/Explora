  "rdfs:comment": {
    "de": [
      "Ein Nugget mit türkisfarbenem Wasser inmitten von Almwiesen. Genießen Sie diesen offenen und sonnigen Bereich mit einem atemberaubenden Blick auf die Nadeln von Arves. Angelegter Strand auf Rasen. Wasserfläche für alle und Planschbecken für die Kleinsten."
    ],
    "en": [
      "Enjoy the lake, its fantastic surroundings and great facilities for all. Picnic areas, boules, volleyball. Free parking."
    ],
    "it": [
      "Una pepita di acqua turchese in mezzo ai prati alpini. Venite a godervi questo spazio aperto e soleggiato con una vista mozzafiato sulle Aiguilles d'Arves. Spiaggia su prato. Piscina per tutti e vasca per i più piccoli."
    ],
    "fr": [
      "Une pépite aux eaux turquoises au milieu des prairies d'alpages. Venez profiter de cet espace ouvert et ensoleillé avec une vue imprenable sur les aiguilles d'Arves. Plage aménagée sur gazon. Plan d'eau pour tous et pataugeoire pour les plus petits."
    ],
    "es": [
      "Una pepita de agua turquesa en medio de prados alpinos. Venga a disfrutar de este espacio abierto y soleado con una vista impresionante de las Aiguilles d'Arves. Playa de hierba. Piscina para todos y piscina infantil para los más pequeños."
    ],
    "nl": [
      "Een klompje turquoise water te midden van alpenweiden. Kom genieten van deze zonnige, open plek met een adembenemend uitzicht op de Aiguilles d'Arves. Strand op gras. Zwembad voor iedereen en peuterbad voor de kleintjes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lake of Col du Mollard"
    ],
    "fr": [
      "Plan d'eau et baignade du Col du Mollard"
    ]
  },
