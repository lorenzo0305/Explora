  "rdfs:comment": {
    "de": [
      "Didier Lathuille, passionierter lokaler Animateur, spezialisiert auf sanftes, aktives und freizeitorientiertes Wandern in den Aravis.\r\nWanderungen für alle geeignet: Familien, Gruppen, Einzelpersonen, auf gesicherten Wegen, abwechslungsreiche Routen, Leistungen Stunde/Pauschale."
    ],
    "en": [
      "Didier Lathuille, a passionate local instructor, specializes in gentle, active and leisurely walking in the Aravis mountains.\r\nWalks suitable for all: family, group, solo, on safe trails, varied itineraries, hourly or fixed price."
    ],
    "it": [
      "Didier Lathuille, appassionato istruttore locale specializzato in passeggiate dolci, attive e tranquille negli Aravis.\r\nPasseggiate adatte a tutte le capacità: in famiglia, in gruppo, in solitaria, su sentieri sicuri, itinerari variegati, pacchetti a tariffa oraria/fissa."
    ],
    "fr": [
      "Didier Lathuille, animateur local passionné, spécialisé dans la marche douce, active et de loisirs dans les Aravis.\r\nMarches adaptées à tous : famille, groupe, solo, sur des sentiers sécurisés, itinéraires variés, prestations heure/forfait."
    ],
    "nl": [
      "Didier Lathuille, een gepassioneerde lokale instructeur die gespecialiseerd is in rustige, actieve en ontspannende wandelingen in de Aravis.\r\nWandelingen voor alle niveaus: familie, groep, solo, op veilige paden, gevarieerde routes, pakketten per uur/vaste prijs."
    ],
    "es": [
      "Didier Lathuille, apasionado monitor local especializado en paseos suaves, activos y tranquilos en Aravis.\r\nPaseos para todos los públicos: en familia, en grupo, en solitario, por senderos seguros, itinerarios variados, paquetes por horas/precios fijos."
    ]
  },
  "rdfs:label": {
