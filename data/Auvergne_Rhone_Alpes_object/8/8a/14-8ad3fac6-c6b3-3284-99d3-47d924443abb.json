  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e43b8830-14d4-3f42-91e1-39a3c0e1844c",
      "dc:description": {
        "de": [
          "Tauche in eine unsichtbare Welt ein, ohne nass zu werden! Direkt unter der Oberfläche des Teiches tummelt sich ein winziges, aber faszinierendes Leben: Insekten, Larven, kleine Krustentiere und sogar einige geschützte Bewohner wie Molche! Entdecken Sie die unglaubliche Biodiversität dieses unauffälligen, aber wichtigen Gewässers."
        ],
        "en": [
          "Dive into an invisible world? without getting wet! Just beneath the surface of the pond, tiny but fascinating life stirs: insects, larvae, tiny crustaceans? and even some protected inhabitants like newts! Come and discover the incredible biodiversity of this discreet but essential aquatic environment."
        ],
        "it": [
          "Immergetevi in un mondo invisibile? Senza bagnarvi! Appena sotto la superficie dello stagno si agita una vita minuscola ma affascinante: insetti, larve, minuscoli crostacei e persino alcuni abitanti protetti come i tritoni! Venite a scoprire l'incredibile biodiversità di questo ambiente acquatico discreto ma essenziale."
        ],
        "fr": [
          "Plongez dans un monde invisible… sans vous mouiller ! Juste sous la surface de la mare, une vie minuscule mais fascinante s’agite : insectes, larves, petits crustacés… et même quelques habitants protégés comme les tritons ! Venez découvrir l’incroyable biodiversité de ce milieu aquatique discret mais essentiel."
        ],
        "es": [
          "Sumérgete en un mundo invisible... ¡sin mojarte! Justo bajo la superficie del estanque se agita una vida diminuta pero fascinante: insectos, larvas, crustáceos diminutos... ¡e incluso algunos habitantes protegidos como los tritones! Venga a descubrir la increíble biodiversidad de este discreto pero esencial medio acuático."
        ],
        "nl": [
          "Duik in een onzichtbare wereld? zonder nat te worden! Net onder het wateroppervlak van de vijver leeft piepklein maar fascinerend leven: insecten, larven, kleine kreeftachtigen? en zelfs enkele beschermde bewoners zoals salamanders! Kom en ontdek de ongelooflijke biodiversiteit van dit discrete maar essentiële watermilieu."
        ]
      },
      "@type": [
        "Description"
      ],
