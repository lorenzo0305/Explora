  "rdfs:comment": {
    "de": [
      "Unser Restaurant am Fuße der Pisten ist auf Skiern über die blaue Piste von Fontanettes erreichbar, die sich unterhalb des Sessellifts von Reberty befindet. Genießen Sie die Küche unseres Küchenchefs in einem modernen Rahmen und einer freundlichen Atmosphäre."
    ],
    "en": [
      "Our restaurant at the foot of the slopes is accessible on skis via the Fontanettes blue run under the Reberty chairlift. Come and enjoy our chef's cuisine in a modern setting and friendly atmosphere."
    ],
    "it": [
      "Il nostro ristorante ai piedi delle piste è accessibile con gli sci attraverso la pista blu delle Fontanettes sotto la seggiovia Reberty. Venite a gustare la cucina del nostro chef in un ambiente moderno e in un'atmosfera amichevole."
    ],
    "fr": [
      "Notre restaurant au pied des pistes est accessible à skis par la piste bleue des Fontanettes située sous le télésiège de Reberty. Venez savourer la cuisine de notre chef dans un cadre moderne et une ambiance conviviale."
    ],
    "nl": [
      "Ons restaurant aan de voet van de pistes is bereikbaar op ski's via de Fontanettes blauwe piste onder de Reberty stoeltjeslift. Kom genieten van de gerechten van onze chef in een moderne omgeving en vriendelijke sfeer."
    ],
    "es": [
      "Nuestro restaurante a pie de pistas es accesible con esquís por la pista azul de Fontanettes, bajo el telesilla Reberty. Venga a degustar la cocina de nuestro chef en un marco moderno y un ambiente acogedor."
    ]
  },
