  "rdfs:comment": {
    "de": [
      "Der 11 ha große Park bietet einen originellen Spaziergang durch drei verschiedene landschaftliche Umgebungen: einen öffentlichen Garten im Norden, drei breite Lichtungen in der Mitte und ein Unterholz im Süden."
    ],
    "en": [
      "This 11ha park is currently being redeveloped. It will offer an original walk through 3 different landscape atmospheres: a public garden in the north, 3 large clearings in the centre and undergrowth in the south. 3 large play areas shall be created…"
    ],
    "it": [
      "Il parco di 11 ettari offre una passeggiata originale attraverso tre paesaggi diversi: un giardino pubblico a nord, tre grandi radure al centro e un sottobosco a sud."
    ],
    "fr": [
      "Parc de 11 ha, il offre une balade originale à travers 3 ambiances paysagères différentes : un jardin public au nord, 3 larges clairières au au centre et un sous-bois au sud."
    ],
    "nl": [
      "Het park van 11 hectare biedt een originele wandeling door drie verschillende landschappen: een openbare tuin in het noorden, drie grote open plekken in het midden en een kreupelbos in het zuiden."
    ],
    "es": [
      "Este parque de 11 hectáreas ofrece un original paseo por tres paisajes diferentes: un jardín público al norte, tres grandes claros en el centro y un sotobosque al sur."
    ]
  },
