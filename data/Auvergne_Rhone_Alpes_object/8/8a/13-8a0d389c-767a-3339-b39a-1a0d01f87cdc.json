  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle und warme Küche in der Atmosphäre eines kleinen Chalets. Wir arbeiten mit frischen und lokalen Produkten, um ein schönes Erlebnis zu garantieren und die savoyischen Spezialitäten hervorzuheben."
    ],
    "en": [
      "Come discover a traditional and warm cuisine in the atmosphere of a small chalet. We work with fresh and local products to ensure a great experience and highlight the Savoyard specialties."
    ],
    "it": [
      "Venite a scoprire una cucina tradizionale e calorosa nell'atmosfera di un piccolo chalet. Lavoriamo con prodotti freschi e locali per garantire una grande esperienza e presentare le specialità savoiarde."
    ],
    "fr": [
      "Venez découvrir une cuisine traditionnelle et chaleureuse dans l'ambiance d'un petit chalet. Nous travaillons avec des produits frais et locaux pour garantir une belle expérience et mettre en avant les spécialités savoyardes."
    ],
    "es": [
      "Venga a descubrir una cocina tradicional y cálida en el ambiente de un pequeño chalet. Trabajamos con productos frescos y locales para garantizar una gran experiencia y mostrar las especialidades de Saboya."
    ],
    "nl": [
      "."
    ]
  },
