  "rdfs:comment": {
    "de": [
      "Immobilien in der Provence seit 1960.\r\nWir sind seit drei Generationen für Sie da und bemühen uns, Ihnen das beste Immobilienangebot in der Drôme Provençale, dem Ventoux, dem Luberon und den Alpilles zu unterbreiten."
    ],
    "en": [
      "11 agencies in Provence since 1960! At your service for 3 generations, we offer you a wide selection of properties in the Drôme Provençale, Upper Vaucluse and the Enclave des Papes. Visit our web site!"
    ],
    "it": [
      "Immobili in Provenza dal 1960.\r\nAl vostro servizio da 3 generazioni, cerchiamo di offrirvi i migliori immobili nella Drôme Provençale, nel Ventoux, nel Luberon e nelle Alpilles."
    ],
    "fr": [
      "Immobilier en Provence depuis 1960.\r\nA votre service depuis 3 générations, nous nous efforçons de vous proposer la meilleure offre immobilière sur le secteur de la Drôme Provençale, du Ventoux, du Luberon et des Alpilles."
    ],
    "es": [
      "Inmobiliaria en Provenza desde 1960.\r\nA su servicio desde hace 3 generaciones, nos esforzamos por ofrecerle las mejores propiedades inmobiliarias en las zonas de Drôme Provençale, Ventoux, Luberon y Alpilles."
    ],
    "nl": [
      "Al sinds 3 generaties tot uw dienst, ons kantoor is opgestart in 1960. We bieden u een groot aanbod van bezittingen in de Drôme Provençale, Haut Vaucluse en de Enclave des Papes. Bezoek onze website."
    ]
  },
