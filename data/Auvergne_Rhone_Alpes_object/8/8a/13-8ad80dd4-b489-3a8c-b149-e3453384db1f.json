  "rdfs:comment": {
    "de": [
      "Warme und freundliche Atmosphäre. Snacking, salzige und süße Pfannkuchen, hausgemachte Waffeln, hausgemachtes Eis, Getränke und Weinproben, nonstop serviert vor Ort oder zum Mitnehmen. Innen oder Terrasse"
    ],
    "en": [
      "Warm and friendly atmosphere. Snacks, sweet and savoury pancakes, homemade waffles, homemade ice creams, drinks and wine discovery, non-stop served on site or to take away. Interior or terrace."
    ],
    "it": [
      "Atmosfera calda e accogliente. Snack, crêpes dolci e salate, waffles fatti in casa, gelati artigianali e ghiaccio italiano, bevande e degustazioni di vini, serviti sul posto o da asporto senza interruzioni. Al coperto o in terrazza."
    ],
    "fr": [
      "Ambiance chaleureuse et conviviale. Snacking, crêpes salées et sucrées, gaufres faites maison, glaces artisanales et glaces à l'italienne, boissons et découverte des vins, servis sur place ou à emporter en non-stop. Intérieur ou terrasse."
    ],
    "nl": [
      "Warme en vriendelijke sfeer. Snacks, zoete en hartige flensjes, zelfgemaakte wafels, zelfgemaakt ijs, drankjes en wijnproeverijen, ter plekke geserveerd of om mee te nemen. Binnen of op het terras."
    ],
    "es": [
      "Ambiente cálido y acogedor. Aperitivos, crepes dulces y salados, gofres caseros, helados artesanos y hielo italiano, bebidas y degustación de vinos, servidos en el local o para llevar sin parar. En el interior o en la terraza."
    ]
  },
