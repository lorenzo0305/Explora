  "rdfs:comment": {
    "de": [
      "Fleisch von Charolais-Rindern\r\nAusschließlich ohne Silage aufgezogen\r\nAufgewachsen mit Heu und Getreide, das auf dem Betrieb erzeugt wird\r\nVerkauf in Kisten, Paketen und Einzelhandel auf Bestellung\r\n\r\nFreie oder geführte Besichtigungen, einzeln oder in Gruppen auf Anfrage"
    ],
    "en": [
      "Charolais beef\r\nRaised exclusively without silage\r\nRaised on hay and cereals produced on the farm\r\nSales in boxes, parcels and retail by order\r\n\r\nSelf-guided or guided tours, individual or group on request"
    ],
    "it": [
      "Carne di Charolais\r\nAllevato esclusivamente senza insilati\r\nAllevato con fieno e cereali prodotti in azienda\r\nVenduta in scatole, pacchi e al dettaglio su ordinazione\r\n\r\nVisite autogestite o guidate, individuali o di gruppo su richiesta"
    ],
    "fr": [
      "Viande charolaise \r\nÉlevées exclusivement sans ensilage\r\nÉlevées avec le foin et les céréales produit sur l'exploitation\r\nVente en caissette, colis et détail sur commande\r\n\r\nVisites libres ou guidées, individuelles ou groupées sur demande"
    ],
    "nl": [
      "Charolais vlees\r\nUitsluitend gehouden zonder kuilvoer\r\nGefokt op hooi en granen geproduceerd op de boerderij\r\nVerkocht in dozen, pakketten en detailhandel op bestelling\r\n\r\nRondleidingen, individueel of in groep op aanvraag"
    ],
    "es": [
      "Carne Charolais\r\nCriado exclusivamente sin ensilado\r\nCriado con heno y cereales producidos en la granja\r\nSe vende en cajas, paquetes y al por menor por encargo\r\n\r\nVisitas autoguiadas o guiadas, individuales o en grupo previa petición"
    ]
  },
