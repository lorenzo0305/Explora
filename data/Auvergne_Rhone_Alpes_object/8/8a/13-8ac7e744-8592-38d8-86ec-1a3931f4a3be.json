  "rdfs:comment": {
    "de": [
      "Das Hotel befindet sich in einer ehemaligen Seidenmühle aus dem 18. Jahrhundert, mitten in der Natur, in ruhiger Lage, weit weg von der Hektik. Zimmer und Suiten unterschiedlicher Größe sind für ein hohes Maß an Komfort ausgestattet. Swimmingpool und privater Zugang zum Fluss."
    ],
    "en": [
      "The hotel is in a former silk mill in a leafy setting: you'll love its peace, nature and tranquillity. Premium rooms and suites in different sizes."
    ],
    "it": [
      "L'hotel è situato in un antico mulino da seta del XVIII secolo nel cuore della natura, in un luogo tranquillo, lontano dal caos e dalla confusione. Camere e suite di diverse dimensioni e dotate di un elevato livello di comfort. Piscina e accesso privato al fiume."
    ],
    "fr": [
      "L'hôtel est implanté dans un ancien moulinage de la soie du 18ème siècle au coeur de la nature, au calme, loin de l'agitation. Chambres et suites de taille différentes et équipées pour un haut niveau de confort. Piscine et accès privé à la rivière."
    ],
    "nl": [
      "Het hotel is gevestigd in een oude zijdespinnerij uit de 18e eeuw, midden in de natuur, op een rustige plek, ver van de drukte. Kamers en suites van verschillende grootte en uitgerust voor een hoog niveau van comfort. Zwembad en privé toegang tot de rivier."
    ],
    "es": [
      "El hotel está situado en una antigua fábrica de seda del siglo XVIII en plena naturaleza, en un lugar tranquilo, lejos del bullicio. Habitaciones y suites de diferentes tamaños y equipadas para un alto nivel de confort. Piscina y acceso privado al río."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel Domaine de l'Eau Vive"
    ],
    "fr": [
      "Hôtel Domaine de l'Eau Vive"
    ]
  },
