  "rdfs:comment": {
    "de": [
      "Traditionelle Herstellung von Ziegenkäse, der mit der Kelle geformt wird.\r\nWeißer Käse, halbtrockener Käse, trockener Käse, Blauschimmelkäse und Aschenkäse. Joghurt aus Ziegenmilch\r\nWeidehaltung und betriebseigenes Futter für die Herde von 35 Ziegen\r\nProduktion von Eiern."
    ],
    "en": [
      "Traditional production of ladle-molded goat cheeses.\r\nWhite, semi-dry, dry, blue and ashy cheeses. Goat yogurts\r\nGrazing and feed produced on the farm for the 35-goat herd\r\nEgg production."
    ],
    "it": [
      "Produzione tradizionale di formaggi di latte di capra mestolati.\r\nFormaggi bianchi, semisecchi, secchi, erborinati e cenerini. Yogurt di capra\r\nPascolo e mangimi prodotti in azienda per la mandria di 35 capre\r\nProduzione di uova."
    ],
    "fr": [
      "Production traditionnelle de fromages de chèvres, moulés à la louche.\r\nFromages blancs, fromages mi-secs, secs, bleus et cendrés. Yaourts de chèvres\r\nPâturage et alimentation produite sur l 'exploitation pour le troupeau de 35 chèvres\r\nProduction d'oeufs."
    ],
    "nl": [
      "Traditionele productie van opgeschepte geitenkazen.\r\nWitte, halfdroge, droge, blauwe en asachtige kazen. Geiten yoghurt\r\nWeidegang en voer geproduceerd op de boerderij voor de 35 geiten tellende kudde\r\nEierproductie."
    ],
    "es": [
      "Producción tradicional de quesos de cabra en cucharón.\r\nQuesos blancos, semisecos, secos, azules y cenizos. Yogures de cabra\r\nPastos y piensos producidos en la explotación para el rebaño de 35 cabras\r\nProducción de huevos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La chèvrerie des près"
    ]
  },
