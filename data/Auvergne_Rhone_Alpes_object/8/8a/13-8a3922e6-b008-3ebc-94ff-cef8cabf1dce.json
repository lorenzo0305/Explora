  "rdfs:comment": {
    "de": [
      "Die Magnetic Bar und das Restaurant sind für alle offen und bieten Ihnen die Möglichkeit, im Herzen des Geschäftsviertels eine Gourmetpause einzulegen."
    ],
    "en": [
      "Open to all, the Magnetic bar and restaurant allow you to take a gourmet break in the heart of the business district."
    ],
    "it": [
      "Aperto a tutti, il bar e il ristorante Magnetic consentono di fare una pausa gastronomica nel cuore del quartiere degli affari."
    ],
    "fr": [
      "Ouverts à tous, le Magnetic bar et restaurant vous permettent de faire une pause gourmande au cœur du quartier d'affaire."
    ],
    "nl": [
      "De Magnetic bar en het restaurant staan open voor iedereen en bieden u de mogelijkheid om een gastronomische pauze te nemen in het hart van de zakenwijk."
    ],
    "es": [
      "Abiertos a todo el mundo, el bar y el restaurante Magnetic le permiten hacer una pausa gastronómica en el corazón del distrito de negocios."
    ]
  },
