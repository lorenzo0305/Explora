  "rdfs:comment": {
    "de": [
      "Staunen Sie über die Schönheit eines natürlichen Sees, entdecken Sie seine wilde Küste, während Sie an der Abbaye d'Hautecombe vorbeifahren, einem Zisterziensergebäude aus dem 12. Jahrhundert, das den See überragt."
    ],
    "en": [
      "Marvel at the beauty of a natural lake, discover its wild coast passing by the Hautecombe Abbey, a 12th century Cistercian building overlooking the lake."
    ],
    "it": [
      "Stupitevi davanti alla bellezza di un lago naturale, scoprite la sua costa selvaggia passando davanti all'Abbazia di Hautecombe, edificio cistercense del XII secolo che domina il lago."
    ],
    "fr": [
      "Émerveillez-vous devant la beauté d’un lac naturel, découvrez sa côte sauvage en passant devant l’Abbaye d’Hautecombe, édifice cistercien du XIIe siècle qui surplombe le lac."
    ],
    "es": [
      "Maravíllese con la belleza de un lago natural, descubra su costa salvaje mientras pasa por la abadía de Hautecombe, un edificio cisterciense del siglo XII que domina el lago."
    ],
    "nl": [
      "Bewonder de schoonheid van een natuurlijk meer, ontdek de wilde kustlijn terwijl u langs de abdij van Hautecombe komt, een cisterciënzergebouw uit de 12e eeuw dat uitkijkt over het meer."
    ]
  },
  "rdfs:label": {
    "en": [
      "Heritage Cruise - Abbaye d'Hautecombe"
    ],
    "it": [
      "Croisière Promenade Patrimoine - Abbaye Hautecombe"
