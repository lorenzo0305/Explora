  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/682a3e6f-008a-357d-84c2-93f640e62aee",
      "dc:description": {
        "de": [
          "Club der älteren Menschen.\nHilfe für alleinstehende und ältere Menschen, Treffen in geselliger Runde, Ausflüge zu Veranstaltungen, Animation, Tanztee, Lotto, Gesundheits- und Rettungsworkshop, Spiele im Gemeindesaal"
        ],
        "en": [
          "Club of the seniors\nHelp to the lonely and old person, meeting in a friendly place, show outing, animation, tea dance, bingo, Health and rescue workshop, animation games in the community hall"
        ],
        "it": [
          "Club degli anziani.\nAiuto alle persone anziane e sole, incontri in un ambiente amichevole, uscite per spettacoli, intrattenimento, balli del tè, bingo, laboratori sulla salute e sul primo soccorso, giochi nella sala del villaggio"
        ],
        "fr": [
          "Club des aînés. \nAide a la personne seule et âgée , rencontre en lieu convivial , sortie spectacle , animation , thé dansant , loto , atelier Santé et secours , animation jeux en salle communale"
        ],
        "nl": [
          "Seniorenclub.\nHulp voor eenzame en oudere mensen, bijeenkomsten in een vriendelijke omgeving, uitstapjes naar shows, entertainment, theedansen, bingo, gezondheids- en EHBO-workshops, spelletjes in het dorpshuis"
        ],
        "es": [
          "Club de la tercera edad.\nAyuda a personas mayores y solas, reuniones en un entorno agradable, salidas a espectáculos, entretenimiento, bailes de té, bingo, talleres de salud y primeros auxilios, juegos en el salón del pueblo"
        ]
      },
      "@type": [
        "Description"
      ],
