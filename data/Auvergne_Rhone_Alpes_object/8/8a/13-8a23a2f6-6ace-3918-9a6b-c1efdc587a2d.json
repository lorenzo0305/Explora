  "rdfs:comment": {
    "de": [
      "Biobäckerei, die zahlreiche Brotsorten anbietet, die alle mit Natursauerteig gebacken werden. Außerdem bietet sie Gebäck und Kekse an. Um alle ihre Produkte kennenzulernen, besuchen Sie ihre Website."
    ],
    "en": [
      "Organic bakery offering many breads, all with natural leaven. It also offers pastries and biscuits. To know all their products, visit their website."
    ],
    "it": [
      "Panificio biologico che offre un'ampia gamma di pani, tutti prodotti con lievito naturale. Offrono anche dolci e biscotti. Per conoscere tutti i loro prodotti, visitate il loro sito web."
    ],
    "fr": [
      "Boulangerie bio proposant de nombreux pains, tous au levain naturel. Elle propose également des viennoiseries et des biscuits. Pour connaitre l'ensemble de leurs produits, visitez leur site internet."
    ],
    "es": [
      "Panadería ecológica que ofrece una amplia gama de panes, todos ellos elaborados con levadura natural. También ofrecen bollería y galletas. Para conocer todos sus productos, visite su sitio web."
    ],
    "nl": [
      "Biologische bakkerij met een breed scala aan broden, allemaal gemaakt met natuurlijke zuurdesem. Ze bieden ook gebak en koekjes aan. Bezoek hun website voor meer informatie over al hun producten."
    ]
  },
