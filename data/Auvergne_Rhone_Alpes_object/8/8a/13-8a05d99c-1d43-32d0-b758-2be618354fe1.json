  "rdfs:comment": {
    "de": [
      "Das Hotel Ibis Loriol/Le Pouzin verbindet Natur und Modernität und liegt ideal am Fuße der Berge der Ardèche, am Ufer der Rhône und des Radwegs ViaRhôna (vom Genfer See bis zum Mittelmeer)."
    ],
    "en": [
      "The Ibis Loriol Le Pouzin Hotel brings together nature and modern architecture and is the perfect location at the foot of the Ardeche mountains, on the banks of the Rhône by the ViaRhôna cycle path (from Lake Geneva to the Med)."
    ],
    "it": [
      "Combinando natura e modernità, l'hotel Ibis Loriol/Le Pouzin è situato in posizione ideale ai piedi delle montagne dell'Ardèche, sulle rive del Rodano e della pista ciclabile ViaRhôna (dal Lago di Ginevra al Mediterraneo)."
    ],
    "fr": [
      "Alliant nature et modernité, l'hôtel Ibis Loriol/Le Pouzin est idéalement situé au pied des montagnes de l'Ardèche, au bord du Rhône et de la piste cyclable ViaRhôna (du Léman à la Méditerranée)."
    ],
    "nl": [
      "Het Ibis-hotel Loriol/Le Pouzin, dat natuur en moderniteit combineert, is ideaal gelegen aan de voet van de bergen van de Ardèche, aan de oevers van de Rhône en het fietspad ViaRhôna (van het meer van Genève naar de Middellandse Zee)."
    ],
    "es": [
      "Combinando naturaleza y modernidad, el hotel Ibis Loriol/Le Pouzin está idealmente situado a los pies de las montañas de Ardèche, a orillas del Ródano y del carril bici ViaRhôna (del lago de Ginebra al Mediterráneo)."
    ]
  },
