  "rdfs:comment": {
    "de": [
      "Entdecken Sie Marcel?s Farm, die Spielpiste im Sektor Les Grandes Rousses 1800!\r\nWhoops, Tunnel, Slalom und bunte Figuren bestimmen den Rhythmus der Abfahrt und sorgen für Spaß mit der ganzen Familie."
    ],
    "en": [
      "Discover Marcel's Farm, the fun run in the Grandes Rousses 1800 area!\nWhoops, tunnel, slalom and colorful figurines punctuate the descent for family fun."
    ],
    "it": [
      "Scoprite la Fattoria di Marcel, il percorso di divertimento nell'area delle Grandes Rousses 1800!\r\nSalti, tunnel, slalom e figurine colorate punteggiano la discesa per il divertimento della famiglia."
    ],
    "fr": [
      "Découvrez Marcel’s Farm, la piste ludique du secteur des Grandes Rousses 1800 !\r\nWhoops, tunnel, slalom et figurines colorées rythment la descente pour s’amuser en famille."
    ],
    "es": [
      "¡Descubra la Granja de Marcel, el recorrido lúdico de la zona de Grandes Rousses 1800!\r\nWhoops, túnel, slalom y figuritas de colores jalonan el descenso para divertirse en familia."
    ],
    "nl": [
      "Ontdek Marcel's Farm, de fun run in het Grandes Rousses 1800 gebied!\nOprollen, tunnels, slalommen en kleurrijke figuurtjes maken de afdaling tot een plezier voor het hele gezin."
    ]
  },
  "rdfs:label": {
    "en": [
      "Marcel's Farm play trail"
    ],
    "fr": [
      "Piste ludique Marcel's Farm"
    ],
    "nl": [
      "Marcel's Farm speelpad"
    ]
  },
