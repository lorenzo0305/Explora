  "rdfs:comment": {
    "de": [
      "Auf 700 m Höhe, im Herzen des regionalen Naturparks Livradois-Forez, 300 m vom Stadtzentrum von Cunlhat entfernt, können Sie Golf und Footgolf (ein atypisches Ballspiel, das Sie mit Freunden oder der Familie ausüben können) entdecken."
    ],
    "en": [
      "A golf course immersed in the natural landscapes of Livradois. Also discover an unusual ball sport: footgolf (9 holes).\r\nA sport that combines fun and concentration, to enjoy with friends or family."
    ],
    "it": [
      "A 700 m di altitudine, nel cuore del Parco Naturale Regionale Livradois-Forez, a 300 m dal centro di Cunlhat, venite a scoprire il golf e il footgolf (un insolito gioco con la palla da praticare con gli amici o in famiglia)."
    ],
    "fr": [
      "À 700 m d'altitude, au cœur du Parc naturel régional  Livradois-Forez, à 300 m du centre-bourg de Cunlhat, venez découvrir le golf et le footgolf (un jeu de balle atypique à pratiquer entre amis ou famille)."
    ],
    "nl": [
      "Op 700 m hoogte, in het hart van het regionale natuurpark Livradois-Forez, op 300 m van het centrum van Cunlhat, kunt u kennismaken met golf en footgolf (een ongewoon balspel om met vrienden of familie van te genieten)."
    ],
    "es": [
      "A 700 m de altitud, en el corazón del Parque Natural Regional de Livradois-Forez, a 300 m del centro de Cunlhat, venga a descubrir el golf y el footgolf (un juego de pelota fuera de lo común para disfrutar entre amigos o en familia)."
    ]
  },
