          "additionalInformation": {
            "de": [
              "Öffnungszeiten in den kleinen Schulferien (Schwimmbad & Spa).\r\n\r\nZone A: Akademie von Grenoble\r\nMontag bis Samstag: 12h ? 18h\r\nSonntag: 9h ? 14\r\n\r\nDie Öffnungszeiten des Spas sind identisch mit den Öffnungszeiten des Schwimmbads während der kleinen Schulferien."
            ],
            "en": [
              "Opening times for short school vacations (pool & spa).\r\n\r\nZone A: Grenoble Academy\r\nMonday to Saturday: 12h ? 18h\r\nSunday: 9 am to 2 pm\r\n\r\nSpa opening times are the same as pool opening times during school vacations."
            ],
            "it": [
              "Orari di apertura per le vacanze scolastiche brevi (piscina e spa).\r\n\r\nZona A: Accademia Grenoble\r\nDa lunedì a sabato: dalle 12:00 alle 18:00\r\nDomenica: dalle 9.00 alle 14.00\r\n\r\nGli orari di apertura delle terme coincidono con quelli delle piscine durante le vacanze scolastiche."
            ],
            "fr": [
              "Horaires petites vacances scolaires (piscine & spa).\r\n\r\nZone A : Académie de Grenoble\r\nDu lundi au samedi : 12h – 18h\r\nDimanche : 9h – 14\r\n\r\nLes horaires du spa sont identiques aux horaires d’ouverture de la piscine pendant les petites vacances scolaires."
            ],
            "nl": [
              "Openingstijden voor korte schoolvakanties (zwembad & spa).\r\n\r\nZone A: Academie Grenoble\r\nMaandag tot zaterdag: 12u tot 18u\r\nZondag: 9u tot 14u\r\n\r\nDe openingstijden van de spa zijn gelijk aan die van het zwembad tijdens de schoolvakanties."
            ],
            "es": [
              "Horarios de apertura durante las vacaciones escolares cortas (piscina y spa).\r\n\r\nZona A: Academia Grenoble\r\nDe lunes a sábado: de 12:00 a 18:00\r\nDomingo: de 9.00 a 14.00\r\n\r\nLos horarios de apertura del spa coinciden con los de la piscina durante las vacaciones escolares."
            ]
          },
