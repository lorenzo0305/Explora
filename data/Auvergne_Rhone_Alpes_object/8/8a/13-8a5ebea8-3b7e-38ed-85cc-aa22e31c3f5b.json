  "rdfs:comment": {
    "de": [
      "Als Bergbegleiter in den Regionen Trièves, Vercors und Dévoluy biete ich maßgeschneiderte Ausflüge (1/2 Tag, Tag, Aufenthalt, Biwak...), für alle Altersgruppen und insbesondere für Menschen mit Behinderungen."
    ],
    "en": [
      "As a mountain leader in the Trièves, Vercors and Dévoluy regions, I offer tailor-made outings (1/2 day, full day, stays, bivouacs, etc.) for all types of public, and particularly for people with disabilities."
    ],
    "it": [
      "Guida alpina nel Trièves, nel Vercors e nel Dévoluy, propongo escursioni su misura (mezza giornata, giornata intera, soggiorni, bivacchi...), per tutti i tipi di pubblico e in particolare per le persone con disabilità."
    ],
    "fr": [
      "Accompagnateur en montagne sur le Trièves ,Vercors et Dévoluy, je propose des sorties sur mesure (1/2 journée, journée, séjours, bivouacs...)., pour tous publics, et notamment pour les personnes en situation de handicap."
    ],
    "es": [
      "Guía de montaña en las Trièves, Vercors y Dévoluy, ofrezco salidas a medida (media jornada, jornada completa, estancias, vivacs...), para todos los públicos, y en particular para personas con discapacidad."
    ],
    "nl": [
      "Berggids in de Trièves, Vercors en Dévoluy, ik bied uitstapjes op maat (halve dag, hele dag, verblijf, bivak...), voor alle publiek, en in het bijzonder voor mensen met een handicap."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Christian Diénot - accompagnateur en montagne"
    ]
  },
