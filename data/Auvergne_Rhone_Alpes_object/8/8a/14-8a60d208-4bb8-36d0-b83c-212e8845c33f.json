  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6857691d-a914-3942-9664-9ce2ddb7ee24",
      "dc:description": {
        "de": [
          "Between ist ein echter Dialog zwischen visueller Kunst, Choreographie und Musik und wird Sie in die Werke der Ausstellung Second souffle eintauchen lassen."
        ],
        "en": [
          "A veritable dialogue between the visual arts, choreography and music, Between will immerse you in the works in the Second souffle exhibition, with dance impromptus punctuating the evening in the majestic shower room at 9-9bis."
        ],
        "it": [
          "Vero e proprio dialogo tra arti visive, coreografia e musica, Between vi immergerà nelle opere della mostra Second souffle, con danze improvvisate che scandiranno la serata nella maestosa Salle des Douches del 9-9bis."
        ],
        "fr": [
          "Véritable dialogue entre arts visuels, chorégraphie et musique, Between vous plongera dans les œuvres de l’exposition Second souffle lors d’impromptus dansés qui viendront ponctuer la soirée au sein de la majestueuse salle des douches du 9-9bis."
        ],
        "es": [
          "Verdadero diálogo entre las artes plásticas, la coreografía y la música, Between le sumergirá en las obras de la exposición Second souffle, con improvisadas actuaciones de danza a lo largo de la velada en la majestuosa Salle des Douches del 9-9bis."
        ],
        "nl": [
          "Between, een echte dialoog tussen beeldende kunst, choreografie en muziek, dompelt je onder in de werken van de tentoonstelling Second souffle, met geïmproviseerde dansen die de avond opluisteren in de majestueuze Salle des Douches op 9-9bis."
        ]
      },
