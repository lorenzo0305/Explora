  "rdfs:comment": {
    "de": [
      "Nur die Außenanlagen und der Garten können besichtigt werden.\r\nDas feudale Schloss Saint-Gérand-le-Puy stammt aus dem Jahr 1200 und wurde von den Bourbonen, den Herren von Bourbon-l'Archambault, erbaut."
    ],
    "en": [
      "Visit of the exterior and the garden only.\r\nThe feudal castle of Saint-Gérand-le-Puy dates from 1200 and was built by the Bourbons, lords of Bourbon-l?Archambault."
    ],
    "it": [
      "Visita solo dell'esterno e del giardino.\r\nIl castello feudale di Saint-Gérand-le-Puy risale al 1200 e fu costruito dai Borboni, signori di Bourbon-l'Archambault."
    ],
    "fr": [
      "Visite des extérieurs et du jardin uniquement. \r\nLe château féodal de Saint-Gérand-le-Puy date de 1200 et a été bâti par les Bourbons, seigneurs de Bourbon-l’Archambault."
    ],
    "es": [
      "Visita del exterior y del jardín únicamente.\r\nEl castillo feudal de Saint-Gérand-le-Puy data de 1200 y fue construido por los Borbones, señores de Bourbon-l'Archambault."
    ],
    "nl": [
      "Bezoek van het exterieur en de tuin alleen.\r\nHet feodale kasteel van Saint-Gérand-le-Puy dateert uit 1200 en werd gebouwd door de Bourbons, heren van Bourbon-l?Archambault."
    ]
  },
