  "rdfs:comment": {
    "de": [
      "Das Hotel Le Néron liegt im Herzen der Alpen und vor den Toren von Grenoble. Es bietet Ihnen hochwertige Zimmer in einer freundlichen Umgebung. Das Restaurant l'Arbre Bleu, Maître Restaurateur, bietet eine lokale und qualitativ hochwertige Speisekarte. Erreichbar über die A13, A14"
    ],
    "en": [
      "Located in the heart of the Alps at the gateway to Grenoble, Hotel Le Néron offers quality rooms in a friendly environment. The Arbre Bleu restaurant, a master restaurateur, offers a local, high-quality menu. Accessible from A13, A14"
    ],
    "it": [
      "Situato nel cuore delle Alpi e alle porte di Grenoble, l'hotel Le Néron offre camere di qualità in un ambiente amichevole. L'hotel è ben collegato con le autostrade A48 e A49. Parcheggio chiuso, videosorvegliato. Wifi gratis."
    ],
    "fr": [
      "Situé au cœur des Alpes, aux portes de Grenoble, l’Hôtel Le Néron propose des chambres confortables dans un cadre convivial. Son restaurant, L’Arbre Bleu, Maître Restaurateur, offre une cuisine de qualité aux saveurs locales. Accès facile depuis l’A48."
    ],
    "es": [
      "Situado en el corazón de los Alpes y a las afueras de Grenoble, el Hotel Le Néron ofrece habitaciones de calidad en un ambiente acogedor. El restaurante Arbre Bleu, un maestro restaurador, ofrece un menú local de gran calidad. Accesible desde las autopistas A13 y A14."
    ],
    "nl": [
      "Hôtel Le Néron ligt in het hart van de Alpen, net buiten Grenoble, en biedt comfortabele kamers in een vriendelijke omgeving. Het restaurant, L'Arbre Bleu, Maître Restaurateur, biedt kwaliteitsgerechten met een lokaal tintje. Gemakkelijk bereikbaar vanaf de A48."
    ]
  },
