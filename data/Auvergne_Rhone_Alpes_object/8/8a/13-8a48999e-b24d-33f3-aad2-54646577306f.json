  "rdfs:comment": {
    "de": [
      "Das Fort de Tamié liegt zwischen Albertville und Faverges auf 1000 m Höhe und bietet Ihnen einen Wanderweg und Picknickplätze mit einer atemberaubenden Aussicht auf die umliegenden Täler und Bergmassive."
    ],
    "en": [
      "Located between Albertville and Faverges, at 1000 meters above sea level, the Fort of Tamié offers you a walking trail and picnic areas with breathtaking views of the surrounding valleys and mountain ranges."
    ],
    "it": [
      "Situato tra Albertville e Faverges, a 1.000 metri di altitudine, il Forte di Tamié offre un sentiero e aree picnic con una vista mozzafiato sulle valli e le catene montuose circostanti."
    ],
    "fr": [
      "Situé entre Albertville et Faverges,  à 1000 mètres d'altitude, le Fort de Tamié vous offre un sentier de promenade et des aires de pique-nique avec une vue imprenable sur les vallées et massifs montagneux environnants."
    ],
    "es": [
      "Situado entre Albertville y Faverges, a 1.000 metros de altitud, Fort de Tamié ofrece un sendero y zonas de picnic con vistas ininterrumpidas de los valles y cordilleras circundantes."
    ],
    "nl": [
      "Fort de Tamié ligt tussen Albertville en Faverges, op 1000 meter hoogte, en biedt een wandelpad en picknickplaatsen met een adembenemend uitzicht op de omliggende valleien en bergketens."
    ]
  },
