  "rdfs:comment": {
    "de": [
      "Tierärzte und ASV sind von Montag bis Samstagmittag einsatzbereit, um Sie zu empfangen und sich um Ihre Haus- und Nutztiere zu kümmern."
    ],
    "en": [
      "Veterinarians and ASVs are on hand from Monday to Saturday lunchtime to welcome and care for your pets and livestock."
    ],
    "it": [
      "Veterinari e medici veterinari sono a disposizione dal lunedì al sabato a pranzo per accogliervi e prendersi cura dei vostri animali domestici e del vostro bestiame."
    ],
    "fr": [
      "Vétérinaires et ASV sont opérationnels du lundi au samedi midi pour vous accueillir et prendre soin de vos animaux domestiques et d'élevages."
    ],
    "es": [
      "Veterinarios y cirujanos veterinarios están a su disposición de lunes a sábado al mediodía para recibirle y cuidar de sus animales de compañía y ganado."
    ],
    "nl": [
      "Dierenartsen en veeartsen staan van maandag tot zaterdagmiddag klaar om je te verwelkomen en voor je huisdieren en vee te zorgen."
    ]
  },
  "rdfs:label": {
