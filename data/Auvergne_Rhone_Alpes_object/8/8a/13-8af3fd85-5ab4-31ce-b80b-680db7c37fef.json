  "rdfs:comment": {
    "de": [
      "Tagsüber ist auf der Terrasse an der Pistenfront viel los. Skifahrer der ersten Stunde, Sonnenanbeter und Après-Ski-Liebhaber mischen sich untereinander."
    ],
    "en": [
      "During the day, \"the\" terrace at the front of the slopes welcomes first-time skiers, sun worshippers and après-ski enthusiasts."
    ],
    "it": [
      "Durante il giorno, la terrazza sul pendio è un brulicare di attività. Sciatori alle prime armi, amanti del sole e del doposci si mescolano."
    ],
    "fr": [
      "Le jour, « la » terrasse du front de pistes brasse. Skieurs de la première heure, amateurs de plein soleil et mordus de l’après-ski s’entremêlent."
    ],
    "nl": [
      "Overdag is het terras aan de piste een drukte van belang. Beginnende skiërs, zonaanbidders en après-ski liefhebbers mengen zich onder elkaar."
    ],
    "es": [
      "Durante el día, la terraza a pie de pista es un hervidero de actividad. Esquiadores principiantes, amantes del sol y aficionados al après-ski se mezclan."
    ]
  },
