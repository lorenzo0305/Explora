  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, einen schönen Moment rund um das Spiel zu teilen?\r\nIm The Roof Vercors finden Abende mit Gesellschaftsspielen statt, die von La Diagonale du Fou und Jeu Dé Bloc mitorganisiert werden."
    ],
    "en": [
      "Want to share a good time around games?\r\nThe Roof Vercors hosts board game evenings co-hosted by La Diagonale du Fou and Jeu Dé Bloc."
    ],
    "it": [
      "Volete condividere un bel momento di gioco?\r\nIl Roof Vercors ospita serate di giochi da tavolo organizzate da La Diagonale du Fou e Jeu Dé Bloc."
    ],
    "fr": [
      "Envie de partager un bon moment autour du jeu ?\r\nThe Roof Vercors accueille des soirées animation de jeux de société co-animées par La Diagonale du Fou et Jeu Dé Bloc."
    ],
    "es": [
      "¿Quiere compartir un buen rato en torno a los juegos?\r\nEl Roof Vercors acoge veladas de juegos de mesa coorganizadas por La Diagonale du Fou y Jeu Dé Bloc."
    ],
    "nl": [
      "Zin in een leuke tijd met spelletjes?\r\nOp Roof Vercors worden gezelschapsspellenavonden georganiseerd door La Diagonale du Fou en Jeu Dé Bloc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirées Animation Jeux de Société au Roof"
    ]
  },
