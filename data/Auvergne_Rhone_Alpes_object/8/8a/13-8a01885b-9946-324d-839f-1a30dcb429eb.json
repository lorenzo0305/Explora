  "rdfs:comment": {
    "de": [
      "Das FAST FOOD in Le Lioran! Im Herzen des Ortes finden Sie alle neuen Trends in \"Hausmacherqualität\" und im SCHUSS-Modus!\r\nEntdecken Sie die MAXI Hamburger, Paninis, große Pizzen oder Flammkuchen, heiße und kalte Getränke."
    ],
    "en": [
      "The FAST FOOD of Le Lioran! In the heart of the resort, you'll find all the latest trends in \"home-made\" quality in SCHUSS style!\r\nDiscover MAXI Hamburgers, Paninis, large pizzas or flammenkueches, hot and cold drinks."
    ],
    "it": [
      "Il FAST FOOD di Lioran! Nel cuore del resort, tutte le nuove tendenze della qualità \"Home-made\" in modalità SCHUSS!\r\nScoprite i suoi MAXI Hamburger, Panini, grandi pizze o flammenkueches, bevande calde e fredde."
    ],
    "fr": [
      "Le FAST FOOD du Lioran! Au coeur de la station, toutes les nouvelles tendances qualité \"Maison\" en mode SCHUSS!\r\nDécouvrez ses MAXI Hamburgers, Paninis ses grandes pizzas ou flammenkueches,  boissons chaudes, froides."
    ],
    "es": [
      "¡La comida rápida de Lioran! ¡En el corazón de la estación, todas las nuevas tendencias en calidad \"Home-made\" en modo SCHUSS!\r\nDescubre sus hamburguesas MAXI, paninis, pizzas grandes o flammenkueches, bebidas calientes y frías."
    ],
    "nl": [
      "Het FAST FOOD van Lioran! In het hart van het resort, alle nieuwe trends in \"Home-made\" kwaliteit in SCHUSS mode!\r\nOntdek zijn MAXI Hamburgers, Panini's, grote pizza's of flammenkueches, warme en koude dranken."
    ]
  },
