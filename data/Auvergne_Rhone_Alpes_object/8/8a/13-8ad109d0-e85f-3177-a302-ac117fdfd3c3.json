  "rdfs:comment": {
    "de": [
      "Eine vegane, biologische und lokale Küche\".\r\nLokale Produkte, verantwortungsvoller Spezialitätenkaffee, naturbelassene Weine und handwerklich gebraute Biere stehen zur Freude der Locavores zur Verfügung!"
    ],
    "en": [
      "Vegan, organic and local cuisine.\"\r\nLocal produce, responsible specialty coffee, natural wines and craft beers are all on the menu, to the delight of locavores!"
    ],
    "it": [
      "Cucina vegana, biologica e locale\"\r\nProdotti locali, caffè speciali responsabili, vini naturali e birre artigianali sono presenti nel menu, per la gioia dei locavores!"
    ],
    "fr": [
      "Une cuisine végétalienne, bio et locale.\"\r\nProduits locaux, café de spécialité responsable, vins natures et bières artisanales sont au rendez-vous, pour le plus grand plaisir des locavores !"
    ],
    "nl": [
      "Veganistische, biologische en lokale gerechten.\"\r\nLokale producten, verantwoorde speciale koffie, natuurlijke wijnen en ambachtelijke bieren staan op het menu, tot groot genoegen van de locavores!"
    ],
    "es": [
      "Cocina vegana, ecológica y local\".\r\nProductos locales, especialidades de café responsable, vinos naturales y cervezas artesanales forman parte del menú, ¡para deleite de los locávoros!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Locafé"
    ]
  },
