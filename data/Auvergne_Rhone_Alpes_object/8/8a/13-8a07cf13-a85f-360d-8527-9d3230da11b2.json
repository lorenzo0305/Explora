  "rdfs:comment": {
    "de": [
      "Anfänger können auf der grünen Piste \"Les Dames\", die speziell für sie angelegt wurde, das Skifahren in aller Sicherheit erlernen."
    ],
    "en": [
      "Approachable on skis from the top of the Jaillet gondola lift and also reachable from the Ravine chairlift, the Dames green slope has been redesigned to offer beginners a completely safe place to learn to ski."
    ],
    "it": [
      "Accessibile con gli sci dalla cima della telecabina dello Jaillet e servita dalla seggiovia Ravine, i principianti possono imparare a sciare in tutta sicurezza sulla pista verde delle Dames, completamente rinnovata."
    ],
    "fr": [
      "Accessible à ski depuis le sommet de la télécabine du Jaillet et desservie par le télésiège de la Ravine, les débutants pourront apprendre à skier en toute sécurité sur la piste verte des Dames aménagée spécialement pour eux."
    ],
    "nl": [
      "Toegankelijk op ski's vanaf de Jaillet gondel en bediend door de stoeltjeslift Ravine, kunnen beginners in alle veiligheid leren skiën op de groene piste Dames, die speciaal voor hen is aangelegd."
    ],
    "es": [
      "Accesible a esquiar desde la cima del telecabina de Jaillet y servida por el telesilla de la Ravine, módulos lúdicos a lo largo de la pista de las Damas para un aprendizaje del esquí más divertido."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ours des Prés fun ski slope"
    ],
    "it": [
      "Area luidica l'Ours des Prés"
    ],
    "fr": [
      "Espace ludique l'Ours des Prés"
    ],
    "es": [
      "Espacio lúdico \"L'Ours des Prés\""
    ]
  },
