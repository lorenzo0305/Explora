  "rdfs:comment": {
    "de": [
      "Machen Sie auf Ihrer Reise mit dem Fahrrad einen entspannten Zwischenstopp in Wien! Dank unserer sicheren Gepäckaufbewahrung können Sie die Stadt in aller Freiheit erkunden, ohne sich um Ihre Sachen sorgen zu müssen."
    ],
    "en": [
      "Stop off in Vienna with complete peace of mind on your cycling trip! Thanks to our secure lockers, you can explore the city in complete freedom, without worrying about your belongings."
    ],
    "it": [
      "Fate tappa a Vienna in tutta tranquillità durante il vostro viaggio in bicicletta! Grazie ai nostri armadietti sicuri, potrete esplorare la città in piena libertà, senza preoccuparvi dei vostri effetti personali."
    ],
    "fr": [
      "Faites une escale à Vienne en toute sérénité lors de votre voyage à vélo ! Grâce à notre consigne sécurisée, partez explorer la ville en toute liberté, sans vous soucier de vos affaires."
    ],
    "nl": [
      "Stop met een gerust hart in Wenen tijdens je fietstocht! Dankzij onze beveiligde kluisjes kun je de stad in alle vrijheid verkennen, zonder je zorgen te maken over je spullen."
    ],
    "es": [
      "Haga escala en Viena con toda tranquilidad durante su viaje en bicicleta Gracias a nuestras taquillas seguras, podrá explorar la ciudad con total libertad, sin preocuparse por sus pertenencias."
    ]
  },
  "rdfs:label": {
    "de": [
      "Schließfach in Vienne für Reiseradler"
    ],
    "en": [
      "Lockers in Vienne for bicycle touring"
    ],
    "fr": [
      "Consigne à Vienne pour les itinérants à vélo"
    ]
  },
