      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/ffe88b33-8548-3af6-971c-3a9d1c4bdca3",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Freies Eislaufen\r\nAußerhalb der Schulferien :\r\nMittwoch: 14-17.30 Uhr / 20.30-23.30 Uhr\r\nFreitag: 20.30-23.30\r\nSamstag: 14h-17h30 / 20h30-23h30\r\nSonntag: 14h-17h30\r\n\r\nWährend der Schulferien (Zone A) :\r\nTäglich: 14h-17h30\r\nMittwoch, Freitag und Samstag: 20.30-23.30 Uhr\r\n\r\nGarten aus Eis\r\nAußerhalb der Schulferien: Samstag und Sonntag: 10:00-12:30 Uhr.\r\n\r\nWährend der Schulferien (Zone A): Montag bis Sonntag, 10:00 bis 12:30 Uhr."
            ],
            "en": [
              "Free skating\r\nOutside school vacations :\r\nWednesday: 14h-17h30 / 20h30-23h30\r\nFriday: 8:30-11:30 pm\r\nSaturday: 2pm-5.30pm / 8.30pm-11.30pm\r\nSunday: 2pm-5.30pm\r\n\r\nDuring school vacations (zone A):\r\nDaily: 2pm-5.30pm\r\nWednesday, Friday and Saturday: 8:30-11:30 pm\r\n\r\nIce Garden\r\nOutside school vacations: Saturday and Sunday, 10am-12.30pm.\r\n\r\nDuring school vacations (zone A): Monday to Sunday, 10am to 12:30pm."
            ],
            "it": [
              "Pattinaggio libero\r\nAl di fuori delle vacanze scolastiche :\r\nMercoledì: 14.00-17.30 / 20.30-21.30\r\nVenerdì: 20.30-11.30\r\nSabato: 14.00-17.30 / 20.30-11.30\r\nDomenica: 14.00-17.30\r\n\r\nDurante le vacanze scolastiche (zona A):\r\nTutti i giorni: 14.00-17.30\r\nMercoledì, venerdì e sabato: 20.30 - 23.30\r\n\r\nGiardino del ghiaccio\r\nFuori dalle vacanze scolastiche: sabato e domenica, dalle 10.00 alle 12.30.\r\n\r\nDurante le vacanze scolastiche (zona A): da lunedì a domenica, dalle 10.00 alle 12.30."
            ],
            "fr": [
              "Patinage libre\r\nHors vacances scolaires :\r\nMercredi : 14h-17h30 / 20h30-23h30\r\nVendredi : 20h30-23h30\r\nSamedi : 14h-17h30 / 20h30-23h30\r\nDimanche : 14h-17h30\r\n\r\nPendant les vacances scolaires (zone A) :\r\nTous les jours : 14h-17h30\r\nMercredi, vendredi et samedi : 20h30-23h30\r\n\r\nJardin de glace\r\nHors vacances scolaires : samedi et dimanche, de 10h à 12h30.\r\n\r\nPendant les vacances scolaires (zone A) : du lundi au dimanche, de 10h à 12h30."
            ],
            "es": [
              "Patinaje libre\r\nFuera de las vacaciones escolares :\r\nMiércoles: 14:00-17:30 / 20:30-23:30\r\nViernes: de 20.30 h a 23.30 h\r\nSábado: 14:00-17:30 / 20:30-23:30\r\nDomingo: 14:00-17:30\r\n\r\nDurante las vacaciones escolares (zona A)\r\nTodos los días: de 14:00 a 17:30\r\nMiércoles, viernes y sábado: de 20.30 h. a 23.30 h\r\n\r\nJardín de hielo\r\nFuera de las vacaciones escolares: sábados y domingos, de 10.00 a 12.30 h.\r\n\r\nDurante las vacaciones escolares (zona A): de lunes a domingo, de 10.00 a 12.30 h."
            ],
            "nl": [
              "Gratis schaatsen\r\nBuiten schoolvakanties :\r\nWoensdag: 14u tot 17u30 / 20u30-11u30\r\nVrijdag: 20.30-11.30u\r\nZaterdag: 14u tot 17u30 / 20u30-11u30\r\nZondag: 14.00 - 17.30\r\n\r\nTijdens schoolvakanties (zone A):\r\nElke dag: 14u - 17u30\r\nWoensdag, vrijdag en zaterdag: 20.30-11.30 uur\r\n\r\nIjstuin\r\nBuiten de schoolvakanties: zaterdag en zondag van 10.00 tot 12.30 uur.\r\n\r\nTijdens schoolvakanties (zone A): maandag t/m zondag van 10.00 tot 12.30 uur."
            ]
          },
