  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1369bd1c-597a-3949-9eaf-14cce445651e",
      "dc:description": {
        "de": [
          "Sie singen gerne?\nKommen Sie zum Chor \"L'Enchanterelle\" und singen Sie im Chor!\n\nUnterricht jeden Donnerstagabend um 20:00 Uhr."
        ],
        "en": [
          "You like to sing?\nCome and join the choir \"L'Enchanterelle\" to sing in chorus!\n\nClasses every Thursday evening at 8:00 pm."
        ],
        "it": [
          "Le piace cantare?\nUnitevi al coro \"L'Enchanterelle\" per cantare in coro!\n\nLe lezioni si tengono ogni giovedì sera alle 20.00."
        ],
        "fr": [
          "Vous aimez chantez?\nVenez rejoindre la chorale \"L'Enchanterelle\" pour chanter en choeur !\n\nCours chaque jeudis soir à 20h00."
        ],
        "es": [
          "¿Te gusta cantar?\n¡Venga a unirse al coro \"L'Enchanterelle\" para cantar a coro!\n\nClases todos los jueves por la tarde a las 20 horas."
        ],
        "nl": [
          "Hou je van zingen?\nKom bij het koor \"L'Enchanterelle\" om in koor te zingen!\n\nLessen elke donderdagavond om 20.00 uur."
        ]
      },
