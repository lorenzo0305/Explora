      "dc:description": {
        "de": [
          "Boutique, Strandartikel und -spiele.\n\nLust, eine Bestellung aufzugeben?\nFinden Sie die Must-haves der Boutique, indem Sie auf die Schaltfläche \"Reservieren\" klicken"
        ],
        "en": [
          "Store, beach articles and games.\n\nWant to place an order?\nClick on the \"Reserve\" button to find out more about the store's must-haves"
        ],
        "it": [
          "Negozio, attrezzature da spiaggia e giochi.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Prenota\" per saperne di più sugli articoli essenziali del negozio"
        ],
        "fr": [
          "Boutique, articles et jeux de plage.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "nl": [
          "Winkel, strandspullen en spelletjes.\n\nWil je een bestelling plaatsen?\nKlik op de knop \"Reserveren\" voor meer informatie over de benodigdheden van de winkel"
        ],
        "es": [
          "Tienda, material de playa y juegos.\n\n¿Quieres hacer un pedido?\nHaga clic en el botón \"Reservar\" para obtener más información sobre los artículos esenciales de la tienda"
        ]
      },
