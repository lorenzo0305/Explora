  "rdfs:comment": {
    "de": [
      "Köstlichkeiten, Regionalität & Gemeinschaft\r\nTauchen Sie ein in eine Welt, in der die Leidenschaft für Hausgemachtes auf die Authentizität der Savoie trifft. Mit acht Jahren Erfahrung als Catererin veredelt Rachel die Schätze unserer Berge mit einer großzügigen und ehrlichen Küche."
    ],
    "en": [
      "Delicacies, Local Produce & Sharing\r\nImmerse yourself in a world where a passion for home cooking meets the authenticity of Savoie. With eight years of experience as a caterer, Rachel showcases the treasures of our mountains with generous and heartfelt cuisine."
    ],
    "it": [
      "Prelibatezze, terroir e condivisione\r\nImmergetevi in un mondo dove la passione per il cibo fatto in casa incontra l'autenticità della Savoia. Con 8 anni di esperienza come ristoratrice, Rachel sublima i tesori delle nostre montagne con una cucina generosa e sincera."
    ],
    "fr": [
      "Gourmandises, Terroir & Partage\r\nPlongez dans un univers où la passion du fait maison rencontre l'authenticité de la Savoie. Forte de 8 ans d'expérience comme traiteur, Rachel sublime les trésors de nos montagnes avec une cuisine généreuse et sincère."
    ],
    "nl": [
      "Lekkernijen, Terroir & Delen\r\nDompel jezelf onder in een wereld waar de passie voor zelfgemaakte gerechten samenkomt met de authenticiteit van de Savoie. Met 8 jaar ervaring als traiteur sublimeert Rachel de schatten van onze bergen met een genereuze en oprechte keuken."
    ],
    "es": [
      "Delicias, terruño y compartir\r\nSumérjase en un mundo donde la pasión por la comida casera se encuentra con la autenticidad de Saboya. Con 8 años de experiencia como restauradora, Rachel sublima los tesoros de nuestras montañas con una cocina generosa y sincera."
    ]
  },
  "rdfs:label": {
    "de": [
      "Les Recettes de Rachel"
    ],
    "en": [
      "Caterer - Les Recettes de Rachel"
    ],
    "fr": [
      "Gourmandises & Evénements - Les Recettes de Rachel"
    ]
  },
