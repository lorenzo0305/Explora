  "rdfs:comment": {
    "de": [
      "Produzenten von Beerenfrüchten in einem geschützten Naturgebiet.\r\nEmpfang auf dem Bauernhof Pont de Mars: Direktverkauf von frischem Obst, Marmeladen, Coulis, Nektar, Sorbets ..., Snacks, Gesellschafts- und Geschicklichkeitsspiele zur Verfügung, Rätselparcours ..."
    ],
    "en": [
      "Red fruit producers in a protected natural area.\r\nReception at the Pont de Mars farm: direct sales of fresh fruit, jams, coulis, nectars, sorbets, etc., snacks, board games and games of skill, riddle trails, etc."
    ],
    "it": [
      "Produttori di frutti rossi in un'area naturale protetta.\r\nAccoglienza presso la fattoria Pont de Mars: vendita diretta di frutta fresca, marmellate, coulis, nettari, sorbetti, ecc., snack, giochi di società e di abilità a disposizione, percorso di indovinelli, ecc."
    ],
    "fr": [
      "Producteurs de fruits rouges dans un espace naturel préservé.\r\nAccueil à la ferme du Pont de Mars : vente directe de fruits frais, confitures, coulis, nectars, sorbets ..., goûters, jeux de société et d'adresse à disposition, parcours devinettes ..."
    ],
    "es": [
      "Productores de frutos rojos en un espacio natural protegido.\r\nRecepción en la granja de Pont de Mars: venta directa de fruta fresca, mermeladas, coulis, néctares, sorbetes, etc., aperitivos, juegos de mesa y de habilidad disponibles, recorrido de adivinanzas, etc."
    ],
    "nl": [
      "Producenten van rood fruit in een beschermd natuurgebied.\r\nReceptie op de boerderij Pont de Mars: directe verkoop van vers fruit, jam, coulis, nectar, sorbets, enz., snacks, gezelschapsspelletjes en behendigheidsspelletjes, raadspellenparcours, enz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Petits Fruits du Lignon"
    ]
  },
