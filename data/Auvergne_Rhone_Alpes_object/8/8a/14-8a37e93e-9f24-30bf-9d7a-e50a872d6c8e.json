  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aa52b414-abad-3827-8e69-9e50cdd30636",
      "dc:description": {
        "de": [
          "Olympiade von 10:30 bis 12:00 Uhr\n für Kinder von 6 bis 12 Jahren.\n3 Euro pro Kind.\nAnmeldung beim Fremdenverkehrsamt erforderlich.\nTreffen Sie sich mit Ihrer Trinkflasche auf der Esplanade."
        ],
        "en": [
          "Olympics from 10.30am to 12pm\n for children aged 6 to 12.\n3 euros per child.\nRegistration essential at the Tourist Office.\nMeet at the esplanade with your water bottle."
        ],
        "it": [
          "Olimpiadi dalle 10.30 alle 12.00\n per bambini dai 6 ai 12 anni.\n3 euro a bambino.\nIscrizione obbligatoria presso l'Ufficio del Turismo.\nRitrovo alla spianata con la borraccia."
        ],
        "fr": [
          "Olympiades de 10h30 à 12h\n pour les enfants de 6 à 12 ans. \n3 euros par enfant. \nInscription indispensable à l'Office de Tourisme. \nRendez-vous à l'esplanade avec votre gourde."
        ],
        "nl": [
          "Olympische Spelen van 10.30 tot 12.00 uur\n voor kinderen van 6 tot 12 jaar.\n3 euro per kind.\nInschrijven is noodzakelijk bij het toeristenbureau.\nVerzamelen op de esplanade met je waterfles."
        ],
        "es": [
          "Olimpiadas de 10.30 a 12.00 horas\n para niños de 6 a 12 años.\n3 euros por niño.\nImprescindible inscribirse en la Oficina de Turismo.\nReúnase en la explanada con su botella de agua."
        ]
      },
      "@type": [
