  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/070ba17a-4d77-3ad2-9bbc-b2901a4ef51e",
      "dc:description": {
        "de": [
          "Ein Guinguette muss vorbereitet werden! Wärmen Sie sich vor dem Fest auf, um einen festen Hüftschwung und einen sicheren Ellbogen zu haben!"
        ],
        "en": [
          "A good Guinguette needs to be prepared! To make sure you've got a good swing and a good elbow, come and warm up before the party starts!"
        ],
        "it": [
          "Una buona Guinguette deve essere preparata! Quindi assicuratevi di avere un buon swing e un buon gomito, e venite a riscaldarvi prima che la festa abbia inizio!"
        ],
        "fr": [
          "Une bonne Guinguette ça se prépare ! Histoire d'avoir le déhancher solide et le lever de coude assuré, venez-vous échauffer avant le début de la fête !"
        ],
        "es": [
          "¡Una buena Guinguette necesita estar preparada! Así que asegúrate de tener un buen swing y un buen codo, ¡y ven a calentar antes de que empiece la fiesta!"
        ],
        "nl": [
          "Een goede Guinguette moet voorbereid zijn! Dus zorg dat je een goede swing en een goede elleboog hebt, en kom langs om op te warmen voordat het feest begint!"
        ]
      },
