  "rdfs:comment": {
    "de": [
      "Entdecken Sie das 1743 erbaute Schloss Champdor und seinen Park. Verpassen Sie nicht die Ausstellungen im Sommer!"
    ],
    "en": [
      "The Château de Champdor is located a few kilometers drive north of Hauteville-Lompnes. The building dates from 1743 and has 2 tall towers and several outbuildings.  Please note that it is not possible to visit the inside of the château."
    ],
    "it": [
      "Venite a scoprire il Castello di Champdor, costruito nel 1743, e il suo parco. Non perdetevi le mostre estive!"
    ],
    "fr": [
      "Venez découvrir le château de Champdor construit en 1743 ainsi que son parc. Ne ratez pas les expositions en été !"
    ],
    "es": [
      "Venga a descubrir el castillo de Champdor, construido en 1743, y su recinto. No se pierda las exposiciones de verano"
    ],
    "nl": [
      "Kom en ontdek het kasteel van Champdor, gebouwd in 1743, en zijn tuinen. Mis de zomertentoonstellingen niet!"
    ]
  },
