  "rdfs:comment": {
    "de": [
      "Unser Team steht Ihnen zur Verfügung, um Ihnen ein gelungenes Wochenende oder einen gelungenen Aufenthalt zusammenzustellen: Entdeckungen des Kulturerbes, Animationen, Aktivitäten, Restaurants und Unterkünfte. Kartenservice für Konzerte und Aufführungen, Souvenirladen."
    ],
    "en": [
      "Our team is at your service to help you plan a successful weekend or holiday: heritage discoveries, events, activities, restaurants and accommodation. Ticketing service for concerts and shows, souvenir store."
    ],
    "it": [
      "Il nostro team è a vostra disposizione per aiutarvi a pianificare un weekend o una vacanza di successo: scoperte del patrimonio, eventi, attività, ristoranti e alloggi. Servizio di biglietteria per concerti e spettacoli, negozio di souvenir."
    ],
    "fr": [
      "Notre équipe est à votre service pour vous concocter un week-end ou séjour réussi : découvertes patrimoniales, animations, activités, restaurants et hébergements. Service billetterie pour des concerts et spectacles,  boutique souvenirs."
    ],
    "nl": [
      "Ons team staat voor je klaar om je te helpen een geslaagd weekend of vakantie te plannen: erfgoedontdekkingen, evenementen, activiteiten, restaurants en accommodatie. Ticketservice voor concerten en shows, souvenirwinkel."
    ],
    "es": [
      "Nuestro equipo está a su servicio para ayudarle a planificar con éxito un fin de semana o unas vacaciones: descubrimientos patrimoniales, eventos, actividades, restaurantes y alojamiento. Servicio de venta de entradas para conciertos y espectáculos, tienda de recuerdos."
    ]
  },
