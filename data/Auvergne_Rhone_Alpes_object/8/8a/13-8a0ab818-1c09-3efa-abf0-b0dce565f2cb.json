  "rdfs:comment": {
    "de": [
      "Dieses wunderbare Lokal befindet sich am Fuße der Pisten und im Herzen des alten Dorfes Montchavin. Es verfügt über mehrere Säle und ist ein 1975 gegründetes Familienrestaurant, das hausgemachte Gerichte mit vielen frischen Produkten anbietet."
    ],
    "en": [
      "This wonderful establishment is located at the foot of the slopes and in the heart of the old village of Montchavin. With several dining rooms, it's a family-run restaurant founded in 1975, offering homemade dishes made with fresh produce."
    ],
    "it": [
      "Questa splendida struttura si trova ai piedi delle piste e nel cuore dell'antico villaggio di Montchavin. Con diverse sale, è un ristorante a conduzione familiare nato nel 1975 che offre piatti fatti in casa con molti prodotti freschi."
    ],
    "fr": [
      "Ce merveilleux établissement situé au pied des pistes et en plein cœur du vieux village de Montchavin. Doté de plusieurs salles, c'est un restaurant familial né en 1975 qui propose des plats faits maison avec de nombreux produits frais."
    ],
    "es": [
      "Este maravilloso establecimiento está situado a pie de pistas y en el corazón del antiguo pueblo de Montchavin. Con varias salas, es un restaurante familiar nacido en 1975 que ofrece platos caseros con muchos productos frescos."
    ],
    "nl": [
      "Dit prachtige etablissement ligt aan de voet van de pistes en in het hart van het oude dorp Montchavin. Dit familierestaurant met verschillende eetzalen werd opgericht in 1975 en biedt huisgemaakte gerechten met een breed scala aan verse producten."
    ]
  },
