  "rdfs:comment": {
    "de": [
      "Ein vertikaler Transport, der eine schnelle und bequeme Verbindung gewährleistet und gleichzeitig einen Panoramablick auf die umliegenden Berge bietet."
    ],
    "en": [
      "The new elevator provides a fast and convenient link between the towns of Le Fayet and Saint-Gervais, while offering a panoramic view of the surrounding mountains."
    ],
    "it": [
      "Un sistema di trasporto verticale che fornisce un collegamento veloce e comodo, offrendo al contempo una vista panoramica sulle montagne circostanti."
    ],
    "fr": [
      "Un transport vertical qui assure une liaison rapide et pratique, tout en offrant une vue panoramique sur les montagnes environnantes."
    ],
    "es": [
      "Un sistema de transporte vertical que proporciona un enlace rápido y cómodo, al tiempo que ofrece vistas panorámicas de las montañas circundantes."
    ],
    "nl": [
      "Een verticaal transportsysteem dat een snelle, handige verbinding biedt en tegelijkertijd een panoramisch uitzicht op de omliggende bergen."
    ]
