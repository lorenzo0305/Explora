      "dc:description": {
        "de": [
          "Im La Famiglia können Sie italienische Spezialitäten mit der berühmten neapolitanischen Pizza probieren.\nFeinkostladen auch vor Ort"
        ],
        "en": [
          "At La Famiglia, come and taste Italian specialties such as the famous Neapolitan pizza.\nDelicatessen also on site"
        ],
        "it": [
          "Presso La Famiglia potrete gustare specialità italiane come la famosa pizza napoletana.\nDelicatessen anche in loco"
        ],
        "fr": [
          "A la Famiglia, venez goûter aux spécialités italiennes avec la fameuse pizza napolitaine.\nEpicerie fine également sur place"
        ],
        "es": [
          "En La Famiglia podrá degustar especialidades italianas como la famosa pizza napolitana.\nTambién hay una tienda de delicatessen"
        ],
        "nl": [
          "Bij La Famiglia kun je Italiaanse specialiteiten proeven, zoals de beroemde Napolitaanse pizza.\nDelicatessenwinkel ook ter plaatse"
        ]
      },
