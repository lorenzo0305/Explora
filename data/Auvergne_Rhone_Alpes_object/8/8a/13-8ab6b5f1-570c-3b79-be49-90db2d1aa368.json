  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Relais de la Fontaine empfängt Sie in Cros-de-Montvert in einer herzlichen und entspannten Atmosphäre. Im Herzen ihrer gekonnt zubereiteten Speisen finden Sie alle Geschmäcker der Authentizität lokaler Qualitätsprodukte wieder."
    ],
    "en": [
      "Le Relais de la Fontaine welcomes you to Cros-de-Montvert in a warm and relaxed atmosphere. At the heart of their skilfully prepared dishes, you will find all the flavours of the authenticity of quality local products."
    ],
    "it": [
      "Il ristorante Le Relais de la Fontaine vi accoglie a Cros-de-Montvert in un'atmosfera calda e rilassata. Al centro dei loro piatti sapientemente preparati, troverete tutti i sapori degli autentici prodotti locali di qualità."
    ],
    "fr": [
      "Le restaurant Le Relais de la Fontaine vous accueille à Cros-de-Montvert dans une ambiance chaleureuse et décontractée. Au cœur de leurs préparations savamment travaillées, retrouvez toutes les saveurs de l'authenticité des produits locaux de qualité."
    ],
    "nl": [
      "Le Relais de la Fontaine verwelkomt u in Cros-de-Montvert in een warme en ontspannen sfeer. In het hart van hun vakkundig bereide gerechten vindt u alle smaken van authentieke lokale kwaliteitsproducten."
    ],
    "es": [
      "El restaurante Le Relais de la Fontaine le da la bienvenida a Cros-de-Montvert en un ambiente cálido y relajado. En el corazón de sus platos hábilmente preparados, encontrará todos los sabores de los auténticos productos locales de calidad."
    ]
  },
