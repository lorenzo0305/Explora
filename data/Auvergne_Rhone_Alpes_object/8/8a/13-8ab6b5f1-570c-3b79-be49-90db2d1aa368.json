          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Das ganze Jahr über geöffnet. Mittags von 9 bis 14 Uhr täglich außer dienstags (Samstagmittag auf Reservierung) und abends von 18 bis 22 Uhr freitags und samstags. In den Sommermonaten werden die Öffnungszeiten an einigen Donnerstag- und Sonntagabenden ausgeweitet. Besuchen Sie die Facebook-Seite des Restaurants, um Informationen zu finden."
            ],
            "en": [
              "Open all year round. Lunch from 9am to 2pm every day except Tuesday (Saturday lunch by reservation) and evenings from 6pm to 10pm on Fridays and Saturdays. During the summer, openings extend to certain Thursdays and Sunday evenings. Check the restaurant's Facebook page for details."
            ],
            "it": [
              "Aperto tutto l'anno. Pranzo dalle 9.00 alle 14.00 tutti i giorni tranne il martedì (sabato a pranzo su prenotazione) e sera dalle 18.00 alle 22.00 il venerdì e il sabato. Durante l'estate, il ristorante è aperto alcuni giovedì e domeniche sera. Per maggiori informazioni, consultare la pagina Facebook del ristorante."
            ],
            "fr": [
              "Ouvert toute l'année. Les midis de 9h à 14h tous les jours sauf le mardi (samedi midi sur réservation) et les soirs de 18h à 22h les vendredis et samedis. En période estivale, les ouvertures s'étendent certains jeudis et dimanches soirs, consultez le Facebook du restaurant pour trouver les informations."
            ],
            "nl": [
              "Het hele jaar door geopend. Lunchtijd van 9.00 tot 14.00 uur elke dag behalve dinsdag (zaterdag lunchtijd op afspraak) en 's avonds van 18.00 tot 22.00 uur op vrijdag en zaterdag. In de zomer is het restaurant op bepaalde donderdagen en zondagavonden geopend. Bekijk de Facebook-pagina van het restaurant voor meer informatie."
            ],
            "es": [
              "Abierto todo el año. Todos los días de 9.00 a 14.00, excepto los martes (sábados previa reserva), y los viernes y sábados de 18.00 a 22.00. En verano, el restaurante abre algunos jueves y domingos por la noche. En verano, el restaurante abre algunos jueves y domingos por la noche. Para más información, consulte la página de Facebook del restaurante."
            ]
          },
