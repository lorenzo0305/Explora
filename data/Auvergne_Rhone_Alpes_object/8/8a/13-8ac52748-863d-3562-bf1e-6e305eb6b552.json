  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geselligkeit eines Bar-Restaurants in einem Dorf, in dem die traditionelle Tagesküche aus lokalen Produkten zubereitet wird. Genießen Sie Ihr Mittagessen im Barraum oder etwas ruhiger in einem angrenzenden Raum mit 25 Plätzen."
    ],
    "en": [
      "Find the conviviality of a village bar-restaurant where the traditional cuisine of the day is prepared with local products. Have lunch in the bar room or in an adjoining room with 25 seats."
    ],
    "it": [
      "Godetevi la convivialità di un bar-ristorante del villaggio dove la cucina tradizionale del giorno è preparata con prodotti locali. Pranzate nella sala bar o nell'adiacente sala da pranzo da 25 posti."
    ],
    "fr": [
      "Retrouvez la convivialité d'un bar-restaurant de village où la cuisine traditionnelle du jour est préparée à base de produits locaux. Déjeunez dans la salle du bar ou plus au clame dans une salle attenante de 25 couverts."
    ],
    "nl": [
      "Geniet van de gezelligheid van een dorpsbar-restaurant waar de traditionele keuken van de dag wordt bereid met lokale producten. Lunch in de barruimte of in de aangrenzende eetzaal met 25 zitplaatsen."
    ],
    "es": [
      "Disfrute de la convivencia de un bar-restaurante de pueblo donde se prepara la cocina tradicional del día con productos locales. Almuerce en el bar o en el comedor contiguo, con capacidad para 25 comensales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Restaurant Café du Midi"
    ]
  },
