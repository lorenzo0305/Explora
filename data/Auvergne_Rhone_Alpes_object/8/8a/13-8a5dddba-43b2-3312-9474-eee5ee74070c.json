  "rdfs:comment": {
    "de": [
      "Ehemalige gewöhnliche Mühle zum Spinnen, Kardieren und Färben, in den 1950er Jahren Steinmühle (Baryt). Die Mühle bietet Ausstellungen und kulturelle Aktivitäten. Besichtigung nach Vereinbarung. Teil der Route des Moulins d'Auvergne."
    ],
    "en": [
      "An old common mill used for spinning, carding and dyeing, in the 50's stone mill (the barite). The mill offers exhibitions and cultural activities. Visits by appointment. Part of the Route des Moulins d'Auvergne."
    ],
    "it": [
      "Un tempo mulino comune utilizzato per la filatura, la cardatura e la tintura, negli anni '50 mulino a pietra (barite). Il mulino offre mostre e attività culturali. Visita su appuntamento. Fa parte della Route des Moulins d'Auvergne."
    ],
    "fr": [
      "Ancien moulin banal à usage de filature, carderie et teinturerie, dans les années 50, moulin à pierre (la barytine). Le moulin propose des expositions et des activités culturelles. Visite sur rendez-vous. Fait partie de la Route des Moulins d'Auvergne."
    ],
    "nl": [
      "Vroeger een gewone molen gebruikt voor spinnen, kaarden en verven, in de jaren 1950 een stenen molen (bariet). De molen biedt tentoonstellingen en culturele activiteiten. Bezoek op afspraak. Onderdeel van de Route des Moulins d'Auvergne."
    ],
    "es": [
      "Antiguo molino común utilizado para hilar, cardar y teñir, en los años 50 molino de piedra (barita). El molino ofrece exposiciones y actividades culturales. Visitas concertadas. Parte de la Route des Moulins d'Auvergne."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mill of the Pond"
    ],
    "fr": [
      "Moulin de l’Étang"
    ]
  },
