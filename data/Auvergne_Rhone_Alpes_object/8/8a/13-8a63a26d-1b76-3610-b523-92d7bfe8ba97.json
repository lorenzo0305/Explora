  "rdfs:comment": {
    "de": [
      "Ein atemberaubender Blick auf den See, ein bemerkenswerter Tisch, eine saisonale französische Küche zwischen Regionalität und Kreationen\r\nWechselnde Speisekarte zu jeder Jahreszeit."
    ],
    "en": [
      "Stunning lake views, fantastic dishes, seasonal French cuisine with the perfect blend of terroir and modernity. Here, the motto is 'Carpe Diem...seize the dish of the day!'"
    ],
    "it": [
      "Vista mozzafiato sul lago, un ristorante straordinario, cucina francese stagionale che combina prodotti locali e creatività\r\nIl menu cambia ogni stagione."
    ],
    "fr": [
      "Une vue imprenable sur le lac, une table remarquable, une cuisine française de saison entre terroir et création \r\nChangement de carte à chaque saison."
    ],
    "es": [
      "Impresionantes vistas al lago, un restaurante excepcional, cocina francesa de temporada que combina productos locales y creatividad\r\nUn menú nuevo cada temporada."
    ],
    "nl": [
      "Adembenemend uitzicht over het meer, een opmerkelijk restaurant, Franse seizoenskeuken met lokale producten en creativiteit\r\nHet menu verandert elk seizoen."
    ]
  },
