  "rdfs:comment": {
    "de": [
      "Saint-Mamet-la-Salvetat ist die zweitgrößte Gemeinde der Châtaigneraie cantalienne und ihr Hauptort. Saint-Mamet ist ein kleiner Ort mit zahlreichen Geschäften und Dienstleistungen und bietet einen der atemberaubendsten Ausblicke auf den Vulkan Cantalien."
    ],
    "en": [
      "Saint-Mamet-la-Salvetat, the second-largest commune in the Châtaigneraie Cantalienne, is its administrative centre. A large village with a wide range of shops and services, Saint-Mamet offers one of the most breathtaking views of the  Mounts of Cantal."
    ],
    "it": [
      "Saint-Mamet-la-Salvetat, il secondo comune più grande della Châtaigneraie Cantalien, è la città principale. Piccolo villaggio con molti negozi e servizi, Saint-Mamet offre una delle viste più suggestive del vulcano Cantalien."
    ],
    "fr": [
      "Saint-Mamet-la-Salvetat, deuxième commune de la Châtaigneraie cantalienne par la population, en est le chef-lieu. Petit bourg aux multiples commerces et services, Saint-Mamet offre l'un des points de vue les plus saisissants sur le volcan cantalien."
    ],
    "es": [
      "Saint-Mamet-la-Salvetat, el segundo municipio más grande de la Châtaigneraie Cantalien, es la ciudad principal. Pequeño pueblo con numerosos comercios y servicios, Saint-Mamet ofrece una de las vistas más impresionantes del volcán Cantalien."
    ],
    "nl": [
      "Saint-Mamet-la-Salvetat, de tweede grootste gemeente van de Châtaigneraie Cantalienne, is het administratieve centrum. Saint-Mamet, een groot dorp met een breed scala aan winkels en diensten, biedt een van de meest adembenemende uitzichten op de Monts du Cantal."
    ]
  },
