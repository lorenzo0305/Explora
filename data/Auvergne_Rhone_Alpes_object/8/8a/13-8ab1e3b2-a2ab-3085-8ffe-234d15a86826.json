  "rdfs:comment": {
    "de": [
      "Der Start befindet sich am Fuße der Seilbahn Pointe de la Masse. Balcon du Lou ist ein Panorama-Enduro-Trail, der ein perfektes Gleichgewicht zwischen technischem Fahren und atemberaubenden Landschaften bietet."
    ],
    "en": [
      "The trail starts at the base of the Pointe de la Masse gondola. Balcon du Lou is a panoramic enduro trail that strikes the perfect balance between technical riding and breathtaking scenery."
    ],
    "it": [
      "Il percorso inizia ai piedi della funivia della Pointe de la Masse. Il Balcon du Lou è un percorso enduro panoramico che offre un perfetto equilibrio tra guida tecnica e paesaggi mozzafiato."
    ],
    "fr": [
      "Le départ se fait au pied de la télécabine de la Pointe de la Masse. Balcon du Lou est un sentier enduro panoramique qui offre un équilibre parfait entre pilotage technique et paysages à couper le souffle."
    ],
    "es": [
      "El sendero comienza al pie del teleférico de la Pointe de la Masse. Balcon du Lou es un sendero panorámico de enduro que ofrece un equilibrio perfecto entre conducción técnica y paisajes impresionantes."
    ],
    "nl": [
      "De trail begint aan de voet van de Pointe de la Masse kabelbaan. Balcon du Lou is een panoramische enduro trail die een perfecte balans biedt tussen technisch rijden en een adembenemend landschap."
    ]
  },
  "rdfs:label": {
    "en": [
      "E5 - Balcon du Lou"
    ],
    "fr": [
      "E5 - Balcon du Lou"
    ]
  },
