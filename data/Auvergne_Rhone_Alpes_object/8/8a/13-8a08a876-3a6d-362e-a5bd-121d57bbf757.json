  "rdfs:comment": {
    "de": [
      "La Fée Bien-être ist ein exklusiver Ort, der der Entspannung, der Gelassenheit und dem Auftanken von Körper und Geist gewidmet ist.\r\nFinden Sie WELLNESS und INTENSIVE SENTIMENT OF ENTSPANNUNG!"
    ],
    "en": [
      "La Fée Bien-être is an exclusive place dedicated to relaxation, serenity and rejuvenation of body and mind.\r\nRediscover well-being and an intense feeling of relaxation!"
    ],
    "it": [
      "La Fée Bien-être è un luogo esclusivo dedicato al relax, alla serenità e al ringiovanimento del corpo e della mente.\r\nRitrovate il BENESSERE e l'INTENSO SENSO DI RILASSAMENTO!"
    ],
    "fr": [
      "La Fée Bien-être est un lieu exclusif dédié à la détente, la sérénité et au ressourcement du corps et de l’esprit.\r\nRetrouvez BIEN-ÊTRE et INTENSE SENTIMENT DE DÉTENTE !"
    ],
    "nl": [
      "Le Fée Bien-être is een exclusieve plek die gewijd is aan ontspanning, kalmering en verjonging van lichaam en geest.\r\nVindt hier WELZJJN en een INTENS GEVOEL VAN ONTSPANNING!"
    ],
    "es": [
      "La Fée Bien-être es un lugar exclusivo dedicado a la relajación, la serenidad y el rejuvenecimiento del cuerpo y la mente.\r\n¡Encuentre el BIENESTAR y una INTENSA SENSACIÓN DE RELAJACIÓN!"
    ]
  },
