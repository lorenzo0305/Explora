  "rdfs:comment": {
    "de": [
      "Jahrhundert von dem Architekten Ste-Marie Perrin (Co-Architekt der Basilika Fourvière in Lyon) erbaute Kirche. Bemerkenswerte Kunstwerke, die in die Liste der historischen Monumente eingetragen sind, und eine Vitrine mit schönen religiösen Stücken."
    ],
    "en": [
      "Built in the 19th century by the architect Sainte-Marie-Perrin. Notable works of art are held in the church as well as display of handsome religious relics."
    ],
    "it": [
      "Chiesa costruita nel XIX secolo dall'architetto Ste-Marie Perrin (co-architetto della basilica di Fourvière a Lione). Notevoli opere d'arte iscritte ai Monuments Historiques e una vetrina contenente splendidi pezzi religiosi."
    ],
    "fr": [
      "Eglise construite au XIXème par l'architecte Ste-Marie Perrin (co-architecte de la basilique de Fourvière à Lyon). Présence d'oeuvres remarquables inscrites aux Monuments Historiques et d'une vitrine contenant de belles pièces religieuses."
    ],
    "nl": [
      "Kerk gebouwd in de 19e eeuw door de architect Ste-Marie Perrin (mede-architect van de Fourvière-basiliek in Lyon). Opmerkelijke kunstwerken die zijn opgenomen in de Monuments Historiques en een vitrine met prachtige religieuze stukken."
    ],
    "es": [
      "Iglesia construida en el siglo XIX por el arquitecto Ste-Marie Perrin (co-arquitecto de la basílica de Fourvière en Lyon). Notables obras de arte inscritas en los Monumentos Históricos y una vitrina con bellas piezas religiosas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint Prix"
    ]
  },
