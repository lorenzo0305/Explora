  "rdfs:comment": {
    "de": [
      "Ein künstlerisches Werk, das ASTER-Projekt, wird auf dem Gewölbe des Staudamms von Saint-Étienne-Cantalès installiert. Das Projekt wurde von der Künstlerin Delphine Gigoux-Martin entworfen. Es ist eine Premiere in Frankreich (auf einem Wasserkraftdamm)."
    ],
    "en": [
      "An artistic work, the ASTER project, by the artist Delphine Gigoux-Martin, is installed on the vault of the Saint-Étienne-Cantalès Dam."
    ],
    "it": [
      "Un'opera artistica, il Progetto ASTER, viene installata sulla volta della diga di Saint-Étienne-Cantalès. Un progetto dell'artista Delphine Gigoux-Martin. È la prima volta in Francia (su una diga idroelettrica)."
    ],
    "fr": [
      "Une œuvre artistique, le Projet ASTER, est installée sur la voûte du barrage de Saint-Étienne-Cantalès. Un projet de l'artiste Delphine Gigoux-Martin. C'est une première en France (sur un barrage hydroélectrique)."
    ],
    "es": [
      "Una obra artística, el Proyecto ASTER, se instala en la bóveda de la presa de Saint-Étienne-Cantalès. Un proyecto de la artista Delphine Gigoux-Martin. Es una primicia en Francia (en una presa hidroeléctrica)."
    ],
    "nl": [
      "Een artistiek werk, het ASTER-project, van kunstenares Delphine Gigoux-Martin, wordt geïnstalleerd op het gewelf van de Saint-Étienne-Cantalès-stuwdam."
    ]
  },
