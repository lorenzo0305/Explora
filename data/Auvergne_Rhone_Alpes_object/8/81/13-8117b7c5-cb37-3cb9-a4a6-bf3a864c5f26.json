  "rdfs:comment": {
    "de": [
      "Produzent von Ziegenkäse aus Freilandhaltung und Freilandschweinen aus Freilandhaltung.\r\nMilchtomaten vom Fasel bis zum gereiften Tome (natur oder aromatisiert) sowie gepresste Nudeln (natur, Pfeffer, Bärlauch)."
    ],
    "en": [
      "Producer of free-range goat cheeses and free-range pigs.\r\nLactic tomes from faisselle to mature tome (plain or flavored), as well as pressed cheeses (plain, pepper, wild garlic)."
    ],
    "it": [
      "Produttore di formaggi di capra, di maiale e di uova da allevamento all'aperto.\nTome lattiche dalle faisselle alle tome stagionate (semplici o aromatizzate), nonché formaggi pressati (semplici, al pepe, all'aglio selvatico)."
    ],
    "fr": [
      "Producteur de fromages de chèvres fermiers, porcs fermiers plein air et œufs plein air.\nTomes lactiques de la faisselle à la tome affinée (nature ou aromatisée) ainsi que des pâtes pressées (nature, poivre, ail des ours)."
    ],
    "es": [
      "Productor de queso de cabra de granja, carne de cerdo de granja y huevos de granja.\nQuesos lácteos, desde el \"faisselle\" hasta el \"tome\" curado (al natural o aromatizado), así como quesos prensados (al natural, a la pimienta, al ajo silvestre)."
    ],
    "nl": [
      "Producent van scharrelgeitenkaas en scharrelvarkensvlees.\r\nLactische tomes van faisselle tot belegen tome (puur of gearomatiseerd) en geperste kazen (puur, peper, wilde knoflook)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balayn - Capri b"
