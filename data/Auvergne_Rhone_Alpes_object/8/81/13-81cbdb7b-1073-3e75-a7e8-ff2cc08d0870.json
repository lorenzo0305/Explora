  "rdfs:comment": {
    "de": [
      "Eine handwerkliche Schokoladen- und Süßwarenfabrik, die Modernität und Tradition verbindet. Der landesweit bekannte Chefkoch Patrick Bouvard wählt unter der Anleitung seines Sohnes Pierre Edouard hochwertige Rohstoffe aus, um Ihnen geschmackvolle Produkte herzustellen."
    ],
    "en": [
      "Artisanal chocolate and confectionery combining modernity and tradition. Nationally-renowned chef Patrick Bouvard selects top-quality raw materials, under the guidance of his son Pierre Edouard, to create mouth-watering products."
    ],
    "it": [
      "Cioccolato e pasticceria che uniscono modernità e tradizione. Lo chef di fama nazionale Patrick Bouvard, sotto la guida del figlio Pierre Edouard, sceglie materie prime di qualità per realizzare prodotti saporiti."
    ],
    "fr": [
      "Chocolaterie et confiserie artisanale alliant modernité et tradition. Le chef Patrick Bouvard, de renommée nationale, choisi des matières premières de qualités sous les conseils de son fils Pierre Edouard pour vous fabriquer des produits hauts en saveurs."
    ],
    "es": [
      "El chocolate y la confitería combinan modernidad y tradición. El chef de renombre nacional Patrick Bouvard, bajo la dirección de su hijo Pierre Edouard, elige materias primas de calidad para elaborar productos sabrosos."
    ],
    "nl": [
      "Chocolade en banketbakkersambacht dat moderniteit en traditie combineert. De nationaal bekende chef Patrick Bouvard, onder leiding van zijn zoon Pierre Edouard, kiest kwaliteitsgrondstoffen om smaakvolle producten te maken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Maison Bouvard - Chocolate factory"
    ],
    "fr": [
      "Douceurs Sucrées - Chocolaterie Bouvard"
    ]
  },
