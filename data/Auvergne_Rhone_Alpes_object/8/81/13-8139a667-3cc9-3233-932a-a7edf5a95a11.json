  "rdfs:comment": {
    "de": [
      "Spätromanischer Glockenturm, andere Teile aus dem 13. und 17. Jahrhundert, Statuen, Wandmalereien. Ebenfalls im Dorf befindet sich die Kapelle St. Rochus aus dem 17."
    ],
    "en": [
      "Bell tower from the end of the Romanesque period, other parts from the 13th and 17th centuries, statuary, wall paintings. Also in the village, St Roch chapel from the 17th century."
    ],
    "it": [
      "Campanile del tardo romanico, altre parti del XIII e XVII secolo, statuaria, dipinti murali. Sempre nel villaggio, la cappella di San Rocco del XVII secolo."
    ],
    "fr": [
      "Clocher de la fin de la période romane, autres parties XIIIe et XVIIe siècle, statuaire, peintures murales. Également dans le village, chapelle St Roch du XVIIe siècle."
    ],
    "nl": [
      "Klokkentoren uit de late Romaanse periode, andere delen uit de 13e en 17e eeuw, beeldhouwwerk, muurschilderingen. Eveneens in het dorp, de kapel van St Roch uit de 17e eeuw."
    ],
    "es": [
      "Campanario de finales del románico, otras partes de los siglos XIII y XVII, estatuas, pinturas murales. También en el pueblo, la capilla de St Roch del siglo XVII."
    ]
  },
