  "rdfs:comment": {
    "de": [
      "DIABOLO empfängt Ihre Firmenveranstaltungen in einer originellen Location mit atypischer Dekoration. Wir verfügen über mehrere Tagungsräume, aber Sie können unsere Räumlichkeiten auch für eine Messe oder eine zügellose Firmenfeier privatisieren."
    ],
    "en": [
      "DIABOLO hosts your corporate events in an original and stylishly decorated venue. We have a number of meeting rooms, but you can also take advantage of our private facilities for a trade show or a wild company party."
    ],
    "it": [
      "DIABOLO ospita i vostri eventi aziendali in una sede originale con un arredamento atipico. Disponiamo di diverse sale riunioni, ma potete anche approfittare delle nostre strutture private per una fiera o una sfrenata festa aziendale."
    ],
    "fr": [
      "DIABOLO accueille vos événements d'entreprise dans un lieu original à la décoration bien atypique. Nous disposons de plusieurs salles de réunions mais vous pouvez également privatiser notre lieu pour un salon ou pour une soirée d'entreprise débridée."
    ],
    "nl": [
      "DIABOLO organiseert uw bedrijfsevenementen in een originele locatie met een atypisch decor. We hebben een aantal vergaderzalen, maar je kunt ook gebruikmaken van onze privéfaciliteiten voor een beurs of een wild bedrijfsfeest."
    ],
    "es": [
      "DIABOLO acoge sus eventos corporativos en un local original con una decoración atípica. Disponemos de varias salas de reuniones, pero también puede aprovechar nuestras instalaciones privadas para una feria comercial o una fiesta de empresa desenfrenada."
    ]
  },
  "rdfs:label": {
    "en": [
      "Diabolo : meeting and study rooms"
    ],
    "fr": [
      "Diabolo : salles de réunion et d'étude"
    ]
  },
