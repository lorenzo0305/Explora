  "rdfs:comment": {
    "de": [
      "Pauline ist eine zertifizierte Fuß- und Handreflexzonen-Therapeutin, die sich auf Aromatherapie spezialisiert hat. Sie begleitet Sie gerne bei Sitzungen zu Hause oder an Urlaubsorten in der Region Haute Tarentaise."
    ],
    "en": [
      "A certified reflexologist in plantar and palmar practices, and specialized in aromatherapy, Pauline will be delighted to accompany you during home and vacation sessions in the Haute Tarentaise area."
    ],
    "it": [
      "Pauline, riflessologa plantare e palmare certificata e specializzata in aromaterapia, sarà lieta di accompagnarvi durante le sedute a casa vostra o nei luoghi di vacanza della Haute Tarentaise."
    ],
    "fr": [
      "Réflexologue certifiée en pratiques plantaire et palmaire, et spécialisée en aromathérapie, Pauline sera ravie de vous accompagner lors de séances à domicile et lieux de vacances sur le secteur de la haute tarentaise."
    ],
    "nl": [
      "Pauline is gediplomeerd voet- en palmreflextherapeute en gespecialiseerd in aromatherapie. Ze begeleidt je graag tijdens sessies bij jou thuis of op vakantiebestemming in de Haute Tarentaise."
    ],
    "es": [
      "Pauline es reflexóloga podal y palmar diplomada y está especializada en aromaterapia. Estará encantada de acompañarle durante las sesiones en su domicilio o destino de vacaciones en la zona de Haute Tarentaise."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pauline RUFFIER-DES-AIMES Réflexologue"
    ]
  },
