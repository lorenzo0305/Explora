  "rdfs:comment": {
    "de": [
      "Ein Konzept, das Sie begeistern wird, eine Beziehung zwischen Meer und Bergen Noirmoutier/Megève. Probieren Sie Austern, Räucherfisch, Rillettes, Gänseleber, Platten zum Mitnehmen und vor Ort. Platten mit Meeresfrüchten. Verkauf von lokalen Produkten aus Noirmoutier."
    ],
    "en": [
      "A concept you will love, a blend of Noirmoutier/Megève sea/mountain, come and taste our oysters, smoked fish, rillettes, foie gras to take away or to eat onsite. Seafood platters. Sale of local Noirmoutier products."
    ],
    "it": [
      "Un concept che vi affascinerà, una relazione tra mare e montagna\r\nNoirmoutier/Megève: venite a degustare ostriche, pesce affumicato, rillette, foie gras, piatti da asporto; vendita di prodotti locali di Noirmoutier."
    ],
    "fr": [
      "Un concept qui va vous séduire, une relation mer/montagne Noirmoutier/Megève. Venez déguster des huîtres, poissons fumés, rillettes, foie gras, plateaux à emporter et sur place. Plateaux de fruits de mer. Vente de produits locaux de Noirmoutier."
    ],
    "es": [
      "Un concepto que le conquistará, un vínculo mar/montaña entre Noirmoutier y Megeve. Venga a degustar nuestras ostras, pescados ahumados, rillettes, foie gras, platos para llevar y para comer in situ. Platos de marisco. Venta de productos locales de Noirmoutier."
    ],
    "nl": [
      "Een concept dat je zal overtuigen, een verbinding tussen de zee en de bergen tussen Noirmoutier en Megeve. Kom proeven van onze oesters, gerookte vis, rillettes, foie gras, meeneemgerechten en schotels ter plaatse. Schotels met zeevruchten. Verkoop van streekproducten uit Noirmoutier."
    ]
  },
