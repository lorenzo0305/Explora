  "rdfs:comment": {
    "de": [
      "Dieses klimatisierte Hotel befindet sich in Hazebrouck, auf dem Land im Herzen der Region Nord-Pas De Calais. Es ist nur 16 km von der belgischen Grenze entfernt und bietet kostenloses WLAN und einen Garten mit einer Terrasse. Alle Zimmer befinden sich im Erdgeschoss und verfügen über einen eigenen Eingang. Jedes verfügt über einen Flachbild-Sat-TV und ein eigenes Bad."
    ],
    "en": [
      "This air-conditioned hotel is located in Hazebrouck, in the countryside in the heart of the Nord-Pas De Calais region. It is only 16 km from the Belgian border and offers free Wi-Fi and a garden with a terrace. All rooms are on the first floor and have a private entrance. Each has a flat-screen satellite TV and a private bathroom."
    ],
    "it": [
      "Questo hotel climatizzato si trova a Hazebrouck, in campagna, nel cuore della regione Nord-Pas De Calais. Dista solo 16 km dal confine belga e offre la connessione Wi-Fi gratuita e un giardino con terrazza. Tutte le camere si trovano al piano terra e dispongono di un ingresso privato. Ogni camera dispone di una TV satellitare a schermo piatto e di un bagno interno."
    ],
    "fr": [
      "Cet hôtel climatisé se trouve à Hazebrouck, dans la campagne au coeur de la région Nord-Pas De Calais. Il se tient à seulement 16km de la frontière Belge et propose une connexion wifi gratuite et un jardin avec une terrasse. Toutes les chambres se trouvent au rez-de-chaussée et comprennent une entrée privée. Chacune comporte une TV par satellite à écran plat et une salle de bain privative."
    ],
    "es": [
      "Este hotel con aire acondicionado está situado en Hazebrouck, en el campo, en el corazón de la región de Nord-Pas De Calais. Está a solo 16 km de la frontera belga y ofrece conexión Wi-Fi gratuita y un jardín con terraza. Todas las habitaciones están en la planta baja y tienen entrada privada. Todas disponen de TV de pantalla plana vía satélite y baño privado."
    ],
    "nl": [
      "Dit hotel met airconditioning ligt in Hazebrouck, op het platteland in het hart van de regio Nord-Pas De Calais. Het ligt op slechts 16 km van de Belgische grens en biedt gratis WiFi en een tuin met een terras. Alle kamers bevinden zich op de begane grond en hebben een eigen ingang. Elke kamer heeft een flatscreen-tv met satellietzenders en een eigen badkamer."
    ]
  },
