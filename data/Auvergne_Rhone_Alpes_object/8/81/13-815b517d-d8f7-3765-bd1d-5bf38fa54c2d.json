  "rdfs:comment": {
    "de": [
      "Mit seinem klimatisierten Saal und seiner großen Terrasse bietet Ihnen das Restaurant la Chistera einen sehr angenehmen Rahmen, um Ihre Pizza zu genießen."
    ],
    "en": [
      "With its air-conditioned dining room and large terrace, the La Chistera restaurant offers a very pleasant setting in which to enjoy your pizza."
    ],
    "it": [
      "Con la sua sala climatizzata e l'ampia terrazza, il ristorante La Chistera offre un ambiente molto piacevole per gustare la pizza."
    ],
    "fr": [
      "Avec sa salle climatisée, sa grande terrasse, le restaurant la Chistera vous propose un cadre très agréable pour déguster votre pizza."
    ],
    "nl": [
      "Het restaurant La Chistera biedt met zijn zaal met airconditioning en zijn grote terras een zeer aangename omgeving om van uw pizza te genieten."
    ],
    "es": [
      "Con su comedor climatizado y su gran terraza, el restaurante La Chistera ofrece un marco muy agradable para degustar su pizza."
    ]
  },
