  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Beruf des Verlegers und die Herstellung von Büchern, demonstrieren Sie den Druck auf Buchdruckpressen und die Weiterverarbeitung. Buchhandlung vor Ort."
    ],
    "en": [
      "Discover the publishing profession and how books are made, with demonstrations of letterpress printing and finishing. Bookshop on site."
    ],
    "it": [
      "Scoprite il mestiere dell'editore e come nascono i libri, con una dimostrazione di stampa su macchine tipografiche e di finitura. Libreria in loco."
    ],
    "fr": [
      "Découverte du métier d'éditeur et de la fabrication des livres, démonstration d'impression sur presses typographiques et de façonnage. Librairie sur place."
    ],
    "nl": [
      "Kom meer te weten over het uitgeversvak en hoe boeken worden gemaakt, met een demonstratie van drukken op boekdrukmachines en afwerking. Boekwinkel ter plaatse."
    ],
    "es": [
      "Descubra la profesión de editor y cómo se hacen los libros, con una demostración de impresión en tipografía y acabado. Librería in situ."
    ]
  },
