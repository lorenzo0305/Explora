  "rdfs:comment": {
    "de": [
      "Nutzen Sie dieses Schwimmbad und entspannen Sie sich in natürlich warmem Thermalwasser für einen echten Entspannungsmoment. Sie haben Zugang zum Becken mit Massagedüsen, zum Spa, zum Solarium und zu Wassergymnastikkursen."
    ],
    "en": [
      "Take advantage of this pool and relax in naturally warm thermal water for a truly relaxing moment. You'll have access to the massaging jet pool, spa, solarium and aquagym classes."
    ],
    "it": [
      "Approfittate di questa piscina e rilassatevi nell'acqua termale naturalmente calda per un momento di vero relax. Avrete accesso alla piscina a getto massaggiante, alla spa, al solarium e alle lezioni di aquagym."
    ],
    "fr": [
      "Profitez de cette piscine et relaxez-vous dans une eau thermale naturellement chaude pour un vrai moment détente. Vous aurez accès au bassin à jets massants, au spa, au solarium et aux cours d'aquagym."
    ],
    "nl": [
      "Profiteer van dit zwembad en ontspan in natuurlijk warm thermaal water voor een echt ontspannen moment. Je hebt toegang tot het masserende jetbad, de spa, het solarium en aquagymlessen."
    ],
    "es": [
      "Aproveche esta piscina y relájese en el agua termal naturalmente caliente para disfrutar de un momento verdaderamente relajante. Tendrá acceso a la piscina de chorros de masaje, al spa, al solárium y a las clases de aquagym."
    ]
  },
  "rdfs:label": {
    "en": [
      "Thermal swimming-pool of Salins-les-Thermes"
    ],
    "fr": [
      "Les Grands bains de Salins"
    ]
  },
