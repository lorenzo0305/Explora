  "rdfs:comment": {
    "de": [
      "Das Maison du bijou lädt Sie ein, die kostbare Welt des Schmucks zu entdecken. Ein Audioguide in englischer Sprache begleitet Sie durch die acht Ausstellungsräume, die Ihnen die Geheimnisse der Schmuckherstellung näher bringen."
    ],
    "en": [
      "The Maison du bijou invites you to discover the precious world of jewelry. An audioguide accompanies you through the eight exhibition spaces, revealing the secrets of jewellery-making."
    ],
    "it": [
      "La Maison du bijou vi invita a scoprire il prezioso mondo della gioielleria. Un'audioguida, tradotta in inglese, vi accompagna attraverso le otto aree espositive, svelandovi i segreti della creazione di gioielli."
    ],
    "fr": [
      "La Maison du bijou vous invite à découvrir l'univers précieux du bijou. Un audioguide, traduit en anglais, vous accompagne au travers des huit espaces d’exposition qui vous livrent les secrets de fabrication du bijou."
    ],
    "es": [
      "La Maison du bijou le invita a descubrir el precioso mundo de la joyería. Una audioguía, traducida al inglés, le acompañará a través de las ocho zonas de exposición, revelándole los secretos de la fabricación de joyas."
    ],
    "nl": [
      "Het Maison du bijou nodigt je uit om de kostbare wereld van sieraden te ontdekken. Een audiogids neemt je mee door de acht tentoonstellingsruimtes en onthult de geheimen van het maken van sieraden."
    ]
  },
