  "rdfs:comment": {
    "de": [
      "Es handelt sich um ein gemütliches Spielcafé, in dem Sie sich bei Gesellschaftsspielen entspannen können, begleitet von einem kalten oder warmen Getränk und köstlichen Leckereien, die möglichst aus biologischen, lokalen und saisonalen Produkten selbst hergestellt werden."
    ],
    "en": [
      "It's a café-Ludique, where you can spend a relaxing moment playing board games, accompanied by a hot or cold drink, and delicious homemade treats, wherever possible using organic, local and seasonal produce."
    ],
    "it": [
      "È una caffetteria divertente dove trascorrere un momento di relax giocando a giochi da tavolo, accompagnati da una bevanda calda o fredda e da deliziosi dolci fatti in casa con prodotti biologici, locali e di stagione."
    ],
    "fr": [
      "C'est un café-Ludique, accueillant pour passer  un moment de détente autour de jeux de sociétés accompagnés d’une boissons fraîche ou chaude, de délicieuses friandises dans la mesure du possible faites maison avec des produits bio, locaux et de saison."
    ],
    "nl": [
      "Het is een leuk café waar je een ontspannen moment kunt doorbrengen met het spelen van bordspellen, vergezeld van een warm of koud drankje en heerlijke zelfgemaakte zoetigheden gemaakt van biologische, lokale en seizoensgebonden producten."
    ],
    "es": [
      "Es un divertido café donde pasar un momento relajado jugando a juegos de mesa, acompañado de una bebida caliente o fría y deliciosos dulces caseros elaborados con productos ecológicos, locales y de temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Croisée des Jeux"
    ]
  },
