  "rdfs:comment": {
    "de": [
      "Von den Außenanlagen des Schlosses von Montélimar aus erzählt Ihnen ein Vermittler die Geschichte und die Architektur dieses außergewöhnlichen Bauwerks."
    ],
    "en": [
      "From the exterior of the Château de Montélimar, a mediator explains the history and architecture of this exceptional monument."
    ],
    "it": [
      "Dall'esterno del Castello di Montélimar, un interprete vi racconterà la storia e l'architettura di questo eccezionale monumento."
    ],
    "fr": [
      "Depuis les espaces extérieurs du château de Montélimar, un médiateur vous raconte l'histoire et l'architecture de ce monument d'exception."
    ],
    "nl": [
      "Vanaf de buitenkant van het Château de Montélimar vertelt een tolk je alles over de geschiedenis en architectuur van dit uitzonderlijke monument."
    ],
    "es": [
      "Desde el exterior del castillo de Montélimar, un intérprete le contará todo sobre la historia y la arquitectura de este monumento excepcional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite Flash du château en extérieur"
    ]
  },
