      "dc:description": {
        "de": [
          "Lotto, organisiert vom Verein FJEP Guemps in der Salle Polyvalente.\n\nAuchan-Gutscheine von 20 bis 350 Euro (Einzelkarte oder Tasche).\n\nVerpflegung vor Ort."
        ],
        "en": [
          "Loto organized by the Association FJEP Guemps at the Salle Polyvalente.\n\nAuchan vouchers from 20 to 350 euros (individual card or pouch).\n\nCatering on site."
        ],
        "it": [
          "Loto organizzato dall'Associazione FJEP Guemps presso la Salle Polyvalente.\n\nBuoni Auchan da 20 a 350 euro (carta individuale o portafoglio).\n\nRistorazione in loco."
        ],
        "fr": [
          "Loto organisé par l'Association FJEP Guemps à la Salle Polyvalente.\n\nBons d'achat Auchan de 20 à 350 euros (carte individuelle ou pochette).\n\nRestauration sur place."
        ],
        "es": [
          "Loto organizado por la Asociación FJEP Guemps en la Sala Polivalente.\n\nVales Auchan de 20 € a 350 € (tarjeta individual o monedero).\n\nCatering in situ."
        ],
        "nl": [
          "Loto georganiseerd door de FJEP Guemps Association in de Salle Polyvalente.\n\nAuchan waardebonnen van € 20 tot € 350 (individuele kaart of portemonnee).\n\nCatering ter plaatse."
        ]
      },
