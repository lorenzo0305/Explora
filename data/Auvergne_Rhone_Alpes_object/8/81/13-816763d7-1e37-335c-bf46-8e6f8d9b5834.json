  "rdfs:comment": {
    "de": [
      "Restaurant am Fuße der Piste, große Panoramaterrasse, Treffpunkt, der mit den Skiern und für Fußgänger zugänglich ist. Mittags Expressmenüs für eine schnelle Rückkehr auf die Pisten auf der Grundlage von lokalen und \"hausgemachten\" Produkten."
    ],
    "en": [
      "Restaurant at the foot of the slopes, large panoramic terrace, meeting point accessible to skiers and pedestrians. For lunch, express menus for a quick return to the slopes, based on local, home-made products."
    ],
    "it": [
      "Ristorante ai piedi delle piste, ampia terrazza panoramica, punto d'incontro accessibile a sciatori e pedoni. Per il pranzo, menù espressi per un rapido ritorno alle piste a base di prodotti locali e \"fatti in casa\"."
    ],
    "fr": [
      "Restaurant en pied de piste, grande terrasse panoramique, point de rendez-vous accessible skis aux pieds et aux piétons. Pour le midi, des menus express pour un retour rapide sur les pistes à base de produits locaux et \"fait maison\"."
    ],
    "es": [
      "Restaurante a pie de pistas, gran terraza panorámica, punto de encuentro accesible en esquís y a pie. Para el almuerzo, menús exprés para una rápida vuelta a las pistas a base de productos locales y \"caseros\"."
    ],
    "nl": [
      "Restaurant aan de voet van de pistes, groot panoramisch terras, trefpunt toegankelijk op ski's en voetgangers. Voor de lunch, express menu's voor een snelle terugkeer naar de pistes op basis van lokale, huisgemaakte producten."
    ]
  },
