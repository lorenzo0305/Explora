  "rdfs:comment": {
    "de": [
      "Für eine Auszeit von ein paar Stunden oder einen mehrtägigen Aufenthalt ist Trévoux das ideale Reiseziel. Seine außergewöhnliche natürliche Umgebung und sein reiches historisches Erbe versprechen Ihnen eine unvergessliche Entdeckungsreise."
    ],
    "en": [
      "For a break of just a few hours or several days, Trévoux is the ideal destination. Its exceptional natural setting and rich historical heritage promise an unforgettable discovery."
    ],
    "it": [
      "Per una pausa di poche ore o di più giorni, Trévoux è la destinazione ideale. Il suo eccezionale contesto naturale e il suo ricco patrimonio storico promettono una scoperta indimenticabile."
    ],
    "fr": [
      "Pour une parenthèse de quelques heures ou un séjour de plusieurs jours, Trévoux est la destination idéale. Son cadre naturel exceptionnel et son riche patrimoine historique vous promettent une découverte inoubliable."
    ],
    "nl": [
      "Voor een vakantie van een paar uur of meerdere dagen is Trévoux de ideale bestemming. De uitzonderlijke natuurlijke omgeving en het rijke historische erfgoed beloven een onvergetelijke ontdekking."
    ],
    "es": [
      "Para una escapada de unas horas o de varios días, Trévoux es el destino ideal. Su excepcional entorno natural y su rico patrimonio histórico prometen un descubrimiento inolvidable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trévoux, ville d'Art et d'Histoire"
    ]
  },
