        "de": [
          "Johannisfeuer in Verchin am Samstag, den 28. Juni ab 19:30 Uhr\nAnzünden des Feuers gegen 23 Uhr\nReservierung der Mahlzeiten unter 06 17 11 37 73"
        ],
        "en": [
          "Midsummer bonfires in Verchin on Saturday June 28th from 7.30pm\nFire lighting around 11pm\nMeal reservations on 06 17 11 37 73"
        ],
        "it": [
          "Falò di mezza estate a Verchin sabato 28 giugno dalle 19.30\nAccensione del falò alle 23.00 circa\nI pasti possono essere prenotati al numero 06 17 11 37 73"
        ],
        "fr": [
          "Feux de la Saint-Jean à Verchin le samedi 28 juin dès 19h30\nAllumage du feu vers 23h\nRéservation des repas au 06 17 11 37 73"
        ],
        "nl": [
          "Midzomer vreugdevuur in Verchin op zaterdag 28 juni vanaf 19.30 uur\nVuur aansteken rond 23.00 uur\nMaaltijden kunnen worden gereserveerd op 06 17 11 37 73"
        ],
        "es": [
          "Hoguera de San Juan en Verchin el sábado 28 de junio a partir de las 19.30 horas\nEncendido de la hoguera hacia las 23h\nLas comidas pueden reservarse en el 06 17 11 37 73"
        ]
      },
