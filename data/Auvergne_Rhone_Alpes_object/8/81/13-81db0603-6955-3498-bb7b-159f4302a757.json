  "rdfs:comment": {
    "de": [
      "SIGNORIZZA ist der perfekte Ort, um eine Pizza (oder zwei oder drei) zu essen, ein italienisches Rezept zu genießen und dazu einen Spritz oder ein gutes Glas Wein zu trinken, in einer freundlichen Atmosphäre."
    ],
    "en": [
      "SIGNORIZZA is the ideal place to enjoy a pizza (or two or three), savour an Italian recipe and drink a Spritz or a glass of wine in a friendly atmosphere."
    ],
    "it": [
      "SIGNORIZZA è il luogo ideale per gustare una pizza (o due o tre), assaporare una ricetta italiana e bere uno Spritz o un buon bicchiere di vino in un'atmosfera amichevole."
    ],
    "fr": [
      "SIGNORIZZA c’est l’endroit rêvé pour déguster une pizza (ou deux ou trois), savourer une recette italienne et boire un Spritz ou un bon verre de vin, dans une ambiance conviviale."
    ],
    "nl": [
      "SIGNORIZZA is de perfecte plek om te genieten van een pizza (of twee of drie), een Italiaans recept te proeven en een Spritz of een goed glas wijn te drinken in een gezellige sfeer."
    ],
    "es": [
      "SIGNORIZZA es el lugar perfecto para disfrutar de una pizza (o dos o tres), saborear una receta italiana y tomar un Spritz o una buena copa de vino en un ambiente agradable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria Signorizza"
    ]
  },
