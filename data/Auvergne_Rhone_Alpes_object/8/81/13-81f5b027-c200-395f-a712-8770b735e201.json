  "rdfs:comment": {
    "de": [
      "Die Boulangerie Triboulet stellt auf handwerkliche Weise Brot, Gebäck und Feingebäck her. Backwaren, Viennoiserie und Spezialitäten aus Bourbonnais, die nach traditioneller Art zubereitet werden."
    ],
    "en": [
      "Boulangerie Triboulet makes artisan breads, pastries and viennoiseries. Pastries, viennoiseries and Bourbonnais specialties prepared in the traditional way."
    ],
    "it": [
      "La Boulangerie Triboulet produce pane, pasticceria e viennoiseries tradizionali. Pasticceria, viennoiseries e specialità Bourbonnais preparate secondo la tradizione."
    ],
    "fr": [
      "La Boulangerie Triboulet fabrique de manière artisanale des pains, des pâtisseries et des viennoiseries. Des pâtisseries, viennoiseries et spécialités bourbonnaises préparées selon la tradition."
    ],
    "es": [
      "La Boulangerie Triboulet elabora pan, bollería y viennoiseries tradicionales. Bollería, viennoiseries y especialidades Bourbonnais preparadas según la tradición."
    ],
    "nl": [
      "Boulangerie Triboulet maakt ambachtelijk brood, gebak en viennoiseries. Gebak, viennoiseries en Bourbonnaispecialiteiten bereid volgens traditie."
