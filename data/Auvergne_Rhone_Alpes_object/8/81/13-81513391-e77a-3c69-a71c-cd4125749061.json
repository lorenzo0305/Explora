  "rdfs:comment": {
    "de": [
      "Unser 70 m2 großer Raum überragt den Place de la Victoire in Clermont-Ferrand und bietet einen atemberaubenden Blick auf die emblematische Kathedrale Notre-Dame-de-L'Assomption. Er befindet sich im Herzen des historischen Zentrums mit seinen lebhaften Bars, Geschäften und Restaurants."
    ],
    "en": [
      "Our 70m2 venue overlooks the Place de la Victoire in Clermont-Ferrand, with a breathtaking view of the iconic Notre-Dame-de-L'Assomption Cathedral. It's located in the heart of the historic center, with its lively bars, shops and restaurants."
    ],
    "it": [
      "La nostra camera di 70 m2 si affaccia su Place de la Victoire a Clermont-Ferrand e offre una vista mozzafiato sull'iconica Cattedrale di Notre-Dame-de-L'Assomption. Si trova nel cuore del centro storico con i suoi vivaci bar, negozi e ristoranti."
    ],
    "fr": [
      "Notre salle de 70m2 surplombe la place de la Victoire à Clermont-Ferrand et offre une vue imprenable sur l’emblématique Cathédrale Notre-Dame-de-L'Assomption. Elle est située au cœur du centre historique avec ses bars, commerces et restaurants animés."
    ],
    "nl": [
      "Onze kamer van 70m2 kijkt uit op de Place de la Victoire in Clermont-Ferrand en biedt een adembenemend uitzicht op de iconische kathedraal Notre-Dame-de-L'Assomption. Het ligt in het hart van het historische centrum met zijn levendige bars, winkels en restaurants."
    ],
    "es": [
      "Nuestra habitación de 70 m2 da a la plaza de la Victoire de Clermont-Ferrand y ofrece una vista impresionante de la emblemática catedral de Notre-Dame-de-L'Assomption. Está situada en pleno centro histórico, con sus animados bares, tiendas y restaurantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de conférence place de la Victoire"
    ]
  },
