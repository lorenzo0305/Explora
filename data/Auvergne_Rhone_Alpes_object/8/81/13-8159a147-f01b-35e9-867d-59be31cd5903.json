  "rdfs:comment": {
    "de": [
      "Restaurant Aspekt Chalet Montagnard, mit Südterrasse mit Blick auf den Vercors und das Tal. Genießen Sie unsere traditionellen Berggerichte und Spezialitäten."
    ],
    "en": [
      "Mountain chalet-looking restaurant, with south-facing terrace and view of the Vercors and the valley. Come and taste our traditional montagne dishes and specialities."
    ],
    "it": [
      "Ristorante dello Chalet Montagnard, con terrazza esposta a sud con vista sul Vercors e sulla valle. Venite a gustare i nostri piatti e le nostre specialità tradizionali di montagna."
    ],
    "fr": [
      "Restaurant aspect Chalet Montagnard, avec terrasse plein sud donnant sur le Vercors et la vallée. Venez déguster nos plats traditionnels de montagne et nos spécialités."
    ],
    "es": [
      "Restaurante del Chalet Montagnard, con una terraza orientada al sur con vistas al Vercors y al valle. Venga a degustar nuestros platos y especialidades tradicionales de montaña."
    ],
    "nl": [
      "Chalet Montagnard restaurant, met een terras op het zuiden met uitzicht op de Vercors en de vallei. Kom en proef onze traditionele berggerechten en specialiteiten."
    ]
  },
