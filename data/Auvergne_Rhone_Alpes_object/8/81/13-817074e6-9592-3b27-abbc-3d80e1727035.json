  "rdfs:comment": {
    "de": [
      "Parcours für Erwachsene und Jugendliche. Die Route verläuft horizontal entlang des Felsens, mit einigen vertikalen Passagen ohne Schwierigkeiten. Am Ende des Parcours kann man zu La Testouriasso (schwierig) übergehen."
    ],
    "en": [
      "Course for adults and teenagers. The circuit runs horizontally along the rock, with a few vertical sections that are not too difficult. At the end of the route, you can continue on to La Testouriasso (difficult)."
    ],
    "it": [
      "Percorso per adulti e ragazzi. Il percorso si sviluppa orizzontalmente lungo la roccia, con alcuni tratti verticali non troppo difficili. Alla fine del percorso, si può proseguire per La Testouriasso (difficile)."
    ],
    "fr": [
      "Parcours pour adultes et adolescents. Le circuit évolue à l'horizontal, le long du rocher, avec quelques passages verticaux sans difficultés. A la fin du parcours, il est possible d'enchaîner sur La Testouriasso (difficile)."
    ],
    "es": [
      "Recorrido para adultos y adolescentes. La ruta discurre horizontalmente a lo largo de la roca, con algunos tramos verticales no demasiado difíciles. Al final de la ruta, se puede continuar hacia La Testouriasso (difícil)."
    ],
    "nl": [
      "Parcours voor volwassenen en tieners. De route loopt horizontaal langs de rotsen, met een paar verticale stukken die niet al te moeilijk zijn. Aan het einde van de route kun je verder naar La Testouriasso (moeilijk)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Ferrata La Nouvelle"
    ]
  },
