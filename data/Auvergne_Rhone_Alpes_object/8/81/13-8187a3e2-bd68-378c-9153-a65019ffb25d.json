  "rdfs:comment": {
    "de": [
      "In einer modernen und gemütlichen Umgebung, die für alle Padel-Fans gedacht ist. Dieser Club der neuen Generation wurde konzipiert, um ein umfassendes Sporterlebnis zu bieten, das sowohl für Anfänger als auch für erfahrene Wettkampfspieler zugänglich ist."
    ],
    "en": [
      "In a modern, welcoming setting designed for all padel enthusiasts. This new-generation club has been designed to offer a complete sporting experience, accessible to beginners and experienced competitors alike."
    ],
    "it": [
      "In un ambiente moderno e accogliente, pensato per tutti gli appassionati di padel. Questo club di nuova generazione è stato progettato per offrire un'esperienza sportiva completa, accessibile sia ai principianti che agli agonisti più esperti."
    ],
    "fr": [
      "Dans un cadre moderne et chaleureux pensé pour tous les passionnés de padel. Ce club nouvelle génération a été conçu pour offrir une expérience sportive complète, accessible aussi bien aux joueurs débutants qu’aux compétiteurs confirmés."
    ],
    "nl": [
      "In een moderne, gastvrije omgeving ontworpen voor alle padelliefhebbers. Deze club van de nieuwe generatie is ontworpen om een complete sportervaring te bieden, toegankelijk voor zowel beginners als ervaren deelnemers."
    ],
    "es": [
      "En un entorno moderno y acogedor pensado para todos los aficionados al pádel. Este club de nueva generación ha sido diseñado para ofrecer una experiencia deportiva completa, accesible tanto a principiantes como a competidores experimentados."
    ]
  },
  "rdfs:label": {
