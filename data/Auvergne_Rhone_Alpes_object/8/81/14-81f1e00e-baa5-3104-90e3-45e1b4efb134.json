  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/067e4336-f3dc-3bb3-842a-4ce8b40eff1a",
      "dc:description": {
        "de": [
          "Neu in der Gemeinde Rang-du-Fliers, um den Tanz, die Musik und die Wärme der Country-Welt zu entdecken.\nJeden Donnerstag von 19:00 bis 21:00 Uhr\n3 kostenlose Probestunden\nJahresmitgliedschaft: 40?"
        ],
        "en": [
          "New in the commune of Rang-du-Fliers to discover the dance, music and warmth of the Country world.\nEvery Thursday from 7pm to 9pm\n3 free trials\nAnnual membership: 40?"
        ],
        "it": [
          "Novità a Rang-du-Fliers per scoprire la danza, la musica e il calore del mondo Country.\nOgni giovedì dalle 19.00 alle 21.00\n3 prove gratuite\nIscrizione annuale: 40?"
        ],
        "fr": [
          "Nouveau sur la commune de Rang-du-Fliers pour découvrir la danse, la musique et la chaleur du monde Country.\nTous les jeudis de 19h à 21h\n3 essais gratuits\nAdhésion annuelle : 40€"
        ],
        "es": [
          "Nuevo en Rang-du-Fliers para descubrir la danza, la música y el calor del mundo Country.\nTodos los jueves de 19:00 a 21:00\n3 pruebas gratuitas\nAbono anual: 40?"
        ],
        "nl": [
          "Nieuw in Rang-du-Fliers om de dans, muziek en warmte van de Country wereld te ontdekken.\nElke donderdag van 19u tot 21u\n3 gratis proeflessen\nJaarlijks lidmaatschap: 40?"
        ]
      },
      "@type": [
        "Description"
