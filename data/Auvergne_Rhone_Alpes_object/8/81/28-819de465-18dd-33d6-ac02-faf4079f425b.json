  "rdfs:comment": {
    "de": [
      "Weinbar und Lebensmittelgeschäft mit französischen Terroirprodukten - Aperitifbar / before - Große Auswahl an Weinen aus den verschiedenen Regionen Frankreichs.\nLes Frères Pinard beraten Sie in Bezug auf Weine, Biere und Produkte aus dem französischen Terroir.\nBestellungen mit Abholung im Laden möglich."
    ],
    "en": [
      "French wine bar and grocery store - Aperitif bar / before - Wide variety of wines from different French regions.\nLes Frères Pinard advise you on wines, beers and local French produce.\nOrders can be placed and picked up in store."
    ],
    "it": [
      "Enoteca e negozio di prodotti locali francesi - Aperitivo / prima bar - Ampia varietà di vini provenienti da diverse regioni francesi.\nLes Frères Pinard possono consigliarvi su vini, birre e prodotti locali francesi.\nLe ordinazioni possono essere effettuate e ritirate presso il negozio."
    ],
    "fr": [
      "Bar à vin et épicerie de produits du terroir français - Bar d'apéro / before - Grande variété de vins des différentes régions françaises.\nLes Frères Pinard vous conseillent en matière de vins, bières et produits du terroir français.\nCommandes possibles avec retrait en boutique."
    ],
    "nl": [
      "Wijnbar en Franse streekproductenwinkel - Aperitief/voorbar - Grote verscheidenheid aan wijnen uit verschillende Franse regio's.\nLes Frères Pinard kan je adviseren over wijnen, bieren en lokale Franse producten.\nBestellingen kunnen worden geplaatst en afgehaald in de winkel."
    ],
    "es": [
      "Bar de vinos y tienda de productos locales franceses - Aperitivo / antes del bar - Amplia variedad de vinos de diferentes regiones francesas.\nLes Frères Pinard pueden aconsejarle sobre vinos, cervezas y productos locales franceses.\nLos pedidos se pueden hacer y recoger en la tienda."
    ]
  },
