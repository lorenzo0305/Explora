  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet der Club Nautique de Vichy eine kostenlose Schnupperstunde an: Segeln.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Club Nautique de Vichy is offering a free sailing discovery session.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, il Club Nautique de Vichy offre una sessione di vela introduttiva gratuita.\r\nInformazioni e iscrizioni per telefono."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Club Nautique de Vichy propose une séance gratuite de découverte : de la Voile.\r\nRenseignements et inscription par téléphone."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, el Club Nautique de Vichy ofrece una sesión gratuita de iniciación a la vela.\r\nInformación e inscripciones por teléfono."
    ],
    "nl": [
      "Als onderdeel van het vitaliteitsprogramma van Vichy biedt Club Nautique de Vichy een gratis kennismakingssessie zeilen aan.\r\nInformatie en inschrijving per telefoon."
    ]
  },
