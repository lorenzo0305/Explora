  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a18337c8-35a8-341c-a785-7fce69adfd48",
      "dc:description": {
        "de": [
          "Merlimoules, Handel mit frischen und schmackhaften Meeresprodukten. Unser Hauptgeschäft ist der Verkauf von hochwertigem Fisch und Meeresfrüchten, mit besonderem Augenmerk auf Bouchot-Muscheln, einer regionalen Spezialität, die für ihren außergewöhnlichen Geschmack bekannt ist."
        ],
        "en": [
          "Merlimoules, fresh and tasty seafood. Our core business is the sale of top-quality fish and seafood, with a particular focus on bouchot mussels, a regional specialty renowned for its exceptional taste."
        ],
        "it": [
          "Merlimoules, frutti di mare freschi e gustosi. Il nostro core business è la vendita di pesce e frutti di mare di alta qualità, con particolare attenzione alle cozze bouchot, una specialità regionale rinomata per il suo sapore eccezionale."
        ],
        "fr": [
          "Merlimoules, commerce de produits de la mer frais et savoureux. Notre activité principale est la vente de poissons et fruits de mer de qualité supérieure, avec une attention particulière portée aux moules de bouchot, une spécialité régionale réputée pour leur goût exceptionnel."
        ],
        "nl": [
          "Merlimoules, verse en smakelijke zeevruchten. Onze kernactiviteit is de verkoop van vis en zeevruchten van topkwaliteit, met speciale aandacht voor bouchotmosselen, een regionale specialiteit die bekend staat om zijn uitzonderlijke smaak."
        ],
        "es": [
          "Merlimoules, marisco fresco y sabroso. Nuestra actividad principal es la venta de pescado y marisco de primera calidad, con especial atención a los mejillones bouchot, una especialidad regional famosa por su sabor excepcional."
        ]
      },
      "@type": [
        "Description"
      ],
