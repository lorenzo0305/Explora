  "rdfs:comment": {
    "de": [
      "Médié'scape: zwei Escape-Game-Räume in der mittelalterlichen Stadt Crémieu. Ein immersives Dekor lässt Sie in eine völlig verrückte Umgebung eintauchen.  \r\nSie haben eine Stunde Zeit, um einen Weg zu finden, aus einer dieser beiden Welten zu entkommen!"
    ],
    "en": [
      "Médié'scape are two escape game rooms located in the medieval town of Crémieu. An immersive setting plunges you into the heart of a totally insane environment.  You have one hour to find a way to escape from one of these two worlds !"
    ],
    "it": [
      "Médié'scape: due escape game room nella città medievale di Crémieu. Un'ambientazione coinvolgente vi immerge nel cuore di un ambiente totalmente folle.  \r\nAvete un'ora di tempo per trovare il modo di fuggire da uno di questi due mondi!"
    ],
    "fr": [
      "Médié'scape : deux salles d'escape game dans la cité médiévale de Crémieu. Un décor immersif vous plonge au cœur d’un environnement totalement insensé.  \r\nVous avez une heure pour trouver le moyen de vous échapper de l'un de ces deux univers !"
    ],
    "nl": [
      "Médié'scape: twee escape game rooms in de middeleeuwse stad Crémieu. Een meeslepende setting dompelt je onder in het hart van een totaal krankzinnige omgeving.  \r\nJe hebt een uur om een manier te vinden om uit een van deze twee werelden te ontsnappen!"
    ],
    "es": [
      "Médié'scape: dos salas de juegos de escape en la ciudad medieval de Crémieu. Un escenario inmersivo le sumerge en el corazón de un entorno totalmente demencial.  \r\nTienes una hora para encontrar la forma de escapar de uno de estos dos mundos"
    ]
  },
  "rdfs:label": {
    "en": [
