  "rdfs:comment": {
    "de": [
      "Restaurant am Ufer des Sees von Flérier mit hausgemachter Küche aus frischen Produkten.\r\n\r\nAuf der Speisekarte stehen italienische, französische und schweizerische Gerichte.\r\n\r\nMöglichkeit, ein Fondue alleine zu essen.\r\n\r\nRuhige Lage in idyllischer Umgebung."
    ],
    "en": [
      "Restaurant on the shores of Flérier lake, serving home-cooked food made with fresh produce.\r\n\r\nMenu featuring Italian, French and Swiss cuisine.\r\n\r\nFondue available on your own.\r\n\r\nQuiet, idyllic setting."
    ],
    "it": [
      "Ristorante sulle rive del lago Flérier che serve piatti casalinghi preparati con prodotti freschi.\r\n\r\nMenu con cucina italiana, francese e svizzera.\r\n\r\nFonduta disponibile su richiesta.\r\n\r\nPace e tranquillità in un ambiente idilliaco."
    ],
    "fr": [
      "Restaurant au bord du lac de Flérier proposant une cuisine faite maison à partir de produits frais.\r\n\r\nCarte proposant de la cuisine italienne, français et suisse.\r\n\r\nPossibilité de manger une fondue en solo.\r\n\r\nAu calme dans un cadre idyllique."
    ],
    "es": [
      "Restaurante a orillas del lago de Flérier que sirve comida casera elaborada con productos frescos.\r\n\r\nMenú de cocina italiana, francesa y suiza.\r\n\r\nFondue disponible por su cuenta.\r\n\r\nPaz y tranquilidad en un entorno idílico."
    ],
    "nl": [
      "Restaurant aan de oevers van het meer van Flérier waar huisgemaakte gerechten met verse producten worden geserveerd.\r\n\r\nMenu met Italiaanse, Franse en Zwitserse keuken.\r\n\r\nFondue beschikbaar op eigen gelegenheid.\r\n\r\nRust en stilte in een idyllische omgeving."
    ]
  },
