  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/560e8636-9596-369b-a2d8-091e5ac90bc0",
      "dc:description": {
        "de": [
          "Die Kirche Saint-Gilles wurde in einer einzigen Baukampagne um 1500 im Stil der Flamboyant-Gotik errichtet. Sie besteht aus einem Kirchenschiff, einem Querschiff und einem Chor, der von einer Apsis mit abgeschrägten Kanten abgeschlossen wird. Seit 1930 steht sie unter Denkmalschutz."
        ],
        "en": [
          "Saint-Gilles church was built in a single campaign around 1500, in the flamboyant Gothic style. It comprises a nave, a transept and a choir ending in a canted apse. It has been a listed monument since 1930."
        ],
        "it": [
          "La chiesa di Saint-Gilles fu costruita in un'unica campagna intorno al 1500, in stile gotico fiammeggiante. È composta da una navata, un transetto e un coro che termina con un'abside a sbalzo. È un monumento classificato dal 1930."
        ],
        "fr": [
          "L'église Saint-Gilles a été bâtie en une seule campagne de construction vers 1500, dans le style gothique flamboyant. Elle se compose d'une nef, d'un transept et d'un chœur terminé par une abside à pans coupés. Elle est classée monument historique depuis 1930."
        ],
        "es": [
          "La iglesia de Saint-Gilles fue construida en una sola campaña hacia 1500, en estilo gótico flamígero. Consta de una nave, un crucero y un coro rematados en un ábside inclinado. Está clasificada como monumento desde 1930."
        ],
        "nl": [
          "De kerk van Sint-Gillis werd rond 1500 in één keer gebouwd in de flamboyante gotische stijl. Ze bestaat uit een schip, een dwarsschip en een koor dat eindigt in een afgeschuinde apsis. De kerk staat sinds 1930 op de monumentenlijst."
        ]
      },
      "@type": [
        "Description"
      ],
