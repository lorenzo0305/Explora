  "rdfs:comment": {
    "de": [
      "Im Herzen der Monts du Cantal, zwischen Aurillac und dem Puy Mary (Grand Site National), besuchen Sie das Dorf St Simon und seine Kirche."
    ],
    "en": [
      "In the heart of the Mounts of Cantal in the Jordanne Valley, between Aurillac and the Puy Mary, come and visit the village and its church."
    ],
    "it": [
      "Nel cuore dei Monts du Cantal, tra Aurillac e Puy Mary (Grand Site National), visitate il villaggio di St Simon e la sua chiesa."
    ],
    "fr": [
      "Au cœur des Monts du Cantal, entre Aurillac et le Puy Mary (Grand Site National), visitez le village de St Simon et son église."
    ],
    "nl": [
      "In het hart van de Monts du Cantal, tussen Aurillac en Puy Mary (Grand Site National), bezoek je het dorpje St Simon en zijn kerk."
    ],
    "es": [
      "En el corazón de los Montes del Cantal en el valle del Jordanne, entre Aurillac y el Puy Mary, ven a visitar el pueblo de Saint Simon y su iglesia."
    ]
