  "rdfs:comment": {
    "de": [
      "Eine großzügige und schmackhafte Mahlzeit auf 2300 m Höhe, ein überarbeitetes Selbstbedienungsrestaurant, das Ihnen eine leckere und gesellige Küche bietet: Willkommen in La Petite Cuisine de La Folie Douce Alpe d'Huez!"
    ],
    "en": [
      "A generous, tasty meal on the go at 2300 m altitude, a revamped self-service offering gourmet, convivial cuisine: welcome to La Petite Cuisine de La Folie Douce Alpe d'Huez!"
    ],
    "it": [
      "Un pasto generoso e gustoso in movimento a 2300 metri di altitudine, un self-service rinnovato che propone una cucina gourmet e conviviale: benvenuti a La Petite Cuisine de La Folie Douce Alpe d'Huez!"
    ],
    "fr": [
      "Un repas généreux et savoureux pris sur le pouce à 2300 m d’altitude, un self-service revisité qui vous proposera une cuisine gourmande et conviviale : bienvenue à La Petite Cuisine de La Folie Douce Alpe d’Huez !"
    ],
    "es": [
      "Una comida generosa y sabrosa sobre la marcha a 2.300 m de altitud, un autoservicio renovado que ofrece una cocina gastronómica y de convivencia: ¡bienvenido a La Petite Cuisine de La Folie Douce Alpe d'Huez!"
    ],
    "nl": [
      "Een royale, smakelijke maaltijd onderweg op 2300 m hoogte, een vernieuwd zelfbedieningsrestaurant met een vriendelijke, gastronomische keuken: welkom bij La Petite Cuisine de La Folie Douce Alpe d'Huez!"
    ]
  },
