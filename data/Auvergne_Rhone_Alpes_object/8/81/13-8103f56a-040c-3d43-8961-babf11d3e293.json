  "rdfs:comment": {
    "de": [
      "Ein Lokal mit 40 bis 50 Plätzen, das als Maître Restaurateur ausgezeichnet ist und eine Küche im Stil eines Bistros auf der Grundlage lokaler, frischer und saisonaler Produkte anbietet.\r\nTagesmenü: Vorspeise, Hauptgericht, Dessert ab 20 ?"
    ],
    "en": [
      "Émilie and Julien serve an authentic cuisine, which communicates their love of cooking. Fresh and local produce. Closed Sunday evenings, Monday all day and Tuesday evening."
    ],
    "it": [
      "Locale con 40-50 coperti, insignito del marchio Maître Restaurateur, che propone una cucina da bistrot a base di prodotti locali, freschi e di stagione.\r\nMenu del giorno: antipasto, piatto principale, dessert a partire da ? 20."
    ],
    "fr": [
      "Etablissement de 40 à 50 couverts, labellisé Maître restaurateur, proposant une cuisine type bistrot, à base de produit locaux, frais et de saison. \r\nMenu du jour : entrée, plat, dessert à partir de 20 €."
    ],
    "nl": [
      "Etablissement met 40 tot 50 couverts, bekroond met het label Maître Restaurateur, biedt een bistrokeuken op basis van lokale, verse seizoensproducten.\r\nDagmenu: voorgerecht, hoofdgerecht, dessert vanaf 20 euro."
    ],
    "es": [
      "Establecimiento de 40 a 50 cubiertos, galardonado con el sello Maître Restaurateur, que ofrece una cocina de estilo bistró basada en productos locales, frescos y de temporada.\r\nMenú diario: entrante, plato principal y postre a partir de 20 €."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant O P'tit jus - Le Relais Délys"
    ]
  },
