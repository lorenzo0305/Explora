  "rdfs:comment": {
    "de": [
      "Unser Team aus Bergführern und Begleitern in Mittelgebirgen bietet Ihnen zahlreiche Aktivitäten an, mit denen Sie Ihr Vergnügen variieren, Ihre Praxis bereichern oder perfektionieren können."
    ],
    "en": [
      "Our team of High Mountain Guides and Mountain Leaders offers you a wide range of activities that will enable you to vary your pleasures, enrich or perfect your practice."
    ],
    "it": [
      "Il nostro team di guide di alta montagna e di guide di media montagna offre una vasta gamma di attività per aiutarvi a variare il vostro divertimento e a migliorare o perfezionare le vostre abilità alpinistiche."
    ],
    "fr": [
      "Notre équipe de Guides de Haute Montagne et Accompagnateurs en Moyenne Montagne vous propose de nombreuses activités qui vous permettront de varier vos plaisirs, d'enrichir ou de perfectionner votre pratique."
    ],
    "nl": [
      "Ons team van berggidsen en bergleiders biedt een breed scala aan activiteiten om je te helpen je plezier te variëren en je bergbeklimvaardigheden te verbeteren of te perfectioneren."
    ],
    "es": [
      "Nuestro equipo de Guías de Alta Montaña y Líderes de Media Montaña ofrecen una amplia gama de actividades para ayudarle a variar su disfrute y mejorar o perfeccionar sus habilidades montañeras."
    ]
  },
