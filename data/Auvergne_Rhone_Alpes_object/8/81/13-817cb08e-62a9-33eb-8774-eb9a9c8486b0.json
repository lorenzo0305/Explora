  "rdfs:comment": {
    "de": [
      "Ein innovativer Hänge-Freizeitpark ohne Klettergurt im Herzen des Waldes und des Skigebiets Grand Echaillon! Je nach Wetterlage in vier Jahreszeiten geöffnet. Der Abenteuerparcours ist für alle zugänglich, für Groß und Klein, Kinder ab 3 Jahren!"
    ],
    "en": [
      "An innovative suspended leisure park without a harness in the heart of the forest and the Grand Echaillon resort! Open 4 seasons according to weather conditions. The adventure course is accessible to all, young and old, children from 3 years old !"
    ],
    "it": [
      "Un innovativo parco divertimenti sospeso senza imbracatura nel cuore della foresta e del Grand Echaillon! Aperto 4 stagioni a seconda delle condizioni meteorologiche. Il percorso avventura è accessibile a tutti, grandi e piccini, bambini a partire dai 3 anni!"
    ],
    "fr": [
      "Un parc de loisir suspendu innovant sans baudrier au cœur de la forêt et de la station du Grand Echaillon ! Ouverture 4 saisons selon conditions météo. Le parcours aventure est accessible à tous, petits et grands, enfants à partir de 3 ans !"
    ],
    "es": [
      "Un innovador parque de ocio suspendido sin arnés en el corazón del bosque y de la estación de Grand Echaillon Abierto 4 temporadas en función de las condiciones meteorológicas. El recorrido de aventura es accesible a todos, jóvenes y mayores, ¡niños a partir de 3 años!"
    ],
    "nl": [
      "Een innovatief hangend recreatiepark zonder harnas in het hart van het bos en het resort Grand Echaillon! 4 seizoenen geopend, afhankelijk van de weersomstandigheden. Het avonturenparcours is toegankelijk voor iedereen, jong en oud, kinderen vanaf 3 jaar!"
    ]
  },
