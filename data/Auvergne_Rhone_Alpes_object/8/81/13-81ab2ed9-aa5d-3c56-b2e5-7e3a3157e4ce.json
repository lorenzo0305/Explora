  "rdfs:comment": {
    "de": [
      "Der ganzjährig geöffnete Golf de Vezac Aurillac (18 Löcher) liegt im alten Tal des Flusses Cère, 7 km von Aurillac entfernt."
    ],
    "en": [
      "Open all year round, 7 days a week, lessons for beginners and experienced golfers. In the beautiful setting of the Cere valley, come and play on this 18 hole golf course which covers 5,000 metres (par 69) with outdoor and indoor driving ranges, 2 greens and a bunker."
    ],
    "it": [
      "Aperto tutto l'anno, il Vezac Aurillac Golf Club (18 buche) si trova nell'antica valle della Cère, a 7 km da Aurillac."
    ],
    "fr": [
      "Ouvert toute l'année, le Golf de Vezac Aurillac (18 trous) est situé dans l'ancienne vallée de la Cère à 7km d'Aurillac."
    ],
    "es": [
      "El Golf Club Vézac se encuentra en el Valle de la Cère a 7 km de Aurillac. Ven a practicar golf en este campo de golf de 5.000 metros (par 69), 18 hoyos, 17 campos de prácticas, 7 cubiertos y los demás al aire libre, 2 Green y un búnker."
    ],
    "nl": [
      "De Vezac Aurillac Golf Club (18 holes) is het hele jaar door geopend en ligt in de oude Cère-vallei, op 7 km van Aurillac."
    ]
  },
