  "rdfs:comment": {
    "de": [
      "Das La Belle Métairie empfängt Sie in freundlicher Atmosphäre und lädt Sie ein, traditionelle Hausmannskost, darunter hausgemachtes Gebäck, zu genießen. Verbringen Sie einen köstlichen und authentischen Moment auf der wunderschönen Sonnenterrasse mit Blick auf den Mont Blanc."
    ],
    "en": [
      "La Belle Métairie welcomes you in a friendly atmosphere to enjoy traditional, home-style cooking, including homemade pastries. Savor a delicious and authentic moment on the beautiful sunny terrace facing Mont Blanc."
    ],
    "it": [
      "La Belle Métairie vi accoglie in un'atmosfera amichevole per gustare una cucina tradizionale e familiare e dolci fatti in casa. Godetevi un'autentica esperienza gastronomica sulla terrazza soleggiata di fronte al Monte Bianco."
    ],
    "fr": [
      "La Belle Métairie vous accueille dans une ambiance conviviale pour déguster une cuisine traditionnelle et familiale, avec ses pâtisseries maison. Profitez d’un moment gourmand et authentique sur la belle terrasse ensoleillée face au Mont-Blanc."
    ],
    "nl": [
      "La Belle Métairie verwelkomt je in een vriendelijke sfeer om te genieten van traditionele, familiale gerechten en huisgemaakt gebak. Geniet van een authentieke gastronomische ervaring op het zonnige terras met uitzicht op de Mont Blanc."
    ],
    "es": [
      "La Belle Métairie le da la bienvenida en un ambiente acogedor para disfrutar de una cocina tradicional y familiar y de repostería casera. Disfrute de una auténtica experiencia gastronómica en la soleada terraza frente al Mont Blanc."
    ]
  },
