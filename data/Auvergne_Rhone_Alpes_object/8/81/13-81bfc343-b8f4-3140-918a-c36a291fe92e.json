  "rdfs:comment": {
    "de": [
      "Die Angelstrecke ohne zu töten des Vizézy ist wirklich zu entdecken, vor allem wegen seiner schönen Population von Wildforellen mit ihrem prächtigen Kleid!"
    ],
    "en": [
      "The Vizézy no-kill fishing route is a real must-see, not least for its population of beautiful wild trout!"
    ],
    "it": [
      "L'itinerario di pesca no-kill di Vizézy è un vero e proprio must, anche per la sua splendida popolazione di trote selvatiche!"
    ],
    "fr": [
      "Le parcours de pêche sans tuer du Vizézy est véritablement à découvrir notamment pour sa belle population de truites sauvages à la magnifique robe !"
    ],
    "es": [
      "La ruta de pesca sin muerte de Vizézy es una visita obligada, sobre todo por su hermosa población de truchas salvajes"
    ],
    "nl": [
      "De no-kill visroute van Vizézy is een echte aanrader, niet in de laatste plaats vanwege de prachtige populatie wilde forel!"
    ]
