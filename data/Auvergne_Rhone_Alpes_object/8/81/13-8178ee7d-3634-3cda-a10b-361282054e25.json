  "rdfs:comment": {
    "de": [
      "Treffen Sie sich mit der Familie oder mit Freunden auf der Freizeitanlage La Buidonnière, um nach dem Verlassen des Schwimmbads oder des Pumptracks, bei einer Partie Pétanque, Tennis oder Minigolf eine Gourmetpause einzulegen.\r\nMag d'Oé verwöhnt Sie mit seinen Spezialitäten!"
    ],
    "en": [
      "Meet up with family and friends at the Buidonnière leisure park for a gourmet break after a swim or a game of Pumptrack, pétanque, tennis or minigolf.\r\nMag d'Oé will delight you with its specialties!"
    ],
    "it": [
      "Venite al centro ricreativo Buidonnière con la famiglia o gli amici per una pausa gourmet dopo una partita a pétanque, tennis o minigolf.\r\nIl Mag d'Oé vi delizierà con le sue specialità!"
    ],
    "fr": [
      "Rendez-vous sur la base de loisirs de la Buidonnière en famille, entre amis, pour une pause gourmande à la sortie de la piscine ou du Pumptrack, autour d'une bonne partie de pétanque, de tennis ou de minigolf.\r\nMag d'Oé vous régale avec ses spécialités !"
    ],
    "es": [
      "Venga al centro de ocio de la Buidonnière con su familia o amigos para una pausa gastronómica después de un partido de petanca, tenis o minigolf.\r\nEl Mag d'Oé le deleitará con sus especialidades"
    ],
    "nl": [
      "Kom met je gezin of vrienden naar het recreatiecentrum Buidonnière voor een gastronomische pauze na het zwemmen of het spelen van Pumptrack, of voor een spelletje petanque, tennis of minigolf.\r\nMag d'Oé zal u verrukken met zijn specialiteiten!"
    ]
  },
