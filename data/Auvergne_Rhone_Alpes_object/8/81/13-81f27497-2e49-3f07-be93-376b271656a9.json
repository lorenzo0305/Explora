  "rdfs:comment": {
    "de": [
      "Seit 1994, nur wenige Schritte vom Gymnasium entfernt, ein einladender Tisch mit einer Küche aus aller Welt und einer Speisekarte, die für jeden Geschmack etwas bietet. Hamburger, Kebab, Pizzas, Miron-Spezialität Getränke."
    ],
    "en": [
      "Since 1994, next to the high school, friendly atmosphere and world cooking for all tastes. Hamburgers, kebabs, pizzas and specialty \"Miron\" drink."
    ],
    "it": [
      "Dal 1994, a due passi dal liceo, un ristorante accogliente che propone una cucina mondiale e un menu per tutti i gusti. Hamburger, kebab, pizze, bevande speciali Miron."
    ],
    "fr": [
      "Depuis 1994, à deux pas du lycée, une table accueillante avec une cuisine du monde et une carte adaptée à tous les goûts. Hamburgers, kebabs, pizzas, spécialité Miron boisson."
    ],
    "nl": [
      "Sinds 1994, op een steenworp afstand van het lyceum, een gastvrij restaurant met wereldkeuken en een menu naar ieders smaak. Hamburgers, kebab, pizza's, speciale drankjes van Miron."
    ],
    "es": [
      "Desde 1994, a dos pasos del liceo, un restaurante acogedor que sirve cocina del mundo y una carta para todos los gustos. Hamburguesas, kebabs, pizzas, especialidades Miron."
    ]
  },
