  "rdfs:comment": {
    "de": [
      "Dieser Park ist ganz nach dem Thema Ahorn (mehr als 50 Sorten) gestaltet. Er bietet mit seinem Riesenschachbrett, seiner Tischtennisplatte und seinem Kindergarten einen originellen Moment der Entspannung."
    ],
    "en": [
      "This park is entirely designed around the theme of maple trees (over 50 varieties). With its giant chessboard, ping-pong table and children's playground, it offers an original moment of relaxation."
    ],
    "it": [
      "Questo parco è interamente progettato intorno al tema degli aceri (oltre 50 varietà). Con la sua scacchiera gigante, il tavolo da ping-pong e il parco giochi per bambini, è un luogo originale per rilassarsi."
    ],
    "fr": [
      "Ce parc est entièrement aménagé sur le thème de l'érable (plus de 50 variétés). Il offre un moment de détente original avec son échiquier géant, sa table de ping - pong et son jardin d'enfants."
    ],
    "es": [
      "Este parque está enteramente diseñado sobre el tema del arce (más de 50 variedades). Ofrece un momento original de relajación con su tablero de ajedrez gigante, su mesa de ping-pong y su jardín infantil."
    ],
    "nl": [
      "Dit park is volledig ontworpen rond het thema esdoorns (meer dan 50 variëteiten). Met zijn reuzenschaakbord, pingpongtafel en kinderspeelplaats biedt het een originele manier om te ontspannen."
    ]
  },
  "rdfs:label": {
