  "rdfs:comment": {
    "de": [
      "Vom 1. Juliwochenende bis zum letzten Augustwochenende wird in der Base de Loisirs d'ILOA im Zentrum des regionalen Naturparks Livradois Forez ein Badestrand eingerichtet."
    ],
    "en": [
      "Swimming is available from the 1st weekend of July to the last weekend of August at the Base de Loisirs d?ILOA in the center of the Livradois Forez Regional Nature Park."
    ],
    "it": [
      "Il nuoto è disponibile dal primo fine settimana di luglio all'ultimo fine settimana di agosto presso la Base de Loisirs d'ILOA, nel centro del Parco Naturale Regionale Livradois Forez."
    ],
    "fr": [
      "Une baignade est aménagée du 1er weekend de juillet au dernier weekend d’août sur la Base de Loisirs d’ILOA  au centre du Parc naturel régional du Livradois Forez."
    ],
    "nl": [
      "Zwemmen is mogelijk van het 1e weekend van juli tot het laatste weekend van augustus bij de Base de Loisirs d?ILOA in het centrum van het Regionale Natuurpark Livradois Forez."
    ],
    "es": [
      "Desde el primer fin de semana de julio hasta el último de agosto se puede nadar en la Base de Loisirs d'ILOA, en el centro del Parque Natural Regional de Livradois Forez."
    ]
  },
