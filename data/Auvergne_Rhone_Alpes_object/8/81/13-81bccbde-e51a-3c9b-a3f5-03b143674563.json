  "rdfs:comment": {
    "de": [
      "Ein Nuxe-Spa im Herzen der Berge. Nehmen Sie sich Zeit, um sich in einem einzigartigen, dem Wohlbefinden gewidmeten Cocooning-Bereich zu entspannen und neue Energie zu tanken."
    ],
    "en": [
      "A Nuxe spa in the heart of the mountains. Take time to relax and recharge your batteries in a unique cocooning space dedicated to well-being."
    ],
    "it": [
      "Una spa Nuxe nel cuore delle montagne. Prendetevi il tempo per rilassarvi e ricaricare le batterie in uno spazio unico dedicato al benessere."
    ],
    "fr": [
      "Un spa Nuxe au coeur des montagnes. Prenez le temps de vous détendre et vous ressourcer dans un espace cocooning unique dédié au bien-être."
    ],
    "es": [
      "Un spa Nuxe en plena montaña. Tómese su tiempo para relajarse y recargar las pilas en un espacio único dedicado al bienestar."
    ],
    "nl": [
      "Een Nuxe spa in het hart van de bergen. Neem de tijd om te ontspannen en nieuwe energie op te doen in een unieke cocooning ruimte gewijd aan welzijn."
    ]
  },
