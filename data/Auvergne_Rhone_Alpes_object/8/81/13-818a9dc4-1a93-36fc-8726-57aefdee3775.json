  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf ein Abenteuer mit Therma, einem geolokalisierten Erkundungsspiel in Royat-Chamalières! Lösen Sie mit der mobilen App GayaPlayer Rätsel und entdecken Sie das Thermalkulturerbe auf spielerische, immersive und interaktive Weise."
    ],
    "en": [
      "Go on an adventure with Therma, a geolocated exploration game in Royat-Chamalières! Equipped with the GayaPlayer mobile application, solve riddles and discover the thermal heritage in a fun, immersive and interactive way."
    ],
    "it": [
      "Partite all'avventura con Therma, un gioco di esplorazione geolocalizzato a Royat-Chamalières! Dotato dell'applicazione mobile GayaPlayer, risolvi gli enigmi e scopri il patrimonio termale in modo divertente, coinvolgente e interattivo."
    ],
    "fr": [
      "Partez à l’aventure avec Therma, un jeu d’exploration géolocalisé à Royat-Chamalières ! Équipé de l’application mobile GayaPlayer, résolvez des énigmes et découvrez le patrimoine thermal de manière ludique, immersive et interactive."
    ],
    "nl": [
      "Ga op avontuur met Therma, een geolokaliseerd ontdekkingsspel in Royat-Chamalières! Uitgerust met de mobiele applicatie GayaPlayer, los je de raadsels op en ontdek je het thermische erfgoed op een leuke, meeslepende en interactieve manier."
    ],
    "es": [
      "Embárcate en una aventura con Therma, ¡un juego de exploración geolocalizado en Royat-Chamalières! Equipado con la aplicación móvil GayaPlayer, resuelva los enigmas y descubra el patrimonio termal de forma lúdica, inmersiva e interactiva."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Therma – Le Mystère de la Pierre des Eaux"
    ]
  },
