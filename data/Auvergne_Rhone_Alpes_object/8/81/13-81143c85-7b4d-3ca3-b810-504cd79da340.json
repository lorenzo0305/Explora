  "rdfs:comment": {
    "de": [
      "Jean Christophe, der im nationalen Ausbildungszentrum für Fischereiberufe ausgebildet wurde, zeigt Ihnen anhand verschiedener angepasster Aktivitäten eine Welt, die für alle zugänglich ist."
    ],
    "en": [
      "Trained at the national fishing centre, Jean Christophe introduces you to a world that is accessible to all through different activities."
    ],
    "it": [
      "Formatosi presso il Centro nazionale di formazione per la pesca, Jean Christophe vi farà scoprire un mondo accessibile a tutti attraverso varie attività adattate."
    ],
    "fr": [
      "Formé au centre national de formation aux métiers de la pêche, Jean Christophe vous fait découvrir un univers accessible à tous à travers différentes activités adaptées."
    ],
    "nl": [
      "Jean Christophe die een scholing volgde in het \"Centre national de formation aux métiers de la pêche\" (Nationale vorminscentrum voor visserijberoepen) laat u een universum ontdekken dat toegankelijk is voor iedereen via verschillende aangepaste activiteiten."
    ],
    "es": [
      "Formado en el centro nacional de formación de la industria pesquera, Jean Christophe le hará descubrir un mundo accesible para todos a través de diversas actividades adaptadas."
    ]
  },
