  "rdfs:comment": {
    "de": [
      "Haut-Bugey Tourisme heißt Sie herzlich willkommen und zeigt Ihnen ein Reiseziel mit einem sanften Jurarelief, das von Seen und Wasserfällen durchzogen ist und Sie an den wilden Geist Kanadas erinnern wird. Entfliehen Sie dem Alltag, schöpfen Sie neue Kraft, nehmen Sie sich Zeit - willkommen bei uns!"
    ],
    "en": [
      "Haut-Bugey Tourisme welcomes you to discover a destination with a gentle Jura landscape, dotted with lakes and waterfalls that will remind you of the wild spirit of Canada. Escape, recharge your batteries, take your time, welcome to our home!"
    ],
    "it": [
      "Haut-Bugey Tourisme vi dà il benvenuto e vi aiuta a scoprire una destinazione dal paesaggio dolce del Giura, costellata di laghi e cascate che vi ricorderanno lo spirito selvaggio del Canada. Fuggite, fate il pieno di energia, prendetevi il vostro tempo, benvenuti da noi!"
    ],
    "fr": [
      "Haut-Bugey Tourisme vous accueille et vous fait découvrir une destination au doux relief jurassien, parsemé de lacs et de cascades qui vous rappellera l'esprit sauvage du Canada. Évadez-vous, ressourcez-vous, prenez le temps, bienvenue chez nous !"
    ],
    "es": [
      "Haut-Bugey Tourisme le da la bienvenida y le ayuda a descubrir un destino con un paisaje suave del Jura, salpicado de lagos y cascadas que le recordarán el espíritu salvaje de Canadá. Escápese, recargue las pilas, tómese su tiempo, ¡bienvenido a nuestro lugar!"
    ],
    "nl": [
      "Haut-Bugey Tourisme heet u welkom en helpt u een bestemming te ontdekken met een zacht Jura landschap, bezaaid met meren en watervallen die u doen denken aan de wilde geest van Canada. Ontsnappen, nieuwe energie opdoen, de tijd nemen, welkom bij ons!"
    ]
  },
