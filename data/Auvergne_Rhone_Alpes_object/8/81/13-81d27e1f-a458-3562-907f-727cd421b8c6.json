  "rdfs:comment": {
    "de": [
      "Sie werden dieses außergewöhnliche Hochplateau, eine Hochburg des Widerstands, entdecken.\r\nDie Berge des Jura erstrecken sich im Süden zu einer weiten Hochebene aus Gräben, Wäldern, Wegen und Bauernhöfen."
    ],
    "en": [
      "You're about to discover this exceptional high plateau, a stronghold of the French Resistance.\r\nThe Jura mountains stretch southwards to form a vast plateau of valleys, forests, roads and farms."
    ],
    "it": [
      "State per scoprire questo eccezionale altopiano, roccaforte della Resistenza.\r\nLe montagne del Giura si estendono verso sud su un vasto altopiano di valli, foreste, sentieri e fattorie."
    ],
    "fr": [
      "Vous allez découvrir ce haut plateau exceptionnel, haut lieu de la Résistance.\r\nLes montagnes du Jura s'étendent au Sud en un vaste plateau fait de combes, de forêts, de chemins et de fermes."
    ],
    "nl": [
      "Je staat op het punt om dit uitzonderlijke plateau, een bolwerk van het verzet, te ontdekken.\r\nHet Juragebergte strekt zich zuidwaarts uit over een uitgestrekt plateau van valleien, bossen, paden en boerderijen."
    ],
    "es": [
      "Descubrirá este excepcional altiplano, meca de la resistencia.\r\nLas montañas del Jura se extienden hacia el sur en una vasta meseta formada por valles, bosques, caminos y granjas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Reittour auf dem Plateau de Retord"
    ],
    "en": [
      "Plateau de Retord equestrian trail"
    ],
    "it": [
      "Il percorso equestre del Plateau de Retord"
    ],
    "fr": [
      "Circuit équestre du Plateau de Retord"
    ],
    "nl": [
      "Het ruiterpad Plateau de Retord"
    ]
  },
