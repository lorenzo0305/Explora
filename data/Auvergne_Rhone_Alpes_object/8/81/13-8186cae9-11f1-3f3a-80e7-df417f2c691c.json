  "rdfs:comment": {
    "de": [
      "Der Mittagstisch wird von Montag bis Freitag angeboten.\r\nDas Lokal bietet zwei Inselabende pro Woche, freitags und samstags von 18 Uhr bis Mitternacht, mit kulinarischen Angeboten für jeden Geschmack und Appetit."
    ],
    "en": [
      "Lunchtime service from Monday to Friday.\r\nThe restaurant offers two island evenings a week, on Friday and Saturday evenings, for a warm rendezvous from 6pm to midnight, with culinary offerings to suit all tastes and appetites."
    ],
    "it": [
      "Servizio a pranzo dal lunedì al venerdì.\r\nIl ristorante offre due serate a isola alla settimana, il venerdì e il sabato sera, per un incontro amichevole dalle 18.00 alle 24.00, con proposte culinarie per tutti i gusti e gli appetiti."
    ],
    "fr": [
      "Service assuré le midi, du lundi au vendredi.\r\nL’établissement propose deux soirées des îles par semaine, les vendredis et samedis soir pour un rendez- vous chaleureux de 18 h à minuit avec des propositions culinaires selon les goûts et les appétits."
    ],
    "es": [
      "Servicio de comidas de lunes a viernes.\r\nEl restaurante ofrece dos veladas isleñas a la semana, los viernes y sábados por la noche, para disfrutar de una agradable tertulia de 18:00 a 24:00, con sugerencias culinarias para todos los gustos y apetitos."
    ],
    "nl": [
      "Lunchtijd van maandag tot vrijdag.\r\nHet restaurant biedt twee eilandavonden per week, op vrijdag- en zaterdagavond, voor een gezellig samenzijn van 18.00 tot middernacht, met culinaire suggesties voor ieders smaak en trek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le cofy"
    ]
  },
