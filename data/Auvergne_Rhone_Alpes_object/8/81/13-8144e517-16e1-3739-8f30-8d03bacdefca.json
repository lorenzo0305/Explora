  "rdfs:comment": {
    "de": [
      "Vinothentik©, das ist ein Geist der Entdeckungen, der Offenheit und des Austauschs rund um den Wein und andere Produkte, die durch Gärung (Cidre ... wir lieben ihn!) oder Destillation (Calvados, nicht nur mit Apfel, sondern auch Domfront mit Birne!) entstehen."
    ],
    "en": [
      "Vinothentik© is a spirit of discovery, openness and exchange around wine and other products derived from fermentation (cider ... we love it!) or distillation (Calvados, not just apple but also Domfront pear!)."
    ],
    "it": [
      "Vinothentik© è uno spirito di scoperta, apertura e scambio intorno al vino e ad altri prodotti derivanti dalla fermentazione (sidro? lo adoriamo!) o dalla distillazione (Calvados, non solo con le mele ma anche Domfront con le pere!)."
    ],
    "fr": [
      "Vinothentik©, c’est un esprit de découvertes, d’ouverture et d’échanges autour du vin et des autres produits issus de fermentation (le cidre … on l’adore !) ou de distillation (le Calvados, pas juste à la pomme mais aussi le Domfront à la poire !)."
    ],
    "nl": [
      "Vinothentik© is een geest van ontdekking, openheid en uitwisseling rond wijn en andere producten die worden geproduceerd door fermentatie (cider ... we houden ervan!) of distillatie (Calvados, niet alleen appel maar ook Domfront peer!)."
    ],
    "es": [
      "Vinothentik© es un espíritu de descubrimiento, apertura e intercambio en torno al vino y otros productos resultantes de la fermentación (la sidra... ¡nos encanta!) o de la destilación (el Calvados, no sólo con manzanas, sino también el Domfront con peras)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vinothentik - Caviste"
    ]
  },
