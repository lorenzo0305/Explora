  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Marsanne, unter den jahrhundertealten Maronniers, in der Nähe des Rhône-Tals, genau an der geografischen und historischen Grenze zwischen Provence und Dauphiné heissen Sie die Aubergistes herzlich willkommen."
    ],
    "en": [
      "In the heart of the village of Marsanne, under the centuries-old maronniers, near the Rhone Valley, exactly at the geographical and historical limits between Provence and Dauphiné, the Aubergistes welcome you."
    ],
    "it": [
      "Nel cuore del villaggio di Marsanne, sotto i castagni centenari, vicino alla valle del Rodano, esattamente al limite geografico e storico tra Provenza e Delfinato, il ristorante Les Aubergistes vi dà il benvenuto."
    ],
    "fr": [
      "Au cœur du village de Marsanne, sous les maronniers centenaires, à proximité de la vallée du Rhône, exactement aux limites géographiques et historiques entre Provence et Dauphiné, le restaurant les Aubergistes vous souhaite la bienvenue."
    ],
    "nl": [
      "In het hart van het dorp Marsanne, onder de eeuwenoude maronniers, in de buurt van de Rhône-vallei, precies op de geografische en historische grenzen tussen de Provence en Dauphine, de Aubergistes heten u welkom."
    ],
    "es": [
      "En el corazón del pueblo de Marsanne, bajo los castaños centenarios, cerca del valle del Ródano, exactamente en los límites geográficos e históricos entre Provenza y Dauphiné, el restaurante Les Aubergistes le da la bienvenida."
    ]
  },
