  "rdfs:comment": {
    "de": [
      "Nadège und Nicolas freuen sich, Sie in einer bewaldeten Umgebung zu begrüßen, wo Sie eine raffinierte Küche genießen können, die mit frischen, lokalen und saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "Nadège and Nicolas will be delighted to welcome you in a wooded setting to enjoy a refined cuisine, worked with fresh, local and seasonal products."
    ],
    "it": [
      "Nadège e Nicolas saranno lieti di accogliervi in un ambiente boschivo per gustare una cucina raffinata, lavorata con prodotti freschi, locali e di stagione."
    ],
    "fr": [
      "Nadège et Nicolas seront ravis de vous accueillir dans un cadre boisé pour y déguster une cuisine raffinée, travaillée avec des produits frais, locaux et de saison."
    ],
    "es": [
      "Nadège y Nicolas estarán encantados de recibirle en un entorno arbolado para disfrutar de una cocina refinada, trabajada con productos frescos, locales y de temporada."
    ],
    "nl": [
      "Nadège en Nicolas ontvangen u graag in een bosrijke omgeving om te genieten van een verfijnde keuken, gewerkt met verse, lokale en seizoensgebonden producten."
    ]
  },
  "rdfs:label": {
