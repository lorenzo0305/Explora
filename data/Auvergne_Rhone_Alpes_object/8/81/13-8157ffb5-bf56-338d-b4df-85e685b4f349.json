          "additionalInformation": {
            "de": [
              "In den Schulferien täglich geöffnet.\r\n\r\nAußerhalb der Schulferien dienstags und mittwochs geschlossen.\r\n\r\nIm Frühling und Herbst sind wir manchmal auch montags geschlossen. Bitte kontaktieren Sie uns telefonisch, um weitere Informationen zu erhalten."
            ],
            "en": [
              "Open daily during school vacations.\r\n\r\nClosed Tuesdays and Wednesdays outside school vacations.\r\n\r\nIn spring and autumn, we are sometimes closed on Mondays. Please call us for further information."
            ],
            "it": [
              "Aperto tutti i giorni durante le vacanze scolastiche.\r\n\r\nChiuso il martedì e il mercoledì al di fuori delle vacanze scolastiche.\r\n\r\nIn primavera e in autunno siamo talvolta chiusi il lunedì. Per maggiori informazioni, contattateci telefonicamente."
            ],
            "fr": [
              "Ouvert tous les jours en période de vacances scolaires.\r\n\r\nFermé les mardis et mercredis hors vacances scolaires.\r\n\r\nAu printemps et à l'automne, nous sommes parfois fermés les lundis. Merci de nous contacter par téléphone pour plus d'informations."
            ],
            "nl": [
              "Tijdens schoolvakanties elke dag geopend.\r\n\r\nBuiten de schoolvakanties gesloten op dinsdag en woensdag.\r\n\r\nIn het voor- en najaar zijn we soms op maandag gesloten. Neem telefonisch contact met ons op voor meer informatie."
            ],
            "es": [
              "Abierto todos los días durante las vacaciones escolares.\r\n\r\nCerrado los martes y miércoles no festivos.\r\n\r\nEn primavera y otoño, a veces cerramos los lunes. Para más información, póngase en contacto con nosotros por teléfono."
            ]
          },
