  "rdfs:comment": {
    "de": [
      "Die Tour de la Grande Casse ist eine symbolträchtige Wanderung in der Vanoise. Sie bietet wunderschöne Aussichtspunkte und Landschaften!\r\n\r\nAchtung, der Start erfolgt vom Parkplatz Laisonnay-d'en-Bas, der sich in Champagny-en-Vanoise befindet!"
    ],
    "en": [
      "The Tour de la Grande Casse is an emblematic hike in the Vanoise, offering magnificent views and scenery !\r\n\r\nPlease note, departure is from the Laisonnay-d'en-Bas car park located in Champagny-en-Vanoise!"
    ],
    "it": [
      "Il Tour de la Grande Casse è un'escursione emblematica della Vanoise, che offre panorami e scenari magnifici!\r\n\r\nSi ricorda che il tour parte dal parcheggio di Laisonnay-d'en-Bas a Champagny-en-Vanoise!"
    ],
    "fr": [
      "Le Tour de la Grande Casse est une randonnée emblématique de la Vanoise, elle offre des points de vue et des paysages magnifiques !\r\n\r\nAttention, le départ se fait du parking de Laisonnay-d'en-Bas situé à Champagny-en-Vanoise !"
    ],
    "es": [
      "La Tour de la Grande Casse es una excursión emblemática de la Vanoise que ofrece magníficas vistas y paisajes.\r\n\r\n¡Tenga en cuenta que la salida se realiza desde el aparcamiento de Laisonnay-d'en-Bas situado en Champagny-en-Vanoise!"
    ],
    "nl": [
      "De Tour de la Grande Casse is een emblematische wandeling in de Vanoise, met prachtige uitzichten en landschappen!\r\n\r\nLet op: de tocht vertrekt vanaf de parkeerplaats Laisonnay-d'en-Bas in Champagny-en-Vanoise!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Tour de la Grande Casse - 5-day walking tour"
    ],
    "fr": [
      "Le Tour de la Grande Casse - Randonnée pédestre en itinérance de 5 jours"
    ],
    "es": [
      "Tour de la Grande Casse - a pie de 5 días"
    ]
  },
