  "rdfs:comment": {
    "de": [
      "Folgen Sie einfach von Barcelona oder Combovin   den Feldwegen, die zum Turm führen. Dies ist ein Familienausflug, mit einem kindgerechten Höhenunterschied!"
    ],
    "en": [
      "To get to this tower from the villages of Barcelonne or Combovin, all you have to do is to follow one of the dirt tracks. This is a family-friendly walk with very few ups and downs."
    ],
    "it": [
      "Da Barcelonne o Combovin, basta seguire i sentieri sterrati che portano alla torre. Si tratta di una passeggiata per famiglie, con un dislivello adatto ai bambini!"
    ],
    "fr": [
      "Au départ de Barcelonne ou de Combovin, il suffit de suivre les sentiers de terre qui mènent à la tour. Il s’agit d’une balade familiale, avec un dénivelé adapté aux enfants !"
    ],
    "nl": [
      "Vanuit Barcelonne of Combovin volgt u een van de onverharde wegen die allemaal op naar de toren leiden. Een gezinswandeling met een hoogteverschil dat ook geschikt is voor kinderen!"
    ],
    "es": [
      "Desde Barcelonne o Combovin, basta con seguir los caminos de tierra que llevan a la torre. Se trata de un paseo familiar, con un desnivel adecuado para los niños"
    ]
  },
  "rdfs:label": {
