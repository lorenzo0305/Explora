  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Salers empfängt Sie \"La Diligence\" und zeigt Ihnen das traditionelle kulinarische Erbe einer geschmacksintensiven Region!"
    ],
    "en": [
      "In the heart of Salers, la Diligence offers you hearty regional cooking. Eliane and Marc warmly welcome you with traditional local specialities."
    ],
    "it": [
      "Nel cuore del villaggio di Salers, La Diligence vi accoglie per farvi scoprire il patrimonio culinario tradizionale di una regione ricca di sapori!"
    ],
    "fr": [
      "En plein coeur du village de Salers, la Diligence vous accueille et vous fait découvrir le patrimoine culinaire traditionnel d'une région riche en saveurs !"
    ],
    "nl": [
      "In het hart van het dorp Salers heet La Diligence je welkom om het traditionele culinaire erfgoed van een streek rijk aan smaken te ontdekken!"
    ],
    "es": [
      "En el corazón del pueblo de Salers, La Diligence le da la bienvenida para que descubra el patrimonio culinario tradicional de una región rica en sabores"
    ]
  },
