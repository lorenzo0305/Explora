  "rdfs:comment": {
    "de": [
      "In der Einkaufsgalerie von Lanslevillard gelegen, in der Nähe der Startpunkte der markierten Wanderwege und der Skilifte, freut sich unser professionelles Team darauf, Sie zu empfangen und zu beraten."
    ],
    "en": [
      "Located in Lanslevillard's shopping mall, close to marked trailheads and ski lifts, our team of professionals will be delighted to welcome and advise you."
    ],
    "it": [
      "Situato nel centro commerciale di Lanslevillard, vicino alle piste e agli impianti di risalita segnalati, il nostro team di professionisti sarà lieto di accogliervi e consigliarvi."
    ],
    "fr": [
      "Situé dans la galerie commerciale de Lanslevillard, à proximité des départs de sentiers balisés et des remontées mécaniques, notre équipe de professionnels est ravie de vous accueillir et vous conseiller."
    ],
    "es": [
      "Situado en el centro comercial de Lanslevillard, cerca de las pistas señalizadas y de los remontes, nuestro equipo de profesionales estará encantado de recibirle y asesorarle."
    ],
    "nl": [
      "Ons team van professionals bevindt zich in het winkelcentrum van Lanslevillard, dicht bij de bewegwijzerde pistes en skiliften, en zal je met plezier verwelkomen en adviseren."
    ]
  },
