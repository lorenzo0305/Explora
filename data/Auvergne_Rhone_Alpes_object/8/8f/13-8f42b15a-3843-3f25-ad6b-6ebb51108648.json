  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen Moment der Entspannung mit unseren 3 Whirlpools, 2 Saunen, einem Hammam und einer Teestube. Unser Wellnessbereich genießt einen außergewöhnlichen Blick auf das verschneite Skigebiet Les Saisies."
    ],
    "en": [
      "Treat yourself to a moment of relaxation with our three jacuzzis, two saunas, a steam room, and an herbal tea lounge. Our wellness area offers an exceptional view of the snow-covered Saisies resort."
    ],
    "it": [
      "Concedetevi un momento di relax nei nostri tre jacuzzi, due saune, un bagno turco e una sala tisane. La nostra area benessere gode di una vista eccezionale sul comprensorio innevato de Les Saisies."
    ],
    "fr": [
      "Laissez vous tenter par un moment de détente avec nos 3 jacuzzis, 2 saunas, un hammam et une tisanerie. Notre espace bien être jouit d'une vue exceptionnelle sur le domaine enneigé des Saisies."
    ],
    "nl": [
      "Laat u verleiden tot een moment van ontspanning in onze drie jacuzzi’s, twee sauna’s, een hammam en een theelounge. Onze wellnessruimte biedt een uitzonderlijk uitzicht over het besneeuwde skigebied Les Saisies."
    ],
    "es": [
      "Déjese tentar por un momento de relajación con nuestros 3 jacuzzis, 2 saunas, un hammam y una tisanería. Nuestra zona de bienestar goza de una vista excepcional del dominio esquiable nevado de Les Saisies."
    ]
  },
