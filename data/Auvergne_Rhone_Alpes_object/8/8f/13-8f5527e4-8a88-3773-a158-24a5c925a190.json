  "rdfs:comment": {
    "de": [
      "La?Bois?Cyclerie ist eine Materialbibliothek: Sie sammelt und verwertet gebrauchtes Holz (Bretter, Platten, Leisten usw.), bereitet es auf und stellt es zum Kauf oder als Spende zur Verfügung, wobei sie auch kreative Workshops anbietet."
    ],
    "en": [
      "La Bois Cyclerie is a material library: it collects and recycles salvaged wood (boards, panels, cleats, etc.), restores it and makes it available for purchase or donation, while running creative workshops."
    ],
    "it": [
      "La Bois Cyclerie è una biblioteca dei materiali, che raccoglie e ricicla il legno di recupero (tavole, pannelli, listelli, ecc.), lo riporta alle sue condizioni originali e lo rende disponibile per l'acquisto o la donazione, mentre organizza laboratori creativi."
    ],
    "fr": [
      "La Bois’Cyclerie est une matériauthèque : elle collecte et valorise du bois de récupération (planches, panneaux, tasseaux…), le remet en état et le met à disposition pour achat ou don, tout en animant des ateliers créatifs."
    ],
    "nl": [
      "La Bois Cyclerie is een materiaalbibliotheek die teruggewonnen hout (planken, panelen, latten, enz.) verzamelt en recycleert, het in de oorspronkelijke staat herstelt en het beschikbaar stelt voor aankoop of donatie, terwijl ze creatieve workshops organiseert."
    ],
    "es": [
      "La Bois Cyclerie es una biblioteca de materiales que recoge y recicla madera recuperada (tablas, tableros, listones, etc.), la restaura a su estado original y la pone a disposición para su compra o donación, al tiempo que organiza talleres creativos."
    ]
  },
  "rdfs:label": {
