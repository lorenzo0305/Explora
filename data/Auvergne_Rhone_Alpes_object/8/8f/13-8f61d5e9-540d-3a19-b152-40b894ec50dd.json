  "rdfs:comment": {
    "de": [
      "Traditionelles \"hausgemachtes\" Essen à la carte am Mittag und ein einziges Essen am Abend, begleitet von einer atypischen Weinkarte, die in Maßen genossen werden sollte.\r\n\r\nGenießen Sie die Panoramaterrasse mit Blick auf das Maurienne-Tal."
    ],
    "en": [
      "Traditional cuisine homemade with à la carte dining at lunchtimes and set meal in the evenings, accompagned by an unusual wine menu, to be consumed with moderation.\r\n\r\nCome to enjoy our terrace with panoramique views."
    ],
    "it": [
      "Ristorante tradizionale \"casalingo\" à la carte a pranzo e un pasto unico la sera, accompagnato da una carta dei vini atipica, da gustare con moderazione.\r\n\r\nVenite a godervi la terrazza panoramica con vista sulla Valle della Maurienne."
    ],
    "fr": [
      "Restauration traditionnelle \"fait maison\" à la carte le midi et repas unique le soir, accompagné par une carte des vins atypique, à déguster avec modération.\r\n\r\nVenez profiter de la terrasse panoramique avec vue sur la Vallée de la Maurienne."
    ],
    "nl": [
      "Traditionele gerechten op de kaart ‘s middags en een vast menu ‘s avonds, alles vergezeld door een ongewone wijnkaart – met mate te degusteren.\r\nKom genieten van het panoramische terras met uitzicht op de Vallée de la Maurienne."
    ],
    "es": [
      "Restaurante tradicional \"casero\" a la carta a la hora de comer y una comida única por la noche, acompañada de una carta de vinos atípica, para disfrutar con moderación.\r\n\r\nVenga a disfrutar de la terraza panorámica con vistas al valle de la Maurienne."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Grande Léchère lake refuge"
    ],
    "fr": [
      "Refuge du Lac de la Grande Léchère"
    ],
    "nl": [
      "Meer van La GrandeLéchère  toevlucht"
    ]
  },
