  "rdfs:comment": {
    "de": [
      "Yoga Mandir lädt Sie in das La Maison du Yoga in Vassieux-en-Vercors ein, um in die Praxis des Yoga einzutauchen. Sitzungen vor Ort oder unterwegs (Ferienhäuser, Ferienzentren). Entdecken Sie Yoga in einer friedlichen und inspirierenden Umgebung oder entdecken Sie es wieder."
    ],
    "en": [
      "Yoga Mandir invites you to La Maison du Yoga, in Vassieux-en-Vercors, for an immersion in the practice of yoga. Sessions on site or on location (gîtes, vacation centers). Come and discover or rediscover yoga in a peaceful, inspiring setting."
    ],
    "it": [
      "Yoga Mandir vi invita a La Maison du Yoga, a Vassieux-en-Vercors, per un'immersione nella pratica dello yoga. Le sessioni possono essere tenute in loco o presso i centri di vacanza. Venite a scoprire o riscoprire lo yoga in un ambiente tranquillo e stimolante."
    ],
    "fr": [
      "Yoga Mandir vous invite à La Maison du Yoga, à Vassieux-en-Vercors, pour une immersion dans la pratique du Yoga. Séances sur place ou en déplacement (gîtes, centres de vacances). Venez découvrir ou redécouvrir le yoga dans un cadre paisible et inspirant."
    ],
    "nl": [
      "Yoga Mandir nodigt je uit in La Maison du Yoga, in Vassieux-en-Vercors, voor een onderdompeling in de beoefening van yoga. Sessies kunnen worden gehouden op locatie of in vakantiecentra. Kom yoga ontdekken of herontdekken in een rustige en inspirerende omgeving."
    ],
    "es": [
      "Yoga Mandir le invita a La Maison du Yoga, en Vassieux-en-Vercors, para una inmersión en la práctica del yoga. Las sesiones pueden realizarse in situ o en centros de vacaciones. Venga a descubrir o redescubrir el yoga en un entorno tranquilo e inspirador."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Yoga Mandir Vercors | La Maison du Yoga"
    ]
  },
