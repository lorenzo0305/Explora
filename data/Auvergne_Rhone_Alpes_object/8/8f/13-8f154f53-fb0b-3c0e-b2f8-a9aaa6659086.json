  "rdfs:comment": {
    "de": [
      "Naturerlebnisse: Ausflüge und praktische Workshops rund um essbare Wildpflanzen und lokale Heilpflanzen. Veranstaltungen zu allen vier Jahreszeiten im Regionalen Naturpark Massif des Bauges, im Becken von Chambery und in der Nähe."
    ],
    "en": [
      "Nature events: Outings and practical workshops on local wild edible and medicinal plants. 4-season events in and around the Parc Naturel Régional du Massif des Bauges and the Chambéry basin."
    ],
    "it": [
      "Eventi naturalistici: uscite e laboratori pratici sulle piante selvatiche locali commestibili e medicinali. Attività in tutte e 4 le stagioni nel Parc Naturel Régional du massif des Bauges, nella zona di Chambéry e nelle vicinanze."
    ],
    "fr": [
      "Animations nature : Sorties et ateliers pratiques autour des Plantes sauvages comestibles et médicinales locales. Animations aux 4 saisons sur le Parc Naturel Régional du massif des Bauges, le bassin chambérien, et à proximité."
    ],
    "nl": [
      "Natuurevenementen: Uitstapjes en praktische workshops over lokale eetbare en geneeskrachtige wilde planten. Activiteiten in alle 4 seizoenen in het Parc Naturel Régional du Massif des Bauges, de omgeving van Chambéry en in de buurt."
    ],
    "es": [
      "Actividades en la naturaleza: salidas y talleres prácticos sobre plantas silvestres comestibles y medicinales. Actividades en las 4 estaciones en el Parc Naturel Régional du Massif des Bauges, la zona de Chambéry y alrededores."
    ]
  },
