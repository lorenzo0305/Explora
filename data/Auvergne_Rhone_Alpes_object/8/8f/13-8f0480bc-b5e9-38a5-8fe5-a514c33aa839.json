  "rdfs:comment": {
    "de": [
      "In einer grünen, friedlichen und entspannenden Umgebung lädt Cheval des Cimes Sie dazu ein, fabelhafte Momente des Austauschs und des Vergnügens mit ausgeglichenen und liebenswerten Ponys und Pferden zu erleben."
    ],
    "en": [
      "In a green, peaceful setting that's perfect for relaxation, Cheval des Cimes invites you to enjoy fabulous moments of sharing and pleasure with well-balanced, endearing ponies and horses."
    ],
    "it": [
      "In un ambiente verde e tranquillo, perfetto per il relax, Cheval des Cimes vi invita a vivere favolosi momenti di condivisione e piacere con pony e cavalli equilibrati e affettuosi."
    ],
    "fr": [
      "Dans un cadre verdoyant, paisible et propice à la détente, Cheval des Cimes vous invite à vivre de fabuleux moments d'échange et de plaisir avec des poneys et chevaux équilibrés et attachants."
    ],
    "nl": [
      "In een groene, rustige omgeving die perfect is voor ontspanning, nodigt Cheval des Cimes je uit om te genieten van fantastische momenten van delen en plezier met evenwichtige, vertederende pony's en paarden."
    ],
    "es": [
      "En un entorno verde y tranquilo, perfecto para relajarse, Cheval des Cimes le invita a disfrutar de fabulosos momentos de convivencia y placer con ponis y caballos equilibrados y entrañables."
    ]
  },
