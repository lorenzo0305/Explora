  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/27e7d084-1d60-38b4-b071-6d5195ddeccb",
      "dc:description": {
        "de": [
          "Schokoladenfabrik Biskuitfabrik.\n\nAußerhalb der Saison von 10:30 bis 13:00 Uhr und von 14:30 bis 19:00 Uhr geöffnet, außer Samstag und Sonntag durchgehend,\nIn der Saison täglich von 10:00 bis 19:30 Uhr geöffnet."
        ],
        "en": [
          "Chocolaterie Biscuiterie.\n\nOpen out of season from 10:30am to 1pm and from 2:30pm to 7pm except Saturday and Sunday,\nIn season, open daily from 10am to 7:30pm."
        ],
        "it": [
          "Chocolaterie Biscuiterie.\n\nAperto fuori stagione dalle 10.30 alle 13.00 e dalle 14.30 alle 19.00, tranne il sabato e la domenica,\nIn stagione, aperto tutti i giorni dalle 10.00 alle 19.30."
        ],
        "fr": [
          "Chocolaterie Biscuiterie.\n\nOuvert hors saison de 10h30 à 13h et de 14h30 à 19h sauf samedi et dimanche en continu,\nEn saison ouvert tous les jours de 10h à 19h30."
        ],
        "nl": [
          "Chocolaterie Biscuiterie.\n\nBuiten het seizoen geopend van 10.30 tot 13.00 en van 14.30 tot 19.00 behalve op zaterdag en zondag,\nIn het seizoen elke dag geopend van 10.00 tot 19.30 uur."
        ],
        "es": [
          "Chocolatería Biscuiterie.\n\nAbierto fuera de temporada de 10.30 h a 13.00 h y de 14.30 h a 19.00 h, excepto sábados y domingos,\nEn temporada, abierto todos los días de 10.00 a 19.30 h."
        ]
      },
