  "rdfs:comment": {
    "de": [
      "Le Parpaillou verwandelt sich in ein italienisches Restaurant, in dem Sie frische Produkte wie Saltimbocca alla romana, Pasta alla norma, Krakensalat nach sizilianischer Art, Polpette nach sizilianischer Art genießen können. Reservierung erwünscht."
    ],
    "en": [
      "Le Parpaillou is transformed into an Italian restaurant where you can enjoy fresh produce such as saltimbocca alla romana, pasta alla norma, Sicilian-style octopus salad and Sicilian-style polpette. Reservations appreciated."
    ],
    "it": [
      "Le Parpaillou si trasforma in un ristorante italiano dove si possono gustare prodotti freschi come saltimbocca alla romana, pasta alla norma, insalata di polpo alla siciliana e polpette alla siciliana. Pizze da asporto"
    ],
    "fr": [
      "Le Parpaillou se transforme en restaurant italien où vous dégusterez des produits frais tels que la saltimbocca alla romana, le pasta alla norma, salade de poulpes à la sicilienne, polpette à la sicilienne. Pizzas à emporter"
    ],
    "es": [
      "Le Parpaillou se transforma en un restaurante italiano donde podrá degustar productos frescos como saltimbocca alla romana, pasta alla norma, ensalada de pulpo a la siciliana y polpette a la siciliana. Pizzas para llevar"
    ],
    "nl": [
      "Le Parpaillou is omgetoverd tot een Italiaans restaurant waar je kunt genieten van verse producten zoals saltimbocca alla romana, pasta alla norma, octopussalade in Siciliaanse stijl en polpette in Siciliaanse stijl. Afhaalpizza's"
    ]
  },
