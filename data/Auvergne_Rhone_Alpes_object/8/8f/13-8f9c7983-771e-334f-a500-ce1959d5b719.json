  "rdfs:comment": {
    "de": [
      "Der Verein Croq'laine organisiert seinen 2. Flohmarkt der Näherinnen: alle gebrauchten Gegenstände, die mit kreativen Hobbys, Nähen, Stricken, Häkeln zu tun haben. Fertige Kreationen werden nicht angenommen."
    ],
    "en": [
      "The Croq'laine association is organizing its 2nd \"puces de couturières\" (dressmakers' flea market): all second-hand items relating to creative hobbies, sewing, knitting and crochet. Finished creations are not accepted."
    ],
    "it": [
      "L'associazione Croq'laine organizza il suo 2° mercatino delle pulci per sarti: tutti gli articoli di seconda mano relativi alle attività creative del tempo libero, al cucito, alla maglia e all'uncinetto. Non si accettano creazioni finite."
    ],
    "fr": [
      "L'association Croq'laine organise ses 2èmes puces de couturières : tous objets d'occasion concernant les loisirs créatifs, couture, tricot, crochet. Les créations finies ne sont pas acceptées."
    ],
    "es": [
      "La asociación Croq'laine organiza su 2º mercadillo de modistas: todos los artículos de segunda mano relacionados con el ocio creativo, la costura, el punto y el ganchillo. No se aceptan creaciones acabadas."
    ],
    "nl": [
      "De vereniging Croq'laine organiseert haar 2de kleermakersrommelmarkt: alle tweedehands artikelen met betrekking tot creatieve vrijetijdsbesteding, naaien, breien en haken. Afgewerkte creaties worden niet aanvaard."
    ]
  },
  "rdfs:label": {
