  "rdfs:comment": {
    "de": [
      "Eine Arbeit ausgehend von einem Foto ... eine Arbeit mit Farben ... eine Arbeit mit Materialien ... Geschichten, die erzählt werden ...\r\nVerschiedene Themen, darunter eines rund um Nyons. Workshops für Kinder von 6 bis 10 Jahren."
    ],
    "en": [
      "Artist - Visual artist"
    ],
    "it": [
      "Creazioni uniche basate sulle mie foto? Giocare con i colori, i materiali, raccontare storie?\r\nSu richiesta, offro laboratori di fotografia e arte per adulti e bambini dai 6 ai 10 anni."
    ],
    "fr": [
      "Des créations uniques à partir de mes photos… des jeux de couleurs… de matières … des histoires qui se racontent… \r\nJe propose, à la demande, de ateliers photos - arts-plastiques aux adultes et aux enfants de 6 à 10 ans."
    ],
    "es": [
      "Creaciones únicas a partir de mis fotos... jugar con los colores... los materiales... contar historias..\r\nA petición, ofrezco talleres de fotografía y arte para adultos y niños de 6 a 10 años."
    ],
    "nl": [
      "Beeldend kunstenaar."
    ]
  },
