  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Pralognan?la?Vanoise empfängt Sie in der 348 avenue de Chasseforêt und bietet Ihnen eine Auswahl an Büchern für Kinder und Erwachsene zur (kostenlosen) Ausleihe an."
    ],
    "en": [
      "The Pralognan-la-Vanoise library is located at 348 avenue de Chasseforêt and has a selection of books for children and adults on loan (free)."
    ],
    "it": [
      "La biblioteca di Pralognan?la?Vanoise si trova al 348 di avenue de Chasseforêt e offre una selezione di libri per bambini e adulti in prestito (gratuito)."
