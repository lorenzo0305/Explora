  "rdfs:comment": {
    "de": [
      "Eugénie und Cédric empfangen Sie in ihrem traditionellen Restaurant in einer herzlichen und familiären Atmosphäre.\r\nCocooning-Dekoration, eine saisonale Küche mit frischen Produkten, auf einem kleinen schattigen Dorfplatz mit einem kleinen Brunnen."
    ],
    "en": [
      "Eugénie and Cédric welcome you to their traditional restaurant in a warm, family atmosphere.\r\nCosy decor, seasonal cuisine and fresh produce, on a shady village square with a small fountain."
    ],
    "it": [
      "Eugénie e Cédric vi danno il benvenuto nel loro ristorante tradizionale in un'atmosfera calda e familiare.\r\nArredamento accogliente, cucina di stagione e prodotti freschi, in una piazza ombreggiata del paese con una piccola fontana."
    ],
    "fr": [
      "Eugénie et Cédric vous accueillent dans leur restaurant traditionnel dans une ambiance chaleureuse et familiale.\r\nDécoration cocooning, une cuisine de saison et produits frais, sur une petite placette de village ombragée avec sa petite fontaine."
    ],
    "es": [
      "Eugénie y Cédric le dan la bienvenida a su restaurante tradicional en un ambiente cálido y familiar.\r\nDecoración acogedora, cocina de temporada y productos frescos, en una sombreada plaza de pueblo con una pequeña fuente."
    ],
    "nl": [
      "Eugénie en Cédric heten je welkom in hun traditionele restaurant in een warme, familiale sfeer.\r\nGezellige inrichting, seizoensgebonden keuken en verse producten, op een schaduwrijk dorpsplein met een kleine fontein."
    ]
  },
