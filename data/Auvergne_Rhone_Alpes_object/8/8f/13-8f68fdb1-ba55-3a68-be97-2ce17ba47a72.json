  "rdfs:comment": {
    "de": [
      "Ideale Lage oberhalb des Seeufers. Es erhebt sich über den Park Belvédère und verfügt über eine angenehme Terrasse. Einige Zimmer bieten einen Ausblick auf den See."
    ],
    "en": [
      "Ideal location for this hotel, which overlooks Lake Geneva. It rises on the belvedere gardens of Thonon. Its terrace is pleasant and some rooms have a view of the lake."
    ],
    "it": [
      "Posizione ideale per questo hotel, che domina il Lemano: infatti si erge sui giardini con belvedere di Thonon. La terrazza è piacevole a alcune camere hanno vista sul lago."
    ],
    "fr": [
      "L'ibis Thonon Centre est idéalement situé au cœur du centre-ville historique de Thonon-les-Bains, à quelques pas du lac Léman. L'hôtel dispose de chambres climatisées. Restaurant et bar avec belle terrasse et vue sur le lac."
    ],
    "nl": [
      "Het ibis Thonon Centre is ideaal gelegen in het hart van het historische centrum van Thonon-les-Bains, op een steenworp afstand van het meer van Genève. Het hotel beschikt over kamers met airconditioning. Restaurant en bar met een mooi terras en uitzicht op het meer."
    ],
    "es": [
      "El ibis Thonon Centre goza de una ubicación ideal en pleno centro histórico de Thonon-les-Bains, a pocos pasos del lago Lemán. El hotel dispone de habitaciones con aire acondicionado. Restaurante y bar con una bonita terraza y vistas al lago."
    ]
  },
