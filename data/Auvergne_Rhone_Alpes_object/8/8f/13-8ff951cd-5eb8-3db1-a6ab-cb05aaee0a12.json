  "rdfs:comment": {
    "de": [
      "Entdecken Sie Baba School, das Atelier für kreative Näharbeiten und Schmuck aus Mikro-Makramee.\r\nSéverine leitet kreative Workshops bei sich zu Hause, in ihrem Atelier in Annecy oder kommt zu Ihnen in die Region Grand Annecy.\r\nEine einzigartige kreative Entdeckungspause."
    ],
    "en": [
      "Discover Baba School, the sewing and micro macramé jewelry workshop.\r\nSéverine runs creative workshops at her home, in her workshop in Annecy or at your home in the Greater Annecy area.\r\nA unique moment of creative discovery."
    ],
    "it": [
      "Scoprite la Baba School, il laboratorio di cucito creativo e di micro macramè.\r\nSéverine organizza laboratori creativi a casa sua, nel suo atelier di Annecy o viene a trovarvi nell'area di Annecy.\r\nUn momento unico di scoperta creativa."
    ],
    "fr": [
      "Découvrez Baba School l'atelier de création couture et de bijoux en micro macramé.\r\nSéverine anime des ateliers créatifs chez elle, dans son atelier sur Annecy ou se déplace chez vous sur le Grand Annecy.\r\nParenthèse de découverte créative unique."
    ],
    "nl": [
      "Ontdek Baba School, het creatieve atelier voor naaien en micro macramé sieraden.\r\nSéverine geeft creatieve workshops bij haar thuis, in haar atelier in Annecy of komt naar je toe in de buurt van Annecy.\r\nEen uniek moment van creatieve ontdekking."
    ],
    "es": [
      "Descubra la Escuela Baba, el taller de costura creativa y bisutería de micromacramé.\r\nSéverine organiza talleres creativos en su casa, en su taller de Annecy o se desplaza a su domicilio en la región de Annecy.\r\nUn momento único de descubrimiento creativo."
    ]
  },
