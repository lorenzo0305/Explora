  "rdfs:comment": {
    "de": [
      "Am Fuße des Schlosses befindet sich die Pfarrkirche Saint-André. Die Westfassade besteht aus einem viereckigen Turm und einem geschnitzten Portal mit einem kichernden Kopf auf der linken Seite und einem bärtigen Kopf auf der rechten Seite."
    ],
    "en": [
      "At the foot of the château stands the parish church of Saint-André. The western facade features a quadrangular tower and a sculpted portal with a sneering head on the left and a bearded head on the right."
    ],
    "it": [
      "La chiesa parrocchiale di Saint-André si trova ai piedi del castello. La facciata occidentale presenta una torre quadrangolare e un portale scolpito con una testa ghignante a sinistra e una testa barbuta a destra."
    ],
    "fr": [
      "Au pied du château, se dresse l'église paroissiale Saint-André. La façade occidentale est constituée d'une tour quadrangulaire et d'un portail sculpté pourvu, à gauche, d'une t^te ricanante, à droite, d'une tête barbue."
    ],
    "nl": [
      "Aan de voet van het kasteel staat de parochiekerk Saint-André. De westelijke gevel heeft een vierhoekige toren en een gebeeldhouwd portaal met links een grijnzend hoofd en rechts een bebaard hoofd."
    ],
    "es": [
      "A los pies del castillo se alza la iglesia parroquial de Saint-André. La fachada occidental presenta una torre cuadrangular y un portal esculpido con una cabeza burlona a la izquierda y una cabeza barbuda a la derecha."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-André"
    ]
  },
