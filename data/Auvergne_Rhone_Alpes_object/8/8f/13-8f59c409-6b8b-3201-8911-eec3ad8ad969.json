  "rdfs:comment": {
    "de": [
      "Diese Bibliothek wird von der Vereinigung Marque-Page verwaltet und hat die Besonderheit, dass sie zwei Standorte hat, einen in Berrias und einen in Casteljau. Die Öffnungszeiten sind je nach Standort unterschiedlich."
    ],
    "en": [
      "Managed by the association Marque-Page, this library has the particularity to have two sites, one in Berrias, the other in Casteljau. The opening days are different according to the sites."
    ],
    "it": [
      "Gestita dall'associazione Marque-Page, questa biblioteca ha la particolarità di avere due sedi, una a Berrias e l'altra a Casteljau. I giorni di apertura sono diversi a seconda dei siti."
    ],
    "fr": [
      "Gérée par l'association Marque-Page, cette bibliothèque a la particularité d'avoir deux sites, l'un à Berrias, l'autre à Casteljau. Les jours d'ouvertures différents en fonction des sites."
    ],
    "es": [
      "Gestionada por la asociación Marque-Page, esta biblioteca tiene la particularidad de contar con dos sedes, una en Berrias y otra en Casteljau. Los días de apertura son diferentes según los sitios."
    ],
    "nl": [
      "Deze bibliotheek wordt beheerd door de vereniging Marque-Page en heeft de bijzonderheid dat zij over twee vestigingen beschikt, één in Berrias en één in Casteljau. De openingsdagen verschillen per locatie."
    ]
  },
