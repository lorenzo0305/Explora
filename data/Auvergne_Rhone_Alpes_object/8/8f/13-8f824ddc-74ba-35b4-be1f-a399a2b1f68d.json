  "rdfs:comment": {
    "de": [
      "Hat zum Ziel, die materiellen und moralischen Interessen seiner Staatsangehörigen zu wahren: Kriegsveteranen, Kriegsinvaliden und -verletzte, Kriegswitwen, Mündel der Nation, Opfer von Kriegen und in jüngster Zeit auch von Terrorakten."
    ],
    "en": [
      "Its aim is to protect the material and moral interests of its members: veterans, disabled and wounded war veterans, war widows, wards of the Nation, victims of war and, more recently, of acts of terrorism."
    ],
    "it": [
      "Il suo scopo è quello di tutelare gli interessi materiali e morali dei suoi membri: veterani, invalidi e feriti di guerra, vedove di guerra, assistiti della Nazione, vittime di guerra e, più recentemente, di atti di terrorismo."
    ],
    "fr": [
      "A pour objectif de préserver les intérêts matériels et moraux de ses ressortissants : anciens combattants, invalides et blessés de guerre, veuves de guerre, pupilles de la Nation, victimes de guerre, et plus récemment, d'actes de terrorisme."
    ],
    "es": [
      "Su objetivo es proteger los intereses materiales y morales de sus miembros: veteranos, inválidos y heridos de guerra, viudas de guerra, pupilos de la Nación, víctimas de la guerra y, más recientemente, de actos de terrorismo."
    ],
    "nl": [
      "Haar doel is het beschermen van de materiële en morele belangen van haar leden: veteranen, invaliden en oorlogsgewonden, oorlogsweduwen, verzorgers van de Natie, slachtoffers van oorlog en, meer recent, van terroristische daden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association des combattants Algérie Tunisie Maroc - Section d'Huriel et des environs"
    ]
  },
