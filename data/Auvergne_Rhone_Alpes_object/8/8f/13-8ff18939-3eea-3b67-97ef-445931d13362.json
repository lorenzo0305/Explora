  "rdfs:comment": {
    "de": [
      "Start der Route (Croix des Suifs ? Alt. 1472m): Erreichbar \"?per Pedal?\" über zwei \"?aufsteigende?\" Routen (Liaison 1 oder Liaison 2, je nach Wahl) ab dem Parkplatz des Aigle (Lans en Vercors)."
    ],
    "en": [
      "Start of the route (Croix des Suifs, Alt. 1472m): accessible \"by pedal\" via two \"uphill\" routes (Liaison 1 or Liaison 2, your choice) from the Aigle parking lot (Lans en Vercors)."
    ],
    "it": [
      "Inizio del percorso (Croix des Suifs Alt. 1472m): raggiungibile a pedali attraverso due percorsi in salita (Liaison 1 o Liaison 2, a scelta) dal parcheggio di Aigle (Lans en Vercors)."
    ],
    "fr": [
      "Départ de l’itinéraire (Croix des Suifs – Alt. 1472m) : accessible « à la pédale » par deux itinéraires « montants » (Liaison 1 ou liaison 2, au choix) au départ du parking de l’Aigle (Lans en Vercors)."
    ],
    "nl": [
      "Start van de route (Croix des Suifs Alt. 1472m): bereikbaar met de pedalen via twee routes bergop (Liaison 1 of Liaison 2, naar keuze) vanaf de parkeerplaats van Aigle (Lans en Vercors)."
    ],
    "es": [
      "Inicio de la ruta (Croix des Suifs Alt. 1472m): accesible pedaleando por dos rutas de subida (Enlace 1 o Enlace 2, a elegir) desde el aparcamiento de Aigle (Lans en Vercors)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bois de Sigü - Spéciale VTT Enduro - Noir"
    ]
  },
