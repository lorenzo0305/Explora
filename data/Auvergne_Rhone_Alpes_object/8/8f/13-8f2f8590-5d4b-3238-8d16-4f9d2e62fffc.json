  "rdfs:comment": {
    "de": [
      "Die Archive des Departements Rhône und der Metropole Lyon bewahren das Gedächtnis der Rhodaniens und der Lyoner. Sie empfangen Sie kostenlos, um ihre Archivbestände zu konsultieren oder ihr Kultur- und Bildungsangebot zu entdecken."
    ],
    "en": [
      "The Archives du département du Rhône et de la métropole de Lyon preserve the memory of the people of Rhone and Lyon, and welcome you free of charge to consult their archives or discover their cultural and educational offerings."
    ],
    "it": [
      "Gli Archivi del dipartimento del Rodano e dell'area metropolitana di Lione conservano la memoria della popolazione del Rodano e di Lione e vi accolgono gratuitamente per consultare i loro fondi archivistici o per scoprire le loro attività culturali ed educative."
    ],
    "fr": [
      "Les Archives du département du Rhône et de la métropole de Lyon conservent la mémoire des Rhodaniens et des Lyonnais, elles vous accueillent gratuitement pour consulter ses fonds d'archives ou découvrir son offre culturelle et éducative."
    ],
    "es": [
      "Los Archivos del departamento del Ródano y del área metropolitana de Lyon conservan la memoria de los habitantes del Ródano y de Lyon. Le acogen gratuitamente para consultar sus fondos de archivos o descubrir sus actividades culturales y educativas."
    ],
    "nl": [
      "De archieven van het departement Rhône en de agglomeratie Lyon bewaren het geheugen van de inwoners van Rhône en Lyon. Ze verwelkomen u gratis om hun archiefcollecties te raadplegen of om hun culturele en educatieve activiteiten te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Archives départementales et métropolitaines"
    ]
  },
