  "rdfs:comment": {
    "de": [
      "Einzigartig in der Auvergne, Ausstellung und Verkauf von Muscheln und Perlmutt aus der ganzen Welt. Pascal Michelot, Kunsthandwerker aus Perlmutt, zeigt Ihnen seine Schmuckstücke aus Perlmutt, seine Figuren, seine Lampen und alle seine Kreationen aus Muscheln."
    ],
    "en": [
      "Unique in Auvergne. Exhibition and sale of shells and nacres from allover the world. Pascal Michelot, nacre art craftsman, will make you discover his line of nacre jewels, figurines, lamps, and many other shell creations."
    ],
    "it": [
      "Unico in Alvernia, esposizione e vendita di conchiglie e madreperle provenienti da tutto il mondo. Pascal Michelot, artigiano dell'arte della madreperla, vi farà scoprire la sua gamma di gioielli in madreperla, le sue statuette, le sue lampade e tutte le sue creazioni in conchiglia."
    ],
    "fr": [
      "Unique en Auvergne, exposition et vente de coquillages, et nacres du monde entier. Pascal Michelot, artisan d'art nacrier, vous fera découvrir sa gamme de bijoux réalisés en nacre, ses figurines, ses lampes, et toutes ses créations, en coquillage."
    ],
    "es": [
      "Único en Auvernia, exposición y venta de conchas y nácares de todo el mundo. Pascal Michelot, artesano del arte del nácar, le hará descubrir su gama de joyas de nácar, sus figuritas, sus lámparas y todas sus creaciones, en concha."
    ],
    "nl": [
      "Tentoonstelling en verkoop van schelpen en parelmoer van over de hele wereld. Kom en ontdek het werk van een ambachtsman."
    ]
  },
