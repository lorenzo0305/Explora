  "rdfs:comment": {
    "de": [
      "Museumsbereich, der den Geiern gewidmet ist: Film, Ausstellung, Dachterrasse mit Teleskopen.\r\nUm mehr zu erfahren, nehmen Sie an einer Geierentdeckungstour in freier Natur teil, die von einem Ornithologen des Vereins \"Vautours en Baronnies\" begleitet wird"
    ],
    "en": [
      "Museum space dedicated to vultures: film, exhibition, roof terrace equipped with telescopes.\r\nTo find out more about vultures, join an ornithologist from the \"Vautours en Baronnies\" association on an outing to discover them in the wild"
    ],
    "it": [
      "Spazio museale dedicato agli avvoltoi: film, mostra, terrazza sul tetto attrezzata con telescopi.\r\nPer saperne di più, partecipate a una delle uscite alla scoperta degli avvoltoi, accompagnati da un ornitologo dell'associazione \"Vautours en Baronnies\""
    ],
    "fr": [
      "Espace muséographique consacré aux vautours: film, exposition, toit terrasse équipé de télescopes.\r\nPour en savoir plus participez aux sorties découverte des vautours en pleine nature, accompagné d'un ornithologue de l'association \"Vautours en Baronnies\""
    ],
    "nl": [
      "Museumruimte gewijd aan gieren: film, tentoonstelling, dakterras met telescopen.\r\nOm meer te weten te komen, kun je deelnemen aan een van de gierenuitstapjes onder begeleiding van een ornitholoog van de vereniging \"Vautours en Baronnies\""
    ],
    "es": [
      "Espacio museográfico dedicado a los buitres: película, exposición, azotea equipada con telescopios.\r\nPara saber más, participe en una de las salidas para descubrir los buitres, acompañado por un ornitólogo de la asociación \"Vautours en Baronnies\""
    ]
  },
  "rdfs:label": {
    "en": [
      "Vultures Museum"
    ],
    "fr": [
      "Maison des Vautours"
    ]
  },
