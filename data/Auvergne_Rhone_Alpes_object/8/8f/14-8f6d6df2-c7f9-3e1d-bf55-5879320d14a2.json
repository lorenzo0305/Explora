  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2baed56d-be67-3d62-8525-9bd6be342f2f",
      "dc:description": {
        "de": [
          "Organisiert vom Comité des Fêtes (Festkomitee)\nSamstag, den 21. Februar um 20 Uhr\nSalle des Fêtes - Montcavrel\n---------------------------\nPatoisant-Theater\n\nEintritt: 6 ? - Kostenlos für Kinder unter 12 Jahren und Einwohner der Gemeinde.\nGetränke und Kuchenverkauf\nÖffnung der Türen um 19.30 Uhr\n\nReservierungen und Informationen: Olivier Gest unter 06 83 04 24 40 oder Florence Fourcroy unter 06 33 37 16 03\n\nKredit: Le Souffleur d'Embry"
        ],
        "en": [
          "Organized by the Comité des Fêtes\nSaturday, February 21st at 8pm\nSalle des Fêtes - Montcavrel\n---------------------------\nThéâtre patoisant\n\nAdmission: 6? - Free for children under 12 and local residents.\nRefreshment bar and sale of pies\nDoors open at 7:30pm\n\nReservations and information : Olivier Gest on 06 83 04 24 40 or Florence Fourcroy on 06 33 37 16 03\n\nCredit : Le Souffleur d?Embry"
        ],
        "it": [
          "Organizzato dal Comité des Fêtes\nSabato 21 febbraio alle 20.00\nSalle des Fêtes - Montcavrel\n---------------------------\nTeatro Patois\n\nIngresso: 6? - Gratuito per i bambini sotto i 12 anni e per i residenti.\nBar e vendita di torte\nApertura porte alle 19.30\n\nPrenotazioni e informazioni: Olivier Gest allo 06 83 04 24 40 o Florence Fourcroy allo 06 33 37 16 03\n\nCredito: Le Souffleur d'Embry"
        ],
        "fr": [
          "Organisé par le Comité des Fêtes\nSamedi 21 février à 20h\nSalle des Fêtes - Montcavrel\n---------------------------\nThéâtre patoisant\n\nEntrée : 6€ - Gratuit pour les -12 ans et les habitants de la commune.\nBuvette et vente de tartes\nOuverture des portes à 19h30\n\nRéservations et renseignements : Olivier Gest au 06 83 04 24 40 ou Florence Fourcroy au 06 33 37 16 03\n\nCrédit : Le Souffleur d’Embry"
        ],
        "es": [
          "Organizado por el Comité des Fêtes\nSábado 21 de febrero a las 20.00 horas\nSala de Fiestas - Montcavrel\n---------------------------\nTeatro Patois\n\nEntrada: 6? - Gratis para menores de 12 años y residentes locales.\nBarra de refrescos y venta de tartas\nApertura de puertas a las 19.30\n\nReservas e información: Olivier Gest al 06 83 04 24 40 o Florence Fourcroy al 06 33 37 16 03\n\nCrédito: Le Souffleur d'Embry"
        ],
        "nl": [
          "Georganiseerd door het Comité des Fêtes\nZaterdag 21 februari om 20 uur\nFeestzaal - Montcavrel\n---------------------------\nPatois Theater\n\nToegangsprijs: 6? - Gratis voor kinderen onder 12 jaar en buurtbewoners.\nVersnaperingsbar en verkoop van taarten\nDeuren open om 19.30\n\nReserveringen en informatie: Olivier Gest op 06 83 04 24 40 of Florence Fourcroy op 06 33 37 16 03\n\nKrediet: Souffleur d'Embry"
        ]
      },
