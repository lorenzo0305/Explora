  "rdfs:comment": {
    "de": [
      "Im Herzen des historischen Chambéry, nahe der Uhr des Fußgängerplatzes Saint Léger, befindet sich ein Restaurant, das traditionelle Hausmannskost, frische Produkte sowie Spezialitäten aus Savoyen anbietet. Große Terrasse.\r\nGute Laune und Geselligkeit."
    ],
    "en": [
      "Right in the heart of the historical centre of Chambéry, next to the clock tower in Place Saint Léger, this pub-restaurant serves traditional home-made food with fresh products and Savoy specialities, \r\nConvivial easy-going atmosphere."
    ],
    "it": [
      "Nel cuore del centro storico di Chambéry, accanto all'orologio nella piazza pedonale Saint Léger, questo ristorante offre una cucina casalinga tradizionale, prodotti freschi e specialità savoiarde. Ampia terrazza.\r\nBuon umore e convivialità."
    ],
    "fr": [
      "En plein cœur du Chambéry historique, près de l'horloge de la place piétonne Saint Léger, un restaurant proposant une cuisine traditionnelle maison, des produits frais ainsi que des spécialités savoyardes. Grande terrasse.\r\nBonne humeur et convivialité."
    ],
    "nl": [
      "In het hart van het historische Chambéry, naast de klok op het autovrije plein Saint Léger, biedt dit restaurant traditionele huisgemaakte gerechten, verse producten en Savoyaardse specialiteiten. Groot terras.\r\nGoed humeur en gezelligheid."
    ],
    "es": [
      "En pleno centro histórico de Chambéry, junto al reloj de la plaza peatonal Saint Léger, este restaurante ofrece cocina casera tradicional, productos frescos y especialidades saboyanas. Amplia terraza.\r\nBuen humor y convivencia."
    ]
  },
