  "rdfs:comment": {
    "de": [
      "Zwei Tennisplätze, auf denen Sie Ihren Lieblingssport ausüben können, mit Blick auf die Berge.\r\n\r\nReservierung über die App anybuddyapp.com oder tenup.fft.fr für lizenzierte Abonnenten."
    ],
    "en": [
      "Two tennis courts for your favorite sport, with views of the mountains.\r\nReservations on anybuddyapp.com"
    ],
    "it": [
      "Due campi da tennis per praticare il vostro sport preferito, con vista sulle montagne.\r\n\r\nPrenotazioni sull'app anybuddyapp.com o su tenup.fft.fr per gli abbonati con licenza."
    ],
    "fr": [
      "Deux terrains de tennis pour pratiquer votre sport favori, avec vue sur les montagnes.\r\n\r\nRéservation sur l'application anybuddyapp.com ou tenup.fft.fr pour les abonnés licenciés."
    ],
    "nl": [
      "Twee tennisbanen om te genieten van uw favoriete sport, met uitzicht op de bergen.\r\nBoek op de anybuddyapp.com app"
    ],
    "es": [
      "Dos pistas de tenis para disfrutar de su deporte favorito, con vistas a las montañas.\r\n\r\nReservas en la app anybuddyapp.com o tenup.fft.fr para abonados con licencia."
    ]
