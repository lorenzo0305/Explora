  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1878d8a5-bcb2-3e13-b86c-b65480e3eed2",
      "dc:description": {
        "de": [
          "Sind Sie bereit für ein unvergessliches Erlebnis? Begleiten Sie uns auf ein fesselndes Abenteuer auf den Spuren der Tiere, bei dem Ihnen jeder Schritt die geheimnisvolle Tierwelt, die unseren Park bewohnt, näher bringt!"
        ],
        "en": [
          "Are you ready for an unforgettable experience? Join us for a captivating adventure on the animal trail, where every step will bring you closer to the mysterious wildlife that inhabits our park!"
        ],
        "it": [
          "Siete pronti per un'esperienza indimenticabile? Unitevi a noi in un'avvincente avventura sul sentiero degli animali, dove ogni passo che farete vi avvicinerà alla misteriosa fauna selvatica che abita il nostro parco!"
        ],
        "fr": [
          "Êtes-vous prêts pour une expérience inoubliable ? Rejoignez-nous pour une aventure captivante sur la piste des animaux, où chaque pas vous rapprochera de la faune mystérieuse qui habite notre parc !"
        ],
        "es": [
          "¿Está preparado para vivir una experiencia inolvidable? Acompáñenos en una cautivadora aventura por el sendero de los animales, donde cada paso que dé le acercará a la misteriosa fauna que habita nuestro parque"
        ],
        "nl": [
          "Ben je klaar voor een onvergetelijke ervaring? Ga met ons mee op een boeiend avontuur op het dierenpad, waar elke stap die je zet je dichter bij de mysterieuze wilde dieren brengt die ons park bewonen!"
        ]
      },
      "@type": [
        "Description"
