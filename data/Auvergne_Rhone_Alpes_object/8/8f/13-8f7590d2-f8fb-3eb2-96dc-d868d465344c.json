  "rdfs:comment": {
    "de": [
      "Wunderschöner Bergsee, in dessen Wasser sich eine kleine rustikale Hütte spiegelt. Der Presset-See ist ein ziemlich tiefer und relativ tief eingeschnittener See."
    ],
    "en": [
      "Beautiful mountain lake where a small rustic refuge is reflected in its waters. The lake of Presset is a rather deep and relatively deep lake."
    ],
    "it": [
      "Un magnifico lago di montagna dove un piccolo rifugio rustico si riflette nelle sue acque. Il lago di Presset è abbastanza profondo e relativamente profondo."
    ],
    "fr": [
      "Magnifique lac de montagne où se reflète dans ses eaux un petit refuge rustique. Le lac de Presset est un lac assez profond et relativement encaissé."
    ],
    "es": [
      "Un magnífico lago de montaña en cuyas aguas se refleja un pequeño refugio rústico. El lago de Presset es bastante profundo y relativamente profundo."
    ],
    "nl": [
      "Een prachtig bergmeer waar een klein rustiek toevluchtsoord wordt weerspiegeld in het water. Het meer van Presset is vrij diep en relatief diep."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le lac de Presset"
    ]
  },
