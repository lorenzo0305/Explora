  "rdfs:comment": {
    "de": [
      "Bei diesem Spaziergang können Sie das Dorf und das Aix-Tal entdecken, indem Sie einem Weg folgen, der mit Kunstwerken, Spuren des Bildhauersymposiums, gesäumt ist."
    ],
    "en": [
      "This walk takes in the village and the Aix valley, following a trail dotted with works of art from the sculpture symposium."
    ],
    "it": [
      "Questa passeggiata si estende al villaggio e alla valle di Aix, seguendo un percorso costellato di opere d'arte lasciate dal simposio di scultura."
    ],
    "fr": [
      "Cette balade permet de découvrir le village et la vallée de l'Aix en suivant un parcours jalonné d'œuvres d'art, traces du symposium de sculpture."
    ],
    "es": [
      "Este paseo recorre el pueblo y el valle de Aix, siguiendo un itinerario salpicado de obras de arte sobrantes del simposio de escultores."
    ],
    "nl": [
      "Deze wandeling voert langs het dorp en de vallei van Aix, langs een route die bezaaid is met kunstwerken die zijn overgebleven van het beeldhouwsymposium."
    ]
  },
  "rdfs:label": {
    "fr": [
