  "rdfs:comment": {
    "de": [
      "Entdecken Sie anhand der schönsten Stücke der mittelalterlichen Skulpturensammlung des Musée d'histoire de Lyon das Mittelalter in Lyon, wobei die Geschichte der Abtei Ile-Barbe als roter Faden dient."
    ],
    "en": [
      "Discover Lyon?s Middle Ages through the finest pieces in the Musée d?Histoire de Lyon?s medieval sculpture collection, following the history of the Ile-Barbe abbey."
    ],
    "it": [
      "Scoprite il Medioevo a Lione attraverso alcuni dei pezzi più belli della collezione di sculture medievali del Musée d'Histoire de Lyon, seguendo come filo conduttore la storia dell'abbazia dell'Ile-Barbe."
    ],
    "fr": [
      "À travers les plus belles pièces de la collection sculptée médiévale du Musée d’histoire de Lyon, découvrez le Moyen Âge lyonnais, en suivant comme fil conducteur l’histoire de l’abbaye de l’Ile-Barbe."
    ],
    "nl": [
      "Ontdek de middeleeuwen in Lyon aan de hand van enkele van de mooiste stukken uit de collectie middeleeuwse beeldhouwwerken van het Musée d'Histoire de Lyon, met de geschiedenis van de abdij van Ile-Barbe als rode draad."
    ],
    "es": [
      "Descubra la Edad Media en Lyon a través de algunas de las mejores piezas de la colección de esculturas medievales del Museo de Historia de Lyon, siguiendo como hilo conductor la historia de la abadía de Ile-Barbe."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Merveilleux Moyen Âge - L’abbaye de l'ile-barbe, un voyage aux portes de Lyon"
    ]
  },
