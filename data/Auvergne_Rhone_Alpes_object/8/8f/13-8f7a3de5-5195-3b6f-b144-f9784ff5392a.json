  "rdfs:comment": {
    "de": [
      "In einem geheimen Tal oberhalb des Dorfes Val Cenis-Bramans wurde eine brandneue, 60 m lange Himalaya-Fußgängerbrücke über die Ambin-Schlucht in Betrieb genommen. Eine schwindelerregende Erfahrung, die Sie unbedingt testen sollten!"
    ],
    "en": [
      "In a secret valley above the village of Bramans in Val Cenis, a brand new 60m-long Himalayan footbridge has been launched over the Ambin gorges. A vertiginous experience worth trying out!"
    ],
    "it": [
      "In una valle segreta sopra il villaggio di Val Cenis-Bramans, è stata inaugurata una nuovissima passerella himalayana di 60 metri sulle gole dell'Ambin. Un'esperienza vertiginosa che vale la pena provare!"
    ],
    "fr": [
      "Dans une vallée secrète, au dessus du village de Val Cenis-Bramans, une toute nouvelle passerelle himalayenne piétonne de 60 m de long a été lancée au-dessus des gorges de l'Ambin. Une expérience vertigineuse à tester !"
    ],
    "nl": [
      "In een geheime vallei boven het dorpje Bramans in Val Cenis is een gloednieuwe 60 meter lange Himalaya loopbrug over de Ambin gorges gelanceerd. Een duizelingwekkende ervaring die het uitproberen waard is!"
    ],
    "es": [
      "En un valle secreto por encima del pueblo de Val Cenis-Bramans, se ha puesto en marcha una nueva pasarela himalaya de 60 m de longitud sobre las gargantas de Ambin. Una experiencia vertiginosa que merece la pena probar"
    ]
  },
  "rdfs:label": {
    "en": [
      "Ambin Gorge Himalayan footbridge"
    ],
    "fr": [
      "Passerelle himalayenne des gorges d'Ambin"
    ],
    "nl": [
      "Himalaya loopbrug in de Ambin kloven"
    ]
  },
