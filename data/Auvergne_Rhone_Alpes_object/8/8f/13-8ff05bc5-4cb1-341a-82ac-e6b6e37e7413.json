  "rdfs:comment": {
    "de": [
      "Calogero gibt ein Konzert in Montélimar! Ein einzigartiger Moment, in dem seine kraftvolle Stimme und seine zeitlosen Melodien das Publikum in Schwingung versetzen. Ein intensives musikalisches Treffen zwischen Emotionen, Energie und großen Klassikern."
    ],
    "en": [
      "Calogero in concert in Montélimar! A unique moment where his powerful voice and timeless melodies thrill the audience. An intense musical rendezvous of emotion, energy and classic tunes."
    ],
    "it": [
      "Calogero in concerto a Montélimar! Un momento unico in cui la sua voce potente e le sue melodie senza tempo entusiasmano il pubblico. Un intenso incontro musicale fatto di emozioni, energia e grandi classici."
    ],
    "fr": [
      "Calogero en concert à Montélimar ! Un moment unique où sa voix puissante et ses mélodies intemporelles font vibrer le public. Un rendez-vous musical intense, entre émotion, énergie et grands classiques."
    ],
    "es": [
      "¡Calogero en concierto en Montélimar! Un momento único en el que su potente voz y sus melodías intemporales emocionan al público. Un intenso encuentro musical de emoción, energía y grandes clásicos."
    ],
    "nl": [
      "Calogero in concert in Montélimar! Een uniek moment waar zijn krachtige stem en tijdloze melodieën het publiek in vervoering brengen. Een intense muzikale ontmoeting van emotie, energie en grote klassiekers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert de Calogero"
    ]
  },
