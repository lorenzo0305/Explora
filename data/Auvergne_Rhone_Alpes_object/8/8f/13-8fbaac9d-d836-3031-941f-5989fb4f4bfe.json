  "rdfs:comment": {
    "de": [
      "Das Restaurant l'Albatros bietet ein modernes Ambiente mit Bäumen, einen Speisesaal oder eine Terrasse am Pool und ist ideal für ein Geschäftsessen, ein Mittagessen mit der Familie oder mit Freunden."
    ],
    "en": [
      "In a resolutely modern setting, surrounded by trees, indoors or on the terrace by the pool, the Albatros restaurant is perfect for a business lunch, with family or friends."
    ],
    "it": [
      "In un ambiente decisamente moderno, in un contesto boschivo, all'interno o sulla terrazza a bordo piscina, il ristorante Albatros è perfetto per un pranzo di lavoro, in famiglia o con gli amici."
    ],
    "fr": [
      "Dans un cadre résolument moderne, un environnement arboré, en salle ou en terrasse au bord de la piscine, le restaurant l'Albatros est parfait pour un déjeuner d'affaires, en famille ou entre amis."
    ],
    "nl": [
      "In een resoluut moderne omgeving, in een bosrijke omgeving, binnen of op het terras bij het zwembad, is het restaurant Albatros perfect voor een zakenlunch, met familie of vrienden."
    ],
    "es": [
      "En un marco decididamente moderno, en un entorno arbolado, en el interior o en la terraza junto a la piscina, el restaurante Albatros es perfecto para una comida de negocios, en familia o con amigos."
    ]
  },
