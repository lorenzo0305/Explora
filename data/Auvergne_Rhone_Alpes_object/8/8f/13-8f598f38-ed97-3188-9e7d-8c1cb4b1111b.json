  "rdfs:comment": {
    "de": [
      "Der unter dem Hügelstaudamm Combe Oursière eingebettete Spielplatz soll ein einzigartiger Erfrischungsraum sein, ein flacher Raum mit einer kleinen Insel, die durch ein Floß verbunden ist, Wasserspielen und einer ganzen Reihe von Dauerinstallationen."
    ],
    "en": [
      "Nestled beneath the Combe Oursière reservoir, the play area is a unique place to cool off, a shallow space with a small island connected by a raft, water games and a range of permanent installations."
    ],
    "it": [
      "Situato sotto il lago artificiale di Combe Oursière, il parco giochi è un luogo unico per rinfrescarsi, uno spazio poco profondo con una piccola isola collegata da una zattera, giochi d'acqua e una serie di installazioni permanenti."
    ],
    "fr": [
      "Niché sous la retenue collinaire de la Combe Oursière, l'espace ludique se veut un espace de fraîcheur unique, un espace peu profond doté d’une petite île reliée par un radeau, des jeux d’eau, une panoplie d’installations permanentes."
    ],
    "es": [
      "Enclavada bajo el embalse de Combe Oursière, la zona de juegos es un lugar único para refrescarse, un espacio poco profundo con una pequeña isla unida por una balsa, juegos acuáticos y un sinfín de instalaciones permanentes."
    ],
    "nl": [
      "De speeltuin ligt onder het stuwmeer van Combe Oursière en is een unieke plek om af te koelen. Het is een ondiepe ruimte met een klein eiland dat wordt verbonden door een vlot, waterspelletjes en een groot aantal permanente installaties."
    ]
  },
  "rdfs:label": {
    "de": [
      "Spielbereich des Sees Combe Oursière"
    ],
    "en": [
      "Play area at the Combe Oursière lake"
    ],
    "fr": [
      "Espace aqualudique du lac de la Combe Oursière"
    ]
  },
