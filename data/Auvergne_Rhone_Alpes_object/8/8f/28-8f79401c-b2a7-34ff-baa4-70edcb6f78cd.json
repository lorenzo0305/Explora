  "rdfs:comment": {
    "de": [
      "Produzent von BIO-Gemüse der Saison im Direktverkauf.\nIn den Gärten des Stadtturms wird nur mit biologischem Saatgut produziert.\nDirektverkauf von ultrafrischem Gemüse.\nIch verkaufe auf lokalen Märkten und unter der Woche direkt auf meinem Hof."
    ],
    "en": [
      "Producer of organic seasonal vegetables for direct sale.\nAt Les Jardins du Tour de Ville, we grow only organic seeds.\nUltra-fresh direct sales.\nI sell at local markets and direct from my farm during the week."
    ],
    "it": [
      "Produttore di verdure biologiche di stagione per la vendita diretta.\nA Les jardins du tour de ville utilizziamo solo sementi biologiche.\nVendita diretta di prodotti freschissimi.\nVendo ai mercati locali e direttamente dalla mia azienda agricola durante la settimana."
    ],
    "fr": [
      "Producteur de légumes BIO de saison en vente en direct.\nAux jardins du tour de ville nous ne produisons qu’à partir de semences biologiques.\nVente directe en ultra frais.\nJe commercialise sur les marchés locaux et en direct sur mon exploitation en semaine."
    ],
    "es": [
      "Productor de hortalizas ecológicas de temporada para venta directa.\nEn Les jardins du tour de ville sólo utilizamos semillas ecológicas.\nVenta directa de productos ultra frescos.\nVendo en mercados locales y directamente desde mi granja durante la semana."
    ],
    "nl": [
      "Producent van biologische seizoensgroenten voor directe verkoop.\nBij Les jardins du tour de ville gebruiken we alleen biologisch zaad.\nDirecte verkoop van ultraverse producten.\nIk verkoop op lokale markten en doordeweeks rechtstreeks vanaf mijn boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
