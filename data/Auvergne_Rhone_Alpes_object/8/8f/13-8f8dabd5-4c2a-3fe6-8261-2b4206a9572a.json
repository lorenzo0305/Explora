  "rdfs:comment": {
    "de": [
      "IHRE EIGENE KABINE FÜR EINEN HOHEN APERITIF!\r\nEine 50-minütige Blase der Geselligkeit und Freude bei einem Aperitif, den Sie mit Ihrer Familie oder Ihren Freunden teilen können. Kommen Sie an Bord für ein einzigartiges Erlebnis und genießen Sie diesen zeitlosen Moment, während Sie in der Luft hängen."
    ],
    "en": [
      "YOUR OWN CABIN FOR AN APÉR-HAUT!\r\nA 50-minute bubble of joy and conviviality, with an aperitif to share with family and friends. Embark on a unique experience and enjoy this timeless moment, suspended in the air."
    ],
    "it": [
      "LA PROPRIA CABINA PER UN APERITIVO!\r\nUna bolla di convivialità e allegria per 50 minuti, davanti a un aperitivo da condividere con la famiglia e gli amici. Lasciatevi trasportare in un'esperienza unica e godetevi questo momento senza tempo, sospesi a mezz'aria."
    ],
    "fr": [
      "VOTRE PROPRE CABINE POUR UN APÉR-HAUT!\r\nUne bulle de convivialité et de joie pendant 50 mn, autour d’un apéritif  à partager en famille ou entre amis. Embarquez pour une expérience unique et profitez de ce moment hors du temps, suspendus dans les airs."
    ],
    "es": [
      "SU PROPIA CABAÑA PARA UN APERITIVO\r\nUna burbuja de convivencia y alegría durante 50 minutos, en torno a un aperitivo para compartir con la familia y los amigos. Embárquese en una experiencia única y disfrute de este momento intemporal, suspendido en el aire."
    ],
    "nl": [
      "JE EIGEN HUT VOOR EEN APÉR-HAUT!\r\nEen bubbel van gezelligheid en plezier gedurende 50 minuten, bij een aperitief om te delen met familie en vrienden. Beleef een unieke ervaring en geniet van dit tijdloze moment, hangend in de lucht."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Floating Aperitif in Samoëns!"
    ],
    "fr": [
      "L'Apéro Suspendu à Samoëns !"
    ],
    "nl": [
      "Het Hangende Aperitief in Samoëns!"
    ]
  },
