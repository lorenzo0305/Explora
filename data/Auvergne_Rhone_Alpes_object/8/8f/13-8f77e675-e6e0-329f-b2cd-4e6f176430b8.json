  "rdfs:comment": {
    "de": [
      "\"La Folie Douce Avoriaz\" empfängt Sie täglich von 12:00 bis 18:00 Uhr.\r\nAuf 1800 m Höhe gelegen, lädt \"La Folie Douce\" alle Generationen zu einem außergewöhnlichen Erlebnis ein."
    ],
    "en": [
      "\"La Folie Douce Avoriaz\" is open every day from 12pm to 6pm.\r\nAt an altitude of 1800 m, La Folie Douce invites all generations to enjoy an exceptional experience."
    ],
    "it": [
      "\"La Folie Douce Avoriaz\" vi accoglie tutti i giorni dalle 12.00 alle 18.00.\r\nArroccato a 1800 metri di altitudine, La Folie Douce invita tutte le generazioni a vivere un'esperienza eccezionale."
    ],
    "fr": [
      "\"La Folie Douce Avoriaz\" vous accueille tous les jours de 12h à 18h.\r\nPerchée à 1800 m d'altitude, La Folie Douce invite toutes les générations à vivre une expérience d'exception."
    ],
    "nl": [
      "\"La Folie Douce Avoriaz\" verwelkomt u elke dag van 12 tot 18 uur.\r\nGelegen op een hoogte van 1800 m, nodigt La Folie Douce alle generaties uit om te genieten van een uitzonderlijke ervaring."
    ],
    "es": [
      "\"La Folie Douce Avoriaz\" le da la bienvenida todos los días de 12 a 18 horas.\r\nEncaramado a 1.800 m de altitud, La Folie Douce invita a todas las generaciones a disfrutar de una experiencia excepcional."
    ]
  },
