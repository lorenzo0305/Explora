  "rdfs:comment": {
    "de": [
      "VD Artisan à tous vents bietet Ihnen die Reparatur und Herstellung von Blasmusikinstrumenten an.\r\nMit dem Willen, lokale Kompetenzen zu nutzen und nach Möglichkeit\r\nsoweit möglich, die Instrumente zu reparieren, anstatt sie neu zu kaufen."
    ],
    "en": [
      "VD Artisan à tous vents repairs and manufactures wind instruments.\r\nOur aim is to use local expertise and, wherever possible\r\nrepairing instruments rather than buying new ones."
    ],
    "it": [
      "VD Artisan à tous vents ripara e produce strumenti a fiato.\r\nIl nostro obiettivo è quello di utilizzare le competenze locali e, ove possibile\r\nriparare gli strumenti piuttosto che acquistarne di nuovi."
    ],
    "fr": [
      "VD Artisan à tous vents vous propose la réparation et fabrication d'instruments de musique à vent.\r\nAvec la volonté d'utiliser des compétences locales et dans\r\nla mesure du possible de réparer les instruments plutôt que d'en racheter."
    ],
    "nl": [
      "VD Artisan à tous vents repareert en maakt blaasinstrumenten.\r\nOns doel is om lokale expertise te gebruiken en, waar mogelijk\r\ninstrumenten te repareren in plaats van nieuwe te kopen."
    ],
    "es": [
      "VD Artisan à tous vents repara y fabrica instrumentos de viento.\r\nNuestro objetivo es utilizar la experiencia local y, siempre que sea posible\r\nreparar instrumentos en lugar de comprar otros nuevos."
    ]
  },
  "rdfs:label": {
