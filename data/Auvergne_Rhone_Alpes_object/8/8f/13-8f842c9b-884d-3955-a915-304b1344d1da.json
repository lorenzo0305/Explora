  "rdfs:comment": {
    "de": [
      "Das größte römische Forum Frankreichs befindet sich im Forum antique de Bavay, dem archäologischen Museum des Departements Nord. Es erwarten Sie eine archäologische Stätte, ein Museum und immersive Erlebnisse."
    ],
    "en": [
      "The largest Roman forum in France can be found at the Ancient Forum of Bavay, the archaeological museum of the Department of the North. An archaeological site, a museum and immersive experiences await you."
    ],
    "it": [
      "Il più grande foro romano di Francia si trova al Forum Antique de Bavay, il museo archeologico del Département du Nord. Vi aspettano un sito archeologico, un museo ed esperienze coinvolgenti."
    ],
    "fr": [
      "Le plus grand forum romain de France se trouve au Forum antique de Bavay, musée archéologique du Département du Nord. Un site archéologique, un musée et des expériences immersives vous attendent."
    ],
    "nl": [
      "Het grootste Romeinse forum van Frankrijk is te vinden in het Forum Antique de Bavay, het archeologisch museum van het Département du Nord. Een archeologische site, een museum en meeslepende ervaringen wachten op u."
    ],
    "es": [
      "El mayor foro romano de Francia se encuentra en el Foro Antiguo de Bavay, museo arqueológico del Departamento del Norte. Le esperan un yacimiento arqueológico, un museo y experiencias inmersivas."
    ]
  },
