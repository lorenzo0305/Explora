  "rdfs:comment": {
    "de": [
      "Multi-Aktivitäten-Zentrum, in dem Sie für Anfänger und Fortgeschrittene folgende Aktivitäten finden können: Ausbildung, Erkundungstouren im Tauchen, Schwimmunterricht, Erste-Hilfe-Ausbildung, Rettungsschwimmen, Bogenschießen und Blasrohrschießen."
    ],
    "en": [
      "Multi-activity center where you'll find training, scuba diving exploration, swimming instruction, first-aid training, lifesaving, archery and blowpipe."
    ],
    "it": [
      "Un centro multiattività che offre corsi di formazione ed esplorazione per immersioni subacquee, lezioni di nuoto, corsi di primo soccorso, salvataggio, tiro con l'arco e tiro a segno."
    ],
    "fr": [
      "Centre Multi-activités où vous trouverez pour les débutants, aux confirmés : des formations, des explorations en Plongée sous Marine, de l'enseignement en natation, des formations en secourisme, du sauvetage, du Tir à l'Arc et Sarbacanes."
    ],
    "es": [
      "Un centro multiactividades donde encontrará formación y exploración en submarinismo, clases de natación, formación en primeros auxilios, salvamento, tiro con arco y tiro deportivo."
    ],
    "nl": [
      "Een multi-activiteitencentrum waar je training en verkenning kunt krijgen in duiken, zwemlessen, eerstehulptraining, reddingswerk, boogschieten en schieten."
    ]
  },
