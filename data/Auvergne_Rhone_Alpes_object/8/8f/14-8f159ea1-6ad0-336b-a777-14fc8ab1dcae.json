  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d7a97517-c8cb-3f80-8084-684d60db1843",
      "dc:description": {
        "de": [
          "Am Flughafen von Le Touquet gibt es einen Fahrradverleih.\n\nFAHRRADVERLEIH\n4 ?/Stunde,\n12 ?/ ½ Tag,\n15 ?/Tag (+24h)\n \n\nELEKTROFAHRRÄDER\n25 ?/ Tag,\n35 ?/ Tag (+24h)"
        ],
        "en": [
          "Le Touquet airport offers a bicycle rental service.\n\nBIKE RENTAL\n4 ?/hour,\n12 ?/ ½ day,\n15 ?/day (+ 24h)\n \n\nELECTRIC BIKES\n25 ?/ day,\n35 ?/ day (over 24h)"
        ],
        "it": [
          "L'aeroporto di Le Touquet offre un servizio di noleggio biciclette.\n\nNOLEGGIO BICICLETTE\n4 / ora,\n12 ?/giorno e mezzo,\n15 ?/giorno (più di 24 ore)\n \n\nBICICLETTE ELETTRICHE\n25 ?/giorno,\n35 ?/giorno (più di 24 ore)"
        ],
        "fr": [
          "L’aéroport du Touquet met à disposition un service de location de vélos.\n\nLOCATION DE VELOS\n4 €/heure,\n12 €/ ½ journée,\n15 €/ jour (+de 24h)\n \n\nVELOS ELECTRIQUES\n25 €/ journée,\n35 €/ jour (+de 24h)"
        ],
        "es": [
          "El aeropuerto de Le Touquet ofrece un servicio de alquiler de bicicletas.\n\nALQUILER DE BICICLETAS\n4 ?/hora,\n12 ?/ ½ día,\n15 ?/día (más de 24h)\n \n\nBICICLETAS ELÉCTRICAS\n25 ?/día\n35 ¤ /día (más de 24h)"
        ],
        "nl": [
          "De luchthaven van Le Touquet biedt een fietsverhuurservice.\n\nFIETSVERHUUR\n4 uur,\n12 € / ½ dag,\n15 € / dag (meer dan 24 uur)\n \n\nELEKTRISCHE FIETSEN\n25 € / dag,\n35 € / dag (meer dan 24u)"
        ]
      },
