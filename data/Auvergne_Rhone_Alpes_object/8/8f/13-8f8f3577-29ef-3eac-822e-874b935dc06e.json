  "rdfs:comment": {
    "de": [
      "Seit 2015 versammelt das Festival Les Trois Chaises an jedem ersten Augustwochenende in Allègre zahlreiche Musikliebhaber und renommierte Künstler. Am Fuße des berühmten Potences bietet das Festival ein einzigartiges kulturelles Erlebnis in ländlicher Umgebung."
    ],
    "en": [
      "Since 2015, every first weekend in August, the Festival Les Trois Chaises has brought many music lovers and renowned artists to Allègre. At the foot of the famous Potence, the festival offers a unique cultural experience in a rural setting."
    ],
    "it": [
      "Dal 2015, ogni primo fine settimana di agosto, il Festival Les Trois Chaises riunisce ad Allègre una schiera di appassionati di musica e artisti rinomati. Ai piedi della famosa Potence, il festival offre un'esperienza culturale unica in un ambiente rurale."
    ],
    "fr": [
      "Depuis 2015, chaque premier week-end d'août, le Festival Les Trois Chaises rassemble à Allègre, de nombreux mélomanes et artistes de renommées. Au pied de la célèbre Potence, le festival propose une expérience culturelle unique en milieu rural."
    ],
    "nl": [
      "Sinds 2015 brengt het Festival Les Trois Chaises elk eerste weekend van augustus een groot aantal muziekliefhebbers en bekende artiesten samen in Allègre. Aan de voet van de beroemde Potence biedt het festival een unieke culturele ervaring in een landelijke omgeving."
    ],
    "es": [
      "Desde 2015, cada primer fin de semana de agosto, el Festival Les Trois Chaises reúne en Allègre a multitud de melómanos y artistas de renombre. A los pies de la famosa Potence, el festival ofrece una experiencia cultural única en un entorno rural."
    ]
  },
  "rdfs:label": {
