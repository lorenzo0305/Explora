  "rdfs:comment": {
    "de": [
      "Geschenkboutique - Teestube - Touristeninformationsstelle\nLebensmittelgeschäfte, Feinkostläden, Feinschmeckerkerzen...\nVerkauf von Schmuck aus Edelstahl, Handtaschen, Schals, handgefertigten Seifen, Naturkerzen? Verkauf von regionalen Produkten aus der Picardie zum Verzehr vor Ort oder zum Mitnehmen im Touristeninformationspunkt und Teesalon"
    ],
    "en": [
      "Gift store - Tearoom - Tourist information point\nFresh produce, delicatessen, gourmet candles...\nSale of stainless steel jewelry, handbags, scarves, handmade soaps, natural candles... sale of local Picardy products to eat in or take away from the tourist information point and tearoom"
    ],
    "it": [
      "Negozio di souvenir - Sala da tè - Punto di informazione turistica\nProdotti freschi, gastronomia, candele gourmet...\nVendita di gioielli in acciaio, borse, sciarpe, saponi fatti a mano, candele naturali, ecc. Vendita di prodotti locali della Piccardia da consumare o da portare via presso il punto informazioni turistiche e la sala da tè"
    ],
    "fr": [
      "Boutique cadeaux - Salon de thé - Point info touristique \nPrimeur, épiceries fines, bougies gourmandes...\nVente de bijoux en acier inoxydable, sacs à main, écharpes, savons artisanaux, bougies naturelles… vente de produits du terroir picard à consommer sur place ou à emporter au point info touristique et salon de thé"
    ],
    "es": [
      "Tienda de regalos - Salón de té - Punto de información turística\nProductos frescos, delicatessen, velas gourmet...\nVenta de joyas de acero inoxidable, bolsos, pañuelos, jabones artesanales, velas naturales, etc. Venta de productos locales de Picardía para comer o llevar en el punto de información turística y el salón de té"
    ],
    "nl": [
      "Geschenkenwinkel - Tearoom - Toeristisch informatiepunt\nVerse producten, delicatessen, kaarsen voor fijnproevers...\nVerkoop van roestvrijstalen juwelen, handtassen, sjaals, handgemaakte zeep, natuurlijke kaarsen, enz. Verkoop van Picardische streekproducten om te eten of mee te nemen in het toeristisch informatiepunt en de tearoom"
    ]
  },
  "rdfs:label": {
