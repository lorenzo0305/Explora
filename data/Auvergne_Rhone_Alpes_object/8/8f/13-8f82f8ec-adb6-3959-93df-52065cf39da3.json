  "rdfs:comment": {
    "de": [
      "Das Hotel Le Taconet ist ein familiengeführtes, freundliches Haus mit einem herzlichen Empfang.\r\n\r\nEs befindet sich in der Nähe der Skipisten, sodass die Gäste mit Skiern an den Füßen losfahren können.  Das Hotel ist auch für seine guten Gerichte bekannt."
    ],
    "en": [
      "Hotel Le Taconet is a friendly, family-run establishment with a warm welcome.\r\n\r\nIt's close to the ski slopes, so guests can get away from it all with skis on.  The hotel is also renowned for its fine cuisine."
    ],
    "it": [
      "L'Hotel Le Taconet è un'accogliente struttura a conduzione familiare che offre un caloroso benvenuto.\r\n\r\nÈ vicino alle piste da sci e gli ospiti possono sciare con gli sci ai piedi.  L'hotel è anche rinomato per la sua cucina raffinata."
    ],
    "fr": [
      "L'hôtel Le Taconet est un établissement familial, convivial et son accueil est chaleureux.\r\n\r\nIl est à proximité des pistes de ski permettant aux clients de partir skis aux pieds.  L'hôtel est également connu pour ses bons petits plats."
    ],
    "nl": [
      "Hotel Le Taconet is een vriendelijk familiebedrijf met een warm welkom.\r\n\r\nHet ligt dicht bij de skipistes, dus gasten kunnen gaan skiën met hun ski's aan.  Het hotel staat ook bekend om zijn goede keuken."
    ],
    "es": [
      "El Hotel Le Taconet es un establecimiento familiar y acogedor.\r\n\r\nEstá cerca de las pistas de esquí, por lo que los huéspedes pueden esquiar con los esquís puestos.  El hotel también es famoso por su excelente cocina."
    ]
  },
  "rdfs:label": {
