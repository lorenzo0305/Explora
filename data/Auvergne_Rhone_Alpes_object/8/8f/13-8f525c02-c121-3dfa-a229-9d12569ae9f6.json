  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie in einem gemütlichen und eleganten Ambiente, das ideal ist, um einen geselligen Moment zu teilen. Hochwertige bistronomische Küche mit frischen, saisonalen Produkten. Unser Ziel ist es, Ihnen ein unvergessliches kulinarisches Erlebnis zu bereiten."
    ],
    "en": [
      "We welcome you in a cosy and elegant atmosphere, ideal for sharing a convivial moment. Quality bistronomic cuisine using fresh, seasonal produce. Our aim is to provide you with an unforgettable culinary experience."
    ],
    "it": [
      "Vi accogliamo in un'atmosfera accogliente ed elegante, ideale per condividere un momento di convivialità. Cucina bistrot di qualità con prodotti freschi di stagione. Il nostro obiettivo è offrirvi un'esperienza culinaria indimenticabile."
    ],
    "fr": [
      "Nous vous accueillons dans une ambiance cosy et élégante, idéale pour partager un moment convivial. Cuisine bistronomique de qualité à base de produits frais et de saison. L'objectif, vous faire passer une expérience culinaire inoubliable."
    ],
    "nl": [
      "We verwelkomen je in een gezellige en elegante sfeer, ideaal voor het delen van een gezellig moment. Kwaliteits bistrokeuken met verse seizoensproducten. Ons doel is u een onvergetelijke culinaire ervaring te bezorgen."
    ],
    "es": [
      "Le damos la bienvenida en un ambiente acogedor y elegante, ideal para compartir un momento de convivencia. Cocina bistró de calidad elaborada con productos frescos de temporada. Nuestro objetivo es ofrecerle una experiencia culinaria inolvidable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le 1920"
    ]
  },
