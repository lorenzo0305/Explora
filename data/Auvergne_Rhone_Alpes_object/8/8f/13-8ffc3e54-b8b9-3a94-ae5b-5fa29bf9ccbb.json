  "rdfs:comment": {
    "de": [
      "Werkstatt, die auf die sehr genaue Herstellung von Sigillata-Tonwaren aus der römischen Zeit spezialisiert ist. Entdecken Sie einen einzigartigen Laden und zögern Sie nicht, mich für Veranstaltungen zu kontaktieren. Ich kann mich auf den Weg machen, um die Herstellung zu demonstrieren."
    ],
    "en": [
      "In my workshop, you’ll find decorative pieces in relief recounting tales of life, my- thology and the traditions of our ancestors."
    ],
    "it": [
      "Officina specializzata nella produzione fedele di ceramica sigillata romana. Venite a scoprire un negozio unico e non esitate a contattarmi per le animazioni, posso spostarmi per effettuare dimostrazioni di lavorazione."
    ],
    "fr": [
      "Atelier spécialisé en production très fidèle des poteries sigillées de la période romaine. Venez découvrir une boutique unique et n'hésitez pas à me contacter pour des animations, je peux me déplacer pour réaliser des démonstrations de fabrication."
    ],
    "nl": [
      "Workshop gespecialiseerd in de getrouwe productie van Romeins gesignaleerd aardewerk. Kom en ontdek een unieke winkel en aarzel niet om me te contacteren voor animaties, ik kan me verplaatsen om demonstraties van vervaardiging uit te voeren."
    ],
    "es": [
      "Taller especializado en la producción fiel de cerámica sigilada romana. Venga a descubrir una tienda única y no dude en ponerse en contacto conmigo para las animaciones, puedo desplazarme para realizar demostraciones de fabricación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Potier Ars Fictilis"
    ]
  },
