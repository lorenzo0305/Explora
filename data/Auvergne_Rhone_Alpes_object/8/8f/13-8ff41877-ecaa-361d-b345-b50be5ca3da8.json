  "rdfs:comment": {
    "de": [
      "Kino mit einem digitalen Projektionssystem ausgestattet.\r\nZusätzliche Vorführung bei schlechtem Wetter. Saal mit 150 Sitzplätzen.\r\nNeu im Jahr 2025: Wir bieten Ihnen eine Abonnementkarte mit 10 Vorstellungen für 60 Euro an."
    ],
    "en": [
      "Cinema equipped with a digital projection system.\r\nExtra screenings in case of bad weather. Seats 150.\r\nNew for 2025, we are offering a 10-session season ticket for 60 euros."
    ],
    "it": [
      "Cinema dotato di sistema di proiezione digitale.\r\nProiezioni extra in caso di maltempo. Posti a sedere 150.\r\nNovità del 2025, l'abbonamento a 10 spettacoli a 60 euro."
    ],
    "fr": [
      "Cinéma équipé d'un système de projection numérique.\r\nSéance supplémentaire en cas de mauvais temps. Salle de 150 places.\r\nNouveauté en 2025, nous vous proposons une carte d'abonnement de 10 séances pour 60 euros."
    ],
    "es": [
      "Cine equipado con un sistema de proyección digital.\r\nProyecciones adicionales en caso de mal tiempo. 150 plazas.\r\nComo novedad para 2025, ofrecemos un abono de 10 sesiones por 60 euros."
    ],
    "nl": [
      "Bioscoop uitgerust met een digitaal projectiesysteem.\r\nExtra voorstellingen bij slecht weer. 150 zitplaatsen.\r\nNieuw in 2025: een abonnement voor 10 zittingen voor 60 euro."
    ]
  },
