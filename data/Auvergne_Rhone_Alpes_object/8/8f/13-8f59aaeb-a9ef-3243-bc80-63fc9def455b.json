  "rdfs:comment": {
    "de": [
      "Im Herzen von Banne kreieren die Cousinen Kim (Chefin) und Claire (Gärtnerin) frische, hausgemachte Gerichte, die vom Gemüsegarten und den Jahreszeiten der Ardèche inspiriert sind. Ein herzliches und authentisches Erlebnis vom Bauernhof bis auf den Teller."
    ],
    "en": [
      "In the heart of Banne, our restaurant blends tradition and creativity. Enjoy fresh, local dishes celebrating Ardèche's flavours in a warm, authentic setting. Perfect for any occasion, we offer a unique dining experience with every meal."
    ],
    "it": [
      "Nel cuore di Banne, le cugine Kim (chef) e Claire (giardiniera) creano piatti freschi e casalinghi ispirati all'orto dell'Ardèche e alle stagioni. Un'esperienza calda e autentica dalla fattoria al piatto."
    ],
    "fr": [
      "Au cœur de Banne, les cousines Kim (cheffe) et Claire (jardinière) créent des plats frais, faits maison, inspirés par le potager et les saisons de l’Ardèche. Une expérience chaleureuse et authentique de la ferme à l’assiette."
    ],
    "nl": [
      "In het hart van Banne creëren de nichtjes Kim (chef-kok) en Claire (tuinvrouw) verse, huisgemaakte gerechten geïnspireerd op de moestuin van de Ardèche en de seizoenen. Een warme en authentieke ervaring van boerderij tot bord."
    ],
    "es": [
      "En el corazón de Banne, las primas Kim (chef) y Claire (jardinera) crean platos frescos y caseros inspirados en la huerta de Ardèche y en las estaciones. Una experiencia cálida y auténtica de la granja al plato."
    ]
  },
