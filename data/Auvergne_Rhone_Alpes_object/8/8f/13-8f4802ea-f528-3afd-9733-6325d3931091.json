  "rdfs:comment": {
    "de": [
      "Demnächst in Ardèche Grand Air und Porte de DrômArdèche: die Via Fluvia, eine Fahrradroute zwischen Loire und Rhône für ein 360°-Erlebnis!\r\nEine Strecke, über die derzeit nachgedacht wird und die sich auf der Höhe von Serrières mit der Via Rhôna verbinden soll."
    ],
    "en": [
      "Coming soon in Ardèche Grand Air and Porte de DrômArdèche: the Via Fluvia, a bicycle route between the Loire and the Rhône for a 360° experience!\r\nThis route is currently being studied and should join the Via Rhôna at Serrières."
    ],
    "it": [
      "In arrivo in Ardèche Grand Air e Porte de DrômArdèche: la Via Fluvia, un percorso ciclabile tra la Loira e il Rodano per un'esperienza a 360°!\r\nIl percorso è attualmente in fase di studio e dovrebbe unirsi alla Via Rhôna a Serrières."
    ],
    "fr": [
      "Prochainement en Ardèche Grand Air et en Porte de DrômArdèche : la Via Fluvia, une véloroute entre Loire et Rhône pour une expérience à 360° !\r\nTracé en cours de réflexion qui devrait rejoindre la Via Rhôna au niveau de Serrières."
    ],
    "es": [
      "Próximamente en Ardèche Grand Air y Porte de DrômArdèche: la Vía Fluvia, una ruta ciclista entre el Loira y el Ródano para vivir una experiencia de 360°\r\nEl itinerario se está estudiando actualmente y debería unirse a la Vía Rhôna en Serrières."
    ],
    "nl": [
      "Binnenkort in Ardèche Grand Air en Porte de DrômArdèche: de Via Fluvia, een fietsroute tussen de Loire en de Rhône voor een 360° ervaring!\r\nDe route wordt momenteel overwogen en zou bij Serrières moeten aansluiten op de Via Rhôna."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Fluvia - Annonay - Via Rhôna"
    ]
  },
