  "rdfs:comment": {
    "de": [
      "Virginie und ihr Chefkoch bieten Ihnen neue Angebote an, die im Restaurant notiert sind. Entdecken Sie die modernen Gerichte des Küchenchefs, einschließlich vegetarischer Optionen und einer neuen Weinkarte."
    ],
    "en": [
      "Virginie and her Chef are offering you a new range of dishes at the restaurant. Come and discover the chef's modern dishes, including vegetarian options and a new wine list."
    ],
    "it": [
      "Virginie e il suo chef vi propongono una nuova gamma di piatti al ristorante. Venite a scoprire i piatti moderni dello chef, comprese le opzioni vegetariane e una nuova carta dei vini."
    ],
    "fr": [
      "Virginie et son Chef vous proposent de nouvelles offres coté restaurant. Venez découvrir les plats modernes du chef y compris des options végétariennes ainsi qu'une nouvelle carte des vins."
    ],
    "es": [
      "Virginie y su Chef le ofrecen una nueva gama de platos en el restaurante. Venga a descubrir los platos modernos del chef, incluyendo opciones vegetarianas y una nueva carta de vinos."
    ],
    "nl": [
      "Virginie en haar chef-kok bieden je een nieuwe reeks gerechten in het restaurant. Kom en ontdek de moderne gerechten van de chef, inclusief vegetarische opties en een nieuwe wijnkaart."
    ]
  },
