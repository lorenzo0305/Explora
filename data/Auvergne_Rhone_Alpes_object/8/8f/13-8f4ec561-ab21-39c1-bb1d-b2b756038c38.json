  "rdfs:comment": {
    "de": [
      "Lust auf einen Tagesausflug? Testen Sie das \"Picknick des Chefs\"! Eine Formel, die in unserer Küche zubereitet wird und aus lokalen und saisonalen Produkten besteht! Nur auf Vorbestellung erhältlich. Für Gruppen möglich."
    ],
    "en": [
      "Fancy a day out? Try the \"chef's picnic\"! Prepared in our kitchen with local, seasonal produce! Available on reservation only. Possible for groups."
    ],
    "it": [
      "Avete voglia di una giornata fuori porta? Provate il \"picnic dello chef\"! Preparato nella nostra cucina con prodotti locali e di stagione! Disponibile solo su prenotazione. Disponibile per gruppi."
    ],
    "fr": [
      "Envie de partir à la journée ? Testez le \"pique nique du chef\" ! Une formule préparée dans notre cuisine, composées de produits locaux et de saison ! Disponible sur réservation uniquement. Possible pour les groupes."
    ],
    "es": [
      "¿Le apetece pasar un día fuera? Pruebe el \"picnic del chef\" Preparado en nuestra cocina con productos locales de temporada Sólo con reserva previa. Disponible para grupos."
    ],
    "nl": [
      "Zin in een dagje uit? Probeer de \"picknick van de chef\"! Bereid in onze keuken met lokale, seizoensgebonden producten! Alleen beschikbaar op reservering. Beschikbaar voor groepen."
    ]
  },
