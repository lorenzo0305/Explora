  "rdfs:comment": {
    "de": [
      "Die Roza Lallemand Trophy ist ein Wettbewerb, der sich an Schachspielerinnen aller Spielstärken richtet, auch an solche, die nicht in einem Verein spielen.\r\nDas Turnier besteht aus 7 Partien zu je 15 Minuten pro Spielerin."
    ],
    "en": [
      "The Trophée Roza Lallemand is a competition for female chess players of all levels, even those who don't play in a club.\r\nThe tournament consists of 7 games of 15 minutes each."
    ],
    "it": [
      "Il Trophée Roza Lallemand è una competizione per scacchiste di tutti i livelli, anche per quelle che non giocano in un club.\r\nIl torneo consiste in 7 partite di 15 minuti ciascuna."
    ],
    "fr": [
      "Le Trophée Roza Lallemand est une compétition adressée aux joueuses d'échecs de tout niveau, même ne jouant pas en club.\r\nCe tournoi se déroule en 7 parties de 15 minutes par joueuses."
    ],
    "es": [
      "El Trophée Roza Lallemand es una competición para ajedrecistas femeninas de todos los niveles, incluso las que no juegan en un club.\r\nEl torneo consta de 7 partidas de 15 minutos cada una."
    ],
    "nl": [
      "De Trophée Roza Lallemand is een competitie voor vrouwelijke schakers van alle niveaus, zelfs voor degenen die niet in een club spelen.\r\nHet toernooi bestaat uit 7 partijen van elk 15 minuten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Compétition d'échec : Trophée Roza Lallemand"
    ]
  },
