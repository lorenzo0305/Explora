  "rdfs:comment": {
    "de": [
      "Pascal, Absolvent der internationalen Schule von Mirecourt, empfängt Sie in seinem Atelier im Herzen des historischen Viertels von Le Puy-en-Velay, einer außergewöhnlichen Stätte, die zum UNESCO-Weltkulturerbe gehört."
    ],
    "en": [
      "Pascal, a graduate of the International School of Mirecourt, welcomes you to his workshop in the heart of the historic district of Le Puy-en-Velay, an exceptional UNESCO World Heritage site."
    ],
    "it": [
      "Pascal, diplomato alla Scuola Internazionale di Mirecourt, vi accoglie nel suo laboratorio nel cuore del quartiere storico di Le Puy-en-Velay, eccezionale patrimonio mondiale dell'UNESCO."
    ],
    "fr": [
      "Pascal, diplômé de l'école internationale de Mirecourt, vous accueille dans son atelier installé au cœur du quartier historique du Puy-en-Velay, site exceptionnel inscrit au patrimoine mondial de l'UNESCO."
    ],
    "es": [
      "Pascal, diplomado de la Escuela Internacional de Mirecourt, le da la bienvenida a su taller en el corazón del casco histórico de Le Puy-en-Velay, excepcional Patrimonio Mundial de la UNESCO."
    ],
    "nl": [
      "Pascal, afgestudeerd aan de Internationale School van Mirecourt, heet je welkom in zijn atelier in het hart van de historische wijk van Le Puy-en-Velay, een uitzonderlijk UNESCO Werelderfgoed."
    ]
  },
