  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c4269f6b-e091-3a92-8b84-b6dd34f7918d",
      "dc:description": {
        "de": [
          "Reparatur, Wartung und Verkauf von Fahrrädern (Mountainbikes, E-Bikes, Rennräder, Stadträder...). Entdecken Sie ein qualitatives und einzigartiges Angebot an Verkauf, Reparatur und Verleih von Fahrrädern, das als das qualitativ hochwertigste der Region positioniert ist."
        ],
        "en": [
          "Repair, maintenance and sales of bicycles (mountain bikes, VAE, road bikes, city bikes...). Discover a unique, high-quality range of bicycle sales, repairs and rentals, positioned as the region's best."
        ],
        "it": [
          "Riparazione, manutenzione e vendita di biciclette (mountain bike, VAE, bici da strada, city bike, ecc.). Scoprite un'offerta unica e di qualità per la vendita, la riparazione e il noleggio di biciclette, posizionata come la migliore della regione."
        ],
        "fr": [
          "Réparation, entretien, vente de vélos (VTT, VAE, Vélos route, villes...). Découvrez une offre qualitative et unique de vente, réparation et location de cycles, positionnée comme la plus qualitative de la région."
        ],
        "nl": [
          "Reparatie, onderhoud en verkoop van fietsen (mountainbikes, VAE's, racefietsen, stadsfietsen, enz.). Ontdek een uniek en kwalitatief hoogstaand aanbod van fietsverkoop, -reparatie en -verhuur, gepositioneerd als het beste in de regio."
        ],
        "es": [
          "Reparación, mantenimiento y venta de bicicletas (bicicletas de montaña, VAE, bicicletas de carretera, bicicletas urbanas, etc.). Descubra una oferta única y de calidad en venta, reparación y alquiler de bicicletas, posicionada como la mejor de la región."
        ]
      },
      "@type": [
        "Description"
      ],
