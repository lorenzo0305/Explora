  "rdfs:comment": {
    "de": [
      "Das im Herzen des Haut-Bugey in Nantua gelegene Musée de la Résistance et de la Déportation de l'Ain bietet eine aktualisierte Interpretation der Ereignisse des Zweiten Weltkriegs anhand der Erlebnisse der Bewohner des Ain."
    ],
    "en": [
      "Housed in a 19th-century prison, the Museum of Resistance and Deportation is one of the region’s major museums about the Second World War. Please note that the museum is closed until 10th September 2017 for renovation works, making it more accessible to wheelchair users."
    ],
    "it": [
      "Situato nel cuore della regione dell'Haut-Bugey, a Nantua, il Museo della Resistenza e della Deportazione dell'Ain offre una lettura aggiornata degli eventi della Seconda Guerra Mondiale attraverso l'esperienza degli abitanti dell'Ain."
    ],
    "fr": [
      "Installé au cœur du Haut-Bugey, à Nantua, le musée de la Résistance et de la Déportation de l’Ain propose une lecture actualisée des événements de la Seconde Guerre à travers le vécu des habitants de l’Ain."
    ],
    "es": [
      "Situado en el corazón de la región de Haut-Bugey, en Nantua, el Museo de la Resistencia y la Deportación del Ain ofrece una lectura actualizada de los acontecimientos de la Segunda Guerra Mundial a través de la experiencia de los habitantes del Ain."
    ],
    "nl": [
      "In het hart van de Haut-Bugey, in Nantua, biedt het Verzets- en Deportatiemuseum van de Ain een actuele lezing van de gebeurtenissen van de Tweede Wereldoorlog aan de hand van de ervaringen van de inwoners van de Ain."
    ]
  },
  "rdfs:label": {
