  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Magie des nordischen Badens! Beheizte Becken im Freien, das Ganze durch eine überdachte und temperierte Schleuse zugänglich! Ein Moment der Entspannung und des Wohlbefindens, im warmen Wasser unter der frischen Bergluft."
    ],
    "en": [
      "An open-air pool for all ages in the heart of the beautiful mountains of Le Massif des Bauges."
    ],
    "it": [
      "Scoprite la magia del nuoto nordico! Piscine riscaldate all'aperto, tutte accessibili attraverso una camera stagna coperta e temperata! Un momento di relax e benessere, nell'acqua calda e nell'aria fresca di montagna."
    ],
    "fr": [
      "Découvrez la magie de la baignade nordique ! Bassins chauffés en plein-air, le tout accessible par un sas couvert et tempéré ! Un moment de détente et bien-être, dans une eau chaude sous l'air frais des montagnes."
    ],
    "es": [
      "¡Descubra la magia de la natación nórdica! Piscinas exteriores climatizadas, ¡todas accesibles a través de una esclusa cubierta y templada! Un momento de relajación y bienestar, en aguas cálidas y aire fresco de montaña."
    ],
    "nl": [
      "Openluchtzwembad midden in de bergen van het Baugesmassief, waterplezier voor klein en groot!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Open-air swimming pool"
    ],
    "fr": [
      "Piscine municipale d'Aillons-Margériaz"
    ],
    "nl": [
      "Openluchtzwembad"
    ]
  },
