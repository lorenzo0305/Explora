  "rdfs:comment": {
    "de": [
      "Die Gondelbahn bringt Sie zu einem Panoramablick auf Morzine, das Chablais und den Mont Blanc. Sie ist auch der Ausgangspunkt für zahlreiche Wanderrouten."
    ],
    "en": [
      "The cable car lifts you up to a panoramic view of Morzine, the Chablais and Mont Blanc. It is also the departure point for many hiking routes."
    ],
    "it": [
      "La funivia offre una vista panoramica su Morzine, la regione dello Chablais e il Monte Bianco. È anche il punto di partenza di numerosi sentieri escursionistici."
    ],
    "fr": [
      "La télécabine vous élève vers une vue panoramique de Morzine, du Chablais et sur le Mont Blanc. C’est aussi le départ de nombreux itinéraires de randonnée."
    ],
    "es": [
      "El teleférico permite disfrutar de una vista panorámica de Morzine, la región de Chablais y el Mont Blanc. También es el punto de partida de varias rutas de senderismo."
    ],
    "nl": [
      "De kabelbaan brengt je naar een panoramisch uitzicht over Morzine, de Chablais regio en de Mont Blanc. Het is ook het startpunt van een aantal wandelroutes."
    ]
  },
