  "rdfs:comment": {
    "de": [
      "\"Als Angelspezialist betreue ich alle Flüsse des Departements, die Seen von Aiguebelette, Bourget, Annecy und den Genfer See. Ich führe auch auf dem Fluss Rhône sowie auf den Stauseen von Villerest und Grangent in der Loire. \""
    ],
    "en": [
      "\"A fishing specialist, I work on all the rivers in the département, as well as on lakes Aiguebelette, Bourget, Annecy and Léman. I also guide on the Rhône river and the Villerest and Grangent dam lakes in the Loire. \""
    ],
    "it": [
      "\"Come specialista della pesca, lavoro su tutti i fiumi del dipartimento, oltre che sui laghi di Aiguebelette, Bourget, Annecy e Léman. Guido anche sul Rodano e sui laghi di Villerest e Grangent nella Loira. \""
    ],
    "fr": [
      "\"Spécialiste de la pêche, j'interviens sur toutes les rivières du département, les lacs d'Aiguebelette, du Bourget, d'Annecy et du Léman. Je guide aussi sur le fleuve Rhône ainsi que sur les lacs de barrage de Villerest et Grangent en Loire. \""
    ],
    "es": [
      "\"Especialista en pesca, trabajo en todos los ríos del departamento, los lagos de Aiguebelette, Bourget, Annecy y Leman. También guío en el río Ródano, así como en los lagos de la presa de Villerest y Grangent, en el Loira. \""
    ],
    "nl": [
      "\"Als visspecialist werk ik op alle rivieren in het departement, evenals op de meren Aiguebelette, Bourget, Annecy en Léman. Ik begeleid ook op de Rhône en de stuwmeren van Villerest en Grangent in de Loire. \""
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing guide - Jimmy MAISTRELLO (Savoieguidage)"
    ],
    "it": [
      "Guida di pesca - Jimmy MAISTRELLO (Savoieguidage)"
    ],
    "fr": [
      "Moniteur guide de pêche - Jimmy MAISTRELLO (Savoieguidage)"
    ],
    "nl": [
      "Visgids - Jimmy MAISTRELLO (Savoieguidage)"
    ]
  },
