  "rdfs:comment": {
    "de": [
      "Als Kletterlehrer und Bergführer bieten wir Ihnen das ganze Jahr über Aktivitäten in der freien Natur in den Tälern von Giffre, Risse, Foron und Chablais an.\r\nGanztägig, halbtägig, am Wochenende oder im Rahmen von Praktika."
    ],
    "en": [
      "As climbing instructors and mountain guides, we offer year-round outdoor activities in the Giffre, Risse, Foron and Chablais valleys.\r\nBy the day, 1/2 day, weekend or during training courses."
    ],
    "it": [
      "Come istruttori di arrampicata e guide alpine, possiamo offrirvi attività all'aperto tutto l'anno nelle valli di Giffre, Risse, Foron e Chablais.\r\nA giornata, 1/2 giornata, weekend o durante i corsi."
    ],
    "fr": [
      "Moniteurs d'escalade et accompagnateur en montagne, nous vous proposons des activités de pleine nature toute l'année dans les vallées du Giffre, du Risse, du Foron et du Chablais.\r\nA la journée, 1/2 journée, week-end ou lors de stages."
    ],
    "es": [
      "Como instructores de escalada y guías de montaña, podemos ofrecerle actividades al aire libre durante todo el año en los valles de Giffre, Risse, Foron y Chablais.\r\nPor el día, 1/2 día, fin de semana o durante los cursos."
    ],
    "nl": [
      "Als kliminstructeurs en berggidsen kunnen we je het hele jaar door outdooractiviteiten aanbieden in de valleien van Giffre, Risse, Foron en Chablais.\r\nPer dag, 1/2 dag, weekend of tijdens cursussen."
    ]
  },
