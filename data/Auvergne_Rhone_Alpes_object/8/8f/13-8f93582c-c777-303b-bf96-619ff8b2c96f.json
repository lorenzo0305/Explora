  "rdfs:comment": {
    "de": [
      "Zum Vergnügen der Kleinsten, nach einer Langlauftour oder einfach für einen lustigen Moment gibt es nichts Besseres als eine kleine Abfahrt auf einer angelegten Rodelbahn!"
    ],
    "en": [
      "After a cross-country ski trek or just for fun, there's nothing like sledding down a snow slope!"
    ],
    "it": [
      "Per il piacere dei più piccoli, dopo una gita di sci di fondo o semplicemente per un momento di svago, non c'è niente di meglio di un po' di slittino su una pista preparata!"
    ],
    "fr": [
      "Pour le plaisirs des plus petits, après une balade en ski de fond ou simplement pour un moment de rigolade, rien de tel qu'une petite descente en luge sur une piste aménagée !"
    ],
    "nl": [
      "Voor het plezier van de kleintjes, na een langlauftocht of gewoon voor een moment van plezier, gaat er niets boven een beetje sleeën op een geprepareerde baan!"
    ],
    "es": [
      "Para el placer de los más pequeños, después de un viaje de esquí de fondo o simplemente para un momento de diversión, ¡no hay nada como un poco de trineo en una pista preparada!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Rodelbahn Les Moises"
    ],
    "en": [
      "Les Moises Sledding Slope"
    ],
    "fr": [
      "Piste de luge des Moises"
    ]
  },
