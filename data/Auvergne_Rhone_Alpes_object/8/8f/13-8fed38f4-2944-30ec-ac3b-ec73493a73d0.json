  "rdfs:comment": {
    "de": [
      "Kayacorde bietet Ihnen ungewöhnliche Familienausflüge, die für Kinder ab 4 Jahren geeignet sind, sowie maßgeschneiderte Multiaktivitätsprogramme: Canyoning, Kanu, Klettern, Via Corda, Via Ferrata und Abenteuerparcours."
    ],
    "en": [
      "Kayacorde offers family outings for children aged 4 and over, with tailor-made programmes of activities including canyoning, canoeing and kayaking, climbing, Via corda, Via ferrata and adventure raids."
    ],
    "it": [
      "Lontano dai sentieri battuti, godetevi un'attività sportiva all'aperto adatta a tutta la famiglia, per adolescenti e bambini dai 4 anni in su: canyoning, canoa, kayak, arrampicata, via corda, via ferrata e raid d'avventura."
    ],
    "fr": [
      "Loin des sentiers battus, profitez d'une sortie sportive de plein air adaptée à toute la famille, pour ados et enfants à partir de 4 ans : Canyoning, Canoë kayak, Escalade, Via corda, Via ferrata et Raid aventure."
    ],
    "nl": [
      "Ver weg van de gebaande paden biedt Kayacorde gezinsuitstapjes voor kinderen vanaf 4 jaar, met op maat gemaakte activiteitenprogramma's zoals canyoning, kanoën en kajakken, klimmen, Via corda, Via ferrata en avontuurlijke raids."
    ],
    "es": [
      "Lejos de los caminos trillados, disfrute en familia de una actividad deportiva al aire libre para adolescentes y niños a partir de 4 años: barranquismo, piragüismo, kayak, escalada, vía corda, vía ferrata y raids de aventura."
    ]
  },
