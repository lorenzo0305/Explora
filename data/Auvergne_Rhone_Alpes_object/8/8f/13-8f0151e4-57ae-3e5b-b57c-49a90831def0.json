  "rdfs:comment": {
    "de": [
      "Le 31, eine englisch inspirierte Oase im Herzen der Stadt. Bei uns wird alles mit Liebe gestaltet und selbst zubereitet. Sie können jeden Tag brunchen ."
    ],
    "en": [
      "Le 31, an English-inspired haven in the heart of the city. Here, everything is lovingly designed and home-cooked. You can brunch every day."
    ],
    "it": [
      "Le 31, un rifugio di ispirazione inglese nel cuore della città. Qui tutto è progettato con amore e cucinato in casa. È possibile fare il brunch tutti i giorni."
    ],
    "fr": [
      "Le 31, un havre d'inspiration anglaise au cœur de la ville. Chez nous, tout est conçu avec amour et préparé maison. Vous pouvez bruncher tous les jours ."
    ],
    "es": [
      "Le 31, un refugio de inspiración inglesa en el corazón de la ciudad. Aquí, todo está diseñado con cariño y es casero. Puedes tomar el brunch todos los días."
    ],
    "nl": [
      "Le 31, een Engels geïnspireerd toevluchtsoord in het hart van de stad. Hier is alles met liefde ontworpen en huisgemaakt. Je kunt hier elke dag brunchen."
    ]
  },
