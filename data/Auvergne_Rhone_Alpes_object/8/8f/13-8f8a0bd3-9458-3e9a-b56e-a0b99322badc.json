  "rdfs:comment": {
    "de": [
      "Das Grand Palais bietet 9 Säle, die alle für Personen mit eingeschränkter Mobilität zugänglich sind.  Das Kino bietet außerdem 2 Säle für 3D-Reliefvorführungen und 2 Premium-Säle (neuer Komfort und neue Technologie)."
    ],
    "en": [
      "The Grand Palais offers 9 screens, all accessible to people with reduced mobility.  The cinema also offers 2 3D projection rooms and 2 premium rooms (new comfort and new technology)."
    ],
    "it": [
      "Il Grand Palais dispone di 9 schermi, tutti accessibili alle persone a mobilità ridotta.  Il cinema dispone anche di 2 sale di proiezione 3D e 2 sale premium (nuovo comfort e nuova tecnologia)."
    ],
    "fr": [
      "Le Grand Palais propose 9 salles toutes accessibles aux personnes à mobilité réduite.  Le cinéma propose également 2 salles pour les projections en relief 3D et 2 salles premium (nouveau confort et nouvelle technologie)."
    ],
    "nl": [
      "Het Grand Palais heeft 9 zalen, allemaal toegankelijk voor mensen met beperkte mobiliteit.  De bioscoop heeft ook 2 3D-projectiezalen en 2 premium zalen (nieuw comfort en nieuwe technologie)."
    ],
    "es": [
      "El Grand Palais cuenta con 9 pantallas, todas accesibles para personas con movilidad reducida.  El cine también cuenta con 2 salas de proyección 3D y 2 salas premium (nuevo confort y nueva tecnología)."
    ]
  },
  "rdfs:label": {
