  "rdfs:comment": {
    "de": [
      "Ein Andenken an Ihren Aufenthalt, eine lokale Geschenkidee für Ihre Freunde, Karten und Topoguides für Ihre Spaziergänge? Entdecken Sie die Boutiquen des Fremdenverkehrsamtes."
    ],
    "en": [
      "A souvenir of your stay, an idea for a local gift for your friends, maps and topoguides for your walks? Come and discover the Tourist Office stores."
    ],
    "it": [
      "Un souvenir del vostro soggiorno, un'idea per un regalo locale per i vostri amici, mappe e topoguide per le vostre passeggiate? Venite a scoprire i negozi dell'Ufficio del Turismo."
    ],
    "fr": [
      "Un souvenir de votre séjour, une idée de cadeau local pour vos amis, des cartes et topoguides pour vos balades ? Venez découvrir Les espaces boutiques de l'Office de Tourisme."
    ],
    "es": [
      "¿Un recuerdo de su estancia, una idea de regalo local para sus amigos, mapas y topoguías para sus paseos? Venga a descubrir las tiendas de la Oficina de Turismo."
    ],
    "nl": [
      "Een souvenir van je verblijf, een idee voor een lokaal cadeau voor je vrienden, kaarten en topogidsen voor je wandelingen? Kom en ontdek de winkels van het VVV-kantoor."
    ]
  },
