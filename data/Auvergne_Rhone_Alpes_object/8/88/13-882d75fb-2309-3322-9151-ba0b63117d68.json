  "rdfs:comment": {
    "de": [
      "Kleine Gerichte und hausgemachtes Gebäck, Eis, Getränke... Verleih von Angelruten und Ködern, um Forellen im Teich zu fangen und den Fang für Ihr Essen mitzunehmen. Schnitzeljagd, Spielbereich für alle Altersgruppen und Animationen/Workshops."
    ],
    "en": [
      "Coffee shop offering assortments of home baked pastries, ice cream, beverages. Trout fishing in the lake is available using  the fishing rods and bait we place at your disposals; take your catch home for dinner."
    ],
    "it": [
      "Piatti e dolci fatti in casa, gelati, bevande... Noleggio di canne ed esche per stuzzicare le trote nel laghetto e portare a casa il pescato per il vostro pasto. Caccia al tesoro, area giochi per tutte le età e attività/laboratori."
    ],
    "fr": [
      "Petits plats et pâtisseries maisons, glaces, boissons... Cannes et appâts en location pour taquiner la truite dans l'étang et emporter les prises pour votre repas. Jeu de piste, zone de jeux tous âges et animations/ateliers."
    ],
    "nl": [
      "Streekgerechten, ijs, drankjes, etc. specialiteiten uit Royans en huisgemaakt gebak en taart. Hengels en lokaas staan tot uw beschikking om de forel in het meer te plagen en de vangst mee te brengen naar uw bord."
    ],
    "es": [
      "Platos caseros y repostería, helados, bebidas... Alquiler de cañas y cebos para pescar truchas en el estanque y llevárselas a casa para comer. Búsqueda del tesoro, zona de juegos para todas las edades y actividades/talleres."
    ]
  },
