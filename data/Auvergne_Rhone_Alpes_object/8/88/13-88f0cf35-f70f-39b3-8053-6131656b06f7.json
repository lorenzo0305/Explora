  "rdfs:comment": {
    "de": [
      "Epicurio bietet Ihnen Mahlzeiten im italienischen Stil mit Freunden oder der Familie. Frische Qualitätsprodukte, hausgemachte Speisen und italienische Aromen. Bar mit musikalischer Atmosphäre, After-Work-Partys, handwerklich gebrautes Bier und Aperitifbretter zum Teilen!"
    ],
    "en": [
      "Epicurio offers you Italian style meals with friends or family. Fresh and quality products, home-made with Italian flavours. Musical atmosphere bar, after-work, craft beers and aperitif boards to share!"
    ],
    "it": [
      "Epicurio vi offre pasti in stile italiano con gli amici o la famiglia. Prodotti freschi e di qualità, fatti in casa con sapori italiani. Bar dall'atmosfera musicale, dopolavoro, birre artigianali e taglieri di aperitivi da condividere!"
    ],
    "fr": [
      "Epicurio vous propose des repas au style italien entre amis ou en famille. Des produits frais et de qualité, du fait maison aux saveurs italiennes. Bar d'ambiance musicale, after-work, bières artisanales et planches apéritives à partager!"
    ],
    "es": [
      "Epicurio le ofrece comidas al estilo italiano con los amigos o la familia. Productos frescos y de calidad, hechos en casa con sabores italianos. Bar de ambiente musical, afterwork, cervezas artesanales y tablas de aperitivos para compartir"
    ],
    "nl": [
      "Epicurio biedt u maaltijden in Italiaanse stijl met vrienden of familie. Verse kwaliteitsproducten, huisgemaakt met Italiaanse smaken. Bar met muzikale sfeer, na het werk, ambachtelijke bieren en aperitiefplanken om te delen!"
    ]
  },
