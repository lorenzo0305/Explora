  "rdfs:comment": {
    "de": [
      "Willkommen im ELIOSPA By SOWELL HÔTELS Mont Blanc & Spa, einem Ort der absoluten Entspannung und Gelassenheit im Herzen von Saint-Gervais.\r\nUnsere Gesichts- und Körperbehandlungen von Sothys versetzen Sie in eine einzigartige Sinneserfahrung."
    ],
    "en": [
      "Welcome to ELIOSPA By SOWELL HÔTELS Mont Blanc & Spa, a place of absolute relaxation and serenity nestled in the heart of Saint-Gervais.\r\nOur signature Sothys face and body treatments transport you into a unique sensory experience."
    ],
    "it": [
      "Benvenuti all'ELIOSPA By SOWELL HÔTELS Mont Blanc & Spa, un luogo di assoluto relax e serenità nel cuore di Saint-Gervais.\r\nI nostri trattamenti viso e corpo firmati Sothys vi trasportano in un'esperienza sensoriale unica."
    ],
    "fr": [
      "Bienvenue chez ELIOSPA By SOWELL HÔTELS Mont Blanc & Spa, un lieu de détente et de sérénité absolue niché au cœur de Saint-Gervais.\r\nNos soins visages et corps signés Sothys transportent dans une expérience sensorielle unique."
    ],
    "nl": [
      "Welkom bij ELIOSPA By SOWELL HÔTELS Mont Blanc & Spa, een plek van absolute ontspanning en sereniteit genesteld in het hart van Saint-Gervais.\r\nOnze kenmerkende gezichts- en lichaamsbehandelingen van Sothys voeren je mee in een unieke zintuiglijke ervaring."
    ],
    "es": [
      "Bienvenido a ELIOSPA By SOWELL HÔTELS Mont Blanc & Spa, un lugar de relajación y serenidad absolutas enclavado en el corazón de Saint-Gervais.\r\nNuestros tratamientos faciales y corporales Sothys le transportarán a una experiencia sensorial única."
    ]
  },
