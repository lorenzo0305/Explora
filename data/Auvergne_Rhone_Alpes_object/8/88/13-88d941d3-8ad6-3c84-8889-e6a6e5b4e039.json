  "rdfs:comment": {
    "de": [
      "Entdecken Sie in einem sehr gemütlichen Rahmen dieses Restaurant mit Spezialitäten aus Savoyen und einer traditionellen französischen Küche, die mit schmackhaften Produkten zubereitet wird. Alles hausgemacht!"
    ],
    "en": [
      "In a very friendly setting, come and discover our restaurant, with its combination of pizzas and traditional French cuisine."
    ],
    "it": [
      "Venite a scoprire questo ristorante che serve specialità savoiarde e cucina tradizionale francese a base di ingredienti deliziosi. Tutto fatto in casa!"
    ],
    "fr": [
      "Dans un cadre très accueillant, venez découvrir ce restaurant de spécialités savoyardes et une cuisine traditionnelle française faite avec de savoureux produits. Que du fait maison !"
    ],
    "es": [
      "Venga a descubrir este restaurante de especialidades saboyanas y cocina tradicional francesa elaborada con deliciosos ingredientes. ¡Todo casero!"
    ],
    "nl": [
      "Kom en ontdek dit restaurant dat Savoyaardse specialiteiten en traditionele Franse gerechten met heerlijke ingrediënten serveert. Alles huisgemaakt!"
    ]
  },
