  "rdfs:comment": {
    "de": [
      "Französische Traditionsküche, savoyische Spezialitäten, Brasserie mit Pauschalen Vorspeise + Hauptgericht oder Hauptgericht + Dessert.\r\nAngemessene Preise."
    ],
    "en": [
      "Traditional French dishes, Savoie specialities, brasserie with set menus (starter + main or main + dessert). Reasonable prices."
    ],
    "it": [
      "In un'atmosfera calda e familiare, venite a rilassarvi e a gustare una cucina tradizionale a base di prodotti freschi preparati sul posto, specialità savoiarde, il nostro Burger e dolci fatti in casa..."
    ],
    "fr": [
      "Dans une ambiance familiale et chaleureuse venez vous détendre et déguster une cuisine traditionnelle de produits frais élaborée sur place, Spécialités Savoyarde,  nos Burger et pâtisseries maison..."
    ],
    "nl": [
      "Kom in een warme en familiale sfeer ontspannen en genieten van een traditionele keuken met ter plaatse bereide verse producten, Savoyaardse specialiteiten, onze Burger en huisgemaakt gebak..."
    ],
    "es": [
      "En un ambiente cálido y familiar, venga a relajarse y a disfrutar de una cocina tradicional de productos frescos preparados al momento, de especialidades saboyanas, de nuestra hamburguesa y de la repostería casera..."
    ]
  },
