    "de": [
      "Auf dem Dorfplatz öffnet das Kulturzentrum Künstlern und Kulturwerkstätten während der Fremdenverkehrssaison seine Tore."
    ],
    "en": [
      "On the village square, the cultural centre opens its doors to artists and cultural workshops during the tourist season."
    ],
    "it": [
      "Nella piazza del paese, il centro culturale apre le porte ad artisti e laboratori culturali durante la stagione turistica."
    ],
    "fr": [
      "Sur la place du village, le centre culturel ouvre ses portes aux artistes ainsi qu'à des ateliers culturels durant la saison touristique."
    ],
