  "rdfs:comment": {
    "de": [
      "Juweliergeschäft und Uhrengeschäft. Verkauf und Reparaturen. Spezialist für mechanische Uhren und antike Pendeluhren. Reparaturwerkstatt: Schmuck, Uhren, antike Pendeluhren, Gravur, Gold-, vergoldete und versilberte Schmuckstücke. Rodania - Boccia - Paco Rabanne."
    ],
    "en": [
      "Jewelry and watches. Sales and repairs. Specialist in mechanical watches and antique clocks. Repair shop: jewelry, watches, antique clocks, engraving, gold, gold-plated and silver jewelry. Rodania - Boccia - Paco Rabanne."
    ],
    "it": [
      "Gioielli e orologi. Vendite e riparazioni. Specialista in orologi meccanici e antichi. Laboratorio di riparazione: gioielli, orologi, orologi antichi, incisioni, gioielli in oro, placcati in oro e argento. Rodania - Boccia - Paco Rabanne."
    ],
    "fr": [
      "Bijouterie et horlogerie. Vente et réparations. Spécialiste montres mécaniques et pendules anciennes. Atelier de réparations : bijoux, montres, pendules anciennes, gravure, bijoux or, plaqué or et argent. Rodania - Boccia - Paco Rabanne."
    ],
    "nl": [
      "Juwelen en horloges. Verkoop en reparaties. Specialist in mechanische horloges en antieke klokken. Reparatiewerkplaats: sieraden, horloges, antieke klokken, graveren, gouden, vergulde en zilveren sieraden. Rodania - Boccia - Paco Rabanne."
    ],
    "es": [
      "Joyas y relojes. Ventas y reparaciones. Especialista en relojes mecánicos y relojes antiguos. Taller de reparación: joyería, relojería, relojes antiguos, grabado, joyas de oro, chapado en oro y plata. Rodania - Boccia - Paco Rabanne."
    ]
  },
