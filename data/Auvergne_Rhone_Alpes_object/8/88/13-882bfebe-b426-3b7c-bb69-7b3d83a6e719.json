          "additionalInformation": {
            "de": [
              "Montag, Dienstag und Donnerstag: 9:00 - 21:00 Uhr\r\nMittwoch und Freitag: 9:00 - 20:00 Uhr\r\nSamstag: 9 - 12.30 Uhr\r\n\r\nÜbliche Schließungen\r\n1 Woche Osterferien (wird auf das Abonnement übertragen), 3 Wochen im August (wird auf das Abonnement übertragen), 1 Woche Weihnachtsferien (wird auf das Abonnement übertragen) und alle Feiertage."
            ],
            "en": [
              "Monday, Tuesday and Thursday: 9am - 9pm\r\nWednesday and Friday: 9 am - 8 pm\r\nSaturday: 9 am - 12.30 pm\r\n\r\nUsual closures\r\n1 week Easter holidays (included in the subscription), 3 weeks in August (included in the subscription), 1 week Christmas holidays (included in the subscription) and all public holidays."
            ],
            "it": [
              "Lunedì, martedì e giovedì: dalle 9.00 alle 21.00\r\nMercoledì e venerdì: dalle 9.00 alle 20.00\r\nSabato: dalle 9:00 alle 12:30\r\n\r\nChiusure abituali\r\n1 settimana di vacanze di Pasqua (da riportare sull'abbonamento), 3 settimane di agosto (da riportare sull'abbonamento), 1 settimana di vacanze di Natale (da riportare sull'abbonamento) e tutti i giorni festivi."
            ],
            "fr": [
              "Lundi, mardi et jeudi : 9h – 21h\r\nMercredi et vendredi : 9h – 20h\r\nSamedi : 9h – 12h30\r\n\r\nFermetures habituelles\r\n1 semaine vacances de Pâques (reportée sur l'abonnement), 3 semaines en août (reportées sur l'abonnement), 1 semaine vacances de Noël (reportée sur l'abonnement) et tous les jours fériés."
            ],
            "nl": [
              "Maandag, dinsdag en donderdag: 9.00 - 21.00 uur\r\nWoensdag en vrijdag: 9.00 - 20.00 uur\r\nZaterdag: 9.00 - 12.30 uur\r\n\r\nGebruikelijke sluitingen\r\n1 week paasvakantie (overgedragen naar het abonnement), 3 weken in augustus (overgedragen naar het abonnement), 1 week kerstvakantie (overgedragen naar het abonnement) en alle feestdagen."
            ],
            "es": [
              "Lunes, martes y jueves: de 9 a 21 horas\r\nMiércoles y viernes: de 9 a 20 horas\r\nSábado: de 9:00 a 12:30\r\n\r\nCierres habituales\r\n1 semana de vacaciones de Semana Santa (se traslada al abono), 3 semanas en agosto (se traslada al abono), 1 semana de vacaciones de Navidad (se traslada al abono) y todos los días festivos."
            ]
          },
