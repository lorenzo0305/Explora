  "rdfs:comment": {
    "de": [
      "RDV in Chamrousse 1650 - Recoin für ein Großereignis und einen Höhepunkt der Feierlichkeiten am Montagnachmittag, den 16. März 2026, mit der Rückkehr der paralympischen Flagge und der französischen Mannschaft nach den Paralympischen Winterspielen in Mailand-Cortina 2026."
    ],
    "en": [
      "Join us at Chamrousse 1650 - Recoin for a major event and a moment of celebration, on Monday afternoon, March 16, 2026, with the return of the Paralympic flag and the French Team, at the conclusion of the Milan-Cortina 2026 Paralympic Winter Games."
    ],
    "it": [
      "Unitevi a noi a Chamrousse 1650 - Recoin per un grande evento e un momento di festa, lunedì 16 marzo 2026 nel pomeriggio e nella serata, con il ritorno della bandiera paralimpica e della squadra francese, a conclusione dei Giochi Paralimpici Invernali di Milano-Cortina."
    ],
    "fr": [
      "RDV à Chamrousse 1650 - Recoin pour un événement majeur et un moment fort de célébration, lundi 16 mars 2026 après-midi et soir, avec le retour du drapeau paralympique et de l’Équipe de France, à l’issue des Jeux Paralympiques d’hiver de Milan-Cortina."
    ],
    "es": [
      "Únase a nosotros en Chamrousse 1650 - Recoin para un gran evento y un momento de celebración, el lunes 16 de marzo de 2026 por la tarde y por la noche, con el regreso de la bandera paralímpica y el Equipo Francés, en la conclusión de los Juegos Paralímpicos de Invierno de Milán-Cortina."
    ],
    "nl": [
      "Kom op maandag 16 maart 2026 's middags en 's avonds naar Chamrousse 1650 - Recoin voor een belangrijke gebeurtenis en een feestelijk moment, met de terugkeer van de Paralympische vlag en het Franse team, ter afsluiting van de Paralympische Winterspelen Milaan-Cortina."
    ]
  },
  "rdfs:label": {
    "de": [
      "Rückkehr der französischen Mannschaft und der Paralympischen Flagge nach Chamrousse"
    ],
    "en": [
      "The French team and the Paralympic flag return to Chamrousse"
    ],
    "fr": [
      "Retour de l’Équipe de France et du drapeau paralympique à Chamrousse"
    ]
  },
