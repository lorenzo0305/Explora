  "rdfs:comment": {
    "de": [
      "Entdecken Sie das emblematische Café-Concert in Bourg-Saint-Andéol! Ein gemütlicher, geselliger und musikalischer Ort am Ufer der Rhône. Lokale Weine, hausgemachte Cocktails, frisch gezapfte Biere und Feinschmeckerbretter zum Probieren! Das ganze Jahr über ein abwechslungsreiches künstlerisches Programm."
    ],
    "en": [
      "Discover the emblematic café-concert in Bourg-Saint-Andéol! A warm, friendly and musical space on the banks of the Rhône. Local wines, house cocktails, draught beers and gourmet platters to sample! Diverse artistic program all year round."
    ],
    "it": [
      "Scoprite l'emblematico caffè concerto di Bourg-Saint-Andéol! Uno spazio caldo, accogliente e musicale sulle rive del Rodano. Vini locali, cocktail fatti in casa, birre alla spina, piatti gourmet da gustare! Programma artistico diversificato tutto l'anno."
    ],
    "fr": [
      "Découvrez l’emblématique café-concert de Bourg-Saint-Andéol! Un espace chaleureux, convivial et musical au bord du Rhône. Vins locaux, cocktails maisons, bières pression, planches gourmandes à déguster! Programmation artistique diversifiée toute l’année."
    ],
    "es": [
      "¡Descubra el emblemático café concierto de Bourg-Saint-Andéol! Un espacio cálido, acogedor y musical a orillas del Ródano. ¡Vinos locales, cócteles caseros, cervezas de barril, platos gastronómicos para degustar! Programa artístico diversificado durante todo el año."
    ],
    "nl": [
      "Ontdek het mythische concertcafé in Bourg-Saint-Andéol! Een warme, vriendelijke en muzikale plek aan de oevers van de Rhône. Lokale wijnen, huiscocktails, bieren van het vat en gastronomische schotels ! Het hele jaar door een gevarieerd artistiek programma."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Alcazar - Concert"
    ]
  },
