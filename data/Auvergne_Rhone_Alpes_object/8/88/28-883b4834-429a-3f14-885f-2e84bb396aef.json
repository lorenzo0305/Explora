  "rdfs:comment": {
    "de": [
      "In einem typisch orientalischen und gemütlichen Raum bietet Ihnen der Palais de Marrakech eine abwechslungsreiche Küche: Couscous, Tagine, Pastilla, Minztee. Zum Verzehr vor Ort oder zum Mitnehmen. Empfang von Gruppen bis zu 90 Personen."
    ],
    "en": [
      "In a typically oriental and warm space, the Palais de Marrakech offers you a varied cuisine: couscous, tagine, pastilla, mint tea. To be consumed on the spot or to take away. Reception of groups up to 90 people."
    ],
    "it": [
      "In uno spazio tipicamente orientale e caldo, il Palais de Marrakech vi offre una cucina varia: couscous, tagine, pastilla, tè alla menta. Da mangiare o da portare via. È possibile ospitare gruppi fino a 90 persone."
    ],
    "fr": [
      "Dans un espace typiquement oriental et chaleureux, le Palais de Marrakech vous propose une cuisine variée : couscous, tagine, pastilla, thé à la menthe. A consommer sur place ou à emporter. Accueil de groupes jusqu’à 90 personnes."
    ],
    "nl": [
      "In een typisch oosterse en warme ruimte biedt het Palais de Marrakech u een gevarieerde keuken: couscous, tajine, pastilla, muntthee. Om op te eten of mee te nemen. Groepen tot 90 personen kunnen worden ontvangen."
    ],
    "es": [
      "En un espacio típicamente oriental y cálido, el Palais de Marrakech le ofrece una cocina variada: cuscús, tagine, pastilla, té a la menta. Para comer en casa o para llevar. Se pueden acomodar grupos de hasta 90 personas."
    ]
  },
