  "rdfs:comment": {
    "de": [
      "Erleben Sie die Freuden des freien Falls bei einem Tandemsprung aus einem Flugzeug aus 3500 Metern Höhe über den Schluchten der Ardèche."
    ],
    "en": [
      "Come and taste the joys of free fall by jumping from a tandem plane 3,500 meters above the Gorges de l'Ardèche."
    ],
    "it": [
      "Venite a provare le gioie della caduta libera lanciandovi da un aereo in tandem a 3500 metri di altezza sopra le Gorges de l'Ardèche."
    ],
    "fr": [
      "Venez goûter aux joies de la chute libre en sautant d'un avion en tandem à 3500 mètres au dessus des Gorges de l'Ardèche."
    ],
    "nl": [
      "Kom genieten van een  vrije val door te springen van een tandem, 3.500 meter boven de Ardèche Gorges."
    ],
    "es": [
      "Experimente el placer de la caída libre saltando desde un avión biplaza a 3.500 metros de altura sobre las Gargantas del Ardèche."
    ]
  },
