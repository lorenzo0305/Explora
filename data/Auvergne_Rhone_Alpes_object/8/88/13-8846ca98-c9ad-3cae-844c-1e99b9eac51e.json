  "rdfs:comment": {
    "de": [
      "Eine gesicherte Rodelbahn, gesäumt von kostenlosen Förderbändern, die den Aufstieg erleichtern (die Förderbänder sind Skilifte und daher derzeit geschlossen)"
    ],
    "en": [
      "Safe sledge piste, with free conveyor belts which made it easier to go up slopes.(the carpets are ski lifts and are therefore currently closed)"
    ],
    "it": [
      "Una pista da slittino sicura, fiancheggiata da nastri trasportatori gratuiti per facilitare la salita (i nastri sono impianti di risalita e quindi attualmente chiusi)"
    ],
    "fr": [
      "Une piste de luge sécurisée, bordée de tapis roulants gratuits qui facilitent la remontée (les tapis sont des remontées mécaniques et sont donc actuellement fermés)"
    ],
    "es": [
      "Una pista de trineo segura, bordeada de cintas transportadoras gratuitas para facilitar el ascenso (las cintas son remontes mecánicos, por lo que actualmente están cerradas)"
    ],
    "nl": [
      "Een beveiligde sleepiste uitgerust met rolbanden om moeiteloos omhoog te lopen. (de tapijten zijn skiliften en zijn daarom momenteel gesloten)"
    ]
  },
