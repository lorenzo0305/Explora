  "rdfs:comment": {
    "de": [
      "Herstellung von Alltagsgegenständen (sowohl Gebrauchs- als auch Dekorationsgegenstände) und Einzelstücken aus glasierter Erde. Möglichkeit der Herstellung auf Bestellung. Ich biete auch ganzjährige Kurse und Praktika an."
    ],
    "en": [
      "Creation of everyday objects (both utilitarian and decorative) and unique pieces. Possibility of making to order. Isabelle Gatineau also offers year-round courses and workshops."
    ],
    "it": [
      "Creazione di oggetti di uso quotidiano (sia utilitari che decorativi) e di pezzi unici in argilla smaltata. Possibilità di realizzare su ordinazione. Offro anche corsi e workshop durante tutto l'anno."
    ],
    "fr": [
      "Réalisation d'objets du quotidien ( à la fois utilitaires et décoratifs) et de pièces uniques en terre vernissée . Possibilité de réalisations sur commande. Je propose également des cours à l'année et des stages."
    ],
    "nl": [
      "Maken van alledaagse voorwerpen (zowel gebruiks- als siervoorwerpen) en unieke stukken in geglazuurde klei. Mogelijkheid om op bestelling te maken. Ik bied ook het hele jaar door cursussen en workshops aan."
    ],
    "es": [
      "Creación de objetos cotidianos (utilitarios y decorativos) y piezas únicas en arcilla vidriada. Posibilidad de hacer por encargo. También ofrezco cursos y talleres durante todo el año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poterie de la Croisette"
    ]
  },
