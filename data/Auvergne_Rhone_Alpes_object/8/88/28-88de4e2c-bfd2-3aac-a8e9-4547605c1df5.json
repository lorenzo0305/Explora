  "rdfs:comment": {
    "de": [
      "Catherine und Hubert halten ca. 30 Milchkühe auf 45 ha Land, das für die Fütterung der Tiere bestimmt ist. Sie produzieren und verkaufen eine Reihe von Bio-Milchprodukten (Butter, Sahne, Quark und Joghurt), die in ihrem Laden erhältlich sind."
    ],
    "en": [
      "Catherine and Hubert raise around 30 dairy cows on 45 hectares of land dedicated to feeding the animals. They produce and sell a full range of organic dairy products (butter, crème fraîche, fromage frais and yoghurts), available in their store."
    ],
    "it": [
      "Catherine e Hubert allevano una trentina di mucche da latte su 45 ettari di terreno utilizzati per l'alimentazione degli animali. Producono e vendono un'intera gamma di prodotti caseari biologici (burro, crème fraîche, fromage frais e yogurt), disponibili nel loro negozio."
    ],
    "fr": [
      "Catherine et Hubert élèvent une trentaine de vaches laitières sur 45 ha de terres destinées à l’alimentation des bêtes. Ils produisent et vendent toute une gamme de produits laitiers bio (beurre, crème fraîche, fromage blanc et yaourts), disponibles dans leur magasin."
    ],
    "es": [
      "Catherine y Hubert crían una treintena de vacas lecheras en 45 hectáreas de terreno destinadas a la alimentación de los animales. Producen y venden toda una gama de productos lácteos ecológicos (mantequilla, crème fraîche, fromage frais y yogures), disponibles en su tienda."
    ],
    "nl": [
      "Catherine en Hubert houden een dertigtal melkkoeien op 45 hectare land dat gebruikt wordt om de dieren te voederen. Ze produceren en verkopen een hele reeks biologische zuivelproducten (boter, crème fraîche, fromage frais en yoghurt), verkrijgbaar in hun winkel."
    ]
  },
