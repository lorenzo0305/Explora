  "rdfs:comment": {
    "de": [
      "Die Ferme du Val Fleury produziert und bietet natürlichen oder aromatisierten Joghurt, Dessertcremes sowie Eier, Mehl und Hacksteaks an, alles zertifiziert aus ökologischem Landbau. Erhältlich bei AlterMonts (Saint-Denis-sur-Coise)."
    ],
    "en": [
      "Ferme du Val Fleury produces and sells plain and flavored yogurts, cream desserts, as well as eggs, flour and minced steaks, all certified organic. On sale at AlterMonts (Saint-Denis-sur-Coise)."
    ],
    "it": [
      "La Ferme du Val Fleury produce e vende yogurt semplici e aromatizzati, dessert alla crema, uova, farina e bistecche macinate, tutti certificati biologici. In vendita presso AlterMonts (Saint-Denis-sur-Coise)."
    ],
    "fr": [
      "La Ferme du Val Fleury  produit et propose des yaourts natures ou aromatisés, des crèmes desserts ainsi que des œufs, de la farine et des steaks hachés, le tout certifiés en agriculture biologique. En vente à AlterMonts (Saint-Denis-sur-Coise)."
    ],
    "nl": [
      "Ferme du Val Fleury produceert en verkoopt gewone en gearomatiseerde yoghurt, roomdesserts, eieren, bloem en gehakt, allemaal biologisch gecertificeerd. Te koop bij AlterMonts (Saint-Denis-sur-Coise)."
    ],
    "es": [
      "Ferme du Val Fleury produce y vende yogures naturales y aromatizados, postres de nata, huevos, harina y carne picada, todo ello con certificación ecológica. A la venta en AlterMonts (Saint-Denis-sur-Coise)."
    ]
  },
  "rdfs:label": {
