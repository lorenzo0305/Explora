  "rdfs:comment": {
    "de": [
      "Die Stadt Le Puy-en-Velay besitzt zwei Bauwerke, die zum Weltkulturerbe der UNESCO im Rahmen der Jakobswege gehören: den Kathedralenkomplex und das Hôtel-Dieu. Kostenpflichtige Besichtigung, Anmeldung erforderlich."
    ],
    "en": [
      "The town of Le Puy-en-Velay has two monuments listed as World Heritage Sites by Unesco as part of the Pilgrim's Way to Santiago de Compostela: the cathedral complex and the Hôtel-Dieu. Visits subject to charge and registration."
    ],
    "it": [
      "La città di Le Puy-en-Velay possiede due monumenti dichiarati Patrimonio dell'Umanità dall'UNESCO come parte del Cammino di Santiago de Compostela: il complesso della cattedrale e l'Hôtel-Dieu. Visite a pagamento e previa registrazione."
    ],
    "fr": [
      "La ville du Puy-en-Velay a deux monuments classés patrimoine mondial de l'Humanité, inscrits au Patrimoine Mondial de l'Unesco au titre des Chemins de Saint-Jacques de Compostelle : l'ensemble cathédral et l'Hôtel-Dieu. Visite payante, sur inscription."
    ],
    "es": [
      "La ciudad de Le Puy-en-Velay cuenta con dos monumentos declarados Patrimonio de la Humanidad por la UNESCO en el marco del Camino de Santiago: el conjunto catedralicio y el Hôtel-Dieu. Visitas sujetas a pago e inscripción."
    ],
    "nl": [
      "De stad Le Puy-en-Velay heeft twee monumenten die op de Werelderfgoedlijst van UNESCO staan als onderdeel van de Camino de Santiago de Compostela: het kathedraalcomplex en het Hôtel-Dieu. Bezoek tegen betaling en registratie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée des trésors UNESCO : cathédrale, Hôtel-Dieu et sa pharmacie XIXe"
    ]
  },
