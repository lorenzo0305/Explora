  "rdfs:comment": {
    "de": [
      "Inspiriert von echten \"Diners\" trifft die musikalische Atmosphäre auf eine sorgfältige Dekoration, die mit einem typisch amerikanischen Menü zum Teilen verbunden ist. Memphis bietet Ihnen eine umfangreiche Speisekarte mit exklusiven amerikanischen Rezepten, die aus hochwertigen Produkten zubereitet werden."
    ],
    "en": [
      "Inspired by real diners, the musical ambience is matched by meticulous decoration and a typically American menu to share. Memphis offers an extensive menu of exclusive American recipes, made with quality ingredients."
    ],
    "it": [
      "Ispirata a veri e propri commensali, l'atmosfera musicale si combina con una decorazione meticolosa e un menu tipicamente americano da condividere. Memphis offre un'ampia gamma di ricette americane esclusive, realizzate con prodotti di qualità."
    ],
    "fr": [
      "Inspirée des véritables “diners”, l’ambiance musicale rejoint une décoration minutieuse couplée à un menu typiquement américain à partager. Memphis vous propose une large carte de recettes américaines exclusives, réalisées avec des produits de qualité."
    ],
    "es": [
      "Inspirado en los comedores reales, el ambiente musical se combina con una cuidada decoración y un menú típicamente americano para compartir. Memphis ofrece una amplia gama de exclusivas recetas americanas, elaboradas con productos de calidad."
    ],
    "nl": [
      "Geïnspireerd door echte diners wordt de muzikale ambiance gecombineerd met een zorgvuldige decoratie en een typisch Amerikaans menu om te delen. Memphis biedt een uitgebreid menu met exclusieve Amerikaanse recepten, bereid met kwaliteitsproducten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Memphis"
    ]
  },
