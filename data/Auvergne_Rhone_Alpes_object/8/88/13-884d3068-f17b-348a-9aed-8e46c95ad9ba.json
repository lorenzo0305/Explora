  "rdfs:comment": {
    "de": [
      "Gravity 1650 (ehemals Le Grillon), das erst kürzlich renoviert wurde, empfängt Sie mit einer warmen und freundlichen Atmosphäre unter der Leitung des neuen Geschäftsführers!"
    ],
    "en": [
      "Gravity 1650 (formerly Le Grillon), recently renovated, welcomes you in a warm and friendly atmosphere, under the direction of its new manager!"
    ],
    "it": [
      "Il Gravity 1650 (ex Le Grillon) è stato recentemente rinnovato e ora vanta un'atmosfera calda e accogliente, sotto la direzione del suo nuovo gestore!"
    ],
    "fr": [
      "Gravity 1650 (ex. Le Grillon), tout récemment rénové, vous accueille avec une ambiance chaleureuse et conviviale, sous la direction de son nouveau gérant !"
    ],
    "nl": [
      "Gravity 1650 (voorheen Le Grillon) is onlangs gerenoveerd en heeft nu een warme en gezellige sfeer, onder leiding van de nieuwe manager!"
    ],
    "es": [
      "Gravity 1650 (antes Le Grillon) ha sido reformado recientemente y ahora cuenta con un ambiente cálido y acogedor, bajo la dirección de su nuevo gerente"
    ]
  },
