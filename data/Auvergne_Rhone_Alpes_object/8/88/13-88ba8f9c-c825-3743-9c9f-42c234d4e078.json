  "rdfs:comment": {
    "de": [
      "Pizzeria LE SPOT bietet Ihnen seit 2012 eine große Auswahl an hausgemachten Pizzen und eine Auswahl an frittierten Snacks zum Mitnehmen oder nach Hause geliefert.\r\nUnser Automat mit hausgemachten Paninis steht Ihnen 24/7 zur Verfügung."
    ],
    "en": [
      "LE SPOT propose you a great choice of home-made pizzas and finger snacks for take-away or delivery since 2012.\r\nOur home-made paninis’ vending machine is at your service 24/7."
    ],
    "it": [
      "La Pizzeria LE SPOT offre un'ampia scelta di pizze fatte in casa e una selezione di snack fritti da asporto o da consegnare a domicilio dal 2012.\r\nIl nostro distributore automatico di panini fatti in casa è a vostra disposizione 24 ore su 24, 7 giorni su 7."
    ],
    "fr": [
      "Pizzeria LE SPOT vous propose un large choix de pizzas fait maison et une sélection de snacks frits à emporter ou livré à domicile depuis 2012.\r\nNotre distributeur automatique de paninis maison est à votre disposition 24/7."
    ],
    "nl": [
      "Pizzeria LE SPOT biedt sinds 2012 een ruime keuze aan huisgemaakte pizza's en een selectie gefrituurde snacks om mee te nemen of thuis te bezorgen.\r\nOnze huisgemaakte panini-automaat staat 24/7 tot uw beschikking."
    ],
    "es": [
      "Pizzería LE SPOT ofrece una amplia selección de pizzas caseras y una selección de bocadillos fritos para llevar o entregar a domicilio desde 2012.\r\nNuestra máquina expendedora de paninis caseros está a su disposición las 24 horas del día."
    ]
  },
