  "rdfs:comment": {
    "de": [
      "Vanessa und Franck bieten Ihnen seit über 10 Jahren in ihrem charmanten Restaurant in VIRIAT, 5 Minuten vom Zentrum von Bourg-en-Bresse (Präfektur von AIN 01) entfernt, eine traditionelle Küche mit ständig überarbeiteten Vorschlägen an."
    ],
    "en": [
      "Vanessa and Franck have been offering you for more than 10 years in their charming restaurant in VIRIAT, 5 minutes from the center of Bourg-en-Bresse (Prefecture of AIN 01), a traditional cuisine made of constantly revised suggestions."
    ],
    "it": [
      "Vanessa e Franck vi propongono da oltre 10 anni una cucina tradizionale nel loro incantevole ristorante di VIRIAT, a 5 minuti dal centro di Bourg-en-Bresse (Prefettura di AIN 01), con proposte costantemente rivisitate."
    ],
    "fr": [
      "Vanessa et Franck vous proposent depuis plus de 10 ans dans leur charmant restaurant de VIRIAT à 5 mn du centre de Bourg-en-Bresse (Préfecture de L’AIN 01) une cuisine traditionnelle faite de suggestions sans cesse revisitées."
    ],
    "es": [
      "Vanessa y Franck le ofrecen desde hace más de 10 años una cocina tradicional en su encantador restaurante de VIRIAT, a 5 minutos del centro de Bourg-en-Bresse (Prefectura de AIN 01), con sugerencias que se revisan constantemente."
    ],
    "nl": [
      "Vanessa en Franck serveren al meer dan 10 jaar traditionele gerechten in hun charmante restaurant in VIRIAT, op 5 minuten van het centrum van Bourg-en-Bresse (prefectuur van AIN 01), met voortdurend herziene suggesties."
    ]
  },
