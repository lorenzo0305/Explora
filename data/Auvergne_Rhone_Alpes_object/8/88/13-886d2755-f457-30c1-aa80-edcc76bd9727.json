  "rdfs:comment": {
    "de": [
      "Karine, eine Bergbegleiterin, kennt das Tal wie keine andere! Sie hat die großen Bergmassive der Welt durchwandert: Peru, Ecuador, Nepal und einen großen Teil des Alpenbogens. Kommen Sie und teilen Sie ihre gute Laune und ihre Leidenschaft für die Naturheilkunde."
    ],
    "en": [
      "Karine, a mountain guide, knows the valley like the back of her hand! She has travelled the world's great mountain ranges: Peru, Ecuador, Nepal and a large part of the Alps. Come and share her good humour and her passion for naturopathy."
    ],
    "it": [
      "Karine, guida alpina, conosce la valle come le sue tasche! Ha percorso le grandi catene montuose del mondo: Perù, Ecuador, Nepal e gran parte delle Alpi. Venite a condividere il suo buon umore e la sua passione per la naturopatia."
    ],
    "fr": [
      "Karine, accompagnatrice en montagne, a une connaissance de la vallée hors pair ! Elle a parcouru les grands massifs du monde : Pérou, Equateur, Népal et une grande partie de l'arc alpin. Venez partager sa bonne humeur et sa passion pour la naturopathie."
    ],
    "es": [
      "Karine, guía de montaña, conoce el valle como la palma de su mano Ha recorrido las grandes cordilleras del mundo: Perú, Ecuador, Nepal y gran parte de los Alpes. Venga a compartir su buen humor y su pasión por la naturopatía."
    ],
    "nl": [
      "Karine, een berggids, kent de vallei op haar duimpje! Ze heeft de grote bergketens van de wereld bereisd: Peru, Ecuador, Nepal en een groot deel van de Alpen. Kom en deel haar goede humeur en haar passie voor natuurgeneeskunde."
    ]
  },
  "rdfs:label": {
    "en": [
      "Karine Routin - Mountain guide"
    ],
    "fr": [
      "Karine Routin - Accompagnatrice en montagne"
    ],
    "nl": [
      "Karine Routin - Berggids"
    ]
  },
