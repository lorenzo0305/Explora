  "rdfs:comment": {
    "de": [
      "Ein legendärer Veranstaltungsort für Familien, in dem Musik jeden Moment bestimmt. Von Live-Konzerten über kreative Cocktails bis hin zu feurigen Nächten – erleben Sie ein einzigartiges Studioerlebnis."
    ],
    "en": [
      "An iconic venue where music guides every moment. From live concerts to creative cocktails and fiery nights, experience a unique studio experience."
    ],
    "it": [
      "Un luogo iconico dove la musica guida ogni momento. Dai concerti dal vivo ai cocktail creativi, fino alle serate infuocate, vivi un'esperienza in studio unica."
    ],
    "fr": [
      "Un lieu emblématique où la musique guide chaque moment. Entre concerts live, cocktails créatifs et nuits enflammées, vivez une expérience studio unique."
    ],
    "es": [
      "Un lugar emblemático donde la música guía cada momento. Conciertos en directo, cócteles creativos y una vida nocturna desenfrenada conforman una experiencia de estudio única."
    ],
    "nl": [
      "Een iconische locatie waar muziek elk moment bepaalt. Van liveconcerten tot creatieve cocktails en vurige nachten: ervaar een unieke studio-ervaring."
    ]
  },
