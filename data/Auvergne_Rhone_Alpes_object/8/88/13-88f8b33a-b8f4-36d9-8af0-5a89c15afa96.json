  "rdfs:comment": {
    "de": [
      "Auf dem Weg zum Erfolg kümmert sie sich halbtags um eine Mini-Wohngemeinschaft mit gemeinsamem Sorgerecht und nimmt uns mit auf ihre Abenteuer als fast perfekte Mutter."
    ],
    "en": [
      "On her way to success, she looks after a mini-flatmate part-time, and takes us along on her adventures as a near-perfect mother."
    ],
    "it": [
      "Sulla strada del successo, si occupa di un mini appartamento in condivisione part-time e ci accompagna nelle sue avventure di madre quasi perfetta."
    ],
    "fr": [
      "Sur le chemin du succès, elle s'occupe à mi-temps d'un mini-coloc en garde partagée et nous emmène dans ses aventures de mère presque parfaite."
    ],
    "nl": [
      "Op weg naar succes zorgt ze parttime voor een mini-flat en neemt ze ons mee op haar avonturen als bijna-perfecte moeder."
    ],
    "es": [
      "En su camino hacia el éxito, cuida a tiempo parcial de un minipiso compartido y nos acompaña en sus aventuras como madre casi perfecta."
    ]
  },
  "rdfs:label": {
    "fr": [
