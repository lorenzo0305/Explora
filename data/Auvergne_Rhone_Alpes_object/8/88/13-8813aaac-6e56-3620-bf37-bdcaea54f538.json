  "rdfs:comment": {
    "de": [
      "Die im 15. Jahrhundert erbauten Markthallen von Virieu wurden 1816 wieder aufgebaut, nachdem sie 1793 eingestürzt waren."
    ],
    "en": [
      "Built in the 15th century, Virieu's covered market was rebuilt in 1816 after collapsing in 1793."
    ],
    "it": [
      "Costruito nel XV secolo, il mercato coperto di Virieu fu ricostruito nel 1816 dopo il crollo del 1793."
    ],
    "fr": [
      "Construites au XVe siècle, les halles de Virieu ont été reconstruites en 1816 après leur écroulement en 1793."
    ],
    "nl": [
      "De overdekte markt van Virieu werd in de 15e eeuw gebouwd en werd in 1816 herbouwd nadat hij in 1793 instortte."
    ],
    "es": [
      "Construido en el siglo XV, el mercado cubierto de Virieu fue reconstruido en 1816 tras derrumbarse en 1793."
    ]
