  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/95635c7f-4ac4-3563-9faf-6707c8bbbe03",
      "dc:description": {
        "de": [
          "Lav Dose bietet für Gewerbetreibende, öffentliche Einrichtungen und Privatpersonen eine breite Palette an Reinigungsgeräten, Hygiene- und Pflegeprodukten sowie persönlicher Schutzausrüstung an.\n\nJAHRESSCHLUSS IM AUGUST"
        ],
        "en": [
          "Lav Dose offers a wide range of cleaning equipment, hygiene and maintenance products, and personal protective equipment for professionals, local authorities and private individuals.\n\nANNUAL CLOSURE IN AUGUST"
        ],
        "it": [
          "Lav Dose offre un'ampia gamma di attrezzature per la pulizia, prodotti per l'igiene e la manutenzione e dispositivi di protezione individuale per professionisti, enti locali e privati.\n\nCHIUSURA ANNUALE IN AGOSTO"
        ],
        "fr": [
          "Lav Dose propose pour les Professionnels, Collectivités et Particuliers une large gamme de matériels de nettoyage, de produits d'hygiène et d'entretien, et d'équipements de protection individuelle.\n\nFERMETURE ANNUELLE AU MOIS D'AOUT"
        ],
        "es": [
          "Lav Dose ofrece una amplia gama de equipos de limpieza, productos de higiene y mantenimiento y equipos de protección individual para profesionales, autoridades locales y particulares.\n\nCIERRE ANUAL EN AGOSTO"
        ],
        "nl": [
          "Lav Dose biedt een breed assortiment schoonmaakapparatuur, hygiëne- en onderhoudsproducten en persoonlijke beschermingsmiddelen voor professionals, lokale overheden en particulieren.\n\nJAARLIJKSE SLUITING IN AUGUSTUS"
        ]
      },
      "@type": [
        "Description"
      ],
