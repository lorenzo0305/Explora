  "rdfs:comment": {
    "de": [
      "150 Meter über dem Boden schwebend, zeigt sich dieses Lokal als das Gourmetrestaurant mit einer der schönsten und außergewöhnlichsten Aussichten Lyons."
    ],
    "en": [
      "The Celest Bar & Restaurant offers what is, without a doubt, one of the best view of the city. In this unique setting, discover a mixture of flavours cooked with care and respect with local and fresh products."
    ],
    "it": [
      "Sospeso a 150 metri di altezza, questo è il ristorante gourmet con una delle viste più belle ed eccezionali di Lione."
    ],
    "fr": [
      "Suspendu à 150 mètres au-dessus du sol, cet établissement se montre comme le restaurant gastronomique offrant l'une des plus belles et exceptionnelles vues de Lyon."
    ],
    "es": [
      "Suspendido a 150 metros del suelo, es el restaurante gastronómico con una de las vistas más bellas y excepcionales de Lyon."
    ],
    "nl": [
      "Dit gastronomische restaurant hangt 150 meter boven de grond en heeft een van de mooiste en meest uitzonderlijke uitzichten van Lyon."
    ]
  },
