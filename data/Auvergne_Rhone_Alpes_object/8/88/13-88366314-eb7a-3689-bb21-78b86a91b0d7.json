  "rdfs:comment": {
    "de": [
      "L'Avancher: Ein Kokon im Herzen von Val d'Isère, in dem sich der Geist eines Chalets mit modernem Komfort verbindet, um Ihren Aufenthalt einfach unvergesslich zu machen."
    ],
    "en": [
      "L’Avancher: a cozy haven in the heart of Val d’Isère, where chalet charm meets modern comfort for a truly unforgettable stay."
    ],
    "it": [
      "L'Avancher: un bozzolo nel cuore della Val d'Isère, dove lo spirito dello chalet si fonde con il comfort moderno per un soggiorno semplicemente indimenticabile."
    ],
    "fr": [
      "L’Avancher : un cocon au cœur de Val d’Isère, où l’esprit chalet se marie au confort moderne pour un séjour tout simplement inoubliable."
    ],
    "es": [
      "L'Avancher: un capullo en el corazón de Val d'Isère, donde el espíritu de chalet se mezcla con las comodidades modernas para una estancia sencillamente inolvidable."
    ],
    "nl": [
      "L'Avancher: een cocon in het hart van Val d'Isère, waar de sfeer van een chalet wordt gecombineerd met modern comfort voor een onvergetelijk verblijf."
    ]
  },
