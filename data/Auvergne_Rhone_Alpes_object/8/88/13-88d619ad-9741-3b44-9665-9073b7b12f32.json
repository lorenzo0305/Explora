  "rdfs:comment": {
    "de": [
      "Im Regionalpark Monts d'Ardèche, im Herzen eines Cevennen-Anwesens mit Blick auf das mittelalterliche Dorf Largentière, heißen wir Sie gerne in unserem alten, charaktervollen Mas willkommen."
    ],
    "en": [
      "Our eatery in the heart of a Cévennes property in Ardèche Mountains Regional Park overlooks the medieval village of Largentière. We'd love to see you in our old farmhouse oozing personality."
    ],
    "it": [
      "Nel Parco Regionale dei Monts d'Ardèche, nel cuore di una proprietà delle Cévennes che domina il villaggio medievale di Largentière, saremo lieti di accogliervi nel nostro antico Mas de caractère."
    ],
    "fr": [
      "Dans le Parc Régional des Monts d’Ardèche, au cœur d’une propriété cévenole dominant le village médiéval de Largentière, nous vous accueillerons avec plaisir dans notre vieux Mas de caractère."
    ],
    "nl": [
      "In het regionale park van de Monts d'Ardèche, in het hart van een landgoed in de Cevennen met uitzicht op het middeleeuwse dorp Largentière, heten wij u van harte welkom in onze oude Mas de caractère."
    ],
    "es": [
      "En el Parque Regional de los Montes de Ardèche, en el corazón de una propiedad de las Cévennes con vistas al pueblo medieval de Largentière, estaremos encantados de recibirle en nuestro antiguo Mas de caractère."
    ]
  },
