  "rdfs:comment": {
    "de": [
      "Le Palais, seit 50 Jahren das Königreich des Sports und der Entspannung! Entdecken Sie den größten Freizeitkomplex der Alpen. Ob allein, mit der Familie oder mit Freunden, lassen Sie Ihren Wünschen freien Lauf. Das gesamte Programm und die verschiedenen Bereiche finden Sie in der Broschüre."
    ],
    "en": [
      "Le Palais, kingdom of sport and relaxation for 50 years! Discover the largest leisure complex in the Alps. Alone, with family or friends, give free rein to your desires. Find out all about the program and the different areas in the brochure."
    ],
    "it": [
      "Le Palais, il regno dello sport e del relax da 50 anni! Scoprite il più grande complesso per il tempo libero delle Alpi. Da soli, in famiglia o con gli amici, date libero sfogo ai vostri desideri. Scoprite il programma e le diverse aree nella brochure."
    ],
    "fr": [
      "Le Palais, royaume du sport et de la détente depuis 50 ans ! Découvrez le plus grand complexe de loisirs des Alpes. Seul, en famille ou entre amis, laissez libre court à vos envies. Retrouvez tout le programme et les différents espaces sur la brochure."
    ],
    "nl": [
      "Le Palais, al 50 jaar het koninkrijk van sport en ontspanning! Ontdek het grootste vrijetijdscomplex in de Alpen. Alleen, met het gezin of met vrienden, laat je verlangens de vrije loop. Ontdek alles over het programma en de verschillende zones in de brochure."
    ],
    "es": [
      "Le Palais, ¡el reino del deporte y la relajación desde hace 50 años! Descubra el mayor complejo de ocio de los Alpes. Solo, en familia o con amigos, dé rienda suelta a sus deseos. Infórmese sobre el programa y los diferentes espacios en el folleto."
    ]
  },
  "rdfs:label": {
    "en": [
