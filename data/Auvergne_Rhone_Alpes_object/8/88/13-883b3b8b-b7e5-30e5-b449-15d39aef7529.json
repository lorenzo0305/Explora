  "rdfs:comment": {
    "de": [
      "Ein Weiler aus dem 17. Jahrhundert auf der Sonnenseite, mit seiner Barockkapelle, seinem Brotbackofen und seinem Blick auf Gletscher und Wasserfälle."
    ],
    "en": [
      "A 17th-century hamlet on the sunny side of the mountain, with its baroque chapel, bread oven and view of glaciers and waterfalls."
    ],
    "it": [
      "Un borgo del XVII secolo sul versante soleggiato della montagna, con la sua cappella barocca, il forno per il pane e la vista su ghiacciai e cascate."
    ],
    "fr": [
      "Un hameau du XVII ème siècle, à l'adret, le versant au soleil, avec sa chapelle baroque, son four à pain, et sa vue sur les glaciers et les cascades."
    ],
    "es": [
      "Una aldea del siglo XVII en la ladera soleada de la montaña, con su capilla barroca, su horno de pan y sus vistas a glaciares y cascadas."
    ],
    "nl": [
      "Een 17e-eeuws gehucht aan de zonnige kant van de berg, met een barokke kapel, broodoven en uitzicht op gletsjers en watervallen."
    ]
  },
