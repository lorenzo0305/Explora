  "rdfs:comment": {
    "de": [
      "Besitzerwechsel: Der neue Küchenchef Jérôme Pras lädt Sie ein, das ganze Jahr über eine klassische und gepflegte Küche zu entdecken. Die Menüs und die Speisekarte entwickeln sich je nach Jahreszeit mit frischen Produkten."
    ],
    "en": [
      "Change of ownership: new chef Jérôme Pras invites you to discover his classic, carefully-crafted cuisine all year round. Menus and menus evolve with the seasons, using fresh produce."
    ],
    "it": [
      "Con il cambio di proprietà, il nuovo chef Jérôme Pras vi invita a scoprire la sua cucina classica e curata tutto l'anno. I menu e il menu à la carte cambiano con le stagioni, utilizzando prodotti freschi."
    ],
    "fr": [
      "Changement de propriétaire : le nouveau chef Jérôme Pras vous invite à découvrir une cuisine classique et soignée toute l'année. Les menus et la carte évoluent en fonction des saisons avec des produits frais."
    ],
    "nl": [
      "Met een verandering van eigenaar nodigt de nieuwe chef-kok Jérôme Pras u uit om het hele jaar door zijn klassieke, zorgvuldig bereide keuken te ontdekken. De menu's en het à la carte menu veranderen met de seizoenen en er wordt gebruik gemaakt van verse producten."
    ],
    "es": [
      "Con un cambio de propietario, el nuevo chef Jérôme Pras le invita a descubrir su cocina clásica y cuidada durante todo el año. Los menús y la carta cambian con las estaciones, utilizando productos frescos."
    ]
  },
