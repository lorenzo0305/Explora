  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine traditionelle, hausgemachte Küche mit frischen Produkten. Frösche in Persillades am Abend und am Wochenende, sowie hausgemachte Backwaren."
    ],
    "en": [
      "The restaurant offers traditional homemade cuisine made with fresh produce, including frogs in parsley sauce on evenings and weekends, as well as homemade pastries."
    ],
    "it": [
      "Il ristorante propone una cucina tradizionale casalinga a base di prodotti freschi, tra cui rane in salsa di prezzemolo la sera e nei fine settimana, e dolci fatti in casa."
    ],
    "fr": [
      "Le restaurant vous propose une cuisine traditionnelle faite maison composée de produits frais. grenouilles en persillades les soirs et Week end, ainsi des pâtisserie maison."
    ],
    "nl": [
      "Het restaurant serveert traditionele huisgemaakte gerechten met verse producten, waaronder 's avonds en in het weekend kikkers in peterseliesaus en huisgemaakt gebak."
    ],
    "es": [
      "El restaurante sirve cocina casera tradicional elaborada con productos frescos, incluidas ranas en salsa de perejil por las noches y los fines de semana, así como repostería casera."
    ]
  },
  "rdfs:label": {
