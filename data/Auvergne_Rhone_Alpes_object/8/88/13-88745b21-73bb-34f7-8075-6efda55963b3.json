  "rdfs:comment": {
    "de": [
      "In einem alten Destilliergerät mit Panoramaterrasse mit Blick auf die Ardèche und die Klippen des Dorfes. La Voguette bietet Ihnen eine abwechslungsreiche Speisekarte, Salate, Pinsa, Ravioli, Gegrilltes aus frischen und ursprünglichen Produkten."
    ],
    "en": [
      "In an old still with a panoramic terrace overlooking the Ardèche and the village cliffs, La Voguette offers a varied menu of salads, pinsa, ravioli and grilled dishes made with fresh, local produce."
    ],
    "it": [
      "Situata in un antico edificio con una terrazza panoramica che si affaccia sull'Ardèche e sulle scogliere del villaggio, La Voguette offre un menù vario di insalate, pinsa, ravioli e piatti alla griglia preparati con prodotti freschi e locali."
    ],
    "fr": [
      "Dans un ancien alambique  avec terrasse panoramique sur l'Ardèche et les falaises du village. la  Voguette vous propose une carte variée, salades, pinsa,  ravioles, grill  à base de produits frais et d'origine."
    ],
    "es": [
      "Ubicado en un antiguo alambique con terraza panorámica con vistas al Ardèche y a los acantilados del pueblo, La Voguette ofrece una carta variada de ensaladas, pinsa, raviolis y platos a la parrilla elaborados con productos frescos y locales."
    ],
    "nl": [
      "La Voguette is gevestigd in een oude molen met een panoramisch terras dat uitkijkt over de Ardèche en de kliffen van het dorp en biedt een gevarieerd menu van salades, pinsa, ravioli en gegrilde gerechten gemaakt met verse, lokale producten."
    ]
  },
