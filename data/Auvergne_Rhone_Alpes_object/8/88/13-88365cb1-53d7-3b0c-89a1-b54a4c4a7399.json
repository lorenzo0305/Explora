  "rdfs:comment": {
    "de": [
      "Von Philippe SABINE I Naturalistische Fotografien\r\nEin Eintauchen in das Herz der wilden Tierwelt, um Säugetiere, Vögel und Insekten zu treffen, die in der Intimität ihres Alltags festgehalten werden."
    ],
    "en": [
      "By Philippe SABINE I Nature photography\r\nAn immersion into the heart of the wild fauna, meeting mammals, birds and insects captured in the intimacy of their daily lives."
    ],
    "it": [
      "Di Philippe SABINE I Fotografia naturalistica\r\nUn'immersione nel cuore della fauna selvatica, per incontrare mammiferi, uccelli e insetti catturati nell'intimità della loro vita quotidiana."
    ],
    "fr": [
      "Par Philippe SABINE I Photographies naturalistes\r\nUne immersion au coeur de la faune sauvage, à la rencontre de mammifères, oiseaux et insectes saisis dans l’intimité de leur quotidien."
    ],
    "es": [
      "Por Philippe SABINE I Fotografía de naturaleza\r\nUna inmersión en el corazón de la fauna salvaje, para conocer mamíferos, aves e insectos captados en la intimidad de su vida cotidiana."
    ],
    "nl": [
      "Door Philippe SABINE I Natuurfotografie\r\nEen onderdompeling in het hart van de wilde fauna, om zoogdieren, vogels en insecten te ontmoeten, gevangen in de intimiteit van hun dagelijkse leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Les animaux de l'ombre"
    ]
  },
