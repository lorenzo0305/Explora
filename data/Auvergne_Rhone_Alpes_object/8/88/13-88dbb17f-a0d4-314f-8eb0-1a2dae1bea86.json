  "rdfs:comment": {
    "de": [
      "In dieser traditionellen Scheune mit Steinmauern und Schieferdach werden dem Publikum alle Geheimnisse eines der ältesten Käses der Auvergne enthüllt..."
    ],
    "en": [
      "In this barn, you will learn the secrets of one of the oldest cheeses in Auvergne."
    ],
    "it": [
      "In questo tradizionale fienile con muri in pietra e tetto in ardesia, tutti i segreti di uno dei più antichi formaggi dell'Alvernia vengono svelati al pubblico..."
    ],
    "fr": [
      "Dans cette grange traditionnelle aux murs de pierre et toit de lauzes, tous les secrets de l'un des plus vieux fromages d'Auvergne se dévoilent au public..."
    ],
    "nl": [
      "In deze traditionele schuur met stenen muren en leien dak worden alle geheimen van een van de oudste kazen van de Auvergne onthuld..."
    ],
    "es": [
      "En este granero tradicional con paredes de piedra y techo de pizarra, se revelan al público todos los secretos de uno de los quesos más antiguos de Auvernia..."
    ]
  },
