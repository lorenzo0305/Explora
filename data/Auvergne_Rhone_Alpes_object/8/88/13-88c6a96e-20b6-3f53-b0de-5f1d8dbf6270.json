  "rdfs:comment": {
    "de": [
      "Die Hits von Jean-Jacques Goldman 100% live: Eine neue Show mit 100% Hits aus der Welt von Jean-Jacques GOLDMAN und dem Trio FREDERICKS GOLDMAN JONES.\r\nDieses Tribute lässt Sie dieses Monument des französischen Chansons wieder aufleben"
    ],
    "en": [
      "The hits of Jean-Jacques Goldman 100% live: a new 100% hits show, from the world of Jean-Jacques GOLDMAN to that of the FREDERICKS GOLDMAN JONES trio.\r\nThis tribute will bring this monument to French chanson back to life"
    ],
    "it": [
      "I successi di Jean-Jacques Goldman 100% live: un nuovo spettacolo 100% hits, dal mondo di Jean-Jacques Goldman a quello del trio Fredericks Goldman Jones.\r\nQuesto tributo farà rivivere questo monumento della chanson francese"
    ],
    "fr": [
      "Les tubes de Jean-Jacques Goldman 100% live :  un nouveau show 100% tubes, de l’univers de Jean-Jacques GOLDMAN à celui du trio FREDERICKS GOLDMAN JONES.\r\nCe tribute vous ferra revivre ce monument de la chanson francaise"
    ],
    "es": [
      "Los éxitos de Jean-Jacques Goldman 100% en directo: un nuevo espectáculo 100% éxitos, del universo de Jean-Jacques Goldman al del trío Fredericks Goldman Jones.\r\nEste homenaje hará revivir a este monumento de la chanson francesa"
    ],
    "nl": [
      "De hits van Jean-Jacques Goldman 100% live: een nieuwe 100% hitshow, vanuit de wereld van Jean-Jacques Goldman naar die van het trio Fredericks Goldman Jones.\r\nDit eerbetoon brengt dit monument van het Franse chanson weer tot leven"
    ]
  },
  "rdfs:label": {
