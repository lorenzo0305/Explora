  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8f5efc17-0984-3ebb-82e9-3ec08927e1a5",
      "dc:description": {
        "de": [
          "Aquaterra stellt junge Astronauten ein, um Raketen herzustellen und zu testen, die einen sauberen Antrieb verwenden! Bist du interessiert? Dann melde dich an und besuche die Aquaterra-Startbasis Summer-24."
        ],
        "en": [
          "Aquaterra is recruiting young astronauts to build and test rockets using clean propulsion! Interested? Then sign up and visit the Aquaterra Summer-24 launch base."
        ],
        "it": [
          "Aquaterra sta reclutando giovani astronauti per costruire e testare razzi a propulsione pulita! Siete interessati? Allora iscrivetevi e visitate la base di lancio di Aquaterra Summer-24."
        ],
        "fr": [
          "Aquaterra recrute des jeunes astronautes pour fabriquer et tester des fusées qui utilisent un moyen de propulsion propre ! Intéressé ? Alors inscris-toi et rendez-vous à la base de lancement d’Aquaterra Summer-24."
        ],
        "nl": [
          "Aquaterra werft jonge astronauten aan om raketten te bouwen en te testen met schone aandrijving! Geïnteresseerd? Meld je dan aan en bezoek de Aquaterra Summer-24 lanceerbasis."
        ],
        "es": [
          "Aquaterra recluta jóvenes astronautas para construir y probar cohetes con propulsión limpia ¿Te interesa? Entonces inscríbete y visita la base de lanzamiento Aquaterra Summer-24."
        ]
      },
