  "rdfs:comment": {
    "de": [
      "Ziegenhufe, Schilf, Därme, Eselskiefer, Hölzer, Steine und Metalle... Alles ist Musik seit Anbeginn der Zeit.\r\nNach vorheriger Anmeldung."
    ],
    "en": [
      "Goat hooves, reeds, guts, donkey jaws, wood, stone and metal... It's all been music since the dawn of time.\r\nPlease book in advance."
    ],
    "it": [
      "Zoccoli di capra, canne, budella, mascelle d'asino, legno, pietra e metallo... Tutto è musica dalla notte dei tempi.\r\nPrenotazione obbligatoria."
    ],
    "fr": [
      "Les sabots des chèvres, les roseaux, les boyaux, les mâchoires d'âne, les bois, les pierres et les métaux... Tout est musique depuis la nuit des temps. \r\nSur réservation."
    ],
    "es": [
      "Pezuñas de cabra, cañas, tripas, mandíbulas de burro, madera, piedra y metal... Todo ha sido música desde la noche de los tiempos.\r\nEs necesario reservar."
    ],
    "nl": [
      "Geitenhoeven, riet, ingewanden, ezelskaken, hout, steen en metaal... Alles is muziek sinds het begin der tijden.\r\nReserveren verplicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : L'Homme, l'animal, le végétal"
    ]
  },
