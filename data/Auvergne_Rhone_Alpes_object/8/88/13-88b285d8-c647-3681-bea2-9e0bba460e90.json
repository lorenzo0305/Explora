  "rdfs:comment": {
    "de": [
      "Das Hörgeräteakustiklabor in Saugues ist auf Hörgeräte für Erwachsene und Kinder spezialisiert.\r\nHörgeräteakustiker D.E.: Jean Benoit Proriol\r\nMöglichkeit der Terminvereinbarung auf der Website audio-solution.de"
    ],
    "en": [
      "The Saugues hearing correction laboratory specializes in hearing aids for adults and children.\r\nAudioprosthetist D.E. : Jean Benoit Proriol\r\nAppointments can be booked via audio-solution.fr"
    ],
    "it": [
      "Il laboratorio di correzione dell'udito di Saugues è specializzato in apparecchi acustici per adulti e bambini.\r\nSpecialista in apparecchi acustici: Jean Benoit Proriol\r\nÈ possibile richiedere un appuntamento sul sito web audio-solution.fr"
    ],
    "fr": [
      "Le laboratoire de correction auditive de Saugues est spécialisé dans les appareils auditifs de l’adulte et de l’enfant.\r\nAudioprothésiste D.E. : Jean Benoit Proriol\r\nPossibilité de demande de rendez-vous sur le site audio-solution.fr"
    ],
    "nl": [
      "Het gehoorcorrectielaboratorium in Saugues is gespecialiseerd in hoortoestellen voor volwassenen en kinderen.\r\nHoortoestelspecialist: Jean Benoit Proriol\r\nU kunt een afspraak aanvragen op de website audio-solution.fr"
    ],
    "es": [
