  "rdfs:comment": {
    "de": [
      "In unserem Feinkostladen werden sorgfältig ausgewählte Qualitätsprodukte angeboten, die lokale Spezialitäten und außergewöhnliche Geschmacksrichtungen miteinander verbinden. Er ist eine unumgängliche Adresse für Liebhaber der Gastronomie und authentischer Produkte."
    ],
    "en": [
      "Our delicatessen showcases carefully selected quality products, combining local specialties and exceptional flavors. It's the place to go for lovers of gastronomy and authentic products."
    ],
    "it": [
      "La nostra gastronomia presenta prodotti di qualità accuratamente selezionati, combinando specialità locali e sapori eccezionali. È una tappa obbligata per gli amanti della buona tavola e dei prodotti autentici."
    ],
    "fr": [
      "Notre épicerie fine met à l’honneur des produits de qualité, soigneusement sélectionnés, mêlant spécialités locales et saveurs d’exception. C'est une adresse incontournable pour les amateurs de gastronomie et de produits authentiques."
    ],
    "es": [
      "Nuestra charcutería presenta productos de calidad cuidadosamente seleccionados, que combinan especialidades locales y sabores excepcionales. Es una visita obligada para los amantes de la buena mesa y los productos auténticos."
    ],
    "nl": [
      "In onze delicatessenzaak vind je zorgvuldig geselecteerde kwaliteitsproducten, een combinatie van lokale specialiteiten en uitzonderlijke smaken. Een must voor liefhebbers van lekker eten en authentieke producten."
    ]
  },
  "rdfs:label": {
