  "rdfs:comment": {
    "de": [
      "Eine hausgemachte Küche, die mit lokalen und saisonalen Produkten zubereitet wird. Hier genießt man gerne ein Getränk auf der Terrasse mit einem atemberaubenden Blick auf die Bucht."
    ],
    "en": [
      "Home-cooked cuisine using local, seasonal produce. Enjoy a drink on the terrace with a breathtaking view of the bay."
    ],
    "it": [
      "Cucina casalinga con prodotti locali e di stagione. Sorseggiate un drink sulla terrazza con vista mozzafiato sulla baia."
    ],
    "fr": [
      "Une cuisine faite maison élaborée avec des produits locaux et de saison. On aime y prendre un verre en terrasse avec une vue imprenable sur la baie."
    ],
    "nl": [
      "Huisgemaakte gerechten met lokale, seizoensgebonden producten. Geniet van een drankje op het terras met een adembenemend uitzicht over de baai."
    ],
    "es": [
      "Cocina casera con productos locales de temporada. Disfrute de una copa en la terraza con impresionantes vistas a la bahía."
    ]
  },
