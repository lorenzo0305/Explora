  "rdfs:comment": {
    "de": [
      "Museum, das die lokale Geschichte und das Leben in der Vergangenheit darstellt: Küche und Zimmer der Beate - Versammlungsraum. Im Obergeschoss Ausstellung von Utensilien und Werkzeugen aus dem Landleben.\r\nJeden Sommer neue Ausstellung zu entdecken."
    ],
    "en": [
      "Museum presenting the local history and life of the past: kitchen and room of the Beate - assembly room. On the first floor, an exhibition of utensils and tools of rural life. Summer exhibitions."
    ],
    "it": [
      "Museo che presenta la storia locale e la vita di un tempo: cucina e camera da letto di La Béate - sala riunioni. Al piano superiore, un'esposizione di utensili e attrezzi rurali.\r\nOgni estate una nuova mostra da scoprire."
    ],
    "fr": [
      "Musée présentant l'histoire locale et la vie d'autrefois : cuisine et chambre de la Béate - salle d'assemblée. A l'étage, exposition d'ustensiles et outils de la vie rurale. \r\nNouvelle exposition à découvrir chaque été."
    ],
    "nl": [
      "Museum over de plaatselijke geschiedenis en het leven van vroeger: keuken en slaapkamer van La Béate - vergaderzaal. Boven een tentoonstelling van landelijke gebruiksvoorwerpen en gereedschappen.\r\nElke zomer een nieuwe tentoonstelling."
    ],
    "es": [
      "Museo que presenta la historia local y la vida de antaño: cocina y dormitorio de La Béate - salón de actos. Arriba, exposición de utensilios y herramientas rurales.\r\nNueva exposición por descubrir cada verano."
    ]
  },
