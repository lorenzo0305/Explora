  "rdfs:comment": {
    "de": [
      "Kanu und Kajak Vermietung  und begleitete Fahrt, 7 oder 10 Km"
    ],
    "en": [
      "Discover the beautiful Gorges du Chassezac! With 7 and 10km options, the Chassezac will amaze you with its landscapes and idyllic beaches. On a rental basis or with our instructors, we offer a formula that suits your needs of discovery and change of scenery."
    ],
    "it": [
      "Scoprite le magnifiche Gole dello Chassezac! Da soli o guidati da uno dei nostri istruttori, abbiamo un pacchetto che soddisfa tutti i vostri desideri di scoperta e di cambiamento di scenario."
    ],
    "fr": [
      "Découvrez les magnifiques Gorges du Chassezac ! En toute liberté ou guidé par nos moniteurs, nous proposons une formule répondant à vos envies de découvertes et de dépaysement."
    ],
    "nl": [
      "Ontdek de prachtige Gorges du Chassezac! Of je nu alleen gaat of onder begeleiding van een van onze instructeurs, we hebben een pakket dat past bij al je wensen voor ontdekking en verandering van omgeving."
    ],
    "es": [
      "Descubra las magníficas Gargantas del Chassezac Ya sea por su cuenta o guiado por uno de nuestros monitores, tenemos un paquete que se adapta a todos sus deseos de descubrimiento y cambio de aires."
    ]
  },
