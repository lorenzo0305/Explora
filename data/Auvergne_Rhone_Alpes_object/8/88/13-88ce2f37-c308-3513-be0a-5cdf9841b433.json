  "rdfs:comment": {
    "de": [
      "DER Snowpark für alle Niveaus!\r\nVersuchen Sie sich im Freestyle auf den breiten Boxen und Mini-Buckeln der ROOKIES-Zone oder perfektionieren Sie Ihren Stil auf den Kickern der PRO-Zone!"
    ],
    "ru": [
      "Один из самых лучших сноупарков Европы, который подходит как для экспертов так и для новичков.\r\nИспытайте себя во фристайле на широких и мини боксах в зоне ROOKIES, либо повысьте Ваш уровень на хаф-пайпе для экспертов в зоне ПРО!"
    ],
    "en": [
      "The snowpark adapted to all levels ! \r\nTry freestyle on the wide boxes and mini bumps of the ROOKIES area or perfect your style on PRO zone!"
    ],
    "it": [
      "Lo snowpark per tutti i livelli!\r\nMettetevi alla prova con il freestyle sui box larghi e le mini moguls nella zona ROOKIES o perfezionate il vostro stile sui kicker nella zona PRO!"
    ],
    "fr": [
      "LE snowpark pour tous les niveaux ! \r\nEssayez-vous au freestyle sur les boxs larges et les mini bosses de la zone ROOKIES ou perfectionnez votre style sur les kickers de la zone PRO !"
    ],
    "nl": [
      "Het snowpark voor alle niveaus!\r\nProbeer je freestyle op de brede boxen en mini-moguls in de ROOKIES-zone of perfectioneer je stijl op de kickers in de PRO-zone!"
    ],
    "es": [
      "El parque de nieve para todos los niveles\r\nPrueba tu estilo libre en las cajas anchas y los mini moguls en la zona ROOKIES o perfecciona tu estilo en los kickers de la zona PRO"
    ]
  },
