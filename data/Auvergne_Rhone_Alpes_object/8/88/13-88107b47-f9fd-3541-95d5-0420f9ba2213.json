  "rdfs:comment": {
    "de": [
      "Machst du deine Filme selbst? Mit deinem Handy oder sogar mit echtem Profi-Equipment? Nimm an unserem ersten Festival für DIY-Amateurfilme teil und präsentiere deine Kreationen!"
    ],
    "en": [
      "Do you make your own films? With your phone or even with real pro equipment? Take part in our first DIY amateur film festival and show off your creations!"
    ],
    "it": [
      "Realizzate i vostri film? Con il vostro telefono o anche con una vera attrezzatura professionale? Partecipate al nostro primo festival del cinema amatoriale fai da te e mostrate le vostre creazioni!"
    ],
    "fr": [
      "Tu fais toi même tes propres films ? Avec ton téléphone ou même avec du vrai matos de pro ? Participez à notre premier festival de films amateurs DIY et présente tes créations !"
    ],
    "es": [
      "¿Haces tus propias películas? ¿Con tu teléfono o incluso con un auténtico equipo profesional? Participa en nuestro primer festival de cine amateur DIY y muestra tus creaciones"
    ],
    "nl": [
      "Maak jij je eigen films? Met je telefoon of zelfs met echte professionele apparatuur? Doe mee aan ons eerste doe-het-zelf amateurfilmfestival en laat je creaties zien!"
    ]
  },
  "rdfs:label": {
