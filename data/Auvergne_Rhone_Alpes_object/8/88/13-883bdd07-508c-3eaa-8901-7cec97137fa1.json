  "rdfs:comment": {
    "de": [
      "Kommentierte Besichtigung der Gärten mit anschließender Verkostung. Nach vorheriger Vereinbarung.\r\nHerstellung von einfachen oder zusammengesetzten Kräutertees, aromatisierten Salzen, Sirupen und Konfitüren. Partizipative Arbeitseinsätze zum Wiederaufbau von Trockensteinmauern."
    ],
    "en": [
      "Guided tour of the gardens followed by a tasting. By appointment only.\r\nProduction of simple or blended herbal teas, flavored salts, syrups, jams. Participatory workcamps to rebuild dry-stone walls."
    ],
    "it": [
      "Visita guidata dei giardini seguita da una degustazione. Solo su appuntamento.\r\nProduzione di tisane semplici o miscelate, sali aromatizzati, sciroppi e marmellate. Campi di lavoro partecipativi per la ricostruzione di muri a secco."
    ],
    "fr": [
      "Visite commentée des jardins suivie d'une dégustation. Sur rendez-vous.\r\nProductions de tisanes simples ou composées, sels aromatisés, sirops, confitures. Chantiers participatifs pour reconstruire des murs en pierres sèches."
    ],
    "es": [
      "Visita guiada a los jardines seguida de una degustación. Sólo con cita previa.\r\nElaboración de infusiones simples o mezclas, sales aromatizadas, siropes y mermeladas. Campos de trabajo participativos para reconstruir muros de piedra seca."
    ],
    "nl": [
      "Rondleiding door de tuinen gevolgd door een proeverij. Alleen op afspraak.\r\nProductie van eenvoudige of gemengde kruidenthee, gearomatiseerd zout, siroop en jam. Participatieve werkkampen om droge stenen muren te herbouwen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mélisse & compagnie"
    ]
  },
