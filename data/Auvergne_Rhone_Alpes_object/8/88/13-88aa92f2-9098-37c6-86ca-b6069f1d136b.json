  "rdfs:comment": {
    "de": [
      "Textilkreationen aus Pflanzenfarben, Herstellung von handgefertigten Aquarellen. Cl?arté verbindet Kunst und Natur, indem es einzigartige Stücke kreiert, die unsere Umwelt respektieren. Entdecken Sie die Welt der Pflanzenfarben dank der Einführungsworkshops."
    ],
    "en": [
      "Vegetable-dyed textile creations, handmade watercolors. Cl?arté combines art and nature, creating unique pieces that respect our environment. Discover the world of vegetable color with introductory workshops."
    ],
    "it": [
      "Creazioni tessili con tinture vegetali e acquerelli artigianali. Cl?arté unisce arte e natura, creando pezzi unici nel rispetto dell'ambiente. Scoprite il mondo della tintura vegetale nei laboratori introduttivi."
    ],
    "fr": [
      "Créations textiles en teinture végétale, fabrication d’aquarelles artisanales. Cl’arté allie l’art et la nature en créant des pièces uniques, respectueuses de notre environnement. Découvrez l’univers de la couleur végétale grâce aux ateliers d’initiation."
    ],
    "nl": [
      "Textielcreaties met plantaardige verfstoffen, handgemaakte aquarellen. Cl?arté combineert kunst en natuur en creëert unieke stukken die ons milieu respecteren. Ontdek de wereld van plantaardig verven in inleidende workshops."
    ],
    "es": [
      "Creaciones textiles con tintes vegetales, acuarelas artesanales. Cl?arté combina arte y naturaleza, creando piezas únicas que respetan nuestro entorno. Descubre el mundo de los tintes vegetales en talleres de iniciación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cl'arté - Teinture végétale, aquarelles artisanales"
    ]
  },
