  "rdfs:comment": {
    "de": [
      "Vert'Tige Aventure bietet 15 atypische Hochseilgärten, darunter eine Mega-Seilrutsche mit einer schwindelerregenden Höhe von 50 Metern und einer beeindruckenden Länge von 350 Metern! In einer malerischen Umgebung für ein unvergessliches Erlebnis im Freien!"
    ],
    "en": [
      "Vert'Tige Aventure offers 15 atypical treetop adventure courses, including a mega zip line with a dizzying height of 50 meters and an impressive length of 350 meters! In a picturesque setting for an unforgettable outdoor experience!"
    ],
    "it": [
      "Vert Tige Aventure a Roussas offre 15 percorsi avventura per tutte le età, tra cui una mega zip line unica nella zona! Godetevi un'avventura nel cuore della natura, con zip-line, ponti sospesi e relax nella foresta."
    ],
    "fr": [
      "Vert Tige Aventure à Roussas vous propose 15 parcours accrobranche pour tous les âges, avec une méga tyrolienne unique dans les environs ! Vivez une aventure en pleine nature, entre tyroliennes, ponts suspendus, et détente en forêt."
    ],
    "es": [
      "Vert Tige Aventure en Roussas ofrece 15 recorridos de aventura para todas las edades, ¡incluida una mega tirolina única en la zona! Disfrute de una aventura en plena naturaleza, con tirolinas, puentes colgantes y relajación en el bosque."
    ],
    "nl": [
      "Parcours in de bomen, 8 parcours, 70 ateliers. Vanaf 3 jaar."
    ]
  },
