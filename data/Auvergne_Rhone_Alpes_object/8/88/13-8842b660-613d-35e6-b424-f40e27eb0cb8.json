  "rdfs:comment": {
    "de": [
      "Familienhotel-Restaurant gegenüber dem See Fades-Besserve. Blumiger Park. Terrasse mit Blick auf den See, wo Sie unsere Spezialitäten probieren können: hausgemachte Gänseleberpastete, Kalbsbries mit Morchelcreme, Pilzomelett der Saison, Cantal-Truffade."
    ],
    "en": [
      "Family run hotel and restaurant which overlooks the lake Fades-Besserve. Flowered garden and a terrace with a superb view where you can enjoy our specialities: homemade foie gras, sweetbreads, omelette with seasonal mushrooms and truffard with cantal."
    ],
    "it": [
      "Hotel-ristorante a conduzione familiare situato di fronte al lago di Fades-Besserve. Parco fiorito. Terrazza con vista sul lago dove si possono gustare le nostre specialità: foie gras fatto in casa, animelle con spugnole, omelette con funghi di stagione, truffade con cantal."
    ],
    "fr": [
      "Hôtel-Restaurant familial situé face au lac des Fades-Besserve. Parc fleuri. Terrasse avec vue sur le lac où vous pouvez déguster nos spécialités: foie gras maison, ris de veau crème aux morilles, omelette aux champignons de saison, truffade au cantal."
    ],
    "es": [
      "Hotel-restaurante familiar situado frente al lago de Fades-Besserve. Parque florido. Terraza con vistas al lago donde podrá degustar nuestras especialidades: foie gras casero, mollejas con colmenillas, tortilla con setas de temporada, trufa con cantal."
    ],
    "nl": [
      "Gelegen tegenover het stuwmeer van Fades- Besserve."
    ]
  },
