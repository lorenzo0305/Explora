  "rdfs:comment": {
    "de": [
      "Familienbetrieb mit ca. 40 Milchschafen, Herstellung von Joghurt und Milchkäse, von Faisselle, Frischkäse bis hin zu gereiftem Käse."
    ],
    "en": [
      "Family-run farm with around 40 dairy ewes, producing yoghurts and lactic cheese, from faisselle to fromage frais and matured cheeses."
    ],
    "it": [
      "Azienda agricola a conduzione familiare con una quarantina di pecore da latte, che produce yogurt e formaggi lattici, dalle faisselle al fromage frais e ai formaggi stagionati.\r\nVisitate la fattoria..."
    ],
    "fr": [
      "Élevage familial d'une quarantaine de brebis laitières, production de yaourts et fromage lactique, de la faisselle, du fromage frais à l'affiné.\r\nVisite à la ferme..."
    ],
    "es": [
      "Granja familiar con unas cuarenta ovejas lecheras, que produce yogures y quesos lácteos, desde faisselle hasta queso fresco y quesos curados.\r\nVisite la granja..."
    ],
    "nl": [
      "Familieboerderij met ongeveer veertig melkschapen, die yoghurt en melkzuurkaas produceert, van faisselle en fromage frais tot gerijpte kazen."
    ]
  },
