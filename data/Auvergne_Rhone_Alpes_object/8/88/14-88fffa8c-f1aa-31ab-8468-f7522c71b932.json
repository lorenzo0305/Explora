  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f0c4822c-54f1-3d96-8650-93121608a71b",
      "dc:description": {
        "de": [
          "Gemeindesaal im 1. Stock von 180m².\n\nMit Verpflegung :\n? Lokale Antragsteller: 300 ?\n? Antragsteller außerhalb des Ortes: 600 ?\n\nOhne Verpflegung :\n? Örtliche Antragsteller: 150 ?\n? Antragsteller außerhalb des Ortes : 300 ?\n\nEin Kautionsscheck von 300 ? wird vor jeder Belegung der Räumlichkeiten verlangt"
        ],
        "en": [
          "1st floor community hall, 180m².\n\nWith catering :\n? Local applicants: 300 ?\n? Out-of-town applicants: 600 ?\n\nWithout catering :\n? Local applicants: 150 ?\n? Out-of-town applicants: 300 ?\n\nA deposit cheque for 300 ? will be requested prior to any occupation of the premises"
        ],
        "it": [
          "Sala comunitaria al 1° piano di 180 m².\n\nCon ristorazione :\n? Richiedenti locali: 300 ?\n? Candidati esterni alla località: 600 ?\n\nSenza ristorazione :\n? Richiedenti locali: 150 ?\n? Candidati provenienti da fuori regione: 300 ?\n\nPrima dell'occupazione dei locali verrà richiesto un assegno di deposito di 300 ?"
        ],
        "fr": [
          "Salle communale au 1er étage de 180m². \n\nAvec restauration :\n– Demandeurs locaux : 300 €\n– Demandeurs hors localité : 600 €\n\nSans restauration :\n– Demandeurs locaux : 150 €\n– Demandeurs hors localité : 300 €\n\nUn chèque de caution de 300 € vous sera demandé avant toute occupation des lieux"
        ],
        "es": [
          "Salón comunitario de 180m² en la 1ª planta.\n\nCon servicio de comidas :\n? Solicitantes locales: 300 ?\n? Solicitantes de fuera de la localidad: 600 ?\n\nSin catering :\n? Solicitantes locales: 150 ?\n? Solicitantes de fuera de la localidad: 300 ?\n\nSe solicitará un cheque de fianza de 300€ antes de cualquier ocupación de los locales"
        ],
        "nl": [
          "Gemeenschapszaal op de 1e verdieping van 180m².\n\nMet catering :\n? Lokale kandidaten: 300 ?\n? Kandidaten van buiten de gemeente: 600 ?\n\nZonder catering :\n? Lokale kandidaten: 150 ?\n? Kandidaten van buiten de gemeente: 300 ?\n\nEen waarborgcheque van 300 € zal worden gevraagd voordat het pand in gebruik wordt genomen"
        ]
      },
