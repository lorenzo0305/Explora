  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant in einer außergewöhnlichen Umgebung mit Blick auf das Tal, 300m von den Thermen und 3 km von den Pisten entfernt. Beheizter Bereich des Hallenbads. Lounge-Atmosphäre an der Bar. Restaurant \"Oyeti\" jeden Abend geöffnet.\r\nSpezielle Preise für Kuren. Beste Preise direkt."
    ],
    "en": [
      "Hotel located in an exceptional setting, view of the valley, 300 m from the thermal baths and 3 km from the slopes. Heated indoor swimming pool area. Lounge atmosphere at the bar. Restaurant \"Oyeti\" open every evening. \r\nSpecial spa rates. Best live rates."
    ],
    "it": [
      "Hotel-ristorante situato in un contesto eccezionale, con vista sulla valle, a 300 m dalle terme e a 3 km dalle piste. Piscina interna riscaldata. Atmosfera lounge nel bar. Ristorante \"Oyeti\" aperto tutte le sere.\r\nTariffe speciali per le terme. Migliori tariffe dirette."
    ],
    "fr": [
      "Hôtel-restaurant situé dans un cadre exceptionnel, vue sur la vallée, 300m des Thermes et 3 km des pistes. Espace piscine couverte chauffée. Ambiance lounge au bar. Restaurant \"Oyeti\" ouvert tous les soirs.\r\nTarifs spécial cure. Meilleurs tarifs en direct."
    ],
    "es": [
      "Hotel-restaurante situado en un marco excepcional, con vistas al valle, a 300 m de los baños termales y a 3 km de las pistas. Piscina cubierta climatizada. Ambiente de salón en el bar. Restaurante \"Oyeti\" abierto todas las noches.\r\nTarifas especiales spa. Las mejores tarifas directamente."
    ],
    "nl": [
      "Hotel-restaurant gelegen in een uitzonderlijke omgeving, met uitzicht op de vallei, 300m van de thermale baden en 3 km van de pistes. Verwarmd binnenzwembad. Loungesfeer in de bar. Restaurant \"Oyeti\" elke avond geopend.\r\nSpeciale spa-tarieven. Beste tarieven direct."
    ]
  },
  "rdfs:label": {
    "fr": [
      "The Originals Boutique Hôtel Le Panorama"
    ]
  },
