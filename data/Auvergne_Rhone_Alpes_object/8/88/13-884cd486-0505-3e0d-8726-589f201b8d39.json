  "rdfs:comment": {
    "de": [
      "Ines Tamm stellt Gegenstände aus Steingut und Porzellan her, die Ihren Alltag verschönern sollen: Schalen, Tassen, Teekannen, Vasen, Krüge usw.\r\nDiese Gefäße sind für den täglichen Gebrauch konzipiert, enthalten keine Schwermetalle und sind lebensmittelecht."
    ],
    "en": [
      "Ines Tamm creates sandstone and porcelain objects to add an element of beauty your daily life: bowls, cups, teapots, vases, jugs etc.These pots are designed for everyday use, do not contain heavy metals and are food grade."
    ],
    "it": [
      "Ines Tamm realizza oggetti in gres e porcellana di uso quotidiano: ciotole, tazze, teiere, vasi, brocche, ecc.\r\nQueste pentole sono progettate per l'uso quotidiano, non contengono metalli pesanti e sono sicure per gli alimenti."
    ],
    "fr": [
      "Ines Tamm fabrique des objets en grès et en porcelaine destinés à embellir votre quotidien : bols, tasses, théières, vases, pichets etc.\r\nCes pots sont conçus pour un usage au quotidien, ne contiennent pas de métaux lourds et sont alimentaires."
    ],
    "nl": [
      "Ines Tamm maakt voorwerpen van steengoed en porselein voor dagelijks gebruik: kommen, kopjes, theepotten, vazen, kannen enz.\r\nDeze potten zijn ontworpen voor dagelijks gebruik, bevatten geen zware metalen en zijn voedselveilig."
    ],
    "es": [
      "Ines Tamm fabrica objetos de gres y porcelana de uso cotidiano: cuencos, tazas, teteras, jarrones, jarras, etc.\r\nEstas ollas están diseñadas para el uso diario, no contienen metales pesados y son seguras para los alimentos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ines Tamm Pottery"
    ],
    "fr": [
      "Ines Tamm - Poterie à la ferme"
    ]
  },
