  "rdfs:comment": {
    "de": [
      "Gewölbesaal mit atypischem Charme und Terrasse mit Panoramablick auf die südliche Ardèche.\r\nEinfallsreiche Küche, Auswahl an natürlichen Weinen und lokalen Produkten."
    ],
    "en": [
      "Vaulted room with atypical charm and terrace with a panoramic view over the southern Ardèche.\r\nInventive cuisine, selection of natural wines and local products."
    ],
    "it": [
      "Camera a volta dal fascino atipico e terrazza con vista panoramica sull'Ardèche meridionale.\r\nCucina fantasiosa, selezione di vini naturali e prodotti locali."
    ],
    "fr": [
      "Salle voûtée au charme atypique et terrasse avec vue panoramique sur l'Ardèche méridionale.\r\nCuisine inventive, sélection de vins naturels et produits locaux."
    ],
    "es": [
      "Habitación abovedada con encanto atípico y terraza con vista panorámica del sur de Ardèche.\r\nCocina inventiva, selección de vinos naturales y productos locales."
    ],
    "nl": [
      "Gewelfde kamer met atypische charme en terras met panoramisch uitzicht op de zuidelijke Ardèche.\r\nInventieve keuken, selectie van natuurlijke wijnen en lokale producten."
    ]
  },
