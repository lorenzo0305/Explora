  "rdfs:comment": {
    "de": [
      "In ihrem Betrieb baut Caroline, eine AB-zertifizierte Produzentin, mit Leidenschaft Heil- und Gewürzpflanzen an. Entdecken Sie ihre natürlichen Produkte Kräutertees und Sirupe, die mit Sorgfalt hergestellt werden, um Ihnen eine Auszeit vom Alltag zu bieten."
    ],
    "en": [
      "On her farm, Caroline, an AB-certified producer, passionately cultivates medicinal and aromatic plants. Discover her natural herbal teas and syrups, carefully crafted to offer you a break from your routine."
    ],
    "it": [
      "Nella sua fattoria, Caroline, produttrice certificata AB, coltiva con passione piante medicinali e aromatiche. Scoprite le sue tisane e i suoi sciroppi naturali, preparati con cura, per una pausa dal tran tran quotidiano."
    ],
    "fr": [
      "Dans son exploitation, Caroline, productrice certifiée AB, cultive avec passion des plantes médicinales et aromatiques. Découvrez ses produits naturels tisanes et sirops, élaborés avec soin, pour vous offrir une parenthèse de bien-être au quotidien."
    ],
    "nl": [
      "Op haar boerderij kweekt Caroline, een AB-gecertificeerde producent, met passie geneeskrachtige en aromatische planten. Ontdek haar zorgvuldig samengestelde natuurlijke kruidenthee en siropen voor een onderbreking van de dagelijkse sleur."
    ],
    "es": [
      "En su granja, Caroline, productora con certificado AB, cultiva con pasión plantas medicinales y aromáticas. Descubre sus tisanas y jarabes naturales cuidadosamente elaborados para descansar de la rutina diaria."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Legoût des plantes"
    ]
  },
