  "rdfs:comment": {
    "de": [
      "Unsere Priorität: Ihre Gelassenheit als Reisende und Eigentümer. Persönlicher Empfang, rund um die Uhr verfügbar, Schadensabwicklung, Erstellung von Anzeigen mit Foto über Plattformen und direkt. Radius 15 bis 20 km um Saint-Paul-Trois-Châteaux."
    ],
    "en": [
      "Our priority: your peace of mind as a traveler or owner. Personal welcome, available 24 hours a day, claims management, creation of photo ads via platforms and direct. 15 to 20 km radius around Saint-Paul-Trois-Châteaux."
    ],
    "it": [
      "La nostra priorità: la vostra tranquillità di viaggiatori o proprietari. Accoglienza personale, disponibilità 24 ore su 24, gestione dei sinistri, creazione di annunci con foto tramite le piattaforme e direttamente. Raggio di 15-20 km intorno a Saint-Paul-Trois-Châteaux."
    ],
    "fr": [
      "Notre priorité, votre sérénité voyageurs et propriétaires. Accueil en personne, disponible 24h/24h, gestion des sinistres, création d'annonces avec photo via les plateformes et en directe. Rayonnement 15 à 20 km autour de Saint-Paul-Trois-Châteaux."
    ],
    "nl": [
      "Onze prioriteit: uw gemoedsrust als reiziger of eigenaar. Persoonlijke ontvangst, 24 uur per dag beschikbaar, schadebeheer, maken van advertenties met foto's via de platforms en rechtstreeks. 15 tot 20 km radius rond Saint-Paul-Trois-Châteaux."
    ],
    "es": [
      "Nuestra prioridad: su tranquilidad como viajero o propietario. Acogida personalizada, disponible las 24 horas del día, gestión de reclamaciones, creación de anuncios con fotos a través de las plataformas y en directo. Radio de 15 a 20 km alrededor de Saint-Paul-Trois-Châteaux."
    ]
  },
  "rdfs:label": {
