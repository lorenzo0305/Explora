  "rdfs:comment": {
    "de": [
      "Die Kirche, die dem Heiligen Petrus geweiht ist, befindet sich in einer isolierten Lage zwischen dem Marktflecken und dem Dorf Veret. Die Kirche wurde zwischen 1839 und 1841 im neoklassischen sardischen Stil erbaut."
    ],
    "en": [
      "The church, dedicated to Saint Peter, stands in a secluded position between the town and the village of Veret. It was built between 1839 and 1841 in the neo-classical Sardinian style."
    ],
    "it": [
      "La chiesa, dedicata a San Pietro, sorge in posizione isolata tra la città mercato e il villaggio di Veret. Fu costruita tra il 1839 e il 1841 in stile neoclassico sardo."
    ],
    "fr": [
      "L’église, dédiée à Saint Pierre occupe une position isolée entre le bourg et le village de Veret . Elle fut construite entre 1839 et 1841 dans le style sarde néo-classique.L’église fut construite entre 1839 et 1841 dans le style sarde néo-classique."
    ],
    "es": [
      "La iglesia, dedicada a San Pedro, está situada en una posición aislada entre el pueblo y la ciudad de Veret. La iglesia fue construida entre 1839 y 1841 en estilo neoclásico sardo."
    ],
    "nl": [
      "De kerk, gewijd aan Sint Peter, ligt geïsoleerd tussen de markt en het dorp Veret. Het werd gebouwd tussen 1839 en 1841 in de neoklassieke Sardijnse stijl."
    ]
  },
