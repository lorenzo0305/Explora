  "rdfs:comment": {
    "de": [
      "Das Comptoir Beaujolais befindet sich im Zentrum von Beaujeu, der historischen Hauptstadt des Beaujolais.\r\nSteigen Sie in unseren traditionellen Weinkeller hinab und entdecken Sie unter einem wunderschönen Steingewölbe die Beaujolais-Villages, Crus und Crémants unserer 15 Weingüter."
    ],
    "en": [
      "Comptoir Beaujolais is located right in the centre of Beaujeu, the historic capital of Beaujolais. \r\nCome down into our traditional cellar and discover the Beaujolais-Villages, Crus and Crémants from our 15 estates, under a magnificent stone vault."
    ],
    "it": [
      "Le Comptoir Beaujolais si trova nel centro di Beaujeu, la capitale storica del Beaujolais.\r\nScendete nella nostra cantina tradizionale e scoprite i Beaujolais-Villages, i Crus e i Crémants delle nostre 15 tenute, sotto una magnifica volta in pietra."
    ],
    "fr": [
      "Le Comptoir Beaujolais se situe en plein centre de Beaujeu, capitale historique du Beaujolais. \r\nDescendez dans notre caveau traditionnel et venez découvrir les Beaujolais-Villages, Crus et Crémants de nos 15 domaines, sous une magnifique voûte en pierre."
    ],
    "nl": [
      "Le Comptoir Beaujolais ligt in het centrum van Beaujeu, de historische hoofdstad van de Beaujolais.\r\nKom naar onze traditionele kelder en ontdek de Beaujolais-Villages, Crus en Crémants van onze 15 domeinen, onder een prachtig stenen gewelf."
    ],
    "es": [
      "Le Comptoir Beaujolais está situado en el centro de Beaujeu, la capital histórica del Beaujolais.\r\nBaje a nuestra bodega tradicional y descubra los Beaujolais-Villages, Crus y Crémants de nuestras 15 fincas, bajo una magnífica bóveda de piedra."
    ]
  },
