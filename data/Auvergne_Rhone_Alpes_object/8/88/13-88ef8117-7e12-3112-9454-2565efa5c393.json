  "rdfs:comment": {
    "de": [
      "Dorf Saint-Julien-Des-Chazes: Kirche aus dem 15. Jahrhundert mit Madonna in Majestät aus dem 13. Überreste der Abtei von Les Chazes (18. Jh.). Basaltische Orgeln. Wasserfall des Baches von Légal. Romanische Kapelle Notre-Dame-des-Chazes."
    ],
    "en": [
      "Village of Saint-Julien-Des-Chazes: 15th-century church with 13th-century Vierge en Majesté. Remains of the 18th-century Les Chazes abbey. Basalt organs. Légal waterfall. Romanesque chapel of Notre-Dame-des-Chazes."
    ],
    "it": [
      "Villaggio di Saint-Julien-Des-Chazes: chiesa del XV secolo con la Vergine in Maestà del XIII secolo. Resti dell'abbazia di Chazes (XVIII secolo). Organi di basalto. Cascata del torrente Légal. Cappella romanica di Notre-Dame-des-Chazes."
    ],
    "fr": [
      "Village de Saint-Julien-Des-Chazes : Église du XVe siècle avec Vierge en Majesté du XIIIe siècle. Vestiges de l’abbaye des Chazes (XVIIIe siècle). Orgues basaltiques. Cascade du ruisseau de Légal. Chapelle romane de Notre-Dame-des-Chazes."
    ],
    "es": [
      "Pueblo de Saint-Julien-Des-Chazes: iglesia del siglo XV con Virgen en Majestad del siglo XIII. Restos de la abadía de Chazes (siglo XVIII). Órganos de basalto. Cascada del arroyo Légal. Capilla románica de Notre-Dame-des-Chazes."
    ],
    "nl": [
      "Dorp Saint-Julien-Des-Chazes: 15e-eeuwse kerk met 13e-eeuwse Maagd in Majesteit. Overblijfselen van de abdij van Chazes (18e eeuw). Basaltorgels. Waterval van de beek Légal. Romaanse kapel van Notre-Dame-des-Chazes."
    ]
  },
  "rdfs:label": {
