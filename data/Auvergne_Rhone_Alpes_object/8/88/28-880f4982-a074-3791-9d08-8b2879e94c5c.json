  "rdfs:comment": {
    "de": [
      "Atelier-Boutique, in der man Wolle aus der Sommebucht in verschiedenen Naturtönen, aber auch handwerklich bearbeitetes Leder (Schmuck, Gürtel usw.) und Spielzeug aller Art entdecken kann. Ein Paradies sowohl für die Jüngsten als auch für Erwachsene!"
    ],
    "en": [
      "Workshop-Boutique where you can discover the wool of the Baie de Somme in different natural shades but also handcrafted leather (jewellery, belts, etc...) and toys of all types. A paradise for youngsters and adults alike!"
    ],
    "it": [
      "Un laboratorio-boutique dove scoprire la lana della Baie de Somme in diversi colori naturali, oltre a pelli artigianali (gioielli, cinture, ecc.) e giocattoli di ogni tipo. Un paradiso per grandi e piccini!"
    ],
    "fr": [
      "Atelier-Boutique où l’on découvre la laine de la Baie de Somme sous différentes teintes naturelles mais aussi le cuir travaillé artisanalement (bijoux, ceintures, etc…) et des jouets de tous types. Le paradis autant pour les plus jeunes que pour les adultes !"
    ],
    "nl": [
      "Workshop-Boetiek waar u de wol van de Baie de Somme in verschillende natuurlijke kleuren kunt ontdekken, evenals handgemaakt leer (juwelen, riemen, enz...) en allerlei soorten speelgoed. Een paradijs voor jong en oud!"
    ],
    "es": [
      "Un taller-boutique donde podrá descubrir la lana de la Bahía de Somme en diferentes colores naturales, así como el cuero (joyas, cinturones, etc.) y juguetes de todo tipo. Un paraíso para jóvenes y mayores"
    ]
  },
  "rdfs:label": {
