  "rdfs:comment": {
    "de": [
      "Abwechslungsreiche Pizzakarte zum Verzehr vor Ort oder zum Mitnehmen und hausgemachte Desserts. Im Lebensmittelgeschäft finden Sie italienische Produkte wie Panettone, verschiedene Pestos, Aperitif-Grissini, Amatetti-Kuchen und andere Produkte."
    ],
    "en": [
      "A varied menu of pizzas to eat in or take away, and homemade desserts. In the grocery section, you'll find Italian products such as panettone, pesto, aperitif breadsticks, amatetti cakes and more."
    ],
    "it": [
      "Un menu vario di pizze da mangiare o da portare via e di dolci fatti in casa. Nella sezione alimentari, troverete prodotti italiani come panettoni, pesti vari, grissini da aperitivo, amatetti e altri prodotti."
    ],
    "fr": [
      "Carte variée de pizzas à consommer sur place ou à emporter et desserts fait maison. Retrouvez dans la partie épicerie des produits italiens avec des panettones, différents pesto, des gressins apéritifs, des gâteaux amatetti et autres produits."
    ],
    "es": [
      "Una variada carta de pizzas para comer o llevar, y postres caseros. En la sección de ultramarinos, encontrará productos italianos como panettone, pestos variados, grisines de aperitivo, pasteles amatetti y otros productos."
    ],
    "nl": [
      "Een gevarieerd menu met pizza's om te eten of om mee te nemen, en huisgemaakte desserts. In de kruideniersafdeling vind je Italiaanse producten zoals panettone, verschillende pesto's, aperitiefbroodstengels, amatetti gebak en andere producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria La Nostra"
    ]
  },
