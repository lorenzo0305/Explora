  "rdfs:comment": {
    "de": [
      "Lokale Produkte im Direktverkauf: Gemüse, Obst, Fleisch, Käse, Lebensmittel, Wein, Brot, Kräuter...\r\nGutes, Lokales, Biologisches (oder nicht)... Das Wichtigste für Ihren täglichen Einkauf auf kurzem Wege."
    ],
    "en": [
      "Welcome to the Charrette! Here, you'll find direct sale products (40 producers), fruits, vegetables, meat, wines, fruit juices, cheeses, jams, honeys..."
    ],
    "it": [
      "Prodotti locali venduti direttamente: verdura, frutta, carne, formaggi, alimentari, vini, pane, erbe...\r\nBuoni, locali, biologici (o meno)... L'essenziale per la vostra spesa quotidiana."
    ],
    "fr": [
      "Des Produits locaux en vente directe : Légumes, Fruits, Viandes, Fromages, Epicerie, Vins, Pain, Plantes aromatiques...\r\nDu bon, du local, du bio (ou pas)... L'essentiel pour vos courses au quotidien en circuit court."
    ],
    "es": [
      "Venta directa de productos locales: Verduras, frutas, carne, queso, comestibles, vinos, pan, hierbas...\r\nBuenos, locales, ecológicos (o no)... Lo esencial para su compra diaria."
    ],
    "nl": [
      "Kom naar la Charrette en ontdek de producten die verkocht worden van wel 40 verschillende voedselproducenten. Fruit, groente, vlees, wijn, vruchtensap, kaas, jam, honing, etc."
    ]
  },
