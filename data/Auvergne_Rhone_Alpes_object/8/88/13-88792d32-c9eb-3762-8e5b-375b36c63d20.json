  "rdfs:comment": {
    "de": [
      "Willkommen im Chalet de Combe! Auf dem Gipfel des Skiortes Bernex gelegen, empfängt Sie unser Bergrestaurant mit leckeren Gerichten, einer gemütlichen Atmosphäre und einem atemberaubenden Blick auf die Alpen"
    ],
    "en": [
      "Welcome to Chalet de Combe! Situated at the top of the Bernex ski resort, our high-altitude restaurant welcomes you with tasty dishes, a warm atmosphere and a breathtaking view of the Alps."
    ],
    "it": [
      "Benvenuti allo Chalet de Combe! Situato in cima alla stazione sciistica di Bernex, il nostro ristorante d'alta quota vi accoglie con piatti gustosi, un'atmosfera calda e una vista mozzafiato sulle Alpi"
    ],
    "fr": [
      "Bienvenue au Chalet de Combe ! Situé au sommet de la station de ski de Bernex, notre restaurant d'altitude vous accueille avec des plats savoureux, une ambiance chaleureuse, et une vue imprenable sur les Alpes"
    ],
    "es": [
      "¡Bienvenido al Chalet de Combe! Situado en la cima de la estación de esquí de Bernex, nuestro restaurante de altura le da la bienvenida con sabrosos platos, un ambiente cálido y una vista impresionante de los Alpes"
    ],
    "nl": [
      "Welkom in Chalet de Combe! Gelegen op de top van het Bernex skigebied, verwelkomt ons hooggelegen restaurant je met smakelijke gerechten, een warme sfeer en een adembenemend uitzicht op de Alpen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez LeSteph's Restaurant - Chalet de Combe"
    ],
    "fr": [
      "Restaurant Chez LeSteph's - Chalet de Combe"
    ],
