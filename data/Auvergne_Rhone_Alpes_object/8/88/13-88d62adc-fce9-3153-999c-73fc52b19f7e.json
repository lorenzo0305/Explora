  "rdfs:comment": {
    "de": [
      "Kleiner Gemüseanbaubetrieb, in dem Biogemüse ohne Bodenbearbeitung, ohne Maschinen und fast nur mit alten Gemüsesorten angebaut wird.\r\nGemüseanbau auf lebendem Boden"
    ],
    "en": [
      "Small market garden where organic vegetables are produced without tilling the soil or using machinery, using almost exclusively old varieties of vegetables.\r\nLiving Soil Vegetable Growing"
    ],
    "it": [
      "Un piccolo orto in cui si coltivano ortaggi biologici, senza lavorazione del terreno né macchinari, utilizzando quasi esclusivamente varietà antiche di ortaggi.\r\nColtivazione di ortaggi in terreno vivo"
    ],
    "fr": [
      "Petite exploitation maraichère où des légumes bio sont produits sans travail du sol, sans machine, avec quasiment que des variétés de légumes anciens.\r\nMaraichage sur Sol Vivant"
    ],
    "es": [
      "Pequeña huerta donde se producen hortalizas ecológicas sin labranza ni maquinaria, utilizando casi exclusivamente variedades antiguas de hortalizas.\r\nCultivo de hortalizas en suelo vivo"
    ],
    "nl": [
      "Een kleine moestuin waar biologische groenten worden verbouwd zonder grondbewerking of machines, met bijna uitsluitend oude groentesoorten.\r\nLevende grond groenteteelt"
    ]
  },
  "rdfs:label": {
