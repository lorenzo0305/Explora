  "rdfs:comment": {
    "de": [
      "In einer familiären Atmosphäre können Sie eine Schlemmerpause einlegen und sich von einer traditionellen und großzügigen Küche verführen lassen. Die Speisekarte ändert sich mit den Jahreszeiten."
    ],
    "en": [
      "In a family atmosphere, take a gourmet break and let yourself be tempted by a traditional and generous cuisine. The menu evolves with the seasons."
    ],
    "it": [
      "In un'atmosfera familiare, concedetevi una pausa gourmet e lasciatevi tentare da una cucina tradizionale e generosa. Il menu cambia a seconda delle stagioni."
    ],
    "fr": [
      "Dans une ambiance familiale, faites une pause gourmande et laissez vous tenter par une cuisine traditionnelle et généreuse. La carte évolue au fil des saisons."
    ],
    "nl": [
      "In een familiale sfeer, neem een gastronomische pauze en laat u verleiden door een traditionele en genereuze keuken. Het menu verandert met de seizoenen."
    ],
    "es": [
      "En un ambiente familiar, tómese un descanso gastronómico y déjese tentar por una cocina tradicional y generosa. El menú cambia con las estaciones."
    ]
  },
