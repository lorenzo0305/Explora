  "rdfs:comment": {
    "de": [
      "Nomad Bike ist ein Fahrradverleihservice für E-Bikes und klassische Fahrräder am Ufer des Lac d'Annecy. Unsere Basis befindet sich im Espace Lac d'Angon, nur einen Steinwurf vom Radweg und den Stränden entfernt."
    ],
    "en": [
      "Nomad Bike is an electric and standard bike hire service on the shores of Lake Annecy. We are based at the heart of the Espace Lac d'Angon, a stone's throw from the cycle path and beaches."
    ],
    "it": [
      "Nomad Bike è un servizio di noleggio di biciclette elettriche e classiche situato sulle rive del lago di Annecy. Le nostre basi di noleggio si trovano in riva al lago ad Angon e sulla pista ciclabile a Doussard."
    ],
    "fr": [
      "Nomad Bike est un service de location de vélos électriques et classiques situé au bord du lac d’Annecy. Nos bases de locations sont situées au bord de l'eau à Angon et au bord de la piste cyclable à Doussard."
    ],
    "nl": [
      "Nomad Bike is een verhuurbedrijf van elektrische en klassieke fietsen aan de oevers van het meer van Annecy. Onze verhuurbases bevinden zich aan het water in Angon en aan het fietspad in Doussard."
    ],
    "es": [
      "Nomad Bike es un servicio de alquiler de bicicletas eléctricas y clásicas situado a orillas del lago de Annecy. Nuestras bases de alquiler están situadas junto al agua en Angon y junto al carril bici en Doussard."
    ]
  },
