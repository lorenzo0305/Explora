  "rdfs:comment": {
    "de": [
      "Saint-Galmier gehört nicht umsonst zu den \"100 Plus Beaux Détours de France\" (100 schönste Orte in Frankreich)! Wenn Sie einen kleinen Abstecher in die Stadt machen, werden Sie ein malerisches und liebenswertes Städtchen entdecken."
    ],
    "en": [
      "Saint-Galmier is one of the \"100 Most Beautiful Detours in France\" for good reason! Take a short detour through the town and you'll discover a picturesque and charming village."
    ],
    "it": [
      "Saint-Galmier è una delle \"100 deviazioni più belle di Francia\" per un motivo preciso! Se fate una deviazione attraverso la città, scoprirete un villaggio pittoresco e affascinante."
    ],
    "fr": [
      "Si Saint-Galmier fait partie des \"100 Plus Beaux Détours de France\", ce n'est pas pour rien ! En faisant un petit crochet par la ville, vous découvrirez un bourg pittoresque et attachant."
    ],
    "nl": [
      "Saint-Galmier is niet voor niets een van de \"100 mooiste ommetjes in Frankrijk\"! Maak een omweg door het stadje en je ontdekt een pittoresk en charmant dorpje."
    ],
    "es": [
      "Por algo Saint-Galmier es uno de los \"100 desvíos más bellos de Francia\" Desvíese por la ciudad y descubrirá un pueblo pintoresco y encantador."
    ]
  },
