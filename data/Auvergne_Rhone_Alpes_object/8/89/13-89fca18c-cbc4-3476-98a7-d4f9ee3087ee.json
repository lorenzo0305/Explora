  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über bietet das Vesprade-Kino in Zusammenarbeit mit dem Maison de l'Image Filmvorführungen, Festivals und „ciné-goûter“-Veranstaltungen für junge Zuschauer an."
    ],
    "en": [
      "Throughout the year, the Vesprade cinema offers film screenings, festivals and ‘ciné-goûter’ events for young audiences in partnership with the Maison de l'Image."
    ],
    "it": [
      "Durante tutto l'anno, il cinema Vesprade offre proiezioni di film, festival ed eventi \"ciné-goûter\" per il pubblico giovane in collaborazione con la Maison de l'Image."
    ],
    "fr": [
      "Tout au long de l’année, le cinéma de la Vesprade vous propose des projections de films, festivals, des rendez-vous pour le jeune public \"ciné-goûter\" en partenariat avec la Maison de l’Image."
    ],
    "nl": [
      "Het hele jaar door biedt de Vesprade-bioscoop filmvertoningen, festivals en \"ciné-goûter\"-evenementen voor een jong publiek in samenwerking met het Maison de l'Image."
    ],
    "es": [
      "A lo largo de todo el año, el cine Vesprade ofrece proyecciones de películas, festivales y eventos \"ciné-goûter\" para el público joven en colaboración con la Maison de l'Image."
    ]
  },
