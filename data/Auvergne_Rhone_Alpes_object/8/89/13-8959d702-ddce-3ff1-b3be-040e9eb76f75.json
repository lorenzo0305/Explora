  "rdfs:comment": {
    "de": [
      "Le Chalet ist Ihr neues Spezialitätenrestaurant in Savoyen.\r\nWir bieten Ihnen Raclette à la Meule, Fondues Savoyardes, Tartiflette, Croziflette, Matafan... und viele andere Spezialitäten aus den Bergen, die es zu entdecken gilt, und das alles in einem atypischen Rahmen!"
    ],
    "en": [
      "Le Chalet is your new Savoyard Speciality Restaurant.\r\nWe offer Raclettes à la Meule, Fondues Savoyardes, Tartiflette, Croziflette, Matafan... and many other mountain specialties to discover, all in an unusual setting!"
    ],
    "it": [
      "Lo Chalet è il vostro nuovo ristorante di specialità savoiarde.\r\nOffriamo raclettes à la meule, fondues savoyardes, tartiflette, croziflette, matafan... e tante altre specialità di montagna da scoprire, il tutto in un ambiente insolito!"
    ],
    "fr": [
      "Le Chalet est votre nouveau restaurant de spécialités savoyardes.\r\nNous vous proposons raclettes à la meule, fondues savoyardes, tartiflette, croziflette, matafan.. et plein d'autres spécialités de montagne à découvrir, le tout dans un cadre atypique !"
    ],
    "nl": [
      "Le Chalet is uw nieuwe Savoyaardse specialiteitenrestaurant.\r\nWij bieden Raclettes à la Meule, Fondues Savoyardes, Tartiflette, Croziflette, Matafan... en nog veel meer bergspecialiteiten om te ontdekken, allemaal in een ongewone omgeving!"
    ],
    "es": [
      "Le Chalet es su nuevo restaurante de especialidades saboyanas.\r\nLe proponemos raclettes à la meule, fondues savoyardes, tartiflette, croziflette, matafan... y muchas otras especialidades de montaña por descubrir, ¡todo ello en un marco insólito!"
    ]
  },
