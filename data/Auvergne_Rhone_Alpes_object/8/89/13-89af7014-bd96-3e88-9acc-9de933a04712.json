  "rdfs:comment": {
    "de": [
      "Die Skischule von Combloux besteht aus 120 Lehrern und Lehrerinnen: Gruppenunterricht, Privatunterricht, Minikurse, Wettkampfkurse, Snowboardkurse, Handiski, Skitaxi...\r\n2 Büros: eines im Zentrum des Dorfes und das zweite am Fuße der Pisten."
    ],
    "en": [
      "The Combloux Ski School is made up of 120 instructors: group and private lessons, mini lessons, competition courses, snowboarding courses, handiskiing, taxi-skiing...\r\n2 offices: one in the centre of the village and the second at the foot of the slopes."
    ],
    "it": [
      "La Scuola di Sci Combloux è composta da 120 maestri: lezioni di gruppo e private, mini lezioni, corsi di gara, corsi di snowboard, handiski, taxi-ski...\r\n2 uffici: uno nel centro del paese e l'altro ai piedi delle piste."
    ],
    "fr": [
      "L'Ecole du Ski de Combloux se compose de 120 moniteurs et monitrices : cours collectifs, privés, mini cours, stage compétition, stage snowboard, handiski, taxi-ski...\r\n2 bureaux : un au centre du village et le second au pied des pistes."
    ],
    "es": [
      "La Escuela de Esquí de Combloux está compuesta por 120 instructores: clases grupales y privadas, mini clases, cursos de competición, cursos de snowboard, handiski, taxis...\r\n2 oficinas: una en el centro del pueblo y la segunda al pie de las laderas."
    ],
    "nl": [
      "De skischool Combloux heeft 120 instructeurs: groepslessen, privélessen, minilessen, wedstrijdlessen, snowboardlessen, handiskiën, taxiskiën...\r\n2 kantoren: een in het centrum van het dorp en de tweede aan de voet van de pistes."
    ]
  },
