  "rdfs:comment": {
    "de": [
      "Familienbauernhof mit biologischem Anbau am Fuße der Lance, um Qualitätsprodukte aus der Region zu entdecken: Aprikosenkonfitüre, Aprikosencoulis, Aprikosenpaste, Aprikosennektar, Milchlamm, Kartoffeln."
    ],
    "en": [
      "Family-run organic farm at the foot of the Lance. Come and discover our quality local produce: apricot jam, apricot coulis, apricot paste, apricot nectar, milk-fed lamb, potatoes."
    ],
    "it": [
      "Azienda agricola a conduzione familiare, in regime di agricoltura biologica, ai piedi della Lancia per scoprire prodotti di qualità e locali: Marmellata di albicocche, coulis di albicocche, pasta di albicocche, nettare di albicocche, agnello da latte, patate."
    ],
    "fr": [
      "Ferme familiale, en agriculture biologique, au pied de la Lance pour découvrir des produits de qualité et du terroir : Confiture d'abricot, coulis d'abricot, pâte d'abricot, nectar d'abricot, agneau de lait, pommes de terres."
    ],
    "es": [
      "Granja familiar, en agricultura ecológica, al pie del Lance para descubrir productos de calidad y locales: Mermelada de albaricoque, coulis de albaricoque, pasta de albaricoque, néctar de albaricoque, cordero lechal, patatas."
    ],
    "nl": [
      "Familieboerderij met biologische landbouw, aan de voet van de Lance, waar u streekproducten van hoge kwaliteit vindt: abrikozenjam, abrikozencoulis, abrikozenpasta, abrikozennectar, zuiglam, aardappels."
    ]
  },
