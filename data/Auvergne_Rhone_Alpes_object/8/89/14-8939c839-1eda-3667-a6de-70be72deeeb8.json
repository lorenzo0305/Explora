  "rdfs:comment": {
    "de": [
      "Luc et Vaiteani ist die Hybridhymne zwischen dem Elsass und Tahiti. Polynesian Folk\", der aus dem Nichts auftaucht, uns einfängt und uns mit einer ganz neuen Sinnlichkeit umschmeichelt."
    ],
    "en": [
      "Luc and Vaiteani is the hybrid hymen of Alsace and Tahiti. Polynesian Folk\" that pops up at the drop of a hat, that captures and caresses us in a brand new sensuality."
    ],
    "it": [
      "Luc et Vaiteani è l'imene ibrido di Alsazia e Tahiti. Folk polinesiano\" che spunta fuori all'improvviso, catturandoci e accarezzandoci in una sensualità tutta nuova."
    ],
    "fr": [
      "Luc et Vaiteani c’est l’hymen hybride de l’Alsace et de Tahiti. De la « Polynesian Folk » qui surgit à brûle-pourpoint, qui nous capture et nous caresse dans une sensualité toute nouvelle."
    ],
    "nl": [
      "Luc et Vaiteani is het hybride mengsel van de Elzas en Tahiti. Polynesische folk\" die in een oogwenk de kop opsteekt, ons vangt en streelt in een geheel nieuwe sensualiteit."
    ],
    "es": [
      "Luc et Vaiteani es el himen híbrido de Alsacia y Tahití. Folk polinesio\" que surge de un momento a otro, capturándonos y acariciándonos en una sensualidad inédita."
    ]
  },
