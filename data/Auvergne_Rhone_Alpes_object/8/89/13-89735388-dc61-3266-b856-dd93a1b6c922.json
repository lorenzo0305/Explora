  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Hotel Le Régina in Le Puy-en-Velay, eine perfekte Mischung aus Kühnheit und Einfachheit. Genießen Sie komfortable Zimmer, ein raffiniertes Restaurant und einen tadellosen Service. Das alles ist leicht zugänglich und ideal am Jakobsweg gelegen."
    ],
    "en": [
      "Discover Hôtel Le Régina in Le Puy-en-Velay, a perfect blend of boldness and simplicity. Enjoy comfortable rooms, a refined restaurant and impeccable service, all within easy reach and ideally located on the Chemin de St Jacques."
    ],
    "it": [
      "Scoprite l'Hôtel Le Régina a Le Puy-en-Velay, una miscela perfetta di audacia e semplicità. Godetevi camere confortevoli, un ristorante raffinato e un servizio impeccabile, il tutto a portata di mano e in posizione ideale sul cammino di Santiago de Compostela."
    ],
    "fr": [
      "Découvrez l'Hôtel Le Régina au Puy-en-Velay, mélange parfait d'audace et de simplicité. Profitez de chambres confortables, d'un restaurant raffiné et d'un service impeccable, le tout accessible et idéalement situé sur le chemin de St Jacques."
    ],
    "nl": [
      "Ontdek Hôtel Le Régina in Le Puy-en-Velay, een perfecte combinatie van durf en eenvoud. Geniet van comfortabele kamers, een verfijnd restaurant en een onberispelijke service, allemaal binnen handbereik en ideaal gelegen op de route naar Santiago de Compostela."
    ],
    "es": [
      "Descubra el Hôtel Le Régina en Le Puy-en-Velay, una mezcla perfecta de audacia y sencillez. Disfrute de cómodas habitaciones, un refinado restaurante y un servicio impecable, todo al alcance de la mano e idealmente situado en el camino de Santiago de Compostela."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Le Regina****"
    ]
  },
