  "rdfs:comment": {
    "de": [
      "In einem speziellen Bereich für Sehhilfen können Sie Ihre Sonnenbrillen und Korrektionsbrillen frei auswählen und dabei vom Fachwissen und der Beratung unserer Optiker profitieren."
    ],
    "en": [
      "In a space dedicated to sight, you can choose your sunglasses and glasses freely while benefiting from the expertise and advice of our opticians."
    ],
    "it": [
      "In un'area dedicata agli occhiali, potrete scegliere liberamente i vostri occhiali da sole e da vista, beneficiando della competenza e dei consigli dei nostri ottici."
    ],
    "fr": [
      "Dans un espace dédié à la vue, vous pourrez choisir vos lunettes de soleil et lunettes de vue librement tout en bénéficiant de l'expertise et du conseil de nos opticiens."
    ],
    "nl": [
      "In een speciale ruimte voor brillen kunt u vrij uw zonnebrillen en brillen op sterkte kiezen en profiteren van de expertise en het advies van onze opticiens."
    ],
    "es": [
      "En un espacio dedicado a las gafas, podrá elegir libremente sus gafas de sol y sus gafas graduadas mientras se beneficia de la experiencia y los consejos de nuestros ópticos."
    ]
  },
  "rdfs:label": {
