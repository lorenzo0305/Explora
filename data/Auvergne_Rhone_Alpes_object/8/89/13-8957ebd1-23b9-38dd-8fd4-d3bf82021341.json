  "rdfs:comment": {
    "de": [
      "1 km langer Rundgang über 45 Minuten, um die mittelalterliche Stadt und ihre zahlreichen Überreste mit erklärenden Schildern zu entdecken.\r\n\r\nFührungen durch den Marktflecken und das Schlossmuseum des Mönchs-Sakristans sind nach vorheriger Reservierung unter 04 77 35 26 55 möglich"
    ],
    "en": [
      "A 1km, 45-minute tour of the medieval town and its many remains, with explanatory panels.\r\n\r\nGuided tours of the town and the castle-museum of the monk-sacristan are available on reservation by calling 04 77 35 26 55"
    ],
    "it": [
      "Un tour di 1 km e 45 minuti della città medievale e dei suoi numerosi resti, con pannelli esplicativi.\r\n\r\nLe visite guidate al villaggio e al castello-museo del monaco-sacrestano sono disponibili su prenotazione chiamando il numero 04 77 35 26 55"
    ],
    "fr": [
      "Parcours de 1 kilomètre sur 45 minutes pour découvrir le bourg médiéval et ses nombreux vestiges avec panneaux explicatifs.\r\n\r\nDes visites guidées du bourg et du château-musée du moine-sacristain sont possibles sur réservation au 04 77 35 26 55"
    ],
    "es": [
      "Recorrido de 1 km y 45 minutos por la ciudad medieval y sus numerosos vestigios, con paneles explicativos.\r\n\r\nVisitas guiadas del pueblo y del castillo-museo del monje-sacristán disponibles previa reserva llamando al 04 77 35 26 55"
    ],
    "nl": [
      "Een rondleiding van 1 km en 45 minuten door de middeleeuwse stad en de vele overblijfselen, met verklarende panelen.\r\n\r\nRondleidingen door het dorp en het kasteel-museum van de monnik-sacristan zijn beschikbaar op reservering via 04 77 35 26 55"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite du bourg médiéval d'Aurec-sur-Loire"
    ]
  },
