  "rdfs:comment": {
    "de": [
      "Eine Boutique mit Kinderkleidung, aber nicht nur. Man findet auch Accessoires, Schmuck, Taschen ... Das ganze Jahr über werden Workshops für Kinder und Erwachsene veranstaltet."
    ],
    "en": [
      "Store for children's clothing but not only. You can find accessories, jewelry, bags ... Workshops are organized all year long for children and adults."
    ],
    "it": [
      "Negozio di abbigliamento per bambini ma non solo. Si possono trovare accessori, gioielli, borse... Tutto l'anno vengono organizzati laboratori per bambini e adulti."
    ],
    "fr": [
      "Boutique de vêtements pour enfants mais pas que. On déniche des accessoires, bijoux, sacs ... Des ateliers sont organisés toute l'année à destination des enfants et des adultes."
    ],
    "es": [
      "Tienda de ropa infantil, pero no sólo. Puedes encontrar complementos, bisutería, bolsos... Durante todo el año se organizan talleres para niños y adultos."
    ],
    "nl": [
      "Kinderkledingwinkel maar niet alleen. U vindt er accessoires, juwelen, tassen ... Het hele jaar door worden er workshops georganiseerd voor kinderen en volwassenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tout et son contraire - boutique et ateliers"
