  "rdfs:comment": {
    "de": [
      "Raum für Seminare, Versammlungen, Ausstellungen, Verkauf an Privatpersonen.\r\n50m² großer Raum mit viel Licht, der den Eindruck vermittelt, sich im Freien zu befinden. Profitiert von einem eigenen Eingang. Kaffeemaschine vor Ort."
    ],
    "en": [
      "Room for seminars, meetings, exhibitions, private sales.\r\n50m² room with plenty of natural light, giving the impression of being outdoors. Separate entrance. Coffee machine on site."
    ],
    "it": [
      "Sala per seminari, riunioni, mostre e vendite private.\r\nSala di 50 m² con molta luce naturale, che dà l'impressione di essere all'aperto. Ingresso separato. Macchina del caffè in loco."
    ],
    "fr": [
      "Salle de séminaire, réunion, exposition, vente aux particuliers.\r\nSalle de 50m² avec une luminosité importante qui donne l'impression d'être à l'extérieur. Bénéficie d'une entrée indépendante. Machine à café sur place."
    ],
    "es": [
      "Sala para seminarios, reuniones, exposiciones y ventas privadas.\r\nSala de 50 m² con mucha luz natural, que da la impresión de estar al aire libre. Entrada independiente. Máquina de café in situ."
    ],
    "nl": [
      "Ruimte voor seminars, vergaderingen, tentoonstellingen en privéverkoop.\r\nRuimte van 50 m² met veel daglicht, waardoor het lijkt alsof je buiten bent. Aparte ingang. Koffiezetapparaat ter plaatse."
    ]
  },
