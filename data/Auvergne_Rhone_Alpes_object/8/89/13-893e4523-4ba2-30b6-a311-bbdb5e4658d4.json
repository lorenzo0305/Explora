  "rdfs:comment": {
    "de": [
      "Ein immersiver und sensorischer Rundgang durch das Herz der Weinrebe und des Weins. Entdecken, berühren, riechen, lernen und verkosten Sie bis zu 8 Weine in den Gewölbekellern eines alten Gebäudes in Lyon. Ein einzigartiges, spielerisches und kulturelles Erlebnis!"
    ],
    "en": [
      "An immersive and sensory journey through the world of vines and wine. Discover, touch, smell, learn and taste up to 8 wines in the vaulted cellars of a historic Lyon building. A unique, fun and cultural experience!"
    ],
    "it": [
      "Un viaggio immersivo e sensoriale nel cuore della vite e del vino. Scoprite, toccate, annusate, imparate e degustate fino a 8 vini nelle cantine a volta di un antico edificio lionese. Un'esperienza unica, divertente e culturale!"
    ],
    "fr": [
      "Un parcours immersif et sensoriel au cœur de la vigne et du vin. Découvrez, touchez, sentez, apprenez et dégustez jusqu’à 8 vins dans les caves voûtées d’un ancien immeuble lyonnais. Une expérience unique, ludique et culturelle !"
    ],
    "es": [
      "Un viaje inmersivo y sensorial al corazón de la viña y el vino. Descubra, toque, huela, aprenda y deguste hasta 8 vinos en las bodegas abovedadas de un antiguo edificio lionés. Una experiencia única, lúdica y cultural"
    ],
    "nl": [
      "Een meeslepende, zintuiglijke reis naar het hart van wijnstokken en wijn. Ontdek, voel, ruik, leer en proef tot 8 wijnen in de gewelfde kelders van een oud Lyonnais gebouw. Een unieke, leuke en culturele ervaring!"
    ]
  },
