  "rdfs:comment": {
    "de": [
      "Der Picknickplatz von de Rémy befindet sich in der Nähe des Bois de Rémy und ist mit Tischen, Mülleimern und einem Parkplatz in der Nähe ausgestattet."
    ],
    "en": [
      "The picnic area of de Rémy is located near the woods of Rémy and is equipped with tables, rubbish bins and a car park nearby."
    ],
    "it": [
      "Situata vicino al bosco di Rémy, l'area picnic di Rémy è attrezzata con tavoli, cestini e un parcheggio nelle vicinanze."
    ],
    "fr": [
      "Située à proximité du bois de Rémy, l'aire de pique-nique de de Rémy est équipée de tables, poubelles et d'un parking à proximité."
    ],
    "es": [
      "Situado cerca del bosque de Rémy, el merendero de Rémy está equipado con mesas, papeleras y un aparcamiento cercano."
    ],
    "nl": [
      "De picknickplaats Rémy bevindt zich in de buurt van het bos en is uitgerust met tafels, vuilnisbakken en een parkeerplaats in de buurt."
    ]
  },
