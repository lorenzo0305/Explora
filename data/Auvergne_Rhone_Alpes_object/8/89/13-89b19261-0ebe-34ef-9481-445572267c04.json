  "rdfs:comment": {
    "de": [
      "Das Café-Restaurant La Table de Dorian empfängt Sie im Herzen des Dorfes Laurac-en-Vivarais. Traditionelle und leckere Küche an einem geselligen Ort. Auch Catering-Service."
    ],
    "en": [
      "The Café-Restaurant La Table de Dorian welcomes you to the heart of the village of Laurac-en-Vivarais. Traditional gourmet cuisine in a friendly setting."
    ],
    "it": [
      "Il Café-Restaurant La Table de Dorian vi accoglie nel cuore del villaggio di Laurac-en-Vivarais. Cucina tradizionale gourmet in un ambiente accogliente. È disponibile anche il servizio di catering."
    ],
    "fr": [
      "Le Café-Restaurant La Table de Dorian vous accueille au cœur du village de Laurac-en-Vivarais. Une cuisine traditionnelle et gourmande dans un lieu convivial. Service de traiteur également."
    ],
    "es": [
      "El Café-Restaurante La Table de Dorian le da la bienvenida al corazón del pueblo de Laurac-en-Vivarais. Cocina gastronómica tradicional en un ambiente acogedor. Servicio de catering también disponible."
    ],
    "nl": [
      "Café-Restaurant La Table de Dorian heet u welkom in het hart van het dorp Laurac-en-Vivarais. Traditionele gastronomische keuken in een vriendelijke omgeving. Catering service ook beschikbaar."
    ]
  },
