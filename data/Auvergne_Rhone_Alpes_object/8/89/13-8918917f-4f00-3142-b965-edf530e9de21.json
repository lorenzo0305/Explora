  "rdfs:comment": {
    "de": [
      "Nachdem er die Welt bereist hat, bietet Ihnen Michel Seyve in seinem gemütlichen Restaurant traditionelle und Weltküche, die mit lokalen und saisonalen Zutaten zubereitet wird. Sie wird in Gläsern serviert und kann vor Ort genossen oder mitgenommen werden."
    ],
    "en": [
      "After traveling the world for more then 30 years. In his cozy restaurant, Chef Michel Seyve offers traditional French and international cuisine prepared with all local and seasonal ingredients. He serves his food in jar or take away."
    ],
    "it": [
      "Dopo aver viaggiato in tutto il mondo, Michel Seyve vi propone la sua cucina tradizionale e mondiale, preparata con ingredienti locali e di stagione nel suo accogliente ristorante. Servito in vasetti, può essere gustato sul posto o portato via."
    ],
    "fr": [
      "Après avoir voyagé à travers le monde, Michel Seyve vous offre sa cuisine traditionnelle et du monde préparée avec des ingrédients locaux et de saison dans son restaurant chaleureux. Servie en bocaux, elle peut être dégustée sur place ou être emportée."
    ],
    "es": [
      "Tras haber viajado por todo el mundo, Michel Seyve le ofrece su cocina tradicional y mundial preparada con ingredientes locales y de temporada en su acogedor restaurante. Servido en tarros, puede disfrutarse in situ o llevarse."
    ],
    "nl": [
      "Michel Seyve heeft de hele wereld afgereisd en biedt je in zijn gezellige restaurant zijn traditionele en wereldkeuken, bereid met lokale en seizoensgebonden ingrediënten. De gerechten worden geserveerd in potten en kunnen ter plaatse worden genuttigd of worden meegenomen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le CresToranT"
    ]
  },
