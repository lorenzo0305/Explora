  "rdfs:comment": {
    "de": [
      "Musiktherapie, Psychotherapie, Entspannung, Traumdeutung, Chi Ney Tsang. Praktikum zur Selbstfindung und persönlichen Entwicklung durch Klang.\r\nMithilfe von Klang und seiner starken Schwingungskraft eine Veränderung herbeiführen und persönliche Arbeit leisten."
    ],
    "en": [
      "Music therapy is a wonderful way of healing.\r\nIt is for people looking for calm and better being.\r\nI propose workshops in different structures and ecological places"
    ],
    "it": [
      "Musicoterapia, psicoterapia, rilassamento, interpretazione dei sogni, Chi Ney Tsang. Un corso di sviluppo personale e di guarigione attraverso il suono.\r\nRaggiungere il cambiamento personale e il lavoro attraverso il suono e il suo potente potere vibratorio."
    ],
    "fr": [
      "Musicothérapie, psychothérapie, relaxation, interprétation des rêves, Chi Ney Tsang. Stage de ressourcement et développement personnel par le son.\r\nRéaliser un changement et un travail personnel grâce au son et son puissant pouvoir vibratoire."
    ],
    "nl": [
      "Muziektherapie, psychotherapie, ontspanning, droominterpretatie, Chi Ney Tsang. Herbronning en persoonlijke ontwikkeling door middel van geluid.\r\nPersoonlijke verandering en werk bereiken door middel van geluid en zijn krachtige vibrerende kracht."
    ],
    "es": [
      "Musicoterapia, psicoterapia, relajación, interpretación de sueños, Chi Ney Tsang. Un curso de desarrollo personal y sanación a través del sonido.\r\nLograr el cambio personal y el trabajo a través del sonido y su poderoso poder vibratorio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Verson'or"
    ]
  },
