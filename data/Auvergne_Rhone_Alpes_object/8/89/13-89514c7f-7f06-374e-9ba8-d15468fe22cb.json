  "rdfs:comment": {
    "de": [
      "Kurse für Kinder und Erwachsene, um zu lernen oder sich zu verbessern.\r\nAlle Techniken: Zeichnung, Pastell, Tinte, Aquarell, Öl, Acryl...\r\nArbeit mit Farben, Annäherung an die Komposition, Porträt und menschlicher Körper, Landschaft, figurative und abstrakte Kunst..."
    ],
    "en": [
      "Courses for children or adults to learn or improve.\r\nall techniques: drawing, pastel, ink, watercolor, oil, acrylic...\r\nWork on color, composition approach, portrait and human body, landscape, figurative art, abstract..."
    ],
    "it": [
      "Corsi per bambini o adulti per imparare o migliorare.\r\ntutte le tecniche: disegno, pastello, inchiostro, acquerello, olio, acrilico...\r\nLavoro sul colore, approccio alla composizione, ritratto e corpo umano, paesaggio, arte figurativa, astratto..."
    ],
    "fr": [
      "Cours enfant ou adulte pour apprendre ou se perfectionner.\r\ntoutes techniques : dessin, pastel, encre, aquarelle, huile, acrylique...\r\nTravail sur la couleur, approche de la composition, portrait et corps humain, paysage, art figuratif, abstrait..."
    ],
    "nl": [
      "Cursussen voor kinderen of volwassenen om te leren of te verbeteren.\r\nalle technieken: tekenen, pastel, inkt, aquarel, olieverf, acryl...\r\nWerk aan kleur, benadering van compositie, portretten en het menselijk lichaam, landschap, figuratieve en abstracte kunst..."
    ],
    "es": [
      "Cursos para que los niños o los adultos aprendan o mejoren.\r\ntodas las técnicas: dibujo, pastel, tinta, acuarela, óleo, acrílico...\r\nTrabajo sobre el color, enfoque de la composición, retrato y cuerpo humano, paisaje, arte figurativo, abstracto..."
    ]
  },
