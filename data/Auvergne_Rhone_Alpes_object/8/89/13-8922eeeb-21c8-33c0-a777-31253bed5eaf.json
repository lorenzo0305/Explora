  "rdfs:comment": {
    "de": [
      "Sicherstellung des Schutzes der alten Denkmäler in der Drôme Suche nach zu schützenden Elementen des Kulturerbes und Bekanntmachung dieser Elemente. Fête de la\r\nTour Wanderungen, Lottos und Ausflüge, um alte Denkmäler des Departements zu entdecken."
    ],
    "en": [
      "Safeguard the ancient monuments of the Drôme. Identify heritage elements to be safeguarded and publicize them. Fête de la\r\nTour Hiking, bingo and outings to discover the department's ancient monuments."
    ],
    "it": [
      "Assicurare la salvaguardia dei monumenti antichi della Drôme, ricercare gli elementi del patrimonio da salvaguardare e farli conoscere. Festa della\r\nTour Randonnee, bingo e uscite alla scoperta degli antichi monumenti del dipartimento."
    ],
    "fr": [
      "Assurer la sauvegarde des monuments anciens de la Drôme rechercher les éléments du patrimoine à sauvegarder et les faire connaître. Fête de la \r\nTour Randonne, lotos et sorties pour découvrir monuments anciens du département."
    ],
    "es": [
      "Velar por la salvaguardia de los monumentos antiguos de la Drôme, buscar los elementos del patrimonio que hay que salvaguardar y darlos a conocer. Fiesta de la\r\nTour Randonnee, bingo y salidas para descubrir antiguos monumentos del departamento."
    ],
    "nl": [
      "Bescherming van de oude monumenten van de Drôme. Identificatie van te beschermen erfgoedelementen en de bekendmaking ervan. Fête de la\r\nTour Wandelen, bingo en uitstapjes om de oude monumenten van het departement te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nyons-Patrimoine Société de Sauvegarde des Monuments anciens"
    ]
  },
