  "rdfs:comment": {
    "de": [
      "Das Hotel Europole ist ein internationales Hotel für Geschäftsreisende und Touristen und befindet sich im Herzen des Geschäftsviertels Europole. 100 m vom Bahnhof entfernt, in der Nähe der Straßenbahnen A und B, mit denen Sie sich problemlos fortbewegen können (Haltestelle Palais de Justice 20 m)."
    ],
    "en": [
      "Europole hotel is an international business and touristic hotel, benefiting from an ideal location in the heart of the business district,Europole. Situated only 100m from the train station and close proximity to trams A and B (Stop: Palais de Justice 20m)"
    ],
    "it": [
      "L'Hotel Europole, a vocazione internazionale di affari e di turismo, si trova nel cuore del quartiere d'affari Europole. A 100m dalla stazione, vicino ai tram A e B che Le permetteranno di muoversi facilmente (fermata Palais de Justice a 20m)."
    ],
    "fr": [
      "L'hôtel Europole, à vocation internationale d'affaires et de tourisme,est implanté au cœur du quartier d'affaire Europole. A 100m de la gare,proximité des trams A et B qui vous permettront de vous déplacer en toute simplicité (arrêt Palais de Justice 20m)"
    ],
    "nl": [
      "Het Europole hotel, met een internationale zakelijke en toeristische roeping, ligt in het hart van de Europole zakenwijk. 100m van het station, dicht bij de trams A en B waarmee u zich gemakkelijk kunt verplaatsen (halte Paleis van Justitie 20m)"
    ],
    "es": [
      "El hotel Europole, especializado en los negocios y el turismo internacional, se situa en el corazón del distrito financiero. A 100m de la estación de trenes, cerca de los tranvías A y B, se podrá moverse fácilmente (parada \"Palais de Justice\" a 20 metros)"
    ]
  },
