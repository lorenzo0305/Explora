  "rdfs:comment": {
    "de": [
      "Biologisch bewirtschafteter Bauernhof, Montbéliard-Kühe. Kleine Produktion von Bergkäse, Quark, Sahne und frischem Tomme. Derzeit keine Besichtigung des Hofes möglich, nur Verkauf."
    ],
    "en": [
      "Organic agricultural farm with Montbéliard cows. Production of mountain-type cheeses, , fromage blanc, cream and fresh tomme. No more farm visits for the moment, only the sale."
    ],
    "it": [
      "Azienda agricola biologica, vacche Montbéliarde. Piccola produzione di formaggi di montagna, fromage blanc, panna e tomme fresco. Per il momento non sono previste visite alla fattoria, ma solo vendite."
    ],
    "fr": [
      "Ferme en agriculture biologique, vaches montbéliardes. Petite production de fromages type montagne, fromage blanc, crème et tomme fraîche. Pas de visite de la ferme pour le  moment, uniquement la vente."
    ],
    "es": [
      "Granja ecológica, vacas de Montbéliarde. Pequeña producción de quesos de montaña, fromage blanc, nata y tomme fresco. No hay visitas a la granja por el momento, sólo ventas."
    ],
    "nl": [
      "Biologische boerderij, Montbéliarde koeien. Kleine productie van bergkazen, fromage blanc, room en verse tomme. Momenteel geen boerderijbezoeken, alleen verkoop."
    ]
  },
