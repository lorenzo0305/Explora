  "rdfs:comment": {
    "de": [
      "Die GAEC de la Besseye ist ein Bauernhof mit biologischer Rinderzucht. Die Kühe werden mit Leidenschaft und Respekt aufgezogen und entwickeln sich unter den besten Bedingungen mit einem Futter, das vom Hof und seinen weitläufigen Weideflächen stammt."
    ],
    "en": [
      "The GAEC de la Besseye is an organic cattle breeding farm. Raised with passion and respect, our cows thrive in the best possible conditions, with feed sourced from the farm and its vast pastures."
    ],
    "it": [
      "Il GAEC de la Besseye è un allevamento di bovini biologici. Allevate con passione e rispetto, le mucche crescono nelle migliori condizioni possibili grazie all'alimentazione della fattoria e dei suoi vasti pascoli."
    ],
    "fr": [
      "Le GAEC de la Besseye est une ferme d'élevage bovin biologique. Élevées avec passion et respect, les vaches évoluent dans les meilleures conditions avec une alimentation issue de la ferme et de ses vastes espaces de pâtures."
    ],
    "es": [
      "El GAEC de la Besseye es una explotación de vacuno ecológico. Criadas con pasión y respeto, las vacas prosperan en las mejores condiciones gracias a la alimentación procedente de la granja y sus vastos pastos."
    ],
    "nl": [
      "De GAEC de la Besseye is een biologisch rundveebedrijf. De koeien worden met passie en respect grootgebracht en gedijen onder de best mogelijke omstandigheden met voer van de boerderij en haar uitgestrekte weilanden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de la Besseye"
    ]
  },
