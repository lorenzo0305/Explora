  "rdfs:comment": {
    "de": [
      "Genießen Sie am Fuße des Jura-Gebirges die hausgemachten Spezialitäten: Rindertartar, Froschschenkel, Savoyer Spezialitäten, Fisch (Jakobsmuscheln, Jakobsmuscheln)."
    ],
    "en": [
      "At the foot of the Monts Jura, enjoy the house specialties: beef tartar, frog legs, Savoyard specialties, fish (scallops)."
    ],
    "it": [
      "Ai piedi dei Monts Jura, gustate le specialità della casa: tartare di manzo, cosce di rana, specialità savoiarde, pesce (capesante)."
    ],
    "fr": [
      "Au pied des Monts Jura, savourez les spécialités maison : tartare de boeuf, cuisses de grenouilles, spécialités savoyardes, poissons (St Jacques, pétoncles)."
    ],
    "es": [
      "Al pie de los Montes Jura, disfrute de las especialidades de la casa: tartar de ternera, ancas de rana, especialidades saboyanas, pescado (vieiras)."
    ],
    "nl": [
      "Aan de voet van de Monts Jura kunt u genieten van de specialiteiten van het huis: tartaar van rundvlees, kikkerbilletjes, Savoyaardse specialiteiten, vis (sint-jakobsschelpen)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bistrot Gourmand Restaurant"
    ],
    "fr": [
      "Restaurant Le Bistrot Gourmand"
    ]
  },
