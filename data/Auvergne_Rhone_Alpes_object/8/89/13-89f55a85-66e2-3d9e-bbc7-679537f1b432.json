  "rdfs:comment": {
    "de": [
      "Domaine des Maisons Neuves mit zahlreichen Auszeichnungen und Medaillen.\nFünf Generationen Leidenschaft am Fuße des Mont Brouilly. Zum besten Gamay der Welt 2016 gewählt. Eine authentische Signatur der Crus du Beaujolais und der außergewöhnlichen Rebsorten."
    ],
    "en": [
      "Domaine des Maisons Neuves, with its many awards and medals.\nFive generations of passion at the foot of Mont Brouilly.\nVoted Best Gamay in the World 2016.\nAn authentic signature of the Beaujolais Crus and exceptional grape varieties."
    ],
    "it": [
      "Domaine des Maisons Neuves, vincitore di numerosi premi e medaglie.\nCinque generazioni di passione ai piedi del Mont Brouilly. Votato come miglior Gamay del mondo 2016. Un'autentica firma dei crus del Beaujolais e di vitigni eccezionali."
    ],
    "fr": [
      "Domaine des Maisons Neuves aux multiples récompenses et médailles.\nCinq générations de passion au pied du Mont Brouilly. Élu Meilleur Gamay du Monde 2016. Une signature authentique des Crus du Beaujolais et de cépages d’exception."
    ],
    "nl": [
      "Domaine des Maisons Neuves, winnaar van talrijke prijzen en medailles.\nVijf generaties passie aan de voet van de Mont Brouilly. Uitgeroepen tot beste Gamay ter wereld 2016. Een authentieke signatuur van de Crus Beaujolais en uitzonderlijke druivenrassen."
    ],
    "es": [
      "Domaine des Maisons Neuves, ganador de numerosos premios y medallas.\nCinco generaciones de pasión a los pies del Mont Brouilly. Elegido mejor Gamay del mundo 2016. Una auténtica firma de los Crus de Beaujolais y de variedades de uva excepcionales."
    ]
  },
  "rdfs:label": {
