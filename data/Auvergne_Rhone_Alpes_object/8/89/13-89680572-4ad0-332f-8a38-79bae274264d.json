  "rdfs:comment": {
    "de": [
      "Valérie und Rodolphe empfangen Sie jeden Tag ab 7 Uhr.\r\nMenüs jeden Mittag aus frischen und lokalen Produkten.\r\nJeden Abend auf Reservierung ab 8 Personen.\r\nTeestube an den Nachmittagen."
    ],
    "en": [
      "Valérie and Rodolphe welcome you every day from 7am.\nLunch time menus serving fresh and local produce.\nEvery evening by reservation for 8 or more people.\nTea room service in the afternoons."
    ],
    "it": [
      "Valérie e Rodolphe vi accolgono ogni giorno dalle 7 del mattino\r\nMenù a pranzo con prodotti freschi e locali.\r\nOgni sera su prenotazione a partire da 8 persone.\r\nSala da tè nel pomeriggio."
    ],
    "fr": [
      "Valérie et Rodolphe vous accueillent tous les jours à partir de 7h. \r\nMenus tous les midis à partir de produits frais et locaux.\r\nTous les soirs sur réservation à partir de 8 personnes.\r\nSalon de thé les après-midi."
    ],
    "es": [
      "Valérie y Rodolphe le dan la bienvenida todos los días a partir de las 7 de la mañana\r\nMenús todos los días con productos frescos y locales.\r\nTodas las noches con reserva a partir de 8 personas.\r\nSalón de té por la tarde."
    ],
    "nl": [
      "Valérie en Rodolphe ontvangen u dagelijks vanaf 7.00 u. \nMenu elke middag op basis van verse lokale producten.\nDagelijks op reservering, vanaf 8 personen.\nTheesalon elke middag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Provençal"
    ]
  },
