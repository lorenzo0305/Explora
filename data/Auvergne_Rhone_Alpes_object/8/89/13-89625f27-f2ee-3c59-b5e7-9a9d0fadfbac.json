  "rdfs:comment": {
    "de": [
      "Das Trapperhaus befindet sich im Herzen des Waldes, im Tierpark von Courzieu. Es ist ein einzigartiger Ort aus Holzstämmen, auf denen ein Elch thront."
    ],
    "en": [
      "The trapper's house is located in the heart of the forest, in the animal park of Courzieu. It is a unique place made of wooden logs where a moose is enthroned."
    ],
    "it": [
      "La casa del trapper si trova nel cuore della foresta, nel parco degli animali di Courzieu. Si tratta di un luogo unico fatto di tronchi di legno dove troneggia un alce."
    ],
    "fr": [
      "La maison du trappeur est située au cœur de la forêt, dans le parc animalier de Courzieu. C'est un lieu unique fait de rondins de bois où trône un élan."
    ],
    "es": [
      "La casa del trampero está situada en el corazón del bosque, en el parque de animales de Courzieu. Es un lugar único hecho de troncos de madera donde se entroniza un alce."
    ],
    "nl": [
      "Het trappershuis ligt in het hart van het bos, in het dierenpark van Courzieu. Het is een unieke plek gemaakt van houten boomstammen waar een eland op troont."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La maison du trappeur - location de salle"
    ]
  },
