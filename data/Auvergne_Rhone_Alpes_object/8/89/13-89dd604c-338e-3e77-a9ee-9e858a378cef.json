  "rdfs:comment": {
    "de": [
      "Erika Digard empfängt Sie im neuen Saint-Augustin, um Ihnen ihre komplett hausgemachte, frische und saisonale Küche zu präsentieren. Probieren Sie Gerichte und süße Leckereien des Tages, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Erika Digard welcomes you to the new Saint-Augustin to introduce you to her fresh, seasonal, home-cooked cuisine. Come and taste the dishes and sweet treats of the day, on the spot or to take away."
    ],
    "it": [
      "Erika Digard vi accoglie nel nuovo Saint-Augustin per presentarvi la sua cucina fresca, stagionale e casalinga. Venite a gustare i piatti e i dolci del giorno, sul posto o da asporto."
    ],
    "fr": [
      "Erika Digard vous accueille au sein du nouveau Saint-Augustin pour vous faire découvrir sa cuisine entièrement faite maison, fraîche et de saison. Venez déguster plats et douceurs sucrées du jour, sur place ou à emporter."
    ],
    "es": [
      "Erika Digard le da la bienvenida al nuevo Saint-Augustin para presentarle su cocina casera, fresca y de temporada. Venga a degustar los platos y dulces del día, en el establecimiento o para llevar."
    ],
    "nl": [
      "Erika Digard heet je welkom in de nieuwe Saint-Augustin om je kennis te laten maken met haar verse, seizoensgebonden, huisgemaakte keuken. Kom proeven van de gerechten en zoete lekkernijen van de dag, ter plekke of om mee te nemen."
    ]
  },
