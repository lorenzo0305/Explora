  "rdfs:comment": {
    "de": [
      "Im Schein der Fackeln lädt Farandole Celtique Sie dazu ein, einige Geheimnisse der Welt zu entdecken. Vom Wald bis zum Ozean teilen Sie mit dem Volk des Unsichtbaren schelmische Anekdoten und magische Rezepte."
    ],
    "en": [
      "By torchlight, Farandole Celtique invites you to discover some of the world's secrets. From forest to ocean, share mischievous anecdotes and magical recipes with the people of the Invisible."
    ],
    "it": [
      "Alla luce delle fiaccole, Farandole Celtique vi invita a scoprire alcuni segreti del mondo. Dalla foresta all'oceano, condividete aneddoti maliziosi e ricette magiche con il popolo degli invisibili."
    ],
    "fr": [
      "A la lumière des flambeaux, Farandole Celtique vous invite à découvrir quelques secrets du monde. De la forêt à l'océan, partagez avec le peuple de l'Invisible, anecdotes malicieuses et recettes magiques."
    ],
    "nl": [
      "Bij fakkellicht nodigt Farandole Celtique je uit om enkele geheimen van de wereld te ontdekken. Van het bos tot de oceaan, deel ondeugende anekdotes en magische recepten met de mensen van het onzichtbare."
    ],
    "es": [
      "A la luz de las antorchas, Farandole Celtique le invita a descubrir algunos de los secretos del mundo. Del bosque al océano, comparta anécdotas traviesas y recetas mágicas con la gente de lo Invisible."
    ]
  },
  "rdfs:label": {
