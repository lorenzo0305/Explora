  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich in einem 200m² großen Raum auf zwei Ebenen (Erdgeschoss für Erwachsene und 1. Stock für Jugendliche). Sie ist an die Schulgruppe angebaut und befindet sich direkt neben dem Espace Olca."
    ],
    "en": [
      "The library is located in a room of 200m² on 2 levels (first floor for adults and 1st floor for youth). It is adjacent to the school group and is located next to the Espace Olca."
    ],
    "it": [
      "La biblioteca si trova in un edificio di 200 m² su due livelli (piano terra per gli adulti e primo piano per i giovani). È adiacente al gruppo scolastico e si trova accanto all'Espace Olca."
    ],
    "fr": [
      "La bibliothèque se situe dans un local de 200m² sur 2 niveaux (rez-de-chaussée pour les adultes et 1er étage pour les jeunes). Elle est attenante au groupe scolaire et se situe juste à côté de l'Espace Olca."
    ],
    "es": [
      "La biblioteca se encuentra en un edificio de 200m² en dos niveles (planta baja para adultos y primera planta para jóvenes). Es adyacente al grupo escolar y se encuentra al lado del Espace Olca."
    ],
    "nl": [
      "De bibliotheek is gevestigd in een gebouw van 200 m² met twee verdiepingen (begane grond voor volwassenen en eerste verdieping voor jongeren). Het grenst aan de schoolgroep en ligt naast het Espace Olca."
    ]
  },
  "rdfs:label": {
