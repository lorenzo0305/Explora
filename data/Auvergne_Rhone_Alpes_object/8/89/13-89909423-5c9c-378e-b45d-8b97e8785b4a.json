  "rdfs:comment": {
    "de": [
      "Entdecken Sie Sensations Nordiques, eine Hundeschlittenschule in La Chapelle en Vercors. Mit Sébastien, einem leidenschaftlichen Musher, dem das Wohl der Tiere am Herzen liegt, begeben Sie sich für 1 Stunde oder 2 Tage auf ein Abenteuer und erleben Sie unvergessliche Momente mit den nordischen Hunden!"
    ],
    "en": [
      "Discover Sensations Nordiques, a dogsledding school in La Chapelle en Vercors. With Sébastien, a passionate musher who cares about animal welfare, set off on an adventure for 1 hour or 2 days and experience unforgettable moments with Nordic dogs!"
    ],
    "it": [
      "Scoprite Sensations Nordiques, una scuola di sleddog a La Chapelle en Vercors. Con Sébastien, un musher appassionato che ha a cuore il benessere degli animali, partite per un'avventura di 1 ora o 2 giorni e vivete momenti indimenticabili con i cani nordici!"
    ],
    "fr": [
      "Découvrez Sensations Nordiques, école de traîneaux à chiens à La Chapelle en Vercors. Avec Sébastien, musher passionné et soucieux du bien-être animal, partez à l'aventure pour 1h ou 2 jours et vivez des moments inoubliables avec les chiens nordiques !"
    ],
    "nl": [
      "Ontdek Sensations Nordiques, een hondenslee-school in La Chapelle en Vercors. Ga met Sébastien, een gepassioneerde musher die geeft om het welzijn van dieren, op avontuur voor 1 uur of 2 dagen en beleef onvergetelijke momenten met Scandinavische honden!"
    ],
    "es": [
      "Descubra Sensations Nordiques, una escuela de trineos tirados por perros en La Chapelle en Vercors. Con Sébastien, un musher apasionado que se preocupa por el bienestar de los animales, láncese a la aventura durante 1 hora o 2 días y viva momentos inolvidables con perros nórdicos"
    ]
  },
  "rdfs:label": {
