  "rdfs:comment": {
    "de": [
      "In der Nähe des Rhône-Ufers und gegenüber der Cité Internationale, dem Kongresszentrum und dem Parc de la Tête d'Or ist dieses 3-Sterne-Hotel der Ausgangspunkt für Ihren Geschäftsaufenthalt oder mit der Familie, um die Stadt Lyon zu erkunden."
    ],
    "en": [
      "Close to the banks of the Rhône and opposite the Cité Internationale, the Convention Centre and the Parc de la Tête d'Or, this 3-star hotel is the perfect base for your business trip or family visit to Lyon."
    ],
    "it": [
      "Vicino alle rive del Rodano e di fronte alla Cité Internationale, al Centro Congressi e al Parc de la Tête d'Or, questo hotel a 3 stelle è la base perfetta per un viaggio d'affari o una visita in famiglia a Lione."
    ],
    "fr": [
      "A proximité des bords du Rhône et face à la Cité Internationale, au Centre de Congrès et au parc de la Tête d'Or, cet hôtel 3 étoiles est le point de départ pour votre séjour d'affaires, ou en famille pour visiter la ville de Lyon."
    ],
    "nl": [
      "Dit 3-sterrenhotel ligt dicht bij de oevers van de Rhône en tegenover de Cité Internationale, het congrescentrum en het Parc de la Tête d'Or. Het is de perfecte uitvalsbasis voor uw zakenreis of familiebezoek aan Lyon."
    ],
    "es": [
      "Cerca de las orillas del Ródano y frente a la Cité Internationale, el Palacio de Congresos y el Parc de la Tête d'Or, este hotel de 3 estrellas es la base perfecta para su viaje de negocios o su visita familiar a Lyon."
    ]
  },
