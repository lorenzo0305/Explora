  "rdfs:comment": {
    "de": [
      "Ikonen & Design ist vor allem eine fröhliche Mischung aus außergewöhnlichen Stücken und raffinierten Objekten. Eine einzigartige Auswahl an Vintage-Stücken und zeitgenössischen Stücken für Ihr Zuhause."
    ],
    "en": [
      "Icônes & design is above all a joyful mix of exceptional pieces and refined objects. A singular selection of vintage and contemporary pieces for your home."
    ],
    "it": [
      "Icônes & design è soprattutto un mix gioioso di pezzi eccezionali e oggetti raffinati. Una selezione unica di pezzi vintage e contemporanei per la vostra casa."
    ],
    "fr": [
      "Icônes & design c’est avant tout un joyeux mélange de pièces d’exceptions et d’objets raffinés. Une sélection singulière de pièce vintages et également de pièces contemporaines pour votre intérieur."
    ],
    "nl": [
      "Icônes & design is vooral een vrolijke mix van bijzondere stukken en verfijnde objecten. Een unieke selectie van vintage en hedendaagse stukken voor je huis."
    ],
    "es": [
      "Icônes & design es ante todo una alegre mezcla de piezas excepcionales y objetos refinados. Una selección única de piezas vintage y contemporáneas para su hogar."
    ]
  },
