  "rdfs:comment": {
    "de": [
      "Das Hôtel d'Ornacieux wurde nach 1630 erbaut und hat sein Portal aus zweifarbigem Kalkstein mit Buckelquadern erhalten, über dem sich ein offener Rundbogengiebel mit Steinrollen befindet..."
    ],
    "en": [
      "The Hôtel d'Ornacieux, built after 1630, retains its two-tone, rusticated limestone portal topped by an open, arched pediment with stone scrolls..."
    ],
    "it": [
      "L'Hôtel d'Ornacieux, costruito dopo il 1630, ha conservato il suo portale bicolore in calcare sbalzato, sormontato da un frontone ad arco aperto con volute in pietra..."
    ],
    "fr": [
      "L'Hôtel d'Ornacieux, édifié après 1630, a conservé son portail en appareil de pierres calcaires bicolores à bossage surmonté d'un fronton cintré ouvert à enroulement de pierre..."
    ],
    "nl": [
      "Het Hôtel d'Ornacieux, gebouwd na 1630, heeft zijn tweekleurig kalkstenen portaal met reliëf bewaard, met daarboven een open gebogen fronton met stenen rollen..."
    ],
    "es": [
      "El Hôtel d'Ornacieux, construido después de 1630, conserva su portal bicolor de piedra caliza rústica rematado por un frontón arqueado abierto con volutas de piedra..."
    ]
  },
