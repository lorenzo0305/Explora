  "rdfs:comment": {
    "de": [
      "Die 20. Etappe der Tour de France wird am 25. Juli 2026 von Le Bourg-d'Oisans aus mit einer Ankunft in L'Alpe d'Huez stattfinden, wobei die Etappe zu 100 % in Oisans stattfinden wird."
    ],
    "en": [
      "The 20th stage of the Tour de France will take place on July 25, 2026, starting from Bourg-d'Oisans and finishing at Alpe d'Huez, for a 100% Oisans stage."
    ],
    "it": [
      "La 20ª tappa del Tour de France si svolgerà il 25 luglio 2026, con partenza da Le Bourg-d'Oisans e arrivo a L'Alpe d'Huez, per una tappa 100% Oisans."
    ],
    "fr": [
      "La 20ème étape du Tour de France aura lieu le 25 Juillet 2026 au départ du Bourg-d'Oisans avec une arrivée à l'Alpe d'Huez, pour une étape 100% Oisans."
    ],
    "es": [
      "La 20ª etapa del Tour de Francia tendrá lugar el 25 de julio de 2026, con salida en Le Bourg-d'Oisans y llegada en L'Alpe d'Huez, para una etapa 100% oisana."
    ],
    "nl": [
      "De 20e etappe van de Tour de France vindt plaats op 25 juli 2026, met de start in Le Bourg-d'Oisans en de finish in L'Alpe d'Huez, voor een etappe die 100% uit Oisans bestaat."
    ]
  },
  "rdfs:label": {
