  "rdfs:comment": {
    "de": [
      "Ein traditionelles Restaurant im Herzen des Dorfes, dessen Speisekarte zahlreiche Gerichte mit einem sehr guten Preis-Leistungs-Verhältnis bietet. Gegrilltes und Pizzen, die von unserem italienischen Pizzaiolo im Saal zubereitet werden. Beheizte Terrasse und Bar."
    ],
    "en": [
      "A traditional restaurant in the heart of the village, with a wide choice of dishes offering excellent value for money. Grilled meats and pizzas made in-house by our Italian pizzaiolo. Heated terrace and bar."
    ],
    "it": [
      "Un ristorante tradizionale situato nel cuore del villaggio con un'ampia gamma di piatti di buon valore nel menu. Carni alla griglia e pizze preparate nel ristorante dal nostro pizzaiolo italiano. Terrazza riscaldata e bar."
    ],
    "fr": [
      "Un restaurant traditionnel situé en plein cœur du village dont la carte propose de nombreux plats d'un très bon rapport qualité prix. Grillades et pizzas faites en salle par notre pizzaiolo italien. Terrasse chauffée et bar."
    ],
    "es": [
      "Un restaurante tradicional situado en el corazón del pueblo con una amplia gama de platos a buen precio en el menú. Carnes a la parrilla y pizzas hechas en el restaurante por nuestro pizzaiolo italiano. Terraza climatizada y bar."
    ],
    "nl": [
      "Een traditioneel restaurant in het hart van het dorp, met een ruim aanbod aan gerechten met een goede prijs-kwaliteitverhouding. Gegrild vlees en pizza's gemaakt door onze Italiaanse pizzaiolo. Verwarmd terras en bar."
    ]
  },
  "rdfs:label": {
