      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\n\nSamstags von 9:00 bis 12:00 Uhr\n\nSonntag geschlossen\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Friday, 9am to 12pm and 2pm to 7pm\n\nSaturday 9am to 12pm\n\nClosed on Sunday\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\n\nSabato dalle 9.00 alle 12.00\n\nChiuso la domenica\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au vendredi de 9h à 12h et de 14h à 19h\n\nLe samedi de 9h à 12h00\n\nFermeture le dimanche\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot vrijdag, 9u tot 12u en 14u tot 19u\n\nZaterdag van 9 tot 12 uur\n\nZondag gesloten\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a viernes, de 9.00 a 12.00 h. y de 14.00 a 19.00 h\n\nSábado de 9h a 12h\n\nDomingo cerrado\n\n\n "
        ]
      },
