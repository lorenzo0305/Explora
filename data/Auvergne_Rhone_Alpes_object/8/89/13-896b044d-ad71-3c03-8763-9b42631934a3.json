  "rdfs:comment": {
    "de": [
      "Raphaël ist Erzeuger/Sammler von Heil- und Aromapflanzen. Er stellt leckere Mischungen(Kräutertees, Sirupe,Salze, Liköre) um den Alltag und die Jahreszeiten zusammen und erntet den kostbaren Nektar dieser Bienenstöcke des Forez."
    ],
    "en": [
      "Raphaël cultivates and gathers medicinal plants and herbs. He concocts some delicious mixtures (herbal teas, syrups, salts and liqueurs) for everyday use, following the seasons to harvest the precious nectar from the apiaries of Forez."
    ],
    "it": [
      "Raccoglitori di benessere, produttori di gusto. Tisane, sciroppi, sali, liquori, mieli di Forez. Raccolta selvatica, orti biologici, apiari biologici."
    ],
    "fr": [
      "Cueilleureuses de Bien-Être, Producteurices de Goût. Tisanes, Sirops, Sels, Liqueurs, Miels du Forez. Cueillettes sauvages, Jardin Bio, Ruchers bio."
    ],
    "nl": [
      "Verzamelaars van welzijn, producenten van smaak. Kruidenthee, siropen, zouten, likeuren, Forez-honing. Wildplukken, biologische tuinen, biologische bijenstallen."
    ],
    "es": [
      "Recolectores de bienestar, productores de sabor. Tisanas, jarabes, sales, licores, mieles de Forez. Recolección silvestre, huertos ecológicos, colmenares ecológicos."
    ]
  },
