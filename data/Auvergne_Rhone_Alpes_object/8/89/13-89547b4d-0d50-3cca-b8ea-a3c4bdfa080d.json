  "rdfs:comment": {
    "de": [
      "Zwischen Drôme und Ardèche in der Gemeinde Montélimar ist das Auberge La Pignata ein Restaurant, in dem Sie täglich übernachten. Wir haben zwölf bequeme Zimmer."
    ],
    "en": [
      "Between Drôme and Ardèche, in the town of Montelimar, the Auberge La Pignata is a welcoming hotel and restaurant every day of the week you. We have twelve comfortable rooms equipped."
    ],
    "it": [
      "Tra la Drôme e l'Ardèche, nel comune di Montélimar, l'Auberge La Pignata è un hotel-ristorante che vi accoglie tutti i giorni della settimana. Disponiamo di dodici camere confortevoli e completamente attrezzate."
    ],
    "fr": [
      "Entre la Drôme et l'Ardèche, sur la commune de Montélimar, l'Auberge La Pignata est un hôtel-restaurant vous accueillant tous les jours de la semaine. Nous disposons de douze chambres équipées confortables."
    ],
    "es": [
      "Entre la Drôme y la Ardèche, en la comuna de Montélimar, el Auberge La Pignata es un hotel-restaurante que le acoge todos los días de la semana. Disponemos de doce habitaciones cómodas y totalmente equipadas."
    ],
    "nl": [
      "Auberge La Pignata, tussen de Drôme en de Ardèche, in de gemeente Montélimar, is een hotel-restaurant dat u elke dag van de week verwelkomt. We beschikken over twaalf comfortabel ingerichte kamers."
    ]
  },
