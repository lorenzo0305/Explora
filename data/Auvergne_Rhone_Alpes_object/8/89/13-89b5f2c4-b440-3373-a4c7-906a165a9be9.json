  "rdfs:comment": {
    "de": [
      "Lokale Köstlichkeiten aus römischer Produktion, ohne Zusatz- oder Konservierungsstoffe, wobei mehr als 60 % der Rohstoffe aus der Region stammen.\r\nPogne, St Genix, Suisse de Valence (Mürbeteig), Brioches, Mouna (Spezialitäten auf Basis von Anissamen)"
    ],
    "en": [
      "Local delicacies made in Romans, without additives or preservatives, with more than 60% of the raw materials coming from the Region.\r\nPogne, St Genix, Suisse de Valence (Shortcrust pastry), Brioches, Mouna (Specialties based on anise seed)"
    ],
    "it": [
      "Prelibatezze locali made in Romans, senza additivi né conservanti, con oltre il 60% delle materie prime provenienti dalla Regione.\r\nPogne, St Genix, Suisse de Valence (Pasta frolla), Brioches, Mouna (Specialità a base di semi di anice)"
    ],
    "fr": [
      "Gourmandises locales fabriquées à Romans, sans additifs, ni conservateurs dont plus de 60% des matières premières proviennent de la Région.\r\nPogne, St Genix, Suisse de Valence (Pâte Sablé), Brioches, Mouna (Spécialités à base de graine d'anis)."
    ],
    "nl": [
      "Lokale lekkernijen gemaakt in Rome, zonder toevoegingen of conserveringsmiddelen, met meer dan 60% van de grondstoffen afkomstig uit de regio.\r\nPogne, St Genix, Suisse de Valence (zanddeeg), Brioches, Mouna (specialiteiten op basis van anijs)."
    ],
    "es": [
      "Delicias locales elaboradas en romano, sin aditivos ni conservantes, con más del 60% de materias primas procedentes de la región.\r\nPogne, St Genix, Suisse de Valence (masa quebrada), Brioches, Mouna (especialidades a base de anís)."
    ]
  },
