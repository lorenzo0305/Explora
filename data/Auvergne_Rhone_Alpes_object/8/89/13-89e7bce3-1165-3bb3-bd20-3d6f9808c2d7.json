  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Tür von L'Atelier de Monique und Sie werden ein magisches Universum mit einer überbordenden Fantasie für vielfältige Kreationen entdecken: Malerei, Raku-Keramik, Skulpturen, Textilkunst in Einzelstücken."
    ],
    "en": [
      "Push open the door of L'Atelier de Monique and you'll discover a magical world of imaginative creations: painting, Raku ceramics, sculpture and one-of-a-kind textile art."
    ],
    "it": [
      "Aprite la porta de L'Atelier de Monique e scoprirete un mondo magico che trabocca della fantasia di molteplici creazioni: pittura, ceramica Raku, scultura, arte tessile in pezzi unici."
    ],
    "fr": [
      "Poussez la porte de L'Atelier de Monique et vous découvrirez un univers magique à l'imagination débordante de créations multiples : peinture, céramique Raku, sculpture, art textile en pièces uniques."
    ],
    "nl": [
      "Duw de deur van L'Atelier de Monique open en je ontdekt een magische wereld die bol staat van de verbeelding en de vele creaties: schilderkunst, Raku-keramiek, beeldhouwkunst, textielkunst in unieke stukken."
    ],
    "es": [
      "Abra de un empujón la puerta de L'Atelier de Monique y descubrirá un mundo mágico rebosante de imaginación de múltiples creaciones: pintura, cerámica Raku, escultura, arte textil en piezas únicas."
    ]
  },
  "rdfs:label": {
