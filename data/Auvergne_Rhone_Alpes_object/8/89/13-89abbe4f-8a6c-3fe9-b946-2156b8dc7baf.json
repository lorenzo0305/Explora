  "rdfs:comment": {
    "de": [
      "Im Skigebiet Villard de Lans/Cote 2000 können Sie die Freuden des Gleitschirmfliegens bei einem Ausflug in die Luft entdecken.\r\nHerrliche Flüge über das Skigebiet mit einer atemberaubenden Aussicht auf das Vercors-Plateau und seine schneebedeckten Gipfel."
    ],
    "en": [
      "In the Villard de Lans/Cote 2000 ski area, discover the pleasures of paragliding on an aerial tour. \r\nMagnificent flights over the ski area with a breathtaking view of the Vercors plateau and its snow-capped peaks."
    ],
    "it": [
      "Nel comprensorio sciistico di Villard de Lans/Cote 2000, scoprite il piacere del parapendio con un tour aereo.\r\nGodetevi splendidi voli sopra il comprensorio sciistico, con una vista mozzafiato sull'altopiano del Vercors e sulle sue cime innevate."
    ],
    "fr": [
      "Sur le domaine skiable de Villard de Lans/Cote 2000, vous découvrirez les plaisirs du parapente lors d’une balade aérienne. \r\nVols splendides au-dessus du domaine de ski avec une vue imprenable sur le plateau du Vercors et ses sommets enneigés."
    ],
    "nl": [
      "Ontdek in het skigebied Villard de Lans/Cote 2000 het plezier van paragliding tijdens een tocht door de lucht.\r\nGeniet van prachtige vluchten boven het skigebied, met een adembenemend uitzicht op het Vercors-plateau en de besneeuwde toppen."
    ],
    "es": [
      "En el dominio esquiable de Villard de Lans/Cote 2000, descubra los placeres del parapente en un recorrido aéreo.\r\nDisfrute de espléndidos vuelos sobre la zona de esquí, con una vista impresionante de la meseta de Vercors y sus picos nevados."
    ]
  },
