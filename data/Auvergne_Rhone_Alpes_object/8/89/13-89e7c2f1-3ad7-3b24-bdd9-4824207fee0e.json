  "rdfs:comment": {
    "de": [
      "Hauteville-Gondon, das für seine Barockkirche Saint-Martin de Tours bekannt ist, lässt Sie mit seiner ländlichen Dominanz, die trotz ihrer Entwicklung ihre Authentizität bewahrt hat, auf eine Zeitreise gehen."
    ],
    "en": [
      "Renowned for its baroque church of Saint-Martin de Tours, Hauteville-Gondon takes you back in time with its predominantly rural setting, which has kept its authenticity despite its development."
    ],
    "it": [
      "Conosciuta per la sua chiesa barocca di Saint-Martin de Tours, Hauteville-Gondon riporta indietro nel tempo con il suo ambiente prevalentemente rurale, che è riuscito a mantenere la sua autenticità nonostante il suo sviluppo."
    ],
    "fr": [
      "Reconnu pour son église baroque Saint-Martin de Tours, Hauteville-Gondon vous fait voyager dans le temps avec sa dominante rurale, qui a su garder son authenticité malgré son développement."
    ],
    "es": [
      "Conocida por su iglesia barroca de Saint-Martin de Tours, Hauteville-Gondon le hace retroceder en el tiempo con su entorno predominantemente rural, que ha sabido conservar su autenticidad a pesar de su desarrollo."
    ],
    "nl": [
      "Bekend om zijn barokke kerk Saint-Martin de Tours, neemt Hauteville-Gondon u mee terug in de tijd met zijn overwegend landelijke omgeving, die ondanks zijn ontwikkeling zijn authenticiteit heeft weten te behouden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hameau de Hauteville-Gondon"
    ]
  },
