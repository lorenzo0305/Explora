  "rdfs:comment": {
    "de": [
      "Das Cinéma Espace Renoir ist als Kunst- und Versuchskino eingestuft und bietet 2 Vorführsäle und eine Einrichtung für Hörgeschädigte. Das Kino bietet ein Programm für junge Zuschauer, zahlreiche Veranstaltungen und Ausstellungen!"
    ],
    "en": [
      "Classified as an art house cinema, the Cinéma Espace Renoir offers 2 screening rooms and a facility for the hearing impaired. The cinema offers programming for young audiences, as well as numerous events and exhibitions!"
    ],
    "it": [
      "Classificato come cinema d'essai, il Cinéma Espace Renoir dispone di 2 sale di proiezione e di una struttura per non udenti. Il cinema offre una programmazione per il pubblico giovane, oltre a numerosi eventi e mostre!"
    ],
    "fr": [
      "Classé cinéma d'art et d'essai, le Cinéma Espace Renoir propose 2 salles de projection et un dispositif pour les personnes malentendantes. Le cinéma propose une programmation jeune public, de nombreux évènements et expositions !"
    ],
    "nl": [
      "De Cinéma Espace Renoir, geclassificeerd als arthousebioscoop, heeft 2 zalen en een voorziening voor slechthorenden. De bioscoop biedt programma's voor een jong publiek, evenals talloze evenementen en tentoonstellingen!"
    ],
    "es": [
      "Clasificado como cine de arte y ensayo, el Cinéma Espace Renoir cuenta con 2 salas de proyección y una instalación para personas con discapacidad auditiva. El cine ofrece una programación para el público joven, así como numerosos eventos y exposiciones"
    ]
  },
