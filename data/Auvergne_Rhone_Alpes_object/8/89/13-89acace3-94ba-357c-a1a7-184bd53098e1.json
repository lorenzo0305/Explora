  "rdfs:comment": {
    "de": [
      "American Blues ist ein traditionelles Restaurant in der Nähe der ViaRhôna und im Herzen des Freizeitzentrums Vallée Bleue. Es bietet einen gemütlichen Rahmen, um sich nach einem Spaziergang oder einer Aktivität im Freien zu entspannen."
    ],
    "en": [
      "American Blues is a traditional restaurant located near the ViaRhôna and in the heart of the Vallée Bleue leisure park. It offers a friendly setting for relaxing after a walk or outdoor activity."
    ],
    "it": [
      "L'American Blues è un ristorante tradizionale situato vicino alla ViaRhôna e nel cuore del parco divertimenti Vallée Bleue. Offre un ambiente accogliente in cui rilassarsi dopo una passeggiata o un'attività all'aperto."
    ],
    "fr": [
      "American Blues est un restaurant traditionnel situé à proximité de la ViaRhôna et au cœur de la base de loisirs de la Vallée Bleue. Il propose un cadre convivial pour se détendre après une balade ou une activité en plein air."
    ],
    "nl": [
      "American Blues is een traditioneel restaurant in de buurt van de ViaRhôna en in het hart van het recreatiepark Vallée Bleue. Het biedt een gezellige omgeving om te ontspannen na een wandeling of een buitenactiviteit."
    ],
    "es": [
      "American Blues es un restaurante tradicional situado cerca de la ViaRhôna y en el corazón del parque de ocio Vallée Bleue. Ofrece un ambiente acogedor en el que relajarse después de un paseo o una actividad al aire libre."
    ]
  },
