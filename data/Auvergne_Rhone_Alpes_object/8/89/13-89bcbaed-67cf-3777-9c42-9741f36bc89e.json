  "rdfs:comment": {
    "de": [
      "Vincent Giraudon empfängt Sie in St-Alban-les-Eaux und bietet Ihnen seinen Rotwein und seinen Roséwein aus der Rebsorte Gamay sowie Weißwein (Rebsorte Aligoté) an."
    ],
    "en": [
      "Vincent Giraudon welcomes you to St-Alban-les-Eaux and offers you his red and rosé Gamay varietal as well as white (aligoté varietal)."
    ],
    "it": [
      "Vincent Giraudon vi dà il benvenuto a St-Alban-les-Eaux e vi offre il suo Gamay rosso e rosato e il suo bianco (aligoté)."
    ],
    "fr": [
      "Vincent Giraudon vous accueille à St-Alban-les-Eaux et vous propose son rouge et son rosé cépage Gamay ainsi que du blanc (cépage aligoté)."
    ],
    "es": [
      "Vincent Giraudon le da la bienvenida a St-Alban-les-Eaux y le ofrece su Gamay varietal tinto y rosado, así como el blanco (varietal aligoté)."
    ],
    "nl": [
      "Vincent Giraudon heet je welkom in St-Alban-les-Eaux en biedt je zijn rode en rosé Gamay en witte (aligoté) variëteit."
    ]
  },
