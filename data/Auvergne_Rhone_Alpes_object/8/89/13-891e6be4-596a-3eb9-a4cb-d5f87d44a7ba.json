  "rdfs:comment": {
    "de": [
      "Erleben Sie Halloween in Flammen! Feuershow \"Infernodeliko\" der Compagnie FuegoLoko in der Festung von Polignac: flammende Jonglage, Feuerspucker, Humor und pyrotechnische Effekte. Zwei Vorstellungen zur Auswahl: 17:30 und 20:30 Uhr."
    ],
    "en": [
      "Come and experience Halloween in flames! Infernodeliko\" fire show by Compagnie FuegoLoko at the Forteresse de Polignac: flaming jugglers, fire-eaters, humor and pyrotechnic effects. Two sessions to choose from: 5:30pm and 8:30pm."
    ],
    "it": [
      "Venite a vivere un Halloween in fiamme! Spettacolo di fuoco \"Infernodeliko\" della compagnia FuegoLoko alla Forteresse de Polignac: giocoleria infuocata, mangiafuoco, comicità ed effetti pirotecnici. Due sessioni a scelta: alle 17.30 e alle 20.30."
    ],
    "fr": [
      "Venez vivre Halloween en flammes ! Spectacle de feu « Infernodeliko » par la Compagnie FuegoLoko à la Forteresse de Polignac : jongleries enflammées, cracheurs de feu, humour et effets pyrotechniques. Deux séances au choix : 17h30 et 20h30."
    ],
    "es": [
      "¡Viva Halloween en llamas! Espectáculo de fuego \"Infernodeliko\" de la compañía FuegoLoko en la Forteresse de Polignac: malabares de fuego, tragafuegos, comedia y efectos pirotécnicos. Dos sesiones a elegir: 17.30 h y 20.30 h."
    ],
    "nl": [
      "Kom en beleef Halloween in vlammen! Vuurshow \"Infernodeliko\" van de FuegoLoko Company in de Forteresse de Polignac: vurig jongleren, vuurspuwers, komedie en pyrotechnische effecten. Keuze uit twee sessies: 17.30 en 20.30 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de feu pour Halloween : Infernodeliko"
    ]
  },
