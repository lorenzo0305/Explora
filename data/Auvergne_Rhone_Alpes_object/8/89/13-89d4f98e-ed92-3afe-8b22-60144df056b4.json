  "rdfs:comment": {
    "de": [
      "Dieses Ende des 15. Jahrhunderts errichtete Herrenhaus zeugt von der Vorliebe der damaligen Oberschicht für eine imposante und demonstrative Architektur. MH 1928."
    ],
    "en": [
      "This mansion, built at the end of the 15th century, reflects the taste of the haute-bourgeoisie for imposing, demonstrative architecture. MH 1928."
    ],
    "it": [
      "Questo palazzo privato, costruito alla fine del XV secolo, testimonia il gusto dell'alta borghesia dell'epoca per un'architettura imponente e dimostrativa. MH 1928."
    ],
    "fr": [
      "Cet hôtel particulier, construit à la fin du XVe siècle, témoigne du goût de la haute-bourgeoisie de l'époque pour une architecture imposante et démonstratrice. MH 1928."
    ],
    "es": [
      "Esta mansión privada, construida a finales del siglo XV, atestigua el gusto de la alta burguesía de la época por una arquitectura imponente y demostrativa. MH 1928."
    ],
    "nl": [
      "Dit particuliere herenhuis, gebouwd aan het einde van de 15e eeuw, getuigt van de smaak van de haute-bourgeoisie van die tijd voor imposante, demonstratieve architectuur. MH 1928."
    ]
  },
  "rdfs:label": {
