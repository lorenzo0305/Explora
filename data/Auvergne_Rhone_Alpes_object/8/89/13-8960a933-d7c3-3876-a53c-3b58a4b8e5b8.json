  "rdfs:comment": {
    "de": [
      "Affectus: Organisator von unvergesslichen musikalischen Veranstaltungen.\r\nErleben Sie emotionale, inspirierende und verbindende Momente mit unseren maßgeschneiderten Konzerten, Konferenzen und Teambuildings."
    ],
    "en": [
      "Affectus: organizer of unforgettable musical events.\r\nExperience moments of emotion, inspiration and cohesion thanks to our tailor-made concerts, conferences and team-buildings."
    ],
    "it": [
      "Affectus: organizzatore di eventi musicali indimenticabili.\r\nI nostri concerti, conferenze e team-building su misura sono sicuri di ispirare, entusiasmare e unire."
    ],
    "fr": [
      "Affectus : organisateur d’événements musicaux inoubliables.\r\nVivez des moments d’émotion, d’inspiration et de cohésion grâce à nos concerts, conférences et team-buildings sur mesure."
    ],
    "es": [
      "Affectus: organizador de eventos musicales inolvidables.\r\nNuestros conciertos, conferencias y team-buildings a medida seguro que inspiran, motivan y unen."
    ],
    "nl": [
      "Affectus: organisator van onvergetelijke muzikale evenementen.\r\nOnze op maat gemaakte concerten, conferenties en team-buildings zullen zeker inspireren, bezielen en verenigen."
    ]
  },
