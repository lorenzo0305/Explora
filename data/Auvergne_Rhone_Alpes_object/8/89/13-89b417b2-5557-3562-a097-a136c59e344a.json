  "rdfs:comment": {
    "de": [
      "Der Verein \"la Récréation\" lädt Sie zu einem kulturellen Wochenende mit seiner traditionellen Ausstellung \"Artistes à tous vents\" ein.\r\nEntdecken Sie Künstler mit unterschiedlichen Welten und lassen Sie sich von der Kreativität tragen!"
    ],
    "en": [
      "The association \"la Récréation\" invites you to a cultural weekend, with its traditional \"Artistes à tous vents\" exhibition.\r\nCome and discover artists from a wide variety of backgrounds, and let yourself be carried away by their creativity!"
    ],
    "it": [
      "L'associazione \"la Récréation\" vi invita a un fine settimana culturale, con la sua tradizionale mostra \"Artistes à tous vents\".\r\nVenite a scoprire artisti di diversa provenienza e lasciatevi trasportare dalla creatività in un viaggio di scoperta!"
    ],
    "fr": [
      "L'association \"la Récréation\" vous invite à un week-end culturel, avec sa traditionnelle exposition \"Artistes à tous vents\". \r\nVenez découvrir des artistes aux univers variés et laissez-vous porter par la créativité !"
    ],
    "es": [
      "La asociación \"la Récréation\" le invita a un fin de semana cultural, con su tradicional exposición \"Artistes à tous vents\".\r\nVenga a descubrir artistas de orígenes muy diversos y déjese llevar por su creatividad en un viaje de descubrimiento"
    ],
    "nl": [
      "De vereniging \"la Récréation\" nodigt je uit voor een cultureel weekend, met haar traditionele tentoonstelling \"Artistes à tous vents\".\r\nKom en ontdek kunstenaars met verschillende achtergronden en laat je creativiteit je meenemen op een ontdekkingsreis!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Artistes à tous vents"
    ]
  },
