  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch den Ortskern von Laval, um die Markierungen zu entdecken, die in der Nähe von bemerkenswerten Orten angebracht wurden."
    ],
    "en": [
      "Using your map, navigate around the heart of the village of Laval to find the markers that have been placed near places of interest."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, muovetevi nel cuore del villaggio di Laval per scoprire i segnalatori che sono stati installati vicino a luoghi notevoli."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous au cœur du village de Laval, pour découvrir les balises qui ont été installées à proximité des lieux remarquables."
    ],
    "nl": [
      "Verplaats je met behulp van de kaart door het hart van het dorp Laval om de merkpunten te ontdekken die in de buurt van bezienswaardigheden zijn geplaatst."
    ],
    "es": [
      "Con la ayuda de su mapa, desplácese por el corazón del pueblo de Laval para descubrir las balizas que se han instalado cerca de lugares destacados."
    ]
  },
  "rdfs:label": {
