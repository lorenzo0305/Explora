  "rdfs:comment": {
    "de": [
      "Der Verein verwaltet und betreut Gemeinschaftsgärten am Fuße von Gebäuden in den Stadtteilen Fontbarlettes und Le Plan in Valence. In diesen Gärten ist eine Parzelle für den Verein reserviert, der dort sein eigenes Gemüse anbaut."
    ],
    "en": [
      "The association manages and organizes shared gardens at the foot of buildings in the Fontbarlettes and Plan districts of Valence. In these gardens, a plot is reserved for the association, which produces its own vegetables."
    ],
    "it": [
      "L'associazione gestisce e amministra orti condivisi ai piedi degli edifici nei quartieri Fontbarlettes e Plan di Valence. In questi orti, un lotto è riservato all'associazione, che produce i propri ortaggi."
    ],
    "fr": [
      "L'association gère et anime des jardins partagés en pieds d'immeubles sur les quartiers de Fontbarlettes et du Plan à Valence. Dans ces jardins, une parcelle est réservée à l'association qui produit ses propres légumes."
    ],
    "es": [
      "La asociación gestiona y explota huertos compartidos al pie de edificios en los barrios de Fontbarlettes y Plan de Valence. En estos huertos se reserva una parcela a la asociación, que produce sus propias hortalizas."
    ],
    "nl": [
      "De vereniging beheert en beheert gemeenschappelijke tuinen aan de voet van gebouwen in de wijken Fontbarlettes en Plan in Valence. In deze tuinen is een perceel gereserveerd voor de vereniging, die haar eigen groenten produceert."
    ]
  },
  "rdfs:label": {
