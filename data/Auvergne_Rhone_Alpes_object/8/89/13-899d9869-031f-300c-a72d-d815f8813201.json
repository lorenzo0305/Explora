  "rdfs:comment": {
    "de": [
      "Leidenschaftlicher Angler, vor allem Fliegenfischer. Gilles André leitet Amateure an und erfindet eine ganze Reihe von Ausrüstungsgegenständen, die den Anglern Freude bereiten.\r\nEin Treffen mit einem leidenschaftlichen Hobbyisten, der zwischen Geo Trouve-tout und MacGyver angesiedelt ist."
    ],
    "en": [
      "Passionate about angling, especially fly fishing. Gilles André guides amateurs, and invents a whole range of equipment to delight anglers.\r\nMeet a passionate man, somewhere between Géo Trouve-tout and MacGyver."
    ],
    "it": [
      "Appassionato di pesca, soprattutto di pesca a mosca. Gilles André guida gli appassionati e inventa tutta una serie di attrezzature per la gioia dei pescatori.\r\nIncontra un uomo appassionato, a metà tra Géo Trouve-tout e MacGyver."
    ],
    "fr": [
      "Passionné de pêche à la ligne, à la mouche notamment. Gilles André guide les amateurs, et invente tout un tas d'équipements qui ravit les pratiquants. \r\nRencontre avec un passionné, entre Géo Trouve-tout et MacGyver."
    ],
    "nl": [
      "Gepassioneerd door vissen, vooral vliegvissen. Gilles André gidst enthousiastelingen en vindt een hele reeks uitrustingen uit om vissers te plezieren.\r\nMaak kennis met een gepassioneerde man die het midden houdt tussen Géo Trouve-tout en MacGyver."
    ],
    "es": [
      "Apasionado de la pesca, sobre todo de la pesca a mosca. Gilles André guía a los aficionados e inventa toda una gama de equipos para hacer las delicias de los pescadores.\r\nUn hombre apasionado, entre Géo Trouve-tout y MacGyver."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Art / techniques pêche 73"
    ]
  },
