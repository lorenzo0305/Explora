  "rdfs:comment": {
    "de": [
      "Gannat vibriert im Rhythmus des Tanzes! Workshops, Vorführungen, Aufführungen, Ausstellungen, Kino und Mediathek. Höhepunkt: eine große Wiederaufführung mit allen Schülern aus Gannat. Vollständiges Programm auf ville-gannat.fr."
    ],
    "en": [
      "Gannat vibrates to the rhythm of dance! Workshops, demonstrations, shows, exhibitions, cinema and media library. Highlight: a grand restitution with all Gannat students. Full program on ville-gannat.fr."
    ],
    "it": [
      "Gannat vibra al ritmo della danza! Laboratori, dimostrazioni, spettacoli, mostre, cinema e mediateca. Momento clou: gran finale con tutti gli allievi di Gannat. Programma completo su ville-gannat.fr."
    ],
    "fr": [
      "Gannat vibre au rythme de la danse ! Ateliers, démonstrations, spectacles, expositions, cinéma et médiathèque. Point fort : une grande restitution avec tous les élèves gannatois. Programme complet sur ville-gannat.fr."
    ],
    "es": [
      "¡Gannat vibra al ritmo de la danza! Talleres, demostraciones, espectáculos, exposiciones, cine y mediateca. Lo más destacado: un gran final con todos los alumnos de Gannat. Programa completo en ville-gannat.fr."
    ],
    "nl": [
      "Gannat vibreert op het ritme van dans! Workshops, demonstraties, voorstellingen, tentoonstellingen, bioscoop en mediatheek. Hoogtepunt: een grote finale met alle leerlingen van Gannat. Volledig programma op ville-gannat.fr."
    ]
  },
  "rdfs:label": {
