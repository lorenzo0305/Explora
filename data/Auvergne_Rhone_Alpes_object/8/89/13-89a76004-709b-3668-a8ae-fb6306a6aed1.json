  "rdfs:comment": {
    "de": [
      "Entdecken Sie mittags wie abends eine gemütliche Atmosphäre rund um eine abwechslungsreiche und raffinierte Speisekarte, ohne dabei die Spezialitäten der Region zu vergessen. Südterrasse."
    ],
    "en": [
      "Discover the midday and the evening a warm atmosphere around a varied and refined menu, without forgetting the specialties of the region."
    ],
    "it": [
      "Scoprite un'atmosfera accogliente a pranzo e alla sera con un menu vario e raffinato, senza dimenticare le specialità della regione. Terrazza esposta a sud."
    ],
    "fr": [
      "Découvrez  le midi comme le soir une atmosphère chaleureuse autour d'une carte variée et raffinée, sans oublier les spécialités de la région. Terrasse plein sud."
    ],
    "nl": [
      "Ontdek tijdens de lunch en het diner een warme sfeer rond een gevarieerd en verfijnd menu, zonder de specialiteiten van de regio te vergeten. Terras op het zuiden."
    ],
    "es": [
      "Descubra un ambiente cálido al mediodía y por la noche con un menú variado y refinado, sin olvidar las especialidades de la región. Terraza orientada al sur."
    ]
  },
