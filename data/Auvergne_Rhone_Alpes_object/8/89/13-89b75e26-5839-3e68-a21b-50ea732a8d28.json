  "rdfs:comment": {
    "de": [
      "Werkstatt für Schmuck/Joaillerie/Fasserei\r\nKreation, Reparatur, Umwandlung\r\nEntdecken Sie auch ihre von der Natur inspirierten Kreationen, die Silber, Holz, Steine, Tahiti-Zuchtperlen, Leder, Samen... miteinander verbinden."
    ],
    "en": [
      "Jewelry/jewelry-making/welding workshop\r\nCreation, repair, transformation\r\nDiscover her creations inspired by nature, combining silver, wood, stones, Tahitian cultured pearls, leather, seeds..."
    ],
    "it": [
      "Laboratorio di gioielleria/gioielleria/saldatura\r\nCreazione, riparazione, trasformazione\r\nScoprite le sue creazioni ispirate alla natura, che combinano argento, legno, pietre, perle coltivate di Tahiti, cuoio, semi, ecc."
    ],
    "fr": [
      "Atelier de bijouterie/joaillerie/sertissage\r\nCréation, réparation, transformation\r\nDécouvrez aussi ses créations inspirées par la nature qui associent Argent, Bois, Pierres, Perles de culture de Tahiti, Cuir, Graines..."
    ],
    "es": [
      "Taller de joyería/joyería/soldadura\r\nCreación, reparación, transformación\r\nDescubra sus creaciones inspiradas en la naturaleza, combinando plata, madera, piedras, perlas cultivadas de Tahití, cuero, semillas, etc."
    ],
    "nl": [
      "Sieraden/sieradenmakerij/laswerkplaats\r\nCreatie, reparatie, transformatie\r\nOntdek haar creaties geïnspireerd door de natuur, een combinatie van zilver, hout, stenen, Tahitiaanse gekweekte parels, leer, zaden, enz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Léz'Arts du Métal - Bijouterie"
    ]
  },
