  "rdfs:comment": {
    "de": [
      "Ob mit kleinen Schritten oder großen Schritten, machen Sie sich bereit für das Abenteuer!\r\nAls leidenschaftliche Bergsteigerin und Reisende bin ich neugierig und fasziniert vom Reichtum der Kulturen der Welt, aber auch von der Vielfalt unserer französischen Geografie."
    ],
    "en": [
      "With short steps or long strides, get ready for adventure!\r\nI'm passionate about mountains and travel, and I'm fascinated by the richness of the world's cultures, as well as by the diversity of our French geography."
    ],
    "it": [
      "A piccoli passi o a grandi passi, preparatevi all'avventura!\r\nSono appassionata di montagna e di viaggi e sono affascinata dalla ricchezza delle culture del mondo e dalla diversità della geografia francese."
    ],
    "fr": [
      "À petits pas ou à grandes enjambées, préparez vous pour l'aventure !\r\nPassionnée de montagne et de voyages, je suis curieuse et fascinée par la richesse des cultures du monde, mais aussi par la diversité de notre géographie française."
    ],
    "nl": [
      "Met kleine stapjes of grote stappen, maak je klaar voor avontuur!\r\nIk heb een passie voor bergen en reizen, en ik ben gefascineerd door de rijkdom van de culturen in de wereld en de diversiteit van de Franse geografie."
    ],
    "es": [
      "A pequeños pasos o a grandes zancadas, ¡prepárate para la aventura!\r\nMe apasionan la montaña y los viajes, y me fascina la riqueza de las culturas del mundo, así como la diversidad de la geografía francesa."
    ]
  },
