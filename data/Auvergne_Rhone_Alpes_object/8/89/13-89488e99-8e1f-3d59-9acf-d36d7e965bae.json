  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen der Fischzucht Les Meuniers und beobachten Sie die Fische unserer Bergseen und Wildbäche: Bachsaiblinge, Bachforellen. Außerdem zu sehen: Regenbogen-Zuchtforellen und Brunnenlachse."
    ],
    "en": [
      "Visit the fish farm for a closer look at what they do and to learn about the fish in our mountain lakes and streams: arctic char and faro trout. You’ll also see rainbow trout and brook trout."
    ],
    "it": [
      "Aprite le porte dell'allevamento ittico di Meuniers per osservare i pesci dei nostri laghi e torrenti di montagna: salmerino alpino, trota fario. Si possono vedere anche trote iridee e salmoni di fontana."
    ],
    "fr": [
      "Poussez les portes de la pisciculture des Meuniers pour observer les poissons de nos lacs de montagne et torrents : ombles chevalier, truites fario. A voir également : truites d'élevage arc en ciel et saumons de fontaine."
    ],
    "nl": [
      "Open de deuren van de viskwekerij van Meuniers en bekijk de vissen uit onze bergmeren en bergstromen: ridderforel en fario forel. Ook te zien: regenboogforel en beekzalm."
    ],
    "es": [
      "Abra las puertas de la piscifactoría de Meuniers para observar los peces de nuestros lagos y torrentes de montaña: trucha ártica, trucha fario. También se pueden ver: truchas arco iris y salmones fuente."
    ]
  },
  "rdfs:label": {
    "en": [
      "Meuniers fish farm"
    ],
    "fr": [
      "Pisciculture des Meuniers"
    ]
  },
