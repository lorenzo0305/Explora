  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Kulturerbe des Departements Allier mit der ganzen Familie auf spielerische und pädagogische Weise mit PÉPIT!\r\nLaden Sie die App herunter, wählen Sie die Mission \"Machen Sie Karriere im Granit\", beantworten Sie die Rätsel und finden Sie den Schatz!"
    ],
    "en": [
      "Go treasure hunting thanks to your smartphone, choose the mission \"Faites carrière dans le granit\" and follow Mandrin."
    ],
    "it": [
      "Scoprite il patrimonio dell'Allier in famiglia in modo divertente ed educativo con PÉPIT!\r\nScaricate l'applicazione, selezionate la missione \"Fare carriera nel granito\", rispondete agli indovinelli e trovate il tesoro!"
    ],
    "fr": [
      "Découvrez le patrimoine de l'Allier en famille de façon ludique et pédagogique avec PÉPIT !\r\nTéléchargez l'application, sélectionnez la mission \"Faites carrière dans le granit\", répondez aux énigmes et trouvez trésor !"
    ],
    "es": [
      "¡Descubre el patrimonio del Allier en familia de forma divertida y didáctica con PÉPIT!\r\nDescarga la aplicación, selecciona la misión \"Haz carrera en el granito\", responde a las adivinanzas y ¡encuentra el tesoro!"
    ],
    "nl": [
      "Ontdek met het gezin het erfgoed van de Allier op een leuke en leerzame manier met PÉPIT!\r\nDownload de applicatie, kies de missie \"Maak carrière in graniet\", beantwoord de raadsels en vind de schat!"
    ]
  },
  "rdfs:label": {
    "en": [
      "PÉPIT: Riddle walk"
    ],
    "fr": [
      "PÉPIT :  Faites carrière dans le granit"
    ]
  },
