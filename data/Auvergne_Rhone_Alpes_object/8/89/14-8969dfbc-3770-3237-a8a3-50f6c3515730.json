  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5c572558-f3a3-3ecb-846a-fc8ce3e6ccbb",
      "dc:description": {
        "de": [
          "Lauf mit Abstieg zum Strand und Panoramablick\nsup 5.5 und 11 kms Nordic Walking\n5.5 und duo mixte 2x 5.5 kms organisiert von der amicale le drapeau athlétisme und der Stadt\nTreffpunkt am Strand um 14.30 Uhr\nKontakt: 06.30.55.85.69."
        ],
        "en": [
          "Run with descent to the beach and panoramic view\nsup 5.5 and 11 kms nordic walking\n5.5 and mixed duo 2x 5.5 kms organized by l'amicale le drapeau athlétisme and the town\nMeet on the beach at 2.30pm\nContact: 06.30.55.85.69."
        ],
        "it": [
          "Corsa con discesa verso la spiaggia e vista panoramica\nsup 5,5 e 11 km di nordic walking\n5.5 e duo misto 2x 5,5 km organizzato da l'amicale le drapeau athlétisme e la città\nAppuntamento sulla spiaggia alle 14.30\nContatto: 06.30.55.85.69."
        ],
        "fr": [
          "Course avec descente sur la plage et  vue panoramique\nsup 5.5 et 11 kms marche nordique\n5.5 et duo mixte 2x 5.5 kms organisée par l'amicale le drapeau athlétisme et la ville\nRendez vous sur la plage à 14h30\nContact : 06.30.55.85.69."
        ],
        "nl": [
          "Run met afdaling naar het strand en panoramisch uitzicht\nsup 5,5 en 11 km Nordic Walking\n5.5 en gemengd duo 2x 5,5 km georganiseerd door l'amicale le drapeau athlétisme en de stad\nVerzamelen op het strand om 14.30 uur\nContact: 06.30.55.85.69."
        ],
        "es": [
          "Carrera con descenso a la playa y vistas panorámicas\nsup 5,5 y 11 kms marcha nórdica\n5.5 y dúo mixto 2x 5,5 kms organizado por l'amicale le drapeau athlétisme y la ciudad\nCita en la playa a las 14h30\nContacto: 06.30.55.85.69."
        ]
      },
