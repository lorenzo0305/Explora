  "rdfs:comment": {
    "de": [
      "La Musette de Valentine befindet sich im Herzen des Bauernhofs des Lycée agricole du Valentin.\r\nAlle bäuerlichen Produkte stammen von rund 30 Betrieben aus der Drôme und der Ardèche."
    ],
    "en": [
      "La Musette de Valentine is at the heart of the Lycée agricole du Valentin farm.\r\nAll farm produce comes from around thirty farms in the Drôme and Ardèche regions."
    ],
    "it": [
      "La Musette de Valentine è il cuore dell'azienda agricola Lycée agricole du Valentin.\r\nTutti i prodotti dell'azienda provengono da una trentina di fattorie della Drôme e dell'Ardèche."
    ],
    "fr": [
      "La Musette de Valentine est au cœur de la ferme du Lycée agricole du Valentin.\r\nL’ensemble des produits fermiers provient d’une trentaine d’exploitations de la Drôme et de l’Ardèche."
    ],
    "es": [
      "La Musette de Valentine se encuentra en el corazón de la granja del Lycée agricole du Valentin.\r\nTodos los productos de la granja proceden de una treintena de explotaciones de las regiones de Drôme y Ardèche."
    ],
    "nl": [
      "La Musette de Valentine is het hart van de boerderij Lycée agricole du Valentin.\r\nAlle producten van de boerderij komen van een dertigtal boerderijen uit de Drôme en de Ardèche."
    ]
  },
  "rdfs:label": {
