  "rdfs:comment": {
    "de": [
      "Wir bauen Pflanzen und Beeren in Gravières und Chambonas biologisch an und verarbeiten sie zu Kräutertees, Sirupen, Gewürzen, Marmeladen und Trockenfrüchten. Sie können unsere Gärten im Rahmen von Spaziergängen und thematischen Workshops besuchen."
    ],
    "en": [
      "Aqua Terra Silva offers herbal teas, aromatic blends and syrups made from plants grown in Gravières and Chambonas, as well as fresh and dried fruit and jams. Our production is certified in Organic Agriculture."
    ],
    "it": [
      "A Gravières e Chambonas coltiviamo piante e bacche da agricoltura biologica che trasformiamo in tisane, sciroppi, condimenti, marmellate e frutta secca. È possibile visitare i nostri giardini durante passeggiate e laboratori tematici."
    ],
    "fr": [
      "Nous cultivons des plantes et petits fruits en agriculture biologique à Gravières et Chambonas pour les transformer en tisanes, sirops, condiments, confitures et fruits séchés. Vous pouvez visiter nos jardins lors de balades et d’ateliers thématiques."
    ],
    "nl": [
      "We telen biologische planten en bessen in Gravières en Chambonas en maken er kruidenthee, siropen, specerijen, jam en gedroogd fruit van. Je kunt onze tuinen bezoeken tijdens themawandelingen en workshops."
    ],
    "es": [
      "En Gravières y Chambonas cultivamos plantas y bayas de cultivo ecológico que transformamos en tisanas, jarabes, condimentos, mermeladas y frutos secos. Puede visitar nuestros jardines durante paseos y talleres temáticos."
    ]
  },
