  "rdfs:comment": {
    "de": [
      "Grüne Mountainbike-Strecke auf dem Kamm von Doucy, auf halbem Weg zwischen Downhill und Enduro. Er ermöglicht es, vom Gipfel des TC de Planchamp aus den Skiort Doucy und vom Gipfel des TSD Combelouvière aus Valmorel zu erreichen. Sehr verspielt und leicht zu erreichen."
    ],
    "en": [
      "New green track of enduro on the ridge of Doucy, marked and accessible from the top of Combelouvière chairlift.\r\nLength: 3 km, 220 meters elevation."
    ],
    "it": [
      "Un percorso verde per mountain bike sulla Crête de Doucy, a metà strada tra downhill ed enduro. È possibile raggiungere la località di Doucy dalla cima del TC de Planchamp e Valmorel dalla cima del TSD Combelouvière. È molto divertente e facile da raggiungere."
    ],
    "fr": [
      "Parcours VTT vert sur la Crête de Doucy, à mi-chemin entre la descente et l'enduro. Il permet de rejoindre la station de Doucy depuis le sommet de la TC de Planchamp, et Valmorel depuis le sommet du TSD Combelouvière. Très ludique et facile d'accès."
    ],
    "es": [
      "Una ruta verde de bicicleta de montaña en la Crête de Doucy, a medio camino entre el descenso y el enduro. Se puede llegar a la estación de Doucy desde la cima del TC de Planchamp, y a Valmorel desde la cima del TSD Combelouvière. Es muy divertido y fácil de llegar."
    ],
    "nl": [
      "Een groene mountainbikeroute op de Crête de Doucy, halverwege downhill en enduro. Je kunt het skioord Doucy bereiken vanaf de top van de TC de Planchamp en Valmorel vanaf de top van de TSD Combelouvière. Het is erg leuk en gemakkelijk te bereiken."
    ]
  },
  "rdfs:label": {
