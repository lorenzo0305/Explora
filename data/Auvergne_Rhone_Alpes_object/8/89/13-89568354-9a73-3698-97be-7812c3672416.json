  "rdfs:comment": {
    "de": [
      "Von Thoissey aus erreichen Sie Trévoux mit dem Fahrrad durch die geschützte Natur, die der Treidelpfad bietet, entlang des Saône-Tals und mit Blick auf das Beaujolais. Entlang der Strecke laden mehrere unumgängliche Sehenswürdigkeiten zu einem kulturellen oder gastronomischen Zwischenstopp ein."
    ],
    "en": [
      "From Thoissey, cycle to Trévoux via the unspoilt natural setting of the towpath, along the Val de Saône and facing the Beaujolais region. Along the way, you'll find a number of unmissable cultural and gastronomic attractions."
    ],
    "it": [
      "Da Thoissey, pedalate fino a Trévoux attraverso la natura incontaminata dell'alzaia, lungo la Val de Saône e di fronte alla regione del Beaujolais. Lungo il percorso, numerosi siti imperdibili invitano a fare una sosta culturale o gastronomica."
    ],
    "fr": [
      "De Thoissey, rejoignez Trévoux à vélo par le cadre naturel préservé qu'offre le chemin de halage, le long du Val de Saône et face au Beaujolais. Le long de l’itinéraire, plusieurs sites incontournables invitent à une halte culturelle ou gastronomique."
    ],
    "nl": [
      "Fiets vanuit Thoissey naar Trévoux via de ongerepte natuur van het jaagpad, langs de Val de Saône en tegenover de Beaujolais. Onderweg nodigen een aantal niet te missen bezienswaardigheden u uit voor een culturele of gastronomische stop."
    ],
    "es": [
      "Desde Thoissey, vaya en bicicleta hasta Trévoux por el entorno natural intacto del camino de sirga, a lo largo del valle del Saona y frente al Beaujolais. A lo largo de la ruta, varios lugares ineludibles le invitan a hacer una parada cultural o gastronómica."
    ]
  },
  "rdfs:label": {
    "de": [
      "La Voie Bleue® Moselle Saône à vélo - Etappe Thoissey - Trévoux"
    ],
