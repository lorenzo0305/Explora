  "rdfs:comment": {
    "de": [
      "Die Communauté de Communes du Haut-Lignon bietet mittwochs und während der Schulferien einen Empfang für Minderjährige (Accueil Collectif de Mineurs, ACM) an. Dieser Service wird von der CAF de Haute-Loire unterstützt."
    ],
    "en": [
      "The Communauté de Communes du Haut-Lignon offers a Accueil Collectif de Mineurs (ACM) on Wednesdays and during school holidays. This service is supported by the CAF of Haute-Loire."
    ],
    "it": [
      "La Comunità dei Comuni dell'Haut-Lignon offre un \"Accueil Collectif de Mineurs\" (ACM) il mercoledì e durante le vacanze scolastiche. Questo servizio è sostenuto dal CAF dell'Alta Loira."
    ],
    "fr": [
      "La Communauté de Communes du Haut-Lignon propose un Accueil Collectif de Mineurs (ACM) les mercredis et pendant les vacances scolaires. Ce service bénéficie du soutien de la CAF de Haute-Loire."
    ],
    "es": [
      "La Comunidad de Municipios de Haut-Lignon ofrece un \"Accueil Collectif de Mineurs\" (ACM) los miércoles y durante las vacaciones escolares. Este servicio cuenta con el apoyo de la CAF de Haute-Loire."
    ],
    "nl": [
      "De gemeente Haut-Lignon biedt een \"Accueil Collectif de Mineurs\" (ACM) aan op woensdag en tijdens de schoolvakanties. Deze dienst wordt ondersteund door het CAF van de Haute-Loire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre de loisirs antenne du Chambon-sur-Lignon"
    ]
  },
