  "rdfs:comment": {
    "de": [
      "Echte bretonische Crêperie im historischen Viertel der Stadt Bourg-en-Bresse (Porte des Jacobins). Traditionelle Crêpes und Galettes, die vor Ihren Augen zubereitet werden. Mehl aus 100 % Buchweizen aus der Bretagne (I.G.P.). Bretonische Produkte (Cidre, Breizh-Cola, Bier)."
    ],
    "en": [
      "Authentic Breton crêperie in the historic district of Bourg-en-Bresse (Porte des Jacobins). Traditional crepes and galettes made in front of you. 100% buckwheat flour from Brittany (I.G.P.). Breton products (cider, Breizh-cola, beers)."
    ],
    "it": [
      "Vera creperia bretone nel quartiere storico di Bourg-en-Bresse (Porte des Jacobins). Frittelle e galette tradizionali preparate davanti a voi. 100% farina di grano saraceno della Bretagna (I.G.P.). Prodotti bretoni (sidro, Breizh-cola, birre)."
    ],
    "fr": [
      "Véritable crêperie bretonne dans le quartier historique de la ville de Bourg-en-Bresse (porte des Jacobins). Crêpes et galettes traditionnelles faites devant vous. Farine 100% blé noir de Bretagne (I.G.P.). Produits bretons (cidre, Breizh-cola, bières)."
    ],
    "nl": [
      "Echte Bretonse crêperie in de historische wijk van Bourg-en-Bresse (Porte des Jacobins). Traditionele pannenkoeken en galetten die voor uw neus worden gebakken. 100% boekweitmeel uit Bretagne (I.G.P.). Bretonse producten (cider, Breizh-cola, bieren)."
    ],
    "es": [
      "Auténtica crepería bretona en el barrio histórico de Bourg-en-Bresse (Porte des Jacobins). Tortitas y galletas tradicionales hechas delante de usted. Harina de trigo sarraceno 100% de Bretaña (I.G.P.). Productos bretones (sidra, Breizh-cola, cervezas)."
    ]
  },
