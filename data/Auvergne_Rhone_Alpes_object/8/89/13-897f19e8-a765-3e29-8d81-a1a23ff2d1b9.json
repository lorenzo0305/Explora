  "rdfs:comment": {
    "de": [
      "Rückverbindung mit der Natur, mit sich selbst & ô Lebendiger Weg des Bewusstseins. Bergführer für Skiwanderungen . Massage \"Les Mains du C?ur\". Initiatische Reisen und Retreats im Herzen der Berge Frankreichs und der Welt."
    ],
    "en": [
      "Reconnection to Nature, to Oneself & O Living Path of Consciousness. High Mountain Guide Ski Hiking. Massage \"the Hands of the Heart\". Travel & Initiatory Retreat in the Heart of the Mountains France and World."
    ],
    "it": [
      "Riconnettersi alla natura, a se stessi e al sentiero vivente della coscienza. Guida di alta montagna per lo scialpinismo. Massaggio \"Mani del Cuore\". Viaggi e ritiri iniziatici nel cuore delle montagne in Francia e nel mondo."
    ],
    "fr": [
      "Reconnexion à la Nature, à Soi & ô Vivant Chemin de Conscience. Guide Haute Montagne Ski Randonnée . Massage\" les Mains du Cœur\". Voyage & Retraite Initiatique au Cœur des Montagnes France et Monde."
    ],
    "es": [
      "Reconectar con la naturaleza, con uno mismo y con el camino vivo de la conciencia. Guía de alta montaña para esquí de travesía. Masaje \"Manos del Corazón\". Viaje & Retiro de Iniciación en el Corazón de las Montañas Francia y el Mundo."
    ],
    "nl": [
      "Herverbinding met de natuur, met zichzelf en een levend pad van bewustzijn. Hoge berggids Skiën Wandelen. Masseer \"de handen van het hart\". Travel & Initiatory Retreat in the Heart of the Mountains France and World."
    ]
  },
