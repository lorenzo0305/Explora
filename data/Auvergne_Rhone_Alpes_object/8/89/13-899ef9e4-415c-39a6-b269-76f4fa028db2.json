  "rdfs:comment": {
    "de": [
      "Nutzen Sie diese eingerichtete und gesicherte Rodelbahn auf dem Plateau du Capucin oberhalb des Mont-Dore, die von der Nordic Zone aus startet."
    ],
    "en": [
      "Come and enjoy this secure toboggan run on the Capucin plateau above Le Mont-Dore, starting from the Nordic zone."
    ],
    "it": [
      "Venite a godervi questa pista di slittino sicura sull'altopiano del Capucin, sopra Le Mont-Dore, partendo dalla zona nordica."
    ],
    "fr": [
      "Venez profiter de cette piste de luge aménagée et sécurisée sur le plateau du Capucin, au-dessus du Mont-Dore, au départ de la zone nordique."
    ],
    "es": [
      "Ven a disfrutar de esta pista de trineo segura en la meseta de Capucin, por encima de Le Mont-Dore, partiendo de la zona nórdica."
    ],
    "nl": [
      "Kom genieten van deze veilige rodelbaan op het Capucin plateau boven Le Mont-Dore, vanaf de Nordic zone."
    ]
  },
