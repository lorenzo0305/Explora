  "rdfs:comment": {
    "de": [
      "Der Turm von Barcelonne liegt an den ersten Ausläufern des Vercors und überragt die Ebene von Valence. Der heute restaurierte Turm öffnet seine Türen für Sie.\r\nGenießen Sie die spektakuläre Aussicht auf dem Kammweg bis zur Kapelle Sainte-Marguerite."
    ],
    "en": [
      "Clinging to the foothills of the Vercors, the Tour de Barcelonne overlooks the Valence plain. Now restored, it opens its doors to you.\r\nEnjoy spectacular views along the ridge path to the Sainte-Marguerite chapel."
    ],
    "it": [
      "Aggrappata alle pendici del Vercors, la torre di Barcelonne domina la pianura di Valence. Ora restaurata, vi apre le sue porte.\r\nGodetevi le viste spettacolari lungo il sentiero di cresta fino alla cappella Sainte-Marguerite."
    ],
    "fr": [
      "Accrochée aux premiers contreforts du Vercors, la tour de Barcelonne surplombe la plaine de Valence. Aujourd’hui restaurée, elle vous ouvre ses portes. \r\nProfitez d'une vue spectaculaire le long du sentier de crête jusqu’à la chapelle Sainte-Marguerite."
    ],
    "es": [
      "Aferrada a las estribaciones del Vercors, la torre de Barcelonne domina la llanura de Valence. Ahora restaurada, le abre sus puertas.\r\nDisfrute de unas vistas espectaculares por el camino de la cresta hasta la capilla Sainte-Marguerite."
    ],
    "nl": [
      "Aan de voet van de Vercors kijkt de toren van Barcelonne uit over de vlakte van Valence. Nu gerestaureerd, opent hij zijn deuren voor je.\r\nGeniet van het spectaculaire uitzicht langs het pad naar de kapel Sainte-Marguerite."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée patrimoine : La tour de Barcelonne"
    ]
  },
