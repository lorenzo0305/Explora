  "rdfs:comment": {
    "de": [
      "Magali befindet sich neben dem nordischen Foyer auf dem Plateau von Sardières. Sie empfängt Sie jeden Tag und bietet Ihnen Getränke und Feinschmeckerspezialitäten an. Schnellrestaurants auf den Langlaufloipen des nordischen Skigebiets Monolithe. Brotverkauf."
    ],
    "en": [
      "Located next to the Nordic foyer on the Sardières plateau, Magali welcomes you every day, offering drinks and gourmet specialities. Fast food on the cross-country ski trails of the Monolithe Nordic ski area. Bread shop."
    ],
    "it": [
      "Situato accanto al foyer Nordic sull'altopiano di Sardières, Magali vi accoglie ogni giorno e vi offre bevande e specialità gastronomiche. Fast food sulle piste di sci di fondo del comprensorio nordico delle Monolithe. Deposito di pane."
    ],
    "fr": [
      "Située à côté du foyer nordique sur le plateau de Sardières, Magali vous accueille tous les jours et vous propose boissons et spécialités gourmandes. Restauration rapide sur les pistes de ski de fond du domaine nordique du Monolithe. Dépôt de pain."
    ],
    "es": [
      "Situado junto al vestíbulo nórdico en la meseta de Sardières, Magali le da la bienvenida todos los días y le ofrece bebidas y especialidades gastronómicas. Comida rápida en las pistas de esquí de fondo de la zona nórdica de Monolithe. Depósito de pan."
    ],
    "nl": [
      "Gelegen naast de Nordic foyer op het plateau van Sardières, verwelkomt Magali u deze winter elke dag met drankjes en gastronomische specialiteiten. Fast food op de langlaufloipes van het Monolithe Nordic gebied."
    ]
  },
