  "rdfs:comment": {
    "de": [
      "Mitten im Herzen des Alpenmassivs verankert, lädt Sie Les Aiglons, ein 4-Sterne-Hotel nur einen Katzensprung vom Stadtzentrum entfernt, zu einem einzigartigen Erlebnis ein."
    ],
    "en": [
      "Anchored in the heart of the Alpine massif, Les Aiglons, a 4-star hotel just a stone's throw from the city center, invites you to enjoy a unique experience."
    ],
    "it": [
      "Ancorato nel cuore del massiccio alpino, Les Aiglons, hotel 4**** a due passi dal centro città, vi invita a vivere un'esperienza unica."
    ],
    "fr": [
      "Ancré au coeur du massif alpin, Les Aiglons, hôtel 4**** à deux pas du centre ville vous invite à vivre une expérience unique."
    ],
    "nl": [
      "Les Aiglons, een 4**** hotel in het hart van de Alpen op een steenworp afstand van het stadscentrum, nodigt je uit voor een unieke ervaring."
    ],
    "es": [
      "Anclado en el corazón del macizo alpino, Les Aiglons, un hotel de 4 estrellas a dos pasos del centro de la ciudad, le invita a vivir una experiencia única."
    ]
  },
