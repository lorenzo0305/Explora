  "rdfs:comment": {
    "de": [
      "Dieses Museum beherbergt Werkzeuge, Maschinen und Geräte, die von unseren Vorfahren benutzt wurden, sowie Dinge, die den Alltag in ihren Häusern darstellten."
    ],
    "en": [
      "This museum houses the tools, machines and devices used by our ancestors as well as what represented their daily life in their homes."
    ],
    "it": [
      "Questo museo ospita gli strumenti, le macchine e gli elettrodomestici utilizzati dai nostri antenati e ciò che rappresentava la loro vita quotidiana nelle loro case."
    ],
    "fr": [
      "Ce musée abrite les outils, machines et appareils utilisés par nos aïeux ainsi que ce qui représentait leur quotidien dans leurs foyers."
    ],
    "es": [
      "Este museo alberga las herramientas, máquinas y electrodomésticos utilizados por nuestros antepasados, así como lo que representaba su vida cotidiana en sus hogares."
    ],
    "nl": [
      "Dit museum herbergt de werktuigen, machines en apparaten die onze voorouders gebruikten en wat hun dagelijks leven in hun huizen vertegenwoordigde."
    ]
  },
