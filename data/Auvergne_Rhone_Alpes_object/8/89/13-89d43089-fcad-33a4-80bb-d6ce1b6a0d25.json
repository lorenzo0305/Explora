  "rdfs:comment": {
    "de": [
      "Regionale Spezialitäten à la carte, jeden Mittag ein Tagesgericht und eine Bar für einen gemütlichen \"Après-Ski\" auf einer großen Terrasse. Dieses Restaurant verfügt außerdem über das Gütesiegel \"Familie Plus\"."
    ],
    "en": [
      "Regional specialties à la carte, daily specials for lunch and bar for a warm \"après-ski\" on a large terrace, this restaurant also has the \"Famille Plus\" label."
    ],
    "it": [
      "Con specialità regionali à la carte, specialità del giorno e un bar per un accogliente \"après-ski\" sulla grande terrazza, questo ristorante ha anche il marchio \"Famille Plus\"."
    ],
    "fr": [
      "Spécialités régionales à la carte, plat du jour tous les midis et bar pour un \"après-ski\" chaleureux sur une grande terrasse, ce restaurant bénéficie en plus du label \"Famille Plus\"."
    ],
    "nl": [
      "Lokale gerechten, elke middag  een dagmenu, een gezellige bar en groot terras om volop te genieten van de « après-ski ». Bovendien bezit dit restaurant het label « Famille Plus »."
    ],
    "es": [
      "Con especialidades regionales a la carta, platos del día y un bar para un acogedor \"après-ski\" en la gran terraza, este restaurante también cuenta con la etiqueta \"Famille Plus\"."
    ]
  },
