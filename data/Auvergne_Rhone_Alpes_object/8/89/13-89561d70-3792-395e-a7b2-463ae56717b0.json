  "rdfs:comment": {
    "de": [
      "Wenn Sie einen kleinen Hunger haben, bietet Ihnen Chez Fläder eine Mittagsverpflegung mit zwei Tagesgerichten zur Auswahl, darunter ein vegetarisches Gericht, und hausgemachte Patisserie, die Sie den ganzen Tag über vor Ort genießen oder mitnehmen können."
    ],
    "en": [
      "If you're feeling peckish, Chez Fläder offers lunchtime catering with a choice of 2 dishes of the day, one of which is vegetarian, and homemade pastries to eat in or take away throughout the day."
    ],
    "it": [
      "Se avete un certo languorino, Chez Fläder offre un menu a pranzo con una scelta di 2 piatti del giorno, di cui uno vegetariano, e dolci fatti in casa da consumare o portare via durante la giornata."
    ],
    "fr": [
      "Si vous avez une petite faim, Chez Fläder, vous propose une restauration le midi avec au choix 2 plats du jour dont un végétariens et des pâtisseries faites maison à déguster sur place ou à emporter tout au long de la journée."
    ],
    "es": [
      "Si tiene hambre, Chez Fläder le ofrece un menú a mediodía con 2 platos del día a elegir, uno de ellos vegetariano, y repostería casera para comer o llevar a lo largo del día."
    ],
    "nl": [
      "Als je trek hebt, biedt Chez Fläder een lunchmenu met keuze uit 2 dagschotels, waarvan één vegetarisch, en huisgemaakt gebak om de hele dag door te eten of mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Fläder | Restaurant"
    ]
  },
