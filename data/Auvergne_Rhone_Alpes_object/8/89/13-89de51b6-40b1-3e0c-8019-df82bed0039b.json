  "rdfs:comment": {
    "de": [
      "Als ehemaliger Hundeführer bei der Gendarmerie während 20 Jahren und staatlich geprüfter Bergbegleiter biete ich Ihnen eine einzigartige Erfahrung an: mit Ihrem eigenen Hund in die Berge zu gehen, in einem betreuten, wohlwollenden und professionellen Rahmen."
    ],
    "en": [
      "A former dog handler with the Gendarmerie for 20 years and a qualified mountain leader, I offer you a unique experience: going into the mountains with your own dog, in a supervised, caring and professional environment."
    ],
    "it": [
      "Ex conduttore di cani della Gendarmeria per 20 anni e leader di montagna qualificato, vi offro un'esperienza unica: andare in montagna con il vostro cane, in un ambiente sorvegliato, attento e professionale."
    ],
    "fr": [
      "Ancien maître de chien au sein de la Gendarmerie durant 20 ans et Accompagnateur en Montagne diplômé d'État, je vous propose une expérience unique : partir en montagne accompagné de votre propre chien, dans un cadre encadré, bienveillant et professionnel."
    ],
    "es": [
      "Antiguo adiestrador de perros de la Gendarmería durante 20 años y monitor de montaña titulado, le ofrezco una experiencia única: salir a la montaña con su propio perro, en un entorno supervisado, atento y profesional."
    ],
    "nl": [
      "Als voormalig hondengeleider bij de Gendarmerie gedurende 20 jaar en gekwalificeerd bergleider, bied ik je een unieke ervaring: de bergen in met je eigen hond, in een begeleide, zorgzame en professionele omgeving."
    ]
  },
