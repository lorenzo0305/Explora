  "rdfs:comment": {
    "de": [
      "Im Zentrum von Annecy, nur wenige Minuten von den Ufern des Sees entfernt, empfängt Sie das Hotel im Rahmen Ihres nächsten Urlaubs oder Geschäftsaufenthalts."
    ],
    "en": [
      "In the center of Annecy, just a few minutes from the shores of the lake, the hotel welcomes you for your next tourist or business stay."
    ],
    "it": [
      "Nel centro di Annecy, a pochi minuti dalle rive del lago, l'hotel vi accoglie per la vostra prossima vacanza o viaggio d'affari."
    ],
    "fr": [
      "Au centre d'Annecy, à quelques minutes des rives du lac, l'hôtel vous accueille dans le cadre de votre prochain séjour touristique ou professionnel."
    ],
    "nl": [
      "In het centrum van Annecy, op slechts een paar minuten van de oevers van het meer, verwelkomt het hotel u voor uw volgende vakantie of zakenreis."
    ],
    "es": [
      "En el centro de Annecy, a pocos minutos de la orilla del lago, el hotel le da la bienvenida para su próxima estancia turística o de negocios."
    ]
  },
