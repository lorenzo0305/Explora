  "rdfs:comment": {
    "de": [
      "Auf dem Hauptplatz von Charlieu bietet Ihnen unsere Brasserie eine traditionelle und hausgemachte Küche mit lokalen Produkten. Eine Terrasse erwartet Sie, um Momente mit Freunden zu teilen. Brasserie-Karte, Tagesmenü, Cocktails und Eis werden angeboten."
    ],
    "en": [
      "On Charlieu's main square, our brasserie offers traditional, home-style cooking using local produce. A terrace awaits you to share moments with friends. Brasserie menu, daily specials, cocktails and ice creams are available."
    ],
    "it": [
      "Sulla piazza principale di Charlieu, la nostra brasserie offre una cucina tradizionale casalinga a base di prodotti locali. Una terrazza vi aspetta per condividere momenti con gli amici. Sono disponibili menu della brasserie, menu del giorno, cocktail e gelati."
    ],
    "fr": [
      "Sur la place principale de Charlieu, notre brasserie vous offre une cuisine traditionnelle et maison avec des produits locaux. Une terrasse vous attend pour partager des moments entre amis. Carte brasserie, menu du jour, cocktails et glaces sont proposés."
    ],
    "nl": [
      "Op het hoofdplein van Charlieu biedt onze brasserie een traditionele keuken met streekproducten. Een terras wacht op je om momenten met vrienden te delen. Brasseriemenu, dagmenu, cocktails en ijsjes zijn beschikbaar."
    ],
    "es": [
      "En la plaza principal de Charlieu, nuestra brasserie ofrece cocina casera tradicional elaborada con productos locales. Una terraza le espera para compartir momentos con amigos. Menú de brasserie, menú del día, cócteles y helados disponibles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Grand Café"
    ]
  },
