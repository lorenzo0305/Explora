  "rdfs:comment": {
    "de": [
      "Im März lädt Sie Ihre Bibliothek zu einem großen Sprung in die Vergangenheit ein, denn wir werden unsere Veranstaltungen für Kinder ? in die prähistorische Zeit versetzen!"
    ],
    "en": [
      "In March, your library invites you to take a leap into the past as we put our children's activities on prehistoric time!"
    ],
