  "rdfs:comment": {
    "de": [
      "In der Boutique Vignolis können Sie den Geschmacksreichtum unserer regionalen Produktionen mit g.U. oder g.g.A., Weine, Olivenöle und Oliven aus Nyons entdecken."
    ],
    "en": [
      "Vignolis will enable you to discover the richness and taste of our productions (AOC and IGP labels), wines, olive oils and olives."
    ],
    "it": [
      "Il negozio Vignolis vi permetterà di scoprire la ricchezza dei sapori dei nostri prodotti locali DOP o IGP, vini, oli d'oliva e olive di Nyons."
    ],
    "fr": [
      "La boutique Vignolis vous permettra de découvrir la richesse des goûts de nos productions de terroir en AOP ou IGP, vins, huiles d'olive et olives de Nyons."
    ],
    "es": [
      "La tienda Vignolis le permitirá descubrir la riqueza de los sabores de nuestros productos locales DOP o IGP, vinos, aceites de oliva y aceitunas de Nyons."
    ],
    "nl": [
      "Bij Vignolis ontdekt u de rijkdom van de smaken van onze lokale producten (met het keurmerk AOC of IGP), wijnen, olijfolie en olijven uit Nyons."
    ]
  },
