  "rdfs:comment": {
    "de": [
      "Die Biennale der Kunsthandwerke in Brioude, die mit dem Label \"Ville et Métiers d'Art\" (Stadt der Kunsthandwerke) ausgezeichnet wurde, stellt in ihrer zweiten Ausgabe die Kunsthandwerker in den Mittelpunkt."
    ],
    "en": [
      "For its 2nd edition, the Biennale des Métiers d?Art de Brioude, which has been awarded the Ville et Métiers d?Art label, puts the spotlight on craftsmen."
    ],
    "it": [
      "Giunto alla sua seconda edizione, il Festival Biennale delle Arti e dei Mestieri di Brioude, che ha ottenuto il marchio Ville et Métiers d'Art (Città e Mestieri), punta i riflettori sugli artigiani."
    ],
    "fr": [
      "Pour sa 2ᵉ édition, la Biennale des Métiers d’Art de Brioude, labellisée Ville et Métiers d’Art, met en lumière les artisans d’art."
    ],
    "nl": [
      "Het tweejaarlijkse kunst- en ambachtsfestival van Brioude, dat het label Ville et Métiers d'Art (Stad en Ambacht) heeft gekregen, zet de ambachtslieden van Brioude in de schijnwerpers."
    ],
    "es": [
      "En su segunda edición, la Bienal de Artesanía de Brioude, galardonada con el sello Ville et Métiers d'Art (Ciudad y Oficios), pone el acento en los artesanos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "2è édition Biennale des Métiers d'Art"
    ]
  },
