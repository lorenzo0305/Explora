          "additionalInformation": {
            "de": [
              "Frühstück: 7h-10h (nach außen hin geöffnet).\r\nMittagsservice: 12h-14h.\r\nAbendservice: 19h-21h.\r\nLimonadenservice den ganzen Tag über.\r\nNachmittags Snackformel und Aperitifbretter.\r\nMuscheln und Pommes frites am Dienstagmittag."
            ],
            "en": [
              "Breakfast: 7am-10am (open outside).\r\nLunch service: 12pm-2pm.\r\nEvening service: 7-9pm.\r\nLemonade service all day.\r\nAfternoon snack and aperitif platters.\r\nMussels and French fries Tuesday lunchtime."
            ],
            "it": [
              "Colazione: 7.00-10.00 (aperto all'esterno).\r\nPranzo: 12.00-14.00.\r\nServizio serale: 19.00-21.00.\r\nServizio di limonata tutto il giorno.\r\nSpuntini pomeridiani e aperitivi al piatto.\r\nMenu cozze e patatine il martedì a pranzo."
            ],
            "fr": [
              "Petit déjeuner : 7h-10h (ouvert à l’extérieur).\r\nService midi : 12h-14.\r\nService soir : 19h-21h.\r\nService limonade toute la journée.\r\nFormule goûter l'après-midi et planches apéritives. \r\nFormule moules/frites le mardi midi."
            ],
            "nl": [
              "Ontbijt: 7.00-10.00 uur (buiten open).\r\nLunch: 12.00 - 14.00 uur.\r\nAvondeten: 19.00-9.00 uur.\r\nDe hele dag limonadeservice.\r\nMiddagsnack en aperitiefschotels.\r\nMosselen en frietmenu op dinsdagmiddag."
            ],
            "es": [
              "Desayuno: de 7.00 a 10.00 (abierto al exterior).\r\nServicio de comidas: de 12.00 a 14.00 h.\r\nServicio nocturno: de 19.00 a 21.00 horas.\r\nServicio de limonada todo el día.\r\nMerienda y aperitivo.\r\nMenú de mejillones y patatas fritas los martes al mediodía."
            ]
          },
