  "rdfs:comment": {
    "de": [
      "Kulturelle Veranstaltung mit dem Ziel, das Kino als Vektor zur Sensibilisierung für Behinderungen und Unterschiede zu fördern. Parallele Ausstrahlung der Filme zwischen Tence und Le Chambon/Lignon."
    ],
    "en": [
      "Cultural event to promote cinema as a means of raising awareness of disability and difference. Films shown in parallel between Tence and Le Chambon/Lignon."
    ],
    "it": [
      "Un evento culturale volto a promuovere il cinema come strumento di sensibilizzazione alla disabilità e alla differenza. Proiezione di film in parallelo tra Tence e Le Chambon/Lignon."
    ],
    "fr": [
      "Manifestation culturelle ayant pour objectif de promouvoir le cinéma comme vecteur de sensibilisation aux handicaps et à la différence. Diffusion des films en parallèle entre Tence et le Chambon/Lignon."
    ],
    "es": [
      "Manifestación cultural destinada a promover el cine como medio de sensibilización sobre la discapacidad y la diferencia. Proyección paralela de películas entre Tence y Le Chambon/Lignon."
    ],
    "nl": [
      "Een cultureel evenement om cinema te promoten als een middel om mensen bewust te maken van handicaps en verschillen. Gelijktijdige vertoning van films tussen Tence en Le Chambon/Lignon."
    ]
  },
