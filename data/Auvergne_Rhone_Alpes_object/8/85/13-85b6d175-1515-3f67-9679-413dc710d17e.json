  "rdfs:comment": {
    "de": [
      "Das Dorf umfasst ein Schloss und einen Marktflecken, der von Festungen umgeben ist, die dem alten Zentrum seine kreisförmige Form verleihen.\r\nNur die Fassade ist sichtbar."
    ],
    "en": [
      "The village comprises a castle and a town surrounded by fortifications that give the old center its circular shape.\r\nOnly the façade is visible."
    ],
    "it": [
      "Il paese ha un castello e una città circondata da fortificazioni che danno al centro storico la sua forma circolare.\r\nÈ visibile solo la facciata."
    ],
    "fr": [
      "Le village comporte un château et un bourg ceinturé de fortifications qui confèrent au centre ancien sa forme circulaire.\r\nSeule la façade est visible."
    ],
    "nl": [
      "Het dorp bestaat uit een kasteel en een stad omringd door vestingwerken die het oude centrum zijn ronde vorm geven.\r\nAlleen de voorgevel is zichtbaar."
    ],
    "es": [
      "El pueblo tiene un castillo y una ciudad rodeada de fortificaciones que dan al casco antiguo su forma circular.\r\nSólo es visible la fachada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le château Renaissance"
    ]
  },
