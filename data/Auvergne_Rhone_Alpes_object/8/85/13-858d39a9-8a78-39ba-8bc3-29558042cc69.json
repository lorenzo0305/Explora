  "rdfs:comment": {
    "de": [
      "Lydia empfängt Sie in ihrer Sophrologiepraxis in Evian-Les-Bains im Bereich des Strandes von Grande Rive.\r\nFlexible Öffnungstage und -zeiten, die Zeitfenster variieren, um den Möglichkeiten jedes Einzelnen bestmöglich gerecht zu werden."
    ],
    "en": [
      "Lydia welcomes you to her sophrology practice in Evian-Les-Bains, in the Grande Rive beach area.\r\nFlexible opening days and times, slots vary to best suit individual needs."
    ],
    "it": [
      "Lydia vi accoglie nel suo studio di sofrologia a Evian-Les-Bains, nella zona della spiaggia della Grande Rive.\r\nGiorni e orari di apertura flessibili, con fasce orarie diverse per soddisfare le esigenze di tutti."
    ],
    "fr": [
      "Lydia vous reçoit dans son cabinet de sophrologie situé à Evian-Les-Bains dans le secteur de la plage de Grande Rive. \r\nJours et horaires d'ouverture flexibles, les créneaux varient pour répondre aux mieux aux possibilités de chacun."
    ],
    "es": [
      "Lydia le da la bienvenida a su consulta de sofrología en Evian-Les-Bains, en la zona de la playa Grande Rive.\r\nHorarios y días de apertura flexibles, con diferentes franjas horarias para adaptarse a las necesidades de cada uno."
    ],
    "nl": [
      "Lydia heet je welkom in haar praktijk voor sofrologie in Evian-Les-Bains, in de buurt van het strand van Grande Rive.\r\nFlexibele openingsdagen en -tijden, met verschillende slots om aan ieders behoeften te voldoen."
    ]
  },
  "rdfs:label": {
