  "rdfs:comment": {
    "de": [
      "Es ist die 62. Ausgabe des Interfolk-Festivals! Eröffnungsgala, Le Puy-en-Fête und Aufführungen im ganzen Departement: Schließen Sie sich den Kompanien an, die vom 20. bis 26. Juli 2026 anwesend sind, um diese schöne Ausgabe zu feiern! Programmierung folgt."
    ],
    "en": [
      "It's the 62nd Interfolk Festival! Opening gala, Le Puy-en-Fête and shows throughout the department: join the companies present from July 20 to 26, 2026 to celebrate this wonderful edition! Program to come."
    ],
    "it": [
      "È il 62° Festival Interfolk! Galà di apertura, Le Puy-en-Fête e spettacoli in tutto il dipartimento: unitevi alle compagnie presenti dal 20 al 26 luglio 2026 per festeggiare questa splendida edizione! Programma a venire."
    ],
    "fr": [
      "C’est la 62ème édition du Festival Interfolk ! Gala d’ouverture, le Puy-en-Fête et spectacles dans tout le département : rejoignez les compagnies présentes du 20 au 26 juillet 2026 pour célébrer cette belle édition ! Programmation à venir."
    ],
    "es": [
      "¡Es la 62ª edición del Festival Interfolk! Gala inaugural, Le Puy-en-Fête y espectáculos por todo el departamento: ¡únase a las compañías presentes del 20 al 26 de julio de 2026 para celebrar esta maravillosa edición! Próxima programación."
    ],
    "nl": [
      "Het 62e Interfolk Festival! Openingsgala, Le Puy-en-Fête en voorstellingen over het hele departement: sluit je aan bij de aanwezige gezelschappen van 20 tot 26 juli 2026 om deze prachtige editie te vieren! Programma volgt."
    ]
  },
