  "rdfs:comment": {
    "de": [
      "Stoßen Sie die Tür des Restaurants auf und genießen Sie geschmorte Gerichte, Spezialitäten aus Savoyen, die mit saisonalen Produkten in einer authentischen und entspannten Atmosphäre zubereitet werden. Der Küchenchef Jean-Pascal und Brigitte heißen Sie jeden Tag herzlich willkommen."
    ],
    "en": [
      "Time for a lunch or a dinner, come and taste a very good traditional cooking. Passed down from father to son since 1896, this hotel will welcome you in a warm atmosphere for a nice moment."
    ],
    "it": [
      "Spingete la porta del ristorante e venite a gustare piatti a fuoco lento, specialità della Savoia, elaborati con prodotti di stagione in un'atmosfera autentica e rilassata. Lo chef Jean-Pascal e Brigitte vi danno il benvenuto ogni giorno."
    ],
    "fr": [
      "Pousser la porte du restaurant et venez déguster des plats mijotés, des spécialités de Savoie, élaborés avec des produits de saison dans une ambiance authentique et décontractée. Le chef Jean-Pascal et Brigitte vous accueillent tous les jours."
    ],
    "es": [
      "Empuje la puerta del restaurante y venga a degustar platos cocinados a fuego lento, especialidades de Saboya, elaborados con productos de temporada en un ambiente auténtico y relajado. El chef Jean-Pascal y Brigitte le dan la bienvenida todos los días."
    ],
    "nl": [
      "Duw de deur van het restaurant binnen en proef gestoofde gerechten, specialiteiten van Savoye, gemaakt met seizoensproducten in een authentieke en ontspannen sfeer. De chef-kok Jean-Pascal en Brigitte heten u elke dag welkom."
    ]
  },
  "rdfs:label": {
