  "rdfs:comment": {
    "de": [
      "Tanz: Petits Papillons ist ein Junge auf einer Bank, der sich nicht mit seinen Füßen abstützen kann. Er kostet die Schwerkraft aus\r\nauf seine eigene Art und Weise. Es ist auch ein Mädchen, das mit ihm spielt."
    ],
    "en": [
      "Dance: Petits Papillons is about a boy on a bench who can't use his feet for support. He tastes gravity\r\nin his own way. There's also a girl playing with him."
    ],
    "it": [
      "Danza: Petits Papillons parla di un ragazzo su una panchina che non può usare l'appoggio dei piedi. Assapora la gravità\r\na modo suo. C'è anche una ragazza che gioca con lui."
    ],
    "fr": [
      "Danse : Petits Papillons, c'est un garçon sur un banc, qui ne peut pas se servir de l'appui de ses pieds. Il goûte la gravité\r\nà sa façon. C'est aussi une fille qui joue avec lui."
    ],
    "es": [
      "Danza: Petits Papillons trata de un niño en un banco que no puede utilizar el apoyo de sus pies. Saborea la gravedad\r\na su manera. También hay una niña que juega con él."
    ],
    "nl": [
      "Dans: Petits Papillons gaat over een jongen op een bank die de steun van zijn voeten niet kan gebruiken. Hij proeft de zwaartekracht\r\nop zijn eigen manier. Er speelt ook een meisje met hem."
    ]
  },
