  "rdfs:comment": {
    "de": [
      "Die Pizzeria Bella Ciao empfängt Sie in einer freundlichen Atmosphäre, mit hausgemachten Speisen aus frischen Zutaten.\r\nPizza-Automat gegenüber der Pizzeria in Selbstbedienung 7 Tage die Woche und 24 Stunden am Tag"
    ],
    "en": [
      "The pizzeria Bella Ciao welcomes you in a friendly spirit, homemade cooking with fresh products.\r\nPizza vending machine in front of the pizzeria in self-service 7 days a week and 24 hours a day"
    ],
    "it": [
      "La pizzeria Bella Ciao vi accoglie con spirito amichevole, cucina casalinga con prodotti freschi.\r\nDistributore automatico di pizze di fronte alla pizzeria, self-service 7 giorni su 7 e 24 ore su 24"
    ],
    "fr": [
      "La pizzeria Bella Ciao vous accueille dans un esprit convivial, cuisine faite maison avec des produits frais.\r\nDistributeur de pizza face à la pizzeria en libre service 7 jours/7 et 24h/24"
    ],
    "es": [
      "La pizzería Bella Ciao le da la bienvenida con un espíritu amistoso, cocina casera con productos frescos.\r\nMáquina expendedora de pizzas frente a la pizzería, autoservicio 7 días a la semana y 24 horas al día"
    ],
    "nl": [
      "De pizzeria Bella Ciao ontvangt u in een vriendelijke sfeer, huisgemaakte gerechten met verse producten.\r\nPizzaautomaat voor de pizzeria, zelfbediening 7 dagen per week en 24 uur per dag"
    ]
  },
