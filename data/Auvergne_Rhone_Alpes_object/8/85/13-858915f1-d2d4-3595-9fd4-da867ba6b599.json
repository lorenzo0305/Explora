  "rdfs:comment": {
    "de": [
      "Im Herzen der Region Beaujolais empfängt Sie das La Maison des Beaujolais jeden Tag mittags und abends.  Was auch immer der Anlass ist, unser Team, unsere Küche und unsere guten Weine werden Sie bei diesem schönen Moment begleiten."
    ],
    "en": [
      "In the heart of the Beaujolais area, La Maison des Beaujolais welcomes you every day for lunch or dinner.  Whatever the occasion, our team, our cuisine and our good wines will accompany you for this beautiful moment."
    ],
    "it": [
      "Nel cuore della regione del Beaujolais, La Maison des Beaujolais vi accoglie ogni giorno per pranzo e cena.  Qualunque sia l'occasione, il nostro team, la nostra cucina e i nostri vini pregiati vi accompagneranno in questo meraviglioso momento."
    ],
    "fr": [
      "Au cœur de la région Beaujolaise, La Maison des Beaujolais vous accueille tous les jours Midi et Soir.  Quelle que soit l'occasion, notre équipe, notre cuisine et nos bons vins sauront vous accompagner pour ce beau moment."
    ],
    "nl": [
      "In het hart van de Beaujolais heet La Maison des Beaujolais u elke dag welkom voor lunch en diner.  Wat de gelegenheid ook is, ons team, onze keuken en onze heerlijke wijnen zullen u begeleiden voor dit prachtige moment."
    ],
    "es": [
      "En el corazón de la región de Beaujolais, La Maison des Beaujolais le da la bienvenida todos los días para almorzar y cenar.  Sea cual sea la ocasión, nuestro equipo, nuestra cocina y nuestros buenos vinos le acompañarán en este maravilloso momento."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Maison des Beaujolais restaurant"
    ],
    "fr": [
      "La Maison des Beaujolais"
    ]
  },
