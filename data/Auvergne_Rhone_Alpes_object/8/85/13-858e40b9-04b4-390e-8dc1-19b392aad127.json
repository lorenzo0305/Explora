  "rdfs:comment": {
    "de": [
      "Das 2-Sterne-Hotel B&B befindet sich in einer ruhigen Umgebung, nur 2 km vom historischen Zentrum von Le Puy-en-Velay, dem Start des Jakobswegs, 1,5 km vom SNCF-Bahnhof, 5 Minuten von den Hauptverkehrsstraßen und 15 Minuten vom Flughafen entfernt."
    ],
    "en": [
      "The 2 star hotel B&B is situated near Le Puy en Velay, less than 10 minutes from the main monuments and from the St Jacques de Compostelle way, 1.5 km from the train station, 5 minutes from the main roads and 15 minutes from the aerodrome."
    ],
    "it": [
      "L'hotel B&B a 2 stelle è situato in un ambiente tranquillo a soli 2 km dal centro storico di Le Puy-en-Velay e dall'inizio del Cammino di Santiago de Compostela, a 1,5 km dalla stazione ferroviaria SNCF, a 5 minuti dalle strade principali e a 15 minuti dall'aeroporto."
    ],
    "fr": [
      "L’hôtel B&B, hôtel 2 étoiles, se situe dans un cadre calme à seulement 2 km du centre historique du Puy-en-Velay, du départ du chemin de St Jacques de Compostelle, à 1,5 km de la gare SNCF, à 5 min des principaux axes routiers et à 15 min de l’aéroport."
    ],
    "nl": [
      "Het 2-sterren B&B hotel ligt in een rustige omgeving op slechts 2 km van het historische centrum van Le Puy-en-Velay en het begin van de pelgrimsroute naar Santiago de Compostela, op 1,5 km van het SNCF treinstation, op 5 minuten van de hoofdwegen en op 15 minuten van het vliegveld."
    ],
    "es": [
      "El hotel B&B de 2 estrellas está situado en un entorno tranquilo, a sólo 2 km del centro histórico de Le Puy-en-Velay y del inicio del Camino de Santiago, a 1,5 km de la estación de tren SNCF, a 5 minutos de las principales carreteras y a 15 minutos del aeropuerto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "B&B Hôtel"
    ]
  },
