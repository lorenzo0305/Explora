  "rdfs:comment": {
    "de": [
      "Erleben Sie ein unvergleichliches Wohlfühlerlebnis in dieser ungewöhnlichen Massagepraxis, die mitten in der Natur liegt, nur 20 Minuten vom See von Annecy entfernt."
    ],
    "en": [
      "Traveling massage practice, sauna, relaxation workshops, introduction to wellness massage... Personalised services provided by a certified practitioner. All audiences: adults, children, individuals, companies, events, hotels..."
    ],
    "it": [
      "Godetevi un'incomparabile esperienza di benessere in questo insolito centro massaggi immerso nella natura, a soli 20 minuti dal lago di Annecy."
    ],
    "fr": [
      "Vivez une expérience bien-être incomparable dans ce cabinet de massage insolite situé en pleine nature, à seulement 20 minutes du lac d'Annecy."
    ],
    "nl": [
      "Geniet van een onvergelijkbare wellnesservaring in dit bijzondere massagecentrum midden in de natuur, op slechts 20 minuten van het meer van Annecy."
    ],
    "es": [
      "Disfrute de una experiencia de bienestar incomparable en este insólito centro de masajes situado en plena naturaleza, a sólo 20 minutos del lago de Annecy."
    ]
