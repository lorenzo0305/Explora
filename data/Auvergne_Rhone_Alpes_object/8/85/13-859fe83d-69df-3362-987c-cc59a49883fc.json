  "rdfs:comment": {
    "de": [
      "In der Residenz Les Flocons d'Argent, traditionelles Restaurant, Savoyer Spezialitäten, Pizzas und Gerichte vor Ort oder zum Mitnehmen. Mittags und abends.\r\nGroße Sonnenterrasse mit Blick auf die schönen Gipfel von Aussois. Zauberabend jeden Dienstag in der Saison."
    ],
    "en": [
      "In the Flocons d'Argent residence, traditional restaurant, Savoyard specialties, pizzas and takeaway or on-site dishes. Lunch and dinner.\r\nLarge sunny terrace overlooking the beautiful peaks of Aussois. Magic evening every Tuesday in season."
    ],
    "it": [
      "Nella residenza Flocons d'Argent, ristorante tradizionale, specialità savoiarde, pizze e piatti da mangiare o da portare via. Pranzo e sera.\r\nAmpia terrazza soleggiata con vista sulle splendide cime dell'Aussois. Serata magica ogni martedì in stagione."
    ],
    "fr": [
      "Dans la résidence les Flocons d'Argent, restaurant traditionnel, spécialités Savoyardes, pizzas et plats sur place où à emporter. Midi et soir.\r\nGrande terrasse ensoleillée avec vue sur les beaux sommets d'Aussois. Soirée magie tous les mardis en saisons."
    ],
    "nl": [
      "In de residentie Flocons d'Argent, traditioneel restaurant, Savoyaardse specialiteiten, pizza's en gerechten om te eten of mee te nemen. Lunchtijd en 's avonds.\r\nGroot zonnig terras met uitzicht op de prachtige toppen van de Aussois. Magische avond elke dinsdag in het seizoen."
    ],
    "es": [
      "En la residencia Flocons d'Argent, restaurante tradicional, especialidades saboyanas, pizzas y platos para comer o llevar. A mediodía y por la noche.\r\nGran terraza soleada con vistas a las bellas cumbres del Aussois. Velada mágica todos los martes de temporada."
    ]
  },
