  "rdfs:comment": {
    "de": [
      "Hausgemachter Spieß aus 100% französischem Fleisch, eingelegtem Gemüse und frischen Kräutern, alles in einem getoasteten Brot eines Bäckermeisters, das mit einer hausgemachten Sauce überzogen wird."
    ],
    "en": [
      "Homemade skewer of 100% French meat, candied vegetables and fresh herbs, all in a toasted bread from an Artisan Baker topped with a homemade sauce."
    ],
    "it": [
      "Spiedino fatto in casa di carne 100% francese, verdure conservate ed erbe fresche, il tutto in un pane tostato da un panettiere artigianale e condito con una salsa fatta in casa."
    ],
    "fr": [
      "Broche maison de viande 100% française, légumes confits et herbes fraîches, le tout dans un pain grillé d'un Artisan Boulanger nappé d'une sauce maison."
    ],
    "nl": [
      "Huisgemaakte spies van 100% Frans vlees, ingemaakte groenten en verse kruiden, alles in een geroosterd brood van een Artisan Boulanger overgoten met een huisgemaakte saus."
    ],
    "es": [
      "Brocheta casera de carne 100% francesa, verduras en conserva y hierbas frescas, todo ello en un pan tostado de un Panadero Artesano cubierto con una salsa casera."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Broche"
    ]
  },
