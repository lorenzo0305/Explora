  "rdfs:comment": {
    "de": [
      "Keramikatelier Kreation von Sandsteinobjekten durch Anne-France Torrent. Herstellung und Verkauf in der Werkstatt. Privatkurse für Drehen in zweistündigen Sitzungen zu 40? pro Sitzung. Bestellungen und Sonderwünsche: Bitte erkundigen Sie sich."
    ],
    "en": [
      "Ceramic workshop, creation of stoneware objects by Anne-France Torrent. Manufacture and sale in the workshop. Private lessons in throwing for 2 hours at 40? per session. Orders and special requests: please enquire."
    ],
    "it": [
      "Laboratorio di ceramica, creazione di oggetti in gres da parte di Anne-France Torrent. Produzione e vendita nel laboratorio. Lezioni private di lancio per 2 ore a 40 euro a sessione. Ordini e richieste speciali: chiedete pure."
    ],
    "fr": [
      "Atelier céramique création d'objets en grès par Anne-France Torrent. Fabrication et vente en atelier. Cours pour particuliers de tournage en séance de 2h à 40€ la séance. Commandes et demandes particulières: se renseigner."
    ],
    "es": [
      "Taller de cerámica, creación de objetos de gres por Anne-France Torrent. Fabricación y venta en el taller. Clases particulares de lanzamiento de 2 horas a 40 euros la sesión. Encargos y pedidos especiales: consultar."
    ],
    "nl": [
      "Keramisch atelier, creatie van steengoed objecten door Anne-France Torrent. Vervaardiging en verkoop in het atelier. Privéles in werpen van 2 uur voor 40 euro per sessie. Bestellingen en speciale verzoeken: op aanvraag."
    ]
  },
