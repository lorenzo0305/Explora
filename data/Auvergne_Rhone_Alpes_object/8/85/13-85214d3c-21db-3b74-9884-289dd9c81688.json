  "rdfs:comment": {
    "de": [
      "In der Nähe von La Chaise-Dieu lädt dieses experimentelle Arboretum, das im Frühjahr 1993 auf 3 ha inmitten von Nadelwäldern gepflanzt wurde, Groß und Klein zu Spaziergängen ein, bei denen sie verschiedene Baumarten entdecken können. Botanikliebhaber entdecken hier einen bemerkenswerten Ort."
    ],
    "en": [
      "Near La Chaise-Dieu, this experimental arboretum planted in the spring of 1993 on 3 ha in the middle of coniferous forests, invites you to take a stroll where young and old will discover various species of trees.\r\nIf you are a fan of botany, you will love this magnificent site"
    ],
    "it": [
      "Vicino a La Chaise-Dieu, questo arboreto sperimentale è stato piantato nella primavera del 1993 su un terreno di 3 ettari in mezzo a foreste di conifere, invitando grandi e piccini a passeggiare e a scoprire una varietà di specie arboree. Scoprite un sito straordinario per gli amanti della botanica."
    ],
    "fr": [
      "Près de La Chaise-Dieu, cet arboretum expérimental planté au printemps 1993 sur 3 ha au milieu de forêts de résineux, invite à la balade petits et grands qui découvriront diverses essences d'arbres. Amoureux de botanique, découvrez un site remarquable."
    ],
    "nl": [
      "In de buurt van La Chaise-Dieu werd dit experimentele arboretum in de lente van 1993 aangelegd op een terrein van 3 hectare te midden van naaldbossen. Het nodigt jong en oud uit om een wandeling te maken en verschillende boomsoorten te ontdekken. Ontdek een opmerkelijke site voor liefhebbers van plantkunde."
    ],
    "es": [
      "Cerca de La Chaise-Dieu, este arboreto experimental se plantó en la primavera de 1993 en un terreno de 3 hectáreas en medio de bosques de coníferas, invitando a pequeños y mayores a pasear y descubrir una gran variedad de especies arbóreas. Descubra un lugar excepcional para los amantes de la botánica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Arboretum de Charvols"
    ]
  },
