  "rdfs:comment": {
    "de": [
      "Praxis: Paragliding\r\nOrientierung : N\r\nBemerkungen/Gefahren: Start für Anfänger nicht empfehlenswert, da ohne Wind beeindruckend. Gelände in den Bergen.\r\nOberhalb der Gondelbahn von Thollon gelegen."
    ],
    "en": [
      "Practice: paragliding\r\nDirection: N\r\nObservations / Dangers: take-off not recommended for absolute beginners, as impressive without wind. Mountain terrain.\r\nLocated at the top of the Thollon Télécabine."
    ],
    "it": [
      "Pratica : parapendio\r\nDirezione: N\r\nOsservazioni / Pericoli: sconsigliato ai principianti perché è impressionante anche senza vento. Terreno di montagna.\r\nSituato in cima alla funivia di Thollon."
    ],
    "fr": [
      "Pratique : parapente\r\nOrientation : N\r\nObservations / Dangers : décollage déconseillé aux tout débutants car impressionnant sans vent. Terrain de montagne.\r\nSitué en Haut de la Télécabine de Thollon."
    ],
    "nl": [
      "Praktijk: paragliding\r\nRichting: N\r\nOpmerkingen / Gevaren: opstijgen niet aanbevolen voor absolute beginners omdat het indrukwekkend is zonder wind. Bergachtig terrein.\r\nGelegen op de top van de Thollon Télécabine."
    ],
    "es": [
      "Práctica : parapente\r\nDirección: N\r\nObservaciones / Peligros: no se recomienda para principiantes ya que es impresionante sin viento. Terreno de montaña.\r\nSituado en la parte superior del teleférico de Thollon."
    ]
  },
  "rdfs:label": {
    "en": [
      "Take off from the Lavanchy"
    ],
    "fr": [
      "Décollage du Lavanchy"
    ],
    "nl": [
      "Opstijgen uit Lavanchy"
    ]
  },
