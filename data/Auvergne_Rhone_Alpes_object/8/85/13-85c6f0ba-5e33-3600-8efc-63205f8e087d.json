  "rdfs:comment": {
    "de": [
      "Die Bibliothekarinnen bieten den kleinen Ohren thematische Geschichten, Reime, Fingerspiele und gemeinsames Lesen an, um die kleinen Ohren zu wecken."
    ],
    "en": [
      "Librarians offer themed stories, nursery rhymes, finger plays and shared readings to awaken little ears."
    ],
    "it": [
      "I bibliotecari propongono storie a tema, filastrocche, giochi di dita e letture condivise per risvegliare le piccole orecchie."
    ],
    "fr": [
      "Les bibliothécaire proposent aux petites oreilles des histoires thématiques, des comptines, des jeux de doigts et des lectures partagées pour éveiller les petites oreilles."
    ],
    "es": [
      "Los bibliotecarios ofrecen cuentos temáticos, canciones infantiles, juegos con los dedos y lecturas compartidas para despertar los oídos de los más pequeños."
    ],
    "nl": [
      "De bibliothecarissen bieden thematische verhalen, kinderliedjes, vingerspelletjes en gezamenlijke voorleessessies om de kleine oortjes wakker te schudden."
    ]
  },
