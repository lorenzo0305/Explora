  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/244d2cc6-65cf-3d15-879c-2b758e8fb6dc",
      "dc:description": {
        "de": [
          "Für Externe: Hochzeit, Kommunion, Bankett: 550? Tagesmiete + 150? für den nächsten Tag\n\nFür Einwohner der Gemeinde: Hochzeit, Kommunion, Bankett: 250? pro Tag + 100? am nächsten Tag\n\nHeizkostenzuschlag von November bis Februar\n\nVerfügbarkeit und weitere Informationen nur im Rathaus."
        ],
        "en": [
          "For outsiders: weddings, communions, banquets: 550? daily rental + 150? for the following day\n\nFor local residents: Wedding, communion, banquet: 250? per day + 100? per subsequent day\n\nHeating surcharge from November to February.\n\nAvailability and further information only at the Town Hall."
        ],
        "it": [
          "Per gli esterni: Matrimoni, comunioni, banchetti: 550? al giorno + 150? al giorno successivo\n\nPer i residenti locali: Matrimoni, comunioni, banchetti: 250? al giorno + 100? al giorno successivo\n\nSupplemento riscaldamento da novembre a febbraio.\n\nDisponibilità e ulteriori informazioni solo presso il Municipio."
        ],
        "fr": [
          "Pour les extérieurs : Mariage, communion, banquet : 550€ la location journalière + 150€ la journée suivante \n\nPour les habitants de la commune : Mariage, communion, banquet : 250€ la location journalière + 100€ la journée suivante \n\nSupplément chauffage de novembre à février. \n\nDisponibilités et renseignements supplémentaires uniquement à la mairie."
        ],
        "nl": [
          "Voor buitenstaanders: Bruiloften, communies, banketten: 550? per dag + 150? per dag daarna\n\nVoor inwoners: Bruiloften, communies, banketten: 250 per dag + 100 per dag daarna\n\nBijkomende verwarmingskosten van november tot februari.\n\nBeschikbaarheid en verdere informatie uitsluitend bij het gemeentehuis."
        ],
        "es": [
          "Para los forasteros: Bodas, comuniones, banquetes: 550? por día + 150? por día posterior\n\nPara residentes locales: Bodas, comuniones, banquetes: 250? por día + 100? por día posterior\n\nCargo adicional por calefacción de noviembre a febrero.\n\nDisponibilidad y más información sólo en el Ayuntamiento."
        ]
      },
