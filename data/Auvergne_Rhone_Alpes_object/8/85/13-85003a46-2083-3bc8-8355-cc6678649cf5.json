  "rdfs:comment": {
    "de": [
      "Bauernhofproduzenten von Ziegenkäse (Crottins, Quark, Tomes,...), Wurstwaren und Fleisch vom Bauernschwein (Wurst, Kopfkäse,...) sowie von Stopfenten (Stopfleber, Entenbrust,...) Direktverkauf und Sammelstellen."
    ],
    "en": [
      "Farm producers of goat's cheese (crottins, fromage blanc, tomes, etc.), charcuterie and farm-raised pork (sausages, head cheese, etc.) and duck (foie gras, magret, etc.). Direct sales and collective outlets."
    ],
    "it": [
      "Produttori agricoli di formaggi di capra (crottins, fromage blanc, tomes, ecc.), salumi e carni suine di fattoria (salsicce, formaggi di testa, ecc.) e anatre ingrassate (foie gras, magret, ecc.). Vendita diretta e punti vendita collettivi."
    ],
    "fr": [
      "Producteurs fermiers de fromages de chèvre (crottins, fromages blancs, tomes,...) ,de charcuteries et viandes de porc fermier (saucissons, fromage de tête...) ainsi que de canards gras (foie gras, magret...) Vente directe et points collectifs."
    ],
    "es": [
      "Granjas productoras de quesos de cabra (crottins, fromage blanc, tomes, etc.), charcutería y chacinas de granja (salchichas, queso de cabeza, etc.) y patos cebados (foie gras, magret, etc.). Venta directa y puntos de venta colectivos."
    ],
    "nl": [
      "Boerderijproducenten van geitenkaas (crottins, fromage blanc, tomes, enz.), vleeswaren en vleeswaren van boerenvarkens (worsten, kopkaas, enz.) en vetgemeste eenden (foie gras, magret, enz.). Rechtstreekse verkoop en collectieve verkooppunten."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Farm of Bruyères"
    ],
    "fr": [
      "La Ferme des Bruyères"
    ]
  },
