  "rdfs:comment": {
    "de": [
      "Die Ferme Nikita ist ein kleiner, ganzheitlicher Freiland-Schweinezuchtbetrieb mit biologischem Anbau.\r\nDidier züchtet und züchtet seit sechs Jahren Schweine und Ferkel rustikaler Rassen.\r\nAlle Schweine sind für den Verkauf bestimmt und werden von ihm selbst verarbeitet."
    ],
    "en": [
      "At Ferme Nikita, Didier has been raising pigs and piglets for six years, from birth to processing and sale."
    ],
    "it": [
      "Ferme Nikita è una piccola azienda suinicola completamente biologica e all'aperto.\r\nDidier alleva e cresce maiali e suinetti resistenti da sei anni.\r\nTutti i suini sono venduti e lavorati dallo stesso Didier."
    ],
    "fr": [
      "La Ferme Nikita est un petit élevage de porc plein air intégral en agriculture biologique.\r\nDidier fait naître et élève depuis six années des porcs et porcelets de races rustiques.\r\nTous les porcs sont destinés à la vente et transformé par ses soins."
    ],
    "nl": [
      "Op Ferme Nikita houdt Didier al zes jaar varkens en biggen, van geboorte tot verwerking en verkoop."
    ],
    "es": [
      "Ferme Nikita es una pequeña granja de cerdos camperos totalmente ecológicos.\r\nDidier lleva seis años criando cerdos y lechones resistentes.\r\nTodos los cerdos son vendidos y transformados por el propio Didier."
    ]
  },
  "rdfs:label": {
