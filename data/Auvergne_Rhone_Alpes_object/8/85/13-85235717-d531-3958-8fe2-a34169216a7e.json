  "rdfs:comment": {
    "de": [
      "Saisonale Küche mit südländischem Geschmack und Aromen\r\nAlfred hat sich auch einem umweltbewussten Ansatz verschrieben und bietet ab sofort ein rein pflanzliches Menü an."
    ],
    "en": [
      "Seasonal cuisine with southern tastes and flavors.\r\nAlfred is also committed to an eco-responsible approach, and now offers an all-vegetable menu."
    ],
    "it": [
      "Cucina stagionale con gusti e sapori del sud\r\nAlfred è anche impegnato in un approccio eco-responsabile e ora offre un menu interamente vegetale."
    ],
    "fr": [
      "Cuisine de saison aux goûts et saveurs du sud. \r\nAlfred s’est aussi engagé dans une démarche éco-responsable et propose dorénavant un menu entièrement Végétal."
    ],
    "nl": [
      "Seizoensgebonden keuken met zuidelijke smaken en aroma's\r\nAlfred zet zich ook in voor een ecologisch verantwoorde aanpak en biedt nu een volledig plantaardig menu."
    ],
    "es": [
      "Cocina de temporada con gustos y sabores del sur\r\nAlfred también apuesta por un enfoque eco-responsable y ahora ofrece un menú totalmente vegetal."
    ]
  },
