  "rdfs:comment": {
    "de": [
      "Alexandra und Cédric empfangen Sie für eine Mahlzeit, eine süße Pause oder auch als Teesalon. Hausgemachtes in einer familiären Atmosphäre. Le Repaire ist mit dem Auto oder zu Fuß über die Wanderwege im Sommer und die präparierten Pisten im Winter erreichbar."
    ],
    "en": [
      "Alexandra and Cédric welcome you for a meal, a sweet break or as a tea room. All homemade in a family atmosphere. Le Repaire is accessible by car, or on foot via trails in summer and groomed slopes in winter."
    ],
    "it": [
      "Alexandra e Cédric vi accolgono per un pasto, una pausa dolce o come sala da tè. Tutto fatto in casa in un'atmosfera familiare. Le Repaire è accessibile in auto o a piedi attraverso i sentieri in estate e le piste battute in inverno."
    ],
    "fr": [
      "Alexandra et Cédric vous accueillent pour un repas, une pause sucrée ou encore en version salon de thé. Du fait maison dans une ambiance familiale. Le Repaire est accessible en voiture, ou à pied par les sentiers en été, les pistes damées en hiver."
    ],
    "es": [
      "Alexandra y Cédric le dan la bienvenida para una comida, una pausa dulce o como salón de té. Todo casero en un ambiente familiar. Le Repaire es accesible en coche o a pie por los senderos en verano y las pistas acondicionadas en invierno."
    ],
    "nl": [
      "Alexandra en Cédric heten je welkom voor een maaltijd, een zoete pauze of als theesalon. Alles zelfgemaakt in een familiale sfeer. Le Repaire is bereikbaar met de auto, of te voet via de wandelpaden in de zomer en de geprepareerde pistes in de winter."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Crêperie du Repaire"
    ],
    "fr": [
      "La Crêperie du Repaire"
    ]
  },
