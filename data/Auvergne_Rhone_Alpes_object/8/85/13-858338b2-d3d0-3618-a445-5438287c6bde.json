  "rdfs:comment": {
    "de": [
      "Das Institut führt zahlreiche Gesichts- und Körperbehandlungen durch, bietet Ihnen Make-up, Hand- und Fußpflege mit oder ohne Lackieren sowie Cocooning-Pakete an."
    ],
    "en": [
      "The institute offers a wide range of face and body treatments, as well as make-up, hand and foot care with or without nail polish, and cocooning packages."
    ],
    "it": [
      "L'istituto offre un'ampia gamma di trattamenti per il viso e per il corpo, make-up, cura delle mani e dei piedi con o senza smalto e pacchetti cocooning."
    ],
    "fr": [
      "L'institut assure de nombreux soins de visage et corps, propose de vous maquiller, de faire des soins mains et pieds avec ou sans pose de vernis ainsi que des forfaits cocooning."
    ],
    "nl": [
      "Het instituut biedt een breed scala aan gezichts- en lichaamsbehandelingen, make-up, hand- en voetverzorging met of zonder nagellak, en cocooningpakketten."
    ],
    "es": [
      "El instituto ofrece una amplia gama de tratamientos faciales y corporales, maquillaje, cuidado de manos y pies con o sin esmalte de uñas, y paquetes cocooning."
    ]
  },
