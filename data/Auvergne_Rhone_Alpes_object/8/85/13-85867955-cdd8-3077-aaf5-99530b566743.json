  "rdfs:comment": {
    "de": [
      "Audrey und Nicolas begrüßen Sie in der rustikalen Umgebung eines alten renovierten Bauernhauses mit Terrasse und Garten in einer ruhigen Gegend in der Nähe von Sehenswürdigkeiten. 14 komplett renovierte Zimmer. Traditionelle und hausgemachte Küche."
    ],
    "en": [
      "Audrey and Nicolas welcome you in the rustic setting of an old renovated farmhouse, with a terrace and a garden, in a quiet area, close to tourist sites. 14 completely renovated rooms. Traditional and homemade cuisine."
    ],
    "it": [
      "Audrey e Nicolas vi accolgono nell'ambiente rustico di un'antica casa colonica ristrutturata, con terrazza e giardino, in una zona tranquilla, vicino alle attrazioni turistiche. 14 camere completamente rinnovate. Cucina tradizionale e casalinga."
    ],
    "fr": [
      "Audrey et Nicolas vous accueillent dans le cadre rustique d'une ancienne ferme rénovée, dotée d'une terrasse et d'un jardin, au calme, proche de lieux touristiques. 14 chambres entièrement rénovées. Cuisine traditionnelle et faite maison."
    ],
    "es": [
      "Audrey y Nicolas le dan la bienvenida en el entorno rústico de una antigua granja renovada, con una terraza y un jardín, en una zona tranquila, cerca de las atracciones turísticas. 14 habitaciones totalmente renovadas. Cocina tradicional y casera."
    ],
    "nl": [
      "Audrey en Nicolas heten u welkom in de rustieke omgeving van een oude gerenoveerde boerderij, met een terras en een tuin, in een rustige omgeving, dicht bij toeristische attracties. 14 volledig gerenoveerde kamers. Traditionele en huisgemaakte keuken."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Vielle Ferme"
    ],
    "fr": [
      "La Vieille Ferme"
    ]
  },
