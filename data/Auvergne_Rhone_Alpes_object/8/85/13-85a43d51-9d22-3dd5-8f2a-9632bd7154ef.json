  "rdfs:comment": {
    "de": [
      "Le Plan, im Winter am Fuße der Pisten; im Sommer am Beginn der Wanderwege. Johann bietet Ihnen eine traditionelle und raffinierte Küche aus lokalen Produkten. Experte für die Organisation von Hochzeiten. NEU: Drehspießservice für Familienveranstaltungen."
    ],
    "en": [
      "Au Plan, at the foot of the slopes in winter and at the start of the trails in summer. Johann offers traditional, refined cuisine based on local produce. Expert wedding planner. NEW: spit-turner service for family events."
    ],
    "it": [
      "Au Plan, ai piedi delle piste in inverno e all'inizio dei sentieri in estate. Johann offre una cucina tradizionale e raffinata a base di prodotti locali. Esperto wedding planner. NOVITÀ: servizio di spiederia per eventi familiari."
    ],
    "fr": [
      "Au Plan, l'hiver au pied des pistes ; l'été au départ des sentiers. Johann vous propose une cuisine traditionnelle et raffinée à base de produits locaux. Expert dans l'organisation de mariages. NOUVEAU : service de tourne-broche pour événements familiaux."
    ],
    "es": [
      "Au Plan, al pie de las pistas en invierno y al comienzo de los senderos en verano. Johann ofrece una cocina tradicional y refinada basada en los productos locales. Experto organizador de bodas. NOVEDAD: servicio de asador para eventos familiares."
    ],
    "nl": [
      "Au Plan, aan de voet van de pistes in de winter en aan het begin van de loipes in de zomer. Johann biedt een traditionele, verfijnde keuken op basis van lokale producten. Deskundige weddingplanner. NIEUW: spit-turner service voor familie-evenementen."
    ]
  },
