  "rdfs:comment": {
    "de": [
      "Das Restaurant A Ma Façon bietet eine kreative, moderne und saisonale Küche. Wir wählen unsere Produkte sorgfältig aus und verarbeiten sie, um Ihnen eine hausgemachte, originelle und raffinierte Küche anzubieten."
    ],
    "en": [
      "The A Ma Façon restaurant offers creative, modern and seasonal cuisine. We carefully select and process our produce to offer you original, refined, home-cooked cuisine."
    ],
    "it": [
      "Il ristorante A Ma Façon offre una cucina creativa, moderna e stagionale. Selezioniamo e lavoriamo con cura i nostri prodotti per offrirvi una cucina casalinga, originale e raffinata."
    ],
    "fr": [
      "Le restaurant A Ma Façon propose une cuisine créative, moderne et de saison. Nous sélectionnons et travaillons nos produits avec soin pour vous proposer une cuisine faite maison, originale et raffinée."
    ],
    "nl": [
      "Het restaurant A Ma Façon biedt een creatieve, moderne en seizoensgebonden keuken. Wij selecteren en bewerken onze producten met zorg om u een huisgemaakte, originele en verfijnde keuken aan te bieden."
    ],
    "es": [
      "El restaurante A Ma Façon propone una cocina creativa, moderna y de temporada. Seleccionamos y elaboramos cuidadosamente nuestros productos para ofrecerle una cocina casera, original y refinada."
    ]
  },
  "rdfs:label": {
