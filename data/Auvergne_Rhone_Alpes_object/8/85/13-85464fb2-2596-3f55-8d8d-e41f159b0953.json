  "rdfs:comment": {
    "de": [
      "Geselliges und familiäres Restaurant, in dem man sich gerne trifft, um eine gepflegte traditionelle Küche zu genießen. Augenweide und Gaumenfreude, wir heißen Sie herzlich willkommen."
    ],
    "en": [
      "Hospitable family restaurant ideal for getting together to eat delicious traditional cuisine. The welcome is relaxed and you will experience a feast for the eyes and the taste buds."
    ],
    "it": [
      "Un ristorante accogliente e familiare dove si può gustare una cucina tradizionale preparata con cura. Un piacere per gli occhi e per le papille gustative, vi accogliamo in tutta semplicità."
    ],
    "fr": [
      "Restaurant convivial et familial où il fait bon se retrouver pour déguster une cuisine traditionelle soignée. Plaisir des yeux et plaisir des papilles, nous vous accueillons en toute simplicité."
    ],
    "es": [
      "Un restaurante familiar y acogedor en el que se puede disfrutar de una cocina tradicional y cuidada. Un placer para la vista y el paladar, le acogemos con toda sencillez."
    ],
    "nl": [
      "Een gezellig familierestaurant waar u kunt genieten van traditionele, met zorg bereide gerechten. Een genot voor de ogen en de smaakpapillen, wij verwelkomen u in alle eenvoud."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Beaujolais"
    ]
  },
