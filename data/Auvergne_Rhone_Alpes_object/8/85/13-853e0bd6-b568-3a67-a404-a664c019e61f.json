  "rdfs:comment": {
    "de": [
      "Willkommen im Bacchus Club & Rooftop, einem außergewöhnlichen Ort, an dem die Gastronomie und das Feiern aufeinandertreffen.\r\nEin einzigartiger Ort in Bourgoin-Jallieu!\r\nEin einzigartiger Ort in einem schicken und gemütlichen Ambiente, drinnen oder auf dem Rooftop, wo Sie die Sonne in vollen Zügen genießen können."
    ],
    "en": [
      "Discover \"Bacchus Restaurant\", a unique space in the heart of Singer Park in Bourgoin-Jallieu! A Restaurant-Pub/Lounge and Rooftop...A unique place in a chic and cosy atmosphere inside or on the rooftop to fully enjoy the sun."
    ],
    "it": [
      "Benvenuti al Bacchus Club & Rooftop, un luogo eccezionale dove si incontrano gastronomia e festa.\r\nUn locale unico a Bourgoin-Jallieu!\r\nUn locale unico con un'atmosfera chic e accogliente, sia all'interno che sul tetto, dove potrete approfittare del sole."
    ],
    "fr": [
      "Bienvenue au Bacchus Club & Rooftop, un lieu d’exception où la gastronomie et la fête se rencontrent.\r\nUn espace singulier à Bourgoin-Jallieu!\r\nUn lieu unique dans une ambiance chic et cosy à l’intérieur ou sur le rooftop pour profiter pleinement du soleil."
    ],
    "nl": [
      "Welkom bij Bacchus Club & Rooftop, een uitzonderlijke plek waar gastronomie en feest samenkomen.\r\nEen unieke locatie in Bourgoin-Jallieu!\r\nEen unieke plek met een chique, gezellige sfeer, binnen of op het dak, waar je kunt genieten van de zon."
    ],
    "es": [
      "Bienvenido a Bacchus Club & Rooftop, un lugar excepcional donde se dan cita la gastronomía y la fiesta.\r\nUn lugar único en Bourgoin-Jallieu\r\nUn lugar único con un ambiente elegante y acogedor, tanto en el interior como en la azotea, donde podrá disfrutar al máximo del sol."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bacchus Resto festif - Club & Rooftop"
    ]
  },
