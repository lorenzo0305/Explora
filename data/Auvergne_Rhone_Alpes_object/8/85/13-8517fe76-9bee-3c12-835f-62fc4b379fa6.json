  "rdfs:comment": {
    "de": [
      "Das Hôtel du Centre mit seinem Restaurant „La Bougie“ mitten im Dorfzentrum von Villard-de-Lans wird Sie das ganze Jahr über gerne willkommen heißen."
    ],
    "en": [
      "Located in the heart of the village of Villard de Lans, next to the Bear square, the Hotel du Centre and its restaurant La Bougie is pleased to service you all year long. The hotel has 9 rooms with shower and toilet."
    ],
    "it": [
      "Situato nel cuore del villaggio di Villard de Lans, a 2 passi da Place de l'Ours, l'Hôtel du Centre e il suo ristorante La Bougie saranno lieti di accogliervi tutto l'anno. L'hotel dispone di 9 camere con doccia e servizi igienici."
    ],
    "fr": [
      "Situé en plein coeur du village de Villard de Lans, à 2 pas de la place de l'Ours, l'Hôtel du Centre et son restaurant La Bougie seront ravis de vous accueillir tout au long de l'année. L'hôtel est doté de 9 chambres avec douche et wc."
    ],
    "es": [
      "Situado en el corazón del pueblo de Villard de Lans, a 2 pasos de la Place de l'Ours, el Hôtel du Centre y su restaurante La Bougie estarán encantados de recibirle durante todo el año. El hotel dispone de 9 habitaciones con ducha y WC."
    ],
    "nl": [
      "Gelegen in het hart van het dorp Villard de Lans, op 2 stappen van het Place de l'Ours, zal Hôtel du Centre en zijn restaurant La Bougie u het hele jaar door met plezier verwelkomen. Het hotel heeft 9 kamers met douche en toilet."
    ]
  },
