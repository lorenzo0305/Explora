  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a9ab15a9-5f2c-3234-b576-7aab0c8eb10a",
      "dc:description": {
        "de": [
          "Immobilienagentur .\n\nKontaktieren Sie sie, um :\n- Termine für Besichtigungen zu vereinbaren\n- Die Verfolgung Ihres Dossiers\n- Informationen zu den Anzeigen\n- Oder um Ihre Immobilie für unsere zahlreichen wartenden Kunden zum Verkauf anzubieten"
        ],
        "en": [
          "Real Estate Agency .\n\nContact them to :\n- Making appointments for visits\n- Follow-up of your file\n- Information on advertisements\n- Or to put your property up for sale for our many waiting customers"
        ],
        "it": [
          "Agenzia immobiliare .\n\nContattateli per :\n- Fissare appuntamenti per le visite\n- Seguire la vostra pratica\n- Informazioni sugli annunci\n- Oppure per mettere in vendita la vostra proprietà per i nostri numerosi clienti in attesa"
        ],
        "fr": [
          "Agence Immobilière .\n\nContactez-les pour :\n- Prendre rendez-vous pour des visites\n- Le suivi de votre dossier\n- Des informations sur les annonces\n- Ou pour mettre votre bien en vente pour nos nombreux clients en attente"
        ],
        "nl": [
          "Makelaar .\n\nNeem contact met hen op om :\n- Afspraken te maken voor bezichtigingen\n- Opvolging van uw dossier\n- Informatie over advertenties\n- Of om je eigendom te koop te zetten voor onze vele wachtende klanten"
        ],
        "es": [
          "Agencia inmobiliaria .\n\nPóngase en contacto con ellos para :\n- Concertar citas para visitas\n- Seguimiento de su expediente\n- Información sobre anuncios\n- O para poner su propiedad en venta para nuestros numerosos clientes en espera"
        ]
      },
      "@type": [
        "Description"
      ],
