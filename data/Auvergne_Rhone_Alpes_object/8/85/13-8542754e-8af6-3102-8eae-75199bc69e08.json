  "rdfs:comment": {
    "de": [
      "Ein gemütlicher Ort, um sich mit Freunden, Familie oder Kollegen zum Mittagessen zu treffen. Eine hausgemachte Küche mit lokalen und oft biologischen Produkten. Hof des 15. Jahrhunderts in Zugang mit 18 Plätzen."
    ],
    "en": [
      "A friendly place to meet for lunch with friends, family or colleagues. A home-made cuisine with local and often organic products. Courtyard of the 15th in access with 18 places."
    ],
    "it": [
      "Un luogo accogliente dove incontrarsi a pranzo con amici, familiari o colleghi. Cibo fatto in casa con prodotti locali e spesso biologici. Cortile del 15° in accesso con 18 posti."
    ],
    "fr": [
      "Une endroit convivial pour se retrouver le midi entre amis, familles ou encore collègues. Une cuisine faite maison avec des produits locaux et souvent biologiques. Cour du 15ème en accès avec 18 places."
    ],
    "es": [
      "Un lugar agradable para reunirse a comer con los amigos, la familia o los colegas. Comida casera con productos locales y a menudo ecológicos. Patio del 15 en acceso con 18 plazas."
    ],
    "nl": [
      "Een gezellige plek om af te spreken voor een lunch met vrienden, familie of collega's. Huisgemaakt eten met lokale en vaak biologische producten. Binnenplaats van de 15e in toegang met 18 plaatsen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "T.O.C."
    ]
  },
