  "rdfs:comment": {
    "de": [
      "Die Unterpräfektur ist für die Förderung der lokalen Entwicklung und die bürgernahe Verwaltungstätigkeit zuständig und die bevorzugte Ebene für die Abstimmung mit den lokalen Abgeordneten."
    ],
    "en": [
      "The sub-prefecture is in charge of the animation of local development, local administrative action and the privileged level of consultation with local elected officials."
    ],
    "it": [
      "La sottoprefettura è responsabile dell'animazione dello sviluppo locale, dell'azione amministrativa di prossimità e del livello privilegiato di consultazione con gli eletti locali."
    ],
    "fr": [
      "La sous-préfecture est chargée de l'animation du développement local, de l'action administrative de proximité et le niveau privilégié de la concertation avec des élus locaux."
    ],
    "es": [
      "La subprefectura es responsable de la animación del desarrollo local, de la acción administrativa de proximidad y del nivel privilegiado de concertación con los electos locales."
    ],
    "nl": [
      "De onderprefectuur is verantwoordelijk voor het beheer van de plaatselijke ontwikkeling, het bestuurlijke optreden in de nabijheid en het bevoorrechte niveau van overleg met de plaatselijke verkozenen."
    ]
  },
