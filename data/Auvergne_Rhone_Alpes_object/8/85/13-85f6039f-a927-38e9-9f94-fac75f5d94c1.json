  "rdfs:comment": {
    "de": [
      "15 Minuten von Roanne entfernt: La Cure, das Zentrum für Kunsthandwerk von Roannais Agglomération, liegt im Herzen eines charaktervollen Dorfes und hat die Begleitung und Förderung des Kunsthandwerks zum Ziel"
    ],
    "en": [
      "15 min from Roanne: Located in the heart of a village full of character, La Cure, Pôle métiers d?art de Roannais Agglomération aims to support and promote the arts and crafts sector through an arts and crafts incubator, an exhibition space and a training centre"
    ],
    "it": [
      "A 15 minuti da Roanne: situato nel cuore di un villaggio pieno di carattere, La Cure, il Centro delle Arti e dei Mestieri dell'Agglomerazione di Roannais, mira a sostenere e promuovere le arti e i mestieri attraverso un incubatore di arti e mestieri, uno spazio espositivo e un centro di formazione"
    ],
    "fr": [
      "À 15 min de Roanne : Installée au cœur d’un village de caractère, La Cure, Pôle métiers d’art de Roannais Agglomération a pour objectifs l’accompagnement et la promotion des Métiers d’art à travers une pépinière d’artisans d’art, un espace d’expositions t"
    ],
    "nl": [
      "Op 15 minuten van Roanne: La Cure, het kunst- en ambachtscentrum van de Roannais Agglomération, ligt in het hart van een karaktervol dorp en heeft als doel het ondersteunen en promoten van kunst en ambacht door middel van een kunst- en ambachtsbroedplaats, een expositieruimte en een opleidingscentrum"
    ],
    "es": [
      "A 15 minutos de Roanne: Situado en el corazón de un pueblo lleno de carácter, La Cure, el Centro de Artesanía de la Agglomération de Roannais, tiene como objetivo apoyar y promover las artes y la artesanía a través de una incubadora de artes y oficios, un espacio de exposición y un centro de formación"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cure, Pôle Touristique et  Métiers d'Art"
    ]
  },
