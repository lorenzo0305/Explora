  "rdfs:comment": {
    "de": [
      "Sylvain ist einer der letzten Handwerker in Savoyen, die Bücher zur Geltung bringen. Als Buchbinder, Vergolder und Dekorateur ist er vor allem von der Arbeit mit Leder fasziniert. Nach Vereinbarung können Sie sein Atelier betreten und bei einem Atelierbesuch in seine Welt eintauchen."
    ],
    "en": [
      "Sylvain is one of the last Savoy craftsmen to bring books to life. A bookbinder, gilder and decorator, he is above all passionate about working with leather. By appointment, come and visit his workshop and enter his world."
    ],
    "it": [
      "Sylvain è uno degli ultimi artigiani della Savoia a valorizzare i libri. Legatore, doratore e decoratore, la sua passione principale è la lavorazione del cuoio. Venite a visitare il suo laboratorio, su appuntamento, ed entrate nel suo mondo."
    ],
    "fr": [
      "Sylvain est un des derniers artisans des Savoie à mettre les livres en valeur. Relieur, doreur et décorateur, c'est avant tout le travail du cuir qui le passionne. Sur rdv, pénétrez son atelier et entrez dans son univers lors d'une visite de l'atelier."
    ],
    "nl": [
      "Sylvain is een van de laatste ambachtslieden in de Savoie die boeken veredelt. Als boekbinder, gilder en decorateur is zijn grootste passie het werken met leer. Kom op afspraak zijn werkplaats bezoeken en betreed zijn wereld."
    ],
    "es": [
      "Sylvain es uno de los últimos artesanos de la región de Saboya que se dedica a realzar libros. Encuadernador, dorador y decorador, su principal pasión es el trabajo del cuero. Venga a visitar su taller, previa cita, y entre en su mundo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de reliure Monsieur Livre Savoy' Art"
    ]
  },
