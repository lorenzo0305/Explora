  "rdfs:comment": {
    "de": [
      "Im Olympiajahr verpflichtet, bietet das Festival CineComedies eine Auswahl an Komödien rund um den Sport, zwischen großen Klassikern und seltenen Filmen."
    ],
    "en": [
      "In keeping with the Olympic year, the CineComedies Festival offers a selection of sports-related comedies, ranging from the great classics to rare films."
    ],
    "it": [
      "Nell'ambito dell'anno olimpico, il Festival CineComedies propone una selezione di commedie legate allo sport, dai grandi classici ai film rari."
    ],
    "fr": [
      "Année olympique oblige, le Festival CineComedies propose une sélection de comédies autour du sport, entre grands classiques et films rares."
    ],
    "nl": [
      "Met de Olympische Spelen voor de deur biedt het CineComedies Festival een selectie sportgerelateerde komedies, van grote klassiekers tot zeldzame films."
    ],
    "es": [
      "Con los Juegos Olímpicos a la vuelta de la esquina, el Festival CineComedies propone una selección de comedias relacionadas con el deporte, desde los grandes clásicos hasta películas poco frecuentes."
    ]
  },
  "rdfs:label": {
