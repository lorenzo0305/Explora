  "rdfs:comment": {
    "de": [
      "Das 9 ha große Familienweingut liegt in Malleval, einem mittelalterlichen Dorf im Herzen des Pilat-Massivs.\r\nAlle Weine des Weinguts werden ausschließlich aus den Trauben der eigenen Produktion hergestellt."
    ],
    "en": [
      "Family estate of 9ha located in Malleval, a medieval village in the heart of the Pilat massif.\r\nFrom pruning to harvesting, all the work is done by hand, and all the wines of the estate are made only with the grapes of their own production."
    ],
    "it": [
      "Tenuta familiare di 9 ettari situata a Malleval, un villaggio medievale nel cuore del massiccio del Pilat.\r\nDalla potatura alla vendemmia, tutto il lavoro è fatto a mano e tutti i vini della tenuta sono realizzati solo con le uve di propria produzione."
    ],
    "fr": [
      "Domaine familial de 9ha situé à Malleval, village médiéval au cœur du massif du Pilat.\r\nDe la taille à la vendange le travail est entièrement manuel, tous les vins du domaine sont élaborés uniquement avec les raisins de leur production."
    ],
    "es": [
      "Finca familiar de 9ha situada en Malleval, un pueblo medieval en el corazón del macizo del Pilat.\r\nDesde la poda hasta la vendimia, todo el trabajo se hace a mano, y todos los vinos de la finca se elaboran únicamente con las uvas de su propia producción."
    ],
    "nl": [
      "Familiedomein van 9ha gelegen in Malleval, een middeleeuws dorp in het hart van het Pilat-massief.\r\nVan snoeien tot oogsten wordt al het werk met de hand gedaan, en alle wijnen van het domein worden uitsluitend gemaakt met de druiven van eigen productie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wine estate Farjon"
    ],
    "fr": [
      "Domaine Farjon"
    ]
  },
