  "rdfs:comment": {
    "de": [
      "Das Hotel befindet sich im oberen Teil des Skiortes Les Saisies, am Fuße der Pisten und Promenaden, 300 m vom Nordischen Stadion und 100 m vom Kindergarten entfernt."
    ],
    "en": [
      "Quiet, close to the runs and to the center. Family atmosphere, attentive service, restaurant of quality, relaxation space."
    ],
    "it": [
      "Tranquillo, in cima alla stazione (sci ai piedi l'inverno). Ambiente familiare e sportivo, servizio attento, ristorante di qualità, zona relax."
    ],
    "fr": [
      "L’hôtel se trouve en haut de la  station des Saisies, au pied des pistes, des  promenades,  à 300 mètres du Stade nordique et à 100 m du jardin d’enfants."
    ],
    "nl": [
      "Rustig, op de top van het resort (ski in ski out in de winter). Familiale en sportieve sfeer, attente bediening, kwaliteitsrestaurant, ontspanningsruimte."
    ],
    "es": [
      "El hotel está situado en la cima de la estación de Les Saisies, a pie de las pistas, los paseos, a 300 metros del Estadio Nórdico y a 100 metros de la guardería."
    ]
  },
