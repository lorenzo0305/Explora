  "rdfs:comment": {
    "de": [
      "La Table du Golf Hotel**** vereinigt Finesse und Genuss mit subtilen savoyischen Aromen."
    ],
    "ru": [
      "Ресторан La Table 4-звездочного отеля Golf Hotel сочетает в себе утонченность, изысканность и савойские нотки."
    ],
    "en": [
      "\"La Table du Golf Hotel ****\"  offers you card and different menus, a cuisine that combines finesse, refinement and creativity."
    ],
    "it": [
      "La Table du Golf propone una cucina bistronomica, mondiale, vegetariana e savoiarda da condividere\r\nProdotti freschi e regionali, con un'attenzione particolare ai rinomati canali di distribuzione brevi."
    ],
    "fr": [
      "La Table du Golf vous propose une cuisine Bistronomique, du Monde, Végétarienne et Savoyarde à partager\r\nProduis frais et régionaux, en privilégiant les circuits courts de renommée."
    ],
    "es": [
      "La Table du Golf ofrece cocina bistronómica, del mundo, vegetariana y saboyana para compartir\r\nProductos frescos y regionales, con especial atención a los circuitos cortos de distribución de renombre."
    ],
    "nl": [
      "La Table du Golf biedt een bistronomische, wereldse, vegetarische en Savoyaardse keuken om te delen\r\nVerse, regionale producten, met de nadruk op gerenommeerde korte distributiekanalen."
    ]
  },
