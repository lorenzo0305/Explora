  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant Beale Street, eine stimmungsvolle Restaurant-Bar.\r\nEine abwechslungsreiche Speisekarte, Tagesmenüs an Wochentagen mittags, eine große Auswahl an Getränken.\r\nVeranstaltungen an den Wochenenden!"
    ],
    "en": [
      "Come and discover our Beale Street restaurant and bar.\r\nA varied menu, daily lunch menus and a wide choice of drinks.\r\nWeekend events!"
    ],
    "it": [
      "Venite a scoprire il nostro ristorante e bar di Beale Street.\r\nUn menù vario, menù giornalieri per il pranzo durante la settimana e un'ampia scelta di bevande.\r\nEventi nel fine settimana!"
    ],
    "fr": [
      "Venez découvrir notre restaurant le Beale Street, Restaurant-Bar à ambiance.\r\nUne carte variée, des menus du jour les midi en semaine, un large choix de boissons.\r\nÉvénements les weekends !"
    ],
    "es": [
      "Venga a descubrir nuestro restaurante y bar de Beale Street.\r\nUna carta variada, menús diarios durante la semana y una amplia selección de bebidas.\r\n¡Eventos los fines de semana!"
    ],
    "nl": [
      "Kom en ontdek ons Beale Street restaurant en bar.\r\nEen gevarieerd menu, dagelijkse lunchmenu's tijdens de week en een ruime keuze aan drankjes.\r\nEvenementen in het weekend!"
    ]
  },
  "rdfs:label": {
