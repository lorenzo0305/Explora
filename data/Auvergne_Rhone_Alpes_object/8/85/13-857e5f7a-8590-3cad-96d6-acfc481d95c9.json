  "rdfs:comment": {
    "de": [
      "Steigen Sie von der Ebene von Bégude-de-Mazenc aus auf und folgen Sie dem GR de Pays de Dieulefit, um den Kamm der Plaine du Loup zu erreichen."
    ],
    "en": [
      "From the Bégude-de-Mazenc plain, follow the GR de Pays de Dieulefit up to the Crête de la Plaine du Loup."
    ],
    "it": [
      "Dalla piana di Bégude-de-Mazenc, seguire il GR de Pays de Dieulefit fino alla Crête de la Plaine du Loup."
    ],
    "fr": [
      "Au départ de la plaine de la Bégude-de-Mazenc, montez en suivant le GR de Pays de Dieulefit pour atteindre la Crête de la Plaine du Loup."
    ],
    "nl": [
      "Volg vanaf de vlakte van Bégude-de-Mazenc de GR de Pays de Dieulefit tot aan de Crête de la Plaine du Loup."
    ],
    "es": [
      "Desde la llanura de Bégude-de-Mazenc, siga el GR de Pays de Dieulefit hasta la Crête de la Plaine du Loup."
    ]
  },
  "rdfs:label": {
