  "rdfs:comment": {
    "de": [
      "Am Fuße der Kathedrale Notre-Dame bietet die Boutique Show'Colat Vasseur regionale Spezialitäten wie Macarons d'Amiens, Tuiles Picardes und handgefertigte Schokolade an."
    ],
    "en": [
      "At the foot of Notre-Dame Cathedral, the Show'Colat Vasseur shop offers regional specialities such as Amiens macaroons, Picardy tiles and handmade chocolates."
    ],
    "it": [
      "Ai piedi della Cattedrale di Notre-Dame, il negozio Show'Colat Vasseur offre specialità regionali come amaretti di Amiens, tuiles della Piccardia e cioccolatini artigianali."
    ],
    "fr": [
      "Au pied de la Cathédrale Notre-Dame, la boutique Show'Colat Vasseur propose des spécialités régionales telles que les macarons d'Amiens, les tuiles picardes et des chocolats artisanaux."
    ],
    "es": [
      "Al pie de la catedral de Notre-Dame, la tienda Show'Colat Vasseur ofrece especialidades regionales como macarrones de Amiens, tuiles de Picardía y chocolates artesanales."
    ],
    "nl": [
      "Aan de voet van de kathedraal Notre-Dame biedt de winkel Show'Colat Vasseur regionale specialiteiten zoals bitterkoekjes uit Amiens, Picardische tuiles en ambachtelijke bonbons."
    ]
  },
