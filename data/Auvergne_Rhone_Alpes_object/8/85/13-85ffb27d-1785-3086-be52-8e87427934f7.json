  "rdfs:comment": {
    "de": [
      "Vom linken Ufer der Sioule gelangen Sie über die hübsche Brücke von Ebreuil an ihr rechtes Ufer."
    ],
    "en": [
      "From the left bank of the Sioule, you can reach the right bank via the pretty Ebreuil bridge."
    ],
