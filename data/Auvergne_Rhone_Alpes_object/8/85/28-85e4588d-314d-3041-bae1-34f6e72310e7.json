  "rdfs:comment": {
    "de": [
      "Über Papilles & Camomille biete ich Ihnen Kräutertees, Aromaten, essbare Blüten und Kräutersalze für Ihr Wohlbefinden und Ihren Genuss an. Ich baue diese Pflanzen von Hand an und pflücke sie mit Rücksicht auf die Umwelt und die biologische Vielfalt in geschützten Umgebungen."
    ],
    "en": [
      "Through Papilles & Camomille, I offer herbal teas, aromatics, edible flowers and herbal salts, for your well-being and pleasure. I grow and harvest these plants by hand, respecting the environment and biodiversity, in preserved environments."
    ],
    "it": [
      "Attraverso Papilles & Camomille, offro tisane, aromi, fiori commestibili e sali alle erbe, per il vostro benessere e piacere. Coltivo e raccolgo queste piante a mano, nel rispetto dell'ambiente e della biodiversità, in ambienti preservati."
    ],
    "fr": [
      "À travers Papilles & Camomille, je vous propose des tisanes, aromates, fleurs comestibles et sels aux herbes, pour votre bien-être et votre plaisir. Je cultive et cueille ces plantes à la main, dans le respect de l'environnement et de la biodiversité, dans des environnements préservés."
    ],
    "nl": [
      "Via Papilles & Camomille bied ik kruidenthee, aromatische planten, eetbare bloemen en kruidenzouten aan, voor jouw welzijn en plezier. Ik kweek en pluk deze planten met de hand, met respect voor het milieu en de biodiversiteit, in een beschermde omgeving."
    ],
    "es": [
      "A través de Papilles & Camomille, ofrezco tisanas, plantas aromáticas, flores comestibles y sales de hierbas, para su bienestar y placer. Cultivo y recolecto estas plantas a mano, respetando el medio ambiente y la biodiversidad, en entornos preservados."
    ]
  },
