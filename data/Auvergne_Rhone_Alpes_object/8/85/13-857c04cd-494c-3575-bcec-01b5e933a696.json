  "rdfs:comment": {
    "de": [
      "Annecy aus der Vogelperspektive!\r\nVom Col de la Forclaz aus entdecken Sie beim Paragliding ein einzigartiges Panorama über den See von Annecy.\r\nWillkommen in Annecy, einem Juwel in den französischen Alpen, wo das Tandem-Paragliding ein einzigartiges Erlebnis für alle bietet, die den Nervenkitzel lieben."
    ],
    "en": [
      "Annecy from the sky!\r\nFrom the Col de la Forclaz, discover a unique panorama of Lake Annecy thanks to paragliding.\r\nWelcome to Annecy, a jewel in the French Alps, where tandem paragliding offers a unique experience for thrill-seekers."
    ],
    "it": [
      "Annecy dal cielo!\r\nIl parapendio dal Col de la Forclaz offre una vista panoramica unica sul lago di Annecy.\r\nBenvenuti ad Annecy, un gioiello delle Alpi francesi, dove il parapendio in tandem offre un'esperienza unica agli amanti del brivido."
    ],
    "fr": [
      "Annecy vue du ciel !\r\nDepuis le Col de la Forclaz découvrez un panorama unique sur le lac d’Annecy grâce au parapente.\r\nBienvenue à Annecy, un joyau des Alpes françaises, où le parapente biplace offre une expérience unique pour les amateurs de sensations."
    ],
    "nl": [
      "Annecy vanuit de lucht!\r\nParagliding vanaf de Col de la Forclaz biedt een uniek panoramisch uitzicht op het meer van Annecy.\r\nWelkom in Annecy, een juweeltje in de Franse Alpen, waar tandemparagliding een unieke ervaring biedt voor sensatiezoekers."
    ],
    "es": [
      "Annecy desde el cielo\r\nEl parapente desde el Col de la Forclaz ofrece una vista panorámica única del lago de Annecy.\r\nBienvenido a Annecy, una joya de los Alpes franceses, donde el parapente biplaza ofrece una experiencia única para los amantes de las emociones fuertes."
    ]
  },
