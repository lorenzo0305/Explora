  "rdfs:comment": {
    "de": [
      "RockandWalk ist ein Anbieter von Aktivitäten in der Natur mit Sitz in Saint-Jeoire, der betreute Ausflüge anbietet, die Wanderungen und die Entdeckung der natürlichen Umgebung miteinander verbinden."
    ],
    "en": [
      "RockandWalk is an outdoor activity provider based in Saint-Jeoire, offering guided excursions combining hiking and exploration of the natural environment."
    ],
    "it": [
      "RockandWalk è un fornitore di attività all'aria aperta con sede a Saint-Jeoire, che offre uscite supervisionate che combinano escursioni e scoperta dell'ambiente naturale."
    ],
    "fr": [
      "RockandWalk est un prestataire d’activités de pleine nature basé à Saint-Jeoire, proposant des sorties encadrées mêlant randonnée et découverte du milieu naturel."
    ],
    "nl": [
      "RockandWalk is een aanbieder van outdooractiviteiten gevestigd in Saint-Jeoire, die begeleide uitstapjes aanbiedt waarbij wandelen en het ontdekken van de natuurlijke omgeving gecombineerd worden."
    ],
    "es": [
      "RockandWalk es un proveedor de actividades al aire libre con sede en Saint-Jeoire, que ofrece salidas supervisadas que combinan el senderismo y el descubrimiento del entorno natural."
    ]
  },
