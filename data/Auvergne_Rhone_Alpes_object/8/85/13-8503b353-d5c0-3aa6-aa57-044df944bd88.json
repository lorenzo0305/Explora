  "rdfs:comment": {
    "de": [
      "Ein idealer Ort zum Entspannen am Ausgangspunkt mehrerer Wanderungen. Badeteich, Picknicktische, Kinderspielplatz, Tennisplatz und eingerichteter Biwakbereich."
    ],
    "en": [
      "An ideal place to relax, at the beginning of some hiking. Lake, picnic tables, kids games, tennis area and equipped bivouac space."
    ],
    "it": [
      "Un luogo ideale per rilassarsi all'inizio di diverse escursioni. Piscina, tavoli da picnic, area giochi per bambini, campo da tennis e area bivacco attrezzata."
    ],
    "fr": [
      "Un endroit idéal pour la détente au départ de plusieurs randonnées. Plan d'eau de baignade, tables de pique-nique, jeux pour enfants, court de tennis et zone de bivouac aménagée."
    ],
    "es": [
      "Un lugar ideal para relajarse al inicio de varias excursiones. Piscina, mesas de picnic, zona de juegos para niños, pista de tenis y zona de vivac equipada."
    ],
    "nl": [
      "Een ideale plek om te ontspannen aan het begin van verschillende wandeltochten. Zwembad, picknicktafels, speeltuin, tennisbaan en uitgeruste bivakzone."
    ]
