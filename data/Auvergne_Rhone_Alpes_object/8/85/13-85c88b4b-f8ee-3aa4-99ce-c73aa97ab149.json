  "rdfs:comment": {
    "de": [
      "Ein kultureller und sozialer Verein auf einem Bio-Kollektivhof! Sie haben Batotopie genannt! Kulturelle Aktivitäten, Workshops und Schulungen zur Entwicklung und Förderung von ökologischen Praktiken werden hier angeboten, also worauf wartest du noch? Los geht's!"
    ],
    "en": [
      "A cultural and social association on an organic collective farm! You named Batotopie! Cultural activities, workshops and training for the development and promotion of ecological practices are all on offer, so what are you waiting for? Get in on the action!"
    ],
    "it": [
      "Un'associazione culturale e sociale in una fattoria collettiva biologica! Avete nominato Batotopie! Attività culturali, laboratori e corsi di formazione per sviluppare e promuovere le pratiche ecologiche sono tutte offerte, quindi cosa state aspettando? Cosa state aspettando?"
    ],
    "fr": [
      "Une association culturelle et sociale dans une ferme collective bio! Vous avez nommé Batotopie! Activités culturelles, ateliers et formations pour le développement et la promotion de pratiques écologiques vous sont proposées, alors qu'attend-tu? Vas-y!"
    ],
    "es": [
      "¡Una asociación cultural y social en una granja colectiva ecológica! ¡Has llamado a Batotopie! Se ofrecen actividades culturales, talleres y cursos de formación para desarrollar y promover prácticas ecológicas, ¿a qué esperas? ¿A qué esperas?"
    ],
    "nl": [
      "Een culturele en sociale vereniging op een biologische collectieve boerderij! Je hebt Batotopie genoemd! Culturele activiteiten, workshops en trainingen om ecologische praktijken te ontwikkelen en te promoten worden allemaal aangeboden, dus waar wacht je nog op? Dus waar wacht je nog op?"
    ]
  },
