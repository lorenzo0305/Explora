  "rdfs:comment": {
    "de": [
      "Die Kirche von Le Bouchaud wurde Ende des 19. Jahrhunderts von dem Architekten Moreau vollständig umgebaut. Von der alten Kirche sind keine Überreste erhalten geblieben."
    ],
    "en": [
      "The church of Le Bouchaud was entirely rebuilt at the end of the 19th century by the architect Moreau. There are no remains of the old church."
    ],
    "it": [
      "La chiesa di Le Bouchaud fu completamente ricostruita alla fine del XIX secolo dall'architetto Moreau. Non ci sono resti dell'antica chiesa."
    ],
    "fr": [
      "L'Eglise de Le Bouchaud fut entièrement reconstruite à la fin du XIXe par l'architecte Moreau. Il ne subsiste aucun vestige de l'ancienne église."
    ],
    "es": [
      "La iglesia de Le Bouchaud fue completamente reconstruida a finales del siglo XIX por el arquitecto Moreau. No hay restos de la antigua iglesia."
    ],
    "nl": [
      "De kerk van Le Bouchaud werd aan het eind van de 19e eeuw volledig herbouwd door de architect Moreau. Er zijn geen overblijfselen van de oude kerk."
    ]
  },
