  "rdfs:comment": {
    "de": [
      "Ausleihe von Büchern, Romanen, Comics, Bergzeitschriften und anderen Büchern. Lesen auf spielerische Weise, wobei an die Freude des Lesers appelliert und diese geteilt wird.\r\nAnmeldebedingungen: Deklaratives Anmeldeformular zum Ausfüllen."
    ],
    "en": [
      "Loan of books, novels, comics, mountain magazines and more. Reading in a fun mode, appealing to the reader's pleasure and sharing. Conditions of registration: declarative registration form to be completed."
    ],
    "it": [
      "Prestito di libri, romanzi, fumetti, riviste di montagna e altro. Leggere in modo divertente, facendo appello al piacere e alla condivisione del lettore. Condizioni di iscrizione: modulo di iscrizione dichiarativo da compilare."
    ],
    "fr": [
      "Prêt de livres, romans, BD, revues de montagne et autres. La lecture sur un mode ludique, en faisant appel au plaisir du lecteur et à son partage.\r\nConditions d'inscription : fiche d'inscription déclarative à remplir."
    ],
    "nl": [
      "Uitleen van boeken, romans, strips, bergtijdschriften en meer. Lezen op een leuke manier, aantrekkelijk voor het plezier van de lezer en delen. Inschrijvingsvoorwaarden: declaratief inschrijfformulier in te vullen."
    ],
    "es": [
      "Préstamo de libros, novelas, cómics, revistas de montaña y otros. Leer de forma lúdica, apelando al placer del lector y a compartir.\r\nCondiciones de inscripción: rellenar el formulario de inscripción."
    ]
  },
