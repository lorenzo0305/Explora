  "rdfs:comment": {
    "de": [
      "Die gemütliche Bar/Pub La Casa de L'Ours ist die erste Adresse in Plagne Villages!\r\nGemütlicher und warmer Rahmen, Non-Stop-Service 7/7, geöffnet ab 8.30 Uhr bis 23.00 Uhr..."
    ],
    "en": [
      "La Casa de L’Ours, an establishment you mustn't miss at the bottom of the slopes in Plagne Villages! Restaurant/Pizzeria, Lounge Bar/Pub, sunny terrace, warm, cosy atmosphere, service non-stop 7/7, bar/pub open 8.30am to midnight…."
    ],
    "it": [
      "Accogliente bar/pub La Casa de L'Ours, il posto giusto a Plagne Villages!\r\nAmbiente accogliente e caldo, servizio non-stop 7 giorni su 7, aperto dalle 8.30 alle 23.00?"
    ],
    "fr": [
      "Bar/Pub cosy La Casa de L’Ours, adresse incontournable de Plagne Villages !\r\nCadre cosy et chaleureux, service non-stop 7/7, ouvert dès 8h30 jusqu’à 23h00…"
    ],
    "nl": [
      "Casa de L'Ours, een must op het sneeuwfront van Plagne Villages! Restaurant / pizzeria, bar/pub lounge, terras op het zuiden, gezellige en warme sfeer, non-stop service 7/7, Bar/Pub openvan 8u30 uur tot middernacht ..."
    ],
    "es": [
      "Acogedor bar/pub La Casa de L'Ours, ¡el lugar de moda en Plagne Villages!\r\nEntorno acogedor y cálido, servicio ininterrumpido los 7 días de la semana, abierto desde las 8.30 hasta las 23.00 horas.."
    ]
  },
