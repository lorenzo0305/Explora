  "rdfs:comment": {
    "de": [
      "Rasen, Sand und ausgestattete Stege erwarten Sie am Strand Albert Griot am Nordufer in der fabelhaften natürlichen Umgebung des Sees von Nantua.\r\nSand und Picknicktische finden Sie am Strand La Colonne am Südufer.\r\nBeaufsichtigtes Baden ist im Juli und August kostenlos."
    ],
    "en": [
      "You would rather get a tan than set diving records? Landscaped lawn and pontoons await you for swimming in a fabulous natural setting! Snack bar an refreshments on site."
    ],
    "it": [
      "Prati, sabbia e pontili vi aspettano a Plage Albert Griot, sulla riva nord, nella favolosa cornice naturale del Lac de Nantua.\r\nSabbia e tavoli da picnic si trovano a Plage de la Colonne, sulla riva sud.\r\nNuoto libero e sorvegliato in luglio e agosto."
    ],
    "fr": [
      "Pelouse, sable et pontons aménagés vous attendent plage Albert Griot rive nord dans le cadre naturel fabuleux du lac de Nantua.\r\nRetrouvez sable et tables de pique-nique à la plage de la Colonne, rive sud. \r\nBaignade surveillée gratuite en juillet et août."
    ],
    "nl": [
      "Gazons, zand en pontons wachten op je bij Plage Albert Griot op de noordoever, in de prachtige natuurlijke omgeving van Lac de Nantua.\r\nZand en picknicktafels vind je bij Plage de la Colonne op de zuidoever.\r\nGratis zwemmen onder toezicht in juli en augustus."
    ],
    "es": [
      "Césped, arena y pontones le esperan en Plage Albert Griot, en la orilla norte, en el fabuloso marco natural del Lac de Nantua.\r\nArena y mesas de picnic en la playa de la Colonne, en la orilla sur.\r\nBaño vigilado gratuito en julio y agosto."
    ]
  },
  "rdfs:label": {
    "de": [
      "Baden am See von Nantua"
    ],
    "en": [
      "swimming at Nantua lake"
    ],
    "fr": [
      "Baignade au lac de Nantua"
    ]
  },
