  "rdfs:comment": {
    "de": [
      "Das Restaurant im Stil eines Korkens befindet sich in der Unterstadt und besticht durch einfache, traditionelle Gerichte, die aus frischen Produkten der Region zubereitet werden."
    ],
    "en": [
      "The bouchon-style restaurant is located in the lower town and attracts diners with its simple, traditional dishes made from fresh local produce."
    ],
    "it": [
      "Il ristorante in stile bouchon nella città bassa serve piatti semplici e tradizionali preparati con prodotti freschi locali."
    ],
    "fr": [
      "Le restaurant de type bouchon se trouve dans la basse ville et séduit par des plats simples et traditionnels faits à partir des produits frais du terroir."
    ],
    "nl": [
      "Het restaurant in bouchonstijl in de benedenstad serveert eenvoudige, traditionele gerechten met verse lokale producten."
    ],
    "es": [
      "El restaurante de estilo bouchon de la parte baja de la ciudad sirve platos sencillos y tradicionales elaborados con productos frescos de la zona."
    ]
  },
