  "rdfs:comment": {
    "de": [
      "Die Mediathek Saint Exupéry steht den Einwohnern der Gemeinde und den Bewohnern anderer Gemeinden offen. Die Mediathek verfügt über einen angenehmen Entspannungsbereich, einen Arbeitsraum und eine Computerstation, an der Sie die Recherchen Ihrer Autoren einsehen können."
    ],
    "en": [
      "The Saint Exupéry multimedia library is open to residents of the commune and to residents of other communes. The library has a pleasant relaxation area, a workroom and a computer workstation for consulting your authors' research."
    ],
    "it": [
      "La biblioteca multimediale Saint Exupéry è aperta ai residenti del comune e a quelli di altri comuni. La biblioteca dispone di una piacevole area relax, di una sala studio e di una postazione informatica per la consultazione delle proprie ricerche d'autore."
    ],
    "fr": [
      "La médiathèque Saint Exupéry est ouverte aux résidents de la communes et pour les habitants des autres communes. Ce lieu bénéficie d'un espace de détente agréable, d'une salle de travail, d'un poste informatique pour consulter la recherche de vos auteurs."
    ],
    "es": [
      "La biblioteca multimedia Saint Exupéry está abierta a los habitantes del municipio y a los de otros municipios. La biblioteca dispone de una agradable zona de descanso, una sala de estudio y un puesto informático para consultar sus investigaciones de autor."
    ],
    "nl": [
      "De mediatheek van Saint Exupéry is toegankelijk voor inwoners van de gemeente en inwoners van andere gemeenten. De bibliotheek beschikt over een aangename ontspanningsruimte, een studieruimte en een computerwerkstation voor het raadplegen van uw auteursonderzoek."
    ]
  },
  "rdfs:label": {
