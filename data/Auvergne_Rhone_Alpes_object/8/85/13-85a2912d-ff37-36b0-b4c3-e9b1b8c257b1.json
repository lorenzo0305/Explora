  "rdfs:comment": {
    "de": [
      "Sehen Sie dieses schöne Gebäude, das in einem Park in der Nähe von Chamboeuf liegt, einem Dorf, das gerade erst mit dem Fleur d'Or-Label ausgezeichnet wurde?"
    ],
    "en": [
      "In the 1st garden village in the Loire, Chamboeuf, in the midst of the roses the \"La Rose des Délices\" restaurant offers refined, home-made cuisine using fresh, local produce."
    ],
    "it": [
      "Riuscite a vedere questo bellissimo edificio, immerso in un parco alle porte di Chamboeuf, un villaggio che ha appena ricevuto il marchio Fleur d'Or?"
    ],
    "fr": [
      "Vous voyez cette belle bâtisse, nichée dans un parc tout près de Chamboeuf, ce village tout juste auréolé du label Fleur d’Or ?"
    ],
    "es": [
      "¿Puede ver este hermoso edificio, enclavado en un parque a las afueras de Chamboeuf, un pueblo que acaba de recibir el sello de la Flor de Oro?"
    ],
    "nl": [
      "Zie je dit prachtige gebouw, genesteld in een park net buiten Chamboeuf, een dorp dat net het Fleur d'Or-label heeft gekregen?"
    ]
  },
