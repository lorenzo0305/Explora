  "rdfs:comment": {
    "de": [
      "Eine stille Plage, eine Spur der Vergangenheit...\r\nErleben Sie ein Abenteuer mit der Familie oder mit Freunden und teilen Sie einen spielerischen Moment, indem Sie das Geheimnis des trüben Wassers im Schloss lüften."
    ],
    "en": [
      "A silent plague, a trace of the past...\r\nJoin us for a fun-filled adventure with family and friends as we unravel the secret of the château's murky water."
    ],
    "it": [
      "Una piaga silenziosa, una traccia del passato...\r\nVenite a vivere un'avventura con la vostra famiglia o i vostri amici e divertitevi a svelare il segreto dell'acqua torbida del castello."
    ],
    "fr": [
      "Un fléau silencieux, une trace du passé...\r\nVenez vivre une aventure en famille ou entre amis et partager un moment ludique, en perçant le secret de l'eau trouble au château."
    ],
    "es": [
      "Una plaga silenciosa, una huella del pasado...\r\nVen a disfrutar de una aventura con tu familia o amigos, y diviértete mientras desentrañas el secreto del agua turbia del castillo."
    ],
    "nl": [
      "Een stille plaag, een spoor uit het verleden...\r\nKom en beleef een avontuur met je familie of vrienden en maak plezier terwijl je het geheim van het troebele water in het kasteel ontrafelt."
    ]
  },
  "rdfs:label": {
