  "rdfs:comment": {
    "de": [
      "Das Café des Lys liegt im Herzen des historischen Zentrums von Romans-sur-Isère und ist weit mehr als nur ein Restaurant. Es ist ein Ort, an dem das Kochen zu einer wahren Kunst wird, ein Erlebnis für die Sinne, das raffinierte Aromen und eine warme Atmosphäre miteinander verbindet."
    ],
    "en": [
      "Located in the heart of the historic center of Romans-sur-Isère, Café des Lys is much more than just a restaurant. It's a place where cuisine becomes a true art, a sensory experience combining refined flavors and a warm atmosphere."
    ],
    "it": [
      "Situato nel cuore del centro storico di Romans-sur-Isère, il Café des Lys è molto più di un semplice ristorante. È un luogo dove la cucina diventa una vera e propria arte, un'esperienza sensoriale che unisce sapori raffinati e un'atmosfera accogliente."
    ],
    "fr": [
      "Situé en plein cœur du centre historique de Romans-sur-Isère, le Café des Lys est bien plus qu'un simple restaurant. C’est un lieu où la cuisine devient un véritable art, une expérience sensorielle mêlant saveurs raffinées et ambiance chaleureuse."
    ],
    "es": [
      "Situado en pleno centro histórico de Romans-sur-Isère, el Café des Lys es mucho más que un restaurante. Es un lugar donde la cocina se convierte en un verdadero arte, una experiencia sensorial que combina sabores refinados y un ambiente cálido."
    ],
    "nl": [
      "Café des Lys ligt in het hart van het historische centrum van Romans-sur-Isère en is veel meer dan een restaurant. Het is een plek waar koken een ware kunst wordt, een zintuiglijke ervaring die verfijnde smaken combineert met een warme sfeer."
    ]
  },
