  "rdfs:comment": {
    "de": [
      "Monroe, die durch Prodiges 2024 bekannt wurde, bereitet eine Tournee 2026 zu den schönsten heiligen Stätten Frankreichs vor. Begleitet von den örtlichen Kinderchören verwandelt ihre seltene und überwältigende Stimme jedes Konzert in eine spirituelle und leuchtende Erfahrung."
    ],
    "en": [
      "Revealed by Prodiges 2024, Monroe is preparing a 2026 tour of France?s most beautiful sacred sites. Accompanied by local children?s choirs, her rare, moving voice transforms every recital into a luminous, spiritual experience."
    ],
    "it": [
      "Rivelata da Prodiges 2024, la Monroe sta preparando una tournée 2026 nei più bei luoghi sacri della Francia. Accompagnata da cori di bambini locali, la sua voce rara e commovente trasforma ogni recital in una luminosa esperienza spirituale."
    ],
    "fr": [
      "Révélée par Prodiges 2024, Monroe prépare une tournée 2026 dans les plus beaux lieux sacrés de France. Accompagnée par les maîtrises d’enfants locales, sa voix rare et bouleversante transforme chaque récital en expérience spirituelle et lumineuse."
    ],
    "es": [
      "Revelada por Prodiges 2024, Monroe prepara una gira en 2026 por los lugares sagrados más bellos de Francia. Acompañada por coros infantiles locales, su voz rara y conmovedora transforma cada recital en una luminosa experiencia espiritual."
    ],
    "nl": [
      "Onthuld door Prodiges 2024, bereidt Monroe een tournee voor in 2026 langs de mooiste heilige plaatsen in Frankrijk. Begeleid door lokale kinderkoren verandert haar zeldzame en ontroerende stem elk recital in een stralende spirituele ervaring."
    ]
  },
  "rdfs:label": {
    "fr": [
