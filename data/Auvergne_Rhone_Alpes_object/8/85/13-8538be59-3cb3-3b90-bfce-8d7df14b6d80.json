  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, die Kunst des alkoholfreien Cocktailmixens zu erlernen? Entdecken Sie das Know-how des Mixens und nutzen Sie die Gelegenheit, sich auszutauschen, zu probieren und an einem Imbiss teilzunehmen!\r\nEs gibt viele Preise zu gewinnen."
    ],
    "en": [
      "Would you like to learn the art of non-alcoholic cocktails? Come and discover the know-how behind the mixes, and take advantage of the opportunity to chat, taste and take part in the snack!\r\nPrizes to be won on site."
    ],
    "it": [
      "Volete cimentarvi nell'arte dei cocktail analcolici? Venite a scoprire il know-how che si cela dietro le miscele e approfittate dell'occasione per chiacchierare, degustare e partecipare al tea party!\r\nPremi in palio sul posto."
    ],
    "fr": [
      "Envie de vous initier à l'art des cocktails sans alcool? Venez découvrir le savoir-faire des mélanges, et profitez-en pour échanger, déguster et prendre part au goûter! \r\nDes lots sont à gagner sur place."
    ],
    "es": [
      "¿Le gustaría probar el arte de los cócteles sin alcohol? Venga a descubrir el saber hacer de las mezclas y aproveche para charlar, degustar y participar en la fiesta del té\r\nPremios para ganar in situ."
    ],
    "nl": [
      "Wil je de kunst van alcoholvrije cocktails uitproberen? Kom de knowhow achter de mixen ontdekken en maak van de gelegenheid gebruik om te kletsen, te proeven en deel te nemen aan het theekransje!\r\nEr zijn ter plekke prijzen te winnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mocktails Challenge"
    ]
  },
