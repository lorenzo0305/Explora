  "rdfs:comment": {
    "de": [
      "Der Hangar du Saint Vincent bietet Ihnen Mountainbike-Vermietungen an, mit denen Sie die Region auf andere Weise entdecken können! Fahren Sie auf den kleinen, malerischen Straßen der Ardèche auf individuell angepassten, familienfreundlichen Strecken!"
    ],
    "en": [
      "Discover the region in a different way with The Hangar du Saint Vincent mountain bikes and its summer activities ! Ride along the picturesque little roads of the Ardèche on customised family routes, Smooth riding assured !"
    ],
    "it": [
      "Le Hangar du Saint Vincent offre il noleggio di mountain bike per farvi scoprire la regione in un modo completamente nuovo! Percorrete le pittoresche strade secondarie dell'Ardèche su percorsi personalizzati e dolci per tutta la famiglia!"
    ],
    "fr": [
      "Le Hangar du Saint Vincent vous propose des locations VTT qui vous feront découvrir la région autrement ! Partez sur les petites routes pittoresques de l'Ardèche sur des parcours familiaux personnalisés, en toute douceur !"
    ],
    "es": [
      "Le Hangar du Saint Vincent le ofrece el alquiler de bicicletas de montaña para que descubra la región de una forma totalmente nueva Recorra las pintorescas carreteras secundarias de Ardèche en rutas personalizadas y suaves para toda la familia"
    ],
    "nl": [
      "Bij Le Hangar du Saint Vincent kun je mountainbikes huren om de streek op een andere manier te ontdekken! Trek er op uit langs de schilderachtige wegen van de Ardèche op gepersonaliseerde, rustige familieroutes!"
    ]
  },
