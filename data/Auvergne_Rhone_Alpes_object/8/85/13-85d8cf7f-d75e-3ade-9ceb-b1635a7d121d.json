  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist auf regionale Küche spezialisiert : hechtklöße"
    ],
    "en": [
      "located on the shores of Nantua Lake Patio and verandas with panoramic view of the lake. Fully equipped meeting room for 60 people."
    ],
    "it": [
      "Struttura completamente rinnovata con terrazza e verande con vista panoramica sul lago di Nantua. Specialità culinarie: quenelle di luccio con salsa Nantua, frittura, rane, pesce persico."
    ],
    "fr": [
      "Etablissement entièrement rénové avec terrasse et vérandas avec vue panoramique sur le lac de Nantua. Spécialités culinaires: quenelle de brochet sauce Nantua, friture, grenouilles, perches."
    ],
    "nl": [
      "Volledig gerenoveerd etablissement met terras en veranda's met een panoramisch uitzicht op het meer van Nantua. Culinaire specialiteiten: quenelle van snoek met Nantua-saus, bakken, kikkers, baars."
    ],
    "es": [
      "Establecimiento completamente renovado con terraza y verandas con vista panorámica al lago de Nantua. Especialidades culinarias: quenelle de lucio con salsa Nantua, fritura, ranas, perca."
    ]
  },
