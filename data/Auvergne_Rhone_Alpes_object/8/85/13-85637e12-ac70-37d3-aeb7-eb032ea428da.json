  "rdfs:comment": {
    "de": [
      "Im Herzen des Henri-Vinay-Parks, nur wenige Schritte vom Crozatier-Museum entfernt, befindet sich die Buvette du jardin, ein erholsamer Ort, an dem man sich im Schatten der Platanen entspannen kann."
    ],
    "en": [
      "Located in the heart of the Parc Henri-Vinay, just a stone's throw from the Musée Crozatier, the garden refreshment area is a relaxing place to unwind in the shade of the plane trees."
    ],
    "it": [
      "Situato nel cuore del Parc Henri-Vinay, a pochi passi dal Musée Crozatier, l'area di ristoro in giardino è un luogo rilassante dove rilassarsi all'ombra dei platani."
    ],
    "fr": [
      "Située au cœur du parc Henri-Vinay à deux pas du musée Crozatier, la buvette du jardin est un lieu reposant, où l'on vient se détendre à l'ombre des platanes."
    ],
    "es": [
      "Situado en el corazón del Parque Henri-Vinay, a dos pasos del Museo Crozatier, el área de descanso del jardín es un lugar relajante para descansar a la sombra de los plátanos."
    ],
    "nl": [
      "Gelegen in het hart van het Parc Henri-Vinay, op een steenworp afstand van het Musée Crozatier, is de verfrissingstuin een ontspannende plek om tot rust te komen in de schaduw van de platanen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Buvette du Jardin Henri Vinay"
    ]
  },
