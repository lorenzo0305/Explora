  "rdfs:comment": {
    "de": [
      "Das einladende, selbstgebaute und umweltfreundliche Agroökologische Zentrum Amanins verkörpert einen praktischen, alltagstauglichen Ansatz für Ökologie mit dem Schwerpunkt auf Selbstversorgung mit Lebensmitteln und Energie. Ein gemeinschaftliches Projekt, das Verbundenheit fördert und Mensch und Natur in den Mittelpunkt stellt."
    ],
    "en": [
      "A welcoming, self-built, and eco-friendly space, the Amanins agroecological center embodies a practical, everyday approach to ecology, centered on food and energy self-sufficiency. A cooperative project, fostering connection, focused on people and nature.."
    ],
    "it": [
      "Il centro agroecologico di Amanins è un eco-centro conviviale, autocostruito, che incarna un'ecologia pratica e quotidiana basata sull'autosufficienza alimentare ed energetica. Un progetto cooperativo, favorevole all'incontro, incentrato su Umanità e Natura."
    ],
    "fr": [
      "Lieu convivial auto et éco-construit, le centre agroécologique des Amanins incarne une écologie pratique et quotidienne, autour de l’autonomie alimentaire et énergétique. Un projet coopératif, favorable à la rencontre, centré sur l’Humain et la Nature."
    ],
    "nl": [
      "Het Amanins agro-ecologisch centrum is een gastvrije, zelfgebouwde en milieuvriendelijke ruimte die een praktische, alledaagse benadering van ecologie belichaamt, gericht op voedsel- en energiezelfredzaamheid. Een coöperatief project dat verbinding bevordert en zich richt op mens en natuur."
    ],
    "es": [
      "El centro agroecológico Amanins es un centro ecológico de convivencia, autoconstruido, que encarna una ecología práctica y cotidiana basada en la autosuficiencia alimentaria y energética. Un proyecto cooperativo, propicio al encuentro, centrado en la Humanidad y la Naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Amanins, centre agro écologique"
    ]
  },
