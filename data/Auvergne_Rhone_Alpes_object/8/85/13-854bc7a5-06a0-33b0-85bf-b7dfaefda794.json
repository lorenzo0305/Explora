  "rdfs:comment": {
    "de": [
      "Familienbetrieb, der Rot-, Weiß- und Roséweine in den AOP Vinsobres, Côtes du Rhône Villages, Côtes du Rhône und IGP Méditerranée produziert. Zertifiziert nach AB und HVE Niveau 3. Produzent von Olivenöl, Tapenaden und Speiseoliven mit g.U. Nyons."
    ],
    "en": [
      "Family farm producing wines Cru Vinsobres PDO, Côtes du Rhône Villages red and white, Côtes du Rhône white and rosé. \r\nCertified High Environmental Value Level 3.\r\nProducer of olive oil, tapenade and olives of Nyons PDO."
    ],
    "it": [
      "Azienda a conduzione familiare che produce vini rossi, bianchi e rosati AOP Vinsobres, Côtes du Rhône Villages, Côtes du Rhône e IGP Méditerranée. Certificato AB e HVE Livello 3. Produttore di olio d'oliva DOP Nyons, tapenades e olive."
    ],
    "fr": [
      "Exploitation familiale produisant des vins rouges, blancs et rosé en AOP Vinsobres, Côtes du Rhône Villages, Côtes du Rhône et IGP Méditerranée. Certifiée AB et HVE Niveau 3. Producteur d'huile d'olive, tapenades et olives de bouche AOP Nyons."
    ],
    "es": [
      "Empresa familiar que produce vinos tintos, blancos y rosados AOP Vinsobres, Côtes du Rhône Villages, Côtes du Rhône e IGP Méditerranée. Certificado AB y HVE nivel 3. Productor de aceite de oliva DOP Nyons, tapenades y aceitunas."
    ],
    "nl": [
      "Agrarisch familiebedrijf, wijnproducent van CDR  rood, wit en rosé en CRU Vinsobres. Producent van olijfolie en tapenade."
    ]
  },
