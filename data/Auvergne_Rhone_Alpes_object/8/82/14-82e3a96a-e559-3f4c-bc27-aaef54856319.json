  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/09ab226a-7449-3b27-82d4-23dc584e30b7",
      "dc:description": {
        "de": [
          "In den Osterferien sind die Kleinen zu einer Mini-Eierjagd eingeladen. Ein Moment, den Sie mit der Familie teilen können.\nPreis: 2 ?\nWorkshop für Babys von 18 Monaten - 3 Jahren / Mit Reservierung"
        ],
        "en": [
          "For the Easter vacations, little ones are invited to a mini egg hunt. A moment to share with the whole family.\nPrice: 2?\nWorkshop for babies aged 18 months - 3 years / On reservation"
        ],
        "it": [
          "Per le vacanze di Pasqua, i più piccoli sono invitati a una mini caccia alle uova. Un'esperienza divertente per tutta la famiglia.\nPrezzo: 2 euro\nLaboratorio per bambini da 18 mesi a 3 anni / Solo su prenotazione"
        ],
        "fr": [
          "Pour les vacances de Pâques, les petits sont invités à une mini chasse aux œufs. Un moment à partager en famille.\nTarif : 2 € \nAtelier pour les bébés de 18 mois - 3 ans / Sur réservation"
        ],
        "nl": [
          "Voor de paasvakantie worden de kleintjes uitgenodigd voor een mini-eierenjacht. Het is een leuke gezinservaring.\nPrijs: €2\nWorkshop voor baby's van 18 maanden - 3 jaar / Alleen op reservering"
        ],
        "es": [
          "Para las vacaciones de Pascua, los más pequeños están invitados a una mini búsqueda del huevo. Es una divertida experiencia familiar.\nPrecio: 2\nTaller para bebés de 18 meses a 3 años / Sólo con reserva previa"
        ]
      },
      "@type": [
        "Description"
      ],
