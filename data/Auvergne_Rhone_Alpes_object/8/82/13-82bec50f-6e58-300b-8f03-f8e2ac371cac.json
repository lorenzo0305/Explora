  "rdfs:comment": {
    "de": [
      "Traditionelle Küche. Frische Frösche auf Bestellung. Gerichte zum Mitnehmen. Cateringservice auf Kostenvoranschlag. Pizza zum Mitnehmen von Montag bis Samstag nur abends, Einheitspreis 10€ pro Pizza"
    ],
    "en": [
      "Traditional cuisine. French speciality: fresh frogs on order. Takeaway. Catering on request."
    ],
    "it": [
      "Cucina tradizionale. Rane fresche su ordinazione. Pasti da asporto. Servizio di catering su richiesta. Pizza da asporto da lunedì a sabato solo la sera, prezzo unico 10? per pizza"
    ],
    "fr": [
      "Cuisine traditionnelle. Grenouilles fraîches sur commande. Plats à emporter. Service traiteur sur devis. Pizza à emporter du lundi au samedi seulement le soir, prix unique 10€ la pizza"
    ],
    "nl": [
      "Traditionele keuken. Verse kikkers op bestelling. Afhaalmaaltijden. Catering service op aanvraag. Pizza om mee te nemen van maandag tot en met zaterdag alleen 's avonds, stukprijs 10€ per pizza"
    ],
    "es": [
      "Cocina tradicional. Ranas frescas por encargo. Comidas para llevar. Servicio de catering a petición. Pizza para llevar de lunes a sábado sólo por la noche, precio único 10€ por pizza"
    ]
  },
