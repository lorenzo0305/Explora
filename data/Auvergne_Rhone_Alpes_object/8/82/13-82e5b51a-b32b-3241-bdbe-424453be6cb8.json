  "rdfs:comment": {
    "de": [
      "Das Hotel Clos Syrah bietet Ihnen die Möglichkeit, die Ruhe und den Komfort seiner Zimmer zu genießen. Genießen Sie dank des Parks und des Swimmingpools entspannende Momente mit den Füßen im Wasser."
    ],
    "en": [
      "The Clos Syrah hotel invites you to enjoy the calm and comfort of its rooms. Relax by the pool or in the park."
    ],
    "it": [
      "L'hotel-ristorante-spa Clos Syrah**** invita a godere della pace e del comfort delle sue camere. Rilassatevi in piscina o nel parco."
    ],
    "fr": [
      "L'hôtel-restaurant-spa Clos Syrah**** vous propose de bénéficier du calme et du confort de ses chambres. Profitez de moments de détente les pieds dans l'eau grâce au parc et à la piscine."
    ],
    "nl": [
      "Het hotel Clos Syrah biedt je de rust en het comfort van zijn kamers. Ontspan bij het zwembad of in het park."
    ],
    "es": [
      "El hotel-restaurante-spa Clos Syrah**** le invita a disfrutar de la tranquilidad y el confort de sus habitaciones. Relájese junto a la piscina o en el parque."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant Best Western Plus Clos Syrah"
    ]
  },
