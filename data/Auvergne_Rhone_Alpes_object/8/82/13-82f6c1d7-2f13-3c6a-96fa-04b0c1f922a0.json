  "rdfs:comment": {
    "de": [
      "Avialpes bietet Überflüge des Sees von Annecy und des Mont Blanc-Massivs an. Machen Sie es sich in einem unserer Flugzeuge mit Panoramafenster bequem und betrachten Sie die Alpen aus der Vogelperspektive. Überfliegen Sie atemberaubende Landschaften!"
    ],
    "en": [
      "Avialpes provides flights over Annecy Lake and the Mont Blanc mountain range. See the Alps from the skies sitting comfortably on board one of our planes with panoramic glass. Glide over breathtaking scenery!"
    ],
    "it": [
      "Avialpes propone voli sul Lago di Annecy e sul Monte Bianco. Scoprite le Alpi viste dal cielo, comodamente, a bordo di uno dei nostri aerei con vetrata panoramica. Sorvolerete paesaggi mozzafiato!"
    ],
    "fr": [
      "Avialpes propose des survols du lac d'Annecy et du massif du Mont Blanc. Découvrez les Alpes vues du ciel, confortablement installés à bord de l'un de nos avions à verrière panoramique. Survolez des paysages à couper le souffle !"
    ],
    "es": [
      "Avialpes ofrece vuelos sobre el lago de Annecy y el macizo del Mont Blanc. Descubra los Alpes desde el cielo, cómodamente sentado a bordo de uno de nuestros aviones con techo de cristal panorámico. Sobrevuele paisajes impresionantes"
    ],
    "nl": [
      "Avialpes biedt vluchten over het meer van Annecy en over het massief van de Mont Blanc. Ontdek de Alpen vanuit de lucht, vanuit het comfort van een van onze vliegtuigen met panoramische ramen. Vlieg over adembenemende landschappen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Flugzeug Flug"
    ],
    "en": [
      "Airplane flight"
    ],
    "it": [
      "Volo in aereo"
    ],
    "fr": [
      "Survol en avion"
    ],
    "nl": [
      "vliegtuig vlucht"
    ]
  },
