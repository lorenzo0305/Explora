  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Orientierungslauf VERT in Chanoux Vallier: 4?km und 150?m Höhenunterschied, um die Natur und das lokale Erbe zu erkunden. Diese Strecke ist ideal für alle Niveaus und verbindet Sport, Abenteuer und Entdeckung. Perfekt für eine Outdoor-Aktivität in der Haute-Loire!"
    ],
    "en": [
      "Discover the VERT orienteering course at Chanoux Vallier: 4?km and 150?m ascent to explore nature and local heritage. Ideal for all levels, this trail combines sport, adventure and discovery. Perfect for an outdoor activity in the Haute-Loire!"
    ],
    "it": [
      "Scoprite il percorso di orientamento VERT a Chanoux Vallier: 4 km e 150 m di dislivello per esplorare la natura e il patrimonio locale. Ideale per tutti i livelli, questo percorso unisce sport, avventura e scoperta. Perfetto per un'attività all'aria aperta nell'Alta Loira!"
    ],
    "fr": [
      "Découvrez le parcours d’orientation VERT à Chanoux Vallier : 4 km et 150 m de dénivelé pour explorer nature et patrimoine local. Idéal pour tous niveaux, ce circuit allie sport, aventure et découverte. Parfait pour une activité plein air en Haute-Loire !"
    ],
    "nl": [
      "Ontdek de VERT oriëntatieloop in Chanoux Vallier: 4 km en 150 m klimmen om de natuur en het plaatselijke erfgoed te ontdekken. Dit parcours is ideaal voor alle niveaus en combineert sport, avontuur en ontdekking. Perfect voor een buitenactiviteit in de Haute-Loire!"
    ],
    "es": [
      "Descubra el sendero de orientación VERT en Chanoux Vallier: 4 km y 150 m de desnivel para explorar la naturaleza y el patrimonio local. Ideal para todos los niveles, este sendero combina deporte, aventura y descubrimiento. Perfecto para una actividad al aire libre en el Alto Loira"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours vert d'orientation de Chanoux Vallier"
    ]
  },
