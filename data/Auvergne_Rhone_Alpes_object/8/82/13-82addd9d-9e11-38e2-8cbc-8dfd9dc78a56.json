  "rdfs:comment": {
    "de": [
      "Ideal gelegen im Herzen von Val d'Isère und nur wenige Schritte von den Skipisten entfernt.\r\nLa Savoyarde empfängt Sie seit über 60 Jahren in einer traditionellen und familiären Atmosphäre."
    ],
    "en": [
      "Ideally located in the heart of Val d'Isère and close to the ski slopes, the hotel La Savoyarde has been welcoming you in a traditional and family atmosphere for more than 60 years."
    ],
    "it": [
      "Situato in posizione ideale nel cuore della Val d'Isère e a due passi dalle piste da sci. La Savoyarde vi accoglie in un'atmosfera tradizionale e familiare da oltre 60 anni."
    ],
    "fr": [
      "Idéalement situé au cœur de Val d’Isère et à deux pas des pistes de ski.\r\nLa Savoyarde vous accueille dans une ambiance traditionnelle et familiale depuis plus de 60 ans."
    ],
    "es": [
      "Idealmente situado en el corazón de Val d'Isère y a dos pasos de las pistas de esquí.\r\nLa Savoyarde lleva más de 60 años acogiendo a sus huéspedes en un ambiente tradicional y familiar."
    ],
    "nl": [
      "Ideaal gelegen in het hart van Val d'Isère en op een steenworp afstand van de skipistes.\r\nLa Savoyarde verwelkomt al meer dan 60 jaar gasten in een traditionele, familiaire sfeer."
    ]
  },
