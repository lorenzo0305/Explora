  "rdfs:comment": {
    "de": [
      "Das TRK OJEM empfängt seit 2012 Kinder im Alter von 2 bis 16 Jahren.\nGarantierte Atmosphäre, Spielpark, Sportanimation, Außenfahrten für Teenager, täglich Geschenke."
    ],
    "en": [
      "TRK OJEM has been welcoming children aged 2 to 16 since 2012.\nGuaranteed atmosphere, playground, sports activities, outdoor trips for teens, gifts every day."
    ],
    "it": [
      "TRK OJEM accoglie bambini dai 2 ai 16 anni dal 2012.\nAtmosfera garantita, parco giochi, attività sportive, gite all'aperto per ragazzi, regali ogni giorno."
    ],
    "fr": [
      "Le TRK OJEM accueille les enfants de 2 ans à 16 ans depuis 2012.\nAmbiance assurée, parc de jeux, animations sportives, déplacements extérieurs pour les ados, cadeaux tous les jours."
    ],
    "nl": [
      "TRK OJEM verwelkomt sinds 2012 kinderen van 2 tot 16 jaar.\nGegarandeerde sfeer, speeltuin, sportactiviteiten, uitstapjes voor tieners, elke dag cadeautjes."
    ],
    "es": [
      "TRK OJEM acoge a niños de 2 a 16 años desde 2012.\nAmbiente garantizado, parque infantil, actividades deportivas, excursiones al aire libre para adolescentes, regalos todos los días."
    ]
