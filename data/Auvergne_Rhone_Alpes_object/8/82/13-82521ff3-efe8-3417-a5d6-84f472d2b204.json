  "rdfs:comment": {
    "de": [
      "Lauffreunde, Naturliebhaber und Abenteurer, streichen Sie sich den Kalender an! Der mit Spannung erwartete Trail de Mirmande wird am Samstag, den 28. und Sonntag, den 29. März 2026 sein großes Comeback feiern. Bereiten Sie sich darauf vor, die Pfade der Drôme für eine unvergessliche Ausgabe zu betreten."
    ],
    "en": [
      "Runners, nature lovers and adventure enthusiasts, mark your calendars! The eagerly-awaited Trail de Mirmande will be back on Saturday March 28 and Sunday March 29, 2026. Get ready to hit the trails of the Drôme for a memorable edition."
    ],
    "it": [
      "Corridori, amanti della natura e dell'avventura, segnate il calendario! L'attesissimo Trail de Mirmande tornerà sabato 28 e domenica 29 marzo 2026. Preparatevi a percorrere i sentieri della Drôme per un'edizione memorabile."
    ],
    "fr": [
      "Amis coureurs, passionnés de nature et d'aventure, marquez vos calendriers ! Le très attendu Trail de Mirmande fera son grand retour les samedi 28 et dimanche 29 mars 2026. Préparez-vous à fouler les sentiers de la Drôme pour une édition mémorable."
    ],
    "nl": [
      "Hardlopers, natuurliefhebbers en avonturiers, markeer je agenda! De langverwachte Trail de Mirmande komt terug op zaterdag 28 en zondag 29 maart 2026. Bereid je voor op een onvergetelijke editie op de paden van de Drôme."
    ],
    "es": [
      "Corredores, amantes de la naturaleza y aficionados a la aventura, ¡marquen sus calendarios! El esperado Trail de Mirmande volverá el sábado 28 y el domingo 29 de marzo de 2026. Prepárese para recorrer los senderos de la Drôme en una edición memorable."
    ]
  },
