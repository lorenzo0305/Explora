  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadtmauern von Ruoms entdecken Sie die Atelier-Boutique von Véronique: Keramik, Töpferwaren made in Ardèche, Kerzen, Keramikkaffee..."
    ],
    "en": [
      "In the heart of the ramparts of Ruoms, come and discover Véronique's Atelier-Boutique: ceramics, pottery made in Ardèche, candles, ceramic café..."
    ],
    "it": [
      "Nel cuore dei bastioni di Ruoms, venite a scoprire l'Atelier-Boutique di Véronique: ceramiche, vasellame dell'Ardèche, candele, caffè in ceramica..."
    ],
    "fr": [
      "Au coeur des remparts de Ruoms, venez découvrir l'Atelier-Boutique de Véronique : céramique, poterie made in Ardèche, bougies, café céramique..."
    ],
    "nl": [
      "Kom in het hart van de stadswallen van Ruoms de Atelier-Boetiek van Véronique ontdekken: keramiek, aardewerk uit de Ardèche, kaarsen, keramisch café..."
    ],
    "es": [
      "En el corazón de las murallas de Ruoms, venga a descubrir el Atelier-Boutique de Véronique: cerámica, alfarería hecha en Ardèche, velas, café de cerámica..."
    ]
