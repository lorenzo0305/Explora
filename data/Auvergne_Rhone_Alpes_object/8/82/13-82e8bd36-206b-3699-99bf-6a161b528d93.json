  "rdfs:comment": {
    "de": [
      "Der Lesepunkt von Saint-Sulpice-des-Rivoires bietet Ihnen in den Räumlichkeiten des Rathauses Sprechstunden an. Vor Ort können Sie Ihre Bücher, CDs, DVDs, Videospiele ... zurückgeben oder abholen."
    ],
    "en": [
      "The Saint-Sulpice-des-Rivoires reading center is open all day, in the town hall. You can return or collect your books, CDs, DVDs, video games, etc. on site."
    ],
    "it": [
      "Il centro di lettura di Saint-Sulpice-des-Rivoires è aperto tutto il giorno presso il municipio. È possibile restituire o ritirare i libri, i CD, i DVD, i videogiochi, ecc. sul posto."
    ],
    "fr": [
      "Le point lecture de Saint-Sulpice-des-Rivoires vous propose des permanences, dans les locaux de la mairie. Sur place, vous pouvez  rendre ou retirer vos livres, CD, DVD, jeu vidéo .."
    ],
    "nl": [
      "Het leescentrum van Saint-Sulpice-des-Rivoires is de hele dag geopend in het gemeentehuis. Je kunt er je boeken, cd's, dvd's, videospelletjes enz. inleveren of ophalen."
    ],
    "es": [
      "El centro de lectura de Saint-Sulpice-des-Rivoires está abierto todo el día en el ayuntamiento. Allí podrá devolver o recoger sus libros, CD, DVD, videojuegos, etc."
    ]
  },
  "rdfs:label": {
