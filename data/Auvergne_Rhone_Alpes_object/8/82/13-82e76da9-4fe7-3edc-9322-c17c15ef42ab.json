  "rdfs:comment": {
    "de": [
      "Mille Traces ist ein Zusammenschluss von Naturforschern, Animateuren, Wissenschaftlern und einfachen Naturliebhabern, die sich für den Schutz, die Entdeckung, den Respekt und die Verbesserung der Umwelt einsetzen."
    ],
    "en": [
      "Bringing together naturalists, animators, scientists, or simple nature lovers, Mille Traces acts for the protection, discovery, respect and improvement of the environment."
    ],
    "it": [
      "Riunendo naturalisti, animatori, scienziati o semplici amanti della natura, Mille Tracce agisce per la protezione, la scoperta, il rispetto e il miglioramento dell'ambiente."
    ],
    "fr": [
      "Regroupant naturalistes, animateurs, scientifiques, ou simples amateurs de la nature, Mille Traces agit pour la protection, la découverte, le respect et l’amélioration de l’environnement."
    ],
    "es": [
      "Reuniendo a naturalistas, animadores, científicos o simples amantes de la naturaleza, Mille Traces actúa para la protección, el descubrimiento, el respeto y la mejora del medio ambiente."
    ],
    "nl": [
      "Mille Traces brengt natuurkenners, animatoren, wetenschappers en eenvoudige natuurliefhebbers samen en zet zich in voor de bescherming, de ontdekking, het respect en de verbetering van het milieu."
    ]
  },
