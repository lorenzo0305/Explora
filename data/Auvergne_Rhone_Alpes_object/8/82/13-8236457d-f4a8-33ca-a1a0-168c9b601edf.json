  "rdfs:comment": {
    "de": [
      "Im Herzen von Monestier-de-Clermont in der Region Trièves laden Frédérique und Willy Sie ein, eine inspirierende und leckere französische Küche in einer gemütlichen Umgebung zu genießen. Genießen Sie im Sommer die schattige Terrasse."
    ],
    "en": [
      "In the heart of Monestier-de-Clermont, Frédérique and Willy invite you to enjoy inspired, gourmet French cuisine in a warm and welcoming setting. Enjoy the shaded terrace in summer."
    ],
    "it": [
      "Nel cuore di Monestier-de-Clermont, nel Trièves, Frédérique e Willy vi invitano a gustare una cucina francese ispirata e gourmet in un ambiente caldo e accogliente. Godetevi la terrazza ombreggiata in estate."
    ],
    "fr": [
      "En plein cœur de Monestier-de-Clermont, dans le Trièves, Frédérique et Willy vous invitent à déguster une cuisine française inspirée et gourmande dans un cadre chaleureux. Profitez de la terrasse ombragée en été."
    ],
    "nl": [
      "In het hart van Monestier-de-Clermont, in de Trièves, nodigen Frédérique en Willy je uit om te genieten van een geïnspireerde, gastronomische Franse keuken in een warm en gastvrij kader. Geniet in de zomer van het schaduwrijke terras."
    ],
    "es": [
      "En el corazón de Monestier-de-Clermont, en Trièves, Frédérique y Willy le invitan a disfrutar de una cocina francesa inspirada y gastronómica en un ambiente cálido y acogedor. Disfrute de la terraza a la sombra en verano."
    ]
  },
