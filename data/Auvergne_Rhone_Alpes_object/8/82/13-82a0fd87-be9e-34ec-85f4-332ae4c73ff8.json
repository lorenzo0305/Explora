  "rdfs:comment": {
    "de": [
      "Von Avoriaz aus fahren Sie in Richtung Le Proclou, vorbei am Altiport, um dann zum Col de la Joux Verte aufzusteigen.\r\nAbfahrt vom Col de la Joux Verte, Haltestelle in der Nähe des Restaurants."
    ],
    "en": [
      "Starting from Avoriaz, head towards Proclou, walking past the heliportuntil you reach the Joux Verte pass. Start from the Joux Verte road, and park near the restaurant at the pass (“col”)."
    ],
    "it": [
      "Da Avoriaz, dirigersi verso Le Proclou, passare davanti all'altiport e salire al Col de la Joux Verte.\r\nPartite dal Col de la Joux Verte e parcheggiate vicino al ristorante."
    ],
    "fr": [
      "Depuis Avoriaz, prenez la direction du Proclou, passez près de l'altiport pour remonter jusqu'au col de la Joux Verte.\r\nDépart du Col de la Joux Verte, station-nez près du restaurant."
    ],
    "nl": [
      "Ga vanuit Avoriaz richting Le Proclou, passeer de altiport en klim omhoog naar de Col de la Joux Verte.\r\nVertrek vanaf de Col de la Joux Verte en parkeer in de buurt van het restaurant."
    ],
    "es": [
      "Desde Avoriaz, diríjase hacia Le Proclou, pase por el altiport y suba hasta el Col de la Joux Verte.\r\nSalir del Col de la Joux Verte y aparcar cerca del restaurante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Crêtes de Zore - piste de ski de fond"
    ]
  },
