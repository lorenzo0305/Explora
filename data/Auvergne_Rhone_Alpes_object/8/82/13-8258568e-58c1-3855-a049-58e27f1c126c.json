  "rdfs:comment": {
    "de": [
      "Kunsttischler / Kunstschmied, der Holz, Stahl und Altmaterialien miteinander verbindet, um eine Reihe von Produkten anzubieten, die sowohl für den Innen- als auch für den Außenbereich geeignet sind."
    ],
    "en": [
      "Custom-made furniture and decorative objects creation / design workshop combining wood, steel and recycled materials to offer a range of products suitable for both interior and exterior. Consulting service in space design (interior architecture) and objects (designer)"
    ],
    "it": [
      "Ebanista/ferraio che combina legno, acciaio e materiali riciclati per offrire una gamma di prodotti adatti sia agli interni che agli esterni."
    ],
    "fr": [
      "Ebéniste / Ferronnier d'Art  alliant le bois, l'acier et des matériaux de récupération afin de proposer une gamme de produits adaptés tant pour l'intérieur que pour l'extérieur."
    ],
    "nl": [
      "Meubelmaker / ijzerbewerker die hout, staal en gerecyclede materialen combineert om een reeks producten aan te bieden die geschikt zijn voor zowel interieurs als exterieurs."
    ],
    "es": [
      "Ebanista / Ferretero que combina madera, acero y materiales reciclados para ofrecer una gama de productos adecuados tanto para interiores como para exteriores."
    ]
  },
