  "rdfs:comment": {
    "de": [
      "Sérénité et Harmonie begleitet Sie mit Energiebehandlungen, Aromamassagen, Beratung zu ätherischen Ölen und der Methode Bye Bye Allergies auf dem Weg zu Ihrem Wohlbefinden. Dieser Ansatz berücksichtigt Ihren Körper, Ihren Geist und Ihre Emotionen."
    ],
    "en": [
      "Sérénité et Harmonie accompanies you on your path to well-being with energy treatments, aromatic massages, essential oil advice and the Bye Bye Allergies method. This approach takes into account your body, mind and emotions."
    ],
    "it": [
      "Sérénité et Harmonie vi guida verso il benessere con trattamenti energetici, massaggi aromatici, consigli sugli oli essenziali e il metodo Bye Bye Allergies. Questo approccio tiene conto del corpo, della mente e delle emozioni."
    ],
    "fr": [
      "Sérénité et Harmonie vous accompagne vers le bien-être grâce à des soins énergétiques, des massages aromatiques, des conseils en huiles essentielles et la méthode Bye Bye Allergies. Cette approche prend en compte votre corps, votre mental et vos émotions."
    ],
    "es": [
      "Sérénité et Harmonie le guía hacia el bienestar con tratamientos energéticos, masajes aromáticos, consejos sobre aceites esenciales y el método Bye Bye Alergias. Este enfoque tiene en cuenta su cuerpo, su mente y sus emociones."
    ],
    "nl": [
      "Sérénité et Harmonie begeleidt je naar welzijn met energiebehandelingen, aromatische massages, advies over essentiële oliën en de Bye Bye Allergies-methode. Deze aanpak houdt rekening met je lichaam, geest en emoties."
    ]
  },
  "rdfs:label": {
    "en": [
      "Serenité & harmonie: energy treatments and massages with essential oils"
    ],
    "fr": [
      "Sérénité et harmonie : soins énergétiques et massages aux huiles essentielles"
    ],
    "nl": [
      "Sérénité & harmonie: energiebehandelingen en massages met essentiële oliën"
    ]
  },
