  "rdfs:comment": {
    "de": [
      "Die Kirche von La Chapelle-sur-Coise ist ein historisches Gebäude im Herzen des Dorfes, das aufgrund seiner klassischen Architektur und seines Glockenturms, der das umliegende Tal überragt, bemerkenswert ist."
    ],
    "en": [
      "The church at La Chapelle-sur-Coise is a historic building in the heart of the village, remarkable for its classical architecture and bell tower overlooking the surrounding valley."
    ],
    "it": [
      "La chiesa di La Chapelle-sur-Coise è un edificio storico nel cuore del villaggio, notevole per la sua architettura classica e il suo campanile che domina la valle circostante."
    ],
    "fr": [
      "L’église de La Chapelle-sur-Coise est un édifice historique au cœur du village, remarquable pour son architecture classique et son clocher dominant la vallée environnante."
    ],
    "es": [
      "La iglesia de La Chapelle-sur-Coise es un edificio histórico en el corazón del pueblo, que destaca por su arquitectura clásica y su campanario con vistas al valle circundante."
    ],
    "nl": [
      "De kerk van La Chapelle-sur-Coise is een historisch gebouw in het hart van het dorp, opmerkelijk vanwege de klassieke architectuur en de klokkentoren die uitkijkt over de omliggende vallei."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Sainte-Étienne"
    ]
  },
