  "rdfs:comment": {
    "de": [
      "Farjon conciergerie ist von der bezaubernden Atmosphäre der Provence inspiriert und bietet Hausmeisterdienste, saisonale Vermietungen, Hausmeisterdienste und langfristige Mietverwaltung an."
    ],
    "en": [
      "Farjon conciergerie is inspired by the enchanting atmosphere of Provence, offering concierge services, seasonal rentals, housekeeping and long-term rental management."
    ],
    "it": [
      "La conciergerie Farjon si ispira all'atmosfera incantevole della Provenza e offre servizi di concierge, affitti stagionali, pulizia della casa e gestione degli affitti a lungo termine."
    ],
    "fr": [
      "Farjon conciergerie s'inspire de l'atmosphère enchanteresse de la Provence, offrant des services de conciergerie, de locations saisonnières, d'intendances et de gestion locative longue durée."
    ],
    "es": [
      "La conserjería Farjon se inspira en el encantador ambiente de la Provenza y ofrece servicios de conserjería, alquileres de temporada, limpieza y gestión de alquileres a largo plazo."
    ],
    "nl": [
      "Farjon conciergerie is geïnspireerd door de betoverende sfeer van de Provence en biedt conciërgediensten, seizoensverhuur, huishouding en beheer van langetermijnverhuur."
    ]
  },
