  "rdfs:comment": {
    "de": [
      "Laurent Putman ist ein leidenschaftlicher Imker, Züchter und erntender Produzent.\nEr produziert vor Ort verschiedene Honigsorten: Akazienhonig, Kastanienhonig und den unumgänglichen Frühlingshonig."
    ],
    "en": [
      "Laurent Putman is a passionate beekeeper, breeder and producer.\nHe produces several varieties of honey locally: Acacia, chestnut and the essential spring honey."
    ],
    "it": [
      "Laurent Putman è un appassionato apicoltore, allevatore e produttore.\nProduce localmente diverse varietà di miele: di acacia, di castagno e l'essenziale miele di primavera."
    ],
    "fr": [
      "Apiculteur éleveur et producteur récoltant, Laurent Putman est un passionné. \nIl produit localement différentes variétés de miel : Acacia, châtaignier et l'incontournable miel de printemps."
    ],
    "nl": [
      "Laurent Putman is een gepassioneerde imker, kweker en producent.\nHij produceert lokaal verschillende soorten honing: acaciahoning, kastanjehoning en de essentiële voorjaarshoning."
    ],
    "es": [
      "Laurent Putman es un apasionado apicultor, criador y productor.\nProduce localmente diversas variedades de miel: de acacia, de castaño y la imprescindible miel de primavera."
    ]
  },
  "rdfs:label": {
