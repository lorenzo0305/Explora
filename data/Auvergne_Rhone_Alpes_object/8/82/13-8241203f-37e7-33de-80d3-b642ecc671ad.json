  "rdfs:comment": {
    "de": [
      "Drei Stunden lang tauchen Sie in die Welt der natürlichen Parfümerie ein. Entdecken Sie die Düfte und die Geschichte der Akkorde und machen Sie sich dann an die Komposition."
    ],
    "en": [
      "Three hours of immersion in the world of natural perfumery. Discover the scents and history of fragrance accords, then get to work on the composition."
    ],
    "it": [
      "Tre ore di immersione nel mondo della profumeria naturale. Scoprite i profumi e la storia delle combinazioni di fragranze, poi iniziate a comporre le vostre."
    ],
    "fr": [
      "Trois heures d'immersion dans le monde de la parfumerie naturelle. Partez à la découverte des senteurs et de l'histoire des accords puis lancez-vous dans la composition."
    ],
    "es": [
      "Tres horas de inmersión en el mundo de la perfumería natural. Descubra los aromas y la historia de las combinaciones de fragancias, y empiece a componer las suyas propias."
    ],
    "nl": [
      "Drie uur onderdompeling in de wereld van natuurlijke parfums. Ontdek de geuren en de geschiedenis van geurcombinaties en begin daarna met het samenstellen van je eigen geur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Parfum : \"De la matière à l'accord\""
    ]
  },
