  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Feinschmeckerdorf St Bonnet le Froid mithilfe unserer Botschafter der Region: Jeannot und Marie France Neyron oder André Marcon. Buchen Sie Ihren Besuch beim Fremdenverkehrsamt Haut Pays du Velay 04 71 59 95 73."
    ],
    "en": [
      "Discover the gourmet village of St Bonnet le Froid with our local ambassadors: Jeannot and Marie France Neyron or André Marcon. Book your visit with the Haut Pays du Velay tourist office 04 71 59 95 73."
    ],
    "it": [
      "Scoprite il villaggio gastronomico di St Bonnet le Froid con i nostri ambasciatori locali: Jeannot e Marie France Neyron o André Marcon. Prenotate la vostra visita presso l'Ufficio del Turismo dell'Haut Pays du Velay 04 71 59 95 73."
    ],
    "fr": [
      "Découvrez le village gourmand de St Bonnet le Froid grâce à nos ambassadeurs de territoire : Jeannot et Marie France Neyron ou André Marcon. Réservez votre visite auprès de l'office de tourisme Haut Pays du Velay 04 71 59 95 73."
    ],
    "nl": [
      "Ontdek het gastronomische dorp St Bonnet le Froid met onze plaatselijke ambassadeurs: Jeannot en Marie France Neyron of André Marcon. Reserveer je bezoek bij het Office du Tourisme du Haut Pays du Velay 04 71 59 95 73."
    ],
    "es": [
      "Descubra el pueblo gastronómico de St Bonnet le Froid de la mano de nuestros embajadores locales: Jeannot y Marie France Neyron o André Marcon. Reserve su visita en la Oficina de Turismo de Haut Pays du Velay 04 71 59 95 73."
    ]
  },
  "rdfs:label": {
