  "rdfs:comment": {
    "de": [
      "Das Eisstadion mit seiner 1800 m2 großen Eisfläche bietet im Sommer einen frischen Luftzug und rundet das vielfältige Angebot an Wintersportaktivitäten harmonisch ab. Kommen Sie zu unseren „Popcorn“-Nachmittagen, zum Schokoladen-Fondue und „DJ'Ice\" oder zur „Bubble-Party“!"
    ],
    "en": [
      "With its 1800m2 of ice, the ice rink can provide a welcome breath of cool air in summer as well as being an ideal addition to your winter sports activites."
    ],
    "it": [
      "1.800 m2 di superficie ghiacciata!  La pista di pattinaggio è una boccata d'aria fresca in estate e un complemento perfetto per l'offerta di sport invernali."
    ],
    "fr": [
      "1 800 m2 de surface glacée !  La patinoire offre une bouffée d’air frais pendant l’été et complète harmonieusement la panoplie des sports d’hiver."
    ],
    "nl": [
      "1.800 m2 ijsoppervlak!  De ijsbaan is een verademing in de zomer en een perfecte aanvulling op het wintersportaanbod."
    ],
    "es": [
      "1.800 m2 de superficie de hielo  La pista de hielo es un soplo de aire fresco en verano y un complemento perfecto a la oferta de deportes de invierno."
    ]
  },
