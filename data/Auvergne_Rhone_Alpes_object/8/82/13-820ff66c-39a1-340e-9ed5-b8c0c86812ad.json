  "rdfs:comment": {
    "de": [
      "Lust, eine gute Zeit zu verbringen? Unser Bowling- und Freizeitbereich empfängt Sie in einer herzlichen und festlichen Atmosphäre, um Momente des Austauschs und der Unterhaltung zu erleben."
    ],
    "en": [
      "A 6-lane bowling alley, 3 of which have been specially adapted to children. It also has a games area with billiards and table football as well as a giant screen showing all sporting events and a snack bar in case you're feeling peckish."
    ],
    "it": [
      "Siete alla ricerca di divertimento? La nostra area bowling e tempo libero vi accoglie in un'atmosfera calda e festosa, per momenti di condivisione e divertimento."
    ],
    "fr": [
      "Envie de passer un bon moment ? Notre espace bowling et loisirs vous accueille dans une ambiance chaleureuse et festive, pour des instants de partages et de divertissements."
    ],
    "es": [
      "¿Busca pasar un buen rato? Nuestra zona de bolos y ocio le da la bienvenida en un ambiente cálido y festivo, para momentos de compartir y entretenimiento."
    ],
    "nl": [
      "Op zoek naar een leuke tijd? Onze bowling- en ontspanningsruimte verwelkomt je in een warme en feestelijke sfeer, voor momenten van samenzijn en vermaak."
    ]
  },
  "rdfs:label": {
    "en": [
