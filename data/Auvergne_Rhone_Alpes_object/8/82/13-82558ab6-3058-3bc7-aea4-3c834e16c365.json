  "rdfs:comment": {
    "de": [
      "Es verfügt über eine schattige Terrasse und einen Parkplatz und bietet eine einfache Küche mit guten Produkten in einer Dekoration, die an die RN7 vor 1968 erinnert."
    ],
    "en": [
      "Featuring a shaded terrace and parking, the restaurant offers simple, high-quality cuisine, decorated in a style reminiscent of the RN7 before 1968."
    ],
    "it": [
      "Con la sua terrazza ombreggiata e il parcheggio, serve una cucina semplice e di qualità, decorata in uno stile che ricorda la RN7 prima del 1968."
    ],
    "fr": [
      "Disposant d’une terrasse ombragée et d’un parking, il propose une cuisine simple avec des bons produits, dans une décoration évoquant la RN7 avant 1968."
    ],
    "nl": [
      "Met zijn schaduwrijke terras en parkeerplaats serveert het eenvoudige gerechten van hoge kwaliteit, ingericht in een stijl die doet denken aan de RN7 van voor 1968."
    ],
    "es": [
      "Con su terraza a la sombra y su aparcamiento, sirve comida sencilla y de calidad, decorada con un estilo que recuerda a la RN7 anterior a 1968."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Pause RN 7"
    ]
  },
