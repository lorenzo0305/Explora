  "rdfs:comment": {
    "de": [
      "Das familiengeführte Hotel-Restaurant, das Ihnen Ruhe und Entspannung in den Bergen der Ardèche bietet. Hausgemachte Küche von hoher Qualität. Wir freuen uns, Sie zu empfangen!"
    ],
    "en": [
      "Hôtel Au Parfum des Bois is a family hotel and restaurant where you can enjoy peace and quiet in the Ardèche mountain. Home cooking. We can't wait to meet you!"
    ],
    "it": [
      "Un hotel-ristorante a conduzione familiare che offre pace e relax nelle montagne dell'Ardèche. Cucina casalinga di qualità. Saremo lieti di darvi il benvenuto!"
    ],
    "fr": [
      "L'hôtel-restaurant familial qui vous procurera calme et détente en Montagne Ardéchoise. Cuisine faite maison de qualité. Au plaisir de vous recevoir !"
    ],
    "es": [
      "Un hotel-restaurante familiar que ofrece tranquilidad y relajación en las montañas de Ardèche. Cocina casera de calidad. ¡Le esperamos!"
    ],
    "nl": [
      "Een hotel-restaurant in familiebeheer dat rust en ontspanning biedt in de bergen van de Ardèche. Huisgemaakte kwaliteitskeuken. We kijken ernaar uit u te verwelkomen!"
    ]
  },
