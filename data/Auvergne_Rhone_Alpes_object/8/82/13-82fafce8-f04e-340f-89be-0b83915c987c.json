  "rdfs:comment": {
    "de": [
      "Workshop zur Korbflechterei aus Weidenruten. Entdecken Sie ein echtes Kunsthandwerk: von der Korbflechterei bis zur Pflanzenskulptur. Kommentierte Besichtigung nach Vereinbarung. Praktika. Einführung auf Anfrage (Gruppen, Kinder, Familien)."
    ],
    "en": [
      "Wicker basketry workshop. Discover a real craft: from the corbel to the plant sculpture. Guided tour by appointment. Training courses. Initiation on request (groups, children, families)."
    ],
    "it": [
      "Laboratorio di vimini. Scoprite un vero e proprio mestiere: dalla mensola alla scultura vegetale. Visita guidata su appuntamento. Corsi di formazione. Iniziazione su richiesta (gruppi, bambini, famiglie)."
    ],
    "fr": [
      "Atelier de vannerie d'osier. Découvrez un véritable métier d'art : du corbillon à la sculpture végétale. Visite commentée sur RDV. Stages. Initiation à la demande (groupes, enfants, familles)."
    ],
    "nl": [
      "Vlechtwerk workshop. Ontdek een echt ambacht: van de korbeel tot de plantensculptuur. Rondleiding op afspraak. Opleidingen. Initiatie op aanvraag (groepen, kinderen, families)."
    ],
    "es": [
      "Taller de mimbres. Descubra un verdadero oficio: desde la ménsula hasta la escultura vegetal. Visita guiada con cita previa. Cursos de formación. Iniciación a petición (grupos, niños, familias)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vannier l'Atelier d'Osier"
    ]
  },
