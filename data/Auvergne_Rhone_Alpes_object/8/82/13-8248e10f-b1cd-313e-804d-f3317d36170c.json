  "rdfs:comment": {
    "de": [
      "Diesen Winter bietet Chefkoch Emmanuel Renaut im Flocons Village ein neues Konzept für ein Bergrestaurant an. Entdecken Sie schmackhafte Gerichte rund um unsere Käsesorten."
    ],
    "en": [
      "This winter, Chef Emmanuel Renaut is offering a new mountain restaurant concept at Flocons Village. Discover delicious dishes featuring our cheeses."
    ],
    "it": [
      "Quest'inverno, lo chef Emmanuel Renaut propone un nuovo concetto di ristorante di montagna al Flocons Village. Scoprite i gustosi piatti a base dei nostri formaggi."
    ],
    "fr": [
      "Cet hiver, le Chef Emmanuel Renaut propose un nouveau concept de restaurant de montagne au Flocons Village. Découvrez des plats savoureux autour de nos fromages."
    ],
    "es": [
      "Este invierno, el Chef Emmanuel Renaut propone un nuevo concepto de restaurante de montaña en Flocons Village. Descubra sabrosos platos en torno a nuestros quesos."
    ],
    "nl": [
      "Deze winter biedt chef-kok Emmanuel Renaut een nieuw bergrestaurantconcept in Flocons Village. Ontdek smakelijke gerechten gebaseerd op onze kazen."
    ]
