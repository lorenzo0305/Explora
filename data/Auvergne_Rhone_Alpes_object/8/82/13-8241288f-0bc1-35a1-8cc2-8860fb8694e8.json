  "rdfs:comment": {
    "de": [
      "In Hières-sur-Amby, zwischen Natur und Kulturerbe, empfängt Sie dieses Haus für einen Zwischenstopp oder einen herzlichen Aufenthalt. \r\nDas Hotel verfügt über komfortable Zimmer mit gepflegter Dekoration sowie über ein Restaurant mit raffinierten Aromen."
    ],
    "en": [
      "Located in Hières-sur-Amby, between nature and heritage, this establishment welcomes you for a stopover or a warm stay. \r\nThe hotel has comfortable, tastefully decorated rooms and a refined restaurant."
    ],
    "it": [
      "Situata a Hières-sur-Amby, tra natura e patrimonio, questa struttura vi accoglie per una sosta o un caldo soggiorno.\r\nL'hotel dispone di camere confortevoli e arredate con gusto e di un ristorante raffinato."
    ],
    "fr": [
      "Situé à Hières-sur-Amby, entre nature et patrimoine, cet établissement vous accueille pour une étape ou pour un séjour chaleureux. \r\nL'hôtel dispose de chambres confortables à la décoration soignée ainsi que d'un restaurant aux saveurs raffinées."
    ],
    "es": [
      "Situado en Hières-sur-Amby, entre naturaleza y patrimonio, este establecimiento le da la bienvenida para una escala o una cálida estancia.\r\nEl hotel dispone de habitaciones confortables y decoradas con gusto, así como de un refinado restaurante."
    ],
    "nl": [
      "Gelegen in Hières-sur-Amby, tussen natuur en erfgoed, verwelkomt dit etablissement u voor een tussenstop of een warm verblijf.\r\nHet hotel beschikt over comfortabele, smaakvol ingerichte kamers en een verfijnd restaurant."
    ]
  },
  "rdfs:label": {
    "de": [
      "Hôtel Restaurant du Val d'Amby"
    ],
