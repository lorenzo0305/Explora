  "rdfs:comment": {
    "de": [
      "Die vierte Generation der Familie Vachon freut sich, Sie für einen schmackhaften und komfortablen Zwischenstopp auf dem Jakobsweg, dem Weg des Heiligen Johannes Franziskus Regis und mit direktem Zugang zum grünen Weg Via Fluvia begrüßen zu dürfen."
    ],
    "en": [
      "The 4th generation of the Vachon family will be delighted to welcome you for a tasty and comfortable stopover on the Way of St. James of Compostela, the Way of St. John Francis Regis and in direct access on the greenway the Via Fluvia."
    ],
    "it": [
      "La quarta generazione della famiglia Vachon sarà lieta di accogliervi per una sosta gustosa e confortevole sul Cammino di St Jacques de Compostelle, da St Jean François Régis e con accesso diretto alla Via Fluvia."
    ],
    "fr": [
      "La 4ème génération de la famille Vachon sera ravie de vous accueillir pour une étape savoureuse et confortable sur le Chemin de St Jacques de Compostelle, de St Jean François Régis et en accès directe sur la voie verte la Via Fluvia."
    ],
    "es": [
      "La 4ª generación de la familia Vachon estará encantada de recibirle para una sabrosa y confortable parada en el Camino de Santiago de Compostela, desde St Jean François Régis y con acceso directo a la Vía Fluvia."
    ],
    "nl": [
      "De 4e generatie van de familie Vachon ontvangt u graag voor een smakelijke en comfortabele tussenstop op de Weg van St Jacques de Compostelle, vanuit St Jean François Régis en met directe toegang tot de Via Fluvia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant les Platanes - Maison Vachon"
    ]
  },
