  "rdfs:comment": {
    "de": [
      "Weingut, das sich in der Umstellung auf biologischen Landbau befindet. Die Kennzeichnung ist für die Weine vorgesehen, die aus der Weinlese des Jahrgangs 2021 hervorgehen und ab dem späten Frühjahr 2020 vermarktet werden können"
    ],
    "en": [
      "Wine estate in conversion to Organic Agriculture. Labelling planned for the wines which will be stemming from the vintage 2021 and which will be able to be marketed from the end of spring 2020"
    ],
    "it": [
      "Azienda vitivinicola in conversione all'agricoltura biologica. Il marchio sarà assegnato ai vini prodotti a partire dalla vendemmia 2021 e commercializzati a partire dalla tarda primavera del 2020"
    ],
    "fr": [
      "Domaine viticole en conversion vers l'Agriculture Biologique. Labellisation prévue pour les vins qui seront issus la vendange du millésime 2021 et qui pourront être commercialisés à partir de la fin printemps 2020"
    ],
    "nl": [
      "Wijnbouwbedrijf in omschakeling naar biologische landbouw. Het label zal worden toegekend aan wijnen die geproduceerd zijn vanaf oogstjaar 2021 en vanaf het late voorjaar van 2020 op de markt worden gebracht"
    ],
    "es": [
      "Finca vitícola en reconversión a la Agricultura Ecológica. La etiqueta se concederá a los vinos producidos a partir de la cosecha de 2021 y comercializados a partir de finales de la primavera de 2020"
    ]
  },
  "rdfs:label": {
    "en": [
