  "rdfs:comment": {
    "de": [
      "\"Der Salle Jean Dasté ist der Programmort der städtischen Kultursaison. Mit einer Kapazität von 479 Sitzplätzen ist dieser Saal der ideale Ort, um Konzerte von nationaler Bedeutung in einer intimen Atmosphäre zu besuchen\"."
    ],
    "en": [
      "\"Salle Jean Dasté is the venue for the municipal cultural season. With a seating capacity of 479, this hall is the ideal place to attend concerts of national stature in an intimate atmosphere\"."
    ],
    "it": [
      "\"La Salle Jean Dasté è la sede della stagione culturale comunale. Con una capacità di 479 posti a sedere, è il luogo ideale per assistere a concerti nazionali in un ambiente intimo."
    ],
    "fr": [
      "\"La salle Jean Dasté est le lieu de programmation de la saison culturelle municipale. Avec une capacité de 479 places assises, cette salle est le lieu idéal pour assister à des concerts d’envergure nationale dans une ambiance intimiste\"."
    ],
    "es": [
      "\"La Salle Jean Dasté es el escenario de la temporada cultural municipal. Con un aforo de 479 plazas, es el lugar ideal para disfrutar de conciertos nacionales en un ambiente íntimo."
    ],
    "nl": [
      "\"De Salle Jean Dasté is de locatie voor het gemeentelijke culturele seizoen. Met een capaciteit van 479 zitplaatsen is het de ideale plek om te genieten van nationale concerten in een intieme setting\"."
    ]
  },
