  "rdfs:comment": {
    "de": [
      "Herstellung und Verkauf von Produkten auf Kastanienbasis: Kastaniencreme, glasierte Kastanien, Kastanienpüree, Kastanienpaste, kandierte Kastanien in Sirup. Direktverkauf an die Öffentlichkeit. Schmecken Goûtez l'Ardèche®."
    ],
    "en": [
      "Manufacture and sale of chestnut-based products: chestnut cream, marrons glacés, chestnut purée, chestnut paste, candied chestnuts in syrup. Direct sales to the public. Goûtez l'Ardèche®."
    ],
    "it": [
      "Produzione e vendita di prodotti a base di castagne: crema di castagne, castagne glassate, purea di castagne, pasta di castagne, castagne sciroppate. Vendita diretta al pubblico. Assaggiate l'Ardèche®."
    ],
    "fr": [
      "Fabrication et vente de produits à base de marrons : crème de marrons, marrons glacés, purée de marrons, pâte de marrons, marrons confits au sirop. Vente directe au public. Goûtez l'Ardèche®."
    ],
    "nl": [
      "Productie en verkoop van producten op basis van kastanjes: kastanjecrème, marrons glacés, kastanjepuree, kastanjepasta, gekonfijte kastanjes op siroop. Rechtstreekse verkoop aan het publiek. Goûtez l'Ardèche®."
    ],
    "es": [
      "Fabricación y venta de productos a base de castañas: crema de castañas, castañas glaseadas, puré de castañas, pasta de castañas, castañas confitadas en almíbar. Venta directa al público. Pruebe el Ardèche®."
    ]
  },
