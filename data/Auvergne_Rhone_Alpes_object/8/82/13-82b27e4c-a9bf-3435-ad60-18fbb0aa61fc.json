  "rdfs:comment": {
    "de": [
      "Privates Tor zur Exzellenz der Region Rhône-Alpes. Ultra-personalisierte Routen für anspruchsvolle Reisende: exklusiver Zugang, Premium-Logistik und Legacy-Service von Lyon bis zu den Alpen."
    ],
    "en": [
      "Private gateway to excellence in the Rhône-Alpes region. Ultra-personalized itineraries for discerning travelers: exclusive access, premium logistics and 'Legacy' service from Lyon to the Alps."
    ],
    "it": [
      "Una porta privata verso l'eccellenza della regione Rodano-Alpi. Itinerari ultra-personalizzati per viaggiatori esigenti: accesso esclusivo, logistica premium e servizio \"Legacy\" da Lione alle Alpi."
    ],
    "fr": [
      "Porte d’entrée privée vers l’excellence rhônalpine. Itinéraires ultra-personnalisés pour voyageurs exigeants : accès exclusifs, logistique premium et service 'Legacy' de Lyon aux Alpes."
    ],
    "es": [
      "Una puerta privada a la excelencia en la región de Rhône-Alpes. Itinerarios ultrapersonalizados para viajeros exigentes: acceso exclusivo, logística premium y servicio \"Legacy\" de Lyon a los Alpes."
    ],
    "nl": [
      "Een privé toegangspoort tot uitmuntendheid in de regio Rhône-Alpes. Uiterst persoonlijke routes voor veeleisende reizigers: exclusieve toegang, eersteklas logistiek en 'Legacy'-service van Lyon naar de Alpen."
    ]
  },
  "rdfs:label": {
