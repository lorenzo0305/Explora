  "rdfs:comment": {
    "de": [
      "Auf dem Plateau des Hurtières-Massivs, gegenüber dem Lauzière-Massiv, entdecken Sie ein religiöses (barockes) und natürliches (Natura 2000) Erbe.\r\nGeführte Besichtigungen mit Marie-Claire oder pädagogische Workshops mit Laetitia, Guides du Patrimoine Savoie Mont Blanc."
    ],
    "en": [
      "On the plateau of the Hurtières massif, facing the Lauzière massif, discover a religious (Baroque) and natural (Natura 2000) heritage.\r\nGuided tours with Marie-Claire or educational workshops with Laetitia, Savoie Mont Blanc Heritage Guides."
    ],
    "it": [
      "Sull'altopiano del massiccio delle Hurtières, di fronte al massiccio del Lauzière, scoprite un patrimonio religioso (barocco) e naturale (Natura 2000).\r\nVisite guidate con Marie-Claire o laboratori didattici con Laetitia, Guide del Patrimonio della Savoia Monte Bianco."
    ],
    "fr": [
      "Sur le plateau du massif des Hurtières, face au massif de la Lauzière, découvrez un patrimoine religieux (baroque) et naturel (Natura 2000).\r\nVisites guidées avec Marie-Claire ou ateliers pédagogiques avec Laetitia, Guides du Patrimoine Savoie Mont Blanc."
    ],
    "nl": [
      "Ontdek op het plateau van het Hurtières-massief, tegenover het Lauzière-massief, een religieus (barok) en natuurlijk (Natura 2000) erfgoed.\r\nRondleidingen met Marie-Claire of educatieve workshops met Laetitia, Savoie Mont Blanc Heritage Guides."
    ],
    "es": [
      "En la meseta del macizo de las Hurtières, frente al macizo de la Lauzière, descubra un patrimonio religioso (barroco) y natural (Natura 2000).\r\nVisitas guiadas con Marie-Claire o talleres didácticos con Laetitia, Guías del Patrimonio de Saboya Mont Blanc."
    ]
  },
