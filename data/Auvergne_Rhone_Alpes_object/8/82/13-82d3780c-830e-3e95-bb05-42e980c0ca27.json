  "rdfs:comment": {
    "de": [
      "Seit der Ernte 2024 hat Jean-Paul BRUN die Domaine des Terres Dorées, eine echte Referenz im Beaujolais, in die Hände der Domaines Roger Zannier gelegt, um sie weiterzugeben. Das neue Team hat es sich zur Aufgabe gemacht, qualitativ hochwertige Beaujolais-Weine anzubieten."
    ],
    "en": [
      "Since the 2024 harvest, with a desire to pass on his legacy, Jean-Paul BRUN has entrusted Domaines Roger Zannier with Domaine des Terres Dorées, a true benchmark in Beaujolais. The new team is committed to offering high-quality Beaujolais wines."
    ],
    "it": [
      "Dalla vendemmia 2024, Jean-Paul BRUN ha affidato a Domaines Roger Zannier il Domaine des Terres Dorées, un punto di riferimento nel Beaujolais. Il nuovo team è determinato a offrire vini di qualità del Beaujolais."
    ],
    "fr": [
      "Depuis la récolte 2024, dans une volonté de transmettre, Jean-Paul BRUN a confié aux Domaines Roger Zannier le Domaine des Terres Dorées, véritable référence du Beaujolais. La nouvelle équipe met à cœur de proposer des vins du beaujolais de qualité."
    ],
    "nl": [
      "Sinds de oogst van 2024 heeft Jean-Paul BRUN het Domaine des Terres Dorées, een referentie in de Beaujolais, toevertrouwd aan Domaines Roger Zannier. Het nieuwe team is vastbesloten om Beaujolais-wijnen van hoge kwaliteit aan te bieden."
    ],
    "es": [
      "Desde la cosecha de 2024, Jean-Paul BRUN confía a Domaines Roger Zannier el Domaine des Terres Dorées, una referencia en Beaujolais. El nuevo equipo está decidido a ofrecer vinos de Beaujolais de calidad."
    ]
  },
  "rdfs:label": {
