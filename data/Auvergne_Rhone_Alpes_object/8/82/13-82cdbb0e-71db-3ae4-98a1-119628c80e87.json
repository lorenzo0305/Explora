  "rdfs:comment": {
    "de": [
      "Bar-Restaurant mit 100% hausgemachter Küche aus frischen, lokalen Produkten. Ardèche Wein- und Bierkeller, hausgemachte Cocktails. Geöffnet jeden Mittag (außer Mittwoch) + Freitag/Samstag abends außerhalb der Saison."
    ],
    "en": [
      "Bar-restaurant serving 100% home-cooked food made with fresh, local produce. Ardèche wine and beer cellar, homemade cocktails. Open every lunchtime (except Wednesday) + Friday/Saturday evenings out of season."
    ],
    "it": [
      "Bar-ristorante che propone una cucina casalinga al 100% con prodotti freschi e locali. Cantina di vini e birre dell'Ardèche, cocktail fatti in casa. Aperto tutti i pranzi (tranne il mercoledì) + venerdì/sabato sera fuori stagione."
    ],
    "fr": [
      "Bar restaurant proposant une cuisine 100 % maison élaborée à partir de produits frais, bruts et locaux. Cave à vins et à bières d’Ardèche, cocktails maisons. Ouvert tous les midis (sauf mercredi) + les vendredi/samedi soir hors saison."
    ],
    "es": [
      "Bar-restaurante con cocina 100% casera elaborada con productos frescos y locales. Bodega de vinos y cervezas de Ardèche, cócteles caseros. Abierto todos los mediodías (excepto los miércoles) y los viernes y sábados por la noche fuera de temporada."
    ],
    "nl": [
      "Bar-restaurant met 100% huisgemaakte keuken met verse, lokale producten. Ardèche wijn- en bierkelder, huisgemaakte cocktails. Elke middag geopend (behalve woensdag) + vrijdag/zaterdagavond buiten het seizoen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Bistro de Pays: der Orgelpunkt"
    ],
    "en": [
      "Bistrot de Pays: The Point d'Orgues"
    ],
    "fr": [
      "Bistrot de Pays : Le Point d'Orgues"
    ]
  },
