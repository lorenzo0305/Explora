  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Heritage-Orientierungslauf an der Côte d'Aime! Entdecken Sie diese alten Dörfer, die Weinberge und Obstgärten dieses hochgelegenen Dorfes. Eine mittlere Strecke von 4 km mit 150mD+ und 9 Markierungen."
    ],
    "en": [
      "Welcome to the orienteering course focusing on heritage around La Côte d'Aime!\r\nDiscover the old villages, the vineyards and orchards around this village nestled on the mountainside.\r\nA medium-level course of 4km and 150m elevation gain with 9 markers."
    ],
    "it": [
      "Benvenuti sul percorso di orienteering del patrimonio della Côte d'Aime! Scoprite gli antichi borghi, i vigneti e i frutteti di questo villaggio collinare. Un percorso medio di 4 km con 150mD+ e i suoi 9 indicatori."
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation patrimoine sur la Côte d'Aime ! Découvrez ces villages anciens, les vignes et vergers de ce village perché Un parcours moyen de 4km avec 150mD+ et ses 9 balises."
    ],
    "nl": [
      "Welkom bij het oriëntatieparcours van de Côte d'Aime! Ontdek de oude dorpjes, wijngaarden en boomgaarden van dit dorp op een heuveltop. Een gemiddeld parcours van 4 km met 150mD+ en 9 markers."
    ],
    "es": [
      "Bienvenido al recorrido de orientación patrimonial de la Côte d'Aime Descubra las antiguas aldeas, los viñedos y los huertos de este pueblo en la cima de una colina. Un recorrido medio de 4 km con 150mD+ y sus 9 balizas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Kulturerbe an der Côte d'Aime - blauer Parcours"
    ],
    "en": [
      "Orienteering course focusing on heritage around La Côte d'Aime - blue level"
    ],
    "fr": [
      "Parcours d'orientation Patrimoine sur la Côte d'Aime - parcours bleu"
    ],
    "nl": [
      "Oriëntatieloop van de Côte d'Aime - blauwe route"
    ]
  },
