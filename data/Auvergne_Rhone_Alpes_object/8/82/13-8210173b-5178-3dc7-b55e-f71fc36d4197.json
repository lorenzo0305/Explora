  "rdfs:comment": {
    "de": [
      "Der Weinberg von Anthony Paret liegt im nördlichen Rhône-Tal, 50 km südlich von Lyon, und ist mit steilen, unebenen Hängen bepflanzt, die nach Süd-Südost ausgerichtet sind."
    ],
    "en": [
      "Located in the Northern Rhône Valley, 50 km south of Lyon, Anthony Paret's vineyard is planted on steep, hilly hillsides facing south-south-east."
    ],
    "it": [
      "Situato nella Valle del Rodano settentrionale, a 50 km a sud di Lione, il vigneto di Anthony Paret è piantato su colline ripide e irregolari esposte a sud-sud-est."
    ],
    "fr": [
      "Situé dans la Vallée du Rhône Septentrionale, à 50 km au sud de Lyon, le vignoble d’Anthony Paret est planté à flans de coteaux pentus, accidentés, orientés sud sud-est."
    ],
    "es": [
      "Situado en el Valle del Ródano Norte, a 50 km al sur de Lyon, el viñedo de Anthony Paret está plantado en laderas empinadas y accidentadas orientadas al sur-sureste."
    ],
    "nl": [
      "De wijngaard van Anthony Paret ligt in de noordelijke Rhône-vallei, 50 km ten zuiden van Lyon en is aangeplant op steile, oneffen hellingen die naar het zuidzuidoosten gericht zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Anthony Paret"
    ]
  },
