  "rdfs:comment": {
    "de": [
      "Tignes ist ein unumgänglicher Spot für Winterferien mit der Familie. Es ist ein Skiort mit Rodelbahnen, die für kleine Kinder geeignet sind. Gesicherte Rodelbereiche stehen in verschiedenen Vierteln des Ortes (Lac, Lavachet...) kostenlos zur Verfügung."
    ],
    "en": [
      "A must-visit destination for family winter vacations, Tignes is a ski resort with sledding slopes suitable for young children. Secure sledding areas are available free of charge in various parts of the resort (Lac, Lavachet, etc.)."
    ],
    "it": [
      "Tignes è un must per tutte le vacanze invernali in famiglia, con piste da slittino adatte ai bambini più piccoli. Aree sicure per slittini sono disponibili gratuitamente in varie zone della località (Lac, Lavachet...)."
    ],
    "fr": [
      "Spot incontournable des vacances d’hiver en famille, Tignes est une station de ski avec des pistes de luge adaptées aux jeunes enfants. Des espaces luge sécurisés sont à disposition gratuitement dans différents quartiers de la station (Lac, Lavachet...)."
    ],
    "nl": [
      "Tignes is een must voor alle wintervakanties met het hele gezin, met rodelbanen die geschikt zijn voor jonge kinderen. Veilige rodelgebieden zijn gratis beschikbaar in verschillende delen van het resort (Lac, Lavachet...)."
    ],
    "es": [
      "Tignes es un destino obligado para las vacaciones de invierno en familia, con pistas de trineo aptas para niños pequeños. Hay zonas de trineo seguras y gratuitas en varios puntos de la estación (Lac, Lavachet...)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Children's tobogganing areas"
    ],
    "fr": [
      "Espaces luge enfants"
    ]
  },
