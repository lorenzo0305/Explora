  "rdfs:comment": {
    "de": [
      "12 Hektar, 2. Kategorie, Navigation verboten.\r\nSeine beweglichen Ufer (Torf/Schlamm) und sein schwieriger Zugang sind potenziell gefährlich. Nur für erfahrene und ausgerüstete Angler."
    ],
    "en": [
      "12 hectares, 2nd category, navigation prohibited.\r\nIts shifting banks (peat/mud) and difficult access are potentially dangerous. For experienced and equipped anglers only."
    ],
    "it": [
      "12 ettari, 2a categoria, navigazione vietata.\r\nLe sue sponde mobili (torba/fango) e l'accesso difficile sono potenzialmente pericolose. Solo per pescatori esperti e attrezzati."
    ],
    "fr": [
      "12 hectares, 2ème catégorie, navigation interdite. \r\nSes berges mouvantes (tourbe/vase) et son accès difficile sont potentiellement dangereux. Réservé aux pêcheurs expérimentés et équipés."
    ],
    "nl": [
      "12 hectare, 2e categorie, scheepvaart verboden.\r\nDe verschuivende oevers (veen/modder) en moeilijke toegang zijn potentieel gevaarlijk. Alleen voor ervaren en goed uitgeruste vissers."
    ],
    "es": [
      "12 hectáreas, 2ª categoría, navegación prohibida.\r\nSus orillas movedizas (turba/lodo) y su difícil acceso son potencialmente peligrosas. Solo para pescadores experimentados y equipados."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lac de Madic (fishing site)"
    ],
    "fr": [
      "Lac de Madic (site de pêche)"
    ]
  },
