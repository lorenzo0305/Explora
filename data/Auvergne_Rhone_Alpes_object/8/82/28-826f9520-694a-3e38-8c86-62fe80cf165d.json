      "rdfs:comment": {
        "de": [
          "Verkauf von Meeresfrüchteplatten (auf Bestellung), Fisch, Schalentieren, Konserven, Präsentkörben (auf Anfrage), Weinen, Präsentkörben (auf Bestellung) und kleinen allgemeinen Lebensmitteln."
        ],
        "en": [
          "Sale of seafood platters (to order), fish, shellfish, preserves, gourmet baskets (to order), wines, gourmet baskets (to order) and small general groceries."
        ],
        "it": [
          "Vendita di piatti di pesce (su ordinazione), pesce, crostacei, conserve, cestini gourmet (su ordinazione), vini, cestini gourmet (su ordinazione) e piccoli generi alimentari."
        ],
        "fr": [
          "Vente de plateaux de fruits de mer (sur commande), poissons, crustacés, conserves, paniers garnis (sur demande), vins, panier garnis (sur commande) et petite épicerie générale."
        ],
        "nl": [
          "Verkoop van schalen met zeevruchten (op bestelling), vis, schaaldieren, conserven, gourmetmanden (op bestelling), wijnen, gourmetmanden (op bestelling) en kleine algemene kruidenierswaren."
        ],
        "es": [
          "Venta de platos de marisco (por encargo), pescado, marisco, conservas, cestas gastronómicas (por encargo), vinos, cestas gastronómicas (por encargo) y pequeños productos de alimentación general."
        ]
      },
