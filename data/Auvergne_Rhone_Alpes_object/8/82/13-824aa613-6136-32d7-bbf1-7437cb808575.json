  "rdfs:comment": {
    "de": [
      "Familienbetrieb im Herzen der Bourne-Schlucht mit traditioneller und lokaler Küche, die von unserer Küchenchefin Marine zubereitet wird. Das Lokal wird von Liebhabern des Vercors geführt. Zögern Sie nicht, nach Tipps für Ihre Besuche in unserer schönen Region zu fragen."
    ],
    "en": [
      "Family-run establishment in the heart of the Bourne gorges, with traditional & local cuisine prepared by our chef Marine. Run by people who love the Vercors. Don't hesitate to ask for advice on visiting our beautiful region."
    ],
    "it": [
      "Struttura a conduzione familiare nel cuore delle Gorges de la Bourne, con cucina tradizionale locale preparata dal nostro chef Marine. Gestito da persone che amano il Vercors. Non esitate a chiedere consigli per visitare la nostra bella regione."
    ],
    "fr": [
      "Établissement familial situé au cœur des gorges de la Bourne.Cuisine traditionnelle & locale élaborée par notre cheffe Marine. Établissement tenu par des amoureux du Vercors. N’hésitez pas à demander des conseils pour vos visites de notre belle région."
    ],
    "nl": [
      "Familiebedrijf in het hart van de Gorges de la Bourne, met traditionele lokale gerechten bereid door onze chef-kok Marine. Gerund door mensen die van de Vercors houden. Aarzel niet om advies te vragen over een bezoek aan onze prachtige streek."
    ],
    "es": [
      "Establecimiento familiar en el corazón de las Gorges de la Bourne, con cocina tradicional local elaborada por nuestra chef Marine. Dirigido por amantes del Vercors. No dude en pedirnos consejo para visitar nuestra hermosa región."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Jorjane"
    ]
  },
