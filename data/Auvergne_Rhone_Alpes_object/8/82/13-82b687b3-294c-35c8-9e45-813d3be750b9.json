  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere neue Weinbar und unser Restaurant! Eine große Auswahl an Weinen (zum Probieren vor Ort oder zum Mitnehmen), die von Sommelier Antoine ausgewählt wurden und perfekt zu unserer von Nicolas zusammengestellten hausgemachten Küche passen."
    ],
    "en": [
      "Discover our new wine bar and restaurant! A wide selection of wines (to enjoy on site or take away) chosen by Antoine, our sommelier, which pair perfectly with our homemade cuisine prepared by Nicolas."
    ],
    "it": [
      "Scoprite il nostro nuovo wine bar e ristorante! Un'ampia selezione di vini (da degustare sul posto o da asporto) selezionati da Antoine, il nostro sommelier, che si abbinano perfettamente alla nostra cucina casalinga preparata da Nicolas."
    ],
    "fr": [
      "Découvrez notre nouveau bar à vin et restaurant ! Une large sélection de vin (à déguster sur place ou à emporter) sélectionnée par Antoine, sommelier, qui s'accorde parfaitement à notre cuisine maison concoctée par Nicolas."
    ],
    "nl": [
      "Ontdek onze nieuwe wijnbar en restaurant! Een ruime selectie wijnen (om ter plekke te proeven of om mee te nemen), geselecteerd door Antoine, onze sommelier, die perfect samengaan met onze huiselijke keuken, samengesteld door Nicolas."
    ],
    "es": [
      "Descubra nuestro nuevo bar de vinos y restaurante Una amplia selección de vinos (para degustar en el establecimiento o para llevar) seleccionados por Antoine, nuestro sumiller, que combinan a la perfección con nuestra cocina casera elaborada por Nicolas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wine Bar - Vins Dieux"
    ],
