  "rdfs:comment": {
    "de": [
      "Die Manufaktur von Couleuvre, die das Gütesiegel \"Unternehmen des lebendigen Erbes\" trägt, stellt außergewöhnliche Porzellanobjekte her. Als Inbegriff der Eleganz veredelt sie den Alltag mit Anspruch und Kreativität."
    ],
    "en": [
      "The Manufacture de Couleuvre, which has been awarded the \"Entreprise du Patrimoine Vivant\" label, creates exceptional porcelain objects. The quintessence of elegance, it sublimates everyday life with exacting standards and creativity."
    ],
    "it": [
      "La Manufacture de Couleuvre, che ha ottenuto il marchio \"Entreprise du Patrimoine Vivant\" (azienda del patrimonio vivente), crea oggetti di porcellana eccezionali. Quintessenza dell'eleganza, sublima la vita quotidiana con standard esigenti e creatività."
    ],
    "fr": [
      "La Manufacture de Couleuvre, labellisée \"Entreprise du Patrimoine Vivant\" crée des objets de porcelaine d’exception. Quintessence de l’élégance, elle sublime le quotidien avec exigence et créativité."
    ],
    "es": [
      "La Manufacture de Couleuvre, galardonada con el sello \"Entreprise du Patrimoine Vivant\" (Empresa del Patrimonio Vivo), crea objetos de porcelana excepcionales. Quintaesencia de la elegancia, sublima la vida cotidiana con exigencia y creatividad."
    ],
    "nl": [
      "De Manufacture de Couleuvre, die het label \"Entreprise du Patrimoine Vivant\" (Levend Erfgoed Onderneming) heeft gekregen, maakt uitzonderlijke voorwerpen van porselein. De kwintessens van elegantie, sublimeert het dagelijks leven met veeleisende normen en creativiteit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Manufacture de Couleuvre"
    ]
  },
