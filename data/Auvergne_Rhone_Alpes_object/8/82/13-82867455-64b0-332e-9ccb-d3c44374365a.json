  "rdfs:comment": {
    "de": [
      "Premium Massage sind 280 m², die dem Wohlbefinden gewidmet sind. Unser Mehrwert besteht darin, dass wir ein einzigartiges Produkt sind: 7 Tage die Woche geöffnet. Unsere 620 5-Sterne-GOOGLE-Bewertungen sprechen für uns, denn die Qualität der Massage ist unsere Priorität."
    ],
    "en": [
      "Premium Massage offers 3,000 sq. ft of pure wellness in the heart of Lyon’s Presqu’île, right between Opéra and Hôtel de Ville (69001 LYON).\r\nWhat sets us apart? We're a one-of-a-kind experience: open 7 days a week from 10 AM to 9:30 PM — Sundays included — with real-time availability for bookings online or via WhatsApp. Our 620+ 5-star Google reviews say it all: at Premium Massage, massage quality is our top priority."
    ],
    "it": [
      "Premium Massage è un'area di 280 m² dedicata al benessere. Il nostro valore aggiunto è quello di essere un prodotto unico: aperto 7 giorni su 7. Le nostre 620 recensioni a 5 stelle su GOOGLE parlano per noi, perché la qualità del massaggio è la nostra priorità."
    ],
    "fr": [
      "Premium Massage c'est 280 m² dédiés au bien-être. Notre plus-value est d'être un produit unique : ouvert 7 jours sur 7. Nos 620 avis GOOGLE 5 étoiles parlent de nous car la qualité du massage est notre priorité."
    ],
    "nl": [
      "Premium Massage is 280 m² gewijd aan welzijn. Onze toegevoegde waarde is dat we een uniek product zijn: 7 dagen per week geopend. Onze 620 GOOGLE-beoordelingen met 5 sterren spreken voor zich, want de kwaliteit van onze massage is onze prioriteit."
    ],
    "es": [
      "Premium Massage cuenta con 280 m² dedicados al bienestar. Nuestro valor añadido es ser un producto único: abierto los 7 días de la semana. Nuestras 620 opiniones GOOGLE de 5 estrellas hablan por nosotros, porque la calidad de nuestros masajes es nuestra prioridad."
    ]
  },
