  "rdfs:comment": {
    "de": [
      "Werkstatt für die Reparatur von (Quasi-)Fahrrädern aller Marken, Verkauf von neuen und gebrauchten Teilen und Zubehör sowie Kunsthandwerk aus recycelten Teilen alter Fahrräder."
    ],
    "en": [
      "Bicycle workshop, attends to (almost) every brand, retail of spare parts and accessories, new and used, as well as crafted objects from old bicycle parts."
    ],
    "it": [
      "Officina per la riparazione di biciclette di (quasi) tutte le marche, vendita di ricambi e accessori nuovi e di seconda mano, nonché di prodotti artigianali realizzati con parti di vecchie biciclette riciclate."
    ],
    "fr": [
      "Atelier de réparation de vélo (quasi) toutes marques, vente de pièces et accessoires neufs et d'occasion, ainsi que de l'artisanat en pièces de vélos anciennes recyclées."
    ],
    "es": [
      "Taller de reparación de bicicletas de (casi) todas las marcas, venta de piezas y accesorios nuevos y de segunda mano, así como artesanía hecha con piezas de bicicletas antiguas recicladas."
    ],
    "nl": [
      "Fietsreparatiewerkplaats voor (bijna) alle merken, verkoop van nieuwe en tweedehands onderdelen en accessoires, en handwerk gemaakt van gerecyclede oude fietsonderdelen."
    ]
  },
