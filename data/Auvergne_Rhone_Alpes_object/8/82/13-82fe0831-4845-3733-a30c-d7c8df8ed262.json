  "rdfs:comment": {
    "de": [
      "Bankett - Familienessen - Arbeitermahlzeit\r\nSpezialität Froschschenkel und Frittiertes im Juli und August auf Vorbestellung 48 Stunden im Voraus\r\nVegetarische Gerichte\r\nReservierung erforderlich"
    ],
    "en": [
      "Banquet - family meal - worker's meal\r\nSpeciality frog's leg and frying in July-August on reservation 48h in advance\r\nVegetarian dishes\r\nReservation required"
    ],
    "it": [
      "Banchetto - pasto di famiglia - pasto dei lavoratori\r\nSpecialità coscia di rana e fritto in luglio e agosto, su prenotazione con 48 ore di anticipo\r\nPiatti vegetariani\r\nPrenotazione obbligatoria"
    ],
    "fr": [
      "Banquet - repas de familles - repas ouvrier\r\nSpécialité cuisse de grenouille et Friture en juillet-août sur réservation 48h à l\"avance\r\nPlats végétariens\r\nRéservation obligatoire"
    ],
    "es": [
      "Banquete - comida familiar - comida de trabajadores\r\nEspecialidad en ancas de rana y frituras en julio y agosto, reservando con 48 horas de antelación\r\nPlatos vegetarianos\r\nEs necesario reservar"
    ],
    "nl": [
      "Banket - gezinsmaaltijd - arbeidersmaaltijd\r\nKikkerbout en gebakken voedsel specialiteit in juli en augustus, 48 uur van tevoren reserveren\r\nVegetarische gerechten\r\nReservering verplicht"
    ]
  },
