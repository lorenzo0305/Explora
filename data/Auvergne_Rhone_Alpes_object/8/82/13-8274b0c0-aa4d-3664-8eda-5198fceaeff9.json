  "rdfs:comment": {
    "de": [
      "Herberge im Mittelgebirge mit atemberaubendem Blick auf das Aulps-Tal. Restaurant mit traditioneller und großzügiger Küche, die regionale Produkte in den Vordergrund stellt."
    ],
    "en": [
      "A mid-mountain guesthouse offering stunning views of the Vallée d’Aulps. The restaurant has a traditional, hearty menu where the accent is on regional produce."
    ],
    "it": [
      "Locanda di montagna di media categoria con vista mozzafiato sulla Vallée d'Aulps. Ristorante che propone una cucina tradizionale e generosa con prodotti locali."
    ],
    "fr": [
      "Auberge de moyenne montagne avec vue imprenable sur la Vallée d'Aulps. restaurant proposant une cuisine traditionnelle et généreuse qui met en avant les produits régionaux."
    ],
    "es": [
      "Posada de montaña de categoría media con impresionantes vistas sobre el Valle de Aulps. Restaurante de cocina tradicional y generosa elaborada con productos locales."
    ],
    "nl": [
      "Middenklasse bergherberg met adembenemend uitzicht over de Vallée d'Aulps. Restaurant met traditionele, royale keuken met lokale producten."
    ]
  },
