  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/848e6569-334f-3d0d-8372-c7bb198695e5",
      "dc:description": {
        "de": [
          "Kreative Geschichten\nBald ist Weihnachten!\nHör dir diese Weihnachtsgeschichten an, bevor du deine hübsche Festtagsfabrikation herstellst!\n\n\n\nMediathek des Sandettie\nmittwoch, 4. Dezember, um 15 Uhr\nAb 5 Jahren\nKostenlos, nach Anmeldung"
        ],
        "en": [
          "Creative stories\nIt's almost Christmas!\nListen to these Christmas stories before creating your very own festive craft!\n\n\n\nMédiathèque du Sandettie\nwednesday, December 4, at 3pm\nAges 5 and up\nFree, registration required"
        ],
        "it": [
          "Storie creative\nÈ quasi Natale!\nAscoltate queste storie natalizie prima di creare i vostri lavoretti!\n\n\n\nBiblioteca multimediale Sandettie\nmercoledì 4 dicembre, ore 15.00\nDai 5 anni in su\nGratuito, su iscrizione"
        ],
        "fr": [
          "Histoires créatives\nC'est bientôt Noël !\nEcoute ces histoires de Noël avant de créer ta jolie fabrication de fête !\n\n\n\nMédiathèque du Sandettie\nmercredi 4 décembre, à 15h\nA partir de 5 ans\nGratuit, sur inscription"
        ],
        "es": [
          "Historias creativas\n¡Ya casi es Navidad!\nEscucha estos cuentos navideños antes de crear tu propia manualidad festiva\n\n\n\nBiblioteca multimedia Sandettie\nmiércoles 4 de diciembre, a las 15 h\nA partir de 5 años\nGratuito, previa inscripción"
        ],
        "nl": [
          "Creatieve verhalen\nHet is bijna Kerstmis!\nLuister naar deze kerstverhalen voordat je je eigen feestelijke knutselwerkje maakt!\n\n\n\nSandettie mediatheek\nwoensdag 4 december om 15.00 uur\nVanaf 5 jaar\nGratis, op inschrijving"
        ]
      },
      "@type": [
        "Description"
