  "rdfs:comment": {
    "de": [
      "Der Verein Ferme Theranima ist eine Struktur, die zahlreiche Reitaktivitäten vereint, die sich auf das Reiten im Freien und das Wohlbefinden der Equiden konzentrieren."
    ],
    "en": [
      "The Ferme Theranima association offers a wide range of equestrian activities, focusing on outdoor riding and equine well-being."
    ],
    "it": [
      "L'associazione Ferme Theranima offre un'ampia gamma di attività equestri, incentrate sull'equitazione all'aperto e sul benessere degli equini."
    ],
    "fr": [
      "L'association Ferme Theranima est une structure qui regroupe de multiples activités équestres, centrées sur l'équitation d'extérieur et le bien-être des équidés."
    ],
    "es": [
      "La asociación Ferme Theranima ofrece una amplia gama de actividades ecuestres, centradas en la equitación al aire libre y el bienestar equino."
    ],
    "nl": [
      "De vereniging Ferme Theranima biedt een breed scala aan ruiteractiviteiten, gericht op buitenritten en paardenwelzijn."
    ]
  },
