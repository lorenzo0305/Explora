  "rdfs:comment": {
    "de": [
      "Auf den Höhen von Champagny-en-Vanoise empfangen Sie drei Welten: Le Schuss für eine schicke Snackpause, die Lounge für Cocktails und Tapas und das Bistro für ein bistronomisches Erlebnis mit Blick auf die Gipfel."
    ],
    "en": [
      "On the heights of Champagny-en-Vanoise, three universes welcome you: the Schuss for a chic snacking break, the Lounge for cocktails & tapas, and the Bistro for a bistronomic experience facing the summits."
    ],
    "it": [
      "Sulle alture di Champagny-en-Vanoise vi aspettano tre mondi: lo Schuss per uno spuntino chic, la Lounge per cocktail e tapas e il Bistro per un'esperienza bistronomica con vista sulle vette."
    ],
    "fr": [
      "Sur les hauteurs de Champagny-en-Vanoise, trois univers vous accueillent : le Schuss pour une pause snacking chic, le Lounge pour savourer cocktails & tapas, et le Bistro pour une expérience bistronomique face aux sommets."
    ],
    "nl": [
      "Op de hoogten van Champagny-en-Vanoise wachten drie werelden op je: de Schuss voor een chique snackpauze, de Lounge voor cocktails en tapas en de Bistro voor een bistronomische ervaring met uitzicht op de bergtoppen."
    ],
    "es": [
      "En las alturas de Champagny-en-Vanoise, le esperan tres mundos: el Schuss para un tentempié chic, el Lounge para cócteles y tapas, y el Bistro para una experiencia bistronómica con vistas a las cumbres."
    ]
  },
