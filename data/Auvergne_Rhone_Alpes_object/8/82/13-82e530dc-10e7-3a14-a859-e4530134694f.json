  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen Gerichte aus aller Welt mit einem großen Anteil an lokalen Produkten: Gourmet-Burger, Brathähnchen am Spieß, Savoyer Spezialitäten, lokale Fleischsorten, köstliche Salate und Tagesvorschläge."
    ],
    "en": [
      "We offer dishes from all over the world, with an emphasis on local products: gourmet burgers, spit-roasted chicken, Savoyard specialities, local meats, delicious salads and daily specials."
    ],
    "it": [
      "Offriamo piatti da tutto il mondo con un'attenzione particolare ai prodotti locali: hamburger gourmet, pollo allo spiedo, specialità savoiarde, carni locali, insalate deliziose e specialità del giorno."
    ],
    "fr": [
      "Nous vous proposons des plats de tous horizons avec une belle place donnée aux produits locaux : burgers gourmands, poulets rôtis à la broche, spécialités savoyardes, viandes locales, délicieuses salades et propositions du jour."
    ],
    "nl": [
      "Wij bieden gerechten uit de hele wereld met een focus op lokale producten: gastronomische burgers, aan het spit geroosterde kip, Savoyaardse specialiteiten, lokaal vlees, heerlijke salades en dagschotels."
    ],
    "es": [
      "Ofrecemos platos de todo el mundo con un enfoque en los productos locales: hamburguesas gourmet, pollo asado, especialidades de Saboya, carnes locales, deliciosas ensaladas y especiales del día."
    ]
  },
