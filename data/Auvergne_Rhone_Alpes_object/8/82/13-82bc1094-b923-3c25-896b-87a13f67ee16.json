  "rdfs:comment": {
    "de": [
      "Die White Lounge verspricht Ihnen eine gemütliche und loungeartige Atmosphäre. Das gesamte Team wird Sie mit großem Vergnügen durch seine verschiedenen Tapas, Cocktails, Biere und Pizzen führen. Lassen Sie sich die Konzert- und DJ-Abende nicht entgehen."
    ],
    "en": [
      "The White Lounge offers you a cosy and lounge atmosphere. The whole team will make you discover with a great pleasure their selection of tapas, cocktails, beers and pizzas of course. Don't miss the concerts and DJ evenings !"
    ],
    "it": [
      "Il White Lounge promette un'atmosfera accogliente e lounge. L'intero team sarà lieto di aiutarvi a scoprire le diverse selezioni di tapas, cocktail, birre e pizze. Da non perdere le serate con musica dal vivo e DJ."
    ],
    "fr": [
      "Le White Lounge vous promet une ambiance cosy et lounge. Toute l'équipe vous fera découvrir avec un grand plaisir leurs différentes sélections de tapas, cocktails, bières ainsi que leurs pizzas. Ne passez pas à côté des soirées concerts et DJs."
    ],
    "es": [
      "El White Lounge promete un ambiente acogedor y de salón. Todo el equipo estará encantado de ayudarle a descubrir sus diferentes selecciones de tapas, cócteles, cervezas y pizzas. No se pierda las noches de música en directo y DJ."
    ],
    "nl": [
      "De White Lounge belooft u een gezellige en lounge sfeer. Het hele team zal u met veel plezier hun tapas, cocktails, verschillende bieren en hun pizza's laten ontdekken. Mis de concerten en DJ-avonden niet."
    ]
  },
