  "rdfs:comment": {
    "de": [
      "Das in einem Bergdorf im Herzen des Chartreuse-Massivs gelegene Hotel mit Panoramaterrasse empfängt Sie in einem freundlichen und familiären Geist."
    ],
    "en": [
      "Located in an alpine village, in the heart of the Chartreuse Massif, the hotel with its panoramic terrace welcomes you in a friendly and family spirit."
    ],
    "it": [
      "Situato in un villaggio di montagna, nel cuore del Massiccio della Chartreuse, l'hotel con la sua terrazza panoramica vi accoglie in un'atmosfera amichevole e familiare."
    ],
    "fr": [
      "Situé dans un village de montagne, au cœur du massif de la Chartreuse, l’hôtel  avec terrasse panoramique vous accueille dans un esprit convivial et familial."
    ],
    "es": [
      "Situado en un pueblo de montaña, en el corazón del macizo de la Chartreuse, el hotel con su terraza panorámica le da la bienvenida en un ambiente acogedor y familiar."
    ],
    "nl": [
      "Gelegen in een bergdorp, in het hart van het Chartreuse-massief, verwelkomt het hotel met zijn panoramisch terras u in een vriendelijke en familiale sfeer."
    ]
  },
