  "rdfs:comment": {
    "de": [
      "France Services ist eine Einrichtung, die den Zugang zu öffentlichen Dienstleistungen und zur digitalen Welt erleichtern soll.\r\nDie Mitarbeiter von France Services empfangen Sie und helfen Ihnen bei Ihren Behördengängen.\r\nComputer mit freiem Zugang."
    ],
    "en": [
      "France Services is a system designed to facilitate access to public services and digital technology.\r\nFrance Services agents welcome you and help you with your administrative formalities.\r\nFree computer access."
    ],
    "it": [
      "France Services è un programma volto a facilitare l'accesso ai servizi pubblici e alla tecnologia digitale.\r\nIl personale di France Services vi accoglierà e vi aiuterà a sbrigare le formalità amministrative.\r\nAccesso gratuito ai computer."
    ],
    "fr": [
      "France Services est un dispositif pour faciliter l'accès aux services publics et au numérique.\r\nLes agents France services vous accueillent et vous aident pour vos démarches administratives.\r\nOrdinateur en accès libre."
    ],
    "nl": [
      "France Services is een programma dat is ontworpen om de toegang tot openbare diensten en digitale technologie te vergemakkelijken.\r\nMedewerkers van France Services heten u welkom en helpen u met uw administratieve formaliteiten.\r\nGratis toegang tot computers."
    ],
    "es": [
      "France Services es un dispositivo destinado a facilitar el acceso a los servicios públicos y a las tecnologías digitales.\r\nEl personal de France Services le dará la bienvenida y le ayudará con sus trámites administrativos.\r\nAcceso gratuito a los ordenadores."
    ]
  },
