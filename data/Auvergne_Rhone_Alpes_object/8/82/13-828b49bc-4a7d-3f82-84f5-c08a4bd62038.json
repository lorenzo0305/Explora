  "rdfs:comment": {
    "de": [
      "Diese Wanderung, eine Kombination der Rundwege \"Les grands espaces sauvages\" und \"Le tour d'Angèle\", bietet Ihnen einen sehr umfassenden Einblick in das Pays de Nyons."
    ],
    "en": [
      "This Ride is a combination of the circuits \"The big wild spaces\" and \"Around Angèle\".  It will offer a complete view of the Pays de Nyons."
    ],
    "it": [
      "Questa passeggiata, una combinazione dei circuiti \"Les grands espaces sauvages\" e \"Le tour d'Angèle\", vi offrirà una visione molto completa del Pays de Nyons."
    ],
    "fr": [
      "Cette balade, une combinaison des circuits \"Les grands espaces sauvages\" et \"Le tour d'Angèle\", vous offrira une vue très complète du Pays de Nyons."
    ],
    "es": [
      "Este paseo, una combinación de los circuitos \"Les grands espaces sauvages\" y \"Le tour d'Angèle\", le ofrecerá una visión muy completa del Pays de Nyons."
    ],
    "nl": [
      "Deze uitstap kombineert de twee circuits \"grootse wilde ruimten\" en \"de toer van Angèle\""
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade culturelle en 2cv : le grand tour d'Angèle"
    ],
    "nl": [
      "Kulturele uitstap in tweepardje : de grote toer van Angèle"
    ]
  },
