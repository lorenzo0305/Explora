  "rdfs:comment": {
    "de": [
      "Möchten Sie einen Moment des Wohlbefindens und der Gelassenheit? Dieses auf den Höhen von Violay gelegene Institut heißt Sie in seinem Entspannungs- und Cocooning-Bereich willkommen, um Ihnen eine erholsame Pause und eine Reise der Sinne zu bieten."
    ],
    "en": [
      "Want a moment of well-being and serenity? This institute, located on the heights of Violay, welcomes you to its relaxation and cocooning space to offer you a relaxing break and a journey of the senses."
    ],
    "it": [
      "Cercate un momento di benessere e serenità? Questo istituto, situato sulle alture di Violay, vi accoglie nella sua area relax e cocooning per una pausa rilassante e un viaggio dei sensi."
    ],
    "fr": [
      "Envie d’un moment de bien-être, de sérénité ? Cet institut, situé sur les hauteurs de Violay, vous accueille dans son espace détente et cocooning pour vous offrir une pause relaxante et un voyage des sens."
    ],
    "es": [
      "¿Busca un momento de bienestar y serenidad? Este instituto, situado en las alturas de Violay, le da la bienvenida a su espacio relajante y cocooning para una pausa de relax y un viaje de los sentidos."
    ],
    "nl": [
      "Op zoek naar een moment van welzijn en sereniteit? Dit instituut, gelegen op de hoogten van Violay, verwelkomt je in zijn ontspannende en cocooning ruimte voor een ontspannende pauze en een reis van de zintuigen."
    ]
  },
