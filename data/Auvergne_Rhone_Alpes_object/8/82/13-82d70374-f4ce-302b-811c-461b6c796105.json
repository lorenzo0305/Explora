  "rdfs:comment": {
    "de": [
      "Die Domäne bietet zahlreiche Aktivitäten an: pädagogischer Bauernhof, Viehzucht, Zirkusschule, Zirkusvoltigierschule, Aufführungen, Geburtstagsparty, Tiervermittlung und Pferdearbeit."
    ],
    "en": [
      "The Domaine offers a wide range of activities: educational farm, breeding, circus school, circus acrobatics school, shows, birthday parties, animal mediation and horse work."
    ],
    "it": [
      "La tenuta offre una vasta gamma di attività: fattoria didattica, allevamento, scuola di circo, scuola di acrobazie circensi, spettacoli, feste di compleanno, mediazione animale e lavoro a cavallo."
    ],
    "fr": [
      "Le Domaine propose de nombreuses activités : ferme pédagogique, élevage, école de cirque, école de voltige de cirque, spectacles, goûter d'anniversaire, médiation animale et travail des chevaux."
    ],
    "es": [
      "La finca ofrece una amplia gama de actividades: granja educativa, cría, escuela de circo, escuela de acrobacia circense, espectáculos, fiestas de cumpleaños, mediación con animales y trabajo con caballos."
    ],
    "nl": [
      "Het landgoed biedt een breed scala aan activiteiten: educatieve boerderij, fokkerij, circusschool, circusacrobatiekschool, shows, verjaardagsfeestjes, dierenbemiddeling en paardenwerk."
    ]
  },
