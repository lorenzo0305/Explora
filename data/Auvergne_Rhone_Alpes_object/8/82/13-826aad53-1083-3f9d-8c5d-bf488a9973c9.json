  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant und SPA am Col de la Croix Perrin im Herzen des Waldes gelegen, mit einer Kapazität von 52 Innenplätzen. Terrasse mit einer bioklimatischen Pergola für 60 Personen im Sommer und Kaminecke (dreiseitig) im Winter."
    ],
    "en": [
      "Hotel/Restaurant and Spa located at Col de la Croix Perrin in the heart of the forest, with 52 seats inside. Terrace equipped with a bioclimatic pergola for 60 people in the summer and a fireplace area (triple-sided) in the winter."
    ],
    "it": [
      "Hotel-ristorante e SPA situato al passo della Croix Perrin, nel cuore della foresta, con una capacità interna di 52 posti. Terrazza attrezzata con una pergola bioclimatica per 60 persone in estate e un angolo camino (a tripla faccia) in inverno."
    ],
    "fr": [
      "Hôtel-Restaurant et SPA situé au col de la Croix Perrin au cœur de la forêt, d’une capacité de 52 couverts à l’intérieur. Terrasse équipée d’une pergola bioclimatique de 60 places l’été et coin cheminée (triple face) l’hiver."
    ],
    "es": [
      "Hotel-Restaurante y SPA situado en el puerto de la Croix Perrin, en el corazón del bosque, con una capacidad de 52 plazas en su interior. Terraza equipada con una pérgola bioclimática para 60 personas en verano y una chimenea (triple cara) en invierno."
    ],
    "nl": [
      "Hotel-Restaurant en SPA gelegen aan de Croix Perrin pas in het hart van het bos, met een capaciteit van 52 zitplaatsen binnen. Terras uitgerust met een bioklimatologische pergola voor 60 personen in de zomer en een open haard hoek (triple gezicht) in de winter."
    ]
  },
  "rdfs:label": {
    "de": [
      "Auberge de la Croix Perrin"
    ],
    "en": [
      "Auberge de la Croix Perrin"
    ],
    "fr": [
      "Auberge de la Croix Perrin"
    ]
  },
