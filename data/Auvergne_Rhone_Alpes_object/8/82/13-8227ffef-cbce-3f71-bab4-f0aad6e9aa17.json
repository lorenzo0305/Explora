  "rdfs:comment": {
    "de": [
      "In ihrem kleinen, authentischen Königreich, das sich in die Gassen von Vieil Alpe schmiegt, empfängt Sie Stéphanie mit Jovialität, um ihre traditionellen Pizzen zu probieren."
    ],
    "en": [
      "Discover this little kingdom tucked away in the streets of the old village (vieil Alpe) where Stéphanie your hostess will give you a warm and cheerful welcome."
    ],
    "it": [
      "Nel suo piccolo regno autentico immerso nelle stradine della Vieil Alpe, Stéphanie vi accoglierà con giovialità per farvi assaggiare le sue pizze tradizionali."
    ],
    "fr": [
      "Dans son petit royaume authentique niché dans les ruelles du Vieil Alpe, Stéphanie vous accueillera avec jovialité pour déguster ses pizzas traditionnelles."
    ],
    "nl": [
      "In haar authentieke koninkrijkje, verscholen in de smalle straatjes van Le Vieil Alpe, heet Stéphanie je van harte welkom om haar traditionele pizza's te proeven."
    ],
    "es": [
      "En su pequeño y auténtico reino enclavado en las estrechas calles del Vieil Alpe, Stéphanie le acogerá con jovialidad para que pruebe sus pizzas tradicionales."
    ]
  },
