  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b0085a8-35a3-352e-9010-9175e70ea65f",
      "dc:description": {
        "de": [
          "Geöffnet von Montagabend bis Samstagabend - Sonntag und Montagmittag geschlossen.\n\nBesteckaufnahme von 12h bis 14h und abends von 19h bis 22h\n\nPreis: 15? - 30?\n\nKarte ins Englische übersetzt\n\nGruppen von 10 bis 80 Personen werden akzeptiert.\nHaustiere erlaubt\n\n\nMetro 1 oder 2: Bahnhof Lille Flandres oder Metro 1: Rihour.\n\n\n\n "
        ],
        "en": [
          "Open Monday evening to Saturday evening - Closed Sunday and Monday lunchtime.\n\nCutlery service from 12pm to 2pm and in the evening from 7pm to 10pm\n\nPrice: 15? - 30?\n\nMenu translated into English\n\nGroups accepted from 10 to 80 people.\nPets welcome\n\n\nMetro 1 or 2: Gare Lille Flandres or Metro 1: Rihour.\n\n\n\n "
        ],
        "it": [
          "Aperto dal lunedì al sabato sera - Chiuso la domenica e il lunedì a pranzo.\n\nMenu fisso dalle 12.00 alle 14.00 e la sera dalle 19.00 alle 22.00\n\nPrezzo: 15? - 30?\n\nMenu tradotto in inglese\n\nSi accettano gruppi da 10 a 80 persone.\nAnimali domestici ammessi\n\n\nMetro 1 o 2: Gare Lille Flandres o Metro 1: Rihour.\n\n\n\n "
        ],
        "fr": [
          "Ouvert du lundi soir au samedi soir - Fermé le dimanche et lundi midi.\n\nPrise de couverts de 12h à 14h et le soir de 19h à 22h \n\nPrix : 15€ - 30€\n\nCarte traduite en anglais\n\nGroupes acceptés de 10 à 80 personnes.\nAnimaux acceptés\n\n\nMétro 1 ou 2 : Gare Lille Flandres ou Métro 1 : Rihour.\n\n\n\n "
        ],
        "nl": [
          "Geopend van maandag tot zaterdag 's avonds - Gesloten op zondag en maandag 's middags.\n\nMenu's van 12.00 tot 14.00 uur en 's avonds van 19.00 tot 22.00 uur\n\nPrijs: 15? - 30?\n\nMenu vertaald in het Engels\n\nGroepen van 10 tot 80 personen worden geaccepteerd.\nHuisdieren welkom\n\n\nMetro 1 of 2: Gare Lille Flandres of Metro 1: Rihour.\n\n\n\n "
        ],
        "es": [
          "Abierto de lunes a sábado por la noche - Cerrado domingos y lunes al mediodía.\n\nMenús de 12h a 14h y por la noche de 19h a 22h\n\nPrecio: 15? - 30?\n\nMenú traducido al inglés\n\nSe aceptan grupos de 10 a 80 personas\nSe admiten mascotas\n\n\nMetro 1 ó 2: Gare Lille Flandres o Metro 1: Rihour.\n\n\n\n "
        ]
      },
