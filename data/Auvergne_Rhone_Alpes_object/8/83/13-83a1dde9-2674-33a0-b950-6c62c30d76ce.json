  "rdfs:comment": {
    "de": [
      "Als diplomierte Fremdenführerin und Kulturvermittlerin biete ich Ihnen meine Spaziergänge durch die Zeit an Orten mit einem reichen architektonischen, kulturellen und landschaftlichen Erbe an."
    ],
    "en": [
      "As a qualified tour guide and cultural mediator, I can take you on walks through time in places with a rich architectural, cultural and landscape heritage."
    ],
    "it": [
      "Come guida turistica qualificata e mediatore culturale, posso accompagnarvi in passeggiate nel tempo in luoghi con un ricco patrimonio architettonico, culturale e paesaggistico."
    ],
    "fr": [
      "Guide conférencière et médiatrice culturelle diplômée, je vous propose mes balades à travers le temps dans des lieux au riche patrimoine architectural, culturel et paysager."
    ],
    "es": [
      "Como guía turístico cualificado y mediador cultural, puedo llevarle a pasear a través del tiempo por lugares con un rico patrimonio arquitectónico, cultural y paisajístico."
    ],
    "nl": [
      "Als gediplomeerd reisleider en cultureel bemiddelaar kan ik je meenemen op een wandeling door de tijd op plaatsen met een rijk architecturaal, cultureel en landschappelijk erfgoed."
    ]
  },
  "rdfs:label": {
