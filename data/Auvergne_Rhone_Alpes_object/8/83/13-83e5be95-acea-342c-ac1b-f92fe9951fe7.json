  "rdfs:comment": {
    "de": [
      "Finden Sie das Konzept L'endroit, nur wenige Schritte vom Grand Stade de l'Olympique Lyonnais entfernt, und genießen Sie hausgemachte Gerichte aus frischen Zutaten."
    ],
    "en": [
      "Find the L'endroit concept, just a stone's throw from the Olympique Lyonnais Grand Stadium and enjoy home-cooked meals made from fresh produce."
    ],
    "it": [
      "Scoprite il concetto di L'endroit, a pochi passi dallo stadio dell'Olympique Lyonnais, e gustate i pasti preparati in casa con prodotti freschi."
    ],
    "fr": [
      "Retrouvez le concept L'endroit, à deux pas du Grand Stade de l'Olympique Lyonnais et dégustez des plats cuisinés maison, réalisés à partir de produits frais."
    ],
    "nl": [
      "Ontdek het L'endroit concept, op een steenworp afstand van het Olympique Lyonnais stadion, en geniet van huisgemaakte maaltijden met verse producten."
    ],
    "es": [
      "Descubra el concepto L'endroit, a dos pasos del estadio del Olympique Lyonnais, y disfrute de la comida casera elaborada con productos frescos."
    ]
  },
