  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3bae754d-c1a6-3f0e-9221-a4409eeaaa4b",
      "dc:description": {
        "de": [
          "Das Maison de la Presse in Montreuil-sur-Mer ist ein lokales Multi-Service-Geschäft: Presse, Tabak, FDJ, Buchhandlung, Karterie, Schreibwarenladen...\n\nGeöffnet von Dienstag bis Samstag von 08:30 bis 12:30 Uhr und von 14:30 bis 19:00 Uhr, am Sonntag von 09:30 bis 12:00 Uhr."
        ],
        "en": [
          "The Maison de la Presse in Montreuil-sur-Mer is a local multi-service store: press, tobacco, FDJ, bookshop, stationery, stationery...\n\nOpen Tuesday to Saturday 08:30 to 12:30 and 14:30 to 19:00, Sunday 09:30 to 12:00."
        ],
        "it": [
          "La Maison de la Presse di Montreuil-sur-Mer è un negozio locale multiservizi: stampa, tabacchi, FDJ, libreria, cartoleria, ecc.\n\nAperto dal martedì al sabato dalle 08:30 alle 12:30 e dalle 14:30 alle 19:00, la domenica dalle 09:30 alle 12:00."
        ],
        "fr": [
          "La Maison de la Presse de Montreuil-sur-Mer est un commerce de proximité multi-services : presse, tabac, FDJ, librairie, carterie, papeterie...\n\nOuvert du mardi au samedi de 08h30 à 12h30 et de 14h30 à 19h00, le dimanche de 09h30 à 12h00."
        ],
        "es": [
          "La Maison de la Presse de Montreuil-sur-Mer es una tienda local multiservicios: prensa, tabaco, FDJ, librería, papelería, etc.\n\nAbre de martes a sábado de 08:30 a 12:30 y de 14:30 a 19:00, domingos de 09:30 a 12:00."
        ],
        "nl": [
          "Het Maison de la Presse in Montreuil-sur-Mer is een plaatselijke winkel met meerdere diensten: pers, tabak, FDJ, boekhandel, kantoorbenodigdheden, enz.\n\nGeopend van dinsdag tot zaterdag van 08.30 tot 12.30 uur en van 14.30 tot 19.00 uur, op zondag van 09.30 tot 12.00 uur."
        ]
      },
