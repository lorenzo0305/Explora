  "rdfs:comment": {
    "de": [
      "Das Haus Boissieux freut sich, Sie in seinem Geschäft begrüßen zu dürfen!\nHier finden Sie frische Trüffel (in der Saison), Tiefkühlkost und Fertiggerichte! Hier können Sie sich mit dem berühmten schwarzen Diamanten verwöhnen lassen!\nAuch Kosmetika auf Trüffelbasis werden angeboten!"
    ],
    "en": [
      "Maison Boissieux is delighted to welcome you to its boutique!\nYou'll find fresh truffles (in season), frozen foods and ready-made meals! Enough to treat yourself to the famous black diamond!\nTruffle-based cosmetics are also available!"
    ],
    "it": [
      "La Maison Boissieux è lieta di darvi il benvenuto nel suo negozio!\r\nTroverete tartufi freschi (in stagione), surgelati e piatti pronti! Abbastanza per concedersi il famoso diamante nero!\r\nSono disponibili anche cosmetici a base di tartufo!"
    ],
    "fr": [
      "La maison Boissieux est ravie de vous recevoir dans leur boutique ! \r\nRetrouvez truffes fraiches (en saison), surgelé et plats préparés ! De quoi vous régaler avec le fameux diamant noir !\r\nDes cosmétiques à base de truffes sont aussi proposées !"
    ],
    "nl": [
      "Maison Boissieux heet je van harte welkom in hun winkel!\nJe vindt er verse truffels (in het seizoen), diepgevroren en bereide gerechten! Genoeg om jezelf te trakteren op de beroemde zwarte diamant!\nEr is ook cosmetica op basis van truffels verkrijgbaar!"
    ],
    "es": [
      "La Maison Boissieux le da la bienvenida a su tienda\r\n¡Encontrará trufas frescas (en temporada), congelados y platos preparados! ¡Suficiente para darse un capricho con el famoso diamante negro!\r\nTambién hay cosméticos a base de trufa"
    ]
  },
  "rdfs:label": {
    "de": [
      "Der schwarze Diamant der Drome des Collines"
    ],
    "en": [
      "The Black Diamond of Drome des Collines"
    ],
    "fr": [
      "Le Diamant Noir de la Drome des Collines"
    ],
    "nl": [
      "De zwarte diamant van Drome des Collines"
    ]
  },
