  "rdfs:comment": {
    "de": [
      "Das Verkehrsnetz CHAMONIX MOBILITE ermöglicht es Ihnen, sich im Gebiet des Tals von Chamonix Mont-Blanc fortzubewegen, indem es die Schneefronten, die Weiler und die 4 Gemeinden Servoz, Les Houches, Chamonix und Vallorcine fein bedient."
    ],
    "en": [
      "The CHAMONIX MOBILITE transport network enables you to move around the Chamonix Mont-Blanc Valley, serving snow fronts, hamlets and the 4 communes of Servoz, Les Houches, Chamonix and Vallorcine."
    ],
    "it": [
      "La rete di trasporti CHAMONIX MOBILITE permette di spostarsi nella Valle del Monte Bianco di Chamonix, servendo i fronti di neve, le frazioni e i 4 comuni: Servoz, Les Houches, Chamonix e Vallorcine."
    ],
    "fr": [
      "Le réseau de transport CHAMONIX MOBILITE permet de vous déplacer sur le territoire de la Vallée de Chamonix Mont-Blanc en desservant finement les fronts de neiges, les hameaux et les 4 communes : Servoz, Les Houches, Chamonix et Vallorcine."
    ],
    "nl": [
      "Met het CHAMONIX MOBILITE vervoersnetwerk kun je je verplaatsen in de vallei van Chamonix Mont-Blanc via de sneeuwfronten, de gehuchten en de 4 gemeenten: Servoz, Les Houches, Chamonix en Vallorcine."
    ],
    "es": [
      "La red de transportes CHAMONIX MOBILITE le permite desplazarse por el valle de Chamonix Mont-Blanc dando servicio a los frentes de nieve, las aldeas y los 4 municipios: Servoz, Les Houches, Chamonix y Vallorcine."
    ]
  },
