  "rdfs:comment": {
    "de": [
      "Der See liegt auf 1100 m Höhe, hat eine Fläche von 2,5 ha und ist 4 m tief. Er wird von Rotaugen, Gründlingen, Karpfen, Schleien und Forellen bevölkert."
    ],
    "en": [
      "The lake lies at an altitude of 1100 m, covers 2.5 ha and is 4 m deep. It is stocked with roach, gudgeon, carp, tench and trout."
    ],
    "it": [
      "Il lago si trova a 1100 m di altitudine, con una superficie di 2,5 ettari e una profondità di 4 metri. È popolato da lasche, scorfani, carpe, tinche e trote."
    ],
    "fr": [
      "Le plan d'eau est situé à 1100 m  d'altitude, sa superficie est 2,5 ha et sa profondeur de 4 m. Il est peuplé de gardons, goujons, carpes, tanches et truites."
    ],
    "nl": [
      "Het meer ligt op 1100 m hoogte, heeft een oppervlakte van 2,5 ha en een diepte van 4 m. Het meer is gevuld met voorn, riviergrondel, karper, zeelt en forel."
    ],
    "es": [
      "El lago está situado a 1.100 m de altitud, tiene una superficie de 2,5 ha y una profundidad de 4 m. Está poblado de cucarachas, gobios, carpas, tencas y truchas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site de pêche du plan d'eau du Pré Cohadon à Murat le Quaire"
    ]
  },
