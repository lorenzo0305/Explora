  "rdfs:comment": {
    "de": [
      "Philippe Trincaz und sein Sohn Sébastien, begleitet von ihren Ehefrauen Christine und Karolina, heißen Sie in einer familiären und herzlichen Atmosphäre willkommen."
    ],
    "en": [
      "The hotel restaurant Fleur de Neige is situated in Chatel in an exceptional environment at the heart of the Portes du Soleil resort and the Abondance valley."
    ],
