  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in unserem gemütlichen Restaurant und Bar und bieten Ihnen traditionelle französische Küche (Spezialität: Charolais-Fleisch) in Charlieu, um Ihnen eine unvergessliche Erinnerung in unserem kleinen Zuhause zu hinterlassen!"
    ],
    "en": [
      "We welcome you to our friendly restaurant and bar in Charlieu, where we offer traditional French cuisine (specializing in Charolais meats) to give you a memorable stay in our little home!"
    ],
    "it": [
      "Vi diamo il benvenuto nel nostro accogliente ristorante e bar a Charlieu, dove proponiamo una cucina tradizionale francese (specializzata in carni Charolais) per regalarvi un soggiorno memorabile nella nostra piccola casa!"
    ],
    "fr": [
      "Nous vous accueillons dans notre restaurant et bar au cadre convivial en proposant une cuisine traditionnelle française (spécialité viandes charolaise) à Charlieu afin de vous laisser un nouvenir mémorable dans notre petit chez-nous !"
    ],
    "nl": [
      "We verwelkomen je in ons gezellige restaurant en bar in Charlieu, waar we je een traditionele Franse keuken aanbieden (gespecialiseerd in Charolais vlees) om je een onvergetelijk verblijf in ons kleine huis te bezorgen!"
    ],
    "es": [
      "Le damos la bienvenida a nuestro acogedor restaurante y bar de Charlieu, donde le ofrecemos cocina tradicional francesa (especializada en carnes de Charolais) para que pase una estancia inolvidable en nuestra pequeña casa"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Sornin"
    ]
  },
