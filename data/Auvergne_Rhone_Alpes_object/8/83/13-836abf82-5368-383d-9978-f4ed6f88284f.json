  "rdfs:comment": {
    "de": [
      "Der Club freut sich, Sie bei der nächsten Ausgabe der Chemins de Chatu begrüßen zu dürfen! Es werden Ihnen drei Strecken sowie zwei Kinderstrecken angeboten. Diese solidarische Veranstaltung unterstützt den Verein Coala 26 und wird den Blauen März ins rechte Licht rücken."
    ],
    "en": [
      "The club invites you to the next edition of the Chemins de Chatu! Three trails and two children's trails are on offer. This solidarity event supports the Coala 26 association and will highlight Mars Bleu."
    ],
    "it": [
      "Il club vi invita alla prossima edizione dei Chemins de Chatu! Ci saranno tre percorsi tra cui scegliere, più due per i bambini. Questo evento benefico sostiene l'associazione Coala 26 e metterà sotto i riflettori il Mars Bleu."
    ],
    "fr": [
      "Le club vous donne rendez-vous pour la prochaine édition des Chemins de Chatu ! Trois parcours vous sont proposés ainsi que deux parcours enfants. Cet événement solidaire soutient l'association Coala 26 et mettra en lumière Mars Bleu."
    ],
    "es": [
      "¡El club te invita a la próxima edición de los Chemins de Chatu! Habrá tres recorridos para elegir, más dos para niños. Este evento benéfico apoya a la asociación Coala 26 y pondrá el foco de atención en Mars Bleu."
    ],
    "nl": [
      "De club nodigt je uit voor de volgende editie van de Chemins de Chatu! Er zijn drie routes om uit te kiezen, plus twee voor kinderen. Dit liefdadigheidsevenement steunt de vereniging Coala 26 en zet Mars Bleu in de schijnwerpers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les chemins de Chatu"
    ]
  },
