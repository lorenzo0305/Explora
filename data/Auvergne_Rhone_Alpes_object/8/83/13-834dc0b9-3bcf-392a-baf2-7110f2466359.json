  "rdfs:comment": {
    "de": [
      "Die archäologische Stätte von Saint-Romain-en-Gal ist eine der größten Ensembles der gallorömischen Zivilisation in Frankreich."
    ],
    "en": [
      "The Saint-Romain-en-Gal archaeological site is one of the biggest in France devoted to Gallo-Roman civilisation. The museum is at the heart of a 7-hectare cultural park that has brought new life to this residential district in Vienne."
    ],
    "it": [
      "Il sito archeologico di Saint-Romain-en-Gal è una delle più grandi collezioni dedicate alla civiltà gallo-romana in Francia. Il Museo si trova nel cuore di un parco culturale di 7 ettari, che fa rivivere la zona residenziale di Vienna."
    ],
    "fr": [
      "Le site Archéologique de Saint-Romain-en-Gal constitue l'un des plus grands ensembles consacrés à la civilisation gallo-romaine en France. \r\nLe musée est situé au cœur d'un parc culturel de 7 hectares qui fait revivre ce quartier résidentiel de Vienne."
    ],
    "es": [
      "El sitio arqueológico de Saint-Romain-en-Gal constituye uno de los mayores conjuntos dedicados a la civilización galorromana en Francia. El museo se encuentra dentro de un parque cultural de 7 hectáreas que da vida a este barrio residencial de Vienne."
    ],
    "nl": [
      "De archeologische site van Saint-Romain-en-Gal is een van de grootste complexen gewijd aan de Gallo-Romeinse beschaving in Frankrijk.\r\nHet museum ligt in het hart van een 7 hectare groot cultureel park dat deze woonwijk van Vienne weer tot leven brengt."
    ]
  },
  "rdfs:label": {
    "de": [
