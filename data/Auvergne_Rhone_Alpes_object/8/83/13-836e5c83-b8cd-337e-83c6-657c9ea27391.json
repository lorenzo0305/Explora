  "rdfs:comment": {
    "de": [
      "Beheiztes Freibad, das während der Sommermonate geöffnet ist. Es verfügt über zwei Becken, einen Imbiss und eine \"Solarium\"-Terrasse zum Ausruhen. Fußgängerzugang (gefahrlos) vom städtischen Campingplatz aus."
    ],
    "en": [
      "Heated outdoor swimming pool open during the summer. It has two pools, a refreshment bar, a mini-golf course and a \"solarium\" terrace for relaxing. Safe pedestrian access from the municipal campsite."
    ],
    "it": [
      "Piscina esterna riscaldata aperta durante i mesi estivi. Dispone di due vasche, un bar e una terrazza \"solarium\" per il relax. Accesso pedonale (sicuro) dal campeggio comunale."
    ],
    "fr": [
      "Piscine de plein air, chauffée et ouverte pendant la période estivale. Elle dispose de deux bassins, d'une buvette et d'une terrasse \"solarium\"  pour se reposer. Accès piétonnier (sans danger) à partir du camping municipal."
    ],
    "nl": [
      "Verwarmd buitenzwembad geopend tijdens de zomermaanden. Het heeft twee zwembaden, een verfrissingsbar en een \"solarium\" terras om te ontspannen. Toegang voor voetgangers (veilig) vanaf de gemeentelijke camping."
    ],
    "es": [
      "Piscina exterior climatizada abierta durante los meses de verano. Dispone de dos piscinas, un bar de refrescos y una terraza \"solarium\" para relajarse. Acceso peatonal (seguro) desde el camping municipal."
    ]
  },
  "rdfs:label": {
    "en": [
      "Municipal swimming pool"
    ],
    "fr": [
      "Piscine municipale"
    ]
  },
