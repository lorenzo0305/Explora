  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9a42eb3b-716d-3896-8578-32b02b187ac0",
      "dc:description": {
        "de": [
          "Lektionen Solo Practice\n40 Min\nPauschale für 5 Lektionen möglich\n\nLektionen Practice Duo\n40 Minuten\n\nCoaching Parcours\n80 Minuten = Solo 80? und Duo 50 ?/Pers\n2 Stunden = 120 ? im Duo\n18 Löcher = Mich kontaktieren\n \nGruppenlektionen 90min\nVon 3 bis 6 Personen\nÜbungsbälle nicht inbegriffen\n \nEinführung Gruppe / Gesellschaft\n90min Üben/Putting\nmax. 15 Pers\nMaterial und Übungsbälle inbegriffen"
        ],
        "en": [
          "Solo Practice Lessons\n40 minutes\nPackage of 5 lessons available\n\nPractice Duo\n40 minutes\n\nCourse Coaching\n80 Minutes = Solo 80 ? and Duo 50 ?/pers\n2 Hours = 120 ? for Duo\n18 Holes = Contact me\n \nGroup Lessons 90min\nFrom 3 to 6 people\nDriving range balls not included\n \nGroup / Company Initiation\n90min Practice/Putting\n15 people max\nEquipment and practice balls included"
        ],
        "it": [
          "Lezioni di pratica in solitaria\n40 minuti\nPacchetto di 5 lezioni disponibile\n\nPratica in duo\n40 minuti\n\nCorso di formazione\n80 minuti = Solo 80 ? e Duo 50 ?\n2 Ore = 120 ? in Duo\n18 Buche = Contattatemi\n \nLezioni di gruppo 90min\nDa 3 a 6 persone\nLe palline del campo pratica non sono incluse\n \nLezione di gruppo/azienda\n90min Pratica/Putting\n15 persone al massimo\nAttrezzatura e palline di pratica incluse"
        ],
        "fr": [
          "Leçons Practice Solo\n40 Minutes\nForfait 5 leçons possible\n\nLeçons Practice Duo\n40 Minutes \n\nCoaching Parcours\n80 Minutes = Solo 80 € et Duo 50 €/pers\n2 Heures = 120 €  en Duo\n18 Trous = Me contacter\n \nLeçons Collectives 90min\nDe 3 à 6 personnes\nBalles de practice non incluses\n \nInitiation Groupe / Société\n90min Practice/Putting\n15 pers maxi \nMatériel et balles de practice inclus"
        ],
        "nl": [
          "Solo praktijklessen\n40 minuten\n5 lessen pakket beschikbaar\n\nPraktijk Duo\n40 minuten\n\nCursus begeleiding\n80 Minuten = Solo 80 ? en Duo 50 ?\n2 uur = 120 minuten in Duo\n18 Holes = Neem contact met mij op\n \nGroepslessen 90min\nVan 3 tot 6 personen\nDriving range ballen niet inbegrepen\n \nGroep / Bedrijfsinitiatie\n90min Oefenen/Putting\n15 personen max\nUitrusting en oefenballen inbegrepen"
        ],
        "es": [
          "Clases prácticas en solitario\n40 minutos\nPaquete de 5 lecciones disponible\n\nPráctica Dúo\n40 minutos\n\nCurso Coaching\n80 Minutos = Solo 80€ y Dúo 50€ /pers\n2 Horas = 120€ en Dúo\n18 Hoyos = Contacta conmigo\n \nClases en Grupo 90min\nDe 3 a 6 personas\nBolas de prácticas no incluidas\n \nGrupo / Empresa Iniciación\n90min Práctica/Put\n15 personas máximo\nEquipamiento y bolas de práctica incluidos"
        ]
      },
