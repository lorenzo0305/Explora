          "additionalInformation": {
            "de": [
              "Von Sonntagabend bis einschließlich Dienstagmittag geschlossen\r\nMittagsservice: von 12:00 bis 13:15 Uhr (Mittwoch, Donnerstag), von 12:00 bis 13:30 Uhr (Freitag, Samstag, Sonntag)\r\nService Abendessen: von 19:00 bis 20:15 Uhr (Dienstag, Donnerstag), von 19:00 bis 20:00 Uhr (Mittwoch), von 19:00 bis 21:15 Uhr (Freitag), von 19:00 bis 21:30 Uhr (Samstag)\r\nGeschlossen in den letzten 2 Wochen im November"
            ],
            "en": [
              "Closed from Sunday evening to Tuesday lunchtime inclusive\r\nLunch service: 12pm to 1:15pm (Wednesday, Thursday), 12pm to 1:30pm (Friday, Saturday, Sunday)\r\nDinner service: 7pm to 8:15pm (Tuesday, Thursday), 7pm to 8pm (Wednesday), 7pm to 9:15pm (Friday), 7pm to 9:30pm (Saturday)\r\nClosed the last 2 weeks of November"
            ],
            "it": [
              "Chiuso dalla domenica sera al martedì a pranzo compreso\r\nServizio pranzo: dalle 12.00 alle 13.15 (mercoledì, giovedì), dalle 12.00 alle 13.30 (venerdì, sabato, domenica)\r\nServizio cena: dalle 19.00 alle 20.15 (martedì, giovedì), dalle 19.00 alle 20.00 (mercoledì), dalle 19.00 alle 21.15 (venerdì), dalle 19.00 alle 21.30 (sabato)\r\nChiuso le ultime 2 settimane di novembre"
            ],
            "fr": [
              "Fermé du dimanche soir au mardi midi inclus \r\nService déjeuner : de 12h à 13h15 (mercredi, jeudi), de 12h à 13h30 (vendredi, samedi, dimanche)\r\nService dîner : de 19h à 20h15 (mardi, jeudi), de 19h à 20h (mercredi), de 19h à 21h15 (vendredi), de 19h à 21h30 (samedi)\r\nFermé les 2 dernières semaines de novembre"
            ],
            "nl": [
              "Gesloten van zondagavond tot en met dinsdagmiddag\r\nLunchservice: 12.00 tot 13.15 uur (woensdag, donderdag), 12.00 tot 13.30 uur (vrijdag, zaterdag, zondag)\r\nDiner: 19.00 tot 20.15 uur (dinsdag, donderdag), 19.00 tot 20.00 uur (woensdag), 19.00 tot 21.15 uur (vrijdag), 19.00 tot 21.30 uur (zaterdag)\r\nDe laatste 2 weken van november gesloten"
            ],
            "es": [
              "Cerrado del domingo por la noche al martes al mediodía inclusive\r\nServicio de comidas: de 12.00 a 13.15 h (miércoles y jueves), de 12.00 a 13.30 h (viernes, sábado y domingo)\r\nServicio de cena: de 19.00 a 20.15 h (martes y jueves), de 19.00 a 20.00 h (miércoles), de 19.00 a 21.15 h (viernes), de 19.00 a 21.30 h (sábado)\r\nCerrado las 2 últimas semanas de noviembre"
            ]
          },
