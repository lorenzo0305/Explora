  "rdfs:comment": {
    "de": [
      "Mit der Alpin-Gondelbahn gelangen Sie auf das Plateau du Bettex in 1450 m Höhe. Dort oben genießen Sie sommers wie winters das atemberaubende Panorama des Mont Blanc."
    ],
    "en": [
      "The Alpin gondola lift takes you up to the Plateau du Bettex at an altitude of 1450 metres. Up there, in summer and winter alike, you can enjoy breathtaking panoramic views of Mont Blanc."
    ],
    "it": [
      "La cabinovia Alpin vi porta sul Plateau du Bettex a 1450 metri di altitudine. Lassù, sia in estate che in inverno, si può godere di una vista panoramica mozzafiato sul Monte Bianco."
    ],
    "fr": [
      "La télécabine de l'Alpin vous permet d'accéder au Plateau du Bettex à 1450 mètres d'altitude. Là-haut, été comme hiver vous profiterez du panorama époustouflant sur le Mont Blanc."
    ],
    "es": [
      "El teleférico Alpin le lleva hasta el Plateau du Bettex, a 1.450 metros de altitud. Allí arriba, tanto en verano como en invierno, podrá disfrutar de unas vistas impresionantes del Mont Blanc."
    ],
    "nl": [
      "De Alpin kabelbaan brengt je naar het Plateau du Bettex op 1450 meter hoogte. Daarboven kun je zowel in de zomer als in de winter genieten van een adembenemend uitzicht op de Mont Blanc."
    ]
  },
  "rdfs:label": {
    "en": [
      "Gondola l'Alpin - Saint-Gervais/Le Bettex"
    ],
    "it": [
      "Gondola l'Alpin - Saint-Gervais/Le Bettex"
    ],
    "fr": [
      "Télécabine de l'Alpin - Saint-Gervais/Le Bettex"
    ]
  },
