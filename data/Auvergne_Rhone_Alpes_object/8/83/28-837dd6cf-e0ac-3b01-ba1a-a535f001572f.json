      "dc:description": {
        "de": [
          "Familienbetrieb mit der Möglichkeit von Führungen: Entdecken Sie die Schur, das Sortieren der Wolle bis hin zum Endprodukt. Mit dem Label \"Bienvenue à la ferme\" ausgezeichnet."
        ],
        "en": [
          "Family-run farm with guided tours: discovery of shearing, wool sorting and the finished product. Welcome to the farm label."
        ],
        "it": [
          "Fattoria a conduzione familiare con visite guidate al processo di tosatura, alla selezione della lana e al prodotto finito. Benvenuti nel marchio della fattoria."
        ],
        "fr": [
          "Exploitation familiale avec possibilité de visites guidées : découverte de la tonte, du tri de la laine, jusqu'au produit fini. Labellisée Bienvenue à la ferme."
        ],
        "es": [
          "Granja familiar con visitas guiadas al proceso de esquileo, clasificación de la lana y producto acabado. Bienvenido a la etiqueta de la granja."
        ],
        "nl": [
          "Familieboerderij met rondleidingen door het scheerproces, het sorteren van de wol en het eindproduct. Welkom op het boerderijlabel."
        ]
      },
