          "additionalInformation": {
            "de": [
              "Besichtigung des Melkens der Kühe täglich von 6 bis 7 Uhr und von 15:30 bis 16:30 Uhr.\r\nBesuch der Herstellung von 8 bis 9 Uhr und von 17:30 bis 18:30 Uhr (außer sonntags: keine Herstellung)."
            ],
            "en": [
              "Visit the milking center every day from 6 to 7 am and from 3:30 to 4:30 pm.\r\nVisit the production facility from 8am to 9am and from 5:30pm to 6:30pm (except Sunday: no production)."
            ],
            "it": [
              "Visita alla sala di mungitura tutti i giorni dalle 6 alle 7 e dalle 15.30 alle 16.30.\r\nVisita al caseificio dalle 8.00 alle 9.00 e dalle 17.30 alle 18.30 (tranne la domenica: non si produce)."
            ],
            "fr": [
              "Visite de la traite des vaches tous les jours de 6h à 7h et de 15h30 à 16h30.\r\nVisite de la fabrication de 8h à 9h et de 17h30 à 18h30 (sauf le dimanche : pas de fabrication)."
            ],
            "es": [
              "Visite la sala de ordeño todos los días de 6.00 a 7.00 h. y de 15.30 a 16.30 h.\r\nVisita la quesería de 8:00 a 9:00 y de 17:30 a 18:30 (excepto el domingo: no hay producción)."
            ],
            "nl": [
              "Bezoek de melkstal elke dag van 6 tot 7 uur en van 15.30 tot 16.30 uur.\r\nBezoek de kaasmakerij van 8.00 tot 9.00 uur en van 17.30 tot 18.30 uur (behalve zondag: geen productie)."
            ]
          },
