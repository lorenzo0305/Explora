  "rdfs:comment": {
    "de": [
      "Die Compagnie Générale de Navigation bietet jeden Sommer Dampferfahrten auf dem Genfersee an. Von Yvoire aus können Sie in Richtung Genf, Nyon und Lausanne fahren."
    ],
    "en": [
      "Every summer, Compagnie Générale de Navigation offers steamboat cruises on Lake Geneva. Departing from Yvoire, you can sail to Geneva, Nyon and Lausanne."
    ],
    "it": [
      "Ogni estate, la Compagnie Générale de Navigation offre crociere in battello a vapore sul Lago di Ginevra. Da Yvoire si può navigare verso Ginevra, Nyon e Losanna."
    ],
    "fr": [
      "La Compagnie Générale de Navigation propose tous les étés des croisières en bateau à vapeur sur le lac Léman. Au départ d'Yvoire, vous pourrez naviguez en direction de Genève, Nyon et Lausanne."
    ],
    "es": [
      "Todos los veranos, la Compagnie Générale de Navigation ofrece cruceros en barco de vapor por el lago Lemán. Desde Yvoire, puede navegar hasta Ginebra, Nyon y Lausana."
    ],
    "nl": [
      "Elke zomer biedt de Compagnie Générale de Navigation stoombootcruises aan op het meer van Genève. Vanuit Yvoire kunt u naar Genève, Nyon en Lausanne varen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kreuzfahrt auf einem Belle-Epoque-Schiff mit der CGN ab Yvoire"
    ],
    "en": [
      "Belle Epoque boat cruise with CGN departing from Yvoire"
    ],
    "fr": [
      "Croisière en bateau Belle Epoque avec la CGN au départ d'Yvoire"
    ]
  },
