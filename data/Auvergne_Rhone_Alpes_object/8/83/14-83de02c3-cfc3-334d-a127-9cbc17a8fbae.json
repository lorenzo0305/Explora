  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/63fbaeb0-9773-3785-aba1-360f4a2cfbc5",
      "dc:description": {
        "de": [
          "China\nSt. Etienne-au-Mont Gemeindefriedhof?\nGemeindefriedhof von St -Etiene au Mont ? RD 940\n\nAb 1916 rekrutierte die britische Armee chinesische Bauern für logistische Aufgaben in ihren Lagern in Frankreich. Am Ende des Konflikts halfen die Männer des Chinese Labour Corps bei der Minenräumung und der Beerdigung von gefallenen Soldaten auf dem Schlachtfeld."
        ],
        "en": [
          "China\nSt. Etienne-au-Mont Communal Cemetery\nCimetière communal de Saint -Etiene au Mont ? RD 940\n\nFrom 1916, the British army recruited Chinese peasants for logistical tasks in its camps in France. By the end of the war, Chinese Labour Corps men were helping to clear land of mines and bury soldiers who had died on the battlefield."
        ],
        "it": [
          "Cina\nCimitero comunale di St. Etienne-au-Mont\nCimitero comunale di Saint-Etiene au Mont ? RD 940\n\nDal 1916, l'esercito britannico reclutò contadini cinesi per compiti logistici nei suoi campi in Francia. Alla fine della guerra, gli uomini del Corpo del lavoro cinese aiutavano a liberare i terreni dalle mine e a seppellire i soldati morti sul campo di battaglia."
        ],
        "fr": [
          "Chine\nSt. Etienne-au-Mont Communal Cemetery\nCimetière communal de Saint -Etiene au Mont – RD 940\n\nA partir de 1916, l’armée britannique recrute des paysans chinois pour les tâches logistiques dans ses camps en France. A la fin du conflit, les hommes du Chinese Labour Corps participeront au déminage des sols et à l’ensevelissement des soldats morts sur le champ de bataille."
        ],
        "nl": [
          "China\nGemeenschappelijke begraafplaats St. Etienne-au-Mont\nGemeenschappelijke begraafplaats Saint-Etienne-au-Mont ? RD 940\n\nVanaf 1916 rekruteerde het Britse leger Chinese boeren voor logistieke taken in de kampen in Frankrijk. Tegen het einde van de oorlog hielpen de mannen van het Chinese arbeiderskorps met het mijnenvrij maken van land en het begraven van soldaten die op het slagveld gesneuveld waren."
        ],
        "es": [
          "China\nCementerio Comunal de Saint -Etiene-au-Mont\nCementerio Comunal de Saint -Etiene au Mont ? RD 940\n\nA partir de 1916, el ejército británico reclutó a campesinos chinos para tareas logísticas en sus campamentos de Francia. Al final de la guerra, los hombres del Chinese Labour Corps ayudaban a limpiar el terreno de minas y a enterrar a los soldados que habían muerto en el campo de batalla."
        ]
      },
