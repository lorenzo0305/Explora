  "rdfs:comment": {
    "de": [
      "Der geniale Pianist, Komponist und Improvisator Jean-François Zygel bietet an diesem Wochenende eine Reise in die Welt der Emotionen, die durch Musik hervorgerufen werden: \"Le Pouvoir de la Musique\" in Vichy und ein Recital rund um die Fabeln von La Fontaine in Thiers."
    ],
    "en": [
      "Pianist, composer and improviser of genius, Jean-François Zygel takes us on a journey to the heart of the emotions aroused by music: \"Le Pouvoir de la Musique\" in Vichy and a recital of the fables of La Fontaine in Thiers."
    ],
    "it": [
      "Pianista, compositore e improvvisatore di genio, Jean-François Zygel ci accompagna in un viaggio al cuore delle emozioni suscitate dalla musica questo fine settimana con \"Le Pouvoir de la Musique\" a Vichy e un recital basato sulle favole di La Fontaine a Thiers."
    ],
    "fr": [
      "Pianiste, compositeur et improvisateur de génie, Jean-François Zygel nous propose durant ce week-end, un voyage au cœur des émotions suscitées par la musique \"Le Pouvoir de la Musique\" à Vichy et un récital autour des fables de la Fontaine à Thiers."
    ],
    "es": [
      "Pianista, compositor e improvisador genial, Jean-François Zygel nos lleva este fin de semana al corazón de las emociones suscitadas por la música con \"Le Pouvoir de la Musique\" en Vichy y un recital basado en las fábulas de La Fontaine en Thiers."
    ],
    "nl": [
      "Pianist, componist en geniaal improvisator Jean-François Zygel neemt ons dit weekend mee op reis naar het hart van de emoties die muziek oproept met \"Le Pouvoir de la Musique\" in Vichy en een recital gebaseerd op de fabels van La Fontaine in Thiers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Un week-end avec Jean-François Zygel"
    ]
  },
