  "rdfs:comment": {
    "de": [
      "\"L'Annexe\" bietet Ihnen: Pizzas, Burger, Snacks zum Mitnehmen.\r\nZahlreiche Angebote: Burger des Chefs mit Pommes frites und Wasser (50cl) oder Burger + Pommes frites + Dessert + Getränk, usw. ... Pizzas auf Tomaten- oder Sahnebasis.\r\nDessert nach Wahl:4?"
    ],
    "en": [
      "\"L'Annexe\" offers: pizzas, burgers, takeaway snacks"
    ],
    "it": [
      "\"L'Annexe\" offre pizze, hamburger e snack da asporto.\r\nNumerose formule: hamburger dello chef con patatine e 50cl di acqua o hamburger + patatine+dessert+bevanda, ecc... Pizze al pomodoro o alla crema.\r\nScelta di dessert: 4?"
    ],
    "fr": [
      "\"L'Annexe\" vous propose: pizzas, burgers, snacking à emporter.\r\nNombreuses formules: burger du chef avec frites et eau 50cl ou burger + frites+dessert+boisson, etc ... Pizzas base tomate ou crème.\r\nDessert au choix:4€"
    ],
    "es": [
      "\"L'Annexe\" ofrece pizzas, hamburguesas y aperitivos para llevar.\r\nNumerosas fórmulas: hamburguesa del chef con patatas fritas y 50 cl de agua o hamburguesa + patatas fritas+postre+bebida, etc... Pizzas a base de tomate o nata.\r\nElección de postres:4?"
    ],
    "nl": [
      "\"L'Annexe\" biedt pizza's, hamburgers en meeneemsnacks.\r\nTalrijke formules: hamburger van de chef met frietjes en 50cl water of hamburger + frietjes+dessert+drank, enz ... Pizza's op basis van tomaten of room.\r\nKeuze uit desserts:4?"
    ]
  },
