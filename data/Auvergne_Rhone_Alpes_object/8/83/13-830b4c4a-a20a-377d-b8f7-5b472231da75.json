  "rdfs:comment": {
    "de": [
      "Escape Game für Familien. Parcours im Freien. Der Ausbruch des Aztekenvulkans Tétultcan, einer Quelle für lebenswichtiges Gold, ist fehlgeschlagen. Das Imperium ist bedroht. Es liegt an Ihnen, das Geheimnis des Vulkans zu lüften. Wird mit einem Mobiltelefon gespielt."
    ],
    "en": [
      "Family Escape game. Outdoor course. The eruption of the Aztec volcano Tetultcan, source of vital gold, has failed. The empire is threatened. It's up to you to solve the volcano's secret. Can be played with a cell phone."
    ],
    "it": [
      "Gioco di fuga per famiglie. Percorso all'aperto. L'eruzione del vulcano azteco Tetultcan, fonte vitale di oro, è fallita. L'impero è in pericolo. Sta a voi risolvere il segreto del vulcano. Giocato con un telefono cellulare."
    ],
    "fr": [
      "Escape game familial. Parcours en extérieur. L'éruption du volcan Aztèque Tétultcan, source d'or vital a échoué. L'empire est menacé. À vous de résoudre le secret du volcan. Se joue avec un téléphone portable."
    ],
    "nl": [
      "Ontsnappingsspel voor het hele gezin. Buitenparcours. De uitbarsting van de Azteekse vulkaan Tetultcan, een vitale bron van goud, is mislukt. Het rijk wordt bedreigd. Het is aan jou om het geheim van de vulkaan op te lossen. Gespeeld met een mobiele telefoon."
    ],
    "es": [
      "Juego de escape familiar. Recorrido al aire libre. La erupción del volcán azteca Tetultcan, una fuente vital de oro, ha fallado. El imperio está amenazado. De ti depende resolver el secreto del volcán. Se juega con un teléfono móvil."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le secret du volcan"
    ]
  },
