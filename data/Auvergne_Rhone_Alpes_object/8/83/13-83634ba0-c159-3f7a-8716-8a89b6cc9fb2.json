  "rdfs:comment": {
    "de": [
      "Anne und Jean Marc Troncy empfangen Sie in einem Gewölbekeller aus goldenen Steinen, der auf einen angenehmen Hof hinausgeht, um ihre Produktion von rotem, weißem und roséfarbenem Beaujolais, Chénas, Moulin à Vent und Perlwein zu verkosten."
    ],
    "en": [
      "Anne and Jean Marc Troncy welcome you in a vaulted cellar of golden stones overlooking a pleasant courtyard to taste their production of red, white, rosé Beaujolais, as well as Chénas, Moulin à Vent and sparkling wine."
    ],
    "it": [
      "Anne e Jean Marc Troncy vi accolgono in una cantina a volta di pietre dorate che si affaccia su un piacevole cortile per degustare la loro produzione di Beaujolais rosso, bianco e rosé, Chénas, Moulin à Vent e spumante."
    ],
    "fr": [
      "Anne et Jean Marc Troncy vous accueillent dans une cave voutée en pierres dorées donnant sur une cour agréable pour déguster leur production de Beaujolais rouge, blanc, rosé, Chénas, Moulin à Vent et vin pétillant."
    ],
    "es": [
      "Anne y Jean Marc Troncy le dan la bienvenida en una bodega abovedada de piedras doradas que da a un agradable patio para que pruebe su producción de Beaujolais tinto, blanco y rosado, Chénas, Moulin à Vent y vino espumoso."
    ],
    "nl": [
      "Anne en Jean Marc Troncy verwelkomen u in een gewelfde kelder van gouden stenen met uitzicht op een aangename binnenplaats om hun productie van rode, witte en rosé Beaujolais, Chénas, Moulin à Vent en mousserende wijn te proeven."
    ]
  },
  "rdfs:label": {
