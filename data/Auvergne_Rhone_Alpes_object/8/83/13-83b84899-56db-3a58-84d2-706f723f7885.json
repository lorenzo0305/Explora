  "rdfs:comment": {
    "de": [
      "Mit Evolution 2 Val d'Isère: Machen Sie eine Fahrt mit dem Elektro-Mountainbike im Herzen von Val d'Isère, auf Panoramapfaden zwischen Wäldern, Fluss und Bergen."
    ],
    "en": [
      "With Evolution 2 Val d'Isère: set off on an electric mountain bike ride in the heart of Val d'Isère, on scenic trails through forests, rivers and mountains."
    ],
    "it": [
      "Con Evolution 2 Val d'Isère: partite per un'escursione in mountain bike elettrica nel cuore di Val d'Isère, su sentieri panoramici tra boschi, fiumi e montagne."
    ],
    "fr": [
      "Avec Evolution 2 Val d’Isère : partez pour une balade en VTT électrique au cœur de Val d’Isère, sur des sentiers panoramiques entre forêts, rivière et montagnes."
    ],
    "nl": [
      "Met Evolution 2 Val d'Isère: maak een elektrische mountainbiketocht in het hart van Val d'Isère, over panoramische paden tussen bossen, rivieren en bergen."
    ],
    "es": [
      "Con Evolution 2 Val d'Isère: láncese a un paseo en bicicleta de montaña eléctrica en el corazón de Val d'Isère, por senderos panorámicos entre bosques, río y montañas."
    ]
  },
