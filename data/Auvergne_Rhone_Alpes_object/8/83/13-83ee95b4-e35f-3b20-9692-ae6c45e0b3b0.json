  "rdfs:comment": {
    "de": [
      "Das Maison de la Tour - Le Cube bietet das ganze Jahr über Ausstellungen an, begleitet anerkannte oder aufstrebende Künstler bei der Kreation und stellt sie vor, verbreitet kreative Werke und trägt zu hochwertigen künstlerischen Veranstaltungen (Theater, Konzerte) bei."
    ],
    "en": [
      "La Maison de la Tour - Le Cube offers year-round exhibitions, supports the creation and presentation of recognized and up-and-coming artists, distributes creative works, and contributes to high-quality artistic events (theater, concerts)."
    ],
    "it": [
      "La Maison de la Tour - Le Cube propone mostre durante tutto l'anno, sostiene la creazione e la presentazione di artisti riconosciuti o emergenti, distribuisce opere creative e contribuisce a eventi artistici di qualità (teatro, concerti)."
    ],
    "fr": [
      "La Maison de la Tour - Le Cube propose des expositions toute l'année, accompagne en création et présente des artistes reconnus ou en devenir, diffuse des œuvres de création, contribue à des événements artistiques de qualité (théâtre, concerts)."
    ],
    "es": [
      "La Maison de la Tour - Le Cube ofrece exposiciones a lo largo de todo el año, apoya la creación y presentación de artistas reconocidos o emergentes, distribuye obras de creación y contribuye a la realización de eventos artísticos de calidad (teatro, conciertos)."
    ],
    "nl": [
      "La Maison de la Tour - Le Cube biedt het hele jaar door tentoonstellingen, ondersteunt de creatie en presentatie van gevestigde en opkomende kunstenaars, verspreidt creatieve werken en draagt bij aan artistieke evenementen van hoge kwaliteit (theater, concerten)."
    ]
  },
