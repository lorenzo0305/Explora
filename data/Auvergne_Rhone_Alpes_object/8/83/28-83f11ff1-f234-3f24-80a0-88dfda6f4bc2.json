  "rdfs:comment": {
    "de": [
      "Der Picknickplatz im Dorf Catheux liegt in der Nähe des Coulée Verte und befindet sich am Fuße der feudalen Motte. Er bietet einen herrlichen Blick auf das Dorfzentrum und die Kirche. Er ist mit einem Tisch, einer Bank und Mülleimern ausgestattet. Es gibt zwei Bouleplätze."
    ],
    "en": [
      "Situated near the Coulée Verte, the picnic area in the village of Catheux is located at the foot of the motte féodale. It offers a breathtaking view of the village center and church. It is equipped with a table, benches and litter garbage cans. There are 2 boules courts."
    ],
    "it": [
      "Situata nei pressi della Coulée Verte, l'area picnic del villaggio di Catheux si trova ai piedi della motta feudale. Offre una vista ininterrotta sul centro del villaggio e sulla chiesa. È attrezzata con tavolo, panche e cestini per i rifiuti. Sono presenti 2 campi da bocce."
    ],
    "fr": [
      "Située à proximité de la Coulée Verte, l'aire de pique-nique du village de Catheux est localisée au pied de la motte féodale. Elle offre une vue imprenable sur le centre du village et l'église. Elle est aménagée d'une table, de banc et de poubelles. Il y a 2 terrains de boules."
    ],
    "es": [
      "Situado cerca de la Coulée Verte, el merendero del pueblo de Catheux se encuentra a los pies de la mota feudal. Ofrece una vista ininterrumpida del centro del pueblo y de la iglesia. Está equipado con una mesa, bancos y papeleras. Hay 2 pistas de petanca."
    ],
    "nl": [
      "De picknickplaats in het dorp Catheux ligt vlakbij de Coulée Verte, aan de voet van de feodale motte. Het biedt een ononderbroken uitzicht op het dorpscentrum en de kerk. Het is uitgerust met een tafel, banken en afvalbakken. Er zijn 2 petanquebanen."
    ]
  },
  "rdfs:label": {
    "fr": [
