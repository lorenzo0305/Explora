  "rdfs:comment": {
    "de": [
      "Die Kirche von Brullioles ist ein altes religiöses Gebäude, das das Dorf überragt und sich durch seinen typischen Glockenturm und seine traditionelle Architektur aus der Region Lyon auszeichnet."
    ],
    "en": [
      "The church of Brullioles is an ancient religious building dominating the village, characterized by its typical bell tower and traditional architecture of the Lyon region."
    ],
    "it": [
      "La chiesa di Brullioles è un antico edificio religioso che domina il villaggio, caratterizzato dal tipico campanile e dall'architettura tradizionale della regione di Lione."
    ],
    "fr": [
      "L’église de Brullioles est un édifice religieux ancien qui domine le village, caractérisé par son clocher typique et son architecture traditionnelle de la région lyonnaise."
    ],
    "es": [
      "La iglesia de Brullioles es un antiguo edificio religioso que domina el pueblo, caracterizado por su campanario típico y su arquitectura tradicional de la región lionesa."
    ],
    "nl": [
      "De kerk van Brullioles is een oud religieus gebouw dat het dorp domineert, gekenmerkt door de typische klokkentoren en traditionele architectuur van de regio Lyon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église de la Nativité-de-Saint-Jean-Baptiste"
    ]
  },
