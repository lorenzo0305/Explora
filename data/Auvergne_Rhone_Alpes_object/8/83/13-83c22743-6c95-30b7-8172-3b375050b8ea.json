  "rdfs:comment": {
    "de": [
      "La Forge bietet Ihnen den einzigen Squash-Bereich des Tals! Auf zwei Feldern können Sie ein Maximum an Kalorien verbrennen und dabei Spaß haben. Dieser Racketsport entwickelt Ihre Beweglichkeit, Geschwindigkeit und Reflexe. Sie werden Ihre Ausdauer verbessern!"
    ],
    "en": [
      "La Forge offers you the only Squash area in the valley! 2 courses to burn maximum calories while having fun. This racket sport develops your flexibility, speed and reflexes. You will improve your stamina!"
    ],
    "it": [
      "La Forge ha l'unico campo da squash della valle! Due campi per bruciare più calorie possibili divertendosi. Questo sport con la racchetta sviluppa flessibilità, velocità e riflessi. È un ottimo modo per migliorare la vostra resistenza!"
    ],
    "fr": [
      "La Forge vous propose l'unique espace Squash de la vallée ! Deux terrains pour brûler un maximum de calories tout en vous amusant. Ce sport de raquette développera votre souplesse, votre vitesse et vos réflexes. Vous améliorerez votre endurance !"
    ],
    "es": [
      "¡La Forge tiene la única pista de squash del valle! Dos pistas para quemar el máximo de calorías mientras te diviertes. Este deporte de raqueta desarrollará su flexibilidad, velocidad y reflejos. ¡Es una forma estupenda de mejorar tu resistencia!"
    ],
    "nl": [
      "La Forge heeft de enige squashbaan in de vallei! Twee banen om zoveel mogelijk calorieën te verbranden terwijl je plezier hebt. Deze racketsport ontwikkelt je flexibiliteit, snelheid en reflexen. Het is een geweldige manier om je uithoudingsvermogen te verbeteren!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Forge Squash Club"
    ],
    "fr": [
      "La Forge Squash Club"
    ]
  },
