  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes gelegen, lädt seine große, schattige Terrasse zum Faulenzen ein\r\nChez Lych bietet Ihnen eine traditionelle Gastronomie, Tagesgerichte von Montag bis Freitag, aber auch einen Barservice und gutes Eis zum Verkosten."
    ],
    "en": [
      "L’Auberge is located in the heart of the village and has a shaded terrace. L’Auberge proposes traditional cuisine and ice-creams."
    ],
    "it": [
      "Situato nel cuore del villaggio, la sua grande terrazza ombreggiata invita al relax\r\nChez Lych offre un ristorante tradizionale con specialità giornaliere dal lunedì al venerdì, oltre a un servizio bar e a deliziosi gelati."
    ],
    "fr": [
      "Situé en plein coeur du village sa vaste terrasse ombragé vous invitera au farniente\r\nChez Lych on vous propose une restauration traditionnelle, des plats du jour du lundi au vendredi mais aussi un service de bar et de bonnes glaces à déguster."
    ],
    "es": [
      "Situado en el corazón del pueblo, su gran terraza a la sombra invita a relajarse\r\nChez Lych ofrece un restaurante tradicional con especialidades diarias de lunes a viernes, así como servicio de bar y deliciosos helados."
    ],
    "nl": [
      "Gelegen in het hart van het dorp, nodigt het grote schaduwrijke terras je uit om te ontspannen\r\nChez Lych biedt een traditioneel restaurant met dagschotels van maandag tot vrijdag, evenals een barservice en heerlijke ijsjes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Lych"
    ]
  },
