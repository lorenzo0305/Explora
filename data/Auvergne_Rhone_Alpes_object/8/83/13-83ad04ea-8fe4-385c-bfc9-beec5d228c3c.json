  "rdfs:comment": {
    "de": [
      "Gedenkfeier für die Erschossenen des Parkplatzes La Luire und der Brücke Pont des Oules :\r\n? um 11 Uhr vor der Stele des Parkplatzes La Luire\r\n? um 11.30 Uhr vor der Stele der Brücke Pont des Oules\r\nAn jeder der Stelen werden Kränze niedergelegt."
    ],
    "en": [
      "Celebration in honor of the shootings at the Luire parking lot and the Oules bridge:\r\n? at 11am in front of the Luire stele\r\n? at 11:30 am at the Pont des Oules stele\r\nWreaths will be laid in front of each stele."
    ],
    "it": [
      "Celebrazione in onore dei caduti nel parcheggio della Luire e sul ponte di Oules:\r\nalle ore 11 davanti alla stele del Luire\r\nalle 11.30 davanti alla stele del ponte di Oules\r\nDavanti a ciascuna stele verranno deposte delle corone."
    ],
    "fr": [
      "Célébration à l’hommage des fusillés du parking de la Luire et du pont des Oules :\r\n• à 11H devant la stèle de la Luire \r\n• à 11H30 devant la stèle du pont des Oules\r\nUn dépôt de gerbes sera fait devant chacune des stèles."
    ],
    "nl": [
      "Viering ter ere van de doden op de parkeerplaats van Luire en op de brug van Oules:\r\nom 11 uur voor de stele van Luire\r\nom 11.30 uur voor de stele van de Oules brug\r\nEr zullen kransen worden gelegd voor elke stele."
    ],
    "es": [
      "Celebración en honor de los fusilados en el aparcamiento de Luire y en el puente de Oules:\r\n? a las 11h frente a la estela de Luire\r\n? a las 11.30 h delante de la estela del puente de Oules\r\nSe depositarán coronas de flores delante de cada estela."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cérémonie du 28 juillet : Célébration à l’hommage des fusillés"
    ]
  },
