  "rdfs:comment": {
    "de": [
      "Das La Fèrma im Herzen des Hotels Annapurna ist eine Hommage an die Aromen von Savoyen in einer warmen und intimen Atmosphäre. Raclette, Fondue, hausgemachte Wurstwaren und Beignets de Vonezins werden hier in einem Dekor aus Holz, Wolle und blauem Zellig serviert."
    ],
    "en": [
      "At the heart of Hotel Annapurna, La Fèrma pays tribute to the flavors of Savoy in a warm and intimate setting. Raclette, fondue, artisanal charcuterie, and Vonezins fritters are savored in a décor blending wood, wool, and blue zellige tiles."
    ],
    "it": [
      "Nel cuore dell'Hôtel Annapurna, La Fèrma rende omaggio ai sapori della Savoia in un'atmosfera calda e intima. Raclette, fonduta, salumi fatti in casa e ciambelle Vonezins sono serviti in un arredamento che combina legno, lana e zelliges blu."
    ],
    "fr": [
      "Au cœur de l’Hôtel Annapurna, La Fèrma rend hommage aux saveurs de Savoie dans une ambiance chaleureuse et intimiste. Raclette, fondue, charcuteries artisanales et beignets de Vonezins s’y dégustent dans un décor mêlant bois, laine et zelliges bleus."
    ],
    "nl": [
      "In het hart van Hôtel Annapurna brengt La Fèrma hulde aan de smaken van de Savoie in een warme en intieme sfeer. Raclette, fondue, huisgemaakte vleeswaren en Vonezins donuts worden geserveerd in een decor van hout, wol en blauwe zelliges."
    ],
    "es": [
      "En el corazón del Hôtel Annapurna, La Fèrma rinde homenaje a los sabores de Saboya en un ambiente cálido e íntimo. Raclette, fondue, charcutería casera y donuts Vonezins se sirven en una decoración que combina madera, lana y zelliges azules."
    ]
  },
