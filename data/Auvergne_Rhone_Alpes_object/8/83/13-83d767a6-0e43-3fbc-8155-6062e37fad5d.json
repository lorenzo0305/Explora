  "rdfs:comment": {
    "de": [
      "In einem völlig neu gestalteten Dekor mit raffinierten Farben und einer auf Trödelmärkten gefundenen Einrichtung zeigt dieses neue Restaurant echte gastronomische Ambitionen, die sich an die besten Ressourcen der Region anlehnen."
    ],
    "en": [
      "In a completely revamped decor, with refined colors and antiques, this new restaurant displays real gastronomic ambitions, backed by the best local resources."
    ],
    "it": [
      "In un arredamento completamente rinnovato, con colori raffinati e pezzi d'antiquariato, questo nuovo ristorante ha vere e proprie ambizioni gastronomiche, basate sui migliori prodotti locali."
    ],
    "fr": [
      "Dans un décor entièrement revisité, aux couleurs raffinées, avec une décoration chinée dans les brocantes, ce nouveau restaurant affiche de vraies ambitions gastronomiques, adossées aux meilleures ressources du terroir."
    ],
    "nl": [
      "In een volledig vernieuwd decor, met verfijnde kleuren en antiek, heeft dit nieuwe restaurant echte gastronomische ambities, gebaseerd op de beste lokale producten."
    ],
    "es": [
      "En una decoración totalmente renovada, con colores refinados y antigüedades, este nuevo restaurante tiene verdaderas ambiciones gastronómicas, basadas en los mejores productos locales."
    ]
  },
