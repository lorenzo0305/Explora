  "rdfs:comment": {
    "de": [
      "Glaskünstlerin, die mit Glasmalerei arbeitet. Mitglied der Association des Artisans d'Art du Val-d'Allier, die ihre Besucher und Kunden seit 6 Jahren in Escandilha, boutique-galerie-atelier d'artisans créateurs in Brioude, 19 rue Sébastopol, empfängt."
    ],
    "en": [
      "Stained glass artist. Member of the Association des Artisans d'Art du Val-d'Allier, which has been welcoming visitors and customers to Escandilha, a boutique-gallery-workshop of creative craftsmen in Brioude, 19 rue Sébastopol, for 6 years."
    ],
    "it": [
      "Artista del vetro colorato. Membro dell'Association des Artisans d'Art du Val-d'Allier, che da 6 anni accoglie visitatori e clienti a Escandilha, una boutique-galleria-laboratorio di artigiani creativi a Brioude, 19 rue Sébastopol."
    ],
    "fr": [
      "Artiste-verrier, travaillant le vitrail. Membre de l'Association des Artisans d'Art du Val-d'Allier qui accueille ses visiteurs et clients à Escandilha, boutique-galerie-atelier d'artisans créateurs à Brioude, 19 rue Sébastopol, depuis 6 ans."
    ],
    "es": [
      "Vitralista. Miembro de la Association des Artisans d'Art du Val-d'Allier, que desde hace 6 años acoge a visitantes y clientes en Escandilha, boutique-galería-taller de artesanos creadores en Brioude, 19 rue Sébastopol."
    ],
    "nl": [
      "Glas-in-lood kunstenaar. Lid van de Association des Artisans d'Art du Val-d'Allier, die al 6 jaar bezoekers en klanten ontvangt in Escandilha, een boetiek-galerie-werkplaats voor creatieve ambachtslieden in Brioude, 19 rue Sébastopol."
    ]
  },
