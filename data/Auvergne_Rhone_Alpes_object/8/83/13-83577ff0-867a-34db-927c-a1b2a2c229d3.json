  "rdfs:comment": {
    "de": [
      "Der Freizeitpark Léman Forest bietet einen Abenteuerpark und ein Lasergame im Freien. Er befindet sich an der französisch-schweizerischen Grenze, sodass seine Seilrutsche über beide Länder führt."
    ],
    "en": [
      "The Léman Forest leisure park offers an outdoor adventure park and laser game. Located on the Franco-Swiss border, its zip line flies over both countries."
    ],
    "it": [
      "Il parco divertimenti Léman Forest offre un parco avventura e un gioco laser all'aperto. Situata al confine tra Francia e Svizzera, la sua zip line sorvola entrambi i Paesi."
    ],
    "fr": [
      "Le parc de loisirs Léman Forest propose un parc aventure et un laser game en extérieur. Situé sur la frontière franco-suisse, sa tyrolienne survole donc les deux pays."
    ],
    "nl": [
      "Het recreatiepark Léman Forest biedt een outdoor avonturenpark en lasergame. Het ligt op de Frans-Zwitserse grens en de tokkelbaan vliegt over beide landen."
    ],
    "es": [
      "El parque de ocio Léman Forest ofrece un parque de aventuras y un juego de láser al aire libre. Situada en la frontera franco-suiza, su tirolina sobrevuela ambos países."
    ]
  },
