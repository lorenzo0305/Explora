  "rdfs:comment": {
    "de": [
      "Ein kleiner Spaziergang durch seine Gassen enthüllt wunderschöne Häuser mit ihren für die Region typischen Schieferdächern. Raulhac wird Sie mit seinem Charme und seiner bewahrten Authentizität überraschen."
    ],
    "en": [
      "A stroll through the narrow streets reveals some superb houses with their typical local slate roofs. Raulhac will surprise you with its charm and unspoilt authenticity."
    ],
    "it": [
      "Passeggiando per le stradine si scoprono le superbe case con i tipici tetti in ardesia. Raulhac vi sorprenderà con il suo fascino e la sua autenticità preservata."
    ],
    "fr": [
      "Une petite balade dans ses ruelles dévoile de superbes maisons et leurs toits en lauzes typiques de la région. Raulhac saura vous surprendre par son charme et son authenticité préservée."
    ],
    "es": [
      "Pasee por sus callejuelas y verá algunas de las magníficas casas y tejados de pizarra típicos de la región. Raulhac le sorprenderá por su encanto y su autenticidad intacta."
    ],
    "nl": [
      "Een wandeling door de smalle straatjes onthult de prachtige huizen met hun typische leien daken. Raulhac zal u verrassen door zijn charme en zijn bewaard gebleven authenticiteit."
    ]
  },
