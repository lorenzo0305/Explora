  "rdfs:comment": {
    "de": [
      "Mieten Sie ein Fahrrad in aller Freiheit, 7 Tage die Woche, 24 Stunden am Tag und bis zu 24 Stunden hintereinander.\r\nFinden Sie 28 Stationen in der Gemeinde Valence.\r\nErfordert die mobile Anwendung PBSC oder eine Registrierung bei Citéa."
    ],
    "en": [
      "Rent a bike with complete freedom, 24/7 and for up to 24 hours at a time.\r\n28 stations in Valence.\r\nRequires PBSC mobile application or registration with Citéa."
    ],
    "it": [
      "Noleggiate una bicicletta in totale libertà, 7 giorni su 7, 24 ore su 24 e fino a 24 ore di seguito.\r\nCi sono 28 stazioni nell'area di Valence.\r\nRichiede l'applicazione mobile PBSC o la registrazione a Citéa."
    ],
    "fr": [
      "Louez un vélo en toute liberté, 7j/7, 24h/24 et jusqu’à 24h consécutives.\r\nRetrouvez 28 stations sur la commune de Valence.\r\nNécessite l'application mobile PBSC ou une inscription auprès de Citéa."
    ],
    "nl": [
      "Huur een fiets in alle vrijheid, 7 dagen per week, 24 uur per dag en voor maximaal 24 uur per keer.\r\nEr zijn 28 stations in Valence.\r\nHiervoor is de mobiele applicatie van PBSC nodig of een registratie bij Citéa."
    ],
    "es": [
      "Alquile una bicicleta con total libertad, 7 días a la semana, 24 horas al día y hasta 24 horas seguidas.\r\nHay 28 estaciones en la zona de Valence.\r\nRequiere la aplicación móvil PBSC o el registro en Citéa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stations Libélo de Valence"
    ]
  },
