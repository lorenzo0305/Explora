  "rdfs:comment": {
    "de": [
      "Mit einer großen Auswahl an Produkten, sei es zum Probieren oder zum Verschenken, finden Sie hier bestimmt das Richtige für sich!"
    ],
    "en": [
      "With a wide choice of products, whether to enjoy or to give as a gift, you're bound to find what you're looking for!"
    ],
    "it": [
      "Con un'ampia scelta di prodotti, da gustare o da regalare, troverete sicuramente quello che cercate!"
    ],
    "fr": [
      "Avec un large de choix de produits, que ce soit pour déguster ou pour offrir, vous y trouverez forcément ce qu'il vous faut !"
    ],
    "nl": [
      "Met een ruime keuze aan producten, om van te genieten of om cadeau te geven, vind je vast en zeker wat je zoekt!"
    ],
    "es": [
      "Con una amplia gama de productos, tanto para disfrutar como para regalar, ¡seguro que encuentra lo que busca!"
    ]
  },
