  "rdfs:comment": {
    "de": [
      "Restaurant-Bar La Clé des Chants - All-you-can-eat-Buffet, das die traditionelle Küche in einem einladenden Ambiente zelebriert. Perfekt für ein Mittagessen mit Freunden oder der Familie oder für eine Gourmetpause während Ihres Tages."
    ],
    "en": [
      "Restaurant-Bar La Clé des Chants - all-you-can-eat buffet celebrating traditional cuisine in a welcoming atmosphere. Perfect for lunch with friends or family, or for a gourmet break during the day."
    ],
    "it": [
      "Ristorante-Bar La Clé des Chants - buffet a volontà che celebra la cucina tradizionale in un'atmosfera accogliente. Perfetto per un pranzo con gli amici o la famiglia, o per una pausa golosa durante la giornata."
    ],
    "fr": [
      "Restaurant-Bar La Clé des Chants - buffet à volonté qui célèbre la cuisine traditionnelle dans une ambiance accueillante. Parfait pour un déjeuner entre amis, en famille, ou pour une pause gourmande durant votre journée."
    ],
    "es": [
      "Restaurante-Bar La Clé des Chants - buffet libre de platos tradicionales en un ambiente acogedor. Perfecto para almorzar con amigos o en familia, o para una pausa gastronómica durante el día."
    ],
    "nl": [
      "Restaurant-Bar La Clé des Chants - all-you-can-eat buffet met traditionele gerechten in een gezellige sfeer. Perfect voor een lunch met vrienden of familie, of voor een gastronomische pauze overdag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant \"La Clé des Chants\""
    ]
  },
