  "rdfs:comment": {
    "de": [
      "Erleben Sie am 28. März ab 20 Uhr im großen Saal des Rathauses von Saint-Vidal Les Saveurs mêlées, eine Theateradaption von Guy de Maupassant durch die Theatergruppe Monnaie de Singe."
    ],
    "en": [
      "Come and discover Les Saveurs mêlées, a theatrical adaptation of Guy de Maupassant by the Monnaie de Singe company, on March 28 from 8pm in the main hall of Saint-Vidal town hall."
    ],
    "it": [
      "Venite a vedere Les Saveurs mêlées, un adattamento teatrale di Guy de Maupassant realizzato dalla compagnia Monnaie de Singe, il 28 marzo dalle 20.00 nella sala principale del municipio di Saint-Vidal."
    ],
    "fr": [
      "Venez découvrir le 28 mars à partir de 20h dans la grande salle de la mairie de Saint-Vidal, Les Saveurs mêlées, une adaptation théâtrale de Guy de Maupassant par la compagnie Monnaie de Singe."
    ],
    "es": [
      "Venga a ver Les Saveurs mêlées, adaptación teatral de Guy de Maupassant a cargo de la compañía Monnaie de Singe, el 28 de marzo a partir de las 20:00 h en la sala principal del ayuntamiento de Saint-Vidal."
    ],
    "nl": [
      "Kom kijken naar Les Saveurs mêlées, een theatrale bewerking van Guy de Maupassant door het gezelschap Monnaie de Singe, op 28 maart vanaf 20 uur in de grote zaal van het gemeentehuis van Saint-Vidal."
    ]
  },
