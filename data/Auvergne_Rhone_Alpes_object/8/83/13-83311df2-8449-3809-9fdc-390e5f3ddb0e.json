  "rdfs:comment": {
    "de": [
      "Sie werden den Espace sensoriel des Instituts lieben. Dieser Bereich ist der exquisiten Entspannung gewidmet und besteht aus mehreren Punkten, von denen einer so verführerisch wie der andere ist."
    ],
    "en": [
      "You'll love the institute's Sensory Space. Dedicated to exquisite relaxation, this space is made up of several points, each as seductive as the next."
    ],
    "it": [
      "L'area sensoriale dell'istituto vi piacerà moltissimo. Dedicato allo squisito relax, questo spazio è composto da diversi punti, ognuno seducente come l'altro."
    ],
    "fr": [
      "Vous allez adorer l'Espace sensoriel de l'institut. Dédié à une détente exquise, cet espace est composé de plusieurs points aussi séduisant les uns que les autres."
    ],
    "nl": [
      "U zult genieten van de zintuiglijke ruimte van het instituut. Deze ruimte, gewijd aan exquise ontspanning, bestaat uit verschillende punten, elk even verleidelijk als het andere."
    ],
    "es": [
      "Le encantará el Espacio Sensorial del Instituto. Dedicada a una relajación exquisita, esta zona se compone de varios puntos, cada uno tan seductor como el siguiente."
    ]
  },
