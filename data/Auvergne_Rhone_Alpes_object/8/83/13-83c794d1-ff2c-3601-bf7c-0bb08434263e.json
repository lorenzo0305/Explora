  "rdfs:comment": {
    "de": [
      "Der Bauernladen vereint 25 lokale Produzenten und Handwerker, er ermöglicht es, den Wunsch nach lokalem Konsum zu befriedigen!"
    ],
    "en": [
      "The producers' store opened its doors in the small town of Ébreuil in July 2022. Bringing together 25 local producers and artisans, it satisfies the desire to consume locally!"
    ],
    "it": [
      "La bottega dei produttori riunisce 25 produttori e artigiani locali ed è il luogo ideale per soddisfare il vostro desiderio di acquistare locale!"
    ],
    "fr": [
      "Le magasin de producteurs regroupe 25 producteurs et artisans locaux, il permet de satisfaire les envies de consommer local !"
    ],
    "es": [
      "La tienda de productores reúne a 25 productores y artesanos locales, y es el lugar perfecto para satisfacer su deseo de comprar productos locales"
    ],
    "nl": [
      "De producentenwinkel brengt 25 lokale producenten en ambachtslieden samen en is de perfecte plek om je verlangen naar lokaal kopen te bevredigen!"
    ]
  },
