  "rdfs:comment": {
    "de": [
      "Der CATV organisiert zahlreiche Veranstaltungen, deren Ziel es ist, das Dorf bei Touristen bekannt zu machen und die soziale Bindung für die Vinsobrais zu fördern."
    ],
    "en": [
      "Tourist Activity Committee of Vinsobres."
    ],
    "it": [
      "Il CATV organizza una serie di eventi, il cui scopo è quello di promuovere il villaggio ai turisti e di incoraggiare i contatti sociali per i Vinsobrais."
    ],
    "fr": [
      "Le CATV organise de multiples manifestations, dont le but est de promouvoir le village auprès des touristes et  favoriser le lien social pour les Vinsobrais."
    ],
    "nl": [
      "Het CATV organiseert diverse evenementen waarbij het doel is om het dorp te promoten onder de toeristen en het bevorderen van de sociale contacten van de Vinsobrais."
    ],
    "es": [
      "El CATV organiza una serie de eventos cuyo objetivo es promocionar el pueblo entre los turistas y fomentar el contacto social de los vinsobrais."
    ]
  },
  "rdfs:label": {
