      "@id": "https://data.datatourisme.fr/1c1753ff-169b-3524-90a7-eb09c4b2f823",
      "dc:description": {
        "de": [
          "Ein Ort des Lebens, zeitlos und im Trend der Zeit. Eine lokale, hausgemachte Küche. Meeresfrüchte und Produkte aus der Region."
        ],
        "en": [
          "A place to live, timeless and in tune with the times. Local, homemade cuisine. Seafood and local produce."
        ],
        "it": [
          "Un luogo da vivere, senza tempo e al passo con i tempi. Cucina locale e casalinga. Frutti di mare e prodotti locali."
        ],
        "fr": [
          "Un lieu de vie, hors du temps et dans l'air du temps. Une cuisine locale, fait maison. Fruits de mer et produits du terroir."
        ],
        "es": [
          "Un lugar para vivir, intemporal y acorde con los tiempos. Cocina local y casera. Marisco y productos de la tierra."
        ],
        "nl": [
          "Een plek om te wonen, tijdloos en bij de tijd. Lokale, huisgemaakte keuken. Zeevruchten en lokale producten."
        ]
      },
