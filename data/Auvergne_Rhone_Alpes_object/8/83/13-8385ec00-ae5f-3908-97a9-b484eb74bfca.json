  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Beef Lodge, ein außergewöhnliches Steakhaus mitten im Zentrum von Megève. Genießen Sie zum Abendessen seltenes, gereiftes Fleisch, das nach allen Regeln der Kunst zubereitet wird.  Und im Winter wird das Mittagessen zum Gourmet-Brunch!"
    ],
    "en": [
      "Discover the Beef Lodge, an exceptional Steak House in the center of Megève. For dinner, savour rare meats, matured and cooked true to tradition.\r\nAnd in winter, lunch at the bar become gourmet brunches!"
    ],
    "it": [
      "Scoprite il Beef Lodge, un'eccezionale steak house nel centro di Megève. A cena potrete gustare carni rare, stagionate e cucinate a regola d'arte.  E a pranzo, in inverno, i pranzi diventano brunch gourmet!"
    ],
    "fr": [
      "Découvrez le Beef Lodge, un Steak House d’exception en plein centre de Megève. Pour le dîner, savourez des viandes rares, affinées et cuisinées dans les règles de l’art.  Et au déjeuner, en hiver, les déjeuners se font brunchs gourmands!"
    ],
    "nl": [
      "Ontdek de Beef Lodge, een uitzonderlijk steakhouse in het centrum van Megève. Geniet voor het diner van zeldzaam vlees, gerijpt en bereid volgens de regels van de kunst.  En voor de lunch zijn er in de winter brunches voor fijnproevers!"
    ],
    "es": [
      "Descubra el Beef Lodge, un asador excepcional en pleno centro de Megève. Para cenar, saboree carnes raras, maduradas y cocinadas según las reglas del arte.  Y para almorzar, en invierno, ¡se ofrecen brunchs gastronómicos!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Beef Lodge"
    ],
    "it": [
      "Le Beef Lodge"
    ],
    "fr": [
      "Le Beef Lodge"
    ]
  },
