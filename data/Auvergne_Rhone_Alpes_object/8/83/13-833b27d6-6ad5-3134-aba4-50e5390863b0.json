  "rdfs:comment": {
    "de": [
      "Zwei Geschäfte, eine Gourmet-Adresse!\r\nFeinkost & Gourmetgeschenke\r\nBrunch\r\nGourmet-Lounge\r\nCocktails, Weine und Tapas zum Teilen am Abend\r\nOriginelle Events und kreative Workshops jede Woche"
    ],
    "en": [
      "Two shops, one gourmet address!\r\nDelicatessen & gourmet gifts\r\nBrunch\r\nGourmet lounge\r\nEvening cocktails, wines and tapas to share\r\nOriginal events and creative workshops every week"
    ],
    "it": [
      "Due negozi, un unico indirizzo gastronomico!\r\nDelicatessen e regali gourmet\r\nBrunch\r\nLounge gourmet\r\nCocktail, vini e tapas da condividere la sera\r\nEventi originali e laboratori creativi ogni settimana"
    ],
    "fr": [
      "Deux commerces, une seule adresse gourmande !\r\nEpicerie fine & cadeaux gourmands\r\nBrunch\r\nSalon gourmand\r\nCocktails, vins et tapas à partager le soir\r\nEvènements originaux et ateliers créatifs toutes les semaines"
    ],
    "nl": [
      "Twee winkels, één adres voor fijnproevers!\r\nDelicatessen & gourmetgeschenken\r\nBrunch\r\nZitkamer voor fijnproevers\r\nCocktails, wijnen en tapas om 's avonds te delen\r\nElke week originele evenementen en creatieve workshops"
    ],
    "es": [
      "Dos tiendas, una dirección gourmet\r\nDelicatessen y regalos gourmet\r\nBrunch\r\nSalón gastronómico\r\nCócteles, vinos y tapas para compartir por la noche\r\nEventos originales y talleres creativos cada semana"
    ]
  },
