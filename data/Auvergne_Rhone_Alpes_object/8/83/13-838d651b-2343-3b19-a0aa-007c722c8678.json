  "rdfs:comment": {
    "de": [
      "Das Restaurant El Raïs bietet eine traditionelle Küche des Maghreb, in der die algerischen Spezialitäten im Vordergrund stehen.\r\nCouscous, Tajines, Briques und orientalisches Gebäck werden in einer warmen und freundlichen Atmosphäre serviert, die den Traditionen treu bleibt."
    ],
    "en": [
      "The El Raïs restaurant offers traditional Maghreb cuisine featuring Algerian specialties.\r\nCouscous, tajines, bricks and oriental pastries are served in a warm and friendly atmosphere, true to tradition."
    ],
    "it": [
      "Il ristorante El Raïs offre una cucina tradizionale magrebina con specialità algerine.\r\nCouscous, tajine, brick e dolci orientali sono serviti in un'atmosfera calda e accogliente, fedele alla tradizione."
    ],
    "fr": [
      "Le restaurant El Raïs propose une cuisine traditionnelle du Maghreb mettant à l’honneur les spécialités algériennes. \r\nCouscous, tajines, briques et pâtisseries orientales sont servis dans une ambiance chaleureuse et conviviale, fidèle aux traditions."
    ],
    "nl": [
      "Restaurant El Raïs serveert traditionele gerechten uit de Maghreb met Algerijnse specialiteiten.\r\nCouscous, tajines, bakstenen en oosters gebak worden geserveerd in een warme en vriendelijke sfeer, trouw aan de traditie."
    ],
    "es": [
      "El restaurante El Raïs ofrece cocina tradicional magrebí con especialidades argelinas.\r\nCuscús, tajines, bricks y repostería oriental se sirven en un ambiente cálido y acogedor, fiel a la tradición."
    ]
  },
  "rdfs:label": {
