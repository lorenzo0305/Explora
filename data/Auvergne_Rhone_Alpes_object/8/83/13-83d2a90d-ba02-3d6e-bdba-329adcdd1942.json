  "rdfs:comment": {
    "de": [
      "Als Skitourenliebhaber können Sie die eigens dafür vorgesehene Piste testen und als Belohnung: die erhabene Aussicht auf dem Gipfel!"
    ],
    "en": [
      "If you love ski touring, come and try out the dedicated slope, and the reward: the sublime view from the summit!"
    ],
    "it": [
      "Se amate lo sci alpinismo, venite a provare la pista dedicata e la ricompensa: la vista sublime dalla cima!"
    ],
    "fr": [
      "Amateur de ski randonnée, venez tester la piste dédiée à cet effet, et en récompense : la vue sublime au sommet !"
    ],
    "es": [
      "Si le gusta el esquí de travesía, venga a probar la pista dedicada, y la recompensa: ¡la sublime vista desde la cumbre!"
    ],
    "nl": [
      "Als je van toerskiën houdt, kom dan de speciale piste uitproberen, en de beloning: het sublieme uitzicht vanaf de top!"
    ]
