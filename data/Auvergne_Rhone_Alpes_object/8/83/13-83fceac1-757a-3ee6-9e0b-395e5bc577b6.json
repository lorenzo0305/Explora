  "rdfs:comment": {
    "de": [
      "Das Bistro Jeanne ist eine echte Einladung zu einer Schlemmerpause in einem pflanzlichen und zeitgenössischen Rahmen. Sie können auch die Sonnenterrasse oder die schönen Sommerabende unter der Pergola genießen."
    ],
    "en": [
      "Bistrot Jeanne is a contemporary restaurant with a vegetal feel. Here, cooking and eating rhymes with good, seasonal and regional cuisine. Gourmet dishes with local products, all in a warm atmosphere."
    ],
    "it": [
      "Il Bistro Jeanne è un vero e proprio invito a una parentesi gastronomica in un ambiente verde e contemporaneo. Potete anche godervi la terrazza soleggiata o le belle serate estive sotto la pergola."
    ],
    "fr": [
      "Le Bistro Jeanne est une véritable invitation à une parenthèse gourmande dans un cadre végétal et contemporain,  vous pourrez également profiter de la terrasse ensoleillée ou des belles soirée d'été sous la pergola."
    ],
    "es": [
      "El Bistro Jeanne es una auténtica invitación a un interludio gastronómico en un entorno verde y contemporáneo. También podrá disfrutar de la soleada terraza o de las hermosas veladas estivales bajo la pérgola."
    ],
    "nl": [
      "Bistro Jeanne is een echte uitnodiging voor een gastronomisch intermezzo in een groen en eigentijds kader. Je kunt er ook genieten van het zonnige terras of de mooie zomeravonden onder de pergola."
    ]
  },
