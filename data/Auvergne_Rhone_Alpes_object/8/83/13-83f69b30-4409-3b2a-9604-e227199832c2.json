  "rdfs:comment": {
    "de": [
      "Die Drôme ist Gegenstand der geistes- und sozialwissenschaftlichen Forschung junger Forscher, die ihre Arbeit auf die Untersuchung von Archiven, Gebäuden oder Objekten stützen."
    ],
    "en": [
      "The Drôme is the subject of research in the humanities and social sciences by young researchers who base their work on the study of archives, buildings and objects."
    ],
    "it": [
      "La Drôme è oggetto di ricerca nelle scienze umane e sociali da parte di giovani ricercatori che basano il loro lavoro sullo studio di archivi, edifici e oggetti."
    ],
    "fr": [
      "La Drôme fait l’objet de recherches en sciences humaines et sociales de la part de jeunes chercheurs qui fondent leur travail sur l’étude d’archives, d’édifices ou d’objets."
    ],
    "es": [
      "La Drôme es objeto de investigaciones en humanidades y ciencias sociales por parte de jóvenes investigadores que basan sus trabajos en el estudio de archivos, edificios y objetos."
    ],
    "nl": [
      "De Drôme is het onderwerp van onderzoek in de geestes- en sociale wetenschappen door jonge onderzoekers die hun werk baseren op de studie van archieven, gebouwen en voorwerpen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence de Mars \"Quoi de neuf sur l'histoire de la Drôme ?\""
    ]
  },
