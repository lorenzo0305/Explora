  "rdfs:comment": {
    "de": [
      "Dies ist der von einem Turm gekrönte Felsen, der Bourg-Saint-Maurice überragt. Dieser ehemalige Steinbruch ist eine der ersten Kletterschulen des Tals; es ist ein interessanter Ort für Anfänger, aber die Routen auf der linken Seite gehen bis 7a+."
    ],
    "en": [
      "This is the rock topped by a tower that dominates Bourg-Saint-Maurice. This former quarry was one of the valley?s first climbing schools; it?s an interesting site for beginners, but the routes on the left go up to 7a+."
    ],
    "it": [
      "Questa è la roccia sormontata da una torre che domina Bourg-Saint-Maurice. Questa ex cava è stata una delle prime scuole di arrampicata della valle; è un sito interessante per i principianti, ma le vie sulla sinistra arrivano fino al 7a+."
    ],
    "fr": [
      "C'est le rocher surmonté d'une tour qui domine Bourg-Saint-Maurice. Cette ancienne carrière est une des premières écoles d'escalade de la vallée ;  c’est un site intéressant pour les débutants, mais les voies de gauche vont jusqu'au 7a+."
    ],
    "es": [
      "Esta es la roca coronada por una torre que domina Bourg-Saint-Maurice. Esta antigua cantera fue una de las primeras escuelas de escalada del valle; es un sitio interesante para principiantes, pero las vías de la izquierda llegan hasta 7a+."
    ],
    "nl": [
      "Dit is de rots met de top van een toren die Bourg-Saint-Maurice domineert. Deze voormalige steengroeve was een van de eerste klimscholen in de vallei; het is een interessante plek voor beginners, maar de routes links gaan tot 7a+."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Rocher du Châtelard"
    ]
  },
