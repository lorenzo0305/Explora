  "rdfs:comment": {
    "de": [
      "Das 5 Minuten von Bourgoin-Jallieu entfernte VIP ICE ist die Referenz für die Nacht in Nord-Isère und erfindet sich immer wieder neu, um den neuesten Trends zu entsprechen und seine treuen Clubber immer mehr zufrieden zu stellen."
    ],
    "en": [
      "5 minutes from Bourgoin-Jallieu, the Saint-Savin Ice Rink welcomes you with your family, friends or work colleagues in a 1500m2 complex\r\nThe VIP ICE, the reference of the night in Nord-Isère and much more than a disco."
    ],
    "it": [
      "A 5 minuti da Bourgoin-Jallieu, il VIP ICE è il punto di riferimento della notte nel Nord-Isère e non smette mai di reinventarsi per corrispondere alle ultime tendenze e soddisfare i suoi fedeli frequentatori di discoteche."
    ],
    "fr": [
      "A 5 minutes de Bourgoin-Jallieu, Le VIP ICE est la référence de la nuit en Nord-Isère et ne cesse de se réinventer pour correspondre au mieux aux dernières tendances et satisfaire toujours plus ses fidèles clubbeurs."
    ],
    "nl": [
      "De VIP ICE, op 5 minuten van Bourgoin-Jallieu, is de referentie van de nacht in Nord-Isère en blijft zichzelf steeds opnieuw uitvinden om aan de laatste trends te beantwoorden en zijn trouwe clubbers tevreden te stellen."
    ],
    "es": [
      "A 5 minutos de Bourgoin-Jallieu, el VIP ICE es la referencia de la noche en Nord-Isère y no deja de reinventarse para corresponder a las últimas tendencias y satisfacer a sus fieles clubbers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Club VIP ICE Discothèque de Saint-Savin"
    ]
  },
