  "rdfs:comment": {
    "de": [
      "Dorf Aubazat: Alte Kirche mit Grablegung aus dem 15. Jahrhundert aus polychromem Holz. Romanische Kapelle von Peyrusse mit Wandmalereien aus dem 13. Jahrhundert. Madonna in Majestät und Antependium aus dem 18."
    ],
    "en": [
      "Village of Aubazat: Old church with 15th-century polychrome wooden Entombment. Peyrusse Romanesque chapel with 13th-century wall paintings. 18th-century Virgin in Majesty and antependium."
    ],
    "it": [
      "Villaggio di Aubazat: antica chiesa con sepoltura lignea policroma del XV secolo. Cappella romanica di Peyrusse con dipinti murali del XIII secolo. Vergine in Maestà e paliotto del XVIII secolo."
    ],
    "fr": [
      "Village d'Aubazat : Église ancienne avec Mise au tombeau du XVe siècle en bois polychrome. Chapelle romane de Peyrusse avec peintures murales du XIIIe siècle. Vierge en Majesté et antependium du XVIIIe siècle."
    ],
    "es": [
      "Pueblo de Aubazat: Antigua iglesia con sepulcro de madera policromada del siglo XV. Capilla románica de Peyrusse con pinturas murales del siglo XIII. Virgen en Majestad y antependio del siglo XVIII."
    ],
    "nl": [
      "Dorp Aubazat: Oude kerk met polychroom houten grafmonument uit de 15e eeuw. Romaanse kapel van Peyrusse met 13e-eeuwse muurschilderingen. Maagd in Majesteit en antependium uit de 18e eeuw."
    ]
  },
