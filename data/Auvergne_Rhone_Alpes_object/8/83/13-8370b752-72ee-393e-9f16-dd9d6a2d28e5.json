  "rdfs:comment": {
    "de": [
      "Ein Fluchtspiel für 2 bis 4 Spieler. Die Teilnehmer erleben die Flucht des Widerstandskämpfers Claude Hettier de Boislambert während des Zweiten Weltkriegs. Lösen Sie Rätsel, um diesen spektakulären Ausbruch aus dem Gefängnis von Gannat zu verstehen."
    ],
    "en": [
      "Escape game for 2 to 4 players. Participants relive the escape of resistance fighter Claude Hettier de Boislambert during the Second World War. Solve riddles to understand this spectacular escape from Gannat prison."
    ],
    "it": [
      "Gioco di fuga per 2-4 giocatori. I partecipanti rivivranno la fuga del combattente della resistenza Claude Hettier de Boislambert durante la Seconda guerra mondiale. Risolvete gli indovinelli per capire questa spettacolare fuga dalla prigione di Gannat."
    ],
    "fr": [
      "Jeu d’évasion de 2 à 4 joueurs. Les participants vont revivre l’évasion du résistant Claude Hettier de Boislambert durant la Seconde Guerre Mondiale. Résolution d'énigmes pour comprendre cette évasion spectaculaire de la prison de Gannat."
    ],
    "nl": [
      "Ontsnappingsspel voor 2 tot 4 spelers. Deelnemers herbeleven de ontsnapping van verzetsstrijder Claude Hettier de Boislambert tijdens de Tweede Wereldoorlog. Los raadsels op om deze spectaculaire ontsnapping uit de gevangenis van Gannat te begrijpen."
    ],
    "es": [
      "Juego de escape para 2 a 4 jugadores. Los participantes revivirán la fuga del resistente Claude Hettier de Boislambert durante la Segunda Guerra Mundial. Resuelve enigmas para comprender esta espectacular fuga de la prisión de Gannat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape game \"Cellule 42\""
    ]
  },
