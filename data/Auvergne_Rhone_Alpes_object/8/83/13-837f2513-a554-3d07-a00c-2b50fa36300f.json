  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Orcival empfängt und bewirtet Sie die Auberge Le Cantou. Entdecken Sie die vergessenen Aromen einer traditionellen Küche."
    ],
    "en": [
      "In the heart of the village of Orcival, the Auberge Le Cantou welcomes you and serves you food. Discover the forgotten flavours of a traditional cuisine."
    ],
    "it": [
      "Nel cuore del villaggio di Orcival, l'Auberge Le Cantou vi accoglie e vi serve del cibo. Riscoprire i sapori dimenticati di una cucina tradizionale."
    ],
    "fr": [
      "Au cœur du village d'Orcival, l’Auberge Le Cantou vous accueille et vous restaure. Retrouvez les saveurs oubliées d’une cuisine traditionnelle."
    ],
    "nl": [
      "In het hart van het dorp Orcival heet de Auberge Le Cantou u welkom en serveert u eten. Herontdek de vergeten smaken van een traditionele keuken."
    ],
    "es": [
      "En el corazón del pueblo de Orcival, el Auberge Le Cantou le da la bienvenida y le sirve la comida. Redescubra los sabores olvidados de una cocina tradicional."
    ]
  },
