  "rdfs:comment": {
    "de": [
      "Maison Le Fournier unterstützt Privatpersonen, Architekten und Fachleute aus der Luxusbranche bei der Schaffung einzigartiger Innenräume. Zwischen französischem Tapezierhandwerk, hochwertiger Dekoration und künstlerischer Leitung wird jedes Projekt zu einem maßgeschneiderten Raum."
    ],
    "en": [
      "Maison Le Fournier helps individuals, architects and luxury professionals create unique interiors. French upholstery expertise, top-of-the-range decoration and artistic direction combine to turn each project into a made-to-measure piece."
    ],
    "it": [
      "La Maison Le Fournier aiuta privati, architetti e professionisti del lusso a creare interni unici. La combinazione di competenza francese nella tappezzeria, decorazione di alta gamma e direzione artistica fa sì che ogni progetto diventi un pezzo su misura."
    ],
    "fr": [
      "Maison Le Fournier accompagne particuliers, architectes et professionnels du luxe dans la création d’intérieurs uniques. Entre savoir-faire tapissier français, décoration haut de gamme et direction artistique, chaque projet devient une pièce sur mesure."
    ],
    "nl": [
      "Maison Le Fournier helpt particulieren, architecten en luxeprofessionals bij het creëren van unieke interieurs. De combinatie van Franse stofferingsexpertise, topdecoratie en artistieke richting betekent dat elk project een stuk maatwerk wordt."
    ],
    "es": [
      "Maison Le Fournier ayuda a particulares, arquitectos y profesionales del lujo a crear interiores únicos. La experiencia francesa en tapicería, la decoración de alta gama y la dirección artística se combinan para convertir cada proyecto en una pieza a medida."
    ]
  },
