  "rdfs:comment": {
    "de": [
      "Das Maison des pratiques artistiques tous azimuts bietet das ganze Jahr über Kurse, Workshops und Praktika in Zeichnen, Malen und Drucken für alle Altersgruppen und Niveaus an. Außerdem gibt es Kunsttherapiekurse, jährliche Pilates- und Iyengar-Yogakurse."
    ],
    "en": [
      "The center for all kinds of artistic practices offers classes, workshops, and courses in drawing, painting, and engraving throughout the year, for all ages and levels. It also offers art therapy courses and annual Pilates and Iyengar yoga classes."
    ],
    "it": [
      "La maison des pratiques artistiques tous azimuts offre tutto l'anno corsi, laboratori e workshop di disegno, pittura e stampa, per tutte le età e i livelli. Ci sono anche corsi di arteterapia e lezioni annuali di Pilates e Iyengar yoga."
    ],
    "fr": [
      "La maison des pratiques artistiques tous azimuts propose toute l'année des cours, ateliers et stages de dessin, peinture, gravure, pour tous les âges et tous les niveaux. Et aussi des stages d'art thérapie, des cours annuels de Pilates et de yoga Iyengar."
    ],
    "es": [
      "La maison des pratiques artistiques tous azimuts ofrece durante todo el año cursos, talleres y cursillos de dibujo, pintura y grabado, para todas las edades y niveles. También hay cursos de arteterapia y clases anuales de pilates y yoga Iyengar."
    ],
    "nl": [
      "La maison des pratiques artistiques tous azimuts biedt het hele jaar door cursussen, workshops en ateliers in tekenen, schilderen en prenten maken, voor alle leeftijden en niveaus. Er zijn ook cursussen kunstzinnige therapie en jaarlijkse Pilates- en Iyengar yogalessen."
    ]
  },
  "rdfs:label": {
