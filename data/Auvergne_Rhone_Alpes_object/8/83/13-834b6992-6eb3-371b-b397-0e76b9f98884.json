  "rdfs:comment": {
    "de": [
      "From The Inside sind sechs Musiker aus Clermont-Ferrand, die entschlossen sind, das Adrenalin von Linkin Park auf der Bühne wieder aufleben zu lassen. Die Band hat eine offensichtliche Komplizenschaft, einen massiven Sound und eine Präzision, die auffällt: Die Band erschafft die Welt des kalifornischen Nu Metal neu."
    ],
    "en": [
      "From The Inside are 6 musicians from Clermont-Ferrand, determined to bring the adrenalin of Linkin Park back to the stage. With their obvious complicity, massive sound and striking precision, the band recreate the world of Californian Nu Metal."
    ],
    "it": [
      "I From The Inside sono 6 musicisti di Clermont-Ferrand, determinati a riportare sul palco l'adrenalina dei Linkin Park. Con la loro evidente complicità, il suono massiccio e la precisione impressionante, la band ricrea il mondo del Nu Metal californiano."
    ],
    "fr": [
      "From The Inside c'est 6 musiciens clermontois décidés à faire renaître sur scène l’adrénaline de Linkin Park. Une complicité évidente, un son massif, une précision qui frappe : le groupe recrée l’univers du Nu Metal californien."
    ],
    "nl": [
      "From The Inside zijn 6 muzikanten uit Clermont-Ferrand, vastbesloten om de adrenaline van Linkin Park terug te brengen op het podium. Met hun overduidelijke medeplichtigheid, massieve geluid en opvallende precisie herschept de band de wereld van de Californische Nu Metal."
    ],
    "es": [
      "From The Inside son 6 músicos de Clermont-Ferrand, decididos a devolver la adrenalina de Linkin Park a los escenarios. Con su evidente complicidad, su sonido masivo y su impactante precisión, la banda recrea el mundo del Nu Metal californiano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : FROM THE INSIDE (TRIBUTE LINKIN PARK) + BASAALT"
    ]
  },
