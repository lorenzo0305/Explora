  "rdfs:comment": {
    "de": [
      "L'Ours befindet sich auf einer Höhe von 1400 m. Der Startplatz ist günstig von E, SE bis S. Um zu Fuß dorthin zu gelangen, benötigen Sie 1 Stunde. Parken Sie in Le Tiocan und folgen Sie dem Weg, der über Thoiry devant nach Le Reculet führt."
    ],
    "en": [
      "L'Ours is located at an altitude of 1400 m. The take-off is favourable from E, SE to S. It takes 1 hour to get there on foot. Park at Tiocan and follow the path to Le Reculet via Thoiry in front."
    ],
    "it": [
      "L'Ours si trova a 1400 m di altitudine. Il decollo è favorevole da E, SE a S. Per arrivarci a piedi ci vuole 1 ora. Parcheggiare a Tiocan e seguire il sentiero per Le Reculet passando per Thoiry di fronte."
    ],
    "fr": [
      "L’Ours se situe à une altitude de 1400 m. Le décollage est favorable de E, SE à S. Pour y accéder à pieds il faut compter 1h. Se garer au Tiocan et suivre le chemin menant au Reculet par Thoiry devant."
    ],
    "es": [
      "L'Ours se encuentra a una altitud de 1400 m. El despegue es favorable desde el E, SE al S. Para llegar a pie se necesita 1 hora. Aparcar en Tiocan y seguir el camino hacia Le Reculet por Thoiry en frente."
    ],
    "nl": [
      "L'Ours ligt op een hoogte van 1400 m. De start is gunstig vanuit E, SE tot S. Om er te voet te komen duurt het 1 uur. Parkeer bij Tiocan en volg het pad naar Le Reculet via Thoiry aan de voorkant."
    ]
  },
  "rdfs:label": {
    "en": [
      "Paragliding site L'ours"
    ],
    "fr": [
      "Site de parapente de l'ours"
    ]
  },
