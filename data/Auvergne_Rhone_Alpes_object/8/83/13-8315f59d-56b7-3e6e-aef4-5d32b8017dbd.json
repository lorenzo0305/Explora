  "rdfs:comment": {
    "de": [
      "Das Hotel Les Côtes befindet sich 500 m von der Seilbahn Super-Morzine und 5 Gehminuten vom Place de l'Eglise entfernt. Es verbindet den Komfort eines 3-Sterne-Hotels mit der Unabhängigkeit einer Residenz mit zahlreichen kostenlosen Freizeiteinrichtungen."
    ],
    "en": [
      "Hotel Les Côtes is located 500 meters from the Super-Morzine lift and 5 min walk to the church place. It combines the comfort of a 3 star hotel and the independency of a self-catered accommodation with numerous leisure facilities for free.  Run by the Family Marullaz since 1951, it is the perfect spot for your next Morzine Holidays!"
    ],
    "it": [
      "L'hotel Les Côtes si trova a 500 metri dalla funivia Super-Morzine e a 5 minuti a piedi da Place de l'Eglise. Combina il comfort di un hotel a 3 stelle con l'indipendenza di un residence e una serie di strutture ricreative gratuite."
    ],
    "fr": [
      "L’hôtel Les Côtes est situé à 500m de la télécabine de Super-Morzine et 5 min à pied de la place de l’Eglise. Il combine le confort d’un hôtel 3 étoiles et l'indépendance d'une résidence avec de nombreux équipement de loisirs gratuits."
    ],
    "nl": [
      "Hotel Les Côtes ligt op 500 meter van de kabelbaan Super-Morzine en op 5 minuten lopen van het Place de l'Eglise. Het combineert het comfort van een 3-sterrenhotel met de onafhankelijkheid van een residentie en tal van gratis recreatiefaciliteiten."
    ],
    "es": [
      "El hotel Les Côtes está situado a 500 metros del teleférico Super-Morzine y a 5 minutos a pie de la Place de l'Eglise. Combina el confort de un hotel de 3 estrellas con la independencia de una residencia y un sinfín de instalaciones de ocio gratuitas."
    ]
  },
