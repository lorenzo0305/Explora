  "rdfs:comment": {
    "de": [
      "Winzer mit eigenem Weinkeller auf einem Familienweingut seit vier Generationen. Anbau in Agrarökologie mit dem Label HVE. Verkauf auf dem Weingut: AOC Vinsobres und CDR Rot-, Rosé- und Weißweine in Flaschen und lose. Olivenöl aus der Domäne. Weinkeller für Verkostungen."
    ],
    "en": [
      "Independent winemaker on a family estate. Traditional farming for 4 generations. Sale on site: PDO Vinsobres wines and CDR red, rosé, and white wines. Bottles and bulk. Olive oil of the estate. Tasting cellar."
    ],
    "it": [
      "Viticoltore in cantina privata in una tenuta di famiglia da 4 generazioni. Coltivazione agroecologica con il marchio HVE. Vendita in azienda: vini rossi, rosati e bianchi AOC Vinsobres e CDR in bottiglia e sfusi. Olio d'oliva della tenuta. Cantina di degustazione."
    ],
    "fr": [
      "Vigneron en cave particulière sur un domaine familial depuis 4 générations. Culture  en agroécologie avec le label HVE. Vente au Domaine : vins AOC Vinsobres et CDR rouge, rosé, blanc en bouteilles et vrac. Huile d'Olive du domaine. Caveau de dégustation."
    ],
    "nl": [
      "Zelfstandige wijnkelder, familiedomein. Traditiegetrouw al 4 generaties lang. Verkoop van onze producten: AOC Vinsobres, CDR rood, rosé en wit. Flessen en bulkverkoop. Olijfolie van het domein. Proefkelder."
    ],
    "es": [
      "Viticultor en bodega privada en una finca familiar desde hace 4 generaciones. Cultivo agroecológico con la etiqueta HVE. Venta en la finca: vinos AOC Vinsobres y CDR tintos, rosados y blancos en botella y a granel. Aceite de oliva de la finca. Bodega de degustación."
    ]
  },
