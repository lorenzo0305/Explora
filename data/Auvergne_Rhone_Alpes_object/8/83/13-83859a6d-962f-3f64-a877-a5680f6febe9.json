  "rdfs:comment": {
    "de": [
      "Die Orgel bekannt zu machen, musikalische Aktivitäten zu schaffen und zu unterhalten, das Studium der Orgel zu fördern und zu ermöglichen, für die ordnungsgemäße Funktion und Nutzung der Orgeln der Protestantischen Kirche von Valencia zu sorgen."
    ],
    "en": [
      "To raise awareness of the organ, to create and lead musical activities, to promote and enable the study of the organ, to ensure the proper functioning and use of the organs of the Protestant Church of Valence."
    ],
    "it": [
      "Far conoscere l'organo, creare e animare attività musicali, promuovere e permettere lo studio dell'organo, vigilare sul buon funzionamento e sul buon uso degli organi della Chiesa protestante di Valencia."
    ],
    "fr": [
      "Faire connaître l’orgue, créer et animer des activités musicales, promouvoir et permettre l’étude de l’orgue, veiller au bon fonctionnement et à la bonne utilisation des orgues de l’Eglise Protestante de Valence."
    ],
    "nl": [
      "Het vergroten van de bekendheid van het orgel, het creëren en leiden van muzikale activiteiten, het bevorderen en mogelijk maken van orgelstudie en het zorgen voor de goede werking en het juiste gebruik van de orgels in de Protestantse Kerk in Valence."
    ],
    "es": [
      "Dar a conocer el órgano, crear y animar actividades musicales, promover y permitir el estudio del órgano, velar por el buen funcionamiento y el buen uso de los órganos de la Iglesia Protestante de Valencia."
    ]
  },
