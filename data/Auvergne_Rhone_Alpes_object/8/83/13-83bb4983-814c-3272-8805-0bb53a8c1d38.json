  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Kamm-Museum oder die Grande Vapeur einzeln oder in einer Gruppe. Entdecken Sie die Sammlungen des Museums mit Erklärungen, um sie besser zu verstehen. 3 Termine für das Museum, 2 Termine für die Grande Vapeur."
    ],
    "en": [
      "Visit the Musée du Peigne or the Grande Vapeur individually or in a group. Discover the museum's collections with explanations, for a better understanding. 3 dates for the Museum, 2 dates for the Grande Vapeur."
    ],
    "it": [
      "Visitate il Musée du Peigne o la Grande Vapeur individualmente o in gruppo. Scoprite le collezioni del museo con spiegazioni che vi aiuteranno a comprenderle meglio. 3 date per il Museo, 2 date per la Grande Vapeur."
    ],
    "fr": [
      "Visiter le Musée du Peigne ou la Grande Vapeur individuellement ou en groupe. Découvrir les collections du musée avec des explications, pour mieux comprendre. 3 dates pour le Musée, 2 dates pour la Grande Vapeur."
    ],
    "es": [
      "Visite el Musée du Peigne o la Grande Vapeur individualmente o en grupo. Descubra las colecciones del museo con explicaciones que le ayudarán a comprenderlas mejor. 3 fechas para el Museo, 2 fechas para la Grande Vapeur."
    ],
    "nl": [
      "Bezoek het Musée du Peigne of de Grande Vapeur individueel of in groep. Ontdek de collecties van het museum met uitleg om ze beter te begrijpen. 3 data voor het museum, 2 data voor de Grande Vapeur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les visites de l'été au Musée du Peigne"
    ]
  },
