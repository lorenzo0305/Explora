  "rdfs:comment": {
    "de": [
      "ALPIZEN steht für einen Ort, der ausschließlich dem Wohlbefinden gewidmet ist und ein einzigartiges Konzept von Aufenthalten bietet, die sich auf Entspannung und Revitalisierung durch eine individuelle Kombination natürlicher Gesundheitsmethoden konzentrieren."
    ],
    "en": [
      "ALPIZEN is a place dedicated exclusively to well-being, offering a unique concept of stays focused on relaxation and revitalization through a personalized combination of natural health methods."
    ],
    "it": [
      "ALPIZEN è un luogo dedicato esclusivamente al benessere, che offre un concetto unico di vacanza incentrato sul relax e la rivitalizzazione attraverso una combinazione personalizzata di metodi di salute naturali."
    ],
    "fr": [
      "ALPIZEN représente un lieu exclusivement dédié au bien-être, offrant un concept unique de séjours axés sur la détente et la revitalisation grâce à une combinaison personnalisée de méthodes de santé naturelle."
    ],
    "nl": [
      "ALPIZEN is een plek die uitsluitend gewijd is aan welzijn en biedt een uniek vakantieconcept dat gericht is op ontspanning en revitalisering door middel van een gepersonaliseerde combinatie van natuurlijke gezondheidsmethoden."
    ],
    "es": [
      "ALPIZEN es un lugar dedicado exclusivamente al bienestar, que ofrece un concepto único de vacaciones centradas en la relajación y la revitalización mediante una combinación personalizada de métodos naturales de salud."
    ]
  },
