  "rdfs:comment": {
    "de": [
      "Auf dieser kurzen Trailroute, die im Dorf Rochefort-en-Valdaine beginnt, können Sie die Anhöhen des Dorfes mit dem Schloss von Rochefort-en-Valdaine und die Wälder mit ihren mediterranen Baumarten erkunden."
    ],
    "en": [
      "This short trail from the village of Rochefort-en-Valdaine explores the heights of the village, with the Rochefort-en-Valdaine castle and Mediterranean woods."
    ],
    "it": [
      "Questo breve sentiero che parte dal villaggio di Rochefort-en-Valdaine esplora le alture del villaggio, con il castello di Rochefort-en-Valdaine e il bosco mediterraneo."
    ],
    "fr": [
      "Ce court itinéraire de trail au départ du village de Rochefort-en-Valdaine permet d'explorer les hauteurs du village avec le château de Rochefort-en-Valdaine et les bois aux essences méditerranéennes."
    ],
    "es": [
      "Este corto sendero desde el pueblo de Rochefort-en-Valdaine explora las alturas del pueblo, con el castillo de Rochefort-en-Valdaine y el bosque mediterráneo."
    ],
    "nl": [
      "Dit korte pad vanuit het dorp Rochefort-en-Valdaine verkent de hoogten van het dorp, met het kasteel van Rochefort-en-Valdaine en de mediterrane bossen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Montagne de la Série et Bois de Fonbrenoux"
    ]
  },
