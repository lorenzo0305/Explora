  "rdfs:comment": {
    "de": [
      "Sein Industriegebäude sieht aus wie eine Skaterrampe; es beherbergt eine Bowl und einen Streetbereich aus Holz, die von der Betreibervereinigung Session Libre entworfen wurden."
    ],
    "en": [
      "In an industrial building, whose roof reminds the design of a skate ramp, the riders practise in a bowl and wood “street” area."
    ],
    "it": [
      "L'edificio industriale ha l'aspetto di una rampa da skateboard; ospita una vasca in legno e un'area stradale progettata dall'associazione di gestione Session Libre."
    ],
    "fr": [
      "Son bâtiment industriel a des allures de rampe de skate ; il abrite un bowl et une partie street en bois conçus par l'association gestionnaire Session Libre."
    ],
    "nl": [
      "Het industriële gebouw ziet eruit als een skateboardhelling; het herbergt een houten kom en een straatgedeelte ontworpen door de beheerdersvereniging Session Libre."
    ],
    "es": [
      "En una nave industrial cuyo techo recuerda el diseño de una rampa de skate, los practicantes se entrenan en un “bowl” y en un espacio “street” en madera."
    ]
  },
