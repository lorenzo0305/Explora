  "rdfs:comment": {
    "de": [
      "Lo Festenal: Das Festival der okzitanischen Kulturen (fèsta de las culturas occitanas) kehrt für seinen achten Frühling in das Maison Pour Tous in Chadrac zurück. Ein reichhaltiger Tag mit Workshops, Aufführungen und einem Abend mit gezeichnetem Konzert und Tanz!"
    ],
    "en": [
      "Lo Festenal: the festival of Occitan cultures (fèsta de las culturas occitanas) returns for its eighth spring at Chadrac's Maison Pour Tous. A full day of workshops, shows and an evening concert and dance!"
    ],
    "it": [
      "Lo Festenal: il festival delle culture occitane (fèsta de las culturas occitanas) torna per la sua ottava primavera alla Maison Pour Tous di Chadrac. Un'intera giornata di laboratori, spettacoli e una serata di disegno e danza!"
    ],
    "fr": [
      "Lo Festenal : le festival des cultures occitanes (fèsta de las culturas occitanas) revient pour son huitième printemps à la Maison Pour Tous de Chadrac. Une journée riche avec ateliers, spectacles et une soirée concert dessiné et bal !"
    ],
    "nl": [
      "Lo Festenal: het festival van de Occitaanse culturen (fèsta de las culturas occitanas) keert terug voor zijn achtste lente in het Maison Pour Tous in Chadrac. Een volle dag met workshops, voorstellingen en een avond vol tekeningen en dans!"
    ],
    "es": [
      "Lo Festenal: el festival de las culturas occitanas vuelve en su octava primavera a la Maison Pour Tous de Chadrac. Una jornada repleta de talleres, espectáculos y una velada de dibujo y danza"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival Lo Festenal à la Couveuse"
    ]
  },
