  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Saint-Germain-des-Fossés, eine alte Stadt in der Auvergne und später im Bourbonnais, liegt angenehm auf einem Vorgebirge, einer Art Sporn, der sich bis zum Zusammenfluss von Mourgon und Allier absenkend nach vorne schiebt."
    ],
    "en": [
      "Free admission. Saint-Germain-des-Fossés, an ancient town in the Auvergne region, then in the Bourbonnais region, is pleasantly situated on a promontory, a sort of spur that slopes down to the confluence of the Mourgon and Allier rivers."
    ],
    "it": [
      "Ingresso libero. Saint-Germain-des-Fossés, antica città dell'Alvernia e poi del Bourbonnais, è piacevolmente situata su un promontorio, una sorta di sperone che degrada verso la confluenza dei fiumi Mourgon e Allier."
    ],
    "fr": [
      "Accès libre. Saint-Germain-des-Fossés, ancienne ville d'Auvergne, puis du Bourbonnais, est agréablement située sur un promontoire, sorte d'éperon qui s'avance, en s'affaissant jusqu'au confluent du Mourgon et de l'Allier."
    ],
    "nl": [
      "Gratis toegang. Saint-Germain-des-Fossés, een oude stad in de Auvergne en later de Bourbonnais, is aangenaam gelegen op een voorgebergte, een soort uitloper die afloopt naar de samenvloeiing van de rivieren de Mourgon en de Allier."
    ],
    "es": [
      "Entrada gratuita. Saint-Germain-des-Fossés, antigua ciudad de Auvernia y más tarde del Bourbonnais, está agradablemente situada sobre un promontorio, una especie de espolón que desciende hasta la confluencia de los ríos Mourgon y Allier."
    ]
  },
