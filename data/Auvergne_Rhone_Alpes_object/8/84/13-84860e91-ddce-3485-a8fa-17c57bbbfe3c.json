  "rdfs:comment": {
    "de": [
      "Ein Raum, viele Bücher. 3 Räume, 11.000 Bücher zu Ihrer Verfügung.\r\nAlben, Comics, Dokumentarfilme, Zeitschriften, Romane, Spielbücher, Bücher zum Anfassen - die Bibliothek bietet Ihnen die Möglichkeit, die Freude am Lesen schon in jungen Jahren zu entdecken."
    ],
    "en": [
      "Space, books. 3 rooms, 11,000 books at your disposal.\r\nAlbums, comic books, documentaries, magazines, novels, game books, books to touch, the library invites you to discover the pleasure of reading from a very young age..."
    ],
    "it": [
      "Uno spazio, molti libri. 3 sale, 11.000 libri a disposizione.\r\nAlbum, fumetti, documentari, riviste, romanzi, giochi e libri da toccare: la biblioteca vi offre la possibilità di scoprire il piacere della lettura fin da piccoli."
    ],
    "fr": [
      "Un espace, des livres. 3 salles, 11 000 livres à votre disposition.\r\nAlbums, BD, documentaires, magazines, romans, livres jeux, livres à toucher, la bibliothèque vous propose de découvrir le plaisir de la lecture dès le plus jeune âge.."
    ],
    "es": [
      "Un espacio, muchos libros. 3 salas, 11.000 libros a tu disposición.\r\nÁlbumes, cómics, documentales, revistas, novelas, juegos y libros para tocar: la biblioteca te ofrece la oportunidad de descubrir el placer de la lectura desde una edad temprana."
    ],
    "nl": [
      "Eén ruimte, vele boeken. 3 zalen, 11.000 boeken tot je beschikking.\r\nAlbums, strips, documentaires, tijdschriften, romans, spelletjes, boeken om aan te raken, de bibliotheek biedt je de kans om het plezier van lezen van jongs af aan te ontdekken..."
    ]
  },
