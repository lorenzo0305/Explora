  "rdfs:comment": {
    "de": [
      "Im Sektor Loze können Sie die sonnigen Pisten genießen und auf Entdeckungsreise zu den Drachen gehen, die die Piste säumen. Nutzen Sie die Rastplätze: 2 Hängemattenbereiche mit Blick auf das Tal und ein Chalet mit allem Komfort in der Privatsphäre einer Lichtung."
    ],
    "en": [
      "On the Loze, enjoy the sunny slopes and discover the Dragons around the track, and have a break : 2 hammock areas overlooking the valley and comfortable tiny relaxing chalet."
    ],
    "it": [
      "Nel settore di Loze, godetevi i pendii soleggiati e scoprite i Draghi che costeggiano il pendio, e approfittate delle aree di sosta: 2 aree amache con vista sulla valle e un comodo chalet nella privacy di una radura."
    ],
    "fr": [
      "Sur le secteur de la Loze, profitez des pistes ensoleillées et partez à la découverte des Dragons qui bordent la piste, et profitez des aires de repos : 2 zones de hamacs avec vue sur la vallée et chalet tout confort dans l'intimité d'une clairière."
    ],
    "nl": [
      "Geniet in de sector Loze van de zonnige hellingen en ontdek de Draken die aan de helling grenzen, en profiteer van de rustplaatsen: 2 hangmatten met uitzicht op de vallei en een comfortabel chalet in de beslotenheid van een open plek."
    ],
    "es": [
      "En el sector de Loze, disfrute de las laderas soleadas y descubra los Dragones que bordean la ladera, y aproveche las áreas de descanso: 2 zonas de hamacas con vistas al valle y un cómodo chalet en la intimidad de un claro."
    ]
  },
  "rdfs:label": {
    "en": [
      "Loze Chairlift"
    ],
    "fr": [
      "Télésiège Loze"
    ],
    "nl": [
      "Loze stoeltjeslift"
    ]
  },
