      "dc:description": {
        "de": [
          "Obst und Gemüse der Saison, Eier.\nGeöffnet am Donnerstag-, Freitag- und Samstagnachmittag von 15:00 bis 19:00 Uhr."
        ],
        "en": [
          "Seasonal fruit and vegetables, eggs.\nOpen Thursday, Friday and Saturday afternoons from 3pm to 7pm."
        ],
        "it": [
          "Frutta e verdura di stagione, uova.\nAperto giovedì, venerdì e sabato pomeriggio dalle 15.00 alle 19.00."
        ],
        "fr": [
          "Fruits et légumes de saison, oeufs.\nOuvert les jeudi, vendredi et samedi après-midis de 15h à 19h."
        ],
        "nl": [
          "Seizoensfruit en -groenten, eieren.\nGeopend op donderdag-, vrijdag- en zaterdagmiddag van 15.00 tot 19.00 uur."
        ],
        "es": [
          "Frutas y verduras de temporada, huevos.\nAbierto jueves, viernes y sábados por la tarde de 15.00 a 19.00 h."
        ]
      },
