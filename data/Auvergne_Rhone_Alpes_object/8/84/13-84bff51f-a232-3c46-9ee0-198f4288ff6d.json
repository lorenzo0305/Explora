  "rdfs:comment": {
    "de": [
      "Der Kunstschmied Abdelati Aatif öffnet Ihnen die Türen seiner Werkstatt.\r\n\r\nEr bietet Ihnen am Donnerstag, den 9. April um 14 Uhr eine Schmiedevorführung an (Dauer: 1 Stunde - mit Reservierung)."
    ],
    "en": [
      "Abdelati Aatif, ironworker, opens the doors of his workshop.\r\n\r\nHe offers a forging demonstration on Thursday April 9 at 2pm (duration: 1h - booking required)."
    ],
    "it": [
      "Abdelati Aatif, artigiano del ferro battuto, vi apre le porte del suo laboratorio.\r\n\r\nGiovedì 9 aprile alle 14.00 si terrà una dimostrazione di forgiatura (durata: 1 ora - prenotazione obbligatoria)."
    ],
    "fr": [
      "Abdelati Aatif, ferronnier d'art, vous ouvre les portes de son atelier.\r\n\r\nIl vous propose une démonstration de forge le Jeudi 9 avril à 14h (durée : 1h - sur réservation)."
    ],
    "es": [
      "Abdelati Aatif, artesano del hierro forjado, le abre las puertas de su taller.\r\n\r\nHabrá una demostración de forja el jueves 9 de abril a las 14:00 (duración: 1 hora - reserva obligatoria)."
    ],
    "nl": [
      "Abdelati Aatif, ambachtsman van smeedijzer, opent de deuren van zijn werkplaats voor je.\r\n\r\nEr is een smeeddemonstratie op donderdag 9 april om 14.00 uur (duur: 1 uur - reserveren verplicht)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Portes ouvertes de Aatif Ferronnerie #8 - Journées Européennes des Métiers d'Art"
    ]
  },
