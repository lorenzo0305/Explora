  "rdfs:comment": {
    "de": [
      "Das diskrete Spa\r\nÖffnen Sie die Türen zum Wellnessbereich des Chalet La Perle de l'Oisans****\r\nSie werden in ein Universum eintauchen, in dem Schönheit und Wohlbefinden die Handschrift von Pure Altitude tragen."
    ],
    "en": [
      "The Discreet Spa Open the doors of the wellness area of Chalet La Perle de l'Oisans ****. You will dive into a universe where beauty and well-being are the hallmarks of Pure Altitude."
    ],
    "it": [
      "La Spa discreta\r\nEntrate nell'area benessere dello Chalet La Perle de l'Oisans****.\r\nImmergetevi in un mondo di bellezza e benessere a Pure Altitude."
    ],
    "fr": [
      "Le Spa Discret\r\nPoussez les portes de l’espace bien-être du Chalet La Perle de l’Oisans****. \r\nVous plongerez dans un univers où la beauté et le bien-être sont signés Pure Altitude."
    ],
    "es": [
      "El Spa discreto\r\nEntre en el espacio de bienestar del Chalet La Perle de l'Oisans****.\r\nSumérjase en un universo de belleza y bienestar de Pura Altitud."
    ],
    "nl": [
      "De discrete spa Open de deuren van de wellnessruimte van Chalet La Perle de l'Oisans ****. Je duikt in een universum waar schoonheid en welzijn de kenmerken zijn van Pure Altitude."
    ]
  },
