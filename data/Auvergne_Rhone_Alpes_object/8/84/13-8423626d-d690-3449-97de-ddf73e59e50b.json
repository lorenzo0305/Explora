  "rdfs:comment": {
    "de": [
      "In der Altstadt von Le Puy-en-Velay befindet sich ein kleines, charmantes Restaurant mit einer originellen Dekoration. Genießen Sie die regionale Küche!"
    ],
    "en": [
      "Push open the door of this charming little restaurant, with its original decor in the heart of the old town of Le Puy-en-Velay, and enjoy local cuisine!"
    ],
    "it": [
      "Aprite la porta di questo piccolo e affascinante ristorante, dall'arredamento originale, nel cuore del centro storico di Le Puy-en-Velay, e gustate la cucina locale!"
    ],
    "fr": [
      "Poussez la porte de ce petit restaurant charmant, à la déco originale au cœur de la vieille ville du Puy-en-Velay et profitez d'une cuisine du terroir !"
    ],
    "nl": [
      "Open de deur van dit charmante restaurantje, met zijn originele inrichting in het hart van het oude centrum van Le Puy-en-Velay, en geniet van de lokale keuken!"
    ],
    "es": [
      "Abra la puerta de este pequeño y encantador restaurante, con su original decoración en el corazón del casco antiguo de Le Puy-en-Velay, y disfrute de la cocina local"
    ]
  },
  "rdfs:label": {
