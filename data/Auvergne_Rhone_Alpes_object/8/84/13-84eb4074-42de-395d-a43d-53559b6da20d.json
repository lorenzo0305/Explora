  "rdfs:comment": {
    "de": [
      "Ein Reitzentrum, das für alle ab 3 Jahren geeignet ist! Genießen Sie Ausritte in voller Montur, um unser wunderbares Reiseziel zu entdecken. Eine Freizeitaktivität, die Sie ohne Mäßigung genießen können!"
    ],
    "en": [
      "An equestrian centre suitable for all and from 3 years old! Come and enjoy a ride in the middle of discovering our marvellous destination. A leisure activity to consume without moderation!"
    ],
    "it": [
      "Un centro di equitazione adatto a tutti, a partire dai 3 anni! Venite a fare un giro all'aria aperta per scoprire la nostra meravigliosa destinazione. Un'attività di svago da praticare senza moderazione!"
    ],
    "fr": [
      "Un centre équestre adapté pour tous et à partir de 3 ans ! Venez profitez de balade en pleine à la découverte de notre merveilleuse destination. Une activité de loisir à consommer sans modération !"
    ],
    "es": [
      "Un centro hípico apto para todos los públicos a partir de los 3 años Venga a disfrutar de un paseo al aire libre para descubrir nuestro maravilloso destino. ¡Una actividad de ocio para disfrutar sin moderación!"
    ],
    "nl": [
      "Een manege geschikt voor iedereen vanaf 3 jaar! Kom en geniet van een ritje in de open lucht om onze prachtige bestemming te ontdekken. Een vrijetijdsbesteding om met mate van te genieten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Equ'yz Nature"
    ]
  },
