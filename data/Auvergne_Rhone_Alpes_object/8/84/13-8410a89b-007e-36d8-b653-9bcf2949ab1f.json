  "rdfs:comment": {
    "de": [
      "Restauration: Arbeitermenü mittags von Montag bis Freitag,Wurst-/Käseplatten und Verkauf zum Mitnehmen, Zimmer(Hotel/Unterkunft) und täglich für Gruppen auf Anfrage.Organisation von Veranstaltungen(Konzerte,Themenabende...)"
    ],
    "en": [
      "Catering: work menu at lunchtime from Monday to Friday, delicatessen/cheese boards and takeaway sales, rooms (hotel/gite) and every day for groups on request. \r\nOrganization of events (concerts, theme nights...)"
    ],
    "it": [
      "Ristorazione: menù dei lavoratori a pranzo dal martedì al venerdì, snack bar a tutte le ore, takeaway, camere (hotel/gîte) e tutti i giorni per gruppi su richiesta. \t\r\nOrganizzazione di eventi (concerti, serate a tema, ecc.)"
    ],
    "fr": [
      "Restauration : menu ouvrier le midi du mardi au vendredi, snack à toutes heures, vente à emporter, chambres (hôtel/gîte) et tous les jours pour les groupes sur demande. \t\r\nOrganisation d’événements (concerts, soirées à thèmes…)"
    ],
    "es": [
      "Restauración: menú para trabajadores al mediodía de martes a viernes, snack bar a todas horas, comida para llevar, habitaciones (hotel/gîte) y a diario para grupos previa petición. \t\r\nOrganización de eventos (conciertos, veladas temáticas, etc.)"
    ],
    "nl": [
      "Catering: arbeidersmenu 's middags van dinsdag tot vrijdag, snackbar op alle uren, afhaalmaaltijden, kamers (hotel/gîte) en dagelijks voor groepen op aanvraag. \t\r\nOrganisatie van evenementen (concerten, thema-avonden, enz.)"
    ]
  },
