  "rdfs:comment": {
    "de": [
      "Unter den Bäumen des Gartens in der schönen Jahreszeit oder am Kamin im Winter, auf Ihrem Teller eine hausgemachte Küche mit frischen Produkten aus der lokalen und saisonalen Landwirtschaft."
    ],
    "en": [
      "Under the trees of the garden in the summer or by the fire in winter, in your plate, a home cooking, with fresh products resulting from the local and seasonal agriculture."
    ],
    "it": [
      "Sotto gli alberi in giardino d'estate o accanto al fuoco d'inverno, nel vostro piatto, cucina casalinga, con prodotti freschi provenienti dall'agricoltura locale e di stagione."
    ],
    "fr": [
      "Sous les arbres du jardin à la belle saison ou au coin du feu en hiver, dans votre assiette, une cuisine maison, aux produits frais issus de l'agriculture locale et saisonnière."
    ],
    "nl": [
      "Onder de bomen in de tuin in de zomer of bij het vuur in de winter, op uw bord, home cooking, met verse producten van lokale en seizoensgebonden landbouw."
    ],
    "es": [
      "Bajo los árboles del jardín en verano o junto al fuego en invierno, en su plato, cocina casera, con productos frescos de la agricultura local y de temporada."
    ]
  },
