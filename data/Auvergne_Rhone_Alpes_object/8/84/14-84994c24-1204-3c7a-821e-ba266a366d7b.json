  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/155a8970-7a8f-3596-b038-061cdf571b38",
      "dc:description": {
        "de": [
          "Die Sushi Bar lädt Sie zu einer einzigartigen kulinarischen Reise ein, die Tradition und Kreativität miteinander verbindet. Unser Lokal bietet eine raffinierte asiatische Küche, die mit frischen und hochwertigen Produkten zubereitet wird.\n\nGeöffnet von Dienstag bis Sonntag von 12:00 bis 14:00 Uhr und von 18:30 bis 22:00 Uhr."
        ],
        "en": [
          "Sushi Bar invites you on a unique culinary journey, combining tradition and creativity. Our establishment offers refined Asian cuisine, prepared with fresh, high-quality ingredients.\n\nOpen Tuesday to Sunday, 12:00 to 14:00 and 18:30 to 22:00."
        ],
        "it": [
          "Il Sushi Bar vi invita a un viaggio culinario unico, che unisce tradizione e creatività. Il nostro ristorante offre una raffinata cucina asiatica, preparata con ingredienti freschi e di alta qualità.\n\nAperto da martedì a domenica dalle 12:00 alle 14:00 e dalle 18:30 alle 22:00."
        ],
        "fr": [
          "Le Sushi Bar vous invite à un voyage culinaire unique, mêlant tradition et créativité. Notre établissement propose une cuisine asiatique raffinée, élaborée avec des produits frais et de qualité.\n\nOuvert du mardi au dimanche de 12h00 à 14h00 et de 18h30 à 22h00."
        ],
        "es": [
          "El Sushi Bar le invita a un viaje culinario único, que combina tradición y creatividad. Nuestro restaurante ofrece una cocina asiática refinada, elaborada con ingredientes frescos y de alta calidad.\n\nAbierto de martes a domingo de 12:00 a 14:00 y de 18:30 a 22:00."
        ],
        "nl": [
          "De Sushi Bar nodigt u uit voor een unieke culinaire reis, waarbij traditie en creativiteit worden gecombineerd. Ons restaurant biedt verfijnde Aziatische gerechten, bereid met verse ingrediënten van hoge kwaliteit.\n\nGeopend van dinsdag tot zondag van 12.00 tot 14.00 uur en van 18.30 tot 22.00 uur."
        ]
      },
