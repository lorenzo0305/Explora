  "rdfs:comment": {
    "de": [
      "Die Saône hat einen sehr vielfältigen Fischbestand: Karpfen, Zander, Hecht, Wels, Plötze, Brasse.... Jeder kann die für ihn geeignete Art finden!"
    ],
    "en": [
      "Fish population: carp, pike-perch, pike-perch, pike-perch, catfish, roach, bream. . ."
    ],
    "it": [
      "La Saona ha una popolazione ittica molto diversificata: carpe, lucioperca, lucci, pesci siluro, lasche, orate... Ce n'è per tutti i gusti!"
    ],
    "fr": [
      "La Saône possède un peuplement piscicole très diversifié : carpe, sandre, brochet, silure, gardon, brème... Chacun pourra trouver l'espèce qui lui convient !"
    ],
    "es": [
      "El Saona cuenta con una población piscícola muy diversa: carpas, luciopercas, luciopercas, luciopercas, cucarachas, sargos... Hay para todos los gustos"
    ],
    "nl": [
      "De Saône heeft een zeer gevarieerde vispopulatie: karper, snoekbaars, snoek, meerval, voorn, brasem... Er is voor ieder wat wils!"
    ]
  },
