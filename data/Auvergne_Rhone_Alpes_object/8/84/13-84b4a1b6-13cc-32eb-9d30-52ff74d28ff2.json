  "rdfs:comment": {
    "de": [
      "Workshops zur Käseverkostung bei Ihnen zu Hause: ein maßgeschneidertes, geselliges Gourmet-Erlebnis. Für Ihre Abende, Veranstaltungen oder Feiern. Genießen Sie zu Hause oder an Ihrem Aufenthaltsort außergewöhnliche Käsesorten und die Möglichkeit, Speisen und Getränke zu kombinieren."
    ],
    "en": [
      "At-home cheese-tasting workshops: a gourmet and convivial experience, tailor-made for you. For your parties, events or celebrations. Enjoy exceptional cheeses and food/drink pairings at home or at your venue."
    ],
    "it": [
      "Laboratori di degustazione di formaggi a domicilio: un'esperienza gastronomica e conviviale, su misura. Per le vostre serate, eventi o celebrazioni. Assaporate formaggi eccezionali e abbinamenti cibo/bevande a casa vostra o nel vostro locale."
    ],
    "fr": [
      "Ateliers de dégustation de fromages à domicile : expérience gourmande et conviviale, sur mesure. Pour vos soirées, événements ou célébrations. Profitez à domicile ou sur votre lieu de séjour, fromages d’exception et possibilités d'accords mets/boissons."
    ],
    "es": [
      "Talleres de degustación de quesos a domicilio: una experiencia gastronómica y de convivencia a medida. Para sus veladas, eventos o celebraciones. Disfrute de quesos excepcionales y maridajes en su casa o en su lugar de celebración."
    ],
    "nl": [
      "Kaasdegustaties aan huis: een gastronomische en gezellige ervaring op maat. Voor uw avonden, evenementen of feesten. Geniet thuis of op je locatie van uitzonderlijke kazen en combinaties van eten en drinken."
    ]
  },
  "rdfs:label": {
