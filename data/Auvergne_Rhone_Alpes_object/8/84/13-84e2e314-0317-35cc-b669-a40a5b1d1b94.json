  "rdfs:comment": {
    "de": [
      "Sommercamp zum Thema Kurzfilmregie im Maison des Isles . Von der Erfindung eines Drehbuchs bis zum Dreh, nimm an jeder Etappe der Herstellung eines Kurzfilms teil und tauche eine Woche lang in die Welt des Kinos ein!"
    ],
    "en": [
      "Summer camp on the theme of making short films at the Maison des Isles. From scriptwriting to filming, take part in every stage of making a short film, for a week immersed in the world of cinema!"
    ],
    "it": [
      "Campo estivo sul tema della realizzazione di cortometraggi alla Maison des Isles. Dalla sceneggiatura alle riprese, partecipate a tutte le fasi della realizzazione di un cortometraggio, per una settimana immersi nel mondo del cinema!"
    ],
    "fr": [
      "Colo d'été sur le thème réalisation court métrage à la maison des isles . De l'invention d'un scénario au tournage, participe à chaque étape de la réalisation d'un film court, le temps d'une semaine immersive dans l'univers du cinéma !"
    ],
    "nl": [
      "Zomerkamp met als thema het maken van korte films in het Maison des Isles. Van het schrijven van het scenario tot het filmen, neem deel aan elke fase van het maken van een korte film, voor een week ondergedompeld in de wereld van de cinema!"
    ],
    "es": [
      "Campamento de verano sobre la realización de cortometrajes en la Maison des Isles. Desde la escritura del guión hasta el rodaje, participe en todas las etapas de la realización de un cortometraje, ¡durante una semana inmerso en el mundo del cine!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Colo' été 2026 - réalisation court métrage"
    ]
  },
