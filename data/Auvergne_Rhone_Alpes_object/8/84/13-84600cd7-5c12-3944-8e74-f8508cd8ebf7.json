  "rdfs:comment": {
    "de": [
      "Dieser Raum bietet ein Programm mit kreativen Workshops für Groß und Klein, den Direktverkauf von Kreationen aus lokalem Kunsthandwerk und einen Co-Working-Bereich mit kreativem Material zur Nutzung durch Privatpersonen oder Fachleute."
    ],
    "en": [
      "This space offers a program of creative workshops for young and old, direct sales of local handicrafts, and a co-working space with creative equipment for use by individuals or professionals."
    ],
    "it": [
      "Questo spazio offre un programma di laboratori creativi per giovani e meno giovani, la vendita diretta di artigianato locale e uno spazio di co-working con materiali creativi per l'uso da parte di singoli o professionisti."
    ],
    "fr": [
      "Cet espace propose une programmation d'ateliers créatifs pour petits et grands, la vente directe de créations d'artisanat local, et un espace de co-working avec du matériel créatif à l'usage des particuliers ou professionnels."
    ],
    "es": [
      "Este espacio ofrece un programa de talleres creativos para jóvenes y mayores, venta directa de artesanía local y un espacio de co-working con materiales creativos para uso de particulares o profesionales."
    ],
    "nl": [
      "Deze ruimte biedt een programma van creatieve workshops voor jong en oud, directe verkoop van lokale ambachten en een co-working ruimte met creatieve materialen voor gebruik door particulieren of professionals."
    ]
  },
