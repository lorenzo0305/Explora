  "rdfs:comment": {
    "de": [
      "Das Cintra ist eine hundert Jahre alte Brasserie, deren Speisekarte aus dem Lyoner Terroir schöpft und ein authentisches kulinarisches Erlebnis in einem Dekor aus geschnitzten Holzarbeiten bietet. Das historische Lokal verfügt über eine der schönsten Terrassen Lyons."
    ],
    "en": [
      "A century-old brasserie, Le Cintra offers a menu that draws on local Lyonnais produce to provide an authentic culinary experience in a setting featuring carved wood panelling. This historic establishment boasts one of the most beautiful terraces in Lyon."
    ],
    "it": [
      "Brasserie centenaria, il Cintra propone un menu che attinge ai prodotti locali di Lione per offrire un'esperienza culinaria autentica in un ambiente rivestito di legno intagliato. Questo locale storico vanta una delle più belle terrazze di Lione."
    ],
    "fr": [
      "Brasserie centenaire, le Cintra propose une carte qui puise dans le terroir lyonnais pour offrir une expérience culinaire authentique dans un décor de boiseries sculptées. Établissement historique, il possède l’une des plus belles terrasses de Lyon."
    ],
    "es": [
      "El Cintra, una brasserie centenaria, ofrece una carta que se inspira en los productos locales de Lyon para ofrecer una auténtica experiencia culinaria en un marco con paneles de madera tallada. Este establecimiento histórico cuenta con una de las terrazas más bellas de Lyon."
    ],
    "nl": [
      "De Cintra, een eeuwenoude brasserie, biedt een menu dat gebruikmaakt van de lokale producten van Lyon voor een authentieke culinaire ervaring in een decor met houtsnijwerk. Dit historische etablissement heeft een van de mooiste terrassen van Lyon."
    ]
  },
