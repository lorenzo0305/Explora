  "rdfs:comment": {
    "de": [
      "Ob in der Gruppe, mit der Familie, für eine Cousinade oder ein Teambuilding, nehmen Sie an diesem Raumspiel teil, bei dem Sie das Tal der Entremonts durchqueren und seine Landschaften, seine Geschichte und seine Legenden entdecken werden."
    ],
    "en": [
      "Whether you're a group, a family, a cousin or a team-builder, come and take part in this game area that will take you through the Entremonts valley, discovering its landscapes, its history and its legends."
    ],
    "it": [
      "Che siate un gruppo, una famiglia, un cugino o un team-builder, venite a partecipare a quest'area di gioco che vi porterà in un viaggio attraverso la valle di Entremonts alla scoperta dei suoi paesaggi, della sua storia e delle sue leggende."
    ],
    "fr": [
      "En groupe, en famille, pour une cousinade ou un team building, venez participer à cet espace game qui vous fera sillonné la vallée des Entremonts à la découverte de ses paysages, son histoire et ses légendes."
    ],
    "es": [
      "Ya seas un grupo, una familia, un primo o un team-builder, ven a participar en este espacio de juego que te llevará de viaje por el valle de Entremonts para descubrir sus paisajes, su historia y sus leyendas."
    ],
    "nl": [
      "Of je nu een groep, een familie, een neef of een teambuilder bent, kom en neem deel aan dit spelgebied dat je meeneemt op een reis door de vallei van Entremonts om zijn landschappen, geschiedenis en legendes te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape game \"La colère d'Hermesende\""
    ]
  },
