  "rdfs:comment": {
    "de": [
      "Das Restaurant Tournebroche bietet eine gesunde Küche mit lokalen Produkten und am Spieß Gebratenem in gemütlichem Rahmen. Traditionelle Küche, Kochen am Spieß ,Fisch und Fleisch,frische und lokale Produkte."
    ],
    "en": [
      "The restaurant Tournebroche offers a healthy cuisine and respectful of the local products, à la broche (cocked on skewer) in a warm and welcoming atmosphere."
    ],
    "it": [
      "Il ristorante Tournebroche offre una cucina sana e allo spiedo con prodotti locali in un'atmosfera calda e accogliente.\r\nCucina tradizionale, pesce e carne allo spiedo, prodotti freschi locali."
    ],
    "fr": [
      "Le restaurant Tournebroche propose une cuisine saine et respectueuse des produits locaux, à la broche dans un cadre et une ambiance chaleureuse.\r\nCuisine traditionnelle, cuisine à la broche , poissons et viandes, produits frais et locaux."
    ],
    "nl": [
      "Het restaurant Tournebroche biedt gezonde, aan het spit geroosterde gerechten met lokale producten in een warme en gastvrije sfeer.\r\nTraditionele keuken, aan het spit geroosterde vis en vlees, verse lokale producten."
    ],
    "es": [
      "El restaurante Tournebroche le propone una cocina sana y asada con productos locales en un ambiente cálido y acogedor.\r\nCocina tradicional, pescados y carnes a la brasa, productos locales frescos."
    ]
  },
