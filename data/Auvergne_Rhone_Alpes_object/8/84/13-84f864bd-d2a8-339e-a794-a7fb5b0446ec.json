  "rdfs:comment": {
    "de": [
      "Die Skilehrer der ESF von Montchavin werden Ihnen ihre Leidenschaft und die besten Techniken des Skifahrens und Snowboardens näher bringen und mit Ihnen teilen."
    ],
    "en": [
      "Apart from passing on their infectious passion for the sport, the Montchavin ski school instructors will also teach you some awesome skiing and snowboarding techniques."
    ],
    "it": [
      "I maestri dell'ESF di Montchavin vi faranno scoprire e condividere la loro passione e le migliori tecniche di sci e snowboard."
    ],
    "fr": [
      "Les moniteurs de l'ESF de Montchavin vous feront découvrir et partager leurs passions et les meilleures techniques du ski, et du snowboard."
    ],
    "es": [
      "Los monitores de la ESF de Montchavin le harán descubrir y compartir su pasión y las mejores técnicas de esquí y snowboard."
    ],
    "nl": [
      "De skileraren van de Franse skischool (EFS) van Montchavin zullen U het skiën leren ontdekken, hun passie met U delen en U de beste ski- en snowboardtechnieken aanleren."
    ]
  },
