  "rdfs:comment": {
    "de": [
      "Orientierungslauf mit den Schwierigkeitsgraden grün, blau und rot, damit jeder seinen Orientierungslauf in vollen Zügen genießen kann. Sie bewegen sich in der Stadt St Julien Chapteuil."
    ],
    "en": [
      "Orienteering course with green, blue, red difficulties so that everyone can fully enjoy their orienteering hike. You evolve in the town of St Julien Chapteuil."
    ],
    "it": [
      "Percorso di orienteering con difficoltà verdi, blu e rosse, in modo che tutti possano godere appieno della loro escursione di orienteering. Si evolve nella città di St Julien Chapteuil."
    ],
    "fr": [
      "Parcours d'orientation avec les difficultés vert, bleu, rouge pour que chacun profite pleinement de sa rando'orientation. Vous évoluez dans la ville de St Julien Chapteuil."
    ],
    "es": [
      "Recorrido de orientación con dificultades verdes, azules y rojas para que todo el mundo pueda disfrutar plenamente de su caminata de orientación. Usted evoluciona en la ciudad de St Julien Chapteuil."
    ],
    "nl": [
      "Oriëntatieloop met groene, blauwe en rode moeilijkheden zodat iedereen ten volle kan genieten van zijn oriëntatieloop. Je evolueert in de stad St Julien Chapteuil."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Course d'orientation - Parcours de St Julien Chapteuil"
    ]
  },
