  "rdfs:comment": {
    "de": [
      "Erleben Sie ein außergewöhnliches Rockerlebnis! 15 000 Chorsänger, werden die Bühne der Halle Tony Garnier mit den größten Rockklassikern zum Kochen bringen."
    ],
    "en": [
      "Enjoy an extraordinary rock experience! 15,000 singers will set the stage alight at the Halle Tony Garnier with renditions of the greatest rock classics."
    ],
    "it": [
      "Un'esperienza rock senza precedenti! 15.000 coristi infiammeranno il palco della Halle Tony Garnier con le loro interpretazioni dei più grandi classici del rock."
    ],
    "fr": [
      "Vivez une expérience rock hors du commun ! 15 000 choristes,  vont enflammer la scène de la Halle Tony Garnier en reprenant les plus grands classiques du rock."
    ],
    "es": [
      "Una experiencia de rock sin igual 15.000 coristas prenderán fuego al escenario del Halle Tony Garnier con sus interpretaciones de los grandes clásicos del rock."
    ],
    "nl": [
      "Een rockervaring als geen ander! 15.000 achtergrondzangers zetten het podium van de Halle Tony Garnier in vuur en vlam met hun vertolkingen van de grootste rockklassiekers."
    ]
  },
  "rdfs:label": {
