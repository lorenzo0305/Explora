  "rdfs:comment": {
    "de": [
      "Verkauf von Würstchen und Linsen zum Mitnehmen, organisiert vom Vokalensemble \"Ch?ur à C?urs\", Parkplatz der Dorlière.\r\nAuf der Speisekarte: Würstchen-Linsen /Käse/Dessert\r\nEine Reservierung ist erforderlich. Reservierungen sind beim Fremdenverkehrsamt von Beauzac möglich"
    ],
    "en": [
      "Sausage and lentil takeaway organized by the \"Ch?ur à C?urs\" Vocal Ensemble, parking de la Dorlière.\r\nMenu: Sausage-lentils/Cheese/Dessert\r\nReservations essential. Reservations can be made at the Beauzac Tourist Office"
    ],
    "it": [
      "Salsiccia e lenticchie da asporto a cura dell'Ensemble vocale \"Ch?ur à C?urs\", parcheggio Dorlière.\r\nMenu: Salsiccia e lenticchie/Cheese/Dessert\r\nÈ necessario prenotare in anticipo. Le prenotazioni possono essere effettuate presso l'Ufficio del Turismo di Beauzac"
    ],
    "fr": [
      "Vente de saucisses-lentilles à emporter organisée par l’Ensemble Vocal « Chœur à Cœurs », parking de la Dorlière.\r\nAu menu : Saucisses-lentilles /Fromages/Dessert\r\nRéservation obligatoire. Réservation possible auprès de l’Office de tourisme de Beauzac"
    ],
    "es": [
      "Comida para llevar a base de salchichas y lentejas organizada por el Conjunto Vocal \"Ch?ur à C?urs\", aparcamiento de Dorlière.\r\nMenú: salchichas y lentejas / queso / postre\r\nEs necesario reservar con antelación. Las reservas pueden realizarse en la Oficina de Turismo de Beauzac"
    ],
    "nl": [
      "Afhaalmaaltijd van worst en linzen georganiseerd door het Vocaal Ensemble \"Ch?ur à C?urs\", parkeerplaats Dorlière.\r\nMenu: Worst en linzen / Kaas / Dessert\r\nVooraf reserveren. Reserveren kan bij het Office du Tourisme van Beauzac"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saucisse lentilles  à emporter"
    ]
  },
