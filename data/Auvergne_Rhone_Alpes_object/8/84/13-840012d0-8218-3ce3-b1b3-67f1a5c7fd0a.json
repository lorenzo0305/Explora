  "rdfs:comment": {
    "de": [
      "Der kleine Zug bietet eine Strecke von 35 Minuten.\r\nSie werden an Bord die wichtigsten Denkmäler und Wahrzeichen der Stadt in Kommentaren entdecken."
    ],
    "en": [
      "The little train offers you a 35 minutes tour.\r\nThanks to the commentary on board, you will discover the main monuments and emblematic places of the city."
    ],
    "it": [
      "Il trenino di Evian vi offre un tour di 35 minuti.\r\nGrazie al commento a bordo, scoprirete i principali monumenti e luoghi emblematici della città."
    ],
    "fr": [
      "Le petit train d'Evian vous propose un circuit de 35 minutes.\r\nVous découvrirez grâce au commentaire à bord les principaux monuments et lieux emblématiques de la ville."
    ],
    "nl": [
      "Het treintje van Evian neemt je mee op een rondrit van 35 minuten.\r\nDankzij het commentaar aan boord ontdek je de belangrijkste monumenten en bezienswaardigheden van de stad."
    ],
    "es": [
      "El trenecito de Evian le ofrece un recorrido de 35 minutos.\r\nGracias a los comentarios a bordo, descubrirá los principales monumentos y lugares emblemáticos de la ciudad."
    ]
  },
  "rdfs:label": {
    "de": [
