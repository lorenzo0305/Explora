  "rdfs:comment": {
    "de": [
      "Minigolf-Parcours 18 Pisten mit verspielten Hindernissen in unterschiedlichen Höhen. Ab 4 Jahren für jedermann zugänglich. Picknick vor Ort möglich. Buvette, Parkplatz, CB nicht angenommen. Gepflegte Begrüssung, Einführung."
    ],
    "en": [
      "Minigolf course 18 tracks with fun obstacles, of various levels. Accessible to all audiences from 4 years. Picnic possible on site. Bar, parking, CB not accepted. Reception, initiation."
    ],
    "it": [
      "Godetevi un campo da minigolf a 18 corsie con una varietà di ostacoli divertenti. È un'attività amichevole e familiare, accessibile a tutti a partire dai 4 anni di età, compresi gli utenti in sedia a rotelle. Gli animali domestici sono benvenuti. Bar e snack bar, parcheggio gratuito, carte di credito accettate."
    ],
    "fr": [
      "Profitez d'un parcours de minigolf de 18 pistes aux obstacles ludiques et variés. Une activité conviviale et familiale accessible à tous dès 4 ans, y compris en fauteuil roulant . Animaux acceptés. Buvette et snacking, parking gratuit, CB acceptée."
    ],
    "nl": [
      "Midgetgolfbaan 18 tracks met leuke obstakels, van verschillende niveaus. Toegankelijk voor alle doelgroepen vanaf 4 jaar. Picknick mogelijk op het terrein. Bar, parkeerplaats, CB niet geaccepteerd. Ontvangst, initiatie."
    ],
    "es": [
      "Disfrute de un recorrido de minigolf de 18 carriles con una gran variedad de divertidos obstáculos. Es una actividad familiar y agradable, accesible para todos a partir de 4 años, incluidos los usuarios de sillas de ruedas. Se admiten mascotas. Bar, aparcamiento gratuito, se aceptan tarjetas de crédito."
    ]
  },
