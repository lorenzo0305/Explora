  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Lebensmittelladen des Bistrot de Pays de Malbosc: lokale Produkte, authentische Geschmäcker und Gastlichkeit im Herzen des Dorfes. Eine Gourmetpause für Ihre Ausflüge in die Cevennen der Ardèche!"
    ],
    "en": [
      "Discover the Bistrot de Pays de Malbosc grocery store: local produce, authentic flavors and conviviality in the heart of the village. A gourmet break for your Cévennes d'Ardèche escapades!"
    ],
    "it": [
      "Scoprite la drogheria Bistrot de Pays a Malbosc: prodotti locali, sapori autentici e un'atmosfera accogliente nel cuore del villaggio. Una pausa golosa per le vostre escursioni nelle Cévennes d'Ardèche!"
    ],
    "fr": [
      "Découvrez l'épicerie du Bistrot de Pays de Malbosc : produits locaux, saveurs authentiques et convivialité au cœur du village. Une pause gourmande pour vos escapades en Cévennes d'Ardèche !"
    ],
    "nl": [
      "Ontdek de kruidenierswinkel Bistrot de Pays in Malbosc: streekproducten, authentieke smaken en een gezellige sfeer in het hart van het dorp. Een gastronomische onderbreking voor uw escapades in de Cevennen d'Ardèche!"
    ],
    "es": [
      "Descubra la tienda de ultramarinos Bistrot de Pays en Malbosc: productos locales, sabores auténticos y un ambiente acogedor en el corazón del pueblo. Una pausa gastronómica para sus escapadas por las Cevenas de Ardèche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot de Malbosc - Epicerie"
    ]
  },
