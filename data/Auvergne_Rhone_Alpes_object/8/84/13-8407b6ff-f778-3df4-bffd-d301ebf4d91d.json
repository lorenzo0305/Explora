  "rdfs:comment": {
    "de": [
      "La Tribu Alonso,einzigartiges ampelographisches Konservatorium, 2,5 Hektar .Cyril, biologischer Weinbauer und Karine, seine Frau. In Marchampt an außergewöhnlichen Hängen gelegen."
    ],
    "en": [
      "La Tribu Alonso, a unique ampelographic conservatory, 2.5 hectares. Cyril, organic winegrower, and Karine, his wife. Located in Marchampt on exceptional hillsides."
    ],
    "it": [
      "La Tribu Alonso, una serra ampelografica unica nel suo genere che si estende su 2,5 ettari, è gestita da Cyril, viticoltore biologico, e da sua moglie Karine. Si trova a Marchampt su colline eccezionali."
    ],
    "fr": [
      "La Tribu Alonso,conservatoire ampelographique unique, 2,5 hectares .Cyril, viticulteur biologique et Karine, son épouse. Situé à Marchampt sur des coteaux exceptionnels."
    ],
    "es": [
      "La Tribu Alonso, un conservatorio ampelográfico único de 2,5 hectáreas, está dirigido por Cyril, viticultor ecológico, y su esposa Karine. Situado en Marchampt, en unas laderas excepcionales."
    ],
    "nl": [
      "La Tribu Alonso, een unieke ampelografische serre van 2,5 hectare, wordt gerund door Cyril, een biologische wijnbouwer, en zijn vrouw Karine. Gelegen in Marchampt op uitzonderlijke hellingen."
    ]
  },
