  "rdfs:comment": {
    "de": [
      "Direkt neben dem Savoy Hotel befindet sich der Grill du Savoy im Herzen des Dorfes Saint Michel de Maurienne in Savoyen. Es liegt an der Straße zu den großen Alpenpässen, neben Italien, Orelle und Valloire."
    ],
    "en": [
      "Right next door to the Savoy hotel is the Grill du Savoy in the heart of the village of Saint Michel de Maurienne in Savoie, on the route to the major Alpine passes, near Italy, Orelle and Valloire."
    ],
    "it": [
      "Proprio accanto all'hotel Savoy si trova il Grill du Savoy, nel cuore del villaggio di Saint Michel de Maurienne in Savoia, situato sulla strada dei grandi passi alpini, vicino all'Italia, a Orelle e a Valloire."
    ],
    "fr": [
      "Juste à côté du Savoy hôtel se trouve le Grill du Savoy au cœur du village de Saint Michel de Maurienne en Savoie, situé sur la route des grands cols alpins, à côté de l’Italie, d’Orelle, et de Valloire."
    ],
    "es": [
      "Justo al lado del hotel Savoy se encuentra el Grill du Savoy, en el corazón del pueblo de Saint Michel de Maurienne, en Saboya, situado en la carretera de los grandes puertos alpinos, junto a Italia, Orelle y Valloire."
    ],
    "nl": [
      "Direct naast het hotel Savoy ligt de Grill du Savoy in het hart van het dorp Saint Michel de Maurienne in de Savoie, gelegen aan de weg naar de grote Alpenpassen, naast Italië, Orelle en Valloire."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Grill du Savoy"
    ],
    "fr": [
      "Le Grill du Savoy"
    ]
  },
