  "rdfs:comment": {
    "de": [
      "Im Herzen des mittelalterlichen Dorfes erkunden Sie die Gassen auf den Spuren des Großen Quinson und seiner lustigen Träumereien. Dieser Wahrsager wird Ihnen den Weg weisen, um den großen Anführer der Gnolus aufzuspüren und zu fangen: Graal."
    ],
    "en": [
      "In the heart of the medieval village, explore the alleyways in the footsteps of Grand Quinson and his strange reveries. This soothsayer will guide you as you seek out and capture the great leader of the Gnolus: Graal."
    ],
    "it": [
      "Nel cuore del villaggio medievale, esplorate le stradine sulle tracce del Grande Quinson e delle sue strane fantasticherie. Questo indovino vi guiderà per stanare e catturare il grande capo degli Gnolus: Graal."
    ],
    "fr": [
      "Au cœur du village médiéval, explorez les ruelles dans les pas du Grand Quinson et ses drôles de rêveries. Ce devin vous guidera pour débusquer et capturer le grand chef des Gnolus : Graal."
    ],
    "nl": [
      "In het hart van het middeleeuwse dorp verken je de smalle straatjes in de voetsporen van de Grote Quinson en zijn vreemde mijmeringen. Deze waarzegger zal je begeleiden om de grote leider van de Gnolus op te sporen en gevangen te nemen: Graal."
    ],
    "es": [
      "En el corazón de la aldea medieval, explora las callejuelas siguiendo los pasos del Gran Quinson y sus extraños ensueños. Este adivino te guiará para descubrir y capturar al gran líder de los Gnolus: Graal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : Les rêveries du Grand Quinson"
    ]
  },
