  "rdfs:comment": {
    "de": [
      "E-VTT - Alpages du Bozelet\r\n\r\nRoute zwischen La Plagne und Champagny en Vanoise durch die Almen, das Gebiet des Beaufort-Käses. Angenehme Strecke, die Sie mit einem Mountainbike mit elektrischer Unterstützung entdecken können!"
    ],
    "en": [
      "Cycling tour – Mountain Pastures of Bozelet\r\nDeparture: Champagny\r\n\r\nRoute through the alpine pastures between La Plagne and Champagny en Vanoise – home of Beaufort cheese. Perfect for a ride with electric Mountain bikes."
    ],
    "it": [
      "E-VTT? Alpages du Bozelet\r\n\r\nItinerario tra La Plagne e Champagny en Vanoise attraverso gli alpeggi, il territorio del formaggio Beaufort. Un percorso piacevole da scoprire su una mountain bike a pedalata assistita!"
    ],
    "fr": [
      "E-VTT – Alpages du Bozelet\r\n\r\nItinéraire entre la Plagne et Champagny en Vanoise à travers les alpages, territoire du fromage Beaufort. Parcours agréable à découvrir en VTT à assistance électrique !"
    ],
    "es": [
      "E-VTT ? Alpages du Bozelet\r\n\r\nItinerario entre La Plagne y Champagny en Vanoise a través de los pastos de montaña, el territorio del queso de Beaufort. Una agradable ruta para descubrir en una bicicleta de montaña con asistencia eléctrica"
    ],
    "nl": [
      "E-VTT - Alpages du Bozelet\r\n\r\nRoute tussen La Plagne en Champagny en Vanoise door de bergweiden, het grondgebied van de Beaufort kaas. Een aangename route om te ontdekken op een elektrisch ondersteunde mountainbike!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Mountainbike-Route E : Alpages du Bozelet"
    ],
    "en": [
      "Mountain Biking Tour, Route-E : Mountain Pastures of Bozelet"
    ],
    "fr": [
      "Circuit VTT-E : Alpages du Bozelet"
    ],
