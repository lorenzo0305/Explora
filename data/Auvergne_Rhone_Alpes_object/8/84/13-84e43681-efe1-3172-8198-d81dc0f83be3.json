  "rdfs:comment": {
    "de": [
      "Lederwaren und handwerkliche Schuhmacherei aus Leder: Herstellung von schlichten und ergonomischen Artikeln. Hier finden Sie verschiedene und vielfältige Kreationen: Schuhe, Taschen, Geldbörsen, Etuis, Gürtel und Alltagsgegenstände.\r\nSchuhreparaturen."
    ],
    "en": [
      "Leather Craft\r\nThe workshop produce a large offer such as shoes, belts, bags, wallets ans purses"
    ],
    "it": [
      "Pelletteria artigianale e calzoleria in pelle: prodotti semplici ed ergonomici. Un'ampia gamma di creazioni: scarpe, borse, portafogli, sacchetti, cinture e oggetti di uso quotidiano.\r\nRiparazioni di scarpe."
    ],
    "fr": [
      "Maroquinerie et Cordonnerie artisanale à partir de cuir : fabrication d'articles sobres et ergonomiques. Retrouvez des créations diverses et variées : chaussures, sacs, portefeuilles, trousses, ceintures et objets du quotidien. \r\nRéparation chaussures."
    ],
    "es": [
      "Marroquinería artesanal y zapatería de piel: productos sencillos y ergonómicos. Amplia gama de creaciones: zapatos, bolsos, carteras, bolsas, cinturones y artículos de uso cotidiano.\r\nReparación de calzado."
    ],
    "nl": [
      "Handgemaakte lederwaren en schoenen van leer: eenvoudige, ergonomische producten. Een breed scala aan creaties: schoenen, tassen, portefeuilles, buidels, riemen en alledaagse voorwerpen.\r\nSchoenreparaties."
    ]
  },
