  "rdfs:comment": {
    "de": [
      "In der Gemeinde befindet sich das interkommunale Boulodrome des Gorges de l'Ardèche, das 2012 vom Gemeindeverband gebaut wurde und vom Pétanque-Verein Chauzon-Pradons, dem größten Pétanque-Verein der Ardèche, betrieben wird."
    ],
    "en": [
      "The commune is home to the inter-communal boulodrome des Gorges de l'Ardèche, built by the communauté de communes in 2012, and managed by the Chauzon-Pradons pétanque association, the largest pétanque club in the Ardèche."
    ],
    "it": [
      "Il comune ospita il campo da bocce intercomunale delle Gorges de l'Ardèche, costruito dalla Communauté de Communes nel 2012 e gestito dall'associazione di pétanque Chauzon-Pradons, il più grande club di pétanque dell'Ardèche."
    ],
    "fr": [
      "La commune abrite le boulodrome intercommunal des Gorges de l’Ardèche, construit par la communauté de communes en 2012, est géré par l’association de pétanque Chauzon-Pradons, le plus important club de pétanque d’Ardèche."
    ],
    "nl": [
      "In de gemeente ligt het intercommunale petanqueterrein Gorges de l'Ardèche, dat in 2012 werd aangelegd door de communauté de communes en wordt beheerd door de petanquevereniging Chauzon-Pradons, de grootste petanquevereniging in de Ardèche."
    ],
    "es": [
      "El municipio alberga el campo de petanca intercomunal de Gorges de l'Ardèche, construido por la communauté de communes en 2012 y gestionado por la asociación de petanca Chauzon-Pradons, el mayor club de petanca de Ardèche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulodrome  Intercommunal des Gorges de l'Ardèche"
    ]
  },
