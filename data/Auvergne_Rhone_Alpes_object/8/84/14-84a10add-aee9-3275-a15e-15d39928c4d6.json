  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/47f2a69a-f633-3973-858e-ec03e4c713c0",
      "dc:description": {
        "de": [
          "Nehmen Sie an dieser festlichen, generationenübergreifenden und lokalen Veranstaltung teil. Auf dem Programm stehen Aufführungen, Workshops, Ausstellungen und Festabende, die das Bergbau- und Kulturerbe in einer geselligen Atmosphäre zur Geltung bringen."
        ],
        "en": [
          "Take part in this festive, intergenerational and local event. The program includes shows, workshops, exhibitions and festive evenings, highlighting mining and cultural heritage in a convivial atmosphere."
        ],
        "it": [
          "Partecipate a questo evento festivo, intergenerazionale e locale. Il programma comprende spettacoli, laboratori, mostre e serate di festa, che mettono in luce il patrimonio minerario e culturale in un'atmosfera amichevole."
        ],
        "fr": [
          "Participez à cet événement festif, intergénérationnel et local. Au programme, il y aura des spectacles, ateliers, expositions et soirées festives, qui valorisent le patrimoine minier et culturel dans une ambiance conviviale."
        ],
        "es": [
          "Participe en este acontecimiento festivo, intergeneracional y local. El programa incluye espectáculos, talleres, exposiciones y veladas festivas, que ponen de relieve el patrimonio minero y cultural en un ambiente acogedor."
        ],
        "nl": [
          "Neem deel aan dit feestelijke, intergenerationele en lokale evenement. Op het programma staan voorstellingen, workshops, tentoonstellingen en feestelijke avonden die de mijnbouw en het culturele erfgoed in een gezellige sfeer onder de aandacht brengen."
        ]
      },
