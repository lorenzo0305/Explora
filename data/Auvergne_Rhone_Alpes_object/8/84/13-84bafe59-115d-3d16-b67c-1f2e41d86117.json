  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Office de Tourisme Intercommunal Maurienne Galibier in Saint-Michel-de-Maurienne! Herzlicher Empfang, rollstuhlgerecht, ideal für Radfahrer und Wanderer. Umfassende Dienstleistungen wie kostenloses WiFi und Parkplätze. Haustiere sind willkommen."
    ],
    "en": [
      "Discover the Maurienne Galibier Intercommunal Tourist Office in Saint-Michel-de-Maurienne! Warm welcome, wheelchair accessible, ideal for cyclists and hikers. Full services including free WiFi and parking. Pets welcome."
    ],
    "it": [
      "Scoprite l'Ufficio Intercomunale del Turismo della Maurienne Galibier a Saint-Michel-de-Maurienne! Accoglienza calorosa, accesso per sedie a rotelle, ideale per ciclisti ed escursionisti. Servizi completi, tra cui WiFi e parcheggio gratuiti. Animali domestici ammessi."
    ],
    "fr": [
      "Découvrez l'Office de Tourisme Intercommunal Maurienne Galibier à Saint-Michel-de-Maurienne! Accueil chaleureux, accessible en fauteuil roulant, idéal pour cyclistes et randonneurs. Services complets incluant WiFi gratuit et parking. Animaux bienvenus."
    ],
    "nl": [
      "Ontdek de Toeristische Intercommunale Maurienne Galibier in Saint-Michel-de-Maurienne! Hartelijke ontvangst, rolstoeltoegankelijk, ideaal voor fietsers en wandelaars. Volledige dienstverlening, inclusief gratis wifi en parkeerplaats. Huisdieren welkom."
    ],
    "es": [
      "Descubra la Oficina de Turismo Intermunicipal Maurienne Galibier en Saint-Michel-de-Maurienne Cálida acogida, accesible en silla de ruedas, ideal para ciclistas y excursionistas. Servicios completos, incluidos WiFi y aparcamiento gratuitos. Se admiten animales de compañía."
    ]
  },
