  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Place Bellecour entfernt lädt Newtree Café, Restaurant, Coffee Shop und umweltbewusste Chocolaterie Sie dazu ein, das Leben mit leckeren, gesunden und verantwortungsbewussten Erfahrungen zu genießen. 100% biologisch, 100% hausgemacht."
    ],
    "en": [
      "Close to the Place Bellecour, the Newtree Café, an eco-friendly restaurant,coffee shop and chocolaterie invites you to enjoy life with delicious, healthy and responsible experiences. 100% organic, 100% homemade."
    ],
    "it": [
      "A pochi passi da Place Bellecour, il Newtree Café, ristorante, caffetteria e cioccolateria vi invita ad assaporare la vita attraverso esperienze gastronomiche sane e responsabili. 100% biologico, 100% fatto in casa."
    ],
    "fr": [
      "A deux pas de la Place Bellecour, Newtree Café, Restaurant, Coffee Shop et Chocolaterie écoresponsable, vous invite à savourer la vie autour d’expériences gourmandes, saines et responsables. 100% bio, 100% maison."
    ],
    "nl": [
      "Op een steenworp afstand van de Place Bellecour nodigt Newtree Café, Restaurant, Coffee Shop en Chocolaterie u uit om van het leven te genieten door middel van gastronomische, gezonde en verantwoorde ervaringen. 100% biologisch, 100% zelfgemaakt."
    ],
    "es": [
      "A dos pasos de la plaza Bellecour, el café, restaurante, cafetería y chocolatería Newtree le invita a saborear la vida a través de experiencias gastronómicas sanas y responsables. 100% ecológico, 100% casero."
    ]
  },
