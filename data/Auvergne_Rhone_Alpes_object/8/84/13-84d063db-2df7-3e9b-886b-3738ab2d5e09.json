  "rdfs:comment": {
    "de": [
      "Die Brasserie du Merle bietet eine Auswahl an handwerklich gebrauten Bieren mit AB-Zertifizierung, die mit Liebe auf dem Plateau de la Leysse gebraut werden. Pierre und Benjamin heißen Sie mit hausgemachten Bieren, Weinen und Limo willkommen. Im Sommer bietet die Brauerei Konzertabende an."
    ],
    "en": [
      "Brasserie du Merle offers an assortment of AB-certified craft beers, lovingly brewed on the Plateau de la Leysse. Pierre and Benjamin welcome you, with beers, wines and homemade limos. In summer, the brewery offers evening concerts."
    ],
    "it": [
      "La Brasserie du Merle offre una gamma di birre artigianali certificate AB, prodotte con amore sul Plateau de la Leysse. Pierre e Benjamin vi accolgono con le loro birre artigianali, i loro vini e le loro limousine. In estate, la birreria offre concerti serali."
    ],
    "fr": [
      "La Brasserie du Merle propose un assortiment de bières artisanales certifiées AB, brassées avec amour sur le Plateau de la Leysse. Pierre et Benjamin vous accueillent, avec bières, vins et limo maison. A l'été, la brasserie propose des soirées concerts."
    ],
    "es": [
      "Brasserie du Merle ofrece una gama de cervezas artesanales con certificación AB, elaboradas con amor en el Plateau de la Leysse. Pierre y Benjamin le dan la bienvenida con sus cervezas artesanales, vinos y limonadas. En verano, la cervecería ofrece conciertos nocturnos."
    ],
    "nl": [
      "Brasserie du Merle biedt een assortiment AB-gecertificeerde ambachtelijke bieren, met liefde gebrouwen op het Plateau de la Leysse. Pierre en Benjamin verwelkomen je met hun huisgemaakte bieren, wijnen en limo's. In de zomer biedt de brouwerij avondconcerten."
    ]
  },
