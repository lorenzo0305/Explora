  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ad1632cd-c033-3032-9ffc-26b45ad59399",
      "dc:description": {
        "de": [
          "Damenoberbekleidung, Schuhe, Lederwaren, Accessoires und Schmuck.\nGeöffnet von Montag bis Sonntag.\nMontag von 14:00 bis 18:00 Uhr.\nDienstag, Donnerstag, Freitag und Samstag von 10:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr.\nMittwoch und Sonntag von 14:00 bis 18:00 Uhr."
        ],
        "en": [
          "Women's ready-to-wear, shoes, leather goods, accessories and jewelry.\nOpen Monday to Sunday.\nMonday, 2pm to 6pm.\nTuesday, Thursday, Friday and Saturday, 10am to 12pm and 2pm to 6pm.\nWednesday and Sunday, 2pm to 6pm."
        ],
        "it": [
          "Prêt-à-porter femminile, scarpe, pelletteria, accessori e gioielli.\nAperto da lunedì a domenica.\nLunedì dalle 14.00 alle 18.00.\nMartedì, giovedì, venerdì e sabato dalle 10.00 alle 12.00 e dalle 14.00 alle 18.00.\nMercoledì e domenica dalle 14.00 alle 18.00."
        ],
        "fr": [
          "Prêt à porter féminin, chaussures, maroquinerie, accessoires et bijoux.\nOuvert du lundi au dimanche.\nLundi de 14h à 18h.\nMardi, jeudi, vendredi et samedi de 10h à 12h et de 14h à 18h.\nLe mercredi et dimanche de 14h à 18h."
        ],
        "es": [
          "Prêt-à-porter femenino, zapatos, marroquinería, accesorios y joyería.\nAbierto de lunes a domingo.\nLunes de 14.00 a 18.00 h.\nMartes, jueves, viernes y sábado de 10.00 a 12.00 h. y de 14.00 a 18.00 h.\nMiércoles y domingo de 14.00 a 18.00 h."
        ],
        "nl": [
          "Dameskleding, schoenen, lederwaren, accessoires en sieraden.\nGeopend van maandag tot zondag.\nMaandag van 14.00 tot 18.00 uur.\nDinsdag, donderdag, vrijdag en zaterdag van 10.00 tot 12.00 uur en van 14.00 tot 18.00 uur.\nWoensdag en zondag van 14.00 tot 18.00 uur."
        ]
      },
