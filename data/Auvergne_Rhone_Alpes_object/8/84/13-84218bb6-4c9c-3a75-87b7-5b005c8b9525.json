  "rdfs:comment": {
    "de": [
      "Im Jahr 2026 treffen wir uns im Frühling wieder!\r\nWir sehen uns am Sonntag, den 7. Juni, zum berühmtesten Trail der Welt."
    ],
    "en": [
      "In 2026, it's springtime again!\r\nSee you on Sunday June 7 for the world's most famous Trail."
    ],
    "it": [
      "Nel 2026, ci incontreremo in primavera!\r\nCi vediamo domenica 7 giugno per il Trail più famoso del mondo."
    ],
    "fr": [
      "En 2026, c’est au printemps qu’on se retrouve!\r\nRDV le dimanche 7 juin pour le Trail le plus célèbre du monde."
    ],
    "nl": [
      "In 2026 komen we samen in de lente!\r\nTot ziens op zondag 7 juni voor de beroemdste Trail ter wereld."
    ],
    "es": [
      "En 2026, ¡nos reuniremos en primavera!\r\nNos vemos el domingo 7 de junio en el Trail más famoso del mundo."
    ]
