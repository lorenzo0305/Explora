  "rdfs:comment": {
    "de": [
      "Das Tilbury bietet köstliche Salate, Hacksteaks mit Pommes Frites für Eilige. Nicht zu vergessen ist die große Auswahl an hausgemachten Crêpes..."
    ],
    "en": [
      "Restaurant Snack Bar Le Tilbury\r\nSituated in la Croisette district, in Beaufortain building\r\nNear to the snow front"
    ],
    "it": [
      "Il ristorante Tilbury offre deliziose insalate, hamburger e patatine per un pranzo veloce, oltre a una varietà di crêpes fatte in casa."
    ],
    "fr": [
      "Le restaurant  Tilbury propose de délicieuses salades, steack haché/frites pour un déjeuner rapide sans oublier la diversité des crêpes faites maison."
    ],
    "nl": [
      "Le Tilbury biedt overheerljke salades, biefstuk/friet voor een snelle lunch zonder de diverse pannenkoeken van het huis te vergeten ..."
    ],
    "es": [
      "El restaurante Tilbury ofrece deliciosas ensaladas, hamburguesas y patatas fritas para un almuerzo rápido, sin olvidar una variedad de crepes caseros."
    ]
