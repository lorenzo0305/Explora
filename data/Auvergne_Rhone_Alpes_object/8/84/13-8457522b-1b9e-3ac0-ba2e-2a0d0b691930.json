  "rdfs:comment": {
    "de": [
      "Familiengeführtes Restaurant im Stadtzentrum, am Ufer des Flusses Couze und in der Nähe der Abteikirche Saint-Austremoine. Traditionelle Küche mit frischen Produkten."
    ],
    "en": [
      "Family restaurant, located in the center of town, on the banks of the river Couze and near the Abbey of Saint-Austremoine. Traditional cuisine with fresh produce."
    ],
    "it": [
      "Ristorante a conduzione familiare, situato nel centro della città, sulle rive del fiume Couze e vicino all'Abbazia di Saint-Austremoine. Cucina tradizionale con prodotti freschi."
    ],
    "fr": [
      "Restaurant familial, situé en plein centre ville, au bord de la couze et près de l'abbatiale Saint-Austremoine. Cuisine  traditionnelle avec des produits frais."
    ],
    "es": [
      "Restaurante familiar, situado en el centro de la ciudad, a orillas del río Couze y cerca de la Abadía de Saint-Austremoine. Cocina tradicional con productos frescos."
    ],
    "nl": [
      "Familierestaurant, gelegen in het stadscentrum, aan de oever van de rivier de Couze en vlakbij de abdij van Saint-Austremoine. Traditionele keuken met verse producten."
    ]
  },
