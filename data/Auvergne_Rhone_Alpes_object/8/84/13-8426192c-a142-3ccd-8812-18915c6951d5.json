  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-André in Champagnier besitzt als Glockenturm einen schönen romanischen Turm aus Tuffstein. Sie liegt an einem der meistbegangenen Familienwanderwege der Gegend: Le saut du Moine."
    ],
    "en": [
      "Saint-André Church boasts a fine Romanesque bell tower made of tuff. It is located along one of the most popular family hikes in the area; Le Saut du Moine."
    ],
    "it": [
      "La chiesa di Saint-André de Champagnier ha una bella torre romanica in tufo. Si trova su uno dei sentieri escursionistici per famiglie più popolari della zona: Le saut du Moine."
    ],
    "fr": [
      "L’église Saint-André de Champagnier possède, pour clocher, une belle tour romane en tuf . Elle est située sur l’un des chemins de randonnée familiale les plus fréquentés du secteur : Le saut du Moine."
    ],
    "es": [
      "La iglesia de Saint-André de Champagnier cuenta con una hermosa torre románica de toba. Se encuentra en una de las rutas de senderismo familiares más populares de la zona: Le Saut du Moine."
    ],
    "nl": [
      "De kerk Saint-André de Champagnier heeft een prachtige Romaanse toren van tufsteen. Het ligt aan een van de populairste familiewandelroutes in de omgeving: Le saut du Moine."
    ]
  },
