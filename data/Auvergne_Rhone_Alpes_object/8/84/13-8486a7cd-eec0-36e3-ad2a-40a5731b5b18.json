  "rdfs:comment": {
    "de": [
      "Mit 180°-Panorama, gegenüber dem Lizieux und dem Mézenc, sind Tische vor dem Saal des Belvédère aufgestellt."
    ],
    "en": [
      "With a 180° panorama, facing the Lizieux and Mezenc mountains, tables are set up in front of the Belvedere room."
    ],
    "it": [
      "Con una vista panoramica a 180°, di fronte alle montagne Lizieux e Mézenc, i tavoli sono stati allestiti davanti alla sala Belvedere."
    ],
    "fr": [
      "Avec panorama à 180°, face au Lizieux, et au Mézenc, des tables sont installées devant la salle du Belvédère."
    ],
    "nl": [
      "Met een 180° panoramisch uitzicht op de bergen van Lizieux en Mézenc zijn er tafels gedekt voor de zaal Belvedere."
    ],
    "es": [
      "Con una vista panorámica de 180°, frente a los montes Lizieux y Mézenc, se han instalado mesas delante de la sala Belvedere."
    ]
