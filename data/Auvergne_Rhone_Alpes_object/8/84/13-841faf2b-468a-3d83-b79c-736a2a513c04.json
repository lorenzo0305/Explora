  "rdfs:comment": {
    "de": [
      "Im Herzen von Lyon Confluence empfängt Sie das Spa des Keystone in einer Blase des Wohlbefindens. Lassen Sie sich in diesem Bereich, der sieben Tage die Woche von 10:00 bis 21:00 Uhr geöffnet ist, zu einem ultimativen Entspannungserlebnis hinreißen."
    ],
    "en": [
      "In the heart of Lyon Confluence, the Keystone spa welcomes you to its bubble of well-being. Let yourself be swept away by the ultimate relaxation experience in this space open 7 days a week from 10am to 9pm."
    ],
    "it": [
      "Nel cuore di Lyon Confluence, la spa Keystone vi accoglie nella sua bolla di benessere. Lasciatevi travolgere da un'esperienza di relax senza precedenti in questo spazio aperto 7 giorni su 7 dalle 10.00 alle 21.00."
    ],
    "fr": [
      "Au cœur de Lyon Confluence, le spa du Keystone vous accueille dans sa bulle de bien-être. Laissez-vous emporter par une expérience de relaxation ultime dans cet espace ouvert 7 jours sur 7 de 10h à 21h."
    ],
    "nl": [
      "In het hart van Lyon Confluence heet de Keystone spa je welkom in zijn welzijnsbubbel. Laat je meeslepen door de ultieme ontspanningservaring in deze ruimte die 7 dagen per week geopend is van 10.00 tot 21.00 uur."
    ],
    "es": [
      "En el corazón de Lyon Confluence, el spa Keystone le da la bienvenida a su burbuja de bienestar. Déjese llevar por la experiencia de relajación definitiva en este espacio abierto los 7 días de la semana de 10:00 a 21:00."
    ]
  },
