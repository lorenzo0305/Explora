  "rdfs:comment": {
    "de": [
      "Vom 4. bis 5. April lädt Sie die Auberge collective et Atelier L?Oustal in Bourdeaux ein, in die faszinierende Welt der Comics und der Illustration einzutauchen. Ein Wochenende voller Aktivitäten für Groß und Klein!"
    ],
    "en": [
      "From April 4 to 5, the Auberge Collective and Atelier L?Oustal in Bourdeaux invite you to plunge into the fascinating world of comics and illustration. A weekend packed with activities for young and old alike!"
    ],
    "it": [
      "Dal 4 al 5 aprile, l'Auberge Collective e l'Atelier L'Oustal di Bourdeaux vi invitano a immergervi nell'affascinante mondo del fumetto e dell'illustrazione. Un fine settimana ricco di attività per grandi e piccini!"
    ],
    "fr": [
      "Du 4 au 5 avril, l'Auberge collective et Atelier L’Oustal à Bourdeaux  vous invite à plonger dans l'univers fascinant de la bande dessinée et de l'illustration. Un week-end riche en activités pour petits et grands !"
    ],
    "nl": [
      "Van 4 tot 5 april nodigen de Auberge Collective en Atelier L?Oustal in Bourdeaux je uit om een duik te nemen in de fascinerende wereld van strips en illustraties. Een weekend vol activiteiten voor jong en oud!"
    ],
    "es": [
      "Del 4 al 5 de abril, el Auberge Collective y el Atelier L'Oustal de Burdeos te invitan a sumergirte en el fascinante mundo del cómic y la ilustración. Un fin de semana repleto de actividades para grandes y pequeños"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Week-end BD et illustration à l'Oustal"
    ]
  },
