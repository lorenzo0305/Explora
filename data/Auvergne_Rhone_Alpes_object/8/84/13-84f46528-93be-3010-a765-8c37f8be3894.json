  "rdfs:comment": {
    "de": [
      "Erleben Sie eine außergewöhnliche Erfahrung bei Paintball Beaucroissant.\r\nUnsere angebotenen Aktivitäten sind : PAINTBALL, AIRSOFT, LASER GAME, ARROW, WaterTag und Bazooka Ball im Freien sind ab 5 Jahren zugänglich."
    ],
    "en": [
      "The paintball park in the village of Beaucroissant is in an urban setting built for both your enjoyment and safety. It also includes a SPEED PARK composed of flexible blow up units with a TURF pitch, shelters for players and air pumped to 4500 psi."
    ],
    "it": [
      "Venite a vivere un'esperienza straordinaria al Paintball Beaucroissant.\r\nLe attività proposte: PAINTBALL, AIRSOFT, LASER GAME, ARROW, WaterTag e Bazooka ball all'aria aperta sono accessibili a partire dai 5 anni."
    ],
    "fr": [
      "Venez vivre une experience extraordinaire chez Paintball Beaucroissant.\r\nNos activités proposées : PAINTBALL, AIRSOFT, LASER GAME, ARROW, WaterTag et Bazooka ball en plein air sont accessibles dès 5 ans."
    ],
    "es": [
      "Ven a disfrutar de una experiencia extraordinaria en el Paintball Beaucroissant.\r\nNuestras actividades propuestas : PAINTBALL, AIRSOFT, LASER GAME, ARROW, WaterTag y Bazooka ball al aire libre son accesibles a partir de los 5 años."
    ],
    "nl": [
      "Kom en geniet van een buitengewone ervaring bij Paintball Beaucroissant.\r\nOnze voorgestelde activiteiten : PAINTBALL, AIRSOFT, LASER GAME, ARROW, WaterTag en Bazooka ball in de open lucht zijn toegankelijk vanaf 5 jaar."
    ]
  },
