  "rdfs:comment": {
    "de": [
      "Dieses Massiv ist eine imposante Kalksteinbarriere und gehört zu den ersten Ausläufern des Vercors. Es ist die westlichste Kette des Alpenmassivs.\r\nEin idealer Ort für herrliche Wanderungen zu Fuß, mit dem Mountainbike oder zu Pferd. Kletterspot."
    ],
    "en": [
      "An imposing limestone barrier, this massif forms part of the first foothills of the Vercors. It is the westernmost range of the Alpine Massif.\r\nAn ideal place for magnificent hikes, mountain biking and horseback riding. Climbing spot."
    ],
    "it": [
      "Imponente barriera calcarea, questo massiccio fa parte delle prime propaggini del Vercors. È la catena più occidentale del massiccio alpino.\r\nÈ un luogo ideale per magnifiche passeggiate, mountain bike ed equitazione. Un luogo di arrampicata."
    ],
    "fr": [
      "Imposante barrière calcaire, ce massif s'inscrit dans les premiers contreforts du Vercors. C'est la chaîne la plus occidentale du Massif Alpin.\r\nLieu idéal pour de magnifiques randonnées, à pied ou en VTT ou à cheval. Spot d'escalade."
    ],
    "es": [
      "Imponente barrera calcárea, este macizo forma parte de las primeras estribaciones del Vercors. Es la cordillera más occidental del macizo alpino.\r\nEs un lugar ideal para realizar magníficos paseos a pie, en bicicleta de montaña o a caballo. Un lugar de escalada."
    ],
    "nl": [
      "Dit imposante kalksteenmassief maakt deel uit van de eerste uitlopers van de Vercors. Het is de meest westelijke bergketen van het Alpenmassief.\r\nHet is een ideale plek voor prachtige wandelingen, mountainbiken en paardrijden. Een plek om te klimmen."
    ]
  },
