  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/88d42b03-6380-3eaf-bc5b-4cf93ec72a06",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Der Gemüsegarten von Monsieur Pétain bietet Ihnen sein Gemüse an.\n\nTage der Öffnung:\nMontag bis Sonntag\n\nKontaktieren Sie den Erzeuger vor Ihrem Besuch telefonisch unter 06 77 14 49 30\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Monsieur Pétain's vegetable garden offers you its vegetables.\n\nOpening days:\nMonday to Sunday\n\nContact the grower by phone at 06 77 14 49 30 before your visit\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: L'orto di Monsieur Pétain vi offre le sue verdure.\n\nGiorni di apertura:\nDa lunedì a domenica\n\nContattare il produttore telefonicamente al numero 06 77 14 49 30 prima di venire\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :  Le potager de Monsieur Pétain vous propose ses légumes.\n\nJours d'ouverture:\nDu lundi au dimanche\n\nContacter le producteur par téléphone au 06 77 14 49 30 avant votre passage \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: De moestuin van Monsieur Pétain biedt je zijn groenten aan.\n\nOpeningsdagen:\nMaandag tot zondag\n\nNeem voordat je komt telefonisch contact op met de producent op 06 77 14 49 30\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: El huerto de Monsieur Pétain le ofrece sus verduras.\n\nDías de apertura:\nDe lunes a domingo\n\nPóngase en contacto con el productor por teléfono en el 06 77 14 49 30 antes de venir\n\n "
        ]
      },
