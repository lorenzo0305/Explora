  "rdfs:comment": {
    "de": [
      "WAM PARK: Wassersport-Freizeitzentrum und Wasserskilift im Herzen der Savoyen!\r\nWasserski und Wakeboard mit der Familie oder mit Freunden in einer prächtigen Umgebung.\r\nAktivitäten ab 5 Jahren zugänglich."
    ],
    "en": [
      "WAM Park : outdoor activities center with cable tow water-skiing in Savoie. \r\nYou can do cable tow water-skiing or wakeboard in family or with friends in a beautiful space."
    ],
    "it": [
      "WAM PARK: centro ricreativo per gli sport acquatici e impianto di risalita per lo sci nautico nel cuore della Savoia!\r\nGodetevi lo sci nautico e il wakeboard con la famiglia e gli amici in un ambiente sontuoso.\r\nAttività aperte ai bambini a partire dai 5 anni."
    ],
    "fr": [
      "WAM PARK : Base de loisirs nautique et téléski nautique au coeur de la Savoie !\r\nPratique du ski nautique et du wakeboard en famille ou entre amis dans un cadre somptueux.\r\nActivités accessibles à partir de 5 ans."
    ],
    "nl": [
      "WAM PARK: watersportcentrum en waterskilift in het hart van de Savoie!\r\nGeniet van waterskiën en wakeboarden met familie en vrienden in een prachtige omgeving.\r\nActiviteiten toegankelijk voor kinderen vanaf 5 jaar."
    ],
    "es": [
      "WAM PARK: ¡centro de ocio náutico y telesquí acuático en el corazón de Saboya!\r\nDisfrute del esquí náutico y del wakeboard en familia o con amigos en un entorno suntuoso.\r\nActividades abiertas a niños a partir de 5 años."
    ]
  },
  "rdfs:label": {
    "en": [
      "WAM PARK"
    ],
    "fr": [
      "Wam Park"
    ]
  },
