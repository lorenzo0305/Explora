  "rdfs:comment": {
    "de": [
      "Das Oratorium, das an einem Wanderweg und in der Nähe der Ruinen der Abtei von Montcenoux liegt, ist der Heiligen Thorette gewidmet. Die bescheidene Hirtin wurde im 11. Jh. in der Nähe von Bourges geboren und die Bevölkerung schrieb ihr Wunder zu. Sie ist die Schutzpatronin der Gemeinde."
    ],
    "en": [
      "The oratory, located on a hiking trail near the ruins of Montcenoux Abbey, is dedicated to Ste-Thorette. A modest shepherdess born near Bourges in the 11th century, she was said to have worked miracles. She is the town's patron saint."
    ],
    "it": [
      "L'oratorio, situato su un sentiero escursionistico vicino alle rovine dell'Abbazia di Montcenoux, è dedicato a Ste-Thorette. Era una modesta pastorella nata vicino a Bourges nell'XI secolo e la popolazione locale le attribuiva miracoli. È la patrona del villaggio."
    ],
    "fr": [
      "L'oratoire, situé sur une chemin de randonnée et à proximité des ruines de l'Abbaye de Montcenoux, est dédié à Ste-Thorette. Modeste bergère née près de Bourges au 11e s., la population lui attribue des miracles. C'est la patronne de la commune."
    ],
    "nl": [
      "Het oratorium, gelegen aan een wandelpad in de buurt van de ruïnes van de abdij van Montcenoux, is gewijd aan Ste-Thorette. Ze was een bescheiden herderin die in de 11e eeuw in de buurt van Bourges werd geboren en de lokale bevolking schreef wonderen aan haar toe. Ze is de beschermheilige van het dorp."
    ],
    "es": [
      "El oratorio, situado en una ruta de senderismo cerca de las ruinas de la abadía de Montcenoux, está dedicado a Ste-Thorette. Fue una modesta pastora nacida cerca de Bourges en el siglo XI, y la población local le atribuía milagros. Es la patrona del pueblo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Oratoire Sainte-Thorette"
    ]
  },
