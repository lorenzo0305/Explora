  "rdfs:comment": {
    "de": [
      "Begleitete Ausflüge mit Elektrorollern (1 Begleitperson pro 10 Teilnehmer, darunter 2 Kinder) ab 8 Jahren.\r\nGruppenausflüge (mind. 8 Personen) im gesamten Puy-de-Dôme möglich."
    ],
    "en": [
      "Accompanied electric scooter outings (1 companion for a maximum of 10 riders, including 2 children) from age 8.\r\nPossibility of group outings (min 8 pers) throughout the Puy-de-Dôme."
    ],
    "it": [
      "Uscite in monopattino elettrico accompagnate (1 accompagnatore per un massimo di 10 persone, tra cui 2 bambini) a partire dagli 8 anni.\r\nPossibilità di uscite di gruppo (min. 8 persone) in tutto il Puy-de-Dôme."
    ],
    "fr": [
      "Sorties en trottinettes électriques accompagnées (1 accompagnant pour 10 pratiquants maximum, dont 2 enfants) à partir de 8 ans.\r\nPossibilité de sorties groupes (min 8 pers) dans tout le Puy-de-Dôme."
    ],
    "nl": [
      "Uitstapjes met een elektrische step onder begeleiding (1 begeleider voor maximaal 10 rijders, waarvan 2 kinderen) vanaf 8 jaar.\r\nMogelijkheid tot groepsuitstapjes (min. 8 personen) in de hele Puy-de-Dôme."
    ],
    "es": [
      "Salidas en scooter eléctrico con acompañante (1 acompañante para un máximo de 10 usuarios, 2 de ellos niños) a partir de 8 años.\r\nPosibilidad de salidas en grupo (mínimo 8 personas) por todo el Puy-de-Dôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trott-in Nature"
    ]
  },
