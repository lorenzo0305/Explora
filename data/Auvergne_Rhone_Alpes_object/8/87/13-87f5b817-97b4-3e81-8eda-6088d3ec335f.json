  "rdfs:comment": {
    "de": [
      "Auf halbem Weg zwischen Annecy und Aix-les-Bains, in dem charmanten Dorf Alby-sur-Chéran gelegen, ist das Restaurant Le Bourgeon entstanden. Im Herzen dieses mittelalterlichen Städtchens, umgeben von bunten Häusern und unter steinernen Arkaden."
    ],
    "en": [
      "Halfway between Annecy and Aix-les-Bains, in the charming village of Alby-sur-Chéran, the restaurant Le Bourgeon has sprung up. In the heart of this medieval village, surrounded by colourful houses and stone arcades."
    ],
    "it": [
      "A metà strada tra Annecy e Aix-les-Bains, nell'affascinante villaggio di Alby-sur-Chéran, è sorto il ristorante Le Bourgeon. Nel cuore di questo villaggio medievale, circondato da case colorate e portici in pietra."
    ],
    "fr": [
      "C’est à mi-chemin entre Annecy et Aix-les-Bains, situé dans le charmant village d’Alby-sur-Chéran, que le restaurant Le Bourgeon a éclos. Au cœur de ce bourg médiéval, entouré de maisons colorées et sous des arcades de pierre."
    ],
    "nl": [
      "Halverwege Annecy en Aix-les-Bains, in het charmante dorpje Alby-sur-Chéran, is het restaurant Le Bourgeon verrezen. In het hart van dit middeleeuwse dorp, omringd door kleurrijke huizen en stenen arcades."
    ],
    "es": [
      "A medio camino entre Annecy y Aix-les-Bains, en el encantador pueblo de Alby-sur-Chéran, ha surgido el restaurante Le Bourgeon. En el corazón de este pueblo medieval, rodeado de casas de colores y bajo arcos de piedra..."
    ]
  },
