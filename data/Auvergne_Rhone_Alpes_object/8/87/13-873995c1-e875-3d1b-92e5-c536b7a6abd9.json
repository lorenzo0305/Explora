  "rdfs:comment": {
    "de": [
      "Die Valencize ist ein Fluss, der unter dem Croix de Montvieux auf 800 m Höhe in der Gemeinde Pélussin entspringt. Das starke Gefälle verleiht ihm manchmal das Aussehen eines Gebirgsbachs und sein Lauf auf über 10 km ist sehr abwechslungsreich."
    ],
    "en": [
      "The Valencize rises below the Croix de Montvieux at an altitude of 800 m in the commune of Pélussin. Its steep gradient sometimes gives it the appearance of a mountain torrent, and its 10km course is highly varied."
    ],
    "it": [
      "La Valencize è un fiume che nasce sotto la Croix de Montvieux a 800 m di altitudine nel comune di Pélussin. La sua forte pendenza gli conferisce talvolta l'aspetto di un torrente di montagna e il suo corso, lungo più di 10 km, è molto vario."
    ],
    "fr": [
      "La Valencize est une rivière qui prend sa source sous la Croix de Montvieux à 800 m d'altitude sur la commune de Pélussin. La forte pente lui confère parfois des allures de torrent de montagne et son parcours sur plus de 10km est très varié."
    ],
    "es": [
      "El Valencize es un río que nace bajo la Croix de Montvieux, a 800 m de altitud, en el municipio de Pélussin. Su fuerte pendiente le da a veces el aspecto de un torrente de montaña, y su curso a lo largo de más de 10 km es muy variado."
    ],
    "nl": [
      "De Valencize is een rivier die ontspringt onder de Croix de Montvieux op een hoogte van 800 m in de gemeente Pélussin. Door de steile helling lijkt het soms op een bergstroom en de loop over meer dan 10 km is zeer gevarieerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche dans la rivière Valencize"
    ]
  },
