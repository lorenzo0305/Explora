  "rdfs:comment": {
    "de": [
      "Villarembert ist ein Dorf, das den Skiort Le Corbier beherbergt, einen der sechs Orte, die an das Skigebiet Les Sybelles mit seinen 310 km Pisten angeschlossen sind."
    ],
    "en": [
      "Villarembert is the village of Le Corbier, one of six resorts in the 310 km-long Les Sybelles ski area."
    ],
    "it": [
      "Villarembert ospita Le Corbier, una delle sei stazioni del comprensorio sciistico Les Sybelles, con i suoi 310 km di piste."
    ],
    "fr": [
      "Villarembert est un village qui abrite la station du Corbier, une des six stations rattachées au domaine des Sybelles et ses 310 km de pistes."
    ],
    "nl": [
      "Villarembert is de thuisbasis van Le Corbier, een van de zes resorts in het Les Sybelles skigebied, met 310 km aan pistes."
    ],
    "es": [
      "Villarembert es un pueblo que alberga la estación de Le Corbier, una de las seis estaciones anexas al dominio esquiable de Les Sybelles y sus 310 km de pistas."
    ]
  },
