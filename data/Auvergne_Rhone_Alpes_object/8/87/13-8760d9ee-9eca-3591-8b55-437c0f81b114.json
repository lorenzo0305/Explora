  "rdfs:comment": {
    "de": [
      "Ô p?tit four empfängt Sie auf dem Dorfplatz von Creys-Mépieu in einer freundlichen Atmosphäre. Der Küchenchef bietet eine abwechslungsreiche Speisekarte: Tagesgerichte, traditionelle Küche und raffinierte Gourmetküche mit vegetarischen Optionen."
    ],
    "en": [
      "Ô p’tit four welcomes you to the village square of Creys-Mépieu in a warm and friendly atmosphere.\r\nThe chef offers a dual menu featuring daily specials, traditional French cuisine, and refined gastronomic dishes, along with delicious vegetarian options."
    ],
    "it": [
      "Ô p?tit four vi accoglie nella piazza del villaggio di Creys-Mépieu in un'atmosfera amichevole. Lo chef propone un menu vario: specialità del giorno, cucina tradizionale e raffinata cucina gourmet con opzioni vegetariane."
    ],
    "fr": [
      "Ô p’tit four vous accueille sur la place du village de Creys-Mépieu dans une ambiance conviviale. Le chef propose une carte variée : plats du jour, cuisine traditionnelle et cuisine gastronomique raffinée avec des options végétariennes."
    ],
    "nl": [
      "Ô p?tit four verwelkomt u op het dorpsplein in Creys-Mépieu in een gezellige sfeer. De chef biedt een gevarieerd menu: dagschotels, traditionele gerechten en verfijnde gastronomische gerechten met vegetarische opties."
    ],
    "es": [
      "Ô p?tit four le da la bienvenida en la plaza del pueblo de Creys-Mépieu en un ambiente acogedor. El chef ofrece un menú variado: platos del día, cocina tradicional y refinada cocina gourmet con opciones vegetarianas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chantegrit"
    ],
    "fr": [
      "Ô p'tit four"
    ]
  },
