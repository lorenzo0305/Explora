  "rdfs:comment": {
    "de": [
      "Besuchen Sie ein authentisches Bauernhaus der Ardèche, Familienhaus von Alphonse Daudet (franz. Schriftsteller 1840-1897). Lernen Sie das Landleben von früher, die Seidenraupenzucht sowie den Autor von \"Die Ziege des Herrn Seguin\" kennen."
    ],
    "en": [
      "In this authentic Provençal farmhouse, the family home of Alphonse Daudet, visit the Ardèche of the 19th century, learn about silkworm farming, past and present, and get to know the author of ‘Mr. Seguin’s Goat’. Then prolong the experience at the park."
    ],
    "it": [
      "Visita a un'autentica fattoria dell'Ardèche, la casa di famiglia di Alphonse Daudet\r\n(scrittore francese 1840-1897). Scoprite la vita agricola del passato, l'allevamento dei bachi da seta e l'autore della capra del signor Seguin."
    ],
    "fr": [
      "Visitez un authentique mas ardéchois, propriété familiale d'Alphonse Daudet\r\n(écrivain Français 1840-1897). Découvrez la vie agricole d’autrefois, l'élevage du ver à soie ainsi que l'auteur de la chèvre de M. Seguin."
    ],
    "es": [
      "Visite una auténtica granja de Ardèche, la propiedad familiar de Alphonse Daudet\r\n(escritor francés 1840-1897). Descubra la vida agrícola del pasado, la cría de gusanos de seda y el autor de la cabra del señor Seguin."
    ],
    "nl": [
      "Op dit typische landgoed uit de Ardèche, familie-eigendom van Alphone Daudet, duikt u in de Ardèche van de 19e eeuw, ontdekt u de kwekerij van de levende zijderups en maakt u kennis met de schrijver van \"La Chèvre de monsieur Seguin\"."
    ]
  },
