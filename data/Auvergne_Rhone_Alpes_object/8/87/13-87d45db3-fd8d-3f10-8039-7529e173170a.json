  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Freuden des Wintersports mit ESF Albiez. Entdecken Sie die Freuden des Skifahrens, Snowboardens, Biathlons, Skitourengehens, Schneeschuhwanderns oder - warum nicht - des Snake Gliss!"
    ],
    "en": [
      "Discover the joys of winter sports with ESF Albiez. Accompanied by a passionate, qualified instructor, discover the pleasures of skiing, snowboarding, biathlon, ski touring, snowshoeing or why not... snake gliss!"
    ],
    "it": [
      "Scoprite le gioie degli sport invernali con ESF Albiez. Accompagnati da un istruttore qualificato, scoprite i piaceri dello sci, dello snowboard, del biathlon, dello sci alpinismo, delle ciaspole o, perché no, dello snake gliss!"
    ],
    "fr": [
      "Découvrez les joies des sports d'hiver avec ESF Albiez. Accompagné(e) d'une monitrice ou d'un moniteur passionné(e) et diplômé(e), découvrez les plaisirs de la glisse en ski, snowboard, biathlon, ski de rando, raquettes ou pourquoi pas… en snake gliss !"
    ],
    "nl": [
      "Ontdek de geneugten van de wintersport met ESF Albiez. Ontdek onder begeleiding van een gekwalificeerde instructeur het plezier van skiën, snowboarden, biatlon, toerskiën, sneeuwschoenwandelen of waarom niet: slangenglijden!"
    ],
    "es": [
      "Descubra los placeres de los deportes de invierno con ESF Albiez. Acompañado por un monitor cualificado, descubra los placeres del esquí, el snowboard, el biatlón, el esquí de travesía, las raquetas de nieve o, por qué no, ¡el snake gliss!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Albiez French Ski School (ESF)"
    ],
    "fr": [
      "École de Ski Français Albiez (ESF)"
    ]
  },
