  "rdfs:comment": {
    "de": [
      "Die Moulins Geek Convention ist wieder da und bietet zwei Tage lang pures Vergnügen rund um die Popkultur.\r\nVideospiele, Cosplay, Mangas, Comics, Science-Fiction... ein Muss für alle, die sich für Videospiele begeistern können, aber auch für Neugierige."
    ],
    "en": [
      "The Moulins Geek Convention returns for two days of pure pop culture fun.\r\nVideo games, cosplay, manga, comics, science fiction? an unmissable event for enthusiasts and the curious alike."
    ],
    "it": [
      "La Moulins Geek Convention torna per due giorni di puro divertimento all'insegna della cultura pop.\r\nVideogiochi, cosplay, manga, fumetti, fantascienza: un evento imperdibile per appassionati e curiosi."
    ],
    "fr": [
      "La Moulins Geek Convention revient pour deux jours de pur plaisir autour de la culture pop. \r\nJeux vidéo, cosplay, mangas, comics, science-fiction… un rendez-vous incontournable pour les passionnés comme pour les curieux."
    ],
    "es": [
      "La Moulins Geek Convention vuelve con dos días de pura cultura pop.\r\nVideojuegos, cosplay, manga, cómics, ciencia ficción... una cita ineludible para aficionados y curiosos."
    ],
    "nl": [
      "De Moulins Geek Convention keert terug voor twee dagen puur popcultuurplezier.\r\nVideogames, cosplay, manga, comics, sciencefiction? Het is een niet te missen evenement voor liefhebbers en nieuwsgierigen."
    ]
  },
