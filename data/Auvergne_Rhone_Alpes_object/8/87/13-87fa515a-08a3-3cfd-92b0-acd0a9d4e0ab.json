  "rdfs:comment": {
    "de": [
      "An der Küste, selbst der Höhe mit Hausmannskost, die vom Chefkoch und seinen Komplizen zubereitet wird.\r\nIn diesem Chalet werden Tagesgerichte, Spezialitäten und traditionelle Gerichte serviert."
    ],
    "en": [
      "In La Côte, altitude self-service with home cooking prepared by the chef and his accomplices.\r\nDish of the day, specialities and traditional dishes are served in this chalet."
    ],
    "it": [
      "A La Côte, un ristorante d'alta quota con cucina casalinga preparata dallo chef e dai suoi collaboratori.\r\nIn questo chalet vengono servite specialità giornaliere e piatti tradizionali."
    ],
    "fr": [
      "A la Côte, self d'altitude avec cuisine maison préparée par le chef et ses complices.\r\nPlat du jour, spécialités et mets traditionnels se côtoient dans ce chalet."
    ],
    "nl": [
      "In La Côte, een self-catering restaurant op grote hoogte, wordt de thuiskeuken bereid door de chef-kok en zijn medewerkers.\r\nIn dit chalet worden dagschotels en traditionele gerechten geserveerd."
    ],
    "es": [
      "En La Côte, un restaurante autoservicio de gran altitud con cocina casera preparada por el chef y sus cómplices.\r\nEn este chalé se sirven especialidades del día y platos tradicionales."
    ]
  },
