  "rdfs:comment": {
    "de": [
      "Dan beyond the clouds ist das Indie-Folk-Soloprojekt von Jordan Jupin.\r\nEin leichtes und intensives Abenteuer mit akustischen Klängen, das die Welt und ihre Bewohner hinterfragt."
    ],
    "en": [
      "Dan beyond the clouds is Jordan Jupin's indie folk solo project.\r\nA light, intense adventure with acoustic sounds, questioning the world and its residents."
    ],
    "it": [
      "Dan beyond the clouds è il progetto indie folk solista di Jordan Jupin.\r\nUn'avventura scanzonata e intensa con suoni acustici, che mette in discussione il mondo e i suoi abitanti."
    ],
    "fr": [
      "Dan beyond the clouds est le projet solo indie folk de Jordan Jupin.\r\nUne aventure légère et intense aux sonorités acoustiques, questionnant le monde et ses résidents."
    ],
    "nl": [
      "Dan beyond the clouds is het indiefolk soloproject van Jordan Jupin.\r\nHet is een licht, intens avontuur in akoestische klanken, waarbij de wereld en haar bewoners in vraag worden gesteld."
    ],
    "es": [
      "Dan beyond the clouds es el proyecto indie folk en solitario de Jordan Jupin.\r\nUna aventura desenfadada e intensa con sonidos acústicos, en la que se cuestiona el mundo y sus habitantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Dan \"beyond the clouds\""
    ]
  },
