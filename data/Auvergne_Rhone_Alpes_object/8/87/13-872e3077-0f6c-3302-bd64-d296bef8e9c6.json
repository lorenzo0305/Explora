  "rdfs:comment": {
    "de": [
      "TEYSSIERES (Alt: 659m): Mehrere Weiler liegen verstreut in der Landschaft aus Lavendel und Bergen (La Lance, Miélandre). Die Straße zum Col de Valouse verbindet das obere Lez-Tal mit Nyonsais."
    ],
    "en": [
      "TEYSSIERES (Alt: 659m): Several hamlets are scattered across a landscape of lavender and mountains (La Lance, Miélandre). The Col de Valouse road links the upper Lez valley with the Nyonsais."
    ],
    "it": [
      "TEYSSIERES (alt. 659 m): diverse frazioni sono sparse nel paesaggio di lavanda e montagne (La Lance, Miélandre). La strada per il Col de Valouse collega l'alta valle di Lez al Nyonsais."
    ],
    "fr": [
      "TEYSSIERES (Alt : 659m) : Plusieurs hameaux sont dispersés dans le paysage de lavandes et de montagnes (La Lance, Miélandre). La route du col de Valouse relie la haute vallée du Lez au Nyonsais."
    ],
    "nl": [
      "TEYSSIERES (Hoogte: 659m): Verspreid over het landschap van lavendel en bergen (La Lance, Miélandre) liggen verschillende gehuchten. De weg Col de Valouse verbindt de hoge Lez-vallei met de omgeving van Nyons."
    ],
    "es": [
      "TEYSSIERES (Alt: 659m): Varias aldeas están dispersas en el paisaje de lavanda y montañas (La Lance, Miélandre). La carretera del Col de Valouse une el alto valle del Lez con el Nyonsais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Teyssières"
    ]
  },
