  "rdfs:comment": {
    "de": [
      "Wir bieten viele Aktivitäten rund ums Pferd für alle Altersstufen an. Ponyreiten, Reitwandern für die ganze Familie, aber auch das übliche Angebot eines Reiterhofs. Und im Winter werden die Skier zum Skijöring angeschnallt, probieren Sie es doch mal aus!"
    ],
    "en": [
      "Leaving from the Font d’Alagnon (le Lioran) and Ussel, treks on horseback\r\nand pony rides. In the winter, put your skis on and initiate yourself in Ski joering in Le Lioran, ski resort."
    ],
    "it": [
      "Fattoria equestre a Ussel tutto l'anno tranne luglio e agosto.\r\nIn luglio e agosto, fattoria equestre a Font d'Alagnon a Le Lioran.\r\nVenite a scoprire la regione del Cantal a cavallo, per tutta la famiglia. Corsi e battesimi a partire da 2 anni."
    ],
    "fr": [
      "Ferme équestre à Ussel toute l'année sauf juillet et août.\r\nEn juillet et août, ferme équestre à Font d'Alagnon au Lioran.\r\nVenez découvrir le Cantal à travers la randonnée à cheval, pour toute la famille. Stages et baptêmes à partir de 2 ans."
    ],
    "es": [
      "Venga a descubrir Cantal a caballo, para toda la familia. Pasantías durante las vacaciones a partir de los 3 años."
    ],
    "nl": [
      "Paardenboerderij in Ussel het hele jaar door behalve in juli en augustus.\r\nIn juli en augustus, paardenboerderij bij Font d'Alagnon in Le Lioran.\r\nKom de Cantal ontdekken te paard, voor het hele gezin. Cursussen en dopen vanaf 2 jaar."
    ]
  },
  "rdfs:label": {
    "de": [
      "Reitwandern \"La Planèze\""
    ],
    "en": [
      "Equestrian centre \"La Planèze\""
    ],
    "fr": [
      "Fermes équestres de l'Alagnon et de la Planèze"
    ],
    "es": [
      "Granja ecuestre de la Planèze"
    ]
  },
