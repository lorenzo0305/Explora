  "rdfs:comment": {
    "de": [
      "Ein sehr französisches Restaurant! Eine große Bar empfängt Sie, Bistrotische, Holzstühle, eine altmodische Dekoration und das Ballett der Kellner in Bistrokleidung geben den Ton an. In der Küche arbeitet der Chefkoch mit Rezepten, die nach alten Zeiten duften."
    ],
    "en": [
      "A restaurant with a typical French atmosphere! A large bar, bistro tables, wooden chairs, old-fashioned decoration and waiters in bistro-style uniform. In the kitchens, the chef concocts traditional French dishes."
    ],
    "it": [
      "Un ristorante molto francese! Un grande bar vi accoglie, tavoli da bistrot, sedie in legno, un arredamento d'altri tempi e il balletto dei camerieri in abiti da bistrot danno il tono. In cucina, lo chef elabora ricette con i sapori di una volta."
    ],
    "fr": [
      "Un restaurant bien franchouillard ! Un grand bar vous accueille, des tables bistrot, des chaises en bois, une déco à l'ancienne et le ballet des serveurs en tenue bistrot donnent le ton. En cuisine le chef travaille des recettes aux parfums d'antan."
    ],
    "es": [
      "Un restaurante muy francés. Un gran bar, mesas de bistró, sillas de madera, decoración anticuada y el ballet de camareros vestidos de bistró marcan la pauta. En la cocina, el chef elabora recetas con los sabores de antaño."
    ],
    "nl": [
      "Een zeer Frans restaurant! Een grote bar verwelkomt u, bistrotafels, houten stoelen, een ouderwetse inrichting en het ballet van obers in bistrokleding zetten de toon. In de keuken werkt de chef aan recepten met de smaken van weleer."
    ]
  },
