  "rdfs:comment": {
    "de": [
      "300 Meter vom Dorfzentrum entfernt erwartet Sie das Hotel Le Fer à Cheval mit seinen 2 Schwimmbädern und seinem Spa By Kos Paris & Skinceuticals, um Ihnen die Kunst des Lebens in den Bergen näher zu bringen, in einem außergewöhnlichen Rahmen für unvergessliche Momente."
    ],
    "en": [
      "Just 300 meters from the center of the village, Le Fer à Cheval Hotel, its 2 swimming pools and its Spa By Kos Paris & Skinceuticals, awaits you to share the art of living in the mountains, in an exceptional setting for unforgettable moments."
    ],
    "it": [
      "A 300 metri dal centro del paese, l'hotel Le Fer A Cheval vi aspetta con le sue 2 piscine e la sua Spa by Carita & Décléor per condividere con voi l'arte di vivere in montagna in una cornice eccezionale, per istanti indimenticabili."
    ],
    "fr": [
      "A 300 mètres du centre du village, l'hôtel Le Fer à Cheval, ses 2 piscines et son Spa By Kos Paris & Skinceuticals, vous attendent pour vous faire partager l'art de vivre à la montagne, dans un cadre d'exception pour des moments inoubliables."
    ],
    "nl": [
      "Op slechts 300 meter van het dorpscentrum wacht hotel Le Fer à Cheval, met zijn 2 zwembaden en Spa By Kos Paris & Skinceuticals, op je om de kunst van het leven in de bergen met je te delen, in een uitzonderlijke omgeving voor onvergetelijke momenten."
    ],
    "es": [
      "A 300 metros del centro del pueblo, el hotel Le Fer à Cheval, con sus 2 piscinas y su Spa By Kos Paris & Skinceuticals, le espera para compartir con usted el arte de vivir en la montaña, en un marco excepcional para momentos inolvidables."
    ]
  },
