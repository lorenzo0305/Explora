  "rdfs:comment": {
    "de": [
      "Das in der Galerie des Intermarché gelegene Le Bistrot du Marché empfängt Sie mit einer familiären Küche mittags von Montag bis Samstag für einen Service von 12 bis 14 Uhr, die Bar ab 10.30 Uhr. ."
    ],
    "en": [
      "Located in the Intermarché shopping mall, Le Bistrot du Marché serves family-style cuisine at lunchtime from Monday to Saturday, from 12pm to 2pm, with the bar open from 10.30am. ."
    ],
    "it": [
      "Situato nella galleria commerciale Intermarché, Le Bistrot du Marché serve una cucina familiare a pranzo dal lunedì al sabato dalle 12.00 alle 14.00, con il bar aperto dalle 10.30. ."
    ],
    "fr": [
      "Situé dans la galerie de l'Intermarché, Le Bistrot du Marché vous accueille avec une cuisine familiale le midi du lundi au samedi pour un service de 12h à 14h, le bar à partir de 10h30. ."
    ],
    "es": [
      "Situado en la galería comercial Intermarché, Le Bistrot du Marché sirve cocina familiar al mediodía de lunes a sábado, de 12.00 a 14.00 h, y el bar abre a partir de las 10.30 h. ."
    ],
    "nl": [
      "Le Bistrot du Marché, gelegen in de winkelpassage Intermarché, serveert van maandag tot en met zaterdag van 12.00 tot 14.00 uur gerechten in familiestijl en de bar is open vanaf 10.30 uur."
    ]
  },
