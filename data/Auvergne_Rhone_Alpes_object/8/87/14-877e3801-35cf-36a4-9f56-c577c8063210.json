      "dc:description": {
        "de": [
          "5 Hektar großer Park, ein Paradies für Angler und\nspaziergänger, genießen Sie die Wege\ndie am Ufer der Teiche angelegt wurden"
        ],
        "en": [
          "A 5-hectare park, a paradise for fishermen and\nand walkers, come and enjoy the\nalong the banks of the ponds"
        ],
        "it": [
          "Un parco di 5 ettari, un paradiso per gli amanti della pesca e della\nvenite ad approfittare dei sentieri\nlungo le rive degli stagni"
        ],
        "fr": [
          "Parc de 5 ha, paradis des pêcheurs et des\npromeneurs, venez profiter des sentiers\naménagés au bord des étangs"
        ],
        "es": [
          "Un parque de 5 hectáreas, un paraíso para los pescadores y\nvenga a aprovechar los senderos\npor las orillas de los estanques"
        ],
        "nl": [
          "Een park van 5 hectare, een paradijs voor vissers en\nkom en profiteer van de paden\nlangs de oevers van de vijvers"
        ]
      },
