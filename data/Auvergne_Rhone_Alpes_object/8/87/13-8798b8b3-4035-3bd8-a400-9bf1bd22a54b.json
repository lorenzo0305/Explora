  "rdfs:comment": {
    "de": [
      "Laurent HUSTACHE ist Züchter und Begleiter für Reittourismus in Bourg d'Oisans. Er züchtet seit 25 Jahren Merens-Pferde und Limousin-Kühe. An schönen Tagen organisiert er auch Ausritte."
    ],
    "en": [
      "Laurent Hustache is a breeder and riding guide in Bourg d’Oisans. He has been breeding Mérens horses and Limousine cows for 25 years. He organises rides and treks in Oisans throughout spring and summer."
    ],
    "it": [
      "Laurent HUSTACHE è allevatore e guida del turismo equestre a Bourg d'Oisans. Da 25 anni alleva cavalli Merens e vacche Limousin. Organizza anche passeggiate a cavallo durante i mesi estivi."
    ],
    "fr": [
      "Laurent HUSTACHE est éleveur et accompagnateur de tourisme équestre à Bourg d’Oisans. Il élève depuis 25 ans des chevaux de Mérens et des vaches limousines. Il organise également durant les beaux jours des promenades à cheval."
    ],
    "nl": [
      "Laurent HUSTACHE is paardenfokker- en begeleider in Bourg d'Oisans.  Sinds 25 jaar is hij fokker van Mérenspaarden en Limousin koeien.  Bij mooi weer organiseert hij tevens paardenwandelingen."
    ],
    "es": [
      "Laurent HUSTACHE es criador y guía de turismo ecuestre en Bourg d'Oisans. Lleva 25 años criando caballos Merens y vacas Limousin. También organiza paseos a caballo durante los meses de verano."
    ]
  },
  "rdfs:label": {
