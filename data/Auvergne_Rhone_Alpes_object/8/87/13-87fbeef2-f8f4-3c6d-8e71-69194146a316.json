  "rdfs:comment": {
    "de": [
      "Das Atelier Mermet organisiert seine Jahresausstellung vom 8. bis 17. Mai 2026 im Espace Chambon. Die Mitglieder des Ateliers präsentieren ihre Werke, die sie im Laufe des Jahres in Malerei und Skulptur geschaffen haben."
    ],
    "en": [
      "Atelier Mermet is holding its annual exhibition from May 8 to 17, 2026 at Espace Chambon. Members of the Atelier will showcase their work in painting and sculpture over the course of the year."
    ],
    "it": [
      "L'Atelier Mermet organizza la sua mostra annuale dall'8 al 17 maggio 2026 presso l'Espace Chambon. I membri dell'Atelier esporranno le loro opere di pittura e scultura realizzate nel corso dell'anno."
    ],
    "fr": [
      "L'atelier Mermet organise son exposition annuelle di 8 au 17 mai 2026 à l'Espace Chambon. Les membres de l'Atelier présenteront leurs œuvres réalisées au cours de l'année en peinture et sculpture."
    ],
    "nl": [
      "Het Atelier Mermet houdt zijn jaarlijkse tentoonstelling van 8 tot 17 mei 2026 in de Espace Chambon. Leden van het Atelier tonen hun schilderijen en beeldhouwwerken die ze in de loop van het jaar hebben gemaakt."
    ],
    "es": [
      "El Atelier Mermet celebra su exposición anual del 8 al 17 de mayo de 2026 en el Espace Chambon. Los miembros del Atelier expondrán sus pinturas y esculturas creadas a lo largo del año."
    ]
  },
