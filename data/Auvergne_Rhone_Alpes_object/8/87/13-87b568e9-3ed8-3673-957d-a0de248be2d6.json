  "rdfs:comment": {
    "de": [
      "Nördlich der Stadt Le Puy-en-Velay liegt die Gemeinde Aiguilhe, die sich durch einen Felsen (einen alten Vulkanschlot) auszeichnet, auf dem eine überraschende und wunderschöne Kapelle steht, die seit dem 10. Jahrhundert dem heiligen Michael geweiht ist."
    ],
    "en": [
      "To the north of the town of Le Puy-en-Velay, the commune of Aiguilhe is characterised by a rock (an ancient volcanic chimney) on which stands a surprising and magnificent chapel, dedicated to Saint Michael since the 10th century."
    ],
    "it": [
      "A nord della città di Le Puy-en-Velay, il comune di Aiguilhe è caratterizzato da una roccia (un antico camino vulcanico) su cui sorge una sorprendente e magnifica cappella, dedicata a San Michele fin dal X secolo."
    ],
    "fr": [
      "Au nord de la ville du Puy-en-Velay, la commune d’Aiguilhe se caractérise par un Rocher (ancienne cheminée volcanique) sur lequel se dresse une surprenante et magnifique chapelle, dédiée à saint Michel depuis le 10ème siècle."
    ],
    "nl": [
      "Ten noorden van de stad Le Puy-en-Velay wordt de gemeente Aiguilhe gekenmerkt door een rots (een oude vulkanische schoorsteen) waarop een verrassende en prachtige kapel staat, sinds de 10e eeuw gewijd aan Sint Michiel."
    ],
    "es": [
      "Al norte de la ciudad de Le Puy-en-Velay, el municipio de Aiguilhe se caracteriza por una roca (una antigua chimenea volcánica) sobre la que se alza una sorprendente y magnífica capilla, dedicada a San Miguel desde el siglo X."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rocher et Chapelle Saint-Michel d'Aiguilhe"
    ]
  },
