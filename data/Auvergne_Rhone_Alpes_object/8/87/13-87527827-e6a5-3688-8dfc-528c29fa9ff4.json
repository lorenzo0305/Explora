  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Know-how Ihrer Region. 30 Handwerker, Künstler, Romanautoren und Lebensmittelproduzenten sind in einem geräumigen und freundlichen Raum versammelt. Dies ist der unumgängliche Ort, um einen originellen, einzigartigen oder personalisierten Artikel zu finden."
    ],
    "en": [
      "Come and discover the know-how of your region. 30 craftsmen, artists, novelists and food producers grouped together in a spacious and friendly space. It is the place to be to find an original, unique or personalized item."
    ],
    "it": [
      "Venite a scoprire il know-how della vostra regione. 30 artigiani, artisti, romanzieri e produttori di cibo raggruppati in uno spazio ampio e accogliente. Questo è il posto giusto per trovare un oggetto originale, unico o personalizzato."
    ],
    "fr": [
      "Venez découvrir le savoir-faire de votre région. 30 artisans, artistes, romanciers et producteurs alimentaires regroupés dans un espace spacieux et convivial. C'est l'endroit incontournable pour trouver un article original, unique ou personnalisé."
    ],
    "es": [
      "Venga a descubrir el saber hacer de su región. 30 artesanos, artistas, novelistas y productores de alimentos agrupados en un espacio amplio y acogedor. Este es el lugar ideal para encontrar un artículo original, único o personalizado."
    ],
    "nl": [
      "Kom en ontdek de knowhow van uw regio. 30 ambachtslieden, kunstenaars, romanschrijvers en voedselproducenten gegroepeerd in een ruime en vriendelijke ruimte. Dit is dé plek om een origineel, uniek of gepersonaliseerd voorwerp te vinden."
    ]
  },
  "rdfs:label": {
