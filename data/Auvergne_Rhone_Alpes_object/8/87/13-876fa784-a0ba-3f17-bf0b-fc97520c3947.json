  "rdfs:comment": {
    "de": [
      "In Bloye, zwischen Annecy und Aix-les-Bains, nur 5 Minuten von Rumilly entfernt, heißen wir alle willkommen, die einen authentischen Umgang mit Pferden und Ponys entdecken möchten..."
    ],
    "en": [
      "Located in Bloye, between Annecy and Aix-les-Bains, just 5 minutes from Rumilly, we welcome anyone who wants to discover an authentic approach to horses."
    ],
    "it": [
      "Situato a Bloye, tra Annecy e Aix-les-Bains, a soli 5 minuti da Rumilly, accogliamo tutte le persone che desiderano scoprire un approccio autentico ai cavalli."
    ],
    "fr": [
      "Situé à Bloye, entre Annecy et Aix-les-Bains, à seulement 5 minutes de Rumilly, nous accueillons toutes les personnes désirant découvrir une authentique approche des chevaux et des poneys.​"
    ],
    "es": [
      "Situado en Bloye, entre Annecy y Aix-les-Bains, a sólo 5 minutos de Rumilly, damos la bienvenida a todo aquel que desee descubrir un auténtico acercamiento a los caballos y ponis.."
    ],
    "nl": [
      "Gelegen in Bloye, tussen Annecy en Aix-les-Bains, op slechts 5 minuten van Rumilly, verwelkomen wij iedereen die een authentieke benadering van paarden en pony's wil ontdekken.."
    ]
  },
