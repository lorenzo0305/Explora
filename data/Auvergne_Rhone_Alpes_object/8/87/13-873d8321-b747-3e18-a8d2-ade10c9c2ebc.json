  "rdfs:comment": {
    "de": [
      "Kollektiv von Fachleuten für Aktivitäten in der Natur, die Ihnen das ganze Jahr über Themenwanderungen, Eselwanderungen, Mountainbiketouren und Mountainbikes mit Elektrounterstützung, Schneeschuhwanderungen, Alpinski und Langlauf (mit der ESF) anbieten"
    ],
    "en": [
      "A group of outdoor activity professionals offering themed hikes, donkey rides, mountain biking and electric mountain biking, snowshoeing, downhill and cross-country skiing (with ESF) all year round."
    ],
    "it": [
      "Collettivo di professionisti delle attività all'aria aperta, che vi propone tutto l'anno passeggiate a tema, passeggiate con gli asini, uscite in mountain bike e in mountain bike a pedalata assistita, escursioni con le racchette da neve, sci alpino e sci di fondo (con la FSE)"
    ],
    "fr": [
      "Collectif de professionnels des activités de pleine nature, vous proposant toute l’année des randonnées pédestres à thème, randonnées accompagnées d’ânes, sorties VTT et VTT à assistance électrique, raquettes à neige, ski alpin et ski de fond (avec l’ESF)"
    ],
    "nl": [
      "Collectief van professionals in buitenactiviteiten, dat u het hele jaar door thematische wandelingen, ezelwandelingen, uitstapjes met mountainbikes en elektrisch ondersteunde mountainbikes, sneeuwschoenwandelingen, skiën en langlaufen (met de ESF) aanbiedt"
    ],
    "es": [
      "Colectivo de profesionales de las actividades al aire libre, que le ofrece durante todo el año paseos temáticos, paseos en burro, salidas en bicicleta de montaña y con asistencia eléctrica, raquetas de nieve, esquí alpino y de fondo (con el FSE)"
    ]
  },
