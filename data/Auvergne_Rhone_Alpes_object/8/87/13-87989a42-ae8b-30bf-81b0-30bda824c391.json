  "rdfs:comment": {
    "de": [
      "\"Bassolo\" enthüllt den Kontrabass, wie man ihn selten hört: allein, ohne Kunstgriffe, in seiner ganzen akustischen Kraft.\r\nJulien Mathias enthüllt den Reichtum des Bogenspiels und erkundet ein eklektisches Repertoire, das vom Barock bis zur Gegenwart reicht."
    ],
    "en": [
      "\"Bassolo\" reveals the double bass as it is rarely heard: alone, without artifice, in all its acoustic power.\r\nJulien Mathias reveals the richness of his bowed playing, exploring an eclectic repertoire from Baroque to contemporary."
    ],
    "it": [
      "\"Bassolo\" rivela il contrabbasso come raramente lo si ascolta: da solo, senza artifici, in tutta la sua potenza acustica.\r\nJulien Mathias rivela la ricchezza del suo modo di suonare l'arco, esplorando un repertorio eclettico dal barocco al contemporaneo."
    ],
    "fr": [
      "« Bassolo » dévoile la contrebasse comme on l’entend rarement : seule, sans artifice, dans toute sa puissance acoustique. \r\nJulien Mathias y révèle la richesse du jeu à l’archet, explorant un répertoire éclectique, du baroque au contemporain."
    ],
    "es": [
      "\"Bassolo\" revela el contrabajo como pocas veces se escucha: solo, sin artificios, en toda su potencia acústica.\r\nJulien Mathias revela la riqueza de su toque de arco, explorando un repertorio ecléctico que va del barroco al contemporáneo."
    ],
    "nl": [
      "\"Bassolo\" onthult de contrabas zoals hij zelden wordt gehoord: alleen, zonder kunstgrepen, in al zijn akoestische kracht.\r\nJulien Mathias onthult de rijkdom van zijn strijkspel en verkent een eclectisch repertoire van barok tot hedendaags."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert - Julien Mathias - Contrebasse solo"
    ]
  },
