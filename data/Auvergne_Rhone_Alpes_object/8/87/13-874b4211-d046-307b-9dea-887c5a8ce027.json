  "rdfs:comment": {
    "de": [
      "Au Bureau, neue Leitung und neues Team!\r\nIn diesem komplett neu gestalteten Lokal, das mitten in der Fußgängerzone des Chablais Parc liegt, finden Sie den Charme eines englischen Pubs wieder!"
    ],
    "en": [
      "Au Bureau, new management and new team!\r\nIn this completely redecorated establishment, located in the pedestrian zone of the Chablais Parc, you will find the charm of an English pub!"
    ],
    "it": [
      "Au Bureau, nuova direzione e nuova squadra!\r\nIn questo locale completamente ristrutturato, situato nella zona pedonale del Parco Chablais, troverete il fascino di un pub inglese!"
    ],
    "fr": [
      "Au Bureau, nouvelle direction et nouvelle équipe !\r\nDans cet établissement entièrement redécoré, situé en pleine zone piétonne du Chablais Parc, retrouvez le charme d'un pub anglais !"
    ],
    "es": [
      "¡Au Bureau, nueva dirección y nuevo equipo!\r\n¡En este establecimiento completamente redecorado, situado en la zona peatonal del Chablais Parc, redescubra el encanto de un pub inglés!"
    ],
    "nl": [
      "Au Bureau, nieuwe directie en nieuw team!\r\nIn dit volledig heringerichte etablissement, gelegen in de voetgangerszone van het Chablais Parc, vindt u de charme van een Engelse pub!"
    ]
  },
