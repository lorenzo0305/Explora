  "rdfs:comment": {
    "de": [
      "Die Nocturne étudiante (Studenten-Nacht) bietet den Besuchern ein breites Spektrum an Live-Darbietungen, bildender und visueller Kunst inmitten der Sammlungen."
    ],
    "en": [
      "The Nocturne étudiante offers the public an opportunity to enjoy live performances and visual arts in the heart of the collections."
    ],
    "it": [
      "Il Nocturne étudiante offre al pubblico una grande scelta di spettacoli dal vivo e di arti visive nel cuore delle collezioni."
    ],
    "fr": [
