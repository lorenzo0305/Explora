  "rdfs:comment": {
    "de": [
      "Le Local steht für den Wunsch, sich (Ihnen) mit handwerklich hergestellten Schnellgerichten und Produkten von lokalen Partnern eine Freude zu machen. Kurz gesagt: ein großzügiges Angebot bei gleichzeitig günstigen Preisen in einem geselligen Rahmen!"
    ],
    "en": [
      "Le Local is all about indulging (you) with artisanal fast food and products from local partners. In short, a generous offer at reasonable prices, in a convivial setting!"
    ],
    "it": [
      "Le Local si propone di soddisfare le esigenze di un fast food tradizionale e di prodotti provenienti da partner locali. Insomma, un'offerta generosa a prezzi ragionevoli, in un ambiente amichevole!"
    ],
    "fr": [
      "Le Local, c'est la volonté de se (vous) faire plaisir avec de la restauration rapide artisanale et des produits issus de partenaires locaux. En bref, une offre généreuse tout en gardant des tarifs raisonnables, dans un cadre convivial !"
    ],
    "es": [
      "Le Local consiste en darse un capricho con comida rápida tradicional y productos de socios locales. En resumen, una oferta generosa a precios razonables en un ambiente acogedor."
    ],
    "nl": [
      "Bij Le Local gaat het erom jezelf te plezieren met traditioneel fastfood en producten van lokale partners. Kortom, een royaal aanbod tegen redelijke prijzen, in een vriendelijke omgeving!"
    ]
  },
  "rdfs:label": {
