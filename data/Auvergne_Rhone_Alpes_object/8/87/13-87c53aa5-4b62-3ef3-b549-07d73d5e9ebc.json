  "rdfs:comment": {
    "de": [
      "Das Klettergebiet La Fayette in Saint-Férreol d'Auroure erreicht eine Höhe von 560 m und überragt die \"Gorges de la Semène\". Der Klettergarten besteht aus 62 Routen der Schwierigkeitsgrade 3A bis 7B und hat eine breite West- bis Südausrichtung."
    ],
    "en": [
      "The La Fayette climbing site in Saint-Férreol d?Auroure rises to 560 m, overlooking the \"Gorges de la Semène\". It comprises 62 routes classified from level 3A to 7B, and has a wide West to South exposure."
    ],
    "it": [
      "Il sito di arrampicata La Fayette a Saint-Férreol d'Auroure si eleva a 560 m, con vista sulle \"Gorges de la Semène\". Dispone di 62 vie, classificate dal livello 3A al 7B, con un'ampia esposizione da ovest a sud."
    ],
    "fr": [
      "Le site d’escalade de La Fayette à Saint-Férreol d’Auroure culmine à 560 m, il domine les « Gorges de la Semène ». Il est constitué de 62 voies classées du niveau 3A au 7B et possède une large exposition Ouest à Sud."
    ],
    "es": [
      "El rocódromo de La Fayette, en Saint-Férreol d'Auroure, se eleva a 560 m y domina las gargantas de la Semène. Cuenta con 62 vías, clasificadas de nivel 3A a 7B, y goza de una amplia exposición de oeste a sur."
    ],
    "nl": [
      "De klimlocatie La Fayette in Saint-Férreol d'Auroure stijgt tot 560 meter en kijkt uit over de \"Gorges de la Semène\". Het heeft 62 routes, geclassificeerd van niveau 3A tot 7B, en geniet van een brede blootstelling van west naar zuid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site d'escalade de La Fayette"
    ]
  },
