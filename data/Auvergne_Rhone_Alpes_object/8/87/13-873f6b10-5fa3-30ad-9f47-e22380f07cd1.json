  "rdfs:comment": {
    "de": [
      "Diese in Meymans gelegene Kirche wurde im 13. Jahrhundert Notre-Dame und später Sainte Anne geweiht. Jahrhundert befestigt und von einem Wehrgang überragt, der um das Dach des Kirchenschiffs herumführt."
    ],
    "en": [
      "Located in Meymans, this church was dedicated to Notre-Dame and then Sainte Anne in the 13th century. A former dependency of the Prieuré de Jaillans, it was fortified in the 14th century and topped by a parapet walk around the roof of the nave."
    ],
    "it": [
      "Situata a Meymans, questa chiesa fu dedicata nel XIII secolo a Notre-Dame e poi a Sainte Anne. Ex dipendenza del Priorato di Jaillans, fu fortificata nel XIV secolo e sormontata da un parapetto che circonda il tetto della navata."
    ],
    "fr": [
      "Située à Meymans, cette église est dédiée au XIIIème siècle à Notre-Dame puis à Sainte Anne. Ancienne dépendance du Prieuré de Jaillans, elle est fortifiée au XIVème siècle et surmontée d'un chemin de ronde qui fait le tour du toit de la nef."
    ],
    "es": [
      "Situada en Meymans, esta iglesia fue dedicada en el siglo XIII a Notre-Dame y después a Sainte Anne. Antigua dependencia del priorato de Jaillans, fue fortificada en el siglo XIV y rematada por un camino cubierto que rodea el tejado de la nave."
    ],
    "nl": [
      "Deze kerk in Meymans was in de 13e eeuw gewijd aan Notre-Dame en daarna aan Sainte Anne. Deze voormalige dependance van de priorij van Jaillans werd in de 14e eeuw versterkt en bekroond met een borstwering rond het dak van het schip."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Sainte-Anne"
    ]
  },
