  "rdfs:comment": {
    "de": [
      "Kinderspielplatz im Park La Coulée Verte.\r\nHier gibt es verschiedene Spielgeräte für Kinder: Rutsche, Spinnennetz, Balancierstrecke, Schaukel. Picknicktische und Bänke."
    ],
    "en": [
      "Children's play area in the Coulée Verte park.\r\nVarious children's play equipment: slide, spider's web, balance course, swing. Picnic tables and benches."
    ],
    "it": [
      "Area giochi per bambini nel parco della Coulée Verte.\r\nVarie attrezzature per bambini: scivolo, ragnatela, percorso di equilibrio, altalena. Tavoli da picnic e panchine."
    ],
    "fr": [
      "Aire de jeux pour enfants dans le parc la Coulée Verte. \r\nPrésence de divers jeux pour enfants: toboggan, toile d'araignée, parcours d'équilibre, balançoire. Tables de pique-nique et bancs."
    ],
    "es": [
      "Zona de juegos infantiles en el parque Coulée Verte.\r\nDiversos juegos infantiles: tobogán, tela de araña, circuito de equilibrio, columpio. Mesas de picnic y bancos."
    ],
    "nl": [
      "Kinderspeeltuin in het park Coulée Verte.\r\nVerschillende kinderspelen: glijbaan, spinnenweb, evenwichtsparcours, schommel. Picknicktafels en banken."
    ]
  },
