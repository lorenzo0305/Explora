  "rdfs:comment": {
    "de": [
      "Steve Chapelin erweckt die seit 60 Jahren nicht mehr bewirtschafteten Weinberge im Nord-Isère zu neuem Leben. Seit 2019 ist er der Schöpfer eines BIO-Weinguts aus Rebsorten der Iseris mit unbekanntem, seltenem und lokalem Wein."
    ],
    "en": [
      "Steve Chapelin is breathing new life into the vineyards of Nord-Isère, which have been uncultivated for 60 years. Since 2019, he has been the creator of an organic vineyard of Isère grape varieties, with a wine that is little-known, rare and local."
    ],
    "it": [
      "Steve Chapelin sta dando nuova vita alle viti del Nord-Isère, incolte da 60 anni. Dal 2019 è il creatore di un'azienda vinicola biologica che produce varietà di uve rare, locali e poco conosciute dell'Isère."
    ],
    "fr": [
      "Steve Chapelin redonne vie aux vignes du Nord-Isère, non-cultivées depuis 60 ans. Depuis 2019, il est le créateur d’un domaine viticole BIO de cépages isérois au vin méconnu, rare et local."
    ],
    "es": [
      "Steve Chapelin insufla nueva vida a las viñas de Nord-Isère, que llevan 60 años sin cultivarse. Desde 2019, es el creador de una finca vinícola ecológica que produce variedades de uva raras, locales y poco conocidas de Isère."
    ],
    "nl": [
      "Steve Chapelin blaast nieuw leven in de wijngaarden van Nord-Isère, die al 60 jaar onbebouwd zijn. Sinds 2019 is hij de schepper van een biologisch wijndomein dat zeldzame, lokale en weinig bekende Isère-druivensoorten produceert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Chapelin"
    ]
  },
