  "rdfs:comment": {
    "de": [
      "Dieses Restaurant im Herzen der mittelalterlichen Stadt Montferrand bietet eine traditionelle Küche mit einigen Exzentrizitäten.\r\nDie lokalen Produkte sind sehr präsent und werden gut zur Geltung gebracht."
    ],
    "en": [
      "This restaurant, nestled in the heart of the medieval town of Montferrand, offers traditional cuisine with a few eccentric touches.\r\nLocal produce is used extensively and showcased to best advantage."
    ],
    "it": [
      "Questo ristorante, situato nel cuore della città medievale di Montferrand, propone una cucina tradizionale con qualche tocco eccentrico.\r\nI prodotti locali sono ampiamente utilizzati e valorizzati al meglio."
    ],
    "fr": [
      "Ce restaurant lové en plein cœur de la cité médiévale de Montferrand propose une cuisine traditionnelle teintée de quelques excentricités. \r\nLes produits locaux sont très présents et bien mis en valeur."
    ],
    "es": [
      "Este restaurante, situado en el corazón de la ciudad medieval de Montferrand, sirve cocina tradicional con algunos toques excéntricos.\r\nLos productos locales se utilizan en abundancia y se aprovechan al máximo."
    ],
    "nl": [
      "Dit restaurant, genesteld in het hart van de middeleeuwse stad Montferrand, serveert traditionele gerechten met een paar excentrieke accenten.\r\nEr wordt veel gebruik gemaakt van lokale producten, die goed tot hun recht komen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table de Fred"
    ]
  },
