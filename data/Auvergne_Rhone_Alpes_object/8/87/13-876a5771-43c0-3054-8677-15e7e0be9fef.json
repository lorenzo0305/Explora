  "rdfs:comment": {
    "de": [
      "Sushi hat sich in Charlieu niedergelassen: hausgemachte Produkte, die à la minute mit sorgfältig ausgewählten Zutaten zubereitet werden. Lassen Sie sich von unseren japanischen Spezialitäten verführen, bei denen Frische und Tradition aufeinandertreffen."
    ],
    "en": [
      "Sushi has arrived in Charlieu: home-made products, prepared à la minute, with carefully selected ingredients. Let yourself be tempted by our Japanese specialties, where freshness meets tradition."
    ],
    "it": [
      "Il sushi è arrivato a Charlieu: prodotti fatti in casa, preparati al minuto, con ingredienti accuratamente selezionati. Lasciatevi tentare dalle nostre specialità giapponesi, dove la freschezza incontra la tradizione."
    ],
    "fr": [
      "Les sushis se sont installés à Charlieu : des produits faits maison, préparés à la minute, avec des ingrédients soigneusement sélectionnés. Laissez vous tenter par nos spécialités japonaises où fraîcheur et tradition se rencontrent."
    ],
    "nl": [
      "Sushi is gearriveerd in Charlieu: huisgemaakte producten, tot op de minuut bereid, met zorgvuldig geselecteerde ingrediënten. Laat u verleiden door onze Japanse specialiteiten, waar versheid en traditie samenkomen."
    ],
    "es": [
      "El sushi ha llegado a Charlieu: productos caseros, preparados al minuto, con ingredientes cuidadosamente seleccionados. Déjese tentar por nuestras especialidades japonesas, donde la frescura se une a la tradición."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sushi n'co"
    ]
  },
