  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e48f69cb-3568-3920-8ea1-dc11786becba",
      "dc:description": {
        "de": [
          "- Fluss - 1. Kategorie\nBereich 1800 m²\nTagespreise\nohne Stempel = 23 €\nmit Stempel = 19 €\n\nAngeln erlaubt am Sonntag und an Feiertagen\n\n- Teich 2. Kategorie\nBereich 5500 m²\nTagespreise\nohne Stempel = 11 €\nmit Stempel = 6 €\n\nAngeln jeden Tag erlaubt!"
        ],
        "en": [
          "- River - 1st category\nEstate 1800 m² (1,800 sq. ft.)\nDay rates \nwithout stamp = 23 €\nwith stamp = € 19\n\nFishing allowed on Sundays and public holidays\n\n- Pond 2nd Category\nDomain 5500 m² (5,500 sq. ft.)\nDay rates \nwithout stamp = 11 €\nwith stamp = € 6\n\nFishing allowed every day!"
        ],
        "it": [
          "- Fiume - 1a categoria\n1800 m² di superficie\nTariffe giornaliere \nsenza timbro = 23 ?\ncon timbro = 19 ?\n\nLa pesca è consentita la domenica e nei giorni festivi\n\n- Stagno 2a categoria\nArea di 5500 m²\nTariffe giornaliere \nsenza timbro = 11 ?\ncon timbro = 6 ?\n\nPesca consentita tutti i giorni!"
        ],
        "fr": [
          "- Rivière - 1ère catégorie\nDomaine 1800 m²\nTarifs journée : \nsans timbre = 23 €\navec timbre = 19 €\n\nPêche autorisée le Dimanche et les jours fériés\n\n- Etang 2e Catégorie\nDomaine 5500 m²\nTarifs journée : \nsans timbre = 11 €\navec timbre = 6 €\n\nPêche autorisée tous les jours!"
        ],
        "nl": [
          "- Rivier - 1e categorie\n1800 m² oppervlakte\nDagtarieven \nzonder postzegel = € 23\nmet zegel = € 19\n\nVissen toegestaan op zon- en feestdagen\n\n- Vijver 2e Categorie\nOppervlakte 5500 m²\nDagtarieven \nzonder zegel = 11 € met zegel = 6\nmet postzegel = € 6\n\nVissen is elke dag toegestaan!"
        ],
        "es": [
          "- Río - 1ª categoría\n1800 m² de superficie\nTarifas diarias \nsin sello = 23 ?\ncon sello = 19 ?\n\nSe permite pescar los domingos y los días festivos\n\n- Estanque de 2ª categoría\nSuperficie de 5500 m²\nTarifas diarias \nsin sello = 11 ?\ncon sello = 6 ?\n\nLa pesca está permitida todos los días"
        ]
      },
