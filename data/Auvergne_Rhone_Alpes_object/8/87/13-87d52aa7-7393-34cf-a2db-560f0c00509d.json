  "rdfs:comment": {
    "de": [
      "Das Spa der fünf Welten des Kyriad-Hotels ist ideal im Herzen der Stadt gelegen. Nutzen Sie diesen Ort, um neue Energie zu tanken und sich einen Moment der Flucht aus dem Alltag zu gönnen."
    ],
    "en": [
      "The Kyriad Hotel's Spa des cinq mondes is ideally located in the heart of the city. Take advantage of this place to recharge your batteries and treat yourself to a moment of escape."
    ],
    "it": [
      "La Spa des cinq mondes dell'Hotel Kyriad è situata in posizione ideale nel cuore della città. Approfittate di questo luogo per ricaricare le batterie e concedervi un momento di evasione."
    ],
    "fr": [
      "Le Spa des cinq mondes de l'Hôtel Kyriad est idéalement situé au cœur de la ville. Profitez de ce lieu pour vous ressourcer et vous offrir un moment d'évasion."
    ],
    "es": [
      "El Spa des cinq mondes del hotel Kyriad goza de una ubicación ideal en pleno centro de la ciudad. Aproveche este lugar para recargar las pilas y regalarse un momento de evasión."
    ],
    "nl": [
      "De Spa des cinq mondes van het Kyriad Hotel is ideaal gelegen in het hart van de stad. Profiteer van deze plek om nieuwe energie op te doen en trakteer uzelf op een moment van ontsnapping."
    ]
  },
  "rdfs:label": {
    "fr": [
