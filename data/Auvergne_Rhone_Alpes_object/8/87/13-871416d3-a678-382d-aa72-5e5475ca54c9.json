  "rdfs:comment": {
    "de": [
      "Vom Blumendorf zum achteckigen Turm von Ratières und weiter zum Vermeille-Tal. Diese Route bietet herrliche Panoramen auf die umliegenden Landschaften, von der Ardèche bis zu den Alpen.Balade à retrouver dans notre application \"MHIKES\""
    ],
    "en": [
      "From the flowery village to the octagonal tower of Ratières, then to the Vermeille Valley. This itinerary offers magnificent panoramas of the surrounding countryside, from the Ardèche to the Alps, and can be found in \"MHIKES\" application."
    ],
    "it": [
      "Dal villaggio fiorito alla torre ottagonale di Ratières, per poi proseguire verso la Vallée de la Vermeille. Questo percorso offre magnifiche viste panoramiche sulla campagna circostante, dall'Ardèche alle Alpi."
    ],
    "fr": [
      "Du village fleuri à la tour octogonale de Ratières, puis à la Vallée de la Vermeille. Cet itinéraire offre de magnifiques panoramas sur les paysages environnants, de l’Ardèche aux Alpes.Balade à retrouver dans l'application \"MHIKES\"."
    ],
    "nl": [
      "Van het bloemrijke dorp naar de achthoekige toren van Ratières en dan verder naar de Vallée de la Vermeille. Deze route biedt prachtige panoramische uitzichten over het omringende landschap, van de Ardèche tot de Alpen."
    ],
    "es": [
      "Del pueblo florido a la torre octogonal de Ratières, pasando por el Valle de la Vermeille. Esta ruta ofrece magníficas vistas panorámicas de los alrededores, desde la Ardèche hasta los Alpes."
    ]
  },
  "rdfs:label": {
    "en": [
      "The panoramic ridge"
    ],
    "fr": [
      "La crête panoramique"
    ]
  },
