  "rdfs:comment": {
    "de": [
      "Verlängern Sie Ihre Wanderung, um einen dritten See, den Lac du Pêtre, zu überblicken.\r\nVom Pass aus haben Sie einen einzigartigen Blick auf das Tal von Courchevel, das Gebiet von La Plagne und das Mont-Blanc-Massiv."
    ],
    "en": [
      "Extend your walk for a view out over a third lake, the Lac du Pêtre.\r\nFrom the mountain pass, enjoy unrivalled views of the Courchevel valley, the La Plagne ski area and the Mont Blanc mountain range."
    ],
    "it": [
      "Estendete la vostra escursione per affacciarvi su un terzo lago, il Lac du Pêtre.\r\nDal passo si gode di una vista unica sulla valle di Courchevel, sul comprensorio sciistico di La Plagne e sul massiccio del Monte Bianco."
    ],
    "fr": [
      "Prolongez votre randonnée pour surplomber un troisième lac, le lac du Pêtre.\r\nDu col, vous profiterez d’une vue unique sur la vallée de Courchevel, le domaine de La Plagne et le massif du Mont-Blanc."
    ],
    "es": [
      "Prolongue su excursión para contemplar un tercer lago, el Lac du Pêtre.\r\nDesde el paso, podrá disfrutar de una vista única del valle de Courchevel, la estación de esquí de La Plagne y el macizo del Mont Blanc."
    ],
    "nl": [
      "Breid je wandeling uit om uit te kijken over een derde meer, Lac du Pêtre.\r\nVanaf de pas kun je genieten van een uniek uitzicht op de vallei van Courchevel, het skigebied van La Plagne en het Mont Blanc-massief."
    ]
  },
