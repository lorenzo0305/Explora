  "rdfs:comment": {
    "de": [
      "Eine hausgemachte Gourmetküche, ein untypischer Ort, lokale Produkte und ein musikalisches Ambiente... Das ist die gesunde Mischung dieses Rasthauses für Hühner... (Kann Spuren von BIO-Lebensmitteln enthalten)... Jazzkonzert an Sonntagen im Sommer!"
    ],
    "en": [
      "Gourmet home cooking, an unusual setting, local produce and a musical atmosphere... This is the clever blend of this henhouse restaurant... (May contain traces of ORGANIC food)... Jazz concerts on Sundays in summer!"
    ],
    "it": [
      "Cucina casalinga gourmet, un luogo atipico, prodotti locali e un'atmosfera musicale... Questo è il mix intelligente di questo ristorante di pollo... (Può contenere tracce di alimenti biologici)... Concerto jazz la domenica d'estate!"
    ],
    "fr": [
      "Une cuisine gourmande maison, un lieu atypique, des produits locaux et une ambiance musicale... Voici le savant mélange de ce resto poulailler... (Peut contenir des traces d'aliment BIO)... Concert Jazz les dimanches en été !"
    ],
    "nl": [
      "Gastronomische thuiskeuken, een atypische plek, lokale producten en een muzikale sfeer... Dit is de slimme mix van dit kippenhok... (Kan sporen bevatten van organisch voedsel)... Jazzconcert op zondag in de zomer !"
    ],
    "es": [
      "Cocina casera gourmet, un lugar atípico, productos locales y un ambiente musical... Esta es la mezcla inteligente de este restaurante de pollo... (Puede contener trazas de alimentos orgánicos)... ¡Concierto de jazz los domingos en verano !"
    ]
  },
