  "rdfs:comment": {
    "de": [
      "Vom 26. bis 28. Juni 2026 findet in Les 2 Alpes eine Runde des Coupe de France DH statt: ein Wochenende mit 100 % Abfahrt, an dem Elite und Amateure auf einer technischen und anspruchsvollen Piste, der Fury, zusammenkommen."
    ],
    "en": [
      "From June 26 to 28, 2026, Les 2 Alpes will welcome a stage of the French Downhill Cup: three days dedicated entirely to downhill racing, uniting top-tier athletes and passionate amateurs on a fast, technical, and highly demanding track, the Fury."
    ],
    "it": [
      "Dal 26 al 28 giugno 2026, Les 2 Alpes ospiterà una tappa della Coppa di Francia di Downhill: un weekend interamente dedicato alla discesa che riunirà atleti d’élite e amatori su una pista tecnica ed impegnativa."
    ],
    "fr": [
      "Du 26 au 28 juin 2026, Les 2 Alpes accueillent une manche de la Coupe de France DH : un week-end 100 % descente réunissant élites et amateurs sur une piste technique et exigeante, la Fury."
    ],
    "nl": [
      "Van 26 tot 28 juni 2026 vindt in Les 2 Alpes een ronde van de Franse DH Cup plaats: een 100% downhillweekend met eliterenners en amateurs op de technische en veeleisende Fury-piste."
    ],
    "es": [
      "Del 26 al 28 de junio de 2026, Les 2 Alpes acogerá una prueba de la Copa de Francia de DH: un fin de semana 100% de descenso que reunirá a riders de élite y aficionados en la técnica y exigente pista Fury."
    ]
  },
