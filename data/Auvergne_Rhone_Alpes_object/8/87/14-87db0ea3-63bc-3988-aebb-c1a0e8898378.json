  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b4f6dd40-1da4-35c9-b314-dde324534086",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck\n\nTage der Öffnung:\n\nDienstag, Mittwoch und Freitag: 15:00 - 19:00 Uhr\n\nMontag, Donnerstag, Samstag und Sonntag geschlossen\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n \n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries\n\nOpening days:\n\nTuesday, Wednesday and Friday: 3pm - 7pm\n\nClosed Monday, Thursday, Saturday and Sunday\n \n Collection:\n\nTakeaway during store opening hours\n \n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria\n\nGiorni di apertura:\n\nMartedì, mercoledì e venerdì: 15.00-19.00\n\nChiuso lunedì, giovedì, sabato e domenica\n \n Ritiro:\n\nDa asporto durante gli orari di apertura del negozio\n \n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, pâtisseries\n\nJours d'ouverture:\n\nMardi, mercredi et vendredi : 15h - 19h\n\nFermeture le lundi, jeudi, samedi et dimanche\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n \n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak\n\nOpeningsdagen:\n\nDinsdag, woensdag en vrijdag: 15.00 - 19.00 uur\n\nGesloten op maandag, donderdag, zaterdag en zondag\n \n Ophalen:\n\nAfhalen tijdens openingstijden winkel\n \n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería\n\nDías de apertura:\n\nMartes, miércoles y viernes: 15.00 - 19.00 horas\n\nCerrado los lunes, jueves, sábados y domingos\n \n Recogida:\n\nPara llevar durante el horario de apertura de la tienda\n \n "
        ]
      },
