  "rdfs:comment": {
    "de": [
      "Willkommen im ScorPub, Ihrer neuen Bar im Herzen des historischen Zentrums von Wien! Tauchen Sie ein in eine freundliche und warme Atmosphäre, in der sich die Leidenschaft für gute Drinks mit der Aufregung von Live-Sportveranstaltungen vermischt."
    ],
    "en": [
      "Welcome to ScorPub, your new must-have bar in the heart of Vienna's historic center! Immerse yourself in a warm, friendly atmosphere where a passion for good drinks meets the excitement of live sporting events."
    ],
    "it": [
      "Benvenuti allo ScorPub, il vostro nuovo bar da non perdere nel cuore del centro storico di Vienna! Immergetevi in un'atmosfera calda e accogliente, dove la passione per i buoni drink incontra l'emozione degli eventi sportivi dal vivo."
    ],
    "fr": [
      "Bienvenue au ScorPub, votre nouveau bar incontournable au cœur du centre historique de Vienne ! Plongez dans une ambiance conviviale et chaleureuse où la passion pour les bonnes boissons se mêle à l'excitation des événements sportifs en direct."
    ],
    "nl": [
      "Welkom bij ScorPub, je nieuwe must-visit bar in het hart van het historische centrum van Wenen! Dompel jezelf onder in een warme en vriendelijke sfeer waar passie voor goede drankjes samenkomt met de opwinding van live sportevenementen."
    ],
    "es": [
      "Bienvenido al ScorPub, su nuevo bar de visita obligada en el corazón del centro histórico de Viena Sumérjase en un ambiente cálido y acogedor donde la pasión por las buenas bebidas se une a la emoción de los acontecimientos deportivos en directo."
    ]
  },
  "rdfs:label": {
