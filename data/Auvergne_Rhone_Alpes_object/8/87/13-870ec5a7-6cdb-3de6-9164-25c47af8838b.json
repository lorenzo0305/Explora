  "rdfs:comment": {
    "de": [
      "Das Hotel und sein neues Team befinden sich in der Nähe der Autobahn A71, an der Kreuzung aller Straßen, die Montluçon und seine Region bedienen. An schönen Tagen bietet das Hotel seine schattige Terrasse zum Mittag- oder Abendessen an."
    ],
    "en": [
      "Situated near the A71 motorway, at the crossroads of all the roads serving Montluçon and its region, the hotel and its new team offers its shaded terrace for lunch or dinner on sunny days."
    ],
    "it": [
      "Situato vicino all'autostrada A71, all'incrocio di tutte le strade che servono Montluçon e la sua regione, l'hotel e il suo nuovo team offrono una terrazza ombreggiata per pranzare o cenare nella bella stagione."
    ],
    "fr": [
      "Situé près de l'autoroute A71, au carrefour de tous les axes routiers desservant Montluçon et sa région, l'hôtel et sa nouvelle équipe propose sa terrasse ombragée pour le déjeuner ou le dîner aux beaux jours."
    ],
    "es": [
      "Situado cerca de la autopista A71, en el cruce de todas las carreteras que dan servicio a Montluçon y su región, el hotel y su nuevo equipo ofrecen una terraza a la sombra para comer o cenar cuando hace buen tiempo."
    ],
    "nl": [
      "Het hotel ligt vlakbij de snelweg A71, op het kruispunt van alle wegen naar Montluçon en de regio. Bij mooi weer biedt het hotel en zijn nieuwe team een schaduwrijk terras voor de lunch of het diner."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant Campanile"
    ]
  },
