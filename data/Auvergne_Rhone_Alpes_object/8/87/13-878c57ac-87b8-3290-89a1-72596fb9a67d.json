  "rdfs:comment": {
    "de": [
      "Dieser Ort überragt das Trièves-Gebiet und bietet ein herrliches Panorama in der grandiosen Umgebung des Mont-Aiguille. Seine Höhe und die vielen Sonnenstunden machen ihn zu einem idealen Ort für schöne Frühlings- und Sommertage."
    ],
    "en": [
      "This site overlooks the Trièves and offers superb panoramic views of the imposing Mont-Aiguille. Its altitude and sunshine make it an ideal site for beautiful spring and summer days."
    ],
    "it": [
      "Questo sito domina le Trièves e offre un panorama superbo nella grandiosa cornice del Mont-Aiguille. L'altitudine e il sole ne fanno un sito ideale per le belle giornate di primavera ed estate."
    ],
    "fr": [
      "Site dominant le Trièves et réserve un panorama superbe dans le cadre grandiose du Mont-Aiguille. Son altitude et son ensoleillement en font un site idéal pour les belles journées du printemps et de l'été."
    ],
    "es": [
      "Este emplazamiento domina el Trièves y ofrece un magnífico panorama en el grandioso marco del Mont-Aiguille. Su altitud y su sol hacen que sea un sitio ideal para los hermosos días de primavera y verano."
    ],
    "nl": [
      "Deze plaats domineert de Trièves en biedt een prachtig panorama in de grandioze omgeving van de Mont-Aiguille. De hoogte en de zon maken het een ideale plek voor de mooie dagen van de lente en de zomer."
    ]
  },
  "rdfs:label": {
    "en": [
      "Trézanne climbing site"
    ],
    "fr": [
      "Site d’escalade de Trézanne"
    ]
  },
