  "rdfs:comment": {
    "de": [
      "Diese im Grésivaudan in Villard-Bonnot (zwischen Grenoble und Chambéry) gelegene Kultureinrichtung wird von der Communauté de communes Le Grésivaudan verwaltet und bietet jedes Jahr eine Saison mit verschiedenen Aufführungen."
    ],
    "en": [
      "Located in Villard-Bonnot (between Grenoble and Chambéry) in the Grésivaudan region, this cultural facility, managed by the Communauté de communes Le Grésivaudan, offers a season of shows every year."
    ],
    "it": [
      "Situata a Villard-Bonnot, nella regione del Grésivaudan (tra Grenoble e Chambéry), questa struttura culturale, gestita dalla Comunità dei Comuni del Grésivaudan, organizza ogni anno una stagione di spettacoli."
    ],
    "fr": [
      "Situé dans le Grésivaudan à Villard-Bonnot (entre Grenoble et Chambéry), cet équipement culturel, géré par la Communauté de communes Le Grésivaudan, propose chaque année un saison de spectacles."
    ],
    "es": [
      "Situado en Villard-Bonnot, en la región de Grésivaudan (entre Grenoble y Chambéry), este equipamiento cultural, gestionado por la Mancomunidad de Municipios de Le Grésivaudan, organiza cada año una temporada de espectáculos."
    ],
    "nl": [
      "Dit culturele centrum in Villard-Bonnot in de regio Grésivaudan (tussen Grenoble en Chambéry), dat wordt beheerd door de gemeente Le Grésivaudan, organiseert elk jaar een seizoen vol voorstellingen."
    ]
  },
