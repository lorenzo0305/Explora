  "rdfs:comment": {
    "de": [
      "Ihre Pizzeria Basilic & Co empfängt Sie 7 Tage die Woche im Stadtzentrum von Roanne. Probieren Sie über dreißig Pizzarezepte, die vor Ihren Augen mit regionalen Produkten zubereitet werden. Auch Pizetten, Salate und Desserts werden hier angeboten."
    ],
    "en": [
      "Your Basilic & Co pizzeria welcomes you 7/7 in downtown Roanne. Taste over thirty different pizza recipes, prepared before your very eyes with the finest local produce. You'll also love our pizzettes, salads and gourmet desserts."
    ],
    "it": [
      "La vostra pizzeria Basilic & Co è aperta 7 giorni su 7 nel centro di Roanne. Potrete gustare oltre trenta diverse ricette di pizza, preparate davanti ai vostri occhi con prodotti locali. Potete anche provare le nostre pizzette, le insalate e i dessert gourmet."
    ],
    "fr": [
      "Votre pizzeria Basilic & Co vous accueille 7j/7 au centre-ville de Roanne. Dégustez plus d’une trentaine de recettes de pizzas, préparées sous vos yeux avec de bons produits de terroirs. Craquez aussi pour les pizettes, les salades et desserts gourmands."
    ],
    "es": [
      "Su pizzería Basilic & Co está abierta los 7 días de la semana en el centro de Roanne. Disfrute de más de treinta recetas de pizza diferentes, preparadas ante sus ojos con productos locales. También puede probar nuestras pizzetas, ensaladas y postres gourmet."
    ],
    "nl": [
      "De pizzeria Basilic & Co is 7 dagen per week geopend in het centrum van Roanne. Geniet van meer dan dertig verschillende pizzarecepten, voor je ogen bereid met lokale producten. Je kunt ook onze pizzettes, salades en gastronomische desserts proberen."
    ]
  },
