  "rdfs:comment": {
    "de": [
      "Gemütliches Café mit lokal geröstetem Spezialitätenkaffee von LOMI, handwerklich gebrauten Bieren, Frühstück, saisonalem Mittagessen und hausgemachtem Gebäck.\r\nAusternbar Freitag und Samstag 11:00-14:00 Uhr (Sept.-Mai)\r\nSommerabende jeden Donnerstag"
    ],
    "en": [
      "Friendly café offering specialty coffee roasted locally by LOMI, craft beers, breakfasts, seasonal lunches and homemade pastries.\r\nOyster bar Friday and Saturday 11am-2pm (Sept - May)\r\nSummer evenings every Thursday"
    ],
    "it": [
      "Caffetteria accogliente che serve caffè speciale tostato localmente da LOMI, birre artigianali, colazioni, pranzi stagionali e dolci fatti in casa.\r\nOyster bar venerdì e sabato 11.00-14.00 (settembre-maggio)\r\nSerate estive ogni giovedì"
    ],
    "fr": [
      "Café convivial proposant du café de spécialité torréfié localement par LOMI, bières artisanales, petits- déjeuners, déjeuners de saison et pâtisseries maison.\r\nBar à huîtres vendredi et samedi 11h-14h00 (sept - mai)\r\nSoirées estivales tous les jeudis"
    ],
    "nl": [
      "Vriendelijk café met lokaal door LOMI gebrande koffie, ambachtelijk bier, ontbijt, seizoenslunches en zelfgemaakt gebak.\r\nOesterbar vrijdag en zaterdag van 11.00 tot 14.00 uur (sept. - mei)\r\nZomeravonden elke donderdag"
    ],
    "es": [
      "Agradable cafetería que sirve especialidades de café tostado localmente por LOMI, cervezas artesanales, desayunos, almuerzos de temporada y repostería casera.\r\nBar de ostras los viernes y sábados de 11:00 a 14:00 (de septiembre a mayo)\r\nNoches de verano todos los jueves"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Corazon Café"
    ]
  },
