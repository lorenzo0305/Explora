  "rdfs:comment": {
    "de": [
      "Probieren Sie Ihre schönsten Sprünge und Freestyle-Figuren auf dem Big Airbag an der Seilbahn La Logère aus! Der Zugang ist kostenlos und für alle offen! An zwei Nachmittagen pro Woche gibt es musikalische Unterhaltung."
    ],
    "en": [
      "Try out your best jumps and freestyle tricks on the Big Airbag at the Logère cable car! Free access and open to all! Musical entertainment two afternoons a week."
    ],
    "it": [
      "Mettete alla prova i vostri migliori salti e trick freestyle sul Big Airbag della funivia del Logère! Gratuito e aperto a tutti! Animazione musicale 2 pomeriggi a settimana."
    ],
    "fr": [
      "Testez vos plus beaux sauts, figures freestyles sur le Big Airbag à la Télécabine de la Logère ! Accès gratuit et ouvert à tous ! Animations musicales 2 après-midi par semaine."
    ],
    "nl": [
      "Test je beste sprongen en freestyle tricks op de Big Airbag bij de kabelbaan van Logère! Gratis en open voor iedereen! Muzikaal entertainment 2 middagen per week."
    ],
    "es": [
      "Pon a prueba tus mejores saltos y trucos de freestyle en el Big Airbag del teleférico de Logère Gratis y abierto a todos Animación musical 2 tardes a la semana."
    ]
  },
