  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen leckeren und festlichen Moment, der auch die Eröffnung unserer neuen Verkaufsstelle markiert, mit Produkten direkt aus der Mandelplantage und dem Bienenhaus!"
    ],
    "en": [
      "Come and enjoy a gourmet and festive moment that will also mark the opening of our new sales outlet, with products directly from the almond grove and apiary!"
    ],
    "it": [
      "Venite a godervi un momento delizioso e festoso, che segnerà anche l'apertura del nostro nuovo punto vendita, con prodotti provenienti direttamente dal mandorleto e dall'apiario!"
    ],
    "fr": [
      "Venez passer un moment gourmand et festif qui marquera aussi l’ouverture de notre nouveau point de vente, des produits directement issu de l’amanderaie et du rucher  !"
    ],
    "es": [
      "Venga a disfrutar de un momento delicioso y festivo, que marcará también la apertura de nuestro nuevo punto de venta, con productos directamente procedentes del almendro y el colmenar"
    ],
    "nl": [
      "Kom genieten van een heerlijk en feestelijk moment, dat ook de opening zal markeren van ons nieuwe verkooppunt, met producten rechtstreeks uit de amandelboomgaard en bijenstal!"
    ]
  },
  "rdfs:label": {
