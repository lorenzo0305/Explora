  "rdfs:comment": {
    "de": [
      "Das Kino in Saint-Genix-sur-Guiers zeigt zwischen 3 und 4 Filme pro Woche. Genießen Sie die neuesten Filme in einem hochwertigen Saal mit modernster Dolby-5.1-Soundtechnik - ganz in Ihrer Nähe!"
    ],
    "en": [
      "The cinema of Saint-Genix-sur-Guiers broadcasts between 3 to 4 movies every week. You will appreciate the new movies coming out in a quality room, equipped with Dolby 5.1 sound."
    ],
    "it": [
      "Il cinema di Saint-Genix-sur-Guiers proietta da 3 a 4 film a settimana. Potrete godervi film recenti in un cinema di qualità, dotato della più recente tecnologia audio Dolby 5.1, a due passi da casa vostra!"
    ],
    "fr": [
      "Le cinéma de Saint-Genix-sur-Guiers projette entre 3 et 4 films par semaine. Vous apprécierez les films récents dans une salle de qualité, équipée de la technologie de pointe du son dolby 5.1, à deux pas de chez vous !"
    ],
    "es": [
      "El cine de Saint-Genix-sur-Guiers proyecta entre 3 y 4 películas por semana. Podrá disfrutar de películas recientes en un cine de calidad, equipado con la última tecnología de sonido Dolby 5.1, ¡a un paso de su casa!"
    ],
    "nl": [
      "De bioscoop in Saint-Genix-sur-Guiers vertoont 3 tot 4 films per week. U geniet van recente films in een kwaliteitsbioscoop, uitgerust met de nieuwste Dolby 5.1 geluidstechnologie, op een steenworp afstand van uw huis!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Atmosphere cinema"
    ],
    "fr": [
      "Cinéma Atmosphère"
    ]
  },
