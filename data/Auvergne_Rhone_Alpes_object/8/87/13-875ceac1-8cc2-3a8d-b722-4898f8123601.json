  "rdfs:comment": {
    "de": [
      "Das in der Auvergne im Puy de Dôme gelegene Steinmetzatelier Philippe Marpillat untersucht alle Ihre Projekte für Innen- und Außenmöbel: Couchtische, Spülbecken, Arbeitsplatten, Kamine, Brunnen, Bänke, Skulpturen..."
    ],
    "en": [
      "Located in the Puy de Dôme region of the Auvergne, the Philippe Marpillat stone-cutting workshop can design all your interior and exterior furniture projects: coffee tables, sinks, worktops, fireplaces, fountains, benches, sculptures..."
    ],
    "it": [
      "Situato nella regione del Puy de Dôme, in Alvernia, il laboratorio di taglio della pietra di Philippe Marpillat studierà tutti i vostri progetti di arredamento per interni ed esterni: tavolini, lavandini, piani di lavoro, caminetti, fontane, panchine, sculture..."
    ],
    "fr": [
      "Situé en Auvergne dans le Puy de Dôme, l'Atelier de taille de pierres Philippe Marpillat étudie tous vos projets de mobilier intérieur et extérieur : tables basses, éviers, plans de travail, cheminées, fontaines, bancs, sculptures.."
    ],
    "es": [
      "Situado en la región de Puy de Dôme, en Auvernia, el taller de cantería Philippe Marpillat estudiará todos sus proyectos de mobiliario interior y exterior: mesas de centro, lavabos, encimeras, chimeneas, fuentes, bancos, esculturas..."
    ],
    "nl": [
      "Het steenhouwatelier van Philippe Marpillat, gelegen in de Puy de Dôme in de Auvergne, bestudeert al uw projecten voor binnen- en buitenmeubilair: salontafels, gootstenen, werkbladen, schouwen, fonteinen, banken, beeldhouwwerken..."
    ]
  },
