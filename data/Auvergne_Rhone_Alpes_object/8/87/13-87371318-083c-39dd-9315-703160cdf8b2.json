  "rdfs:comment": {
    "de": [
      "GAEC de la Veyssaire ? Ein Bauernhof zum Entdecken im Herzen der Region\r\n\r\nDie GAEC de la Veyssaire öffnet Ihnen die Türen ihres Hofes für einen authentischen Besuch, bei dem Sie die Landwirtschaft und das lokale Know-how hautnah erleben können."
    ],
    "en": [
      "GAEC de la Veyssaire ? A farm to discover in the heart of the terroir\r\n\r\nThe GAEC de la Veyssaire opens the doors of its farm for an authentic visit, with a close-up view of local agriculture and know-how."
    ],
    "it": [
      "GAEC de la Veyssaire ? Una fattoria da scoprire nel cuore della regione\r\n\r\nIl GAEC de la Veyssaire vi apre le porte della sua fattoria per una visita autentica, con una visione ravvicinata dell'agricoltura e del know-how locali."
    ],
    "fr": [
      "GAEC de la Veyssaire – Une ferme à découvrir au cœur du terroir\r\n\r\nLe GAEC de la Veyssaire vous ouvre les portes de son exploitation pour une visite authentique, au plus près de l’agriculture et des savoir-faire locaux."
    ],
    "es": [
      "GAEC de la Veyssaire ? Una granja por descubrir en el corazón de la región\r\n\r\nEl GAEC de la Veyssaire le abre las puertas de su granja para una visita auténtica, con una visión cercana de la agricultura y el saber hacer locales."
    ],
    "nl": [
      "GAEC de la Veyssaire ? Een boerderij om te ontdekken in het hart van de regio\r\n\r\nDe GAEC de la Veyssaire opent de deuren van zijn boerderij voor een authentiek bezoek, met een close-up van de lokale landbouw en knowhow."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC de la Veyssaire"
    ]
  },
