  "rdfs:comment": {
    "de": [
      "Die Auberge du Guéry ist ein Hotel und Restaurant am Seeufer, das aus 7 Zimmern, darunter 1 Suite, und einem Wellnessbereich (finnische Sauna, Trainingsrad, Dusche und Massage auf Anfrage) besteht."
    ],
    "en": [
      "L'Auberge du Guéry is a hotel restaurant on the lake, composed of 7 rooms including 1 suite and a wellness area (sauna, hammam and massage on request)."
    ],
    "it": [
      "L'Auberge du Guéry è un hotel-ristorante sul lago con 7 camere, tra cui 1 suite, e un'area benessere (sauna finlandese, cyclette, doccia e massaggi su richiesta)."
    ],
    "fr": [
      "L'Auberge du Guéry est un hôtel restaurant en bord de lac, composé de 7 chambres dont 1 suite et d'un espace bien-être (sauna finlandais, vélo d'exercice, douche et massage sur demande)."
    ],
    "es": [
      "El Auberge du Guéry es un hotel-restaurante a orillas del lago con 7 habitaciones, incluida 1 suite, y una zona de bienestar (sauna finlandesa, bicicleta estática, ducha y masajes bajo petición)."
    ],
    "nl": [
      "De Auberge du Guéry is een hotel-restaurant aan het meer met 7 kamers, waarvan 1 suite, en een wellnessruimte (Finse sauna, hometrainer, douche en massage op aanvraag)."
    ]
  },
