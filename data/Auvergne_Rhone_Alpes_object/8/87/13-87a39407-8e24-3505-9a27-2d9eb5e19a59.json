  "rdfs:comment": {
    "de": [
      "Das Atelier Pimpelume empfängt Sie für alle Ihre Nähprojekte: Anfertigung von Kleidung, Möbeln, Accessoires, Änderungen und Reparaturen.\r\nIch biete Ihnen Nähworkshops für alle Niveaus ab ca. 7 Jahren an."
    ],
    "en": [
      "L'atelier Pimpelume welcomes you for all your sewing projects: garment making, furnishing, accessories, alterations and repairs.\r\nI offer sewing workshops for all levels from about 7 years old."
    ],
    "it": [
      "Il laboratorio Pimpelume vi accoglie per tutti i vostri progetti di cucito: realizzazione di abiti, arredi, accessori, modifiche e riparazioni.\r\nOffro laboratori di cucito per tutti i livelli, da circa 7 anni in su."
    ],
    "fr": [
      "L'atelier Pimpelume vous accueille pour tous vos projets couture : confection de vêtements, ameublement, accessoires, retouches et réparations.\r\nJe vous propose des ateliers coutures tous niveaux à partir de 7 ans environ."
    ],
    "nl": [
      "In het Pimpelume atelier kun je terecht voor al je naaiprojecten: het maken van kleding, meubels, accessoires, verstelwerk en reparaties.\r\nIk bied naaiworkshops aan voor alle niveaus vanaf ongeveer 7 jaar."
    ],
    "es": [
      "El taller Pimpelume te acoge para todos tus proyectos de costura: confección de ropa, mobiliario, accesorios, arreglos y reparaciones.\r\nOfrezco talleres de costura para todos los niveles a partir de 7 años aproximadamente."
    ]
  },
