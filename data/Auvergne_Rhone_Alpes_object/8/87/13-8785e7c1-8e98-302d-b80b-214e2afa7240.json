  "rdfs:comment": {
    "de": [
      "In einem angenehmen und gemütlichen Rahmen mit einer Fassade aus Naturstein bieten wir Ihnen eine regionale und raffinierte Küche in einer malerischen Umgebung. Karte mit Gerichten zum Mitnehmen."
    ],
    "en": [
      "In a pleasant and warm setting with an exposed stone facade, we offer refined regional cuisine in a picturesque environment. Takeaway menu."
    ],
    "it": [
      "In un ambiente piacevole e caldo con una facciata in pietra a vista, offriamo una raffinata cucina regionale in un ambiente pittoresco. Menu da asporto."
    ],
    "fr": [
      "Dans un cadre agréable et chaleureux avec une façade en pierres apparentes, nous vous proposons une cuisine régionale et raffinée dans un environnement pittoresque. Carte de plats à emporter."
    ],
    "nl": [
      "In een warme en gastvrije omgeving met een gevel van zichtbare stenen bieden we verfijnde regionale gerechten in een schilderachtige omgeving. Afhaalmenu."
    ],
