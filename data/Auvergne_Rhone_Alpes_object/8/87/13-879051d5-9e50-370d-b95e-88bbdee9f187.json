  "rdfs:comment": {
    "de": [
      "Das Hotel befindet sich in einer idyllischen Umgebung mit Bergblick, 10 Min. südlich von Grenoble und in der Nähe der Hauptverkehrsstraßen. Klimatisierte Zimmer, Frühstücksbuffet. Traditionelle und kreative Gastronomie."
    ],
    "en": [
      "The hotel is located in an idyllic setting with mountain views, 10 minutes south of Grenoble and close to major roads. Air-conditioned rooms, buffet breakfast. Traditional and creative cuisine."
    ],
    "it": [
      "L'hotel è situato in un ambiente idilliaco con vista sulle montagne a 10 minuti a sud di Grenoble e vicino agli assi principali. Camere climatizzate, prima colazione a buffet. Ristorazione tradizionale e creativa: Label (marchio) Maître restaurateur."
    ],
    "fr": [
      "L'hôtel des Trois Massifs 3 *, 45 chambres, est situé à 10 mn au sud de Grenoble et proche des grands axes routiers. Chambres confortables et climatisées. Le restaurant vous accueille pour les petits déjeuners et le diner."
    ],
    "nl": [
      "Het 3-sterrenhotel Trois Massifs, met 45 kamers, ligt 10 minuten ten zuiden van Grenoble en dicht bij grote wegen. Comfortabele kamers met airconditioning. Het restaurant serveert ontbijt en diner."
    ],
    "es": [
      "El hotel está situado en un entorno idílico con vistas a la montaña, a 10 minutos al sur de Grenoble y cerca de las principales carreteras. Habitaciones con aire acondicionado, desayuno buffet. Cocina tradicional y creativa."
    ]
  },
