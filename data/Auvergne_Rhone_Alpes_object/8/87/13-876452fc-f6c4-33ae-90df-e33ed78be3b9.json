  "rdfs:comment": {
    "de": [
      "An der Nationalstraße 122 gelegen, 20min von Le Lioran, 10min von Murat. Ideal gelegen, um eine kleine Pause einzulegen, Kinderspielplatz im Freien, ein sehr großer Parkplatz mit behindertengerechtem Zugang. Aber auch eine einfache, abwechslungsreiche und lokale Speisekarte."
    ],
    "en": [
      "Located on Route Nationale 122, 20min from Le Lioran, 10min from Murat. Ideally placed for a short break, outdoor play area for children, ample parking with handicapped access. But also a simple, varied and local menu."
    ],
    "it": [
      "Situato sulla Route Nationale 122, a 20 minuti da Le Lioran e a 10 minuti da Murat. Posizione ideale per una breve pausa, area giochi all'aperto per bambini, parcheggio molto ampio con accesso per disabili. Ma anche un menu semplice, vario e locale."
    ],
    "fr": [
      "Située sur la Route Nationale 122, 20min du Lioran, 10min De Murat.. Idéalement placé pour s'arrêter faire une petite pause, aire de jeux extérieur pour enfants, un très grand parking avec accès handicapé. Mais aussi une carte simple, variée et locale."
    ],
    "es": [
      "Situado en la Route Nationale 122, a 20 minutos de Le Lioran y a 10 minutos de Murat. Idealmente situado para una escapada, zona de juegos al aire libre para los niños, aparcamiento muy grande con acceso para minusválidos. Pero también un menú sencillo, variado y local."
    ],
    "nl": [
      "Gelegen aan de Route Nationale 122, op 20 minuten van Le Lioran en 10 minuten van Murat. Ideaal voor een korte vakantie, speeltuin voor de kinderen, zeer grote parkeerplaats met toegang voor gehandicapten. Maar ook een eenvoudig, gevarieerd en lokaal menu."
    ]
  },
