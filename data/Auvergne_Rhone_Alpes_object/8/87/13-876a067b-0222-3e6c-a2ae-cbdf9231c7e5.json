  "rdfs:comment": {
    "de": [
      "Leichter und schattiger Familienspaziergang durch den Wald ab Villarlurin.\r\nEs besteht die Möglichkeit, eine Schleife zu machen und über den Doron-Pfad zurückzukehren. (+ 2h)."
    ],
    "en": [
      "Easy, shady family walk in the forest starting from Villarlurin.\r\nPossibility of making a loop by returning along the Doron trail. (+ 2h)."
    ],
    "it": [
      "Facile e ombreggiata passeggiata per famiglie nel bosco con partenza da Villarlurin.\r\nPossibilità di fare un anello ritornando lungo il sentiero Doron. (+ 2h)."
    ],
    "fr": [
      "Balade familiale facile et ombragée dans la forêt au départ de Villarlurin.\r\nPossibilité de faire une boucle en revenant par le sentier du Doron. (+  2h)."
    ],
    "es": [
      "Paseo familiar fácil y sombreado por el bosque partiendo de Villarlurin.\r\nPosibilidad de hacer un bucle volviendo por el camino de Doron. (+ 2h)."
    ],
    "nl": [
      "Makkelijke, schaduwrijke familiewandeling in het bos vanaf Villarlurin.\r\nMogelijkheid om een lus te maken door terug te keren langs het Doron-pad. (+ 2h)."
    ]
  },
  "rdfs:label": {
