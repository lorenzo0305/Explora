  "rdfs:comment": {
    "de": [
      "Zwischen Bellenaves und Saint-Bonnet-de-Rochefort erreichen Sie das Plateau\r\nvon Naves, dem Dorf mit den zahlreichen Waschplätzen, und genießen Sie weite Ausblicke auf die Ebene. Mit dem Zug hin und zu Fuß zurück (oder umgekehrt): die Originalität einer Zugwanderung."
    ],
    "en": [
      "Between Bellenaves and Saint-Bonnet-de-Rochefort, reach the plateau\r\nof Naves, the village with its many wash-houses, and enjoy sweeping views over the plain. Go by train and return on foot (or vice versa): the originality of a train-hike."
    ],
    "it": [
      "Tra Bellenaves e Saint-Bonnet-de-Rochefort, dirigetevi verso l'altopiano di Naves, il villaggio con i suoi numerosi lavatoi, e godetevi un'ampia vista sulla pianura\r\ndi Naves, il villaggio con i suoi numerosi lavatoi, e godere di ampie vedute sulla pianura. Andare in treno e tornare a piedi (o viceversa): l'originalità di un'escursione in treno."
    ],
    "fr": [
      "Entre Bellenaves et Saint-Bonnet-de-Rochefort, gagnez le plateau\r\nde Naves, le village aux nombreux lavoirs, et profitez de larges vues sur la plaine. Aller en train et retour à pied (ou l'inverse) : l'originalité d'une rando-train."
    ],
    "nl": [
      "Ga tussen Bellenaves en Saint-Bonnet-de-Rochefort naar het plateau van Naves\r\nvan Naves, het dorp met de vele wasplaatsen, en geniet van een prachtig uitzicht over de vlakte. Ga met de trein en keer te voet terug (of omgekeerd): de originaliteit van een treinwandeling."
    ],
    "es": [
      "Entre Bellenaves y Saint-Bonnet-de-Rochefort, diríjase a la meseta de Naves, el pueblo de los lavaderos\r\nde Naves, el pueblo con sus numerosos lavaderos, y disfrute de amplias vistas sobre la llanura. Ir en tren y volver a pie (o viceversa): la originalidad de una excursión en tren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rando-Train Les Plateaux"
    ]
  },
