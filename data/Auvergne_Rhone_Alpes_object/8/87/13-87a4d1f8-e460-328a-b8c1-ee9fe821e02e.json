  "rdfs:comment": {
    "de": [
      "Der Felsen von Mousset liegt versteckt am Ende der Halbinsel und strahlt Ruhe aus. Nur ein kleiner Pinienwald trennt den Felsen vom Fuß des Wassers."
    ],
    "en": [
      "Mousset rock, hidden away at the end of the peninsula, exudes tranquility. Only a small pine forest separates the rock from the water's edge."
    ],
    "it": [
      "Lo scoglio di Mousset, nascosto all'estremità della penisola, emana tranquillità. Solo una piccola pineta separa la roccia dall'acqua."
    ],
    "fr": [
      "Le rocher de Mousset, dissimulé en bout de presqu'île, respire la tranquilLité. Seule une petite pinède sépare le rocher du pied de l'eau."
    ],
    "es": [
      "La roca Mousset, escondida al final de la península, desprende tranquilidad. Sólo un pequeño pinar separa la roca del agua."
    ],
    "nl": [
      "De rots van Mousset, verborgen aan het einde van het schiereiland, straalt rust uit. Alleen een klein dennenbos scheidt de rots van het water."
    ]
  },
  "rdfs:label": {
