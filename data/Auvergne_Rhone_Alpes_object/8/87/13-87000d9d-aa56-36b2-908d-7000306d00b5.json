  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Central Bar in Villard-de-Lans, eine Brasserie mit viel Charme im Herzen des Dorfes. Genießen Sie die traditionelle Küche auf der schattigen Terrasse."
    ],
    "en": [
      "Discover Le Central Bar in Villard-de-Lans, a charming brasserie in the heart of the village. Recently renovated, enjoy traditional cuisine on the shady terrace."
    ],
    "it": [
      "Scoprite il Bar Le Central di Villard-de-Lans, una brasserie ricca di fascino nel cuore del villaggio. Recentemente rinnovata, potrete gustare la cucina tradizionale sulla terrazza ombreggiata."
    ],
    "fr": [
      "Découvrez Le Central Bar à Villard-de-Lans, une brasserie pleine de charme au cœur du village. Récemment rénovée, savourez une cuisine traditionnelle en terrasse ombragée."
    ],
    "nl": [
      "Ontdek Le Central Bar in Villard-de-Lans, een brasserie vol charme in het hart van het dorp. Onlangs gerenoveerd, geniet van traditionele gerechten op het schaduwrijke terras."
    ],
    "es": [
      "Descubra Le Central Bar en Villard-de-Lans, una brasserie llena de encanto en el corazón del pueblo. Recientemente renovado, disfrute de la cocina tradicional en la terraza a la sombra."
    ]
  },
