  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen Zwischenstopp beim Yoga oder Pilates!\r\nVinyasa-Yoga-, Yin-Yoga- oder Pilates-Kurse am See im Sommer, im Saal oder in Ihrem Hotel/Unterkunft.\r\nBuchen Sie Ihren Kurs direkt online für einen Moment der Entspannung und Ressourcen."
    ],
    "en": [
      "Treat yourself to a Yoga or Pilates break!\r\nYoga Vinyasa, Yin Yoga or Pilates classes at the lake in summer, indoors or in your hotel / resort.\r\nBook your class directly online for a moment of rejuvenation and relaxation."
    ],
    "it": [
      "Concedetevi una pausa di Yoga o Pilates!\r\nCorsi di Vinyasa Yoga, Yin Yoga o Pilates al lago in estate, al chiuso o nel vostro hotel/resort.\r\nPrenotate la vostra lezione online per un momento di ringiovanimento e relax."
    ],
    "fr": [
      "Offrez-vous une escale Yoga ou Pilates ! \r\nCours de Yoga Vinyasa, Yin Yoga ou Pilates  au lac l'été, en salle ou dans votre hôtel / lieu de séjour.\r\nRéservez directement en ligne votre cours pour un moment ressource et détente."
    ],
    "es": [
      "¡Regálese una escapada de Yoga o Pilates!\r\nClases de Vinyasa Yoga, Yin Yoga o Pilates en el lago en verano, en interior o en su hotel/resort.\r\nReserve su clase en línea para disfrutar de un momento de rejuvenecimiento y relajación."
    ],
    "nl": [
      "Trakteer jezelf op een Yoga of Pilates break!\r\nVinyasa Yoga, Yin Yoga of Pilates lessen aan het meer in de zomer, binnen of in je hotel/resort.\r\nBoek je les online voor een moment van verjonging en ontspanning."
    ]
  },
