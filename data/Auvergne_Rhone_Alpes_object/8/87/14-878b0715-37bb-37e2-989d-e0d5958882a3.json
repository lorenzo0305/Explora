  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1c8bbf9e-59c7-30c7-a43c-e4de2a3502ce",
      "dc:description": {
        "de": [
          "Erzählter Spaziergang am Strand.\nKomm mit deinem Handtuch und lausche unseren Erzählern und Erzählerinnen, um in die Fantasie zu reisen.\n\nTreffpunkt vor dem Office de Tourisme in Wimereux\n\nDauer ca. 1 Stunde 30 Minuten"
        ],
        "en": [
          "Storytelling on the beach.\nBring your towel and listen to our storytellers as they take you on a journey of the imagination.\n\nMeet in front of the Wimereux Tourist Office\n\nDuration approx. 1 h 30"
        ],
        "it": [
          "Racconto sulla spiaggia.\nPortate il vostro asciugamano e ascoltate i nostri narratori che vi accompagneranno in un viaggio dell'immaginazione.\n\nAppuntamento davanti all'Ufficio del Turismo di Wimereux\n\nDurata circa 1 ora e 30"
        ],
        "fr": [
          "Balade contée sur la plage.\nViens avec ta serviette écouter nos conteurs et conteuses pour voyager dans l'imaginaire.\n\nRendez-vous devant l'Office de Tourisme de Wimereux \n\nDurée environ 1 h 30"
        ],
        "nl": [
          "Verhalen vertellen op het strand.\nNeem je handdoek mee en luister naar onze verhalenvertellers die je meenemen op een reis door de verbeelding.\n\nAfspraak aan de Toeristische Dienst van Wimereux\n\nDuur ongeveer 1 u 30"
        ],
        "es": [
          "Cuentacuentos en la playa.\nTrae tu toalla y escucha a nuestros cuentacuentos mientras te llevan en un viaje por la imaginación.\n\nEncuentro frente a la Oficina de Turismo de Wimereux\n\nDuración aprox. 1 h 30"
        ]
      },
      "@type": [
        "Description"
      ],
