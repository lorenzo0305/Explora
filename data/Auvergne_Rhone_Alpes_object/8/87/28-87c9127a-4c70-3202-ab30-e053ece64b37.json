  "rdfs:comment": {
    "de": [
      "Es ist der Tempel der Mode, des Luxus und der Schönheit! Eine Institution in Lille. Von den feinsten Dessous bis zu den größten Gepäckstücken, von der inspirierendsten Dekoration bis zur kreativsten Frisur - hier ist alles möglich!"
    ],
    "en": [
      "The temple of fashion, luxury and beauty! A Lille institution. From the finest lingerie to the finest luggage, from the most inspired decor to the most creative hairstyles, here everything is possible!"
    ],
    "it": [
      "Questo è il tempio della moda, del lusso e della bellezza! Un'istituzione di Lille. Dalla lingerie più raffinata alle valigie più belle, dall'arredamento più ispirato alle acconciature più creative, qui tutto è possibile!"
    ],
    "fr": [
      "C’est le temple de la mode, du luxe et de la beauté ! Une institution à Lille. De la lingerie la plus fine aux bagages les plus grands, de la déco la plus inspirée à la coiffure la plus créative, ici tout est possible !"
    ],
    "es": [
      "Es el templo de la moda, el lujo y la belleza Una institución en Lille. Desde la lencería más refinada hasta el equipaje más fino, pasando por la decoración más inspirada o los peinados más creativos, ¡aquí todo es posible!"
    ],
    "nl": [
      "Dit is de tempel van mode, luxe en schoonheid! Een instituut in Lille. Van de mooiste lingerie tot de fijnste bagage, van de meest geïnspireerde inrichting tot de meest creatieve kapsels, hier is alles mogelijk!"
    ]
  },
