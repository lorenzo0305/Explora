  "rdfs:comment": {
    "de": [
      "Eine Adresse, an der Sie regionale Spezialitäten aus Italien genießen können und die ein All-you-can-eat-Buffet anbietet. Eine große Terrasse, die bei schönem Wetter angenehm ist, erwartet Sie, damit Sie Ihre Antipasti in der Sonne genießen können!"
    ],
    "en": [
      "An address where you can taste regional specialities from Italy and offer an all-you-can-eat buffet. A large terrace, pleasant on sunny days, awaits you to enjoy antipasti in the sun!"
    ],
    "it": [
      "Un indirizzo dove si possono gustare specialità regionali italiane e un buffet a volontà. Un'ampia terrazza, piacevole per le giornate di sole, vi aspetta per gustare gli antipasti al sole!"
    ],
    "fr": [
      "Une adresse où déguster des spécialités régionales d'Italie et proposant un buffet à volonté. Une grande terrasse, agréable pour les beaux jours, vous attend pour déguster des antipasti au soleil !"
    ],
    "es": [
      "Una dirección en la que podrá disfrutar de las especialidades regionales italianas y de un buffet libre. Una gran terraza, agradable para los días soleados, le espera para disfrutar de los antipasti al sol"
    ],
    "nl": [
      "Een adres waar u kunt genieten van regionale Italiaanse specialiteiten en een all-you-can-eat buffet. Een groot terras, aangenaam voor zonnige dagen, wacht op u om te genieten van antipasti in de zon!"
    ]
  },
  "rdfs:label": {
