  "rdfs:comment": {
    "de": [
      "Sébastien Durlin ist ein Naturführer, der das ganze Jahr über Naturausflüge anbietet, bei denen Sie lernen, unsere Umwelt zu betrachten, zu hören und zu erkennen: Fauna, Flora, Insekten und Vögel haben kein Geheimnis für ihn."
    ],
    "en": [
      "Guided wildlife tours. Nordic walking and hiking instructor."
    ],
    "it": [
      "Sébastien Durlin è una guida naturalistica che propone durante tutto l'anno escursioni nella natura per imparare a guardare, ascoltare e riconoscere il nostro ambiente: fauna, flora, insetti e uccelli non hanno segreti per lui."
    ],
    "fr": [
      "Sébastien Durlin est un guide naturaliste qui propose tout au long de l'année des sorties nature pour apprendre à regarder, écouter et reconnaître notre environnement : faune, flore, insectes et oiseaux n'ont pas de secret pour lui."
    ],
    "nl": [
      "Sébastien Durlin is een natuurgids die het hele jaar door natuuruitstapjes aanbiedt om te leren kijken, luisteren en onze omgeving te herkennen: fauna, flora, insecten en vogels hebben voor hem geen geheimen."
    ],
    "es": [
      "Sébastien Durlin es un guía naturalista que ofrece salidas a la naturaleza durante todo el año para aprender a mirar, escuchar y reconocer nuestro entorno: la fauna, la flora, los insectos y las aves no tienen secretos para él."
    ]
  },
  "rdfs:label": {
