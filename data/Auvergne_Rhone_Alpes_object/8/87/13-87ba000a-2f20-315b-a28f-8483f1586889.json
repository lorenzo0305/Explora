  "rdfs:comment": {
    "de": [
      "Verleih von elektrischen und klassischen Mountainbikes, Tandems, Draisinen, Babytragen und Kinderanhängern - Täglich telefonischer Fahrrad-Pannendienst - Verkauf von Ersatzteilen - Shop für Zubehör und Sportbekleidung."
    ],
    "en": [
      "Rental of electric and classic mountain bikes, tandems, draisienne, baby carriers and children's trailers - Bicycle breakdown service by telephone every day - Sale of spare parts - Shop for accessories and sportswear."
    ],
    "it": [
      "Noleggio di mountain bike elettriche e classiche, tandem, draisienne, marsupi e rimorchi per bambini - Servizio di soccorso bici telefonico tutti i giorni - Vendita di ricambi - Negozio di accessori e abbigliamento sportivo."
    ],
    "fr": [
      "Location VTT électriques et classiques,  tandem, draisienne, porte bébé et remorque enfant - Service dépannage vélos tous les jours par téléphone - Vente de pièces détachés - Boutique accessoires et vêtement de sports."
    ],
    "nl": [
      "Verhuur van elektrische en klassieke mountainbikes, tandems, draisienne, bagagedragers en kinderkarren - Dagelijks telefonische pechverhelping - Verkoop van reserveonderdelen - Winkel met accessoires en sportkleding."
    ],
    "es": [
      "Alquiler de bicicletas de montaña eléctricas y clásicas, tándems, draisienne, portabebés y remolques para niños - Servicio de reparación de bicicletas por teléfono todos los días - Venta de piezas de recambio - Tienda de accesorios y ropa deportiva."
    ]
  },
