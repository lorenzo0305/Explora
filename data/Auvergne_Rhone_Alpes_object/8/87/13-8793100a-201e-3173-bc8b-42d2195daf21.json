  "rdfs:comment": {
    "de": [
      "Willkommen bei Agnes ORSI, die seit über 25 Jahren im Herzen des Dorfes BRULLIOLES, in der Nähe der Kirche und des Rathauses, ansässig ist. Dieses Restaurant bietet Ihnen eine traditionelle, hausgemachte Küche."
    ],
    "en": [
      "Welcome to Agnès ORSI's restaurant, established over 25 years ago in the heart of the village of BRULLIOLES, near the church and town hall. The restaurant offers traditional, home-cooked cuisine."
    ],
    "it": [
      "Benvenuti al ristorante di Agnès ORSI, aperto da oltre 25 anni nel cuore del villaggio di BRULLIOLES, vicino alla chiesa e al municipio. Questo ristorante offre una cucina tradizionale e casalinga."
    ],
    "fr": [
      "Bienvenue chez Agnès ORSI implanté depuis plus de 25 ans en plein cœur du village de BRULLIOLES, à proximité de l'église et de la mairie. Ce restaurant vous propose une cuisine traditionnelle faite maison."
    ],
    "nl": [
      "Welkom in het restaurant van Agnès ORSI, meer dan 25 jaar geleden opgericht in het hart van het dorp BRULLIOLES, vlakbij de kerk en het gemeentehuis. Dit restaurant biedt een traditionele, huisgemaakte keuken."
    ],
    "es": [
      "Bienvenido al restaurante de Agnès ORSI, establecido hace más de 25 años en el corazón del pueblo de BRULLIOLES, cerca de la iglesia y del ayuntamiento. Este restaurante ofrece una cocina tradicional y casera."
    ]
  },
