  "rdfs:comment": {
    "de": [
      "Durance, das in Grignan in der Terre de Provence gegründete Familienhaus, bietet raffinierte und lokale Duftprodukte für echte Wohlfühlmomente. Ihre Raumdüfte, Parfums für sich selbst und Naturkosmetik verschönern unseren Alltag."
    ],
    "en": [
      "Home fragrances, candles, perfumes, natural cosmetics... Discover how we produce our products. \r\nCollection and new products at advantageous prices (15% off)."
    ],
    "it": [
      "Durance, azienda familiare fondata a Grignan nella Terra di Provenza, offre prodotti profumati raffinati e locali per veri momenti di benessere. Le sue fragranze, i profumi per la casa e i cosmetici naturali impreziosiscono la nostra vita quotidiana."
    ],
    "fr": [
      "Durance, Maison de Famille fondée à Grignan en Terre de Provence, offre des produits parfumés raffinés et locaux pour de véritables moments de bien-être. Ses parfums d’intérieur, parfums pour soi et cosmétiques naturels embellissent notre quotidien."
    ],
    "nl": [
      "Parfums voor binnen, kaarsen, parfums voor uzelf en natuurlijke cosmetische producten. Ontdek de vervaardiging van onze producten en beleef een ervaring in het rijlkdom van de parfum! Kom en ontdek alle onze collecties en nieuwigheden met een aantrekkelijke korting (15%)."
    ],
    "es": [
      "Durance, empresa familiar fundada en Grignan, en el País de la Provenza, ofrece productos perfumados refinados y locales para verdaderos momentos de bienestar. Sus fragancias para el hogar, sus perfumes para el hogar y sus cosméticos naturales embellecen nuestra vida cotidiana."
    ]
  },
