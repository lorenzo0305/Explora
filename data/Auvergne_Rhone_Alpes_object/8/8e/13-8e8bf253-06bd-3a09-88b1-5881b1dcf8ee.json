  "rdfs:comment": {
    "de": [
      "Kunstschmiedearbeiten. Das Feuer der Schmiede begleitet das Auge und die Hand, um einzigartige Stücke, reine und leichte Linien zu schaffen: Treppen, Geländer, Gartenlauben, Möbel."
    ],
    "en": [
      "Art metalwork. The fire of the forge accompanies the eye and the hand to create unique pieces, pure and light lines: stairs, railings, arbors, furniture."
    ],
    "it": [
      "Il fuoco della fucina accompagna l'occhio e la mano per creare pezzi unici dalle linee pure e leggere: scale, ringhiere, pergole e mobili."
    ],
    "fr": [
      "Le feu de la forge accompagne l’œil et la main pour mettre en œuvre des pièces uniques, des lignes pures et légères: escaliers, gardes-corps, tonnelles, mobiliers."
    ],
    "nl": [
      "Smeedijzerwerk. Het vuur van de smederij begeleidt het oog en de hand om unieke stukken te creëren met pure, lichte lijnen: trappen, leuningen, priëlen en meubels."
    ],
    "es": [
      "El fuego de la forja acompaña al ojo y a la mano para crear piezas únicas de líneas puras y ligeras: escaleras, barandillas, cenadores y muebles."
    ]
  },
  "rdfs:label": {
