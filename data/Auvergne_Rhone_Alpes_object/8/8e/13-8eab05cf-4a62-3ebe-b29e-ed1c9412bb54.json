  "rdfs:comment": {
    "de": [
      "In der Ebene von Pratz gelegen, ist der Pumptrack für Skateboarder, Roller, Fahrradfahrer oder Roller-Skater geeignet."
    ],
    "en": [
      "Located in the plain of Pratz, the circuit of Pumptrack is for skateboarding enthusiasts, scooter, bike or fans of roller skating."
    ],
    "it": [
      "Il nostro Pump Track è composto da due aree distinte: una dotata di pista verde di 50 m per i principianti, l’altra di una pista blu e una rossa di 200 m per i più esperti. Accesso libero in bicicletta, rollerblade, skateboard e monopattino."
    ],
    "fr": [
      "Situé dans la plaine des Pratz, le circuit de Pumptrack s’adresse aux amateurs de skateboard, trottinette, vélo ou encore aux férus du roller."
    ],
    "es": [
      "Situado en la llanura de Pratz, el circuito de Pumptrack está destinado a los amantes del monopatín, el patinete, la bicicleta y el patín."
    ],
    "nl": [
      "Het Pumptrack circuit ligt op de Pratz-vlakte en is bedoeld voor liefhebbers van skateboard, step, fiets en skeeleren."
    ]
  },
