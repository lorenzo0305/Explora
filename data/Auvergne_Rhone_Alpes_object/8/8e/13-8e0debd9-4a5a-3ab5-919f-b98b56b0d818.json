  "rdfs:comment": {
    "de": [
      "Kommen Sie sich während Ihrem Geschäfts- oder Freizeitaufenthalt in der Bar der großen Weine in einer geselligen Atmosphäre stärken."
    ],
    "en": [
      "During your business or leisure trip, come along and enjoy a meal in its bar with its superb wine collection and friendly atmosphere."
    ],
    "it": [
      "Durante il tuo soggiorno di lavoro o di piacere vieni a ristorarti nell'allegra atmosfera del suo wine bar."
    ],
    "fr": [
      "Pendant votre séjour d’affaires ou de loisir, venez vous restaurer dans ce bar à grands vins dans une ambiance conviviale."
    ],
    "nl": [
      "Kom tijdens uw zaken- of vakantieverblijf genieten van een maaltijd in deze fijne wijnbar in een gezellige sfeer."
    ],
    "es": [
      "En este bar de vinos se respira buen ambiente, perfecto para disfrutar un rato durante una estancia en la ciudad de negocios o de ocio."
    ]
