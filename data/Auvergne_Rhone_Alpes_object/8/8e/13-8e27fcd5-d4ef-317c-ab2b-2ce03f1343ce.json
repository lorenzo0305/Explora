  "rdfs:comment": {
    "de": [
      "Die Auvergne verdichtet eine reiche vulkanische Geschichte mit mehreren Millionen Jahren aufeinanderfolgender Eruptionen, von denen die außergewöhnliche Vielfalt der Reliefs zeugt."
    ],
    "en": [
      "The Auvergne region has a rich volcanic history spanning millions of years of successive eruptions, as witnessed by the exceptional diversity of its relief."
    ],
    "it": [
      "L'Alvernia ha una ricca storia vulcanica, con milioni di anni di eruzioni successive, come dimostra l'eccezionale diversità dei suoi rilievi."
    ],
    "fr": [
      "L'Auvergne condense une histoire volcanique riche de plusieurs millions d'années d'éruptions successives dont témoigne l'exceptionnelle diversité des reliefs."
    ],
    "nl": [
      "De Auvergne heeft een rijke vulkanische geschiedenis, met miljoenen jaren van opeenvolgende uitbarstingen, zoals blijkt uit de uitzonderlijke diversiteit van het reliëf."
    ],
    "es": [
      "Auvernia posee una rica historia volcánica, con millones de años de erupciones sucesivas, como demuestra la excepcional diversidad de su relieve."
    ]
  },
  "rdfs:label": {
    "fr": [
