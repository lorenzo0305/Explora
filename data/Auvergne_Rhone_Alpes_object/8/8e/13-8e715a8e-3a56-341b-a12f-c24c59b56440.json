  "rdfs:comment": {
    "de": [
      "Die Kirche St. Laurent de La Côte wurde von 102 bis 1714 im Barockstil erbaut und zeichnet sich durch ein nüchternes Äußeres und ein wunderschönes Altarbild im Chor aus."
    ],
    "en": [
      "Built between 102 and 1714, the church of St Laurent de La Côte is baroque in style, with a sober exterior and a magnificent altarpiece in the choir."
    ],
    "it": [
      "Costruita tra il 102 e il 1714, la chiesa di St Laurent de La Côte è in stile barocco, con un esterno sobrio e una magnifica pala d'altare nel coro."
    ],
    "fr": [
      "Edifiée de 102 à 1714, l'église de St Laurent de La Côte est de style baroque caractérisé par un aspect sobre à l'extérieur et un magnifique retable dans son choeur."
    ],
    "nl": [
      "De kerk van St Laurent de La Côte werd gebouwd tussen 102 en 1714 en heeft een barokke stijl, een sobere buitenkant en een prachtig altaarstuk in het koor."
    ],
    "es": [
      "Construida entre 102 y 1714, la iglesia de San Lorenzo de la Costa es de estilo barroco, con un exterior sobrio y un magnífico retablo en su coro."
    ]
  },
