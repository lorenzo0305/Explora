  "rdfs:comment": {
    "de": [
      "Eine große Runde auf den Wegen der Bresse mit typischen Landschaften dieses Landes mit seinen landwirtschaftlichen Gütern, seinen Bauernhöfen mit Fachwerkhäusern, seinen Viehzuchtbetrieben (Geflügel, Büffel, Ziegen, Milchkühe...). Eine Schüssel Landleben, ein bisschen Sport, aber vor allem Spaß."
    ],
    "en": [
      "A grand tour of the Bresse countryside, with its typical agricultural estates, timber-framed farms and livestock (poultry, bison, goats, dairy cows, etc.). A bowl of countryside, a bit of sport, but above all, a lot of fun."
    ],
    "it": [
      "Un grande tour della campagna bresciana, con le sue tipiche tenute agricole, le fattorie a graticcio e il bestiame (pollame, bisonti, capre, mucche da latte, ecc.). Una ciotola di campagna, un tocco di sport ma soprattutto di piacere."
    ],
    "fr": [
      "Grand tour des chemins bressans avec des paysages typiques de cette terre avec ses domaines agricoles, ses fermes à pans de bois, ses élevages (volailles, bisons, chèvres, vaches laitières..). Un bol de campagne , un brin de sport mais surtout du plaisir."
    ],
    "es": [
      "Un gran recorrido por la campiña de Bresse, con sus típicas fincas agrícolas, sus granjas con entramado de madera y su ganadería (aves de corral, bisontes, cabras, vacas lecheras, etc.). Un tazón de campo, un toque de deporte pero sobre todo de placer."
    ],
    "nl": [
      "Een grootse tocht door het platteland van Bresse, met zijn typische landbouwbedrijven, vakwerkboerderijen en vee (pluimvee, bizons, geiten, melkkoeien, enz.). Een kom platteland, een vleugje sport maar vooral plezier."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit Gravel n°26 (black) - Tour de St Didier d'Aussiat"
    ],
    "fr": [
      "Circuit Gravel n°26 (noir) - Tour de St Didier d'Aussiat"
    ]
  },
