  "rdfs:comment": {
    "de": [
      "Unser ideal im Zentrum des Dorfes Poncin gelegenes Hotel empfängt Sie in einem modernen und gemütlichen Rahmen.\r\nEs besteht die Möglichkeit, abends zu essen."
    ],
    "en": [
      "Situated in the heart of Poncin, an old medieval village, discover a traditional cooking. \r\nPizza area to eat in or take out."
    ],
    "it": [
      "Il nostro hotel, situato in posizione ideale nel centro del villaggio di Poncin, vi accoglie in un ambiente caldo e moderno.\r\nPossibilità di mangiare la sera."
    ],
    "fr": [
      "Notre hôtel idéalement situé au centre du village de Poncin, vous accueille dans un cadre moderne et chaleureux.\r\nPossibilité de repas en soirée."
    ],
    "nl": [
      "Ons hotel, ideaal gelegen in het centrum van het dorp Poncin, verwelkomt je in een warme en moderne omgeving.\r\nAvondmaaltijden beschikbaar."
    ],
    "es": [
      "Nuestro hotel, idealmente situado en el centro del pueblo de Poncin, le da la bienvenida en un ambiente cálido y moderno.\r\nCenas disponibles."
    ]
  },
