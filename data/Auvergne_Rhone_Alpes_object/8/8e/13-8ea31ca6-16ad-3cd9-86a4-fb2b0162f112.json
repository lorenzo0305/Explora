  "rdfs:comment": {
    "de": [
      "Von La Voulte sur Rhône nach Dunières, die meterspurige Eisenbahn in der Ardèche und Haute-Loire. Rückblick auf ein gewaltiges Abenteuer dank der Association du Patrimoine Vivarais-Lignon."
    ],
    "en": [
      "From La Voulte sur Rhône to Dunières, the metre-gauge railroad in Ardèche and Haute-Loire. The Vivarais-Lignon Heritage Association looks back on a wonderful adventure."
    ],
    "it": [
      "Da La Voulte sur Rhône a Dunières, la ferrovia a scartamento ridotto dell'Ardèche e dell'Alta Loira. Ripercorriamo una splendida avventura grazie all'Associazione del Patrimonio Vivarais-Lignon."
    ],
    "fr": [
      "De La Voulte sur Rhône à Dunières, le chemin de fer à voie métrique en Ardèche et Haute-Loire. Retour sur une formidable aventure grâce à l'association du Patrimoine Vivarais-Lignon."
    ],
    "nl": [
      "Van La Voulte sur Rhône naar Dunières, de meterspoorlijn in de Ardèche en Haute-Loire. Een terugblik op een prachtig avontuur dankzij de Vivarais-Lignon Heritage Association."
    ],
    "es": [
      "De La Voulte sur Rhône a Dunières, el ferrocarril de vía métrica de Ardèche y Alto Loira. Una mirada retrospectiva a una aventura maravillosa gracias a la Asociación del Patrimonio Vivarais-Lignon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ligne CFD"
    ]
  },
