  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt Belledonne Chartreuse ist ein Gemeinschaftsbüro, dessen Aufgabe es ist, den Tourismus und Veranstaltungen im Belledonne-Massiv zu fördern."
    ],
    "en": [
      "The Belledonne Chartreuse Tourist Office is a community office whose mission is to promote tourism and events in the Belledonne massif."
    ],
    "it": [
