  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich in einer wunderschönen Umgebung, die an den Fuß der Kathedrale angebaut ist, und ist ein Ort, der den kulinarischen und sommelierischen Flaniermeilen gewidmet ist."
    ],
    "en": [
      "The restaurant, located in a magnificent setting at the foot of the cathedral, is a place dedicated to culinary and sommelier strolls."
    ],
    "it": [
      "Il ristorante, situato in una magnifica cornice ai piedi della cattedrale, è un luogo dedicato alle passeggiate culinarie e ai sommelier."
    ],
    "fr": [
      "Le restaurant, situé dans un cadre magnifique accolé au pied de la cathédrale, est un lieu dédié aux flâneries culinaires et sommelières."
    ],
    "nl": [
      "Het restaurant, gelegen in een prachtige omgeving aan de voet van de kathedraal, is een plek gewijd aan culinaire en sommelierwandelingen."
    ],
    "es": [
      "El restaurante, situado en un magnífico marco a los pies de la catedral, es un lugar dedicado a los paseos culinarios y sumilleres."
    ]
