  "rdfs:comment": {
    "de": [
      "Das Galerie-Atelier du Losange bietet jeden Monat Ausstellungen mit Malerei, Skulptur, Fotografie, Zeichnung und Installationen. Seit 26 Jahren erwecken lokale und internationale Künstler diesen Ausstellungsraum zum Leben!\nIn der Werkstatt bildende Kunstkurse."
    ],
    "en": [
      "The Galerie-Atelier du Losange offers exhibitions of painting, sculpture, photography, drawing and installations every month. Local and international artists have been bringing this exhibition space to life for 26 years!\nAt the Workshop, plastic arts classes."
    ],
    "it": [
      "La Galerie-Atelier du Losange propone ogni mese mostre di pittura, scultura, fotografia, disegno e installazioni. Artisti locali e internazionali danno vita a questo spazio espositivo da 26 anni!\nAl Laboratorio, lezioni di arti plastiche."
    ],
    "fr": [
      "La Galerie-Atelier du Losange propose des expositions de peinture, sculpture, photo, dessin et installations tous les mois. Des artiste locaux et internationaux font vivre ce lieu d'exposition depuis 26 ans !\nA l'Atelier, de cours d'art plastiques."
    ],
    "es": [
      "En cuanto a la galería, Losange ofrece arte contemporáneo, art brut y exposiciones diferentes cada mes. Desde hace 20 años, artistas internacionales se dan cita en sus paredes para dar vida a este espacio expositivo."
    ],
    "nl": [
      "De Galerie-Atelier du Losange houdt maandelijks tentoonstellingen van schilderkunst, beeldhouwkunst, fotografie, tekeningen en installaties. Lokale en internationale kunstenaars brengen deze expositieruimte al 26 jaar tot leven!\nKunstlessen in het Atelier."
    ]
  },
