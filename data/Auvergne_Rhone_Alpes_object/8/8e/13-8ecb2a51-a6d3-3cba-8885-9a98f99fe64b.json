  "rdfs:comment": {
    "de": [
      "Vögel der Welt, wilde Vögel? ein einzigartiges Konzept, das es zu entdecken gilt. Entdecken Sie auf dieser Busreise ab Saint-Jean-de Maurienne die schönsten Vögel und Landschaften der 5 Kontinente."
    ],
    "en": [
      "Birds of the world, wild birds... a unique concept to discover. Embark on a world tour to discover the most beautiful birds and landscapes of 5 continents on this coach excursion departing from Saint-Jean-de Maurienne."
    ],
    "it": [
      "Uccelli del mondo, uccelli selvatici? Un concetto unico da scoprire. Partite per un giro del mondo alla scoperta degli uccelli e dei paesaggi più belli dei 5 continenti in questa escursione in pullman con partenza da Saint-Jean-de Maurienne."
    ],
    "fr": [
      "Oiseaux du monde, oiseaux sauvages… un concept unique à découvrir. Embarquez pour un tour du monde à la découverte des plus beaux oiseaux et paysages des 5 continents à l'occasion de cette excursion en car au départ de Saint-Jean-de Maurienne."
    ],
    "nl": [
      "Vogels van de wereld, wilde vogels? een uniek concept om te ontdekken. Ga op wereldreis en ontdek de mooiste vogels en landschappen van de 5 continenten tijdens deze excursie per bus vanuit Saint-Jean-de Maurienne."
    ],
    "es": [
      "Aves del mundo, aves salvajes... un concepto único por descubrir. Embárquese en una vuelta al mundo para descubrir las aves y los paisajes más bellos de los 5 continentes en esta excursión en autocar con salida de Saint-Jean-de Maurienne."
    ]
  },
  "rdfs:label": {
    "en": [
      "Excursion - Bird Park"
    ],
    "fr": [
      "Excursion - Parc des oiseaux"
    ]
  },
