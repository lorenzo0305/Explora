  "rdfs:comment": {
    "de": [
      "Isabel zu Ihren Diensten auf der Domaine du Château des Gipières\r\n\r\nIch verwalte 30 Wohnungen und Studios, die Sie für Ihren Urlaub in Montbrun les Bains am Fuße des Mont Ventoux in der Provence, Südfrankreich, mieten können."
    ],
    "en": [
      "Isabel at your service at Domaine du Château des Gipières\r\n\r\nI manage 30 apartments and studios to rent for your vacations in Montbrun les Bains, at the foot of Mont Ventoux in Provence, south of France."
    ],
    "it": [
      "Isabel al vostro servizio presso il Domaine du Château des Gipières\r\n\r\nGestisco 30 appartamenti e monolocali in affitto per le vostre vacanze a Montbrun les Bains, ai piedi del Mont Ventoux in Provenza, nel sud della Francia."
    ],
    "fr": [
      "Isabel à votre service au Domaine du château des Gipières \r\n\r\nJe gère 30 appartements et studios à louer pour vos vacances à Montbrun les Bains, au pied du Mont Ventoux en Provence, sud de la France."
    ],
    "nl": [
      "Isabel tot uw dienst op het Domaine du Château des Gipières\r\n\r\nIk beheer 30 appartementen en studio's te huur voor uw vakantie in Montbrun les Bains, aan de voet van de Mont Ventoux in de Provence, Zuid-Frankrijk."
    ],
    "es": [
      "Isabel a su servicio en el Domaine du Château des Gipières\r\n\r\nGestiono 30 pisos y estudios en alquiler para sus vacaciones en Montbrun les Bains, al pie del Mont Ventoux en Provenza, sur de Francia."
    ]
  },
