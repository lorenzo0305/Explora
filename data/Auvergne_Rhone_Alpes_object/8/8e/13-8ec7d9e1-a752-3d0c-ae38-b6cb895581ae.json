  "rdfs:comment": {
    "de": [
      "Bergrestaurant in der Nähe der Bergstation der Seilbahn Fierney in Crozet, schöne Atmosphäre in einem Ambiente mit Blick auf das Pays de Gex und einen Blick auf den Mont Blanc."
    ],
    "en": [
      "High-altitude restaurant located near the upper station of the Fierney cable car in Crozet, with a lovely atmosphere in a setting overlooking the Pays de Gex, with a nod to Mont Blanc."
    ],
    "it": [
      "Questo ristorante d'alta quota si trova vicino alla stazione a monte della funivia del Fierney, a Crozet, e offre un'atmosfera piacevole in un ambiente che si affaccia sul Pays de Gex, con un accenno al Monte Bianco."
    ],
    "fr": [
      "Restaurant d'altitude situé à proximité de la gare supérieure de la télécabine du Fierney à Crozet, belle ambiance dans un décor qui surplombe le Pays de de Gex, fait un clin d'œil au Mont Blanc."
    ],
    "nl": [
      "Dit restaurant op grote hoogte ligt vlakbij het bergstation van de kabelbaan Fierney in Crozet. Het heeft een heerlijke sfeer in een omgeving met uitzicht op het Pays de Gex, met een knipoog naar de Mont Blanc."
    ],
    "es": [
      "Cerca de la estación superior del teleférico de Fierney, en Crozet, se encuentra este restaurante de altura, con un ambiente agradable y vistas al Pays de Gex, con un guiño al Mont Blanc."
    ]
  },
