  "rdfs:comment": {
    "de": [
      "Das Schwimmbad in Séderon ist ein beheiztes Freibad, das während der Sommersaison geöffnet ist.\r\nEs ist mit einem schönen Schwimmbecken und einer Sonnenterrasse ausgestattet.\r\nDort werden vom Bademeister Schwimm- und Wassergymnastikkurse angeboten."
    ],
    "en": [
      "The swimming pool of Séderon is an outdoor heated pool, open during the summer period. It consists of a nice pool and a solarium.\r\nThe lifeguard offers swimming couses and aqua-gym."
    ],
    "it": [
      "La piscina di Séderon è una piscina all'aperto riscaldata, aperta durante la stagione estiva.\r\nÈ dotato di una bella piscina e di un solarium.\r\nIl bagnino offre lezioni di nuoto e acquagym."
    ],
    "fr": [
      "La piscine à Séderon est une piscine de plein air chauffée, ouverte pendant la saison estivale.\r\nElle est équipée d'un beau bassin et d'un solarium.\r\nDes cours de natation et d'aquagym y sont proposés par le maître nageur."
    ],
    "es": [
      "La piscina de Séderon es una piscina exterior climatizada, abierta durante la temporada de verano.\r\nEstá equipado con una hermosa piscina y un solárium.\r\nEl socorrista ofrece clases de natación y gimnasia acuática."
    ],
    "nl": [
      "Het zwembad in Séderon is een verwarmd buitenzwembad, geopend tijdens het zomerseizoen.\r\nHet is uitgerust met een prachtig zwembad en een solarium.\r\nZwem- en aquagymlessen worden aangeboden door de badmeester."
    ]
  },
  "rdfs:label": {
    "en": [
      "Municipal swimming pool"
    ],
    "fr": [
      "Piscine Municipale"
    ],
    "nl": [
      "Gemeentelijk zwembad"
    ]
  },
