  "rdfs:comment": {
    "de": [
      "18-Loch-Minigolfplatz im Herzen des kleinen Dorfes La Chapelle sur Coise. Dauer: ca. 2 Stunden. Originelle Hindernisse, der Schwierigkeitsgrad nimmt im Laufe des Parcours zu. Der Platz ist sehr schattig. Auf Reservierung für Gruppen ab 15 Personen. Ab 4 Jahren."
    ],
    "en": [
      "18-hole miniature obstacle golf course in the heart of the small village of La-Chapelle-sur-Coise. The course takes about 2 hours to complete."
    ],
    "it": [
      "Un campo da minigolf a 18 buche nel cuore del piccolo villaggio di La Chapelle sur Coise. Durata: circa 2 ore. Ostacoli originali di difficoltà crescente lungo il percorso. Sito molto ombreggiato. Prenotazione obbligatoria per gruppi di almeno 15 persone. Per bambini a partire dai 4 anni."
    ],
    "fr": [
      "Parcours de mini-golf de 18 trous , au cœur du petit village de La Chapelle sur Coise. Durée : environ 2h. Obstacles originaux, difficulté croissante au fil du parcours. Site très ombrager. Sur réservation pour les groupes + 15 personnes. Dès 4 ans."
    ],
    "es": [
      "Un minigolf de 18 hoyos en el corazón del pequeño pueblo de La Chapelle sur Coise. Duración: 2 horas aproximadamente. Originales obstáculos de dificultad creciente a lo largo del recorrido. Terreno muy sombreado. Reserva obligatoria para grupos a partir de 15 personas. Para niños a partir de 4 años."
    ],
    "nl": [
      "Een midgetgolfbaan met 18 holes in het hart van het kleine dorpje La Chapelle sur Coise. Duur: ongeveer 2 uur. Originele hindernissen met stijgende moeilijkheidsgraad langs het parcours. Zeer schaduwrijk terrein. Reserveren verplicht voor groepen vanaf 15 personen. Voor kinderen vanaf 4 jaar."
    ]
  },
  "rdfs:label": {
