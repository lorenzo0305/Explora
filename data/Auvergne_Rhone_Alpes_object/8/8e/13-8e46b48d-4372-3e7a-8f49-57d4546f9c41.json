  "rdfs:comment": {
    "de": [
      "Die Auberge des Montagnes in Pailherols empfängt Sie in einer traditionellen und herzlichen Atmosphäre. Hier entdecken Sie eine qualitativ hochwertige, kreative und von der Region inspirierte Küche."
    ],
    "en": [
      "The Auberge des Montagnes in Pailherols welcomes you in a warm, traditional atmosphere. You'll discover quality, creative cuisine inspired by local produce."
    ],
    "it": [
      "L'Auberge des Montagnes di Pailherols vi accoglie in un'atmosfera tradizionale e calorosa. Scoprirete una cucina di qualità, creativa e ispirata alla terra."
    ],
    "fr": [
      "L’Auberge des Montagnes à Pailherols vous accueille dans une ambiance traditionnelle et chaleureuse. Vous y découvrirez une cuisine de qualité, créative et inspirée du terroir."
    ],
    "es": [
      "El Auberge des Montagnes de Pailherols le ofrece una acogida cálida y tradicional. Descubrirá una cocina creativa y de calidad inspirada en los productos locales."
    ],
    "nl": [
      "De Auberge des Montagnes in Pailherols ontvangt u in een traditionele en warme sfeer. U zult een kwaliteitskeuken ontdekken, creatief en geïnspireerd door het land."
    ]
  },
