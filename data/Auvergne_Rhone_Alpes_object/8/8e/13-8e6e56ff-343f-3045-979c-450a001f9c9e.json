  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von seiner semi-gastronomischen Küche verzaubern (nur in der Nebensaison).\r\nEr bietet Ihnen das Tagesmenü und eine Mittagskarte.\r\nVon Juni bis September Cocktails, Eisbecher am Nachmittag."
    ],
    "en": [
      "Let yourself be enchanted by its semi-gastronomic cuisine. The restaurant offers a menu of the day and an à la carte menu at lunchtime. From June to September, cocktails and ice creams in the afternoon.\r\nOpen daily for lunch and dinner from June to September, closed on Mondays from September to May.\r\nThe honey comes from St-Martin de Valamas, the goat's cheese from Jaunac and the ceps from St-Julien-Boutières."
    ],
    "it": [
      "Lasciatevi incantare dalla sua cucina semi-gastronomica (solo fuori stagione).\r\nIl ristorante propone un menu del giorno e un menu à la carte a pranzo.\r\nDa giugno a settembre, cocktail e gelati nel pomeriggio."
    ],
    "fr": [
      "Laissez-vous envoûter par sa cuisine semi-gastronomique (seulement en hors-saison). \r\nIl vous propose le menu du jour et une carte à midi. \r\nDe juin à septembre, cocktails, coupes de glaces l'après-midi."
    ],
    "nl": [
      "Laat je betoveren door de semi-gastronomische keuken (alleen buiten het seizoen).\r\nHet restaurant biedt een dagmenu en 's middags een à la carte menu.\r\nVan juni tot september 's middags cocktails en ijsjes."
    ],
    "es": [
      "Déjese seducir por su cocina semigastronómica (sólo fuera de temporada).\r\nEl restaurante ofrece un menú del día y un menú a la carta al mediodía.\r\nDe junio a septiembre, cócteles y helados por la tarde."
    ]
  },
