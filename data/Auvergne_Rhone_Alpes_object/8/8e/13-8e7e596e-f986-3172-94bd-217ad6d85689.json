  "rdfs:comment": {
    "de": [
      "Mit der ganzen Familie können Sie sich in luftiger Höhe vergnügen, mitten im Wald auf der Domaine Pertuyzat-Pavin!"
    ],
    "en": [
      "Bring the whole family to the Domaine Pertuyzat-Pavin, where you can enjoy a bit of height and fun in the middle of the forest!"
    ],
    "it": [
      "Portate tutta la famiglia e godetevi un po' di altezza in mezzo alla foresta al Domaine Pertuyzat-Pavin!"
    ],
    "fr": [
      "En famille, venez vous amuser en prenant un peu de hauteur, en pleine forêt au Domaine Pertuyzat-Pavin !"
    ],
    "es": [
      "Traiga a toda la familia y disfrute de un poco de altura en pleno bosque en el Domaine Pertuyzat-Pavin"
    ],
    "nl": [
      "Neem het hele gezin mee en geniet van een beetje hoogte midden in het bos op Domaine Pertuyzat-Pavin!"
    ]
  },
  "rdfs:label": {
