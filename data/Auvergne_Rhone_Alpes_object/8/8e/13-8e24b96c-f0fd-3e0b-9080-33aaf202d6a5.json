  "rdfs:comment": {
    "de": [
      "In der Halle aux Grains finden folgende Veranstaltungen statt: Aufführungen der städtischen Kultursaison, von Vereinen veranstaltete Konzerte, Galas und Festivals, Jahresabschlussveranstaltungen, Konferenzen und Kolloquien, Gastspiele von Ensembles"
    ],
    "en": [
      "The Halle aux Grains, hosts: the shows of the Cultural Season of the City, concerts proposed by associations, galas and festivals, end of year shows, conferences and symposiums, the reception of company in residence"
    ],
    "it": [
      "La Halle aux Grains ospita: gli spettacoli della Stagione Culturale della Città, i concerti proposti dalle associazioni, le serate di gala e i festival, gli spettacoli di fine anno, le conferenze e i simposi, le residenze delle compagnie"
    ],
    "fr": [
      "La Halle aux Grains, accueille : les spectacles de la Saison Culturelle de la Ville ,  les concerts proposés par les associations , les galas et festivals, les spectacles de fin d'année,  les conférences et colloques, l'accueil de compagnie en résidence"
    ],
    "es": [
      "La Halle aux Grains acoge: los espectáculos de la Temporada Cultural de la Ciudad, los conciertos propuestos por las asociaciones, las galas y festivales, los espectáculos de fin de año, las conferencias y coloquios, las residencias de empresas"
    ],
    "nl": [
      "De Halle aux Grains herbergt: de voorstellingen van het Cultureel Seizoen van de Stad, concerten voorgesteld door verenigingen, gala's en festivals, eindejaarsvoorstellingen, conferenties en symposia, bedrijfsresidenties"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Halle aux Grains - Salle de spectacle -"
    ]
  },
