  "rdfs:comment": {
    "de": [
      "Reiten und Ponyreiten mit dem Poney Club des Rapeaux aus Saint-Martin-d'Uriage, der sein Sommerquartier in Chamrousse 1600 - Plateau de l'Arselle aufschlägt.\r\nVon Anfang Juli bis Mitte September können Sie hier schöne Ausritte in die Berge inmitten der Natur genießen."
    ],
    "en": [
      "Horseback riding and pony trekking by the Poney Club des Rapeaux de Saint-Martin-d'Uriage, which has set up summer quarters at Chamrousse 1600 - Plateau de l'Arselle.\r\nFrom early July to mid-September, come and enjoy lovely mountain rides in a natural setting."
    ],
    "it": [
      "Passeggiate a cavallo e su pony organizzate dal Poney Club des Rapeaux de St-Martin-d'Uriage, con sede a Chamrousse 1600 - Plateau de l'Arselle.\r\nDall'inizio di luglio a metà settembre, venite a fare delle belle passeggiate in montagna in un ambiente naturale."
    ],
    "fr": [
      "Balade en cheval et poney par le Poney Club des Rapeaux de St-Martin-d'Uriage qui établit ses quartiers d'été à Chamrousse 1600 - Plateau de l'Arselle.\r\nDe début juillet à mi-septembre venez profiter de jolies balades à la montagne dans un écrin de nature."
    ],
    "es": [
      "Paseos a caballo y en poni organizados por el Poney Club des Rapeaux de St-Martin-d'Uriage, con sede en Chamrousse 1600 - Plateau de l'Arselle.\r\nDesde principios de julio hasta mediados de septiembre, disfrute de agradables paseos por la montaña en un entorno natural."
    ],
    "nl": [
      "Paarden- en ponyritten georganiseerd door de Poney Club des Rapeaux de St-Martin-d'Uriage, gevestigd in Chamrousse 1600 - Plateau de l'Arselle.\r\nKom van begin juli tot half september genieten van prachtige bergritten in een natuurlijke omgeving."
    ]
  },
  "rdfs:label": {
    "de": [
      "GESCHLOSSEN SOMMER 2025 - Reiten und Ponyreiten in Chamrousse"
    ],
    "en": [
      "CLOSED SUMMER 2025 - Horseback riding and pony trekking in Chamrousse"
    ],
    "fr": [
      "FERMÉ ÉTÉ 2025 - Equitation et poney à Chamrousse"
    ]
  },
