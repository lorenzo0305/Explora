  "rdfs:comment": {
    "de": [
      "Abseits der ausgetretenen Pfade, inmitten der unberührten Natur des Bauges-Massivs. Ein Gourmetrestaurant, das in einer reichen und vielfältigen Region verwurzelt ist.\r\nLokale und saisonale Produkte mit einem Hauch von Anderswo. Unser Küchenchefpaar wird Sie auf eine Reise mitnehmen"
    ],
    "en": [
      "Far off the beaten track, in the heart of the unspoilt environment of the Massif des Bauges. A gourmet restaurant rooted in a rich and varied terroir.\r\nLocal, seasonal produce, with a touch of elsewhere. Our two Chefs will take you on a voyage of discovery"
    ],
    "it": [
      "Lontano dai sentieri battuti, nel cuore dell'ambiente incontaminato del massiccio dei Bauges. Un ristorante gastronomico che affonda le sue radici in un terroir ricco e variegato.\r\nProdotti locali e di stagione, con un tocco di altrove. I nostri due chef vi accompagneranno in un viaggio di scoperta"
    ],
    "fr": [
      "Loin des sentiers battus, au cœur de l'environnement préservé du massif des Bauges. Un restaurant gastronomique, ancré dans un terroir riche et varié.\r\nDes produits locaux, de saison, des touches d'ailleurs. Notre couple de Chefs saura vous faire voyager"
    ],
    "nl": [
      "Weg van de gebaande paden, in het hart van de ongerepte omgeving van het Bauges-massief. Een gastronomisch restaurant geworteld in een rijk en gevarieerd terroir.\r\nLokale, seizoensgebonden producten, met een vleugje van elders. Onze twee chef-koks nemen u mee op ontdekkingsreis"
    ],
    "es": [
      "Lejos de los caminos trillados, en el corazón del entorno virgen del macizo de Bauges. Un restaurante gastronómico arraigado en un terruño rico y variado.\r\nProductos locales, de temporada, con un toque de otros lugares. Nuestros dos Chefs le acompañarán en un viaje de descubrimiento"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant de l'Auberge d'Aillon et d'Ailleurs"
    ]
  },
