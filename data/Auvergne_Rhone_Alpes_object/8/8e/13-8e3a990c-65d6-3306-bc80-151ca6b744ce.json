  "rdfs:comment": {
    "de": [
      "Wir verkaufen unsere Produktion direkt ab Hof in Lans en Vercors: Bleu du Vercors-Sassenage AOP, St Marcellin IGP, Quark und Raclette-Käse.\r\nSie können sich unsere Kuhherde ansehen und von 17.00 bis 18.00 Uhr beim Melken zuschauen. \r\n."
    ],
    "en": [
      "We sell our products directly from the farm in Lans-en-Vercors: Bleu du Vercors-Sassenage PDO cheese, St Marcellin PGI cheese, fromage blanc and raclette.\r\nYou can see our herd of cows and watch them being milked from 5-6pm."
    ],
    "it": [
      "Vendiamo i nostri prodotti direttamente dalla fattoria di Lans en Vercors: Bleu du Vercors-Sassenage DOP, St Marcellin IGP, fromage blanc e raclette.\r\nÈ possibile vedere la nostra mandria di mucche e assistere alla mungitura dalle 17.00 alle 18.00.\r\n."
    ],
    "fr": [
      "Nous vendons notre production directement à la ferme à Lans en Vercors : Bleu du Vercors-Sassenage AOP, St Marcellin IGP, fromage blanc et raclette.\r\nVous pourrez voir notre troupeau de vaches et assister à la traite de 17h à 18h. \r\n."
    ],
    "nl": [
      "Wij verkopen onze producten rechtstreeks van de boerderij in Lans en Vercors: Bleu du Vercors-Sassenage BOB, St Marcellin BGA, fromage blanc en raclette.\r\nU kunt onze kudde koeien zien en het melken bijwonen van 17.00 tot 18.00 uur.\r\n."
    ],
    "es": [
      "Vendemos nuestros productos directamente desde la granja de Lans en Vercors: Bleu du Vercors-Sassenage DOP, St Marcellin IGP, fromage blanc y raclette.\r\nPuede ver nuestro rebaño de vacas y asistir al ordeño de 17 a 18 h.\r\n."
    ]
  },
