  "rdfs:comment": {
    "de": [
      "Der Montchauvet ist einer der Gipfel von La Margeride und ein bemerkenswerter Belvedere über dem Zentralmassiv.\r\nHöhe: 1484 m\r\nDas verlassene mittelalterliche Dorf Montchauvet ist eine archäologische Stätte, die 1965 wiederentdeckt wurde. Es befindet sich an der Ostflanke des Berges."
    ],
    "en": [
      "Montchauvet is one of the peaks of La Margeride, a remarkable belvedere overlooking the Massif Central.\r\nAltitude: 1484 m\r\nThe deserted medieval village of Montchauvet is an archaeological site rediscovered in 1965. It lies on the eastern flank of the mountain."
    ],
    "it": [
      "Montchauvet è una delle cime della Margeride, un notevole belvedere che domina il Massiccio Centrale.\r\nAltitudine: 1484 m\r\nIl villaggio medievale abbandonato di Montchauvet è un sito archeologico riscoperto nel 1965. Si trova sul versante orientale della montagna."
    ],
    "fr": [
      "Le Montchauvet est un des sommets de La Margeride, c'est un remarquable belvèdère sur le Massif Central.\r\nAltitude : 1484 m\r\nLe village médiéval déserté de Montchauvet est un site archéologique redécouvert en 1965. Il se situe sur le flanc oriental du mont."
    ],
    "nl": [
      "Montchauvet is een van de toppen van La Margeride, een opmerkelijke belvedère die uitkijkt over het Centraal Massief.\r\nHoogte: 1484 m\r\nHet verlaten middeleeuwse dorp Montchauvet is een archeologische vindplaats die in 1965 werd herontdekt. Het ligt op de oostelijke flank van de berg."
    ],
    "es": [
      "Montchauvet es uno de los picos de La Margeride, un notable mirador que domina el Macizo Central.\r\nAltitud: 1484 m\r\nEl pueblo medieval abandonado de Montchauvet es un yacimiento arqueológico redescubierto en 1965. Está situado en el flanco oriental de la montaña."
    ]
  },
  "rdfs:label": {
    "fr": [
