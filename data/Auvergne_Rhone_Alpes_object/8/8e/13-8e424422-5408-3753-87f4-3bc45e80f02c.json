  "rdfs:comment": {
    "de": [
      "Kunsthandwerkliche Näherin, die einzigartige und farbenfrohe textile Accessoires herstellt.\r\nIch kombiniere Materialien und Nuancen, um Frauen elegante Stücke für jeden Anlass zu bieten.\r\nEin Universum, in dem Know-how, Kreativität und handwerkliche Authentizität aufeinandertreffen."
    ],
    "en": [
      "Couturière artisan d?art, unique and colorful textile accessories.\r\nI combine materials and shades to create elegant pieces for women for all occasions.\r\nA world where know-how, creativity and authentic craftsmanship meet."
    ],
    "it": [
      "Couturière artigianale, accessori tessili unici e colorati.\r\nCombino materiali e tonalità per creare pezzi eleganti per le donne, per tutte le occasioni.\r\nUn mondo di competenza, creatività e autentica artigianalità."
    ],
    "fr": [
      "Couturière artisan d’art, d'accessoires textiles uniques et colorés. \r\nJ’associe matières et nuances pour offrir des pièces élégantes aux femmes en toutes occasions.\r\nUn univers où se rencontrent savoir-faire, créativité et authenticité artisanale."
    ],
    "nl": [
      "Couturière artisan d'art, unieke en kleurrijke textielaccessoires.\r\nIk combineer materialen en tinten om elegante stukken te creëren voor vrouwen voor alle gelegenheden.\r\nEen wereld van expertise, creativiteit en authentiek vakmanschap."
    ],
    "es": [
      "Couturière artisan d'art, accesorios textiles únicos y llenos de color.\r\nCombino materiales y matices para crear elegantes piezas femeninas para todas las ocasiones.\r\nUn mundo de maestría, creatividad y auténtica artesanía."
    ]
  },
  "rdfs:label": {
    "en": [
      "Kréaméline workshop"
    ],
    "fr": [
      "Kréaméline - Mélanie Laboure"
    ]
  },
