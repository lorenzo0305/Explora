  "rdfs:comment": {
    "de": [
      "Die Nyonser und Besucher der Gemeinde können sich auf die Arbeit der aus 13 Soldaten bestehenden Territorialbrigade von Nyons sowie auf die autonome Brigade von Grignan verlassen, die die Brigade von Nyons im Bedarfsfall unterstützen kann."
    ],
    "en": [
      "The people of Nyons and visitors to the commune can count on the work of the thirteen-strong Nyons territorial brigade, as well as the autonomous Grignan brigade, which can provide support to the Nyons brigade if required."
    ],
    "it": [
      "Gli abitanti di Nyons e i visitatori del comune possono contare sul lavoro della brigata territoriale di Nyons, composta da tredici soldati, e della brigata autonoma di Grignan, che può fornire supporto alla brigata di Nyons se necessario."
    ],
    "fr": [
      "Les Nyonsais et visiteurs de la commune peuvent compter sur le travail de la brigade territoriale de Nyons composée de treize militaires ainsi que sur la brigade autonome de Grignan susceptible d’apporter son soutien à celle de Nyons en cas de besoin."
    ],
    "es": [
      "Los habitantes de Nyons y los visitantes del municipio pueden contar con el trabajo de la brigada territorial de Nyons, compuesta por trece soldados, así como de la brigada autónoma de Grignan, que puede prestar apoyo a la brigada de Nyons en caso necesario."
    ],
    "nl": [
      "De inwoners van Nyons en de bezoekers van de gemeente kunnen rekenen op het werk van de territoriale brigade van Nyons, bestaande uit dertien soldaten, en de autonome brigade van Grignan, die de brigade van Nyons indien nodig kan ondersteunen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gendarmerie"
    ]
  },
