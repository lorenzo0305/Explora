  "rdfs:comment": {
    "de": [
      "Weißes Mehl, Halbvollkornmehl, Vollkornmehl, Buchweizen, 5-Korn-Mehl. Nudeln Natur, Buchweizen, Piment d'Espelette, Natur/Tomate... Rapsöl und Sonnenblumenöl. Kits Madeleines mit Safran, Kekse, Lebkuchen. Frische Nudeln und Ravioli."
    ],
    "en": [
      "White, semi-complete, wholemeal, buckwheat, 5-grain flours. Plain pasta, buckwheat, Espelette pepper, plain/tomato... Rapeseed and sunflower oil. Saffron madeleine kits, cookies, gingerbread. Fresh pasta and ravioli."
    ],
    "it": [
      "Farina bianca, semicompleta, integrale, di grano saraceno, ai 5 cereali. Pasta normale, grano saraceno, pepe di Espelette, pasta semplice/al pomodoro... Olio di colza e di girasole. Kit di madeleine allo zafferano, biscotti, pan di zenzero. Pasta fresca e ravioli."
    ],
    "fr": [
      "Farine blanche, semi-complète, complète, sarrasin, 5 céréales. Pâtes nature, sarrasin, piment d’Espelette, nature/tomate... Huile de colza et de tournesol. Kits madeleines au safran, cookies, pain d'épices. Pâtes fraîches et raviolis."
    ],
    "nl": [
      "Hele of witte bloem, boekweitmeel. 100% lokaal, geteeld en verwerkt op de boerderij. Natuurlijke pasta met Espelette-peper en boekweit. Saffraan Madeleines-set, koekjes, zandkoekjes met boekweit."
    ],
    "es": [
      "Harina blanca, semicompleta, integral, de trigo sarraceno, de 5 cereales. Pasta normal, trigo sarraceno, pimiento de Espelette,... Aceite de colza y girasol. Kits de magdalenas de azafrán, galletas, pan de jengibre. Pasta fresca y raviolis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Céréalement d'ici / SAS Maison Landrieaux"
    ],
