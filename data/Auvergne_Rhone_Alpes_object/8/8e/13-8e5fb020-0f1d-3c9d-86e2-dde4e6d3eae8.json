  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais Vert durch ein spielerisches und kostenloses Geocaching-Erlebnis: eine Schatzsuche für die ganze Familie!\r\nBegeben Sie sich in Amplepuis auf die Jagd nach Öpinell, der nicht mehr über die Textilgeschichte der Gemeinde Bescheid weiß."
    ],
    "en": [
      "Discover the Beaujolais Vert through a fun and free geocaching experience: a treasure hunt for the whole family!\r\nIn Amplepuis, go on a hunt for Öpinell, who knows all about the textile history of the town."
    ],
    "it": [
      "Scoprite il Beaujolais Vert attraverso un'esperienza di geocaching divertente e gratuita: una caccia al tesoro per tutta la famiglia!\r\nAd Amplepuis, andate a caccia di Öpinell, che sa tutto sulla storia tessile della città."
    ],
    "fr": [
      "Découvrez le Beaujolais Vert à travers une expérience ludique et gratuite de géocaching : une chasse aux trésors à vivre en famille !\r\nÀ Amplepuis, partez à la chasse de Öpinell, incollable sur l'histoire textile de la commune."
    ],
    "nl": [
      "Ontdek de Beaujolais Vert via een leuke en gratis geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nGa in Amplepuis op jacht naar Öpinell, die alles weet over de textielgeschiedenis van het stadje."
    ],
    "es": [
      "Descubra el Beaujolais Vert a través de una experiencia de geocaching divertida y gratuita: ¡una búsqueda del tesoro para toda la familia!\r\nEn Amplepuis, vaya a la caza de Öpinell, que lo sabe todo sobre la historia textil de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Il n'y a que maille qui m'aille..."
    ]
  },
