  "rdfs:comment": {
    "de": [
      "Thomas ist Bergführer (D.E.) an den Quellen des Sees von Annecy und in den umliegenden Bergmassiven. Er führt Sie auf Schneeschuhwanderungen, Trekking-Touren, Trails und bietet sogar Fotoreportagen an."
    ],
    "en": [
      "Thomas is a D.E mountain guide in les Sources du lac d'Annecy and the surrounding mountain ranges. He will guide you during snowshoeing hikes, treks, trails and even offers photo-reportage outings."
    ],
    "it": [
      "Thomas è un accompagnatore di montagna qualificato nell'area delle Fonti del Lago di Annecy e delle montagne circostanti. Può guidarvi in escursioni con le racchette da neve, trekking e sentieri, e può anche fornire una copertura fotografica."
    ],
    "fr": [
      "Thomas est accompagnateur en montagne D.E sur les Sources du lac d'Annecy et sur les massifs environnants. Il vous guide lors de sorties raquettes, treks, trails et propose même des sorties reportages photos."
    ],
    "nl": [
      "Thomas is een gekwalificeerde berggids in het brongebied van het meer van Annecy en de omliggende bergen. Hij kan je begeleiden tijdens sneeuwschoenwandelingen, trektochten en trails, en kan zelfs zorgen voor fotoreportages."
    ],
    "es": [
      "Thomas es un guía de montaña cualificado en la zona de Fuentes del lago de Annecy y las montañas circundantes. Puede guiarte en salidas con raquetas de nieve, caminatas y senderos, e incluso puede hacerte reportajes fotográficos."
    ]
  },
