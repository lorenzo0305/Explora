  "rdfs:comment": {
    "de": [
      "Das Museum befindet sich im Herzen des Dorfes und zeigt archäologische Sammlungen, die größtenteils das Ergebnis von Ausgrabungen in Soyons und Umgebung sind. Es zeigt das Leben der Menschen von der Vorgeschichte bis zum Mittelalter."
    ],
    "en": [
      "Located in the heart of the village, the museum presents archaeological collections, most of which are the result of excavations carried out in and around Soyons. It traces the lives of people from prehistoric times to the Middle Ages."
    ],
    "it": [
      "Situato nel cuore del villaggio, il museo presenta collezioni archeologiche che sono, per la maggior parte, il risultato di scavi effettuati a Soyons e nella zona circostante. Ripercorre la vita dell'uomo dalla preistoria al Medioevo."
    ],
    "fr": [
      "Installé au cœur du village, le musée présente les collections d'archéologie qui sont, pour la plupart, le résultat des fouilles réalisées à Soyons et dans les environs. Il retrace la vie des hommes depuis la Préhistoire jusqu'au Moyen Âge."
    ],
    "es": [
      "Situado en el corazón del pueblo, el museo presenta colecciones arqueológicas que son, en su mayoría, el resultado de excavaciones realizadas en Soyons y sus alrededores. Recorre la vida de la humanidad desde la prehistoria hasta la Edad Media."
    ],
    "nl": [
      "Het museum ligt in het hart van het dorp en presenteert archeologische collecties die grotendeels afkomstig zijn van opgravingen in Soyons en omgeving. Het schetst het leven van de mens vanaf de prehistorie tot de middeleeuwen."
    ]
  },
  "rdfs:label": {
