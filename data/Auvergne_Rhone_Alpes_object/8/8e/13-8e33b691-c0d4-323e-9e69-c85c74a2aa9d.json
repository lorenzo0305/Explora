  "rdfs:comment": {
    "de": [
      "Der AltiParc du Vernet ist ein Hochseilgarten mit über 100 Spielen auf 10 Parcours und 1 Netzbereich. Mehr als 1500 m Seilrutschen, davon 600 m über dem Wasserspiegel von Le Vernet! \"Im Entspannungs- oder Sportmodus, Sie haben die Wahl!\""
    ],
    "en": [
      "AltiParc du Vernet is an accrobranche with over 100 games spread over 10 courses and 1 net area. Over 1,500m of zip lines, including 600m over the Vernet lake! \"Whether you prefer relaxation or sport, the choice is yours!"
    ],
    "it": [
      "L'AltiParc du Vernet è un accrobranche con oltre 100 giochi distribuiti su 10 percorsi e 1 area di rete. Oltre 1.500 m di teleferiche, di cui 600 m sopra il lago Vernet! \"Relax o sport, a voi la scelta!"
    ],
    "fr": [
      "L' AltiParc du Vernet est un accrobranche avec plus de 100 jeux répartis sur 10 parcours et 1 espace filet. Plus de 1500m de tyroliennes dont 600m au-dessus du plan d'eau du Vernet ! \"En mode détente ou sportif, à vous de choisir !\""
    ],
    "nl": [
      "Het AltiParc du Vernet is een accrobranche met meer dan 100 spellen verdeeld over 10 parcoursen en 1 netgebied. Meer dan 1.500 m tokkelbanen, waarvan 600 m boven het meer van Vernet! \"Ontspanning of sport, de keuze is aan jou!"
    ],
    "es": [
      "El AltiParc du Vernet es un accrobranche con más de 100 juegos repartidos en 10 recorridos y 1 zona de redes. Más de 1.500 m de tirolinas, ¡incluidas 600 m sobre el lago Vernet! \"Relajación\" o \"deporte\", ¡usted elige!"
    ]
  },
  "rdfs:label": {
