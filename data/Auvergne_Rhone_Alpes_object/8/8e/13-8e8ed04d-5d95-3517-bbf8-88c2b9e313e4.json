  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Berge auf eine andere Art und Weise, erleben Sie unvergessliche Momente in einer freundlichen Atmosphäre mit den Skilehrern und Bergführern von SENSATIONS."
    ],
    "en": [
      "Discover the mountain in a different way, live unforgettable moments in a friendly atmosphere with the instructors and guides of SENSATIONS."
    ],
    "it": [
      "Scoprite la montagna in modo diverso, vivete momenti indimenticabili in un'atmosfera amichevole con gli istruttori e le guide di SENSATIONS."
    ],
    "fr": [
      "Découvrez la montagne autrement, vivez des instants inoubliables dans une ambiance conviviale avec les moniteurs et guides de SENSATIONS."
    ],
    "nl": [
      "Ontdek de bergen op een andere manier en geniet van onvergetelijke momenten in een vriendelijke sfeer met de instructeurs en gidsen van SENSATIONS."
    ],
    "es": [
      "Descubre la montaña de una manera diferente, vive momentos inolvidables en un ambiente agradable con los instructores y guías de SENSATIONS."
    ]
  },
