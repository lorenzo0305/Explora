  "rdfs:comment": {
    "de": [
      "Bewege dich mithilfe deiner Karte von Pontcharra bis zum Dorf Saint Maximin. Benutzen Sie die Markierungen, um die Route \"au temps du Chevalier Bayard\" zu entdecken, eine thematische Route über das Leben des berühmten Ritters."
    ],
    "en": [
      "Use your map to walk from Pontcharra to the village of Saint Maximin. Use the markers to discover the “Bayard Chevalier” trail, a themed tour of the famous knight's life."
    ],
    "it": [
      "Utilizzate la vostra mappa per spostarvi da Pontcharra al villaggio di Saint Maximin. Utilizzate i segnalatori per scoprire l'itinerario \"al tempo del cavaliere Bayard\", un percorso tematico basato sulla vita del famoso cavaliere."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez -vous depuis Pontcharra jusqu'au village de Saint Maximin. Utilisez les balises, qui vous permettront de découvrir le parcours \"au temps du Chevalier Bayard\", parcours thématique sur la vie du célèbre Chevalier."
    ],
    "es": [
      "Utilice su mapa para viajar desde Pontcharra hasta el pueblo de Saint Maximin. Utilice los marcadores para descubrir la ruta \"en tiempos del caballero Bayardo\", una ruta temática basada en la vida del famoso caballero."
    ],
    "nl": [
      "Gebruik je kaart om van Pontcharra naar het dorp Saint Maximin te reizen. Gebruik de markers om de route “ten tijde van de ridder Bayard” te ontdekken, een thematische route gebaseerd op het leven van de beroemde ridder."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Au temps du Chevalier Bayard” heritage orienteering trail"
    ],
    "fr": [
      "Parcours d'orientation patrimoine \"Au temps du Chevalier Bayard\""
    ],
    "nl": [
      "Oriëntatieloop van het erfgoed “Ten tijde van de Bayard ridder”."
    ]
  },
