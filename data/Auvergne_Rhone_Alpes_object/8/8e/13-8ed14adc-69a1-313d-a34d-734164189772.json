  "rdfs:comment": {
    "de": [
      "Kinderaugen werden staunen! Für die ersten Wasserspaßmomente gibt es einen neuen Indoor-Wasserspielplatz mit Murmeltier, Kuh und Co"
    ],
    "en": [
      "Your children will not believe it! For their first pleasure in the water, they will share a playful and interactive moment in this new indoor area, among a marmot, cow..."
    ],
    "it": [
      "Gli occhi dei bambini si meraviglieranno! Per scoprire le gioie dell'acqua, venite a condividere un momento di gioco e interattivo nel nuovo parco giochi acquatico al coperto tra una marmotta e una mucca..."
    ],
    "fr": [
      "Les yeux des enfants vont s'émerveiller ! Pour les premiers plaisirs de l'eau, venez partager un moment ludique et interactif dans la nouvelle aire de jeu aqualudique intérieure au milieu d'une marmotte, d'une vache…"
    ],
    "es": [
      "¡Los ojos de los niños se llenarán de asombro! Para los primeros placeres del agua, venga a compartir un momento lúdico e interactivo en la nueva zona interior de juegos acuáticos en medio de una marmota, una vaca.."
    ],
    "nl": [
      "De ogen van de kinderen zullen gevuld zijn met verwondering! Voor de eerste geneugten van water, kom en deel een speels en interactief moment in de nieuwe overdekte aqua speeltuin te midden van een marmot, een koe?"
    ]
  },
  "rdfs:label": {
    "en": [
      "Indoor paddling pool"
    ],
    "it": [
      "Piscina per bambini - interno"
    ],
    "fr": [
      "Pataugeoire intérieure"
    ]
  },
