  "rdfs:comment": {
    "de": [
      "Im vulkanischen Massiv Cézallier zwischen den Monts Dore und Cantal gelegen. Auf dem Gebiet sind zahlreiche Routen zum Wandern, Mountainbiken und Schneeschuhwandern markiert. Werfen Sie einen Blick auf die Webcam!"
    ],
    "en": [
      "Located in the volcanic Cézallier massif, between Monts Dore and Cantal. Numerous hiking, mountain biking and snowshoeing trails are marked out on the estate. Take a look at the webcam!"
    ],
    "it": [
      "Situato nel massiccio vulcanico del Cézallier, tra le montagne del Dore e del Cantal. Nella tenuta ci sono molti percorsi segnalati per escursioni a piedi, in mountain bike e con le racchette da neve. Date un'occhiata alla webcam!"
    ],
    "fr": [
      "Situé dans le massif volcanique du Cézallier, entre monts Dore et Cantal. De nombreux itinéraires sont balisés sur le domaine pour la pratique de la randonnée pédestre, du VTT et des raquettes. Jetez un œil à la webcam !"
    ],
    "es": [
      "Situada en el macizo volcánico de Cézallier, entre los montes Dore y Cantal. En la finca hay numerosas rutas señalizadas para practicar senderismo, bicicleta de montaña y raquetas de nieve. Eche un vistazo a la webcam"
    ],
    "nl": [
      "Gelegen in het vulkanische Cézallier-massief, tussen de Dore en de Cantal. Er zijn veel bewegwijzerde routes op het landgoed om te wandelen, mountainbiken en sneeuwschoenwandelen. Bekijk de webcam!"
    ]
  },
  "rdfs:label": {
