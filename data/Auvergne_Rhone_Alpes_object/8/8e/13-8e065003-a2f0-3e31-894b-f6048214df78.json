  "rdfs:comment": {
    "de": [
      "Alle Castanhaïres, die Leute aus der Châtaigneraie, werden es Ihnen sagen: Saint-Gérons, das reimt sich auf Taucher! Seine Lage am See von Saint-Étienne-Cantalès macht die Gemeinde im Sommer zu einer der meistbesuchten im Cantal."
    ],
    "en": [
      "All the inhabitants of the Châtaigneraie will tell you: Saint-Gérons is all about diving! Its location on the banks of Lake Saint-Étienne-Cantalès makes it one of the busiest spots in Cantal during summer."
    ],
    "it": [
      "Tutti i Castanhaïres, gli abitanti della Châtaigneraie, ve lo diranno: Saint-Gérons, fa rima con immersione! La sua posizione ai margini del lago di Saint-Étienne-Cantalès rende il villaggio uno dei più frequentati del Cantal in estate."
    ],
    "fr": [
      "Tous les Castanhaïres, les gens de la Châtaigneraie, vous le diront : Saint-Gérons, ça rime avec plongeon ! Sa situation au bord du lac de Saint-Étienne-Cantalès fait de la commune l'une des plus fréquentées du Cantal en été."
    ],
    "es": [
      "Todos los Castanhaïres, la gente de la Châtaigneraie, se lo dirán: Saint-Gérons, ¡rima con buceo! Su situación al borde del lago de Saint-Étienne-Cantalès hace del pueblo uno de los más frecuentados del Cantal en verano."
    ],
    "nl": [
      "Alle inwoners van de Châtaigneraie zullen het je vertellen: Saint-Gérons rijmt op duiken! Door zijn ligging aan de oevers van het meer van Saint-Étienne-Cantalès is het in de zomer een van de populairste plekken in de Cantal."
    ]
  },
  "rdfs:label": {
