  "rdfs:comment": {
    "de": [
      "Der Fluss Allier ist das Rückgrat der Auvergne, er bewässert das Pays d'Issoire, seine Nebenflüsse werden Couzes genannt."
    ],
    "en": [
      "The Allier River is the backbone of the Auvergne region, irrigating the Pays d'Issoire, and its tributaries are called couzes."
    ],
    "it": [
      "Il fiume Allier è la spina dorsale dell'Alvernia e irriga il Pays d'Issoire; i suoi affluenti sono noti come couzes."
    ],
    "fr": [
      "La rivière Allier est la colonne vertébrale de l’Auvergne, elle irrigue le Pays d’Issoire, ses affluents sont appelés couzes."
    ],
    "es": [
      "El río Allier es la columna vertebral de Auvernia, riega el Pays d'Issoire y sus afluentes se conocen como los couzes."
    ],
    "nl": [
      "De Allier is de ruggengraat van de Auvergne en bevloeit het Pays d'Issoire. De zijrivieren staan bekend als de couzes."
    ]
  },
  "rdfs:label": {
    "fr": [
