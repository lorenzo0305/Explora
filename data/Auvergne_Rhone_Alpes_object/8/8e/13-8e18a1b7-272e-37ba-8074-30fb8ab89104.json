  "rdfs:comment": {
    "de": [
      "Jahrzehntelange Erfahrung und Know-how in der Kunst der Glasmalerei.\r\nZwischen der Restaurierung historischer Monumente, der Dekoration, der Inneneinrichtung und der künstlerischen Zusammenarbeit arbeitet Vitrail St-Georges im Dienste der Farbe wie des Lichts."
    ],
    "en": [
      "Decades of experience and know-how in the art of stained glass.\r\nBetween restoration of historical monuments, decoration, interior design and artistic collaboration, Vitrail St-Georges works in the service of colour and light."
    ],
    "it": [
      "Decenni di esperienza e know-how nell'arte del vetro colorato.\r\nTra restauro di monumenti storici, decorazione, interior design e collaborazione artistica, Vitrail St-Georges lavora al servizio del colore e della luce."
    ],
    "fr": [
      "Des décennies d'expérience et un savoir-faire dans l'art du Vitrail.\r\nEntre restauration de monuments historiques, décoration, agencement d'intérieur et collaboration artistique, Vitrail St-Georges œuvre au service de la couleur comme de la lumière."
    ],
    "nl": [
      "Tientallen jaren ervaring en knowhow in de kunst van het glas in lood.\r\nTussen restauratie van historische monumenten, decoratie, binnenhuisarchitectuur en artistieke samenwerking staat Vitrail St-Georges in dienst van kleur en licht."
    ],
    "es": [
      "Décadas de experiencia y conocimientos en el arte de las vidrieras.\r\nEntre la restauración de monumentos históricos, la decoración, el interiorismo y la colaboración artística, Vitrail St-Georges trabaja al servicio del color y la luz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Vitrail St-Georges"
    ]
  },
