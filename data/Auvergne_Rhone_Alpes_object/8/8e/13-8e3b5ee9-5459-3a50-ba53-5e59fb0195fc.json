  "rdfs:comment": {
    "de": [
      "das Refuge du Dahu empfängt Sie in einem gemütlichen Rahmen und einer geselligen Atmosphäre.\r\nDas Restaurant bietet Spezialitäten aus den Bergen, Crêpes aus Buchweizen oder Weizen, herzhaft oder süß, sowie Spezialitäten aus aller Welt im Dauerbetrieb."
    ],
    "en": [
      "the Refuge du Dahu welcomes you in a warm and friendly atmosphere.\r\nThe restaurant offers buckwheat or wheat crêpes, savory or sweet, as well as world specialties, with continuous service."
    ],
    "it": [
      "il Refuge du Dahu offre un'accoglienza calorosa in un'atmosfera amichevole.\r\nIl ristorante propone specialità di montagna, crêpes di grano saraceno o di frumento, salate o dolci, nonché specialità del mondo, servite in continuazione."
    ],
    "fr": [
      "le Refuge du Dahu vous accueille dans un cadre chaleureux et une ambiance conviviale.\r\nLe restaurant propose des spécialités montagnardes, des crêpes au blé noir ou au froment, salées ou sucrée, ainsi que des spécialités du monde, en service continu."
    ],
    "es": [
      "el Refuge du Dahu ofrece una cálida bienvenida en un ambiente acogedor.\r\nEl restaurante ofrece especialidades de montaña, crepes de trigo sarraceno o de trigo, salados o dulces, así como especialidades del mundo, servidas continuamente."
    ],
    "nl": [
      "de Refuge du Dahu verwelkomt je in een warme en vriendelijke sfeer.\r\nHet restaurant serveert de hele dag door boekweit- of tarwe crêpes, hartig of zoet, en wereldspecialiteiten."
    ]
  },
