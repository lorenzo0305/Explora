  "rdfs:comment": {
    "de": [
      "Die Tapete der \"Ruinen von Rom\", die das Wohnzimmer eines alten Hauses in Bas-en-Basset schmückte, wird seit Juni 2024 am Eingang des Empfangsbüros des Fremdenverkehrsamtes in Bas-en-Basset ausgestellt."
    ],
    "en": [
      "The \"Ruins of Rome\" wallpaper that once adorned the living room of an old Bassoise house has been on display since June 2024, at the entrance to the Tourist Office reception desk in Bas-en-Basset."
    ],
    "it": [
      "Dal giugno 2024, la carta da parati \"Rovine di Roma\" che un tempo ornava il salotto di un'antica casa bassanese è esposta all'ingresso della reception dell'Ufficio del Turismo di Bas-en-Basset."
    ],
    "fr": [
      "Le papier peint des « Ruines de Rome » qui ornait le salon d’une ancienne maison bassoise est présenté depuis juin 2024, à l’entrée du bureau d’accueil de l’Office de Tourisme à Bas-en-Basset."
    ],
    "nl": [
      "Sinds juni 2024 is het behangpapier \"Ruïnes van Rome\" dat ooit de woonkamer van een oud Bassoise huis sierde, te zien bij de ingang van de receptie van het Office du Tourisme in Bas-en-Basset."
    ],
    "es": [
      "Desde junio de 2024, el papel pintado \"Ruinas de Roma\" que antaño adornaba el salón de una antigua casa bassoise exhibe en la entrada de la recepción de la Oficina de Turismo de Bas-en-Basset."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le papier peint « Ruines de Rome »"
    ]
  },
