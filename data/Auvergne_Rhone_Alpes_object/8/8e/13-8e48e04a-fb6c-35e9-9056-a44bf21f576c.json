  "rdfs:comment": {
    "de": [
      "Bereit für eine rasante Abfahrt? Der Mountain Twister führt dich über 800 m mit Kurven, Twists und Passagen – in deinem Tempo! Familienspaß ab 3 Jahren, auch zu zweit fahrbar. Im Sommer wie im Winter genießen!"
    ],
    "en": [
      "Ready for a hair-raising ride? The Mountain Twister takes you over 800 m of banked turns, twists and passages at the speed you choose! Fun and family-friendly from age 3, with a two-seater option. Enjoy all year round!"
    ],
    "it": [
      "Pronti per una discesa emozionante? Il Mountain Twister vi porta per 800 m di curve, torsioni e passaggi alla velocità che scegliete! Divertente e adatto alle famiglie, dai 3 anni, anche in due. Da vivere tutto l’anno!"
    ],
    "fr": [
      "Prêt(e) pour une descente qui décoiffe ? Le Mountain Twister vous embarque sur 800 m de virages, vrilles et passages, à la vitesse que vous voulez ! Fun et familial dès 3 ans, avec option à deux. À savourer sans modération, été comme hiver !"
    ],
    "es": [
      "¿Listo(a) para un descenso increíble? El Mountain Twister te lleva por 800 m de curvas, giros y pasajes a la velocidad que elijas. Diversión familiar desde los 3 años, con opción de ir en pareja. ¡Disfruta todo el año!"
    ],
    "nl": [
      "Klaar voor een spannende afdaling? De Mountain Twister neemt je mee over 800 m bochten, twists en passages, op jouw snelheid! Leuk en familievriendelijk, vanaf 3 jaar, ook met twee personen. Het hele jaar door te beleven!"
    ]
  },
