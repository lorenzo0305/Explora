  "rdfs:comment": {
    "de": [
      "Neues Konzept in der Auvergne: Axtwerfen!\r\nMit der Familie, unter Freunden oder um Ihre Bürokollegen herauszufordern, bietet Ihnen H men bien die Möglichkeit, Ihre Geschicklichkeit im Umgang mit der Axt zu testen."
    ],
    "en": [
      "New concept in Auvergne: axe throwing!\r\nWith family, friends or to challenge your office colleagues, H men bien invites you to test your axe-throwing skills."
    ],
    "it": [
      "Un nuovo concetto in Alvernia: il lancio dell'ascia!\r\nIn famiglia, con gli amici o per sfidare i colleghi d'ufficio, H men bien vi invita a mettere alla prova le vostre abilità nel lancio dell'ascia."
    ],
    "fr": [
      "Nouveau concept en Auvergne : le lancer de Haches !\r\nEn famille, entres amis ou pour défier vos collègues de bureaux, H men bien vous propose de tester votre habileté au maniement de la Hache."
    ],
    "es": [
      "Un nuevo concepto en Auvernia: ¡el lanzamiento de hachas!\r\nEn familia, con amigos o para desafiar a tus compañeros de oficina, H men bien te invita a poner a prueba tus habilidades con el lanzamiento de hachas."
    ],
    "nl": [
      "Een nieuw concept in Auvergne: bijlwerpen!\r\nAls familie, met vrienden of om je collega's op kantoor uit te dagen, nodigt H men bien je uit om je bijlwerpkunsten te testen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "H m'en bien - Lancer de haches"
    ]
  },
