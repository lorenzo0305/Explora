  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant anhand eines einzigen Menüs \"Retour de marché\" mit regionalen Köstlichkeiten je nach Saison."
    ],
    "en": [
      "Come and discover our restaurant and its unique \"back from market\" menu with regional and seasonal flavours."
    ],
    "it": [
      "Venite a scoprire il nostro ristorante, con un menu unico di sapori locali e stagionali, e il nostro mazot di fonduta."
    ],
    "fr": [
      "Venez découvrir notre restaurant, au menu unique \"retour de marché\", aux saveurs locales et de saison, ainsi que notre mazot à fondue."
    ],
    "es": [
      "Venga a descubrir nuestro restaurante, con el menú único, recién salido del mercado, lleno de sabores regionales y de la temporada."
    ],
    "nl": [
