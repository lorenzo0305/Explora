  "rdfs:comment": {
    "de": [
      "Privater Liegeplatz, gebührenpflichtig von Mai bis September. Motor- und Segelboote mit einer Länge von mehr als 5 Metern müssen an der Bouchet-Brücke zu Wasser gelassen werden. Die Mitgliedschaft im Verein ist obligatorisch."
    ],
    "en": [
      "Private mooring, fee charged from May to September. Motorised or sailing boats over 5 metres in length must be launched at the Bouchet bridge. Membership of the association is compulsory."
    ],
    "it": [
      "Ormeggio privato a pagamento da maggio a settembre. Le imbarcazioni a motore o a vela di lunghezza superiore a 5 metri devono essere varate al ponte Bouchet. L'iscrizione all'associazione è obbligatoria."
    ],
    "fr": [
      "Mise à l'eau aménagée, payante de Mai à Septembre, domaine privée. Les bateaux motorisés ou à voile de plus de 5 mètres de longueur doivent être mises à l'eau au pont de Bouchet. Une adhésion à l'association sur place est obligatoire."
    ],
    "nl": [
      "Privé aanlegplaats, tegen betaling van mei tot september. Gemotoriseerde of zeilboten met een lengte van meer dan 5 meter moeten te water worden gelaten bij de brug van Bouchet. Lidmaatschap van de vereniging is verplicht."
    ],
    "es": [
      "Amarre privado de pago de mayo a septiembre. Las embarcaciones a motor o a vela de más de 5 metros de eslora deben botarse en el puente de Bouchet. Es obligatorio ser miembro de la asociación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mise à l'eau Pont du Bouchet - Lac des Fades"
    ]
  },
