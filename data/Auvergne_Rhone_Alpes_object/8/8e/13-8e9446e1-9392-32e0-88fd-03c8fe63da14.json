  "rdfs:comment": {
    "de": [
      "Chazelles-sur-Lyon, dessen Geschichte und Architektur stark von der Industrie der Filzhutfabrikation (hergestellt aus Kaninchenhaar) geprägt wurde. Im Herzen der Stadt gelegen, ist das Touristeninformationsbüro leicht zu erreichen."
    ],
    "en": [
      "Chazelles-sur-Lyon, whose history and architecture have been strongly marked by the felt hat industry (made from rabbit hair). Located in the heart of the city, the tourist information office is easily accessible."
    ],
    "it": [
      "Chazelles-sur-Lyon, la cui storia e architettura sono state fortemente influenzate dall'industria dei cappelli di feltro (realizzati con peli di coniglio). L'ufficio informazioni turistiche si trova nel cuore della città ed è facilmente accessibile."
    ],
    "fr": [
      "Chazelles-sur-Lyon, dont l'histoire et l'architecture ont été fortement marquées par l'industrie de la fabrique du chapeau de feutre (fabriqué avec du poil de lapin) Situé au cœur de la ville, le bureau d'information touristique est facile d'accès."
    ],
    "nl": [
      "Chazelles-sur-Lyon, waarvan de geschiedenis en de architectuur sterk zijn beïnvloed door de vilthoedenindustrie (gemaakt van konijnenhaar)."
    ],
    "es": [
      "Chazelles-sur-Lyon, cuya historia y arquitectura están fuertemente influenciadas por la industria de los sombreros de fieltro (fabricados con pelo de conejo). La oficina de información turística está situada en el centro de la ciudad y es fácilmente accesible."
    ]
  },
  "rdfs:label": {
