  "rdfs:comment": {
    "de": [
      "Champvallier, das an den Plan d'eau des Ozières angrenzt, ist ein 13 ha großes Gebiet (Teich von 5 ha), das Anglern mit einer Bundeskarte die Möglichkeit bietet, ihren Lieblingshobby zu genießen."
    ],
    "en": [
      "Champvallier, next to the Ozières lake, is a 13-hectare estate (with a 5-hectare pond) where anglers with a federal fishing licence can enjoy their favourite pastime."
    ],
    "it": [
      "Champvallier, vicino al lago di Ozières, è una tenuta di 13 ettari (con un laghetto di 5 ettari) dove i pescatori con licenza di pesca federale possono praticare il loro passatempo preferito."
    ],
    "fr": [
      "Champvallier, voisin du plan d'eau des Ozières, est un domaine de 13 ha (étang de 5 hectares) qui offre aux pêcheurs munis d'une carte fédérale de profiter de leur passe-temps favori."
    ],
    "nl": [
      "Champvallier, naast het meer van Ozières, is een domein van 13 hectare (met een vijver van 5 hectare) waar vissers met een federale visvergunning hun favoriete tijdverdrijf kunnen beoefenen."
    ],
    "es": [
      "Champvallier, junto al lago de Ozières, es una finca de 13 hectáreas (con un estanque de 5 hectáreas) donde los pescadores con licencia federal de pesca pueden disfrutar de su pasatiempo favorito."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Étang de Champvallier"
    ]
  },
