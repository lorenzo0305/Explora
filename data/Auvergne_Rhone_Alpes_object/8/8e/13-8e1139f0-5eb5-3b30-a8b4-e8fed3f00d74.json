  "rdfs:comment": {
    "de": [
      "Mit der Familie, Freunden oder Mitarbeitern, in Teams von 4 bis 10 Personen, entdecken Sie einen außergewöhnlichen Sinnesparcours und stellen sich ungewöhnlichen Herausforderungen in der Dunkelheit."
    ],
    "en": [
      "With family, friends or colleagues, in teams of 4 to 10 people, discover an unusual sensory course and take on unusual challenges in the dark."
    ],
    "it": [
      "Con la famiglia, gli amici o i colleghi, in squadre da 4 a 10 persone, scoprite un percorso sensoriale insolito e affrontate sfide insolite al buio."
    ],
    "fr": [
      "En famille, entre amis ou entre collaborateurs, en équipe de 4 à 10 personnes, découvrez un parcours sensoriel hors du commun et relevez des défis insolites dans l'obscurité."
    ],
    "nl": [
      "Met familie, vrienden of collega's, in teams van 4 tot 10 personen, een ongewoon zintuiglijk parcours ontdekken en ongewone uitdagingen aangaan in het donker."
    ],
    "es": [
      "Con la familia, los amigos o los colegas, en equipos de 4 a 10 personas, descubra un recorrido sensorial insólito y enfréntese a retos insólitos en la oscuridad."
    ]
  },
