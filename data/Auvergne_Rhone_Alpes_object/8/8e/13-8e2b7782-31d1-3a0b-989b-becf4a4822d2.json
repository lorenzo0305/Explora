  "rdfs:comment": {
    "de": [
      "Die Bergbegleiter lassen Sie die Berge und ihre Freuden entdecken! Tages- oder Halbtageswanderungen: Entdeckung der Fauna und Flora, Yoga-Wanderungen, Feinschmeckerwanderungen, spezielle Kinder-, Gruppen- und Schulwanderungen."
    ],
    "en": [
      "Mountain guides will help you discover the mountains and their pleasures! Full day or half day hikes: discovery of the fauna and flora, yoga hikes, gourmet hikes, special hikes for children, groups and schools."
    ],
    "it": [
      "Le nostre guide alpine vi faranno scoprire le montagne e tutto ciò che hanno da offrire! Escursioni di un'intera giornata o di mezza giornata: scoperta della fauna e della flora, escursioni yoga, escursioni gastronomiche, escursioni speciali per bambini, gruppi e scuole."
    ],
    "fr": [
      "Les accompagnateurs en montagne vous font découvrir la montagne et ses plaisirs ! Randonnée à la journée ou demi-journée : découverte de la faune, de la flore, rando yoga, gourmande, spéciale enfant, groupes et scolaires."
    ],
    "nl": [
      "Onze berggidsen helpen je de bergen en alles wat ze te bieden hebben te ontdekken! Wandelingen van een hele of halve dag: ontdek de fauna en flora, yoga wandelingen, gastronomische wandelingen, speciale wandelingen voor kinderen, groepen en scholen."
    ],
    "es": [
      "Nuestros guías de montaña le ayudarán a descubrir las montañas y todo lo que pueden ofrecerle Excursiones de un día o medio día: descubrimiento de la fauna y la flora, excursiones de yoga, excursiones gastronómicas, excursiones especiales para niños, grupos y escuelas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bureau de la Montagne de la vallée d'Abondance - Association of mid-mountain guides"
    ],
    "fr": [
      "Bureau de la Montagne de la vallée d'Abondance - Regroupement d'accompagnateurs en moyenne montagne"
    ],
    "nl": [
      "Bureau de la Montagne de la vallée d'Abondance - Vereniging van gidsen voor het middelgebergte"
    ]
  },
