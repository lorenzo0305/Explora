  "rdfs:comment": {
    "de": [
      "Unsere Familie ist seit 1809 Eigentümer und Betreiber des Château de Varennes und gibt das Know-how seit mehr als zehn Generationen weiter\r\nWir produzieren Beaujolais Villages und einen Crémant de Bourgogne."
    ],
    "en": [
      "Our family has been the owner-manager of the Château de Varennes since 1809, passing on its know-how for more than 10 generations. The domain encompasses 20 Ha of vineyard facing South on the slopes that border the castle."
    ],
    "it": [
      "La nostra famiglia possiede e gestisce lo Château de Varennes dal 1809, trasmettendo il know-how da oltre 10 generazioni\r\nProduciamo Beaujolais Villages e Crémant de Bourgogne."
    ],
    "fr": [
      "Notre famille est propriétaire-exploitante du Château de Varennes depuis 1809, se transmettant le savoir-faire depuis plus de 10 générations. \r\nNous produisons des Beaujolais Villages et un Crémant de Bourgogne."
    ],
    "nl": [
      "Onze familie bezit en beheert Château de Varennes sinds 1809 en geeft de knowhow al meer dan 10 generaties door\r\nWij produceren Beaujolais Villages en Crémant de Bourgogne."
    ],
    "es": [
      "Nuestra familia es propietaria y gestora del Château de Varennes desde 1809, transmitiendo el saber hacer durante más de 10 generaciones\r\nProducimos Beaujolais Villages y Crémant de Bourgogne."
    ]
  },
