  "rdfs:comment": {
    "de": [
      "Teambuilding-Sitzungen, Seminare oder private Veranstaltungen nach Maß (Slalom, Fackelabfahrten, Schlitten, Schneeschuhe, Biathlon usw.). Teilen Sie das 100%ige Schneeerlebnis mit ESF."
    ],
    "ru": [
      "Команда ESF Мерибель предлагает свои услуги и помощь в организации Ваших закрытых мероприятий. Team Building, биатлон, спуски с факелами, соревнования по слалому с возможностью приватизировать стадион, санки, лыжи, снегоступы и многое другое. Присылайте Ваши заявки и вопросы на адрес электронной почты: commercial@esf-meribel.com."
    ],
    "en": [
      "Let us organize your private events, team building and incentives. All events are taylored to your needs and budget (ski races, torchlite descents, sledging, snowshoeing, biathlon, etc.) Live a new experience with ESF Méribel."
    ],
    "it": [
      "Sessioni di team building, seminari o eventi privati su misura (slalom, discese in fiaccolata, slittino, ciaspole, biathlon ecc.). Venite a condividere l'esperienza 100% neve con ESF."
    ],
    "fr": [
      "Séances team building, séminaires ou événements privés sur mesure (slalom, descentes aux torches, luges, raquettes, biathlon etc.). Venez partagez l'expérience 100% neige avec ESF."
    ],
    "es": [
      "Sesiones de team building, seminarios o eventos privados a medida (slalom, descenso con antorcha, trineo, raquetas de nieve, biatlón, etc.). Ven a compartir la experiencia de la nieve al 100% con el FSE."
    ],
    "nl": [
      "Let us organize your private events, team building and incentives. All events are taylored to your needs and budget (ski races, torchlite descents, sledging, snowshoeing, biathlon, etc.) Live a new experience with ESF Méribel."
    ]
  },
