  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73222867-f06c-3d7c-aa5a-58de9acfb52e",
      "dc:description": {
        "de": [
          "Bei Les Biclounes du mini-golf können Sie klassische Fahrräder für Ausflüge auf den Radwegen der Somme-Bucht mieten, die in Saint-Valéry-sur-Somme beginnen! Verpflegung vor Ort möglich."
        ],
        "en": [
          "Les Biclounes du mini-golf offer classic bikes for hire for rides on the Baie de Somme's cycle paths, departing from Saint-Valéry-sur-Somme! Catering on site is possible."
        ],
        "it": [
          "Les Biclounes du mini-golf propongono il noleggio di biciclette d'epoca per le passeggiate sulle piste ciclabili della Baie de Somme, partendo da Saint-Valéry-sur-Somme! Catering disponibile in loco."
        ],
        "fr": [
          "Les Biclounes du mini-golf proposent à la location des vélos classiques pour des balades sur les pistes cyclables de la Baie de Somme, au départ de Saint-Valéry-sur-Somme ! Restauration sur place possible."
        ],
        "nl": [
          "Les Biclounes du mini-golf verhuren klassieke fietsen voor tochten over de fietspaden van de Baie de Somme, vanuit Saint-Valéry-sur-Somme! Catering ter plaatse beschikbaar."
        ],
        "es": [
          "Les Biclounes du mini-golf ofrecen el alquiler de bicicletas clásicas para pasear por los carriles bici de la Bahía de Somme, ¡a partir de Saint-Valéry-sur-Somme! Servicio de catering disponible en el lugar."
        ]
      },
      "@type": [
        "Description"
