  "rdfs:comment": {
    "de": [
      "Mieten Sie Fahrräder bei Les Biclounes du mini-golf in der mittelalterlichen Stadt Saint-Valery-sur-Somme. Schwingen Sie sich auf Ihr Fahrrad und fahren Sie durch die Baie de Somme!"
    ],
    "en": [
      "Bike hire at Les Biclounes du mini-golf in the medieval town of Saint-Valery-sur-Somme. Get on your bike and explore the Baie de Somme!"
    ],
    "it": [
      "Noleggio di biciclette presso Les Biclounes du mini-golf nella città medievale di Saint-Valery-sur-Somme. Salite in sella alla vostra bici ed esplorate la Baie de Somme!"
    ],
    "fr": [
      "Location de vélos aux Biclounes du mini-golf dans la cité médiévale de Saint-Valery-sur-Somme. Enfourchez votre vélo et parcourez la Baie de Somme !"
    ],
    "nl": [
      "Fietsverhuur bij Les Biclounes du mini-golf in de middeleeuwse stad Saint-Valery-sur-Somme. Stap op de fiets en verken de Baie de Somme!"
    ],
    "es": [
      "Alquiler de bicicletas en Les Biclounes du mini-golf, en la ciudad medieval de Saint-Valery-sur-Somme. ¡Súbete a tu bici y explora la Bahía de Somme!"
    ]
  },
