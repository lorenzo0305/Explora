  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1469cc7a-3a57-3af5-819f-42b01f8d59e4",
      "dc:description": {
        "de": [
          "Nehmen Sie am Montag, dem 21. April, von 14.00 bis 16.00 Uhr an der von der Ferme du Bois Joli in Torcy organisierten Eiersuche teil. Auf dem Programm stehen: Eiersuche, Besuch des Bauernhofs und ein Bauernsnack. Weitere Informationen finden Sie auf dem Plakat"
        ],
        "en": [
          "Come and take part in the egg hunt organized by the Ferme du Bois Joli in Torcy on Monday April 21 from 2pm to 4pm. The program includes an egg hunt, a visit to the farm and a farm snack. For more information, please consult the poster"
        ],
        "it": [
          "Partecipate alla caccia alle uova organizzata dalla Ferme du Bois Joli di Torcy lunedì 21 aprile dalle 14 alle 16. Il programma prevede una caccia alle uova, una visita alla fattoria e una merenda in fattoria. Per maggiori informazioni, consultare la locandina"
        ],
        "fr": [
          "Venez participer à la chasse aux œufs organisée par la ferme du Bois Joli à Torcy le lundi 21 avril de 14h à 16h, au programme : chasse aux oeufs, visite de la ferme et goûter fermier. Pour obtenir davantage d'informations, veuillez consulter l'affiche"
        ],
        "es": [
          "Participe en la caza del huevo organizada por la Ferme du Bois Joli de Torcy el lunes 21 de abril de 14:00 a 16:00. El programa incluye una búsqueda del huevo, una visita a la granja y una merienda campestre. Para más información, consulte el cartel"
        ],
        "nl": [
          "Kom op maandag 21 april van 14.00 tot 16.00 uur meedoen aan het eierzoeken georganiseerd door de Ferme du Bois Joli in Torcy. Op het programma staan een eierzoeken, een bezoek aan de boerderij en een boerderijhapje. Zie voor meer informatie de poster"
        ]
      },
      "@type": [
        "Description"
      ],
