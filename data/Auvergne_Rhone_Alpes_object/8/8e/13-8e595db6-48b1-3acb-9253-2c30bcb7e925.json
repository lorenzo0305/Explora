  "rdfs:comment": {
    "de": [
      "Ämÿ Äÿm bietet Ihnen die Workshops \"Montagn' Art Nature\" an. Wir pflücken in der Natur\r\nin der freien Natur Pflanzen, um dann im Atelier Ihren Kranz oder Ihr Blumenarrangement zu gestalten."
    ],
    "en": [
      "Ämÿ Äÿm offers \"Montagn 'Art Nature\" workshops. We pick in\r\nfull nature of plants to then create in the workshop your wreath or floral arrangement."
    ],
    "it": [
      "Ämÿ Äÿm propone laboratori “Montagn’ Art \r\nNature”. I partecipanti vengono accompagnati in \r\nmezzo alla natura per raccogliere vegetali e creare \r\nin atelier una ghirlanda o altra composizione \r\nfloreale, che sarà poi possibile portare a casa al \r\ntermine del laboratorio."
    ],
    "fr": [
      "Ämÿ Äÿm vous propose des ateliers \"Montagn' Art Nature\". Nous cueillons en\r\npleine nature des végétaux pour ensuite créer en atelier votre couronne ou composition florale."
    ],
    "es": [
      "Ämÿ Äÿm le ofrece talleres de \"Montagn' Art Nature\". Recogemos plantas en el\r\nplantas en la naturaleza y luego crear su propia corona o arreglo floral en el taller."
    ],
    "nl": [
      "Ämÿ Äÿm biedt u \"Montagn' Art Nature\" workshops aan. We verzamelen planten in de\r\nplanten in het wild en maak dan je eigen krans of bloemstuk in de workshop."
    ]
  },
