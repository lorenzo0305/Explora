  "rdfs:comment": {
    "de": [
      "Drei Tätigkeitsbereiche: Gemüseanbau, Gemüse- oder Blumensamen, Ackerbau. Angemessene Landwirtschaft, aber keine Behandlung des Gemüses."
    ],
    "en": [
      "Three areas of activity: market gardening, vegetable and flower seeds, field crops. Sustainable agriculture, but no treatments on vegetables."
    ],
    "it": [
      "Tre aree di attività: orticoltura, sementi di ortaggi e fiori, coltivazioni in campo. Agricoltura sostenibile, ma nessun trattamento per gli ortaggi."
    ],
    "fr": [
      "Trois domaines d’activités : maraîchage, semences potagères ou florales, grandes cultures. Agriculture raisonnée mais aucun traitement sur les légumes."
    ],
    "es": [
      "Tres áreas de actividad: horticultura, semillas de hortalizas y flores, cultivos de campo. Agricultura sostenible, pero sin tratamientos para las hortalizas."
    ],
    "nl": [
      "Drie gebieden van activiteit: tuinbouw, groente- en bloemzaden, veldgewassen. Duurzame landbouw, maar geen groentebehandelingen."
    ]
  },
  "rdfs:label": {
