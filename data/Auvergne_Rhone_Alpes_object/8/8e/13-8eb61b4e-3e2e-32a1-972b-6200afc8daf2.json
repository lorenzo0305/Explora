  "rdfs:comment": {
    "de": [
      "Vichy ist eine ganz besondere Atmosphäre, eine zeitlose Stimmung, eine Ruhe, die in dieser für jeden von uns komplizierten Zeit ihre volle Bedeutung erlangt."
    ],
    "en": [
      "Vichy is a special atmosphere, a timeless atmosphere, a calmness that takes all its meaning during this complicated period for each of us."
    ],
    "it": [
      "Vichy è un'atmosfera speciale, un'atmosfera senza tempo, una calma che ha senso in questo periodo complicato per tutti noi."
    ],
    "fr": [
      "Vichy c'est une atmosphère à part, une ambiance hors du temps, un calme qui prend tout son sens pendant cette période compliquée pour chacun d'entre nous."
    ],
    "nl": [
      "Vichy is een bijzondere sfeer, een tijdloze sfeer, een rust die zinvol is in deze voor ons allen gecompliceerde periode."
    ],
    "es": [
      "Vichy es un ambiente especial, un ambiente intemporal, una calma que tiene sentido en este periodo complicado para todos nosotros."
    ]
  },
