  "rdfs:comment": {
    "de": [
      "Mit meinem fotografischen Auge habe ich im Laufe der Jahre einen wohlwollenden Blick auf die Natur und die Vulkane geworfen, in denen ich geboren wurde."
    ],
    "en": [
      "With my photographic eye, over the years I've been able to cast a benevolent gaze on nature and the volcanoes that gave birth to me."
    ],
    "it": [
      "Con il mio occhio fotografico, nel corso degli anni ho potuto gettare uno sguardo benevolo sulla natura e sui vulcani in cui sono nato."
    ],
    "fr": [
      "Avec mon œil de photographe, j’ai su, au fil des années, poser un regard bienveillant sur la nature et les volcans qui m'ont vu naître."
    ],
    "nl": [
      "Met mijn fotografische oog heb ik door de jaren heen een welwillende blik kunnen werpen op de natuur en de vulkanen waar ik geboren ben."
    ],
    "es": [
      "Con mi ojo fotográfico, a lo largo de los años he podido lanzar una mirada benévola sobre la naturaleza y los volcanes que me vieron nacer."
    ]
  },
  "rdfs:label": {
