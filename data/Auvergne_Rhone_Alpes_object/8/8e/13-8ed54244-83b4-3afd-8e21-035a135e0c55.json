  "rdfs:comment": {
    "de": [
      "Ein unumgänglicher Zwischenstopp in den Baronnies\r\nSeit 1902 vom Vater auf den Sohn übertragene handwerkliche Brennerei: Entdecken Sie unsere außergewöhnlichen Spirituosen und probieren Sie die Produkte aus unserer Region.\r\nLe Moulin & Oliveraie Bio: Olivenöl und Oliven AOP Nyons."
    ],
    "en": [
      "An Unmissable Stopover in the Baronnies\r\nHandcrafted distillery handed down from father to son since 1902: discover our exceptional spirits and taste products from our terroir.\r\nLe Moulin & Oliveraie Bio: AOP Nyons olive oil and olives."
    ],
    "it": [
      "Una tappa imperdibile nelle Baronnies\r\nUna distilleria tradizionale tramandata di padre in figlio dal 1902: scoprite i nostri eccezionali distillati e assaggiate i prodotti della nostra regione.\r\nLe Moulin & Oliveraie Bio: olio d'oliva e olive DOP di Nyons."
    ],
    "fr": [
      "Une Escale Incontournable en Baronnies\r\nDistillerie artisanale de père en fils depuis 1902 : Découvrez nos spiritueux d’exception et dégustez des produits issus de notre terroir.\r\nLe Moulin & Oliveraie Bio : Huile d’olive et olives AOP Nyons."
    ],
    "es": [
      "Una parada ineludible en las Baronnies\r\nUna destilería tradicional transmitida de padres a hijos desde 1902: descubra nuestros espirituosos excepcionales y deguste los productos de nuestra región.\r\nLe Moulin & Oliveraie Bio: aceite de oliva y aceitunas DOP Nyons."
    ],
    "nl": [
      "Een niet te missen tussenstop in de Baronnies\r\nEen traditionele stokerij die sinds 1902 van vader op zoon wordt doorgegeven: ontdek onze uitzonderlijke sterke dranken en proef de producten uit onze streek.\r\nLe Moulin & Oliveraie Bio: olijfolie en olijven met BOB Nyons."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite et dégustation : moulin et distillerie familiale"
    ]
  },
