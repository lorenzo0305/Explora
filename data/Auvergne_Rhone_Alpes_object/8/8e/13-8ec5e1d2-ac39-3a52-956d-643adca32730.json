  "rdfs:comment": {
    "de": [
      "Ich biete eine Reihe von Lederobjekten an, die vollständig von Hand gefertigt werden (ich habe keine Maschinen in meiner Werkstatt). Ausgehend von großen Lederhäuten stelle ich jedes Objekt auf einzigartige Weise her, Schritt für Schritt, vom Zuschnitt bis zum Zusammenbau."
    ],
    "en": [
      "I offer a wide range of leather objects made entirely by hand (I have no machines in my workshop). Starting with large leather hides, I make each object uniquely, step by step, from cutting to assembly."
    ],
    "it": [
      "Offro una gamma di oggetti in pelle realizzati interamente a mano (non ho macchine nel mio laboratorio). Partendo da grandi pelli di cuoio, realizzo ogni oggetto in modo unico, passo dopo passo, dal taglio all'assemblaggio."
    ],
    "fr": [
      "Je propose une panoplie d’objets en cuir entièrement réalisés à la main (je n’ai aucune machine dans mon atelier). En partant de grandes peaux de cuir, je fabrique chaque objet de manière unique, étape par étape, de la découpe à l’assemblage."
    ],
    "es": [
      "Ofrezco una gama de objetos de cuero hechos totalmente a mano (no tengo máquinas en mi taller). Partiendo de grandes pieles de cuero, elaboro cada objeto de forma única, paso a paso, desde el corte hasta el montaje."
    ],
    "nl": [
      "Ik bied een reeks leren objecten aan die volledig met de hand zijn gemaakt (ik heb geen machines in mijn werkplaats). Ik begin met grote leren huiden en maak elk object uniek, stap voor stap, van snijden tot in elkaar zetten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maroquine"
    ]
  },
