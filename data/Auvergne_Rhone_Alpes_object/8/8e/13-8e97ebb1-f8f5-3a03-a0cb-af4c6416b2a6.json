  "rdfs:comment": {
    "de": [
      "Die Domaine des Côteaux d'Or wurde von Manon Champalle, einer Schülerin des berühmten Gérard DUCERF, hergestellt und lädt Sie zu einem Spaziergang ein, um die Vielfalt der Pflanzen in unserem Land zu entdecken."
    ],
    "en": [
      "Developed by Manon Champalle, a disciple of the famous Gérard DUCERF, Le Domaine des Côteaux d?Or invites you to take a stroll and discover the diversity of plants found in our terroir."
    ],
    "it": [
      "Ideato da Manon Champalle, discepola del famoso Gérard DUCERF, il Domaine des Côteaux d'Or vi invita a passeggiare e a scoprire la diversità delle piante presenti nel nostro terroir."
    ],
    "fr": [
      "Elaboré par Manon Champalle, disciple du célèbre Gérard DUCERF, Le Domaine des Côteaux d’Or vous propose de faire une ballade afin de découvrir toutes la diversité des plantes présentes sur notre terroir."
    ],
    "nl": [
      "Het Domaine des Côteaux d'Or is ontwikkeld door Manon Champalle, een leerling van de beroemde Gérard DUCERF, en nodigt je uit om een wandeling te maken en de diversiteit van de planten in onze terroir te ontdekken."
    ],
    "es": [
      "Desarrollado por Manon Champalle, discípula del célebre Gérard DUCERF, Le Domaine des Côteaux d'Or le invita a pasear y descubrir la diversidad de plantas de nuestro terruño."
    ]
  },
