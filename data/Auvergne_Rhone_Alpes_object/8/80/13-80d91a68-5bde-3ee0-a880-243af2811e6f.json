  "rdfs:comment": {
    "de": [
      "Freizeitzentrum Étang de Goule: Kurs auf Freizeitaktivitäten im Freien! Der Étang de Goule liegt zwischen Bourges, Montluçon und Nevers am Rande des Tronçais-Waldes und wird von Liebhabern der freien Natur geschätzt."
    ],
    "en": [
      "Etang de Goule leisure park: a focus on outdoor activities! Located between Bourges, Montluçon and Nevers, on the edge of the Tronçais forest, the Etang de Goule is a favorite with lovers of the great outdoors."
    ],
    "it": [
      "Il centro ricreativo dell'Etang de Goule: un'attenzione particolare alle attività all'aria aperta! Situato tra Bourges, Montluçon e Nevers, ai margini della foresta di Tronçais, l'Etang de Goule è uno dei luoghi preferiti dagli amanti della vita all'aria aperta."
    ],
    "fr": [
      "Base de loisirs de l’étang de Goule : cap sur les loisirs de plein air ! Situé entre Bourges, Montluçon et Nevers, en bordure de la forêt de Tronçais, l’étang de Goule est apprécié par les amoureux des grands espaces."
    ],
    "nl": [
      "Vrijetijdscentrum Etang de Goule: focus op buitenactiviteiten! Gelegen tussen Bourges, Montluçon en Nevers, aan de rand van het bos van Tronçais, is het Etang de Goule favoriet bij liefhebbers van het buitenleven."
    ],
    "es": [
      "El centro de ocio Etang de Goule: ¡un foco de actividades al aire libre! Situado entre Bourges, Montluçon y Nevers, al borde del bosque de Tronçais, el Etang de Goule es uno de los lugares preferidos de los amantes de la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Base de loisirs du Village de Goule"
    ]
  },
