  "rdfs:comment": {
    "de": [
      "3* Hotel-Restaurant, 10 Minuten zu Fuß vom Dorfzentrum entfernt. Klimatisierte Zimmer mit Terrasse oder Balkon für 2 bis 5 Personen. Beheizter Pool, Entspannungsbereich mit Sauna und Jacuzzi, Parkplatz und Kinderspielplatz."
    ],
    "en": [
      "3* hotel-restaurant 10 min. walk from village center. Air-conditioned rooms with terrace or balcony for 2 to 5 people. Heated swimming pool, relaxation area with sauna and jacuzzi, parking lot and children's play area."
    ],
    "it": [
      "Hotel Ristorante 3* a 10 minuti a piedi dal centro del paese. Camere climatizzate, con terrazza o balcone, per 2-5 persone. Piscina riscaldata, area relax con sauna e jacuzzi, parcheggio e parco giochi per bambini."
    ],
    "fr": [
      "Hôtel Restaurant 3* à 10 min à pied du centre du village. Chambres climatisées, avec terrasse ou balcon, pour 2 à 5 pers. Piscine chauffée, Espace détente avec sauna et jacuzzi, Parking et Aire de jeux pour enfants."
    ],
    "es": [
      "Hotel Restaurante 3* a 10 minutos a pie del centro del pueblo. Habitaciones con aire acondicionado, con terraza o balcón, para 2 a 5 personas. Piscina climatizada, zona de relax con sauna y jacuzzi, aparcamiento y parque infantil."
    ],
    "nl": [
      "Een 3-sterren hotel-restaurant op 10 min wandelafstand van het centrum van Vallon Pont d'Arc. Geklimatiseerde kamers met terras of balkon, voor 2 tot 5 personen. Verwarmd zwembad, ontspanningsruimte met sauna en bubbelbad, Parking en speeltuin voor de kinderen."
    ]
  },
