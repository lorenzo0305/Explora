  "rdfs:comment": {
    "de": [
      "Ein unvergessliches Sporterlebnis inmitten der grandiosen Landschaften des Bugey. Mit seinen 2.000 Metern Höhenunterschied erreicht dieser Lauf seinen Höhepunkt auf dem Gipfel des Grand Colombier. Machen Sie sich bereit für ein neues Abenteuer zwischen Himmel und Erde im Herzen des wilden Bugey."
    ],
    "en": [
      "An unforgettable sporting experience in the heart of the Bugey region's breathtaking scenery. With its 2,000-meter vertical drop, this race culminates at the summit of the Grand Colombier. Get ready for a new adventure between heaven and earth in the heart of the wild Bugey region."
    ],
    "it": [
      "Un'esperienza sportiva indimenticabile nel cuore dei paesaggi mozzafiato della regione di Bugey. Con i suoi 2.000 metri di dislivello, questa gara culmina sulla cima del Grand Colombier. Preparatevi a una nuova avventura tra cielo e terra nel cuore della selvaggia regione del Bugey."
    ],
    "fr": [
      "Une expérience sportive inoubliable au cœur de paysages grandioses du Bugey. Avec ses 2 000 mètres de dénivelé, cette course culmine au sommet du Grand Colombier. Préparez-vous à une nouvelle aventure entre ciel et terre au cœur du Bugey sauvage."
    ],
    "es": [
      "Una experiencia deportiva inolvidable en el corazón de los impresionantes paisajes de la región de Bugey. Con sus 2.000 metros de desnivel, esta carrera culmina en la cima del Grand Colombier. Prepárese para una nueva aventura entre el cielo y la tierra en el corazón de la salvaje región de Bugey."
    ],
    "nl": [
      "Een onvergetelijke sportieve ervaring in het hart van het adembenemende landschap van de Bugey-streek. Met een hoogteverschil van 2.000 meter bereikt deze race zijn hoogtepunt op de top van de Grand Colombier. Bereid je voor op een nieuw avontuur tussen hemel en aarde in het hart van de wilde Bugeystreek."
    ]
  },
  "rdfs:label": {
