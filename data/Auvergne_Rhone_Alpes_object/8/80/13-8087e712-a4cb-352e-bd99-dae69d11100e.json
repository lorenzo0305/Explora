  "rdfs:comment": {
    "de": [
      "Verein, der sich zum Ziel gesetzt hat, außerschulische Aktivitäten sowie sportliche, kulturelle und festliche Veranstaltungen für die Kinder der SRPSAT zu organisieren... Zur Freude der Kleinen, aber auch der Großen!!!!"
    ],
    "en": [
      "An association whose aim is to organize extra-curricular activities and sports, cultural and festive events for the children of SRPSAT... For the pleasure of young and old alike!!!!"
    ],
    "it": [
      "Lo scopo dell'associazione è quello di organizzare attività extrascolastiche ed eventi sportivi, culturali e festivi per i bambini della SRPSAT... Per il divertimento di grandi e piccini!!!!"
    ],
    "fr": [
      "Association qui a pour but de mettre en place des activités péri-scolaires et manifestations sportives, culturelles et festives pour les enfants du SRPSAT... Pour le plus grand plaisir des petits mais aussi des grands!!!!"
    ],
    "nl": [
      "Het doel van de vereniging is het organiseren van buitenschoolse activiteiten en sportieve, culturele en feestelijke evenementen voor de kinderen van SRPSAT... Voor het plezier van jong en oud !!!!"
    ],
    "es": [
      "El objetivo de la asociación es organizar actividades extraescolares y eventos deportivos, culturales y festivos para los niños de SRPSAT... ¡¡¡¡Para el disfrute de grandes y pequeños !!!!"
    ]
  },
