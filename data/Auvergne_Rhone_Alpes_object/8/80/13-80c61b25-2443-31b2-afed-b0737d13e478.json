  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung. Das Museum zeigt eine großartige Sammlung von Werkzeugen und Gegenständen, die für die Berufe und das lokale, ländliche Leben von früher typisch sind."
    ],
    "en": [
      "Guided tour. The museum presents a magnificent collection of tools and objects specific to the trades and local, rural life of the past."
    ],
    "it": [
      "Visita guidata. Il museo presenta una magnifica collezione di strumenti e oggetti relativi ai mestieri e alla vita locale e rurale del passato."
    ],
    "fr": [
      "Visite guidée. Le musée présente une magnifique collections d'outils et d'objets propres aux métiers et à la vie locale, rurale d'autrefois."
    ],
    "es": [
      "Visita guiada. El museo presenta una magnífica colección de herramientas y objetos relacionados con los oficios y la vida local y rural del pasado."
    ],
    "nl": [
      "Rondleiding. Het museum presenteert een prachtige collectie werktuigen en voorwerpen die betrekking hebben op de ambachten en het plaatselijke, landelijke leven van vroeger."
    ]
  },
