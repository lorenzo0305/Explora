  "rdfs:comment": {
    "de": [
      "L'encart ist das Abenteuer von zwei Kumpels, die sich für Wein und Gastronomie begeistern. L'encart, das sind sie: Julien, in der Küche, und Xavier, im Speisesaal."
    ],
    "en": [
      "L'Encart is an adventure embarked upon by two friends, passionate about wine and good food. L'Encart features Julien in the kitchen and Xavier in the dining room."
    ],
    "it": [
      "L'encart è l'avventura di due amici con la passione per il vino e la gastronomia. L'encart siamo noi: Julien in cucina e Xavier in sala."
    ],
    "fr": [
      "L’encart c’est l’aventure de deux potes, passionnés de vin et de gastronomie. L’encart, c’est eux : Julien, en cuisine et Xavier, en salle."
    ],
    "nl": [
      "L'encart is het avontuur van twee vrienden met een passie voor wijn en gastronomie. Dat zijn Julien in de keuken en Xavier in de eetkamer."
    ],
    "es": [
      "L'encart es la aventura de dos amigos apasionados por el vino y la gastronomía. Son Julien en la cocina y Xavier en el comedor."
    ]
  },
