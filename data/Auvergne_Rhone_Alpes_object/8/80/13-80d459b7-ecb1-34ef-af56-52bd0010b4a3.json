  "rdfs:comment": {
    "de": [
      "Bergziegenzucht und Käseherstellung. Besichtigung des Hofs auf Anfrage."
    ],
    "en": [
      "Breeding of alpine goats and manufacture of cheeses. Farm visits by appointment."
    ],
    "it": [
      "Incontrate le capre di Chazalon! Qui scoprirete un allevamento di capre alpine in armonia con la natura. Visitate la fattoria, accarezzate gli animali e scoprite cosa significa fare l'agricoltore."
    ],
    "fr": [
      "Rencontrez les chèvres de Chazalon ! Ici, on découvre un élevage de chèvres alpines en symphonie avec la nature. Visitez la ferme, caresser les animaux et venez comprendre ce qu'est l'Agriculture."
    ],
    "es": [
      "¡Conozca a las cabras de Chazalon! Aquí descubrirá una granja alpina de cabras en armonía con la naturaleza. Visita la granja, acaricia a los animales y descubre en qué consiste la agricultura."
    ],
    "nl": [
      "Maak kennis met de Chazalon-geiten! Hier ontdek je een alpengeitenboerderij in harmonie met de natuur. Bezoek de boerderij, aai de dieren en ontdek wat het boerenleven inhoudt."
    ]
  },
