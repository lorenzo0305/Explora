          "additionalInformation": {
            "de": [
              "Verkauf auf dem Weingut von 17.00 bis 18.30 Uhr. Verkauf in der Boutique in 8 Rue Saunerie in Feurs (geöffnet Dienstag, Mittwoch, Freitag und Samstagmorgen) und auf dem Markt in Panissières am Samstagmorgen."
            ],
            "en": [
              "On-site sales from 5:00 pm to 6:30 pm. Store sales at 8 Rue Saunerie in Feurs (open Tuesday, Wednesday, Friday and Saturday mornings) and Panissières market on Saturday mornings."
            ],
            "it": [
              "Vendite presso la tenuta dalle 17.00 alle 18.30. Negozio al numero 8 di Rue Saunerie a Feurs (aperto martedì, mercoledì, venerdì e sabato mattina) e mercato di Panissières il sabato mattina."
            ],
            "fr": [
              "Vente à la propriété de 17h00 à 18h30. Vente en boutique au 8 Rue Saunerie à Feurs (ouvert mardi, mercredi, vendredi et samedi matin) et marché de Panissières le samedi matin."
            ],
            "nl": [
              "Verkoop op het landgoed van 17.00 tot 18.30 uur. Winkel op Rue Saunerie 8 in Feurs (open op dinsdag-, woensdag-, vrijdag- en zaterdagochtend) en Panissières markt op zaterdagochtend."
            ],
            "es": [
              "Ventas en la finca de 17.00 a 18.30 h. Tienda en el número 8 de la rue Saunerie de Feurs (abierta los martes, miércoles, viernes y sábados por la mañana) y mercado de Panissières los sábados por la mañana."
            ]
          },
