  "rdfs:comment": {
    "de": [
      "Es liegt auf 1000 m Höhe und hat eine Fläche von 3 Hektar.\r\n3 ha 1000 m. Karpfen, Pommes frites, Forellen.\r\nAngelkarten sind im Hôtel du Lac am Ufer des Gewässers erhältlich (04 73 21 52 19)."
    ],
    "en": [
      "Located at 1000 m of altitude it has an area of 3 hectares.\r\n3 ha 1000 m. Carp, fry, trout.\r\nFishing cards on sale at the Hôtel du Lac at the edge of the lake (04 73 21 52 19)."
    ],
    "it": [
      "Situato a 1000 m di altitudine, ha una superficie di 3 ettari.\r\n3 ha 1000 m. Carpe, avannotti, trote.\r\nCarte di pesca in vendita presso l'Hôtel du Lac in riva al lago (04 73 21 52 19)."
    ],
    "fr": [
      "Situé à 1000 m d’altitude il a une superficie de 3 hectares.\r\n3 ha 1000 m. Carpes, fritures, truites.\r\nCartes de pêche en vente à l'Hôtel du Lac au bord du plan d'eau (04 73 21 52 19)."
    ],
    "es": [
      "Situado a 1000 m de altitud, tiene una superficie de 3 hectáreas.\r\n3 ha 1000 m. Carpas, alevines, truchas.\r\nTarjetas de pesca a la venta en el Hôtel du Lac, a orillas del lago (04 73 21 52 19)."
    ],
    "nl": [
      "Het ligt op 1000 m hoogte en heeft een oppervlakte van 3 hectare.\r\n3 ha 1000 m. Karper, pootvis, forel.\r\nViskaarten te koop bij Hôtel du Lac aan de rand van het meer (04 73 21 52 19)."
    ]
  },
