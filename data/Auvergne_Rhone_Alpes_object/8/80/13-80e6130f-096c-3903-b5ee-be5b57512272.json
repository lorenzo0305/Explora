  "rdfs:comment": {
    "de": [
      "Entdecken Sie regionale, lokale, AOP-, IGP- und Bio-Käse. Honig, Marmelade, Wein, Bier und lokale Wurstwaren werden ebenfalls zum Verkauf angeboten, um Ihren Käse zu begleiten."
    ],
    "en": [
      "Come and discover local, PDO, PGI and organic cheeses. Honey, jam, wine, beer and local charcuterie are also on sale to accompany your cheeses."
    ],
    "it": [
      "Venite a scoprire i formaggi locali, DOP, IGP e biologici. Miele, marmellata, vino, birra e salumi locali sono in vendita per accompagnare i vostri formaggi."
    ],
    "fr": [
      "Venez découvrir des fromages du terroir, locaux, AOP, IGP et bio. Miel, confiture, vin, bière et charcuterie local sont également en vente pour accompagner vos fromages."
    ],
    "es": [
      "Venga a descubrir los quesos locales, DOP, IGP y ecológicos. Miel, mermelada, vino, cerveza y charcutería local también están a la venta para acompañar sus quesos."
    ],
    "nl": [
      "Kom en ontdek lokale, BOB, BGA en biologische kazen. Er is ook honing, jam, wijn, bier en lokale vleeswaren te koop voor bij de kazen."
    ]
  },
  "rdfs:label": {
