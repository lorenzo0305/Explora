  "rdfs:comment": {
    "de": [
      "Entspannung & Relaxation in einem authentischen und beruhigenden Rahmen in Grenoble. Massagen, japanische Schönheitsbehandlungen für Gesicht und Körper, Permanent-Make-up für Augenbrauen, Eyeliner und Lippen, Wimpernverlängerung."
    ],
    "en": [
      "ASIA SPA- propose authentic asian massages and Japanese facials, permanent make up eyebrows, eyeliner and lips, eyelash extension."
    ],
    "it": [
      "Relax in un ambiente autentico e rilassante a Grenoble. Massaggi, trattamenti estetici giapponesi per viso e corpo, trucco permanente per sopracciglia, eyeliner e labbra, estensione delle ciglia."
    ],
    "fr": [
      "Détente & Relaxation dans un cadre authentique et apaisant à Grenoble. Massages, soins esthétiques japonais visage et corps, maquillage permanent sourcils, eyeliner et lèvres, cils extension."
    ],
    "es": [
      "Relajación en un entorno auténtico y relajante en Grenoble. Masajes, tratamientos de belleza japoneses faciales y corporales, maquillaje permanente de cejas, eyeliner y labios, extensiones de pestañas."
    ],
    "nl": [
      "Ontspanning in een authentiek en rustgevend kader in Grenoble. Massages, Japanse schoonheidsbehandelingen voor gezicht en lichaam, permanente make-up voor wenkbrauwen, eyeliner en lippen, wimperextensions."
    ]
  },
