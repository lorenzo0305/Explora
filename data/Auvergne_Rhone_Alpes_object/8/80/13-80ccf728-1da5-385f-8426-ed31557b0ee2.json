  "rdfs:comment": {
    "de": [
      "Animationen und Gokart-Verleih für alle."
    ],
    "en": [
      "Lissartel outdoor karting track close to Lake Saint-Étienne-Cantalès, renowned for its long straight line and its winding and hilly character. Kart accessible from 6 (1.30 m mini), and 390cc from 16. Snacking, bar.\r\nClosed on Mondays & Tuesdays (except school holidays) from 10/01 to 05/31."
    ],
    "it": [
      "Intrattenimento e noleggio go-kart per tutti."
    ],
    "fr": [
      "Animations et location de kartings pour tous."
    ],
    "nl": [
      "Openlucht kartbaan Lissartel bij het meer van Saint-Étienne-Cantalès, bekend om zijn lange rechte lijn en zijn bochtige en heuvelachtige karakter. Kart toegankelijk vanaf 6 jaar (mini van 1,30 m), en 390cc vanaf 16 jaar. Snacking, bar.\r\nGesloten op maandag en dinsdag (behalve schoolvakanties) van 10/01 tot 05/31."
    ],
    "es": [
      "Entretenimiento y alquiler de karts para todos."
    ]
  },
