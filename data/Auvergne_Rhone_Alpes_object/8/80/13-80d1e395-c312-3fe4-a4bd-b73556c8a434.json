  "rdfs:comment": {
    "de": [
      "Frisch renoviert, um Luxus, Modernität und Charme zu vereinen.\r\nDas Experimental Chalet Val d'Isère befindet sich in idealer Lage im Herzen des Dorfes und nur wenige Schritte von den Pisten entfernt."
    ],
    "en": [
      "Freshly renovated to combine luxury, modernity and charm. \r\nThe Experimental Chalet Val d'Isère is ideally located in the heart of the village, just a stone's throw from the slopes."
    ],
    "it": [
      "Appena ristrutturato per combinare lusso, modernità e fascino. \r\nLo Chalet Sperimentale Val d'Isère è situato in posizione ideale nel cuore del villaggio e a due passi dalle piste."
    ],
    "fr": [
      "Fraîchement rénové pour allier luxe, modernité et charme. \r\nL'Experimental Chalet Val d'Isère est idéalement situé au cœur du village et à deux pas des pistes."
    ],
    "es": [
      "Recién renovado para combinar lujo, modernidad y encanto.\r\nEl Chalet Experimental Val d'Isère goza de una ubicación ideal en el corazón del pueblo y a un paso de las pistas."
    ],
    "nl": [
      "Pas gerenoveerd om luxe, moderniteit en charme te combineren.\r\nHet Experimental Chalet Val d'Isère is ideaal gelegen in het hart van het dorp en op een steenworp afstand van de pistes."
    ]
  },
