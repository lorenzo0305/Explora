  "rdfs:comment": {
    "de": [
      "Wir stellen Sauerteigbrot (über Holzfeuer gebacken), Lammfleisch und Kastanienprodukte her (ganze Kastanien, Kastaniencreme, Kastanienmehl...)"
    ],
    "en": [
      "We produce leavened bread (cooked on a wood fire), lamb meat, and chestnut products (whole chestnuts, chestnut cream, chestnut flour...)"
    ],
    "it": [
      "Produciamo pane lievitato (cotto a legna), carne di agnello e prodotti a base di castagne (castagne intere, crema di castagne, farina di castagne, ecc.)"
    ],
    "fr": [
      "Nous produisons du pain au levain (cuit au feu de bois), de la viande d'agneau, et des produits à base de châtaigne (châtaignes entières, crème de châtaigne, farine de châtaigne...)"
    ],
    "nl": [
      "Wij produceren gezuurd brood (gekookt op houtvuur), lamsvlees en kastanjeproducten (hele kastanjes, kastanjecrème, kastanjemeel...)"
    ],
    "es": [
      "Producimos pan con levadura (cocinado a leña), carne de cordero y productos a base de castañas (castañas enteras, crema de castañas, harina de castañas, etc.)"
    ]
  },
