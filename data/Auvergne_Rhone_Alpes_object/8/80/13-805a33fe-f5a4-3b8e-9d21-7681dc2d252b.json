  "rdfs:comment": {
    "de": [
      "Frau Papadopoulou empfängt Sie jeden Freitagmorgen nach Vereinbarung, um Ihnen im Bereich der digitalen Medien zu helfen! Sie können einen Computer bedienen, im Internet surfen, E-Mails verwalten, Apps auf Smartphones installieren und nutzen etc."
    ],
    "en": [
      "Ms Papadopoulou welcomes you every Friday morning by appointment to help you in the digital field! Getting to grips with a computer, surfing the Internet, managing e-mail, installing and using smartphone applications, etc."
    ],
    "it": [
      "La signora Papadopoulou vi accoglie ogni venerdì mattina su appuntamento per aiutarvi a soddisfare le vostre esigenze digitali! Imparare a usare il computer, navigare in Internet, gestire la posta elettronica, installare e utilizzare applicazioni per smartphone, ecc."
    ],
    "fr": [
      "Madame Papadopoulou vous accueille tous les vendredis matin sur rdv pour apporter son aide dans le champs du numérique ! Prendre en main un ordinateur, naviguer sur Internet, gérer ses courriels, installer et utilises des applications sur smartphone etc."
    ],
    "nl": [
      "Mevrouw Papadopoulou ontvangt u elke vrijdagochtend op afspraak om u te helpen met uw digitale behoeften! De computer onder de knie krijgen, surfen op internet, e-mail beheren, smartphone-applicaties installeren en gebruiken, enz."
    ],
    "es": [
      "La Sra. Papadopoulou le recibe todos los viernes por la mañana con cita previa para ayudarle en sus necesidades digitales Familiarizarse con el ordenador, navegar por Internet, gestionar el correo electrónico, instalar y utilizar aplicaciones para smartphone, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conseillère numérique"
    ]
  },
