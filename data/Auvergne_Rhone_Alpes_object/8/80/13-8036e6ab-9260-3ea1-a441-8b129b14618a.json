  "rdfs:comment": {
    "de": [
      "Restaurant mit atemberaubendem Blick auf den Lac d'Aydat.\r\nLa Cocotte Bleue und sein Team heißen Sie den ganzen Tag über für eine gesellige Mahlzeit, eine Schlemmerpause oder eine Erfrischung willkommen."
    ],
    "en": [
      "Restaurant with breathtaking views over Lake Aydat.\r\nLa Cocotte Bleue and its team welcome you for a convivial meal, a gourmet break or a refreshment throughout the day."
    ],
    "it": [
      "Ristorante con vista mozzafiato sul lago Aydat.\r\nLa Cocotte Bleue e il suo team vi accolgono per un pasto conviviale, una pausa gourmet o un rinfresco durante la giornata."
    ],
    "fr": [
      "Restaurant avec vue imprenable sur le lac d'Aydat.\r\nLa Cocotte Bleue et son équipe vous accueillent pour un repas convivial, une pause gourmande ou un rafraîchissement tout au long de la journée."
    ],
    "es": [
      "Restaurante con impresionantes vistas al lago Aydat.\r\nLa Cocotte Bleue y su equipo le dan la bienvenida para una comida de convivencia, una pausa gourmet o un refresco a lo largo del día."
    ],
    "nl": [
      "Restaurant met adembenemend uitzicht over het Aydat meer.\r\nLa Cocotte Bleue en haar team verwelkomen je voor een gezellige maaltijd, een gastronomische pauze of een verfrissing gedurende de dag."
    ]
  },
