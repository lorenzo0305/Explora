  "rdfs:comment": {
    "de": [
      "Genießen Sie einen Moment der Entspannung mit Blick auf den Mont-Blanc. Übernachten Sie in einem der 27 Zimmer mit allem Komfort. Das hauseigene Restaurant serviert eine feine und einfallsreiche Küche. Partner des Golfplatzes von Giez (9 & 18 Löcher), 6 km vom Hotel entfernt."
    ],
    "en": [
      "With great views of Mont-Blanc, just sit back and relax. Stay in one of our 27 comfortable rooms and enjoy the hotel's restaurant that offers refined and creative cuisine. The hotel partners with the 9 and 18 hole golf course in Giez 6km away."
    ],
    "it": [
      "Con il Monte Bianco in vista, godetevi un momento di relax. Soggiornate in una delle 27 camere confortevoli con ristorante in loco che serve una cucina raffinata e inventiva. Partner del campo da golf di Giez (9 e 18 buche) a 6 km dall'hotel."
    ],
    "fr": [
      "Avec le Mont-Blanc en perspective, profitez d'un moment de détente. Demeurez dans l'une des 27 chambres tout confort avec restaurant sur place servant une cuisine fine et inventive. Partenaire du golf de Giez (9 & 18 trous) à  6 km de l'hôtel."
    ],
    "nl": [
      "Met de Mont Blanc in zicht, geniet u van een moment van ontspanning. Verblijf in een van de 27 comfortabele kamers en het restaurant ter plaatse serveert verfijnde en inventieve gerechten. Partner van de golfbaan van Giez (9 & 18 holes) op 6 km van het hotel."
    ],
    "es": [
      "Con el Mont Blanc a la vista, disfrute de un momento de relax. Alójese en una de las 27 confortables habitaciones con un restaurante que sirve cocina fina e inventiva. Socio del campo de golf de Giez (9 y 18 hoyos) a 6 km del hotel."
    ]
  },
  "rdfs:label": {
    "en": [
      "Florimont Hotel"
    ],
