  "rdfs:comment": {
    "de": [
      "Höhenrestaurant in Mottaret Meribel\r\nServiert: Frühstück, Mittagessen und kann Gruppen beherbergen.\r\nDas Lokal ist in zwei Teile gegliedert: eine Snackbar auf der Ebene der Pisten und ein Restaurant auf den beiden oberen Etagen."
    ],
    "en": [
      "Altitude restaurant divised in two businesses: On main floor,  a traditional restaurant offering Breakfast and lunch.\r\n On bottom floor, right on the slopes, a snack specialised in Burger, paninis and soup."
    ],
    "it": [
      "Ristorante d'alta quota a Mottaret Meribel\r\nServe: colazione, pranzo e può ospitare gruppi.\r\nLa struttura è divisa in due parti: uno snack bar sulle piste e un ristorante ai due piani superiori."
    ],
    "fr": [
      "Restaurant d'altitude à  Mottaret Meribel. \r\nSert : Petit Déjeuner, déjeuner et peut accueillir des groupes.\r\nL'établissement est divisé en deux parties: un snack au niveau des pistes et un restaurant sur les deux étages supérieurs."
    ],
    "es": [
      "Restaurante de altura en Mottaret Meribel\r\nSirve: Desayuno, almuerzo y puede acomodar grupos.\r\nEl establecimiento está dividido en dos partes: un snack bar en las pistas y un restaurante en las dos plantas superiores."
    ],
    "nl": [
      "Hooggelegen restaurant in Mottaret Meribel.\r\nServeert: ontbijt, lunch en is geschikt voor groepen.\r\nHet etablissement bestaat uit twee delen: een snackbar op de piste en een restaurant op de twee bovenste verdiepingen."
    ]
  },
