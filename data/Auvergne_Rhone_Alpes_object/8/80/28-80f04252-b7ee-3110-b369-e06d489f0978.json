      "rdfs:comment": {
        "de": [
          "In den Frischefächern finden Sie Obst, Gemüse der Saison von lokalen Produzenten sowie Produkte aus der Region.\nEinfach, schnell und effizient!"
        ],
        "en": [
          "Find at the freshness racks fruits, vegetables of season of the local producers as well as products of the soil.\nSimple, fast and efficient!"
        ],
        "it": [
          "Trovate frutta e verdura fresca di stagione proveniente da produttori locali e prodotti locali negli scaffali della freschezza.\nSemplice, veloce ed efficiente!"
        ],
        "fr": [
          "Retrouvez aux casiers fraîcheurs les fruits, légumes de saison des producteurs locaux ainsi que des produits du terroir.\nSimple, rapide et efficace !"
        ],
        "nl": [
          "Vind vers fruit en groenten in het seizoen van lokale producenten en lokale producten in de vershoudrekken.\nEenvoudig, snel en efficiënt!"
        ],
        "es": [
          "Encuentre frutas y verduras frescas de temporada procedentes de productores locales, así como productos locales en los estantes de frescura.\nSencillo, rápido y eficaz"
        ]
      },
