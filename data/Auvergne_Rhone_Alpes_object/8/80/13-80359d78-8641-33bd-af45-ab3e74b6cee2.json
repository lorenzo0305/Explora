  "rdfs:comment": {
    "de": [
      "Auf dem Grün bitte! Der Golfplatz von Montboucher ist in der Region sehr beliebt. Ohne sich auf den Golfplatz zu begeben, werden Sie einen Spaziergang in diesem Park genießen, in dem man auch zu Mittag essen kann."
    ],
    "en": [
      "On the green, please! The Montboucher golf course is very popular in the region. Without having to play the course, you can enjoy a stroll in the park, where you can also have lunch."
    ],
    "it": [
      "Sul verde per favore! Il campo da golf di Montboucher è molto popolare nella regione. Senza dover giocare il campo, si può fare una passeggiata nel parco, dove si può anche pranzare."
    ],
    "fr": [
      "Sur le Green s’il vous plaît ! Le golf de Montboucher est très prisé dans la Région. Sans vous lancer dans le parcours, vous apprécierez de vous balader dans ce parc, où l’on peut aussi déjeuner."
    ],
    "es": [
      "¡En el verde, por favor! El campo de golf de Montboucher es muy popular en la región. Sin tener que jugar en el campo, podrá disfrutar de un paseo por el parque, donde también podrá almorzar."
    ],
    "nl": [
      "Op de green, alstublieft! De golfbaan van Montboucher is erg populair in de regio. Zonder op de baan te spelen, kun je genieten van een wandeling in het park, waar je ook kunt lunchen."
    ]
  },
