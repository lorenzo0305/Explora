  "rdfs:comment": {
    "de": [
      "Boutique mit regionalen Produkten: Clairette de Die und Crémant de Die, Lavendel, Honig, Pasteten, Kunsthandwerk (Töpferwaren, Leder, Holz, Schmuck ...). Preise für Erzeuger und Handwerker. Verkostung von Clairette de Die und Crémant de Die."
    ],
    "en": [
      "Shop selling local products: Clairette de Die and Crémant de Die sparkling wines, lavender, honey, pâtés, handicrafts (pottery, leather, wood, jewellery...). at producer and craftsmen prices. Clairette de Die and Crémant de Die wine tasting."
    ],
    "it": [
      "Negozio di prodotti regionali: Clairette de Die e Crémant de Die, lavanda, miele, paté, artigianato (ceramica, cuoio, legno, gioielli, ecc.). Prezzi dei produttori e degli artigiani. Degustazione di Clairette de Die e Crémant de Die."
    ],
    "fr": [
      "Boutique de produits régionaux : Clairette de Die et Crémant de Die, lavande, miel, pâtés, artisanat (poteries, cuirs, bois, bijoux ...). Prix producteurs et artisans. Dégustation Clairette de Die et Crémant de Die."
    ],
    "nl": [
      "Winkel met regionale producten: clairette, crémant, lavendel, honing, pâté, ambachtelijk handwerk (potten, leer, hout, sieraden, etc.). Prijzen producenten en ambachtslieden. Proeverij Clairette en Crémant de Die."
    ],
    "es": [
      "Tienda de productos regionales: Clairette de Die y Crémant de Die, lavanda, miel, patés, artesanía (cerámica, cuero, madera, bisutería, etc.). Precios para productores y artesanos. Degustación de Clairette de Die y Crémant de Die."
    ]
  },
