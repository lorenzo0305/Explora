  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die berauschende Welt von Blu Wulú! Dieses einzigartige Kollektiv besteht aus 10 leidenschaftlichen Musikerinnen, von denen jede ihre Kultur und ihren Stil einbringt, um ein unwiderstehliches musikalisches Festmahl zu kreieren. Für alle Altersgruppen."
    ],
    "en": [
      "Immerse yourself in the intoxicating world of Blu Wulú! This unique collective brings together 10 passionate musicians, each bringing her own culture and style to create an irresistible musical feast. All audiences."
    ],
    "it": [
      "Immergetevi nell'inebriante mondo dei Blu Wulú! Questo collettivo unico riunisce 10 musicisti appassionati, ognuno dei quali porta la propria cultura e il proprio stile per creare un'irresistibile festa musicale. Tutti i pubblici."
    ],
    "fr": [
      "Plongez dans l'univers enivrant de Blu Wulú! Ce collectif unique rassemble 10 musiciennes passionné-es, chacun e apportant sa culture et son style pour créer un festin musical irrésistible. Tout public."
    ],
    "es": [
      "¡Sumérjase en el embriagador mundo de Blu Wulú! Este colectivo único reúne a 10 músicos apasionados, cada uno de los cuales aporta su propia cultura y estilo para crear un festín musical irresistible. Para todos los públicos."
    ],
    "nl": [
      "Dompel jezelf onder in de bedwelmende wereld van Blu Wulú! Dit unieke collectief brengt 10 gepassioneerde muzikanten samen, die elk hun eigen cultuur en stijl meebrengen om een onweerstaanbaar muzikaal feest te creëren. Alle doelgroepen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saison culturelle : Blu Wulú, fanfare multiculturelle"
    ]
  },
