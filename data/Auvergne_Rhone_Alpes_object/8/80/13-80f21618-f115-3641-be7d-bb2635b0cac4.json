  "rdfs:comment": {
    "de": [
      "Große Tour, aber große Erinnerungen an dieses Land der g.U., des Geflügels, der Sahne und der Butter aus der Bresse.\r\nDas Land ist hügelig, historisch landwirtschaftlich geprägt und die Landschaft besteht aus einer Reihe von Bergen mit Bauernhöfen, Wiesen oder Anbauflächen, feuchten Tälern und kleinen Wäldern."
    ],
    "en": [
      "A grand tour, but great memories in this land of PDO, poultry, Bresse cream and butter.\r\nA hilly country, historically agricultural, the landscape is a succession of hills topped with farms, meadows or crops, damp valleys and small woods."
    ],
    "it": [
      "Un grande tour, ma grandi ricordi di queste terre di DOP, pollame, panna e burro di Bresse.\r\nRegione collinare, storicamente agricola, il paesaggio è un susseguirsi di colline sormontate da fattorie, prati o coltivazioni, valli umide e piccoli boschi."
    ],
    "fr": [
      "Grand tour, mais grands souvenirs sur ces terres d'AOP, volailles, crème et beurre de Bresse. \r\nPays vallonée, historiquement agricole, le paysage est une succession de monts coiffés de fermes, prés ou cultures, vallons humides, petits bois."
    ],
    "es": [
      "Un gran recorrido, pero grandes recuerdos de estas tierras de DOP, aves de corral, nata y mantequilla de Bresse.\r\nRegión de colinas, históricamente agrícola, el paisaje es una sucesión de colinas coronadas por granjas, prados o cultivos, valles húmedos y pequeños bosques."
    ],
    "nl": [
      "Een grote tour, maar mooie herinneringen aan deze streek van BOB, gevogelte, room en Bresse-boter.\r\nEen heuvelachtige streek, van oudsher agrarisch, het landschap is een aaneenschakeling van heuvels met daarop boerderijen, weiden of gewassen, vochtige valleien en kleine bossen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit Gravel n°27 (black) - Bresse estates"
    ],
    "fr": [
      "Circuit Gravel n°27 (noir) - Les domaines de Bresse"
    ]
  },
