  "rdfs:comment": {
    "de": [
      "Natürliches Reiten auf Pferden und Ponys, Unterricht / Ausritte, Spiele, Shows, Reitkunst: Dressur, Kosakenvoltigieren, Praktika mit Unterkunft (Kinder, Erwachsene, Einführung und Perfektionierung), Empfang von Wanderern, Etappenunterkunft"
    ],
    "ru": [
      "Естественные прогулки на лошадях и пони, уроки/прогулки, игры, шоу, конное искусство: выездка, казачья акробатика, курсы с проживанием (дети, взрослые, начинающие и продвинутые), пешие прогулки, гетто с остановкой."
    ],
    "en": [
      "Natural horse and pony riding, lessons/rides, games, shows, equestrian art: dressage, Cossack acrobatics, training courses with accommodation (children, adults, beginners and advanced), hikers, stopover gîte."
    ],
    "it": [
      "Equitazione naturale e pony, lezioni/corse, giochi, spettacoli, arte equestre: dressage, acrobazie cosacche, corsi con alloggio (bambini, adulti, principianti e avanzati), escursionisti, gîte di sosta."
    ],
    "fr": [
      "Equitation naturelle sans mors : leçons / balades privées (12 ans minimum) , spectacles d'été tout public. Stage dressage, équitation de travail, éthologie appliquée, voltige cosaque (initiation et perfectionnement), accueil de randonneurs, gîte d'étape."
    ],
    "zh": [
      "自然骑马和骑小马、课程/骑马、游戏、表演、马术艺术：盛装舞步、哥萨克杂技、带住宿的课程（儿童、成人、初级和高级）、徒步旅行、中途停留的小木屋。"
    ],
    "nl": [
      "Natuurlijk paard- en ponyrijden, lessen/ritten, spelletjes, shows, ruiterkunst: dressuur, Kozakkenacrobatiek, cursussen met verblijf (kinderen, volwassenen, beginners en gevorderden), wandelaars, tussenstop gîte."
    ],
    "es": [
      "Equitación natural y en poni, clases/ paseos, juegos, espectáculos, arte ecuestre: doma, acrobacia cosaca, cursos con alojamiento (niños, adultos, principiantes y avanzados), excursionistas, casa rural de paso."
    ]
  },
