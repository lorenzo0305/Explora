  "rdfs:comment": {
    "de": [
      "Die Gemeinde Chazemais und ihre Umgebung bilden eine natürliche und historische Region, die von Wanderern, Reitern und Radfahrern, aber auch von Touristen gerne durchstreift wird."
    ],
    "en": [
      "The commune of Chazemais and its surroundings form a natural and historic region that walkers, horse riders and cyclists, as well as tourists, love to explore."
    ],
    "it": [
      "Il comune di Chazemais e i suoi dintorni sono una regione naturale e storica che gli escursionisti, i cavalieri e i ciclisti, così come i turisti, amano esplorare."
    ],
    "fr": [
      "La commune de Chazemais et ses alentours forment une région naturelle et historique que les randonneurs à pied, à cheval ou à vélo, mais aussi les touristes aiment parcourir."
    ],
    "es": [
      "El municipio de Chazemais y sus alrededores es una región natural e histórica que gusta explorar a senderistas, jinetes y ciclistas, así como a turistas."
    ],
    "nl": [
      "De gemeente Chazemais en omgeving is een natuurlijke en historische streek die wandelaars, ruiters, fietsers en toeristen graag verkennen."
    ]
  },
  "rdfs:label": {
