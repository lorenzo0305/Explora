  "rdfs:comment": {
    "de": [
      "Bar, Brasserie in idealer Lage am Quai Farconnet.  Traditionelle Restauration nur mittags von Montag bis Samstag. Brett zum Teilen von Mittwoch- bis Samstagabend 18h/22h."
    ],
    "en": [
      "Bar, Brasserie situated on the \"quai Farconnet\". traditional french food, from tuesday to saturday for lunch only. Fridays and Saturdays evening also."
    ],
    "it": [
      "Bar, Brasserie situato in posizione ideale sul molo di Farconnet.  Ristorazione tradizionale solo a pranzo dal lunedì al sabato. Consiglio da condividere da mercoledì a sabato sera 18.00/22.00"
    ],
    "fr": [
      "Bar, Brasserie idéalement situé sur le quai Farconnet.  Restauration traditionnelle uniquement les services de midi du lundi au samedi. Planche à partager  du mercredi au samedi soir 18h/22h"
    ],
    "nl": [
      "Bar, Brasserie, ideaal gelegen aan de Quai Farconnet.  Traditionele catering alleen 's middags van maandag tot zaterdag. Maaltijdregime van woensdag- tot zaterdagavond 18u/22u"
    ],
    "es": [
      "Bar, Brasserie idealmente situado en el muelle de Farconnet.  Catering tradicional sólo a la hora de comer de lunes a sábado. Tablero a compartir de miércoles a sábado por la tarde 18:00/22:00"
    ]
  },
