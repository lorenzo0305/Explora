  "rdfs:comment": {
    "de": [
      "Die festliche Atmosphäre einer Grenzstadt in den Bergen zur Zeit des Anschlusses von Savoyen an Frankreich und des Durchstichs des ersten Eisenbahntunnels, begleitet von den Klängen mechanischer Pianos."
    ],
    "en": [
      "The festive atmosphere of a mountain border town at the time of the attachment of Savoy to France and the drilling of the first railway tunnel, the sound of mechanical pianos."
    ],
    "it": [
      "L'atmosfera festosa di una città di confine di montagna al momento dell'attaccamento di Savoia alla Francia e la perforazione del primo tunnel ferroviario, il suono dei pianoforti meccanici."
    ],
    "fr": [
      "L’ambiance festive d’une ville frontière de montagne au moment du rattachement de la Savoie à la France et du percement du premier tunnel ferroviaire, au son des pianos mécaniques."
    ],
    "es": [
      "El ambiente festivo de una ciudad fronteriza de montaña en la época de la anexión de Saboya a Francia y la excavación del primer túnel ferroviario, al son de los pianos mecánicos."
    ],
    "nl": [
      "De feestelijke sfeer van een bergdorpje toen Savoye zich bij Frankrijk voegde en de eerste spoortunnel werd geopend, op het geluid van mechanische piano's."
    ]
  },
