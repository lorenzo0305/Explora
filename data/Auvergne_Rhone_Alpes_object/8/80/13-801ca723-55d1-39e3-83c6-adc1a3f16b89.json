  "rdfs:comment": {
    "de": [
      "Le Domaine de la Croix Rochefort liegt im Norden des Beaujolais, 40 Minuten von Lyon entfernt, und öffnet Ihnen seine Türen.\r\nWir stellen Ihnen zwei Säle von je 600 m2 zur Verfügung, die 300 Sitzplätze oder 600 Stehplätze bieten."
    ],
    "en": [
      "Situated in the north of the Beaujolais region, 40 minutes from Lyon, the Domaine de la Croix Rochefort opens its doors to you.\r\nWe have two 600m2 rooms, each of which can accommodate 300 people seated or 600 standing."
    ],
    "it": [
      "Situato nel nord della regione del Beaujolais, a 40 minuti da Lione, il Domaine de la Croix Rochefort vi apre le sue porte.\r\nVi offriamo due sale di 600 m2 ciascuna, che possono ospitare 300 persone sedute o 600 persone in piedi."
    ],
    "fr": [
      "Situé au Nord du Beaujolais, à 40 minutes de Lyon, Le Domaine de la Croix Rochefort vous ouvre ses portes.\r\nNous mettons à votre disposition deux salles de 600m2 chacune, pouvant accueillir 300 personnes assises ou 600 personnes debout."
    ],
    "es": [
      "Situado en el norte de la región del Beaujolais, a 40 minutos de Lyon, el Domaine de la Croix Rochefort le abre sus puertas.\r\nLe ofrecemos dos salas de 600 m2 cada una, que pueden acoger a 300 personas sentadas o 600 de pie."
    ],
    "nl": [
      "In het noorden van de Beaujolais, op 40 minuten van Lyon, opent het Domaine de la Croix Rochefort zijn deuren voor u.\r\nWij bieden u twee zalen van elk 600m2, die plaats bieden aan 300 personen zittend of 600 personen staand."
    ]
  },
