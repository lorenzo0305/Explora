  "rdfs:comment": {
    "de": [
      "250 Profi- und 350 Amateurfahrer werden auf speziell angelegten Strecken im Bikepark von Morillon sowie auf außergewöhnlichen Strecken durch die charmanten Dörfer La Rivière-Enverse und Samoëns gegeneinander antreten."
    ],
    "en": [
      "250 professional riders and 350 amateurs will compete on specially designed courses in the heart of the Morillon Bike Park, as well as on exceptional routes through the charming villages of La Rivière-Enverse and Samoëns."
    ],
    "it": [
      "250 ciclisti professionisti e 350 dilettanti si sfideranno su percorsi appositamente allestiti nel cuore del Morillon Bike Park, oltre che su percorsi eccezionali attraverso gli incantevoli villaggi di La Rivière-Enverse e Samoëns."
    ],
    "fr": [
      "250 coureurs professionnels et 350 amateurs s’affronteront sur des parcours spécialement aménagés au cœur du Bike Park de Morillon, ainsi que sur des tracés exceptionnels traversant les charmants villages de La Rivière-Enverse et Samoëns."
    ],
    "nl": [
      "250 professionele renners en 350 amateurs zullen het tegen elkaar opnemen op speciaal aangelegde parcoursen in het hart van het Morillon Bike Park, maar ook op uitzonderlijke routes door de charmante dorpjes La Rivière-Enverse en Samoëns."
    ],
    "es": [
      "250 ciclistas profesionales y 350 aficionados competirán en recorridos especialmente trazados en el corazón del Morillon Bike Park, así como en rutas excepcionales a través de los encantadores pueblos de La Rivière-Enverse y Samoëns."
    ]
  },
  "rdfs:label": {
    "en": [
      "UCI Enduro World Cup"
    ],
    "fr": [
      "UCI Enduro World Cup"
    ]
  },
