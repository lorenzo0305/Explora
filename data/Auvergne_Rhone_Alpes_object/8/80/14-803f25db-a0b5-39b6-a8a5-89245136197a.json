      "@id": "https://data.datatourisme.fr/e2c63d92-d356-3876-ad94-23e9be8a7503",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag von 7:30 - 19:00 Uhr.\n\nSonntags geschlossen.\n \n Bestellungen :\n\nKontaktieren Sie den Laden telefonisch unter 03 21 48 35 12 für weitere Informationen\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday 7.30am - 7pm.\n\nClosed on Sundays.\n \n To order :\n\nContact the store by phone on 03 21 48 35 12 for more information\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al sabato dalle 7.30 alle 19.00.\n\nChiuso la domenica.\n \n Per ordinare :\n\nContattare il negozio telefonicamente al numero 03 21 48 35 12 per maggiori informazioni\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture: \n\nDu lundi au samedi de 7h30 - 19h.\n\nFermeture le dimanche.\n \n Commandes :\n\nContacter le magasin par téléphone au 03 21 48 35 12 pour plus d'informations\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag t/m zaterdag 7.30 - 19.00 uur.\n\nGesloten op zondag.\n \n Om te bestellen :\n\nNeem telefonisch contact op met de winkel op 03 21 48 35 12 voor meer informatie\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado, de 7.30 a 19.00 h.\n\nDomingos cerrado.\n \n Para hacer un pedido :\n\nPóngase en contacto con la tienda por teléfono en el 03 21 48 35 12 para más información\n\n\n "
        ]
      },
