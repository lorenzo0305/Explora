  "rdfs:comment": {
    "de": [
      "Ein beheiztes, ganzjährig geöffnetes Hauptbecken mit einem Wellnessbereich mit Jacuzzi, Massagedüsen und Gegenschwimmanlage. Ein Splash-Pad für Kinder rundet das Angebot für Familien ab. Im Sommer wird ein zweites beheiztes Becken zur Verfügung stehen."
    ],
    "en": [
      "A main heated pool open all year round, including a wellness area with jacuzzi, massage jets and counter-current swimming. A splash pad dedicated to children completes the family offering. A second heated pool will be available in summer."
    ],
    "it": [
      "Una piscina principale riscaldata e aperta tutto l'anno, che include un'area benessere con idromassaggio, getti massaggianti e nuoto controcorrente. Uno splash pad dedicato ai bambini completa l'offerta per le famiglie. Una seconda piscina riscaldata sarà accessibile in estate."
    ],
    "fr": [
      "Un bassin principal chauffé et ouvert toute l’année, incluant un espace bien-être avec jacuzzi, jets massants et nage à contre-courant. Un splash pad dédié aux enfants complète l’offre familiale. Un second bassin chauffé sera accessible l’été."
    ],
    "es": [
      "Una piscina principal climatizada abierta todo el año, que incluye una zona de bienestar con jacuzzi, chorros de masaje y natación contracorriente. Un chapoteadero para niños completa las instalaciones familiares. En verano habrá una segunda piscina climatizada."
    ],
    "nl": [
      "Een verwarmd hoofdzwembad dat het hele jaar door geopend is, inclusief een wellnessgedeelte met jacuzzi, massagestralen en zwemmen in tegenstroom. Een plonsbad voor kinderen maakt de gezinsfaciliteiten compleet. Een tweede verwarmd zwembad zal beschikbaar zijn in de zomer."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les 2 Alpes Swimming pool"
    ],
    "it": [
      "Piscina di Les 2 Alpes"
    ],
    "fr": [
      "Piscine des 2 Alpes"
    ]
  },
