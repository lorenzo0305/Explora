  "rdfs:comment": {
    "de": [
      "In einem freundlichen und herzlichen Rahmen werden ungewöhnliche und immer originelle Hochzeiten organisiert. Pansette de Gerzat, Blätterteigpastete aus dem Unterholz, Jakobsmuscheln und Polenta auf auvergnatische Art, Pastilla mit Äpfeln und Mandeln."
    ],
    "en": [
      "In a friendly and warm setting, unusual and always original marriages. Pansette of Gerzat, puff pastry of undergrowth, scallops and polenta with the auvergnate, pastilla with apples and almonds."
    ],
    "it": [
      "In un ambiente caldo e accogliente, combinazioni insolite e sempre originali. Pansette de Gerzat, pasta sfoglia del bosco, capesante e polenta à l'auvergnate, pastilla di mele e mandorle."
    ],
    "fr": [
      "Dans un cadre convivial et chaleureux, mariages insolites et toujours originaux. Pansette de Gerzat, feuilleté de sous bois, st jacques et polenta à l' auvergnate, pastilla aux pommes et amandes."
    ],
    "nl": [
      "In een warm en vriendelijk kader, ongewone en altijd originele combinaties. Pansette de Gerzat, bladerdeeg uit het bos, coquilles en polenta à l'auvergnate, appel- en amandelpasta."
    ],
    "es": [
      "En un ambiente cálido y acogedor, combinaciones insólitas y siempre originales. Pansette de Gerzat, hojaldre del bosque, vieiras y polenta à l'auvergnate, pastilla de manzana y almendra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Rainette"
    ]
  },
