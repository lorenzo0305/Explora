  "rdfs:comment": {
    "de": [
      "Eine schöne Weinkarte und wertvolle Tipps für eine Weinprobe, nur wenige Schritte von der Kathedrale entfernt!\n28 Gedecke + 8 auf der Terrasse / Haustiere erlaubt)"
    ],
    "en": [
      "A fine wine list and invaluable advice for a great tasting experience just a stone's throw from the cathedral!\n28 covers + 8 on terrace / pets welcome)"
    ],
    "it": [
      "Un'ottima carta dei vini e preziosi consigli per una grande esperienza di degustazione a due passi dalla cattedrale!\n28 coperti + 8 in terrazza / animali ammessi)"
    ],
    "fr": [
      "Une belle carte de vins et de précieux conseils pour une chouette dégustation à deux pas de la cathédrale !\n28 couverts + 8 en terrasse / animaux acceptés)"
    ],
    "es": [
      "Una excelente carta de vinos y valiosos consejos para una degustación inolvidable a dos pasos de la catedral\n28 cubiertos + 8 en la terraza / se admiten animales)"
    ],
    "nl": [
      "Een fijne wijnkaart en advies van onschatbare waarde voor een geweldige proefervaring op een steenworp afstand van de kathedraal!\n28 couverts + 8 op het terras / huisdieren toegestaan)"
    ]
  },
