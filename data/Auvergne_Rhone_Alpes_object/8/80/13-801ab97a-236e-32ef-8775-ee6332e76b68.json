  "rdfs:comment": {
    "de": [
      "Am Ufer des beeindruckenden Lac du Bourget, dem größten natürlichen See Frankreichs, am Fuße des Mont Revard und gegenüber dem Katzenzahn genießt das Hotel Adelphia mit seinem integrierten Balneotherapiezentrum eine außergewöhnliche Lage."
    ],
    "en": [
      "On the shores of the impressive Lac du Bourget, the largest natural lake in France, at the foot of Mont Revard and opposite the Dent du Chat, the Adelphia Hotel and its integrated balneotherapy centre enjoy an exceptional location."
    ],
    "it": [
      "Sul bordo dell'impressionante Lago del Bourget, il più grande lago naturale della Francia, ai piedi del Monte Revard e di fronte alla Dent du Chat, l'hotel Adelphia e il suo centro di balneoterapia integrato godono di una posizione eccezionale."
    ],
    "fr": [
      "Au bord de l'impressionnant Lac du Bourget le plus grand lac naturel de France, au pied du Mont Revard et face à la dent du chat, l'hôtel Adelphia et son centre de balnéothérapie intégré bénéficient d'une situation exceptionnelle."
    ],
    "nl": [
      "Aan de oevers van het indrukwekkende Lac du Bourget, het grootste natuurlijke meer van Frankrijk, aan de voet van de Mont Revard en tegenover de Dent du Chat, geniet het hotel Adelphia en zijn geïntegreerde balneotherapiecentrum van een uitzonderlijke ligging."
    ],
    "es": [
      "A orillas del impresionante Lac du Bourget, el mayor lago natural de Francia, al pie del Mont Revard y frente a la Dent du Chat, el hotel Adelphia y su centro de balneoterapia integrado gozan de una ubicación excepcional."
    ]
  },
