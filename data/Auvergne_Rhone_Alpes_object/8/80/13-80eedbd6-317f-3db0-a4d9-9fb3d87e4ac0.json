  "rdfs:comment": {
    "de": [
      "Das Atelier bietet ganzjährig Zeichen- und Malkurse sowie Praktika an. Die angebotenen Techniken sind Pastell, Zeichnung, Acryl, Öl und Aquarell."
    ],
    "en": [
      "The studio offers drawing and painting courses throughout the year, as well as workshops. Techniques include pastel, drawing, acrylic, oil and watercolor."
    ],
    "it": [
      "Lo studio offre lezioni di disegno e pittura tutto l'anno, oltre a corsi. Le tecniche comprendono pastello, disegno, acrilico, olio e acquerello."
    ],
    "fr": [
      "L'atelier propose des cours de dessin et de peinture à l'année ainsi que des stages. Les techniques proposées sont le pastel, dessin, acrylique, huile et aquarelle."
    ],
    "es": [
      "El estudio ofrece clases de dibujo y pintura durante todo el año, así como cursos. Las técnicas incluyen pastel, dibujo, acrílico, óleo y acuarela."
    ],
    "nl": [
      "De studio biedt het hele jaar door teken- en schilderlessen en cursussen. Technieken zijn onder andere pastel, tekenen, acryl, olieverf en aquarel."
    ]
  },
