  "rdfs:comment": {
    "de": [
      "Fotograf, Videokünstler, Webmaster. Ich mache Reportagen und Aufnahmen für Tourismus, Veranstaltungen und Produkte. Ich verkaufe Landschaftsfotos aus dem Trièves und seinen Dörfern und biete Schulungen für alle an."
    ],
    "en": [
      "Photographer for individuals and companies. I produce reports and photos for tourism, events and products. I sell landscape photos of the Trièves and its villages and offer training courses for everyone."
    ],
    "it": [
      "Fotografo, videografo e webmaster, produco reportage e foto per il turismo, gli eventi e i prodotti. Vendo foto di paesaggi del Trièves e dei suoi villaggi e offro corsi di formazione per tutti."
    ],
    "fr": [
      "Photographe, vidéaste, webmaster, je réalise des reportages et des prises de vues pour le tourisme, l'évènementiel, les produits. Je vends des photos de paysages du Trièves et ses villages et propose des formations pour tous."
    ],
    "nl": [
      "Fotograaf, videograaf en webmaster, ik maak reportages en foto's voor toerisme, evenementen en producten. Ik verkoop landschapsfoto's van de Trièves en zijn dorpen en bied cursussen aan voor iedereen."
    ],
    "es": [
      "Fotógrafo, videógrafo y webmaster, realizo reportajes y fotos para turismo, eventos y productos. Vendo fotos de paisajes de Trièves y sus pueblos y ofrezco cursos de formación para todo el mundo."
    ]
  },
