  "rdfs:comment": {
    "de": [
      "Begegnen Sie unseren Eselinnen Pivoine und Tulipe auf einem begleiteten Spaziergang. Kleine Entdeckungswanderung mit 30-minütiger oder 2-stündiger Route, Picknickwanderung für den ganzen Tag."
    ],
    "en": [
      "Come and meet our donkeys Pivoine and Tulipe for an accompanied walk. Short discovery walks with a 30-minute or 2-hour itinerary, or day-long picnics."
    ],
    "it": [
      "Venite a conoscere i nostri asini Pivoine e Tulipe per una passeggiata accompagnata. Brevi passeggiate di scoperta con un itinerario di 30 minuti o 2 ore, o passeggiate di un giorno con picnic."
    ],
    "fr": [
      "Venez à la rencontre de nos ânesses Pivoine et Tulipe pour une balade accompagnée. Petite balade découverte avec itinéraire de 30 mn ou de 2h, randonnée pique-nique à la journée."
    ],
    "es": [
      "Venga a conocer a nuestros burros Pivoine y Tulipe en un paseo acompañado. Paseos cortos de descubrimiento con un itinerario de 30 minutos o 2 horas, o paseos de picnic de un día."
    ],
    "nl": [
      "Maak kennis met onze ezels Pivoine en Tulipe voor een wandeling onder begeleiding. Korte ontdekkingswandelingen van 30 minuten of 2 uur, of picknickwandelingen van een dag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée avec les ânes"
    ]
  },
