  "rdfs:comment": {
    "de": [
      "Die im Herzen der Stadt gelegene La Vence Scène ist ganz der Kultur gewidmet. Sie erfüllt die Erwartungen der Einwohner von Saint-Egrévois und ihrer Nachbarn in Bezug auf Kino und darstellende Künste."
    ],
    "en": [
      "In the centre of the city, in the Pont de Vence neighbourhood, La Vence Scène is entirely dedicated to culture. It matches the expectations of the Saint-Egrève's inhabitants and of their neighbours, in terms of cinema and living arts."
    ],
    "it": [
      "Situata nel cuore della città, La Vence Scène è interamente dedicata alla cultura. Soddisfa le aspettative degli abitanti di Saint-Egrévois e dei loro vicini in termini di cinema e arti dello spettacolo."
    ],
    "fr": [
      "Située au cœur de la ville,  La Vence Scène est entièrement dédiée à la culture. Elle répond aux attentes des Saint-Egrévois et de leurs voisins en matière de cinéma et d'arts vivants."
    ],
    "es": [
      "Situada en el corazón de la ciudad, La Vence Scène está totalmente dedicada a la cultura. Responde a las necesidades de los habitantes de Saint-Egrévois y sus vecinos en materia de cine y artes escénicas."
    ],
    "nl": [
      "La Vence Scène, gelegen in het hart van de stad, is geheel gewijd aan cultuur. Het beantwoordt aan de verwachtingen van de inwoners van Saint-Egrévois en hun buren op het gebied van film en podiumkunsten."
    ]
  },
