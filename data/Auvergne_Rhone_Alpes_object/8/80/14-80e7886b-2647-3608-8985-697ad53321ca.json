  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/522ee73f-35e3-312d-b882-73bdef058709",
      "dc:description": {
        "de": [
          "Das RPI von Créquy, Lebiez, Rimboval, Royon und Torcy organisiert am Samstag, den 8. März ab 19 Uhr im Festsaal von Créquy ein spezielles Karnevalsessen. Weitere Informationen finden Sie auf dem Plakat"
        ],
        "en": [
          "The RPI of Créquy, Lebiez, Rimboval, Royon and Torcy is organizing a special carnival meal starting at 7pm on Saturday March 8 at the Créquy village hall. For more information, see the poster"
        ],
        "it": [
          "La RPI di Créquy, Lebiez, Rimboval, Royon e Torcy organizza un pranzo di carnevale speciale, sabato 8 marzo, a partire dalle 19.00, presso la sala del villaggio di Créquy. Per maggiori informazioni, consultare la locandina"
        ],
        "fr": [
          "Le RPI de Créquy, Lebiez, Rimboval, Royon et de Torcy organise un repas spécial carnaval à partir de 19h le samedi 8 mars à la salle des fêtes de Créquy. pour plus d'informations, voir l'affiche"
        ],
        "es": [
          "El RPI de Créquy, Lebiez, Rimboval, Royon y Torcy organiza una comida especial de carnaval a partir de las 19.00 horas del sábado 8 de marzo en el ayuntamiento de Créquy. Para más información, consulte el cartel"
        ],
        "nl": [
          "De RPI van Créquy, Lebiez, Rimboval, Royon en Torcy organiseert op zaterdag 8 maart vanaf 19.00 uur een speciale carnavalsmaaltijd in het dorpshuis van Créquy. Zie voor meer informatie de poster"
        ]
      },
