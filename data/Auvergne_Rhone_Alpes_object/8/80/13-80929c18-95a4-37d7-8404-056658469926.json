  "rdfs:comment": {
    "de": [
      "DIE Bibliothek von Margencel bietet Ihnen das ganze Jahr über Bücher, Zeitschriften und CDs sowie verschiedene Veranstaltungen.\r\nWenn die Bibliothek geschlossen ist, steht Ihnen eine Bücherrückgabebox zur Verfügung."
    ],
    "en": [
      "Margencel's library offers books, magazines and CDs as well as various activities throughout the year.\r\nA \"book return\" box is at your disposal to return your books when the library is closed."
    ],
    "it": [
      "La biblioteca di Margencel offre libri, riviste e CD, oltre a varie attività durante l'anno.\r\nÈ a disposizione una cassetta per la restituzione dei libri quando la biblioteca è chiusa."
    ],
    "fr": [
      "LA bibliothèque de Margencel vous propose livres, magazines et cd ainsi que diverses animations tout au long de l'année.\r\nUne boite \"retour de livres\" est à votre disposition pour rendre vos livres lorsque la bibliothèque est fermée."
    ],
    "es": [
      "La biblioteca de Margencel ofrece libros, revistas y CDs, así como diversas actividades a lo largo del año.\r\nUn buzón de \"devolución de libros\" está a su disposición para devolver sus libros cuando la biblioteca está cerrada."
    ],
    "nl": [
      "De bibliotheek van Margencel biedt boeken, tijdschriften en cd's en het hele jaar door diverse activiteiten.\r\nU kunt uw boeken terugbrengen als de bibliotheek gesloten is."
    ]
  },
  "rdfs:label": {
