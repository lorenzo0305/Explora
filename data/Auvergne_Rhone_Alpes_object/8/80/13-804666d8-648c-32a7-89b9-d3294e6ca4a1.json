  "rdfs:comment": {
    "de": [
      "La Dame des Vins bietet Ihnen und Ihren Lieben individuelle Weinproben-Workshops bei Ihnen zu Hause an.\r\nIch biete auch Beratung und die Organisation Ihrer Veranstaltungen an.\r\nMeine Dienstleistungen stehen auch Unternehmen zur Verfügung."
    ],
    "en": [
      "La Dame des Vins offers personalized tasting workshops, at home, with your loved ones.\r\nI also provide advice and organization of your events.\r\nMy services are also available for businesses."
    ],
    "it": [
      "La Dame des Vins offre laboratori di degustazione personalizzati, a casa vostra, con i vostri amici e familiari.\r\nPosso anche fornire consulenza e organizzare i vostri eventi.\r\nI miei servizi sono disponibili anche per le aziende."
    ],
    "fr": [
      "La Dame des Vins vous propose des ateliers dégustation personnalisés, à domicile, avec vos proches.\r\nJ'assure également des conseils et l'organisation de vos évènements.\r\nMes services sont aussi disponibles pour les entreprises."
    ],
    "es": [
      "La Dame des Vins ofrece talleres de cata de vinos personalizados, en su casa, con sus amigos y familiares.\r\nTambién puedo asesorarle y organizar sus eventos.\r\nMis servicios también están a disposición de las empresas."
    ],
    "nl": [
      "La Dame des Vins biedt gepersonaliseerde workshops wijnproeven, bij jou thuis, met je vrienden en familie.\r\nIk kan ook advies geven en uw evenementen organiseren.\r\nMijn diensten zijn ook beschikbaar voor bedrijven."
    ]
  },
