  "rdfs:comment": {
    "de": [
      "Tägliches Angeln am Tyx-Teich, 67 ha, in Puy-de-Dôme.\r\nGanz in der Nähe des GR4 in Puy-de-Dôme öffnet der Tyx-Teich zwischen Giat und Saint-Avit (63) einen Teil seiner Ufer für den Angeltourismus im Teich."
    ],
    "en": [
      "Daily fishing at the Tyx pond, 67 ha, in Puy-de-Dôme.\r\nVery close to the GR4 in Puy-de-Dôme, the Tyx pond located between Giat and Saint-Avit (63) opens part of its banks for pond fishing tourism."
    ],
    "it": [
      "Pesca giornaliera all'Etang de Tyx, 67 ettari, nel Puy-de-Dôme.\r\nAppena fuori dal GR4, nel Puy-de-Dôme, l'Etang de Tyx, tra Giat e Saint-Avit (63), apre parte delle sue sponde ai turisti della pesca in laghetto."
    ],
    "fr": [
      "Pêche journalière à l'étang de Tyx, 67 ha, dans le Puy-de-Dôme.\r\nTout près du GR4 dans le Puy-de-Dôme, l’étang de Tyx situé entre Giat et Saint-Avit (63) ouvre une partie de ses berges pour le tourisme de pêche en étang."
    ],
    "es": [
      "Pesca diaria en el Etang de Tyx, 67 ha, en el Puy-de-Dôme.\r\nJusto al lado del GR4, en el Puy-de-Dôme, el Etang de Tyx, entre Giat y Saint-Avit (63), abre parte de sus orillas a los turistas que practican la pesca en estanque."
    ],
    "nl": [
      "Dagelijks vissen in het Etang de Tyx, 67 ha, in de Puy-de-Dôme.\r\nNet buiten de GR4 in de Puy-de-Dôme stelt het Etang de Tyx tussen Giat en Saint-Avit (63) een deel van zijn oevers open voor vijvervistoeristen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Teich von Tyx"
    ],
    "en": [
      "Fishing site - Étang de Tyx"
    ],
    "fr": [
      "Site de pêche - Étang de Tyx"
    ]
  },
