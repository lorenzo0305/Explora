  "rdfs:comment": {
    "de": [
      "3 Minuten zu Fuß vom Platz der Basilika entfernt empfängt Sie das Saint-Mary in seinem Speisesaal in einer freundlichen Atmosphäre."
    ],
    "en": [
      "Only 3 minutes on foot from Place Pompidou (Notre-Dame des Miracles Basilica), the hotel and restaurant Saint-Mary welcomes you in a cosy and convivial atmosphere."
    ],
    "it": [
      "A soli 3 minuti a piedi dalla piazza della Basilica, il Saint-Mary vi accoglie nel suo ristorante in un'atmosfera amichevole."
    ],
    "fr": [
      "A 3 mn à pied de la place de la basilique, le Saint-Mary vous accueille dans sa salle de restaurant dans une ambiance conviviale."
    ],
    "nl": [
      "Op slechts 3 minuten lopen van het Basiliekplein ontvangt de Saint-Mary u in zijn restaurant in een vriendelijke sfeer."
    ],
    "es": [
      "A 3 minutos a pie de la plaza de la Basílica, el Saint-Mary le acoge en su restaurante en un ambiente acogedor."
    ]
