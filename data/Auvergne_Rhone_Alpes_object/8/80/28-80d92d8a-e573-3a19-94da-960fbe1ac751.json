  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Pub-Atmosphäre, in der Sie eine große Auswahl an Biersorten probieren können! Erleben Sie Sportveranstaltungen, die auf Großbildschirmen übertragen werden, oder Konzerte, die am Wochenende stattfinden"
    ],
    "en": [
      "Come and discover the \"Pub\" atmosphere where you can taste a wide choice of beers! Share good moments around sports events broadcast on giant screen or in front of the various concerts offered during the weekend!"
    ],
    "it": [
      "Venite a scoprire l'atmosfera da \"Pub\" dove potrete degustare una vasta gamma di birre! Condividete i momenti migliori intorno agli eventi sportivi trasmessi su uno schermo gigante o davanti ai vari concerti proposti durante il fine settimana!"
    ],
    "fr": [
      "Venez découvrir l’ambiance « Pub » où vous pourrez déguster un large choix de bières! Partagez de bons moments autour d’évènements sportifs retransmis sur écran géant ou devant les divers concerts proposés le week-end !"
    ],
    "es": [
      "Venga a descubrir el ambiente de \"Pub\" donde podrá degustar una amplia gama de cervezas Comparta buenos momentos en torno a los eventos deportivos retransmitidos en pantalla gigante o frente a los diversos conciertos que se ofrecen durante el fin de semana"
    ],
    "nl": [
      "Kom en ontdek de \"Pub\" sfeer waar u een breed scala aan bieren kunt proeven! Deel goede tijden rond sportevenementen die worden uitgezonden op een reuzenscherm of voor de verschillende concerten die tijdens het weekend worden aangeboden!"
    ]
  },
