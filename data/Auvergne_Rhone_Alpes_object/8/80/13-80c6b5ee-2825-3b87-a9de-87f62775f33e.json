  "rdfs:comment": {
    "de": [
      "Mehrzweckraum im Zentrum des Dorfes, Fliesenboden, französische Decke mit sichtbaren Balken, begrenzt auf 120 Personen. Lärmbeschränkung ab 2 Uhr morgens, um die Nachbarschaft zu schützen."
    ],
    "en": [
      "Multi-purpose hall in village center, tiled floor, French ceiling with exposed beams, limited to 120 people. Noise limit from 2 a.m. to protect the neighborhood."
    ],
    "it": [
      "Sala polivalente situata nel centro del paese, pavimento in piastrelle, soffitto alla francese con travi a vista, capienza massima 120 persone. Limitazione del rumore a partire dalle 2 del mattino per proteggere il quartiere."
    ],
    "fr": [
      "Salle polyvalente située au centre du village, carrelage au sol, plafond à la française avec poutres apparentes, limitée à 120 personnes. Limitation sonore à partir de 2 heures du matin pour préserver le voisinage."
    ],
    "es": [
      "Sala polivalente situada en el centro del pueblo, suelo de baldosas, techo francés con vigas a la vista, limitada a 120 personas. Limitación del ruido a partir de las 2 de la madrugada para proteger al vecindario."
    ],
    "nl": [
      "Multifunctionele zaal in het centrum van het dorp, tegelvloer, Frans plafond met zichtbare balken, beperkt tot 120 personen. Geluidsbeperking vanaf 2 uur 's nachts om de buurt te beschermen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle polyvalente"
    ]
  },
