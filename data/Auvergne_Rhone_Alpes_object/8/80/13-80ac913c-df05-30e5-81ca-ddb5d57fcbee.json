  "rdfs:comment": {
    "de": [
      "Auf dem Campingplatz Citykamp Lyon gibt es ein Café-Restaurant, in dem Sie auf der Terrasse ein Glas trinken, einen Aperitif genießen oder sich eine hausgemachte Pizza schmecken lassen können. Tagsüber können Sie den Co-Working-Bereich nutzen."
    ],
    "en": [
      "On the Camping de Lyon discover the Café-resto to have a drink on the terrace or to taste a home-made pizza. During the day, take advantage of the co-working space."
    ],
    "it": [
      "Al campeggio Citykamp Lyon potrete sorseggiare un drink sulla terrazza, condividere un aperitivo o gustare una pizza fatta in casa al Café-resto. Durante il giorno, approfittate dello spazio di co-working."
    ],
    "fr": [
      "Sur le site du camping Citykamp Lyon découvrez le Café-resto pour boire un verre sur la terrasse, partager une planche apéritive ou déguster une pizza maison. En journée profitez de l’espace de co-working."
    ],
    "nl": [
      "Op camping Citykamp Lyon kun je genieten van een drankje op het terras, een aperitief delen of een huisgemaakte pizza eten in het Café-resto. Overdag kun je gebruikmaken van de co-working space."
    ],
    "es": [
      "En el camping Citykamp Lyon, podrá disfrutar de una copa en la terraza, compartir un aperitivo o saborear una pizza casera en el Café-resto. Durante el día, aproveche el espacio de co-working."
    ]
  },
