  "rdfs:comment": {
    "de": [
      "In einem gemütlichen Rahmen bieten Ihnen Hélène und Thibaut eine Küche, die mit frischen und saisonalen Produkten zubereitet wird\r\nentdecken Sie ihre 100% hausgemachte Tageskarte\r\nKüche von hier und anderswo, vegetarische Gerichte, leckere Desserts."
    ],
    "en": [
      "Hélène and Thibaut offer you a warm and friendly setting where you can enjoy a cuisine prepared with fresh and seasonal products. \r\nCome and discover their 100% home-made slate of the day menu. \r\nCuisine d'Ici et d'Ailleurs, vegetarian dishes, gourmet desserts."
    ],
    "it": [
      "Hélène e Thibaut vi offrono un ambiente caldo e accogliente dove potrete gustare una cucina a base di prodotti freschi e di stagione. \r\nVenite a scoprire il loro menu del giorno 100% fatto in casa. \r\nCuisine d'Ici et d'Ailleurs, piatti vegetariani, dolci gourmet."
    ],
    "fr": [
      "Dans un cadre chaleureux, Hélène et Thibaut vous proposent une cuisine élaborée avec des produits frais et de saison. \r\n​Venez découvrir leur carte à l'ardoise du jour 100% faite maison. \r\nCuisine d'Ici et d'Ailleurs, plats végétarien, desserts gourmands."
    ],
    "nl": [
      "In een warm kader bieden Hélène en Thibaut u een keuken bereid met verse en seizoensgebonden producten\r\nkom en ontdek hun menu met de dagschotel, 100% huisgemaakt\r\nKeuken van hier en elders, vegetarische gerechten, gastronomische desserts."
    ],
    "es": [
      "En un ambiente cálido, Hélène y Thibaut le ofrecen una cocina elaborada con productos frescos y de temporada\r\nven a descubrir su menú con la pizarra del día, 100% casera\r\nCocina de aquí y de fuera, platos vegetarianos, postres gourmet."
    ]
  },
