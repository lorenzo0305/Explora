  "rdfs:comment": {
    "de": [
      "RNCP-zertifizierte Sophrologin für Kinder, Jugendliche und Erwachsene. Le Souffle du Farou bietet Ihnen eine Zeit der Atmung und Entspannung, in der Sie sich um sich selbst kümmern können. Laure empfängt Sie in ihrer Praxis, damit Sie den Druck des Alltags abbauen können."
    ],
    "en": [
      "Le Souffle du Farou is an RNCP-certified sophrologist for children, teenagers, and adults, offering breathing and relaxation sessions to help you take care of yourself. Laure welcomes you to her office to help you reduce the pressure of everyday life."
    ],
    "it": [
      "Sofrologista certificata RNCP per bambini, adolescenti e adulti, Le Souffle du Farou offre un momento di respirazione e rilassamento per aiutarvi a prendervi cura di voi stessi. Laure vi accoglie nel suo studio per aiutarvi ad alleviare la pressione della vita quotidiana."
    ],
    "fr": [
      "Sophrologue certifiée RNCP, pour enfants, adolescents et adultes, Le Souffle du Farou propose un temps de respiration et de relaxation pour prendre soin de vous. Laure vous reçoit en cabinet pour vous permettre de faire baisser la pression du quotidien."
    ],
    "es": [
      "Sofrologa certificada por el RNCP para niños, adolescentes y adultos, Le Souffle du Farou le ofrece un momento de respiración y relajación para ayudarle a cuidarse. Laure le da la bienvenida a su consulta para ayudarle a aliviar la presión de la vida cotidiana."
    ],
    "nl": [
      "Als RNCP-gecertificeerd sofrologist voor kinderen, tieners en volwassenen biedt Le Souffle du Farou een moment van ademhaling en ontspanning om je te helpen goed voor jezelf te zorgen. Laure heet je welkom in haar praktijk om je te helpen de druk van het dagelijks leven te verlichten."
    ]
  },
  "rdfs:label": {
