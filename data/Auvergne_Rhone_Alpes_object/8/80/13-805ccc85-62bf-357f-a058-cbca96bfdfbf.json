  "rdfs:comment": {
    "de": [
      "Dies ist ein junges Team mit Leidenschaft für PIZZA!\r\nDer Chefkoch hat sich bei akrobatischen Pizza-Wettbewerben einen Namen gemacht und bietet ein einzigartiges kulinarisches und visuelles Erlebnis."
    ],
    "en": [
      "Here's a young team with a passion for PIZZA!\r\nThe chef has been recognized in acrobatic pizza competitions, offering a unique culinary and visual experience."
    ],
    "it": [
      "Ecco un team giovane con la passione per la PIZZA!\r\nLo chef ha ottenuto riconoscimenti in gare di pizza acrobatica, offrendo un'esperienza culinaria e visiva unica."
    ],
    "fr": [
      "Voici une jeune équipe passionnée dans le domaine de la PIZZA ! \r\nLe chef a été reconnu dans des compétitions de pizza acrobatique, offrant ainsi une expérience culinaire et visuelle unique."
    ],
    "es": [
      "¡He aquí un joven equipo apasionado por la PIZZA!\r\nEl chef ha sido aclamado en competiciones de pizza acrobática, ofreciendo una experiencia culinaria y visual única."
    ],
    "nl": [
      "Hier is een jong team met een passie voor PIZZA!\r\nDe chef-kok heeft prijzen gewonnen in acrobatische pizzawedstrijden en biedt een unieke culinaire en visuele ervaring."
    ]
  },
  "rdfs:label": {
