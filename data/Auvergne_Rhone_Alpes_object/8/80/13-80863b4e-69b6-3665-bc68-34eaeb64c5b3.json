  "rdfs:comment": {
    "de": [
      "Mit der Familie, mit Freunden oder in der Gruppe profitieren Sie von all unseren Kanuangeboten mit verschiedenen Unterkunftsarten am Ufer der Ardèche auf dem Campingplatz La Rouvière."
    ],
    "en": [
      "As a family, with friends or in a group, take advantage of all our canoeing packages with different types of accommodation on the banks of the Ardèche at La Rouvière campsite."
    ],
    "it": [
      "In famiglia, con gli amici o in gruppo, approfittate di tutti i nostri pacchetti canoa con diversi tipi di alloggio sulle rive dell'Ardèche al campeggio La Rouvière."
    ],
    "fr": [
      "En famille, entre amis ou en groupe profitez de toutes nos formules canoë avec différents types d'hébergement en bord d'Ardèche au camping de la Rouvière."
    ],
    "nl": [
      "Profiteer als gezin, met vrienden of in groep van al onze kano-arrangementen met verschillende soorten accommodatie aan de oevers van de Ardèche op camping La Rouvière."
    ],
    "es": [
      "En familia, con amigos o en grupo, aproveche todos nuestros paquetes de piragüismo con diferentes tipos de alojamiento a orillas del Ardèche en el camping La Rouvière."
    ]
  },
