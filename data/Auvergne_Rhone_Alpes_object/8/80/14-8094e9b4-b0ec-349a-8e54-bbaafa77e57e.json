  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/60950c08-46ab-33ed-9ff6-e72b57d96439",
      "dc:description": {
        "de": [
          "Die EMA lädt Kinder von 5 bis 13 Jahren mit ihren Ferienworkshops dazu ein, die fabelhafte Welt der Utopien zu besuchen, sich vorzustellen, zu bauen und zu spielen. Preise: Boulonnais: 33 Euro/Woche, außerhalb: 48 Euro/Woche. Achtung !!! Begrenzte Anzahl an Plätzen! Reservierung über das Sekretariat der EMA."
        ],
        "en": [
          "EMA invites children aged 5 to 13 to come, imagine, build and play around the fabulous world of utopias with its vacation workshops. Prices : Boulonnais: 33 euros/week, outside Boulonnais: 48 euros/week. Please note! Places are limited! Bookings through the EMA secretariat."
        ],
        "it": [
          "L'EMA invita i bambini dai 5 ai 13 anni a immaginare, costruire e giocare nel favoloso mondo delle utopie con i suoi laboratori per le vacanze. Prezzi : Boulonnais: 33 euro/settimana, fuori Boulonnais: 48 euro/settimana. Attenzione! I posti sono limitati! Si prega di prenotare presso la segreteria dell'EMA."
        ],
        "fr": [
          "L'EMA invite les enfants de 5 à 13 ans à venir, imaginer, construire et jouer autour de l’univers fabuleux des utopies avec ses ateliers de vacances. Tarifs : Boulonnais : 33 euros/semaine, extérieurs : 48 euros/semaine. Attention ! Nombre de places limité ! Réservation auprès du secrétariat de l’EMA."
        ],
        "es": [
          "La EMA invita a los niños de 5 a 13 años a venir a imaginar, construir y jugar en torno al fabuloso mundo de las utopías con sus talleres de vacaciones. Precios : Boulonnais: 33 euros/semana, fuera de Boulonnais: 48 euros/semana. ¡Atención! Las plazas son limitadas Se ruega reservar en la secretaría de la EMA."
        ],
        "nl": [
          "EMA nodigt kinderen van 5 tot 13 jaar uit om te komen fantaseren, bouwen en spelen rond de fantastische wereld van utopieën met zijn vakantieworkshops. Prijzen : Boulonnais: 33 euro/week, buiten Boulonnais: 48 euro/week. Let op! De plaatsen zijn beperkt! Reserveer bij het secretariaat van EMA."
        ]
      },
