  "rdfs:comment": {
    "de": [
      "Freie Besichtigung. Die Kirche stammt aus der zweiten Hälfte des 12. Jahrhunderts und besteht aus einem Schiff mit drei ungleichen Jochen, einem quadratischen Sanktuarium und einem flachen Kopfende."
    ],
    "en": [
      "Free visit. The church, which dates from the second half of the 12th century, has a nave of three unequal bays with a square sanctuary and a flat chevet."
    ],
    "it": [
      "Visita gratuita. La chiesa, che risale alla seconda metà del XII secolo, ha una navata a tre campate disuguali con un santuario quadrato e un chevet piatto."
    ],
    "fr": [
      "Visite libre. L'église, qui date de la seconde moitié du XIIe siècle, comprend une nef de trois travées inégales avec un sanctuaire carré et un chevet plat."
    ],
    "es": [
      "Visita gratuita. La iglesia, que data de la segunda mitad del siglo XII, tiene una nave de tres tramos desiguales con una cabecera cuadrada y una cabecera plana."
    ],
    "nl": [
      "Gratis bezoek. De kerk, die dateert uit de tweede helft van de 12e eeuw, heeft een schip van drie ongelijke traveeën met een vierkant heiligdom en een plat chevet."
    ]
  },
  "rdfs:label": {
