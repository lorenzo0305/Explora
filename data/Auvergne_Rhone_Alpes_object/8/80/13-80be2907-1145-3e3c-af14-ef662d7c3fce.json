  "rdfs:comment": {
    "de": [
      "Chefkoch Bernard und seine Frau Nathalie freuen sich, Sie in ihrer Auberge in der Ortschaft Argnat im Herzen der Auvergne begrüßen zu dürfen .."
    ],
    "en": [
      "Chef Bernard and his wife Nathalie, are pleased to welcome you in their Auberge located in the village of Argnat in the heart of the Auvergne .."
    ],
    "it": [
      "Lo chef Bernard e sua moglie Nathalie sono lieti di accogliervi nel loro Auberge situato nel villaggio di Argnat, nel cuore dell'Alvernia"
    ],
    "fr": [
      "Le chef Bernard et sa femme Nathalie, ont le plaisir de vous accueillir dans leur Auberge située dans le bourg d’Argnat en plein cœur de l’Auvergne …"
    ],
    "es": [
      "El chef Bernard y su esposa Nathalie se complacen en darle la bienvenida a su Auberge, situado en el pueblo de Argnat, en el corazón de Auvernia"
    ],
    "nl": [
      "Chef Bernard en zijn vrouw Nathalie heten u van harte welkom in hun Auberge gelegen in het dorp Argnat in het hart van de Auvergne"
    ]
