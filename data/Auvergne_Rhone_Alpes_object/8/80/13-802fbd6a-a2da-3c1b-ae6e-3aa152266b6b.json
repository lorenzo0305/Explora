  "rdfs:comment": {
    "de": [
      "WAT.bike ist ein Zusammenschluss von zwei Freunden, die leidenschaftliche Mountainbiker sind und bereichernde und sichere Erlebnisse anbieten. Unsere Mission: Kunden effektiv zu führen, sie zu inspirieren, Fortschritte zu machen und neue Horizonte zu erkunden, und dabei die Umwelt zu schonen."
    ],
    "en": [
      "WAT.bike is the alliance of two friends passionate about mountain biking, offering enriching and safe experiences. Our mission: to effectively guide customers, inspire them to progress and explore new horizons while preserving the environment."
    ],
    "it": [
      "WAT.bike è l'alleanza di due amici con la passione per la mountain bike, che offrono esperienze sicure e gratificanti. La nostra missione: guidare i clienti in modo efficace, ispirandoli a progredire e a esplorare nuovi orizzonti, preservando l'ambiente."
    ],
    "fr": [
      "WAT.bike, c'est l'alliance de 2 amis passionnés de VTT, offrant des expériences enrichissantes et sécurisées. Notre mission : guider efficacement les clients, les inspirer à progresser et à explorer de nouveaux horizons tout en préservant l'environnement."
    ],
    "nl": [
      "WAT.bike is de alliantie van twee vrienden met een passie voor mountainbiken, die verrijkende en veilige ervaringen bieden. Onze missie: klanten effectief begeleiden, inspireren om vooruitgang te boeken en nieuwe horizonten te verkennen, met behoud van het milieu."
    ],
    "es": [
      "WAT.bike es la alianza de 2 amigos apasionados por la bicicleta de montaña, que ofrecen experiencias seguras y gratificantes. Nuestra misión: guiar a los clientes de forma eficaz, inspirándoles para que progresen y exploren nuevos horizontes, preservando al mismo tiempo el medio ambiente."
    ]
  },
  "rdfs:label": {
