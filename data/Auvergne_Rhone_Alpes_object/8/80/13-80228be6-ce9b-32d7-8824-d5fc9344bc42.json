  "rdfs:comment": {
    "de": [
      "Le Quermoz ist der höchste Punkt der Gemeinde Hautecour (2296 m).\r\nAuf dem Gipfel bietet sich Ihnen ein außergewöhnliches 360°-Panorama über das Tal der Tarentaise, das Massif de la Vanoise, den Beaufortain, die 3 Vallées und den Mont Blanc!"
    ],
    "en": [
      "The Quermoz is the highest point in the town of Hautecour (2296 m). At the top, a 360 ° view of the Tarentaise valley, the Vanoise massif, the Beaufortain, the 3 Valleys and Mont Blanc!"
    ],
    "it": [
      "Le Quermoz è il punto più alto dell'Hautecour (2296 m).\r\nDalla cima si gode di un'eccezionale vista panoramica a 360° sulla valle della Tarentaise, il massiccio della Vanoise, il Beaufortain, le 3 Vallées e il Monte Bianco!"
    ],
    "fr": [
      "Le Quermoz est le point culminant de la commune de Hautecour (2296 m).\r\nAu sommet, un panorama exceptionnel à 360° sur la vallée de la Tarentaise, le massif de la Vanoise, le Beaufortain, les 3 Vallées et le Mont Blanc !"
    ],
    "nl": [
      "Le Quermoz is het hoogste punt van Hautecour (2296 m).\r\nOp de top kun je genieten van een uitzonderlijk 360° panoramisch uitzicht over de Tarentaise vallei, het Vanoise massief, de Beaufortain, de 3 Vallées en de Mont Blanc!"
    ],
    "es": [
      "Le Quermoz es el punto más alto del Hautecour (2296 m).\r\nEn la cima, podrá disfrutar de una excepcional vista panorámica de 360° sobre el valle de la Tarentaise, el macizo de la Vanoise, el Beaufortain, los 3 Vallées y el Mont Blanc"
    ]
  },
