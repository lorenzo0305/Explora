  "rdfs:comment": {
    "de": [
      "Genießen Sie köstliche Pizzas und Calzone, die im Holzofen gebacken werden. Präsenz des Foodtrucks ab 18 Uhr am Mittwoch auf dem Dorfplatz von Panossas."
    ],
    "en": [
      "Enjoy delicious wood-fired pizzas and calzones. The foodtruck opens at 6pm on Wednesdays in the village square of Panossas."
    ],
    "it": [
      "Gustate deliziose pizze e calzoni cotti a legna. Il foodtruck sarà presente nella piazza del paese di Panossas dalle 18.00 del mercoledì."
    ],
    "fr": [
      "Dégustez de délicieuses pizzas et calzones cuites au feu de bois. Présence du foodtruck dès 18h le mercredi sur la place du village de Panossas."
    ],
    "nl": [
      "Geniet van heerlijke houtovenpizza's en calzones. De foodtruck staat op woensdag vanaf 18.00 uur op het dorpsplein in Panossas."
    ],
    "es": [
      "Disfrute de deliciosas pizzas y calzones al horno de leña. El foodtruck estará en la plaza del pueblo de Panossas a partir de las 18:00 los miércoles."
    ]
  },
  "rdfs:label": {
