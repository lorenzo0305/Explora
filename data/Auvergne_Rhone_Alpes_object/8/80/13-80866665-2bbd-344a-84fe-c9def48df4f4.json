  "rdfs:comment": {
    "de": [
      "Das Gewässer verfügt über einen feinen Sandstrand, Rasenflächen und Spiele für Kinder. \r\nSchwimmen unter Aufsicht im Juli und August."
    ],
    "en": [
      "The body of water has a beach of fine sand, grassy stretches and games for children. \r\nSwimming supervised in July and August."
    ],
    "it": [
      "Il lago dispone di una spiaggia sabbiosa, di aree erbose e di aree gioco per bambini.\r\nNuoto sorvegliato in luglio e agosto."
    ],
    "fr": [
      "Le plan d'eau dispose d'une plage de sable fin, d'étendues herbeuses et de jeux pour les enfants. \r\nBaignade surveillée en Juillet Août."
    ],
    "nl": [
      "Het meer heeft een zandstrand, grasvelden en kinderspeelplaatsen.\r\nZwemmen onder toezicht in juli en augustus."
    ],
    "es": [
      "El lago cuenta con una playa de arena, zonas de césped y áreas de juegos infantiles.\r\nBaño vigilado en julio y agosto."
    ]
  },
