  "rdfs:comment": {
    "de": [
      "Merowingische Skulpturen und Fragmente von Sarkophagen, die in Ronfin gefunden wurden, deuten darauf hin, dass das Dorf St Symphorien de Lay seit der frühesten Antike bewohnt war."
    ],
    "en": [
      "Merovingian sculptures and sarcophagus fragments discovered at Ronfin suggest that the village of St Symphorien de Lay has been inhabited since earliest antiquity."
    ],
    "it": [
      "Sculture merovingie e frammenti di sarcofagi rinvenuti a Ronfin suggeriscono che il villaggio di St Symphorien de Lay sia stato abitato fin da tempi molto antichi."
    ],
    "fr": [
      "Des sculptures mérovingiennes et des fragments de sarcophages découverts à Ronfin laissent entendre que le village de St Symphorien de Lay est habité depuis la plus haute Antiquité."
    ],
    "nl": [
      "Merovingische beeldhouwwerken en fragmenten van sarcofagen ontdekt in Ronfin suggereren dat het dorp St Symphorien de Lay al sinds de oudheid bewoond is."
    ],
    "es": [
      "Las esculturas merovingias y los fragmentos de sarcófagos descubiertos en Ronfin sugieren que el pueblo de St Symphorien de Lay ha estado habitado desde tiempos muy antiguos."
    ]
  },
  "rdfs:label": {
