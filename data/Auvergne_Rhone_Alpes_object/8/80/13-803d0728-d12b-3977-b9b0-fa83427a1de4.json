  "rdfs:comment": {
    "de": [
      "Traditionelle Optiker - Beratung - Gesundheit, denn bei Crest' optique sind Ihre Augen immer wertvoller als Ihre Brille. Hier garantiert Ihnen unser offenes Ohr einen zielgerichteten Service."
    ],
    "en": [
      "Traditional opticians - advice - health, because at Crest' optique your eyes will always be more precious than your glasses. At Crest' Optique, we listen to you to ensure you get the service you need."
    ],
    "it": [
      "Ottica tradizionale - consulenza - salute, perché da Crest' optique i vostri occhi saranno sempre più preziosi dei vostri occhiali. La nostra attenzione vi garantisce un servizio mirato."
    ],
    "fr": [
      "Opticiens traditionnels - conseil - santé, parce que chez Crest' optique vos yeux seront toujours plus précieux que vos lunettes. Ici, notre écoute vous garantit un service ciblé."
    ],
    "es": [
      "Óptica tradicional - asesoramiento - salud, porque en Crest' optique sus ojos siempre serán más valiosos que sus gafas. Aquí, nuestra atención le garantiza un servicio específico."
    ],
    "nl": [
      "Traditionele opticiens - advies - gezondheid, want bij Crest' optique zijn uw ogen altijd kostbaarder dan uw bril. Hier garanderen onze luistervaardigheden u een doelgerichte service."
    ]
  },
