  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine Küche, die zu Herzen geht: authentische, hausgemachte Gerichte, wie wir sie lieben. Hier gibt es kein Chichi, sondern nur den Geschmack guter Dinge, immer zum kleinen Preis."
    ],
    "en": [
      "Our cuisine is straight to the heart: authentic, homemade dishes, just the way we like them. There's no fuss here, just a taste for good things at low prices."
    ],
    "it": [
      "La nostra cucina va dritta al cuore: piatti autentici, fatti in casa, proprio come piacciono a noi. Non ci sono fronzoli, ma solo il gusto per le cose buone a prezzi bassi."
    ],
    "fr": [
      "On vous propose une cuisine qui va droit au cœur : des plats authentiques, faits maison, comme on les aime. Ici, pas de chichis, juste le goût des bonnes choses toujours à petit prix."
    ],
    "nl": [
      "Onze keuken is recht uit het hart: authentieke, huisgemaakte gerechten, precies zoals wij ze lekker vinden. Hier geen poespas, alleen een voorliefde voor goede dingen tegen lage prijzen."
    ],
    "es": [
      "Nuestra cocina va directa al corazón: platos auténticos, caseros, tal y como nos gustan. Aquí no hay aspavientos, sólo gusto por lo bueno a bajo precio."
    ]
  },
