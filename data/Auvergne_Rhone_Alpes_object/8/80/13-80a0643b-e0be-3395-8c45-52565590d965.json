  "rdfs:comment": {
    "de": [
      "Das Restaurant Chez la Tante liegt auf 1850 m Höhe und ist ein Restaurant, das zwischen Himmel und Schnee schwebt, wo die Zeit stillzustehen scheint. Dieses Refugium ist nur mit der Seilbahn von Le Bettex oder auf Skiern erreichbar und lädt zum Abschalten und zur Kontemplation ein."
    ],
    "en": [
      "Perched at an altitude of 1850 m, Restaurant Chez la Tante is a restaurant suspended between sky and snow, where time seems to stand still. Accessible only by the Bettex cable car or on skis, this refuge invites you to disconnect and contemplate."
    ],
    "it": [
      "Arroccato a 1850 m di altitudine, il Ristorante Chez la Tante è un ristorante sospeso tra cielo e neve, dove il tempo sembra essersi fermato. Raggiungibile solo con la funivia Bettex o con gli sci, questo rifugio invita a staccare la spina e a contemplare."
    ],
    "fr": [
      "Perché à 1850 m d’altitude, le Restaurant Chez la Tante est un restaurant suspendu entre ciel et neige, où le temps semble s’arrêter. Accessible uniquement par le téléphérique du Bettex ou à ski, ce refuge invite à la déconnexion et à la contemplation."
    ],
    "nl": [
      "Restaurant Chez la Tante ligt op 1850 meter hoogte en is een restaurant dat zweeft tussen hemel en sneeuw, waar de tijd lijkt stil te staan. Dit toevluchtsoord is alleen bereikbaar met de Bettex kabelbaan of op ski's en nodigt je uit om je te ontkoppelen en na te denken."
    ],
    "es": [
      "Encaramado a 1850 m de altitud, el Restaurant Chez la Tante es un restaurante suspendido entre el cielo y la nieve, donde el tiempo parece detenerse. Accesible únicamente con el teleférico Bettex o esquiando, este refugio invita a la desconexión y la contemplación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Chez la Tante - Mont d'Arbois"
    ]
  },
