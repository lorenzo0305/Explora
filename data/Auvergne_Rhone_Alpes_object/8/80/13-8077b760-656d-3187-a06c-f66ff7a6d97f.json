  "rdfs:comment": {
    "de": [
      "600 m² in 3 Sälen: Ausstellungshalle, Linder-Saal und Dussud-Saal, die bis zu 464 Personen für Ihre verschiedenen Veranstaltungen aufnehmen können.\r\n3 Säle mit 206m², 95m² und 159m². Rund um die Uhr zugängliche Duschen (Label Village Sport Nature). Geschirr wird bereitgestellt."
    ],
    "en": [
      "600 m² in 3 rooms: exhibition hall, Linder room and Dussud room, accommodating up to 464 people for your various events.\r\n3 rooms of 206m², 95m² and 159m². Showers available 24/24h (Village Sport Nature label). Crockery and cutlery supplied."
    ],
    "it": [
      "600 m² in 3 sale: sala espositiva, sala Linder e sala Dussud, che possono ospitare fino a 464 persone per i vostri eventi.\r\n3 sale di 206 m², 95 m² e 159 m². Docce disponibili 24 ore su 24 (marchio Village Sport Nature). Stoviglie e posate fornite."
    ],
    "fr": [
      "600 m² en 3 salles : hall d’exposition, salle Linder et salle Dussud pouvant accueillir jusqu’à 464 personnes pour vos différents évènements.\r\n3 salles de 206m², 95m² et 159m². Douche accessible 24/24h (label Village Sport Nature). Vaisselle fournie."
    ],
    "es": [
      "600 m² repartidos en 3 salas: sala de exposiciones, sala Linder y sala Dussud, que pueden albergar hasta 464 personas para sus distintos eventos.\r\n3 salas de 206 m², 95 m² y 159 m². Duchas disponibles las 24 horas del día (etiqueta Village Sport Nature). Vajilla y cubertería a su disposición."
    ],
    "nl": [
      "600 m² in 3 zalen: tentoonstellingszaal, Linderzaal en Dussudzaal, die tot 464 personen kunnen herbergen voor uw verschillende evenementen.\r\n3 zalen van 206m², 95m² en 159m². Douches 24 uur per dag beschikbaar (label Village Sport Nature). Servies en bestek aanwezig."
    ]
  },
