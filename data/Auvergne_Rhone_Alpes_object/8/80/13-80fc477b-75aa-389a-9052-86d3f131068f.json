  "rdfs:comment": {
    "de": [
      "Das Saisonbüro in Vic-le-Comte befindet sich im Herzen der Petite Cité de Caractère®, 30 km südöstlich von Clermont-Ferrand. Unsere Aufenthaltsberater empfangen die Besucher vom 3. Juli bis zum 31. August."
    ],
    "en": [
      "The Vic-le-Comte seasonal office is located in the heart of the Petite Cité de Caractère®, 30 km south-east of Clermont-Ferrand. Our holiday advisors welcome visitors from 3 July to 31 August."
    ],
    "it": [
      "L'ufficio stagionale di Vic-le-Comte si trova nel cuore della Petite Cité de Caractère®, a 30 km a sud-est di Clermont-Ferrand. I nostri consulenti per le vacanze accolgono i visitatori dal 3 luglio al 31 agosto."
    ],
    "fr": [
      "Le bureau saisonnier de Vic-le-Comte est situé au cœur de la Petite Cité de Caractère®, à 30 km au sud-est de Clermont-Ferrand. Nos conseillers en séjours accueillent les visiteurs du 3 juillet au 31 août."
    ],
    "es": [
      "La oficina de temporada de Vic-le-Comte está situada en el corazón de la Petite Cité de Caractère®, a 30 km al sureste de Clermont-Ferrand. Nuestros asesores de vacaciones reciben a los visitantes del 3 de julio al 31 de agosto."
    ],
    "nl": [
      "Het seizoenskantoor van Vic-le-Comte ligt in het hart van de Petite Cité de Caractère®, 30 km ten zuidoosten van Clermont-Ferrand. Onze vakantieadviseurs verwelkomen bezoekers van 3 juli tot 31 augustus."
    ]
  },
