  "rdfs:comment": {
    "de": [
      "Die Fontaine du Melon oder de la Conche (was so viel wie Muschel bedeutet) ermöglichte es vielen Pilgern auf ihrem Weg nach St-Gilles du Gard, auf ihrem Weg durch die mittelalterliche Stadt Pradelles ihren Durst zu stillen."
    ],
    "en": [
      "The Fontaine du Melon, or de la Conche (which means \"shell\"), has enabled many pilgrims on their way to St-Gilles du Gard to quench their thirst as they pass through the medieval town of Pradelles."
    ],
    "it": [
      "La Fontaine du Melon, o de la Conche (che significa \"conchiglia\"), ha permesso a molti pellegrini diretti a St-Gilles du Gard di dissetarsi passando per la città medievale di Pradelles."
    ],
    "fr": [
      "La Fontaine du Melon, ou de la Conche (qui veut dire coquille) a permis à de nombreux pèlerins se rendant à St-Gilles du Gard de se désaltérer en traversant la cité médiévale de Pradelles."
    ],
    "es": [
      "La Fontaine du Melon, o de la Conche (que significa \"concha\"), ha permitido a muchos peregrinos de camino a St-Gilles du Gard saciar su sed a su paso por la ciudad medieval de Pradelles."
    ],
    "nl": [
      "De Fontaine du Melon, of de la Conche (wat \"schelp\" betekent), heeft vele pelgrims op weg naar St-Gilles du Gard in staat gesteld hun dorst te lessen als ze door het middeleeuwse stadje Pradelles lopen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fontaine du Melon | Pradelles"
    ]
  },
