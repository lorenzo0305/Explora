  "rdfs:comment": {
    "de": [
      "Die Gemeinde Outriaz ist mit zwei Picknickplätzen ausgestattet. Dieser ist aus Holz mit einem Unterstand und befindet sich am Dorfausgang in Richtung Brenod."
    ],
    "en": [
      "Outriaz has two picnic areas. The wooden one, with a shelter, is located on the outskirts of the village in the direction of Brenod."
    ],
    "it": [
      "Outriaz dispone di due aree picnic. Quella in legno, con un riparo, si trova alla periferia del villaggio in direzione di Brenod."
    ],
    "fr": [
      "La commune de Outriaz est équipée de deux aires de pique-nique. Celle-ci est en bois avec un abri et se trouve à la sortie du village en direction de Brenod."
    ],
    "nl": [
      "Outriaz heeft twee picknickplaatsen. De houten, met een afdak, ligt aan de rand van het dorp in de richting van Brenod."
    ],
    "es": [
      "Outriaz cuenta con dos merenderos. El de madera, con un refugio, está a las afueras del pueblo en dirección a Brenod."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique-nique en bois d'Outriaz"
    ]
  },
