  "rdfs:comment": {
    "de": [
      "Das Restaurant du Pont bietet Ihnen täglich seine Froschschenkel und Ukelei-Frituren, Kalbskopf, Schweinefüße und Schnitzel aus der Auvergne an. Neu: Pizza an jedem Abend des Jahres."
    ],
    "en": [
      "\"Restaurant du pont\" serves frogs’ legs and deep fried whitebait every day, and local products. Eat as much as you like! Open lunchtime daily and Friday, Saturday and Sunday evenings. Open for lunch and dinner daily from 15/06 to 15/09."
    ],
    "it": [
      "Il ristorante du Pont offre ogni giorno cosce di rana e ablette fritte, testa di vitello, zampe di maiale e scaloppine d'Alvernia. Novità: pizza ogni sera dell'anno."
    ],
    "fr": [
      "Le Restaurant du Pont vous propose tous les  jours ses cuisses de grenouilles  et  fritures d’ablettes, tête de veau, pieds de cochons et escalope auvergnate. Nouveauté : pizza tous les soirs de l’année."
    ],
    "nl": [
      "Het Restaurant du Pont biedt dagelijks kikkerbilletjes en gebakken ablette, kalfskop, varkenspoten en Auvergne escalope. Nieuw: pizza elke avond van het jaar."
    ],
    "es": [
      "El Restaurante du Pont ofrece a diario ancas de rana y ablette frita, cabeza de ternera, pies de cerdo y escalope de Auvernia. Novedad: pizza todas las noches del año."
    ]
  },
  "rdfs:label": {
