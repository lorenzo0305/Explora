  "rdfs:comment": {
    "de": [
      "Salate, Sandwiches, Tagesgericht, Gebäck... Genießen Sie es vor Ort oder nehmen Sie es mit an einen warmen und authentischen Ort. Wir sind täglich von 6:45 Uhr bis 18:30 Uhr geöffnet."
    ],
    "en": [
      "Salads, sandwiches, daily specials, pastries... Come and eat in or take away in a warm, authentic setting. We're open every day from 6.45am to 6.30pm."
    ],
    "it": [
      "Insalate, panini, specialità del giorno, dolci... È possibile mangiare all'interno o da asporto in un'atmosfera calda e autentica. Siamo aperti tutti i giorni dalle 6.45 alle 18.30."
    ],
    "fr": [
      "Salades, sandwichs, plat du jour, pâtisseries... A venir déguster sur place ou à emporter dans un lieu chaleureux et authentique. Nous sommes ouverts tous les jours de 6h45 à 18h30."
    ],
    "nl": [
      "Salades, sandwiches, dagschotels, gebak... Je kunt bij ons eten of afhalen in een warme en authentieke sfeer. We zijn elke dag open van 6.45 tot 18.30 uur."
    ],
    "es": [
      "Ensaladas, bocadillos, platos del día, bollería... Se puede comer en el restaurante o para llevar en un ambiente cálido y auténtico. Abrimos todos los días de 6.45 a 18.30."
    ]
  },
