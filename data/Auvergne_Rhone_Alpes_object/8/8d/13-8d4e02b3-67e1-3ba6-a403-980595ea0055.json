  "rdfs:comment": {
    "de": [
      "Explor'a Sciences weckt Ihre Neugier! Wir bieten zahlreiche wissenschaftliche Workshops an, um die Welt um uns herum zu entdecken, zu manipulieren, zu erforschen und zu verstehen! Club, Geburtstag, Praktikum, Veranstaltungen..."
    ],
    "en": [
      "Explor'a Sciences awakens your curiosity! We offer a wide range of scientific workshops to help you discover the world around us, manipulate, explore and understand! Clubs, birthday parties, workshops, events..."
    ],
    "it": [
      "Explor'a Sciences risveglia la vostra curiosità! Offriamo un'ampia gamma di laboratori scientifici per aiutarvi a scoprire il mondo che vi circonda, a toccare con mano, a esplorare e a capire! Club, compleanni, corsi, eventi..."
    ],
    "fr": [
      "Explor'a Sciences éveille votre curiosité ! Nous proposons de nombreux ateliers scientifiques pour découvrir le monde qui nous entoure, manipuler, explorer comprendre ! Club, anniversaire, stage, évènements..."
    ],
    "es": [
      "¡Explor'a Sciences despierta tu curiosidad! Te ofrecemos una amplia gama de talleres científicos para que descubras el mundo que te rodea, te pongas manos a la obra, explores y comprendas Clubes, cumpleaños, cursos, eventos..."
    ],
    "nl": [
      "Explor'a Sciences prikkelt je nieuwsgierigheid! Wij bieden een breed scala aan wetenschappelijke workshops om je te helpen de wereld om je heen te ontdekken, zelf aan de slag te gaan, te onderzoeken en te begrijpen! Clubs, verjaardagen, cursussen, evenementen..."
    ]
  },
