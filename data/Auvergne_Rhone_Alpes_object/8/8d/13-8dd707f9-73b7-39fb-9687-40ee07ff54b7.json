  "rdfs:comment": {
    "de": [
      "Um alles über Lamas und Alpakas zu erfahren, begeben Sie sich nach Le Tilloux in Deux-Chaises. Entdecken Sie diese ungewöhnlichen Tiere im Herzen der Bocage Bourbonnais. Sie lernen die Tiere und die aus der Wolle der Alpakas hergestellten Kunstwerke kennen."
    ],
    "en": [
      "For all you need to know about llama and alpaca, go to Le Tilloux in Deux-Chaises. Discover these unusual animals in the heart of the Bocage Bourbonnais. You will get to know the animals and the creations made from alpaca wool."
    ],
    "it": [
      "Per scoprire tutto sui lama e gli alpaca, recatevi a Le Tilloux a Deux-Chaises. Scoprite questi animali insoliti nel cuore del Bocage Bourbonnais. Conoscerete gli animali e i prodotti realizzati con la lana degli alpaca."
    ],
    "fr": [
      "Pour tout savoir sur le lama et l’alpaga, rendez-vous au Tilloux à Deux-Chaises. Découvrez ces animaux insolites au cœur du Bocage Bourbonnais. Vous ferez la connaissance des animaux et les réalisations faites à partir de la laine des alpagas."
    ],
    "es": [
      "Para saberlo todo sobre las llamas y las alpacas, vaya a Le Tilloux, en Deux-Chaises. Descubra estos insólitos animales en el corazón del Bocage Bourbonnais. Conocerá a los animales y los productos elaborados con la lana de las alpacas."
    ],
    "nl": [
      "Om alles te weten te komen over lama's en alpaca's gaat u naar Le Tilloux in Deux-Chaises. Ontdek deze bijzondere dieren in het hart van de Bocage Bourbonnais. U maakt kennis met de dieren en de creaties die van de wol van de alpaca's worden gemaakt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Lamas du Tilloux"
    ]
  },
