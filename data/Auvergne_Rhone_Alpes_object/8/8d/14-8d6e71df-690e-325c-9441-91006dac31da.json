      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 9:15 bis 12:15 Uhr und von 14:00 bis 20:00 Uhr\nSamstags von 9:15 bis 12:15 Uhr und von 14:00 bis 17:00 Uhr.\n\n\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 9.15am to 12.15pm and 2pm to 8pm\nSaturday 9.15am to 12.15pm and 2pm to 5pm.\n\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a venerdì, dalle 9.15 alle 12.15 e dalle 14.00 alle 20.00\nSabato dalle 9.15 alle 12.15 e dalle 14.00 alle 17.00.\n\n\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture: \n\nDu lundi au vendredi de 9h15 à 12h15 et de 14h à 20h\nLe samedi de 9h15 à 12h15 et de 14h à 17h.\n\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag t/m vrijdag van 9.15 tot 12.15 uur en van 14.00 tot 20.00 uur\nOp zaterdag van 9.15 tot 12.15 en van 14.00 tot 17.00.\n\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 9.15 h a 12.15 h y de 14 h a 20 h\nSábados de 9h15 a 12h15 y de 14h00 a 17h00.\n\n\n\n\n "
        ]
      },
