  "rdfs:comment": {
    "de": [
      "Le Golf Pitch & Putt verfügt über einen Saal und eine Terrasse, die Sie für Ihre Geburtstage, Familienessen und Versammlungen mieten können:\r\n - ein Saal im Innenbereich mit einer Kapazität von 30 Personen\r\n - Überdachte Terrasse mit einer Kapazität für 50 Personen"
    ],
    "en": [
      "Le Golf Pitch & Putt has a room and terrace available for hire for birthdays, family meals and meetings:\r\n - indoor room for 30 people\r\n - Covered terrace for 50 people"
    ],
    "it": [
      "Le Golf Pitch & Putt dispone di una sala e di una terrazza disponibili per compleanni, pranzi di famiglia e riunioni:\r\n - una sala interna per 30 persone\r\n - Terrazza coperta per 50 persone"
    ],
    "fr": [
      "Le Golf Pitch & Putt dispose d''une  salle et une terrasse à la location pour vos anniversaire, repas de famille, réunion : \r\n - une salle en intérieur d'une capacité de 30 personnes\r\n - Terrasse couverte d'une capacité de 50 personnes"
    ],
    "nl": [
      "Le Golf Pitch & Putt heeft een zaal en een terras te huur voor verjaardagen, familiediners en vergaderingen:\r\n - een overdekte zaal voor 30 personen\r\n - Overdekt terras voor 50 personen"
    ],
    "es": [
      "Le Golf Pitch & Putt dispone de una sala y una terraza de alquiler para cumpleaños, comidas familiares y reuniones:\r\n - una sala interior para 30 personas\r\n - Terraza cubierta para 50 personas"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle - Terrasse Golf Pitch & Putt"
    ]
  },
