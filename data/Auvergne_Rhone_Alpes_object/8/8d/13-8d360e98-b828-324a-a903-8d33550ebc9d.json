  "rdfs:comment": {
    "de": [
      "Seyssel war seit der Antike an beiden Ufern der Rhône präsent und gehörte abwechselnd zu Savoyen und Frankreich, bis die Rhône 1760 zur Grenze wurde. Entdecken Sie seine Geschichte bei den von Haut-Rhône Tourisme organisierten Besichtigungen."
    ],
    "en": [
      "Present on both banks of the Rhône since ancient times, Seyssel was alternately Savoyard and French until the Rhône became a border in 1760. Come and discover its history during tours organized by Haut-Rhône Tourisme."
    ],
    "it": [
      "Presente su entrambe le sponde del Rodano fin dall'antichità, Seyssel è stata alternativamente savoiarda e francese fino a quando il Rodano è diventato un confine nel 1760. Venite a scoprire la sua storia durante le visite organizzate da Haut-Rhône Tourisme."
    ],
    "fr": [
      "Présente dès l'Antiquité sur les deux rives du Rhône, Seyssel sera tour à tour savoyarde et française jusqu'à ce que le Rhône devienne en 1760 une frontière. Venez découvrir son histoire lors des visites organisées par Haut-Rhône Tourisme."
    ],
    "nl": [
      "Seyssel, sinds de oudheid aanwezig op beide oevers van de Rhône, was afwisselend Savoyard en Frans totdat de Rhône in 1760 een grens werd. Kom de geschiedenis ontdekken tijdens de rondleidingen georganiseerd door Haut-Rhône Tourisme."
    ],
    "es": [
      "Presente en las dos orillas del Ródano desde la antigüedad, Seyssel fue alternativamente saboyana y francesa hasta que el Ródano se convirtió en frontera en 1760. Venga a descubrir su historia durante las visitas organizadas por Haut-Rhône Tourisme."
    ]
  },
