  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Umwandlung einer Textilfabrik in eine nationale Kartuschenfabrik. Die Besichtigung wird Ihnen die Geschichte dieses Industriegeländes aus dem 19. Jahrhundert näher bringen, das heute hervorragend restauriert und rehabilitiert ist."
    ],
    "en": [
      "Discover the transformation of a textile factory into a national cartridge factory. The tour will reveal the history of this 19th-century industrial site, now remarkably restored and rehabilitated."
    ],
    "it": [
      "Scoprite la trasformazione di una fabbrica tessile nella fabbrica nazionale di cartucce. La visita svelerà la storia di questo sito industriale del XIX secolo, oggi notevolmente restaurato e riabilitato."
    ],
    "fr": [
      "Partez à la découverte de la transformation d’une usine de textile en cartoucherie nationale. La visite vous dévoilera l’histoire de ce site industriel du XIXe siècle aujourd’hui remarquablement restauré et réhabilité."
    ],
    "nl": [
      "Ontdek de transformatie van een textielfabriek tot de nationale cartridgefabriek. De rondleiding onthult de geschiedenis van deze 19e-eeuwse industriële locatie, die nu opmerkelijk gerestaureerd en gerehabiliteerd is."
    ],
    "es": [
      "Descubra la transformación de una fábrica textil en la fábrica nacional de cartuchos. El recorrido le revelará la historia de este emplazamiento industrial del siglo XIX, ahora notablemente restaurado y rehabilitado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : La Cartoucherie"
    ]
  },
