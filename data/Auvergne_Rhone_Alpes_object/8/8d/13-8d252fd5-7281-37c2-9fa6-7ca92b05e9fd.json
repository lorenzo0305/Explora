  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Dieser Garten wurde angelegt, um ein bis dahin brachliegendes Überschwemmungsgebiet am Ufer der Besbre zu gestalten."
    ],
    "en": [
      "Free access. This garden was created to develop a flood zone on the banks of the Besbre, which until then was fallow."
    ],
    "it": [
      "Accesso libero. Questo giardino è stato creato per sviluppare un'area allagata sulle rive della Besbre, che in precedenza era incolta."
    ],
    "fr": [
      "Accès libre. Ce jardin a été créé pour aménager une zone inondable des bords de la Besbre jusqu'alors en friche."
    ],
    "nl": [
      "Vrije toegang. Deze tuin werd aangelegd om een overstroomd gebied aan de oevers van de Besbre, dat voorheen onbebouwd was, te ontwikkelen."
    ],
    "es": [
      "Acceso gratuito. Este jardín se creó para valorizar una zona inundada en la ribera del Besbre, que antes estaba sin cultivar."
    ]
  },
