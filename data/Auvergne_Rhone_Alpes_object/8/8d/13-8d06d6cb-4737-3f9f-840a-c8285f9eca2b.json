  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren Außenbereich, um während der Sommermonate einen geselligen Moment mit der Familie oder mit Freunden zu verbringen. Schließen Sie sich uns an, um einen Abend im Freien zu genießen. Bestellen Sie Aperitifbretter, leichte Weine und lokale Biere."
    ],
    "en": [
      "Come and discover our outdoor space to spend a convivial moment with family and friends during the summer. Join us for an open-air evening. Order appetizers, light wines and local beers."
    ],
    "it": [
      "Venite a scoprire il nostro spazio esterno per trascorrere un momento conviviale con la famiglia e gli amici durante l'estate. Unitevi a noi per una serata all'aperto. Ordinate aperitivi, vini leggeri e birre locali."
    ],
    "fr": [
      "Venez découvrir notre espace extérieur pour passer un moment convivial en famille, entre amis durant la période estivale. Rejoignez nous pour profiter d'une soirée en plein air. Commandez des planches apéritives, des vins légers, des bières locales."
    ],
    "es": [
      "Venga a descubrir nuestro espacio al aire libre para pasar un momento de convivencia con la familia y los amigos durante el verano. Acompáñenos en una velada al aire libre. Pida aperitivos, vinos ligeros y cervezas locales."
    ],
    "nl": [
      "Kom en ontdek onze buitenruimte om in de zomer een gezellig moment door te brengen met familie en vrienden. Kom bij ons voor een avond in de open lucht. Bestel aperitieven, lichte wijnen en lokale bieren."
    ]
  },
  "rdfs:label": {
