  "rdfs:comment": {
    "de": [
      "Das Café \"Chez Colette\" oder das \"Café du centre\" ist Colette und ihr Team, die Sie mit einem breiten Lächeln bewaffnet empfangen und Ihnen eine Erfrischung oder eine Mahlzeit im Saal oder auf der Terrasse anbieten."
    ],
    "en": [
      "Chez Colette\" or \"Café du Centre\" is where Colette and her team welcome you armed with a broad smile, offering refreshments and meals in the dining room or on the terrace."
    ],
    "it": [
      "Il caffè \"Chez Colette\" o il \"Café du centre\" è il luogo in cui Colette e il suo team vi accolgono con un ampio sorriso, offrendovi rinfreschi o pasti nella sala da pranzo o sulla terrazza."
    ],
    "fr": [
      "Le café \"Chez Colette\" ou le \"Café du centre\" c'est Colette et son équipe qui vous accueillent armée d'un large sourire, vous proposant de vous rafraîchir ou vous restaurer en salle ou en terrasse."
    ],
    "nl": [
      "Het café \"Chez Colette\" of het \"Café du centre\" is waar Colette en haar team je met een brede glimlach verwelkomen en je verfrissingen of maaltijden aanbieden in de eetzaal of op het terras."
    ],
    "es": [
      "El café \"Chez Colette\" o el \"Café du centre\" es donde Colette y su equipo le dan la bienvenida con una amplia sonrisa, ofreciéndole refrescos o comidas en el comedor o en la terraza."
    ]
  },
  "rdfs:label": {
