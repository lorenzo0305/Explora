  "rdfs:comment": {
    "de": [
      "Traditionelle tunesische und koschere Küche. Couscous nach Belieben (1 Kind unter 6 Jahren pro Familie gratis). Tajines, verschiedene Gerichte. Frische Produkte und Gemüse. Verkauf zum Mitnehmen."
    ],
    "en": [
      "Traditional Tunisian cuisine and kosher. Couscous at will (free for 1 child under 6 years old per family). Tajines, various dishes. Fresh products and vegetables. Take away sale."
    ],
    "it": [
      "Cucina tradizionale tunisina e kosher. Couscous a volontà (gratis per 1 bambino sotto i 6 anni per famiglia). Tajine, piatti vari. Prodotti freschi e verdure. Vendite da asporto."
    ],
    "fr": [
      "Cuisine traditionnelle tunisienne et casher. Couscous à volonté (gratuit pour 1 enfant de -6ans par famille). Tajines, plats variés. Produits et légumes frais. Vente à emporter."
    ],
    "nl": [
      "Traditionele Tunesische en koosjere keuken. Couscous voor iedereen (gratis voor 1 kind tot 6 jaar per gezin). Tajines, diverse gerechten. Verse producten en groenten. Afhaalmaaltijden."
    ],
    "es": [
      "Cocina tradicional tunecina y kosher. Cuscús todo lo que puedas comer (gratis para 1 niño menor de 6 años por familia). Tajines, platos varios. Productos frescos y verduras. Ventas de comida para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La bouffe de Tunis"
    ]
  },
