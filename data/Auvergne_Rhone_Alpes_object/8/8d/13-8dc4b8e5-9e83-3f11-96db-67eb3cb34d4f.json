  "rdfs:comment": {
    "de": [
      "Athénaïs Vercelloti, Korbflechterin, bietet Ihnen traditionelle und zeitgenössische Kreationen an."
    ],
    "en": [
      "Athénaïs Vercelloti, basket weaver, offers traditional and contemporary creations."
    ],
    "it": [
      "Athénaïs Vercelloti, artigiana cestaia, vi propone creazioni tradizionali e contemporanee.\r\nInsieme al suo partner Maël Guiriec, cestaio artigiano (Atelier DIoica), si impegnano a trasmettere questo raro know-how."
    ],
    "fr": [
      "Athénaïs Vercelloti, artisane vannière-osiéricultrice, vous propose des créations traditionnelles et contemporaines. \r\nAvec son compagnon Maël Guiriec artisan d'art vannier (Atelier DIoica), ils ont à cœur la transmission de ce savoir-faire rare."
    ],
    "es": [
      "Athénaïs Vercelloti, artesana cestera, le propone creaciones tradicionales y contemporáneas.\r\nJunto con su socio Maël Guiriec, cestero artesano (Atelier DIoica), se dedican a transmitir esta rara experiencia."
    ],
    "nl": [
      "Athénaïs Vercelloti, ambachtelijk mandenmaker, biedt u traditionele en hedendaagse creaties.\r\nSamen met haar partner Maël Guiriec, een ambachtelijke mandenmaker (Atelier DIoica), zetten zij zich in om deze zeldzame expertise door te geven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Athénaïs Vercelloti - Vannerie"
    ]
  },
