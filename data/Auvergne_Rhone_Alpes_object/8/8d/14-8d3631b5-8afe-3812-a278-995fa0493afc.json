  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7e75c603-6b0c-3a74-adfd-1d0eea075d7a",
      "dc:description": {
        "de": [
          "Beratung individuelle Begleitung\n\nPsycho-Energetikerin\n\nWellness-Praktikerin\n\nLeistungen bei Ihnen zu Hause nach Vereinbarung: 06.10.48.49.43\n30 Jahre Erfahrung im Bereich Wellness, Modellagen und Ausbildung, um Ihren persönlichen Bedürfnissen gerecht zu werden."
        ],
        "en": [
          "Advice and individual support\n\nPsycho-energetician\n\nWellness Practitioner\n\nHome services by appointment: 06.10.48.49.43\n30 years' experience in wellness, modelling and training to meet your personal needs."
        ],
        "it": [
          "Consulenza e assistenza individuale\n\nPsicoenergetico\n\nOperatore del benessere\n\nServizi a domicilio su appuntamento: 06.10.48.49.43\n30 anni di esperienza nel campo del benessere, della modellazione e della formazione per soddisfare le vostre esigenze personali."
        ],
        "fr": [
          "Conseil accompagnement individuel\n\nPsycho-énergéticienne\n\nPraticienne en bien-être\n\nPrestations à domicile sur rendez-vous : 06.10.48.49.43\n30 ans d'expérience dans le Mieux-être, les modelages et la formation pour répondre à vos besoins personnels."
        ],
        "es": [
          "Asesoramiento y apoyo individual\n\nPsicoenergética\n\nProfesional del bienestar\n\nServicios a domicilio con cita previa: 06.10.48.49.43\n30 años de experiencia en bienestar, modelado y formación para responder a sus necesidades personales."
        ],
        "nl": [
          "Advies en individuele ondersteuning\n\nPsycho-energeticus\n\nWelzijnswerker\n\nDiensten aan huis op afspraak: 06.10.48.49.43\n30 jaar ervaring in wellness, modellering en training om aan je persoonlijke behoeften te voldoen."
        ]
      },
