  "rdfs:comment": {
    "de": [
      "LOTO DER SCHULEN VON CHATU am Samstag, den 14. März ab 18 Uhr!\r\n\r\nEs gibt zahlreiche Preise zu gewinnen: Fernseher, AirFryer, Fahrrad, Laufband, Bierzapfanlage, Staubsauger..... Alle Kinder werden mit einem Spielzeug nach Hause gehen."
    ],
    "en": [
      "CHATU SCHOOLS LOTO on Saturday March 14th from 6pm!\r\n\r\nRefreshments and snacks on site, and lots of prizes to be won: TV, AirFryer, Bike, Treadmill, Beer taps, Vacuum cleaner.... All children will go home with a toy."
    ],
    "it": [
      "LOTO DELLE SCUOLE CHATU sabato 14 marzo dalle 18.00!\r\n\r\nRinfresco e ristorazione in loco. In palio: TV, Friggitrice, Bicicletta, Tapis roulant, Rubinetti della birra, Aspirapolvere.... Tutti i bambini torneranno a casa con un giocattolo."
    ],
    "fr": [
      "LOTO DES ÉCOLES DE CHATU le Samedi 14 Mars à partir de 18h !\r\n\r\nBuvette et restauration sur place de nombreux lots a gagner : TV, AirFryer, Vélo, Tapis de course, Tireuse a bière, Aspirateur.... Tous les enfants repartiront avec un jouet."
    ],
    "es": [
      "¡CHATU SCHOOLS LOTO el sábado 14 de marzo a partir de las 18.00 horas!\r\n\r\nRefrescos y catering in situ. Lotes para ganar: TV, AirFryer, Bicicleta, Cinta de correr, Grifos de cerveza, Aspiradora.... Todos los niños se irán a casa con un juguete."
    ],
    "nl": [
      "CHATU SCHOOLS LOTO op zaterdag 14 maart vanaf 18.00 uur!\r\n\r\nVersnaperingen en catering ter plaatse. Loten te winnen: TV, AirFryer, Fiets, Loopband, Bierkranen, Stofzuiger.... Alle kinderen gaan naar huis met speelgoed."
    ]
  },
