  "rdfs:comment": {
    "de": [
      "Dorf Saint-Arcons-de-Barges: Romanische Kirche mit Kammglockenturm. Grotte de la Beaume mit wundersamer Quelle und Marienheiligtum. Château du Villard 16. Jh., im 19. Jh. umgebaut (privat)."
    ],
    "en": [
      "Village of Saint-Arcons-de-Barges: Romanesque church with combed steeple. Grotte de la Beaume with miraculous spring and Marian shrine. 16th-century Château du Villard, remodeled in the 19th century (private)."
    ],
    "it": [
      "Villaggio di Saint-Arcons-de-Barges: chiesa romanica con campanile a pettine. Grotte de la Beaume con sorgente miracolosa e santuario mariano. Château du Villard, del XVI secolo, modificato nel XIX secolo (privato)."
    ],
    "fr": [
      "Village de Saint-Arcons-de-Barges : Église romane à clocher peigne. Grotte de la Beaume avec source miraculeuse et sanctuaire marial. Château du Villard XVIe siècle remanié au XIXe siècle (privé)."
    ],
    "es": [
      "Pueblo de Saint-Arcons-de-Barges: iglesia románica con campanario peinado. Gruta de la Beaume con fuente milagrosa y santuario mariano. Château du Villard, siglo XVI, modificado en el siglo XIX (privado)."
    ],
    "nl": [
      "Dorp Saint-Arcons-de-Barges: Romaanse kerk met gekamde klokkentoren. Grotte de la Beaume met miraculeuze bron en Mariaheiligdom. Château du Villard, 16e eeuw, verbouwd in de 19e eeuw (privé)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Saint-Arcons-de-Barges"
    ]
  },
