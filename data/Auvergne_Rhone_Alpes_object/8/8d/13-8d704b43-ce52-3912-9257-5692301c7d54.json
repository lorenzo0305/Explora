  "rdfs:comment": {
    "de": [
      "Ladengeschäft in der Fabrik. Direktverkauf an Privatpersonen und Gewerbetreibende.\r\n\r\n Sie finden: Label Rouge, IGP, Volaille Française, Poulet fermier IGP, Poulet de ma région, Truthahn, Halal-Geflügel, Geflügelinnereien, Coquelet."
    ],
    "en": [
      "Factory outlet. Direct sales to individuals and professionals.\r\n\r\n You will find : Label Rouge, IGP, French poultry, IGP free-range chicken, chicken from my region, turkey, halal poultry, poultry offal, cockerel."
    ],
    "it": [
      "Outlet di fabbrica. Vendita diretta a privati e professionisti.\r\n\r\n Troverete : Label Rouge, IGP, pollame francese, pollo ruspante IGP, pollo della mia regione, tacchino, pollame halal, frattaglie di pollame, galletto."
    ],
    "fr": [
      "Magasin d'usine. Vente directe aux particuliers et professionnels.\r\n\r\n Vous trouverez : Label Rouge, IGP, Volaille Française, Poulet fermier IGP, poulet de ma région, dinde, volaille halal, abats de volaille, coquelet."
    ],
    "es": [
      "Punto de venta en fábrica. Venta directa a particulares y profesionales.\r\n\r\n Encontrará : Label Rouge, IGP, aves de corral francesas, pollo de corral IGP, pollo de mi región, pavo, aves halal, despojos de aves de corral, gallo."
    ],
    "nl": [
      "Fabriekswinkel. Directe verkoop aan particulieren en professionals.\r\n\r\n U vindt : Label Rouge, IGP, Frans gevogelte, IGP scharrelkip, kip uit mijn streek, kalkoen, halal gevogelte, slachtafval van gevogelte, haan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Royal Bernard - Volaille Gourmande"
    ]
  },
