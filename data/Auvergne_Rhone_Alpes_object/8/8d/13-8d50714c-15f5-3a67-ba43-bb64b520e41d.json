  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Millery empfängt Sie mit über 10 000 Medien, die es zu entdecken gilt, sowie mit vielfältigen Veranstaltungen für Groß und Klein."
    ],
    "en": [
      "The Millery library welcomes you with over 10,000 documents to discover, as well as a variety of activities for young and old."
    ],
    "it": [
      "La biblioteca di Millery offre oltre 10.000 articoli da scoprire, oltre a una serie di eventi per grandi e piccini."
    ],
    "fr": [
      "La bibliothèque de Millery vous accueille avec plus de 10 000 documents à découvrir, ainsi que des animations variées pour petits et grands."
    ],
    "es": [
      "La biblioteca de Millery tiene más de 10.000 artículos para descubrir, así como una gran variedad de eventos para jóvenes y mayores."
    ],
    "nl": [
      "De bibliotheek van Millery heeft meer dan 10.000 items die je kunt ontdekken en er worden allerlei evenementen georganiseerd voor jong en oud."
