  "rdfs:comment": {
    "de": [
      "Lackierte Töpferwaren. Dekorationsgegenstand sowohl für Alltag als auch für besondere Anlässe! Farbe, Freude und Humor!\r\nWillkommen."
    ],
    "en": [
      "Glazed  pottery. Decorative utility pottery for everyday,  and special occasions! Color, joy and humor in the dishes!\r\nAnd very delicate porcelain jewelry, with silver settings.\r\nYou are Welcome."
    ],
    "it": [
      "Ceramiche in argilla smaltata. Oggetti di utilità molto decorativi per l'uso quotidiano e le occasioni speciali! Colore, gioia e umorismo nei piatti!\r\nE gioielli molto delicati in porcellana, montati su argento.\r\nBenvenuti nel nostro sito web."
    ],
    "fr": [
      "Poterie en terre vernissée. De l'utilitaire très décoratif pour le quotidien et les grandes occasions ! De la couleur, de la joie et de l'humour dans les plats ! \r\nEt des bijoux très délicats en porcelaine, montés sur argent.\r\nBienvenue."
    ],
    "nl": [
      "Geglazuurd aardewerk. Uiterst decoratieve gebruiksvoorwerpen voor dagelijks gebruik en voor bij speciale gelegenheden. Kleur, plezier en humor op uw bord, Welkom!"
    ],
    "es": [
      "Cerámica de arcilla vidriada. Artículos de utilidad muy decorativos para el día a día y las ocasiones especiales ¡Color, alegría y humor en los platos!\r\nY joyas muy delicadas en porcelana, montadas en plata.\r\nBienvenido a nuestro sitio web."
    ]
  },
