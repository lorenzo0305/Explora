  "rdfs:comment": {
    "de": [
      "Die Auberge befindet sich auf dem Plateau de Beauregard in 1620 m Höhe und heißt Sie im Sommer wie im Winter willkommen.\r\nGenießen Sie den Panoramablick auf das Mont-Blanc-Massiv und die Aravis-Kette, während Sie unsere Bergspezialitäten probieren oder eine Gourmet-Pause einlegen."
    ],
    "en": [
      "Located on the Plateau de Beauregard, at an altitude of 1620m, the Auberge welcomes you summer and winter alike.\r\nEnjoy a panoramic view of the Mont-Blanc massif and the Aravis mountain range while sampling our mountain specialities or taking a gourmet break."
    ],
    "it": [
      "Situato sul Plateau de Beauregard, a 1620 m di altitudine, l'Auberge vi accoglie in estate e in inverno.\r\nGodetevi una vista panoramica sul massiccio del Monte Bianco e sulla catena degli Aravis mentre gustate le nostre specialità di montagna o per una pausa gourmet."
    ],
    "fr": [
      "Situé sur le Plateau de Beauregard, à 1620m d’altitude, l’Auberge vous accueille été comme hiver.\r\nProfitez d’une vue panoramique sur le massif du Mont-Blanc et la chaîne des Aravis tout en dégustant nos spécialités de montagne ou pour une pause gourmande."
    ],
    "es": [
      "Situado en la meseta de Beauregard, a 1620 m de altitud, el Auberge le da la bienvenida en verano y en invierno.\r\nDisfrute de una vista panorámica del macizo del Mont Blanc y de la cordillera de Aravis mientras degusta nuestras especialidades de montaña o para una pausa gastronómica."
    ],
    "nl": [
      "Gelegen op het Plateau de Beauregard, op een hoogte van 1620m, verwelkomt de Auberge u zowel in de zomer als in de winter.\r\nGeniet van een panoramisch uitzicht op het Mont Blanc-massief en het Aravis-gebergte tijdens het proeven van onze bergspecialiteiten of voor een gastronomische pauze."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Matins Clairs - Mountain Inn"
    ],
    "fr": [
      "Les Matins Clairs - Auberge de montagne"
    ]
  },
