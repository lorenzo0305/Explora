  "rdfs:comment": {
    "de": [
      "Die Atelier-Galerie Rêves de couleurs bietet Ihnen eine Dauerausstellung mit Werken der Künstlerin Hélène Munet-Blocier: Gemälde, Buchmalereien und Scherenschnitte, die Sie entdecken und\nerwerben."
    ],
    "en": [
      "The Rêves de Couleurs studio and gallery has a permanent exhibition of works by artist Hélène Munet-Blocier, with paintings, illuminations and cut-outs on display in the gallery, which is also an art studio."
    ],
    "it": [
      "La galleria-studio Rêves de couleurs ospita un'esposizione permanente di opere dell'artista Hélène Munet-Blocier, tra cui dipinti, illuminazioni e ritagli\ne acquistare."
    ],
    "fr": [
      "L'atelier-galerie Rêves de couleurs vous propose une exposition permanente des œuvres de l'artiste Hélène Munet-Blocier, peintures, enluminures et découpages à découvrir et à\nacquérir."
    ],
    "es": [
      "El estudio-galería Rêves de couleurs presenta una exposición permanente de obras de la artista Hélène Munet-Blocier, entre pinturas, iluminaciones y recortables\ny adquirir."
    ],
    "nl": [
      "De Rêves de couleurs workshop-galerie heeft een permanente tentoonstelling van werken van kunstenaar Hélène Munet-Blocier, met schilderijen, illuminaties en cut-outs die te zien zijn in de galerie, die tevens het atelier is."
    ]
  },
  "rdfs:label": {
    "en": [
