  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Lélex empfängt Sie jeden Freitag von 17:00 bis 18:30 Uhr im alten Pfarrhaus gegenüber der Kirche. Während der Winterferien auch montags. Die Ausleihe ist kostenlos."
    ],
    "en": [
      "The Lélex library welcomes you every Friday from 5pm to 6:30pm in the former vicarage opposite the church. And Mondays during the winter vacations. Borrowing is free of charge."
    ],
    "it": [
      "La biblioteca di Lélex vi accoglie ogni venerdì dalle 17 alle 18.30 nella vecchia canonica di fronte alla chiesa. E il lunedì durante le vacanze invernali. Il prestito è gratuito."
    ],
    "fr": [
      "La bibliothèque de Lélex vous accueille tous les vendredis de 17h à 18h30 dans l’ancienne cure en face de l’église. Et les lundis pendant les vacances d'Hiver. Les emprunts sont gratuits."
    ],
    "es": [
      "La biblioteca de Lélex le acoge todos los viernes de 17 a 18.30 horas en la antigua vicaría frente a la iglesia. Y los lunes durante las vacaciones de invierno. El préstamo es gratuito."
    ],
    "nl": [
      "De Lélex bibliotheek ontvangt u elke vrijdag van 17.00 tot 18.30 uur in de oude pastorie tegenover de kerk. En op maandag tijdens de wintervakantie. Lenen is gratis."
    ]
  },
