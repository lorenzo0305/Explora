  "rdfs:comment": {
    "de": [
      "Dieses landschaftlich gestaltete Arboretum schützt eine bemerkenswerte Sammlung von Nadelbäumen und Gehölzen (insbesondere Ahorn). Es bietet eine große Auswahl an einheimischen oder exotischen botanischen Arten, von Patagonien bis Sibirien!"
    ],
    "en": [
      "This arboretum protects a remarkable collection of conifers and maple trees. It also boasts a large collection of autochtonous and exotic botanical plants from Patagonia to Siberia !"
    ],
    "it": [
      "Questo arboreto paesaggistico protegge una notevole collezione di conifere e piante legnose (in particolare aceri). Offre una vasta gamma di specie botaniche indigene ed esotiche, dalla Patagonia alla Siberia!"
    ],
    "fr": [
      "Cet arboretum paysagé protège une remarquable collection de conifères et végétaux ligneux (érables notamment). Il offre un large panel d'espèces botaniques autochtones ou exotiques, de la Patagonie à la Sibérie !"
    ],
    "nl": [
      "U kunt een arboretum (bomen- en plantenpark. Bezoeken op\r\nafspraak."
    ],
    "es": [
      "Este arboreto ajardinado protege una notable colección de coníferas y plantas leñosas (especialmente arces). Ofrece una amplia gama de especies botánicas autóctonas y exóticas, ¡desde la Patagonia hasta Siberia!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Arboretum High Combraille"
    ],
    "fr": [
      "Arboretum de Haute Combraille"
    ]
  },
