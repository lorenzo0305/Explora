  "rdfs:comment": {
    "de": [
      "Eine Pizzeria nur für Sie!\r\nMit einem perfekt beherrschten, hausgemachten Pizzateig aus BIO-Mehrkornmehl, sorgfältig ausgewählten lokalen und handwerklichen Produkten bietet Ihnen L'ATELIER A PIZZA nur das Beste."
    ],
    "en": [
      "A pizzeria just for you!\r\nL'ATELIER A PIZZA offers you the very best in homemade pizza dough made with organic multigrain flour and carefully selected local and artisanal products."
    ],
    "it": [
      "Una pizzeria solo per voi!\r\nCon un impasto per la pizza fatto in casa e perfettamente lavorato con farina multicereali biologiche, prodotti locali e artigianali accuratamente selezionati, L'ATELIER A PIZZA vi offre il meglio."
    ],
    "fr": [
      "Une pizzeria rien que pour vous !\r\nAvec une pâte à pizza faite maison parfaitement maitrisée à base de farine multi céréales BIO, des produits locaux et artisanaux sélectionnés avec attention, L’ATELIER A PIZZA vous propose le meilleur."
    ],
    "es": [
      "¡Una pizzería sólo para ti!\r\nCon una masa de pizza casera perfectamente dominada, elaborada con harina multicereales orgánica, productos locales y artesanales cuidadosamente seleccionados, L'ATELIER A PIZZA le ofrece lo mejor."
    ],
    "nl": [
      "Een pizzeria speciaal voor jou!\r\nL'ATELIER A PIZZA biedt je het allerbeste in huisgemaakt pizzadeeg, gemaakt van biologisch meergranenmeel en zorgvuldig geselecteerde lokale en ambachtelijke producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marques Avenue - L' Atelier à Pizza"
    ]
  },
