  "rdfs:comment": {
    "de": [
      "Vom Collectif Piétons (Kollektiv für Fußgänger). Dieses Kollektiv identifiziert und erstellt Rundwege, die es ermöglichen, Spaziergangsschleifen zu realisieren, und schneidet und pflegt die Wanderwege."
    ],
    "en": [
      "By the Collectif Piétons. This collective identifies and creates circuits for walking loops, clears and maintains footpaths."
    ],
    "it": [
      "A cura del Collectif Piétons. Questo gruppo identifica e crea percorsi per creare anelli pedonali e provvede alla pulizia e alla manutenzione dei sentieri."
    ],
    "fr": [
      "Par le Collectif Piétons. Ce collectif identifie et crée des circuits permettant de réaliser des boucles de promenade, débroussaille et entretient les chemins pédestres."
    ],
    "nl": [
      "Door het Collectif Piétons. Deze groep identificeert en creëert routes om wandellussen te maken en maakt de wandelpaden schoon en onderhoudt ze."
    ],
    "es": [
      "A cargo del Collectif Piétons. Este grupo identifica y crea rutas para crear bucles de senderismo, y limpia y mantiene los senderos."
    ]
  },
  "rdfs:label": {
