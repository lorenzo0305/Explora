  "rdfs:comment": {
    "de": [
      "Das Rooftop des Anges bietet Ihnen einen unvergesslichen Moment auf 2225 m Höhe! Genießen Sie einen zeitlosen Moment in einer gemütlichen Atmosphäre mit ausgearbeiteten Gerichten!"
    ],
    "en": [
      "The Rooftop des Anges offers you an unforgettable experience at an altitude of 2225m! Enjoy a timeless moment in a cosy atmosphere with carefully prepared dishes!"
    ],
    "it": [
      "Il Rooftop des Anges vi offre un'esperienza indimenticabile a 2225 m di altitudine! Godetevi un momento fuori dal tempo, in un'atmosfera accogliente e con piatti preparati con cura!"
    ],
    "fr": [
      "Le Rooftop des Anges vous propose un moment inoubliable à 2225m d'altitude ! Profitez d'un moment hors du temps, dans une ambiance cozy avec des plats travaillés !"
    ],
    "es": [
      "El Rooftop des Anges le ofrece una experiencia inolvidable a 2225 m de altitud Disfrute de un momento fuera del tiempo, en un ambiente acogedor y con platos preparados con esmero"
    ],
    "nl": [
      "De Rooftop des Anges biedt je een onvergetelijke ervaring op 2225 meter hoogte! Geniet van een tijdloos moment in een gezellige sfeer met zorgvuldig bereide gerechten!"
    ]
  },
