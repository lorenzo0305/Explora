  "rdfs:comment": {
    "de": [
      "Arkose, Saint-Austremoine, der Uhrenturm, Couzes, der Herzog von Berry, Höhlenwohnungen, ein Winzerhaus, Anatole Dauvergne, ein Bergfried Philippe Auguste, die Königin Margot, das Marchidial... Entdecken Sie die unerwarteten Reichtümer des Pays d'Issoire!"
    ],
    "en": [
      "Arkose, Saint-Austremoine, la Tour de l'Horloge, couzes, le Duc de Berry, troglodytes, a winegrower's house, Anatole Dauvergne, a Philippe Auguste keep, Reine Margot, le Marchidial... Come and discover the unexpected treasures of the Pays d'Issoire!"
    ],
    "it": [
      "Arkose, Saint-Austremoine, la Tour de l'Horloge, Couzes, il Duc de Berry, i trogloditi, la casa di un viticoltore, Anatole Dauvergne, il torrione di Philippe Auguste, Reine Margot, il Marchidial... Venite a scoprire i tesori inaspettati del Pays d'Issoire!"
    ],
    "fr": [
      "Arkose, Saint-Austremoine, la Tour de l'Horloge, couzes, le Duc de Berry, des troglodytes, une maison vigneronne, Anatole Dauvergne, un donjon Philippe Auguste, la Reine Margot, le Marchidial... Venez découvrir les richesses inattendues du Pays d'Issoire!"
    ],
    "es": [
      "Arkose, Saint-Austremoine, la Tour de l'Horloge, Couzes, el Duque de Berry, trogloditas, una casa de viticultor, Anatole Dauvergne, un torreón de Philippe Auguste, Reine Margot, el Marchidial... Venga a descubrir los inesperados tesoros del País de Issoire"
    ],
    "nl": [
      "Arkose, Saint-Austremoine, de Tour de l'Horloge, Couzes, de Duc de Berry, troglodytes, een wijnbouwershuis, Anatole Dauvergne, een Philippe Auguste donjon, Reine Margot, de Marchidial... Kom en ontdek de onverwachte schatten van het Pays d'Issoire!"
    ]
  },
  "rdfs:label": {
