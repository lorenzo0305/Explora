  "rdfs:comment": {
    "de": [
      "Ein Spielcafé und ein Spielladen, der von einem Paar aus Tençois betrieben wird.  \r\nEntdecken Sie eine Auswahl an Spielen und kreativen Hobbys für jedes Alter, egal ob Sie ein Gelegenheitsspieler oder ein Eingeweihter sind..."
    ],
    "en": [
      "A games café and store run by a local couple.  \r\nDiscover a selection of games and hobbies for all ages, whether you're an occasional player or an initiate..."
    ],
    "it": [
      "Una caffetteria e un negozio di giochi gestiti da una coppia locale.  \r\nScoprite una selezione di giochi, arti e mestieri per tutte le età, sia che siate giocatori occasionali o esperti..."
    ],
    "fr": [
      "Un café jeux et une boutique de jeux tenu par un couple de tençois.  \r\nDécouvrez une sélection de jeux et loisirs créatifs pour tout âge que vous soyez un joueur occasionnel ou un initié..."
    ],
    "es": [
      "Una cafetería y tienda de juegos regentada por una pareja local.  \r\nDescubre una selección de juegos y manualidades para todas las edades, ya seas un jugador ocasional o un experto..."
    ],
    "nl": [
      "Een spelletjescafé en -winkel gerund door een plaatselijk echtpaar.  \r\nOntdek een selectie spellen en kunstnijverheidsproducten voor alle leeftijden, of je nu af en toe speelt of een expert bent..."
    ]
  },
  "rdfs:label": {
