      "dc:description": {
        "de": [
          "Happy Halloween\n\n18:30 / 20:30 Uhr: Halloween-Fitness-Party, Muskelaufbau, Kardio, Herausforderung, spielerisch.\n\nPreise:\n- Halloween-Fitnessparty: 5? Abonnenten oder 8? Nicht-Abonnenten\n\nAuskunft und Informationen: +33(0)6 62 85 01 27\nOrt: Camping chez Mireille, chemin Genty, 62600 Berck"
        ],
        "en": [
          "Happy Halloween\n\n6:30 pm / 8:30 pm: Halloween fitness party, muscle-building, cardio, challenge, fun.\n\nPrices :\n- Halloween fitness party: 5? subscribers or 8? non-subscribers\n\nInformation: +33(0)6 62 85 01 27\nLocation: camping chez Mireille, chemin Genty, 62600 Berck"
        ],
        "it": [
          "Buon Halloween\n\n18.30/8.30: Halloween fitness party, potenziamento muscolare, cardio, sfida, divertimento.\n\nPrezzi :\n- Halloween fitness party: 5? abbonati o 8? non abbonati\n\nInformazioni: +33(0)6 62 85 01 27\nLuogo: Camping chez Mireille, chemin Genty, 62600 Berck"
        ],
        "fr": [
          "Happy Halloween \n\n18h30 / 20h30 : Halloween fitness party, renforcement musculaire, cardio, challenge, ludique.\n\nTarifs : \n- Soirée fitness halloween : 5€ abonnés ou 8€ non abonnés\n\nRenseignement et informations :  +33(0)6 62 85 01 27\nLieu : camping chez Mireille, chemin Genty, 62600 Berck"
        ],
        "nl": [
          "Gelukkig Halloween\n\n18.30/8.30: Halloween-fitnessparty, spieropbouw, cardio, uitdaging, plezier.\n\nPrijzen :\n- Halloween-fitness: 5? abonnees of 8? niet-abonnees\n\nInformatie: +33(0)6 62 85 01 27\nPlaats: Camping chez Mireille, chemin Genty, 62600 Berck"
        ],
        "es": [
          "Feliz Halloween\n\n18.30-20.30: Halloween fitness party, musculación, cardio, desafío, diversión.\n\nPrecios :\n- Halloween fitness party: 5? abonados u 8? no abonados\n\nInformación: +33(0)6 62 85 01 27\nLugar: Camping chez Mireille, chemin Genty, 62600 Berck"
        ]
      },
