  "rdfs:comment": {
    "de": [
      "Herstellung von handwerklich hergestellter Lindenblütenlimonade mit beruhigenden und besänftigenden Eigenschaften. Handwerkliche Herstellung auf der Grundlage von Kräutertee.\r\nAber auch im Comptoir Provençal: Tabak, Presse, FDJ, Lebensmittel, Bar, Snack."
    ],
    "en": [
      "Production of artisanal lime tree lemonade with calming and soothing properties. Handcrafted infusion factory.\r\nBut also in Comptoir Provençal : tobacco, the press, food, bar, snack."
    ],
    "it": [
      "Produzione di limonata di tiglio fatta in casa con proprietà calmanti e lenitive. Realizzato a mano da infusione\r\nMa anche al Comptoir Provençal: tabacco, stampa, fdj, cibo, bar, snack."
    ],
    "fr": [
      "Production de limonade de tilleul artisanale aux vertus calmantes et apaisantes. Fabrique artisanale à base d'infusion. \r\nMais aussi au Comptoir Provençal: tabac, presse, fdj, alimentation, bar, snack."
    ],
    "nl": [
      "Productie van traditionele lindenlimonade met kalmerende en verzachtende eigenschappen. Traditionele productie op basis van infusie.\r\nOok bij Comptoir Provençal: tabakswinkel, tijdschriftenhandel, levensmiddelenwinkel, bar, snackbar."
    ],
    "es": [
      "Elaboración de limonada de tilo casera con propiedades calmantes y sedantes. Hecho a mano a partir de una infusión\r\nPero también en el Comptoir Provençal: tabaco, prensa, fdj, comida, bar, merienda."
    ]
  },
