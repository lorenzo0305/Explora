  "rdfs:comment": {
    "de": [
      "Ganzjährig geöffneter Außenspielplatz mit 3 Inseln in Chamrousse 1750 - Roche Béranger: spielerischer Kletterbereich für alle Niveaus mit Routen für 20 Kletterer.\r\nErstellt von EP Climbing."
    ],
    "en": [
      "3-island outdoor play area open all year round at Chamrousse 1750 - Roche Béranger: fun climbing area for all levels with routes for 20 climbers.\r\nCreated by EP Climbing."
    ],
    "it": [
      "Area giochi all'aperto con 3 isole aperta tutto l'anno a Chamrousse 1750 - Roche Béranger: divertente area di arrampicata per tutti i livelli con percorsi per 20 arrampicatori.\r\nCreato da EP Climbing."
    ],
    "fr": [
      "Aire de jeux extérieure de 3 îlots ouverte à l'année à Chamrousse 1750 - Roche Béranger : zone ludique d'escalade pour tous les niveaux avec des voies pour 20 grimpeurs.\r\nRéalisée par EP Climbing."
    ],
    "es": [
      "Zona de juegos al aire libre con 3 islas abierta todo el año en Chamrousse 1750 - Roche Béranger: divertida zona de escalada para todos los niveles con vías para 20 escaladores.\r\nCreado por EP Climbing."
    ],
    "nl": [
