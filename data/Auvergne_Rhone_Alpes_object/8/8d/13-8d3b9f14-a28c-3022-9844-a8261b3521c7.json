  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine Reise durch die 600-jährige Geschichte des Schlosses. Tauchen Sie ein in das Mittelalter, entdecken Sie das größte Trebuchet der Welt und die faszinierende Geschichte der Seidenraupenzucht. Mittelalterliche Animationen und Vorführungen."
    ],
    "en": [
      "Embark on a journey of total immersion to discover the castle's 600 years of history. Delve into the heart of the Middle Ages, discover the world's largest trebuchet and the fascinating history of silkworm breeding. Medieval entertainment and shows."
    ],
    "it": [
      "Intraprendete un viaggio totalmente immersivo alla scoperta dei 600 anni di storia del castello. Immergetevi nel cuore del Medioevo, scoprite il trabucco più grande del mondo e l'affascinante storia dell'allevamento dei bachi da seta. Intrattenimento e spettacoli medievali."
    ],
    "fr": [
      "Embarquez pour une immersion totale à la découverte des 600 années d’histoire du château. Plongez au cœur du moyen-âge, découvrez le plus grand trébuchet au monde et la fascinante histoire de l’élevage du vers à soie. Animations et spectacles médiévaux."
    ],
    "nl": [
      "Kasteel uit de late Middeleeuwen, centrum van religieuze oorlogen in de Vivarais en een van grootste zijderupskwekerijen uit de regio. Ontmoet het spook van de vergeetput, de wondere wereld van de zijderupsen en geniet van het uitzicht over de Cevennen."
    ],
    "es": [
      "Embárquese en un viaje totalmente envolvente para descubrir los 600 años de historia del castillo. Sumérjase en el corazón de la Edad Media, descubra el trebuchet más grande del mundo y la fascinante historia de la cría de gusanos de seda. Entretenimiento y espectáculos medievales."
    ]
  },
