  "rdfs:comment": {
    "de": [
      "Das Hilton Évian-les-Bains liegt ideal am Ufer des Genfersees und am Fuße der französischen Alpen und bietet Ihnen eine Mischung aus Eleganz und Modernität."
    ],
    "en": [
      "Ideally located on the shores of Lake Geneva and at the foot of the French Alps, the Hilton Évian-les-Bains offers services that combine refinement and modernity."
    ],
    "it": [
      "Situato in posizione ideale sulle rive del Lago di Ginevra e ai piedi delle Alpi francesi, l'Hilton Évian-les-Bains offre un mix di raffinatezza e modernità."
    ],
    "fr": [
      "Idéalement situé sur les rives du lac Léman et au pied des Alpes françaises, le Hilton Évian-les-Bains offre des prestations mêlant raffinement et modernité."
    ],
    "es": [
      "Idealmente situado a orillas del lago Lemán y al pie de los Alpes franceses, el Hilton Évian-les-Bains ofrece una mezcla de refinamiento y modernidad."
    ],
    "nl": [
      "Het Hilton Évian-les-Bains is ideaal gelegen aan de oevers van het Meer van Genève en aan de voet van de Franse Alpen en biedt een mix van verfijning en moderniteit."
    ]
  },
