  "rdfs:comment": {
    "de": [
      "Erkunden Sie die magischen Pisten des Altiports, darunter zahlreiche Spielpisten und ihre Animationen: Inuit-Piste, Tierpiste, Parallelslalom oder auch gesicherter Rodelbereich."
    ],
    "en": [
      "Explore the magical slopes of the Altiport, including many fun tracks and their animations : Inuit slope, Animal slope, Parallel Slalom..."
    ],
    "it": [
      "Esplorate le magiche piste dell'Altiport, tra cui molte piste divertenti e le loro animazioni: la pista Inuit, la pista degli animali, lo slalom parallelo e l'area sicura per lo slittino."
    ],
    "fr": [
      "Explorer les pistes magiques de l'Altiport, parmi lesquelles de nombreuses pistes ludiques et leurs animations : piste des Inuits, piste des animaux, slalom parallèle ou encore espace luge sécurisé."
    ],
    "nl": [
      "Ontdek de magische pistes van het Altiport, met vele fun-routes en hun animaties: de Inuit-run, de dierenpiste, de parallelle slalom en het veilige rodelgebied."
    ],
    "es": [
      "Explore las mágicas pistas del Altiport, incluyendo muchas pistas divertidas y sus animaciones: la pista de los inuit, la pista de los animales, el slalom paralelo y la zona de luge seguro."
    ]
  },
