  "rdfs:comment": {
    "de": [
      "Sehr angenehmer Park gegenüber dem Stadion Lesdiguières. Dieser Park ist der ideale Ort, um einen angenehmen Tag in der Nähe des Stadtzentrums von Grenoble zu verbringen. Er verfügt über ein zentrales Wasserbecken, Kinderspielplätze, einen kleinen Zug und einen Sportparcours."
    ],
    "en": [
      "Very pleasant park opposite the Lesdiguières stadium. This park is the ideal place to spend a pleasant day close to Grenoble city center, with its central pool, children's play areas, little train and sports trail."
    ],
    "it": [
      "Parco molto piacevole situato di fronte allo stadio di Lesdiguières. Questo parco è il luogo ideale per trascorrere una piacevole giornata vicino al centro di Grenoble, con la sua piscina centrale, i parchi giochi per bambini, il trenino e il campo sportivo."
    ],
    "fr": [
      "Parc très agréable situé face au stade Lesdiguières. Ce parc est le lieu idéal pour passer une agréable journée à proximité du centre ville de Grenoble, avec son bassin central, ses aires de jeux pour les enfants, son petit train et son parcours sportif."
    ],
    "nl": [
      "Zeer aangenaam park gelegen tegenover het stadion van Lesdiguières. Dit park is de ideale plek om een aangename dag door te brengen in de buurt van het centrum van Grenoble, met zijn centrale zwembad, kinderspeelplaatsen, treintje en sportparcours."
    ],
    "es": [
      "Un parque muy agradable situado frente al estadio de Lesdiguières. Este parque es el lugar ideal para pasar un día agradable cerca del centro de Grenoble, con su piscina central, zonas de juegos infantiles, trenecito y sendero deportivo."
    ]
  },
