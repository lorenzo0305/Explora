  "rdfs:comment": {
    "de": [
      "Côté Saône\" ist eine Institution im Dienste der Papillen derer, die man liebt.\r\nEine spritzige und leckere Küche, die mit frischen Produkten zubereitet wird, die größtenteils von regionalen Erzeugern stammen, und eine sorgfältig ausgewählte Weinkarte."
    ],
    "en": [
      "\"Côté Saône” is an institution at the service of the taste buds of those we love.\r\nA sparkling and gourmet cuisine, prepared with fresh products, mostly from regional producers and a carefully selected wine list."
    ],
    "it": [
      "Côté Saône\" è un'istituzione al servizio del palato di chi amiamo.\r\nCucina frizzante e gourmet preparata con prodotti freschi, per lo più provenienti da produttori regionali, e una carta dei vini accuratamente selezionata."
    ],
    "fr": [
      "Côté Saône » est une institution au service des papilles de ceux que l’on aime.\r\nUne cuisine pétillante et gourmande, préparée avec des produits frais, issus pour la plupart de producteurs régionaux et une carte des vins sélectionnée avec soin."
    ],
    "nl": [
      "Côté Saône\" is een instituut dat de smaakpapillen van onze geliefden bedient.\r\nEen sprankelende, gastronomische keuken bereid met verse producten, meestal van regionale producenten, en een zorgvuldig geselecteerde wijnkaart."
    ],
    "es": [
      "Côté Saône\" es una institución al servicio del paladar de nuestros seres queridos.\r\nEspumosos, cocina gourmet elaborada con productos frescos, en su mayoría de productores regionales, y una carta de vinos cuidadosamente seleccionada."
    ]
  },
