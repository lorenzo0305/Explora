  "rdfs:comment": {
    "de": [
      "Diese Abtei aus dem 12. Jahrhundert beherbergt mehrere Gebäude, die im 18. Jahrhundert nach einem Brand restauriert wurden. Sie ist im romanischen Zisterzienserstil gehalten. Das Gebäude zeichnet sich durch eine Porta aus dem 14. Jahrhundert aus, von der es in Frankreich nur wenige gibt."
    ],
    "en": [
      "This 12th-century abbey houses several buildings, restored in the 18th century following a fire. It has a Cistercian Romanesque style. The building is characterized by its 14th century porter: there are very few in France."
    ],
    "it": [
      "Questa abbazia del XII secolo comprende diversi edifici, restaurati nel XVIII secolo in seguito a un incendio. È costruita in stile romanico cistercense. L'edificio si distingue per la sua portineria del XIV secolo, una delle poche del genere in Francia."
    ],
    "fr": [
      "Cette abbaye du XIIe siècle regroupe plusieurs bâtiments, restaurés au XVIIIe siècle suite à un incendie. Elle présente un style roman cistercien. L’édifice se caractérise par sa porterie datant du XIVe siècle : il n’en existe que très peu en France."
    ],
    "es": [
      "Esta abadía del siglo XII comprende varios edificios, restaurados en el siglo XVIII tras un incendio. Es de estilo románico cisterciense. El edificio destaca por su portería del siglo XIV, una de las pocas de este tipo en Francia."
    ],
    "nl": [
      "Deze 12e-eeuwse abdij bestaat uit verschillende gebouwen, gerestaureerd in de 18e eeuw na een brand. Het is gebouwd in cisterciënzer Romaanse stijl. Het gebouw valt op door het 14e-eeuwse poortgebouw, een van de weinige in zijn soort in Frankrijk."
    ]
  },
  "rdfs:label": {
