  "rdfs:comment": {
    "de": [
      "Bibliothek, Videothek und Spielothek. Im Zentrum des Ortes gelegen, finden Sie hier eine große Auswahl an Büchern, DVDs und einigen Gesellschaftsspielen sowie einen gemütlichen Raum zum Lesen oder Recherchieren."
    ],
    "en": [
      "Library, video library and games library. Located right in the centre of the resort, you'll find a vast selection of books, DVDs and a few board games, as well as a comfortable space for reading or researching."
    ],
    "it": [
      "Biblioteca, videoteca e ludoteca. Situata al centro del resort, offre una vasta selezione di libri, DVD e alcuni giochi da tavolo, oltre a uno spazio confortevole per leggere o fare ricerche."
    ],
    "fr": [
      "Bibliothèque, vidéothèque et ludothèque. Installée en plein centre de la station, vous y trouverez un vaste choix de livres, DVD et quelques jeux de société, ainsi qu'un espace confortable pour lire ou vous documenter."
    ],
    "nl": [
      "Bibliotheek, videotheek en spelletjesbibliotheek. In het centrum van het resort vind je een uitgebreide selectie boeken, dvd's en een paar bordspellen, evenals een comfortabele ruimte om te lezen of onderzoek te doen."
    ],
    "es": [
      "Biblioteca, videoteca y ludoteca Situada justo en el centro del complejo, encontrará una amplia selección de libros, DVD y algunos juegos de mesa, así como un cómodo espacio para leer o investigar."
    ]
  },
  "rdfs:label": {
    "en": [
