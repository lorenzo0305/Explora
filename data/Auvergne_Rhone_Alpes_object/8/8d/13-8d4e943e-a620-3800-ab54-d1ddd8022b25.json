      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/5031de1a-7369-3a13-82c4-ae0e56c71c41",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Schulferien: Montag bis Freitag von 16:00 bis 19:00 Uhr.\r\nAußerhalb der Schulferien: montags, mittwochs und freitags von 16:30 bis 19:00 Uhr.\r\nUnd das ganze Jahr über: dienstags vormittags von 10:30 bis 12:00 Uhr.\r\nAußerhalb der Öffnungstage und -zeiten besteht die Möglichkeit, die Bücher im Tourismusbüro abzugeben."
            ],
            "en": [
              "School vacations: Monday to Friday, 4pm to 7pm.\r\nOutside school vacations: Mondays, Wednesdays and Fridays, 4:30 pm to 7:00 pm.\r\nAnd all year round, Tuesday mornings from 10.30am to 12pm.\r\nOutside opening hours, books can be dropped off at the Tourist Office."
            ],
            "it": [
              "Vacanze scolastiche: dal lunedì al venerdì, dalle 16.00 alle 19.00.\r\nFuori dalle vacanze scolastiche: lunedì, mercoledì e venerdì dalle 16.30 alle 19.00.\r\nE tutto l'anno, il martedì mattina dalle 10.30 alle 12.00.\r\nAl di fuori degli orari di apertura, i libri possono essere consegnati all'Ufficio del Turismo."
            ],
            "fr": [
              "Vacances scolaires : du lundi au vendredi de 16h à 19h.\r\nHors vacances scolaires : lundi, mercredi et vendredi de 16h30 à 19h00.\r\nEt toute l'année, les mardis matins de 10h30 à 12h.\r\nEn dehors des jours et horaires d'ouverture, possibilité de déposer les livres à l'Office de Tourisme."
            ],
            "es": [
              "Vacaciones escolares: de lunes a viernes, de 16.00 a 19.00 h.\r\nFuera de vacaciones escolares: lunes, miércoles y viernes de 16.30 a 19.00 h.\r\nY durante todo el año, los martes por la mañana de 10.30 a 12.00 h.\r\nFuera del horario de apertura, los libros pueden entregarse en la Oficina de Turismo."
            ],
            "nl": [
              "Schoolvakanties: maandag t/m vrijdag van 16.00 tot 19.00 uur.\r\nBuiten schoolvakanties: maandag, woensdag en vrijdag van 16.30 tot 19.00 uur.\r\nEn het hele jaar door op dinsdagochtend van 10.30 tot 12.00 uur.\r\nBuiten openingstijden kunnen boeken worden afgegeven bij het VVV-kantoor."
            ]
          },
