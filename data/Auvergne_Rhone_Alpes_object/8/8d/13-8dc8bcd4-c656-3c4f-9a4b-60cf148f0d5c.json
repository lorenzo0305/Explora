  "rdfs:comment": {
    "de": [
      "Die Gemeinde Saint-Paulien verfügt über einen Pumptrack-Platz, der für Fahrräder, BMX-Räder, Roller, Inlineskates, Draisinen und Skateboards gedacht ist. Der Platz ist dieser jungen Sportart gewidmet, Motor- und Elektrofahrzeuge sind verboten."
    ],
    "en": [
      "The commune of Saint-Paulien has a pumptrack area for bikes, BMX, scooters, rollerblades, draisienne and skateboards. The area is dedicated to this recent sporting discipline, and motorized and electric vehicles are prohibited."
    ],
    "it": [
      "Saint-Paulien dispone di un'area di pumptrack per biciclette, BMX, monopattini, rollerblade, draisienne e skateboard. L'area è dedicata a questo nuovo sport e sono vietati i veicoli motorizzati ed elettrici."
    ],
    "fr": [
      "La commune de Saint-Paulien dispose d'un espace pumptrack, destiné aux  vélo, BMX, trottinette, roller, draisienne et skate-board. Le lieu est consacré à cette discipline sportive récente, les véhicules à moteur et électrique sont interdits."
    ],
    "nl": [
      "Saint-Paulien heeft een pumptrackzone voor fietsen, BMX-fietsen, steps, skeelers, draisienne-fietsen en skateboards. Het gebied is gewijd aan deze nieuwe sport en gemotoriseerde en elektrische voertuigen zijn verboden."
    ],
    "es": [
      "Saint-Paulien cuenta con una zona de pumptrack para bicicletas, bicicletas BMX, patinetes, patines, bicicletas draisienne y monopatines. La zona está dedicada a este nuevo deporte, y los vehículos motorizados y eléctricos están prohibidos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pumptrack"
    ]
  },
