  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Haute Maurienne Vanoise, ihre Kletterrouten, Via Ferrata, wilden Canyons, Bergtouren oder auch Gletscherwanderungen! Begeben Sie sich mit unseren Bergführern in luftige Höhen und erleben Sie einen unvergesslichen Moment!"
    ],
    "en": [
      "Come and discover the Haute Maurienne Vanoise, its climbing routes, via ferrata, its wild canyons, its mountaineering races and its glacier hikes! Take to the heights with our high mountain guides for an unforgettable moment!"
    ],
    "it": [
      "Venite a scoprire la Haute Maurienne Vanoise, le sue vie di arrampicata, le sue vie ferrate, i suoi canyon selvaggi, i suoi corsi di alpinismo o le sue escursioni sui ghiacciai! Prendete l'altezza con le nostre guide di alta montagna per un momento indimenticabile!"
    ],
    "fr": [
      "Venez découvrir la Haute Maurienne Vanoise, ses voies d’escalade, via ferrata, ses canyons sauvages, ses courses d’alpinisme ou encore ses randonnées glaciaires ! Prenez de la hauteur avec nos guides de haute montagne pour un moment inoubliable !"
    ],
    "es": [
      "Venga a descubrir la Haute Maurienne Vanoise, sus vías de escalada, sus vías ferratas, sus cañones salvajes, sus cursos de alpinismo o sus excursiones por los glaciares ¡Tome la altura con nuestros guías de alta montaña para un momento inolvidable!"
    ],
    "nl": [
      "Kom en ontdek de Haute Maurienne Vanoise, zijn klimroutes, via ferrata, zijn wilde canyons, zijn bergsportraces en zijn gletsjerwandelingen! Ga de hoogte in met onze hooggebergtegidsen voor een onvergetelijk moment!"
    ]
  },
  "rdfs:label": {
    "en": [
