  "rdfs:comment": {
    "de": [
      "Neben der Pump Track-Piste von Aime-La-Plagne und am Anfang des Grünen Wegs gelegen, verfügt der Ort über\r\nneue Einrichtungen für Sport- und Freizeitaktivitäten."
    ],
    "en": [
      "Situated next to the Pump Track in Aime-La-Plagne and at the start of the cycle path, the site has new sports and leisure equipment."
    ],
    "it": [
      "Situato accanto alla pista di pompaggio di Aime-La-Plagne e all'inizio della greenway, il sito vanta nuove strutture per lo sport e il tempo libero\r\nnuove strutture per lo sport e il tempo libero."
    ],
    "fr": [
      "Situé à côté de la piste de Pump Track d’Aime-La-Plagne et au départ de la voie verte, le site dispose de\r\nnouveaux équipements pour la pratique sportive et les activités de loisirs."
    ],
    "es": [
      "Situado junto a la Pista de Bombeo de Aime-La-Plagne y al comienzo de la vía verde, el recinto cuenta con nuevas instalaciones para actividades deportivas y de ocio\r\nnuevas instalaciones para actividades deportivas y de ocio."
    ],
    "nl": [
      "De site ligt naast de Aime-La-Plagne Pump Track en aan het begin van de greenway en beschikt over nieuwe faciliteiten voor sport- en vrijetijdsactiviteiten.\r\nnieuwe faciliteiten voor sport- en vrijetijdsactiviteiten."
    ]
  },
