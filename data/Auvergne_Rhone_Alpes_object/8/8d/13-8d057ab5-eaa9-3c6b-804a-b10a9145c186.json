  "rdfs:comment": {
    "de": [
      "Die Freizeitanlage Les Mottets ist eine grüne Lunge am südlichen Ende des Lac du Bourget: Spaziergänge, Kinderspiele, Picknicks ... um eine gute Zeit mit den Füßen im Gras zu verbringen."
    ],
    "en": [
      "The Mottets leisure center is a green lung at the southern end of Lake Bourget: walks, children's games, picnics... everything you need to have a good time with your feet in the grass."
    ],
    "it": [
      "La base di svago dei Mottets è un polmone verde all'estremità sud del lago del Bourget: passeggiate, giochi per bambini, picnic... tutto il necessario per passare dei bei momenti con i piedi nell'erba."
    ],
    "fr": [
      "La base de loisirs des Mottets est un poumon vert à l'extrémité sud du lac du Bourget : balade, jeux pour enfants, pique-nique ... de quoi passer un bon moment les pieds dans l'herbe."
    ],
    "nl": [
      "Het recreatiecentrum Mottets is een groene long aan de zuidkant van het Lac du Bourget, met wandelingen, spelletjes voor kinderen, picknicks... genoeg om een leuke tijd door te brengen met je voeten in het gras."
    ],
    "es": [
      "El centro de ocio de Mottets es un pulmón verde en el extremo sur del lago du Bourget, que ofrece paseos, juegos infantiles, picnics... suficiente para pasar un buen rato con los pies en la hierba."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mottets Recreation Area"
    ],
    "it": [
      "Area Ricreativa dei Mottets"
    ],
    "fr": [
      "Base de loisirs des Mottets"
    ]
  },
