  "rdfs:comment": {
    "de": [
      "Das peruanische Latino-Restaurant bietet eine kulinarische Reise nach Peru, aber auch nach Argentinien.\r\nOb vor Ort oder zum Mitnehmen, entdecken Sie neue Geschmacksrichtungen, die Sie begeistern werden!"
    ],
    "en": [
      "Peruvian Latino restaurant offering a culinary journey through Peru and Argentina.\r\nWhether on the premises or to take away, come and discover new flavours that will delight you!"
    ],
    "it": [
      "Ristorante latino-peruviano che offre un viaggio culinario attraverso il Perù e l'Argentina.\r\nSia che scegliate di mangiare all'interno o di portar via, venite a scoprire nuovi sapori che vi delizieranno!"
    ],
    "fr": [
      "Restaurant latino péruvien proposant un véritable voyage culinaire au Pérou mais aussi en Argentine à travers nos plats.\r\nQue ce soit sur place ou à emporter, venez découvrir de nouvelles saveurs qui vous raviront!"
    ],
    "es": [
      "Restaurante peruano latino que ofrece un viaje culinario por Perú y Argentina.\r\nYa sea para comer o para llevar, venga y descubra nuevos sabores que le encantarán"
    ],
    "nl": [
      "Peruaans Latijns-Amerikaans restaurant biedt een culinaire reis door Peru en Argentinië.\r\nOf je nu kiest om te eten of om mee te nemen, kom en ontdek nieuwe smaken die je zullen verrukken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant El Inca"
    ]
  },
