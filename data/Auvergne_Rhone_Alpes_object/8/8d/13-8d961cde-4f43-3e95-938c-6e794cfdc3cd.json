  "rdfs:comment": {
    "de": [
      "Ziemlich rollende Strecke durch die charakteristischen Landschaften des Plateau de Retord, stellenweise Panorama auf den Mont-Blanc. Ideal für die ganze Familie."
    ],
    "en": [
      "A fairly rolling route through the characteristic landscapes of the Plateau de Retord, with panoramic views of Mont Blanc in places. Ideal for families."
    ],
    "it": [
      "Un percorso abbastanza facile attraverso i paesaggi caratteristici del Plateau de Retord, con vista panoramica sul Monte Bianco in alcuni punti. Ideale per le famiglie."
    ],
    "fr": [
      "Parcours assez roulant à travers les paysages caractéristiques du Plateau de Retord, panorama sur le Mont-Blanc par endroit. Idéal à faire en famille."
    ],
    "es": [
      "Una ruta bastante fácil a través de los paisajes característicos del Plateau de Retord, con vistas panorámicas del Mont Blanc en algunos lugares. Ideal para familias."
    ],
    "nl": [
      "Een vrij gemakkelijke route door de karakteristieke landschappen van het Plateau de Retord, met hier en daar een panoramisch uitzicht op de Mont Blanc. Ideaal voor gezinnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours VTTAE 31 vert - Les fermes de Retord - Espace FFC Ain Forestière"
    ]
  },
