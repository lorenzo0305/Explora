  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Galettes und Crêpes, die aus lokalen und biologischen Produkten hergestellt werden. Unser Restaurant mit Terrasse erwartet Sie auf einem kleinen Platz etwas abseits des historischen Zentrums. Haustiere sind willkommen."
    ],
    "en": [
      "Come and discover our pancakes and crepes made from local and organic products. Our restaurant with terrace awaits you, on a small square slightly away from the historical centre. Animals are welcome."
    ],
    "it": [
      "Venite a scoprire le nostre galettes e crêpes a base di prodotti locali e biologici. Il nostro ristorante con terrazza vi aspetta, in una piazzetta leggermente lontana dal centro storico. Gli animali sono i benvenuti."
    ],
    "fr": [
      "Venez découvrir nos galettes et crêpes confectionnées à partir de produits locaux et biologiques. Notre restaurant avec terrasse vous attend, sur une petite place légèrement à l'écart du centre historique. Les animaux sont les bienvenus."
    ],
    "es": [
      "Venga a descubrir nuestras galletas y crepes elaboradas con productos locales y ecológicos. Nuestro restaurante con terraza le espera, en una pequeña plaza ligeramente alejada del centro histórico. Los animales son bienvenidos."
    ],
    "nl": [
      "Kom en ontdek onze galettes en crêpes gemaakt van lokale en biologische producten. Ons restaurant met terras wacht op u, op een pleintje iets buiten het historische centrum. Dieren zijn welkom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maison d'Alexandre"
    ]
  },
