  "rdfs:comment": {
    "de": [
      "Gasthaus, Unterkunft, Bar, Restaurant, Lebensmittelgeschäft mit regionalen Produkten. Wir arbeiten mit frischen Produkten von lokalen Erzeugern, die Speisekarte wechselt zu jeder Jahreszeit."
    ],
    "en": [
      "Inn, gîte, bar, restaurant, local grocery store and regional products. We work with fresh produce from local producers, and our menu changes with the seasons."
    ],
    "it": [
      "Locanda, gîte, bar, ristorante, alimentari locali e prodotti regionali. Lavoriamo con prodotti freschi provenienti da produttori locali e il menu cambia in base alle stagioni."
    ],
    "fr": [
      "Auberge, gîte, bar, restaurant, épicerie de proximité et de produits régionaux. Nous travaillons avec des produits frais de producteurs locaux, la carte change à chaque saison."
    ],
    "es": [
      "Posada, casa rural, bar, restaurante, tienda de comestibles y productos regionales. Trabajamos con productos frescos de productores locales, y el menú cambia con las estaciones."
    ],
    "nl": [
      "Herberg, gîte, bar, restaurant, plaatselijke kruidenierswinkel en streekproducten. We werken met verse producten van lokale producenten en het menu verandert met de seizoenen."
    ]
  },
  "rdfs:label": {
