  "rdfs:comment": {
    "de": [
      "L'Arbre à Fil, Freizeit- und Abenteuerpark für alle von 2 bis 99 Jahren! Seilrutschen, hüpfende Netze, kreative Workshops, ein schiefes Haus und vieles mehr. Nervenkitzel und Natur pur. Genießen Sie auch das Restaurant am Wasser."
    ],
    "en": [
      "L'Arbre à Fil, a leisure and adventure park for all ages 2 to 99! Zip lines, bouncing nets, creative workshops, leaning house and much more. Sensations and nature await you. Enjoy the waterfront restaurant."
    ],
    "it": [
      "L'Arbre à Fil, un parco divertimenti e avventura per tutti i bambini dai 2 ai 99 anni! Traversata tirolese, reti rimbalzanti, laboratori creativi, casa pendente e molto altro ancora. Sensazioni e natura vi aspettano. E non dimenticate il ristorante sull'acqua."
    ],
    "fr": [
      "L'Arbre à Fil, parc de loisir et d'aventure pour tous de 2 à 99 ans ! Tyroliennes, filets bondissants, ateliers créatifs, maison penchée et bien plus. Sensations et nature au rendez-vous. Profitez aussi du resto au bord de l'eau."
    ],
    "nl": [
      "L'Arbre à Fil, een vrijetijds- en avonturenpark voor iedereen van 2 tot 99 jaar! Tiroolse traverse, springnetten, creatieve workshops, schommelhuis en nog veel meer. Sensaties en natuur wachten op je. En vergeet het restaurant aan het water niet."
    ],
    "es": [
      "L'Arbre à Fil, ¡un parque de ocio y aventura para todos los públicos de 2 a 99 años! Tirolina, redes de rebote, talleres creativos, casa inclinada y mucho más. Sensaciones y naturaleza le esperan. Y no olvide el restaurante a orillas del agua."
    ]
  },
  "rdfs:label": {
