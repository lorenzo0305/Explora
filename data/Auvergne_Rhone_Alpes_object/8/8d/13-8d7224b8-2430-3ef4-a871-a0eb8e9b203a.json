  "rdfs:comment": {
    "de": [
      "Le potager de Dantonnière: Permakultureller Obst- und Gemüsegarten\r\nKörbe mit Gemüse und Obst der Saison und Vendirecfür Personen, die sich für alte, biologische und nach umweltfreundlichen Techniken gezüchtete Sorten interessieren."
    ],
    "en": [
      "Le potager de Dantonnière: permaculture orchard and market garden\r\nSeasonal vegetable and fruit baskets and vendirecfor people interested in old-fashioned, organic varieties grown using environmentally-friendly techniques."
    ],
    "it": [
      "Le potager de Dantonnière: frutteto e orto in permacultura\r\nCesti di verdura e frutta di stagione per chi è interessato a varietà antiche e biologiche coltivate con tecniche ecologiche."
    ],
    "fr": [
      "Le potager de Dantonnière : verger-maraîcher permaculturel \r\nPaniers de légumes et fruits de saison et vendirecpour des personnes intéressées par des variétés anciennes, biologiques et conduites selon des techniques respectueuses de l'environnement."
    ],
    "nl": [
      "Le potager de Dantonnière: permacultuur boomgaard en tuinderij\r\nManden met seizoensgroenten en -fruit voor mensen die geïnteresseerd zijn in oude, biologische variëteiten die met milieuvriendelijke technieken worden geteeld."
    ],
    "es": [
      "Le potager de Dantonnière: huerto y jardín de permacultura\r\nCestas de verduras y frutas de temporada para los interesados en variedades antiguas y ecológicas cultivadas con técnicas respetuosas con el medio ambiente."
    ]
  },
