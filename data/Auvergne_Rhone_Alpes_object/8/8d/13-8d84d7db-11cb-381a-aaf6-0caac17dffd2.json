  "rdfs:comment": {
    "de": [
      "Delphine Cance ist seit jeher von Pferden begeistert. Seit 20 Jahren ist sie staatlich geprüfte Reitlehrerin. Der Verein Poney and Co heißt Sie in seinen Räumlichkeiten herzlich willkommen."
    ],
    "en": [
      "Delphine Cance has always had a passion for horses. A qualified riding instructor for 20 years, Poney and Co welcomes you to its premises."
    ],
    "it": [
      "Delphine Cance ha sempre avuto una passione per i cavalli. Istruttrice di equitazione qualificata da 20 anni, Poney and Co vi dà il benvenuto nei suoi locali."
    ],
    "fr": [
      "Delphine Cance est passionnée par les chevaux depuis toujours. Monitrice d'équitation diplômée d'Etat depuis 20 ans, l'association Poney and Co vous accueille dans ses locaux."
    ],
    "es": [
      "Delphine Cance siempre ha sentido pasión por los caballos. Profesora de equitación titulada desde hace 20 años, Poney and Co le da la bienvenida a sus instalaciones."
    ],
    "nl": [
      "Delphine Cance heeft altijd al een passie voor paarden gehad. Poney and Co is al 20 jaar gediplomeerd paardrijinstructrice en heet je van harte welkom."
    ]
  },
