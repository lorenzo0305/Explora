  "rdfs:comment": {
    "de": [
      "Das Bistro Ermitage, Ihre neue Feinschmeckeradresse in St Nizier, eine entspannende Pause mit Freunden oder der Familie. Das Bistrot Ermitage bietet keine festgelegte Speisekarte, sondern eine Bistroküche mit fünf oder sechs regelmäßig wechselnden Auswahlmöglichkeiten."
    ],
    "en": [
      "The Bistrot Ermitage is your new gourmet address in St Nizier for a relaxing break with friends or family. The Bistrot Ermitage doesn’t have a set menu but has bistro-style cuisine with 5 or 6 choices that change regularly."
    ],
    "it": [
      "Il Bistrot Ermitage è il vostro nuovo indirizzo gastronomico a St Nizier, per una pausa rilassante con gli amici o la famiglia. Il Bistrot Ermitage non ha un menu fisso, ma offre una cucina da bistrot con 7 o 8 scelte che cambiano regolarmente."
    ],
    "fr": [
      "Le bistrot Ermitage votre nouvelle adresse gourmande à St Nizier, une pause détente entre amis ou en famille. Le Bistrot Ermitage ne propose  pas de carte défini mais une cuisine de Bistrot avec 7 ou 8 choix qui changent régulièrement."
    ],
    "es": [
      "El Bistrot Ermitage es su nueva dirección gastronómica en St Nizier, para una escapada relajante con amigos o en familia. El Bistrot Ermitage no ofrece un menú fijo, sino una cocina de bistró con 7 u 8 opciones que cambian regularmente."
    ],
    "nl": [
      "Bistrot Ermitage is uw nieuwe gastronomische adres in St Nizier, voor een ontspannende pauze met vrienden of familie. Bistrot Ermitage heeft geen vast menu, maar biedt een bistrokeuken met 7 of 8 regelmatig wisselende keuzes."
    ]
  },
