  "rdfs:comment": {
    "de": [
      "Am Fuße des Alpengebiets Montagnes de Lans gibt es eine gesicherte Rodelbahn, die für die Kleinsten frei zugänglich ist."
    ],
    "en": [
      "At the foot of the Montagnes de Lans alpine area, a safe sledging run is available for all the youngest visitors."
    ],
    "it": [
      "Ai piedi del comprensorio sciistico alpino di Montagnes de Lans, una pista da slittino sicura è liberamente accessibile ai più piccoli."
    ],
    "fr": [
      "Au pied du domaine alpin des Montagnes de Lans, une piste de luge sécurisée est accessible librement aux plus jeunes."
    ],
    "es": [
      "Situado a pocos kilómetros del pueblo, al nivel de la zona de esquí alpino de las montañas Lans, se puede acceder a una pista de trineo.\r\nPista segura separada de los flujos de esquiadores."
    ],
    "nl": [
      "Aan de voet van het alpine skigebied Montagnes de Lans is een veilige rodelbaan vrij toegankelijk voor de allerkleinsten."
    ]
  },
