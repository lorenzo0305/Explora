  "rdfs:comment": {
    "de": [
      "Jean Christophe, ein leidenschaftlicher Handwerker, empfängt Sie in seinem Atelier und seiner Boutique im Herzen von Vichy. Er ist Gründer der Marke La Kourone und entwirft seine originellen Kreationen."
    ],
    "en": [
      "A passionate craftsman, Jean Christophe welcomes you to his workshop/boutique in the heart of Vichy. Founder of the La Kourone brand, come and discover his original creations."
    ],
    "it": [
      "Artigiano appassionato, Jean Christophe vi accoglie nel suo laboratorio/negozio nel cuore di Vichy. Fondatore del marchio La Kourone, venite a scoprire le sue creazioni originali."
    ],
    "fr": [
      "Artisan passionné, Jean Christophe vous accueille dans son atelier/boutique au cœur de Vichy. Fondateur de la marque La Kourone ,venez découvrir ses créations originales ."
    ],
    "nl": [
      "Jean Christophe, een gepassioneerd ambachtsman, heet je welkom in zijn atelier/winkel in het hart van Vichy. Oprichter van het merk La Kourone, kom en ontdek zijn originele creaties."
    ],
    "es": [
      "Artesano apasionado, Jean Christophe le da la bienvenida a su taller/tienda en el corazón de Vichy. Fundador de la marca La Kourone, venga a descubrir sus originales creaciones."
    ]
  },
  "rdfs:label": {
