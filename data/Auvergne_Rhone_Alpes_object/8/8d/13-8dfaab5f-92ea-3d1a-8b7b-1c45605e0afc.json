  "rdfs:comment": {
    "de": [
      "Ich biete Ihnen durch verschiedene Aktivitäten eine Wiederverbindung mit der Natur an. Mein Leitmotiv ist die Begegnung mit der Natur durch einen wissenschaftlichen, naturalistischen, spielerischen und sensorischen Ansatz!"
    ],
    "en": [
      "I propose a reconnection with nature through a variety of activities. My leitmotiv is the encounter with nature through a scientific, naturalistic, playful and sensory approach!"
    ],
    "it": [
      "Posso aiutarvi a riconnettervi con la natura attraverso una serie di attività. Il mio leitmotiv è l'incontro con la natura attraverso un approccio scientifico, naturalistico, divertente e sensoriale!"
    ],
    "fr": [
      "Je vous propose une reconnexion à la nature à travers diverses activités. Mon leitmotiv est la rencontre avec la nature grâce à une approche scientifique, naturaliste, ludique et sensorielle !"
    ],
    "es": [
      "Puedo ayudarte a reconectar con la naturaleza a través de una serie de actividades. Mi leitmotiv es el encuentro con la naturaleza a través de un enfoque científico, naturalista, divertido y sensorial"
    ],
    "nl": [
      "Ik kan je helpen om weer in contact te komen met de natuur door middel van verschillende activiteiten. Mijn leidmotief is de ontmoeting met de natuur door middel van een wetenschappelijke, naturalistische, leuke en zintuiglijke benadering!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Passeuse de Nature"
    ]
  },
