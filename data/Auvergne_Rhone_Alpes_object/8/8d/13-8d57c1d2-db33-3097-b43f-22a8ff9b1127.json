  "rdfs:comment": {
    "de": [
      "Das Weingut ist seit 1890 eine Familiengeschichte. Lucie und Pierre bewirtschaften einen Weinberg, der aus 10 Hektar Weinbergen in Coteaux du Lyonnais besteht, mit den Rebsorten: Chardonnay, Gamay, Viognier, Gamaret, Pinot gris, Syrah in Biodynamie."
    ],
    "en": [
      "The domaine has been a family affair since 1890. Lucie and Pierre cultivate a 10-hectare vineyard in the Coteaux du Lyonnais region, with grape varieties including Chardonnay, Gamay, Viognier, Gamaret, Pinot gris and Syrah, using Biodynamic methods."
    ],
    "it": [
      "La tenuta è un affare di famiglia dal 1890. Lucie e Pierre coltivano un vigneto di 10 ettari nella regione dei Coteaux du Lyonnais, con uve Chardonnay, Gamay, Viognier, Gamaret, Pinot grigio e Syrah coltivate in modo biodinamico."
    ],
    "fr": [
      "Le domaine est une histoire familiale depuis 1890. Lucie et Pierre cultive un vignoble composé de 10 hectares de vignes en Coteaux du Lyonnais avec comme cépages : Chardonnay, Gamay, Viognier, Gamaret, Pinot gris, syrah en Biodynamie."
    ],
    "es": [
      "La propiedad es un negocio familiar desde 1890. Lucie y Pierre cultivan un viñedo de 10 hectáreas de vides en la región de Coteaux du Lyonnais, con uvas Chardonnay, Gamay, Viognier, Gamaret, Pinot gris y Syrah cultivadas biodinámicamente."
    ],
    "nl": [
      "Het domein is een familiezaak sinds 1890. Lucie en Pierre cultiveren een wijngaard van 10 hectare wijnstokken in de Coteaux du Lyonnais regio, met Chardonnay, Gamay, Viognier, Gamaret, Pinot gris en Syrah druiven die biologisch-dynamisch geteeld worden."
    ]
  },
