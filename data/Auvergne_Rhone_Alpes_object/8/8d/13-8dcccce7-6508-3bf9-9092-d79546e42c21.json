  "rdfs:comment": {
    "de": [
      "Savoyardische Gerichte und Bauernmahlzeiten; Crêperie mit savoyardischen Spezialitäten. Heimische Gerichte und Rezepte; Fondues und Raclettes, serviert mit den Wurstdelikatessen eines savoyardischen Metzgermeisters (essen Sie soviel Sie möchten!). Spezialitäten: hausgemachte Flusskrebssoße und Bauernmahlzeit. Auch Kinder sind herzlich willkommen."
    ],
    "en": [
      "Restaurant with farm and mountain specialities and mountain crêpes. Regional dishes and recipes. All-you-can-eat fondues and raclettes served with cold cuts made by a maître artisan from the Savoie region. Specialities: Homemade crayfish sauce and farmer's plate. Children welcome."
    ],
    "it": [
      "Ristorazione di montagna e di campagna. Piatti e ricette regionali. Fondute e raclettes servite con un numero illimitato di formaggi e salumi di un maestro artigiano savoiardo. Specialità: ravioli al sugo di gamberi di fiume fatti in casa."
    ],
    "fr": [
      "Restauration montagnarde et paysanne. Plats et recettes régionaux. Fondues et raclettes servies avec  fromage à volonté et avec la charcuterie d'un maître artisan savoyard . Spécialités : ravioles avec sauce aux écrevisses maison."
    ],
    "nl": [
      "Catering in berg- en plattelandsstijl. Regionale gerechten en recepten. Fondues en raclettes geserveerd met onbeperkt kaas en vleeswaren van een Savoyaardse ambachtsman. Specialiteiten: ravioli met huisgemaakte rivierkreeftsaus."
    ],
    "es": [
      "Catering de montaña y campestre. Platos y recetas regionales. Fondues y raclettes servidas con quesos y embutidos ilimitados de un maestro artesano saboyano. Especialidades: raviolis con salsa casera de cangrejo de río."
    ]
  },
  "rdfs:label": {
    "de": [
      "Le Petit Paysan"
    ],
