  "rdfs:comment": {
    "de": [
      "Restaurant-Pizzeria, Catering, Familienfeiern (Hochzeit, Taufe), Firmenessen, Cocktails, Vereinsessen.\r\nEs gibt immer einen großen Anlass, um das Saint Vic' in Anspruch zu nehmen!"
    ],
    "en": [
      "Restaurant-pizzeria, caterer, family events (weddings, christenings), corporate meals, cocktails, association meals.\r\nThere's always a great occasion to call on Le Saint Vic'!"
    ],
    "it": [
      "Ristorante-pizzeria, catering, eventi familiari (matrimoni, battesimi), pranzi aziendali, cocktail, pranzi associativi.\r\nC'è sempre una grande occasione per rivolgersi a Le Saint Vic'!"
    ],
    "fr": [
      "Restaurant-pizzéria, traiteur, évènements familiaux (mariage, baptême), repas d'entreprise, cocktails, repas d'association.\r\nIl y a toujours une grande occasion pour faire appel au Saint Vic' !"
    ],
    "es": [
      "Restaurante-pizzería, catering, eventos familiares (bodas, bautizos), comidas de empresa, cócteles, comidas de asociaciones.\r\n¡Siempre hay una buena ocasión para recurrir a Le Saint Vic'!"
    ],
    "nl": [
      "Restaurant-pizzeria, traiteur, familie-evenementen (bruiloften, doopfeesten), bedrijfsmaaltijden, cocktails, verenigingsmaaltijden.\r\nEr is altijd wel een leuke gelegenheid om een beroep te doen op Le Saint Vic'!"
    ]
  },
