  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Mont-Blanc-Massiv und bewundern Sie seine Pracht, während Sie bis zur schweizerischen und italienischen Grenze fliegen."
    ],
    "en": [
      "Discover the Mont-Blanc massif and admire its splendor as you fly to the Swiss and Italian borders."
    ],
    "it": [
      "Scoprite il massiccio del Monte Bianco e ammirate il suo splendore mentre volate verso i confini svizzeri e italiani."
    ],
    "fr": [
      "Partez à la découverte du massif du Mont-Blanc et admirez sa splendeur en volant jusqu'aux frontières suisses et italiennes."
    ],
    "nl": [
      "Ontdek het Mont Blanc-massief en bewonder de pracht en praal terwijl je naar de Zwitserse en Italiaanse grens vliegt."
    ],
    "es": [
      "Descubra el macizo del Mont Blanc y admire su esplendor mientras vuela hacia las fronteras suiza e italiana."
    ]
  },
