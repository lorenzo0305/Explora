  "rdfs:comment": {
    "de": [
      "Ein Treffpunkt für Feinschmecker in L'Isle d'Abeau!\r\nDas Relais du Catey verfügt über drei Speisesäle und bietet eine lebhafte und spontane Chefküche, die lokale Produkte in den Vordergrund stellt und die Aromen mit viel Finesse zubereitet. Ideal für einen besonderen Moment."
    ],
    "en": [
      "The Relais du Catey has 3 dining rooms and offers a lively and spontaneous chef's cuisine which highlights local products with a fine approach to flavours. Ideal for a special moment...."
    ],
    "it": [
      "Un appuntamento gastronomico a L'Isle d'Abeau!\r\nIl Relais du Catey dispone di 3 sale ristorante e propone una cucina vivace e spontanea dello chef che valorizza i prodotti locali con un approccio sottile ai sapori. Ideale per un momento di pausa."
    ],
    "fr": [
      "Rendez-vous gourmand à L’Isle d’Abeau!\r\nLe Relais du Catey dispose de 3 salles de restaurant et propose une cuisine de chef vive et spontanée qui met en avant les produits locaux avec une approche des saveurs tout en finesse. Idéal pour un moment à part."
    ],
    "es": [
      "¡Una cita gastronómica en L'Isle d'Abeau!\r\nLe Relais du Catey dispone de 3 salas de restaurante y ofrece una cocina de chef viva y espontánea que pone de relieve los productos locales con un enfoque sutil de los sabores. Ideal para un momento aparte."
    ],
    "nl": [
      "Een gastronomisch rendez-vous in L'Isle d'Abeau!\r\nLe Relais du Catey heeft 3 restaurantzalen en biedt een levendige, spontane keuken van de chef die lokale producten benadrukt met een subtiele benadering van smaken. Ideaal voor een moment apart."
    ]
  },
  "rdfs:label": {
