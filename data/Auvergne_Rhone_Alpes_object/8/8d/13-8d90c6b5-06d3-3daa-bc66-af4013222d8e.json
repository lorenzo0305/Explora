          "additionalInformation": {
            "de": [
              "Restaurant von Dienstagmittag bis Samstagabend geöffnet.\r\nÖffnungszeiten: 12.00-13.30 Uhr / 19.30-21.00 Uhr.\r\nDas Restaurant ist an bestimmten Sonntagen an Feiertagen geöffnet.\r\nBetriebsferien 3 Wochen im August/1 Woche Ende Dezember und 1 Woche Ende April."
            ],
            "en": [
              "Restaurant open Tuesday lunchtime to Saturday evening.\r\nOpening hours: 12:00-13:30 / 19:30-21:00.\r\nThe restaurant is open on some Sundays during public holidays.\r\nClosed for 3 weeks in August/1 week at the end of December and 1 week at the end of April."
            ],
            "it": [
              "Ristorante aperto dal martedì a pranzo al sabato sera.\r\nOrari di apertura: 12.00-13.30 / 19.30-21.00.\r\nIl ristorante è aperto alcune domeniche durante i giorni festivi.\r\nChiuso per 3 settimane in agosto, 1 settimana a fine dicembre e 1 settimana a fine aprile."
            ],
            "fr": [
              "Restaurant ouvert du mardi midi au samedi soir.\r\nHoraires : 12h00-13h30 / 19h30-21h.\r\nLe restaurant est ouvert certains dimanches de fêtes.\r\nFermeture annuelle 3 semaines en Août/1 semaine fin Décembre et 1 semaine fin Avril."
            ],
            "es": [
              "Restaurante abierto de martes a mediodía a sábado por la noche.\r\nHorario: 12.00-13.30 / 19.30-21.00.\r\nEl restaurante abre algunos domingos festivos.\r\nCierra 3 semanas en agosto, 1 semana a finales de diciembre y 1 semana a finales de abril."
            ],
            "nl": [
              "Restaurant geopend van dinsdagmiddag tot zaterdagavond.\r\nOpeningstijden: 12.00-13.30 / 19.30-21.00.\r\nHet restaurant is op sommige zondagen tijdens de feestdagen geopend.\r\nGesloten voor 3 weken in augustus/1 week eind december en 1 week eind april."
            ]
          },
