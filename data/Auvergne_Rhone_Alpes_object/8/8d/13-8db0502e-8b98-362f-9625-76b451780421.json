  "rdfs:comment": {
    "de": [
      "Der Bahnhof Romans - Bourg-de-Péage ist ein französischer Bahnhof auf der Strecke von Valence nach Annecy. Er befindet sich im Stadtzentrum von Romans-sur-Isère, in der Nähe von Bourg-de-Péage. Fahrradpark (48 Plätze in Schließfächern), Autoparkplatz und Busbahnhof vor Ort."
    ],
    "en": [
      "Romans - Bourg-de-Péage station is a French railway station on the Valence to Annecy line, located in the center of Romans-sur-Isère, near Bourg-de-Péage. Bicycle park (48 spaces in lockers), parking lot and bus station on site."
    ],
    "it": [
      "La stazione di Romans - Bourg-de-Péage è una stazione ferroviaria francese sulla linea Valence - Annecy, situata nel centro di Romans-sur-Isère, vicino a Bourg-de-Péage. In loco sono presenti un parcheggio per biciclette (48 posti), un parcheggio e una stazione degli autobus."
    ],
    "fr": [
      "La gare de Romans - Bourg-de-Péage est une gare ferroviaire française de la ligne de Valence à Annecy, située en centre ville de Romans-sur-Isère, à proximité de Bourg-de-Péage. Parc vélo (48 places en consigne), parking auto et gare routière sur place."
    ],
    "es": [
      "La estación de Romans - Bourg-de-Péage es una estación de ferrocarril francesa de la línea Valence - Annecy, situada en el centro de Romans-sur-Isère, cerca de Bourg-de-Péage. Hay un aparcamiento para bicicletas (48 plazas), un parking y una estación de autobuses en el mismo recinto."
    ],
    "nl": [
      "Het station Romans - Bourg-de-Péage is een Frans treinstation op de lijn Valence naar Annecy, gelegen in het centrum van Romans-sur-Isère, vlakbij Bourg-de-Péage. Er is een fietsenstalling (48 plaatsen in de kluis), een parkeergarage en een busstation op het terrein."
    ]
  },
