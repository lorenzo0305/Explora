  "rdfs:comment": {
    "de": [
      "200m² großes städtisches SPA vor den Toren des Stadtzentrums: Allein, zu zweit oder mit Freunden genießen Sie Körper- und Gesichtspflege, Whirlpool und andere Wellness-Behandlungen! IDEOSPA bietet Behandlungen, die Sie mit Ihrer Familie durchführen können. Wir akzeptieren Kinder ab 6 Jahren."
    ],
    "en": [
      "200m² urban SPA on the outskirts of the city center: body and facial treatments, balneotherapy and other wellness treatments! IDEOSPA propose family treatments, children from 6 are accepted."
    ],
    "it": [
      "SPA urbana di 200 m² ai margini del centro città: da soli, in coppia o con gli amici, godetevi trattamenti per il corpo, trattamenti per il viso, balneoterapia e altri trattamenti benessere! IDEOSPA offre trattamenti per famiglie, con bambini a partire dai 6 anni."
    ],
    "fr": [
      "SPA urbain de 200m² aux portes du centre ville : seul en couple ou entre amis profitez des soins du corps, du visage, balnéo et autres soins bien-être ! IDEOSPA propose des soins à réaliser en famille, nous acceptons les enfants à partir de 6 ans."
    ],
    "nl": [
      "Stedelijke spa van 200 m² aan de rand van het stadscentrum: lichaams- en gezichtsbehandelingen, balneotherapie en andere wellnessbehandelingen!"
    ],
    "es": [
      "SPA urbano de 200 m² en las afueras del centro de la ciudad: solo, en pareja o con amigos, disfrute de tratamientos corporales, tratamientos faciales, balneoterapia y otros tratamientos de bienestar IDEOSPA ofrece tratamientos familiares, con niños a partir de 6 años."
    ]
  },
