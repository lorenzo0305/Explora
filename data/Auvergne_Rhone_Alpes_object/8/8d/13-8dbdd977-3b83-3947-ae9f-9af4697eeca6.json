  "rdfs:comment": {
    "de": [
      "Für Familienessen, Abendessen mit Freunden oder Vereinen empfängt Sie das Restaurant Archipel Volcans unabhängig vom Hotel in einer grünen Umgebung, die sich zur Natur hin öffnet."
    ],
    "en": [
      "For family meals, dinners with friends or associations, the Archipel Volcans restaurant welcomes you independently of the hotel, in a green setting overlooking nature."
    ],
    "it": [
      "Per i pasti in famiglia, le cene con gli amici o le associazioni, il ristorante Archipel Volcans vi accoglie indipendentemente dall'hotel in un ambiente verde aperto alla natura."
    ],
    "fr": [
      "Pour les repas de famille, dîners entre amis ou associations, le restaurant Archipel Volcans vous accueille indépendamment de l’hôtel dans un cadre de verdure ouvert sur la nature."
    ],
    "nl": [
      "Voor familiemaaltijden, diners met vrienden of verenigingen ontvangt het restaurant Archipel Volcans u onafhankelijk van het hotel in een groene omgeving die openstaat voor de natuur."
    ],
    "es": [
      "Para comidas familiares, cenas con amigos o asociaciones, el restaurante Archipel Volcans le acoge independientemente del hotel en un entorno verde abierto a la naturaleza."
    ]
  },
