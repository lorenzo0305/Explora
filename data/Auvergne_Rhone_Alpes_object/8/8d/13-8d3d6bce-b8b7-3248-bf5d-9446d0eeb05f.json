  "rdfs:comment": {
    "de": [
      "Nature and Mushing lädt Sie zu einer einzigartigen Erfahrung ein: Entdecken Sie die Komplizenschaft mit nordischen Hunden bei Taufen mit Hundekarts und Canibalades. Sensationen und Emotionen für Groß und Klein inmitten authentischer Landschaften sind garantiert."
    ],
    "en": [
      "Nature and Mushing invites you to enjoy a unique experience: discover the complicity with Nordic dogs during dog kart baptisms and canibalades. Sensations and emotions guaranteed, for young and old, in the heart of authentic landscapes."
    ],
    "it": [
      "Natura e Mushing vi invita a vivere un'esperienza unica: scoprire la complicità con i cani nordici durante battesimi e canibalate in dog kart. Sensazioni ed emozioni garantite, per grandi e piccini, nel cuore di paesaggi autentici."
    ],
    "fr": [
      "Nature and Mushing vous invite à vivre une expérience unique : découvrez la complicité avec des chiens nordiques lors de baptêmes en kart à chiens et canibalades. Senstions et émotions garanties, pour petits et grands, au cœur de paysages authentiques."
    ],
    "nl": [
      "Nature and Mushing nodigt je uit voor een unieke ervaring: ontdek de medeplichtigheid met Scandinavische honden tijdens hondenkartdopen en canibalades. Sensaties en emoties gegarandeerd, voor jong en oud, in het hart van authentieke landschappen."
    ],
    "es": [
      "Naturaleza y Mushing le invita a disfrutar de una experiencia única: descubrir la complicidad con los perros nórdicos durante bautismos de karting canino y canibaladas. Sensaciones y emociones garantizadas, para grandes y pequeños, en el corazón de paisajes auténticos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nature and Mushing"
    ]
  },
