  "rdfs:comment": {
    "de": [
      "In Vinsobres können Sie mit Freunden oder der Familie das Bogenschießen in der Natur entdecken. Auf einem schattigen und angelegten Gelände gibt es zwei Aktivitäten: eine spielerische Einführung oder einen Naturparcours im Wald mit seinen verschiedenen Zielen."
    ],
    "en": [
      "In Vinsobres, come and discover archery in nature with friends or family. On a shady, landscaped site, two activities are available: a fun introduction to archery or a nature trail in the forest with a variety of targets."
    ],
    "it": [
      "A Vinsobres, venite a scoprire il tiro con l'arco nella natura con gli amici o la famiglia. Si può scegliere tra due attività: una divertente introduzione al tiro con l'arco o un percorso naturalistico nella foresta con diversi bersagli."
    ],
    "fr": [
      "A Vinsobres, venez découvrir le tir à l’arc en nature entre amis ou en famille. Sur un terrain ombragé et aménagé, deux activités : une initiation ludique ou un Parcours-nature en forêt avec ses cibles variés."
    ],
    "nl": [
      "Kom in Vinsobres met vrienden of familie boogschieten in de natuur ontdekken. Je kunt kiezen uit twee activiteiten: een leuke kennismaking met boogschieten of een natuurparcours in het bos met verschillende doelen."
    ],
    "es": [
      "En Vinsobres, venga a descubrir el tiro con arco en la naturaleza con amigos o en familia. Hay dos actividades para elegir: una divertida iniciación al tiro con arco o un recorrido natural por el bosque con diversas dianas."
    ]
  },
  "rdfs:label": {
    "de": [
      "ESN - Bogenschießen"
    ],
    "en": [
      "ESN - Archery"
    ],
    "fr": [
      "ESN - Tir à l'Arc"
    ],
    "nl": [
      "ESN - Boogschieten"
    ]
  },
