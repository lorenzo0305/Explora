  "rdfs:comment": {
    "de": [
      "Das charmante kleine provenzalische Dorf Portes-en-Valdaine verfügt über 30 km markierte Wanderwege inmitten eines 600 ha großen Waldgebiets, das nach Lavendel, aromatischen Pflanzen und Steineichen duftet. Von den Anhöhen des Dorfes aus überblickt man die Ebene der Valdaine."
    ],
    "en": [
      "Portes-en-Valdaine, a charming little Provencal village, boasts 30 km of signposted trails in the heart of a 600-hectare forest estate, fragrant with lavender, aromatic plants and evergreen oaks. The village overlooks the Valdaine plain."
    ],
    "it": [
      "Portes-en-Valdaine è un incantevole paesino provenzale con 30 km di sentieri segnalati nel cuore di un'area boschiva di 600 ettari ricca di lavanda, piante aromatiche e querce verdi. Dalle alture del paese si domina la piana di Valdaine."
    ],
    "fr": [
      "Charmant petit village provençal, Portes-en-Valdaine dispose de 30 km de sentiers balisés au cœur d’un domaine forestier de 600 ha respirant lavande, plantes aromatiques et chênes verts. Depuis les hauteurs du village, on domine la plaine de la Valdaine."
    ],
    "nl": [
      "Portes-en-Valdaine is een charmant Provençaals dorpje met 30 km bewegwijzerde wandelpaden in het hart van een bos van 600 hectare met lavendel, aromatische planten en steeneiken. Het dorp kijkt uit over de Valdaine vlakte."
    ],
    "es": [
      "Portes-en-Valdaine es un encantador pueblecito provenzal con 30 km de senderos señalizados en el corazón de una zona boscosa de 600 hectáreas llena de lavanda, plantas aromáticas y robles verdes. Desde las alturas del pueblo, se puede contemplar la llanura de Valdaine."
    ]
  },
