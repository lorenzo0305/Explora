  "rdfs:comment": {
    "de": [
      "Im historischen Zentrum empfängt Sie das Croustou von Montag bis Samstag mittags und abends, um regionale Spezialitäten und andere Produkte aus der Gegend zu genießen."
    ],
    "en": [
      "In the historic center of town, Le Croustou welcomes you for lunch and dinner, Monday to Saturday, to savor regional specialties and other local products."
    ],
    "it": [
      "Situato nel centro storico, Croustou vi accoglie a pranzo e a cena, dal lunedì al sabato, per gustare specialità regionali e altri prodotti locali."
    ],
    "fr": [
      "C'est dans le centre historique que le Croustou vous accueille midi et soir, du lundi au samedi, pour savourer des spécialités régionales et autres produits du terroir."
    ],
    "es": [
      "Situado en el centro histórico, Croustou le recibe para almorzar y cenar, de lunes a sábado, y degustar especialidades regionales y otros productos locales."
    ],
    "nl": [
      "Croustou ligt in het historische centrum en verwelkomt je van maandag tot zaterdag voor lunch en diner om te genieten van regionale specialiteiten en andere lokale producten."
    ]
  },
  "rdfs:label": {
