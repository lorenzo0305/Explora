  "rdfs:comment": {
    "de": [
      "Verwirklichungen von Artikeln Textilien nach Maß, individuell gegestaltet: Taschen(Säcke), Börsen(Stipendien), Zubehörteile. Zubereitung: Vorhänge, Tischtücher, Dekorationskissen(Dekorationssitzkissen), Necessaires und das Gut der anderen Sachen."
    ],
    "en": [
      "Realizations of custom-made, personalized textile articles: bags, stock exchanges(scholarships), accessories. Preparation(clothing business): curtains, tablecloths, pillows of decoration, toilet bags and the good(property) of the other things."
    ],
    "it": [
      "Produzione di articoli tessili personalizzati e su misura: borse, borsette, accessori. Produzione di tende, tovaglie, cuscini decorativi, sacchetti per la toilette e molto altro."
    ],
    "fr": [
      "Réalisations d'articles textiles sur mesure, personnalisés: sacs, bourses, accessoires. Confection : rideaux, nappes, coussins de décoration, trousses de toilette et bien d'autres choses."
    ],
    "es": [
      "Producción de artículos textiles a medida y personalizados: bolsos, carteras, accesorios. Fabricación de cortinas, manteles, cojines decorativos, bolsas de aseo y muchas otras cosas."
    ],
    "nl": [
      "Gepersonaliseerde textielproducten op maat: tassen, portemonnees, accessoires. Productie: gordijnen, tafelkleden, sierkussens, toilettassen en nog veel meer."
    ]
  },
