  "rdfs:comment": {
    "de": [
      "Das 26FK befindet sich im historischen Zentrum von Annonay und ist ein assoziativer Dritter Ort, der mehrere Aktivitäten anbietet: ein assoziatives Café, einen digitalen Raum, ein Repair-Café und eine Kunstgalerie. Ein Ort der Begegnung und des Austauschs."
    ],
    "en": [
      "Located in the historic center of Annonay, the 26FK is a third-party associative space offering several activities: an associative café, a digital space, a repair café and an art gallery. A place to meet and exchange."
    ],
    "it": [
      "Situato nel centro storico di Annonay, 26FK è un centro comunitario di terze parti che offre una serie di attività: un community café, uno spazio digitale, un repair café e una galleria d'arte. È un luogo dove le persone possono incontrarsi e scambiare idee."
    ],
    "fr": [
      "Situé dans le centre historique d'Annonay, le 26FK est un tiers-lieu associatif qui propose plusieurs activités : un café associatif, un espace numérique, un repair café, et une galerie d'art. Un lieu de rencontres et d'échanges."
    ],
    "es": [
      "Situado en el centro histórico de Annonay, 26FK es un centro comunitario para terceros que ofrece diversas actividades: un café comunitario, un espacio digital, un café de reparaciones y una galería de arte. Es un lugar donde la gente puede reunirse e intercambiar ideas."
    ],
    "nl": [
      "26FK, gelegen in het historische centrum van Annonay, is een gemeenschapscentrum voor derden dat verschillende activiteiten biedt: een buurtcafé, een digitale ruimte, een repaircafé en een kunstgalerie. Het is een plek waar mensen elkaar kunnen ontmoeten en ideeën kunnen uitwisselen."
    ]
  },
