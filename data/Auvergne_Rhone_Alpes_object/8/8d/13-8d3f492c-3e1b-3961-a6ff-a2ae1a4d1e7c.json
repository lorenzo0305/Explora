  "rdfs:comment": {
    "de": [
      "La Movida, eine Woche mit einer großen Vielfalt an Künstlern, internationalen Flamenco-Größen ebenso wie aufstrebenden Talenten und lokalen Tänzern aus der Region Valencia."
    ],
    "en": [
      "La Movida, a week featuring a wide variety of artists, from international flamenco figures to emerging talents, as well as local dancers from the Valencia region."
    ],
    "it": [
      "La Movida, una settimana in cui si esibisce una grande varietà di artisti, dalle star internazionali del flamenco ai talenti emergenti, oltre ai ballerini locali della regione di Valencia."
    ],
    "fr": [
      "La Movida, une semaine avec une grande diversité d’artistes, des figures internationales du flamenco comme des talents émergents ainsi que des danseurs locaux de la région de Valence."
    ],
    "es": [
      "La Movida, una semana en la que participan artistas muy diversos, desde estrellas internacionales del flamenco a talentos emergentes, pasando por bailaores locales de la Comunidad Valenciana."
    ],
    "nl": [
      "La Movida, een week met een grote verscheidenheid aan artiesten, van internationale flamencosterren tot opkomende talenten, maar ook lokale dansers uit de regio Valencia."
    ]
