  "rdfs:comment": {
    "de": [
      "Das Hotel la Pause RN 7 liegt in La Coucourde, in unmittelbarer Nähe der berühmten Nationalstraße Nationale 7 (5 min von der Ausfahrt A7 entfernt) und 10 min von Montélimar Nord. Es ist der ideale Zwischenstopp für Reisende, die auf der Suche nach einer erholsamen Pause auf dem Weg in den Urlaub sind."
    ],
    "en": [
      "Located in La Coucourde, just off the famous Nationale 7 (5 min from the A7 exit) and 10 min from Montélimar Nord, Hotel la Pause RN 7 is the ideal stopover for travelers looking for a relaxing break on the road to vacation."
    ],
    "it": [
      "Situato a La Coucourde, appena fuori dalla famosa Nationale 7 (a 5 minuti dall'uscita A7) e a 10 minuti da Montélimar Nord, l'Hotel la Pause RN 7 è la tappa ideale per i viaggiatori in cerca di una pausa rilassante durante il viaggio verso la meta delle loro vacanze."
    ],
    "fr": [
      "Situé à La Coucourde, à proximité immédiate de la célèbre Nationale 7 (à 5 min de la sortie A7) et à 10 min de Montélimar Nord, l'hôtel la Pause RN 7 est l’escale idéale pour les voyageurs en quête d’une halte reposante sur la route des vacances."
    ],
    "es": [
      "Situado en La Coucourde, justo al lado de la famosa Nationale 7 (a 5 minutos de la salida de la A7) y a 10 minutos de Montélimar Nord, el Hotel la Pause RN 7 es la parada ideal para los viajeros que buscan un descanso de camino a su destino de vacaciones."
    ],
    "nl": [
      "Hotel la Pause RN 7 ligt in La Coucourde, vlak bij de beroemde Nationale 7 (op 5 minuten van de afrit van de A7) en op 10 minuten van Montélimar Nord. Het is de ideale tussenstop voor reizigers die op zoek zijn naar een ontspannende pauze op weg naar hun vakantiebestemming."
    ]
  },
  "rdfs:label": {
