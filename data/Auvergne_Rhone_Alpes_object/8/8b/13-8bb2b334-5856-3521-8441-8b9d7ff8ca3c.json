  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine regionale Küche mit Zutaten aus unserem Lebensmittelgeschäft."
    ],
    "en": [
      "We offer you cuisine prepared with the produce from our own delicatessen."
    ],
    "it": [
      "Le relais du week-end è un bar, un ristorante e un negozio di alimentari tutto in uno. Il menu del fine settimana prevede lumache, torta di fegato, rane, carne grattugiata e salumi."
    ],
    "fr": [
      "Le relais du week-end est un à la fois un bar, restaurant et une épicerie. A la carte le week-end : escargots, gâteau de foie, grenouilles, râpées et charcuterie."
    ],
    "nl": [
      "Le relais du week-end is een bar, restaurant en kruidenierswinkel in één. Op het menu in het weekend: slakken, levercake, kikkers, geraspt vlees en vleeswaren."
    ],
    "es": [
      "Le relais du week-end es bar, restaurante y tienda de comestibles, todo en uno. En el menú de los fines de semana: caracoles, pastel de hígado, ranas, carne rallada y charcutería."
    ]
  },
