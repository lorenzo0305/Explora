  "rdfs:comment": {
    "de": [
      "Notre-Dame-de-Paulhat wurde Ende des 16. Jahrhunderts in der Art des 12. Jahrhunderts wieder aufgebaut und ist wegen des Gewölbes ihres Kirchenschiffs, ihrer Vorhalle und ihres mit einem Pelikan geschmückten Hauptaltars bewundernswert."
    ],
    "en": [
      "Rebuilt at the end of the 16th century in the manner of the 12th century, Notre-Dame-de-Paulhat is admirable for the vault of its nave, its porch and its main altar decorated with a pelican."
    ],
    "it": [
      "Ricostruita alla fine del XVI secolo alla maniera del XII secolo, Notre-Dame-de-Paulhat è ammirevole per la volta della navata, il portico e l'altare maggiore decorato con un pellicano."
    ],
    "fr": [
      "Reconstruite à la fin du XVIe siècle à la manière du XIIe siècle, Notre-Dame-de-Paulhat est admirable pour la voûte de sa nef, son porche et son maître autel orné d'un pélican."
    ],
    "es": [
      "Reconstruida a finales del siglo XVI a la manera del siglo XII, Notre-Dame-de-Paulhat es admirable por la bóveda de su nave, su pórtico y su altar mayor decorado con un pelícano."
    ],
    "nl": [
      "Notre-Dame-de-Paulhat, herbouwd aan het einde van de 16e eeuw in de stijl van de 12e eeuw, is bewonderenswaardig vanwege het gewelf van het schip, het portaal en het met een pelikaan versierde hoogaltaar."
    ]
  },
