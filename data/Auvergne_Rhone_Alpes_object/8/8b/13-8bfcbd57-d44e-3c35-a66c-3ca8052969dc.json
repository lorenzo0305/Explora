  "rdfs:comment": {
    "de": [
      "Jahrhundert in einem 31 Hektar großen Park, ein viereckiges befestigtes Haus mit Eckturm, Sälen und Gewölbekellern. Es beherbergt auch Ausstellungen.\r\nKann nicht besichtigt werden."
    ],
    "en": [
      "This 16th-century château, set in 31 hectares of parkland, is a quadrangular fortified house with a corner tower, vaulted rooms and cellars. It also houses exhibitions.\r\nNot open to the public."
    ],
    "it": [
      "Si tratta di un castello del XVI secolo immerso in 31 ettari di parco, una casa fortificata quadrangolare con una torre d'angolo, stanze e cantine a volta. Ospita anche mostre.\r\nNon aperto al pubblico."
    ],
    "fr": [
      "C' est un château du XVIème siècle situé au sein d'un parc de 31 hectares, maison forte quadrangulaire à tour d'angle, salles et caves voutées. Il abrite également des expositions.\r\nNe se visite pas."
    ],
    "es": [
      "Se trata de un castillo del siglo XVI situado en 31 hectáreas de parque, una casa fortificada cuadrangular con una torre de esquina, habitaciones y bodegas abovedadas. También alberga exposiciones.\r\nNo está abierto al público."
    ],
    "nl": [
      "Dit 16e-eeuwse kasteel, gelegen in 31 hectare park, is een vierhoekig versterkt huis met een hoektoren, gewelfde kamers en kelders. Er worden ook tentoonstellingen gehouden.\r\nNiet toegankelijk voor het publiek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Château Les Oliviers de Salettes"
    ]
  },
