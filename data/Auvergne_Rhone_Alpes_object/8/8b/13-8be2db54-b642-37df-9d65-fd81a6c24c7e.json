  "rdfs:comment": {
    "de": [
      "Zucht von Milchschafen - Käseverarbeitung - Verkauf von Schafskäse aus Rohmilch, Joghurt, Feta, Tomme... Verkauf auf dem Bauernhof jeden Freitag von 16 bis 19 Uhr. Auf dem Markt in Alba La Romaine am Sonntagmorgen."
    ],
    "en": [
      "Dairy sheep farming - Cheese processing - Sale of raw-milk ewe's milk cheeses, yoghurts, Feta, tomme... Sales at the farm every Friday from 4pm to 7pm. Present at the Alba La Romaine market on Sunday mornings."
    ],
    "it": [
      "Allevamento di pecore da latte - Lavorazione del formaggio - Vendita di formaggi di pecora a latte crudo, yogurt, Feta, tomme... Vendita in azienda ogni venerdì dalle 16.00 alle 19.00. Presenza al mercato di Alba La Romaine la domenica mattina."
    ],
    "fr": [
      "Élevage Ovins laitières -Transformation fromagères - Vente de fromages de brebis au lait cru, yaourts, Fêta, tomme... Vente à la ferme tout les vendredi de 16h à 19h. Présent sur le marché d'Alba La Romaine le dimanche matin."
    ],
    "nl": [
      "Melkschapenhouderij - Kaasverwerking - Verkoop van rauwmelkse schapenkazen, yoghurts, feta, tomme... Verkoop op de boerderij elke vrijdag van 16.00 tot 19.00 uur. Aanwezig op de markt van Alba La Romaine op zondagochtend."
    ],
    "es": [
      "Ganadería ovina lechera - Elaboración de quesos - Venta de quesos de leche cruda de oveja, yogures, Feta, tomme... Venta en la granja todos los viernes de 16h a 19h. Presencia en el mercado de Alba La Romaine los domingos por la mañana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Bergerie de Luas"
    ]
  },
