  "rdfs:comment": {
    "de": [
      "Mit seinen drei Sälen und seinem außergewöhnlichen Auditorium veranstaltet das MC2: Grenoble jedes Jahr fast 80 Aufführungen (Theater, Tanz, Zirkus usw.) und Konzerte."
    ],
    "en": [
      "Opened in 1968 when Grenoble hosted the Winter Olympics and inaugurated by André Malraux, the MC2: Grenoble belongs to flagship institutions of the cultural decentralization. In 2004, it became the MC2 and awarded the label of “Scène nationale”. The MC2: Grenoble is fully equipped with a complex of three playhouses in one, one auditorium and associated rehearsal studios which is unparalleled in France."
    ],
    "it": [
      "Con le sue tre sale e l'eccezionale auditorium, l'MC2 di Grenoble ospita ogni anno quasi 80 spettacoli (teatro, danza, circo, ecc.) e concerti."
    ],
    "fr": [
      "Avec ses trois salles et son auditorium exceptionnel, la MC2: Grenoble accueille chaque année près de 80 spectacles (théâtre, danse, cirque...) et concerts."
    ],
    "nl": [
      "Met zijn drie zalen en uitzonderlijke auditorium ontvangt het MC2: Grenoble jaarlijks bijna 80 voorstellingen (theater, dans, circus, enz.) en concerten."
    ],
    "es": [
      "Con sus tres salas y su excepcional auditorio, el MC2: Grenoble acoge cada año cerca de 80 espectáculos (teatro, danza, circo) y conciertos."
    ]
  },
  "rdfs:label": {
