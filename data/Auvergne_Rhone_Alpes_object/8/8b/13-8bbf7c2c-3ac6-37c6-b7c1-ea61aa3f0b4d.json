  "rdfs:comment": {
    "de": [
      "Arlette und Pierre FAURE begrüßen Sie im Herzen ihres Ziegenbetriebs.\r\nVerkauf ab Hof nach Vereinbarung, montags bis samstags. Markt in Montélimar am Mittwoch, Donnerstag und Samstag."
    ],
    "en": [
      "Arlette and Pierre FAURE welcome you to their goat farm. \r\nFarm sales from Monday to Saturday, by appointment. Montélimar market on Wednesday, Thursday and Saturday."
    ],
    "it": [
      "Picodon DOP\r\nVendite in fattoria dal lunedì al sabato (tranne il mercoledì)\r\nMercato di Montélimar il mercoledì, giovedì e sabato."
    ],
    "fr": [
      "AOP Picodon\r\nVente à la ferme du lundi au samedi.(hors mercredi)  \r\nMarché de Montélimar le mercredi, jeudi et samedi."
    ],
    "es": [
      "Picodon DOP\r\nVenta en la granja de lunes a sábado (excepto los miércoles)\r\nMercado de Montélimar los miércoles, jueves y sábados."
    ],
    "nl": [
      "Arlette en Pierre FAURE ontvangen u in het hart van hun geitenbedrijf. \r\nVerkoop bij de boerderij op afspraak, van maandag tot en met zaterdag. Markt in Montélimar op woensdag, donderdag en zaterdag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Chèvrerie les 3 Mûriers"
    ]
  },
