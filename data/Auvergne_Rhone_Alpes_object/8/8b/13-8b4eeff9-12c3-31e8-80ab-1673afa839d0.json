  "rdfs:comment": {
    "de": [
      "Als Fan des Tanzes der 80er Jahre können Sie mit uns einen Moment des Grooves in einer explosiven und energiegeladenen Atmosphäre teilen. Lassen Sie sich diesen Termin nicht entgehen!"
    ],
    "en": [
      "If you're a fan of 80s dance, join us for a groovy, high-energy party. Don't miss it!"
