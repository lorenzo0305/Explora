  "rdfs:comment": {
    "de": [
      "Einige Kilometer von der Ausfahrt 31 der Autobahn CL F / Lyon entfernt empfängt Sie die Familie Balichard auf ihrem Hof, wo Fourme de Montbrison fermière AOP und Wurstwaren vom Bauernhof sowie Schweinefleisch aus eigener Aufzucht hergestellt werden."
    ],
    "en": [
      "A few kilometres from exit 31 on the motorway between Clermont-Ferrand and Lyon, the Balichard family invite you to visit their cattle and dairy farm where they produce traditional charcuterie, pork, and PDO Fourme de Montbrison cheese."
    ],
    "it": [
      "A pochi chilometri dall'uscita 31 dell'autostrada CL F / Lione, la famiglia Balichard vi accoglie nella sua azienda agricola, dove produce il formaggio Fourme de Montbrison DOP, salumi di fattoria e carne di maiale proveniente dalla propria fattoria."
    ],
    "fr": [
      "A  quelques kms de la sortie 31 de l'autoroute CL F / Lyon, la famille Balichard vous accueille sur son exploitation, où sont fabriquées de la fourme de Montbrison fermière AOP, et de la charcuterie fermière, de la viande de porc issue de son élevage."
    ],
    "nl": [
      "Op enkele kilometers van afrit 31 van de snelweg CL F / Lyon heet de familie Balichard u welkom op hun boerderij, waar ze boerenkaas Fourme de Montbrison BOB, boerencharcuterie en varkensvlees van eigen boerderij produceren."
    ],
    "es": [
      "A pocos kilómetros de la salida 31 de la autopista CL F / Lyon, la familia Balichard le da la bienvenida a su granja, en la que producen queso de granja Fourme de Montbrison DOP, charcutería de granja y carne de cerdo de su propia granja."
    ]
  },
