  "rdfs:comment": {
    "de": [
      "Wir erwarten Sie jeden Tag mit einer von uns frisch zubereiteten Küche. Wir bieten eine eher traditionelle Küche an, wobei wir manchmal einige bekannte Gerichte neu interpretieren."
    ],
    "en": [
      "We look forward to welcoming you every day with our freshly prepared cuisine. We offer a traditional cuisine, sometimes revisiting well-known dishes."
    ],
    "it": [
      "Saremo lieti di accogliervi ogni giorno con la nostra cucina preparata al momento. Offriamo una cucina tradizionale, talvolta rivisitando piatti noti."
    ],
    "fr": [
      "Nous vous attendons chaque jour pour une cuisine fraîchement préparée par nos soins. Nous offrons une cuisine plutôt traditionnelle en revisitant parfois certains mets connus."
    ],
    "nl": [
      "We kijken ernaar uit om je elke dag te verwelkomen met onze vers bereide keuken. We bieden een traditionele keuken, waarbij we soms bekende gerechten herhalen."
    ],
    "es": [
      "Estamos deseando darle la bienvenida cada día con nuestra cocina recién preparada. Ofrecemos una cocina tradicional, a veces revisitando platos conocidos."
    ]
  },
  "rdfs:label": {
