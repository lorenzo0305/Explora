  "rdfs:comment": {
    "de": [
      "Jeden Tag kocht unser Team gute, hausgemachte Gerichte und mischt die \"unumgänglichen\" Gerichte, die immer gut ankommen (Burger, Tartar...) mit traditionellen französischen Rezepten und regionalen Spezialitäten, für die es ein Geheimnis hat."
    ],
    "en": [
      "Every day, our team cooks delicious home-cooked meals, mixing the \"must-have\" dishes that always please (burgers, tartars...) with traditional French recipes and regional specialties they know the secret of."
    ],
    "it": [
      "Ogni giorno, il nostro team prepara deliziosi pasti casalinghi, mescolando i piatti \"imperdibili\" che piacciono sempre (hamburger, tartara...) con le ricette tradizionali francesi e le specialità regionali di cui conosce il segreto."
    ],
    "fr": [
      "Chaque jour, notre équipe cuisine de bons petits plats faits maison en mixant les mets \"incontournables\" qui font toujours plaisir (burgers, tartares...) avec des recettes traditionnelles françaises et des spécialités régionales dont elle a le secret."
    ],
    "nl": [
      "Elke dag bereidt ons team heerlijke huisgemaakte maaltijden, een mix van \"must-try\" gerechten die altijd in de smaak vallen (hamburgers, tartaar...) met traditionele Franse recepten en regionale specialiteiten waarvan zij het geheim kennen."
    ],
    "es": [
      "Cada día, nuestro equipo prepara deliciosas comidas caseras, mezclando los platos \"imprescindibles\" que siempre gustan (hamburguesas, tartares...) con recetas tradicionales francesas y especialidades regionales de las que conocen el secreto."
    ]
  },
