  "rdfs:comment": {
    "de": [
      "Mitten in Jaujac erwartet Sie traditionelle Hausmannskost. Frische, regionale Produkte, Sonntagsbrunch, köstliche Desserts am Nachmittag und eine abwechslungsreiche Speisekarte. Reservierung empfohlen."
    ],
    "en": [
      "In the heart of Jaujac, traditional home-style cooking. Fresh, local produce, Sunday brunch, indulgent desserts in the afternoon, and a varied menu. Reservations recommended."
    ],
    "it": [
      "Nel cuore di Jaujac, cucina casalinga tradizionale. Prodotti freschi locali, brunch domenicale, dessert pomeridiani gourmet e un menu vario.  Si consiglia la prenotazione."
    ],
    "fr": [
      "Au cœur de Jaujac, une cuisine traditionnelle maison. Produits frais et locaux, brunch le dimanche, desserts gourmands l’après-midi et une carte variée.  Réservation conseillée."
    ],
    "nl": [
      "In het hart van Jaujac, traditionele thuiskeuken. Verse streekproducten, brunch op zondag, desserts voor fijnproevers in de namiddag en een gevarieerd menu.  Reserveren aanbevolen."
    ],
    "es": [
      "En el corazón de Jaujac, cocina casera tradicional. Productos locales frescos, brunch dominical, postres gourmet por la tarde y una carta variada.  Se recomienda reservar."
    ]
  },
