  "rdfs:comment": {
    "de": [
      "Die Mosaikkünstlerin Brigitte Gangloff restauriert aus zerbrochenem Geschirr unerwartete und prächtige Dekorationen. Sie hat für die Köche Paul Bocuse und Jean-Paul Lacombe gearbeitet, die ihr die Aufgabe anvertrauten, Objekte zu schaffen, die ihren Saal schmücken sollten."
    ],
    "en": [
      "Brigitte Gangloff, mosaic artist, restores unexpected and sumptuous decorations from broken crockery. She has worked for the cooks Paul Bocuse and Jean-Paul Lacombe who entrusted her with the task of creating objects to decorate their rooms."
    ],
    "it": [
      "Brigitte Gangloff, artista del mosaico, recupera decorazioni inaspettate e sontuose da piatti rotti. Ha lavorato per gli chef Paul Bocuse e Jean-Paul Lacombe, che le hanno affidato il compito di creare oggetti per decorare le loro sale da pranzo."
    ],
    "fr": [
      "Brigitte Gangloff, artiste mosaïste, restaure à partir de vaisselles cassées des décors inattendus et somptueux. Elle a travaillé pour les cuisiniers Paul Bocuse et Jean-Paul  Lacombe qui lui confièrent le soin de créer des objets devant orner leur salle."
    ],
    "nl": [
      "Brigitte Gangloff, mozaïek kunstenares, herstelt onverwachte en weelderige decoraties van gebroken vaatwerk. Zij heeft gewerkt voor de chefs Paul Bocuse en Jean-Paul Lacombe, die haar de opdracht gaven objecten te creëren om hun eetzalen te decoreren."
    ],
    "es": [
      "Brigitte Gangloff, artista del mosaico, restaura decoraciones inesperadas y suntuosas a partir de platos rotos. Ha trabajado para los chefs Paul Bocuse y Jean-Paul Lacombe, que le confiaron la tarea de crear objetos para decorar sus comedores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brigitte Gangloff Création mosaïque"
    ]
  },
