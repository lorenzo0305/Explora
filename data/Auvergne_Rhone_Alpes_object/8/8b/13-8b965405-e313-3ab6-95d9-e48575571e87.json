  "rdfs:comment": {
    "de": [
      "Das Hotel Restaurant de l'Abbaye liegt im Herzen des Dorfes Sauxillanges, nur 10 Minuten von Issoire und der A75 entfernt. Es verfügt über 16 Zimmer, die mit dem Aufzug erreichbar sind, um Sie auf Geschäfts- oder Urlaubsreisen zu empfangen."
    ],
    "en": [
      "Located in the heart of the village of Sauxillanges, just 10 minutes from Issoire and the A75 motorway, the Hôtel Restaurant de l'Abbaye has 16 rooms accessible by elevator to welcome you on your business or tourist trips."
    ],
    "it": [
      "Situato nel cuore del villaggio di Sauxillanges, a soli 10 minuti da Issoire e dalla A75, l'Hôtel Restaurant de l'Abbaye dispone di 16 camere accessibili con ascensore per accogliervi nei vostri viaggi d'affari o turistici."
    ],
    "fr": [
      "Situé au cœur du village de Sauxillanges à seulement 10 minutes d'Issoire et l'A75, l’Hôtel Restaurant de l’Abbaye dispose de 16 chambres accessible par ascenseur pour vous accueillir lors de vos déplacements professionnels ou touristiques."
    ],
    "es": [
      "Situado en el corazón del pueblo de Sauxillanges, a 10 minutos de Issoire y de la A75, el Hôtel Restaurant de l'Abbaye dispone de 16 habitaciones accesibles en ascensor para acogerle en sus viajes de negocios o de turismo."
    ],
    "nl": [
      "Gelegen in het hart van het dorp Sauxillanges, op slechts 10 minuten van Issoire en de A75, beschikt Hôtel Restaurant de l'Abbaye over 16 kamers die bereikbaar zijn met de lift om u te verwelkomen op uw zakelijke of toeristische reizen."
    ]
  },
