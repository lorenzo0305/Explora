  "rdfs:comment": {
    "de": [
      "Halbnächtlicher Lauf mit Sonnenuntergang über dem Vercors und der Ardèche im Hintergrund, die Strecke ist mit LEDs beleuchtet. 2 Läufe werden angeboten: 5 km schnell und zugänglich? 10 km ultra rollend"
    ],
    "en": [
      "Semi-nocturnal race, with the sun setting over the Vercors and the Ardèche in the background, LED-lit track. 2 races will be offered: 5 km fast and accessible? 10 km ultra rolling"
    ],
    "it": [
      "Gara seminotturna, con il sole che tramonta sul Vercors e l'Ardèche sullo sfondo, pista illuminata a LED. 2 gare proposte: una 5 km veloce e accessibile? 10 km ultra veloce"
    ],
    "fr": [
      "Course en semi-nocturne, coucher de soleil sur le Vercors et l’Ardèche en toile de fond, piste éclairée par les LED. 2 courses vous seront proposées: 5 km rapide et accessible\u2028• 10 km ultra roulant"
    ],
    "nl": [
      "Semi-nachtelijke race, met de ondergaande zon boven de Vercors en de Ardèche op de achtergrond, LED-verlicht parcours. 2 races worden aangeboden: een snelle en toegankelijke 5 km? 10 km ultrasnel"
    ],
    "es": [
      "Carrera seminocturna, con la puesta de sol sobre el Vercors y el Ardèche de fondo, pista iluminada con LED. Se proponen 2 carreras: una rápida y accesible de 5 km? 10 km ultrarrápidos"
    ]
  },
  "rdfs:label": {
