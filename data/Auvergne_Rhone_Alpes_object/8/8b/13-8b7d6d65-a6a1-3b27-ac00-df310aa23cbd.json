  "rdfs:comment": {
    "de": [
      "Erleben Sie das Rodeln auf Schienen! Hier sind Sensation und Spaß für Groß und Klein im Herzen der Berge garantiert! Sie suchen nach einer einzigartigen und aufregenden Aktivität? Die Sommerrodelbahn auf Schienen in La Sambuy verspricht Ihnen unvergessliche Momente."
    ],
    "en": [
      "La Sambuy's 4 season alpine slide; 600 meters of pure gliding thrills in the great outdoors. 9 turns ans 3 jumps. Integrated braking system.\r\nFor children from 1,05m tall accompanied with an adult and from 1,25m unaccompanied.\r\nRuns even in wet weather."
    ],
    "it": [
      "Provate il brivido dello slittino su rotaia! Emozioni e divertimento garantiti per grandi e piccini nel cuore delle montagne! Siete alla ricerca di un'attività unica ed emozionante? Lo slittino estivo su rotaie di La Sambuy promette momenti indimenticabili."
    ],
    "fr": [
      "Osez l'Expérience de la Luge sur Rails ! Sensation et plaisir garantis pour petits et grands au cœur de la montagne ! Vous cherchez une activité unique et palpitante ? La luge d'été sur rails de La Sambuy vous promet des moments inoubliables."
    ],
    "es": [
      "Experimente la emoción del trineo sobre raíles Diversión garantizada para grandes y pequeños en el corazón de las montañas ¿Busca una actividad única y emocionante? El trineo sobre raíles de verano de La Sambuy promete momentos inolvidables."
    ],
    "nl": [
      "Boven het meer van Annecy in volle natuur genieten van 600 meter rodelen. 9 bochten, 3 sprongen. Geïntegreerd remsysteem.\r\nToegankelijk voor kinderen vanaf 1.05m begeleid door een volwassene, vanaf 1.25 zonder begeleiding. Activiteit open tijdens regenbuien."
    ]
  },
  "rdfs:label": {
    "en": [
      "Alpine slide on rails: JIM La Sambuy"
    ],
    "fr": [
      "Luge sur rails : JIM La Sambuy"
    ],
    "nl": [
      "Slee: La Sambuy 4 seizoenen"
    ]
  },
