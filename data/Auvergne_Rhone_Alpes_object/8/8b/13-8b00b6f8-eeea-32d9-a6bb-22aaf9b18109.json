  "rdfs:comment": {
    "de": [
      "Ich bin seit 40 Jahren Töpferin und bearbeite derzeit Steinzeug in kleinen Serien oder Einzelstücken für Haus und Garten, mit fröhlichen und farbenfrohen Glasuren.\r\nSeit Sommer 2023 bin ich in Beaune-le-froid ansässig und heiße Sie jeden Tag willkommen,...oder fast jeden."
    ],
    "en": [
      "A potter for 40 years, I currently work in stoneware in small series or one-off pieces, for the home or garden, with cheerful, colorful glazes.\r\nSettled in Beaune-le-froid since summer 2023, I welcome you every day... or almost every day."
    ],
    "it": [
      "Ceramista da 40 anni, attualmente lavoro il gres in piccole serie o pezzi unici, per la casa o il giardino, con smalti allegri e colorati.\r\nInsediata a Beaune-le-froid dall'estate del 2023, vi accolgo tutti i giorni... o quasi."
    ],
    "fr": [
      "Potière depuis 40 ans, je travaille actuellement le grès en petites séries ou pièces uniques, pour la maison ou le jardin, avec des émaux gais et colorés. \r\nInstallée à Beaune-le-froid depuis l'été 2023, je vous accueille tous les jours,...ou presque."
    ],
    "nl": [
      "Ik ben al 40 jaar pottenbakker en werk momenteel met steengoed in kleine series of eenmalige stukken, voor thuis of in de tuin, met vrolijke, kleurrijke glazuren.\r\nSinds de zomer van 2023 ben ik gevestigd in Beaune-le-froid en ik verwelkom je elke dag... of bijna elke dag."
    ],
    "es": [
      "Alfarero desde hace 40 años, actualmente trabajo el gres en pequeñas series o piezas únicas, para la casa o el jardín, con esmaltes alegres y coloridos.\r\nInstalada en Beaune-le-froid desde el verano de 2023, le doy la bienvenida todos los días... o casi todos los días."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poterie Susanne Jensen"
    ]
  },
