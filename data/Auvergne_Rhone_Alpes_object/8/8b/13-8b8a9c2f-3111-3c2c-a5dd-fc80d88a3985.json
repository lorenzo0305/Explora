  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Region, indem Sie einen angenehmen Aufenthalt bei uns verbringen und leckere Gerichte von lokalen Produzenten probieren. Sie können auch bei Ihren Treffen in unserem Saal Ideen austauschen! Bis bald!"
    ],
    "en": [
      "Come and discover our region by spending a pleasant stay with us and by tasting good small dishes from local producers. You can also during your meetings come and share ideas in our room! See you soon!"
    ],
    "it": [
      "Venite a scoprire la nostra regione trascorrendo un piacevole soggiorno con noi e assaggiando il buon cibo dei produttori locali. Potete anche venire a condividere idee nella nostra sala durante le vostre riunioni! A presto!"
    ],
    "fr": [
      "Venez découvrir notre région en passant un agréable séjour chez nous et en dégustant de bons petits plats issus de producteurs locaux. Vous pouvez aussi lors de vos réunions venir partager des idées dans notre salle ! A très bientôt !"
    ],
    "es": [
      "Venga a descubrir nuestra región pasando una agradable estancia con nosotros y degustando la buena comida de los productores locales. También puede venir a compartir ideas en nuestra sala durante sus reuniones Hasta pronto"
    ],
    "nl": [
      "Kom en ontdek onze regio door een aangenaam verblijf bij ons en het proeven van lekker eten van lokale producenten. U kunt ook ideeën komen uitwisselen in onze ruimte tijdens uw vergaderingen! Tot ziens!"
    ]
  },
