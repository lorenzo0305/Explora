  "rdfs:comment": {
    "de": [
      "Gesellige und kulturelle Bistrokantine. Lokale, biologische und hausgemachte Küche. Bedienung an der Theke. Tagesteller, Aperitif, Gebäck, Musikveranstaltungen."
    ],
    "en": [
      "Friendly, cultural bistro-canteen. Local, organic and homemade cuisine. Counter service. Daily specials, aperitifs, pastries, musical events."
    ],
    "it": [
      "Un bistrot-mensa accogliente e culturale. Cucina locale, biologica e casalinga. Eventi musicali.\r\nVini naturali, birre artigianali e sciroppi. Pasticceria fatta in casa. Specialità giornaliere e cene aperitivo."
    ],
    "fr": [
      "Bistro cantine convivial et culturel. Une cuisine locale, bio et faite maison. Événements musicaux.\r\nVins naturels, bières et sirops artisanaux. Pâtisseries maison. Gamelle du jour et apéros dînatoires."
    ],
    "es": [
      "Un bistró-cantina acogedor y cultural. Cocina local, ecológica y casera. Eventos musicales.\r\nVinos naturales, cervezas artesanas y siropes. Pastelería casera. Ofertas diarias y cenas aperitivo."
    ],
    "nl": [
      "Een vriendelijke, culturele bistro-kantine. Lokale, biologische en huisgemaakte gerechten. Bediening aan de balie. Dagelijkse specialiteiten, aperitieven, gebak, muzikale evenementen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Magasin Général"
    ]
  },
