  "rdfs:comment": {
    "de": [
      "Das Ziel des Clubs ist die Ausübung und Verbreitung der internationalen Sprache Esperanto. Der Club organisiert Kurse. Die Mitglieder treffen sich einmal im Monat und mindestens zweimal im Monat, um die Sprache zu üben."
    ],
    "en": [
      "The aim of the club is to practice and spread the international language Esperanto. The club organizes courses. Members meet once a month and at least twice a month to practice the language."
    ],
    "it": [
      "Lo scopo del club è quello di praticare e diffondere la lingua internazionale esperanto. Il club organizza corsi. I soci si incontrano una volta al mese e almeno due volte al mese per praticare la lingua."
    ],
    "fr": [
      "Le but du club est la pratique et la diffusion de la langue internationale Espéranto. Le club organise des cours. Les membres se réunissent une fois par mois et au moins deux fois par mois pour pratiquer la langue."
    ],
    "nl": [
      "Het doel van de club is het beoefenen en verspreiden van de internationale taal Esperanto. De club organiseert cursussen. De leden komen één keer per maand bij elkaar en minstens twee keer per maand om de taal te oefenen."
    ],
    "es": [
      "El objetivo del club es practicar y difundir la lengua internacional esperanto. El club organiza cursos. Los socios se reúnen una vez al mes y al menos dos veces al mes para practicar la lengua."
    ]
  },
  "rdfs:label": {
    "fr": [
