  "rdfs:comment": {
    "de": [
      "Vic sur Cère ist seit der keltischen Zeit für seine Mineralwasserquelle bekannt. Sie fließt friedlich am Kiosk der Wassertrinker wie in der \"Belle Epoque\". Beachten Sie die schönen Häuser im charakteristischen Stil der Kurorte des 19."
    ],
    "en": [
      "Vic sur Cère has been known since Celtic times for its mineral spring. It flows peacefully by the water-drinkers' kiosk, just as it did in the \"belle époque\". Take a look at these beautiful houses in the style typical of 19th-century spas."
    ],
    "it": [
      "Vic sur Cère è famosa fin dai tempi dei Celti per la sua sorgente minerale. Scorre tranquillamente dal chiosco dei bevitori d'acqua come nella \"belle époque\". Osservate le belle case nello stile tipico delle terme del XIX secolo."
    ],
    "fr": [
      "Vic sur Cère est connue depuis l'époque celtique pour sa source d'eau minérale. Elle coule paisible au kiosque des buveurs d'eau comme à la \"belle époque\". Remarquez ces belles maisons au style caractéristique des stations thermales du 19ème siècle."
    ],
    "nl": [
      "Vic sur Cère is al sinds de Keltische tijd beroemd om zijn mineraalwaterbron. Net als in de \"belle époque\" stroomt hij vredig uit de kiosk voor waterdrinkers. Bekijk de prachtige huizen in de typische stijl van 19e-eeuwse kuuroorden."
    ],
    "es": [
      "Vic sur Cère es famosa desde la época celta por su manantial mineral. Fluye tranquilamente desde el quiosco de los bebedores de agua como lo hacía en la \"belle époque\". Eche un vistazo a las hermosas casas de estilo típico de los balnearios del siglo XIX."
    ]
  },
