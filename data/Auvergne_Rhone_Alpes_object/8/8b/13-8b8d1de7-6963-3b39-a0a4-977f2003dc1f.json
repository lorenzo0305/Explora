  "rdfs:comment": {
    "de": [
      "Der Verein Bas Terre bringt Menschen zusammen, die sich für Keramik begeistern. Diese Ausstellung und der Verkauf von Töpferwaren findet im Saal der Mammutbäume im öffentlichen Garten statt."
    ],
    "en": [
      "The Bas Terre Association brings together people with a passion for ceramics. This pottery exhibition and sale will take place in the Salle des Séquoia in the public garden."
    ],
    "it": [
      "L'Associazione Bas Terre riunisce persone appassionate di ceramica. La mostra e la vendita di ceramiche si svolgeranno nella Salle des Séquoia del giardino pubblico."
    ],
    "fr": [
      "L’Association Bas Terre rassemble des personnes passionnées par la céramique. Cette exposition vente de poterie se déroulera  à la salle des Séquoia au jardin public."
    ],
    "es": [
      "La asociación Bas Terre reúne a personas apasionadas por la cerámica. Esta exposición y venta de cerámica tendrá lugar en la Salle des Séquoia del jardín público."
    ],
    "nl": [
      "De Bas Terre Association brengt mensen met een passie voor keramiek samen. Deze tentoonstelling en verkoop van aardewerk vindt plaats in de Salle des Séquoia in de openbare tuin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition - Vente Association Bas Terre"
