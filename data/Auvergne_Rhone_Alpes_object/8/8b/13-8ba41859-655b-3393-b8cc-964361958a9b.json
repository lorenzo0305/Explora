  "rdfs:comment": {
    "de": [
      "Madame Pizza steht für handgemachte Pizzen, die mit einem Lächeln serviert werden. Genießen Sie unsere Spezialitäten auf unserer Terrasse, nur wenige Schritte vom Stadtzentrum entfernt!"
    ],
    "en": [
      "Mrs. Pizza, these are homemade pizzas served with a smile. Come and enjoy our specialties on our terrace just a stone's throw from downtown!"
    ],
    "it": [
      "Madame Pizza offre pizze fatte in casa servite con un sorriso. Venite a gustare le nostre specialità sulla nostra terrazza, a due passi dal centro città!"
    ],
    "fr": [
      "Madame Pizza, ce sont des pizzas artisanales servies avec le sourire. Venez profitez de nos spécialités sur notre terrasse à 2 pas du centre-ville !"
    ],
    "es": [
      "Madame Pizza ofrece pizzas caseras servidas con una sonrisa. Venga a disfrutar de nuestras especialidades en nuestra terraza, a un paso del centro de la ciudad"
    ],
    "nl": [
      "Madame Pizza biedt huisgemaakte pizza's geserveerd met een glimlach. Kom genieten van onze specialiteiten op ons terras, op een steenworp afstand van het centrum!"
    ]
  },
