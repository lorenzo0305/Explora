  "rdfs:comment": {
    "de": [
      "Fahrradverleih: Mountainbikes, VTTAE, VTC, Rennrad, Gravel, klassische und unterstützte Kinderfahrräder, Babytragen, Anhänger.\nVerkauf und Reparatur aller Marken.\nMöglichkeit, einen Pendelbus zum Col de Rousset zu buchen (60€)."
    ],
    "en": [
      "Bike rentals: mountain bikes, ATVs, mountain bikes, road bikes, gravel bikes, classic and power-assisted children's bikes, baby carriers, trailers.\nSales and repairs of all makes.\nShuttle service to Col de Rousset available (€60)."
    ],
    "it": [
      "Noleggio di biciclette: mountain bike, ATV, mountain bike, bici da strada, gravel bike, bici classiche e a pedalata assistita per bambini, marsupi, rimorchi\r\nVendita e riparazione di tutte le marche.\r\nServizio navetta per il Col de Rousset (60?) disponibile"
    ],
    "fr": [
      "Location de vélos : VTT, VTTAE, VTC, route, gravel, vélos enfants classiques et à assistance, porte-bébés, remorques\r\nVente et réparation toutes marques.\r\nPossbilité de réserver une navette pour le col de Rousset (60€)"
    ],
    "nl": [
      "Fietsverhuur: mountainbikes, ATV's, mountainbikes, racefietsen, gravelfietsen, klassieke en gemotoriseerde kinderfietsen, bagagedragers, aanhangers, enz.\nVerkoop en reparatie van alle merken.\nPendeldienst naar Col de Rousset beschikbaar (€60)."
    ],
    "es": [
      "Alquiler de bicicletas: bicicletas de montaña, quads, mountain bikes, bicicletas de carretera, bicicletas de gravilla, bicicletas infantiles clásicas y con asistencia eléctrica, portabebés, remolques\r\nVenta y reparación de todas las marcas.\r\nServicio de lanzadera al Col de Rousset (60?) disponible"
    ]
  },
  "rdfs:label": {
    "de": [
      "Werkstatt, Verkauf, Verleih von Mountainbikes, Rennrädern und E-Bikes in Yeti."
    ],
    "en": [
      "Workshop, sales, mountain bike, road bike and VAE rentals at Yéti."
    ],
    "fr": [
      "Atelier, vente, location VTT,  vélo route et VAE à Yéti."
    ],
    "nl": [
      "Werkplaats, verkoop, verhuur van mountainbikes, racefietsen en EAB's in Yéti."
    ]
  },
