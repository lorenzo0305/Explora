  "rdfs:comment": {
    "de": [
      "Etwas abseits des Dorfes erwartet Sie eine Kirche mit einer Fassade, die weitgehend der Sonne ausgesetzt ist, als würde sie Sie zu einer Meditation vor den Bergen einladen! Neben ihrer spätbarocken Ausstattung besitzt diese Kirche eine interessante Sammlung von Reliquienschreinen."
    ],
    "en": [
      "This church, with its façade broadly exposed to the sun, awaits you a little way outside the village, as if encouraging you to meditate facing the mountains! In addition to its late Baroque décor, this church has an interesting collection of reliquaries."
    ],
    "it": [
      "La chiesa si trova a breve distanza dal villaggio. Accoglie il visitatore con la sua facciata ampiamente esposta al sole, come invitandolo a meditare di fronte alle montagne!\r\nOltre alla decorazione tardo-barocca, la chiesa ha un'interessante collezione di reliquiari."
    ],
    "fr": [
      "C'est un peu à l'écart du village que vous attend l'église à la façade largement exposée au soleil, comme pour vous inviter à méditer face aux montagnes ! Outre son décor baroque tardif, cette église possède une intéressante collection de reliquaires."
    ],
    "nl": [
      "Iets buiten het dorp wacht de kerk op je, met zijn zonnige gevel die je uitnodigt om te mediteren voor de bergen! Naast het laatbarokke decor heeft deze kerk een interessante collectie relikwieën."
    ],
    "es": [
      "A poca distancia del pueblo, la iglesia le espera con su fachada expuesta al sol, ¡como si le invitara a meditar frente a las montañas! Además de su decoración barroca tardía, esta iglesia cuenta con una interesante colección de relicarios."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church of St. Maurice"
    ],
    "it": [
      "Chiesa Saint-Maurice"
    ],
    "fr": [
      "Eglise Saint-Maurice"
    ],
    "nl": [
      "Kerk van Saint-Maurice"
    ]
  },
