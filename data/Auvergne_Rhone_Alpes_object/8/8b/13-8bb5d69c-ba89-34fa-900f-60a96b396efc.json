  "rdfs:comment": {
    "de": [
      "3 km lange Rodelbahn mit einem 40 m langen Tunnel (anspruchsvolle Abfahrt).\r\nErreichbar über den Sessellift Palafour als Après-Ski mit einem speziellen Skipass.\r\nDiese Aktivität hängt von den Schnee- und Wetterbedingungen ab"
    ],
    "en": [
      "3 km toboggan run with 40 m tunnel (challenging descent).\r\nAccessible via the Palafour chairlift après-ski with a special ski pass.\r\nActivity dependent on snow and weather conditions"
    ],
    "it": [
      "Una pista per slittini di 3 km con un tunnel di 40 m (discesa impegnativa).\r\nAccessibile tramite la seggiovia Palafour dopo lo sci con un pass speciale.\r\nL'attività dipende dalle condizioni della neve e del tempo"
    ],
    "fr": [
      "Piste de luge de 3 km, dotée d'un tunnel de 40 m (descente engagée).\r\nAccessible par le télésiège Palafour en après-ski avec un forfait spécifique.\r\nActivité dépendante des conditions d'enneigement et météorologiques"
    ],
    "es": [
      "Pista de trineo de 3 km con un túnel de 40 m (descenso difícil).\r\nAccesible a través del telesilla Palafour après-ski con un forfait especial.\r\nActividad sujeta a las condiciones meteorológicas y de nieve"
    ],
    "nl": [
      "Een rodelbaan van 3 km met een tunnel van 40 m (uitdagende afdaling).\r\nBereikbaar via de Palafour stoeltjeslift après-ski met een speciale pas.\r\nActiviteit afhankelijk van sneeuw- en weersomstandigheden"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Expédition Cobra"
    ]
  },
