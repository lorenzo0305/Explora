  "rdfs:comment": {
    "de": [
      "Historische, multimediale Schnitzeljagd! Lösen Sie die Rätsel bei der Entdeckung dieses wunderschönen Dorfes. Parcours von 1:30h für Erwachsene und Kinder ab 10 Jahren."
    ],
    "en": [
      "A heritage quiz circuit with its own app! Solve the mysteries while exploring this charming village with its historical tales. A 1 hour 30 minute route for adults and for children aged 10 and over."
    ],
    "it": [
      "Un'attività insolita per scoprire il villaggio collinare di Saint-Restitut attraverso una caccia al tesoro con indovinelli e aneddoti storici, disponibile su un'applicazione mobile Foxie."
    ],
    "fr": [
      "Activité insolite pour découvrir le village perché de Saint-Restitut via un jeu de piste avec des énigmes et des anecdotes historiques, disponible sur une application mobile Foxie."
    ],
    "es": [
      "Una actividad insólita para descubrir el pueblo de Saint-Restitut en lo alto de una colina a través de una búsqueda del tesoro con acertijos y anécdotas históricas, disponible en una aplicación móvil Foxie."
    ],
    "nl": [
      "Een half online historische speurtocht. Ontrafel raadsels en ontdek dit charmante dorp met historische anekdotes. Dit parcours van 1u30 is voor volwassenen en kinderen vanaf 10 jaar."
    ]
  },
