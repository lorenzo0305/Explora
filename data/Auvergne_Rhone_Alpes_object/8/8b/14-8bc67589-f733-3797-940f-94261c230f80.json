  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/781265c3-c021-3faf-8675-0b4ff02b7141",
      "dc:description": {
        "de": [
          "Syrisches Spezialitätenrestaurant\n\nÖffnungszeiten:\n\nMontags bis donnerstags von 12:00 bis 14:00 Uhr und von 19:00 bis 21:30 Uhr\nFreitags und samstags von 12:00 bis 14:00 Uhr und von 19:00 bis 22:00 Uhr\nSonntag geschlossen"
        ],
        "en": [
          "Syrian specialty restaurant\n\nOpening hours :\n\nMonday to Thursday, 12pm to 2pm and 7pm to 9:30pm\nFridays and Saturdays from 12h to 14h and from 19h to 22h\nClosed on Sunday"
        ],
        "it": [
          "Ristorante con specialità siriane\n\nOrari di apertura :\n\nDal lunedì al giovedì, dalle 12.00 alle 14.00 e dalle 19.00 alle 21.30\nVenerdì e sabato dalle 12.00 alle 14.00 e dalle 19.00 alle 22.00\nChiuso la domenica"
        ],
        "fr": [
          "Restaurant de spécialités syriennes \n\nHoraires d'ouverture : \n\nDu lundi au jeudi de 12h à 14h et de 19h à 21h30\nLes vendredis et samedis de 12h à 14h et de 19h à 22h\nFermé le dimanche "
        ],
        "es": [
          "Restaurante de especialidades sirias\n\nHorario de apertura :\n\nDe lunes a jueves de 12h a 14h y de 19h a 21h30\nViernes y sábados de 12h a 14h y de 19h a 22h\nDomingos cerrado"
        ],
        "nl": [
          "Restaurant met Syrische specialiteiten\n\nOpeningstijden :\n\nMaandag tot donderdag van 12 tot 14 uur en van 19 tot 21.30 uur\nVrijdag en zaterdag van 12 tot 14 uur en van 19 tot 22 uur\nGesloten op zondag"
        ]
      },
