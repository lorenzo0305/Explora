  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Nicolas besitzt einen Glockenturm aus dem 12. und 13. Jahrhundert, der Steinpfeil stammt aus dem 17. und 18."
    ],
    "en": [
      "St Nicholas Church’s bell tower dates back to the 12th/13th century, its stone spire back to the 17th/18th century, and the choir and nave to 1875."
    ],
    "it": [
      "La chiesa di San Nicola ha un campanile del XII-XIII secolo, la guglia in pietra del XVII-XVIII secolo e il coro e la navata del 1875."
    ],
    "fr": [
      "L'église Saint Nicolas possède un clocher datant du 12e-13e siècle, sa flèche de pierre daterait du 17e-18e siècle, quant au chœur et la nef du bâtiment de 1875."
    ],
    "es": [
      "La iglesia de San Nicolás tiene un campanario de los siglos XII-XIII, su aguja de piedra de los siglos XVII-XVIII y el coro y la nave de 1875."
    ],
    "nl": [
      "De Sint-Nicolaaskerk heeft een klokkentoren uit de 12e-13e eeuw, een stenen torenspits uit de 17e-18e eeuw en het koor en schip uit 1875."
    ]
  },
