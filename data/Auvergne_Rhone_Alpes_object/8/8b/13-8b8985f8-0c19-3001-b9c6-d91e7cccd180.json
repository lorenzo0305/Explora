  "rdfs:comment": {
    "de": [
      "Seit über 20 Jahren wählt Pierre Chauvet die besten Kakaosorten aus. Vollmundig, fruchtig, leicht... Mit Leidenschaft wählt er seine Kakaosorten aus, die in seinen Meisterhänden zu wahren Geschmackserlebnissen, zu köstlichen Perlen für Feinschmecker werden."
    ],
    "en": [
      "Pierre Chauvet selects for over 15 years the best cocoas . With passion, he chooses his cocoa that will become for you a real taste emotions."
    ],
    "it": [
      "Pierre Chauvet seleziona le migliori fave di cacao da oltre 20 anni. Corposo, fruttato, leggero... con passione sceglie le sue fave di cacao che diventeranno, nelle sue mani esperte, vere e proprie emozioni gustative, formidabili perle gastronomiche."
    ],
    "fr": [
      "Pierre Chauvet sélectionne depuis plus de 20 ans les meilleurs cacaos. Corsés, fruités, légers...avec passion, il choisit ses cacaos qui deviendront entre ses mains d'orfèvre, de véritables émotions gustatives, de formidables perles gourmandes."
    ],
    "nl": [
      "Pierre Chauvet selecteert al meer dan 20 jaar de beste cacao. Vol, fruitig, licht... met passie kiest hij voor zijn cacao die in zijn gouden handen veranderen in ware smaakemoties, formidabele gastronomische parels."
    ],
    "es": [
      "Pierre Chauvet lleva más de 20 años seleccionando los mejores granos de cacao. Con cuerpo, afrutado, ligero... con pasión, elige sus granos de cacao que se convertirán, en sus manos expertas, en verdaderas emociones gustativas, formidables perlas gourmet."
    ]
  },
