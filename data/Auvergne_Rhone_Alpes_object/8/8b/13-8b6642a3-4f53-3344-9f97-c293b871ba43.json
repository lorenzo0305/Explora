  "rdfs:comment": {
    "de": [
      "Als kultiger Nachtclub im Resort heißt Sie unser Etablissement jeden Abend willkommen, um zu tanzen und das Nachtleben an einem Ort zu genießen, der für Liebhaber der Nacht und der Berge konzipiert wurde."
    ],
    "en": [
      "An emblematic nightclub in the resort, our establishment welcomes you every night to dance and enjoy the nightlife in a place designed for lovers of the night and the mountains."
    ],
    "it": [
      "Discoteca simbolo della località, la nostra struttura vi accoglie ogni sera per ballare e godervi la vita notturna in un luogo pensato per gli amanti della notte e della montagna."
    ],
    "fr": [
      "Night-club emblématique de la station, notre établissement vous accueille chaque soir pour danser et profiter de la vie nocturne dans un lieu conçu pour les amoureux de la nuit et de la montagne."
    ],
    "nl": [
      "Onze iconische nachtclub in het resort nodigt u elke avond uit om te dansen en te genieten van het nachtleven, op een plek die speciaal is ontworpen voor liefhebbers van de nacht en de bergen."
    ],
    "es": [
      "La emblemática discoteca del complejo le da la bienvenida cada noche para bailar y disfrutar de la vida nocturna en un lugar pensado para los amantes de la noche y la montaña."
    ]
  },
  "rdfs:label": {
