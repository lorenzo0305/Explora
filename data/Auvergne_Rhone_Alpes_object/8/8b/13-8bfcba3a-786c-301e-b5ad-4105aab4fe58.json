  "rdfs:comment": {
    "de": [
      "\"Die letzte Amphore\", ist ein Ermittlungsspiel, ein Escape Game auf Smartphones inmitten der Weinberge. Sie werden Professor Martin dabei helfen, den Schatz der letzten Amphore zu finden, bevor er geplündert wird."
    ],
    "en": [
      "With your smartphone, you will help Professor Martin to find the treasure of the last amphora before it is looted."
    ],
    "it": [
      "\"The Last Amphora\" è un gioco di investigazione, un gioco di fuga su smartphone in mezzo ai vigneti. Aiuterete il professor Martin a trovare il tesoro dell'ultima anfora prima che venga saccheggiata."
    ],
    "fr": [
      "« La dernière amphore », est un jeu d’enquête, un escape game sur smartphone au milieu des vignes. Vous allez aider le professeur Martin à retrouver le trésor de la dernière amphore avant qu'il ne soit pillé."
    ],
    "nl": [
      "\"The Last Amphora\" is een onderzoeksspel, een ontsnappingsspel op de smartphone midden in de wijngaarden. Je zult Professor Martin helpen om de schat van de laatste amfoor te vinden voordat deze geplunderd wordt."
    ],
    "es": [
      "\"La Última Ánfora\" es un juego de investigación, un juego de escape en smartphone en medio de los viñedos. Ayudarás al profesor Martin a encontrar el tesoro de la última ánfora antes de que sea saqueada."
    ]
  },
  "rdfs:label": {
    "en": [
      "Escape Game in the vineyards: The Last Amphora"
    ],
    "fr": [
      "Escape Game dans les vignes : La Dernière Amphore"
    ]
  },
