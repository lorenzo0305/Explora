  "rdfs:comment": {
    "de": [
      "Brotfest in Chastenuel, organisiert vom Festkomitee von Jax. Auf dem Programm stehen der Verkauf von im Dorfbackofen gebackenem Brot, eine Messe mit anschließendem Aperitif, ein ländliches Essen und verschiedene Animationen für Groß und Klein."
    ],
    "en": [
      "Bread festival at Chastenuel organized by the Comité des Fêtes de Jax, with the sale of bread baked in the village oven, mass followed by an aperitif, country-style meal, and various activities for young and old."
    ],
    "it": [
      "Festa del pane a Chastenuel organizzata dal Comité des Fêtes de Jax, con un programma che prevede la vendita di pane cotto nel forno del villaggio, la Messa seguita da un aperitivo, un pasto in stile rustico e varie attività per tutte le età."
    ],
    "fr": [
      "Fête du pain à Chastenuel organisée par le Comité des Fêtes de Jax avec au programme, vente de pain cuit dans le four du village, Messe suivie d'un apéritif, repas champêtre, diverses animations pour petits et grands."
    ],
    "es": [
      "Fiesta del pan en Chastenuel organizada por el Comité des Fêtes de Jax, con un programa que incluye la venta de pan cocido en el horno del pueblo, misa seguida de un aperitivo, una comida campestre y diversas actividades para todas las edades."
    ],
    "nl": [
      "Broodfeest in Chastenuel georganiseerd door het Comité des Fêtes de Jax, met op het programma de verkoop van brood gebakken in de dorpsoven, de mis gevolgd door een aperitief, een maaltijd in landelijke stijl en verschillende activiteiten voor alle leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête du pain | Chastenuel"
    ]
  },
