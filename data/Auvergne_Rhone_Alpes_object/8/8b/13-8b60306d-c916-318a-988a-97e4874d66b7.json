  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Kulturerbe der Ardèche! Restaurierung und Wiederinbetriebnahme der Mühle, die 1820 in Betrieb genommen und 1957 stillgelegt wurde. Restauriert und 2024 wieder in Betrieb genommen. Demonstration der Funktionsweise der Mühlen und der Gestik der Müller."
    ],
    "en": [
      "Learn more about the heritage of Ardèche! Restoration and restarting of the silk mill, which was put into operation in 1784 and stopped in 1957. Demonstration of how the mills worked. Look attentively at the millers' techniques."
    ],
    "it": [
      "Scoprite il patrimonio dell'Ardèche! Restauro e riavvio del mulino, avviato nel 1820 e chiuso nel 1957. Restaurato e rimesso in funzione nel 2024. Dimostrazione del funzionamento dei mulini e di come lo facevano i mugnai."
    ],
    "fr": [
      "Découvrez le patrimoine d’Ardèche ! Restauration et remise en marche du moulinage démarré en 1820  et arrêté en 1957. Restauré et redémarré en 2024. Démonstration du fonctionnement des moulins et de la gestuelle des mouliniers."
    ],
    "es": [
      "¡Descubra el patrimonio de la Ardèche! Restauración y puesta en marcha del molino, iniciado en 1820 y cerrado en 1957. Restaurado y vuelto a poner en marcha en 2024. Demostración del funcionamiento de los molinos y de cómo lo hacían los molineros."
    ],
    "nl": [
      "Ontdek het erfgoed van de Ardèche! Restauratie en opnieuw opstarten van de molen, begonnen in 1820 en stilgelegd in 1957. Gerestaureerd en opnieuw opgestart in 2024. Demonstreer hoe de molens werken en hoe de molenaars het vroeger deden."
    ]
  },
