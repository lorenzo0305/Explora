  "rdfs:comment": {
    "de": [
      "Das Hotel Alizé mit seiner typischen \"Art-Déco\"-Architektur genießt eine außergewöhnliche und privilegierte Lage am Ufer des Genfersees und im Herzen des Stadts."
    ],
    "en": [
      "Hotel Alize proposes an architecture Typically \"art deco\". Located in front of the lake Geneva, it takes advantage of an exceptional and privileged location in the heart of the station."
    ],
    "it": [
      "L'Hotel Alizé, con la sua tipica architettura \"Art-Deco\", gode di una posizione eccezionale e privilegiata sulle rive del Lago di Ginevra e nel cuore della località."
    ],
    "fr": [
      "L'hôtel Alizé, à l'architecture typiquement \"Art-Déco\" profite d'un emplacement exceptionnel et privilégié au bord du lac Léman et au coeur de la station."
    ],
    "nl": [
      "Hotel Alizé, met zijn typische Art-Deco-architectuur, geniet van een uitzonderlijke, bevoorrechte locatie aan de oevers van het Meer van Genève en in het hart van het resort."
    ],
    "es": [
      "El Hotel Alizé, con su típica arquitectura \"Art-Deco\", goza de una ubicación excepcional y privilegiada a orillas del lago Lemán y en el corazón de la estación."
    ]
  },
