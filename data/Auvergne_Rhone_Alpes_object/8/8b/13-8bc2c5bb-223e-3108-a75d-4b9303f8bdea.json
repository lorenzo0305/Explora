  "rdfs:comment": {
    "de": [
      "Lassen Sie sich massieren und verbringen Sie einen Moment wie in der Medina in Marokko im Riad A Vichy! Erleben Sie eine Erfahrung, bei der Zeit und Raum eine andere Dimension annehmen!"
    ],
    "en": [
      "Treat yourself to a massage in the Riad A Vichy and experience a change of scenery as if you were in the Moroccan medina! An experience where time and space take on another dimension!"
    ],
    "it": [
      "Concedetevi un massaggio nel Riad A Vichy e godetevi un cambiamento di scenario come se foste nel cuore della medina marocchina! Godetevi un'esperienza in cui il tempo e lo spazio assumono un'altra dimensione!"
    ],
    "fr": [
      "Faites vous masser et passez un moment dépaysant comme en pleine médina au Maroc dans le Riad A Vichy ! Vivez une expérience où le temps et l’espace prennent une autre dimension !"
    ],
    "nl": [
      "Trakteer jezelf op een massage in Riad A Vichy en geniet van een andere omgeving alsof je in het hart van de Marokkaanse medina bent! Geniet van een ervaring waar tijd en ruimte een andere dimensie krijgen!"
    ],
    "es": [
      "Regálese un masaje en el Riad A Vichy y disfrute de un cambio de aires como si estuviera en el corazón de la medina marroquí Disfrute de una experiencia en la que el tiempo y el espacio adquieren otra dimensión"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Moment de détente au Riad À Vichy"
    ]
  },
