      "@id": "https://data.datatourisme.fr/50dcfed2-7d4a-3ebf-9585-b0d6f3a0cae8",
      "dc:description": {
        "de": [
          "Kinokomplex mit 12 Sälen, d. h. 2600 Sitzen. Säle mit 91 bis 584 Plätzen - Vermietung von Räumen - Organisation von Seminaren - Organisation von Privatpartys mit Filmvorführungen - Weihnachtsbäume - Cocktailpartys - Autoausstellungen - Verteilung von Flyern in Kisten"
        ],
        "en": [
          "Cinema complex composed of 12 cinemas with 2600 seats. Theatres from 91 to 584 seats - Hiring of theatres - Organisation of seminars - Organisation of private parties with film projection - Christmas trees - Cocktail parties - Car exhibitions - Flyer box distributions"
        ],
        "it": [
          "Complesso cinematografico con 12 sale, pari a 2600 posti. Sale da 91 a 584 posti - Affitto di sale - Organizzazione di seminari - Organizzazione di feste private con proiezione di film - Alberi di Natale - Cocktail party - Esposizioni di auto - Distribuzione di volantini in cassetta"
        ],
        "fr": [
          "Complexe cinématographique composé de 12 salles, soit 2600 fauteuils. Des salles de 91 à 584 places.- Locations de Salles - Organisation de Séminaires - Organisation de soirées privées avec projection de film - Arbres de Noël - Cocktail - Exposition de voitures - Distributions en caisses de Flyers"
        ],
        "es": [
          "Complejo cinematográfico con 12 salas, es decir, 2.600 plazas. Teatros de 91 a 584 plazas - Alquiler de salas - Organización de seminarios - Organización de fiestas privadas con proyección de películas - Árboles de Navidad - Cócteles - Exposiciones de coches - Distribución de folletos en cajas"
        ],
        "nl": [
          "Bioscoopcomplex met 12 zalen, d.w.z. 2600 zitplaatsen. Theaters van 91 tot 584 zitplaatsen - Zaalverhuur - Organisatie van seminars - Organisatie van privéfeesten met filmvoorstellingen - Kerstbomen - Cocktailparty's - Autotentoonstellingen - Flyerverspreiding in kratten"
        ]
      },
