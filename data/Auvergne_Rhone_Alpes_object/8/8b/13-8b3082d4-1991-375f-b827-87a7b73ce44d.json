  "rdfs:comment": {
    "de": [
      "Die Verwaltung einer Bibliothek, die allen Bewohnern der Gemeinde und der Umgebung offen steht (Ausleihe und Konsultation von Dokumenten) ein öffentlicher Raum der Begegnung, der Auseinandersetzung und der Reflexion."
    ],
    "en": [
      "The management of a library open to all residents of the commune and surrounding area, (loans and consultation of documents) a public space for meeting, discussion and reflection."
    ],
    "it": [
      "La gestione di una biblioteca aperta a tutti i residenti del comune e dell'area circostante (prestito e consultazione di documenti), uno spazio pubblico per incontri, discussioni e riflessioni."
    ],
    "fr": [
      "La gestion d’une bibliothèque ouverte à tous les habitants de la commune et des environs, (prêts et consultation de documents) un espace public de rencontre, de confrontation et de réflexion."
    ],
    "es": [
      "La gestión de una biblioteca abierta a todos los habitantes del municipio y alrededores (préstamo y consulta de documentos), un espacio público de encuentro, debate y reflexión."
