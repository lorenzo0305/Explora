  "rdfs:comment": {
    "de": [
      "Nur 15 Minuten von Grenoble entfernt, im Herzen des regionalen Naturparks Vercors, entdecken Sie eine gesellige, bodenständige und für alle zugängliche Küche, in der die Zeit stillzustehen scheint. Pluspunkte: die Lage, die atemberaubende Aussicht und die Terrasse."
    ],
    "en": [
      "Only 15 minutes from Grenoble, in the heart of the Vercors Regional Natural Park, come and discover a convivial, local and accessible cuisine where time seems to have stood still. The plusses: the location, the breathtaking view and the terrace."
    ],
    "it": [
      "A soli 15 minuti da Grenoble, nel cuore del parco naturale regionale del Vercors, venite a scoprire una cucina accogliente e locale, accessibile a tutti, dove il tempo sembra essersi fermato. I vantaggi: la posizione, la vista mozzafiato e la terrazza."
    ],
    "fr": [
      "A seulement 15 minutes de Grenoble, au coeur du parc naturel régional du Vercors, venez découvrir une cuisine conviviale, du terroir et accessible à tous où le temps semble s'être suspendu. Les + : la situation, la vue imprenable et la terrasse."
    ],
    "nl": [
      "Op slechts 15 minuten van Grenoble, in het hart van het regionale natuurpark van de Vercors, ontdekt u een vriendelijke, lokale keuken, toegankelijk voor iedereen, waar de tijd lijkt stil te staan. De voordelen: de ligging, het adembenemende uitzicht en het terras."
    ],
    "es": [
      "A sólo 15 minutos de Grenoble, en el corazón del parque natural regional del Vercors, venga a descubrir una cocina de proximidad, accesible a todos, donde el tiempo parece detenerse. Las ventajas: la ubicación, las impresionantes vistas y la terraza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Auberge des Trois Pucelles"
    ]
  },
