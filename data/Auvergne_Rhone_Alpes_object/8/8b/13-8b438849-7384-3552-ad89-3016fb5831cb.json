  "rdfs:comment": {
    "de": [
      "Maßanfertigung von personalisierter Kleidung für ein einzigartiges Kleidungsstück ganz nach Ihren Maßen, für jeden Tag oder für einen besonderen Anlass.\r\nÄnderung von Kleidungsstücken.\r\nNähkurse in Einzelunterricht für Erwachsene und Kinder oder in kleinen Gruppen."
    ],
    "en": [
      "Made-to-measure personalized garments for a one-of-a-kind garment entirely to your measurements, for every day or for a special occasion.\r\nAlterations.\r\nPrivate sewing lessons for adults and children, or in small groups."
    ],
    "it": [
      "Abbigliamento su misura per un capo unico interamente su misura, da indossare tutti i giorni o per un'occasione speciale.\r\nAlterazioni.\r\nLezioni private di cucito per adulti e bambini, o in piccoli gruppi."
    ],
    "fr": [
      "Confection sur mesure de vêtements personnalisés pour un vêtement unique entièrement à vos mesures, pour tous les jours ou pour une occasion spéciale.\r\nRetouches.\r\nCours de couture en cours particuliers pour adultes et enfants ou en petit groupe."
    ],
    "es": [
      "Ropa a medida para una prenda única totalmente a su medida, para el día a día o para una ocasión especial.\r\nModificaciones.\r\nClases particulares de costura para adultos y niños, o en pequeños grupos."
    ],
    "nl": [
      "Kleding op maat voor een uniek kledingstuk helemaal op maat, voor alledaagse kleding of voor een speciale gelegenheid.\r\nAanpassingen.\r\nPrivé-naailessen voor volwassenen en kinderen, of in kleine groepen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au fil de mes idées, créations Matcléor"
    ]
  },
