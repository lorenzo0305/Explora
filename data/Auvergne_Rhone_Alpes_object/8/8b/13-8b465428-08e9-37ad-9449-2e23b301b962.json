  "rdfs:comment": {
    "de": [
      "In Ébreuil, am Ufer des Flusses, ist die Bar/Restaurant La Guinguette du Camping des Nières für alle geöffnet und bietet eine ruhige Ecke, in der Sie Ihren Durst löschen, essen und warum nicht auch tanzen können. Abends finden Konzerte statt. Imbiss/Restaurant."
    ],
    "en": [
      "In Ebreuil, by the river, the restaurant La Guinguette of Camping des Nières is open to all . Evenings concerts; Regional specialties and pizzas on site or to take away."
    ],
    "it": [
      "A Ébreuil, sulle rive del fiume, il bar-ristorante La Guinguette du Camping des Nières è aperto a tutti e offre un luogo tranquillo per dissetarsi, mangiare e, perché no, ballare. Concerti serali. Snack bar/ristorante."
    ],
    "fr": [
      "À Ébreuil, au bord de la rivière, le bar/restaurant La Guinguette du Camping des Nières est ouvert à tous et offre un coin tranquille où se désaltérer, manger et pourquoi pas danser. Soirées concerts. Snack/restaurant."
    ],
    "nl": [
      "In Ébreuil, aan de oever van de rivier, is bar/restaurant La Guinguette du Camping des Nières open voor iedereen. Hier kun je in alle rust je dorst lessen, eten en, waarom niet, dansen. Avondconcerten. Snackbar/restaurant."
    ],
    "es": [
      "En Ébreuil, a orillas del río, el bar-restaurante La Guinguette du Camping des Nières está abierto a todos y ofrece un lugar tranquilo para saciar la sed, comer y, por qué no, bailar. Conciertos nocturnos. Snack bar/restaurante."
    ]
  },
  "rdfs:label": {
