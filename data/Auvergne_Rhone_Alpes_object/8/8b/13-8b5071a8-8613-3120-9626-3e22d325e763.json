  "rdfs:comment": {
    "de": [
      "Im Süden der Ardèche, entdecken Sie das Familienweingut von Séverine und Patrice und verkosten Sie ihre Weine. Gîte des Mûriers - Gîtes de France 3 Epis (Ferienwohnungen 3 Sterne)."
    ],
    "en": [
      "Come and meet Séverine and Patrice on their family-run estate in Southern Ardèche. Discover their passion for wine-making whilst tasting their wines. Les Mûriers holiday cottage (Gite de France labelled, 3 cornheads)."
    ],
    "it": [
      "Sul nostro magnifico altopiano di GRAS, vi invitiamo a scoprire la nostra tenuta a conduzione familiare e a coltivazione biologica e a degustare i nostri vini bianchi, rosati e rossi IGP ARDECHE per deliziare il vostro palato."
    ],
    "fr": [
      "Sur nôtre magnifique Plateau de GRAS, nous vous accueillons pour  vous faire découvrir nôtre Domaine Familial en Agriculture Biologique autour d'une dégustation de nos Vins en IGP ARDECHE Blanc, Rosé, Rouge qui régalerons vos papilles."
    ],
    "nl": [
      "Welkom op het domein van Séverine en Patrice die u laten proeven van hun wijnen. Voor de kinderen is er druivensap voorzien."
    ],
    "es": [
      "En nuestra magnífica meseta GRAS, le invitamos a descubrir nuestra explotación familiar de agricultura ecológica y a degustar nuestros vinos IGP ARDECHE Blanco, Rosado y Tinto para deleitar su paladar."
    ]
  },
