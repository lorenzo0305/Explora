  "rdfs:comment": {
    "de": [
      "Dieser Slopestyle mit einer Reihe von Table, Bonnerlog, Doppelbuckel, Step Down und einem großen Kicker mit Spanlandung richtet sich an Fahrer mit guten Sprungkenntnissen."
    ],
    "en": [
      "This slopestyle features a table, bonnerlog, double bump, step down and a big kicker with a chip landing and is aimed at riders with a good knowledge of jumping."
    ],
    "it": [
      "Questo slopestyle presenta una tavola, un bonnerlog, un doppio bump, uno step down e un grande kicker con atterraggio in chip ed è rivolto a rider con una buona conoscenza dei salti."
    ],
    "fr": [
      "Ce slopestyle enchaînant table, bonnerlog, bosse double, step down et un gros kicker avec réception en copeaux s'adresse aux riders ayant une bonne connaissance du saut."
    ],
    "es": [
      "Este slopestyle cuenta con una tabla, bonnerlog, doble bump, step down y un gran kicker con aterrizaje en chip y está dirigido a riders con buenos conocimientos de salto."
    ],
    "nl": [
      "Deze slopestyle bevat een tafel, bonnerlog, dubbele bump, step down en een grote kicker met een chiplanding en is bedoeld voor mountainbikers met een goede kennis van springen."
    ]
  },
