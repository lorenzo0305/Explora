  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten lädt Sie die Résidence Club MMV Samoëns Village **** zu einem Moment der Ruhe und Gelassenheit ein. Entdecken Sie das SPA, das auch externen Gästen offen steht, und lassen Sie sich von den natürlichen Behandlungen und Massagen von Fleur's verwöhnen."
    ],
    "en": [
      "At the foot of the slopes, in the village, the Résidence Club MMV Samoëns Village **** invites you to take a serene break. Discover our SPA, open to outside guests, and indulge in Altearah BIO natural treatments and massages."
    ],
    "it": [
      "Ai piedi delle piste, il Résidence Club MMV Samoëns Village **** invita a prendersi una pausa serena. Scoprite la sua SPA, aperta agli ospiti esterni al resort, e concedetevi i trattamenti naturali e i massaggi di Fleur's."
    ],
    "fr": [
      "Au pied des pistes, la Résidence Club MMV Samoëns Village **** vous invite à une parenthèse de sérénité. Découvrez son SPA, ouvert à la clientèle extérieure, et laissez vous tenter par des soins et massages naturels signés Fleur's."
    ],
    "nl": [
      "Aan de voet van de pistes, in het dorp, nodigt Résidence Club MMV Samoëns Village **** je uit voor een moment van sereniteit. Ontdek de SPA, open voor gasten van buiten het resort, en laat je verwennen met natuurlijke behandelingen en massages aangeboden door Altearah BIO."
    ],
    "es": [
      "A pie de pistas, la Résidence Club MMV Samoëns Village **** le invita a una pausa serena. Descubra su SPA, abierto a huéspedes de fuera de la estación, y deléitese con los tratamientos naturales y masajes de Fleur's."
    ]
  },
  "rdfs:label": {
    "en": [
      "Spa by MMV ® – Résidence Club MMV Samoëns Village"
    ],
    "fr": [
