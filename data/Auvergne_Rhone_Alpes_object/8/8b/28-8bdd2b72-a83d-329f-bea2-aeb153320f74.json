  "rdfs:comment": {
    "de": [
      "Der Bienenstock Rucher de la clairière aux oiseaux bietet verschiedene Produkte aus seinen Bienenstöcken zum Verkauf an: Waldhonig, Lindenhonig, Kastanienhonig, Sommerhonig, Frühlingshonig, Pollen."
    ],
    "en": [
      "The Apiary of the Bird Clearing offers for sale several products from its hives: Forest honey, Lime tree honey, Chestnut tree honey, Summer honey, Spring honey, pollen."
    ],
    "it": [
      "Il Rucher de la clairière aux oiseaux offre in vendita diversi prodotti dei suoi alveari: miele di bosco, miele di tiglio, miele di castagno, miele estivo, miele primaverile, polline."
    ],
    "fr": [
      "Le Rucher de la clairière aux oiseaux propose à la vente plusieurs produits issus de ses ruches : miel de Forêt, miel de Tilleul, miel de Châtaignier, miel d’Été, miel de printemps, pollen."
    ],
    "es": [
      "El Rucher de la clairière aux oiseaux ofrece a la venta varios productos de sus colmenas: miel de bosque, miel de tilo, miel de castaño, miel de verano, miel de primavera, polen."
    ],
    "nl": [
      "De Rucher de la clairière aux oiseaux biedt verschillende producten uit zijn bijenkasten te koop aan: boshoning, lindehoning, kastanjehoning, zomerhoning, voorjaarshoning, stuifmeel."
    ]
  },
