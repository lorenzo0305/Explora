  "rdfs:comment": {
    "de": [
      "Laufen Sie gerne bergab?!\r\n\r\nNehmen Sie am ersten Trailrennen im Hochgebirge teil, bei dem es 100% bergab geht. Nehmen Sie am Megavalanche Trail de l'Alpe d'Huez teil!"
    ],
    "en": [
      "Do you like running downhill?\r\n\r\nTake part in the first 100% downhill high-mountain trail race, the Megavalanche Trail de l'Alpe d'Huez!"
    ],
    "it": [
      "Le piace correre in discesa?\r\n\r\nPartecipate alla prima gara di trail di alta montagna al 100% in discesa, il Megavalanche Trail de l'Alpe d'Huez!"
    ],
    "fr": [
      "Vous aimez courir en descente ?!\r\n\r\nLancez vous dans la première course de Trail de haute montagne 100% descendante, participez à la Megavalanche Trail de l’Alpe d’Huez !"
    ],
    "es": [
      "¿Te gusta correr cuesta abajo?\r\n\r\n¡Participa en la primera carrera de trail de alta montaña 100% cuesta abajo, la Megavalanche Trail de l'Alpe d'Huez!"
    ],
    "nl": [
      "Loop je graag bergafwaarts?\r\n\r\nDoe dan mee aan de eerste 100% downhill trailrace in het hooggebergte, de Megavalanche Trail de l'Alpe d'Huez!"
    ]
  },
