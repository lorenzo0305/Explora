  "rdfs:comment": {
    "de": [
      "In der Nähe des Dorfes, traditionelle Küche mit dem Duft vergangener Zeiten und Gerichten aus der Region, die Sie vor Ort auf der überdachten Terrasse oder im Speisesaal genießen können. Vorteil: Aufblasbarer Spielplatz für Kinder."
    ],
    "en": [
      "Close to the village, traditional cuisine with a flavour of yesteryear, with local dishes served on the covered terrace or in the dining room. Bonus: Inflatable play area for children."
    ],
    "it": [
      "Vicino al villaggio, cucina tradizionale dal sapore d'altri tempi e piatti locali da gustare sulla terrazza coperta o nella sala da pranzo. Bonus: area giochi gonfiabili per bambini."
    ],
    "fr": [
      "Proche du village, cuisine traditionnelle aux parfums d'antan avec des plats de pays à déguster sur place en terrasse couverte ou en salle. Le + : Aire de jeux gonflable pour les enfants."
    ],
    "nl": [
      "Dicht bij het dorp, traditionele keuken met de smaak van weleer en lokale gerechten om van te genieten op het overdekte terras of in de eetzaal. Bonus: Opblaasbare speeltuin voor kinderen."
    ],
    "es": [
      "Cerca del pueblo, cocina tradicional con sabor de antaño y platos locales para degustar en la terraza cubierta o en el comedor. Bonus: zona de juegos hinchable para los niños."
    ]
  },
  "rdfs:label": {
