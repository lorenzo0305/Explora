  "rdfs:comment": {
    "de": [
      "Gesellige Küche & Cateringservice nach Maß, Tischfußball, Darts, Karten & gute Laune, Nachbarschaftsdienste, die den Alltag erleichtern, ein Ort der Geselligkeit und des Teilens im Herzen des Dorfes"
    ],
    "en": [
      "Convivial cuisine & made-to-measure catering, table soccer, darts, cards & good humour, local services to make everyday life easier, a place of conviviality and sharing in the heart of the village"
    ],
    "it": [
      "Cucina conviviale e servizio di catering su misura, calcio balilla, freccette, carte e buon umore, servizi locali per facilitare la vita quotidiana, un luogo di incontro e condivisione nel cuore del villaggio"
    ],
    "fr": [
      "Cuisine conviviale & service traiteur sur mesure, baby-foot, fléchettes, cartes & bonne humeur, services de proximité pour faciliter le quotidien, un lieu de convivialité et de partage au cœur du village"
    ],
    "nl": [
      "Gezellige keuken en catering op maat, tafelvoetbal, darts, kaarten en een goed humeur, lokale diensten om het dagelijks leven gemakkelijker te maken, een plek om samen te komen en te delen in het hart van het dorp"
    ],
    "es": [
      "Cocina de convivencia y servicio de catering a medida, futbolín, dardos, cartas y buen humor, servicios locales para facilitar la vida cotidiana, un lugar para reunirse y compartir en el corazón del pueblo"
    ]
  },
