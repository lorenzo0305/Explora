  "rdfs:comment": {
    "de": [
      "Hotel an der Autobahn A40 auf der Höhe von Bourg-en-Bresse, zwischen den Ausfahrten 6 und 7, perfekt gelegen für Ihre Reisen ans Meer oder in die Berge. Hotel in der Nähe für Geschäftsreisen oder Familienveranstaltungen."
    ],
    "en": [
      "Hotel located on the A40 freeway near Bourg-en-Bresse, between exits 6 and 7, perfectly situated for your trips to the sea or the mountains. Hotel of proximity for business trips or family events."
    ],
    "it": [
      "Hotel situato sull'autostrada A40 vicino a Bourg-en-Bresse, tra le uscite 6 e 7, in posizione perfetta per le vostre gite al mare o in montagna. L'hotel è vicino per viaggi d'affari o eventi familiari."
    ],
    "fr": [
      "Hôtel situé sur l'autoroute A40 à hauteur de Bourg-en-Bresse, entre les sorties 6 et 7, parfaitement situé pour vos déplacements à la mer ou à la montagne. Hôtel de proximité pour des déplacements professionnels ou événements familiaux."
    ],
    "es": [
      "Hotel situado en la autopista A40, cerca de Bourg-en-Bresse, entre las salidas 6 y 7, perfectamente situado para sus viajes al mar o a la montaña. El hotel está cerca para viajes de negocios o eventos familiares."
    ],
    "nl": [
      "Hotel gelegen aan de A40 bij Bourg-en-Bresse, tussen afritten 6 en 7, perfect gelegen voor uw uitstapjes naar de zee of de bergen. Het hotel is dichtbij voor zakenreizen of familiebijeenkomsten."
    ]
  },
