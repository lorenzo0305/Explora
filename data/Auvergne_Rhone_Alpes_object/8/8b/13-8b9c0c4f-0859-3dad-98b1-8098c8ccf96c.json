  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf den Weg zu den Gipfeln mit dieser Panoramatour, die Sie über die Bergkämme von La Toussuire und Le Corbier führt.\r\nEine der schönsten Aussichten auf die Sybelles und die umliegenden Berge!"
    ],
    "en": [
      "Take the direction of the summits with this panoramic circuit leading you on the ridges of La Toussuire and Corbier.\r\nOne of the sectors offering the most beautiful views of the Sybelles and the surrounding area!"
    ],
    "it": [
      "Puntate alle vette con questo circuito panoramico che vi porterà sulle creste di La Toussuire e Le Corbier.\r\nUno dei settori che offre le più belle viste sulle Sybelles e sui massicci circostanti!"
    ],
    "fr": [
      "Prenez la direction des sommets avec ce circuit panoramique vous menant sur les crêtes de La Toussuire et du Corbier.\r\nUn des secteur proposant les plus beaux points de vue sur les Sybelles et les massifs alentours!"
    ],
    "nl": [
      "Neem de richting van de toppen met dit panoramische circuit dat je leidt over de bergkammen van La Toussuire en Corbier.\r\nEen van de sectoren met het mooiste uitzicht op de Sybelles en de omliggende gebieden!"
    ],
    "es": [
      "Diríjase a las cumbres con este circuito panorámico que le llevará a las crestas de La Toussuire y Le Corbier.\r\nUno de los sectores que ofrece las más bellas vistas de los Sybelles y de los macizos circundantes"
    ]
  },
  "rdfs:label": {
    "en": [
      "Crests route"
    ],
    "fr": [
      "Circuit des crêtes"
    ],
    "nl": [
      "Toppen route"
    ]
  },
