  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Neva Restaurant, das sich im Herzen von Val Thorens in der Rue Caron befindet. Genießen Sie eine authentische traditionelle französische Küche, inspiriert von den Rezepten unserer Großmütter, in einer warmen und freundlichen Atmosphäre."
    ],
    "en": [
      "Discover the Neva Restaurant, located in the heart of Val Thorens, on Rue Caron. Savour authentic traditional French cuisine, inspired by our grandmothers' recipes, in a warm and friendly atmosphere."
    ],
    "it": [
      "Scoprite il ristorante Neva, situato nel cuore di Val Thorens, in rue Caron. Gustate l'autentica cucina tradizionale francese, ispirata alle ricette delle nostre nonne, in un'atmosfera calda e conviviale."
    ],
    "fr": [
      "Découvrez le Neva Restaurant, situé au cœur de Val Thorens, rue Caron. Savourez une cuisine traditionnelle française authentique, inspirée des recettes de nos grands-mères, dans une ambiance chaleureuse et conviviale."
    ],
    "nl": [
      "Ontdek het Neva Restaurant, gelegen in het hart van Val Thorens, in de Rue Caron. Geniet van authentieke traditionele Franse gerechten, geïnspireerd op de recepten van onze grootmoeders, in een warme en gezellige sfeer."
    ],
    "es": [
      "Descubra el restaurante Neva, situado en el corazón de Val Thorens, en la calle Caron. Disfrute de una auténtica cocina tradicional francesa, inspirada en las recetas de nuestras abuelas, en un ambiente cálido y acogedor."
    ]
  },
