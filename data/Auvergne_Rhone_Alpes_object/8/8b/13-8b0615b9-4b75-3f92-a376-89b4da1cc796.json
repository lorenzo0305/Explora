  "rdfs:comment": {
    "de": [
      "Schöner Orientierungstisch in Haut-Livron, der sich auf dem Aussichtspunkt am Ende des Place du Vieux Marché befindet und den Fluss Drôme überblickt. Die Landschaft erstreckt sich von den Ausläufern des Vercors bis zum Mont Brian. Start des Wanderwegs \"Randonnée des coteaux du Brézème\"."
    ],
    "en": [
      "Beautiful panoramic viewpoint at Haut-Livron on the belvedere at the end of Place du Vieux Marché overlooking the Drôme river. The landscape stretches from the foothills of the Vercors to Mont Brian. Start of the Brézème hillsides hiking trail."
    ],
    "it": [
      "Haut-Livron ha un bellissimo punto panoramico situato sul belvedere alla fine della Place du Vieux Marché che si affaccia sul fiume Drôme. Il paesaggio si estende dalle pendici del Vercors al Mont Brian. Inizio del sentiero delle colline di Brézème."
    ],
    "fr": [
      "Belle table d'orientation au Haut-Livron située sur le belvédère au bout de la Place du Vieux Marché surplombant la rivière Drôme. Le paysage s'étend depuis les contreforts du Vercors jusqu'au Mont Brian. Départ du chemin Randonnée des coteaux du Brézème."
    ],
    "nl": [
      "Haut-Livron heeft een prachtig panoramisch uitkijkpunt op de belvedère aan het einde van de Place du Vieux Marché met uitzicht op de rivier de Drôme. Het landschap strekt zich uit van de uitlopers van de Vercors tot de Mont Brian. Start van de Brézème heuvels wandelroute."
    ],
    "es": [
      "Haut-Livron cuenta con un hermoso mirador situado en el belvedere al final de la Place du Vieux Marché que domina el río Drôme. El paisaje se extiende desde las estribaciones del Vercors hasta el Mont Brian. Inicio del sendero de las laderas del Brézème."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'Orientation 1 - Haut-Livron"
    ]
  },
