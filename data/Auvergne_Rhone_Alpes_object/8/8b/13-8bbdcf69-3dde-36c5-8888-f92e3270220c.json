  "rdfs:comment": {
    "de": [
      "Almrestaurant, am Ausgangspunkt der Langlaufloipen und Wanderwege auf dem Plateau des Glières. Savoyische Spezialitäten: Kartoffelkrapfen, Farcement, Heidelbeerkuchen, Käsefondue & Raclette auf Vorbestellung"
    ],
    "en": [
      "Alpine restaurant at the start of cross-country ski trails and hiking paths on the Plateau des Glières. Savoyard specialities: potato fritters, stuffing, blueberry tart, cheese fondue & raclette on reservation"
    ],
    "it": [
      "Ristorante alpino, all'inizio delle piste di sci di fondo e delle escursioni sul Plateau des Glières. Specialità savoiarde: frittelle di patate, ripieno, crostata di mirtilli, fonduta di formaggio e raclette su prenotazione"
    ],
    "fr": [
      "Restaurant d'alpage, au départ des pistes de ski de fond et des sentiers de randonnées sur le Plateau des Glières. Spécialités savoyardes : beignets de patate, farcement, tarte aux myrtilles, fondue au fromage & raclette  sur réservation"
    ],
    "es": [
      "Restaurante alpino, al comienzo de las pistas de esquí de fondo y de senderismo del Plateau des Glières. Especialidades de Saboya: buñuelos de patata, relleno, tarta de arándanos, fondue de queso y raclette previa reserva"
    ],
    "nl": [
      "Alpenrestaurant, aan het begin van de langlauf- en wandelpaden op het Plateau des Glières. Savoyaardse specialiteiten: aardappelbeignets, vulling, bosbessentaart, kaasfondue & raclette op reservering"
    ]
  },
  "rdfs:label": {
    "en": [
      "Café Restaurant Chez Régina"
    ],
    "fr": [
      "Café Restaurant Chez Régina"
    ]
