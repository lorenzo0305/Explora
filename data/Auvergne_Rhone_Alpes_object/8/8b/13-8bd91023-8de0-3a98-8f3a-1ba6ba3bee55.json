  "rdfs:comment": {
    "de": [
      "Die Ski- und Outdoor-Abenteuerschule Evolution 2 Saint-Gervais empfängt Sie das ganze Jahr über, um Sie zu Abenteuern in den Bergen zu verführen!"
    ],
    "en": [
      "The Evolution 2 Saint-Gervais ski and outdoor adventure school welcomes you all year round for mountain adventures!"
    ],
    "it": [
      "La scuola di sci e avventure outdoor Evolution 2 Saint-Gervais vi accoglie tutto l'anno per farvi vivere avventure in montagna!"
    ],
    "fr": [
      "L’école de ski et d’aventures outdoor Evolution 2 Saint-Gervais vous accueille toute l’année pour vous faire vivre des aventures en montagne !"
    ],
    "es": [
      "La escuela de esquí y aventura al aire libre Evolution 2 Saint-Gervais te acoge todo el año para que disfrutes de tus aventuras en la montaña"
    ],
