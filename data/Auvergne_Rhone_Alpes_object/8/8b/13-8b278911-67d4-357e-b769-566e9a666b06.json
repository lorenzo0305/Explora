  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Auswahl an Winzern, verkosten Sie außergewöhnliche Weine und erkunden Sie den Reichtum unseres Terroirs. Ein Muss für alle Weinliebhaber."
    ],
    "en": [
      "Discover a selection of winegrowers, taste exceptional vintages and explore the richness of our terroirs. An unmissable event for wine lovers."
    ],
    "it": [
      "Scoprite una selezione di viticoltori, degustate annate eccezionali ed esplorate la ricchezza dei nostri terroir. Un appuntamento imperdibile per tutti gli amanti del vino."
    ],
    "fr": [
      "Découvrez une sélection de vignerons, dégustez des crus d’exception et explorez la richesse de nos terroirs. Un rendez-vous incontournable pour les amateurs de vin."
    ],
    "nl": [
      "Ontdek een selectie van wijnboeren, proef uitzonderlijke wijnen en verken de rijkdom van onze terroirs. Een must voor alle wijnliefhebbers."
    ],
    "es": [
      "Descubra una selección de viticultores, deguste añadas excepcionales y explore la riqueza de nuestros terruños. Una visita obligada para todos los amantes del vino."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salon des vins de France et produits du terroir"
    ]
  },
