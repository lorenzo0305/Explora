  "rdfs:comment": {
    "de": [
      "Bäuerlicher Bauernhof mit biologischer Landwirtschaft, Ziegen- und Milchkuhzucht in biologischer Landwirtschaft in der Gemeinde Dompierre-sur-Besbre. Verarbeitung der Milch auf dem Hof in unserer Käserei."
    ],
    "en": [
      "Ferme paysanne en Agriculture Biologique, organic goat and dairy cow farm in the commune of Dompierre-sur-Besbre. Milk is processed on the farm in our cheese dairy."
    ],
    "it": [
      "Azienda agricola biologica che alleva capre e mucche da latte biologiche nel comune di Dompierre-sur-Besbre. Il latte viene lavorato in azienda nel nostro caseificio."
    ],
    "fr": [
      "Ferme paysanne en Agriculture Biologique, élevage de chèvres et de vaches laitières en Agriculture Biologique sur la commune de Dompierre-sur-Besbre. Transformation du lait à la ferme dans notre fromagerie."
    ],
    "es": [
      "Granja de agricultura ecológica que cría cabras y vacas lecheras ecológicas en el municipio de Dompierre-sur-Besbre. La leche se procesa en la granja en nuestra quesería."
    ],
    "nl": [
      "Biologische boerderij met biologische geiten en melkkoeien in de gemeente Dompierre-sur-Besbre. De melk wordt op de boerderij verwerkt in onze kaasmakerij."
    ]
  },
