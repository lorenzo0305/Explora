  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit Celtic Spirit of Ireland, einer außergewöhnlichen irischen Tanzshow, die seit mehr als zwei Jahrzehnten das Publikum auf der ganzen Welt in ihren Bann zieht, in das Herz des reichen kulturellen Erbes Irlands ein."
    ],
    "en": [
      "Immerse yourself in Ireland's rich cultural heritage with Celtic Spirit of Ireland, an extraordinary Irish dance show that has been captivating audiences around the world for over two decades."
    ],
    "it": [
      "Immergetevi nel ricco patrimonio culturale irlandese con Celtic Spirit of Ireland, uno straordinario spettacolo di danza irlandese che da oltre due decenni affascina il pubblico di tutto il mondo."
    ],
    "fr": [
      "Plongez au coeur du riche héritage culturel de l'Irlande avec Celtic Spirit of Ireland, un spectacle extraordinaire de danse irlandaise qui captive les publics du monde entier depuis plus de deux décennies."
    ],
    "es": [
      "Sumérjase en el rico patrimonio cultural irlandés con Celtic Spirit of Ireland, un extraordinario espectáculo de danza irlandesa que lleva más de dos décadas cautivando al público de todo el mundo."
    ],
    "nl": [
      "Dompel jezelf onder in het rijke culturele erfgoed van Ierland met Celtic Spirit of Ireland, een buitengewone Ierse dansshow die al meer dan twintig jaar publiek over de hele wereld in vervoering brengt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Celtic spirit of Ireland"
    ]
  },
