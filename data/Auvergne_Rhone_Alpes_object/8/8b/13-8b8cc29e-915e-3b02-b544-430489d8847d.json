  "rdfs:comment": {
    "de": [
      "Pastel ist ein spielerischer Teesalon. Hier werden serviert: Frühstück, Brunch, Mittagessen, Snacks, heiße und kalte Getränke vor Ort oder zum Mitnehmen. In einem warmen und gemütlichen Rahmen finden Sie auch eine Boutique für Kinder - Erwachsene - Haus."
    ],
    "en": [
      "Pastel is a playful tea room. We serve breakfast, brunch, lunch, snacks, hot and cold drinks on the premises or to take away. In a warm and cosy setting, you'll also find a children's - adult - home boutique."
    ],
    "it": [
      "Pastel è una divertente sala da tè. Serviamo colazione, brunch, pranzo, snack, bevande calde e fredde in loco o da asporto. In un ambiente caldo e accogliente, troverete anche un negozio di articoli per bambini e adulti."
    ],
    "fr": [
      "Pastel est un salon de thé ludique. On y sert : petit déjeuner, Brunch, déjeuner, goûter, boissons chaudes et fraiches sur place ou à emporter. Dans un cadre chaleureux et cosy, vous trouverez aussi une boutique enfants - adultes- maison."
    ],
    "nl": [
      "Pastel is een leuke theesalon. We serveren ontbijt, brunch, lunch, snacks, warme en koude dranken ter plekke of om mee te nemen. In een warme en gezellige omgeving vind je ook een kinder-, volwassenen- en huishoudwinkel."
    ],
    "es": [
      "Pastel es un divertido salón de té. Servimos desayunos, brunch, almuerzos, meriendas y bebidas frías y calientes en el mismo local o para llevar. En un ambiente cálido y acogedor, también encontrará una tienda para niños - adultos - a domicilio."
    ]
  },
  "rdfs:label": {
    "fr": [
