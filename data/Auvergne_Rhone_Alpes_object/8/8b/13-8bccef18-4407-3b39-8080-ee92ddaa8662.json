  "rdfs:comment": {
    "de": [
      "Les Seychelles, ein Restaurant und eine Pizzeria im Zentrum des Ortes Courpière, bietet Ihnen Pizzen, die à la minute zubereitet und im Holzofen gebacken werden, sowie andere Pastagerichte und Salate und eine freundliche Atmosphäre."
    ],
    "en": [
      "Les Seychelles, restaurant and pizzeria located in the centre of Courpière, offers pizzas, prepared by the minute and cooked over a wood fire, and other pastas and salads, and a friendly atmosphere."
    ],
    "it": [
      "Les Seychelles, ristorante e pizzeria situato nel centro di Courpière, vi offre pizze preparate al minuto e cotte a legna, oltre a paste e insalate, in un'atmosfera accogliente."
    ],
    "fr": [
      "Les Seychelles, restaurant et pizzeria situé dans le centre bourg de Courpière, vous propose pizzas, préparées à la minute et cuites au feu de bois, et autres pâtes et salades, et ambiance conviviale."
    ],
    "es": [
      "Les Seychelles, restaurante y pizzería situado en el centro de Courpière, le ofrece pizzas, preparadas al minuto y cocinadas a fuego de leña, y otras pastas y ensaladas, en un ambiente acogedor."
    ],
    "nl": [
      "Les Seychelles, een restaurant en pizzeria in het centrum van Courpière, biedt u pizza's, op de minuut bereid en gekookt op houtvuur, en andere pasta's en salades, in een gezellige sfeer."
    ]
  },
  "rdfs:label": {
