      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/a1f1dcac-08e4-38f2-a6cd-3dec489b0b28",
          "schema:validFrom": "2026-06-01T00:00:00",
          "schema:validThrough": "2026-09-30T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "In der Hochsaison im Sommer ist das Geschäft von 9:00 bis 19:00 Uhr durchgehend geöffnet.\r\nIn der Winterhochsaison ist das Geschäft durchgehend von 8:00 bis 19:00 Uhr geöffnet.\r\nIn der Nebensaison ist das Geschäft montags bis freitags von 9:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr und am Wochenende von 9:00 bis 19:00 Uhr durchgehend geöffnet."
            ],
            "en": [
              "In high summer season, the store is open from 9am to 7pm non-stop.\r\nIn high winter season, the store is open from 8am to 7pm non-stop.\r\nIn low season, the store is open from 9am to 12pm and from 2pm to 6pm, Monday to Friday, and from 9am to 7pm on weekends."
            ],
            "it": [
              "Durante l'alta stagione estiva, il negozio è aperto dalle 9.00 alle 19.00 ininterrottamente.\r\nDurante l'alta stagione invernale, il negozio è aperto dalle 8.00 alle 19.00 ininterrottamente.\r\nIn bassa stagione, il negozio è aperto dalle 9.00 alle 12.00 e dalle 14.00 alle 18.00 dal lunedì al venerdì e dalle 9.00 alle 19.00 ininterrottamente nei fine settimana."
            ],
            "fr": [
              "En haute saison d'été, le magasin est ouvert de 9h à 19h en continue.\r\nEn haute saison d'hiver, le magasin est ouvert de 8h à 19h en continue. \r\nEn basse saison le magasin est ouvert de 9h à 12h et de 14h à 18h du lundi au vendredi puis de 9h à 19h en continue le weekend."
            ],
            "nl": [
              "In het hoogseizoen is de winkel non-stop geopend van 9.00 tot 19.00 uur.\r\nIn het hoogseizoen is de winkel non-stop geopend van 8.00 tot 19.00 uur.\r\nIn het laagseizoen is de winkel geopend van 9.00 tot 12.00 uur en van 14.00 tot 18.00 uur van maandag tot vrijdag en van 9.00 tot 19.00 uur doorlopend in het weekend."
            ],
            "es": [
              "En temporada alta de verano, la tienda abre de 9.00 a 19.00 horas ininterrumpidamente.\r\nEn temporada alta de invierno, la tienda abre de 8.00 a 19.00 horas ininterrumpidamente.\r\nEn temporada baja, la tienda abre de 9.00 a 12.00 y de 14.00 a 18.00 horas de lunes a viernes y de 9.00 a 19.00 horas ininterrumpidamente los fines de semana."
            ]
          },
