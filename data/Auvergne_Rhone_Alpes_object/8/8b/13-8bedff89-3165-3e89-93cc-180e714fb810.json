  "rdfs:comment": {
    "de": [
      "Apotheke. Vermietung von medizinischem Material. Tiers payant für alle Krankenkassen.\r\nMontag bis Freitag von 9:00 bis 12:30 Uhr und von 15:00 bis 19:30 Uhr geöffnet.\r\nSamstag von 9 bis 12.30 Uhr"
    ],
    "en": [
