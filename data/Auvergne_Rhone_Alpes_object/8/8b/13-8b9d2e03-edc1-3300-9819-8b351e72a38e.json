  "rdfs:comment": {
    "de": [
      "Dieser Schönheitssalon bietet Ihnen eine Fläche von 400 m², die der Pflege und Entspannung gewidmet ist. Fünf Kosmetikerinnen empfangen Sie von Montag bis Samstag mit und ohne Termin."
    ],
    "en": [
      "This beauty salon offers a ?400m² space dedicated to treatments and relaxation. Five beauticians welcome you from Monday to Saturday, with or without appointment."
    ],
    "it": [
      "Questo salone di bellezza offre uno spazio di 400 m² dedicato ai trattamenti e al relax. Cinque estetiste vi accolgono dal lunedì al sabato, con o senza appuntamento."
    ],
    "fr": [
      "Cet institut de beauté vous propose un espace de ﻿400m² dédié aux soins et à la détente. Cinq esthéticiennes vous accueillent du lundi au samedi, avec et sans rendez vous."
    ],
    "es": [
      "Este salón de belleza le ofrece un espacio de 400 m² dedicado a los tratamientos y la relajación. Cinco esteticistas le dan la bienvenida de lunes a sábado, con o sin cita previa."
    ],
    "nl": [
      "Deze schoonheidssalon biedt je een ruimte van 400 m² gewijd aan behandelingen en ontspanning. Vijf schoonheidsspecialistes verwelkomen je van maandag tot zaterdag, met of zonder afspraak."
    ]
  },
