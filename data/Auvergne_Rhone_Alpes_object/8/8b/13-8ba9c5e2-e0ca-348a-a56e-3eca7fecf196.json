  "rdfs:comment": {
    "de": [
      "Wohlwollender, entspannter und geselliger Empfang mit einer Gasthaus- und Familienküche. Hausgemachte Zubereitungen mit lokalen Produkten und Getränken aus der Region. Möglichkeit von Menüs für Familienfeiern oder Feiern mit Freunden."
    ],
    "en": [
      "A warm, relaxed and friendly welcome, with inn-style, family-style cuisine. Homemade dishes using local produce and beverages. Menus available for family celebrations and gatherings of friends."
    ],
    "it": [
      "Un'accoglienza calorosa, rilassata e amichevole, con una cucina di tipo familiare. Piatti fatti in casa con prodotti locali e bevande della regione. Menù disponibili per feste di famiglia e riunioni tra amici."
    ],
    "fr": [
      "Accueil bienveillant, décontracté et convivial, avec une cuisine d'auberge et familiale. Des préparations maisons, avec des produits locaux et des boissons de la région. Possibilité de menus pour fêtes de famille ou entre amis."
    ],
    "es": [
      "Una acogida cálida, distendida y acogedora, con una cocina de mesón y familiar. Platos caseros con productos locales y bebidas de la región. Menús disponibles para celebraciones familiares y reuniones con amigos."
    ],
    "nl": [
      "Een warm, ontspannen en vriendelijk welkom, met een huiselijke keuken. Huisgemaakte gerechten met lokale producten en dranken uit de regio. Menu's beschikbaar voor familiefeesten en bijeenkomsten met vrienden."
    ]
  },
