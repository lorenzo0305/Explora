  "rdfs:comment": {
    "de": [
      "Schlicht und natürlich gestalteter Speisesaal. Spezialitäten: Geflügelleberkuchen, Knödel, Schnecken, Frittiertes, Frösche auf Bestellung, Gaudrioles (süßes Gebäck aus Gaudemehl)."
    ],
    "en": [
      "Restaurant with simple lines and a natural feel. Specialties: poultry liver cake, quenelles, snails, fried fish, frogs to order, gaudrioles (sweet shortbread made from gaude flour)."
    ],
    "it": [
      "Ristorante dalle linee semplici e dallo spirito naturale. Specialità: torta di fegato di pollame, quenelles, lumache, fritture, rane su ordinazione, gaudrioles (frollini dolci a base di farina di gaude)."
    ],
    "fr": [
      "Salle de restaurant à la ligne simple et à l'esprit naturel. Spécialités: gâteau de foies de volailles, quenelles, escargots, friture, grenouilles sur commande, gaudrioles (sablé sucré à base de farine de gaude)."
    ],
    "es": [
      "Restaurante de líneas sencillas y espíritu natural. Especialidades: pastel de hígado de ave, quenelles, caracoles, frituras, ranas por encargo, gaudrioles."
    ],
    "nl": [
      "Een restaurant met eenvoudige lijnen en een natuurlijke sfeer. Specialiteiten: gevogeltelevertaart, quenelles, slakken, gebakken vis, kikkers op bestelling, gaudrioles (zoet zandkoekje gemaakt van gaudebloem)."
    ]
  },
