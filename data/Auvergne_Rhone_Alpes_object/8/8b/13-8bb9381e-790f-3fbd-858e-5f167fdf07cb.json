  "rdfs:comment": {
    "de": [
      "Das im Haus des Landvogts untergebrachte Museum bietet eine vielfältige Sammlung aus früheren Zeiten. Tauchen Sie in die Welt des Weins von Saint-Pourçain ein, verstehen Sie das Leben des Winzers, seine Arbeit und seine Mentalität im Laufe von 11 Sälen."
    ],
    "en": [
      "Free or guided tour on request. Go into the world of the wine of Saint-Pourçain."
    ],
    "it": [
      "Ospitato nella casa del balivo, il museo offre una varietà di collezioni del passato. Entrate nel mondo del vino di Saint-Pourçain, comprendete la vita del viticoltore, il suo lavoro e la sua mentalità attraverso 11 sale."
    ],
    "fr": [
      "Installé dans la maison du bailli, le musée propose des collections d'antan et variées. Pénétrez dans l'univers du vin de Saint-Pourçain, comprenez la vie du vigneron, son travail et ses mentalités au fil de 11 salles."
    ],
    "nl": [
      "Vrij te bezoeken, rondleiding op aanvraag. Betreed de wereld van de wijn van Saint-Pourçain."
    ],
    "es": [
      "Ubicado en la casa del alguacil, el museo ofrece una variedad de colecciones del pasado. Entre en el mundo del vino de Saint-Pourçain, comprenda la vida del viticultor, su trabajo y su mentalidad a través de 11 salas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum of the Vine and the Country"
    ],
    "fr": [
      "Musée de la Vigne et du Terroir"
    ],
    "nl": [
      "Museum van de wijnen en de wijngebieden"
    ]
  },
