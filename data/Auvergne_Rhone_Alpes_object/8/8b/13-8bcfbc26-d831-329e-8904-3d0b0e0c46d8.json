  "rdfs:comment": {
    "de": [
      "Vermittlung eines kulturellen Erbes der Schulbildung um 1900 in einem für die damalige Zeit typischen Dekor mit den Gerüchen von Papier, Tinte, Holz ..."
    ],
    "en": [
      "In an authentic school house dating back  to the 1880s, discover L’École de Jules Ferry: classroom, canteen, dormitory and antique toys. You will be allowed to write, as pupils did, with ink and a quill"
    ],
    "it": [
      "Trasmissione di un patrimonio culturale dell'istruzione scolastica nel 1900, in un arredamento tipico dell'epoca, con l'odore della carta, dell'inchiostro, del legno..."
    ],
    "fr": [
      "Transmission d'un patrimoine culturel de l'enseignement scolaire en 1900, dans un décor typique de l'époque, aux odeurs de papier, encre, bois ..."
    ],
    "es": [
      "Transmisión de un patrimonio cultural de la educación escolar en 1900, en una decoración típica de la época, con olor a papel, tinta, madera..."
    ],
    "nl": [
      "Overdracht van een cultureel erfgoed van het schoolonderwijs in 1900, in een typisch decor van die tijd, met de geur van papier, inkt, hout ..."
    ]
  },
