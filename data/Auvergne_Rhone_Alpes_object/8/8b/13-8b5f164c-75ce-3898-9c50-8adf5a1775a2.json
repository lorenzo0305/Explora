  "rdfs:comment": {
    "de": [
      "Unser Restaurant im Herzen des Dorfes Besse und Saint-Anastaise empfängt Sie in einer gemütlichen und typisch auvergnatischen Umgebung. Die Küche wird von uns zubereitet."
    ],
    "en": [
      "Our restaurant, located in the heart of the village of Besse and Saint-Anastaise, welcomes you in a warm and typical Auvergnat setting."
    ],
    "it": [
      "Il nostro ristorante, situato nel cuore del villaggio di Besse e Saint-Anastaise, vi accoglie in un ambiente caldo e tipico di Auvergnat. Cucina propria."
    ],
    "fr": [
      "Notre restaurant situé au cœur du village de Besse et Saint-Anastaise, vous accueille dans un cadre chaleureux et typique Auvergnat. Cuisine préparée par nos soins."
    ],
    "nl": [
      "Ons restaurant, gelegen in het hart van het dorp Besse en Saint-Anastaise, verwelkomt je in een warm en typisch Auvergnat kader. Onze eigen keuken."
    ],
