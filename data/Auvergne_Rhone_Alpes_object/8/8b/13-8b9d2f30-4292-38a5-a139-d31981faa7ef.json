  "rdfs:comment": {
    "de": [
      "Panda wok ist ein asiatisches Restaurant, das ein All-you-can-eat-Buffet für Erwachsene und Kinder anbietet. Es ist möglich, die Schalen selbst herzustellen, um die Gerichte mit nach Hause zu nehmen."
    ],
    "en": [
      "Panda wok is an Asian restaurant offering an all-you-can-eat buffet for adults and children. It is possible to make your own trays to take the dishes home."
    ],
    "it": [
      "Il Panda wok è un ristorante asiatico che offre un buffet a volontà per adulti e bambini. È possibile realizzare i propri vassoi da portare a casa."
    ],
    "fr": [
      "Panda wok est un restaurant asiatique proposant un buffet à volonté pour les adultes et les enfants. Il est possible de faire soi-même ses barquettes pour emporter les plats à la maison."
    ],
    "nl": [
      "Panda wok is een Aziatisch restaurant met een all-you-can-eat buffet voor volwassenen en kinderen. Het is mogelijk je eigen bakjes te maken om mee naar huis te nemen."
    ],
    "es": [
      "Panda Wok es un restaurante asiático que ofrece un buffet libre para adultos y niños. Es posible hacer sus propias bandejas para llevar a casa."
    ]
  },
