  "rdfs:comment": {
    "de": [
      "Im Inneren von Marions Atelier erwartet Sie eine Mischung aus Farben und Materialien, Design und Illustrationen, ausgefeilten Mustern und einer Vielfalt an Techniken. \r\nHändler : Marion Clément.\r\nDesigner : Rugiada Petrelli."
    ],
    "en": [
      "Marion’s workshop combines materials and colours, design and illustrations, motifs and a diversity of techniques.\r\nBusinesses : Marion Clément.\r\nDesigner : Rugiada Petrelli."
    ],
    "it": [
      "Nello studio di Marion si combinano materiali e colori, design e illustrazioni, il pensiero del motivo e la diversità delle tecniche."
    ],
    "fr": [
      "Au sein de l'atelier de Marion se mêlent matières et couleurs, design et illustrations, pensée du motif et diversité des techniques."
    ],
    "nl": [
      "In het atelier van Marion worden materialen en kleuren, ontwerp en illustraties, de gedachte van het motief en de diversiteit van technieken gecombineerd."
    ],
    "es": [
      "En el estudio de Marion se combinan los materiales y los colores, el diseño y las ilustraciones, el pensamiento del motivo y la diversidad de técnicas."
    ]
  },
  "rdfs:label": {
