  "rdfs:comment": {
    "de": [
      "LAPLAINE, ein Haus mit Know-how, das sich auf Straußenleder spezialisiert hat, setzt die Kreativität frei, indem es dieses seltene und zutiefst ausdrucksstarke Material wieder zum Leben erweckt. Aufgewertet von der Familienfarm, wird es zum einzigen kostbaren Leder, das 100% rückverfolgbar und französisch ist."
    ],
    "en": [
      "LAPLAINE, a house of expertise in ostrich leather, unleashes creativity by breathing new life into this rare and profoundly expressive material. Revalorized from the family farm, it becomes the only 100% traceable and French precious leather."
    ],
    "it": [
      "LAPLAINE, esperto di pelle di struzzo, libera la creatività dando nuova vita a questo materiale raro e profondamente espressivo. Rivalorizzata dalla fattoria di famiglia, diventa l'unica pelle preziosa al 100% tracciabile e francese."
    ],
    "fr": [
      "LAPLAINE, maison de savoir-faire experte dans le cuir d’autruche, libère la créativité en redonnant vie à cette matière rare et profondément expressive. Revalorisé de l'exploitation familiale, il devient le seul cuir précieux 100% traçable et français."
    ],
    "es": [
      "LAPLAINE, experto en piel de avestruz, da rienda suelta a la creatividad insuflando nueva vida a este material raro y profundamente expresivo. Revalorizada desde la granja familiar, se convierte en la única piel preciosa 100% trazable y francesa."
    ],
    "nl": [
      "LAPLAINE, expert in struisvogelleer, laat creativiteit de vrije loop door dit zeldzame en zeer expressieve materiaal nieuw leven in te blazen. Het wordt gerevaloriseerd van de familieboerderij en wordt het enige kostbare leer dat 100% traceerbaar en Frans is."
    ]
  },
  "rdfs:label": {
