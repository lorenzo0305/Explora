  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes begrüßen wir Sie im Restaurant Le Nouveau Siècle in einer familiären und herzlichen Atmosphäre. Eine großzügige Küche, deren Aromen mit den Produkten der Saison bearbeitet werden. Monatlicher Menüwechsel."
    ],
    "en": [
      "In the heart of the village, we welcome you to the restaurant Le Nouveau Siècle in a warm and family atmosphere. A generous cuisine, flavors worked according to the products of season. Change of menus every month."
    ],
    "it": [
      "Nel cuore del villaggio, vi diamo il benvenuto al ristorante Le Nouveau Siècle in una calda atmosfera familiare. Una cucina generosa, sapori lavorati in base ai prodotti di stagione. Il menu cambia ogni mese."
    ],
    "fr": [
      "En plein cœur du village, nous vous accueillons au sein du restaurant Le Nouveau Siècle dans une ambiance familiale et chaleureuse. Une cuisine généreuse, des saveurs travaillées en fonction des produits de saison. Changement de menus tous les mois."
    ],
    "nl": [
      "In het hart van het dorp verwelkomen wij u in het restaurant Le Nouveau Siècle in een warme familiesfeer. Een gulle keuken, smaken bewerkt volgens de producten van het seizoen. Het menu verandert elke maand."
    ],
    "es": [
      "En el corazón del pueblo, le damos la bienvenida al restaurante Le Nouveau Siècle en un cálido ambiente familiar. Una cocina generosa, sabores trabajados según los productos de temporada. El menú cambia cada mes."
    ]
  },
