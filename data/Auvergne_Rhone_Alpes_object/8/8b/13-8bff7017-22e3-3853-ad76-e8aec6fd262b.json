  "rdfs:comment": {
    "de": [
      "Erkunden Sie die Sioule mit dem Quad! Geheime Wege, bemalte Kirchen und einzigartige Landschaften. Geführte Wanderungen, Neuheit 2025 Quad Horse-Optionen. Besitzer von Quads, private Begleitung möglich. Abenteuer und Entdeckungen garantiert!"
    ],
    "en": [
      "Explore the Sioule on a quad! Secret paths, painted churches and unique landscapes. Guided tours, new 2025 quad horse options. Quad owners, private accompaniment available. Adventure and discovery guaranteed!"
    ],
    "it": [
      "Esplorate la Sioule in quad! Sentieri segreti, chiese dipinte e paesaggi unici. Visite guidate, nuove opzioni per i quad nel 2025. Proprietari di quad, accompagnatori privati disponibili. Avventura e scoperta garantite!"
    ],
    "fr": [
      "Explorez la Sioule en quad ! Chemins secrets, églises peintes et paysages uniques. Randonnées guidées, nouveauté 2025 options quad horse. Propriétaires de quads, accompagnement privé possible. Aventure et découverte garanties !"
    ],
    "es": [
      "¡Explore la Sioule en quad! Senderos secretos, iglesias pintadas y paisajes únicos. Visitas guiadas, nuevo en 2025 opciones quad caballo. Propietarios de quads, acompañantes privados disponibles. ¡Aventura y descubrimiento garantizados!"
    ],
    "nl": [
      "Verken de Sioule op een quad! Geheime paden, beschilderde kerken en unieke landschappen. Begeleide tochten, nieuw in 2025 quad paard opties. Quad eigenaren, privé begeleiding beschikbaar. Avontuur en ontdekking gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Quad Aventure"
    ]
  },
