  "rdfs:comment": {
    "de": [
      "Imker und Produzent von Gelée Royale, Familienbetrieb. Probieren Sie unseren Honig und die Produkte aus dem Bienenstock. Lavendelhonig, Garrigue-Honig usw. Auf den Märkten: freitags in Sablet und sonntags (von Mai bis September) in Nyons."
    ],
    "en": [
      "Beekeeper producer, family farm, come and taste our honey and products derived from the hive. Honey lavender, honey garrigue, etc ...\r\nOn the markets: Wednesday in Malaucène, Friday in Sablet and Sunday (from May to September) in Nyons."
    ],
    "it": [
      "Apicoltore e produttore di pappa reale, azienda a conduzione familiare, venite a degustare i nostri mieli e i prodotti derivati dall'alveare. Sui mercati: venerdì a Sablet e domenica (da maggio a settembre) a Nyons."
    ],
    "fr": [
      "Apiculteur et producteur de Gelée Royale, exploitation familiale, venez déguster nos miels et produits dérivés de la ruche. Miel de lavande, garrigue, etc..Sur les marchés :  Vendredi à Sablet et Dimanche (de Mai à Septembre) à Nyons."
    ],
    "nl": [
      "Honing, pollen, propolis, honingsnoepjes, kruidenkoek, etc.\r\nAan bijenkast verwante producten."
    ],
    "es": [
      "Apicultor y productor de jalea real, empresa familiar, venga a degustar nuestras mieles y productos derivados de la colmena. En los mercados: viernes en Sablet y domingo (de mayo a septiembre) en Nyons."
    ]
  },
