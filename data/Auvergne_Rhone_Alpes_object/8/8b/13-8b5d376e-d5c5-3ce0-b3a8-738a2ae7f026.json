  "rdfs:comment": {
    "de": [
      "Schnitzeljagd auf dem Handy. Laden Sie die GayaPlayer-App aus dem App Store und von Google Play herunter, um zu spielen. Ihr Erkundungsgebiet erstreckt sich vom Park des Schwimmbads über die Anhöhen des Dorfes bis zu den Thermen von Chaudes-Aigues. Dauer ca. 1 Stunde"
    ],
    "en": [
      "Mobile scavenger hunt. Download the GayaPlayer application on App store and Google Play to play. Your exploration zone stretches from the Parc de la piscine to the Chaudes-Aigues thermal baths, passing through the heights of the village. Duration approx. 1 hour"
    ],
    "it": [
      "Caccia al tesoro mobile. Scaricate l'applicazione GayaPlayer dall'App store e da Google Play per giocare. La zona di esplorazione si estende dal parco delle piscine alle terme di Chaudes-Aigues, passando per le alture del villaggio. Durata circa 1 ora"
    ],
    "fr": [
      "Jeu de piste sur mobile. Téléchargez l'application GayaPlayer sur App store et Google Play pour jouer. Votre zone d’exploration s’étend du parc de la piscine aux thermes de Chaudes-Aigues, passant par les hauteurs du village. Durée 1h environ"
    ],
    "nl": [
      "Mobiele speurtocht. Download de applicatie GayaPlayer in de App Store en Google Play om te spelen. Je verkenningszone strekt zich uit van het zwembadpark tot de thermen van Chaudes-Aigues, langs de hoogten van het dorp. Duur ongeveer 1 uur"
    ],
    "es": [
      "Búsqueda del tesoro móvil. Descárgate la aplicación GayaPlayer en App store y Google Play para jugar. Su zona de exploración se extiende desde el parque de la piscina hasta las termas de Chaudes-Aigues, pasando por las alturas del pueblo. Duración aprox. 1 hora"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Therma : le monde de Géothermia"
    ]
  },
