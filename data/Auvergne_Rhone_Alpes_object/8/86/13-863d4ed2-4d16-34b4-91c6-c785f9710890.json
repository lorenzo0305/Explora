  "rdfs:comment": {
    "de": [
      "Cowork In Voiron ist eine Gemeinschaft aus sündigen Unternehmern, Angestellten mit Telearbeit, kreativen Freiberuflern und einfallsreichen Unternehmensgründern. 265 m² geteilte Arbeitsräume, vom Openspace bis zum privaten Büro, für das Glück eines jeden!"
    ],
    "en": [
      "Cowork In Voiron is a community of hard-working entrepreneurs, telecommuting employees, creative freelancers and imaginative entrepreneurs. 265 m² of shared workspaces, from openspace to private offices, for everyone to enjoy!"
    ],
    "it": [
      "Cowork In Voiron è una comunità di imprenditori che lavorano sodo, dipendenti che telelavorano, freelance creativi e imprenditori fantasiosi. 265 m² di spazio di lavoro condiviso, dall'openspace agli uffici privati, a disposizione di tutti!"
    ],
    "fr": [
      "Cowork In Voiron c'est une communauté d'entrepreneurs pêchus, de salariés en télétravail, de freelances créatifs et de créateurs d'entreprise imaginatifs. 265 m² d'espaces de travail partagés, de l'openspace au bureau privatif, pour le bonheur de chacun !"
    ],
    "nl": [
      "Cowork In Voiron is een gemeenschap van hardwerkende ondernemers, telewerkende werknemers, creatieve freelancers en vindingrijke ondernemers. 265 m² gedeelde werkruimte, van open space tot privékantoren, voor iedereen om van te genieten!"
    ],
    "es": [
      "Cowork In Voiron es una comunidad de empresarios trabajadores, empleados que teletrabajan, autónomos creativos y emprendedores imaginativos. 265 m² de espacios de trabajo compartidos, desde espacios abiertos a despachos privados, ¡para disfrute de todos!"
    ]
  },
