      "dc:description": {
        "de": [
          "Konzertabend im Rahmen der Rallye der 7 Täler des Artois.\nTreffpunkt: Saal Françis Sagot in Fruges\nMahlzeit (Vorspeise - Hauptgericht - Dessert)\nAuf Reservierung"
        ],
        "en": [
          "Concert evening as part of the 7 Vallées d'Artois rally.\nMeet at Salle Françis Sagot, Fruges\nMeal (Starter - Main course - Dessert)\nOn reservation"
        ],
        "it": [
          "Serata di concerti nell'ambito del raduno 7 Vallées d'Artois.\nRitrovo presso la Salle Françis Sagot a Fruges\nPasto (antipasto - piatto principale - dessert)\nSu prenotazione"
        ],
        "fr": [
          "Soirée concert dans le cadre du rallye des 7 Vallées d'Artois.\nRendez-vous salle Françis Sagot à Fruges\nRepas (Entrée - Plat - Dessert)\nSur réservation"
        ],
        "es": [
          "Noche de concierto en el marco del rally 7 Vallées d'Artois.\nEncuentro en la Salle Françis Sagot de Fruges\nComida (entrante - plato principal - postre)\nPrevia reserva"
        ],
        "nl": [
          "Concertavond in het kader van de 7 Vallées d'Artois rally.\nVerzamelen in de Salle Françis Sagot in Fruges\nMaaltijd (Voorgerecht - Hoofdgerecht - Dessert)\nOp reservering"
        ]
      },
