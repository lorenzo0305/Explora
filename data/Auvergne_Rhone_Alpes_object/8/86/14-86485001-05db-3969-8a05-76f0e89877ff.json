      "dc:description": {
        "de": [
          "In Le Touquet in der Rue Saint-Jean schlossen zwei IKKS-Boutiquen (Herren und Junior) ihre Türen. Die Filiale für Frauen ist noch geöffnet."
        ],
        "en": [
          "In Rue Saint-Jean, Le Touquet, two IKKS stores (for men and juniors) have closed. The women?s store is still open."
        ],
        "it": [
          "Due negozi IKKS (uomo e junior) hanno chiuso in Rue Saint-Jean a Le Touquet. Il negozio femminile è ancora aperto."
        ],
        "fr": [
          "Au Touquet dans la rue Saint-Jean deux boutiques IKKS (Homme et junior) ont fermé leurs portes. L’enseigne pour les femmes est encore ouverte."
        ],
        "nl": [
          "Twee IKKS winkels (voor mannen en junioren) zijn gesloten in de Rue Saint-Jean in Le Touquet. De dameswinkel is nog open."
        ],
        "es": [
          "En la calle Saint-Jean de Le Touquet han cerrado dos tiendas IKKS (para hombre y junior). La tienda femenina sigue abierta."
        ]
      },
