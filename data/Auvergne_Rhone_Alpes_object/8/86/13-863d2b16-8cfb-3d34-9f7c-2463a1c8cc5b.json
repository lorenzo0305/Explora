  "rdfs:comment": {
    "de": [
      "Unser Seminarraum im Hotel Le Christel? Cit?Hôtel in Le Puy-en-Velay bietet einen modulierbaren, hellen und ausgestatteten Raum für Ihre Meetings, Schulungen oder Geschäftsveranstaltungen. Er ist ideal im Herzen der Stadt gelegen und profitiert von einem einfachen Zugang, einer guten Anbindung an die öffentliche Verkehrsmittel"
    ],
    "en": [
      "Our seminar room at the Hôtel Le Christel ? Cit?Hôtel in Le Puy-en-Velay offers a modular, bright and fully-equipped space for your meetings, training sessions or professional events. Ideally located in the heart of the city, it benefits from easy access, a wide range of facilities and a wide range of services"
    ],
    "it": [
      "La nostra sala seminari dell'Hôtel Le Christel? Cit?Hôtel di Le Puy-en-Velay offre uno spazio modulare, luminoso e completamente attrezzato per le vostre riunioni, corsi di formazione o eventi aziendali. Situata in posizione ideale nel cuore della città, gode di un facile accesso, di un'ampia gamma di servizi e di un'ottima posizione"
    ],
    "fr": [
      "Notre salle de séminaire à l’Hôtel Le Christel – Cit’Hôtel au Puy-en-Velay offre un espace modulable, lumineux et équipé pour vos réunions, formations ou événements professionnels. Idéalement située au cœur de la ville, elle bénéficie d’un accès facile, d"
    ],
    "nl": [
      "Onze seminarruimte in Hôtel Le Christel? Cit?Hôtel in Le Puy-en-Velay biedt een modulaire, lichte en volledig uitgeruste ruimte voor uw vergaderingen, trainingen of zakelijke evenementen. Ideaal gelegen in het hart van de stad, profiteert het van een goede bereikbaarheid, een breed scala aan faciliteiten en een uitstekende locatie"
    ],
    "es": [
      "Nuestra sala de seminarios del Hôtel Le Christel? Citôtel de Le Puy-en-Velay le ofrece un espacio modulable, luminoso y totalmente equipado para sus reuniones, cursos de formación o eventos de negocios. Idealmente situado en el corazón de la ciudad, se beneficia de un fácil acceso, una amplia gama de instalaciones y una excelente ubicación"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Chris'tel - salle de séminaire"
    ]
  },
