  "rdfs:comment": {
    "de": [
      "Monsieur P lädt seine Gäste in sein bürgerliches Haus ein. Hier können Sie die authentische Küche seines Chefkochs Florent Poulard genießen, der jeden Tag außergewöhnliche Produkte veredelt!"
    ],
    "en": [
      "Chef Florent Poulard serves up authentic and innovative cuisine. Taking pride of place, the vegetables are sourced from local producers. The meat and fish are frequently cooked whole."
    ],
    "it": [
      "Monsieur P invita gli ospiti nella sua casa borghese. Potranno gustare l'autentica cucina del suo chef privato, Florent Poulard, che ogni giorno tira fuori il meglio da prodotti eccezionali!"
    ],
    "fr": [
      "Monsieur P invite ses convives à franchir la porte de sa maison bourgeoise. Ces derniers pourront y déguster la cuisine authentique de son chef particulier, Florent Poulard, qui sublime chaque jour des produits d’exception !"
    ],
    "nl": [
      "Monsieur P nodigt zijn gasten uit in zijn burgerlijke woning. Ze kunnen genieten van de authentieke keuken van zijn privékok, Florent Poulard, die elke dag het beste uit uitzonderlijke producten haalt!"
    ],
    "es": [
      "Monsieur P invita a sus huéspedes a su casa burguesa. Allí podrán disfrutar de la auténtica cocina de su chef privado, Florent Poulard, que cada día saca lo mejor de unos productos excepcionales"
    ]
  },
