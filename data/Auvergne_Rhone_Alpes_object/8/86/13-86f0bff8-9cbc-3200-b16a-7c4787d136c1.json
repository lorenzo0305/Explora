  "rdfs:comment": {
    "de": [
      "Unser 5-Sterne-Hotel liegt gegenüber dem Mont-Blanc und empfängt Sie das ganze Jahr über im Herzen von Chamonix. In diesem legendären Hotel mischt sich der typische Architekturstil des Chamonix-Tals mit einem zeitgenössischen und raffinierten Hauch der Berge."
    ],
    "en": [
      "Facing Mont Blanc, our 5-star hotel welcomes you all year round to the heart of Chamonix. In this legendary hotel, the architectural style typical of the Chamonix valley blends with a contemporary, refined mountain touch."
    ],
    "it": [
      "Di fronte al Monte Bianco, il nostro hotel 5 stelle vi accoglie tutto l'anno nel cuore di Chamonix. In questo leggendario hotel, lo stile architettonico tipico della valle di Chamonix si fonde con un tocco contemporaneo e raffinato di montagna."
    ],
    "fr": [
      "Situé face au Mont-Blanc, notre hôtel 5 étoiles vous accueille tout au long de l'année au cœur de Chamonix. Dans cet hôtel mythique, le style architectural typique de la vallée de Chamonix se mêle à une touche contemporaine et raffinée de montagne."
    ],
    "nl": [
      "Met uitzicht op de Mont Blanc verwelkomt ons 5-sterrenhotel je het hele jaar door in het hart van Chamonix. In dit legendarische hotel combineert de typische architectuurstijl van de vallei van Chamonix met een eigentijdse en verfijnde bergtouch."
    ],
    "es": [
      "Frente al Mont Blanc, nuestro hotel de 5 estrellas le da la bienvenida todo el año al corazón de Chamonix. En este legendario hotel, el estilo arquitectónico típico del valle de Chamonix se mezcla con un toque contemporáneo y refinado de montaña."
    ]
  },
