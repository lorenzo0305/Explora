  "rdfs:comment": {
    "de": [
      "Laurent Fritsch leitet mit seiner Frau Mylène dieses Familienhotel mit 14 Zimmern, die geschmackvoll eingerichtet, gemütlich und alle unterschiedlich sind."
    ],
    "en": [
      "In the lovely Jordanne Valley, the Hotel-Restaurant “Les Tilleuls”, a centenarian family home, warmly welcomes you for a relaxation stay, nature and gastronomy."
    ],
    "it": [
      "Laurent Fritsch e sua moglie Mylène gestiscono questo hotel a conduzione familiare con 14 camere arredate con gusto, piacevoli e diverse."
    ],
    "fr": [
      "Laurent Fritsch dirige avec son épouse Mylène, cet hôtel familial de 14 chambres, décorées avec goût, agréables, et toutes différentes."
    ],
    "es": [
      "Situado en el encantador valle del Jordanne, el Hotel-Restaurante \"Les Tilleuls\" (Los Tilos), casa familiar centenaria, te da una cálida bienvenida para una estancia de relajación acompañada por la naturaleza y la gastronomía."
    ],
    "nl": [
      "Laurent Fritsch en zijn vrouw Mylène runnen dit familiehotel met 14 smaakvol ingerichte, aangename en verschillende kamers."
    ]
  },
