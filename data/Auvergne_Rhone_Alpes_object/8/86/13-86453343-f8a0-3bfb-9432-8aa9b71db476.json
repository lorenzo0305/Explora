  "rdfs:comment": {
    "de": [
      "Nach der Ankunft des Super-Chatel-Lifts folgen Sie dem Fußgängerweg in Richtung Lac de Conche. Der erste Teil der Route verläuft auf dem Fußgängerweg bis zur Kreuzung mit dem Skilift Chalet Neuf."
    ],
    "en": [
      "From the arrival point of the Super-Châtel gondola lift, follow the footpath towards Lac de Conche. The first part of the route is on the footpath as far as the Chalet Neuf ski lift junction."
    ],
    "it": [
      "Dalla funivia di Super Châtel, seguire il sentiero in direzione del Lac de Conche. La prima parte del percorso si svolge sul sentiero fino all'incrocio degli impianti di risalita dello Chalet Neuf."
    ],
    "fr": [
      "A l’arrivée de la télécabine de Super Châtel, suivez le sentier piéton en direction du lac de Conche. La première partie de l’itinéraire se fait sur le sentier piéton jusqu’au croisement du téléski de Chalet Neuf."
    ],
    "nl": [
      "Vanaf de aankomst van de Super-Châtel gondellift volgt u het voetpad in de richting van Lac de Conche. Het eerste deel van de route gaat over het voetpad tot aan de splitsing van de skilift Chalet Neuf."
    ],
    "es": [
      "Desde el teleférico de Super Châtel, siga el sendero hacia Lac de Conche. La primera parte del recorrido se realiza por el sendero hasta el cruce del remonte de Chalet Neuf."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski touring trail La Franco-Suisse"
    ],
    "fr": [
      "Itinéraire de ski de randonnée La Franco-Suisse"
    ],
    "nl": [
      "Toerskiroute  La Franco-Suisse"
    ]
  },
