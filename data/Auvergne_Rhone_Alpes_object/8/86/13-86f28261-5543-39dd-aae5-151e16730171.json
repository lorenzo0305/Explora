  "rdfs:comment": {
    "de": [
      "Kommen Sie und lesen Sie Ihre Lieblingsgedichte oder Ihre eigenen Gedichte, oder hören Sie einfach nur zu und unterhalten Sie sich, trinken Sie etwas und knabbern Sie selbstgemachte Kleinigkeiten."
    ],
    "en": [
      "Come and read your favorite poems or your own, or just listen and chat, have a drink and nibble on homemade goodies."
    ],
    "it": [
      "Venite a leggere le vostre poesie preferite o le vostre, o semplicemente ad ascoltare e a chiacchierare, a bere qualcosa e a sgranocchiare prodotti fatti in casa."
    ],
    "fr": [
      "Venez lire vos poèmes préférés ou les vôtres, ou tout simplement écouter et discuter, boire un verre et grignoter des petites choses faites maison."
    ],
    "es": [
      "Venga a leer sus poemas favoritos o los suyos propios, o simplemente a escuchar y charlar, tomar algo y picar algo casero."
    ],
    "nl": [
      "Kom en lees je favoriete gedichten of je eigen gedichten, of luister en praat gewoon, neem een drankje en knabbel van zelfgemaakt lekkers."
    ]
  },
  "rdfs:label": {
