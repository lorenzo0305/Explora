  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d29508ff-3e8f-3ab7-849b-42993842372f",
      "dc:description": {
        "de": [
          "Etang de Crecques: 4 Hektar: Weißfische Raubfisch; Nachtangeln auf Karpfen.\nLac de la sauvagine in Mametz: 10 Hektar: Raubfisch und Weißfische"
        ],
        "en": [
          "Etang de Crecques: 4 hectares: whitefish and carnivorous fish; night fishing for carp.\nLac de la sauvagine at Mametz: 10 hectares: carnivorous fish and white fish"
        ],
        "it": [
          "Etang de Crecques: 4 ettari: pesci bianchi e carnivori; pesca notturna alla carpa.\nLac de la Sauvagine a Mametz: 10 ettari: pesci carnivori e pesci bianchi"
        ],
        "fr": [
          "Etang de Crecques : 4 hectares : poissons blancs carnassier ; pêche de nuit à la carpe.\nLac de la sauvagine à Mametz : 10 hectares : carnassier et poissons blancs"
        ],
        "nl": [
          "Etang de Crecques: 4 hectare: witvis en vleesetende vis; nachtvissen op karper.\nLac de la Sauvagine bij Mametz: 10 hectare: vleesetende vis en witvis"
        ],
        "es": [
          "Etang de Crecques: 4 hectáreas: peces blancos y carnívoros; pesca nocturna de carpas.\nLac de la Sauvagine en Mametz: 10 hectáreas: peces carnívoros y peces blancos"
        ]
      },
