  "rdfs:comment": {
    "de": [
      "4 Sterne Boutique-Hotel am Ufer in einer atemberaubenden Natur. Intime und gemütliche Atmosphäre in einem sehr schönen Hotel mit 14 Zimmern, Spa, Sauna, Strand und Anlegesteg."
    ],
    "en": [
      "Waterfront 4* boutique hotel in a breathtaking setting. Intimate and cosy atmosphere in this modern gem with 14 rooms. Spa, sauna, private beach and jetty."
    ],
    "it": [
      "Boutique hotel 4 stelle vicino al lago, in una cornice mozzafiato. Atmosfera intima e ideale per questo gioiello contemporaneo di 14 camere. Spa, sauna, spiaggia e moli privati."
    ],
    "fr": [
      "Hôtel 4 étoiles situé les pieds dans l'eau et dans un environnement naturel époustouflant. Espace bien-être, bain nordique, sauna, plage et ponton privés."
    ],
    "es": [
      "Hotel de 4 estrellas situado a orillas del agua en un entorno natural impresionante. Zona de bienestar, baño nórdico, sauna, playa privada y pontón."
    ],
    "nl": [
      "Boetiek en 4-sterren hotel aan de waterkant, in een adembenemend kader. Dit moderne juweeltje met 14 kamers biedt een intieme, knusse sfeer . SPA, sauna, privé- strand en pontonbruggen."
    ]
  },
