  "rdfs:comment": {
    "de": [
      "Die 1995 gegründete SAS Foucaud Laveix ist eine Getreidefarm, die Honig und Bienenprodukte mit nicht weniger als 80 Bienenstöcken in drei Bienenhäusern produziert: Verdiaux, Trois Roys und Street Art City."
    ],
    "en": [
      "SAS Foucaud Laveix, created in 1995, is a cereal farm that produces honey and beehive products with no fewer than 80 hives in 3 apiaries: Verdiaux, Trois Roys and Street Art City."
    ],
    "it": [
      "SAS Foucaud Laveix, fondata nel 1995, è un'azienda cerealicola che produce miele e prodotti dell'alveare con ben 80 arnie in 3 apiari: Verdiaux, Trois Roys e Street Art City."
    ],
    "fr": [
      "La SAS Foucaud Laveix, créée en 1995, est une ferme céréalière qui produit du miel et des produits de la ruche avec pas moins de 80 ruches sur 3 ruchers : Verdiaux, Trois Roys et Street Art City."
    ],
    "nl": [
      "SAS Foucaud Laveix, opgericht in 1995, is een graanboerderij die honing en bijenkorfproducten produceert met niet minder dan 80 bijenkasten in 3 bijenstallen: Verdiaux, Trois Roys en Street Art City."
    ],
    "es": [
      "La SAS Foucaud Laveix, fundada en 1995, es una explotación cerealista que produce miel y productos de la colmena con no menos de 80 colmenas repartidas en 3 colmenares: Verdiaux, Trois Roys y Street Art City."
    ]
  },
  "rdfs:label": {
