  "rdfs:comment": {
    "de": [
      "Hotel *** Restaurant in einem Dorf in der Ardèche, im Herzen des Weinbaugebiets St-Joseph im Rhône-Tal und 70 km südlich von Lyon gelegen.\r\nRestaurant - Überdachte Terrasse - Schwimmbad - Park mit Bäumen - Bouleplatz - Bar - KOSTENLOSER Parkplatz - Stromsäule."
    ],
    "en": [
      "La Désirade is an approved \"hôtel de charme\" in St. Désirat, a small Ardèche village in the heart of the Saint Joseph vineyard in the Rhône Valley, 70km south of Lyon."
    ],
    "it": [
      "Hotel *** Ristorante situato in un villaggio dell'Ardèche nel cuore dei vigneti di St-Joseph nella Valle del Rodano, a 70 km a sud di Lione.\r\nRistorante - Terrazza coperta - Piscina - Parco alberato - Petanque - Bar - Parcheggio gratuito - Punto di aggancio elettrico."
    ],
    "fr": [
      "Hôtel *** Restaurant situé dans un village ardéchois au coeur du vignoble St-Joseph dans la vallée du Rhône et à 70 km au Sud de Lyon.\r\nRestaurant - Terrasse couverte - Piscine - Parc arboré - Terrain de pétanque - Bar - Parking GRATUIT - borne électrique."
    ],
    "es": [
      "Hotel *** Restaurante situado en un pueblo de Ardèche, en el corazón de los viñedos de St-Joseph, en el valle del Ródano, a 70 km al sur de Lyon.\r\nRestaurante - Terraza cubierta - Piscina - Parque arbolado - Zona de petanca - Bar - Aparcamiento GRATUITO - Punto de conexión eléctrica."
    ],
    "nl": [
      "Hotel *** Restaurant gelegen in een dorpje in de Ardèche in het hart van de St-Joseph wijngaarden in de Rhône vallei, 70 km ten zuiden van Lyon.\r\nRestaurant - Overdekt terras - Zwembad - Bosrijk park - Petanqueterrein - Bar - GRATIS parkeren - elektrische aansluiting."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Désirade Hotel"
    ],
    "fr": [
      "Hôtel Restaurant la Désirade"
    ]
  },
