  "rdfs:comment": {
    "de": [
      "Der offizielle Shop des US Oyonnax Rugby. Fan-Linie mit Trikots, Shorts, Schals, Plaids, und eine Prêt-à-porter-Linie für Männer, Frauen, Kinder und Babys mit T-Shirts, Polos, Hemden... Und zahlreiche Accessoires (Bälle, Tassen, Schlüsselanhänger...)"
    ],
    "en": [
      "The official US Oyonnax Rugby store. Fan line with jerseys, shorts, scarves, plaids, and a ready-to-wear line for men, women, children and babies with T-shirts, polo shirts, shirts... And a wide range of accessories (balls, mugs, key-rings, etc.)"
    ],
    "it": [
      "Il negozio ufficiale dell'US Oyonnax Rugby. Linea per i tifosi con magliette, pantaloncini, sciarpe, plaid, e una linea di prêt-à-porter per uomo, donna, bambino e neonato con magliette, polo, camicie... E una vasta gamma di accessori (palloni, tazze, portachiavi, ecc.)"
    ],
    "fr": [
      "La boutique Officielle de l'US Oyonnax Rugby. Ligne supporter avec les maillots, shorts, écharpes, plaids, et une ligne prêt à porter homme, femme, enfant et bébé avec T-shirts, polos, chemises... Et de nombreux accessoires (ballons, tasses, porte-clés..)"
    ],
    "es": [
      "La tienda oficial del Oyonnax Rugby de Estados Unidos. Línea para aficionados con camisetas, pantalones cortos, bufandas, cuadros escoceses, y una línea de prêt-à-porter para hombres, mujeres, niños y bebés con camisetas, polos, camisas... Y una amplia gama de accesorios (balones, tazas, llaveros, etc.)"
    ],
    "nl": [
      "De officiële winkel van US Oyonnax Rugby. Supporterslijn met shirts, shorts, sjaals, plaids, en een confectielijn voor mannen, vrouwen, kinderen en baby's met T-shirts, poloshirts, overhemden... En een breed assortiment accessoires (ballen, mokken, sleutelhangers, enz.)"
    ]
  },
  "rdfs:label": {
