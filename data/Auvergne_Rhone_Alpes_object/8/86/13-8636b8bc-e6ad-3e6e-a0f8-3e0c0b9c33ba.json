  "rdfs:comment": {
    "de": [
      "Ein komplettes Workout im Halbdunkel in Symbiose mit der Musik, um den Körper in der Tiefe zu trainieren. Genießen Sie in Annecy 50 Minuten zum Atmen, Schwitzen, Kräftigen und Aufladen - und das alles ohne Auswirkungen auf die Gelenke."
    ],
    "en": [
      "A complete workout in the half-light, in symbiosis with the music, to work the body in depth. In Annecy, enjoy 50 minutes of breathing, sweating, toning and recharging, all without impacting joints."
    ],
    "it": [
      "Un allenamento completo al buio, in armonia con la musica, per dare al vostro corpo un allenamento completo. Ad Annecy, approfittate di 50 minuti per respirare, sudare, tonificarvi e ricaricarvi, il tutto senza impattare sulle articolazioni."
    ],
    "fr": [
      "Un workout complet dans la pénombre en symbiose avec la musique pour travailler le corps en profondeur. À Annecy, profitez de 50 minutes pour respirer, transpirer, se tonifier et recharger, le tout sans impact sur les articulations."
    ],
    "es": [
      "Un entrenamiento completo en la oscuridad, en armonía con la música, para que su cuerpo se ejercite a fondo. En Annecy, aproveche 50 minutos para respirar, sudar, tonificarse y recargarse, todo ello sin impacto en sus articulaciones."
    ],
    "nl": [
      "Een complete workout in het donker, in harmonie met de muziek, om je lichaam een grondige training te geven. Profiteer in Annecy van 50 minuten om te ademen, te zweten, te trainen en op te laden, en dat alles zonder je gewrichten te belasten."
    ]
  },
