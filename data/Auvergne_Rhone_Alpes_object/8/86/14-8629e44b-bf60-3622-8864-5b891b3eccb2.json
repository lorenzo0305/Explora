  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/94fc694a-7ff4-32e7-a2a3-6dac609750b6",
      "dc:description": {
        "de": [
          "Elena Nagapetyan\nÖffnung der Türen: 19.00 Uhr\n\"Meine größte Angst im Leben ist es, etwas zu bereuen und einer Kakerlake über den Weg zu laufen.\""
        ],
        "en": [
          "Elena Nagapetyan\nDoors open: 7pm\n\"My greatest fear in life is having regrets and running into a cockroach.\""
        ],
        "it": [
          "Elena Nagapetyan\nApertura porte: 19:00\n\"La mia più grande paura nella vita è avere rimpianti e incontrare uno scarafaggio"
        ],
        "fr": [
          "Elena Nagapetyan \nOuverture des portes : 19h00\n\"Ma plus grande peur dans la vie, c’est d’avoir des regrets et de croiser un cafard.\""
        ],
        "nl": [
          "Elena Nagapetyan\nDeuren open: 19:00\n\"Mijn grootste angst in het leven is spijt hebben en een kakkerlak tegenkomen"
        ],
        "es": [
          "Elena Nagapetyan\nApertura de puertas: 19:00\n\"Mi mayor miedo en la vida es arrepentirme y encontrarme con una cucaracha"
        ]
      },
