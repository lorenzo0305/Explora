  "rdfs:comment": {
    "de": [
      "19.30 Uhr Ein musikalischer Augenblick im Auditorium: Unsere jungen Musiker kommen auf die Bühne, um ihre Leidenschaft zu teilen! Ein 40-minütiger, bewegender Moment, in dem die Schülerinnen und Schüler der Musikschule ihre Talente offenbaren. Freier Eintritt."
    ],
    "en": [
      "7.30pm Un Instant Musical in the auditorium: our young musicians take to the stage to share their passion! A moving 40-minute performance in which music school students reveal their talents. Free admission."
    ],
    "it": [
      "19.30 Un Instant Musical in auditorium: i nostri giovani musicisti salgono sul palco per condividere la loro passione! Un emozionante spettacolo di 40 minuti in cui gli studenti della scuola di musica rivelano il loro talento. Ingresso libero."
    ],
    "fr": [
      "19h30 Un Instant Musical à l'auditorium  : nos jeunes musiciens montent sur scène pour partager leur passion ! Un moment émouvant de 40 minutes où les élèves de l'école de musique révèlent leurs talents. Entrée libre et gratuite."
    ],
    "nl": [
      "19.30 uur Un Instant Musical in de aula: onze jonge muzikanten betreden het podium om hun passie te delen! Een ontroerende voorstelling van 40 minuten waarin leerlingen van de muziekschool hun talenten laten zien. Gratis toegang."
    ],
    "es": [
      "19.30 h Un Instant Musical en el auditorio: ¡nuestros jóvenes músicos suben al escenario para compartir su pasión! Un espectáculo conmovedor de 40 minutos en el que los alumnos de la escuela de música revelan su talento. Entrada gratuita."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Instant musical"
    ]
  },
