  "rdfs:comment": {
    "de": [
      "Im Rahmen ihres Wanderoper-Projekts präsentiert die Opéra de Lyon das Stück Le Sang du glacier (Das Blut des Gletschers) in einem neuartigen Opernwagen, der im Hof des Lycée Les Catalins aufgestellt wurde."
    ],
    "en": [
      "As part of its touring opera project, Opéra de Lyon presents Le Sang du glacier, in an original Opera Truck set up in the courtyard of the Lycée Les Catalins."
    ],
    "it": [
      "Nell'ambito del suo progetto di opera itinerante, l'Opéra de Lyon presenta Le Sang du glacier (Il sangue del ghiacciaio) in un nuovissimo Opera Truck allestito nel cortile del Lycée Les Catalins."
    ],
    "fr": [
      "Dans le cadre de son projet d’opéra itinérant, l’Opéra de Lyon présente le spectacle Le Sang du glacier, dans un dispositif inédit de Camion-Opéra installé dans la cour du Lycée Les Catalins."
    ],
    "es": [
      "En el marco de su proyecto de ópera itinerante, la Ópera de Lyon presenta Le Sang du glacier (La sangre del glaciar) en un flamante Opera Truck instalado en el patio del Liceo Les Catalins."
    ],
    "nl": [
      "Als onderdeel van haar reizende operaproject presenteert de Opéra de Lyon Le Sang du glacier (Het bloed van de gletsjer) in een gloednieuwe Opera Truck die op de binnenplaats van het Lycée Les Catalins staat."
    ]
  },
  "rdfs:label": {
    "fr": [
