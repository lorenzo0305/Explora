  "rdfs:comment": {
    "de": [
      "Ob Sie die Attraktivität Ihrer Region, Ihrer Stadt, Ihrer Immobilie oder Ihrer Familie steigern möchten, ich weiß, wie ich Sie bei professionellen Fotos beraten kann."
    ],
    "en": [
      "Whether you want to enhance the appeal of your region, your town, your property, or your family, I can advise you on professional photography."
    ],
    "it": [
      "Se volete valorizzare la vostra regione, la vostra città, la vostra proprietà o la vostra famiglia, posso consigliarvi una fotografia professionale."
    ],
    "fr": [
      "Que vous souhaitiez augmenter l'attrait de votre région, de votre ville, de votre bien immobilier, ou de votre famille,  je saurai vous conseiller pour des photos professionnelles."
    ],
    "es": [
      "Si desea realzar el atractivo de su región, su ciudad, su propiedad o su familia, puedo asesorarle en fotografía profesional."
    ],
    "nl": [
      "Of je nu de aantrekkingskracht van je regio, je stad, je huis of je familie wilt vergroten, ik kan je adviseren over professionele fotografie."
    ]
