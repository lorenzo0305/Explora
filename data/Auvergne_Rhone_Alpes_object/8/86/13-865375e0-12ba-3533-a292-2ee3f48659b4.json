  "rdfs:comment": {
    "de": [
      "Das milde Klima der Drôme, eine Oase des Friedens und der Ruhe an den Ufern der Isère, das Hôtel Restaurant de Charme Les Vieilles Granges, ein alter Dauphinoise-Bauernhof, lädt Sie ein, sich zu entspannen und zu erholen."
    ],
    "en": [
      "In Drôme's nice weather, you will find a haven of peace and tranquillity along the Isère River. The charming Hotel and Restaurant \"Les Vieilles Granges\", ancient farm of the Dauphiné region, is the perfect place to relax and rest."
    ],
    "it": [
      "Nel clima mite della Drôme, in un'oasi di pace e tranquillità sulle rive dell'Isère, l'affascinante Hôtel-Restaurant Les Vieilles Granges, un'antica casa colonica del Delfinato, vi invita a rilassarvi e a riposare."
    ],
    "fr": [
      "La clémence du climat Drômois, un Havre de Paix et de tranquillité sur les berges de l'Isère, l'Hôtel-Restaurant de charme Les Vieilles Granges, ancienne ferme dauphinoise, vous invite à la détente et au repos."
    ],
    "nl": [
      "Het zachte klimaat in Driois, een haven van rust langs de oevers van de Isère, Les Vieilles Granges, een charmant hotelrestaurant, een oude boerderij in de Dauphiné, nodigt uit tot ontspanning en rust."
    ],
    "es": [
      "El clima suave de la Drôme, remanso de paz y tranquilidad a orillas del Isère, el encantador Hôtel-Restaurant Les Vieilles Granges, una antigua granja del Dauphiné, le invita a relajarse y descansar."
    ]
  },
