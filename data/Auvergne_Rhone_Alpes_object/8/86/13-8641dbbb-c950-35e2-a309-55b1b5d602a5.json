  "rdfs:comment": {
    "de": [
      "27 Hektar großer Stausee am Cher (klassifiziert als 1. Kategorie), unterhalb des Stausees (8 km von Prat bis Lavault-Sainte-Anne) + Nebenflüsse 1. Kategorie (Bachforelle, Gründling, Elritze, Ukelei dominieren).\r\nListe der Verkaufsstellen für Angelkarten unten."
    ],
    "en": [
      "27-hectare reservoir on the Cher (classified as 1st category), downstream of the reservoir (8 km from Prat to Lavault-Sainte-Anne) + 1st category tributaries (brown trout, gudgeon, minnow, bleak dominant).\r\nList of fishing card sales points below."
    ],
    "it": [
      "Bacino di 27 ettari sullo Cher (classificato di 1ª categoria), a valle del bacino (8 km da Prat a Lavault-Sainte-Anne) + affluenti di 1ª categoria (trota fario, scardola, minnow, alborella dominante).\r\nElenco dei punti di vendita delle tessere di pesca qui sotto."
    ],
    "fr": [
      "Retenue de 27 hectares sur le Cher (classée en 1re catégorie), à l'aval de la retenue (8 km de Prat à Lavault-Sainte-Anne) + affluents 1ère catégorie (truite fario, goujon, vairon, ablette dominants).\r\nListe des points de vente de carte pêche ci-dessous."
    ],
    "nl": [
      "Stuwmeer van 27 hectare aan de Cher (1ste categorie), stroomafwaarts van het stuwmeer (8 km van Prat tot Lavault-Sainte-Anne) + zijrivieren 1ste categorie (beekforel, riviergrondel, minnow, alver).\r\nLijst met verkooppunten voor viskaarten hieronder."
    ],
    "es": [
      "Embalse de 27 hectáreas en el Cher (clasificado de 1ª categoría), aguas abajo del embalse (8 km de Prat a Lavault-Sainte-Anne) + afluentes de 1ª categoría (trucha común, gobio, pececillo, dominante sombría).\r\nLista de puntos de venta de tarjetas de pesca a continuación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche au barrage de Prat"
    ]
  },
