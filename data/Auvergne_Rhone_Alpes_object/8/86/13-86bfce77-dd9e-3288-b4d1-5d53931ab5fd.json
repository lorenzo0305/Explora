  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Springs & Volcanoes empfängt Sie in seinen 3 Büros in den 3 Dörfern mit Charakter. Besuchen Sie unsere Berater, um Ihren Aufenthalt zu planen und Thueyts und die Umgebung in der Ardèche zu entdecken."
    ],
    "en": [
      "The Springs & Volcanoes Tourist Office welcomes you to its 3 offices in the 3 villages of character. Visit our advisors to help you plan your stay and discover Thueyts and the surrounding area in the Ardèche."
    ],
    "it": [
      "L'Ufficio del Turismo Sources & Volcans vi accoglie nei suoi 3 uffici nei 3 villaggi di carattere. Visitate i nostri consulenti per pianificare il vostro soggiorno e scoprire Thueyts e i dintorni dell'Ardèche."
    ],
    "fr": [
      "L'Office de Tourisme Sources & volcans vous reçoit dans ses 3 bureaux dans les 3 villages de caractère. Rendez visite à nos conseillères pour préparer avec elle votre séjour à la découverte de Thueyts et de ses alentours en Ardèche."
    ],
    "es": [
      "La Oficina de Turismo de Sources & Volcans le da la bienvenida en sus 3 oficinas situadas en 3 pueblos con carácter. Visite a nuestros asesores para planificar su estancia y descubrir Thueyts y sus alrededores en Ardèche."
    ],
    "nl": [
      "Het Office du Tourisme des Sources & Volcans heet u welkom in zijn 3 kantoren in de 3 karaktervolle dorpen. Bezoek onze adviseurs om u te helpen uw verblijf te plannen en Thueyts en de omgeving in de Ardèche te ontdekken."
    ]
  },
  "rdfs:label": {
    "de": [
