  "rdfs:comment": {
    "de": [
      "Der Guiers, der mythische Fluss des Avant-Pays-Savoyard und der Chartreuse, bietet ein fantastisches Spielfeld für leidenschaftliche Angler. Er ist zu Fuß von der Freizeitanlage Rivièr'Alp aus erreichbar und bietet Ihnen unvergessliche Angelerlebnisse."
    ],
    "en": [
      "The Guiers is a mythical river of the Savoy foreland and Chartreuse which offers a wonderful playground for the fishing fans. Accessible by foot from the leisure center Rivièr’ Alp, you will have an unforgettable fishing experience."
    ],
    "it": [
      "Il Guiers, il mitico fiume dell'Avant-Pays-Savoyard e della Chartreuse, offre un formidabile terreno di gioco per gli appassionati di pesca. Raggiungibile a piedi dal centro ricreativo Rivièr'Alp, vi offre sensazioni di pesca indimenticabili."
    ],
    "fr": [
      "Le Guiers, mythique rivière de l'Avant-Pays-Savoyard et de la Chartreuse, offre un formidable terrain de jeu pour les passionnés de la pêche. Accessible à pied depuis la base de loisirs Rivièr'Alp, vous y trouverez des sensations de pêche inoubliables."
    ],
    "es": [
      "El Guiers, mítico río de la Avant-Pays-Savoyard y la Chartreuse, ofrece un formidable terreno de juego para los aficionados a la pesca. Accesible a pie desde el centro de ocio Rivièr'Alp, encontrará sensaciones de pesca inolvidables."
    ],
    "nl": [
      "De Guiers, de mythische rivier van de Avant-Pays-Savoyard en de Chartreuse, biedt een formidabel speelterrein voor visliefhebbers. Te voet bereikbaar vanaf het recreatiecentrum Rivièr'Alp, vindt u onvergetelijke vissensensaties."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing site of upstream Guiers river"
    ],
    "fr": [
      "Le Guiers amont"
    ]
  },
