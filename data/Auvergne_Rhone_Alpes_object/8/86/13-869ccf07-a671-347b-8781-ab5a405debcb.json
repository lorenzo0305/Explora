  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie die Literaturpreise und die Neuheiten des Jahres.\r\nSie können auch CDs und DVDs ausleihen und Dokumente reservieren."
    ],
    "en": [
      "Come and discover the literary prizes, the novelties of the year.\r\nYou can also borrow CDs and DVDs and reserve documents."
    ],
    "it": [
      "Venite a scoprire i premi letterari e le novità dell'anno.\r\nÈ inoltre possibile prendere in prestito CD e DVD e prenotare documenti."
    ],
    "fr": [
      "Venez découvrir les prix littéraires, les nouveautés de l'année.\r\nVous pouvez aussi emprunter des CD, des DVD, et réserver des documents."
    ],
    "es": [
      "Venga a descubrir los premios literarios y las novedades del año.\r\nTambién puede tomar prestados CD y DVD y reservar documentos."
