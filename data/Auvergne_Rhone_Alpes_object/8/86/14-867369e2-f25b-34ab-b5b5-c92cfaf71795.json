  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/172b6379-fc74-30f9-bcc8-69faae087eac",
      "dc:description": {
        "de": [
          "Entdecken Sie Räume, die Sie noch nicht kennen, betrachten Sie die Architektur des renommierten Büros SANAA mit anderen Augen und bringen Sie das Museum in seinen Kontext zurück: einen einzigartigen Park und eine einzigartige Geschichte!"
        ],
        "en": [
          "Discover spaces you've never seen before, take a fresh look at the architecture designed by the prestigious SANAA studio, and put the museum back into context: a unique park and a unique history!"
        ],
        "it": [
          "Scoprite spazi mai visti prima, date un'occhiata all'architettura progettata dal prestigioso studio SANAA e ricollocate il museo nel suo contesto: un parco unico e una storia unica!"
        ],
        "fr": [
          "Découvrez des espaces que vous ne connaissez pas, regardez d'un autre œil cette architecture conçue par le prestigieux bureau SANAA et restituez le musée dans son contexte : un parc et une histoire uniques !"
        ],
        "nl": [
          "Ontdek ruimtes die je nog nooit hebt gezien, werp een frisse blik op de architectuur die is ontworpen door de prestigieuze SANAA studio en plaats het museum weer in zijn context: een uniek park en een unieke geschiedenis!"
        ],
        "es": [
          "Descubra espacios nunca vistos, contemple de nuevo la arquitectura diseñada por el prestigioso estudio SANAA y sitúe el museo en su contexto: ¡un parque único y una historia única!"
        ]
      },
