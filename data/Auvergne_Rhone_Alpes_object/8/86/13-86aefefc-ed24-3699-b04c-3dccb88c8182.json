  "rdfs:comment": {
    "de": [
      "Auf der Baustelle des Tabellions wurde ein seltsames Manuskript gefunden... Handelt es sich dabei um das des Entdeckers Brun-Rollet? Charlock nimmt dich mit zu den Hütern dieses Schatzes!"
    ],
    "en": [
      "At the Tabellion construction site, a strange manuscript has been found... Could it be that of the explorer Brun-Rollet? Charlock takes you to meet the guardians of this treasure! Adventure bag available from the tourist office for the day."
    ],
    "it": [
      "Nel cantiere di Tabellion è stato trovato uno strano manoscritto... Potrebbe essere quello dell'esploratore Brun-Rollet? Charlock vi porterà a conoscere i custodi di questo tesoro!"
    ],
    "fr": [
      "Sur le chantier du Tabellion, un étrange manuscrit a été trouvé… S’agirait-il de celui de l’explorateur Brun-Rollet ? Charlock t’emmène à la rencontre des gardiens de ce trésor ! Sac aventure à retirer à l’office de tourisme pour la journée."
    ],
    "es": [
      "¿Se ha encontrado un extraño manuscrito en las obras del Tabellion? ¿Podría ser el del explorador Brun-Rollet? Charlock le llevará a conocer a los guardianes de este tesoro Recoja su bolsa de aventuras en la Oficina de Turismo para pasar el día."
    ],
    "nl": [
      "Op de bouwplaats van Tabellion is een vreemd manuscript gevonden... Zou het dat van de ontdekkingsreiziger Brun-Rollet kunnen zijn? Charlock neemt je mee om de bewakers van deze schat te ontmoeten!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Rätsel des Charlock - Der Schatz des Heiligen Johannes"
    ],
    "ru": [
      "Загадки Чарлока - Сокровища Святого Иоанна"
    ],
    "en": [
      "Charlock's riddles - The treasure of Saint John"
    ],
    "it": [
      "Gli enigmi di Charlock - Il tesoro di San Giovanni"
    ],
    "fr": [
      "Les énigmes de Charlock - Le trésor de Saint-Jean"
    ],
    "zh": [
      "夏洛克的谜语 - 圣约翰的宝藏"
    ],
    "es": [
      "Enigmas de Charlock - El tesoro de San Juan"
    ],
    "nl": [
      "Charlocks raadsels - De schat van Sint Jan"
    ]
  },
