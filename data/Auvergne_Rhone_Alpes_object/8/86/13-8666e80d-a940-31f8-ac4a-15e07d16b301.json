  "rdfs:comment": {
    "de": [
      "Ein auf 28°C beheizter Wasserbereich mit einem 25 m langen Sportbecken (1 Bahn für Schwimmer), einem Spielbecken, einem Innen-Whirlpool und einem Außenbereich mit Rutsche und Planschbecken, der Ihrem Vergnügen gewidmet ist."
    ],
    "en": [
      "An aquatic area heated to 28°C with a 25 m sports pool (1 line reserved for swimmers), a leisure pool, an indoor bubble pool, and an outdoor area dedicated to your amusement with a slide and paddling pool."
    ],
    "it": [
      "Un'area acquatica riscaldata a 28°C con una piscina sportiva di 25 metri (1 corsia riservata ai nuotatori), una piscina per il tempo libero, una vasca idromassaggio interna e un'area esterna dedicata al divertimento con scivolo e piscina per bambini."
    ],
    "fr": [
      "Un espace aquatique chauffé à 28°C avec un bassin sportif de 25 m (1 ligne réservée aux nageurs), un bassin ludique, bassin à remous intérieur, un espace extérieur dédié à votre amusement avec toboggan et pataugeoire."
    ],
    "es": [
      "Un espacio acuático climatizado a 28°C con una piscina deportiva de 25 metros (1 carril reservado a los nadadores), una piscina lúdica, un jacuzzi interior y un espacio exterior dedicado a la diversión con tobogán y piscina infantil."
    ],
    "nl": [
      "Een aquatische ruimte verwarmd tot 28°C met een sportbad van 25 meter (1 baan gereserveerd voor zwemmers), een recreatiebad, een overdekt bubbelbad en een buitenruimte gewijd aan plezier met een glijbaan en een peuterbad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Municipal swimming pool of the Glières Leisure Park"
    ],
    "fr": [
      "Piscine municipale du Parc de Loisirs des Glières"
    ],
    "nl": [
      "Gemeentelijk zwembad van het recreatiecentrum Les Glières"
    ]
  },
