  "rdfs:comment": {
    "de": [
      "Wir sind seit sieben Generationen in Familienbesitz und bieten Ihnen sieben Appellationen aus einer einzigen Rebsorte an: dem Gamay. Als Winzer und Handwerker bauen wir unsere Reben an, vinifizieren und vermarkten unsere Weine."
    ],
    "en": [
      "Our estate has been in the family for 7 generations. We have 7 appellations made using a single grape variety-gamay-on offer. Craftsmen of vines and wine, we train and tend our vines , vinify our wine and sell it ourselves."
    ],
    "it": [
      "Proprietà familiare da 7 generazioni, offriamo 7 denominazioni basate su un unico vitigno: il Gamay. Come viticoltori e artigiani, coltiviamo le nostre vigne, vinifichiamo e commercializziamo i nostri vini."
    ],
    "fr": [
      "Propriété familiale depuis 7 générations, nous vous proposons 7 appellations à partir d’un cépage unique : le Gamay. Vignerons et artisans, nous cultivons nos vignes, vinifions et commercialisons nos vins."
    ],
    "es": [
      "Propiedad familiar desde hace 7 generaciones, ofrecemos 7 denominaciones de origen basadas en una única variedad de uva: la Gamay. Como viticultores y artesanos, cultivamos nuestras viñas, vinificamos y comercializamos nuestros vinos."
    ],
    "nl": [
      "Als familiebedrijf sinds 7 generaties bieden wij 7 appellaties aan van één enkele druivensoort: Gamay. Als wijnbouwers en ambachtslieden bewerken wij onze wijnstokken, vinifiëren wij en brengen wij onze wijnen op de markt."
    ]
  },
