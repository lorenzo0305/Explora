  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von einem professionellen Musher über die bewaldeten Wege führen und entdecken Sie ein anderes Courchevel.\r\nTagsüber am \"Plan du Vah\" für eine Dauer von ca. 25 Minuten.\r\nAm Abend am \"Plantret\" für eine Dauer von ca. 45 Minuten."
    ],
    "en": [
      "Guided by a professional musher, let yourself be led along wooded trails to discover a different Courchevel.\r\nDaytime: \"Plan du Vah\", approx. 25 minutes.\r\nIn the evening at \"Plantret\" for around 45 minutes."
    ],
    "it": [
      "Guidati da un musher professionista, lasciatevi condurre lungo i sentieri boschivi per scoprire una Courchevel diversa.\r\nDi giorno al \"Plan du Vah\" per circa 25 minuti.\r\nLa sera al \"Plantret\" per circa 45 minuti."
    ],
    "fr": [
      "Guidé par un musher professionnel, laissez vous conduire sur les sentiers boisés pour découvrir un Courchevel différent.\r\nEn journée au \"plan du Vah\"  pour une durée d'environ 25 minutes.\r\nEn soirée au \"Plantret\" pour une durée d'environ 45 minutes."
    ],
    "nl": [
      "Laat je onder begeleiding van een professionele musher over de beboste paden leiden om een ander Courchevel te ontdekken.\r\nOverdag bij het \"Plan du Vah\" voor ongeveer 25 minuten.\r\nS Avonds bij \"Plantret\" voor ongeveer 45 minuten."
    ],
    "es": [
      "Guiado por un musher profesional, déjese llevar por los senderos arbolados para descubrir un Courchevel diferente.\r\nDurante el día en \"Plan du Vah\" durante unos 25 minutos.\r\nPor la noche, en \"Plantret\" durante unos 45 minutos."
    ]
  },
