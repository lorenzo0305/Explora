  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Domaine CARREL François & fils in Jongieux, um hochwertige Savoyer Weine zu verkosten. Vater und Tochter, Winzer in der sechsten Generation, legen großen Wert auf ihr Terroir und die lokalen Rebsorten."
    ],
    "en": [
      "Winemakers for 6 generations, father and daughter, we attach great importance to our terroir and local grape varieties."
    ],
    "it": [
      "Scoprite il Domaine CARREL François & fils a Jongieux per degustare i vini di qualità della Savoia. Viticoltori da 6 generazioni, padre e figlia attribuiscono grande importanza al loro terroir e ai vitigni locali."
    ],
    "fr": [
      "Découvrez le Domaine CARREL François & fils à Jongieux pour déguster des vins de Savoie de qualité. Vignerons depuis 6 générations, père et fille, apportent une grande importance à leur terroir et aux cépages locaux."
    ],
    "nl": [
      "We zijn al 6 generaties lang wijnmakers, vader en dochter, en hechten veel belang aan ons terroir en onze lokale druivenrassen."
    ],
    "es": [
      "Descubra Domaine CARREL François & fils en Jongieux para degustar vinos de calidad de Saboya. Viticultores desde hace 6 generaciones, padre e hija conceden gran importancia a su terruño y a las variedades de uva locales."
    ]
  },
