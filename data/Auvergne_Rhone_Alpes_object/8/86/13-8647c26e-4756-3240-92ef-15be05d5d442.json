  "rdfs:comment": {
    "de": [
      "Boutique im Herzen des historischen Zentrums von Clermont-Ferrand mit einer großen Auswahl an Besteckartikeln aus überwiegend thiernoiser Produktion, aber auch aus Europa, Japan und den USA."
    ],
    "en": [
      "Boutique located in the heart of Clermont-Ferrand's historic center, offering a wide selection of cutlery, mainly made in Thiers, but also in Europe, Japan and the USA."
    ],
    "it": [
      "Negozio situato nel cuore del centro storico di Clermont-Ferrand, che offre un'ampia gamma di posate, principalmente prodotte a Thiers, ma anche in Europa, Giappone e Stati Uniti."
    ],
    "fr": [
      "Boutique située en plein cœur du centre historique de Clermont-Ferrand, proposant un vaste choix d'articles de coutellerie de production majoritairement thiernoise mais aussi européenne, japonaise ou américaine."
    ],
    "nl": [
      "Winkel in het hart van het historische centrum van Clermont-Ferrand, met een breed assortiment bestekken die voornamelijk in Thiers worden geproduceerd, maar ook in Europa, Japan en de Verenigde Staten."
    ],
    "es": [
      "Tienda situada en el corazón del centro histórico de Clermont-Ferrand, que ofrece una amplia gama de cubiertos, principalmente fabricados en Thiers, pero también en Europa, Japón y Estados Unidos."
    ]
  },
