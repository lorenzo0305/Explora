  "rdfs:comment": {
    "de": [
      "Genießen Sie köstliche Buchweizengaletten und bretonische Crêpes in einer wunderschönen Umgebung.\n\nSie werden eine Speisekarte mit einer großen Auswahl an Galettes, Salaten und Desserts entdecken."
    ],
    "en": [
      "Come and enjoy delicious buckwheat pancakes and Breton crepes in a beautiful setting.\n\nYou will discover a menu with a large choice of pancakes, salads and desserts."
    ],
    "it": [
      "Venite a gustare le deliziose frittelle di grano saraceno e le crepes bretoni in una splendida cornice.\n\nScoprirete un menu con un'ampia scelta di galette, insalate e dessert."
    ],
    "fr": [
      "Venez savourer de délicieuses galettes de sarrasin et crêpes bretonnes dans un magnifique cadre.\n\nVous découvrirez une carte avec un large choix de galettes, de salades et de desserts."
    ],
    "es": [
      "Venga a degustar deliciosas tortitas de trigo sarraceno y crepes bretonas en un marco incomparable.\n\nDescubrirá una carta con una amplia selección de galettes, ensaladas y postres."
    ],
    "nl": [
      "Kom genieten van heerlijke boekweitpannenkoeken en Bretonse crêpes in een prachtig decor.\n\nU ontdekt een menu met een ruime keuze aan galettes, salades en desserts."
    ]
  },
  "rdfs:label": {
