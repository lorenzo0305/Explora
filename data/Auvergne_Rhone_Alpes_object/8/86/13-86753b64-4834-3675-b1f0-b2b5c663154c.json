  "rdfs:comment": {
    "de": [
      "Fahrradverleih für 1/2 Tag auf dem grünen Weg \"Via Ardèche\", entdecken Sie unsere ultra-komfortablen Beach-Cruiser-Fahrräder, mit denen Sie sanft die wunderschönen Landschaften entdecken können."
    ],
    "en": [
      "Half-day bike hire on the \"Via Ardèche\" greenway, come and discover our ultra-comfortable beach cruiser bikes, which will allow you to gently explore the magnificent countryside."
    ],
    "it": [
      "Noleggio di biciclette per mezza giornata sull'itinerario verde \"Via Ardèche\", venite a scoprire le nostre comodissime biciclette da spiaggia, che vi permetteranno di scoprire magnifici paesaggi con facilità."
    ],
    "fr": [
      "Location de vélos à la 1/2 journée sur la voie verte « Via Ardèche » , venez découvrir nos vélos beach cruiser ultra confortables, qui vous permettront de découvrir avec douceur de magnifiques paysages."
    ],
    "nl": [
      "Fietsverhuur voor een halve dag op de groene route \"Via Ardèche\", kom en ontdek onze ultracomfortabele beach cruiser fietsen, waarmee je met gemak prachtige landschappen kunt ontdekken."
    ],
    "es": [
      "Alquiler de bicicletas para medio día en la vía verde \"Via Ardèche\", venga a descubrir nuestras bicicletas beach cruiser ultraconfortables, que le permitirán descubrir magníficos paisajes con facilidad."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fahrradverleih für 1/2 Tag - Balazuc Loisirs"
    ],
    "en": [
      "1/2 day bike hire - Balazuc Loisirs"
    ],
    "fr": [
      "Location de vélos à la 1/2 journée - Balazuc Loisirs"
    ],
    "nl": [
      "1/2 dag fietsverhuur - Balazuc Loisirs"
    ]
  },
