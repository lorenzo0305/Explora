  "rdfs:comment": {
    "de": [
      "Das Team des Fremdenverkehrsamtes befindet sich an der Bergstation des legendären Mastrou und empfängt Sie im Herzen des Doux-Tals in der Ardèche. Verpassen Sie nicht die unumgänglichen Märkte am Dienstag und Samstag in Lamastre."
    ],
    "en": [
      "Located at the arrival station of the legendary Mastrou, the Tourist Office team welcomes you at the heart of the Doux Valley in Ardèche. Don't miss the must-visit Tuesday and Saturday markets in Lamastre."
    ],
    "it": [
      "Situato alla stazione di arrivo del leggendario Mastrou, il team dell'Ufficio del Turismo vi dà il benvenuto nel cuore della Valle del Doux nell'Ardèche. Non perdete gli imperdibili mercati del martedì e del sabato a Lamastre."
    ],
    "fr": [
      "Située à la gare d'arrivée du légendaire Mastrou, l'équipe de l'Office de Tourisme vous accueille au cœur de la vallée du Doux en Ardèche. Ne manquez pas les incontournables marchés du mardi et du samedi à Lamastre."
    ],
    "es": [
      "Situado en la estación de llegada del legendario Mastrou, el equipo de la Oficina de Turismo le da la bienvenida al corazón del valle del Doux, en Ardèche. No se pierda los ineludibles mercados de los martes y sábados en Lamastre."
    ],
    "nl": [
      "Gelegen op het aankomststation van de legendarische Mastrou, verwelkomt het team van het VVV-kantoor je in het hart van de vallei van de Doux in de Ardèche. Mis de onmisbare markten op dinsdag en zaterdag in Lamastre niet."
    ]
  },
  "rdfs:label": {
    "en": [
