  "rdfs:comment": {
    "de": [
      "Das Eden besteht aus drei Kinosälen und einem Veranstaltungssaal (mit Platz für 450 Personen). Das Programm umfasst Filme mit nationalem Start, in OV, Kunstfilme, Kurzfilme, Filmabende und Mahlzeiten."
    ],
    "en": [
      "L'Eden has 3 cinemas and an auditorium (seating 450). Great programming with national release films, V.O, art & essai, short films, themed evenings and meals."
    ],
    "it": [
      "L'Eden dispone di 3 sale cinematografiche e di un auditorium (che può ospitare 450 persone). Bellissimi programmi con film in uscita nazionale, in V.O, art & essai, cortometraggi, serate tematiche e pasti."
    ],
    "fr": [
      "L'Eden c'est 3 salles de cinéma et une salle de spectacle (qui peut accueillir 450 personnes). De belles programmations avec films à sortie nationale, en V.O, art & essai, courts-métrage, soirées thématiques films et repas."
    ],
    "es": [
      "L'Eden cuenta con 3 salas de cine y un auditorio (con capacidad para 450 personas). Bonitos programas con películas de estreno nacional, en V.O, arte y essai, cortometrajes, veladas temáticas y comidas."
    ],
    "nl": [
      "Eden heeft 3 bioscopen en een auditorium (met 450 zitplaatsen). Een geweldig programma van films met nationale release, in V.O, art house, korte films, thema-avonden en maaltijden."
    ]
  },
  "rdfs:label": {
