  "rdfs:comment": {
    "de": [
      "Das 1885 unter Emile Loubet erbaute Stadttheater von Montélimar ist ein Wahrzeichen der Belle Epoque Montiliens und ein Muss für jeden Besucher der Stadt. Diese Führung enthüllt die Geschichte und die Geheimnisse des Ortes."
    ],
    "en": [
      "An emblem of Montélimar's Belle Epoque, built in 1885 under the mandate of Emile Loubet, Montélimar's municipal theater is one of the city's must-see sites. This guided tour will reveal the theatre's history and secrets."
    ],
    "it": [
      "Emblema della Belle Epoque di Montélimar, costruito nel 1885 su mandato di Emile Loubet, il teatro municipale di Montélimar è una delle attrazioni imperdibili della città. Questa visita guidata vi svelerà la storia e i segreti del teatro."
    ],
    "fr": [
      "Emblème de la Belle Epoque montilienne, construit en 1885 sous le mandat d'Emile Loubet, le théâtre municipal de Montélimar est un site incontournable de la ville. Cette visite guidée dévoilera l'histoire et les secrets du lieu."
    ],
    "es": [
      "Emblema de la Belle Epoque de Montélimar, construido en 1885 bajo el mandato de Emile Loubet, el teatro municipal de Montélimar es una de las atracciones imprescindibles de la ciudad. Esta visita guiada le desvelará la historia y los secretos del teatro."
    ],
    "nl": [
      "De stadsschouwburg van Montélimar, een symbool van de Belle Epoque van Montélimar en gebouwd in 1885 onder het mandaat van Emile Loubet, is een van de trekpleisters van de stad. Deze rondleiding onthult de geschiedenis en de geheimen van het theater."
    ]
  },
  "rdfs:label": {
    "fr": [
