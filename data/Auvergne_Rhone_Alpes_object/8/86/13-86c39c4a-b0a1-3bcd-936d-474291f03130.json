  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Broût-Vernet entstand 1831 durch den Zusammenschluss der Gemeinden Broût (östlicher Teil der heutigen Gemeinde) und Le Vernet-sur-Sioule (westlicher Teil)."
    ],
    "en": [
      "Free access. Broût-Vernet is the result of the 1831 merger of the communes of Broût (eastern part of the current commune) and Le Vernet-sur-Sioule (western part)."
    ],
    "it": [
      "Accesso libero. Broût-Vernet è nato dalla fusione, avvenuta nel 1831, dei comuni di Broût (la parte orientale dell'attuale comune) e Vernet-sur-Sioule (la parte occidentale)."
    ],
    "fr": [
      "Accès libre. Broût-Vernet résulte de la fusion, en 1831, des communes de Broût (partie orientale de l'actuelle commune) et du Vernet-sur-Sioule (partie occidentale)."
    ],
    "nl": [
      "Vrije toegang. Broût-Vernet ontstond uit de fusie in 1831 van de gemeenten Broût (het oostelijke deel van de huidige gemeente) en Vernet-sur-Sioule (het westelijke deel)."
    ],
    "es": [
      "Acceso libre. Broût-Vernet es el resultado de la fusión en 1831 de los municipios de Broût (la parte oriental del municipio actual) y Vernet-sur-Sioule (la parte occidental)."
    ]
  },
