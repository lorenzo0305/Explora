  "rdfs:comment": {
    "de": [
      "Auf dem Dorfplatz bietet Ihnen Isabelle Schnellgerichte aus regionalen Produkten an.\r\nAll-inclusive-Angebote, Salate, Ravioli, Galettes, Crêpes, Eis...\r\nEine Boutique mit regionalen und bodenständigen Produkten steht Ihnen ebenfalls zur Verfügung."
    ],
    "en": [
      "On the village square, Isabelle offers fast food based on regional products.\r\nAll-inclusive formulas, salads, ravioli, galettes, crêpes, ice creams...\r\nA store selling local and regional products is also available."
    ],
    "it": [
      "Nella piazza del paese, Isabelle propone un fast food a base di prodotti locali.\r\nFormule all-inclusive, insalate, ravioli, galettes, crêpes, gelati...\r\nÈ disponibile anche un negozio di prodotti locali e regionali."
    ],
    "fr": [
      "Sur la place du village, Isabelle vous propose une restauration rapide à base de produits régionaux. \r\nFormules tout compris, salades, ravioles, galettes, crêpes, glaces...\r\nUne boutique de produits du terroir et régionaux est également à votre disposition."
    ],
    "nl": [
      "Op het dorpsplein biedt Isabelle fastfood op basis van lokale producten.\r\nAll-inclusive formules, salades, ravioli, galettes, crêpes, ijsjes...\r\nEr is ook een winkel met lokale en regionale producten."
    ],
    "es": [
      "En la plaza del pueblo, Isabelle ofrece comida rápida a base de productos locales.\r\nFórmulas todo incluido, ensaladas, raviolis, galettes, crêpes, helados...\r\nTambién dispone de una tienda de productos locales y regionales."
    ]
  },
  "rdfs:label": {
