  "rdfs:comment": {
    "de": [
      "Ravioles De Val ein Ort, an dem man Ravioles mit Sahne und wechselnden Füllungen unter der Woche zum Mitnehmen oder zum Verzehr vor Ort in einem herzlichen Empfang genießen kann"
    ],
    "en": [
      "Ravioles De Val a place to enjoy ravioli with cream and changing fillings on weekdays to take away, or to eat on the spot in a warm welcome"
    ],
    "it": [
      "Ravioles De Val è un luogo dove gustare ravioli con crema e ripieni variabili durante la settimana, da asporto o da mangiare in casa, in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Ravioles De Val, un endroit où déguster des ravioles avec crème et garnitures changeantes en semaine.\r\n A emporter, ou à consommer sur place dans un accueil chaleureux !"
    ],
    "es": [
      "Ravioles De Val, un lugar para degustar ravioles con crema y rellenos cambiantes durante la semana.\r\n Para llevar o para comer in situ en un ambiente acogedor"
    ],
    "nl": [
      "Ravioles De Val is een plek om doordeweeks te genieten van ravioli met room en wisselende vullingen, om mee te nemen of om in te eten, in een warme en vriendelijke sfeer."
    ]
