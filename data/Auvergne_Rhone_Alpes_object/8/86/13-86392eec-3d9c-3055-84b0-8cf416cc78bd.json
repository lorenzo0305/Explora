  "rdfs:comment": {
    "de": [
      "Das Idéal 1850 verfügt über eine prächtige Terrasse mit einem atemberaubenden Blick auf den Mont-Blanc. Skifahrer und Spaziergänger treffen sich hier, um sich an einer schönen Auswahl an Austern und der unumgänglichen Champagnerbar zu erfreuen."
    ],
    "en": [
      "Ideal 1850 features a beautiful terrace with a breathtaking view of Mont Blanc. Skiers and walkers gather there to savor , a fine selection of oysters, and the must-visit champagne bar."
    ],
    "it": [
      "L'Idéal 1850 vanta una splendida terrazza con una vista mozzafiato sul Monte Bianco. Sciatori e passeggiatori si ritrovano qui per gustare  una prelibata selezione di ostriche e l'imperdibile champagne bar."
    ],
    "fr": [
      "L'Idéal 1850 dispose d’une somptueuse terrasse avec une vue imprenable sur le Mont-Blanc. Skieurs et promeneurs s'y retrouvent pour se délecter  d'une belle sélection d’huitre et l’incontournable bar à champagne."
    ],
    "nl": [
      "L'Idéal 1850 heeft een weelderig terras met een adembenemend uitzicht op de Mont Blanc. Hier kunnen zowel skiërs als wandelaars genieten van een fijne selectie oesters en de niet te missen champagnebar."
    ],
    "es": [
      "L'Idéal 1850 cuenta con una suntuosa terraza con impresionantes vistas del Mont Blanc. Aquí, esquiadores y senderistas pueden disfrutar de una exquisita selección de ostras y del imperdible bar de champán."
    ]
  },
