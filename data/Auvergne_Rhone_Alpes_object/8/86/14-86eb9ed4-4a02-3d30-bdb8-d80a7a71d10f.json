      "dc:description": {
        "de": [
          "Rennen zu Fuß\nSamstag, 27. September\nCOSEC d?Ecuires\n-------------------------------\nDie Veranstaltung wird von der Amicale des Sapeurs-Pompiers präsentiert\nLauf \"Les Remparts\" über 6 km\nLauf \"La Montreuilloise\" über 11,5 km\n\nKlicken Sie auf den Link, um zu buchen: https://shorturl.at/g2CTG\nAb 14 Uhr\n\nKredit: La Ronde des Misérables"
        ],
        "en": [
          "Pedestrian races\nSaturday, September 27\nEcuires COSEC\n-------------------------------\nEvent presented by the Amicale des Sapeurs-Pompiers\nLes Remparts? 6km race\nLa Montreuilloise? 11.5km race\n\nClick on the link to book: https://shorturl.at/g2CTG\nStarting at 2pm\n\nCredit: La Ronde des Misérables"
        ],
        "it": [
          "Gare pedonali\nSabato 27 settembre\nEcuires COSEC\n-------------------------------\nEvento presentato dall'Amicale des Sapeurs-Pompiers\nLes Remparts? Corsa di 6 km\nLa Montreuilloise? Corsa di 11,5 km\n\nCliccare sul link per prenotare: https://shorturl.at/g2CTG\nA partire dalle 14:00\n\nCrediti: la Ronde des Misérables"
        ],
        "fr": [
          "Courses pédestres \nSamedi 27 septembre\nCOSEC d’Ecuires\n-------------------------------\nEvénement présenté par l’Amicale des Sapeurs-Pompiers \nCourse ‘Les Remparts’ de 6km\nCourse ‘La Montreuilloise’ de 11,5kms \n\nCliquez sur le lien pour réserver : https://shorturl.at/g2CTG\nA partir de 14h\n\nCrédit : la Ronde des Misérables"
        ],
        "nl": [
          "Voetgangersraces\nZaterdag 27 september\nEcuires COSEC\n-------------------------------\nEvenement aangeboden door de Amicale des Sapeurs-Pompiers\nWedstrijd Les Remparts: 6 km\n11,5 km La Montreuilloise\n\nKlik op de link om te reserveren: https://shorturl.at/g2CTG\nAanvang 14u\n\nKrediet: La Ronde des Misérables"
        ],
        "es": [
          "Carreras pedestres\nSábado 27 de septiembre\nEcuires COSEC\n-------------------------------\nEvento presentado por la Amicale des Sapeurs-Pompiers\nCarrera de 6 km Les Remparts\nLa Montreuilloise: carrera de 11,5 km\n\nHaga clic en el enlace para reservar: https://shorturl.at/g2CTG\nComienzo a las 14:00\n\nCrédito: la Ronde des Misérables"
        ]
      },
