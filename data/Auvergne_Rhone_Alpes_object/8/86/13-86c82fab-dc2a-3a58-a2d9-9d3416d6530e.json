  "rdfs:comment": {
    "de": [
      "Gegenüber des denkmalgeschützten, ehemaligen Bahnhofs von Brotteaux ehrt Georges Blanc in dieser schönen Brasserie die berühmten Köchinnen mit dem Namen \"Lyoner Mütter\". Eine richtige Lyoner Institution!"
    ],
    "en": [
      "Located opposite the former Gare des Brotteaux, today listed as a historical monument, Georges Blanc pays tribute to the legendary mères cuisinières in this attractive brasserie. A genuine Lyonnais institution!"
    ],
    "it": [
      "Di fronte all'ex stazione ferroviaria dei Brotteaux, dichiarata monumento storico, Georges Blanc rende omaggio alle celebri madri-cuoche lionesi in questa bella brasserie. Una vera e propria istituzione a Lione!"
    ],
    "fr": [
      "Face à l’ancienne Gare des Brotteaux classée monument historique, Georges Blanc rend hommage aux célèbres mères cuisinières dans cette belle brasserie. Une véritable institution lyonnaise !"
    ],
    "nl": [
      "Tegenover het voormalige station van Brotteaux, een beschermd historisch monument, brengt Georges Blanc hulde aan de beroemde moederkoks in deze prachtige brasserie. Een echt Lyon instituut!"
    ],
    "es": [
      "Frente a la antigua estación de Brotteaux, declarada monumento histórico, Georges Blanc rinde homenaje a las famosas madres cocineras en esta hermosa brasserie. ¡Una auténtica institución lionesa!"
    ]
  },
