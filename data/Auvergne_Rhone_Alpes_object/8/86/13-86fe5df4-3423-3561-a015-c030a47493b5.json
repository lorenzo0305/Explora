  "rdfs:comment": {
    "de": [
      "Das Kabarett Music-Hall l?Élégance öffnet Ihnen seine Türen an einem magischen Ort für hochwertige Mittags- oder Abendessen-Shows in einem der größten Kabaretts Frankreichs, in dem die Revue entstaubt wird. Kommen Sie und verbringen Sie einen einzigartigen Moment."
    ],
    "en": [
      "The cabaret Music-Hall l?Élégance opens its doors to you in a magical setting for top-quality lunch or dinner shows, in one of France's greatest cabarets where revue has been dusted off. Come and spend a unique moment."
    ],
    "it": [
      "Il cabaret l'Élégance vi apre le porte in un ambiente magico per spettacoli di alta qualità a pranzo o a cena, in uno dei più grandi cabaret francesi dove la revue è stata rispolverata. Venite a trascorrere un momento unico."
    ],
    "fr": [
      "Le cabaret Music-Hall l’Élégance vous ouvre ses portes dans un lieu magique  pour des déjeuners ou dîners-spectacles de grande qualité, dans l'un des plus grands cabarets de France où la revue est dépoussiérée. Venez passer un moment unique."
    ],
    "nl": [
      "Het cabaret l'Élégance opent zijn deuren voor u in een magische omgeving voor lunch- of dinnershows van topkwaliteit, in een van de grootste cabarets van Frankrijk waar de revue is afgestoft. Kom en beleef een uniek moment."
    ],
    "es": [
      "El cabaret music-hall l'Élégance le abre sus puertas en un marco mágico para almuerzos o cenas con espectáculos de gran calidad, en uno de los grandes cabarets franceses donde se ha desempolvado la revista. Venga a pasar un momento único."
    ]
  },
