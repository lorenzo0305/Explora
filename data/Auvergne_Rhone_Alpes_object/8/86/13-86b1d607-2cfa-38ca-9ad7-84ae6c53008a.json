  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration mit Gerichten wie Terrine, Stück vom Metzger, Trüffel, Käseplatte usw. Und zum Abschluss etwas Süßes: Brioche perdue, Moelleux au chocolat, Bauernhof-Eis..."
    ],
    "en": [
      "Traditional catering with dishes such as terrine, pièce du boucher, truffade, cheese platter and more. And to finish on a sweet note: brioche perdue, moelleux au chocolat, farmhouse ice creams..."
    ],
    "it": [
      "Ristorazione tradizionale con piatti come terrina, tagliata del macellaio, truffade, tagliere di formaggi, ecc. E per finire in dolcezza: brioche perdue, torta al cioccolato, gelati di fattoria..."
    ],
    "fr": [
      "Restauration traditionnelle avec des plats comme la terrine, la pièce du boucher, la truffade, plateau de fromages, etc. Et pour finir sur une touche sucrée : brioche perdue, moelleux au chocolat, glaces fermières..."
    ],
    "nl": [
      "Traditionele catering met gerechten zoals terrine, slagerij, truffade, kaasplateau, enz. En om zoet af te sluiten: brioche perdue, chocoladetaart, boerenijs..."
    ],
    "es": [
      "Restauración tradicional con platos como terrina, corte de carnicero, truffade, tabla de quesos, etc. Y para terminar con una nota dulce: brioche perdue, tarta de chocolate, helados de granja..."
    ]
  },
