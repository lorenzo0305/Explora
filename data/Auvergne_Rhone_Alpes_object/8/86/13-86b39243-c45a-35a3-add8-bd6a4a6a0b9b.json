  "rdfs:comment": {
    "de": [
      "Wochenende der offenen Tür: Hundertjährige Olivenbäume und biodynamisch bewirtschaftete Weinberge AOP Nyons.\r\nAm Samstag: kostenlose Fahrt mit dem Elektrofahrrad. Vorführung von Zugtieren (10:30, 14:30, 16:30)."
    ],
    "en": [
      "Open house weekend: century-old olive trees and biodynamic AOP Nyons vines.\r\nSaturday: free electric bike ride. Animal traction demonstration (10:30 am, 2:30 pm, 4:30 pm)."
    ],
    "it": [
      "Apertura del fine settimana: ulivi secolari e viti biodinamiche AOP Nyons.\r\nSabato: passeggiata gratuita in bicicletta elettrica. Dimostrazione di trazione animale (10.30, 14.30, 16.30)."
    ],
    "fr": [
      "Week-end portes-ouvertes : oliviers centenaires et vignes cultivées en biodynamie AOP Nyons.\r\nLe samedi : balade gratuite à vélo électrique. Démonstration de traction animale (10h30, 14h30, 16h30)."
    ],
    "nl": [
      "Weekend open huis: eeuwenoude olijfbomen en biodynamische AOP Nyons wijnstokken.\r\nZaterdag: gratis elektrische fietstocht. Demonstratie dierentractie (10.30, 14.30, 16.30)."
    ],
    "es": [
      "Fin de semana de puertas abiertas: olivos centenarios y viñedos biodinámicos AOP Nyons.\r\nSábado: paseo gratuito en bicicleta eléctrica. Demostración de tracción animal (10.30 h, 14.30 h, 16.30 h)."
    ]
  },
