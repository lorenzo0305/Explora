  "rdfs:comment": {
    "de": [
      "La Maison du Tourisme de Saint Martin bietet seine Dienste:  allgemeine Informationen über das Dorf und die umliegenden Gebiete.\r\nProgramm von Aktivitäten: Freizeit, Märkte, Unterhaltung, Museum, Ausstellung Touren."
    ],
    "en": [
      "The tourist Office welcomes you in the winter and summer. \r\nYou'll get full of practical informations, advice and useful addresses : brochures,  wifi and internet connexion, photocopies."
    ],
    "it": [
      "La Maison du Tourisme di Saint Martin vi dà il benvenuto e vi offre i suoi servizi: documentazione/informazioni sul villaggio e sui dintorni\r\nProgramma di eventi: attività per il tempo libero, mercati, eventi, musei, mostre, visite guidate.  Connessione internet e wifi."
    ],
    "fr": [
      "La Maison du Tourisme de Saint Martin vous accueille et vous propose ses services : documentation/information du village et des environs\r\nProgramme d'animation : loisirs, marchés, animations, musée, exposition, visites guidées.  Connexion internet et wifi."
    ],
    "es": [
      "La Maison du Tourisme de Saint Martin le da la bienvenida y le ofrece sus servicios: documentación/información sobre el pueblo y los alrededores\r\nPrograma de actos: actividades de ocio, mercados, eventos, museo, exposición, visitas guiadas.  Conexión a Internet y wifi."
    ],
    "nl": [
      "La Maison du Tourisme de Saint Martin biedt haar diensten: algemene informatie van het dorp en de omliggende gebieden.\r\nProgramma van activiteiten: vrije tijd, markten, amusement, museum, tentoonstelling tours."
    ]
  },
