  "rdfs:comment": {
    "de": [
      "L'Echappée Romanaise ist das Atelier/Boutique von Silvia, Buchbinderin, und Laure, Fotografin und Cyanotypistin.\r\n\r\nHier teilen wir unser Know-how mit Ihnen in Form von kreativen Workshops und dem Verkauf unserer Produktionen."
    ],
    "en": [
      "L'Echappée Romanaise is the workshop/shop of Silvia, bookbinder, and Laure, photographer and cyanotyper.\r\n\r\nWe share our expertise with you through creative workshops and the sale of our work."
    ],
    "it": [
      "L'Echappée Romanaise è il laboratorio/negozio di Silvia, rilegatrice, e Laure, fotografa e cianotipista.\r\n\r\nCondividiamo la nostra esperienza con voi attraverso laboratori creativi e la vendita dei nostri lavori."
    ],
    "fr": [
      "L'Echappée Romanaise est l'atelier/boutique de Silvia, relieuse, et Laure, photographe et cyanotypeuse. \r\n\r\nNous y partageons avec vous notre savoir-faire sous forme d'ateliers créatifs et de vente de nos productions."
    ],
    "nl": [
      "L'Echappée Romanaise is het atelier/winkel van Silvia, boekbindster, en Laure, fotografe en cyanotypiste.\r\n\r\nWe delen onze expertise met jou door middel van creatieve workshops en de verkoop van ons werk."
    ],
    "es": [
      "L'Echappée Romanaise es el taller/tienda de Silvia, encuadernadora, y Laure, fotógrafa y cianotipista.\r\n\r\nCompartimos nuestra experiencia con usted a través de talleres creativos y la venta de nuestro trabajo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Echappée Romanaise - Ateliers de reliure et cyanotype"
    ]
  },
