  "rdfs:comment": {
    "de": [
      "Unsere Bäckerei lädt Sie zu einer süßen oder salzigen Auszeit ein! In unserer Einrichtung können Sie eine große Menge an Brot, aber auch Süßigkeiten kaufen."
    ],
    "en": [
      "Our bakery invites you to a sweet or savory interlude! In our establishment, you will be able to buy a vast quantity of bread but also confectionery."
    ],
    "it": [
      "La nostra panetteria vi invita a una pausa dolce o salata! Nel nostro stabilimento è possibile acquistare una grande quantità di pane ma anche di prodotti dolciari."
    ],
    "fr": [
      "Notre boulangerie vous convie à une parenthèse gourmande sucrée ou salée ! Dans notre établissement, vous pourrez acheter une vaste quantité de pain mais aussi des confiseries."
    ],
    "nl": [
      "Onze bakkerij nodigt u uit voor een zoete of hartige pauze! In onze vestiging kunt u een grote hoeveelheid brood, maar ook zoetwaren kopen."
    ],
    "es": [
      "Nuestra panadería le invita a una pausa dulce o salada En nuestro establecimiento, podrá comprar una gran cantidad de pan, pero también productos de confitería."
    ]
  },
