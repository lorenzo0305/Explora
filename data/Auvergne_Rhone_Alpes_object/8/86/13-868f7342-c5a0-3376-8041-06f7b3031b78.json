  "rdfs:comment": {
    "de": [
      "Fabienne, Stéphane und ihr Team bieten Ihnen in geselliger Runde und in einem authentischen Rahmen traditionelle savoyische Küche: Fleisch, Fondues, Raclette, Reblochonade..."
    ],
    "en": [
      "Fabienne, Stéphane and their team warmly welcome you in an authentic setting, offering traditional Savoyard cuisine: meats, fondues, raclettes, reblochonade, and more."
    ],
    "it": [
      "Fabienne, Stéphane e il loro team vi propongono una cucina tradizionale savoiarda in un ambiente accogliente e autentico: carne, fondute, raclettes, reblochonade..."
    ],
    "fr": [
      "Fabienne, Stéphane et leur équipe vous proposent en toute convivialité et dans un cadre authentique une cuisine traditionnelle savoyarde : viandes, fondues, raclettes, reblochonade..."
    ],
    "es": [
      "Fabienne, Stéphane y su equipo le proponen una cocina tradicional saboyana en un marco acogedor y auténtico: carnes, fondues, raclettes, reblochonade..."
    ],
    "nl": [
      "Fabienne, Stéphane en hun team bieden u traditionele Savoyaardse gerechten in een vriendelijke, authentieke omgeving: vlees, fondues, raclettes, reblochonade..."
    ]
  },
