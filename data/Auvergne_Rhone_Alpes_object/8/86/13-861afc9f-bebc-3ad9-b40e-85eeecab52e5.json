  "rdfs:comment": {
    "de": [
      "Der Holzdreher Roger Marey und der Marker Adrien Pagneux öffnen Ihnen die Türen ihrer Werkstätten. Zögern Sie nicht, vorher anzurufen."
    ],
    "en": [
      "Roger Marey, woodturner and Adrien Pagneux, marker, open the doors of their workshop. Do not hesitate to call beforehand."
    ],
    "it": [
      "Roger Marey, tornitore del legno, e Adrien Pagneux, disegnatore, aprono le porte del loro laboratorio. Non esitate a chiamare prima."
    ],
    "fr": [
      "Roger Marey, tourneur sur bois et Adrien Pagneux marqueteur, vous ouvrent les portes de leur atelier. N'hésitez pas à appeler au préalable."
    ],
    "es": [
      "Roger Marey, tornero, y Adrien Pagneux, rotulador, abren las puertas de su taller. No dude en llamar antes."
    ],
