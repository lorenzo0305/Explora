  "rdfs:comment": {
    "de": [
      "Entdecken Sie DIE gastronomische Spezialität der Bresse: die Quenelles GIRAUDET, die mit Bressebutter AOP hergestellt und seit 1910 mit demselben handwerklichen Können mit dem Löffel geformt werden. Klassische und originelle Rezepte der Saison, die Sie einfach zu Hause nachkochen können!"
    ],
    "en": [
      "Discover THE gastronomic specialty of Bresse: GIRAUDET quenelles, made with Bresse PDO butter and spoon-molded with the same artisan know-how since 1910. Classic and original seasonal recipes for simple home cooking!"
    ],
    "it": [
      "Scoprite la specialità gastronomica della Bresse: le quenelles GIRAUDET, preparate con burro di Bresse DOP e modellate al cucchiaio con lo stesso savoir-faire tradizionale dal 1910. Ricette stagionali classiche e originali, facili da preparare a casa!"
    ],
    "fr": [
      "Découvrez LA spécialité gastronomique bressane : les quenelles GIRAUDET, au beurre de Bresse AOP et moulées à la cuillère avec le même savoir-faire artisanal depuis 1910. Des recettes de saison, classiques et originales, à cuisiner simplement chez soi!"
    ],
    "nl": [
      "Ontdek DE gastronomische specialiteit van Bresse: GIRAUDET quenelles, gemaakt met Bresse BOB boter en lepelgebakken met dezelfde traditionele knowhow sinds 1910. Klassieke en originele seizoensrecepten die gemakkelijk thuis te bereiden zijn!"
    ],
    "es": [
      "Descubra LA especialidad gastronómica de Bresse: las quenelles GIRAUDET, elaboradas con mantequilla de Bresse DOP y moldeadas con cuchara con el mismo saber hacer tradicional desde 1910. Recetas de temporada clásicas y originales, ¡fáciles de preparar en casa!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Maison Giraudet"
    ],
    "fr": [
      "Maison Giraudet"
    ]
  },
