  "rdfs:comment": {
    "de": [
      "Handgefertigte Keramik, die Sie sich selbst schenken oder verschenken können. Handgefertigt in der Ardèche. Ein Hauch von Poesie, um Ihr Leben zu verschönern! Einführungsworkshops für Erwachsene und Kinder."
    ],
    "en": [
      "Hand-crafted ceramics for yourself or as a gift. Handmade in the Ardèche. A touch of poetry to brighten up your life! Introductory workshops for adults and children."
    ],
    "it": [
      "Ceramiche fatte a mano da offrire o regalare. Realizzato a mano in Ardèche. Un tocco di poesia per abbellire le vostre vite! Laboratori di iniziazione per adulti e bambini."
    ],
    "fr": [
      "Céramiques artisanales à s'offrir ou à offrir. Fabriquées à la main en Ardèche. Un brin de poésie pour embellir vos vies ! Ateliers initiations adulte et enfant."
    ],
    "nl": [
      "Handgemaakte keramiek om aan te bieden of om cadeau te geven. Handgemaakt in de Ardèche. Een vleugje poëzie om uw leven te verfraaien! Inwijdingsworkshops voor volwassenen en kinderen."
    ],
    "es": [
      "Cerámica artesanal para ofrecer o regalar. Hecho a mano en Ardèche. ¡Un toque de poesía para embellecer sus vidas! Talleres de iniciación para adultos y niños."
    ]
  },
