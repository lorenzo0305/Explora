  "rdfs:comment": {
    "de": [
      "Tauche ein in das Herz der Geheimnisse und der Spannung und verbünde dich mit Madame de Sévigné, um das Geheimnis von Versailles zu lüften!  Ein Spiel zwischen Fiktion und Realität? Nehmen Sie die Herausforderung an und führen Sie die Ermittlungen!"
    ],
    "en": [
      "Plunge into the heart of mystery and suspense and join forces with Madame de Sévigné to discover the secret of Versailles!  A game between fiction and reality? Take up the challenge and lead the investigation A game of clues and riddles to make you dream a little."
    ],
    "it": [
      "Immergetevi nel cuore del mistero e della suspense e unitevi a Madame de Sévigné per scoprire il segreto di Versailles!  Un gioco tra finzione e realtà? Accettate la sfida e guidate l'indagine Un gioco di indizi e indovinelli per aiutarvi a sognare un po'."
    ],
    "fr": [
      "Plongez au coeur des mystères et du suspense et faites alliance avec Madame de Sévigné pour découvrir le secret de Versailles !  Un jeu entre fiction et réalité… Relevez le défi et menez l’enquête  Jeu de piste et d'énigmes pour rêver un peu."
    ],
    "es": [
      "Sumérgete en el corazón del misterio y el suspense y une tus fuerzas a las de Madame de Sévigné para descubrir el secreto de Versalles  ¿Un juego entre ficción y realidad? Acepte el reto y dirija la investigación Un juego de pistas y acertijos para ayudarle a soñar un poco."
    ],
    "nl": [
      "Duik in het hart van mysterie en spanning en bundel je krachten met Madame de Sévigné om het geheim van Versailles te ontdekken!  Een spel tussen fictie en werkelijkheid? Ga de uitdaging aan en leid het onderzoek Een spel met aanwijzingen en raadsels om een beetje te dromen."
    ]
  },
