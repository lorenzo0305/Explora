  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Comptoir du Bois d'Amour! Es liegt mitten auf einem schattigen Pfad mit einem herrlichen Blick auf den See. Genießen Sie einen Snack direkt am Wasser, eine wahre Oase der Ruhe."
    ],
    "en": [
      "Discover Le Comptoir du Bois d'Amour! Located in the middle of a shady path with a magnificent view of the lake. Enjoy a waterside snack, a true haven of peace."
    ],
    "it": [
      "Scoprite il Comptoir du Bois d'Amour! Situato al centro di un sentiero ombreggiato con una magnifica vista sul lago. Godetevi uno spuntino in riva al lago, una vera oasi di pace."
    ],
    "fr": [
      "Découvrez Le Comptoir du Bois d'Amour ! Situé en plein sentier ombragé avec une magnifique vue sur le lac. Profitez d'un snack au bord de l'eau, un véritable havre de paix."
    ],
    "es": [
      "¡Descubra Le Comptoir du Bois d'Amour! Situado en medio de un sendero sombreado con una magnífica vista del lago. Disfrute de un aperitivo a orillas del agua, un auténtico remanso de paz."
    ],
    "nl": [
      "Ontdek Le Comptoir du Bois d'Amour! Gelegen in het midden van een schaduwrijk pad met een prachtig uitzicht op het meer. Geniet van een hapje aan het water, een echte oase van rust."
    ]
  },
