  "rdfs:comment": {
    "de": [
      "Eine Blase der Entspannung, geschützt vor Blicken in einem warmen Rahmen, finden Sie im Spa du Bailliage in Salers (Sauna, Hammam, Whirlpool, Schwimmhalle, Sinnesdusche, Balneo, Kräutertee)"
    ],
    "en": [
      "Do you want a moment of serenity in a cosy environment dedicated to your well being? You will quickly find what you are looking for here in an atmosphere combining music, perfume, and soft lighting."
    ],
    "it": [
      "Un'oasi di relax in un ambiente caldo e accogliente, la spa di Le Bailliage a Salers (sauna, hammam, vasca idromassaggio, corridoio per nuotare, doccia sensoriale, balneoterapia, tisaneria)"
    ],
    "fr": [
      "Une bulle de détente à l'abri des regards dans un cadre chaleureux, retrouvez le spa du Bailliage à Salers (Sauna, Hammam, bain à remous, Couloir de nage, douche sensorielle, balnéo, tisanerie.)"
    ],
    "es": [
      "Un remanso de relajación en un entorno cálido y acogedor, el spa de Le Bailliage en Salers (sauna, hammam, bañera de hidromasaje, pasillo de natación, ducha sensorial, balneoterapia, sala de tisanas)"
    ],
    "nl": [
      "Een oase van ontspanning in een warme en gastvrije omgeving, de spa van Le Bailliage in Salers (sauna, hammam, bubbelbad, zwemgang, zintuiglijke douche, balneotherapie, kruidentheesalon)"
    ]
  },
  "rdfs:label": {
    "en": [
      "SPA \"Calme et Volupté\" - well-being"
    ],
    "fr": [
      "SPA \"Le Bailliage\""
    ]
