  "rdfs:comment": {
    "de": [
      "Dieses Hotel befindet sich in der Nähe zum Stadtzentrum Lyons und bietet Ihnen seine geräumigen und komfortablen Zimmer an. Auf Geschäftsreise oder im Kurzurlaub können Sie vom Schwimmbad und der Terrasse profitieren."
    ],
    "en": [
      "This hotel, situated close to Lyon city centre, offers a range of spacious and comfortable guest rooms. Whether you stay for business or pleasure, take full advantage of our pool and terrace."
    ],
    "it": [
      "Questo hotel situato nelle vicinanze del centro di Lione ti offre le sue spaziose camere dotate di ogni comfort. In viaggio di lavoro o di piacere potrai goderti la piscina e la terrazza."
    ],
    "fr": [
      "Cet hôtel situé à proximité du centre ville de Lyon vous offre ses chambres spacieuses et confortables. En voyage d'affaires ou de loisirs, vous pourrez profiter de la piscine et de la terrasse."
    ],
    "es": [
      "Este hotel situado cerca del centro urbano de Lyon ofrece habitaciones espaciosas y cómodas. Un establecimiento ideal tanto para estancias de negocios como de ocio, que cuenta también con una piscina y una terraza."
    ],
    "nl": [
      "Dit hotel ligt vlak bij het centrum van Lyon en biedt ruime en comfortabele kamers. Of u nu voor zaken of plezier reist, u kunt genieten van het zwembad en het terras."
    ]
  },
