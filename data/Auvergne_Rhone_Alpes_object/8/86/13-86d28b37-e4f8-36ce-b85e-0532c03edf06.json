  "rdfs:comment": {
    "de": [
      "PIERROT LUNAIRE wurde 1912 von der berühmten Berliner Kabarettistin Albertine Zehme bei dem österreichischen Komponisten Arnold Schönberg in Auftrag gegeben und ist ein in vielerlei Hinsicht verwirrendes Werk, das in einer technologischen Umgebung inszeniert wird."
    ],
    "en": [
      "Commissioned from Austrian composer Arnold Schönberg in 1912 by the famous Berlin cabaret performer Albertine Zehme, PIERROT LUNAIRE is a puzzling work in more ways than one, staged in a technological environment."
    ],
    "it": [
      "Commissionato al compositore austriaco Arnold Schönberg nel 1912 dalla famosa cabarettista berlinese Albertine Zehme, PIERROT LUNAIRE è un'opera sconcertante sotto più aspetti, ambientata in un ambiente tecnologico."
    ],
    "fr": [
      "Commandée au compositeur autrichien Arnold Schönberg en 1912 par la célèbre diseuse de cabaret berlinoise Albertine Zehme, PIERROT LUNAIRE est une œuvre déroutante à plus d’un titre, mise en scène dans un environnement technologique."
    ],
    "nl": [
      "PIERROT LUNAIRE werd in 1912 in opdracht van de Oostenrijkse componist Arnold Schönberg geschreven door de beroemde Berlijnse cabaretière Albertine Zehme. Het is in meerdere opzichten een onthutsend werk dat zich afspeelt in een technologische omgeving."
    ],
    "es": [
      "Encargada al compositor austriaco Arnold Schönberg en 1912 por la famosa cabaretera berlinesa Albertine Zehme, PIERROT LUNAIRE es una obra desconcertante en más de un sentido, ambientada en un entorno tecnológico."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert augmenté avec les solistes du conservatoire"
    ]
  },
