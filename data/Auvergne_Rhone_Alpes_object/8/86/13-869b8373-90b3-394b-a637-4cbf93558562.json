  "rdfs:comment": {
    "de": [
      "Traditionelle, einfallsreiche und großzügige Küche, die von unseren kleinen Händen mit Sorgfalt zubereitet wird. Frische und saisonale Produkte. Vegetarier willkommen."
    ],
    "en": [
      "Traditional, creative and generous cooking, prepared with care by our own hands. Fresh and seasonal products. Vegetarians welcome."
    ],
    "it": [
      "Una cucina tradizionale, inventiva e generosa, preparata con cura dalle nostre manine. Prodotti freschi e di stagione. I vegetariani sono i benvenuti."
    ],
    "fr": [
      "Cuisine traditionnelle, inventive et généreuse, préparée avec soins par nos petites mains. Produits frais et de saison. Végétariens bienvenus."
    ],
    "nl": [
      "Traditionele, rijke en inventieve gerechten, door ons met zorg bereid. Verse seizoensproducten."
    ],
    "es": [
      "Cocina tradicional, inventiva y generosa, preparada con esmero por nuestras pequeñas manos. Productos frescos y de temporada. Los vegetarianos son bienvenidos."
    ]
  },
