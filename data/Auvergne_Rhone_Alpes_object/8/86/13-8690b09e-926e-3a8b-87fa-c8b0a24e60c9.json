  "rdfs:comment": {
    "de": [
      "Dieses Kinozentrum bietet 11 Säle mit modernster filmtechnischer Ausstattung."
    ],
    "en": [
      "Find out what films are on screen at Archamps’ Pathé Cinema. Experience total immersion in the only IMAX LASER screen in the region."
    ],
    "it": [
      "Situato tra Annemasse e Saint-Julien, il cinema Pathé Archamps vi invita a vivere appieno le vostre emozioni! Approfittate dell'opportunità di scoprire l'esperienza IMAX Laser. Prima o dopo la proiezione, prolungate la vostra esperienza negli spazi conviviali..."
    ],
    "fr": [
      "Situé entre Annemasse et Saint-Julien, le cinéma Pathé Archamps vous propose de vivre vos émotions intensément ! Profitez-en pour découvrir l’expérience IMAX Laser. Avant ou après votre séance, prolongez votre expérience dans les espaces conviviaux..."
    ],
    "es": [
      "Situado entre Annemasse y Saint-Julien, el cine Pathé Archamps le invita a vivir plenamente sus emociones. Aproveche la ocasión para descubrir la experiencia IMAX Láser. Antes o después de su proyección, prolongue su experiencia en los espacios de convivencia..."
    ],
    "nl": [
      "De bioscoop Pathé Archamps, gelegen tussen Annemasse en Saint-Julien, biedt u de mogelijkheid om uw emoties intens te beleven! Maak van de gelegenheid gebruik om de IMAX Laser ervaring te ontdekken. Voor of na uw vertoning kunt u uw ervaring uitbreiden in de gezellige ruimtes..."
    ]
  },
