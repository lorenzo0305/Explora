  "rdfs:comment": {
    "de": [
      "Engagiertes Café Art Concert in Bilieu am Ufer des Lac de Paladru mit Konzerten, Ausstellungen, Workshops und Veranstaltungen für Groß und Klein. Geselliger und intimer Ort, um sich zu treffen, auszutauschen und im Rhythmus der Kreativität und der Natur zu schwingen."
    ],
    "en": [
      "Café Art Concert engagé, in Bilieu, on the shores of Lac de Paladru, offering concerts, exhibitions, workshops and events for young and old. A friendly, intimate place to meet, exchange ideas and vibrate to the rhythm of creativity and nature."
    ],
    "it": [
      "Il Café Art Concert di Bilieu, sulle rive del lago Paladru, offre concerti, mostre, laboratori ed eventi per tutte le età. È un luogo intimo e amichevole dove incontrarsi, chiacchierare e vibrare al ritmo della creatività e della natura."
    ],
    "fr": [
      "Café Art Concert engagé, à Bilieu, au bord du Lac de Paladru, proposant concerts, expositions, ateliers et événements pour petits et grands. Lieu convivial et intimiste pour se retrouver, échanger et vibrer au rythme de la créativité et de la nature."
    ],
    "nl": [
      "Café Art Concert in Bilieu, aan de oevers van het Paladru-meer, biedt concerten, tentoonstellingen, workshops en evenementen voor alle leeftijden. Het is een gezellige, intieme plek waar je elkaar kunt ontmoeten, kletsen en vibreren op het ritme van creativiteit en natuur."
    ],
    "es": [
      "Café Art Concert de Bilieu, a orillas del lago Paladru, ofrece conciertos, exposiciones, talleres y eventos para todas las edades. Es un lugar acogedor e íntimo donde reunirse, charlar y vibrar al ritmo de la creatividad y la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Café des Eaux Sauvages"
    ]
  },
