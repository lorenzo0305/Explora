  "rdfs:comment": {
    "de": [
      "Um Körper und Geist zur Ruhe zu bringen, bietet Ihnen das Spa des Hotels MiL8 in seinem vollständig verglasten Bereich mit Außenpool und Sauna Behandlungen und Massagen à la carte an."
    ],
    "en": [
      "To put your body and mind at rest, the MiL8 hotel's Spa offers treatments and massages in its fully glazed area with outdoor pool and sauna."
    ],
    "it": [
      "Per riposare la mente e il corpo, la MiL8 Spa offre una gamma di trattamenti e massaggi nella sua area completamente vetrata con piscina all'aperto e sauna."
    ],
    "fr": [
      "Pour mettre corps et esprit au repos, le Spa de l'hôtel MiL8 vous propose des soins et des massages à la carte dans son espace totalement vitré avec piscine extérieure et sauna."
    ],
    "es": [
      "Para que su mente y su cuerpo descansen, el Spa MiL8 le ofrece una serie de tratamientos y masajes en su zona totalmente acristalada con piscina exterior y sauna."
    ],
    "nl": [
      "Om uw lichaam en geest tot rust te brengen, biedt de MiL8 Spa u een scala aan behandelingen en massages in de volledig beglaasde ruimte met buitenzwembad en sauna."
    ]
  },
