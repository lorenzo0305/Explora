  "rdfs:comment": {
    "de": [
      "Inmitten eines 10 Hektar großen Parks zwischen See und Bergen empfängt Sie das Mercure Aix-les-Bains Domaine de Marlioz für Ihre Geschäfts- oder Freizeitreisen."
    ],
    "en": [
      "In the middle of a 10-hectare park between the lake and the mountains, the Mercure Hotel in Aix-les-Bains welcomes you for your business or leisure trips."
    ],
    "it": [
      "Ubicato nel parco di 10 ettari tra il lago e le montagne, il Mercure Aix-les-Bains vi accoglie per i vostri soggiorni d'affari o di piacere."
    ],
    "fr": [
      "Au cœur d'un parc de 10 hectares entre lac et montagnes, le Mercure Aix-les-Bains Domaine de Marlioz vous accueille pour vos séjours d'affaires ou de loisirs."
    ],
    "nl": [
      "In het hart van een park van 10 hectare tussen het meer en de bergen verwelkomt het Mercure Aix-les-Bains Domaine de Marlioz u voor een zakelijk of toeristisch verblijf."
    ],
    "es": [
      "En el corazón de un parque de 10 hectáreas entre lago y montañas, el Mercure Aix-les-Bains Domaine de Marlioz le da la bienvenida para sus estancias de negocios o de ocio."
    ]
  },
