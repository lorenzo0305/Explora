  "rdfs:comment": {
    "de": [
      "Kalksteinfelsen mit Vorkommen von Quarzit, 15 bis 150 m hoch.\r\nDieser Ort bietet große Möglichkeiten in einem Niveau von Routen 6a / 7c. Es ist eine Hochburg des Klettersports in der Tarentaise."
    ],
    "en": [
      "Limestone cliffs with quartzite, from 15 to 150m high.\r\nThis site offers great potential for 6a / 7c routes. It's a Mecca for climbing in the Tarentaise region."
    ],
    "it": [
      "Rocce calcaree con quarzite, alte da 15 a 150 metri.\r\nQuesto sito offre grandi possibilità di vie di livello 6a / 7c. È una mecca dell'arrampicata in Tarentaise."
    ],
    "fr": [
      "Falaises calcaires avec présence de quartzite, de 15  à 150m de haut.\r\nCe site offre de grandes possibilités dans un niveau de voies 6a /  7c. C'est un haut lieu de l'escalade en Tarentaise."
    ],
    "nl": [
      "Kalksteenrotsen met kwartsiet, van 15 tot 150m hoog.\r\nDeze site biedt grote mogelijkheden in een niveau van routes 6a / 7c. Het is een mekka voor het klimmen in de Tarentaise."
    ],
    "es": [
      "Acantilados calcáreos con cuarcita, de 15 a 150 m de altura.\r\nEste sitio ofrece grandes posibilidades en un nivel de rutas 6a / 7c. Es una meca de la escalada en la Tarentaise."
    ]
  },
  "rdfs:label": {
    "en": [
      "Rock Climbing at Saint Antoine bridge"
    ],
    "fr": [
      "Voie d'escalade  Pont Saint Antoine"
    ]
  },
