  "rdfs:comment": {
    "de": [
      "Dieser über 700 Jahre alte Kanal ist in der warmen Jahreszeit immer in Betrieb und bietet einen netten schattigen Weg, der an heißen Tagen ideal ist."
    ],
    "en": [
      "Always in use in the warmer months, this 700-year-old canal offers a pleasant shady trail, ideal for hot weather."
    ],
    "it": [
      "Ancora in uso nei mesi più caldi, questo canale di 700 anni offre un piacevole percorso ombreggiato, ideale per la stagione calda."
    ],
    "fr": [
      "Toujours en service à la saison chaude, ce canal vieux de plus de 700 ans offre un sympathique parcours ombragé, idéal lorsqu'il fait chaud."
    ],
    "nl": [
      "Het kanaal wordt nog altijd gebruikt tijdens de warme zomermaanden, meer als 700 jaar oud een aangename tocht in de schaduw, mooi maar sportief !"
    ],
    "es": [
      "Aún en uso en los meses más cálidos, este canal de 700 años de antigüedad ofrece un agradable recorrido sombreado, ideal para el tiempo caluroso."
    ]
  },
