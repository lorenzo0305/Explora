  "rdfs:comment": {
    "de": [
      "Die Animationsabteilung der Gemeinde Albiez-Montrond bietet Ihnen während der Saison jede Woche ein komplettes Animationsprogramm für alle Altersgruppen an. Das vollständige Programm finden Sie im Tourismusbüro oder auf dessen Website."
    ],
    "en": [
      "Albiez-Montrond's entertainment department offers a full program of activities for all ages, every week of the season. Find the full program at the tourist office or on the website."
    ],
    "it": [
      "Ogni settimana, durante la stagione, il dipartimento di animazione di Albiez-Montrond offre un programma completo di attività per tutte le età. Il programma completo è disponibile presso l'ufficio turistico o sul sito web."
    ],
    "fr": [
      "Le service animations de la commune d'Albiez-Montrond vous propose chaque semaine, en saison, un programme complet d'animations pour tous les âges. Retrouvez le programme complet à l'office de tourisme ou sur son site Internet."
    ],
    "es": [
      "Todas las semanas de la temporada, el departamento de animación de Albiez-Montrond ofrece un completo programa de actividades para todas las edades. Puede consultar el programa completo en la oficina de turismo o en su sitio web."
    ],
    "nl": [
      "Tijdens het seizoen biedt de animatieafdeling van Albiez-Montrond elke week een uitgebreid activiteitenprogramma voor alle leeftijden. Je vindt het volledige programma bij het toeristenbureau of op de website."
    ]
  },
