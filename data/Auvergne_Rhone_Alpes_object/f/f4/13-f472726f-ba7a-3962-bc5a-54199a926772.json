  "rdfs:comment": {
    "de": [
      "La Coucourde besteht aus mehreren Weilern und bietet markierte Wanderwege, auf denen Sie das alte befestigte Dorf Lachamp mit den Ruinen seiner romanischen Kapelle (12. Jahrhundert) erkunden können. Auf dem Land begleitet Sie der süße Duft der Lavendelfelder bei Ihren Spaziergängen."
    ],
    "en": [
      "Made up of hamlets, La Coucourde offers marked trails to explore the ancient fortified village of Lachamp and the ruins of its Romanesque chapel (12th century). In the countryside, the sweet scent of lavender fields accompanies your walks."
    ],
    "it": [
      "Composta da frazioni, La Coucourde offre percorsi segnalati per esplorare l'antico villaggio fortificato di Lachamp con le rovine della sua cappella romanica (XII secolo). In campagna, il dolce profumo dei campi di lavanda accompagna le vostre passeggiate."
    ],
    "fr": [
      "Constituée de hameaux, La Coucourde propose ses sentiers balisés permettant d’explorer l’ancien village fortifié de Lachamp avec les ruines de sa chapelle romane (XIIe siècle). Dans la campagne, la douce odeur des champs de lavande accompagne vos balades."
    ],
    "nl": [
      "La Coucourde bestaat uit een aantal gehuchten, met bewegwijzerde wandelpaden die leiden naar het oude versterkte dorp Lachamp en de ruïnes van de Romaanse kapel (12e eeuw). Op het platteland begeleidt de zoete geur van lavendelvelden je wandelingen."
    ],
    "es": [
      "Formado por aldeas, La Coucourde ofrece senderos marcados para explorar el antiguo pueblo fortificado de Lachamp con las ruinas de su capilla románica (siglo XII). En el campo, el dulce olor de los campos de lavanda acompaña sus paseos."
    ]
  },
