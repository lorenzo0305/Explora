  "rdfs:comment": {
    "de": [
      "Im Rahmen des \"Printemps des Poètes\" kann jeder einen Text seiner Wahl zum Thema \"La Liberté, force vive déployée\" (Die Freiheit, eine entfaltete lebendige Kraft) vorlesen."
    ],
    "en": [
      "As part of the \"Printemps des Poètes\" festival, everyone can read a text of their choice, on the theme of \"La Liberté, force vive déployée\"."
    ],
    "it": [
      "Nell'ambito del \"Printemps des Poètes\" (Festival della Poesia di Primavera), tutti potranno leggere un testo a scelta sul tema \"La Liberté, force vive déployée\"."
    ],
    "fr": [
      "Dans le cadre du \"Printemps des Poètes\", chacun peut lire un texte de son choix, sur le thème \"La Liberté, force vive déployée\"."
    ],
    "nl": [
      "In het kader van de \"Printemps des Poètes\" (Lentepoëziefestival) kan iedereen een tekst naar keuze lezen over het thema \"La Liberté, force vive déployée\"."
    ],
    "es": [
      "En el marco del \"Printemps des Poètes\" (Festival de Poesía de Primavera), todo el mundo podrá leer un texto de su elección sobre el tema \"La Liberté, force vivante déployée\"."
    ]
  },
  "rdfs:label": {
