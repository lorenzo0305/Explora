  "rdfs:comment": {
    "de": [
      "Das Espace 600 ist sowohl ein offenes Theater für zeitgenössische Jugendkunst als auch ein Theater, in dem junge Theatergruppen entdeckt werden können. Das ganze Jahr über stehen Aufführungen für Groß und Klein sowie Workshops auf dem Programm."
    ],
    "en": [
      "Discover Espace 600 in Grenoble, the scene dedicated to children and young people: shows, theater, workshops and much more, from the earliest age and for a lifetime!"
    ],
    "it": [
      "Scoprite l'Espace 600 di Grenoble, la scena dedicata ai bambini e ai giovani: spettacoli, teatro, laboratori e molto altro, fin dalla più tenera età e per tutta la vita!"
    ],
    "fr": [
      "Découvrez l'Espace 600 à Grenoble, la scène dédiée à l'enfance et à la jeunesse : spectacles, théâtre, ateliers et bien d'autres choses encore, dès le plus jeune âge et pour toute la vie !"
    ],
    "nl": [
      "Ontdek de Espace 600 in Grenoble, de scène gewijd aan kinderen en jongeren: voorstellingen, theater, workshops en nog veel meer, van jongs af aan en levenslang!"
    ],
    "es": [
      "Espace 600 es a la vez un teatro abierto a la creación contemporánea para los jóvenes y un teatro de descubrimiento de jóvenes compañías. Durante todo el año se programan espectáculos para grandes y pequeños y talleres."
    ]
  },
