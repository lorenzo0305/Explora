  "rdfs:comment": {
    "de": [
      "Restaurant, Lebensmittelgeschäft, Bar. Einheimische und freundliche Gaststätte. Bei uns können Sie die echte spanische \"Mama\"-Küche probieren: Großmutters Rezepte, kulinarische Versuche, spanische und katalanische Aromen?"
    ],
    "en": [
      "Restaurant, grocery store, bar. Local and friendly. Here, you'll taste real Spanish \"mama\" cuisine: grandma's recipes, culinary trials, Spanish and Catalan flavors?"
    ],
    "it": [
      "Ristorante, negozio di alimentari, bar. Locale e accogliente. Qui potrete assaggiare la vera cucina spagnola \"mama\": ricette della nonna, esperimenti culinari, sapori spagnoli e catalani?"
    ],
    "fr": [
      "Restaurant, épicerie, bar. Établissement local et convivial. Chez nous, vous goûterez à la véritable cuisine de \"mama\" espagnole : recettes de grand-mère, essais culinaires, saveurs espagnoles et catalanes…"
    ],
    "es": [
      "Restaurante, tienda de comestibles, bar. Local y acogedor. Aquí podrá degustar la auténtica cocina \"mama\" española: recetas de la abuela, experimentos culinarios, sabores españoles y catalanes.."
    ],
    "nl": [
      "Restaurant, kruidenierswinkel, bar. Lokaal en vriendelijk. Hier kun je de echte Spaanse \"mama\"-keuken proeven: grootmoeders recepten, culinaire experimenten, Spaanse en Catalaanse smaken?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Coq et la Mule"
    ]
  },
