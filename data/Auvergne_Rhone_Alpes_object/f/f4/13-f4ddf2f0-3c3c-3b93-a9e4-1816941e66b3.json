  "rdfs:comment": {
    "de": [
      "Wir befinden uns in Saint-Floret in einer der \"Petites Cités de Caractère\" und heißen Sie von Anfang April bis Ende September herzlich willkommen. Von April bis Ende September finden täglich außer montags kostenlose, kommentierte Besichtigungen statt, für die keine Reservierung erforderlich ist."
    ],
    "en": [
      "Located in Saint-Floret, one of the \"Petites Cités de Caractère\", we welcome you from early April to late September. Free guided tours, without reservation, are available every day except Monday from April to the end of September."
    ],
    "it": [
      "A Saint-Floret, una delle \"Petites Cités de Caractère\", vi accogliamo dall'inizio di aprile alla fine di settembre. Le visite guidate gratuite, senza prenotazione, sono disponibili tutti i giorni, tranne il lunedì, da aprile a fine settembre."
    ],
    "fr": [
      "Situé à Saint-Floret dans l'une des \"Petites Cités de Caractère\", nous vous accueillons de début avril jusqu'à fin septembre. Des visites commentées gratuites, sans réservation, ont lieu tous les jours sauf le lundi d'avril à fin septembre."
    ],
    "es": [
      "Situado en Saint-Floret, una de las \"Petites Cités de Caractère\", le damos la bienvenida desde principios de abril hasta finales de septiembre. Las visitas guiadas gratuitas, sin reserva previa, están disponibles todos los días excepto los lunes desde abril hasta finales de septiembre."
    ],
    "nl": [
      "Gelegen in Saint-Floret, een van de \"Petites Cités de Caractère\", verwelkomen we je van begin april tot eind september. Gratis rondleidingen, zonder reservering, elke dag behalve maandag van april tot eind september."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau de tourisme de Saint-Floret - Auvergne Pays d'Issoire"
    ]
  },
