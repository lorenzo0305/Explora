  "rdfs:comment": {
    "de": [
      "Cette fête incontournable met en valeur des traditions locales dont la transhumance des troupeaux de vaches Salers vers les estives. Montée et défilé de troupeaux, marché et présentation des produits du terroir, repas et autres animations de rue."
    ],
    "en": [
      "This not-to-be-missed festival highlights local traditions, including the transhumance of Salers cow herds to summer pastures. Herd rides and parades, local market, meals and street entertainment."
    ],
    "it": [
      "Questo imperdibile festival mette in mostra le tradizioni locali, tra cui la transumanza delle mandrie di mucche di Salers verso gli alpeggi. Cavalcate e sfilate delle mandrie, mercato locale, pasti e intrattenimento di strada."
    ],
    "fr": [
      "Cette fête incontournable met en valeur des traditions locales dont la transhumance des troupeaux de vaches Salers vers les estives. Montée et défilé de troupeaux, marché de terroir, repas et animations de rue."
    ],
    "es": [
      "Esta fiesta ineludible muestra las tradiciones locales, incluida la trashumancia de los rebaños de vacas de Salers a los pastos de montaña. Paseos y desfiles de rebaños, mercado local, comidas y espectáculos callejeros."
    ],
    "nl": [
      "Dit niet te missen festival laat lokale tradities zien, waaronder de transhumance van kuddes Salers-koeien naar de bergweiden. Kudde tochten en parades, lokale markt, maaltijden en straatentertainment."
    ]
  },
  "rdfs:label": {
