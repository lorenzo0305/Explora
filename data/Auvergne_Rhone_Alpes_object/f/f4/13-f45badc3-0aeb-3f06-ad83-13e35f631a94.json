  "rdfs:comment": {
    "de": [
      "Machen Sie eine Pause im Garten von Peylong bei einem Kräutertee, einem Tee oder einem kalten Getränk mit hausgemachtem Gebäck. Leichte Wanderung (1H) in der Nähe. Möglichkeit, die Bio-Weine des Weinguts zu probieren. Spiele für Kinder."
    ],
    "en": [
      "Take a break in Peylong's garden with a herbal tea, tea or cold drink accompanied by homemade pastries. Easy hike (1 hour) nearby. Opportunity to taste the estate's organic wines. Games for children."
    ],
    "it": [
      "Fate una pausa nel giardino di Peylong e gustate una tisana, un tè o una bevanda fredda accompagnata da una pasta fatta in casa. Facile passeggiata (1 ora) nelle vicinanze. Possibilità di degustare i vini biologici della tenuta. Giochi per bambini."
    ],
    "fr": [
      "Faire une pause dans le jardin de Peylong autour d'une tisane, d'un thé ou d'une boisson froide accompagnée d'une patisserie maison. Randonnée facile (1H) à proximité. possibilité de déguster les vins bio du Domaine. Jeux pour enfants."
    ],
    "es": [
      "Tómese un descanso en el jardín Peylong y disfrute de una tisana, té o bebida fría acompañada de un pastel casero. Paseo fácil (1 hora) en las inmediaciones. Posibilidad de degustar los vinos ecológicos de la finca. Juegos para niños."
    ],
    "nl": [
      "Neem een pauze in de Peylong tuin en geniet van een kruidenthee, thee of frisdrank vergezeld van een huisgemaakt gebakje. Gemakkelijke wandeling (1 uur) in de buurt. Mogelijkheid om de biologische wijnen van het landgoed te proeven. Spelletjes voor kinderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salon de thé - Domaine Peylong"
    ]
  },
