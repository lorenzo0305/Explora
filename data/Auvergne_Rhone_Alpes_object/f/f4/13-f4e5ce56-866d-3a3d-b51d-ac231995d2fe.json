  "rdfs:comment": {
    "de": [
      "Kunstzeitschriften, Ausstellungskataloge, Künstlermonografien, Wörterbücher und Essays über die großen Bewegungen der modernen und zeitgenössischen Kunst zum Nachschlagen - oder zum Ausleihen für Personen, die Abonnenten der Artothek und/oder Inhaber des Museumspasses sind."
    ],
    "en": [
      "Art periodicals, exhibition catalogs, monographes, dictionaries and essays regarding the major modern and contemporary art movements can be viewed or  borrowed (for members only)."
    ],
    "it": [
      "Riviste d'arte, cataloghi di mostre, monografie di artisti, dizionari e saggi sui principali movimenti dell'arte moderna e contemporanea sono a disposizione per essere consultati o presi in prestito se si possiede un abbonamento alla biblioteca d'arte e/o una tessera del museo."
    ],
    "fr": [
      "Revues d'art, catalogues d'exposition, monographies d'artistes, dictionnaires et essais sur les grands mouvements de l'art moderne et contemporain à consulter - ou emprunter pour les personnes abonnées à l'artothèque et/ou détenant le pass-musée."
    ],
    "es": [
      "Revistas de arte, catálogos de exposiciones, monografías de artistas, diccionarios y ensayos sobre los principales movimientos del arte moderno y contemporáneo están disponibles para su consulta - o para préstamo si dispone de una suscripción a la biblioteca de arte y/o un pase de museo."
    ],
    "nl": [
      "Kunsttijdschriften, tentoonstellingscatalogi, monografieën van kunstenaars, woordenboeken en essays over de belangrijkste stromingen in de moderne en hedendaagse kunst zijn beschikbaar om te raadplegen - of om te lenen als je een abonnement hebt op de kunstbibliotheek en/of een museumpas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Library of modern and contemporary art"
    ],
    "fr": [
      "Bibliothèque d'art moderne et contemporain"
    ]
  },
