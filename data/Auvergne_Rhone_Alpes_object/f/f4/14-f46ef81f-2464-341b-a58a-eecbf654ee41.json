  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/519c2331-dd49-35a2-9a38-f4a898650174",
      "dc:description": {
        "de": [
          "Die Sternennacht ist wieder da! Sie war letztes Jahr ein voller Erfolg! Open-Air-Kino, Taschenlampenführungen, Sternenbeobachtung und eine Nacht im Zelt? Erleben Sie einen ganz neuen Abend!"
        ],
        "en": [
          "You loved it last year - Starry Night is back! Open-air cinema, torchlight tours, stargazing and a night under the tent? Experience an evening like no other!"
        ],
        "it": [
          "L'anno scorso vi è piaciuta molto, quindi la Notte Stellata è tornata! Cinema all'aperto, visite alla luce delle torce, osservazione delle stelle e una notte in tenda? Vivete una serata senza precedenti!"
        ],
        "fr": [
          "Vous l’avez adorée l’an passé, la Nuit des Étoiles est de retour ! Cinéma en plein air, visites à la lampe torche, observation des étoiles et nuit sous la tente… Vivez une soirée inédite !"
        ],
        "nl": [
          "Vorig jaar vonden jullie het geweldig, dus Starry Night is terug! Openluchtbioscoop, fakkelbezoeken, sterren kijken en een nacht in een tent? Beleef een avond als geen ander!"
        ],
        "es": [
          "El año pasado te encantó, ¡así que vuelve la Noche Estrellada! Cine al aire libre, visitas a la luz de las antorchas, observación de las estrellas y una noche en una tienda de campaña? Viva una velada sin igual"
        ]
      },
      "@type": [
        "Description"
      ],
