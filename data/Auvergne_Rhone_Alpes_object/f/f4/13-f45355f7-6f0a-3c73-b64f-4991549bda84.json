          "additionalInformation": {
            "de": [
              "Juli bis September: Pizza-Abend (Samstagabend), Mittwoch- bis Freitagabend. Juni bis September: Catering.\r\nJanuar bis Juni: Brunch (sonntags); Oktober bis Mai: Essen am Donnerstag- bis Samstagabend."
            ],
            "en": [
              "July to September: Pizza evenings (Saturday evenings), and meals Wednesday to Friday evenings. June to September: catering.\r\nJanuary to June: brunch (Sunday); October to May: meals Thursday to Saturday evenings."
            ],
            "it": [
              "Da luglio a settembre: serate pizza (sabato sera) e pasti dal mercoledì al venerdì sera. Da giugno a settembre: catering.\r\nDa gennaio a giugno: brunch domenicale; da ottobre a maggio: pasti dal giovedì al sabato sera."
            ],
            "fr": [
              "Juillet à Septembre: Soirée pizza (samedi soir), et repas mercredi au vendredi soir. Juin à septembre: traiteur. \r\nJanvier à juin: brunch (le dimanche); Octobre à Mai: repas jeudi au samedi soirs."
            ],
            "nl": [
              "Juli tot september: pizza-avonden (zaterdagavond) en maaltijden van woensdag- tot vrijdagavond. Juni tot september: catering.\r\nJanuari tot juni: brunch op zondag; oktober tot mei: maaltijden van donderdag- tot zaterdagavond."
            ],
            "es": [
              "De julio a septiembre: noches de pizza (sábados por la noche) y comidas de miércoles a viernes por la noche. De junio a septiembre: catering.\r\nDe enero a junio: brunch dominical; de octubre a mayo: cenas de jueves a sábado."
            ]
          },
