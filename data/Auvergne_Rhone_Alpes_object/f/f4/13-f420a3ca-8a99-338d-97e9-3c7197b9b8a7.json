  "rdfs:comment": {
    "de": [
      "Die Université Indépendante de Vichy (U.I.V.) ist eine kulturelle Vereinigung mit 1400 Mitgliedern, deren Ziel es ist, den Zugang zu Wissen für alle zu erleichtern, zu fördern, zu dynamisieren und zu teilen!"
    ],
    "en": [
      "With its 1400 members, the Université Indépendante de Vichy (U.I.V.) is a cultural association whose aim is to facilitate, encourage, energize and share access to knowledge for all!"
    ],
    "it": [
      "Con i suoi 1400 membri, l'Université Indépendante de Vichy (U.I.V.) è un'associazione culturale il cui obiettivo è facilitare, incoraggiare, stimolare e condividere l'accesso alla conoscenza per tutti!"
    ],
    "fr": [
      "Forte de ses 1400 adhérents, l’Université Indépendante de Vichy (U.I.V.) est une association culturelle qui a pour but de faciliter, encourager, dynamiser, partager l’accès à la connaissance pour tous !"
    ],
    "nl": [
      "Met zijn 1400 leden is de Université Indépendante de Vichy (U.I.V.) een culturele vereniging die als doel heeft de toegang tot kennis voor iedereen te vergemakkelijken, aan te moedigen, te stimuleren en te delen!"
    ],
    "es": [
      "Con sus 1.400 miembros, la Universidad Independiente de Vichy (U.I.V.) es una asociación cultural cuyo objetivo es facilitar, fomentar, estimular y compartir el acceso al conocimiento para todos"
    ]
  },
