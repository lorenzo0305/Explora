  "rdfs:comment": {
    "de": [
      "Mediathek des Netzwerks Valence Romans Agglo - einheitliche Karte für die 13 Mediatheken des Netzwerks - freier und kostenloser Zugang für alle - Ausleihe von Dokumenten nach Anmeldung kostenlos für Kinder / kostenpflichtig für Erwachsene."
    ],
    "en": [
      "Library in the Valence Romans Agglo network - a single card for all 13 media libraries in the network - free access for all - loan of documents on registration - free for children / paying for adults."
    ],
    "it": [
      "Mediateca della rete Valence Romans Agglo - un'unica tessera per tutte le 13 mediateche della rete - accesso gratuito per tutti - prestito di documenti su iscrizione - gratuito per i bambini / a pagamento per gli adulti."
    ],
    "fr": [
      "Médiathèque du réseau Valence Romans Agglo - carte unique pour les 13 médiathèques du réseau - accès libre et gratuit pour tous - prêt de documents sur inscription gratuite pour les enfants / payante pour les adultes."
    ],
    "nl": [
      "Mediatheek in het netwerk Valence Romans Agglo - één kaart voor alle 13 mediatheken in het netwerk - gratis toegang voor iedereen - uitlenen van documenten bij inschrijving - gratis voor kinderen / betalend voor volwassenen."
    ],
    "es": [
      "Mediateca de la red Valence Romans Agglo - un carné único para las 13 mediatecas de la red - acceso gratuito para todos - préstamo de documentos previa inscripción - gratuito para los niños / de pago para los adultos."
    ]
