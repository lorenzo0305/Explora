  "rdfs:comment": {
    "de": [
      "Das Edelweiss wechselt den Besitzer!\r\nDie 23 geräumigen und komfortablen Zimmer sind eine Mischung aus Holz und Naturtönen mit allen Annehmlichkeiten und Dienstleistungen, die einer internationalen Einrichtung würdig sind."
    ],
    "en": [
      "Welcome to the newly-renovated Edelweiss Hotel! \r\nStay in one of our warm cozy rooms."
    ],
    "it": [
      "L'Edelweiss è di nuova proprietà!\r\nLe 23 camere, spaziose e confortevoli, combinano legno e toni naturali con tutte le strutture e i servizi degni di una struttura internazionale."
    ],
    "fr": [
      "L’Edelweiss change de propriétaires ! \r\nLes 23 chambres, spacieuses et confortables, mélangent bois et tons naturels avec tous les équipements et services dignes d’un établissement international."
    ],
    "es": [
      "¡Estamos renovando el Edelweiss para darte la bienvenida! \r\nLas 23 habitaciones amplias y confortables combinan la madera y los tonos naturales con todas las instalaciones y servicios dignos de un establecimiento internacional."
    ],
    "nl": [
      "L'Edelweiss is in nieuwe handen!\r\nDe 23 ruime, comfortabele kamers combineren hout en natuurlijke tinten met alle faciliteiten en diensten die een internationaal etablissement waardig zijn."
    ]
  },
