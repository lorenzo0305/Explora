  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Bibliothek von Montagny, die Ihnen eine große Auswahl an Jugend- und Erwachsenendokumenten zum Ausleihen oder Lesen vor Ort sowie Veranstaltungen für alle Altersgruppen bietet."
    ],
    "en": [
      "Come and discover the Montagny library, which offers a wide range of children's and adult literature to borrow or read on site, as well as events for the general public."
    ],
    "it": [
      "Venite a scoprire la biblioteca di Montagny, che offre un'ampia scelta di letteratura per bambini e adulti da prendere in prestito o da leggere in loco, oltre a eventi per il pubblico in generale."
    ],
    "fr": [
      "Venez découvrir la bibliothèque de Montagny qui vous propose un large choix de documents jeunesse et adultes à emprunter ou à lire sur place ainsi que des animations tout public."
    ],
    "es": [
      "Venga a descubrir la biblioteca de Montagny, que ofrece una amplia gama de literatura infantil y para adultos para tomar prestada o leer in situ, así como eventos para el público en general."
    ],
    "nl": [
      "Kom en ontdek de bibliotheek van Montagny, die een breed aanbod aan literatuur voor kinderen en volwassenen biedt om te lenen of ter plekke te lezen, evenals evenementen voor het grote publiek."
    ]
  },
  "rdfs:label": {
