  "rdfs:comment": {
    "de": [
      "Das Assois Fées empfängt Sie in einer Retro-/Pin-up-Atmosphäre: Bar, Billard, Tischfußball, Darts. Wir bieten Snacks für den kleinen Hunger zwischendurch und Gläser, die von einem lokalen Caterer mit Sorgfalt zubereitet werden und die Sie vor Ort genießen oder mitnehmen können!"
    ],
    "en": [
      "L'Assois Fées welcomes you in a retro/pin-up atmosphere: bar, pool table, table soccer, darts. We also offer snacks and jars carefully prepared by a local caterer, which you can eat in or take away!"
    ],
    "it": [
      "L'Assois Fées vi accoglie in un'atmosfera retro/pin-up: bar, tavolo da biliardo, calcio balilla, freccette. Offriamo anche spuntini e vasetti preparati con cura da un ristoratore locale, che potrete consumare all'interno o portare via!"
    ],
    "fr": [
      "L'Assois Fées vous accueille dans une ambiance rétro/pin-up : bar, billard, baby-foot, fléchettes. Nous proposons du snacking pour vos petits creux et des bocaux cuisinés avec soin par un traiteur local que vous pouvez déguster sur place ou emporter !"
    ],
    "nl": [
      "L'Assois Fées verwelkomt je in een retro/pin-up sfeer: bar, pooltafel, tafelvoetbal, darts. We bieden ook snacks en potjes die zorgvuldig zijn bereid door een plaatselijke traiteur, die je binnen kunt eten of meenemen!"
    ],
    "es": [
      "L'Assois Fées le da la bienvenida en un ambiente retro/pin-up: bar, mesa de billar, futbolín, dardos. También ofrecemos aperitivos y jarras cuidadosamente preparadas por un servicio de catering local, ¡que podrá tomar en el restaurante o llevarse para llevar!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Assois Fées"
    ]
  },
