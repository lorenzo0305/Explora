  "rdfs:comment": {
    "de": [
      "Eine privilegierte Umgebung, im Herzen von St Ismier, auf dem Dorfplatz,\r\nin einem Haus aus dem 19. Jahrhundert mit geräumigen Zimmern und einem diskreten Park."
    ],
    "en": [
      "A privileged setting, in the heart of St Ismier, on the village square,\r\nin a 19th-century house with spacious rooms and discreet grounds."
    ],
    "it": [
      "Un ambiente privilegiato nel cuore di St Ismier, sulla piazza del paese,\r\nin una casa del XIX secolo con camere spaziose e un parco discreto."
    ],
    "fr": [
      "Un cadre privilégié, au cœur de St Ismier, sur la place du village,\r\ndans une maison du 19ème siècle, aux pièces spacieuses, au parc discret."
    ],
    "es": [
      "Un marco privilegiado en el corazón de St Ismier, en la plaza del pueblo,\r\nen una casa del siglo XIX con amplias habitaciones y un discreto jardín."
    ],
    "nl": [
      "Een bevoorrechte omgeving in het hart van St Ismier, op het dorpsplein,\r\nin een 19e-eeuws huis met ruime kamers en een discreet terrein."
    ]
  },
  "rdfs:label": {
