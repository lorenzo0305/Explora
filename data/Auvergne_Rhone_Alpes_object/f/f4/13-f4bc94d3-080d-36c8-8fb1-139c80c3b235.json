  "rdfs:comment": {
    "de": [
      "Ein gemütliches Restaurant, in dem wir ausschließlich frische Produkte verarbeiten. Die Schlüsselwörter für unsere Gerichte sind: Französisch, Italienisch, Spanisch und natürlich ein Hauch von Holland ..."
    ],
    "en": [
      "A welcoming restaurant where we work exclusively with fresh produce. The keywords for our dishes are: French, Italian, Spanish and of course a touch of Dutch..."
    ],
    "it": [
      "Un ristorante accogliente dove lavoriamo esclusivamente con prodotti freschi. Le parole chiave dei nostri piatti sono: francese, italiano, spagnolo e naturalmente un tocco di olandese..."
    ],
    "fr": [
      "Un restaurant accueillant dans lequel nous travaillons exclusivement des produits frais. Les mots-clés de nos plats sont : français, italien, espagnol et bien sûr une touche hollandaise..."
    ],
    "es": [
      "Un restaurante acogedor donde trabajamos exclusivamente con productos frescos. Las palabras clave de nuestros platos son: francés, italiano, español y, por supuesto, un toque holandés...."
    ],
    "nl": [
      "Een gastvrij restaurant waar we uitsluitend met verse producten werken. De sleutelwoorden voor onze gerechten zijn: Frans, Italiaans, Spaans en natuurlijk een vleugje Nederlands..."
    ]
  },
