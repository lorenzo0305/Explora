  "rdfs:comment": {
    "de": [
      "Stephanie, Massagepraktikerin, Inspiriert durch Sport und Reisen, wo die Vorteile der Massage nicht mehr bewiesen werden müssen, für diejenigen, die sich verführen lassen...\r\nIn der Praxis oder bei Ihnen zu Hause im ganzen Giffre-Tal. (Zuschlag von 5? pro Fahrt)"
    ],
    "en": [
      "Stephanie, Massage Practitioner, inspired by sport and travel, where the benefits of massage no longer need to be proven to those who let themselves be tempted...\r\nIn the office or at home throughout the Giffre Valley. (Supp of 5€ per trip)"
    ],
    "it": [
      "Stephanie, Massaggiatrice, ispirata dallo sport e dai viaggi, dove i benefici del massaggio non hanno più bisogno di essere dimostrati a chi si lascia tentare...\r\nIn ufficio o a domicilio in tutta la Valle di Giffre. (Supplemento di 5? per viaggio)"
    ],
    "fr": [
      "Stephanie, Praticienne Masseuse, Inspirée part le sport et les voyage, où les bienfaits du massage n'ont plus besoin d'être prouvé à ceux qui s'y seront laissé tenter...\r\nEn cabinet où à domicile dans toute la vallée du Giffre. (Supp de 5€ par déplacement)"
    ],
    "nl": [
      "Stephanie, Massagepraktijk, Geïnspireerd door sport en reizen, waar de voordelen van massage niet langer bewezen hoeven te worden aan degenen die zich laten verleiden...\r\nOp kantoor of thuis in de hele Giffrevallei. (Toeslag van 5€ per reis)"
    ],
    "es": [
      "Stephanie, Masajista, Inspirada por el deporte y los viajes, donde los beneficios del masaje ya no necesitan ser probados a aquellos que se dejan tentar...\r\nEn la oficina o a domicilio en todo el Valle de Giffre. (Supp de 5? por viaje)"
    ]
  },
