  "rdfs:comment": {
    "de": [
      "Nicht weit vom Place Bellecour entfernt, präsentiert Ihnen David von Les Culottes Longues seine Sicht der Küche: authentische und großzügige Teller nach Großmutters Art oder gewagtere Teller, jedoch immer im Respekt des Produkts."
    ],
    "en": [
      "At Culottes Longues, not far from place Bellecour, David offers diners his own vision of cuisine: generously-served, traditional dishes just like Grandma used to make, or with a twist, but always with respect for the ingredients used."
    ],
    "it": [
      "Vicino alla place Bellecour, alle Culottes Longues, David ti propone la sua visione della cucina: piatti genuini e generosi secondo le ricette della nonna, oppure più sfiziosi ma sempre nel rispetto del prodotto."
    ],
    "fr": [
      "Non loin de Bellecour, aux Culottes Longues, David vous propose sa vision de la cuisine : assiettes authentiques et généreuses façon grand-mère ou plus culottées mais toujours dans le respect du produit."
    ],
    "es": [
      "No lejos de Bellecour, en Les Culottes Longues, David propone su visión de la cocina: platos auténticos y generosos como los hacían las abuelas o más atrevidos, pero siempre respetando el producto."
    ],
    "nl": [
      "Niet ver van Bellecour, bij Les Culottes Longues, biedt David u zijn visie op koken: authentieke en gulle gerechten in grootmoeders stijl of brutaler, maar altijd met respect voor het product."
    ]
  },
