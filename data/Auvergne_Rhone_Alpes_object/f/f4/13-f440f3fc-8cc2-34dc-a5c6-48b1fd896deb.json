  "rdfs:comment": {
    "de": [
      "3 Sandtennisplätze und 2 Quicktan-Plätze. Die Tennisplätze können im Office de Tourisme du Carladès (04 71 47 50 68) gemietet werden, außer vom 01/06 bis 31/08, dann müssen Sie sich an den Eingang des Schwimmbads wenden (04 71 47 52 43)"
    ],
    "en": [
      "5 good reasons to indulge in your favorite sport in Vic sur Cère: 3 clay tennis courts and 2 quicktan courts. Set in a varied sports complex with quality equipment and in an exceptional environment."
    ],
    "it": [
      "3 campi da tennis in terra battuta e 2 campi da quicktan. I campi possono essere noleggiati presso l'Ufficio del Turismo di Carladès (04 71 47 50 68), tranne che dal 01/06 al 31/08, quando è necessario recarsi all'ingresso della piscina (04 71 47 52 43)"
    ],
    "fr": [
      "3 courts de tennis  en terre battue et 2 courts quicktan. La location des courts se fait à l'Office de Tourisme du Carladès (04 71 47 50 68) sauf du 01/06 au 31/08 où il faut s'adresser à l'entrée de la piscine (04 71 47 52 43)"
    ],
    "es": [
      "cancha de tenis"
    ],
    "nl": [
      "3 gravel tennisbanen en 2 quicktan banen. De banen kunnen worden gehuurd bij het toeristenbureau van Carladès (04 71 47 50 68), behalve van 01/06 tot 31/08, dan moet u naar de ingang van het zwembad (04 71 47 52 43)"
    ]
  },
