  "rdfs:comment": {
    "de": [
      "Als Liebhaber des Kulturerbes ist diese Route für Sie bestimmt. Sie wandern von einem Dorf zum anderen und können alle acht Weiler des Hangs durchqueren."
    ],
    "en": [
      "This is the route for heritage lovers. You'll make your way from one village to the next, passing through the eight hamlets on the hillside."
    ],
    "it": [
      "Questo percorso è dedicato agli amanti del patrimonio. Camminerete da un villaggio all'altro e potrete attraversare le otto frazioni del versante."
    ],
    "fr": [
      "Amateurs de patrimoine, cette itinéraire vous est destiné. Vous cheminerez d'un village à l'autre et vous pourrez traverser les huit hameaux du versant."
    ],
    "es": [
      "Esta ruta es para los amantes del patrimonio. Pasará de un pueblo a otro y podrá recorrer los ocho caseríos de la vertiente."
    ],
    "nl": [
      "Deze route is voor liefhebbers van erfgoed. U loopt van het ene dorp naar het andere en u kunt de acht gehuchten van de helling doorkruisen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tour of chapels and hamlets on the adret on E-Bike"
    ],
    "fr": [
      "Tournée des chapelles et hameaux de l'adret en VTTAE"
    ]
  },
