  "rdfs:comment": {
    "de": [
      "La Réserve in Avoriaz ist eine gastronomische Adresse in einem savoyischen Chalet. Entdecken Sie eine raffinierte und großzügige Küche, die von den Bergen inspiriert ist, auf einer Südterrasse mit Blick auf die Landschaft. Ein einzigartiges Gourmet-Erlebnis seit 1997."
    ],
    "en": [
      "La Réserve is the resort's ultimate gourmet restaurant. Delightful, rustic, chalet-style decor serving unique, sophisticated, gastro cuisine. Lovely sunny terrace, perfect for sitting out at lunchtime."
    ],
    "it": [
      "La Réserve, ad Avoriaz, è un indirizzo gourmet in uno chalet savoiardo. Scoprite una cucina raffinata e generosa ispirata alle montagne, su una terrazza esposta a sud con vista sulla campagna. Un'esperienza gastronomica unica dal 1997."
    ],
    "fr": [
      "La Réserve, à Avoriaz, est une adresse gastronomique dans un chalet savoyard. Découvrez une cuisine raffinée et généreuse, inspirée de la montagne, sur une terrasse plein sud face aux paysages. Une expérience gourmande unique depuis 1997."
    ],
    "es": [
      "La Réserve, en Avoriaz, es una dirección gastronómica en un chalet saboyano. Descubra una cocina refinada y generosa inspirada en la montaña, en una terraza orientada al sur con vistas al campo. Una experiencia gastronómica única desde 1997."
    ],
    "nl": [
      "La Réserve is hét culinaire restaurant van het skioord. In het sublieme decor van deze bergchalet kunt u proeven van unieke en verfijnde gerechten. Tussen de middag kunt u gebruikmaken van het zonnige terras."
    ]
  },
  "rdfs:label": {
