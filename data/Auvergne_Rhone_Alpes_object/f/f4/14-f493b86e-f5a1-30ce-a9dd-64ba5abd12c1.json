  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dde12435-14e1-37b5-a0ab-5e6e0dd5daeb",
      "dc:description": {
        "de": [
          "Besichtigungen \"Arktische Welten\"\nMuseum von Boulogne-sur-Mer\nEin Besuch, um die Sammlungen Rogoff und Jacot-Baud zu entdecken.\nVom 5. Juli bis 31. August 2025, jeden Tag um 14.30 Uhr\nDauer 45 min\nBesuche in englischer Sprache auf Anfrage.\nIn der Eintrittskarte enthalten - ohne Voranmeldung"
        ],
        "en": [
          "Arctic Worlds\" tours\nBoulogne-sur-mer Museum\nA visit to discover the Rogoff and Jacot-Baud collections.\nFrom July 5 to August 31, 2025, daily at 2.30pm\nDuration: 45 min\nVisits in english on request.\nIncluded in admission ticket - no appointment necessary"
        ],
        "it": [
          "Visite ai \"Mondi artici\nMuseo di Boulogne-sur-mer\nUna visita alla scoperta delle collezioni Rogoff e Jacot-Baud.\nDal 5 luglio al 31 agosto 2025, tutti i giorni alle 14.30\nDurata: 45 minuti\nVisite in inglese su richiesta.\nIncluso nel biglietto d'ingresso - non è necessario fissare un appuntamento"
        ],
        "fr": [
          "Visites « Mondes arctiques »\nMusée de Boulogne-sur-mer\nUne visite pour découvrir les collections Rogoff et Jacot-Baud.\nDu 5 juillet au 31 août 2025, chaque jour à 14h30\nDurée 45 min\nVisits in english on request.\nInclus dans le billet d’entrée - sans rendez-vous"
        ],
        "es": [
          "Visitas \"Mundos Árticos\nMuseo de Boulogne-sur-mer\nUna visita para descubrir las colecciones Rogoff y Jacot-Baud.\nDel 5 de julio al 31 de agosto de 2025, todos los días a las 14.30 h\nDuración: 45 minutos\nVisitas en inglés a petición.\nIncluido en el precio de la entrada - sin cita previa"
        ],
        "nl": [
          "Arctische werelden\" rondleidingen\nMuseum van Boulogne-sur-mer\nEen bezoek om de collecties Rogoff en Jacot-Baud te ontdekken.\nVan 5 juli tot 31 augustus 2025, dagelijks om 14u30\nDuur: 45 minuten\nBezoeken in het Engels op aanvraag.\nInbegrepen in het entreebewijs - geen afspraak nodig"
        ]
      },
