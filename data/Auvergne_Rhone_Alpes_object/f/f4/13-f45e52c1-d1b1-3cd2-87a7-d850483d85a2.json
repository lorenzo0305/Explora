  "rdfs:comment": {
    "de": [
      "Die Abtei wurde im 11. Jahrhundert von Pierre de Chavanon gegründet. Auf dem Höhepunkt seiner Macht im 15. Jahrhundert hatte der Abt von Pébrac, der aus der Familie Flageac stammte, das Recht auf hohe und niedere Gerichtsbarkeit über eine Kongregation von fast 40 Prioraten."
    ],
    "en": [
      "Abbey founded in the 11th century by Pierre de Chavanon. At the height of his power in the 15th century, the Abbé de Pébrac, a member of the Flageac family, had the right of high and low justice over a congregation of almost 40 priories."
    ],
    "it": [
      "Abbazia fondata nell'XI secolo da Pierre de Chavanon. All'apice del suo potere nel XV secolo, l'abate di Pébrac, membro della famiglia Flageac, aveva il diritto di alta e bassa giustizia su una congregazione di quasi 40 priorati."
    ],
    "fr": [
      "Abbaye fondée au XIème siècle par Pierre de Chavanon. A l'apogée de sa puissance, au XVème, l'Abbé de Pébrac, issu de la famille Flageac, a droit de haute et de basse justice sur une congrégation de près de 40 prieurés."
    ],
    "nl": [
      "Abdij gesticht in de 11e eeuw door Pierre de Chavanon. Op het hoogtepunt van zijn macht in de 15e eeuw had de abt van Pébrac, een lid van de familie Flageac, het recht van hoge en lage rechtspraak over een congregatie van bijna 40 priorijen."
    ],
    "es": [
      "Abadía fundada en el siglo XI por Pierre de Chavanon. En el apogeo de su poder en el siglo XV, el abad de Pébrac, miembro de la familia Flageac, tenía el derecho de alta y baja justicia sobre una congregación de casi 40 prioratos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ensemble Abbatial N.D. de Pebrac"
    ]
  },
