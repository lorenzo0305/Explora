  "rdfs:comment": {
    "de": [
      "Die Eishalle mit einer öffentlichen Kapazität von 4200 Personen ist Schauplatz von Eisshows, internationalen und nationalen Wettbewerben sowie Themenabenden."
    ],
    "en": [
      "With a public capacity of 4200 people, the ice-rink regularly holds skating shows and both international and national competitions."
    ],
    "it": [
      "Con una capacità di pubblico di 4.200 persone, la pista di pattinaggio ospita spettacoli sul ghiaccio, competizioni internazionali e nazionali e serate a tema."
    ],
    "fr": [
      "D'une capacité publique 4200 personnes, la patinoire accueille des spectacles sur glace, des compétitions internationales et nationales ainsi que des soirées à thèmes."
    ],
    "nl": [
      "Met een publiekscapaciteit van 4.200 personen worden op de ijsbaan ijsshows, internationale en nationale wedstrijden en thema-avonden gehouden."
    ],
    "es": [
      "Con un aforo de 4.200 personas, la pista de hielo acoge espectáculos sobre hielo, competiciones internacionales y nacionales y noches temáticas."
    ]
  },
