  "rdfs:comment": {
    "de": [
      "Das 3000 Bowling Live Café ist ein fabelhafter Komplex, der Sport und Freizeit miteinander verbindet und in dem man mit Freunden, Familie oder Kollegen eine gute Zeit verbringen kann."
    ],
    "en": [
      "6 Hartwood bowling lanes, 1 vidéo game arcade, 1 billiards hall, 1 outdoor petanque court.\r\nTheme nights, live concerts and entertainment, birthdays and other private events.\r\nAn inescapable place of the from Albertville pond \"is."
    ],
    "it": [
      "Il 3000 Bowling Live Café è un complesso favoloso, che unisce sport e tempo libero, dove è possibile divertirsi con gli amici, la famiglia o i colleghi."
    ],
    "fr": [
      "Le 3000 Bowling Live Café est un fabuleux complexe, alliant sport et loisirs, où passer de bons moments entre amis, famille, ou collègues."
    ],
    "nl": [
      "Het 3000 Bowling Live Café is een fantastisch complex dat sport en ontspanning combineert en waar u met vrienden, familie of collega's een geweldige tijd kunt beleven."
