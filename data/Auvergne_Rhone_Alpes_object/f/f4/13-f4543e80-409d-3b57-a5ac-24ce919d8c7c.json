  "rdfs:comment": {
    "de": [
      "Im öffentlichen Raum, Erzählung der Kämpfe, die die Geschichte der homosexuellen Kultur des 20. Jahrhunderts in Frankreich und den Vereinigten Staaten geprägt haben, auf halbem Wege zwischen einer kollektiven Suche, einem Dokumentarfilm und einer Demonstration."
    ],
    "en": [
      "Dans l'espace public, an account of the struggles that shaped the history of 20th-century homosexual culture in France and the United States, is halfway between a collective quest, a documentary and a demonstration."
    ],
    "it": [
      "Dans l'espace public, un resoconto delle lotte che hanno segnato la storia della cultura omosessuale del XX secolo in Francia e negli Stati Uniti, a metà strada tra una ricerca collettiva, un documentario e una manifestazione."
    ],
    "fr": [
      "Dans l'espace public, récit des luttes qui ont fait l'histoire de la culture homosexuelle du 20ème siècle en France et aux Etats Unis à mi-chemin entre une quête collective, un documentaire et une manifestation."
    ],
    "es": [
      "Dans l'espace public, un relato de las luchas que han marcado la historia de la cultura homosexual del siglo XX en Francia y Estados Unidos, a medio camino entre la búsqueda colectiva, el documental y la manifestación."
    ],
    "nl": [
      "Dans l'espace public, een verslag van de strijd die de geschiedenis van de 20e-eeuwse homoseksuele cultuur in Frankrijk en de Verenigde Staten heeft bepaald, halverwege tussen een collectieve zoektocht, een documentaire en een demonstratie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle - Le Pédé - Festival F(r)iction du réel"
    ]
  },
