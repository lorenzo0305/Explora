  "rdfs:comment": {
    "de": [
      "Entdecken Sie den geländegängigen Elektroroller, eine sportliche und zugleich spielerische Aktivität.\r\nEntdecken Sie die Bergpfade auf andere Weise und lassen Sie sich von einem professionellen Lehrer führen."
    ],
    "en": [
      "Come and discover the all-terrain electric scooter, an activity that is both sporty and fun.\r\nDiscover the mountain trails in a different way, guided by a professional instructor"
    ],
    "it": [
      "Venite a scoprire lo scooter elettrico fuoristrada, un'attività sportiva e divertente.\r\nScoprite i sentieri di montagna in modo diverso, guidati da un istruttore professionista."
    ],
    "fr": [
      "Venez découvrir la trottinette électrique tout terrain, une activité à la fois sportive et ludique.\r\nPartez à la découverte des sentiers de montagne autrement en vous laissant guider par un moniteur professionnel."
    ],
    "es": [
      "Ven a descubrir el scooter eléctrico todo terreno, una actividad tan deportiva como divertida.\r\nDescubre los senderos de montaña de una forma diferente, guiado por un instructor profesional."
    ],
    "nl": [
      "Kom en ontdek de all-terrain elektrische step, een activiteit die zowel sportief als leuk is.\r\nOntdek de bergpaden op een andere manier, begeleid door een professionele instructeur."
    ]
  },
