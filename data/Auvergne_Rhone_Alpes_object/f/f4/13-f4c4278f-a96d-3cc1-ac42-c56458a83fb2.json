  "rdfs:comment": {
    "de": [
      "Das Spa-Hotel \"Le Bout du Monde\" liegt 10 Minuten von St-Flour im Cantal (und 10 Minuten von der A75) entfernt. Es liegt in einem kleinen Tal in der Nähe des Forellenflusses \"l'Ander\" und ist über eine kleine, von Bäumen gesäumte Straße zu erreichen."
    ],
    "en": [
      "The Hôtel Spa \"Le Bout du Monde\" is located 10 minutes from St-Flour in the Cantal region (and 10 minutes from the A75 motorway). Nestled in a small valley near the trout river \"l'Ander\", it is reached by a tree-lined road."
    ],
    "it": [
      "L'Hôtel Spa \"Le Bout du Monde\" si trova a 10 minuti da St-Flour, nella regione del Cantal (e a 10 minuti dall'autostrada A75). Immerso in una piccola valle vicino al fiume di trote \"l'Ander\", è raggiungibile attraverso una piccola strada alberata."
    ],
    "fr": [
      "L'Hôtel Spa \"Le Bout du Monde\" est situé à 10 mn. de St-Flour dans le Cantal (et à 10 min. de l'A75). Blotti dans une petite vallée près de la rivière à truites \"l'Ander\", on y accède par une petite route bordée d'arbres."
    ],
    "nl": [
      "Hôtel Spa \"Le Bout du Monde\" ligt op 10 minuten van St-Flour in de Cantal (en 10 minuten van de snelweg A75). Het is genesteld in een kleine vallei in de buurt van de forellenrivier \"l'Ander\" en is bereikbaar via een kleine, met bomen omzoomde weg."
    ],
    "es": [
      "El Hôtel Spa \"Le Bout du Monde\" está situado a 10 minutos de St-Flour, en la región de Cantal (y a 10 minutos de la autopista A75). Enclavado en un pequeño valle cerca del río truchero \"l'Ander\", se accede a él por una pequeña carretera arbolada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel et Spa Le Bout du Monde"
    ]
  },
