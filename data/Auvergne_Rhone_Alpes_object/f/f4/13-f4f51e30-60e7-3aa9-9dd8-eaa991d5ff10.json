  "rdfs:comment": {
    "de": [
      "Bergrestaurant auf dem Col d'Aulac mit Blick auf das Mars-Tal und den Puy Mary.\r\nRegionale und traditionelle hausgemachte Küche, lokale Produkte.\r\nIn der Nähe: Paragliding-Standort, Standort Cotteughes, Wanderwege."
    ],
    "en": [
      "Mountain restaurant situated at the Aulac pass overlooking the Mars valley and the Puy Mary. Traditional and home cooking with local products.\r\nRecommended by the “Guide du Routard”."
    ],
    "it": [
      "Ristorante di montagna situato sul Col d'Aulac con vista sulla valle del Mars e sul Puy Mary.\r\nCucina regionale e tradizionale fatta in casa, prodotti locali.\r\nNelle vicinanze: sito di parapendio, sito di Cotteughes, sentieri escursionistici."
    ],
    "fr": [
      "Restaurant de montagne situé au col d'Aulac avec vue sur la vallée du Mars et le Puy Mary.\r\nCuisine régionale et traditionnelle maison, produits locaux.\r\nA proximité : site de parapente, site de Cotteughes, sentiers de randonnée."
    ],
    "es": [
      "Restaurante de montaña situado en el Col d'Aulac con vistas al valle de Marte y al Puy Mary.\r\nCocina casera regional y tradicional, productos locales.\r\nCerca: sitio de parapente, sitio de Cotteughes, rutas de senderismo."
    ],
    "nl": [
      "Bergrestaurant gelegen op de Col d'Aulac met uitzicht op de vallei van Mars en de Puy Mary.\r\nRegionale en traditionele huisgemaakte keuken, lokale producten.\r\nIn de buurt: paragliding site, Cotteughes site, wandelpaden."
    ]
  },
