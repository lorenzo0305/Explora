  "rdfs:comment": {
    "de": [
      "Kleines Restaurant und Bar am Fuße der Skipisten im Winter und der Mountainbike-Strecken im Sommer.\r\nAuf der großen Terrasse können Sie den Blick auf das Skigebiet, die Anfängerpisten und die Mountainbike-Abfahrten genießen."
    ],
    "en": [
      "Small restaurant and bar at the foot of the ski slopes in winter and the mountain bike trails in summer.\r\nA large terrace with views of the ski area, beginners' slopes and downhill mountain biking."
    ],
    "it": [
      "Piccolo ristorante e bar ai piedi delle piste da sci in inverno e dei percorsi per mountain bike in estate.\r\nUn'ampia terrazza da cui si gode la vista sul comprensorio sciistico, sulle piste per principianti e sulle discese in mountain bike."
    ],
    "fr": [
      "Petite restauration et bar au pied des pistes de ski en hiver et des pistes VTT en été.\r\nUne grande terrasse pour profiter de la vue sur le domaine skiable, les pistes débutants et des descente en VTT."
    ],
    "es": [
      "Pequeño restaurante y bar al pie de las pistas de esquí en invierno y de las pistas de BTT en verano.\r\nUna gran terraza donde disfrutar de las vistas de la zona de esquí, las pistas para principiantes y el descenso en bicicleta de montaña."
    ],
    "nl": [
      "Klein restaurant en bar aan de voet van de skipistes in de winter en de mountainbikeroutes in de zomer.\r\nEen groot terras waar je kunt genieten van het uitzicht op het skigebied, de beginnerspistes en downhill mountainbiken."
    ]
  },
