  "rdfs:comment": {
    "de": [
      "Snow Systems Skischule: Privatunterricht für Ski, Snowboard und Touring/Off-Piste im gesamten Gebiet der 3 Vallées sowie Kinder-/Jugendgruppen (von 5 bis 17 Jahren) mit maximal 6 bis 8 Schülern pro Lehrer, mit Start in Mottaret und Méribel."
    ],
    "en": [
      "Snow Systems ski school: private ski, snowboard and touring/off-piste lessons throughout the 3 Vallées ski area, as well as children's and teenage groups (5 to 17 years) of 6 to 8 students maximum per instructor, departing from Mottaret and Méribel."
    ],
    "it": [
      "Scuola di sci Snow Systems: lezioni private di sci, snowboard e turismo/fuoripista in tutto il comprensorio sciistico delle 3 Vallées, nonché gruppi di bambini e ragazzi (dai 5 ai 17 anni) da 6 a 8 studenti al massimo per istruttore, con partenza da Mottaret e Méribel."
    ],
    "fr": [
      "L'école de glisse Snow Systems  : cours privés de ski, snowboard et touring/hors-piste dans tout le domaine des 3 Vallées ainsi que des groupes enfants/ados (de 5 à 17 ans) de 6 à 8 élèves maximum par moniteur, au départ de Mottaret et Méribel."
    ],
    "nl": [
      "Skischool Snow Systems: privélessen skiën, snowboarden en toerskiën/off-piste in het hele gebied van de 3 Vallées, maar ook groepen kinderen en tieners (van 5 tot 17 jaar) van maximaal 6 tot 8 leerlingen per instructeur, met vertrek vanuit Mottaret en Méribel."
    ],
    "es": [
      "Escuela de esquí Snow Systems: clases particulares de esquí, snowboard y travesía/fuera de pista en toda la zona de los 3 Vallées, así como grupos de niños y adolescentes (de 5 a 17 años) de 6 a 8 alumnos máximo por monitor, con salidas desde Mottaret y Méribel."
    ]
  },
