  "rdfs:comment": {
    "de": [
      "Altitude Biathlon besteht aus ehemaligen Mitgliedern der französischen Nationalmannschaft, die vom Biathlon begeistert sind und Ihnen zu Diensten stehen. Sie sind Spezialisten für Biathlon-Animationen in ganz Frankreich und Europa, im Sommer wie im Winter."
    ],
    "en": [
      "Altitude Biathlon is a team of ex-members of the French national biathlon team, passionate about biathlon and at your service, specializing in biathlon activities throughout France and Europe, summer and winter alike."
    ],
    "it": [
      "Altitude Biathlon è un team di ex membri delle squadre nazionali francesi appassionati di biathlon e al vostro servizio, specializzato in attività di biathlon in tutta la Francia e in Europa, sia in estate che in inverno."
    ],
    "fr": [
      "Altitude Biathlon c’est des ex-membres des équipes de France, passionnés de biathlon et à votre service, spécialistes de l’animation de biathlon partout en France et en Europe, été comme hiver."
    ],
    "nl": [
      "Altitude Biathlon is een team van ex-leden van de Franse nationale teams die gepassioneerd zijn door biatlon en tot uw dienst staan, gespecialiseerd in biatlonactiviteiten in heel Frankrijk en Europa, zowel in de zomer als in de winter."
    ],
    "es": [
      "Altitude Biathlon es un equipo de ex miembros de los equipos nacionales franceses apasionados por el biatlón y a su servicio, especializados en actividades de biatlón en toda Francia y Europa, tanto en verano como en invierno."
    ]
  },
