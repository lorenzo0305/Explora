  "rdfs:comment": {
    "de": [
      "Ludovic und Myriam freuen sich, Sie in ihrem Restaurant \"terre et mer\" in einer gemütlichen Atmosphäre mit gepflegter Küche und garantierter Gastlichkeit begrüßen zu dürfen. Die Speisekarte wird alle fünf Wochen gewechselt."
    ],
    "en": [
      "Ludovic and Myriam are happy to welcome you in their restaurant \"terre et mer\", in a cosy atmosphere with a neat cooking and assured conviviality. The menu changes every 5 weeks."
    ],
    "it": [
      "Ludovic e Myriam sono lieti di accogliervi nel loro ristorante, in un'atmosfera accogliente con una cucina accurata e una convivialità garantita. Il menu cambia ogni 5 settimane."
    ],
    "fr": [
      "Ludovic et Myriam sont heureux de vous accueillir dans leur restaurant terre et mer, dans une ambiance cosy avec une cuisine soignée et convivialité assurée. Changement de carte toutes les 5 semaines."
    ],
    "es": [
      "Ludovic y Myriam están encantados de recibirle en su restaurante, en un ambiente acogedor con una cocina cuidada y una convivencia garantizada. El menú cambia cada 5 semanas."
    ],
    "nl": [
      "Ludovic en Myriam ontvangen u graag in hun restaurant, in een gezellige sfeer met een zorgvuldige keuken en gegarandeerde gezelligheid. Het menu verandert elke 5 weken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Coq en Poulpe"
    ]
  },
