  "rdfs:comment": {
    "de": [
      "Die Galerie Deza, die bereits in Roanne vertreten ist, eröffnet nun auch in Villerest. Sie werden eine echte künstlerische Linie wiederfinden, die sich auf die Farbe konzentriert. Verschiedene Welten, seien es Skulpturen, Gemälde oder Fotografien, vermischen sich in diesem neuen Ort."
    ],
    "en": [
      "Galerie Deza, already present in Roanne, opens in Villerest. You'll find a real artistic line focused on color. A variety of worlds, including sculpture, painting and photography, intermingle in this new venue."
    ],
    "it": [
      "La Galerie Deza, già presente a Roanne, apre a Villerest. Troverete una vera e propria linea artistica incentrata sul colore. Un'ampia varietà di opere, tra cui sculture, dipinti e fotografie, si mescolano in questa nuova sede."
    ],
    "fr": [
      "La Galerie Deza, déjà présente à Roanne, ouvre à Villerest. Vous retrouverez une réelle ligne artistique axée sur la couleur. Des univers variés, qu'il s'agisse de sculptures, de peintures ou de photographies, s'entremêlent dans ce nouveau lieu."
    ],
    "es": [
      "La Galerie Deza, ya presente en Roanne, abre sus puertas en Villerest. Encontrará una verdadera línea artística centrada en el color. Una gran variedad de obras, entre esculturas, pinturas y fotografías, se entremezclan en esta nueva sede."
    ],
    "nl": [
      "Galerie Deza, al aanwezig in Roanne, opent haar deuren in Villerest. U vindt er een echte artistieke lijn waarin kleur centraal staat. Een grote verscheidenheid aan werken, waaronder beeldhouwwerken, schilderijen en foto's, komen samen in deze nieuwe locatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Galerie Deza - Villerest"
    ]
  },
