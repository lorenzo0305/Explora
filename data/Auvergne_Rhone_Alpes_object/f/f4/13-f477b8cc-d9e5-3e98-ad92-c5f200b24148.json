  "rdfs:comment": {
    "de": [
      "Spezialistin für Abenteuertourismus und Outdoor-Aktivitäten mit ihrem Hund.  Ich helfe Ihnen dabei, Ihre Abenteuerträume zu verwirklichen und einzigartige Momente mit Ihrem Hund zu teilen."
    ],
    "en": [
      "Specialist in adventure tourism and outdoor activities with your dog.  I help you make your adventure dreams come true and share unique moments with your dog."
    ],
    "it": [
      "Specialista in turismo d'avventura e attività all'aperto con il vostro cane.  Vi aiuterò a realizzare i vostri sogni di avventura e a condividere momenti unici con il vostro cane."
    ],
    "fr": [
      "Spécialiste du tourisme d'aventure et activités outdoor avec son chien.  Je vous aide à concrétiser vos rêves d'aventure et à partager des instants uniques avec votre chien."
    ],
    "nl": [
      "Specialist in avontuurlijk toerisme en outdooractiviteiten met je hond.  Ik help je om je avontuurlijke dromen waar te maken en unieke momenten te delen met je hond."
    ],
    "es": [
      "Especialista en turismo de aventura y actividades al aire libre con tu perro.  Te ayudaré a hacer realidad tus sueños de aventura y a compartir momentos únicos con tu perro."
    ]
  },
