  "rdfs:comment": {
    "de": [
      "Im Herzen der Freizeitanlage von Neyrial können Sie die Kontrollpunkte auf der von der FFCO erstellten Karte finden. Diese Aktivität trainiert Sie im Lesen von Plänen, im Umgang mit einem Kompass und vor allem im Sport."
    ],
    "en": [
      "In the heart of the Neyrial leisure park, have fun finding the checkpoints on the FFCO map. This activity will teach you how to read maps, use a compass and, above all, have a great sporting time."
    ],
    "it": [
      "Nel cuore del parco divertimenti di Neyrial, divertitevi a trovare i punti di controllo sulla mappa elaborata dalla FFCO. Questa attività vi insegnerà a leggere le mappe, a usare la bussola e soprattutto a divertirvi."
    ],
    "fr": [
      "Au cœur de la base de loisirs du Neyrial, amusez-vous à retrouvez les points de contrôle situés sur la carte élaborée par la FFCO. Cette activité vous entraînera à la lecture de plans, à utiliser une boussole et surtout à passer un bon moment sportif."
    ],
    "nl": [
      "In het hart van het recreatiepark van Neyrial kun je op een leuke manier de checkpoints vinden op de kaart die door de FFCO is gemaakt. Bij deze activiteit leer je kaartlezen, een kompas gebruiken en vooral sportief bezig zijn."
    ],
    "es": [
      "En el corazón del parque de ocio Neyrial, diviértete encontrando los puntos de control en el mapa elaborado por la FFCO. Esta actividad te enseñará a leer mapas, a utilizar la brújula y, sobre todo, a pasar un buen rato deportivo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation du Neyrial"
    ]
  },
