  "rdfs:comment": {
    "de": [
      "Armel Richard nutzt sein Talent als Erzähler, um Kinder mit kleinen Geschichten zu fesseln, die er selbst kreiert hat oder die aus dem klassischen und modernen Repertoire der Märchen aus aller Welt stammen."
    ],
    "en": [
      "Armel Richard uses his talents as a storyteller to captivate children with short stories of his own creation or drawn from the classic and modern repertoire of world tales."
    ],
    "it": [
      "Armel Richard usa il suo talento di narratore per affascinare i bambini con brevi storie di sua creazione o tratte dal repertorio classico e moderno dei racconti del mondo."
    ],
    "fr": [
      "Armel Richard utilise ses talents de conteur pour captiver les enfants à l'aide de petites histoires de sa création ou issues du répertoire classique et moderne des contes du monde."
    ],
    "es": [
      "Armel Richard utiliza su talento como narrador para cautivar a los niños con historias cortas de su propia creación o extraídas del repertorio clásico y moderno de los cuentos del mundo."
    ],
    "nl": [
      "Armel Richard gebruikt zijn talenten als verteller om kinderen te boeien met korte verhalen van zijn eigen creatie of uit het klassieke en moderne repertoire van wereldverhalen."
    ]
  },
