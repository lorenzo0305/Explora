  "rdfs:comment": {
    "de": [
      "Dieser Bereich für Ausstellungen von Amateurkünstlern ist vorrangig für Künstler aus Chambery, neue Aussteller und Vereine aus Chambery bestimmt. Der Verkauf von Kunstwerken ist auf dem Gelände untersagt."
    ],
    "en": [
      "An area devoted to exhibiting the work of amateur artists, particularly from Chambéry, of new exhibitors and Chambéry associations. The sale of works on the premises is prohibited."
    ],
    "it": [
      "Questo spazio dedicato agli esposizioni di artisti è sopratutto riservato agli artisti della città, ai nuovi esposanti e aglli associazioni di Chambéry. La vendità di opere è vietata sui luoghi."
    ],
    "fr": [
      "Cet espace consacré aux expositions d'artistes amateurs est prioritairement destiné aux artistes chambériens, aux nouveaux exposants et aux associations chambériennes. La vente d'œuvres est interdite sur les lieux."
    ],
    "es": [
      "Este espacio dedicado a las exposiciones de artistas aficionados está destinado principalmente a los artistas de la Cámara, a los nuevos expositores y a las asociaciones de la Cámara. La venta de obras está prohibida en el recinto."
    ],
    "nl": [
      "Deze ruimte voor tentoonstellingen van amateurkunstenaars is in de eerste plaats bedoeld voor kunstenaars van de Kamer, nieuwe exposanten en Kamerverenigingen. De verkoop van werken is ter plaatse verboden."
    ]
  },
