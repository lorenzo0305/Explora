  "rdfs:comment": {
    "de": [
      "Die Kirche Sainte-Foy in Contamine-sur-Arve, die seit 1909 als historisches Monument klassifiziert ist, wurde um 1295 erbaut.  Geführte Besichtigungen sind möglich."
    ],
    "en": [
      "The church of Sainte-Foy in Contamine-sur-Arve has been listed as a historic monument since 1909. Guided tours are available to find out more about its history. Contact the tourist office."
    ],
    "it": [
      "La chiesa di Sainte-Foy a Contamine-sur-Arve, classificata come monumento storico dal 1909, fu costruita intorno al 1295.  Sono disponibili visite guidate."
    ],
    "fr": [
      "L’église Sainte-Foy de Contamine-sur-Arve, classée au titre des monuments historiques depuis 1909,  a été édifiée vers 1295.  Des visites guidées sont possibles."
    ],
    "es": [
      "La iglesia de Sainte-Foy, en Contamine-sur-Arve, declarada monumento histórico en 1909, fue construida hacia 1295.  Hay visitas guiadas disponibles."
    ],
    "nl": [
      "De kerk Sainte-Foy in Contamine-sur-Arve, die sinds 1909 op de monumentenlijst staat, werd gebouwd rond 1295.  Er zijn rondleidingen met gids beschikbaar."
    ]
  },
