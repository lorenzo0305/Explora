  "rdfs:comment": {
    "de": [
      "Rundtour zwischen Wald und Plateau, um die Landschaft oberhalb von Saint-Julien und den äußersten Zipfel des Genfer Sees zu entdecken."
    ],
    "en": [
      "A loop allowing you to travel through forest and plateau in order to discover the haut-genevois, looking over Saint-Julien and the tip of Lake Geneva."
    ],
    "it": [
      "Un percorso ad anello che alterna foresta e altopiano, permettendo di scoprire la regione dell'Haute-Genevois con vista su Saint-Julien e sulla punta del Lago di Ginevra."
    ],
    "fr": [
      "Boucle vous permettant d'alterner forêt et plateau afin de découvrir le haut-genevois en surplombant Saint-Julien et l'extrémité du lac Léman."
    ],
    "es": [
      "Un itinerario en bucle que alterna bosque y meseta, y que permite descubrir la región de Haute-Genevois mientras se domina Saint-Julien y la punta del lago Lemán."
    ],
    "nl": [
      "Een lus waarmee u afwisselend bos en hoogvlakte kunt ontdekken, met uitzicht op Saint-Julien en het einde van het meer van Genève."
    ]
  },
  "rdfs:label": {
