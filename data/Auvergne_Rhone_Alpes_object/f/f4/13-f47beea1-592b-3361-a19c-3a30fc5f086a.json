  "rdfs:comment": {
    "de": [
      "Bar, Tapas und Bergbistro.\r\nAm Fuße der Pisten, im Herzen des Weilers „Caseblanche“ in Saint Martin de Belleville, bieten René und Maxime Meilleur ihre Adresse „Simple & Meilleur“ an."
    ],
    "en": [
      "At the foot of the slopes and at the heart of the top-of-the-range “Caseblanche” quarter in Saint Martin de Belleville, René and Maxime Meilleur will be opening \"Simple & Meilleur\", a proposition that makes a perfect\r\ncomplement to La Bouitte."
    ],
    "it": [
      "Bar, tapas e bistrot di montagna.\r\nAi piedi delle piste, nel cuore della frazione di \"Caseblanche\" a Saint Martin de Belleville, René e Maxime Meilleur offrono il loro indirizzo \"Simple & Meilleur\"."
    ],
    "fr": [
      "Bar, tapas et bistrot de montagne.\r\nC’est au pied des pistes, au coeur du hameau de \"Caseblanche\" à Saint Martin de Belleville que René et Maxime Meilleur proposent leur adresse \"Simple & Meilleur\"."
    ],
    "es": [
      "Bar, tapas y bistró de montaña.\r\nAl pie de las pistas, en el corazón de la aldea de \"Caseblanche\" en Saint Martin de Belleville, René y Maxime Meilleur ofrecen su dirección \"Simple & Meilleur\"."
    ],
    "nl": [
      "Bar, tapas en bistro in de bergen.\r\nAan de voet van de pistes, in het hart van het gehucht \"Caseblanche\" in Saint Martin de Belleville, bieden René en Maxime Meilleur hun \"Simple & Meilleur\" adres aan."
    ]
  },
