  "rdfs:comment": {
    "de": [
      "Artymiss Créa bietet Ihnen das ganze Jahr über Zeichenkurse, Mangakurse und Skizzenkurse für Erwachsene oder Kinder an. Wenn Sie die Grundlagen erwerben oder sich weiterbilden möchten, können Sie sich gerne mit ihr in Verbindung setzen, um mehr zu erfahren."
    ],
    "en": [
      "Artymiss Crea offers drawing, manga style drawing and sketching lessons for adults and children. If you'd like to learn the basics or improve your skills, please get in touch to find out more."
    ],
    "it": [
      "Durante tutto l'anno, Artymiss Créa offre corsi di disegno, manga e sketching per adulti e bambini. Se volete imparare le basi o migliorare le vostre capacità, non esitate a contattarla per maggiori informazioni."
    ],
    "fr": [
      "Artymiss Créa vous propose, tout au long de l'année, des cours de dessins, mangas et croquis pour adultes ou enfants. Si vous souhaitez acquérir les bases ou vous perfectionner, n'hésitez pas à la contacter pour en savoir plus."
    ],
    "nl": [
      "Artymiss Créa biedt het hele jaar door teken-, manga- en schetslessen voor volwassenen en kinderen. Als je de basis wilt leren of je vaardigheden wilt verbeteren, aarzel dan niet om contact met haar op te nemen voor meer informatie."
    ],
    "es": [
      "A lo largo del año, Artymiss Créa ofrece clases de dibujo, manga y esbozo para adultos y niños. Si quieres aprender lo básico o mejorar tus habilidades, no dudes en ponerte en contacto con ella para obtener más información."
    ]
  },
