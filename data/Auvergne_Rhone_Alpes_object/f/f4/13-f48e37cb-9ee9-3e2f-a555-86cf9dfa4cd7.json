  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Dorfes Artemare mit einer Restaurantseite, einer Barseite und einer schönen Sonnenterrasse\r\nTraditionelle Küche, wöchentlich wechselndes Tagesmenü und Spezialitätenkarte. Möglichkeit, Gerichte zum Mitnehmen zu bestellen."
    ],
    "en": [
      "Restaurant located in the heart of the village of Artemare, with a restaurant side, a bar side and a beautiful sunny terrace. Traditional cuisine, menu of the day renewed every week and specialities menu. Possibility to order take-away food."
    ],
    "it": [
      "Ristorante situato nel cuore del paese di Artemare, con un lato ristorante, un lato bar e una bella terrazza soleggiata\r\nCucina tradizionale, menù del giorno rinnovato ogni settimana e menù di specialità. Possibilità di ordinare pasti da asporto."
    ],
    "fr": [
      "Restaurant situé au cœur du village d'Artemare, avec un côté restaurant, un côté bar et une belle terrasse ensoleillée. \r\nCuisine traditionnelle, menu du jour renouvelé chaque semaine et carte des spécialités. Possibilité de commander des plats à emporter."
    ],
    "es": [
      "Restaurante situado en el corazón del pueblo de Artemare, con una parte de restaurante, una parte de bar y una hermosa terraza soleada\r\nCocina tradicional, menú del día renovado cada semana y menú de especialidades. Posibilidad de pedir comida para llevar."
    ],
    "nl": [
      "Restaurant gelegen in het hart van het dorp Artemare, met een restaurantzijde, een barzijde en een prachtig zonnig terras\r\nTraditionele keuken, wekelijks vernieuwd dagmenu en specialiteitenmenu. Mogelijkheid om afhaalmaaltijden te bestellen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Le Séran"
    ],
    "fr": [
      "Restaurant Le Séran"
    ]
  },
