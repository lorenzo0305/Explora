  "rdfs:comment": {
    "de": [
      "Im Herzen von Thônes gelegen, profitiert es von einem privilegierten Rahmen für Entspannung und Ruhe, 200m vom Dorf entfernt und am Fuße des Klettersteigs, in einer herzlichen Atmosphäre. Traditionelles Restaurant. Aufenthalte nach Maß, Aktivitäten. Hotel- und Aparthotelformeln."
    ],
    "en": [
      "Situated in the heart of Thônes, it enjoys a privileged setting for relaxation and calm, 200m from the village and at the foot of the via ferrata, in a warm atmosphere. Traditional restaurant. Tailor-made stays and activities. Hotel and Appart'Hôtel packages."
    ],
    "it": [
      "Situato nel cuore di Thônes, beneficia di un ambiente privilegiato per il relax, la calma, a 200 m dal villaggio e ai piedi della via ferrata, in un'atmosfera calorosa. Ristorante tradizionale. Soggiorni e attività su misura. Formule Hotel e Appart'Hotel."
    ],
    "fr": [
      "Situé au coeur de Thônes, il bénéficie d'un cadre privilégié pour la détente, le calme, à 200m du village et au pied de la via ferrata, dans une ambiance chaleureuse. Restaurant traditionnel. Séjours sur mesure, activités. Formules hôtel et Appart'Hôtel."
    ],
    "es": [
      "Situado en el corazón de Thônes, se beneficia de un entorno privilegiado para el descanso, la calma, a 200 m del pueblo y al pie de la vía ferrata, en un ambiente cálido. Restaurante tradicional. Estancias y actividades a medida. Fórmulas de hotel y de Appart'Hotel."
    ],
    "nl": [
      "Gelegen in het hart van Thônes, profiteert het van een bevoorrechte omgeving voor ontspanning, rust, 200m van het dorp en aan de voet van de via ferrata, in een warme sfeer. Traditioneel restaurant. Verblijven op maat, activiteiten. Hotel en Appart'Hotel formules."
    ]
  },
