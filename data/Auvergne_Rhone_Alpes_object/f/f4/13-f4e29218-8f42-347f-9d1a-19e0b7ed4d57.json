  "rdfs:comment": {
    "de": [
      "Isabelle und Stéphane bieten Ihnen einen kleinen Imbiss an: Galettes Sarrazin, Crêpes, Eis, savoyische und lokale Spezialitäten. Von der Terrasse des Chalets aus können Sie ein wunderschönes Panorama genießen und Tiere beobachten."
    ],
    "en": [
      "Isabelle and Stéphane offer you a little catering: sarrazin pancakes, pancakes, ice cream, Savoyard and local specialties. From the terrace of the chalet, you can observe a magnificent panorama and observe the animals."
    ],
    "it": [
      "Isabelle e Stéphane offrono un piccolo ristorante: galettes sarrazin, crêpes, gelati, specialità savoiarde e locali. Dalla terrazza dello chalet si può osservare un magnifico panorama e osservare gli animali."
    ],
    "fr": [
      "Isabelle et Stéphane vous proposent une petite restauration : galettes sarrazin, crêpes, glaces, spécialités savoyardes et locales. Depuis la terrasse du chalet, vous pourrez observer un magnifique panorama et observer les animaux."
    ],
    "es": [
      "Isabelle y Stéphane le ofrecen un pequeño restaurante: galettes sarrazin, crepes, helados, especialidades saboyanas y locales. Desde la terraza del chalet, se puede observar un magnífico panorama y observar a los animales."
    ],
    "nl": [
      "Isabelle en Stéphane bieden u een kleine maaltijd: boekweitpannenkoekjes, pannenkoeken, ijs, Savoie en lokale specialiteiten. Vanaf het chaletterras kunt u een prachtig panorama en de dieren observeren."
    ]
  },
  "rdfs:label": {
