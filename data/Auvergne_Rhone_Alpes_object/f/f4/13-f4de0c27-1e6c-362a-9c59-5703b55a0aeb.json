  "rdfs:comment": {
    "de": [
      "Das Saint-Georges heißt Sie in einer warmen Atmosphäre willkommen, mit seinem Restaurant, das bis zu 40 Gäste aufnehmen kann, und seiner gemütlichen Bar. Das Haus bietet eine verbesserte traditionelle Küche an."
    ],
    "en": [
      "Saint-Georges welcomes you in a warm atmosphere with its restaurant room that can accommodate up to 40 guests, and its friendly bar. The establishment offers improved traditional cuisine."
    ],
    "it": [
      "Le Saint-Georges offre un'accoglienza calorosa nella sua sala ristorante, che può ospitare fino a 40 persone, e nel suo accogliente bar. Il ristorante propone una cucina tradizionale con un tocco di classe."
    ],
    "fr": [
      "Le Saint-Georges vous accueille dans une ambiance chaleureuse avec sa salle de restaurant pouvant recevoir jusqu’à 40 convives, et son bar convivial . L’établissement propose une cuisine traditionnelle améliorée."
    ],
    "es": [
      "Le Saint-Georges ofrece una cálida bienvenida en su sala de restaurante, con capacidad para 40 comensales, y en su acogedor bar. El restaurante sirve cocina tradicional con un toque especial."
    ],
    "nl": [
      "Le Saint-Georges biedt een warm welkom in de restaurantzaal, die plaats biedt aan maximaal 40 gasten, en de gezellige bar. Het restaurant serveert traditionele gerechten met een twist."
    ]
  },
