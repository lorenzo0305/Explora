  "rdfs:comment": {
    "de": [
      "Genießen Sie im L'Escargot traditionelle und frische Gerichte, die mit einem Lächeln in einer freundlichen Umgebung im Herzen von Valenciennes serviert werden."
    ],
    "en": [
      "At L'Escargot, enjoy traditional, fresh dishes served with a smile in a friendly setting in the heart of Valenciennes."
    ],
    "it": [
      "All'Escargot potrete gustare piatti tradizionali e freschi, serviti con un sorriso in un ambiente accogliente nel cuore di Valenciennes."
    ],
    "fr": [
      "Dégustez à l'Escargot des plats traditionnels et frais, servis avec le sourire dans un cadre convivial au cœur de Valenciennes."
    ],
    "es": [
      "En L'Escargot podrá degustar platos tradicionales y frescos, servidos con una sonrisa en un ambiente acogedor en el corazón de Valenciennes."
    ],
    "nl": [
      "Bij L'Escargot kunt u genieten van traditionele, verse gerechten, geserveerd met een glimlach in een vriendelijke omgeving in het hart van Valenciennes."
    ]
  },
