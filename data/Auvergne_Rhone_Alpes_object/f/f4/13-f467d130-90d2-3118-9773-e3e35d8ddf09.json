  "rdfs:comment": {
    "de": [
      "La Pizz'A Max bietet Ihnen Pizzas zum Mitnehmen an. Neue Rezepte sowie ein täglich frisch zubereiteter Teig und frisch zubereitete Produkte werden hier angeboten. An den schönsten Tagen des Jahres steht Ihnen eine Terrasse zur Verfügung."
    ],
    "en": [
      "Pizz'A Max offers takeaway pizzas. New recipes, fresh dough and freshly baked products are on offer. Terrace available on sunny days."
    ],
    "it": [
      "Pizz'A Max offre pizze da asporto. Vengono proposte nuove ricette, impasti freschi e prodotti cucinati al momento. Terrazza disponibile per i giorni più belli dell'anno."
    ],
    "fr": [
      "La Pizz'A Max vous propose des pizzas à emporter. De nouvelles recettes ainsi qu'une pâte élaborée tous les jours et des produits fraichement cuisinés seront au rendez-vous. Terrasse disponible pour les plus beaux jours de l’année."
    ],
    "es": [
      "Pizz'A Max ofrece pizzas para llevar. Se ofrecen nuevas recetas, masa recién hecha y productos recién cocinados. Terraza disponible para los mejores días del año."
    ],
    "nl": [
      "Pizz'A Max biedt afhaalpizza's. Nieuwe recepten, vers gemaakt deeg en vers bereide producten worden aangeboden. Terras beschikbaar voor de beste dagen van het jaar."
    ]
  },
