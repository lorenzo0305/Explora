  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf ein Abenteuer inmitten einer der schönsten Naturlandschaften des Departements Oise\n\nAls riesiges Feucht- und Torfgebiet von fast 1000ha enthüllen die Marais de Sacy ihre Geschichte und ihre Schönheit!"
    ],
    "en": [
      "Set off on an adventure in the heart of one of the most beautiful natural sites in the Oise\n\nVast wet and peaty area of nearly 1000ha, the Sacy Marshes reveal their history and beauty!"
    ],
    "it": [
      "Partite all'avventura nel cuore di uno dei siti naturali più belli dell'Oise\n\nVasta zona umida e torbosa di quasi 1000 ettari, i Marais de Sacy rivelano la loro storia e la loro bellezza!"
    ],
    "fr": [
      "Partez pour une aventure au cœur d'un des plus beaux sites naturels de l'Oise. \n\nVaste zone humide et tourbeuse de près de 1000ha, les Marais de Sacy dévoilent leur histoire et leur beauté !"
    ],
    "nl": [
      "Ga op avontuur in het hart van een van de mooiste natuurgebieden van de Oise\n\nDe Marais de Sacy, een uitgestrekt water- en veengebied van bijna 1000 hectare, onthullen hun geschiedenis en schoonheid!"
    ],
    "es": [
      "Aventúrese en el corazón de uno de los más bellos parajes naturales del Oise\n\nLos Marais de Sacy, una vasta zona húmeda y de turba de casi 1.000 hectáreas, revelan su historia y su belleza"
    ]
  },
