  "rdfs:comment": {
    "de": [
      "Das Chalet des Vignobles richtet sich für Juli und August in Champagny-le-Haut ein. Teilen Sie mit uns eine angenehme Zeit bei unseren Pferden und Ponys in einer idyllischen Umgebung im Vallon de Champagny-le-Haut im Herzen der Vanoise."
    ],
    "en": [
      "The Chalet des Vignobles has moved to Champagny-le-Haut for July and August.\r\nCome and share a pleasant moment with our horses and ponies in an idyllic setting in the Vallon de Champagny-le-Haut in the heart of the Vanoise."
    ],
    "it": [
      "Lo Chalet des Vignobles si è trasferito a Champagny-le-Haut per luglio e agosto.\r\nVenite a condividere un momento piacevole con i nostri cavalli e pony in un ambiente idilliaco nel Vallon de Champagny-le-Haut, nel cuore della Vanoise."
    ],
    "fr": [
      "Le Chalet des Vignobles s'installe à Champagny-le-Haut pour Juillet et Aout.\r\nVenez partager avec nous un moment agréable auprès de nos chevaux et poneys dans un cadre idyllique dans le Vallon de Champagny-le-Haut au cœur de la Vanoise."
    ],
    "nl": [
      "Het Chalet des Vignobles is voor juli en augustus verhuisd naar de P'tit Ranch in Champagny-le-Haut.\r\nKom en deel met ons een aangenaam moment met onze paarden en pony's in een idyllische omgeving in de Vallon de Champagny le Haut in het hart van de Vanoise."
    ],
    "es": [
      "El Chalet des Vignobles se ha trasladado a Champagny-le-Haut para julio y agosto.\r\nVenga a compartir un momento agradable con nuestros caballos y ponis en un entorno idílico en el Vallon de Champagny-le-Haut, en el corazón de la Vanoise."
    ]
  },
  "rdfs:label": {
