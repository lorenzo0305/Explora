  "rdfs:comment": {
    "de": [
      "MILDISS lädt Sie zu einem ungewöhnlichen & einzigartigen kulinarischen Erlebnis ein. Der Küchenchef und sein Team laden Sie ein, seine Küche zu entdecken, die regionale und lokale Produkte in den Vordergrund stellt."
    ],
    "en": [
      "MILDISS invites you to live an unusual & unique culinary experience. The chef and his team invite you to discover his cuisine featuring regional and local products."
    ],
    "it": [
      "MILDISS vi invita a vivere un'esperienza culinaria insolita e unica. Lo chef e il suo team vi invitano a scoprire la sua cucina, che valorizza i prodotti regionali e locali."
    ],
    "fr": [
      "MILDISS vous invite à vivre une expérience culinaire insolite & unique. Le chef et son équipe vous invite à découvrir sa cuisine mettant en avant les produits régionaux et locaux."
    ],
    "nl": [
      "MILDISS nodigt u uit voor een ongewone en unieke culinaire ervaring. De chef en zijn team nodigen u uit om zijn keuken te ontdekken, waarin regionale en lokale producten centraal staan."
    ],
    "es": [
      "MILDISS le invita a disfrutar de una experiencia culinaria inusual y única. El chef y su equipo le invitan a descubrir su cocina, que destaca los productos regionales y locales."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant MILDISS"
    ],
    "fr": [
      "Restaurant Mildiss"
    ]
  },
