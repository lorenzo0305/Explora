  "rdfs:comment": {
    "de": [
      "Das kleine Dorf La Baume-Cornillane ist der Ausgangspunkt für zahlreiche Wanderungen und den unumgänglichen Pfad, der Sie zum \"Zentrum der Pangäa\" führt."
    ],
    "en": [
      "The small village of La Baume-Cornillane is the starting point for numerous hikes and the not-to-be-missed trail to the \"center of Pangaea\"."
    ],
    "it": [
      "Il piccolo villaggio di La Baume-Cornillane è il punto di partenza di numerose escursioni e dell'imperdibile sentiero che conduce al \"centro della Pangea\"."
    ],
    "fr": [
      "Le petit village de la Baume-Cornillane est le point de départ de nombreuses randonnées et de l’incontournable sentier vous menant  au \"centre de la pangée\"."
    ],
    "nl": [
      "Het kleine dorpje La Baume-Cornillane is het startpunt voor vele wandelingen, waaronder het niet te missen pad naar het \"centrum van Pangaea\"."
    ],
    "es": [
      "El pequeño pueblo de La Baume-Cornillane es el punto de partida de numerosas excursiones y del imperdible sendero que lleva al \"centro de la Pangea\"."
    ]
  },
