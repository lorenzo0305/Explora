  "rdfs:comment": {
    "de": [
      "Ein Weingut  in Familienbesitz. Weinbau mit Respekt vor landwirtschaftlichen Traditionen."
    ],
    "en": [
      "Family vineyard situated to Casteljau, around theChassezac river. We produce and market red, rosé and white wines. We organized guided tours and tasting on the spot."
    ],
    "it": [
      "Azienda vinicola a conduzione familiare situata a Casteljau, intorno alle gole di Chassezac, selezionata da \"Les étapes savoureuses\". Produciamo e vendiamo vini rossi, rosati e bianchi. Si organizzano visite guidate e degustazioni in loco."
    ],
    "fr": [
      "Domaine viticole familial situé à Casteljau, autour des gorges du Chassezac, sélectionné « Les étapes savoureuses ». Nous produisons et commercialisons des vins rouges, rosés et blancs. Des visites guidées et des dégustations sont organisées sur place."
    ],
    "nl": [
      "Proeverij en verkoop"
    ],
    "es": [
      "Bodega familiar situada en Casteljau, en torno a las gargantas de Chassezac, seleccionada por \"Les étapes savoureuses\". Producimos y vendemos vinos tintos, rosados y blancos. Se organizan visitas guiadas y degustaciones in situ."
    ]
  },
