  "rdfs:comment": {
    "de": [
      "Im Rahmen des Art-Deco-Frühlings bieten wir Ihnen diesen Workshop an, um das Art-Deco auf einfache Weise und in einer freundlichen Atmosphäre zu entdecken."
    ],
    "en": [
      "As part of the Printemps de l'Art déco (Art Deco Spring Festival), we offer you this workshop to discover Art Deco in a simple, friendly atmosphere."
    ],
    "it": [
      "Nell'ambito del Printemps de l'Art déco (Festival di primavera dell'Art Déco), proponiamo questo workshop come un modo semplice per scoprire l'Art Déco in un'atmosfera amichevole."
    ],
    "fr": [
      "Dans le cadre du Printemps de l’Art déco, nous vous proposons cet atelier pour découvrir l’Art déco en toute simplicité et dans une ambiance conviviale."
    ],
    "es": [
      "En el marco del Printemps de l'Art déco (Festival de primavera del Art Déco), proponemos este taller para descubrir fácilmente el Art Déco en un ambiente agradable."
    ],
    "nl": [
      "Als onderdeel van de Printemps de l'Art déco (Art Deco Lentefestival) bieden we deze workshop aan als een gemakkelijke manier om Art Deco te ontdekken in een gezellige sfeer."
    ]
  },
