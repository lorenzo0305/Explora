          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "- Eröffnung Hecht : 25/04/2026\r\n- Öffnung Zander : 13/06/2026\r\n- Angeln am Strand: 21/03 ? 05/04/2026\r\n- Verbot des Angelns mit lebenden/toten Fischen + Köder: 21/03 ? 24/04/2026\r\n- Freilassung von Forellen : 17/03 ? 24/03 ? 31/03/2026 (mit Hinweis: eine Rute nur am Tag X + Folgetag)\r\nStändiger Zugang - Angelschein erforderlich"
            ],
            "en": [
              "- Pike opening: 04/25/2026\r\n- Pike-perch opening: 13/06/2026\r\n- Beach fishing: 21/03 ? 05/04/2026\r\n- Ban on fishing with live/dead fish + lures: 21/03 ? 24/04/2026\r\n- Trout releases: 17/03 ? 24/03 ? 03/31/2026 (with mention: one rod only on D-day + following day)\r\nPermanent access - fishing card required"
            ],
            "it": [
              "- Apertura del luccio: 25/04/2026\r\n- Apertura del luccioperca: 13/06/2026\r\n- Pesca sulla spiaggia: 21/03 ? 05/04/2026\r\n- Divieto di pesca con pesci vivi/morti + esche artificiali: 21/03 ? 24/04/2026\r\n- Rilascio di trote: 17/03 ? 24/03 ? 31/03/2026 (con nota: una sola canna il giorno D + il giorno successivo)\r\nAccesso permanente - è richiesta la licenza di pesca"
            ],
            "fr": [
              "- Ouverture brochet : 25/04/2026\r\n- Ouverture sandre : 13/06/2026\r\n- Pêche sur la plage : 21/03 → 05/04/2026\r\n- Interdiction de la pêche au poisson vivant/mort + leurres : 21/03 → 24/04/2026\r\n- Lâchers truites : 17/03 – 24/03 – 31/03/2026 (avec mention : une canne uniquement le jour J + lendemain)\r\nAccès permanent - carte de pêche obligatoire"
            ],
            "nl": [
              "- Opening snoek: 25/04/2026\r\n- Opening snoekbaars: 13/06/2026\r\n- Vissen op het strand: 21/03 ? 05/04/2026\r\n- Verbod op vissen met levende/dode vis + kunstaas: 21/03 ? 24/04/2026\r\n- Uitzetten forel: 17/03 ? 24/03 ? 31/03/2026 (met aantekening: één hengel alleen op D-day + volgende dag)\r\nPermanente toegang - visvergunning verplicht"
            ],
            "es": [
              "- Apertura del lucio: 25/04/2026\r\n- Apertura lucioperca: 13/06/2026\r\n- Pesca en la playa: 21/03 ? 05/04/2026\r\n- Prohibición de la pesca con peces vivos/muertos + señuelos: 21/03 ? 24/04/2026\r\n- Liberación de truchas: 17/03 ? 24/03 ? 31/03/2026 (con nota: una sola caña el día D + el día siguiente)\r\nAcceso permanente - se requiere licencia de pesca"
            ]
          },
