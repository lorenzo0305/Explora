  "rdfs:comment": {
    "de": [
      "Diese Baumschule mit überschaubarer Größe bietet junge Bäume von schöner Qualität: kräftig, mit einem guten Wurzelsystem. Sie werden biologisch angebaut, wobei das Bodenleben respektiert wird."
    ],
    "en": [
      "My human-sized nursery offers you high-quality young trees: vigorous with a good root system. They are grown organically, respecting the life of the soil."
    ],
    "it": [
      "Questo piccolo vivaio offre giovani alberi di alta qualità: vigorosi, con un buon apparato radicale. Sono coltivati in modo biologico, rispettando la vita del suolo."
    ],
    "fr": [
      "Cette pépinière à taille humaine propose des jeunes arbres de belle qualité : vigoureux, dotés d'un bon système racinaire. Ils sont cultivés en agriculture biologique, dans le respect de la vie du sol."
    ],
    "es": [
      "Este vivero a pequeña escala ofrece árboles jóvenes de gran calidad: vigorosos, con un buen sistema radicular. Se cultivan de forma ecológica, respetando la vida del suelo."
    ],
    "nl": [
      "Deze kleinschalige kwekerij biedt jonge bomen van hoge kwaliteit: krachtig, met goede wortelsystemen. Ze worden biologisch gekweekt, met respect voor het leven in de bodem."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tree sales at the Racines et Fruits nursery"
    ],
    "fr": [
      "Vente d'arbres à la pépinière des Racines et des Fruits"
    ]
  },
