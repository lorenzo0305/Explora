  "rdfs:comment": {
    "de": [
      "Das Rathaus von Saint Denis-les-Bourg bietet den Saal La Chaufferie zur Miete an:\r\n- An die Einwohner der Gemeinde\r\n- An Vereine der Gemeinde und externe Vereine\r\n- An die Verwaltungen\r\n- An lokale und externe Unternehmen"
    ],
    "en": [
      "The Mairie de Saint Denis-les-Bourg offers the Chaufferie room for rental:\r\n- Local residents\r\n- Local and outside associations\r\n- Administrations\r\n- Local and external companies"
    ],
    "it": [
      "Il Municipio di Saint Denis-les-Bourg mette a disposizione la sala Chaufferie per il noleggio:\r\n- Residenti locali\r\n- Associazioni locali e associazioni esterne\r\n- Amministrazioni\r\n- Aziende locali ed esterne"
    ],
    "fr": [
      "La Mairie de Saint Denis-les-Bourg propose à la location la salle de La Chaufferie : \r\n- Aux habitants de la commune\r\n- Aux Associations de la commune et associations extérieures\r\n- Aux Administrations\r\n- Aux Entreprises locales et extérieures"
    ],
    "nl": [
      "Het stadhuis van Saint Denis-les-Bourg biedt de Chaufferiezaal te huur aan:\r\n- Buurtbewoners\r\n- Plaatselijke verenigingen en externe verenigingen\r\n- Administraties\r\n- Lokale en externe bedrijven"
    ],
    "es": [
      "El Ayuntamiento de Saint Denis-les-Bourg ofrece en alquiler la sala Chaufferie:\r\n- Vecinos\r\n- Asociaciones locales y asociaciones exteriores\r\n- Administraciones\r\n- Empresas locales y externas"
    ]
  },
