  "rdfs:comment": {
    "de": [
      "Espace VTT - FFC Ambert Livradois-Forez bietet Ihnen 700 km markierte FFC-Strecken. Von Viverols über die Hautes-Chaumes bis nach Ambert können Sie die Panoramen des Livradois-Forez genießen."
    ],
    "en": [
      "Come and explore our landscapes in the region of Ambert, St-Anthème, Prabouré, and Viverols. 700 km of trails, 30 marked paths. Mountain  bike / GPS rentals."
    ],
    "it": [
      "L'Espace VTT - FFC Ambert Livradois-Forez offre 700 km di sentieri segnalati FFC. Da Viverols ad Ambert passando per le Hautes-Chaumes, venite a godervi le viste panoramiche del Livradois-Forez."
    ],
    "fr": [
      "Espace VTT - FFC Ambert Livradois-Forez vous propose ses 700 km de pistes balisées FFC. De Viverols à Ambert en passant par les Hautes-Chaumes, venez profiter des panoramas du Livradois-Forez."
    ],
    "es": [
      "Espace VTT - FFC Ambert Livradois-Forez ofrece 700 km de senderos marcados por el FFC. De Viverols a Ambert pasando por Hautes-Chaumes, venga a disfrutar de las vistas panorámicas del Livradois-Forez."
    ],
    "nl": [
      "Espace VTT - FFC Ambert Livradois-Forez biedt 700 km aan door het FFC gemarkeerde paden. Kom van Viverols naar Ambert via de Hautes-Chaumes en geniet van de panoramische uitzichten van de Livradois-Forez."
    ]
  },
