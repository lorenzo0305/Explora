  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Maurice wurde 1643 umgebaut und vergrößert. Sie bewahrt das alpenländische Barockdekor ihrer Altarbilder aus geschnitztem, polychromem und vergoldetem Holz, insbesondere das Hauptaltarbild, das den heiligen Mauritius von Agaune darstellt."
    ],
    "en": [
      "The church of St. Maurice was transformed and enlarged in the 17th century. It retains the baroque alpine decor of its altarpieces, carved, polychromatic and gilded, including the main altarpiece dedicated to St. Maurice of Agaune."
    ],
    "it": [
      "La chiesa Saint Maurice fu modificata e ampliata nel 1643. Conserva la decorazione barocca alpina dei suoi retabli, in legno scolpito, policromo e dorato, in particolare il retablo principale che rappresenta San Maurizio d'Agauno."
    ],
    "fr": [
      "L'église Saint Maurice est transformée et agrandie en 1643. Elle conserve le décor baroque alpin de ses retables, en bois sculpté, polychrome et doré, notamment le retable principal représentant saint Maurice d'Agaune."
    ],
    "es": [
      "La iglesia de San Mauricio fue transformada y ampliada en 1643. Conserva la decoración barroca alpina de sus retablos, en madera tallada, policromada y dorada, en particular el retablo mayor que representa a San Mauricio de Agaune."
    ],
    "nl": [
      "De kerk van Saint Maurice werd in 1643 verbouwd en vergroot. De altaarstukken in houtsnijwerk, polychroom en verguld hout, met name het hoofdaltaarstuk dat de heilige Maurits van Agaune voorstelt, hebben de alpenbarokke versiering behouden."
    ]
  },
