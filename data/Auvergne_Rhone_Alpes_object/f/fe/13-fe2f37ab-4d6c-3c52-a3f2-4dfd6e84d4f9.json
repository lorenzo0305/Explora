  "rdfs:comment": {
    "de": [
      "Eine bewegende Spannung, die in die Eingeweide geht und aus der Seele spricht: Belfour geht mit Worten und Rock?n?Roll mit demselben Anspruch um. Es ist schön und kraftvoll, intelligent und berührend."
    ],
    "en": [
      "A moving tension that grips the guts and speaks to the soul: Belfour handles words and rock?n?roll with the same exacting standards. Beautiful and powerful, intelligent and touching."
    ],
    "it": [
      "Una tensione commovente che attanaglia le viscere e parla all'anima: Belfour tratta le parole e il rock'n'roll con gli stessi standard esigenti. È bello e potente, intelligente e toccante."
    ],
    "fr": [
      "Une tension émouvante qui prend aux tripes et parle à l’âme : Belfour manie les mots et le rock’n’roll avec la même exigence. C’est beau et puissant, intelligent et touchant."
    ],
    "es": [
      "Una tensión conmovedora que atenaza las entrañas y habla al alma: Belfour maneja las palabras y el rock?n?roll con la misma exigencia. Es hermoso y poderoso, inteligente y conmovedor."
    ],
    "nl": [
      "Een ontroerende spanning die de moed grijpt en tot de ziel spreekt: Belfour hanteert woorden en rock-'n-roll met dezelfde veeleisende normen. Het is mooi en krachtig, intelligent en ontroerend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Belfour"
    ]
  },
