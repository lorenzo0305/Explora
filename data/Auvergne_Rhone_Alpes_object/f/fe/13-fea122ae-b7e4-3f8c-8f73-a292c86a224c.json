  "rdfs:comment": {
    "de": [
      "Die kleine Brauerei „La Canaille“ im Herzen des Forez, im Ort Sail sous Couzan bietet das ganze Jahr handwerklich hergestellte und geschmackvolle Biere!"
    ],
    "en": [
      "Marion and Guillaume of the Brewery \"La Canaille\" propose you home-made\r\nbeers full of taste but also visits, workshops about bier and seminars.\r\n\r\nLa Canaille microbrewery  offers beers for every taste, brewed in the heart of Forez. Come discover and taste them."
    ],
    "it": [
      "Con sede a Sail Sous Couzan, nella Loira (42), la birreria La Canaille vi offre birre tradizionali nel cuore di Forez, in un'ex fabbrica di acqua frizzante che è emblematica del villaggio."
    ],
    "fr": [
      "Basée à Sail Sous Couzan dans la loire (42), la brasserie La Canaille vous propose des bières brassées artisanalement au cœur du Forez, dans une ancienne usine d’eau gazeuse emblématique du village."
    ],
    "es": [
      "Situada en Sail Sous Couzan, en el Loira (42), la cervecería La Canaille le ofrece cervezas elaboradas artesanalmente en el corazón de Forez, en una antigua fábrica de agua con gas emblemática del pueblo."
    ],
    "nl": [
      "De brouwerij La Canaille, gevestigd in Sail Sous Couzan in de Loire (42), biedt traditioneel gebrouwen bieren in het hart van Forez, in een voormalige bruiswaterfabriek die kenmerkend is voor het dorp."
    ]
  },
  "rdfs:label": {
    "de": [
      "Brauerei \"La Canaille\""
    ],
    "en": [
      "“La Canaille” craft brewery"
    ],
    "fr": [
      "Brasserie artisanale \"La Canaille\""
    ]
  },
