  "rdfs:comment": {
    "de": [
      "Geben Sie Ihren Kleidungsstücken und Accessoires ein zweites Leben, indem Sie sie dienstags, donnerstags und samstags von 9:30 bis 12:00 Uhr in der Boutique Nipp's & Frip's abgeben."
    ],
    "en": [
      "Give a second life to your clothes and accessories by dropping them off at Nipp's & Frip's every Tuesday, Thursday and Saturday from 9.30am to 12pm."
    ],
    "it": [
      "Date una seconda vita ai vostri abiti e accessori lasciandoli alla boutique Nipp's & Frip's ogni martedì, giovedì e sabato dalle 9.30 alle 12.00."
    ],
    "fr": [
      "Donnez une seconde vie à vos vêtements et accessoires en les déposant à la boutique Nipp's & Frip's tous les mardis, jeudis et samedis de 9h30 à 12h."
    ],
    "nl": [
      "Geef je kleding en accessoires een tweede leven door ze in te leveren bij de Nipp's & Frip's boetiek, elke dinsdag, donderdag en zaterdag van 9.30 tot 12.00 uur."
