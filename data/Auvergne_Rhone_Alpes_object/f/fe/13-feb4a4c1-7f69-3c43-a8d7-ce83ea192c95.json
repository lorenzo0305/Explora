  "rdfs:comment": {
    "de": [
      "Gemeinsame Verkaufsstelle. Von unseren Bauernhöfen bis zu Ihren Geschmacksnerven: Probieren Sie die hervorragende Frische, die Jahreszeiten und die Vielfalt unserer Region."
    ],
    "en": [
      "Collective sales point. From our farms to your taste buds, try the quality and freshness of our seasonal products and the diversity of our region."
    ],
    "it": [
      "Punto vendita collettivo. Dalle nostre fattorie alle vostre papille gustative, assaporate l'eccellenza della freschezza, delle stagioni e della diversità della nostra regione."
    ],
    "fr": [
      "Point de vente collectif. De nos fermes à vos papilles, goûtez l'excellence de la fraîcheur, des saisons et de la diversité de notre région."
    ],
    "es": [
      "Punto de venta colectivo. Desde nuestras granjas hasta sus papilas gustativas, pruebe la excelencia de la frescura, las estaciones y la diversidad de nuestra región."
    ],
    "nl": [
      "Collectief verkooppunt. Van onze boerderijen tot uw smaakpapillen, proef de kwaliteit van onze verse seizoensproducten en de diversiteit van de streek."
    ]
  },
