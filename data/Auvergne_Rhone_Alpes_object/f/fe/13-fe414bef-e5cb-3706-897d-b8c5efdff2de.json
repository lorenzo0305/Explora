  "rdfs:comment": {
    "de": [
      "Élodie und Yoann Conte bringen ihre Seele und ihre Leidenschaft in diesen außergewöhnlichen Ort ein, an dem die Kunst des Empfangens ihren ganzen Sinn erhält. Hier ist jeder Augenblick eine Einladung zu Geselligkeit, Austausch und Emotionen."
    ],
    "en": [
      "The little brother of the restaurant La Table de Yoann Conte, it offers a first glimpse into Yoann's world. Between lake and mountains, our restaurant welcomes you in a chic setting, where the atmosphere is refined, soft and warm..."
    ],
    "it": [
      "Fratello minore del ristorante La Table de Yoann Conte, offre un primo assaggio del mondo di Yoann. Situato tra il lago e le montagne, il nostro ristorante vi accoglie in un ambiente chic, dove l'atmosfera è raffinata, morbida e calda?"
    ],
    "fr": [
      "Petit frère du restaurant La Table de Yoann Conte, il offre une première découverte de l’univers de Yoann. Entre lac et montagnes, notre restaurant vous accueille dans un décor chic, où l’ambiance est raffinée, douce et chaleureuse…"
    ],
    "nl": [
      "Het kleine broertje van het restaurant La Table de Yoann Conte biedt een eerste voorproefje van de wereld van Yoann. Gelegen tussen het meer en de bergen, verwelkomt ons restaurant u in een chique omgeving, waar de sfeer verfijnd, zacht en warm is?"
    ],
    "es": [
      "Hermano pequeño del restaurante La Table de Yoann Conte, ofrece un primer contacto con el universo de Yoann. Situado entre el lago y las montañas, nuestro restaurante le da la bienvenida a un entorno chic, donde el ambiente es refinado, suave y cálido.."
    ]
  },
