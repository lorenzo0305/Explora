  "rdfs:comment": {
    "de": [
      "\"Le Monaco\", im Herzen der Stadt Thiers gelegen, bietet Ihnen drei Kinosäle und die Möglichkeit, zahlreiche Filme (Essay, junges Publikum, ...) zu sehen."
    ],
    "en": [
      "\"Le Monaco\", located in the heart of the city of Thiers, offers three movie theatres and the possibility to watch many films (essay, young audience, ...)."
    ],
    "it": [
      "\"Le Monaco\", situato nel cuore della città di Thiers, offre tre sale cinematografiche e la possibilità di vedere un'ampia gamma di film (sperimentali, per giovani, ecc.)."
    ],
    "fr": [
      "\" Le Monaco \", situé en plein cœur de la ville de Thiers, vous propose trois salles de cinéma et la possibilité de visionner de nombreux films (essai, jeune public, ...)."
    ],
    "es": [
      "\"Le Monaco\", situado en el corazón de la ciudad de Thiers, ofrece tres salas de cine y la posibilidad de ver una amplia gama de películas (experimentales, para el público joven, etc.)."
    ],
    "nl": [
      "\"Le Monaco\", gelegen in het hart van de stad Thiers, biedt drie bioscopen en de mogelijkheid om een breed scala aan films te bekijken (experimenteel, jong publiek, enz.)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cinéma Le Monaco"
    ]
  },
