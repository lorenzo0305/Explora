  "rdfs:comment": {
    "de": [
      "Ein Barkeeper, zwei Stammgäste, ein Live-Musiker und Geschichten, die durch Ihre Anekdoten zum Leben erweckt werden.\r\nEntdecken Sie diese Galerie von untypischen, aber dennoch sehr realen Charakteren!"
    ],
    "en": [
      "A bartender, two regulars, a live musician and stories that come to life from your anecdotes.\r\nCome and discover this gallery of atypical yet very real characters!"
    ],
    "it": [
      "Un barman, due clienti abituali, un musicista dal vivo e storie che prendono vita dai vostri aneddoti.\r\nVenite a scoprire questa galleria di personaggi insoliti ma molto reali!"
    ],
    "fr": [
      "Un barman, deux habitués, un musicien live et des histoires qui prennent vie à partir de vos anecdotes.\r\nVenez découvrir cette galerie de personnages atypiques mais pourtant bien réels !"
    ],
    "es": [
      "Un camarero, dos clientes habituales, un músico en directo e historias que cobran vida a partir de sus anécdotas.\r\nVenga a descubrir esta galería de personajes insólitos pero muy reales"
    ],
    "nl": [
      "Een barman, twee stamgasten, een live muzikant en verhalen die tot leven komen uit jouw anekdotes.\r\nKom en ontdek deze galerij van ongewone maar zeer echte personages!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle d'impro : \"En terrasse\" - Pièce improvisée avec musicien live"
    ]
  },
