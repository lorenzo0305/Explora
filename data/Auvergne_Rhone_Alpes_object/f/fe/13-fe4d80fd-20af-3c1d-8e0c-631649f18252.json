  "rdfs:comment": {
    "de": [
      "Die \"Amicale des Sapeurs Pompiers\" (Freundeskreis der Feuerwehr) organisiert Erste-Hilfe-Kurse und Auffrischungskurse. Sie nimmt auch am Weihnachtsmarkt in Lagardien teil."
    ],
    "en": [
      "The Amicale des Sapeurs Pompiers organizes first-aid and refresher courses. It also takes part in the Lagardien Christmas market."
    ],
    "it": [
      "L'Associazione dei Vigili del Fuoco organizza corsi di primo soccorso e di aggiornamento. Partecipa inoltre al mercatino di Natale di Lagundo."
    ],
    "fr": [
      "L'amicale des Sapeurs Pompiers organise des formations aux premiers secours et recyclage. Elle participe aussi au marché de Noël Lagardien."
    ],
    "es": [
      "La Asociación de Bomberos organiza cursos de primeros auxilios y de actualización. También participa en el mercado navideño de Lagardía."
    ],
    "nl": [
