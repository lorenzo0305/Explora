  "rdfs:comment": {
    "de": [
      "In Zusammenarbeit mit der Moma Group feiert der ikonische Savoyer Koch Marc Veyrat sein großes Comeback in Me? Megeve! In der ehemaligen Auberge de la Cote 2000 wurde das neue, 100% savoyische Konzept Rural by Marc Veyrat inszeniert."
    ],
    "en": [
      "In partnership with Moma Group, the iconic Savoyard chef Marc Veyrat is making his big return to Megeve! In the former Auberge de la Cote 2000, the new 100% Savoyard concept, Rural by Marc Veyrat, is nestled."
    ],
    "it": [
      "In collaborazione con il Moma Group, l'iconico chef savoiardo Marc Veyrat farà il suo grande ritorno a Megève! Nell'ex Auberge de la Cote 2000 si trova il nuovo concept 100% savoiardo Rural di Marc Veyrat."
    ],
    "fr": [
      "En partenariat avec Moma Group, l’iconique chef Savoyard Marc Veyrat fait son grand retour à Megève ! Dans l’écrin de l’ancienne Auberge de la Cote 2000, se niche le nouveau concept 100% savoyard, Rural by Marc Veyrat."
    ],
    "nl": [
      "In samenwerking met de Moma Group maakt de iconische Savoyaardse chef-kok Marc Veyrat een grote terugkeer naar MegeÃ¨ve Megeïve! In de oude Auberge de la Cote 2000 nestelt zich het nieuwe 100% Savoyaardse concept, Rural by Marc Veyrat."
    ],
    "es": [
      "En colaboración con el Grupo Moma, el emblemático chef de Saboya Marc Veyrat regresa por todo lo alto a Mege?ve ¡Megevé! En el antiguo Auberge de la Cote 2000, anida el nuevo concepto 100% saboyano, Rural by Marc Veyrat."
    ]
  },
