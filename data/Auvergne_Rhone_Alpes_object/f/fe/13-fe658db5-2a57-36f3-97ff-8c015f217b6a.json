  "rdfs:comment": {
    "de": [
      "Das Weingut ist ein Familienbetrieb, den Denise und Charles Grangier 1988 mit 4 ha Wein und 8 ha Obstbäumen gegründet haben. 2002 übernimmt ihr Sohn Roland den Weinbaubetrieb und vergrößert ihn. Heute erstreckt sich das Weingut auf 7.5 ha."
    ],
    "en": [
      "The Domain is a family business founded in 1988 by Denise and Charles Grangier with 4 hectares of vines and 8 hectares of fruit trees. In 2002, Roland, their son, took the wine part and developped it, the vineyard now covers 7.5 hectares."
    ],
    "it": [
      "Il vigneto Roland Grangier è un'azienda familiare fondata nel 2002 da Roland Grangier. Coltiviamo e vinifichiamo 13 ettari di vigneti nelle denominazioni Saint Joseph Rosso e Bianco, Condrieu, Côte Rôtie, Vin de France Syrah e Viognier."
    ],
    "fr": [
      "Le vignoble Roland Grangier est une exploitation familiale créée en 2002 par Roland Grangier. Nous cultivons et vinifions 13 ha et de vigne sur les appellations Saint Joseph  Rouge et Blanc, Condrieu, Côte Rôtie, Vin de France Syrah et Viognier."
    ],
    "es": [
      "El viñedo Roland Grangier es una empresa familiar fundada en 2002 por Roland Grangier. Cultivamos y vinificamos 13 hectáreas de viñedos en las denominaciones Saint Joseph Tinto y Blanco, Condrieu, Côte Rôtie, Vin de France Syrah y Viognier."
    ],
    "nl": [
      "De Roland Grangier wijngaard is een familiebedrijf opgericht in 2002 door Roland Grangier. We cultiveren en vinifiëren 13 hectare wijngaarden in de appellations Saint Joseph Red en White, Condrieu, Côte Rôtie, Vin de France Syrah en Viognier."
    ]
  },
  "rdfs:label": {
    "en": [
