  "rdfs:comment": {
    "de": [
      "Essbare Wildpflanzen, Entdeckung des Lavendels, Familien- oder Sportwanderungen, Panoramawanderungen. Workshops im Wohnwagen: Naturaktivitäten, Herstellung von Balsam mit ätherischen Ölen. Jugendliche/Erwachsene: Orientierungslauf, Biwak am Lagerfeuer."
    ],
    "en": [
      "Wild edible plants, lavender discovery, family or sport hikes, panoramic hikes. Caravan workshops: nature activities, creation of essential oil balms. Young people/adults: orienteering, fireside bivouac."
    ],
    "it": [
      "Piante selvatiche commestibili, scoperta della lavanda, escursioni in famiglia o sportive, escursioni panoramiche. Laboratori in roulotte: attività naturalistiche, creazione di balsami agli oli essenziali. Giovani/adulti: orienteering, bivacco accanto al fuoco."
    ],
    "fr": [
      "Plantes sauvages comestibles, découverte de la lavande, randonnée famille ou sportive, rando panoramique. Ateliers en caravane : activités nature, création de baumes aux huiles essentielles. Jeunes/adultes : course d'orientation, bivouac au coin du feu."
    ],
    "nl": [
      "Wilde eetbare planten, lavendel ontdekken, gezins- of sportwandelingen, panoramische wandelingen. Workshops in de caravan: natuuractiviteiten, balsems maken met essentiële oliën. Jongeren/volwassenen: oriëntatieloop, vuurbivak."
    ],
    "es": [
      "Plantas silvestres comestibles, descubrimiento de la lavanda, caminatas familiares o deportivas, caminatas panorámicas. Talleres en caravana: actividades en la naturaleza, creación de bálsamos de aceites esenciales. Jóvenes/adultos: orientación, vivac junto al fuego."
    ]
  },
