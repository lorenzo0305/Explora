  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Ardèche einmal anders! Quad- und Buggy-Touren unter der Leitung von qualifizierten Guides und Selbstbedienungsverleih von Rollern, Elektromopeds und Rosalies für unvergessliche Ausflüge in Vallon-Pont-d'Arc."
    ],
    "en": [
      "Discover the Ardèche in a different way! Quad bike and buggy rides supervised by qualified guides, and self-service rental of scooters, electric mopeds, and quad bikes for unforgettable rides in Vallon-Pont-d'Arc."
    ],
    "it": [
      "Scoprite l'Ardèche in modo diverso! Escursioni in quad e buggy con guide qualificate e noleggio self-service di scooter, motorini elettrici e rosali per gite indimenticabili a Vallon-Pont-d'Arc."
    ],
    "fr": [
      "Découvrez l’Ardèche autrement ! Randonnées en quads et buggys encadrées par des guides diplômés, et location en libre-service de trottinettes, mobylettes électriques et rosalies pour des balades inoubliables à Vallon-Pont-d’Arc."
    ],
    "es": [
      "¡Descubra la Ardèche de otra manera! Paseos en quad y buggy con guías cualificados, y alquiler en autoservicio de scooters, ciclomotores eléctricos y rosalies para salidas inolvidables en Vallon-Pont-d'Arc."
    ],
    "nl": [
      "Ontdek de Ardèche op een andere manier! Quad- en buggytochten onder begeleiding van gediplomeerde gidsen en zelfbedieningsverhuur van steps, elektrische bromfietsen en rosalies voor onvergetelijke tochten in Vallon-Pont-d'Arc."
    ]
  },
