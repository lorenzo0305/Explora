  "rdfs:comment": {
    "de": [
      "Mieten Sie ein Fahrrad mit Elektrounterstützung und entdecken Sie unsere Gegend auf eine andere Art und Weise! Nehmen Sie sich Zeit, um die Landschaft zu genießen... mit weniger Anstrengung!\r\nWir schlagen Ihnen verschiedene Touren vor."
    ],
    "en": [
      "Electric Bikes available at the tourism office in Lalouvesc."
    ],
    "it": [
      "Noleggiate una bicicletta a pedalata assistita e scoprite la nostra regione in modo diverso! Prendetevi il tempo per godervi la campagna... con meno fatica!\r\nVerranno fornite idee per i tour."
    ],
    "fr": [
      "Louez un Vélo à assistance électrique pour découvrir notre territoire d'une manière différente! Prenez le temps d’apprécier les paysages... à moindre efforts! \r\nDes idées de circuits vous seront proposées."
    ],
    "nl": [
      "Huur een elektrisch ondersteunde fiets en ontdek onze streek op een andere manier! Neem de tijd om van het platteland te genieten... met minder inspanning!\r\nIdeeën voor tochten zullen worden verstrekt."
    ],
    "es": [
      "Alquile una bicicleta con asistencia eléctrica y descubra nuestra región de otra manera Tómese su tiempo para disfrutar del campo... ¡con menos esfuerzo!\r\nSe le proporcionarán ideas para las excursiones."
    ]
  },
  "rdfs:label": {
    "en": [
      "Electric bikes"
    ],
    "fr": [
      "Location de vélos à assistance électrique"
    ]
  },
