  "rdfs:comment": {
    "de": [
      "Der Tennis Club du Lac verfügt über 4 Plätze, von denen sich drei in Charavines und einer in Paladru befinden. Stundentickets (für die Außenplätze) sind im Tourismusbüro in Charavines oder über die anybuddy-App erhältlich."
    ],
    "en": [
      "Tennis Club du Lac has 4 courts, three of which are located in Charavines, the last one being in Paladru. Time tickets (for outdoor courts) are on sale at the Charavines Tourist Office or via the anybuddy app."
    ],
    "it": [
      "Il Tennis Club du Lac dispone di 4 campi, tre a Charavines e uno a Paladru. I biglietti a tempo (per i campi all'aperto) sono in vendita presso l'Ufficio del Turismo di Charavines o tramite l'app anybuddy."
    ],
    "fr": [
      "Le Tennis Club du Lac dispose de 4 courts, trois d'entre eux situés à Charavines et l'autre à Paladru. Des tickets horaire (pour les courts extérieurs) sont en vente à l'Office de Tourisme de Charavines ou via l'application anybuddy."
    ],
    "es": [
      "El Tennis Club du Lac dispone de 4 pistas, tres en Charavines y una en Paladru. Las entradas (para las pistas exteriores) están a la venta en la Oficina de Turismo de Charavines o a través de la aplicación anybuddy."
    ],
    "nl": [
      "De Tennis Club du Lac heeft 4 banen, drie in Charavines en één in Paladru. Tijdkaarten (voor de buitenbanen) zijn te koop bij het toeristenbureau van Charavines of via de applicatie anybuddy."
    ]
  },
