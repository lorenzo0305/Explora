  "rdfs:comment": {
    "de": [
      "Handwerkliche Werkstatt zur Verarbeitung von Fleisch und Produkten vom Bauernhof: Würste, Konserven (Wachteln, Pasteten...), Frischprodukte..."
    ],
    "en": [
      "Local artisan butcher producing cold cuts such as saucisson, meat preserves (pâtés, caillettes) and fresh meat products."
    ],
    "it": [
      "Laboratorio di trasformazione tradizionale di carne e prodotti agricoli: salsicce, conserve (caillettes, paté, ecc.), prodotti freschi, ecc.\nLavori su commissione e fornitura di servizi\nCatering per eventi, con consegna o in loco"
    ],
    "fr": [
      "Atelier artisanal de transformation de viandes et produits fermiers : saucissons, conserves (caillettes, pâtés...), produits frais...\nTravail à façon et prestation de services\nTraiteur évènementiel, livraison ou sur place"
    ],
    "es": [
      "Taller tradicional de transformación de productos cárnicos y de granja: embutidos, conservas (caillettes, patés, etc.), productos frescos, etc.\nTrabajos por encargo y prestación de servicios\nCatering para eventos, a domicilio o in situ"
    ],
    "nl": [
      "Ambachtelijke werkplaats voor de verwerking van vlees en boerderijproducten: worst, ingemaakt vlees (varkenspasteitjes, paté's...), verse producten…"
    ]
  },
  "rdfs:label": {
