  "rdfs:comment": {
    "de": [
      "Dorf Montclard: Kirche mit Kammglockenturm. Chapelle de La Trinité aus dem 19. Jahrhundert. Ruinen des Château de Cusse aus dem 12. Jahrhundert (privat). Steinkreuz."
    ],
    "en": [
      "Village of Montclard: Church with combed bell tower. 19th-century La Trinité chapel. Ruins of the 12th-century Château de Cusse (private). Stone cross."
    ],
    "it": [
      "Villaggio di Montclard: chiesa con campanile a pettine. Cappella della Trinità (XIX secolo). Rovine del castello di Cusse del XII secolo (privato). Croce di pietra."
    ],
    "fr": [
      "Village de Montclard : Église à clocher peigne. Chapelle de La Trinité du XIXe siècle. Ruines du Château de Cusse du XIIe siècle (privé). Croix en pierre."
    ],
    "es": [
      "Pueblo de Montclard: Iglesia con campanario peinado. Capilla de la Trinité (siglo XIX). Ruinas del castillo de Cusse (privado) del siglo XII. Cruz de piedra."
    ],
    "nl": [
      "Dorp Montclard: Kerk met gekamde klokkentoren. Kapel van La Trinité (19e eeuw). Ruïnes van het kasteel van Cusse uit de 12e eeuw (privé). Stenen kruis."
    ]
  },
