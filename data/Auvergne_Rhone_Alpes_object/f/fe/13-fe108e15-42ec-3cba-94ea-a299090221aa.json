  "rdfs:comment": {
    "de": [
      "Familiengeführte Süßwarenfabrik mit dem Gütesiegel \"Entreprise du Patrimoine Vivant\" (Unternehmen des lebendigen Erbes). La compagnie d'Ancône stellt Nougat, Calissons, provenzalische Kekse und andere Leckereien nach Originalrezepten und mit einer strengen Auswahl der Rohstoffe her."
    ],
    "en": [
      "Family confectionery, labeled Living Heritage Company. La compagnie d'Ancône makes Nougat, Calissons, Provencal Biscuits and other delicacies in the respect of the original recipes, with a rigorous selection of raw materials."
    ],
    "it": [
      "Pasticceria a conduzione familiare con il marchio Entreprise du Patrimoine Vivant (Azienda del Patrimonio Vivente). L'Amandoria produce torrone, calissons, biscotti provenzali e altre prelibatezze secondo le ricette originali, con una rigorosa selezione delle materie prime."
    ],
    "fr": [
      "Confiserie familiale, labélisée Entreprise du Patrimoine Vivant. L'Amandoria confectionne Nougat, Calissons, Biscuits provençaux et autres gourmandises dans le respect des recettes d'origine, avec une sélection rigoureuse des matières premières."
    ],
    "es": [
      "Una pastelería familiar con el sello Entreprise du Patrimoine Vivant (Empresa del Patrimonio Vivo). L'Amandoria elabora turrones, calissons, galletas provenzales y otras delicias según las recetas originales, con una rigurosa selección de materias primas."
    ],
    "nl": [
      "Familie banketbakkerij, gelabeld als een Living Heritage Company. La compagnie d'Ancône maakt Nougat, Calissons, Provençaalse koekjes en andere lekkernijen volgens de originele recepten, met een strenge selectie van de grondstoffen."
    ]
  },
