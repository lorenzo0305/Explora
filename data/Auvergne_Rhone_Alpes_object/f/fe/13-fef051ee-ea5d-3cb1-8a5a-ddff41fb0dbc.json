  "rdfs:comment": {
    "de": [
      "7ici ist ein Kollektiv von Designern, Künstlern und Kunsthandwerkern, die sich in einer gemütlichen Boutique-Atelier zusammengeschlossen haben, die ideal im belebten Viertel Bas des Pentes gelegen ist: Willkommen im Reich des \"Handgemachten\" mit Liebe!"
    ],
    "en": [
      "7ici is a collective of designers, artists and craftspeople working together in a cosy boutique-workshop ideally located in the bustling \"Bas des Pentes\" district: welcome to the realm of handmade with love!"
    ],
    "it": [
      "7ici è un collettivo di designer, artisti e artigiani che si sono riuniti in un'accogliente boutique-laboratorio situata nel vivace quartiere di Bas des Pentes: benvenuti nel regno del \"fatto a mano\" con amore!"
    ],
    "fr": [
      "7ici est un collectif de créateur-ices, d’artistes et d’artisan-es regroupés au sein d’une chaleureuse Boutique-Atelier idéalement située dans le quartier très animé du bas des pentes : bienvenue dans le royaume du “Fait-main” avec amour !"
    ],
    "nl": [
      "7ici is een collectief van ontwerpers, kunstenaars en ambachtslieden die zijn samengekomen in een gezellige boetiek-werkplaats, ideaal gelegen in de bruisende wijk Bas des Pentes: welkom in het rijk van \"handgemaakt\" met liefde!"
    ],
    "es": [
      "7ici es un colectivo de diseñadores, artistas y artesanos que se han reunido en una acogedora tienda-taller idealmente situada en el animado barrio de Bas des Pentes: ¡bienvenidos al reino del \"hecho a mano\" con amor!"
    ]
  },
