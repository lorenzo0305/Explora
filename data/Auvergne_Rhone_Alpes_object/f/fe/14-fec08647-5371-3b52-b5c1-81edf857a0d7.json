  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/16ad5290-91ed-372f-ade1-8b38581aecc0",
      "dc:description": {
        "de": [
          "Bis zu sieben Musiker auf der Bühne für eine atemberaubende Show!\nDie Stimme, die Interpretation, die Kostüme, alles ist da, um eine Show zu reproduzieren, die der Flamboyanz von Sir Elton gerecht wird!"
        ],
        "en": [
          "Up to 7 musicians on stage, for a breathtaking show!\nThe voice, the performance, the costumes - all the elements are there to reproduce a show worthy of Sir Elton?s flamboyance!"
        ],
        "it": [
          "Fino a 7 musicisti sul palco per uno spettacolo mozzafiato!\nLa voce, la performance, i costumi: ci sono tutti gli elementi per ricreare uno spettacolo degno dell'estro di Sir Elton!"
        ],
        "fr": [
          "Jusqu’à 7 musiciens sur scène, pour un show époustouflant !\nLa voix, l’interprétation, les costumes, tous les éléments sont là pour reproduire un show à la hauteur de la flamboyance de Sir Elton !"
        ],
        "es": [
          "¡Hasta 7 músicos en el escenario para un espectáculo impresionante!\nLa voz, la interpretación, el vestuario... ¡todos los elementos están ahí para recrear un espectáculo digno de la extravagancia de Sir Elton!"
        ],
        "nl": [
          "Tot 7 muzikanten op het podium voor een adembenemende show!\nDe stem, het optreden, de kostuums - alle elementen zijn aanwezig om een show neer te zetten die Sir Elton's flamboyantie waardig is!"
        ]
      },
