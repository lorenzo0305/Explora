  "rdfs:comment": {
    "de": [
      "Sehr schönes Freizeitzentrum mit 3 Seen, die Sie für alle Ihre Freizeitaktivitäten willkommen heißen: Angeln, Schwimmen und Paddeln, Windsurfen, Spazierengehen und Faulenzen sowie zahlreiche andere Aktivitäten vor Ort: Gesundheitsparcours, Volleyballfeld, Tischtennisplatte."
    ],
    "en": [
      "Very beautiful leisure center with its 3 lakes which welcome you for all your leisure activities: fishing, swimming and paddle, windsurfing, walking and relaxing and many other activities on site: fitness trail, volleyball court, ping-pong table."
    ],
    "it": [
      "Bellissimo centro ricreativo con i suoi 3 laghi che vi accolgono per tutte le vostre attività ricreative: pesca, nuoto e paddle, windsurf, passeggiate e relax e tante altre attività sul posto: percorso vita, campo da pallavolo, tavolo da ping-pong."
    ],
    "fr": [
      "Très belle base de loisirs avec ses 3 lacs qui vous accueillent pour tous vos loisirs : pêche, baignade et paddle, planche à voile, promenade et farniente et de nombreuses autres activités sur place : parcours santé, terrain de volley, table de ping-pong."
    ],
    "es": [
      "Un hermoso centro de ocio con 3 lagos para todas sus actividades de ocio: pesca, natación y paddle-board, windsurf, senderismo y relajación, y muchas otras actividades en el sitio: pista de fitness, cancha de voleibol, mesa de ping-pong."
    ],
    "nl": [
      "Een prachtig recreatiecentrum met 3 meren voor al je vrijetijdsactiviteiten: vissen, zwemmen en paddleboarden, windsurfen, wandelen en ontspannen, en vele andere activiteiten ter plaatse: fitnessparcours, volleybalveld, tafeltennistafel."
    ]
  },
