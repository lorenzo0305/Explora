  "rdfs:comment": {
    "de": [
      "Am Sonntag, den 19. April 2026, organisiert der Verein FitRunSports den 7. Puy Urban Trail, um Ihnen die Möglichkeit zu geben, die Stadt Le Puy-en-Velay aus einem neuen Blickwinkel zu entdecken!"
    ],
    "en": [
      "On Sunday, April 19, 2026, the FitRunSports association will give you the chance to discover the town of Le Puy-en-Velay from a whole new angle by organizing the 7th edition of the Puy Urban Trail!"
    ],
    "it": [
      "Domenica 19 aprile 2026, l'associazione FitRunSports vi permetterà di scoprire la città di Le Puy-en-Velay da un punto di vista completamente nuovo, organizzando la 7ª edizione del Puy Urban Trail!"
    ],
    "fr": [
      "Le Dimanche 19 avril 2026, l’association FitRunSports vous permettra de venir découvrir la ville du Puy-en-Velay sous un nouvel angle grâce à l’organisation de la 7ème édition du Puy Urban Trail !"
    ],
    "nl": [
      "Op zondag 19 april 2026 geeft de vereniging FitRunSports je de kans om de stad Le Puy-en-Velay van een heel andere kant te ontdekken door de 7e editie van de Puy Urban Trail te organiseren!"
    ],
    "es": [
      "El domingo 19 de abril de 2026, la asociación FitRunSports le dará la oportunidad de descubrir la ciudad de Le Puy-en-Velay desde un nuevo ángulo organizando la 7ª edición del Puy Urban Trail"
    ]
  },
  "rdfs:label": {
    "fr": [
