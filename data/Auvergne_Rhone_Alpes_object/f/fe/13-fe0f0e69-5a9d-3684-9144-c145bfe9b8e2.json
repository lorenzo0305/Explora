  "rdfs:comment": {
    "de": [
      "Unglaubliche Gefühle, unvergleichliche Geschwindigkeit, schwindelerregende Weite... Einzigartig in den Alpen!  Bequem in einem Gurtzeug sitzend, fliegen Sie mit fast 100 km/h und in einer Höhe von bis zu 240 m über den Weiler Plaine-Dranse."
    ],
    "en": [
      "From the sky the countryside looks completely different!!! Don't deny yourself the chance for some spine-tingling thrills, come and flirt with the clouds!!! In Châtel, you really can fly."
    ],
    "it": [
      "Sensazioni incredibili, velocità ineguagliabile, ampiezza vertiginosa? Unico nelle Alpi!  Comodamente seduti in un'imbracatura, si vola sopra il borgo di Plaine-Dranse a quasi 100 km/h e fino a 240 m di altezza."
    ],
    "fr": [
      "Sensations incroyables,vitesse inégalée, amplitude vertigineuse… Unique dans les Alpes !  Confortablement installé dans un harnais, vous survolez à presque 100 km/h et jusqu’à 240 m de haut, le hameau de Plaine-Dranse."
    ],
    "es": [
      "Sensaciones increíbles, velocidad inigualable, amplitud vertiginosa.. ¡Único en los Alpes!  Cómodamente instalado en un arnés, volarás sobre la aldea de Plaine-Dranse a casi 100 km/h y hasta 240 m de altura."
    ],
    "nl": [
      "Ongelooflijke sensaties, ongeëvenaarde snelheid, duizelingwekkende amplitude... Uniek in de Alpen!  Comfortabel geïnstalleerd in een harnas vliegt u met bijna 100 km/u en tot op 240 m hoogte over het gehucht Plaine-Dranse."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fantasticable im Sommer"
    ],
    "en": [
      "The Fantasticable in summer"
    ],
    "fr": [
      "Fantasticable en été"
    ],
    "nl": [
      "Fantasticable in de zomer"
    ]
  },
