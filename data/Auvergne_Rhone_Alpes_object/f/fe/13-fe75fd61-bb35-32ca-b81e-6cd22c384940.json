  "rdfs:comment": {
    "de": [
      "Willkommen bei Chez Nous in Taninges.\r\nWir sind stolz darauf, Ihnen einen gemütlichen Raum, qualitativ hochwertige Burger und Pizzen und eine freundliche Atmosphäre bieten zu können.\r\nOb Sie allein, mit der Familie oder mit Freunden kommen, Chez Nous ist der ideale Ort, um sich zu entspannen und zu genießen."
    ],
    "en": [
      "Welcome to Chez Nous in Taninges.\r\nWe're proud to offer you a welcoming space, quality burgers and pizzas and a friendly atmosphere.\r\nWhether you're alone, with family or friends, Chez Nous is the place to relax and enjoy."
    ],
    "it": [
      "Benvenuti da Chez Nous a Taninges.\r\nSiamo orgogliosi di offrirvi uno spazio accogliente, hamburger e pizze di qualità e un'atmosfera amichevole.\r\nChe siate da soli, in famiglia o con gli amici, Chez Nous è il luogo perfetto per rilassarsi e divertirsi."
    ],
    "fr": [
      "Bienvenue Chez Nous à Taninges.\r\nNous sommes fiers de vous offrir un espace chaleureux, des burgers et pizzas de qualité et une ambiance conviviale.\r\nQue vous soyez seul, en famille ou entre amis, Chez Nous est l'endroit idéal pour se détendre et profiter."
    ],
    "nl": [
      "Welkom bij Chez Nous in Taninges.\r\nWe zijn er trots op dat we je een gezellige ruimte, kwaliteitshamburgers en -pizza's en een vriendelijke sfeer kunnen bieden.\r\nOf je nu alleen bent, met familie of vrienden, Chez Nous is de perfecte plek om te ontspannen en te genieten."
    ],
    "es": [
      "Bienvenido a Chez Nous en Taninges.\r\nEstamos orgullosos de ofrecerte un espacio acogedor, hamburguesas y pizzas de calidad y un ambiente agradable.\r\nTanto si está solo, en familia o con amigos, Chez Nous es el lugar perfecto para relajarse y disfrutar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Restaurant Pizzéria Chez nous"
    ]
  },
