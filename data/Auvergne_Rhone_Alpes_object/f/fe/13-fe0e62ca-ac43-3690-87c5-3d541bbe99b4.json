  "rdfs:comment": {
    "de": [
      "Die Semaine de la Danse bietet professionelle Aufführungen, Workshops und neue Begegnungen. Sie trägt so dazu bei, die choreografische Kunst in der Region zu verbreiten und möglichst viele Menschen für die Freude am Tanz zu sensibilisieren."
    ],
    "en": [
      "La Semaine de la Danse offers professional performances, participatory workshops and original encounters. It helps to raise the profile of choreographic art in the region, and introduces as many people as possible to the pleasures of dance."
    ],
    "it": [
      "La Semaine de la Danse propone spettacoli professionali, laboratori partecipativi e incontri originali. Contribuisce a far conoscere l'arte coreografica nella regione e introduce il maggior numero possibile di persone al piacere della danza."
    ],
    "fr": [
      "La Semaine de la Danse propose des spectacles professionnels, des ateliers participatifs et des rencontres inédites. Elle contribue ainsi à faire rayonner l’art chorégraphique sur le territoire et sensibilise le plus grand nombre au plaisir de la danse."
    ],
    "es": [
      "La Semaine de la Danse ofrece espectáculos profesionales, talleres participativos y encuentros originales. Contribuye a dar a conocer el arte coreográfico en la región e introduce al mayor número posible de personas en los placeres de la danza."
    ],
    "nl": [
      "La Semaine de la Danse biedt professionele voorstellingen, participatieve workshops en originele ontmoetingen. Het helpt de choreografische kunst in de regio onder de aandacht te brengen en laat zoveel mogelijk mensen kennismaken met het plezier van dans."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Semaine de la Danse - 4ème édition"
    ]
  },
