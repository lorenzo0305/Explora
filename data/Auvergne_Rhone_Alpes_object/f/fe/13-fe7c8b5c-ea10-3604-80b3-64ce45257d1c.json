  "rdfs:comment": {
    "de": [
      "Für Ihre Fahrradtouren mit der Familie auf dem Grünen Weg Via Fluvia bietet Ihnen Le Neyrial einen Verleih von Straßenfahrrädern (VTC Erwachsene und Kinder) und VAE (Vélos à Assistance Electrique). Die Einrichtung trägt das Gütesiegel ACCUEILVELO."
    ],
    "en": [
      "For your family cycling outings on the Via Fluvia greenway, Le Neyrial offers road bike rentals (VTC adults and children) and VAE (Vélos à Assistance Electrique). ACCUEILVELO label."
    ],
    "it": [
      "Per le vostre gite in bicicletta in famiglia sulla Via Fluvia, Le Neyrial offre il noleggio di biciclette da strada (VTC adulti e bambini) e VAE (Vélos à Assistance Electrique). Questo stabilimento ha il marchio ACCUEILVELO."
    ],
    "fr": [
      "Pour vos sorties vélos en famille sur la voie verte Via Fluvia, le Neyrial vous propose des location de vélos route (VTC adultes et enfants) et des VAE (Vélos à Assistance Electrique). Etablissement labellisé ACCUEILVELO."
    ],
    "nl": [
      "Voor uw fietstochten met het gezin op de groene weg Via Fluvia kunt u bij Le Neyrial racefietsen (VTC volwassenen en kinderen) en VAE (Vélos à Assistance Electrique) huren. Dit etablissement heeft het ACCUEILVELO label."
    ],
    "es": [
      "Para sus paseos en bicicleta en familia por la vía verde de la Via Fluvia, Le Neyrial le propone el alquiler de bicicletas de carretera (VTC adultos y niños) y VAE (Vélos à Assistance Electrique). Este establecimiento cuenta con la etiqueta ACCUEILVELO."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Neyrial - Location de vélos"
    ]
  },
