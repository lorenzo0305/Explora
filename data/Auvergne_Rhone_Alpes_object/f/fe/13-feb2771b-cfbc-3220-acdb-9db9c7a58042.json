  "rdfs:comment": {
    "de": [
      "Die Abtei Notre Dame de Bosquet stammt aus dem 12. Jahrhundert. Sie wurde zunächst von Nonnen bewohnt. Später wurde die Abtei in eine Spinnerei umgewandelt und vergrößert. Danach wurde sie von der Gruft Cellier des Dauphins belegt."
    ],
    "en": [
      "Notre Dame de Bosquet Abbey dates back to the 12th century. It was first occupied by nuns. The abbey was later transformed into a spinning mill, and enlarged. It was later occupied by the Cellier des Dauphins winery."
    ],
    "it": [
      "L'Abbazia di Notre Dame de Bosquet risale al XII secolo. Inizialmente fu occupato da suore. L'abbazia fu poi trasformata in filanda e ampliata. In seguito è stato occupato dalla cantina Cellier des Dauphins."
    ],
    "fr": [
      "L'Abbaye Notre Dame de Bosquet date du 12ème siècle. Elle fut d'abord occupée par des religieuses. L'abbaye a été transformée par la suite en filature, et agrandie. Ensuite le caveau Cellier des Dauphins l'a occupé."
    ],
    "es": [
      "La abadía de Notre Dame de Bosquet data del siglo XII. Primero fue ocupado por monjas. Posteriormente, la abadía se transformó en una hilandería y se amplió. Más tarde fue ocupada por la bodega Cellier des Dauphins."
    ],
    "nl": [
      "De abdij Notre Dame de Bosquet dateert uit de 12e eeuw. Het werd eerst bewoond door nonnen. De abdij werd later omgebouwd tot een spinnerij en vergroot. Later werd het bewoond door de kelder van Cellier des Dauphins."
    ]
  },
