  "rdfs:comment": {
    "de": [
      "Gaumenschmaus und Augenweide: La Calèche ist ein authentischer Ort der Gastronomie in Chamonix, der Sie inmitten von antiken Gegenständen empfängt, die eines savoyischen Museums aus vergangenen Zeiten würdig sind."
    ],
    "en": [
      "A treat for the taste buds and a treat for the eyes, La Calèche is an authentic Chamonix restaurant that welcomes you in the midst of antique objects worthy of a Savoyard museum of the past."
    ],
    "it": [
      "Una delizia per il palato e per gli occhi, La Calèche è un autentico ristorante di Chamonix che vi accoglie in mezzo a oggetti antichi degni di un museo savoiardo del passato."
    ],
    "fr": [
      "Régal des papilles et régal des yeux, La Calèche est un lieu authentique de la restauration chamoniarde qui vous accueille au milieu d'objets anciens dignes d'un musée savoyard d'autrefois."
    ],
    "es": [
      "Un placer para el paladar y una fiesta para la vista, La Calèche es un auténtico restaurante de Chamonix que le acoge en medio de objetos antiguos dignos de un museo saboyano del pasado."
    ],
    "nl": [
      "La Calèche, een genot voor de smaakpapillen en een lust voor het oog, is een authentiek restaurant in Chamonix dat u verwelkomt te midden van antieke voorwerpen die een Savoyaards museum uit het verleden waardig zijn."
    ]
  },
