  "rdfs:comment": {
    "de": [
      "Die Bar ist die Seele des Hotels und wird jeden Abend von unserem Pianisten zum Leben erweckt\r\nBegleitet vom sanften Knistern des Feuers können Sie sich hier bei einem Drink austauschen."
    ],
    "en": [
      "The bar is the heart and soul of the hotel – a pianist plays in the evening.\r\nHotel guests and outside visitors can sit and enjoy each other's company and a drink in front of a crackling fire."
    ],
    "it": [
      "Il bar è la vera anima dell'hotel ed è animato ogni sera dagli accordi del nostro pianista\r\nAccompagnati dal dolce crepitio del fuoco, prendetevi il tempo di chiacchierare davanti a un drink."
    ],
    "fr": [
      "Véritable âme de l’hôtel, le bar s’anime chaque soir des accords de notre pianiste. \r\nAccompagnés du doux crépitement du feu, venez prendre le temps d’échanger autour d’un verre."
    ],
    "es": [
      "El bar es el verdadero alma del hotel, y se anima cada noche con los acordes de nuestro pianista\r\nAcompañado por el suave crepitar del fuego, venga y tómese el tiempo de charlar mientras toma una copa."
    ],
    "nl": [
      "De bar is de echte ziel van het hotel en komt elke avond tot leven met de akkoorden van onze pianist.\r\nBegeleid door het zachte geknetter van het vuur kunt u hier de tijd nemen voor een gesprek onder het genot van een drankje."
    ]
  },
