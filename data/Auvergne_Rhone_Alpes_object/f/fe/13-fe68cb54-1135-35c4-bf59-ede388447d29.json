  "rdfs:comment": {
    "de": [
      "Swing 37 ist eine Gypsy-Jazz-Band aus der Touraine, deren Musiker eine herzliche Komplizenschaft pflegen und ihr Publikum mit ihren ausgelassenen Improvisationen und ihrer\r\nansteckend gute Laune!"
    ],
    "en": [
      "Swing 37 is a gypsy jazz band based in Touraine, France, whose musicians share a warm complicity and delight their audience with their wild improvisations and infectious good humor\r\ninfectious good humor!"
    ],
    "it": [
      "Swing 37 è un gruppo gypsy jazz con sede in Touraine, Francia, i cui musicisti hanno un rapporto caldo e amichevole tra loro e deliziano il pubblico con le loro improvvisazioni selvagge e il loro contagioso buonumore\r\nbuonumore contagioso!"
    ],
    "fr": [
      "Swing 37 est un groupe de Jazz manouche, basé en Touraine, dont les musiciens ont une chaleureuse complicité et régalent leur auditoire par leurs improvisations échevelées et leur \r\nbonne humeur communicative !"
    ],
    "nl": [
      "Swing 37 is een zigeunerjazzgroep uit Touraine, Frankrijk, waarvan de muzikanten een warme, vriendelijke band met elkaar hebben en hun publiek verblijden met hun wilde improvisaties en aanstekelijke goede humeur\r\naanstekelijk goed humeur!"
    ],
    "es": [
      "Swing 37 es un grupo de jazz gitano de Touraine (Francia), cuyos músicos tienen una relación cordial y amistosa entre sí y deleitan al público con sus salvajes improvisaciones y su contagioso buen humor\r\n¡buen humor contagioso!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Swing 37"
    ]
  },
