  "rdfs:comment": {
    "de": [
      "Im Herzen von Vogüé Gare, nur 1 km vom Dorf Vogüé entfernt, verwöhnt Sie Le Cabanon des Pizzas mit handgemachten Pizzas, knusprigem Teig und hochwertigen Zutaten, die Sie vor Ort genießen oder mitnehmen können."
    ],
    "en": [
      "In the heart of Vogüé Gare, just 1 km from the village of Vogüé, Le Cabanon des Pizzas delights you with artisanal pizzas, crispy dough and quality ingredients, to eat in or take away."
    ],
    "it": [
      "Nel cuore di Vogüé Gare, a solo 1 km dal villaggio di Vogüé, Le Cabanon des Pizzas serve pizze fatte in casa con pasta croccante e ingredienti di qualità, da mangiare o da portare via."
    ],
    "fr": [
      "Au cœur de Vogüé Gare, à seulement 1 km du village de Vogüé, Le Cabanon des Pizzas vous régale avec des pizzas artisanales, pâte croustillante et ingrédients de qualité, à déguster sur place ou à emporter."
    ],
    "nl": [
      "In het hart van Vogüé Gare, op slechts 1 km van het dorp Vogüé, serveert Le Cabanon des Pizzas huisgemaakte pizza's met knapperig deeg en kwaliteitsingrediënten, om te eten of mee te nemen."
    ],
    "es": [
      "En el corazón de la Gare de Vogüé, a sólo 1 km del pueblo de Vogüé, Le Cabanon des Pizzas sirve pizzas caseras con masa crujiente e ingredientes de calidad, para comer en el restaurante o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au cabanon des pizzas"
    ]
  },
