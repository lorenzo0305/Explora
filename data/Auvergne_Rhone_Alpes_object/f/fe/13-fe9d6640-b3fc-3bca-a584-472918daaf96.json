  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Die Kirche Notre-Dame, von der nur der Chor und die Apsiden aus dem 12. Jahrhundert stammen, verdankt ihre Bewahrung vor Plünderungen der Tatsache, dass sie von den Mauern der Burg eingeschlossen war."
    ],
    "en": [
      "Free visit with document. The church of Notre-Dame, of which only the choir and the apses date from the 12th century, owes its preservation against looting to the fact that it was enclosed within the castle walls."
    ],
    "it": [
      "Visita gratuita con documentazione. La chiesa di Notre-Dame, di cui solo il coro e le absidi risalgono al XII secolo, deve la sua conservazione contro i saccheggi al fatto che era racchiusa nelle mura del castello."
    ],
    "fr": [
      "Visite libre avec document. L'église Notre-Dame, dont seuls le chœur et les absides datent du XIIe siècle, doit sa préservation contre les pillages au fait qu'elle était enclose dans l'enceinte du château."
    ],
    "es": [
      "Visita gratuita con documentación. La iglesia de Notre-Dame, de la que sólo el coro y los ábsides datan del siglo XII, debe su conservación contra los saqueos al hecho de estar encerrada dentro de los muros del castillo."
    ],
    "nl": [
      "Gratis bezoek met documentatie. De kerk Notre-Dame, waarvan alleen het koor en de absiden dateren uit de 12e eeuw, dankt haar behoud tegen plunderingen aan het feit dat zij binnen de kasteelmuren was ingesloten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Notre-Dame"
    ]
  },
