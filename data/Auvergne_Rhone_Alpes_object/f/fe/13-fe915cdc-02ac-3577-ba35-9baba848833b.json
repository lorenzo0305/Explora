  "rdfs:comment": {
    "de": [
      "Zwischen Rhone und Saône, an der Ecke einer kleinen Straße, wird Ihnen Le Casse Museau seine Geheimnisse enthüllen, sobald Sie die Tür durchschreiten."
    ],
    "en": [
      "Between the Rhone and Saône rivers, just around the corner, Le Casse Museau will reveal its secrets to you as soon as you walk through the door."
    ],
    "it": [
      "Tra i fiumi Rodano e Saona, proprio dietro l'angolo, Le Casse Museau vi svelerà i suoi segreti non appena varcherete la porta."
    ],
    "fr": [
      "Entre Rhone et Saône, au détour d’une petite rue, Le Casse Museau saura vous dévoiler ses secrets dès que vous franchirez la porte."
    ],
    "nl": [
      "Tussen de Rhône en de Saône, net om de hoek, geeft Le Casse Museau zijn geheimen aan je prijs zodra je door de deur loopt."
    ],
    "es": [
      "Entre los ríos Ródano y Saona, a la vuelta de la esquina, Le Casse Museau le revelará sus secretos nada más cruzar la puerta."
    ]
  },
