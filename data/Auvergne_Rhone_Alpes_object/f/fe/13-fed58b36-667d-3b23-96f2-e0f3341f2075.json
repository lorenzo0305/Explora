  "rdfs:comment": {
    "de": [
      "Das Restaurant BHC ist ein Muss für Liebhaber der traditionellen Küche in der Region Bourbonnais.\r\nEs befindet sich in einem Rahmen mit schlichter Dekoration und Sie werden sofort von der warmen und freundlichen Atmosphäre, die hier herrscht, begeistert sein."
    ],
    "en": [
      "The BHC restaurant is a must for lovers of traditional cuisine in the Bourbonnais region.\r\nWith its uncluttered decor, you'll be immediately seduced by the warm, friendly atmosphere."
    ],
    "it": [
      "Il ristorante BHC è un must per gli amanti della cucina tradizionale della regione del Bourbonnais.\r\nL'arredamento raffinato del ristorante vi conquisterà immediatamente con la sua atmosfera calda e accogliente."
    ],
    "fr": [
      "Le restaurant BHC est un établissement incontournable pour les amateurs de cuisine traditionnelle dans le Bourbonnais. \r\nSitué dans un cadre à la décoration épurée, vous serez immédiatement séduit par l'ambiance chaleureuse et conviviale qui y règne."
    ],
    "nl": [
      "Het restaurant BHC is een must voor liefhebbers van de traditionele keuken in de regio Bourbonnais.\r\nHet verfijnde decor van het restaurant zal je meteen overtuigen met zijn warme en vriendelijke sfeer."
    ],
    "es": [
      "El restaurante BHC es una visita obligada para los amantes de la cocina tradicional de la región de Bourbonnais.\r\nLa refinada decoración del restaurante le conquistará de inmediato por su ambiente cálido y acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le BHC"
    ]
  },
