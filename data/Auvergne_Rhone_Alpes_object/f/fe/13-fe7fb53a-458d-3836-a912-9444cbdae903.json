  "rdfs:comment": {
    "de": [
      "Diese leichte, bukolische Strecke ist für Anfänger und Kinder geeignet. Nutzen Sie die Gelegenheit, den Weiler Villard zu besuchen und sich an seinem Brunnen zu erfrischen. Mögliche Variante: Gehen Sie weiter bis Poingt Ravier"
    ],
    "en": [
      "This small, easy, bucolic course is suitable for beginners and children. Take the opportunity to visit the hamlet of Villard and refresh yourself at its fountain. Possible variant: continue to Poingt Ravier"
    ],
    "it": [
      "Questo percorso breve, facile e bucolico è adatto a principianti e bambini. Cogliete l'occasione per visitare il borgo di Villard e rinfrescarvi alla sua fontana. Opzione: proseguire fino a Poingt Ravier."
    ],
    "fr": [
      "Ce petit parcours facile bucolique  est adapté aux débutants et aux enfants. Profitez-en pour visiter le hameau du Villard et vous rafraîchir à sa fontaine. Variante possible : poursuivez jusqu'à Poingt Ravier"
    ],
    "es": [
      "Esta ruta corta, fácil y bucólica es apta para principiantes y niños. Aproveche para visitar la aldea de Villard y refrescarse en su fuente. Opción: continuar hasta Poingt Ravier"
    ],
    "nl": [
      "Deze korte, gemakkelijke, landelijke route is geschikt voor beginners en kinderen. Maak van de gelegenheid gebruik om het gehucht Villard te bezoeken en verfris uzelf bij de fontein. Optie: doorgaan tot Poingt Ravier."
    ]
  },
  "rdfs:label": {
    "de": [
      "4 - Entdeckung des Weilers Villard - Mountainbike-/Mountainbike-Route"
    ],
    "ru": [
      "4 - Знакомство с деревушкой Виллар - маршрут для горных велосипедов и квадроциклов"
    ],
    "en": [
      "4 - Discovering the hamlet of Villard - Mountain bike / ATV itinerary"
    ],
    "it": [
      "4 - Alla scoperta del borgo di Villard - Percorso in mountain bike / ATV"
    ],
    "fr": [
      "4 - Découverte du hameau du Villard - Itinéraire de VTT / VTTAE"
    ],
    "zh": [
      "4 - 探索维拉德小村--山地自行车/全地形车路线"
    ],
    "nl": [
      "4 - Ontdekking van het gehucht Villard - Mountainbike / ATV route"
    ],
    "es": [
      "4 - Descubrir la aldea de Villard - Ruta en BTT / quad"
    ]
