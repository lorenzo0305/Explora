  "rdfs:comment": {
    "de": [
      "Als leidenschaftliche und gründliche Osteopathin begleite ich jeden Patienten mit einer individuellen Behandlung, um ihm zu helfen, den Körper zu befreien und selbst zum Akteur seiner Gesundheit zu werden."
    ],
    "en": [
      "A passionate and meticulous osteopath, I accompany each patient with personalized care to help them free their body and become active players in their own health."
    ],
    "it": [
      "Come osteopata appassionato e meticoloso, fornisco a ogni paziente un'assistenza personalizzata per aiutarlo a liberare il proprio corpo e a prendere in mano la propria salute."
    ],
    "fr": [
      "Ostéopathe passionnée et minutieuse, j'accompagne chaque patient avec un soin personnalisé pour l'aider à libérer le corps et devenir acteur de sa santé."
    ],
    "es": [
      "Como osteópata apasionada y meticulosa, ofrezco a cada paciente una atención personalizada para ayudarle a liberar su cuerpo y tomar las riendas de su salud."
    ],
    "nl": [
      "Als gepassioneerd en nauwgezet osteopaat bied ik elke patiënt persoonlijke zorg om hen te helpen hun lichaam te bevrijden en hun gezondheid in eigen handen te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
