  "rdfs:comment": {
    "de": [
      "Restaurant in Südlage mit Blick auf den Mont-Blanc in einem typischen Savoyer Rahmen.  Möglichkeit, Bankette, Geschäftsessen und Geburtstage zu organisieren. Spezialitäten: Rebloche, Spießbraten, Rindstatar."
    ],
    "en": [
      "Restaurant facing directly south in front of Mont Blanc in typically Savoyard setting. Possibility of holding banquet, business or birthday lunch.\r\nSpecialties: La rebloche, the brooch, the beef tartar."
    ],
    "it": [
      "Ristorante situato a sud, di fronte al Monte Bianco, in un ambiente tipicamente savoiardo.  Possibilità di organizzare banchetti, pranzi di lavoro, compleanni. Specialità: Rebloche, broche, tartara di manzo."
    ],
    "fr": [
      "Restaurant situé plein sud face au Mont-Blanc dans un cadre typiquement savoyard.  Possibilité d'organiser banquet, repas d'affaires, anniversaires. Spécialités : La rebloche, la broche, le tartare de boeuf."
    ],
    "es": [
      "Restaurante situado al sur, frente al Mont Blanc, en un entorno típico saboyano.  Posibilidad de organizar banquetes, comidas de empresa, cumpleaños. Especialidades: Rebloche, broche, tartar de carne."
    ],
    "nl": [
      "Restaurant gelegen op het zuiden met uitzicht op de Mont Blanc in een typisch Savoyaardse omgeving.  Mogelijkheid tot het organiseren van banketten, zakendiners, verjaardagen. Specialiteiten: Rebloche, broche, rundertartaar."
    ]
  },
  "rdfs:label": {
