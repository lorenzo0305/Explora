  "rdfs:comment": {
    "de": [
      "Kleiner Park neben dem Parkplatz des Rathauses. Vorhandensein einer Schaukel, die an einem Baum hängt, und eines Picknicktisches."
    ],
    "en": [
      "Small park next to the town hall parking lot. There's a swing hanging from the tree and a picnic table."
    ],
    "it": [
      "Piccolo parco accanto al parcheggio del municipio. C'è un'altalena appesa all'albero e un tavolo da picnic."
    ],
    "fr": [
      "Petit parc à côté du parking de la mairie. Présence d'une balançoire accrochée à l'arbre et d'une table de pique-nique."
    ],
    "es": [
      "Pequeño parque junto al aparcamiento del ayuntamiento. Hay un columpio colgado del árbol y una mesa de picnic."
    ],
    "nl": [
      "Klein park naast de parkeerplaats van het gemeentehuis. Er hangt een schommel aan de boom en er is een picknicktafel."
    ]
  },
