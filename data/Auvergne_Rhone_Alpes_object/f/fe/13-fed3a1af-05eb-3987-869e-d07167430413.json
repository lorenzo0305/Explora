  "rdfs:comment": {
    "de": [
      "L'Alternative bietet Ihnen handgemachte Pizzas aus ausgewählten Produkten, Bruschetta, Paninis, gemischte Salate, Pommes frites, Tartiflette, Getränke, Desserts, Eis?"
    ],
    "en": [
      "Takeaway HOMEMADE pizzas, snack\r\nPizzas, toasted sandwiches, bruschettas, salads, chips, beverages, desserts, ice-creams...to TAKE OUT(or eat in possible lunchtimes).\r\n\r\nBook in advance!\r\n\r\nFollow us on Facebook for more information."
    ],
    "it": [
      "L'Alternative offre pizze fatte in casa con ingredienti selezionati, bruschette, panini, insalate miste, patatine, tartiflette, bevande, dessert, gelati?"
    ],
    "fr": [
      "L'Alternative vous propose ses pizzas artisanales élaborées à partir de produits sélectionnés, ses bruschettas, paninis, salades composées, frites, tartiflette,…des boissons, desserts, glaces…"
    ],
    "es": [
      "L'Alternative ofrece pizzas caseras elaboradas con ingredientes seleccionados, bruschettas, paninis, ensaladas mixtas, patatas fritas, tartiflette, bebidas, postres, helados?"
    ],
