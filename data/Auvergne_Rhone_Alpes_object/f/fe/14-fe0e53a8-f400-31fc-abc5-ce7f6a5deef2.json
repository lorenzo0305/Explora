      "dc:description": {
        "de": [
          "2K Küchen Nolte\nDesigner von Küchen für jeden Stil\nSeit 2011 zu Ihren Diensten\nEine Planung nach Maß\nGeöffnet von Dienstag bis Samstag\nVon Nordfrankreich bis Paris"
        ],
        "en": [
          "2K Kitchens Nolte\nKitchen designer for every style\nAt your service since 2011\nMade-to-measure design\nOpen Tuesday to Saturday\nFrom northern France to Paris"
        ],
        "it": [
          "2K Cucine Nolte\nDesigner di cucine per ogni stile\nAl vostro servizio dal 2011\nProgettazione su misura\nAperto da martedì a sabato\nDal nord della Francia a Parigi"
        ],
        "fr": [
          "2K Cuisines Nolte\nCréateur de cuisines pour tous les styles\nA votre service depuis 2011\nUne conception sur mesure \nOuvert du mardi au samedi\nDu nord de la France jusqu’à Paris"
        ],
        "nl": [
          "2K Keukens Nolte\nKeukenontwerpers voor elke stijl\nTot uw dienst sinds 2011\nOntwerp op maat\nGeopend van dinsdag tot zaterdag\nVan Noord-Frankrijk tot Parijs"
        ],
        "es": [
          "2K Cocinas Nolte\nDiseñadores de cocinas para todos los estilos\nA su servicio desde 2011\nDiseño a medida\nAbierto de martes a sábado\nDel norte de Francia a París"
        ]
      },
