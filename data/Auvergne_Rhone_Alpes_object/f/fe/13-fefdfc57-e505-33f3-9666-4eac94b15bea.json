  "rdfs:comment": {
    "de": [
      "Fliegen Sie mit einem Ultraleichtflugzeug über die Weinberge von Saint-Pourçain, die Schlösser und Flüsse des Bourbonnais. Während Ihres Fluges werden Sie unsere schöne Region Bourbonnais kennenlernen: Das wird Ihnen unvergessliche Erinnerungen bescheren. Ab 10 Jahren."
    ],
    "en": [
      "Fly over the vineyards of Saint-Pourçain, castles and rivers of the Bourbonnais region in a hang glider. During your flight, you'll discover our beautiful Bourbonnais region, leaving you with unforgettable memories. For ages 10 and up."
    ],
    "it": [
      "Sorvolate i vigneti di Saint-Pourçain, i castelli e i fiumi del Bourbonnais in deltaplano. Durante il volo, scoprirete la nostra bella regione del Bourbonnais: ciò che vi lascerà ricordi indimenticabili. A partire da 10 anni."
    ],
    "fr": [
      "Survolez le vignoble de Saint-Pourçain, châteaux et rivières du Bourbonnais en ULM pendulaire. Lors de votre vol, vous découvrirez notre belle région du Bourbonnais : de quoi vous laisser des souvenirs inoubliables. À partir de 10 ans."
    ],
    "nl": [
      "Vlieg over de wijngaarden van Saint-Pourçain, kastelen en rivieren van de Bourbonnais in een deltavlieger. Tijdens uw vlucht ontdekt u onze prachtige regio Bourbonnais: wat u onvergetelijke herinneringen zal nalaten. Vanaf 10 jaar."
    ],
    "es": [
      "Sobrevuele los viñedos de Saint-Pourçain, los castillos y los ríos del Bourbonnais en ala delta. Durante su vuelo, descubrirá nuestra hermosa región del Bourbonnais: lo que le dejará recuerdos inolvidables. A partir de 10 años."
    ]
  },
  "rdfs:label": {
    "en": [
      "ULM"
    ],
    "fr": [
      "ULM - Vignoble et châteaux à Tire d'aile"
    ]
  },
