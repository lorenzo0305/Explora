  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/db2ab5e4-a1d2-3284-8a2e-af610f67a323",
      "dc:description": {
        "de": [
          "- Betreuung zu Hause\n- Besuch und Spaziergang Hund, Katze, NAC\nErziehung und Verhalten im Laufe des Jahres\n\nBiologisch abbaubare Beutel für Hundekot\nUmweltfreundliche Produkte"
        ],
        "en": [
          "- Home care\n- Visits and walks for dogs, cats and NACs\nEducation and behavior throughout the year\n\nBio-degradable poop bags\nEnvironmentally-friendly products"
        ],
        "it": [
          "- Babysitting a domicilio\n- Visite e passeggiate per cani, gatti e CNA\nEducazione e comportamento durante tutto l'anno\n\nSacchetti per rifiuti biodegradabili\nProdotti ecologici"
        ],
        "fr": [
          "- Garde à domicile\n- Visite et promenade chien, chat, NAC\nEducation et comportement dans l'année\n\nSacs à déjection bio-dégradable\nProduits respectueux de l'environnement"
        ],
        "es": [
          "- Servicio de canguro a domicilio\n- Visitas y paseos para perros, gatos y NAC\nEducación y comportamiento durante todo el año\n\nBolsas de basura biodegradables\nProductos respetuosos con el medio ambiente"
        ],
        "nl": [
          "- Babysitten aan huis\n- Bezoeken en wandelingen voor honden, katten en NAC's\nOpvoeding en gedrag het hele jaar door\n\nBiologisch afbreekbare afvalzakken\nMilieuvriendelijke producten"
        ]
      },
