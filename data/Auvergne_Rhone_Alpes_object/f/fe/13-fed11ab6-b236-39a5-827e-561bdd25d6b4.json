  "rdfs:comment": {
    "de": [
      "Unser Restaurant mit dem Konzept Albert's Place ist sieben Tage die Woche von 19.00 bis 22.00 Uhr geöffnet. Freuen Sie sich auf eine Auswahl an Gerichten, die zum Teil mit lokalen und frischen Produkten zubereitet werden. Ein von unserem Chefkoch zusammengestelltes Tagesmenü wird Ihnen ebenfalls angeboten."
    ],
    "en": [
      "Our Albert's Place concept restaurant is open 7/7 from 7pm to 10pm. Come and discover a selection of dishes, cooked in part with local produce and fresh products. A daily menu prepared by our chef is also available."
    ],
    "it": [
      "Il nostro concept restaurant Albert's Place è aperto 7 giorni su 7, dalle 19.00 alle 22.00. Venite a scoprire una selezione di piatti, cucinati in parte con prodotti locali e freschi. È disponibile anche un menu giornaliero preparato dal nostro chef."
    ],
    "fr": [
      "Notre restaurant sous concept Albert’s Place est ouvert 7j/7j de 19h à 22H. Venez découvrir une sélection de plats, cuisinés en partie avec des produits locaux et des produits frais. Un menu du jour confectionné par notre chef vous sera également proposé."
    ],
    "nl": [
      "Ons conceptrestaurant Albert's Place is 7 dagen per week geopend van 19.00 tot 22.00 uur. Kom en ontdek een selectie gerechten, deels bereid met lokale producten en verse producten. Er is ook een dagmenu beschikbaar dat wordt bereid door onze chef-kok."
    ],
    "es": [
      "Nuestro restaurante de concepto Albert's Place está abierto los 7 días de la semana de 19:00 a 22:00 horas. Venga a descubrir una selección de platos, cocinados en parte con productos locales y frescos. También ofrecemos un menú diario elaborado por nuestro chef."
    ]
  },
