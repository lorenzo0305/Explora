  "rdfs:comment": {
    "de": [
      "Das Le P'tit Trésor und seine Weltküche bieten Ihnen kreolische, italienische, asiatische und französische Spezialitäten.\r\nUnd jeden Samstagabend veranstaltet das P'tit Trésor ab 21 Uhr Karaoke-Abende."
    ],
    "en": [
      "Le P'tit Trésor and its world cuisine offers Creole, Italian, Asian and French specialties.\r\nAnd every Saturday night, Le P'tit Trésor organizes karaoke evenings from 9pm."
    ],
    "it": [
      "Le P'tit Trésor e la sua cucina mondiale offrono specialità creole, italiane, asiatiche e francesi.\r\nOgni sabato sera, inoltre, Le P'tit Trésor organizza serate di karaoke a partire dalle 21.00."
    ],
    "fr": [
      "Le P'tit Trésor et sa cuisine du monde vous propose des spécialités créoles, italiennes, asiatiques, françaises.\r\nEt tous les samedis soirs, le P'tit Trésor organise des soirées Karaoké à partir de 21h."
    ],
    "es": [
      "Le P'tit Trésor y su cocina del mundo ofrecen especialidades criollas, italianas, asiáticas y francesas.\r\nY todos los sábados por la noche, Le P'tit Trésor organiza veladas de karaoke a partir de las 21:00."
    ],
    "nl": [
      "Le P'tit Trésor en zijn wereldkeuken biedt Creoolse, Italiaanse, Aziatische en Franse specialiteiten.\r\nEn elke zaterdagavond organiseert Le P'tit Trésor karaoke-avonden vanaf 21.00 uur."
    ]
  },
