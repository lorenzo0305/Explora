  "rdfs:comment": {
    "de": [
      "Günstige Schnellrestaurants, Gerichte auf der Grundlage von Grillfleisch mit Tagesgericht. Ketten \"Bistrot Marché\". Die Speisekarte wechselt alle drei Monate."
    ],
    "en": [
      "Fast food , good value for money, grilled dish of the day."
    ],
    "it": [
      "Cibo veloce ed economico, piatti alla griglia con specialità del giorno. Catene \"Bistrot Marché\". Il menu cambia ogni tre mesi."
    ],
    "fr": [
      "Restauration rapide et bon marché, plats basés sur les grillades avec plat du jour. Chaînes \"Bistrot Marché\". La carte change tous les trois mois."
    ],
    "nl": [
      "Goedkoop fastfood, op grill gebaseerde gerechten met dagelijkse specials. Bistrot Marché\" ketens. Het menu verandert elke drie maanden."
    ],
    "es": [
      "Comida rápida y barata, platos a la parrilla con especialidades diarias. Cadenas \"Bistrot Marché\". El menú cambia cada tres meses."
    ]
  },
