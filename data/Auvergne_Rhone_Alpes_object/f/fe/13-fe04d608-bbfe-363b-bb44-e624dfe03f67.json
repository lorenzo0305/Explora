  "rdfs:comment": {
    "de": [
      "Die Ludothek der Monts du Lyonnais bietet rund 100 Gesellschaftsspiele für Groß und Klein an, die vor Ort zur Verfügung stehen oder für das Spielen zu Hause reserviert werden können!"
    ],
    "en": [
      "The Monts du Lyonnais toy library offers a hundred board games for young and old, available on site or to reserve to play at home!"
    ],
    "it": [
      "La ludoteca del Monts du Lyonnais offre un centinaio di giochi da tavolo per grandi e piccini, disponibili in loco o da prenotare per giocare a casa!"
    ],
    "fr": [
      "La ludothèque des Monts du Lyonnais propose une centaine de jeux de société pour les petits et grands mis à disposition sur place ou à réserver pour jouer à la maison !"
    ],
    "es": [
      "La ludoteca de Monts du Lyonnais ofrece un centenar de juegos de mesa para grandes y pequeños, disponibles in situ o para reservar y jugar en casa"
    ],
    "nl": [
      "De spelotheek van de Monts du Lyonnais biedt een honderdtal gezelschapsspellen voor jong en oud, ter plaatse verkrijgbaar of te reserveren om thuis te spelen!"
    ]
  },
