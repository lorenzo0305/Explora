  "rdfs:comment": {
    "de": [
      "Saal mit 215 Plätzen, 11 Meter breite Leinwand, digitaler Ton.\r\nFilme in nationalen Kinos während der Ferien.\r\nVorführungen in 2D und 3D.\r\nVorführungen für Gruppen und Hörgeschädigte auf Anfrage.\r\nProgramm im Tourismusbüro und auf allocine.fr erhältlich"
    ],
    "en": [
      "Hall with 215 seats, 11-metre-wide screen, digital sound.\r\nFilms released nationally during the holidays.\r\nDigital 2D and 3D projection.\r\nFilm screenings for groups and the hearing impaired on request\r\nProgram available in the Tourist Office and on allocine.fr"
    ],
    "it": [
      "Sala da 215 posti, schermo panoramico di 11 metri, audio digitale.\r\nProiezione di film nazionali durante le festività.\r\nProiezioni in 2D e 3D.\r\nProiezioni per gruppi e per non udenti su richiesta.\r\nProgramma disponibile presso l'Ufficio del Turismo e allocine.fr"
    ],
    "fr": [
      "Salle de 215 places, écran de 11 mètres de large, son numérique.\r\nFilms en sortie nationale pendant les vacances.\r\nProjection en 2D et 3D.\r\nSéances pour les groupes et malentendants sur demande.\r\nProgramme disponible en Office de tourisme et sur allocine.fr"
    ],
    "es": [
      "Sala de 215 localidades, pantalla panorámica de 11 metros, sonido digital.\r\nEstrenos nacionales durante las vacaciones.\r\nProyecciones en 2D y 3D.\r\nProyecciones para grupos y personas con discapacidad auditiva previa petición.\r\nPrograma disponible en la Oficina de Turismo y en allocine.fr"
    ],
    "nl": [
      "Bioscoop met 215 zitplaatsen, 11 meter breedbeeldscherm, digitaal geluid.\r\nFilms die nationaal worden uitgebracht tijdens de feestdagen.\r\nDigitale projectie in 2D en 3D.\r\nFilmvoorstellingen voor groepen op aanvraag.\r\nProgramma beschikbaar bij de VVV en op allocine.fr"
    ]
  },
