  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b79c6bf9-4d6d-3bb4-8791-f72779106858",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 9:00 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 8:30 bis 13:00 Uhr\n\nSonntag geschlossen\n \n Abholung :\n\nZu den Öffnungszeiten der Apotheke\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 9am to 12:30pm and 2pm to 7pm\nSaturday from 8:30am to 1pm\n\nClosed on Sunday\n \n Collection:\n\nDuring pharmacy opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 9.00 alle 12.30 e dalle 14.00 alle 19.00\nSabato dalle 8.30 alle 13.00\n\nChiuso la domenica\n \n Ritiro:\n\nDurante gli orari di apertura della farmacia\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 9h à 12h30 et de 14h à 19h\nLe samedi de 8h30 à 13h\n\nFermeture le dimanche\n \n Retrait :\n\nAux horaires d'ouverture de la pharmacie\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag van 9u tot 12u30 en van 14u tot 19u\nZaterdag van 8.30 tot 13.00\n\nZondag gesloten\n \n Ophalen:\n\nTijdens openingsuren van de apotheek\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 9.00 a 12.30 h. y de 14.00 a 19.00 h\nSábado de 8h30 a 13h00\n\nDomingos cerrado\n \n Recogida:\n\nDurante el horario de apertura de la farmacia\n\n\n "
        ]
      },
