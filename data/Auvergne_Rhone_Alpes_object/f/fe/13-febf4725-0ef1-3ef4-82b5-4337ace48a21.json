  "rdfs:comment": {
    "de": [
      "Als Produzent von Biogemüse, der die Natur und Ihre Gesundheit respektiert, biete ich Ihnen Saisongemüse an, das Sie auf unserer Website bestellen können, samstags auf dem Markt in Le Puy en Velay und sonntags vor der Boucherie d'Augustin."
    ],
    "en": [
      "As a producer of organic vegetables that respect nature and your health, I offer you seasonal vegetables available to order on our website, at the Le Puy en Velay market on Saturdays and in front of Augustin's Butcher shop on Sundays."
    ],
    "it": [
      "Come produttore di verdure biologiche che rispettano la natura e la vostra salute, vi propongo verdure di stagione disponibili su ordinazione sul nostro sito web, al mercato di Le Puy en Velay il sabato e davanti alla Boucherie d'Augustin la domenica."
    ],
    "fr": [
      "Producteur de légumes biologiques respectant la nature et votre santé, je vous propose des légumes de saison disponibles en commande sur notre site internet, sur le marché du Puy en Velay le samedi et devant la Boucherie d'Augustin les dimanches."
    ],
    "es": [
      "Como productor de verduras ecológicas que respetan la naturaleza y su salud, ofrezco verduras de temporada disponibles por encargo en nuestra página web, en el mercado de Le Puy en Velay los sábados y frente a la Boucherie d'Augustin los domingos."
    ],
    "nl": [
      "Als producent van biologische groenten die de natuur en jouw gezondheid respecteren, bied ik seizoensgroenten aan die te bestellen zijn op onze website, op de markt van Le Puy en Velay op zaterdag en voor de Boucherie d'Augustin op zondag."
    ]
  },
  "rdfs:label": {
