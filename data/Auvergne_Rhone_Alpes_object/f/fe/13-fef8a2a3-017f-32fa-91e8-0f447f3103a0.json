  "rdfs:comment": {
    "de": [
      "Höhenrestaurant auf 1300m auf den Skipisten von Méaudre, je nach Saison mit dem Sessellift oder über die Waldstraße Route des Feuilles erreichbar, direkt über dem Start der Zipline gelegen. Atemberaubende Aussicht. Burger, Pasta, Salate, Crêpes, Ravioli."
    ],
    "en": [
      "Mountain restaurant at 1,300m high on the Méaudre ski slopes. Can be reached by chairlift or by Route Forestière des Feuilles depending on the season, located just above the start of the Zipline. Uninterrupted view. Burgers, Pasta, Salads, Pancakes, Ravioles."
    ],
    "it": [
      "snack bar di montagna a 1300 m sulle piste da sci di Méaudre (in cima alla seggiovia Gonçon e alla partenza della zipline). Raggiungibile in seggiovia, a piedi, con le racchette da neve, in mountain bike o attraverso la strada forestale delle Feuilles. Vista mozzafiato. Piccolo ristorante."
    ],
    "fr": [
      "snack gourmand d'altitude à 1300m sur les pistes de ski de Méaudre (sommet du télésiège du Gonçon et départ zipline). Accessible en télésiège, à pied, en raquette , à VTT ou par la route forestière des Feuilles. Vue imprenable. Petite restauration."
    ],
    "nl": [
      "snackbar voor fijnproevers op 1300m hoogte op de skipistes van Méaudre (bovenaan de stoeltjeslift Gonçon en vertrekpunt van de zipline). Bereikbaar met de stoeltjeslift, te voet, op sneeuwschoenen, met de mountainbike of via de bosweg van Feuilles. Adembenemend uitzicht. Klein restaurant."
    ],
    "es": [
      "cafetería gastronómica de montaña a 1300 m en las pistas de Méaudre (punto de partida del telesilla Gonçon y de la tirolina). Accesible en telesilla, a pie, con raquetas, en bicicleta de montaña o por la pista forestal de Feuilles. Vistas impresionantes. Pequeño restaurante."
    ]
  },
  "rdfs:label": {
    "de": [
      "La Pause Marmotte 1300"
    ],
    "en": [
      "La Pause Marmotte 1300"
    ],
    "fr": [
      "La pause marmotte 1300"
    ]
  },
