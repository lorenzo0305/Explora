  "rdfs:comment": {
    "de": [
      "Frei verwalteter Saal, in dem Sie Ihre berufliche Veranstaltung in aller Freiheit organisieren können. Möglichkeit einer Formel \"mâchon vigneron Beaujolais\" oder eines schlüsselfertigen Tages auf Anfrage ab 10 Personen."
    ],
    "en": [
      "Self-managed room to organize your business event. Beaujolais winegrower's mâchon or turnkey day available on request for groups of 10 or more."
    ],
    "it": [
      "Sala autogestita per l'organizzazione di eventi aziendali. Un mâchon vigneron Beaujolais o una giornata \"chiavi in mano\" possono essere organizzati su richiesta per gruppi di almeno 10 persone."
    ],
    "fr": [
      "Salle en gestion libre pour organiser en toute liberté votre évènement professionnel. Possibilité de formule mâchon vigneron Beaujolais ou journée clé en main sur demande à partir de 10 personnes."
    ],
    "nl": [
      "Zelf beheerde ruimte voor het organiseren van uw bedrijfsevenement. Een mâchon vigneron Beaujolais of kant-en-klare dag kan op verzoek worden geregeld voor groepen vanaf 10 personen."
    ],
    "es": [
      "Sala autogestionada para organizar su evento de empresa. Para grupos a partir de 10 personas, se puede organizar bajo petición una jornada de mâchon vigneron Beaujolais o llave en mano."
    ]
  },
  "rdfs:label": {
