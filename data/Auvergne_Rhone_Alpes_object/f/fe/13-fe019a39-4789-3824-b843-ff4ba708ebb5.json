  "rdfs:comment": {
    "de": [
      "Ein originelles und leckeres Snackangebot, das unserem Engagement treu bleibt.\r\nChez Loulou, das sind hausgemachte und von uns ausgewählte Qualitätsprodukte, die Sie vor Ort genießen oder mitnehmen können."
    ],
    "en": [
      "An original, gourmet snacking proposition, true to our commitment.\r\nChez Loulou is home-made, with quality products selected by us, to eat in or take away."
    ],
    "it": [
      "Uno spuntino originale e gustoso, fedele al nostro impegno.\r\nChez Loulou è fatto in casa, con prodotti di qualità selezionati da noi, da mangiare o da portare via."
    ],
    "fr": [
      "Une proposition de snacking originale et gourmande, fidèle à notre engagement.\r\nChez Loulou, c’est du fait maison et des produits de qualité sélectionnés par nos soins, à déguster sur place ou à emporter."
    ],
    "es": [
      "Un tentempié original y sabroso, fiel a nuestro compromiso.\r\nChez Loulou es casero, con productos de calidad seleccionados por nosotros, para comer en casa o para llevar."
    ],
    "nl": [
      "Een origineel en smakelijk tussendoortje, trouw aan onze belofte.\r\nChez Loulou is huisgemaakt, met door ons geselecteerde kwaliteitsproducten, om te eten of om mee te nemen."
    ]
  },
  "rdfs:label": {
