  "rdfs:comment": {
    "de": [
      "Joséphine ist der perfekte Ort in Lyon, um hausgemachte Gerichte, handgemachtes Eis und unwiderstehliche Süßigkeiten zu genießen. Genießen Sie traditionelle Küche zum Mittagessen und köstliche süße Pausen die ganze Woche über."
    ],
    "en": [
      "Joséphine is the perfect place in Lyon to enjoy homemade dishes, artisanal ice creams and irresistible sweets. Enjoy traditional cuisine for lunch and delicious sweet breaks throughout the week."
    ],
    "it": [
      "Joséphine è il luogo perfetto a Lione per gustare piatti fatti in casa, gelati artigianali e dolci irresistibili. A pranzo potrete assaporare la cucina tradizionale e durante tutta la settimana potrete concedervi deliziose pause dolci."
    ],
    "fr": [
      "Joséphine c'est l'endroit parfait à Lyon pour savourer des plats faits maison, des glaces artisanales et des douceurs irrésistibles. Profitez d’une cuisine traditionnelle pour le déjeuner et de délicieuses pauses sucrées tout au long de la semaine."
    ],
    "nl": [
      "Joséphine is de perfecte plek in Lyon om te genieten van huisgemaakte gerechten, zelfgemaakt ijs en onweerstaanbare zoetigheden. Geniet van traditionele gerechten voor de lunch en heerlijke zoete pauzes gedurende de hele week."
    ],
    "es": [
      "Joséphine es el lugar perfecto en Lyon para disfrutar de platos caseros, helados artesanales y dulces irresistibles. Disfrute de la cocina tradicional al mediodía y de deliciosas pausas dulces durante toda la semana."
    ]
  },
