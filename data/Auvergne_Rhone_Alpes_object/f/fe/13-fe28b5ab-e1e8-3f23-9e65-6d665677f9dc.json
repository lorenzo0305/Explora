  "rdfs:comment": {
    "de": [
      "Die Brasserie befindet sich in unmittelbarer Nähe des Bahnhofs im Stadtzentrum und wird Sie mit ihrer modernen Einrichtung und der gemütlichen Terrasse begeistern."
    ],
    "en": [
      "Located near the train station, in the city centre, the brasserie will seduce you with its modern decoration and its pleasant terrace."
    ],
    "it": [
      "Situata vicino alla stazione ferroviaria, nel centro della città, la brasserie vi conquisterà con il suo arredamento moderno e la sua piacevole terrazza."
    ],
    "fr": [
      "Située à proximité immédiate de la gare, en centre ville, la brasserie vous séduira par sa décoration moderne et sa terrasse agréable."
    ],
    "es": [
      "Situada cerca de la estación de tren, en el centro de la ciudad, la brasserie le seducirá con su moderna decoración y su agradable terraza."
    ],
    "nl": [
      "De brasserie ligt vlakbij het station, in het centrum van de stad, en zal u verleiden met zijn moderne inrichting en zijn aangename terras."
    ]
  },
