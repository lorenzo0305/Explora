  "rdfs:comment": {
    "de": [
      "Der Bauernhof von Antoine öffnet seine Türen für einen geselligen Moment inmitten der Natur. Die Tiere warten schon ungeduldig auf Sie, damit Sie sie füttern und streicheln können. Ein Familienerlebnis, das Sie sich nicht entgehen lassen sollten!"
    ],
    "en": [
      "Antoine's farm welcomes you for a friendly moment surrounded by nature. The animals are eagerly awaiting your arrival so you can feed and pet them. A family moment not to be missed!"
    ],
    "it": [
      "La fattoria di Antoine vi apre le porte per un momento conviviale in mezzo alla natura, gli animali aspettano impazienti che gli diate da mangiare e li accarezziate. Un momento di famiglia da non perdere!"
    ],
    "fr": [
      "Le ferme d'Antoine vous ouvre ses portes pour un moment convivial en pleine nature, les animaux vous attendent avec impatience pour les nourrir et les caresser. Un moment en famille à ne pas manquer !"
    ],
    "es": [
      "La granja de Antoine te abre sus puertas para que pases un momento de convivencia en plena naturaleza, los animales esperan impacientes que los alimentes y los acaricies. ¡Un momento familiar que no debe perderse!"
    ],
    "nl": [
      "De boerderij van Antoine opent haar deuren voor u voor een gezellig moment midden in de natuur, de dieren wachten ongeduldig op u om ze te voeren en te aaien. Een niet te missen familiemoment!"
    ]
  },
