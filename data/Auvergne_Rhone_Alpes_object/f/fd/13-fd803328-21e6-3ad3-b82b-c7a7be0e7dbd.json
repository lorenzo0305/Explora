  "rdfs:comment": {
    "de": [
      "Regelmäßig mit Fisch besetzte Wasserfläche. Spaziergang, Picknick (mit Grill) und Spielplatz. Saisonale Ausübung von Angeln oder Fliegenfischen."
    ],
    "en": [
      "The pond in Marlens is stocked with fish on a regular basis. Enjoy walks, a picnic area (with barbecue), and a playground. Seasonal bait casting or fly fishing."
    ],
    "it": [
      "Laghetto regolarmente rifornito. Passeggiate, picnic (con barbecue) e parco giochi. Pesca stagionale o pesca a mosca."
    ],
    "fr": [
      "Plan d'eau empoissonné régulièrement. Promenade, pique-nique (avec barbecue) et terrain de jeux. Pratique saisonnière de la pêche à la ligne ou de la pêche à la mouche."
    ],
    "nl": [
      "Regelmatig gevulde vijver. Wandelen, picknick (met barbecue) en speeltuin. Of vliegvissen."
    ],
    "es": [
      "Estanque abastecido regularmente. Paseos, picnic (con barbacoa) y parque infantil. Pesca de temporada o con mosca."
    ]
  },
