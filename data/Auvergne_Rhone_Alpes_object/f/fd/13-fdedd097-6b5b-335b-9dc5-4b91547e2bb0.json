  "rdfs:comment": {
    "de": [
      "Vom Morel-Viertel aus entscheiden Sie sich für den Morel-Sessellift, mit dem Sie leicht auf die Pisten gelangen, insbesondere zum Altiport, wo Sie eine Skipass-Verkaufsstelle finden."
    ],
    "en": [
      "From the Morel district, choose the Morel chairlift to access the slopes easily, especially to the Altiport where you will find a skipass ticket office."
    ],
    "it": [
      "Dal quartiere Morel, prendete la seggiovia Morel per accedere facilmente alle piste, in particolare all'Altiport dove troverete un punto vendita di skipass."
    ],
    "fr": [
      "Depuis le quartier du Morel, optez pour le télésiège de Morel pour accéder aux pistes facilement, notamment à l'Altiport où vous trouverez un point de vente skipass."
    ],
    "nl": [
      "Vanuit de wijk Morel neemt u de stoeltjeslift Morel voor een gemakkelijke toegang tot de pistes, met name tot de Altiport waar u een verkooppunt voor skipassen vindt."
    ],
    "es": [
      "Desde el barrio de Morel, tome el telesilla de Morel para acceder fácilmente a las pistas, especialmente al Altiport, donde encontrará un punto de venta de forfaits."
    ]
  },
  "rdfs:label": {
    "en": [
      "Morel chairlift"
    ],
    "fr": [
      "Télésiège de Morel"
    ],
    "nl": [
      "Stoeltjeslift Morel"
    ]
  },
