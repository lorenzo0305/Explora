  "rdfs:comment": {
    "de": [
      "Der Spaziergang \"Au fil de l'eau\" ist eine Einladung, Romans durch seine Verbindungen mit dem Wasser zu erkunden, ein wesentliches Element für die Geschichte und Entwicklung der Stadt."
    ],
    "en": [
      "The walk \"Au fil de l'eau\" is an invitation to explore Romans through its links with water, an essential element in the history and development of the city."
    ],
    "it": [
      "La passeggiata \"Au fil de l'eau\" è un invito a esplorare Romans attraverso il suo legame con l'acqua, un elemento essenziale nella storia e nello sviluppo della città."
    ],
    "fr": [
      "La balade \"Au fil de l'eau\" est une invitation à explorer Romans à travers ses liens avec l'eau, élément essentiel à l'histoire et au développement de la ville."
    ],
    "es": [
      "El paseo \"Au fil de l'eau\" es una invitación a explorar Romans a través de sus vínculos con el agua, elemento esencial en la historia y el desarrollo de la ciudad."
    ],
    "nl": [
      "De wandeling \"Au fil de l'eau\" is een uitnodiging om Romeinen te verkennen door zijn banden met water, een essentieel element in de geschiedenis en ontwikkeling van de stad."
    ]
  },
