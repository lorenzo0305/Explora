  "rdfs:comment": {
    "de": [
      "Das Weingut ist seit vier Generationen in Familienbesitz und befindet sich im Herzen des Dorfes Saint Martin gegenüber der  Festungsmauern von Aigueze. Es produziert kräftige, würzige Côtes du Rhône-Weine oder angenehme, frische und leichte Weine."
    ],
    "en": [
      "This family-run estate has been in operation for 4 generations now and is at the heart of the village of Saint-Martin, facing the jagged hills of Aigueze where some powerful, spicy and lively Côtes du Rhône wines are produced."
    ],
    "it": [
      "Una tenuta familiare di 4 generazioni nel cuore del villaggio di Saint Martin, di fronte ai bastioni frastagliati di Aiguèze, che produce Côtes du Rhône potenti, speziate e di facile beva."
    ],
    "fr": [
      "Domaine familiale de 4 générations situé au cœur du village de Saint Martin face aux remparts dentelés d'Aiguèze produisant des Côtes du Rhône puissants, épicés ou gouleyants."
    ],
    "es": [
      "Una propiedad familiar de 4 generaciones en el corazón del pueblo de Saint Martin, frente a las escarpadas murallas de Aiguèze, que produce Côtes du Rhône potentes, especiados y fáciles de beber."
    ],
    "nl": [
      "Nabij de Gorges de l'Ardèche met aan de overkant de kliffen van Aiguèze. Hier bevindt zich ook de wijnkelder in het hart van het dorpscentrum St Martin d'Ardèche."
    ]
  },
