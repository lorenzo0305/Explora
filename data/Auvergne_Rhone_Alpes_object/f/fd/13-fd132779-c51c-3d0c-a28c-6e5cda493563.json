  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich ein einzigartiges kulinarisches Erlebnis mit Blick auf den Mont-Blanc, im Herzen des Col des Aravis. Unser Restaurant verbindet Tradition und Bistronomie in einer herzlichen Atmosphäre. Das ganze Jahr über geöffnet. Wir sind auch Spezialisten für Hochzeiten in den Bergen."
    ],
    "en": [
      "Treat yourself to a unique culinary experience overlooking Mont Blanc, in the heart of the Col des Aravis. Our restaurant blends tradition and bistronomy in a warm atmosphere. Open all year round. We also specialize in mountain weddings."
    ],
    "it": [
      "Concedetevi un'esperienza culinaria unica con vista sul Monte Bianco, nel cuore del Col des Aravis. Il nostro ristorante unisce tradizione e bistronomia in un'atmosfera accogliente. Aperto tutto l'anno. Siamo anche specializzati in matrimoni in montagna."
    ],
    "fr": [
      "Offrez-vous une expérience culinaire unique face au Mont-Blanc, au cœur du Col des Aravis. Notre restaurant mêle tradition et bistronomie dans une ambiance chaleureuse. Ouvert toute l'année. Nous sommes aussi spécialistes du mariage à la montagne."
    ],
    "nl": [
      "Trakteer jezelf op een unieke culinaire ervaring met uitzicht op de Mont Blanc, in het hart van de Col des Aravis. Ons restaurant combineert traditie en bistronomie in een warme sfeer. Het hele jaar door geopend. We zijn ook gespecialiseerd in bruiloften in de bergen."
    ],
    "es": [
      "Regálese una experiencia culinaria única con vistas al Mont Blanc, en el corazón del Col des Aravis. Nuestro restaurante combina tradición y bistronomía en un ambiente cálido. Abierto todo el año. También estamos especializados en bodas en la montaña."
    ]
  },
