  "rdfs:comment": {
    "de": [
      "Barservice ab 9:30 Uhr und den ganzen Tag über.\r\nKomplett renoviertes Restaurant, um Sie besser empfangen zu können.\r\nDie Speisekarte wird alle 20 Tage mit frischen Produkten erneuert."
    ],
    "en": [
      "Bar service from 9:30 a.m. all day long.\r\nThe restaurant has been completely refurbished to make it even more welcoming.\r\nThe menu is renewed every month with fresh produce."
    ],
    "it": [
      "Servizio bar dalle 9.30 per tutto il giorno. 7 giorni su 7\r\nIl ristorante è stato completamente rinnovato per renderlo ancora più accogliente.\r\nIl menu viene rinnovato ogni mese con prodotti freschi."
    ],
    "fr": [
      "Service du bar dès 9h30 et toute la journée. 7j/7j\r\nRestaurant entièrement refait à neuf afin de mieux vous accueillir.\r\nLa carte est renouvelée tous les mois avec des produits frais."
    ],
    "es": [
      "Servicio de bar desde las 9.30 h durante todo el día. 7 días a la semana\r\nEl restaurante ha sido completamente reformado para hacerlo aún más acogedor.\r\nLa carta se renueva cada mes con productos frescos."
    ],
    "nl": [
      "Barservice vanaf 9.30 uur, de hele dag door.\r\nHet restaurant is volledig gerenoveerd om het nog gezelliger te maken.\r\nHet menu wordt elke 20 dagen vernieuwd met verse producten."
    ]
  },
