  "rdfs:comment": {
    "de": [
      "Als Ergebnis einer frühen Ansiedlung des Christentums existierte in Comps wahrscheinlich vor dem 10. Jahrhundert eine Pfarrei."
    ],
    "en": [
      "As a result of an early implantation of Christianity, a parish existed in Comps probably before the 10th century."
    ],
    "it": [
      "A seguito della precoce affermazione del cristianesimo, a Comps esisteva probabilmente una parrocchia già prima del X secolo."
    ],
    "fr": [
      "Résultat d'une implantation précoce du christianisme, une paroisse existait à Comps sans doute avant le 10ème siècle."
    ],
    "es": [
      "Debido a la temprana implantación del cristianismo, es probable que existiera una parroquia en Comps antes del siglo X."
