  "rdfs:comment": {
    "de": [
      "ORCINAS (alt: 307m) Die Gemeinde überragt das Land von Bourdeaux und überblickt am Horizont den Col de la Chaudière und die Ausläufer des Vercors. Eine Orientierungstafel befindet sich in der Nähe des Rathauses."
    ],
    "en": [
      "ORCINAS (alt: 307m) The village overlooks the Bourdeaux region, with the Col de la Chaudière and the Vercors foothills on the horizon. An orientation table is located near the town hall."
    ],
    "it": [
      "ORCINAS (alt : 307m) Il villaggio domina la zona di Bourdeaux e, all'orizzonte, il passo della Chaudière e le Prealpi del Vercors. Un tavolo di orientamento è situato vicino al municipio."
    ],
    "fr": [
      "ORCINAS (alt : 307m) La commune surplombe le pays de Bourdeaux et comtemple, à l'horizon, le col de la Chaudière et les contreforts du Vercors. Une table d'orientation se trouve près de la mairie."
    ],
    "nl": [
      "ORCINAS (hoogte: 307m) Het dorp kijkt uit over de Bourdeaux regio, met de Col de la Chaudière en de uitlopers van de Vercors aan de horizon. Er is een oriëntatietafel bij het gemeentehuis."
    ],
    "es": [
      "ORCINAS (alt : 307m) El pueblo domina la zona de Bourdeaux y en el horizonte, el puerto de la Chaudière y las estribaciones del Vercors. Hay una mesa de orientación cerca del ayuntamiento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village d'Orcinas"
    ]
  },
