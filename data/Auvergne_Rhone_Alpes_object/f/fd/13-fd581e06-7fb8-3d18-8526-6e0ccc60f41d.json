  "rdfs:comment": {
    "de": [
      "Die Archive des Departements Drôme sind eine Abteilung des Departementsrats des Departements Drôme, die damit beauftragt ist, Archive zu sammeln, zu klassifizieren, aufzubewahren und der Öffentlichkeit zugänglich zu machen."
    ],
    "en": [
      "The Drôme departmental archives are a service of the Drôme departmental council, responsible for collecting, classifying, preserving and making archives available to the public."
    ],
    "it": [
      "Gli archivi dipartimentali della Drôme sono un servizio del Consiglio dipartimentale della Drôme, responsabile della raccolta, della classificazione, della conservazione e della messa a disposizione del pubblico degli archivi."
    ],
    "fr": [
      "Les archives départementales de la Drôme sont un service du conseil départemental de la Drôme, chargé de collecter les archives, de les classer, les conserver et les mettre à la disposition du public."
    ],
    "es": [
      "Los archivos departamentales de la Drôme son un servicio del consejo departamental de la Drôme, encargado de recoger, clasificar, conservar y poner a disposición del público los archivos."
    ],
    "nl": [
      "De departementale archieven van Drôme zijn een dienst van de departementale raad van Drôme die verantwoordelijk is voor het verzamelen, classificeren en bewaren van archieven en deze toegankelijk maakt voor het publiek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Archives départementales de la Drôme"
    ]
  },
