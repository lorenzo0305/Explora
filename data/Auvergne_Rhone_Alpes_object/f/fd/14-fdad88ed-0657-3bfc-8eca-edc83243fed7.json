  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48e063ad-6148-3fdc-9ead-d7e49ef98b01",
      "dc:description": {
        "de": [
          "Zu Beginn des neuen Jahres veranstaltet der Freundeskreis des städtischen Personals sein Lotto. Verbringen Sie einen geselligen Moment mit der Familie oder mit Freunden und versuchen Sie, schöne Preise zu gewinnen!"
        ],
        "en": [
          "To mark the start of the new year, the Amicale du Personnel de la Ville is organizing its bingo. Come and spend a convivial moment with family and friends, and try your luck at winning some great prizes!"
        ],
        "it": [
          "All'inizio del nuovo anno, l'associazione del personale della città organizza una tombola. Venite a trascorrere un po' di tempo con la famiglia e gli amici e a tentare la fortuna per vincere fantastici premi!"
        ],
        "fr": [
          "En ce début de nouvelle année, l'amicale du personnel de la ville organise son loto. Venez passer un moment convivial en famille ou entre amis et tenter de remporter de très beaux lots !"
        ],
        "es": [
          "Con motivo del comienzo del nuevo año, la asociación de personal de la ciudad organiza su bingo. Ven a pasar un buen rato con la familia y los amigos, ¡y a probar suerte para ganar fantásticos premios!"
        ],
        "nl": [
          "Aan het begin van het nieuwe jaar organiseert de personeelsvereniging van de stad haar bingo. Kom wat tijd doorbrengen met familie en vrienden en waag je kans op mooie prijzen!"
        ]
      },
