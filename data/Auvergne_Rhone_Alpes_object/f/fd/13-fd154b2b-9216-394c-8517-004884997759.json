  "rdfs:comment": {
    "de": [
      "Neben der Heimat Lozère des Patrons sind es die Gastfreundschaft und die Liebe zu guten Produkten, die in diesem Restaurant zum Ausdruck kommen. Hier finden Sie vor allem Aubrac-Fleischstücke, Wurstwaren und Käse aus dieser Region."
    ],
    "en": [
      "In addition to the owner's native Lozère, it's the conviviality and love of good produce that shine through in this restaurant, where you'll find Aubrac meats, charcuterie and cheeses from this region."
    ],
    "it": [
      "Oltre alla Lozère, terra d'origine del proprietario, questo ristorante è all'insegna della convivialità e dell'amore per la buona tavola, con carni, salumi e formaggi dell'Aubrac."
    ],
    "fr": [
      "Outre la Lozère natale du patron, c'est la convivialité et l'amour des bons produits  qui transparaissent dans ce restaurant, où vous trouverez notamment des pièces de viande Aubrac, de la charcuterie et des fromages de cette région."
    ],
    "nl": [
      "Naast de Lozère waar de eigenaar vandaan komt, draait dit restaurant om gezelligheid en liefde voor lekker eten, met vlees, vleeswaren en kazen uit de Aubrac."
    ],
    "es": [
      "Además de la Lozère natal del propietario, este restaurante es todo convivencia y amor por la buena mesa, con carnes, charcutería y quesos de Aubrac."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Pépé Louis"
    ]
  },
