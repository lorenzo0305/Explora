  "rdfs:comment": {
    "de": [
      "Seit 1977 bietet Ihnen die Crêperie Le Flocon eine große Auswahl an Buchweizengaletten und Weizencrêpes, die nach rein bretonischer Tradition hergestellt werden. Lassen Sie sich verwöhnen und verbringen Sie eine angenehme Zeit!"
    ],
    "en": [
      "Since 1977, the Crêperie le Flocon has offered a wide selection of  buckwheat galettes and wheat flour crêpes made in the pure Breton tradition. Come and treat yourself and have a great time!"
    ],
    "it": [
      "Dal 1977, la Crêperie Le Flocon offre un'ampia scelta di galette di grano saraceno e di crêpes di frumento preparate secondo la pura tradizione bretone. Venite a farvi viziare e a divertirvi!"
    ],
    "fr": [
      "Depuis 1977, la Crêperie Le Flocon vous propose un large choix de galettes de blé noir et de crêpes de froment réalisées dans la pure tradition bretonne. Venez vous régaler et passer un agréable moment !"
    ],
    "nl": [
      "Le Flocon is een bretoense crêperie die vakantiegangers onthaalt sinds 1977."
    ],
    "es": [
      "Desde 1977, la Crêperie Le Flocon ofrece una amplia selección de galettes de trigo sarraceno y crêpes de trigo elaboradas según la pura tradición bretona. Venga a darse un capricho y ¡páselo en grande!"
    ]
  },
