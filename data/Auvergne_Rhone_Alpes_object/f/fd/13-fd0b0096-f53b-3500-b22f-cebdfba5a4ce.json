  "rdfs:comment": {
    "de": [
      "Gemütlicher und leckerer Coffeeshop, ideal für eine entspannte Pause bei einem Gourmetgetränk und hausgemachten Süßigkeiten. Gesundes Essensangebot am Mittag."
    ],
    "en": [
      "Cosy, gourmet coffee shop, ideal for a relaxing break over a gourmet drink and homemade sweets. Healthy catering at lunchtime."
    ],
    "it": [
      "Un'accogliente caffetteria gourmet, ideale per una pausa rilassante davanti a un drink gourmet e a dolci fatti in casa. A pranzo sono disponibili pasti salutari."
    ],
    "fr": [
      "Coffee shop cosy et gourmand, idéal pour une pause détente autour d'une boisson gourmande et de douceurs maison. Offre de restauration saine le midi."
    ],
    "es": [
      "Una acogedora cafetería gourmet, ideal para relajarse con una bebida gourmet y dulces caseros. A mediodía se sirven platos saludables."
    ],
    "nl": [
      "Een gezellige, gastronomische koffieshop, ideaal voor een ontspannen pauze onder het genot van een gourmetdrankje en zelfgemaakte zoetigheden. Gezonde maaltijden verkrijgbaar tijdens de lunch."
    ]
  },
  "rdfs:label": {
