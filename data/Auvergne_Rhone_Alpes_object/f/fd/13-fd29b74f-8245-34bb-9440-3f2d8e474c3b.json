  "rdfs:comment": {
    "de": [
      "Im Herzen des Sancy-Massivs und des regionalen Naturparks Volcans d'Auvergne, der zum UNESCO-Weltkulturerbe gehört, empfängt Sie das SPA Les Bains Romains in den alten Thermen von Saint-Nectaire."
    ],
    "en": [
      "The Hotel Mercure *** is a charming establishment located in the heart of the Sancy Massif and the Auvergne Volcanoes Regional Natural Park, listed as a UNESCO World Heritage Site. It created the SPA les Bains Romains in 2014, in the former thermal baths of Saint-Nectaire."
    ],
    "it": [
      "Situata nel cuore del massiccio del Sancy e del Parc Naturel Régional des Volcans d'Auvergne, Patrimonio dell'Umanità dell'UNESCO, la SPA les Bains Romains vi accoglie nelle antiche terme di Saint-Nectaire."
    ],
    "fr": [
      "Situé au cœur du massif du Sancy  et du Parc Naturel Régional des Volcans d’Auvergne, inscrit au patrimoine de l’UNESCO, le SPA les Bains Romains vous accueille dans les anciens thermes de Saint-Nectaire."
    ],
    "es": [
      "Situado en el corazón del macizo de Sancy y del Parque Natural Regional de los Volcanes de Auvernia, declarado Patrimonio de la Humanidad por la UNESCO, el SPA les Bains Romains le da la bienvenida a los antiguos baños termales de Saint-Nectaire."
    ],
    "nl": [
      "In het hart van het Sancy-massief en het Parc Naturel Régional des Volcans d'Auvergne, dat op de Werelderfgoedlijst van UNESCO staat, heet SPA les Bains Romains je welkom in de voormalige thermen van Saint-Nectaire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mercure Saint-Nectaire Spa et Bien-être"
    ]
  },
