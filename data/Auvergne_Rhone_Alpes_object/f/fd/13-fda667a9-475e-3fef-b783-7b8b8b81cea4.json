  "rdfs:comment": {
    "de": [
      "Kommen Sie und amüsieren Sie sich im Herzen der Stadt Vals-les-Bains. Auf dem Programm stehen Seilrutschen, hängende Netze und Laufstege. Schattige Parcours für die ganze Familie. Neuheit 2024: Escape Game im Wald. Begeben Sie sich auf die Spuren des berühmtesten aller Zauberer!"
    ],
    "en": [
      "Come and have fun in the heart of the town of Vals-les-Bains, with a programme featuring zip-lines, suspended nets and footbridges. Shady courses for all the family. New for 2024: Escape Game in the forest. Follow in the footsteps of the world's most famous wizard!"
    ],
    "it": [
      "Venite a divertirvi nel cuore della città di Vals-les-Bains, con un programma che prevede zip-line, reti sospese e passerelle. Percorsi ombreggiati per tutta la famiglia. Novità 2024: Escape Game nella foresta. Seguite le orme del mago più famoso del mondo!"
    ],
    "fr": [
      "Venez vous amuser au cœur de la cité de Vals-les-Bains, avec au programme tyroliennes, filets suspendus, passerelles. Des parcours ombragés pour toute la famille. Nouveauté 2024 : Escape Game en forêt. Partez sur les traces du plus célèbre des sorciers !"
    ],
    "es": [
      "Venga a divertirse en el corazón de la ciudad de Vals-les-Bains, con un programa que incluye tirolinas, redes colgantes y pasarelas. Recorridos sombreados para toda la familia. Novedad 2024: Escape Game en el bosque. ¡Siga los pasos del mago más famoso del mundo!"
    ],
    "nl": [
      "Kom plezier maken in het hart van de stad Vals-les-Bains, met een programma met tokkelbanen, hangnetten en loopbruggen. Schaduwrijke parcoursen voor het hele gezin. Nieuw in 2024: Escape Game in het bos. Treed in de voetsporen van de beroemdste tovenaar ter wereld!"
    ]
  },
