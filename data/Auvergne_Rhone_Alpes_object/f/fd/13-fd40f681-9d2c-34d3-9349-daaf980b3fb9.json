  "rdfs:comment": {
    "de": [
      "Die Theatergruppe La Clique wagt es und bietet Ihnen an, Regisseur oder sogar Autor einer Boulevardkomödie zu werden. Ausgangspunkt sind ein Bühnenbild und Schauspieler."
    ],
    "en": [
      "La Clique dares to offer you the chance to become the director or even the author of a boulevard comedy. The starting point is a set and actors."
    ],
    "it": [
      "La Clique osa offrirvi la possibilità di diventare il regista o addirittura l'autore di una commedia da boulevard. Il punto di partenza è un set e degli attori."
    ],
    "fr": [
      "La compagnie La Clique ose et vous propose de devenir metteur en scène voire même auteur de comédie de boulevard. Point de départ, un décor et des comédiens."
    ],
    "es": [
      "La Clique se atreve a ofrecerle la posibilidad de convertirse en el director o incluso en el autor de una comedia de bulevar. El punto de partida es un decorado y unos actores."
    ],
    "nl": [
      "La Clique durft je de kans te bieden om de regisseur of zelfs de auteur te worden van een boulevardkomedie. Het uitgangspunt is een decor en acteurs."
    ]
  },
