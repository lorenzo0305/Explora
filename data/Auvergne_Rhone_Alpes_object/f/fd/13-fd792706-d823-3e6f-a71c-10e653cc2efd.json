  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Schloss La Vigne und seine erstaunlichen Ausstellungen...Eine äußerst seltene Entdeckung: \"Le Studiolo\"! Ein grandioses Panorama auf die Monts du Cantal und ein lebendiges, möbliertes und bewohntes Schloss."
    ],
    "en": [
      "Visit the castle and its amazing exhibitions...The “studiolo » is a very rare discovery. Panorama of the Cantal Mountains, Still occupied by the descendants of the original builders,"
    ],
    "it": [
      "Visitate il castello di La Vigne e le sue sorprendenti mostre... Una rara scoperta: \"Le Studiolo\"! Un grandioso panorama sui Monts du Cantal e un castello vivo, arredato e abitato."
    ],
    "fr": [
      "Visitez le château de La Vigne et ses étonnantes expositions...Une découverte rarissime : \"Le Studiolo\" ! Un panorama grandiose sur les Monts du Cantal et un château vivant, meublé et habité."
    ],
    "es": [
      "Visite el castillo de La Vigne y sus sorprendentes exposiciones... Un raro descubrimiento: ¡\"Le Studiolo\"! Un grandioso panorama de los Montes del Cantal y un castillo vivo, amueblado y habitado."
    ],
    "nl": [
      "Bezoek het kasteel van La Vigne en zijn verbazingwekkende tentoonstellingen... Een zeldzame ontdekking: \"Le Studiolo\"! Een grandioos panorama op de Monts du Cantal en een levend, gemeubileerd en bewoond kasteel."
    ]
  },
