  "rdfs:comment": {
    "de": [
      "Der Zoo von Maubeuge empfängt Sie zu einer Naturpause mit der Familie oder Freunden inmitten eines wunderschönen Parks mit Blumen und Bäumen an den Stadtmauern von Vauban, mitten im Stadtzentrum."
    ],
    "en": [
      "The Maubeuge Zoo welcomes you for a nature break with your family or friends, in the heart of a magnificent park full of flowers and trees on the Vauban ramparts, right in the city center."
    ],
    "it": [
      "Lo zoo di Maubeuge vi accoglie per una pausa nella natura con la famiglia o gli amici, nel cuore di un magnifico parco con fiori e alberi sui bastioni di Vauban, proprio nel centro della città."
    ],
    "fr": [
      "Le Zoo de Maubeuge vous accueille pour une pause nature en famille ou entre amis, au cœur d’un magnifique parc fleuri et arboré des remparts de Vauban, en plein centre ville."
    ],
    "es": [
      "El zoológico de Maubeuge le da la bienvenida para una escapada a la naturaleza con su familia o amigos, en el corazón de un magnífico parque con flores y árboles en las murallas de Vauban, en pleno centro de la ciudad."
    ],
    "nl": [
      "De dierentuin van Maubeuge verwelkomt u voor een natuurvakantie met uw gezin of vrienden, in het hart van een prachtig park vol bloemen en bomen op de vestingmuren van Vauban, midden in het stadscentrum."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Zoo de Maubeuge"
    ]
  },
