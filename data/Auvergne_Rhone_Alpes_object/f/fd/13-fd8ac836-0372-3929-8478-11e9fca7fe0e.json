  "rdfs:comment": {
    "de": [
      "Spielen, teilen und amüsieren Sie sich beim Pétanque-Wettbewerb des Tennisclubs, der für alle offen ist!  Ob Sie Anfänger oder Experte sind, bilden Sie Ihr Doublette und versuchen Sie, den Sieg zu erringen!"
    ],
    "en": [
      "Come and play, share and have fun at the tennis club's Pétanque competition, open to all!  Whether you're a beginner or an expert, form your doublette and try to win!"
    ],
    "it": [
      "Venite a giocare, condividere e divertirvi alla gara di pétanque del Tennis Club, aperta a tutti!  Che siate principianti o esperti, riunite i vostri doppi e cercate di vincere!"
    ],
    "fr": [
      "Venez jouer, partager et vous amuser lors du concours de Pétanque du club de tennis ouvert à tous !  Que vous soyez débutant ou expert, formez votre doublette et tentez de décrocher la victoire !"
    ],
    "es": [
      "Ven a jugar, compartir y divertirte en la competición de petanca del club de tenis, ¡abierta a todos!  Tanto si eres principiante como experto, ¡une a tus dobles e intenta ganar!"
    ],
    "nl": [
      "Kom spelen, delen en plezier maken tijdens de jeu de boules competitie van de tennisclub, die voor iedereen toegankelijk is!  Of je nu een beginner of een expert bent, verzamel je dubbels en probeer te winnen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concours de pétanque"
    ]
  },
