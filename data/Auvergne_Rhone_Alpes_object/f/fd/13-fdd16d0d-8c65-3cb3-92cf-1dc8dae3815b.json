  "rdfs:comment": {
    "de": [
      "Ons etablissement, gelegen in het hart van het dorpscentrum tegenover het Aravis-massief, combineert bergcharme met comfort. De directe nabijheid van winkels en activiteiten stelt u in staat om optimaal te genieten van Le Grand-Bornand."
    ],
    "en": [
      "Located right in the heart of the village, facing the Aravis mountain range, our establishment combines mountain charm and comfort. Immediate proximity to shops and activities will allow you to fully enjoy Grand-Bornand."
    ],
    "it": [
      "Situata nel cuore del centro del paese, di fronte alla catena montuosa degli Aravis, la nostra struttura unisce il fascino della montagna al comfort. L'immediata vicinanza ai negozi e alle attività vi permetterà di vivere al meglio Le Grand-Bornand."
    ],
    "fr": [
      "Situé en plein cœur du centre du village face à la chaine des Aravis, notre établissement allie charme montagnard et confort. Une proximité immédiate des commerces et des activés vous permettra de profiter pleinement du Grand-Bornand."
    ],
    "es": [
      "Situado en pleno centro del pueblo, frente a la cadena de los Aravis, nuestro establecimiento combina el encanto de la montaña con la comodidad. Una proximidad inmediata a los comercios y actividades le permitirá disfrutar plenamente de Le Grand-Bornand."
    ],
    "nl": [
      "Ons etablissement ligt in het hart van het dorpscentrum tegenover het Aravis-gebergte en combineert bergcharme en comfort. Dankzij de directe nabijheid van winkels en activiteiten kunt u optimaal genieten van Le Grand-Bornand."
    ]
  },
