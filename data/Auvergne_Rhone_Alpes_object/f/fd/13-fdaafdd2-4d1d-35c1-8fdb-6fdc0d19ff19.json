  "rdfs:comment": {
    "de": [
      "Entdecken Sie Signature Cocktails und Mocktails, begleitet von leckeren Tapas, in einer freundlichen und beruhigenden Atmosphäre, sowohl drinnen als auch draußen. Genießen Sie auch Themen-Afterworks und privatisierte Abende."
    ],
    "en": [
      "Discover our signature cocktails and mocktails, paired with delicious tapas, in a warm and relaxing atmosphere indoors or outdoors. Join us for themed afterworks or book your own private evening."
    ],
    "it": [
      "Scoprite cocktail e mocktail d'autore, accompagnati da gustose tapas, in un'atmosfera accogliente e rilassante, all'interno o all'esterno. È inoltre possibile partecipare a sessioni di dopolavoro a tema e a serate private."
    ],
    "fr": [
      "Découvrez des cocktails et mocktails signature, accompagnés de tapas savoureux, dans une ambiance conviviale et apaisante, en intérieur comme en extérieur. Profitez aussi des afterworks à thème et des soirées privatisées."
    ],
    "nl": [
      "Ontdek de kenmerkende cocktails en mocktails, vergezeld van smakelijke tapas, in een vriendelijke, rustgevende sfeer, binnen of buiten. Je kunt ook genieten van thematische sessies na het werk en privéavonden."
    ],
    "es": [
      "Descubra cócteles y mocktails de autor, acompañados de sabrosas tapas, en un ambiente agradable y relajante, en el interior o al aire libre. También puede disfrutar de sesiones temáticas afterwork y veladas privadas."
    ]
  },
