  "rdfs:comment": {
    "de": [
      "Laurent, Roxane und ihr Team heißen Sie im Herzen des Dorfes herzlich willkommen. Entdecken Sie eine sonnige Terrasse mit Blick auf die Berge und ein authentisches Ambiente im Inneren!"
    ],
    "en": [
      "Laurent, Roxane and their team welcome you to the heart of the village. Come and discover a sunny terrace with a view of the mountains and an authentic setting inside!"
    ],
    "it": [
      "Laurent, Roxane e il loro team vi accolgono nel cuore del villaggio. Venite a scoprire una terrazza soleggiata con vista sulle montagne e un ambiente autentico all'interno!"
    ],
    "fr": [
      "Laurent, Roxane et leur équipe vous accueillent au cœur du village. Venez découvrir une terrasse ensoleillée avec vue sur les montagnes et un cadre authentique à l’intérieur !"
    ],
    "es": [
      "Laurent, Roxane y su equipo le dan la bienvenida al corazón del pueblo. ¡Ven y descubre una terraza soleada con vistas a las montañas y un entorno auténtico en el interior!"
    ],
    "nl": [
      "Laurent, Roxane en hun team heten u welkom in het hart van het dorp. Kom en ontdek een zonnig terras met uitzicht op de bergen en een authentiek kader binnen!"
    ]
  },
