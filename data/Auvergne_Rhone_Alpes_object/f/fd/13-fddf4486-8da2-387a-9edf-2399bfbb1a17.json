  "rdfs:comment": {
    "de": [
      "Italienische Spezialitäten,Pizza, Pasta ... Tiramisu"
    ],
    "en": [
      "Italian specialities including pizza, pasta and tiramisu."
    ],
    "it": [
      "Pizz?à Vitto vi offre le sue pizze 100% fatte in casa, personalizzabili, con prodotti freschi e di qualità.\r\nIl servizio al tavolo e i piatti italiani sono serviti a Margerie e un distributore automatico è disponibile 7 giorni alla settimana;"
    ],
    "fr": [
      "Pizz’à Vitto vous propose ses pizzas de fabrication 100% artisanales, personnalisables, avec des produits frais et de qualité.\r\nUn service à table et des plats italiens sont servis à Margerie ainsi qu'un distributeur est à disposition 7j sur 7;"
    ],
    "nl": [
      "Pizzà Vitto biedt u zijn 100% huisgemaakte pizza's, aanpasbaar, met verse en kwaliteitsproducten.\r\nTafelservice en Italiaanse gerechten worden geserveerd in Margerie en een automaat is 7 dagen per week beschikbaar;"
    ],
    "es": [
      "Pizz?à Vitto le ofrece sus pizzas 100% caseras, personalizables, con productos frescos y de calidad.\r\nEn Margerie se sirve servicio de mesa y platos italianos, y hay una máquina expendedora disponible los 7 días de la semana;"
    ]
  },
