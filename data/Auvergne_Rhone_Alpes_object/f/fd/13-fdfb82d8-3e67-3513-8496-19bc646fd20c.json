  "rdfs:comment": {
    "de": [
      "Lokale savoyardische Spezialitäten von gestern und heute und auf Holzfeuer gebacken: Brennnesselkuchen, Kartoffelkrapfen, Farcement (auf Bestellung), Kürbiskuchen Kastanien, Pfirsiche mit Gewürzen, Äpfel mit Preiselbeeren, Schokoladenfondant, Jagd..."
    ],
    "en": [
      "Restaurant serving local specialities savoy past and present cooked in a log fire."
    ],
    "it": [
      "Specialità locali savoiarde di ieri e di oggi cucinate sul fuoco a legna: torta di ortiche, frittelle di patate, ripieno (su ordinazione), torta di zucca e castagne, pesche speziate, mele ai mirtilli rossi, fondente al cioccolato, caccia..."
    ],
    "fr": [
      "Spécialités locales savoyardes d'hier et d'aujourd'hui et cuisson au feu de bois : tarte à l'ortie, beignets de pommes de terre, farcement, (sur commande), tarte potiron châtaignes, pêches aux épices, pommes aux airelles, fondant chocolat, chasse..."
    ],
    "nl": [
      "Lokale Savoyaardse specialiteiten van gisteren en vandaag, bereid op een houtvuur: brandneteltaart, aardappelbeignets, vulling (op bestelling), pompoen- en kastanjetaart, gekruide perziken, veenbessenappels, chocoladefondant, jacht..."
    ],
    "es": [
      "Especialidades locales de Saboya de ayer y de hoy y cocinadas a fuego de leña: pastel de ortigas, buñuelos de patata, relleno (por encargo), pastel de calabaza y castañas, melocotones especiados, manzanas con arándanos, fondant de chocolate, caza..."
    ]
  },
