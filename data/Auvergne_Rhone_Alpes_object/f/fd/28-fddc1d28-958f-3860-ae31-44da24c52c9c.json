  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ccb2b688-f79d-3d0a-a070-e27590106f5c",
      "dc:description": {
        "de": [
          "L'estaminet de la petite place ist eine Bar Brasserie in der Altstadt von Douai aus dem 17. Jahrhundert, in der Sie typische und regionale Gerichte sowie traditionelle und abwechslungsreiche Braugerichte genießen können."
        ],
        "en": [
          "L'estaminet de la petite place is a brasserie bar in old Douai dating back to the 17th century, where you can enjoy typical regional dishes and a variety of traditional brasserie fare in a warm atmosphere."
        ],
        "it": [
          "L'estaminet de la petite place è un bar brasserie situato nel centro storico di Douai, risalente al XVII secolo. In un ambiente accogliente si possono gustare piatti tipici regionali e una varietà di piatti tradizionali della brasserie."
        ],
        "fr": [
          "L'estaminet de la petite place est un bar brasserie situé dans le vieux Douai datant du 17eme siècle, c'est dans un cadre chaleureux que vous pourrez déguster les plats typiques et régionaux ainsi que des plats de brasseries traditionnels et variés."
        ],
        "nl": [
          "L'estaminet de la petite place is een brasseriebar in het oude centrum van Douai, daterend uit de 17e eeuw. In een warme omgeving kun je genieten van typische streekgerechten en een verscheidenheid aan traditionele brasseriegerechten."
        ],
        "es": [
          "L'estaminet de la petite place es un bar brasserie situado en el casco antiguo de Douai, que data del siglo XVII. En un ambiente cálido, podrá degustar platos típicos de la región, así como una gran variedad de platos tradicionales de brasserie."
        ]
      },
