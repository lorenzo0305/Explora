  "rdfs:comment": {
    "de": [
      "SIND SIE BEREIT, IHRE GESCHMACKSKNOSPEN ZUM RHYTHMUS DER UKULELE TANZEN ZU LASSEN?"
    ],
    "en": [
      "De l’hawaïen qui signifie « couper en dés », le poké est la version moderne du plat traditionnel d’Hawaï : du poisson cru mariné coupé en dés, accompagné de riz vinaigré et de garnitures de crudités et de fruits frais. Parce que Poké rime avec qualité, Pokawa vous propose des produits frais et de qualité chaque jour."
    ],
    "it": [
      "PRONTI A FAR BALLARE LE VOSTRE PAPILLE GUSTATIVE A RITMO DI UKULELE?"
    ],
    "fr": [
      "PRÊT(E) À FAIRE DANSER VOS PAPILLES AU RYTHME DES UKULÉLÉS ?"
    ],
    "es": [
      "¿LISTO PARA HACER BAILAR SUS PAPILAS GUSTATIVAS AL RITMO DE UKELELES?"
    ],
    "nl": [
      "KLAAR OM UW SMAAKPAPILLEN TE LATEN DANSEN OP HET RITME VAN UKELELES?"
    ]
  },
