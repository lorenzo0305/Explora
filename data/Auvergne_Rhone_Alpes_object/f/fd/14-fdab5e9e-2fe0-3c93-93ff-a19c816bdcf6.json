  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9be320f2-a3c2-39f3-b1ef-30ba25e8a357",
      "dc:description": {
        "de": [
          "Erleben Sie das Science-Fiction-Universum von Star Wars - Krieg der Sterne von George Lucas.\nDie Ausstellung zeigt lebensgroße Figuren, Kostüme und Merchandising-Artikel von 1977 bis 2022."
        ],
        "en": [
          "Discover the science fiction universe of Star Wars - Star Wars by George Lucas.\nThe exhibition features life-size characters, costumes and merchandise from 1977 to 2022."
        ],
        "it": [
          "Scoprite l'universo fantascientifico di Star Wars - Guerre stellari di George Lucas.\nL'esposizione presenta personaggi a grandezza naturale, costumi e prodotti dal 1977 al 2022."
        ],
        "fr": [
          "Retrouvez l'univers de science-fiction de Star Wars - La guerre des étoiles de Georges Lucas.\nL'exposition présente des personnages en taille réelle, des costumes et d’objets dérivés de 1977 à 2022."
        ],
        "nl": [
          "Ontdek het sciencefictionuniversum van Star Wars - Star Wars van George Lucas.\nDe tentoonstelling toont levensgrote personages, kostuums en merchandise van 1977 tot 2022."
        ],
        "es": [
          "Descubre el universo de ciencia ficción de La Guerra de las Galaxias - Star Wars de George Lucas.\nLa exposición cuenta con personajes de tamaño natural, trajes y artículos de merchandising desde 1977 hasta 2022."
        ]
      },
