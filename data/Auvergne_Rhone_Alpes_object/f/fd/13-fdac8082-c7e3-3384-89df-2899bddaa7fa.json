  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen des L'Entracte, wo Sie von der intimen, schrägen Dekoration, der Brasserie und dem Restaurant angesprochen werden."
    ],
    "en": [
      "Push the doors of l'Entracte where you will be challenged by an intimate, offbeat decoration, by the Brasserie and the restaurant."
    ],
    "it": [
      "Aprite le porte de l'Entracte e rimarrete colpiti dall'arredamento intimo e stravagante, dalla Brasserie e dal ristorante."
    ],
    "fr": [
      "Poussez les portes de l'Entracte où vous serez interpellé par une décoration intimiste, décalée, par la Brasserie et le restaurant."
    ],
    "nl": [
      "Duw de deuren van l'Entracte open en je zult onder de indruk zijn van de intieme, eigenzinnige inrichting, de Brasserie en het restaurant."
    ],
