  "rdfs:comment": {
    "de": [
      "Béatrice empfängt Sie mit einem Lächeln in einer freundlichen Umgebung. Sie bietet Ihnen eine traditionelle Küche und \"hausgemachte\" Gerichte.  Der Empfang an der Bar ist durchgehend. An schönen Tagen können Sie auf der Terrasse zu Mittag essen."
    ],
    "en": [
      "Béatrice welcomes you with a smile, in a friendly atmosphere. She offers traditional cuisine and homemade dishes.  The bar is open all day. On sunny days, you can enjoy lunch on the terrace."
    ],
    "it": [
      "Béatrice vi accoglie con un sorriso, in un'atmosfera amichevole. Offre una cucina tradizionale e piatti fatti in casa.  Il bar è aperto tutto il giorno. Nelle giornate di sole, è possibile pranzare sulla terrazza."
    ],
    "fr": [
      "Béatrice vous accueille avec le sourire, dans un cadre convivial. Elle vous propose une cuisine traditionnelle, des plats \"fait maison\".  L'accueil au bar est en continu. Aux beaux jours, vous pourrez déjeuner en terrasse."
    ],
    "nl": [
      "Béatrice verwelkomt je met een glimlach, in een vriendelijke sfeer. Ze biedt een traditionele keuken en huisgemaakte gerechten.  De bar is de hele dag open. Op zonnige dagen kun je genieten van een lunch op het terras."
    ],
    "es": [
      "Béatrice le recibe con una sonrisa, en un ambiente acogedor. Ofrece cocina tradicional y platos caseros.  El bar está abierto todo el día. Los días soleados, se puede comer en la terraza."
    ]
  },
