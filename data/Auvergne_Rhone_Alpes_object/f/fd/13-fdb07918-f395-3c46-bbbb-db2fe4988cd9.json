  "rdfs:comment": {
    "de": [
      "Im Herzen der Alpen sind Sie in dieser Oase des Friedens und der Harmonie herzlich willkommen. Begeben Sie sich in die Hände von Caroline! Entdecken Sie ihre Massagen, ihren Qi Gong-Ansatz und ihre Behandlungen aus der traditionellen chinesischen Medizin."
    ],
    "en": [
      "In the heart of the Alps, you're welcome in this haven of peace and harmony. Put yourself in Caroline's hands! Discover her massages, her approach to Qi Gong and her treatments based on traditional Chinese medicine."
    ],
    "it": [
      "Nel cuore delle Alpi, siete i benvenuti in questa oasi di pace e armonia. Mettetevi nelle mani di Caroline! Scoprite i suoi massaggi, il suo approccio al Qi Gong e i suoi trattamenti basati sulla medicina tradizionale cinese."
    ],
    "fr": [
      "Au cœur des Alpes, vous êtes les bienvenus dans ce havre de paix et d’harmonie. Remettez-vous aux mains de Caroline ! Découvrez ses massages, son approche du Qi Gong et ses soins issus de la médecine traditionnelle chinoise."
    ],
    "nl": [
      "In het hart van de Alpen ben je welkom in deze oase van rust en harmonie. Leg jezelf in de handen van Caroline! Ontdek haar massages, haar benadering van Qi Gong en haar behandelingen op basis van traditionele Chinese geneeskunde."
    ],
    "es": [
      "En el corazón de los Alpes, será bienvenido a este remanso de paz y armonía. Póngase en manos de Caroline. Descubra sus masajes, su enfoque del Qi Gong y sus tratamientos basados en la medicina tradicional china."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'énergie du bien être - Energy healing, Qi gong, massage, foot reflexology"
    ],
    "it": [
      "L'énergie du bien être - Trattamenti energetici, Qi gong, massaggi, riflessologia plantare"
    ],
    "fr": [
      "L'énergie du bien être - Soins énergétiques, Qi gong, massage, réflexologie plantaire"
    ],
    "es": [
      "L'énergie du bien être - Tratamientos energéticos, Qi gong, masajes, reflexología podal"
    ],
    "nl": [
      "L'énergie du bien être - Energetische behandelingen, Qi gong, massage, voetreflexologie"
    ]
