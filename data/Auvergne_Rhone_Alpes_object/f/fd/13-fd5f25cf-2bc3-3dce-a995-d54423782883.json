  "rdfs:comment": {
    "de": [
      "Der Pumptrack-Bereich und der Parc mobi'ludique von Sassenage, die sich im Bereich des Sportkomplexes Les Iles befinden, sind für alle, die gerne gleiten und Fahrrad fahren lernen, frei zugänglich."
    ],
    "en": [
      "Sassenage's Pumptrack area and mobi'ludique park, located in the Iles sports complex area, are freely accessible to all enthusiasts of gliding and learning to ride a bike."
    ],
    "it": [
      "L'area Pumptrack e il parco mobi'ldique di Sassenage, situato nell'area del complesso sportivo di Iles, sono liberamente accessibili a tutti coloro che hanno la passione di scivolare e di imparare ad andare in bicicletta."
    ],
    "fr": [
      "L'espace Pumptrack et le parc mobi'ludique de Sassenage, situés sur le secteur du complexe sportif des Iles, sont accessibles librement à tous les passionnés de glisse et d'apprentissage du vélo."
    ],
    "es": [
      "La zona Pumptrack y el parque mobi'ludique de Sassenage, situados en la zona del complejo deportivo de Iles, son de libre acceso para todos los amantes del deslizamiento y del aprendizaje de la bicicleta."
    ],
    "nl": [
      "De Pumptrack en het mobi'ludique park in Sassenage, gelegen in het sportcomplex Iles, zijn vrij toegankelijk voor iedereen met een passie voor glijden en leren fietsen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Sass'track"
    ]
  },
