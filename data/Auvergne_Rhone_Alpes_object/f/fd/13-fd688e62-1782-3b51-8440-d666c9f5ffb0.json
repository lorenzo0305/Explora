  "rdfs:comment": {
    "de": [
      "Keramik, Graphik(Handschrift), Zeichnung, Malerei...\r\nJulia Huteau, Blandine Masure, Sarah Clotuche, Lisalie Quatremère, Lena Von Busse,  Pierre Gouëset, Yves Coladon, Lisa Renberg"
    ],
    "en": [
      "Ceramic, graphics, drawing, painting...\r\nJulia Huteau, Blandine Masure, Sarah Clotuche, Lisalie Quatremère, Lena Von Busse, Pierre Gouëset, Yves Coladon, Lisa Renberg."
    ],
    "it": [
      "Incubatore di attori locali impegnati e creativi nell'area di Dieulefit. L'Usine è un terzo luogo situato nella Drôme Provençale al confine tra Le Poët-Laval e Dieulefit."
    ],
    "fr": [
      "Pépinière d'acteurs locaux engagés et créatifs au pays de Dieulefit. L'Usine est un tiers-lieu basé en Drôme Provençale à la frontière du Poët-Laval et de Dieulefit."
    ],
    "nl": [
      "Keramiek, graphics(handschrift), tekening, verf(spuiten)...\r\nJulia Hutteau, dankzij de Masure, Sarah Clotuche, Lisalie Quatremère, Lena Von Busse,  Pierre Gouëset, Yves Coladon, Lisa Renberg."
    ],
    "es": [
      "Incubadora de actores locales comprometidos y creativos en la zona de Dieulefit. L'Usine es un tercer lugar situado en la Drôme provenzal, en la frontera de Le Poët-Laval y Dieulefit."
    ]
