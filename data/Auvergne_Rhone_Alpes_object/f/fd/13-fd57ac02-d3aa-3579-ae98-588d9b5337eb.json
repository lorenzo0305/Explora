  "rdfs:comment": {
    "de": [
      "Parfümeur und unabhängiger Hersteller von originellen Kompositionen: Toilettenwasser, Duftwasser, Parfüms für zu Hause, Amber, feste Parfüms, Furoshiki aus parfümierter Hirse?"
    ],
    "en": [
      "LE JARDIN DE MON GRAND-PÈRE is an independent creator and perfume maker of original compositions: essences, eaux de toilette, aromatic waters, solid perfumes, furoshiki of perfumed millet, colognes, home fragrances, amber perfume and aroma bars…"
    ],
    "it": [
      "Profumiere artigianale e produttore indipendente di composizioni originali: eaux de toilettes, eaux aromatiques, fragranze per la casa, ambra, profumi solidi, furoshiki di miglio profumato?"
    ],
    "fr": [
      "Parfumeur artisan et fabricant indépendant de compositions originales : eaux de toilettes, eaux aromatiques, parfums pour la maison, ambre, parfums solides, furoshiki de millet parfumé…"
    ],
    "es": [
      "un perfumista creador y fabricante independiente de composiciones originales  esencias, “eaux de toilette” o aguas de tocador, aguas aromáticas, perfumes sólidos, furoshiki de mijo perfumado, colonias, fragancias caseras, perfumes ámbar y aromas ..."
    ],
    "nl": [
      "Ambachtelijke parfumeur en onafhankelijk fabrikant van originele composities: eaux de toilettes, eaux aromatiques, huisparfums, amber, vaste parfums, geparfumeerde gierst furoshiki?"
    ]
  },
  "rdfs:label": {
