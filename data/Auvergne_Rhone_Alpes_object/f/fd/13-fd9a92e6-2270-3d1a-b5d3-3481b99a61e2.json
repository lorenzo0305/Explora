  "rdfs:comment": {
    "de": [
      "Avoscoot bietet Ihnen Schneemobilfahrten in einem der schönsten Gebiete von Avoriaz an. Die Strecke führt über Waldwege und bietet Ihnen ein herrliches Panorama auf den Ort Avoriaz, das Tal von Morzine und die Umgebung."
    ],
    "en": [
      "The circuit winds through forest trails and offers you a magnificent panorama over the resort of Avoriaz, the Morzine valley, and the surrounding landscape.\r\nEvery evening from 5:30pm, Avoscoot offers skidoo rides around the Proclou area."
    ],
    "it": [
      "Avoscoot vi offre gite in motoslitta in una delle zone più belle di Avoriaz. Il percorso segue sentieri forestali e offre un magnifico panorama della località di Avoriaz, della valle di Morzine e dei suoi dintorni."
    ],
    "fr": [
      "Avoscoot vous propose des balades en Motoneiges sur un des plus beaux secteurs d'Avoriaz. Le parcours emprunte des chemins forestiers et vous offre un magnifique panorama sur la station d’Avoriaz, la vallée de Morzine et ses environs."
    ],
    "es": [
      "Avoscoot le ofrece paseos en moto de nieve en una de las zonas más bellas de Avoriaz. La ruta sigue caminos forestales y ofrece un magnífico panorama de la estación de Avoriaz, el valle de Morzine y sus alrededores."
    ],
    "nl": [
      "Avoscoot biedt sneeuwscootertochten in een van de mooiste gebieden van Avoriaz. De route volgt bospaden en biedt prachtige panoramische uitzichten over het skioord Avoriaz, de vallei van Morzine en de omgeving."
    ]
  },
