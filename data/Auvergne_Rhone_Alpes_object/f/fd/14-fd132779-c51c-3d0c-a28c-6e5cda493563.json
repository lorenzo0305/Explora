  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/60219f1f-9a2c-34b8-80eb-2de7501d2659",
      "dc:description": {
        "de": [
          "Fischgeschäft, Feinkostladen und Austernbar.\n7 Tage die Woche geöffnet\n\nFischgeschäft/Feinkostladen: von 9:00 bis 21:00 Uhr.\n\nAusternbar mit 20 Sitzplätzen außerhalb der Saison nonstop von 11 bis 21 Uhr und im Sommer bis 22 Uhr geöffnet.\nAusternverkostung: Spezialaustern von Gillardeau, Fine de Claire, Fine de Normandes.\nPlatten mit Meeresfrüchten\nHausgemachter geräucherter Lachs\nHausgemachte Fischsuppe nach Belieben!"
        ],
        "en": [
          "Fishmonger's, delicatessen and oyster bar.\nOpen 7 days a week\n\nFishmonger/caterer: 9am to 9pm.\n\n20-seat oyster bar open from 11am to 9pm non-stop out of season and until 10pm in summer.\nOyster tasting: special Gillardeau, Fine de Claire, Fine de Normandes.\nSeafood platters\nHome-smoked salmon\nAll-you-can-eat homemade fish soup!"
        ],
        "it": [
          "Pescheria, catering e oyster bar.\nAperto 7 giorni su 7\n\nPescheria/catering: dalle 9 alle 21.\n\nOyster bar con 20 posti a sedere, aperto dalle 11 alle 21 ininterrottamente fuori stagione e fino alle 22 in estate.\nDegustazione di ostriche: speciali Gillardeau, Fine de Claire, Fine de Normandes.\nPiatti di pesce\nSalmone affumicato in casa\nZuppa di pesce fatta in casa a volontà!"
        ],
        "fr": [
          "Poissonnerie, traiteur et bar à huîtres.\nOuvert 7j/7\n\nPoissonnerie/traiteur : de 9h à 21h.\n\nBar à huîtres de 20 places assises ouvert de 11h à 21h non stop hors saison et jusqu'à 22h l'été.\nDégustation d'huîtres : spéciales Gillardeau, Fine de Claire, Fine de Normandes.\nPlateaux de fruits de mer\nSaumon fumé maison\nSoupe de poissons maison à volonté !"
        ],
        "nl": [
          "Visboer, traiteur en oesterbar.\n7 dagen per week geopend\n\nViswinkel/cateraar: 9.00 tot 21.00 uur.\n\nOesterbar met 20 zitplaatsen, buiten het seizoen doorlopend geopend van 11.00 tot 21.00 uur en in de zomer tot 22.00 uur.\nOesterproeverij: speciale Gillardeau, Fine de Claire, Fine de Normandes.\nSchotels met zeevruchten\nHuisgerookte zalm\nHuisgemaakte vissoep voor iedereen!"
        ],
        "es": [
          "Pescadería, catering y bar de ostras.\nAbierto 7 días a la semana\n\nPescadería/catering: de 9 a 21 h.\n\nBar de ostras con capacidad para 20 personas, abierto de 11.00 a 21.00 h ininterrumpidamente fuera de temporada y hasta las 22.00 h en verano.\nDegustación de ostras: especial Gillardeau, Fine de Claire, Fine de Normandes.\nPlatos de marisco\nSalmón ahumado en casa\nSopa de pescado casera ¡todo lo que pueda comer!"
        ]
      },
