  "rdfs:comment": {
    "de": [
      "BIO-Erzeuger und -Destillateur von Duftpflanzen und Blumen.\r\nBIO-Baumzüchter und -Ölbauer. Besuch rund um Pflanzen und Blumen (Les Pilles) ~ 1,5 Stunden. Besuch rund um eine Destillation (Nyons) ~ 2 Std.\r\nDemo Destillation, Pflanzen probieren, berühren, riechen"
    ],
    "en": [
      "Organic distiller and producer of fragrant plants and flowers.\r\nArborist and organic olive grower\r\nValeur Parc (PNR-BP) brand"
    ],
    "it": [
      "Produttore e distillatore biologico di piante e fiori da profumo.\r\nColtivatore di alberi, olivicoltore biologico. Visita di piante e fiori (Les Pilles) ~ 1h30. Visita di una distilleria (Nyons) ~ 2h\r\nDimostrazione di distillazione, assaggiare, toccare e annusare le piante"
    ],
    "fr": [
      "Producteur distillateur BIO de plantes à parfum et de fleurs.\r\nArboriculteur, Oleïculteur BIO. Visite autour des plantes et fleurs (Les Pilles) ~ 1h30. Visite autour d'une distillation (Nyons) ~ 2h\r\nDémo distillation, goûter, toucher sentir les plantes"
    ],
    "nl": [
      "Produkteur distillateur BIO parfum planten en bloemen. Kweker. Olijfolieteler BIO."
    ],
    "es": [
      "Productor y destilador ecológico de plantas y flores para perfumería.\r\nCultivador de árboles, olivicultor ecológico. Visita en torno a las plantas y las flores (Les Pilles) ~ 1h30. Visita a una destilación (Nyons) ~ 2h\r\nDemostración de destilación, probar, tocar y oler las plantas"
    ]
  },
  "rdfs:label": {
    "en": [
      "5 PM - MARGIELA Rémy"
    ],
