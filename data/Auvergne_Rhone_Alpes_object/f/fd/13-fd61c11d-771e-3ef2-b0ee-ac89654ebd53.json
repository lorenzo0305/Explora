  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Feinschmeckerwelt der Brasserie Benjamin, wo der Reichtum an lokalen Produkten in raffinierten Gerichten zum Ausdruck kommt. Jeder Teller zelebriert die Schätze der Region und bietet ein authentisches und großzügiges kulinarisches Erlebnis."
    ],
    "en": [
      "Dive into the culinary delights of Brasserie Benjamin, where local ingredients take center stage in beautifully crafted dishes. Each plate celebrates regional flavors, offering an authentic and generously satisfying dining experience."
    ],
    "it": [
      "Immergetevi nel mondo gastronomico della Brasserie Benjamin, dove la ricchezza dei prodotti locali si esprime in piatti raffinati. Ogni piatto celebra i tesori della regione, offrendo un'esperienza culinaria autentica e generosa."
    ],
    "fr": [
      "Plongez dans l'univers gourmand de la Brasserie Benjamin, où la richesse des produits locaux s'exprime à travers des plats raffinés. Chaque assiette célèbre les trésors du terroir, offrant une expérience culinaire authentique et généreuse."
    ],
    "es": [
      "Sumérjase en el mundo gourmet de la Brasserie Benjamin, donde la riqueza de los productos locales se expresa en platos refinados. Cada plato celebra los tesoros de la región, ofreciendo una experiencia culinaria auténtica y generosa."
    ],
    "nl": [
      "Dompel jezelf onder in de gastronomische wereld van Brasserie Benjamin, waar de rijkdom van lokale producten tot uiting komt in verfijnde gerechten. Elk gerecht viert de schatten van de regio en biedt een authentieke en genereuze culinaire ervaring."
    ]
  },
