  "rdfs:comment": {
    "de": [
      "Das Informationsbüro am Lac de Paladru in der Nähe des Strands von Charavines steht Ihnen gerne für alle Auskünfte zur Verfügung: Terminkalender, Sehenswertes, Unterkünfte, Sportaktivitäten, Bootfahren und Angeln ..."
    ],
    "en": [
      "Lake Paladru Information Office is located near to Charavines Beach and is at your disposal for all information: events, sites to visit, accommodation, sports activities, sailing and fishing..."
    ],
    "it": [
      "L'ufficio di accoglienza del Lago Paladru, situato vicino alla spiaggia di Charavines, è a vostra disposizione per qualsiasi informazione: agenda, siti da visitare, alloggi, attività sportive, vela, pesca, ecc."
    ],
    "fr": [
      "Le bureau d'accueil du lac de Paladru situé à proximité de la plage de Charavines est à votre disposition pour tout renseignement : agenda, sites à visiter, hébergements, activités sportives, navigation,  pêche..vous y trouverez aussi un espace boutique."
    ],
    "es": [
      "La oficina de recepción del lago Paladru, situada cerca de la playa de Charavines, está a su disposición para cualquier información que necesite: agenda, sitios que visitar, alojamiento, actividades deportivas, vela, pesca, etc. También encontrará allí una tienda."
    ],
    "nl": [
      "De receptie van Lake Paladru, gelegen bij het Charavines strand, staat tot uw beschikking voor alle informatie die u nodig heeft: agenda, bezienswaardigheden, accommodatie, sportactiviteiten, zeilen, vissen, etc. U vindt er ook een winkel."
    ]
  },
  "rdfs:label": {
    "de": [
