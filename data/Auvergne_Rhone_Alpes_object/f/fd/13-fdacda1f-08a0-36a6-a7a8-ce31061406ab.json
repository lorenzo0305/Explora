  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Dauerausstellung und nutzen Sie die Familienanimationen mit einem Animateur. Hunde sind im Maison de la réserve verboten; um den See herum an der Leine erlaubt."
    ],
    "en": [
      "Discover the permanent exhibition and enjoy family activities with a guide. Dogs not allowed in the Maison de la Réserve; leashed dogs allowed around the lake."
    ],
    "it": [
      "Scoprite la mostra permanente e godetevi le attività per famiglie con una guida. I cani non sono ammessi nella Maison de la Réserve; sono ammessi al guinzaglio intorno al lago."
    ],
    "fr": [
      "Découvrez l'exposition permanente et profitez des animations famille avec un animateur. Chiens interdits dans la Maison de la réserve ; admis en laisse autour du lac."
    ],
    "nl": [
      "Ontdek de permanente tentoonstelling en geniet van gezinsactiviteiten met een gids. Honden zijn niet toegestaan in het Maison de la Réserve; wel aangelijnd rond het meer."
    ],
    "es": [
      "Descubra la exposición permanente y disfrute de actividades familiares con un guía. No se admiten perros en la Maison de la Réserve; se admiten con correa alrededor del lago."
    ]
  },
  "rdfs:label": {
