  "rdfs:comment": {
    "de": [
      "Dies ist die versteckte, vor Blicken geschützte Adresse, um den Blick über die Dächer von Val d'Isère zu genießen.\r\nEntdecken Sie die Gourmetkarte und die hausgemachten Gerichte, die Ihren Gaumen verwöhnen werden!"
    ],
    "en": [
      "Welcome on the top floor of the Victoria Lodge hotel, your friendly address in Val d'Isère!\r\nDiscover a tasty menu with homemade dishes in a cosy atmosphere."
    ],
    "it": [
      "Questo è l'indirizzo nascosto, fuori dalla vista, per godere al meglio della vista sui tetti della Val d'Isère. \r\nScoprite un menu gourmet e piatti fatti in casa che delizieranno le vostre papille gustative!"
    ],
    "fr": [
      "C’est l’adresse cachée, à l’abri des regards, pour profiter au mieux de la vue sur les toits de Val d’Isère. \r\nDécouvrez une carte gourmande et des plats faits maison qui raviront vos papilles !"
    ],
    "es": [
      "Es la dirección escondida, fuera de la vista, para disfrutar al máximo de las vistas sobre los tejados de Val d'Isère.\r\nDescubra una carta gastronómica y platos caseros que harán las delicias de su paladar"
    ],
    "nl": [
      "Dit is het verborgen adresje, uit het zicht, om optimaal te genieten van het uitzicht over de daken van Val d'Isère.\r\nOntdek een gastronomisch menu en huisgemaakte gerechten die uw smaakpapillen zullen verrukken!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Toits de Val d'Isère"
    ],
    "it": [
      "Les Toits de Val d'Isère"
    ],
    "fr": [
      "Les Toits de Val d'Isère"
    ]
  },
