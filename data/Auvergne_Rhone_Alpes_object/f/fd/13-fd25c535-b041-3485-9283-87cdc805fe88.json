  "rdfs:comment": {
    "de": [
      "Die JAV-Clubs sind Abende \"offener Bühnen\", die den professionellen und Amateur-Musikschülern der Jazz Action Valence und des Konservatoriums gewidmet sind, die sich zusammenfinden, um ein oder mehrere Stücke als Solo, Duo oder Gruppe zu präsentieren."
    ],
    "en": [
      "The JAV club is an \"open stage\" evening dedicated to professional and amateur student musicians from Jazz Action Valence and the Conservatoire, who come together to perform one or more pieces, in solo, duo or group."
    ],
    "it": [
      "Il JAV club è una serata \"open stage\" dedicata a studenti musicisti professionisti e amatoriali di Jazz Action Valence e del Conservatorio, che si riuniscono per eseguire uno o più brani, in solo, in duo o in gruppo."
    ],
    "fr": [
      "Les JAV club sont des soirées \"scènes ouvertes\" dédiées aux élèves musiciens, professionnels et amateurs, de Jazz Action Valence et du Conservatoire, qui se retrouvent pour présenter un ou plusieurs morceaux, en solo, duo ou groupe."
    ],
    "es": [
      "El club JAV es una velada \"escenario abierto\" dedicada a los estudiantes músicos profesionales y aficionados de Jazz Action Valence y del Conservatorio, que se reúnen para interpretar una o varias piezas, en solo, dúo o grupo."
    ],
    "nl": [
      "De JAV club is een \"open podium\" avond gewijd aan professionele en amateur studenten muzikanten van Jazz Action Valence en het Conservatorium, die samenkomen om een of meer stukken uit te voeren, in solo, duo of groep."
    ]
  },
  "rdfs:label": {
    "fr": [
      "JAV club : scène ouverte"
    ]
  },
