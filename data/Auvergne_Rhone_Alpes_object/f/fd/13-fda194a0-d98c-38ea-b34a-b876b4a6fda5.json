  "rdfs:comment": {
    "de": [
      "Nur 10 Minuten zu Fuß vom historischen Zentrum entfernt, empfängt Sie unser Saisonbüro in Pont-du-Château vom 3. Juli bis zum 31. August, um Sie auf Ihren sommerlichen Entdeckungsreisen zu begleiten."
    ],
    "en": [
      "Just a 10-minute walk from the historic center, our Pont-du-Château seasonal office welcomes you from July 3 to August 31 to accompany you on your summer discoveries."
    ],
    "it": [
      "A soli 10 minuti a piedi dal centro storico, il nostro ufficio stagionale di Pont-du-Château è aperto dal 3 luglio al 31 agosto per aiutarvi a sfruttare al meglio l'estate."
    ],
    "fr": [
      "À seulement 10 minutes à pied du centre historique, notre bureau saisonnier de Pont-du-Château vous accueille du 3 juillet au 31 août pour vous accompagner dans vos découvertes estivales."
    ],
    "nl": [
      "Op slechts 10 minuten lopen van het historische centrum is ons seizoenskantoor in Pont-du-Château geopend van 3 juli tot 31 augustus om je te helpen optimaal van je zomer te genieten."
    ],
    "es": [
      "A sólo 10 minutos a pie del centro histórico, nuestra oficina de temporada de Pont-du-Château está abierta del 3 de julio al 31 de agosto para ayudarle a aprovechar al máximo el verano."
    ]
  },
  "rdfs:label": {
