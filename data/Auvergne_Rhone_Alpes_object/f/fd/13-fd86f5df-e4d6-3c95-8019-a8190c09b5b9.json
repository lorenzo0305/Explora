  "rdfs:comment": {
    "de": [
      "Bénabar enthüllt uns exklusiv einen Teil seiner neuen, noch im Entstehen begriffenen Tournee. Er wird bei diesem außergewöhnlichen Konzert in Val Cenis von fünf Musikern begleitet."
    ],
    "en": [
      "Bénabar gives us an exclusive preview of his new tour. He will be accompanied by 5 musicians for this exceptional concert in Val Cenis."
    ],
    "it": [
      "Bénabar ci offre un'anteprima esclusiva del suo nuovo tour. Sarà accompagnato da 5 musicisti per questo eccezionale concerto in Val Cenis."
    ],
    "fr": [
      "Bénabar nous dévoile en exclusivité une partie de sa nouvelle tournée en création. Il sera accompagné de 5 musiciens pour ce concert exceptionnel à Val Cenis."
    ],
    "es": [
      "Bénabar nos adelanta en exclusiva su nueva gira. Le acompañarán 5 músicos para este concierto excepcional en Val Cenis."
    ],
    "nl": [
      "Bénabar geeft ons een exclusief voorproefje van zijn nieuwe tournee. Hij zal worden begeleid door 5 muzikanten voor dit uitzonderlijke concert in Val Cenis."
    ]
  },
