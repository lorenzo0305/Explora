  "rdfs:comment": {
    "de": [
      "Destillationsworkshops auf dem Bauernhof oder anderswo für die Öffentlichkeit zugänglich! Der Wunsch, traditionelles Wissen über Pflanzen und ihre Verwendung weiterzugeben und zu teilen. Destillation von Pflanzen und Herstellung von Bio-Hydrolaten. Besichtigungen auf Anfrage."
    ],
    "en": [
      "Distillation workshops open to the public on the farm or elsewhere! A desire to pass on and share traditional knowledge about plants and their uses. Distillation of plants and creation of organic hydrosols. Visits on request."
    ],
    "it": [
      "Laboratori di distillazione aperti al pubblico in fattoria o altrove! Il desiderio di trasmettere e scambiare le conoscenze popolari sulle piante e i loro usi. Distillazione di piante e creazione di idrolati biologici. Visite su richiesta."
    ],
    "fr": [
      "Ateliers de distillation ouverts au public à la ferme ou ailleurs ! Une volonté de transmission et d'échange de savoirs populaires autour des plantes et de leurs utilisations. Distillation de plantes et création d'hydrolats bio. Visites sur demande."
    ],
    "es": [
      "Talleres de destilación abiertos al público en la granja o en cualquier otro lugar Deseo de transmitir e intercambiar conocimientos populares sobre las plantas y sus usos. Destilación de plantas y creación de hidrolatos ecológicos. Visitas previa petición."
    ],
    "nl": [
      "Publiek toegankelijke destillatieworkshops op de boerderij of elders! De wens om populaire kennis over planten en hun toepassingen door te geven en uit te wisselen. Distillatie van planten en creatie van biologische hydrolaat. Bezoeken op aanvraag."
    ]
  },
