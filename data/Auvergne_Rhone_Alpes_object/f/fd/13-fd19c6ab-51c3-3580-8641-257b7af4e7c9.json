  "rdfs:comment": {
    "de": [
      "Entdecken Sie den alten Charme dieses Städtchens. Häuser aus Lehm und Rollkiesel, die Kirche, das sogenannte Ludwig XI.-Schloss, die mittelalterlichen Markthallen..."
    ],
    "en": [
      "Discover the ancient charm of this small town, with its cob and round stone houses, its church, the Louis 11th castle and the medieval covered market."
    ],
    "it": [
      "Scoprite il fascino antico di questo villaggio. Le case in coccio e ciottoli arrotolati, la chiesa, il cosiddetto castello Luigi XI, il mercato coperto medievale..."
    ],
    "fr": [
      "Découvrez le charme ancien de cette bourgade. Maisons en torchis et galets roulés, l'église, le château dit Louis XI, les halles médiévales..."
    ],
    "nl": [
      "Ontdek de oude charme van dit dorp. Huizen van kinderkopjes en gerolde kiezels, de kerk, het zogenaamde Louis XI kasteel, de middeleeuwse overdekte markt..."
    ],
    "es": [
      "Descubra el antiguo encanto de este pueblo. Casas de mazorca y guijarros rodados, la iglesia, el llamado castillo Luis XI, el mercado cubierto medieval..."
    ]
  },
