  "rdfs:comment": {
    "de": [
      "Am Eingang des Dorfes Les Coches können Sie sich im White Lines - Pub Lounge entspannen. Hier können Sie die Themenabende und Live-Konzerte genießen, die den ganzen Winter über angeboten werden."
    ],
    "en": [
      "At the entrance to the village of Les Coches, come and relax in the White Lines - Pub Lounge. Enjoy themed evenings and live concerts throughout the winter."
    ],
    "it": [
      "All'ingresso del villaggio di Les Coches, venite a rilassarvi al White Lines - Pub Lounge. Potrete assistere a serate a tema e concerti dal vivo durante tutto l'inverno."
    ],
    "fr": [
      "A l'entrée du village des Coches, venez vous détendre au White Lines - Pub Lounge. Vous pourrez profiter des soirées à thèmes et des concerts en Live proposés tout au long de l'hiver."
    ],
    "nl": [
      "Kom bij de ingang van het dorp Les Coches ontspannen in de White Lines - Pub Lounge. Geniet de hele winter van thema-avonden en liveconcerten."
    ],
    "es": [
      "A la entrada del pueblo de Les Coches, venga a relajarse en el White Lines - Pub Lounge. Podrá disfrutar de noches temáticas y conciertos en directo durante todo el invierno."
    ]
  },
