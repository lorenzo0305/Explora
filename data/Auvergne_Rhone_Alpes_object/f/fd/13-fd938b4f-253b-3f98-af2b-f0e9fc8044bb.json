  "rdfs:comment": {
    "de": [
      "Ein seltener und bezaubernder Ort, der voller Geschichten steckt... Wo es sich gut leben lässt!\r\nEine sehr bewegliche Speisekarte und eine echte Vorliebe für Neues."
    ],
    "en": [
      "A rare and enchanting place, steeped in history... Where life is good!\r\nA highly mobile menu and a real taste for novelties."
    ],
    "it": [
      "Un luogo raro e incantevole, ricco di storia... Un luogo ideale per vivere!\r\nUn menu molto flessibile e un vero gusto per le novità."
    ],
    "fr": [
      "Un lieu rare et envoûtant, chargé d'histoires... Où il fait bon vivre !\r\nUne carte très mobile et un vrai goût pour les nouveautés."
    ],
    "es": [
      "Un lugar raro y encantador, cargado de historia... ¡Un lugar ideal para vivir!\r\nUn menú muy flexible y un verdadero gusto por las novedades."
    ],
    "nl": [
      "Een zeldzame en betoverende plek, boordevol geschiedenis... Een geweldige plek om te wonen!\r\nEen zeer flexibele menukaart en een echte voorliefde voor nieuwigheden."
    ]
  },
  "rdfs:label": {
