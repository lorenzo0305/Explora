  "rdfs:comment": {
    "de": [
      "Die Kirche/Priorat im Stil der provenzalischen Romanik soll die älteste im Departement Drôme sein (zusammen mit der Kirche in Crupies)."
    ],
    "en": [
      "The Provençal Romanesque church/priory is said to be the oldest in the Drôme department (along with that of Crupies)."
    ],
    "it": [
      "La chiesa/prigione romanica provenzale è considerata la più antica del dipartimento della Drôme (insieme a quella di Crupies)."
    ],
    "fr": [
      "L'église/ prieuré de style art roman provençal serait la plus ancienne du département de la Drôme (avec celle de Crupies)."
    ],
    "es": [
      "Se dice que la iglesia/prioral románica provenzal es la más antigua del departamento de la Drôme (junto con la de Crupies)."
    ],
    "nl": [
      "Deze Provençaalse Romaanse kerk en priorij wordt beschouwd als de oudste van het departement Drôme (samen met Crupies)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le prieuré Saint-Jean Baptiste"
    ]
  },
