  "rdfs:comment": {
    "de": [
      "Coco und Ricou begrüßen Sie in ihrem Gasthof, der über eine Bar/Restaurant (traditionelle Küche) mit Sommerterrasse und drei Gästezimmer verfügt, in idealer Lage entlang der Weinstraße im Herzen des typischen Dorfes Valvignères."
    ],
    "en": [
      "Ideally set along the Wine Route in the heart of Valvignères village, Coco and Ricou welcome you to their inn where you’ll find a bar and restaurant serving traditional food, outside terrace for the summer and 3 guest rooms."
    ],
    "it": [
      "In posizione ideale lungo la strada del vino, nel cuore del tipico villaggio di Valvignères, Coco e Ricou vi accolgono nella loro locanda che dispone di un bar/ristorante (cucina tradizionale) con terrazza all'aperto in estate e tre camere per gli ospiti."
    ],
    "fr": [
      "Idéalement situé le long de la route des vins, au cœur du typique village de Valvignères, Coco et Ricou vous accueillent dans leur auberge qui dispose d'un Bar/Restaurant (cuisine traditionnelle) avec terrasse extérieur l'été et de trois chambres d'hôtes."
    ],
    "nl": [
      "Ideaal gelegen langs de wijnroute, in het hart van het typische dorp Valvignères, heten Coco en Ricou u welkom in hun herberg met een bar/restaurant (traditionele keuken) met buitenterras in de zomer en drie gastenkamers."
    ],
    "es": [
      "Con una ubicación ideal en la ruta del vino, en el corazón del típico pueblo de Valvignères, Coco y Ricou le dan la bienvenida a su posada que cuenta con un Bar/Restaurante (cocina tradicional) con una terraza exterior en verano y tres habitaciones para huéspedes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge de l'Helvie chez Coco et Ricou"
    ],
    "fr": [
      "Auberge de l'Helvie chez Coco et Ricou"
    ]
  },
