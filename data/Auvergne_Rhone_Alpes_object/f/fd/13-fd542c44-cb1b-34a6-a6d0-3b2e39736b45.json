  "rdfs:comment": {
    "de": [
      "Die Jahre vergehen, die schönen Häuser bleiben, wie das Grand Hôtel des Bains. Seine Küche folgt dem Lauf der Jahreszeiten und begleitet mit ihren leichten Düften lange Abendessen unter dem Sternenhimmel. Regionales oder gastronomisches Menü."
    ],
    "en": [
      "The years go by, but fine homes like the Grand Hôtel des Bains remain. His cuisine follows the seasons and adds a light touch to long dinners under the stars. Local or gastronomic menus."
    ],
    "it": [
      "Gli anni passano, ma le belle case come il Grand Hôtel des Bains restano. La sua cucina segue le stagioni e aggiunge un tocco di leggerezza alle lunghe cene sotto le stelle. Menù locali e gourmet. Brunch ogni domenica."
    ],
    "fr": [
      "Les années s'en vont, les belles maisons demeurent tel le Grand Hôtel des Bains. Sa cuisine suit le mouvement des saisons et accompagne de ses parfums légers de longs dîners sous les étoiles. Menu du terroir ou gastronomique. Brunch tous les dimanches."
    ],
    "es": [
      "Pasan los años, pero las casas nobles como el Grand Hôtel des Bains permanecen. Su cocina sigue las estaciones y aporta un toque ligero a las largas cenas bajo las estrellas. Menús locales y gastronómicos. Brunch todos los domingos."
    ],
    "nl": [
      "De jaren gaan voorbij, maar mooie huizen zoals het Grand Hôtel des Bains blijven. Zijn keuken volgt de seizoenen en voegt een lichte toets toe aan lange diners onder de sterren. Lokale of gastronomische men"
    ]
  },
