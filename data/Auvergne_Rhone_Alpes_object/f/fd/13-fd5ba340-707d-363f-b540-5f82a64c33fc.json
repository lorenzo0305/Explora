  "rdfs:comment": {
    "de": [
      "Die Schluchten des Allier werden immer enger und die Fahrradroute Via Allier führt aus ihnen heraus, indem sie an Höhe gewinnt."
    ],
    "en": [
      "The Allier Gorge narrows and the Via Allier cycle route climbs out of it."
    ],
    "it": [
      "Le gole dell'Allier si restringono e la pista ciclabile Via Allier si arrampica fuori da esse."
    ],
    "fr": [
      "Les gorges de l'Allier se resserrent et la véloroute de la Via Allier s'en extirpe en prenant de la hauteur."
    ],
    "es": [
      "Las gargantas del Allier se estrechan y la ruta ciclista Via Allier asciende por ellas."
    ],
    "nl": [
      "De kloven van de Allier worden smaller en de fietsroute Via Allier klimt eruit."
    ]
