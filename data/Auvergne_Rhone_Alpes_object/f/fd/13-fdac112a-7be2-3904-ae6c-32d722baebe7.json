  "rdfs:comment": {
    "de": [
      "Mountainbike-Route von Le Bettex aus, mit einem allmählichen Anstieg bis zum Mont Joux über das Plateau de la Croix. Rückfahrt über den Mont d'Arbois vor einer spielerischen Abfahrt auf dem Wizz Trail. Eine komplette Strecke zwischen Alpenpanorama und spielerischen Singletrails!"
    ],
    "en": [
      "VTTAE itinerary starting from Le Bettex, with a gradual climb to Mont Joux via the Plateau de la Croix. Return via Mont d?Arbois before a playful descent on the Wizz trail. A complete tour with alpine panoramas and playful singletracks!"
    ],
    "it": [
      "Percorso MTB con partenza da Le Bettex, con salita graduale al Mont Joux attraverso il Plateau de la Croix. Ritorno via Mont d'Arbois prima di una divertente discesa sul sentiero Wizz. Un percorso completo che unisce panorami alpini e singletrack divertenti!"
    ],
    "fr": [
      "Itinéraire VTTAE au départ du Bettex, avec une montée progressive jusqu’au Mont Joux via le Plateau de la Croix. Retour par le Mont d’Arbois avant une descente ludique sur la piste Wizz. Un parcours complet entre panoramas alpins et singletracks joueurs !"
    ],
    "es": [
      "Ruta en BTT que parte de Le Bettex, con una subida gradual al Mont Joux por el Plateau de la Croix. Regreso por el Mont d'Arbois antes de un divertido descenso por el sendero Wizz. ¡Un recorrido completo que combina panoramas alpinos y singletrack lúdico!"
    ],
    "nl": [
      "MTB-route die begint in Le Bettex, met een geleidelijke klim naar de Mont Joux via het Plateau de la Croix. Keer terug via de Mont d'Arbois voor een leuke afdaling over de Wizz trail. Een complete route die alpenpanorama's en speelse singletracks combineert!"
    ]
  },
  "rdfs:label": {
