  "rdfs:comment": {
    "de": [
      "Idée'O Traiteur, Ihr Partner für Feinschmecker im Skigebiet! Liefern Sie Halbpension direkt in Ihre Unterkunft oder Gerichte à la carte für punktuelle Gelüste. Entdecken Sie eine 100 % hausgemachte Küche, die savoyische Tradition und raffinierte Kreationen verbindet."
    ],
    "en": [
      "Idée’O Traiteur delivers half-board formulas to your accommodation in resort, as well as homemade dishes inspired by local flavours."
    ],
    "it": [
      "Idée?O Traiteur offre formule di mezza pensione e piatti 100% casalinghi ispirati ai sapori locali direttamente nel vostro alloggio nelle località alpine."
    ],
    "fr": [
      "Idée’O Traiteur vous livre en station alpine des formules demi-pension et des plats aux recettes 100% maison inspirées de saveurs locales, directement dans votre logement."
    ],
    "es": [
      "Idée?O Traiteur le ofrece fórmulas de media pensión y platos 100% caseros inspirados en los sabores locales directamente en su alojamiento en las estaciones alpinas."
    ],
    "nl": [
      "Idée'O Traiteur levert halfpensionformules en 100% huisgemaakte gerechten geïnspireerd door lokale smaken rechtstreeks aan je accommodatie in de Alpenresorts."
    ]
  },
  "rdfs:label": {
