  "rdfs:comment": {
    "de": [
      "Bei Casita werden Sie wie zu Hause empfangen! Ein überschaubares Hotel-Restaurant, in dem man gut isst, gut schläft und vor allem mit einem Lächeln zurückkehrt. Kommen Sie und probieren Sie unsere mit Liebe zubereitete Küche."
    ],
    "en": [
      "At Casita, we welcome you as if you were at home! A small hotel-restaurant where you can eat well, sleep well, and above all... leave with a smile on your face. Come and taste our lovingly prepared cuisine."
    ],
    "it": [
      "Alla Casita vi sentirete come a casa vostra! Un hotel-ristorante a misura d'uomo, dove mangiare bene, dormire bene e, soprattutto, tornare con il sorriso. Venite a gustare la nostra cucina preparata con amore."
    ],
    "fr": [
      "Chez Casita, on vous accueille comme à la maison ! Hôtel-restaurant à taille humaine, où l’on mange bien, on dort bien, et surtout… on revient avec le sourire. Venez goûter notre cuisine faite avec amour."
    ],
    "es": [
      "En la Casita, se sentirá como en casa Un hotel-restaurante a escala humana, donde comer bien, dormir bien y, sobre todo, volver con una sonrisa. Venga a degustar nuestra cocina preparada con cariño."
    ],
    "nl": [
      "Bij Casita bent u van harte welkom, alsof u thuis bent! Een hotel-restaurant op menselijke schaal, waar u lekker eet, goed slaapt en vooral... met een glimlach terugkomt. Kom proeven van onze met liefde bereide gerechten."
    ]
  },
