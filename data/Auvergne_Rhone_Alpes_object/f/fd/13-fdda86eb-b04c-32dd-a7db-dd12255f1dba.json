  "rdfs:comment": {
    "de": [
      "Charakteristisch für die Architektur der 1930er Jahre, bekräftigt dieses monumentale Schul-Rathaus die Schaffung des neuen städtischen Zentrums von Echirolles; es beherbergt heute das Centre du Graphisme, dessen Aufgabe es ist, die grafische Kultur im Alltag zu verbreiten."
    ],
    "en": [
      "Characteristic of the architecture of the 1930s, this monumental town hall-school marks the creation of the new urban center of Echirolles. Today, it houses the Centre du Graphisme, whose vocation is to disseminate graphic culture on a daily basis."
    ],
    "it": [
      "Caratteristico dell'architettura degli anni Trenta, questo monumentale municipio-scuola afferma la creazione del nuovo centro urbano di Echirolles; oggi ospita il Centre du Graphisme, la cui vocazione è quella di diffondere quotidianamente la cultura grafica."
    ],
    "fr": [
      "Caractéristique de l'architecture des années 30, cette monumentale mairie-école affirme la création du nouveau centre urbain d'Echirolles ; il abrite aujourd'hui le Centre du Graphisme, dont la vocation est de diffuser la culture graphique au quotidien."
    ],
    "nl": [
      "Kenmerkend voor de architectuur van de jaren 1930, bevestigt deze monumentale stadhuis-school de oprichting van het nieuwe stadscentrum van Echirolles; het herbergt nu het Centre du Graphisme, dat dagelijks grafische cultuur wil verspreiden."
    ],
    "es": [
      "Característico de la arquitectura de los años 30, este ayuntamiento-escuela monumental marca la creación del nuevo centro urbano de Echirolles. Hoy alberga el Centre du Graphisme, cuya vocación es difundir diariamente la cultura gráfica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ancienne mairie-école, Centre du Graphisme"
    ]
  },
