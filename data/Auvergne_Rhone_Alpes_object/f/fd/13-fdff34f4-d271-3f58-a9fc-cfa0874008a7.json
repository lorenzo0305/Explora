  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné de Tramolé. Wir können Sie für die Dauer eines Picknicks empfangen.\r\nEin Picknicktisch, eine Anbindestange für Pferde und ein Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Tramolé. We can accommodate you for a picnic.\r\nPicnic table, horse tie-up bar and parking lot are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné de Tramolé. Possiamo ospitarvi per un picnic.\r\nTavoli da picnic, stalli per cavalli e un parcheggio sono a vostra disposizione."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Tramolé. Nous pouvons vous accueillir le temps d'un pique nique.\r\nTable de pique-nique, barre d'attache pour chevaux et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné de Tramolé. U kunt bij ons terecht voor een picknick.\r\nPicknicktafels, paardenboxen en parkeergelegenheid zijn beschikbaar."
    ],
    "es": [
      "Bienvenido al Relais Cyné de Tramolé. Podemos acogerle para un picnic.\r\nMesas de picnic, establos para caballos y aparcamiento a su disposición."
    ]
  },
  "rdfs:label": {
