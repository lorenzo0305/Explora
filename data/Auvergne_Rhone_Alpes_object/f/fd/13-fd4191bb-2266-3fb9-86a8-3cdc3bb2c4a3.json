  "rdfs:comment": {
    "de": [
      "Singen und tanzen Sie beim Thé Dansant, der von der Vereinigung Nos Combats Nos Héros organisiert wird! Festliche Atmosphäre, mitreißende Musik und eine für alle offene Tanzfläche sorgen für einen geselligen und solidarischen Nachmittag zugunsten kranker und behinderter Kinder."
    ],
    "en": [
      "Come and sing and dance at the Thé Dansant organized by the Nos Combats Nos Héros association! A festive atmosphere, lively music and a dance floor open to all for a friendly afternoon of solidarity in aid of sick and disabled children."
    ],
    "it": [
      "Venite a cantare e a ballare al Thé Dansant organizzato dall'associazione Nos Combats Nos Héros! Atmosfera festosa, musica vivace e pista da ballo aperta a tutti per un pomeriggio di solidarietà a favore dei bambini malati e disabili."
    ],
    "fr": [
      "Venez chanter et danser lors du Thé Dansant organisé par l’association Nos Combats Nos Héros ! Ambiance festive, musiques entraînantes et piste ouverte à tous pour un après-midi convivial et solidaire au profit des enfants malades et handicapés."
    ],
    "es": [
      "¡Venga a cantar y bailar en el Thé Dansant organizado por la asociación Nos Combats Nos Héros! Ambiente festivo, música animada y pista de baile abierta a todos para una tarde amistosa y solidaria a favor de los niños enfermos y discapacitados."
    ],
    "nl": [
      "Kom zingen en dansen op de Thé Dansant georganiseerd door de vereniging Nos Combats Nos Héros! Een feestelijke sfeer, levendige muziek en een dansvloer die voor iedereen openstaat voor een gezellige middag vol solidariteit ten bate van zieke en gehandicapte kinderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Thé dansant"
    ]
  },
