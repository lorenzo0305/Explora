  "rdfs:comment": {
    "de": [
      "Der von der Kompanie Transe Express in Eurre im Departement Drôme initiierte Ort La Gare à Coulisses ist eine Basis für die Straßenkunst: ein Labor, in dem Formen erfunden, entwickelt und getestet werden, die es den Künstlern ermöglichen, die Stadt..."
    ],
    "en": [
      "La Gare à Coulisses is a street arts base set up by the Transe Express company in Eurre, in the Drôme region of France. It's a laboratory where artists invent, develop and test the forms that enable them to stage the city..."
    ],
    "it": [
      "La Gare à Coulisses è una base per le arti di strada avviata dalla compagnia Transe Express a Eurre, nella Drôme. È un laboratorio dove gli artisti inventano, sviluppano e testano le forme che permettono loro di mettere in scena la città..."
    ],
    "fr": [
      "Lieu initié par la compagnie Transe Express à Eurre, dans la Drôme, La Gare à Coulisses est une base des Arts de la Rue : un laboratoire où s'inventent, se développent et se testent les formes qui permettent aux artistes de mettre en scène la ville..."
    ],
    "nl": [
      "La Gare à Coulisses werd opgericht door de maatschappij Transe Express in Eurre, in de Drôme, als basis voor straatkunsten: een laboratorium waar kunstenaars de vormen bedenken, ontwikkelen en testen die ze gebruiken om de stad in scène te zetten..."
    ],
    "es": [
      "La Gare à Coulisses es una base artística de calle iniciada por la compañía Transe Express en Eurre, en la Drôme. Es un laboratorio donde los artistas inventan, desarrollan y prueban las formas que les permiten escenificar la ciudad..."
    ]
  },
