  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Thônes Coeur des Vallées empfängt Sie und stellt Ihnen Folgendes zur Verfügung: kostenloser Wi-Fi, Sessel, Konsultation von Dokumenten, großer Schaukasten mit allen Sehenswürdigkeiten der Region, Kinderbereich..."
    ],
    "en": [
      "The Thônes Coeur des Vallées Tourist Office welcomes you and offers you free wi-fi, armchairs, document consultation, a large display of all the sites in the region, a children's area..."
    ],
    "it": [
      "L'Ufficio del Turismo di Thônes Coeur des Vallées vi accoglie e vi mette a disposizione: wi-fi gratuito, poltrone, consultazione di documenti, una grande esposizione di tutti i siti della regione, uno spazio per i bambini..."
    ],
    "fr": [
      "L'Office de tourisme de Thônes Coeur des Vallées vous accueille et met à votre disposition : wi-fi gratuit, fauteuils, consultation de documents, grand présentoir sur tous les sites de la région, espace enfants..."
    ],
    "es": [
      "La Oficina de Turismo de Thônes Coeur des Vallées le da la bienvenida y pone a su disposición: wi-fi gratuito, sillones, consulta de documentos, una gran exposición de todos los sitios de la región, un espacio para niños..."
    ],
    "nl": [
      "Het VVV-kantoor van Thônes Coeur des Vallées heet u welkom en biedt u: gratis wi-fi, fauteuils, raadpleging van documenten, een groot scherm met alle bezienswaardigheden in de regio, een ruimte voor kinderen..."
    ]
  },
