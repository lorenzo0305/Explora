  "rdfs:comment": {
    "de": [
      "Das Maison du Patrimoine ist ein für alle kostenlos zugänglicher Ort, der dem Kulturerbe der Region Valence Romans Agglo gewidmet ist. Es ist ein Ort der Information, des Austauschs und der Bildung!"
    ],
    "en": [
      "The Heritage Center is a free space open to all, dedicated to the heritage of the Valence Romans Agglo area. It is a place for information, sharing, and education!"
    ],
    "it": [
      "La Maison du Patrimoine è uno spazio gratuito e aperto a tutti, dedicato al patrimonio della zona di Valence Romans Agglo. È un luogo di informazione, condivisione ed educazione!"
    ],
    "fr": [
      "La Maison du Patrimoine est un espace gratuit ouvert à tous dédié au patrimoine du territoire de Valence Romans Agglo. C’est un lieu d’information, de partage et de pédagogie !"
    ],
    "es": [
      "La Maison du Patrimoine es un espacio gratuito y abierto a todos, dedicado al patrimonio de la zona de Valence Romans Agglo. Es un lugar para informarse, compartir y formarse"
    ],
    "nl": [
      "Het Maison du Patrimoine is een gratis ruimte die voor iedereen toegankelijk is en gewijd is aan het erfgoed van het gebied Valence Romans Agglo. Het is een plek waar informatie wordt gedeeld en waar educatie centraal staat!"
    ]
  },
  "rdfs:label": {
