  "rdfs:comment": {
    "de": [
      "Von den aromatischen Gewürzen des Punjab bis zur pulsierenden Straßenküche Karachis erzählt jedes Gericht eine Geschichte von Erbe, Kultur und Leidenschaft!"
    ],
    "en": [
      "From the aromatic spices of Punjab to the vibrant street food of Karachi, each dish tells a story of heritage, culture and passion!"
    ],
    "it": [
      "Delbar, ristorante pakistano/indiano \"NoLo\", halal a Bourg-lès-Valence.\r\nDalle spezie aromatiche del Punjab al vivace street food di Karachi, ogni piatto racconta una storia di eredità, cultura e passione!"
    ],
    "fr": [
      "Delbar, restaurant pakistanais/indiens \"NoLo\", halal à Bourg-lès-Valence.\r\nDes épices aromatiques du Pendjab à la cuisine de rue vibrante de Karachi, chaque plat raconte une histoire d'héritage, de culture et de passion !"
    ],
    "nl": [
      "Van de aromatische kruiden van de Punjab tot het levendige straateten van Karachi, elk gerecht vertelt een verhaal van erfgoed, cultuur en passie!"
    ],
    "es": [
      "Delbar, restaurante pakistaní/indio \"NoLo\", halal en Bourg-lès-Valence.\r\nDesde las aromáticas especias del Punjab hasta la vibrante comida callejera de Karachi, ¡cada plato cuenta una historia de herencia, cultura y pasión!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Delbar - Restaurant franco-pakistanais"
    ]
  },
