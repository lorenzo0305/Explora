  "rdfs:comment": {
    "de": [
      "Seit 1998 begeistert AIR TARENTAISE mit Leidenschaft für das Gleitschirmfliegen! Schnupperflüge, Kunstflug, Pilotenausbildung: Ein Team aus erfahrenen Gleitschirmprofis für ein einzigartiges Erlebnis.\r\nNeu im Sommer 2025: Flug mit der King Live 3000, Start am Fuße des Bellecôte-Gletschers!"
    ],
    "en": [
      "Since 1998, AIR TARENTAISE has been passionately sharing the joys of paragliding! Introductory flights, aerobatics, pilot training: a team of free-flight professionals for a unique experience.\r\nNew for summer 2025: King Live 3000 flight, taking off at the foot of the Bellecôte glacier!"
    ],
    "it": [
      "Dal 1998, AIR TARENTAISE fa vivere il parapendio con passione! Primi voli, acrobazie, formazione dei piloti: un team di professionisti del parapendio per un'esperienza unica.\r\nNovità dell'estate 2025: un volo King Live 3000, con decollo ai piedi del ghiacciaio della Bellecôte!"
    ],
    "fr": [
      "Depuis 1998, AIR TARENTAISE fait vivre le parapente avec passion ! Baptêmes, voltige, formation de pilotes : une équipe de pros du vol libre pour une expérience unique. \r\nNouveauté été 2025 : vol King Live 3000, décollage au pied du glacier de Bellecôte !"
    ],
    "nl": [
      "Sinds 1998 brengt AIR TARENTAISE met passie paragliding tot leven! Eerste vluchten, aerobatics, pilotenopleidingen: een team van paraglidingprofs voor een unieke ervaring.\r\nNieuw in de zomer van 2025: een vlucht met de King Live 3000 aan de voet van de Bellecôte-gletsjer!"
    ],
    "es": [
      "Desde 1998, AIR TARENTAISE da vida al parapente con pasión Primeros vuelos, acrobacias aéreas, formación de pilotos: un equipo de profesionales del parapente para una experiencia única.\r\nNovedad para el verano de 2025: un vuelo King Live 3000, ¡despegando desde los pies del glaciar Bellecôte!"
    ]
  },
