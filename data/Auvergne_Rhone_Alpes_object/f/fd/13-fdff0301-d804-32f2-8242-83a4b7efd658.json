  "rdfs:comment": {
    "de": [
      "Farbenfrohe, würzige und von zahlreichen Ursprüngen inspirierte Küche für Gruppen von mindestens 8 Personen, während eines Aufenthalts in einer Unterkunft, einer Ausbildung oder eines Praktikums in Gaststätten mit einer Küche oder direkt bei Ihnen zu Hause im Diois oder Crestois."
    ],
    "en": [
      "Colorful, spicy cuisine inspired by multiple origins for groups of at least 8 people, staying in a gîte, on a course or training course in a venue with its own kitchen, or directly at your home in the Diois or Crestois regions."
    ],
    "it": [
      "Una cucina colorata e deliziosamente piccante, ispirata a molte origini diverse.\r\nRealizzata con prodotti biologici, freschi, di stagione e preferibilmente locali.\r\nMinimo 8 persone. Sono felice di soddisfare tutte le esigenze dietetiche e di lavorare con voi per creare il vostro menu."
    ],
    "fr": [
      "Cuisine colorée, savoureusement épicée et inspirée de multiples origines.\r\nComposée d’aliments biologiques, frais, de saison et de préférence locale. \r\nMin 8 pers. Je m’adapte volontiers à tous les régimes alimentaires et élabore les menu avec vous."
    ],
    "nl": [
      "Kleurrijke, kruidige gerechten geïnspireerd door een brede waaier aan origines voor groepen van minstens 8 personen, die verblijven in een gîte, op cursus of stage in een locatie met een keuken, of rechtstreeks bij u thuis in de Diois of Crestois."
    ],
    "es": [
      "Cocina colorista y deliciosamente picante inspirada en orígenes muy diversos.\r\nElaborada con productos ecológicos, frescos, de temporada y preferentemente locales.\r\nMínimo 8 personas. Estaré encantada de satisfacer todas las necesidades dietéticas y trabajar con usted para crear su menú."
    ]
  },
  "rdfs:label": {
    "de": [
      "Essen auf Rädern - Ça vous goûte"
    ],
    "en": [
      "Home catering - Ça vous goûte"
    ],
    "fr": [
      "Restauration à domicile - Ça vous goûte"
    ],
    "nl": [
      "Thuis catering - Ça vous goûte"
    ]
  },
