  "rdfs:comment": {
    "de": [
      "Von der Gîte des flocons verts aus führt die Route in Richtung Puy de Bâne. Die Route verläuft eine Zeit lang auf dem Bergpfad. Danach kippt die Route in das Tal von Brezons und steigt dann auf dem gegenüberliegenden Plateau nach Pierrefort auf."
    ],
    "en": [
      "From the gîte des flocons verts, the route heads towards Puy de Bâne. For a while, the route follows the mountain trail. The route then drops down into the Brezons valley and climbs up to Pierrefort on the opposite plateau."
    ],
    "it": [
      "Dal gîte Flocons verts, l'itinerario si dirige verso il Puy de Bâne. Il percorso segue per un po' il sentiero di montagna. Poi si scende nella valle di Brezons e si risale sull'altopiano opposto per raggiungere Pierrefort."
    ],
    "fr": [
      "Depuis le gîte des flocons verts, l'itinéraire part en direction du Puy de Bâne. Le tracé emprunte un temps la piste des montagnes. Après quoi l'itinéraire bascule dans la vallée de Brezons puis remonte sur le plateau opposé pour rejoindre Pierrefort."
    ],
    "nl": [
      "Vanaf de gîte Flocons verts gaat de route in de richting van Puy de Bâne. De route volgt een tijdje het bergpad. Daarna daalt de route af in de vallei van Brezons en klimt weer omhoog naar het tegenoverliggende plateau om Pierrefort te bereiken."
    ],
    "es": [
      "Desde la casa rural Flocons verts, la ruta se dirige hacia Puy de Bâne. El itinerario sigue durante un rato la pista de montaña. A continuación, el itinerario desciende hacia el valle de Brezons y vuelve a subir hacia la meseta opuesta para llegar a Pierrefort."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tour des Monts du Cantal en vélo électrique VTTAE ou VTCAE – Étape 2 Pailherols - Pierrefort"
    ]
  },
