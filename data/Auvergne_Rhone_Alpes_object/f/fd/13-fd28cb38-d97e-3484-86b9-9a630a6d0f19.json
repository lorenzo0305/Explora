  "rdfs:comment": {
    "de": [
      "Ofenfest in Sainte-Eugénie-de-Villeneuve mit Barbecue, Boulespiel (14? pro Doppelkopf), Hüpfburg, Feuerwerk, Kinderschminken und einem Ofenessen für 15? mit Melone/Schinken & PDT/Käse/Vanillepudding."
    ],
    "en": [
      "Oven festival in Sainte-Eugénie-de-Villeneuve with barbecue, pétanque (14? per doubles), inflatable games, fireworks, face painting for children and oven-baked meal at 15? with melon/braised ham & PDT/cheese/vanilla custard on the menu."
    ],
    "it": [
      "Festa del forno a Sainte-Eugénie-de-Villeneuve con barbecue, pétanque (14? per doppio), giochi gonfiabili, fuochi d'artificio, pittura del viso per i bambini e un pasto al forno a 15? con melone/prosciutto brasato e PDT/formaggio/crema alla vaniglia nel menu."
    ],
    "fr": [
      "Fête du four à Sainte-Eugénie-de-Villeneuve avec au programme, barbecue, pétanque (14€ la doublette), jeux gonflables, feux d'artifice, maquillage pour les enfants et repas cuit au four à 15€ avec au menu melon/jambon braisé & PDT/fromage/flan vanille."
    ],
    "nl": [
      "Ovenfeest in Sainte-Eugénie-de-Villeneuve met een barbecue, jeu de boules (14? per dubbelspel), opblaasbare spelen, vuurwerk, schminken voor kinderen en een ovenmaaltijd om 15? met meloen/gerookte ham & PDT/kaas/vanillevla op het menu."
    ],
    "es": [
      "Fiesta del horno en Sainte-Eugénie-de-Villeneuve con barbacoa, petanca (14? por parejas), juegos hinchables, fuegos artificiales, pintacaras para los niños y una comida al horno a 15? con melón/jamón braseado & PDT/queso/natillas de vainilla en el menú."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête du four | Sainte-Eugénie-de-Villeneuve"
    ]
  },
