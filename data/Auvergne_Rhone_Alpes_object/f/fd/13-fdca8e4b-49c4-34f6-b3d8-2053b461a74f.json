  "rdfs:comment": {
    "de": [
      "In einer alten Ölmühle im Herzen eines provenzalischen Dorfes können Sie regionale Produkte probieren.\r\nJérôme und Elsa, die neuen Besitzer, empfangen Sie in einer herzlichen Atmosphäre."
    ],
    "en": [
      "In an old mill in the heart of a Provençal village, tasting of local products.\r\nJérome and Elsa, the new owners, reserve you a warm welcom."
    ],
    "it": [
      "In un antico frantoio nel cuore di un villaggio provenzale, degustazione di prodotti locali.\r\nJérôme ed Elsa, i nuovi proprietari, vi accolgono in una calda atmosfera."
    ],
    "fr": [
      "Dans un ancien moulin à Huile au coeur d'un village provençal, dégustation des produits du terroir.\r\nJérôme et Elsa, les nouveaux propriétaires, vous accueillent dans une ambiance chaleureuse."
    ],
    "nl": [
      "In een oude oliemolen in het hart van een Provençaals dorpje vindt u onze streekproducten."
    ],
    "es": [
      "En un antiguo molino de aceite en el corazón de un pueblo provenzal, degustación de productos locales.\r\nJérôme y Elsa, los nuevos propietarios, le dan la bienvenida en un ambiente cálido."
    ]
  },
  "rdfs:label": {
