  "rdfs:comment": {
    "de": [
      "Der Handwerker bereitet die Produkte mit Obst und Gemüse der Saison zu, eine Vielzahl von Geschmäckern und Düften sind zu entdecken. Insgesamt gibt es fast 120 originelle und überraschende Rezepte. Und nicht zu vergessen: der Honig aus Charroux!"
    ],
    "en": [
      "The artisan prepares products with seasonal fruits and vegetables, a multitude of flavours and perfumes to discover. In total, almost 120 original and surprising recipes."
    ],
    "it": [
      "L'artigiano prepara i prodotti utilizzando frutta e verdura di stagione, con una moltitudine di sapori e aromi da scoprire. In tutto, quasi 120 ricette originali e sorprendenti. E non dimenticate il miele di Charroux!"
    ],
    "fr": [
      "L'artisan prépare des produits avec des fruits et légumes de saison, une multitude de saveurs et de parfums sont à découvrir. En tout, près de 120 recettes originales et surprenantes. Sans oublier le miel de Charroux !"
    ],
    "es": [
      "El artesano prepara productos con frutas y verduras de temporada, y hay multitud de sabores y aromas por descubrir. En total, casi 120 recetas originales y sorprendentes. ¡Y no olvide la miel de Charroux!"
    ],
    "nl": [
      "De ambachtsman bereidt producten met seizoensgebonden groenten en fruit, een veelheid aan smaken en geuren zijn te ontdekken. In totaal bijna 180 originele en verrassende recepten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Jams"
    ],
    "fr": [
      "Les confitures de Charroux®"
    ],
    "nl": [
      "Jam van Charroux"
    ]
  },
