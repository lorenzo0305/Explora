  "rdfs:comment": {
    "de": [
      "Eisenbahnmaterial aus dem 19. bis frühen 20. Jahrhundert: wie der lokale \"Tacot\" oder der einzige historische französische Konvoi eines Zuges schwerer Artillerie auf Schienen 1914-18 und seine Geschichte sowie viele andere einzigartige oder seltene Stücke, die als historisches Denkmal eingestuft sind."
    ],
    "en": [
      "Railway equipment from the 19th - early 20th c.: such as the local \"Tacot\" or the only French historic convoy of a heavy artillery train on railroad tracks 1914-18 and its history, and many other unique or rare items classified as Historic Monuments."
    ],
    "it": [
      "Attrezzature ferroviarie del XIX e dell'inizio del XX secolo: come il \"Tacot\" locale o l'unico convoglio storico francese di un treno di artiglieria pesante su binari ferroviari del 1914-18 e la sua storia, oltre a molti altri oggetti unici o rari elencati come Monumenti storici."
    ],
    "fr": [
      "Matériel ferroviaire des 19e - début 20e s. : comme \"le Tacot\" local ou le seul convoi historique français d'une rame d'artillerie lourde sur voies ferrées 1914-18 et son histoire et bien d'autres pièces uniques ou rares classées Monument Historique."
    ],
    "nl": [
      "Spoorwegmaterieel uit de 19e en begin 20e eeuw: zoals de lokale \"Tacot\" of het enige Franse historische konvooi van een zware artillerietrein op spoorrails uit 1914-18 en zijn geschiedenis, evenals vele andere unieke of zeldzame voorwerpen die op de monumentenlijst staan."
    ],
    "es": [
      "Material ferroviario del siglo XIX y principios del XX: como el \"Tacot\" local o el único convoy histórico francés de un tren de artillería pesada sobre vías férreas de 1914-18 y su historia, así como muchos otros objetos únicos o raros catalogados como Monumentos Históricos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée du chemin de fer de l'Allier"
    ]
  },
