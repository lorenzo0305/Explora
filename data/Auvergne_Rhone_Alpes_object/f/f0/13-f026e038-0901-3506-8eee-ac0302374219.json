    "it": [
      "Circuito equestre del Giura e del paese di Cerdon"
    ],
    "fr": [
      "Circuit équestre des Montagnes du Jura et pays du Cerdon"
    ],
    "nl": [
      "Juragebergte en Cerdon ruiterroute"
    ]
  },
