      "dc:description": {
        "de": [
          "Dieser Sportparcours im Freien bietet verschiedene Workshops für Arme, Beine ...\nSo können Sie Sport und Natur miteinander verbinden!"
        ],
        "en": [
          "This outdoor fitness trail offers a variety of workshops for arms, legs and more.\nA great way to combine sport and nature!"
        ],
        "it": [
          "Questo percorso di fitness all'aperto offre una varietà di laboratori per braccia, gambe e altro.\nUn ottimo modo per combinare sport e natura!"
        ],
        "fr": [
          "Ce parcours sportif en extérieur permet divers ateliers pour les bras, jambes ... \nDe quoi mêler sport et nature !"
        ],
        "es": [
          "Este sendero de fitness al aire libre ofrece una gran variedad de talleres para brazos, piernas y mucho más.\n¡Una forma estupenda de combinar deporte y naturaleza!"
        ],
        "nl": [
          "Dit outdoor fitnessparcours biedt verschillende workshops voor armen, benen en meer.\nEen geweldige manier om sport en natuur te combineren!"
        ]
      },
