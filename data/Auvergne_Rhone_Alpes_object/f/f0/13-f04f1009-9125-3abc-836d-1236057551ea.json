  "rdfs:comment": {
    "de": [
      "Café mit rockiger Atmosphäre! Große Auswahl an Bieren, Weinen, Softdrinks und Spirituosen, die Sie vor Ort genießen oder mitnehmen können. Essensangebot: Tapas, Aperitifplatten und Hotdogs. Dienstag- und Sonntagabend Konzerte, jeden Donnerstag offene Bühne."
    ],
    "en": [
      "Rockin' café atmosphere! Wide choice of beers, wines, softs and spirits to enjoy on the premises or to take away. Food: tapas, appetizers and hot dogs. Concerts on Tuesday and Sunday evenings, open stages every Thursday."
    ],
    "it": [
      "Caffè dall'atmosfera rock! Ampia scelta di birre, vini, bibite e alcolici da gustare sul posto o da portare via. Cibo: tapas, aperitivi e hot dog. Concerti il martedì e la domenica sera e palchi aperti ogni giovedì."
    ],
    "fr": [
      "Café ambiance rock ! Large choix de bières, vins, softs et spiritueux à déguster sur place ou à emporter. Côté food : tapas, planches apéro et hot-dogs. Concerts les mardis et dimanches soirs, scènes ouvertes tous les jeudis."
    ],
    "nl": [
      "Café met een rockatmosfeer! Ruime keuze aan bieren, wijnen, frisdranken en sterke dranken om ter plekke van te genieten of om mee te nemen. Eten: tapas, aperitiefschotels en hotdogs. Concerten op dinsdag- en zondagavond en elke donderdag open podia."
    ],
    "es": [
      "Café con ambiente rockero Amplia selección de cervezas, vinos, refrescos y licores para disfrutar en el local o para llevar. Comida: tapas, aperitivos y perritos calientes. Conciertos los martes y domingos por la noche, y escenarios abiertos todos los jueves."
    ]
  },
