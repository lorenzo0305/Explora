  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/47c07a0a-a3cb-3baa-91eb-4d49909af1d1",
      "dc:description": {
        "de": [
          "Montag bis Samstag von 9:30 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\nEin kleiner, praktischer Laden, in dem Lebensmittel, Hygieneartikel und je nach Anlieferung sogar Kosmetika und Kleidung zum Verkauf angeboten werden."
        ],
        "en": [
          "Monday to Saturday, 9.30am to 12.30pm and 2pm to 7pm\nA handy little boutique selling food, hygiene products and even cosmetics and clothing, according to availability."
        ],
        "it": [
          "Dal lunedì al sabato, dalle 9.30 alle 12.30 e dalle 14.00 alle 19.00\nUn pratico negozietto che vende generi alimentari, prodotti per l'igiene e persino cosmetici e abbigliamento, a seconda della disponibilità."
        ],
        "fr": [
          "Du lundi au samedi de 9h30 à 12h30 et de 14h à 19h\nUne petite boutique bien pratique qui propose à la vente des produits alimentaires, d'hygiène et même des cosmétiques et des vêtements en fonction des arrivages."
        ],
        "nl": [
          "Maandag tot zaterdag van 9.30 tot 12.30 uur en van 14.00 tot 19.00 uur\nEen handig winkeltje dat voedsel, hygiëneproducten en zelfs cosmetica en kleding verkoopt, afhankelijk van wat er beschikbaar is."
        ],
        "es": [
          "De lunes a sábado, de 9.30 a 12.30 y de 14.00 a 19.00 h\nUna pequeña tienda muy práctica que vende alimentos, productos de higiene e incluso cosméticos y ropa, según las existencias."
        ]
      },
