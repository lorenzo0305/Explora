  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant am Schnittpunkt großer Autobahnanschlüsse bietet Ihnen komfortable, ausgestattete und geräumige Zimmer für Geschäfts- oder Freizeitreisen."
    ],
    "en": [
      "At the intersection of the main motorways, this hotel-restaurant provides guests with comfortable, fully equipped and spacious rooms for a business trip or holiday."
    ],
    "it": [
      "All'incrocio delle principali autostrade, questo hotel-ristorante offre camere confortevoli, attrezzate e spaziose per un soggiorno di lavoro o di piacere."
    ],
    "fr": [
      "A la croisée des grands axes autoroutiers, cet hôtel-restaurant vous propose des chambres confortables, équipées et spacieuses pour un séjour d'affaires ou de loisirs."
    ],
    "nl": [
      "Op het kruispunt van belangrijke snelwegen biedt dit hotel-restaurant comfortabele, uitgeruste en ruime kamers voor een zakelijk of recreatief verblijf."
    ],
    "es": [
      "En el cruce de las principales autopistas, este hotel-restaurante ofrece habitaciones cómodas, equipadas y amplias para una estancia de negocios o de ocio."
    ]
  },
