  "rdfs:comment": {
    "de": [
      "Herstellung von handwerklichen Naturseifen, ausgehend von der Technik der Kaltverseifung, die es ermöglicht, die Eigenschaften der sorgfältig ausgewählten natürlichen Inhaltsstoffe zu bewahren. Natürliche und ethische Produkte mit dem Label \"Nature & Progrès\""
    ],
    "en": [
      "Production of natural handmade soaps, using the cold saponification technique to preserve the properties of carefully selected natural ingredients. Natural and ethical products certified by \"Nature & Progrès\""
    ],
    "it": [
      "Produciamo saponi naturali fatti a mano utilizzando la tecnica della saponificazione a freddo, che preserva le proprietà degli ingredienti naturali accuratamente selezionati. Prodotti naturali ed etici certificati da \"Nature & Progrès\""
    ],
    "fr": [
      "Fabrication de savons artisanaux naturels, à partir de la technique de la saponification à froid permettant de conserver les propriétés des ingrédients naturels soigneusement sélectionnés. Produits naturels et éthiques labélisés par \"Nature & Progrès\""
    ],
    "nl": [
      "We maken natuurlijke handgemaakte zepen met behulp van de koude verzepingstechniek, die de eigenschappen van zorgvuldig geselecteerde natuurlijke ingrediënten behoudt. Natuurlijke en ethische producten gecertificeerd door \"Nature & Progrès\""
    ],
    "es": [
      "Elaboramos jabones naturales artesanales mediante la técnica de saponificación en frío, que preserva las propiedades de los ingredientes naturales cuidadosamente seleccionados. Productos naturales y éticos certificados por \"Nature & Progrès\""
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bellis savonnerie"
    ]
  },
