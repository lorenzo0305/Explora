  "rdfs:comment": {
    "de": [
      "Das Gebäude von Mègemont, das als eine der schönsten Zisterzienserabteien der Auvergne gilt, liegt isoliert in einem Tal auf 900 m Höhe am Rande des Cézallier und ist einen Umweg wert!"
    ],
    "en": [
      "Isolated in a secluded valley and saved from the ruin, the choir and the transept of the abbey testify from what was one of the most important Cistercian abbeys in the region."
    ],
    "it": [
      "Considerata una delle più belle abbazie cistercensi dell'Alvernia, Mègemont, isolata in una valle a 900 metri di altitudine ai margini del Cézallier, merita una visita!"
    ],
    "fr": [
      "Considérée comme l'une des plus belles abbayes Cisterciennes d’Auvergne, l'édifice de Mègemont, isolé dans un vallon à 900 mètres d'altitude aux confins du Cézallier, vaut le détour !"
    ],
    "nl": [
      "Mègemont, dat wordt beschouwd als een van de mooiste cisterciënzerabdijen van de Auvergne, ligt geïsoleerd in een vallei op 900 meter boven zeeniveau aan de rand van de Cézallier en is zeker een bezoekje waard!"
    ],
    "es": [
      "Considerada una de las abadías cistercienses más bellas de Auvernia, Mègemont, aislada en un valle a 900 metros sobre el nivel del mar al borde del Cézallier, bien merece una visita"
    ]
  },
  "rdfs:label": {
    "en": [
      "The Abbey Of Megemont - Clunisian Site"
    ],
    "fr": [
      "Abbaye de Mègemont - site cistercien"
    ]
  },
