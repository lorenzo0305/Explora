  "rdfs:comment": {
    "de": [
      "Profitieren Sie von mehr als 7.500 Spielen und Spielsachen (Gesellschaftsspiele, Puzzles, Puppen, Bastel- und Konstruktionsspiele, wissenschaftliche Spiele, Verkleidungen...), die Sie vor Ort entdecken oder kostenlos ausleihen können."
    ],
    "en": [
      "Enjoy more than 7,500 games and toys (board games, puzzles, dolls, DIY, construction, scientific games, disguises...) to discover on site or to borrow for free."
    ],
    "it": [
      "Approfittate di oltre 7.500 giochi e giocattoli (giochi da tavolo, puzzle, bambole, giochi di bricolage, giochi di costruzione, giochi scientifici, costumi, ecc.) da scoprire sul posto o da prendere in prestito gratuitamente."
    ],
    "fr": [
      "Profitez de plus de 7 500 jeux et jouets (jeux de société, puzzles, poupées, jeux de bricolage, de construction, jeux scientifiques, déguisements…) à découvrir sur place ou à emprunter gratuitement."
    ],
    "nl": [
      "Profiteer van meer dan 7.500 spellen en speelgoed (bordspellen, puzzels, poppen, doe-het-zelfspellen, bouwspellen, wetenschappelijke spellen, kostuums, enz.) om ter plaatse te ontdekken of gratis te lenen."
    ],
    "es": [
      "Aproveche los más de 7.500 juegos y juguetes (juegos de mesa, rompecabezas, muñecas, juegos de bricolaje, juegos de construcción, juegos científicos, disfraces, etc.) para descubrir in situ o para tomar prestados gratuitamente."
    ]
  },
