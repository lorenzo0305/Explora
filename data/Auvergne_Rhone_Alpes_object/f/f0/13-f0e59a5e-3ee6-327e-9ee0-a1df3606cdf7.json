  "rdfs:comment": {
    "de": [
      "Hat Ihnen die grüne Schleife nicht gereicht? Verlängern Sie Ihre Reise bis zum Weiler Thyl und genießen Sie die Reize der Dörfer, die Sie durchqueren werden."
    ],
    "en": [
      "Not satisfied with the green loop? Extend your journey to the hamlet of Le Thyl and enjoy the charms of the villages you'll pass through."
    ],
    "it": [
      "L'anello verde non era sufficiente per voi? Estendete il vostro viaggio al borgo di Thyl e godetevi il fascino dei villaggi che attraverserete."
    ],
    "fr": [
      "La boucle verte ne vous a pas suffit ? Prolongez votre périple jusqu'au hameau du Thyl et profitez des charmes offerts pas les villages que vous allez traverser."
    ],
    "es": [
      "¿El bucle verde no fue suficiente para ti? Prolongue su viaje hasta la aldea de Thyl y disfrute de los encantos de los pueblos que atravesará."
    ],
    "nl": [
      "De groene lus was niet genoeg voor je? Verleng uw reis naar het gehucht Thyl en geniet van de charmes van de dorpen waar u doorheen komt."
    ]
  },
