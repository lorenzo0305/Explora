  "rdfs:comment": {
    "de": [
      "Persönliche Entwicklung und Entwicklung des Kindes."
    ],
    "en": [
      "With L'Esprit Glisse, I accompany you in the search of balance, understanding and improving movement. Experience the intuitive ski experience; connecting creative visualisation to the source: the happiness of your being."
    ],
    "it": [
      "Con l'anima dello sciatore, vi accompagno nella ricerca dell'equilibrio, della comprensione e del miglioramento del movimento. Vivete l'esperienza dello sci intuitivo; la visualizzazione creativa che si riunisce alla fonte: la felicità del vostro essere."
    ],
    "fr": [
      "Développement personnel et développement de l'enfant."
    ],
    "nl": [
      "L'Esprit Glisse, ik begeleid u in het zoeken naar evenwicht, het begrip en de verbetering van de beweging. Beleef intuïtief glijden; creërende visualisatie verbinding met de bron; uw welzijn."
    ],
    "es": [
      "Desarrollo personal y desarrollo infantil."
    ]
  },
