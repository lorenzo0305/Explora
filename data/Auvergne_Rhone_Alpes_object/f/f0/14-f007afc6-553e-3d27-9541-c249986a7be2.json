  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8ec627c9-e54f-3542-8bc1-4f83af37e0f2",
      "dc:description": {
        "de": [
          "Racomptines\n\"Special Gilles Bachelet Autor / Illustrator\"\nGeschichten, Reime und Fingerspiele für Kleinkinder.\n\n\nBibludothek Damrémont\n\nAb 1 Jahr.\nMit Voranmeldung."
        ],
        "en": [
          "Racomptines\n\"Special Gilles Bachelet Author / Illustrator\"\nStories, rhymes and fingerplays for toddlers.\n\n\nBibludothèque Damrémont\n\nFrom 1 year.\nReservations required."
        ],
        "it": [
          "Racomptine\n\"Speciale Gilles Bachelet Autore / Illustratore\nStorie, filastrocche e giochi con le dita per i più piccoli.\n\n\nBiblioteca Damrémont\n\nDa 1 anno.\nPrenotazione obbligatoria."
        ],
        "fr": [
          "Racomptines\n\"Spécial Gilles Bachelet Auteur / Illustrateur\"\nDes histoires, des comptines et des jeux de doigts pour les tout-petits.\n\n\nBibludothèque Damrémont\n\nA partir de 1 an.\nSur réservation."
        ],
        "nl": [
          "Racomptines\n\"Speciaal Gilles Bachelet Auteur / Illustrator\nVerhalen, kinderrijmpjes en vingerspelletjes voor peuters.\n\n\nBibliotheek Damrémont\n\nVanaf 1 jaar.\nReserveren verplicht."
        ],
        "es": [
          "Racomptines\n\" Especial Gilles Bachelet Autor / Ilustrador\nCuentos, canciones infantiles y juegos de dedos para niños pequeños.\n\n\nBiblioteca Damrémont\n\nA partir de 1 año.\nReserva obligatoria."
        ]
      },
