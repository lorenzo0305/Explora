  "rdfs:comment": {
    "de": [
      "Der Schlosspark aus dem 12., 15. und 16. Jahrhundert ist von April bis Oktober frei zugänglich. Inmitten von Wäldern und Rasenflächen bietet das Schloss die Form eines unregelmäßigen Fünfecks, das von fünf Türmen mit unterschiedlichen Winkeln flankiert wird. Die Umfriedungen und Wehrgänge sind intakt. ISMH."
    ],
    "en": [
      "Free admission to the park of the 12th, 15th and 16th-century château from April to October. Set in woods and lawns, the château is an irregular pentagon flanked by five towers of varying angles. The enclosures and walkways are intact. ISMH."
    ],
    "it": [
      "Ingresso gratuito al parco del castello del XII, XV e XVI secolo da aprile a ottobre. Immerso in boschi e prati, ha la forma di un pentagono irregolare fiancheggiato da cinque torri ad angolo variabile. I recinti e i camminamenti sono intatti. ELENCO ISMH."
    ],
    "fr": [
      "Accès libre du parc du château des XIIe, XVe et XVIe siècles d'avril à octobre. Dans son écrin de bois et de pelouses, il offre la forme d'un pentagone irrégulier flanqué de cinq tours d'angles variés. Les enceintes et chemins de ronde sont intacts. ISMH."
    ],
    "nl": [
      "Gratis toegang tot de tuinen van het kasteel uit de 12e, 15e en 16e eeuw van april tot oktober. Het kasteel ligt in een bos en gazons en heeft de vorm van een onregelmatige vijfhoek geflankeerd door vijf torens met verschillende hoeken. De omheiningen en wandelpaden zijn intact. ISMH-LIJST."
    ],
    "es": [
      "Entrada gratuita al recinto del castillo de los siglos XII, XV y XVI de abril a octubre. Situado entre bosques y céspedes, tiene forma de pentágono irregular flanqueado por cinco torres de ángulos variables. Los recintos y paseos están intactos. ISMH LISTED."
    ]
  },
