  "rdfs:comment": {
    "de": [
      "6-stündige Bootsfahrt auf dem Kanal von Pont-de-Vaux und der Saône bis nach Tournus und zurück. Passieren der Schleuse von Pont-de-Vaux. Essen an Bord und geführte Besichtigung der romanischen Abtei Saint-Philibert de Tournus bei einem Zwischenstopp von 14:30 bis 15:30 Uhr."
    ],
    "en": [
      "Departing from the port of Pont-de-Vaux, lunch cruise on the Canal de Pont-de-Vaux and the Saône to Tournus and back. Passage of the Pont-de-Vaux lock. Lunch on board and guided tour of the Romanesque abbey of Saint-Philibert de Tournus."
    ],
    "it": [
      "Partenza dal porto di Pont-de-Vaux, pranzo in crociera sul canale di Pont-de-Vaux e sulla Saona fino a Tournus e ritorno. Passaggio attraverso la chiusa di Pont-de-Vaux. Pasto a bordo e visita guidata dell'abbazia romanica di Saint-Philibert de Tournus."
    ],
    "fr": [
      "Au départ du port de Pont-de-Vaux, croisière déjeuner sur le Canal de Pont-de-Vaux et la Saône jusqu'à Tournus aller et retour. Passage de l'écluse de Pont-de-Vaux. Repas à bord et  visite guidée de l'abbaye romane Saint-Philibert de Tournus en escale."
    ],
    "nl": [
      "Vertrek uit de haven van Pont-de-Vaux, lunch op het kanaal van Pont-de-Vaux en de Saône naar Tournus en terug. Passage door de sluis van Pont-de-Vaux. Maaltijd aan boord en rondleiding door de Romaanse abdij Saint-Philibert de Tournus."
    ],
    "es": [
      "Salida del puerto de Pont-de-Vaux, almuerzo crucero por el canal de Pont-de-Vaux y el Saona hasta Tournus y regreso. Paso por la esclusa de Pont-de-Vaux. Comida a bordo y visita guiada de la abadía románica de Saint-Philibert de Tournus."
    ]
  },
  "rdfs:label": {
    "de": [
      "Saône-Kreuzfahrt Tournus Abtei"
    ],
    "en": [
      "Saône Tournus abbaye cruise"
    ],
    "fr": [
      "Croisière Saône Tournus abbaye"
    ],
    "nl": [
