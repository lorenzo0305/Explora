  "rdfs:comment": {
    "de": [
      "Entdecken Sie die traditonelle Käseherstellung des \"Fourme de Montbrison\" (gesetzlich geschützte Benennung) in Pont de la Pierre. Kostenlose Verkostung und Verkauf vor Ort. Besichtigung der Fabrikationslaboratorien von einer Beobachtungsgalerie aus."
    ],
    "en": [
      "Come discover the traditional methods of manufacturing of the Fourme de Montbrison (the Montbrison round cheese) Pont de la Pierre. \r\nFree tasting and sale in the shop. \r\nVisit of the manufacturing laboratory from an observation gallery."
    ],
    "it": [
      "Venite a scoprire la produzione tradizionale di Fourme de Montbrison (AOP) Pont de la Pierre. Da una galleria di osservazione è possibile osservare ogni fase della produzione\r\nVisita alla cantina di stagionatura, degustazione gratuita e vendita sul posto."
    ],
    "fr": [
      "Venez découvrir la fabrication traditionnelle de la Fourme de Montbrison (AOP) Pont de la Pierre. Depuis une galerie d'observation vous pourrez assister à chaque étape de fabrication. \r\nVisite de la cave d'affinage, dégustation gratuite et vente sur place."
    ],
    "es": [
      "Venga a descubrir la fabricación artesanal del queso DOP Pont de la Pierre Fourme de Montbrison. Desde una galería de observación, podrá observar cada etapa de la producción.\r\nVisite la bodega de maduración, disfrute de una degustación gratuita y compre su Fourme in situ."
    ],
    "nl": [
      "Kom en ontdek de traditionele productie van Pont de la Pierre Fourme de Montbrison BOB kaas. Vanuit een observatiegalerij kun je elke productiefase bekijken.\r\nBezoek de rijpingskelder, geniet van een gratis proeverij en koop je Fourme ter plekke."
    ]
  },
