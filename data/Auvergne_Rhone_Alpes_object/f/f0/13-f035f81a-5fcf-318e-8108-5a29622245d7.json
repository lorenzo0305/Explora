  "rdfs:comment": {
    "de": [
      "Jean-Pierre Michy wird die Arbeit des berühmten Komponisten der Filmmusik von Alfred Hitchcock, aber auch seine unbekannteren Werke beleuchten.\r\nErwachsenenpublikum, Reservierung empfohlen."
    ],
    "en": [
      "Jean-Pierre Michy will highlight the work of the famous composer of Alfred Hitchcock's film scores, as well as his lesser-known works.\r\nAdults, booking recommended."
    ],
    "it": [
      "Jean-Pierre Michy metterà in luce il lavoro del famoso compositore delle colonne sonore di Alfred Hitchcock, nonché le sue opere meno conosciute.\r\nAdulti, prenotazione consigliata."
    ],
    "fr": [
      "Jean-Pierre Michy mettra en lumière le travail du célèbre compositeur de musiques de films du cinéaste Alfred Hitchcock, mais aussi ses œuvres plus méconnues.\r\nPublic adulte, réservation conseillée."
    ],
    "es": [
      "Jean-Pierre Michy destacará la obra del famoso compositor de las partituras de las películas de Alfred Hitchcock, así como sus obras menos conocidas.\r\nAdultos, se recomienda reservar."
    ],
    "nl": [
      "Jean-Pierre Michy belicht het werk van de beroemde componist van de filmmuziek van Alfred Hitchcock, maar ook zijn minder bekende werken.\r\nVolwassenen, reserveren aanbevolen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Rencontre musicale avec Bernart Hermann"
    ]
  },
