  "rdfs:comment": {
    "de": [
      "Probieren Sie in modernem Dekor die traditionelle Küche im L'Everest. Im Herzen von Firminy können Sie einen schönen Augenblick unter Freunden, zu zweit oder während der Mittagspause verbringen ..."
    ],
    "en": [
      "Come and enjoy traditional french cuisine surrounded by modern décor at L'Everest, in central Firminy. Come here for a good time with friends, family, your partner or just for a lunch break... Enjoy a different menu at each season."
    ],
    "it": [
      "Gustate la cucina tradizionale francese in un ambiente moderno. Nel cuore di Firminy, venite a divertirvi con gli amici, la famiglia, gli innamorati, durante una pausa pranzo o nel fine settimana\r\nIl menu varia a seconda della stagione."
    ],
    "fr": [
      "Dans un décor moderne, venez déguster la cuisine traditionnelle française. Au coeur de Firminy, venez passer un bon moment entre amis, en famille, en amoureux ou lors d'une pause déjeuner ou le weekend \r\nLa carte varie selon les saisons."
    ],
    "nl": [
      "Geniet van de traditionele Franse keuken in een modern kader. In het hart van Firminy, kom en geniet met vrienden, familie, geliefden, tijdens een lunchpauze of in het weekend\r\nHet menu varieert naargelang het seizoen."
    ],
    "es": [
      "Disfrute de la cocina tradicional francesa en un ambiente moderno. En el corazón de Firminy, venga a pasar un buen rato con los amigos, la familia, los enamorados, durante un almuerzo o el fin de semana\r\nEl menú varía según la temporada."
    ]
  },
