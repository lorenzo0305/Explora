  "rdfs:comment": {
    "de": [
      "1h15 von Lyon und Genf entfernt bietet der Bikepark von Cormaranche 13 Pisten für alle Schwierigkeitsgrade. Entdecken Sie die Enduro- und Downhill-Mountainbike-Strecken: 7 Downhill-Strecken, 5 Enduro-Strecken und 1 Ludik-Park für die Kleinsten."
    ],
    "en": [
      "1h15 from Lyon and Geneva, the Cormaranche Bike Park offers 13 trails for all levels. Come and discover the enduro and downhill mountain bike trails: 7 downhill trails, 5 enduro trails and 1 ludik park for the little ones."
    ],
    "it": [
      "A 1h15 da Lione e Ginevra, il Cormaranche Bike Park offre 13 percorsi per tutti i livelli. Venite a scoprire le piste da enduro e da downhill: 7 piste da downhill, 5 piste da enduro e 1 ludik park per i più piccoli."
    ],
    "fr": [
      "À 1h15 de Lyon et de Genève, le Bike Park de Cormaranche propose 13 pistes tous niveaux. Venez découvrir les pistes de VTT enduro et descente : 7 pistes de descente, 5 pistes d'enduro et 1 ludik park pour les plus jeunes."
    ],
    "nl": [
      "Op 1u15 van Lyon en Genève biedt het Cormaranche Bike Park 13 routes voor alle niveaus. Kom en ontdek de enduro en downhill mountainbiketracks: 7 downhill tracks, 5 enduro tracks en 1 Ludik park voor de allerkleinsten."
    ],
    "es": [
      "A 1h15 de Lyon y Ginebra, el Bike Park de Cormaranche ofrece 13 pistas para todos los niveles. Venga a descubrir las pistas de enduro y descenso en bicicleta de montaña: 7 pistas de descenso, 5 pistas de enduro y 1 ludik park para los más pequeños."
    ]
  },
