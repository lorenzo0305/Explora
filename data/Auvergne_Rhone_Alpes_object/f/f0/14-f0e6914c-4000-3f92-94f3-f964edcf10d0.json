      "dc:description": {
        "de": [
          "Frisur Mann Spezialist Kind.\n\nTäglich außer Sonntag und Montag von 9:00 bis 12:30 Uhr und von 14:30 bis 19:15 Uhr geöffnet."
        ],
        "en": [
          "Men's hairstyling, children's hairstyling.\n\nOpen every day except Sunday and Monday, 9am to 12:30pm and 2:30pm to 7:15pm."
        ],
        "it": [
          "Parrucchiere uomo, parrucchiere bambino.\n\nAperto tutti i giorni, tranne domenica e lunedì, dalle 9.00 alle 12.30 e dalle 14.30 alle 19.15."
        ],
        "fr": [
          "Coiffure homme spécialiste enfant.\n\nOuvert tous les jours sauf dimanche et lundi de 9h à 12h30 et de 14h30 à 19h15."
        ],
        "es": [
          "Peluquería masculina, peluquería infantil.\n\nAbierto todos los días excepto el domingo y el lunes de 9.00 a 12.30 y de 14.30 a 19.15."
        ],
        "nl": [
          "Herenkappers, kinderkappers.\n\nElke dag geopend behalve zondag en maandag van 9.00 tot 12.30 uur en van 14.30 tot 19.15 uur."
        ]
      },
