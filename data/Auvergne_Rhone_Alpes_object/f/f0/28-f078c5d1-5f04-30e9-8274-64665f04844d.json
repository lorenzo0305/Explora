  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/59826fff-10ae-3d9f-91e7-3fdd218b44d4",
      "dc:description": {
        "de": [
          "Golf de Salouel - Par 33 - 2173 m - Übungsgelände - Schule - Vermietung - Clubhaus. Unser 9-Loch-Parcours ist sehr hügelig und technisch anspruchsvoll. Seine Greens werden von zahlreichen Bunkern stark verteidigt."
        ],
        "en": [
          "Golf de Salouel - Par 33 - 2173 m - Practice - School - Rental - Club house. Our 9-hole course is very hilly and technical. Its greens are strongly defended by numerous bunkers."
        ],
        "it": [
          "Golf de Salouel - Par 33 - 2173 m - Pratica - Scuola - Noleggio - Club house. Il nostro campo a 9 buche è molto collinoso e tecnico. I suoi green sono fortemente difesi da numerosi bunker."
        ],
        "fr": [
          "Golf de Salouel - Par 33 - 2173 m - Practice - Ecole - Location - Club house. Notre parcours de 9 trous est très vallonné et technique. Ses greens sont fortement défendus par de nombreux bunkers."
        ],
        "nl": [
          "Golf de Salouel - Par 33 - 2173 m - Practice - School - Verhuur - Clubhuis. Onze 9-holes baan is zeer heuvelachtig en technisch. De greens worden sterk verdedigd door talrijke bunkers."
        ],
        "es": [
          "Golf de Salouel - Par 33 - 2173 m - Práctica - Escuela - Alquiler - Casa club. Nuestro campo de 9 hoyos es muy accidentado y técnico. Sus greens están fuertemente defendidos por numerosos bunkers."
        ]
      },
