  "rdfs:comment": {
    "de": [
      "Das Office de Tourisme du Pilat, das im Maison du Parc in Pélussin untergebracht ist, empfängt Sie und berät Sie, damit Sie Ihren Ausflug in den Parc du Pilat optimal vorbereiten können."
    ],
    "en": [
      "Located in the Maison du Parc in Pélussin, the Pilat Tourist Office welcomes and advises you on how to best prepare your excursion in the Parc du Pilat."
    ],
    "it": [
      "Situato nella Maison du Parc a Pélussin, l'Ufficio del Turismo del Pilat vi accoglie e vi consiglia su come preparare al meglio la vostra escursione nel Parc du Pilat."
    ],
    "fr": [
      "Installé au sein de la Maison du Parc à Pélussin, l'Office de Tourisme du Pilat vous accueille et vous conseille pour préparer au mieux votre excursion dans le Parc du Pilat."
    ],
    "es": [
      "Situada en la Maison du Parc de Pélussin, la Oficina de Turismo de Pilat le da la bienvenida y le asesora para preparar mejor su excursión por el Parque de Pilat."
    ],
    "nl": [
      "In het Maison du Parc in Pélussin ontvangt het toeristenbureau van Pilat u en adviseert u over de beste voorbereiding van uw excursie in het Parc du Pilat."
    ]
  },
