  "rdfs:comment": {
    "de": [
      "Schreiben bedeutet teilen, kreieren, sich ausdrücken, etwas wagen, träumen, hoffen, entdecken, verändern, ausleben, zuhören, reisen, da sein. In Partnerschaft mit dem C2R"
    ],
    "en": [
      "To write is to share, create, express oneself, dare, dream, hope, discover, change, externalize, listen, travel, be there. In partnership with C2R"
    ],
    "it": [
      "Scrivere significa condividere, creare, esprimersi, osare, sognare, sperare, scoprire, cambiare, esprimere, ascoltare, viaggiare, esserci. In collaborazione con C2R"
    ],
    "fr": [
      "Ecrire c'est partager, créer, s’exprimer, oser, rêver, espérer, découvrir, changer, extérioriser, écouter, voyager, être là. En partenariat avec le C2R"
    ],
    "nl": [
      "Schrijven gaat over delen, creëren, jezelf uitdrukken, durven, dromen, hopen, ontdekken, veranderen, uitdrukken, luisteren, reizen, er zijn. In samenwerking met C2R"
    ],
    "es": [
      "Escribir es compartir, crear, expresarse, atreverse, soñar, esperar, descubrir, cambiar, expresarse, escuchar, viajar, estar ahí. En colaboración con C2R"
    ]
  },
  "rdfs:label": {
