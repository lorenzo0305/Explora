  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/422b099b-44f7-3142-a853-b3c77806a698",
      "dc:description": {
        "de": [
          "Das Restaurant L'Olivier wird Sie mit seiner mediterranen Küche \"Tajine - Couscous - Grilladen - Salate\" verführen. Es befindet sich im Zentrum von Béthune. Genießen Sie auch unsere Terrasse. Eine Reservierung ist wünschenswert."
        ],
        "en": [
          "The restaurant L'Olivier will seduce you with its Mediterranean cuisine \"tajine - couscous - grills - salads\", located in the center of Béthune. Come and enjoy also our terrace. Reservation is advisable."
        ],
        "it": [
          "Il ristorante L'Olivier vi sedurrà con la sua cucina mediterranea \"tajine - couscous - grigliate - insalate\", situato nel centro di Bethune. Venite a godervi la nostra terrazza. Si consiglia la prenotazione."
        ],
        "fr": [
          "Le restaurant L'Olivier sera vous séduire avec sa cuisine méditerranéenne \"tajine - couscous - grillades - salades\", situé au centre de Béthune. Venez également profiter de notre terrasse. La réservation est souhaitable."
        ],
        "nl": [
          "Het restaurant L'Olivier zal u verleiden met zijn mediterrane keuken \"tajine - couscous - grill - salades\", gelegen in het centrum van Bethune. Kom en geniet van ons terras. Reserveren is aanbevolen."
        ],
        "es": [
          "El restaurante L'Olivier le seducirá con su cocina mediterránea \"tajine - cuscús - parrilla - ensaladas\", situado en el centro de Bethune. Venga a disfrutar de nuestra terraza. Se recomienda reservar."
        ]
      },
