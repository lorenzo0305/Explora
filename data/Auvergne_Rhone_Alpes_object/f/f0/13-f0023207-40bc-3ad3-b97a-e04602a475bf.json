  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Überreste eines Schlosses in der Haute-Loire, 1 Stunde von Lyon und 30 Minuten von Saint-Etienne entfernt. Ein Ort des Kulturerbes und der Natur, der aus der Zeit gefallen ist, enthüllt all seine Geheimnisse?"
    ],
    "en": [
      "Experience a real immersion in the heart of the remains of a castle in the Haute-Loire, 1 hour from Lyon and 30 minutes from Saint-Etienne. A place of heritage preservation and natural species, out of time, reveals all its secrets?"
    ],
    "it": [
      "Vivete una vera e propria immersione nel cuore dei resti di un castello nell'Alta Loira, a 1 ora da Lione e a 30 minuti da Saint-Etienne. Un luogo di conservazione del patrimonio e delle specie naturali, fuori dal tempo, rivela tutti i suoi segreti?"
    ],
    "fr": [
      "Vivez une véritable immersion au cœur des vestiges d’un château de Haute-Loire,  à  1 heure de Lyon et 30 minutes de Saint-Etienne. Un lieu de préservation du Patrimoine et d’espèces naturelles, hors du temps, vous dévoile tous ses secrets…"
    ],
    "es": [
      "Viva una auténtica inmersión en el corazón de los restos de un castillo del Alto Loira, a 1 hora de Lyon y a 30 minutos de Saint-Etienne. ¿Un lugar de conservación del patrimonio y las especies naturales, fuera del tiempo, revela todos sus secretos?"
    ],
    "nl": [
      "Beleef een echte onderdompeling in het hart van de overblijfselen van een kasteel in de Haute-Loire, op 1 uur van Lyon en 30 minuten van Saint-Etienne. Een plaats van erfgoedbehoud en natuurlijke soorten, buiten de tijd, geeft al zijn geheimen prijs?"
    ]
  },
