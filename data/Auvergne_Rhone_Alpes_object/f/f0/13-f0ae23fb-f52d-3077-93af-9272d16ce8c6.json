  "rdfs:comment": {
    "de": [
      "Seit fast 50 Jahren bringen die Reiterhöfe des Vercors zahlreichen Reitern, Anfängern wie Fortgeschrittenen, die Freude am Reitsport näher."
    ],
    "en": [
      "For nearly 50 years, the Fermes Équestres du Vercors has given beginners and experienced riders the opportunity to enjoy horse riding."
    ],
    "it": [
      "Da 50 anni, le fattorie equestri del Vercors offrono le gioie dell'equitazione a molti cavalieri, principianti ed esperti."
    ],
    "fr": [
      "Depuis 50 ans, les fermes équestres du Vercors font vivre à de nombreux cavaliers, débutants et confirmés, les joies du cheval."
    ],
    "es": [
      "Desde hace 50 años, las granjas ecuestres del Vercors llevan el placer de montar a caballo a numerosos jinetes, principiantes y experimentados."
    ],
    "nl": [
      "Al 50 jaar brengen de paardenboerderijen van de Vercors het plezier van paardrijden bij vele ruiters, zowel beginners als gevorderden."
    ]
  },
