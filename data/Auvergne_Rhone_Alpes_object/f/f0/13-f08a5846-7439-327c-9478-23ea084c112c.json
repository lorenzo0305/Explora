  "rdfs:comment": {
    "de": [
      "Dominique Rochet, Holzdreher und Kunsttischler, entwirft exklusive Leuchten, die das Licht und die besondere Transparenz des Holzes offenbaren. Bei einem Abstecher in sein Atelier können Sie die ganze Vielfalt und Feinheit seiner einzigartigen Kreationen entdecken."
    ],
    "en": [
      "Dominique Rochet, woodturner and cabinetmaker, creates exclusive lighting fixtures that reveal the light and transparency of wood. Take a detour to his workshop to discover the diversity and finesse of his unique creations."
    ],
    "it": [
      "Dominique Rochet, tornitore ed ebanista, crea apparecchi di illuminazione esclusivi che rivelano la luce e la trasparenza del legno. Una visita al suo laboratorio rivelerà la diversità e la finezza delle sue creazioni uniche."
    ],
    "fr": [
      "Dominique Rochet, tourneur sur bois ébéniste, créé des luminaires exclusifs qui révèlent la lumière et la transparence particulière du bois. Un détour par son atelier vous permettra de découvrir toute la diversité et la finesse de ses créations uniques."
    ],
    "es": [
      "Dominique Rochet, tornero y ebanista, crea luminarias exclusivas que revelan la luz y la transparencia de la madera. Una visita a su taller le revelará la diversidad y delicadeza de sus creaciones únicas."
    ],
    "nl": [
      "Dominique Rochet, houtdraaier en meubelmaker, creëert exclusieve verlichtingsarmaturen die het licht en de transparantie van hout onthullen. Een bezoek aan zijn werkplaats onthult de diversiteit en finesse van zijn unieke creaties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dominique Rochet - Tourneur sur bois ébéniste"
    ]
  },
