  "rdfs:comment": {
    "de": [
      "Im Jahr 2026 kehrt das Festival Camp de base mit einem wesentlichen Thema zurück: der Erde. Eine Woche im Rhythmus von Vorträgen, Aufführungen, Konzerten und Austausch, zwischen Naturausflügen, der Entdeckung von Mutter Erde und dem Eintauchen in die lokale Landwirtschaft."
    ],
    "en": [
      "In 2026, the Base Camp Festival returns with an essential theme: the Earth. A week punctuated by conferences, shows, concerts and sharing, between nature outings, discovery of Mother Earth and immersion in local agriculture."
    ],
    "it": [
      "Nel 2026, il Festival Campo Base torna con un tema essenziale: la Terra. Una settimana scandita da conferenze, spettacoli, concerti e condivisione, tra uscite naturalistiche, scoperta della Madre Terra e immersione nell'agricoltura locale."
    ],
    "fr": [
      "En 2026, le Festival Camp de base revient avec un thème essentiel : la Terre. Une semaine rythmée par les conférences, spectacles, concerts et le partage, entre sorties nature, découverte de la terre nourricière et immersion dans l’agriculture locale."
    ],
    "nl": [
      "In 2026 keert het Basiskampfestival terug met een essentieel thema: de Aarde. Een week doorspekt met conferenties, voorstellingen, concerten en uitwisselingen, tussen natuurexcursies, het ontdekken van Moeder Aarde en een onderdompeling in de lokale landbouw."
    ],
    "es": [
      "En 2026, el Festival del Campo Base vuelve con un tema esencial: la Tierra. Una semana jalonada de conferencias, espectáculos, conciertos y puestas en común, entre salidas a la naturaleza, descubrimiento de la Madre Tierra e inmersión en la agricultura local."
    ]
  },
  "rdfs:label": {
