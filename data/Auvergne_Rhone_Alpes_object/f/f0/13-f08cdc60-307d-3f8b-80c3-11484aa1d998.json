  "rdfs:comment": {
    "de": [
      "Sind Sie ein Fan von Schnitzeljagden? Das Fremdenverkehrsamt von Morzine hat eine kostenlose virtuelle Schnitzeljagd eingerichtet, bei der Sie das Dorf und sein Kulturerbe auf interaktive Weise entdecken können."
    ],
    "en": [
      "Fan of track game? The Morzine Tourist Office has set up a free virtual treasure hunt to explore the village and its heritage in an interactive way."
    ],
    "it": [
      "Vi piace la caccia al tesoro? L'Ufficio del Turismo di Morzine ha organizzato una caccia al tesoro virtuale gratuita per scoprire il villaggio e il suo patrimonio in modo interattivo."
    ],
    "fr": [
      "Adepte des jeux de piste ? L’Office de Tourisme de Morzine a mis en place un jeu de piste virtuel gratuit pour découvrir le village et le patrimoine de façon interactive."
    ],
    "es": [
      "¿Te gustan las búsquedas de tesoros? La Oficina de Turismo de Morzine ha creado una búsqueda del tesoro virtual y gratuita para descubrir el pueblo y su patrimonio de forma interactiva."
    ],
    "nl": [
      "Hou je van schatzoeken? Het toeristenbureau van Morzine heeft een gratis virtuele schattenjacht opgezet om het dorp en zijn erfgoed op een interactieve manier te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Treasure hunt"
    ],
    "fr": [
      "Jeux de piste"
    ]
  },
