  "rdfs:comment": {
    "de": [
      "Der Mountainbike-Raum Thiers Vallée de la Dore bietet markierte Strecken für alle Mountainbiker in der Region Livradois-Forez. Er befindet sich im Herzen des größten Mountainbikegebiets Frankreichs: Destination Grand?R."
    ],
    "en": [
      "The Thiers Vallée de la Dore mountain biking center offers marked trails for all mountain bikers in the Livradois-Forez region. It lies at the heart of France?s largest mountain-biking area: Destination Grand-R."
    ],
    "it": [
      "L'area per mountain bike Thiers Vallée de la Dore offre percorsi segnalati per tutti gli appassionati di mountain bike nella regione Livradois-Forez. Si trova nel cuore della più grande area per mountain bike della Francia: Destination Grand-R."
    ],
    "fr": [
      "L’espace VTT Thiers Vallée de la Dore propose des circuits balisés pour tous les VTTistes dans le Livradois-Forez. Il se situe au cœur du plus grand espace VTT de France : Destination Grand’R."
    ],
    "es": [
      "La zona de BTT de Thiers Vallée de la Dore ofrece senderos señalizados para todos los ciclistas de montaña en la región de Livradois-Forez. Se encuentra en el corazón de la mayor zona de ciclismo de montaña de Francia: Destination Grand-R."
    ],
    "nl": [
      "Het mountainbikegebied Thiers Vallée de la Dore biedt bewegwijzerde routes voor alle mountainbikers in de regio Livradois-Forez. Het ligt in het hart van het grootste mountainbikegebied van Frankrijk: Destination Grand-R."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace vtt Vallée de la Dore"
    ]
  },
