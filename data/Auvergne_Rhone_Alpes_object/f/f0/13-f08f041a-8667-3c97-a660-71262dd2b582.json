  "rdfs:comment": {
    "de": [
      "Rocky Buffet ist das Restaurant, das sich an alle Wünsche anpasst, egal ob Sie zu zweit, mit der Familie oder mit Freunden kommen! Das Rocky Buffet ist eines der drei Restaurants im RockyPop Flaine Hotel & Spa."
    ],
    "en": [
      "Rocky Buffet is the restaurant that caters to all tastes, whether you come as a couple, with family or friends! Rocky Buffet is one of three restaurants at the RockyPop Flaine Hotel & Spa."
    ],
    "it": [
      "Il Rocky Buffet è il ristorante adatto a tutti i gusti, sia che veniate in coppia, con la famiglia o con gli amici! Il Rocky Buffet è uno dei tre ristoranti del RockyPop Flaine Hotel & Spa."
    ],
    "fr": [
      "Rocky Buffet, c’est le restaurant qui s’adapte à toutes les envies, que vous veniez en couple, en famille ou entre amis ! Rocky Buffet est l’un des trois restaurants du RockyPop Flaine Hotel & Spa."
    ],
    "nl": [
      "Rocky Buffet is het restaurant dat zich aanpast aan alle wensen, of u nu met z'n tweeën, met het gezin of met vrienden komt! Rocky Buffet is een van de drie restaurants van het RockyPop Flaine Hotel & Spa."
    ],
    "es": [
      "Rocky Buffet es el restaurante para todos los gustos, ya venga en pareja, en familia o con amigos Rocky Buffet es uno de los tres restaurantes del RockyPop Flaine Hotel & Spa."
    ]
  },
