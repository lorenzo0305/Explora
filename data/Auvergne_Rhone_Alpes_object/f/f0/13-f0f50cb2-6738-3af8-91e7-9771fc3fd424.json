  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant am Südhang des Dorfes, 300 m von der Gondelbahn Super-Morzine nach Avoriaz entfernt und in der Nähe von Geschäften, Aktivitäten, Sportpark und Ausgangspunkt für Wanderungen."
    ],
    "en": [
      "Hotel with restaurant situated at Les Bois Venants, south side of Morzine at 200m from the Super-Morzine skilifts and Avoriaz, near the shops, activities, sport hall and start of the walks."
    ],
    "it": [
      "Hotel-ristorante situato sul lato sud del villaggio, a 300 m dalla funivia Super-Morzine per Avoriaz e vicino a negozi, attività, parco sportivo e alla partenza di passeggiate."
    ],
    "fr": [
      "Hôtel-restaurant situé , versant sud du village à 300 m de la Télécabine de Super-Morzine reliant Avoriaz et à proximité des commerces, activités , parc des sports et départ des balades."
    ],
    "es": [
      "Hotel-restaurante situado en el lado sur del pueblo, a 300 m del teleférico de Super-Morzine a Avoriaz y cerca de los comercios, las actividades, el parque deportivo y el inicio de las caminatas."
    ],
    "nl": [
      "Hotel-restaurant op de zuidhelling van het dorp, op 300 m van de kabelbaan Super-Morzine naar Avoriaz en in de buurt van winkels, activiteiten, sportpark en vertrekpunt voor wandelingen."
    ]
