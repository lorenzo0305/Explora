  "rdfs:comment": {
    "de": [
      "Alle Weinberge sind nach Süden ausgerichtet. Sylvain arbeitet allein auf einer Fläche von 5 Hektar und verfolgt sein Produkt von der Rebe bis zur Vermarktung. Zahlreiche Auszeichnungen für die Qualität der Weine"
    ],
    "en": [
      "All the vines are south-facing. Sylvain works alone, on a 5-hectare plot, and oversees his product from vineyard to market. Numerous awards for the quality of our wines"
    ],
    "it": [
      "Tutte le viti sono esposte a sud. Sylvain lavora da solo, su una superficie di 5 ettari e segue il suo prodotto dalla vite alla commercializzazione. Numerosi premi per la qualità dei vini"
    ],
    "fr": [
      "Toutes les vignes sont exposées plein sud. Sylvain travaille seul, sur une surface de 5 hectares et il suit son produit de la vigne à sa commercialisation. Nombreuses récompenses pour la qualité des vins"
    ],
    "es": [
      "Todas las viñas están orientadas al sur. Sylvain trabaja solo, en una superficie de 5 hectáreas y sigue su producto desde la vid hasta su comercialización. Numerosos premios a la calidad de los vinos"
    ],
    "nl": [
      "Alle wijnstokken liggen op het zuiden. Sylvain werkt alleen, op een oppervlakte van 5 hectare en hij volgt zijn product van de wijnstok tot de verkoop. Talrijke onderscheidingen voor de kwaliteit van de wijnen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Caveau Bois Sylvain"
    ]
  },
