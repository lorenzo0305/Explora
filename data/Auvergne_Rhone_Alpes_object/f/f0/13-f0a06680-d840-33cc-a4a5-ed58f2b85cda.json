  "rdfs:comment": {
    "de": [
      "Lust, über das Wasser zu gleiten?\r\nJibe\"- und \"Fun\"-Liebhaber sind auf diesem dritten See, einem der besten Spots der Haute-Savoie für Windsurfer und Wingfoiler, herzlich willkommen."
    ],
    "en": [
      "Want to slide on the water?\r\nNotice to lovers of \"jibe\" and \"fun\" who are welcome on this 3rd lake, one of the best spots in Haute-Savoie for windsurfers and wingfoiler."
    ],
    "it": [
      "Vuoi scivolare sull'acqua?\r\nAvviso agli amanti della \"strambata\" e del \"divertimento\" che sono i benvenuti su questo terzo lago, uno dei migliori spot dell'Alta Savoia per i windsurfisti e wingfoiler."
    ],
    "fr": [
      "Envie de glisser sur l'eau ?\r\nAvis aux amateurs de\" jibe\" et de \"fun\" qui sont les bienvenus sur ce 3ème lac, l'un des meilleurs spots de la Haute-Savoie pour les véliplanchistes et wingfoiler."
    ],
    "es": [
      "¿Te apetece deslizarte por el agua?\r\nEste 3er lago, uno de los mejores lugares de la Alta Saboya para los windsurfistas y los wingfoilers, es el lugar ideal para los amantes de la trasluchada y la diversión."
    ],
    "nl": [
      "Zin om over het water te glijden?\r\nDit 3e meer, een van de beste plekken in de Haute-Savoie voor windsurfers en wingfoilers, is de place to be voor liefhebbers van gijp en plezier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lac de planche à voile des Ilettes"
    ]
  },
