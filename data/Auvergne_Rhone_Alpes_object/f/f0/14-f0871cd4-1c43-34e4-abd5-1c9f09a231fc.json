  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/54e093b2-8057-3833-b43a-4af941740953",
      "dc:description": {
        "de": [
          "Entdecken Sie den Museumspark in Begleitung des Pays d'art et histoire de Lens-Liévin: Eine diktierte Zeichnung, die für alle, ob groß oder klein, geeignet ist, führt Sie zu einer geheimnisvollen Landschaft. Können Sie sie finden?"
        ],
        "en": [
          "Explore the museum grounds with the Pays d?art et histoire de Lens-Liévin: a dictated drawing, suitable for all ages, will lead you to a mysterious landscape. Can you find it?"
        ],
        "it": [
          "Partite alla scoperta del parco del museo, in compagnia del Pays d'art et histoire de Lens-Liévin: un disegno dettato, adatto a tutte le età, vi condurrà in un paesaggio misterioso. Riuscirete a trovarlo?"
        ],
        "fr": [
          "Partez à la découverte du parc du musée, en compagnie du Pays d’art et histoire de Lens-Liévin : un dessin dicté, adapté à tous, petits et grands, vous mènera vers un mystérieux paysage. Saurez-vous le trouver ?"
        ],
        "es": [
          "Salga a descubrir el recinto del museo, en compañía del Pays d'art et histoire de Lens-Liévin: un dibujo dictado, apto para todas las edades, le conducirá a un paisaje misterioso. ¿Podrás encontrarlo?"
        ],
        "nl": [
          "Ontdek het museumterrein in gezelschap van het Pays d'art et histoire de Lens-Liévin: een gedicteerde tekening, geschikt voor alle leeftijden, leidt je naar een mysterieus landschap. Kun jij het vinden?"
        ]
      },
