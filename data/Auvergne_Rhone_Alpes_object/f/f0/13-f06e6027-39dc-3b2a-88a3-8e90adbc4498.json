  "rdfs:comment": {
    "de": [
      "La Vie est Belle bietet Ihnen eine Kollektion von Damenbekleidung in kleinen und großen Größen, Kinderbekleidung und Accessoires. Zögern Sie nicht, mich in der Boutique zu besuchen und mich um Rat zu fragen, ich werde mich gerne um Sie kümmern."
    ],
    "en": [
      "La Vie est Belle offers a collection of women's clothing in large and small sizes, children's ready-to-wear and accessories. Don't hesitate to visit my boutique and ask me for advice, I'll be happy to take care of you."
    ],
    "it": [
      "La Vie est Belle offre una collezione di abbigliamento femminile per taglie piccole e grandi, abbigliamento per bambini e accessori. Non esitate a venirmi a trovare in negozio e a chiedermi consigli, sarò felice di prendermi cura di voi."
    ],
    "fr": [
      "La Vie est Belle vous propose une collection de vêtements pour femme petite et grande taille, prêt-à-porter enfant et accessoires. N'hésitez pas à me rendre visite à la boutique et me demander des conseils, je me ferai un plaisir de m'occuper de vous."
    ],
    "es": [
      "La Vie est Belle te ofrece una colección de ropa de mujer para tallas pequeñas y grandes, ropa para niños y accesorios. No dudes en visitarme en la tienda y pedirme consejo, estaré encantado de atenderte."
    ],
    "nl": [
      "La Vie est Belle biedt een collectie dameskleding in kleine en grote maten, kinderkleding en accessoires. Kom gerust eens langs in mijn boetiek en vraag me om advies, ik sta je graag te woord."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Vie est belle"
    ]
  },
