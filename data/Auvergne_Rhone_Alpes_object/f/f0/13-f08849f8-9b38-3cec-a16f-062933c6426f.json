  "rdfs:comment": {
    "de": [
      "Kommen Sie und necken Sie die wunderschönen Regenbogenforellen aus dem Arc-Stausee. Es gibt noch drei weitere kleine Seen in der Umgebung, die mit Arc und im Marlouz mit Fario gefüllt sind."
    ],
    "en": [
      "Come and tease the magnificent rainbow trout of the Arc reservoir. Three other small lakes are also present around, filled with arc, and fario for the Marlouz."
    ],
    "it": [
      "Venite a stuzzicare le magnifiche trote iridee nel lago artificiale di Arc. Intorno sono presenti anche altri tre piccoli laghi, pieni di arco e fario per i Marlouz."
    ],
    "fr": [
      "Venez taquiner les magnifiques truites arc-en-ciel de la retenue de l'Arc. Trois autres petits lacs sont également présents autour, remplis d'arc, et de fario pour le Marlouz."
    ],
    "es": [
      "Venga a molestar a las magníficas truchas arco iris del embalse de Arc. Otros tres pequeños lagos también están presentes alrededor, llenos de arco, y fario para el Marlouz."
    ],
    "nl": [
      "Kom en plaag de prachtige regenboogforellen in het Arc reservoir. Er zijn ook drie andere kleine meren in de buurt, gevuld met boog, en fario voor de Marlouz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La retenue de l’Arc et ses lacs"
    ]
  },
