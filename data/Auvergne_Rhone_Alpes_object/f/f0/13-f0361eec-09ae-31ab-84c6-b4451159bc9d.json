  "rdfs:comment": {
    "de": [
      "Für den etwas geübteren Radfahrer ist die Tour du Léman die Belohnung für einige Anstrengungen mit dem Anblick von Orten von überwältigender Schönheit. Die hier vorgestellte Strecke befindet sich auf der Seite der Hochsavoyen. Die gesamte Tour ist 200 km lang."
    ],
    "en": [
      "For the more seasoned cyclist, the Tour du Léman is the reward for a little effort, with the spectacle of breathtakingly beautiful scenery. The route presented is on the Haute-Savoie section. The complete tour is 200 km long."
    ],
    "it": [
      "Per i ciclisti più esperti, il Tour du Léman è la ricompensa per alcuni sforzi con lo spettacolo di siti di impressionante bellezza. L'itinerario presentato si trova nella parte dell'Alta Savoia. Il tour completo è lungo 200 km."
    ],
    "fr": [
      "Pour le cyclotouriste un peu aguerri, le Tour du Léman, c'est la récompense de quelques efforts par le spectacle de sites d'une beauté saisissante. Le tracé présenté est situé sur la partie haut-savoyarde. Le tour complet étant de 200 km."
    ],
    "nl": [
      "Voor de meer doorgewinterde fietser is de Tour du Léman de beloning voor een beetje inspanning, met het spektakel van adembenemend mooie landschappen. De gepresenteerde route gaat over de Haute-Savoie. De volledige tocht is 200 km lang."
    ],
    "es": [
      "Para los ciclistas más experimentados, el Tour du Léman es la recompensa a unos cuantos esfuerzos con el espectáculo de lugares de impactante belleza. La ruta presentada se encuentra en la parte de la Alta Saboya. El recorrido completo es de 200 km."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tour du Léman"
    ],
    "fr": [
      "Tour du Léman"
    ],
    "nl": [
      "Rondleiding door het meer van Genève"
    ]
  },
