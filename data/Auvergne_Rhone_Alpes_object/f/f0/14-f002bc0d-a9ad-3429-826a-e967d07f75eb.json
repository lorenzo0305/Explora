      "dc:description": {
        "de": [
          "Im Rahmen der Europäischen Tage des Kulturerbes: Spaziergang zum Kulturerbe!\nAbfahrt 14 Uhr nach Verchin, seinem verdrehten Glockenturm und seinem Pfarrhaus"
        ],
        "en": [
          "As part of the European Heritage Days: heritage walk!\n2pm departure for Verchin, its twisted bell tower and presbytery"
        ],
        "it": [
          "Nell'ambito delle Giornate europee del patrimonio: passeggiata nel patrimonio!\nOre 14:00 partenza per Verchin, il suo campanile contorto e il presbiterio"
        ],
        "fr": [
          "Dans le cadre des Journées Européennes du Patrimoine : balade patrimoine !\nDépart 14h pour Verchin, son clocher tors et son presbytère"
        ],
        "nl": [
          "In het kader van de Europese Erfgoeddagen: erfgoedwandeling!\n14u vertrek naar Verchin, zijn gedraaide klokkentoren en pastorie"
        ],
        "es": [
          "En el marco de las Jornadas Europeas del Patrimonio: ¡paseo por el patrimonio!\n14:00 Salida hacia Verchin, su campanario retorcido y su presbiterio"
        ]
