  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fb8bf8eb-2aac-3045-82f6-a69baeaf089d",
      "dc:description": {
        "de": [
          "einkaufsservice \"Drive\": Lieferung nach Hause, Einräumen...\nkleine Reparaturen: Sanitäranlagen, Elektrizität\ndekoration: Entwurf, Homestaging, Ausführung\nregelmäßige Besuche bei längeren Schließungen\nankunft und Ende des Aufenthalts für Ihre Mieter...- Empfang und Betreuung der saisonalen Vermietungen der Immobilie in Ihrer Abwesenheit"
        ],
        "en": [
          "drive\" shopping service: home delivery, storage...\nminor repairs: plumbing, electricity\ndecoration: design, homestaging, realization\nperiodic visits in the event of prolonged closure\narrival and end of stay for your tenants...- reception and follow-up of seasonal rentals of the property in your absence"
        ],
        "it": [
          "servizio di spesa \"drive\": consegna a domicilio, riordino...\npiccole riparazioni: idraulica, elettricità\ndecorazione: progettazione, homestaging, realizzazione\nvisite periodiche in caso di chiusura prolungata\narrivo e fine soggiorno dei vostri inquilini... - accoglienza e monitoraggio degli affitti stagionali dell'immobile in vostra assenza"
        ],
        "fr": [
          "service courses \" drive\" : livraison chez vous, rangement...\npetites réparations : plomberie, électricité\ndéco : conception, homestaging, réalisation\nvisites périodiques en cas de fermeture prolongée\narrivée et fin de séjour pour vos locataires...- Accueil et suivi des locations saisonnières du bien en votre absence"
        ],
        "es": [
          "servicio de compras \"drive\": entrega a domicilio, arreglo...\npequeñas reparaciones: fontanería, electricidad\ndecoración: diseño, homestaging, puesta en marcha\nvisitas periódicas en caso de cierre prolongado\nllegada y fin de estancia de sus inquilinos... - recepción y seguimiento de los alquileres de temporada de la vivienda en su ausencia"
        ],
        "nl": [
          "drive\" boodschappendienst: levering aan huis, opruimen...\nkleine reparaties: loodgieterswerk, elektriciteit\ndecoratie: ontwerp, homestaging, uitvoering\nperiodieke bezoeken in geval van langdurige sluiting\naankomst en einde van het verblijf van uw huurders... - ontvangst en opvolging van seizoensverhuur van de woning tijdens uw afwezigheid"
        ]
      },
      "@type": [
        "Description"
      ],
