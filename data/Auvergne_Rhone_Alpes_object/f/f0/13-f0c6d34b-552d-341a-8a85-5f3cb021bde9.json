  "rdfs:comment": {
    "de": [
      "Eine Veranstaltung inmitten der Vulkanlandschaften unserer Region, die für die Qualität ihrer Organisation und ihre freundliche Atmosphäre bekannt ist. Die 6. Ausgabe zieht wieder zahlreiche Begeisterte aus unserer Region und darüber hinaus an."
    ],
    "en": [
      "An event in the heart of our region's volcanic landscapes, renowned for the quality of its organization and its friendly atmosphere. Our 6th edition once again attracts a large number of enthusiasts from our region and beyond."
    ],
    "it": [
      "Un evento nel cuore dei paesaggi vulcanici della nostra regione, rinomato per la qualità dell'organizzazione e l'atmosfera amichevole. La nostra sesta edizione attira ancora una volta un gran numero di appassionati dalla nostra regione e non solo."
    ],
    "fr": [
      "Un évènement au cœur des paysages volcaniques de notre territoire, reconnu pour la qualité de son organisation et son ambiance conviviale. Notre 6e édition attire une nouvelle fois de très nombreux passionnés de notre région et au-delà."
    ],
    "es": [
      "Un acontecimiento en el corazón de los paisajes volcánicos de nuestra región, famoso por la calidad de su organización y su ambiente acogedor. Nuestra 6ª edición atrae una vez más a un gran número de aficionados de nuestra región y de fuera de ella."
    ],
    "nl": [
      "Een evenement in het hart van de vulkaanlandschappen van onze regio, bekend om de kwaliteit van de organisatie en de gezellige sfeer. Onze 6e editie trekt opnieuw een groot aantal liefhebbers uit onze regio en daarbuiten."
    ]
  },
  "rdfs:label": {
