  "rdfs:comment": {
    "de": [
      "Das Team des Fin Gourmet lädt Sie ein, eine großzügige und leckere Küche zu entdecken, die sowohl den Gaumen als auch das Auge erfreut."
    ],
    "en": [
      "The team of the restaurant invite you to discover a savory and gourmet cooking, for both the eyes and palate."
    ],
    "it": [
      "Il team Fin Gourmet vi invita a scoprire una cucina generosa e gourmet, per il piacere delle papille gustative e degli occhi."
    ],
    "fr": [
      "L’équipe du Fin Gourmet vous invite à découvrir une cuisine généreuse et gourmande, pour le plaisir des papilles et des yeux."
    ],
    "nl": [
      "Het team van Fin Gourmet nodigt u uit om een gulle en gastronomische keuken te ontdekken, voor het plezier van de smaakpapillen en de ogen."
    ],
    "es": [
      "El equipo de Fin Gourmet le invita a descubrir una cocina generosa y gourmet, para el placer de las papilas gustativas y de la vista."
    ]
  },
