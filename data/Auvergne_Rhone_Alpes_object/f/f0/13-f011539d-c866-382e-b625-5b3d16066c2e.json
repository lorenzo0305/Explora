  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Restaurant, das eine hochwertige traditionelle Küche anbietet.\r\nDas Menü besteht aus einem Vorspeisenbuffet nach Wunsch, dem Tagesgericht, einem Dessert und einem Kaffee."
    ],
    "en": [
      "Come and discover this restaurant offering traditional quality cuisine.\nMenu includes an all-you-can-eat starter buffet, dish of the day, dessert and coffee."
    ],
    "it": [
      "Venite a scoprire questo ristorante che propone una cucina tradizionale e di qualità.\r\nIl menu comprende un buffet di antipasti, il piatto del giorno, il dessert e il caffè."
    ],
    "fr": [
      "Venez découvrir ce restaurant qui propose une cuisine traditionnelle de qualité.\r\nMenu composé d'un buffet d'entrées à volonté, du plat du jour, d'un dessert et d'un café."
    ],
    "nl": [
      "Kom en ontdek dit restaurant dat traditionele gerechten van hoge kwaliteit serveert.\r\nOp het menu staat een all-you-can-eat buffet met voorgerechten, de dagschotel, dessert en koffie."
    ],
    "es": [
      "Descubra este restaurante de cocina tradicional y de calidad.\r\nEl menú incluye un bufé libre de entrantes, plato del día, postre y café."
    ]
  },
