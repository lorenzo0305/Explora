  "rdfs:comment": {
    "de": [
      "Willkommen bei Cycles Amc7, dem Fahrradspezialisten in der Ardèche. Das ganze Jahr über ein leidenschaftliches Team, das Ihnen zur Verfügung steht, um Sie zu bedienen und zu beraten."
    ],
    "en": [
      "The bike specialist in Ardeche.\r\nRental, sale and bicycle repair. \r\nAccessory and equipment store for cyclists."
    ],
    "it": [
      "Benvenuti su Cycles Amc7, lo specialista del ciclismo in Ardèche. Tutto l'anno un team appassionato, disponibile a servirvi e consigliarvi."
    ],
    "fr": [
      "Bienvenue chez Cycles Amc7, le spécialiste du vélo en Ardèche. Toute l'année une équipe passionnée, disponible pour vous servir et vous conseiller."
    ],
    "nl": [
      "Welkom bij Cycles Amc7, de fietsspecialist in de Ardèche. Het hele jaar door een gepassioneerd team, beschikbaar om u te dienen en te adviseren."
    ],
    "es": [
      "Bienvenido a Cycles Amc7, el especialista del ciclismo en Ardèche. Todo el año un equipo apasionado, disponible para servirle y aconsejarle."
    ]
  },
