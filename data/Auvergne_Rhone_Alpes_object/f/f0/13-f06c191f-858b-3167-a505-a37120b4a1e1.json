  "rdfs:comment": {
    "de": [
      "Gehen Sie zum Eingang des Parc du Puits Couriot / Musée de la Mine und entdecken Sie den Konzertsaal Le Clapier, einen Ort des Teilens und Feierns im Herzen von Saint-Étienne."
    ],
    "en": [
      "Meet us at the entrance to the Parc du Puits Couriot / Musée de la Mine to discover the Le Clapier concert hall, a place for sharing and celebrating in the heart of Saint-Étienne."
    ],
    "it": [
      "Incontriamoci all'ingresso del Parc du Puits Couriot / Musée de la Mine per scoprire la sala concerti Le Clapier, un luogo di condivisione e di festa nel cuore di Saint-Étienne."
    ],
    "fr": [
      "Rendez-vous à l'entrée du Parc du Puits Couriot / Musée de la Mine pour découvrir la salle de concert Le Clapier, lieu de partage et de fête au cœur de Saint-Étienne."
    ],
    "nl": [
      "Ontmoet ons bij de ingang van het Parc du Puits Couriot / Musée de la Mine om de concertzaal Le Clapier te ontdekken, een plek om te delen en te vieren in het hart van Saint-Étienne."
    ],
    "es": [
      "Nos vemos en la entrada del Parc du Puits Couriot / Musée de la Mine para descubrir la sala de conciertos Le Clapier, un lugar para compartir y celebrar en el corazón de Saint-Étienne."
    ]
  },
  "rdfs:label": {
