  "rdfs:comment": {
    "de": [
      "Galerie: Verschiedene Ausstellungen von Gemälden, Skulpturen und Fotografien, Vernissagen und Auftritte von Künstlern.\nAtelier: Gruppenkurse von 1 bis 4 Tagen, alle Niveaus, verschiedene Techniken mit anerkannten Künstlern (Unterbringung vor Ort möglich)"
    ],
    "en": [
      "Gallery: Various exhibitions of paintings, sculptures and photographs, vernissages and artist performances.\nWorkshop: Group courses from 1 to 4 days, all levels, different techniques, with recognized artists (accommodation available on site)"
    ],
    "it": [
      "Galleria: varie mostre di pittura, scultura e fotografia, vernissage e performance di artisti.\nWorkshop: corsi di gruppo da 1 a 4 giorni, a tutti i livelli, con tecniche diverse, con artisti riconosciuti (alloggio disponibile in loco)"
    ],
    "fr": [
      "Galerie : Expositions diverses de peintures, sculptures et photographies…, vernissages et performances d’artistes. \nAtelier : Stages de groupe de 1 à 4 jours, tout niveau, différentes techniques avec artistes reconnus (hébergement possible sur place)"
    ],
    "nl": [
      "Galerie: Verschillende tentoonstellingen van schilderijen, beeldhouwwerken en foto's, vernissages en optredens van kunstenaars.\nWorkshop: Groepscursussen van 1 tot 4 dagen, alle niveaus, verschillende technieken, met erkende kunstenaars (accommodatie ter plaatse beschikbaar)"
    ],
    "es": [
      "Galería: Exposiciones variadas de pintura, escultura y fotografía, vernissages y actuaciones de artistas.\nTaller: Cursos colectivos de 1 a 4 días, todos los niveles, diferentes técnicas, con artistas reconocidos (alojamiento disponible in situ)"
    ]
