  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/28913f5c-0db8-3c2e-bb83-8e8521f7399e",
      "dc:description": {
        "de": [
          "Geführte Tour \"DIE FUNERALE DEKORATION UND IHRE SYMBOLIK AUF DEM CIMETIERE SAINT-PIERRE\" (\"Die Grabdekoration und ihre Symbolik auf dem Friedhof St. Peter\")\n\nSchlendern Sie durch den Friedhof der Seeleute und entdecken Sie die Gräber und ihre Grabsymbolik\n\nRV vor dem Friedhofseingang, rue de la Flotille\n\nUhrzeit: 15 Uhr (Dauer:1,5 Stunden)\n-\tMontag, 20. Oktober\n-\tDienstag, 28. Oktober"
        ],
        "en": [
          "Guided tour \"THE FUNERAL DECOR AND ITS SYMBOLIC AT SAINT-PIERRE CEMETERY\"\n\nTake a stroll through the sailors' cemetery to discover the tombs and their funerary symbolism\n\nMeeting point in front of the cemetery entrance, rue de la Flotille\n\nTime: 3 pm (duration: 1h30)\n-\tMonday, October 20th\n-\tTuesday, october 28"
        ],
        "it": [
          "Visita guidata \"LA DECORAZIONE FUNERARIA E LA SUA SIMBOLICA NEL CIMITERO DI SAINT-PIERRE\"\n\nPasseggiata nel cimitero dei marinai alla scoperta delle tombe e del loro simbolismo funerario\n\nPunto d'incontro davanti all'ingresso del cimitero, in rue de la Flotille\n\nOra: 15.00 (durata: 1 ora)\n-\tLunedì 20 ottobre\n-\tMartedì 28 ottobre"
        ],
        "fr": [
          "Visite guidée « LE DECOR FUNERAIRE ET SA SYMBOLIQUE AU CIMETIERE SAINT-PIERRE »\n\nDéambulez dans le cimetière des marins à la découverte de tombes et leur symbolique funéraire\n\nRV devant l’entrée du cimetière, rue de la Flotille\n\nHoraire : 15 h (durée :1h30)\n-\tLundi 20 octobre\n-\tMardi 28 octobre"
        ],
        "es": [
          "Visita guiada \"LA DECORACIÓN FUNERARIA Y SU SIMBOLOGÍA EN EL CEMENTERIO DE SAINT-PIERRE\"\n\nPasee por el cementerio de los marineros para descubrir las tumbas y su simbología funeraria\n\nPunto de encuentro frente a la entrada del cementerio, rue de la Flotille\n\nHora: 15:00 (duración: hora y media)\n-\tLunes 20 de octubre\n-\tMartes 28 de octubre"
        ],
        "nl": [
          "Rondleiding \"DE FUNERAL DECORATION AND ITS SYMBOLIC AT SAINT-PIERRE CEMETERY\"\n\nMaak een wandeling over het zeemanskerkhof en ontdek de graven en hun funeraire symboliek\n\nTrefpunt voor de ingang van het kerkhof, rue de la Flotille\n\nTijd: 15.00 uur (duur: 1 uur)\n-\tMaandag 20 oktober\n-\tDinsdag 28 oktober"
        ]
      },
