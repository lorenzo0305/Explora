  "rdfs:comment": {
    "de": [
      "Modernes traditionelles Restaurant, das eine raffinierte Küche mit einem super Preis-Leistungs-Verhältnis anbietet.\r\nDie Küche ist zu 100 % hausgemacht und besteht aus frischen Produkten der Saison.\r\nFür die Abende haben wir auch einen Lounge-Bereich ."
    ],
    "en": [
      "Traditional modern restaurant offering refined cuisine at great value for money.\r\n100% home-cooked cuisine using fresh seasonal produce.\r\nWe also offer an evening lounge area."
    ],
    "it": [
      "Ristorante tradizionale e moderno che offre una cucina raffinata con un ottimo rapporto qualità-prezzo.\r\nLa cucina è fatta al 100% in casa con prodotti freschi di stagione.\r\nAbbiamo anche un'area lounge per le serate."
    ],
    "fr": [
      "Restaurant traditionnel moderne proposant une cuisine raffinée avec un super rapport qualité prix.\r\nUne cuisine 100 % faite maison avec des produits frais de saison.\r\nNous avons également pour les soirs un espace Lounge ."
    ],
    "nl": [
      "Traditioneel modern restaurant met een verfijnde keuken met een goede prijs-kwaliteitverhouding.\r\nDe keuken is 100% huisgemaakt met verse seizoensproducten.\r\nWe hebben ook een loungeruimte voor 's avonds."
    ],
    "es": [
      "Restaurante tradicional y moderno que ofrece una cocina refinada con una excelente relación calidad-precio.\r\nLa cocina es 100% casera con productos frescos de temporada.\r\nTambién disponemos de un salón para las veladas."
    ]
  },
