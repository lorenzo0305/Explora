  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2743e2d4-b387-3527-a917-ee9ab44f47a0",
      "dc:description": {
        "de": [
          "Diesen Donnerstag, den 20. Juli :\nÜberwinden Sie Ihre Grenzen unabhängig von Ihrem Niveau beim Biking - Radfahrkurs mit Musik - Anmeldung erforderlich (Office de Tourisme)\nTourisme) - Begrenzte Plätze - Ab 16 Jahren mit elterlicher Erlaubnis - Treffpunkt auf der Esplanade de Sainte Cécile um 18 Uhr - Kostenlos"
        ],
        "en": [
          "This Thursday, July 20 :\nCome and exceed your limits whatever your level at the Biking session - Cycling lessons with music - Registration essential (Office de Tourisme) - Places limited\nTourist Office) - Places are limited - For those aged 16 and over with parental consent - Meeting point on the Sainte Cécile esplanade at 6pm - Free of charge"
        ],
        "it": [
          "Questo giovedì 20 luglio:\nVenite a superare i vostri limiti, qualunque sia il vostro livello, alla sessione di ciclismo - Lezioni di ciclismo con musica - Iscrizione indispensabile (Ufficio del Turismo) - I posti sono limitati\nUfficio del Turismo) - I posti sono limitati - Maggiori di 16 anni con autorizzazione dei genitori - Punto d'incontro sulla spianata di Sainte Cécile alle 18.00 - Gratuito"
        ],
        "fr": [
          "Ce jeudi 20 juillet :\nVenez dépasser vos limites quel que soit votre niveau à la séance de Biking - Cours de cyclisme tout en musique - Inscription indispensable (Office de\nTourisme) - Places limitées - A partir de 16 ans avec autorisation parentale - RDV sur l’esplanade de Sainte Cécile à 18h - Gratuit"
        ],
        "es": [
          "Este jueves 20 de julio :\nVenga a superar sus límites, sea cual sea su nivel, en la sesión Biking - Clases de ciclismo con música - Inscripción obligatoria (Oficina de Turismo) - Plazas limitadas\nOficina de Turismo) - Plazas limitadas - A partir de 16 años con autorización paterna - Punto de encuentro en la explanada Sainte Cécile a las 18.00 h - Gratuito"
        ],
        "nl": [
          "Deze donderdag 20 juli :\nKom je grenzen verleggen, ongeacht je niveau, tijdens de fietssessie - Fietslessen met muziek - Inschrijven noodzakelijk (Dienst voor Toerisme) - Plaatsen zijn beperkt\nDe plaatsen zijn beperkt - 16 jaar en ouder met toestemming van de ouders - Trefpunt op de esplanade Sainte Cécile om 18.00 uur - Gratis"
        ]
      },
