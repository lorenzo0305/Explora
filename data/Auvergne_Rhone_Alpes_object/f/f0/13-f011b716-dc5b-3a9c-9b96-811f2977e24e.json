  "rdfs:comment": {
    "de": [
      "Im Parc du Cerey gibt es 2 Orientierungsparcours für die breite Öffentlichkeit :\r\n- 1 blauer Parcours\r\n- 1 grüner Parcours\r\nDie Karten und Korrekturen können auf der Bürgerseite der Gemeinde Riom heruntergeladen werden."
    ],
    "en": [
      "Parc du Cerey has 2 orienteering courses for the general public:\r\n- 1 blue course\r\n- 1 green course\r\nMaps and corrections can be downloaded from the Commune de Riom's citizen's area."
    ],
    "it": [
      "Il Parc du Cerey dispone di 2 percorsi di orientamento per il pubblico:\r\n- 1 percorso blu\r\n- 1 percorso verde\r\nLe mappe e le correzioni possono essere scaricate dall'area cittadini di Riom."
    ],
    "fr": [
      "Le Parc du Cerey dispose de 2 parcours d'orientation pour le grand public : \r\n- 1 parcours bleu\r\n- 1 parcours vert\r\nLes cartes et corrections sont à télécharger sur l'espace citoyens de la Commune de Riom."
    ],
    "nl": [
      "Het Parc du Cerey heeft 2 oriëntatieparcours voor het grote publiek:\r\n- 1 blauw parcours\r\n- 1 groen parcours\r\nKaarten en correcties kunnen worden gedownload in de burgerzone van Riom."
    ],
    "es": [
      "El Parc du Cerey dispone de 2 recorridos de orientación para el público en general:\r\n- 1 recorrido azul\r\n- 1 recorrido verde\r\nLos mapas y las correcciones pueden descargarse de la zona ciudadana de Riom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation au Cerey - Parcours Bleu"
    ]
  },
