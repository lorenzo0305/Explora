  "rdfs:comment": {
    "de": [
      "Angehende Ermittler, dieses Spiel auf der Via Fluvia ist genau das Richtige für Sie!\r\n17 km lange Radtour zwischen Bourg-Argental und Saint-Sauveur-en-Rue oder 4,5 km lange Fußtour in Bourg-Argental."
    ],
    "en": [
      "Aspiring investigators, this Via Fluvia game is for you!\r\n17km bike tour between Bourg-Argental and Saint-Sauveur-en-Rue or 4.5km walking tour in Bourg-Argental."
    ],
    "it": [
      "Aspiranti investigatori, questo gioco sulla Via Fluvia è per voi!\r\nUn percorso ciclabile di 17 km tra Bourg-Argental e Saint-Sauveur-en-Rue o un percorso a piedi di 4,5 km a Bourg-Argental."
    ],
    "fr": [
      "Enquêteurs en herbe, ce jeu sur la Via Fluvia est fait pour vous ! \r\nCircuit vélo de 17 km entre Bourg-Argental et Saint-Sauveur-en-Rue ou circuit à pied de 4,5km à Bourg-Argental."
    ],
    "es": [
      "Aspirantes a investigadores, ¡este juego de la Vía Fluvia es para vosotros!\r\nUna ruta ciclista de 17 km entre Bourg-Argental y Saint-Sauveur-en-Rue o una ruta a pie de 4,5 km en Bourg-Argental."
    ],
    "nl": [
      "Aspirant-speurders, dit spel op de Via Fluvia is voor jou!\r\nEen 17 km lang fietspad tussen Bourg-Argental en Saint-Sauveur-en-Rue of een 4,5 km lang wandelpad in Bourg-Argental."
    ]
  },
  "rdfs:label": {
