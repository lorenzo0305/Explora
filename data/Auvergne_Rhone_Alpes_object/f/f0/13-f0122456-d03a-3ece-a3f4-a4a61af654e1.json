  "rdfs:comment": {
    "de": [
      "Dieses legendäre Stück, das 1985 von Jacqueline Maillan gespielt wurde, kehrt in einer überarbeiteten und modernen Version zurück, um eine neue Generation von Zuschauern zu begeistern."
    ],
    "en": [
      "This legendary play, performed by Jacqueline Maillan in 1985, returns in a revisited, modern version, to enchant a new generation of spectators."
    ],
    "it": [
      "Questa opera leggendaria, interpretata da Jacqueline Maillan nel 1985, torna in una versione rivisitata e moderna per deliziare una nuova generazione di spettatori."
    ],
    "fr": [
      "Cette pièce mythique, jouée par Jacqueline Maillan en 1985, revient dans une version revisitée et moderne, pour enchanter une nouvelle génération de spectateurs."
    ],
    "es": [
      "Esta obra legendaria, representada por Jacqueline Maillan en 1985, vuelve en una versión revisitada y moderna para deleitar a una nueva generación de espectadores."
    ],
    "nl": [
      "Dit legendarische toneelstuk, dat Jacqueline Maillan in 1985 opvoerde, is terug in een herziene, moderne versie om een nieuwe generatie theaterbezoekers te verrukken."
    ]
  },
