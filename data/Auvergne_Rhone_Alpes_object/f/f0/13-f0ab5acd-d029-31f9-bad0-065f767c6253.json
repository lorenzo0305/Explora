  "rdfs:comment": {
    "de": [
      "Für einen Moment der Entspannung, im Herzen von Chambon-sur-Lignon, entdecken Sie die Fußreflexzonenmassage, die manuelle Lymphdrainage und die Massagen, ohne das Hammam zu vergessen."
    ],
    "en": [
      "For a moment of relaxation, in the heart of Chambon-sur-Lignon, discover foot reflexology, manual lymphatic drainage and massages without forgetting the hammam."
    ],
    "it": [
      "Per un momento di relax, nel cuore di Le Chambon-sur-Lignon, scoprite la riflessologia plantare, il linfodrenaggio manuale e i massaggi, senza dimenticare l'hammam."
    ],
    "fr": [
      "Pour un instant de détente, en plein coeur du Chambon-sur-Lignon, découvrez , la réflexologie plantaire, le drainage manuel lymphatique  et les massages sans oublier le hammam."
    ],
    "nl": [
      "Voor een moment van ontspanning, in het hart van Le Chambon-sur-Lignon, ontdek voetreflexologie, manuele lymfedrainage en massages zonder de hammam te vergeten."
    ],
    "es": [
      "Para un momento de relajación, en el corazón de Le Chambon-sur-Lignon, descubra la reflexología podal, el drenaje linfático manual y los masajes sin olvidar el hammam."
    ]
  },
  "rdfs:label": {
