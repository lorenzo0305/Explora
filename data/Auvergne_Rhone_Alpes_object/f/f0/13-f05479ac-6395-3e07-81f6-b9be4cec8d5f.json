  "rdfs:comment": {
    "de": [
      "Im Herzen der Drôme haben Pierre und Margaux ein kleines Familienunternehmen mit dem Ziel gegründet, einen hochwertigen Pastis herzustellen und zu vermarkten: Le Pierrot."
    ],
    "en": [
      "In the middle of the Drôme region, Pierre and Margaux set up a small family business to produce and sell Le Pierrot, a quality pastis."
    ],
    "it": [
      "Nel cuore della Drôme, Pierre e Margaux hanno creato una piccola azienda familiare con l'obiettivo di produrre e commercializzare un pastis di qualità: Le Pierrot."
    ],
    "fr": [
      "Au cœur de la Drôme, Pierre et Margaux ont créé une petite entreprise familiale dans le but de fabriquer et de commercialiser un pastis de qualité : Le Pierrot."
    ],
    "nl": [
      "In het hart van de Drôme hebben Pierre en Margaux een klein familiebedrijf opgericht met als doel een kwaliteitspastis te maken en op de markt te brengen: Le Pierrot."
    ],
    "es": [
      "En el corazón de la Drôme, Pierre y Margaux han creado una pequeña empresa familiar con el objetivo de elaborar y comercializar un pastis de calidad: Le Pierrot."
    ]
  },
  "rdfs:label": {
