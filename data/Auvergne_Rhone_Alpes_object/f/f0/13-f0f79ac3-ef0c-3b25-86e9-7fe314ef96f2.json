  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais durch ein spielerisches und kostenloses Geocaching-Erlebnis! In Brussieu begeben Sie sich auf die Jagd nach öpinell, einem Spezialisten für Know-how. Er und die anderen Gnolus werden Ihnen die Geschichte des Dorfes und der Minen näher bringen..."
    ],
    "en": [
      "Discover the Monts du Lyonnais through a fun and free geocaching experience! In Brussieu, go hunting for öpinell, a specialist in know-how. He and the other Gnolus will make you discover the history of the village and the mines..."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais attraverso un'esperienza di geocaching divertente e gratuita! A Brussieu, andate a caccia di öpinell, uno specialista del know-how. Lui e gli altri Gnolus vi aiuteranno a scoprire la storia del villaggio e delle miniere..."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais à travers une expérience ludique et gratuite de géocaching ! A Brussieu, partez à la chasse d'öpinell, spécialiste des savoir-faire. Lui et les autres Gnolus vous feront découvrir l'histoire du village et des mines..."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais via een leuke en gratis geocaching-ervaring! Ga in Brussieu op jacht naar öpinell, een kennis specialist. Hij en de andere Gnolus zullen je helpen de geschiedenis van het dorp en de mijnen te ontdekken..."
    ],
    "es": [
      "Descubra los Montes del Lyonnais a través de una experiencia de geocaching divertida y gratuita En Brussieu, vaya a la caza de öpinell, un especialista en conocimientos técnicos. Él y los demás Gnolus te ayudarán a descubrir la historia del pueblo y de las minas..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Attention, terrain minier !"
    ]
  },
