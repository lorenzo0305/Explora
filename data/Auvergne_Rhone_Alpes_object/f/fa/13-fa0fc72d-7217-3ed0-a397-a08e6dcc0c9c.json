  "rdfs:comment": {
    "de": [
      "Sie sind auf der Suche nach einem Auftrag oder einer Stelle im Gesundheitssektor oder im medizinisch-sozialen Bereich? Kelyps Medical hilft Ihnen dabei, die richtige Gelegenheit zu finden, die Ihren Fähigkeiten und beruflichen Zielen entspricht."
    ],
    "en": [
      "Are you looking for an assignment or a position in the healthcare or medical-social sector? Kelyps Médical can help you find the opportunity that matches your skills and career aspirations."
    ],
    "it": [
      "Siete alla ricerca di un incarico o di una posizione nel settore sanitario o medico-sociale? Kelyps Médical può aiutarvi a trovare l'opportunità che corrisponde alle vostre competenze e aspirazioni di carriera."
    ],
    "fr": [
      "Vous êtes à la recherche d’une mission ou d’un poste dans le secteur de la santé ou du médico-social ? Kelyps Médical vous aide à trouver l’opportunité qui correspond à vos compétences et à vos aspirations professionnelles."
    ],
    "es": [
      "¿Busca una misión o un puesto en el sector sanitario o médico-social? Kelyps Médical puede ayudarle a encontrar la oportunidad que se ajuste a sus competencias y aspiraciones profesionales."
    ],
    "nl": [
      "Bent u op zoek naar een opdracht of een functie in de gezondheidszorg of de medisch-sociale sector? Kelyps Médical kan u helpen bij het vinden van de mogelijkheid die past bij uw vaardigheden en loopbaanambities."
    ]
  },
  "rdfs:label": {
