  "rdfs:comment": {
    "de": [
      "La Pat' à Marie bietet eine große Auswahl an Pizzen, die mit frischen Zutaten zubereitet werden. Und nicht zu vergessen: die monatlich wechselnde Pizza des Augenblicks!"
    ],
    "en": [
      "La Pat' à Marie offers a wide range of pizzas made with fresh ingredients. And don't forget our monthly pizza of the moment!"
    ],
    "it": [
      "La Pat' à Marie offre una gamma di pizze preparate con ingredienti freschi. E non dimenticate la pizza del momento, che cambia ogni mese!"
    ],
    "fr": [
      "La Pat' à Marie vous suggère une carte de plusieurs pizzas élaborée avec des produits frais. Sans oublier, la pizza du moment qui change chaque mois!"
    ],
    "es": [
      "La Pat' à Marie ofrece una gama de pizzas elaboradas con ingredientes frescos. Y no se olvide de la pizza del momento, ¡que cambia cada mes!"
    ],
    "nl": [
      "La Pat' à Marie biedt een reeks pizza's gemaakt met verse ingrediënten. En vergeet niet de pizza van het moment, die elke maand verandert!"
    ]
  },
