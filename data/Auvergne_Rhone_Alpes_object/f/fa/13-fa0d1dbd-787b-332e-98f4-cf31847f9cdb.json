  "rdfs:comment": {
    "de": [
      "Der Chefkoch Cédric Vaujany, der am Institut Paul Bocuse ausgebildet wurde, entscheidet sich für eine saisonale Küche, die Tradition und Moderne in einem intimen Rahmen miteinander verbindet."
    ],
    "en": [
      "The Chef, Cédric Vaujany, trained at the Institut Paul Bocuse, opts for seasonal cuisine, mixing tradition and modernity in an intimate setting."
    ],
    "it": [
      "Lo chef, Cédric Vaujany, formatosi all'Institut Paul Bocuse, opta per una cucina stagionale, mescolando tradizione e modernità in un ambiente intimo."
    ],
    "fr": [
      "Le Chef, Cédric Vaujany, formé à l’Institut Paul Bocuse, opte pour une cuisine de saison, mêlant tradition et modernité dans un cadre intime."
    ],
    "es": [
      "El Chef, Cédric Vaujany, formado en el Instituto Paul Bocuse, opta por una cocina de temporada, mezclando tradición y modernidad en un ambiente íntimo."
    ],
    "nl": [
      "De chef, Cédric Vaujany, opgeleid aan het Institut Paul Bocuse, kiest voor een seizoensgebonden keuken, waarbij traditie en moderniteit in een intiem kader worden vermengd."
    ]
  },
