  "rdfs:comment": {
    "de": [
      "Als sportliches Aushängeschild von Grenoble lädt Sie dieser 18-Loch-Golfplatz dazu ein, all Ihre Spielqualitäten in einer grandiosen Umgebung von 100 Hektar zwischen bewaldeten Hügeln und kleinen Seen zum Ausdruck zu bringen."
    ],
    "en": [
      "A jewel in Grenoble’s sporting crown, this 18-hole golf course, covering 100 ha of magnificent scenery featuring wooded hills and small lakes, is perfect for testing your golfing skills."
    ],
    "it": [
      "Fiore all'occhiello sportivo di Grenoble, questo campo da golf a 18 buche vi invita a esprimere tutte le vostre qualità di gioco in una cornice grandiosa di 100 ettari tra colline boscose e piccoli laghi."
    ],
    "fr": [
      "Fleuron sportif de Grenoble, ce golf 18 trous vous invite à exprimer toutes vos qualités de jeu dans un cadre grandiose de 100 hectares entre collines boisées et petits lacs."
    ],
    "nl": [
      "Het sportieve vlaggenschip van Grenoble, deze 18-holes golfbaan nodigt u uit om al uw speelkwaliteiten tot uiting te brengen in een grandioze omgeving van 100 hectare tussen beboste heuvels en meertjes."
    ],
    "es": [
      "Buque insignia deportivo de Grenoble, este campo de golf de 18 hoyos le invita a demostrar todas sus habilidades de juego en un imponente entorno de 100 hectáreas de colinas arboladas y pequeños lagos."
    ]
  },
