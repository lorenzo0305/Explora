  "rdfs:comment": {
    "de": [
      "ChaChaCha ist mehr als nur ein Weinkeller, es ist eine echte Wein- und Spirituosenbar: eine erlesene Auswahl an Weinen, Champagner, handwerklich gebrauten Bieren und Spirituosen. Jeder Besuch ist eine Entdeckung."
    ],
    "en": [
      "More than just a cellar, ChaChaCha is a veritable wine & spirits bar, offering a cutting-edge selection of wines, champagnes, craft beers & spirits. Every visit is a discovery."
    ],
    "it": [
      "Più che una semplice cantina, ChaChaCha è un vero e proprio wine and spirits bar che offre una selezione esclusiva di vini, champagne, birre artigianali e liquori. Ogni visita è una scoperta."
    ],
    "fr": [
      "Plus qu’une simple cave, ChaChaCha est un véritable bar à vins & spiritueux : une sélection pointue de vins, champagnes, bières artisanales & spiritueux. Chaque visite est une découverte."
    ],
    "es": [
      "Más que una bodega, ChaChaCha es un auténtico bar de vinos y licores, que ofrece una exclusiva selección de vinos, champanes, cervezas artesanales y licores. Cada visita es un descubrimiento."
    ],
    "nl": [
      "ChaChaCha is meer dan alleen een kelder, het is een echte wijn- en sterke drankbar met een exclusieve selectie wijnen, champagnes, ambachtelijke bieren en sterke dranken. Elk bezoek is een ontdekking."
    ]
  },
  "rdfs:label": {
    "en": [
