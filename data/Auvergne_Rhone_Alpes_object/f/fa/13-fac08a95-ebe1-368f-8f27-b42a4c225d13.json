  "rdfs:comment": {
    "de": [
      "Auf dem Weg nach Santiago de Compostela werden Sie von der außergewöhnlichen Aussicht dieses Ortes überwältigt sein und können auf der Panoramaterrasse des Restaurants zu Mittag essen. Direkter Zugang zum See mit Anlegestelle für Boote oder Tretboote."
    ],
    "en": [
      "On the Way of St. James, you'll be delighted by the exceptional views from this site and you can enjoy lunch on the restaurant's panoramic terrace. Direct access to the lake with pontoon for boats or pedalos."
    ],
    "it": [
      "Lungo il percorso verso Santiago de Compostela, sarete deliziati dalle viste eccezionali di questo sito e potrete pranzare sulla terrazza panoramica del ristorante. Accesso diretto al lago con pontile per barche o pedalò."
    ],
    "fr": [
      "Sur le chemin de Saint-Jacques-de-Compostelle, vous serez comblés par la vue exceptionnelle de ce site et vous pourrez déjeuner sur la terrasse panoramique du restaurant. Accès direct au lac avec ponton pour accueil bateaux ou pédalos."
    ],
    "nl": [
      "Op de route naar Santiago de Compostela zul je verrukt zijn over het uitzonderlijke uitzicht vanaf deze plek en kun je genieten van een lunch op het panoramische terras van het restaurant. Directe toegang tot het meer met ponton voor boten of waterfietsen."
    ],
    "es": [
      "En el camino a Santiago de Compostela, se deleitará con las excepcionales vistas desde este lugar y podrá disfrutar del almuerzo en la terraza panorámica del restaurante. Acceso directo al lago con pontón para barcas o pedales."
    ]
  },
  "rdfs:label": {
