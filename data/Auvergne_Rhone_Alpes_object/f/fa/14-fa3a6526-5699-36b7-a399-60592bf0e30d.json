  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8346fdf3-498f-3235-a4db-ada7eeb437b4",
      "dc:description": {
        "de": [
          "Ein Pariser Haus im Zeichen von Mode, Eleganz und schönen Materialien.\n\nGeöffnet von März bis Januar von Mittwoch bis Sonntag von 10:00 bis 13:00 Uhr und von 15:00 bis 19:00 Uhr.\nIm Juli und August täglich geöffnet."
        ],
        "en": [
          "A Parisian house dedicated to fashion, elegance and beautiful materials.\n\nOpen March to January, Wednesday to Sunday, 10am to 1pm and 3pm to 7pm.\nOpen daily in July and August."
        ],
        "it": [
          "Una casa parigina di moda, eleganza e bei materiali.\n\nAperto da marzo a gennaio, dal mercoledì alla domenica, dalle 10.00 alle 13.00 e dalle 15.00 alle 19.00.\nAperto tutti i giorni in luglio e agosto."
        ],
        "fr": [
          "Une maison parisienne sous le signe de la mode, de l'élégance et de belles matières.\n\nOuvert de mars à janvier du mercredi au dimanche de 10h à 13h et de 15h à 19h.\nOuvert tous les jours en juillet et août."
        ],
        "es": [
          "Una casa parisina de moda, elegancia y bellos materiales.\n\nAbierto de marzo a enero, de miércoles a domingo, de 10.00 a 13.00 y de 15.00 a 19.00 h.\nAbierto todos los días en julio y agosto."
        ],
        "nl": [
          "Een Parijs huis van mode, elegantie en prachtige materialen.\n\nOpen van maart tot januari, van woensdag tot zondag, van 10.00 tot 13.00 uur en van 15.00 tot 19.00 uur.\nIn juli en augustus elke dag geopend."
        ]
      },
