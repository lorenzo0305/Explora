  "rdfs:comment": {
    "de": [
      "Diese Kirche ist dem heiligen Stephanus gewidmet, wie auch die erste Pfarrgemeinde von Gevrier, eine romanische Kirche, die im 12. Jahrhundert gegründet und 1793 zerstört wurde."
    ],
    "en": [
      "This church is dedicated to St. Stephen, like the first parish of Gevrier, a Romanesque church founded in the 12th century and destroyed in 1793."
    ],
    "it": [
      "Questa chiesa è dedicata a Santo Stefano, come la prima parrocchia di Gevrier, una chiesa romanica fondata nel XII secolo e distrutta nel 1793."
    ],
    "fr": [
      "Cette église est dédiée à saint Étienne, comme la première paroisse de Gevrier, une église romane fondée au 12e siècle, et détruite en 1793."
    ],
    "es": [
      "Esta iglesia está dedicada a San Esteban, al igual que la primera parroquia de Gevrier, una iglesia románica fundada en el siglo XII y destruida en 1793."
    ],
    "nl": [
      "Deze kerk is gewijd aan Sint Stefanus, net als de eerste parochie van Gevrier, een romaanse kerk gesticht in de 12e eeuw en verwoest in 1793."
    ]
  },
