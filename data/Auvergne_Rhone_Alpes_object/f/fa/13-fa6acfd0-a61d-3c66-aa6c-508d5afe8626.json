  "rdfs:comment": {
    "de": [
      "Französische und exotische Aromen stehen in diesem Restaurant in der Rue Neuve auf der Speisekarte. Ein Wunsch: ihre Gaumenfreuden und ihre Liebe zur Küche durch die Begegnung zweier Länder, China und Frankreich, zu teilen."
    ],
    "en": [
      "Both French and more far-flung flavours are on the menu of this restaurant in Rue Neuve. Its aim: to share love of good food and cooking by combining the cultures of two countries - China and France."
    ],
    "it": [
      "Sapori francesi ed esotici sono il menù di questo ristorante in rue Neuve. Un unico desiderio: condividere la loro avidità e il loro amore per la cucina attraverso l'incontro di due Paesi, la Cina e la Francia."
    ],
    "fr": [
      "Saveurs françaises et exotiques sont au menu de ce restaurant de la rue Neuve. Une envie : faire partager leur gourmandise et leur amour de la cuisine à travers la rencontre de deux pays, la Chine et la France."
    ],
    "es": [
      "Sabores franceses y exóticos en la carta de este restaurante de la rue Neuve. Un deseo: compartir su codicia y su amor por la cocina a través del encuentro de dos países, China y Francia."
    ],
    "nl": [
      "Franse en exotische smaken staan op het menu van dit restaurant in de Nieuwstraat. Eén wens: hun hebzucht en hun liefde voor koken delen door de ontmoeting tussen twee landen, China en Frankrijk."
    ]
  },
  "rdfs:label": {
    "en": [
      "Table Wei"
    ],
    "fr": [
      "La Table Wei"
    ]
  },
