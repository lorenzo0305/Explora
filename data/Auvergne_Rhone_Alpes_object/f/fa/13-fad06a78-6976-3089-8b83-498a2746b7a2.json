  "rdfs:comment": {
    "de": [
      "Entdecken Sie die wunderschönen Gorges du Chassezac! Lassen Sie sich von den grandiosen Landschaften und den idyllischen Stränden verzaubern. Ob im Verleih oder in Begleitung unserer Lehrer, wir bieten Ihnen eine Erfahrung der Entdeckung und des Tapetenwechsels."
    ],
    "en": [
      "Discover the beautiful Gorges du Chassezac! With 7 and 10km options, the Chassezac will amaze you with its landscapes and idyllic beaches. On a rental basis or with our instructors, we offer a formula that suits your needs of discovery and change of scenery."
    ],
    "it": [
      "Scoprite le magnifiche Gorges du Chassezac! Ammirate i magnifici paesaggi e le spiagge idilliache. Che siate a noleggio o accompagnati da uno dei nostri istruttori, possiamo offrirvi un'esperienza di scoperta e di cambiamento di scenario."
    ],
    "fr": [
      "Découvrez les magnifiques Gorges du Chassezac ! Laissez-vous émerveiller par ses paysages grandioses et ses plages idylliques. En location ou accompagnés de nos moniteurs, nous vous proposons une expérience de découverte et de dépaysement."
    ],
    "nl": [
      "Ontdek de prachtige Gorges du Chassezac! Bewonder het prachtige landschap en de idyllische stranden. Of je nu huurt of begeleid wordt door een van onze instructeurs, wij bieden je een ervaring van ontdekking en verandering van omgeving."
    ],
    "es": [
      "Descubra las magníficas Gargantas del Chassezac Maravíllese con los magníficos paisajes y las idílicas playas. Ya sea en alquiler o acompañado por uno de nuestros monitores, le ofrecemos una experiencia de descubrimiento y cambio de aires."
    ]
  },
  "rdfs:label": {
