  "rdfs:comment": {
    "de": [
      "Die Festung von Opme ist eines der ältesten Schlösser der Auvergne. Die Burg und ihre Gärten sind als historische Monumente klassifiziert."
    ],
    "en": [
      "Château-fort d’Opme is one of the oldest châteaux in Auvergne. The château and gardens are listed on the Historic Monuments registry."
    ],
    "it": [
      "Château-fort d'Opme è uno dei più antichi castelli dell'Alvernia. Il castello e i suoi giardini sono classificati come Monumenti storici"
    ],
    "fr": [
      "Le château-fort d’Opme est l’un des plus anciens châteaux d’Auvergne. Le château et ses jardins sont classés Monuments Historiques"
    ],
    "nl": [
      "Het kasteelfort van Opme is een van de oudste kastelen in de Auvergne. Het kasteel en de tuinen staan op de lijst van historische monumenten."
    ],
    "es": [
      "El castillo-fortaleza de Opme es uno de los más antiguos de Auvernia. El castillo y sus jardines están declarados Monumento Histórico."
