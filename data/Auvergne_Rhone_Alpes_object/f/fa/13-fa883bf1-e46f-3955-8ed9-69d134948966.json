  "rdfs:comment": {
    "de": [
      "Der Grüne Weg verläuft auf etwa 14 Kilometern entlang der Isère zwischen Aime und Bourg Saint Maurice. Er ermöglicht auch den Zugang zum Freizeitzentrum Les Versants d'Aime."
    ],
    "en": [
      "La voie verte runs along the Isère river for about 15 kilometres from Aime to Bourg Saint Maurice. It can also be reached from the leisure centre."
    ],
    "it": [
      "La greenway si snoda lungo l'Isère per circa 14 chilometri, tra Aime e Bourg Saint Maurice. Offre inoltre l'accesso al centro ricreativo Versants d'Aime."
    ],
    "fr": [
      "La voie verte longe l'Isère sur 14 kilomètres environ, entre Aime et Bourg Saint Maurice. Elle permet aussi l'accès à la base de loisirs des Versants d'Aime."
    ],
    "nl": [
      "La voie verte (\"de groene piste\") loopt langs de Isère over ongeveer 14 km, tussen Aime en Bourg Saint Maurice.  Ze geeft ook toegang tot het recreatiecentrum."
    ],
    "es": [
      "La vía verde recorre el Isère a lo largo de unos 14 kilómetros, entre Aime y Bourg Saint Maurice. También proporciona acceso al centro de ocio Versants d'Aime."
    ]
  },
