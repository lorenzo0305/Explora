  "rdfs:comment": {
    "de": [
      "Als neue Restaurantadresse in Saint-Julien-d?Intres empfängt Sie das Bolet des Pins zu einer geselligen Gourmetpause. Das Restaurant bietet Ihnen eine traditionelle Küche aus frischen und lokalen Produkten."
    ],
    "en": [
      "A new restaurant in Saint-Julien-d?Intres, Le Bolet des Pins welcomes you for a convivial gourmet break. The restaurant offers traditional cuisine based on fresh local produce."
    ],
    "it": [
      "Nuovo ristorante di Saint-Julien-d'Intres, Le Bolet des Pins vi accoglie per una pausa gastronomica conviviale. Il ristorante offre una cucina tradizionale a base di prodotti freschi locali."
    ],
    "fr": [
      "Nouvelle adresse de restauration à Saint-Julien-d’Intres, le Bolet des Pins vous accueille pour une pause gourmande et conviviale. Le restaurant vous propose une cuisine traditionnelle à base de produits frais et locaux."
    ],
    "es": [
      "Le Bolet des Pins, un nuevo restaurante de Saint-Julien-d'Intres, le da la bienvenida para una agradable pausa gastronómica. El restaurante ofrece cocina tradicional basada en productos frescos de la zona."
    ],
    "nl": [
      "Le Bolet des Pins, een nieuw restaurant in Saint-Julien-d?Intres, verwelkomt je voor een gezellige gastronomische pauze. Het restaurant biedt een traditionele keuken op basis van verse streekproducten."
    ]
  },
  "rdfs:label": {
