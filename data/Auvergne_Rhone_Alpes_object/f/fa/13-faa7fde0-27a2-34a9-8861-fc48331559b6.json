  "rdfs:comment": {
    "de": [
      "Die Französische Skischule in Gresse-en-Vercors empfängt Sie in einer außergewöhnlichen Umgebung\r\nPrivatunterricht, Gruppenunterricht. Kindergarten (ab 4 Jahren) in den Ferienzeiten. Schneeklassen - Gruppen - Seminare - Schulklassen."
    ],
    "en": [
      "The Gresse-en-Vercors French Ski School welcomes you in an exceptional setting.\r\nPrivate lessons, group lessons. Kindergarten (from age 4) during vacation periods. Snow classes - groups - seminars - schools."
    ],
    "it": [
      "La scuola di sci francese di Gresse-en-Vercors vi accoglie in un ambiente eccezionale.\r\nLezioni private, lezioni di gruppo. Asilo (dai 4 anni) durante le vacanze. Corsi sulla neve - gruppi - seminari - scuole."
    ],
    "fr": [
      "L'Ecole du Ski Français de Gresse-en-Vercors vous accueille dans un cadre exceptionnel. \r\nLeçons particulières, cours collectifs. Jardin d'enfants (à partir de 4 ans) en période de vacances. Classes de neige - groupes - séminaires - scolaires."
    ],
    "es": [
      "La Escuela de Esquí Francesa de Gresse-en-Vercors le da la bienvenida en un entorno excepcional\r\nClases particulares, clases en grupo. Jardín de infancia (a partir de 4 años) durante las vacaciones. Clases de nieve - grupos - seminarios - escuelas."
    ],
    "nl": [
      "De Franse Skischool van Gresse-en-Vercors verwelkomt u in een uitzonderlijk kader\r\nPrivélessen, groepslessen. Kleuterschool (vanaf 4 jaar) tijdens de vakantie. Sneeuwklassen - groepen - seminars - scholen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ecole du Ski Français de Gresse en Vercors"
    ]
  },
