  "rdfs:comment": {
    "de": [
      "Ich habe mich vor fünf Jahren mit den 26 Alpen-Gämsziegen in der Gemeinde Suze niedergelassen und stelle schmackhafte Picodons AOP aus biologischem Anbau her."
    ],
    "en": [
      "I've been living in Suze for 5 years, with my 26 chamois Alpine goats, and I make tasty organic PDO Picodons."
    ],
    "it": [
      "Da 5 anni vivo nel comune di Suze con le mie 26 capre camosciate e produco gustosi Picodon DOP da agricoltura biologica."
    ],
    "fr": [
      "Installée depuis 5 ans sur la commune de Suze avec les 26 chèvres alpines chamoisées, je fabrique de savoureux Picodons AOP issus de l'agriculture biologique."
    ],
    "es": [
      "Vivo en la comuna de Suze desde hace 5 años con mis 26 cabras gamuzas, y elaboro sabrosos Picodones DOP procedentes de la agricultura ecológica."
    ],
