  "rdfs:comment": {
    "de": [
      "Organisation der Aufführungen \"Die Legende von Andarta\".\r\n150 Freiwillige, die von Fachleuten umgeben sind, setzen alles daran, Ende August einen magischen und einzigartigen Zeitsprung zu bieten!"
    ],
    "en": [
      "Organization of \"La Légende d'Andarta\" shows.\r\n150 volunteers, surrounded by professionals, pull out all the stops to offer a unique and magical leap back in time at the end of August!"
    ],
    "it": [
      "Organizzazione degli spettacoli della \"Leggenda di Andarta\".\r\n150 volontari circondati da professionisti che si prodigano per offrire un salto nel tempo magico e unico a fine agosto!"
    ],
    "fr": [
      "Organisation des spectacles \"La Légende d'Andarta\".\r\n150 bénévoles entourés par des professionnels qui mettent tout en œuvre pour offrir un saut dans le temps magique et unique à la fin du mois d’août !"
    ],
    "es": [
      "Organización de los espectáculos de la \"Leyenda de Andarta\".\r\n150 voluntarios rodeados de profesionales que se esfuerzan por ofrecer un salto de tiempo mágico y único a finales de agosto"
    ],
    "nl": [
      "Organisatie van de voorstellingen \"Legende van Andarta\".\r\n150 vrijwilligers, omringd door professionals, doen er alles aan om eind augustus een magische en unieke sprong terug in de tijd te bieden!"
    ]
  },
