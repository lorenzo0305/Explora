  "rdfs:comment": {
    "de": [
      "Kleine Struktur, erholsame Umgebung, angenehmer Empfang, familiäre Atmosphäre. Diplomierte Reitlehrerin, hochwertiger Reitunterricht ab 4 Jahren. Wettbewerbe, Poneys Games, Ponyreiten, Ferien- und Entdeckungskurse, Spiele, Springen, Voltigieren."
    ],
    "en": [
      "Small structure, relaxing setting, pleasant welcome, family atmosphere. Qualified instructor, quality horseback riding lessons from 4 years old. Competitions, pony games, pony rides, vacation or discovery courses, games, jumping, voltige."
    ],
    "it": [
      "Struttura piccola, ambiente rilassante, accoglienza piacevole, atmosfera familiare. Istruttore qualificato, lezioni di equitazione di qualità a partire dai 4 anni. Concorsi, pony games, passeggiate con i pony, corsi di vacanza o di scoperta, giochi, salti, volteggi."
    ],
    "fr": [
      "Petite structure, cadre reposant, accueil agréable, ambiance familiale. Monitrice diplômée, enseignement de l'équitation de qualité à partir de 4 ans. Compétitions, poneys games, balades à poneys, stages de vacances ou de découvertes, jeux, saut, voltige."
    ],
    "nl": [
      "Kleine structuur, ontspannende omgeving, aangename ontvangst, familiale sfeer. Gediplomeerde instructeur, kwaliteitsvolle paardrijlessen vanaf 4 jaar. Wedstrijden, ponyspelen, ponyritten, vakantie- of ontdekkingsstages, spelletjes, springen, voltigeren."
    ],
    "es": [
      "Estructura pequeña, entorno relajante, acogida agradable, ambiente familiar. Instructor cualificado, clases de equitación de calidad a partir de los 4 años. Concursos, juegos con ponis, paseos en ponis, cursos de vacaciones o de descubrimiento, juegos, saltos, saltos de obstáculos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Equestre de Joux"
    ]
  },
