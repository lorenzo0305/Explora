      "rdfs:comment": {
        "de": [
          "Monsieur Van Den Casteele, der seit über 45 Jahren in Nordfrankreich lebt, teilt sein Know-how mit handwerklich hergestellten Eisdesserts für alle Ihre Momente..."
        ],
        "en": [
          "A northerner for over 45 years, Monsieur Van Den Casteele shares his expertise with handcrafted frozen desserts for all your special occasions..."
        ],
        "it": [
          "Il signor Van Den Casteele è presente nella regione nordica da oltre 45 anni e condivide la sua esperienza con i dessert surgelati fatti in casa per tutte le occasioni speciali..."
        ],
        "fr": [
          "Nordiste depuis plus de 45 ans, Monsieur Van Den Casteele partage son savoir-faire avec des desserts glacés de fabrication artisanale pour tous vos instants..."
        ],
        "es": [
          "El Sr. Van Den Casteele lleva más de 45 años en la región nórdica, compartiendo su experiencia con postres helados caseros para todas sus ocasiones especiales..."
        ],
        "nl": [
          "De heer Van Den Casteele is al meer dan 45 jaar actief in Scandinavië en deelt zijn expertise met huisgemaakte diepvriesdesserts voor al uw speciale gelegenheden..."
        ]
      },
      "foaf:homepage": [
