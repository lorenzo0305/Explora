  "rdfs:comment": {
    "de": [
      "Das Refuge du logis des fées empfängt Sie, um hausgemachte, bergische und rustikale Gerichte auf über 1800 m Höhe inmitten der Berge zu genießen!"
    ],
    "en": [
      "The Refuge du logis des fées welcomes you to enjoy home-cooked, rustic mountain dishes at an altitude of over 1800m right in the middle of the mountains!"
    ],
    "it": [
      "Il Refuge du logis des fées vi accoglie per farvi gustare piatti di montagna rustici e caserecci a oltre 1800 metri di altitudine, proprio in mezzo alle montagne!"
    ],
    "fr": [
      "Le Refuge du logis des fées vous accueille pour profiter de plats maisons, montagnards et rustiques à plus de 1800m d'altitude en pleine montagne !"
    ],
    "es": [
      "El Refuge du logis des fées le da la bienvenida para degustar platos caseros y rústicos de montaña a más de 1.800 m de altitud, ¡en plena montaña!"
    ],
    "nl": [
      "De Refuge du logis des fées verwelkomt je om te genieten van huisgemaakte, rustieke berggerechten op een hoogte van meer dan 1800m midden in de bergen!"
    ]
  },
