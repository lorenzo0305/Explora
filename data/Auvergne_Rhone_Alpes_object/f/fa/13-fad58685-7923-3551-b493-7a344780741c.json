  "rdfs:comment": {
    "de": [
      "Le Puits des saveurs ist ein Restaurant, das lokale Küche und regionale Produkte miteinander verbindet und sich dabei von den Geschmäckern der Welt inspirieren lässt."
    ],
    "en": [
      "Le Puits des saveurs is a restaurant that combines local cuisine and regional products while drawing inspiration from flavors from around the world."
    ],
    "it": [
      "Le Puits des saveurs è un ristorante che combina la cucina locale e i prodotti regionali ispirandosi ai sapori del mondo."
    ],
    "fr": [
      "Le Puits des saveurs est un restaurant qui allie cuisine locale et produits régionaux tout en s’inspirant des saveurs du monde."
    ],
    "nl": [
      "Le Puits des saveurs is een restaurant dat lokale gerechten en regionale producten combineert en inspiratie haalt uit smaken uit de hele wereld."
