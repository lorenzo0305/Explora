  "rdfs:comment": {
    "de": [
      "Bar - Restaurant - Brasserie - Savoyische Spezialitäten, vor Ort oder zum Mitnehmen: täglich mittags und abends geöffnet. Wir erwarten Sie gerne und unkompliziert, um Ihnen einen angenehmen Aufenthalt zu bereiten."
    ],
    "en": [
      "Bar - Restaurant - Brasserie - Savoyard specialties, service on the spot or take away : open daily for lunch and dinner. With a terrace on the slopes."
    ],
    "it": [
      "Bar - Ristorante - Brasserie - Specialità savoiarde, sul posto o da asporto: aperto tutti i giorni, a pranzo e a cena. Con una terrazza ai piedi delle piste, saremo lieti di accogliervi con piacere e semplicità per farvi trascorrere un momento piacevole."
    ],
    "fr": [
      "Bar - Restaurant - Brasserie - Spécialités savoyardes, sur place ou à emporter : ouvert tous les jours, midi et soir. Possédant une terrasse aux pieds des pistes; nous vous attendons avec plaisir et simplicité afin de vous faire passer un agréable moment."
    ],
    "es": [
      "Bar - Restaurante - Brasserie - Especialidades de Saboya, en el lugar o para llevar: abierto todos los días, para el almuerzo y la cena. Con una terraza a pie de pistas, esperamos recibirle con gusto y sencillez para hacerle pasar un momento agradable."
    ],
    "nl": [
      "Bar - Restaurant - Brasserie – Specialiteiten van Savoye, ter plaatse te nuttigen of om mee te nemen: alle dagen geopend, ‘s middags en ‘s avonds. Met een terras aan de voet van de pistes; we verwachten u met plezier en in alle eenvoud om u een aangenaam moment te laten beleven."
    ]
  },
