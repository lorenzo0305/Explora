  "rdfs:comment": {
    "de": [
      "Seit 2014 bieten wir Ihnen die Möglichkeit, in die Welt des Weins und der Gastronomie einzutauchen. Private Besuche, begleitet von einer Sommelière, um die verschiedenen Regionen zu entdecken: Lyon - Beaujolais - Burgund und Rhône-Tal."
    ],
    "en": [
      "Since 2014, we have been offering wine and gastronomy immersions. Private visits, accompanied by a sommelier, to discover the different regions: Lyon - Beaujolais - Burgundy and the Rhône Valley."
    ],
    "it": [
      "Dal 2014 proponiamo immersioni enogastronomiche. Visite private, accompagnate da un sommelier, alla scoperta delle diverse regioni: Lione - Beaujolais - Borgogna e Valle del Rodano."
    ],
    "fr": [
      "Depuis 2014 nous vous proposons des véritables immersions autour du vin et de la gastronomie. Des visites privées, accompagnés d’ une sommelière, à la découverte des différentes régions : Lyon - Beaujolais - Bourgogne et Vallée du Rhône."
    ],
    "nl": [
      "Sinds 2014 bieden we onderdompelingen in wijn en gastronomie aan. Privébezoeken, begeleid door een sommelier, om de verschillende regio's te ontdekken: Lyon - Beaujolais - Bourgogne en de Rhônevallei."
    ],
    "es": [
      "Desde 2014, ofrecemos inmersiones enogastronómicas. Visitas privadas, acompañadas por un sumiller, para descubrir las diferentes regiones: Lyon - Beaujolais - Borgoña y el Valle del Ródano."
    ]
  },
