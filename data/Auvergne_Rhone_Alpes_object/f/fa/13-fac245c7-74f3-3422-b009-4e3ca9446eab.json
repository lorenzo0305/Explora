  "rdfs:comment": {
    "de": [
      "Eine einfache, qualitativ hochwertige Küche, eine Speisekarte mit einer großen Auswahl für Vegetarier und Veganer.\r\nNehmen Sie sich Zeit für eine Mittagspause mit Blick auf den Mont-Blanc!"
    ],
    "en": [
      "Simple, high-quality cuisine, a menu with a wide choice for vegetarians and vegans\r\nTake time out for a lunch break overlooking Mont Blanc!"
    ],
    "it": [
      "Una cucina semplice e di qualità, un menù con un'ampia scelta per vegetariani e vegani\r\nConcedetevi una pausa pranzo con vista sul Monte Bianco!"
    ],
    "fr": [
      "Une cuisine simple et de qualité, une carte avec un large choix pour les végétariens et les vegans\r\nPrenez le temps d'une pause déjeuner face au Mont-Blanc !"
    ],
    "nl": [
      "Eenvoudige keuken van hoge kwaliteit, een menu met een ruime keuze voor vegetariërs en veganisten\r\nNeem de tijd voor een lunchpauze met uitzicht op de Mont Blanc!"
    ],
    "es": [
      "Cocina sencilla y de calidad, un menú con una amplia oferta para vegetarianos y veganos\r\nTómese su tiempo para almorzar con vistas al Mont Blanc."
    ]
  },
