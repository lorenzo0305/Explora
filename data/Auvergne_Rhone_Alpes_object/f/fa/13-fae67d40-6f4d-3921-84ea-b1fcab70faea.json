  "rdfs:comment": {
    "de": [
      "Gegenüber den Hallen Paul Bocuse im Viertel Part-Dieu bietet das Bistrot Bonnel eine traditionelle Küche, die das Beste der französischen und Lyoner Spezialitäten aufgreift, sowie eine umfangreiche Pizzakarte."
    ],
    "en": [
      "Opposite Les Halles de Lyon Paul Bocuse, in the Part-Dieu area, Bistrot Bonnel serves traditional cuisine including the best of France's and Lyon's specialities, as well as a wide range of pizzas."
    ],
    "it": [
      "Di fronte alle Halles Paul Bocuse, nel quartiere Part-Dieu, il Bistrot Bonnel offre una cucina tradizionale con il meglio delle specialità francesi e lionesi e un ampio menu di pizze."
    ],
    "fr": [
      "Face aux Halles Paul Bocuse, dans le quartier de la Part-Dieu, le Bistrot Bonnel propose une cuisine traditionnelle reprenant le meilleur des spécialités françaises et lyonnaises ainsi qu’une large carte de pizzas."
    ],
    "nl": [
      "Tegenover de Halles Paul Bocuse, in de wijk Part-Dieu, biedt Bistrot Bonnel een traditionele keuken met de beste Franse en Lyonnaise specialiteiten en een uitgebreid pizzamenu."
    ],
    "es": [
      "Frente a las Halles Paul Bocuse, en el barrio de la Part-Dieu, el Bistrot Bonnel ofrece una cocina tradicional con lo mejor de las especialidades francesas y lionesas, así como una amplia carta de pizzas."
    ]
  },
