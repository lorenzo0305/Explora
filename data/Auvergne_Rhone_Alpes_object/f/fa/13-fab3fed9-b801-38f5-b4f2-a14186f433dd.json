  "rdfs:comment": {
    "de": [
      "Yllar Montagne organisiert für Sie eine lustige und kooperative Zeit, die auf Ihre Gruppe zugeschnitten ist. Von 16 bis 250 Teilnehmern stellt Yllar ein dreistündiges Spiel in den Alpen auf die Beine."
    ],
    "en": [
      "Yllar Montagne organizes a fun, cooperative experience for your group. From 16 to 250 participants, Yllar sets up a 3-hour game in the Alps."
    ],
    "it": [
      "Yllar Montagne può organizzare un'esperienza divertente e cooperativa adatta al vostro gruppo. Da 16 a 250 partecipanti, Yllar può organizzare un gioco di 3 ore sulle Alpi."
    ],
    "fr": [
      "Yllar Montagne organise pour vous un moment fun et coopératif, adapté à votre groupe. De 16 à 250 participants, Yllar met en place un jeu de 3 heures dans les Alpes."
    ],
    "es": [
      "Yllar Montagne puede organizar una experiencia divertida y cooperativa a la medida de su grupo. De 16 a 250 participantes, Yllar puede organizar una partida de 3 horas en los Alpes."
    ],
    "nl": [
      "Yllar Montagne kan voor jouw groep een leuke, coöperatieve ervaring organiseren. Van 16 tot 250 deelnemers kan Yllar een 3-uur durend spel in de Alpen organiseren."
    ]
  },
