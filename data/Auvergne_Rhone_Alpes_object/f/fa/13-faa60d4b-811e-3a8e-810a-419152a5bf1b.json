  "rdfs:comment": {
    "de": [
      "Von den Musikausbildungsklassen des Conservatoire du Tricastin und ihren Lehrern. Eine Inszenierung von Jérémy CHAPLAIN. Es war einmal ein Müller, der seinen drei Söhnen eine Mühle, einen Esel und ... eine Katze hinterließ."
    ],
    "en": [
      "By the Conservatoire du Tricastin's musical training classes and their teachers. Directed by Jérémy CHAPLAIN. Once upon a time, a miller left his three sons a mill, a donkey and? a cat."
    ],
    "it": [
      "A cura delle classi di musica del Conservatorio di Tricastin e dei loro insegnanti. Regia di Jérémy CHAPLAIN. C'era una volta un mugnaio che lasciò ai suoi tre figli un mulino, un asino e un gatto."
    ],
    "fr": [
      "Par les classes de formation musicale du Conservatoire du Tricastin et leurs professeurs. Une mise en scène de Jérémy CHAPLAIN. Il était une fois un meunier laissant à ses trois fils un moulin, un âne et… un chat."
    ],
    "es": [
      "Por las clases de música del Conservatorio Tricastin y sus profesores. Dirigido por Jérémy CHAPLAIN. Érase una vez un molinero que dejó a sus tres hijos un molino, un burro y... un gato."
    ],
    "nl": [
      "Door de muziekklassen van het Tricastin Conservatorium en hun docenten. Regie: Jérémy CHAPLAIN. Er was eens een molenaar die zijn drie zonen een molen, een ezel en een kat naliet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conte musical : Le chat botté"
    ]
  },
