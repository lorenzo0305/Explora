  "rdfs:comment": {
    "de": [
      "Kreation von Einzelstücken aus Steingut. Personalisierte Bestellungen und Maßanfertigungen! Tischkultur und Dekoration. Keramik-Workshops zu Hause, im Unternehmen oder an einem geselligen Ort für eine Veranstaltung, einen Geburtstag?"
    ],
    "en": [
      "Creation of unique earthenware pieces. Personalised, made-to-measure orders!"
    ],
    "it": [
      "Creazione di pezzi unici in terracotta. Ordini personalizzati e su misura! Oggetti per la tavola e decorazioni. Laboratori di creazione di ceramica a casa, sul posto di lavoro o in un contesto conviviale per eventi, compleanni, ecc"
    ],
    "fr": [
      "Création de pièces uniques en faïence. Commandes personnalisées et sur-mesure ! Arts de la table et décoration. Ateliers de création céramique à domicile, en entreprise ou dans un lieu convivial pour un événement, un anniversaire…"
    ],
    "nl": [
      "Creatie van unieke stukken aardewerk. Gepersonaliseerde bestellingen op maat! Tafelgerei en decoratie. Keramiekworkshops bij je thuis, op het werk of in een gezellig kader voor evenementen, verjaardagen, enz"
    ],
    "es": [
      "Creación de piezas de barro únicas. Pedidos personalizados y a medida Servicio de mesa y decoración. Talleres de creación cerámica a domicilio, en el lugar de trabajo o en un marco de convivencia para eventos, cumpleaños, etc"
    ]
  },
