  "rdfs:comment": {
    "de": [
      "Der Port Gallatin befindet sich am linken Ufer der Rhône in Seyssel Haute-Savoie. Er bietet 26 Ringe zur Vermietung an. Zwei Hausbootanlegestellen stehen den Bootsfahrern in Seyssel Ain und Seyssel Haute-Savoie ebenfalls zur Verfügung."
    ],
    "en": [
      "Port Gallatin is located on the left bank of the Rhône in Seyssel, Haute-Savoie. It offers 26 moorings for hire. There are also two river stops for boaters in Seyssel Ain and Seyssel Haute-Savoie."
    ],
    "it": [
      "Port Gallatin si trova sulla riva sinistra del Rodano a Seyssel, in Alta Savoia. Offre 26 ormeggi a noleggio. Ci sono anche due fermate fluviali per i navigatori a Seyssel Ain e Seyssel Haute-Savoie."
    ],
    "fr": [
      "Le Port Gallatin est situé sur la rive gauche du Rhône, à Seyssel Haute-Savoie. Il propose 26 anneaux à la location. Deux haltes fluviales sont aussi à la disposition des plaisanciers à Seyssel Ain et Seyssel Haute-Savoie."
    ],
    "nl": [
      "Port Gallatin ligt op de linkeroever van de Rhône in Seyssel, Haute-Savoie. Er zijn 26 ligplaatsen te huur. Er zijn ook twee rivierhaltes voor watersporters in Seyssel Ain en Seyssel Haute-Savoie."
    ],
    "es": [
      "Port Gallatin está situado en la orilla izquierda del Ródano, en Seyssel (Alta Saboya). Ofrece 26 amarres de alquiler. También hay dos paradas fluviales para navegantes en Seyssel Ain y Seyssel Haute-Savoie."
    ]
  },
  "rdfs:label": {
