  "rdfs:comment": {
    "de": [
      "Paradis kid's ist ein Ort, an dem Ihre Kinder aufblasbare Spiele, Wasserspiele, Minigolf, einen kleinen Zug und Pedal-Gokarts spielen können. Der Spielplatz umfasst mehr als 4000m².\r\nSnacks und Getränke vor Ort."
    ],
    "en": [
      "Paradis kid's is a place where your children can play inflatable games, water games, mini golf, little trains and pedal go-karts. Over 4000m² of playground.\r\nSnacks and drinks on site."
    ],
    "it": [
      "Il Paradis kid's è un luogo dove i vostri bambini possono giocare con giochi gonfiabili, giochi acquatici, mini golf, trenino e go-kart a pedali. Più di 4000 m² di parco giochi.\r\nSnack e bevande in loco."
    ],
    "fr": [
      "Paradis kid's est lieu où vos enfants pourront jouer à des jeux gonflables, aquatiques, mini golf, petit train et avec des kart à pédale . plus de 4000m² de parc de jeux.\r\nSnack et boissons sur place."
    ],
    "nl": [
      "Paradis kid's is een plek waar uw kinderen kunnen spelen met opblaasbare spelletjes, waterspelletjes, minigolf, treintje en skelters. Meer dan 4000 m² speeltuin.\r\nSnacks en drankjes ter plaatse."
    ],
    "es": [
      "Paradis kid's es un lugar donde sus hijos podrán jugar a hinchables, juegos acuáticos, minigolf, trenecito y karts de pedales. Más de 4000 m² de parque infantil.\r\nSnacks y bebidas in situ."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Base de loisir | Paradis Kid's | Cayres"
    ]
  },
