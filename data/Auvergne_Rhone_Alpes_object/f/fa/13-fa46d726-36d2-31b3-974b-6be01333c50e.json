  "rdfs:comment": {
    "de": [
      "Authentizität, Herzlichkeit und gastfreundliches Ambiente gehören im Victorine zum echten Kulturerbe. Das Restaurant bietet eine große Auswahl, von regionalen Spezialitäten über à la carte-Gerichte des Küchenchefs bis zu den Menüs vom Bauernhof.  \r\n15 Minuten von Megève und 12 Minuten von Les Saisies entfernt."
    ],
    "en": [
      "Authenticity, warmth, friendly atmosphere are part of Victorine’s culture. The restaurant offers different menus, from regional specialities to the chef’s à la carte dishes as well as the farm’s set menus. 15 mins from Megève/12 mins from Les Saisies."
    ],
    "it": [
      "Autenticità, calore e convivialità sono il vero patrimonio di Victorine. Il ristorante offre una gamma di menu, dalle specialità regionali al menu dello chef e ai menu della fattoria.\r\nA 15 minuti da Megève e a 12 minuti da Les Saisies."
    ],
    "fr": [
      "Authenticité, chaleur, et convivialité sont le véritable héritage de Victorine. Le restaurant propose différents menus, des spécialités régionales à la carte du chef en passant par les menus de la ferme.\r\nA 15 minutes de Megève et 12 minutes des Saisies."
    ],
    "nl": [
      "Authenticiteit, warmte en gezelligheid zijn de ware erfenis van Victorine. Het restaurant biedt verschillende menu's, van regionale specialiteiten tot het menu van de chef en boerenmenu's.\r\nOp 15 minuten van Megève en op 12 minuten van Les Saisies."
    ],
    "es": [
      "Autenticidad, calidez y cordialidad son el verdadero patrimonio de Victorine. El restaurante ofrece menús variados, desde especialidades regionales hasta la carta del chef y menús de granja.\r\nA 15 minutos de Megève y a 12 minutos de Les Saisies."
    ]
  },
