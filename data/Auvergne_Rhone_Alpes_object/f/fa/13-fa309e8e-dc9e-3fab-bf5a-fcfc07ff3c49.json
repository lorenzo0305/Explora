  "rdfs:comment": {
    "de": [
      "Das Maison d'assitantes maternelles la Cabanaille nimmt Ihre Kinder von 0 bis 5 Jahren von Montag bis Freitag auf, sofern Sie Ihre \"pajemploi\"-Nummer angeben, um den Vertrag zu erstellen."
    ],
    "en": [
      "La Cabanaille childminding center welcomes your children aged 0 to 5 from Monday to Friday, subject to providing your \"pajemploi\" number to draw up the contract."
    ],
    "it": [
      "Il centro per l'infanzia La Cabanaille accoglie i vostri bambini da 0 a 5 anni dal lunedì al venerdì, previa comunicazione del numero di pajemploi per la stipula del contratto."
    ],
    "fr": [
      "La maison d'assitantes maternelles la Cabanaille accueille vos enfants de 0 à 5 ans du lundi au vendredi, sous réserve de fournir votre numéro \"pajemploi\" pour établir le contrat."
    ],
    "es": [
      "La guardería La Cabanaille acoge a sus hijos de 0 a 5 años de lunes a viernes, a condición de proporcionar su número de \"pajemploi\" para establecer el contrato."
    ],
    "nl": [
      "Het kinderdagverblijf La Cabanaille ontvangt uw kinderen van 0 tot 5 jaar van maandag tot vrijdag, op voorwaarde dat u uw \"pajemploi\"-nummer opgeeft om het contract op te stellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cabanaille Maison d'assistantes maternelles"
    ]
  },
