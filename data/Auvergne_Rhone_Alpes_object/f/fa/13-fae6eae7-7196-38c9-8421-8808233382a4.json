  "rdfs:comment": {
    "de": [
      "Schnitzen mit der Kettensäge, Herstellung von verschiedenen Holzobjekten Bär, Morchel, Steinpilz, Murmeltier.\r\nNeuheit ... Handwerkliche Herstellung von einzigartigen Designstücken, Hocker, Stuhl, Regal etc."
    ],
    "en": [
      "Carving with a chainsaw, making various objects from bear, morel, boletus and marmot wood.\r\nNew products ... Artisanal creation of unique design pieces, stools, chairs, shelves, etc."
    ],
    "it": [
      "Intaglio con la motosega, realizzazione di vari oggetti in legno di orso, spugnola, boleto e marmotta.\r\nNuovi oggetti ... Creazione artigianale di pezzi unici di design, sgabelli, sedie, mensole, ecc."
    ],
    "fr": [
      "Sculpture a la tronçonneuse, fabrication d’objets divers en bois ours , morille, cèpe ,  marmotte. \r\nNouveauté ... Création  artisanale pièces uniques design , tabouret, chaise, étagère etc."
    ],
    "es": [
      "Tallado con motosierra, fabricación de objetos diversos con madera de oso, colmenilla, boletus y marmota.\r\nNovedades ... Creación artesanal de piezas de diseño únicas, taburetes, sillas, estanterías, etc."
    ],
    "nl": [
      "Snijden met een kettingzaag, verschillende voorwerpen maken van beren-, morieljes-, boleten- en marmottenhout.\r\nNieuwe artikelen ... Ambachtelijke creatie van unieke designstukken, krukjes, stoelen, planken, enz."
    ]
  },
