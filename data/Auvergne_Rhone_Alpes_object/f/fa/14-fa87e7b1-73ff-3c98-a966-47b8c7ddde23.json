  "rdfs:comment": {
    "de": [
      "Romain Watson ist ein Sänger, Songwriter und Komponist, der einen tanzbaren und farbenfrohen Pop destilliert.\nEr teilt seine Energie und seine Sensibilität im Laufe seiner Konzerte, die reich an Emotionen sind."
    ],
    "en": [
      "Romain Watson is a singer-songwriter who distils colorful, danceable pop.\nHe shares his energy and sensitivity in emotionally-charged concerts."
    ],
    "it": [
      "Romain Watson è un cantautore che distilla un pop colorato e ballabile.\nCondivide la sua energia e sensibilità in concerti ricchi di emozioni."
    ],
    "fr": [
      "Romain Watson est un chanteur-auteur-compositeur qui distille une Pop dansante et colorée. \nIl partage son énergie et sa sensibilité au fil de concerts riches en émotions."
    ],
    "nl": [
      "Romain Watson is een singer-songwriter die kleurrijke, dansbare pop maakt.\nHij deelt zijn energie en gevoeligheid in concerten boordevol emotie."
    ],
    "es": [
      "Romain Watson es un cantautor que destila un pop colorista y bailable.\nComparte su energía y sensibilidad en conciertos llenos de emoción."
    ]
  },
