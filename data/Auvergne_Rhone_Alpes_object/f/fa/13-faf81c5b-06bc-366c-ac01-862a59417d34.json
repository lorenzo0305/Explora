  "rdfs:comment": {
    "de": [
      "Die 15 km von Le Puy-en-Velay sind ein international bekannter Laufwettbewerb. Der Wettkampf findet im Herzen der Pontischen Stadt statt und besteht aus einer Schleife, die zweimal durchlaufen werden muss."
    ],
    "en": [
      "The 15 km of Le Puy-en-Velay is an internationally renowned pedestrian race. The event takes place in the heart of the Pontian city, and consists of a loop to be run twice."
    ],
    "it": [
      "La 15 km di Le Puy-en-Velay è una gara podistica di fama internazionale. L'evento si svolge nel cuore della città di Puy-en-Velay e consiste in un anello da completare due volte."
    ],
    "fr": [
      "Les 15 km du Puy-en-Velay sont une course pédestre de renommée internationale. L’épreuve se déroule au cœur de la cité ponote et consiste en une boucle à parcourir deux fois."
    ],
    "es": [
      "Los 15 km de Le Puy-en-Velay son una carrera a pie de renombre internacional. El evento tiene lugar en el corazón de la ciudad de Puy-en-Velay y consiste en un bucle que debe completarse dos veces."
    ],
    "nl": [
      "De 15 km van Le Puy-en-Velay is een internationaal bekende loopwedstrijd. Het evenement vindt plaats in het hart van de stad Puy-en-Velay en bestaat uit een lus die twee keer moet worden afgelegd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "15 km internationaux du Puy-en-Velay"
    ]
  },
