  "rdfs:comment": {
    "de": [
      "RENT & RIDE ist ein netter und geselliger Ort, der rund um den Ski-/Snowboardverleih, aber auch um das Testen neuer Spielzeuge und den Verkauf einiger großer Marken entstanden ist."
    ],
    "en": [
      "RENT & RIDE is a nice and friendly place, created around the rental of ski / snowboard, but also the test of new products and the sale of some big brands."
    ],
    "it": [
      "RENT & RIDE è un luogo simpatico e amichevole, creato intorno al noleggio di sci/snowboard, ma anche alla prova di nuovi giocattoli e alla vendita di alcune grandi marche."
    ],
    "fr": [
      "RENT & RIDE c'est un lieu sympa et convivial, créé autour de la location de ski/snowboard, mais aussi du test de nouveaux joujoux et de la vente de quelques grandes marques."
    ],
    "nl": [
      "RENT & RIDE is een leuke en vriendelijke plek, gecreëerd rond ski-/snowboardverhuur, maar ook het testen van nieuw speelgoed en de verkoop van een aantal geweldige merken."
    ],
    "es": [
      "RENT & RIDE es un lugar agradable y acogedor, creado en torno al alquiler de esquís y tablas de nieve, pero también a la prueba de nuevos juguetes y a la venta de algunas grandes marcas."
    ]
  },
