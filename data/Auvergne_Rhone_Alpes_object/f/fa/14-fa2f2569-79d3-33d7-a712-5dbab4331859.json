  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/deb7d9b8-a789-36d7-88f6-f74e11ef973b",
      "dc:description": {
        "de": [
          "Damrémont amüsiert sich\nAbend mit Gesellschaftsspielen für Kinder und Eltern\nTipps, Regelerklärungen, Präsentationen - unser Team wird Sie durch diesen spielerischen Abend begleiten.\n\n \n\nBibludothek Damrémont\nSamstag, 16. November 2024 um 19 Uhr\nFamilienpublikum, mit Reservierung"
        ],
        "en": [
          "Damrémont s'amuse\nBoard game evening for children and parents\nAdvice, explanations of rules, presentations: our team will accompany you throughout this fun-filled evening.\n\n \n\nBibludothèque Damrémont\nSaturday, November 16, 2024 at 7pm\nFamily audience, on reservation"
        ],
        "it": [
          "Damrémont s'amuse\nUna serata di giochi da tavolo per bambini e genitori\nIl nostro team sarà a disposizione per dare consigli, spiegare le regole e fare presentazioni durante la serata.\n\n \n\nBiblioteca Damrémont\nSabato 16 novembre 2024 alle 19.00\nPubblico di famiglie, su prenotazione"
        ],
        "fr": [
          "Damrémont s'amuse\nSoirée jeux de société pour enfants et parents\nConseils, explications de règles, présentations, notre équipe vous accompagnera tout au long de cette soirée ludique.\n\n \n\nBibludothèque Damrémont\nSamedi 16 novembre 2024 à 19h\nPublic familial, sur réservation"
        ],
        "es": [
          "Damrémont s'amuse\nUna tarde de juegos de mesa para niños y padres\nNuestro equipo estará a su disposición para aconsejarle, explicarle las reglas y hacerle presentaciones durante toda la velada.\n\n \n\nBiblioteca Damrémont\nSábado 16 de noviembre de 2024 a las 19.00 h\nPúblico familiar, previa reserva"
        ],
        "nl": [
          "Damrémont s'amuse\nEen avond vol gezelschapsspelletjes voor kinderen en ouders\nOns team staat de hele avond klaar om advies te geven, de regels uit te leggen en presentaties te geven.\n\n \n\nBibliotheek Damrémont\nZaterdag 16 november 2024 om 19u\nFamiliepubliek, op reservering"
        ]
      },
