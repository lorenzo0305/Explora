  "rdfs:comment": {
    "de": [
      "Erleben Sie ein unvergessliches Erlebnis bei Tag und bei Nacht. Steigen Sie allein oder zu zweit in einen Schlitten und machen Sie sich auf einen Adrenalinschub gefasst, bei dem Sie zwischen aufeinanderfolgenden Steilkurven, Tunneln und Höhenunterschieden und Geschwindigkeiten hin- und hergerissen werden."
    ],
    "en": [
      "An unforgettable experience, day or night. Alone or in pairs, climb aboard a toboggan and prepare for an adrenalin rush of successive banked turns, tunnels and variations in altitude and speed."
    ],
    "it": [
      "Godetevi un'esperienza indimenticabile di giorno o di notte. Da soli o con il partner, salite su una slitta e preparatevii a una grande scarica di adrenalina tra curve successive, tunnel e variazioni di altitudine e velocità."
    ],
    "fr": [
      "Vivez une expérience inoubliable de jour comme de nuit. Seul ou en duo, montez dans une luge et préparez-vous à une belle montée d’adrénaline entre virages successifs relevés, tunnels et variations de dénivelé et de vitesse."
    ],
    "es": [
      "Vive una experiencia inolvidable de día y de noche. Solo o en pareja, suba en un trineo y prepárese para un buen subidón de adrenalina entre giros sucesivos, túneles y variaciones de desnivel y velocidad."
    ],
    "nl": [
      "Geniet overdag of 's nachts van een onvergetelijke ervaring. Stap alleen of met z'n tweeën op de slee en bereid je voor op een geweldige adrenalinekick tussen opeenvolgende scherpe bochten, tunnels en variaties in hoogte en snelheid."
    ]
  },
  "rdfs:label": {
    "en": [
      "4 seasons sledge"
    ],
    "it": [
      "Slittino 4 stagioni"
    ],
    "fr": [
      "Luge 4 saisons"
    ],
    "es": [
      "Trineo sobre raíles"
    ]
  },
