  "rdfs:comment": {
    "de": [
      "Das Cherlieu liegt im Zentrum von Charlieu und bietet Ihnen hausgemachte Gerichte. Mit seiner schönen Sommerterrasse ist es sehr angenehm, hier zu Mittag zu essen.  Bietet von Mai bis September samstags vormittags Brunch an."
    ],
    "en": [
      "Le Cherlieu, located right in the center of Charlieu, offers home-made dishes. With its lovely summer terrace, it's a great place to enjoy lunch.  Saturday brunches from May to September."
    ],
    "it": [
      "Le Cherlieu, situato proprio nel centro di Charlieu, serve piatti fatti in casa. Con la sua bella terrazza estiva, è un luogo ideale per pranzare.  Offre un brunch il sabato mattina da maggio a settembre."
    ],
    "fr": [
      "Le Cherlieu, situé en plein centre de Charlieu, vous propose des plats faits maison. Avec sa belle terrasse d'été, il est très agréable de venir y déjeuner.  Propose des brunchs les samedis matins de mai à septembre."
    ],
    "es": [
      "Le Cherlieu, situado en pleno centro de Charlieu, sirve platos caseros. Con su bonita terraza de verano, es un lugar ideal para almorzar.  Ofrece brunch los sábados por la mañana de mayo a septiembre."
    ],
    "nl": [
      "Le Cherlieu, gelegen in het centrum van Charlieu, serveert huisgemaakte gerechten. Met zijn mooie zomerterras is het een geweldige plek om te lunchen.  Van mei tot september is er een brunch op zaterdagochtend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cherlieu"
    ]
  },
