  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bc5270a5-68a2-3fb6-8127-91e1a633e551",
      "dc:description": {
        "de": [
          "Das Restaurant La Baguernette befindet sich gegenüber dem Sumpfgebiet Audomarois in der Kleinstadt Clairmarais. Diese 3600 Hektar große Fläche strotzt nur so vor rohen Schätzen. Eine Oase der Ruhe und ein garantierter Moment der Abwechslung, den Sie mit Freunden oder der Familie teilen können."
        ],
        "en": [
          "The restaurant La Baguernette is located in front of the Audomarois marsh, in the small town of Clairmarais. This 3600 hectare area is overflowing with raw treasures. A haven of peace and a moment of guaranteed change of scenery to share with friends or family."
        ],
        "it": [
          "Il ristorante La Baguernette si trova di fronte alle paludi di Audomarois, nella cittadina di Clairmarais. Quest'area di 3600 ettari trabocca di tesori grezzi. Un'oasi di pace e un cambiamento di scenario da condividere con gli amici o la famiglia."
        ],
        "fr": [
          "Le restaurant La Baguernette est situé en face du marais Audomarois, dans la petite ville de Clairmarais. Cette étendue d’une superficie de 3600 hectares déborde de trésors bruts. Un havre de paix et un moment de dépaysement assuré à partager entre amis ou en famille."
        ],
        "nl": [
          "Het restaurant La Baguernette ligt tegenover de moerassen van Audomarois, in het stadje Clairmarais. Dit 3600 hectare grote gebied zit boordevol ruwe schatten. Een oase van rust en een verandering van omgeving om te delen met vrienden of familie."
        ],
        "es": [
          "El restaurante La Baguernette está situado frente a las marismas de Audomarois, en la pequeña ciudad de Clairmarais. Esta zona de 3.600 hectáreas rebosa de tesoros en bruto. Un remanso de paz y un cambio de aires para compartir con los amigos o la familia."
        ]
      },
      "@type": [
        "Description"
