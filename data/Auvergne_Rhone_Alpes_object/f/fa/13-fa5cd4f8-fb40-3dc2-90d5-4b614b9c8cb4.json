  "rdfs:comment": {
    "de": [
      "Die Mediathek in Novel befindet sich in der Nähe des Sozialzentrums Le Mikado und bietet eine freie Nutzung von Multimediasammlungen und verschiedene Dienstleistungen für die Öffentlichkeit. Sie wertet die Sammlungen rund um den Feminismus auf und beherbergt einen Pressebereich."
    ],
    "en": [
      "Located close to the Le Mikado social center, the Novel multimedia library offers free access to multimedia collections and a wide range of public services. The library also features collections on feminism and a press room."
    ],
    "it": [
      "Situata vicino al centro sociale Mikado, la biblioteca multimediale Novel offre accesso gratuito alle collezioni multimediali e una serie di servizi per il pubblico. Promuove collezioni sul femminismo e dispone di una sala stampa."
    ],
    "fr": [
      "Située à proximité du centre social Le Mikado, la médiathèque de Novel propose une libre consultation de collections multimédias et de services variés pour le public. Elle valorise les collections autour du féminisme et accueille un espace presse."
    ],
    "es": [
      "Situada cerca del centro social Mikado, la biblioteca multimedia Novel ofrece acceso gratuito a colecciones multimedia y diversos servicios para el público en general. Promueve colecciones sobre feminismo y dispone de una sala de prensa."
    ],
    "nl": [
      "De Novel-multimediabibliotheek bevindt zich in de buurt van het Mikado sociaal centrum en biedt gratis toegang tot multimediacollecties en een reeks diensten voor het grote publiek. Het promoot collecties over feminisme en heeft een perskamer."
    ]
  },
