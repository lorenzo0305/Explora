  "rdfs:comment": {
    "de": [
      "Direkt vom Bahnhof aus erreichbar für diejenigen, die mit dem Zug anreisen, bietet dieser Weg die Möglichkeit, die Höhen des Rhônetals zu erkunden."
    ],
    "en": [
      "Directly accessible from the station for those arriving by train, this route takes in the heights of the Rhône valley."
    ],
    "it": [
      "Direttamente accessibile dalla stazione per chi arriva in treno, questo percorso permette di scoprire le alture della Valle del Rodano."
    ],
    "fr": [
      "Directement accessible depuis la gare pour ceux qui arrivent en train, ce parcours permet de découvrir les hauteurs de la vallée du Rhône."
    ],
    "es": [
      "Directamente accesible desde la estación para los que lleguen en tren, esta ruta permite descubrir las alturas del valle del Ródano."
    ],
    "nl": [
      "Deze route is rechtstreeks bereikbaar vanaf het station voor wie met de trein komt en laat je de hoogten van de Rhônevallei ontdekken."
    ]
  },
  "rdfs:label": {
