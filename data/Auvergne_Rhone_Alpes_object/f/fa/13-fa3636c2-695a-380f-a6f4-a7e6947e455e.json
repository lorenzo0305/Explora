  "rdfs:comment": {
    "de": [
      "Le Gratin ist eine Bar, ein Tabakladen und ein Restaurant, das hausgemachte Gerichte aus lokalen und saisonalen Produkten für eine traditionelle französische Küche mit italienischen Einflüssen und Pizzen an Freitag- & Samstagabenden anbietet."
    ],
    "en": [
      "Le Gratin is a bar, tobacconist's shop and restaurant serving homemade dishes made with local, seasonal produce, traditional French cuisine with Italian influences, and pizzas on Friday and Saturday evenings."
    ],
    "it": [
      "Le Gratin è un bar, tabaccheria e ristorante che serve piatti fatti in casa con prodotti locali e di stagione, cucina tradizionale francese con influenze italiane e pizze il venerdì e il sabato sera."
    ],
    "fr": [
      "Le Gratin est un bar, tabac, restaurant qui propose des plats fait maison avec des produits locaux et de saison pour une cuisine traditionnelle française avec des influences italiennes et des pizzas les vendredis & samedis soirs."
    ],
    "nl": [
      "Le Gratin is een bar, tabakswinkel en restaurant met huisgemaakte gerechten met lokale en seizoensgebonden producten, traditionele Franse gerechten met Italiaanse invloeden en pizza's op vrijdag- en zaterdagavond."
    ],
    "es": [
      "Le Gratin es un bar, estanco y restaurante que sirve platos caseros elaborados con productos locales y de temporada, cocina tradicional francesa con influencias italianas y pizzas los viernes y sábados por la noche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Gratin Restaurant"
    ]
  },
