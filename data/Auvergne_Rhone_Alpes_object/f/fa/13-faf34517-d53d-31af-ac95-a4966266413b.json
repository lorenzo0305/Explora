  "rdfs:comment": {
    "de": [
      "Bar - Restaurant im Herzen des Dorfes, Terrasse und Parkplatz in der Nähe. Der Ort ist einladend und die Aussicht auf das Schloss von Rochemaure ist atemberaubend. Zögern Sie nicht, einen Zwischenstopp einzulegen, um Ihren Durst zu löschen oder eine hausgemachte Mahlzeit zu sich zu nehmen."
    ],
    "en": [
      "Bar - Restaurant is located in the heart of the village, terrace and parking access nearby. The place is welcoming and the view is breathtaking over the Rochemaure castle. Don't hesitate to stop off to quench your thirst or for a home-cooked meal."
    ],
    "it": [
      "Bar e ristorante nel cuore del villaggio, con terrazza e parcheggio nelle vicinanze. Il locale è accogliente e la vista sul castello di Rochemaure è mozzafiato. Fermatevi per un drink o un pasto fatto in casa."
    ],
    "fr": [
      "Bar - Restaurant situé au cœur du village, terrasse et accès parking à proximité. Le lieu est accueillant et la vue imprenable sur le château de Rochemaure. N'hésitez pas à faire une halte pour vous désaltérer ou pour un repas fait maison."
    ],
    "es": [
      "Bar y restaurante en el corazón del pueblo, con terraza y aparcamiento en las inmediaciones. El lugar es acogedor y la vista del castillo de Rochemaure es impresionante. Pase a tomar una copa o una comida casera."
    ],
    "nl": [
      "Bar en restaurant in het hart van het dorp, met terras en parkeerplaats in de buurt. De plek is gastvrij en het uitzicht op het kasteel van Rochemaure is adembenemend. Kom langs voor een drankje of een huisgemaakte maaltijd."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Auberge de Rochemaure"
    ],
    "fr": [
      "La Vieille Maison"
    ]
  },
