  "rdfs:comment": {
    "de": [
      "Treffen Sie sich am 19. Juli 2026, um die Durchfahrt der Etappe der Tour de France zu erleben!\r\nDie Amateurradfahrer werden bei der Abfahrt auf den Straßen des Col de la Croix de Fer vorbeifahren.\r\nDie Tour de France wird dann am 25. Juli durch Saint Sorlin d'Arves fahren."
    ],
    "en": [
      "Come along on July 19, 2026 to watch the Tour de France stage pass by!\r\nAmateur cyclists will ride down the Col de la Croix de Fer.\r\nThe Tour de France will then pass through Saint Sorlin d'Arves on July 25th."
    ],
    "it": [
      "Unitevi a noi il 19 luglio 2026 per la tappa del Tour de France!\r\nI ciclisti dilettanti scenderanno dal Col de la Croix de Fer.\r\nIl Tour de France passerà poi da Saint Sorlin d'Arves il 25 luglio."
    ],
    "fr": [
      "Rendez-vous le 19 juillet 2026 pour assister au passage de l'Étape du Tour de France !\r\nLes cyclistes amateurs passeront à la descente sur les routes du Col de la Croix de Fer.\r\nLe Tour de France passera ensuite par Saint Sorlin d'Arves le 25 juillet."
    ],
    "nl": [
      "Kom op 19 juli 2026 naar de Tour de France!\r\nDe amateurwielrenners zullen de afdaling op de wegen van de Col de la Croix de Fer nemen.\r\nDe Tour de France komt vervolgens op 25 juli door Saint Sorlin d'Arves."
    ],
    "es": [
      "Acompáñanos el 19 de julio de 2026 en la etapa del Tour de Francia\r\nLos ciclistas aficionados descenderán el Col de la Croix de Fer.\r\nA continuación, el Tour de Francia pasará por Saint Sorlin d'Arves el 25 de julio."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Tour Stage 2026"
    ],
    "fr": [
      "L'Étape du Tour 2026"
    ],
    "nl": [
      "De etappe van de Tour 2026"
    ]
  },
