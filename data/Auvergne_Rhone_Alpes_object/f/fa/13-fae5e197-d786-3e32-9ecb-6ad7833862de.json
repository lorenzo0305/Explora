  "rdfs:comment": {
    "de": [
      "Im Herzen des wunderschönen Regionalen Naturparks Baronnies Provençales, gegenüber dem Mont Ventoux, entdecken Sie unser charmantes Hotel und unser Restaurant. Die außergewöhnliche Ruhe und das Panorama machen es zu einem bevorzugten Ort für Naturliebhaber."
    ],
    "en": [
      "A real little paradise for nature lovers. Calm and welcoming hotel."
    ],
    "it": [
      "Nel cuore del magnifico Parc Naturel Régional des Baronnies Provençales, di fronte al Mont Ventoux, venite a scoprire il nostro hotel e ristorante a 3 stelle. La tranquillità e le eccezionali viste panoramiche lo rendono il luogo preferito dagli amanti della natura."
    ],
    "fr": [
      "Au cœur du magnifique Parc Naturel Régional des Baronnies Provençales, face au Mont Ventoux, venez découvrir notre Hôtel*** et notre Restaurant. Le calme et le panorama exceptionnels en font un lieu de prédilection pour les amoureux de la nature."
    ],
    "es": [
      "En el corazón del magnífico Parc Naturel Régional des Baronnies Provençales, frente al Mont Ventoux, venga a descubrir nuestro hotel y restaurante de 3 estrellas. La tranquilidad y las excepcionales vistas panorámicas lo convierten en un lugar predilecto para los amantes de la naturaleza."
    ],
    "nl": [
      "Een waar paradijs voor natuurliefhebbers. Rustig en sfeervol hotel."
    ]
  },
