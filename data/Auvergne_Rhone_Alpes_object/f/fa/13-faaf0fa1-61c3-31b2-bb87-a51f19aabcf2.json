  "rdfs:comment": {
    "de": [
      "Machen Sie einen Zwischenstopp im Beaufortois. Familiäre Atmosphäre und traditionelle Küche von hoher Qualität. Unter der Woche gibt es ein Tagesmenü für 17.00? oder eine Karte mit Burgern, Entrecôte, gratinierten Ravioli... Sonntags gibt es ein Froschmenü oder saisonale Gerichte wie Zicklein oder Pommes frites."
    ],
    "en": [
      "Come and stop off at Le Beaufortois. Family atmosphere and quality traditional cuisine. Weekdays: daily menu at €17.00 or à la carte with burger, entrecôte, ravioli gratin... Sundays: frog menu or seasonal dishes... venison, fried fish."
    ],
    "it": [
      "Venite a fermarvi a Le Beaufortois. Atmosfera familiare e cucina tradizionale di qualità. Durante la settimana, menù del giorno alle 17.00 o alla carta con hamburger, entrecote, ravioli gratinati... La domenica menù a base di rane o piatti di stagione... capra, pesce fritto."
    ],
    "fr": [
      "Venez faire une halte au Beaufortois. Ambiance familiale et cuisine traditionnelle de qualité. La semaine un menu du jour à 17.00€ ou carte avec burger, entrecôte,  gratiné de ravioles.. Le dimanche menu grenouilles ou mets de saison... cabris,  fritures."
    ],
    "es": [
      "Venga a hacer una parada en Le Beaufortois. Ambiente familiar y cocina tradicional de calidad. Entre semana, menú del día a las 17h... o a la carta con hamburguesa, entrecot, raviolis gratinados... Domingos menú rana o platos de temporada... cabrito, pescado frito."
    ],
    "nl": [
      "Kom langs bij Le Beaufortois. Familiale sfeer en traditionele kwaliteitskeuken. Doordeweeks een dagmenu om 17.00 uur of à la carte met een hamburger, entrecote, gegratineerde ravioli... Op zondag kikkermenu of seizoensgerechten... geiten, gebakken vis."
    ]
  },
