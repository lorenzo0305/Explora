  "rdfs:comment": {
    "de": [
      "Aperi'Klub ist nach dem Willen seiner beiden Betreiber, Nicolas und Florian, ein etwas besonderer Tisch, ein belebter Ort, an dem man gute Gerichte isst.\r\nGenießen Sie die gute Zubereitung in unserem Restaurant / Brasserie / Bar a Tapas & Cocktails..."
    ],
    "en": [
      "Aperi'Klub is from the will of its two managers, Nicolas and Florian, is a table a little special, a lively place where we eat good food"
    ],
    "it": [
      "L'Aperi'Klub, nato da un'idea dei suoi due gestori, Nicolas e Florian, è un luogo molto speciale, un posto vivace dove si mangia bene.\r\nVenite a gustare i nostri deliziosi piatti nel nostro Ristorante / Brasserie / Tapas & Cocktails Bar..."
    ],
    "fr": [
      "Aperi'Klub, de la volonté de ses deux gérants, Nicolas et Florian, est une table un peu particulière, un lieu animé où l'on mange de bons petits plats. \r\nVenez déguster les bonnes préparations dans notre Restaurant / Brasserie / Bar a Tapas & Cocktails.."
    ],
    "es": [
      "Aperi'Klub, la creación de sus dos gerentes, Nicolas y Florian, es un lugar muy especial, un lugar animado donde se puede comer bien.\r\nVenga y disfrute de nuestros deliciosos platos en nuestro Restaurante / Brasserie / Tapas & Cocktails Bar...."
    ],
    "nl": [
      "Aperi'Klub, het geesteskind van de twee managers, Nicolas en Florian, is een heel bijzondere plek, een levendige plek waar je lekker kunt eten.\r\nKom en geniet van onze heerlijke gerechten in ons Restaurant / Brasserie / Tapas & Cocktails Bar..."
    ]
  },
