  "rdfs:comment": {
    "de": [
      "Die in Doussard ansässige La Ferme des Castors ist ein biologischer Gemüsebaubetrieb mit Permakultur, der sich für eine lokale Landwirtschaft einsetzt, die die Natur respektiert und ohne chemische Hilfsmittel auskommt."
    ],
    "en": [
      "Based in Doussard, La Ferme des Castors is a permaculture organic market-gardening farm, committed to local agriculture that respects nature and uses no chemical inputs."
    ],
    "it": [
      "Con sede a Doussard, La Ferme des Castors è un'azienda agricola biologica in permacultura, impegnata in un'agricoltura locale che rispetta la natura e non utilizza input chimici."
    ],
    "fr": [
      "Installée à Doussard, La Ferme des Castors est une ferme maraîchère biologique en permaculture, engagée dans une agriculture locale, respectueuse de la nature et sans intrants chimiques."
    ],
    "es": [
      "La Ferme des Castors, situada en Doussard, es una explotación de permacultura ecológica y horticultura de mercado, comprometida con una agricultura de proximidad respetuosa con la naturaleza y sin insumos químicos."
    ],
    "nl": [
      "La Ferme des Castors, gevestigd in Doussard, is een biologische permacultuur tuinderij die zich inzet voor lokale landbouw die de natuur respecteert en geen chemische middelen gebruikt."
    ]
  },
  "rdfs:label": {
