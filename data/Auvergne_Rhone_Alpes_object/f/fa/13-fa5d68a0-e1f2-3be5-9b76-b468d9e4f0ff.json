  "rdfs:comment": {
    "de": [
      "San Palou's Knett empfängt Sie im Dekor eines amerikanischen Diners. Tagesmenü unter der Woche 16? mit Vorspeise, Hauptgericht und Dessert. Steakhouse mit Burgern und Grillgerichten am Freitag- und Samstagabend."
    ],
    "en": [
      "San Palou's Knett welcomes you in an American diner setting. Menu du jour weekdays 16? with starter, main course and dessert. Steakhouse with burgers and grills on Friday and Saturday evenings."
    ],
    "it": [
      "Il Knett di San Palou vi accoglie in un ambiente da American diner. Menu giornaliero nei giorni feriali 16? con antipasto, piatto principale e dessert. Steakhouse con hamburger e grigliate il venerdì e il sabato sera."
    ],
    "fr": [
      "Le San Palou's Knett vous accueille dans un décor de diner américain. Menu du jour en semaine 16 € avec entrée, plat et dessert. Steakhouse avec burgers et grillades le vendredi et samedi soir."
    ],
    "nl": [
      "San Palou's Knett verwelkomt je in een Amerikaanse diner setting. Dagmenu doordeweeks 16? met voorgerecht, hoofdgerecht en dessert. Steakhouse met hamburgers en grills op vrijdag- en zaterdagavond."
    ],
    "es": [
      "El Knett de San Palou le da la bienvenida en un ambiente de diner americano. Menú del día entre semana 16? con entrante, plato principal y postre. Asador con hamburguesas y parrilladas los viernes y sábados por la noche."
    ]
  },
  "rdfs:label": {
