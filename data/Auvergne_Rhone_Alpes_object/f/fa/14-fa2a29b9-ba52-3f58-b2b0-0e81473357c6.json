      "dc:description": {
        "de": [
          "19 KM LANGER WANDERWEG - 5 STUNDEN\nSTART AUF DEM RATHAUSPLATZ VON COLEMBERT\nNICHT MARKIERT - WANDERBUCH IM TOURISMUSBÜRO ERHÄLTLICH"
        ],
        "en": [
          "19 KM WALKING TRAIL - 5H\nDEPARTS FROM COLEMBERT TOWN HALL SQUARE\nNOT SIGNPOSTED - HIKER'S BOOKLET AVAILABLE FROM THE TOURIST OFFICE"
        ],
        "it": [
          "PERCORSO A PIEDI DI 19 KM - 5 ORE\nPARTE DALLA PIAZZA DEL MUNICIPIO DI COLEMBERT\nNON SEGNALATO - LIBRETTO PER ESCURSIONISTI DISPONIBILE PRESSO L'UFFICIO DEL TURISMO"
        ],
        "fr": [
          "SENTIER PEDESTRE DE 19 KM - 5H\nDEPART DE LA PLACE DE LA MAIRIE DE  COLEMBERT\nNON BALISEE - CARNET DU RANDONNEUR DISPONIBLE A L'OFFICE DE TOURISME"
        ],
        "es": [
          "RUTA A PIE DE 19 KM - 5 HORAS\nSALIDA DE LA PLAZA DEL AYUNTAMIENTO DE COLEMBERT\nNO SEÑALIZADO - FOLLETO PARA EXCURSIONISTAS DISPONIBLE EN LA OFICINA DE TURISMO"
        ],
        "nl": [
          "19 KM WANDELROUTE - 5 UUR\nSTART VANAF HET STADHUISPLEIN IN COLEMBERT\nNIET BEWEGWIJZERD - WANDELBOEKJE VERKRIJGBAAR BIJ HET TOERISTENBUREAU"
        ]
      },
