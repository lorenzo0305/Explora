  "rdfs:comment": {
    "de": [
      "Stéphane, Bergbegleiter und Mountainbike-Lehrer, hat sich in mehr als zwanzig Jahren, in denen er Berge und Wüsten auf der ganzen Welt durchwandert hat, eine solide Erfahrung angeeignet."
    ],
    "en": [
      "Stéphane, a mountain leader and mountain bike instructor, has acquired a wealth of experience over the past twenty years, traveling the world's mountains and deserts."
    ],
    "it": [
      "Stéphane, guida alpina e istruttore di mountain bike, ha accumulato un'esperienza di oltre vent'anni di viaggi sulle montagne e nei deserti del mondo."
    ],
    "fr": [
      "Stéphane, accompagnateur en montagne et moniteur de VTT, a acquis une solide expérience en parcourant les montagnes et les déserts à travers le monde depuis plus de vingt ans."
    ],
    "es": [
      "Stéphane, guía de montaña y monitor de bicicleta de montaña, acumula una gran experiencia recorriendo montañas y desiertos de todo el mundo desde hace más de veinte años."
    ],
    "nl": [
      "Stéphane, bergleider en mountainbike-instructeur, heeft meer dan twintig jaar ervaring opgedaan met reizen door de bergen en woestijnen van de wereld."
    ]
  },
