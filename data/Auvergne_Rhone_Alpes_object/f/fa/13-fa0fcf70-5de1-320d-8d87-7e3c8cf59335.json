  "rdfs:comment": {
    "de": [
      "Diese gotische Stiftskirche, die unter Denkmalschutz steht, wurde 1493 geweiht. Sie war von St. Apolinaire de Valence abhängig und wurde meist von einem Mitglied des Kapitels betreut."
    ],
    "en": [
      "Listed as a Monument Historique, this Gothic collegiate church was consecrated in 1493. It depended on St Apolinaire de Valence and was usually served by a member of the chapter."
    ],
    "it": [
      "Classificata come monumento storico, questa chiesa collegiata gotica fu consacrata nel 1493. Dipendeva da Sant'Apollinare di Valence e il più delle volte era servito da un membro del capitolo."
    ],
    "fr": [
      "Classée Monument Historique, cette collégiale gothique a été consacrée en 1493. Elle dépendait de St Apolinaire de Valence et fut le plus souvent desservie par un membre du chapitre."
    ],
    "nl": [
      "Deze gotische collegiale kerk, die op de monumentenlijst staat, werd in 1493 ingewijd. Ze hing af van St Apolinaire de Valence en werd gewoonlijk bediend door een lid van het kapittel."
    ],
    "es": [
      "Catalogada como monumento histórico, esta colegiata gótica fue consagrada en 1493. Dependía de San Apolinar de Valence y la mayoría de las veces era atendido por un miembro del cabildo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vestiges de la Collégiale Saint Prix"
    ]
  },
