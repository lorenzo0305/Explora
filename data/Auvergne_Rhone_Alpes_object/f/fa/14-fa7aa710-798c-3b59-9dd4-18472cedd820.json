  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/734b87c5-1b46-30aa-b83d-f8846d865765",
      "dc:description": {
        "de": [
          "Presse, Geschenke, Spielzeug und Plüschtiere, Artikel für den Aufenthalt (Toilettenartikel, Briefmarken, Postkarten, Telefonkarten), verschiedene Snacks sowie heiße und kalte Getränke."
        ],
        "en": [
          "Press, gifts, toys and cuddly toys, items for your stay (toiletries, stamps, postcards, telephone cards), various snacks, and hot and cold drinks."
        ],
        "it": [
          "Stampa, regali, giocattoli e peluche, articoli per il soggiorno (articoli da toilette, francobolli, cartoline, schede telefoniche), vari snack e bevande calde e fredde."
        ],
        "fr": [
          "Presse, cadeaux, jouets et peluches, articles pour le séjour (produits de toilette, timbres, cartes postales, cartes téléphoniques), diverses collations, et boissons chaudes et fraîches."
        ],
        "es": [
          "Prensa, regalos, juguetes y peluches, artículos para su estancia (artículos de aseo, sellos, postales, tarjetas telefónicas), aperitivos variados y bebidas frías y calientes."
        ],
        "nl": [
          "Pers, cadeautjes, speelgoed en knuffels, spullen voor je verblijf (toiletartikelen, postzegels, ansichtkaarten, telefoonkaarten), diverse snacks en warme en koude dranken."
        ]
      },
