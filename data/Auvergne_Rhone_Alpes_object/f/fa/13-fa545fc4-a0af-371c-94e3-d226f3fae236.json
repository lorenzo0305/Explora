  "rdfs:comment": {
    "de": [
      "Das Come Back ist ein richtiges Bistro!\r\nUnsere Brasserie verwöhnt Sie mit lokalen Produkten der Bäckerei \"Maison Jas\" und des Gemüsehändlers DJ Primeur aus Le Grand-Lemps.\r\nQualität ist bei jedem Gericht garantiert!"
    ],
    "en": [
      "Le Come Back, karrément bistrot!\r\nOur brasserie treats you to local produce from the \"Maison Jas\" bakery and the DJ Primeur market gardener in Grand-Lemps.\r\nQuality guaranteed in every dish!\r\nPassionate about meat? Our matured meats promise unforgettable flavors.\r\nEnjoy our daily menu, all-you-can-eat mussels and frogs evenings. Come and enjoy an explosive culinary experience!"
    ],
    "it": [
      "Le Come Back, un vero bistrot!\r\nLa nostra brasserie vi delizierà con i prodotti locali del panificio Maison Jas e dell'ortolano DJ Primeur di Grand-Lemps.\r\nQualità garantita in ogni piatto!"
    ],
    "fr": [
      "Le Come Back, karrément bistrot!\r\nNotre brasserie vous régale avec des produits locaux de la boulangerie “Maison Jas” et du maraîcher DJ Primeur du Grand-Lemps. \r\nQualité garantie dans chaque plat !"
    ],
    "nl": [
      "Le Come Back, een echte bistro!\r\nOnze brasserie verwent je met streekproducten van bakkerij Maison Jas en de tuinder DJ Primeur uit Grand-Lemps.\r\nKwaliteit gegarandeerd in elk gerecht!"
    ],
    "es": [
      "Le Come Back, ¡un auténtico bistró!\r\nNuestra brasserie le deleitará con los productos locales de la panadería Maison Jas y del horticultor DJ Primeur de Grand-Lemps.\r\n¡Calidad garantizada en cada plato!"
    ]
  },
