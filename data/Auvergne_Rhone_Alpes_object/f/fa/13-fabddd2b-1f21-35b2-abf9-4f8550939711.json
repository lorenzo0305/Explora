  "rdfs:comment": {
    "de": [
      "Jeden Dienstag, Mittwoch und Donnerstag (sowie freitags in den Schulferien) verwandelt sich das Iglu von 19:00 bis 21:00 Uhr in ein Restaurant und empfängt Sie zu einem außergewöhnlichen Abendessen mit einem echten savoyischen Fondue."
    ],
    "en": [
      "Every Tuesday, Wednesday and Thursday (as well as Fridays during the school holidays), from 7pm to 9pm, the igloo transforms into a restaurant and welcomes you for an exceptional dinner of real Savoyard fondue."
    ],
    "it": [
      "Ogni martedì, mercoledì e giovedì (oltre al venerdì durante le vacanze scolastiche), dalle 19.00 alle 21.00, l'igloo si trasforma in un ristorante e vi accoglie per una cena eccezionale a base di vera fonduta savoiarda."
    ],
    "fr": [
      "Tous les mardis, mercredis et jeudis (ainsi que les vendredis en période de vacances scolaires), de 19h à 21h, l’igloo se transforme en restaurant et vous accueille pour un dîner exceptionnel autour d’une véritable fondue savoyarde."
    ],
    "es": [
      "Todos los martes, miércoles y jueves (así como los viernes durante las vacaciones escolares), de 19:00 a 21:00, el iglú se transforma en restaurante y le da la bienvenida para una cena excepcional de auténtica fondue saboyana."
    ],
    "nl": [
      "Elke dinsdag, woensdag en donderdag (en vrijdag tijdens de schoolvakanties), van 19u tot 21u, verandert de iglo in een restaurant en heet je welkom voor een uitzonderlijk diner van echte Savoyaardse fondue."
    ]
  },
  "rdfs:label": {
