  "rdfs:comment": {
    "de": [
      "Erleben Sie das Abenteuer Natur in Châtel-Guyon.\r\nIn luftiger Höhe mitten im Wald können Sie die verschiedenen Baumkletterparcours entdecken, die Rätsel des \"Expérience Game\" lösen und die Region beim Geocaching erkunden."
    ],
    "en": [
      "Come and experience nature's adventure at Châtel-Guyon.\r\nHigh up in the forest, come and discover the various accrobranche courses, solve the riddles of the Experience Game\" and discover the region with Geocaching."
    ],
    "it": [
      "Venite a vivere l'avventura della natura a Châtel-Guyon.\r\nIn alto, in mezzo alla foresta, venite a scoprire i vari percorsi di accrobranche (arrampicata sugli alberi), a risolvere gli enigmi del Gioco dell'Esperienza\" e a scoprire la regione con il Geocaching."
    ],
    "fr": [
      "Venez vivre l'aventure nature à Châtel-Guyon.\r\nDans les hauteurs au beau milieu de la forêt, venez découvrir les différents parcours d'accrobranche, résoudre les énigmes de l'Expérience Game\", découvrir la région avec le Géocaching."
    ],
    "es": [
      "Venga a vivir la aventura de la naturaleza en Châtel-Guyon.\r\nEn lo alto, en pleno bosque, venga a descubrir los diferentes recorridos de accrobranche (escalada de árboles), resuelva los enigmas del Juego de la Experiencia\" y descubra la región con el Geocaching."
    ],
    "nl": [
      "Kom en beleef het avontuur van de natuur in Châtel-Guyon.\r\nKom hoog in het bos de verschillende accrobrancheparcoursen ontdekken, los de raadsels van het belevingsspel op en ontdek de streek met geocaching."
    ]
  },
  "rdfs:label": {
    "de": [
      "Hochseilgarten, geocaching und experiene game Parc écureuil"
    ],
    "en": [
      "Ecureuil tree climbing park, geocaching and experience game"
    ],
    "fr": [
      "Parc Écureuil"
    ],
    "nl": [
      "Ecureuil boomklimpark, experience game & geocaching"
    ]
  },
