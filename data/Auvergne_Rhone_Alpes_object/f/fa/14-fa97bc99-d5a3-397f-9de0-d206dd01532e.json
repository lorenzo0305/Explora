  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f9570f95-e746-3f62-8bd4-d691f5f8cc85",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nLa Mercerie Hollande bietet Stoffe und Zubehör für Kurzwaren an.\n\nÖffnungstage:\n\nDienstag von 10:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr\nMittwoch bis Samstag von 10:00 bis 13:00 Uhr\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nLa Mercerie Hollande offers haberdashery fabrics and accessories.\n\nOpening days:\n\nTuesday 10am to 12pm and 2pm to 6pm\nWednesday to Saturday, 10am to 1pm\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nLa Mercerie Hollande propone tessuti e accessori per la merceria.\n\nGiorni di apertura:\n\nMartedì dalle 10.00 alle 12.00 e dalle 14.00 alle 18.00\nDa mercoledì a sabato dalle 10.00 alle 13.00\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nLa Mercerie Hollande propose tissus et accessoires de mercerie.\n\nJours d'ouverture: \n\nMardi de 10h à 12h et de 14h à 18h\nDu mercredi au samedi de 10h à 13h\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nMercerie Hollande biedt fournituren en accessoires.\n\nOpeningsdagen:\n\nDinsdag van 10.00 tot 12.00 uur en van 14.00 tot 18.00 uur\nWoensdag tot zaterdag van 10 tot 13 uur\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nMercerie Hollande ofrece tejidos y accesorios de mercería.\n\nDías de apertura:\n\nMartes de 10h a 12h y de 14h a 18h\nDe miércoles a sábado de 10:00 a 13:00\n\n\n "
        ]
      },
