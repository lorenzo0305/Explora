  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6956c06b-557c-32c4-824d-738b0b1954f2",
      "dc:description": {
        "de": [
          "Mediterranes Restaurant mit Fischspezialitäten\n7 Tage die Woche geöffnet\n\nCOVID-Info: Gesundheitsmaßnahmen der Regierung, Gerichte zum Mitnehmen oder als Lieferservice möglich. Lieferung in einem Umkreis von 15 km mit einem Mindestbetrag von 30€. Über diesen Betrag hinaus: 5€. Reservierung unter +33 (0)3 21 94 65 11. Karte auf der Facebook-Seite verfügbar"
        ],
        "en": [
          "Mediterranean restaurant with fish specialties\nOpen 7 days a week\n\nInfo COVID: Government sanitary measures, Possibility of take away or delivery. Delivery within a radius of 15 km with a minimum of 30€. Beyond that : 5€. Reservation at +33 (0)3 21 94 65 11. Map available on the Facebook page"
        ],
        "it": [
          "Ristorante mediterraneo con specialità di pesce\nAperto 7 giorni su 7\n\nCOVID Info: Misure sanitarie governative, Possibilità di asporto o consegna. Consegna nel raggio di 15 km con un minimo di 30? Oltre a questo: 5? Prenotazione al numero +33 (0)3 21 94 65 11. Mappa disponibile sulla pagina Facebook"
        ],
        "fr": [
          "Restaurant méditerranéen avec spécialités poissons\nOuvert 7j/7\n\nInfo COVID : Mesures sanitaires gouvernementales, Possibilité de plats à emporter ou en livraison. Livraison dans un rayon de 15 km avec un minimum de 30€. Au-delà : 5€. Réservation au +33 (0)3 21 94 65 11. Carte disponible sur la page Facebook"
        ],
        "es": [
          "Restaurante mediterráneo con especialidades de pescado\nAbierto los 7 días de la semana\n\nInformación de COVID: Medidas sanitarias gubernamentales, Posibilidad de llevar o entregar. Entrega en un radio de 15 km con un mínimo de 30? Más allá de eso: ¿5? Reserva en el +33 (0)3 21 94 65 11. Mapa disponible en la página de Facebook"
        ],
        "nl": [
          "Mediterraan restaurant met visspecialiteiten\n7 dagen per week geopend\n\nCOVID Info: Sanitaire overheidsmaatregelen, Mogelijkheid tot afhalen of bezorgen. Levering binnen een straal van 15 km met een minimum van 30? Daarbuiten: 5? Reservering op +33 (0)3 21 94 65 11. Kaart beschikbaar op de Facebook-pagina"
        ]
      },
