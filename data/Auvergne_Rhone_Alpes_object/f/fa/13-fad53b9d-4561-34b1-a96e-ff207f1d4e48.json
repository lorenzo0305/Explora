  "rdfs:comment": {
    "de": [
      "Ein Pickleballplatz steht Ihnen im Zentrum des Dorfes Crest-Voland neben der Seilbahn „La Logère” zur Verfügung. Eine Reservierung beim Fremdenverkehrsamt von Crest-Voland Cohennoz ist erforderlich."
    ],
    "en": [
      "A pickleball court is available in the centre of the village of Crest-Voland, next to the Logère cable car. Booking is required at the Crest-Voland Cohennoz Tourist Office."
    ],
    "it": [
      "Un campo da pickleball è disponibile nel centro del villaggio di Crest-Voland, vicino alla funivia della Logère. Le prenotazioni devono essere effettuate presso l'Ufficio del Turismo di Crest-Voland Cohennoz."
    ],
    "fr": [
      "Un terrain de pickleball est à votre disposition au centre du village de Crest-Voland, à côté de la télécabine de la Logère. Réservation obligatoire auprès de l'Office de Tourisme de Crest-Voland Cohennoz."
    ],
    "nl": [
      "In het centrum van het dorp Crest-Voland, naast de kabelbaan Logère, is een picklebalveld beschikbaar. Reserveringen moeten worden gemaakt bij het toeristenbureau van Crest-Voland Cohennoz."
    ],
    "es": [
      "En el centro del pueblo de Crest-Voland, junto al teleférico de Logère, hay un campo de pickleball. Hay que reservar en la Oficina de Turismo de Crest-Voland Cohennoz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terrain de Pickleball"
    ]
  },
