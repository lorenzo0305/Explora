  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Wandern mit einem Esel in Begleitung von Lydie,\r\nmärchenwanderungen oder Workshops zur Entdeckung des Esels\r\nmit Lydie, einer begeisterten Eselstreiberin und Geschichtenerzählerin."
    ],
    "en": [
      "Discover donkey trekking with Lydie,\r\nstorytelling walks or donkey discovery workshops\r\nwith Lydie, a passionate donkey rider and storyteller."
    ],
    "it": [
      "Scoprite il trekking con gli asini con Lydie,\r\nle passeggiate di narrazione o i laboratori di scoperta dell'asino\r\ncon Lydie, appassionata cavallerizza e narratrice di asini."
    ],
    "fr": [
      "Découvrez la randonnée avec un âne accompagnée de Lydie,\r\ndes balades contées ou des ateliers découverte de l’âne\r\navec Lydie, ânière et conteuse passionnée."
    ],
    "nl": [
      "Ontdek ezeltochten met Lydie,\r\nverhalenwandelingen of ezelontdekkingsworkshops\r\nmet Lydie, een gepassioneerde ezelrijdster en verhalenvertelster."
    ],
    "es": [
      "Descubre los paseos en burro con Lydie\r\npaseos narrativos o talleres para descubrir a los burros\r\ncon Lydie, apasionada jinete de burros y cuentacuentos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association A Fleur d'Ane"
    ]
  },
