  "rdfs:comment": {
    "de": [
      "Laden Sie das Faltblatt für den Rundgang herunter und machen Sie sich auf den Weg, um das Dorf Saint-Fargeol kennenzulernen. Entdecken Sie seine charakteristischsten Bauwerke anhand eines Rundgangs, der seine Geschichte und sein Erbe in Szene setzt."
    ],
    "en": [
      "Download the brochure of the tour and discover the village of Saint-Fargeol and its most characteristic monuments by means of a tour highlighting its history and heritage."
    ],
    "it": [
      "Scaricate l'opuscolo del tour e scoprite il villaggio di Saint-Fargeol e i suoi monumenti più caratteristici attraverso un percorso che ne evidenzia la storia e il patrimonio."
    ],
    "fr": [
      "Téléchargez le dépliant du circuit et partez à la rencontre du village de Saint-Fargeol, en découvrant ses monuments les plus caractéristiques au moyen d'un parcours mettant en scène son histoire et son patrimoine."
    ],
    "nl": [
      "Download de folder van de rondleiding en ontdek het dorp Saint-Fargeol en zijn meest karakteristieke monumenten aan de hand van een route die de geschiedenis en het erfgoed belicht."
    ],
    "es": [
      "Descargue el folleto de la visita y descubra el pueblo de Saint-Fargeol y sus monumentos más característicos a través de un recorrido que pone de relieve su historia y su patrimonio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours découverte de Saint-Fargeol"
    ]
  },
