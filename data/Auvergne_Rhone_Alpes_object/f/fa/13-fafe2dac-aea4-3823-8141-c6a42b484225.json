  "rdfs:comment": {
    "de": [
      "Die Gemeinde Plateau d'Hauteville ist mit fünf Picknickplätzen ausgestattet, dieser befindet sich in der Nähe der Kapelle von Mazières."
    ],
    "en": [
      "The Plateau d'Hauteville commune is equipped with five picnic areas, this one near the Mazières chapel."
    ],
