  "rdfs:comment": {
    "de": [
      "Restaurant, Bar und Gîte d'étape.\r\nVerbringen Sie eine angenehme und leckere Zeit im Maison Forestière. Traditionelle Küche, \"hausgemacht\"; geselliger und gemütlicher Ort."
    ],
    "en": [
      "Restaurant, Bar and Gîte d'étape.\r\nCome and spend a pleasant, gourmet moment at the Maison Forestière. Traditional, home-cooked cuisine in a warm, friendly atmosphere."
    ],
    "it": [
      "Ristorante, Bar e Gîte di sosta.\r\nVenite a gustare un pasto delizioso alla Maison Forestière. Cucina tradizionale e casalinga in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Restaurant, Bar et Gîte d'étape.\r\nVenez passer un moment gourmand et agréable à la Maison Forestière. Cuisine traditionnelle, \"fait maison\" ; lieu convivial et chaleureux."
    ],
    "es": [
      "Restaurante, Bar y Casa Rural de Parada.\r\nDisfrute de una deliciosa comida en la Maison Forestière. Cocina tradicional y casera en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Restaurant, bar en gîte met tussenstop.\r\nKom genieten van een heerlijke maaltijd in Maison Forestière. Traditionele, huisgemaakte gerechten in een warm en vriendelijk kader."
    ]
  },
