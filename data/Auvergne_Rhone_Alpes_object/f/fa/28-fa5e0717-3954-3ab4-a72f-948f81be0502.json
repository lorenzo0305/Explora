  "rdfs:comment": {
    "de": [
      "Der Poney Club de la Bohême bietet Ihnen die Möglichkeit, in einer freundlichen Atmosphäre Dressur- und Springreiten zu erlernen und zu perfektionieren."
    ],
    "en": [
      "The Bohemian Pony Club offers you the opportunity to learn and improve your skills in dressage and show jumping in a friendly atmosphere."
    ],
    "it": [
      "Il Pony Club de la Bohême vi offre l'opportunità di imparare e migliorare le vostre abilità nel dressage e nel salto ostacoli in un'atmosfera amichevole."
    ],
    "fr": [
      "Le Poney Club de la Bohême vous propose de vous initier et de vous perfectionner au dressage et  saut d’obstacles dans une ambiance conviviale."
    ],
    "es": [
      "El Pony Club de la Bohême le ofrece la oportunidad de aprender y mejorar sus habilidades de doma y salto de obstáculos en un ambiente agradable."
    ],
    "nl": [
      "De Pony Club de la Bohême biedt u de mogelijkheid om in een gezellige sfeer uw dressuur- en springvaardigheden te leren en te verbeteren."
    ]
  },
