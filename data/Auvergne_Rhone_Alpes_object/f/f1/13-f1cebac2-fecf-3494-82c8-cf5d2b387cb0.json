  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant & Lyoner. Lokale und frische Produkte. Jeden Mittag 2 Vorspeisen zur Auswahl, ein Fisch, ein Fleisch, lokale Käsesorten und hausgemachte Desserts.\r\nGerichte à la carte, die die Jahreszeiten & die regionale und Lyoner Gastronomie respektieren!"
    ],
    "en": [
      "Traditional Lyonnais restaurant. Fresh local produce. A choice of 2 starters, fish, meat, local cheeses and homemade desserts every lunchtime.\r\nA la carte dishes that respect the seasons & regional and Lyonnais gastronomy!"
    ],
    "it": [
      "Ristorante tradizionale lionese. Prodotti freschi locali. A pranzo, una scelta di 2 antipasti, pesce, carne, formaggi locali e dolci fatti in casa.\r\nPiatti alla carta che rispettano le stagioni e la gastronomia regionale e lionese!"
    ],
    "fr": [
      "Restaurant traditionnel & Lyonnais. Produits locaux et frais. Chaque midi 2 entrées au choix, un poisson, une viande, des fromages locaux et desserts maison.\r\nDes plats à la carte qui respectent les saisons & la gastronomie régionale et Lyonnaise !"
    ],
    "nl": [
      "Traditioneel Lyonnais restaurant. Verse lokale producten. Elke middag keuze uit 2 voorgerechten, vis, vlees, lokale kazen en huisgemaakte desserts.\r\nA la carte gerechten die de seizoenen en de regionale en Lyonnaise gastronomie respecteren!"
    ],
    "es": [
      "Restaurante tradicional lionés. Productos locales frescos. 2 entrantes a elegir, pescado, carne, quesos locales y postres caseros cada mediodía.\r\nPlatos a la carta que respetan las estaciones y la gastronomía regional y lionesa"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Crouton des Gones"
    ]
  },
