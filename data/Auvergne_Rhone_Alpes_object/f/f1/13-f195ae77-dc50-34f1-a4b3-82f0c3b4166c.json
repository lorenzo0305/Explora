  "rdfs:comment": {
    "de": [
      "Die Gemeinde Tulette verfügt über 1 Ladestation, an der gleichzeitig 2 Elektrofahrzeuge aufgeladen werden können: 2 Parkplätze, die ausschließlich für diese Nutzung des elektrischen Aufladens reserviert sind."
    ],
    "en": [
      "The commune of Tulette has 1 charging point for simultaneous recharging of 2 electric vehicles: 2 parking spaces reserved for this purpose only."
    ],
    "it": [
      "Tulette dispone di 1 punto di ricarica per la ricarica simultanea di 2 veicoli elettrici: 2 posti auto riservati esclusivamente a questo scopo."
    ],
    "fr": [
      "La commune de Tulette dispose d'1 borne pour recharger en simultané 2 véhicules électriques : 2 places de stationnement réservées à cet usage de recharge électrique uniquement."
    ],
    "nl": [
      "Tulette heeft 1 oplaadpunt voor het gelijktijdig opladen van 2 elektrische voertuigen: 2 parkeerplaatsen uitsluitend voor dit doel gereserveerd."
    ],
    "es": [
      "Tulette dispone de 1 punto de carga para la recarga simultánea de 2 vehículos eléctricos: 2 plazas de aparcamiento reservadas exclusivamente para este fin."
    ]
  },
