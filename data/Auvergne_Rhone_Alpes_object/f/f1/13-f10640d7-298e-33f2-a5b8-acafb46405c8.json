  "rdfs:comment": {
    "de": [
      "Die Kirche von Saillant besitzt den einzigen noch intakten Glockenturm aus der romanischen Periode im Bezirk Ambert."
    ],
    "en": [
      "This roman church has the only intact steeple of the XVth Century in Ambert’s neighbourhood. Its chapels in the aisles are dedicated to the important families of the Ance valley."
    ],
    "it": [
      "La chiesa di Saillant possiede l'unico campanile romanico intatto del distretto di Ambert."
    ],
    "fr": [
      "L'église de Saillant possède le seul clocher de la période romane encore intact sur l'arrondissement d'Ambert."
    ],
    "es": [
      "La iglesia de Saillant posee el único campanario románico intacto del barrio de Ambert."
    ],
    "nl": [
      "De kerk van Saillant heeft de enige intacte Romaanse klokkentoren in het district Ambert."
    ]
