          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Das Hotel ist 7/7 Tage geöffnet:\r\n- Die Anreise ist von 16:00 bis 19:30 Uhr, die Abreise bis 11:30 Uhr.\r\n- \"Le Bistrot de l'Auberge\" Geöffnet Montag Abend & Dienstag Abend, Donnerstag, Freitag & Samstag Mittag & Abend, Sonntag Mittag;\r\n- \" Restaurant l'Intimiste \" Geöffnet von Donnerstagabend bis Sonntagmittag."
            ],
            "en": [
              "Hotel open 7/7 days:\r\n- Arrivals are from 4:00 pm to 7:30 pm, and departures before 11:30 am.\r\n- \"Le Bistrot de l'Auberge\" open Monday evening & Tuesday evening, Thursday, Friday & Saturday lunch & dinner, Sunday lunch;\r\n- \"Restaurant l'Intimiste\" Open Thursday evening to Sunday lunchtime."
            ],
            "it": [
              "Hotel aperto 7/7 giorni:\r\n- Arrivi dalle 16.00 alle 19.30 e partenze entro le 11.30.\r\n- \"Le Bistrot de l'Auberge\" aperto lunedì sera e martedì sera, giovedì, venerdì e sabato a pranzo e cena, domenica a pranzo;\r\n- \"Restaurant l'Intimiste\" aperto dal giovedì sera alla domenica a pranzo."
            ],
            "fr": [
              "Hôtel ouvert 7/7 jours :\r\n- Les arrivées sont de 16h00 à 19h30, et les départs avant 11h30.\r\n- « Le Bistrot de l'Auberge» Ouvert lundi soir & mardi soir, jeudi, vendredi & samedi midi & soir, dimanche midi ;\r\n- « Restaurant l'Intimiste » Ouvert du jeudi soir au dimanche midi."
            ],
            "es": [
              "Hotel abierto 7/7 días:\r\n- Llegadas de 16:00 a 19:30 y salidas antes de las 11:30.\r\n- \"Le Bistrot de l'Auberge\" abierto lunes noche y martes noche, jueves, viernes y sábado comida y cena, domingo comida;\r\n- \"Restaurant l'Intimiste\" abierto de jueves por la noche a domingo a mediodía."
            ],
            "nl": [
              "Hotel 7/7 dagen geopend:\r\n- Aankomst van 16.00 tot 19.30 uur en vertrek voor 11.30 uur.\r\n- \"Le Bistrot de l'Auberge\" open maandagavond & dinsdagavond, donderdag, vrijdag & zaterdag lunch & diner, zondag lunch;\r\n- \"Restaurant l'Intimiste' geopend van donderdagavond tot zondagmiddag."
            ]
          },
