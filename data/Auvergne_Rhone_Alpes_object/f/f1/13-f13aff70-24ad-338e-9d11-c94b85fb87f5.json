  "rdfs:comment": {
    "de": [
      "Das Hotel L'Auberge Bressane in Buellas ist der ideale Ort, um eine Pause einzulegen oder sich mit Freunden zu treffen. Der Ort hat den ganzen Charme der traditionellen Bresse bewahrt."
    ],
    "en": [
      "L'Auberge Bressane de Buellas is the ideal place to take a break or catch up with friends. The place has retained all the charm of traditional Bresse."
    ],
    "it": [
      "L'hotel L'Auberge Bressane de Buellas è il luogo ideale per una pausa o per incontrare gli amici. Il luogo ha conservato tutto il fascino della Bresse tradizionale."
    ],
    "fr": [
      "L'hôtel L’Auberge Bressane de Buellas est le lieu idéal pour faire une pause ou rejoindre des amis. L'endroit a conservé tout le charme de la Bresse traditionnelle."
    ],
    "es": [
      "El hotel L'Auberge Bressane de Buellas es el lugar ideal para descansar o reunirse con los amigos. El lugar ha conservado todo el encanto de la Bresse tradicional."
    ],
    "nl": [
      "De Auberge Bressane de Buellas is de ideale plek om er even tussenuit te gaan of om vrienden te ontmoeten. De plaats heeft alle charme van de traditionele Bresse behouden."
    ]
