  "rdfs:comment": {
    "de": [
      "Die pädagogische Website des Col de Tournu zeigt die Landschaft aus der Sicht eines Försters, einer Landwirtin und einer Landschaftsgestalterin.\r\nEine Realisierung in Partnerschaft zwischen der Agglo, dem Office National des Forêts und FiBois."
    ],
    "en": [
      "The Col de Tournu educational site presents the landscape through the eyes of a forester, a farmer and a landscaper.\r\nA partnership between the Agglo, the Office National des Forêts and FiBois."
    ],
    "it": [
      "Il sito didattico del Col de Tournu mostra il paesaggio attraverso gli occhi di un forestale, di un agricoltore e di un paesaggista.\r\nUn progetto congiunto tra l'Agglo, l'Office National des Forêts e FiBois."
    ],
    "fr": [
      "Le site pédagogique du Col de Tournu donne à voir le paysage à travers les regards d’un forestier, une agricultrice et une paysagère.\r\nUne réalisation en partenariat entre l'Agglo, l'Office National des Forêts et FiBois."
    ],
    "es": [
      "El sitio educativo del Col de Tournu muestra el paisaje a través de los ojos de un silvicultor, un agricultor y un paisajista.\r\nUn proyecto conjunto de Agglo, la Office National des Forêts y FiBois."
    ],
    "nl": [
      "De educatieve site Col de Tournu laat het landschap zien door de ogen van een boswachter, een boer en een landschapsarchitect.\r\nHet project is een samenwerking tussen de Agglo, het Office National des Forêts en FiBois."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site pédagogique du Col de Tournu - Trois regards sur un paysage de collines"
    ]
  },
