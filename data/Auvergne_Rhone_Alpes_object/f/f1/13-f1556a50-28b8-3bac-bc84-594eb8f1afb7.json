  "rdfs:comment": {
    "de": [
      "Der Saal hat eine Kapazität von 361 Sitzplätzen und ist mit einer versenkbaren Tribüne (147 Plätze), einer Technikkabine (Licht und Ton) und WIFI ausgestattet.  Der Saal wird für Sitzungen, Konferenzen, Generalversammlungen und Aufführungen genutzt."
    ],
    "en": [
      "The 361-seat hall is equipped with a retractable stand (147 seats), a technical booth (sound and lighting) and WIFI.  The hall is used for meetings, conferences, general assemblies and shows."
    ],
    "it": [
      "La sala da 361 posti è dotata di una tribuna retrattile (147 posti), di una cabina tecnica (audio e luci) e di WIFI.  La sala viene utilizzata per riunioni, conferenze, assemblee generali e spettacoli."
    ],
    "fr": [
      "Salle d’une capacité de 361 places assises, est équipé d’une tribune rétractable  (147 places), d’une cabine technique (son et lumière) et de la  WIFI.  Cette salle est utilisée pour des réunions, conférences, assemblée générale, spectacles."
    ],
    "es": [
      "La sala, con 361 plazas, está equipada con una tribuna retráctil (147 plazas), una cabina técnica (sonido e iluminación) y WIFI.  La sala se utiliza para reuniones, conferencias, asambleas generales y espectáculos."
    ],
    "nl": [
      "De zaal met 361 zitplaatsen is uitgerust met een uitschuifbare tribune (147 zitplaatsen), een technische stand (geluid en licht) en WIFI.  De zaal wordt gebruikt voor vergaderingen, conferenties, algemene bijeenkomsten en shows."
    ]
  },
