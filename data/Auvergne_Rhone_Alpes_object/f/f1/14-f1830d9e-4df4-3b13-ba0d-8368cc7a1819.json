  "rdfs:comment": {
    "de": [
      "Eingebettet in das charmante Dorf Savy-Berlette, öffnet Ihnen Le Chambord seine Türen für ein authentisches und geselliges kulinarisches Erlebnis. Hier trifft Tradition auf Leidenschaft, und jedes Gericht erzählt eine Geschichte von lokalen Aromen und handwerklichem Können."
    ],
    "en": [
      "Nestled in the charming village of Savy-Berlette, Le Chambord opens its doors to you for an authentic and convivial culinary experience. Here, tradition meets passion, and each dish tells a story of local flavors and savoir-faire."
    ],
    "it": [
      "Situato nell'incantevole villaggio di Savy-Berlette, Le Chambord vi apre le porte per un'esperienza culinaria autentica e conviviale. Qui la tradizione incontra la passione e ogni piatto racconta una storia di sapori e competenze locali."
    ],
    "fr": [
      "Niché dans le charmant village de Savy-Berlette, Le Chambord vous ouvre ses portes pour une expérience culinaire authentique et conviviale. Ici, la tradition rencontre la passion, et chaque plat raconte une histoire de saveurs locales et de savoir-faire."
    ],
    "nl": [
      "Genesteld in het charmante dorpje Savy-Berlette, opent Le Chambord zijn deuren voor u voor een authentieke en gezellige culinaire ervaring. Hier ontmoeten traditie en passie elkaar en elk gerecht vertelt een verhaal van lokale smaken en expertise."
    ],
    "es": [
      "Enclavado en el encantador pueblo de Savy-Berlette, Le Chambord le abre sus puertas para vivir una experiencia culinaria auténtica y acogedora. Aquí, la tradición se une a la pasión, y cada plato cuenta una historia de sabores locales y experiencia."
    ]
  },
