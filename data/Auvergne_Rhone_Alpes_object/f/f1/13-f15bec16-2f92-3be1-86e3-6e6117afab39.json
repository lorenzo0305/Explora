  "rdfs:comment": {
    "de": [
      "Dieser Ort befindet sich auf einem unauffälligen Felsgrat, nicht weit entfernt vom berühmten Pierre Percée, der der Stolz des Matheysin-Plateaus ist. Ruhig und in der Natur, ideal für Familienausflüge"
    ],
    "en": [
      "This site is located on a discrete rocky ridge, not far from the famous Pierre Percée which is the pride of the Matheysin plateau. Quiet and in the nature, ideal for family outings"
    ],
    "it": [
      "Questo sito si trova su una discreta sosta rocciosa non lontana della famosa Pierre Percée che fa l'orgoglio del Plateau Matheysin. Calma e in natura, ideale per le uscite in famiglia."
    ],
    "fr": [
      "Ce site se trouve sur une discrète arrête rocheuse, pas très loin de la fameuse Pierre Percée qui fait la fierté du plateau Matheysin. Calme et dans la nature, idéale pour les sorties en famille"
    ],
    "es": [
      "Este lugar está situado en una discreta cresta rocosa, no lejos de la famosa Pierre Percée, orgullo de la meseta de Matheysin. Tranquilo y rodeado de naturaleza, ideal para paseos en familia"
    ],
    "nl": [
      "Deze camping ligt op een discrete rotsrichel, niet ver van de beroemde Pierre Percée, de trots van het plateau van Matheysin. Rustig en midden in de natuur, ideaal voor gezinsuitstapjes"
    ]
  },
  "rdfs:label": {
