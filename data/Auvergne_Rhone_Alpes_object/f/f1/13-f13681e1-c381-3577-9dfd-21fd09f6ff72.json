  "rdfs:comment": {
    "de": [
      "Die aus Vietnam stammende Thâm Thuy bietet Ihnen einen wahren kulinarischen Garten, in dem Sie alle Geschmäcker ihrer Kindheit entdecken können.\r\nSie zaubert Ihnen jeden Monat ein neues Menü aus frischen Zutaten von lokalen Produzenten."
    ],
    "en": [
      "Thâm Thuy, originally from Vietnam, offers you a culinary garden where you can discover all the flavours of her childhood.\r\nShe concocts a new menu every month using fresh produce from local producers."
    ],
    "it": [
      "Thâm Thuy, originaria del Vietnam, vi offre un vero e proprio giardino culinario dove potrete scoprire tutti i sapori della sua infanzia.\r\nOgni mese elabora un nuovo menu utilizzando prodotti freschi provenienti da produttori locali."
    ],
    "fr": [
      "Thâm Thuy, originaire du Vietnam  vous propose un véritable jardin culinaire où vous découvrirez toutes les saveurs de son enfance.\r\nElle vous concocte un nouveau menu tous les mois à base de produits frais issus des producteurs locaux."
    ],
    "es": [
      "Thâm Thuy, originaria de Vietnam, le ofrece un auténtico jardín culinario donde descubrir todos los sabores de su infancia.\r\nCada mes elabora un nuevo menú con productos frescos de productores locales."
    ],
    "nl": [
      "Thâm Thuy, oorspronkelijk uit Vietnam, biedt je een ware culinaire tuin waar je alle smaken uit haar kindertijd kunt ontdekken.\r\nElke maand stelt ze een nieuw menu samen met verse producten van lokale producenten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Little Garden"
    ],
    "fr": [
      "Restaurant Little Garden"
    ]
  },
