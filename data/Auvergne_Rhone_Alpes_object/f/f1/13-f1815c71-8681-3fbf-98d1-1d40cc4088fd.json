  "rdfs:comment": {
    "de": [
      "Keramikpraktikum für Kinder\r\nDieses Jahr haben Ihre Kinder die Gelegenheit, bei einem Töpferkurs zu kreieren, zu lernen und ihre Hände in die Erde zu stecken"
    ],
    "en": [
      "Children's pottery workshop\r\nThis year, your children will have the opportunity to create, learn and get their hands dirty at a pottery workshop"
    ],
    "it": [
      "Corso di ceramica per bambini\r\nQuest'anno i vostri bambini avranno la possibilità di creare, imparare e sporcarsi le mani con un corso di ceramica"
    ],
    "fr": [
      "Stage céramique enfant\r\nCette année, c'est l'occasion pour vos enfants de venir créer, apprendre, et mettre les mains dans la terre lors d’un stage de poterie"
    ],
    "nl": [
