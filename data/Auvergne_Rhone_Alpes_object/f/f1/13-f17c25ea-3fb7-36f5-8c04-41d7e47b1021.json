  "rdfs:comment": {
    "de": [
      "Léo CHAUVIN, Imker in der Gegend von Chabeuil. Ich bewege meine Bienenstöcke in der Saison, um den Blüten zu folgen und abwechslungsreichen Honig anzubieten, wobei meine Bienen das ganze Jahr über ihre Bedürfnisse befriedigen können."
    ],
    "en": [
      "Léo CHAUVIN, beekeeper in the Chabeuil area, I move my hives in season to follow the flowering and offer a variety of honeys, while allowing my bees to meet their needs throughout the year."
    ],
    "it": [
      "Léo CHAUVIN, apicoltore della zona di Chabeuil, sposto i miei alveari in base alla stagione per seguire la fioritura e offrire una varietà di mieli, permettendo alle mie api di soddisfare le loro esigenze durante tutto l'anno."
    ],
    "fr": [
      "Léo CHAUVIN, apiculteur sur le secteur de Chabeuil, je déplace mes ruches en saison pour suivre les floraisons et proposer des miels variés, tout en permettant à mes abeilles de subvenir à leurs besoins tout au long de l'année."
    ],
    "nl": [
      "Léo CHAUVIN, imker in de buurt van Chabeuil, ik verplaats mijn bijenkasten in het seizoen om de bloei te volgen en een verscheidenheid aan honingsoorten aan te bieden, terwijl mijn bijen het hele jaar door in hun behoeften kunnen voorzien."
    ],
    "es": [
      "Léo CHAUVIN, apicultor en la zona de Chabeuil, desplazo mis colmenas en temporada para seguir la floración y ofrecer una variedad de mieles, al tiempo que permito a mis abejas satisfacer sus necesidades durante todo el año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Mauricettes - Apiculteur"
    ]
  },
