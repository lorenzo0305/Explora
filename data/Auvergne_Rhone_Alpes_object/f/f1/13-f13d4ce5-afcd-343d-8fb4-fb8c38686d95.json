  "rdfs:comment": {
    "de": [
      "Wir treffen uns ab 19 Uhr im Festsaal für einen unvergesslichen Abend! Kommen Sie zahlreich, um zu feiern und einen geselligen Moment zu teilen."
    ],
    "en": [
      "Join us in the village hall from 7pm for an unforgettable evening! Come one, come all to celebrate and share a convivial moment."
    ],
    "it": [
      "Unitevi a noi nella sala del villaggio dalle 19:00 per una serata indimenticabile! Venite tutti a festeggiare e a condividere un momento di convivialità."
    ],
    "fr": [
      "Rendez-vous à la salle des fêtes dès 19h pour une soirée inoubliable ! Venez nombreux faire la fête et partager un moment convivial."
    ],
    "es": [
      "Únase a nosotros en la sala de fiestas del pueblo a partir de las 19:00 para disfrutar de una velada inolvidable Vengan todos a celebrar y compartir un momento de convivencia."
    ],
    "nl": [
      "Kom vanaf 19.00 uur naar het dorpshuis voor een onvergetelijke avond! Kom allen om feest te vieren en een gezellig moment te delen."
    ]
  },
  "rdfs:label": {
