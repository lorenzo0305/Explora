  "rdfs:comment": {
    "de": [
      "Ein Verkostungsraum, ein Versammlungsraum.\r\nDie Weinkellerei La Sérigoule verfügt über einen Verkostungsraum, in dem der Kellermeister Sie auf thematische Weinproben mitnimmt. Für Unternehmen steht außerdem ein Tagungsraum zur Verfügung."
    ],
    "en": [
      "A tasting room and a meeting room.\r\nLa Sérigoule cellar has a tasting room, where the cellar master can take you on themed tastings. A meeting room is also available for companies."
    ],
    "it": [
      "Una sala di degustazione e una sala riunioni.\r\nLa cantina La Sérigoule dispone di una sala di degustazione, dove il maestro di cantina può accompagnarvi in degustazioni a tema. Per le aziende è disponibile anche una sala riunioni."
    ],
    "fr": [
      "Une salle de dégustation, une salle de réunion.\r\nLa cave La Sérigoule dispose d’une salle de dégustation, où le caviste vous emmènera sur des dégustations à thèmes. Une salle de réunion est aussi à disposition pour les entreprises."
    ],
    "es": [
      "Una sala de degustación y una sala de reuniones.\r\nLa bodega La Sérigoule dispone de una sala de degustación, donde el maestro bodeguero le propone degustaciones temáticas. También dispone de una sala de reuniones para empresas."
    ],
    "nl": [
      "Een proefruimte en een vergaderruimte.\r\nDe wijnkelder van La Sérigoule heeft een proeflokaal, waar de keldermeester je kan meenemen op themaproeverijen. Er is ook een vergaderruimte beschikbaar voor bedrijven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de dégustation"
    ]
  },
