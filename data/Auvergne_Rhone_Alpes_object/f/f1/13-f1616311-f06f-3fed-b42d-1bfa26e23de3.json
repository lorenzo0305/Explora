  "rdfs:comment": {
    "de": [
      "Ausstrahlung von aktuellen Mainstream-Filmen, aber auch Arthouse-Vorstellungen. Neuer Saal mit ausgezeichneten Komfortbedingungen. Jedes Jahr im April findet ein Aurnalpin-Filmfestival statt."
    ],
    "en": [
      "Screening of current mainstream films, as well as art house screenings. Recent theater with excellent comfort conditions. Annual Aurnalpin film festival in April."
    ],
    "it": [
      "Film mainstream che fanno notizia, ma anche proiezioni d'autore. Cinema recente con ottime condizioni di comfort. Ogni aprile si tiene il festival cinematografico Aurnalpin."
    ],
    "fr": [
      "Diffusion des films grand public qui font l'actualité, mais aussi séances d'art et essai. Salle récente avec d'excellentes conditions de confort. Organisation chaque année en avril d'un festival du film Aurnalpin."
    ],
    "es": [
      "Películas de actualidad, pero también proyecciones de arte y ensayo. Cine reciente con excelentes condiciones de confort. En abril se celebra el festival de cine Aurnalpin."
    ],
    "nl": [
      "Mainstream films die in het nieuws zijn, maar ook arthouse vertoningen. Recente bioscoop met uitstekend comfort. Elk jaar in april wordt er een Aurnalpin filmfestival gehouden."
    ]
  },
