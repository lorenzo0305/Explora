  "rdfs:comment": {
    "de": [
      "Das SKOB liegt am Fuße der Pisten an der Schneefront und bietet eine traditionelle Küche, in der sich die Aromen der Berge und des Nordens vermischen. Die großzügigen Gerichte und die belgischen und französischen Biere können Sie auf der Sonnenterrasse oder im Innenbereich genießen."
    ],
    "en": [
      "Located at the foot of the slopes on the snow front, SKOB offers traditional cuisine combining mountain and northern flavors, with generous dishes and Belgian and French beers, to be enjoyed on the sunny terrace or indoors."
    ],
    "it": [
      "Situato ai piedi delle piste, sul fronte della neve, lo SKOB propone una cucina tradizionale che unisce i sapori della montagna e del nord, con piatti abbondanti e birre belghe e francesi, da gustare sulla terrazza soleggiata o all'interno."
    ],
    "fr": [
      "Situé au pied des pistes sur le front de neige, le SKOB propose une cuisine traditionnelle mêlant saveurs de la montagne et du Nord, avec des plats généreux et des bières belges et françaises, à savourer en terrasse au soleil ou à l'intérieur."
    ],
    "es": [
      "Situado al pie de las pistas, en primera línea de nieve, SKOB sirve cocina tradicional que combina sabores de montaña y del norte, con platos generosos y cervezas belgas y francesas, para degustar en la soleada terraza o en el interior."
    ],
    "nl": [
      "SKOB ligt aan de voet van de pistes aan de voorkant van de sneeuw en serveert een traditionele keuken die berg- en noordelijke smaken combineert, met royale gerechten en Belgische en Franse bieren, waarvan je kunt genieten op het zonnige terras of binnen."
    ]
  },
