  "rdfs:comment": {
    "de": [
      "Wir freuen uns, Sie in unseren Gästezimmern und unserem Weinkeller in Saint-Lager begrüßen zu dürfen, wo Sie unsere Weine am Fuße des Mont Brouilly probieren können"
    ],
    "en": [
      "We will be delighted to welcome you to our Bed & Breakfast and tasting cellar in Saint-Lager to give you a tasting of our wines at the foot of Mont Brouilly."
    ],
    "it": [
      "Saremo lieti di accogliervi nelle nostre camere e nella nostra cantina di Saint-Lager per farvi degustare i nostri vini ai piedi del Mont Brouilly"
    ],
    "fr": [
      "Nous serons heureux de vous accueillir dans nos chambres d’hôtes et notre caveau situé à Saint-Lager pour vous faire déguster nos vins au pied du Mont Brouilly"
    ],
    "nl": [
      "Wij ontvangen u graag in onze gastenkamers en onze kelder in Saint-Lager om u onze wijnen te laten proeven aan de voet van de Mont Brouilly"
    ],
    "es": [
      "Estaremos encantados de recibirle en nuestras habitaciones y en nuestra bodega situada en Saint-Lager para que pueda degustar nuestros vinos a los pies del Mont Brouilly"
    ]
  },
