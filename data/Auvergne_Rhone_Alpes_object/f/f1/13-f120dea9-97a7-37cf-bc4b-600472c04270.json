  "rdfs:comment": {
    "de": [
      "BEGEBEN SIE SICH MIT UNSEREN ERFAHRENEN GUIDES AUF EINE UNVERGESSLICHE RAFTING-, AIRBOAT-, CANORAFT- ODER HYDROSPEED-TOUR AUF DEM GIFFRE! GARANTIERTE SENSATIONEN!"
    ],
    "en": [
      "EMBARK WITH OUR EXPERIENCED GUIDES FOR AN UNFORGETTABLE RAFTING, AIRBOAT, CANORAFT OR HYDROSPEED DESCENT ON THE GIFFRE RIVER ! SENSATIONS GUARANTEED !"
    ],
    "it": [
      "SALITE A BORDO CON LE NOSTRE GUIDE ESPERTE PER UN'INDIMENTICABILE DISCESA DEL GIFFRE IN RAFTING, AIRBOAT, CANORAFT O HYDROSPEED! EMOZIONI GARANTITE!"
    ],
    "fr": [
      "EMBARQUEZ AVEC NOS GUIDES EXPÉRIMENTÉS POUR UNE DESCENTE INOUBLIABLE EN RAFTING, AIRBOAT, CANORAFT OU HYDROSPEED SUR LE GIFFRE ! SENSATIONS GARANTIES !"
    ],
    "es": [
      "SUBA A BORDO CON NUESTROS EXPERIMENTADOS GUÍAS PARA DISFRUTAR DE UN INOLVIDABLE DESCENSO EN BALSA, HIDRODESLIZADOR, CANORAFT O HIDROSPEED POR EL GIFFRE ¡EMOCIONES GARANTIZADAS!"
    ],
    "nl": [
      "KOM AAN BOORD MET ONZE ERVAREN GIDSEN VOOR EEN ONVERGETELIJKE RAFTING, AIRBOAT, CANORAFT OF HYDROSPEED TOCHT OP DE GIFFRE! SENSATIE GEGARANDEERD!"
    ]
