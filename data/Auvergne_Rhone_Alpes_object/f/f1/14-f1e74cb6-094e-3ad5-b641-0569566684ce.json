  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/095a1ef4-2312-394e-9b79-508740b68871",
      "dc:description": {
        "de": [
          "CGED ist ein Multi-Spezialist im Vertrieb von Elektroprodukten. Als nationale Marke vertreibt sie mehr als eine Million Artikel an Geschäftskunden. Das Angebot von CGED Distribution deckt alle diese Anwendungsbereiche ab."
        ],
        "en": [
          "CGED is a multi-specialist distributor of electrical products. A national brand, it markets over a million references to professional customers. Whether for the residential, commercial or industrial sectors, CGED Distribution's range of products covers all applications."
        ],
        "it": [
          "CGED è un distributore multispecialistico di prodotti elettrici. Marchio nazionale, commercializza oltre un milione di prodotti a clienti professionali. Che si tratti di applicazioni residenziali, commerciali o industriali, la gamma di prodotti di CGED Distribution copre tutte le applicazioni."
        ],
        "fr": [
          "CGED est un distributeur multi-spécialiste de produits électriques. Enseigne nationale, elle commercialise plus d'un million de références auprès de la clientèle professionnelle. Résidentiel, Tertiaire ou Industrie, l'éventail d'offre de CGED Distribution répond à toutes ces applications."
        ],
        "nl": [
          "CGED is een gespecialiseerde distributeur van elektrische producten. Als nationaal merk verkoopt het meer dan een miljoen producten aan professionele klanten. Of het nu voor residentiële, commerciële of industriële toepassingen is, het assortiment van CGED Distribution dekt alle toepassingen."
        ],
        "es": [
          "CGED es un distribuidor multiespecialista de productos eléctricos. Marca nacional, comercializa más de un millón de productos a clientes profesionales. Ya sea para aplicaciones residenciales, comerciales o industriales, la gama de productos de CGED Distribution cubre todas las aplicaciones."
        ]
      },
      "@type": [
        "Description"
      ],
