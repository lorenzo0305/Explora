      "@id": "https://data.datatourisme.fr/61ad1b7c-325e-3aa4-8979-33571c4c19a7",
      "dc:description": {
        "de": [
          "Japanisches Restaurant in der Nähe des Bahnhofs. Sushi, Sashimi, Yakitori und alle anderen traditionellen japanischen Gerichte stehen auf der Speisekarte und werden in großzügigen Portionen serviert."
        ],
        "en": [
          "Japanese restaurant located near the station. Sushi, sashimi, yakitori and all other traditional Japanese dishes are on the menu and are served in generous portions."
        ],
        "it": [
          "Ristorante giapponese situato vicino alla stazione ferroviaria. Sushi, sashimi, yakitori e tutti gli altri piatti tradizionali giapponesi sono presenti nel menu e vengono serviti in porzioni generose."
        ],
        "fr": [
          "Restaurant Japonais situé à proximité de la gare. Sushi, sashimi, yakitori et tous les autres mets traditionnels japonais sont présents sur la carte, et sont servis en portions généreuses."
        ],
        "es": [
          "Restaurante japonés situado cerca de la estación de tren. Sushi, sashimi, yakitori y todos los demás platos tradicionales japoneses están en el menú, y se sirven en generosas porciones."
        ],
        "nl": [
          "Japans restaurant vlakbij het station. Sushi, sashimi, yakitori en alle andere traditionele Japanse gerechten staan op het menu, en worden in royale porties geserveerd."
        ]
      },
