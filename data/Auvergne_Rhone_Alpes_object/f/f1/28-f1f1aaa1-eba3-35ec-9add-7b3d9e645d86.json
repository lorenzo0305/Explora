  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: Zweifellos das beste japanische Restaurant der Stadt, trotz eines sehr kleinen Saals. Top-Service zum Mitnehmen!"
    ],
    "en": [
      "You'll love: arguably the best Japanese restaurant in town, despite its small space. Top takeaway service!"
    ],
    "it": [
      "Vi piacerà: senza dubbio il miglior ristorante giapponese della città, nonostante la sua piccola sala da pranzo. Servizio d'asporto al top!"
    ],
    "fr": [
      "Vous aimerez : sans doute le meilleur restaurant japonais de la ville malgré une toute petite salle. Un service à emporter au top !"
    ],
    "es": [
      "Te encantará: sin duda el mejor restaurante japonés de la ciudad, a pesar de su diminuto comedor. El mejor servicio de comida para llevar"
    ],
    "nl": [
      "Je zult ervan houden: zonder twijfel het beste Japanse restaurant in de stad, ondanks de kleine eetzaal. Top afhaalservice!"
    ]
  },
