  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/79d47bfc-c14c-39b0-8387-68a019b3ea6a",
      "dc:description": {
        "de": [
          "Monique, die Andersens Märchen liebt und eine Pionierin des Handels in Toulouse ist, ist eine der letzten Geschäftsführerinnen eines Ladens, der ausschließlich Souvenirs aus dem Ort anbietet."
        ],
        "en": [
          "A lover of Andersen?s fairy tales and a pioneer of the Touquet trade, Monique is one of the last managers of a boutique dedicated exclusively to souvenirs of the resort."
        ],
        "it": [
          "Amante delle fiabe di Andersen e pioniera del commercio del Touquet, Monique è una delle ultime gestrici di un negozio dedicato esclusivamente ai souvenir della località."
        ],
        "fr": [
          "Amoureuse des contes d’Andersen, et pionnière du commerce touquettois, Monique est l’une des dernières gérantes d’une boutique exclusivement dédiée aux objets souvenirs de la station."
        ],
        "nl": [
          "Monique is een liefhebber van de sprookjes van Andersen en een pionier in de handel van Touquet. Ze is een van de laatste managers van een winkel die uitsluitend gewijd is aan souvenirs van de badplaats."
        ],
        "es": [
          "Amante de los cuentos de Andersen y pionera del comercio de Touquet, Monique es una de las últimas responsables de una tienda dedicada exclusivamente a los recuerdos de la estación."
        ]
      },
