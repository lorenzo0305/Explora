  "rdfs:comment": {
    "de": [
      "Inspiriert vom Petit Trianon in Versailles wurden der Park und das Schloss (ISMH) von La Louvière auf Wunsch des Industriellen Monsieur Troubat aus Montluçonnais im Jahr 1926 errichtet."
    ],
    "en": [
      "Inspired by the Petit Trianon of Versailles, the park and the château (ISMH) of La Louvière were built at the request of the Montluçon industrialist Monsieur Troubat in 1926."
    ],
    "it": [
      "Ispirati al Petit Trianon di Versailles, il parco e il castello (ISMH) di La Louvière furono costruiti su richiesta dell'industriale montuonese Monsieur Troubat nel 1926."
    ],
    "fr": [
      "Inspirés du petit Trianon de Versailles, le parc et le château (ISMH) de la Louvière ont été réalisés à la demande de l'industriel montluçonnais Monsieur Troubat en 1926."
    ],
    "es": [
      "Inspirados en el Petit Trianon de Versalles, el parque y el castillo (ISMH) de La Louvière fueron construidos a petición del industrial de Montluçonnais Monsieur Troubat en 1926."
    ],
    "nl": [
      "Geïnspireerd door het Petit Trianon in Versailles, werden het park en het kasteel (ISMH) van La Louvière gebouwd op verzoek van de Montluçonnais industrieel Monsieur Troubat in 1926."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc de la Villa Louvière"
    ]
  },
