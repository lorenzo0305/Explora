  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Nordic Walking Route Col du Feu - Foyer des Moises ab dem COl du Feu in Lullin! Genießen Sie das Bergpanorama, den Blick auf den Genfersee und die Ruhe der Almen im Winter"
    ],
    "en": [
      "At Lullin, the Col du Feu is also a Nordic ski trail from Les Moises cross-country ski centre to Habère-Poche (7 km). It’s a paradise for cross-country skiers and snowshoers – get away from it all and enjoy panoramic views of Lake Geneva!"
    ],
    "it": [
      "Scoprite il percorso nordico Col du Feu - Foyer des Moises dal Col du Feu a Lullin! Godetevi i panorami montani, le viste sul Lago di Ginevra e la pace e la tranquillità degli alpeggi in inverno"
    ],
    "fr": [
      "Découvrez l'Itinéraire nordique Col du Feu - Foyer des Moises depuis le COl du Feu à Lullin ! Profitez des panoramas de montagnes, de la vue sur le Lac Léman et de la quiétude des alpages en hiver"
    ],
    "es": [
      "¡Descubra la ruta nórdica Col du Feu - Foyer des Moises desde el Col du Feu en Lullin! Disfrute de panoramas montañosos, vistas del lago Lemán y de la tranquilidad de los pastos de montaña en invierno"
    ],
    "nl": [
      "Ontdek de Nordic route Col du Feu - Foyer des Moises vanaf de Col du Feu in Lullin! Geniet van bergpanorama's, uitzicht op het Meer van Genève en de rust van de alpenweiden in de winter"
    ]
  },
