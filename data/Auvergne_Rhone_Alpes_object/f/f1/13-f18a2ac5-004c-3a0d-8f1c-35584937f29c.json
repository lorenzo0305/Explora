  "rdfs:comment": {
    "de": [
      "Wandermassagepraxis, Sauna, Energiebehandlungen, Entspannungsworkshops, Einführungskurse in die Praxis der Wellnessmassage, Wochenenden \"Wellness und Natur\"..."
    ],
    "en": [
      "Wellness, change of scene and wonder: all in the hands of Marc! Discover his deft touch in the Roulotte du masseur, a pretty little wooden caravan settled at the heart of the Val de Tamié, a natural setting with an enchanting beauty in every season."
    ],
    "it": [
      "Pratica di massaggio itinerante, sauna, trattamenti energetici, workshop di rilassamento, corsi di introduzione alla pratica del massaggio del benessere, weekend \"benessere e natura\"..."
    ],
    "fr": [
      "Cabinet de massage itinérant, sauna, soins énergétiques, ateliers de relaxation, stages d'initiation à la pratique du massage bien-être, week-ends \"bien-être et nature\"..."
    ],
    "nl": [
      "Reizende massagepraktijk, sauna, energiebehandelingen, ontspanningsworkshops, initiatiecursussen in de praktijk van de welzijnsmassage, weekends \"welzijn en natuur\"..."
    ],
    "es": [
      "Práctica de masaje itinerante, sauna, tratamientos energéticos, talleres de relajación, cursos de iniciación a la práctica del masaje de bienestar, fines de semana de \"bienestar y naturaleza\"..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sauna at la Roulotte du Masseur"
    ],
    "fr": [
      "Le sauna mobile de la Roulotte du Masseur"
    ]
  },
