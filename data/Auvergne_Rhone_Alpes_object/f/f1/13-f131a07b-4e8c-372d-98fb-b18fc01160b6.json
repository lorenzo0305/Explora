  "rdfs:comment": {
    "de": [
      "Sport Boutique und Ski-/Snowboardverleih. Im Herzen des Skigebiets auf 300 m2 auf 2 Ebenen. Verkauf von Sportswear, Skiwear und Zubehör. Werkstatt für Reparaturen und Bootfitting. Techniker, Spezialisten und Skifahrer stehen zu Ihren Diensten\r\nEmpfang und Lächeln!"
    ],
    "en": [
      "Sports shop and ski/snowboard equipment rental. In the centre of the ski resort on 300 m2 and 2 levels. Sportswear, skiwear and accessories. \r\nBootfitting and repairing. Technicians, specialists and skiers at your service. Welcome and smile !"
    ],
    "it": [
      "Boutique sportiva e noleggio di sci/snowboard. Nel cuore del resort, 300 m2 su 2 livelli. Vendita di abbigliamento sportivo, sci e accessori. Officina di riparazione e montaggio di stivali. Tecnici, specialisti e sciatori al vostro servizio\r\nBenvenuti e sorridete!"
    ],
    "fr": [
      "Sport Boutique et Location skis/snowboards. Au cœur de la station sur 300 m2 en 2 niveaux. Vente sportswear, skiwear et accessoires. Atelier réparation et bootfitting. Des techniciens, spécialistes et pratiquants à votre service. \r\nAccueil et sourire !"
    ],
    "es": [
      "Boutique deportiva y alquiler de esquís y tablas de nieve. En el corazón de la estación en 300 m2 en 2 niveles. Venta de ropa deportiva, ropa de esquí y accesorios. Taller de reparación y montaje de botas. Técnicos, especialistas y esquiadores a su servicio\r\n¡Bienvenido y sonríe!"
    ],
    "nl": [
      "Boetiek en verhuur ski’s / snowboard. In het hart van het station op 300m2\r\nop 2 niveaus. Verkoop sportswear, skiwear en accessoires. Atelier reparatie en\r\nbootfitting. Technieken, specialisten en beoefenaars tot uw dienst. Onthaal met de glimlach!"
    ]
  },
