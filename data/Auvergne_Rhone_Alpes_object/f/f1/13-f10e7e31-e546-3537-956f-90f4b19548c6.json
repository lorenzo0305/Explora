  "rdfs:comment": {
    "de": [
      "Unsere Flüge starten vom Altiport Megève und werden an allen Tagen des Jahres (Woche und Wochenende) durchgeführt, je nach Wetterbedingungen und Verfügbarkeit unserer Hubschrauber."
    ],
    "en": [
      "Our flights depart from the airfield in Megeve and are available all year round, throughout the week and weekends.  Depending on the weather conditions and helicopter availability"
    ],
    "it": [
      "I nostri voli partono dall'Altiport di Megeve e si svolgono tutti i giorni dell'anno (in settimana e nei fine settimana) a seconda delle condizioni meteorologiche e della disponibilità dei nostri elicotteri."
    ],
    "fr": [
      "Nos vols sont au départ de l’Altiport de Megève et s’effectuent tous les jours de l’année (semaine et weekend) selon les conditions météorologiques et la disponibilité de nos hélicoptères."
    ],
    "nl": [
      "Onze vluchten vertrekken vanaf de Altiport van Megève en vinden elke dag van het jaar plaats (doordeweeks en in het weekend), afhankelijk van de weersomstandigheden en de beschikbaarheid van onze helikopters."
    ],
    "es": [
      "Nuestros vuelos parten del Altiport de Megeve y tienen lugar todos los días del año (días laborables y fines de semana) en función de las condiciones meteorológicas y de la disponibilidad de nuestros helicópteros."
    ]
  },
  "rdfs:label": {
    "en": [
      "Trip round Mont Blanc"
    ],
    "fr": [
      "Tour du Mont Blanc"
    ]
  },
