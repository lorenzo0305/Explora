  "rdfs:comment": {
    "de": [
      "Performances Drive empfängt Sie das ganze Jahr über an 7 Tagen in der Woche zu Ihrem Vergnügen! Aktivitäten für Groß und Klein: GoKart, Paintball und Minigolf. Im Sommer stehen Ihnen eine Hüpfburg, Tischtennis,Tischfußball und ein Bouleplatz zur Verfügung."
    ],
    "en": [
      "Performances Drive welcomes you for your total enjoyment 7 days a week all year round! Activities for all agesd: kart, paintball and mini-golf. In summer, there are a bouncy castle, table tennis, table football and a boules' court (la pétanque)."
    ],
    "it": [
      "Benvenuti a Performances Drive!\r\nSi tratta del circuito di karting più lungo del dipartimento, ma anche di un centro ricreativo che offre una vasta gamma di attività come paintball, minigolf, strutture gonfiabili? per grandi e piccini!"
    ],
    "fr": [
      "Bienvenue chez Performances Drive !\r\nC'est le circuit karting loisir le plus long du département, mais également un pôle loisir proposant un large panel d’activités paintball, mini-golf, structures gonflables… pour petits et grands !"
    ],
    "es": [
      "¡Bienvenido a Performances Drive!\r\nEs el circuito de karting de ocio más largo del departamento, pero también un centro de ocio que ofrece una amplia gama de actividades como paintball, minigolf, estructuras hinchables... ¡para grandes y pequeños!"
    ],
    "nl": [
      "Welkom bij Performances Drive!\r\nHet is het langste recreatieve kartcircuit van het departement, maar ook een vrijetijdscentrum met een breed scala aan activiteiten zoals paintball, minigolf, opblaasbare structuren? voor jong en oud!"
    ]
  },
