  "rdfs:comment": {
    "de": [
      "Dies ist eine kleine Wendeltreppe, die die Stockwerke eines großen Bürgerhauses bedient. Sie diente auch als Wachturm. Sie befindet sich an der Ecke der Rue de l'Eglise."
    ],
    "en": [
      "This small spiral staircase served the upper floors of a large bourgeois house. It also served as a watchtower. It stands at the corner of rue de l'église."
    ],
    "it": [
      "Si tratta di una piccola scala a chiocciola che serve i piani di una grande casa borghese. Veniva utilizzata anche come torre di avvistamento. Si trova all'angolo con la strada della chiesa."
    ],
    "fr": [
      "C'est un escalier à vis de petite dimension, desservant les étages d'une grosse maison bourgeoise. Il servait également de tour de guet. Il se trouve à l'angle de la rue de l'église."
    ],
    "es": [
      "Se trata de una pequeña escalera de caracol que da servicio a los pisos de una gran casa burguesa. También se utilizaba como torre de vigilancia. Se encuentra en la esquina de la calle de la iglesia."
    ],
    "nl": [
      "Dit is een kleine wenteltrap die de bovenste verdiepingen van een groot burgerlijk huis bedient. Hij werd ook gebruikt als uitkijktoren. Hij staat op de hoek van de rue de l'église."
    ]
  },
