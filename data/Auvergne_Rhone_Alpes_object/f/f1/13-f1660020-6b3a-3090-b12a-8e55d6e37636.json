  "rdfs:comment": {
    "de": [
      "Jahrhundert auf einem Felsvorsprung im Herzen der Sioule-Schlucht gelegene Burg, die den Herren von Chouvigny, der Familie La Fayette und dem Herzog von Morny gehörte. Das im 20. Jahrhundert restaurierte Familienschloss kann nur im Sommer besichtigt werden (ISMH)."
    ],
    "en": [
      "A 13th-century fortified castle on a rocky outcrop in the heart of the Sioule Gorge, it belonged to the Seigneurs de Chouvigny, the La Fayette family and the Duc de Morny. Restored in the 20th century, this family-run château can only be visited in summer (ISMH)."
    ],
    "it": [
      "Questo castello fortificato del XIII secolo, situato su uno sperone roccioso nel cuore delle gole della Sioule, apparteneva ai signori di Chouvigny, alla famiglia La Fayette e al duca di Morny. Restaurato nel XX secolo, questo castello di famiglia è visitabile solo in estate (ISMH)."
    ],
    "fr": [
      "Château fort du XIIIe siècle situé sur un éperon rocheux au cœur des gorges de la Sioule, a appartenu aux Seigneurs de Chouvigny, à la famille La Fayette et au Duc de Morny. Restauré au XXe siècle, ce château familial se visite uniquement l'été (ISMH)."
    ],
    "nl": [
      "Kasteel uit 13e eeuw gelegen op een rots bij de Gorges de la Sioule, behoorde toe aan de heren van Chouvigny, de familie La Fayette en uiteindelijk aan de hertog van Morny. Het kasteel is gerestaureerd in de twintigste eeuw en kan alleen in de zomer worden bezocht."
    ],
    "es": [
      "Este castillo fortificado del siglo XIII, situado en un espolón rocoso en el corazón de las gargantas del Sioule, perteneció a los señores de Chouvigny, a la familia La Fayette y al duque de Morny. Restaurado en el siglo XX, este castillo familiar sólo puede visitarse en verano (ISMH)."
    ]
  },
