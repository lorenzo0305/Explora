  "rdfs:comment": {
    "de": [
      "Sophie und Vincent bieten ihre Produkte an: Hydrolate, ätherische Öle, Kastanien, Heidelbeeren, Honig, Fruchtsäfte und andere saisonale Artikel (Kerzen, Duftsalze, Balsame). Zertifiziert biologisch und mit DEMETER-Siegel ausgezeichnet."
    ],
    "en": [
      "Sophie and Vincent offer their products: hydrolats, essential oils, chestnuts, blueberries, honey, fruit juices and other seasonal items (candles, scented salts, balms). Certified organic and DEMETER labelled."
    ],
    "it": [
      "Sophie e Vincent vi offrono i loro prodotti: idrolati, oli essenziali, castagne, mirtilli, miele, succhi di frutta e altre trasformazioni stagionali (candele, sali aromatizzati, balsami). Marchio certificato AB e DEMETER."
    ],
    "fr": [
      "Sophie et Vincent vous proposent leurs productions: hydrolats, huiles essentielles, châtaignes, myrtilles, miel, jus de fruits et autres transformations selon saisons ( bougies, sels aromatisés, baumes). Certifiées AB et labelisées DEMETER."
    ],
    "es": [
      "Sophie y Vincent le ofrecen sus productos: hidrolatos, aceites esenciales, castañas, arándanos, miel, zumos de frutas y otras transformaciones de temporada (velas, sales aromatizadas, bálsamos). Certificado AB y etiqueta DEMETER."
    ],
    "nl": [
      "Sophie en Vincent bieden je hun producten aan: hydrolaten, essentiële oliën, kastanjes, bosbessen, honing, vruchtensappen en andere seizoensgebonden transformaties (kaarsen, smaakzouten, balsems). Gecertificeerd AB en DEMETER-label."
    ]
  },
