  "rdfs:comment": {
    "de": [
      "Der Fauteuil Tout Terrain ist eine Mischung aus Mountainbike und Quad und ermöglicht es Ihnen, sich auf allen Bergpfaden zu bewegen. Er vermittelt Ihnen ein Gefühl der Geschwindigkeit und ermöglicht es Ihnen so, Abfahrten mit der Familie oder mit Freunden zu teilen."
    ],
    "en": [
      "An all-terrain wheelchair outing lies somewhere between mountain biking and quad bike riding. You can travel along all the paths on the mountainside, enjoying the sensation of speed and sharing descents with family or friends."
    ],
    "it": [
      "A metà strada tra una mountain bike e un quad, la carrozzina All-Terrain vi permette di affrontare tutti i sentieri di montagna, dandovi una sensazione di velocità e permettendovi di condividere le discese con la famiglia e gli amici."
    ],
    "fr": [
      "A mi-chemin entre le VTT et le quad, le Fauteuil Tout Terrain vous permettra d'évoluer sur tous les sentiers de montagne, il vous procurera des sensations de vitesse et ainsi vous permettra de partager des descentes en famille ou entre amis."
    ],
    "nl": [
      "Een all -terrain rolstoel ligt ergens tussen mountainbiken en quad rijden . \r\nU kunt reizen langs alle paden op de berghelling , genieten van de sensatie van snelheid en het delen van afdalingen met familie of vrienden ."
    ],
    "es": [
      "A medio camino entre una bicicleta de montaña y un quad, la silla de ruedas todoterreno te permite recorrer todos los senderos de montaña, dándote sensación de velocidad y permitiéndote compartir descensos con familiares y amigos."
    ]
  },
  "rdfs:label": {
    "en": [
      "All-terrain wheelchair loan in Samoens"
    ],
    "fr": [
      "Prêt de Fauteuil tout-terrain à Samoens"
    ],
    "nl": [
      "All-terrain rolstoel huren in Samoens"
    ]
  },
