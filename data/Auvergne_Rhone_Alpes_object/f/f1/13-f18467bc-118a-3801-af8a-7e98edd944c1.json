  "rdfs:comment": {
    "de": [
      "Das Restaurant inmitten der Pisten empfängt Sie in seinem schönen Saal und auf der nach Süden ausgerichteten Terrasse zum Mittagessen (neuer Chefkoch!) oder auf der Schneefront in Liegestühlen, um etwas zu trinken, in der Snackbar zu essen oder einen Snack zu sich zu nehmen."
    ],
    "en": [
      "The restaurant, located in the middle of the slopes welcomes you in its beautiful room and on the terrace facing south to eat at noon or on the snow front in the deckchairs for a drink. It is accessible by the Bonnets Rouges chairlift."
    ],
    "it": [
      "Il ristorante si trova in mezzo alle piste e vi accoglie nella sua bella sala da pranzo e sulla terrazza esposta a sud per il pranzo (nuovo chef!) o sul fronte neve sulle sedie a sdraio per un drink, uno spuntino o un tè pomeridiano."
    ],
    "fr": [
      "Le restaurant situé au milieu des pistes  vous accueille dans sa belle salle et sur la terrasse exposée plein sud pour le midi (nouveau chef !) ou sur le front de neige en transats pour boire un coup, manger au snack ou pour le goûter."
    ],
    "nl": [
      "Het restaurant, midden op de hellingen, verwelkomt u in zijn prachtige kamer en op het terras op het zuiden om 's middags te eten of op het sneeuwfront in de ligstoelen voor een drankje. Het is bereikbaar met de stoeltjeslift Bonnets Rouges."
    ],
    "es": [
      "El restaurante está situado en medio de las pistas y le da la bienvenida en su hermoso comedor y en la terraza orientada al sur para almorzar (¡nuevo chef!) o en el frente de nieve en tumbonas para tomar una copa, un aperitivo o el té de la tarde."
    ]
  },
