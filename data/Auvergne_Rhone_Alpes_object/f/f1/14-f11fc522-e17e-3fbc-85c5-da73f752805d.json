  "rdfs:comment": {
    "de": [
      "Die retrofuturistische, ja afrofuturistische Neuerfindung des Meisterwerks von David Bowie, die Magie einer Platte ? Ziggy Stardust? durch das Sieb der Synthesizer und Perkussion von LÉONIE PERNET."
    ],
    "en": [
      "A retro-futuristic, even afro-futuristic reinvention of David Bowie?s masterpiece, the magic of a ? Ziggy Stardust? sifted through LÉONIE PERNET?s synthesizers and percussion."
    ],
    "it": [
      "Una reinvenzione retro-futuristica, persino afro-futuristica, del capolavoro di David Bowie, la magia di uno ? Ziggy Stardust? setacciata attraverso i sintetizzatori e le percussioni di LÉONIE PERNET."
    ],
    "fr": [
      "Réinvention rétrofuturiste, voire afrofuturiste du chef d’œuvre de David Bowie, la magie d’un disque – Ziggy Stardust – passé au tamis des synthétiseurs et percussions de LÉONIE PERNET."
    ],
    "es": [
      "Una reinvención retrofuturista, incluso afrofuturista, de la obra maestra de David Bowie, la magia de un ? Ziggy Stardust? tamizada por los sintetizadores y la percusión de LÉONIE PERNET."
    ],
    "nl": [
      "Een retro-futuristische, zelfs afro-futuristische heruitvinding van David Bowie's meesterwerk, de magie van een ? Ziggy Stardust? gezeefd door de synthesizers en percussie van LÉONIE PERNET."
    ]
  },
