  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Lebensmittelladen mit biologischen und/oder lokalen, aber immer leckeren Produkten! Die Freiwilligen werden Sie mit Einfachheit und Freundlichkeit empfangen."
    ],
    "en": [
      "We sells tasty organic and/or local produces in our grocery store!  Expect a friendly and simple welcome from our volunteers."
    ],
    "it": [
      "Scoprite il negozio di alimentari con prodotti biologici e/o locali, ma sempre con un tocco gourmet! I volontari vi accoglieranno con semplicità e gentilezza."
    ],
    "fr": [
      "Découvrez l'épicerie de produits bio et/ou locaux mais toujours gourmands ! Les bénévoles vous accueilleront avec simplicité et gentillesse."
    ],
    "nl": [
      "Maak kennis met onze plaatselijke dranken (tapbier, Clairette, siroop, sap) op een gezellige, schaduwrijke plek. Neem een kijkje in de winkel met de lekkerste biologische en plaatselijke producten. De vrijwilligers ontvangen je hartelijk."
    ],
    "es": [
      "Descubra la tienda de comestibles con productos ecológicos y/o locales, ¡pero siempre con un toque gourmet! Los voluntarios le recibirán con sencillez y amabilidad."
    ]
  },
