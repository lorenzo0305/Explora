  "rdfs:comment": {
    "de": [
      "Versammeln Sie Ihre Freunde und haben Sie nur ein Ziel: Ihren Aperitif aus Savoyen, der in einer riesigen Kühlbox eingeschlossen ist, freizuschalten. Sind Sie bereit, die Herausforderung anzunehmen?"
    ],
    "en": [
      "Gather your friends, with the sole aim of unlocking your Savoyard aperitif locked in an enormous icebox. Are you up to the challenge?"
    ],
    "it": [
      "Riunite i vostri amici, con l'unico obiettivo di sbloccare il vostro aperitivo savoiardo chiuso in un'enorme ghiacciaia. Siete all'altezza della sfida?"
    ],
    "fr": [
      "Rassemblez vos amis, avec pour seul objectif : débloquer votre apéro savoyard enfermé dans une énorme glacière. Êtes-vous prêt à relever le défi ?"
    ],
    "nl": [
      "Verzamel je vrienden, met als enige doel het ontgrendelen van je Savoyaardse aperitief dat opgesloten zit in een enorme koelkast. Gaan jullie de uitdaging aan?"
    ],
    "es": [
      "Reúne a tus amigos, con el único objetivo de desbloquear tu aperitivo saboyano encerrado en una enorme nevera. ¿Estás preparado para el desafío?"
    ]
  },
  "rdfs:label": {
