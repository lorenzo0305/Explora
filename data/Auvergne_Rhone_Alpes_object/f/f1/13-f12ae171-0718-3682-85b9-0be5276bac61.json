  "rdfs:comment": {
    "de": [
      "Ein hybrides Bar-Tapas-Restaurant-Konzept\r\nDas Restaurant L'1D3 zelebriert die traditionelle französische Küche.\r\nSeine Speisekarte, die regelmäßig im Einklang mit den Jahreszeiten und frischen Produkten aktualisiert wird, bietet ein authentisches Geschmackserlebnis."
    ],
    "en": [
      "A hybrid Bar-Tapas-Restaurant concept\r\nThe L'1D3 restaurant celebrates traditional French cuisine.\r\nIts menu, regularly updated in harmony with the seasons and fresh produce, offers an authentic taste experience."
    ],
    "it": [
      "Un concetto ibrido di Bar-Tapas-Ristorante\r\nIl ristorante L?1D3 celebra la cucina francese tradizionale.\r\nIl suo menu, regolarmente aggiornato in armonia con le stagioni e i prodotti freschi, offre un'autentica esperienza di gusto."
    ],
    "fr": [
      "Un Concept hybride Bar-Tapas-Restaurant\r\nLe restaurant L’1D3 célèbre la cuisine française traditionnelle.\r\nSa carte, régulièrement actualisée en harmonie avec les saisons et les produits frais, offre une expérience gustative authentique."
    ],
    "es": [
      "Un concepto híbrido de Bar-Tapas-Restaurante\r\nEl restaurante L'1D3 rinde homenaje a la cocina tradicional francesa.\r\nSu menú, actualizado regularmente en armonía con las estaciones y los productos frescos, ofrece una auténtica experiencia de sabor."
    ],
    "nl": [
      "Een hybride bar-tapas-restaurantconcept\r\nHet restaurant L?1D3 viert de traditionele Franse keuken.\r\nHet menu, dat regelmatig wordt bijgewerkt in harmonie met de seizoenen en verse producten, biedt een authentieke smaakervaring."
    ]
  },
