  "rdfs:comment": {
    "de": [
      "Probieren Sie den guten Bienenhonig!\r\nVerkaufsstellen: Auf Bestellung bei der Produzentin oder im Laden in den Jardins du Gévaudan in Saugues."
    ],
    "en": [
      "Enjoy the goodness of bee honey!\r\nWhere to buy: contact the producer to order, or store at Jardins du Gévaudan in Saugues."
    ],
    "it": [
      "Assaggiate il buon miele delle api!\r\nDisponibile su ordinazione presso il produttore o nel negozio dei Jardins du Gévaudan a Saugues."
    ],
    "fr": [
      "Dégustez le bon miel d'abeilles !\r\nPoints de vente : sur commande en contactant la productrice, ou en boutique aux Jardins du Gévaudan à Saugues."
    ],
    "es": [
      "¡Pruebe la buena miel de abeja!\r\nDisponible por encargo al productor, o en la tienda de los Jardins du Gévaudan en Saugues."
