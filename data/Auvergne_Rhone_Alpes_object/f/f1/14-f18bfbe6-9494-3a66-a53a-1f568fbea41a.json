  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b7ec40aa-5a32-36f8-ad59-819b7b3afa08",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag von 7:00 - 22:00 Uhr\nSonntag von 9:00 bis 13:00 Uhr\n\nAbholung:\nZum Mitnehmen während der Ladenöffnungszeiten\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday 7am - 10pm\nSunday 9am - 1pm\n\nPick-up :\nTakeaway during store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato dalle 7.00 alle 22.00\nDomenica dalle 9.00 alle 13.00\n\nRitiro :\nDa asporto durante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi de 7h - 22h\nLe dimanche de  9h - 13h\n\nRetrait :\nÀ emporter aux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag 7u - 22u\nZondag 9u - 13u\n\nAfhalen :\nAfhalen tijdens winkelopeningstijden\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado de 7h a 22h\nDomingo de 9h a 13h\n\nRecogida :\nPara llevar durante el horario de apertura de la tienda\n\n\n "
        ]
      },
