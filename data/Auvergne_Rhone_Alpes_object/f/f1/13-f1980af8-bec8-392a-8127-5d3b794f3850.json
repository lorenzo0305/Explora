  "rdfs:comment": {
    "de": [
      "Neue Dekoration, Menüs mit lokalen Produkten, eine Küche mit Holzfeuer. Das Fleisch ist französischen Ursprungs, stammt von lokalen Metzgern und wird von uns gereift. Wurst- und Käseplatten am Sonntag: das ist der Petit Roche"
    ],
    "en": [
      "New decoration, menus with local products, a wood-fired kitchen. The meats are of French origin coming from local butchers and matured by us. Boards of charcuteries and cheeses on Sundays : it's the Petit Roche"
    ],
    "it": [
      "Nuova decorazione, menù con prodotti locali, cucina a legna. La carne è di origine francese, proviene da macellerie locali e viene frollata da noi. Piatti di salumi e formaggi la domenica: è la Petit Roche"
    ],
    "fr": [
      "Nouvelle déco, des menus avec des produits locaux, une cuisine au feu de bois . Les viandes sont d'origine française provenant des bouchers locaux et maturées par nos soins. Des planches de charcuteries et de fromages le dimanche : c'est le Petit Roche"
    ],
    "es": [
      "Nueva decoración, menús con productos locales, cocina de leña. La carne es de origen francés y proviene de carnicerías locales y es madurada por nosotros. Platos de embutidos y quesos los domingos: es el Petit Roche"
    ],
    "nl": [
      "Nieuwe inrichting, menu's met lokale producten, houtgestookte keuken. Het vlees is van Franse oorsprong en komt van lokale slagers en wordt door ons gerijpt. Borden met vleeswaren en kazen op zondag: het is de Petit Roche"
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Petit Roche"
    ],
    "fr": [
      "Le Petit Roche"
    ],
    "es": [
      "l"
    ]
  },
