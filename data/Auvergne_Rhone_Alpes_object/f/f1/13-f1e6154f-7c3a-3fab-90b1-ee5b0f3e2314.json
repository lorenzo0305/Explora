  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen Zen-Moment in einem Cocooning-Raum, lassen Sie los und lassen Sie sich für einen besonderen Moment in den Schlaf wiegen. Verschiedene Wellness-Massagen."
    ],
    "en": [
      "Come and spend a zen moment in a cocooning space, let go and let yourself be lulled to sleep for a privileged moment. Various wellness massages."
    ],
    "it": [
      "Venite a trascorrere un momento zen in uno spazio cocooning, lasciatevi andare e lasciatevi cullare per un momento speciale. Vari massaggi benessere."
    ],
    "fr": [
      "Venez passer un moment zen, dans un espace cocooning, lâchez prise et laissez vous bercer pour un moment privilégié. Différents Massages bien-être."
    ],
    "es": [
      "Venga a pasar un momento zen en un espacio envolvente, suéltese y déjese mecer por un momento especial. Masajes de bienestar variados."
    ],
    "nl": [
      "Kom en breng een zen-moment door in een cocooning ruimte, laat je gaan en laat je wiegen voor een speciaal moment. Diverse welzijnsmassages."
    ]
  },
