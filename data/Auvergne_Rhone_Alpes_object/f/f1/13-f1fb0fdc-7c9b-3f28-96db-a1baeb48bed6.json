  "rdfs:comment": {
    "de": [
      "Die SARL Dame Blanche ist ein Familienunternehmen, das in Chabeuil Geflügel für Masthähnchen züchtet. Ein Dutzend Beschäftigte arbeiten für eine nicht-intensive, geflügelfreundliche Zucht. Eine Getreideproduktion ergänzt die Geflügelhaltung."
    ],
    "en": [
      "Poultry farm. Dame Blanche was created in June 1996 by Jean-Luc Guyon for the poultry farming part and Christian Guyon for the cereal production part in and around Chabeuil."
    ],
    "it": [
      "SARL Dame Blanche è un allevamento di pollame da carne a conduzione familiare con sede a Chabeuil. Una decina di dipendenti lavorano in un'azienda non intensiva e rispettosa del pollame. L'allevamento di pollame è integrato dalla produzione di cereali."
    ],
    "fr": [
      "La SARL Dame Blanche est une entreprise familiale d'élevage avicole de poulet de chair, située à Chabeuil. Une dizaine de salariés œuvre pour un élevage non-intensif, respectueux des volailles. Une production céréalière vient compléter l'activité avicole."
    ],
    "es": [
      "SARL Dame Blanche es una explotación familiar de pollos de engorde situada en Chabeuil. Unos diez empleados trabajan en una explotación avícola no intensiva. La avicultura se complementa con la producción de cereales."
    ],
    "nl": [
      "Pluimveebedrijf. Dame Blanche is in juni 1996 opgericht door Jean-Luc Guyon voor de pluimveehouderij en Christian Guyon voor de graanproductie in en rond Chabeuil."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dame Blanche"
    ]
  },
