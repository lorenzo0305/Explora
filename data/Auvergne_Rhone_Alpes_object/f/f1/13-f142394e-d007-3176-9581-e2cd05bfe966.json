  "rdfs:comment": {
    "de": [
      "Der Wake Ski Club bietet eine Vielzahl von Wassersportaktivitäten wie Wakeboarding, Wakeskate, Wasserski, Babyski und gezogene Geräte an, die von einem staatlich geprüften Lehrer betreut werden."
    ],
    "en": [
      "Wake Ski Club offers a wide range of water sports activities, including wakeboarding, wakeskating, water skiing, baby skiing and towed vehicles, all supervised by state-certified instructors."
    ],
    "it": [
      "Il Wake Ski Club offre un'ampia gamma di attività sportive acquatiche, tra cui wakeboard, wakeskating, sci nautico, baby ski e veicoli trainati, tutte supervisionate da un istruttore certificato dallo Stato."
    ],
    "fr": [
      "Wake Ski Club propose un très grand nombre d’activités nautiques comme le wakeboard, wakeskate, le ski nautique, le Baby ski et les engins tractés, encadrées par un moniteur diplômé d’Etat."
    ],
    "es": [
      "Wake Ski Club ofrece una amplia gama de actividades deportivas acuáticas que incluyen wakeboard, wakeskating, esquí acuático, baby ski y vehículos remolcados, todas ellas supervisadas por un instructor certificado por el estado."
    ],
    "nl": [
      "Wake Ski Club biedt een breed scala aan watersportactiviteiten, waaronder wakeboarden, wakeskaten, waterskiën, babyskiën en getrokken voertuigen, allemaal onder toezicht van een door de staat gecertificeerde instructeur."
    ]
  },
  "rdfs:label": {
