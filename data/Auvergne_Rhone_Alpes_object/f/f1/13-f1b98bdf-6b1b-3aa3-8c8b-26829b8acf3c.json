  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Longessaigne ist eine Gemeindebibliothek, die mit einem Dutzend ehrenamtlicher Mitarbeiter betrieben wird. Einmal im Monat bietet die Bibliothek eine Veranstaltung mit jeder Klasse der Grundschule an."
    ],
    "en": [
      "The Longessaigne library is run by a dozen volunteers. Once a month, the library organizes an activity with each of the elementary school classes."
    ],
    "it": [
      "La biblioteca di Longessaigne è gestita da una dozzina di volontari. Una volta al mese, la biblioteca organizza un'attività per ciascuna delle classi della scuola primaria."
    ],
    "fr": [
      "La bibliothèque de Longessaigne est une bibliothèque municipale, qui fonctionne avec une dizaine de bénévoles. Une fois par mois, la bibliothèque propose une animation avec chacune des classes de l'école primaire."
    ],
    "es": [
      "La biblioteca de Longessaigne está dirigida por una docena de voluntarios. Una vez al mes, la biblioteca organiza una actividad para cada clase de primaria."
    ],
    "nl": [
      "De bibliotheek van Longessaigne wordt gerund door een tiental vrijwilligers. Een keer per maand organiseert de bibliotheek een activiteit voor elk van de basisschoolklassen."
    ]
  },
  "rdfs:label": {
