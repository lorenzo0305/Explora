  "rdfs:comment": {
    "de": [
      "Natacha SIMONNET , Bobine d'argile, empfängt Sie in ihrem Töpferatelier. Sie zeigt Ihnen ihre Kreationen von Gebrauchs- und Dekorationsgegenständen aus weißem Steingut"
    ],
    "en": [
      "Natacha welcome you to their shared workshop and shop. They'll be delighted to show you their creations of utilitarian stoneware objects. Both are passionate about working with clay, each with its own style and inspiration.\r\nIf you are unable to visit the studio, please contact us for an appointment.\r\n\r\nNatacha Hallier took up residence on 1 July 2022 and has begun production. You can find her creations in the workshop-boutique and also in the Tourist Office shops under the name Bobine d'argile."
    ],
    "it": [
      "Natacha SIMONNET , Bobine d'argile, vi accoglie nel suo laboratorio di ceramica. Vi mostrerà le sue creazioni di oggetti utilitari o decorativi in gres bianco"
    ],
    "fr": [
      "Natacha SIMONNET , Bobine d'argile, vous accueille dans son atelier de poterie. Elle vous fait découvrir ses créations d'objets utilitaires ou décoratifs en grès blanc"
    ],
    "es": [
      "Natacha SIMONNET , Bobine d'argile, le da la bienvenida a su taller de alfarería. Le mostrará sus creaciones de objetos utilitarios o decorativos en gres blanco"
    ],
    "nl": [
      "Natacha SIMONNET , Bobine d'argile, heet je welkom in haar pottenbakkersatelier. Ze toont je haar creaties van gebruiks- of siervoorwerpen in wit steengoed"
    ]
  },
