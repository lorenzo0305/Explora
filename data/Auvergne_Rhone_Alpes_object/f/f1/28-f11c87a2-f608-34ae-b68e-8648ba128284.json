  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Feuchtgebiet, das vom Bach Somme d'Or und einem Dutzend artesischer Brunnen gespeist wird. Auf Wegen, einem Steg und erklärenden Schildern können Sie diesen natürlichen Lebensraum entdecken.\n\nViel Spaß beim Entdecken!"
    ],
    "en": [
      "Discover this wetland area fed by the Somme d'Or stream and a dozen artesian wells. Paths, footbridges and information panels will help you discover this natural environment.\n\nEnjoy your discovery!"
    ],
    "it": [
      "Scoprite questa zona umida alimentata dal torrente Somme d'Or e da una dozzina di pozzi artesiani. Sentieri, passerelle e pannelli informativi vi faranno scoprire questo ambiente naturale.\n\nBuona scoperta!"
    ],
    "fr": [
      "Découvrez cette zone humide alimentée par le ruisseau de la Somme d'Or et une dizaine de puits artésiens. Chemins, passerelle et panneaux explicatifs vous permettront de découvrir ce milieu naturel.\n\nBonne découverte !"
    ],
    "nl": [
      "Ontdek dit waterrijke gebied dat gevoed wordt door de Somme d'Or en een tiental artesische bronnen. Paden, loopbruggen en informatiepanelen laten je deze natuurlijke omgeving ontdekken.\n\nGeniet van je ontdekkingstocht!"
    ],
    "es": [
      "Descubra esta zona húmeda alimentada por el arroyo Somme d'Or y una docena de pozos artesianos. Senderos, pasarelas y paneles informativos te ayudarán a descubrir este entorno natural.\n\n¡Disfrute de su descubrimiento!"
    ]
  },
  "rdfs:label": {
