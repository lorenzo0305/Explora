  "rdfs:comment": {
    "de": [
      "Besichtigung der Ziegenzucht aus biologischem Anbau, Verkostung und Verkauf von Bio-Käse. Ausflüge zur Entdeckung der Natur mit Gérard, einem begeisterten Ornithologen."
    ],
    "en": [
      "Visit of the organic goat farm, tasting and sale of organic cheeses. Outings to discover nature with Gérard, a passionate ornithologist."
    ],
    "it": [
      "Visita dell'allevamento biologico di capre, degustazione e vendita di formaggi biologici. Uscite alla scoperta della natura con Gérard, appassionato ornitologo."
    ],
    "fr": [
      "Visite de l'élevage des chèvres en agriculture biologique, dégusation et vente de fromages bio. Sorties découverte de la nature avec Gérard, ornithologue passionné."
    ],
    "es": [
      "Visita a la granja de cabras ecológicas, degustación y venta de quesos ecológicos. Salidas para descubrir la naturaleza con Gérard, un ornitólogo apasionado."
    ],
    "nl": [
      "Bezoek aan de biologische geitenboerderij, proeverij en verkoop van biologische kazen. Natuurontdekkingstochten met Gérard, een gepassioneerd ornitholoog."
    ]
  },
  "rdfs:label": {
