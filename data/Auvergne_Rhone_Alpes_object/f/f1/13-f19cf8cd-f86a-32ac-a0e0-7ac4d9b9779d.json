  "rdfs:comment": {
    "de": [
      "Reitunterricht ab 4 Jahren, Jugendliche, Erwachsene in Wettkampf und Freizeit.\r\nPonyreiten auf Anfrage ab 2 Jahren.\r\nAusritte ab 10 Jahren, Jugendliche und Erwachsene in der Freizeit.\r\nPferde und Ponys in Pension.\r\nThemenkurse"
    ],
    "en": [
      "Riding lessons from age 4, for teenagers and adults in competition and leisure.\r\nPony rides on request from age 2.\r\nHorseback riding from age 10, teenagers and adults for leisure.\r\nHorses and ponies for boarding\r\nTheme courses"
    ],
    "it": [
      "Lezioni di equitazione a partire dai 4 anni, adolescenti, adulti in competizione e nel tempo libero.\r\nGiri in pony su richiesta a partire dai 2 anni.\r\nEquitazione a partire da 10 anni, adolescenti e adulti per il tempo libero\r\nCavalli e pony in pensione\r\nCorsi a tema"
    ],
    "fr": [
      "Cours d'équitation dès 4 ans, adolescents, adultes en compétition et loisir.\r\nBalade à poney à la demande dès 2 ans.\r\nBalade à cheval dès 10 ans, adolescents et adultes en loisir\r\nChevaux et poneys en pension\r\nStages à thème"
    ],
    "nl": [
      "Paardrijlessen vanaf 4 jaar, voor tieners en volwassenen in competitie en vrije tijd.\r\nPonyrijden op aanvraag vanaf 2 jaar.\r\nPaardrijden vanaf 10 jaar, voor tieners en volwassenen in de vrije tijd.\r\nPaarden en pony's voor pensionstalling\r\nThema cursussen"
    ],
    "es": [
      "Clases de equitación a partir de 4 años, adolescentes, adultos en competición y ocio.\r\nPaseos en poni bajo petición a partir de 2 años.\r\nPaseos a caballo a partir de 10 años, adolescentes y adultos para el ocio\r\nCaballos y ponis en pensión\r\nCursos temáticos"
    ]
  },
