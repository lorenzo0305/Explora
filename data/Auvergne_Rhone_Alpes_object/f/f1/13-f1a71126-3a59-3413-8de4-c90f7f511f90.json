  "rdfs:comment": {
    "de": [
      "Das Maison Nô befindet sich in einer ehemaligen Bank in einem historischen Gebäude und ist ein 4-Sterne-Boutique-Hotel. Das Restaurant Le Rooftop verfügt über eine Panoramaterrasse mit einem atemberaubenden Blick auf die Stadt Lyon."
    ],
    "en": [
      "Located in a historical building, Maison Nô is a four-star boutique-hotel, with a restaurant, Le Rooftop, offering a panoramic terrace with a stunning view of Lyon."
    ],
    "it": [
      "Ospitato in un'ex banca in un edificio storico, la Maison Nô è un hotel boutique a 4 stelle, il cui ristorante Le Rooftop dispone di una terrazza panoramica che offre una vista mozzafiato sulla città di Lione."
    ],
    "fr": [
      "Installé dans une ancienne banque dans un immeuble historique, Maison Nô est un boutique hôtel 4 étoiles, dont le restaurant Le Rooftop dispose d’une terrasse panoramique offrant une vue imprenable sur la ville de Lyon."
    ],
    "es": [
      "Ubicado en un antiguo banco en un edificio histórico, Maison Nô es un hotel boutique de 4 estrellas, cuyo restaurante Le Rooftop tiene una terraza panorámica que ofrece una vista impresionante de la ciudad de Lyon."
    ],
    "nl": [
      "Maison Nô, gevestigd in een voormalige bank in een historisch gebouw, is een 4-sterren boetiekhotel, waarvan het restaurant Le Rooftop beschikt over een panoramisch terras met een adembenemend uitzicht over de stad Lyon."
    ]
  },
