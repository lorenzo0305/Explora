  "rdfs:comment": {
    "de": [
      "Fast Food auf dem Land, das ein Menü mit hausgemachten panierten Hähnchenbruststreifen oder Hot Dogs mit einer Metzgerwurst ohne Zusatzstoffe, die zu 100 % natürlich ist, zusammen mit Pommes frites - italienischem Eis, Waffeln und hausgemachten Crêpes anbietet."
    ],
    "en": [
      "Country fast food, offering a menu with homemade breaded chicken strips or hots dogs with 100% natural, additive-free butcher's sausage, accompanied by fries - Italian ices, waffles and homemade crêpes."
    ],
    "it": [
      "Fast food in campagna, che offre un menu con strisce di pollo impanate in casa o hot dog con salsiccia di macelleria 100% naturale senza additivi, accompagnati da patatine fritte - gelati italiani, waffle e frittelle fatte in casa."
    ],
    "fr": [
      "Fast food des campagnes, proposant un menu avec des aiguillettes de poulet panés maison ou hots dog avec une saucisse bouchère sans additifs 100% naturel accompagnés de frites - glaces italiennes, gaufres et crêpes maison."
    ],
    "nl": [
      "Fastfood op het platteland, met een menu met zelfgemaakte gepaneerde kipreepjes of hotdogs met 100% natuurlijke worst zonder toevoegingen van de slager, vergezeld van frietjes - Italiaans ijs, wafels en zelfgemaakte pannenkoeken."
    ],
    "es": [
      "Comida rápida en el campo, que ofrece un menú con tiras de pollo empanado casero o perritos calientes con salchicha de carnicero 100% natural sin aditivos, acompañados de patatas fritas - helados italianos, gofres y tortitas caseras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Foodtruck Les Voisines"
    ]
  },
