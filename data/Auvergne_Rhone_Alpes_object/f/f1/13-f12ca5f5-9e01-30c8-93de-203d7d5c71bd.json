  "rdfs:comment": {
    "de": [
      "Verkauf von landwirtschaftlichen Produkten und regionalen Produkten, ätherischen Lavendelölen, Weinen, Obst und Gemüse, hausgemachtem Apfelsaft und Traubensaft. Ökologische Pflegemittel, Bio-Lebensmittel, Speiseeis ..."
    ],
    "en": [
      "Sales of farmhouse and regional products, lavender essential oil, fruit and vegetables, artisanally-made apple and grape juice. Environmentally-friendly cleaning products, organic groceries, artisanal ice cream, and much more besides."
    ],
    "it": [
      "Vendita di prodotti aziendali: ciliegie, albicocche, pesche, mele, pere, mandorle, verdure di stagione, succhi di frutta e composte, olio essenziale di lavanda, vini.\nProdotti regionali: formaggi, carni, salumi, miele, marmellate, regali."
    ],
    "fr": [
      "Vente de produits de la ferme : cerise, abricots, pêches, pommes, poires ,amandes, légumes de saison, jus et compotes de nos fruits, huile essentielle de lavande, vins.\nProduits régionaux : Fromages, viande, charcuterie, , miel, confitures, cadeaux."
    ],
    "nl": [
      "Verkoop van boerderij- en regionale producten, etherische lavandelolie, wijn, fruit en groente, ambachtelijke productie van appelsap en druivensap. Milieuvriendelijke schoonmaakmiddelen, biologische kruidenier, ambachtelijk ijs, etc."
    ],
    "es": [
      "Venta de productos agrícolas: cerezas, albaricoques, melocotones, manzanas, peras, almendras, verduras de temporada, zumos y compotas de frutas, aceite esencial de lavanda, vinos.\nProductos regionales: queso, carne, charcutería, miel, mermeladas, regalos."
    ]
