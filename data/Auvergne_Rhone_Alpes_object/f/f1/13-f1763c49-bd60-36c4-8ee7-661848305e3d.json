  "rdfs:comment": {
    "de": [
      "Mehrere Anlaufstellen in der Region: Maurs, Montsalvy, Laroquebrou und Le Rouget-Pers. Im Juli und August ist eine Anlaufstelle in der Gemeinde Marcolès geöffnet."
    ],
    "en": [
      "Several reception points in the area: Maurs, Montsalvy, Laroquebrou and Le Rouget-Pers. In July and August, a reception point is open in the commune of Marcolès."
    ],
    "it": [
      "Nella zona sono presenti diversi centri di accoglienza: Maurs, Montsalvy, Laroquebrou e Le Rouget-Pers. Nei mesi di luglio e agosto è aperto un punto di accoglienza nel comune di Marcolès."
    ],
    "fr": [
      "Plusieurs points d'accueil sur le territoire : Maurs, Montsalvy, Laroquebrou et Le Rouget-Pers. En juillet et août, un point d'accueil est ouvert sur la commune de Marcolès."
    ],
    "es": [
      "Hay varios centros de acogida en la zona: Maurs, Montsalvy, Laroquebrou y Le Rouget-Pers. En julio y agosto, está abierto un punto de acogida en la comuna de Marcolès."
    ],
    "nl": [
      "Er zijn verschillende opvangcentra in de omgeving: Maurs, Montsalvy, Laroquebrou en Le Rouget-Pers. In juli en augustus is er een opvangpunt geopend in de gemeente Marcolès."
    ]
  },
