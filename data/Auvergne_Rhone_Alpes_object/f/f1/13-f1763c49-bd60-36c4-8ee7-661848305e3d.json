      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/320ea24a-80ea-3f40-ad80-9d7e3ce5d535",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Täglich im Juli und August von 9:30 bis 12:30 Uhr und von 14:00 bis 18:30 Uhr. Von Juni bis September von 9:00 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr geöffnet:\r\n- Le Rouget-Pers: mittwochs, donnerstags, samstags und sonntags vormittags geöffnet.\r\n- Maurs: dienstags, donnerstags, freitags und samstags geöffnet.\r\n- Laroquebrou: dienstags, mittwochs, freitags und samstags geöffnet.\r\n- Montsalvy: Montags, donnerstags, freitags und samstags geöffnet."
            ],
            "en": [
              "Open daily in July and August from 9:30 am to 12:30 pm and from 2 pm to 6:30 pm. June to September open 9am to 12pm and 2pm to 5pm:\r\n- Le Rouget-Pers: open every Wednesday, Thursday, Saturday and Sunday morning.\r\n- Maurs: open Tuesdays, Thursdays, Fridays and Saturdays.\r\n- Laroquebrou: open Tuesdays, Wednesdays, Fridays and Saturdays.\r\n- Montsalvy: open Mondays, Thursdays, Fridays and Saturdays."
            ],
            "it": [
              "Aperto tutti i giorni in luglio e agosto dalle 9.30 alle 12.30 e dalle 14.00 alle 18.30. Da giugno a settembre aperto dalle 9.00 alle 12.00 e dalle 14.00 alle 17.00:\r\n- Le Rouget-Pers: aperto ogni mercoledì, giovedì, sabato e domenica mattina.\r\n- Maurs: aperto martedì, giovedì, venerdì e sabato.\r\n- Laroquebrou: aperto martedì, mercoledì, venerdì e sabato.\r\n- Montsalvy: aperto lunedì, giovedì, venerdì e sabato."
            ],
            "fr": [
              "Tous les jours en juillet et aout de 9h30 à 12h30 et de 14h à 18h30. De juin à septembre ouvert de 9h à 12h et de 14h à 17h : \r\n- Le Rouget-Pers : ouvert tous les mercredis, jeudis, samedis et dimanche matin.\r\n- Maurs : ouvert les mardis, jeudis, vendredis et samedis.\r\n- Laroquebrou : ouvert les mardis, mercredis, vendredis et samedis.\r\n- Montsalvy : ouvert les lundis, jeudis, vendredis et samedis."
            ],
            "nl": [
              "In juli en augustus dagelijks geopend van 9.30 tot 12.30 uur en van 14.00 tot 18.30 uur. Van juni tot september geopend van 9.00 tot 12.00 uur en van 14.00 tot 17.00 uur:\r\n- Le Rouget-Pers: elke woensdag, donderdag, zaterdag en zondagochtend geopend.\r\n- Maurs: open op dinsdag, donderdag, vrijdag en zaterdag.\r\n- Laroquebrou: open op dinsdag, woensdag, vrijdag en zaterdag.\r\n- Montsalvy: open op maandag, donderdag, vrijdag en zaterdag."
            ],
            "es": [
              "Abierto todos los días en julio y agosto de 9.30 a 12.30 y de 14.00 a 18.30. De junio a septiembre, abierto de 9.00 a 12.00 y de 14.00 a 17.00 h:\r\n- Le Rouget-Pers: abierto todos los miércoles, jueves, sábados y domingos por la mañana.\r\n- Maurs: abierto los martes, jueves, viernes y sábados.\r\n- Laroquebrou: abierto los martes, miércoles, viernes y sábados.\r\n- Montsalvy: abierto los lunes, jueves, viernes y sábados."
            ]
          },
