  "rdfs:comment": {
    "de": [
      "Willkommen auf der Ferme Équestre de Chantaigut, in der Gemeinde Ceilloux. Sie ist das ganze Jahr über geöffnet und bietet Reitaktivitäten - touristisch oder sportlich - für alle Altersgruppen und jedes Niveau."
    ],
    "en": [
      "Welcome to La Ferme Equestre de Chantaigut, in the commune of Ceilloux. It is open all year round and offers equestrian activities - tourist or sporting - for all ages and all levels."
    ],
    "it": [
      "Benvenuti a La Ferme Equestre de Chantaigut, nel comune di Ceilloux. È aperto tutto l'anno e offre attività equestri - turistiche o sportive - per tutte le età e tutti i livelli."
    ],
    "fr": [
      "Bienvenue à La Ferme Équestre de Chantaigut, sur la commune de Ceilloux. Elle est ouverte toute l'année et propose des activités équestres - touristiques ou sportives - pour tous âges et tous niveaux."
    ],
    "nl": [
      "Welkom bij La Ferme Equestre de Chantaigut, in de gemeente Ceilloux. Het is het hele jaar geopend en biedt ruiteractiviteiten - toeristisch of sportief - voor alle leeftijden en alle niveaus."
    ],
    "es": [
      "Bienvenido a La Ferme Equestre de Chantaigut, en el municipio de Ceilloux. Está abierto todo el año y ofrece actividades ecuestres -turísticas o deportivas- para todas las edades y todos los niveles."
    ]
  },
  "rdfs:label": {
