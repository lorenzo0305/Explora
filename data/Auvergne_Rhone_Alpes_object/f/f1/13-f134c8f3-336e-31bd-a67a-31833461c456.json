  "rdfs:comment": {
    "de": [
      "Die Gesellschaft verwaltet das Skigebiet sowie die Freizeiteinrichtungen wie den Fantasticable, den Bike Park, die Bob-Rodelbahnen sowie den Parcours Châtel Aventures."
    ],
    "en": [
      "The company manages the ski area as well as the recreational activities as the Fantasticable, the Bike-Pak, the summer bobsled, as well as the adventure park."
    ],
    "it": [
      "La società gestisce il comprensorio sciistico e le strutture per il tempo libero come il Fantasticable, il Bike Park, le piste da bob e il percorso Châtel Aventures."
    ],
    "fr": [
      "La société gère le domaine skiable ainsi que les équipements de loisirs comme le Fantasticable, le Bike Park, les pistes de bob-luge, ainsi que le parcours Châtel Aventures."
    ],
    "es": [
      "La empresa gestiona el dominio esquiable, así como instalaciones de ocio como el Fantasticable, el Bike Park, las pistas de bobsleigh y el recorrido Châtel Aventures."
    ],
    "nl": [
      "Het bedrijf beheert het skigebied, evenals de recreatieve voorzieningen zoals de fantastiscable, het Bikepark, de bobsleebaan en het avonturencircuit Châtel Aventures."
    ]
