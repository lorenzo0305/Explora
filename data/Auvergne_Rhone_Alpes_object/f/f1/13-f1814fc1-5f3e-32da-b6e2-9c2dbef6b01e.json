  "rdfs:comment": {
    "de": [
      "Das Hotel Les Balcons Village*** liegt oberhalb des Ortes Belle-Plagne mit Zugang zu den Skipisten. Es verfügt über 41 Zimmer mit Aussicht im traditionellen Savoyer Stil, ein Restaurant und Zugang zum Spa Les Balcons in unmittelbarer Nähe."
    ],
    "en": [
      "Situated at the top of Belle-Plagne with ski-in, ski-out access, the Hotel Les Balcons Village*** has 41 rooms with mountain views in traditional Savoyard style, as well as a restaurant and access to the Les Balcons spa just next door."
    ],
    "it": [
      "Situato sulle alture della località di Belle-Plagne con accesso ski-to-door, l'Hôtel Les Balcons Village*** dispone di 41 camere con vista, in stile tradizionale savoiardo, oltre a un ristorante e all'accesso al centro benessere Les Balcons proprio accanto."
    ],
    "fr": [
      "Situé sur les hauteurs de la station de Belle-Plagne avec accès skis aux pieds, l’Hôtel Les Balcons Village*** comprend 41 chambres avec vue, dans un style savoyard traditionnel, ainsi qu'un restaurant et un accès au spa Les Balcons à proximité immédiate."
    ],
    "es": [
      "Situado en las alturas de la estación de Belle-Plagne con acceso a pie de pista, el Hôtel Les Balcons Village*** dispone de 41 habitaciones con vistas, de estilo tradicional saboyano, así como de un restaurante y acceso al spa Les Balcons, justo al lado."
    ],
    "nl": [
      "Hôtel Les Balcons Village*** ligt op de hoogten van het Belle-Plagne resort met ski-to-deur toegang en heeft 41 kamers met uitzicht, in traditionele Savoyaardse stijl, evenals een restaurant en toegang tot de Les Balcons spa direct naast de deur."
    ]
  },
