  "rdfs:comment": {
    "de": [
      "Die Eisbahn ist von Freitag, dem 16. Januar, bis Sonntag, dem 18. Januar 2026, aufgrund des internationalen Curlingturniers für die Öffentlichkeit geschlossen."
    ],
    "en": [
      "Located at the heart of the village this semi-natural ice rink is open from mid december until March.\r\nEnjoy skating and the exceptional surrounding panoramic views."
    ],
    "it": [
      "La pista di pattinaggio sarà chiusa al pubblico da venerdì 16 gennaio a domenica 18 gennaio 2026 per il torneo internazionale di curling."
    ],
    "fr": [
      "La patinoire est fermée au public du vendredi 16 janvier au dimanche 18 janvier 2026 en raison du tournoi international de curling."
    ],
    "es": [
      "La pista de hielo permanecerá cerrada al público del viernes 16 de enero al domingo 18 de enero de 2026 con motivo del torneo internacional de curling."
    ],
    "nl": [
      "De ijsbaan is van vrijdag 16 januari tot en met zondag 18 januari 2026 gesloten voor het publiek voor het internationale curlingtoernooi."
    ]
  },
