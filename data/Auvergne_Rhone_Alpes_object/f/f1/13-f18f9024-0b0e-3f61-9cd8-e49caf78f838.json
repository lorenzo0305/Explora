  "rdfs:comment": {
    "de": [
      "Stürzen Sie sich auf unsere Rodelbahn mit Zeitmessung! Groß und Klein können mit Höchstgeschwindigkeit hinuntersausen, sich gegenseitig herausfordern und einen Moment voller Spaß und Sensationen teilen. Wer wird die schnellste Zeit fahren?"
    ],
    "en": [
      "Take to our timed toboggan run! Young and old alike can hurtle down at top speed, challenge each other and share a fun, thrilling experience. Who will set the fastest time?"
    ],
    "it": [
      "Mettetevi alla prova sulla nostra pista da slittino a tempo! Grandi e piccini potranno sfrecciare sulla pista alla massima velocità, sfidandosi a vicenda e condividendo un'esperienza divertente. Chi farà il tempo più veloce?"
    ],
    "fr": [
      "Lancez-vous sur notre piste de luge chronométrée ! Petits et grands pourront dévaler à toute vitesse, se challenger et partager un moment fun et plein de sensations. Qui signera le meilleur temps ?"
    ],
    "es": [
      "¡Anímate a probar nuestra pista de trineo cronometrada! Grandes y pequeños podrán lanzarse a toda velocidad, retarse entre ellos y compartir un momento divertido y lleno de emociones. ¿Quién conseguirá el mejor tiempo?"
    ],
    "nl": [
      "Probeer onze getimede rodelbaan! Jong en oud kunnen op topsnelheid over de baan racen, elkaar uitdagen en een leuke ervaring delen. Wie zet de snelste tijd neer?"
    ]
  },
  "rdfs:label": {
    "en": [
      "Timed sledge race"
    ],
    "fr": [
      "Course de luge chronométrée"
    ],
    "es": [
      "Carrera cronometrada de trineo"
    ]
  },
