  "rdfs:comment": {
    "de": [
      "Diese 5,5 km lange, gesicherte Route mit 600 m positivem Höhenunterschied beginnt an der Schneefront von Méribel Village und bietet Ihnen, den Anhängern des Skitourengehens, eine perfekte Mischung aus atemberaubenden Panoramen und Passagen durch den majestätischen Wald des Altiports."
    ],
    "en": [
      "Departing from the Méribel Village snow front, this 5.5km safe route with a 600m vertical drop is for you, ski tourers, a perfect blend of breathtaking panoramas and passages through the majestic Altiport forest."
    ],
    "it": [
      "Partendo dal fronte neve del Méribel Village, questo percorso sicuro di 5,5 km e 600 metri di altezza è un mix perfetto di panorami mozzafiato e passaggi attraverso la maestosa foresta dell'Altiport."
    ],
    "fr": [
      "Au départ du front de neige de Méribel Village, cet itinéraire sécurisé de 5,5 km et 600m de dénivelé positif s'offre à vous, adeptes du ski de rando, mélange parfait entre panoramas époustouflants et passages à travers la majestueuse forêt de l'Altiport."
    ],
    "nl": [
      "Deze 5,5 km lange, veilige route op 600 meter hoogte vertrekt vanaf het sneeuwfront van Méribel Village en is de perfecte mix van adembenemende panorama's en passages door het majestueuze bos van Altiport."
    ],
    "es": [
      "Con salida desde el frente de nieve de Méribel Village, esta ruta segura de 5,5 km y 600 m de altura es la mezcla perfecta de panoramas impresionantes y pasajes por el majestuoso bosque de Altiport."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski touring itinerary Méribel Village"
    ],
    "fr": [
      "Itinéraire ski de randonnée Méribel Village"
    ]
  },
