  "rdfs:comment": {
    "de": [
      "In den Papeteries, einem von Citia betreuten Totemort der Bild- und Kreativindustrie, sind über 50 Unternehmen angesiedelt, vom Start-up bis zum KMU. Betreuung vor Ort in Form von Workshops, Co-Development-Sitzungen und Expertensprechstunden."
    ],
    "en": [
      "Les Papeteries is a totem pole for the image and creative industries, run by Citia, and home to over 50 companies, from start-ups to SMEs. On-site support in the form of workshops, co-development sessions and expert consultations."
    ],
    "it": [
      "The Papeteries è un centro di punta per le industrie dell'immagine e della creatività, gestito da Citia, che ospita oltre 50 aziende, dalle start-up alle PMI. Supporto in loco sotto forma di workshop, sessioni di co-sviluppo e consulenze di esperti."
    ],
    "fr": [
      "Lieu totem de l'image et des industries créatives animé par Citia, les Papeteries regroupent plus de 50 entreprises, de la startup à la PME. Accompagnement sur place sous forme d'ateliers, de séances de co-développement et de permanences d’experts."
    ],
    "es": [
      "The Papeteries es un centro emblemático para las industrias de la imagen y la creación, gestionado por Citia, que acoge a más de 50 empresas, desde start-ups hasta PYME. Apoyo in situ en forma de talleres, sesiones de codesarrollo y consultas de expertos."
    ],
    "nl": [
      "De Papeteries is een toonaangevend centrum voor de beeld- en creatieve industrie, gerund door Citia. Er zijn meer dan 50 bedrijven gevestigd, van start-ups tot MKB-bedrijven. Ondersteuning op locatie in de vorm van workshops, co-ontwikkelingssessies en consultaties van deskundigen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Papeteries Image Factory"
    ]
  },
