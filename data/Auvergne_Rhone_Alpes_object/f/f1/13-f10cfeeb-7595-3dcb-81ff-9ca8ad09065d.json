  "rdfs:comment": {
    "de": [
      "Diese Veranstaltung wird vom SEL des gorges de la Sioule organisiert. Das Prinzip :\r\n bringen Sie Ihre verwurzelten oder wurzelnackten Pflanzen, Ihre Samen in Tüten, Ihre Stecklinge...für einen Moment des Austauschs mit."
    ],
    "en": [
      "This event is organized by the SEL des gorges de la Sioule. The principle:\r\n bring your rooted or bare-rooted plants, your seeds in sachets, your cuttings... for a moment of exchange."
    ],
    "it": [
      "Questo evento è organizzato dal SEL des gorges de la Sioule. Il principio:\r\n portate le vostre piante radicate o nude, i vostri semi in bustina, le vostre talee... per un momento di scambio."
    ],
    "fr": [
      "Cette manifestation est organisée par le SEL des gorges de la Sioule. Le principe :\r\n apporter vos plantes enracinées, en racines nues, vos graines en sachets, vos boutures...pour un moment d'échange."
    ],
    "es": [
      "Este evento está organizado por el SEL des gorges de la Sioule. El principio :\r\n traiga sus plantas enraizadas o a raíz desnuda, sus semillas en bolsitas, sus esquejes... para un momento de intercambio."
    ],
    "nl": [
      "Dit evenement wordt georganiseerd door SEL des gorges de la Sioule. Het principe :\r\n breng je planten met wortels of blote wortels, je zaden in zakjes, je stekken... mee voor een uitwisselingsmoment."
    ]
  },
