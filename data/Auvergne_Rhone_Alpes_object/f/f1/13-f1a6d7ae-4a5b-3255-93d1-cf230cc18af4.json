  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt bietet folgende Dienstleistungen an:\r\n- Touristeninformationen\r\n- Kartenverkauf für Aufführungen\r\n- Verkauf von Angelscheinen und Zugang zu den Tennisplätzen\r\n- Reservierung der Unterkunft \"Gîte du Presbytère\"\r\n- Verkauf von einigen Artikeln (Bücher, Goodies, etc.)"
    ],
    "en": [
      "The Tourist Office offers the following services:\r\n- Tourist information\r\n- Tickets for shows\r\n- Sale of fishing permits and access to tennis courts\r\n- Reservations for the Gîte du Presbytère\r\n- Sale of certain items (books, goodies, etc.)"
    ],
    "it": [
      "L'Ufficio del Turismo offre i seguenti servizi:\r\n- Informazioni turistiche\r\n- Biglietti per spettacoli\r\n- Vendita di permessi di pesca e accesso ai campi da tennis\r\n- Prenotazioni per il Gîte du Presbytère\r\n- Vendita di alcuni articoli (libri, articoli da regalo, ecc.)"
    ],
    "fr": [
      "L'Office de Tourisme propose les services suivants :\r\n- Informations touristiques\r\n- Billetterie spectacles\r\n- Vente de permis de pêche et accès aux terrains de tennis\r\n- Réservation du Gîte du Presbytère\r\n- Vente de quelques articles (livres, goodies, etc...)"
    ],
    "es": [
      "La Oficina de Turismo ofrece los siguientes servicios\r\n- Información turística\r\n- Entradas para espectáculos\r\n- Venta de permisos de pesca y acceso a las pistas de tenis\r\n- Reservas en la Casa Rural del Presbiterio\r\n- Venta de determinados artículos (libros, golosinas, etc.)"
    ],
    "nl": [
      "Het VVV-kantoor biedt de volgende diensten:\r\n- Toeristische informatie\r\n- Tickets voor voorstellingen\r\n- Verkoop van visvergunningen en toegang tot tennisbanen\r\n- Reserveringen voor de Gîte du Presbytère\r\n- Verkoop van bepaalde artikelen (boeken, goodies, enz.)"
    ]
  },
