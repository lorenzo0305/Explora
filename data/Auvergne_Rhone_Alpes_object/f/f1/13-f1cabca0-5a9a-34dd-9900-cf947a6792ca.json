  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek erstreckt sich über 1 200 m² (200 m² für Kinder) mit 55 000 Medien, DVDs, Buch-CDs für Sehbehinderte, nationaler und regionaler Presse. Kunstbücher (Foto & Film). Multimedialer Bereich. 100 m² großer Konferenzraum."
    ],
    "en": [
      "The municipal library covers 1,200 m² (200 m² for children) with 55,000 documents, DVDs, CD books for the visually impaired, national and regional press. Works of art (photography & cinema). Multimedia space. 100 m² conference room."
    ],
    "it": [
      "La biblioteca comunale si estende su 1.200 m² (200 m² per i bambini) con 55.000 documenti, DVD, libri e CD per ipovedenti, stampa nazionale e regionale. Libri d'arte (fotografia e cinema). Spazio multimediale. Sala conferenze di 100 m²."
    ],
    "fr": [
      "La bibliothèque municipale s'étend sur 1 200 m² (200 m² pour enfants) avec  55 000 documents,  DVD, livres CD pour mal-voyants, presse nationale et régionale. Ouvrages d'art (photo & cinéma). Espace multi-média. Salle pour conférences de 100 m²."
    ],
    "es": [
      "La biblioteca municipal ocupa 1.200 m² (200 m² para niños) con 55.000 documentos, DVD, libros y CD para discapacitados visuales, prensa nacional y regional. Libros de arte (fotografía y cine). Espacio multimedia. Sala de conferencias de 100 m²."
    ],
    "nl": [
      "De gemeentelijke bibliotheek beslaat 1.200 m² (200 m² voor kinderen) met 55.000 documenten, dvd's, boeken en cd's voor slechtzienden, nationale en regionale pers. Kunstboeken (foto en film). Multi-media ruimte. Conferentiezaal van 100 m²."
    ]
  },
  "rdfs:label": {
