  "rdfs:comment": {
    "de": [
      "Atelier mit Galerie. Möglichkeit, die Bilder online direkt auf der Website anzusehen. www.artfleuron.fr oder nach Vereinbarung 06 88 24 29 46.\r\nZeichen- und Malkurse für Erwachsene und Jugendliche während der Schulzeit.\r\nAnmeldung das ganze Jahr über."
    ],
    "en": [
      "Workshop and gallery. Possibility of viewing paintings online directly on the website. www.artfleuron.fr or by appointment 06 88 24 29 46\r\nDrawing and painting classes for adults and teenagers during the school year.\r\nenrolment all year round."
    ],
    "it": [
      "Studio-galleria. Possibilità di visionare i dipinti online direttamente sul sito. www.artfleuron.fr o su appuntamento 06 88 24 29 46.\r\nCorsi di disegno e pittura per adulti e ragazzi durante le vacanze scolastiche.\r\nIscrizioni tutto l'anno."
    ],
    "fr": [
      "Atelier-galerie. Possibilité de voir les tableaux en ligne directement sur le site internet. www.artfleuron.fr ou sur rendez-vous 06 88 24 29 46.\r\nCours dessin- peinture pour adultes et ados pendant  les périodes scolaires.\r\nInscription toute l'année."
    ],
    "nl": [
      "Studio-galerie. Mogelijkheid om schilderijen direct online te bekijken op de website. www.artfleuron.fr of op afspraak 06 88 24 29 46.\r\nTeken- en schilderlessen voor volwassenen en tieners tijdens schoolvakanties.\r\nInschrijving het hele jaar door."
    ],
    "es": [
      "Estudio-galería. Posibilidad de ver cuadros en línea directamente en la página web. www.artfleuron.fr o con cita previa 06 88 24 29 46.\r\nClases de dibujo y pintura para adultos y adolescentes durante las vacaciones escolares.\r\nInscripciones todo el año."
    ]
  },
