  "rdfs:comment": {
    "de": [
      "Wir sind stolz darauf, ein erstklassiges kulinarisches Erlebnis mit viel Liebe zum Detail zu bieten, vom herzlichen Service bis zur gemütlichen Atmosphäre."
    ],
    "en": [
      "We pride ourselves on delivering a superior dining experience with attention to detail, from the warm service to the friendly atmosphere."
    ],
    "it": [
      "Siamo orgogliosi di offrire un'esperienza culinaria di qualità superiore con attenzione ai dettagli, dal servizio cordiale all'atmosfera amichevole."
    ],
    "fr": [
      "Nous sommes fiers de proposer une expérience culinaire de qualité supérieure avec une attention particulière portée aux détails, du service chaleureux à l'ambiance conviviale."
    ],
    "nl": [
      "We zijn trots op het leveren van een superieure eetervaring met aandacht voor detail, van de warme service tot de vriendelijke sfeer."
    ],
    "es": [
      "Nos enorgullecemos de ofrecer una experiencia gastronómica superior con atención al detalle, desde el cálido servicio hasta el ambiente acogedor."
    ]
  },
