  "rdfs:comment": {
    "de": [
      "Willkommen im L'Estanco! Lokale Küche aus frischen und saisonalen Produkten, die von Chefkoch Remy zubereitet wird. Wir bieten auch einen Barservice, Brot und Zeitungen an. Semi-gastronomische Küche von Freitag bis Sonntag."
    ],
    "en": [
      "Welcome to l'Estanco! Local cuisine with fresh seasonal produce prepared by chef Rémy. We also offer bar service, a bread and newspaper stand. Semi-gastronomic cuisine from Friday to Sunday."
    ],
    "it": [
      "Benvenuti a l'Estanco! Cucina locale con prodotti freschi di stagione preparati dallo chef Rémy. Offriamo anche un servizio bar e una rivendita di pane e giornali. Cucina semi-gastronomica dal venerdì alla domenica."
    ],
    "fr": [
      "Bienvenue à l'Estanco ! Cuisine locale, de produits frais et de saison élaborée par le chef Rémy. Nous proposons également un service bar, un dépôt de pain et de journaux. Cuisine semi-gastronomique du vendredi au dimanche."
    ],
    "es": [
      "¡Bienvenido a l'Estanco! Cocina local con productos frescos de temporada elaborada por el chef Rémy. También ofrecemos un servicio de bar y una tienda de pan y periódicos. Cocina semigastronómica de viernes a domingo."
    ],
    "nl": [
      "Welkom bij l'Estanco! Lokale gerechten met verse seizoensproducten bereid door chef Rémy. We bieden ook een barservice en een brood- en krantenwinkel. Semi-gastronomische keuken van vrijdag tot zondag."
    ]
  },
