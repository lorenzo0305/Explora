  "rdfs:comment": {
    "de": [
      "Seit über 115 Jahren stellen die Brüder der Heiligen Familie Getränke mit wohltuender Wirkung her, eine geschickte Mischung aus oft seltenen Alpenpflanzen."
    ],
    "en": [
      "For more than 115 years, the Brothers of the Holy Family have been producing drinks with beneficial properties, a clever mix of alpine plants that are often rare."
    ],
    "it": [
      "Da oltre 115 anni, i Fratelli della Sacra Famiglia producono bevande dalle proprietà benefiche, una sapiente miscela di piante alpine spesso rare."
    ],
    "fr": [
      "Depuis plus de 115 ans, les Frères de la Sainte-Famille produisent des boissons aux vertus bienfaitrices, savant mélange de plantes alpines souvent rares."
    ],
    "es": [
      "Desde hace más de 115 años, los Hermanos de la Sagrada Familia producen bebidas con propiedades beneficiosas, una hábil mezcla de plantas alpinas a menudo raras."
    ],
    "nl": [
      "Al meer dan 115 jaar produceren de Broeders van de Heilige Familie dranken met heilzame eigenschappen, een kundig mengsel van vaak zeldzame Alpenplanten."
    ]
  },
