  "rdfs:comment": {
    "de": [
      "Der Kinofrühling kehrt vom 22. bis 24. März 2026 zurück! Eine einmalige Gelegenheit für alle Kinobesucher, mit der Familie, mit Freunden oder allein das Erlebnis eines Kinosaals zu genießen, zu einem Einheitspreis von 5 Euro pro Vorstellung."
    ],
    "en": [
      "Printemps du Cinéma returns from March 22 to 24, 2026! A unique opportunity for all spectators to enjoy the cinema experience with family, friends or solo, at a single rate of 5 euros per screening."
    ],
    "it": [
      "Il Printemps du Cinéma torna dal 22 al 24 marzo 2026! Si tratta di un'opportunità unica per gli spettatori di tutte le età di vivere un'esperienza cinematografica con la famiglia, gli amici o da soli, al prezzo di un biglietto unico di 5 euro."
    ],
    "fr": [
      "Le Printemps du Cinéma revient du 22 au 24 mars 2026 ! L’occasion unique pour tous les spectateurs de profiter en famille, entre amis ou en solo de l’expérience de la salle de cinéma, à un tarif unique de 5 euros la séance."
    ],
    "es": [
      "¡Printemps du Cinéma vuelve del 22 al 24 de marzo de 2026! Es una oportunidad única para que todos los cinéfilos disfruten de la experiencia del cine en familia, con amigos o solos, a un precio único de 5 euros por proyección."
    ],
    "nl": [
      "Printemps du Cinéma keert terug van 22 tot 24 maart 2026! Het is een unieke kans voor alle bioscoopbezoekers om te genieten van een bioscoopervaring met familie, vrienden of alleen, voor één prijs van €5 per voorstelling."
    ]
  },
  "rdfs:label": {
