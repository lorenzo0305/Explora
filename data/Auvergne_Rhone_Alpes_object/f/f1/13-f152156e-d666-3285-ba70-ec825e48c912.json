  "rdfs:comment": {
    "de": [
      "Die offenen Bühnen der Excités: Wer weiß, was dort passieren wird?\r\nOrange Jam sind die Abende, an denen alles erlaubt ist!\r\nExperimentiere mit deinen Ideen, schlage ein Konzept vor und teile die Bühne mit der Community"
    ],
    "en": [
      "Les Scènes ouvertes des Excités: Who knows what's going to happen?\r\nOrange Jam is a party where anything goes!\r\nCome and try out your ideas, propose a concept and share the stage with the community"
    ],
    "it": [
      "Les Scènes ouvertes des Excités: chi sa cosa succederà?\r\nOrange Jam è una festa in cui tutto è possibile!\r\nVenite a provare le vostre idee, a proporre un concetto e a condividere il palco con la comunità"
    ],
    "fr": [
      "Les Scènes ouvertes des Excités : Qui sait ce qui va s’y dérouler ?\r\nOrange Jam ce sont les soirées où tout est permis !\r\nViens expérimenter tes idées, propose un concept et partage la scène avec la communauté"
    ],
    "es": [
      "Les Scènes ouvertes des Excités: ¿Quién sabe lo que va a pasar?\r\nOrange Jam es una fiesta en la que todo vale\r\nVen a probar tus ideas, propón un concepto y comparte el escenario con la comunidad"
    ],
    "nl": [
      "Les Scènes ouvertes des Excités: Wie weet wat er gaat gebeuren?\r\nOrange Jam is een feest waar alles kan!\r\nKom je ideeën uitproberen, stel een concept voor en deel het podium met de gemeenschap"
    ]
  },
  "rdfs:label": {
    "fr": [
      "- ANNULE - Théâtre d'impro : Orange Jam"
