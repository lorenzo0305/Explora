  "rdfs:comment": {
    "de": [
      "Erleben Sie ein unvergessliches Abenteuer mit Schlittenhunden!\r\nDas gesamte Team und unsere Musher werden Sie an ihrer außergewöhnlichen Welt teilhaben lassen, in Begleitung ihrer 70 liebenswerten Polarhunde und durch verschiedene Aktivitäten für alle Altersgruppen."
    ],
    "en": [
      "Ride behind a real dog sled team for a wild magical experience !"
    ],
    "it": [
      "Vivete un'avventura indimenticabile con i cani da slitta!\r\nL'intero team e i nostri musher condivideranno con voi il loro mondo eccezionale, in compagnia dei loro 70 adorabili cani polari e attraverso varie attività per tutte le età."
    ],
    "fr": [
      "Vivez une aventure inoubliable avec des chiens de traîneaux !\r\nToute l'équipe et nos Mushers vous feront partager leur univers exceptionnel en compagnie de leurs adorables 70 chiens polaires et au travers de différentes activités pour tous publics."
    ],
    "es": [
      "¡Viva una aventura inolvidable con perros de trineo!\r\nTodo el equipo y nuestros mushers compartirán contigo su excepcional mundo, en compañía de sus 70 adorables perros polares y a través de diversas actividades para todas las edades."
    ],
    "nl": [
      "Beleef een onvergetelijk avontuur met sledehonden!\r\nSerge Verhille is een professionele musher die met plezier zijn kennis en ervaring over de sledehonden en de uitrustingen met u deelt."
    ]
  },
  "rdfs:label": {
