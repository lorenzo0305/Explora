  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Clarines und sein Koch Stéphane Bulle stellen Ihnen eine Küche mit außerordentlichen Würzen und Aromen vor: entdecken Sie die Würzen des Vercors!"
    ],
    "en": [
      "The restaurant Des Clarines and its chef Cyril Guerineau will introduce you to dishes with original flavours made from local ingredients."
    ],
    "it": [
      "Lo chef e il suo team propongono una cucina tradizionale che combina prodotti locali e sapori originali. Il tutto nell'atmosfera accogliente della sala da pranzo o sulla terrazza della piscina."
    ],
    "fr": [
      "Le chef et son équipe vous proposent une cuisine de tradition alliant produits du terroir et saveurs originales. Le tout à découvrir dans l’atmosphère feutrée de la salle à manger ou en terrasse, au bord de notre piscine."
    ],
    "es": [
      "El chef y su equipo ofrecen una cocina tradicional que combina productos locales y sabores originales. Todo ello en el acogedor ambiente del comedor o en la terraza junto a nuestra piscina."
    ],
    "nl": [
      "De chef en zijn team bieden een traditionele keuken met lokale producten en originele smaken. Dit alles in de gezellige sfeer van de eetzaal of op het terras bij ons zwembad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar - Restaurant Les Clarines"
    ]
  },
