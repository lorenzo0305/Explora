  "rdfs:comment": {
    "de": [
      "Beherrscht von seinem mittelalterlichen Dorf, von dem aus Wanderwege durch Landschaften mit Olivenbäumen, Trüffeleichen und Lavendel führen, bietet Allan ein außergewöhnliches Panorama über das Rhônetal."
    ],
    "en": [
      "Dominated by its medieval village, from which hiking trails lead through landscapes of olive groves, truffle oaks and lavender, Allan offers exceptional panoramic views of the Rhône valley."
    ],
    "it": [
      "Dominato dal suo borgo medievale, da cui partono sentieri escursionistici che attraversano paesaggi di ulivi, querce da tartufo e lavanda, Allan offre un panorama eccezionale sulla valle del Rodano."
    ],
    "fr": [
      "Dominé par son village médiéval d’où partent des sentiers de randonnées qui traversent des paysages d’oliviers, chênes truffiers et lavandes, Allan offre un panorama exceptionnel sur la vallée du Rhône."
    ],
    "es": [
      "Dominado por su pueblo medieval, desde el que parten rutas de senderismo a través de paisajes de olivos, robles trufados y lavanda, Allan ofrece un panorama excepcional del valle del Ródano."
    ],
    "nl": [
      "Allan wordt gedomineerd door zijn middeleeuwse dorp, van waaruit wandelpaden leiden door landschappen met olijfbomen, truffeleiken en lavendel, en biedt een uitzonderlijk panorama op de Rhônevallei."
    ]
  },
