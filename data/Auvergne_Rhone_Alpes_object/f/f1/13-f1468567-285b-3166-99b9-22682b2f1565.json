  "rdfs:comment": {
    "de": [
      "Lust auf ein Erlebnis der besonderen Art? Lust auf einen leeren Raum? Am Col de Balme öffnet der Balme-Steg seine Türen zu einem außergewöhnlichen Aussichtspunkt."
    ],
    "en": [
      "Change your perspective and look at the mountains from a different angle. On the Col de Balme, the brand-new… will be opening its doors on an exceptional viewpoint. The glass viewing platform is suspended for an unrivalled view over the Mont Blanc massif. An unforgettable sight !"
    ],
    "it": [
      "Cercate un'esperienza all'altezza? Volete allontanarvi da tutto? Al Col de Balme, la passerella di Balme apre le porte a un punto di vista eccezionale."
    ],
    "fr": [
      "Envie d’une expérience à la hauteur ? Envie de faire le vide ? Au col de Balme, la  passerelle de Balme ouvre ses portes  sur un point de vue exceptionnel."
    ],
    "es": [
      "¿Busca una experiencia a su altura? ¿Quiere alejarse de todo? En el Col de Balme, la pasarela de Balme abre sus puertas a un mirador excepcional."
    ],
    "nl": [
      "Op zoek naar een ervaring die bij je past? Wil je er even helemaal tussenuit? Op de Col de Balme opent de loopbrug van Balme zijn deuren naar een uitzonderlijk uitkijkpunt."
    ]
  },
  "rdfs:label": {
    "en": [
      "The viewing platform"
    ],
    "fr": [
      "Passerelle de Balme"
    ]
  },
