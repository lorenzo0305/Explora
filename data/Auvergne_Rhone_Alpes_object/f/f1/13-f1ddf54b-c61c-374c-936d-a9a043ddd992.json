  "rdfs:comment": {
    "de": [
      "In Saint-Julien-sur-Bibost ist der Hahn des Bauernhofs Reverdy entlaufen. Helfen Sie Beta und den anderen Gnolus, ihn wieder nach Hause zu bringen. Auf dem Spaziergang, der von herrlichen Panoramen begleitet wird, sind auch andere Tiere des Bauernhofs zu sehen."
    ],
    "en": [
      "In Saint-Julien-sur-Bibost, the rooster from the Reverdy farm has escaped. Come and help Beta and all the other gnolls bring him home. Other farm animals will be on hand for the walk, punctuated by magnificent panoramic views."
    ],
    "it": [
      "A Saint-Julien-sur-Bibost, il gallo della fattoria Reverdy è scappato. Venite ad aiutare Beta e tutti gli altri gnoll a riportarlo a casa. Anche altri animali della fattoria saranno presenti sul percorso, punteggiato da magnifiche viste panoramiche."
    ],
    "fr": [
      "A Saint-Julien-sur-Bibost, le coq de la ferme Reverdy s’est échappé. Venez aider Bêta et tous les autres gnolus à le ramener chez lui. D’autres animaux de la ferme seront de la balade également ponctuée par de magnifiques panoramas."
    ],
    "nl": [
      "In Saint-Julien-sur-Bibost is de haan van de boerderij Reverdy ontsnapt. Kom Beta en alle andere gnolletjes helpen om hem thuis te brengen. Andere dieren van de boerderij zullen ook aanwezig zijn op het parcours, onderbroken door prachtige panoramische uitzichten."
    ],
    "es": [
      "En Saint-Julien-sur-Bibost, el gallo de la granja Reverdy se ha escapado. Ven a ayudar a Beta y a los demás gnolls a traerlo a casa. Otros animales de la granja también estarán en el recorrido, salpicado de magníficas vistas panorámicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : Une ferme au paradis ...."
    ]
  },
