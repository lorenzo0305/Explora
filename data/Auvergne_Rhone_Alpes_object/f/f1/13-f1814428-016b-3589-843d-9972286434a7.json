  "rdfs:comment": {
    "de": [
      "In Begleitung eines Führers steuern Sie ein Schneemobil und begeben sich auf eine echte Wanderung zwischen Pisten und Wäldern im Grand Massif: Les Carroz, Flaine, Samoëns und Morillon."
    ],
    "en": [
      "Accompanied by a guide, you will drive a snowmobile and you will leave to make a true hike between tracks and forest on the Grand Massif: Carroz, Flaine and Samoens Morillon."
    ],
    "it": [
      "Accompagnati da una guida, potrete guidare una motoslitta e fare un vero e proprio giro tra piste e foreste nel Grand Massif: Les Carroz, Flaine, Samoëns e Morillon."
    ],
    "fr": [
      "Accompagné d'un guide, vous piloterez une motoneige et partirez faire une vraie randonnée entre piste et forêt sur le Grand Massif : les Carroz, Flaine, Samoëns et Morillon."
    ],
    "nl": [
      "Onder begeleiding van een gids bestuur je een sneeuwscooter en maak je een echte rit tussen piste en bos in het Grand Massif: Les Carroz, Flaine, Samoëns en Morillon."
    ],
    "es": [
      "Acompañado por un guía, conducirá una moto de nieve y dará un auténtico paseo entre pistas y bosques en el Grand Massif: Les Carroz, Flaine, Samoëns y Morillon."
    ]
  },
