          "additionalInformation": {
            "de": [
              "Planen Sie vor Ort zwischen 1:10 und 1:30 Stunden ein. Nach einem Briefing und einer Einweisung in das Fahren mit Ihrem Guide (5-10 Minuten) begeben Sie sich auf eine immersive Fahrt zwischen Pisten und Wäldern (50-55 Minuten)."
            ],
            "en": [
              "Allow between 1h10 and 1h30 on site. After a briefing and introduction to driving with your guide (5 to 10 minutes), set off on an immersive ride through tracks and forests (50 to 55 minutes)."
            ],
            "it": [
              "Prevedere tra 1h10 e 1h30 sul posto. Dopo un briefing e un'introduzione alla guida con la guida (da 5 a 10 minuti), si parte per un viaggio coinvolgente attraverso piste e foreste (da 50 a 55 minuti)."
            ],
            "fr": [
              "Prévoyez entre 1h10 et 1h30 sur place. Après un briefing et une initiation au pilotage avec votre guide (5 à 10 minutes), partez pour une randonnée immersive entre pistes et forêts (50 à 55 minutes)."
            ],
            "nl": [
              "Reken op 1u10 tot 1u30 ter plaatse. Na een briefing en kennismaking met het rijden met je gids (5 tot 10 minuten), vertrek je voor een meeslepende rit door paden en bossen (50 tot 55 minuten)."
            ],
            "es": [
              "Entre 1h10 y 1h30 en el lugar. Tras una sesión informativa y una introducción a la conducción con su guía (de 5 a 10 minutos), emprenda un viaje de inmersión a través de pistas y bosques (de 50 a 55 minutos)."
            ]
          },
