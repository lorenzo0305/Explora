  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration, Bar, Brasserie, Teesalon, regionale Spezialitäten und lokale Produkte\r\nBuffet nach Belieben. Cocktails, Whisky aus dem Vercors, Weinbar. Aperitifbretter am Donnerstag, Freitag und Samstag\r\nSpezialitäten aus den Savoyen. 7/7 Tage geöffnet"
    ],
    "en": [
      "Traditional cuisine, brewery, regional specialties. All-you-can-eat buffet. Ice cream. Terrace. Betting office."
    ],
    "it": [
      "Ristorante tradizionale, bar, brasserie, sala da tè, specialità regionali e prodotti locali\r\nBuffet a volontà. Cocktail, whisky del Vercors, enoteca. Tavole per l'aperitivo giovedì, venerdì e sabato\r\nSpecialità savoiarde. Aperto 7 giorni su 7"
    ],
    "fr": [
      "Restauration traditionnelle, bar, brasserie, salon de thé, spécialités régionales et produits locaux\r\nBuffet à volonté. Cocktails, whisky du Vercors, bar à vin. Planches apéro les jeudi, vendredi et samedi\r\nSpécialités savoyardes. Ouvert 7/7j"
    ],
    "nl": [
      "Traditioneel restaurant, brasserie, regionale specialiteiten. All you can eat buffet. IJs. Terras. Ook toegankelijk voor personen met een beperkte mobiliteit."
    ],
    "es": [
      "Restaurante tradicional, bar, brasserie, salón de té, especialidades regionales y productos locales\r\nBufé de todo lo que puedas comer. Cócteles, whisky de Vercors, bar de vinos. Tablas de aperitivos el jueves, viernes y sábado\r\nEspecialidades saboyanas. Abierto los 7 días de la semana"
    ]
  },
