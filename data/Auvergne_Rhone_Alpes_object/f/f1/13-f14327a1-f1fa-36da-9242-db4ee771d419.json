  "rdfs:comment": {
    "de": [
      "Ein scherzhafter Koch und ein riesiger Crêpe kommen Ihnen auf den Pisten entgegen. Verpassen Sie sie nicht: Sie rutschen, sie scherzen und vor allem... sie schlemmen!"
    ],
    "en": [
      "A joker cook and a giant pancake come to meet you on the slopes!\r\nDon't miss them: they slide, they joke around, and above all... they treat you to delicious food!"
    ],
    "it": [
      "Un cuoco burlone e una frittella gigante vi aspettano sulle piste. Non perdeteli: scivolano, scherzano e soprattutto... deliziano!"
    ],
    "fr": [
      "Un cuisinier farceur et une crêpe géante viennent à votre rencontre sur les pistes. Ne les manquez pas : ils glissent, ils plaisantent, et surtout... ils régalent !"
    ],
    "es": [
      "Un cocinero bromista y una tortita gigante vienen a tu encuentro en las pistas. No te los pierdas: se deslizan, bromean y, sobre todo... ¡hacen las delicias!"
    ],
    "nl": [
      "Een grappige kok en een gigantische crêpe wachten op u op de pistes!\r\nMis ze niet: ze glijden, ze maken grapjes en bovenal... ze bieden u crêpes aan!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Who wants a pancake?"
    ],
    "fr": [
      "Qui veut une crêpe ?"
    ],
    "nl": [
      "Wie wil er een pannenkoek?"
    ]
  },
