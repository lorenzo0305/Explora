  "rdfs:comment": {
    "de": [
      "Produzent von Pflanzen und Früchten, wir verarbeiten die Früchte zu Likören oder Kräutertees und Sirup direkt auf dem Hof: Kommen Sie und probieren Sie unsere 100 % natürlichen Produkte (Silbermedaille Verveine digestive auf der Landwirtschaftsmesse 2017)!!!"
    ],
    "en": [
      "Producer of plants and fruits, we transform the fruits into liqueurs or herbal teas and syrup directly on the farm: come and taste our 100% natural products (silver medal for digestive verbena at the agriculture show 2017)!"
    ],
    "it": [
      "Produttore di piante e frutti, trasformiamo i frutti in liquori o tisane e sciroppo direttamente in azienda: venite a degustare i nostri prodotti 100% naturali (medaglia d'argento per la verbena digestiva alla fiera dell'agricoltura 2017)!"
    ],
    "fr": [
      "Producteur de plantes et de fruits, nous transformons les fruits  en liqueurs ou en tisanes et sirop directement sur l'exploitation : venez dégustez nos produits 100 % naturels (médaille d'argent verveine digestive au salon de l'agriculture 2017) !!"
    ],
    "es": [
      "Productor de plantas y frutos, transformamos los frutos en licores o infusiones y jarabes directamente en la granja: ¡venga a probar nuestros productos 100% naturales (medalla de plata para la verbena digestiva en la feria de agricultura de 2017)!"
    ],
    "nl": [
      "Producent van planten en vruchten, wij verwerken de vruchten tot likeuren of kruidenthee en siroop direct op de boerderij: kom onze 100% natuurlijke producten proeven (zilveren medaille voor digestieve verbena op de landbouwbeurs van 2017)!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saveurs des Sucs - boutique et espace dégustation"
    ]
  },
