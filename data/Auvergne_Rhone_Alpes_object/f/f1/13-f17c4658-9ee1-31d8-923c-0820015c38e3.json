  "rdfs:comment": {
    "de": [
      "Der Lac de Lessy liegt am Fuße des Pic de Jallouvre und erstreckt sich über grüne Almwiesen. Der See wurde 2009 für die Fischerei geöffnet, nachdem Arbeiten durchgeführt wurden, um den großen Wasserverlust zu beheben. Es handelt sich um einen Angelplatz der ersten Kategorie."
    ],
    "en": [
      "Located at the base of  the Pic du Jallouvre, Lake of Lessy extend its territorial waters in the high and green mountain pastures. It has been opened for fishing in 2009, following some works to stop loss of water."
    ],
    "it": [
      "Situato ai piedi del Pic de Jallouvre, il Lac de Lessy spande le sue acque su verdeggianti pascoli di montagna. È stato aperto alla pesca nel 2009 in seguito ai lavori per colmare le grandi perdite d'acqua. È un sito di pesca di 1a categoria."
    ],
    "fr": [
      "Situé au pied du Pic de Jallouvre, le lac de Lessy étend ses eaux au sein d’alpages verdoyants. Il fut ouvert à la pêche en 2009 à la suite de travaux visant à colmater d’importante pertes d’eau. C'est une site de pêche de 1ère catégorie."
    ],
    "es": [
      "Situado a los pies del Pic de Jallouvre, el Lac de Lessy extiende sus aguas por verdes prados de montaña. Se abrió a la pesca en 2009, tras unas obras para taponar importantes pérdidas de agua. Es un lugar de pesca de 1ª categoría."
    ],
    "nl": [
      "Lac de Lessy ligt aan de voet van de Pic de Jallouvre en verspreidt zijn water over groene bergweiden. Het meer werd in 2009 opengesteld voor vissen na werkzaamheden om grote waterverliezen op te vangen. Het is een 1e categorie visplek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing Lake of Lessy"
    ],
    "fr": [
      "Site de pêche Lac de Lessy"
    ]
  },
