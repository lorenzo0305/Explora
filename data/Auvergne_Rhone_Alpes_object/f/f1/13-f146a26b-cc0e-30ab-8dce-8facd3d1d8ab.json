  "rdfs:comment": {
    "de": [
      "Genießen Sie im Herzen von Alpe d'Huez authentische Ramen, die jeden Tag hausgemacht werden, um Ihre Tage in den Bergen zu erwärmen.\r\nUnkai ist ein intimes und familiäres Restaurant, das von leidenschaftlichen Menschen geführt wird."
    ],
    "en": [
      "Enjoy authentic ramen in the heart of Alpe d'Huez, homemade every day to warm up your days in the mountains.\nUnkai is an intimate, family-run restaurant run by passionate restaurateurs."
    ],
    "it": [
      "Gustate un autentico ramen nel cuore dell'Alpe d'Huez, fatto in casa ogni giorno per riscaldare le vostre giornate in montagna.\r\nUnkai è un ristorante intimo e familiare gestito da ristoratori appassionati."
    ],
    "fr": [
      "Dégustez au cœur de l'Alpe d'Huez des ramens authentiques, préparés maison chaque jour pour réchauffer vos journées à la montagne. \r\nUnkai est un restaurant intimiste et familial tenu par des passionnés."
    ],
    "nl": [
      "Geniet van authentieke ramen in het hart van Alpe d'Huez, elke dag zelfgemaakt om je dagen in de bergen op te warmen.\nUnkai is een intiem familierestaurant gerund door gepassioneerde restaurateurs."
    ],
    "es": [
      "Disfrute del auténtico ramen en el corazón de Alpe d'Huez, hecho en casa todos los días para calentar sus jornadas en la montaña.\r\nUnkai es un restaurante íntimo y familiar dirigido por restauradores apasionados."
    ]
  },
