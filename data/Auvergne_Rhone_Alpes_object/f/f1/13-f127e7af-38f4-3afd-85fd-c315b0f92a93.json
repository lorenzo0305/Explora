  "rdfs:comment": {
    "de": [
      "Das Bar-Restaurant \"La brasserie de la mairie\" empfängt Sie in warmer und freundlicher Atmosphäre. Probieren Sie die traditionelle Küche und die lokalen Burger, die Sie vor Ort verzehren oder mitnehmen können; und die guten hausgemachten Desserts sowie die Pierrade."
    ],
    "en": [
      "The bar-restaurant \"La brasserie de la marie\" welcomes you in a warm and friendly atmosphere."
    ],
    "it": [
      "\"La brasserie de la mairie\" vi accoglie in un'atmosfera calda e accogliente.\r\nCucina tradizionale, hamburger locali... da mangiare o da portare via.\r\nI giorni e gli orari di apertura variano durante l'anno: si prega di telefonare per prenotare."
    ],
    "fr": [
      "\"La brasserie de la mairie\" vous accueille dans une ambiance chaleureuse et conviviale.\r\nCuisine traditionnelle, burgers locaux... sur place ou à emporter.\r\nJours d'ouverture et horaires variables sur l'année : Il est préférable d'appeler pour réserver."
    ],
    "nl": [
      "\"La brasserie de la mairie\" verwelkomt je in een warme en vriendelijke sfeer.\r\nTraditionele keuken, lokale hamburgers... eten of meenemen.\r\nOpeningsdagen en -tijden variëren gedurende het jaar: bel om te reserveren."
    ],
    "es": [
      "\"La brasserie de la mairie\" le da la bienvenida en un ambiente cálido y acogedor.\r\nCocina tradicional, hamburguesas locales... para comer o llevar.\r\nLos días y horarios de apertura varían a lo largo del año: llame para reservar."
    ]
  },
