  "rdfs:comment": {
    "de": [
      "Erkunden Sie die unberührte Schönheit des Tals des Flusses Ay auf diesem Rundweg ab der ViaRhôna. Bewundern Sie die Weinterrassen und die atemberaubende Aussicht auf die Rhône und ihre Windungen. Entdecken Sie die App MHIKES"
    ],
    "en": [
      "Explore the unspoiled beauty of the Ay river valley with this loop starting from the ViaRhôna. Admire the terraced vineyards and its breathtaking views of the Rhône and its meanders. To discover on the application MHIKES."
    ],
    "it": [
      "Esplorate la bellezza incontaminata della valle della Rivière d'Ay con questo itinerario che parte dalla ViaRhôna. Ammirate i vigneti terrazzati e le viste mozzafiato sui meandri del Rodano. Scopritelo sull'applicazione MHIKES"
    ],
    "fr": [
      "Explorez la beauté préservée de la vallée de la rivière d’Ay avec cette boucle au départ de la ViaRhôna. Admirez les vignobles en terrasse et ses vue imprenables sur le Rhône et ses méandres. A découvrir sur l'application MHIKES"
    ],
    "nl": [
      "Ontdek de ongerepte schoonheid van de Rivière d'Ay-vallei met deze lus die begint bij de ViaRhôna. Bewonder de terrasvormige wijngaarden en het adembenemende uitzicht op de meanderende Rhône. Ontdek het op de MHIKES applicatie"
    ],
    "es": [
      "Explore la belleza intacta del valle de Rivière d'Ay con este circuito que parte de la ViaRhôna. Admire los viñedos en terrazas y las impresionantes vistas de los meandros del Ródano. Descúbralo en la aplicación MHIKES"
    ]
  },
  "rdfs:label": {
    "fr": [
      "De la ViaRhôna au Val d’ay"
    ]
  },
