  "rdfs:comment": {
    "de": [
      "Marie George Haudiquez führt Sie durch Dunières: seine Geschichte, seine Anekdoten und die lokale Natur. Ein authentischer Besuch, der von einer Botschafterin der Region geleitet wird. Reservierung: Office de Tourisme 04 71 59 95 73."
    ],
    "en": [
      "Marie George Haudiquez introduces you to Dunières: its history, anecdotes and local nature. An authentic tour led by a local ambassador. Booking: Tourist Office 04 71 59 95 73."
    ],
    "it": [
      "Marie George Haudiquez vi presenta Dunières: la sua storia, gli aneddoti e la natura locale. Un tour autentico guidato da un ambasciatore locale. Prenotazione: Ufficio del Turismo 04 71 59 95 73."
    ],
    "fr": [
      "Marie George Haudiquez vous fait découvrir Dunières : son histoire, ses anecdotes et la nature locale. Une visite authentique menée par une ambassadrice du territoire. Réservation : Office de Tourisme 04 71 59 95 73."
    ],
    "es": [
      "Marie George Haudiquez le presenta Dunières: su historia, anécdotas y naturaleza local. Una auténtica visita guiada por una embajadora local. Reservas: Oficina de Turismo 04 71 59 95 73."
    ],
    "nl": [
      "Marie George Haudiquez laat je kennismaken met Dunières: de geschiedenis, anekdotes en de plaatselijke natuur. Een authentieke rondleiding onder leiding van een plaatselijke ambassadeur. Reservering: Toeristenbureau 04 71 59 95 73."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ambassadeurs de territoire: histoire locale Dunières"
    ]
  },
