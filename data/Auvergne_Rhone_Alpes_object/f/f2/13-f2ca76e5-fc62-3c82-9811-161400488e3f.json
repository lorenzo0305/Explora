  "rdfs:comment": {
    "de": [
      "Entdecken Sie die brandneue Kasinobar-/-brauerei in einer stilvollen und zeitgenössischen Kulisse! Für Schleckmäuler bieten wir einen Fast-Food-Service an, der rund um die Ladenöffnungszeiten des Kasinos läuft."
    ],
    "en": [
      "Discover the brand new casino bar/brasserie area, in a stylish and contemporary decor! For foodies, we offer a non-stop fast food service at casino opening hours."
    ],
    "it": [
      "Scoprite la nuovissima area bar/birreria del casinò, con un arredamento elegante e contemporaneo! Per i più golosi, offriamo un servizio di fast food non-stop durante gli orari di apertura del casinò."
    ],
    "fr": [
      "Découvrez le tout nouvel espace bar/brasserie de casino, dans un décor stylé et contemporain ! Pour les gourmands, nous proposons un service de restauration rapide non stop, aux heures d'ouverture du casino."
    ],
    "nl": [
      "Ontdek de gloednieuwe casino bar/ brouwerij ruimte, in een stijlvol en eigentijds decor! Voor de zoetekauwen is er een non-stop fastfooddienst tijdens de openingsuren van het casino."
    ],
    "es": [
      "Descubra la nueva zona de bar/cervecería del casino, con una decoración elegante y contemporánea Para los más golosos, ofrecemos un servicio de comida rápida ininterrumpido durante el horario de apertura del casino."
    ]
  },
