  "rdfs:comment": {
    "de": [
      "Nach einem Skitag im Skigebiet Paradiski können Sie die Happy Hour genießen und in der Auberge des Balcons savoyardische und traditionelle Spezialitäten probieren. Und das alles mit Blick auf den Skiort!"
    ],
    "en": [
      "After a day of skiing in the Paradiski area, come and enjoy Happy Hour and try the traditional Savoyard specialities on the menu at the Auberge des Balcons. There is even a great view of the resort!"
    ],
    "it": [
      "Dopo una giornata di sci nell'area Paradiski, godetevi l'Happy Hour e assaporate le specialità tradizionali savoiarde all'Auberge des Balcons. Il tutto con vista sul resort!"
    ],
    "fr": [
      "Après une journée de ski sur le domaine de Paradiski, profitez de l’Happy Hour et dégustez des spécialités savoyardes et traditionnelles à l’Auberge des Balcons. Le tout avec vue sur la station !"
    ],
    "nl": [
      "Geniet na een dag skiën in het Paradiski-gebied van Happy Hour en Savoyaardse en traditionele specialiteiten in de Auberge des Balcons. En dat alles met uitzicht op het skigebied!"
    ],
    "es": [
      "Después de un día de esquí en la zona de Paradiski, disfrute de la Happy Hour y saboree las especialidades tradicionales de Saboya en el Auberge des Balcons. Todo ello con vistas a la estación"
    ]
  },
