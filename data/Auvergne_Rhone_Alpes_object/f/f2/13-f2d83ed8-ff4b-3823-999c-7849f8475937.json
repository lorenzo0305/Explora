  "rdfs:comment": {
    "de": [
      "Die Brasserie Le Bayern empfängt Sie mittags von Montag bis Samstag mit einer traditionellen und qualitativ hochwertigen Küche. Tagesmenüs oder Gerichte à la carte. Die Brasserie ist von Montag bis Freitag ganztägig und samstags bis 14:30 Uhr geöffnet."
    ],
    "en": [
      "Le Bayern brasserie welcomes you for lunch from Monday to Saturday for traditional, quality cuisine. Daily menus or à la carte dishes. The brasserie is open all day Monday to Friday, and until 2.30pm on Saturdays."
    ],
    "it": [
      "La brasserie Le Bayern vi accoglie a pranzo dal lunedì al sabato e propone una cucina tradizionale di alta qualità. Menù del giorno o piatti à la carte. La brasserie è aperta tutto il giorno dal lunedì al venerdì e fino alle 14.30 il sabato."
    ],
    "fr": [
      "La brasserie Le Bayern vous accueille les midis du lundi au samedi pour une cuisine traditionnelle et de qualité. Menus du jour ou plats à la carte. La brasserie est ouverte toute la journée du lundi au vendredi et le samedi jusqu'à 14h30."
    ],
    "es": [
      "La brasserie Le Bayern le da la bienvenida para almorzar de lunes a sábado, sirviendo cocina tradicional de alta calidad. Menús del día o platos a la carta. La brasserie está abierta todo el día de lunes a viernes y hasta las 14:30 los sábados."
    ],
    "nl": [
      "Brasserie Le Bayern verwelkomt je van maandag tot zaterdag voor de lunch en serveert traditionele gerechten van hoge kwaliteit. Dagmenu's of à la carte gerechten. De brasserie is van maandag tot vrijdag de hele dag geopend en op zaterdag tot 14.30 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Le Bayern"
    ]
  },
