  "rdfs:comment": {
    "de": [
      "Auf diesem Pumptrack-Parcours können die Fahrer auf Buckeln und Steilkurven trainieren. Er ist für alle zugänglich, unabhängig von Alter oder Können. Das Tragen eines Helms, von Handschuhen und anderen Schutzvorrichtungen wird dringend empfohlen."
    ],
    "en": [
      "This pumptrack course lets riders practice on moguls and banked turns. Accessible to everyone, any age or level. Helmets, gloves and other protection is highly recommended."
    ],
    "it": [
      "Questo percorso su pumptrack offre ai piloti la possibilità di esercitarsi su dossi e curve a gomito. È accessibile a tutti, indipendentemente dall'età e dal livello. Caschi, guanti e altri dispositivi di protezione sono fortemente raccomandati."
    ],
    "fr": [
      "Ce parcours sur pumptrack permet aux riders de s'entraîner sur des bosses et des virages relevés. Accessible à tous, quel que soit l'âge ou le niveau. Le port du casque, des gants et autres protections est fortement recommandé."
    ],
    "es": [
      "Este circuito de pumptrack ofrece a los pilotos la oportunidad de practicar sobre baches y curvas peraltadas. Accesible a todos, sea cual sea su edad o nivel. Se recomienda encarecidamente el uso de cascos, guantes y otros equipos de protección."
    ],
    "nl": [
      "Dit pumptrackparcours geeft rijders de kans om te oefenen op hobbels en schuine bochten. Toegankelijk voor iedereen, ongeacht leeftijd of niveau. Helmen, handschoenen en andere beschermende kleding worden sterk aanbevolen."
    ]
  },
  "rdfs:label": {
