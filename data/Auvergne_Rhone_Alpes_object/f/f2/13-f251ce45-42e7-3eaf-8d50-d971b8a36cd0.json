  "rdfs:comment": {
    "de": [
      "Die Nacht könnte von keiner schöneren Atmosphäre träumen. Der gesellige und festliche Ort wird zum unangefochtenen Tempel der schönsten Partys in der Region."
    ],
    "en": [
      "\"The ultimate nightlife atmosphere.\r\nPartying and togetherness are your watchwords at the region’s unrivalled nightlife temple.\""
    ],
    "it": [
      "La notte non avrebbe potuto sognare un'atmosfera più bella\r\nIl luogo conviviale e festoso sarà il tempio indiscusso delle più belle serate della regione."
    ],
    "fr": [
      "La nuit ne pouvait rêver de plus belle ambiance. \r\nLe lieu convivial et festif sera le temple incontesté des plus belles soirées de la région."
    ],
    "es": [
      "La noche no podía soñar con un ambiente más hermoso\r\nEste lugar festivo y de convivencia será el templo indiscutible de las más bellas veladas de la región."
    ],
    "nl": [
      "De nacht had zich geen mooiere sfeer kunnen dromen\r\nDe gezellige en feestelijke plaats zal de onbetwiste tempel zijn van de mooiste avonden in de regio."
    ]
  },
