  "rdfs:comment": {
    "de": [
      "Bistronomisches Restaurant und gesellige Bar\r\nGemeinsamkeit, Austausch und Geselligkeit!\r\nDas sind die Schlüsselwörter dieses schönen Lokals\r\nHerzlicher Empfang und Service\r\nQualitativ hochwertige und vielfältige Produkte (Getränke und Lebensmittel)"
    ],
    "en": [
      "Bistronomic restaurant and festive bar\r\nSharing, exchange and conviviality!\r\nThese are the key words of this beautiful establishment\r\nWarm welcome and service\r\nHigh quality and varied products (drinks and food)"
    ],
    "it": [
      "Ristorante bistronomico e bar accogliente\r\nCondivisione, scambio e convivialità!\r\nQueste sono le parole d'ordine di questo bel locale\r\nAccoglienza calorosa e servizio cordiale\r\nProdotti di alta qualità e varietà (bevande e cibo)"
    ],
    "fr": [
      "Restaurant bistronomique et bar convivial\r\nPartage, échange et convivialité ! \r\nVoilà les maîtres mots de ce bel établissement\r\nL'accueil et service chaleureux\r\nDes produits d'appellations de hautes qualités et variés (boissons et alimentations)"
    ],
    "es": [
      "Restaurante bistronómico y bar acogedor\r\nCompartir, intercambiar y convivir\r\nEstas son las consignas de este magnífico establecimiento\r\nAcogida calurosa y servicio cordial\r\nProductos variados y de calidad (bebidas y alimentos)"
    ],
    "nl": [
      "Bistronomisch restaurant en gezellige bar\r\nDelen, uitwisselen en gezelligheid!\r\nDat zijn de sleutelwoorden van dit mooie etablissement\r\nEen warm onthaal en vriendelijke service\r\nGevarieerde producten van hoge kwaliteit (dranken en gerechten)"
    ]
  },
  "rdfs:label": {
    "en": [
      "The House of Jacobins"
    ],
    "fr": [
      "La Maison Jacobins"
    ]
  },
