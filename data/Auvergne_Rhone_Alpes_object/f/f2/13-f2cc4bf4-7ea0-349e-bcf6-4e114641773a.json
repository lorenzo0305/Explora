  "rdfs:comment": {
    "de": [
      "Genießen Sie im Terminus den besten Couscous von Oyonnax, vor Ort oder zum Mitnehmen, der seit 1977 in der Familientradition gekocht wird. Die Speisekarte wird durch traditionelle französische Gerichte bereichert (grillades....)"
    ],
    "en": [
      "Café and grilled gambas. In a friendly environment. Takeaway couscous."
    ],
    "it": [
      "Gustate il miglior couscous di Oyonnax al Terminus, sul posto o da asporto, cucinato secondo la tradizione familiare dal 1977. Il menu è arricchito da piatti della tradizione francese (grigliate....)"
    ],
    "fr": [
      "Dégustez le meilleur couscous d’Oyonnax au Terminus, sur place ou à emporter, cuisiné dans la tradition familiale depuis 1977. La carte est enrichie de plats  français traditionnels (grillades....)"
    ],
    "nl": [
      "Geniet van de beste couscous in Oyonnax in de Terminus, ter plaatse of om mee te nemen, gekookt volgens de familietraditie sinds 1977. Het menu is verrijkt met traditionele Franse gerechten (grills....)"
    ],
    "es": [
      "Disfrute del mejor cuscús de Oyonnax en el Terminus, en el momento o para llevar, cocinado según la tradición familiar desde 1977. El menú se enriquece con platos tradicionales franceses (parrilla....)"
    ]
  },
