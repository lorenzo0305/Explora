  "rdfs:comment": {
    "de": [
      "Der Küchenchef bietet Ihnen das ganze Jahr über regionale Küche, bodenständige Spezialitäten und eine Weinkarte, auf der Sie die zehn Crus des Beaujolais finden."
    ],
    "en": [
      "All year round, the chef offers regional cuisine, local specialities and a wine list featuring the ten Beaujolais crus."
    ],
    "it": [
      "Durante tutto l'anno, lo chef propone una cucina regionale, specialità locali e una carta dei vini con i dieci crus del Beaujolais."
    ],
    "fr": [
      "Le chef vous propose tout au long de l’année une cuisine régionale, des spécialités de terroir et une carte des vins où vous retrouverez les dix crus du Beaujolais."
    ],
    "nl": [
      "Het hele jaar door biedt de chef een regionale keuken, lokale specialiteiten en een wijnkaart met de tien crus Beaujolais."
    ],
    "es": [
      "Durante todo el año, el chef ofrece cocina regional, especialidades locales y una carta de vinos con los diez crus de Beaujolais."
    ]
  },
