  "rdfs:comment": {
    "de": [
      "Cortigrimpe ist eine 800m² große Kletterhalle und ein Bistro. Sie ist ein Ort der Begegnung und des Austauschs für alle, unabhängig von ihrem Niveau und ihren Ambitionen!"
    ],
    "en": [
      "Cortigrimpe is a 800m² climbing room and a bistro. It was conceived as a place of meetings and exchanges for all, whatever its level and ambitions!"
    ],
    "it": [
      "Il Cortigrimpe è una palestra di arrampicata e un bistrot di 800 m². È stata concepita come un luogo di incontro per tutti, indipendentemente dal livello e dalle ambizioni!"
    ],
    "fr": [
      "Cortigrimpe est une salle d’escalade de 800m² et un bistro. Elle a été pensée comme un lieu de rencontres et d’échanges pour tous, quelque soit son niveau et ses ambitions !"
    ],
    "nl": [
      "Cortigrimpe is een klimzaal en bistro van 800 m². Het is ontworpen als ontmoetingsplaats voor iedereen, ongeacht niveau of ambities!"
    ],
    "es": [
      "Cortigrimpe es un rocódromo y bistró de 800 m². Se ha concebido como un lugar de encuentro para todos, sea cual sea su nivel o sus ambiciones"
    ]
  },
