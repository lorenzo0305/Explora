  "rdfs:comment": {
    "de": [
      "Familienbrauerei mit von Autorallyes inspirierter Dekoration, traditionellem Essen und Snacks. Frische Produkte, hausgemachte Gerichte und von einem Konditor zubereitete Desserts. Restauration nur mittags. Teestube und Bar von 7 bis 21 Uhr geöffnet."
    ],
    "en": [
      "Family-run brasserie with rally-inspired decor, traditional restaurant and snack bar. Fresh produce, home-made dishes and desserts prepared by a pastry chef. Lunchtime only. Tearoom and bar open from 7am to 9pm."
    ],
    "it": [
      "Brasserie a conduzione familiare con arredamento ispirato ai rally, ristorante tradizionale e snack bar. Prodotti freschi, piatti fatti in casa e dessert preparati da un pasticcere. Solo a pranzo. Sala da tè e bar aperti dalle 7.00 alle 21.00."
    ],
    "fr": [
      "Brasserie familiale avec décoration inspirée des rallyes automobiles, restauration traditionnelle et snack. Produits frais, plats maisons et desserts élaborés par un pâtissier. Restauration uniquement le midi. Salon de thé et bar ouvert de 7h à 21h."
    ],
    "nl": [
      "Familiale brasserie met op rally's geïnspireerd decor, traditioneel restaurant en snackbar. Verse producten, huisgemaakte gerechten en desserts bereid door een patissier. Alleen tijdens de lunch. Tearoom en bar geopend van 7.00 tot 21.00 uur."
    ],
    "es": [
      "Brasserie familiar con decoración inspirada en los rallies, restaurante tradicional y snack bar. Productos frescos, platos caseros y postres elaborados por un pastelero. Sólo a mediodía. Salón de té y bar abiertos de 7.00 a 21.00 h."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie L'Entrepotes"
    ]
  },
