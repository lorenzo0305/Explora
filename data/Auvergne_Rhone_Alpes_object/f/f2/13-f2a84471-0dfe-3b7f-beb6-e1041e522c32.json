  "rdfs:comment": {
    "de": [
      "Seit drei Jahren arbeitet der Verein Cré'ateliers du Haut Lignon daran, die kreativen Handwerker der Region Auvergne Rhône Alpes zu vereinen und ein gemeinsames Projekt zu verfolgen: die Entwicklung, Aufwertung und Förderung der Aktivitäten der verschiedenen Berufsgruppen"
    ],
    "en": [
      "For 3 years, the Association Cré'ateliers du Haut Lignon has been working with the aim of federating the Artisans-Creators of the Auvergne Rhône Alpes Region, around a common project: to develop, enhance and promote the activities of the different"
    ],
    "it": [
      "Da 3 anni, l'Associazione Cré'ateliers du Haut Lignon lavora con l'obiettivo di federare gli artigiani-creatori della Regione Auvergne Rhône Alpes, intorno a un progetto comune: sviluppare, valorizzare e promuovere le attività delle diverse aziende"
    ],
    "fr": [
      "Depuis 3 ans, l'Association Cré'ateliers du Haut Lignon oeuvre dans le but de fédérer les Artisans- Créateurs de la Région Auvergne Rhône Alpes, autour d'un projet commun : développer, valoriser et promouvoir les activités des différents"
    ],
    "nl": [
      "Sinds 3 jaar werkt de Association Cré'ateliers du Haut Lignon met als doel de ambachtelijke scheppers van de regio Auvergne Rhône Alpes te verenigen rond een gemeenschappelijk project: het ontwikkelen, versterken en promoten van de activiteiten van de verschillende"
    ],
    "es": [
      "Desde hace 3 años, la Asociación Cré'ateliers du Haut Lignon trabaja con el objetivo de federar a los Artesanos-Creadores de la Región de Auvernia Rhône Alpes, en torno a un proyecto común: desarrollar, valorizar y promover las actividades de los diferentes"
    ]
  },
