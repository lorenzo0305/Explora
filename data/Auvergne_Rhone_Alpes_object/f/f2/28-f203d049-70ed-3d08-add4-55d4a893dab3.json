  "rdfs:comment": {
    "de": [
      "Shop des Heiligtums Sainte Rita\nDer Laden Sainte Rita bietet Ihnen eine große Auswahl an religiösen Artikeln.\nFür Informationen über den Schrein lesen Sie bitte die Karteikarte \"Sanctuaire Sainte Rita de Vendeville\""
    ],
    "en": [
      "Saint Rita Shrine Shop\nThe Sainte Rita Shrine Shop offers a wide selection of religious articles.\nFor information about the sanctuary, please see the \"Sanctuaire Sainte Rita de Vendeville\" page"
    ],
    "it": [
      "Negozio del Santuario di Santa Rita\nIl negozio del Santuario di Santa Rita offre un'ampia gamma di articoli religiosi.\nPer informazioni sul santuario, consultare la pagina \"Sanctuaire Sainte Rita de Vendeville\""
    ],
    "fr": [
      "Magasin du sanctuaire Sainte Rita \nLa Boutique Sainte Rita vous propose un grand choix d’articles religieux. \nPour des renseignements sur le sanctuaire, veuillez consulter la fiche  \"Sanctuaire Sainte Rita de Vendeville\""
    ],
    "es": [
      "Tienda del Santuario Santa Rita\nLa tienda del Santuario Santa Rita ofrece una amplia gama de artículos religiosos.\nPara más información sobre el santuario, consulte la página \"Santuario Santa Rita de Vendeville\""
    ],
    "nl": [
      "Sint Rita heiligdom winkel\nDe Saint Rita Shrine Shop biedt een breed scala aan religieuze artikelen.\nVoor informatie over het heiligdom kun je terecht op de pagina \"Sanctuaire Sainte Rita de Vendeville\""
    ]
  },
