  "rdfs:comment": {
    "de": [
      "Der Fluss Guiers weist bis zu seinem Zusammenfluss mit der Rhône einen Wechsel von Stromschnellen und ruhigen Gewässern auf. Der Fluss ist für das Fliegenfischen bekannt und war ein Lieblingsplatz von Winston Churchill, der selbst Fliegenfischer war."
    ],
    "en": [
      "The Guiers river is a mix of quiet water and rapids, at the confluence of the Rhône. Well known for the fly fishing, this river was the favorite fishing place of Winston Churchill."
    ],
    "it": [
      "Il fiume Guiers alterna rapide e acque calme fino alla confluenza con il Rodano. Ben noto per la pesca a mosca, questo fiume era uno dei luoghi preferiti da Winston Churchill, anch'egli pescatore a mosca."
    ],
    "fr": [
      "La rivière Guiers présente une alternance de rapides et d'eaux calmes jusqu'à sa confluence avec le Rhône. Bien connue pour la pêche à la mouche, cette rivière était un lieu favori de Winston Churchill, pêcheur à la mouche lui-même."
    ],
    "es": [
      "El río Guiers alterna rápidos y aguas tranquilas hasta su confluencia con el Ródano. Conocido por la pesca con mosca, este río fue uno de los lugares favoritos de Winston Churchill, también pescador con mosca."
    ],
    "nl": [
      "De rivier Guiers wisselt tussen stroomversnellingen en rustig water tot aan de samenvloeiing met de Rhône. Deze rivier staat bekend om het vliegvissen en was een favoriete plek van Winston Churchill, zelf een vliegvisser."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing on the Guiers river"
    ],
    "fr": [
      "Pêche dans la rivière Guiers et Etang de Reculfort"
    ],
    "nl": [
      "Mooie visplekjes in de rivier Guiers: verkoop van visvergunningen"
    ]
  },
