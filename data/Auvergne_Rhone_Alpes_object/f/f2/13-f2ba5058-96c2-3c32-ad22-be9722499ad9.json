  "rdfs:comment": {
    "de": [
      "Vanessa Paradis kehrt mit einem neuen Album auf die Bühne zurück, das ihr großes musikalisches Comeback markiert und von den für sie so wichtigen Einflüssen aus Pop & Soul getragen wird. Am 14. November 2026 wird sie in der LDLC Arena in Lyon-Décines auftreten."
    ],
    "en": [
      "Vanessa Paradis returns to the stage with a new album that marks her big musical comeback, driven by the pop & soul influences that are dear to her heart, and will be performing at the LDLC Arena in Lyon-Décines on November 14, 2026."
    ],
    "it": [
      "Vanessa Paradis torna in scena con un nuovo album che segna il suo grande ritorno musicale, con le sue influenze pop e soul, e si esibirà all'Arena LDLC di Lione-Décines il 14 novembre 2026."
    ],
    "fr": [
      "Vanessa Paradis revient sur scène avec un nouvel album qui marque son grand retour musical, porté par des influences pop & soul qui lui sont chères, et se produira à la LDLC Arena de Lyon-Décines  le 14 novembre 2026."
    ],
    "es": [
      "Vanessa Paradis vuelve a los escenarios con un nuevo álbum que marca su gran regreso musical, con las influencias pop y soul que la caracterizan, y actuará en el LDLC Arena de Lyon-Décines el 14 de noviembre de 2026."
    ],
    "nl": [
      "Vanessa Paradis is terug op het podium met een nieuw album dat haar grote muzikale comeback markeert, met haar kenmerkende pop- en soulinvloeden, en zal op 14 november 2026 optreden in de LDLC Arena in Lyon-Décines."
    ]
  },
