      "@id": "https://data.datatourisme.fr/adff0ec4-efa3-3347-a09c-52b26d235f31",
      "dc:description": {
        "de": [
          "Barjots Family ist eine Metzgerei mit Fleisch- und Wurstwaren und eine Rotisserie in Sainte Cécile. Geöffnet von Mittwoch bis Sonntag von 9:00 bis 13:30 Uhr und von 17:00 bis 19:30 Uhr"
        ],
        "en": [
          "Barjots Family is a butcher's, delicatessen and rotisserie located in Sainte Cécile. Open Wednesday to Sunday, 9am to 1:30pm and 5pm to 7:30pm"
        ],
        "it": [
          "La famiglia Barjots è una macelleria, salumeria e rosticceria situata a Sainte Cécile. Aperto da mercoledì a domenica, dalle 9 alle 13.30 e dalle 17 alle 19.30"
        ],
        "fr": [
          "Barjots Family est une boucherie charcuterie et une rôtisserie située à Sainte Cécile. Ouvert du mercredi au dimanche de 9h à 13h30 et de 17h à 19h30"
        ],
        "nl": [
          "Barjots Family is een slagerij, delicatessenzaak en rotisserie in Sainte Cécile. Geopend van woensdag tot zondag van 9.00 tot 13.30 en van 17.00 tot 19.30"
        ],
        "es": [
          "Barjots Family es una carnicería, charcutería y asador situado en Sainte Cécile. Abierto de miércoles a domingo, de 9:00 a 13:30 y de 17:00 a 19:30"
        ]
      },
