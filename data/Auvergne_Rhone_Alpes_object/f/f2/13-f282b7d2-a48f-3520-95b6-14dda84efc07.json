  "rdfs:comment": {
    "de": [
      "Das Restaurant le Marius ist während der Sommersaison für Ihre Mahlzeiten oder eine Schlemmerpause am Nachmittag geöffnet. Auf der Speisekarte steht eine einfache, lokale Küche mit Produkten aus der Auvergne."
    ],
    "en": [
      "The restaurant of the Marius Hotel is open for the summer season for your meals or a gourmet break in the afternoon."
    ],
    "it": [
      "Il ristorante le Marius è aperto durante la stagione estiva per i vostri pasti o per una pausa gourmet nel pomeriggio. Nel menu, una cucina semplice e locale con prodotti dell'Alvernia."
    ],
    "fr": [
      "Le Restaurant le Marius est ouvert pendant la saison estivale pour vos repas ou une pause gourmande l'après-midi. A la carte, une cuisine simple et locale avec des produits auvergnats."
    ],
    "nl": [
      "Het Restaurant le Marius is tijdens het zomerseizoen geopend voor uw maaltijden of een gastronomische pauze in de middag. Op het menu staat een eenvoudige en lokale keuken met producten uit de Auvergne."
    ],
    "es": [
      "El Restaurante le Marius está abierto durante la temporada de verano para sus comidas o una pausa gastronómica por la tarde. En el menú, una cocina sencilla y local con productos de Auvernia."
    ]
  },
