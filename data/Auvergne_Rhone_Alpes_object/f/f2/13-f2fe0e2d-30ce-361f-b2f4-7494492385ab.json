  "rdfs:comment": {
    "de": [
      "Au Cardi, c'est deux salles deux ambiances: Sie werden unten den Restaurantteil entdecken, für alle Ihre Familien-, Freundes- oder Zwischenmahlzeiten, und schließlich den Pubteil sowie die Dachterrasse, die sich oben befindet, um mittags und abends von lustigen Momenten zu profitieren"
    ],
    "en": [
      "Au Cardi has two rooms, two atmospheres: downstairs you'll find the restaurant area, for all your meals with family, friends or business associates, and upstairs, the pub area and roof terrace, where you can enjoy fun times at lunchtime and in the evenings"
    ],
    "it": [
      "Le Cardi ha due ambienti, due atmosfere: al piano inferiore si trova il ristorante per tutti i pasti con la famiglia, gli amici o i colleghi di lavoro, mentre al piano superiore si trovano il pub e la terrazza sul tetto per il divertimento di mezzogiorno e sera"
    ],
    "fr": [
      "Au Cardi, c’est deux salles deux ambiances : vous découvrirez en bas la partie restaurant, pour tous vos repas en famille, entre amis ou d'entrep, et enfin la partie pub ainsi que le toit terrasse, situé en haut, pour profiter de moments funs midi et soir"
    ],
    "nl": [
      "Le Cardi heeft twee ruimtes, twee sferen: beneden vind je het restaurant voor al je maaltijden met familie, vrienden of zakenrelaties, en boven vind je de pub en het dakterras voor al je middag- en avondplezier"
    ],
    "es": [
      "Le Cardi cuenta con dos salas, dos ambientes: en la planta baja se encuentra la zona de restaurante, para todas sus comidas en familia, con amigos o con socios de negocios, y en la planta superior la zona de pub y la terraza de la azotea, donde podrá divertirse a la hora de comer y por la noche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cardi"
    ]
  },
