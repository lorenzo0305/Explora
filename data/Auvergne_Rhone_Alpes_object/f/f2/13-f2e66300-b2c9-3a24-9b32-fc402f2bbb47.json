  "rdfs:comment": {
    "de": [
      "Das 1600 m² große Wassersportzentrum Eyrium empfängt Sie im Herzen des Eyrieux-Tals in der Nähe von Le Cheylard. Schwimmbad, Rutschen, Kinderspielplatz, Planschbecken, Picknick-Ecke, Bar und Boulespiel... Hier ist für jeden Geschmack etwas dabei!"
    ],
    "en": [
      "The 1600 m² Eyrium aquatic center welcomes you to the heart of the Eyrieux Valley, near Le Cheylard. Swimming pool, slides, children's games, paddling pool, picnic area, bar and boules... Something for everyone!"
    ],
    "it": [
      "Il centro acquatico Eyrium, di 1600 m², vi accoglie nel cuore della Valle dell'Eyrieux, vicino a Le Cheylard. Piscina, scivoli, giochi per bambini, piscina per bambini, area picnic, bar e bocce... Qualcosa per tutti!"
    ],
    "fr": [
      "La base aquatique Eyrium de 1600 m² vous accueille au cœur de la Vallée de l'Eyrieux, proche du Cheylard. Piscine, toboggans, jeux pour enfants, pataugeoire, coin pique-nique, bar et jeux de boules... Il y en a pour tous les goûts !"
    ],
    "nl": [
      "Het Eyrium aquacentrum van 1600 m² verwelkomt je in het hart van de Eyrieux vallei, vlakbij Le Cheylard. Zwembad, glijbanen, kinderspelen, pierenbad, picknickplaats, bar en petanque... Voor ieder wat wils!"
    ],
    "es": [
      "El centro acuático Eyrium, de 1600 m², le da la bienvenida en el corazón del valle de Eyrieux, cerca de Le Cheylard. Piscina, toboganes, juegos infantiles, piscina para niños, zona de picnic, bar y petanca... Para todos los gustos"
    ]
  },
  "rdfs:label": {
    "en": [
      "Aquatic park Eyrium"
    ],
    "fr": [
      "Base de loisirs aquatique Eyrium"
    ]
  },
