  "rdfs:comment": {
    "de": [
      "Jars ist eine 1857 gegründete Keramikmanufaktur in Anneyron im Departement Drôme.\r\nDer Werkstattladen bietet das ganze Jahr über eine große Auswahl an Steingutstücken zu günstigen Preisen an."
    ],
    "en": [
      "Jars is a stoneware specialist in the art of tableware and home decoration. Our  know-how and design techniques have made us a recognized brand name the world over.   The shop offers  discontinued lines."
    ],
    "it": [
      "Jars è un produttore di ceramiche fondato nel 1857 ad Anneyron, nella Drôme.\r\nIl negozio del laboratorio offre una vasta gamma di pezzi in gres a prezzi accessibili tutto l'anno."
    ],
    "fr": [
      "Jars est une manufacture de céramique fondée en 1857 à Anneyron, dans la Drôme.\r\nLa boutique d'ateliers  propose toute l’année, un large choix de pièces en grès à prix doux."
    ],
    "nl": [
      "Tafelkunst en huisinrichting, wereldberoemd merk. Verkoop van restanten en afgeprijsde producten."
    ],
    "es": [
      "Jars es un fabricante de cerámica fundado en 1857 en Anneyron, en la Drôme.\r\nLa tienda-taller ofrece durante todo el año una amplia gama de piezas de gres a precios asequibles."
    ]
  },
  "rdfs:label": {
