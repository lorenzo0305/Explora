  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ceac18b8-b952-3709-a972-40ffbe08b6cb",
      "dc:description": {
        "de": [
          "Nimm deine Mütter, Großmütter, Schwestern, Freundinnen... mit zu einem Nachmittag mit Mädchenfußball\nVon 14 Uhr bis 17 Uhr\nOffen für alle, ob sportlich oder nicht!\nWorkshops, Gesprächsrunden, Minispiele, ... rund um den Fußball"
        ],
        "en": [
          "Bring your mothers, grandmothers, sisters, friends... for an afternoon of girls' soccer!\n2pm to 5pm\nOpen to all, sporty or not!\nWorkshops, round tables, mini-games... all about soccer"
        ],
        "it": [
          "Portate le vostre mamme, nonne, sorelle, amiche... per un pomeriggio di calcio femminile!\nDalle 14.00 alle 17.00\nAperto a tutte, sportive e non!\nLaboratori, tavole rotonde, mini-giochi... tutto sul calcio"
        ],
        "fr": [
          "Emmenez vos mères, grands-mères, soeurs, amies... pour une après-midi foot entre filles \nDe 14h à 17h\nOuvert à toutes, sportives ou non ! \nAteliers, tables rondes, mini-jeux, ... autour du football"
        ],
        "es": [
          "Traed a vuestras madres, abuelas, hermanas, amigas... ¡para una tarde de fútbol femenino!\nDe 14:00 a 17:00\nAbierto a todas, ¡seas deportista o no!\nTalleres, mesas redondas, minijuegos... todo sobre el fútbol"
        ],
        "nl": [
          "Breng je moeders, oma's, zussen, vriendinnen... mee voor een middag meidenvoetbal!\n14.00 tot 17.00 uur\nOpen voor iedereen, of je nu sport of niet!\nWorkshops, ronde tafels, minigames... alles over voetbal"
        ]
      },
      "@type": [
        "Description"
