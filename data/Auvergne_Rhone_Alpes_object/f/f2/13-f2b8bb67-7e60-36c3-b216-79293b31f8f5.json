  "rdfs:comment": {
    "de": [
      "Familienbauernhof mit biologischem Landbau und Hofladen.\r\n\r\nHeute werden Aprikosen, Quitten, Kirschen, Pfirsiche, Birnen und Äpfel angebaut. Die Bäume sind zwischen 30 und 2 Jahre alt."
    ],
    "en": [
      "Organic family farm and farm store.\r\n\r\nToday, we grow apricots, quinces, cherries, peaches, pears and apples. The trees are between 30 and 2 years old."
    ],
    "it": [
      "Azienda agricola biologica a conduzione familiare e spaccio aziendale. Oggi l'azienda produce albicocche, mele cotogne, ciliegie (da raccogliere), pesche, pere e mele. Gli alberi hanno un'età compresa tra i 30 e i 2 anni."
    ],
    "fr": [
      "Ferme familiale en Agriculture biologique et magasin à la ferme. Aujourd’hui, on retrouve des abricots, des coings, des cerises (en cueillette libre), des pêches, des poires et des pommes. Les arbres ont entre 30 ans et 2 ans."
    ],
    "es": [
      "Granja familiar ecológica y tienda de productos agrícolas. En la actualidad, la granja produce albaricoques, membrillos, cerezas (de cosecha propia), melocotones, peras y manzanas. Los árboles tienen entre 30 y 2 años."
    ],
    "nl": [
      "Biologische familieboerderij en boerderijwinkel.\r\n\r\nVandaag telen we abrikozen, kweeperen, kersen, perziken, peren en appels. De bomen zijn tussen de 30 en 2 jaar oud."
    ]
  },
  "rdfs:label": {
