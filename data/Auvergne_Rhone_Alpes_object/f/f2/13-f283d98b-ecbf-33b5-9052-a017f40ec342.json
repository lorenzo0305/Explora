  "rdfs:comment": {
    "de": [
      "Die teilnehmenden Bauernhöfe, die sich der nachhaltigen Landwirtschaft verschrieben haben, öffnen ihre Türen für die breite Öffentlichkeit. Zögern Sie nicht, das Programm in unseren Informationsbüros anzufordern."
    ],
    "en": [
      "Participating farms committed to sustainable agriculture open their doors to the general public. Don't hesitate to ask for the program at our information desks."
    ],
    "it": [
      "Le aziende agricole partecipanti, tutte impegnate nell'agricoltura sostenibile, aprono le loro porte al pubblico. Non esitate a chiedere il programma presso i nostri uffici informazioni."
    ],
    "fr": [
      "Les fermes participantes, engagées dans une démarche d’Agriculture Durable, ouvrent leurs portes au grand public. N'hésitez pas à demander le programme dans nos bureaux d'informations."
    ],
    "es": [
      "Las explotaciones participantes, todas ellas comprometidas con la Agricultura Sostenible, abren sus puertas al público en general. No dude en preguntar por el programa en nuestras oficinas de información."
    ],
    "nl": [
      "De deelnemende boerderijen, die zich allemaal inzetten voor duurzame landbouw, openen hun deuren voor het grote publiek. Aarzel niet om naar het programma te vragen bij onze informatiekantoren."
    ]
  },
