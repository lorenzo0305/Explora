  "rdfs:comment": {
    "de": [
      "Unsere Einrichtungen :\r\n6 Einzelkabinen,\r\n2 Duo-Kabinen\r\n 2 Peelingkabinen\r\n\r\nEin intimer, halbprivater Wellnessbereich bestehend aus einem Whirlpool und einem Hammam\r\n\r\nEin Loungebereich, in dem Sie nach den Behandlungen etwas essen und Ihren Tee genießen können."
    ],
    "en": [
      "Our facilities:\r\n6 single cabins,\r\n2 duo cabins\r\n 2 exfoliation cabins\r\n\r\nIntimate, semi-private wellness area with whirlpool bath and steam room\r\n\r\nA lounge area for refreshments and afternoon tea."
    ],
    "it": [
      "Le nostre strutture :\r\n5 cabine singole,\r\n2 cabine duo\r\n 2 cabine di esfoliazione\r\n\r\nUn'area benessere intima e semi-privata con vasca idromassaggio e bagno turco\r\n\r\nUn'area lounge dove mangiare e gustare una tazza di tè dopo i trattamenti."
    ],
    "fr": [
      "Nos installations :\r\n5 cabines individuelles,\r\n2 cabines duos\r\n 2 cabines de gommage\r\n\r\nUn espace bien-être intimiste et semi-privatif composé d'un bain à remous et d'un hammam\r\n\r\nUn espace lounge pour se restaurer et déguster son thé à la fin des soins."
    ],
    "nl": [
      "Onze faciliteiten :\r\n6 eenpersoonshutten,\r\n2 tweepersoonshutten\r\n 2 scrubhutten\r\n\r\nEen intieme, semi-private wellnessruimte met bubbelbad en stoombad\r\n\r\nEen loungeruimte waar je kunt eten en genieten van een kopje thee na je behandelingen."
    ],
    "es": [
      "Nuestras instalaciones :\r\n5 camarotes individuales,\r\n2 cabinas dúo\r\n 2 cabinas de exfoliación\r\n\r\nUn espacio de bienestar íntimo y semiprivado con bañera de hidromasaje y sala de vapor\r\n\r\nUna zona lounge donde podrá comer y disfrutar de una taza de té después de sus tratamientos."
    ]
  },
