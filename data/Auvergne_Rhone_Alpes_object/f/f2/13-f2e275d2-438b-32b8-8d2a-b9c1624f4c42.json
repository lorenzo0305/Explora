  "rdfs:comment": {
    "de": [
      "Die Balcons de l'Isère sind ein Zusammenschluss von Bergprofis aus dem Gebiet der Coulmes. Unsere Berufung: unsere Leidenschaft für die Naturbeobachtung zu teilen und Ihnen die schönsten Orte des Vercors zu zeigen."
    ],
    "en": [
      "Les Balcons de l'Isère brings together mountain professionals from the Coulmes area. Our vocation: to share our passion for observing nature and make you discover the most beautiful places of the Vercors."
    ],
    "it": [
      "I Balcons de l'Isère sono un gruppo di professionisti della montagna della zona di Coulmes. La nostra vocazione: condividere la nostra passione per l'osservazione della natura e farvi scoprire i luoghi più belli del Vercors."
    ],
    "fr": [
      "Les Balcons de l'Isère regroupent des professionnels de la montagne du secteur des Coulmes. Notre vocation : partager notre passion pour l’observation de la nature et vous faire découvrir les plus beaux endroits du Vercors."
    ],
    "es": [
      "Los Balcons de l'Isère son un grupo de profesionales de la montaña de la zona de Coulmes. Nuestra vocación: compartir nuestra pasión por la observación de la naturaleza y ayudarle a descubrir los lugares más bellos del Vercors."
    ],
    "nl": [
      "De Balcons de l'Isère is een groep bergprofessionals uit de omgeving van Coulmes. Onze roeping: onze passie voor natuurwaarneming delen en u de mooiste plekjes van de Vercors laten ontdekken."
    ]
  },
