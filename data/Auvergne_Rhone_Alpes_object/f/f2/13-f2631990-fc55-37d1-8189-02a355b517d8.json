  "rdfs:comment": {
    "de": [
      "Ausgestattet mit einer Karte, in der Gruppe, allein oder im Team macht man sich in der freien Natur auf die Suche nach Markierungen. Diese spielerische Aktivität ist für Kinder ab 6 Jahren geeignet (in Begleitung eines Erwachsenen)."
    ],
    "en": [
      "Armed with a map, groups, individuals or teams set off in search of beacons in the great outdoors. It's a fun activity for children aged 6 and over (accompanied by an adult)."
    ],
    "it": [
      "Armati di mappa, in gruppo, da soli o come parte di una squadra, si parte alla ricerca di fari nella natura. È un'attività divertente per bambini dai 6 anni in su (accompagnati da un adulto)."
    ],
    "fr": [
      "Muni d’une carte, en groupe, seul ou en équipe, on part à la recherche de balises en pleine nature. C’est une activité ludique accessible à partir de 6 ans (en étant accompagné d’un adulte)."
    ],
    "nl": [
      "Gewapend met een kaart ga je in groepjes, alleen of in teamverband op zoek naar bakens in de natuur. Het is een leuke activiteit voor kinderen vanaf 6 jaar (onder begeleiding van een volwassene)."
    ],
    "es": [
      "Armados con un mapa, en grupos, solos o en equipo, salimos en busca de balizas en plena naturaleza. Es una actividad divertida para niños a partir de 6 años (acompañados de un adulto)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation du Bruas - 800m"
    ]
  },
