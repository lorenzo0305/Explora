  "rdfs:comment": {
    "de": [
      "Eine kleine Blase, um sanft die Lust am Spiel zu wecken, um mit Kleinkindern und Erwachsenen die Freude am gemeinsamen Spiel zu teilen."
    ],
    "en": [
      "A little bubble to gently awaken a taste for play, so that toddlers and adults alike can share the pleasure of playing together."
    ],
    "it": [
      "Una piccola bolla per risvegliare delicatamente il gusto del gioco, affinché grandi e piccini possano condividere il piacere di giocare insieme."
    ],
    "fr": [
      "Une petite bulle pour éveiller tout en douceur le goût au jeu, pour partager, tout-petits et grands le plaisir de jouer ensemble."
    ],
    "es": [
      "Una burbujita para despertar suavemente el gusto por el juego, para que pequeños y mayores compartan el placer de jugar juntos."
    ],
    "nl": [
      "Een bubbeltje om zachtjes de smaak van het spelen op te wekken, zodat peuters en volwassenen het plezier van samen spelen kunnen delen."
    ]
  },
