  "rdfs:comment": {
    "de": [
      "Eugénie, Nicolas und Antoine heißen Sie in ihrem Bar-Restaurant und Konzertsaal willkommen! Kommen Sie auf ein Getränk vorbei, probieren Sie ihr hausgemachtes Essen, spielen Sie Dart und Tischfußball, bringen Sie die Tanzfläche zum Glühen oder lernen Sie sie einfach kennen!"
    ],
    "en": [
      "Eugénie, Nicolas and Antoine welcome you to their bar-restaurant and concert venue! Come and have a drink, taste their homemade food, play darts and table soccer, fire up the dance floor or simply meet them!"
    ],
    "it": [
      "Eugénie, Nicolas e Antoine vi danno il benvenuto nel loro bar-ristorante e sala concerti! Venite a bere qualcosa, ad assaggiare i loro piatti fatti in casa, a giocare a freccette e a calcio balilla, ad accendere la pista da ballo o semplicemente a conoscerli!"
    ],
    "fr": [
      "Eugénie, Nicolas et Antoine vous accueillent dans leur bar-restaurant et salle de concert ! Venez boire un verre, déguster leur nourriture maison, jouer aux fléchettes et au babyfoot, enflammer la piste de danse ou simplement les rencontrer !"
    ],
    "es": [
      "Eugénie, Nicolas y Antoine te dan la bienvenida a su bar-restaurante y sala de conciertos Venga a tomar una copa, a degustar su comida casera, a jugar a los dardos y al futbolín, a encender la pista de baile o simplemente a conocerlos"
    ],
    "nl": [
      "Eugénie, Nicolas en Antoine heten je welkom in hun bar-restaurant en concertzaal! Kom iets drinken, hun huisgemaakte gerechten proeven, darts en tafelvoetbal spelen, de dansvloer opstoken of gewoon kennismaken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vacarme Exquis"
    ]
  },
