  "rdfs:comment": {
    "de": [
      "Muskelaufbau und Fitness\r\nDas Fitness Center empfängt Sie das ganze Jahr über.\r\nModule und Geräte für alle Niveaus garantieren Ihnen eine perfekte Fitness vor, während und nach dem Urlaub!"
    ],
    "en": [
      "Bodybuilding and fitness\r\nThe Fitness Center welcomes you all year round.\r\nModules and devices for all levels that guarantee you perfect fitness before, during, after the holidays!"
    ],
    "it": [
      "Bodybuilding e fitness\r\nIl Centro fitness vi accoglie tutto l'anno.\r\nModuli e attrezzature per tutti i livelli vi garantiscono un allenamento perfetto prima, durante e dopo le vacanze!"
    ],
    "fr": [
      "Musculation et remise en forme\r\nLe Fitness Center vous accueille toute l’année.\r\nDes modules et des appareils pour tous les niveaux qui vous garantissent une parfaite remise en forme avant, pendant, après les vacances !"
    ],
    "es": [
      "Culturismo y fitness\r\nEl Centro de Fitness le da la bienvenida todo el año.\r\nMódulos y equipos para todos los niveles le garantizan un entrenamiento perfecto antes, durante y después de sus vacaciones"
    ],
    "nl": [
      "Bodybuilding en fitness\r\nHet fitnesscentrum verwelkomt u het hele jaar door.\r\nModules en apparaten voor alle niveaus die u perfecte fitheid garanderen voor, tijdens, na de vakantie!"
    ]
  },
  "rdfs:label": {
    "en": [
