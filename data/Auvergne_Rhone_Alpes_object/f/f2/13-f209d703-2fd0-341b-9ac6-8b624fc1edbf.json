  "rdfs:comment": {
    "de": [
      "Im Espace Harmonia können kleine Privatbüros und flexibel buchbare Arbeitsbereiche für mobile Arbeitnehmer, Selbstständige und Unternehmen mit kleinen Teams gemietet werden."
    ],
    "en": [
      "La Loco'Working in Bourgoin-Jallieu, a place optimized for work and a set of small, practical and indispensable services for the well-being of our loco'workers! Discover a different way of working!"
    ],
    "it": [
      "Espace Harmonia offre piccoli uffici privati e spazi di lavoro flessibili in affitto a lavoratori mobili, freelance e aziende con piccoli team."
    ],
    "fr": [
      "L'espace Harmonia propose à la location des petits bureaux privés et des espaces de travail aux réservations flexibles pour travailleurs nomades, indépendants et pour les entreprises avec de petites équipes."
    ],
    "es": [
      "Espace Harmonia ofrece pequeñas oficinas privadas y espacios de trabajo flexibles en alquiler a trabajadores móviles, autónomos y empresas con equipos reducidos."
    ],
    "nl": [
      "Espace Harmonia biedt kleine privékantoren en flexibele werkruimten te huur aan mobiele werknemers, freelancers en bedrijven met kleine teams."
    ]
