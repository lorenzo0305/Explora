  "rdfs:comment": {
    "de": [
      "Entdecken Sie die bildende Kunst oder perfektionieren Sie sie mit der bildenden Künstlerin Corinne Chany.\r\nKurse für alle Niveaus dienstags von 14:30 bis 16:30 Uhr für Erwachsene. 17h bis 18h30 Workshops für Kinder (1 Woche/2)"
    ],
    "en": [
      "Discover or perfect your art with Corinne Chany, artist painter.\r\nClasses for all levels on Tuesdays from 2:30pm to 4:30pm for adults. 5 to 6.30pm children's workshops (1 week/2)"
    ],
    "it": [
      "Venite a scoprire o a migliorare le vostre arti plastiche con Corinne Chany, pittrice plastica.\r\nLezioni per tutti i livelli il martedì dalle 14.30 alle 16.30 per gli adulti. laboratori per bambini dalle 17.00 alle 18.30 (1 settimana/2)"
    ],
    "fr": [
      "Venez découvrir ou vous perfectionner en art plastique avec Corinne Chany, artiste peintre plasticienne.\r\nCours pour tous niveaux les mardis de 14h30 à 16h30 pour les adultes. 17h à 18h30 ateliers enfants (1 semaine/2)"
    ],
    "es": [
      "Venga a descubrir o perfeccionar sus artes plásticas con Corinne Chany, pintora plástica.\r\nClases para todos los niveles los martes de 14h30 a 16h30 para adultos. talleres infantiles de 17.00 a 18.30 h (1 semana/2)"
    ],
    "nl": [
      "Kom en ontdek of verbeter je plastische kunsten met Corinne Chany, plastisch schilder.\r\nLessen voor alle niveaus op dinsdag van 14.30 tot 16.30 uur voor volwassenen. kinderworkshops van 17.00 tot 18.30 uur (1 week/2)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de Dessin | Corinne Chany"
    ]
  },
