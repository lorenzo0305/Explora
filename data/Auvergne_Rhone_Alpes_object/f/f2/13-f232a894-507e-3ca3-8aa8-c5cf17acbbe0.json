  "rdfs:comment": {
    "de": [
      "Im Bistro-Restaurant La Rochelambert bereiten wir Ihnen gastronomische Spezialitäten aus dem Velay zu, wobei wir so weit wie möglich auf kurze Transportwege und Bioprodukte setzen."
    ],
    "en": [
      "At the La Rochelambert bistro-restaurant, we prepare gastronomic specialties from the Velay region, using local produce and organic products wherever possible."
    ],
    "it": [
      "Al ristorante bistrot La Rochelambert prepariamo specialità gastronomiche della regione del Velay, utilizzando, ove possibile, prodotti locali e biologici."
    ],
    "fr": [
      "Au bistrot restaurant La Rochelambert nous vous préparons des spécialités gastronomiques du Velay en privilégiant autant que possible le circuit court et les produits bios."
    ],
    "nl": [
      "In het bistro-restaurant La Rochelambert bereiden we gastronomische specialiteiten uit de streek Velay, waar mogelijk met lokale producten en biologische producten."
    ],
    "es": [
      "En el restaurante bistró La Rochelambert, preparamos especialidades gastronómicas de la región de Velay, utilizando productos locales y ecológicos siempre que sea posible."
    ]
  },
