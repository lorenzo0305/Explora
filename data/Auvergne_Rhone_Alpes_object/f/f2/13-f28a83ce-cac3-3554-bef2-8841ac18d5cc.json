  "rdfs:comment": {
    "de": [
      "Das Atrium ist eine städtische Einrichtung im Herzen von Le Fontanil-Cornillon, die ein Programm mit Aufführungen, Konzerten, Theaterstücken, kulturellen Begegnungen und Ausstellungen bietet."
    ],
    "en": [
      "The Atrium is a municipal facility located in the heart of Le Fontanil-Cornillon, offering a program of shows, concerts, plays, cultural events and exhibitions."
    ],
    "it": [
      "L'Atrium è una struttura comunale situata nel cuore di Fontanil-Cornillon, che offre un programma di spettacoli, concerti, rappresentazioni teatrali, eventi culturali e mostre."
    ],
    "fr": [
      "L'Atrium est un équipement municipal situé au cœur du Fontanil-Cornillon, qui propose une programmation de spectacles,  concerts, pièces de théâtre, rencontres culturelles et expositions."
    ],
    "nl": [
      "Het Atrium is een gemeentelijke voorziening in het hart van Le Fontanil-Cornillon, die een programma biedt van voorstellingen, concerten, toneelstukken, culturele evenementen en tentoonstellingen."
    ],
    "es": [
      "El Atrium es un equipamiento municipal situado en el corazón de Le Fontanil-Cornillon, que ofrece un programa de espectáculos, conciertos, obras de teatro, eventos culturales y exposiciones."
    ]
  },
