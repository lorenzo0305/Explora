  "rdfs:comment": {
    "de": [
      "Fred bietet Ihnen Pizzen zum Mitnehmen und Gebäck auf Bestellung für Ihre Veranstaltungen.Fred ist ein leidenschaftlicher Hobbykoch und bietet Ihnen qualitativ hochwertige Gerichte, die mit einem Maximum an lokalen Produkten zubereitet werden."
    ],
    "en": [
      "\"For your events, Fred proposes takeaway pizzas and pastries to order. \r\nWith his passion for the catering trade, Fred proposes high-quality food made from local ingredients whenever possible.\""
    ],
    "it": [
      "Roger offre pizze da asporto e verrine al tiramisù per i vostri eventi. Appassionato di arte culinaria, Roger vi offrirà piatti di qualità realizzati con il massimo dei prodotti locali."
    ],
    "fr": [
      "Roger vous propose des pizzas à emporter et des verrines de tiramisu pour vos événements. Passionné des métiers de bouche, Roger vous proposera des mets de qualités fabriqués avec un maximum de produits locaux."
    ],
    "es": [
      "Roger le ofrece pizzas para llevar y verrines de tiramisú para sus eventos. Con su pasión por las artes culinarias, Roger le ofrecerá platos de calidad elaborados con un máximo de productos locales."
    ],
    "nl": [
      "Roger biedt afhaalpizza's en tiramisu-glaasjes voor uw evenementen. Met zijn passie voor culinaire kunsten biedt Roger je kwaliteitsgerechten gemaakt met een maximum aan lokale producten."
    ]
  },
