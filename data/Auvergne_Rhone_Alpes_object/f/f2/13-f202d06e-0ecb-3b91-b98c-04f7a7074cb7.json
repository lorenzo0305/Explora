  "rdfs:comment": {
    "de": [
      "Prestigeträchtige Ausstellungen am Wochenende\r\nTon und Licht, Freitagabend um 21 Uhr\r\nGallisches Festmahl mit der Celtic-Rock-Band Nataverne, Samstag um 20 Uhr\r\nTintinophile und bédéphile Börse, Sonntag ab 8 Uhr\r\nKarneval zum 80. Geburtstag des Journal de Tintin Sonntag, 15 Uhr"
    ],
    "en": [
      "Prestigious weekend exhibitions\r\nSon et lumière, Friday evening at 9pm\r\nGallic banquet with Celtic-rock band Nataverne, Saturday at 8pm\r\nTintinophile and comic-book fair, Sunday from 8am\r\nCarnival to celebrate 80 years of the Journal de Tintin, Sunday at 3pm"
    ],
    "it": [
      "Prestigiose mostre nel fine settimana\r\nSpettacolo di suoni e luci, venerdì sera alle 21.00\r\nBanchetto gallico con la band celtic-rock Nataverne, sabato alle 20.00\r\nFiera di Tintin e del fumetto, domenica dalle 8.00\r\nCarnevale per festeggiare gli 80 anni del Journal de Tintin, domenica alle 15.00"
    ],
    "fr": [
      "Expositions prestigieuses le week-end\r\nSon et lumière, vendredi soir à 21h\r\nBanquet gaulois animé par le groupe de celtic-rock Nataverne, samedi à 20h\r\nBourse tintinophile et bédéphile, dimanche dès 8h\r\nCarnaval des 80 ans du Journal de Tintin dimanche à 15h"
    ],
    "es": [
      "Prestigiosas exposiciones durante el fin de semana\r\nEspectáculo de luz y sonido, viernes a las 21.00 horas\r\nBanquete galo con el grupo de rock celta Nataverne, sábado a las 20.00 horas\r\nSalón de Tintín y del cómic, domingo a partir de las 8.00 h\r\nCarnaval para celebrar los 80 años del Journal de Tintin, domingo a las 15.00 horas"
    ],
    "nl": [
      "Prestigieuze weekendtentoonstellingen\r\nGeluids- en lichtshow, vrijdagavond om 21.00 uur\r\nGallisch banket met Keltische rockband Nataverne, zaterdag om 20 uur\r\nKuifje- en stripbeurs, zondag vanaf 8 uur\r\nCarnaval ter ere van 80 jaar Kuifjejournaal, zondag om 15 uur"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontres Tintinophiles 2026  - Voyage spatio-temporel en fusée"
    ]
