  "rdfs:comment": {
    "de": [
      "Wir sind eine Bar für Gesellschaftsspiele mit einem Spieleladen im vorderen Bereich. Wir veranstalten auch Turniere für Sammelkartenspiele und verkaufen diese im Laden."
    ],
    "en": [
      "We're a board game bar with a game store out front. We also organize trading card tournaments and sell trading cards in our store."
    ],
    "it": [
      "Siamo un bar di giochi da tavolo con un negozio di giochi all'ingresso. Organizziamo anche tornei di carte collezionabili e vendiamo carte collezionabili nel negozio."
    ],
    "fr": [
      "Nous sommes un bar à jeux de société avec une boutique de jeux à l'avant. Nous organisons aussi des tournois de jeux de cartes à collectionner et nous en vendons en boutique."
    ],
    "nl": [
      "We zijn een bar voor bordspellen met een spellenwinkel aan de voorkant. We organiseren ook ruilkaarttoernooien en verkopen ruilkaarten in de winkel."
    ],
    "es": [
      "Somos un bar de juegos de mesa con una tienda de juegos al frente. También organizamos torneos de cartas coleccionables y vendemos cartas coleccionables en la tienda."
    ]
  },
