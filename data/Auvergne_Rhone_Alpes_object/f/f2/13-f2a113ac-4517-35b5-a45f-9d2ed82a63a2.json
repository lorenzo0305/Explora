  "rdfs:comment": {
    "de": [
      "In einem typischen rustikalen Chalet-Rahmen, entdecken Sie unsere raffinierte Küche und unsere savoyischen Spezialitäten.\r\nSonnenterrasse mit Blick auf den Mont Blanc"
    ],
    "en": [
      "In a typical rustic chalet setting, come and discover our refined cuisine and Savoyard specialities.\r\nSunny terrace with Mont Blanc view"
    ],
    "it": [
      "Venite a scoprire la nostra cucina raffinata e le specialità savoiarde in un ambiente tipico da chalet rustico.\r\nTerrazza soleggiata con vista sul Monte Bianco"
    ],
    "fr": [
      "Dans un cadre typique de chalet rustique, venez découvrir notre cuisine raffinée ainsi que nos spécialités savoyardes .\r\nTerrasse ensoleillée avec vue Mont Blanc"
    ],
    "es": [
      "Venga a descubrir nuestra cocina refinada y nuestras especialidades saboyanas en un ambiente típico de chalet rústico.\r\nTerraza soleada con vistas al Mont Blanc"
    ],
    "nl": [
      "Kom en ontdek onze verfijnde keuken en Savoyaardse specialiteiten in een typische rustieke chaletomgeving.\r\nZonnig terras met uitzicht op de Mont Blanc"
    ]
  },
  "rdfs:label": {
