  "rdfs:comment": {
    "de": [
      "Die unabhängigen Winzer und Erntebesitzer Magali und Nicolas freuen sich, Sie auf der Domaine de Roquevignan in Rochegude in der Drôme Provençale zu empfangen, um Ihnen ihren Beruf und ihre Weine vorzustellen."
    ],
    "en": [
      "Magali and Nicolas, independent winemakers and harvesting owners, are delighted to welcome you to the Domaine de Roquevignan in Rochegude, Drôme Provençale, to introduce you to their trade and their wines."
    ],
    "it": [
      "Magali e Nicolas, viticoltori e vendemmiatori indipendenti, sono lieti di accogliervi al Domaine de Roquevignan a Rochegude, nella Drôme Provençale, per farvi scoprire il loro mestiere e i loro vini."
    ],
    "fr": [
      "Vignerons indépendants et propriétaires récoltants, Magali et Nicolas, sont heureux de vous recevoir au domaine de Roquevignan à Rochegude en Drôme Provençale, pour vous faire découvrir leur métier et leurs vins."
    ],
    "es": [
      "Magali y Nicolas, viticultores y cosecheros independientes, están encantados de recibirle en el Domaine de Roquevignan, en Rochegude, en la Drôme provenzal, para hacerle descubrir su oficio y sus vinos."
    ],
    "nl": [
      "Magali en Nicolas, onafhankelijke wijnbouwers en oogstende eigenaren, heten u van harte welkom op het Domaine de Roquevignan in Rochegude in de Drôme Provençale, om u hun vak en hun wijnen te laten ontdekken."
    ]
  },
  "rdfs:label": {
