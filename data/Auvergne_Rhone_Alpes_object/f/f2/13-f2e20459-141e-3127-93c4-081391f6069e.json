  "rdfs:comment": {
    "de": [
      "Unsere Familienstruktur liegt im Süden der Drôme, in Le Poët-Célard, und bietet Ihnen Aktivitäten, die von den \"ExtraPattes\" gezogen werden, nackten Superhelden, nordischen Hunden mit großem Herz."
    ],
    "en": [
      "Located in the south of the Drôme, in Le Poët-Célard, our family-run facility offers activities pulled by the \"ExtraPattes\", our Nordic dogs with their big hearts."
    ],
    "it": [
      "Situata nel sud della Drôme, a Le Poët-Célard, la nostra azienda a conduzione familiare propone attività trainate dagli \"ExtraPattes\", i nostri supereroi, cani nordici dal cuore grande"
    ],
    "fr": [
      "Située dans le sud de la Drôme, au Poët-Célard, notre structure familiale vous propose des activités tractées par les \"ExtraPattes\", nos supers héros, des chiens nordiques au grand coeur"
    ],
    "es": [
      "Situada en el sur de la Drôme, en Le Poët-Célard, nuestra empresa familiar ofrece actividades tiradas por los \"ExtraPattes\", nuestros superhéroes, perros nórdicos con un gran corazón"
    ],
    "nl": [
      "Gelegen in het zuiden van de Drôme, in Le Poët-Célard, biedt ons familiebedrijf activiteiten aan die getrokken worden door de \"ExtraPattes\", naakte superhelden, Scandinavische honden met een groot hart."
    ]
  },
  "rdfs:label": {
