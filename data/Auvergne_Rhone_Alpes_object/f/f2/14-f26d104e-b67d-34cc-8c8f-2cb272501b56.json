  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e8927799-4840-3209-aeb7-4c0923fa1f5e",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nDienstag bis Freitag von 9.00 bis 12.30 Uhr und von 14.30 bis 18.00 Uhr\n\nSamstags von 8:30 bis 13:00 Uhr\n\nMontags und sonntags geschlossen\n \nBestellungen :\n\nKontaktieren Sie den Laden entweder per Telefon unter 0624790651 oder per privater Facebook-Nachricht\n\n\n\n \n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nTuesday to Friday, 9:00 am to 12:30 pm and 2:30 pm to 6:00 pm\n\nSaturday from 8h30 to 13h00\n\nClosed on Monday and Sunday\n \nOrdering :\n\nContact the store either by phone at 0624790651 or by private Facebook message\n\n\n\n \n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDa martedì a venerdì, dalle 9.00 alle 12.30 e dalle 14.30 alle 18.00\n\nSabato dalle 8.30 alle 13.00\n\nChiuso il lunedì e la domenica\n \nOrdini :\n\nContattare il negozio per telefono all'indirizzo 0624790651 o tramite messaggio privato su Facebook\n\n\n\n \n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu mardi au Vendredi de 9h00 à 12h30 et de 14h30 à 18h00\n\nLe samedi de 8h30 à 13h00\n\nFermeture le lundi et dimanche\n \nCommandes :\n\nContacter le magasin soit par téléphone au 0624790651 ou par message prive Facebook\n\n\n\n \n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nDinsdag tot en met vrijdag van 9.00 tot 12.30 uur en van 14.30 tot 18.00 uur\n\nZaterdag van 8.30 tot 13.00 uur\n\nGesloten op maandag en zondag\n \nBestellen :\n\nNeem contact op met de winkel via 0624790651 of via een privébericht op Facebook\n\n\n\n \n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe martes a viernes, de 9.00 a 12.30 h. y de 14.30 a 18.00 h\n\nSábado de 8h30 a 13h00\n\nCerrado los lunes y domingos\n \nPedidos :\n\nPóngase en contacto con la tienda por teléfono en 0624790651 o por mensaje privado en Facebook\n\n\n\n \n "
        ]
      },
