  "rdfs:comment": {
    "de": [
      "Etwa 30 Min. von Lyon, Vienne und Bourgoin entfernt liegt bei den Autobahnanbindungen diese Domaine für Ihre privaten oder geschäftlichen Ereignisse in der Region Lyon-Süd oder Vienne. Es ist eine zauberhafte, komfortable und dabei moderne Anlage."
    ],
    "en": [
      "30 minutes from Lyon, Vienne and Bourgoin, and not far from the motorways, the estate welcomes visitors for private or professional events in the southern Lyon and Vienne region. The venue will surprise you with its charm, comfort and modern style."
    ],
    "it": [
      "A 30 minuti da Lione, Vienne e Bourgoin, vicino alle autostrade, la tenuta vi accoglie per i vostri eventi privati o professionali nella regione di Lione Sud o Vienne. Questo luogo vi sorprenderà per il suo fascino, il suo comfort e la sua modernità."
    ],
    "fr": [
      "A 30 min de Lyon, Vienne et Bourgoin, près des axes autoroutiers, le domaine vous accueille pour vos événements privés ou professionnels dans la région sud-lyonnaise ou viennoise. Ce lieu saura vous surprendre par son charme, son confort, sa modernité."
    ],
    "nl": [
      "Op 30 minuten van Lyon, Vienne en Bourgoin, vlakbij de autosnelwegen, verwelkomt het domein u voor uw privé of professionele evenementen in de regio Zuid-Lyon of Vienne. Deze plek zal u verrassen met zijn charme, zijn comfort en zijn moderniteit."
    ],
    "es": [
      "A 30 minutos de Lyon, Vienne y Bourgoin, cerca de las autopistas, la finca le acoge para sus eventos privados o profesionales en el sur de Lyon o en la región de Vienne. Este lugar le sorprenderá por su encanto, su comodidad y su modernidad."
    ]
  },
