  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage des Kunsthandwerks bietet Ihnen das Schuhmuseum kostenlose Blitzführungen zum Thema \"In den Fußstapfen der ersten Hälfte des 20."
    ],
    "en": [
      "As part of the Journées Européennes des métiers d'art, the Musée de la Chaussure is offering free flash visits on the theme: \"In the footsteps of the 1st half of the 20th century\"."
    ],
    "it": [
      "Nell'ambito delle Giornate Europee dell'Artigianato, il Museo della Calzatura offre visite lampo gratuite sul tema \"Sulle orme della prima metà del XX secolo\"."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes des métiers d'art, le Musée de la Chaussure vous propose des visites flash gratuites sur le thème : « Dans les pas de la 1ére moitié du XXème siècle » ."
    ],
    "nl": [
      "In het kader van de Europese Ambachtsdagen biedt het Schoenenmuseum gratis flitsbezoeken aan met als thema \"In de voetsporen van de 1e helft van de 20e eeuw\"."
    ],
    "es": [
      "En el marco de los Días Europeos de la Artesanía, el Museo del Calzado ofrece visitas flash gratuitas sobre el tema \"Tras las huellas de la 1ª mitad del siglo XX\"."
    ]
  },
