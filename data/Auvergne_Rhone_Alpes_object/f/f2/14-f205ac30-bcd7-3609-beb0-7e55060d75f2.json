  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00d0d22e-29d9-327f-953d-f069bb419861",
      "dc:description": {
        "de": [
          "Geschlossen am Dienstag\nGeöffnet Montag und Sonntag von 9H bis 12H30\nMittwoch bis Samstag von 9:30 bis 12:30 Uhr und von 15:00 bis 19:00 Uhr\nfrische Produkte, kurze Wege: Obst und Gemüse, Bauern- und Bioprodukte, Wein und Feinkost"
        ],
        "en": [
          "Closed on Tuesday\nOpen Monday and Sunday from 9H to 12H30\nWednesday to Saturday from 9H30 to 12H30 and from 15H to 19H\nfresh produce, short circuits: fruit and vegetables, farmhouse and organic produce, wines and delicatessen"
        ],
        "it": [
          "Chiuso il martedì\nAperto lunedì e domenica dalle 9H alle 12H30\nDa mercoledì a sabato dalle 9H30 alle 12H30 e dalle 15H alle 19H\nprodotti freschi, circuiti brevi: frutta e verdura, prodotti di fattoria e biologici, vini e gastronomia"
        ],
        "fr": [
          "Fermé le Mardi\nOuvert Lundi et Dimanche de 9H à 12H30\nMercredi  au Samedi  de 9H30 à 12H30 et de 15H à 19H\nproduits frais, circuits courts : fruits et légumes, produits fermiers et bios, vins et épicerie fine"
        ],
        "nl": [
          "Gesloten op dinsdag\nOpen maandag en zondag van 9H tot 12H30\nWoensdag tot zaterdag van 9H30 tot 12H30 en van 15H tot 19H\nverse producten, korte circuits: fruit en groenten, boerderij- en bioproducten, wijnen en delicatessen"
        ],
        "es": [
          "Cerrado los martes\nAbierto lunes y domingo de 9H a 12H30\nDe miércoles a sábado de 9H30 a 12H30 y de 15H a 19H\nproductos frescos, circuitos cortos: frutas y verduras, productos de granja y ecológicos, vinos y delicatessen"
        ]
      },
      "@type": [
        "Description"
      ],
