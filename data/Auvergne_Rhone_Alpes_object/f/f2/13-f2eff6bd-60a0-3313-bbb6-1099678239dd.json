  "rdfs:comment": {
    "de": [
      "Burger und Hotdogs, die vor Ort mit einem Großteil der Rohstoffe von Erzeugern aus Oisans und der Isère hergestellt werden.\r\n\r\nEntdecken Sie jeden Monat zusätzlich zur regulären Speisekarte einen anderen Burger!"
    ],
    "en": [
      "Burgers and hot dogs made on site with a large proportion of raw materials from producers in the Oisans and Isère regions."
    ],
    "it": [
      "Hamburger e hot dog prodotti in loco con un'ampia percentuale di materie prime provenienti da produttori delle regioni di Oisans e Isère.\r\n\r\nScoprite ogni mese un hamburger diverso oltre al menu abituale!"
    ],
    "fr": [
      "Burgers et Hot-dog fabriqués sur place avec une grande partie de matières premières de producteurs de l'Oisans et de l'Isère.\r\n\r\nDécouvrez chaque mois en plus de la carte habituelle, un burger différent !"
    ],
    "es": [
      "Hamburguesas y perritos calientes elaborados in situ con una gran proporción de materias primas procedentes de productores de las regiones de Oisans e Isère.\r\n\r\n¡Descubra cada mes una hamburguesa diferente además de la carta habitual!"
    ],
    "nl": [
      "Burgers en hotdogs ter plekke gemaakt met een groot deel van de grondstoffen van producenten uit de regio's Oisans en Isère."
    ]
  },
  "rdfs:label": {
    "en": [
