  "rdfs:comment": {
    "de": [
      "Eingebettet am Fuße des Roc de Tougne empfängt Sie das Chalet Tonia jeden Tag für eine richtige Mittagspause oder eine kleine Rast im Laufe Ihres Tages."
    ],
    "en": [
      "Nestled at the bottom of Roc de Tougne, Chalet Tonia welcomes you everydays for a real lunch break or a short break during your skiing day."
    ],
    "it": [
      "Situato ai piedi del Roc de Tougne, lo Chalet Tonia vi accoglie ogni giorno per una vera pausa pranzo o una breve sosta durante la giornata."
    ],
    "fr": [
      "Niché au pied du Roc de Tougne, le Chalet Tonia vous accueille tous les jours pour une vraie pause déjeuner ou une petite halte au cours de votre journée."
    ],
    "nl": [
      "Genesteld aan de voet van de Roc de Tougne, verwelkomt Chalet Tonia u elke dag voor een echte lunchpauze of een korte tussenstop tijdens uw dag."
    ],
    "es": [
      "Enclavado al pie del Roc de Tougne, el Chalet Tonia le da la bienvenida todos los días para una verdadera pausa para comer o una breve parada durante su jornada."
    ]
  },
