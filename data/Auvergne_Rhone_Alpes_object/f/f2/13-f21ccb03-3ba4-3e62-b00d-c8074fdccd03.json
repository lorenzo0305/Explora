  "rdfs:comment": {
    "de": [
      "Abri de la Roche Rousse, unter dem Felsen Les Gressonnes, Viertel Les Sibourg. Der Überlieferung nach diente er den Protestanten nach der Widerrufung des Edikts von Nantes als Zufluchtsort."
    ],
    "en": [
      "Roche Rousse shelter, under the Gressonnes rock in the Sibourg district. Tradition has it that it was used by Protestants after the Revocation of the Edict of Nantes."
    ],
    "it": [
      "Rifugio della Roche Rousse, sotto la roccia di Gressonnes, nel distretto di Sibourg. La tradizione vuole che sia stato utilizzato dai protestanti dopo la revoca dell'Editto di Nantes."
    ],
    "fr": [
      "Abri de la Roche Rousse, sous le rocher des Gressonnes, quartier des Sibourg. La tradition dit qu'il servait aux protestants après la Révocation de l'Edit de Nantes."
    ],
    "es": [
      "Refugio de la Roche Rousse, bajo la roca de Gressonnes, en el distrito de Sibourg. La tradición dice que fue utilizada por los protestantes tras la revocación del Edicto de Nantes."
    ],
    "nl": [
      "De schuilplaats van Roche Rousse, onder de rots van Gressonnes, in het district Sibourg. Volgens de overlevering werd het gebruikt door protestanten na de herroeping van het Edict van Nantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Refuge de Roche Rousse"
    ]
  },
