  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Geschmack von La Drôme!\r\nUnser Koch Marie bringt Ihnen eine genussvolle, saisonale Küche mit reichhaltigen Produkten aus dem Land."
    ],
    "en": [
      "Welcome at the Mistral and enjoy our local cuisine and fully of pep!"
    ],
    "it": [
      "Venite a scoprire la nostra cucina regionale, ricca di sapori e piena di brio!"
    ],
    "fr": [
      "Venez découvrir notre cuisine riche en saveurs, régionale et pleine de pep's!"
    ],
    "es": [
      "Venga a descubrir nuestra cocina regional, rica en sabores y llena de energía"
    ],
    "nl": [
      "Ontdek de smaken van de Drôme!\r\nMarie, onze chef-kok, zal u laten ontdekken een seizoensgebonden keuken vol smaken, rijk aan lokale producten."
    ]
  },
