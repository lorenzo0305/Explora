  "rdfs:comment": {
    "de": [
      "Das Refuge des Prés bietet eine einfache und leckere Verpflegung mit traditionellen Spezialitäten, aber auch kleinen Gerichten aus anderen Ländern (savoyische Farce, Käseschnitte, Brettchen, vegetarischer Teller, Obstkuchen, Schokoladenfondant...)."
    ],
    "en": [
      "The Refuge des Prés offers simple and tasty food with traditional specialities but also small dishes from elsewhere (Savoyard stuffing, cheese crust, planks, vegetarian plate, fruit tarts, chocolate fondant...)."
    ],
    "it": [
      "Il Refuge des Prés offre una cucina semplice e gustosa con specialità tradizionali ma anche piccoli piatti provenienti da altri luoghi (ripieno savoiardo, crosta di formaggio, assi, piatto vegetariano, crostate di frutta, fondente al cioccolato...)."
    ],
    "fr": [
      "Le Refuge des Prés propose une restauration simple et gourmande avec des spécialités traditionnelles mais aussi des petits plats d’ailleurs (farcement savoyard, croûte au fromage, planches, assiette végétarienne, tartes aux fruits, fondant au chocolat..)."
    ],
    "es": [
      "El Refuge des Prés ofrece una comida sencilla y sabrosa con especialidades tradicionales pero también pequeños platos de otros lugares (relleno de Saboya, corteza de queso, tablas, plato vegetariano, tartas de frutas, fondant de chocolate...)."
    ],
    "nl": [
      "De Refuge des Prés biedt eenvoudige en smakelijke gerechten met traditionele specialiteiten maar ook kleine gerechten van elders (Savoyaardse vulling, kaaskorst, planken, vegetarische schotel, fruittaartjes, chocoladefondant...)."
    ]
  },
  "rdfs:label": {
    "fr": [
