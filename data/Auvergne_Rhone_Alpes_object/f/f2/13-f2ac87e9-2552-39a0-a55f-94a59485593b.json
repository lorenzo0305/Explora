  "rdfs:comment": {
    "de": [
      "Der Bebock empfängt Sie, um verschiedene Biere zu probieren, aber auch um seinen Laden zu entdecken, in dem Sie eine große Auswahl an Bieren und einigen Spirituosen finden."
    ],
    "en": [
      "Le Bebock welcomes you to taste a wide variety of beers, but also to discover its store, where a wide choice of beers and spirits awaits you."
    ],
    "it": [
      "Le Bebock vi invita a degustare un'ampia varietà di birre e a scoprire il suo negozio, dove vi attende un'ampia scelta di birre e liquori."
    ],
    "fr": [
      "Le Bebock vous accueil pour déguster des bières diverse et variées mais aussi pour découvrir son magasin où vous attend un large choix de bières et quelques spiritueux."
    ],
    "nl": [
      "Le Bebock verwelkomt je om een grote verscheidenheid aan bieren te proeven en ook om zijn winkel te ontdekken, waar een ruime keuze aan bieren en sterke dranken op je wacht."
    ],
    "es": [
      "Le Bebock le da la bienvenida para degustar una gran variedad de cervezas y también para descubrir su tienda, donde le espera una amplia selección de cervezas y licores."
    ]
  },
  "rdfs:label": {
