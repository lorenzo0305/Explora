  "rdfs:comment": {
    "de": [
      "Only Paintball erwartet Sie, um einen Moment im Zeichen der Entdeckung, des Abenteuers und der Entspannung mit der Familie oder mit Freunden auf einem 15 000 m2 großen, angelegten Gelände zu erleben. Entdecken Sie auch das Axtwerfen!"
    ],
    "en": [
      "Only Paintball awaits you for a moment of discovery, adventure and relaxation with family and friends in 15,000m2 of landscaped grounds. Discover axe throwing too!"
    ],
    "it": [
      "Only Paintball vi aspetta per un momento di scoperta, avventura e relax con la famiglia e gli amici in 15.000 m2 di terreno paesaggistico. Scoprite anche il lancio dell'ascia!"
    ],
    "fr": [
      "Only Paintball vous attend pour vivre un moment placé sous le signe de la découverte, de l'aventure et de la détente en famille ou entre amis dans un espace de 15 000m2 de terrain aménagé. Découvrez aussi le lancer de haches !"
    ],
    "es": [
      "Sólo Paintball le espera para disfrutar de un momento de descubrimiento, aventura y relajación con la familia y los amigos en 15.000m2 de terreno ajardinado. ¡Descubra también el lanzamiento de hachas!"
    ],
    "nl": [
      "Only Paintball wacht op je om te genieten van een moment van ontdekking, avontuur en ontspanning met familie en vrienden op 15.000 m2 aangelegd terrein. Ontdek ook het bijlwerpen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Only Paintball"
    ]
  },
