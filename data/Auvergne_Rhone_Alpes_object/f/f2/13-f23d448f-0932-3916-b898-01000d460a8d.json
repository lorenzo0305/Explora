  "rdfs:comment": {
    "de": [
      "Das 1863 gegründete und in den Gewölben des Château\r\nde Sonnaz untergebrachte Museum lädt Sie zu seiner\r\nWechselausstellung und seinen 3 Dauerausstellungen ein."
    ],
    "en": [
      "The Chablais Museum at the Château de Sonnaz, a historic residence, enjoys an exceptional panorama of Lake Geneva and the Jura. It hosts a permanent exhibition on the history of the Chablais region as well as a temporary exhibition that is renewed every year."
    ],
    "it": [
      "Da questo museo, situato nel castello di Sonnaz, è possibile ammirare un panorama eccezionale sul Lemano e il Giura. Ospita mostre permanenti riattualizzate e un'esposizione temporanea che cambia ogni anno."
    ],
    "fr": [
      "Le musée du Chablais, au château de Sonnaz, propose une exposition permanente sur l’histoire du territoire et, en 2026, l’exposition temporaire « Portrait. De la peinture au selfie, un art de se (re) présenter\"."
    ],
    "nl": [
      "Het Musée du Chablais, in het Château de Sonnaz, heeft een permanente tentoonstelling over de geschiedenis van de regio en in 2026 een tijdelijke tentoonstelling getiteld \"Portret. Van schilderij tot selfie, de kunst van het zichzelf (opnieuw) presenteren\"."
    ],
    "es": [
      "El Museo del Chablais, en el castillo de Sonnaz, cuenta con una exposición permanente sobre la historia de la región y, en 2026, con una exposición temporal titulada \"Retrato. De la pintura al selfie, el arte de (re)presentarse\"."
    ]
  },
