          "additionalInformation": {
            "de": [
              "Geöffnet von Mittwoch bis Sonntag.\r\nMontags und dienstags ganztägig sowie mittwochs und sonntags abends geschlossen.\r\nRestaurant: 12:00 bis 14:00 Uhr und 19:00 bis 22:00 Uhr.\r\nBar: 10:00 bis 14:00 Uhr und 17:30 bis 22:00 Uhr."
            ],
            "en": [
              "Open Wednesday to Sunday.\r\nClosed all day Monday and Tuesday, Wednesday and Sunday evenings.\r\nRestaurant: 12:00 to 14:00 and 19:00 to 22:00.\r\nBar: 10:00 am to 2:00 pm and 5:30 pm to 10:00 pm."
            ],
            "it": [
              "Aperto da mercoledì a domenica.\r\nChiuso tutto il giorno il lunedì e il martedì e il mercoledì e la domenica sera.\r\nRistorante: dalle 12.00 alle 14.00 e dalle 19.00 alle 22.00.\r\nBar: dalle 10 alle 14 e dalle 17.30 alle 22."
            ],
            "fr": [
              "Ouvert du mercredi au dimanche.\r\nFermé le lundi et mardi toute la journée et les mercredis et dimanches soirs.\r\nRestaurant : 12h00 à 14h00 et de 19h00 à 22h00.\r\nBar : 10h00 à 14h00 et de 17h30 à 22h00."
            ],
            "nl": [
              "Geopend van woensdag tot zondag.\r\nOp maandag en dinsdag de hele dag en op woensdag- en zondagavond gesloten.\r\nRestaurant: 12.00 tot 14.00 uur en 19.00 tot 22.00 uur.\r\nBar: 10.00 tot 14.00 uur en 17.30 tot 22.00 uur."
            ],
            "es": [
              "Abierto de miércoles a domingo.\r\nCerrado todo el día los lunes y martes y los miércoles y domingos por la noche.\r\nRestaurante: de 12.00 a 14.00 h. y de 19.00 a 22.00 h.\r\nBar: de 10.00 a 14.00 y de 17.30 a 22.00."
            ]
          },
