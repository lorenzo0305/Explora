  "rdfs:comment": {
    "de": [
      "Nathalie und Christian begrüssen Sie in dem Restaurant \"L'Auberge du Bar à Thym in Minzier in der Nähe von den Alpen."
    ],
    "en": [
      "Nathalie and Christian, originally from Alsace, offer you a warm seasonal welcome at the Auberge du Bar à Thym in Minzier, just outside the Alps."
    ],
    "it": [
      "Christian e il suo team vi offrono un caloroso benvenuto\r\nall'Auberge du Bar à Thym a Minzier, alle porte delle Alpi."
    ],
    "fr": [
      "Christian et son équipe vous accueillent chaleureusement\r\nau fil des saisons à l’Auberge du Bar à Thym à Minzier aux portes des Alpes."
    ],
    "es": [
      "Christian y su equipo le dan la bienvenida\r\nal Auberge du Bar à Thym en Minzier, a las puertas de los Alpes."
    ],
    "nl": [
      "Christian en zijn team heten u van harte welkom\r\nin de Auberge du Bar à Thym in Minzier, aan de poort van de Alpen."
    ]
