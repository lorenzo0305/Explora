  "rdfs:comment": {
    "de": [
      "Um spazieren zu gehen und die Stadt zu genießen, zur Arbeit zu fahren oder die letzten Kilometer bis zu Ihrem Ziel zurückzulegen, ist VIVÉLO die Lösung!"
    ],
    "ru": [
      "VIVÉLO - это решение для прогулок и наслаждения городом, поездок на работу или преодоления последних километров до места назначения!"
    ],
    "en": [
      "VIVÉLO is the solution for strolling and enjoying the city, getting to work or covering the last few kilometers to your destination!"
    ],
    "it": [
      "VIVÉLO è la soluzione per passeggiare e godersi la città, per andare al lavoro o per percorrere gli ultimi chilometri fino alla destinazione!"
    ],
    "fr": [
      "VIVÉLO, votre allié mobilité ! Que ce soit pour flâner en ville, rejoindre votre bureau ou parcourir les derniers kilomètres jusqu’à votre destination, VIVÉLO vous accompagne partout, facilement et en toute liberté."
    ],
    "nl": [
      "VIVÉLO is de oplossing om te wandelen en te genieten van de stad, om naar je werk te gaan of om de laatste kilometers naar je bestemming af te leggen!"
    ],
    "es": [
      "VIVÉLO es la solución para pasear y disfrutar de la ciudad, ir al trabajo o recorrer los últimos kilómetros hasta tu destino."
    ],
    "zh": [
      "VIVÉLO 是您漫步欣赏城市美景、上班或前往目的地最后几公里的最佳选择！"
    ]
  },
