  "rdfs:comment": {
    "de": [
      "Nur wenige Minuten von Genf, Annecy und den Skigebieten entfernt, lässt sich Baud's Table von einem alpenländischen und französischen Terroir inspirieren. Aus Bergkulturen stammend, holt sie die Produkte so nah wie möglich, dort wo sie am besten und zur besten Zeit sind."
    ],
    "en": [
      "Just a few minutes from Geneva, Annecy and the ski resorts, Baud's cuisine is inspired by French and Alpine terroirs. From mountain cultures, it seeks out products as close as possible, where they are at their best and at the best time."
    ],
    "it": [
      "A pochi minuti da Ginevra, Annecy e dalle stazioni sciistiche, la cucina del Baud si ispira alle Alpi francesi. Con le sue culture di montagna, ricerca i prodotti il più vicino possibile, dove sono al meglio e nel momento migliore."
    ],
    "fr": [
      "À quelques minutes de Genève, d'Annecy et des stations de ski, la table de Baud s’inspire d’un terroir alpin et français. De cultures montagnardes, elle va chercher les produits au plus proche, là où ils sont les meilleurs et au meilleur moment."
    ],
    "nl": [
      "Op slechts een paar minuten van Genève, Annecy en de skigebieden is de keuken van Baud geïnspireerd door de Franse Alpen. Met zijn bergculturen zoekt hij producten zo dichtbij mogelijk, waar ze op hun best zijn en op het beste moment."
    ],
    "es": [
      "A pocos minutos de Ginebra, Annecy y las estaciones de esquí, la cocina de Baud se inspira en los Alpes franceses. Con sus culturas de montaña, busca los productos lo más cerca posible, donde están en su mejor momento y en su mejor momento."
    ]
  },
