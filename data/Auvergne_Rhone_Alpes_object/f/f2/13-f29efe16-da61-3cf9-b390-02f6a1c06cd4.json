  "rdfs:comment": {
    "de": [
      "In ihrer außergewöhnlichen grünen Umgebung verspricht Ihnen die Fischzucht mit einer Fläche von drei Hektar angenehme Momente mit der Familie."
    ],
    "ru": [
      "Расположенная в исключительном зеленом месте, рыбная ферма площадью три гектара обязательно понравится всей семье."
    ],
    "en": [
      "Set in an exceptional green setting, the three-hectare fish farm promises pleasant family moments."
    ],
    "it": [
      "Immerso in un'eccezionale cornice di verde, l'allevamento ittico di tre ettari è sicuramente una delizia per tutta la famiglia."
    ],
    "fr": [
      "Dans son écrin de verdure exceptionnel, la pisciculture d'une surface de trois hectares vous promet d'agréables moments en famille."
    ],
    "zh": [
      "占地三公顷的养鱼场绿树成荫，绝对是全家人的乐园。"
    ],
    "es": [
      "Situada en un entorno verde excepcional, esta piscifactoría de tres hectáreas hará las delicias de toda la familia."
    ],
    "nl": [
      "De viskwekerij van drie hectare ligt in een uitzonderlijk groene omgeving en is zeker een genot voor het hele gezin."
    ]
  },
