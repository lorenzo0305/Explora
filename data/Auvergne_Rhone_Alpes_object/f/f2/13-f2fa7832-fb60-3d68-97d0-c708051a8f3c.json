  "rdfs:comment": {
    "de": [
      "Asahi Sushi befindet sich gegenüber dem Palais des Festivals und wählt seine Rohstoffe sorgfältig aus, um eine ganze Reihe von Gerichten wie Sushi, Maki, Sashimi, Chirashi, Lachstatar, Thunfisch und warme Speisen vor Ort oder zum Mitnehmen zuzubereiten."
    ],
    "en": [
      "Facing the Palace of Festivities, Asahi Sushi carefully selects its raw materials to prepare a whole range of sushi dishes, maki, sashimi, chirashi, salmon tartare, tuna and hot dishes at your disposal on site or to take away."
    ],
    "it": [
      "Di fronte al Palais des Festivités, Asahi Sushi seleziona accuratamente le materie prime per preparare un'intera gamma di sushi, maki, sashimi, chirashi, tartara di salmone, tonno e piatti caldi da mangiare o da portare via."
    ],
    "fr": [
      "Face au Palais des Festivités, Asahi Sushi sélectionne soigneusement ses matières premières pour préparer tout un ensemble de plats de sushi, maki, sashimi, chirashi, tartare de saumon, thon et plats chauds à votre disposition sur place ou à l'emporter."
    ],
    "nl": [
      "Tegenover het Palais des Festivités is een hele reeks sushi, maki, sashimi, chirashi en warme gerechten verkrijgbaar om te eten of mee te nemen."
    ],
    "es": [
      "Frente al Palais des Festivités, Asahi Sushi selecciona cuidadosamente sus materias primas para preparar toda una gama de sushi, maki, sashimi, chirashi, tartar de salmón, atún y platos calientes para comer en el restaurante o para llevar."
    ]
  },
