  "rdfs:comment": {
    "de": [
      "Willkommen im Wassersportzentrum Béatrice Hess. Diese neue Einrichtung besteht aus vier Bereichen: sportliche Aktivitäten und Lernen, Wellness und Entspannung, Spielstrukturen im Innenbereich und schließlich Strände, Spielbereich und Rutsche im Außenbereich."
    ],
    "en": [
      "Welcome to the Béatrice Hess aquatic center. This new facility comprises 4 areas: sports and learning activities, well-being and relaxation, indoor play structures and, finally, beaches, play area and outdoor slide."
    ],
    "it": [
      "Benvenuti nel centro acquatico Béatrice Hess. Questa nuova struttura è composta da 4 aree: attività sportive e di apprendimento, benessere e relax, strutture ludiche interne e infine spiagge, area giochi e scivolo esterno."
    ],
    "fr": [
      "Bienvenue au centre aquatique Béatrice Hess. Ce nouvel équipement est composé de 4 espaces : activités sportives et apprentissage, bien-être et détente, structures ludiques intérieures et enfin plages, espace jeux et toboggan extérieurs."
    ],
    "nl": [
      "Welkom in het zwemparadijs Béatrice Hess. Deze nieuwe faciliteit bestaat uit 4 zones: sport- en leeractiviteiten, welzijn en ontspanning, indoor speelstructuren en tot slot stranden, speeltuin en buitenglijbaan."
    ],
    "es": [
      "Bienvenido al centro acuático Béatrice Hess. Esta nueva instalación se compone de 4 áreas: actividades deportivas y de aprendizaje, bienestar y relajación, estructuras de juego interiores y, por último, playas, zona de juegos y tobogán exterior."
    ]
  },
  "rdfs:label": {
    "de": [
      "Schwimmbad Béatrice Hess"
    ],
    "en": [
      "Swimming pool Béatrice Hess"
    ],
    "fr": [
      "Centre Aquatique Béatrice Hess"
    ]
  },
