  "rdfs:comment": {
    "de": [
      "Dies ist ein kleiner Familienbetrieb seit mehreren Generationen. Wir produzieren unser Obst in nachhaltiger Landwirtschaft. In der Saison bieten wir Ihnen an, direkt zum Erzeuger zu kommen, um gutes Obst der Saison zu probieren und zu genießen."
    ],
    "en": [
      "We've been a small family business for several generations. We produce our fruit using sustainable agriculture methods. In season, you can come directly to the grower's to taste and savor good seasonal fruit."
    ],
    "it": [
      "È una piccola azienda agricola a conduzione familiare da diverse generazioni. Produciamo la nostra frutta utilizzando un'agricoltura sostenibile. In stagione, vi proponiamo di recarvi direttamente dal produttore per assaggiare e gustare la buona frutta di stagione."
    ],
    "fr": [
      "C'est une petite exploitation familiale depuis plusieurs générations. Nous produisons nos fruits en agriculture raisonnée. Nous vous proposons en saison de venir directement chez le producteur afin de déguster et savourer de bons fruits de saison."
    ],
    "nl": [
      "We zijn al generaties lang een klein familiebedrijf. We produceren ons fruit met behulp van duurzame landbouwmethoden. In het seizoen kun je rechtstreeks naar de producent komen om goed seizoensfruit te proeven en te proeven."
    ],
    "es": [
      "Es una pequeña granja familiar desde hace varias generaciones. Producimos nuestra fruta mediante una agricultura sostenible. En temporada, le ofrecemos la oportunidad de acudir directamente al productor para degustar y saborear la buena fruta de temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Verger de Béa"
    ]
  },
