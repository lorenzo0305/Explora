  "rdfs:comment": {
    "de": [
      "Vor allem Karpfen und andere große Fische (no kill). Haken ohne Widerhaken.\r\nZugang nur zu einer Hälfte des Teichs erlaubt, die andere Hälfte ist den Gästen des Campingplatzes vorbehalten."
    ],
    "en": [
      "Carp especially and other large fish (no kill). Barbless hooks.\r\nAccess authorised to one half of the pond only, the other half being reserved for campsite guests.\r\nFishing license required: Daily (€14), weekly (€36.50) or yearly permits (€87), on sale at www.cartedepeche.fr or at the campsite Le Cantalou or from the above stockists."
    ],
    "it": [
      "Carpe e altri pesci di grandi dimensioni (no kill). Ami senza ardiglione.\r\nAccesso autorizzato solo a una metà del laghetto, l'altra metà è riservata agli ospiti del campeggio."
    ],
    "fr": [
      "Carpes surtout et autres gros poissons (no kill). Hameçons sans ardillon.\r\nAccès autorisé à une moitié de l'étang seulement, l'autre étant réservée aux clients du camping."
    ],
    "nl": [
      "Vooral karpers en andere grote vissen (no kill). Weerhaakloos haken.\r\nToegang is alleen toegestaan tot de ene helft van de vijver, de andere helft is gereserveerd voor campinggasten.\r\nVisvergunning vereist: Dagelijkse (€ 14), wekelijkse (€ 36,50) of jaarlijkse pas (€ 87), te koop op www.cartedepeche.fr of bij de camping Le Cantalou of bij de bovenstande verkooppunten."
    ],
    "es": [
      "Carpas y otros peces grandes (sin muerte). Anzuelos sin púas.\r\nAcceso autorizado únicamente a una mitad del estanque, la otra mitad está reservada a los clientes del camping."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Pré des Étangs fishing pond"
    ],
    "fr": [
      "Plan d'eau Le Pré des Étangs"
    ],
    "nl": [
      "Visvijver Le Pré des Étangs"
    ]
  },
