  "rdfs:comment": {
    "de": [
      "Freestyle für alle! Kleine und große, junge und weniger junge Teilnehmer, Profis oder Anfänger..., alle Rider kommen auf ihre Kosten. Alles, um einzigartige Momente im Schneeparkt des Grand-Bo zu verbringen (dieser zählt zu den besten Frankreichs)"
    ],
    "en": [
      "Freestyle for all! Young and old, beginners or experienced pros ... all riders will find something for a good session on the park of the Grand Bo ranked among the best French."
    ],
    "it": [
      "Freestyle per tutti! Giovani e meno giovani, professionisti e principianti... C'è qualcosa per ogni rider al parco Grand-Bo, classificato tra i migliori in Francia."
    ],
    "fr": [
      "Le freestyle pour tous ! Petits et grands, jeunes et moins jeunes, pros confirmés ou débutants... Tous les riders trouveront de quoi envoyer une bonne session sur le park du Grand-Bo classé parmi les meilleurs français."
    ],
    "nl": [
      "Freestyle voor iedereen! Jong en oud, profs en beginners... Er is voor elk wat wils in het Grand-Bo park, dat tot de beste van Frankrijk wordt gerekend."
    ],
    "es": [
      "Estilo libre para todos Jóvenes y mayores, profesionales y principiantes... En el parque Grand-Bo, clasificado entre los mejores de Francia, hay para todos los gustos."
    ]
  },
