  "rdfs:comment": {
    "de": [
      "Vortrag präsentiert von Hakim FDAOUCH\r\nreferent, Moderator der Sendung Radio Days\r\nSeit den 1930er Jahren wurde der Indianer in den von den Hollywood-Studios produzierten Western stets negativ dargestellt."
    ],
    "en": [
      "Conference presented by Hakim FDAOUCH\r\nlecturer, host of the Radio Days program\r\nSince the 1930s, Indians have always been negatively portrayed in Hollywood westerns."
    ],
    "it": [
      "Conferenza presentata da Hakim FDAOUCH\r\ndocente, conduttore del programma Radio Days\r\nFin dagli anni '30, gli indiani sono sempre stati ritratti in una luce negativa nei film western prodotti dagli studios di Hollywood."
    ],
    "fr": [
      "Conférence présentée par Hakim FDAOUCH\r\nconférencier, animateur de l'émission Radio Days\r\nDepuis les années 1930, l'indien a toujours été représenté de façon négative dans les westerns produits par les studios hollywoodiens."
    ],
    "nl": [
      "Conferentie gepresenteerd door Hakim FDAOUCH\r\ndocent, presentator van het programma Radio Days\r\nSinds de jaren 1930 zijn Indianen altijd in een negatief daglicht gesteld in westerns die door Hollywoodstudio's zijn geproduceerd."
    ],
    "es": [
      "Conferencia presentada por Hakim FDAOUCH\r\nconferenciante, presentador del programa Días de Radio\r\nDesde los años treinta, los indios siempre han sido retratados de forma negativa en los westerns producidos por los estudios de Hollywood."
    ]
  },
