  "rdfs:comment": {
    "de": [
      "Das L'Entrepôt Café Resto liegt im Gewerbegebiet von Montélimar, unweit der Nationalstraße N7. Es bietet eine Küche, die dem Geschmack des Tages entspricht, aus frischen Produkten zubereitet wird und rund um die Uhr von 8.00 bis 15.30 Uhr serviert wird."
    ],
    "en": [
      "L'Entrepôt Café Resto is located in Montélimar's industrial zone, not far from the N7 motorway, and offers contemporary cuisine made with fresh produce, served any time from 8am to 3:30pm."
    ],
    "it": [
      "Situato nella zona artigianale di Montélimar, non lontano dalla Nationale 7, L'Entrepôt Café Resto offre una cucina contemporanea, preparata con prodotti freschi e servita a qualsiasi ora dalle 8.00 alle 15.30."
    ],
    "fr": [
      "Situé dans la zone artisanale de Montélimar, non loin de la Nationale 7, L'Entrepôt Café Resto propose une cuisine au goût du jour, préparée à partir de produits frais et servie à toute heure de 8 heures à 15h30."
    ],
    "es": [
      "Situado en la zona artesanal de Montélimar, no lejos de la Nationale 7, L'Entrepôt Café Resto ofrece una cocina contemporánea, elaborada con productos frescos y servida a cualquier hora de 8 a 15:30."
    ],
    "nl": [
      "L'Entrepôt Café Resto ligt in het industriegebied Montélimar, niet ver van de snelweg N7, en biedt een eigentijdse keuken met verse producten die tussen 8.00 en 15.30 uur wordt geserveerd."
    ]
  },
  "rdfs:label": {
