  "rdfs:comment": {
    "de": [
      "Episens, Resto Café, tagsüber durchgehend geöffnet\r\n \r\nBio, lokal und hausgemacht. Alle Produkte werden sorgfältig ausgewählt und mit Liebe gekocht! :)\r\nEinzigartige, abwechslungsreiche und ausgewogene Gerichte, jeden Tag anders, vor Ort oder zum Mitnehmen.\r\nDesserts und Getränke"
    ],
    "en": [
      "Episens, Resto Café, open all day long\r\n \r\nOrganic, local and homemade. All products are chosen with care and cooked with love! :)\r\nUnique, varied and balanced dishes, different every day, to eat in or take away.\r\nDesserts and drinks"
    ],
    "it": [
      "Episens, Resto Café, aperto tutto il giorno\r\n \r\nBiologico, locale e fatto in casa. Tutti i prodotti sono scelti con cura e cucinati con amore! :)\r\nPiatti unici, vari ed equilibrati, diversi ogni giorno, da mangiare o da portare via.\r\nDolci e bevande"
    ],
    "fr": [
      "Episens, Resto Café, ouvert la journée en continu\r\n \r\nBio, local et fait maison. Tous les produits sont choisis avec soin et cuisinés avec amour ! :)\r\nPlat unique, varié et équilibré, différent tous les jours, sur place ou à emporter.\r\nDesserts et boissons"
    ],
    "nl": [
      "Episens, Resto Café, de hele dag geopend\r\n \r\nBiologisch, lokaal en huisgemaakt. Alle producten worden met zorg gekozen en met liefde bereid! :)\r\nUnieke, gevarieerde en evenwichtige gerechten, elke dag anders, om te eten of om mee te nemen.\r\nDesserts en drankjes"
    ],
    "es": [
      "Episens, Resto Café, abierto todo el día\r\n \r\nEcológico, local y casero. Todos los productos se eligen con cuidado y se cocinan con amor :)\r\nPlatos únicos, variados y equilibrados, diferentes cada día, para comer en casa o para llevar.\r\nPostres y bebidas"
    ]
  },
