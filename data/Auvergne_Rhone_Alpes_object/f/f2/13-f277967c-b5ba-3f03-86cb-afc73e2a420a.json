  "rdfs:comment": {
    "de": [
      "Dieser halbstädtische Parcours wurde angelegt, um die riesigen Seeforellen zu schützen, die jedes Jahr aus dem See aufsteigen, um sich dort zu vermehren. Werden Sie endlich eine über 80 cm große Forelle fangen?"
    ],
    "en": [
      "This semi-urban course was created to protect the huge lake trout that come up from the lake to spawn every year. Will you finally catch one over 80 cm?"
    ],
    "it": [
      "Questo percorso semi-urbano è stato creato per proteggere le enormi trote lacustri che ogni anno risalgono dal lago per deporre le uova. Riuscirete a catturarne una di oltre 80 cm?"
    ],
    "fr": [
      "Ce parcours semi-urbain a été créé pour protéger les énormes truites lacustres remontant du lac pour s'y reproduire chaque année. En prendrez-vous enfin une de plus de 80 cm ?"
    ],
    "es": [
      "Este recorrido semiurbano se creó para proteger a las enormes truchas de lago que suben cada año a desovar. Atraparás por fin una de más de 80 cm?"
    ],
    "nl": [
      "Dit semi-stedelijke parcours is aangelegd om de enorme meerforellen te beschermen die elk jaar vanuit het meer naar boven komen om te paaien. Vang jij er eindelijk een van meer dan 80 cm lang?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche « 1 poisson » sur le Sierroz à Aix-les-Bains"
    ]
  },
