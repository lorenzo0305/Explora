  "rdfs:comment": {
    "de": [
      "Handwerkliche Ölmühle in der Drôme. Besichtigung der Ölmühle und Verkostung in der Ölbar. Direktverkauf an Privatpersonen von Olivenöl Nyons AOP und anderen AOP-Regionen, Pflanzenölen, Feinkostprodukten und Pflegeprodukten auf Olivenbasis..."
    ],
    "en": [
      "Traditional oil mill in the Drôme (south of France). Tour of the mills and sample tasting at our oil bar, retail sale of PDO Nyons olive oil, PDO Nîmes olive oil, vegetable oils, and olive-based food products and cosmetics."
    ],
    "it": [
      "Frantoio artigianale nella Drôme. Visita al frantoio e degustazione al bar dell'olio. Vendita diretta ai privati dell'olio d'oliva DOP di Nyons e di altre regioni DOP, oli vegetali, prodotti di gastronomia e prodotti per la cura della pelle a base di olive..."
    ],
    "fr": [
      "Huilerie artisanale de la Drôme. Visite du moulin et dégustation au bar à huiles. Vente directe aux particuliers d'huiles d'olive Nyons AOP et autres régions AOP, d'huiles végétales, de produits d'épicerie fine et de produits de soin à base d'olives..."
    ],
    "nl": [
      "De molen bezoeken is mogelijk, proeverijen bij de oliebar, directe verkoop  aan particulieren van olijfolie, olijven, gastronomische oliën,  verzorgingsproducten op basis van olijfolie, etc."
    ],
    "es": [
      "Almazara artesanal en la Drôme. Visita de la almazara y degustación en el bar de aceites. Venta directa a particulares de aceite de oliva con DOP Nyons y otras regiones con DOP, aceites vegetales, productos delicatessen y productos para el cuidado de la piel a base de aceitunas..."
    ]
  },
