  "rdfs:comment": {
    "de": [
      "10.30 Uhr: Lesung von Auszügen aus \"?uvre poétique intégrale\" von M. Desbordes-Valmore durch M-H Boisse.\r\n16.00 Uhr: Treffen mit H. Miguet. Lesung von Auszügen aus seinem dritten Gedichtband \"Gargouille\"."
    ],
    "en": [
      "10:30 am: reading of extracts from M. Desbordes-Valmore's \"complete poetic work\" by M-H Boisse.\r\n4pm: meeting with H. Miguet. Reading of extracts from his third collection \"Gargouille\"."
    ],
    "it": [
      "ore 10.30: lettura di brani dell'opera poetica completa di M. Desbordes-Valmore da parte di M-H Boisse.\r\nore 16.00: incontro con H. Miguet. Lettura di estratti dalla sua terza raccolta \"Gargouille\"."
    ],
    "fr": [
      "10h30 : lecture d'extraits \"Œuvre poétique intégrale\" de M. Desbordes-Valmore par M-H Boisse.\r\n16h : rencontre avec H. Miguet. Lecture d'extraits de son troisième recueil \"Gargouille\"."
    ],
    "nl": [
      "10u30: voordracht van fragmenten uit het volledige poëtische werk van M. Desbordes-Valmore door M-H Boisse.\r\n16u: ontmoeting met H. Miguet. Lezing van fragmenten uit zijn derde bundel \"Gargouille\"."
    ],
    "es": [
      "10.30 h: lectura de extractos de la obra poética completa de M. Desbordes-Valmore por M-H Boisse.\r\n16.00 h: encuentro con H. Miguet. Lectura de extractos de su tercera colección \"Gargouille\"."
    ]
