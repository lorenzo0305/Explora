  "rdfs:comment": {
    "de": [
      "Lust auf Flucht und Abenteuer? Vertic?Eau bietet Ihnen Einführungscanyons ab 8 Jahren, Sportcanyons für einen halben oder ganzen Tag und Praktika an. Zögern Sie nicht, uns zu kontaktieren, um einen unvergesslichen Tag zu erleben!"
    ],
    "en": [
      "Looking for escape and adventure? Vertic'Eau offers introductory canyons for children aged 8 and over, half-day or full-day sport canyons and training courses. Don't hesitate to contact us for an unforgettable day!"
    ],
    "it": [
      "Siete alla ricerca di evasione e avventura? Vertic?Eau offre canyon introduttivi per bambini a partire dagli 8 anni, canyon sportivi e corsi di mezza giornata o di una giornata intera. Non esitate a contattarci per una giornata indimenticabile!"
    ],
    "fr": [
      "Envie d’évasion et d’aventure ? Vertic’Eau vous propose des canyons d’initiation à partir de 8 ans, des canyons sportifs sur la demi-journée ou la journée et des stages. N’hésitez pas à nous contacter pour une journée inoubliable !"
    ],
    "es": [
      "¿Busca evasión y aventura? Vertic'Eau ofrece barrancos de iniciación para niños a partir de 8 años, barrancos deportivos de media jornada o jornada completa y cursillos. No dude en ponerse en contacto con nosotros para pasar un día inolvidable"
    ],
    "nl": [
      "Op zoek naar ontsnapping en avontuur? Vertic'Eau biedt canyoning voor kinderen vanaf 8 jaar, halve of hele dagen sport canyoning en cursussen. Aarzel niet om contact met ons op te nemen voor een onvergetelijk dagje uit!"
    ]
  },
