  "rdfs:comment": {
    "de": [
      "Die gemeindeübergreifende Bibliothek von Châtonnay empfängt Sie dienstags, mittwochs und samstags. Mehr als 10.000 Bücher sind zugänglich und Sie finden eine große Auswahl an Sammlungen."
    ],
    "en": [
      "The intermunicipal library of Châtonnay welcomes you on Tuesdays, Wednesdays and Saturdays. More than 10 000 books are accessible and you will find a wide choice of collections."
    ],
    "it": [
      "La biblioteca intercomunale di Châtonnay vi accoglie il martedì, il mercoledì e il sabato. Sono disponibili più di 10.000 libri e troverete un'ampia scelta di collezioni."
    ],
    "fr": [
      "La bibliothèque intercommunale de Châtonnay vous accueille le mardi, le mercredi et le samedi. Plus de 10 000 ouvrages sont accessibles et vous trouverez un large choix de collections."
    ],
    "es": [
      "La biblioteca intercomunal de Châtonnay le acoge los martes, miércoles y sábados. Hay más de 10.000 libros disponibles y encontrará una amplia selección de colecciones."
    ],
    "nl": [
      "De intercommunale bibliotheek van Châtonnay verwelkomt u op dinsdag, woensdag en zaterdag. Er zijn meer dan 10.000 boeken beschikbaar en u vindt er een ruime keuze aan collecties."
    ]
  },
