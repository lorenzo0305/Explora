  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie mit oder ohne Reservierung für Ihre Geschäftsessen oder für eine ruhige Mittagspause. Mehrmals pro Woche wechselnde Menüs und Gerichte auf der Schiefertafel. Gerichte zum Mitnehmen jeden Mittag jeden Tag."
    ],
    "en": [
      "We welcome you with or without reservation for your business meals or for a quiet lunch break. Menus and slate dishes changing several times a week. Takeaway meals every lunchtime every day."
    ],
    "it": [
      "Vi accogliamo con o senza prenotazione per i vostri pasti di lavoro o per una tranquilla pausa pranzo. I menu e i piatti sulla lavagna cambiano più volte alla settimana. Pasti da asporto tutti i giorni a pranzo."
    ],
    "fr": [
      "Nous vous accueillons avec ou sans réservation pour vos repas d´affaire ou pour une pause déjeuner au calme. Des menus et plats à l´ardoise changeants plusieurs fois par semaine. Plats à emporter tous les midis tous les jours."
    ],
    "nl": [
      "Wij ontvangen u met of zonder reservering voor uw zakelijke maaltijden of voor een rustige lunchpauze. Menu's en gerechten op de lei veranderen meerdere keren per week. Afhaalmaaltijden elke dag tijdens de lunch."
    ],
    "es": [
      "Le recibimos con o sin reserva para sus comidas de negocios o para una tranquila pausa para comer. Los menús y los platos de la pizarra cambian varias veces a la semana. Comidas para llevar todos los días a la hora del almuerzo."
    ]
  },
  "rdfs:label": {
