  "rdfs:comment": {
    "de": [
      "Kreative Küche und Feinschmeckerküche, Happy Food, Lokale und hausgemachte Produkte, Gesellige Gerichte, Paella-Spezialität. In der Nebensaison als Table-Auberge oder im Juli und August als Open-Air-Version. Gruppenmahlzeiten auf Reservierung."
    ],
    "en": [
      "Table on request all year round by reservation. Guinguette from mid-July to mid-August: Creative and gourmet cuisine, Happy Food, Local and home-made produce, Convivial dishes, Paëlla speciality. Group meals by prior arrangement."
    ],
    "it": [
      "Tavolo su richiesta tutto l'anno su prenotazione. Guinguette da metà luglio a metà agosto: cucina creativa e gourmet, Happy Food, prodotti locali e fatti in casa, piatti conviviali, specialità Paëlla. Pasti di gruppo su prenotazione."
    ],
    "fr": [
      "Table à la demande toute l'année sur réservation. Guinguette de mi-juillet à mi Août: Cuisine créative et gourmande, Happy Food, Productions locales et Maison, Plats conviviaux, Spécialité de Paëlla. Repas de groupes sur réservation."
    ],
    "es": [
      "Mesa a petición todo el año previa reserva. Guinguette de mediados de julio a mediados de agosto: Cocina creativa y gastronómica, Happy Food, Productos locales y caseros, Platos de convivencia, Especialidad Paëlla. Comidas para grupos con reserva previa."
    ],
    "nl": [
      "Creatieve en gastronomische keuken, Happy Food, streekproducten en producten van eigen bodem, gezellige gerechten, specialiteit van Paëlla. Tafel-auberge versie in het laagseizoen of openluchtversie in juli en augustus. Groepsmaaltijden op afspraak."
    ]
  },
