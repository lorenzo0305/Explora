  "rdfs:comment": {
    "de": [
      "Der Charme der Saôneufer... Ruhe, warmherziger Empfang, aufmerksamer Service. Sie sind im Hôtel Lyon-Ouest: ein ideales Angebot für Ihre Geschäfts- oder Freizeitaufenthalte!"
    ],
    "en": [
      "Whether you are visiting for business or pleasure, the hotel looks forward to welcoming you into a peaceful setting alongside the river Saone, in a dynamic district with numerous attractions near the town centre."
    ],
    "it": [
      "Il fascino delle sponde della Saona... Tranquillità, accoglienza cordiale, servizio pieno di attenzioni. Sei nell'hotel Lyon-Ouest: un'offerta ideale per i tuoi soggiorni di lavoro o di piacere!"
    ],
    "fr": [
      "Le charme des berges de Saône... Quiétude, accueil chaleureux, service attentionné. Vous êtes à l'hôtel Spark by Hilton Lyon Ouest : une offre idéale pour vos séjours d’affaires ou de loisirs !"
    ],
    "es": [
      "El encanto de las orillas del Saona… Ambiente tranquilo, un cálido recibimiento y un servicio cuidado. Descubra el Hôtel Lyon-Ouest, una opción ideal para cualquier viaje de negocios o turismo."
    ],
    "nl": [
      "De charme van de oevers van de Saône... Rust, een warm welkom en attente service. Dit is het Spark by Hilton Lyon Ouest hotel: de ideale keuze voor uw zaken- of vakantieverblijf!"
    ]
  },
