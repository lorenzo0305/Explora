  "rdfs:comment": {
    "de": [
      "Von der Zeichnung bis zur Tischlerei schafft Sébastien Holzskulpturen, die er Ihnen in der Werkstatt seines Großvaters zeigen wird, wo er frei und auf Bestellung kreiert."
    ],
    "en": [
      "From drawing to woodworking, Sebastian creates wood sculptures that he will makes you discover in his grandfather workshop, where he is creating, freely and to order."
    ],
    "it": [
      "Dal disegno alla falegnameria, Sébastien crea sculture in legno che vi mostrerà nel laboratorio del nonno, dove crea liberamente e su commissione."
    ],
    "fr": [
      "Du dessin à la menuiserie, Sébastien crée des sculptures en bois qu'il vous fera découvrir dans l'atelier de son grand-père, là où il crée, librement et sur commande."
    ],
    "nl": [
      "Van tekenen tot timmeren, Sébastien maakt houten beelden die hij u zal laten zien in het atelier van zijn grootvader, waar hij creëert, vrij en in opdracht."
    ],
    "es": [
      "Del dibujo a la carpintería, Sébastien crea esculturas de madera que le mostrará en el taller de su abuelo, donde crea, libremente y por encargo."
    ]
  },
  "rdfs:label": {
    "en": [
