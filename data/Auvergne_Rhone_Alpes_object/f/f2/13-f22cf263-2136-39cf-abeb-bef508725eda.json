  "rdfs:comment": {
    "de": [
      "Entdecken Sie die gastronomische Welt des Restaurants im Château des Comtes de Challes in Challes-les-Eaux, mit einer Speisekarte, die auf Genuss ausgelegt ist, einem Menü, das unter der Woche frisch vom Markt kommt, und 4- oder 5-Gänge-Menüs, die täglich mittags und abends angeboten werden."
    ],
    "en": [
      "High-quality gastronomic food with seasonal products.\r\nEvery evening at 6 p.m.: wine-tasting with three wines chosen by our wine-waiter, who will reveal all his secrets and the best food-wine matches, through a practical and simple approach. Canapés served."
    ],
    "it": [
      "Scoprite l'universo gastronomico del ristorante dello Château des Comtes de Challes a Challes-les-Eaux, con un menu pensato per il piacere, un menu fresco di mercato durante la settimana e menu di 4 o 5 portate ogni giorno a pranzo e la sera."
    ],
    "fr": [
      "Découvrez l’univers gastronomique du restaurant du Château des Comtes de Challes à Challes-les-Eaux, à travers une carte pensée pour le plaisir, une menu retour du marché en semaine et des menus en 4 ou 5 services tous les jours le midi et le soir."
    ],
    "nl": [
      "Ontdek de gastronomische wereld van het restaurant van het Château des Comtes de Challes in Challes-les-Eaux, met een menu ontworpen voor plezier, een marktvers menu tijdens de week en 4- of 5-gangenmenu's elke dag tijdens de lunch en 's avonds."
    ],
    "es": [
      "Descubra el universo gastronómico del restaurante del Château des Comtes de Challes, en Challes-les-Eaux, con una carta pensada para el placer, un menú de mercado entre semana y menús de 4 o 5 platos todos los días al mediodía y por la noche."
    ]
  },
