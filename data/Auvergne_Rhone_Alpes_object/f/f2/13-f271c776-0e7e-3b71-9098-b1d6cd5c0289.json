  "rdfs:comment": {
    "de": [
      "Strecken für den halben oder ganzen Tag, 5,8, 13, 24 und 32 km. Einführungs-, Familien- oder Sportabfahrten. Formel für 2 Tage Biwak.  Freie oder begleitete Abfahrten. Parkplatz, Dusche, Garage für Motorräder. Diese Basis wird von einem staatlich geprüften Lehrer (BE) geleitet."
    ],
    "en": [
      "Half-day and full-day runs of 5, 8, 13, 24 and 32km. Introductory, family or sport runs. 2-day bivouac formula.  Free or accompanied descent. Parking, shower, motorcycle garage. This base is managed by a state-qualified BE instructor."
    ],
    "it": [
      "Mezza giornata, giornata intera, percorsi di 5, 8, 13, 24 e 32 km. Percorsi introduttivi, familiari o sportivi. Possibilità di bivacco di 2 giorni.  Discesa libera o accompagnata. Parcheggio, doccia, garage per le moto. Questa base è gestita da un istruttore certificato dallo Stato."
    ],
    "fr": [
      "Parcours à la demi-journée, journée, de 5,8, 13, 24 et 32km. Descente d’initiation, familiale ou sportive. Formule sur 2 jours bivouac.  Descente libre ou accompagnée. Parking, douche, garage à moto. Cette base est  gérée par un moniteur diplôme d’Etat BE"
    ],
    "es": [
      "Recorridos de media jornada, jornada completa, 5, 8, 13, 24 y 32 km. Carreras de iniciación, familiares o deportivas. Opción de vivac de 2 días.  Descenso libre o acompañado. Aparcamiento, ducha, garaje para motos. Esta base está dirigida por un monitor titulado estatal."
    ],
    "nl": [
      "Afvaarten van 8, 13, 24 en 32 km voor beginners of iets sportiever.. Formule gedurende 2 dagen met bivak. Vrij of onder begeleiding. Parkeerplaats en douches, moto-garage. (DDJS)"
    ]
  },
