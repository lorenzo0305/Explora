  "rdfs:comment": {
    "de": [
      "Lassen Sie uns die Verbindung, das Kollektiv und die Geselligkeit leben! Lassen Sie uns gemeinsam Wissen und Geschmack aufbauen.\r\nDas Cause Toujours ist vor allem eine Bar! Mittagstisch von Dienstag bis Freitag."
    ],
    "en": [
      "Let's live together, collectively, in conviviality! Let's build together around knowledge and flavors.\r\nLe Cause Toujours is first and foremost a bar! Lunchtime catering Tuesday to Friday."
    ],
    "it": [
      "Viviamo il legame, il collettivo, la convivialità! Costruiamo insieme intorno al sapere e ai sapori.\r\nLe Cause Toujours è soprattutto un bar! Ristorazione a pranzo dal martedì al venerdì."
    ],
    "fr": [
      "Vivons du lien, du collectif, de la convivialité ! Construisons ensemble autours des savoirs et des saveurs.\r\nLe Cause Toujours est avant tout un bar ! Restauration les midis du mardi au vendredi."
    ],
    "es": [
      "¡Vivamos el vínculo, el colectivo, la convivencia! Construyamos juntos en torno al conocimiento y los sabores.\r\nLe Cause Toujours es ante todo un bar Servicio de catering a la hora de comer de martes a viernes."
    ],
    "nl": [
      "Laten we relaties opbouwen, samenkomen en genieten van elkaars gezelschap! Laten we samen bouwen aan kennis en smaken.\r\nLe Cause Toujours is in de eerste plaats een bar! Lunchtime catering van dinsdag tot vrijdag."
    ]
  },
  "rdfs:label": {
