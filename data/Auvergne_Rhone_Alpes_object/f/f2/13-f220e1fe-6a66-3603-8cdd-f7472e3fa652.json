  "rdfs:comment": {
    "de": [
      "Spot \"without killing\" für Flugangler.\r\nDer \"No Kill\"-Kurs verläuft 800 m entlang des Flusses Dorne von Guinguette bis Cheylard. Die Obergrenze befindet sich an der Brücke der Sandgrube.\r\n\r\nKartenverkauf: Super U in Le Cheylard"
    ],
    "en": [
      "Spot \"without killing\" for fly fishing.\r\nThe \"No Kill\" course is on 800m on the river of the Dorne from the Guinguette to Cheylard. The limit Amont is at the bridge of the Sablière.\r\n\r\nCard sales: Super U du Cheylard"
    ],
    "it": [
      "Spot \"senza uccidere\" per la pesca a mosca.\r\nIl percorso \"No Kill\" si sviluppa su 800 m sul fiume della Dorne dalla Guinguette a Cheylard. Il limite di Amont è al ponte della Sablière.\r\n\r\nVendita di carte: Super U du Cheylard"
    ],
    "fr": [
      "Spot \"without killing\" for fly fishing.\r\nThe course \"No Kill\" is on 800m on the river of the Dorne from the Guinguette to Cheylard. The limit Amont is at the bridge of the Sablière.\r\n\r\nVente de carte : Super U du Cheylard"
    ],
    "es": [
      "Spot \"sin matar\" para la pesca a mosca.\r\nEl curso \"No Matar\" está en 800m en el río de la Dorne de la Guinguette a Cheylard. El límite Amont está en el puente de la Sablière.\r\n\r\nVenta de tarjetas: Super U du Cheylard"
    ],
    "nl": [
      "Plek \"zonder doden\" voor vliegvissen.\r\nHet parcours \"No Kill\" ligt op 800m op de rivier de Dorne van de Guinguette tot Cheylard. De limiet Amont ligt bij de brug van de Sablière.\r\n\r\nKaartverkoop: Super U du Cheylard"
    ]
  },
