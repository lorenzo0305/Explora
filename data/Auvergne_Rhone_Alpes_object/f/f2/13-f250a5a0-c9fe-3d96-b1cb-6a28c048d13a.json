  "rdfs:comment": {
    "de": [
      "In einer gemütlichen Atmosphäre empfängt Sie La Barque den ganzen Tag über zum Frühstück, Brunch, Mittagessen, Snacks oder ganz einfach zu einem Aperitif."
    ],
    "en": [
      "In a cosy atmosphere, La Barque welcomes you all day long for breakfast, brunch, lunch, afternoon tea or simply for an aperitif."
    ],
    "it": [
      "In un'atmosfera accogliente, La Barque vi accoglie tutto il giorno per la colazione, il brunch, il pranzo, uno spuntino o semplicemente per un aperitivo."
    ],
    "fr": [
      "Dans une ambiance cosy, La Barque vous accueille toute la journée pour un petit déjeuner, un brunch, un déjeuner, un goûter ou tout soimplement pour un apéritif."
    ],
    "nl": [
      "In een gezellige sfeer verwelkomt La Barque je de hele dag door voor ontbijt, brunch, lunch, een snack of gewoon voor een aperitief."
    ],
    "es": [
      "En un ambiente acogedor, La Barque le da la bienvenida durante todo el día para desayunar, tomar el brunch, comer, merendar o simplemente tomar un aperitivo."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Barque: café, restaurant, boutique and living space"
    ],
    "fr": [
      "La Barque : café, Restaurant, boutique et lieu de vie"
    ]
  },
