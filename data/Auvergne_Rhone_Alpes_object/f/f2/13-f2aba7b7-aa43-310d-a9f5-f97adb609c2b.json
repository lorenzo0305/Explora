  "rdfs:comment": {
    "de": [
      "Das geschlossene Erziehungszentrum hat seinen pädagogischen Bauernhof gegründet und öffnet seine Türen für Sie. Wir bieten einen Besuch auf dem Bauernhof und im Garten, Ponyreiten oder Kutschfahrten, Pferdevermittlung, dekorative Kreationen und einen Workshop zur Herstellung von Ziegenkäse an."
    ],
    "en": [
      "The closed educational centre has set up an educational farm and is opening its doors to you. We offer a visit to the farm and garden, pony or carriage rides, equine mediation, decorative creations and a goat's cheese-making workshop."
    ],
    "it": [
      "Il centro educativo chiuso ha creato la propria fattoria didattica e vi apre le porte. Attività: visita alla fattoria e al giardino, passeggiate in pony o in carrozza, mediazione equina, creazioni decorative, laboratorio di produzione di formaggio di capra."
    ],
    "fr": [
      "Le centre éducatif fermé a créé sa ferme pédagogique et vous ouvre ses portes. Activités : une visite à la ferme et du jardin, la promenade à poney ou en calèche, la médiation équine, créations décoratives, un atelier fabrication de fromage de chèvre."
    ],
    "nl": [
      "Het gesloten educatief centrum heeft een educatieve boerderij opgezet en opent zijn deuren voor jou. Activiteiten: een bezoek aan de boerderij en de tuin, pony- of koetstochten, paardenmeditatie, decoratieve creaties, een workshop geitenkaas maken."
    ],
    "es": [
      "El centro educativo cerrado ha creado su propia granja educativa y le abre sus puertas. Actividades: visita a la granja y al jardín, paseos en poni o en carruaje, mediación equina, creaciones decorativas, taller de elaboración de queso de cabra."
    ]
  },
  "rdfs:label": {
    "de": [
      "Miniferme L'Arverne"
    ],
    "en": [
      "Miniferme L'Arverne"
    ],
    "fr": [
      "Mini ferme L'Arverne"
    ]
  },
