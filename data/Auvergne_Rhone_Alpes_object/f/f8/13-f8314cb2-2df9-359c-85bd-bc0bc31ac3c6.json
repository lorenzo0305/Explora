  "rdfs:comment": {
    "de": [
      "Am Place Bellecour gelegen, ist dieses Restaurant mit dem geselligen Ambiente von 100 Sitzplätzen ein geschickter Mix aus \"Brasserie\" und \"Restaurant\", welcher über eine an schönen Tagen geöffnete Terrasse verfügt."
    ],
    "en": [
      "Located on Place Bellecour, this welcoming restaurant, with capacity for 100 diners, offers a perfect combination of the atmosphere of a brasserie and restaurant. It has a beautiful terrace for when the weather is fine."
    ],
    "it": [
      "Insediato sulla place Bellecour, questo ristorante dall'atmosfera cordiale con 100 coperti è una sapiente combinazione tra uno spirito da Brasserie e un'anima da Ristorante, e dispone di un bello spazio all'aperto nella bella stagione."
    ],
    "fr": [
      "Implanté place Bellecour, ce restaurant à l’ambiance chaleureuse de 100 couverts, est un savant mélange de l’esprit “brasserie” et “restaurant” et dispose d’une belle terrasse ouverte aux beaux jours."
    ],
    "es": [
      "Este restaurante de atmósfera cálida con capacidad para 100 personas, situado en Place Bellecour, es una sabia mezcla entre \"brasserie” y \"restaurante\" y dispone de una hermosa terraza abierta durante el buen tiempo."
    ],
    "nl": [
      "Dit restaurant, gelegen aan de Place Bellecour, heeft een warme sfeer met 100 plaatsen en is een slimme mix van \"brasserie\" en \"restaurant\". Het heeft een prachtig terras dat bij mooi weer open is."
    ]
  },
