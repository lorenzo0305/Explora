  "rdfs:comment": {
    "de": [
      "Das Kunst- oder Showfechten ist eine Disziplin, die sowohl sportlich als auch kulturell geprägt ist.\r\nDazu gehören der Umgang mit Waffen, die Gestaltung von Kostümen und die Freude an der Bühne."
    ],
    "en": [
      "Artistic fencing is both a sporting and a cultural discipline.\r\nIt involves weapon handling, costume design and the enjoyment of the stage."
    ],
    "it": [
      "La scherma artistica o performativa è una disciplina sia sportiva che culturale.\r\nComprende il maneggio delle armi, la progettazione dei costumi e la fruizione del palcoscenico."
    ],
    "fr": [
      "L'escrime artistique ou de spectacle est une discipline à la fois sportive et culturelle.\r\nCela implique le maniement des armes, la conception des costumes et le plaisir de la scène."
    ],
    "es": [
      "La esgrima artística o de espectáculo es una disciplina tanto deportiva como cultural.\r\nImplica el manejo de las armas, el diseño del vestuario y el disfrute del escenario."
    ],
    "nl": [
      "Artistiek of show schermen is zowel een sportieve als culturele discipline.\r\nHet gaat om het hanteren van wapens, het ontwerpen van kostuums en het genieten van het podium."
    ]
  },
