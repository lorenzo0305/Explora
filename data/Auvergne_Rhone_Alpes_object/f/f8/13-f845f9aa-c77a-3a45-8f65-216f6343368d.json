  "rdfs:comment": {
    "de": [
      "Bei diesem Spiel mit einem Laserpointer-Zielfernrohr geht es darum, Punkte zu erzielen, indem man auf andere Teilnehmer zielt. Die Spiele finden im Freien statt und dauern 30 Minuten."
    ],
    "en": [
      "Equipped with a laser pointer sight, this game of confrontation consists of scoring points by aiming at other participants. Games take place outdoors and last 30 minutes."
    ],
    "it": [
      "Dotato di un mirino laser, questo gioco di scontro consiste nel segnare punti mirando agli altri partecipanti. Le partite si svolgono all'aperto e durano 30 minuti."
    ],
    "fr": [
      "Équipé d’un viseur à pointeur laser, ce jeu d’affrontement consiste à marquer des points en visant les autres participants,. Les matchs se déroulent en extérieur, la durée de la  partie dure 30 minutes."
    ],
    "es": [
      "Equipado con una mira de puntero láser, este juego de enfrentamiento consiste en anotar puntos apuntando a los demás participantes. Los partidos tienen lugar al aire libre y duran 30 minutos."
    ],
    "nl": [
      "Dit confrontatiespel is uitgerust met een laseraanwijzer en bestaat uit het scoren van punten door op de andere deelnemers te richten. De wedstrijden vinden buiten plaats en duren 30 minuten."
    ]
  },
  "rdfs:label": {
