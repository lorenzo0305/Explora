  "rdfs:comment": {
    "de": [
      "1 Orientierungslauf mit Start im Dorf Coltines. 7 Markierungen. Karte zum Herunterladen oder in den Fremdenverkehrsbüros erhältlich. Denken Sie daran, einen Kompass mitzunehmen."
    ],
    "en": [
      "1 orienteering course starting from the village of Coltines. 7 markers. Map available to download or from tourist offices. Don't forget your compass."
    ],
    "it": [
      "1 percorso di orienteering con partenza dal villaggio di Coltines. 7 segnalatori. Mappa scaricabile o disponibile presso gli uffici turistici. Ricordarsi di portare una bussola."
    ],
    "fr": [
      "1 parcours d'orientation au départ du village de Coltines. 7 balises. Carte en téléchargement ou disponible auprès des offices de tourisme. Pensez à prendre une boussole."
    ],
    "es": [
      "1 recorrido de orientación a partir del pueblo de Coltines. 7 balizas. Mapa disponible para descargar o en las oficinas de turismo. No olvide llevar una brújula."
    ],
    "nl": [
      "1 oriëntatieloop vanaf het dorp Coltines. 7 markeringen. Kaart beschikbaar om te downloaden of bij de toeristenbureaus. Vergeet niet een kompas mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation de Coltines \"le Bourg\""
    ]
  },
