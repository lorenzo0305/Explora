  "rdfs:comment": {
    "de": [
      "Rundgang Wo sind die Frauen? Vom Modell zum Künstler, vom 16. bis zum 21. Jahrhundert: Diese Führung bietet einen Überblick über die Rolle der Frauen in den Werken des Museums. Ab 12 Jahren"
    ],
    "en": [
      "Where are the women? From model to artist, from the 16th to the 21st century, this tour explores the place of women in the museum?s works. Ages 12 and up"
    ],
    "it": [
      "Dove sono le donne? Dalla modella all'artista, dal XVI al XXI secolo, questo tour analizza il posto delle donne nelle opere del museo. Dai 12 anni in su"
    ],
    "fr": [
      "Visite Où sont les femmes ? De modèle à artiste, du 16e au 21e siècle, cette visite propose un tour d’horizon de la place des femmes dans les œuvres du musée. Dès 12 ans"
    ],
    "es": [
      "¿Dónde están las mujeres? De modelo a artista, del siglo XVI al XXI, este recorrido examina el lugar de la mujer en las obras del museo. A partir de 12 años"
    ],
    "nl": [
      "Waar zijn de vrouwen? Van model tot kunstenaar, van de 16e tot de 21e eeuw, deze rondleiding gaat over de plaats van vrouwen in de werken van het museum. Vanaf 12 jaar"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite commentée \"Où sont les femmes ?\""
    ]
  },
