  "rdfs:comment": {
    "de": [
      "Die Galerie nationale du design wird im Juni 2026 eröffnet.\r\nDieser in Frankreich einzigartige Ort wird jährliche Ausstellungen präsentieren, die von einem Gastkurator anhand von Objekten aus den öffentlichen Sammlungen Frankreichs konzipiert werden."
    ],
    "en": [
      "The Galerie nationale du design will open its doors in June 2026.\r\nThis first-of-its-kind venue in France will present annual exhibitions designed by a guest curator using objects from French public collections."
    ],
    "it": [
      "La Galerie nationale du design aprirà le sue porte nel giugno 2026.\r\nQuesta sede, prima nel suo genere in Francia, presenterà mostre annuali progettate da un curatore ospite che utilizzerà oggetti provenienti da collezioni pubbliche francesi."
    ],
    "fr": [
      "La Galerie nationale du design ouvrira ses portes en juin 2026.\r\nCe lieu inédit en France, présentera des expositions annuelles conçues par un commissaire invité à partir d’objets issus des collections publiques françaises."
    ],
    "es": [
      "La Galerie nationale du design abrirá sus puertas en junio de 2026.\r\nEste espacio inédito en Francia presentará exposiciones anuales diseñadas por un comisario invitado a partir de objetos procedentes de colecciones públicas francesas."
    ],
    "nl": [
      "De Galerie nationale du design opent haar deuren in juni 2026.\r\nDeze unieke locatie in Frankrijk zal jaarlijks tentoonstellingen presenteren die worden ontworpen door een gastcurator met objecten uit Franse openbare collecties."
    ]
  },
  "rdfs:label": {
