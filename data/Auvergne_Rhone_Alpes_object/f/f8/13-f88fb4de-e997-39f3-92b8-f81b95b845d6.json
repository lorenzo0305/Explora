  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist auf regionale Küche spezialisiert : hechtklöße"
    ],
    "en": [
      "La Renaissance is a bistro very much in the Parisian style with a warm and friendly atmosphere that can welcome up to 45 dinners and is located in the very heart of Oyonnax."
    ],
    "it": [
      "La Renaissance, con il suo ambiente da bistrot parigino, vi accoglie in un'atmosfera amichevole. Il menu tradizionale e creativo fatto in casa è cucinato con prodotti freschi e di stagione."
    ],
    "fr": [
      "La Renaissance, au cadre de bistrot parisien, vous accueille dans une ambiance conviviale. La carte au label fait-maison, traditionnelle et créative est cuisinée avec les produits frais et de saison."
    ],
    "nl": [
      "La Renaissance, met zijn Parijse bistro, verwelkomt u in een vriendelijke sfeer. Het traditionele en creatieve huisgemaakte menu wordt bereid met verse en seizoensgebonden producten."
    ],
    "es": [
      "La Renaissance, con su ambiente de bistró parisino, le da la bienvenida en un ambiente acogedor. El menú casero, tradicional y creativo, se elabora con productos frescos y de temporada."
    ]
  },
