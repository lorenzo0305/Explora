  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/78e6f7c4-b916-3e55-a47c-2644ccdcc413",
      "dc:description": {
        "de": [
          "Samstag, 14. Februar\n------------------------------------------------\nOrganisiert von der Animationsabteilung der Stadt Merlimont\n\nFinden Sie die 5 versteckten Herzen, die in der ganzen Gemeinde verteilt sind\nZahlreiche Preise zu gewinnen!\nDie Spielregeln finden Sie auf den sozialen Netzwerken der Stadt Merlimont\nFür alle offen\nKostenlos\n\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Saturday, February 14th\n------------------------------------------------\nOrganized by the Merlimont entertainment department\n\nFind the 5 hidden hearts scattered around the town\nLots of prizes to be won!\nFind the rules of the game on Merlimont's social networks\nOpen to all\nFree\n\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Sabato 14 febbraio\n------------------------------------------------\nOrganizzato dall'ufficio eventi della città di Merlimont\n\nTrova i 5 cuori nascosti sparsi per la città\nTanti premi in palio!\nTrovate le regole del gioco sui social network della città di Merlimont\nAperto a tutti\nGratuito\n\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Samedi 14 février\n------------------------------------------------\nOrganisée par le service animation de la ville Merlimont\n\nRetrouver les 5 coeurs cachés dissumulés dans toute la commune\nDe nombreux lots à gagner !\nRetrouver les règles du jeu sur les réseaux sociaux de la ville de Merlimont\nOuvert à tous\nGratuit\n\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Zaterdag 14 februari\n------------------------------------------------\nGeorganiseerd door de dienst evenementen van de stad Merlimont\n\nVind de 5 verborgen harten verspreid over de stad\nTal van prijzen te winnen!\nOntdek de spelregels op de sociale netwerken van de stad Merlimont\nVoor iedereen toegankelijk\nGratis\n\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Sábado 14 de febrero\n------------------------------------------------\nOrganizado por el departamento de eventos de la ciudad de Merlimont\n\nEncuentra los 5 corazones escondidos repartidos por la ciudad\nMuchos premios\nEncuentra las reglas del juego en las redes sociales de la ciudad de Merlimont\nAbierto a todos\nGratis\n\nCRÉDITO DE LA FOTO: Freepik.com"
        ]
      },
