  "rdfs:comment": {
    "de": [
      "Le Coin de la Rue, Bar, Lebensmittelgeschäft, Restaurant, empfängt Sie mittwochs bis samstags zum Mittagessen und freitags und sonntags zum Abendessen. Hausgemachte Küche. Frösche. Kalbskopf am ersten Donnerstag des Monats. Reservierung empfohlen."
    ],
    "en": [
      "Le Coin de la Rue, bar, grocery store, restaurant, welcomes you for lunch from Wednesday to Saturday and for dinner on Friday and Sunday. Home cooking. Frogs. Tête de veau on the first Thursday of the month. Reservations recommended."
    ],
    "it": [
      "Le Coin de la Rue, bar, negozio di alimentari, ristorante, vi accoglie a pranzo dal mercoledì al sabato e a cena il venerdì e la domenica. Cucina casalinga. Rane. Tête de veau il primo giovedì del mese. Si consiglia la prenotazione."
    ],
    "fr": [
      "Le Coin de la Rue, bar, épicerie, restaurant, vous accueille pour déjeuner du mercredi au samedi et pour diner le vendredi et dimanche. Cuisine maison. Grenouilles. Tête de veau le premier jeudi du mois. Réservation conseillée."
    ],
    "es": [
      "Le Coin de la Rue, bar, tienda de ultramarinos, restaurante, le recibe para almorzar de miércoles a sábado y para cenar los viernes y domingos. Cocina casera. Ranas. Tête de veau el primer jueves del mes. Se recomienda reservar."
    ],
    "nl": [
      "Le Coin de la Rue, bar, kruidenierswinkel, restaurant, verwelkomt je voor de lunch van woensdag tot zaterdag en voor het diner op vrijdag en zondag. Thuis koken. Kikkers. Tête de veau op de eerste donderdag van de maand. Reserveren aanbevolen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Coin de la Rue"
    ]
  },
