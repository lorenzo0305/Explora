  "rdfs:comment": {
    "de": [
      "Das Hotel verfügt über renovierte Zimmer. Außerdem bietet es ein Restaurant, das jeden Tag mittags und abends für Hotelgäste und Durchreisende geöffnet ist."
    ],
    "en": [
      "Renovated rooms. It also offers a restaurant open every day for lunch and dinner catering for hotel guests and visitors."
    ],
    "it": [
      "L'hotel dispone di camere rinnovate. Inoltre, offre un ristorante aperto tutti i giorni, a pranzo e a cena, per gli ospiti e i visitatori dell'hotel."
    ],
    "fr": [
      "L'hôtel dispose de chambres rénovées. Aussi, il propose une restauration ouverte tous les jours, midi et soir pour les clients de l'hôtel et les personnes de passage."
    ],
    "es": [
      "Hotel con habitaciones equipada. El hotel está equipado con aire acondicionada y dispone de acceso wifi. El restaurante está abierto todos los días, mediodía y noche, para los clientes del hotel y de fuera."
    ],
    "nl": [
      "Het hotel heeft gerenoveerde kamers. Het biedt ook een restaurant dat elke dag open is voor lunch en diner voor hotelgasten en bezoekers."
    ]
  },
