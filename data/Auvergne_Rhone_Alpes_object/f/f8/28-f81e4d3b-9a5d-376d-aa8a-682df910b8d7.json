  "rdfs:comment": {
    "de": [
      "Le Terrier bietet Ihnen eine typisch regionale und qualitativ hochwertige Küche, die Tradition und Moderne verbindet.\nDie Speisekarte bietet hausgemachte Gerichte, die aus frischen Produkten zusammengestellt werden."
    ],
    "en": [
      "Le Terrier offers a typical regional cuisine of quality that combines tradition and modernity.\nThe menu proposes home-made dishes concocted from fresh products."
    ],
    "it": [
      "Le Terrier offre una cucina tipica regionale di qualità che unisce tradizione e modernità.\nIl menu offre piatti fatti in casa con prodotti freschi."
    ],
    "fr": [
      "Le Terrier vous propose une cuisine typiquement régionale et de qualité qui combine tradition et modernité.\nLa carte propose des plats faits-maison concoctés à partir de produits frais."
    ],
    "es": [
      "Le Terrier ofrece una cocina típica regional de calidad que combina tradición y modernidad.\nEl menú ofrece platos caseros elaborados con productos frescos."
    ],
    "nl": [
      "Le Terrier biedt een typische regionale keuken van kwaliteit die traditie en moderniteit combineert.\nOp het menu staan huisgemaakte gerechten van verse producten."
    ]
  },
