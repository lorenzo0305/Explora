  "rdfs:comment": {
    "de": [
      "Unser Hof liegt in Eurre im Tal der Drôme, auf einem Hügel und inmitten eines Waldes. Seit der Gründung im Jahr 2013 züchten wir Ziegen und Schweine."
    ],
    "en": [
      "It's in Eurre in the Drôme valley, at the top of a hill and in the middle of the forest, that our farm flourishes. Since its creation in 2013, we have been raising goats and pigs."
    ],
    "it": [
      "La nostra fattoria prospera a Eurre, nella valle della Drôme, su una collina in mezzo alla foresta. Dalla sua creazione nel 2013, alleviamo capre e maiali."
    ],
    "fr": [
      "C’est à Eurre dans la vallée de la Drôme, à la cime d’une colline et au milieu de la forêt, que notre ferme s’épanouit. Depuis sa création en 2013, nous élevons des chèvres et des cochons."
    ],
    "nl": [
      "Onze boerderij floreert in Eurre in de Drôme vallei, op een heuveltop midden in het bos. Sinds de oprichting in 2013 houden we geiten en varkens."
    ],
    "es": [
      "Nuestra granja florece en Eurre, en el valle de la Drôme, en lo alto de una colina en medio del bosque. Desde su creación en 2013, criamos cabras y cerdos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "De Ferme en Ferme : La Ferme Eurreuse"
    ]
  },
