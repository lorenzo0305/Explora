  "rdfs:comment": {
    "de": [
      "Willkommen in der Odyssee O! Eine brandneuer Erlebnispark von 3500m² für Sport, Entspannung und Erholung! Sportbecken, Spielbereich, Wellnessbereich, Fitnessraum... Für jeden eine passende Aktivität !"
    ],
    "en": [
      "Welcome to Odyssée O Water Park ! A brand-new 3,500m2  space for sport, relaxation and leisure! Swimming pool, fun area, well-being space and fitness centre. Activities to meet your needs."
    ],
    "it": [
      "Il centro acquatico Odyssée'O dispone di un'area acquatica con piscina sportiva, piscina per bambini e zona divertimento. C'è anche un'area benessere con sauna, hammam, jacuzzi, doccia massaggiante, bagno freddo e area fitness."
    ],
    "fr": [
      "Le centre aquatique l'Odyssée'O dispose d'un espace aquatique avec un bassin sportif, une pataugeoire et une zone ludique. Elle propose également un espace bien-être avec sauna, hammam, jacuzzi, douche massante, bain froid et un espace fitness."
    ],
    "nl": [
      "Welkom in «Odyssey O»! Een gloednieuwe sport-, ontspannings- en rijetijdszone \r\nvan 3500m²! Sportbad, speelterrein, wellnessruimte, fitnessruimte... Activiteiten die passen bij uw verlangens !"
    ],
    "es": [
      "El centro acuático Odyssée'O dispone de una zona acuática con piscina deportiva, piscina infantil y zona de diversión. También hay una zona de bienestar con sauna, hammam, jacuzzi, ducha de masajes, baño frío y zona de fitness."
    ]
  },
