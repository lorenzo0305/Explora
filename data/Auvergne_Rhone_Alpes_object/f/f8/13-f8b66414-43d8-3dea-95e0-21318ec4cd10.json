  "rdfs:comment": {
    "de": [
      "Es gibt viel zu entdecken: die lachenden Skulpturen von Pascal und die zeitgenössischen Wanddekorationen von Marie-Hélène.  Sie können nicht an ihrem Atelier vorbeigehen, vor der Tür thronen schöne ?uvres, die Sie einladen, ihre Ausstellung zu besuchen!"
    ],
    "en": [
      "Sculpture & Ceramics Workshop\r\nThere are two different styles of creations on offer at the 'Atelier du Pont du Diable':\r\nPascal makes humorous sandstone sculptures and Marie-Hélène creates ceramic paintings."
    ],
    "it": [
      "Non perdetevi le ridenti sculture di Pascal e le decorazioni murali contemporanee di Marie-Hélène.  Non perdetevi il loro studio, con alcune belle opere esposte fuori dalla porta, che vi invitano a visitare la loro mostra!"
    ],
    "fr": [
      "A découvrir : les sculptures rieuses de Pascal et les décorations murales contemporaines de Marie-Hélène.  Vous ne pourrez pas passer à côté de leur atelier, devant la porte trônent de belles œuvres qui vous invitent à visiter leur exposition !"
    ],
    "nl": [
      "Twee ambachtslieden die het ontdekken waard zijn: de humoristische beelden van Pascal en de keramische creaties van Marie-Helène. U kunt hun atelier niet mislopen, voor de deur staat een prachtig schaap dat door Pascal gemaakt is."
    ],
    "es": [
      "No te pierdas las risueñas esculturas de Pascal y las contemporáneas decoraciones murales de Marie-Hélène.  No querrás perderte su estudio, con unas preciosas obras expuestas en la puerta, ¡que te invitan a visitar su exposición!"
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Atelier du Pont du Diable"
    ],
    "fr": [
      "L'Atelier du Pont du Diable"
    ],
