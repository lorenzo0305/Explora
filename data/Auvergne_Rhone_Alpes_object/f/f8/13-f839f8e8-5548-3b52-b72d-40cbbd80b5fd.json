  "rdfs:comment": {
    "de": [
      "Der Ance du Nord ist ein symbolträchtiger Fluss im Osten des Zentralmassivs, vor allem wegen seiner großen Äschenpopulation, die viele Angler anzieht."
    ],
    "en": [
      "The Ance river is one of the most emblematic rivers in the Massif Central area.\r\nNew in 2011: it is compulsory to release fish that has been caught between the Roure bridge in St-Clément-de-Valorgue to the La Thiolière bridge in St-Romain."
    ],
    "it": [
      "L'Ance du Nord è un fiume emblematico del Massiccio Centrale orientale, in particolare grazie alla sua grande popolazione di temoli, che attira molti pescatori."
    ],
    "fr": [
      "L’Ance du Nord est une rivière emblématique de l’est du Massif Central, notamment grâce à son importante population d’ombres communs qui attire de nombreux pêcheurs."
    ],
    "es": [
      "El Ance du Nord es un río emblemático del Macizo Central oriental, en particular gracias a su gran población de tímalo común, que atrae a muchos pescadores."
    ],
    "nl": [
      "De Ance du Nord is een emblematische rivier in het oosten van het Centraal Massief, met name dankzij de grote populatie vlagzalm, die veel vissers aantrekt."
    ]
  },
  "rdfs:label": {
