  "rdfs:comment": {
    "de": [
      "Die Kirche wurde 1861 an der Stelle einer alten Kirche erbaut und liegt höher als das Dorf\r\nIhr Architekt war damals Alfred Berruyer, ein Schüler von Viollet-le-Duc."
    ],
    "en": [
      "The church stands above the village where it was built in 1861 on the site of the previous one.\r\nThe architect was Alfred Berruyer, who was taught by Viollet-le-Duc."
    ],
    "it": [
      "Costruita nel 1861, sul sito di una precedente chiesa, è situata in alto rispetto al villaggio\r\nIl suo architetto era Alfred Berruyer, allievo di Viollet-le-Duc."
    ],
    "fr": [
      "Construite en 1861, sur l'emplacement d'une ancienne église, elle est située en hauteur par rapport au village. \r\nSon architecte est alors Alfred Berruyer, élève de Viollet-le-Duc."
    ],
    "nl": [
      "Gebouwd in 1861, op de plaats van een voormalige kerk, ligt het hoog boven het dorp\r\nDe architect was Alfred Berruyer, een leerling van Viollet-le-Duc."
    ],
    "es": [
      "Construido en 1861, en el emplazamiento de una antigua iglesia, está situado en lo alto del pueblo\r\nSu arquitecto fue Alfred Berruyer, alumno de Viollet-le-Duc."
    ]
  },
