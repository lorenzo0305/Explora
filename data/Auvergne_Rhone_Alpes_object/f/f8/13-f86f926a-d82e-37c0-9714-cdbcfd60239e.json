          "additionalInformation": {
            "de": [
              "Außerordentliche Öffnungszeiten:\r\n- Montag, den 23. Februar und 2. März 2026, von 11.00 bis 13.00 Uhr.\r\n\r\nFalls Sie ein Buch außerhalb der Öffnungszeiten zurückgeben müssen, wenden Sie sich bitte an das gegenüberliegende Rathaus, das seine eigenen Öffnungszeiten hat."
            ],
            "en": [
              "Special opening hours:\r\n- Mondays, February 23 and March 2, 2026, from 11am to 1pm.\r\n\r\nIf you need to return a book outside opening hours, please contact the Town Hall, opposite, during its own opening hours."
            ],
            "it": [
              "Apertura straordinaria:\r\n- Lunedì 23 febbraio e 2 marzo 2026, dalle 11.00 alle 13.00.\r\n\r\nSe avete bisogno di restituire un libro al di fuori degli orari di apertura, rivolgetevi al Municipio, di fronte, durante i suoi orari di apertura."
            ],
            "fr": [
              "Ouverture exceptionnelle :\r\n- Les lundis 23 février et 2 mars 2026, de 11h à 13h.\r\n\r\nSi besoin de rendre un livre en-dehors des heures d'ouverture, s'adresser à la mairie, située en face, à ses propres heures d'ouverture."
            ],
            "nl": [
              "Speciale openingstijden:\r\n- Maandag 23 februari en 2 maart 2026, van 11.00 tot 13.00 uur.\r\n\r\nAls je een boek buiten de openingstijden wilt inleveren, neem dan contact op met het stadhuis, aan de overkant, tijdens de eigen openingstijden."
            ],
            "es": [
              "Horario especial de apertura:\r\n- Lunes 23 de febrero y 2 de marzo de 2026, de 11.00 a 13.00 horas.\r\n\r\nSi necesita devolver un libro fuera del horario de apertura, póngase en contacto con el Ayuntamiento, enfrente, en su propio horario de apertura."
            ]
          },
