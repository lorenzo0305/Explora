  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek von Mijoux ist an drei Tagen in der Woche am späten Nachmittag geöffnet. Sie befindet sich gegenüber dem Rathaus. Sie steht jedem Publikum offen."
    ],
    "en": [
      "The Mijoux municipal library is open three days a week, in the late afternoon. It is located opposite the town hall. Open to all."
    ],
    "it": [
      "La biblioteca comunale di Mijoux è aperta tre giorni alla settimana, nel tardo pomeriggio. Si trova di fronte al municipio. Aperto a tutti."
    ],
    "fr": [
      "La bibliothèque municipale de Mijoux est ouverte trois jours par semaine, en fin d'après-midi. Elle est située en face de la mairie. Ouverte à tout public."
    ],
    "es": [
      "La biblioteca municipal de Mijoux está abierta tres días a la semana, a última hora de la tarde. Se encuentra frente al ayuntamiento. Abierto a todos."
    ],
    "nl": [
      "De gemeentelijke bibliotheek van Mijoux is drie dagen per week geopend, in de late namiddag. Het ligt tegenover het stadhuis. Open voor iedereen."
    ]
  },
