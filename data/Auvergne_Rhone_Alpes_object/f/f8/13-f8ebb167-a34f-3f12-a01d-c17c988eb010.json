  "rdfs:comment": {
    "de": [
      "Pädagogische und therapeutische Besuche: ein zauberhafter Ausflug! Ziehen Sie Ihre Stiefel an und stoßen Sie die Tür der Ferme du Clos auf. Tauchen Sie in die Bio-Landwirtschaft ein, kommen Sie in Kontakt mit zahlreichen Tieren und entdecken Sie die Natur, die Sie umgibt!"
    ],
    "en": [
      "Educational and therapeutic visits: an enchanted escapade! Put on your boots and push open the door of the Ferme du Clos, immerse yourself in the organic farming activity in contact with many animals and discover the nature that surrounds you!"
    ],
    "it": [
      "Visite educative e terapeutiche: un'evasione incantata! Indossate gli stivali e aprite la porta della Ferme du Clos, immergetevi nell'attività agricola biologica a contatto con numerosi animali e scoprite la natura che vi circonda!"
    ],
    "fr": [
      "Visites pédagogique et thérapeutique : une escapade enchantée ! Chaussez vos bottes et poussez la porte de la Ferme du Clos, immergez-vous dans l'activité agricole bio au contact de nombreux animaux et découvrez la nature qui vous entoure !"
    ],
    "es": [
      "Visitas educativas y terapéuticas: ¡una escapada encantada! Póngase las botas y abra la puerta de la Ferme du Clos, sumérjase en la actividad agrícola ecológica en contacto con numerosos animales y descubra la naturaleza que le rodea"
    ],
    "nl": [
      "Educatieve en therapeutische bezoeken: een betoverende escapade! Trek uw laarzen aan en duw de deur van de Ferme du Clos open, dompel u onder in de biologische landbouwactiviteit in contact met talrijke dieren en ontdek de natuur die u omringt!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme du Clos"
    ]
  },
