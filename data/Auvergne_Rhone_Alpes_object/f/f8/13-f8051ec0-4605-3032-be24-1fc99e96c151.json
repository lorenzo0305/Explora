  "rdfs:comment": {
    "de": [
      "Freizeitzentrum an einem angelegten See im Massif de la Maurienne.\r\nST REMY DE MAURIENNE: Blauer See mit beaufsichtigtem Badebetrieb im Juli und August.\r\nVerleih von Paddel- und Tretbooten im Juli und August."
    ],
    "en": [
      "Make the most of the lovely summer days by swimming in a safe area with lifeguard and relax by the water's edge.\r\nST REMY DE MAURIENNE: swimming with lifeguard in the Lac Bleu in July and August."
    ],
    "it": [
      "Centro ricreativo ai bordi di un lago paesaggistico nel massiccio della Maurienne.\r\nST REMY DE MAURIENNE: lago blu con balneazione controllata in luglio e agosto.\r\nNoleggio di pedalò e pagaie in luglio e agosto."
    ],
    "fr": [
      "Base de loisirs au bord d'un lac aménagé situé dans le massif de la Maurienne.\r\nST REMY DE MAURIENNE : lac bleu baignade surveillée en juillet et août.\r\nLocation paddle et pédalos en juillet et août."
    ],
    "nl": [
      "Recreatiecentrum aan de rand van een aangelegd meer in het Maurienne-massief.\r\nST REMY DE MAURIENNE: blauw meer met zwemmen onder toezicht in juli en augustus.\r\nPeddel- en waterfietsverhuur in juli en augustus."
    ],
    "es": [
      "Centro de ocio al borde de un lago ajardinado en el macizo de Maurienne.\r\nST REMY DE MAURIENNE: lago azul con baño vigilado en julio y agosto.\r\nAlquiler de remos y pedalós en julio y agosto."
    ]
  },
  "rdfs:label": {
    "en": [
      "Base de Loisirs du Lac Bleu"
    ],
    "fr": [
      "Base de Loisirs du Lac Bleu"
    ]
  },
