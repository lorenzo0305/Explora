  "rdfs:comment": {
    "de": [
      "Cédric Grondin ist ein leidenschaftlicher Koch und entführt Sie mit seinen raffinierten Gerichten auf die Insel Réunion. Mittags bietet Ihnen das Grand-Ilet eine Küche, die gleichzeitig reunionesisch und traditionell ist."
    ],
    "en": [
      "Passionate about cooking, Cedric Gondrin will take you on a trip to the Reunion Island through his refined cooking. At lunch time, the Grand Ilet restaurant offers both Reunion and traditional French cooking."
    ],
    "it": [
      "Cédric Grondin è un vero appassionato di cucina e vi porterà in viaggio nell'Isola della Riunione con i suoi piatti raffinati. All'ora di pranzo, il Grand-Ilet offre una cucina tradizionale e reunionese."
    ],
    "fr": [
      "Véritable passionné de cuisine, Cédric Grondin vous fait voyager à la Réunion par ses mets raffinés. Le midi, le Grand-Ilet vous propose une cuisine à la fois Réunionnaise et Traditionnelle."
    ],
    "nl": [
      "Cédric Grondin is een echte kookliefhebber en neemt u met zijn verfijnde gerechten mee naar het eiland Réunion. Tijdens de lunch biedt het Grand-Ilet zowel Reunionese als traditionele gerechten."
    ],
    "es": [
      "Cédric Grondin es un auténtico apasionado de la cocina y le hará viajar a la isla de la Reunión con sus refinados platos. A la hora de comer, el Grand-Ilet ofrece tanto cocina reunionense como tradicional."
    ]
  },
