  "rdfs:comment": {
    "de": [
      "Im Dekor eines savoyischen Bauernhofs bietet Ihnen das Névé Crêpes, Galettes, Spezialitäten aus den Bergen und eine Fondue-Gondel. Am Nachmittag können Sie auf der Terrasse süße und herzhafte Crêpes, Fondue/Raclette genießen. Tartiflette zum Mitnehmen auf Anfrage."
    ],
    "en": [
      "In its charming Savoyard farmhouse setting, Le Névé offers crêpes, galettes, mountain specialties, and its unique “fondue cable car.”\r\nIn the afternoon, the south-facing terrace welcomes you with crêpes and galettes served all day long.\r\nTartiflette available to take away upon request."
    ],
    "it": [
      "Situato in una fattoria savoiarda, Le Névé offre crêpes, galettes, specialità di montagna e una gondola per la fonduta. Nel pomeriggio, godetevi la terrazza con crêpes dolci e salate e fondue/raclette. Tartiflette da asporto su richiesta."
    ],
    "fr": [
      "Dans son décor de ferme savoyarde, le Névé vous propose ses crêpes, galettes, spécialités montagnardes et sa télécabine à fondue. L'après-midi, profitez de la terrasse avec crêpes salées et sucrées, fondue/raclette. Tartiflette à emporter sur demande."
    ],
    "es": [
      "Situado en una granja saboyana, Le Névé ofrece crêpes, galettes, especialidades de montaña y una fondue góndola. Por la tarde, disfrute de la terraza con crêpes dulces y salados y fondue/raclette. Tartiflette para llevar previa petición."
    ],
    "nl": [
      "Le Névé is gevestigd in een Savoyaardse boerderij en biedt crêpes, galettes, bergspecialiteiten en een fonduegondel. Geniet 's middags op het terras van zoete en hartige crêpes en fondue/raclette. Tartiflette om mee te nemen op aanvraag."
    ]
  },
  "rdfs:label": {
