  "rdfs:comment": {
    "de": [
      "Das ehemalige Theater, das sich heute in Gemeindebesitz befindet, wurde von Leonard Racle in einem Lagerhaus eingerichtet und 1776 in Anwesenheit des Schauspielers Le Kain eingeweiht."
    ],
    "en": [
      "Today owned by the town, the former theater was built in a warehouse by Léonard Racle and inaugurated in 1776 in the presence of the actor Le Kain."
    ],
    "it": [
      "Oggi di proprietà del Comune, l'antico teatro fu costruito in un magazzino da Léonard Racle e inaugurato nel 1776 alla presenza dell'attore Le Kain."
    ],
    "fr": [
      "Aujourd’hui propriété communale, l'ancien théâtre fut aménagé dans un entrepôt par Léonard Racle et inauguré en 1776 en présence du comédien Le Kain."
    ],
    "nl": [
      "Het voormalige theater, dat nu eigendom is van de gemeente, werd gebouwd in een pakhuis door Léonard Racle en ingehuldigd in 1776 in aanwezigheid van de acteur Le Kain."
    ],
    "es": [
      "El antiguo teatro, hoy propiedad municipal, fue construido en un almacén por Léonard Racle e inaugurado en 1776 en presencia del actor Le Kain."
    ]
  },
