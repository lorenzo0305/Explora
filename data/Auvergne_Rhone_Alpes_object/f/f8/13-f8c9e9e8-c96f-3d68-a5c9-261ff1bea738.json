  "rdfs:comment": {
    "de": [
      "Die kleine Bibliothek befindet sich im Herzen des Dorfes Saint-Nicolas de Véroce. Sie werden herzlich von den ehrenamtlichen Mitarbeitern empfangen, die Ihnen eine Auswahl an Büchern empfehlen, sich mit Ihnen austauschen und Ihnen ihre Favoriten mitteilen können"
    ],
    "en": [
      "At the small library in Saint-Nicolas, a friendly team of volunteers are on site to advise you in your choice of reading and share their favourite books."
    ],
    "it": [
      "“La petite Bibliothèque” (la piccola biblioteca) si trova in pieno centro a SaintNicolas-de-Véroce. Il nostro accogliente personale di volontari potrà darvi consigli di lettura, confrontarsi e condividere con voi i loro libri preferiti."
    ],
    "fr": [
      "La petite Bibliothèque est située en plein cœur du village de Saint-Nicolas de Véroce. Vous serez reçus chaleureusement par l’équipe de bénévoles qui pourront vous conseiller un choix de lecture, échanger avec vous et vous transmettre leurs coups de cœur"
    ],
    "nl": [
      "La petite Bibliothèque ligt in het hart van het dorp Saint-Nicolas de Véroce. Je wordt er hartelijk ontvangen door het team van vrijwilligers, die je kunnen adviseren bij je keuze van leesmateriaal, een praatje met je kunnen maken en hun favorieten met je kunnen delen"
    ],
    "es": [
      "La petite Bibliothèque está situada en el corazón del pueblo de Saint-Nicolas de Véroce. El equipo de voluntarios le dará una calurosa bienvenida y podrá aconsejarle sobre la elección del material de lectura, charlar con usted y compartir sus favoritos"
    ]
  },
