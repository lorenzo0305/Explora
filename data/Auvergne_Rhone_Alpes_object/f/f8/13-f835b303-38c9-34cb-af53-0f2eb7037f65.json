  "rdfs:comment": {
    "de": [
      "Printemps des Poètes Liberté -fore vice déployée à la Suchère . 14 Uhr Start des Spaziergangs, Schreiben eines Wandergedichts, 15 Uhr Crêpes (ein Gourmet-Braun) und Wiedergabe des Gedichts, 16 Uhr Märchen mit der Compagnie Konsl?diz. Kostenlos"
    ],
    "en": [
      "Printemps des Poètes Liberté -fore vice deployed at La Suchère . 2pm start of the walk, writing of a travelling poem, 3pm crêpes (a brown gourmet) and poetry reading, 4pm storytelling with the Konsl?diz company. Free"
    ],
    "it": [
      "Printemps des Poètes Liberté -prima vice schierata a la Suchère. ore 14.00 inizio della passeggiata, stesura di una poesia itinerante, ore 15.00 crêpes e lettura di poesie, ore 16.00 narrazione con la compagnia Konsl?diz. Gratuito"
    ],
    "fr": [
      "Printemps des Poètes Liberté -fore vice déployée à la Suchère . 14h départ de la balade , écriture d’une poésie itinérante, 15h crêpes (un brun gourmand) et restitution de la poésie, 16h conte avec la compagnie Konsl’diz. Gratuit"
    ],
    "es": [
      "Printemps des Poètes Liberté -antes vicio desplegado en la Suchère . a las 14.00 h, inicio de la marcha, escritura de un poema viajero, a las 15.00 h, crepes y lectura de poemas, a las 16.00 h, cuentacuentos con la compañía Konsl?diz. Gratis"
    ],
    "nl": [
      "Printemps des Poètes Liberté - voor ondeugd ingezet op la Suchère . 14u start van de wandeling, schrijven van een reisgedicht, 15u crêpes (een bruine gourmet) en poëzielezing, 16u verhalen vertellen met het gezelschap Konsl?diz. Gratis"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade poétique, conte et gourmandises"
    ]
  },
