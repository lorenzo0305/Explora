  "rdfs:comment": {
    "de": [
      "Kollektion von Korsettbustiers. Einzigartige Stücke. Kreationen aus handwerklicher Fertigung.\r\nCouture-Kreationen - Röcke aus Wax, Gürtel aus Liberty, Armbänder und Halsketten aus Seide, Schmuck aus Edelstahl und Seide."
    ],
    "en": [
      "Collection of corseted bustiers. Unique pieces. Artisanal creations.\r\nCouture creations - wax skirts, Liberty belts."
    ],
    "it": [
      "Collezione di bustier con corsetto. Pezzi unici. Creazioni artigianali.\nCreazioni couture - gonne di cera, cinture Liberty, bracciali e collane di seta, gioielli in acciaio inossidabile, perle di vetro bohémien, cristallo e seta."
    ],
    "fr": [
      "Collection de bustiers corsetés. Pièces uniques. Créations artisanale.\nCréations couture - jupes en wax, ceintures en Liberty, bracelets et colliers en soie, bijoux en acier inoxydable, perles en verre de bohème, cristal et soie."
    ],
    "nl": [
      "Collectie bustiers met korsetten. Unieke stukken. Ambachtelijke creaties.\r\nCouture creaties - wax rokken, Liberty riemen."
    ],
    "es": [
      "Colección de bustiers encorsetados. Piezas únicas. Creaciones artesanales.\nCreaciones de alta costura: faldas de cera, cinturones Liberty, pulseras y collares de seda, joyas de acero inoxidable, cuentas de cristal bohemio, cristal y seda."
    ]
  },
