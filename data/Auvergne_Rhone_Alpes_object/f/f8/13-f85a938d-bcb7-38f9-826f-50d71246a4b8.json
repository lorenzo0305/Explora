  "rdfs:comment": {
    "de": [
      "Gourmetpause in der Boutique Mauricette in the Sky, sie empfängt Sie, um Ihnen die besten Produkte aus Savoyen anzubieten, die Sie vor Ort (drinnen und auf der Terrasse) genießen oder mitnehmen können."
    ],
    "en": [
      "Take a gourmet break at the Mauricette in the Sky shop, where you'll find the very best Savoy products to enjoy on the premises (inside and on the terrace) or to take away."
    ],
    "it": [
      "Fate una pausa gastronomica nel negozio Mauricette in the Sky, dove troverete i migliori prodotti della Savoia da gustare in loco (all'interno e sulla terrazza) o da portare via."
    ],
    "fr": [
      "Pause gourmande à  la boutique Mauricette in the Sky, elle vous accueil pour vous offrir le meilleur des produits de Savoie à savourer sur place (intérieur et terrasse) ou à emporter."
    ],
    "nl": [
      "In de winkel Mauricette in the Sky vind je de beste producten uit de Savoie om ter plekke (binnen en op het terras) van te genieten of om mee te nemen."
    ],
    "es": [
      "Haga una pausa gastronómica en la tienda Mauricette in the Sky, donde encontrará los mejores productos de Saboya para degustar in situ (en el interior y en la terraza) o para llevar."
    ]
  },
