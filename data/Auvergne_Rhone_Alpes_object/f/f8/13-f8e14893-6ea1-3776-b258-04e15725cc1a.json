  "rdfs:comment": {
    "de": [
      "Les FLAM'en vert ist ein biologischer und pädagogischer Gemüsebauernhof. Produktion von Obst und Gemüse. Verkauf vor Ort jeden Donnerstag von 17:00 bis 18:30 Uhr und auf dem Markt in Belley am Samstagmorgen."
    ],
    "en": [
      "Les FLAM'en vert is an organic and educational vegetable farm. Production of fruits and vegetables. Sale on site every Thursday 5-6:30 pm and on the Belley market on Saturday morning."
    ],
    "it": [
      "Les FLAM?en vert è un'azienda agricola biologica e un orto didattico. Produzione di frutta e verdura. Vendita in loco ogni giovedì dalle 17 alle 18.30 e al mercato di Belley il sabato mattina."
    ],
    "fr": [
      "Les FLAM’en vert est une ferme maraîchère biologique et pédagogique. Production de fruits et légumes. Vente sur place tous les jeudis de 17h à 18h30 et sur le marché de Belley le samedi matin."
    ],
    "es": [
      "Les FLAM?en vert es una granja de huerta ecológica y educativa. Producción de frutas y hortalizas. Venta in situ todos los jueves de 17 a 18.30 horas y en el mercado de Belley el sábado por la mañana."
    ],
    "nl": [
      "Les FLAM'en vert is een biologische en educatieve tuinderij. Productie van groenten en fruit. Verkoop ter plaatse elke donderdag van 17 tot 18.30 uur en op de Belley-markt op zaterdagochtend."
    ]
  },
  "rdfs:label": {
