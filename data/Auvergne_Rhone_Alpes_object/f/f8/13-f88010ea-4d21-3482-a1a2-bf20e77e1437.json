  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes, auf der Straße zu den Grandes Alpes, am Fuße des Col de la Colombière, empfängt Sie das Hotel-Restaurant La Chartreuse das ganze Jahr über."
    ],
    "en": [
      "In the village, on the road to Les Grandes Alpes, the hotel-restaurant La Chartreuse welcomes you all year round."
    ],
    "it": [
      "Nel cuore del villaggio, sulla strada delle Grandes Alpes, ai piedi del Colombière, l'hotel-ristorante Chartreuse vi accoglie tutto l'anno."
    ],
    "fr": [
      "Au coeur du village, sur la route des Grandes Alpes, au pied du col de la Colombière, l'hôtel-restaurant la Chartreuse vous accueille tout au long de l'année."
    ],
    "nl": [
      "In het hart van het dorp, aan de weg van de Grandes Alpes, aan de voet van de Colombière-pas, ontvangt hotel-restaurant Chartreuse u het hele jaar door."
    ],
    "es": [
      "En el corazón del pueblo, en la carretera de los Grandes Alpes, al pie del puerto de la Colombière, el hotel-restaurante Chartreuse le da la bienvenida todo el año."
    ]
  },
