  "rdfs:comment": {
    "de": [
      "L'emporté empfängt Sie am Bahnhof von Aime La Plagne.\r\nHier gibt es Sandwiches, Süßes und warme oder kalte Getränke! \r\nHausgemacht und aus regionalen Produkten"
    ],
    "en": [
      "L'emporté welcomes you at the Aime La Plagne train station.\r\nSandwiches, sweets and hot or cold drinks!\r\nHomemade and made from local products"
    ],
    "it": [
      "L'emporté vi accoglie alla stazione ferroviaria di Aime La Plagne.\r\nPanini, dolci e bevande calde o fredde!\r\nFatti in casa e con prodotti locali"
    ],
    "fr": [
      "L'emporté vous accueille à la gare d'Aime La Plagne.\r\nDes sandwichs, du sucré et des boissons chaudes ou froides ! \r\nFait maison et à partir de produits du terroir"
    ],
    "es": [
      "L'emporté le da la bienvenida en la estación de tren de Aime La Plagne.\r\nBocadillos, dulces y bebidas frías o calientes\r\nElaboración casera y a partir de productos locales"
    ],
    "nl": [
      "L'Emporté heet u welkom op het station van Aime-la-Plagne. U vindt er broodjes, zoete snacks, warme en koele dranken! Huisgemaakt met streekproducten."
    ]
  },
  "rdfs:label": {
    "de": [
      "L'EMPORTÉ - Imbiss am Bahnhof Aime la Plagne"
    ],
    "fr": [
      "L'EMPORTÉ - snack gare Aime la Plagne"
    ],
    "nl": [
      "L'EMPORTÉ - snackbar station Aime-la-Plagne"
    ]
  },
