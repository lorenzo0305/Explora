  "rdfs:comment": {
    "de": [
      "Diese sieben Musiker hatten bei der Eröffnung der 45-Jahr-Feier des Jazz-Clubs im Theater für Begeisterung gesorgt. Nun sind sie wieder in unserem Keller, mit einer an die Räumlichkeiten angepassten Formel."
    ],
    "en": [
      "These seven musicians brought the house down when they opened the 45th anniversary of the Jazz-Club at the theater. Now they're back in our cellar, with a formula adapted to the venue."
    ],
    "it": [
      "Questi sette musicisti hanno fatto esplodere la casa in occasione dell'inaugurazione del 45° anniversario del Jazz-Club nel teatro. Ora sono tornati nella nostra cantina, con una formula adattata al locale."
    ],
    "fr": [
      "Ces sept musiciens avaient enflammé l'ouverture des 45 ans du Jazz-Club au théâtre. Les voilà de retour dans notre cave, avec une formule adaptée aux lieux."
    ],
    "es": [
      "Estos siete músicos arrasaron en la inauguración del 45 aniversario del Jazz-Club del teatro. Ahora vuelven a nuestro sótano, con una fórmula adaptada al local."
    ],
    "nl": [
      "Deze zeven muzikanten haalden het huis ondersteboven tijdens de opening van de 45e verjaardag van de Jazz-Club in het theater. Nu zijn ze terug in onze kelder, met een formule aangepast aan de zaal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Little Swing"
    ]
  },
