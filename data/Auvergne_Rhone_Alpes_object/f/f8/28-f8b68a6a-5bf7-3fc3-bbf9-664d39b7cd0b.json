  "rdfs:comment": {
    "de": [
      "Dieses Museum, das sich im Untergeschoss des Rathauses befindet, zeigt das Leben und die Geschichte der Stadt und ihrer Umgebung im Laufe der Jahrhunderte, von der Keltenzeit bis heute."
    ],
    "en": [
      "This museum, located at the basement entrance of the town hall, traces the life and history of the town and its surroundings through the centuries, from the Celtic period to the present day."
    ],
    "it": [
      "Questo museo, situato nell'ingresso del seminterrato del municipio, ripercorre la vita e la storia della città e dei suoi dintorni attraverso i secoli, dall'epoca celtica ai giorni nostri."
    ],
    "fr": [
      "Ce musée, situé à l’entrée sous-sol de la mairie, retrace la vie et l’histoire de la ville et ses environs au travers des siècles, de l’époque celte à nos jours."
    ],
    "es": [
      "Este museo, situado en la entrada del sótano del ayuntamiento, recorre la vida y la historia de la ciudad y sus alrededores a lo largo de los siglos, desde la época celta hasta la actualidad."
    ],
    "nl": [
      "Dit museum, gevestigd in de kelder van het stadhuis, vertelt het leven en de geschiedenis van de stad en haar omgeving door de eeuwen heen, van de Keltische tijd tot nu."
    ]
  },
  "rdfs:label": {
    "fr": [
