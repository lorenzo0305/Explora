  "rdfs:comment": {
    "de": [
      "Das Rathaus von Le Chambon-sur-Lignon ist das administrative und bürgerliche Herz dieser Gemeinde in der Haute-Loire, die für ihre Geschichte der Solidarität und Gastfreundschaft bekannt ist."
    ],
    "en": [
      "Le Chambon-sur-Lignon town hall is the administrative and civic heart of this Haute-Loire commune, renowned for its history of solidarity and hospitality."
    ],
    "it": [
      "Il municipio di Le Chambon-sur-Lignon è il cuore amministrativo e civico di questo comune dell'Alta Loira, noto per la sua storia di solidarietà e ospitalità."
    ],
    "fr": [
      "La mairie du Chambon-sur-Lignon est le cœur administratif et citoyen de cette commune de Haute-Loire, reconnue pour son histoire de solidarité et d’accueil."
    ],
    "nl": [
      "Het gemeentehuis van Le Chambon-sur-Lignon is het administratieve en maatschappelijke hart van deze gemeente in de Haute-Loire, die bekend staat om haar geschiedenis van solidariteit en gastvrijheid."
    ],
    "es": [
      "El ayuntamiento de Le Chambon-sur-Lignon es el corazón administrativo y cívico de este municipio del Alto Loira, famoso por su historia de solidaridad y hospitalidad."
    ]
  },
