  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/04f4f095-07b4-3340-8561-63cdf70368a1",
      "dc:description": {
        "de": [
          "Ein freundlicher und herzlicher Empfang, eine entspannte Atmosphäre und ein aufmerksamer Service - hier ist alles vorhanden, damit Sie eine schöne Zeit bei einem guten Essen verbringen können."
        ],
        "en": [
          "A warm and friendly welcome, a relaxed atmosphere, attentive service, everything is there to make sure you have a good time over a good meal."
        ],
        "it": [
          "Un'accoglienza calorosa e amichevole, un'atmosfera rilassata, un servizio attento, tutto è raccolto affinché possiate trascorrere un bel momento intorno a un buon pasto."
        ],
        "fr": [
          "Un accueil amical et chaleureux, une atmosphère décontractée, un service attentif, tout est réuni pour que vous passiez un bon moment autour d’un bon repas."
        ],
        "es": [
          "Una acogida cálida y amistosa, un ambiente relajado, un servicio atento, todo está reunido para que pueda pasar un buen momento en torno a una buena comida."
        ],
        "nl": [
          "Een warm en vriendelijk onthaal, een ontspannen sfeer, een attente bediening, alles is bijeengebracht om een goed moment door te brengen rond een goede maaltijd."
        ]
      },
      "@type": [
        "Description"
