  "rdfs:comment": {
    "de": [
      "Die Écuries du Lou Blanc heißen Sie das ganze Jahr über willkommen! Louise, Reitlehrerin mit einem BPJEPS-Diplom, bietet Ihnen Ausritte, Wanderungen, Kurse und Praktika, Equicoaching für Kinder und Erwachsene von der Einführung bis zur Perfektionierung. Auf Reservierung."
    ],
    "en": [
      "Louise, rinding instructor at the Ecuries du Lou Blanc, proposes different activities adapted to everyone's level. Poney on a leash ramble, baby poney, ramble, training, show jumping, galops competition."
    ],
    "it": [
      "Louise vi accoglie tutto l'anno! Istruttrice qualificata da 11 anni, offre passeggiate, lezioni e corsi, equitazione e mediazione animale. Bambini e adulti, da principianti ad avanzati. Solo su prenotazione"
    ],
    "fr": [
      "Louise vous accueille toute l'année ! Monitrice diplômée d'état depuis 11 ans, vous propose des balades, randonnées, cours et stages, équicoaching, médiation animal. Enfants et adultes de l'initiation au perfectionnement. Sur réservation"
    ],
    "nl": [
      "Louise, monitrice paardrijdster bij de paardenstallen Les Ecuries du Lou Blanc, stelt u verscheidene aktiviteiten voor volgens de wens en kennis van iedereen, voor een moment van plezier en ontspanning. Begeleide wandelingen, baby poney, cross, afleggen van galop-graden,"
    ],
    "es": [
      "Louise le da la bienvenida todo el año Instructora titulada desde hace 11 años, ofrece paseos, clases y cursos, equicoaching y mediación animal. Niños y adultos, desde principiantes hasta avanzados. Sólo con reserva"
    ]
  },
  "rdfs:label": {
    "en": [
