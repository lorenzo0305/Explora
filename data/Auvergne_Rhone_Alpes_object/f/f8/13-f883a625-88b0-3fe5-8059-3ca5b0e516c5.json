  "rdfs:comment": {
    "de": [
      "Der Lac d'En-Bas ist ein Gletschersee und der einzige der beiden Seen von La Godivelle, der zum Angeln geöffnet ist und für den man Karten kaufen muss."
    ],
    "en": [
      "Lac d'En-Bas, of glacial origin, is the only one of the two Godivelle lakes open to card-purchasing anglers."
    ],
    "it": [
      "Il Lac d'En-Bas, un lago glaciale, è l'unico dei due laghi di Godivelle aperto alla pesca con l'acquisto di carte di pesca."
    ],
    "fr": [
      "Le lac d'En-Bas d'origine glaciaire est le seul des deux lacs de la Godivelle ouvert à la pêche avec achat de cartes ."
    ],
    "nl": [
      "Het Lac d'En-Bas, een gletsjermeer, is het enige van de twee meren van Godivelle waar je kunt vissen als je een viskaart koopt."
    ],
    "es": [
      "El Lac d'En-Bas, un lago glaciar, es el único de los dos lagos de Godivelle abierto a la pesca con la compra de tarjetas de pesca."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site de pêche du lac d'En Bas à la Godivelle"
    ]
  },
