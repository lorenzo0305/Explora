  "rdfs:comment": {
    "de": [
      "Staatlich diplomierter Lehrer und vierfacher Sieger der Landes- und Weltmeisterschaft im Gleitschirmfliegen. Start mit Skiern an den Füßen vom Gipfel des Mont Lachat. Flug über Crest-Voland Cohennoz. Täglich bei guten Wetterverhältnissen."
    ],
    "en": [
      "Qualified instructor and four times French Champion and World Champion.  Launch from the top of Mont Lachat with skis on.  Fly over Crest-Voland Cohennoz.  Every day when the weather is fine."
    ],
    "it": [
      "Istruttore statale, quattro volte campione di Francia e campione del mondo. Sci in cima al Mont Lachat. Volo sulla Crest-Voland Cohennoz. Tutti i giorni con il bel tempo."
    ],
    "fr": [
      "Moniteur d'Etat, quadruple Champion de France et Champion du Monde. Départ du sommet du Mont Lachat skis aux pieds. Survol de Crest-Voland Cohennoz. Tous les jours par beau temps."
    ],
    "nl": [
      "Staatsleraar, viervoudig Frans kampioen en wereldkampioen. Ski naar de top van Mont Lachat. Vlucht over Crest-Voland Cohennoz. Elke dag bij goed weer."
    ],
    "es": [
      "Monitor estatal, cuatro veces campeón de Francia y campeón del mundo. Esquí hasta la cima del Mont Lachat. Vuelo sobre Crest-Voland Cohennoz. Todos los días con buen tiempo."
    ]
  },
