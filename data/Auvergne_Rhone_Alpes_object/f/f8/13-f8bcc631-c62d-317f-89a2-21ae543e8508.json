  "rdfs:comment": {
    "de": [
      "Dieser See, in der Nähe der Fayet, am Rande von Arve, ist das Objekt der Strümpfe von Fario und Regenbogenforelle."
    ],
    "en": [
      "This lake, located near the Fayet, on the edge of Arve, is the object of stockings of fario and rainbow trout."
    ],
    "it": [
      "Questo lago vicino a Le Fayet, sulle rive dell'Arve, è popolato da trote fario e iridee."
    ],
    "fr": [
      "Ce lac situé à proximité du Fayet, en bordure d’Arve, fait l’objet d’empoissonnements en truites fario et arc-en-ciel."
    ],
    "es": [
      "Este lago, situado cerca del Fayet, en el borde de Arve, es el objeto de medias de fario y trucha arco iris."
    ],
    "nl": [
      "Dit meer bij Le Fayet, aan de oevers van de Arve, is gevuld met fario- en regenboogforel."
    ]
  },
