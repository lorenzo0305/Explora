  "rdfs:comment": {
    "de": [
      "Die Mediatheken sind offen und für alle zugänglich. Sie stellen den Besuchern Räume und Sammlungen aller Medien zur Verfügung, um sie auf der Suche nach Wissen, Bildung und Freizeit zu begleiten"
    ],
    "en": [
      "Open and accessible to all, the media libraries provide the public with collections of all kinds to accompany them in their search for knowledge, training and leisure activities."
    ],
    "it": [
      "Aperte e accessibili a tutti, le mediateche forniscono l'accesso pubblico a spazi e collezioni di tutti i media, per sostenere la ricerca della conoscenza, la formazione e le attività del tempo libero"
    ],
    "fr": [
      "Ouvertes et accessibles à tous, les médiathèques mettent à la disposition des publics, des espaces et des collections tout support, pour accompagner dans la recherche de connaissance, de formation et de loisirs"
    ],
    "nl": [
      "Open en toegankelijk voor iedereen, bieden mediatheken openbare toegang tot ruimtes en collecties in alle media, ter ondersteuning van het zoeken naar kennis, opleiding en vrijetijdsbesteding"
    ],
    "es": [
      "Abiertas y accesibles a todos, las mediatecas proporcionan acceso público a espacios y colecciones en todos los soportes, para apoyar la búsqueda de conocimientos, la formación y las actividades de ocio"
    ]
  },
  "rdfs:label": {
