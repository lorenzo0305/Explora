  "rdfs:comment": {
    "de": [
      "Sie werden sich für eine zweistündige Fahrt einschiffen, um die Rhône und ihre Bauwerke zu entdecken und eine Schleuse zu passieren. Christel wird die Fahrt mit einem Quiz über die Rhône moderieren. Die Fahrt wird mit einem Getränk und einem Picknick aus der Tasche abgerundet."
    ],
    "en": [
      "You'll embark on a 2-hour cruise to discover the Rhône and its structures, including a lock passage. Christel will lead the cruise with a quiz on the Rhône. Enjoy a drink and a picnic lunch."
    ],
    "it": [
      "Imbarco per una crociera di 2 ore alla scoperta del Rodano e delle sue chiuse. Christel condurrà la crociera con un quiz sul Rodano. La crociera sarà accompagnata da un aperitivo e da un pranzo al sacco."
    ],
    "fr": [
      "Vous embarquerez pour 2h de balade à la découverte du Rhône et de ses ouvrages avec un passage d'écluse. Christel animera cette croisière en vous proposant un quiz sur le Rhône. La croisière sera agrémentée d'un verre et de votre pique nique tiré du sac."
    ],
    "nl": [
      "Je gaat aan boord van een 2 uur durende cruise om de Rhône en zijn sluizen te ontdekken. Christel leidt de tocht met een quiz over de Rhône. De tocht wordt begeleid door een drankje en een picknicklunch."
    ],
    "es": [
      "Embarcará en un crucero de 2 horas para descubrir el Ródano y sus esclusas. Christel guiará el crucero con un cuestionario sobre el Ródano. El crucero irá acompañado de una bebida y un almuerzo campestre."
    ]
  },
  "rdfs:label": {
    "de": [
      "Animiertfahrt mit Schleusepassage"
    ],
    "en": [
      "Animated cruise with lock passage"
    ],
    "fr": [
      "Croisière animée avec passage écluse"
    ]
  },
