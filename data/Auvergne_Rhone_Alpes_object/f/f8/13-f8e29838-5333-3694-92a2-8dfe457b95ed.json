  "rdfs:comment": {
    "de": [
      "Wir zaubern für Sie einzigartige Rezepte wie Kashmir, duftende Currys aus Bengalen und Tandoori-Grillgerichte aus Rajasthan. Wählen Sie aus unseren Menüs und abwechslungsreichen Gerichten à la carte, die Sie vor Ort genießen oder mitnehmen können."
    ],
    "en": [
      "We concoct unique recipes such as Kashmir, fragrant Bengali curries and Rajasthani tandoori grills. Choose from our varied à la carte menus and dishes, to eat in or take away."
    ],
    "it": [
      "Prepariamo per voi ricette uniche come il Kashmir, i fragranti curry bengalesi e le grigliate tandoori rajasthani. Scegliete tra una varietà di menu à la carte e di piatti, da consumare in casa o da asporto."
    ],
    "fr": [
      "Nous concoctons pour vous des recettes uniques telles que le Kashmir, les currys parfumés du Bengale et les grillades au tandoori du Rajasthan. Choisissez parmi nos menus et nos plats variés à la carte, à déguster sur place ou à emporter."
    ],
    "nl": [
      "We maken unieke recepten zoals Kasjmir, geurige Bengaalse curry's en Rajasthani tandoori grillgerechten. Kies uit onze gevarieerde à la carte menu's en gerechten, om te eten of mee te nemen."
    ],
    "es": [
      "Le preparamos recetas únicas como el cachemir, el fragante curry bengalí y las parrilladas tandoori del Rajastán. Elija entre una variedad de menús y platos a la carta, para comer en casa o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Shalimar"
    ]
  },
