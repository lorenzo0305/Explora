  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b79709d3-8033-3875-a87d-08cc41fdfc49",
      "dc:description": {
        "de": [
          "Als Beraterin für Kompetenzbilanzierung (Qualiopi-zertifiziert), Ausbildung und Coaching begleite ich Sie, um Ihrem beruflichen Werdegang einen neuen Sinn zu geben. Vereinbaren Sie einen Termin für eine kostenlose Information."
        ],
        "en": [
          "As a consultant in skills assessment (Qualiopi certified), training and coaching, I can help you give new meaning to your career path. Make an appointment for free information."
        ],
        "it": [
          "Come consulente in bilancio delle competenze (certificato Qualiopi), formazione e coaching, posso aiutarvi a dare un nuovo significato al vostro percorso professionale. Fissate un appuntamento per avere informazioni gratuite."
        ],
        "fr": [
          "Consultante en bilan de compétences (certifiée Qualiopi), formation et coaching, je vous accompagne pour redonner du sens à votre parcours professionnel. Prenez rendez-vous pour une information gratuite."
        ],
        "es": [
          "Como consultor en evaluación de competencias (certificado Qualiopi), formación y coaching, puedo ayudarle a dar un nuevo sentido a su trayectoria profesional. Concierte una cita para obtener información gratuita."
        ],
        "nl": [
          "Als consultant in het beoordelen van vaardigheden (Qualiopi gecertificeerd), training en coaching, kan ik je helpen een nieuwe invulling te geven aan je carrièrepad. Maak een afspraak voor vrijblijvende informatie."
        ]
      },
