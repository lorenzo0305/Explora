  "rdfs:comment": {
    "de": [
      "Das Mélilot Théâtre ist ein kleiner Veranstaltungssaal, der von der Theatergruppe Atomes Scéniques betrieben wird. Wir bieten das ganze Jahr über im Rahmen eines Programms Theater- und Musikaufführungen an."
    ],
    "en": [
      "Le Mélilot Théâtre is a small theatre managed by the company Atomes Scéniques. We offer theatre and music shows all year round as part of our programming."
    ],
    "it": [
      "Il Mélilot Théâtre è un piccolo teatro gestito dalla compagnia Atomes Scéniques. Offriamo spettacoli teatrali e musicali tutto l'anno come parte di un programma."
    ],
    "fr": [
      "Le Mélilot Théâtre est une petite salle de spectacle gérée par la compagnie Atomes Scéniques. Nous proposons des spectacles théâtre et musique toute l'année dans le cadre d'une programmation."
    ],
    "nl": [
      "Het Mélilot Théâtre is een klein theater dat wordt beheerd door de maatschappij Atomes Scéniques. Wij bieden het hele jaar door theater- en muziekvoorstellingen in het kader van een programma."
    ],
    "es": [
      "El Mélilot Théâtre es un pequeño teatro gestionado por la compañía Atomes Scéniques. Ofrecemos espectáculos de teatro y música durante todo el año en el marco de un programa."
    ]
  },
