  "rdfs:comment": {
    "de": [
      "Dieses erste Escape Game wird Sie auf ein Abenteuer in Aqualis mitnehmen, das zwischen Spiel, Seeentdeckung, Lachen und guter Laune jongliert. Eine andere Art, Aqualis zu erleben!"
    ],
    "en": [
      "This first escape game will take you on an adventure at the heart of Aqualis, juggling games, lake discoveries, laughter and good humor. Another way to experience Aqualis!"
    ],
    "it": [
      "Questo primo gioco di fuga vi porterà in un'avventura nel cuore di Aqualis, tra giochi, scoperta del lago, risate e buon umore. Un altro modo di vivere Aqualis!"
    ],
    "fr": [
      "Ce premier escape game vous emportera dans une aventure au sein d'Aqualis, jonglant entre jeu, découverte lacustre, rires et bonne humeur. Une autre façon de vivre Aqualis !"
    ],
    "es": [
      "Este primer juego de escape le llevará a una aventura en el corazón de Aqualis, juegos malabares, descubrimiento del lago, risas y buen humor. ¡Otra forma de vivir Aqualis!"
    ],
    "nl": [
      "Dit eerste ontsnappingsspel neemt je mee op avontuur in het hart van Aqualis, met jongleerspelletjes, ontdekking van het meer, gelach en goede humor. Een andere manier om Aqualis te beleven!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape game : \"Menace sur le lac\""
    ]
  },
