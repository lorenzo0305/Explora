  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ac23ef83-7e91-3d6e-ae74-6ba6e34c929e",
      "dc:description": {
        "de": [
          "Einladung zur Vernissage der Ausstellung in der Kirche Saint Martin mit musikalischer Unterhaltung durch die Avenir Fressinois\nTreffpunkt: Sonntag, 29. Juni, 16.30 Uhr, anschließend ein Glas Freundschaft\nFreier Eintritt"
        ],
        "en": [
          "Invitation to the opening of the exhibition in the Saint Martin church, with musical entertainment by l'Avenir Fressinois\nSunday June 29, 4.30pm, followed by a friendly drink\nFree admission"
        ],
        "it": [
          "Invito all'inaugurazione della mostra nella chiesa di Saint-Martin, con intrattenimento musicale dell'Avenir Fressinois\nAppuntamento domenica 29 giugno alle 16.30, seguito da un aperitivo in compagnia\nIngresso libero"
        ],
        "fr": [
          "Invitation au vernissage de l'exposition dans l'église Saint Martin avec animation musicale par l'Avenir Fressinois\nRendez-vous le dimanche 29 juin à 16h30, suivi d'un verre de l'amitié\nEntrée libre et gratuite"
        ],
        "nl": [
          "Uitnodiging voor de opening van de tentoonstelling in de Sint-Maartenskerk met muzikale omlijsting door de Avenir Fressinois\nAfspraak op zondag 29 juni om 16u30, gevolgd door een gezellige borrel\nGratis toegang"
        ],
        "es": [
          "Invitación a la inauguración de la exposición en la iglesia de San Martín con animación musical a cargo de Avenir Fressinois\nEncuentro el domingo 29 de junio a las 16.30 h, seguido de una copa amistosa\nEntrada gratuita"
        ]
      },
