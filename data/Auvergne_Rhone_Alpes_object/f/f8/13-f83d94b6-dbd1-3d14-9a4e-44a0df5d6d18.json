  "rdfs:comment": {
    "de": [
      "Erleben Sie den Sternenhimmel!\r\nDen Himmel zu betrachten ist eine einfache und unvergessliche Erfahrung.\r\nSie weckt in jedem von uns besondere Emotionen.\r\nErstaunen, Überraschung, Amüsement, Neugier, Beruhigung, manchmal sogar ein wenig Angst..."
    ],
    "en": [
      "Come and discover the celestial vault!\r\nContemplating the sky is a simple and unforgettable experience.\r\nIt awakens special emotions in each of us.\r\nMarvel, surprise, amusement, curiosity, curiosity, sometimes even a little fright..."
    ],
    "it": [
      "Venite a scoprire il cielo!\r\nContemplare il cielo è un'esperienza semplice e indimenticabile.\r\nRisveglia emozioni speciali in ognuno di noi.\r\nMeraviglia, sorpresa, divertimento, curiosità, acquiescenza, a volte anche un po' di paura..."
    ],
    "fr": [
      "Venez découvrir  la voûte céleste !\r\nContempler le ciel est une expérience simple et inoubliable.\r\nElle éveille en chacun de nous des émotions particulières.\r\nEmerveillement, surprise, amusement, curiosité, apaisement parfois même un peu d'effroi..."
    ],
    "es": [
      "¡Venga a descubrir el cielo!\r\nContemplar el cielo es una experiencia sencilla e inolvidable.\r\nDespierta emociones especiales en cada uno de nosotros.\r\nMaravilla, sorpresa, diversión, curiosidad, apaciguamiento, a veces incluso un poco de miedo..."
    ],
    "nl": [
      "Kom en ontdek de hemel!\r\nDe hemel aanschouwen is een eenvoudige en onvergetelijke ervaring.\r\nHet maakt speciale emoties in ieder van ons wakker.\r\nVerwondering, verrassing, amusement, nieuwsgierigheid, kalmte, soms zelfs een beetje angst..."
    ]
  },
  "rdfs:label": {
