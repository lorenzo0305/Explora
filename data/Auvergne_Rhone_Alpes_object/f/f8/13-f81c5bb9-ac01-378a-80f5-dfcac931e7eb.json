  "rdfs:comment": {
    "de": [
      "Die Kirche ist ein ehemaliges Priorat, das von der Abtei Saint-Géraud abhing, und beherbergt zehn der Chorgestühle der ehemaligen Stiftskirche Saint-Chamant, die 1484 von Robert de Balsac gegründet wurde."
    ],
    "en": [
      "from the 15th century"
    ],
    "it": [
      "Ex priorato dell'abbazia di Saint-Géraud, la chiesa contiene dieci stalli dell'antica collegiata di Saint-Chamant, fondata nel 1484 da Robert de Balsac."
    ],
    "fr": [
      "Ancien prieuré dépendant de l’abbaye Saint-Géraud, l’église renferme dix des stalles de l’ancienne collégiale de Saint-Chamant, fondée en 1484 par Robert de Balsac."
    ],
    "nl": [
      "De kerk is een voormalige priorij van de abdij van Saint-Géraud en bevat tien koorstoelen van de voormalige collegiale kerk van Saint-Chamant, gesticht in 1484 door Robert de Balsac."
    ],
    "es": [
      "Antiguo priorato perteneciente a la abadía de Saint-Géraud, la iglesia contiene diez puestos de la antigua colegiata de Saint-Chamant, fundada en 1484 por Robert de Balsac."
    ]
  },
  "rdfs:label": {
    "en": [
      "St Alyre’s church"
    ],
    "fr": [
      "Eglise Saint-Alyre"
    ]
  },
