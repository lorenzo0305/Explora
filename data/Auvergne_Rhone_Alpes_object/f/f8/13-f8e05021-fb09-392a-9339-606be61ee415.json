  "rdfs:comment": {
    "de": [
      "Hallo, ich bin Bergführerin Julia. Ich lade Sie dazu ein, den Vercors durch verschiedene Aktivitäten zu entdecken. Ich kann Sie auch auf andere Bergmassive mitnehmen, je nachdem, was Sie möchten."
    ],
    "en": [
      "Hello, I'm Julia, mountain guide. Come and discover the Vercors through various activities. I can also take you to other mountain ranges if you wish."
    ],
    "it": [
      "Salve,\r\n\r\nSono Julia, guida alpina, e vorrei invitarvi a scoprire il Vercors attraverso una serie di attività escursionistiche:\r\nescursioni con le racchette da neve, escursioni in famiglia, escursioni femminili, bivacco o micro-avventura, benessere..."
    ],
    "fr": [
      "Bonjour, \r\n\r\nJe suis Julia, accompagnatrice en montagne et je vous invite à découvrir le Vercors à travers diverses activités autour de la randonnée : \r\nraquettes à neige, randonnée en famille, randonnée au féminin, bivouac ou micro-aventure, bien-être..."
    ],
    "es": [
      "Hola,\r\n\r\nSoy Julia, monitora de montaña, y me gustaría invitarte a descubrir el Vercors a través de diversas actividades de senderismo:\r\nraquetas de nieve, senderismo familiar, senderismo femenino, vivac o microaventura, bienestar..."
    ],
    "nl": [
      "Hallo,\r\n\r\nIk ben Julia, bergleidster, en ik nodig je graag uit om de Vercors te ontdekken via verschillende wandelactiviteiten:\r\nsneeuwschoenwandelingen, familiewandelingen, wandelingen voor vrouwen, bivak of micro-avontuur, welzijn..."
    ]
  },
