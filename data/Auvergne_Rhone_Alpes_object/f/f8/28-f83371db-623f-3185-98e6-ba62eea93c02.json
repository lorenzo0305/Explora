      "dc:description": {
        "de": [
          "Skatepark aus Beton mit zwei Ledges (eine für Goofy und eine für Regulars), einigen Stufen, einer Slidebar, geneigten Ebenen und einem Curb am Boden."
        ],
        "en": [
          "Concrete skatepark with two ledges (one for the goofy and one for the regulars) a few steps, a slide bar, inclined planes, a curb on the ground."
        ],
        "it": [
          "Skatepark in cemento con due sporgenze (una per i goofy e una per i regular), alcuni gradini, una barra di scorrimento, piani inclinati, un cordolo a terra."
        ],
        "fr": [
          "Skatepark en béton avec deux ledges (un pour les goofy et un pour les regulars) quelques marches, une barre a slide, des plans inclinés, un curb au sol."
        ],
        "es": [
          "Skatepark de hormigón con dos cornisas (una para bobos y otra para regulares), algunos escalones, una barra de deslizamiento, planos inclinados, un bordillo en el suelo."
        ],
        "nl": [
          "Betonnen skatepark met twee richels (een voor goofy en een voor regulars), enkele trappen, een glijstang, hellende vlakken, een stoeprand op de grond."
        ]
      },
