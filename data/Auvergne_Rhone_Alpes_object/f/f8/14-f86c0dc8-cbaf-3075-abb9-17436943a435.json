      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nDienstag bis Sonntag: 7.30-19.30 Uhr\n\nMontag geschlossen\n \n Abholung:\nZu den Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nTuesday to Sunday: 7:30am-7:30pm\n\nClosed on Monday\n \n Pick-up :\nDuring store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDa martedì a domenica: 7.30-19.30\n\nChiuso il lunedì\n \n Ritiro :\nDurante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nDu mardi au dimanche: 7h30-19h30\n\nFermeture le lundi\n \n Retrait :\nAux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nDinsdag tot zondag: 7.30u-7.30u\n\nMaandag gesloten\n \n Afhalen :\nTijdens winkelopeningstijden\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe martes a domingo: de 7.30 h. a 19.30 h\n\nLunes cerrado\n \n Recogida :\nDurante el horario de apertura de la tienda\n\n\n "
        ]
      },
