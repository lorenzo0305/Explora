  "rdfs:comment": {
    "de": [
      "Am Fuße des Mont Brouilly gelegen, herrliche Aussicht, großer Empfangskeller, Bar aus geschnitzter Eiche, Familienbetrieb, der von Jean-Claude und Hervé Nesme geführt wird. Ernte, Weinbereitung, Abfüllung, Verkauf, alles wird zu Hause gemacht."
    ],
    "en": [
      "Situated at the foot of Mont Brouilly, magnificent view, large reception cellar, carved oak bar, family exploitation managed by Jean-Claude and Hervé Nesme. Harvest, vinification, bottling, sale, everything is done at home."
    ],
    "it": [
      "Situata ai piedi del Mont Brouilly, vista magnifica, grande cantina di ricevimento, bar in rovere intagliato, azienda familiare gestita da Jean-Claude e Hervé Nesme. Vendemmia, vinificazione, imbottigliamento, vendita, tutto viene fatto in casa."
    ],
    "fr": [
      "Située au pied du Mont Brouilly, vue magnifique, grand caveau de réception, bar en chêne sculpté, exploitation familiale gérée par Jean-Claude et Hervé Nesme. Récolte, vinification, mise en bouteilles, vente, tout est fait à la maison."
    ],
    "es": [
      "Situado al pie del Mont Brouilly, magnífica vista, gran bodega de recepción, bar de roble tallado, empresa familiar dirigida por Jean-Claude y Hervé Nesme. La cosecha, la vinificación, el embotellado, la venta, todo se hace en la empresa."
    ],
    "nl": [
      "Gelegen aan de voet van de Mont Brouilly, prachtig uitzicht, grote ontvangstkelder, gebeeldhouwde eikenhouten bar, familiebedrijf geleid door Jean-Claude en Hervé Nesme. Oogsten, vinificatie, bottelen, verkoop, alles gebeurt in eigen huis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine des Grandes Vignes"
    ]
  },
