  "rdfs:comment": {
    "de": [
      "Wir haben uns seit April 2013 auf einem vielfältigen Betrieb niedergelassen, der biologisch bewirtschaftet wird, und produzieren eine ganze Reihe von Produkten, die im Direktverkauf vermarktet werden."
    ],
    "en": [
      "Installed since April 2013, on a diversified farm, in organic agriculture, we produce a complete range of products marketed for direct sale."
    ],
    "it": [
      "Da aprile 2013, in un'azienda agricola diversificata, in agricoltura biologica, produciamo una gamma completa di prodotti commercializzati in vendita diretta."
    ],
    "fr": [
      "Installé depuis avril 2013, sur une exploitation diversifiée, en agriculture biologique, nous produisons une gamme complète de produits commercialisés en vente directe."
    ],
    "nl": [
      "Sinds april 2013 produceren wij op een gediversifieerde boerderij, in de biologische landbouw, een compleet assortiment producten die in de directe verkoop worden gebracht."
    ],
    "es": [
      "Desde abril de 2013, en una finca diversificada, en agricultura ecológica, producimos una gama completa de productos comercializados en venta directa."
    ]
  },
  "rdfs:label": {
