  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d86330da-d4b1-3e87-80f7-548aa9e4ebb4",
      "dc:description": {
        "de": [
          "Die Kindertagesstätte \"La roulotte des bambins\" ist von 7.30 Uhr bis 19.30 Uhr geöffnet.\n\nla roulotte des bambins? kann bis zu 12 Kinder pro Tag aufnehmen."
        ],
        "en": [
          "La roulotte des bambins? is open to children from 7.30am to 7.30pm.\n\nla roulotte des bambins? can accommodate up to 12 children per day."
        ],
        "it": [
          "La roulotte des bambins? è aperta ai bambini dalle 7.30 alle 19.30.\n\nla roulotte des bambins? può ospitare fino a 12 bambini al giorno."
        ],
        "fr": [
          "La micro-crèche “La roulotte des bambins” est ouverte aux enfants de 7H30 à 19H30 .\n\n“La roulotte des bambins” peut accueillir jusqu’à 12 enfants par jour."
        ],
        "nl": [
          "La roulotte des bambins? is open voor kinderen van 7.30 tot 19.30 uur.\n\nla roulotte des bambins? biedt plaats aan maximaal 12 kinderen per dag."
        ],
        "es": [
          "La roulotte des bambins? está abierta a los niños de 7.30 a 19.30 horas.\n\nla roulotte des bambins? puede acoger hasta 12 niños al día."
        ]
      },
