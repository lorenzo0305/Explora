  "rdfs:comment": {
    "de": [
      "Hier finden Sie die besten Bio-Produkte: Bio-Lebensmittel, Nahrungsergänzungsmittel, Kräutertee, Phytotherapie, Aromatherapie, Kosmetika, Parfüms. Ständige Therapeuten nach Vereinbarung: Naturheilpraktiker, Iridologe, Ayurveda-Masseur, Akupunkteur."
    ],
    "en": [
      "Find the best of organic: organic groceries, food supplements, herbal tea, phytotherapy aromatherapy, cosmetics, perfumes. Presence of permanent therapists by appointment: naturopathic iridologist, ayurvedic masseur, acupuncturist."
    ],
    "it": [
      "Troverete il meglio di alimenti biologici, integratori alimentari, tisane, aromaterapia, cosmetici, profumi. Presenza di terapisti fissi su appuntamento: naturopata iridologo, massaggiatore ayurvedico, agopunturista."
    ],
    "fr": [
      "Retrouverez le meilleurs du bio : épicerie biologique, compléments alimentaires, tisanerie, phytothérapie aromathérapie, cosmétiques, parfums. Présence de thérapeutes permanents sur rendez-vous : naturopathe iridologue, masseur ayurvedique, acupuncteur."
    ],
    "nl": [
      "U vindt er het beste van biologische voeding, voedingssupplementen, kruidenthee, aromatherapie, cosmetica, parfums. Aanwezigheid van vaste therapeuten op afspraak: natuurgeneeskundige iridoloog, ayurvedische masseur, acupuncturist."
    ],
    "es": [
      "Encontrará lo mejor de los alimentos ecológicos, complementos alimenticios, infusiones, aromaterapia, cosméticos y perfumes. Presencia de terapeutas permanentes con cita previa: iridólogo naturista, masajista ayurvédico, acupuntor."
    ]
  },
