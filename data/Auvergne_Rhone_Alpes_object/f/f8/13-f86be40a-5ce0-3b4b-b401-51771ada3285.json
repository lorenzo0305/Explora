  "rdfs:comment": {
    "de": [
      "Umgeben von der einzigartigen Natur der Vulkane der Auvergne, nur wenige Schritte von der Volvic-Quelle und nur 15 Minuten von Clermont-Ferrand entfernt, ist das Atelier du Volvic Organic Resort der ideale Ort, um Ihren Seminaren eine natürliche Dimension zu verleihen!"
    ],
    "en": [
      "Surrounded by a unique natural landscape shaped by the volcanoes of the Auvergne, just a stone's throw from the Volvic spring, and only 15 minutes from Clermont-Ferrand, the Atelier du Volvic Organic Resort is the ideal place to add a natural dimension to your seminars!"
    ],
    "it": [
      "Circondato da un paesaggio naturale unico, modellato dai vulcani dell'Alvernia, a due passi dalla sorgente Volvic e a soli 15 minuti da Clermont-Ferrand, l'Atelier du Volvic Organic Resort è il luogo ideale per aggiungere una dimensione naturale ai vostri seminari!"
    ],
    "fr": [
      "Entouré d'une nature unique façonnée par les volcans d' Auvergne, à quelques pas de la Source Volvic,et à seulement 15 minutes de Clermont-Ferrand, l'Atelier du Volvic Organic Resort sera le lieu idéal pour donner une dimension nature à vos séminaires !"
    ],
    "es": [
      "Rodeado de un paisaje natural único formado por los volcanes de Auvernia, a dos pasos del manantial de Volvic y a sólo 15 minutos de Clermont-Ferrand, el Atelier du Volvic Organic Resort es el lugar ideal para añadir una dimensión natural a sus seminarios"
    ],
    "nl": [
      "Omgeven door een uniek natuurlijk landschap gevormd door de vulkanen van de Auvergne, op een steenworp afstand van de Volvic bron en op slechts 15 minuten van Clermont-Ferrand, is het Atelier du Volvic Organic Resort de ideale plek om een natuurlijke dimensie toe te voegen aan uw seminars!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location de salles Volvic Organic Resort"
    ]
  },
