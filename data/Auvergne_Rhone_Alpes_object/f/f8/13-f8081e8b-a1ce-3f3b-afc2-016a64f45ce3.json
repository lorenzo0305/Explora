  "rdfs:comment": {
    "de": [
      "Nils hat eine Leidenschaft für Bewegung, Sport und Fortschritt und arbeitet seit 8 Jahren als Fitnesstrainer.\r\nEr arbeitet in der Region Vercors und begleitet Sportler aller Niveaus bei ihrer körperlichen Entwicklung, ihrer Erholung und ihrer Rückkehr nach Verletzungen."
    ],
    "en": [
      "Passionate about movement, sport and progression, Nils has been a physical trainer for 8 years.\r\nBased in the Vercors region of France, he now assists athletes of all levels in their physical progress, recovery or return from injury."
    ],
    "it": [
      "Appassionato di movimento, sport e progresso, Nils è un preparatore fisico da 8 anni.\r\nCon sede nella regione del Vercors, in Francia, assiste sportivi di ogni livello nello sviluppo fisico, nel recupero e nel ritorno da un infortunio."
    ],
    "fr": [
      "Passionné par le mouvement, le sport et la progression, Nils est préparateur physique depuis 8 ans.\r\nBasé dans le Vercors, il accompagne aujourd’hui des sportifs de tous niveaux dans leur progression physique, récupération ou leur retour après blessure."
    ],
    "nl": [
      "Nils is gepassioneerd door beweging, sport en vooruitgang en is al 8 jaar fysiek trainer.\r\nVanuit de Vercors regio in Frankrijk begeleidt hij nu sporters op alle niveaus in hun fysieke ontwikkeling, herstel en terugkeer van blessures."
    ],
    "es": [
      "Apasionado del movimiento, el deporte y el progreso, Nils es preparador físico desde hace 8 años.\r\nAfincado en la región francesa de Vercors, ahora ayuda a deportistas de todos los niveles en su desarrollo físico, recuperación y vuelta tras una lesión."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nils Djurakdjian"
    ]
  },
