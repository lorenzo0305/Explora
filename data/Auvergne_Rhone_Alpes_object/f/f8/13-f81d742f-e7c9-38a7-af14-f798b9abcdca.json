  "rdfs:comment": {
    "de": [
      "Das Denkmal symbolisiert die Hilfe der Alliierten für den Maquis de l'Ain und den Haut-Jura in den Jahren 1943-1944. Inmitten der Wiese von Echallon erhebt sich eine 7 m hohe Pyramide mit dem Lothringer Kreuz auf der Spitze, wo Fallschirmabwürfe von Waffen und Lebensmitteln stattfanden."
    ],
    "en": [
      "The monument symbolize the allies assistance to Ain and Haut Jura's Scrub in 1943 and 1944. In the middle of Echallon's meadow, rise up a 7m pyramid been on top of the Lorraine Cross. Overthere, had place guns and food supplies parachuting."
    ],
    "it": [
      "Il monumento simboleggia l'aiuto fornito dagli Alleati ai Maquis dell'Ain e dell'Haut-Jura nel 1943-1944. Al centro del prato di Echallon si erge una piramide alta 7 metri sormontata dalla Croce di Lorena, dove venivano sganciate armi e rifornimenti."
    ],
    "fr": [
      "Le monument symbolise l'aide des alliés aux Maquis de l'Ain et du Haut-Jura en 1943-1944. Au milieu de la prairie d'Echallon s'élève une pyramide de 7 mètres de haut surmontée de la Croix de Lorraine où eurent lieu des parachutages d'armes et de vivres."
    ],
    "nl": [
      "Het monument symboliseert de hulp van de geallieerden aan de Maquis van de Ain en de Haut-Jura in 1943-1944. In het midden van de weide van Echallon staat een 7 meter hoge piramide met daarop het Kruis van Lotharingen, waar wapens en voorraden werden gedropt."
    ],
    "es": [
      "El monumento simboliza la ayuda prestada por los Aliados a los maquis del Ain y del Haut-Jura en 1943-1944. En el centro del prado de Echallon se alza una pirámide de 7 metros de altura coronada por la Cruz de Lorena, desde donde se lanzaron armas y suministros."
    ]
  },
  "rdfs:label": {
    "en": [
      "Monument of Echallon's scrub"
    ],
    "fr": [
      "Monument du maquis d' Echallon"
    ]
  },
