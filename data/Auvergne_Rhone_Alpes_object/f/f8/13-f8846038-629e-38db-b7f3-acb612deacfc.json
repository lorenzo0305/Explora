  "rdfs:comment": {
    "de": [
      "Eine den Feuerwehrleuten gewidmete Ausstellung, die von der Freien Gemeinde Saint-Marcel angeboten wird. Sie beleuchtet ihre Geschichte, ihr Engagement und ihre wesentliche Rolle im Dienste der Bevölkerung."
    ],
    "en": [
      "An exhibition dedicated to firefighters, organized by the Commune Libre de Saint-Marcel, highlighting their history, their commitment and their essential role in serving the population."
    ],
    "it": [
      "Una mostra dedicata ai vigili del fuoco, organizzata dal Comune libero di Saint-Marcel, che mette in luce la loro storia, il loro impegno e il loro ruolo essenziale al servizio della popolazione."
    ],
    "fr": [
      "Exposition dédiée aux sapeurs-pompiers, proposée par la Commune Libre de Saint-Marcel, mettant en lumière leur histoire, leur engagement et leur rôle essentiel au service de la population."
    ],
    "es": [
      "Una exposición dedicada a los bomberos, organizada por la Comuna Libre de Saint-Marcel, que pone de relieve su historia, su compromiso y su papel esencial al servicio de los ciudadanos."
    ],
    "nl": [
      "Een tentoonstelling gewijd aan de brandweer, georganiseerd door de Commune Libre de Saint-Marcel, die hun geschiedenis, hun inzet en hun essentiële rol ten dienste van de bevolking belicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Sapeurs Pompiers"
    ]
  },
