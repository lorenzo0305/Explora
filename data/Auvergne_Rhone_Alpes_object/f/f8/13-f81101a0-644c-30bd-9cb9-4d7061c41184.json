  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über bietet Ihnen das Unternehmen Restaurantkreuzfahrten auf dem größten natürlichen See Frankreichs, dem Canal de Savières und der Haut Rhône auf Booten mit 100% elektrischem Antrieb an."
    ],
    "en": [
      "Throughout the year, the company offers you restaurant cruises on the largest natural lake in France, the Savières Canal, and the Upper Rhône on 100% electric motorized boats."
    ],
    "it": [
      "Durante tutto l'anno, la compagnia vi propone crociere ristorante sul più grande lago naturale di Francia, il Canale di Savières e l'Alto Rodano su barche a motore 100% elettriche."
    ],
    "fr": [
      "Tout au long de l'année, la compagnie vous propose des croisières restaurant sur le plus grand lac naturel de France, le canal de Savières et le Haut Rhône sur des bateaux à motorisation 100% électrique."
    ],
    "nl": [
      "Het hele jaar door biedt het bedrijf restaurantcruises aan op het grootste natuurlijke meer van Frankrijk, het kanaal van Savières en de Boven-Rhône op 100% elektrisch aangedreven boten."
    ],
    "es": [
      "A lo largo de todo el año, la empresa ofrece cruceros-restaurante por el lago natural más grande de Francia, el Canal de Savières y el Alto Ródano en embarcaciones de propulsión 100% eléctrica."
    ]
  },
