  "rdfs:comment": {
    "de": [
      "Der Eismacher Les Glaces de Léon bietet hausgemachte Kreationen aus hochwertigen Produkten, bei denen der authentische Geschmack und das handwerkliche Können im Vordergrund stehen."
    ],
    "en": [
      "Les Glaces de Léon, an artisan ice cream maker, offers homemade creations made with quality products, showcasing authentic taste and artisanal know-how."
    ],
    "it": [
      "Les Glaces de Léon, gelataio artigianale, propone creazioni artigianali realizzate con prodotti di qualità, onorando il gusto autentico e il know-how tradizionale."
    ],
    "fr": [
      "Les Glaces de Léon, artisan glacier, propose des créations maison élaborées avec des produits de qualité, mettant à l’honneur le goût authentique et le savoir-faire artisanal."
    ],
    "es": [
      "Les Glaces de Léon, heladería artesanal, ofrece creaciones caseras elaboradas con productos de calidad, haciendo honor al sabor auténtico y al saber hacer tradicional."
    ],
    "nl": [
      "Bij Léon is alles huisgemaakt! Kies uit verschillende smaken bolletjesijs of Italiaans ijs, ijslollies, heerlijke crêpes en wafels, granita’s, verse fruitsappen, milkshakes, churros... er is voor ieder wat wils!"
    ]
  },
