  "rdfs:comment": {
    "de": [
      "Die Cave Monge Granon wurde 1985 von zwei Winzerfamilien gegründet, die eine gemeinsame Leidenschaft verbindet. Sie lebt im Rhythmus ihrer 43 Hektar Weinberge im Herzen des Rhônetals und des Landes der Clairette."
    ],
    "en": [
      "Founded in 1985 by 2 families of winegrowers united by the same passion, Cave Monge Granon lives to the rhythm of its 43 hectares of vines in the heart of the Rhône valley and the Clairette region."
    ],
    "it": [
      "Fondata nel 1985 da due famiglie di viticoltori unite dalla stessa passione, la Cave Monge Granon vive al ritmo dei suoi 43 ettari di vigne nel cuore della Valle del Rodano e della regione della Clairette."
    ],
    "fr": [
      "Fondée en 1985 par 2 familles de vignerons réunies par une même passion, la Cave Monge Granon vit au rythme de ses 43 hectares de vignes au cœur de la vallée du Rhône et du pays de la Clairette."
    ],
    "nl": [
      "Opgericht in 1985 door 2 wijnbouwfamilies verenigd door dezelfde passie, leeft de Cave Monge Granon op het ritme van zijn 43 hectare wijnstokken in het hart van de Rhônevallei en de Clairette."
    ],
    "es": [
      "Fundada en 1985 por 2 familias viticultoras unidas por la misma pasión, la Cave Monge Granon vive al ritmo de sus 43 hectáreas de viñedos en el corazón del valle del Ródano y de la región de Clairette."
    ]
  },
  "rdfs:label": {
