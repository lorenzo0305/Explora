  "rdfs:comment": {
    "de": [
      "Wie wäre es, wenn Sie sich bei einem Mittagessen auf dem Monteynard-See von den Fluten treiben lassen..."
    ],
    "en": [
      "Enjoy the pleasure of a fine lunch while crossing the blue waters of Monteynard lake..."
    ],
    "it": [
      "E se ci si lascia trasportare dalle onde, il tempo di un pranzo sul lago di Monteynard..."
    ],
    "fr": [
      "Et si vous vous laissiez porter par les flots, le temps d'un déjeuner sur le lac du Monteynard..."
    ],
    "es": [
      "Y si te dejas llevar por las olas, el momento de un almuerzo en el lago de Monteynard..."
    ],
    "nl": [
      "Genieten van een fijne lunch aan boord van LA MIRA boot en de blauwe wateren van de Monteynard meer..."
    ]
  },
