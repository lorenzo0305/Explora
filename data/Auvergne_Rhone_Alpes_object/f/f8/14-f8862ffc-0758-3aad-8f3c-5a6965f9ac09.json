      "dc:description": {
        "de": [
          "Im Rahmen der Allerheiligenferien können Sie die Tür des Museums für Geschichte und Archäologie aufstoßen und den Mammuts begegnen."
        ],
        "en": [
          "As part of the All Saints? vacation, push open the door of the Museum of History and Archaeology and come and meet the mammoths."
        ],
        "it": [
          "Nell'ambito della festa di Ognissanti, aprite la porta del Museo di Storia e Archeologia e venite a conoscere i mammut."
        ],
        "fr": [
          "Dans le cadre des vacances de la Toussaint, poussez la porte du Musée d’Histoire et d’Archéologie et venez à la rencontre des mammouths."
        ],
        "nl": [
          "Duw in het kader van de Allerheiligenvakantie de deur van het Museum voor Geschiedenis en Archeologie open en kom de mammoeten ontmoeten."
        ],
        "es": [
          "Con motivo de la festividad de Todos los Santos, abra de un empujón la puerta del Museo de Historia y Arqueología y venga a conocer a los mamuts."
        ]
      },
