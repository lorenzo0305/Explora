  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Cosy in einem wunderschönen Dorf. Weinliebhaber, Liebhaber von lokalen und belgischen Bieren, Happy Hours, verschiedene Tapas, Pizzas und gute Burger warten darauf, von Ihnen entdeckt zu werden!"
    ],
    "en": [
      "Come and discover Le Cosy in a gorgeous village at the foot of the slopes of La Plagne (Paradiski®): a warm welcome in a traditional Savoyard setting."
    ],
    "it": [
      "Venite a scoprire Le Cosy in un bellissimo villaggio. Amanti del vino, appassionati di birre locali e belghe, happy hour, una varietà di tapas, pizze e buoni hamburger da scoprire!"
    ],
    "fr": [
      "Venez découvrir Le Cosy dans un magnifique village. Amoureux du vin, amateur de bières locales et Belge, happy hours, tapas variées, pizzas et bon burgers à découvrir !"
    ],
    "es": [
      "Venga a descubrir Le Cosy en un bonito pueblo. ¡Amantes del vino, aficionados a las cervezas locales y belgas, happy hours, variedad de tapas, pizzas y buenas hamburguesas por descubrir!"
    ],
    "nl": [
      "Kom Le Cosy ontdekken in een zeer mooi dorp aan de voet van de skipistes van La Plagne (Paradiski®) : U krijgt een warm onthaal in een typisch savoyard decor."
    ]
  },
