  "rdfs:comment": {
    "de": [
      "in der Kulisse des Château de la Roche werden Ihnen zwei Escape Games angeboten.\r\nin \"Submersion Alert\" versuchen Sie, dem Ertrinken zu entkommen, und in \"Spirit Are You There?\" versuchen Sie, den Geist zu befreien, der im Schloss herumspukt.\r\n60 Minuten, um die Rätsel zu lösen und den Raum zu verlassen."
    ],
    "en": [
      "2 escape games are offered in the setting of the Château de la Roche.\r\n\"Alerte Submersion\", try to escape drowning, and \"Esprit es-tu là?\", try to free the spirit haunting the château.\r\n60 minutes to solve the riddles and get out of the room."
    ],
    "it": [
      "2 giochi di fuga sono proposti nella cornice del Castello della Roche.\r\n\"Alerte Submersion\", cerca di sfuggire all'annegamento e \"Esprit es-tu là?\", cerca di liberare lo spirito che infesta il castello.\r\n60 minuti per risolvere gli enigmi e uscire dalla stanza."
    ],
    "fr": [
      "2 escape games vous sont proposés dans le décor du château de la Roche.\r\n\"Alerte Submersion\", tentez d'échapper à la noyade et \"Esprit es-tu là?\", tentez de libérer l'esprit qui hante le château.\r\n60 min pour résoudre les énigmes et sortir de la pièce."
    ],
    "es": [
      "se proponen 2 juegos de escape en el marco del Château de la Roche.\r\n\"Alerte Submersion\", intente escapar de ahogarse y \"Esprit es-tu là?\", intente liberar al espíritu que ronda el castillo.\r\n60 minutos para resolver los enigmas y salir de la habitación."
    ],
    "nl": [
      "er worden 2 ontsnappingsspellen aangeboden in het decor van het Château de la Roche.\r\n\"Alerte Submersion\", probeer te ontsnappen aan verdrinking en \"Esprit es-tu là?\", probeer de geest te bevrijden die rondwaart in het kasteel.\r\n60 minuten om de raadsels op te lossen en uit de kamer te komen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Games du château de la Roche"
    ]
  },
