  "rdfs:comment": {
    "de": [
      "Ziel der Herausforderung: Den Mézenc in 24 Stunden so oft wie möglich zu besteigen.\r\nOffen für alle Trail- und Bergbegeisterten.\r\nGesellige Atmosphäre, Verpflegungsstationen, Animationen und der Geist des Übertreffens."
    ],
    "en": [
      "Challenge objective: to climb the Mezenc as many times as possible in 24 hours.\r\nOpen to all trail and mountain enthusiasts.\r\nFriendly atmosphere, refreshments, entertainment and a spirit of challenge."
    ],
    "it": [
      "Obiettivo della sfida: scalare il Mezenc il maggior numero di volte possibile in 24 ore.\r\nAperta a tutti gli appassionati di trail e di montagna.\r\nAtmosfera amichevole, ristoro, intrattenimento e spirito di sfida."
    ],
    "fr": [
      "Objectif du défi: faire le plus grand nombre d'ascension du Mézenc en 24h.\r\nOuvert à tous les passionnés de trail et de montagne.\r\nAmbiance conviviale, ravitaillements, animations et esprit de dépassement."
    ],
    "nl": [
      "Het doel van de uitdaging: zo vaak mogelijk de Mezenc beklimmen in 24 uur.\r\nOpen voor alle trail- en bergliefhebbers.\r\nVriendelijke sfeer, verfrissingen, entertainment en een geest van uitdaging."
    ],
    "es": [
      "El objetivo del desafío: subir al Mezenc tantas veces como sea posible en 24 horas.\r\nAbierto a todos los aficionados al trail y a la montaña.\r\nAmbiente amistoso, refrescos, entretenimiento y espíritu de desafío."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Défi \"Charly Mézenc\""
    ]
  },
