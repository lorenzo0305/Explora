  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1ca4b53a-4dc3-36d2-a262-bad07edfbc99",
      "dc:description": {
        "de": [
          "Ausbildung von neuen Fahrern.\nAusbildung für die Führerscheine B, AAC, Automatikgetriebe und Zweiradausbildung.\nKorrekturen und Code-Kurse von einem Lehrer durchgeführt.\n\nÖffnungszeiten der Schule:\nMittwoch von 16:00 bis 18:00 Uhr\nFreitag 18 Uhr\nSamstag 14 Uhr\n\nIm August geschlossen"
        ],
        "en": [
          "Training for new drivers.\nTraining for B, AAC, automatic gearbox and 2-wheel licenses.\nCode correction and lessons given by a teacher.\n\nOpening hours:\nWednesday from 16h to 18h\nFriday 18h\nSaturday 2pm\n\nClosed in August"
        ],
        "it": [
          "Formazione per neopatentati.\nFormazione per patenti B, AAC, cambio automatico e 2 ruote.\nCorrezione del codice e lezioni impartite da un insegnante.\n\nOrari di apertura:\nMercoledì dalle 16 alle 18\nVenerdì ore 18\nSabato 14:00\n\nChiuso in agosto"
        ],
        "fr": [
          "Formation des nouveaux conducteurs. \nFormation aux permis B, AAC, boîte automatique et formation 2 roues. \nCorrection et cours de code effectué par un enseignant.\n\nHoraires d'ouverture:\nMercredi de 16h a 18h\nVendredi 18h\nSamedi 14h\n\nFermeture au mois d'août"
        ],
        "nl": [
          "Training voor nieuwe bestuurders.\nTraining voor rijbewijzen B, AAC, automatische versnellingsbak en 2-wielig rijden.\nCodecorrectie en lessen gegeven door een leraar.\n\nOpeningstijden:\nWoensdag van 16u tot 18u\nVrijdag van 18u\nZaterdag 14u\n\nGesloten in augustus"
        ],
        "es": [
          "Formación para nuevos conductores.\nFormación para los permisos de conducción B, AAC, caja de cambios automática y 2 ruedas.\nCorrección de códigos y lecciones impartidas por un profesor.\n\nHorario de apertura:\nMiércoles de 16h a 18h\nViernes 18h\nSábado 14h\n\nCerrado en agosto"
        ]
      },
