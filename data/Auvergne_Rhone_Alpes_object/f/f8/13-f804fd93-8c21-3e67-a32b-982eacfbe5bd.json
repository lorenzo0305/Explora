  "rdfs:comment": {
    "de": [
      "L'Écurie des Nauds wurde von Audrey Benoist gegründet. Sie ist eine leidenschaftliche Reiterin und bietet Kurse für alle Altersgruppen, Baby-Ponys, Voltigieren, Ferienkurse sowie Pferdepension und -pflege an."
    ],
    "en": [
      "L?Écurie des Nauds was founded by Audrey Benoist, a passionate horsewoman who offers lessons for all ages, baby pony, acrobatics, vacation courses and horse boarding and care."
    ],
    "it": [
      "L'Écurie des Nauds è stata fondata da Audrey Benoist, un'appassionata cavallerizza che offre lezioni per tutte le età, baby pony, volteggio, corsi di vacanza e pensione e cura dei cavalli."
    ],
    "fr": [
      "L’Écurie des Nauds fondée par Audrey Benoist, passionnée d’équitation, elle propose cours pour tous âges, baby poney, voltige, stages vacances ainsi que pension et soins pour chevaux."
    ],
    "nl": [
      "L'Écurie des Nauds is opgericht door Audrey Benoist, een gepassioneerde amazone die lessen aanbiedt voor alle leeftijden, baby pony, voltigeren, vakantiecursussen en paardenpension en -opvang."
    ],
    "es": [
      "L'Écurie des Nauds fue fundada por Audrey Benoist, una amazona apasionada que ofrece clases para todas las edades, baby pony, volteo, cursos de vacaciones y pupilaje y cuidado de caballos."
    ]
  },
