  "rdfs:comment": {
    "de": [
      "Der Picknickplatz von Saint-Just-en-Chaussée liegt am Rande der Teiche und bietet eine natürliche und angenehme Mittagspause. Sie ist mit Tischen für Ihren Komfort ausgestattet."
    ],
    "en": [
      "Located on the edge of the ponds, the picnic area of Saint-Just-en-Chaussée offers a natural and pleasant break for lunch. It is equipped with tables for your comfort."
    ],
    "it": [
      "Situata ai margini degli stagni, l'area picnic di Saint-Just-en-Chaussée offre una pausa naturale e piacevole per il pranzo. È dotata di tavoli per il vostro comfort."
    ],
    "fr": [
      "Située au bord des étangs, l'aire de pique-nique de Saint-Just-en-Chaussée offre une pause naturelle et agréable pour un déjeuner. Elle est aménagée avec des tables pour votre confort."
    ],
    "es": [
      "Situada al borde de los estanques, la zona de picnic de Saint-Just-en-Chaussée ofrece una pausa natural y agradable para comer. Está equipado con mesas para su comodidad."
    ],
    "nl": [
      "De picknickplaats van Saint-Just-en-Chaussée, gelegen aan de rand van de vijvers, biedt een natuurlijke en aangename lunchpauze. Het is uitgerust met tafels voor uw comfort."
    ]
  },
  "rdfs:label": {
