  "rdfs:comment": {
    "de": [
      "Die Brasserie St Jean ist wie ein zweites Zuhause.\r\nHier wird gegessen, getrunken, diskutiert und ab und zu findet ein \"großes Ereignis\" statt."
    ],
    "en": [
      "The Brasserie St Jean is like a second home.\r\nWe eat, we drink, we talk and, from time to time, a \"big event\" happens."
    ],
    "it": [
      "La Brasserie St Jean è come una seconda casa.\r\nSi mangia, si beve, si chiacchiera e, di tanto in tanto, c'è un \"grande evento\"."
    ],
    "fr": [
      "La Brasserie St Jean, c’est comme une deuxième maison.\r\nOn y mange, on y boit, on y discute et, de temps en temps, il s’y passe un « grand événement »."
    ],
    "es": [
      "La Brasserie St Jean es como un segundo hogar.\r\nComemos, bebemos, charlamos y, de vez en cuando, hay un \"gran evento\"."
    ],
    "nl": [
      "De Brasserie St Jean is als een tweede thuis.\r\nWe eten, drinken, kletsen en van tijd tot tijd is er een \"grote gebeurtenis\"."
    ]
  },
