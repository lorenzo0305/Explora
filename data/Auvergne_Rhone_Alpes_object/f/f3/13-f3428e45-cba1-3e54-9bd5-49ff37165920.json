  "rdfs:comment": {
    "de": [
      "Ein festliches Restaurant in der Höhe, das zu Fuß, auf Skiern oder mit dem Auto erreichbar ist. Hier gibt es gutes Essen, gute Weine und frische Produkte... und wir sind vor allem für unsere festlichen Après-Ski-Partys bekannt, die man sich nicht entgehen lassen sollte!"
    ],
    "en": [
      "Festive mountain restaurant, accessible on foot, by ski or by car. Here you eat well, enjoy great wines, fresh products… and we’re especially famous for our unforgettable après-ski parties!"
    ],
    "it": [
      "Un ristorante festoso in quota, raggiungibile a piedi, con gli sci o in auto. Qui potrete gustare buon cibo, vini pregiati e prodotti freschi... e siamo particolarmente noti per le nostre imperdibili feste del dopo sci!"
    ],
    "fr": [
      "Restaurant festif en altitude, accessible à pied, en ski ou en voiture. Ici on mange bien, on déguste de bons vins, des produits frais… et on est surtout très connu pour nos après-skis festifs incontournables !"
    ],
    "es": [
      "Un restaurante festivo en las alturas, accesible a pie, con esquís o en coche. Aquí podrá disfrutar de buena comida, buenos vinos y productos frescos... ¡y somos especialmente conocidos por nuestras ineludibles fiestas après-ski!"
    ],
    "nl": [
      "Een feestelijk restaurant op hoogte, bereikbaar te voet, op ski's of met de auto. Hier kun je genieten van lekker eten, goede wijnen en verse producten... en we staan vooral bekend om onze niet te missen après-ski festiviteiten!"
    ]
  },
