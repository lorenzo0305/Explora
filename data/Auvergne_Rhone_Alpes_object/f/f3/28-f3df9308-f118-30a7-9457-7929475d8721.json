  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: Der Wirt stellt an manchen Abenden ziemlich coole Konzerte von guten lokalen Bands auf die Beine."
    ],
    "en": [
      "You'll love: the owner puts on some pretty cool concerts by good local bands on certain evenings."
    ],
    "it": [
      "Vi piacerà: il proprietario organizza in alcune serate dei concerti molto belli con ottime band locali."
    ],
    "fr": [
      "Vous aimerez : le patron met en place des concerts plutôt sympas de bons groupes locaux certains soirs."
    ],
    "es": [
      "Te encantará: el dueño organiza conciertos muy chulos con buenos grupos locales algunas noches."
    ],
    "nl": [
      "Je zult het geweldig vinden: de eigenaar organiseert op bepaalde avonden leuke concerten met goede lokale bands."
    ]
  },
