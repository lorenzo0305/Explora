  "rdfs:comment": {
    "de": [
      "Bistronomie auf der Grundlage lokaler, hauptsächlich biologischer Produkte, vegetarische Gerichte.\r\nMenü: 36€ und Speisekarte.\r\nMarktküche, saisonale Produkte, wechselnde Speisekarte je nach Jahreszeit, Verkauf von Emkipop-Eis zum Mitnehmen oder vor Ort. Panoramaterrassen."
    ],
    "en": [
      "Fresh market cuisine cooked with cooked with organic seasonal products. The menu is changing according to the season.  ice-creams to eat-in or to take away. Panoramic terraces."
    ],
    "it": [
      "Bistronomia basata su prodotti locali, prevalentemente biologici, piatti vegetariani.\r\nMenu: 36? e à la carte.\r\nCucina di mercato, prodotti di stagione, menu che cambia con le stagioni, gelati Emkipop da asporto o da consumare. Terrazze panoramiche."
    ],
    "fr": [
      "Bistronomie à base de produits locaux essentiellement bio, plats végétariens. \r\nMenu : 36€ et carte. \r\nCuisine du marché, produits saisonniers, menu changeant au grès des saisons, vente de glaces Emkipop à emporter ou sur place. Terrasses panoramiques."
    ],
    "nl": [
      "Bistronomie op basis van lokale, voornamelijk biologische producten, vegetarische gerechten.\r\nMenu: €36 en à la carte menu.\r\nMarktkeuken, seizoensproducten, menu wisselt met de seizoenen, Emkipop-ijs verkrijgbaar om mee te nemen of om te eten. Panoramische terrassen."
    ],
    "es": [
      "Bistronomía basada en productos locales, principalmente ecológicos, platos vegetarianos.\r\nMenú: 36? y a la carta.\r\nCocina de mercado, productos de temporada, carta que cambia con las estaciones, helados Emkipop para llevar o comer en el restaurante. Terrazas panorámicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Chez So"
    ]
  },
