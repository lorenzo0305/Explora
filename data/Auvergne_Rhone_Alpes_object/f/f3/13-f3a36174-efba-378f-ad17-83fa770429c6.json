  "rdfs:comment": {
    "de": [
      "Es war einmal … das Haus der Märchen ... Ein einzigartiges und magisches Museum mit Märchenfiguren und kleinen Szenen aus Märchen, die im Verlauf der erzählten Geschichte in zauberhaftem Dekor beleuchtet werden. Hier haben Große und Kleine ihre Freude!"
    ],
    "en": [
      "Once upon a time... the House of Fairy Tales... A magical and unusual museum with animated playlets and characters, brought to life using light effects while stories are told in enchanting settings... for the delight of young and old alike!"
    ],
    "it": [
      "La Maison des Contes de Fées è una piccola struttura familiare gestita da appassionati delle fiabe tradizionali. Un’esposizione appreziata dai bambini e dagli adulti che ci trasporta nello mondo feerico delle fiabe di “Sinderella” “Biancaneve”..."
    ],
    "fr": [
      "Il était une fois... la Maison des Contes de fées... un petit monde insolite et magique de personnages et de scénettes animées, qui s'illuminent au gré de l'histoire racontée dans des décors enchanteurs...pour le plaisir de tous, petits et grands !"
    ],
    "es": [
      "Érase una vez... la Casa de los Cuentos de Hadas... un pequeño, insólito y mágico mundo de personajes y escenas animadas, que se iluminan a medida que se cuenta la historia en escenarios encantadores... ¡para el placer de todos, grandes y pequeños!"
    ],
    "nl": [
      "Eens op tijd... The House of Fairy Tales... een ongewone en magische wereld vol personages en geanimeerde scripts, die oplicht terwijl het verhaal zich ontvouwt in een betoverend landschap... voor het plezier van iedereen, jong en oud!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Museum \"La Maison des Contes de Fées\" (Das Haus der Märchen)"
    ],
    "en": [
      "Fairy Tale House Museum"
    ],
    "it": [
      "Museo della Casa delle Fiabe"
    ],
    "fr": [
      "Musée \"La Maison des Contes de Fées\""
    ],
    "nl": [
      "Sprookjeshuis Museum"
    ]
  },
