  "rdfs:comment": {
    "de": [
      "In der \"Petite Cité de Caractère\" von Marcolès empfängt Sie Nelly in ihrem Institut-Spa - Wellness \"Côté Jardin\"."
    ],
    "en": [
      "Come and discover the outdoor jacuzzi with its relaxation area, the hammam and the Flotarium, unique in Auvergne: a floating bath reproducing the relaxing effect of the Dead Sea salts, immersed in complete weightlessness for a deep relaxation of body and mind."
    ],
    "it": [
      "Situata nella \"Petite Cité de Caractère\" di Marcolès, Nelly vi accoglie nel suo istituto termale \"Côté Jardin\"."
    ],
    "fr": [
      "Situé dans la Petite Cité de Caractère de Marcolès, Nelly vous accueille dans son institut-spa - bien-être “Côté Jardin”."
    ],
    "es": [
      "Situada en la \"Petite Cité de Caractère\" de Marcolès, Nelly le da la bienvenida a su instituto termal \"Côté Jardin\"."
    ],
    "nl": [
      "Kom en ontdek de buitenjacuzzi met ontspanningsruimte, de hammam en het Flotarium, uniek in de Auvergne: een floatbad dat het ontspannende effect van het Dode Zeezout reproduceert, ondergedompeld in volledige gewichtloosheid voor een diepe ontspanning van lichaam en geest."
    ]
  },
  "rdfs:label": {
    "en": [
