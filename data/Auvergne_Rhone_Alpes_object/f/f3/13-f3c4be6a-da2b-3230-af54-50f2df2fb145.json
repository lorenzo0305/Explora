  "rdfs:comment": {
    "de": [
      "Ein Museumsbereich und wissenschaftliche Veranstaltungen zum Experimentieren, Entdecken und Staunen! Ausstellungen, Workshops und Animationen, Experimentalshows und interaktive Spiele, Vorträge und Debatten, Zugang zur digitalen Kultur?"
    ],
    "en": [
      "A museum space and scientific activities to experiment, discover and marvel! Exhibitions, workshops and events, experimental shows and interactive games, conferences and debates, access to digital culture…"
    ],
    "it": [
      "Uno spazio museografico ed eventi scientifici per sperimentare, scoprire e stupirsi! Mostre, laboratori e attività, spettacoli sperimentali e giochi interattivi, conferenze e dibattiti, accesso alla cultura digitale?"
    ],
    "fr": [
      "Un espace muséographique et des animations scientifiques pour expérimenter, découvrir et s’émerveiller ! Expositions, ateliers et animations, shows expérimentaux et jeux interactifs, conférences et débats, accès à la culture numérique…"
    ],
    "es": [
      "¡Un espacio museográfico y eventos científicos para experimentar, descubrir y maravillarse! Exposiciones, talleres y actividades, espectáculos experimentales y juegos interactivos, conferencias y debates, acceso a la cultura digital.."
    ],
    "nl": [
      "Een museumruimte en wetenschappelijke activiteiten om te experimenteren, ontdekken en verwonderen! Tentoonstellingen, workshops en evenementen, experimentele shows en interactieve games, conferenties en debatten, toegang tot digitale cultuur…"
    ]
  },
