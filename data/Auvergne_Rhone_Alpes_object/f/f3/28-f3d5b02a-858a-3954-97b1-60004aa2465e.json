  "rdfs:comment": {
    "de": [
      "In einem wunderschönen Rahmen aus Kurven und Arabesken, Farben und Lichtern lädt Sie das Restaurant La Villa d'Ilse zu einer raffinierten Küche ein."
    ],
    "en": [
      "In a magnificent setting made of curves and arabesques, colours and lights, the Villa d'Ilse restaurant invites you to taste a refined cuisine."
    ],
    "it": [
      "In una magnifica cornice di curve e arabeschi, colori e luci, il ristorante Villa d'Ilse vi invita a gustare una cucina raffinata."
    ],
    "fr": [
      "Dans un cadre magnifique fait de courbes et d'arabesques, de couleurs et de lumières, le restaurant la Villa d'Ilse vous invite à la dégustation d'une cuisine raffinée."
    ],
    "nl": [
      "In een prachtig decor van rondingen en arabesken, kleuren en licht, nodigt het restaurant Villa d'Ilse u uit om te genieten van een verfijnde keuken."
    ],
    "es": [
      "En un magnífico entorno de curvas y arabescos, colores y luces, el restaurante Villa d'Ilse le invita a disfrutar de una cocina refinada."
    ]
  },
