  "rdfs:comment": {
    "de": [
      "Entdecken Sie Saint-Romain de Jalionas, das im Westen der Balcons du Dauphiné im Norden der Isère liegt. Die gallo-römische Ausgrabungsstätte und der experimentelle Garten zählen zu den wertvollsten Erbgutschätzen der Balcons du Dauphiné!"
    ],
    "en": [
      "Discover Saint-Romain de Jalionas, located to the west of the Balcons du Dauphiné in northern Isère. The Gallo-Roman archaeological site and the experimental garden are among the Balcons du Dauphiné?s most precious heritage treasures!"
    ],
    "it": [
      "Scoprite Saint-Romain de Jalionas, situata a ovest dei Balcons du Dauphiné, nell'Isère settentrionale. Il sito archeologico gallo-romano e il giardino sperimentale sono tra i beni più preziosi del patrimonio dei Balcons du Dauphiné!"
    ],
    "fr": [
      "Découvrez Saint-Romain de Jalionas, situé à l’ouest des Balcons du Dauphiné en nord Isère. Le site archéologique gallo-romain et le jardin expérimental comptent parmi les plus précieuses richesses patrimoniales des Balcons du Dauphiné !"
    ],
    "nl": [
      "Ontdek Saint-Romain de Jalionas, gelegen ten westen van de Balcons du Dauphiné in het noorden van de Isère. De Gallo-Romeinse archeologische site en de proeftuin behoren tot het meest waardevolle erfgoed van de Balcons du Dauphiné!"
    ],
    "es": [
      "Descubra Saint-Romain de Jalionas, situado al oeste de los Balcons du Dauphiné, en el norte de Isère. El yacimiento arqueológico galo-romano y el jardín experimental figuran entre los bienes patrimoniales más valiosos de los Balcons du Dauphiné"
    ]
  },
