  "rdfs:comment": {
    "de": [
      "Die Bains du Mont-Blanc liegen ideal in einem wunderschönen 10 Hektar großen Park und sind wie eine Initiationsreise in das Herz der tausendjährigen Felsen gestaltet."
    ],
    "en": [
      "Ideally located in a magnificent 10-hectare park, the Thermal Baths are designed as an initiatory journey. Time stops when the experience begins."
    ],
    "it": [
      "Situate in un magnifico parco di 10 ettari, le Terme sono concepite come un viaggio iniziatico. Il tempo si ferma quando inizia l'esperienza."
    ],
    "fr": [
      "Idéalement situés dans un magnifique parc de 10 hectares, les Bains du Mont-Blanc sont conçus comme un voyage initiatique au cœur des roches millénaires, le temps s'arrête quand l'expérience débute."
    ],
    "es": [
      "Idealmente situados en un magnífico parque de 10 hectáreas, los Bains du Mont-Blanc están concebidos como un viaje iniciático al corazón de las rocas milenarias, donde el tiempo se detiene cuando comienza la experiencia."
    ],
    "nl": [
      "De Bains du Mont-Blanc, ideaal gelegen in een prachtig park van 10 hectare, zijn ontworpen als een inwijdingsreis naar het hart van de duizend jaar oude rotsen, waar de tijd stopt en de ervaring begint."
    ]
  },
  "rdfs:label": {
