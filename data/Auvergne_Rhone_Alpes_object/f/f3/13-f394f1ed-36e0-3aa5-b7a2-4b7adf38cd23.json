  "rdfs:comment": {
    "de": [
      "Willkommen im Restaurant DIONYSOS, einem gemütlichen und familiären Lokal in Bourgoin-Jallieu, in der Nähe der Zone d'Activité de la Maladière.\r\nWir heißen Sie freundlich willkommen, ob mit der Familie oder mit Freunden."
    ],
    "en": [
      "Welcome to the DIONYSOS restaurant, a warm, family-run establishment located in Bourgoin-Jallieu, near the Zone d?Activité de la Maladière.\r\nWe look forward to welcoming you, whether with family or friends, in a convivial setting."
    ],
    "it": [
      "Benvenuti al ristorante DIONYSOS, un locale accogliente e familiare situato a Bourgoin-Jallieu, vicino alla Zone d'Activité de la Maladière.\r\nSaremo lieti di accogliere voi, la vostra famiglia o i vostri amici, in un'atmosfera amichevole."
    ],
    "fr": [
      "Bienvenue au restaurant DIONYSOS, un établissement chaleureux et familial situé à Bourgoin-Jallieu, à proximité de la Zone d’Activité de la Maladière.\r\nNous vous accueillons avec bienveillance, que ce soit en famille ou entre amis, dans un cadre convivial."
    ],
    "nl": [
      "Welkom bij restaurant DIONYSOS, een warm familiebedrijf in Bourgoin-Jallieu, vlakbij de Zone d'Activité de la Maladière.\r\nWe kijken ernaar uit om u, uw familie of vrienden te verwelkomen in een gezellige sfeer."
    ],
    "es": [
      "Bienvenido al restaurante DIONYSOS, un establecimiento cálido y familiar situado en Bourgoin-Jallieu, cerca de la Zone d'Activité de la Maladière.\r\nEstaremos encantados de recibirle a usted, a su familia o a sus amigos en un ambiente acogedor."
    ]
  },
