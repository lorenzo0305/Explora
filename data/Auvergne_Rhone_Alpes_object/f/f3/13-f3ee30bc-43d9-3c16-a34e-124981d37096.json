  "rdfs:comment": {
    "de": [
      "Wenn Sie durch die Tür der Bibliothek von La Sure en Chartreuse gehen, werden Sie Teil des Netzwerks der 19 Bibliotheken im Pays Voironnais. Mit einer einzigen Karte und einem einzigen Tarif können Sie alle Dienstleistungen der Bibliotheken in Anspruch nehmen."
    ],
    "en": [
      "Passing through the door of the La Sure en Chartreuse library means joining the network of 19 libraries in the Pays Voironnais. A single card, a single price to access all the services offered by the libraries."
    ],
    "it": [
      "Varcare la porta della biblioteca La Sure en Chartreuse significa entrare nella rete delle 19 biblioteche del Pays Voironnais. Un'unica tessera, un unico prezzo per accedere a tutti i servizi offerti dalle biblioteche."
    ],
    "fr": [
      "Passer la porte de la bibliothèque de La Sure en Chartreuse, c’est entrer dans le réseau des 19 bibliothèques en Pays Voironnais. Une carte unique, un tarif unique pour accéder à l’ensemble des services proposés par les bibliothèques."
    ],
    "es": [
      "Pasar por la puerta de la biblioteca La Sure en Chartreuse significa unirse a la red de 19 bibliotecas del Pays Voironnais. Un carné único, un precio único para acceder a todos los servicios que ofrecen las bibliotecas."
    ],
    "nl": [
      "Als je de deur van de bibliotheek La Sure en Chartreuse binnengaat, sluit je je aan bij het netwerk van 19 bibliotheken in het Pays Voironnais. Eén kaart, één prijs voor toegang tot alle diensten van de bibliotheken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque de La Sure en Chartreuse"
    ]
  },
