  "rdfs:comment": {
    "de": [
      "LE TRAM liegt ideal in Saint-Péray, 10min von Valence und 1h von Lyon und Grenoble entfernt. Sie können die Räumlichkeiten in der Atmosphäre eines Industriebahnhofs für Ihre Seminare und andere Versammlungen mieten."
    ],
    "en": [
      "Ideally located in Saint-Péray, 10min from Valence, 1h from Lyon and Grenoble, LE TRAM offers you the opportunity to rent its premises in an industrial railway station atmosphere for your seminars and other meetings."
    ],
    "it": [
      "Situato in posizione ideale a Saint-Péray, a 10 minuti da Valence e a 1 ora da Lione e Grenoble, LE TRAM vi offre la possibilità di affittare i suoi locali in un'atmosfera da stazione industriale per i vostri seminari e altre riunioni."
    ],
    "fr": [
      "Idéalement placé à Saint-Péray, à 10min de Valence, à 1h de Lyon et de Grenoble, LE TRAM vous propose de louer ses locaux dans une ambiance de gare industrielle pour vos séminaires et autres réunions."
    ],
    "es": [
      "Idealmente situado en Saint-Péray, a 10 minutos de Valence y a 1 hora de Lyon y Grenoble, LE TRAM le ofrece la posibilidad de alquilar sus locales en un ambiente de estación industrial para sus seminarios y otras reuniones."
    ],
    "nl": [
      "Ideaal gelegen in Saint-Péray, op 10 minuten van Valence en 1 uur van Lyon en Grenoble, biedt LE TRAM u de mogelijkheid om zijn lokalen in een industriële stationssfeer te huren voor uw seminars en andere bijeenkomsten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Tram - La Salle"
    ]
  },
