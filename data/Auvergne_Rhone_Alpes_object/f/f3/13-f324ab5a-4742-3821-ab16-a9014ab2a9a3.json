  "rdfs:comment": {
    "de": [
      "1,5-stündige kommentierte Bootsfahrt auf dem Fluss Isère, die in St Nazaire en Royans beginnt und endet. Historische Annäherung an die Orte und Dörfer, die Sie durchqueren, sowie seine Fauna und Flora."
    ],
    "en": [
      "Guided cruise on the Isère River aboard a Mississippi-style boat (1h30). Possibility to depart from St Nazaire en Royans or La Sône. Panoramic view on the calm waters of the Isère River in a lush setting where nature intermingles with history."
    ],
    "it": [
      "Crociera guidata di 1,5 ore sul fiume Isère, con partenza e ritorno da St Nazaire en Royans. Imparate a conoscere la storia dei luoghi e dei villaggi attraversati, nonché la flora e la fauna del fiume."
    ],
    "fr": [
      "Croisière d'1 h 30 commentée sur la rivière de l'Isère, au départ et retour de St Nazaire en Royans. Approche historique des lieux et villages traversés, ainsi que sa faune et sa flore."
    ],
    "es": [
      "Un crucero guiado de 1,5 horas por el río Isère, con salida y regreso a St Nazaire en Royans. Conozca la historia de los lugares y pueblos por los que pasa, así como la flora y la fauna del río."
    ],
    "nl": [
      "Een 1,5 uur durende rondvaart op de Isère, met vertrek en terugkomst in St Nazaire en Royans. Leer meer over de geschiedenis van de plaatsen en dorpen die je passeert en over de flora en fauna van de rivier."
    ]
  },
  "rdfs:label": {
    "en": [
      "Royans Vercors Sternwheeler Tour"
    ],
    "fr": [
      "Bateau à Roue Royans Vercors"
    ]
  },
