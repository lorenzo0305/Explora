  "rdfs:comment": {
    "de": [
      "Laura Carmouze nimmt Sie mit auf eine Odyssee der Lichter, eine innere Erkundung, die mit Träumen spielt, mit Farbtupfern, Melodien von Oberflächen und Materialien.\r\nEntdecken Sie ihre Arbeit im La Coccinelle!"
    ],
    "en": [
      "Laura Carmouze takes you on an odyssey of light, an inner exploration that plays with dreams, with touches of color and a mishmash of surfaces and materials.\r\nCome and discover her work at La Coccinelle!"
    ],
    "it": [
      "Laura Carmouze vi accompagna in un'odissea di luce, un'esplorazione interiore che gioca con i sogni, con tocchi di colore e con un miscuglio di superfici e materiali.\r\nVenite a scoprire il suo lavoro a La Coccinelle!"
    ],
    "fr": [
      "Laura Carmouze vous embarque dans une odyssée des Lumières, une exploration intérieure qui se joue des rêves, par touches de couleurs, méli-mélo de surfaces et de matières.\r\nVenez découvrir son travail à la Coccinelle !"
    ],
    "es": [
      "Laura Carmouze te lleva a una odisea de la luz, una exploración interior que juega con los sueños, con toques de color y un batiburrillo de superficies y materiales.\r\nVenga a descubrir su obra en La Coccinelle"
    ],
    "nl": [
      "Laura Carmouze neemt je mee op een odyssee van licht, een innerlijke verkenning die speelt met dromen, met vleugjes kleur en een mengelmoes van oppervlakken en materialen.\r\nKom haar werk ontdekken bij La Coccinelle!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition \"Sur le sentier de tes songes\" de Laura Carmouze"
    ]
  },
