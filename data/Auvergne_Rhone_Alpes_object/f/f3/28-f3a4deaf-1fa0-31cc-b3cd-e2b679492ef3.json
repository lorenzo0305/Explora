  "rdfs:comment": {
    "de": [
      "Mürbeteiggebäck, süße und herzhafte Kekse, die vor Ort aus Weizen und Eiern des Betriebs hergestellt werden.\nVerkauf von frischem Mehl und Eiern.\nEinzelhandel in loser Schüttung (Behälter mitbringen)\nDer Bauernhof ist über den Voie Verte erreichbar."
    ],
    "en": [
      "Shortbread biscuits, sweet and savoury cookies made on the spot from the farm's wheat and eggs.\nSale of fresh flour and eggs.\nRetail sale in bulk (bring containers)\nThe farm is accessible from the Voie Verte."
    ],
    "it": [
      "Biscotti di pasta frolla, dolci e salati prodotti in loco con il grano e le uova della fattoria.\nVendita di farina fresca e uova.\nVendita al dettaglio di prodotti sfusi (portare i contenitori)\nLa fattoria è accessibile dalla Voie Verte."
    ],
    "fr": [
      "Biscuits sablés, cookies sucrés et salés fabriqués sur place à partir du blé et des œufs de l'exploitation.\nVente de farine et d'œufs frais.\nVente au détail en vrac (prévoir des contenants)\nLa ferme est accessible depuis la Voie Verte."
    ],
    "nl": [
      "Zandkoekjes, zoete en hartige koekjes die ter plaatse worden gemaakt van de tarwe en de eieren van de boerderij.\nVerkoop van vers meel en eieren.\nDetailhandel in bulk (breng containers mee)\nDe boerderij is bereikbaar vanaf de Voie Verte."
    ],
    "es": [
      "Galletas de mantequilla, galletas dulces y saladas elaboradas in situ con el propio trigo y los huevos de la granja.\nVenta de harina fresca y huevos.\nVenta al por menor a granel (llevar contenedores)\nLa granja es accesible desde la Voie Verte."
    ]
  },
