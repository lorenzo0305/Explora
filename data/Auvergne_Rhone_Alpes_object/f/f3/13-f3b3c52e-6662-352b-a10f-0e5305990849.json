  "rdfs:comment": {
    "de": [
      "In unserem Vereinsladen sind lokale Handwerker, Schöpfer und Künstler vertreten. Unsere Kreationen sind Einzelstücke, die wir selbst in unseren Ateliers in der Ardèche oder der Drôme herstellen. Treffen Sie einen von uns während unserer Sprechstunden!"
    ],
    "en": [
      "Our boutique is run by local artists and artisans from Ardèche and Drôme who have come together to sell a unique range of artistic creations, crafted by hand in their workshops."
    ],
    "it": [
      "Il nostro negozio comunitario riunisce artigiani, designer e artisti locali. Le nostre creazioni sono pezzi unici, realizzati da noi stessi nei nostri laboratori dell'Ardèche e della Drôme. Venite a conoscere uno di noi quando siamo in servizio!"
    ],
    "fr": [
      "Notre boutique associative regroupe des artisans, créateurs, artistes locaux. Nos créations sont des pièces uniques, fabriquées par nous-mêmes dans nos ateliers ardéchois ou drômois. Venez rencontrer l’un ou l'une d’entre nous lors de nos permanences !"
    ],
    "nl": [
      "Onze buurtwinkel brengt lokale ambachtslieden, ontwerpers en kunstenaars samen. Onze creaties zijn unieke stukken, door onszelf gemaakt in onze ateliers in de Ardèche en de Drôme. Kom een van ons ontmoeten als we dienst hebben!"
    ],
    "es": [
      "Nuestra tienda comunitaria reúne a artesanos, diseñadores y artistas locales. Nuestras creaciones son piezas únicas, hechas por nosotros mismos en nuestros talleres de Ardèche y Drôme. ¡Venga a conocer a uno de nosotros cuando estemos de servicio!"
    ]
  },
