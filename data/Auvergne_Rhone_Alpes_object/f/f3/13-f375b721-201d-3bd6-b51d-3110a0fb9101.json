  "rdfs:comment": {
    "de": [
      "In diesem Kokon aus Holz und Stoff lädt die Geschichtenerzählerin Melissa Baker Sie zu einer märchenhaften Reise ein, auf der Sie sich von Märchen die Ohren kitzeln lassen können."
    ],
    "en": [
      "In this cocoon of wood and fabric, storyteller Melissa Baker takes you on a fairytale journey to tickle your ears."
    ],
    "it": [
      "In questo bozzolo di legno e tessuto, la narratrice Melissa Baker vi accompagna in un viaggio da favola per solleticare le vostre orecchie."
    ],
    "fr": [
      "Dans ce cocon de bois et de tissus, la conteuse, Melissa Baker, vous propose un voyage féerique pour se faire chatouiller les oreilles par des contes."
    ],
    "nl": [
      "In deze cocon van hout en stof neemt verhalenvertelster Melissa Baker je mee op een sprookjesachtige reis om je oren te kietelen."
    ],
    "es": [
      "En este capullo de madera y tela, la cuentacuentos Melissa Baker te lleva en un viaje de cuento de hadas para hacerte cosquillas en los oídos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle grainothèque : La roulotte à merveilles"
    ]
  },
