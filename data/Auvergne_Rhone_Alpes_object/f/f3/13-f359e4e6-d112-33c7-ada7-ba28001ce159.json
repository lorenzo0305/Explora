  "rdfs:comment": {
    "de": [
      "Spaziergänge und Yoga im Freien jeden Tag am Altiport oder in Tuéda. Es werden auch Privatstunden angeboten. Beim Après-Ski Gruppenkurse für Hatha-Yoga in der Halle: dienstags um 18 Uhr in Les Allues und donnerstags um 17 Uhr im Parc Olympique. Das vollständige Programm finden Sie auf der Website."
    ],
    "en": [
      "Daily walks and outdoor yoga at Altiport or Tuéda. Private classes. Après-ski, group indoor hatha yoga classes: Tuesdays at 6pm at Les Allues and Thursdays at 5pm at Parc Olympique. Full program on the website."
    ],
    "it": [
      "Passeggiate giornaliere e yoga all'aperto all'Altiport o a Tuéda. Lezioni private. Dopo lo sci, lezioni di gruppo di hatha yoga al coperto: il martedì alle 18.00 a Les Allues e il giovedì alle 17.00 al Parc Olympique. Consultate il programma completo sul sito web."
    ],
    "fr": [
      "Balade et yoga en plein air tous les jours à l'Altiport ou à Tuéda. Cours privés. En après-ski, cours collectifs de hatha yoga en salle : le mardi à 18h aux Allues et le jeudi à 17h au Parc Olympique. Retrouvez le programme complet sur le site web."
    ],
    "es": [
      "Paseos diarios y yoga al aire libre en el Altiport o Tuéda. Clases particulares. Después de esquiar, clases colectivas de hatha yoga en interior: los martes a las 18 h en Les Allues y los jueves a las 17 h en Parc Olympique. Consulte el programa completo en el sitio web."
    ],
    "nl": [
      "Dagelijkse wandelingen en buitenyoga bij het Altiport of Tuéda. Privélessen. Na het skiën, indoor hatha yogalessen in groepsverband: dinsdag om 18.00 uur in Les Allues en donderdag om 17.00 uur in Parc Olympique. Bekijk het volledige programma op de website."
    ]
  },
