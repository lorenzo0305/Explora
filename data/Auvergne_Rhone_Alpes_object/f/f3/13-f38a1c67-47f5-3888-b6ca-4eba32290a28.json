  "rdfs:comment": {
    "de": [
      "Ein echtes, authentisches Restaurant, gutes Fleisch, das am Kamin gegart wird, gute Gerichte aus Großmutters Küche, die mit frischen, saisonalen Produkten zubereitet werden, und vor allem viel Liebe!"
    ],
    "en": [
      "A true and authentic restaurant, with fine steaks grilled on the open fire, as well as Pierre’s grandmother’s own traditional French recipes... cooked with love indeed!"
    ],
    "it": [
      "Un ristorante davvero autentico, con buone carni cotte sul fuoco, piatti della nonna cucinati con prodotti freschi di stagione e, soprattutto, tanto amore!"
    ],
    "fr": [
      "Un vrai restaurant authentique, de bonnes viandes cuites à la cheminée, de bons plats de grand-mère cuisinés avec des produits frais et de saison, et surtout beaucoup d’amour !"
    ],
    "es": [
      "Un restaurante realmente auténtico, con buenas carnes cocinadas a la brasa, platos de la abuela elaborados con productos frescos de temporada y, sobre todo, ¡mucho amor!"
    ],
    "nl": [
      "Een echt authentiek restaurant, met goed vlees bereid boven een open vuur, grootmoeders gerechten bereid met verse seizoensproducten en vooral veel liefde!"
    ]
  },
