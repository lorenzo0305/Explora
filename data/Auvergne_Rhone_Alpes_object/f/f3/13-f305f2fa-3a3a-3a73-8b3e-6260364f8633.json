  "rdfs:comment": {
    "de": [
      "Damen- und Herrenschuhe.\r\n\r\nDas Familienunternehmen Jonak wurde 1964 gegründet und setzt sich aus dem Namen seines Schöpfers Joseph Nakam zusammen. Die Marke Jonak entwirft ihre eigenen Schuhmodelle und erneuert ihre Kollektionen im Laufe der Jahreszeiten."
    ],
    "en": [
      "Women's and men's shoes.\r\n\r\nThe Jonak family brand was created in 1964, a contraction of the name of its creator Joseph Nakam. The Jonak brand creates its own shoe models and renews its collections season after season."
    ],
    "it": [
      "Scarpe da donna e da uomo.\r\n\r\nIl marchio della famiglia Jonak è stato creato nel 1964 ed è una contrazione del nome del suo creatore Joseph Nakam. Il marchio Jonak crea i propri modelli di scarpe e rinnova le proprie collezioni nel corso delle stagioni."
    ],
    "fr": [
      "Chaussures femme et homme.\r\n\r\nL’enseigne familiale Jonak créée en 1964 est la contraction de nom de son créateur Joseph Nakam. La marque Jonak crée ses propres modèles de chaussures et renouvèle ses collections au fil des saisons."
    ],
    "nl": [
      "Dames- en herenschoenen.\r\n\r\nHet familiemerk Jonak werd opgericht in 1964, een samentrekking van de naam van de bedenker Joseph Nakam. Het merk Jonak creëert zijn eigen schoenmodellen en vernieuwt zijn collecties van seizoen tot seizoen."
    ],
    "es": [
      "Calzado de señora y caballero.\r\n\r\nJonak es una marca familiar creada en 1964, contracción del nombre de su creador Joseph Nakam. La marca Jonak crea sus propios modelos de zapatos y renueva sus colecciones a lo largo de las temporadas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marques Avenue - Jonak"
    ]
  },
