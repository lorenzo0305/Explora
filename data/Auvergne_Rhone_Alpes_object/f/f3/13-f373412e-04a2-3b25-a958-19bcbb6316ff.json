  "rdfs:comment": {
    "de": [
      "Das Château de la Baume, das sich seit dem 13. Jahrhundert im Besitz derselben Familie befindet, liegt auf einem Felsvorsprung, der die Schluchten des Haut-Allier überragt. Im Inneren des Schlosses findet man authentische Dekorationen aus dem 17., 18. und 19."
    ],
    "en": [
      "Château de la Baume has been owned by the same family since the 13th century, and stands on a rocky spur overlooking the Haut-Allier gorges. The interior features authentic 17th-, 18th- and 19th-century decor."
    ],
    "it": [
      "Lo Château de la Baume appartiene alla stessa famiglia dal XIII secolo e sorge su uno sperone roccioso che domina le gole dell'Haut-Allier. Gli interni presentano decorazioni autentiche del XVII, XVIII e XIX secolo."
    ],
    "fr": [
      "Propriété du XIIIe siècle dans la même famille depuis l'origine, le château de la Baume se situe sur un éperon rocheux qui domine les gorges du Haut-Allier. A l'intérieur, on retrouve d'authentiques décors des XVIIe, XVIIIé et XIXé siècles."
    ],
    "es": [
      "El castillo de la Baume, propiedad de la misma familia desde el siglo XIII, se alza sobre un espolón rocoso que domina las gargantas del Haut-Allier. El interior presenta una decoración auténtica de los siglos XVII, XVIII y XIX."
    ],
    "nl": [
      "Château de la Baume is al sinds de 13e eeuw in het bezit van dezelfde familie en staat op een rotsachtige uitloper met uitzicht op de kloven van de Haut-Allier. Het interieur is authentiek ingericht in de 17e, 18e en 19e eeuw."
    ]
  },
