  "rdfs:comment": {
    "de": [
      "L'ours qui brasse ist eine Mikrobrauerei - Bar im Stadtzentrum von Saint-Etienne.\r\nVor Ort brauen wir unsere Biere, die wir zum Verzehr vor Ort oder zum Mitnehmen in loser Schüttung anbieten."
    ],
    "en": [
      "L'ours qui brasse is a microbrewery and bar in the centre of Saint-Etienne. \r\nWe brew our own beers on the premises, which are available to drink on the premises or to take away in bulk."
    ],
    "it": [
      "L'ours qui brasse è un microbirrificio e bar nel centro di Saint-Etienne.\r\nProduciamo le nostre birre sul posto, che sono disponibili per essere bevute sul posto o per essere portate via sfuse."
    ],
    "fr": [
      "L'ours qui brasse est une microbrasserie - bar en plein centre ville de Saint-Etienne. \r\nSur place, nous brassons nos bières que nous proposons à consommer sur place ou à emporter en vrac."
    ],
    "nl": [
      "L'ours qui brasse is een microbrouwerij en bar in het centrum van Saint-Etienne.\r\nWe brouwen ter plaatse onze eigen bieren, die je ter plaatse kunt drinken of in grote hoeveelheden kunt meenemen."
    ],
    "es": [
      "L'ours qui brasse es una microcervecería y un bar situados en el centro de Saint-Etienne.\r\nElaboramos nuestras propias cervezas en el propio local, que se pueden consumir allí mismo o llevar a granel."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bar L'ours qui brasse"
    ],
    "fr": [
      "Bar L'ours qui brasse"
    ]
  },
