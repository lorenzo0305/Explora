  "rdfs:comment": {
    "de": [
      "Herzlich willkommen an alle Tierliebhaber. Nicolas erwartet Sie auf seinem Bauernhof in der Nähe von Roanne, um Ihnen alle Geheimnisse seiner zahlreichen Tiere zu zeigen und mit ihnen in die Welt einzutauchen."
    ],
    "en": [
      "Welcome to animal lovers. Nicolas is waiting for you at his farm just outside Roanne to let you in on all the secrets of his many animals."
    ],
    "it": [
      "Benvenuti agli amanti degli animali. Nicolas vi aspetta nella sua fattoria a due passi da Roanne per svelarvi tutti i segreti dei suoi numerosi animali."
    ],
    "fr": [
      "Bienvenue aux amoureux des animaux. Nicolas vous attend dans sa ferme à deux pas de Roanne pour vous faire découvrir tous les secrets de ses nombreux animaux et entrer en immersion avec eux."
    ],
    "nl": [
      "Welkom dierenliefhebbers. Nicolas wacht op je in zijn boerderij op een steenworp afstand van Roanne om je alle geheimen van zijn vele dieren te onthullen."
    ],
    "es": [
      "Bienvenidos a los amantes de los animales. Nicolas le espera en su granja, a dos pasos de Roanne, para contarle todos los secretos de sus numerosos animales."
    ]
  },
  "rdfs:label": {
