  "rdfs:comment": {
    "de": [
      "Von September bis Mai bietet der Veranstaltungssaal Claude-Nougaro von Animatis eine komplette Kultursaison, die mit einer extremen Vielfalt an Genres (Theater, Musik, Zirkus, Tanz, Humor...) für jedes Publikum spielt."
    ],
    "en": [
      "From September to May, Animatis' Claude-Nougaro auditorium offers a full cultural season, featuring an extreme variety of genres (theater, music, circus, dance, comedy...) for all audiences."
    ],
    "it": [
      "Da settembre a maggio, la sala concerti Claude-Nougaro di Animatis offre una stagione culturale completa, con una grande varietà di generi (teatro, musica, circo, danza, commedia...) per tutti i pubblici."
    ],
    "fr": [
      "De septembre à mai, la salle de spectacles Claude-Nougaro d'Animatis propose une saison culturelle complète, jouant sur une extrême variété des genres (théâtre, musique, cirque, danse, humour...) pour tous les publics."
    ],
    "nl": [
      "Van september tot mei biedt de concertzaal Claude-Nougaro van Animatis een volledig cultureel seizoen, met een grote verscheidenheid aan genres (theater, muziek, circus, dans, komedie...) voor elk publiek."
    ],
    "es": [
      "De septiembre a mayo, la sala de conciertos Claude-Nougaro de Animatis ofrece una completa temporada cultural, con una gran variedad de géneros (teatro, música, circo, danza, comedia...) para todos los públicos."
    ]
  },
  "rdfs:label": {
