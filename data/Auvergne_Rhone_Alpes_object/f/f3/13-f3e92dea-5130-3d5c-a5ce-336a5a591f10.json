          "additionalInformation": {
            "de": [
              "Kartenverkauf für die Kultursaison bei Animatis :\r\n- montag und Mittwoch von 9:30 bis 12:00 Uhr und von 13:30 bis 16:30 Uhr\r\n- dienstag und Freitag von 13.30 bis 16.30 Uhr\r\n- und an den Abenden der Aufführungen eine 3/4 Stunde vor der Vorstellung"
            ],
            "en": [
              "Ticket sales for the cultural season at Animatis:\r\n- monday and Wednesday, 9:30am to 12pm and 1:30pm to 4:30pm\r\n- tuesday and Friday from 1:30 to 4:30 pm\r\n- and on show nights, 3/4 hour before the performance"
            ],
            "it": [
              "Biglietteria per la stagione culturale di Animatis:\r\n- lunedì e mercoledì, dalle 9.30 alle 12.00 e dalle 13.30 alle 16.30\r\n- martedì e venerdì dalle 13.30 alle 16.30\r\n- e nelle serate di spettacolo, 3/4 d'ora prima della rappresentazione"
            ],
            "fr": [
              "Billetterie de la saison culturelle à Animatis :\r\n- lundi et mercredi de 9h30 à 12h et de 13h30 à 16h30 \r\n- mardi et vendredi de 13h30 à 16h30\r\n- et soirs de spectacle, 3/4 d'heure avant la représentation"
            ],
            "es": [
              "Taquilla para la temporada cultural en Animatis:\r\n- lunes y miércoles de 9.30 a 12.00 y de 13.30 a 16.30 horas\r\n- martes y viernes de 13.30 a 16.30 h\r\n- y las noches de espectáculo, 3/4 de hora antes de la función"
            ],
            "nl": [
              "Kassa voor het culturele seizoen bij Animatis:\r\n- maandag en woensdag van 9.30 tot 12.00 uur en van 13.30 tot 16.30 uur\r\n- dinsdag en vrijdag van 13.30 tot 16.30 uur\r\n- en op voorstellingsavonden, 3/4 uur voor aanvang van de voorstelling"
            ]
          },
