  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Angeln an der Saône von Taponas aus! Die an diesem Ort geschaffenen Einrichtungen ermöglichen es allen Anglern, ihr Hobby auszuüben, egal welche Technik sie bevorzugen."
    ],
    "en": [
      "Discover fishing on the Saône from Taponas! The facilities on this site allow all anglers to enjoy their leisure activities, whatever their preferred technique."
    ],
    "it": [
      "Venite a scoprire la pesca sulla Saona da Taponas! Le strutture di questo sito permettono a tutti i pescatori di praticare il loro hobby, qualunque sia la tecnica preferita."
    ],
    "fr": [
      "Venez découvrir la pêche en Saône depuis Taponas ! Les aménagements réalisés sur ce site permettent à tous les pêcheurs de pratiquer leurs loisirs quelques soit leur technique de prédilection."
    ],
    "es": [
      "¡Venga a descubrir la pesca en el Saona desde Taponas! Las instalaciones de este lugar permiten a todos los pescadores disfrutar de su afición, sea cual sea su técnica preferida."
    ],
    "nl": [
      "Kom en ontdek het vissen op de Saône vanuit Taponas! De faciliteiten op deze camping bieden alle vissers de mogelijkheid om van hun hobby te genieten, ongeacht de techniek van hun voorkeur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêcher la Saône à Taponas"
    ]
  },
