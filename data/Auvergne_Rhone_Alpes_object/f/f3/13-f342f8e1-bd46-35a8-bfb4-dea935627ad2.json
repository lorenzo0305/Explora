  "rdfs:comment": {
    "de": [
      "Eine hausgemachte und einfache Speisekarte von Mittwoch bis Samstag in unserem Restaurant/Spielbar\r\nReduzierte Schiefertafelkarte, lokale und biologische Gerichte so oft wie möglich am Mittag\r\nsowie ein Getränkeangebot, das sich an lokalen Geschmacksrichtungen orientiert."
    ],
    "en": [
      "A simple, homemade menu from Wednesday to Saturday in our restaurant/games bar\r\nReduced slate menu, local and organic whenever possible at lunchtime\r\nas well as a range of drinks based on local flavours."
    ],
    "it": [
      "Un menu semplice e casereccio dal mercoledì al sabato nel nostro ristorante/bar dei giochi\r\nUn menu ridotto sulla lavagna, locale e biologico quando possibile all'ora di pranzo\r\nnonché una gamma di bevande a base di sapori locali."
    ],
    "fr": [
      "Une carte maison et simple du mercredi au samedi dans notre restaurant/Bar à Jeux\r\nCarte réduite à l'ardoise, locale et bio autant que possible le midi\r\nainsi qu’une proposition de boissons tournées vers les saveurs locales."
    ],
    "es": [
      "Un menú sencillo y casero de miércoles a sábado en nuestro restaurante/bar de juegos\r\nUn menú reducido en la pizarra, local y ecológico siempre que sea posible al mediodía\r\nasí como una gama de bebidas basadas en sabores locales."
    ],
    "nl": [
      "Een eenvoudig, huisgemaakt menu van woensdag tot zaterdag in ons restaurant/spelletjesbar\r\nEen gereduceerd menu op de lei, waar mogelijk lokaal en biologisch tijdens lunchtijd\r\nen een assortiment drankjes op basis van lokale smaken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Tanière au Coin du Jeu"
    ]
  },
