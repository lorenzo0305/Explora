  "rdfs:comment": {
    "de": [
      "Vom Grand Véfour in Paris bis zur Mère Brazier in Lyon, vom Kilimandscharo in Courchevel bis zum Château de Bagnols (an der Seite von Jean-Alexandre Ouaratta) - Michaël GAUDINET wird Sie hinter dem Herd der Brasserie des Monts d'Or in einem zeitgemäßen Dekor verwöhnen."
    ],
    "en": [
      "From the Grand Véfour in Paris to the Mère Brazier in Lyon, from Kilimanjaro to Courchevel to the Château de Bagnols (alongside Jean-Alexandre Ouaratta), Michaël GAUDINET will delight you behind the stoves of the Brasserie des Monts d'Or in a contemporary setting."
    ],
    "it": [
      "Dal Grand Véfour di Parigi alla Mère Brazier di Lione, dal Kilimandjaro di Courchevel allo Château de Bagnols (insieme a Jean-Alexandre Ouaratta), Michaël GAUDINET vi delizierà dietro i fornelli della Brasserie des Monts d'Or in un ambiente contemporaneo."
    ],
    "fr": [
      "Du Grand Véfour à Paris à la Mère Brazier à Lyon, du Kilimandjaro à Courchevel au Château de Bagnols (aux côtés de Jean-Alexandre Ouaratta), Michaël GAUDINET vous régalera derrière les fourneaux de la Brasserie des Monts d'Or dans un décor contemporain."
    ],
    "nl": [
      "Van de Grand Véfour in Parijs tot de Mère Brazier in Lyon, van de Kilimandjaro in Courchevel tot het Château de Bagnols (aan de zijde van Jean-Alexandre Ouaratta), Michaël GAUDINET zal u verrukken achter de kachels van de Brasserie des Monts d'Or in een eigentijds kader."
    ],
    "es": [
      "Del Grand Véfour de París a la Mère Brazier de Lyon, del Kilimandjaro de Courchevel al Château de Bagnols (junto a Jean-Alexandre Ouaratta), Michaël GAUDINET le deleitará tras los fogones de la Brasserie des Monts d'Or en un ambiente contemporáneo."
    ]
  },
