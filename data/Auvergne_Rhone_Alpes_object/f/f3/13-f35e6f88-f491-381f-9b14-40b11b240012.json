  "rdfs:comment": {
    "de": [
      "Von den Gletschern bis zu den wulstigen Torfmooren führt Sie der Weg um den See herum durch Landschaften, die in den letzten 20 000 Jahren aufeinander folgten. Und während Sie den Wasserlauf hinaufgehen, wird Ihnen die faszinierende Herkunft eines Findlings erzählt."
    ],
    "en": [
      "The path around the lake takes you through landscapes that have succeeded for 20 000 years."
    ],
    "it": [
      "Dai ghiacciai alle torbiere, il sentiero intorno al lago vi porterà attraverso una successione di paesaggi degli ultimi 20.000 anni. E mentre risalite la corrente, vi verrà raccontata l'intrigante storia dell'origine di un masso erratico."
    ],
    "fr": [
      "Des glaciers au bombement des tourbières, le chemin autour du lac vous fait traverser les paysages qui se sont succédé depuis 20 000 ans. Et en remontant le cours d'eau, l'intrigante origine d'un bloc erratique vous sera conté."
    ],
    "nl": [
      "Van gletsjers tot uitpuilende veenmoerassen, het pad rond het meer voert je door een opeenvolging van landschappen van de afgelopen 20.000 jaar. En als je stroomopwaarts gaat, krijg je te horen over de intrigerende oorsprong van een grillig rotsblok."
    ],
    "es": [
      "Desde glaciares hasta abultadas turberas, el sendero que rodea el lago le lleva a través de una sucesión de paisajes de los últimos 20.000 años. Y mientras remonta el río, le contarán la intrigante historia del origen de una roca errática."
    ]
  },
