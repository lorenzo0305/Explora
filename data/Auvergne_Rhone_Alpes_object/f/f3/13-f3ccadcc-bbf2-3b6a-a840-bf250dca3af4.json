  "rdfs:comment": {
    "de": [
      "Idealer Spot für Selfie- und Landschaftsfotos vor den riesigen Chamrousse-Buchstaben!\r\nKleine Herz-Fototafel zusätzlich neben dem Picknickbereich."
    ],
    "en": [
      "Ideal spot to take selfie and landscape photos in front of the giant Chamrousse letters!\r\nSmall heart-shaped photo panel next to the picnic area."
    ],
    "it": [
      "Il luogo perfetto per scattare selfie e foto di paesaggio davanti alle lettere giganti di Chamrousse!\r\nC'è anche un piccolo pannello fotografico accanto all'area picnic."
    ],
    "fr": [
      "Spot idéal pour prendre des photos selfie et paysage devant les lettres géantes Chamrousse !\r\nPetit panneau photo cœur en plus à côté de la zone de pique-nique."
    ],
    "es": [
      "El lugar perfecto para hacerse selfies y fotos de paisajes delante de las letras gigantes de Chamrousse\r\nTambién hay un pequeño panel fotográfico junto a la zona de picnic."
    ],
    "nl": [
      "De perfecte plek om selfie- en landschapsfoto's te maken voor de gigantische Chamrousse-letters!\r\nEr is ook een klein fotopaneel naast de picknickplaats."
    ]
  },
  "rdfs:label": {
