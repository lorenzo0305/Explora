      "rdfs:comment": {
        "de": [
          "Regionale und lokale Produkte : Äpfel (Jonagold, Melrose, Boskoop, Jonagored, Pinova, Golden...), Birnen(Vorträge), Pflaumen (Mirabellen, Quetsch), Kartoffeln (Charlotte, Agata, Bintje...).Andere Leistungen: Verkauf von Bauernhof- und Regionalprodukten (Geflügel, Gemüse, Apfelsaft, Terrinen, Wein, Bier, Käse, Wurstwaren, Süßwaren,Gebäck...)."
        ],
        "en": [
          "Local products : Apples (Jonagold, Melrose, Boskoop, Jonagored, Pinova, Golden...), pears (conferences), plums (mirabelle plum, quetsch), potatoes (Charlotte, Agata, Bintje...) Other services: sale of farm and local products (poultry, vegetables, apple juice, terrines, wines, beers, cheeses, delicatessen, confectionery, biscuits...)."
        ],
        "it": [
          "Prodotti locali : Mele (Jonagold, Melrose, Boskoop, Jonagored, Pinova, Golden...), pere (conferences), prugne (mirabelle, quetsch), patate (Charlotte, Agata, Bintje...) Altri servizi: vendita di prodotti aziendali e locali (pollame, verdure, succo di mela, terrine, vini, birre, formaggi, gastronomia, pasticceria, biscotti...)."
        ],
        "fr": [
          "Produits du terroir : Pommes (Jonagold, Melrose, Boskoop, Jonagored, Pinova, Golden...), poires(conférences), prunes (mirabelles, quetsch), pommes de terre (Charlotte, Agata, Bintje...).Autres prestations : vente de produits fermiers et de terroir (volailles, légumes, jus de pommes, terrines, vins, bières, fromages, charcuterie, confiserie,biscuiterie..)."
        ],
        "es": [
          "Productos locales : Manzanas (Jonagold, Melrose, Boskoop, Jonagored, Pinova, Golden...), peras (conferences), ciruelas (mirabelle, quetsch), patatas (Charlotte, Agata, Bintje...) Otros servicios: venta de productos agrícolas y locales (aves de corral, verduras, zumo de manzana, terrinas, vinos, cervezas, quesos, charcutería, confitería, galletas...)."
        ],
        "nl": [
          "Lokale producten : Appels (Jonagold, Melrose, Boskoop, Jonagored, Pinova, Golden...), peren (conferences), pruimen (mirabelle, quetsch), aardappelen (Charlotte, Agata, Bintje...) Andere diensten: verkoop van boerderij- en streekproducten (pluimvee, groenten, appelsap, terrines, wijnen, bieren, kazen, delicatessen, snoepgoed, koekjes...)."
        ]
      },
