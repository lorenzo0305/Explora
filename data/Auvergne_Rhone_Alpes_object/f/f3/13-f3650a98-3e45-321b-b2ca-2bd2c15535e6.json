  "rdfs:comment": {
    "de": [
      "Ein Spaziergang durch den alten Ortskern von Taninges bedeutet, dass Sie rund um den Marktplatz ein ganzes bauliches Erbe (16. bis 19. Jahrhundert) entdecken: Brunnen, alte Bürgerhäuser, Arkaden, eine Kapelle und eine alte Brücke über den Foron."
    ],
    "en": [
      "Stroll in the old village of Taninges and discover a whole built heritage (XVIth - XIXth century) around the marketplace : fountain, old houses, arches, chapel and old bridge above Foron."
    ],
    "it": [
      "Passeggiando nel centro storico di Taninges, scoprirete un intero patrimonio di edifici (XVI-XIX secolo) intorno alla piazza del mercato: fontana, vecchie case borghesi, portici, cappella e antico ponte sul Foron."
    ],
    "fr": [
      "Flâner dans le bourg ancien de Taninges, c'est découvrir tout un patrimoine bâti (XVIème - XIXéme siècle) autour de la place du marché : fontaine, anciennes maisons bourgeoises, arcades, chapelle et vieux pont au dessus du Foron."
    ],
    "es": [
      "Paseando por el casco antiguo de Taninges, descubrirá todo un patrimonio de edificios (siglos XVI-XIX) en torno a la plaza del mercado: fuente, antiguas casas burguesas, soportales, capilla y antiguo puente sobre el Forón."
    ],
    "nl": [
      "Een wandeling door de oude stad Taninges onthult een heel erfgoed van gebouwen (16e-19e eeuw) rond het marktplein: fontein, oude burgerhuizen, arcades, kapel en oude brug over de Foron."
    ]
  },
  "rdfs:label": {
    "en": [
      "The old village of Taninges"
    ],
    "fr": [
      "Taninges historique"
    ],
    "nl": [
      "Historisch Taninges"
    ]
  },
