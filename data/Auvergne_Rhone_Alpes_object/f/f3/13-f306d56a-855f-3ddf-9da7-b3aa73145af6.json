  "rdfs:comment": {
    "de": [
      "Der Arly ist im oberen Teil ein mächtiger und wilder Gebirgsstrom. Da er an manchen Stellen nicht leicht zugänglich ist, ist das Forellenangeln eine Herausforderung."
    ],
    "en": [
      "Downstream, the Arly is a fierce, powerful mountain stream where the trout definitely merit being caught because access to some stretches is quite difficult."
    ],
    "it": [
      "L'Arly nella sua parte a valle è un torrente potente e selvaggio, le cui trote devono essere guadagnate perché alcuni accessi sono un po' difficili."
    ],
    "fr": [
      "L'Arly dans sa partie avale se révèle être un torrent puissant et sauvage, dont les truites se méritent car certains accès sont un peu difficiles."
    ],
    "es": [
      "El Arly en su parte aguas abajo es un torrente potente y salvaje, cuyas truchas hay que ganarse porque algunos accesos son un poco difíciles."
    ],
    "nl": [
      "De Arly in het benedenstroomse deel is een krachtige en wilde stroom, waarvan de forel moet worden verdiend omdat sommige toegangen wat moeilijk zijn."
    ]
  },
  "rdfs:label": {
    "de": [
      "Den Arly flussaufwärts"
    ],
    "en": [
      "Upstream Arly"
    ],
    "fr": [
      "L’Arly amont"
    ]
  },
