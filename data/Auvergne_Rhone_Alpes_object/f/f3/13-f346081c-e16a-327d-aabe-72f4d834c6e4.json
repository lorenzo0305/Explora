  "rdfs:comment": {
    "de": [
      "Die Bibliothek und Mediathek bietet Ihnen einen flexiblen Bereich für Kinder. Sie können CDs ausleihen und haben freien Zugang zu Computern.\r\nEin Animationsprogramm ist in Kürze verfügbar."
    ],
    "en": [
      "The library-mediathèque offers a modular space reserved for children. Possibility of borrowing CDs, free access to computers.\r\nAn animation program will soon be available."
    ],
    "it": [
      "La biblioteca-mediateca offre un'area flessibile riservata ai bambini. È possibile prendere in prestito CD e accedere gratuitamente ai computer.\r\nPresto sarà disponibile un programma di intrattenimento."
    ],
    "fr": [
      "La bibliothèque-Médiathèque vous propose un espace modulable réservé aux enfants. Possibilité d'emprunt de cd, point informatique en libre accès.\r\nBientôt disponible un programme d'animation."
    ],
    "es": [
      "La biblioteca-mediateca ofrece un espacio flexible reservado a los niños. Se pueden tomar prestados CD y hay acceso gratuito a ordenadores.\r\nPronto habrá un programa de animación."
    ],
    "nl": [
      "De bibliotheek-mediatheek biedt een flexibele ruimte gereserveerd voor kinderen. Er kunnen cd's worden geleend en er is gratis toegang tot computers.\r\nBinnenkort zal er een animatieprogramma beschikbaar zijn."
    ]
  },
