  "rdfs:comment": {
    "de": [
      "Am Fuße des Jura, 15 Minuten vom Flughafen Genf entfernt, bietet der Golfplatz Maison Blanche 27 Löcher, darunter einen 18-Loch-Meisterschaftsplatz, \"Les Sources\", und einen 9-Loch-Platz (Par 31), \"Allondon\"."
    ],
    "en": [
      "At the foot of the Jura, 15 minutes from Geneva airport, le Golf de Maison Blanche offers 27 holes, including an 18-hole championship course, \"Les Sources\", and a 9-hole course, the Allondon."
    ],
    "it": [
      "Ai piedi delle montagne del Giura, a 15 minuti dall'aeroporto di Ginevra, il Golf Club Maison Blanche offre 27 buche, tra cui un percorso da campionato a 18 buche, \"les Sources\", e un percorso a 9 buche (par 31), l'Allondon."
    ],
    "fr": [
      "Au pied du Jura, à 15 minutes de l’aéroport de Genève, le Golf de Maison Blanche offre 27 trous, dont un parcours championnat de 18 trous, “les Sources”, et un parcours de 9 trous (par 31), l’Allondon."
    ],
    "es": [
      "Al pie de las montañas del Jura, a 15 minutos del aeropuerto de Ginebra, el club de golf Maison Blanche ofrece 27 hoyos, incluyendo un campo de campeonato de 18 hoyos, \"les Sources\", y un campo de 9 hoyos (par 31), l'Allondon."
    ],
    "nl": [
      "Aan de voet van het Jura-gebergte, op 15 minuten van de luchthaven van Genève, biedt de Maison Blanche Golf Club 27 holes, waaronder een 18-holes kampioenschapsbaan, \"Les Sources\", en een 9-holes (par 31) baan, \"Allondon\"."
    ]
  },
