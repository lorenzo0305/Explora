  "rdfs:comment": {
    "de": [
      "Der Verein La Potéose organisiert eine Tombola, bei der es mehr als 20 Preise von lokalen Künstlern und Handwerkern zu gewinnen gibt. Ziehung am 13. April um 14 Uhr im Rathaus."
    ],
    "en": [
      "The association La Potéose is organizing a tombola with over 20 prizes to be won from local artists and craftspeople. Draw on April 13 at 2pm at the town hall."
    ],
    "it": [
      "L'associazione La Potéose organizza una tombola con oltre 20 premi messi in palio da artisti e artigiani locali. L'estrazione avverrà il 13 aprile alle 14.00 presso il municipio."
    ],
    "fr": [
      "L'association La Potéose organise une tombola avec plus de 20 lots d'artistes et artisans locaux à gagner. Tirage le 13 avril à 14h à la mairie."
    ],
    "es": [
      "La asociación La Potéose organiza una tómbola con más de 20 premios de artistas y artesanos locales. Sorteo el 13 de abril a las 14h en el ayuntamiento."
    ],
    "nl": [
      "De vereniging La Potéose organiseert een tombola met meer dan 20 prijzen van plaatselijke kunstenaars en ambachtslieden. De trekking vindt plaats op 13 april om 14.00 uur in het gemeentehuis."
    ]
  },
