  "rdfs:comment": {
    "de": [
      "Das Festival der Apéro Musique findet vom 14. bis 16. August 2026 statt! Bereiten Sie sich auf unvergessliche Momente mit talentierten Künstlern, einer festlichen Atmosphäre und musikalischen Entdeckungen vor. Bleiben Sie dran für weitere Informationen zu dieser Veranstaltung"
    ],
    "en": [
      "The Apéro Musique festival will take place from August 14 to 16, 2026! Get ready to experience unforgettable moments with talented artists, a festive atmosphere and musical discoveries. Stay tuned for more information on this event"
    ],
    "it": [
      "Il festival Apéro Musique si svolgerà dal 14 al 16 agosto 2026! Preparatevi a momenti indimenticabili con artisti di talento, un'atmosfera di festa e scoperte musicali. Restate sintonizzati per ulteriori informazioni su questo evento"
    ],
    "fr": [
      "Le festival des Apéro Musique aura lieu du 14 au 16 août 2026  ! Préparez-vous à vivre des moments inoubliables avec des artistes talentueux, une ambiance festive et des découvertes musicales. Restez à l'écoute pour plus d'informations sur cet événement"
    ],
    "nl": [
      "Het Apéro Musique festival vindt plaats van 14 tot 16 augustus 2026! Bereid je voor op onvergetelijke momenten met getalenteerde artiesten, een feestelijke sfeer en muzikale ontdekkingen. Blijf op de hoogte voor meer informatie over dit evenement"
    ],
    "es": [
      "El festival Apéro Musique se celebrará del 14 al 16 de agosto de 2026 Prepárese para vivir momentos inolvidables con artistas de talento, un ambiente festivo y descubrimientos musicales. Esté atento para más información sobre este evento"
    ]
  },
