  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/505506c0-4f75-39fa-b5a8-b8817b4f3b49",
      "dc:description": {
        "de": [
          "Finden Sie ? Du bout des DOIGTS? vom 8. bis 15. Februar 2025 in 10 Gemeinden der CAHC. In Begleitung der Eltern können die Kleinsten die Welten von Pauline Duez, Sandro Jiro und Adley, ihre Techniken, ihre Welten und auch ihre Alben entdecken!"
        ],
        "en": [
          "Discover ? Du bout des DOIGTS? from February 8 to 15, 2025 in 10 CAHC towns. Accompanied by parents, little ones can discover the worlds of Pauline Duez, Sandro Jiro and Adley, their techniques, their worlds and their albums!"
        ],
        "it": [
          "Scoprire ? Du bout des DOIGTS? dall'8 al 15 febbraio 2025 in 10 città del CAHC. Accompagnati dai genitori, i più piccoli potranno scoprire i mondi di Pauline Duez, Sandro Jiro e Adley, le loro tecniche, i loro mondi e i loro album!"
        ],
        "fr": [
          "Retrouvez “ Du bout des DOIGTS ” du 8 au 15 février 2025 dans 10 communes de la CAHC. Accompagnés des parents, les tout-petits pourront découvrir les univers de Pauline Duez, Sandro Jiro et Adley, leurs techniques, leurs univers et aussi leurs albums !"
        ],
        "nl": [
          "Ontdek ? Du bout des DOIGTS? van 8 tot 15 februari 2025 in 10 steden van de CAHC. Onder begeleiding van hun ouders kunnen de allerkleinsten de wereld van Pauline Duez, Sandro Jiro en Adley ontdekken, hun technieken, hun werelden en ook hun albums!"
        ],
        "es": [
          "Descubra ? Du bout des DOIGTS? del 8 al 15 de febrero de 2025 en 10 ciudades del CAHC. Acompañados por sus padres, los más pequeños podrán descubrir el universo de Pauline Duez, Sandro Jiro y Adley, sus técnicas, sus universos y sus álbumes"
        ]
      },
