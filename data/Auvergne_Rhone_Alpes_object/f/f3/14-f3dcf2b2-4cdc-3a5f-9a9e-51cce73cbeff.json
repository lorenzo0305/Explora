  "rdfs:comment": {
    "de": [
      "Im Rahmen der Politik des öffentlichen Lesens des gemeinschaftlichen Mediennetzwerks organisieren der Verein Droit de Cite? und die Communaute? d'Agglome?ration He?nin-Carvin Treffen mit Autoren und Illustratoren von Kinder- und Jugendbüchern."
    ],
    "en": [
      "As part of the community multimedia network?s public reading policy, the Droit de Cite? association and the Communauté d?Agglome?ration He?nin-Carvin are organizing meetings with authors and illustrators of children?s books."
    ],
    "it": [
      "Nell'ambito della politica di lettura pubblica della rete multimediale comunitaria, l'associazione Droit de Cite? e la Comunità urbana He?nin-Carvin organizzano incontri con autori e illustratori di libri per bambini."
    ],
    "fr": [
      "Dans le cadre de la politique de Lecture Publique du réseau communautaire des médiathèques, l’association Droit de Cité et la Communauté d’Agglomération Hénin-Carvin, organisent des rencontres avec des auteurs-illustrateurs d’albums pour la jeunesse."
    ],
    "nl": [
      "In het kader van het voorleesbeleid van het communautaire multimedianetwerk organiseren de vereniging Droit de Cite en de Stedelijke Gemeenschap Heïne-Carvin ontmoetingen met auteurs en illustratoren van kinderboeken."
    ],
    "es": [
      "En el marco de la política de lectura pública de la red multimedia comunitaria, la asociación Droit de Cite? y la Comunidad Urbana He?nin-Carvin organizan encuentros con autores e ilustradores de libros infantiles."
    ]
  },
