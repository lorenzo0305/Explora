  "rdfs:comment": {
    "de": [
      "Isléa beherbergt jede Saison ein kulturelles Programm, das Entdeckungen und Vielfalt mit einer ausgeprägten musikalischen Dominanz bevorzugt."
    ],
    "en": [
      "Isléa welcomes each season a cultural programme that favours discovery and diversity with a strong musical focus."
    ],
    "it": [
      "Ogni stagione, Isléa ospita un programma culturale che privilegia la scoperta e la diversità con una forte enfasi musicale."
    ],
    "fr": [
      "Isléa accueille chaque saison une programmation culturelle privilégiant la découverte et la diversité avec une dominante musicale affirmée."
    ],
    "nl": [
      "Elk seizoen biedt Isléa een cultureel programma dat de voorkeur geeft aan ontdekking en diversiteit met een sterke muzikale nadruk."
    ],
    "es": [
      "Cada temporada, Isléa acoge un programa cultural que favorece el descubrimiento y la diversidad con un fuerte énfasis musical."
    ]
  },
