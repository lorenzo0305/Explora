  "rdfs:comment": {
    "de": [
      "Nikolaj Szeps-Znaider und das Orchestre National de Lyon setzen ihre Erkundung der Trilogie Mozart/Da Ponte mit dem mythischen Verführer fort, der sowohl Faszination als auch Abneigung hervorruft."
    ],
    "en": [
      "Nikolaj Szeps-Znaider and the Orchestre national de Lyon continue their exploration of the Mozart/Da Ponte trilogy in the company of the mythical seducer, who arouses both fascination and aversion."
    ],
    "it": [
      "Nikolaj Szeps-Znaider e l'Orchestre national de Lyon continuano la loro esplorazione della trilogia Mozart/Da Ponte in compagnia del mitico seduttore, che suscita fascino quanto avversione."
    ],
    "fr": [
      "Nikolaj Szeps-Znaider et l’Orchestre national de Lyon poursuivent leur exploration de la trilogie Mozart/Da Ponte en compagnie du mythique séducteur, qui suscite la fascination autant que l’aversion."
    ],
    "es": [
      "Nikolaj Szeps-Znaider y la Orquesta Nacional de Lyon prosiguen su exploración de la trilogía Mozart/Da Ponte en compañía del mítico seductor, que despierta tanta fascinación como aversión."
    ],
    "nl": [
      "Nikolaj Szeps-Znaider en het Orchestre national de Lyon zetten hun verkenning van de Mozart/Da Ponte trilogie voort in het gezelschap van de mythische verleider, die zowel fascinatie als afkeer oproept."
    ]
  },
