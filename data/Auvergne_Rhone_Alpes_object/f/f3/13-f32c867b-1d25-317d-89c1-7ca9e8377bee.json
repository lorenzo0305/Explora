  "rdfs:comment": {
    "de": [
      "La Paillotte des Tarteaux ist eine Snackbar und Loungebar auf dem Campingplatz Tarteaux. Wir bieten Catering vor Ort oder zum Mitnehmen aus regionalen Produkten an."
    ],
    "en": [
      "This 2025 season, the Tarteaux hut becomes the Guinguette du Pont de Menat!\r\nAperitif, good food and music on the banks of the Sioule."
    ],
    "it": [
      "In questa stagione 2025, la capanna di paglia di Tarteaux diventa la Guinguette du Pont de Menat!\r\nAperitivi, buon cibo e musica sulle rive della Sioule."
    ],
    "fr": [
      "Cette saison 2025, la paillotte des Tarteaux devient la Guinguette du Pont de Menat!\r\nApéro, bonne bouffe et musique en bord de Sioule."
    ],
    "es": [
      "Esta temporada 2025, la cabaña de paja de Tarteaux se convierte en la Guinguette du Pont de Menat\r\nAperitivos, buena comida y música a orillas del Sioule."
    ],
    "nl": [
      "Dit seizoen 2025 wordt de strohut van Tarteaux de Guinguette du Pont de Menat!\r\nAperitieven, lekker eten en muziek aan de oevers van de Sioule."
    ]
  },
