  "rdfs:comment": {
    "de": [
      "Der Jachthafen von Rives ist mit 800 Ringen einer der größten auf der französischen Seite des Genfersees.\r\nEr bietet die für die Freizeitschifffahrt erforderlichen Dienstleistungen: Hafenmeisterei, Tankstelle, Krananlagen, Schiffsreparaturen, Restaurants, Bars, Geschäfte."
    ],
    "en": [
      "The marina of Rives is one of the largest on the French shores of Lake Geneva with 800 moorings, it offers all the services necessary for pleasure boating: harbour master's office, service station, craneage, careening, restaurants, bars, shops."
    ],
    "it": [
      "Il porto turistico di Rives è uno dei più grandi della sponda francese del Lago di Ginevra, con 800 posti barca.\r\nOffre tutti i servizi necessari alla nautica da diporto: capitaneria di porto, stazione di servizio, gru, carenaggio, ristoranti, bar e negozi."
    ],
    "fr": [
      "Le port de plaisance de Rives est l'un des plus importants de la rive française du Léman avec 800 anneaux. \r\nIl offre les services nécessaires à la navigation de plaisance : capitainerie, station service, grutage, carénages, restaurants, bars, commerces."
    ],
    "es": [
      "El puerto deportivo de Rives es uno de los más grandes de la orilla francesa del lago Lemán, con 800 amarres.\r\nOfrece todos los servicios necesarios para la navegación de recreo: capitanía, estación de servicio, grúa, carenado, restaurantes, bares y tiendas."
    ],
    "nl": [
      "De jachthaven van Rives is een van de grootste aan de Franse kant van het meer van Genève, met 800 ligplaatsen.\r\nHet biedt alle diensten die nodig zijn voor de pleziervaart: havenkapiteinskantoor, servicestation, kraan, verzorging, restaurants, bars en winkels."
    ]
  },
  "rdfs:label": {
    "en": [
      "Marina of Rives"
    ],
    "fr": [
      "Port de Plaisance de Rives"
    ]
  },
