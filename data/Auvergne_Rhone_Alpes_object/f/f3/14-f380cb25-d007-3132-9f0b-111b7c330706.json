  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2a090a26-21c3-3d48-978c-830dc1b241f2",
      "dc:description": {
        "de": [
          "Machen wir uns auf den Weg, um Vögel zu treffen, die manchmal aus weit entfernten Ländern kommen. Treffpunkt: 10 Uhr auf dem Parkplatz des Gartencenters \"Tulipe\" in Berck.\nAb 8 Jahren"
        ],
        "en": [
          "Let's go and meet the birds that sometimes come from faraway lands. Meet at 10am in the parking lot of the \"Tulipe\" garden center in Berck.\nAges 8 and up"
        ],
        "it": [
          "Andiamo a conoscere gli uccelli che a volte arrivano da terre lontane. Appuntamento alle 10 nel parcheggio del centro di giardinaggio Tulipe a Berck.\nDa 8 anni"
        ],
        "fr": [
          "Partons à la rencontre d’oiseaux venant parfois de contrées lointaines. RDV à 10h sur le parking de la jardinerie « Tulipe » à Berck.\nA partir de 8 ans"
        ],
        "es": [
          "Vamos a conocer aves que a veces vienen de tierras lejanas. Cita a las 10 h en el aparcamiento del centro de jardinería Tulipe de Berck.\nA partir de 8 años"
        ],
        "nl": [
          "Laten we vogels gaan ontmoeten die soms van ver komen. Afspraak om 10u op de parking van tuincentrum Tulipe in Berck.\nVanaf 8 jaar"
        ]
      },
