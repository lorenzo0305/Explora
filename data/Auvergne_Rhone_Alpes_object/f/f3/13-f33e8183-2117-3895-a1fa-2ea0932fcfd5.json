  "rdfs:comment": {
    "de": [
      "Angelegter Wasserplan am Fluss Lignon.\r\nDie Anlage \"La Plage\" empfängt Sie während der Sommerferien für einen Moment der Entspannung und Freizeitgestaltung.\r\nBeaufsichtigtes Baden von Mittwoch bis Sonntag von 14 bis 18 Uhr."
    ],
    "en": [
      "Lake on the Lignon.\r\nThe \"La Plage\" site welcomes you for a moment of relaxation and leisure during the summer vacations.\r\nSupervised swimming from Wednesday to Sunday, 2pm to 6pm."
    ],
    "it": [
      "Lago sul Lignon.\r\nIl sito \"La Plage\" vi accoglie per un momento di relax e svago durante le vacanze estive.\r\nNuoto sorvegliato da mercoledì a domenica dalle 14.00 alle 18.00."
    ],
    "fr": [
      "Plan d'eau aménagé sur le Lignon.\r\nLe site de \"la Plage\" vous accueille pour un moment de détente et de loisirs pendant les vacances estivales.\r\nBaignade surveillée du mercredi au dimanche de 14h à 18h."
    ],
    "nl": [
      "Meer aan de Lignon.\r\nDe camping \"La Plage\" verwelkomt je voor een moment van ontspanning en vrije tijd tijdens de zomervakantie.\r\nZwemmen onder toezicht van woensdag tot zondag van 14 tot 18 uur."
    ],
    "es": [
      "Lago en el Lignon.\r\nEl camping \"La Plage\" le acoge para un momento de relajación y ocio durante las vacaciones de verano.\r\nNatación vigilada de miércoles a domingo de 14:00 a 18:00."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Plage, Plan d'Eau Naturel au Chambon-sur-Lignon"
    ]
  },
