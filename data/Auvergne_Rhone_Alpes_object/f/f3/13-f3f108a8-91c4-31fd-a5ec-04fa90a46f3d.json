  "rdfs:comment": {
    "de": [
      "Das Novotel Megève Mont-Blanc ist ein Hotel, Restaurant, Bar und Tagungsraum und heißt Sie das ganze Jahr über für Freizeit- und Geschäftsaufenthalte sowie festliche Veranstaltungen willkommen."
    ],
    "en": [
      "Hotel, restaurant, bar, meeting rooms, Novotel Megève Mont-Blanc welcomes you all year round for your leisure and business stays and festive events."
    ],
    "it": [
      "Venite a vivere il meglio delle Alpi! Novotel Megève vi accoglie tutto l'anno per i vostri soggiorni di vacanza, professionali ed eventi festivi."
    ],
    "fr": [
      "Hôtel, restaurant, bar, salles de réunions, Novotel Megève Mont-Blanc vous accueille à l’année pour vos séjours loisirs, professionnels et événements festifs."
    ],
    "es": [
      "Hotel, restaurante, bar, salas de reuniones, Novotel Megève Mont-Blanc le da la bienvenida todo el año para sus estancias de ocio, de negocios y eventos festivos."
    ],
    "nl": [
      "Hotel, restaurant, bar, vergaderzalen, Novotel Megève Mont-Blanc verwelkomt u het hele jaar door voor uw vakanties, zakenreizen en feestelijke evenementen."
    ]
  },
