  "rdfs:comment": {
    "de": [
      "Dieses imposante Herrenhaus, das zeitgleich mit dem Hôtel de la Borderie errichtet wurde, ist ein stiller, aber majestätischer Zeuge der Geschichte des Herzens von Cusset. MH 1928."
    ],
    "en": [
      "This imposing residence, contemporary with the Hôtel de la Borderie, is a silent but majestic witness to the history of the heart of Cusset. MH 1928."
    ],
    "it": [
      "Questa imponente residenza, contemporanea all'Hôtel de la Borderie, è un testimone silenzioso ma maestoso della storia del cuore di Cusset. MH 1928."
    ],
    "fr": [
      "Cette imposante demeure, contemporaine de l'Hôtel de la Borderie, constitue un témoin silencieux mais majestueux de l’histoire du cœur de Cusset. MH 1928."
    ],
    "es": [
      "Esta imponente residencia, contemporánea del Hôtel de la Borderie, es un testigo silencioso pero majestuoso de la historia del corazón de Cusset. MH 1928."
    ],
    "nl": [
      "Deze imposante residentie, eigentijds met het Hôtel de la Borderie, is een stille maar majestueuze getuige van de geschiedenis van het hart van Cusset. MH 1928."
    ]
  },
