  "rdfs:comment": {
    "de": [
      "Diese wohlhabende Handelsstadt zeichnet sich durch ihren schachbrettartigen Grundriss aus dem 14. Sehenswert: der Augustinerturm, eine ehemalige Kirche aus dem 15., 16. und 17."
    ],
    "en": [
      "This small and prosperous market town is known for its chequerboard street system dating from the 14th century. Worth seeing are the Augustin tower and churches from the 15th, 16th and 17th century."
    ],
    "it": [
      "Questa prospera città mercato è caratterizzata da un impianto a griglia del XIV secolo. Da non perdere la torre degli Augustins, un'antica chiesa risalente ai secoli XV, XVI e XVII."
    ],
    "fr": [
      "Cette bourgade commerçante prospère se caractérise par son plan en damier datant du XIVè siècle. A voir : la tour des Augustins, ancienne église du XVe, XVIe et XVIIe siècles."
    ],
    "es": [
      "Esta próspera ciudad mercado se caracteriza por su trazado en cuadrícula del siglo XIV. No se pierda la torre Augustins, una antigua iglesia de los siglos XV, XVI y XVII."
    ],
    "nl": [
      "Dit welvarende marktstadje wordt gekenmerkt door zijn 14e-eeuwse roosterindeling. Mis de Augustinus toren niet, een voormalige kerk uit de 15e, 16e en 17e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Beaurepaire : circuit découverte"
    ]
  },
