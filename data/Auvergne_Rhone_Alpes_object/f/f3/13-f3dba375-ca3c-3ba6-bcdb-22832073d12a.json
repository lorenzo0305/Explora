  "rdfs:comment": {
    "de": [
      "Sonia Organistka ist Polstererin für Möbel. Sie haucht Ihren Sitzmöbeln neues Leben ein und restauriert sie nach Ihren Vorstellungen, traditionell oder modern."
    ],
    "en": [
      "Sonia Organistka is an upholsterer. She gives a new life to your seats, restoring them as close as possible to your expectations, in a traditional or modern way."
    ],
    "it": [
      "Sonia Organistka è una tappezziera. Dà nuova vita alle vostre sedute, restituendole alle vostre aspettative, in modo tradizionale o moderno."
    ],
    "fr": [
      "Sonia Organistka est tapissier d'ameublement. Elle donne une nouvelle vie à vos sièges, en les restaurant au plus près de vos attentes, de manière traditionnelle ou moderne."
    ],
    "nl": [
      "Sonia Organistka is een stoffeerder. Zij geeft een nieuw leven aan uw zetels en herstelt ze naar uw verwachtingen, op een traditionele of moderne manier."
    ],
    "es": [
      "Sonia Organistka es tapicera. Le da una nueva vida a sus asientos, devolviéndolos a sus expectativas, de forma tradicional o moderna."
    ]
  },
