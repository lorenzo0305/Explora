  "rdfs:comment": {
    "de": [
      "Seife und Besteck. Der Shop bietet natürliche und authentische Produkte zum Selbermachen oder Spaß haben. Sie finden eine große Auswahl an hervorragenden Produkten aus der Auvergne und Frankreich."
    ],
    "en": [
      "Soaps, candles and cutlery from Thiers. The shop offers naturel and authentic products to buy or to make. You will find a large selection of excellent products made in the Auvergne and France"
    ],
    "it": [
      "Sapone, posate, regali. Il negozio offre prodotti naturali e autentici per soddisfare se stessi o gli altri. Troverete un'ampia gamma di prodotti eccellenti realizzati in Alvernia e in Francia."
    ],
    "fr": [
      "Savonnerie, Coutellerie, Cadeaux. La boutique propose des produits naturels et authentiques pour faire ou se faire plaisir. Vous trouverez une large gamme d'excellents produits fabriqués en Auvergne et en France."
    ],
    "nl": [
      "Zeep, kaars, messen."
    ],
    "es": [
      "Jabones, cubiertos, regalos. La tienda ofrece productos naturales y auténticos para complacerse a sí mismo o a los demás. Usted encontrará una amplia gama de excelentes productos hechos en Auvernia y Francia."
    ]
  },
