  "rdfs:comment": {
    "de": [
      "Die Kirche ist mit Glasfenstern aus dem Jahr 1900 des Glasmalers L. Balmet geschmückt.\r\nDie Malereien im romanischen Kirchenschiff und in der Apsis stammen aus dem Anfang des 20."
    ],
    "en": [
      "The church is adorned with \"1900\" stained-glass windows by L. Balmet.\r\nThe paintings in the nave and Romanesque apse date from the early 20th century."
    ],
    "it": [
      "La chiesa è decorata con vetrate \"1900\" del pittore vetrario L. Balmet.\r\nI dipinti della navata centrale e dell'abside romanica risalgono all'inizio del XX secolo."
    ],
    "fr": [
      "L'église est ornée de vitraux \"1900\" du peintre verrier L. Balmet.\r\nLes peintures de la nef et de l'abside romane datent du début du 20ème."
    ],
    "es": [
      "Un encantador pueblecito al norte de Romans, el pueblo de Montmiral puede verse desde lejos por su imponente iglesia de San Cristóbal, con su campanario y sus dos ábsides de puro estilo románico."
    ],
    "nl": [
      "De kerk is versierd met \"1900\" gebrandschilderde ramen van L. Balmet.\r\nDe schilderijen in het schip en de romaanse apsis dateren uit het begin van de 20e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Christophe"
    ],
    "es": [
      "Iglesia San Cristobal"
    ]
  },
