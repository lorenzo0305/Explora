  "rdfs:comment": {
    "de": [
      "Diese Siedlung wurde in die vier Gemeinden Bourg-Lès-Valence, Châteauneuf-sur-Isère, Alixan und Valence aufgeteilt, die bis zum 1. Juli 1850 geteilt blieben, als Saint-Marcel eine eigenständige Gemeinde wurde, die dem Kanton Valence angegliedert war."
    ],
    "en": [
      "This agglomeration was divided into 4 communes, Bourg-Lès-Valence, Châteauneuf-sur-Isère, Alixan and Valence, which remained divided until July 1, 1850, when Saint-Marcel became a commune in its own right, attached to the canton of Valence."
    ],
    "it": [
      "Questo agglomerato è diviso in 4 comuni, Bourg-Lès-Valence, Châteauneuf-sur-Isère, Alixan e Valence, che rimarranno divisi fino al 1° luglio 1850, quando Saint-Marcel diventerà un comune a sé stante, annesso al cantone di Valence."
    ],
    "fr": [
      "Cette agglomération est divisée en 4 communes, Bourg-Lès-Valence, Châteauneuf-sur-Isère, Alixan et Valence qui resteront divisées jusqu’au 1er juillet 1850 où Saint-Marcel devient une commune à part entière, rattachée au canton de Valence."
    ],
    "es": [
      "Esta aglomeración se divide en 4 municipios, Bourg-Lès-Valence, Châteauneuf-sur-Isère, Alixan y Valence, que permanecerán divididos hasta el 1 de julio de 1850, cuando Saint-Marcel se convierte en un municipio de pleno derecho, adscrito al cantón de Valence."
    ],
    "nl": [
      "Deze agglomeratie werd opgedeeld in 4 gemeenten, Bourg-Lès-Valence, Châteauneuf-sur-Isère, Alixan en Valence, die verdeeld bleven tot 1 juli 1850, toen Saint-Marcel een volwaardige gemeente werd die bij het kanton Valence hoorde."
    ]
  },
