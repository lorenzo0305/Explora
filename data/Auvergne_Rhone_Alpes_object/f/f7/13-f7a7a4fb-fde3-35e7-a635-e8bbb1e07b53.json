  "rdfs:comment": {
    "de": [
      "10 Min. von St Jean en Royans entfernt. Probieren Sie unsere regionale Spezialität: hausgemachte Ravioles. Terrasse, Garten, Parkplatz."
    ],
    "en": [
      "At an altitude of 500 meters, at the foot of mountains, you will be welcome in a friendly way and you will taste local products and our specialties: \"home-made ravioles\", game, jams, chicken with crayfish, frog legs…"
    ],
    "it": [
      "A 10 minuti da St Jean en Royans, gustate la nostra specialità regionale: i ravioli fatti in casa. Terrazza, giardino, parcheggio."
    ],
    "fr": [
      "A 10 min de St Jean en Royans, dégustez notre spécialité régionale : ravioles fabrication maison. Terrasse, jardin, parking."
    ],
    "nl": [
      "Proef op 10 minuten van St Jean en Royans onze regionale specialiteit: huisgemaakte ravioli. Terras, tuin, parkeerplaats."
    ],
    "es": [
      "A 10 minutos de St Jean en Royans, pruebe nuestra especialidad regional: los raviolis caseros. Terraza, jardín, aparcamiento."
    ]
  },
