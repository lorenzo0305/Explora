  "rdfs:comment": {
    "de": [
      "Traditionelles und familiäres Restaurant zwischen Thonon und Morzine, nur wenige Schritte von der Schlucht Pont du Diable entfernt. Wir bieten Ihnen eine großzügige Küche in einer familiären und freundlichen Atmosphäre."
    ],
    "en": [
      "A traditional and family-run restaurant, located between Thonon and Morzine and a stone’s throw from the Devil’s Bridge Gorges. We offer hearty cooking as well as a family-friendly and welcoming atmosphere."
    ],
    "it": [
      "Ristorante tradizionale e familiare, situato tra Thonon e Morzine, a pochi passi dalle gole del Pont du Diable. Offriamo una cucina generosa in un'atmosfera familiare e amichevole."
    ],
    "fr": [
      "Restaurant traditionnel et familial, situé entre Thonon et Morzine, à quelques pas des gorges du Pont du Diable. Nous vous proposons une cuisine généreuse dans une ambiance familiale et conviviale."
    ],
    "nl": [
      "Traditioneel en familierestaurant, gelegen tussen Thonon en Morzine, op enkele passen van de kloof Pont du Diable. Wij bieden een royale keuken in een vriendelijke familiesfeer."
    ],
    "es": [
      "Restaurante tradicional y familiar, situado entre Thonon y Morzine, a pocos pasos del desfiladero del Pont du Diable. Ofrecemos una cocina generosa en un ambiente familiar y acogedor."
    ]
  },
  "rdfs:label": {
    "en": [
