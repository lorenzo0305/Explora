  "rdfs:comment": {
    "de": [
      "Die Bibliothek/Mediothek in Saint-Jeures ist seit Mittwoch, dem 21. März 2007, für die Öffentlichkeit zugänglich.\r\n\r\nIm Jahr 2025 erhält die Bibliothek ein neues Gesicht, das Projekt des zukünftigen Kulturzentrums von Saint-Jeures. Die Bauarbeiten haben im Januar 2025 begonnen."
    ],
    "en": [
      "The Saint-Jeures library/media center opened to the public on Wednesday March 21, 2007.\r\n\r\nIn 2025, the library will undergo a facelift as part of Saint-Jeures' future cultural hub project. Work began in January 2025."
    ],
    "it": [
      "La biblioteca/centro multimediale di Saint-Jeures è stata aperta al pubblico mercoledì 21 marzo 2007.\r\n\r\nNel 2025, la biblioteca si rinnoverà nell'ambito del progetto di creazione del futuro polo culturale di Saint-Jeures. I lavori sono iniziati nel gennaio 2025."
    ],
    "fr": [
      "La bibliothèque/médiathèque de Saint-Jeures a ouvert au public depuis le mercredi 21 mars 2007. \r\n\r\nEn 2025, la bibliothèque fait peau neuve, le projet du futur pôle culturel de Saint-Jeures. Les travaux ont commencé en janvier 2025."
    ],
    "es": [
      "La biblioteca-mediateca de Saint-Jeures abrió sus puertas al público el miércoles 21 de marzo de 2007.\r\n\r\nEn 2025, la biblioteca será renovada en el marco del proyecto de creación del futuro centro cultural de Saint-Jeures. Las obras comenzaron en enero de 2025."
    ],
    "nl": [
      "De bibliotheek/het mediacentrum van Saint-Jeures is op woensdag 21 maart 2007 geopend voor het publiek.\r\n\r\nIn 2025 krijgt de bibliotheek een facelift als onderdeel van het project om het toekomstige culturele centrum van Saint-Jeures te creëren. De werkzaamheden zijn gestart in januari 2025."
    ]
  },
  "rdfs:label": {
