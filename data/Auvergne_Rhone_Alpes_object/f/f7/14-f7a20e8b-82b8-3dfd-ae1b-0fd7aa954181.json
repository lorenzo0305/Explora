  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1ddbb5ad-15d5-3abd-9d17-eb87a818797a",
      "dc:description": {
        "de": [
          "Informationen:\n\nÖffnungszeiten:\n\nMontag, Dienstag, Donnerstag, Freitag und Samstag: 6:00-19:00 Uhr\nSonntag: 6:00-12:30 Uhr\n\nMittwoch geschlossen\n\n \n\n Rücknahme:\n\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\n\nBestellung:\n\nTelefonische Bestellung unter 03 21 24 91 60 möglich\n\n "
        ],
        "en": [
          "More information:\n\nOpening days:\n\nMonday, Tuesday, Thursday, Friday and Saturday: 6am-7pm\nSunday: 6am-12.30pm\n\nClosed on Wednesday\n\n \n\n Collection:\n\nTakeaway during bakery opening hours\n\nTo order:\n\nOrder by phone 03 21 24 91 60\n\n "
        ],
        "it": [
          "Per ulteriori informazioni:\n\nGiorni di apertura:\n\nLunedì, martedì, giovedì, venerdì e sabato: 6.00-19.00\nDomenica: 6.00-12.30\n\nChiuso il mercoledì\n\n \n\n Collezione:\n\nDa asporto durante gli orari di apertura della pasticceria\n\nCome ordinare\n\nÈ possibile ordinare per telefono al numero 03 21 24 91 60\n\n "
        ],
        "fr": [
          "Informations:\n\nJours d'ouverture:\n\nLe lundi, mardi, jeudi, vendredi et samedi: 6h-19h\nLe dimanche: 6h-12h30\n\nFermeture le mercredi \n\n \n\n Retrait:\n\nA emporter aux horaires d'ouverture de la boulangerie\n\nCommande:\n\nPossibilité de commander par téléphone au 03 21 24 91 60\n\n "
        ],
        "nl": [
          "Voor meer informatie:\n\nOpeningsdagen:\n\nMaandag, dinsdag, donderdag, vrijdag en zaterdag: 6u-19u\nZondag: 6.00-12.30\n\nWoensdag gesloten\n\n \n\n Collectie:\n\nAfhalen tijdens openingstijden bakkerij\n\nHoe te bestellen\n\nU kunt telefonisch bestellen op 03 21 24 91 60\n\n "
        ],
        "es": [
          "Para más información:\n\nDías de apertura:\n\nLunes, martes, jueves, viernes y sábado: de 6.00 a 19.00 h\nDomingo: de 6.00 a 12.30 h\n\nMiércoles cerrado\n\n \n\n Recogida:\n\nPara llevar durante el horario de apertura de la panadería\n\nCómo hacer un pedido\n\nPuede hacer su pedido por teléfono llamando al 03 21 24 91 60\n\n "
        ]
      },
