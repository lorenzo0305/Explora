  "rdfs:comment": {
    "de": [
      "Entdecken Sie Bamatruck, den neuen Foodtruck made by Bamavi! Genießen Sie die im Holzofen gebackenen Flammekueches, die Spezialität des Hauses. Restauration \"hausgemacht\". Umzug in die Region Roannais: Neulise, c?ur de Roanne, Villemontais, Chausseterre und Noirétable."
    ],
    "en": [
      "Discover Bamatruck, the new foodtruck made by Bamavi! Enjoy wood-fired Flammekueches, the house specialty. Home-made catering. Locations in Roannais: Neulise, heart of Roanne, Villemontais, Chausseterre and Noirétable."
    ],
    "it": [
      "Scoprite Bamatruck, il nuovo foodtruck di Bamavi! Gustate le Flammekueches cotte a legna, la specialità della casa. Ristorazione fatta in casa. Viaggiando nella zona di Roannais: Neulise, cuore di Roanne, Villemontais, Chausseterre e Noirétable."
    ],
    "fr": [
      "Découvrez Bamatruck, le nouveau foodtruck made by Bamavi ! Profitez des Flammekueches cuites au feu de bois, spécialités de la maison. Restauration \"fait maison\". Déplacement en Roannais : Neulise, cœur de Roanne, Villemontais, Chausseterre et Noirétable."
    ],
    "nl": [
      "Ontdek Bamatruck, de nieuwe foodtruck van Bamavi! Geniet van houtgestookte Flammekueches, de specialiteit van het huis. Huisgemaakte catering. Reizen in de omgeving van Roannais: Neulise, hartje Roanne, Villemontais, Chausseterre en Noirétable."
    ],
    "es": [
      "Descubra Bamatruck, el nuevo foodtruck de Bamavi Disfrute de Flammekueches a la leña, la especialidad de la casa. Catering casero. Viajar por la zona de Roannais: Neulise, corazón de Roanne, Villemontais, Chausseterre y Noirétable."
    ]
  },
