  "rdfs:comment": {
    "de": [
      "Die Compagnie des Guides de Saint-Gervais ist eine Institution mit über 160 Jahren Erfahrung. Heute zählt sie 85 Bergführer und Begleiter, die ihre Kunden in das Mont-Blanc-Massiv und in die ganze Welt mitnehmen."
    ],
    "en": [
      "The Compagnie des Guides de Saint-Gervais is an institution with over 160 years' experience. Today it has 85 guides and leaders who take their clients around the Mont-Blanc massif and the world."
    ],
    "it": [
      "La Compagnie des Guides de Saint-Gervais è un'istituzione con oltre 160 anni di esperienza e conta oggi 85 guide e accompagnatori che portano i loro clienti in giro per il massiccio del Monte Bianco e per il mondo."
    ],
    "fr": [
      "La Compagnie des Guides de Saint-Gervais est une institution forte de plus de 160 ans d’expérience, elle compte aujourd’hui 85 guides et accompagnateurs qui emmènent leurs clients dans le massif du Mont-Blanc et à travers le monde."
    ],
    "es": [
      "La Compagnie des Guides de Saint-Gervais es una institución con más de 160 años de experiencia. Hoy cuenta con 85 guías y animadores que llevan a sus clientes por el macizo del Mont-Blanc y el mundo."
    ],
    "nl": [
      "De Compagnie des Guides de Saint-Gervais is een instituut met meer dan 160 jaar ervaring en telt vandaag 85 gidsen en begeleiders die hun klanten rondleiden in het massief van de Mont-Blanc en de wereld."
    ]
  },
