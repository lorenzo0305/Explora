  "rdfs:comment": {
    "de": [
      "Verkauf von Geflügel, Hühnern, Kaninchen, Hähnen, Hennen, Truthähnen ab Hof.\r\nVerkauf von Festtagsgeflügel Kapaune, Puten ... Hähnchen und Kaninchen zum Zerlegen.\r\nVerkauf von verarbeiteten Produkten, Rillettes, Terrinen und Blättermagen.\r\nEier vom Bauernhof."
    ],
    "en": [
      "Farm shop selling poultry, chicken, rabbit, cockerel and turkey.\r\nChristmas turkey and capon also on sale, as well as chicken and rabbit cuts.\r\nEggs from the farm."
    ],
    "it": [
      "Vendita di pollame, polli, conigli, galli, galline e tacchini.\r\nVendita di pollame da festa: capponi, tacchini, ecc. Polli e conigli da tagliare.\r\nVendita di prodotti trasformati, rillettes, terrine e ventrigli.\r\nUova di fattoria."
    ],
    "fr": [
      "Vente à la ferme de volailles, poulets, lapins, coqs, poules, dinde.\r\nVente de volailles festives chapons, dindes ... poulets et lapins à la découpe.\r\nVente de produits transformés, rillettes, terrines et gésiers.\r\nOeufs fermiers."
    ],
    "es": [
      "Venta de aves de corral, pollos, conejos, gallos, gallinas y pavos.\r\nVenta de aves festivas: capones, pavos, etc. Pollos y conejos para despiece.\r\nVenta de productos transformados, rillettes, terrinas y mollejas.\r\nHuevos de granja."
    ],
    "nl": [
      "Boerderijverkoop van pluimvee, kippen, konijnen, hanen, kippen en kalkoenen.\r\nVerkoop van feestpluimvee: kapoenen, kalkoenen, etc. Kippen en konijnen om in stukken te snijden.\r\nVerkoop van verwerkte producten, rillettes, terrines en spiermaagjes.\r\nEieren van de boerderij."
    ]
  },
