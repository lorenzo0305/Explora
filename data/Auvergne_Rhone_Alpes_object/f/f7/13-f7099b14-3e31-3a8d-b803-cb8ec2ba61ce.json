  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Crêperie Mamie Claude.\r\nIdeal gelegen im Herzen der Place des Clercs in Valence, genießen Sie hier eine authentische Küche mit großzügig belegten Galettes und verschiedenen süßen Crêpes."
    ],
    "en": [
      "Discover Mamie Claude's crêperie.\r\nIdeally located in the heart of Place des Clercs in Valence, come and enjoy authentic cuisine with generously filled galettes and a variety of sweet crepes."
    ],
    "it": [
      "Scoprite la crêperie Mamie Claude.\r\nSituata in posizione ideale nel cuore di Place des Clercs a Valence, venite a gustare una cucina autentica con generose galettes e una varietà di crêpes dolci."
    ],
    "fr": [
      "Découvrez la crêperie Mamie Claude.\r\nIdéalement située en plein cœur de la place des Clercs à Valence, venez déguster une cuisine authentique avec des galettes généreusement garnies et des crêpes sucrées variées."
    ],
    "nl": [
      "Ontdek de crêperie van Mamie Claude.\r\nIdeaal gelegen in het hart van de Place des Clercs in Valence, kom genieten van de authentieke keuken met royaal gevulde galettes en een verscheidenheid aan zoete crêpes."
    ],
    "es": [
      "Descubra la crepería Mamie Claude.\r\nIdealmente situada en el corazón de la Place des Clercs de Valence, venga a degustar una cocina auténtica con galettes generosamente rellenas y una gran variedad de crêpes dulces."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crêperie Mamie Claude"
    ]
  },
