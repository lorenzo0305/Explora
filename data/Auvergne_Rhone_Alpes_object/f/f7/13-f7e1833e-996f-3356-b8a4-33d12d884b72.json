  "rdfs:comment": {
    "de": [
      "Erleben Sie eine einzigartige Sinnesreise im Herzen der Region Avesnois und lassen Sie sich von den Herstellungsgeheimnissen der Käserei La Fromagerie überraschen"
    ],
    "en": [
      "Come and experience a unique sensory journey in the heart of the Avesnois region, and discover the secrets of La Fromagerie's production"
    ],
    "it": [
      "Venite a vivere un viaggio sensoriale unico nel cuore della regione dell'Avesnois e lasciatevi sorprendere dai segreti della produzione de La Fromagerie"
    ],
    "fr": [
      "Venez vivre un voyage sensoriel unique au coeur de l'Avesnois et laissez-vous surprendre par les secrets de fabrication de La Fromagerie"
    ],
    "es": [
      "Venga a vivir un viaje sensorial único al corazón de la región de Avesnois y déjese sorprender por los secretos de la producción de La Fromagerie"
    ],
    "nl": [
      "Kom en beleef een unieke zintuiglijke reis naar het hart van de Avesnois regio en laat je verrassen door de geheimen achter de productie van La Fromagerie"
    ]
  },
