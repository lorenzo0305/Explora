  "rdfs:comment": {
    "de": [
      "Im Ort Notre Dame de Grâces in der Gemeinde Chambles bietet das 2022 eingeweihte Maison Elisabeth einen Veranstaltungsraum, der sich ideal für Konferenzen, Seminare, Firmen- oder Familientreffen eignet."
    ],
    "en": [
      "Located in the village of Notre Dame de Grâces in the commune of Chambles, the Maison Elisabeth, inaugurated in 2022, offers a reception room ideal for conferences, seminars, company or family reunions."
    ],
    "it": [
      "Situata nel villaggio di Notre Dame de Grâces, nel comune di Chambles, la Maison Elisabeth, inaugurata nel 2022, offre una sala ricevimenti ideale per conferenze, seminari, incontri d'affari o riunioni di famiglia."
    ],
    "fr": [
      "Au lieu-dit Notre Dame de Grâces sur la commune de Chambles, la Maison Elisabeth, inaugurée en 2022, offre une salle de réception, idéale pour des conférences, séminaires, réunion d'entreprise ou familiale."
    ],
    "es": [
      "Situada en el pueblo de Notre Dame de Grâces, en la comuna de Chambles, la Maison Elisabeth, inaugurada en 2022, ofrece una sala de recepción ideal para conferencias, seminarios, reuniones de negocios o encuentros familiares."
    ],
    "nl": [
      "Gelegen in het dorp Notre Dame de Grâces in de gemeente Chambles, biedt het Maison Elisabeth, ingehuldigd in 2022, een ontvangstruimte die ideaal is voor conferenties, seminars, zakelijke bijeenkomsten of familiebijeenkomsten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Elisabeth - Salle en location"
