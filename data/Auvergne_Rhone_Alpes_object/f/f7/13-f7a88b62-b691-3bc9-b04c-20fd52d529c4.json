  "rdfs:comment": {
    "de": [
      "Einfallsreiche Küche aus frischen, saisonalen Produkten, die mit Aromen aus aller Welt verfeinert werden, in einem warmen und gemütlichen Rahmen.\r\nEntdecken Sie unsere Geselligkeit, indem Sie von unserer \"grande tablée\" für 9 bis 12 Personen profitieren."
    ],
    "en": [
      "Inventive cuisine based on fresh seasonal produce, with a twist of world flavours in a warm, cosy setting.\r\nDiscover our conviviality by enjoying our dishes to share or by reserving our \"grande tablée\" for 9 to 12 people."
    ],
    "it": [
      "Cucina inventiva a base di prodotti freschi di stagione, con un tocco di sapori del mondo in un ambiente caldo e accogliente.\r\nScoprite la nostra convivialità gustando la nostra \"grande tablée\" per 9-12 persone."
    ],
    "fr": [
      "Cuisine inventive à base de produits frais et de saisons, twistés des saveurs du monde dans un cadre chaleureux et cosy.\r\nDécouvrez notre convivialité en profitant de  notre \"grande tablée\" pour 9 à 12 personnes."
    ],
    "nl": [
      "Inventieve keuken op basis van verse seizoensproducten, met een vleugje wereldse smaken in een warm, gezellig kader.\r\nOntdek onze gezelligheid door te genieten van onze \"grande tablée\" voor 9 tot 12 personen."
    ],
    "es": [
      "Cocina inventiva basada en productos frescos de temporada, con un toque de sabores del mundo en un ambiente cálido y acogedor.\r\nDescubra nuestra convivialidad disfrutando de nuestra \"grande tablée\" para 9 a 12 personas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Epicurieux"
    ],
    "fr": [
      "Les Epicurieux"
    ]
  },
