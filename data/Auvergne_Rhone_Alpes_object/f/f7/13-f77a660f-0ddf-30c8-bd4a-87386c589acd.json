  "rdfs:comment": {
    "de": [
      "Die Kirche, die der bedeutenden Benediktinerabtei Menatn in der Diözese Clermont Ferrand unterstand, wurde auf einem romanischen Grundriss errichtet. Verschiedene Erweiterungen und Umbauten verändern das ursprüngliche Aussehen."
    ],
    "en": [
      "Dependent on the important Benedictine Abbey of Menatn in the diocese of Clermont Ferrand, the church is built on a Romanesque plan. Various enlargements and alterations have modified the original appearance."
    ],
    "it": [
      "Dipendente dall'importante abbazia benedettina di Menatn, diocesi di Clermont Ferrand, la chiesa fu costruita su un impianto romanico. Vari ampliamenti e modifiche hanno modificato l'aspetto iniziale."
    ],
    "fr": [
      "Dépendant de l'importante abbaye bénédictine de Menatn diocèse de Clermont Ferrand, l'Eglise est érigée sur un plan roman. Différents agrandissements et remaniements viennent modifier l'aspect initial."
    ],
    "es": [
      "Dependiente de la importante abadía benedictina de Menatn, diócesis de Clermont Ferrand, la iglesia se construyó sobre una planta románica. Varias ampliaciones y alteraciones han modificado el aspecto inicial."
    ],
    "nl": [
      "De kerk is afgeleid van de belangrijke benedictijnenabdij van Menatn, bisdom Clermont Ferrand, en werd gebouwd op een Romaans plan. Verschillende uitbreidingen en veranderingen hebben het oorspronkelijke uiterlijk gewijzigd."
    ]
  },
  "rdfs:label": {
