  "rdfs:comment": {
    "de": [
      "Annick und Ludovic sind leidenschaftliche Kastanienbauern.\r\nDirektverkauf auf dem Bauernhof nach Vereinbarung: Kastanien und Produkte auf Kastanienbasis.\r\nProdukte werden auch in verschiedenen Verkaufsstellen (siehe Website) und im Online-Shop verkauft."
    ],
    "en": [
      "Annick and Ludovic are passionate chestnut growers.\r\nDirect sale at the farm by appointment: chestnuts and chestnut-based products.\r\nProducts also sold in various sale outlets (see website) and on the online shop."
    ],
    "it": [
      "Annick e Ludovic sono appassionati coltivatori di castagne.\r\nVendita diretta in azienda su appuntamento: castagne e prodotti a base di castagne.\r\nI prodotti sono venduti anche in vari punti vendita (vedi sito web) e sul negozio online."
    ],
    "fr": [
      "Annick et Ludovic sont des castanéiculteurs passionnés.\r\nVente directe à la ferme sur rendez-vous : châtaignes et produits à base de châtaignes.\r\nProduits également vendus dans différents points de vente (voir le site internet) et sur la boutique en ligne."
    ],
    "es": [
      "Annick y Ludovic son castañeros apasionados.\r\nVenta directa en la granja con cita previa: castañas y productos a base de castañas.\r\nLos productos también se venden en diversos puntos de venta (véase el sitio web) y en la tienda en línea."
    ],
    "nl": [
      "Annick en Ludovic zijn gepassioneerde kastanjetelers.\r\nDirecte verkoop op de boerderij op afspraak: kastanjes en producten op basis van kastanjes.\r\nProducten worden ook verkocht in verschillende verkooppunten (zie website) en via de online shop."
    ]
  },
