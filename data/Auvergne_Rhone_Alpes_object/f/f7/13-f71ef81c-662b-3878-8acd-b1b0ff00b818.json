  "rdfs:comment": {
    "de": [
      "Grillspezialitäten von Rind, Büffel, Fisch... gemischte Salate und eine große Auswahl an Desserts. Indoor-Spielzimmer mit Videotoon für Kinder."
    ],
    "en": [
      "Grilled beef, bison, fish... mixed salads and a wide choice of desserts. Indoor playroom equipped with a videoton for children."
    ],
    "it": [
      "Specialità di manzo alla griglia, bisonte, pesce... insalate miste e un'ampia scelta di dessert. Sala giochi interna dotata di videoterminale per bambini."
    ],
    "fr": [
      "Spécialités de grillades de boeuf, bison, poisson... salades composées et larges choix de desserts. Salle de jeux intérieure équipée d'un vidéotoon pour les enfants."
    ],
    "nl": [
      "Specialiteiten van gegrild rundvlees, bizon, vis... gemengde salades en een ruime keuze aan desserts. Binnenspeelruimte uitgerust met een videotoon voor kinderen."
    ],
    "es": [
      "Especialidades de ternera a la parrilla, bisonte, pescado... ensaladas mixtas y una amplia selección de postres. Sala de juegos interior equipada con un videoteléfono para los niños."
    ]
  },
