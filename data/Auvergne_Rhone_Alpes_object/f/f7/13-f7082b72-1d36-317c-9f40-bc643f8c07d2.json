  "rdfs:comment": {
    "de": [
      "Im Aux 4 Saisons in Saulcet pflegen wir die Rückkehr zu den Wurzeln: eine einfache, authentische und effiziente Küche, in der der wahre Geschmack der Saisonprodukte im Vordergrund steht. Genießen Sie das Wesentliche, schmecken Sie den Unterschied."
    ],
    "en": [
      "Traditional and gourmet cooking."
    ],
    "it": [
      "A Les 4 Saisons di Saulcet, il nostro obiettivo è tornare all'essenziale: una cucina semplice, autentica ed efficiente, dove il vero gusto dei prodotti di stagione è al primo posto. Assaporare l'essenziale, gustare la differenza."
    ],
    "fr": [
      "Aux 4 Saisons à Saulcet, nous cultivons le retour aux sources : une cuisine simple, authentique et efficace, où le goût vrai des produits de saison est à l'honneur. Savourez l'essentiel, goûter la différence."
    ],
    "nl": [
      "Traditionele en gastronomische keuken."
    ],
    "es": [
      "En Les 4 Saisons, en Saulcet, nos gusta volver a lo esencial: una cocina sencilla, auténtica y eficaz, en la que el auténtico sabor de los productos de temporada ocupa un lugar privilegiado. Saboree lo esencial, pruebe la diferencia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les 4 Saisons"
    ],
    "nl": [
      "Les Quatre Saisons"
    ]
  },
