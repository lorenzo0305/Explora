  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/64a96eff-3468-361a-ad0b-2677b9337260",
      "dc:description": {
        "de": [
          "Naturwanderung mit Eden 62 in Zusammenarbeit mit dem Conservatoire d'espaces naturels des Hauts de France - Geologie und Biodiversität - Um 10 Uhr\nRéserve Naturelle de la baie de Canche et Domaine du Rohart - Entdecken Sie die Reichtümer, die diese beiden Naturgebiete bieten - Treffpunkt um 10 Uhr auf dem Parkplatz des britischen Friedhofs von Etaples sur Mer ? Kostenlos"
        ],
        "en": [
          "Nature walk with Eden 62 in partnership with the Conservatoire d'espaces naturels des Hauts de France - Geology and biodiversity - At 10am\nNature Reserve of the Bay of Canche and Domaine du Rohart - Discover the richness of these two natural sites - Meeting point at 10 am at the parking of the British cemetery of Etaples sur Mer - Free"
        ],
        "it": [
          "Passeggiata naturalistica con Eden 62 in collaborazione con il Conservatoire d'espaces naturels des Hauts de France - Geologia e biodiversità - Ore 10.00\nRiserva naturale della baia di Canche e Domaine du Rohart - Scoprite la ricchezza di questi due siti naturali - Punto d'incontro alle ore 10 presso il parcheggio del cimitero britannico di Etaples sur Mer - Gratuito"
        ],
        "fr": [
          "Balade Nature avec Eden 62 en partenariat avec le Conservatoire d'espaces naturels des Hauts de France - Géologie et biodiversité - A 10h\nRéserve Naturelle de la baie de Canche et Domaine du Rohart - Partez à la découverte des richesses qu'offrent ces deux sites naturels - Rendez-vous à 10h sur le parking du cimetière britannique d'Etaples sur Mer – Gratuit"
        ],
        "es": [
          "Paseo por la naturaleza con Eden 62 en colaboración con el Conservatoire d'espaces naturels des Hauts de France - Geología y biodiversidad - A las 10h\nReserva Natural de la Bahía de Canche y Domaine du Rohart - Descubra la riqueza de estos dos parajes naturales - Punto de encuentro a las 10:00 horas en el aparcamiento del cementerio británico de Etaples sur Mer - Gratis"
        ],
        "nl": [
          "Natuurwandeling met Eden 62 in samenwerking met het Conservatoire d'espaces naturels des Hauts de France - Geologie en biodiversiteit - Om 10.00 uur\nNatuurreservaat van de Baai van Canche en het Domaine du Rohart - Ontdek de rijkdom van deze twee natuurgebieden - Trefpunt om 10 uur op de parkeerplaats van de Britse begraafplaats in Etaples sur Mer - Gratis"
        ]
      },
      "@type": [
        "Description"
      ],
