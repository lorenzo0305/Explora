  "rdfs:comment": {
    "de": [
      "Wenn Sie durch die Tür der Bibliothek von Charnècles gehen, treten Sie in das Netz der 19 Bibliotheken im Pays Voironnais ein. Eine einzige Karte, ein einziger Tarif, um Zugang zu allen von den Bibliotheken angebotenen Dienstleistungen zu erhalten."
    ],
    "en": [
      "To pass the door of the Charnècles library is to enter the network of 19 libraries in the Pays Voironnais. A single card, a single rate to access all the services offered by the libraries."
    ],
    "it": [
      "Varcare la porta della biblioteca di Charnècles significa entrare nella rete delle 19 biblioteche del Pays Voironnais. Un'unica tessera, un unico prezzo per accedere a tutti i servizi offerti dalle biblioteche."
    ],
    "fr": [
      "Passer la porte de la bibliothèque de Charnècles, c’est entrer dans le réseau des 19 bibliothèques en Pays Voironnais. Une carte unique, un tarif unique pour accéder à l’ensemble des services proposés par les bibliothèques."
    ],
    "es": [
      "Pasar por la puerta de la biblioteca de Charnècles significa entrar en la red de 19 bibliotecas del Pays Voironnais. Un único carné, un único precio para acceder a todos los servicios que ofrecen las bibliotecas."
    ],
    "nl": [
      "Als u door de deur van de bibliotheek van Charnècles gaat, betreedt u het netwerk van 19 bibliotheken in het Pays Voironnais. Eén kaart, één tarief voor toegang tot alle diensten van de bibliotheken."
    ]
  },
