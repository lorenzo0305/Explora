  "rdfs:comment": {
    "de": [
      "Boutique für Kleidung und Accessoires in ethischer und ethnischer Mode für Frauen, Männer und Kinder.\r\nNeu! Aufbewahrung hübscher gebrauchter Kleidung von März bis Juni und von September bis Dezember."
    ],
    "en": [
      "Ethical and ethnic clothing and accessories for women, men and children.\r\nNew ! Sale of nice second hand clothes from March to June and from September to December."
    ],
    "it": [
      "Abbigliamento e accessori etici ed etnici per donne, uomini e bambini.\r\nNuovo! Vendita di bellissimi abiti di seconda mano da marzo a giugno e da settembre a dicembre."
    ],
    "fr": [
      "Boutique de vêtements et accessoires en mode éthique et ethnique pour femmes, hommes et enfants.\r\nNouveau ! Dépôt de jolis vêtements d'occasion de mars à juin et de septembre à décembre."
    ],
    "es": [
      "Ropa y accesorios éticos y étnicos para mujeres, hombres y niños.\r\n¡Nuevo! Venta de ropa bonita de segunda mano de marzo a junio y de septiembre a diciembre."
    ],
    "nl": [
      "Ethische en etnische kleding en accessoires voor vrouwen, mannen en kinderen.\r\nNieuw! Verkoop van mooie tweedehands kleding van maart tot juni en van september tot december."
    ]
  },
