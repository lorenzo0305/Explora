  "rdfs:comment": {
    "de": [
      "Große Auswahl an Pizzen, die vor Ort auf handwerkliche Weise geknetet und zubereitet werden. Qualitätsprodukte und hausgemachte Küche. Kostenlose Lieferung im gesamten Skigebiet von Valmorel."
    ],
    "en": [
      "Large choice of homemade pizzas prepared on the spot. Quality products and home cooking. Free Delivery on all Valmorel station."
    ],
    "it": [
      "Ampia scelta di pizze impastate e preparate sul posto in modo artigianale. Prodotti di qualità e cucina casalinga. Consegna gratuita in tutto il comprensorio di Valmorel."
    ],
    "fr": [
      "Large choix de pizzas pétries et préparées sur place de façon artisanale. Produits de qualité et cuisine maison. Livraison gratuite sur toute la station de Valmorel."
    ],
    "nl": [
      "Grote keuze aan zelfgemaakte pizza's die ter plaatse worden bereid. Kwaliteitsproducten en thuis koken. Gratis levering op alle Valmorel-station."
    ],
    "es": [
      "Amplia selección de pizzas amasadas y preparadas al momento de forma artesanal. Productos de calidad y cocina casera. Entrega gratuita en toda la estación de Valmorel."
    ]
  },
