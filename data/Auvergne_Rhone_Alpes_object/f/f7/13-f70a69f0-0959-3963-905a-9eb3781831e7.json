  "rdfs:comment": {
    "de": [
      "Savoyardisches Restaurant in einem Teil des Bauernhofs, durch die Fenster blickt man direkt auf den Stall. Genießen Sie die vor Ort hergestellten Käsespezialitäten. Herzliche und familiäre Atmosphäre."
    ],
    "en": [
      "A traditional Savoyard restaurant located in a farmhouse, with bay windows directly overlooking the barn. Enjoy our specialties made with local cheeses. A warm and family-friendly atmosphere."
    ],
    "it": [
      "Ristorante savoiardo in una parte della cascina con finestre direttamente sulla stalla. Gustate le specialità di formaggio prodotte in loco. Atmosfera calda e familiare."
    ],
    "fr": [
      "Restaurant Savoyard aménagé dans une partie de la ferme avec fenêtres donnant directement sur l'étable. Régalez-vous avec les spécialités fromagères produites sur place. Cadre familial et chaleureux."
    ],
    "nl": [
      "Savoyaards restaurant in een deel van de boerderij met ramen direct op de stal. Geniet van de ter plaatse geproduceerde kaasspecialiteiten. Warme en familiale sfeer."
    ],
    "es": [
      "Restaurante saboyano en una parte de la granja con ventanas directamente al establo. Disfrute de las especialidades de queso producidas in situ. Ambiente cálido y familiar."
    ]
  },
