  "rdfs:comment": {
    "de": [
      "Im Herzen der Zone Artisanale des Varennes gelegen, empfängt Sie Pathé Aubière (ex-Ciné Dôme) an 365 Tagen im Jahr, um Ihre Emotionen intensiv zu erleben! Nutzen Sie die Gelegenheit, um unsere immersiven IMAX Laser- und dynamischen 4DX-Erlebnisse zu entdecken."
    ],
    "en": [
      "Located in the heart of the Zone Artisanale des Varennes, Pathé Aubière (ex-Ciné Dôme) welcomes you 365 days a year to experience your emotions to the full! Take the opportunity to discover our immersive IMAX Laser and dynamic 4DX experiences."
    ],
    "it": [
      "Situato nel cuore della Zone Artisanale des Varennes, Pathé Aubière (ex-Ciné Dôme) vi accoglie 365 giorni all'anno per vivere appieno le vostre emozioni! Cogliete l'occasione per scoprire le nostre coinvolgenti esperienze IMAX Laser e 4DX dinamico."
    ],
    "fr": [
      "Situé au coeur de la Zone Artisanale des Varennes, Pathé Aubière (ex-Ciné Dôme) vous accueille 365 jours par an pour vivre vos émotions intensément ! Profitez-en pour découvrir nos expériences immersive IMAX Laser et dynamique 4DX."
    ],
    "es": [
      "Situado en el corazón de la Zone Artisanale des Varennes, Pathé Aubière (ex-Ciné Dôme) le da la bienvenida los 365 días del año para que viva sus emociones al máximo Aproveche la oportunidad de descubrir nuestras inmersivas experiencias IMAX Láser y 4DX dinámico."
    ],
    "nl": [
      "Pathé Aubière (ex-Ciné Dôme), gelegen in het hart van de Zone Artisanale des Varennes, verwelkomt je 365 dagen per jaar om je emoties ten volle te beleven! Maak van de gelegenheid gebruik om onze meeslepende IMAX Laser en dynamische 4DX ervaringen te ontdekken."
    ]
  },
  "rdfs:label": {
