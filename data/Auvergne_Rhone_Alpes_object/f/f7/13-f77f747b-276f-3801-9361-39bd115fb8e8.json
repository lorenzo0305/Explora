  "rdfs:comment": {
    "de": [
      "Große schattige Terrasse mit Bar- und Restaurantbereich. Traditionelle Küche mit lokalen und saisonalen Produkten. Formeln mit Tagesgericht, Menü oder à la carte. Große Auswahl an Bieren. Eisbecherkarte."
    ],
    "en": [
      "Large shady terrace with a space for the bar and for the restaurant. Traditional cuisine with local and seasonal products. Dish of the day, menu . Large choice of beers."
    ],
    "it": [
      "Ampia terrazza ombreggiata con bar e area ristorante. Cucina tradizionale con prodotti locali e di stagione. Formule con piatto del giorno, menu o à la carte. Ampia scelta di birre. Menu di gelati."
    ],
    "fr": [
      "Grande terrasse ombragée avec espace bar et espace restaurant. Cuisine traditionnelle, produits locaux et de saison. Formules avec plat du jour, menu ou à la carte. Grand choix de bières. Carte coupes glacées."
    ],
    "es": [
      "Amplia terraza sombreada con bar y zona de restaurante. Cocina tradicional con productos locales de temporada. Fórmulas con plato del día, menú o a la carta. Amplia carta de cervezas. Carta de helados."
    ],
    "nl": [
      "7 dagen per week geopend, 's middags en 's avonds in het zomerseizoen. Groot schaduwrijk terras met een bar en restaurant. Traditionele keuken en lokale producten. Dagschotel, menu of à la carte. Uitgebreide keuze qua salades, huisgemaakte desserts en nog veel meer..."
    ]
  },
