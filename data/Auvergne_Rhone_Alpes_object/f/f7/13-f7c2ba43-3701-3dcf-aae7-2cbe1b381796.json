  "rdfs:comment": {
    "de": [
      "Mel'Evasion befördert Sie in einem Minibus mit 9 Plätzen - Abfahrt vom Tourismusbüro in Dompierre-sur-Besbre.\r\nKurs auf Moulins! Moulins muss man erleben, man kann es nicht überfliegen... (Maison Mantin, Stadtkern, Gourmet-Pause)"
    ],
    "en": [
      "Mel'Evasion transports you in a 9-seater minibus - Departure from Dompierre-sur-Besbre tourist office.\r\nSet course for Moulins! Moulins is something to be experienced, not flown over... (Maison Mantin, town center, gourmet break)"
    ],
    "it": [
      "Mel'Evasion vi trasporta in un minibus a 9 posti - Partenza dall'ufficio del turismo di Dompierre-sur-Besbre.\r\nDirezione Moulins! Moulins va vissuta, non solo sorvolata... (Maison Mantin, centro città, pausa gastronomica)"
    ],
    "fr": [
      "Mel'Evasion vous transporte en mini-bus 9 places - Départ de l'office de tourisme de Dompierre-sur-Besbre.\r\nCap sur Moulins ! Moulins se vit, elle ne se survole pas... (Maison Mantin, coeur de Ville, pause gourmande)"
    ],
    "nl": [
      "Mel'Evasion vervoert je in een minibus met 9 zitplaatsen - Vertrek vanaf het toeristenbureau in Dompierre-sur-Besbre.\r\nOp naar Moulins! Moulins moet je beleven, niet overvliegen... (Maison Mantin, centrum, gastronomisch verblijf)"
    ],
    "es": [
      "Mel'Evasion le transporta en un minibús de 9 plazas - Salida de la oficina de turismo de Dompierre-sur-Besbre.\r\nRumbo a Moulins Moulins es algo que hay que vivir, no sólo sobrevolar... (Casa Mantin, centro de la ciudad, escapada gastronómica)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée - Quand une ville se raconte"
    ]
  },
