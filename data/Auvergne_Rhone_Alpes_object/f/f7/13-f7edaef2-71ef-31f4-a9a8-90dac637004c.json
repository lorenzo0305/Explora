  "rdfs:comment": {
    "de": [
      "Geräumige kontinentale Jurte mit einem Durchmesser von 7 m.\r\nSie ist ideal für Praktika, Workshops und Seminare geeignet (Kapazität: 12 Personen). Hier finden Sie die nötige Gelassenheit, um magische Momente zu erleben und zu teilen."
    ],
    "en": [
      "Spacious continental yurt, 7m in diameter.\r\nIdeal for training courses, workshops and seminars (capacity 12 people), you'll find the serenity you need to experience and share magical moments."
    ],
    "it": [
      "Spaziosa yurta continentale di 7 metri di diametro.\r\nIdeale per corsi, workshop e seminari (capacità 12 persone), troverete la serenità necessaria per godere e condividere momenti magici."
    ],
    "fr": [
      "Yourte continentale spacieuse de 7m de diamètre.\r\nIdéalement prévue pour accueillir vos stages, ateliers et séminaires (capacité 12 personnes), vous y trouverez la sérénité nécessaire pour y vivre et y partager des moments magiques."
    ],
    "nl": [
      "Ruime continentale yurt, 7m in diameter.\r\nIdeaal voor cursussen, workshops en seminars (capaciteit 12 personen), je vindt hier de sereniteit die je nodig hebt om te genieten en magische momenten te delen."
    ],
    "es": [
      "Espaciosa yurta continental de 7 m de diámetro.\r\nIdeal para cursos, talleres y seminarios (capacidad para 12 personas), encontrará la serenidad necesaria para disfrutar y compartir momentos mágicos."
    ]
  },
  "rdfs:label": {
    "fr": [
