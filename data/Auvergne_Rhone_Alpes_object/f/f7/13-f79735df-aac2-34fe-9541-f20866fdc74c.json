  "rdfs:comment": {
    "de": [
      "Crescendo ist eine Restaurantkette, die mit frischen und saisonalen Produkten kocht: Gegrilltes, Fisch, Crêpes, Pizza und vor Ort hergestellte Backwaren werden angeboten."
    ],
    "en": [
      "Crescendo is a restaurant chain cooking with fresh, seasonal produce: grilled meats, fish, crêpes, pizzas and pastries made on site."
    ],
    "it": [
      "Crescendo è una catena di ristoranti che cucina con prodotti freschi e di stagione: carni alla griglia, pesce, crêpes, pizze e dolci fatti in loco."
    ],
    "fr": [
      "Crescendo est une chaîne de restauration cuisinant à partir de produits frais et de saison : grillades, poissons, crêpes, pizzas et pâtisserie faites sur place vous sont proposés."
    ],
    "nl": [
      "Crescendo is een restaurantketen die kookt met verse, seizoensgebonden producten: gegrild vlees, vis, crêpes, pizza's en gebak dat ter plekke wordt gemaakt."
    ],
    "es": [
      "Crescendo es una cadena de restaurantes que cocina con productos frescos de temporada: carnes a la parrilla, pescados, crepes, pizzas y pasteles elaborados en el propio local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cafétéria Crescendo"
    ]
  },
