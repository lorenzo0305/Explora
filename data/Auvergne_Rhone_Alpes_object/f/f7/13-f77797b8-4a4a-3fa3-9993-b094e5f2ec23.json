  "rdfs:comment": {
    "de": [
      "Jahrhundert erbaut wurde und in dem die alte Ölmühle untergebracht war, die heute auf einem der Dorfplätze zu sehen ist."
    ],
    "en": [
      "Welcome to this beautiful building steeped in history, built in the 19th century to house the old oil mill, now visible in one of the village squares."
    ],
    "it": [
      "Benvenuti in questo splendido edificio ricco di storia, costruito nel XIX secolo per ospitare il vecchio frantoio, oggi visibile in una delle piazze del paese."
    ],
    "fr": [
      "Soyez les bienvenus dans cette belle bâtisse chargée d'histoire, construite au XIXe, et qui abritait l'ancien moulin à huile, visible aujourd'hui sur une des places du village."
    ],
    "nl": [
      "Welkom in dit prachtige gebouw met een rijke geschiedenis, gebouwd in de 19e eeuw om de oude oliemolen te huisvesten, nu zichtbaar op een van de dorpspleinen."
    ],
    "es": [
      "Bienvenido a este hermoso edificio cargado de historia, construido en el siglo XIX para albergar el antiguo molino de aceite, hoy visible en una de las plazas del pueblo."
    ]
  },
