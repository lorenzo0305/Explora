  "rdfs:comment": {
    "de": [
      "Die Stadtverwaltung von Le Brethon bietet einen innovativen Service in ländlichen Gebieten an, indem sie automatische Schließfächer für den Kauf lokaler Produkte aufstellt."
    ],
    "en": [
      "Le Brethon town council is offering an innovative service in a rural area, by setting up automatic lockers for the purchase of local produce."
    ],
    "it": [
      "Il comune di Le Brethon offre un servizio innovativo in una zona rurale, istituendo armadietti automatici per l'acquisto di prodotti locali."
    ],
    "fr": [
      "La mairie du Brethon propose un service innovant en zone rurale, en mettant en place des casiers automatiques pour l’achat de produits locaux."
    ],
    "nl": [
      "Het gemeentebestuur van Le Brethon biedt een innovatieve dienst aan in een landelijk gebied door automatische kluizen in te richten voor het kopen van lokale producten."
    ],
    "es": [
      "El ayuntamiento de Le Brethon ofrece un servicio innovador en una zona rural, instalando taquillas automáticas para la compra de productos locales."
    ]
  },
  "rdfs:label": {
