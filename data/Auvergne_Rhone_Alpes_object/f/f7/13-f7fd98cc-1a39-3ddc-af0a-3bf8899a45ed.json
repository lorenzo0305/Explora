  "rdfs:comment": {
    "de": [
      "Originell und praktisch: Das Herz des Dorfes ist den ganzen Tag über mit dem kleinen Zug von Bernex mit den Füßen der Pisten verbunden, ein Erlebnis für Urlauber ganz allein."
    ],
    "en": [
      "Original and practical, the heart of the village is linked to the foot of the slopes all day long by the Bernex little train, an experience in itself for holidaymakers."
    ],
    "it": [
      "Originale e pratico, il cuore del villaggio è collegato ai piedi delle piste tutto il giorno dal trenino Bernex, un'esperienza in sé per i vacanzieri."
    ],
    "fr": [
      "Original et pratique, le cœur du village est relié aux pieds des pistes toute la journée par le petit train de Bernex, une expérience à lui tout seul pour les vacanciers."
    ],
    "nl": [
      "Origineel en praktisch, het hart van het dorp is de hele dag verbonden met de voet van de pistes door het treintje van Bernex, een ervaring op zich voor vakantiegangers."
    ],
    "es": [
      "Original y práctico, el corazón del pueblo está unido a pie de pistas durante todo el día por el trenecito Bernex, toda una experiencia para los veraneantes."
    ]
  },
  "rdfs:label": {
    "en": [
