  "rdfs:comment": {
    "de": [
      "Das Chalet der ESF befindet sich am oberen Ende der Avenue des J.O. in der Nähe der Skifahrerbrücke und des Espace Erwin Eckl. 2 Treffpunkte für Skikurse (1 vor Ort und 1 im Espace Erwin Eckl). Dies ist am einfachsten, wenn Sie im oberen Teil des Skigebiets wohnen."
    ],
    "en": [
      "The Chalet de l'ESF is located at the top of Avenue des J.O. near the skier bridge and Espace Erwin Eckl. 2 points of ski lessons (1 on the spot and 1 on the Espace Erwin Eckl). It's the simplest if you stay in the upper part of the resort."
    ],
    "it": [
      "Lo chalet ESF si trova in cima a avenue des J.O. vicino al ponte di sci e all'Espace Erwin Eckl. 2 punti di incontro di lezioni di sci (1 in loco e 1 presso Espace Erwin Eckl). È il più semplice se rimani nella parte superiore della stazione."
    ],
    "fr": [
      "Le Chalet de l’ESF se situe en haut de l'avenue des J.O. à proximité du pont skieur et de l’Espace Erwin Eckl. 2 points de rdv cours de ski (1 sur place et 1 sur l'Espace Erwin Eckl). C'est le plus simple si vous logez dans la partie haute de la station."
    ],
    "nl": [
      "Het Chalet de l'ESF bevindt zich op de top van de Avenue des J.O. nabij de skiërbrug en Espace Erwin Eckl. 2 punten skiles (1 ter plaatse en 1 op de Espace Erwin Eckl). Het is de eenvoudigste als je in het bovenste deel van het resort verblijft."
    ],
    "es": [
      "El Chalet ESF está situado en la parte superior de la avenida des J.O., cerca del puente de los esquiadores y del Espace Erwin Eckl. Hay 2 puntos de encuentro para las clases de esquí (1 en el lugar y 1 en el Espace Erwin Eckl). Esto es lo más fácil si te alojas en la parte superior del complejo."
    ]
  },
