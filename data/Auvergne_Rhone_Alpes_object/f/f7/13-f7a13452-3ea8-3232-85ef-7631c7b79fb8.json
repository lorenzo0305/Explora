  "rdfs:comment": {
    "de": [
      "Die Kirche romanischen Ursprungs liegt auf dem Gipfel des alten Dorfes auf einer befestigten Esplanade, von der aus man einen herrlichen Ausblick hat. Der Innenraum ist vollständig bemalt und beherbergt mehrere romanische Kapitelle und zahlreiche geschützte Objekte."
    ],
    "en": [
      "The original Romanesque church, perched at the top of the old village, stands on a fortified esplanade offering magnificent views. The interior, entirely painted, features several Romanesque capitals and numerous protected objects."
    ],
    "it": [
      "L'originale chiesa romanica, arroccata in cima al vecchio villaggio, si trova su una spianata fortificata che offre una magnifica vista. L'interno, interamente dipinto, contiene diversi capitelli romanici e una serie di oggetti protetti."
    ],
    "fr": [
      "L'église d'origine romane, perchée au sommet du village ancien, s'élève sur une esplanade fortifiée qui offre des points de vue magnifiques. L'intérieur, entièrement peint, conserve plusieurs chapiteaux romans et de nombreux objets protégés."
    ],
    "es": [
      "La iglesia románica original, situada en lo alto del antiguo pueblo, se alza sobre una explanada fortificada que ofrece magníficas vistas. El interior, totalmente pintado, alberga varios capiteles románicos y varios objetos protegidos."
    ],
    "nl": [
      "De oorspronkelijke Romaanse kerk, gelegen op de top van het oude dorp, staat op een versterkte esplanade die een prachtig uitzicht biedt. Het interieur, dat volledig beschilderd is, bevat verschillende Romaanse kapitelen en een aantal beschermde objecten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Blaise"
    ]
  },
