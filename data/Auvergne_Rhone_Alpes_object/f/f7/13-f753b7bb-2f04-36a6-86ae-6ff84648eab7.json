  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit Spezialitäten wie Froschschenkel, Kalbsbries, Kalbskopf und Ochsenzunge (jeden Dienstag), frittierte Forelle (Mai bis August)."
    ],
    "en": [
      "If you feel like trying out some French specialties: frogs’ legs, calf head, beef tongue, veal sweetbread with morel sauce, wait no longer and drop in at the Comptoir LSG. We will be delighted to welcome you to our establishment for an enjoyable meal. You will find traditional cuisine and a friendly atmosphere!"
    ],
    "it": [
      "Ristorante tradizionale specializzato in cosce di rana, animelle, testa di vitello e lingua di bue (ogni martedì), trota fritta (da maggio ad agosto)."
    ],
    "fr": [
      "Restaurant traditionnel avec spécialités cuisses de grenouilles, ris de veau, tête de veau et langue de boeuf (tous les mardis), friture de truitelle (mai à aout)."
    ],
    "nl": [
      "Traditioneel restaurant gespecialiseerd in kikkerbilletjes, zwezerik, kalfskop en ossentong (elke dinsdag), gebakken forel (mei tot augustus)."
    ],
    "es": [
      "Restaurante tradicional especializado en ancas de rana, mollejas, cabeza de ternera y lengua de buey (todos los martes), trucha frita (de mayo a agosto)."
    ]
  },
