  "rdfs:comment": {
    "de": [
      "Der Naturclub Pic & Pêche empfängt Kinder und Jugendliche das ganze Jahr über zu Naturausflügen, Exkursionen in den Wald und Spielen im Freien!!!"
    ],
    "en": [
      "The Pic & Pêche nature club welcomes children and teenagers all year round for nature outings, forest excursions and outdoor games!"
    ],
    "it": [
      "Il club naturalistico Pic & Pêche accoglie tutto l'anno bambini e ragazzi per gite nella natura, escursioni nella foresta e giochi all'aperto!"
    ],
    "fr": [
      "Le club nature Pic & Pêche accueille enfants et adolescents tout au long de l'année pour des sorties nature, excursions en forêt et jeux en plein air !!"
    ],
    "es": [
      "El club de naturaleza Pic & Pêche acoge a niños y adolescentes durante todo el año para realizar salidas a la naturaleza, excursiones por el bosque y juegos al aire libre"
    ],
    "nl": [
      "De Pic & Pêche natuurclub verwelkomt kinderen en tieners het hele jaar door voor natuurexcursies, bosuitstapjes en buitenspelletjes!"
