  "rdfs:comment": {
    "de": [
      "Käse, Rapsöl, Eier, Hacksteaks, Geflügel, Lamm-, Kalb- und Schweinekiste.\r\nProduktion auf dem Bauernhof: Milchviehbetrieb, Mastkälber, Schweine, Ziegen, Schafe und der gesamte Hinterhof."
    ],
    "en": [
      "Cheeses, rapese oil, eggs, minced steaks, poultry, boxed lamb, veal and pork.\r\nFarm products: Dairy farm, veal calves, pigs, goats, sheep and the whole farmyard."
    ],
    "it": [
      "Formaggi, olio di colza, uova, bistecche macinate, pollame, agnello, vitello e scatole di maiale.\r\nProdotti dell'azienda agricola: caseificio, vitelli, maiali, capre, pecore e tutta l'aia."
    ],
    "fr": [
      "Fromages, huile de colza, oeufs, steaks hachés, volailles, caissette agneau, veau et porc.\r\nProductions de la ferme : Ferme laitière, veaux de boucherie, porcs, chèvres, moutons et toute la basse-cour."
    ],
    "es": [
      "Quesos, aceite de colza, huevos, carne picada, aves, cordero, ternera y cajas de cerdo.\r\nProductos de granja: Lechería, terneros, cerdos, cabras, ovejas y todo el corral."
    ],
    "nl": [
      "Kaas, raapzaadolie, eieren, gehakt, gevogelte, lams-, kalfs- en varkensboxen.\r\nBoerderijproducten: Melkveebedrijf, vleeskalveren, varkens, geiten, schapen en het hele erf."
    ]
  },
