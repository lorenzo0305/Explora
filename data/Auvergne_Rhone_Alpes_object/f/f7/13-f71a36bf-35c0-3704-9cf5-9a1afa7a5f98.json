  "rdfs:comment": {
    "de": [
      "Die Fidèles et Amis de Notre-Dame de Pradelles öffnen Ihnen die Türen der Kapelle Notre-Dame täglich von 16:00 bis 18:00 Uhr.\r\n\r\nMusikalische Termine in der Kapelle im August :\r\n06/08 Das Duo Ziriab um 20:30 Uhr und am 23/08 La clef des Champs um 18 Uhr."
    ],
    "en": [
      "The Faithful and Friends of Notre-Dame de Pradelles open the doors of the Chapelle Notre-Dame every day from 4pm to 6pm.\r\n\r\nMusical Rendez-vous at the Chapel in August :\r\n06/08 Le Duo Ziriab at 8.30pm and 23/08 La clef des Champs at 6pm."
    ],
    "it": [
      "I fedeli e gli amici di Notre-Dame de Pradelles aprono le porte della Cappella di Notre-Dame tutti i giorni dalle 16.00 alle 18.00.\r\n\r\nEventi musicali alla Cappella in agosto:\r\n06/08 Le Duo Ziriab alle 20.30 e 23/08 La clef des Champs alle 18.00."
    ],
    "fr": [
      "Les Fidèles et Amis de Notre-Dame de Pradelles vous ouvrent les portes de la Chapelle Notre-Dame tous les jours de 16h à 18h.\r\n\r\nLes Rendez-vous Musicaux de la Chapelle en août : \r\n06/08 Le Duo Ziriab à 20h30 et le 23/08 La clef des Champs à 18h."
    ],
    "es": [
      "Los Fieles y Amigos de Notre-Dame de Pradelles abren las puertas de la Chapelle Notre-Dame todos los días de 16:00 a 18:00 horas.\r\n\r\nEventos musicales en la Capilla en agosto :\r\n06/08 Le Duo Ziriab a las 20.30 h y 23/08 La clef des Champs a las 18.00 h."
    ],
    "nl": [
      "De gelovigen en vrienden van Notre-Dame de Pradelles openen de deuren van de Chapelle Notre-Dame elke dag van 16u tot 18u.\r\n\r\nMuzikale evenementen in de kapel in augustus :\r\n06/08 Le Duo Ziriab om 20u30 en 23/08 La clef des Champs om 18u00."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Portes ouvertes de la Chapelle Notre-Dame | Pradelles"
    ]
  },
