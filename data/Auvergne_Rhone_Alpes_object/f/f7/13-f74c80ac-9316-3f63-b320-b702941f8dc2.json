  "rdfs:comment": {
    "de": [
      "Im Quai Numéro Vin finden Sie einen Weinkeller und eine Weinbar an ein und demselben Ort! Hier können Sie eine Auswahl an Weinen im Glas sowie eine große Auswahl an Flaschen probieren und dazu eine Wurst- und Käseplatte genießen."
    ],
    "en": [
      "At Quai Numéro Vin you'll find a wine cellar and a wine bar all in one! Enjoy a selection of wines by the glass, as well as a wide choice of bottles, accompanied by a platter of charcuterie and cheeses."
    ],
    "it": [
      "Al Quai Numéro Vin troverete una cantina e un'enoteca in un unico locale! Potrete gustare una selezione di vini al bicchiere e un'ampia scelta di bottiglie, accompagnate da un piatto di salumi e formaggi."
    ],
    "fr": [
      "Au Quai Numéro Vin vous trouverez une cave et un bar à vin en un seul et même lieu ! Vous pourrez déguster une sélection de vins au verre ainsi qu'un large choix de bouteilles et accompagné d'une planche de charcuteries et de fromages."
    ],
    "es": [
      "En Quai Numéro Vin encontrará una bodega y un bar de vinos, ¡todo en uno! Podrá degustar una selección de vinos por copas y una amplia selección de botellas, acompañados de una tabla de embutidos y quesos."
    ],
    "nl": [
      "Bij Quai Numéro Vin vind je een wijnkelder en een wijnbar in één! Je kunt genieten van een selectie wijnen per glas en een ruime keuze aan flessen, vergezeld van een schotel vleeswaren en kazen."
    ]
  },
