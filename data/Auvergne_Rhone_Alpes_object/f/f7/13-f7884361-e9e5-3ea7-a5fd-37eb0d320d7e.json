  "rdfs:comment": {
    "de": [
      "Eine sehr große Panoramaterrasse bietet einen direkten Blick auf die Skipisten von Belle Plagne.\r\nDie Terrasse ist sowohl im Winter als auch im Sommer zugänglich (Fußgänger oder Skifahrer)."
    ],
    "en": [
      "A very large terrace with panoramic views overlooking the ski slopes in Belle Plagne. The terrace is open for skiers and pedestrians in both winter and summer."
    ],
    "it": [
      "Un'ampia terrazza panoramica si affaccia sulle piste da sci di Belle Plagne.\r\nLa terrazza è accessibile in inverno e in estate (pedoni o sciatori)"
    ],
    "fr": [
      "Une très grande terrasse panoramique donne directement sur les pistes de ski de Belle Plagne.\r\nLa terrasse est accessible en hiver comme en été (piétons ou skieurs)"
    ],
    "es": [
      "Una gran terraza panorámica con vistas a las pistas de esquí de Belle Plagne.\r\nLa terraza es accesible en invierno y en verano (peatones o esquiadores)"
    ],
    "nl": [
      "Het grote panoramische terras kijkt uit op de skipistes van Belle Plagne. Het terras is zowel 's winters als 's zomers toegankelijk (voor voetgangers en skiërs)."
    ]
  },
