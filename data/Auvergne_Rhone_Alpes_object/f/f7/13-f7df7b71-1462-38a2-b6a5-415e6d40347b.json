  "rdfs:comment": {
    "de": [
      "Die Menüs im L'Incontournable bieten die Gelegenheit, eine traditionelle Küche mit frischen und lokalen Produkten in einem atypischen und gemütlichen Rahmen zu entdecken."
    ],
    "en": [
      "Take a dose of vintage, add it a strand of modern insanity and you will obtain an unmissable thing.  The menus of this restaurant are an opportunity to discover a tradition al food made with fresh and local products, in a warm and  unusual setting."
    ],
    "it": [
      "I menu de l'Incontournable sono un'occasione per scoprire la cucina tradizionale con prodotti freschi locali in un ambiente caldo e insolito."
    ],
    "fr": [
      "Les menus de l'Incontournable sont l'occasion de découvrir une cuisine de tradition avec des produits frais et locaux dans un cadre atypique et chaleureux."
    ],
    "es": [
      "Los menús de l'Incontournable son una oportunidad para descubrir la cocina tradicional con productos frescos de la tierra en un marco cálido e insólito."
    ],
    "nl": [
      "De menu's bij l'Incontournable zijn een gelegenheid om de traditionele keuken te ontdekken met verse lokale producten in een warme en ongewone omgeving."
    ]
  },
  "rdfs:label": {
