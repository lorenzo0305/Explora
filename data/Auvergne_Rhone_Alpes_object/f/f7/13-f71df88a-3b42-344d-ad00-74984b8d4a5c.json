  "rdfs:comment": {
    "de": [
      "Das Château des Anges, eine ehemalige königliche Zisterzienserabtei aus dem 14. Jahrhundert, empfängt Sie in einer außergewöhnlichen Umgebung und bietet Ihnen zwei Ferienhäuser sowie 3 Gästezimmer.\r\n\r\nVermietung von Räumen und Unterkünften für Empfänge, Hochzeiten, Seminare..."
    ],
    "en": [
      "Former Royal Cistercian Abbey of the 14th century, the Château des Anges welcomes you in an exceptional setting and offers you two cottages and 3 guest rooms.\r\n\r\nRental of rooms and accommodation for receptions, weddings, seminars..."
    ],
    "it": [
      "Antica Abbazia Reale Cistercense del XIV secolo, il Castello degli Angeli vi accoglie in un ambiente eccezionale e vi offre due alloggi e 3 camere per gli ospiti.\r\n\r\nAffitto di sale e alloggi per ricevimenti, matrimoni, seminari..."
    ],
    "fr": [
      "Ancienne Abbaye Royale Cistercienne du 14ème siècle, le Château des Anges vous accueille dans un cadre exceptionnel et vous propose deux gîtes ainsi que 3 chambres d'hôtes.\r\nLocation de salles et hébergements pour réceptions, mariages, séminaires..."
    ],
    "nl": [
      "Château des Anges, een voormalige koninklijke cisterciënzer abdij uit de 14e eeuw, verwelkomt u in een uitzonderlijke omgeving en biedt u twee gîtes en 3 chambres d'hôtes.\r\n\r\nVerhuur van zalen en accommodaties voor recepties, bruiloften, seminars..."
    ],
    "es": [
      "Antigua abadía real cisterciense del siglo XIV, el Château des Anges le acoge en un marco excepcional y le ofrece dos casas rurales y 3 habitaciones de huéspedes.\r\nAlquiler de salas y alojamientos para recepciones, bodas, seminarios, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Château des Anges"
    ]
  },
