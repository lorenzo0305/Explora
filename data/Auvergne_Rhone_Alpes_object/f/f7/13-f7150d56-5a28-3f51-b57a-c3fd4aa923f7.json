  "rdfs:comment": {
    "de": [
      "Im Herzen der kleinen Toskana der Auvergne produziert und verarbeitet unser Familienbauernhof den von unseren Bienen in der Region Puy de Dôme gesammelten Honig. Shop und Verkostung: Honig, Pollen, Lebkuchen, Nougat?"
    ],
    "en": [
      "In the heart of little Tuscany in Auvergne, our family farm produces and processes the honey collected by our bees in the Puy de Dôme. Shop and tasting: honey, pollen, gingerbread, nougat ..."
    ],
    "it": [
      "Nel cuore della piccola Toscana d'Alvernia, la nostra azienda agricola familiare produce e trasforma i mieli raccolti dalle nostre api nel Puy de Dôme. Negozio e degustazione: mieli, polline, panpepato, torroni?"
    ],
    "fr": [
      "Au cœur de la petite Toscane auvergnate, notre ferme familiale produit et transforme les miels récoltés par nos abeilles dans le Puy de Dôme. Boutique et dégustation : miels, pollen, pains d’épices, nougats …"
    ],
    "nl": [
      "In het hart van het kleine Toscane van de Auvergne produceert en verwerkt onze familieboerderij de honing die door onze bijen in de Puy de Dôme wordt geoogst. Winkel en proeven: honing, stuifmeel, peperkoek, noga?"
    ],
    "es": [
      "En el corazón de la pequeña Toscana de Auvernia, nuestra granja familiar produce y transforma las mieles recolectadas por nuestras abejas en el Puy de Dôme. Tienda y degustación: mieles, polen, pan de especias, turrones.."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les ruchers du bon berger"
    ],
