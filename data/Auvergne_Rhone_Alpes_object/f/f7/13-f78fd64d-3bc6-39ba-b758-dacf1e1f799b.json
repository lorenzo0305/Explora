  "rdfs:comment": {
    "de": [
      "Aix et terra ist die Manuifacktur für Aperitif rezepte und marmelade. Entdecken auch die Restaurant und Lebensmittelgeschäft für Feinschmecker in der Manufaktur."
    ],
    "en": [
      "Aix & terra is a Provence Workshop which creates and produces ultimate gourmet recipes, organic or truffle recipes and jams. In the workshop you will fin a nice restauran and fine grocery shop which serves menus made with the products of the workshop."
    ],
    "it": [
      "Aix&terra, una fabbrica provenzale, produce ricette artigianali e locali: creme spalmabili biologiche e al tartufo, mostarde, oli, aceti, marmellate... All'interno del laboratorio si trova un grazioso ristorante."
    ],
    "fr": [
      "Aix&terra, manufacture provençale, confectionne des recettes artisanales et locales : tartinades, produits à base de truffe, moutardes, huiles bio, vinaigres, confitures bio... Au sein de l'atelier de fabrication, vous trouverez un joli restaurant."
    ],
    "es": [
      "Aix&terra, una fábrica provenzal, elabora recetas artesanales y locales: cremas para untar, productos a base de trufa, mostazas, aceites ecológicos, vinagres, mermeladas ecológicas... Dentro del taller, encontrará un agradable restaurante."
    ],
    "nl": [
      "Aix&terra, een Provençaalse fabriek, maakt ambachtelijke en lokale recepten: smeersels, producten op basis van truffels, mosterd, biologische oliën, azijnen, biologische jam, enz. Er is ook een heerlijk restaurant in het atelier."
    ]
  },
