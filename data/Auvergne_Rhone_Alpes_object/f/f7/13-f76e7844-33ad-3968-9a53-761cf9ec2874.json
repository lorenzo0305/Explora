  "rdfs:comment": {
    "de": [
      "In grüner Naturlage am Seeufer empfängt Sie unser 3-Sterne Hotel 2 km von der Altstadt von Annecy entfernt zu einem unvergesslichen Aufenthalt."
    ],
    "en": [
      "Our 3* hotel in a lush lakeside setting located 2km from Annecy old town would love to welcome you for an unforgettable break."
    ],
    "it": [
      "In una cornice verde e lungo il lago, il nostro hotel 3* situato a 2 km dal centro storico di Annecy, vi accoglie per un soggiorno indimenticabile."
    ],
    "fr": [
      "Dans un cadre verdoyant et au bord du lac, notre hôtel The Originals Relais situé à 3km de la vieille ville d'Annecy, vous accueille pour un séjour inoubliable."
    ],
    "nl": [
      "Ons hotel 3* ligt een groene omgeving en aan de oever van het meer, op 2km van de oude stad van Annecy, voor een onvergetelijk verblijf."
    ],
    "es": [
      "En un entorno verde junto al lago, nuestro hotel The Originals Relais, situado a 3 km del casco antiguo de Annecy, le da la bienvenida para una estancia inolvidable."
    ]
  },
