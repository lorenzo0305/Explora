  "rdfs:comment": {
    "de": [
      "Die Strecke zwischen Saint-Victor und Cours (Rhône) führte über dieses 150 Meter lange und 18 Meter hohe Viadukt mit 9 Bögen über die Rhins."
    ],
    "en": [
      "The line between Saint-Victor and Cours (Rhône) used this 9-arch, 150-meter-long, 18-meter-high viaduct to cross the Rhins."
    ],
    "it": [
      "La linea che collegava Saint-Victor a Cours (Rodano) utilizzava questo viadotto a 9 arcate, lungo 150 metri e alto 18, per attraversare il Reno."
    ],
    "fr": [
      "La ligne reliant Saint-Victor à Cours (Rhône),  empruntait ce viaduc de 9 arches, long de 150 mètres et haut de 18 mètres, permettant de franchir le Rhins."
    ],
    "es": [
      "La línea que unía Saint-Victor con Cours (Rhône) utilizaba este viaducto de 9 arcos, de 150 metros de longitud y 18 metros de altura, para cruzar el Rhin."
    ],
    "nl": [
      "De lijn die Saint-Victor met Cours (Rhône) verbond, gebruikte dit viaduct met 9 bogen, 150 meter lang en 18 meter hoog, om de Rhins over te steken."
    ]
  },
  "rdfs:label": {
