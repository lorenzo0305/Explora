  "rdfs:comment": {
    "de": [
      "Am Volan-Pfad gelegen, am Anfang des Dorfes Malleval, Weinproduzent (AOP Condrieu, AOP St Joseph rot und weiß und Landweine) In Zertifizierung HVE Haute valeur environnementale. Obstproduzent und Verkauf von Fruchtsäften."
    ],
    "en": [
      "Located on the Volan trail, at the start of the village of Malleval, produce wines (AOP Condrieu, AOP St Joseph red and white and local wines). HVE High Environmental Value certification. Fruit producer and sale of fruit juice."
    ],
    "it": [
      "Situato sul sentiero del Volan, appena fuori dal villaggio di Malleval, produttore di vino (AOP Condrieu, AOP St Joseph rosso e bianco e vins de pays) con certificazione HVE High Environmental Value. Produttore di frutta e venditore di succhi di frutta."
    ],
    "fr": [
      "Situé sur le sentier de Volan, au départ du village de Malleval, producteur de vins (AOP Condrieu, AOP St Joseph rouge et blanc et vins de pays) En certification HVE Haute valeur environnementale. Producteur de fruits et vente de jus de fruits."
    ],
    "es": [
      "Situado en la senda del Volan, a las afueras del pueblo de Malleval, productor de vino (AOP Condrieu, AOP St Joseph tinto y blanco y vins de pays) con certificación HVE Alto Valor Medioambiental. Productor de fruta y vendedor de zumos de fruta."
    ],
    "nl": [
      "Gelegen aan het Volan pad, net buiten het dorp Malleval, wijnproducent (AOP Condrieu, AOP St Joseph rood en wit en vins de pays) met HVE High Environmental Value certificering. Fruitproducent en verkoper van vruchtensap."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wine cellar Verrier"
    ],
