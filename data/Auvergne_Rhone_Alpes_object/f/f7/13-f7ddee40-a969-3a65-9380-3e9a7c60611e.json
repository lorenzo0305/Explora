  "rdfs:comment": {
    "de": [
      "ie Bibliothek beherbergt eine Grainothèque: eine lokale Aktion, die von der Vereinigung \"Graines De Troc\" erdacht wurde, die sich für den Schutz der kultivierten Biodiversität einsetzt."
    ],
    "en": [
      "he Library is hosting a Grainothèque: a local initiative devised by the \"Graines De Troc\" association, which works to protect cultivated biodiversity."
    ],
    "it": [
      "a Biblioteca ospita una Biblioteca del Grano: un'azione locale immaginata dall'associazione \"Graines De Troc\" che agisce per la difesa della biodiversità coltivata."
    ],
    "fr": [
      "a Bibliothèque accueille une Grainothèque : une action locale imaginée par l’association “Graines De Troc ” qui agit pour la défense de la biodiversité cultivée."
    ],
    "nl": [
      "e Bibliotheek organiseert een Grainotheek: een lokaal initiatief bedacht door de vereniging \"Graines De Troc\", die zich inzet voor de bescherming van de gecultiveerde biodiversiteit."
    ],
    "es": [
      "a Biblioteca acoge una Grainoteca: una acción local imaginada por la asociación \"Graines De Troc\" que actúa en defensa de la biodiversidad cultivada."
    ]
  },
