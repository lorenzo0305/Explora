  "rdfs:comment": {
    "de": [
      "Das Restaurant le Chalet de la Source ist ein charmantes Haus, das mittags und abends ein Buffet mit Vorspeise, einem oder zwei Hauptgerichten und Dessert anbietet. Es verfügt über einen Speisesaal mit 60 Plätzen und eine Terrasse mit 30 Plätzen und Blick auf die Allier-Schlucht."
    ],
    "en": [
      "The Chalet de la Source restaurant is a charming dwelling offering a buffet lunch & dinner with starter/1 or 2 courses/dessert, in a 60-cover dining room and 30-cover terrace overlooking the Allier Gorges."
    ],
    "it": [
      "Il ristorante Chalet de la Source è una residenza di charme che offre un pranzo e una cena a buffet con antipasto, 1 o 2 piatti unici e dessert, in una sala da 60 coperti e una terrazza da 30 coperti con vista sulle Gorges de l'Allier."
    ],
    "fr": [
      "Le restaurant le Chalet de la Source est une demeure de charme proposant un buffet les midis & soirs avec entrée /1 ou 2 plat unique/dessert, dans une salle à manger de 60 couvert et terrasse de 30 couverts avec vue sur les Gorges de l'Allier."
    ],
    "nl": [
      "Het restaurant Chalet de la Source is een charmant verblijf dat een lunch- en dinerbuffet biedt met voorgerecht, 1 of 2 enkele gangen en dessert, in een eetzaal met 60 couverts en een terras met 30 couverts met uitzicht op de Gorges de l'Allier."
    ],
    "es": [
      "El restaurante del Chalet de la Source es una residencia con encanto que ofrece un almuerzo y una cena buffet con entrante, 1 o 2 platos únicos y postre, en un comedor con 60 cubiertos y una terraza de 30 cubiertos con vistas a las Gorges de l'Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chalet de la Source | Restaurant"
    ]
  },
