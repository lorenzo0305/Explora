  "rdfs:comment": {
    "de": [
      "Die Gemeinde Rochegude verfügt über eine Ladestation, an der zwei Elektrofahrzeuge gleichzeitig aufgeladen werden können: 2 Plätze sind ausschließlich für diese Nutzung des elektrischen Aufladens reserviert."
    ],
    "en": [
      "The commune of Rochegude has a charging station for simultaneous recharging of 2 electric vehicles: 2 spaces are reserved for this purpose only."
    ],
    "it": [
      "Il comune di Rochegude dispone di un punto di ricarica per la ricarica simultanea di due veicoli elettrici: due spazi sono riservati esclusivamente a questo scopo."
    ],
    "fr": [
      "La commune de Rochegude dispose d'une borne pour recharger en simultané 2 véhicules électriques : 2 places sont réservées à cet usage de recharge électrique uniquement."
    ],
    "es": [
      "El municipio de Rochegude dispone de un punto de recarga para la recarga simultánea de dos vehículos eléctricos: se reservan dos plazas para este fin."
    ],
    "nl": [
      "De gemeente Rochegude heeft een oplaadpunt voor het gelijktijdig opladen van 2 elektrische voertuigen: hiervoor zijn 2 plaatsen gereserveerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "eborn - borne de recharge pour véhicule électrique"
    ]
  },
