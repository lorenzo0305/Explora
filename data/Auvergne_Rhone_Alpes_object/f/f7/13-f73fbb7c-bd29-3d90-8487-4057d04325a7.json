  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Enduro Carpe in Moulins teil, einem Muss für leidenschaftliche Angler! Reservierung, Angelkarte erforderlich. Lassen Sie sich diese sportliche Herausforderung nicht entgehen!"
    ],
    "en": [
      "Take part in the Enduro Carpe in Moulins, a must for fishing enthusiasts! Reservation, fishing card required. Don't miss this sporting challenge!"
    ],
    "it": [
      "Partecipate all'Enduro Carpe a Moulins, un appuntamento imperdibile per tutti gli appassionati di pesca! Prenotazione, licenza di pesca obbligatoria. Non perdetevi questa sfida sportiva!"
    ],
    "fr": [
      "Participez à l'Enduro Carpe à Moulins, un incontournable pour les passionnés de pêche ! Réservation, carte de pêche requise. Ne ratez pas ce défi sportif !"
    ],
    "es": [
      "Participe en el Enduro Carpe en Moulins, ¡una cita ineludible para todos los aficionados a la pesca! Reserva previa, se requiere licencia de pesca. ¡No se pierda este desafío deportivo!"
    ],
    "nl": [
      "Doe mee aan de Enduro Carpe in Moulins, een must voor alle visliefhebbers! Reserveren, visvergunning verplicht. Mis deze sportieve uitdaging niet!"
    ]
  },
  "rdfs:label": {
