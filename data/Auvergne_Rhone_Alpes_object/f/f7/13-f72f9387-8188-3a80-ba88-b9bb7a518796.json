  "rdfs:comment": {
    "de": [
      "Einstündiges Konzert mit traditioneller Musik und künstlerischer Performance mit Laurent Bonneau (Zeichner) und Laurent Cavalié (Musiker): eine Blase der Poesie, in der Musik und Tuschezeichnungen live miteinander verwoben werden. Für jedes Publikum."
    ],
    "en": [
      "For 1 hour, a traditional music concert and artistic performance featuring Laurent Bonneau (cartoonist) and Laurent Cavalié (musician): a poetic bubble where music and Indian ink drawings intertwine live. For all audiences."
    ],
    "it": [
      "Per un'ora, un concerto di musica tradizionale e una performance artistica con Laurent Bonneau (disegnatore) e Laurent Cavalié (musicista): una bolla di poesia in cui musica e disegni a china si intrecciano dal vivo. Per tutte le età."
    ],
    "fr": [
      "Durant 1h, concert de musique traditionnelle et performance artistique  mettant en scène Laurent Bonneau (dessinateur) et Laurent Cavalié (musicien)  : une bulle de poésie où musique et dessins à l'encre de Chine s’entrelacent en direct. Pour tout public."
    ],
    "es": [
      "Durante 1 hora, un concierto de música tradicional y un espectáculo artístico protagonizado por Laurent Bonneau (dibujante) y Laurent Cavalié (músico): una burbuja de poesía donde la música y los dibujos de tinta china se entrelazan en directo. Para todos los públicos."
    ],
    "nl": [
      "1 uur lang een concert met traditionele muziek en een artistieke performance met Laurent Bonneau (striptekenaar) en Laurent Cavalié (muzikant): een poëziebel waarin muziek en Indiase inkttekeningen live in elkaar overlopen. Voor alle leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle BD concert \"A la frontière des géants\""
    ]
  },
