  "rdfs:comment": {
    "de": [
      "Einladendes Bar-Restaurant im Dorf, kreative Gourmetküche, vor Ort oder zum Mitnehmen auf der Grundlage von frischen Produkten. Verfügt über eine angenehme schattige Terrasse mit Bergblick. Froschschenkel auf Vorbestellung. Freitags Pizza-Abend."
    ],
    "en": [
      "Cosy village restaurant serving freshly-cooked dishes on a pleasant, shaded terrace with mountain views."
    ],
    "it": [
      "Accogliente bar-ristorante del villaggio, cucina creativa gourmet, sul posto o da asporto, con prodotti freschi. Piacevole terrazza ombreggiata con vista sulle montagne. Cosce di rana su prenotazione. Serata pizza il venerdì."
    ],
    "fr": [
      "Accueillant Bar Restaurant de village, cuisine gourmande et créative, sur place ou à emporter à base de produits frais. Disposant d'une agréable terrasse ombragée avec vue montagne. Cuisse de Grenouille sur réservation. Les vendredis soirée pizza."
    ],
    "nl": [
      "Gezellig dorpsbar-restaurant, creatieve gastronomische keuken, ter plekke of om mee te nemen, met verse producten. Aangenaam schaduwrijk terras met uitzicht op de bergen. Kikkerbilletjes op reservering. Pizza-avond op vrijdag."
    ],
    "es": [
      "Acogedor bar-restaurante de pueblo, cocina gastronómica creativa, en el mismo local o para llevar, con productos frescos. Agradable terraza sombreada con vistas a la montaña. Ancas de rana disponibles previa reserva. Noche de pizza los viernes."
    ]
  },
