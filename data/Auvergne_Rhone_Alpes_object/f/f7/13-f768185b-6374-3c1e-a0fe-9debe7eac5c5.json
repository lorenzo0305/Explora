  "rdfs:comment": {
    "de": [
      "Dieses gemütliche Hotel genießt den schönsten Blick auf die Mont-Blanc-Kette und verfügt über eine privilegierte Umgebung, die je nach Jahreszeit von grünen oder schneebedeckten Tannen umgeben ist."
    ],
    "en": [
      "This cosy hotel boasts the most beautiful view of the Mont Blanc chain, in a privileged setting surrounded by green or snow-covered fir trees, depending on the season."
    ],
    "it": [
      "Questo accogliente hotel vanta la più bella vista sulla catena del Monte Bianco, in un ambiente privilegiato circondato da abeti verdi o innevati, a seconda della stagione."
    ],
    "fr": [
      "Cet hôtel cosy jouit de la plus belle vue sur la chaîne du Mont-Blanc et dispose d’un cadre privilégié entouré des sapins verdoyants ou enneigés selon les saisons."
    ],
    "es": [
      "Este acogedor hotel goza de la vista más hermosa de la cadena del Mont Blanc, en un entorno privilegiado rodeado de abetos verdes o nevados, según la estación."
    ],
    "nl": [
      "Dit gezellige hotel heeft het mooiste uitzicht op de Mont Blanc-keten en een bevoorrechte omgeving omringd door groene of besneeuwde dennenbomen, afhankelijk van het seizoen."
    ]
  },
