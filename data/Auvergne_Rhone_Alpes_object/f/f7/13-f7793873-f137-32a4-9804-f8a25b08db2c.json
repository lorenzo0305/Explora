  "rdfs:comment": {
    "de": [
      "Genießen Sie ein Wochenende, einen Geschäftsaufenthalt oder einen Familienurlaub im einzigartigen und designorientierten 3-Sterne-Hotel KYRIAD LYON EST - Saint Quentin Fallavier, das ideal gelegen ist, weniger als 15 Minuten vom Flughafen Saint Exupéry entfernt und in der Nähe von Lyon."
    ],
    "en": [
      "For a weekend, a business trip or a family holiday, enjoy the 3-star hotel KYRIAD LYON EST - Saint Quentin Fallavier, unique and design, ideally located less than 15 minutes from Saint Exupéry airport and close to Lyon."
    ],
    "it": [
      "Per un weekend, un viaggio d'affari o una vacanza in famiglia, godetevi l'hotel 3 stelle KYRIAD LYON EST - Saint Quentin Fallavier, unico ed elegante, situato in posizione ideale a meno di 15 minuti dall'aeroporto Saint Exupéry e vicino a Lione."
    ],
    "fr": [
      "Le temps d'un week-end, d'un séjour d'affaires ou de vacances en famille, profitez de l’hôtel 3 étoiles KYRIAD LYON EST - Saint Quentin Fallavier, unique et design, idéalement situé à moins de 15 minutes de l’aéroport Saint Exupéry et à proximité de Lyon."
    ],
    "nl": [
      "Profiteer voor een weekend, een zakenreis of een vakantie met het gezin van het 3-sterrenhotel KYRIAD LYON EST - Saint Quentin Fallavier, uniek en stijlvol, ideaal gelegen op minder dan 15 minuten van de luchthaven Saint Exupéry en dicht bij Lyon."
    ],
    "es": [
      "Para un fin de semana, un viaje de negocios o unas vacaciones en familia, disfrute del hotel de 3 estrellas KYRIAD LYON EST - Saint Quentin Fallavier, único y con estilo, idealmente situado a menos de 15 minutos del aeropuerto de Saint Exupéry y cerca de Lyon."
    ]
  },
