  "rdfs:comment": {
    "de": [
      "Entdecken Sie zahlreiche Baumarten an einem schattigen Standort, der auch für Rollstuhlfahrer zugänglich ist.\r\n\r\nZugang zum Arboretum: In der Kurve in der Mitte des Weilers Masserange (Gemeinde St Sébastien) nehmen Sie den Weg mit der Aufschrift Arboretum."
    ],
    "en": [
      "Come and discover the many species of trees on a shady, wheelchair-accessible site.\r\n\r\nAccess to the Arboretum: around the bend in the road in the center of the hamlet of Masserange (commune of St Sébastien), take the track signposted Arboretum."
    ],
    "it": [
      "Venite a scoprire numerose specie in un sito ombreggiato e accessibile alle persone in sedia a rotelle.\r\n\r\nAccesso all'Arboretum: nella curva al centro della frazione di Masserange (comune di St Sébastien) prendere il sentiero che indica Arboretum."
    ],
    "fr": [
      "Venez découvrir de nombreuses essences sur un site ombragé, accessible aux personnes en fauteuil.\r\n\r\nAccès à l’Arboretum : dans le virage au centre du hameau de Masserange (commune de St Sébastien) prendre la piste indiquant Arboretum."
    ],
    "es": [
      "Venga a descubrir numerosas especies en un lugar sombreado y accesible para los usuarios de sillas de ruedas.\r\n\r\nAcceso al Arboreto: en la curva del centro de la aldea de Masserange (municipio de St Sébastien), tomar la pista que indica Arboreto."
    ],
    "nl": [
      "Kom talrijke soorten ontdekken op een schaduwrijk terrein, toegankelijk voor rolstoelgebruikers.\r\n\r\nToegang tot het Arboretum: neem in de bocht in het centrum van het gehucht Masserange (gemeente St Sébastien) de weg die het Arboretum aangeeft."
    ]
  },
