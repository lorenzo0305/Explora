  "rdfs:comment": {
    "de": [
      "Das Kollektiv HAPP'ART organisiert Ausstellungen verschiedener Künste und vereint 3 Unterschriften: Sabrina Bisard (Malerin), Fernand Greco (Bildhauer und Plastiker) und Jean-François Tixier (Fotograf, Grafiker und Autor)."
    ],
    "en": [
      "The HAPP'ART collective organizes exhibitions of a wide variety of art forms, with 3 members: Sabrina Bisard (painter), Fernand Greco (sculptor and visual artist) and Jean-François Tixier (photographer, graphic artist and author)."
    ],
    "it": [
      "Il collettivo HAPP'ART organizza mostre di un'ampia gamma di arti e ospita 3 artisti: Sabrina Bisard (pittrice), Fernand Greco (scultore e artista visivo) e Jean-François Tixier (fotografo, grafico e autore)."
    ],
    "fr": [
      "Le collectif HAPP'ART organise des expositions d'arts divers et regroupe 3 signatures : Sabrina Bisard (artiste peintre), Fernand Greco (sculpteur et plasticien) et Jean-François Tixier (photographe, graphiste et auteur)."
    ],
    "nl": [
      "Het collectief HAPP'ART organiseert tentoonstellingen van een breed scala aan kunsten en bestaat uit 3 kunstenaars: Sabrina Bisard (schilder), Fernand Greco (beeldhouwer en beeldend kunstenaar) en Jean-François Tixier (fotograaf, grafisch ontwerper en auteur)."
    ],
    "es": [
      "El colectivo HAPP'ART organiza exposiciones de artes diversas y cuenta con 3 artistas: Sabrina Bisard (pintora), Fernand Greco (escultor y artista plástico) y Jean-François Tixier (fotógrafo, diseñador gráfico y escritor)."
    ]
  },
