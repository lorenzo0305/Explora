  "rdfs:comment": {
    "de": [
      "Wenn Sie möchten, können Sie den Online-Katalog konsultieren, in dem Sie aus Tausenden von Dokumenten auswählen können, aber auch im Internet surfen, Musik hören, an Veranstaltungen teilnehmen oder einfach nur Zeit verbringen..."
    ],
    "en": [
      "Consult the online catalogue if you wish, where you can make your choice from thousands of documents, but also surf the internet, listen to music, take part in animations, simply spend some time..."
    ],
    "it": [
      "Consultate il catalogo online, dove potrete scegliere tra migliaia di documenti, ma anche navigare in Internet, ascoltare musica, partecipare ad attività, semplicemente passare un po' di tempo..."
    ],
    "fr": [
      "Consultation du catalogue en ligne si vous le souhaitez, ou vous pourrez faire votre choix parmi des milliers de documents, mais aussi surfer sur internet, écouter de la musique, participer à des animations, passer du temps tout simplement..."
    ],
    "nl": [
      "Raadpleeg desgewenst de online catalogus, waar u kunt kiezen uit duizenden documenten, maar surf ook op internet, luister naar muziek, neem deel aan activiteiten, breng gewoon wat tijd door..."
    ],
    "es": [
      "Consulte el catálogo en línea si lo desea, donde podrá elegir entre miles de documentos, pero también navegar por Internet, escuchar música, participar en actividades, simplemente pasar un rato..."
    ]
  },
