  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Pizzas, Salate und Ravioli-Gratins\r\nIn dem kleinen Weiler Brune entdecken Sie unsere Speisekarte, die von Jezza mit Sorgfalt zusammengestellt wurde. Unsere Pizzen, Salate und Ravioli-Gratins werden aus frischen und lokalen Produkten zubereitet."
    ],
    "en": [
      "Come and discover our pizzas, salads and ravioli gratins\r\nIn the small hamlet of Brune, come and discover our menu, carefully prepared by Jezza. Our pizzas, salads and ravioli gratins are prepared using fresh local produce."
    ],
    "it": [
      "Venite a scoprire le nostre pizze, insalate e ravioli gratinati\r\nNella piccola frazione di Brune, venite a scoprire il nostro menu, preparato con cura da Jezza. Le nostre pizze, insalate e ravioli gratinati sono preparati con prodotti freschi e locali."
    ],
    "fr": [
      "Venez découvrir nos pizzas, salades et gratins de ravioles\r\nAu sein du petit hameau de Brune venez découvrir notre carte élaborée avec soin par Jezza. Nos pizzas, salades, et gratins de ravioles sont préparés à base de produits frais et locaux."
    ],
    "es": [
      "Venga a descubrir nuestras pizzas, ensaladas y raviolis gratinados\r\nEn la pequeña aldea de Brune, venga a descubrir nuestra carta, elaborada con esmero por Jezza. Nuestras pizzas, ensaladas y raviolis gratinados se preparan con productos locales frescos."
    ],
    "nl": [
      "Kom en ontdek onze pizza's, salades en gegratineerde ravioli\r\nKom in het kleine gehucht Brune ons menu ontdekken, met zorg bereid door Jezza. Onze pizza's, salades en ravioli worden bereid met verse streekproducten."
    ]
  },
