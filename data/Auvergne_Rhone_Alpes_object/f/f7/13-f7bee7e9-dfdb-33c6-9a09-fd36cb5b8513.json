  "rdfs:comment": {
    "de": [
      "Produktion und Ernte von aromatischen und medizinischen Pflanzen (Kräutertees, Aromaten, Gemmotherapie, Hydrolat...)\r\nPräsenz auf dem Markt in Vic sur Cère, Direktverkauf zu Hause nach Vereinbarung, Produkte in Geschäften...\r\nBotanische Animationen, Besichtigung von Parzellen"
    ],
    "en": [
      "Production and harvesting of aromatic and medicinal plants (infusions, aromatics, gemmotherapy, hydrolats...)\nPresence at the Vic sur Cère market, direct home sales by appointment, products in stores...\nBotanical events, plot visits"
    ],
    "it": [
      "Produzione e raccolta di piante aromatiche e medicinali (infusi, aromi, gemmoterapia, idrolati, ecc.)\r\nPresenza al mercato di Vic sur Cère, vendita diretta a domicilio su appuntamento, prodotti nei negozi...\r\nEventi botanici, visite agli appezzamenti di terreno"
    ],
    "fr": [
      "Production et cueillette de plantes aromatiques et médicinales ( infusions, aromates, gemmothérapie, hydrolats...)\r\nPrésence sur le marché de Vic sur Cère, vente directe à domicile sur rdv, produits en magasins...\r\nAnimations botaniques, visites de parcelle"
    ],
    "nl": [
      "Productie en oogst van aromatische en geneeskrachtige planten (infusies, aromaten, gemmotherapie, hydrolaten, enz.)\r\nAanwezigheid op de markt van Vic sur Cère, directe verkoop aan huis op afspraak, producten in winkels...\r\nBotanische evenementen, bezoeken aan percelen"
    ],
    "es": [
      "Producción y recolección de plantas aromáticas y medicinales (infusiones, aromáticas, gemoterapia, hidrolatos, etc.)\nPresencia en el mercado de Vic sur Cère, venta directa a domicilio con cita previa, productos en tiendas...\nEventos botánicos, visitas a parcelas"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Cueillettes d'Amélie"
    ]
  },
