  "rdfs:comment": {
    "de": [
      "AXCESS SPORT, IHR SPORTSTUDIO!\r\nMit einer Fläche von 450 m2, freien Gewichten, geführten Maschinen, Kardiogeräten, Cross-Training und Gruppenkursen setzt Axcess Sport alles daran, Sie in Ihren sportlichen Momenten zu begleiten! Schließen Sie sich uns schnell an!"
    ],
    "en": [
      "AXCESS SPORT, YOUR GYM!\r\nWith 450m2 of floor space, free weights, guided machines, cardio equipment, cross-training and group classes, Axcess Sport does everything it can to support you in your sporting endeavors! Join us now!"
    ],
    "it": [
      "AXCESS SPORT, LA VOSTRA PALESTRA!\r\nCon 450 m2 di superficie, pesi liberi, macchine guidate, attrezzature cardio, cross training e corsi di gruppo, Axcess Sport fa di tutto per aiutarvi a praticare le vostre attività sportive! Unisciti a noi ora!"
    ],
    "fr": [
      "AXCESS SPORT, VOTRE SALLE DE SPORT !\r\nAvec ses 450m2 de surface, poids libres, machines guidées, appareils cardio, cross training et de cours collectifs, Axcess Sport met tout en œuvre pour vous accompagner dans vos moments sportifs ! Rejoignez-nous vite !"
    ],
    "es": [
      "AXCESS SPORT, ¡TU GIMNASIO!\r\nCon 450 m2 de superficie, pesas libres, máquinas dirigidas, aparatos cardiovasculares, cross training y clases colectivas, Axcess Sport hace todo lo posible para que disfrute de sus actividades deportivas ¡Únase a nosotros!"
    ],
    "nl": [
      "AXCESS SPORT, JOUW SPORTSCHOOL!\r\nMet 450m2 vloeroppervlak, vrije gewichten, geleide machines, cardioapparatuur, crosstraining en groepslessen, doet Axcess Sport er alles aan om jou te laten genieten van je sportieve activiteiten! Word nu lid!"
    ]
  },
