  "rdfs:comment": {
    "de": [
      "Ausgewählte Auswahl an lokalen Produkten: Weine, Olivenöl und Oliven aus Nyons, selbst gerösteter Kaffee, Tee im Einzelhandel, Marmeladen, Honig, Alkohol, Champagner, Clairette de Die und vieles mehr."
    ],
    "en": [
      "Large choice of local products: wine, olive oil and olives from Nyons, home roasted coffee, loose tea, jam, honey, alcohol, champagne, Die Clairette..."
    ],
    "it": [
      "Una selezione di prodotti locali: vini, oli e olive di Nyons, caffè tostato da noi, tè al dettaglio, marmellate, mieli, alcolici, champagne, clairette de Die e molto altro."
    ],
    "fr": [
      "Eventail choisi de produits locaux : vins, huiles d'olive et olives de Nyons, café torréfié par nos soins, thé au détail, confitures, miels, alcool, champagne, clairette de Die et bien d'autres chose encore."
    ],
    "es": [
      "Una selección de productos locales: vinos, aceites de oliva y aceitunas de Nyons, café tostado por nosotros, té al por menor, mermeladas, mieles, alcohol, champán, clairette de Die y mucho más."
    ],
    "nl": [
      "Grote keuze uit streekproducten: wijn, olijfolie en olijven uit Nyons, zelfgebrande koffie, thee, jam, honing, sterke drank, champagne, clairette de Die en vele andere lekkernijen…"
    ]
  },
