  "rdfs:comment": {
    "de": [
      "Der gemeinnützige Verein Les Ailes de Mon Coeur hat sich zum Ziel gesetzt, das Sammeln und Sortieren von Abfällen zu fördern, um eine tugendhafte Abfallwirtschaft zu betreiben und gleichzeitig zum Schutz der Umwelt beizutragen."
    ],
    "en": [
      "Les Ailes de Mon Cœur is a non-profit association dedicated to promoting the collection and sorting of waste, and helping to protect the environment."
    ],
    "it": [
      "L'associazione les Ailes de Mon C?ur è un'organizzazione senza scopo di lucro il cui obiettivo è promuovere la raccolta e la differenziazione dei rifiuti per gestirli in modo virtuoso, contribuendo alla salvaguardia dell'ambiente."
    ],
    "fr": [
      "L’association les Ailes de Mon Cœur à but non lucratif, a pour vocation de promouvoir la collecte et le tri sélectif pour une gestion vertueuse des déchets, tout en participant à la sauvegarde de l’environnement."
    ],
    "nl": [
      "Les Ailes de Mon Cœur is een vereniging zonder winstoogmerk die als doel heeft het inzamelen en sorteren van afval te promoten en zo bij te dragen tot de bescherming van het milieu."
    ],
    "es": [
      "La asociación les Ailes de Mon Cœur es una organización sin ánimo de lucro cuyo objetivo es promover la recogida y clasificación de residuos para gestionarlos de forma virtuosa, contribuyendo al mismo tiempo a la protección del medio ambiente."
    ]
  },
