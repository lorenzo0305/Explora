  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7f8c992b-04a3-3d87-9f5c-b3a3c4f7338c",
      "dc:description": {
        "de": [
          "Organisation von klassischen Konzerten.\n\nFestival Mai MUSICA NI-GELLA und jährliche Saison mit der Herbstveranstaltung in Le Touquet.\n\nKonzerte, Opernaufführungen, pädagogische Maßnahmen."
        ],
        "en": [
          "Organization of classical concerts.\n\nMUSICA NI-GELLA May Festival and annual season with autumn event in Le Touquet.\n\nConcerts, opera performances, educational activities."
        ],
        "it": [
          "Organizzazione di concerti di musica classica.\n\nFestival di maggio MUSICA NI-GELLA e stagione annuale con evento autunnale a Le Touquet.\n\nConcerti, spettacoli d'opera, attività didattiche."
        ],
        "fr": [
          "Organisation de concerts classiques.\n\nFestival Mai MUSICA NI-GELLA et saison annuelle avec l’événement automnal au Touquet.\n\nConcerts, spectacles lyriques, actions pédagogiques."
        ],
        "es": [
          "Organización de conciertos de música clásica.\n\nFestival de mayo MUSICA NI-GELLA y temporada anual con la manifestación de otoño en Le Touquet.\n\nConciertos, representaciones de ópera, actividades pedagógicas."
        ],
        "nl": [
          "Organisatie van klassieke concerten.\n\nMei Festival MUSICA NI-GELLA en jaarlijks seizoen met het najaarsevenement in Le Touquet.\n\nConcerten, operavoorstellingen, educatieve activiteiten."
        ]
      },
