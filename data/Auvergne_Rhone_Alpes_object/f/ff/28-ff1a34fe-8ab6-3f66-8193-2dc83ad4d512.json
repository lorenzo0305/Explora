      "rdfs:comment": {
        "de": [
          "Holen Sie sich Ihr gutes Gemüse, Brot, Kuhmilchprodukte, Eier, Ziegenkäse und Ihre Pilze mittwochs von 17:30 bis 18:30 Uhr im hinteren Teil des Bio'N-Ladens in der 7 rue Notre Dame in Chauny ab."
        ],
        "en": [
          "Come and get your good vegetables, bread, cow's milk products, eggs, goat's cheese, mushrooms on Wednesdays from 5:30 to 6:30 pm at the back of the Bio'N store located at 7 rue Notre Dame in Chauny."
        ],
        "it": [
          "Venite a ritirare le vostre buone verdure, il pane, i prodotti di latte vaccino, le uova, il formaggio di capra e i funghi il mercoledì dalle 17.30 alle 18.30 nel retro del negozio Bio'N, situato al 7 di rue Notre Dame a Chauny."
        ],
        "fr": [
          "Venez chercher vos bons légumes, pain, produits laitiers de vache, œufs, du fromage de chèvre, vos champignons le mercredi de 17h30 à 18h30 à l'arrière du magasin Bio'N situé au 7 rue Notre Dame à Chauny."
        ],
        "es": [
          "Venga a recoger sus buenas verduras, pan, productos de leche de vaca, huevos, queso de cabra y setas los miércoles de 17.30 a 18.30 horas en la parte trasera de la tienda Bio'N, situada en el número 7 de la calle Notre Dame de Chauny."
        ],
        "nl": [
          "Kom uw lekkere groenten, brood, koemelkproducten, eieren, geitenkaas en paddenstoelen ophalen op woensdag van 17.30 tot 18.30 uur aan de achterkant van de Bio'N-winkel in de rue Notre Dame 7 in Chauny."
        ]
      },
