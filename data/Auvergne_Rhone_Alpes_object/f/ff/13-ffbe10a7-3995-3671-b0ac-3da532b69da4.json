  "rdfs:comment": {
    "de": [
      "Die 1108 erbaute Kirche wurde mehrfach restauriert, zuletzt 1996.\r\nDer Glockenturm ist bis auf den oberen Teil original erhalten."
    ],
    "en": [
      "Built in 1108, this church has undergone many restorations, the last in 1996. The entrance and bell tower is the original, apart from the upper part."
    ],
    "it": [
      "Costruita nel 1108, questa chiesa è stata sottoposta a numerosi restauri, l'ultimo dei quali nel 1996.\r\nIl campanile del portico è originale, tranne la parte superiore."
    ],
    "fr": [
      "Construite en 1108, cette église a subi de nombreuses restaurations, la dernière en date étant celle de 1996.\r\nLe clocher porche est d'origine, mise à part la partie supérieure."
    ],
    "nl": [
      "Deze kerk, gebouwd in 1108, heeft vele restauraties ondergaan, de laatste in 1996.\r\nDe klokkentoren is origineel, behalve het bovenste gedeelte."
    ],
    "es": [
      "Construida en 1108, esta iglesia ha sido objeto de numerosas restauraciones, la última en 1996.\r\nEl campanario del pórtico es original, excepto la parte superior."
    ]
  },
