  "rdfs:comment": {
    "de": [
      "Eine gepflegte Küche und abwechslungsreiche Gerichte von seinem Lachstartar über seine flambierten Gambas oder Frösche bis hin zur Spezialität des Küchenchefs, den berühmten Spaghetti mit Meeresfrüchten."
    ],
    "en": [
      "A careful cuisine and varied dishes from its salmon tartar through its flambéed prawns or frogs, to arrive at the Chef's speciality, the famous seafood spaghetti."
    ],
    "it": [
      "La cucina è accurata e i piatti sono vari, dalla tartara di salmone ai gamberi e alle rane fiammeggiate, fino alla specialità dello chef, i famosi spaghetti ai frutti di mare."
    ],
    "fr": [
      "Une cuisine soignée et des plats variés depuis son tartare de saumon en passant par ses gambas flambées ou ses grenouilles, pour arriver à la spécialité du Chef, les fameux spaghettis aux fruits de mer."
    ],
    "es": [
      "La cocina es meticulosa y los platos son variados, desde el tartar de salmón hasta las gambas y ranas flambeadas, pasando por la especialidad del chef, los famosos espaguetis de marisco."
    ],
    "nl": [
      "De keuken is nauwgezet en de gerechten zijn gevarieerd, van zalmtartaar tot geflambeerde garnalen en kikkers, tot de specialiteit van de chef, de beroemde zeevruchtenspaghetti."
    ]
  },
