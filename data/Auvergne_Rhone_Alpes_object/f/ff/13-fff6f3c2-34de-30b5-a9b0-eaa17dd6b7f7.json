  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der ViaRhôna entfernt bietet Elles Lunch Café in Morestel hausgemachte, gesunde und schmackhafte Gerichte. Ideal für eine Schlemmerpause, einen Kaffee oder ein Mittagessen in einer gemütlichen Atmosphäre, egal ob Sie Radfahrer, Tourist oder Einheimischer sind."
    ],
    "en": [
      "Just a stone's throw from the ViaRhôna, Elles Lunch Café in Morestel offers homemade, healthy and flavourful cuisine. Perfect for a tasty break, a coffee or lunch in a warm and welcoming atmosphere—whether you're a cyclist, a visitor or a local."
    ],
    "it": [
      "A pochi passi dalla ViaRhôna, l'Elles Lunch Café di Morestel propone una cucina casalinga sana e gustosa. Ideale per una pausa gourmet, un caffè o un pranzo, in un'atmosfera amichevole, sia che siate ciclisti, turisti o residenti."
    ],
    "fr": [
      "À deux pas de ViaRhôna, Elles Lunch Café à Morestel propose une cuisine maison, saine et savoureuse. Idéal pour une pause gourmande, un café ou un déjeuner, dans une ambiance chaleureuse, que vous soyez cycliste, touriste ou habitant."
    ],
    "nl": [
      "Op een boogscheut van ViaRhôna serveert Elles Lunch Café in Morestel een gezonde en lekkere thuiskeuken. Ideaal voor een gastronomische pauze, koffie of lunch, in een gezellige sfeer, of je nu fietser, toerist of buurtbewoner bent."
    ],
    "es": [
      "A tiro de piedra de ViaRhôna, Elles Lunch Café, en Morestel, sirve comida casera, sana y sabrosa. Ideal para una pausa gastronómica, un café o un almuerzo, en un ambiente agradable, tanto si es ciclista, turista o residente local."
    ]
  },
