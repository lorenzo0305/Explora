  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/795655ed-1c4f-3da7-95eb-b6f9bd0525e0",
      "dc:description": {
        "de": [
          "L'homme V ist eine getanzte akrobatische Solo-BMX-Show mit Live-Cello. Hebungen, Würfe und Ungleichgewichte reihen sich aneinander mit Vincent Warin und seinem Cellisten. Um 19.30 Uhr"
        ],
        "en": [
          "L'homme V is an acrobatic solo BMX dance performance with live cello. Carries, throws and imbalances follow one another with Vincent Warin and his cellist. At 7.30pm"
        ],
        "it": [
          "L'homme V è uno spettacolo di danza BMX acrobatica in solitaria con violoncello dal vivo. Carry, lanci e squilibri si susseguono con Vincent Warin e il suo violoncellista. Alle 19.30"
        ],
        "fr": [
          "L'homme V est un spectacle acrobatique dansé en solo BMX et violoncelle live. Portés, lancers et déséquilibres s'enchainent avec Vincent Warin et son violoncelliste. A 19h30"
        ],
        "nl": [
          "L'homme V is een acrobatische solo BMX dansshow met live cello. Carries, worpen en onbalans volgen elkaar op met Vincent Warin en zijn cellist. Om 19.30 uur"
        ],
        "es": [
          "L'homme V es un espectáculo acrobático de danza BMX en solitario con violonchelo en directo. Carreras, lanzamientos y desequilibrios se suceden con Vincent Warin y su violonchelista. A las 19.30 h"
        ]
      },
