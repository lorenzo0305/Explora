  "rdfs:comment": {
    "de": [
      "Klassisches französisches Restaurant: Froschschenkel, Tartiflette, gebackene Andouillette, Rindfleischstück. Große Terrasse. Themenabende und gelegentliche Konzerte. Spielplatz für Kinder"
    ],
    "en": [
      "Classic French cuisine: frog legs, tartiflette, baked andouillette, beef. Large terrace. Theme evenings and occasional concerts. Playground for children"
    ],
    "it": [
      "Cucina classica francese: cosce di rana, tartiflette, andouillette al forno, manzo. Ampia terrazza. Serate a tema e concerti occasionali. Parco giochi per bambini"
    ],
    "fr": [
      "Restauration française classique : cuisses de grenouilles, tartiflette, andouillette au four, pièce de boeuf. Grande terrasse. Soirées à thème et concerts ponctuels. Aire de jeux pour les enfants"
    ],
    "nl": [
      "Klassieke Franse keuken: kikkerbilletjes, tartiflette, gebakken andouillette, rundvlees. Groot terras. Thema-avonden en incidentele concerten. Speelplaats voor kinderen"
    ],
    "es": [
      "Cocina francesa clásica: ancas de rana, tartiflette, andouillette al horno, ternera. Amplia terraza. Veladas temáticas y conciertos ocasionales. Zona de juegos para niños"
    ]
  },
