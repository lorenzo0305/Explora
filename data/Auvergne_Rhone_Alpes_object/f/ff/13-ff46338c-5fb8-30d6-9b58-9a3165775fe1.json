  "rdfs:comment": {
    "de": [
      "Honig und Bienenprodukte im Direktverkauf, Kalbfleisch, Hacksteaks, Kreuzbraten und Lammfleisch in Paketen möglich.\r\nBesichtigung des Betriebs nach Voranmeldung möglich: Gruppenempfang"
    ],
    "en": [
      "Honey and beehive products for direct sale, veal, minced steak, cross-bred and lamb meat available in packages.\r\nTours of the farm by prior arrangement: groups welcome"
    ],
    "it": [
      "Miele e prodotti dell'alveare venduti direttamente, carne di vitello, bistecca macinata, incrocio e agnello disponibili in pacchi.\r\nVisite alla fattoria su prenotazione: i gruppi sono benvenuti"
    ],
    "fr": [
      "Miel et produits de la ruche en vente directe, viande de veau, steacks hachés, croisés et viande d'agneau possible en colis. \r\nVisite de l'exploitation possible sur réservation : accueil de groupe"
    ],
    "es": [
      "Venta directa de miel y productos de la colmena, carne de ternera, carne picada, carne cruzada y carne de cordero disponible en paquetes.\r\nVisitas a la granja concertadas: se admiten grupos"
    ],
    "nl": [
      "Honing en bijenkorfproducten worden rechtstreeks verkocht, kalfsvlees, gehakt, kruisingen en lamsvlees zijn verkrijgbaar in pakketten.\r\nRondleidingen op de boerderij op afspraak: groepen zijn welkom"
    ]
  },
