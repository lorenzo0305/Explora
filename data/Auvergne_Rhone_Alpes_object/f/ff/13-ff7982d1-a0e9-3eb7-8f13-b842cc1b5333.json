  "rdfs:comment": {
    "de": [
      "Gämsen und Steinböcke sind unsere Nachbarn. Erholen Sie sich und genießen Sie unsere Bar, Snackbar und das Restaurant!\r\n\r\nTraditionelle Küche und savoyische Spezialitäten."
    ],
    "en": [
      "The area's chamois and alpine ibex are our next-door neighbors. Come rest, relax, and recharge your batteries and enjoy our bar, snack bar and restaurant!\r\n\r\nTraditional cuisine and Savoyard specialties."
    ],
    "it": [
      "Camosci e stambecchi sono i nostri vicini, quindi venite a fare il pieno di energia e a godervi il nostro bar, lo snack bar e il ristorante!\r\n\r\nCucina tradizionale e specialità savoiarde."
    ],
    "fr": [
      "Chamois et bouquetins sont nos voisins, venez vous ressourcer et profiter de notre bar, snack et restaurant ! \r\n\r\nCuisine traditionnelle et spécialités savoyardes."
    ],
    "es": [
      "Nuestras vecinas son las gamuzas y las cabras montesas. ¡Ven a recargar cuerpo y alma y disfruta de nuestro bar, snack bar y restaurante\r\n\r\nCocina tradicional y especialidades saboyanas."
    ],
    "nl": [
      "Gemzen en steenbokken zijn onze buren, dus kom nieuwe energie opdoen en geniet van onze bar, snackbar en restaurant!\r\n\r\nTraditionele keuken en specialiteiten uit de Savoie."
    ]
  },
