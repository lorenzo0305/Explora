  "rdfs:comment": {
    "de": [
      "La Sabinette ist ein Unternehmen, das Liköre und Sirupe auf der Grundlage von 100% natürlichen Pflanzen und Bäumen herstellt.\r\nDie Getränke werden aus den Knospen von Tannen, Lavendel und Eisenkraut hergestellt."
    ],
    "en": [
      "La Sabinette produces liqueurs and syrups from 100% natural plants and trees.\r\nThe beverages are made from fir, lavender and verbena buds."
    ],
    "it": [
      "La Sabinette produce liquori e sciroppi da piante e alberi naturali al 100%.\r\nLe bevande sono preparate con germogli di abete, lavanda e verbena."
    ],
    "fr": [
      "La Sabinette est une entreprise de production  de liqueurs et sirops à base de plantes et d’arbres 100% naturelles. \r\nLes boissons sont fabriquées à partir de bourgeons de sapin, de lavande et de verveine."
    ],
    "nl": [
      "La Sabinette produceert likeuren en siropen van 100% natuurlijke planten en bomen.\r\nDe drankjes worden gemaakt van dennen, lavendel en verbena knoppen."
    ],
    "es": [
      "La Sabinette produce licores y siropes a partir de plantas y árboles 100% naturales.\r\nLas bebidas se elaboran con brotes de abeto, lavanda y verbena."
    ]
  },
