  "rdfs:comment": {
    "de": [
      "Ein Schmuckstück, das Ihre Geschichte erzählt. Für jeden einzigartigen Moment in Ihrem Leben? Taufe, Geburtstag, Hochzeit, ... Schaffen Sie ein kostbares Andenken. Jedes Stück ist ein Träger von Emotionen und persönlichen Bedeutungen."
    ],
    "en": [
      "A jewel that tells your story. For every unique moment in your life? Baptism, Birthday, Wedding, ... create a precious souvenir. Each piece is full of emotion and personal meaning."
    ],
    "it": [
      "Un gioiello che racconta la vostra storia. Per ogni momento unico della vostra vita? Battesimo, compleanno, matrimonio, ... create un ricordo prezioso. Ogni pezzo è ricco di emozioni e di significati personali."
    ],
    "fr": [
      "Un Bijou Qui Raconte Votre Histoire. Pour chaque moment unique de votre vie – Baptême, Anniversaire, Mariage, ... créez un souvenir précieux. Chaque pièce est porteuse d’émotions et de significations personnelles."
    ],
    "es": [
      "Una joya que cuenta tu historia. Para cada momento único de tu vida.. Bautizo, cumpleaños, boda, ... cree un precioso recuerdo. Cada pieza está llena de emoción y significado personal."
    ],
    "nl": [
      "Een juweel dat jouw verhaal vertelt. Voor elk uniek moment in je leven? Doop, verjaardag, huwelijk, ... creëer een kostbaar aandenken. Elk stuk zit vol emotie en persoonlijke betekenis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier de Calvin - Créatrice de souvenirs"
    ]
  },
