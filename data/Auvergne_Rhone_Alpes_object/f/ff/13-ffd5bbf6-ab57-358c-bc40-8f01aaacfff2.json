          "additionalInformation": {
            "de": [
              "Geöffnet von Montag bis Samstag.\r\nMontag Abend, Samstag Abend und Sonntag geschlossen.\r\nIm Sommer samstagabends geöffnet.\r\nService von 11:45 bis 13:45 Uhr und von 19:30 bis 21:30 Uhr."
            ],
            "en": [
              "Open from Monday to Saturday.\r\nClosed Monday evening, Saturday evening and Sunday.\r\nSummer opening on Saturday evenings.\r\nService from 11:45 to 13:45 and from 19:30 to 21:30."
            ],
            "it": [
              "Aperto dal lunedì al sabato.\r\nChiuso il lunedì sera, il sabato sera e la domenica.\r\nIn estate, aperto il sabato sera.\r\nServizio dalle 11:45 alle 13:45 e dalle 19:30 alle 21:30."
            ],
            "fr": [
              "Ouvert du lundi au samedi.\r\nFermé lundi soir, samedi soir et dimanche.\r\nL’été ouverture les samedis soirs.\r\nService de 11h45 à 13h45 et de 19h30 à 21h30."
            ],
            "nl": [
              "Open van maandag tot zaterdag.\r\nGesloten op maandagavond, zaterdagavond en zondag.\r\nIn de zomer geopend op zaterdagavond.\r\nDienst van 11:45 tot 13:45 en van 19:30 tot 21:30."
            ],
            "es": [
              "Abierto de lunes a sábado.\r\nCerrado el lunes por la noche, el sábado por la noche y el domingo.\r\nEn verano, abre los sábados por la noche.\r\nServicio de 11:45 a 13:45 y de 19:30 a 21:30."
            ]
          },
