  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum von Clermont-Ferrand gelegen, befindet sich der Pavillon Lamartine 300 m vom Place de Jaude entfernt in Richtung Rue Blatin\r\nSie biegen rechts in die Rue Michel-Hugues ein und können sein Eingangsportal nicht verfehlen."
    ],
    "en": [
      "Located in the center of Clermont-Ferrand, Le Pavillon Lamartine is 300 meters from the Place de Jaude in the direction of Rue Blatin\r\nYou will take on the right the street Michel-Hugues and will not be able to miss its entrance gate."
    ],
    "it": [
      "Situato nel centro di Clermont-Ferrand, Le Pavillon Lamartine dista 300 metri da Place de Jaude verso Rue Blatin\r\nGirate a destra in rue Michel-Hugues e non perdete il cancello d'ingresso."
    ],
    "fr": [
      "Situé au centre ville de Clermont-Ferrand, Le Pavillon Lamartine se trouve  à 300 mètres de la place de Jaude en direction de la rue Blatin. \r\nVous prendrez sur la droite la rue Michel-Hugues et ne pourrez pas manquer son portail d’entrée."
    ],
    "es": [
      "Situado en el centro de la ciudad de Clermont-Ferrand, Le Pavillon Lamartine está a 300 metros de la plaza de Jaude en dirección a la calle Blatin\r\nGire a la derecha en la calle Michel-Hugues y no se pierda la puerta de entrada."
    ],
    "nl": [
      "Le Pavillon Lamartine ligt in het stadscentrum van Clermont-Ferrand, op 300 meter van het Place de Jaude naar de Rue Blatin\r\nSla rechtsaf de rue Michel-Hugues in en u zult de toegangspoort niet missen."
    ]
  },
