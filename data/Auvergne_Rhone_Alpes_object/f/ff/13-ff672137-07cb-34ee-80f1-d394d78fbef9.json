  "rdfs:comment": {
    "de": [
      "Restaurant, das sich einem innovativen kulinarischen Konzept widmet, das frische, gesunde und \"hausgemachte\" Produkte anbietet, um den Gaumen eines jeden in Form eines gastronomischen Criq' Burgers im Herzen des Stadtzentrums zu verwöhnen."
    ],
    "en": [
      "La Main Verte offers healthy, innovative 100% home cooking. Discover the Criq Burger, a gourmet bunless burger with potato patties, topped with refined, gluten-free products and served in an authentic setting on a verdant terrace."
    ],
    "it": [
      "La Main Verte offre una cucina casalinga al 100%, sana e innovativa. Scoprite il Criq Burger gourmet senza pane, le frittelle di patate e i prodotti raffinati e senza glutine, serviti in un ambiente autentico su una terrazza verdeggiante."
    ],
    "fr": [
      "La Main Verte propose une cuisine 100% maison saine et innovante. Découvrez le Criq Burger gastronomique sans pain, aux galettes de pommes de terre, garnis de produits raffinés, sans gluten servi dans un cadre authentique et une terrasse verdoyante."
    ],
    "es": [
      "La Main Verte ofrece una cocina 100% casera, sana e innovadora. Descubra la hamburguesa gourmet Criq Burger sin pan, las tortitas de patata y los productos refinados sin gluten, servidos en un marco auténtico en una frondosa terraza."
    ],
    "nl": [
      "La Main Verte biedt een 100% thuiskeuken die zowel gezond als vernieuwend is. Ontdek de gastronomische Criq Burger zonder brood, aardappelpannenkoeken en verfijnde, glutenvrije producten, geserveerd in een authentieke setting op een lommerrijk terras."
    ]
  },
