  "rdfs:comment": {
    "de": [
      "Traditionelle und regionale Hausmannskost aus frischen Zutaten.\r\nEine Auswahl an Weinen aus dem Dorf und der Umgebung wird Sie überraschen und verwöhnen.\r\nAn schönen Tagen werden die Mahlzeiten im Park serviert."
    ],
    "en": [
      "Traditional, regional home cooking using fresh produce.\r\nA selection of wines from the village and surrounding area will surprise and delight you. \r\nIn fine weather, meals are served in the park."
    ],
    "it": [
      "Cucina casalinga tradizionale e regionale con prodotti freschi.\r\nUna selezione di vini del paese e dei dintorni vi sorprenderà e vi delizierà.\r\nNella bella stagione, i pasti vengono serviti nel parco."
    ],
    "fr": [
      "Cuisine maison traditionnelle et régionale à partir de produits frais.\r\nUne sélection de vins issus du village et des alentours saura vous surprendre et vous régaler. \r\nDès les beaux jours, les repas sont servis dans le parc."
    ],
    "nl": [
      "Traditionele, regionale keuken met verse producten.\r\nEen selectie wijnen uit het dorp en de omgeving zal je verrassen en verrukken.\r\nBij mooi weer worden de maaltijden in het park geserveerd."
    ],
    "es": [
      "Cocina casera, tradicional y regional con productos frescos.\r\nUna selección de vinos del pueblo y sus alrededores le sorprenderá y deleitará.\r\nCuando hace buen tiempo, las comidas se sirven en el parque."
    ]
  },
