  "rdfs:comment": {
    "de": [
      "Skatepark mit Miniramp, sehr streetorientierte Module: 2 Tische, schiefe Ebenen in verschiedenen Größen, mehrere Curbs, eine Slidebar, eine Quarter-Curve (L=3 m). Eine Wasserstelle. Bänke. Schattige Lage. In der Nähe von Fluss, Stadtzentrum, Tennis- und Bouleplätzen."
    ],
    "en": [
      "Skatepark with mini-ramp, very street-oriented modules: 2 tables, inclined planes of various sizes, several curbs, a slide bar, a quarter-curve (L=3 m). Water point. Benches. Shaded. Close to river, town center, tennis courts and pétanque."
    ],
    "it": [
      "Skatepark con mini-rampa, moduli molto orientati alla strada: 2 tavoli, piani inclinati di varie dimensioni, diversi cordoli, una barra di scorrimento, un quarto di curva (L=3 m). Punto acqua. Panchine. Area ombreggiata. Vicino al fiume, al centro città, ai campi da tennis e alle bocce."
    ],
    "fr": [
      "Skatepark avec mini-rampe, modules axés très « street » : 2 tables, plans inclinés de différentes tailles, plusieurs curbs, une barre à slide, un quarter-courbe (L=3 m). Point d'eau. Bancs. Ombragé. Prox rivière, centre ville, terrains tennis et pétanque."
    ],
    "nl": [
      "Skatepark met mini-ramp, zeer straatgerichte modules: 2 tafels, hellende vlakken van verschillende grootte, verschillende stoepranden, een glijstang, een kwartcurve (L=3 m). Waterpunt. Banken. Schaduwrijk gedeelte. Vlakbij de rivier, het stadscentrum, tennisbanen en jeu de boulesbaan."
    ],
    "es": [
      "Skatepark con minirampa, módulos muy orientados a la calle: 2 mesas, planos inclinados de varios tamaños, varios bordillos, una barra de deslizamiento, un quarter-curve (L=3 m). Punto de agua. Bancos. Zona de sombra. Cerca del río, del centro urbano, de las pistas de tenis y de la zona de petanca."
    ]
  },
  "rdfs:label": {
    "fr": [
