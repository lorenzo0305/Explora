  "rdfs:comment": {
    "de": [
      "Le Clos St-Eloi ist ein 4-Sterne-Hotel und Restaurant, das 2015 komplett renoviert wurde. Es befindet sich in Thiers, der Hauptstadt der Messerschmiedekunst, und ist 2 km von der Ausfahrt Nr. 29 auf der Autobahn A89 entfernt, die Lyon mit Bordeaux verbindet."
    ],
    "en": [
      "Our chef draws his inspiration from the products of our region and invites you to sample from our diverse and flavourful menu. Open for lunch and dinner, every day with reservations."
    ],
    "it": [
      "Le Clos St-Eloi è un hotel ristorante a 4 stelle, completamente rinnovato nel 2015. Situato a Thiers, la capitale della coltelleria, si trova a 2 km dall'uscita 29 dell'autostrada A89 che collega Lione a Bordeaux."
    ],
    "fr": [
      "Le Clos St-Eloi est un hôtel restaurant 4 étoiles, entièrement rénové en 2015. Situé à Thiers, capitale de la coutellerie, il est à 2km de la sortie n°29 sur l'autoroute A89 reliant Lyon à Bordeaux."
    ],
    "nl": [
      "Le Clos St-Eloi is een 4-sterrenhotel-restaurant, volledig gerenoveerd in 2015. Het ligt in Thiers, de bestekhoofdstad, op 2 km van afrit 29 van de snelweg A89 die Lyon met Bordeaux verbindt."
    ],
    "es": [
      "Le Clos St-Eloi es un hotel restaurante de 4 estrellas, completamente renovado en 2015. Situado en Thiers, capital de la cuchillería, está a 2 km de la salida 29 de la autopista A89 que une Lyon con Burdeos."
    ]
  },
  "rdfs:label": {
