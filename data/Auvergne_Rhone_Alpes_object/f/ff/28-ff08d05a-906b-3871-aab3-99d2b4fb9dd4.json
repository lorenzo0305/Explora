  "rdfs:comment": {
    "de": [
      "Die Vokalgruppe \"Si on chantait\" aus Peron schlägt Ihnen die Aufführung \"un air de vacances\" vor, um Sie für die Dauer eines Konzerts in den Sommer zu versetzen. Ein geselliger Moment, den Sie unter Freunden, zu zweit oder mit der Familie verbringen können."
    ],
    "en": [
      "The Peron-based vocal group \"Si on chantait\" presents \"un air de vacances\", a concert that will take you back to summer. A convivial moment to spend with friends, couples or family."
    ],
    "it": [
      "Il gruppo vocale di Peron \"Si on chantait\" mette in scena uno spettacolo intitolato \"un air de vacances\" per riportarvi indietro nel tempo per un concerto estivo. Un momento conviviale da trascorrere con gli amici, in coppia o in famiglia."
    ],
    "fr": [
      "Le groupe vocal péronnais \"Si on chantait\"  vous propose le spectacle \"un air de vacances\" pour vous projeter le temps d'un concert en été. Un moment convivial à passer entre amis, en couple ou en famille."
    ],
    "es": [
      "El grupo vocal de Perón \"Si on chantait\" ofrece un espectáculo titulado \"un air de vacances\" para hacernos retroceder en el tiempo durante un concierto de verano. Un momento de convivencia para pasar entre amigos, en pareja o en familia."
    ],
    "nl": [
      "De uit Peron afkomstige zanggroep \"Si on chantait\" brengt een show met de titel \"un air de vacances\" om je mee terug te nemen in de tijd voor een zomerconcert. Een gezellig moment om door te brengen met vrienden, met z'n tweeën of met het hele gezin."
    ]
  },
  "rdfs:label": {
    "fr": [
