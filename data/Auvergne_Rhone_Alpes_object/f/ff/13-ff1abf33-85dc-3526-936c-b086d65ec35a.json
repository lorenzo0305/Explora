  "rdfs:comment": {
    "de": [
      "Das asiatische Restaurant \"Mei Shan\" bietet typische und schmackhafte Gerichte (chinesisch, thailändisch und japanisch), die in Grenoble einzigartig sind."
    ],
    "en": [
      "The \"Mei Shan\" Asian restaurant offers typical, tasty dishes (Chinese, Thai and Japanese) that are unique in Grenoble."
    ],
    "it": [
      "Il ristorante asiatico \"Mei Shan\" offre piatti tipici e gustosi (cinesi, thailandesi e giapponesi) unici a Grenoble."
    ],
    "fr": [
      "Le restaurant Asiatique\" Mei Shan\" propose des plats typiques et savoureux ( chinois, thaïlandais et japonais) unique sur Grenoble."
    ],
    "nl": [
      "Het Aziatische restaurant \"Mei Shan\" biedt typische en smakelijke gerechten (Chinees, Thais en Japans) die uniek zijn in Grenoble."
    ],
    "es": [
      "El restaurante asiático \"Mei Shan\" ofrece platos típicos y sabrosos (chinos, tailandeses y japoneses) únicos en Grenoble."
    ]
