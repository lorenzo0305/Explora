  "rdfs:comment": {
    "de": [
      "Seit 13 Jahren biete ich Ihnen eine breite Palette an Wellness-Massagen, Lymphdrainagen, Kobido, Muskelentspannung, Massagen für Schwangere, Energiebehandlungen in einem privaten, ruhigen und gedämpften Raum."
    ],
    "en": [
      "For the past 13 years, I've been offering a wide range of wellness massages, lymphatic drainage, kobido, muscle relaxation, pregnancy massages and energy treatments, in a private, calm & hushed space."
    ],
    "it": [
      "Da 13 anni offro un'ampia gamma di massaggi benessere, linfodrenaggio, kobido, rilassamento muscolare, massaggi in gravidanza e trattamenti energetici, in un ambiente privato, calmo e silenzioso."
    ],
    "fr": [
      "Depuis 13 ans, je vous propose une large gamme de massages bien-être, drainages lymphatiques, kobido, détente musculaire, massages femme enceinte, soins énergétiques, dans un espace privatisé, calme & feutré."
    ],
    "es": [
      "Desde hace 13 años, ofrezco una amplia gama de masajes de bienestar, drenaje linfático, kobido, relajación muscular, masajes para embarazadas y tratamientos energéticos, en un ambiente privado, tranquilo y silencioso."
    ],
    "nl": [
      "Al 13 jaar bied ik een breed scala aan welzijnsmassages, lymfedrainage, kobido, spierontspanning, zwangerschapsmassages en energiebehandelingen, in een privé, rustige en stille omgeving."
    ]
  },
