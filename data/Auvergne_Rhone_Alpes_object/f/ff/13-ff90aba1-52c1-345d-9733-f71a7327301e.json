  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Restaurant Le Fort Marie-Christine in Aussois! Genießen Sie eine savoyische und regionale Küche für Ihre festlichen Mahlzeiten mit der Familie, Freunden oder Geschäftsleuten in einem Fort mit wunderschönen Gewölbesälen."
    ],
    "en": [
      "Fort Marie-Christine is a lovely restaurant with vaulted rooms, offering local cuisine for your festive meals with family, friends or professionals."
    ],
    "it": [
      "Fort Marie-Christine è un bel ristorante con camere a volta, che offre cucina locale per i vostri pranzi di festa con la famiglia, gli amici o professionisti."
    ],
    "fr": [
      "Découvrez le restaurant Le Fort Marie-Christine à Aussois ! Savourez une cuisine savoyarde et du terroir pour vos repas de fête en famille, entre amis ou professionnels dans un fort aux magnifiques salles voûtées."
    ],
    "es": [
      "¡Descubra el restaurante Le Fort Marie-Christine en Aussois! Saboree la cocina saboyana y local para sus comidas festivas en familia, entre amigos o con profesionales en un fuerte con magníficas salas abovedadas."
    ],
    "nl": [
      "In Fort Marie-Christine vindt u een prachtig restaurant met gewelfde zalen, waar u de lokale keuken kunt proeven voor uw feestelijke maaltijden, met familie, vrienden of professionals."
    ]
  },
