  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Resto des Alpes, ein Erlebnis, das Sie in einer gemütlichen, grünen Umgebung mit einem atemberaubenden Blick auf die Fairways des Golf des Alpes teilen können."
    ],
    "en": [
      "Discover the Resto des Alpes, an experience to share in a cozy and green setting offering a breathtaking view of the fairways at Golf des Alpes."
    ],
    "it": [
      "Scoprite il Resto des Alpes, un'esperienza da condividere in un ambiente accogliente e verdeggiante con una vista mozzafiato sui fairway del Golf des Alpes."
    ],
    "fr": [
      "Découvrez le Resto des Alpes, une expérience à partager dans un cadre cosy et verdoyant offrant une vue imprenable sur les fairways du Golf des Alpes."
    ],
    "nl": [
      "Ontdek het Resto des Alpes, een ervaring om te delen in een gezellige, groene omgeving met een adembenemend uitzicht over de fairways van de Golf des Alpes."
    ],
    "es": [
      "Descubra el Resto des Alpes, una experiencia para compartir en un marco acogedor y frondoso con una vista impresionante sobre las calles del Golf des Alpes."
    ]
  },
