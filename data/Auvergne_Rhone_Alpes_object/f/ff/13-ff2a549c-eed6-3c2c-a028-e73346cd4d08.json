  "rdfs:comment": {
    "de": [
      "\"Wir werten die lokale Wolle auf handwerkliche und ökologische Weise auf, um Ihnen schöne Artikel rund um Kleidung, Haus und Garten anzubieten."
    ],
    "en": [
      "\"We use local wool in an artisanal and ecological way to offer you beautiful articles for clothing, the home and the garden."
    ],
    "it": [
      "\"Utilizziamo la lana locale in modo artigianale ed ecologico per offrirvi bellissimi articoli per l'abbigliamento, la casa e il giardino.\r\n\r\nSito di Valence: aperto solo per eventi speciali. Non è aperto su appuntamento."
    ],
    "fr": [
      "\"Nous valorisons la laine locale de façon artisanale et écologique pour vous proposer de beaux articles autour de l'habillement, de la maison et du jardin.\r\n\r\nSite de Valence : uniquement ouvert lors d'évènements exceptionnels. Pas d'ouverture sur RDV."
    ],
    "nl": [
      "\"We gebruiken lokale wol op een ambachtelijke en ecologische manier om je prachtige artikelen te bieden voor kleding, het huis en de tuin."
    ],
    "es": [
      "\"Utilizamos lana local de forma artesanal y ecológica para ofrecerle bellos artículos para la ropa, el hogar y el jardín.\r\n\r\nSitio de Valence: sólo abierto para eventos especiales. No abierto con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de confection Ardelaine"
    ]
  },
