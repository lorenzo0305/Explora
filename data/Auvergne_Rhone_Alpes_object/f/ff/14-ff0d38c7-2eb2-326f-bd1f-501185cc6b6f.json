  "rdfs:comment": {
    "de": [
      "Im Rahmen der Wanderausstellung \"Territoire en mouvement\"\nEin Reiseführer führt Sie durch die Vergangenheit, Gegenwart und Zukunft von Vendin-le-Vieil."
    ],
    "en": [
      "Within the framework of the travelling exhibition \"Territory in movement\"\nA guide will make you discover the past, the present and the future of Vendin-le-Vieil."
    ],
    "it": [
      "Nell'ambito della mostra itinerante \"Territorio in movimento\"\nUna guida vi illustrerà il passato, il presente e il futuro di Vendin-le-Vieil."
    ],
    "fr": [
      "Dans le cadre de l'Exposition itinérante \"Territoire en mouvement\"\nUn guide vous fera découvrir le passé, le présent et le futur de Vendin-le-Vieil."
    ],
    "es": [
      "En el marco de la exposición itinerante \"Territorio en movimiento\nUn guía le mostrará el pasado, el presente y el futuro de Vendin-le-Vieil."
    ],
    "nl": [
      "Als onderdeel van de reizende tentoonstelling \"Grondgebied in beweging\nEen gids laat je het verleden, het heden en de toekomst van Vendin-le-Vieil zien."
    ]
  },
