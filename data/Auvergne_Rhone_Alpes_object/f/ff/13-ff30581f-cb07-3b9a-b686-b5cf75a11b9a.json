  "rdfs:comment": {
    "de": [
      "La Gevrinoise ist eine handwerkliche Brauerei im Herzen des Bugey-Gebiets, deren Biere alle aus französischen und biologischen Rohstoffen hergestellt werden."
    ],
    "en": [
      "La Gevrinoise is a craft brewery in the heart of the Bugey region, producing all its beers from French and organic raw materials."
    ],
    "it": [
      "La Gevrinoise è un birrificio artigianale nel cuore della regione di Bugey, che produce tutte le sue birre con materie prime francesi e biologiche."
    ],
    "fr": [
      "La Gevrinoise est une brasserie artisanale située en plein cœur du Bugey, dont toutes les bières sont issues de matières premières françaises et biologiques."
    ],
    "nl": [
      "La Gevrinoise is een ambachtelijke brouwerij in het hart van de regio Bugey, die al haar bieren maakt van Franse en biologische grondstoffen."
    ],
    "es": [
      "La Gevrinoise es una cervecería artesanal situada en el corazón de la región de Bugey, que produce todas sus cervezas a partir de materias primas francesas y ecológicas."
    ]
  },
