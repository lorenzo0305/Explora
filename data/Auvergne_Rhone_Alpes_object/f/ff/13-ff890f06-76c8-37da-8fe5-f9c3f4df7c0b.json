  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf leckeres Fleisch vom Flammengrill, frische Produkte, die auf Wunsch zubereitet werden? Dann zögern Sie nicht länger und besuchen Sie unser Restaurant BURGER KING Thonon Anthy."
    ],
    "en": [
      "Do you want to taste a tasty meat grilled on the flame, fresh products, prepared on demand ? Then don’t hesitate any more, go to our restaurant BURGER KING Thonon Anthy."
    ],
    "it": [
      "Volete gustare una gustosa grigliata di carne alla fiamma, prodotti freschi, preparati su richiesta? Allora non esitate a visitare il nostro ristorante BURGER KING Thonon Anthy."
    ],
    "fr": [
      "Envie de déguster une viande savoureuse grillée à la flamme, des produits frais, préparés à la demande ? Alors n’hésitez plus, rendez-vous dans notre restaurant BURGER KING  Thonon Anthy."
    ],
    "es": [
      "¿Le gustaría disfrutar de una sabrosa carne a la parrilla, de productos frescos, preparados a la carta? Entonces no dude en visitar nuestro restaurante BURGER KING Thonon Anthy."
    ],
    "nl": [
      "Wilt u genieten van een smakelijk gegrild vlees, verse producten, bereid op bestelling? Aarzel dan niet langer, kom naar ons restaurant BURGER KING Thonon Anthy."
    ]
  },
