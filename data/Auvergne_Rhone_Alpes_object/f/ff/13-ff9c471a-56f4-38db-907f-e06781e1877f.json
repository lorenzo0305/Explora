  "rdfs:comment": {
    "de": [
      "Caroline ist in der Mitte ihres Lebens, genau zwischen Jung und Alt: Sie hat einen TikTok-Account, aber sie bezahlt jemanden fürs Posten, weil sie nichts versteht!"
    ],
    "en": [
      "Caroline is halfway through her life, right between the young and the old: she has a TikTok account but she pays someone to post, because she doesn't understand anything!"
    ],
    "it": [
