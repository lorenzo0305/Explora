  "rdfs:comment": {
    "de": [
      "Die Venezianische Villa befindet sich in der Rue de Belgique 7. Wenn der Blick an dieser Fassade hängen bleibt, findet sich der Besucher zwischen Byzanz und der Dogenstadt versetzt."
    ],
    "en": [
      "The Venetian Villa is located at 7, rue de Belgique. When the eye catches this façade, the visitor is transported between Byzantium and the City of the Doges."
    ],
    "it": [
      "La Villa Veneta si trova al 7 di rue de Belgique. Quando l'occhio coglie questa facciata, il visitatore viene trasportato tra Bisanzio e la Città dei Dogi."
    ],
    "fr": [
      "La Villa Vénitienne est située au 7, rue de Belgique. Quand le regard accroche cette façade, le visiteur se trouve transporté entre Byzance et la Cité des Doges."
    ],
    "es": [
      "La Villa Veneciana se encuentra en el número 7 de la rue de Belgique. Cuando el ojo capta esta fachada, el visitante se transporta entre Bizancio y la Ciudad de los Dogos."
    ],
    "nl": [
      "De Venetiaanse Villa bevindt zich op 7, Belgiëstraat. Wanneer het oog op deze gevel valt, wordt de bezoeker meegevoerd tussen Byzantium en de Stad van de Doges."
    ]
  },
