  "rdfs:comment": {
    "de": [
      "Im Restaurant A la maison in Ceyzériat fühlen Sie sich, als wären Sie zu Hause.  À la maison bietet hausgemachte Gerichte und Tagesmenüs. Im À la maison erwarten Sie frische Produkte."
    ],
    "en": [
      "The A la maison restaurant in Ceyzériat makes you feel right at home.  À la maison offers home-made dishes and daily menus. Fresh produce awaits you at A la maison."
    ],
    "it": [
      "Il ristorante À la maison di Ceyzériat vi farà sentire come a casa vostra.  À la maison offre piatti fatti in casa e menù giornalieri. I prodotti freschi vi aspettano ad A la maison."
    ],
    "fr": [
      "Le restaurant A la maison, à Ceyzériat, vous fait ressentir comme si vous étiez chez vous à la maison.  À la maison propose des plats confectionnés maison et des menus du jour. À la maison, des produits frais vous attendent."
    ],
    "nl": [
      "In het restaurant À la maison in Ceyzériat voel je je meteen thuis.  À la maison biedt huisgemaakte gerechten en dagmenu's. Verse producten wachten op je bij A la maison."
    ],
    "es": [
      "El restaurante À la maison de Ceyzériat le hará sentirse como en casa.  À la maison ofrece platos caseros y menús diarios. Los productos frescos le esperan en A la maison."
    ]
  },
  "rdfs:label": {
    "en": [
