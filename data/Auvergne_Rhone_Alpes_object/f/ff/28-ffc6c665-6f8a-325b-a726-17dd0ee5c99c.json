  "rdfs:comment": {
    "de": [
      "Leonidas, Chocolatier in Villeneuve-d'Ascq, bietet Ihnen Naschwerk in seiner reinsten Form.\nEntdecken Sie in der Boutique das Sortiment an belgischen Pralinen und die Auswahl an Schokoladensüßigkeiten."
    ],
    "en": [
      "Leonidas, chocolatier in Villeneuve-d'Ascq, offers you pure indulgence.\nDiscover our assortment of Belgian chocolates and our range of chocolate sweets."
    ],
    "it": [
      "Leonidas, cioccolateria di Villeneuve-d'Ascq, vi offre pura indulgenza.\nScoprite la nostra gamma di cioccolatini belgi e dolci al cioccolato in negozio."
    ],
    "fr": [
      "Leonidas, chocolatier à Villeneuve-d'Ascq, vous offre la gourmandise à l’état pur. \nDécouvrez en boutique l'assortiment de chocolats belges et la gamme de douceurs en chocolat."
    ],
    "nl": [
      "Leonidas, chocolatier in Villeneuve-d'Ascq, biedt u pure verwennerij.\nOntdek ons assortiment Belgische pralines en chocoladesnoepjes in de winkel."
    ],
    "es": [
      "Leonidas, chocolatero en Villeneuve-d'Ascq, le ofrece pura indulgencia.\nDescubra nuestra gama de bombones belgas y dulces de chocolate en tienda."
    ]
  },
