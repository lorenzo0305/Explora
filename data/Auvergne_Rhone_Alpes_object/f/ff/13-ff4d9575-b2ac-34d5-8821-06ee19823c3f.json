  "rdfs:comment": {
    "de": [
      "Das Fer à Cheval serviert Tagesgerichte in einer belebenden und gemischten Atmosphäre, in der sich Arbeiter und Führungskräfte begegnen... Dieses Lokal ist eine Institution, die 1970 gegründet wurde."
    ],
    "en": [
      "Le Fer à Cheval serves dishes of the day in a lively atmosphere, with a mixed clientele ranging from labourers to management executives. This local institution opened in 1970."
    ],
    "it": [
      "Il Fer à Cheval serve specialità giornaliere in un'atmosfera vivace e mista, dove si incontrano lavoratori e dirigenti. Questo istituto è stato creato nel 1970."
    ],
    "fr": [
      "Le Fer à Cheval sert des plats du jour, dans une ambiance tonique et mixte où se croisent des ouvriers, des cadres... Cet établissement est une institution qui a été  créée en 1970."
    ],
    "es": [
      "El Fer à Cheval sirve especialidades diarias en un ambiente animado y mixto donde se reúnen... trabajadores y ejecutivos. Este establecimiento es una institución creada en 1970."
    ],
    "nl": [
      "De Fer à Cheval serveert dagschotels in een levendige, gemengde sfeer waar werknemers en leidinggevenden elkaar ontmoeten. Deze instelling werd opgericht in 1970."
    ]
  },
