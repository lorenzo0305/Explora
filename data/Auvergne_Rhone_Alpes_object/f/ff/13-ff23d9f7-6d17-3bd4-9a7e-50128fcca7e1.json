  "rdfs:comment": {
    "de": [
      "Pierluigi und Francesca bieten Ihnen Spezialitäten in den Farben Italiens: Pizza, Pasta, Salate, Wurstbretter und italienische Käsesorten stehen ebenso auf der Speisekarte wie leckere Desserts, Eis und guter ILLY-Kaffee."
    ],
    "en": [
      "Pierluigi and Francesca offer Italian specialties: pizzas, pastas, salads, charcuterie boards and Italian cheeses are all on the menu, along with gourmet desserts, ice creams and good ILLY coffee."
    ],
    "it": [
      "Pierluigi e Francesca vi offrono specialità italiane: pizze, paste, insalate, taglieri di salumi e formaggi italiani sono nel menu, oltre a dessert gourmet, gelati e il buon caffè ILLY."
    ],
    "fr": [
      "Pierluigi et Francesca vous proposent des spécialités aux couleurs de l'Italie : pizzas, pâtes, salades, planches de charcuteries et fromages italiens sont à la carte ainsi que des desserts gourmands, des glaces et du bon café ILLY."
    ],
    "es": [
      "Pierluigi y Francesca le ofrecen especialidades italianas: pizzas, pastas, ensaladas, tablas de embutidos y quesos italianos figuran en la carta, así como postres gourmet, helados y un buen café ILLY."
    ],
    "nl": [
      "Pierluigi en Francesca bieden Italiaanse specialiteiten: pizza's, pasta's, salades, vleeswarenplanken en Italiaanse kazen staan op het menu, evenals gastronomische desserts, ijs en goede ILLY koffie."
    ]
  },
  "rdfs:label": {
