        "de": [
          "Entdeckungstag von 10:30 bis 12:30 Uhr und von 14:30 bis 17:00 Uhr.\nEntdecken Sie die vom Reitzentrum angebotenen Aktivitäten.\nOffen für alle."
        ],
        "en": [
          "Discovery day from 10:30am to 12:30pm and from 2:30pm to 5pm.\nDiscover the activities offered by the equestrian center.\nOpen to all."
        ],
        "it": [
          "Giornata di scoperta dalle 10.30 alle 12.30 e dalle 14.30 alle 17.00.\nScoprite le attività offerte dal centro ippico.\nAperto a tutti."
        ],
        "fr": [
          "Journée découverte de 10h30 à 12h30 et de 14h30 à 17h.\nDécouverte des activités proposées par le centre équestre.\nOuvert à tous."
        ],
        "nl": [
          "Ontdekkingsdag van 10.30 tot 12.30 uur en van 14.30 tot 17.00 uur.\nOntdek de activiteiten van de manege.\nVoor iedereen toegankelijk."
        ],
        "es": [
          "Jornada de descubrimiento de 10.30 a 12.30 y de 14.30 a 17.00 horas.\nDescubra las actividades propuestas por el centro ecuestre.\nAbierto a todos."
