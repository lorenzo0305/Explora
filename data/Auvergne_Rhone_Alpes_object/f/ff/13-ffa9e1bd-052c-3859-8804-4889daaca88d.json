  "rdfs:comment": {
    "de": [
      "In BIO, Honig, Lebkuchen, Brotaufstrich, Honigbonbons, Seifen, Balsam. Je nach Jahreszeit Lämmer aus Freilandhaltung in biologischer Landwirtschaft in Kisten, Terrinen und Fertiggerichten."
    ],
    "en": [
      "Organic honeys, gingerbread, spreads, honey sweets, soaps, balms. Depending on the season, organically-raised free-range lamb is available in boxes, terrines and ready-to-eat dishes."
    ],
    "it": [
      "Azienda agricola sostenibile con miele, miele transfo, agnelli e maiali allevati all'aperto."
    ],
    "fr": [
      "Ferme en agriculture raisonnée avec miel, transfo miel, agneaux et porcs élevés en plein air."
    ],
    "es": [
      "Granja sostenible con miel, miel transfo, corderos y cerdos camperos."
    ],
    "nl": [
      "Biologische honing, ontbijtkoek, smeersels, honingsnoepjes, zeepjes, balsems. Afhankelijk van het seizoen is er biologisch gekweekt lamsvlees met vrije uitloop verkrijgbaar in dozen, terrines en kant-en-klaarmaaltijden."
    ]
  },
