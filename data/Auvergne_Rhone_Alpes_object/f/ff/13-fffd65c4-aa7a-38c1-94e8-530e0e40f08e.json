  "rdfs:comment": {
    "de": [
      "Mathilde SPX stellt ihre Talente in Ihren Dienst und bietet Ihnen fotografische Leistungen für verschiedene Anlässe (Passfotos, Hochzeiten, Porträts, Mutterschaft, Foto- und Videobooth, Iris)."
    ],
    "en": [
      "Mathilde SPX puts her talents at your service and offers photographic services for a variety of occasions (passport photos, weddings, portraits, maternity, photobooths and videobooths, irises)."
    ],
    "it": [
      "Mathilde SPX mette il suo talento al vostro servizio e offre servizi fotografici per diverse occasioni (fototessere, matrimoni, ritratti, foto di maternità, photobooth e videobooth, iris)."
    ],
    "fr": [
      "Mathilde SPX met ses talents à votre service et vous propose des prestations photographiques pour diverses occasions (photo d'identité, mariage, portrait, maternité, photobooth et vidéobooth, iris)."
