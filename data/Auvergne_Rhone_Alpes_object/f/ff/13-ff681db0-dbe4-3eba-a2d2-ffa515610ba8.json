  "rdfs:comment": {
    "de": [
      "Der Lesezirkel bietet jeden zweiten Donnerstag im Monat um 16 Uhr einen Literaturaustausch an, der für alle Bücherfreunde offen ist."
    ],
    "en": [
      "Every 2nd Thursday of the month, at 4pm, the Reading Circle offers a literary sharing session, open to all book lovers."
    ],
    "it": [
      "Ogni secondo giovedì del mese, alle 16.00, il Circolo di lettura offre una sessione di condivisione letteraria, aperta a tutti gli amanti dei libri."
    ],
    "fr": [
      "Le Cercle de lecture vous propose, chaque 2ème jeudi du mois, à 16h, une séance de partage littéraire, ouverte à tout amis des livres."
    ],
    "nl": [
      "Elke 2e donderdag van de maand om 16.00 uur biedt de Leeskring een literaire uitwisselingssessie die openstaat voor alle boekenliefhebbers."
    ],
    "es": [
      "Cada segundo jueves de mes, a las 16.00 horas, el Círculo de Lectura ofrece una sesión de intercambio literario, abierta a todos los amantes de los libros."
