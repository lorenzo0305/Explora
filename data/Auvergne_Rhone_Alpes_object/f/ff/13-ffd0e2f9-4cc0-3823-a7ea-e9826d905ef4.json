  "rdfs:comment": {
    "de": [
      "Concert Mix, Tischfußball, Craft Beer, Cocktail, Rumerie\r\nTapas, Pizzas\r\nIm Sommer verwandelt die Bar ihre Terrasse in eine gemütliche Bar, wo man sich nach einer Wanderung entspannen kann?\r\nJeden Sonntag: Tischfußballturnier (kostenlos)"
    ],
    "en": [
      "Concert Mix, table soccer, craft beer, Cocktail, Rum shop\nTapas, pizzas\nIn summer, the bar turns its terrace into a cosy bar for lounging after a good hike...\nEvery Sunday: table soccer tournament (free)"
    ],
    "it": [
      "Concerto Mix, calcio balilla, birra artigianale, cocktail, rum bar\nTapas, pizze\nIn estate, la terrazza del bar si trasforma in un accogliente locale dove rilassarsi dopo una bella passeggiata...\nOgni domenica: torneo di calcio balilla (gratuito)"
    ],
    "fr": [
      "Concert Mix, babyfoot, craft beer, Cocktail, Rhumerie\r\nTapas, pizzas\r\nL’été le bar aménage sa terrasse en cosy bar pour se prélasser après une bonne randonnée…\r\nTous les dimanches : tournoi de babyfoot (gratuit)"
    ],
    "nl": [
      "Concert-café\r\nWiFi-verbinding"
    ],
    "es": [
      "Concert Mix, futbolín, cerveza artesanal, cócteles, bar de ron\r\nTapas, pizzas\r\nEn verano, la terraza se transforma en un acogedor bar donde relajarse después de un buen paseo?\r\nTodos los domingos: torneo de futbolín (gratuito)"
    ]
