  "rdfs:comment": {
    "de": [
      "Die Ferme Saint Maurice liegt in Saillans in der Drôme am Rande des Diois und produziert in biologischem Anbau französische Rot- und Weißweine sowie Thymian für die Kräutermedizin."
    ],
    "en": [
      "Located in Saillans in the Drôme, at the gateway to the Diois region, Ferme Saint Maurice is an organic producer of French red and white wines, as well as thyme for herbal medicine."
    ],
    "it": [
      "Situata a Saillans, nella Drôme, alle porte della regione del Diois, la Ferme Saint Maurice produce vini rossi e bianchi francesi e timo per la fitoterapia con metodi di agricoltura biologica."
    ],
    "fr": [
      "Située dans la Drôme à Saillans aux portes du Diois, la Ferme Saint Maurice produit en Agriculture Biologique  des vins de France Rouge et Blanc ainsi que du thym destiné à l’herboristerie."
    ],
    "es": [
      "Situada en Saillans, en la Drôme, a las puertas de la región de Diois, la Ferme Saint Maurice produce vinos tintos y blancos franceses y tomillo para herboristería con métodos de agricultura ecológica."
    ],
    "nl": [
      "Ferme Saint Maurice, gelegen in Saillans in de Drôme, aan de poort van de Diois regio, produceert Franse rode en witte wijnen en tijm voor kruidengeneeskunde met behulp van biologische landbouwmethoden."
    ]
  },
  "rdfs:label": {
