  "rdfs:comment": {
    "de": [
      "Nutzen Sie die verschiedenen Flüsse von Megève: Foron de Megève, Planay, Nant Cordie, Glapet, Rau de Cassioz (Wasserläufe der ersten Kategorie). Führerschein Savoie/Haute-Savoie bei Megève Tourisme erhältlich, Erwachsene und Kinder."
    ],
    "en": [
      "Many rivers at Megève : le Foron de Megève, le Planay, le Nant Cordie, le Glapet, le Rau de Cassioz (first class rivers) Fishing permit card Savoie/Haute-Savoie sold at Megève Tourisme."
    ],
    "it": [
      "Approfittate dei vari fiumi di Megève: il Foron de Megève, il Planay, il Nant Cordie, il Glapet, il Rau de Cassioz... (corsi d'acqua di prima categoria). Licenza Savoia/Alta Savoia in vendita presso Megève Tourisme, per adulti e bambini."
    ],
    "fr": [
      "Profitez des diverses rivières de Megève : le Foron de Megève, le Planay, le Nant Cordie, le Glapet, le Rau de Cassioz (cours d'eau de première catégorie). Permis Savoie/Haute-Savoie en vente à Megève Tourisme, adulte et enfant."
    ],
    "nl": [
      "Profiteer van de verschillende rivieren in Megève: het Foron de Megève, de Planay, de Nant Cordie, de Glapet, de Rau de Cassioz (waterloop van de eerste categorie). Vergunningen Savoie/Haute-Savoie te koop bij Megève Tourism, volwassenen en kinderen."
    ],
    "es": [
      "Aproveche los diferentes ríos de Megève: el Foron de Megève, el Planay, el Nant Cordie, el Glapet, el Rau de Cassioz (curso de agua de primera categoría). Permisos de Savoie/Haute-Savoie a la venta en Megève Turismo, adultos y niños."
    ]
  },
