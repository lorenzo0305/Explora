  "rdfs:comment": {
    "de": [
      "Willkommen im Link, Ihrem unumgänglichen Bar-Restaurant für gesellige und festliche Abende! Es ist der ideale Ort, um köstliche Getränke in einer trendigen Atmosphäre zu genießen. Der Restaurantbereich wird von Dienstag bis Freitag auch mittags angeboten."
    ],
    "en": [
      "Welcome to the Link, your go-to bar-restaurant for convivial, festive evenings! The ideal place to enjoy delicious drinks in a trendy atmosphere. The restaurant is also open for lunch from Tuesday to Friday."
    ],
    "it": [
      "Benvenuti al Link, il vostro bar-ristorante di riferimento per serate amichevoli e festose! È il luogo ideale per gustare deliziosi drink in un'atmosfera di tendenza. Il ristorante è aperto anche a pranzo dal martedì al venerdì."
    ],
    "fr": [
      "Bienvenue au Link, votre bar-restaurant incontournable pour des soirées conviviales et festives ! C'est l’endroit idéal pour savourer de délicieuses boissons dans une atmosphère branchée. Espace restaurant également proposé les midis du mardi au vendredi."
    ],
    "nl": [
      "Welkom bij Link, jouw go-to bar-restaurant voor gezellige, feestelijke avonden! Het is de perfecte plek om te genieten van heerlijke drankjes in een trendy sfeer. Het restaurant is ook geopend voor lunch van dinsdag tot en met vrijdag."
    ],
    "es": [
      "Bienvenido a Link, tu bar-restaurante de referencia para veladas agradables y festivas Es el lugar perfecto para disfrutar de deliciosas bebidas en un ambiente de moda. El restaurante también abre al mediodía de martes a viernes."
    ]
  },
