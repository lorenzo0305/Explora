  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cfe9ae77-5f13-36a1-92ba-ab0c12578f7f",
      "dc:description": {
        "de": [
          "Die Schule Jean Moulin in Etaples-sur-Mer organisiert das berühmte Lottospiel.\nVerbringen Sie eine schöne Zeit mit der Familie oder mit Freunden und versuchen Sie, schöne Preise zu gewinnen."
        ],
        "en": [
          "The Jean Moulin school in Etaples-sur-mer organizes the famous lotto game.\nCome and have a good time with family and friends, and try to win some great prizes."
        ],
        "it": [
          "La scuola Jean Moulin di Etaples-sur-mer organizza il suo famoso gioco del lotto.\nVenite a divertirvi con la vostra famiglia o i vostri amici e provate a vincere dei fantastici premi."
        ],
        "fr": [
          "L'école Jean Moulin d'Etaples-sur-mer organise le célèbre jeu de loto.\nVenez passer un bon moment en famille ou entre amis pour tenter de remporter de jolis lots."
        ],
        "es": [
          "La escuela Jean Moulin de Etaples-sur-mer organiza su famoso juego de lotería.\nVen a pasar un buen rato con tu familia o amigos e intenta ganar magníficos premios."
        ],
        "nl": [
          "De Jean Moulin-school in Etaples-sur-mer organiseert haar beroemde lottospel.\nKom gezellig langs met je familie of vrienden en probeer mooie prijzen te winnen."
        ]
      },
