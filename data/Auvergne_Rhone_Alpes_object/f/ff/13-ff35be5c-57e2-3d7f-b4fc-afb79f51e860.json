  "rdfs:comment": {
    "de": [
      "Familienbetrieb für Olivenanbau, biologische Landwirtschaft, außergewöhnliches Terroir, anerkanntes Know-how (mehrfacher Medaillengewinner auf der CGA in Paris). Verkauf ab Hof von Produkten mit geschützter Ursprungsbezeichnung Nyons: Oliven, Olivenöl, Affinade und verschiedene Tapenaden, Wein."
    ],
    "en": [
      "Family-owned olive-growing estate, organic farming, exceptional \"terroir\", recognized know-how (several times awarded by the CGA de Paris). On-site sale of PDO Nyons products: olives, olive oil, affinade, various tapenades and wine."
    ],
    "it": [
      "Azienda olivicola a conduzione familiare, coltivata con metodo biologico, terroir eccezionale, competenza riconosciuta (vincitrice di diverse medaglie). Vendita in azienda dei prodotti DOP di Nyons: olive, olio d'oliva, Affinade e tapenades varie, vino Côtes du Rhône."
    ],
    "fr": [
      "Domaine oléicole familial, en agriculture biologique, terroir d'exception, savoir-faire reconnu (plusieurs fois médaillé). Vente à la ferme des produits AOP Nyons : olives, huile d'olive, Affinade et tapenades diverses, vin Côtes du Rhône."
    ],
    "nl": [
      "Familiebedrijf, olijfolieproducent, uitzonderlijk grondgebied, erkende expertise (meerdere medailles van het CGA in Parijs). Directe verkoop  op het domein van AOP Nyons producten: olijven, olie, olijvencreme en het nieuwe 'douceur d'olive'."
    ],
    "es": [
      "Explotación familiar de olivicultura ecológica, terruño excepcional, saber hacer reconocido (varias medallas). Venta en la explotación de los productos de la DOP Nyons: aceitunas, aceite de oliva, Affinade y tapenades variados, vino Côtes du Rhône."
    ]
  },
