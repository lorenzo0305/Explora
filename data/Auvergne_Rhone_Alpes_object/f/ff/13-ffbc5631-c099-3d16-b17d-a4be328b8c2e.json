  "rdfs:comment": {
    "de": [
      "28 km von der Autobahn A75 entfernt, im Kasino von Chaudes-Aigues, vibrieren Sie in der Zeit der Spielautomaten für garantierte Sensationen\r\nDas ganze Jahr über an sieben Tagen in der Woche geöffnet."
    ],
    "en": [
      "28km from the A75 freeway, at the Chaudes-Aigues casino, experience the thrill of slot machines\r\nOpen 7 days a week, all year round."
    ],
    "it": [
      "A 28 km dall'autostrada A75, al casinò di Chaudes-Aigues provate il brivido delle slot machine\r\nAperto 7 giorni su 7, tutto l'anno."
    ],
    "fr": [
      "À 28km de l'autoroute A75, au casino de Chaudes-Aigues, vibrez au temps des machines à sous pour des sensations garanties \r\nOuvert 7j/7, toute l'année."
    ],
    "nl": [
      "Op 28 km van de snelweg A75 kun je in het casino Chaudes-Aigues genieten van de spanning van gokautomaten\r\n7 dagen per week geopend, het hele jaar door."
    ],
    "es": [
      "A 28 km de la autopista A75, en el casino de Chaudes-Aigues, viva la emoción de las máquinas tragaperras\r\nAbierto 7 días a la semana, todo el año."
    ]
  },
