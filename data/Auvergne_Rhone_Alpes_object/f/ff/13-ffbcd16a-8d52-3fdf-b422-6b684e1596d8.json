  "rdfs:comment": {
    "de": [
      "Die alte romanische Kirche wurde in den 1870er Jahren durch ein großes neogotisches Gebäude ersetzt. Der Architekt war Alfred Berruyer, ein Schüler von Viollet-le-Duc."
    ],
    "en": [
      "The old Romanesque church was replaced during the 1870s by an enormous neo-Gothic structure built by Alfred Berruyer who was a student of the architect Viollet-le-Duc."
    ],
    "it": [
      "L'antica chiesa romanica fu sostituita negli anni Settanta del XIX secolo da un grande edificio neogotico. L'architetto era Alfred Berruyer, allievo di Viollet-le-Duc."
    ],
    "fr": [
      "L'ancienne église romane fut remplacée dans les années 1870 par un vaste édifice néo-gothique. L'architecte était Alfred Berruyer, élève de Viollet-le-Duc."
    ],
    "es": [
      "La antigua iglesia románica fue sustituida en la década de 1870 por un gran edificio neogótico. El arquitecto fue Alfred Berruyer, alumno de Viollet-le-Duc."
    ],
    "nl": [
      "De oude Romaanse kerk werd in de jaren 1870 vervangen door een groot neogotisch gebouw. De architect was Alfred Berruyer, een leerling van Viollet-le-Duc."
    ]
  },
