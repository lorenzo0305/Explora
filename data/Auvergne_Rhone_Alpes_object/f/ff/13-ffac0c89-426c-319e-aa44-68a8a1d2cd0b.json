  "rdfs:comment": {
    "de": [
      "Ab-Hof-Verkauf von Kräutertees, Hydrolaten, Pflanzenextrakten sowie Wollartikeln aus unserer Alpaka-Zucht: Mützen, Schals, Ponchos, ...Nur nach Voranmeldung!"
    ],
    "en": [
      "Sale at the farm of herbal teas, hydrosols, plant extracts, as well as woolen articles from our Alpaca breeding: hats, scarves, ponchos, ...Only by appointment!"
    ],
    "it": [
      "Un'ampia gamma di tisane, aromi, infusi e idrolati di qualità. Dai semi agli idrosol ed estratti di piante. Offriamo anche prodotti della nostra fattoria di alpaca, realizzati in laboratori in Francia."
    ],
    "fr": [
      "Large gamme de plantes à tisanes, aromates, infusettes et hydrolats de qualité. De la graine au sachet à l’hydrolat ou à l’extrait végétal. Nous proposons aussi des produits issus de notre élevage d'alpagas, confectionnés dans des ateliers en France."
    ],
    "es": [
      "Una amplia gama de tisanas, aromáticas, infusiones e hidrosoles de calidad. Desde semillas hasta hidrosoles y extractos de plantas. También ofrecemos productos de nuestra granja de alpacas, elaborados en talleres de Francia."
    ],
    "nl": [
      "Een breed assortiment kruidentheeën, aromatische kruiden, infusies en hydrolaten van hoge kwaliteit. Van zaden tot hydrosolen en plantenextracten. We bieden ook producten van onze alpacaboerderij, gemaakt in workshops in Frankrijk."
    ]
  },
  "rdfs:label": {
    "en": [
      "Catherine and Vincent Segretain"
    ],
    "fr": [
      "Ouma Le Chemin des Plantes et produits en laine d'Alpaga"
    ]
  },
