  "rdfs:comment": {
    "de": [
      "Im Herzen von Avoriaz gelegen, empfängt Sie das La Boule de Neige in einer warmen und freundlichen Atmosphäre. Es ist auf savoyische Küche spezialisiert (Raclette, Fondue, Tartiflette, Galgen), bietet aber auch eine große Auswahl an Pizzas und Burgern"
    ],
    "en": [
      "Located in the heart of Avoriaz, La Boule de Neige welcomes you in a warm and friendly atmosphere. Specializing in traditional Savoyard cuisine (raclette, fondue, tartiflette, potence), it also offers a wide selection of pizzas and burgers."
    ],
    "it": [
      "Situato nel cuore di Avoriaz, La Boule de Neige offre un'accoglienza calorosa e amichevole. Specializzato in cucina savoiarda (raclette, fondue, tartiflette, potence), offre anche un'ampia scelta di pizze e hamburger"
    ],
    "fr": [
      "Situé en plein cœur d’Avoriaz, La Boule de Neige vous accueille dans une ambiance chaleureuse et conviviale. Spécialisé en cuisine savoyarde  (raclette, fondue, tartiflette, potence), il propose également une large sélection de pizzas et burgers"
    ],
    "es": [
      "Situado en el corazón de Avoriaz, La Boule de Neige ofrece una acogida cálida y acogedora. Especializado en cocina saboyana (raclette, fondue, tartiflette, potence), también ofrece una amplia selección de pizzas y hamburguesas"
    ],
    "nl": [
      "Gelegen in het hart van Avoriaz verwelkomt La Boule de Neige u in een warme en gezellige sfeer. Gespecialiseerd in traditionele Savoyarde keuken (raclette, fondue, tartiflette, potence), biedt het ook een ruime selectie pizzas en burgers."
    ]
  },
