  "rdfs:comment": {
    "de": [
      "Etablissement, das für alle Momente des Lebens in aller Einfachheit gemacht ist. Französische und traditionelle Küche. Verwendung von frischen und lokalen Produkten. Fleisch aus Frankreich. Hausgemachte Rezepte für Qualitätsprodukte."
    ],
    "en": [
      "Establishment made for all the moments of life in all simplicity. Traditional French cuisine. Use of fresh, local produce. Meat from France. Home-made recipes for quality products."
    ],
    "it": [
      "Un locale fatto per tutti i momenti della vita in tutta semplicità. Cucina tradizionale francese. Utilizzo di prodotti freschi e locali. Carni provenienti dalla Francia. Ricette fatte in casa per prodotti di qualità."
    ],
    "fr": [
      "Établissement fait pour tous les moments de la vie en toute simplicité. Cuisine française et traditionnelle. Utilisation de produits frais et locaux. Viande origine France. Recette \"fait maison\" pour des produits de qualité."
    ],
    "es": [
      "Un establecimiento hecho para todos los momentos de la vida con toda sencillez. Cocina tradicional francesa. Utilización de productos frescos y locales. Carnes de Francia. Recetas caseras para productos de calidad."
    ],
    "nl": [
      "Een etablissement gemaakt voor alle momenten van het leven in alle eenvoud. Traditionele Franse keuken. Gebruik van verse, lokale producten. Vlees uit Frankrijk. Huisgemaakte recepten voor kwaliteitsproducten."
    ]
  },
  "rdfs:label": {
