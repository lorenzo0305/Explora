  "rdfs:comment": {
    "de": [
      "In den Frühlingsferien öffnet das Museum für Geschichte und Archäologie die Tore seines Parks und empfängt Sie zu einer Familienaktivität."
    ],
    "en": [
      "For the Spring vacations, the Museum of History and Archaeology opens the doors of its park and welcomes you for a family activity."
    ],
    "it": [
      "Per le vacanze di primavera, il Museo di Storia e Archeologia apre le porte del suo parco e vi accoglie per un'attività in famiglia."
    ],
    "fr": [
      "Pour les vacances de Printemps, le Musée d'Histoire et d’Archéologie ouvre les portes de son parc et vous accueille pour une activité en famille."
    ],
    "nl": [
      "Voor de voorjaarsvakantie opent het Museum voor Geschiedenis en Archeologie de deuren van zijn park en verwelkomt je voor een gezinsactiviteit."
    ],
    "es": [
      "Para las vacaciones de primavera, el Museo de Historia y Arqueología le abre las puertas de su parque y le acoge para una actividad familiar."
    ]
