  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f161c383-feba-398c-9b87-4a4cbf5e1720",
      "dc:description": {
        "de": [
          "Was ist die Aufgabe? An Ästen rütteln, Steine heben, durch wilde Gräser streifen? Kurz gesagt, sich in einen Forscher zu verwandeln, der nach den kleinen Tieren sucht, die das Brachland bevölkern."
        ],
        "en": [
          "The mission? Shake branches, lift stones, wander through wild grasses? In short, become an explorer in search of the little animals that inhabit the wasteland."
        ],
        "it": [
          "La missione? Scuotere rami, sollevare pietre, vagare tra l'erba selvatica? Insomma, diventare un esploratore alla ricerca degli animaletti che popolano la terra desolata."
        ],
        "fr": [
          "La mission ? Secouer les branches, soulever les pierres, parcourir les herbes folles … Bref, se transformer en explorateur à la recherche des petits animaux qui peuplent les friches."
        ],
        "es": [
          "¿La misión? ¿Sacudir las ramas, levantar las piedras, vagar entre la maleza? En definitiva, convertirse en un explorador en busca de los animalitos que habitan el páramo."
        ],
        "nl": [
          "De missie? Takken schudden, stenen optillen, door wild gras dwalen? Kortom, word een ontdekkingsreiziger op zoek naar de kleine dieren die de woestenij bewonen."
        ]
      },
