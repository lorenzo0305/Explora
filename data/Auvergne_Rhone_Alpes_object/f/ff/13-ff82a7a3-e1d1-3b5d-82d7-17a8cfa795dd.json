  "rdfs:comment": {
    "de": [
      "Das Restaurant AU COUP DE CŒUR bietet Ihnen jeden Tag eine Vielfalt an traditionellen und authentischen Rezepten, die je nach Lust und Laune und Frische der Produkte variieren."
    ],
    "en": [
      "The AU COUP DE CŒUR restaurant offers a daily variety of traditional and authentic recipes that vary according to your tastes and the freshness of the produce."
    ],
    "it": [
      "Il ristorante AU COUP DE C?UR vi offre una varietà di ricette tradizionali e autentiche che variano a seconda dei vostri desideri e della freschezza dei prodotti."
    ],
    "fr": [
      "Le restaurant AU COUP DE CŒUR vous propose chaque jour une variété de recettes traditionnelles et authentiques qui varient selon vos envies et la fraîcheur des produits."
    ],
    "es": [
      "Todos los días, el restaurante AU COUP DE CŒUR le ofrece una variedad de recetas tradicionales y auténticas que varían en función de sus gustos y de la frescura de los productos."
    ],
    "nl": [
      "Het restaurant AU COUP DE CŒUR biedt u elke dag een verscheidenheid aan traditionele en authentieke recepten, die variëren naargelang uw wensen en de versheid van de producten."
    ]
  },
