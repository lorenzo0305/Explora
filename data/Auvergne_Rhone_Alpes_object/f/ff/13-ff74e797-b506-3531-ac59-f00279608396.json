  "rdfs:comment": {
    "de": [
      "Wenn Sie bei Tonton essen, lassen Sie alle unsere kleinen Produzenten für sich arbeiten, danke! Alle unsere Desserts stammen aus der Konditorei \"Au Macaron de Massiac\", einer eingetragenen Marke."
    ],
    "en": [
      "When you come to eat at Tonton's, you're putting all our small producers to work, thank you! All our desserts come from the patisserie \"Au Macaron de Massiac\", a registered trademark."
    ],
    "it": [
      "Quando venite a mangiare da Tonton's, mettete al lavoro tutti i nostri piccoli produttori, grazie! Tutti i nostri dessert provengono dalla pasticceria \"Au Macaron de Massiac\", un marchio registrato."
    ],
    "fr": [
      "Quand vous venez manger chez Tonton, c'est tous nos petits producteurs que vous faites travailler, merci ! Tous nos desserts proviennent de la pâtisserie \"Au Macaron de Massiac\", marque déposée."
    ],
    "es": [
      "Cuando vienes a comer a Tonton's, pones a trabajar a todos nuestros pequeños productores, ¡gracias! Todos nuestros postres proceden de la pastelería \"Au Macaron de Massiac\", una marca registrada."
    ],
    "nl": [
      "Als je bij Tonton komt eten, zet je al onze kleine producenten aan het werk, dank je wel! Al onze desserts komen uit de patisserie \"Au Macaron de Massiac\", een gedeponeerd handelsmerk."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tonton le Foirail"
    ],
    "fr": [
      "Tonton le Foirail"
    ]
  },
