  "rdfs:comment": {
    "de": [
      "VTTAE-Ausfahrt (elektrische Unterstützung) zu einem bestimmten Thema, Fahrkurs und Biker-Kurs unter Anleitung eines staatlich geprüften MCF-Führers (französischer Fahrradlehrer)."
    ],
    "en": [
      "Absolutely passionnate about Forez and mountain biking, I propose you different activities like thematic hikes, introduction to electric mountain bike, night-time tour, downhill mountain bike lessons…\r\nFor young and old, parasports (disabled persons), beginner, experienced sportsman, I adapt my offers to everybody!\r\nI can come on demand, according to your needs."
    ],
    "it": [
      "Uscite a tema VTTAE (assistenza elettrica), corsi di equitazione e corsi per motociclisti condotti da un MCF (istruttore-guida francese di ciclismo) qualificato dallo Stato."
    ],
    "fr": [
      "Sortie VTTAE (assistance électrique) à thème, stage de pilotage et stage biker encadrés par un moniteur-guide MCF (moniteur cycliste français) diplômé d'état."
    ],
    "nl": [
      "Thema-uitstapjes VTTAE (elektrisch ondersteund), rijcursussen en fietscursussen onder leiding van een door de staat gediplomeerde MCF (Franse fietsinstructeur-gids)."
    ],
    "es": [
      "Salidas temáticas VTTAE (con asistencia eléctrica), cursos de equitación y cursos para ciclistas dirigidos por un MCF (monitor-guía de ciclismo francés) titulado por el Estado."
    ]
  },
  "rdfs:label": {
    "en": [
      "Forez bike school with Félix Groizard"
    ],
    "fr": [
      "Félix Groizard - moniteur VTT"
    ]
  },
