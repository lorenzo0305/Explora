  "rdfs:comment": {
    "de": [
      "Der Platz befindet sich in der Nähe des Schlosses von Goutelas und überragt das Anwesen. Er kann über das Schloss gemietet werden."
    ],
    "en": [
      "The court is located close to the Château de Goutelas enclosure, it overlooks the estate. It is available for rent, which can be arranged through the Château."
    ],
    "it": [
      "La corte si trova vicino allo Château de Goutelas, con vista sulla tenuta. È disponibile a noleggio presso lo Château."
    ],
    "fr": [
      "Le court est situé à proximité de l'enceinte du Château de Goutelas, il surplombe le domaine. Disponible à la location, celle-ci s'effectue auprès du Château."
    ],
    "nl": [
      "Het hof ligt bij het Château de Goutelas, met uitzicht op het landgoed. Het is te huur bij het kasteel."
    ],
    "es": [
      "El patio está situado cerca del Château de Goutelas, con vistas a la finca. Se puede alquilar en el Château."
    ]
  },
