  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Familienbetrieb, der schwarze Kirschen (guignes) und Walnüsse produziert, die zu Saft, Konfitüre, Kirschwasser, Sahne und Ratafia verarbeitet werden, mit Direktverkauf ab Hof."
    ],
    "en": [
      "Family farm producing black cherries (guignes) and walnuts, processed into juice, jam, kirsch, cream and ratafia, with direct sales at the farm."
    ],
    "it": [
      "Azienda agricola a conduzione familiare che produce ciliegie nere (guignes) e noci, trasformate in succo, marmellata, kirsch, crema e ratafia, con vendita diretta in azienda."
    ],
    "fr": [
      "Exploitation agricole familiale produisant cerises noires (guignes) et noix, transformées en jus, confitures, kirsch, crème et ratafia, avec vente directe à la ferme."
    ],
    "nl": [
      "Familieboerderij die zwarte kersen (guignes) en walnoten produceert, verwerkt tot sap, jam, kirsch, room en ratafia, met rechtstreekse verkoop vanaf de boerderij."
    ],
    "es": [
      "Explotación familiar de cerezas negras (guignes) y nueces, transformadas en zumo, mermelada, kirsch, nata y ratafía, con venta directa desde la explotación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Noix et Cerises en Fête"
    ]
  },
