  "rdfs:comment": {
    "de": [
      "15 km nördlich von Montluçon, auf dem Gelände eines alten Wasserbahnhofs, können Sie die Zeit zurückdrehen und die fabelhafte Geschichte des Canal de Berry von seinem Durchstich bis zu seiner Herabstufung entdecken."
    ],
    "en": [
      "15km north of Montluçon, on the site of a former water station, step back in time and discover the fabulous history of the Canal de Berry, from the time it was pierced to its decommissioning."
    ],
    "it": [
      "A 15 km a nord di Montluçon, sul sito di un'antica stazione idrica, fate un salto indietro nel tempo e scoprite la favolosa storia del Canal de Berry, dalla sua apertura alla sua dismissione."
    ],
    "fr": [
      "À 15km au nord de Montluçon, sur le site d'une ancienne gare d'eau, remontez le temps et découvrez la fabuleuse histoire du Canal de Berry depuis son percement jusqu'à son déclassement."
    ],
    "es": [
      "A 15 km al norte de Montluçon, en el emplazamiento de una antigua estación fluvial, retroceda en el tiempo y descubra la fabulosa historia del Canal de Berry desde su inauguración hasta su desmantelamiento."
    ],
    "nl": [
      "15 km ten noorden van Montluçon, op de plek van een voormalig waterstation, stap je terug in de tijd en ontdek je de fabelachtige geschiedenis van het Canal de Berry vanaf het moment dat het werd geopend tot het moment dat het uit bedrijf werd genomen."
    ]
  },
  "rdfs:label": {
