  "rdfs:comment": {
    "de": [
      "Lyon & Grace - Kuratieren Sie einzigartige Momente in Lyon. Wir kreieren maßgeschneiderte Touren, die Sie in Künstlerateliers, Kunstgalerien, geheimes religiöses Erbe und normalerweise unzugängliche Orte eintauchen lassen."
    ],
    "en": [
      "Lyon & Grace - Curating unique moments in Lyon. We create tailor-made itineraries, true immersions in the heart of artists? studios, art galleries, secret religious heritage and places that are usually inaccessible."
    ],
    "it": [
      "Lyon & Grace - Curiamo momenti unici a Lione. Creiamo itinerari su misura, immergendovi in studi di artisti, gallerie d'arte, patrimoni religiosi segreti e luoghi solitamente inaccessibili."
    ],
    "fr": [
      "Lyon & Grace - Curating unique moments in Lyon. Nous créons des parcours sur-mesure, véritables immersions au cœur d’ateliers d’artistes, galeries d’art, du patrimoine religieux secret et des lieux habituellement inaccessibles."
    ],
    "nl": [
      "Lyon & Grace - Creëert unieke momenten in Lyon. We maken routes op maat en dompelen je onder in kunstenaarsateliers, kunstgalerijen, geheim religieus erfgoed en plekken die normaal gesproken ontoegankelijk zijn."
    ],
    "es": [
      "Lyon & Grace - Comisariado de momentos únicos en Lyon. Creamos itinerarios a medida, sumergiéndole en estudios de artistas, galerías de arte, patrimonio religioso secreto y lugares habitualmente inaccesibles."
    ]
  },
