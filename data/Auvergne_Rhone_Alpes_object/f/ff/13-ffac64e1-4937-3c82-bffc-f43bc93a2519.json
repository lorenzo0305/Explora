  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von einem angenehmen und dynamischen Team empfangen. Die abwechslungsreiche Speisekarte bietet Gerichte aus verschiedenen Ländern. Hausgemachtes, gute und reichhaltige Mahlzeiten und ein Service mittags und abends."
    ],
    "en": [
      "Let yourself be welcomed by a pleasant and dynamic team. The varied menu offers dishes from different countries. Home-cooked, hearty meals, served at lunchtime and in the evening."
    ],
    "it": [
      "Lasciatevi accogliere da un team piacevole e dinamico. Il menu vario offre piatti di diversi paesi. Pasti casalinghi e abbondanti, serviti a pranzo e alla sera."
    ],
    "fr": [
      "Laissez-vous accueillir par une équipe agréable et dynamique. La carte très variée propose des plats de différents pays. Du fait maison, de bons repas copieux, et un service le midi et le soir."
    ],
    "nl": [
      "Laat u verwelkomen door een aangenaam en dynamisch team. Het gevarieerde menu biedt gerechten uit verschillende landen. Huisbereide, stevige maaltijden, 's middags en 's avonds geserveerd."
    ],
    "es": [
      "Déjese acoger por un equipo agradable y dinámico. La variada carta ofrece platos de diferentes países. Comida casera y abundante, servida al mediodía y por la noche."
    ]
  },
