  "rdfs:comment": {
    "de": [
      "Das Hotel liegt 300m von den Skiliften entfernt, hoteleigene Minibusse pendeln zu den Pisten. Schwimmbad und SPA, Spielzimmer mit Billard, Bar-Lounge mit Kamin, die auf eine Panoramaterrasse mit Blick auf den Nationalpark Ecrins führt."
    ],
    "en": [
      "Located 300m from the ski lifts, the hotel's minibuses shuttle to access the slopes. Swimming pool and SPA, games room with billiards, lounge bar and fireplace, opening onto a panoramic terrace on the Ecrins National Park."
    ],
    "it": [
      "Situato a 300 metri dagli impianti di risalita, l'hotel dispone di un minibus che accompagna gli ospiti sulle piste. Piscina e SPA, sala giochi con biliardo, bar-lounge e camino, che si apre su una terrazza panoramica con vista sul Parco Nazionale degli Ecrins."
    ],
    "fr": [
      "Situé à 300m des remontées mécaniques, des minibus de l’hôtel font la navette pour accéder aux pistes. Piscine et SPA, salle de jeux avec billard, bar-salon et cheminée, donnant sur une terrasse panoramique sur le Parc National des Ecrins."
    ],
    "es": [
      "Situado a 300 metros de los remontes, el minibús del hotel lleva a los huéspedes a las pistas. Piscina y SPA, sala de juegos con billar, bar-salón y chimenea, que se abre a una terraza panorámica con vistas al Parque Nacional de Ecrins."
    ],
    "nl": [
      "Het hotel ligt op 300 meter van de skiliften en de eigen minibusjes brengen de gasten naar de pistes. Zwembad en SPA, speelzaal met biljart, bar-lounge en open haard, uitkomend op een panoramisch terras met uitzicht op het Parc National des Ecrins."
    ]
  },
