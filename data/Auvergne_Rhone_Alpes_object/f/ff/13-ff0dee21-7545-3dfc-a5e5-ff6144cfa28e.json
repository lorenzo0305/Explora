  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf eine Reise in einen Strudel aus Musik, Tanz und guter Laune vor - mit \"Belles, Belles, Belles\", einer prickelnden Show! Auf der Bühne stehen erhabene Stimmen und schwungvolle Choreografien."
    ],
    "en": [
      "Get ready for a whirlwind journey of music, dance and good humor with \"Belles, Belles, Belles\", a sparkling show! On stage, sublime voices and playful choreography."
    ],
    "it": [
      "Preparatevi a un viaggio vorticoso di musica, danza e buonumore con \"Belles, Belles, Belles\", uno spettacolo scintillante! Sul palco, voci sublimi e coreografie giocose."
    ],
    "fr": [
      "Préparez-vous à un voyage dans un tourbillon de musique, de danse et de bonne humeur avec « Belles, Belles, Belles », un spectacle pétillant ! Sur scène, des voix sublimes et des chorégraphies enjouées."
    ],
    "es": [
      "Prepárese para un viaje relámpago de música, baile y buen humor con \"Belles, Belles, Belles\", ¡un espectáculo chispeante! En el escenario, voces sublimes y coreografías juguetonas."
    ],
    "nl": [
      "Bereid je voor op een wervelende reis vol muziek, dans en humor met \"Belles, Belles, Belles\", een wervelende show! Op het podium sublieme stemmen en speelse choreografie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Comédie Musicale: Belles, Belles, Belles"
    ]
  },
