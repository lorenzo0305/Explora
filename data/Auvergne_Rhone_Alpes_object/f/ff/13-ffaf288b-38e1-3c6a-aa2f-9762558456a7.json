  "rdfs:comment": {
    "de": [
      "Verkauf von Bio-Landkäse wie \"Le Brancouny\", ''und verschiedenen Milchprodukten (Milch, Frischkäse, Joghurt, Butter ...)\r\n\r\nVerkauf auf den Märkten von Saugues am Freitag und Brioude am Samstag."
    ],
    "en": [
      "Sales of organic local cheeses such as \"Le Brancouny\", and various dairy products (milk, fromage frais, yoghurt, butter, etc.)\r\n\r\nSales at Saugues market on Fridays and Brioude market on Saturdays."
    ],
    "it": [
      "Vendita di formaggi biologici locali, come \"Le Brancouny\", e di vari prodotti caseari (latte, fromage frais, yogurt, burro, ecc.)\r\n\r\nVendita al mercato di Saugues il venerdì e al mercato di Brioude il sabato."
    ],
    "fr": [
      "Ventes de fromages bio de pays tel que \"Le Brancouny\", ''et divers produits laitiers (lait,fromage frais, yaourt, beurre...)\r\n\r\nVente sur les marchés de Saugues le vendredi et de Brioude le samedi."
    ],
    "nl": [
      "Verkoop van biologische lokale kazen zoals \"Le Brancouny\" en verschillende zuivelproducten (melk, fromage frais, yoghurt, boter, enz.)\r\n\r\nVerkoop op de markt van Saugues op vrijdag en de markt van Brioude op zaterdag."
    ],
    "es": [
      "Venta de quesos locales ecológicos, como \"Le Brancouny\", y diversos productos lácteos (leche, queso fresco, yogur, mantequilla, etc.)\r\n\r\nVenta en el mercado de Saugues los viernes y en el de Brioude los sábados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme du Brancouny"
    ]
  },
