  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aa003fbe-a091-38b3-a5e6-54c284891863",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Freitag von 9:00 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\n\nSamstags von 9.00 bis 12.30 Uhr\n\nSonntag geschlossen\n\nAbholung:\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Friday, 9:00 am to 12:30 pm and 2:00 pm to 7:00 pm\n\nSaturday from 9h00 to 12h30\n\nClosed on Sunday\n\nPick-up :\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDal lunedì al venerdì, dalle 9.00 alle 12.30 e dalle 14.00 alle 19.00\n\nSabato dalle 9.00 alle 12.30\n\nChiuso la domenica\n\nRitiro:\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au vendredi de 9h00 à 12h30 et de 14h00 à 19h00\n\nLe samedi de 9h00 à 12h30\n\nFermeture le dimanche\n\nRetrait :\nAux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot vrijdag van 9.00 tot 12.30 uur en van 14.00 tot 19.00 uur\n\nZaterdag van 9.00 tot 12.30 uur\n\nZondag gesloten\n\nAfhalen:\nTijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a viernes, de 9.00 a 12.30 h. y de 14.00 a 19.00 h\n\nSábados de 9h a 12h30\n\nDomingos cerrado\n\nRecogida:\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
