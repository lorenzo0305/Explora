  "rdfs:comment": {
    "de": [
      "Die Stadt Craponne lädt Sie in Partnerschaft mit dem Syndicat Mixte du Projet Chaise-Dieu am 5. Juni um 17 Uhr auf dem Vorplatz der Mediathek zu einer musikalischen Begegnung mit der Gruppe Banan'n Jug ein."
    ],
    "en": [
      "The town of Craponne, in partnership with the Syndicat Mixte du Projet Chaise-Dieu, invites you to a musical encounter with the group Banan'n Jug on June 5 at 5pm in front of the media library."
    ],
    "it": [
      "La città di Craponne, in collaborazione con il Syndicat Mixte du Projet Chaise-Dieu, vi invita a un incontro musicale con il gruppo Banan'n Jug il 5 giugno alle 17.00 davanti alla mediateca."
    ],
    "fr": [
      "La Ville de Craponne, en partenariat avec le Syndicat Mixte du Projet Chaise-Dieu, vous invite à une rencontre musicale avec le groupe Banan'n Jug le 5 juin à 17h sur le parvis de la médiathèque."
    ],
    "es": [
      "La ciudad de Craponne, en colaboración con el Syndicat Mixte du Projet Chaise-Dieu, le invita a un encuentro musical con el grupo Banan'n Jug el 5 de junio a las 17.00 horas frente a la mediateca."
    ],
    "nl": [
      "De stad Craponne, in samenwerking met het Syndicat Mixte du Projet Chaise-Dieu, nodigt je uit voor een muzikale ontmoeting met de groep Banan'n Jug op 5 juni om 17.00 uur voor de mediatheek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre musicale avec Banan'n Jug"
    ]
  },
