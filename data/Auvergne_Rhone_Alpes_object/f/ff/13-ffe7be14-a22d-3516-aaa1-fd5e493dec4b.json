  "rdfs:comment": {
    "de": [
      "Die Aequinoxes. \"Rien ne sert pas de courir\" (Nichts nützt, um zu rennen). Nehmen wir uns dank der Zusammenarbeit von Musik, Versen und Kostümen Zeit zum Träumen."
    ],
    "en": [
      "The Aequinoxes. \"Nothing's worth running for. Let's take the time to dream thanks to the collaboration of music, verse and costumes."
    ],
    "it": [
      "Gli Aequinox. \"Non ha senso correre. Prendiamoci il tempo di sognare grazie alla collaborazione di musica, versi e costumi."
    ],
    "fr": [
      "Les Aequinoxes. \"Rien ne sert de courir\". Prenons le temps de rêver grâce à la collaboration de la musique, des vers et des costumes."
    ],
    "es": [
      "Los Aequinoxes. \"No tiene sentido correr. Tomémonos el tiempo de soñar gracias a la colaboración de la música, los versos y el vestuario."
    ],
    "nl": [
      "De Aequinoxen. \"Het heeft geen zin om te rennen. Laten we de tijd nemen om te dromen dankzij de samenwerking van muziek, vers en kostuums."
    ]
  },
