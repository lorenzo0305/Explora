  "rdfs:comment": {
    "de": [
      "David Alberge kocht uns ein Abenteuer vor... Sein Leitmotiv? Vor allem der Respekt, die Qualität und die Frische unserer Schätze in einem kurzen Kreislauf. Er möchte eine freie, instinktive und authentische Bistroküche, in der die Saisonalität im Vordergrund steht."
    ],
    "en": [
      "David Alberge cooks up culinary adventures with the themes of respect, quality and fresh, locally sourced ingredients. His bistronomic cuisine is free, instinctive, authentic and gives pride of place to seasonality."
    ],
    "it": [
      "David Alberge sta preparando un'avventura? Il suo leitmotiv? Soprattutto, rispetto, qualità e freschezza delle nostre risorse in un circuito breve. Vuole una cucina bistronomica libera, istintiva e autentica che onori la stagionalità."
    ],
    "fr": [
      "David Alberge nous mijote l’aventure… Son leitmotiv ? Avant tout le respect, la qualité et la fraîcheur de nos richesses dans un circuit court. Il veut une cuisine bistronomique libre, instinctive et authentique mettant à l’honneur la saisonnalité."
    ],
    "es": [
      "¿David Alberge está preparando una aventura? ¿Su leitmotiv? Sobre todo, el respeto, la calidad y la frescura de nuestros recursos en un circuito corto. Quiere una cocina bistronómica libre, instintiva y auténtica que haga honor a la estacionalidad."
    ],
    "nl": [
      "David Alberge bereidt een avontuur voor... Zijn leitmotiv? Vooral respect, kwaliteit en versheid van onze middelen in een kort circuit. Hij wil een vrije, instinctieve en authentieke bistronomische keuken die de seizoensgebondenheid in ere houdt."
    ]
  },
