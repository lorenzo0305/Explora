  "rdfs:comment": {
    "de": [
      "Ehemaliger Almbauernhof, der vollständig renoviert wurde, um Platz für ein Restaurant zu schaffen, das Tradition und Moderne miteinander verbindet. In diesem Dekor aus altem Holz stehen eine erlesene Küche und traditionelle Gerichte mit Fleisch von hoher Qualität auf der Speisekarte. Blick auf den Mont Blanc."
    ],
    "en": [
      "This former alpine farmhouse, refurbished as a restaurant, combines tradition and modernity. On the menu: traditional dishes with top-quality meats served in an authentic wooden decor overlooking Mont-Blanc."
    ],
    "it": [
      "Antica fattoria di alpeggio completamente ristrutturata per fare spazio a un ristorante che unisce tradizione e modernità. In questo arredamento in legno antico, al menu, una cucina ricercata e piatti tradizionali con carni di alta qualità. Vista Monte Bianco."
    ],
    "fr": [
      "Ancienne ferme d’alpage entièrement rénovée pour faire place à un restaurant  alliant tradition et modernité. Dans ce décor en vieux bois, au menu, une cuisine recherchée et des plats traditionnels avec des viandes de grande qualité. Vue Mont Blanc."
    ],
    "es": [
      "Esta antigua granja de pastos de montaña ha sido completamente renovada para crear un restaurante que combina tradición y modernidad. La carta ofrece una cocina sofisticada y platos tradicionales con carnes de primera calidad. Vistas al Mont Blanc."
    ],
    "nl": [
      "Deze voormalige almboerderij is volledig gerenoveerd tot een restaurant dat traditie en moderniteit combineert. Op het menu staan verfijnde gerechten en traditionele gerechten met vlees van topkwaliteit. Uitzicht op de Mont Blanc."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Tremplin de la Croix"
    ],
    "it": [
      "Le Tremplin de la Croix"
    ],
