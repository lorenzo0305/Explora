  "rdfs:comment": {
    "de": [
      "Der Wanderweg beginnt am Maison du Parc des Monts d’Ardèche und bietet eine originelle Entdeckungstour durch das fast 40 Hektar große Anwesen Rochemure, das von gepflegten Gärten bis hin zu wilden Naturlandschaften reicht."
    ],
    "en": [
      "Starting from the Maison du Parc des Monts d'Ardèche, the trail offers an original exploration of the Rochemure estate, which covers nearly 40 hectares, from landscaped gardens to wilder areas."
    ],
    "it": [
      "Partendo dalla Maison du Parc des Monts d'Ardèche, il percorso offre un modo originale per esplorare la tenuta di Rochemure, che si estende per quasi 40 ettari, dalle aree coltivate a quelle più selvagge."
    ],
    "fr": [
      "Au départ de la Maison du Parc des Monts d’Ardèche, le sentier propose une découverte originale du domaine de Rochemure qui s’étend sur près de 40 hectares, des espaces jardinés aux plus sauvages."
    ],
    "nl": [
      "De route vertrekt vanuit het Maison du Parc des Monts d'Ardèche en biedt een originele manier om het landgoed van Rochemure te verkennen, dat zich uitstrekt over bijna 40 hectare, van de beplante gebieden tot de wildste."
    ],
    "es": [
      "Con salida de la Maison du Parc des Monts d'Ardèche, el sendero ofrece una forma original de explorar la finca de Rochemure, que se extiende por casi 40 hectáreas, desde las zonas ajardinadas hasta las más salvajes."
    ]
  },
  "rdfs:label": {
    "de": [
      "Gärten des Maison du Parc"
    ],
    "en": [
      "Gardens of the Park House"
    ],
    "fr": [
      "Jardins de la Maison du Parc"
    ]
  },
