  "rdfs:comment": {
    "de": [
      "Gegenüber der Marques Avenue, in einem einzigartigen Rahmen und einer von Art Deco inspirierten Dekoration, genießen Sie eine Feinschmeckerküche aus frischen und lokalen Produkten. Neuheit 2024: Trüffelmenü im Januar und Februar!\r\nCocktailbar"
    ],
    "en": [
      "Opposite Marques Avenue, in a unique, Art Deco-inspired setting, enjoy gourmet cuisine based on fresh, local produce. New for 2024: Truffle menu in January and February!\r\nCocktail bar"
    ],
    "it": [
      "Di fronte al viale Marques, in un ambiente unico con decorazioni Art Déco, si può gustare una cucina gourmet a base di prodotti freschi locali. Bella terrazza ombreggiata esposta a sud.\r\nCocktail bar."
    ],
    "fr": [
      "Située en face de Marques Avenue, dans un cadre unique et une décoration d'inspiration Art Déco, dégustez une cuisine gourmande à base de produits frais et locaux. Très belle terrasse ombragée côté Sud.\r\nBar à cocktails."
    ],
    "nl": [
      "Tegenover Marques Avenue, in een unieke omgeving met een Art Deco-geïnspireerd decor, kunt u genieten van gastronomische gerechten op basis van verse, lokale producten. Nieuw in 2024: Truffelmenu in januari en februari!\r\nCocktailbar"
    ],
    "es": [
      "Frente a la avenida del Marqués, en un marco único con decoración Art Déco, disfrute de una cocina gastronómica basada en productos frescos de la tierra. Terraza sombreada orientada al sur.\r\nBar de cócteles."
    ]
  },
