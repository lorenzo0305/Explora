  "rdfs:comment": {
    "de": [
      "Ich bin ein Messerschmied, der in einer unglaublichen Umgebung, dem Livradois Forez, arbeitet. Diese magische Umgebung, die von Wäldern und Flüssen umgeben ist, ermöglicht es mir, originelle und einzigartige Klingen herzustellen."
    ],
    "en": [
      "I'm an artisan cutler working in an incredible setting, the ?Livradois Forez? This magical setting, surrounded by forests and rivers, enables me to create original and unique blades."
    ],
    "it": [
      "Sono un coltellinaio artigiano che lavora in un ambiente incredibile, il Livradois Forez. Questo ambiente magico, circondato da foreste e fiumi, mi permette di creare lame originali e uniche."
    ],
    "fr": [
      "Je suis un artisan coutelier qui travaille dans un cadre incroyable, le “Livradois Forez”. Ce cadre magique entouré de forêts et de rivières me permet de créer des lames originales et uniques."
    ],
    "es": [
      "Soy un cuchillero artesano que trabaja en un entorno increíble, el Forez de Livradois. Este entorno mágico, rodeado de bosques y ríos, me permite crear cuchillas originales y únicas."
    ],
    "nl": [
      "Ik ben een ambachtelijke messenmaker die werkt in een ongelooflijke omgeving, de Livradois Forez. Deze magische omgeving, omringd door bossen en rivieren, stelt me in staat om originele en unieke bladen te maken."
    ]
  },
  "rdfs:label": {
