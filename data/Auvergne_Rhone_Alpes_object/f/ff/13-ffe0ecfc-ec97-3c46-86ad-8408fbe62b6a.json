  "rdfs:comment": {
    "de": [
      "Als erntender Imker übe ich meinen Beruf in den Baronnies aus. Einzigartiger und typischer Honig aus der Region, Nougat und Lebkuchen. Verkauf auf dem Markt in Buis, mittwochs und samstags vormittags. Besichtigung des Honigraums am Mittwochnachmittag nach Vereinbarung."
    ],
    "en": [
      "Beekeeper and honey harvester working in the Baronnies region. I sell typical regional honeys and nougat. At Buis market on Wednesday morning. Visit of the honey house on Wednesday afternoon by appointment."
    ],
    "it": [
      "Sono un apicoltore e raccoglitore che lavora nelle Baronnies. Mieli unici e particolari della regione, torroni e panpepati. Venduto al mercato di Buis il mercoledì e il sabato mattina. Visite alla casa del miele il mercoledì pomeriggio su appuntamento."
    ],
    "fr": [
      "Apiculteur récoltant, j'exerce ma profession dans les Baronnies. Miels de la région, uniques et typés, nougats et pains d'épices. Vente sur le marché de Buis, les mercredi et samedi matin. Visite de la miellerie le mercredi après-midi sur rendez-vous."
    ],
    "es": [
      "Soy apicultor y recolector, y trabajo en las Baronnies. Mieles únicas y distintivas de la región, turrones y pan de especias. Venta en el mercado de Buis los miércoles y sábados por la mañana. Visitas a la mielería los miércoles por la tarde con cita previa."
    ],
    "nl": [
      "Bijenhouder-oogster, ik oefen mijn beroep uit in les Baronnies. Honing uit de streek, uniek en karakteristiek, nougat. Verkoop op de markt van Buis op woensdag, in Ste-Jalle op vrijdagavond. Aangesloten bij Rouge Amarante."
    ]
  },
