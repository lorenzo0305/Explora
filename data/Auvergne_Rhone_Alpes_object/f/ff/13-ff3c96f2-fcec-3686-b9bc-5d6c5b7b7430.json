  "rdfs:comment": {
    "de": [
      "Ideal im Herzen des Place des Terreaux, in direkter Nähe des Rathauses und der Oper gelegen, bietet Ihnen diese Brasserie seine qualitative Küche im Saal und auf der Terrasse an."
    ],
    "en": [
      "Ideally located in the middle of place des Terreaux near the town hall and the Opera, this brasserie proposes its quality cooking to be enjoyed indoors or out on the terrace."
    ],
    "it": [
      "Collocata in posizione ideale nel cuore della place des Terreaux, vicino all'Hôtel de Ville e al Teatro dell'Opera, questa brasserie ti propone la sua cucina di qualità da degustare in sala o all'aperto."
    ],
    "fr": [
      "Idéalement située au cœur de la place des Terreaux, à proximité de l’Hôtel de Ville et de l’Opéra, cette brasserie vous propose sa cuisine de qualité à déguster en salle ou en terrasse."
    ],
    "es": [
      "Esta \"brasserie\", muy bien situada en Place des Terreaux, cerca del ayuntamiento y la Ópera, propone una cocina de calidad para disfrutar en sala o en la terraza."
    ],
    "nl": [
      "Deze brasserie, ideaal gelegen in het hart van het Place des Terreaux, vlakbij het Hôtel de Ville en de Opera, biedt een kwaliteitskeuken die u in de eetzaal of op het terras kunt nuttigen."
    ]
  },
