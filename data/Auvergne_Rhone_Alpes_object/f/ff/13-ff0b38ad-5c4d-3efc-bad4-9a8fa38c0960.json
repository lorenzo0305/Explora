  "rdfs:comment": {
    "de": [
      "Historischer Snowpark in Avoriaz, der 1993 gegründet wurde und den Namen Nami-Park trägt. Nami bedeutet auf Japanisch \"Welle\" und kennzeichnet einen neuen Shape, der von der Philosophie des Surfens inspiriert ist und große Schneewellen und originelle Module nachbildet."
    ],
    "en": [
      "Avoriaz's historic snowpark, created in 1993, is named Nami-Park. Nami means \"wave\" in Japanese and defines a new shape inspired by surfing philosophy, featuring large snow waves and original modules."
    ],
    "it": [
      "Lo storico snowpark di Avoriaz, creato nel 1993 e denominato Nami-Park. Nami significa \"onda\" in giapponese ed è il nome di una nuova forma, ispirata alla filosofia del surf, che riproduce grandi onde di neve e moduli originali."
    ],
    "fr": [
      "Snowpark historique d’Avoriaz, créé en 1993, baptisé Nami-Park. Nami signifie « vague » en japonais et caractérise un nouveau shape, inspiré de la philosophie du surf, qui reproduit de grandes vagues de neige et des modules originaux."
    ],
    "nl": [
      "Het historische snowpark van Avoriaz, opgericht in 1993, heet Nami-Park. Nami betekent \"golven\" in het Japans en kenmerkt een nieuwe vorm, geïnspireerd door de filosofie van surfen, die grote sneeuwgolven en originele modules nabootst."
    ],
    "es": [
      "El histórico snowpark de Avoriaz, creado en 1993 y bautizado como Nami-Park. Nami significa \"ola\" en japonés y es el nombre de una nueva forma, inspirada en la filosofía del surf, que reproduce grandes olas de nieve y módulos originales."
    ]
  },
  "rdfs:label": {
