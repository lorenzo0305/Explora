  "rdfs:comment": {
    "de": [
      "Bäckerbauern, der Fruchtbare Halbmond in AB führt alle notwendigen Schritte zur Brotherstellung vom Getreideanbau bis zum Backen des Brotes durch. Die Brote werden mit Natursauerteig gebacken, das Mehl wird auf Steinmühlsteinen gemahlen: Buchweizen, Weizen und Roggen."
    ],
    "en": [
      "The Fertile Crescent is a family-run, AB-based bakery that carries out all the steps involved in bread-making, from growing the cereals to baking the bread. Our breads are made with natural sourdough, stone-ground buckwheat, wheat and rye flours."
    ],
    "it": [
      "Panettiere agricolo, il Croissant Fertile di AB svolge tutte le fasi della produzione del pane, dalla coltivazione dei cereali alla cottura del pane. I pani sono prodotti con lievito madre naturale e farine di grano saraceno, grano e segale macinate a pietra."
    ],
    "fr": [
      "Paysans boulangers, le Croissant Fertile en AB réalise toutes les étapes nécessaires à la fabrication du pain de la culture des céréales à la cuisson du pain. Les pains sont au levain naturel, farines sur meule de pierre : sarrasin, blé et seigle."
    ],
    "es": [
      "Panaderos de granja, los Croissant Fertile de AB realizan todas las etapas de la fabricación del pan, desde el cultivo de los cereales hasta la cocción del pan. Los panes se elaboran con masa madre natural y harinas molidas a la piedra de trigo sarraceno, trigo y centeno."
    ],
    "nl": [
      "Croissant Fertile in AB, een boerderijbakkerij, voert alle stappen van het broodmaken uit, van het verbouwen van het graan tot het bakken van het brood. De broden worden gemaakt met natuurlijk zuurdesem en steengemalen boekweit-, tarwe- en roggemeel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Croissant fertile"
    ]
  },
