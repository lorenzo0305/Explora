  "rdfs:comment": {
    "de": [
      "Rider's Camp ist ein Mountainbike-Camp im Cézallier-Massiv, das sich ganz dem Mountainbiken widmet. Wir bieten verschiedene Tagesangebote mit Essen aus dem Rucksack an, von klassischen Wanderungen über Kurse bis hin zu Pendeltagen."
    ],
    "en": [
      "Based in the Cézallier massif, Rider's Camp is a camp dedicated to mountain biking. We offer several day formulas with a packed lunch, from the classic ride to the training courses to the shuttle days."
    ],
    "it": [
      "Situato nel massiccio del Cézallier, il Rider's Camp è un campo dedicato alla mountain bike. Offriamo una serie di escursioni giornaliere con pranzo al sacco, dalle classiche cavalcate ai corsi e alle giornate in navetta."
    ],
    "fr": [
      "Basé sur le massif du Cézallier, Rider's Camp est un camp dédié à la pratique du VTT. Nous proposons plusieurs formules à la journée avec repas tiré du sac de la randonnée classique en passant par les stages jusqu'aux journées navettes."
    ],
    "es": [
      "Situado en el macizo de Cézallier, el Rider's Camp es un campamento dedicado a la bicicleta de montaña. Ofrecemos una serie de excursiones de un día con almuerzo para llevar, desde paseos clásicos hasta cursos y días de lanzadera."
    ],
    "nl": [
      "Rider's Camp, gelegen in het massief van Cézallier, is een kamp gewijd aan mountainbiken. Wij bieden een scala aan dagtochten met lunchpakket, van klassieke ritten tot cursussen en pendeldagen."
    ]
  },
