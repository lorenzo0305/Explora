  "rdfs:comment": {
    "de": [
      "Besuchen Sie uns in der JukeBoxx und entdecken Sie unsere Tapas und unsere innovative Cocktailkarte, alles in einer aufgedrehten Atmosphäre.\r\n\r\nJede Nacht bringt ein Live-DJ die Bar zum Kochen!"
    ],
    "en": [
      "Expect a warm welcome in our freshly renovated bar, a paradise for music lovers and bi-alpine parties.\r\nThe JUKEBOXX offers an eclectic choice of music and theme nights every week with live music and renowned DJs."
    ],
    "it": [
      "Aspettatevi un caldo benvenuto nel nostro bar appena ristrutturato, un paradiso per gli amanti della musica e delle feste bi-alpine.\r\nLo JUKEBOXX offre ogni settimana un'eclettica scelta di musica e serate a tema con musica dal vivo e rinomati DJ."
    ],
    "fr": [
      "Rendez nous visite au JukeBoxx et découvrez nos tapas et notre carte de cocktails innovants, le tout dans une ambiance survoltée.\r\n\r\nChaque nuit, un DJ live enflamme le bar !"
    ],
    "es": [
      "Visítenos en JukeBoxx y descubra nuestras tapas y nuestra innovadora carta de cócteles, todo ello en un ambiente sobrealimentado.\r\n\r\nTodas las noches, un DJ en directo se encarga de animar el bar"
    ],
    "nl": [
      "Bezoek ons bij JukeBoxx en ontdek onze tapas en onze innovatieve cocktailkaart, allemaal in een supergezellige sfeer.\r\n\r\nElke avond staat er een live DJ op de bar!"
    ]
  },
