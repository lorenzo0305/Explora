  "rdfs:comment": {
    "de": [
      "Gesicherte Naturpisten, die von Pistenarbeitern markiert werden, ohne dass eine Pistenraupe die Authentizität des Ortes beeinträchtigt. Pures Skivergnügen!"
    ],
    "en": [
      "Natural pistes made safe and marked by the piste patrols without any grooming to spoil the authenticity of the location. The pleasure of snow riding in its pure form!"
    ],
    "it": [
      "Piste naturali assicurate e tracciate dalla pattuglia sciistica, senza che la battitura disturbi l'autenticità del sito. Puro piacere di sciare!"
    ],
    "fr": [
      "Des pistes naturelles sécurisées et balisées par les pisteurs, sans qu'aucun damage ne vienne perturber l'authenticité du site. Le plaisir de la glisse à l'état pur!"
    ],
    "es": [
      "Pistas naturales aseguradas y delimitadas por la patrulla de esquí, sin que ningún tipo de preparación perturbe la autenticidad del lugar. ¡Puro placer de esquiar!"
    ],
    "nl": [
      "Natuurlijke hellingen, beveiligd en afgebakend door de skipatrouille, zonder enige verzorging die de authenticiteit van het terrein verstoort. Puur skiplezier!"
    ]
  },
