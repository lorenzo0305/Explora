  "rdfs:comment": {
    "de": [
      "Testen Sie das Konzept eines einzigartigen, kurzlebigen Freizeitparks unter freiem Himmel. Entdecken Sie einen riesigen Spielplatz für alle, Kinder und Erwachsene. Bei Pop Corn Labyrinthe gibt es bestimmt eine Aktivität, die Ihnen Spaß macht."
    ],
    "en": [
      "Come and try out a unique, ephemeral, open-air leisure park concept. Discover a huge playground for children and adults alike. There's bound to be something to amuse you at Pop Corn Labyrinthe."
    ],
    "it": [
      "Venite a provare un concetto di parco divertimenti all'aperto unico ed effimero. Scoprite un enorme parco giochi per bambini e adulti. Al Pop Corn Labyrinthe ci sarà sicuramente qualcosa che vi divertirà."
    ],
    "fr": [
      "Venez tester un concept de parc de loisirs unique, éphémère et en plein air. Découvrez un immense terrain de jeu pour tous, enfants et adultes. Il y aura forcément une activité pour vous amuser chez Pop Corn Labyrinthe."
    ],
    "es": [
      "Venga a probar un concepto de parque de ocio único, efímero y al aire libre. Descubra una enorme zona de juegos para niños y adultos. Seguro que hay algo que te divierte en Pop Corn Labyrinthe."
    ],
    "nl": [
      "Kom en probeer een uniek, efemeer openluchtpretparkconcept uit. Ontdek een enorme speeltuin voor kinderen en volwassenen. Er is zeker iets om je te vermaken in Pop Corn Labyrinthe."
    ]
  },
