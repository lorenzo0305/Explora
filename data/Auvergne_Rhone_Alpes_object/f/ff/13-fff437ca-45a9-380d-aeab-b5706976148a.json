  "rdfs:comment": {
    "de": [
      "Die Orgeltage werden jedes Jahr Anfang August angeboten, um die große Barockorgel der Abteikirche zu ehren: 3 Recitals, die von der Vereinigung Marin Carouge organisiert werden, werden vom 4. bis 6. August 2026 gegeben"
    ],
    "en": [
      "The Journées de l'orgue (organ days) are held every year at the beginning of August to honor the abbey church's great Baroque organs: 3 recitals organized by the Marin Carouge association will be given from August 4 to 6, 2026"
    ],
    "it": [
      "Le Giornate dell'organo si tengono ogni anno all'inizio di agosto per onorare i grandi organi barocchi della chiesa abbaziale: dal 4 al 6 agosto 2026 si terranno 3 recital organizzati dall'associazione Marin Carouge"
    ],
    "fr": [
      "Les Journées de l'orgue sont proposées chaque année début août pour mettre à l'honneur les grandes orgues baroques de l'église abbatiale : 3 récitals organisés par l'association Marin Carouge seront donnés du 4 au 6 août 2026"
    ],
    "es": [
      "Las Jornadas del Órgano se celebran todos los años a principios de agosto para rendir homenaje a los grandes órganos barrocos de la iglesia abacial: del 4 al 6 de agosto de 2026 tendrán lugar 3 recitales organizados por la asociación Marin Carouge"
    ],
    "nl": [
      "De Orgeldagen worden elk jaar begin augustus gehouden om de grote barokorgels van de abdijkerk te eren: 3 concerten georganiseerd door de vereniging Marin Carouge worden gegeven van 4 tot 6 augustus 2026"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Journées de l'Orgue"
    ]
  },
