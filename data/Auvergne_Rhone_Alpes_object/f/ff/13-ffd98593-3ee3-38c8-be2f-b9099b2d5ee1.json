  "rdfs:comment": {
    "de": [
      "Ein Weinkeller mit den Weinen der Domaine Rostaing-Tayard und denen seiner Kumpels: Auswahl an identitätsstiftenden, vertraulichen und charakterstarken Weinen; Verkostungsworkshops."
    ],
    "en": [
      "A wine cellar featuring Domaine Rostaing-Tayard wines and those of its friends: a selection of wines with identity, confidentiality and strong personality; tasting workshops."
    ],
    "it": [
      "Una cantina con i vini del Domaine Rostaing-Tayard e quelli dei suoi amici: una selezione di vini dalla forte identità, vini confidenziali e vini dalla forte personalità; laboratori di degustazione."
    ],
    "fr": [
      "Une cave à vin avec les vins du Domaine Rostaing-Tayard et ceux de ses copains : sélection de vins identitaires, confidentiels et à forte personnalité ; ateliers de dégustation."
    ],
    "es": [
      "Una bodega que presenta los vinos del Domaine Rostaing-Tayard y los de sus amigos: una selección de vinos con una fuerte identidad, vinos confidenciales y vinos con una fuerte personalidad; talleres de degustación."
    ],
    "nl": [
      "Een wijnkelder met wijnen van Domaine Rostaing-Tayard en zijn vrienden: een selectie wijnen met een sterke identiteit, vertrouwelijke wijnen en wijnen met een sterke persoonlijkheid; degustaties."
    ]
  },
