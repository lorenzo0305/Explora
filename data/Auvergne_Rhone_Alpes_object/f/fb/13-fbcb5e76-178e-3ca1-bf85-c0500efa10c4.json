  "rdfs:comment": {
    "de": [
      "Im authentischen und gemütlichen Domaine Le Prieuré können Sie die Küche der Region entdecken, wobei am Wochenende das Fleisch am Kamin gegart wird."
    ],
    "en": [
      "Authentic and welcoming, Domaine Le Prieuré invites you to discover regional cuisine, with meat cooked over an open fire at weekends."
    ],
    "it": [
      "Autentico e accogliente, il Domaine Le Prieuré vi offre la possibilità di scoprire la cucina regionale, con la carne cotta sul fuoco durante il fine settimana."
    ],
    "fr": [
      "Authentique et chaleureux, le domaine Le Prieuré vous propose de découvrir une cuisine de la région avec le week-end une cuisson des viandes à la cheminée."
    ],
    "nl": [
      "Het authentieke en gastvrije Domaine Le Prieuré biedt je de kans om de regionale keuken te ontdekken, met vlees dat in het weekend boven een open vuur wordt bereid."
    ],
    "es": [
      "Auténtico y acogedor, el Domaine Le Prieuré le ofrece la posibilidad de descubrir la cocina regional, con carnes cocinadas al fuego los fines de semana."
    ]
  },
