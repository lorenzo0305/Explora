  "rdfs:comment": {
    "de": [
      "Der gehobene Concierge-Service La Casa Signature bietet Ihnen einen maßgeschneiderten Service für die Verwaltung Ihrer Kurzzeitvermietung.  Die Kunst des Managements ist der Schlüssel zur Rentabilität."
    ],
    "en": [
      "The upscale concierge service La Casa Signature offers you a tailor-made short-term rental management service.  The art of management, the key to profitability."
    ],
    "it": [
      "Il servizio di concierge di alto livello La Casa Signature vi offre un servizio su misura per gestire il vostro affitto a breve termine.  L'arte della gestione, la chiave della redditività."
    ],
    "fr": [
      "La conciergerie haut de gamme La Casa Signature vous offre un service sur mesure de gestion de votre location courte durée.  L'art de gérer, la clé de la rentabilité."
    ],
    "es": [
      "El servicio de conserjería de lujo La Casa Signature le ofrece un servicio a medida para gestionar su alquiler a corto plazo.  El arte de la gestión, la clave de la rentabilidad."
    ],
    "nl": [
      "De chique conciërgedienst La Casa Signature biedt je een op maat gemaakte service voor het beheer van je kortetermijnverhuur.  De kunst van het beheer, de sleutel tot winstgevendheid."
    ]
  },
  "rdfs:label": {
