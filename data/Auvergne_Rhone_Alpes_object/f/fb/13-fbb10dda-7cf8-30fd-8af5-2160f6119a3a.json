  "rdfs:comment": {
    "de": [
      "L'Écrin ist die Bar im Herzen der Domaine mit einem gemütlichen und raffinierten Raum, einer Sonnenterrasse, ? und vor allem: offen für alle, nicht nur für Hotelgäste."
    ],
    "en": [
      "L'Écrin is the bar nestled in the heart of the Domaine, with a warm, refined atmosphere, a sunny terrace? and above all: open to all, not just hotel guests."
    ],
    "it": [
      "L'Écrin è il bar situato nel cuore del Domaine, con un'atmosfera calda e raffinata, una terrazza soleggiata e soprattutto: aperto a tutti, non solo agli ospiti dell'hotel."
    ],
    "fr": [
      "L’Écrin, c’est le bar niché au cœur du Domaine avec un espace chaleureux et raffiné, une terrasse ensoleillée, … et surtout : ouvert à tous, pas seulement aux clients de l’hôtel."
    ],
    "nl": [
      "L'Écrin is de bar in het hart van het Domaine, met een warme, verfijnde sfeer, een zonnig terras en vooral: open voor iedereen, niet alleen hotelgasten."
    ],
    "es": [
      "L'Écrin es el bar situado en el corazón del Domaine, con un ambiente cálido y refinado, una terraza soleada y, sobre todo, abierto a todos, no sólo a los huéspedes del hotel."
    ]
  },
  "rdfs:label": {
