  "rdfs:comment": {
    "de": [
      "Via ferrata - Klettern in großen Routen in Buis-les-Baronnies.\r\nKletterkurse an natürlichen Standorten für alle Niveaus, in Saoû und um Nyons.\r\nMathilde führt Sie vertrauensvoll und sicher über den Fels, im Sommer im Schatten und im Winter in der Sonne."
    ],
    "en": [
      "Via ferrata - long route climbing in Buis-les-Baronnies.\r\nClimbing sessions on natural sites for all levels, in Saoû and around Nyons.\r\nMathilde guides you safely and confidently on the rock, in the shade in summer and in the sun in winter."
    ],
    "it": [
      "Via ferrata - arrampicata su vie lunghe a Buis-les-Baronnies.\r\nSessioni di arrampicata su siti naturali per tutti i livelli, a Saoû e nei dintorni di Nyons.\r\nMathilde vi guiderà con sicurezza e fiducia sulla roccia, all'ombra in estate e al sole in inverno."
    ],
    "fr": [
      "Via ferrata - escalade en grande voie à Buis-les-Baronnies.\r\nSéances d’escalade sur sites naturels pour tous les niveaux, à Saoû et autour de Nyons.\r\nMathilde vous guide en confiance et en sécurité sur le rocher, à l’ombre l’été et au soleil l’hiver."
    ],
    "es": [
      "Vía ferrata - escalada de largo recorrido en Buis-les-Baronnies.\r\nSesiones de escalada en parajes naturales para todos los niveles, en Saoû y en los alrededores de Nyons.\r\nMathilde le guiará con seguridad y confianza en la roca, a la sombra en verano y al sol en invierno."
    ],
    "nl": [
      "Klettersteigen - langeafstandsklimmen in Buis-les-Baronnies.\r\nKlimsessies op natuurlijke sites voor alle niveaus, in Saoû en rond Nyons.\r\nMathilde begeleidt je veilig en zelfverzekerd op de rots, in de schaduw in de zomer en in de zon in de winter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Natura Grimpe"
    ]
  },
