  "rdfs:comment": {
    "de": [
      "Traditionelle Pizzas zum Mitnehmen. Mit der Hand geformt. Teig und Tomatensoße werden vor Ort aus frischen Produkten hergestellt. Etwa 20 Pizzen zum Mitnehmen oder zum Verzehr vor Ort."
    ],
    "en": [
      "Traditional pizzas baked in a wood-fired oven and home-made. Pasta and tomato sauce with fresh products. About 10 Pizzas to take away or ready to eat on high tables installed on site. Drink et homemade desserts"
    ],
    "it": [
      "Pizze tradizionali da asporto. Fatte a mano. Impasto e salsa di pomodoro preparati in loco con prodotti freschi. Una ventina di pizze da asporto o da gustare."
    ],
    "fr": [
      "Pizzas traditionnelles à emporter. Façonnées à la main. Pâte et sauce tomate élaborées sur place avec produits frais. Une vingtaine de pizzas à emporter ou à déguster sur place."
    ],
    "nl": [
      "Traditionele afhaalpizza's. Met de hand gemaakt. Deeg en tomatensaus ter plekke gemaakt met verse producten. Ongeveer twintig pizza's om mee te nemen of om op te eten."
    ],
    "es": [
      "Pizzas tradicionales para llevar. Hechas a mano. Masa y salsa de tomate elaboradas in situ con productos frescos. Una veintena de pizzas para llevar o comer en casa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au bol d'Air"
    ]
  },
