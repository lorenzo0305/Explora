  "rdfs:comment": {
    "de": [
      "Galerie für moderne Kunst, in der Sie originelle und inspirierende ?uvres bewundern können. L'Art Perché ist eine Galerie, ein Museum und ein kleines Theater, die sich in einer Wohnung befinden.\r\nEine Oase der Kreativität im Herzen von La Mure, die von der Magie der Kunst getragen wird"
    ],
    "en": [
      "Modern art gallery where you can admire original and inspiring works.\r\nL'Art Perché A Gallery, Museum and a Small Theater Nestled in an Apartment\r\nA haven of creativity in the heart of La Mure brought by the magic of art."
    ],
    "it": [
      "Galleria d'arte moderna dove si admirano delle opere originale e ispirante. L'Art Perché è una galleria, un musée e un piccolo teatro in un'appartamento. Un luogo di creatività nel cuore di La Mure per la magia dell'arte."
    ],
    "fr": [
      "Galerie d'art moderne où admirer des œuvres originales et inspirantes. L'Art Perché est une galerie, un musée et un petit théâtre nichés dans un appartement.\r\nUn havre de créativité au cœur de La Mure transporté par la magie de l'art"
    ],
    "es": [
      "Una galería de arte moderno donde admirar obras originales e inspiradoras. L'Art Perché es una galería, museo y pequeño teatro ubicado en un piso.\r\nUn remanso de creatividad en el corazón de La Mure, transportado por la magia del arte"
    ],
    "nl": [
      "Een moderne kunstgalerie waar je originele en inspirerende werken kunt bewonderen. L'Art Perché is een galerie, museum en klein theater gehuisvest in een flat.\r\nEen oase van creativiteit in het hart van La Mure, vervoerd door de magie van kunst"
    ]
  },
