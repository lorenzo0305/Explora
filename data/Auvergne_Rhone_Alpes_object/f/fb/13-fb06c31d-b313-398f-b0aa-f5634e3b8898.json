  "rdfs:comment": {
    "de": [
      "Unser Selectour-Büro Ailleurs Voyages begleitet Sie, um mit Ihnen Ihre nächste Reise zu planen. Aufenthalte, Rundreisen, Kreuzfahrten, Flüge, Hotels oder maßgeschneiderte Reisen werden Ihnen in unserem Reisebüro angeboten."
    ],
    "en": [
      "Our Selectour agency Ailleurs Voyages will work with you to design your next trip. Stays, tours, cruises, flights, hotels or tailor-made trips are all on offer at our travel agency."
    ],
    "it": [
      "La nostra agenzia Selectour Ailleurs Voyages lavorerà con voi per progettare il vostro prossimo viaggio. Soggiorni, tour, crociere, voli, hotel o viaggi su misura sono tutti offerti dalla nostra agenzia di viaggi."
    ],
    "fr": [
      "Notre agence Selectour Ailleurs Voyages vous accompagne pour construire avec vous votre prochain voyage. Séjours, circuits, croisières, vols, hôtels ou voyages sur mesure vous seront proposés dans notre agence de voyages."
    ],
    "nl": [
      "Ons Selectour-reisbureau Ailleurs Voyages stelt samen met jou je volgende reis samen. Verblijven, rondreizen, cruises, vluchten, hotels of reizen op maat zijn allemaal mogelijk bij ons reisbureau."
    ],
    "es": [
      "Nuestra agencia Selectour Ailleurs Voyages diseñará con usted su próximo viaje. Estancias, circuitos, cruceros, vuelos, hoteles o viajes a medida: todo es posible en nuestra agencia de viajes."
    ]
  },
