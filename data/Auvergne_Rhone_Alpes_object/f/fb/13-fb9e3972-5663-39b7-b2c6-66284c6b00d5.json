  "rdfs:comment": {
    "de": [
      "La Casa Luigi ist ein Restaurant am Ortseingang von Morestel, das nach Italien riecht und hausgemachte Gerichte anbietet. Liebhaber von Bruschetta, Lasagne, Risotto, Tiramisu und italienischen Weinen aufgepasst! Unter der Woche werden mittags Tagesmenüs angeboten."
    ],
    "en": [
      "La Casa Luigi is a restaurant with a strong Italian flavour and homemade dishes, just outside Morestel. For lovers of bruschetta, lasagne, risotto, tiramisu and Italian wines! Daily lunch menus are available on weekdays."
    ],
    "it": [
      "La Casa Luigi è un ristorante dal forte sapore italiano con piatti fatti in casa, appena fuori Morestel. Bruschetta, lasagne, risotto, tiramisù e vini italiani sono tutti offerti! Durante la settimana sono disponibili menù giornalieri per il pranzo."
    ],
    "fr": [
      "La Casa Luigi est un restaurant qui sent bon l'Italie, et les plats faits maison, à l'entrée de Morestel. Avis aux amateurs bruschetta, lasagnes, risotto, tiramisu et vins italiens ! Des menus du jour sont proposés à midi en semaine."
    ],
    "nl": [
      "La Casa Luigi is een restaurant met een sterke Italiaanse smaak en huisgemaakte gerechten, net buiten Morestel. Bruschetta, lasagne, risotto, tiramisu en Italiaanse wijnen zijn allemaal verkrijgbaar! Tijdens de week zijn er dagelijkse lunchmenu's beschikbaar."
    ],
    "es": [
      "La Casa Luigi es un restaurante con un fuerte sabor italiano y platos caseros, a las afueras de Morestel. Bruschetta, lasaña, risotto, tiramisú y vinos italianos Durante la semana hay menús diarios para almorzar."
    ]
  },
  "rdfs:label": {
