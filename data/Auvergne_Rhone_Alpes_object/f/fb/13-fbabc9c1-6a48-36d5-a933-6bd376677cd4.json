  "rdfs:comment": {
    "de": [
      "Die Katholische Nothilfe arbeitet mit Migranten zusammen, um ihre Rechte zu verteidigen und ihre Eingliederung in die Gesellschaft zu fördern. Die Katholische Nothilfe bietet Nothilfe für Haushalte und unterstützt sie beim Zugang zu ihren sozialen Rechten."
    ],
    "en": [
      "Secours Catholique works with migrants to defend their rights and help them integrate into society. Secours Catholique offers emergency assistance to households and helps them access their social rights."
    ],
    "it": [
      "Secours Catholique lavora con i migranti per difendere i loro diritti e promuovere la loro integrazione nella società. Il Secours Catholique offre assistenza di emergenza alle famiglie e le aiuta ad accedere ai loro diritti sociali."
    ],
    "fr": [
      "Le Secours Catholique agit auprès des personnes migrantes pour défendre leur droits et favoriser leur insertion dans la société. Le Secours Catholique propose, une aide d'urgence aux ménages et les accompagne dans l'accès à leurs droits sociaux."
    ],
    "nl": [
      "Secours Catholique werkt met migranten om hun rechten te verdedigen en hen te helpen integreren in de maatschappij. Secours Catholique biedt noodhulp aan huishoudens en helpt hen toegang te krijgen tot hun sociale rechten."
    ],
    "es": [
      "Secours Catholique trabaja con inmigrantes para defender sus derechos y promover su integración en la sociedad. Secours Catholique ofrece ayuda de emergencia a los hogares y les ayuda a acceder a sus derechos sociales."
    ]
  },
  "rdfs:label": {
