  "rdfs:comment": {
    "de": [
      "\"les plaisirs gourmands\" empfängt Sie in einem modernen und gemütlichen Rahmen mit einer originellen Küche, die Wert auf den Geschmack und die Saisonalität der Produkte und authentische Weine legt."
    ],
    "en": [
      "\"les plaisirs gourmands\" welcomes you in a modern and warm setting around an original cuisine, attached to the taste and seasonality of authentic products and wines."
    ],
    "it": [
      "\"les plaisirs gourmands\" vi accoglie in un ambiente moderno e caloroso attorno a una cucina originale, legata al gusto e alla stagionalità dei prodotti e dei vini autentici."
    ],
    "fr": [
      "\"les plaisirs gourmands\" vous accueille dans un cadre moderne et chaleureux autour d'une cuisine originale, attachée au goût et à la saisonnalité des produits et des vins authentiques."
    ],
    "nl": [
      "\"les plaisirs gourmands\" ontvangt u in een modern en warm kader rond een originele keuken, gehecht aan de smaak en seizoensgebondenheid van de producten en authentieke wijnen."
    ],
    "es": [
      "\"les plaisirs gourmands\" le acoge en un marco moderno y cálido en torno a una cocina original, apegada al sabor y a la estacionalidad de los productos y a los vinos auténticos."
    ]
  },
