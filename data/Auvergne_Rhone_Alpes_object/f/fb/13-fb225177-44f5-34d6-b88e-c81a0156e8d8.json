  "rdfs:comment": {
    "de": [
      "Begleitung und Bekanntmachung der Ausstellung von Werken von Kunstschaffenden in den Gärten und öffentlichen Räumen von Valaurie in der Region Drôme Provençale. Die 3. Biennale LE TEMPS DES JARDINS A VALAURIE, die am 4., 5. und 6. September 2021 stattfinden sollte, wird abgesagt."
    ],
    "en": [
      "To support and publicize the exhibition of artists' works in the gardens and public spaces of Valaurie, in the Drôme provençale region. The 3rd biennial event LE TEMPS DES JARDINS A VALAURIE, scheduled for September 4, 5 and 6, 2021, has been cancelled."
    ],
    "it": [
      "Accompagnare e pubblicizzare l'esposizione di opere di artisti nei giardini e negli spazi pubblici di Valaurie, nella Drôme provenzale. La terza edizione della manifestazione biennale LE TEMPS DES JARDINS A VALAURIE, che si sarebbe dovuta tenere il 4, 5 e 6 settembre 2021, è stata annullata."
    ],
    "fr": [
      "Accompagner et faire connaître l'exposition d'œuvres de créateurs dans les jardins et espaces publics de Valaurie, en Drôme provençale. La 3ème biennale LE TEMPS DES JARDINS A VALAURIE qui devrait se tenir les 4, 5 et 6 septembre 2021 est annulée."
    ],
    "nl": [
      "Het ondersteunen en bekendmaken van de tentoonstelling van het werk van kunstenaars in de tuinen en openbare ruimten van Valaurie, in de Drôme provençale. Het 3e tweejaarlijkse evenement LE TEMPS DES JARDINS A VALAURIE, dat op 4, 5 en 6 september 2021 zou plaatsvinden, is geannuleerd."
    ],
    "es": [
      "Acompañar y dar a conocer la exposición de obras de artistas en los jardines y espacios públicos de Valaurie, en la Drôme provenzal. El tercer evento bienal LE TEMPS DES JARDINS A VALAURIE, que iba a celebrarse los días 4, 5 y 6 de septiembre de 2021, ha sido cancelado."
    ]
  },
