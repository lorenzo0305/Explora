  "rdfs:comment": {
    "de": [
      "Haiyan Ying, Designerin von Maßkleidung: Prêt-à-porter, Abendkleider, Hochzeitskleider, Kleidungsaccessoires, Umstyling, Änderungen...\r\nIch biete auch Schulungen für Modedesign an."
    ],
    "en": [
      "Haiyan Ying, designer of made-to-measure clothing (ready-to-wear, evening gowns, wedding dresses,clothing accessories, styling training, transformation, retouching...)."
    ],
    "it": [
      "Haiyan Ying, stilista di abbigliamento su misura: prêt-à-porter, abiti da sera, abiti da sposa, accessori per l'abbigliamento, modifiche, variazioni...\r\nOffro anche corsi di styling."
    ],
    "fr": [
      "Haiyan Ying, créatrice de vêtements sur mesure : prêt-à-porter, robes de soirée, robes de mariage, accessoires vestimentaires, transformation, retouche...\r\nJe propose également des formations de stylisme."
    ],
    "nl": [
      "Haiyan Ying, ontwerper van maatkleding (confectie, avondjurken, trouwjurken, enz.)."
    ],
