  "rdfs:comment": {
    "de": [
      "In der Haute Loire, inmitten der Natur... mit Sitz in St Georges Lagricol, 900 m über dem Meeresspiegel, 45 Minuten von Le Puy en Velay, 1 Stunde von Saint Etienne und 1 Stunde 40 von Lyon entfernt... Au Bord de l'Étang ist ein Ort der Gastfreundschaft, der künstlerischen und kulturellen Aktivitäten."
    ],
    "en": [
      "Located in Haute Loire, in the heart of nature... based in St Georges Lagricol, at an altitude of 900 m, 45 minutes from Le Puy en Velay, 1 hour from Saint Étienne, and 1 hour 40 from Lyon... Au Bord de l'Étang is a venue for artistic and cultural activities."
    ],
    "it": [
      "Situato nell'Alta Loira, nel cuore della natura... con sede a St Georges Lagricol, a 900 m di altitudine, a 45 minuti da Le Puy en Velay, a 1 ora da Saint Étienne e a 1 ora e 40 da Lione... Au Bord de l'Étang è una sede di attività artistiche e culturali."
    ],
    "fr": [
      "Situé en Haute Loire, en pleine nature... basé à St Georges Lagricol, à 900 m d'altitude, 45 minutes du Puy en Velay, 1 heure de Saint Étienne, et 1 heure 40 de Lyon... Au Bord de l’Étang est un lieu d'accueil, d'activités artistiques et culturelles."
    ],
    "es": [
      "Situado en el Alto Loira, en plena naturaleza... con sede en St Georges Lagricol, a 900 m de altitud, a 45 minutos de Le Puy en Velay, a 1 hora de Saint Étienne y a 1 hora 40 de Lyon... Au Bord de l'Étang es un lugar de actividades artísticas y culturales."
    ],
    "nl": [
      "Gelegen in de Haute Loire, midden in de natuur... gevestigd in St Georges Lagricol, op 900 m hoogte, op 45 minuten van Le Puy en Velay, 1 uur van Saint Étienne en 1 uur 40 van Lyon... Au Bord de l'Étang is een plek voor artistieke en culturele activiteiten."
    ]
  },
