  "rdfs:comment": {
    "de": [
      "Ein familiärer Reiterhof, auf dem man gerne Ponys und Pferden begegnet. Reitambiente in der freien Natur, wo die Pferde mit größtem Respekt aufgezogen und ausgebildet werden. Ausritte und Gespannfahrten, Kurse während der Schulferien."
    ],
    "en": [
      "Organization of equestrian activities: riding, trail rides, animal traction training, working boarding, saddle and carriage breaking and breeding of working and leisure horses."
    ],
    "it": [
      "Una fattoria equestre a conduzione familiare dove è possibile incontrare i pony e i cavalli. I cavalli sono allevati e addestrati nel massimo rispetto dell'ambiente. Gite a cavallo e in carrozza, corsi durante le vacanze scolastiche."
    ],
    "fr": [
      "Une ferme équestre familiale où il fait bon rencontrer les poneys et les chevaux. Ambiance équitation de pleine nature où les chevaux sont élevés et dressés dans le plus grand respect. Balade à cheval et en attelage, stage pendant les vacances scolaires."
    ],
    "es": [
      "Una granja ecuestre familiar donde podrá conocer a los ponis y caballos. Los caballos se crían y entrenan respetando al máximo el medio ambiente. Paseos a caballo y en carruaje, cursos durante las vacaciones escolares."
    ],
    "nl": [
      "Een familieboerderij waar je de pony's en paarden kunt ontmoeten. De paarden worden gefokt en getraind met het grootste respect voor de omgeving. Ritten met paard en wagen, cursussen tijdens de schoolvakanties."
    ]
  },
  "rdfs:label": {
    "en": [
      "Léon Ninette Farm"
    ],
    "fr": [
      "La Ferme Léon Ninette"
    ]
  },
