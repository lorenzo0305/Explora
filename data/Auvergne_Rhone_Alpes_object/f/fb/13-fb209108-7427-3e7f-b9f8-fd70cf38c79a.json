  "rdfs:comment": {
    "de": [
      "Auf der 700 m langen Via Ferrata können Sie sich bei einer Mischung aus Wandern und Klettern mit hohen Felswänden vertraut machen."
    ],
    "en": [
      "This activity is a cross between hiking and mountaineering. 700 m long, the via ferrata \"Yves Pollet-Villard\" is equipped with ladders, footbridges, ramps and cables. Situated in the Borderan Mountain, the via ferrata is near the Aravis Pass road."
    ],
    "it": [
      "Uno dei modi migliori per provare il brivido dell'arrampicata è la Via Ferrata!"
    ],
    "fr": [
      "Un des meilleurs moyens pour vous procurer les sensations d’escalade est la Via Ferrata !"
    ],
    "es": [
      "Una de las mejores formas de sentir la emoción de la escalada es en una vía ferrata"
    ],
    "nl": [
      "Een van de beste manieren om de sensatie van het klimmen te beleven is op een Via Ferrata!"
    ]
  },
