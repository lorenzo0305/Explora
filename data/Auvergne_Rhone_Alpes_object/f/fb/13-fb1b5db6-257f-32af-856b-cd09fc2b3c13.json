  "rdfs:comment": {
    "de": [
      "Willkommen zur 6. Ausgabe von FESTI'CLAP, dem unumgänglichen Festival der Straßenkunst in Monistrol sur Loire!\r\nVom 29. bis 31. Mai laden wir Sie zu drei Tagen voller Animationen, Theater, Crique, Workshops, Spiele usw. für alle Altersgruppen ein."
    ],
    "en": [
      "Welcome to the 6th edition of FESTI'CLAP, Monistrol sur Loire's not-to-be-missed street arts festival!\r\nFrom May 29 to 31, we invite you to three days of entertainment, theater, crickets, workshops, games and more, for all ages."
    ],
    "it": [
      "Benvenuti alla 6ª edizione di FESTI'CLAP, l'imperdibile festival delle arti di strada di Monistrol sur Loire!\r\nDal 29 al 31 maggio, vi invitiamo a tre giorni di intrattenimento, teatro, cricket, laboratori, giochi, ecc. per tutte le età."
    ],
    "fr": [
      "Bienvenue à la 6ème édition de FESTI'CLAP, le festival incontournable des arts de rue de Monistrol sur Loire ! \r\nDu 29 au 31 mai, nous vous invitons à trois jours d'animations, de théâtre, de crique, d'ateliers, de jeux, etc. pour tous les âges."
    ],
    "nl": [
      "Welkom bij de 6e editie van FESTI'CLAP, het niet te missen straatkunstenfestival in Monistrol sur Loire!\r\nVan 29 tot 31 mei nodigen wij u uit voor drie dagen van entertainment, theater, cricket, workshops, spelletjes, enz. voor alle leeftijden."
    ],
    "es": [
      "Bienvenido a la 6ª edición del FESTI'CLAP, el festival de artes de calle que no se puede perder en Monistrol sur Loire\r\nDel 29 al 31 de mayo, le invitamos a tres días de animaciones, teatro, cricket, talleres, juegos, etc. para todas las edades."
    ]
  },
