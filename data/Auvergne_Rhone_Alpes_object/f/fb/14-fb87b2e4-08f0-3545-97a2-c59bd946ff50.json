  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8330d8c9-64da-3811-85d6-7859216ae449",
      "dc:description": {
        "de": [
          "Seine abwechslungsreiche Speisekarte bietet eine große Auswahl an Tellern, Tacos, Burgern, Sandwiches, Paninis, libanesischen Gerichten, Pommes frites-Schalen, Salaten sowie Kindermenüs."
        ],
        "en": [
          "Its diversified menu offers a wide selection of plates, tacos, burgers, sandwiches, paninis, Lebanese dishes, French fries and salads, as well as children's menus."
        ],
        "it": [
          "Il variegato menu offre un'ampia scelta di piatti, tacos, hamburger, panini, panini, piatti libanesi, patatine e insalate, oltre a menu per bambini."
        ],
        "fr": [
          "Son menu diversifié propose une large sélection d'assiettes, de tacos, de burgers, de sandwichs, de paninis, de plats libanais, de barquettes de frites, de salades, ainsi que des menus enfants."
        ],
        "es": [
          "La variada carta ofrece una amplia selección de platos, tacos, hamburguesas, sándwiches, paninis, platos libaneses, patatas fritas y ensaladas, así como menús infantiles."
        ],
        "nl": [
          "Het gevarieerde menu biedt een ruime keuze aan borden, taco's, hamburgers, sandwiches, panini's, Libanese gerechten, friet en salades, en ook kindermenu's."
        ]
      },
