  "rdfs:comment": {
    "de": [
      "Das Schwimmbad Bellevue in Saint-Quentin-Fallavier bietet Ihnen das ganze Jahr über zahlreiche Wassergymnastik-Aktivitäten. 1 Becken mit 25 m Länge und 4 Schwimmbahnen."
    ],
    "en": [
      "The Bellevue swimming pool, located in Saint-Quentin-Fallavier, welcomes you every day of the week and offers many aquagymic activities throughout the year. 1 pool of 25m integrating 4 swimming lanes."
    ],
    "it": [
      "La piscina Bellevue di Saint-Quentin-Fallavier offre una vasta gamma di attività di acquagym durante tutto l'anno. 1 vasca da 25 m con 4 corsie."
    ],
    "fr": [
      "La piscine Bellevue, située à Saint-Quentin-Fallavier vous propose de nombreuses activités aquagymniques au cours de l'année. 1 bassin de 25m intégrant 4 couloirs de nage."
    ],
    "es": [
      "La piscina Bellevue de Saint-Quentin-Fallavier ofrece una amplia gama de actividades de aquagym durante todo el año. piscina de 1 x 25 m con 4 calles de natación."
    ],
    "nl": [
      "Het zwembad Bellevue in Saint-Quentin-Fallavier biedt het hele jaar door allerlei aquagymactiviteiten. 1 x 25m bad met 4 zwembanen."
    ]
