  "rdfs:comment": {
    "de": [
      "Eine Schatzsuche mit Objekten zum Anfassen und Rätseln, um dieses wunderschöne Dorf, das zu den Schönsten Dörfern Frankreichs® gehört, zu entdecken. Erkunde die Stadt mit einem geheimnisvollen Rucksack, der von Piraten im Tourismusbüro zurückgelassen wurde!"
    ],
    "en": [
      "A treasure hunt with objects to manipulate and riddles to discover this magnificent village labelled one of Les Plus Beaux Villages de France®. Explore the town with a mysterious backpack left behind by pirates at the tourist office!"
    ],
    "it": [
      "Una caccia al tesoro con oggetti da maneggiare e indovinelli per scoprire questo magnifico villaggio, uno dei Borghi più belli di Francia®. Esplorate la città con uno zaino misterioso lasciato dai pirati all'ufficio turistico!"
    ],
    "fr": [
      "Une chasse aux trésors agrémentée d’objets à manipuler et d’énigmes pour découvrir ce magnifique village labélisé parmi Les Plus Beaux Villages de France®. Parcourez la ville avec un mystérieux sac à dos laissé par des pirates à la maison du tourisme !"
    ],
    "es": [
      "Una búsqueda del tesoro con objetos que manipular y acertijos para descubrir este magnífico pueblo, uno de los Pueblos Más Bonitos de Francia®. ¡Explora el pueblo con una misteriosa mochila dejada por piratas en la oficina de turismo!"
    ],
    "nl": [
      "Een speurtocht met voorwerpen en raadsels om dit prachtige dorp, een van de Mooiste Dorpen van Frankrijk®, te ontdekken. Verken het dorp met een mysterieuze rugzak die piraten achterlieten bij het toeristenbureau!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game Outdoor \" Les Pierres du Temps\""
    ]
  },
