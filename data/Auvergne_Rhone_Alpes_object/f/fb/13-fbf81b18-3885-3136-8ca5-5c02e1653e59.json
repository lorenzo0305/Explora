  "rdfs:comment": {
    "de": [
      "Wellness-Leistungen in Verbindung mit der Natur: Waldtherapie/Waldbäder, Themenworkshops, geführte Audios zur Entspannung, Online-Begleitung, um sich um sich selbst zu kümmern und aus seiner Sensibilität und Diskretion eine Stärke zu machen."
    ],
    "en": [
      "Well-being services linked to nature: silvotherapy/forest baths, thematic workshops, guided relaxation audios, online support to take care of yourself and make your sensitivity and discretion a strength."
    ],
    "it": [
      "Servizi di benessere legati alla natura: silvoterapia/bagni nella foresta, laboratori tematici, audioguide di rilassamento, supporto online per prendersi cura di sé e trasformare la propria sensibilità e discrezione in forza."
    ],
    "fr": [
      "Prestations de bien-être en lien avec la nature : sylvothérapie/bains de forêt, ateliers thématiques, audios guidés détente, accompagnement en ligne pour prendre soin de soi et  faire de sa sensibilité et de sa discrétion une force."
    ],
    "es": [
      "Servicios de bienestar relacionados con la naturaleza: silvoterapia/baños en el bosque, talleres temáticos, audioguías de relajación, apoyo en línea para cuidarse y convertir su sensibilidad y discreción en fortaleza."
    ],
    "nl": [
      "Natuurgerelateerde welzijnsdiensten: sylvotherapie/bosbaden, themaworkshops, audio-gidsen voor ontspanning, online ondersteuning om voor jezelf te zorgen en je gevoeligheid en discretie om te zetten in kracht."
    ]
  },
