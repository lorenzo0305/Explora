  "rdfs:comment": {
    "de": [
      "In der Nähe der romanischen Kapelle von Saint Martin de Galéjas empfängt Sie die Käserei Brunière, um Ihnen ihren Picodon und andere Ziegenkäsesorten vorzustellen. Verkauf vor Ort."
    ],
    "en": [
      "Near the Romanesque chapel of Saint Martin de Galéjas, the Brunière cheese dairy welcomes you to discover its Picodon and other goat cheeses. On-site sales."
    ],
    "it": [
      "Vicino alla cappella romanica di Saint Martin de Galéjas, il caseificio Brunière vi accoglie per farvi scoprire il suo Picodon e altri formaggi di latte di capra. Vendita sul posto."
    ],
    "fr": [
      "A proximité de la Chapelle Romane de Saint Martin de Galéjas, la fromagerie Brunière vous accueille pour vous faire découvrir son Picodon et autres fromages de chèvre. Vente sur place."
    ],
    "nl": [
      "Vlakbij de Romaanse kapel van Saint Martin de Galéjas verwelkomt de kaasmakerij Brunière je om zijn Picodon en andere geitenkazen te ontdekken. Verkoop ter plaatse."
    ],
    "es": [
      "Cerca de la capilla románica de Saint Martin de Galéjas, la quesería Brunière le da la bienvenida para que descubra su Picodon y otros quesos de leche de cabra. Venta in situ."
    ]
  },
