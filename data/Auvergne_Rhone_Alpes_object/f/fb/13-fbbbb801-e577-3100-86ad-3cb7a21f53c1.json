  "rdfs:comment": {
    "de": [
      "Der Club Numismatique Histoire et Archéologie de Pierrelatte hat sich zum Ziel gesetzt, die Kenntnisse über Münzen, Medaillen, Postkarten und alte Papiere im Zusammenhang mit der Geschichte im Allgemeinen und der Geschichte von Pierrelatte im Besonderen zu erweitern."
    ],
    "en": [
      "The Club Numismatique Histoire et Archéologie de Pierrelatte aims to develop knowledge of coins, medals, postcards and old papers relating to history in general and Pierrelatte in particular."
    ],
    "it": [
      "Il Club Numismatique Histoire et Archéologie de Pierrelatte si propone di sviluppare la conoscenza di monete, medaglie, cartoline e documenti antichi legati alla storia in generale e a Pierrelatte in particolare."
    ],
    "fr": [
      "Le Club Numismatique Histoire et Archéologie de Pierrelatte a pour but le développement des connaissances sur les monnaies, les médailles, les cartes postales, les vieux papiers en rapport avec l'histoire en général et celle de Pierrelatte en particulier."
    ],
    "es": [
      "El Club Numismatique Histoire et Archéologie de Pierrelatte tiene como objetivo desarrollar el conocimiento de las monedas, medallas, tarjetas postales y papeles antiguos relacionados con la historia en general y con Pierrelatte en particular."
    ],
    "nl": [
      "De Club Numismatique Histoire et Archéologie de Pierrelatte heeft als doel het ontwikkelen van kennis over munten, medailles, ansichtkaarten en oude papieren met betrekking tot geschiedenis in het algemeen en Pierrelatte in het bijzonder."
    ]
  },
