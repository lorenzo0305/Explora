  "rdfs:comment": {
    "de": [
      "Entdecken Sie den traditionellen Lavendelanbau, geführt vom Erzeuger, lernen Sie die Geschichte des Lavendels kennen, führen Sie sich in das Schneiden mit der Sichel und der Schaufel ein, wiegen Sie Ihre Ernte, wohnen Sie der Destillation Ihrer Ernte bei."
    ],
    "en": [
      "Discover the traditional cultivation of lavender, guided by the grower, learn about the history of lavender, learn how to cut lavender with a sickle and a saquette, weigh your harvest and watch it being distilled."
    ],
    "it": [
      "Scoprite la coltivazione tradizionale della lavanda, guidati dal coltivatore, conoscete la storia della lavanda, imparate a tagliarla con un falcetto e una saquette, pesate il vostro raccolto e assistete alla sua distillazione."
    ],
    "fr": [
      "Découvrez la culture traditionnelle de la lavande, guidés par le producteur, découvrez l’histoire de la lavande, initiez-vous à la coupe à la faucille et à la saquette, pesez votre récolte, assistez à la distillation de votre récolte."
    ],
    "nl": [
      "Ontdek de traditionele teelt van lavendel, begeleid door de kweker, leer meer over de geschiedenis van lavendel, leer lavendel snijden met een sikkel en een saquette, weeg je oogst en kijk hoe het wordt gedistilleerd."
    ],
    "es": [
      "Descubra el cultivo tradicional de la lavanda, guiado por el cultivador, conozca la historia de la lavanda, aprenda a cortar la lavanda con una hoz y una saqueta, pese su cosecha y observe cómo se destila."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sortie Lavande dans la peau d'un lavandier"
    ]
  },
