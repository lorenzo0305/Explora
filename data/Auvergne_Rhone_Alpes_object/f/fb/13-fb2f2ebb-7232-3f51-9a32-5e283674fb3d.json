  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Besse-en-Oisans, das als bemerkenswerter Ort eingestuft wurde, befindet sich die Maison des Alpages, die ein Museum, einen Filmraum und Ausstellungen über die Weidewirtschaft umfasst. Sie bietet auch Ausflüge zu den Herden und Hirten an."
    ],
    "en": [
      "In the heart of the village of Besse-en-Oisans, classified as a remarkable site, the Maison des Alpages houses a museum, a projection room and exhibitions dedicated to pastoralism. It also offers outings to meet the herds and shepherds."
    ],
    "it": [
      "Nel cuore del villaggio di Besse-en-Oisans, classificato come sito straordinario, la Maison des Alpages ospita un museo, una sala di proiezione e mostre dedicate alla pastorizia. Offre anche escursioni per incontrare le mandrie e i pastori."
    ],
    "fr": [
      "Au cœur du village classé site remarquable de Besse-en-Oisans, la Maison des Alpages rassemble un musée, une salle de projection et des expositions dédiées au pastoralisme. Elle propose également des sorties à la rencontre des troupeaux et bergers."
    ],
    "nl": [
      "In het hart van het dorp Besse-en-Oisans, dat geklasseerd is als opmerkelijke site, herbergt het Maison des Alpages een museum, een projectiezaal en tentoonstellingen gewijd aan de herderseconomie. Het biedt ook uitstapjes aan om de kuddes en herders te ontmoeten."
    ],
    "es": [
      "En el corazón del pueblo de Besse-en-Oisans, clasificado como sitio notable, la Maison des Alpages alberga un museo, una sala de proyecciones y exposiciones dedicadas al pastoreo. También ofrece salidas al encuentro de los rebaños y los pastores."
    ]
  },
  "rdfs:label": {
