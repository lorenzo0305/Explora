  "rdfs:comment": {
    "de": [
      "Im Stade Pompidou findet das 13. Spiel der Saison zwischen den Mannschaften von Valence und Colomiers statt. Die beiden Vereine mit ihren jeweiligen Geschichten und Leidenschaften bereiten sich darauf vor, ein energiegeladenes und spannendes Spektakel zu bieten."
    ],
    "en": [
      "The Stade Pompidou will play host to the 13th match of the season between Valence and Colomiers. The two clubs, with their respective histories and passions, are preparing to put on a show full of energy and suspense."
    ],
    "it": [
      "Lo Stade Pompidou ospiterà la 13ª partita della stagione tra Valence e Colomiers. I due club, con le rispettive storie e passioni, si preparano a dare vita a uno spettacolo pieno di energia e suspense."
    ],
    "fr": [
      "Le stade Pompidou accueillera le 13ème match de la saison entre les équipes de Valence et Colomiers. Les deux clubs, avec leurs histoires et leurs passions respectives, se préparent à offrir un spectacle plein d'énergie et de suspense."
    ],
    "nl": [
      "Het Stade Pompidou zal gastheer zijn voor de 13e wedstrijd van het seizoen tussen Valence en Colomiers. De twee clubs, met hun respectievelijke geschiedenis en passies, bereiden zich voor op een show vol energie en spanning."
    ],
    "es": [
      "El Estadio Pompidou acogerá el 13º partido de la temporada entre el Valence y el Colomiers. Los dos clubes, con sus respectivas historias y pasiones, se preparan para ofrecer un espectáculo lleno de energía y suspense."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Match VRDR vs Colomiers"
    ]
  },
