  "rdfs:comment": {
    "de": [
      "der Etang du Maupas hat eine Fläche von 1,8 ha.\nAngelarten: Karpfen, Hecht, Schleie, Forelle und Wels.\nStandort für Handi-Fischerei.\nAngelschein erforderlich."
    ],
    "en": [
      "The Etang du Maupas covers an area of 1.8 hectares.\nTypes of fishing: carp, pike, tench, trout and catfish.\nFishing for the disabled site.\nFishing licence required."
    ],
    "it": [
      "l'Etang du Maupas si estende su una superficie di 1,8 ettari.\nTipi di pesca: carpa, luccio, tinca, trota e pesce gatto.\nSito di pesca a mano.\nÈ richiesta la licenza di pesca."
    ],
    "fr": [
      "l' Etang du Maupas a une superficie de 1,8 Ha.\nType de pêche : carpe, brochet,tanche, truite et silure.\nSite Handi-pêche.\nPermis pêche obligatoire."
    ],
    "es": [
      "el Etang du Maupas tiene una superficie de 1,8 hectáreas.\nTipos de pesca: carpa, lucio, tenca, trucha y siluro.\nLugar de pesca artesanal.\nLicencia de pesca obligatoria."
    ],
    "nl": [
      "De Etang du Maupas heeft een oppervlakte van 1,8 hectare.\nVissoorten: karper, snoek, zeelt, forel en meerval.\nHandi-pêche website.\nVisvergunning verplicht."
    ]
  },
