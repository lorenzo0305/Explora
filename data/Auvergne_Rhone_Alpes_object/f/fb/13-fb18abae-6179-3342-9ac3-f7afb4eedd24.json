          "additionalInformation": {
            "de": [
              "Geöffnet:\r\n- mittags von 11:00 bis 14:30 Uhr von Mittwoch bis Samstag\r\n- abends von 18:00 bis 21:30 Uhr am Mittwoch und Donnerstag und von 18:00 bis 22:00 Uhr am Freitag und Samstag.\r\nSonntag ab 17:00 Uhr bis 21:30 Uhr geöffnet."
            ],
            "en": [
              "Open :\r\n- lunch from 11:00 to 14:30 Wednesday to Saturday\r\n- evening from 6pm to 9:30pm on Wednesday and Thursday and from 6pm to 10pm on Friday and Saturday.\r\nSunday open from 5pm to 9:30pm."
            ],
            "it": [
              "Aperto per :\r\n- a pranzo dalle 11:00 alle 14:30 da mercoledì a sabato\r\n- la sera dalle 18.00 alle 21.30 il mercoledì e il giovedì e dalle 18.00 alle 22.00 il venerdì e il sabato.\r\nDomenica aperto dalle 17.00 alle 21.30."
            ],
            "fr": [
              "Ouvert :\r\n- le midi de 11h00 à 14h30 du mercredi au samedi \r\n- le soir de 18h à 21h30 du mercredi et jeudi et de 18h à 22h du vendredi au samedi.\r\nDimanche ouvert à partir de 17h00 à 21h30."
            ],
            "nl": [
              "Open voor :\r\n- lunchtijd van 11 tot 14.30 uur van woensdag tot zaterdag\r\n- 's avonds van 18.00 tot 21.30 uur op woensdag en donderdag en van 18.00 tot 22.00 uur op vrijdag en zaterdag.\r\nZondag open van 17.00 tot 21.30 uur."
            ],
            "es": [
              "Abierto para :\r\n- al mediodía, de 11.00 a 14.30 h, de miércoles a sábado\r\n- por la noche, de 18.00 a 21.30 h el miércoles y el jueves, y de 18.00 a 22.00 h el viernes y el sábado.\r\nDomingo abierto de 17h00 a 21h30."
            ]
          },
