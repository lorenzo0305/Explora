  "rdfs:comment": {
    "de": [
      "Keramikerin & bildende Künstlerin. Modellier-, Bildhauer- und Drechselkurse wöchentlich, jährlich oder pauschal, Erwachsene/Kinder. Töpferei- und Keramikkurse. Poetische Kreationen von Hand und mit Liebe gemacht. Personalisierte Kreationen und Bestellungen auf Anfrage. Geschenkgutscheine."
    ],
    "en": [
      "Ceramist & artist. Modeling, sculpture and throwing lessons weekly, yearly or fixed price, adult/child. Pottery and ceramics workshops. Poetic creations handmade with love. Custom creations and orders on request. Gift vouchers available."
    ],
    "it": [
      "Ceramista e artista visivo. Lezioni di modellazione, scultura e lancio settimanali, annuali o a prezzo fisso, adulto/bambino. Corsi di ceramica e ceramica. Creazioni poetiche fatte a mano con amore. Creazioni e ordini personalizzati su richiesta. Buoni regalo disponibili."
    ],
    "fr": [
      "Céramiste & artiste plasticienne. Cours de modelage, sculpture et tournage hebdo, année ou forfait, adulte/enfant. Stage poterie et céramique. Créations poétiques faites main et avec amour. Créations personnalisées et commandes sur demande. Bons cadeaux."
    ],
    "nl": [
      "Keramist en beeldend kunstenaar. Boetseer-, beeldhouw- en werplessen per week, per jaar of vaste prijs, volwassene/kind. Cursussen pottenbakken en keramiek. Poëtische creaties met de hand en met liefde gemaakt. Gepersonaliseerde creaties en bestellingen op aanvraag. Cadeaubonnen beschikbaar."
    ],
    "es": [
      "Ceramista y artista visual. Clases de modelado, escultura y lanzamiento semanales, anuales o a precio fijo, adulto/niño. Cursos de alfarería y cerámica. Creaciones poéticas hechas a mano con amor. Creaciones personalizadas y encargos por encargo. Cheques regalo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de céramique Marine Klaa"
    ]
  },
