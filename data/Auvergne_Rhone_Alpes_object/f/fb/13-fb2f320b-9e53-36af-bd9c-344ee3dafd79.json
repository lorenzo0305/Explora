  "rdfs:comment": {
    "de": [
      "Das Grand Hôtel Montespan Talleyrand ist ein charmantes und charaktervolles Haus mit großem Komfort, ideal für Ihren Wunsch nach einer Flucht aus dem Alltag."
    ],
    "en": [
      "The Grand Hôtel Montespan Talleyrand is a charming, character-filled establishment with a high level of comfort, ideal for those who want to get away from it all."
    ],
    "it": [
      "Il Grand Hôtel Montespan Talleyrand è una struttura affascinante, ricca di carattere e con un elevato livello di comfort, ideale per staccare la spina."
    ],
    "fr": [
      "Le Grand Hôtel Montespan Talleyrand est un établissement de charme et de caractère au grand confort, idéal pour vos envies d'évasion."
    ],
