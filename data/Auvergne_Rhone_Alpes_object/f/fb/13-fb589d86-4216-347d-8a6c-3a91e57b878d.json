  "rdfs:comment": {
    "de": [
      "Wir laden Sie ein, das Leben in all seiner Schönheit und Intensität zu feiern! Straßenkünste, Zirkus, Entreresorts, intime Aufführungen, Konzerte, Handwerker, Guinguette und Verpflegung vor Ort."
    ],
    "en": [
      "We invite you to celebrate life in all its beauty and intensity! Street arts, circus, entresorts, intimate shows, concerts, craftspeople, guinguette and on-site catering."
    ],
    "it": [
      "Vi invitiamo a celebrare la vita in tutta la sua bellezza e intensità! Arti di strada, circo, entresort, spettacoli intimi, concerti, artigiani, guinguette e catering in loco."
    ],
    "fr": [
      "Nous vous invitons à célébrer la vie, dans toute sa beauté et son intensité ! Arts de rue, cirque, entresorts, spectacles intimistes, concerts, artisan.e.s, guinguette et restauration sur place."
    ],
    "nl": [
      "We nodigen je uit om het leven te vieren in al zijn schoonheid en intensiteit! Straatkunsten, circus, entresorts, intieme shows, concerten, ambachtslieden, guinguette en catering ter plaatse."
    ],
    "es": [
      "Le invitamos a celebrar la vida en toda su belleza e intensidad Artes de calle, circo, entresijos, espectáculos íntimos, conciertos, artesanos, guinguette y catering in situ."
    ]
  },
