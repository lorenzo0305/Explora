  "rdfs:comment": {
    "de": [
      "Auf dem Plateau de la Croix, am Anfang der Pisten und Wanderwege, proﬁtieren Sie von einer Panoramaterrasse mit einem magniﬁschen Blick auf das Mont-Blanc-Massiv."
    ],
    "en": [
      "Located at Plateau de la Croix, at the foot of the ski slopes and hiking trails, this restaurant boasts a panoramic terrace with magniﬁcent views of the Mont Blanc\r\nrange. In winter a relaxed family self-service and in summer, delicious cuisine  in a rural setting."
    ],
    "it": [
      "Al Plateau de la Croix, a partire dalle piste e dai sentieri escursionistici, approfittate di una terrazza panoramica con una vista magnifica sul massiccio del Monte Bianco. In inverno self informale e familiare, in estate gustosa cucina e ambiente bucolico."
    ],
    "fr": [
      "Au Plateau de la Croix, au départ des pistes et des sentiers de randonnées, vous proﬁterez d’une terrasse panoramique avec une vue magniﬁque sur le massif du Mont Blanc."
    ],
    "nl": [
      "Op het Plateau de la Croix, aan het begin van de pistes en wandelpaden, vindt u een panoramisch terras met een magnifiek uitzicht op het Mont Blanc-massief."
    ],
    "es": [
      "En el Plateau de la Croix, al inicio de las pistas y rutas de senderismo, disfrutará de una terraza panorámica con una magnífica vista del macizo del Mont Blanc."
    ]
  },
