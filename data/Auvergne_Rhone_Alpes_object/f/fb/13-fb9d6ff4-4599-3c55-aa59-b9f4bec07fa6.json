  "rdfs:comment": {
    "de": [
      "Das städtische Schwimmbad in Passy besteht aus einem einzigen 25 m langen Becken mit einer Tiefe von 0,95 m bis 2,15 m. In den Sommermonaten profitieren Sie von der Öffnung zu einem schattigen Park."
    ],
    "en": [
      "The Passy municipal swimming pool features a single 25m pool, with depths ranging from 0.95 m to 2.15 m. In summer, the pool opens onto a shady park."
    ],
    "it": [
      "La piscina comunale di Passy dispone di un'unica vasca di 25 metri con una profondità che varia da 0,95 a 2,15 metri. Durante i mesi estivi, la piscina si apre su un parco ombreggiato."
    ],
    "fr": [
      "La piscine municipale de Passy se compose d'un bassin unique de 25m, d'une profondeur de  0,95 m à 2,15 m. En période estivale, profitez de l'ouverture sur un parc ombragé."
    ],
    "es": [
      "La piscina municipal de Passy dispone de una sola piscina de 25 m con una profundidad que oscila entre 0,95 m y 2,15 m. Durante los meses de verano, la piscina se abre a un parque sombreado."
    ],
    "nl": [
      "Het gemeentelijk zwembad van Passy bestaat uit één bad van 25m, met een diepte van 0,95m tot 2,15m. Profiteer in de zomer van de opening naar een schaduwrijk park."
    ]
  },
  "rdfs:label": {
    "de": [
      "Schwimmbad marlioz"
    ],
    "en": [
      "Swimming Pool in Marlioz"
    ],
    "fr": [
      "Piscine de Marlioz"
    ]
  },
