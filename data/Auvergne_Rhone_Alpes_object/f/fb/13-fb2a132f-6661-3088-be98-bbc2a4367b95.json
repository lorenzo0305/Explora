  "rdfs:comment": {
    "de": [
      "Ein Restaurant an einem vielseitigen Ort, La grange de babel, das einen Coworking Space, eine Hebamme, eine Osteopathin und ein großes Potenzial für Freizeit- und Arbeitsaktivitäten beherbergt."
    ],
    "en": [
      "A restaurant in a multi-purpose venue, La grange de babel, which hosts a coworking space, a midwife, an osteopath and a vast array of leisure and work activities."
    ],
    "it": [
      "Un ristorante in un locale polivalente, La grange de babel, che ospita uno spazio di coworking, un'ostetrica, un osteopata e un'ampia gamma di attività ricreative e lavorative."
    ],
    "fr": [
      "Un restaurant dans un lieu polyvalent, La grange de babel, qui accueille un espace de coworking, une sage-femme, une ostéopathe et un vaste potentiel d’activités, soit de loisir, soit de travail."
    ],
    "es": [
      "Un restaurante en un local polivalente, La grange de babel, que alberga un espacio de coworking, una comadrona, un osteópata y un amplio abanico de actividades de ocio y trabajo."
    ],
    "nl": [
      "Een restaurant in een multifunctionele locatie, La grange de babel, die onderdak biedt aan een coworkingruimte, een verloskundige, een osteopaat en een breed scala aan vrijetijds- en werkactiviteiten."
    ]
  },
  "rdfs:label": {
