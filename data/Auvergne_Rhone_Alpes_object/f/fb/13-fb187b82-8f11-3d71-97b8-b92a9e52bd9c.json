  "rdfs:comment": {
    "de": [
      "Die Association Communale de Chasse Agréée de Saint-Laurent-en-Royans sorgt für die Instandhaltung der Wege und Pfade in den Bergen, koordiniert das jagdliche Management der Wildtiere und achtet darauf, dass die Jagd nicht missbräuchlich ausgeübt wird"
    ],
    "en": [
      "The Association Communale de Chasse Agréée de Saint-Laurent-en-Royans (Saint-Laurent-en-Royans local hunting association) looks after the upkeep of mountain paths and trails, coordinates the hunting management of wildlife and ensures that hunting is not abused"
    ],
    "it": [
      "L'Association Communale de Chasse Agréée de Saint-Laurent-en-Royans (associazione venatoria locale di Saint-Laurent-en-Royans) si occupa della manutenzione dei sentieri e delle piste di montagna, coordina la gestione venatoria della fauna selvatica e vigila affinché la caccia non venga praticata abusivamente"
    ],
    "fr": [
      "L'Association Communale de Chasse Agréée de Saint-Laurent-en-Royans veille à l'entretien des chemins et sentiers en montagne, coordonne la gestion cynégétique de la faune sauvage et veille à ce que la chasse ne soit pas abusive"
    ],
    "es": [
      "La Association Communale de Chasse Agréée de Saint-Laurent-en-Royans (Asociación Local de Caza de Saint-Laurent-en-Royans) vela por el mantenimiento de los caminos y senderos de montaña, coordina la gestión cinegética de la fauna salvaje y vela por que no se abuse de la caza"
    ],
    "nl": [
      "De Association Communale de Chasse Agréée de Saint-Laurent-en-Royans (de plaatselijke jachtvereniging van Saint-Laurent-en-Royans) zorgt voor het onderhoud van de bergpaden en -paden, coördineert het jachtbeheer van de wilde fauna en ziet erop toe dat er geen misbruik wordt gemaakt van de jacht"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Communale de Chasse Agréée"
    ]
  },
