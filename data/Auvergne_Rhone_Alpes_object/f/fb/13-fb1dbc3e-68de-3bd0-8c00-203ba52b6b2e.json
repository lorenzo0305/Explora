  "rdfs:comment": {
    "de": [
      "Olivier, ein staatlich geprüfter Mountainbike-Lehrer, begleitet Sie auf den ausgetretenen Pfaden der Haute Loire, auf dem Grünen Weg und überall in der Haute Loire.\r\nEntdeckung Orientierungslauf"
    ],
    "en": [
      "Olivier, a state-certified mountain bike instructor, will accompany you on the beaten tracks of the Haute Loire, on the voie verte and everywhere else in the Haute Loire.\r\nDiscover orienteering"
    ],
    "it": [
      "Olivier, istruttore di mountain bike diplomato, vi accompagnerà sui sentieri battuti dell'Alta Loira, sulla voie verte e ovunque nell'Alta Loira.\r\nScoprire l'orienteering"
    ],
    "fr": [
      "Olivier, moniteur de VTT diplômé d'état vous accompagne  sur les sentiers battus de la Haute Loire, sur la voie verte et partout en Haute Loire.\r\nDécouverte course d'orientation"
    ],
    "es": [
      "Olivier, monitor de BTT diplomado por el Estado, le acompañará por los caminos trillados del Alto Loira, por la voie verte y por todos los rincones del Alto Loira.\r\nDescubrir la orientación"
    ],
    "nl": [
      "Olivier, een door de staat gediplomeerd mountainbike-instructeur, zal je begeleiden op de gebaande paden van de Haute Loire, op de voie verte en overal elders in de Haute Loire.\r\nOntdek oriëntatieloop"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Olivier Bonnet - Guide de Randonnée"
    ]
  },
