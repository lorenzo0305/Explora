  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Multiaktivitäten:\r\n- Quad-, Motorrad- und Karting-Touren\r\n- Quad-, Motorrad- und Buggytouren\r\n- Paint Ball\r\n- Neuheit 2026 Karting Drift.\r\nFür Ihre Seminare, Gruppen, Junggesellenabschiede organisieren wir Ihren Aufenthalt nach Maß."
    ],
    "en": [
      "Discover our multi activities:\r\n- Quad, Motorcycle and Karting Tours\r\n- Quad, Motorbike and Buggy tours\r\n- Paint Ball\r\n- New in 2026: drift karting\r\nFor your seminars, groups or stag parties, we'll organize a tailor-made stay."
    ],
    "it": [
      "Scoprite la nostra gamma di attività:\r\n- Tour in Quad, Moto e Karting\r\n- Tour in quad, moto e buggy\r\n- Paint Ball\r\n- Novità del 2026: drift karting\r\nPer i vostri seminari, gruppi o addii al celibato, possiamo organizzare un soggiorno su misura."
    ],
    "fr": [
      "Découvrez nos multi activités :\r\n- Circuit Quad, Moto et Karting\r\n- Randonnée Quad, Moto et Buggy\r\n- Paint Ball\r\n- Nouveauté 2026 karting drift\r\nPour vos séminaires, groupes, enterrement de vie de garçons, nous organisons votre séjour sur mesure."
    ],
    "nl": [
      "Ontdek onze reeks activiteiten:\r\n- Quad-, motor- en kartsafari's\r\n- Quad-, motor- en buggytours\r\n- Verfbal\r\n- Nieuw in 2026: driftkarten\r\nVoor uw seminars, groepen of vrijgezellenfeesten kunnen we een verblijf op maat organiseren."
    ],
    "es": [
      "Descubra nuestra gama de actividades:\r\n- Excursiones en quad, moto y karting\r\n- Quad, Moto y Buggy\r\n- Paint Ball\r\n- Novedad 2026: karting a la deriva\r\nPara sus seminarios, grupos o despedidas de soltero, podemos organizar una estancia a medida."
    ]
  },
