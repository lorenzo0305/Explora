  "rdfs:comment": {
    "de": [
      "Restaurant mit 2* im Guide Michelin.\r\nIn einem an ewige Savoie erinnernden Kokon, schlagen die Chef René und Maxime Meilleur eine moderne und erfinderische Küche vor, die von Natur inspiriert ist."
    ],
    "en": [
      "2 star Michelin restaurant. \r\nIn a setting evocative of Savoie, chefs René and Maxime Meilleur create modern and inventive cuisine inspired by nature."
    ],
    "it": [
      "Ristorante 2* stellato Michelin a Saint Martin de Belleville\r\nIn un bozzolo che ricorda l'eterna Savoia, gli chef René e Maxime Meilleur propongono una cucina moderna e inventiva ispirata alla natura."
    ],
    "fr": [
      "Restaurant classé 2* au Guide Michelin à Saint Martin de Belleville\r\nDans un cocon évoquant la Savoie éternelle, les chefs René et Maxime Meilleur proposent une cuisine moderne et inventive, inspirée par la nature."
    ],
    "es": [
      "Restaurante con 2 estrellas Michelin en Saint Martin de Belleville\r\nEn un capullo que recuerda a la eterna Saboya, los chefs René y Maxime Meilleur ofrecen una cocina moderna e inventiva inspirada en la naturaleza."
    ],
    "nl": [
      "2* sterren restaurant in Saint Martin de Belleville\r\nIn een cocon die doet denken aan de eeuwige Savoie, bieden chef-koks René en Maxime Meilleur moderne, inventieve gerechten geïnspireerd door de natuur."
    ]
  },
