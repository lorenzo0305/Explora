  "rdfs:comment": {
    "de": [
      "Berufsfotograf seit 30 Jahren, erfahren im Fotografieren von Events und Reportagen. Ich biete auch fotografische Dekoration an, eine regionalistische Fotothek steht zur Verfügung. Ein Studio steht ebenfalls zu Ihren Diensten."
    ],
    "en": [
      "I've been a professional photographer for 30 years, with experience shooting events and reports. I also offer photo decoration, and a regional photo library is available. A studio is also at your service."
    ],
    "it": [
      "Sono un fotografo professionista da 30 anni, con esperienza di riprese di eventi e reportage. Offro anche decorazioni fotografiche ed è disponibile una fototeca regionale. È disponibile anche uno studio fotografico."
    ],
    "fr": [
      "Photographe professionnel depuis 30 ans, expérimenté en prise de vue sur évènementiels et reportages. Je propose aussi de la décoration photographique, une photothèque régionaliste est disponible. Un studio est également à votre service."
    ],
    "es": [
      "Soy fotógrafo profesional desde hace 30 años, con experiencia en la realización de eventos y reportajes. También ofrezco decoración fotográfica y dispongo de una fototeca regional. También tengo un estudio a su disposición."
    ],
    "nl": [
      "Ik ben al 30 jaar professioneel fotograaf, met ervaring in het fotograferen van evenementen en reportages. Ik bied ook fotografische decoratie aan en er is een regionale fototheek beschikbaar. Een studio staat ook tot uw beschikking."
    ]
  },
  "rdfs:label": {
