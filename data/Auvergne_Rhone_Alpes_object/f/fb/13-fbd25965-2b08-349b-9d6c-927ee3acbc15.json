  "rdfs:comment": {
    "de": [
      "Das in Porcieu-Amblagnieu gelegene Le Bistroquet ist ein geselliger Ort, der in einem schönen, vollständig renovierten Gebäude untergebracht ist. Restaurant, Bar und Tante-Emma-Laden. David und Romain, zwei leidenschaftliche Genießer, empfangen Sie mit Großzügigkeit und guter Laune."
    ],
    "en": [
      "Located in Porcieu-Amblagnieu, Le Bistroquet is a friendly place set in a completely renovated building. Restaurant, bar and local grocery store, David and Romain, two passionate epicureans, welcome you with generosity and good humor."
    ],
    "it": [
      "Situato a Porcieu-Amblagnieu, Le Bistroquet è un locale accogliente situato in un edificio splendidamente ristrutturato. Ristorante, bar e negozio di alimentari locale, David e Romain, due appassionati epicurei, vi accolgono con generosità e buon umore."
    ],
    "fr": [
      "Situé à Porcieu-Amblagnieu, Le Bistroquet est un lieu convivial installé dans une belle bâtisse entièrement rénovée. Restaurant, bar et épicerie de proximité, David et Romain, deux épicuriens passionnés, vous accueillent avec générosité et bonne humeur."
    ],
    "es": [
      "Situado en Porcieu-Amblagnieu, Le Bistroquet es un lugar acogedor ubicado en un bonito edificio renovado. Restaurante, bar y tienda de comestibles locales, David y Romain, dos epicúreos apasionados, le dan la bienvenida con generosidad y buen humor."
    ],
    "nl": [
      "Le Bistroquet, gelegen in Porcieu-Amblagnieu, is een gezellige plek in een prachtig gerenoveerd gebouw. Restaurant, bar en plaatselijke kruidenierswinkel. David en Romain, twee gepassioneerde levensgenieters, verwelkomen u met gulheid en een goed humeur."
    ]
  },
  "rdfs:label": {
