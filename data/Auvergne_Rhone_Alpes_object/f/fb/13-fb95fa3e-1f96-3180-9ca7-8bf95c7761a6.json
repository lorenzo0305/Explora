  "rdfs:comment": {
    "de": [
      "Anbau von Getreide (alte Sorten), Mehl auf Mühlsteinen, Brot mit Natursauerteig. Alles in bäuerlicher Agrarökologie."
    ],
    "en": [
      "Grain cultivation (ancient varieties), stone-ground flour, natural sourdough bread. All part of an agroecological approach."
    ],
    "it": [
      "Coltivazione di cereali (varietà autoctone), farina macinata a pietra e pane a lievitazione naturale. Il tutto nell'ambito di un approccio di agroecologia rurale."
    ],
    "fr": [
      "Culture de céréales (variétés anciennes), farines sur meule de pierre, pain au levain naturel. Le tout en agroécologie paysanne."
    ],
    "nl": [
      "Het telen van granen (heirloom variëteiten), steengemalen meel en natuurlijk zuurdesembrood. Allemaal onderdeel van een landelijke agro-ecologische aanpak."
    ],
    "es": [
      "Cultivo de cereales (variedades autóctonas), harina molida a la piedra y pan de masa madre natural. Todo ello en el marco de la agroecología rural."
    ]
  },
