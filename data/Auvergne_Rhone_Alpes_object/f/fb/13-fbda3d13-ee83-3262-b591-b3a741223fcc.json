  "rdfs:comment": {
    "de": [
      "Salate, Burger, Fleisch, belegte Brote. 200 m von Ciné Dôme entfernt. Riesige Leinwand. Lounge. Rockkonzert jeden Donnerstag. Themenabende jeden Freitag. HD-Sportübertragungen."
    ],
    "en": [
      "Salads, burgers, meats, toast. 200 yards from the Cinema Dome. Giant screen. Lounge. Rock concert every Thursday. Theme night every Friday. HD sports broadcasts."
    ],
    "it": [
      "Insalate, hamburger, carne, panini. A 200 m dal Ciné Dôme. Schermo gigante. Salone. Concerto rock ogni giovedì. Serate a tema ogni venerdì. Trasmissioni sportive in HD."
    ],
    "fr": [
      "Salades, burger, viandes, tartines. À 200 m de Ciné Dôme. Ecran géant. Lounge. Concert rock tous les jeudis. Soirée à thème tous les vendredis. Retransmission sportives HD."
    ],
    "nl": [
      "Salades, hamburgers, vlees, sandwiches. 200 m van Ciné Dôme. Groot scherm. Lounge. Rockconcert elke donderdag. Elke vrijdag thema-avonden. HD sportuitzendingen."
    ],
    "es": [
      "Ensaladas, hamburguesas, carnes, sándwiches. A 200 m del Ciné Dôme. Pantalla gigante. Salón. Concierto de rock todos los jueves. Noches temáticas todos los viernes. Retransmisiones deportivas en HD."
    ]
  },
  "rdfs:label": {
