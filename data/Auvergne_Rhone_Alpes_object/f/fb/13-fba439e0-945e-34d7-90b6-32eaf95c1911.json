  "rdfs:comment": {
    "de": [
      "Mein Vorname ist Y, ich bin Vietnamesin. Ich biete Ihnen traditionelle vietnamesische Gerichte an: Ich erwarte Sie in meiner kleinen blauen Estafette, um sie zu testen!"
    ],
    "en": [
      "My first name is Y, and I'm Vietnamese. I offer traditional Vietnamese dishes: I'll be waiting for you in my little blue Estafette to try them out!"
    ],
    "it": [
      "Mi chiamo Y e sono vietnamita. Offro piatti della tradizione vietnamita: vi aspetto nella mia piccola Estafette blu per farveli provare!"
    ],
    "fr": [
      "Mon prénom est Y, je suis Vietnamienne. Je vous propose des plats traditionnels Vietnamiens : je vous attends dans ma petite Estafette bleue pour les tester !"
    ],
    "nl": [
      "Mijn voornaam is Y en ik ben Vietnamees. Ik bied traditionele Vietnamese gerechten aan: ik wacht op je in mijn kleine blauwe Estafette om ze uit te proberen!"
    ],
    "es": [
      "Me llamo Y y soy vietnamita. Ofrezco platos tradicionales vietnamitas: ¡te espero en mi pequeña Estafette azul para que los pruebes!"
    ]
