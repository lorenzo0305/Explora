          "additionalInformation": {
            "de": [
              "7.30-12.30 Uhr.\r\nAbends: auf Vorbestellung und Abholung nach Vereinbarung zwischen 15:30 und 18:30 Uhr in Aillon le Vieux (Cimeteret)\r\n\r\nAillon-le-Vieux: L-Ma-Me-Di-Sa abends.\r\nMarkt in Lescheraines: Dienstagmittag.\r\nMarkt in Le Châtelard: Freitagmittag"
            ],
            "en": [
              "7:30am-12:30pm.\r\nEvenings: order in advance, and pick-up by appointment between 3:30pm and 6:30pm at Aillon le Vieux (Cimeteret)\r\n\r\nAillon-le-Vieux: L-Ma-Me-Je-Sa evenings.\r\nLescheraines market: Tuesday lunchtime.\r\nMarché du Châtelard: Friday lunchtime"
            ],
            "it": [
              "7.30-12.30.\r\nSera: su ordinazione, ritiro su appuntamento tra le 15.30 e le 18.30 presso Aillon le Vieux (Cimeteret)\r\n\r\nAillon-le-Vieux: lunedì-lunedì-giovedì-sabato sera.\r\nMercato di Lescheraines: martedì a pranzo.\r\nMercato di Châtelard: venerdì a pranzo"
            ],
            "fr": [
              "7h30-12h30.\r\nSoirs : sur commande à l'avance, et retrait sur rdv entre 15h30 et 18h30 à Aillon le Vieux (Cimeteret)\r\n\r\nAillon-le-Vieux : L-Ma-Me-Je-Sa soirs.\r\nMarché de Lescheraines : Mardi midi.\r\nMarché du Châtelard : Vendredi Midi"
            ],
            "es": [
              "de 7.30 a 12.30 h.\r\nTardes: por encargo y recogida con cita previa de 15.30 a 18.30 h en Aillon le Vieux (Cimeteret)\r\n\r\nAillon-le-Vieux: lunes, lunes, jueves y sábados por la noche.\r\nMercado de Lescheraines: martes al mediodía.\r\nMercado de Châtelard: viernes al mediodía"
            ],
            "nl": [
              "19.30-12.30 uur.\r\nS Avonds: vooraf bestellen en afhalen op afspraak tussen 15.30 en 18.30 uur bij Aillon le Vieux (Cimeteret)\r\n\r\nAillon-le-Vieux: ma-maandag-donderdag-zaterdagavond.\r\nMarkt van Lescheraines: dinsdagmiddag.\r\nMarché du Châtelard: vrijdagmiddag"
            ]
          },
