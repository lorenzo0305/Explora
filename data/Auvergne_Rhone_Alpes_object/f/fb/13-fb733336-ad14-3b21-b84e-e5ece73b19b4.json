  "rdfs:comment": {
    "de": [
      "Eine Panoramaterrasse an der Ankunft des Sessellifts Tête des Saix auf 2100 m Höhe im Herzen des Skigebiets (oder Wanderungen im Sommer), Bar, Schnellrestaurants."
    ],
    "en": [
      "A panoramic view from the terrace facing the mountains all around Les Carroz, above the Airon bowl."
    ],
    "it": [
      "Una terrazza panoramica all'arrivo della seggiovia Tête des Saix a 2100 m di altitudine nel cuore del comprensorio sciistico (o escursionistico in estate), bar, fast food."
    ],
    "fr": [
      "Une terrasse panoramique à l'arrivée du Télésiège de la Tête des Saix à 2100 m d'altitude au coeur du domaine skiable (ou de randonnées en été), bar, restauration rapide."
    ],
    "es": [
      "Una terraza panorámica a la llegada del telesilla Tête des Saix, a 2100 m de altitud, en el corazón de la zona de esquí (o de senderismo en verano), bar, comida rápida."
    ],
    "nl": [
      "Een panoramisch terras aan de aankomst van de stoeltjeslift van l’Airon en van les Gentianes op 2100m hoogte. Broodjes, snelle restauratie."
    ]
  },
