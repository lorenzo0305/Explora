  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08c2dfef-c936-38b7-bf4b-f6efa640b928",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMittwoch bis Samstag von 9:00 bis 12:30 Uhr und von 15:30 bis 19:00 Uhr\n\n\nAbholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nTelefonische Bestellungen unter 06 47 24 25 60 möglich\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nWednesday to Saturday, 9am to 12:30pm and 3:30pm to 7pm\n\n\nCollection :\n\nTakeaway during store opening hours\n\nOrdering :\n\nYou can order by phone on 06 47 24 25 60\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa mercoledì a sabato, dalle 9.00 alle 12.30 e dalle 15.30 alle 19.00\n\n\nRaccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nSi può ordinare per telefono al numero 06 47 24 25 60\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu mercredi au samedi de 9h à 12h30 et de 15h30 à 19h\n\n\nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au  06 47 24 25 60\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nWoensdag tot zaterdag van 9u tot 12u30 en van 15u30 tot 19u\n\n\nOphalen :\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nJe kunt telefonisch bestellen op 06 47 24 25 60\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe miércoles a sábado, de 9.00 a 12.30 h. y de 15.30 a 19.00 h\n\n\nRecogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nPuede hacer su pedido por teléfono llamando al 06 47 24 25 60\n\n "
        ]
      },
