  "rdfs:comment": {
    "de": [
      "Die Stiftskirche Saint-Martin in Picquigny wurde vom 12. bis zum 16. Jahrhundert erbaut. Jahrhundert erbaut. Es ist eine Auswahl an architektonischen Rätseln, die in der Stiftskirche erhalten geblieben sind."
    ],
    "en": [
      "The collegiate church of Saint-Martin de Picquigny was built from the 12th to the 16th century. It is an assortment of architectural enigmas that remain within the collegiate church."
    ],
    "it": [
      "La collegiata di Saint-Martin de Picquigny fu costruita tra il XII e il XVI secolo. Si tratta di un assortimento di enigmi architettonici che rimangono all'interno della collegiata."
    ],
    "fr": [
      "La collégiale Saint-Martin de Picquigny a été construite du XIIe au XVIe siècle. C'est un assortiment d'énigmes architecturales qui subsistent au sein de la collégiale."
    ],
    "es": [
      "La colegiata de Saint-Martin de Picquigny fue construida entre los siglos XII y XVI. Es un conjunto de enigmas arquitectónicos que permanecen dentro de la colegiata."
    ],
    "nl": [
      "De collegiale kerk Saint-Martin de Picquigny werd gebouwd tussen de 12e en 16e eeuw. Het is een assortiment van architecturale raadsels die binnen de collegiale kerk blijven."
    ]
  },
