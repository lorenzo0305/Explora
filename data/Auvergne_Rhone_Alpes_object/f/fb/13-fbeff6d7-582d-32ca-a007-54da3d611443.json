  "rdfs:comment": {
    "de": [
      "Museumsbereiche über die Geschichte der siamesischen Dörfer Saint-Santin-de-Maurs und Saint-Santin-d'Aveyron. Eine erzählte und animierte Erzählung wird Ihnen von zwei emblematischen Figuren angeboten."
    ],
    "en": [
      "Museum on the unique history of the “double village” of Saint-Santin that delimits two communes, two departments, and even two regions!"
    ],
    "it": [
      "Spazi museografici sulla storia dei villaggi siamesi di Saint-Santin-de-Maurs e Saint-Santin-d'Aveyron. Una storia vivace è raccontata da due personaggi emblematici."
    ],
    "fr": [
      "Espaces muséographiques sur l'histoire des villages siamois de Saint-Santin-de-Maurs et Saint-Santin-d'Aveyron. Un récit conté et animé vous est proposé par deux personnages emblématiques."
    ],
    "nl": [
      "Museum over de bijzondere geschiedenis van het “dubbel dorp” Saint-Santin dat in twee gemeenten, twee departementen en twee regio’s ligt."
    ],
    "es": [
      "Espacios museográficos sobre la historia de los pueblos siameses de Saint-Santin-de-Maurs y Saint-Santin-d'Aveyron. Dos personajes emblemáticos narran una historia llena de vida."
    ]
  },
