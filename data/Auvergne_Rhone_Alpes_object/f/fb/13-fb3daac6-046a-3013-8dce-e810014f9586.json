  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Gegend um Roanne aus der Luft mit einem Paramotor! Bei dieser Lufttaufe in einem zweisitzigen Luftfahrzeug genießen Sie einen exklusiven Flug mit dem Piloten. In luftiger Höhe können Sie die Bergmassive, Schlösser, Kirchen und die Loire bewundern."
    ],
    "en": [
      "Discover the Roanne region from the air in a paramotor! During this first flight in a two-seater aircraft, you'll enjoy an exclusive flight with the pilot. At altitude, you'll be able to admire mountain ranges, castles, churches and the Loire River."
    ],
    "it": [
      "Scoprite la regione di Roanne dall'alto in paramotore! Durante questo primo volo su un aereo biposto, godrete di un volo esclusivo con il pilota. In quota, potrete ammirare catene montuose, castelli, chiese e la Loira."
    ],
    "fr": [
      "Découvrez la région de Roanne depuis le ciel en paramoteur ! Lors de ce baptême de l'air en aéronef biplace, vous profiterez d'un vol exclusif avec le pilote. En altitude, vous pourrez admirer les massifs montagneux, des châteaux, des églises et la Loire."
    ],
    "es": [
      "¡Descubra la región de Roanne desde el aire en paramotor! Durante este primer vuelo en biplaza, disfrutará de un vuelo exclusivo con el piloto. En las alturas, podrá admirar cadenas montañosas, castillos, iglesias y el Loira."
    ],
    "nl": [
      "Ontdek de streek van Roanne vanuit de lucht in een paramotor! Tijdens deze eerste vlucht in een tweezitter geniet je van een exclusieve vlucht met de piloot. Op grote hoogte kun je bergketens, kastelen, kerken en de Loire bewonderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baptême de l'air en paramoteur"
    ]
  },
