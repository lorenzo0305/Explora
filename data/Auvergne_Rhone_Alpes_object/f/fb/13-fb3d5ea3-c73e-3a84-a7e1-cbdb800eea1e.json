  "rdfs:comment": {
    "de": [
      "Der 9-Loch-Golfplatz von La Rosière liegt auf 2000 m Höhe in einer wunderschönen Umgebung. Der von der FFG zugelassene Golfplatz bietet auch eine Driving Range, auf der Sie Ihre Drives vor einem atemberaubenden Panorama üben können."
    ],
    "en": [
      "Perched at an altitude of 2,000m, this well-kept golf course is FFGolf-approved and will keep both beginners and experienced golfers entertained all day long, particularly with its practice facing a breathtaking view."
    ],
    "it": [
      "Situato a 2000 m di altitudine in un ambiente magnifico, il Golf Club La Rosière a 9 buche, approvato dalla FFG, offre anche un campo pratica per lavorare sui vostri drive davanti a un panorama che vi lascerà senza fiato."
    ],
    "fr": [
      "Situé à 2000m d'altitude dans un cadre magnifique, le Golf 9 trous de La Rosière, homologué FFG, propose également un practice pour vous permettre de travailler vos drives face à un panorama qui vous coupera le souffle."
    ],
    "es": [
      "Situado a 2.000 metros de altitud en un magnífico entorno, el club de golf de La Rosière, de 9 hoyos y homologado por la FFG, ofrece también un campo de prácticas para que pueda trabajar sus golpes ante un panorama que le dejará sin aliento."
    ],
    "nl": [
      "De door de FFG erkende golfclub La Rosière met 9 holes ligt op een hoogte van 2000 m in een prachtige omgeving en biedt ook een oefenbaan om aan uw drives te werken voor een adembenemend panorama."
    ]
  },
  "rdfs:label": {
    "en": [
      "Golf Practice La Rosière"
    ],
    "fr": [
      "Practice de golf de La Rosière"
    ]
  },
