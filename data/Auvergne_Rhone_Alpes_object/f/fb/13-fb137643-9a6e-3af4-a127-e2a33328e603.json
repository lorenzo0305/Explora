  "rdfs:comment": {
    "de": [
      "Reisen im Zigeunerwagen im Rhythmus der Pferde, um die Drôme zu entdecken. Zu Ihrer Beruhigung wird das Gespann von einem professionellen Fahrer geleitet. 1<7 Nächte\r\nKutschenfahrten: Zeitlose Fahrten zwischen Drôme Provençale und Drôme-Tal"
    ],
    "en": [
      "Discover the Drôme region in a horse-drawn carriage. For your peace of mind, the carriage is driven by a professional driver. 1<7 nights\r\nHorse-drawn carriage rides: timeless rides between the Drôme Provençale and the Drôme Valley."
    ],
    "it": [
      "Scoprite la regione della Drôme in una carrozza trainata da cavalli. Per la vostra tranquillità, la carrozza è guidata da un autista professionista. 1<7 notti\r\nGite in carrozza: passeggiate senza tempo tra la Drôme Provençale e la Valle della Drôme"
    ],
    "fr": [
      "Voyage en roulotte au rythme des chevaux pour découvrir la Drôme. Pour votre tranquillité l'attelage est mené par un meneur professionnel . 1<7 nuits\r\nBalades en calèches: Des promenades hors de temps entre Drôme Provençale et Vallée de la Drôme"
    ],
    "nl": [
      "Een ontdekkingsreis maken door de fraaie landschappen van de Drôme in een woonwagen met paarden en menner. Reizen in het tempo van de paarden, een nieuwe omgeving ontdekken, uitrusten, dat ziet eruit als een tof programma voor je woonwagenvakantie!"
    ],
    "es": [
      "Descubra la Drôme en coche de caballos. Para su tranquilidad, el carruaje es conducido por un chófer profesional. 1<7 noches\r\nPaseos en coche de caballos: paseos intemporales entre la Drôme provenzal y el valle de la Drôme"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Drôme Roulottes Vacances: Calèches et vacances en roulottes itinérantes."
    ]
  },
