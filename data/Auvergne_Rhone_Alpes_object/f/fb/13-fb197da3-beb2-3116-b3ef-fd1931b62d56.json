  "rdfs:comment": {
    "de": [
      "Wine & Free entwirft und organisiert einzigartige Entdeckungserlebnisse, die Wein, Gastronomie und Reisen miteinander verbinden.\nSie sind für Reisende gedacht, die auf der Suche nach unvergesslichen Momenten sind, und können direkt gebucht oder maßgeschneidert werden."
    ],
    "en": [
      "Wine & Free designs and orchestrates unique discovery experiences at the crossroads of wine, gastronomy, and travel. Created for travelers seeking memorable moments, these experiences can be booked directly or customized to your specifications."
    ],
    "it": [
      "Wine & Free progetta e organizza esperienze di scoperta uniche, all'incrocio tra vino, gastronomia e viaggi.\nPensate per viaggiatori alla ricerca di momenti memorabili, possono essere prenotate direttamente o su misura."
    ],
    "fr": [
      "Wine & Free conçoit et orchestre des expériences de découverte singulières, à la croisée du vin, de la gastronomie et du voyage.\nPensées pour les voyageurs en quête de moments mémorables, elles peuvent être réservées directement ou imaginées sur-mesure."
    ],
    "nl": [
      "Wine & Free ontwerpt en organiseert unieke ontdekkingservaringen op het kruispunt van wijn, gastronomie en reizen.\nZe zijn ontworpen voor reizigers die op zoek zijn naar memorabele momenten en kunnen rechtstreeks of op maat worden geboekt."
    ],
    "es": [
      "Wine & Free diseña y orquesta experiencias de descubrimiento únicas, en la encrucijada del vino, la gastronomía y los viajes.\nPensadas para viajeros en busca de momentos memorables, pueden reservarse directamente o a medida."
    ]
  },
