      "dc:description": {
        "de": [
          "Besuchen Sie die Theateraufführung \"8 Femmes\" des Theaterateliers von Fliers.\num 15 Uhr im Saal Francis SAGOT in Fruges\nPreis: 7 ? | Kostenlos für Kinder unter 16 Jahren\nohne Reservierung"
        ],
        "en": [
          "Come and see the play \"8 Femmes\" by the Fliers theater workshop.\nat 3pm at the Salle Francis SAGOT in Fruges\nPrice: 7? free for children under 16\nno reservation"
        ],
        "it": [
          "Venite a vedere lo spettacolo \"8 Femmes\" del laboratorio teatrale Fliers.\nalle ore 15.00 presso la Salle Francis SAGOT di Fruges\nPrezzo: 7 € Gratis per i minori di 16 anni\nsenza prenotazione"
        ],
        "fr": [
          "Venez assister à la représentation théâtrale \"8 Femmes\" par l'atelier théâtre de Fliers. \nà 15h à la salle Francis SAGOT à Fruges\nTarif : 7€ | Gratuit pour les - de 16 ans\nsans réservation"
        ],
        "es": [
          "Venga a ver la obra \"8 Femmes\" del taller de teatro Fliers.\na las 15.00 h en la Sala Francis SAGOT de Fruges\nPrecio: 7 euros Gratis para menores de 16 años\nsin reserva"
        ],
        "nl": [
          "Kom kijken naar het toneelstuk \"8 Femmes\" van de theaterworkshop Fliers.\nom 15.00 uur in de Salle Francis SAGOT in Fruges\nPrijs: €7 Gratis voor kinderen onder de 16 jaar\ngeen reservering"
        ]
      },
