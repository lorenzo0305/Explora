  "rdfs:comment": {
    "de": [
      "Restaurant, Hotel, Catering. Am Fuße des Livradois Forez bietet Ihnen unsere großzügige, bretonisch inspirierte Gourmetküche Bistronomique\"-Gerichte aus lokalen und französischen Produkten."
    ],
    "en": [
      "Restaurant, hotel, caterer. At the foot of the Livradois Forez mountains, our generous, Breton-inspired cuisine offers \"Bistronomique\" dishes made with local and French produce."
    ],
    "it": [
      "Ristorante, hotel, catering. Ai piedi del Livradois Forez, la nostra generosa cucina gourmet di ispirazione bretone propone piatti \"bistronomique\" a base di prodotti locali e francesi."
    ],
    "fr": [
      "Restaurant, hôtel, traiteur. Au pied du Livradois Forez, notre cuisine gourmande et généreuse d’inspiration bretonne vous propose des plats « Bistronomique » composés de produits du terroir local et français."
    ],
    "es": [
      "Restaurante, hotel, catering. A los pies del Livradois Forez, nuestra generosa cocina gastronómica de inspiración bretona ofrece platos \"Bistronomique\" elaborados con productos locales y franceses."
    ],
    "nl": [
      "Restaurant, hotel, traiteur. Aan de voet van Livradois Forez biedt onze gulle, Bretons geïnspireerde gastronomische keuken \"Bistronomique\" gerechten gemaakt met lokale en Franse producten."
    ]
  },
  "rdfs:label": {
