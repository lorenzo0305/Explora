  "rdfs:comment": {
    "de": [
      "Der Rat für Architektur, Städtebau und Umwelt (Conseil d'Architecture, d'Urbanisme et de l'Environnement, CAUE) ist ein privatrechtlicher Verein mit einem öffentlichen Auftrag zum Nutzen aller: Privatpersonen, Gebietskörperschaften und der breiten Öffentlichkeit."
    ],
    "en": [
      "The Council of Architecture, Urbanism and Environment (CAUE) is an association under private law, invested with a public service mission for the benefit of all: individuals, communities and the general public."
    ],
    "it": [
      "Il Consiglio di Architettura, Urbanistica e Ambiente (CAUE) è un'associazione di diritto privato, investita di una missione di servizio pubblico a beneficio di tutti: individui, comunità e pubblico in generale."
    ],
    "fr": [
      "Le Conseil d’Architecture, d’Urbanisme et de l’Environnement (CAUE) est une association de droit privé, investi d’une mission de service public au profit de tous : particuliers, collectivités et grand public."
    ],
    "es": [
      "El Consejo de Arquitectura, Urbanismo y Medio Ambiente (CAUE) es una asociación de derecho privado, investida de una misión de servicio público en beneficio de todos: individuos, comunidades y público en general."
    ],
    "nl": [
      "De Raad voor Architectuur, Stedenbouw en Milieu (CAUE) is een privaatrechtelijke vereniging met een openbare dienstverleningsopdracht ten behoeve van iedereen: particulieren, gemeenschappen en het grote publiek."
    ]
  },
  "rdfs:label": {
