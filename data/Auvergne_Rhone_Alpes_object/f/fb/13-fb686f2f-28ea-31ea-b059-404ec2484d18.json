  "rdfs:comment": {
    "de": [
      "Sie werden von unseren vielfältigen französischen Gerichten begeistert sein, die von unseren Köchen für Sie zubereitet werden. Lassen Sie sich von unserer köstlichen Küche und einer Auswahl an kühlen Getränken verwöhnen."
    ],
    "en": [
      "You'll be delighted by the variety of French dishes prepared for you by our chefs. Let yourself be tempted by our delicious cuisine and a choice of cold drinks."
    ],
    "it": [
      "Sarete deliziati dai variegati piatti francesi preparati dai nostri cuochi per voi. Lasciatevi tentare dalla nostra deliziosa cucina e da una scelta di bevande fredde."
    ],
    "fr": [
      "Vous serez ravis par nos plats français et variés préparés par nos cuisiniers à votre attention. Laissez-vous tenter par notre délicieuse cuisine et un choix de boissons fraîches."
    ],
    "es": [
      "Le encantarán nuestros variados platos franceses preparados por nuestros cocineros para usted. Déjese tentar por nuestra deliciosa cocina y una selección de bebidas frías."
    ],
    "nl": [
      "Je zult verrukt zijn van de verscheidenheid aan Franse gerechten die onze chef-koks voor je bereiden. Laat je verleiden door onze heerlijke keuken en een keuze aan koude dranken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le 12/04"
    ]
  },
