  "rdfs:comment": {
    "de": [
      "Laurence und Gilles begrüßen Sie in ihrem charmanten Hotel. 11 komfortable Zimmer für einen erholsamen Aufenthalt. Genießen Sie auch die renommierte Tafel des Küchenchefs Gilles, der die Produkte der Region im Rhythmus der Jahreszeiten veredelt."
    ],
    "en": [
      "Laurence and Gilles welcome you to their charming hotel. 11 comfortable rooms for a rejuvenating stay. Enjoy Chef Gilles' renowned cuisine, which sublimates local produce to the rhythm of the seasons."
    ],
    "it": [
      "Laurence e Gilles vi danno il benvenuto nel loro hotel di charme. 11 camere confortevoli per un soggiorno rigenerante. Potrete anche approfittare della rinomata cucina dello chef Gilles, che sublima i prodotti locali al ritmo delle stagioni."
    ],
    "fr": [
      "Laurence et Gilles vous accueillent dans leur hôtel de charme. 11 chambres confortables pour un séjour ressourçant. Profitez aussi de la table renommée du chef Gilles qui sublime les produits du terroir au rythme des saisons."
    ],
    "es": [
      "Laurence y Gilles le dan la bienvenida a su encantador hotel. 11 cómodas habitaciones para una estancia rejuvenecedora. También podrá disfrutar de la reconocida cocina del Chef Gilles, que sublima los productos locales al ritmo de las estaciones."
    ],
    "nl": [
      "Laurence en Gilles heten je welkom in hun charmante hotel. 11 comfortabele kamers voor een verkwikkend verblijf. U kunt ook genieten van de gerenommeerde keuken van chef Gilles, die lokale producten sublimeert op het ritme van de seizoenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel la Tour"
    ]
  },
