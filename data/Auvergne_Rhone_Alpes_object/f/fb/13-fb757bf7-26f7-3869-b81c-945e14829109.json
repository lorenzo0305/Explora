  "rdfs:comment": {
    "de": [
      "L'Etage befindet sich im Stadtzentrum in der Nähe des Museums und öffnet seine Türen für Sie.\r\nWir bieten Ihnen eine große Auswahl an frischem Fisch, gegrilltem Fleisch und Fleisch vom Grill oder von der Plancha. Genießen Sie unsere zwei Säle und unsere Außenterrasse."
    ],
    "en": [
      "Located in the town center near the museum, l'Etage opens its doors to you.\r\nWe offer a wide choice of fresh fish, grilled meats and a la plancha. Come and enjoy our two dining rooms and outdoor terrace."
    ],
    "it": [
      "Situato nel centro della città, vicino al museo, l'Etage vi apre le sue porte.\r\nOffriamo un'ampia scelta di pesce fresco, carne alla griglia o à la plancha. Venite a godervi le nostre due sale da pranzo e la nostra terrazza esterna."
    ],
    "fr": [
      "Situé dans le centre ville près du musée, l'Etage vous ouvre ses portes.\r\nNous proposons un large choix de poissons frais, de viandes cuites en grillades ou à la plancha. Venez profiter de nos deux salles et notre terrasse extérieure."
    ],
    "es": [
      "Situado en el centro de la ciudad, cerca del museo, l'Etage le abre sus puertas.\r\nOfrecemos una amplia selección de pescado fresco, carne a la parrilla o a la plancha. Venga a disfrutar de nuestros dos comedores y nuestra terraza exterior."
    ],
    "nl": [
      "Gelegen in het stadscentrum vlakbij het museum, opent l'Etage zijn deuren voor jou.\r\nWe bieden een ruime keuze aan verse vis en gegrild of plancha vlees. Kom genieten van onze twee eetzalen en het buitenterras."
    ]
  },
