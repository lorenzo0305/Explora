  "rdfs:comment": {
    "de": [
      "Im Herzen Frankreichs und Europas genießt das Parc des Expositions de Montluçon, eine privilegierte Lage an der Kreuzung der großen regionalen Hauptstädte."
    ],
    "en": [
      "In the heart of France and Europe, the Montluçon Exhibition Centre enjoys a privileged location at the crossroads of the major regional capitals."
    ],
    "it": [
      "Nel cuore della Francia e dell'Europa, il Centro Esposizioni di Montluçon gode di una posizione privilegiata all'incrocio delle principali capitali regionali."
    ],
    "fr": [
      "Au cœur de la France et de l’Europe, le Parc des Expositions de Montluçon, bénéficie d’une situation privilégiée au carrefour des grandes capitales régionales."
    ],
    "nl": [
      "In het hart van Frankrijk en Europa ligt het expositiecentrum van Montluçon op een bevoorrechte locatie op het kruispunt van de grote regionale hoofdsteden."
    ],
    "es": [
      "En el corazón de Francia y de Europa, el Parque de Exposiciones de Montluçon goza de una ubicación privilegiada en el cruce de las principales capitales regionales."
    ]
  },
  "rdfs:label": {
