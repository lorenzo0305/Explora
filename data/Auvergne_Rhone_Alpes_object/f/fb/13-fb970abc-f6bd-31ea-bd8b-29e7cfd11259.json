  "rdfs:comment": {
    "de": [
      "Ein Kinderreim zum Summen, Geschichten zum Anknabbern, ein Moment der Freude, den Sie mit Ihrem Baby teilen können, wenn es seine ersten Schritte in die Welt des Lesens und der Bücher macht."
    ],
    "en": [
      "A rhyme to hum, stories to crunch, a moment of pleasure to share with baby as he takes his first steps into the world of reading and books."
    ],
    "it": [
      "Una filastrocca da canticchiare, storie da masticare, un momento di piacere da condividere con il vostro bambino che muove i primi passi nel mondo della lettura e dei libri."
    ],
    "fr": [
      "Une comptine à fredonner, des histoires à croquer, un moment de plaisir à partager avec Bébé pour ses premiers pas dans l'univers de la lecture et du livre."
    ],
    "es": [
      "Una canción infantil para tararear, cuentos para masticar, un momento de placer para compartir con tu bebé mientras da sus primeros pasos en el mundo de la lectura y los libros."
    ],
    "nl": [
      "Een kinderrijmpje om te neuriën, verhaaltjes om op te kauwen, een moment van plezier om te delen met je baby terwijl hij zijn eerste stapjes zet in de wereld van lezen en boeken."
    ]
  },
  "rdfs:label": {
