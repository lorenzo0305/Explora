  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Schankraum der DRAC-Brauerei und genießen Sie unsere Getränke und die unserer Freunde im Herzen des malerischen Dorfes Jaujac! Aperitifplatten zur Auswahl, lokale Biere vom Fass oder zum Mitnehmen."
    ],
    "en": [
      "Discover the DRAC brewery taproom and enjoy our beverages and those of our friends in the heart of the picturesque village of Jaujac! Aperitif boards to choose from, local beers on tap or to take away."
    ],
    "it": [
      "Scoprite la birreria DRAC e gustate le nostre bevande e quelle dei nostri amici nel cuore del pittoresco villaggio di Jaujac! Aperitivi a scelta, birre locali alla spina o da asporto."
    ],
    "fr": [
      "Découvrez la taproom de la brasserie DRAC et délectez-vous de nos breuvages et de ceux de nos amis au cœur du village de caractère de Jaujac ! Planches apéros à composer, bières locales sur place ou à emporter."
    ],
    "nl": [
      "Ontdek de DRAC brouwerij tapkamer en geniet van onze dranken en die van onze vrienden in het hart van het pittoreske dorpje Jaujac! Aperitieven om uit te kiezen, lokale bieren van het vat of om mee te nemen."
    ],
    "es": [
      "Descubra la cervecería DRAC y disfrute de nuestras bebidas y las de nuestros amigos en el corazón del pintoresco pueblo de Jaujac Aperitivos a elegir, cervezas locales de barril o para llevar."
    ]
  },
  "rdfs:label": {
    "de": [
      "Schankraum der DRAC-Brauerei"
    ],
    "en": [
      "Taproom of the DRAC brewery"
    ],
    "fr": [
      "Taproom de la Brasserie DRAC"
    ]
  },
