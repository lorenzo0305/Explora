  "rdfs:comment": {
    "de": [
      "Befestigte Burg, die unter Denkmalschutz steht und Ende des 12. Jahrhunderts erbaut und im 15. Jahrhundert fertiggestellt wurde. Es umfasst einen Kerker und sechs Türme; es ist noch bewohnt. Bemerkenswerter hohler Gemüsegarten, klassifiziert als MH. Museum der Silberminen in den Nebengebäuden des Schlosses."
    ],
    "en": [
      "Fortified castle, listed as a historic monument. Built at the end of the 12th century and complete in the 15th century. There is a dungeon and six turets, it is still lived in today. A vegetable garden which is labelled as 'remarkable'  and a silver mining museum exist in the grounds."
    ],
    "it": [
      "Un castello classificato costruito alla fine del XII secolo e completato nel XV secolo. Comprende un mastio e sei torri; è ancora abitato. Notevole orto sommerso classificato come monumento storico. Museo delle miniere d'argento nelle pertinenze del castello."
    ],
    "fr": [
      "Château fort, classé Monument Historique (MH), construit à la fin du XIIe siècle et complété au XVe. Il comprend un donjon et six tours; il est toujours habité. Remarquable potager en creux classé MH. Musée des mines d'argent dans les communs du château."
    ],
    "es": [
      "Castillo protegido construido a finales del siglo XII y terminado en el siglo XV. Incluye una torre del homenaje y seis torres; todavía está habitada. Notable huerto hundido clasificado como monumento histórico. Museo de las minas de plata en las dependencias del castillo."
    ],
    "nl": [
      "Bezoek een beroemd kasteel, staat op de monumentenlijst"
    ]
  },
