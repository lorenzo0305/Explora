  "rdfs:comment": {
    "de": [
      "Semita Tours bietet Ihnen geführte Touren mit Elektrofahrrädern und Fahrradverleih an, um das Beaujolais und seine Weinberge zu entdecken. Ihr diplomierter Führer wird Sie gerne zu seinen Lieblingsecken mitnehmen und seine Leidenschaft für Wein und Fahrrad mit Ihnen teilen."
    ],
    "en": [
      "Guided electric bike tours and rentals bike to discover the Beaujolais region. Your guide will share with you his passion for wine and bike."
    ],
    "it": [
      "Semita Tours offre tour guidati in bicicletta elettrica e noleggio di biciclette per scoprire la regione del Beaujolais e i suoi vigneti. La vostra guida qualificata sarà lieta di portarvi nei suoi luoghi preferiti per condividere la sua passione per il vino e la bicicletta."
    ],
    "fr": [
      "Semita Tours vous propose des tours guidés à vélo électrique et la location pour découvrir le Beaujolais et son vignoble. Votre guide diplômé se fera un plaisir de vous emmener dans ses coins favoris pour vous partager sa passion pour le vin et le vélo."
    ],
    "es": [
      "Semita Tours ofrece visitas guiadas en bicicleta eléctrica y alquiler de bicicletas para descubrir la región del Beaujolais y sus viñedos. Su guía cualificado estará encantado de llevarle a sus lugares favoritos para compartir su pasión por el vino y el ciclismo."
    ],
    "nl": [
      "Semita Tours biedt begeleide elektrische fietstochten en fietsverhuur om de Beaujolais en zijn wijngaarden te ontdekken. Je gediplomeerde gids neemt je graag mee naar zijn favoriete plekjes om zijn passie voor wijn en fietsen te delen."
    ]
  },
