  "rdfs:comment": {
    "de": [
      "Alté Chamrousse Aventures bietet Ihnen über 170 Workshops in den Bäumen ab 4 Jahren. Entdecken Sie Parcours, die für jedes Alter und jedes Niveau geeignet sind. So können Sie mit der Familie oder mit Freunden ein gemeinsames Abenteuer erleben."
    ],
    "en": [
      "Alté Chamrousse Aventures offers more than 170 tree-climbing activities for children aged 4 and over. Come and discover courses adapted to all ages and levels. Enjoy an adventure with family and friends."
    ],
    "it": [
      "Alté Chamrousse Aventures offre più di 170 attività di arrampicata sugli alberi per bambini dai 4 anni in su. Venite a scoprire percorsi adatti a tutte le età e a tutti i livelli. Potete condividere l'avventura con la vostra famiglia o con gli amici."
    ],
    "fr": [
      "Alté Chamrousse Aventures vous propose plus de 170 ateliers dans les arbres dès 4 ans. Venez découvrir des parcours adaptés à tous les âges et tous les niveaux. Vous pourrez ainsi partager une aventure en famille ou entre amis."
    ],
    "es": [
      "Alté Chamrousse Aventures ofrece más de 170 actividades de escalada de árboles para niños a partir de 4 años. Venga a descubrir recorridos adaptados a todas las edades y niveles. Podrás compartir una aventura en familia o con amigos."
    ],
    "nl": [
      "Alté Chamrousse Aventures biedt meer dan 170 boomklimactiviteiten voor kinderen vanaf 4 jaar. Kom en ontdek routes die geschikt zijn voor alle leeftijden en niveaus. Je kunt een avontuur delen met je familie of vrienden."
    ]
  },
  "rdfs:label": {
    "de": [
      "Baumkronen-Parcours \"Alté Chamrousse Aventures\" (Abenteuer in Chamrousse)"
    ],
    "en": [
      "\"Alté Chamrousse Adventures\" tree adventure"
    ],
    "fr": [
      "Parcours dans les arbres \"Alté Chamrousse Aventures\""
    ]
  },
