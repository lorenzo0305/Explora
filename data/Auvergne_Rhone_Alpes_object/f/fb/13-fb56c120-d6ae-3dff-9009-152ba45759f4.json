  "rdfs:comment": {
    "de": [
      "In einem sehr schönen Gebäude in Sallanches empfängt Sie La Charrette, ein Restaurant mit traditioneller französischer Küche in neuem Gewand, in seinem Kokon, um Ihnen eine angenehme Zeit zu bereiten."
    ],
    "en": [
      "In a beautiful building in Sallanches, la Charrette, a restaurant of traditional French cuisine revisited, will welcome you in its cocoon to make you spend a pleasant moment."
    ],
    "it": [
      "In uno splendido edificio di Sallanches, La Charrette, un ristorante di cucina tradizionale francese, vi accoglierà nel suo bozzolo per farvi trascorrere un momento piacevole."
    ],
    "fr": [
      "Dans une très belle bâtisse de Sallanches, la Charrette, restaurant de cuisine française traditionnelle revisitée, vous accueillera dans son cocon pour vous faire passer un agréable moment."
    ],
    "nl": [
      "In een prachtig gebouw in Sallanches ontvangt La Charrette, een restaurant met traditionele Franse keuken, u in zijn cocon om u een aangenaam moment te bezorgen."
    ],
    "es": [
      "En un hermoso edificio de Sallanches, La Charrette, un restaurante de cocina tradicional francesa, le acogerá en su capullo para hacerle pasar un momento agradable."
    ]
  },
