  "rdfs:comment": {
    "de": [
      "Das Restaurant L'Artichaut mit 45 Sitzplätzen bietet eine raffinierte, schmackhafte und saisonale Küche. Der Chefkoch wählt regionale Produkte aus einer bäuerlichen und nachhaltigen Landwirtschaft aus, um eine Küche im Bistronomiestil zu kreieren."
    ],
    "en": [
      "L’Artichaut is a 45-cover restaurant serving tasty, fresh and seasonal market cuisine. We source regional products from sustainable small-scale farms and create “bistronomic” cuisine."
    ],
    "it": [
      "Il ristorante L'Artichaut, con 45 posti a sedere, offre una cucina raffinata, gustosa e stagionale. Lo chef seleziona prodotti regionali, provenienti da un'agricoltura sostenibile, per creare una cucina di tipo bistronomico."
    ],
    "fr": [
      "L’Artichaut, restaurant de 45 couverts, propose une cuisine raffinée, savoureuse et de saison. Le Chef sélectionne des produits régionaux, issus d’une agriculture paysanne et raisonnée pour créer une cuisine de type bistronomique."
    ],
    "es": [
      "L'Artichaut, un restaurante de 45 plazas, ofrece una cocina refinada, sabrosa y de temporada. El chef selecciona productos regionales, procedentes de una agricultura sostenible, para crear una cocina de tipo bistronómico."
    ],
    "nl": [
      "L'Artichaut, een restaurant met 45 plaatsen, biedt een verfijnde, smakelijke en seizoensgebonden keuken. De chef selecteert regionale producten uit een duurzame landbouw om een bistronomische keuken te creëren."
    ]
  },
