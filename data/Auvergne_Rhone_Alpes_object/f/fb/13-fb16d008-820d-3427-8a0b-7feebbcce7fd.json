  "rdfs:comment": {
    "de": [
      "Wie die Palette eines Malers ist das L'Octave ein Chamäleon-Restaurant, das sich jeder für die Dauer einer Mahlzeit aneignen und sich dort wie zu Hause fühlen kann."
    ],
    "en": [
      "Like a painter's palette, L'Octave is a chameleon restaurant that everyone can make their own for a meal and feel at home."
    ],
    "it": [
      "Come la tavolozza di un pittore, L'Octave è un ristorante camaleontico che ognuno può fare suo per un pasto e sentirsi a casa."
    ],
    "fr": [
      "Comme une palette de peintre, L’Octave est un restaurant caméléon que chacun pourra s’approprier le temps d’un repas et s’y sentir comme à la maison."
    ],
    "nl": [
      "Zoals het palet van een schilder is L'Octave een kameleonrestaurant waar iedereen zich een maaltijd eigen kan maken en zich thuis kan voelen."
    ],
    "es": [
      "Como la paleta de un pintor, L'Octave es un restaurante camaleónico que cada uno puede hacer suyo para comer y sentirse como en casa."
    ]
  },
