  "rdfs:comment": {
    "de": [
      "Zum Abschluss des Comic-Wettbewerbs, der während des gesamten Schuljahres stattgefunden hat, lädt die Mediathek von Saint-Didier-en-Velay Sie zu einem Werkstattfest ein. Es werden Ihnen zahlreiche Spiele rund um den Gewinnercomic angeboten."
    ],
    "en": [
      "To round off the comic book competition held throughout the school year, the Saint-Didier-en-Velay media library invites you to a workshop party. You'll be able to play a number of games based on the winning comic."
    ],
    "it": [
      "La mediateca di Saint-Didier-en-Velay vi invita a una festa-laboratorio per celebrare la fine del concorso di fumetti svoltosi durante l'anno scolastico. Ci saranno molti giochi basati sul fumetto vincitore."
    ],
    "fr": [
      "Afin de clôturer le concours BD qui s'est déroulé tout au long de l'année scolaire, la médiathèque de Saint-Didier-en-Velay vous invite à une fête-atelier. De nombreux jeux autour de la BD gagnante vous seront proposés."
    ],
    "es": [
      "La mediateca de Saint-Didier-en-Velay te invita a una fiesta-taller con motivo del final del concurso de cómics celebrado durante todo el curso escolar. Habrá muchos juegos en torno al cómic ganador."
    ],
    "nl": [
      "De mediatheek van Saint-Didier-en-Velay nodigt je uit voor een workshop ter afsluiting van de stripwedstrijd die het hele schooljaar is gehouden. Er worden allerlei spelletjes georganiseerd rond het winnende stripverhaal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le prix Bd en fête"
    ]
  },
