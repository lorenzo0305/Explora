  "rdfs:comment": {
    "de": [
      "Genießen Sie eine raffinierte und einfallsreiche Küche in einem über 100 Jahre alten authentischen Schafstall. Unsere Küche ist eine gelungene Mischung aus lokaler Tradition, französischer Gastronomie und einem Ausflug in die Aromen der Welt."
    ],
    "en": [
      "Savour refined, inventive cuisine in an authentic sheepfold over 100 years old. Our cuisine is a skilful blend of local tradition, French gastronomy and an escape to the heart of world flavours."
    ],
    "it": [
      "Godetevi una cucina raffinata e inventiva in un autentico ovile centenario, la nostra cucina è un sapiente mix di tradizione locale, gastronomia francese e un viaggio nel cuore dei sapori del mondo."
    ],
    "fr": [
      "Savourez une cuisine raffinée et inventive dans une bergerie authentique de plus de 100 ans, notre cuisine est un savant mélange entre la tradition locale, la gastronomie française et une escapade au cœur des saveurs du monde."
    ],
    "nl": [
      "Geniet van verfijnde, inventieve gerechten in een authentieke schaapskooi van meer dan 100 jaar oud. Onze keuken is een kundige mix van lokale traditie, Franse gastronomie en een ontsnapping naar het hart van de wereldse smaken."
    ],
    "es": [
      "Disfrute de una cocina refinada e inventiva en un auténtico aprisco centenario. Nuestra cocina es una inteligente mezcla de tradición local, gastronomía francesa y un viaje al corazón de los sabores del mundo."
    ]
  },
