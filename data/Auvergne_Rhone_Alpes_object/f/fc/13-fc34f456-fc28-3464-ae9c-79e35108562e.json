  "rdfs:comment": {
    "de": [
      "Atelier/Boutique zur Herstellung von Grand Cru-Schokolade, Rösten von Bio- und Fairtrade-Kaffee, Verkostungen vor Ort.\r\nTextilkreationen mit bunten und grafischen Mustern, Kleidung und Accessoires.  Heilpflanzen und aromatische Zubereitungen."
    ],
    "en": [
      "Workshop/gallery for making Grand Cru chocolate from Latin America, roasting organic and fair trade coffee, tastings on site. Zen Jolo makes on site and offers creations with colorful and graphic patterns in 100% cotton fabrics."
    ],
    "it": [
      "Laboratorio/negozio di cioccolato Grand Cru, torrefazione di caffè biologico ed equo-solidale, degustazioni in loco.\r\nCreazioni tessili con disegni colorati e grafici, abbigliamento e accessori.  Piante medicinali e preparati aromatici."
    ],
    "fr": [
      "Atelier/boutique de fabrication de chocolat grand cru, torréfaction de café bio et équitable, dégustations sur place.\r\nCréations textiles aux motifs colorés et graphiques, vêtements et accessoires.  Plantes médicinales et préparations aromatiques."
    ],
    "es": [
      "Taller/tienda de chocolate Grand Cru, tostado de café ecológico y de comercio justo, degustaciones in situ.\r\nCreaciones textiles con diseños coloridos y gráficos, ropa y accesorios.  Plantas medicinales y preparados aromáticos."
    ],
    "nl": [
      "Grand Cru chocolaterie/winkel, biologische en fairtrade koffiebranderij, proeverijen ter plekke.\r\nTextielcreaties met kleurrijke, grafische ontwerpen, kleding en accessoires.  Medicinale planten en aromatische preparaten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chemise & Chocolat"
    ]
  },
