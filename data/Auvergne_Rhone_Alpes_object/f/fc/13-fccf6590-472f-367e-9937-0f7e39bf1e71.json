  "rdfs:comment": {
    "de": [
      "1929 mit der Bepflanzung der ersten Parzelle gegründetes Weingut in Familienhand, das anschließend über 4 Generationen weitergegeben wurde."
    ],
    "en": [
      "The family estate, founded in 1929, when the first vines were planted, has been handed down over four generations. Today, Bernard, Agnes and Nicole Levet take care of around 4 hectares of terraced vineyards in different areas of Ampuis."
    ],
    "it": [
      "Tenuta familiare tramandata da 4 generazioni, lavoriamo esclusivamente 4,5 ha di vecchie vigne ad Ampuis,\r\nnel cuore storico della Côte Rôtie e 0,3 ettari di Condrieu a Saint Michel sur Rhône dal 2019."
    ],
    "fr": [
      "Domaine familial qui s'est transmis sur 4 générations, nous travaillons exclusivement 4,5 ha de vieilles vignes à Ampuis,\r\ndans le cœur historique de l'appellation Côte Rôtie et 0,3 ha de Condrieu à Saint Michel sur Rhône depuis 2019."
    ],
    "es": [
      "Propiedad familiar transmitida a través de 4 generaciones, trabajamos exclusivamente 4,5 ha de viñas viejas en Ampuis,\r\nen el corazón histórico de la denominación Côte Rôtie y 0,3 ha de Condrieu en Saint Michel sur Rhône desde 2019."
    ],
    "nl": [
      "Als familiedomein dat al 4 generaties lang wordt doorgegeven, bewerken wij uitsluitend 4,5 ha oude wijngaarden in Ampuis,\r\nin het historische hart van de appellation Côte Rôtie en 0,3 ha Condrieu in Saint Michel sur Rhône sinds 2019."
    ]
  },
