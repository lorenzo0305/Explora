  "rdfs:comment": {
    "de": [
      "Der Nationale Marsch für das Augenlicht kehrt am 4. Oktober 2026 nach Solignac-sur-Loire zurück, organisiert von der AMD Association? Antenne du Puy-en-Velay. Ein solidarischer Wandertag, um die Forschung zu unterstützen und das Bewusstsein für Sehstörungen zu schärfen."
    ],
    "en": [
      "The Marche nationale pour la Vue returns to Solignac-sur-Loire on October 4, 2026, organized by the Association DMLA ? Antenne du Puy-en-Velay. A day of walking to support research and raise awareness of vision diseases."
    ],
    "it": [
      "La Marche nationale pour la Vue tornerà a Solignac-sur-Loire il 4 ottobre 2026, organizzata dall'Associazione DMLA ? Antenne du Puy-en-Velay. Una giornata di marcia per sostenere la ricerca e sensibilizzare l'opinione pubblica sulle malattie della vista."
    ],
    "fr": [
      "La Marche nationale pour la Vue revient le 4 octobre 2026 à Solignac-sur-Loire, organisée par l’Association DMLA – Antenne du Puy-en-Velay. Une journée solidaire de marche pour soutenir la recherche et sensibiliser aux maladies de la vision."
    ],
    "es": [
      "La Marche nationale pour la Vue volverá a Solignac-sur-Loire el 4 de octubre de 2026, organizada por la Asociación DMLA ? Antenne du Puy-en-Velay. Una jornada de marcha para apoyar la investigación y sensibilizar sobre las enfermedades relacionadas con la visión."
    ],
    "nl": [
      "De Marche nationale pour la Vue keert terug naar Solignac-sur-Loire op 4 oktober 2026, georganiseerd door de Association DMLA ? Antenne du Puy-en-Velay. Een wandeldag om onderzoek te steunen en mensen bewust te maken van ziekten die verband houden met het gezichtsvermogen."
    ]
  },
