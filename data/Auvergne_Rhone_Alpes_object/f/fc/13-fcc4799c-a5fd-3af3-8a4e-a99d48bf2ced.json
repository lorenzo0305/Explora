  "rdfs:comment": {
    "de": [
      "Verleihgeschäft von am Fuße der Pisten des Anfängerskigebiets „Les Rambins“: Alpin- und Langlaufskiausrüstungen, Snowboard, Babysnow, Schneeschuhe, Mützen, Handschuhe usw."
    ],
    "en": [
      "Located at the foot of the Rambins beginners' slopes, rental of downhill and Nordic skis, snowboards, Babysnow, snowshoes, hats."
    ],
    "it": [
      "Novità 2025: uscite in mountain bike con la supervisione di istruttori.\r\nSituato nel cuore del villaggio di Corrençon en Vercors, il negozio GUILLET Sports - SPORT 2000 - relais MONDOVELO sarà lieto di accogliervi in un'atmosfera calda e familiare."
    ],
    "fr": [
      "Nouveauté 2025 : sorties VTT encadrées par des moniteurs.\r\nSitué au cœur du village de Corrençon en Vercors, le magasin GUILLET Sports - SPORT 2000 - relais MONDOVELO sera ravi de vous accueillir dans une ambiance familiale et chaleureuse."
    ],
    "es": [
      "Novedad para 2025: salidas en bicicleta de montaña supervisadas por monitores.\r\nSituada en el corazón del pueblo de Corrençon en Vercors, la tienda GUILLET Sports - SPORT 2000 - relais MONDOVELO estará encantada de recibirle en un ambiente cálido y familiar."
    ],
    "nl": [
      "Nieuw in 2025: mountainbiketochten onder begeleiding van instructeurs.\r\nGelegen in het hart van het dorp Corrençon en Vercors, zal de GUILLET Sports - SPORT 2000 - relais MONDOVELO winkel je met plezier ontvangen in een warme, familiale sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Guillet Sports - Sport 2000"
    ]
  },
