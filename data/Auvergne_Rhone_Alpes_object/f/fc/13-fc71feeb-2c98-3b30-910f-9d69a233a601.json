  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte und den Gebrauch der kleinen Wasserläufe, die das Viertel Châteauvert durchziehen und verschönern. Ein Spaziergang an der frischen Luft der Kanäle, die durch Valence fließen."
    ],
    "en": [
      "Discover the history and uses of the small waterways that run through the Châteauvert district. A walk in the freshness of the canals that flow through Valence."
    ],
    "it": [
      "Scoprite la storia e gli usi dei piccoli corsi d'acqua che attraversano il quartiere di Châteauvert. Passeggiate lungo i freschi canali che attraversano Valence."
    ],
    "fr": [
      "Découvrez l'histoire et les usages des petits cours d'eau qui traversent et agrémentent le quartier de Châteauvert. Une balade à la fraîcheur des canaux qui s’écoulent dans Valence."
    ],
    "nl": [
      "Ontdek de geschiedenis en het gebruik van de kleine waterwegen die door de wijk Châteauvert lopen. Maak een wandeling langs de koele kanalen die door Valence stromen."
    ],
    "es": [
      "Descubra la historia y los usos de los pequeños canales que atraviesan el barrio de Châteauvert. Pasee por los frescos canales que fluyen por Valence."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade nature : les canaux de Châteauvert"
    ]
  },
