  "rdfs:comment": {
    "de": [
      "Julia und Mickaël heißen Sie bei Aficionado willkommen. Öffnen Sie die Tür dieses Coffeeshops im Herzen von Bourg en Bresse und lassen Sie sich von einem Spezialitätenkaffee, einem Frühstück, einer Mahlzeit oder einem Snack verführen.\r\nAficionado verwöhnt Sie den ganzen Tag lang!"
    ],
    "en": [
      "Julia and Mickaël welcome you to Aficionado. Push open the door of this coffee shop in the heart of Bourg en Bresse, and let yourself be tempted by a specialty coffee, breakfast, meal or snack.\r\nAficionado treats you all day long!"
    ],
    "it": [
      "Julia e Mickaël vi danno il benvenuto da Aficionado. Spingete la porta di questa caffetteria nel cuore di Bourg en Bresse e lasciatevi tentare da un caffè di specialità, una colazione, un pasto o uno spuntino.\r\nAficionado vi delizia tutto il giorno!"
    ],
    "fr": [
      "Julia et Mickaël vous accueillent chez Aficionado. Poussez la porte de ce coffee shop au coeur de Bourg en Bresse, et laissez vous tenter par un café de spécialité, un petit-déjeuner, un repas ou un goûter.\r\nAficionado vous régale toute la journée !"
    ],
    "es": [
      "Julia y Mickaël le dan la bienvenida a Aficionado. Empuje la puerta de este café en el corazón de Bourg en Bresse, y déjese tentar por un café de especialidad, un desayuno, una comida o un tentempié.\r\n¡Aficionado le agasaja durante todo el día !"
    ],
    "nl": [
      "Julia en Mickaël heten je welkom bij Aficionado. Duw de deur van deze koffieshop in het hart van Bourg en Bresse open en laat je verleiden door een koffie met een specialiteit, een ontbijt, een maaltijd of een snack.\r\nAficionado verwent je de hele dag!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Aficionado Coffee shop & Brunch"
    ],
    "fr": [
      "Aficionado Coffee shop & Brunch"
    ]
  },
