  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7f26ec38-15f6-3dbf-80a9-cec8e0b56381",
      "dc:description": {
        "de": [
          "Verlorene Wege, \"man hat mir gesagt, dass\"?es gibt viele Geschichten über die Vergangenheit dieser Orte. Kannst du dich zurechtfinden und herausfinden, was wahr und was falsch ist?"
        ],
        "en": [
          "Chemins perdus, \"on m?a dit que\"? many stories are told about the past of these places. Will you be able to find your bearings and sort out the real from the fake?"
        ],
        "it": [
          "Sentieri perduti, \"me l'hanno detto\"? Ci sono molte storie sul passato di questi luoghi. Riuscirete a orientarvi e a distinguere il vero dal falso?"
        ],
        "fr": [
          "Chemins perdus, « on m’a dit que »…on raconte beaucoup d’histoires sur le passé de ces lieux. Saurez-vous trouver vos repères et démêler le vrai du faux ?"
        ],
        "nl": [
          "Verloren paden, \"dat is mij verteld\"? Er zijn veel verhalen over het verleden van deze plaatsen. Kun jij je oriënteren en het echte van het valse onderscheiden?"
        ],
        "es": [
          "Caminos perdidos, \"me lo han contado\"... hay muchas historias sobre el pasado de estos lugares. ¿Serás capaz de orientarte y distinguir lo verdadero de lo falso?"
        ]
      },
