  "rdfs:comment": {
    "de": [
      "Die Pizzeria médiévale bietet Ihnen traditionelle Pizzen an. Entdecken Sie vor allem Pizzen mit baskischem Coulis sowie Flammkuchen, die mit frischen Produkten hergestellt werden. Sie finden sie von Mittwoch bis Sonntag vor Ort oder rund um die Uhr am Automaten."
    ],
    "en": [
      "The medieval pizzeria offers traditional pizzas. Discover pizzas with Basque coulis, and flammekueche made with fresh produce. On-site from Wednesday to Sunday or at the 24/24 vending machine."
    ],
    "it": [
      "La pizzeria medievale offre pizze tradizionali. Scoprite le pizze con salsa basca e flammekueche preparate con prodotti freschi. Disponibili in loco dal mercoledì alla domenica o presso il distributore automatico aperto 24 ore su 24."
    ],
    "fr": [
      "La pizzeria médiévale vous propose des pizzas traditionnelles. Découvrez notamment des pizzas à base de coulis basquais, ainsi que la flammekueche réalisés avec des produits frais. A retrouver sur place du mercredi au dimanche ou au distributeur 24/24."
    ],
    "es": [
      "La pizzería medieval ofrece pizzas tradicionales. Descubra pizzas con salsa vasca y flammekueche elaboradas con productos frescos. Disponibles in situ de miércoles a domingo o en la máquina expendedora 24 horas."
    ],
    "nl": [
      "De middeleeuwse pizzeria biedt traditionele pizza's. Ontdek pizza's met Baskische saus en flammekueche gemaakt met verse producten. Ter plaatse verkrijgbaar van woensdag tot zondag of uit de 24-uurs automaat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizza Médiévale"
    ]
  },
