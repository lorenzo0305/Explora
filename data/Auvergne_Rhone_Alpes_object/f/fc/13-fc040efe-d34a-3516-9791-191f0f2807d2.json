  "rdfs:comment": {
    "de": [
      "Yves Culic ist Wanderleiter und Animator für Schulausflüge und Einführungen in die Umwelt im Klassenzimmer. Er bietet außerdem Einführungen in das instinktive Bogenschießen in den Bergen von Bourbonnaise an."
    ],
    "ru": [
      "Ив Кулик - гид и инструктор для школьных экскурсий и вводных курсов по экологии. Он также предлагает курсы стрельбы из инстинктивного лука в горах Бурбонне."
    ],
    "en": [
      "Yves Culic is a hiking guide and organizer for school outings and environmental education courses. He also offers instinctive archery courses in the Bourbonnais mountains."
    ],
    "it": [
      "Yves Culic è guida escursionistica e istruttore per gite scolastiche e corsi di introduzione all'ambiente. Offre anche corsi di tiro con l'arco istintivo sulle montagne del Bourbonnais."
    ],
    "fr": [
      "Yves Culic est accompagnateur de randonnées pédestres et animateur pour les sorties scolaires et des initiations à l'environnement en classe. Il propose également des initiations de tir à l'arc instinctif en montagne bourbonnaise."
    ],
    "zh": [
      "伊夫-库利克（Yves Culic）是一名徒步旅行向导，也是学校郊游和环境入门课程的讲师。他还在布尔邦尼山区开设射箭课程。"
    ],
    "nl": [
      "Yves Culic is wandelgids en instructeur voor schoolreisjes en inleidende cursussen over het milieu. Hij geeft ook cursussen instinctief boogschieten in de bergen van Bourbonnais."
    ],
    "es": [
      "Yves Culic es guía de senderismo e instructor de excursiones escolares y cursos de iniciación al medio ambiente. También ofrece cursos de tiro con arco instintivo en las montañas de Bourbonnais."
    ]
  },
