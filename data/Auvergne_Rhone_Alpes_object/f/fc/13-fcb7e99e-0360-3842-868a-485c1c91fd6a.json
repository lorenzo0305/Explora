  "rdfs:comment": {
    "de": [
      "Fahrradreparaturwerkstatt, Teileverkauf und -verleih. Verkauf von Sport- und Freizeitartikeln. Verleih von Bergsportausrüstung: Schneeschuhe, Skier, Snowboards. (+ Langlaufskiverleih nur in Aouste)."
    ],
    "en": [
      "Bike repair shop, parts sales and rentals. Sports store and sales of leisure equipment. Mountain equipment rentals: snowshoes, skis, snowboards. (+ Cross-country ski rentals in Aouste only)."
    ],
    "it": [
      "Negozio di riparazione di biciclette, vendita di ricambi e noleggio di biciclette. Vendita di articoli sportivi e per il tempo libero. Noleggio di attrezzature da montagna: racchette da neve, sci, snowboard (+ noleggio di sci di fondo solo ad Aouste)."
    ],
    "fr": [
      "Atelier de réparation, vente de pièces et location de vélo. Vente d'articles de sports et de Loisirs. Location de matériel de montagne : raquettes, ski, snowboard. (+ Location de skis de fond à Aouste uniquement)."
    ],
    "es": [
      "Taller de reparación de bicicletas, venta de piezas y alquiler de bicicletas. Venta de artículos deportivos y de ocio. Alquiler de material de montaña: raquetas, esquís, tablas de snowboard (+ alquiler de esquí de fondo sólo en Aouste)."
    ],
    "nl": [
      "Fietsreparatiewerkplaats, verkoop en verhuur van onderdelen. Verkoop van sport- en vrijetijdsartikelen. Verhuur van bergsportmateriaal: sneeuwschoenen, ski's, snowboards. (+ Verhuur van langlaufski's alleen in Aouste)."
    ]
  },
