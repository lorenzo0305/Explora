  "rdfs:comment": {
    "de": [
      "Restaurant im Gewerbegebiet Bièvre Dauphine, in der Nähe eines Autobahnkreuzes, das eine praktische Lösung für Geschäftskunden bietet. Freundliche Atmosphäre und schneller Service."
    ],
    "en": [
      "This restaurant is fully renovated and is located on the Bievre Dauphine business park, near the motorway junction. Catering for business lunches you can enjoy an efficient and friendly service."
    ],
    "it": [
      "Ristorante situato nel parco commerciale Bièvre Dauphine, vicino a uno svincolo autostradale, che offre una soluzione pratica per la clientela business. Atmosfera amichevole e servizio veloce."
    ],
    "fr": [
      "Restaurant situé sur la zone d'activité Bièvre Dauphine, à proximité d'un échangeur autoroutier, et offrant une solution pratique pour une clientèle d'affaire. Ambiance conviviale et service rapide."
    ],
    "es": [
      "Restaurante situado en el parque empresarial de Bièvre Dauphine, cerca de un cruce de autopistas, que ofrece una solución práctica para los clientes de negocios. Ambiente acogedor y servicio rápido."
    ],
    "nl": [
      "Restaurant gelegen in het bedrijvenpark van Bièvre Dauphine, vlakbij een snelwegknooppunt, dat een praktische oplossing biedt voor zakelijke klanten. Vriendelijke sfeer en snelle service."
    ]
  },
