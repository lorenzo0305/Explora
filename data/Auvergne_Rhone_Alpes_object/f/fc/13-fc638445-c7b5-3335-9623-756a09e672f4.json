  "rdfs:comment": {
    "de": [
      "Von der Schneefront von La Chaudanne oder dazwischen im Quartier du Rond-point ist die Gondelbahn von Rhodos der direkteste Zugang zum Altiport und seinen zahlreichen Pisten und Spielplätzen mitten im Wald."
    ],
    "en": [
      "From the Chaudanne snow front or the intermediary, in the Rond-Point district, the Rhodos gondola is the most direct access to the Altiport with numerous slopes and fun areas in the heart of the forest."
    ],
    "it": [
      "Dal fronte neve di Chaudanne o in posizione intermedia, nel quartiere di Rond-point, la telecabina Rhodos è l'accesso più diretto all'Altiport e alle sue numerose piste e aree gioco nel cuore della foresta."
    ],
    "fr": [
      "Depuis le front de neige de la Chaudanne ou à l'intermédiaire, au quartier du Rond-point, la télécabine des Rhodos est l'accès le plus direct vers l'Altiport et ses nombreuses pistes et espaces ludiques au cœur de la forêt."
    ],
    "nl": [
      "Vanaf het sneeuwfront van Chaudanne of op het tussenstation, in de wijk Rond-point, is de Rhodos-gondel de meest directe toegang tot het Altiport en zijn talrijke pistes en speelterreinen in het hart van het bos."
    ],
    "es": [
      "Desde el frente de nieve de Chaudanne o en el intermedio, en el barrio de Rond-point, el telecabina de Rhodos es el acceso más directo al Altiport y a sus numerosas pistas y zonas de juego en el corazón del bosque."
    ]
  },
  "rdfs:label": {
    "en": [
      "Rhodos Gondola"
    ],
    "fr": [
      "Télécabine des Rhodos"
    ],
    "nl": [
      "Rhodos kabelbaan"
    ]
  },
