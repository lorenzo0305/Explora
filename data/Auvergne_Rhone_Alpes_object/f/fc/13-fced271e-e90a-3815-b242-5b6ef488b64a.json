  "rdfs:comment": {
    "de": [
      "Ein Werkzeugmaschinenhersteller, der seinen Kunden zuhört und sie bedient\r\nSOMAB ist ein Konstrukteur und Hersteller von spanabhebenden, CNC-gesteuerten Werkzeugmaschinen."
    ],
    "en": [
      "A machine tool manufacturer attentive to customer needs\r\nSOMAB is a designer and manufacturer of CNC and CNC-assisted machine tools for machining operations."
    ],
    "it": [
      "Un produttore di macchine utensili che ascolta e serve i suoi clienti\r\nSOMAB è un progettista e produttore di macchine utensili a controllo numerico o assistite da CNC per la lavorazione."
    ],
    "fr": [
      "Un constructeur de machines-outils à l’écoute et au service de ses clients \r\nSOMAB est un concepteur - fabricant de machines outils à commande assistée ou numérique, travaillant par enlèvement de copeaux."
    ],
    "es": [
      "Un fabricante de máquinas-herramienta que escucha y atiende a sus clientes\r\nSOMAB diseña y fabrica máquinas herramienta CNC o asistidas por CNC para el mecanizado."
    ],
    "nl": [
      "Een fabrikant van bewerkingsmachines die luistert naar en ten dienste staat van zijn klanten\r\nSOMAB is een ontwerper en fabrikant van CNC of CNC-ondersteunde bewerkingsmachines."
    ]
  },
