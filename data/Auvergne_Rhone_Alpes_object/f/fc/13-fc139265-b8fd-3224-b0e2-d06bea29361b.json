  "rdfs:comment": {
    "de": [
      "Wir bieten Spaziergänge und Wanderungen mit unseren Packeseln an, von einem halben Tag bis zu mehreren Tagen.\r\nVon einer kleinen Panoramawanderung über die Schluchten bis hin zu einer kompletten einwöchigen Wandertour."
    ],
    "en": [
      "We offer walks and hikes with our pack donkeys, from 1/2 day to several days.\r\nFrom a short panoramic stroll along the gorges, to a complete week-long itinerant tour."
    ],
    "it": [
      "Offriamo passeggiate ed escursioni con i nostri asini da soma, da 1/2 giornata a più giorni.\r\nDa una breve passeggiata panoramica lungo le gole a un tour itinerante di una settimana intera."
    ],
    "fr": [
      "Nous proposons des balades et randonnées avec nos ânes de bât, de la 1/2 journée jusqu'à plusieurs jours.\r\nDe la petite balade panoramique sur les gorges, jusqu'au circuit complet d'une semaine en itinérance."
    ],
    "nl": [
      "We bieden wandelingen en trektochten met onze pakezels, van 1/2 dag tot meerdere dagen.\r\nVan een korte panoramische wandeling langs de kloven tot een trektocht van een hele week."
    ],
    "es": [
      "Ofrecemos paseos y excursiones con nuestros burros de carga, desde 1/2 día hasta varios días.\r\nDesde un breve paseo panorámico por las gargantas hasta una excursión itinerante de una semana completa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Anes de Rochegude"
    ]
  },
