  "rdfs:comment": {
    "de": [
      "Zögern Sie nicht, die Türen der Bibliothek zu öffnen, um sich mit der ganzen Familie zu bilden und zu informieren. Um diesen geselligen Ort am Leben zu erhalten, werden das ganze Jahr über wechselnde Ausstellungen und Veranstaltungen organisiert."
    ],
    "en": [
      "Don't hesitate to open the library's doors to discover new things with your family. Temporary exhibitions and events are organized throughout the year to bring this friendly place to life."
    ],
    "it": [
      "Non esitate ad aprire le porte della biblioteca per imparare qualcosa di nuovo con la vostra famiglia. Durante tutto l'anno vengono organizzate mostre temporanee ed eventi per mantenere vivo questo luogo accogliente."
    ],
    "fr": [
      "N'hésitez pas à ouvrir les portes de la bibliothèque pour vous cultiver et vous documenter en famille. Tout au long de l'année, pour faire vivre ce lieu convivial, des expositions temporaires et des animations sont organisées."
    ],
    "es": [
      "No dude en abrir las puertas de la biblioteca para aprender algo nuevo con su familia. A lo largo del año se organizan exposiciones temporales y eventos para mantener vivo este acogedor lugar."
    ],
    "nl": [
      "Aarzel niet om de deuren van de bibliotheek te openen om samen met je gezin iets nieuws te leren. Het hele jaar door worden er tijdelijke tentoonstellingen en evenementen georganiseerd om deze gezellige plek levendig te houden."
    ]
  },
  "rdfs:label": {
