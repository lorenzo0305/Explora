  "rdfs:comment": {
    "de": [
      "Die Vergers de Louisias produzieren von Juni bis Oktober rote Früchte und stellen außerdem hausgemachte, wenig süße Konfitüren (30 Sorten) oder auch Quittenpasten und biologisches Weizenmehl her."
    ],
    "en": [
      "Les Vergers de Louisias produces red fruit from June to October, and also makes lightly sweetened home-made jams (30 varieties), quince paste, fruit in syrup and organic wheat flour."
    ],
    "it": [
      "Les Vergers de Louisias produce frutti rossi da giugno a ottobre, oltre a marmellate fatte in casa a basso contenuto di zucchero (30 varietà), pasta di mele cotogne e farina di grano biologico."
    ],
    "fr": [
      "Les Vergers de Louisias produisent des fruits rouges de juin à octobre et fabriquent également des confitures maisons peu sucrées (30 variétés) ou encore des pâtes de coing et de la farine de blé biologique."
    ],
    "nl": [
      "Les Vergers de Louisias produceert rood fruit van juni tot oktober, maar ook zelfgemaakte jam met een laag suikergehalte (30 soorten), kweeperenpasta en biologisch tarwemeel."
    ],
    "es": [
      "Les Vergers de Louisias produce frutos rojos de junio a octubre, así como mermeladas caseras con bajo contenido en azúcar (30 variedades), dulce de membrillo y harina de trigo ecológico."
    ]
  },
  "rdfs:label": {
    "de": [
      "Marmeladenverkauf bei Obstproduktion Louisas"
    ],
    "en": [
      "Jam sale at Les Vergers de Louisias"
    ],
    "fr": [
      "Vente de confitures aux Vergers de Louisias"
    ]
  },
