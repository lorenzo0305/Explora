  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4d007b3a-0610-3ed0-964f-4833eb774c42",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Les Vergers de Saulty bietet Ihnen im Direktverkauf und bei Wiederverkäufern Äpfel, Apfelsaft, Birnen und Birnensaft an.\n\nÖffnungszeiten:\nMontag bis Freitag: 13:00-17:00 Uhr\n\nAbholung:\nWährend der Öffnungszeiten\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Les Vergers de Saulty offers apples, apple juice, pears and pear juice for direct sale and through their retailers.\n\nOpening days :\nMonday to Friday: 1pm-5pm\n\nPick-up :\nDuring opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Les Vergers de Saulty offre mele, succo di mela, pere e succo di pera per la vendita diretta e tramite i propri rivenditori.\n\nGiorni di apertura :\nDa lunedì a venerdì: dalle 13.00 alle 17.00\n\nRitiro :\nDurante gli orari di apertura\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: Les Vergers de Saulty vous propose en vente directe et auprès de leurs revendeurs des pommes, du jus de pommes, des poires et du jus de poires.\n\nJours d'ouverture : \nDu lundi au vendredi: 13h-17h\n\nRetrait :\nAux horaires d'ouverture \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Les Vergers de Saulty biedt appels, appelsap, peren en perensap aan voor rechtstreekse verkoop en via hun kleinhandelaars.\n\nOpeningsdagen :\nMaandag tot vrijdag: 13u tot 17u\n\nAfhalen :\nTijdens openingstijden\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Les Vergers de Saulty ofrece manzanas, zumo de manzana, peras y zumo de pera en venta directa y a través de sus minoristas.\n\nDías de apertura :\nDe lunes a viernes: de 13.00 a 17.00 h\n\nRecogida :\nDurante el horario de apertura\n\n "
        ]
      },
