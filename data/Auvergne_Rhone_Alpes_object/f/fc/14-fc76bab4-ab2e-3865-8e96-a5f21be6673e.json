  "rdfs:comment": {
    "de": [
      "Verkauf von lokalen Produkten: Obst aus dem Obstgarten und anderes Obst, Gemüse aus lokaler Produktion, Apfelsaft, Birnensaft aus den Obstgärten von Saulty und Marmeladen."
    ],
    "en": [
      "Sale of local produce: orchard fruit and other fruits, locally-grown vegetables, apple juice, pear juice from Saulty orchards and jams."
    ],
    "it": [
      "Vendita di prodotti locali: frutta del frutteto e altra frutta e verdura coltivata localmente, succo di mela, succo di pera dei frutteti di Saulty e marmellate."
    ],
    "fr": [
      "Vente de produits locaux : fruits du verger et autres fruits, légumes de production locale, jus de pommes, jus de poires des vergers de Saulty et confitures."
    ],
    "nl": [
      "Verkoop van lokale producten: fruit uit de boomgaard en andere lokaal geteelde groenten en fruit, appelsap, perensap uit de boomgaarden van Saulty en jam."
    ],
    "es": [
      "Venta de productos locales: fruta del huerto y otras frutas y verduras cultivadas localmente, zumo de manzana, zumo de pera de los huertos de Saulty y mermeladas."
    ]
