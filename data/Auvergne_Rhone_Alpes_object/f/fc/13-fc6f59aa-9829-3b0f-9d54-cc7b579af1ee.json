  "rdfs:comment": {
    "de": [
      "Mithilfe des Mash-up-Tisches lernen Sie die Grundlagen der Videobearbeitung kennen. Erstellen Sie kleine Filme mithilfe Ihrer Lieblingsvideospiele! In Zusammenarbeit mit dem Cinema des Templiers"
    ],
    "en": [
      "Discover the basics of video editing with the Mash-up table. Create short films using your favorite video games! In partnership with the Templiers cinema"
    ],
    "it": [
      "Utilizzate la tabella Mash-up per scoprire le basi del montaggio video. Create dei cortometraggi utilizzando i vostri videogiochi preferiti! In collaborazione con il cinema Templiers"
    ],
    "fr": [
      "À l'aide de la table Mash-up, venez découvrir les bases du montage vidéo. Créez des petits films à l'aide de vos jeux vidéo préférés ! En partenariat avec le cinéma des Templiers"
    ],
    "es": [
      "Utiliza la tabla Mash-up para descubrir los fundamentos de la edición de vídeo. Crea cortometrajes con tus videojuegos favoritos En colaboración con el cine Templiers"
    ],
    "nl": [
      "Gebruik de Mash-up tabel om de basis van videobewerking te ontdekken. Maak korte films met je favoriete videogames! In samenwerking met de bioscoop Templiers"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Quinzaine des jeux vidéo : Découvrez le montage vidéo avec vos jeux vidéo favoris !"
    ]
  },
