  "rdfs:comment": {
    "de": [
      "Der Point Information et Capitainerie Vallée Bleue informiert Sie über die Aktivitäten der Base de Loisirs und der nahe gelegenen Sehenswürdigkeiten. Empfang für Fahrräder, Schließfächer für Fahrräder, Fahrradreparaturmaterial, Dokumentation: Orientierungslaufkarte, Viarhona-Karte"
    ],
    "en": [
      "The Vallée Bleue Home Information Point informs you about activities at the Leisure Centre and nearby."
    ],
    "it": [
      "Il punto informativo Vallée Bleue e la Capitaneria di Porto forniscono informazioni sulle attività del Centro ricreativo e sui siti vicini. Reception per le biciclette, armadietti per le biciclette, attrezzature per la riparazione delle biciclette, documentazione: mappa dell'orienteering, mappa di Viarhona, ecc"
    ],
    "fr": [
      "Le Point Information et Capitainerie Vallée Bleue vous informe sur les activités de la Base de Loisirs et des sites à proximité. Accueil vélo, consignes vélo, matériel de réparation vélo, documentation: carte de course d'orientation. carte Viarhona"
    ],
    "nl": [
      "Het informatiepunt van Vallée Bleue en het kantoor van de havenmeester geven informatie over activiteiten in het recreatiecentrum en nabijgelegen plaatsen. Fietsontvangst, fietskluizen, fietsreparatiemateriaal, documentatie: oriëntatiekaart, kaart van Viarhona, enz"
    ],
    "es": [
      "El Punto de Información de la Vallée Bleue y la Capitanía Marítima proporcionan información sobre las actividades del Centro de Ocio y los lugares cercanos. Recepción de bicicletas, taquillas para bicicletas, material de reparación de bicicletas, documentación: mapa de orientación, mapa de Viarhona, etc"
    ]
  },
