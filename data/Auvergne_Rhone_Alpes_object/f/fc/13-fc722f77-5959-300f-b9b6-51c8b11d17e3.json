  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Oz 3300 öffnet seine Türen für Sie, um Ihnen ein umfassendes Angebot an Dienstleistungen zu bieten, die Ihr Erlebnis in Oz 3300, im Herzen des Alpe d'Huez Gebiets, bereichern sollen!"
    ],
    "en": [
      "The Oz 3300 Tourist Office opens its doors to offer you a full range of services to enhance your experience in Oz 3300, at the heart of the Espace Alpe d'Huez !"
    ],
    "it": [
      "L'Ufficio del Turismo di Oz 3300 vi apre le porte per offrirvi una gamma completa di servizi per migliorare la vostra esperienza a Oz 3300, nel cuore dell'Alpe d'Huez!"
    ],
    "fr": [
      "L'Office de Tourisme d'Oz 3300 vous ouvre ses portes pour vous offrir une gamme complète de services visant à enrichir votre expérience à Oz 3300, au cœur de l' Espace Alpe d'Huez !"
    ],
    "es": [
      "La Oficina de Turismo de Oz 3300 le abre sus puertas para ofrecerle una amplia gama de servicios que le permitirán disfrutar al máximo de su estancia en Oz 3300, en el corazón de Alpe d'Huez"
    ],
    "nl": [
      "Het Office du Tourisme Oz 3300 opent zijn deuren om u een volledig dienstenpakket aan te bieden om uw ervaring in Oz 3300 te verbeteren, in het hart van het  Espace Alpe d'Huez !"
    ]
  },
  "rdfs:label": {
    "en": [
      "Oz 3300 Tourist Office"
    ],
    "fr": [
      "Office de Tourisme d'Oz 3300"
    ],
    "nl": [
      "VVV-kantoor Oz 3300"
    ]
  },
