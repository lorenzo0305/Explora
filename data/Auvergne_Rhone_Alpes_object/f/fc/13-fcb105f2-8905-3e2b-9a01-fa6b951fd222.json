  "rdfs:comment": {
    "de": [
      "Machen Sie einen Spaziergang entlang der Kanäle, die zahlreiche Privat- und Gemeinschaftsgärten versorgen und dem Viertel ein ländliches Flair mitten in der Stadt verleihen."
    ],
    "en": [
      "Take a stroll along the canals that feed the many private and shared gardens, giving this district a rural feel right in the heart of the city."
    ],
    "it": [
      "Passeggiate lungo i canali che alimentano i numerosi giardini privati e condominiali, che conferiscono a questo quartiere un'atmosfera rurale proprio nel cuore della città."
    ],
    "fr": [
      "Promenez-vous le long des canaux qui alimentent de nombreux jardins privatifs et partagés, donnant à ce quartier un air de campagne en pleine ville."
    ],
    "es": [
      "Pasee por los canales que alimentan los numerosos jardines privados y compartidos, dando a este distrito un aire rural en pleno centro de la ciudad."
    ],
    "nl": [
      "Maak een wandeling langs de grachten die de vele privé- en gemeenschappelijke tuinen voeden, waardoor deze wijk een landelijk gevoel geeft in het hart van de stad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade nature : Les canaux du Charran"
    ]
  },
