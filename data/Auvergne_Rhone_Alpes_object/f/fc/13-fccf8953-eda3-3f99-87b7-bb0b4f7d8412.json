  "rdfs:comment": {
    "de": [
      "Überfliegen Sie schwindelfrei Saint-Gervais und bewundern Sie das Bergmassiv des Mont Blanc. Erste Flugerfahrung im Tandemgleitschirm für alle in Begleitung von staatlich geprüften, vom Verband FFVL zugelassenen Lehrern."
    ],
    "en": [
      "Tandem discovery flights, courses at all levels and equipment sales. \r\nItinér’Air parapente, a FFVL French free flight paragliding school, meets \r\nall your expectations"
    ],
    "it": [
      "Battesimi dell’aria in parapendio biposto sopra Saint-Gervais, sessioni di \r\navvicinamento alla disciplina di una giornata, corsi per qualsiasi livello, \r\nvendita di attrezzatura... Itinér’Air Parapente, scuola convenzionata con la \r\nfederazione di volo libero francese (FFVL) e aperta tutto l’anno, è ciò che \r\nstavate cercando!"
    ],
    "fr": [
      "Vols biplaces au-dessus de Saint-Gervais, journées découvertes, stages tous \r\nniveaux, vente de matériel… Itinér’Air Parapente, école Française de Vol Libre \r\nlabellisée FFVL, répond à toutes vos attentes"
    ],
    "es": [
      "Vuelos de dos plazas sobre Saint-Gervais, vuelos de descubrimiento, cursos para todos los niveles, venta de material... Itinere'Air Parapente, escuela francesa de vuelo libre \r\nCertificado FFVL, cumple con todas sus expectativas"
    ],
    "nl": [
      "Tandemvluchten boven Saint-Gervais, ontdekkingsdagen, cursussen voor alle niveaus, verkoop van materiaal\r\nitinér'Air Parapente, een FFVL erkende Franse parapente school\r\nschool, voldoet aan al uw verwachtingen"
    ]
  },
