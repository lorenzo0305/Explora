  "rdfs:comment": {
    "de": [
      "Das Gourmetrestaurant Maison Chat Noir (nur mit Reservierung) befindet sich in Aubenas im Süden der Ardèche. Der Chefkoch aus der Ardèche, Joshua Martin, geht mit einer kreativen grünen und lokalen Küche neue Wege und unterstützt die Produzenten der Ardèche."
    ],
    "en": [
      "The gastronomic restaurant Maison Chat Noir (by reservation only) is located in Aubenas in the southern Ardèche. Ardèche chef Joshua Martin innovates with creative green and local cuisine, supporting Ardèche producers."
    ],
    "it": [
      "Il ristorante gastronomico Maison Chat Noir (su prenotazione) si trova ad Aubenas, nell'Ardèche meridionale. Lo chef dell'Ardèche, Joshua Martin, innova con una cucina verde e locale creativa, sostenendo i produttori dell'Ardèche."
    ],
    "fr": [
      "Le restaurant gastronomique  Maison Chat Noir (sur réservation uniquement) est situé à Aubenas dans le Sud Ardèche. Le chef ardéchois, Joshua Martin, innove avec une cuisine créative verte et locale en soutenant les producteurs d'Ardèche."
    ],
    "nl": [
      "Het gastronomische restaurant Maison Chat Noir (alleen op reservering) ligt in Aubenas in de zuidelijke Ardèche. De chef-kok uit de Ardèche, Joshua Martin, innoveert met creatieve groene en lokale gerechten door producenten uit de Ardèche te steunen."
    ],
    "es": [
      "El restaurante gastronómico Maison Chat Noir (sólo con reserva) se encuentra en Aubenas, en el sur de Ardèche. El chef de Ardèche, Joshua Martin, innova con una cocina creativa verde y local apoyando a los productores de Ardèche."
    ]
  },
