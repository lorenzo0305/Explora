  "rdfs:comment": {
    "de": [
      "Dieses Gebäude wurde Ende des 12. Jahrhunderts, wahrscheinlich unter der Herrschaft von Philippe Auguste, errichtet. Sehenswert sind 2 Altarbilder in den Kapellen sowie die Glasfenster."
    ],
    "en": [
      "The building was constructed at the end of the 12th century, probably during the reign of Philippe Auguste. Don't miss the 2 altarpieces in the chapels and the stained-glass windows."
    ],
    "it": [
      "Questo edificio fu costruito alla fine del XII secolo, probabilmente durante il regno di Filippo Augusto. Da non perdere le 2 pale d'altare nelle cappelle e le vetrate."
    ],
    "fr": [
      "Cet édifice fut construit à la fin du XIIème siècle, sans doute sous le règne de Philippe Auguste. A ne pas manquer 2 retables dans les chapelles ainsi que les vitraux."
    ],
    "es": [
      "Este edificio se construyó a finales del siglo XII, probablemente durante el reinado de Felipe Augusto. No se pierda los 2 retablos de las capillas y las vidrieras."
    ],
    "nl": [
      "Dit gebouw werd aan het einde van de 12e eeuw gebouwd, waarschijnlijk tijdens het bewind van Philippe Auguste. Mis de 2 altaarstukken in de kapellen en de gebrandschilderde ramen niet."
    ]
  },
  "rdfs:label": {
