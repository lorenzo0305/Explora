  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf zum Skaten auf den 2 präparierten Strecken des nordischen Skigebiets von Prachanié :\r\n- La vie neuve: 5km mit 140m positivem Höhenunterschied.\r\n- Montée de la chavonne: 3km mit 260m positivem Höhenunterschied"
    ],
    "en": [
      "Try cross-country skate skiing on the 2 groomed trails in the Prachanié nordic area:\r\n- La Vie Neuve: 5km climbing 140m\r\n- Montée de la Chavonne: 3km climbing 260m"
    ],
    "it": [
      "Andate a pattinare sui 2 percorsi battuti nell'area nordica di Prachanié:\r\n- La vie neuve: 5 km con 140 m di salita\r\n- Montée de la Chavonne: 3 km con 260 m di salita"
    ],
    "fr": [
      "Partez faire du skating sur les 2 itinéraires damés du domaine nordique de Prachanié :\r\n- La vie neuve : 5km avec 140m de dénivelé positif\r\n- Montée de la chavonne : 3km avec 260m de dénivelé positif"
    ],
    "es": [
      "Patine en los 2 itinerarios acondicionados de la zona nórdica de Prachanié:\r\n- La vie neuve: 5 km con 140 m de desnivel\r\n- Montée de la Chavonne: 3 km con 260 m de desnivel"
    ],
    "nl": [
      "Ga schaatsen op de 2 geprepareerde routes in het noordse gebied van Prachanié:\r\n- La vie neuve: 5 km met 140 m stijging\r\n- Montée de la Chavonne: 3 km met 260 m klimmen"
    ]
  },
