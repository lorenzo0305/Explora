  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5f8768c0-6066-32ff-831f-1cae7f6fe1ca",
      "dc:description": {
        "de": [
          "Tanznachmittag von 14.30 bis 18.30 Uhr in der Festhalle von Bourthes, moderiert von Alain und Hubert\nGetränke vor Ort\nKostenloser Kinderschminkstand um 16.30 Uhr\nFackelzug 17.30 Uhr\nFeuerwerk gegen 18.30 Uhr"
        ],
        "en": [
          "Afternoon dance from 2.30 pm to 6.30 pm at the Bourthes village hall, hosted by Alain and Hubert\nRefreshments on site\nFree face painting for children at 4:30 pm\nTorchlight procession at 5:30pm\nFireworks around 6:30 pm"
        ],
        "it": [
          "Pomeriggio di danza dalle 14.30 alle 18.30 presso la sala del villaggio di Bourthes con Alain e Hubert\nRinfresco in loco\nPittura del viso gratuita per i bambini alle 16.30\nFiaccolata alle 17.30\nFuochi d'artificio intorno alle 18.30"
        ],
        "fr": [
          "Après-midi dansante de 14h30 à 18h30 à la salle des fêtes de Bourthes animée par Alain et Hubert \nBuvette sur place\nStand maquillage enfant gratuit à 16h30\nRetraite aux flambeaux 17h30\nFeux d'artifice vers 18h30"
        ],
        "es": [
          "Tarde de baile de 14h30 a 18h30 en la sala del pueblo de Bourthes con Alain y Hubert\nRefrescos in situ\nPintacaras gratuito para los niños a las 16.30 h\nDesfile de antorchas a las 17.30 h\nFuegos artificiales hacia las 18.30 h"
        ],
        "nl": [
          "Middagdans van 14.30 tot 18.30 uur in het Bourthes dorpshuis met Alain en Hubert\nVersnaperingen ter plaatse\nGratis schminken voor kinderen om 16.30 uur\nFakkeltocht om 17.30 uur\nVuurwerk rond 18.30 uur"
        ]
      },
      "@type": [
        "Description"
      ],
