  "rdfs:comment": {
    "de": [
      "Als Nebengebäude von Alleyras im Velay gehörte Vabres zu Gévaudan, ohne jedoch als eigenständige Pfarrei errichtet worden zu sein. Die Kapelle ist ein Gebäude, dessen Apsis nach dem romanischen Modell der Auvergne erbaut wurde und sich in ein im 19."
    ],
    "en": [
      "An annex of Alleyras in the Velay region, Vabres belonged to the Gévaudan, but was never established as an independent parish. The chapel has an apse built in the Auvergne Romanesque style and a nave built in the 19th century."
    ],
    "it": [
      "Annesso ad Alleyras, nella regione del Velay, Vabres apparteneva alla regione del Gévaudan ma non era una parrocchia indipendente. La cappella ha un'abside in stile romanico alverniate e una navata costruita nel XIX secolo."
    ],
    "fr": [
      "Annexe d'Alleyras en Velay, Vabres appartenait au Gévaudan sans pour autant avoir été érigée en paroisse indépendante. La chapelle est un édifice dont l'abside construite suivant le modèle roman auvergnat se prolonge par une nef édifiée au XIXème siècle."
    ],
    "nl": [
      "Vabres was een dependance van Alleyras in de regio Velay en behoorde tot de regio Gévaudan, maar was geen onafhankelijke parochie. De kapel heeft een apsis gebouwd in de Romaanse stijl van de Auvergne en een schip gebouwd in de 19e eeuw."
    ],
    "es": [
      "Anejo de Alleyras, en la región de Velay, Vabres pertenecía a la región de Gévaudan, pero no era una parroquia independiente. La capilla tiene un ábside construido en estilo románico de Auvernia y una nave construida en el siglo XIX."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Grégoire | Vabre"
    ]
  },
