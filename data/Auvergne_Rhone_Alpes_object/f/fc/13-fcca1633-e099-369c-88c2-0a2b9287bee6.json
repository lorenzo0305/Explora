  "rdfs:comment": {
    "de": [
      "Vercors Ski de Fond (VSF) ist ein Sportverein, der Aktivitäten im Zusammenhang mit dem nordischen Skisport anbietet.\r\nOb Wettkämpfer oder Freizeitsportler, Jugendliche oder Erwachsene, Anfänger oder Fortgeschrittene, jeder kann hier seinen Platz finden!"
    ],
    "en": [
      "Vercors Ski de Fond (VSF) is a sports association offering Nordic skiing activities.\r\nCompetitive or recreational, young or adult, beginner or advanced, there's something for everyone!"
    ],
    "it": [
      "Vercors Ski de Fond (VSF) è un'associazione sportiva che offre attività di sci nordico.\r\nAgonistico o ricreativo, giovane o adulto, principiante o avanzato, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "Le Vercors Ski de Fond (VSF) est une association sportive proposant des activités liées à la pratique du ski nordique.\r\nCompétiteur ou loisir, jeune ou adulte, débutant ou confirmé, chacun peut y trouver sa place !!"
    ],
    "nl": [
      "Vercors Ski de Fond (VSF) is een sportvereniging die Noords skiën aanbiedt.\r\nCompetitief of recreatief, jong of volwassen, beginner of gevorderd, er is voor elk wat wils!"
    ],
    "es": [
      "Vercors Ski de Fond (VSF) es una asociación deportiva que ofrece actividades de esquí nórdico.\r\nCompetitivo o recreativo, joven o adulto, principiante o avanzado, ¡hay para todos los gustos!"
    ]
  },
