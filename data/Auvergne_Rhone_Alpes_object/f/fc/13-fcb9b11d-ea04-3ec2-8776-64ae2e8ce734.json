  "rdfs:comment": {
    "de": [
      "Wenn \"hausgemacht\" Sinn macht? Hier sind das Brot und die Desserts \"hausgemacht\" und das Fleisch stammt aus der Region. es gibt 10 verschiedene Burgerrezepte, die Sie vor Ort bestellen oder mitnehmen können."
    ],
    "en": [
      "When \"home-made\" makes sense? Here, the bread and desserts are homemade, and the meat is locally sourced. 10 different burger recipes available to eat in or take away."
    ],
    "it": [
      "Quando il \"fatto in casa\" ha senso? Qui il pane e i dolci sono fatti in casa e la carne è di provenienza locale. sono disponibili 10 diverse ricette di hamburger da mangiare o da portare via."
    ],
    "fr": [
      "Quand le \"fait maison\" prend tout son sens… Ici, le pain et les desserts sont \"fait maison\", la viande est locale. 10 recettes différentes de burgers vous sont proposés sur place ou à emporter."
    ],
    "es": [
      "¿Cuándo lo \"casero\" tiene sentido? Aquí, el pan y los postres son caseros, y la carne es de origen local. hay 10 recetas diferentes de hamburguesas para comer en casa o para llevar."
    ],
    "nl": [
      "Wanneer is 'zelfgemaakt' zinvol? Hier zijn het brood en de desserts huisgemaakt en is het vlees van lokale herkomst. er zijn 10 verschillende hamburgerrecepten om ter plekke te eten of mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Len's Burgers Chef"
    ]
  },
