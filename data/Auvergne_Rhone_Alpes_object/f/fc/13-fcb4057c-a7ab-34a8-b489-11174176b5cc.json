  "rdfs:comment": {
    "de": [
      "Ein Freizeitbad für die ganze Familie, das dem Spaß im Wasser gewidmet ist, mit Sprudelbänken, Geysiren, Flüssen, Schwanenhälse, Schwimmleinen, Planschbecken für die Kleinen ... Um sich fit zu halten und zu bewegen, gibt es ein Programm für Aktivitäten im Wasser."
    ],
    "en": [
      "A space for the whole family to have fun in the water, with a bubble bench, jets, rivers, swan neck fountains, swimming lanes, paddling pool for the littlest ones...\r\nThere is also a programme of water-based activities for training and working off your energy."
    ],
    "it": [
      "Uno spazio per tutta la famiglia dedicato ai piaceri dell'acqua con panca a bolle, geyser, fiumi, colli di cigno, linee di nuoto, piscina per bambini per bambini ... Un programma di attività acquatiche per mantenere e da spendere."
    ],
    "fr": [
      "Un espace pour toute la famille dédié aux plaisirs de l'eau avec banquette à bulles, geysers, rivières, cols de cygne, lignes de nage, pataugeoire pour les tout-petits... Un programme d'activités aquatiques pour s'entretenir et se dépenser."
    ],
    "es": [
      "Un espacio para toda la familia dedicado a los placeres del agua con bancos de burbujas, géiseres, ríos, cuellos de cisne, líneas de natación, piscina infantil para los más pequeños... Un programa de actividades acuáticas para mantenerse en forma y hacer ejercicio."
    ],
    "nl": [
      "Een ruimte voor het hele gezin gewijd aan de geneugten van water met bubbelbank, geisers, rivieren, zwanenhalzen, zwemlijnen, peuterbad voor peuters ... Een programma van wateractiviteiten te onderhouden en uitgeven."
    ]
  },
  "rdfs:label": {
