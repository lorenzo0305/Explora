  "rdfs:comment": {
    "de": [
      "Entdeckung unserer Zucht von Angora-Ziegen. Verkauf von Knäueln und Kreationen aus Ziegenmohair: Pullover, Plaids, Strick- und Webwaren. Für Feinschmecker: Bio-Einkorn und Honig. Das ganze Jahr über nur nach Vereinbarung geöffnet."
    ],
    "en": [
      "Visit our angora goats farm! And discover our mohair products for sale: shawls, sweaters, plaids, knitting wool, hand-woven scarves... Open year-round, reservation highly recommended. Phone: +33 670 090 914"
    ],
    "it": [
      "Scoperta del nostro allevamento di capre d'angora. Vendita di gomitoli e creazioni in mohair di capra: maglioni, plaid, maglie e tessiture. Per i più golosi: farro biologico e miele. Aperto su appuntamento, tutto l'anno."
    ],
    "fr": [
      "Découverte de notre élevage de chèvres angora. Vente de pelotes et de créations en mohair de chevreau : pulls, plaids, tricots et tissages. Pour les gourmands : petit épeautre bio et miel. Ouvert sur rendez-vous uniquement, toute l'année."
    ],
    "es": [
      "Descubrimiento de nuestra granja de cabras de angora. Venta de ovillos y creaciones en mohair de cabra: jerseys, cuadros escoceses, prendas de punto y tejidos. Para los más golosos: espelta ecológica y miel. Abierto sólo con cita previa, todo el año."
    ],
    "nl": [
      "Bezoek aan de Angora geitenfokkerij en verkoop van wol en producten van mohair: sjaals, stolas, omslagdoeken, truien, plaids, bollen wol, tricots... Het hele jaar door geopend, afspraken welkom!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mohair du Moulin"
    ]
  },
