  "rdfs:comment": {
    "de": [
      "An der Ankunft des kuppelbaren Sessellifts von Piapolay nach Le Planay, Zugang für Fußgänger. Les Arolles überragt das Tal von Arêches. Die luftige Terrasse, die herrliche Aussicht und die herzhaften Gerichte, die dort oben serviert werden, machen den Ort zu einem Anhaltspunkt für eine Mahlzeit oder eine Erfrischung."
    ],
    "en": [
      "Les Arolles dominate over Arêches Valley, on the ski slopes in winter or on the walk course of Beaufortain in summer. The dizzy terrace of the restaurant and hearty meals served up there make with it a good landmark."
    ],
    "it": [
      "All'arrivo della seggiovia ad agganciamento automatico Piapolay a Le Planay, accesso pedonale. Les Arolles si affaccia sulla valle di Arêches. La terrazza aerea, la splendida vista e gli abbondanti piatti serviti ne fanno un punto di riferimento per il ristoro."
    ],
    "fr": [
      "A l'arrivée du télésiège débrayable de Piapolay au Planay, accès piétons. Les Arolles dominent la vallée d'Arêches. La terrasse aérienne, la vue splendide et les plats copieux servis là-haut en font un point de repère pour se restaurer ou se rafraîchir."
    ],
    "nl": [
      "Bij aankomst van de afneembare stoeltjeslift van Pipolay naar Planay, toegang voor voetgangers. Les Arolles domineren de Arêches-vallei. Het luchtterras, het prachtige uitzicht en de stevige gerechten die daar worden geserveerd, maken het een herkenningspunt om te eten of af te koelen."
    ],
    "es": [
      "A la llegada del telesilla desmontable de Piapolay en Le Planay, acceso peatonal. Les Arolles domina el valle de Arêches. La terraza aérea, la espléndida vista y los suculentos platos que allí se sirven lo convierten en un lugar de referencia para refrescarse."
    ]
  },
