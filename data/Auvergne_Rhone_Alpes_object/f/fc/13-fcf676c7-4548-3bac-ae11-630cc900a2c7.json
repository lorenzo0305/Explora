  "rdfs:comment": {
    "de": [
      "Als Produzenten und Handwerker von Mutter zu Tochter bieten wir unsere Produkte an, die in Chamrousse aus Blumen und Pflanzen zubereitet werden, sowie Workshops, in denen Sie umweltfreundliches Know-how entdecken können."
    ],
    "en": [
      "Producers and artisans from mother to daughter, we offer our products prepared in Chamrousse from flowers and plants, as well as workshops to discover environmentally-friendly know-how."
    ],
    "it": [
      "Produttori e artigiani da madre a figlia, offriamo i nostri prodotti preparati a Chamrousse a partire da fiori e piante, nonché laboratori per scoprire tecniche ecologiche."
    ],
    "fr": [
      "Producteurs et artisans de mère en fille, nous proposons nos produits préparés sur Chamrousse à base de fleurs et de plantes, ainsi que des ateliers pour découvrir des savoir-faire respectueux de l'environnement."
    ],
    "es": [
      "Productores y artesanos de madre a hija, ofrecemos nuestros productos elaborados en Chamrousse a partir de flores y plantas, así como talleres para descubrir técnicas respetuosas con el medio ambiente."
    ],
    "nl": [
      "Producenten en ambachtslieden van moeder op dochter, bieden wij onze producten bereid in Chamrousse van bloemen en planten, evenals workshops om milieuvriendelijke technieken te ontdekken."
    ]
  },
  "rdfs:label": {
