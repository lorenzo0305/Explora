  "rdfs:comment": {
    "de": [
      "Produzentin von Linsen und Sonnenblumen auf einem Betrieb mit hohem Umweltwert (Haute Valeur Environnementale). Sandie bietet ihre Produkte (Linsen in Beuteln) und Öle (Sonnenblumen und Raps) im Direktverkauf auf dem Hof an. Sie wurde mit dem Label \"Saveurs de l'Ain\" ausgezeichnet."
    ],
    "en": [
      "Lentil and sunflower grower on a High Environmental Value farm. Sandie sells her products (bagged lentils) and oils (sunflower and rapeseed) direct from the farm. She has been awarded the Saveurs de l'Ain label."
    ],
    "it": [
      "Produttore di lenticchie e girasoli in un'azienda agricola ad alto valore ambientale. Sandie offre i suoi prodotti (lenticchie in sacchetto) e gli oli (di girasole e di colza) per la vendita diretta in azienda. Ha ricevuto il marchio Saveurs de l'Ain."
    ],
    "fr": [
      "Productrice de lentilles et de tournesol sur une exploitation Haute Valeur Environnementale. Sandie propose ses produits (lentilles en sachet) et huiles (tournesol et colza) en vente directe à la ferme. Elle a reçu le label Saveurs de l'Ain."
    ],
    "es": [
      "Productor de lentejas y girasol en una explotación de alto valor medioambiental. Sandie ofrece sus productos (lentejas embolsadas) y aceites (girasol y colza) para la venta directa en la granja. Ha recibido el sello Saveurs de l'Ain."
    ],
    "nl": [
      "Producent van linzen en zonnebloemen op een bedrijf met een hoge milieuwaarde. Sandie biedt haar producten (linzen in zakken) en oliën (zonnebloem en koolzaad) aan voor rechtstreekse verkoop op de boerderij. Zij heeft het label Saveurs de l'Ain ontvangen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Ain'Grédients"
    ],
    "fr": [
      "Les Ain'Grédients"
    ]
  },
