      "dc:description": {
        "de": [
          "Brasserie in Familienbesitz. Nur wenige Schritte vom Aquarium Nausicaà entfernt, gegenüber vom Strand.\nParkplätze in der Nähe.\nMahlzeiten vor Ort"
        ],
        "en": [
          "Family-run brasserie. A stone's throw from the Nausicaà Aquarium, opposite the beach.\nParking nearby.\nMeals on site"
        ],
        "it": [
          "Brasserie familiare. A due passi dall'Acquario di Nausicaà, di fronte alla spiaggia.\nParcheggio nelle vicinanze.\nPasti in loco"
        ],
        "fr": [
          "Brasserie familiale. A deux pas de l'Aquarium Nausicaà, en face de la plage. \nParking à proximité.\nRepas sur place"
        ],
        "nl": [
          "Familie brasserie. Op een steenworp afstand van het Nausicaà Aquarium, tegenover het strand.\nParkeerplaats in de buurt.\nMaaltijden ter plaatse"
        ],
        "es": [
          "Brasería familiar. A un paso del Acuario Nausicaà, frente a la playa.\nParking cercano.\nComidas en el establecimiento"
        ]
