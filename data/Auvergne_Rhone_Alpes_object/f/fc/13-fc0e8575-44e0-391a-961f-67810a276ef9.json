  "rdfs:comment": {
    "de": [
      "900 m² mit weißem Marmor dekoriert, der den frisch gefallenen Schnee inspiriert: Sauna, Dampfbad, Fitnessraum, Friseursalon und beheizter Innen- und Außenpool. Sechs Behandlungsräume, darunter ein VIP-Raum mit eigener Badewanne und Sinnesdusche."
    ],
    "en": [
      "900 m² decorated in white marble inspiring freshly fallen snow: Sauna, Turkish bath, fitness room, hairdressing salon and heated indoor and outdoor swimming pool. Six treatment rooms, of which one is VIP, with private sensory bath and shower"
    ],
    "it": [
      "900 m² decorati con marmo bianco che ricorda la neve appena caduta: sauna, hammam, sala fitness, parrucchiere e piscina interna ed esterna riscaldata. Sei stanze per i trattamenti, compresa una stanza VIP con vasca e doccia sensoriale."
    ],
    "fr": [
      "900 m² décorés de marbre blanc inspirant la neige fraîchement tombée : sauna, hammam, salle de fitness, salon de coiffure et piscine intérieure et extérieure chauffée. Six salles de soins dont une salle VIP, avec baignoire et douche sensorielle privée."
    ],
    "nl": [
      "900 m² gedecoreerd met wit marmer dat vers gevallen sneeuw inspireert: sauna, hammam, fitnessruimte, kapsalon en verwarmd binnen- en buitenzwembad. Zes behandelkamers, waaronder een VIP-kamer met eigen bad en zintuiglijke douche."
    ],
    "es": [
      "900 m² decorados con mármol blanco que inspira la nieve recién caída: sauna, hammam, sala de fitness, peluquería y piscina interior y exterior climatizada. Seis salas de tratamiento, incluida una sala VIP con baño privado y ducha sensorial."
    ]
  },
