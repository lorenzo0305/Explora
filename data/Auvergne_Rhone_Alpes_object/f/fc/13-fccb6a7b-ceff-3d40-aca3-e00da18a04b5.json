  "rdfs:comment": {
    "de": [
      "Der Safran von Roys wird mit Liebe und so natürlich wie möglich in den Böden von Bourbonnais gepflanzt und geerntet, um Ihnen all seine Vorzüge zu bieten."
    ],
    "en": [
      "Saffron des Roys is planted and harvested with love, as naturally as possible, in Bourbonnais soil, to bring you all its benefits."
    ],
    "it": [
      "Lo zafferano di Roys è piantato e raccolto con amore, nel modo più naturale possibile, nella regione della Borgogna, per offrirvi tutti i suoi benefici."
    ],
    "fr": [
      "Le Safran des Roys est planté et récolté avec amour, le plus naturellement possible, dans les terres bourbonnaises, pour vous offrir tous ses bienfaits."
    ],
    "nl": [
      "Saffron des Roys wordt met liefde geplant en geoogst, zo natuurlijk mogelijk, in de Bourgogne, om je al zijn voordelen te bieden."
    ],
    "es": [
      "El Azafrán des Roys se planta y se cosecha con amor, de la forma más natural posible, en la región de Borgoña, para aportarle todos sus beneficios."
    ]
  },
