  "rdfs:comment": {
    "de": [
      "S'ortie, das sind die beiden Naturanimateure Cédric und Marie-Laure Bonvoison, die Ihnen eine Vielzahl von Naturausflügen in den Monts du Lyonnais auf Anfrage oder mit einem ganzjährigen Programm anbieten."
    ],
    "en": [
      "S'ortie is the name of two nature guides, Cédric and Marie-Laure Bonvoison, who offer a multitude of nature outings in the Monts du Lyonnais on request or with a year-round program."
    ],
    "it": [
      "S'ortie è composta da due guide naturalistiche, Cédric e Marie-Laure Bonvoison, che propongono un'ampia gamma di escursioni naturalistiche nei Monts du Lyonnais su richiesta o nell'ambito di un programma annuale."
    ],
    "fr": [
      "S'ortie, ce sont deux animateurs nature Cédric et Marie-Laure Bonvoison qui vous proposent une multitude de sorties nature dans les Monts du Lyonnais à la demande ou avec une programmation à l'année."
    ],
    "es": [
      "S'ortie está formada por dos guías de naturaleza, Cédric y Marie-Laure Bonvoison, que ofrecen un amplio abanico de salidas por la naturaleza de los Montes del Lyonnais bajo petición o en el marco de un programa anual."
    ],
    "nl": [
      "S'ortie bestaat uit twee natuurgidsen, Cédric en Marie-Laure Bonvoison, die een breed scala aan natuuruitstapjes in de Monts du Lyonnais aanbieden op aanvraag of als onderdeel van een programma dat het hele jaar door loopt."
    ]
  },
