  "rdfs:comment": {
    "de": [
      "Eine alte Scheune, die mit verfugten Steinen und sichtbaren Balken restauriert wurde. Mit seiner Bar-Ecke ist dieser Saal ideal für gesellige Abende mit der Familie oder mit Freunden. Ein Programm mit Jazzkonzerten und Musik aus aller Welt."
    ],
    "en": [
      "\"An old converted barn with stone walls and exposed beams. This function room with bar area makes the perfect party venue for a little togetherness with family or friends. A whole programme of jazz concerts and performances from around the world\""
    ],
    "it": [
      "Un vecchio fienile ristrutturato con pietre appuntite e travi a vista. Con la sua zona bar, questa sala è ideale per serate conviviali in famiglia o con gli amici.\r\nAl centro, la stufa a legna vi terrà al caldo in inverno."
    ],
    "fr": [
      "Une ancienne grange restaurée avec des pierres jointées et des poutres apparentes. Avec son coin bar, cette salle est idéale pour des soirées conviviales en famille ou entre amis.\r\nAu centre, le poêle à bois assure le confort en hiver."
    ],
    "nl": [
      "Een oude schuur gerestaureerd met puntstenen en zichtbare balken. Met zijn bargedeelte is deze ruimte ideaal voor gezellige avonden met familie of vrienden.\r\nIn het midden houdt de houtkachel het gezellig in de winter."
    ],
    "es": [
      "Antiguo granero restaurado con piedras puntiagudas y vigas vistas. Con su zona de bar, esta sala es ideal para las veladas en familia o entre amigos.\r\nEn el centro, la estufa de leña le mantendrá calentito en invierno."
    ]
  },
