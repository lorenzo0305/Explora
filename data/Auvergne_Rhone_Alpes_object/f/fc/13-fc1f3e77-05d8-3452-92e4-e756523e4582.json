  "rdfs:comment": {
    "de": [
      "Fossilien, Mineralien, antike Bücher, Vintage-Postkarten, Münzen, Modeschmuck, Kunsthandwerk, Sammlerstücke und Geschenkideen. Verkauf von Edelmetallen, Gold und Silber."
    ],
    "en": [
      "Fossils, minerals, antique books, vintage postcards, coins, costume jewelry, crafts, collectibles and gift ideas. Buying precious metals, gold and silver."
    ],
    "it": [
      "Da 30 anni a Montélimar, Fossili, minerali, cartoline, monete, ampia scelta di gioielli in pietre vere, bigiotteria (ZAG, Mix,...) artigianato, collezioni e idee regalo. Acquisto di metalli preziosi, oro, argento..."
    ],
    "fr": [
      "Depuis 30 ans à Montélimar, Fossiles, minéraux, cartes postales, monnaies, grand choix de bijoux en pierre véritable, bijoux fantaisies (ZAG, Mix,...) artisanat, collections, et idées cadeaux. Achat métaux précieux, or, argent.."
    ],
    "nl": [
      "Fossielen, mineralen, boeken en oude ansichtkaarten, munten, namaakjuwelen, kunstnijverheid, curiosa en cadeaus. Aankoop van edele metalen, goud en zilver."
    ],
    "es": [
      "Desde hace 30 años en Montélimar, Fósiles, minerales, postales, monedas, gran selección de joyas de piedras auténticas, bisutería (ZAG, Mix,...) artesanía, colecciones e ideas para regalos. Compra de metales preciosos, oro, plata..."
    ]
  },
