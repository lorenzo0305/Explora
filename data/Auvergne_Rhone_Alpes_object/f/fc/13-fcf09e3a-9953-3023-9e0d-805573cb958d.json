  "rdfs:comment": {
    "de": [
      "Ein Geschäft, das von Keramikern, die auf der kollektiven Abenteuer einzulassen, um einen Platz zu bündeln, bedeutet, Träume. Unser Vorschlag: Beleg sowie unsere kreativen und vielseitigen Universum getippt und kommunizieren unser Geschäft."
    ],
    "en": [
      "Shared boutique created in 2013 by ceramists. A collective adventure gathering a common space, means and dreams. We exhibit our creative and eclectic universes all in one place."
    ],
    "it": [
      "9 ceramisti locali, con universi originali ed eclettici. Porcellana, gres, terracotta, terra smaltata come al tempo delle argille che danno vita a oggetti utilitari o scultorei. Orari sul sito web."
    ],
    "fr": [
      "9 céramistes locales, aux univers originaux et éclectiques. Porcelaine, grès, faïence, terre vernissée comme au temps d'argiles donnant naissance à des objets utilitaires ou sculpturaux. Horaires sur le site web."
    ],
    "nl": [
      "Een winkel die door keramisten die beginnen aan het collectief avontuur om een plaats te bundelen, betekent, dromen. Ons voorstel: exposeren samen onze creatieve en eclectische universum getypt en communiceren van onze business."
    ],
    "es": [
      "9 ceramistas locales, con universos originales y eclécticos. Porcelana, gres, loza, tierra vidriada como en la época de las arcillas dando lugar a objetos utilitarios o escultóricos. Horarios en el sitio web."
    ]
  },
