  "rdfs:comment": {
    "de": [
      "Alain hat sich in der Drôme Provençale niedergelassen und ist Produzent von Lavendelhonig, Frühlingshonig und Allblütenhonig. Diese Produkte sind reich an natürlichen Zuckern, die dank ihrer therapeutischen Eigenschaften der Gesundheit zugute kommen."
    ],
    "en": [
      "Producer of lavender honey, spring honey, wild flower honey.\r\nSales on site and at Rosans tourist office."
    ],
    "it": [
      "Con sede nella Drôme provenzale, Alain produce miele di lavanda, miele di primavera e miele per tutti i fiori. Questi prodotti sono ricchi di zuccheri naturali, che fanno bene alla salute grazie alle loro proprietà terapeutiche."
    ],
    "fr": [
      "Installé en Drôme provençale, Alain est producteur de miel de lavande, miel de printemps, miel toutes fleurs. Des produits riches en sucres naturels qui sont des bienfaits pour la santé grâce à ses propriétés thérapeutiques."
    ],
    "nl": [
      "Producent van lavendelhoning, lentehoning, bloemhoning."
    ],
    "es": [
      "Establecido en Drôme provençale, Alain produce miel de lavanda, miel de primavera y miel para todas las flores. Estos productos son ricos en azúcares naturales, buenos para la salud gracias a sus propiedades terapéuticas."
    ]
  },
