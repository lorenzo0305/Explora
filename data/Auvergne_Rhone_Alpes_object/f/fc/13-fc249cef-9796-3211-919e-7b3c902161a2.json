  "rdfs:comment": {
    "de": [
      "Der Familienbauernhof La ferme des Aubracs in Montbeugny in der Nähe von Moulins ist auf die Rinderzucht und den Direktverkauf von Aubrac-Rindfleisch spezialisiert."
    ],
    "en": [
      "A family farm in Montbeugny near Moulins, La ferme des Aubracs specialises in cattle breeding and the direct sale of Aubrac beef."
    ],
    "it": [
      "Azienda agricola a conduzione familiare situata a Montbeugny, vicino a Moulins, La ferme des Aubracs è specializzata nell'allevamento di bovini e nella vendita diretta di carne di razza Aubrac."
    ],
    "fr": [
      "Ferme familiale à Montbeugny près de Moulins, La ferme des Aubracs est spécialisée dans l'élevage bovin et la vente directe  de viande de bœuf Aubrac."
    ],
    "es": [
      "La ferme des Aubracs, granja familiar situada en Montbeugny, cerca de Moulins, está especializada en la cría de ganado y en la venta directa de carne de vacuno de Aubrac."
    ],
    "nl": [
      "La ferme des Aubracs, een familiebedrijf in Montbeugny bij Moulins, is gespecialiseerd in het fokken van runderen en de rechtstreekse verkoop van Aubrac-rundvlees."
    ]
  },
