  "rdfs:comment": {
    "de": [
      "Für die Liebhaber des Boulespiels,\r\nIm Skiort erwarten Sie verschiedene Pétanque-Plätze. Sie befinden sich auf der Höhe von Plan Mollaret, Montjoie, Place de la Madeleine und der Station 1450."
    ],
    "en": [
      "For Pétanque fans,\r\nThere are several Pétanque courts in the resort. They are located at Plan Mollaret, Montjoie, Place de la Madeleine and resort 1450."
    ],
    "it": [
      "Per gli appassionati di Pétanque,\r\nNel resort sono presenti diversi campi da pétanque. Si trovano a Plan Mollaret, Montjoie, Place de la Madeleine e la stazione 1450."
    ],
    "fr": [
      "Pour les amateurs de Pétanque,\r\nDifférents terrains de Pétanque vous attendent sur la station. Situés au niveau de Plan Mollaret, du Montjoie, de la Place de la Madeleine et de la station 1450."
    ],
    "nl": [
      "Voor jeu de boules fans,\r\nEr zijn verschillende jeu de boulesbanen in het resort. Ze bevinden zich in Plan Mollaret, Montjoie, Place de la Madeleine en resort 1450."
    ],
    "es": [
      "Para los aficionados a la petanca,\r\nHay varias pistas de petanca en la estación. Se encuentran en Plan Mollaret, Montjoie, Place de la Madeleine y la estación 1450."
    ]
  },
  "rdfs:label": {
