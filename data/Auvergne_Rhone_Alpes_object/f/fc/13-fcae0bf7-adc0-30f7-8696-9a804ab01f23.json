  "rdfs:comment": {
    "de": [
      "In die Fußstapfen der Älteren treten am 20. Juni auch die jungen Rider, die sich dem legendären Mountain Of Hell stellen werden."
    ],
    "en": [
      "Following in the footsteps of their elders, the young riders will also take on the mythical Mountain Of Hell on 20 June."
    ],
    "it": [
      "Seguendo le orme dei loro anziani, i giovani piloti affronteranno anche la mitica Montagna dell'Inferno il 20 giugno."
    ],
    "fr": [
      "Dans les traces de leurs aînés, les jeunes rideurs vont eux aussi affronter la mythique Mountain Of Hell le 20 juin prochain."
    ],
    "es": [
      "Siguiendo los pasos de sus mayores, los jóvenes pilotos también se enfrentarán a la legendaria Montaña del Infierno el 20 de junio."
    ],
