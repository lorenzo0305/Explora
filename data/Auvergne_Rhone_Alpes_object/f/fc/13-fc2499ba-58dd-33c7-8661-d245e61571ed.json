  "rdfs:comment": {
    "de": [
      "In einem historischen Gebäude in Le Sappey, im Herzen des Dorfes, empfangen Sie Joe und Marco für leckere Berggerichte. Herzliche Atmosphäre und Chartousine garantiert!"
    ],
    "en": [
      "In a historic building in Le Sappey, in the heart of the village, Joe and Marco welcome you for tasty mountain dishes. A warm, Chartous atmosphere guaranteed!"
    ],
    "it": [
      "In un edificio storico di Le Sappey, nel cuore del villaggio, Joe e Marco vi accolgono per gustare i gustosi piatti di montagna. Un'atmosfera calda e in stile Chartres è garantita!"
    ],
    "fr": [
      "Dans un bâtiment historique du Sappey, au cœur du village, Joe et Marco vous accueillent pour de savoureux plats montagnards. Ambiance chaleureuse et chartousine garantie !"
    ],
    "nl": [
      "In een historisch gebouw in Le Sappey, in het hart van het dorp, heten Joe en Marco je welkom voor smakelijke gerechten uit de bergen. Een warme, Chartres-achtige sfeer gegarandeerd!"
    ],
    "es": [
      "En un edificio histórico de Le Sappey, en el corazón del pueblo, Joe y Marco le dan la bienvenida para degustar sabrosos platos de montaña. Un ambiente cálido al estilo de Chartres garantizado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'auberge chez Joe et Marco"
    ]
  },
