  "rdfs:comment": {
    "de": [
      "Im Herzen der Bresse, große Anlage in idealer Lage am Rande der RD.1083, 5 km vom Autobahnkreuz A40 und A39 Lyon-Genf-Mâcon-Paris entfernt - Ausfahrt Nr. 6 A40."
    ],
    "en": [
      "In the heart of the Bresse region, a vast establishment ideally located on the edge of the RD.1083, 5 km from the A40 and A39 Lyon-Geneva-Mâcon-Paris motorway interchange - Exit n°6 A40."
    ],
    "it": [
      "Nel cuore della regione della Bresse, un vasto stabilimento situato in posizione ideale ai margini della RD.1083, a 5 km dagli svincoli autostradali A40 e A39 Lione-Ginevra-Mâcon-Parigi - Uscita n°6 A40."
    ],
    "fr": [
      "Au coeur de la Bresse, vaste établissement idéalement situé en bordure de la RD.1083 à 5 km de l'échangeur autoroutier A 40 et A39  Lyon-Genève-Mâcon-Paris - Sortie n°6 A40."
    ],
    "nl": [
      "In het hart van de Bresse, een uitgestrekt etablissement ideaal gelegen aan de rand van de RD.1083, op 5 km van de snelwegknooppunten A40 en A39 Lyon-Geneva-Mâcon-Parijs - Afrit n°6 A40."
    ],
    "es": [
      "En el corazón de la región de Bresse, un vasto establecimiento idealmente situado al borde de la RD.1083, a 5 km de los cruces de la autopista A40 y A39 Lyon-Ginebra-Mâcon-París - Salida n°6 A40."
    ]
