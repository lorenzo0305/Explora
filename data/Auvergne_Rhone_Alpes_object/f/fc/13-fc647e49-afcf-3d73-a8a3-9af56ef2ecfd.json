  "rdfs:comment": {
    "de": [
      "Das Théâtre de l'Echange bietet Theateraufführungen, aber auch Amateurfilme einmal im Monat. Es ist auch während der Weihnachtsferien geöffnet.\r\nHistorisch gesehen war es das Camille-Mugnier-Theater."
    ],
    "en": [
      "The Théâtre de l'Echange offers theatrical performances as well as amateur cinema once a month. It is open during the Christmas vacations.\r\nHistorically, it was the Camille Mugnier theater."
    ],
    "it": [
      "Il Théâtre de l'Echange offre spettacoli teatrali e cinema amatoriale una volta al mese. È aperto durante le vacanze di Natale.\r\nStoricamente era il teatro Camille Mugnier."
    ],
    "fr": [
      "Le Théâtre de l'Echange propose des représentations théâtrales mais aussi du cinéma amateur une fois par mois. Il est ouvert pendant les vacances de Noël.\r\nHistoriquement, c'était le théâtre Camille Mugnier."
    ],
    "nl": [
      "Het Théâtre de l'Echange biedt een keer per maand theatervoorstellingen en amateurfilms. Het is open tijdens de kerstvakantie.\r\nHistorisch gezien was dit het Camille Mugnier theater."
    ],
    "es": [
      "El Théâtre de l'Echange ofrece representaciones teatrales y cine amateur una vez al mes. Está abierto durante las vacaciones de Navidad.\r\nHistóricamente, fue el teatro Camille Mugnier."
    ]
  },
