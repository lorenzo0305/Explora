  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/277568e6-2b58-345a-bcbe-0b3ec4ccfe61",
      "dc:description": {
        "de": [
          "Der Garten des Minenhauses ist ein blühender und nährender Garten, der die Herausforderungen der heutigen Zeit widerspiegelt!"
        ],
        "en": [
          "A nourishing and flowering garden, the garden of the Maison des Mines echoes the issues of today!"
        ],
        "it": [
          "Giardino di fiori e di cibo, il giardino della Maison des Mines riflette le sfide di oggi!"
        ],
        "fr": [
          "Jardin nourricier et fleuri, le jardin de la maison des mines fait écho aux enjeux d’aujourd’hui !"
        ],
        "es": [
          "Jardín de flores y alimentos, el jardín de la Maison des Mines refleja los retos actuales"
        ],
        "nl": [
          "Een tuin van bloemen en voedsel, de tuin van het Maison des Mines weerspiegelt de uitdagingen van vandaag!"
        ]
      },
