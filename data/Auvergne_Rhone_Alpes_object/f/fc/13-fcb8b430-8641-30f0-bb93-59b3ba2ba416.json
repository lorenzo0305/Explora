  "rdfs:comment": {
    "de": [
      "Schlittschuhlaufen im Freien auf einer 400m² großen Eisbahn im Zentrum des Club-Resorts... Ein magischer Moment für die ganze Familie! Für alle ab 2 Jahren geeignet. Pinguine und Stühle können gemietet werden."
    ],
    "en": [
      "Outdoor skating on a 400m² rink in the centre of the Village... A magical moment to share with your family! Activity open to children from age 2, penguins and chairs available for rent."
    ],
    "it": [
      "Pattinate all'aperto su una pista di ghiaccio di 400 m² nel centro del Villaggio... Un momento magico da condividere con la famiglia! Attività accessibile a tutti a partire dai 2 anni, pinguini e sedie a noleggio."
    ],
    "fr": [
      "Patinez à l’extérieur sur une patinoire de 400m², au centre du Village... Un  moment de magie à partager en famille ! Activité accessible à tous dès 2 ans, pingouins et chaises disponibles à la location."
    ],
    "nl": [
      "Schaats in de buitenlucht op een schaatsbaan van 400 m2 in het centrum van het dorp. Een magisch moment te delen met de familie ! Activiteit toegankelijk voor iedereen vanaf 2 jaar, stoelen te huur."
    ],
    "es": [
      "Patinar al aire libre en una pista de hielo de 400 m² en el centro de la Villa... ¡Un momento mágico para compartir con su familia! Actividad accesible para todos a partir de 2 años, pingüinos y sillas disponibles para alquilar."
    ]
  },
  "rdfs:label": {
    "de": [
