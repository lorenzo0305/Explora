  "rdfs:comment": {
    "de": [
      "Dieses seit fast 40 Jahren vom Club des cyclos Bourcains angebotene, nicht wettbewerbsorientierte Radtourismustreffen ermöglicht es, auf Strecken von 50 bis über 100 Kilometern im nordöstlichen Teil der Drôme in die Pedale zu treten."
    ],
    "en": [
      "Organized by the Club des Cyclos Bourcains for almost 40 years, this non-competitive cycling touring event features routes ranging from 50 to over 100 kilometers in the northeastern part of the Drôme."
    ],
    "it": [
      "Organizzata dal cicloclub Bourcain da quasi 40 anni, questa manifestazione cicloturistica non competitiva prevede percorsi da 50 a oltre 100 chilometri nel nord-est della Drôme."
    ],
    "fr": [
      "Proposé par le club des cyclos Bourcains depuis près de 40 ans, ce rendez-vous cyclotouriste non compétitif permet de pédaler sur des parcours de 50 à plus de 100 kilomètres dans la partie nord-est de la Drôme."
    ],
    "es": [
      "Organizada por el club ciclista Bourcain desde hace casi 40 años, esta prueba cicloturista no competitiva recorre rutas de entre 50 y más de 100 kilómetros en el noreste de la Drôme."
    ],
    "nl": [
      "Dit niet-competitieve fietstoerneevenement wordt al bijna 40 jaar georganiseerd door de Bourcain cyclos club en loopt over routes van 50 tot meer dan 100 kilometer in het noordoosten van de Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée cycliste des Violettes"
    ]
  },
