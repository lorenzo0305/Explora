  "rdfs:comment": {
    "de": [
      "«Beachpoint» für die Vermietung von Kajaks, Paddles, Rudern und Tretbooten. 1. Abfahrt um 13.00 Uhr und letzte Abfahrt um 18.00 Uhr. \r\nGeführte Sitzungen jeden Donnerstag nachmittags vom 9. Juli bis 20. August, machen Sie einen gerahmten Ausflug nach Ihren Wünschen."
    ],
    "en": [
      "“Beach point” for kayaks, paddles, oars and pedal boats. 1st departure at 1 PM and last departure at 6 PM. \r\nSupervised sessions every Thursday afternoon from July 9th to August 20th, do a supervised outing according to your desires."
    ],
    "it": [
      "\"Punto spiaggia\" per il noleggio di kayak, pagaie, remi e pedalò. prima partenza alle 13.00 e ultima alle 18.00.\r\nSessioni sorvegliate ogni giovedì pomeriggio dal 9 luglio al 20 agosto, per un'uscita sorvegliata in base al vostro umore."
    ],
    "fr": [
      "« Point plage » pour la location de kayaks, paddles, avirons et pédalos. 1er départ à 13h et dernier départ à 18h. \r\nSéances encadrées tous les jeudis après-midi du 9 juillet au 20 août, faites une sortie encadrée en fonction de vos envies."
    ],
    "nl": [
      "\"Strandpunt voor verhuur van kajaks, peddels, roeispanen en waterfietsen. eerste vertrek om 13.00 uur en laatste vertrek om 18.00 uur.\r\nElke donderdagmiddag van 9 juli tot 20 augustus: maak een uitstapje onder begeleiding dat bij je stemming past."
    ],
    "es": [
      "\"Beach point\" para el alquiler de kayaks, remos y pedales. 1ª salida a las 13 h y última salida a las 18 h.\r\nSesiones supervisadas todos los jueves por la tarde del 9 de julio al 20 de agosto. Haga una salida supervisada a su gusto."
    ]
  },
