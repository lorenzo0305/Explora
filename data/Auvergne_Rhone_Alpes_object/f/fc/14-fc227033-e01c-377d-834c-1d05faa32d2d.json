      "dc:description": {
        "de": [
          "Dieses Unternehmen kümmert sich um die Reparatur von Mobilheimen aller Marken: Elektrizität, Boden, Innenwände, Dachluke, Verkleidung."
        ],
        "en": [
          "This company repairs all brands of mobile homes: electricity, flooring, interior walls, skylights, cladding."
        ],
        "it": [
          "Questa azienda ripara case mobili di tutte le marche: elettricità, pavimenti, pareti interne, lucernari, rivestimenti."
        ],
        "fr": [
          "Cette entreprise s'occupe de la réparation de mobil-homes de toutes les marques : électricité, plancher, parois intérieur, lanterneau, bardage."
        ],
        "es": [
          "Esta empresa repara autocaravanas de todas las marcas: electricidad, suelos, paredes interiores, claraboyas, revestimientos."
        ],
        "nl": [
          "Dit bedrijf repareert stacaravans van alle merken: elektriciteit, vloeren, binnenmuren, daklichten, bekleding."
        ]
