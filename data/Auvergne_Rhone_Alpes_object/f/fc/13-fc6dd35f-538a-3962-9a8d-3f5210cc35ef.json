  "rdfs:comment": {
    "de": [
      "Die Auberge des Avenières bietet traditionelle Küche mit einer Auswahl an Menüs und Gerichten à la carte: Froschschenkel, Vorspeisenbuffet, Pommes frites, Moules frites, Ravioles."
    ],
    "en": [
      "L'Auberge des Avenières serves authentic and traditional cuisine, with a wide choice of menus and a la carte dishes: frogs' legs, starter buffet, large salads, fried dishes..."
    ],
    "it": [
      "L'Auberge des Avenières offre una cucina tradizionale con una scelta di menu e piatti à la carte: cosce di rana, antipasti a buffet, pesce fritto, cozze fritte e ravioli."
    ],
    "fr": [
      "L'Auberge des Avenières propose une cuisine traditionnelle avec choix de menus et de plats à la carte : cuisses de grenouilles, buffet d'entrées, fritures, moules frites, ravioles."
    ],
    "es": [
      "El Auberge des Avenières ofrece cocina tradicional con menús a elegir y platos a la carta: ancas de rana, entrantes de bufé, pescado frito, mejillones fritos y raviolis."
    ],
    "nl": [
      "De Auberge des Avenières biedt een traditionele keuken met een keuze aan menu's en à la carte gerechten: kikkerbilletjes, voorgerechtenbuffet, gebakken vis, gebakken mosselen en ravioli."
    ]
  },
