  "rdfs:comment": {
    "de": [
      "Verkauf von Kuh- und Ziegenkäse auf dem Bauernhof. Verkauf auf dem Bauernmarkt in Aurec am Freitagnachmittag von 15:00 bis 18:45 Uhr und auf dem Markt in Monistrol am Samstagmorgen von 8:00 bis 12:00 Uhr."
    ],
    "en": [
      "Farm sale of cow and goat cheeses. Sales at the Aurec farmers' market on Friday afternoon from 3 to 6.45 pm and at the Monistrol market on Saturday morning from 8 to 12 am."
    ],
    "it": [
      "Vendita in azienda di formaggi di mucca e di capra. Vendita al mercato agricolo di Aurec il venerdì pomeriggio dalle 15.00 alle 18.45 e al mercato di Monistrol il sabato mattina dalle 8.00 alle 12.00."
    ],
    "fr": [
      "Vente à la ferme de fromages de vache et chèvre. Vente sur le marché de producteurs d'Aurec le vendredi après midi de 15 h à 18h45 et sur le marché de Monistrol le samedi matin de 8h à 12 h."
    ],
    "nl": [
      "Verkoop op de boerderij van koe- en geitenkazen. Verkoop op de boerenmarkt van Aurec op vrijdagmiddag van 15.00 tot 18.45 uur en op de markt van Monistrol op zaterdagochtend van 8.00 tot 12.00 uur."
    ],
    "es": [
      "Venta en la granja de quesos de vaca y de cabra. Venta en el mercado agrícola de Aurec los viernes por la tarde de 15 a 18.45 horas y en el mercado de Monistrol los sábados por la mañana de 8 a 12 horas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec d'Orcimont L'Or des Champs"
    ]
  },
