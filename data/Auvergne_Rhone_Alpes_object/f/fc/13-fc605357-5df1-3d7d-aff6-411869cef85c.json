  "rdfs:comment": {
    "de": [
      "Besichtigung nach Vereinbarung. Der Künstler Daniel Lanne widmet sich seiner Leidenschaft: der Glasmalerei. Er verwendet die Tiffany-Methode (Kupfer und Zinn) und Blei. Die Arbeiten befassen sich mit verschiedenen Themen: Vögel, Geometrie, Figuren... Möglichkeit von Praktika."
    ],
    "en": [
      "Visit by appointment.The artist, Daniel Lanne, dedicates himself to its passion : the stained glass. He uses Tiffany method (copper and tin) and lead. Its pieces are about birds, geometry, characters... Course possible."
    ],
    "it": [
      "Visita su appuntamento. L'artista, Daniel Lanne, si dedica alla sua passione: il vetro colorato. Utilizza il metodo Tiffany (rame e stagno) e il piombo. Il suo lavoro si basa su vari temi: uccelli, geometria, personaggi... Possibilità di corsi di formazione."
    ],
    "fr": [
      "Visite sur rendez-vous. L'artiste, Daniel Lanne, se consacre à sa passion : le vitrail. Il utilise la méthode Tiffany (cuivre et étain) et plomb. Les réalisations portent sur des thèmes variés : oiseaux, géométrie, personnages... Possibilité de stages."
    ],
    "es": [
      "Visita con cita previa. El artista, Daniel Lanne, se dedica a su pasión: las vidrieras. Utiliza el método Tiffany (cobre y estaño) y el plomo. Su obra se basa en varios temas: pájaros, geometría, personajes... Posibilidad de cursos de formación."
    ],
    "nl": [
      "Bezoek op afspraak. De kunstenaar, Daniel Lanne, wijdt zich aan zijn passie: glas in lood. Hij gebruikt de Tiffany methode (koper en tin) en lood. Zijn werk is gebaseerd op verschillende thema's: vogels, geometrie, personages... Mogelijkheid van opleidingen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Stained-glass art"
    ],
    "fr": [
      "L'art du vitrail"
    ]
  },
