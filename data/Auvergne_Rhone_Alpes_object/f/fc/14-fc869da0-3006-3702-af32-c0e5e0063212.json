  "rdfs:comment": {
    "de": [
      "Antike Texte, Ikonografie und zahlreiche archäologische Funde haben es ermöglicht, die neuen Essgewohnheiten nach der Eroberung besser zu charakterisieren."
    ],
    "en": [
      "Ancient texts, iconography and numerous archaeological discoveries have enabled us to better characterize the new eating habits following the conquest."
    ],
    "it": [
      "I testi antichi, l'iconografia e le numerose scoperte archeologiche ci hanno permesso di caratterizzare meglio le nuove abitudini alimentari dopo la conquista."
    ],
    "fr": [
      "Les textes antiques, l’iconographie et les nombreuses découvertes archéologiques ont permis de mieux caractériser les nouvelles habitudes alimentaires postérieures à la conquête."
    ],
    "es": [
      "Textos antiguos, iconografía y numerosos descubrimientos arqueológicos han permitido caracterizar mejor los nuevos hábitos alimentarios tras la conquista."
    ],
    "nl": [
      "Oude teksten, iconografie en talrijke archeologische vondsten hebben ons in staat gesteld om de nieuwe eetgewoonten na de verovering beter te karakteriseren."
    ]
  },
