  "rdfs:comment": {
    "de": [
      "Das MuPop in Montluçon ist das erste Museum in Frankreich, das sich der Geschichte und den Objekten der Musik widmet."
    ],
    "en": [
      "Exceptional collection of musical instruments considered as the reference collection in France, the MuPop of Montluçon is the first museum in France dedicated to the history and the musical objects."
    ],
    "it": [
      "Il MuPop di Montluçon è il primo museo in Francia dedicato alla storia della musica e degli oggetti musicali."
    ],
    "fr": [
      "Collection exceptionnelle d'instruments de musiques considérée comme le fonds de référence en France, le MuPop de Montluçon est le premier musée en France consacré à l'histoire et aux objets musicaux ."
    ],
    "nl": [
      "Het MuPop in Montluçon is het eerste museum in Frankrijk dat gewijd is aan de geschiedenis van muziek en muzikale voorwerpen."
    ],
    "es": [
      "El MuPop de Montluçon es el primer museo de Francia dedicado a la historia de la música y los objetos musicales."
    ]
  },
