  "rdfs:comment": {
    "de": [
      "Entdecken, füttern und berühren Sie einige unserer Tiere. Erleben Sie außerdem zwei Tauchanimationen mit Myocastoren und Wallabys."
    ],
    "en": [
      "Come discover, feed, cuddle animals. Myocastors, marmots, kangaroos, prairie dogs, .... More than 10 animal species."
    ],
    "it": [
      "Venite a scoprire, nutrire e toccare alcuni dei nostri animali. Potrete anche partecipare a due attività immersive con i miocastori e i wallaby."
    ],
    "fr": [
      "Venez découvrir, nourrir et toucher certains de nos animaux. Assistez également à deux animations en immersion avec les myocastors et les wallabies."
    ],
    "es": [
      "Venga a descubrir, alimentar y tocar a algunos de nuestros animales. También podrá participar en dos actividades inmersivas con miocastores y ualabíes."
    ],
    "nl": [
      "Kom een aantal van onze dieren ontdekken, voeren en aanraken. Je kunt ook deelnemen aan twee meeslepende activiteiten met myocastors en wallaby's."
    ]
  },
