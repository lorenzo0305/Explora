      "@id": "https://data.datatourisme.fr/ff841c9a-1a7a-396c-9df3-a21cb4dfee3e",
      "dc:description": {
        "de": [
          "16 KM LANGER FUSS- UND MOUNTAINBIKEWEG - 4 STUNDEN\nSTART AUF DEM PLACE FOCH IN SAMER\nGELBE MARKIERUNG\n\nFinden Sie den Verlauf der Strecke in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "16 KM PEDESTRIAN AND MOUNTAIN BIKE TRAIL - 4H\nDEPARTURE FROM SAMER'S PLACE FOCH\nYELLOW MARKINGS\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO PEDONALE E PER MOUNTAIN BIKE DI 16 KM - 4 ORE\nPARTE DA PLACE FOCH A SAMER\nSEGNALETICA GIALLA\n\nIl percorso è disponibile sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE ET VTT DE 16 KM - 4H\nDEPART DE LA PLACE FOCH DE SAMER\nBALISAGE EN JAUNE\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA PEATONAL Y EN BICICLETA DE MONTAÑA DE 16 KM - 4 HORAS\nSALE DE PLACE FOCH EN SAMER\nSEÑALIZACIÓN AMARILLA\n\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "16 KM WANDEL- EN MOUNTAINBIKEROUTE - 4 UUR\nSTART VANAF PLAATS FOCH IN SAMER\nGELE MARKERINGEN\n\nJe kunt de route vinden op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
