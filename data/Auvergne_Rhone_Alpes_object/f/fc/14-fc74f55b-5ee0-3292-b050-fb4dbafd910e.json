      "dc:description": {
        "de": [
          "Das 20. Festival vom 15. Mai bis 8. Juni 2025 :\n- samstag, den 17. Mai: \"Rameau génie énigmatique\" Chapelle Calot 20.30 Uhr Barockkonzert\n- mittwoch, den 27. Mai: \"Imaginarium\" Musée Opale Sud 19.30 Uhr Lyrikkonzert\n\nOrganisiert von Musica Nigella"
        ],
        "en": [
          "The 20th festival from May 15 to June 8, 2025 :\n- saturday, May 17: \"Rameau génie énigmatique\" Chapelle Calot 8:30 pm baroque concert\n- wednesday May 27: \"Imaginarium\" Musée Opale Sud 7:30 pm lyric concert\n\nOrganized by Musica Nigella"
        ],
        "it": [
          "Il 20° festival dal 15 maggio all'8 giugno 2025:\n- sabato 17 maggio: \"Rameau génie énigmatique\" Chapelle Calot ore 20.30 concerto barocco\n- mercoledì 27 maggio: \"Imaginarium\" Musée Opale Sud ore 19.30 concerto lirico\n\nOrganizzato da Musica Nigella"
        ],
        "fr": [
          "Le 20 ème festival du 15 mai au 8 juin 2025 :\n- le samedi 17 mai : \"Rameau génie énigmatique\" Chapelle Calot 20h30 concert baroque\n- le mercredi 27 mai : \"Imaginarium\" Musée Opale Sud 19h30 concert lyrique \n\nOrganisé par Musica Nigella"
        ],
        "nl": [
          "Het 20e festival van 15 mei tot 8 juni 2025 :\n- zaterdag 17 mei: \"Rameau génie énigmatique\" Chapelle Calot 20u30 barokconcert\n- woensdag 27 mei: \"Imaginarium\" Musée Opale Sud 19.30 uur lyrisch concert\n\nGeorganiseerd door Musica Nigella"
        ],
        "es": [
          "20º festival del 15 de mayo al 8 de junio de 2025 :\n- sábado 17 de mayo: \"Rameau génie énigmatique\" Chapelle Calot 20:30 h concierto barroco\n- miércoles 27 de mayo: \"Imaginarium\" Musée Opale Sud 19:30 h Concierto lírico\n\nOrganización Música Nigella"
        ]
      },
