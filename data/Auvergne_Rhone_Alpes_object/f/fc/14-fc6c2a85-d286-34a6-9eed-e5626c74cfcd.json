      "dc:description": {
        "de": [
          "Wir treffen uns am 3. Juli ab 18.30 Uhr in Le Repère in Torcy für ein Konzert mit 10 Streichern\nUnter Mitwirkung des Ensemble Musical POP"
        ],
        "en": [
          "Join us on July 3 from 6:30 pm at Le Repère de Torcy for a 10-string concert\nWith the participation of Ensemble Musical POP"
        ],
        "it": [
          "Unitevi a noi il 3 luglio dalle 18.30 presso Le Repère a Torcy per un concerto a 10 corde\nCon la partecipazione dell'Ensemble Musical POP"
        ],
        "fr": [
          "Rendez-vous le 3 juillet à partir de 18 h30 Au Repère de Torcy pour un concert 10 cordes\nAvec la participation de l'Ensemble Musical POP"
        ],
        "es": [
          "Únase a nosotros el 3 de julio a partir de las 18.30 h en Le Repère de Torcy para un concierto a 10 cuerdas\nCon la participación del Ensemble Musical POP"
        ],
        "nl": [
          "Kom op 3 juli vanaf 18.30 uur naar Le Repère in Torcy voor een concert met 10 snaren\nMet de deelname van het Ensemble Musical POP"
        ]
