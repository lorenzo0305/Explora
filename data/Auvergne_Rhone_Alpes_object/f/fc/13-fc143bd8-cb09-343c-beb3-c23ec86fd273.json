  "rdfs:comment": {
    "de": [
      "Konzert für junge Talente in Zusammenarbeit mit dem Centre culturel de rencontre d'Ambronay\r\nSulla Piazza lässt einen Abend lang das musikalische Leben im Venedig des 16. Jahrhunderts rund um die Piazza San Marco wieder aufleben."
    ],
    "en": [
      "Concert Jeunes talents in partnership with the Centre culturel de rencontre d'Ambronay\r\nFor one evening, Sulla Piazza brings to life the musical life of 16th-century Venice around Piazza San Marco."
    ],
    "it": [
      "Concerto di giovani talenti in collaborazione con il Centre culturel de rencontre d'Ambronay\r\nPer una sera, Sulla Piazza fa rivivere la vita musicale della Venezia del XVI secolo intorno a Piazza San Marco."
    ],
    "fr": [
      "Concert Jeunes talents en partenariat avec le Centre culturel de rencontre d'Ambronay\r\nSulla Piazza fait revivre, le temps d’une soirée, la vie musicale de la Venise du XVIᵉ siècle autour de la Piazza San Marco."
    ],
    "es": [
      "Concierto de Jóvenes Talentos en colaboración con el Centre culturel de rencontre d'Ambronay\r\nDurante una noche, Sulla Piazza revive la vida musical de la Venecia del siglo XVI en torno a la plaza de San Marcos."
    ],
    "nl": [
      "Concert voor jong talent in samenwerking met het Centre culturel de rencontre d'Ambronay\r\nSulla Piazza brengt voor één avond het muzikale leven van het 16e-eeuwse Venetië rond het San Marcoplein tot leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert - Sulla Piazza, les violons de San Marco"
    ]
  },
