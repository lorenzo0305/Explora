          "additionalInformation": {
            "de": [
              "Europäische Tage des Kulturerbes\r\nNur geführte Besichtigung der Außenanlagen (keine freie Besichtigung) ? Dauer 1 Stunde\r\nDie Führungen beginnen am Samstag und Sonntag pünktlich um 11 Uhr, 15 Uhr und 17 Uhr.\r\nEintrittskarten am großen Eingangstor: 5 ? pro Erwachsener ? Kostenlos ? ab 18 Jahren"
            ],
            "en": [
              "European Heritage Days\r\nGuided tour of exteriors only (no self-guided tours) ? duration 1 hour\r\nTours depart Saturday and Sunday at 11 a.m., 3 p.m. and 5 p.m. sharp.\r\nTickets at the main entrance gate: 5? per adult ? Free ? under 18"
            ],
            "it": [
              "Giornate europee del patrimonio\r\nVisita guidata solo dell'esterno (no visite autoguidate) ? durata 1 ora\r\nLe visite partono il sabato e la domenica alle 11.00, alle 15.00 e alle 17.00 in punto.\r\nBiglietti all'ingresso principale: 5? per adulto? Gratuito per i minori di 18 anni"
            ],
            "fr": [
              "Journées Européennes du Patrimoine\r\nVisite guidée des extérieurs uniquement  (pas de visite libre) – durée 1 heure\r\nDépart des visites le Samedi et Dimanche à 11h, 15h et 17h précises.\r\nBilletterie à la grande grille d'entrée : 5€ par adulte  – Gratuit – de 18 ans"
            ],
            "es": [
              "Jornadas Europeas del Patrimonio\r\nVisita guiada sólo del exterior (no hay visitas autoguiadas) ? duración 1 hora\r\nLas visitas salen los sábados y domingos a las 11:00, 15:00 y 17:00 en punto.\r\nEntradas en la entrada principal: 5? por adulto ? Gratis para menores de 18 años"
            ],
            "nl": [
              "Europese Erfgoeddagen\r\nAlleen rondleiding van buiten (geen rondleidingen op eigen gelegenheid) ? duur 1 uur\r\nRondleidingen vertrekken op zaterdag en zondag om 11 uur, 15 uur en 17 uur precies.\r\nTickets aan de hoofdingang: 5 € per volwassene Gratis voor kinderen onder de 18 jaar"
            ]
          },
