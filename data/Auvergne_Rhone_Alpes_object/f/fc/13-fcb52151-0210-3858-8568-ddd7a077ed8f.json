  "rdfs:comment": {
    "de": [
      "Schloss in der Sologne Bourbonnaise (17. Jh.), in dem Madeleine de Castille, die Ehefrau von Nicolas Fouquet, die Marquise de Sévigné empfing. Die Harmonie seiner Einrichtung und das Rot seiner Backsteine und Dachziegel machen es zu einem Ort der Entspannung und der Flucht."
    ],
    "en": [
      "Castle in Sologne bourbonnaise (XVIIth) where Madeleine de Castille wife of Nicolas Fouquet welcomes the Marquise de Sévigné. The harmony of its layout and the red of its bricks and tiles make it a colourful site of relaxation and escape."
    ],
    "it": [
      "Un castello nella Sologne bourbonnaise (XVII secolo) dove Madeleine de Castille, moglie di Nicolas Fouquet, accolse la marchesa di Sévigné. L'armonia della sua disposizione e il rosso dei mattoni e delle piastrelle ne fanno un luogo colorato di relax e di evasione."
    ],
    "fr": [
      "Château en Sologne bourbonnaise (XVIIème) où Madeleine de Castille épouse de Nicolas Fouquet accueille la Marquise de Sévigné. L’harmonie de ses agencements et du rouge de ses briques et tuiles en font un site chamarré, de détente et d’évasion."
    ],
    "nl": [
      "Een kasteel in de Sologne bourbonnaise (17e eeuw) waar Madeleine de Castille, echtgenote van Nicolas Fouquet, de markiezin van Sévigné ontving. De harmonie van de indeling en het rood van de bakstenen en tegels maken het een kleurrijke, ontspannende en escapistische plek."
    ],
    "es": [
      "Castillo de la Sologne bourbonnaise (siglo XVII) donde Madeleine de Castille, esposa de Nicolas Fouquet, acogió a la marquesa de Sévigné. La armonía de su trazado y el rojo de sus ladrillos y tejas lo convierten en un lugar colorido, relajante y evasivo."
    ]
  },
