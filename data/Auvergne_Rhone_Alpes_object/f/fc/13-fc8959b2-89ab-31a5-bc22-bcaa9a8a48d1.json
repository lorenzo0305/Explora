  "rdfs:comment": {
    "de": [
      "Die Büros der Nordic-Skischule von Villard-de-Lans/Corrençon sind während der Wintersaison täglich geöffnet."
    ],
    "en": [
      "The offices of the Nordic Ski School in Villard de Lans/Corrençon are open every day during the winter season."
    ],
    "it": [
      "Gli uffici della scuola di sci Villard/Corrençon Nordic sono aperti tutti i giorni durante la stagione invernale. Il sito nordico dell'Haut-Vercors è un ottimo terreno di gioco per scoprire i piaceri dello sci e della natura."
    ],
    "fr": [
      "Les bureaux de l’école de ski nordique Villard /Corrençon sont ouverts tous les jours pendant la saison hivernale  . Le site nordique du Haut-Vercors est un excellent terrain de jeu pour découvrir les plaisirs de la glisse et faire le plein de nature."
    ],
    "es": [
      "Las oficinas de la escuela de esquí nórdico de Villard/Corrençon están abiertas todos los días durante la temporada de invierno. El sitio nórdico de Haut-Vercors es un excelente terreno de juego para descubrir los placeres del esquí y adentrarse en la naturaleza."
    ],
    "nl": [
      "De kantoren van de Noordse skischool Villard/Corrençon zijn tijdens het winterseizoen elke dag geopend. De Nordic site van de Haut-Vercors is een uitstekend speelterrein om de geneugten van het skiën te ontdekken en de natuur in te trekken."
    ]
  },
  "rdfs:label": {
    "de": [
      "Nordische Skischule Villard/"
    ],
    "en": [
      "Nordic ski school Villard/Corrençon Bois Barbu"
    ],
    "fr": [
      "Ecole de ski nordique Villard Corrençon / Accueil Villard Bois Barbu"
    ]
  },
