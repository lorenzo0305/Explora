  "rdfs:comment": {
    "de": [
      "Ein 14 Hektar großer Bauernhof mit Kastanienwald, Freilandhaltung von Legehennen und biologischem Gemüseanbau. Boutique mit Verkauf von Produkten des Bauernhofs und anderen regionalen Produkten, die Feinschmecker begeistern werden."
    ],
    "en": [
      "Agricultural smallholding set in 14 hectares producing chestnuts, free range eggs and organic vegetables. Food-lovers will enjoy visiting our shop stocked with products from our own farm as well as from other local producers."
    ],
    "it": [
      "Fattoria alimentare di 14 ettari, che comprende un castagneto, galline ovaiole all'aperto e orticoltura biologica. Un negozio di prodotti agricoli e altri prodotti regionali delizierà i buongustai."
    ],
    "fr": [
      "Ferme vivrière de 14 hectares dont une châtaigneraie, élevage en plein air de poules pondeuses, maraîchage biologique. Boutique avec vente de produits de la ferme et d’autres produits régionaux pourra ravir les gourmands."
    ],
    "nl": [
      "Voedselboerderij van 14 hectare met kastanjebos, scharrelkippen en biologische tuinbouw. Een winkel met boerderijproducten en andere regionale producten zal fijnproevers zeker bevallen."
    ],
    "es": [
      "Granja agroalimentaria de 14 hectáreas que incluye un castañar, gallinas ponedoras camperas y horticultura ecológica. Una tienda de productos agrícolas y otros productos regionales hará las delicias de los gourmets."
    ]
  },
