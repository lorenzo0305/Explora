  "rdfs:comment": {
    "de": [
      "Dieser schattige Park mit hügeligen Rasenflächen bietet seinen Besuchern einen großen Biotopteich, barrierefreie Wege sowie zwei Kinderspielplätze."
    ],
    "en": [
      "This shaded park with rolling lawns offers its visitors a large biotope pond, pathways accessible to all and two play areas for children."
    ],
    "it": [
      "Questo parco ombreggiato con prati ondulati offre ai visitatori un grande stagno biotopo, sentieri accessibili a tutti e due aree gioco per bambini."
    ],
    "fr": [
      "Ce parc ombragé aux pelouses vallonnées offre à ses visiteurs un grand bassin biotope, des cheminements accessibles à tous ainsi que deux aires de jeux pour enfants."
    ],
    "es": [
      "Este parque, sombreado y de césped irregular, ofrece a sus visitantes un gran estanque biotopo, caminos adaptados para todos y zonas de juego infantil."
    ],
    "nl": [
      "Dit schaduwrijke park met golvende grasvelden biedt zijn bezoekers een groot biotoopzwembad, voor iedereen toegankelijke paden en twee kinderspeelplaatsen."
    ]
  },
