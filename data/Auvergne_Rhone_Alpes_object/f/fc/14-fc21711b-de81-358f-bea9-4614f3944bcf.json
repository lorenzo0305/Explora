  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/296224c6-6dd0-3ac5-ae10-b060354b69f6",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Fächern werden Ihnen verschiedene Brotsorten angeboten, die aus der Bäckerei La Grange O pains in Agnez-lès-Duisans stammen.\n\nÖffnungszeiten:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nSeveral types of bread from the La Grange O pains bakery in Agnez-lès-Duisans are available in racks.\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nDiversi tipi di pane del panificio La Grange O pains di Agnez-lès-Duisans sono disponibili in scaffalature.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposés plusieurs types de pains provenants de la boulangerie La Grange O pains située à Agnez-lès-Duisans.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nVerschillende broodsoorten van de bakkerij La Grange O pains in Agnez-lès-Duisans zijn verkrijgbaar in rekken.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nVarios tipos de pan de la panadería La Grange O pains de Agnez-lès-Duisans están disponibles en rejillas.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
