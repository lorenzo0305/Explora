  "rdfs:comment": {
    "de": [
      "Khadidja und Pierre freuen sich, Sie in einem freundlichen und herzlichen Geist zu empfangen. Teilen Sie mit uns die familiäre Küche, traditionelle Gerichte von zu Hause und von anderswo!"
    ],
    "en": [
      "Khadidja and Pierre are delighted to welcome you into a warm and friendly atmosphere. Come and share their family-style cuisine and traditional dishes from home and abroad!"
    ],
    "it": [
      "Khadidja e Pierre sono lieti di accogliervi in un'atmosfera calorosa e amichevole. Venite a condividere la loro cucina familiare e i piatti tradizionali del paese e dell'estero!"
    ],
    "fr": [
      "Khadidja et Pierre ont le plaisir de vous accueillir dans un esprit convivial et chaleureux, venez partager une cuisine familiale, des plats traditionnels de chez nous et d'ailleurs !"
    ],
    "es": [
      "Khadidja y Pierre están encantados de recibirle en un ambiente cálido y acogedor. Venga a compartir su cocina familiar y platos tradicionales de su país y del extranjero"
    ],
    "nl": [
      "Khadidja en Pierre heten je van harte welkom in een warme en vriendelijke sfeer. Kom en deel hun familiekeuken en traditionele gerechten uit binnen- en buitenland!"
    ]
  },
