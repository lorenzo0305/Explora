  "rdfs:comment": {
    "de": [
      "L'Olympide, das Wassersportzentrum für Fitness und Wohlbefinden, empfängt Sie ganz nach Ihren Wünschen. In Form bleiben, sich entspannen, Spaß haben... Mit seinen drei Bereichen: Schwimmbad, Spa & Cardio-Fitness, bietet L'Olympide alles, was das Herz begehrt."
    ],
    "en": [
      "L'Olympide, aquatic fitness and wellness center welcomes you at the rhythm of your desires. To keep in shape, to relax, to have fun... with its 3 areas: swimming pool, Spa & cardio fitness, l'Olympide allows all practices."
    ],
    "it": [
      "L'Olympide, centro fitness e benessere acquatico, vi accoglie al ritmo dei vostri desideri. Mantenersi in forma, rilassarsi, divertirsi... con le sue 3 aree: piscina, Spa e cardio fitness, l'Olympide permette tutte le pratiche."
    ],
    "fr": [
      "L'Olympide, centre aquatique forme & bien être vous accueille au rythme de vos envies. Garder la forme, se relaxer, s'amuser... avec ses 3 espaces : piscine, Spa & cardio fitness, l'Olympide permet toutes les pratiques."
    ],
    "es": [
      "L'Olympide, centro acuático de fitness y bienestar, le acoge al ritmo de sus deseos. Mantenerse en forma, relajarse, divertirse... con sus 3 zonas: piscina, Spa & cardio fitness, l'Olympide permite todas las prácticas."
    ],
    "nl": [
      "L'Olympide, aquatisch fitness- en wellnesscentrum, ontvangt u in het tempo van uw wensen. In vorm blijven, ontspannen, plezier maken... met zijn 3 zones: zwembad, Spa & cardio fitness, laat l'Olympide alle praktijken toe."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Olympide | Espace cardio"
    ]
  },
