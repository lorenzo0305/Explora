  "rdfs:comment": {
    "de": [
      "Marokkanische Küche. Im Shems resto sind die Produkte frisch und stammen aus dem Anbau der lokalen Produzenten. Frische, nichts als frische Ware, um Ihnen die Qualität und Authentizität der Gerichte zu garantieren."
    ],
    "en": [
      "Moroccan cuisine. At Shems resto, all products are fresh and grown by local producers. Nothing but the freshest to guarantee the quality and authenticity of our dishes."
    ],
    "it": [
      "Cucina marocchina. Al ristorante Shems i prodotti sono freschi e provengono da produttori locali. Fresco, nient'altro che fresco per garantire la qualità e la genuinità dei piatti.\r\n\r\n?"
    ],
    "fr": [
      "Cuisine Marocaine. Au Shems resto, les produits sont frais et issus de la culture des producteurs locaux. Du frais, rien que du frais pour vous garantir de la qualité et l'authenticité des plats.\r\n\r\n​"
    ],
    "nl": [
      "Marokkaanse keuken. Bij Shems resto zijn de producten vers en afkomstig van lokale producenten. Niets dan verse producten om de kwaliteit en authenticiteit van onze gerechten te garanderen."
    ],
    "es": [
      "Cocina marroquí. En Shems resto, los productos son frescos y provienen de productores locales. Fresco, nada más que fresco para garantizar la calidad y la autenticidad de los platos.\r\n\r\n?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Shem's Resto"
    ]
  },
