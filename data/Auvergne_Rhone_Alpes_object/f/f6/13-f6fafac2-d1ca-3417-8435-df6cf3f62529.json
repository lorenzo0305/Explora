  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Oper im Kino bietet das Ciné Planète in Romans die HD-Live-Übertragung des letzten Traums von Frida und Diego durch die Metropolitan Opera an. Diese Oper in zwei Akten wird in spanischer Sprache mit französischen Untertiteln aufgeführt (1 Pause)."
    ],
    "en": [
      "As part of its Opera au Cinéma program, Ciné Planète de Romans is offering an HD Live broadcast of Frida and Diego's Last Dream by the Metropolitan Opera. This two-act opera is presented in Spanish with French subtitles (1 intermission)."
    ],
    "it": [
      "Nell'ambito del programma Opera au Cinéma, il Ciné Planète di Roma propone la trasmissione in diretta in HD di Frida e L'ultimo sogno di Diego del Metropolitan Opera. Quest'opera in due atti è presentata in spagnolo con sottotitoli in francese (1 intervallo)."
    ],
    "fr": [
      "Dans le cadre de la programmation Opéra au Cinéma, le Ciné Planète de Romans propose la diffusion en HD Live du Dernier rêve de Frida et Diego par le Metropolitan Opera. Cet Opéra en deux actes est présenté en espagnol sous-titré en français (1 entracte)."
    ],
    "es": [
      "En el marco de su programa Opera au Cinéma, el Ciné Planète de Roma ofrece la retransmisión en directo en alta definición de Frida y el último sueño de Diego, de la Metropolitan Opera. Esta ópera en dos actos se presenta en español con subtítulos en francés (1 intervalo)."
    ],
    "nl": [
      "Als onderdeel van het programma Opera au Cinéma biedt de Ciné Planète in Rome een HD Live-uitzending van Frida en Diego's Last Dream van de Metropolitan Opera. Deze opera in twee bedrijven wordt gepresenteerd in het Spaans met Franse ondertiteling (1 pauze)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Opéra au Cinéma - Le dernier rêve de Frida et Diego"
    ]
  },
