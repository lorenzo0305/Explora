  "rdfs:comment": {
    "de": [
      "An der Flussanlegestelle können kleine Sportboote bis zu 12 m Länge anlegen.\r\nDer Tiefgang an der tiefsten Stelle beträgt 1,60 m und der Tiefgang (= die Höhe unter der Brücke) 3 m.\r\nKapazität für 2 Boote."
    ],
    "en": [
      "The River stop allows the docking of small pleasure boats up to 12m.\r\nThe draught at the lowest is 1.60m and the draught (= the height under the deck) is 3m.\r\nCapacity of 2 boats."
    ],
    "it": [
      "L'Halte fluviale può ospitare piccole imbarcazioni da diporto fino a 12 metri.\r\nIl pescaggio minimo è di 1,60 m e il pescaggio dell'aria (= l'altezza sotto il ponte) è di 3 m.\r\nCapacità per 2 barche."
    ],
    "fr": [
      "La Halte fluviale permet l'accostage des petits bateaux de plaisance jusqu'à 12m.\r\nLe tirant d'eau au plus bas est de 1.60m et le tirant d'air (= la hauteur sous le pont) est de 3m.\r\nCapacité de 2 bateaux."
    ],
    "es": [
      "El Halte fluviale puede acoger pequeñas embarcaciones de recreo de hasta 12 m.\r\nEl calado más bajo es de 1,60 m y el calado aéreo (= la altura bajo el puente) es de 3 m.\r\nCapacidad para 2 embarcaciones."
    ],
    "nl": [
      "De Halte fluviale is geschikt voor kleine plezierboten tot 12m.\r\nDe laagste diepgang is 1,60 m en de doorvaarthoogte (= de hoogte onder de brug) is 3 m.\r\nCapaciteit voor 2 boten."
    ]
  },
