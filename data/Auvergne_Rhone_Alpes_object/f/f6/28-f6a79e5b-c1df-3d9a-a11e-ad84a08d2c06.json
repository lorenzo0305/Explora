  "rdfs:comment": {
    "de": [
      "Im Herzen des Vexin und eines kleinen, geschützten Dorfes befinden sich zwei Orte mit außergewöhnlicher Natur. Durchqueren Sie den Wald, um sie für eine Naturpause zwischen Larris und Teichen zu erreichen."
    ],
    "en": [
      "In the heart of the Vexin and a small, unspoilt village, two sites of exceptional natural beauty. Cross the woods to reach them for a nature break between larris and ponds."
    ],
    "it": [
      "Nel cuore del Vexin e in un piccolo villaggio incontaminato, due siti di eccezionale bellezza naturale. Attraversate il bosco per raggiungerli, per una pausa nella natura tra brughiere e stagni."
    ],
    "fr": [
      "Au cœur du Vexin et d'un petit village préservé, deux sites à la nature exceptionnelle. Traversez le bois pour les rejoindre pour une pause nature entre larris et étangs."
    ],
    "nl": [
      "In het hart van de Vexin en een klein ongerept dorp, twee sites van uitzonderlijke natuurlijke schoonheid. Doorkruis het bos om ze te bereiken voor een natuurvakantie te midden van heide en vijvers."
    ],
    "es": [
      "En el corazón del Vexin y de un pequeño pueblo virgen, dos parajes de excepcional belleza natural. Atraviese el bosque para llegar a ellos y disfrutar de un descanso en plena naturaleza entre páramos y estanques."
    ]
  },
  "rdfs:label": {
    "fr": [
