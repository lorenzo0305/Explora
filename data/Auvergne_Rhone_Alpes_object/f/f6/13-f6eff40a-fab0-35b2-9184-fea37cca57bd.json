  "rdfs:comment": {
    "de": [
      "Ein Schmuckstück der romanischen Kunst, erbaut aus Vulkangestein und Arkose, bildet die Kirche ein ungewöhnliches Ganzes. Sie können hier die besonderen Züge der romanischen Architektur in der Auvergne bewundern."
    ],
    "en": [
      "Pearl of Romanesque art, built from volcanic stone and arkose and forming a highly unusual whole. You’ll have the opportunity to admire the specific features of the Auvergne Romanesque architecture."
    ],
    "it": [
      "Costruita nel XII secolo tra il 1150 e il 1157, questa chiesa è la più piccola delle cinque principali chiese romaniche dell'Alvernia, un edificio cluniacense di ispirazione monastica."
    ],
    "fr": [
      "Construite au XIIe siècle entre 1150 et 1157, cette église est la plus petite des cinq église romanes majeures d'Auvergne, édifice clunisien d'inspiration monastique."
    ],
    "nl": [
      "Parel van de romaanse kunst, gebouwd van vulkaansteen en arkose. Vormt een bijzonder ongebruikelijk geheel. Bewonder de bijzondere kenmerken van de romaanse architectuur in de Auvergne."
    ],
    "es": [
      "Construida en el siglo XII, entre 1150 y 1157, esta iglesia es la más pequeña de las cinco grandes iglesias románicas de Auvernia, un edificio cluniacense de inspiración monástica."
    ]
  },
  "rdfs:label": {
