  "rdfs:comment": {
    "de": [
      "Dorf Grèzes, Kirche aus dem 12. Jahrhundert mit geschnitzten Kapitellen.\r\nKalvarienberg von Roche Montru.\r\nHameau de La Clauze, Stadtmauer mit Rundtürmen und polygonalem Turm aus dem 13. Jahrhundert, die auf einem Granittorus errichtet wurde.\r\nMaison de la Béate"
    ],
    "en": [
      "Village of Grèzes, 12th-century church with carved capitals.\r\nCalvary of Roche Montru.\r\nHamlet of La Clauze, enclosure with round towers and 13th-century polygonal tower built on a granite torus.\r\nMaison de la Béate"
    ],
    "it": [
      "Villaggio di Grèzes, chiesa del XII secolo con capitelli scolpiti.\r\nCalvario di Roche Montru.\r\nFrazione di La Clauze, recinto con torri rotonde e torre poligonale del XIII secolo costruita su un toro di granito.\r\nMaison de la Béate"
    ],
    "fr": [
      "Village de Grèzes, Église du XIIe siècle avec chapiteaux sculptés.\r\nCalvaire de Roche Montru. \r\nHameau de La Clauze, enceinte avec tours rondes et tour polygonale du XIIIe siècle édifiée sur un tore granitique. \r\nMaison de la Béate"
    ],
    "es": [
      "Pueblo de Grèzes, iglesia del siglo XII con capiteles esculpidos.\r\nCalvario de Roche Montru.\r\nAldea de La Clauze, recinto con torres redondas y torre poligonal del siglo XIII construida sobre un toro de granito.\r\nCasa de la Béate"
    ],
    "nl": [
      "Dorp Grèzes, kerk uit de 12e eeuw met gebeeldhouwde kapitelen.\r\nCalvarieberg van Roche Montru.\r\nHet gehucht La Clauze, ommuring met ronde torens en 13de-eeuwse veelhoekige toren gebouwd op een granieten torus.\r\nMaison de la Béate"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Grèzes"
    ]
  },
