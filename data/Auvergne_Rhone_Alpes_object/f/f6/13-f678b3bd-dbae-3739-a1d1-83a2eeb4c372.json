  "rdfs:comment": {
    "de": [
      "Eine uralte Kunst, die Kraft und Zartheit vereint, Schöpfer unter den Schlägen der Hämmer...\r\nHandwerkliche Schmiedekunst nach alter Tradition. Herstellung von mittelalterlichen und esoterischen Objekten.\r\nPraktika möglich, bitte kontaktieren Sie mich."
    ],
    "en": [
      "Ancestral art, combining strength and delicacy, creative under the blows of hammers...\r\nOld-fashioned artisan forge. Creation of medieval and esoteric objects.\r\nCourses available, please contact me."
    ],
    "it": [
      "Un'arte ancestrale, che unisce forza e delicatezza, creativa sotto i colpi dei martelli...\r\nFucina artigianale d'altri tempi. Creazione di oggetti medievali ed esoterici.\r\nCorsi disponibili, contattatemi."
    ],
    "fr": [
      "Art ancestral, alliant force et délicatesse, créateur sous les coups des marteaux...\r\nForge artisanale à l'ancienne. Réalisation d'objets médiévaux et ésotériques.\r\nStages possibles, me contacter."
    ],
    "es": [
      "Un arte ancestral, que combina fuerza y delicadeza, creativo bajo los golpes de los martillos...\r\nForja artesanal a la antigua usanza. Creación de objetos medievales y esotéricos.\r\nCursos disponibles, póngase en contacto conmigo."
    ],
    "nl": [
      "Een voorouderlijke kunst, die kracht en delicatesse combineert, creatief onder de slagen van hamers...\r\nOuderwetse ambachtelijke smederij. Creatie van middeleeuwse en esoterische voorwerpen.\r\nCursussen beschikbaar, neem contact met me op."
    ]
  },
  "rdfs:label": {
