  "rdfs:comment": {
    "de": [
      "La Fora ist ein Café-Restaurant! Wir empfangen Sie mit hausgemachten Gerichten, Bier und Wein, die die unglaublichen Produzenten rund um unsere schöne Hochebene ehren."
    ],
    "en": [
      "La Fora is a café-restaurant! We welcome you with simplicity to our home-cooked meals, beers and wines featuring the incredible producers who work all around our beautiful plateau."
    ],
    "it": [
      "La Fora è un caffè-ristorante! Vi accogliamo con semplicità nella nostra cucina tradizionale, nelle nostre birre, nei nostri 18 gusti di gelato e nei nostri vini che celebrano gli incredibili produttori che lavorano intorno al nostro bellissimo altopiano..."
    ],
    "fr": [
      "La Fora c'est un café-restaurant! On vous accueille en toute simplicité avec une cuisine traditionnelle, des bières ,nos 18 parfums de glaces, des vins qui mettent à l'honneur les incroyables producteurs qui œuvrent tout autour de notre beau plateau..."
    ],
    "es": [
      "¡La Fora es un café-restaurante! Le damos la bienvenida con sencillez a nuestra cocina tradicional, nuestras cervezas, nuestros 18 sabores de helado, y nuestros vinos que celebran los increíbles productores que trabajan alrededor de nuestra hermosa meseta ..."
    ],
    "nl": [
      "La Fora is een café-restaurant! We verwelkomen je met eenvoud in onze traditionele keuken, onze bieren, onze 18 smaken ijs en onze wijnen die de ongelooflijke producenten vieren die op ons prachtige plateau werken..."
    ]
  },
  "rdfs:label": {
    "de": [
      "Café - Restaurant La Fora"
    ],
    "fr": [
      "Café - Restaurant La Fora"
    ]
  },
