  "rdfs:comment": {
    "de": [
      "Das Café de la Place wird von einem Dutzend Freunden aus Viriolans und Umgebung betrieben, die einen Verein gegründet haben, um das Café zu betreiben."
    ],
    "en": [
      "The Café de la Place is run by a dozen friends from Viriol and the surrounding area, who have set up an association."
    ],
    "it": [
      "Il Café de la Place è gestito da una dozzina di amici di Viriol e dintorni, che hanno costituito un'associazione per gestire il locale."
    ],
    "fr": [
      "Le Café de la Place est tenu par une dizaine d’amis viriolans et des environs, qui ont monté une association pour tenir ce café."
    ],
    "nl": [
      "Het Café de la Place wordt gerund door een tiental vrienden uit Viriol en omgeving, die een vereniging hebben opgericht om het café te beheren."
    ],
    "es": [
      "El Café de la Place está dirigido por una docena de amigos de Viriol y alrededores, que han creado una asociación para gestionar el café."
    ]
  },
