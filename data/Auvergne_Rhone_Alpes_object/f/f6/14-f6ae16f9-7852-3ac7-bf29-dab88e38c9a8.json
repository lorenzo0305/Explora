  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/052d7b50-aa9e-3a11-8757-28ed082df421",
      "dc:description": {
        "de": [
          "Christi-Ligne ist ein Nähatelier: Änderungen (Saum, Verschlüsse, Größe, Schrumpfen...) Umgestaltung, Dekoration (Vorhang, Gardine, Kissen, Sesselbezug...)."
        ],
        "en": [
          "Christi-Ligne is a sewing workshop: alterations (hems, fastenings, trimming, shrinkage...) Transformation, Decoration (curtains, sheers, cushions, armchair covers...)."
        ],
        "it": [
          "Christi-Ligne è un laboratorio di cucito: modifiche (orli, chiusure, rifiniture, restringimenti, ecc.), trasformazioni, decorazioni (tende, velette, cuscini, copripoltrona, ecc.)."
        ],
        "fr": [
          "Christi-Ligne est un atelier de couture : retouches (ourlet, fermetures, taille, rétrécissements...) Transformation, Décoration (rideau, voilage, coussin, housse fauteuil...)."
        ],
        "nl": [
          "Christi-Ligne is een naaiatelier: aanpassingen (zomen, sluitingen, garnituren, krimp, enz.), transformatie, decoratie (gordijnen, vitrages, kussens, fauteuilhoezen, enz.)."
        ],
        "es": [
          "Christi-Ligne es un taller de costura: arreglos (dobladillos, cierres, pasamanería, encogimientos, etc.), transformación, decoración (cortinas, visillos, cojines, fundas de sillones, etc.)."
        ]
      },
