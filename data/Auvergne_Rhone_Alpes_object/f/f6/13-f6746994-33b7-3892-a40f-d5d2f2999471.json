  "rdfs:comment": {
    "de": [
      "Die Schüler der 1ère Bac Pro organisieren die 3? Fête Agricole\" (Landwirtschaftliches Fest) am Lycée agricole de Montéléger.\r\nEin Tag, der den ländlichen Traditionen gewidmet ist, mit Animationen, Bauernmarkt, Ausstellungen, regionalen Gerichten (auf Reservierung) und Getränken."
    ],
    "en": [
      "1st Bac Pro students organize the 3? Fête Agricole at Montéléger agricultural college.\r\nA day dedicated to rural traditions, with entertainment, a farmers' market, exhibitions, a local meal (reservation required) and refreshments."
    ],
    "it": [
      "Gli studenti del 1° Bac Pro organizzano il 3? Festa dell'agricoltura presso l'istituto agrario di Montéléger.\r\nUna giornata dedicata alle tradizioni rurali, con intrattenimento, mercato contadino, mostre, pasto locale (su prenotazione) e bar per il ristoro."
    ],
    "fr": [
      "Les élèves de 1ère Bac Pro organisent la 3ᵉ Fête Agricole au lycée agricole de Montéléger.\r\nUne journée dédiée aux traditions rurales avec animations, marché de producteurs, expositions, repas du terroir (sur réservation) et buvette."
    ],
    "es": [
      "Los alumnos de 1º de Bac Pro organizan el 3? Fiesta de la agricultura en el colegio agrícola de Montéléger.\r\nUna jornada dedicada a las tradiciones rurales, con animaciones, un mercado agrícola, exposiciones, una comida local (previa reserva) y un bar de refrescos."
    ],
    "nl": [
      "De 1e Bac Pro-studenten organiseren het 3? Landbouwfeest in de landbouwschool van Montéléger.\r\nEen dag gewijd aan landelijke tradities, met entertainment, een boerenmarkt, tentoonstellingen, een streekmaaltijd (reserveren verplicht) en een verfrissingsbar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête Agricole"
    ]
  },
