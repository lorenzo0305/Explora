  "rdfs:comment": {
    "de": [
      "Betrieb, der aus einem Zuchtbetrieb mit 110 Kühen der Rasse Charolais besteht. Besichtigung des Stalls, Entdeckung der Wiederkäuer, Herstellung der Ration...\r\nAuf dem Hof erzeugte Produkte: Rindfleisch."
    ],
    "en": [
      "Farm consisting of a breeding of 110 cows of Charolais breed. Visit of the stall, discovery of the ruminants, production of the ration...\r\nFarm production : Beef."
    ],
    "it": [
      "Azienda agricola con 110 vacche di razza Charolaise. Visita della stalla, scoperta dei ruminanti, preparazione della razione...\r\nProdotti agricoli: Manzo."
    ],
    "fr": [
      "Exploitation composée d'un élevage de 110 vaches de race charolaises. Visite de la stabulation, découverte des ruminants, fabrication de la ration...\r\nProductions de la ferme : Viande bovine."
    ],
    "es": [
      "Granja con 110 vacas de la raza Charolais. Visita del puesto, descubrimiento de los rumiantes, elaboración de la ración...\r\nProductos agrícolas: Carne de vacuno."
    ],
    "nl": [
      "Boerderij met 110 koeien van het Charolais ras. Bezoek van de stal, ontdekking van de herkauwers, samenstelling van het rantsoen...\r\nLandbouwproducten: Rundvlees."
    ]
  },
