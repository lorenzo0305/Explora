    "de": [
      "Finden Sie alle Geschmäcker der Berge im Herzen von Lyon: Fondues, Raclettes, Tartiflettes, Crêpes werden Ihre Gaumenfreuden begeistern!"
    ],
    "en": [
      "Discover all the flavours of the mountain in the very heart of Lyon including fondues, raclettes, tartiflettes and pancakes. A real treat for food lovers!"
    ],
    "it": [
      "Scoprite tutti i sapori della montagna nel cuore di Lione: fondute, raclettes, tartiflettes e crêpes delizieranno il vostro palato!"
    ],
    "fr": [
      "Retrouvez toutes les saveurs de la montagne en plein cœur de Lyon : fondues, raclettes, tartiflettes, crêpes raviront votre gourmandise !"
    ],
    "nl": [
