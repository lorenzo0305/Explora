  "rdfs:comment": {
    "de": [
      "Von der Einführung bis zur Perfektionierung, von kleinen Ausritten bis zur ganztägigen Entdeckung der Margeride - die Animateure von Cheval en Margeride passen sich allen Wünschen an."
    ],
    "en": [
      "From initiation to improvement, from short rides to discoveries to the Margeride day, the animators of Cheval en Margeride adapt to all requests."
    ],
    "it": [
      "Dai principianti ai più esperti, dalle brevi escursioni alle scoperte di un giorno intero della Margeride, gli istruttori di Cheval en Margeride possono adattarsi a tutte le richieste."
    ],
    "fr": [
      "De l'initiation au perfectionnement, des petites balades aux découvertes à la journée de la Margeride, les animateurs de Cheval en Margeride s'adaptent à toutes les demandes."
    ],
    "nl": [
      "Van beginners tot gevorderden, van korte tochten tot volledige dagtochten op de Margeride, de instructeurs van Cheval en Margeride kunnen zich aan alle wensen aanpassen."
    ],
    "es": [
      "De los principiantes a los avanzados, de los paseos cortos a los descubrimientos de todo el día de la Margeride, los instructores de Cheval en Margeride pueden adaptarse a todas las solicitudes."
    ]
  },
