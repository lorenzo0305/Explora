  "rdfs:comment": {
    "de": [
      "Eine Dorf-Crêperie mit einer schönen Terrasse auf dem Platz von Quincie im Beaujolais. Ein Ort der Flucht und des Wohlbefindens im Herzen des Beaujolais für einen kleinen Durst... eine salzige oder süße Pause... ein Brett zum Teilen... eine Nachspeise für die Kinder... ein Aperitif.."
    ],
    "en": [
      "A village crêperie with a pretty terrace on the square in Quincie en Beaujolais. A place to get away from it all and feel good in the heart of the Beaujolais region for a quick snack... a sweet and savoury break... a board to share... a snack for the kids... an aperitif..."
    ],
    "it": [
      "Una crêperie di paese con una bella terrazza sulla piazza di Quincie en Beaujolais. Un luogo di evasione e di benessere nel cuore del Beaujolais per una piccola sete... una pausa dolce e salata... una tavola da condividere... una merenda per i bambini... un aperitivo.."
    ],
    "fr": [
      "Une crêperie de village avec une jolie terrasse sur la place de Quincie en Beaujolais. Un coin d'évasion et de bien être au cœur du Beaujolais pour une petite soif... une pause salée/sucrée...une planche à partager...un gouter pour les enfants…un apéro…"
    ],
    "es": [
      "Una crepería de pueblo con una bonita terraza en la plaza de Quincie en Beaujolais. Un lugar de evasión y bienestar en el corazón del Beaujolais para pasar un poco de sed... una pausa dulce y salada... una tabla para compartir... una merienda para los niños... un aperitivo.."
    ],
    "nl": [
      "Een dorpscrêperie met een mooi terras op het plein in Quincie en Beaujolais. Een plek van ontsnapping en welzijn in het hart van de Beaujolais voor een beetje dorst... een zoete en hartige pauze... een bord om te delen... een snack voor de kinderen... een aperitief.."
    ]
  },
  "rdfs:label": {
    "en": [
      "Crêperie le Balostan"
    ],
