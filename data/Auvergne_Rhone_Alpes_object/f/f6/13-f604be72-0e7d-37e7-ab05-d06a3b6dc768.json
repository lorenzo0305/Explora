  "rdfs:comment": {
    "de": [
      "Willkommen in unserem Raum, einem kleinen, gemütlichen traditionellen Restaurant am Fuße der Quelle des Flusses Reyssouze. Wir sind bestrebt, Ihnen eine einfache, aber raffinierte Küche zu servieren, in einem vollständig renovierten Raum mit Veranda und kleiner Terrasse an schönen Tagen."
    ],
    "en": [
      "Welcome to our cozy, traditional restaurant at the foot of the Reyssouze spring. Our aim is to serve you simple yet refined cuisine in a completely renovated setting, with a veranda and small terrace in fine weather."
    ],
    "it": [
      "Benvenuti nel nostro accogliente ristorante tradizionale ai piedi della sorgente Reyssouze. Ci proponiamo di servirvi una cucina semplice ma raffinata in un locale completamente rinnovato, con una veranda e una piccola terrazza nella bella stagione."
    ],
    "fr": [
      "Bienvenue dans notre espace, petit restaurant traditionnel douillet au pied de la source de la Reyssouze. Soucieux de vous servir une cuisine simple mais raffinée, dans un lieu entièrement rénové, avec véranda et petite terrasse aux beaux jours."
    ],
    "nl": [
      "Welkom in ons gezellige traditionele restaurant aan de voet van de Reyssouze bron. Wij streven ernaar u een eenvoudige maar verfijnde keuken te serveren in een volledig gerenoveerde ruimte, met een veranda en een klein terras bij mooi weer."
    ],
    "es": [
      "Bienvenido a nuestro acogedor restaurante tradicional a los pies del manantial de Reyssouze. Nuestro objetivo es servirle una cocina sencilla pero refinada en un local completamente renovado, con un porche y una pequeña terraza cuando hace buen tiempo."
    ]
  },
