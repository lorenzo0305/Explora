  "rdfs:comment": {
    "de": [
      "Die Stadt Jarrie hat in Partnerschaft mit dem Monkey Club im Park Clos Jouvin rund um das Rathaus von Jarrie einen festen Disc Golf-Parcours mit 9 Löchern und einem Übungskorb installieren lassen."
    ],
    "en": [
      "The town of Jarrie, in partnership with the Monkey club, has installed a fixed Disc Golf course, comprising 9 holes and a practice basket, in the Clos Jouvin park around Jarrie town hall."
    ],
    "it": [
      "La città di Jarrie, in collaborazione con il Monkey club, ha installato un campo fisso di Disc Golf, comprendente 9 buche e un campo pratica, nel parco Clos Jouvin intorno al municipio di Jarrie."
    ],
    "fr": [
      "La ville de Jarrie, en partenariat avec le club des Monkey, a fait installer un parcours fixe de Disc Golf, comprenant 9 trous et une corbeille de practice, dans le parc du Clos Jouvin, autour de la mairie de Jarrie."
    ],
    "es": [
      "La ciudad de Jarrie, en colaboración con el club Monkey, ha instalado un campo de Disc Golf fijo, de 9 hoyos y un campo de prácticas, en el parque Clos Jouvin, en los alrededores del ayuntamiento de Jarrie."
    ],
    "nl": [
      "De stad Jarrie heeft in samenwerking met de Monkey club een vaste Disc Golf baan aangelegd, bestaande uit 9 holes en een driving range, in het Clos Jouvin park rond het gemeentehuis van Jarrie."
    ]
  },
  "rdfs:label": {
