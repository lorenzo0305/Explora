  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a9351af3-5a70-3786-ab0d-64f82c8ca36a",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag von 9:00 bis 19:30 Uhr\nSonntag von 9:30 bis 13:00 Uhr\n\nAbholung :\n\nZu den Öffnungszeiten des Geschäfts\n\nBestellungen:\n\nEs besteht die Möglichkeit, Ihre Bestellungen vorab telefonisch unter 03 52 79 00 85 vorzubereiten und zu den Ladenöffnungszeiten im Laden abzuholen.\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday, 9am to 7:30pm\nSunday from 9:30am to 1pm\n\nCollection :\n\nDuring store opening hours\n\nOrdering :\n\nOrders can be placed in advance by phone on 03 52 79 00 85 and picked up at the store during store opening hours.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato, dalle 9.00 alle 19.30\nDomenica dalle 9.30 alle 13.00\n\nRaccolta :\n\nDurante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate in anticipo per telefono al numero 03 52 79 00 85 e ritirate in negozio durante gli orari di apertura.\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi de 9h à 19h30\nLe dimanche de 9h30 à 13h\n\nRetrait :\n\nAux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de préparer vos commandes à l'avance par téléphone au 03 52 79 00 85 et de venir la chercher au magasin aux horaires du magasin.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag van 9u tot 19u30\nZondag van 9.30 tot 13.00\n\nAfhalen :\n\nTijdens openingstijden van de winkel\n\nBestellen :\n\nBestellingen kunnen vooraf telefonisch worden doorgegeven op 03 52 79 00 85 en kunnen tijdens de openingsuren in de winkel worden afgehaald.\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado de 9h00 a 19h30\nDomingo de 9h30 a 13h00\n\nRecogida :\n\nDurante el horario de apertura de la tienda\n\nPedidos :\n\nLos pedidos pueden hacerse con antelación por teléfono llamando al 03 52 79 00 85 y recogerse en la tienda durante el horario de apertura.\n\n "
        ]
      },
