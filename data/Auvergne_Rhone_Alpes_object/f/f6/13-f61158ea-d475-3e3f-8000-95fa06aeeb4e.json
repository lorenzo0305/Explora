  "rdfs:comment": {
    "de": [
      "Das Cabaret d'Automne 2026 bringt alle Generationen im Centre socioculturel de Gannat zusammen. Die Veranstaltung wird von der ANCM und La Bourrée Gannatoise organisiert und bietet eine Mischung aus Musik, Geselligkeit und lokalen Köstlichkeiten in einer herzlichen Atmosphäre."
    ],
    "en": [
      "The Cabaret d?Automne 2026, brings together all generations at the Centre socioculturel de Gannat. Organized by ANCM with La Bourrée Gannatoise, this festive event combines music, conviviality and local flavors in a warm atmosphere."
    ],
    "it": [
      "Il Cabaret d'Automne 2026 riunisce tutte le generazioni al Centre Socioculturel di Gannat. Organizzato dall'ANCM con La Bourrée Gannatoise, questo evento festivo unisce musica, convivialità e sapori locali in una calda atmosfera."
    ],
    "fr": [
      "Le Cabaret d’Automne 2026, réunit toutes les générations au Centre socioculturel de Gannat. Organisé par l’ANCM avec La Bourrée Gannatoise, cet événement festif mêle musiques, convivialité et saveurs locales dans une ambiance chaleureuse."
    ],
    "nl": [
      "Het Cabaret d'Automne 2026 brengt alle generaties samen in het Centre Socioculturel in Gannat. Dit feestelijke evenement, georganiseerd door het ANCM in samenwerking met La Bourrée Gannatoise, combineert muziek, gezelligheid en lokale smaken in een warme sfeer."
    ],
    "es": [
      "El Cabaret d'Automne 2026 reúne a todas las generaciones en el Centre Socioculturel de Gannat. Organizado por la ANCM con La Bourrée Gannatoise, este evento festivo combina música, convivencia y sabores locales en un ambiente cálido."
    ]
  },
