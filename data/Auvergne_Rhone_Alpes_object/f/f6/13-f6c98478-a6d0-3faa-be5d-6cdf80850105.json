  "rdfs:comment": {
    "de": [
      "Atemberaubender Blick auf das Beaujolais und das Saône-Tal vom neuen, zeitgenössischen Saal aus. Der Küchenchef, Julien Valençot, wird Sie mit einer raffinierten und kreativen Küche verwöhnen, für die er ein Geheimnis hat."
    ],
    "en": [
      "Stunning views over the Beaujolais and the Val de Saône from the new, contemporary dining room. The chef, Julien Valençot, will introduce you to the refined, creative cuisine that is his secret."
    ],
    "it": [
      "Dalla nuova sala da pranzo contemporanea, la vista sul Beaujolais e sulla Val de Saône è mozzafiato. Lo chef, Julien Valençot, vi farà scoprire una cucina raffinata e creativa di cui possiede il segreto."
    ],
    "fr": [
      "Point de vue imprenable sur le Beaujolais et le Val de Saône depuis la nouvelle salle contemporaine. Le chef, Julien Valençot, vous fera découvrir une cuisine raffinée et créative dont il a le secret."
    ],
    "nl": [
      "Vanuit de nieuwe eigentijdse eetzaal is het uitzicht op de Beaujolais en de Val de Saône adembenemend. De chef, Julien Valençot, laat u een verfijnde en creatieve keuken ontdekken waarvan hij het geheim kent."
    ],
    "es": [
      "Desde el nuevo comedor contemporáneo, la vista del Beaujolais y del Val de Saône es impresionante. El chef, Julien Valençot, le hará descubrir una cocina refinada y creativa de la que tiene el secreto."
    ]
  },
