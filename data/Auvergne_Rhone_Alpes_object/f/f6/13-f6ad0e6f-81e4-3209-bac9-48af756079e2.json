  "rdfs:comment": {
    "de": [
      "Das Atelier Chroma ist ein Arbeits-, Ausstellungs- und Verkaufsraum für zeitgenössische Kunst. Hier werden Arbeiten aus den Bereichen Malerei, Gravur, Volumen, Fotografie, Video und Installation angeboten."
    ],
    "en": [
      "Studio Chroma is a place dedicated to creation and exhibition of contemporary art. Paintings, engraving, volume, photography, video and installation, are exhibited there."
    ],
    "it": [
      "Atelier Chroma è uno spazio per lavorare, esporre e vendere arte contemporanea. Vengono proposte opere di pittura, incisione, volume, fotografia, video e installazione."
    ],
    "fr": [
      "L’Atelier Chroma est un espace de travail, d’exposition et de vente en art contemporain. Des travaux de peinture, gravure, volume, photographie, vidéo et installation, y sont proposés."
    ],
    "nl": [
      "Atelier Chroma is een ruimte voor het werken, tentoonstellen en verkopen van hedendaagse kunst. Het biedt werken in schilderkunst, grafiek, volume, fotografie, video en installatie."
    ],
    "es": [
      "Atelier Chroma es un espacio de trabajo, exposición y venta de arte contemporáneo. Se ofrecen obras de pintura, grabado, volumen, fotografía, vídeo e instalación."
    ]
  },
