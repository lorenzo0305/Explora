  "rdfs:comment": {
    "de": [
      "Erleben Sie einen angenehmen Gourmetmoment, auf der Terrasse oder in einem gemütlichen Raum, mit einem atemberaubenden Blick auf die Aravis-Kette. Eine hausgemachte Küche aus frischen Produkten."
    ],
    "en": [
      "Enjoy a pleasant gourmet moment terrace or in a bold and slightly scenery with an unimpeded views of Aravis. A cooking from here and elsewhere open to the world with savoy notes"
    ],
    "it": [
      "Vivi un piacevole momento da gourmet, sulla terrazza o in uno spazio con un arredamento audace e scintillante, con viste mozzafiato sulla gamma Aravis. Cucina di qui e altrove che mescola ispirazioni aperte al mondo con note savoiarde."
    ],
    "fr": [
      "Vivez un agréable moment gourmand, en terrasse ou dans un espace chaleureux, avec vue imprenable sur la chaîne des Aravis. Une cuisine maison, réalisée à base de produits frais."
    ],
    "es": [
      "Disfrute de una deliciosa comida en la terraza o en el acogedor comedor, con una impresionante vista de la cordillera de Aravis. Cocina casera con productos frescos."
    ],
    "nl": [
      "Beleef een aangenaam gastronomisch moment, op het terras of in een ruimte met een gewaagde en sprankelende inrichting, met een adembenemend uitzicht op de Aravis-reeks. De keuken van hier en elders combineert inspiratie voor de wereld met Savoyaardse tonen."
    ]
  },
