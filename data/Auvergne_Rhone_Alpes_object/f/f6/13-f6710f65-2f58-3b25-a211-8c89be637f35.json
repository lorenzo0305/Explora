  "rdfs:comment": {
    "de": [
      "Bergamote, Ihr Restaurant Trattoria | Pizzeria in Langeac, ein geselliger Ort, an dem sich die Leidenschaft für gutes Essen auf jedem Teller wiederfindet.\r\n Handwerklich hergestellte Pizzen & italienische Küche mit frischen & leckeren Zutaten mit einer gemütlichen Atmosphäre"
    ],
    "en": [
      "Bergamote, your Restaurant Trattoria | Pizzeria in Langeac, a friendly place where the passion for good food can be found on every plate.\r\n Artisanal pizzas & Italian cuisine with fresh & tasty ingredients in a warm atmosphere"
    ],
    "it": [
      "Bergamote, il vostro Ristorante Trattoria | Pizzeria a Langeac, un luogo accogliente dove la passione per la buona cucina si ritrova in ogni piatto.\r\n Pizze fatte in casa e cucina italiana con ingredienti freschi e gustosi in un'atmosfera calda e accogliente"
    ],
    "fr": [
      "Bergamote, votre Restaurant Trattoria | Pizzeria à Langeac, un lieu convivial où la passion de la bonne cuisine se retrouve dans chaque assiette. \r\n Pizzas artisanales & cuisine italienne avec des ingrédients frais & savoureux avec une ambiance chaleureuse"
    ],
    "nl": [
      "Bergamote, uw Restaurant Trattoria | Pizzeria in Langeac, een gezellige plek waar de passie voor lekker eten op elk bord te vinden is.\r\n Huisgemaakte pizza's en Italiaanse gerechten met verse, smakelijke ingrediënten in een warme en vriendelijke sfeer"
    ],
    "es": [
      "Bergamote, su Restaurante Trattoria | Pizzeria en Langeac, un lugar acogedor donde la pasión por la buena comida se encuentra en cada plato.\r\n Pizzas caseras y cocina italiana con ingredientes frescos y sabrosos en un ambiente cálido y acogedor"
    ]
  },
  "rdfs:label": {
