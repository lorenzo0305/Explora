  "rdfs:comment": {
    "de": [
      "Das Zentrum empfängt Schulkinder im Alter von 2 bis 6 Jahren mittwochs während des Schuljahres und während der Schulferien.\r\nIhr Kind wird mit gleichaltrigen Freunden Aktivitäten zur Förderung der Entwicklung und Freizeitgestaltung teilen."
    ],
    "en": [
      "The Center welcomes schoolchildren aged 2 to 6, on Wednesdays during the school year and during school vacations.\r\nYour child will share early-learning and leisure activities with friends his or her own age."
    ],
    "it": [
      "Il Centro accoglie i bambini dai 2 ai 6 anni il mercoledì durante l'anno scolastico e durante le vacanze scolastiche.\r\nIl bambino condividerà attività di apprendimento precoce e di svago con amici della sua età."
    ],
    "fr": [
      "Le Centre accueille les enfants scolarisés de 2 à 6 ans, le mercredi pendant l'année scolaire et durant les vacances scolaires.\r\nVotre enfant partagera avec des copains de son âge des activités d'éveil et de loisirs."
    ],
    "nl": [
      "Het centrum verwelkomt schoolkinderen van 2 tot 6 jaar op woensdagen tijdens het schooljaar en tijdens de schoolvakanties.\r\nJe kind kan samen met vrienden van zijn of haar eigen leeftijd activiteiten doen op het gebied van voorschools leren en vrijetijdsbesteding."
    ],
    "es": [
      "El Centro acoge a niños de 2 a 6 años los miércoles durante el curso escolar y durante las vacaciones escolares.\r\nSu hijo compartirá actividades de aprendizaje y ocio con amigos de su edad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre de Loisirs Sans Hébergement les P'tits Bouts"
    ]
  },
