    "de": [
      "SR wird von dem Akkordeonisten CenDra begleitet, um ein schönes musikalisches Abenteuer rund um ein Repertoire französischer Chansons zu erleben. Freie Teilnahme und gemeinsames Essen."
    ],
    "en": [
      "SR will be joined by accordionist CenDra for a musical adventure featuring a repertoire of French songs. Free admission and shared meal."
    ],
    "it": [
      "SR sarà affiancato dal fisarmonicista CenDra per un'avventura musicale con un repertorio di canzoni francesi. Ingresso libero e pasto condiviso."
    ],
    "fr": [
      "SR sera accompagné de l'accordéoniste CenDra pour une belle aventure musicale autour d'un répertoire de chansons françaises. Participation libre et repas partagé."
    ],
    "nl": [
      "SR wordt vergezeld door accordeonist CenDra voor een muzikaal avontuur met een repertoire van Franse liedjes. Gratis toegang en gezamenlijke maaltijd."
    ],
    "es": [
      "SR se unirá al acordeonista CenDra para una aventura musical con un repertorio de canciones francesas. Entrada gratuita y comida compartida."
    ]
