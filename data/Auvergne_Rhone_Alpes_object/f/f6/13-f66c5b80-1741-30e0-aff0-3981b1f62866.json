  "rdfs:comment": {
    "de": [
      "Formidable! Aznavour ist mehr als nur eine Hommage an die Ikone des französischen Chansons Charles Aznavour. Es ist eine emotionale Reise durch sein Leben und seine außergewöhnliche Karriere, während seine größten Lieder gefeiert werden."
    ],
    "en": [
      "Formidable! Aznavour is much more than a simple tribute to French chanson icon Charles Aznavour. It's an emotional journey through his life and extraordinary career, celebrating his greatest songs."
    ],
    "it": [
      "Formidabile! Aznavour è molto più di un semplice tributo all'icona della chanson francese Charles Aznavour: è un viaggio emozionante attraverso la sua vita e la sua straordinaria carriera, che celebra le sue più grandi canzoni."
    ],
    "fr": [
      "Formidable ! Aznavour est bien plus qu’un simple hommage à l’icône de la chanson française Charles Aznavour, c’est un voyage émotionnel à travers sa vie et son extraordinaire carrière, tout en célébrant ses plus grandes chansons."
    ],
    "es": [
      "¡Formidable! Aznavour es mucho más que un simple homenaje al icono de la chanson francesa Charles Aznavour: es un viaje emocional a través de su vida y su extraordinaria carrera, celebrando sus mejores canciones."
    ],
    "nl": [
      "Formidabel! Aznavour is veel meer dan een eenvoudig eerbetoon aan de Franse chansonicoon Charles Aznavour. Het is een emotionele reis door zijn leven en buitengewone carrière, met zijn beste liedjes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Formidable Aznavour"
    ]
  },
