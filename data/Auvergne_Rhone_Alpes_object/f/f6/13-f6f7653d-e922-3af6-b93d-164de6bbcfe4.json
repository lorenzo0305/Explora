  "rdfs:comment": {
    "de": [
      "Gemeinde im Herzen der Valdaine. Ein dynamisches und gastfreundliches Dorf.\r\nFranziskus I., Kaiser Barbarossa oder Madame de Sévigné haben es Ihnen gleichgetan. Sie sind in dieses Dorf gekommen. Sie können auf ihren Spuren wandeln..."
    ],
    "en": [
      "Commune located in the heart of the Valdaine. A dynamic, welcoming village.\r\nFrancois 1er, Emperor Barbarossa and Madame de Sévigné did the same as you. They came to this village. You can follow in their footsteps..."
    ],
    "it": [
      "Comune situato nel cuore della Valdaine. Un villaggio dinamico e accogliente.\r\nFrançois 1er, l'imperatore Barbarossa o Madame de Sévigné hanno fatto come voi. Sono venuti in questo villaggio. Potete seguire le loro orme?"
    ],
    "fr": [
      "Commune située au cœur de la Valdaine. Un village dynamique et accueillant.\r\nFrancois 1er, l’empereur Barberousse ou Madame de Sévigné ont fait comme vous. Ils sont venus dans ce village. Vous pourrez marcher sur leurs traces…"
    ],
    "es": [
      "Municipio situado en el corazón de la Valdaine. Un pueblo dinámico y acogedor.\r\nFrançois 1er, el emperador Barbarossa o Madame de Sévigné hicieron lo mismo. Llegaron a este pueblo. ¿Puedes seguir sus pasos?"
    ],
    "nl": [
      "Gemeente in het hart van de Valdaine. Een dynamisch en gastvrij dorp.\r\nFrançois 1e, keizer Barbarossa en Madame de Sévigné deden hetzelfde als jij. Zij kwamen naar dit dorp. U kunt in hun voetsporen treden..."
    ]
  },
