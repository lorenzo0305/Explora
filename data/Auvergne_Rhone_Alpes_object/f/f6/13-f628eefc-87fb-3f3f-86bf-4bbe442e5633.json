  "rdfs:comment": {
    "de": [
      "Ein Treffen zwischen den afghanischen Stickereien des Guldusi-Projekts und den Künstlern des Kollektivs Conteurs d'Art. Vorgeschlagen im Rahmen der FITE -Biennale für Textilien - Clermont-Ferrand."
    ],
    "en": [
      "Encounter between the Afghan embroideries of the Guldusi project and the artists of the Conteurs d?Art collective, as part of the FITE - Textile Biennial - Clermont-Ferrand."
    ],
    "it": [
      "Incontro tra le ricamatrici afghane del progetto Guldusi e gli artisti del collettivo Conteurs d'Art, nell'ambito della FITE - Biennale del Tessuto - Clermont-Ferrand."
    ],
    "fr": [
      "Rencontre entre les broderies Afghanes du projet Guldusi et les artistes du collectif Conteurs d’Art. Proposée dans le cadre du FITE -Biennale textile - Clermont-Ferrand."
    ],
    "es": [
      "Encuentro entre bordadoras afganas del proyecto Guldusi y artistas del colectivo Conteurs d'Art, en el marco de la FITE - Bienal Textil - Clermont-Ferrand."
    ],
    "nl": [
      "Een ontmoeting tussen Afghaanse borduursters van het Guldusi project en kunstenaars van het Conteurs d?Art collectief, als onderdeel van de FITE - Textiel Biënnale - Clermont-Ferrand."
    ]
  },
