  "rdfs:comment": {
    "de": [
      "Das Team von K2 Outdoor empfängt Sie am Rande des Radwegs mit kostenlosen Parkplätzen und berät Sie gerne zu den Routen am Seeufer. Und natürlich auch in den Bergen!"
    ],
    "en": [
      "For the bicycle pros or amateur cyclists, for rides in nature or just to enjoy the green way, in bike-certified destination... K2 Outdoor adapts to your desires by offering a Scott bike or mountain bike hire, electric or normal."
    ],
    "it": [
      "Ai margini della pista ciclabile, con parcheggio gratuito, il team di K2 Outdoor sarà lì per accogliervi e consigliarvi sui percorsi intorno al lago. E anche sulle montagne, naturalmente!"
    ],
    "fr": [
      "Au bord de la piste cyclable, avec un parking gratuit, l'équipe de K2 Outdoor sera là pour vous accueillir et vous conseiller sur les itinéraires du bord du lac. Et de ses montagnes aussi, bien sûr!"
    ],
    "es": [
      "Al borde del carril bici, con aparcamiento gratuito, el equipo de K2 Outdoor estará allí para darle la bienvenida y aconsejarle sobre las rutas alrededor del lago. Y también por la montaña, por supuesto"
    ],
    "nl": [
      "Aan de rand van het fietspad, met gratis parkeergelegenheid, staat het K2 Outdoor team klaar om je te verwelkomen en je te adviseren over de routes rond het meer. En de bergen natuurlijk ook!"
    ]
  },
  "rdfs:label": {
    "en": [
      "K2 Outdoor - Bike Hire"
    ],
    "fr": [
      "K2 Outdoor - Location de vélos"
    ]
  },
