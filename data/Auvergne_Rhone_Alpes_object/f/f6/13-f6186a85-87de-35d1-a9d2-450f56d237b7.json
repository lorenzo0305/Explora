  "rdfs:comment": {
    "de": [
      "Genießen Sie einen Moment der Entspannung im Thermalbad: zwei Schwimmbäder mit warmem Thermalwasser (innen und außen), Saunen, Hammams... Gönnen Sie sich einen sanften Moment im Institut: Modelagen, Körper- und Gesichtspflege, Hydrotherapie..."
    ],
    "en": [
      "The thermal baths offer a guaranteed moment of relaxation: hot thermal pools (indoor and outdoor), saunas, steam rooms, treatment areas (massages, modelling, hydrotherapy treatments and scrubs ...)."
    ],
    "it": [
      "La Spa termale offre un assoluto momento di relax: piscina d'acqua termale calda (interna ed esterna) sauna, hammam, spazio trattamenti (massaggi, forma, idroterapia, scrub...)."
    ],
    "fr": [
      "Profitez d'un moment de détente au Spa thermal : deux piscines en eau thermale chaude (intérieure et extérieure), saunas, hammams... Accordez-vous un instant de douceur à l'institut : modelages, soins du corps, soins du visage, hydrothérapie..."
    ],
    "nl": [
      "Geniet van een moment van ontspanning in de thermen: twee warmwaterbaden (binnen en buiten), sauna's, hammams... Gun uzelf een moment van ontspanning in het instituut: modellering, lichaamsbehandelingen, gezichtsbehandelingen, hydrotherapie..."
    ],
    "es": [
      "Disfrute de un momento de relajación en el spa termal: dos piscinas de agua termal caliente (interior y exterior), saunas, hammams... Regálese un momento de relajación en el instituto: modelado, tratamientos corporales, tratamientos faciales, hidroterapia..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chevalley Thermal Baths"
    ],
    "it": [
      "Spa termale \"Thermes Chevalley\""
    ],
    "fr": [
      "Spa thermal des Thermes Chevalley"
    ]
  },
