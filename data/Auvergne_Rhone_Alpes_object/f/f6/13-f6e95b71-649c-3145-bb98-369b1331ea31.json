  "rdfs:comment": {
    "de": [
      "Mit einer Sammlung von 80 alten Fahrzeugen (1920 bis 1980) und dem Erbe der Tankstelle Lapalisse Essence (Kanister, Emailleschilder, Zapfsäulen...) lässt dieses Museum das menschliche Abenteuer der Nationalstraße 7 erstrahlen."
    ],
    "en": [
      "With a collection of 80 vintage vehicles (1920 to 1980) and the heritage of the Lapalisse Essence service station (cans, enamelled plates, petrol pumps, etc.), this museum brings to life the human adventure of the Nationale 7."
    ],
    "it": [
      "Con una collezione di 80 veicoli d'epoca (dal 1920 al 1980) e il patrimonio della stazione di servizio Lapalisse Essence (lattine, targhe smaltate, pompe di benzina, ecc.), questo museo fa rivivere l'avventura umana della Nationale 7."
    ],
    "fr": [
      "Avec une collection de 80 véhicules anciens (1920 à 1980) et le patrimoine de la station service Lapalisse Essence (bidons, plaques émaillées, pompes à essence...), ce musée fait rayonner l'aventure humaine de la Nationale 7."
    ],
    "nl": [
      "Met een collectie van 80 oldtimers (1920 tot 1980) en het erfgoed van het benzinestation Lapalisse Essence (blikken, geëmailleerde borden, benzinepompen, enz.) brengt dit museum het menselijk avontuur van de Nationale 7 tot leven."
    ],
    "es": [
      "Con una colección de 80 vehículos de época (de 1920 a 1980) y el patrimonio de la estación de servicio Lapalisse Essence (latas, placas esmaltadas, surtidores, etc.), este museo da vida a la aventura humana de la Nationale 7."
    ]
  },
  "rdfs:label": {
