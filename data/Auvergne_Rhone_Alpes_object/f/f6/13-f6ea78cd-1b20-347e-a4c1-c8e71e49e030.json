  "rdfs:comment": {
    "de": [
      "Das Haus Forissier lädt Sie ein, die Aromen der Verbene rund um eine Reihe von handwerklich hergestellten Produkten zu genießen, wie den Liqueur de Verveine, Kräutertees und andere Gewürze auf der Basisvon Verbene. Elegant und duftend - die Verbene weckt die Sinne!"
    ],
    "en": [
      "The Maison Forissier invites you to savour the taste of verbena in a range of traditional products such as vervain liqueur, herbal teas and various verbena-based condiments. Verbena is an elegant and fragrant plant that stimulates the senses!"
    ],
    "it": [
      "Immergetevi nel cuore della nostra produzione artigianale e partecipate a una visita guidata per scoprire tutte le competenze coinvolte nella produzione della Verveine du Forez."
    ],
    "fr": [
      "Après une immersion au cœur de notre production artisanale, découvrez, grâce à une visite guidée, tous les savoirs-faire de la Verveine du Forez."
    ],
    "es": [
      "Sumérjase en el corazón de nuestra producción artesanal y realice una visita guiada para descubrir todos los oficios que intervienen en la elaboración de la Verveine du Forez."
    ],
    "nl": [
      "Dompel jezelf onder in het hart van onze ambachtelijke productie en volg een rondleiding om alle vaardigheden te ontdekken die komen kijken bij het maken van Verveine du Forez."
    ]
  },
