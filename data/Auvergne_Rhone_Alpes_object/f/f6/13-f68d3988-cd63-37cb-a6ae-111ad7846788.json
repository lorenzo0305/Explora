  "rdfs:comment": {
    "de": [
      "Unternehmen mit Laden, das Besichtigungen nach vorheriger Anmeldung organisiert.\r\n\r\nDer Cash-Bio Markal ist der größte Bio-Supermarkt im Departement Drôme. Hier finden Sie die größte Auswahl an Bio-Produkten."
    ],
    "en": [
      "Company with boutique, organizing tours by reservation.\r\n\r\nMarkal Cash-Bio is the largest organic supermarket in the Drôme. You'll find the widest choice of organic products."
    ],
    "it": [
      "Azienda con negozio che organizza visite su prenotazione.\r\n\r\nMarkal Cash-Bio è il più grande supermercato biologico della Drôme. Troverete la più ampia scelta di prodotti biologici."
    ],
    "fr": [
      "Entreprise avec boutique organisant des visites sur réservation.\r\n\r\nLe Cash-Bio Markal est le plus grand supermarché Bio de la Drôme. Vous y trouverez le plus large choix de produits Bio."
    ],
    "es": [
      "Empresa con tienda que organiza visitas con reserva.\r\n\r\nMarkal Cash-Bio es el mayor supermercado ecológico de la Drôme. Encontrará la más amplia gama de productos ecológicos."
    ],
    "nl": [
      "Bedrijf met winkel organiseert bezoeken op afspraak.\r\n\r\nMarkal Cash-Bio is de grootste biologische supermarkt in de Drôme. Je vindt er de grootste keuze aan biologische producten."
    ]
  },
