  "rdfs:comment": {
    "de": [
      "Produkte vom Bauernhof: Eier, Sonnenblumen- und Rapsöl, Weiß- und Vollkornmehl, Grieß, Nudeln.  Jeden Morgen in der Bäckerei in Saint-Germain-de-Salles erhältlich. Einkauf auf dem Bauernhof auf Bestellung oder im Lebensmittelgeschäft."
    ],
    "en": [
      "Farm products: eggs, sunflower oil, rapeseed oil, white and wholemeal flour, semolina, pasta. Purchases at the farm to order, or at the grocery store and market in Saint-Germain-de-Salles."
    ],
    "it": [
      "Prodotti aziendali: uova, olio di girasole, olio di colza, farina bianca e integrale, semola, pasta.  In vendita ogni mattina presso il panificio di Saint-Germain-de-Salles. Si possono acquistare in fattoria su ordinazione o presso il negozio di alimentari."
    ],
    "fr": [
      "Produits de la ferme : œufs, huile tournesol, colza, farine blanche et complète, semoule, pâtes.  En vente tous les matins à la boulangerie de Saint-Germain-de-Salles. Achats à la ferme sur commande ou à l'épicerie."
    ],
    "es": [
      "Productos de la granja: huevos, aceite de girasol, aceite de colza, harina blanca e integral, sémola, pasta.  A la venta todas las mañanas en la panadería de Saint-Germain-de-Salles. Se puede comprar en la granja por encargo o en la tienda de comestibles."
    ],
    "nl": [
      "Producten van de boerderij: eieren, zonnebloemolie, koolzaadolie, wit en volkoren meel, griesmeel, pasta.  Elke ochtend te koop bij de bakker in Saint-Germain-de-Salles. Op bestelling te koop bij de boerderij of in de kruidenierswinkel."
    ]
  },
  "rdfs:label": {
