  "rdfs:comment": {
    "de": [
      "Auf seinem Felsvorsprung (723 m), in der Gemeinde Retournac, erhebt sich das Schloss Artias im Zentrum der Berge, Miaune und Madeleine, über die Windungen der Loire."
    ],
    "en": [
      "Located on its rocky spur (723 m), on the commune of Retournac, the castle of Artias, in the center of the mounts, Miaune and Madeleine, stands above the meanders of the Loire."
    ],
    "it": [
      "Situato sul suo sperone roccioso (723 m), nel comune di Retournac, lo Château d'Artias, al centro delle montagne Miaune e Madeleine, si erge sui meandri della Loira."
    ],
    "fr": [
      "Situé sur son éperon rocheux (723 m), sur la commune de Retournac, le château d’Artias, au centre des monts, Miaune et Madeleine, se dresse au-dessus des méandres de la Loire."
    ],
    "es": [
      "Situado en su espolón rocoso (723 m), en la comuna de Retournac, el castillo de Artias, en el centro de los montes Miaune y Madeleine, se alza sobre los meandros del Loira."
    ],
    "nl": [
      "Gelegen op een rotsachtige uitloper (723 m), in de gemeente Retournac, staat het Château d'Artias, midden in het Miaune- en Madeleine-gebergte, boven de meanderende Loire."
    ]
  },
