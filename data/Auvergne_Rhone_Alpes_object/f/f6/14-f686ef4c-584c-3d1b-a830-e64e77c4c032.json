  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/731d8d7e-3363-3006-9035-85b34ad66ea2",
      "dc:description": {
        "de": [
          "Der Campingplatz La Sensation in Matringhem organisiert einen Abend mit Muscheln und Pommes frites nach Belieben\nTreffpunkt am Samstag, den 13. Juli ab 19:30 Uhr, gefolgt von einem Karnevals-Themenabend\n\nAuf Reservierung"
        ],
        "en": [
          "La Sensation campsite in Matringhem is organizing an all-you-can-eat mussels and French fries evening\nRendezvous on Saturday July 13 from 7.30pm, followed by a carnival-themed evening\n\nReservations required"
        ],
        "it": [
          "Il campeggio La Sensation di Matringhem organizza una serata a base di cozze e patatine fritte\nAppuntamento sabato 13 luglio a partire dalle 19.30, seguito da una serata a tema carnevalesco\n\nSolo su prenotazione"
        ],
        "fr": [
          "Le camping La Sensation à Matringhem organise une soirée moules frites à volonté\nRendez-vous le samedi 13 juillet à partir de 19h30, suivie d'une soirée thème carnaval\n\nSur réservation"
        ],
        "es": [
          "El camping La Sensation de Matringhem organiza una velada a base de mejillones y patatas fritas\nNos vemos el sábado 13 de julio a partir de las 19.30 h., seguida de una velada temática de carnaval\n\nSólo con reserva previa"
        ],
        "nl": [
          "Camping La Sensation in Matringhem organiseert een mossel- en frietavond met alles erop en eraan\nOntmoet ons op zaterdag 13 juli vanaf 19.30 uur, gevolgd door een avond met carnaval als thema\n\nAlleen op reservering"
        ]
      },
      "@type": [
        "Description"
