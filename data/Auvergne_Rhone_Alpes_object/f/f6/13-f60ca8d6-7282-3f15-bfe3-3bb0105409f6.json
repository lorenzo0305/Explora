  "rdfs:comment": {
    "de": [
      "Natürliche Pflegeprodukte aus frischer Bio-Ziegenmilch, hergestellt in den Cevennen der Ardèche. In handwerklicher Tradition hergestellt. Zutaten natürlichen Ursprungs. Verseifung nach dem Kaltverfahren. Mit oder ohne ätherische Öle. Bio-Zertifizierung."
    ],
    "en": [
      "Soaps and shower gels made with fresh Ardèche goat's milk, produced in Les Vans in the Cévennes region of Ardèche. Handcrafted by hand. 100% natural ingredients. Cold saponification. With or without essential oils. Organic certification."
    ],
    "it": [
      "Prodotti naturali per la cura della pelle a base di latte fresco di capra biologico, prodotti nella regione delle Cévennes, in Ardèche. Prodotti artigianali. Ingredienti di origine naturale. Saponificazione a freddo. Con o senza oli essenziali. Certificazione biologica."
    ],
    "fr": [
      "Produits de soins naturels au lait de chèvre frais bio, fabriqués dans les Cévennes ardéchoises. Fabrication artisanale. Ingrédients d'origine naturelle. Saponification à froid. Avec ou sans huiles essentielles. Certification Bio."
    ],
    "es": [
      "Productos naturales para el cuidado de la piel elaborados con leche de cabra ecológica fresca, producida en la región de Cévennes, en Ardèche. Elaborados artesanalmente. Ingredientes de origen natural. Saponificación en frío. Con o sin aceites esenciales. Certificación ecológica."
    ],
    "nl": [
      "Natuurlijke huidverzorgingsproducten gemaakt van verse biologische geitenmelk, geproduceerd in de Cevennen in de Ardèche. Handgemaakt. Ingrediënten van natuurlijke oorsprong. Koude verzeping. Met of zonder essentiële oliën. Biologische certificering."
    ]
  },
