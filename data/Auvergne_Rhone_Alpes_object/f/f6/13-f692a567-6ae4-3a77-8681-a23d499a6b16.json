  "rdfs:comment": {
    "de": [
      "Ein Team aus einem Direktor und diplomierten Betreuern empfängt Kinder von 3 bis 14 Jahren und bietet ihnen zahlreiche Aktivitäten drinnen und draußen an."
    ],
    "en": [
      "A team of qualified people offers to your children from 3 to 14 years old, a full range of out-and-indoor activities."
    ],
    "it": [
      "Un team composto da un direttore e da animatori qualificati accoglie i bambini dai 3 ai 14 anni e offre loro un'ampia gamma di attività al chiuso e all'aperto."
    ],
    "fr": [
      "Une équipe composée d'un directeur et d'animateurs diplômés accueille les enfants de 3 à 14 ans et leur propose de nombreuses activités d'intérieur comme d'extérieur."
    ],
    "es": [
      "Un equipo formado por un director y monitores de actividades cualificados acoge a niños de 3 a 14 años y les ofrece una amplia gama de actividades de interior y al aire libre."
    ],
    "nl": [
      "Kinderclub met professionele animatieleiders voor kinderen van 3t/m 14 jaar. Talloze binnen- en buitenactiviteiten."
    ]
  },
