  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Mont Saxonnex bietet Ihnen die Möglichkeit, ihre Dokumente vor Ort frei zu konsultieren.\r\nSie bietet einen vielfältigen Bestand für Kinder und Erwachsene sowie das ganze Jahr über Autorentreffen, Aufführungen und Animationen."
    ],
    "en": [
      "The Mont Saxonnex library allows you to consult its documents freely on site.\r\nIt offers a varied background for children and adults as well as meetings with authors, shows and activities throughout the year."
    ],
    "it": [
      "La biblioteca di Mont Saxonnex offre la consultazione gratuita dei suoi documenti in loco.\r\nOffre una vasta gamma di libri per bambini e adulti, oltre a incontri con gli autori, spettacoli ed eventi durante tutto l'anno."
    ],
    "fr": [
      "La bibliothèque de Mont Saxonnex vous propose de consulter ses documents librement sur place.\r\nElle propose un fond varié pour les enfants et les adultes ainsi que des rencontres d’auteurs, des spectacles et des animations tout au long de l’année."
    ],
    "es": [
      "La biblioteca de Mont Saxonnex ofrece la consulta gratuita in situ de sus documentos.\r\nOfrece una amplia gama de libros para niños y adultos, así como encuentros con autores, espectáculos y eventos durante todo el año."
    ],
    "nl": [
      "De bibliotheek van Mont Saxonnex biedt gratis raadpleging van haar documenten ter plaatse.\r\nEr is een ruim aanbod aan boeken voor kinderen en volwassenen, maar ook ontmoetingen met auteurs, voorstellingen en evenementen gedurende het hele jaar."
    ]
  },
  "rdfs:label": {
