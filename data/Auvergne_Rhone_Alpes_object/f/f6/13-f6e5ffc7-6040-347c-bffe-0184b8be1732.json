  "rdfs:comment": {
    "de": [
      "Familie von Fischern, sie sind auf die Zubereitung von frischem Fisch spezialisiert: Barsch, Féra, Saibling, Hecht. . . Genießen Sie ihre Küche am See auf der Terrasse oder in den Zimmern mit Panoramablick."
    ],
    "en": [
      "Family of fishermen, they are specialized in the cooking of fresh fish: perch, féra, char, pike. . . . Enjoy their kitchen on the lake on the terrace, or in the rooms with panoramic view."
    ],
    "it": [
      "Specialità di pesce di lago (coregone, persico, cavedano) pescato dal titolare. Pesci affumicati, soufflé di luccio."
    ],
    "fr": [
      "Famille de pêcheurs, ils sont spécialisés dans la cuisine du poisson frais: perche, féra, omble, brochet.... Dégustez leur cuisine au bord du lac sur la terrasse, ou dans les salles avec vue panoramique."
    ],
    "es": [
      "Una familia de pescadores, especializada en cocinar pescado fresco: perca, salvelino, lucio.... Disfrute de su cocina junto al lago en la terraza, o en las habitaciones con vistas panorámicas."
    ],
    "nl": [
      "Als vissersfamilie zijn ze gespecialiseerd in het bereiden van verse vis: baars, snoekbaars, char, snoek.... Geniet van hun gerechten bij het meer op het terras, of in de kamers met panoramisch uitzicht."
    ]
  },
