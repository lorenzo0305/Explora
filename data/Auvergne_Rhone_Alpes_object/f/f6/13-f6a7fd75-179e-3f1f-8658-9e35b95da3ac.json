  "rdfs:comment": {
    "de": [
      "Ihr Friseursalon in Huriel (03) besteht seit über 50 Jahren und wurde 2012 von Emmanuelle übernommen.\r\n\r\nUnser Team aus 2 Friseurinnen empfängt Sie von Dienstag bis Samstag in einer freundlichen und fröhlichen Atmosphäre für Ihre Pflegemomente!"
    ],
    "en": [
      "In existence for over 50 years, your hair salon in Huriel (03) was taken over in 2012 by Emmanuelle.\r\n\r\nOur team of 2 hairdressers welcomes you from Tuesday to Saturday in a friendly, jovial atmosphere for your pampering moments!"
    ],
    "it": [
      "Presente da oltre 50 anni, il vostro salone di parrucchiere a Huriel (03) è stato rilevato nel 2012 da Emmanuelle.\r\n\r\nIl nostro team di 2 parrucchieri vi accoglie dal martedì al sabato in un'atmosfera amichevole e allegra per i vostri momenti di coccole!"
    ],
    "fr": [
      "Existant depuis plus de 50 ans, votre salon de coiffure à Huriel (03) a été repris en 2012 par Emmanuelle.\r\n\r\nNotre équipe de 2 coiffeuses vous accueille du mardi au samedi dans une ambiance conviviale et joviale pour vos moments de soins !"
    ],
    "nl": [
      "Uw kapsalon in Huriel (03) bestaat al meer dan 50 jaar en werd in 2012 overgenomen door Emmanuelle.\r\n\r\nOns team van 2 kappers verwelkomt u van dinsdag tot zaterdag in een vriendelijke en vrolijke sfeer voor uw verwenmomenten!"
    ],
    "es": [
      "Con más de 50 años de existencia, su peluquería de Huriel (03) fue adquirida en 2012 por Emmanuelle.\r\n\r\n¡Nuestro equipo de 2 peluqueros le da la bienvenida de martes a sábado en un ambiente agradable y alegre para sus momentos de mimos!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Coiffure des Remparts"
    ]
  },
