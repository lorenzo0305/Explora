  "rdfs:comment": {
    "de": [
      "Musik, Zirkus und Werte des Teilens. Das Programm ist eine geschickte Mischung aus lokalen und nationalen Bands und Musik in verschiedenen Stilen, was ein großes Publikum anziehen dürfte (Parken und Camping sind kostenlos). Der Samstag wird ein sehr familienfreundlicher Tag."
    ],
    "en": [
      "Music, circus and shared values. The program is a skilful mix of local and national groups, with music in a variety of styles, which should attract a large audience (free parking and camping). Saturday will be a family day."
    ],
    "it": [
      "Musica, circo e valori condivisi. Il programma è un sapiente mix di gruppi locali e nazionali, con una varietà di stili musicali, che dovrebbe attirare un pubblico numeroso (parcheggio e campeggio gratuiti). Il sabato sarà una giornata dedicata alle famiglie."
    ],
    "fr": [
      "Musique, cirque et valeurs de partage. La programmation est un habile mélange de groupes locaux et nationaux, de musiques aux styles variés, ce qui devrait attirer un nombreux public (parking et camping gratuits). La journée du samedi sera très familiale."
    ],
    "nl": [
      "Muziek, circus en gedeelde waarden. Het programma is een kundige mix van lokale en nationale groepen, met een verscheidenheid aan muziekstijlen, wat een groot publiek zou moeten trekken (gratis parkeren en kamperen). Zaterdag is een familiedag."
    ],
    "es": [
      "Música, circo y valores compartidos. El programa es una hábil mezcla de grupos locales y nacionales, con variedad de estilos musicales, que debería atraer a un numeroso público (aparcamiento y acampada gratuitos). El sábado será un día familiar."
    ]
  },
  "rdfs:label": {
    "fr": [
