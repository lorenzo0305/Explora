  "rdfs:comment": {
    "de": [
      "Geselliges und gemütliches kleines Gasthaus im Herzen von Murat. Hausgemachte, traditionelle Küche, frische Produkte, Fleisch und handwerklich hergestellte Pizzas/Burger vor Ort oder zum Mitnehmen. Mittagsformeln mit Tagesgericht."
    ],
    "en": [
      "Warm, friendly little inn in the heart of Murat. Homemade, traditional cuisine, fresh produce, meat and homemade pizzas/burgers to eat in or take away. Daily specials for lunch."
    ],
    "it": [
      "Piccola locanda accogliente nel cuore di Murat. Cucina casalinga e tradizionale, prodotti freschi, carne e pizze/burger fatti in casa sul posto o da asporto. Formule di pranzo con piatto del giorno."
    ],
    "fr": [
      "Petite auberge conviviale et chaleureuse au cœur de Murat. Cuisine faite maison, traditionnelle, produits frais, viande et pizzas / burgers artisanales sur place ou à emporter. Formules midi avec plat du jour."
    ],
    "es": [
      "Pequeña y acogedora posada en el corazón de Murat. Cocina casera y tradicional, productos frescos, carnes y pizzas/hamburguesas caseras al momento o para llevar. Fórmulas de almuerzo con el plato del día."
    ],
    "nl": [
      "Kleine, vriendelijke en gastvrije herberg in het hart van Murat. Huisgemaakte, traditionele keuken, verse producten, vlees en zelfgemaakte pizza's/burgers ter plaatse of om mee te nemen. Lunchformules met schotel van de dag."
    ]
  },
  "rdfs:label": {
