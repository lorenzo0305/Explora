  "rdfs:comment": {
    "de": [
      "Reiten Sie und haben Sie Spaß auf dem Pumptrack von Injoux am Fuße des Plateau de Retord.\r\nDrei mögliche Abfahrten je nach Niveau mit einer speziellen Abfahrt für unabhängige Anfänger!"
    ],
    "en": [
      "Come ride and have fun at the Injoux pump track, at the foot of the Retord Plateau.\r\nThree possible starts depending on your level, with a special independent start for beginners !"
    ],
    "it": [
      "Venite a divertirvi sulla pista di Injoux, ai piedi del Plateau de Retord.\r\nCi sono tre possibili partenze, a seconda del vostro livello, con una partenza speciale per i principianti indipendenti!"
    ],
    "fr": [
      "Venez rider et vous amuser au pumptrack d'Injoux, au pied sur Plateau de Retord. \r\nTrois départs possibles en fonction du niveau avec un départ spécial débutant indépendant !"
    ],
    "es": [
      "Ven a divertirte en el pumptrack de Injoux, al pie del Plateau de Retord.\r\nHay tres salidas posibles, en función de tu nivel, ¡con una salida especial para principiantes independientes!"
    ],
    "nl": [
      "Kom je uitleven op de pumptrack van Injoux, aan de voet van het Plateau de Retord.\r\nEr zijn drie mogelijke starts, afhankelijk van je niveau, met een speciale start voor zelfstandige beginners!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Pumptrack d'Injoux"
    ],
    "fr": [
      "Pumptrack d'Injoux"
    ]
  },
