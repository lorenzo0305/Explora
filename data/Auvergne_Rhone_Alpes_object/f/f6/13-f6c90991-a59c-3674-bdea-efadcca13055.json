  "rdfs:comment": {
    "de": [
      "Das Restaurant de l'Avenue liegt in einer angenehmen Umgebung ,nur wenige Schritte vom Bahnhof entfernt, und bietet Ihnen einen schnellen Service und ein sehr gutes Preis-Leistungs-Verhältnis mit 'hausgemachten' Gerichten."
    ],
    "en": [
      "In a pleasant setting just a stone’s throw from the station, the Restaurant de l’Avenue proposes fast service, great value for money and in-house cuisine."
    ],
    "it": [
      "Situato in un ambiente piacevole a pochi passi dalla stazione, il ristorante de l'avenue offre un servizio rapido e un ottimo rapporto qualità-prezzo, con piatti fatti in casa."
    ],
    "fr": [
      "Situé dans un cadre agréable, à deux pas de la gare, le restaurant de l'avenue vous propose un service rapide et un très bon rapport qualité-prix, avec des plats \"fait maison\"."
    ],
    "es": [
      "Situado en un entorno agradable a dos pasos de la estación, el restaurante de l'avenue ofrece un servicio rápido y una excelente relación calidad-precio, con platos caseros."
    ],
    "nl": [
      "Het restaurant de l'avenue ligt in een aangename omgeving op een steenworp afstand van het station en biedt snelle service en veel waar voor uw geld, met huisgemaakte gerechten."
    ]
  },
