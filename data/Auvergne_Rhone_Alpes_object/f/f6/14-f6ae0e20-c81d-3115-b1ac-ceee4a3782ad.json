      "@id": "https://data.datatourisme.fr/71808da6-5a78-3188-9a1c-20f3a16a94a1",
      "dc:description": {
        "de": [
          "Die Stadt Samer lädt Sie zu einem Country-Ball ein, der von Sam's Country in der Salle des Fêtes de Samer moderiert wird.\n\nDie Einnahmen werden vollständig an den Téléthon gespendet."
        ],
        "en": [
          "The town of Samer invites you to a Country Ball hosted by Sam's Country at the Salle des Fêtes de Samer.\n\nAll profits will be donated to the Telethon."
        ],
        "it": [
          "La città di Samer vi invita al ballo country organizzato da Sam's Country presso la Salle des Fêtes di Samer.\n\nL'intero ricavato sarà devoluto a Telethon."
        ],
        "fr": [
          "La Ville de Samer vous invite à un Bal Country animé par Sam's Country à la Salle des Fêtes de Samer.\n\nLes bénéfices seront intégralement reversés au Téléthon."
        ],
        "es": [
          "La ciudad de Samer le invita a un Baile Country organizado por Sam's Country en la Salle des Fêtes de Samer.\n\nTodo lo recaudado se donará al Teletón."
        ],
        "nl": [
          "De stad Samer nodigt je uit voor een Country Ball georganiseerd door Sam's Country in de Salle des Fêtes in Samer.\n\nAlle opbrengsten gaan naar de Telethon."
        ]
      },
