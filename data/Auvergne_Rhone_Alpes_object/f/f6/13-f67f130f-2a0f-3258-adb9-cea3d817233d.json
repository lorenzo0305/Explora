  "rdfs:comment": {
    "de": [
      "Hautperfektionistin, biologisch forschend, maßgeschneiderte, exklusive und private Gesichtspflegeprogramme, Wellness, Massagen.\r\n\r\nPersonalisierte Behandlungen nur auf Reservierung. Es kann ein maßgeschneidertes Programm mit einer Dauer von 1 bis 2 Stunden angeboten werden."
    ],
    "en": [
      "Skin perfectionist, organic research, exclusive and private made-to-measure facial care programs, well-being, massages.\r\n\r\nPersonalized treatments by reservation only. Tailor-made programs of 1 to 2 hours are available."
    ],
    "it": [
      "Perfezionista della pelle, ricerca biologica, programmi esclusivi e privati di cura del viso su misura, benessere, massaggi.\r\n\r\nTrattamenti personalizzati su prenotazione. È possibile proporre un programma su misura della durata di 1 o 2 ore."
    ],
    "fr": [
      "Perfectionniste de la peau, biologique recherche, programmes de soins visage sur-mesure, exclusif et privatif, bien-être, massages.\r\n\r\nSoins personnalisés sur réservation uniquement. Un programme sur mesure peut  être proposé d’une durée de 1h à 2h."
    ],
    "es": [
      "Perfeccionamiento de la piel, investigación orgánica, programas exclusivos y privados de cuidado facial a medida, bienestar, masajes.\r\n\r\nTratamientos personalizados sólo con reserva. Se puede proponer un programa a medida con una duración de 1 a 2 horas."
    ],
    "nl": [
      "Huidperfectionist, biologisch onderzoek, gezichtsverzorgingsprogramma's op maat, exclusief en privé, welzijn, massages.\r\n\r\nGepersonaliseerde behandelingen alleen op reservering. Een op maat gemaakt programma van 1 tot 2 uur is beschikbaar."
    ]
  },
