  "rdfs:comment": {
    "de": [
      "Die Freizeitanlage von Vénérieu erstreckt sich über 30 Hektar und umfasst ein angelegtes Wasserloch mit Sandstrand zum Baden, das nach vorheriger Reservierung zugänglich ist, Freizeitaktivitäten, ein Restaurant und einen Angelbereich."
    ],
    "en": [
      "The Vénérieu leisure park covers 30 hectares and includes a reservoir with a sandy beach for swimming, which is accessible by reservation, leisure activities, a restaurant and a fishing area."
    ],
    "it": [
      "Il parco divertimenti di Vénérieu si estende su 30 ettari e comprende un bacino idrico con una spiaggia sabbiosa per il nuoto, accessibile su prenotazione, attività ricreative, un ristorante e un'area di pesca."
    ],
    "fr": [
      "La base de loisirs de Vénérieu s'étend sur 30 hectares et comprend un point d'eau aménagé avec plage de sable pour la baignade, accessible sur réservation, des activités de loisirs, un restaurant et un espace pêche."
    ],
    "nl": [
      "Het recreatiepark van Vénérieu strekt zich uit over 30 hectare en omvat een stuwmeer met een zandstrand om te zwemmen, toegankelijk op reservering, vrijetijdsactiviteiten, een restaurant en een visgebied."
    ],
    "es": [
      "El parque de ocio de Vénérieu ocupa 30 hectáreas e incluye un embalse con una playa de arena para bañarse, accesible previa reserva, actividades de ocio, un restaurante y una zona de pesca."
    ]
  },
  "rdfs:label": {
    "en": [
      "Venerieu Lake"
    ],
    "fr": [
      "Lac de baignade de Vénérieu"
    ]
  },
