  "rdfs:comment": {
    "de": [
      "Hier können Sie unsere moderne französische Küche in Zusammenarbeit mit dem Sternekoch Pierre Gagnaire sowie unsere Vorspeisen- und Dessert-Buffets nach Belieben entdecken."
    ],
    "en": [
      "Discover our contemporary French cuisine prepared in cooperation with the star-winning Chef Pierre Gagnaire, in addition to our all-you-can-eat buffets of hors d’œuvre and desserts."
    ],
    "it": [
      "Vieni a scoprire la nostra cucina francese contemporanea elaborata in collaborazione con lo chef stellato Pierre Gagnaire e i nostri buffet di antipasti e di dessert a volontà."
    ],
    "fr": [
      "Découvrez une cuisine française contemporaine élaborée en collaboration avec Pierre Gagnaire, Chef étoilé, ainsi que des buffets de hors-d’œuvre et de desserts à volonté."
    ],
    "es": [
      "Proponemos una cocina francesa contemporánea elaborada en colaboración con Pierre Gagnaire, premiado con 3 estrellas Michelin, además de bufé libre de entremeses y postres."
    ],
    "nl": [
      "Geniet van de hedendaagse Franse keuken, bereid in samenwerking met sterrenchef Pierre Gagnaire, en van een all-you-can-eat hors d??uvre- en dessertbuffet."
