  "rdfs:comment": {
    "de": [
      "Auf dem Bauernhof Naturânesse halten Julie und Théo ihre Eselinnen biologisch und unter Beachtung des Tierschutzes. Auf ihrem Hof verarbeiten sie die wertvolle Milch zu Naturkosmetik und verbinden dabei handwerkliches Können mit ethischem Engagement."
    ],
    "en": [
      "At the Naturânesse farm, Julie and Théo raise their donkeys organically, respecting animal welfare. On their farm, they transform this precious milk into natural cosmetics, combining traditional know-how and ethical commitment."
    ],
    "it": [
      "Nella fattoria Naturânesse, Julie e Théo allevano le loro asine in modo biologico, rispettando il benessere degli animali. Nella loro fattoria, trasformano questo prezioso latte in cosmetici naturali, combinando il know-how tradizionale con un impegno etico."
    ],
    "fr": [
      "Au sein de la ferme Naturânesse, Julie et Théo élèvent leurs ânesses en bio dans le respect du bien-être animal. Sur leur ferme, ils transforment ce lait précieux en cosmétiques naturels, alliant savoir-faire artisanal et engagement éthique."
    ],
    "nl": [
      "Op de Naturânesse boerderij fokken Julie en Théo hun ezels op biologische wijze en met respect voor het dierenwelzijn. Op hun boerderij verwerken ze deze kostbare melk tot natuurlijke cosmetica, waarbij ze traditionele knowhow combineren met een engagement voor ethiek."
    ],
    "es": [
      "En la granja Naturânesse, Julie y Théo crían a sus burras de forma ecológica, respetando el bienestar animal. En su granja, transforman esta preciosa leche en cosméticos naturales, combinando el saber hacer tradicional con un compromiso ético."
    ]
  },
  "rdfs:label": {
