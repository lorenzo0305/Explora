  "rdfs:comment": {
    "de": [
      "Kunstreise in der Drôme des collines an 6 Orten des Kulturerbes: Eglise St Ange in Peyrins, Chapelle St Roch in Crépol, Eglise du Charaix in St Christophe et le Laris, Maison Quarrée in Moras, Château de Larnage in Anneyron und Domaine Revol in St Uze."
    ],
    "en": [
      "Artistic tour of the Drôme des Collines in 6 heritage sites: Eglise St Ange in Peyrins, Chapelle St Roch in Crépol, Eglise du Charaix in St Christophe et le Laris, Maison Quarrée in Moras, Château de Larnage in Anneyron and Domaine Revol in St Uze."
    ],
    "it": [
      "Un viaggio artistico attraverso la Drôme des Collines in 6 siti del patrimonio: Eglise St Ange a Peyrins, Chapelle St Roch a Crépol, Eglise du Charaix a St Christophe et le Laris, Maison Quarrée a Moras, Château de Larnage ad Anneyron e Domaine Revol a St Uze."
    ],
    "fr": [
      "Parcours artistique en Drôme des collines dans 6 lieux patrimoniaux : Eglise St Ange à Peyrins, Chapelle St Roch à Crépol, Eglise du Charaix à St Christophe et le Laris, Maison Quarrée à Moras, Château de Larnage à Anneyron et Domaine Revol à St Uze."
    ],
    "es": [
      "Un recorrido artístico por la Drôme des Collines en 6 lugares patrimoniales: Eglise St Ange en Peyrins, Chapelle St Roch en Crépol, Eglise du Charaix en St Christophe et le Laris, Maison Quarrée en Moras, Château de Larnage en Anneyron y Domaine Revol en St Uze."
    ],
    "nl": [
      "Een artistieke reis door de Drôme des Collines op 6 erfgoedlocaties: Eglise St Ange in Peyrins, Chapelle St Roch in Crépol, Eglise du Charaix in St Christophe et le Laris, Maison Quarrée in Moras, Château de Larnage in Anneyron en Domaine Revol in St Uze."
    ]
  },
