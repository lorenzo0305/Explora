  "rdfs:comment": {
    "de": [
      "Atelier eines Malers. Arbeit auf Bestellung.\r\nÖlgemälde (figurativ, Porträts, Tiere, Olivenhaine, Stadt Nyons, Meeresbilder, Surrealismus), Pastellfarben.\r\nKunstkurse in allen Techniken für Kinder, Jugendliche und Erwachsene in Gruppen und im Einzelunterricht."
    ],
    "en": [
      "Paint workshop open to the public.\r\nCustom work on all subjects.\r\nOil paintings all figurative subjects, portraits, animals, olive groves, town of Nyons, seascapes and also surrealism, pastels.\r\nClasses for children and teenagers Wednesday & Saturday morning."
    ],
    "it": [
      "Studio del pittore. Lavori su commissione.\r\nDipinti a olio (figurativi, ritratti, animali, oliveti, città di Nyons, paesaggi marini, surrealismo), pastelli.\r\nLezioni d'arte in tutte le tecniche per bambini, adolescenti e adulti in gruppi e lezioni private."
    ],
    "fr": [
      "Atelier de peintre. Travail sur commande.\r\nPeintures à l'huile (figuratif, portraits, animaux, oliveraies, ville de Nyons, marines, surréalisme), pastels.\r\nCours d'art toutes techniques pour enfants , adolescents, adultes en groupe et en cours particuliers."
    ],
    "nl": [
      "Schilder workshop open voor het publiek.\r\nWerk op bestelling, alle onderwerpen.\r\nOlie schilderijen van portrette, dieren, olijfboomgaarden, de stad Nyons, et ook surrealistische werken en pastels.\r\nlessen voor kinderen en tieners op woensdag- en zaterdag voormiddag."
    ],
    "es": [
      "Estudio de pintura. Trabajos por encargo.\r\nÓleos (figurativos, retratos, animales, olivares, ciudad de Nyons, paisajes marinos, surrealismo), pasteles.\r\nClases de arte en todas las técnicas para niños, adolescentes y adultos en grupos y clases particulares."
    ]
  },
