      "dc:description": {
        "de": [
          "So Delicio ist ein Fast-Food-Restaurant, das Hamburger, Tacos und Pizzas zum Mitnehmen anbietet.  Es werden verschiedene Menüs angeboten, darunter auch ein Kindermenü. Möglichkeit der Lieferung nach Hause."
        ],
        "en": [
          "So Delicio is a fast food restaurant offering hamburgers, tacos, pizza to go.  Different menus are available, including children's menus. Possibility of home delivery."
        ],
        "it": [
          "So Delicio è un fast food che offre hamburger, tacos e pizze da asporto.  Sono disponibili diversi menu, compreso un menu per bambini. Possibilità di consegna a domicilio."
        ],
        "fr": [
          "So Delicio est un fast food proposant hamburgers, tacos, pizzas à emporter.  Différents menus proposés dont menu enfant. Possibilité d'être livré à domicile."
        ],
        "es": [
          "So Delicio es un restaurante de comida rápida que ofrece hamburguesas, tacos y pizzas para llevar.  Se ofrecen diferentes menús, incluido un menú para niños. Posibilidad de entrega a domicilio."
        ],
        "nl": [
          "Dus Delicio is een fast food restaurant met hamburgers, taco's en pizza's om mee te nemen.  Verschillende menu's beschikbaar, waaronder een kindermenu. Mogelijkheid tot thuisbezorging."
        ]
      },
