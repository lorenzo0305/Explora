  "rdfs:comment": {
    "de": [
      "Im Zarathustra, das im Herzen des Ibie-Tals liegt, empfangen Sie Baptiste und Marion mit einer Neo-Bistro-Küche. Es erwartet Sie eine kleine Speisekarte, die je nach Ankunft und Jahreszeit wechselt und vor allem auf lokale Produkte setzt."
    ],
    "en": [
      "At Zarathoustra, nestled in the heart of the Ibie Valley, Baptiste and Marion welcome you to their neo-bistro cuisine. A small menu awaits you, changing with the seasons and according to availability, with a focus on local produce."
    ],
    "it": [
      "A Le Zarathoustra, nel cuore della valle dell'Ibie, Baptiste e Marion vi accolgono con la loro cucina neo-bistrot. Vi aspetta un piccolo menu che cambia a seconda delle stagioni e che utilizza il più possibile prodotti locali."
    ],
    "fr": [
      "Au Zarathoustra, niché au cœur de la vallée de l'Ibie, Baptiste et Marion vous accueillent autour d'une cuisine néo-bistro. Une petite carte vous attend, changeant au gré des arrivages et des saisons en faisant la part belle aux produits locaux."
    ],
    "nl": [
      "In Le Zarathoustra, genesteld in het hart van de Ibie-vallei, verwelkomen Baptiste en Marion je met hun neo-bistrokeuken. Er staat je een kleine kaart te wachten, die met de seizoenen mee verandert en zoveel mogelijk lokale producten gebruikt."
    ],
    "es": [
      "En Le Zarathoustra, en el corazón del valle del Ibie, Baptiste y Marion le dan la bienvenida con su cocina neo-bistro. Le espera una pequeña carta que cambia con las estaciones y que utiliza, en la medida de lo posible, productos locales."
    ]
  },
