  "rdfs:comment": {
    "de": [
      "Entdecken Sie den roten Orientierungslauf in Chanoux: 6,5 km und 240 m Höhenunterschied im Herzen des Mont Vallier. Eine sportliche Herausforderung zwischen Natur und Kulturerbe, ideal für Outdoor-Fans und Liebhaber von Nervenkitzel."
    ],
    "en": [
      "Discover the red orienteering course at Chanoux: 6.5 km and 240 m ascent in the heart of Mont Vallier. A sporting challenge between nature and heritage, ideal for outdoor enthusiasts and thrill-seekers."
    ],
    "it": [
      "Scoprite il percorso rosso di orienteering di Chanoux: 6,5 km e 240 m di dislivello nel cuore del Mont Vallier. Una sfida sportiva che unisce natura e patrimonio, ideale per gli amanti dell'outdoor e del brivido."
    ],
    "fr": [
      "Découvrez le parcours rouge de course d’orientation à Chanoux : 6,5 km et 240 m de dénivelé au cœur du mont Vallier. Un défi sportif entre nature et patrimoine, idéal pour les amateurs de plein air et de sensations fortes."
    ],
    "nl": [
      "Ontdek het rode oriëntatieparcours van Chanoux: 6,5 km en 240 m klimmen in het hart van de Mont Vallier. Een sportieve uitdaging die natuur en erfgoed combineert, ideaal voor outdoorliefhebbers en sensatiezoekers."
    ],
    "es": [
      "Descubra el recorrido de orientación rojo de Chanoux: 6,5 km y 240 m de desnivel en el corazón del Mont Vallier. Un desafío deportivo que combina naturaleza y patrimonio, ideal para los amantes de las actividades al aire libre y las emociones fuertes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours rouge d'orientation de Chanoux Vallier"
    ]
  },
