  "rdfs:comment": {
    "de": [
      "Seit mehr als 35 Jahren liegt es dem Maison Patifrais und seinen Teams am Herzen, Ihnen Qualitätsprodukte, die nach authentischen und großzügigen Rezepten zubereitet werden, zu Hause anzubieten."
    ],
    "en": [
      "For more than 35 years, Maison Patifrais and its teams have been committed to bringing you quality products made to authentic, generous recipes."
    ],
    "it": [
      "Da oltre 35 anni, la Maison Patifrais e i suoi team si impegnano a offrire prodotti di qualità preparati secondo ricette autentiche e generose."
    ],
    "fr": [
      "Depuis plus de 35 ans, la Maison Patifrais et ses équipes ont à coeur de vous proposer à domicile des produits de qualité élaborés selon des recette authentiques et généreuses."
    ],
    "es": [
      "Desde hace más de 35 años, la Maison Patifrais y sus equipos se comprometen a ofrecerle productos de calidad elaborados según recetas auténticas y generosas."
    ],
    "nl": [
      "Al meer dan 35 jaar zetten Maison Patifrais en haar teams zich in om u kwaliteitsproducten te bieden, bereid volgens authentieke en genereuze recepten."
    ]
  },
