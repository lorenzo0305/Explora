  "rdfs:comment": {
    "de": [
      "Der Karneval der Tiere ist eines der bekanntesten musikalischen Werke für Kinder. Wenn man dann noch die bezaubernde Stimme von Élodie Fondacci hinzufügt, wird es dringend notwendig, es sich im Auditorium anzuhören."
    ],
    "en": [
      "Le Carnaval des animaux is one of the most famous musical works for children. Add to this the spellbinding voice of Élodie Fondacci, and you?ve got to come and hear it at the Auditorium."
    ],
    "it": [
      "Le Carnaval des animaux è una delle più famose opere musicali per bambini. Se a ciò si aggiunge la voce ammaliante di Élodie Fondacci, non si può non venire a sentirla all'Auditorium."
    ],
    "fr": [
      "Le Carnaval des animaux est l’une des œuvres musicales les plus célèbres pour les enfants. Ajoutons-y la voix envoûtante d’Élodie Fondacci, et il devient alors urgent de venir l’écouter à l’Auditorium."
    ],
    "nl": [
      "Le Carnaval des animaux is een van de beroemdste muziekwerken voor kinderen. Voeg daar de betoverende stem van Élodie Fondacci aan toe, en je moet het komen horen in het Auditorium."
    ],
    "es": [
      "Le Carnaval des animaux es una de las obras musicales infantiles más famosas. Si a esto le añadimos la fascinante voz de Élodie Fondacci, no puede dejar de venir a escucharla al Auditorio."
    ]
  },
  "rdfs:label": {
