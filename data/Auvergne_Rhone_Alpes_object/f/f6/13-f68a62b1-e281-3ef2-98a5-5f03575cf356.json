  "rdfs:comment": {
    "de": [
      "Begleitete Ausflüge mit 100% elektrischen und zugelassenen Quads auf der Straße zwischen dem wunderschönen See von Annecy und den majestätischen Bergen von Aravis. Mehrere Strecken stehen zur Verfügung. Entdecken Sie diese innovative und zugleich umweltfreundliche Aktivität."
    ],
    "en": [
      "Accompanied outing on 100% electric, road-approved quads between magnificent Lake Annecy and the majestic Aravis mountains. Several routes available. Come and discover this innovative and environmentally-friendly activity."
    ],
    "it": [
      "Escursione accompagnata su quad 100% elettrici e omologati per la circolazione stradale tra il magnifico lago di Annecy e le maestose montagne degli Aravis. Sono disponibili diversi percorsi. Venite a scoprire questa attività innovativa ed ecologica."
    ],
    "fr": [
      "Sortie accompagnée en quads 100% électriques et homologués sur route entre le magnifique lac d'Annecy et les majestueuses montagnes des Aravis. Plusieurs parcours disponibles. Venez découvrir cette activité à la fois innovante et écologique."
    ],
    "es": [
      "Excursión acompañada en quads 100% eléctricos, homologados para circular por carretera, entre el magnífico lago de Annecy y los majestuosos montes Aravis. Varios recorridos disponibles. Venga a descubrir esta actividad innovadora y respetuosa con el medio ambiente."
    ],
    "nl": [
      "Begeleide tocht op 100% elektrische, verkeersveilige quad tussen het prachtige meer van Annecy en het majestueuze Aravis-gebergte. Verschillende routes beschikbaar. Kom en ontdek deze innovatieve en milieuvriendelijke activiteit."
    ]
  },
