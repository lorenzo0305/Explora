  "rdfs:comment": {
    "de": [
      "ZUGANGSVERBOT 2025\r\nNach einem Erdrutsch in der Achse der Stätte Les Lames hat die Gemeinde ein AM erlassen, das den Zugang zum gesamten Berg Rachais verbietet."
    ],
    "en": [
      "ACCESS PROHIBITED 2025\r\nFollowing a landslide in the axis of the Lames site, the commune has issued an AM banning access to the entire Rachais mountain."
    ],
    "it": [
      "DIVIETO DI ACCESSO 2025\r\nA seguito di una frana nell'asse del sito di Lames, l'autorità locale ha emesso un'ordinanza che vieta l'accesso all'intera montagna di Rachais."
    ],
    "fr": [
      "ACCÈS INTERDIT 2025\r\nSuite à un éboulement dans l’axe du site des Lames, la commune a pris un AM d’interdiction d’accès à toute la montagne du Rachais."
    ],
    "es": [
      "PROHIBIDO EL ACCESO EN 2025\r\nTras un corrimiento de tierras en el eje del sitio de Lames, la autoridad local ha emitido un AM que prohíbe el acceso a toda la montaña de Rachais."
    ],
    "nl": [
      "GEEN TOEGANG 2025\r\nNa een aardverschuiving in de as van de Lames-site heeft de lokale overheid een AM uitgevaardigd dat de toegang tot de hele Rachais-berg verbiedt."
    ]
  },
  "rdfs:label": {
