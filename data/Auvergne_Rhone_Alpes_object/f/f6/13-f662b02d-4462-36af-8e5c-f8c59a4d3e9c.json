  "rdfs:comment": {
    "de": [
      "Direktverkauf von Fleisch von Limousin-Rindern.\r\nSie stellen Ihre Kiste selbst zusammen, mit den von Ihnen gewünschten Mengen.\r\nAbholung der Pakete auf dem Bauernhof."
    ],
    "en": [
      "Direct sales of Limousin heifer meat.\r\nYou compose your own box, with the quantities you want.\r\nPick-up at the farm."
    ],
    "it": [
      "Vendita diretta di carne di vitella Limousin.\r\nSi compone il proprio box, con le quantità desiderate.\r\nLe confezioni possono essere ritirate in azienda."
    ],
    "fr": [
      "Vente directe de viande de génisses Limousine.\r\nVous composez vous-même votre caissette, avec les quantités que vous souhaitez.\r\nRetrait des colis à la ferme."
    ],
    "es": [
      "Venta directa de carne de novilla Limousin.\r\nUsted confecciona su propia caja, con las cantidades que desee.\r\nLos paquetes se pueden recoger en la granja."
    ],
    "nl": [
      "Directe verkoop van vlees van Limousin vaarzen.\r\nJe stelt je eigen doos samen, met de hoeveelheden die je wilt.\r\nPakketten kunnen worden opgehaald op de boerderij."
    ]
  },
  "rdfs:label": {
