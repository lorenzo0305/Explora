  "rdfs:comment": {
    "de": [
      "Passionierter Musher, der im Winter Schlittenfahrten auf dem Plateau de Retord (01) und den Rest des Jahres Kartfahrten in Menthonnex-en-Bornes (74) oder in der Schweiz anbietet."
    ],
    "en": [
      "Passionate musher who offers sleigh rides in winter on the Plateau de Retord (01) and in kart the rest of the year on Menthonnex-en-Bornes (74) or in Switzerland."
    ],
    "it": [
      "Appassionato musher che offre gite in slitta in inverno sul Plateau de Retord (01) e gite in kart il resto dell'anno a Menthonnex-en-Bornes (74) o in Svizzera."
    ],
    "fr": [
      "Musher passionné qui propose des balades en traîneau l'hivers au Plateau de Retord (01) et en kart le reste de l'année sur Menthonnex-en-Bornes (74) ou en Suisse."
    ],
    "es": [
      "Musher apasionado que ofrece paseos en trineo en invierno en el Plateau de Retord (01) y paseos en kart el resto del año en Menthonnex-en-Bornes (74) o en Suiza."
    ],
    "nl": [
      "Gepassioneerde musher die in de winter sledetochten aanbiedt op het Plateau de Retord (01) en de rest van het jaar karttochten op Menthonnex-en-Bornes (74) of in Zwitserland."
    ]
  },
  "rdfs:label": {
