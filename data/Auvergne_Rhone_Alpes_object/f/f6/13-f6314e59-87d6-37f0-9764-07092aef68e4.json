  "rdfs:comment": {
    "de": [
      "Yogakurse und -workshops in der Natur und in der Halle, alle Niveaus. Die Yogalehrerin Adeline Charvet ist Absolventin des Französischen Yoga-Instituts und unterrichtet alle: Sportler, Kinder, Schwangere etc. Einzelunterricht nach Vereinbarung."
    ],
    "en": [
      "Yoga classes and courses outside in nature and indoors, for all levels. Adeline Charvet, yoga teacher, is a graduate of the French Institute of Yoga and teaches everyone: athletes, children, pregnant women, etc. Individual classes by appointment."
    ],
    "it": [
      "Corsi e lezioni di yoga in natura e al chiuso, per tutti i livelli. L'insegnante di yoga Adeline Charvet è diplomata all'Institut Français de Yoga e insegna a principianti, avanzati, bambini, sportivi e altri. Lezioni individuali su appuntamento."
    ],
    "fr": [
      "Cours et stages de yoga dans la nature, et en salle, tous niveaux. Adeline Charvet, professeure de yoga, est diplômée de l’Institut français de yoga et enseigne à toutes et tous : débutants, confirmés, enfants, sportifs, etc. Cours individuels sur RDV."
    ],
    "nl": [
      "Yogalessen en cursussen in de natuur en binnen, alle niveaus. Yogadocente Adeline Charvet is afgestudeerd aan het Institut Français de Yoga en geeft les aan beginners, gevorderden, kinderen, sportievelingen en anderen. Individuele lessen op afspraak."
    ],
    "es": [
      "Clases y cursos de yoga en la naturaleza y en interior, todos los niveles. La profesora de yoga Adeline Charvet es diplomada del Institut Français de Yoga y enseña a principiantes, avanzados, niños, deportistas y otros. Clases individuales con cita previa."
    ]
  },
