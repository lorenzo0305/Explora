  "rdfs:comment": {
    "de": [
      "Genießen Sie den zeitlosen Kokon des Annexe am Hafen von Nernier in einer sanften Umgebung. Den ganzen Tag über gibt es Frühstück, Mittagessen, Snacks... Nach 18 Uhr entdecken Sie die Cocktailbar mit Spirituosen und hausgemachten Tapas!"
    ],
    "en": [
      "Enjoy the timeless cocoon of the Annexe on the port of Nernier. All day long, breakfasts, lunches, snacks... After 6pm, discover the cocktail bar with spirits and homemade tapas!"
    ],
    "it": [
      "Godetevi il bozzolo senza tempo dell'Annexe sul porto di Nernier. Colazione, pranzo e spuntini sono disponibili tutto il giorno. Dopo le 18:00, scoprite il cocktail bar con liquori e tapas fatte in casa!"
    ],
    "fr": [
      "Dans un écrin de douceur, profitez du cocon hors du temps que  propose l’Annexe sur le port de Nernier. Toute la journée, petits déjeuners, déjeuners et goûters sont proposés. Après 18h découvrez le bar à cocktails avec spiritueux et tapas maison !"
    ],
    "nl": [
      "Geniet van de tijdloze cocon van de Annexe aan de haven van Nernier. Ontbijt, lunch en snacks zijn de hele dag verkrijgbaar. Ontdek na 18.00 uur de cocktailbar met sterke dranken en huisgemaakte tapas!"
    ],
    "es": [
      "Disfrute del capullo atemporal del Anexo en el puerto de Nernier. Desayuno, almuerzo y merienda durante todo el día. A partir de las 18:00, descubra el bar de cócteles con licores y tapas caseras"
    ]
  },
  "rdfs:label": {
    "de": [
      "Das Nebengebäude des Restaurants du Lac"
    ],
    "en": [
      "The Restaurant du Lac annex"
    ],
    "fr": [
      "L'annexe du restaurant du Lac"
    ]
  },
