  "rdfs:comment": {
    "de": [
      "Familienspaziergang durch zu lösende Rätsel, bei dem Sie das Dorf aus verschiedenen Blickwinkeln betrachten können."
    ],
    "en": [
      "Take a family stroll through the village, solving riddles and discovering the village from different points of view."
    ],
    "it": [
      "Una passeggiata per famiglie con indovinelli da risolvere, che vi faranno scoprire il villaggio da diversi punti di vista."
    ],
    "fr": [
      "Balade familiale à travers des énigmes à résoudre, qui vous fera découvrir le village sous différents points de vue."
    ],
    "es": [
      "Un paseo familiar con enigmas por resolver, que le ayudará a descubrir el pueblo desde diferentes puntos de vista."
    ],
