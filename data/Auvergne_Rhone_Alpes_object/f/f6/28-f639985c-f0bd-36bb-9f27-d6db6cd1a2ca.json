  "rdfs:comment": {
    "de": [
      "Marine, Fischhändlerin im Dorf Morlay, das an Ponthoile angrenzt, bietet Aperitifplatten mit Meeresfrüchten und Plancha an. Frisch, lokal und Sie müssen nichts für Ihren Abend vorbereiten, sondern nur genießen! Zögern Sie nicht, Marine im Vorfeld Ihres Aufenthalts zu kontaktieren, um sich beraten zu lassen und Ihre Bestellung aufzugeben."
    ],
    "en": [
      "Marine, fishmonger in the village of Morlay, next to Ponthoile, offers seafood and plancha aperitif platters. Fresh, local and you don't have to prepare anything for your evening, just enjoy! Don't hesitate to contact Marine ahead of time for advice and to place your order."
    ],
    "it": [
      "Marine, la pescheria del villaggio di Morlay, vicino a Ponthoile, offre piatti di pesce e aperitivi plancha. Freschi, locali e non dovrete preparare nulla per la vostra serata, ma solo gustarli! Non esitate a contattare Marine prima del vostro soggiorno per avere i suoi buoni consigli e per fare il vostro ordine."
    ],
    "fr": [
      "Marine, poissonnière du village de Morlay, attenant à Ponthoile, propose des plateaux apéros fruits de mer et plancha. Du frais, du local et vous n'avez rien à préparer pour votre soirée, juste à profiter ! N'hésitez pas à contacter Marine en amont de votre séjour pour ses bons conseils et pour effectuer votre commande."
    ],
    "es": [
      "Marine, la pescadería del pueblo de Morlay, al lado de Ponthoile, ofrece platos de aperitivo a base de marisco y plancha. Frescos, locales y sin tener que preparar nada para la velada, ¡sólo disfrutar! No dude en ponerse en contacto con Marine antes de su estancia para que le aconseje y le haga su pedido."
    ],
    "nl": [
      "Marine, de visboer in het dorp Morlay, naast Ponthoile, biedt zeevruchten en plancha aperitiefschotels. Vers, lokaal en je hoeft niets voor te bereiden voor je avond, gewoon genieten! Aarzel niet om vooraf contact op te nemen met Marine voor haar goede raad en om je bestelling door te geven."
    ]
  },
  "rdfs:label": {
