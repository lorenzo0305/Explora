  "rdfs:comment": {
    "de": [
      "15 Minuten vom Stadtzentrum von Roanne entfernt empfängt das Ateliers des Grands Cèdres jeden Monat einen anderen Koch oder eine andere Köchin, die mit Produkten aus unserer Region arbeiten. Die (vor Ort hergestellten) Teller werden Ihnen in einem einzigartigen Rahmen serviert."
    ],
    "en": [
      "Just 15 minutes from downtown Roanne, Ateliers des Grands Cèdres welcomes a different chef every month to work with local produce. The dishes (made on site) are served in a unique setting."
    ],
    "it": [
      "A soli 15 minuti dal centro di Roanne, l'Ateliers des Grands Cèdres accoglie ogni mese uno chef diverso che lavora con i prodotti locali. I piatti (realizzati in loco) sono serviti in un ambiente unico."
    ],
    "fr": [
      "À 15 min du centre-ville de Roanne, les Ateliers des Grands Cèdres accueillent chaque mois une ou un chef différent qui viennent travailler les produits de notre terroir. Les assiettes (réalisées sur place) vous sont servies dans un cadre unique."
    ],
    "nl": [
      "Op slechts 15 minuten van het centrum van Roanne verwelkomt Ateliers des Grands Cèdres elke maand een andere chef-kok om te werken met lokale producten. De gerechten (ter plekke gemaakt) worden geserveerd in een unieke omgeving."
    ],
    "es": [
      "A 15 minutos del centro de Roanne, Ateliers des Grands Cèdres acoge cada mes a un chef diferente que trabaja con productos locales. Los platos (elaborados in situ) se sirven en un marco único."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Ateliers des Grands Cèdres"
    ]
  },
