  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2e92feda-5208-3675-8488-90c59f0d13e4",
      "dc:description": {
        "de": [
          "Der Verein Touquet Afro Latine Event organisiert jedes Jahr im Juli das 2K FESTIVAL.\nEine Veranstaltung, die den afro-lateinamerikanischen Tänzen gewidmet ist.\nDas ganze Wochenende über finden hier Kurse, Shows und Partys mit Tänzern aus ganz Frankreich und Europa statt."
        ],
        "en": [
          "Every July, the Touquet Afro Latine Event association organizes the 2K FESTIVAL.\nAn event dedicated to Afro-Latin dance.\nThroughout the weekend, you'll find classes, shows and parties featuring dancers from all over France and Europe, amateurs and professionals alike."
        ],
        "it": [
          "Ogni luglio, l'associazione Touquet Afro Latine Event organizza il 2K FESTIVAL.\nUn evento dedicato alla danza afro-latina.\nPer tutto il fine settimana si tengono lezioni, spettacoli e feste con ballerini provenienti da tutta la Francia e dall'Europa, sia amatoriali che professionisti."
        ],
        "fr": [
          "L’association Touquet Afro Latine Event organise chaque année, en juillet, le 2K FESTIVAL. \nUn événement consacré aux danses afro latines. \nPendant tout le week-end, vous y trouverez des cours, des shows, des soirées avec des danseurs venus de toute la France et de l’Europe ; amateurs comme professionnels."
        ],
        "nl": [
          "Elk jaar in juli organiseert de vereniging Touquet Afro Latine Event het 2K FESTIVAL.\nEen evenement gewijd aan Afro-Latijnse dans.\nHet hele weekend lang zijn er lessen, voorstellingen en feesten met dansers uit heel Frankrijk en Europa, zowel amateurs als professionals."
        ],
        "es": [
          "Cada mes de julio, la asociación Touquet Afro Latine Event organiza el FESTIVAL 2K.\nUn evento dedicado a la danza afro-latina.\nDurante todo el fin de semana, encontrará clases, espectáculos y fiestas en las que participan bailarines de toda Francia y Europa, tanto aficionados como profesionales."
        ]
      },
