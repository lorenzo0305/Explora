  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ed31141e-fcdf-3ccb-93f6-ee6964125760",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Fächern werden Ihnen verschiedene Brotsorten angeboten.\n\nTage der Öffnung:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nVarious types of bread are available in racks.\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nSono disponibili vari tipi di pane in rack.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposées différentes sortes de pain.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nVerschillende soorten brood zijn verkrijgbaar in rekken.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nDisponemos de varios tipos de pan en rejillas.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
