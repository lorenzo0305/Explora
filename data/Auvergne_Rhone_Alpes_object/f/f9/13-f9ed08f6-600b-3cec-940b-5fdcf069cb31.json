  "rdfs:comment": {
    "de": [
      "Der Ausschuss Drôme besteht aus 31 Mitgliedern, die von den Clubs bei der Generalversammlung für eine Dauer von vier Jahren gewählt werden. Der Präsident des Komitees ist Herr Jean-Thomas POLETTI."
    ],
    "en": [
      "The Drôme committee is made up of 31 members elected by the clubs at the Annual General Meeting for a 4-year term. The committee chairman is Jean-Thomas POLETTI."
    ],
    "it": [
      "Il Comitato della Drôme è composto da 31 membri eletti dai club durante l'Assemblea generale annuale per un mandato di 4 anni. Il presidente del comitato è Jean-Thomas POLETTI."
    ],
    "fr": [
      "Le comité Drôme est composé de 31 membres élus par les clubs lors de l’Assemblée Générale pour une durée de 4 ans. Le président du comité est M. Jean-Thomas POLETTI."
    ],
    "es": [
      "El Comité de Drôme está compuesto por 31 miembros elegidos por los clubes en la Asamblea General Anual para un mandato de 4 años. El presidente del comité es Jean-Thomas POLETTI."
    ],
    "nl": [
      "De Drômecommissie bestaat uit 31 leden die tijdens de AVA door de clubs worden gekozen voor een periode van 4 jaar. De voorzitter van de commissie is Jean-Thomas POLETTI."
    ]
  },
