  "rdfs:comment": {
    "de": [
      "Zum Abschluss des Little Italy Festivals ist Platz für die Künstler, die die vibrierende Verbindung zwischen Frankreich und Italien verkörpern. Auf der Bühne entdecken Sie Mika, Alfa und Julien Lieb, für einen unvergesslichen letzten Abend!"
    ],
    "en": [
      "To bring the Little Italy Festival to a close, make way for artists who embody a vibrant link between France and Italy. Join Mika, Alfa and Julien Lieb on stage for one last unforgettable evening!"
    ],
    "it": [
      "Per concludere il Little Italy Festival, è il momento degli artisti che incarnano il vibrante legame tra Francia e Italia. Unitevi a Mika, Alfa e Julien Lieb sul palco per un'ultima indimenticabile serata!"
    ],
    "fr": [
      "Pour clore le Little Italy Festival, place aux artistes qui incarnent le lien vibrant entre la France et l'Italie. Sur scène, découvrez Mika, Alfa et Julien Lieb, pour une dernière soirée inoubliable !"
    ],
    "es": [
      "Para clausurar el Festival Little Italy, ha llegado la hora de los artistas que encarnan el vibrante vínculo entre Francia e Italia. Únase a Mika, Alfa y Julien Lieb en el escenario para disfrutar de una última velada inolvidable"
    ],
    "nl": [
      "Om het Little Italy Festival af te sluiten, is het tijd voor de artiesten die de levendige band tussen Frankrijk en Italië belichamen. Sluit je aan bij Mika, Alfa en Julien Lieb op het podium voor een laatste onvergetelijke avond!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Little Italy Festival - International pop concerts"
    ],
    "fr": [
      "Little Italy Festival - Soirée concerts Pop internationale"
    ]
  },
