  "rdfs:comment": {
    "de": [
      "Usson-en-Forez gehört zu den 3 Trail-Stationen des im Jahr 2020 gegründeten Trail-Raums Forez-Massiv. Erkunden Sie die vier 6, 8, 12 und 20 km langen Strecken, die am Wasser beginnen und durch Wald und Hügel führen."
    ],
    "en": [
      "Usson-en-Forez is one of the 3 trail-running centres in the Massif du Forez trail-running domain created in 2020. Come and explore the woods and hills on these 4 trails of 6, 8, 12 and 20km, starting at the lake."
    ],
    "it": [
      "Usson-en-Forez è una delle 3 stazioni del Massif du Forez Trail, creato nel 2020. Venite a scoprire questi 4 sentieri di 6, 8, 12 e 20 km partendo dal lago, attraverso boschi e colline."
    ],
    "fr": [
      "Usson-en-Forez fait partie des 3 stations de Trail de l'espace Trail Massif du Forez créée en 2020. Venez explorer ces 4 parcours de 6, 8, 12 et 20 km au départ du plan d'eau, à travers bois et collines."
    ],
    "nl": [
      "Usson-en-Forez is een van de 3 Trail resorts in het Massif du Forez Trail gebied, gecreëerd in 2020. Kom en verken deze 4 wandelroutes van 6, 8, 12 en 20 km vanaf het meer, door bossen en heuvels."
    ],
    "es": [
      "Usson-en-Forez es una de las 3 estaciones de Trail de la zona de Trail del Macizo del Forez, creada en 2020. Venga a explorar estos 4 senderos de 6, 8, 12 y 20 km que parten del lago, a través de bosques y colinas."
    ]
  },
  "rdfs:label": {
