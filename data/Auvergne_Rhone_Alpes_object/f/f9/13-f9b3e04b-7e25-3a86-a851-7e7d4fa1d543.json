  "rdfs:comment": {
    "de": [
      "La Loca, Ihr Multiaktivitätsraum ganz in Ihrer Nähe! Er befindet sich in Les Ors, in Romans Ouest.\r\n- 55m2 großer Raum, der Sport, Freizeit und Wellness gewidmet ist.\r\n- Büro/Kabinett von 16 m2, das à la carte gemietet werden kann\r\n\r\nKurse für Fitness, Wellness und +"
    ],
    "en": [
      "La Loca, your multi-activity room just a stone's throw away! Located in Les Ors, on Romans Ouest\r\n- 55m2 room dedicated to sports, leisure and well-being\r\n- 16 m2 office/cabinet to rent à la carte\r\n\r\nFitness, wellness and + classes"
    ],
    "it": [
      "Corsi di fitness (allenamento della forza per tutti i livelli, Zumba per adulti, ragazzi e bambini), eventi privati, lezioni su misura... Novità: angolo abbigliamento sportivo e accessori (leggings, reggiseni, magliette, giacche, borse sportive, ecc.)"
    ],
    "fr": [
      "Cours de fitness (Renforcement musculaire tous niveaux, Zumba Adultes, Ados, Enfants), animations événements privés, cours sur mesure... Nouveau : corner vêtements Sportswear et accessoires (leggings, brassières, t-shirts, vestes, sacs de sport...)"
    ],
    "nl": [
      "La Loca, uw multifunctionele ruimte op een steenworp afstand! Gelegen in Les Ors, op de Romans Ouest\r\n- 55 m2 zaal gewijd aan sport, ontspanning en welzijn\r\n- 16 m2 kantoor/kabinet te huur à la carte\r\n\r\nFitnesslessen, welzijn en meer"
    ],
    "es": [
      "Clases de fitness (entrenamiento de fuerza para todos los niveles, Zumba para adultos, adolescentes y niños), eventos privados, clases a medida... Nuevo: Rincón de ropa y accesorios deportivos (leggings, sujetadores, camisetas, chaquetas, bolsas de deporte, etc.)"
    ]
  },
