  "rdfs:comment": {
    "de": [
      "Ein freundlicher und farbenfroher Laden mit einer großen Auswahl an frischen Blumen, Trockenblumen, Pflanzen, Blumenarrangements und Dekorationsartikeln. Wir beraten Sie gerne und bereiten mit Ihnen die Blumenarrangements für Ihre Veranstaltungen vor."
    ],
    "en": [
      "A friendly and colorful store with a large choice of fresh flowers, dried flowers, plants, floral arrangements, decoration items. At your disposal to advise you and prepare with you the floral compositions for your events."
    ],
    "it": [
      "Un negozio accogliente e colorato con un'ampia scelta di fiori freschi, fiori secchi, piante, composizioni floreali e oggetti decorativi. Saremo lieti di consigliarvi e aiutarvi a preparare le composizioni floreali per i vostri eventi."
    ],
    "fr": [
      "Une boutique conviviale et colorée avec un large choix de fleurs fraîches,  fleurs séchées, plantes, compositions florales, articles de décoration. A votre écoute pour vous conseiller et préparer avec vous les compositions florales pour  vos évènements."
    ],
    "es": [
      "Una tienda acogedora y colorida con una amplia selección de flores frescas, flores secas, plantas, arreglos florales y artículos de decoración. Estaremos encantados de asesorarle y ayudarle a preparar sus arreglos florales para sus eventos."
    ],
    "nl": [
      "Een vriendelijke en kleurrijke winkel met een ruime keuze aan verse bloemen, droogbloemen, planten, bloemstukken en decoratieve artikelen. Wij geven u graag advies en helpen u bij de voorbereiding van uw bloemstukken voor uw evenementen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atelier Floral"
    ]
  },
