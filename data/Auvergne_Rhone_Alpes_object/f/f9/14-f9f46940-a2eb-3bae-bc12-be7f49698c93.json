  "rdfs:comment": {
    "de": [
      "Im Rahmen von Polar Lens macht das Festival Series mania erneut in Lens Station und zeigt die Episoden der neuen Serie Syndrome E, die auf dem gleichnamigen Bestseller von Franck Thilliez basiert."
    ],
    "en": [
      "As part of Polar Lens, the Series mania festival is once again stopping over in Lens with the screening of episodes of the new series Syndrome E, based on the best-seller of the same name by Franck Thilliez."
    ],
    "it": [
      "Nell'ambito di Polar Lens, il festival Series mania fa nuovamente tappa a Lens per proiettare gli episodi della nuova serie Syndrome E, tratta dall'omonimo bestseller di Franck Thilliez."
    ],
    "fr": [
      "Dans le cadre de Polar Lens le festival Series mania fait de nouveau escale à Lens avec la projection des épisodes de la nouvelle série Syndrome E tirée du best-seller éponyme de Franck Thilliez."
    ],
    "nl": [
      "In het kader van Polar Lens stopt het Series mania festival opnieuw in Lens om afleveringen te vertonen van de nieuwe serie Syndrome E, gebaseerd op de gelijknamige bestseller van Franck Thilliez."
    ],
    "es": [
      "En el marco de Polar Lens, el festival Series mania vuelve a hacer escala en Lens para proyectar episodios de la nueva serie de Síndrome E, basada en el bestseller homónimo de Franck Thilliez."
    ]
  },
