  "rdfs:comment": {
    "de": [
      "Le Mazot ? Neues savoyisches Restaurant in La Rosière. Genießen Sie Fondues, Raclettes, Tartiflettes und Zwiebelsuppe in einer warmen und freundlichen Atmosphäre. Nur abends geöffnet für einen Gourmetmoment in den Bergen."
    ],
    "en": [
      "Le Mazot – New Savoyard restaurant in La Rosière. Come and enjoy fondues, raclettes, tartiflettes and onion soups in a warm and friendly atmosphere, open only in the evening for a gourmet experience in the mountains."
    ],
    "it": [
      "Le Mazot – Nuovo ristorante savoiardo a La Rosière. Venite a gustare fondute, raclette, tartiflette e zuppe di cipolle in un'atmosfera calda e conviviale, aperto solo la sera per un momento gourmet in montagna."
    ],
    "fr": [
      "Le Mazot – Nouveau restaurant savoyard à La Rosière. Venez savourer fondues, raclettes, tartiflettes et soupes à l’oignon dans une ambiance chaleureuse et conviviale, ouvert uniquement le soir pour un moment gourmand en montagne."
    ],
    "es": [
      "Le Mazot ? Nuevo restaurante saboyano en La Rosière. Venga a degustar fondues, raclettes, tartiflettes y sopas de cebolla en un ambiente cálido y acogedor, abierto sólo por la noche para vivir una experiencia gastronómica de montaña."
    ],
    "nl": [
      "Le Mazot ? Nieuw Savoyaards restaurant in La Rosière. Kom genieten van fondues, raclettes, tartiflettes en uiensoepen in een warme en vriendelijke sfeer, alleen 's avonds geopend voor een gastronomische bergervaring."
    ]
  },
