  "rdfs:comment": {
    "de": [
      "Die gemeindeübergreifende Bibliothek des Pays de Crussol, die mit Leidenschaft daran arbeitet, jedes Dorf zu beleben, indem sie den literarischen Reichtum erkundet, der dort lebt."
    ],
    "en": [
      "The inter-municipal library of Pays de Crussol, passionately working to enliven each village by exploring the literary treasures that reside within them."
    ],
    "it": [
      "La biblioteca intercomunale del Pays de Crussol lavora con passione per far vivere ogni villaggio esplorando la ricchezza letteraria che lo abita."
    ],
    "fr": [
      "La bibliothèque intercommunale du Pays de Crussol, œuvrant avec passion pour animer chaque village en explorant les richesses littéraires qui les habitent."
    ],
    "es": [
      "La biblioteca intermunicipal del Pays de Crussol, que trabaja con pasión para dar vida a cada pueblo explorando la riqueza literaria que lo habita."
    ],
    "nl": [
      "De intergemeentelijke bibliotheek van het Pays de Crussol werkt met passie om elk dorp tot leven te brengen door de literaire rijkdommen die erin huizen te verkennen."
    ]
  },
