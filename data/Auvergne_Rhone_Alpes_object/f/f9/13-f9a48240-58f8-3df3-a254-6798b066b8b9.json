  "rdfs:comment": {
    "de": [
      "Das Hotel Les Négociants empfängt Sie im Herzen von Valence, nur wenige Meter vom SNCF-Bahnhof Valence-Ville, dem Place Aristide Briand und dem Kiosk Peynet entfernt, der den Parc Jouvet dominiert."
    ],
    "en": [
      "The ‘les Négociants’ hotel welcomes you to the heart of Valence, a few metres from the  SNCF Valence-ville station, the place Aristide Briand and the Kiosque Peynet overlooking the Parc Jouvet."
    ],
    "it": [
      "L'Hotel Les Négociants vi accoglie nel cuore di Valence, a pochi metri dalla stazione ferroviaria di Valence-ville, da Place Aristide Briand e dal Kiosque Peynet con vista sul Parc Jouvet."
    ],
    "fr": [
      "L'hôtel les Négociants vous accueille au cœur de Valence, à quelques mètres de la gare SNCF Valence-ville, de la place Aristide Briand et du Kiosque Peynet dominant le Parc Jouvet."
    ],
    "nl": [
      "Hotel les Négociants verwelkomt u in het hart van Valence, op slechts een paar meter van het SNCF-treinstation Valence-ville, Place Aristide Briand en de Peynet Kiosk met uitzicht op Parc Jouvet."
    ],
    "es": [
      "El Hotel Les Négociants le da la bienvenida en el corazón de Valence, a pocos metros de la estación de tren de Valence-ville, la plaza Aristide Briand y el Kiosco Peynet con vistas al Parque Jouvet."
    ]
  },
