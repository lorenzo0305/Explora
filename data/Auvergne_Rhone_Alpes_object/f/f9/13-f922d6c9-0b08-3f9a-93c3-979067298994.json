  "rdfs:comment": {
    "de": [
      "Ein Pumptrack ist ein geschlossener Parcours mit einer Reihe von runden Buckeln und Steilkurven, die eventuell durch Sprünge aufgelockert werden. Sie können in jedem Alter mit BMX-Rädern, Mountainbikes, Rollern, Inlineskates oder Skateboards gefahren werden."
    ],
    "en": [
      "The Pump Track is a closed course with a succession of round bumps and banked turns, sometimes with jumps. It can be ridden at any age on a BMX, mountain bike, scooter, rollerblade or skateboard."
    ],
    "it": [
      "Il Pump Track è un percorso chiuso con una successione di dossi circolari e curve a gomito, talvolta con salti. Può essere percorso a qualsiasi età su BMX, mountain bike, monopattino, rollerblade o skateboard."
    ],
    "fr": [
      "Le Pump Track est un parcours fermé avec une succession de bosses rondes et virages relevés agrémenté éventuellement de sauts. On le pratique à tout âge, en BMX, VTT, trottinette, roller ou skateboard."
    ],
    "nl": [
      "Pump Track is een gesloten parcours met een opeenvolging van ronde bulten en schuine bochten, soms met sprongen. Het kan op elke leeftijd worden bereden op een BMX, mountainbike, step, skeeler of skateboard."
    ],
    "es": [
      "El Pump Track es un circuito cerrado con una sucesión de baches redondos y curvas peraltadas, a veces con saltos. Puede recorrerse a cualquier edad en BMX, bicicleta de montaña, patinete, patines o monopatín."
    ]
  },
