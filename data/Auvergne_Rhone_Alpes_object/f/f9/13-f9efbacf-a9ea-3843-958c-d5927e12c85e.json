  "rdfs:comment": {
    "de": [
      "Am Eingang des Dorfes befindet sich ein erster Picknickplatz mit Kinderspielgeräten.\r\nÜberdachter Tisch bei schlechtem Wetter. Platz zum Boulespielen. Start der Wanderrouten."
    ],
    "en": [
      "At the entrance to the village, a first picnic area with children's play area.\r\nTable under shelter in case of bad weather. Petanque court. Departure point for hiking trails."
    ],
    "it": [
      "All'ingresso del villaggio, un'area picnic con giochi per bambini.\r\nTavolo coperto in caso di maltempo. Campo da petanque. Punto di partenza per i sentieri escursionistici."
    ],
    "fr": [
      "A l'entrée du village, une première aire de pique-nique avec jeux enfants.\r\nTable sous abri en cas de mauvais temps. Terrain de pétanque. Départ des circuits de randonnée."
    ],
    "nl": [
      "Bij de ingang van het dorp is een picknickplaats met speeltuin.\r\nOverdekte tafel bij slecht weer. Petanquebaan. Vertrekpunt voor wandelroutes."
    ],
    "es": [
      "A la entrada del pueblo, merendero con zona de juegos para niños.\r\nMesa a cubierto en caso de mal tiempo. Campo de petanca. Punto de partida de rutas de senderismo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aires de pique-nique du Mas de Tence"
    ]
  },
