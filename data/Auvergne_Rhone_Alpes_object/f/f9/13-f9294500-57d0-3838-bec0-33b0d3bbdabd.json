  "rdfs:comment": {
    "de": [
      "Gilles, ein Canyoning-Führer, nimmt Sie mit auf die Entdeckung von Gebirgsbächen und Schluchten in einer faszinierenden und besonderen Umgebung. Eine unvergessliche und ungewöhnliche Reise in eine wilde Umgebung, in der Sie allein auf der Welt sein werden. Zugänglich ab 5 Jahren."
    ],
    "en": [
      "Gilles, a canyoning guide, will guide you to discover the mountain torrents and gorges in a fascinating and unique environment. An unforgettable and unexpected trip in a wild environment where you will be alone in the world."
    ],
    "it": [
      "Gilles, guida di canyoning, vi porterà a scoprire i torrenti e le gole di montagna in un ambiente affascinante e particolare. Un viaggio indimenticabile e insolito in una natura selvaggia dove sarete soli al mondo."
    ],
    "fr": [
      "Gilles, guide de canyonisme vous emmène à la découverte des torrents et des gorges de montagne dans un environnement fascinant et spécifique. Un voyage inoubliable et insolite dans une nature sauvage où vous serez seuls au monde."
    ],
    "es": [
      "Gilles, guía de barranquismo, le llevará a descubrir los torrentes y desfiladeros de la montaña en un entorno fascinante y específico. Un viaje inolvidable e insólito en una naturaleza salvaje donde estarás solo en el mundo."
    ],
    "nl": [
      "Gilles, een canyoninggids, neemt je mee op een ontdekkingstocht langs bergstromen en kloven in een fascinerende en bijzondere omgeving. Een onvergetelijke en ongewone tocht in een wildernis waar je alleen op de wereld bent."
    ]
  },
