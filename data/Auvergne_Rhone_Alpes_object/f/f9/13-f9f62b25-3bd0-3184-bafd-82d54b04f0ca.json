  "rdfs:comment": {
    "de": [
      "Angenehmer Spielplatz für Kinder von 2 bis 10 Jahren.\r\nRutschen, Schaukeln, Drehkreuz, Federspiele mit 2 Plätzen, Klettergerüst für Kinder von 2 bis 10 Jahren.\r\nKleiner schattiger Park in der Umgebung, Picknicktisch im Schatten, Wasserstelle, WC."
    ],
    "en": [
      "Pleasant playground for children aged 2 to 10\r\nSlides, swings, turnstile, 2-seater spring games, climbing structure for children aged 2 to 10.\r\nSmall shady park around, picnic table in the shade, water point, WC."
    ],
    "it": [
      "Piacevole area giochi per bambini dai 2 ai 10 anni\r\nScivoli, altalene, tornello, giochi a molla a 2 posti, struttura di arrampicata per bambini dai 2 ai 10 anni.\r\nPiccolo parco ombreggiato nelle vicinanze, tavolo da picnic all'ombra, punto acqua, WC."
    ],
    "fr": [
      "Agréable aire de jeux pour les enfants de 2 à 10ans \r\nToboggans, balançoires, tourniquet, jeux à ressort à 2 places, structure d'escalade pour les enfants de 2 à 10 ans.\r\nPetit parc ombragé aux abords, table de pique-nique à l'ombre, point d'eau, WC."
    ],
    "es": [
      "Agradable zona de juegos para niños de 2 a 10 años\r\nToboganes, columpios, torniquete, juegos de muelle de 2 plazas, estructura de escalada para niños de 2 a 10 años.\r\nPequeño parque sombreado cercano, mesa de picnic a la sombra, punto de agua, WC."
    ],
    "nl": [
      "Aangename speeltuin voor kinderen van 2 tot 10 jaar\r\nGlijbanen, schommels, tourniquet, 2-persoons lentespellen, klimstructuur voor kinderen van 2 tot 10 jaar.\r\nKlein schaduwrijk park in de buurt, picknicktafel in de schaduw, watertappunt, WC."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de Jeux pour Enfants - Allex"
    ]
  },
