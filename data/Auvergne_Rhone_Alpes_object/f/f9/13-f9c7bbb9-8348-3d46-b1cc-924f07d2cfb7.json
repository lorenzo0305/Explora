  "rdfs:comment": {
    "de": [
      "Patronatsfest in Félines mit einem Pétanque-Wettbewerb am Samstagnachmittag, gefolgt von einem Essen des Komitees, Feuerwerk, Musette- und Jugendbällen am Abend und am Sonntag: Essen der Schulen, Kinderanimation, Umzug mit Blumenwagen und Show..."
    ],
    "en": [
      "Félines patron saint's day with a pétanque competition on Saturday afternoon followed by a committee meal, fireworks, musette and youth dances in the evening and on Sunday: school meal, children's entertainment, flower float parade and show..."
    ],
    "it": [
      "Festa patronale di Félines con gara di bocce il sabato pomeriggio seguita da un pasto del comitato, fuochi d'artificio, musette e balli giovanili la sera e la domenica: pasto scolastico, animazione per bambini, sfilata di carri floreali e spettacolo..."
    ],
    "fr": [
      "Fête patronale de Félines avec un concours de pétanque le samedi après-midi suivi d'un repas du comité, des feux d'artifice, bals musette et jeunes en soirée et le dimanche : repas des écoles, animations enfants, défilé de chars fleuris et spectacle..."
    ],
    "nl": [
      "Patroonsfeest van Félines met een petanquewedstrijd op zaterdagmiddag gevolgd door een maaltijd van het comité, vuurwerk, musette en jeugddansen 's avonds en op zondag: schoolmaaltijd, kinderanimatie, optocht van bloemenpraalwagens en show..."
    ],
    "es": [
      "Fiestas patronales de Félines con un concurso de petanca el sábado por la tarde seguido de una comida de la comisión, fuegos artificiales, musette y bailes juveniles por la noche y el domingo: comida escolar, animación infantil, desfile de carrozas florales y espectáculo..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête patronale"
    ]
  },
