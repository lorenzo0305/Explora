  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/df23802a-4020-3985-aad6-dff99f96e4ea",
      "dc:description": {
        "de": [
          "Der Running Club noyellois organisiert die 9. Ausgabe des Nachttrails von Noyelles-sous-Lens!\nDer Trail Nocturne de NOYELLES SOUS LENS ist der 9. des Trail de l'Artois Trail Challenge 2024. Die Strecke, die für den ATC ausgewählt wurde, ist 21 km lang."
        ],
        "en": [
          "The noyellois running club organizes the 9th edition of the trail nocturne de Noyelles-sous-Lens!\nThe Trail Nocturne de NOYELLES SOUS LENS is the 9th in the Trail de l'Artois Trail Challenge 2024. The course chosen for the ATC is the 21km."
        ],
        "it": [
          "Il club podistico noyellois organizza la 9ª edizione del Trail Nocturne de Noyelles-sous-Lens!\nIl Trail Nocturne de NOYELLES SOUS LENS è il 9° del Trail de l'Artois Trail Challenge 2024. Il percorso scelto per l'ATC è di 21 km."
        ],
        "fr": [
          "Le running club noyellois organise la 9ème édition du trail nocturne de Noyelles-sous-Lens !\nLe Trail Nocturne de NOYELLES SOUS LENS est le 9éme du Trail de l'Artois Trail Challenge 2024. Le parcours choisi pour l'ATC et le 21km."
        ],
        "es": [
          "El Club de Corredores de Noyellois organiza la 9ª edición del Trail Nocturne de Noyelles-sous-Lens\nEl Trail Nocturne de NOYELLES SOUS LENS es la 9ª edición del Trail de l'Artois Trail Challenge 2024. El recorrido elegido para el ATC es el de 21km."
        ],
        "nl": [
          "De noyellois running club organiseert de 9e editie van de Trail Nocturne de Noyelles-sous-Lens!\nDe Trail Nocturne de NOYELLES SOUS LENS is de 9e in de Trail de l'Artois Trail Challenge 2024. Het parcours dat gekozen is voor de ATC is de 21km."
        ]
      },
