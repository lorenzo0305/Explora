  "rdfs:comment": {
    "de": [
      "L'Archipel, Ihr Aqua-Center im Pays de L'Arbresle, liegt nur 20 km von Lyon entfernt! Dieser Komplex bietet eine große Auswahl an Wassersport-, Fitness- und Wellnessangeboten."
    ],
    "en": [
      "This hydro centre is devoted to the pleasure of water, relaxation and fitness, in summer as in winter. It has indoor and outdoor pools with slides and wide raft slide, a playground, picnic area and fitness centre (body building, sauna...)."
    ],
    "it": [
      "A soli 20 km da Lione, venite a scoprire L'Archipel, il vostro centro acquatico nel Pays de L'Arbresle! Questo complesso offre un'ampia gamma di servizi acquatici per il tempo libero, il fitness e il benessere."
    ],
    "fr": [
      "Situé à seulement 20 km de Lyon, venez découvrir L’Archipel, votre Aqua-Centre du Pays de L’Arbresle ! Ce complexe offre un large choix de prestations de loisirs aquatiques, de remise en forme et de bien-être."
    ],
    "es": [
      "Situado a sólo 20 km de Lyon, venga a descubrir L'Archipel, su Aqua-Centre en el Pays de L'Arbresle Este complejo ofrece una amplia gama de servicios de ocio acuático, fitness y bienestar."
    ],
    "nl": [
      "Kom op 20 km van Lyon L'Archipel ontdekken, uw Aqua-Centrum in het Pays de L'Arbresle! Dit complex biedt een breed scala aan diensten op het gebied van waterrecreatie, fitness en welzijn."
    ]
  },
  "rdfs:label": {
    "en": [
      "Grand Champ's swimming pool and hydro centre"
    ],
    "fr": [
      "L'Archipel, Aqua-Centre du Pays de L'Arbresle"
    ]
  },
