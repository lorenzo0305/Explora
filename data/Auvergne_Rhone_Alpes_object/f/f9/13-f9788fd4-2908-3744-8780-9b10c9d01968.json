  "rdfs:comment": {
    "de": [
      "Sportliche, kulturelle und künstlerische Aktivitäten und Veranstaltungen.\r\nDie Organisation soll einen Rahmen für Meinungsäußerung, Reflexion und Aktionen für alle Personen bilden, die sich für das Leben und die Gestaltung der Stadtviertel interessieren."
    ],
    "en": [
      "Sports, cultural and artistic activities and special events.\r\nProvide a forum for expression, reflection and action for all those interested in neighborhood life and development."
    ],
    "it": [
      "Attività sportive, culturali e artistiche ed eventi unici.\r\nFornire un forum di espressione, riflessione e azione per tutti coloro che sono interessati alla vita e allo sviluppo del quartiere."
    ],
    "fr": [
      "Animations sportives, culturelles, artistiques et manifestations ponctuelles.\r\nConstituer un cadre d ‘expression, de réflexion et d’actions pour toutes les personnes intéressées par la vie et l’aménagement des quartiers."
    ],
    "nl": [
      "Sport, culturele en artistieke activiteiten en speciale evenementen.\r\nEen forum bieden voor expressie, reflectie en actie voor iedereen die geïnteresseerd is in het leven en de ontwikkeling van de buurt."
    ],
    "es": [
      "Actividades deportivas, culturales, artísticas y eventos puntuales.\r\nOfrecer un foro de expresión, reflexión y acción a todos los interesados en la vida y el desarrollo del barrio."
    ]
  },
