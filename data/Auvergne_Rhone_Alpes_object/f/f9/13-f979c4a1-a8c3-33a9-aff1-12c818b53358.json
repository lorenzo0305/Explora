  "rdfs:comment": {
    "de": [
      "Am Fuße des Schlosses der Herzöge von Bourbon und am Rande der mittelalterlichen Stadt können Sie in einem denkmalgeschützten Gebäude aus dem Mittelalter mit gemütlicher Dekoration traditionelle Gerichte und Wurstplatten zum Teilen genießen."
    ],
    "en": [
      "At the foot of the castle of the Dukes of Bourbon and on the edge of the medieval city, you will enjoy traditional cuisine and boards of charcuterie to share, in a listed medieval monument with a Cosy decoration."
    ],
    "it": [
      "Ai piedi del castello dei Duchi di Borbone e ai margini della città medievale, potrete gustare una cucina tradizionale e taglieri di salumi da condividere, in un monumento del periodo medievale dall'arredamento accogliente."
    ],
    "fr": [
      "Au pied du château des Ducs de Bourbon et à l'orée de la cité médiévale, vous dégusterez une cuisine traditionnelle ainsi que des planches de charcuterie à partager, dans un monument classé d'époque médiévale à la décoration Cosy."
    ],
    "nl": [
      "Aan de voet van het kasteel van de hertogen van Bourbon en aan de rand van de middeleeuwse stad kunt u genieten van traditionele gerechten en vleeswarenplanken om te delen, in een geklasseerd monument uit de middeleeuwen met een gezellig decor."
    ],
    "es": [
      "A los pies del castillo de los duques de Borbón y en las afueras de la ciudad medieval, podrá disfrutar de una cocina tradicional y de tablas de embutidos para compartir, en un monumento catalogado de la época medieval con una decoración acogedora."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Nouvelle Auberge"
    ]
  },
