  "rdfs:comment": {
    "de": [
      "In diesem schönen Stadthaus aus dem 16. Jahrhundert finden sehr regelmäßig Kunstausstellungen statt. Es ist nur bei Sonderausstellungen für die Öffentlichkeit zugänglich."
    ],
    "en": [
      "This beautiful 16th-century urban mansion is a regular art venue, opening to the public only for temporary exhibitions."
    ],
    "it": [
      "Questa bella casa di città del XVI secolo ospita regolarmente mostre d'arte. È aperta al pubblico solo per le mostre temporanee."
    ],
    "fr": [
      "Cette belle demeure urbaine du XVIe siècle accueille très régulièrement des expositions artistiques. Elle n'est ouverte au public que lors d'expositions temporaires."
    ],
    "nl": [
      "In dit prachtige 16e-eeuwse herenhuis worden regelmatig kunsttentoonstellingen gehouden. Het is alleen open voor het publiek voor tijdelijke tentoonstellingen."
    ],
    "es": [
      "Esta hermosa casa urbana del siglo XVI acoge regularmente exposiciones de arte. Solo está abierta al público para exposiciones temporales."
    ]
