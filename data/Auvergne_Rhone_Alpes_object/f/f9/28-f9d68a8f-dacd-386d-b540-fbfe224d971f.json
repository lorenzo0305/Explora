  "rdfs:comment": {
    "de": [
      "Isabelle empfängt Sie in ihrem Fischgeschäft, in dem sie Ihnen Qualitätsprodukte anbietet: Meeresfrüchteplatten, Fisch aus lokalem Fang, Muscheln und Krustentiere, die vor Ort gekocht werden."
    ],
    "en": [
      "Isabelle welcomes you to her fishmonger's shop where she offers you quality products: seafood platters, locally caught fish, shellfish and crustaceans cooked on site."
    ],
    "it": [
      "Isabelle vi accoglie nella sua pescheria dove vi offre prodotti di qualità: piatti di pesce, pesce pescato localmente, molluschi e crostacei cucinati sul posto."
    ],
    "fr": [
      "Isabelle vous accueille dans sa poissonnerie dans laquelle elle vous propose des produits de qualité : plateaux de fruits de mer, poisson de pêche locale, coquillages et crustacés cuits sur place."
    ],
    "nl": [
      "Isabelle verwelkomt u in haar viswinkel waar ze u kwaliteitsproducten aanbiedt: schalen met zeevruchten, lokaal gevangen vis, schelp- en schaaldieren die ter plaatse worden bereid."
    ],
    "es": [
      "Isabelle le da la bienvenida a su pescadería, donde le ofrece productos de calidad: bandejas de marisco, pescados, mariscos y crustáceos capturados localmente y cocinados in situ."
    ]
  },
  "rdfs:label": {
