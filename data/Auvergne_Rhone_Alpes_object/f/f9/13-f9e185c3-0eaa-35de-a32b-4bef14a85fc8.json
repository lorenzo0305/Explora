  "rdfs:comment": {
    "de": [
      "Im historischen Viertel von Moulins gelegen, freuen sich David Rollin und sein Team darauf, Sie in diesem authentischen Haus im Bourbonnais-Stil zu empfangen. Der Chefkoch bietet eine moderne, traditionelle und saisonale Küche an."
    ],
    "en": [
      "Located in the historic district of Moulins, David Rollin and his team will be delighted to welcome you to this authentic Bourbonnaise house. The chef offers traditional, modern and seasonal cuisine."
    ],
    "it": [
      "Situato nel quartiere storico di Moulins, David Rollin e il suo team saranno lieti di accogliervi in questa autentica casa borgognona. Lo chef propone una cucina tradizionale, moderna e stagionale."
    ],
    "fr": [
      "Situé dans le quartier historique de Moulins, David Rollin et son équipe prendront plaisir à vous recevoir dans cette authentique maison bourbonnaise. Le chef propose une cuisine traditionnelle moderne et de saison."
    ],
    "es": [
      "Situado en el barrio histórico de Moulins, David Rollin y su equipo estarán encantados de recibirle en esta auténtica casa bourbonnaise. El chef propone una cocina tradicional, moderna y de temporada."
    ],
    "nl": [
      "David Rollin en zijn team verwelkomen je graag in dit authentieke Bourbonnaise huis, gelegen in de historische wijk van Moulins. De chef biedt traditionele, moderne en seizoensgebonden gerechten."
    ]
  },
  "rdfs:label": {
