  "rdfs:comment": {
    "de": [
      "Lassen Sie sich bei einem stärkenden Snack von Geschichten über vergessene Berge und lebendige Wälder mitreißen. Ein schwebender Moment im Haus des Leutnants."
    ],
    "en": [
      "Let yourself be carried away by stories of forgotten mountains and living forests over a comforting snack. A suspended moment at the Maison du Lieutenant."
    ],
    "it": [
      "Lasciatevi trasportare da storie di montagne dimenticate e foreste vive davanti a una merenda che scalda il cuore. Un momento sospeso nel tempo alla Maison du Lieutenant."
    ],
    "fr": [
      "Laissez-vous emporter par des histoires de montagnes oubliées et de forêts vivantes autour d’un goûter réconfortant. Un moment suspendu à la Maison du Lieutenant."
    ],
    "nl": [
      "Laat je meeslepen door verhalen over vergeten bergen en levende bossen onder het genot van een hartverwarmend hapje. Een moment in de tijd in het Maison du Lieutenant."
    ],
    "es": [
      "Déjese llevar por historias de montañas olvidadas y bosques vivos mientras degusta un tentempié reconfortante. Un momento suspendido en el tiempo en la Maison du Lieutenant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Contes et goûter : Récits de forêts vivantes et douceurs partagées"
    ]
  },
