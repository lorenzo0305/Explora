  "rdfs:comment": {
    "de": [
      "Eau2roche ist auf die Betreuung von vertikalen Aktivitäten spezialisiert und hat seinen Sitz in Villard de Lans. Wir organisieren betreute Ausflüge in Canyoning, Klettern und Klettersteige."
    ],
    "en": [
      "Eau2roche specializes in supervised vertical activities based in Villard de Lans. We organize supervised canyoning, climbing and via corda outings."
    ],
    "it": [
      "Eau2roche è specializzata in attività verticali supervisionate con sede a Villard de Lans. Organizziamo uscite supervisionate di canyoning, arrampicata e via corda."
    ],
    "fr": [
      "Eau2roche est spécialisé dans l’encadrement d’activités verticales basée sur Villard de Lans. Nous organisons des sorties encadrées en canyoning, escalade et via corda ."
    ],
    "nl": [
      "Eau2roche is gespecialiseerd in verticale activiteiten onder begeleiding in Villard de Lans. We organiseren canyoning, klimmen en via corda tochten onder begeleiding."
    ],
    "es": [
      "Eau2roche es una empresa especializada en actividades verticales supervisadas con sede en Villard de Lans. Organizamos salidas supervisadas de barranquismo, escalada y vía corda."
    ]
  },
