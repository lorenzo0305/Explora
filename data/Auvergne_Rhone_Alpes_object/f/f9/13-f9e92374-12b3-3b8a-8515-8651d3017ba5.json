  "rdfs:comment": {
    "de": [
      "Dorothée Aschehoug und Albéric Colas, die aus dem Institut Paul Bocuse hervorgegangen sind, empfangen Sie in einem schlichten und hellen Rahmen und bieten Ihnen eine einfache, aber einfallsreiche Küche mit frischen Produkten der Saison."
    ],
    "en": [
      "Dorothée Aschehoug and Albéric Colas, from the Paul Bocuse Institute, welcome you in a sober and luminous setting by offering you a simple but inventive cuisine with fresh seasonal products."
    ],
    "it": [
      "Dorothée Aschehoug e Albéric Colas, diplomati all'Istituto Paul Bocuse, vi accolgono in un ambiente sobrio e luminoso e vi propongono una cucina semplice ma inventiva con prodotti freschi di stagione."
    ],
    "fr": [
      "Dorothée Aschehoug et Albéric Colas, issus de l'Institut Paul Bocuse, vous accueillent dans un cadre sobre et lumineux en vous proposant une cuisine simple mais inventive avec des produits frais de saison."
    ],
    "es": [
      "Dorothée Aschehoug y Albéric Colas, diplomados del Instituto Paul Bocuse, le dan la bienvenida en un ambiente sobrio y luminoso y le ofrecen una cocina sencilla pero inventiva con productos frescos de temporada."
    ],
    "nl": [
      "Dorothée Aschehoug en Albéric Colas, afgestudeerden van het Paul Bocuse Instituut, verwelkomen u in een sober en lichtgevend kader en bieden u een eenvoudige maar inventieve keuken met verse seizoensproducten."
    ]
  },
