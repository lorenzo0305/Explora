  "rdfs:comment": {
    "de": [
      "Begleitung der Elternschaft, Betreuung von Kindern im Alter von 0 bis 11 Jahren durch eine Kinderkrankenschwester, die beruflich mit Gesundheit und Kleinkindern zu tun hat.\r\nAtelier d'éveil, in Gruppen oder einzeln."
    ],
    "en": [
      "Parenthood support, followed by children aged 0 to 11 by a professional childcare nurse in health and early childhood.\r\nAwareness workshop, in groups or individually."
    ],
    "it": [
      "Sostegno alla genitorialità, monitoraggio dei bambini da 0 a 11 anni da parte di un'infermiera, un professionista della salute e della prima infanzia.\r\nLaboratori di apprendimento precoce, in gruppo o individualmente."
    ],
    "fr": [
      "Accompagnement à la parentalité, suivi des enfants de 0 à 11 ans par une Infirmière puéricultrice professionnelle de la santé et de la petite enfance.\r\nAtelier d'éveil, en collectif ou en individuel."
    ],
    "nl": [
      "Opvoedingsondersteuning, opvolging van kinderen van 0 tot 11 jaar door een professionele gezondheids- en vroegkinderlijke verpleegkundige.\r\nBewustwordingsworkshop, in groepen of individueel."
    ],
    "es": [
      "Apoyo a la paternidad, seguimiento de los niños de 0 a 11 años por parte de una enfermera de guardería, un profesional de la salud y de la primera infancia.\r\nTalleres de aprendizaje temprano, en grupo o individualmente."
    ]
  },
