  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Museum.\r\nDas Museum widmet sich der Buchillustration und hat es sich zur Aufgabe gemacht, eine Sammlung repräsentativer Originalwerke aus der Geschichte der Jugendillustration vom 19."
    ],
    "en": [
      "Free admission.\r\nDedicated to book illustration, the museum's mission is to build up a collection of original works representative of the history of children's illustration from the 19th century to the present day."
    ],
    "it": [
      "Ingresso gratuito.\r\nDedicato all'illustrazione del libro, il museo si propone di costituire una collezione di opere originali rappresentative della storia dell'illustrazione per l'infanzia dal XIX secolo a oggi."
    ],
    "fr": [
      "Visite libre. \r\nConsacré à l'illustration du livre, le musée a pour mission de constituer une collection d’œuvres originales représentatives de l'histoire de l'illustration jeunesse du XIXe siècle à nos jours."
    ],
    "nl": [
      "Gratis toegang.\r\nDe missie van het museum, gewijd aan boekillustratie, is het opbouwen van een verzameling originele werken die representatief zijn voor de geschiedenis van de kinderillustratie van de 19e eeuw tot nu."
    ],
    "es": [
      "Entrada gratuita.\r\nDedicado a la ilustración de libros, la misión del museo es constituir una colección de obras originales representativas de la historia de la ilustración infantil desde el siglo XIX hasta nuestros días."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée de l'illustration jeunesse"
    ]
  },
