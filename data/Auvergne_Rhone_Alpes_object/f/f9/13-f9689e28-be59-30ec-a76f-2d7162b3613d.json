  "rdfs:comment": {
    "de": [
      "Pumptrack-Parcours, bestehend aus Buckeln und Steilkurven, auf denen man sich bewegt, indem man die Formen ausnutzt, um an Geschwindigkeit zu gewinnen (durch Pumpen)."
    ],
    "en": [
      "Pumptrack course, made up of bumps and raised bends on which one evolves by exploiting the shapes to gain speed (by pumping)."
    ],
    "it": [
      "Percorso Pumptrack, composto da dossi e curve su cui ci si evolve sfruttando le forme per guadagnare velocità (pompando)."
    ],
    "fr": [
      "Parours Pumptrack, composé de bosses et virages relevés sur lequel on évolue en exploitant les formes pour prendre de la vitesse (en pompant)."
    ],
    "es": [
      "Recorrido de Pumptrack, formado por baches y curvas en los que se evoluciona aprovechando las formas para ganar velocidad (bombeando)."
    ],
    "nl": [
      "Pumptrack parcours, bestaande uit hobbels en bochten waarop men evolueert door gebruik te maken van de vormen om snelheid te winnen (door te pompen)."
    ]
  },
