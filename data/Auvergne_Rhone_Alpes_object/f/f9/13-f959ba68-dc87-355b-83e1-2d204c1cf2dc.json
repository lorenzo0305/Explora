  "rdfs:comment": {
    "de": [
      "Kulturerbe unseres Tals: Ausstellung alter Gegenstände, Trachten aus der Region, Rekonstruktionen alter Wohnräume und eines Klassenzimmers, temporäre Ausstellung. Freier Eintritt."
    ],
    "en": [
      "Examples of our valley’s heritage: objects from the past, local traditional dress, reconstruction of old fashioned home and class room, temporary exhibition."
    ],
    "it": [
      "Museo dedicato al patrimonio della valle. Esposizione di oggetti antichi, costumi tradizionali, ricostituzioni dell'antico habitat e di un'aula scolastica, esposizione temporanea."
    ],
    "fr": [
      "Patrimoine de notre vallée : exposition d'objets anciens, costumes du pays, reconstitutions de l'habitat ancien et d'une salle de classe, exposition temporaire. Entrée libre."
    ],
    "es": [
      "Patrimonio de nuestro valle: exposición de objetos antiguos, trajes locales, reconstrucciones del antiguo hábitat y un aula, exposición temporal. La entrada es gratuita."
    ],
    "nl": [
      "Erfgoed van onze vallei : tentoonstelling van oude voorwerpen, plaatselijke klederdracht, reconstructies van de oude habitat en een klaslokaal, tijdelijke tentoonstelling. Gratis toegang."
    ]
  },
