  "rdfs:comment": {
    "de": [
      "Auf der A 75 bietet der Rastplatz Garabit einen einzigartigen Blick auf das Viadukt von Gustave Eiffel. Entdecken Sie hier die regionalen Produkte, die Sie vor Ort verzehren oder mitnehmen können."
    ],
    "en": [
      "On the A75, the Garabit rest area offers a unique panorama of the Gustave Eiffel viaduct. Come and discover local products to eat in or take away."
    ],
    "it": [
      "Sulla A75, l'area di sosta Garabit offre una vista panoramica unica sul viadotto Gustave Eiffel. Venite a scoprire i prodotti locali da mangiare o da portare via."
    ],
    "fr": [
      "Sur l’A 75, l’aire de repos de Garabit offre un panorama unique sur le viaduc de Gustave Eiffel. Venez y découvrir les produits du terroir à consommer sur place ou à emporter."
    ],
    "nl": [
      "Op de A75 biedt de rustplaats Garabit een uniek panoramisch uitzicht op het viaduct Gustave Eiffel. Kom en ontdek de lokale producten die beschikbaar zijn om te eten of mee te nemen."
    ],
    "es": [
      "En la A75, el área de descanso de Garabit ofrece una vista panorámica única del viaducto Gustave Eiffel. Venga a descubrir los productos locales disponibles para comer en el restaurante o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maison du Cantal"
    ]
  },
