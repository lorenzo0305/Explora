  "rdfs:comment": {
    "de": [
      "Das Bistr'eau d'Odon von Lucie Fournier ist in einem Fachwerkgebäude untergebracht und empfängt Feinschmecker, die in dieser touristischen Region zu Besuch sind, ebenso wie Einheimische mit einer traditionellen, im Holzofen zubereiteten Küche."
    ],
    "en": [
      "Installed in a half-timbered building, Lucie Fournier's Bistr'eau d'Odon welcomes gourmets passing through this tourist region, as do the locals with their traditional cuisine, cooked over a wood fire."
    ],
    "it": [
      "Ospitato in un edificio a graticcio, il Bistr'eau d'Odon di Lucie Fournier accoglie i buongustai di passaggio in questa regione turistica e gli abitanti del luogo con una cucina tradizionale cucinata sul fuoco a legna."
    ],
    "fr": [
      "Installé dans une bâtisse à pans de bois, le Bistr'eau d'Odon de Lucie Fournier accueille les gourmets de passage dans cette région touristique, comme les locaux avec une cuisine traditionnelle, cuite au feu de bois."
    ],
    "es": [
      "Ubicado en un edificio con entramado de madera, el Bistr'eau d'Odon de Lucie Fournier acoge a los gastrónomos de paso por esta región turística, así como a los locales, con una cocina tradicional cocinada a fuego de leña."
    ],
    "nl": [
      "De Bistr'eau d'Odon van Lucie Fournier, gevestigd in een vakwerkgebouw, verwelkomt zowel de fijnproevers in deze toeristische regio als de plaatselijke bevolking met traditionele gerechten die op houtvuur worden bereid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistr'eau d'Odon"
    ]
  },
