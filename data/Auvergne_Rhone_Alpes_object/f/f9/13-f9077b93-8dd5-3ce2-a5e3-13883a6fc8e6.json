  "rdfs:comment": {
    "de": [
      "Der Verein Une rose un espoir, der aus Motorradfahrern besteht, bietet Rosen gegen eine Spende an (mindestens 2? für eine Rose). Der gesammelte Betrag wird an die Krebsliga Loire gespendet.\r\nDie Tour führt durch 23 Gemeinden des Departements Loire."
    ],
    "en": [
      "The association Une rose un espoir, made up of motorcyclists, is offering roses in exchange for a donation (minimum 2? for a rose), with the proceeds going to La Ligue contre le cancer comité Loire.\r\nPassage through 23 communes in the Loire."
    ],
    "it": [
      "L'associazione Une rose un espoir, composta da motociclisti, offre rose in cambio di una donazione (minimo 2? per una rosa), il cui ricavato andrà a La Ligue contre le cancer comité Loire.\r\nL'evento attraversa 23 città della Loira."
    ],
    "fr": [
      "L'association Une rose un espoir composée de motards propose des roses en échanges d'un don (minimum 2€ pour une rose).La somme récoltée est remise à La Ligue contre le cancer comité Loire.\r\nPassage par 23 communes de la Loire."
    ],
    "es": [
      "La asociación Une rose un espoir, formada por motociclistas, ofrece rosas a cambio de un donativo (mínimo 2? por una rosa), cuya recaudación se destinará a La Ligue contre le cancer comité Loire.\r\nEl evento pasa por 23 ciudades del Loira."
    ],
    "nl": [
      "De vereniging Une rose un espoir, bestaande uit motorrijders, biedt rozen aan in ruil voor een donatie (minimaal 2? voor een roos), waarvan de opbrengst naar La Ligue contre le cancer comité Loire gaat.\r\nHet evenement passeert 23 steden in de Loire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Une rose un espoir - Vente de roses par les motards"
    ]
  },
