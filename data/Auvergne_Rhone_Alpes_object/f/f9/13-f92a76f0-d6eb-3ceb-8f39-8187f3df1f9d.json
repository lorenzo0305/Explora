  "rdfs:comment": {
    "de": [
      "Für Petanque-Fans gibt es im Ort einen großen Bouleplatz am Place des Orgières mit herrlichem Blick auf die Meije sowie einen zweiten, eigens dafür vorgesehenen Platz am Place des Écrins."
    ],
    "en": [
      "There is a large petanque ground on the Place des Orgières square and a smaller one on the Place des Ecrins square.  Petanque tournaments are held during the summer season."
    ],
    "it": [
      "Per gli appassionati di pétanque, il resort dispone di un grande campo da bocce in Place des Orgières, con una magnifica vista sulla Meije, e di una seconda area dedicata in Place des Écrins."
    ],
    "fr": [
      "Pour les amateurs de pétanque, vous trouverez sur la station un grand terrain de boules place des Orgières avec vue magnifique sur la Meije, ainsi qu'un deuxième espace dédié place des Écrins."
    ],
    "es": [
      "Para los aficionados a la petanca, la estación cuenta con un gran campo de petanca en la Place des Orgières, con una magnífica vista del Meije, así como una segunda zona dedicada en la Place des Écrins."
    ],
    "nl": [
      "Groot terrein ter hoogte van de Place des Orgières (zand -en kiezelterrein) en kleiner terrein op de Place des Ecrins.  Officiële petanquetoernooien op 13 juli en 15 augustus georganiseerd door de jachtvereniging van Auris."
    ]
  },
  "rdfs:label": {
    "en": [
      "Petanque courts"
    ],
    "fr": [
      "Terrains de pétanque"
    ],
    "nl": [
      "Petanquebanen"
    ]
  },
