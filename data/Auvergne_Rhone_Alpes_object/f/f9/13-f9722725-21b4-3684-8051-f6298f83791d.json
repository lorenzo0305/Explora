  "rdfs:comment": {
    "de": [
      "In einem schlichten und diskreten Dekor, Bistro-Atmosphäre, um eine Küche mit frischen Produkten der Saison zu entdecken. zu einem sehr guten Preis-Leistungs-Verhältnis. Genießen Sie im Sommer die Terrasse."
    ],
    "en": [
      "In a sober and discreet decor, bistro atmosphere to discover a cuisine with fresh seasonal produce. at a very good value for money. Enjoy the terrace in the summer."
    ],
    "it": [
      "In un arredamento sobrio e discreto, un'atmosfera da bistrot per scoprire una cucina con prodotti freschi di stagione ad un ottimo rapporto qualità-prezzo. Godetevi la terrazza in estate."
    ],
    "fr": [
      "Dans un décor sobre et discret,  ambiance bistrot pour découvrir une cuisine avec des produits frais de saison. à un très bon rapport qualité-prix. Profitez de la terrasse l'été."
    ],
    "nl": [
      "In een sober en discreet decor, een bistrosfeer om een keuken te ontdekken met verse seizoensproducten tegen een zeer goede prijs-kwaliteitverhouding. Geniet van het terras in de zomer."
    ],
    "es": [
      "En una decoración sobria y discreta, un ambiente de bistró para descubrir una cocina con productos frescos de temporada a una muy buena relación calidad-precio. Disfruta de la terraza en verano."
    ]
  },
  "rdfs:label": {
