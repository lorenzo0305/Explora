  "rdfs:comment": {
    "de": [
      "Die Workshops von Kôdô Parfum werden von Gabriel Polère, einem passionierten Parfümeur, geleitet. In diesen Workshops lernen Sie die Pflanzenwelt kennen und hören auf die Düfte, entdecken Düfte und kreieren individuelle Naturparfums."
    ],
    "en": [
      "The Kôdô Parfum workshops are run by Gabriel Polère, a passionate artisan perfumer. These workshops offer an opportunity to discover the world of plants, listen to their fragrances and create your own personalised natural perfumes."
    ],
    "it": [
      "I laboratori Kôdô Parfum sono gestiti da Gabriel Polère, un appassionato profumiere artigianale. Questi laboratori offrono l'opportunità di scoprire il mondo delle piante, ascoltare le loro fragranze e creare profumi naturali personalizzati."
    ],
    "fr": [
      "Les ateliers de Kôdô Parfum sont animés par Gabriel Polère, artisan parfumeur passionné. Ces ateliers proposent de rencontrer le monde végétal, à l'écoute des fragrances; découverte des senteurs, création de parfums naturels personnalisés."
    ],
    "es": [
      "Los talleres Kôdô Parfum están dirigidos por Gabriel Polère, un perfumista artesano apasionado. Estos talleres ofrecen la oportunidad de descubrir el mundo de las plantas, escuchar sus fragancias y crear sus propios perfumes naturales personalizados."
    ],
    "nl": [
      "De Kôdô Parfum workshops worden geleid door Gabriel Polère, een gepassioneerde ambachtelijke parfumeur. Deze workshops bieden de mogelijkheid om de wereld van planten te ontdekken, naar hun geuren te luisteren en je eigen persoonlijke natuurlijke parfum te creëren."
    ]
  },
