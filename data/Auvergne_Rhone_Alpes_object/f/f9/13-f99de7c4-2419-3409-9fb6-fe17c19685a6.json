  "rdfs:comment": {
    "de": [
      "Das Hotel Akoya liegt im Herzen von Valmorel und lädt Sie ein, eine luxuriöse Umgebung zu entdecken, in der sich umweltfreundliche Architektur und authentisches Design harmonisch miteinander verbinden."
    ],
    "en": [
      "Nestling in the heart of Valmorel, the Hôtel Akoya invites you to discover a luxurious setting where environmentally-friendly architecture and authentic design blend harmoniously."
    ],
    "it": [
      "Situato nel cuore di Valmorel, l'Hôtel Akoya vi invita a scoprire un ambiente lussuoso in cui architettura ecologica e design autentico si fondono armoniosamente."
    ],
    "fr": [
      "Niché au cœur de Valmorel, l’Hôtel Akoya vous invite à découvrir un cadre luxueux où se marient harmonieusement une architecture respectueuse de l’environnement et un design authentique."
    ],
    "nl": [
      "Hôtel Akoya ligt in het hart van Valmorel en nodigt je uit om een luxe omgeving te ontdekken waar milieuvriendelijke architectuur en authentiek design harmonieus samengaan."
    ],
    "es": [
      "Enclavado en el corazón de Valmorel, el Hôtel Akoya le invita a descubrir un entorno de lujo donde la arquitectura respetuosa con el medio ambiente y el diseño auténtico se funden armoniosamente."
    ]
  },
