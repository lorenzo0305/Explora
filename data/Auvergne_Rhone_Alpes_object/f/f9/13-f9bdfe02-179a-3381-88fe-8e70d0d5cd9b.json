  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie am See von Aiguebelette auf der Basis von Sougey und der Freizeitanlage Port d'Aiguebelette für einen erfrischenden Moment der Entspannung."
    ],
    "en": [
      "We welcome you to Lake Aiguebelette, at the Sougey base and the Port d'Aiguebelette leisure center, for a refreshing moment of relaxation."
    ],
    "it": [
      "Vi diamo il benvenuto sul lago di Aiguebelette presso la base di Sougey e il centro ricreativo Port d'Aiguebelette, per un rinfrescante momento di relax."
    ],
    "fr": [
      "Nous vous accueillons au lac d'Aiguebelette sur la base du Sougey et la base de loisirs du Port d'Aiguebelette, pour un moment de détente rafraîchissant."
    ],
    "nl": [
      "We heten je welkom op het meer van Aiguebelette bij de vertrekhaven Sougey en het recreatiecentrum Port d'Aiguebelette, voor een verfrissend moment van ontspanning."
    ],
    "es": [
      "Le damos la bienvenida al lago de Aiguebelette, en la base de Sougey y en el centro de ocio Port d'Aiguebelette, para que disfrute de un refrescante momento de relajación."
    ]
  },
