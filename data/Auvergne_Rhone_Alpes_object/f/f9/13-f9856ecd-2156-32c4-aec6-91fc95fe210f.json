  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten empfängt Sie \"L'Orée des Pistes\" jeden Tag ab 8 Uhr: Frühstück, Brasserie, Snacks, festliche After-Ski-Partys? Ab 19 Uhr, von Sonntag bis Freitag, finden Sie eine Abendkarte für Feinschmecker in einer herzlichen und geselligen Atmosphäre!"
    ],
    "en": [
      "At the foot of the slopes, L’Orée des Pistes welcomes you every day from 8 a.m.: breakfast, brasserie, snacks, festive après-ski… From 7 p.m., Sunday to Friday, enjoy a delicious dinner menu in a warm and friendly atmosphere!"
    ],
    "it": [
      "Ai piedi delle piste, L’Orée des Pistes vi accoglie tutti i giorni dalle 8: colazione, brasserie, snack, après-ski festoso… Dalle 19, dalla domenica al venerdì, scoprite un menù serale goloso in un’atmosfera calda e conviviale!"
    ],
    "fr": [
      "Au pied des pistes, « L’Orée des Pistes » vous accueille tous les jours dès 8h : petit-déjeuner, brasserie, snacking, after ski festif… Dès 19h, du dimanche au vendredi, retrouvez une carte du soir gourmande dans une ambiance chaleureuse et conviviale !"
    ],
    "nl": [
      "Aan de voet van de pistes verwelkomt \"L'Orée des Pistes\" je elke dag vanaf 8u: ontbijt, brasserie, snacking, feestelijke après-ski? Van 19u, zondag tot vrijdag, kunt u genieten van een gastronomisch avondmenu in een warme en gezellige sfeer!"
    ],
    "es": [
      "A pie de pistas, \"L'Orée des Pistes\" le da la bienvenida todos los días a partir de las 8 de la mañana: desayuno, brasserie, picoteo, after-ski festivo.. De domingo a viernes, a partir de las 19:00, disfrute de un menú gastronómico en un ambiente cálido y acogedor"
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Orée des pistes Restaurant"
    ],
    "it": [
      "Ristorante L'Orée des pistes"
    ],
