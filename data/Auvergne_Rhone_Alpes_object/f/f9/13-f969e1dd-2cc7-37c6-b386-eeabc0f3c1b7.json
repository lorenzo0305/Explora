  "rdfs:comment": {
    "de": [
      "Die Ziegenfarm befindet sich ganz in der Nähe des Weilers Le Bard und beherbergt etwa 70 Ziegen, die in der Umgebung weiden.\r\nAus ihrer Milch stellen wir vor Ort verschiedene Arten von Bio-Rohmilchkäse und Joghurt her."
    ],
    "en": [
      "Located in the hamlet of Le Bard, the goat farm is home to around 70 goats that graze in the surrounding area.\r\nWe use their milk to make a range of organic raw-milk cheeses and yoghurts."
    ],
    "it": [
      "Situato nella frazione di Le Bard, l'allevamento di capre ospita circa 70 capre che pascolano nell'area circostante.\r\nCon il loro latte produciamo una serie di formaggi e yogurt biologici a latte crudo."
    ],
    "fr": [
      "Située tout au hameau du Bard, la chèvrerie abrite environ 70 chèvres qui pâturent dans les environs. \r\nGrâce à leur lait, nous fabriquons sur place différents types de fromages Bio au lait cru et yaourts."
    ],
    "es": [
      "Situada en la aldea de Le Bard, la granja cuenta con unas 70 cabras que pastan en los alrededores.\r\nCon su leche elaboramos quesos y yogures ecológicos de leche cruda."
    ],
    "nl": [
      "De geitenboerderij ligt in het gehucht Le Bard en telt ongeveer 70 geiten die in de omgeving grazen.\r\nWe gebruiken hun melk om een reeks biologische rauwmelkse kazen en yoghurts te maken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Chèvrerie du Bard"
    ]
  },
