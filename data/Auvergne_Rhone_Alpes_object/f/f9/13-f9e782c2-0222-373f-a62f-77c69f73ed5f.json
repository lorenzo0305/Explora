  "rdfs:comment": {
    "de": [
      "Das Beaulieu, eine Liebesgeschichte zwischen einem Koch und einer Konditorin, ist ein Feinschmecker-Bistro, das auf einer marktfrischen Küche und saisonalen Produkten basiert."
    ],
    "en": [
      "The Beaulieu, a love story between a chef and a pastry chef – is a gourmet bistro based on local seasonal products."
    ],
    "it": [
      "Le Beaulieu, una storia d'amore tra uno chef e un pasticcere, è un bistrot gourmet basato sulla cucina di mercato e sui prodotti di stagione."
    ],
    "fr": [
      "Le Beaulieu, histoire d'amour entre un cuisinier et une pâtissière, est un bistrot gourmand basé sur une cuisine du marché et des produits de saison."
    ],
    "es": [
      "Le Beaulieu, una historia de amor entre un chef y una pastelera, es un bistró gastronómico basado en la cocina de mercado y los productos de temporada."
    ],
    "nl": [
      "Le Beaulieu, een liefdesverhaal tussen een chef-kok en een patissier, is een gastronomische bistro gebaseerd op de marktkeuken en seizoensproducten."
