  "rdfs:comment": {
    "de": [
      "Fotografin Ihrer Erinnerungen und kostbaren Augenblicke! Hochzeit, Schwangerschaft, Geburt (im Posing ausgebildet), Kinder, Familie... Ich begrüße Sie in einem Cocooning-Studio in der Gemeinde Huriel 1a rue du pressoir im Departement 03 Allier, 10 km von Montluçon entfernt."
    ],
    "en": [
      "A photographer for your memories and precious moments! Wedding, pregnancy, birth (trained in posing), children, family... I welcome you to my cocooning studio in Huriel 1a rue du pressoir, 03 Allier, 10 km from Montluçon."
    ],
    "it": [
      "Il fotografo dei vostri ricordi e momenti preziosi! Matrimoni, gravidanze, nascite (con formazione in posa), bambini, famiglie... Vi accolgo nel mio studio di Huriel, 1a rue du pressoir, nel dipartimento 03 Allier, a 10 km da Montluçon."
    ],
    "fr": [
      "Photographe de vos souvenirs et de vos instants précieux ! Mariage, grossesse, naissance (formée au posing), enfant, famille... Je vous accueille dans un studio cocooning sur la commune d'Huriel 1a rue du pressoir dans le 03 Allier à 10 km de Montluçon."
    ],
    "es": [
      "¡Fotografiar sus recuerdos y momentos preciosos! Bodas, embarazos, partos (con formación en posado), niños, familias... Le doy la bienvenida a mi estudio cocooning en Huriel 1a rue du pressoir en el 03 departamento de Allier, a 10 km de Montluçon."
    ],
    "nl": [
      "De fotograaf van jouw herinneringen en dierbare momenten! Bruiloften, zwangerschappen, geboortes (getraind in poseren), kinderen, families... Ik heet u welkom in mijn cocooning studio in Huriel 1a rue du pressoir in het departement 03 Allier, op 10 km van Montluçon."
    ]
  },
