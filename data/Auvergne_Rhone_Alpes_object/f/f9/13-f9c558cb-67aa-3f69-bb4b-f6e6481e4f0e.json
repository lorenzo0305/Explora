  "rdfs:comment": {
    "de": [
      "Im Herzen einer geschützten Natur empfängt Sie die Domaine du Cros d'Auzon für einen Urlaub nach Ihrem Geschmack. Es stehen Ihnen verschiedene Unterkunftsmöglichkeiten in Hotels oder Hotelpavillons zur Verfügung. Sie profitieren von den 26 Hektar Land am Ufer der Ardèche."
    ],
    "en": [
      "In the heart of unspoilt countryside, the Domaine du Cros d'Auzon welcomes you for a vacation to suit your taste. We offer a range of hotel and lodge accommodation options. You'll enjoy 26 hectares on the banks of the Ardèche river"
    ],
    "it": [
      "Nel cuore di una natura preservata, il dominio di Cros d'Auzon vi accoglie per vacanze di vostro gusto. Sono disponibili diverse opzioni di alloggio in hotel e lodge. Potrete usufruire di 26 ettari ai margini dell'Ardèche"
    ],
    "fr": [
      "Au cœur d'une nature préservée, le domaine du Cros d'Auzon vous accueille pour des vacances à votre gout. Différentes possibilités d'hébergement en hôtel ou pavillon hôtelier vous sont proposées. Vous bénéficierez des 26 hectares en bordure de l'Ardèche"
    ],
    "nl": [
      "In het hart van de ongerepte natuur verwelkomt het landgoed Cros d'Auzon u voor een vakantie naar wens. Er zijn verschillende accommodatiemogelijkheden in het hotel of kleine huisjes beschikbaar. U profiteert van de 26 hectaren aan de oever van de rivier Ardèche."
    ],
    "es": [
      "En el corazón de una naturaleza preservada, el dominio de Cros d'Auzon le acoge para unas vacaciones a su gusto. Hay varias opciones de alojamiento en hoteles y albergues. Usted se beneficiará de 26 hectáreas en el borde de la Ardèche"
    ]
  },
