  "rdfs:comment": {
    "de": [
      "Die Weinberge werden biologisch bewirtschaftet und erstrecken sich über 5 ha der Beaujolais-Crus: Fleurie, Morgon, Régnié. Julien versucht, durch seine Weine die Originalität des bewirtschafteten Ortes durch handwerklichen und ehrlichen Weinbau zum Ausdruck zu bringen."
    ],
    "en": [
      "In organic farming, the vines are spread over 5 hectares of Beaujolais crus: Fleurie, Morgon, Régnié. Julien tries to express through his wines the originality of the cultivated area, thanks to a sincere and artisanal viticulture."
    ],
    "it": [
      "Le vigne sono coltivate con metodo biologico e si estendono su 5 ettari di crus del Beaujolais: Fleurie, Morgon, Régnié. Julien cerca di esprimere attraverso i suoi vini l'originalità del luogo coltivato, grazie a una viticoltura artigianale e sincera."
    ],
    "fr": [
      "En agriculture biologique, les vignes s'étalent sur 5 ha de crus du Beaujolais : Fleurie, Morgon, Régnié. Julien cherche à exprimer à travers ses vins l'originalité du lieu cultivé, grâce à une viticulture artisanale et sincère."
    ],
    "es": [
      "Los viñedos son de cultivo ecológico y se extienden por 5 hectáreas de crus de Beaujolais: Fleurie, Morgon, Régnié. Julien busca expresar a través de sus vinos la originalidad del lugar cultivado, gracias a una viticultura artesanal y sincera."
    ],
    "nl": [
      "De wijnstokken zijn biologisch geteeld en verspreid over 5 hectare Beaujolais crus: Fleurie, Morgon, Régnié. Julien probeert via zijn wijnen de originaliteit van de gecultiveerde plaats tot uitdrukking te brengen, dankzij een ambachtelijke en oprechte wijnbouw."
    ]
  },
  "rdfs:label": {
