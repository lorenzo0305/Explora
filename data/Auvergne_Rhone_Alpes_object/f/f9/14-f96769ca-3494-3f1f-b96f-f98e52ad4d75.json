  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b18a7e9-390e-337b-adcb-7a88ffe0ae9b",
      "dc:description": {
        "de": [
          "Lebensmittel-Supermarkt\n\"Unser Vival-Markt Groffliers freut sich, Sie begrüßen zu dürfen und bietet Ihnen seine Dienstleistungen, seine frischen Produkte sowie eine vielfältige Auswahl an Bio- und lokalen Produkten an.\""
        ],
        "en": [
          "Grocery store\n\"Our Vival Groffliers store is delighted to welcome you and offer its services, fresh produce and a varied choice of organic and local products.\""
        ],
        "it": [
          "Supermercato alimentare\n\"Il nostro negozio Vival Groffliers è lieto di accogliervi e di offrirvi i suoi servizi, prodotti freschi e una variegata scelta di prodotti biologici e locali.\""
        ],
        "fr": [
          "Supérette alimentaire \n\"Notre magasin Vival Groffliers est ravi de vous accueillir et de vous proposer ses services, ses produits frais, ainsi qu’un choix varié de produits bio et locaux.\""
        ],
        "es": [
          "Supermercado de alimentación\n\"Nuestra tienda Vival Groffliers está encantada de recibirle y ofrecerle sus servicios, productos frescos y una variada selección de productos ecológicos y locales.\""
        ],
        "nl": [
          "Levensmiddelenwinkel\n\"Onze Vival Groffliers winkel is verheugd je te verwelkomen en je zijn diensten, verse producten en een gevarieerde keuze aan biologische en lokale producten aan te bieden.\""
        ]
      },
      "@type": [
        "Description"
