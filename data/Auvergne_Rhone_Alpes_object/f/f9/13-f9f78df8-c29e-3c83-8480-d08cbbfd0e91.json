  "rdfs:comment": {
    "de": [
      "LyLyLand, eine Eisdiele und Teestube im Herzen des Dorfes, ist eine Verkaufsstelle zum Mitnehmen. Ein Reich der Süßigkeiten in einem gemütlichen und warmen Raum, in dem alles \"hausgemacht\" ist ...."
    ],
    "en": [
      "Takeaway from LyLyLand, an ice cream parlour and tea room in the heart of the village. A realm of sweet treats in a warm, cosy space where everything is homemade ...."
    ],
    "it": [
      "Da asporto da LyLyLand, gelateria e sala da tè nel cuore del paese. Un regno di dolcezze in uno spazio accogliente e caldo dove tutto è fatto in casa ...."
    ],
    "fr": [
      "Point de vente à emporter de LyLyLand  un glacier - salon de Thé, au cœur du village. Un royaume de douceurs dans un espace cosy et chaleureux où tout est fabriqué \"maison\" ...."
    ],
    "es": [
      "Comida para llevar en LyLyLand, una heladería y salón de té en el corazón del pueblo. Un reino de dulces en un espacio acogedor y cálido donde todo es casero ...."
    ],
    "nl": [
      "Afhaalmaaltijden van LyLyLand, een ijssalon en theesalon in het hart van het dorp. Een rijkdom aan zoete lekkernijen in een gezellige, warme ruimte waar alles huisgemaakt is ...."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique-Glacier Lylyland"
    ]
  },
