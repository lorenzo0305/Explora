  "rdfs:comment": {
    "de": [
      "Das Monchu Méribel lädt Sie zu einem einzigartigen Erlebnis in einer Berghütte im Herzen der 3 Täler ein. Sie fahren die Rhodos-Piste entlang und schon sind Sie da!"
    ],
    "en": [
      "Bistro D'altitude, the Monchu is the \"Friendly Place\" for each of your breaks: breakfast, drink, lunch, snacks, but you can also privatize it for your evenings."
    ],
    "it": [
      "Il Monchu Méribel vi invita a vivere un'esperienza unica in uno chalet d'alta quota nel cuore delle 3 Valli. Prendete la pista Rhodos e siete arrivati!"
    ],
    "fr": [
      "Le Monchu Méribel vous invite à vivre des expériences uniques dans un chalet d’altitude au cœur des 3 Vallées. Vous empruntez la piste des Rhodos et vous y êtes!"
    ],
    "es": [
      "El Monchu Méribel le invita a disfrutar de una experiencia única en un chalet de gran altitud en el corazón de los 3 Valles. ¡Tome la pista Rhodos y ya está allí!"
    ],
    "nl": [
      "Bistro D'altitude, de Monchu is de \"Friendly Place\" voor elk van uw pauzes: ontbijt, drankje, lunch, snack, maar u kunt het ook privatiseren voor uw avonden."
    ]
  },
