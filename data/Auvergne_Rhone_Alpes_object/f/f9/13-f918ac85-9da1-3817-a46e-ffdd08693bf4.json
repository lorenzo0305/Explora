  "rdfs:comment": {
    "de": [
      "Hausgemachte Pizzen und Burger, Salate, Sandwiches, traditionelle Gerichte (Trüffel). Brauerei mit einem Maximum an lokalen Produkten, kurze Lieferketten. .Panoramaterrasse auf der Sioule und dem Château Rocher."
    ],
    "en": [
      "Pizzas, homemade burgers, salads, toasties and traditional dishes (truffade). Brewery with other locally brewed products. Concerts in July and August. Terrace with a panoramic view of the Sioule and the Rocher castle"
    ],
    "it": [
      "Pizze e hamburger fatti in casa, insalate, panini, piatti tradizionali (truffade). Brasserie con un massimo di prodotti locali, a filiera corta. Terrazza panoramica con vista sulla Sioule e su Château Rocher."
    ],
    "fr": [
      "Pizzas et burgers maison, salades, tartines, plats traditionnels (truffade). Brasserie avec un maximum de produits locaux, filières courtes. Terrasse panoramique sur la Sioule et Château Rocher."
    ],
    "es": [
      "Pizzas y hamburguesas caseras, ensaladas, bocadillos, platos tradicionales (trufada). Brasserie con un máximo de productos locales, cadenas de suministro cortas. Terraza panorámica con vistas al Sioule y al Château Rocher."
    ],
    "nl": [
      "Huisgemaakte pizza's en hamburgers, salades, sandwiches, traditionele gerechten (truffade). Brasserie met een maximum aan lokale producten, korte leveringsketens. Panoramisch terras met uitzicht op de Sioule en Château Rocher."
    ]
  },
