  "rdfs:comment": {
    "de": [
      "Aus technischen Gründen wird die für Freitag, den 20. Februar 2026 im Palais des Congrès de Montélimar geplante Vorstellung von Jeff Panacloc auf Donnerstag, den 8. April 2027 verschoben. Ihre Eintrittskarten bleiben für diese neue Vorstellung gültig."
    ],
    "en": [
      "For technical reasons, the performance of Jeff Panacloc scheduled at the Palais des Congrès de Montélimar on Friday, February 20, 2026 has been postponed to Thursday, April 8, 2027. Your tickets remain valid for this new performance."
    ],
    "it": [
      "Per motivi tecnici, lo spettacolo di Jeff Panacloc previsto al Palazzo dei Congressi di Montélimar per venerdì 20 febbraio 2026 è stato rinviato a giovedì 8 aprile 2027. I biglietti restano validi per questo nuovo spettacolo."
    ],
    "fr": [
      "Pour des raisons techniques, la représentation de Jeff Panacloc prévue au Palais des Congrès de Montélimar le vendredi 20 février 2026 est reportée au jeudi 8 avril 2027. Vos billets restent valables pour cette nouvelle séance."
    ],
    "es": [
      "Por razones técnicas, la representación de Jeff Panacloc prevista en el Palacio de Congresos de Montélimar el viernes 20 de febrero de 2026 ha sido aplazada al jueves 8 de abril de 2027. Sus entradas siguen siendo válidas para esta nueva representación."
    ],
    "nl": [
      "Om technische redenen is de voorstelling van Jeff Panacloc die gepland stond in het Palais des Congrès in Montélimar op vrijdag 20 februari 2026 verplaatst naar donderdag 8 april 2027. Uw tickets blijven geldig voor deze nieuwe voorstelling."
    ]
  },
  "rdfs:label": {
    "fr": [
