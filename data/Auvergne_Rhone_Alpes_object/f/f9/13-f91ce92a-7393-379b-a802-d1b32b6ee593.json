  "rdfs:comment": {
    "de": [
      "In der Mehrzweckhalle von Bourgoin-Jallieu finden alle Arten von Veranstaltungen statt: Ausstellungen, Messen, Aufführungen, Tanztees, Weihnachtsbäume, Kleider- und Tauschbörsen und die gesamte Kultursaison des Jean-Vilar-Theaters!"
    ],
    "en": [
      "The multi-purpose hall of Bourgoin-Jallieu welcomes all types of events: exhibitions, shows, performances, tea dances, Christmas trees, clothing and exchange fairs and find all the cultural season of the Théâtre Jean-Vilar!"
    ],
    "it": [
      "La sala polivalente di Bourgoin-Jallieu ospita ogni tipo di evento: mostre, fiere, spettacoli, danze del tè, alberi di Natale, fiere di abbigliamento e incontri di scambio, nonché l'intera stagione culturale del Théâtre Jean-Vilar!"
    ],
    "fr": [
      "La salle polyvalente de Bourgoin-Jallieu accueille tous types de manifestations : expositions, salons, spectacles, thés dansants, arbres de noël, bourses aux vêtements et d'échanges, et retrouvez toute la saison culturelle du Théâtre Jean-Vilar!"
    ],
    "es": [
      "La sala polivalente de Bourgoin-Jallieu acoge todo tipo de eventos: exposiciones, ferias, espectáculos, bailes de té, árboles de Navidad, ferias de ropa e intercambios, ¡así como toda la temporada cultural del Théâtre Jean-Vilar!"
    ],
    "nl": [
      "In de polyvalente zaal van Bourgoin-Jallieu vinden allerlei evenementen plaats: tentoonstellingen, beurzen, voorstellingen, theedansen, kerstbomen, kledingbeurzen en ruilbeurzen, maar ook het hele culturele seizoen in het Théâtre Jean-Vilar!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle Polyvalente"
    ]
  },
