  "rdfs:comment": {
    "de": [
      "Unser Restaurant Sevan bietet Ihnen libanesisch-armenische Spezialitäten, die mit Sorgfalt und Leidenschaft zubereitet werden. Zögern Sie nicht länger und begeben Sie sich für die Dauer einer Mahlzeit auf eine Reise."
    ],
    "en": [
      "Our Sevan restaurant offers you Lebanese-Armenian specialties cooked with care and passion. Don't hesitate to come and travel for a meal."
    ],
    "it": [
      "Il nostro ristorante Sevan vi offre specialità libanesi-armene cucinate con cura e passione. Non esitate più e venite a viaggiare nel tempo di un pasto."
    ],
    "fr": [
      "Notre restaurant Sevan vous propose des spécialités libano-arméniennes cuisinées avec soin et passion. N'hésitez plus et venez voyager le temps d'un repas."
    ],
    "nl": [
      "Ons restaurant in Sevan biedt Libanees-Armeense specialiteiten die met zorg en passie worden bereid. Aarzel niet langer en kom voor een maaltijd."
    ],
    "es": [
      "Nuestro restaurante Sevan le ofrece especialidades libanesas-armenias cocinadas con cuidado y pasión. No lo dudes más y ven a recorrer el tiempo de una comida."
    ]
  },
