  "rdfs:comment": {
    "de": [
      "Dieser Tempel ist eine ehemalige methodistische Kapelle, die 1863 - 1864 erbaut wurde. Großes dreistöckiges Gebäude, das sich fast gegenüber dem heutigen Tempel an der Straße nach Dieulefit befindet. Tür und Fenster werden von einem spitzbogigen Maßwerk überragt."
    ],
    "en": [
      "This temple is a former Methodist chapel built in 1863 - 1864. Large, three-storey building almost opposite the present temple on the route de Dieulefit. Door and windows surmounted by a pointed arch."
    ],
    "it": [
      "Questo tempio è un'ex cappella metodista costruita nel 1863-1864. Il grande edificio a tre piani si trova quasi di fronte all'attuale tempio, sulla strada per Dieulefit. Porta e finestre sormontate da un arco a sesto acuto."
    ],
    "fr": [
      "Ce temple est une ancienne chapelle méthodiste construite en 1863 - 1864. Grand bâtiment de trois niveaux qui se situe presque en face du temple actuel sur la route de Dieulefit. Porte et fenêtres surmontées d'un tracé d'arc brisé."
    ],
    "es": [
      "Este templo es una antigua capilla metodista construida en 1863 - 1864. El gran edificio de tres plantas está casi enfrente del templo actual, en la carretera de Dieulefit. Puerta y ventanas coronadas por un arco apuntado."
    ],
    "nl": [
      "Deze tempel is een voormalige Methodistenkapel gebouwd in 1863 - 1864. Dit grote gebouw van drie verdiepingen staat bijna tegenover de huidige kerk op de route de Dieulefit. Deur en ramen worden bekroond door een spitsboog."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ancien Temple de Bourdeaux (chapelle méthodiste)"
    ]
  },
