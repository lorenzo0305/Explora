  "rdfs:comment": {
    "de": [
      "Ein zauberhafter Rahmen und eine herzliche Atmosphäre erwarten Sie, um Sie mit einer Feinschmeckerküche zu verwöhnen, die von frischen, lokalen und saisonalen Produkten inspiriert ist."
    ],
    "en": [
      "An enchanting setting and a warm atmosphere await you as you indulge in gourmet cuisine inspired by fresh, local and seasonal produce."
    ],
    "it": [
      "Un ambiente incantevole e un'atmosfera accogliente vi aspettano per gustare una cucina gourmet ispirata a prodotti freschi, locali e di stagione."
    ],
    "fr": [
      "Un cadre enchanteur et une ambiance chaleureuse vous attendent pour vous régaler d’une cuisine gourmande inspirée de produits frais, locaux et de saison."
    ],
    "es": [
      "Un entorno encantador y un ambiente cálido le esperan para disfrutar de una cocina gourmet inspirada en productos frescos, locales y de temporada."
    ],
    "nl": [
      "Een betoverende omgeving en een warme sfeer wachten op u om te genieten van een gastronomische keuken geïnspireerd door verse, lokale en seizoensgebonden producten."
    ]
  },
