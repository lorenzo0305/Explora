  "rdfs:comment": {
    "de": [
      "Bootsverleih, Bootsausflüge auf einem 14 km langen Wasserweg, Wasserski, Wakeboarden, Schlauchboote, Jetski, Bootsverleih zur Selbststeuerung… und die Möglichkeit, vor Ort etwas zu trinken oder ein Eis zu genießen."
    ],
    "en": [
      "Boat pontoon rental, boat trips on a 14 km stretch of water, water skiing, wakeboarding, towed inflatables, jet skiing, self-drive boat rentals… and the possibility of having a drink or enjoying an ice cream on site."
    ],
    "it": [
      "Noleggio di imbarcazioni, gite su uno specchio d'acqua di 14 km, sci nautico, wakeboard, boe trainate, jetski, noleggio di imbarcazioni senza equipaggio e la possibilità di gustare un drink o un gelato in loco."
    ],
    "fr": [
      "Location de ponton pour bateau, balades sur un plan d’eau de 14 km, ski nautique, wakeboard, bouée tractée, jetski, location de bateaux sans pilote… et possibilité de boire un verre ou déguster une glace sur place."
    ],
    "nl": [
      "Verhuur van pontons, tochten over een 14 km lang water, waterskiën, wakeboarden, sleepboeien, jetskiën, verhuur van onbemande boten en de mogelijkheid om ter plekke iets te drinken of een ijsje te eten."
    ],
    "es": [
      "Alquiler de pantalanes, paseos por un tramo de 14 km de agua, esquí acuático, wakeboard, boyas remolcadas, motos acuáticas, alquiler de embarcaciones sin tripulación... y la posibilidad de disfrutar de una bebida o un helado in situ."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ski Motonautisme des Fades-Besserve"
    ],
    "en": [
      "Ski Motonautisme des Fades-Besserve"
    ],
