  "rdfs:comment": {
    "de": [
      "Sandrine empfängt Sie in ihrer Crêperie/Snackbar und bietet Ihnen ihre hausgemachten Spezialitäten an: Crêpes, Bubble-Waffeln, Buchweizenpfannkuchen.\r\nSie können auch einen Kaffee oder ein Getränk zu sich nehmen und handgemachtes Eis probieren."
    ],
    "en": [
      "Creperie - snacks on the spot and to take away. Homemade pancakes, waffle bubbles, ice cream, coffees, paninis, salads, buckwheat pancakes...."
    ],
    "it": [
      "Sandrine vi accoglie nella sua crêperie/snack bar e vi offre le sue specialità fatte in casa: Crêpes, Bubble waffles, frittelle di grano saraceno.\r\nPotrete anche sorseggiare un caffè o una bevanda o assaggiare i nostri gelati fatti in casa."
    ],
    "fr": [
      "Sandrine vous accueille dans sa crêperie/snack et vous propose ses spécialités faites maison : Crêpes, gaufres Bubble, galettes sarrasin.\r\nIl est également possible de prendre un café, une boisson et de déguster des glaces artisanales."
    ],
    "es": [
      "Sandrine le da la bienvenida a su crêperie/snack bar y le ofrece sus especialidades caseras: crêpes, gofres Bubble, tortitas de trigo sarraceno.\r\nTambién podrá disfrutar de un café o una bebida, o probar nuestros helados caseros."
    ],
    "nl": [
      "Sandrine heet je welkom in haar crêperie/snackbar en biedt je haar huisgemaakte specialiteiten: crêpes, Bubble wafels, boekweitpannenkoeken.\r\nJe kunt er ook genieten van een kopje koffie of een drankje, of onze huisgemaakte ijsjes proeven."
    ]
  },
