  "rdfs:comment": {
    "de": [
      "Der Tennisclub Die kann Sie auf seinen drei Tennisplätzen, von denen zwei im Jahr 2016 neu gestaltet wurden, sowie auf der Padelbahn begrüßen. Wir bieten Ihnen Kurse an, die von einem DE geleitet werden."
    ],
    "en": [
      "The Die tennis club can welcome you on its 3 tennis courts, 2 of which were refurbished in 2016, as well as on the padel court. We offer lessons given by a DE."
    ],
    "it": [
      "Il Die tennis club dispone di 3 campi da tennis, 2 dei quali sono stati rinnovati nel 2016, oltre a un campo da padel. Offriamo lezioni impartite da un DE."
    ],
    "fr": [
      "Le tennis club de Die peut vous accueillir sur ces 3 courts de tennis, dont 2 refait à neuf en 2016, ainsi que sur la piste de padel. Nous vous proposons des cours donnés par un DE."
    ],
    "es": [
      "El club de tenis Die cuenta con 3 pistas de tenis, 2 de ellas reformadas en 2016, así como una pista de pádel. Ofrecemos clases impartidas por un DE."
    ],
    "nl": [
      "De tennisclub Die heeft 3 tennisbanen, waarvan er 2 in 2016 zijn gerenoveerd, en een padelbaan. Er worden lessen gegeven door een DE."
    ]
  },
