  "rdfs:comment": {
    "de": [
      "Dorf Cayres: Dorf am Fuße des Mont Devès. Kirche aus dem 19. Jahrhundert. Kapelle und Steinkreuz in Chacornac. Orientierungstafeln auf dem Gipfel des Mont Recours."
    ],
    "en": [
      "Village of Cayres: Village at the foot of Mont Devès. 19th-century church. Chapel and stone cross at Chacornac. Orientation tables at the summit of Mont Recours."
    ],
    "it": [
      "Villaggio di Cayres: villaggio ai piedi del Mont Devès. Chiesa del XIX secolo. Cappella e croce di pietra a Chacornac. Tavole di orientamento in cima al Mont Recours."
    ],
    "fr": [
      "Village de Cayres : Village au pied du Mont Devès. Église du XIXe siècle. Chapelle et croix en pierre à Chacornac. Tables d’orientation au sommet du Mont Recours."
    ],
    "es": [
      "Pueblo de Cayres: Pueblo al pie del Mont Devès. Iglesia del siglo XIX. Capilla y cruz de piedra en Chacornac. Mesas de orientación en la cima del Mont Recours."
    ],
    "nl": [
      "Dorp Cayres: Dorp aan de voet van de Mont Devès. Kerk uit de 19e eeuw. Kapel en stenen kruis in Chacornac. Oriëntatietafels op de top van de Mont Recours."
    ]
  },
