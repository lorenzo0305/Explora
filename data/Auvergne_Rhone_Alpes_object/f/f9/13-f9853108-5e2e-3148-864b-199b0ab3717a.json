  "rdfs:comment": {
    "de": [
      "Die Gemeinde Viry liegt auf 516 Metern Höhe im Nordwesten von\r\nDepartements Savoyen und 10 Kilometer von Genf entfernt. Mit 2616 Hektar,\r\nist sie die größte Gemeinde im Flachland von Hochsavoyen."
    ],
    "en": [
      "The town of St-Julien offers you an active walk interspersed with workshops, in a pleasant and natural environment."
    ],
    "it": [
      "Il comune di Viry si trova a 516 metri di altitudine, nel nord-ovest del dipartimento della Savoia, a 10 chilometri da Ginevra.\r\nSavoia, a 10 chilometri da Ginevra. Con 2616 ettari,\r\nè il più grande comune di pianura dell'Alta Savoia."
    ],
    "fr": [
      "La commune de Viry se situe à 516 mètres d’altitude, au nord-ouest du\r\ndépartement de la Savoie à 10 kilomètres de Genève. Avec 2616 hectares,\r\nelle est la plus grande commune de plaine de Haute Savoie."
    ],
    "es": [
      "El municipio de Viry se encuentra a 516 metros de altitud, en el noroeste del departamento de Saboya, a 10 kilómetros de Ginebra.\r\ndepartamento de Saboya, a 10 kilómetros de Ginebra. Con 2616 ha,\r\nes el municipio de llanura más extenso de la Alta Saboya."
    ],
    "nl": [
      "De gemeente Viry ligt op een hoogte van 516 meter, in het noordwesten van\r\ndepartement Savoie, 10 kilometer van Genève. Met 2616 hectare,\r\nhet is de grootste vlakke gemeente van de Haute Savoie."
    ]
  },
