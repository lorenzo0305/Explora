  "rdfs:comment": {
    "de": [
      "Museum für Kunst und Geschichte Das mit dem Gütesiegel „Musée de France“ ausgezeichnete Museum für Kunst und Geschichte von Albertville befindet sich im Herzen der historischen Altstadt von Conflans. Seine Sammlungen zeichnen die Geschichte von Albertville von der gallorömischen Zeit bis zum Beginn des 20. Jahrhunderts nach. Besichtigungen sind möglich."
    ],
    "en": [
      "Museum of Art and History Awarded the \"Musée de France\" label, the Albertville Museum of Art and History is located in the heart of the historic medieval city of Conflans. Its collections trace the history of Albertville from the Gallo-Roman period to the early 20th century. Tours are available."
    ],
    "it": [
      "Museo d’Arte e di Storia Insignito del marchio \"Musée de France\", il Museo d'Arte e di Storia di Albertville è situato nel cuore della città storica di Conflans. Le sue collezioni ripercorrono la storia di Albertville, dal periodo gallo-romano fino all'inizio del XX secolo. Sono possibili visite guidate e libere."
    ],
    "fr": [
      "Labellisé Musée de France, le Musée d’art et d’histoire d’Albertville est installé au cœur de la cité historique de Conflans.\r\nSes collections retracent l'histoire d'Albertville, de la période gallo-romaine au début du XXe siècle. Visites possibles."
    ],
    "nl": [
      "Museum voor Kunst en Geschiedenis Het Museum voor Kunst en Geschiedenis van Albertville is bekroond met het kwaliteitslabel \"Musée de France\" en is gevestigd in het hart van de historische stad Conflans. De collecties vertellen de geschiedenis van Albertville, van de Gallo-Romeinse periode tot het begin van de 20e eeuw. Bezoeken zijn mogelijk."
    ],
    "es": [
      "El Museo de Arte e Historia de Albertville, museo de Francia, está situado en el centro histórico de la ciudad de Conflans.\r\nSus colecciones recorren la historia de Albertville desde la época galo-romana hasta principios del siglo XX. Visitas disponibles."
    ]
  },
