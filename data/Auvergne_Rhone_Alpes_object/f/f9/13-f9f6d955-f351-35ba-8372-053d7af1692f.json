  "rdfs:comment": {
    "de": [
      "Audrey bietet Ihnen Yoga-Einzelunterricht in einem wunderschönen, dem Yoga gewidmeten Raum oder bei Ihnen zu Hause an. In diesen Kursen können Sie sich nach einem anstrengenden Sporttag dehnen und entspannen."
    ],
    "en": [
      "Audrey proposes individual Yoga classes in a magnificent room dedicated to Yoga or in the comfort of your own home. Yoga classes help you to relax at the end of a day full of activities."
    ],
    "it": [
      "Audrey offre lezioni private di yoga in una magnifica sala yoga o a domicilio. Queste lezioni vi aiuteranno a distendervi e a rilassarvi dopo una giornata di sport."
    ],
    "fr": [
      "Audrey vous propose des cours particuliers de Yoga dans une magnifique salle dédiée au Yoga ou à domicile. Ces cours vous permettront de vous étirer et de vous détendre après une journée de sport."
    ],
    "es": [
      "Audrey ofrece clases particulares de yoga en una magnífica sala de yoga o a domicilio. Estas clases te ayudarán a estirarte y relajarte después de un día de deporte."
    ],
    "nl": [
      "Audrey geeft privé yogalessen in een prachtige yogaruimte of bij je thuis. Deze lessen helpen je te stretchen en te ontspannen na een dag sporten."
    ]
  },
  "rdfs:label": {
