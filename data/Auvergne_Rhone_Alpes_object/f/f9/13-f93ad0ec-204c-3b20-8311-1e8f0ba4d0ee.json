  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf den Pisten von Contamines-Montjoie die Bûche croisée.\r\nSeine savoyischen Krusten, Gänseleber und Morcheln, sein Ham'Buche und hausgemachte Pommes frites, seine Ravioles... Frische Produkte und hausgemachte Küche.\r\nGemütlich und warm drinnen oder auf der Terrasse."
    ],
    "en": [
      "On the slopes of Les Contamines-Montjoie, discover \"La Bûche Croisée\".\r\nFoie gras and morel mushroom croûte savoyard toasted sandwiches, Ham'Buche and homemade fries, ravioli ... Freshly and homemade cuisine.\r\nSit in the comfort of the warm dining room or outside on the terrace."
    ],
    "it": [
      "Scoprite la Bûche Croisée sulle piste di Les Contamines-Montjoie; croûtes savoiardes, foie gras e funghi, il tipico Ham’Buche e patate fritte fatte in casa, ravioli … Prodotti freschi e cucina genuina. Accogliente e riscaldato all’interno o in terrazza."
    ],
    "fr": [
      "Sur les piste des Contamines-Montjoie, découvrez la Bûche croisée.\r\nSes croûtes savoyardes, foie gras et morilles, son Ham'Buche et frites maison, ses ravioles... Produits frais et cuisine maison.\r\nConfortable et au chaud à l'intérieur ou en terrasse."
    ],
    "nl": [
      "Ontdek op de hellingen van Les Contamines-Montjoie de Bûche croisée.\r\nZijn Savoyaardse korsten, foie gras en morilles, zijn Ham'Buche en huisgemaakte frieten, zijn ravioli... Verse producten en thuis koken.\r\nComfortabel en warm binnen of op het terras."
    ],
    "es": [
      "En las laderas de Les Contamines-Montjoie, descubra la Bûche croisée.\r\nSus cortezas de Saboya, su foie gras y sus colmenas, su Ham'Buche y sus patatas fritas caseras, sus ravioles... Productos frescos y comida casera.\r\nCómodo y cálido en el interior o en la terraza."
    ]
  },
