  "rdfs:comment": {
    "de": [
      "Restaurant mit einer kleinen Speisekarte, das jedoch auf die Qualität der zubereiteten Produkte achtet: überwiegend lokale Produkte mit natürlichem Ursprung, Bio- und/oder Qualitätsprodukten."
    ],
    "en": [
      "A restaurant with a limited \"à l'ardoise\" menu, but with a focus on the quality of the products cooked: mostly local products of natural, organic and/or quality origin."
    ],
    "it": [
      "Un ristorante con un menù limitato \"à l'ardoise\", ma con un'attenzione particolare alla qualità dei prodotti cucinati: la maggior parte dei prodotti locali sono di origine naturale, biologica e/o di qualità."
    ],
    "fr": [
      "Restaurant proposant une carte réduite, \"à l'ardoise\", mais qui a le soucis de la qualité des produits cuisinés: produits locaux en grande majorité ayant une origine naturelle, bio et/ou de qualité."
    ],
    "es": [
      "Un restaurante con un menú \"à l'ardoise\" limitado, pero centrado en la calidad de los productos cocinados: la gran mayoría de los productos locales son de origen natural, ecológico y/o de calidad."
    ],
    "nl": [
      "Een restaurant met een beperkte kaart 'à l'ardoise', maar met de nadruk op de kwaliteit van de bereide producten: de overgrote meerderheid van de lokale producten zijn van natuurlijke, biologische en/of kwalitatieve oorsprong."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Trèfle A Quatre Feuilles"
    ]
  },
