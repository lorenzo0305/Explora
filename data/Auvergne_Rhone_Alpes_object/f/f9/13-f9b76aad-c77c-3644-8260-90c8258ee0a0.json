  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Kulturerbe auf spielerische Weise!\r\nDiese 5 km lange Strecke führt Sie auf eine Entdeckungsreise durch Grézieu-la-Varenne. Entdecken Sie den Dorfkern: seinen runden Turm, seinen quadratischen Turm, seine Kirche... und die umliegende Landschaft."
    ],
    "en": [
      "Discover the heritage in a playful way!\r\nThis 5 km route takes you to discover Grézieu-la-Varenne. Discover the heart of the village: its round tower, its square tower, its church... and its surrounding countryside."
    ],
    "it": [
      "Scoprite il patrimonio in modo giocoso!\r\nQuesto percorso di 5 km vi porta alla scoperta di Grézieu-la-Varenne. Scoprite il cuore del villaggio: la sua torre rotonda, la sua torre quadrata, la sua chiesa e la campagna circostante."
    ],
    "fr": [
      "Découvrez le patrimoine de manière ludique ! \r\nCe parcours de 5 km vous emmène à la découverte de Grézieu-la-Varenne. Découvrez le cœur du village : sa tour ronde, sa tour carrée, son église… et sa campagne environnante."
    ],
    "es": [
      "¡Descubra el patrimonio de forma lúdica!\r\nEsta ruta de 5 km le lleva a descubrir Grézieu-la-Varenne. Descubra el corazón del pueblo: su torre redonda, su torre cuadrada, su iglesia... y sus alrededores."
    ],
    "nl": [
      "Ontdek het erfgoed op een speelse manier!\r\nDeze route van 5 km neemt u mee op ontdekking van Grézieu-la-Varenne. Ontdek het hart van het dorp: de ronde toren, de vierkante toren, de kerk... en het omringende landschap."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade en Vallons à Grézieu-la-Varenne"
    ]
  },
