  "rdfs:comment": {
    "de": [
      "Romanische Kirche aus dem 12. Jahrhundert. Jahrhundert. Besichtigung möglich, indem Sie bei Frau Ceres (Haus unterhalb der Kirche) nach dem Schlüssel fragen, falls die Kirche geschlossen ist."
    ],
    "en": [
      "12th-century Romanesque church. Possibility of visiting by asking Mrs Ceres (house below the church) for the key if the church is closed."
    ],
    "it": [
      "Chiesa romanica del XII secolo. È possibile visitarla chiedendo la chiave alla signora Ceres (nella casa sotto la chiesa) se è chiusa."
    ],
    "fr": [
      "Eglise romane du XIIe siècle. Possibilité de visite en demandant la clef à Mme Ceres (maison en dessous de l'église) si celle-ci est fermée."
    ],
    "nl": [
      "Romaanse kerk uit de 12e eeuw. Je kunt het bezoeken door de sleutel te vragen aan mevrouw Ceres (in het huis onder de kerk) als het gesloten is."
    ],
    "es": [
      "Iglesia románica del siglo XII. Puede visitarla pidiendo la llave a la Sra. Ceres (en la casa situada debajo de la iglesia) si está cerrada."
    ]
  },
  "rdfs:label": {
