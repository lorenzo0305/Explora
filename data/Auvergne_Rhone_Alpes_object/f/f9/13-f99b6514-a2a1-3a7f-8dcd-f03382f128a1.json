  "rdfs:comment": {
    "de": [
      "Zwischen zwei Abfahrten können Sie sich im Saal oder auf einer der schönsten Terrassen von Flaine niederlassen, um ein leckeres Mittagessen zu genießen oder einfach eine Pause mit Blick auf die Berge einzulegen."
    ],
    "en": [
      "Between runs, take a seat indoors or on one of Flaine's most beautiful terraces to enjoy a gourmet lunch or simply a break with a view of the mountains."
    ],
    "it": [
      "Tra una discesa e l'altra, accomodatevi nella sala da pranzo o su una delle più belle terrazze di Flaine per un pranzo gourmet o semplicemente per una pausa con vista sulle montagne."
    ],
    "fr": [
      "Entre deux descentes, installez-vous en salle ou sur l’une des plus belles terrasses de Flaine pour profiter d’un déjeuner gourmand ou simplement d’une pause face aux montagnes."
    ],
    "nl": [
      "Tussen de afdalingen door kunt u binnen plaatsnemen of op een van de mooiste terrassen van Flaine om te genieten van een gastronomische lunch of gewoon even te pauzeren met uitzicht op de bergen."
    ],
    "es": [
      "Entre dos descensos, tome asiento en el comedor o en una de las terrazas más bellas de Flaine para disfrutar de un almuerzo gourmet o simplemente de un descanso con vistas a las montañas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Friendly Kitchen"
    ],
    "fr": [
      "Friendly Kitchen"
    ],
    "nl": [
      "Friendly Kitchen"
    ]
  },
