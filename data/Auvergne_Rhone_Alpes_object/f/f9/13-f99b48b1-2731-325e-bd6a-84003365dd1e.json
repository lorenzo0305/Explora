  "rdfs:comment": {
    "de": [
      "Jahrhundert bis ins 20. Jahrhundert: reich bestickte Gewänder, verzierte Kelche und Monstranzen, Reliquienschreine, Statuen und Gemälde?"
    ],
    "en": [
      "The Musée d?art sacré houses an exceptional collection of liturgical objects from the 14th to the 20th century: richly embroidered vestments, ornate chalices and monstrances, reliquaries, statues and paintings?"
    ],
    "it": [
      "Il Musée d'art sacré ospita un'eccezionale collezione di oggetti liturgici dal XIV al XX secolo: paramenti riccamente ricamati, calici e ostensori ornati, reliquiari, statue e dipinti?"
    ],
    "fr": [
      "Le Musée d’art sacré réunit un fonds exceptionnel d’objets liturgiques du XIVe siècle au XXe siècle : habits richement brodés, calices et ostensoirs ornementés, reliquaires, statues et tableaux…"
    ],
    "nl": [
      "Het Musée d'art sacré herbergt een uitzonderlijke collectie liturgische voorwerpen van de 14e tot de 20e eeuw: rijkelijk geborduurde gewaden, sierlijke kelken en monstransen, reliekhouders, beelden en schilderijen?"
    ],
    "es": [
      "El Museo de Arte Sacro alberga una excepcional colección de objetos litúrgicos de los siglos XIV al XX: vestimentas ricamente bordadas, cálices y custodias ornamentados, relicarios, estatuas y pinturas.."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite Guidée : Analyses d'oeuvres au Musée d'Art Sacré"
    ]
  },
