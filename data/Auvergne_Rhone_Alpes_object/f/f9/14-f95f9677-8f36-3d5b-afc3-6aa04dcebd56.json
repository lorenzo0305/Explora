  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8905f621-1b6c-32ed-a0f5-c6ab979a3f1e",
      "dc:description": {
        "de": [
          "Die Gemeinde organisiert am 31. März 2024 eine Eierjagd für die Kinder von Capelleelle. Die Anmeldung ist obligatorisch, weitere Informationen erhalten Sie im Rathaus von La Capelle-Lès-Boulogne 03.21.10.26.00"
        ],
        "en": [
          "The municipality is organizing an egg hunt for Capelle children on March 31, 2024. Registration is compulsory; further information is available from the Mairie de La Capelle-Lès-Boulogne 03.21.10.26.00"
        ],
        "it": [
          "Il Comune organizza una caccia alle uova per i bambini di Capelle il 31 marzo 2024. L'iscrizione è obbligatoria; ulteriori informazioni sono disponibili presso il municipio di La Capelle-Lès-Boulogne (03.21.10.26.00)"
        ],
        "fr": [
          "La municipalité organise la chasse à l'œuf le 31 mars 2024 pour les enfants capellois. L'inscription est obligatoire, renseignements complémentaires en mairie de La Capelle-Lès-Boulogne 03.21.10.26.00"
        ],
        "es": [
          "El ayuntamiento organiza una búsqueda del huevo para los niños de Capelle el 31 de marzo de 2024. La inscripción es obligatoria; más información en el ayuntamiento de La Capelle-Lès-Boulogne (03.21.10.26.00)"
        ],
        "nl": [
          "De gemeente organiseert op 31 maart 2024 een eierspeurtocht voor kinderen uit Capelle. Inschrijven is verplicht; meer informatie is verkrijgbaar bij het gemeentehuis van La Capelle-Lès-Boulogne (03.21.10.26.00)"
        ]
      },
