  "rdfs:comment": {
    "de": [
      "Eine originalgetreue Nachbildung, die zur Entdeckung der Tugenden und der Symbolik der Pflanzenarten (Blumen, Gemüse, Heilkräuter...) einlädt - Garten mit Gütesiegel - Rustica- und Ökotourismus-Preis 2005. -Label bemerkenswerter Garten."
    ],
    "en": [
      "A faithful reconstruction invitin to the discovery of virtues and symbolism of plants kinds (flowers, vegetables, curatives herbs...)"
    ],
    "it": [
      "Una ricostruzione fedele che invita a scoprire le virtù e il simbolismo delle specie vegetali (fiori, ortaggi, erbe medicinali...) - Giardino etichettato - Premio Rustica ed ecoturismo nel 2005. -Notevole etichetta da giardino."
    ],
    "fr": [
      "Une reconstitution fidèle invitant à la découverte des vertus et du symbolisme des espèces végétales (fleurs, légumes, herbes médicinales...) - Jardin labellisé - Prix Rustica et de l'écotourisme en 2005. -Label jardin remarquable."
    ],
    "es": [
      "Una fiel reconstrucción que invita a descubrir las virtudes y el simbolismo de las especies vegetales (flores, hortalizas, hierbas medicinales...) - Jardín etiquetado - Rústico y premio de ecoturismo en 2005. -Etiqueta de jardín notable."
    ],
    "nl": [
      "Een getrouwe reconstructie die uitnodigt tot het ontdekken van de deugden en de symboliek van de plantensoorten (bloemen, groenten, geneeskrachtige kruiden...) - Tuin met label - Rustica en ecotoerismeprijs in 2005. -Opmerkelijk tuinlabel."
    ]
  },
  "rdfs:label": {
