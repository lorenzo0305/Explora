  "rdfs:comment": {
    "de": [
      "Seit dem Sommer 2004 erwarten Sie die neuen Besitzer, um Ihnen ihre neue Spezialität, die Moules-Frites, aber auch ihre traditionelle Küche, ihre Frösche und Pommes frites schmackhaft zu machen."
    ],
    "en": [
      "Since the summer of 2004, the new owners are waiting for you to taste their new speciality: Moules-Frites but also their traditional cuisine, frogs and fried foods."
    ],
    "it": [
      "Dall'estate del 2004, i nuovi proprietari vi aspettano per farvi provare la loro nuova specialità: le Moules-Frites, ma anche la loro cucina tradizionale, le rane e i fritti."
    ],
    "fr": [
      "Depuis l'été 2004, les nouveaux propriétaires vous attendent pour vous faire goûter leur nouvelle spécialité : les Moules-Frites mais aussi leur cuisine traditionnelle, leurs grenouilles et fritures."
    ],
    "nl": [
      "Sinds de zomer van 2004 wachten de nieuwe eigenaars op u om hun nieuwe specialiteit te proberen: Moules-Frites, maar ook hun traditionele keuken, kikkers en gefrituurde gerechten."
    ],
    "es": [
      "Desde el verano de 2004, los nuevos propietarios le esperan para que pruebe su nueva especialidad: las Moules-Frites, pero también su cocina tradicional, las ranas y las frituras."
    ]
  },
  "rdfs:label": {
