  "rdfs:comment": {
    "de": [
      "L'Atelier des Énigmes wurde seit 2017 bei den Escape Game Awards zur besten Escape-Game-Schild der Region Auvergne-Rhône-Alpes gewählt und bietet Ihnen die Möglichkeit, einen unvergesslichen Moment zu teilen!"
    ],
    "en": [
      "Voted best Escape Game in the Auvergne-Rhône-Alpes region since 2017 at the Escape Game Awards, L'Atelier des Énigmes offers you the chance to share an unforgettable moment!"
    ],
    "it": [
      "Votato miglior Escape Game della regione Auvergne-Rhône-Alpes dal 2017 agli Escape Game Awards, L'Atelier des Énigmes vi offre la possibilità di condividere un momento indimenticabile!"
    ],
    "fr": [
      "Élu meilleure enseigne d’Escape Game de la région Auvergne-Rhône-Alpes, depuis 2017 aux Escape Game Awards, L'Atelier des Énigmes vous offre l’occasion de partager un moment inoubliable !"
    ],
    "nl": [
      "L'Atelier des Énigmes, sinds 2017 uitgeroepen tot beste Escape Game in de regio Auvergne-Rhône-Alpes bij de Escape Game Awards, biedt je de kans om een onvergetelijk moment te beleven!"
    ],
    "es": [
      "Elegido mejor juego de escape de la región de Auvernia-Ródano-Alpes en los Escape Game Awards de 2017, ¡L'Atelier des Énigmes te ofrece la oportunidad de compartir una experiencia inolvidable!"
    ]
  },
