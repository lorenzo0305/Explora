  "rdfs:comment": {
    "de": [
      "Mvélo+ gewährleistet die (kurz- und langfristige) Vermietung von Fahrrädern in Grenoble und seinem Umland\r\nFast 9000 Fahrräder können in 4 Filialen gemietet werden und es gibt über 2000 individuelle oder kollektive Schließfächer."
    ],
    "en": [
      "Mvélo+ provides bicycle rentals (short and long term) in Grenoble and its surrounding area\r\nNearly 9,000 bicycles for rent in 4 agencies and more than 2,000 individual or collective locker spaces."
    ],
    "it": [
      "Mvélo+ offre il noleggio di biciclette a breve e lungo termine a Grenoble e dintorni\r\nQuasi 9.000 biciclette a noleggio in 4 filiali e più di 2.000 posti di blocco individuali o collettivi."
    ],
    "fr": [
      "Mvélo+ assure  la location (courte et longue durée) de vélos sur Grenoble et son agglomération\r\nPrès de 9000 vélos à la location dans 4 agences et plus de 2000 places de consignes individuelles ou collectives."
    ],
    "nl": [
      "Mvélo+ verhuurt fietsen op korte en lange termijn in Grenoble en omgeving\r\nBijna 9.000 fietsen te huur in 4 filialen en meer dan 2.000 individuele of collectieve stallingsplaatsen."
    ],
    "es": [
      "Mvélo+ ofrece alquiler de bicicletas a corto y largo plazo en Grenoble y sus alrededores\r\nCerca de 9.000 bicicletas de alquiler en 4 sucursales y más de 2.000 plazas individuales o colectivas."
    ]
  },
