  "rdfs:comment": {
    "de": [
      "Das Haus PASSOT Rémy & Fils hat die Seele eines Familienhauses: Dominique, Rémy, Félix und Simon freuen sich darauf, Ihnen ihr Weingut zu zeigen, das mit dem Zertifikat \"Haute Valeur Environnementale\" ausgezeichnet ist."
    ],
    "en": [
      "Come and discover our range of typical Beaujolais wines."
    ],
    "it": [
      "PASSOT Rémy & Fils ha l'anima di una casa di famiglia: Dominique, Rémy, Félix e Simon saranno lieti di mostrarvi la loro tenuta, certificata di alto valore ambientale."
    ],
    "fr": [
      "La Maison PASSOT Rémy & Fils a l’âme d’une Maison Familiale : Dominique, Rémy, Félix et Simon seront ravis de vous faire découvrir leur Domaine, certifié Haute Valeur Environnementale."
    ],
    "es": [
      "PASSOT Rémy & Fils tiene el alma de una casa familiar: Dominique, Rémy, Félix y Simon estarán encantados de mostrarle su finca, certificada como de alto valor medioambiental."
    ],
    "nl": [
      "PASSOT Rémy & Fils heeft de ziel van een familiehuis: Dominique, Rémy, Félix en Simon zullen u met plezier rondleiden op hun landgoed, dat gecertificeerd is als zeer waardevol voor het milieu."
    ]
  },
