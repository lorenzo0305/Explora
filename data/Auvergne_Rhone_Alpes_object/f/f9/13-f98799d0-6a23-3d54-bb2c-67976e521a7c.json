  "rdfs:comment": {
    "de": [
      "⚠ Sommerroute wegen Bauarbeiten gesperrt, benutzen Sie die Winterroute.\r\nSmartphone-Spiel im Freien zwischen Chamrousse 1650 - Recoin und Chamrousse 2250 - Croix de Chamrousse.\r\nSommer- und Winteraktivität, für Groß und Klein, allein oder in der Gruppe."
    ],
    "en": [
      "⚠ Summer route closed for roadworks, use winter route.\r\nOutdoor smartphone game between Chamrousse 1650 - Recoin and Chamrousse 2250 - Croix de Chamrousse.\r\nSummer and winter activities for young and old, alone or in a group."
    ],
    "it": [
      "? Percorso estivo chiuso per lavori, utilizzare il percorso invernale.\r\nGioco di smartphone all'aperto tra Chamrousse 1650 - Recoin e Chamrousse 2250 - Croix de Chamrousse.\r\nAttività estive e invernali per giovani e anziani, da soli o in gruppo."
    ],
    "fr": [
      "⚠ Itinéraire été fermé pour travaux, utiliser l'itinéraire hiver.\r\nJeu sur smartphone en plein air entre Chamrousse 1650 - Recoin et Chamrousse 2250 - Croix de Chamrousse.\r\nActivité été comme hiver, pour les grands comme les petits, seul ou en groupe."
    ],
    "nl": [
      "? Zomerroute gesloten wegens werkzaamheden, winterroute gebruiken.\r\nOutdoor smartphone game tussen Chamrousse 1650 - Recoin en Chamrousse 2250 - Croix de Chamrousse.\r\nZomer- en winteractiviteiten voor jong en oud, alleen of in groep."
    ],
    "es": [
      "? Ruta de verano cerrada por obras, utilizar ruta de invierno.\r\nJuego de smartphone al aire libre entre Chamrousse 1650 - Recoin y Chamrousse 2250 - Croix de Chamrousse.\r\nActividades de verano e invierno para jóvenes y mayores, solos o en grupo."
    ]
  },
