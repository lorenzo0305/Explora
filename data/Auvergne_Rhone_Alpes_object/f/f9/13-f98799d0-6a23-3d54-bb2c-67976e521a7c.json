      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/aa50cdc7-85a3-31cd-a288-7d00ba0cbf71",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "ACHTUNG Spiel ganzjährig vorhanden, aber :\r\n- Während der Hauptsaison (Dezember > April und Juli / August) + Mai-Brücken + Wochenenden im Juni und September (unter Wettervorbehalt) über die Gondelbahn erreichbar\r\n- Nur zu Fuß erreichbar (2 Std. und 500 m Höhenunterschied von der Talstation) in der Nebensaison und außerhalb der Öffnungszeiten der Gondelbahn."
            ],
            "en": [
              "ATTENTION game present all year round but :\r\n- Accessible via gondola during peak seasons (December > April and July / August) + May bank holidays + weekends in June and September (weather permitting)\r\n- Accessible on foot only (2h and 500m ascent from the bottom of the resort) out of season and when the gondola is not open."
            ],
            "it": [
              "ATTENZIONE gioco disponibile tutto l'anno ma :\r\n- Accessibile con la telecabina durante l'alta stagione (dicembre > aprile e luglio / agosto) + giorni festivi di maggio + fine settimana di giugno e settembre (tempo permettendo)\r\n- Accessibile solo a piedi (2 ore e 500 m di salita dal fondo del resort) fuori stagione e quando la telecabina non è aperta."
            ],
            "fr": [
              "ATTENTION jeu présent à l'année mais : \r\n- Accessible via la télécabine durant les pleines saisons (décembre > avril et juillet / août) + ponts de mai + week-ends juin et de septembre (sous réserve météo)\r\n- Accessible à pied uniquement (2h et 500m de dénivelé depuis le bas de station) hors saison et en dehors de l'ouverture de la télécabine."
            ],
            "nl": [
              "ATTENTIE spel het hele jaar beschikbaar maar :\r\n- Toegankelijk via gondel tijdens het hoogseizoen (december > april en juli / augustus) + feestdagen in mei + weekenden in juni en september (als het weer het toelaat)\r\n- Alleen te voet bereikbaar (2u en 500m klimmen vanaf de onderkant van het resort) buiten het seizoen en wanneer de gondel niet open is."
            ],
            "es": [
              "ATENCIÓN juego disponible todo el año, pero :\r\n- Accesible en telecabina en temporada alta (diciembre > abril y julio / agosto) + puentes de mayo + fines de semana de junio y septiembre (si el tiempo lo permite)\r\n- Accesible sólo a pie (2 h y 500 m de ascenso desde la base de la estación) fuera de temporada y cuando la telecabina no está abierta."
            ]
          },
