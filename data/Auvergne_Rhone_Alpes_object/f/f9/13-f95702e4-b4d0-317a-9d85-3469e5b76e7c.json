  "rdfs:comment": {
    "de": [
      "Die Manège Mons Maubeuge ist eine in Europa einzigartige grenzüberschreitende Bühne.\r\nDie nationale Bühne bietet jedes Jahr mehr als hundert Aufführungen, Saison und Festivals zusammengenommen, mit fast 60.000 Zuschauern und 5000 Abonnenten."
    ],
    "en": [
      "Le Manège Mons Maubeuge is a cross-border stage unique in Europe.\r\nEvery year, the national stage puts on over a hundred shows, including seasons and festivals, with almost 60,000 spectators and 5,000 subscribers."
    ],
    "it": [
      "Il Manège Mons Maubeuge è un palcoscenico transfrontaliero unico in Europa.\r\nOgni anno, il palcoscenico nazionale mette in scena più di cento spettacoli, stagioni e festival messi insieme, con quasi 60.000 spettatori e 5.000 abbonati."
    ],
    "fr": [
      "Le Manège Mons Maubeuge est une scène transfrontalière unique en Europe. \r\nLa scène nationale propose chaque année plus d’une centaine de spectacles, saison et festivals confondus, avec près de 60 000 spectateurs et 5000 abonnés."
    ],
    "nl": [
      "Le Manège Mons Maubeuge is een grensoverschrijdend podium dat uniek is in Europa.\r\nElk jaar brengt het nationale podium meer dan honderd voorstellingen, seizoenen en festivals samen, met bijna 60.000 toeschouwers en 5.000 abonnees."
    ],
    "es": [
      "Le Manège Mons Maubeuge es un escenario transfronterizo único en Europa.\r\nCada año, el escenario nacional pone en escena más de un centenar de espectáculos, entre temporadas y festivales, con cerca de 60.000 espectadores y 5.000 abonados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre Le Manège"
    ]
  },
