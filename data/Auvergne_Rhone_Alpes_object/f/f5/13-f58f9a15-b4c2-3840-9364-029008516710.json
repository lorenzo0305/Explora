  "rdfs:comment": {
    "de": [
      "Familiäre, traditionelle hausgemachte Küche mit der Jahreszeit entsprechenden Produkten"
    ],
    "en": [
      "The restaurant La Feuille de Chou offers home cooking, traditional, family-style cooking using produce from the four seasons. We welcome you for lunch and dinner all year round, in a friendly setting (lovely vaulted, air-conditioned room)."
    ],
    "it": [
      "Il ristorante La Feuille de Chou offre una cucina casalinga, tradizionale e familiare con i prodotti delle quattro stagioni. Vi accogliamo a pranzo e a cena tutto l'anno, in un'atmosfera amichevole (bella sala a volta e climatizzata)."
    ],
    "fr": [
      "Le restaurant La Feuille de Chou vous propose une cuisine maison, traditionnelle et familiale avec les produits des quatre saisons. Nous vous accueillons midi et soir toute l'année, dans un cadre convivial (jolie salle voûtée et climatisée)."
    ],
    "nl": [
      "Het restaurant La Feuille de Chou biedt u een huisgemaakte, traditionele en familiale keuken met de producten van de vier seizoenen. Wij ontvangen u het hele jaar door voor lunch en diner, in een gezellig kader (mooie gewelfde zaal met airconditioning)."
    ],
    "es": [
      "El restaurante La Feuille de Chou le ofrece una cocina casera, tradicional y familiar con los productos de las cuatro estaciones. Le damos la bienvenida para almorzar y cenar durante todo el año, en un entorno acogedor (preciosa sala abovedada y climatizada)."
    ]
  },
