  "rdfs:comment": {
    "de": [
      "1 Stunde Floating = 4 Stunden Schlaf\r\nEin einzigartiges Erlebnis in unseren Floating-Kabinen, allein oder zu zweit.\r\nLassen Sie sich von der sensorischen Isolation überraschen und von der Außenwelt abschotten, um in einen tiefen, regenerierenden, meditativen Zustand zu gleiten."
    ],
    "en": [
      "1 hour floating = 4 hours sleep\r\nA unique experience in our floating cabins, alone or with a partner.\r\nLet yourself be surprised by the sensory isolation and cut off from the outside world as you slip into a deep, regenerating meditative state."
    ],
    "it": [
      "1 ora di galleggiamento = 4 ore di sonno\r\nUn'esperienza unica nelle nostre cabine galleggianti, da soli o in coppia.\r\nLasciatevi sorprendere dall'isolamento sensoriale e tagliate fuori dal mondo esterno mentre scivolate in uno stato meditativo profondo e rigenerante."
    ],
    "fr": [
      "1 heure de flottaison = 4 heures de sommeil\r\nUne expérience unique grâce à nos cabines de flottaisons, seul ou à deux.\r\nLaissez vous surprendre par l’isolation sensorielle et couper du monde extérieur vous glisser vers un état méditatif profond, régénérant."
    ],
    "nl": [
      "1 uur drijven = 4 uur slapen\r\nEen unieke ervaring in onze drijvende cabines, alleen of met een partner.\r\nLaat je verrassen door de zintuiglijke isolatie en afgesloten van de buitenwereld terwijl je in een diepe, regenererende meditatieve staat komt."
    ],
    "es": [
      "1 hora flotando = 4 horas durmiendo\r\nUna experiencia única en nuestras cabañas flotantes, solo o en pareja.\r\nDéjese sorprender por el aislamiento sensorial y desconéctese del mundo exterior mientras se sumerge en un estado meditativo profundo y regenerador."
    ]
  },
  "rdfs:label": {
    "en": [
      "A Cal'O"
    ],
    "fr": [
      "A Cal'O"
    ]
  },
