  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte auf den Höhen des Arselle-Plateaus, um die Markierungen zu entdecken, die in Chamrousse 1700 in der Nähe der Dörfer Bachat-Bouloud aufgestellt wurden."
    ],
    "en": [
      "With you map, you will walk across a part of the Arselle's plateau to discover tags in Chamrousse 1700 around Bachat-Bouloud villages."
    ],
    "it": [
      "Utilizzando la vostra mappa, spostatevi sulle alture dell'altopiano di Arselle per scoprire i fari installati a Chamrousse 1700, vicino ai villaggi di Bachat Bouloud."
    ],
    "fr": [
      "À l'aide de votre carte, déplacez-vous sur les hauteurs du plateau de l'Arselle pour découvrir les balises qui ont été installées à Chamrousse 1700 à proximité des Villages de Bachat Bouloud."
    ],
    "nl": [
      "Verplaats je met behulp van je kaart over de hoogten van het plateau van Arselle om de bakens te ontdekken die zijn geïnstalleerd in Chamrousse 1700 in de buurt van de dorpen van Bachat Bouloud."
    ],
    "es": [
      "Con ayuda de su mapa, desplácese por las alturas de la meseta de Arselle para descubrir las balizas instaladas en Chamrousse 1700, cerca de las aldeas de Bachat Bouloud."
    ]
  },
  "rdfs:label": {
    "de": [
      "Erbgut-Orientierungslauf Kind"
    ],
    "en": [
      "Orienteering course for children"
    ],
    "fr": [
      "Parcours d'orientation patrimoine Enfant"
    ]
  },
