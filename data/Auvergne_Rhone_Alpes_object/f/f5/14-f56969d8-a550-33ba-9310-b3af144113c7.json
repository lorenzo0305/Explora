  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dca90139-8910-3a20-8885-3e1d917a19ff",
      "dc:description": {
        "de": [
          "Fahrradparade in den Farben Belgiens ab dem Rathaus um 10:30 Uhr - Wettbewerb um das schönste Fahrrad und Überraschung bei der Ankunft - 10:30 Uhr\n\n Anmeldung im Tourismusbüro erforderlich"
        ],
        "en": [
          "Belgium-colored Bike Parade departing from Town Hall at 10:30 a.m. - Contest for the most beautiful bike and surprise at the finish line - 10:30 a.m\n\n Registration essential at the Tourist Office"
        ],
        "it": [
          "Sfilata di biciclette con i colori del Belgio con partenza dal municipio alle 10.30 - Concorso per la bicicletta più bella e sorpresa all'arrivo - 10.30\n\n Iscrizione obbligatoria presso l'Ufficio del Turismo"
        ],
        "fr": [
          "Véloparade au couleur de la Belgique au départ de la mairie à 10h30 - Concours du plus beau vélo et surprise à l'arrivée - 10h30\n\n Inscription indispensable à l'office de Tourisme"
        ],
        "nl": [
          "Fietsparade in de kleuren van België vanaf het gemeentehuis om 10.30 uur - Wedstrijd voor de mooiste fiets en verrassing aan de finish - 10.30 uur\n\n Inschrijving verplicht bij de Dienst voor Toerisme"
        ],
        "es": [
          "Desfile de bicicletas con los colores de Bélgica con salida del ayuntamiento a las 10.30 h. - Concurso a la bicicleta más bonita y sorpresa a la llegada - 10.30 h\n\n Inscripción obligatoria en la Oficina de Turismo"
        ]
      },
      "@type": [
        "Description"
      ],
