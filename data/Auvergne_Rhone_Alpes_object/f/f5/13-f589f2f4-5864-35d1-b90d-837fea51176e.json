  "rdfs:comment": {
    "de": [
      "Ausstieg und Abfahrt in Canyons von Grenoble aus.  Canyon du Furon, Canyon des Ecouges, Canyon du Versoud, Canyon de l'infernet...\r\nErmäßigung für Gruppen, EVGs und EVJFs. Entdecken Sie wunderschöne Landschaften und tanken Sie Adrenalin!"
    ],
    "en": [
      "Descent of canyons from Grenoble. Furon canyon, Ecouges canyon, Versoud canyon, Infernet canyon...\r\nDiscount for groups, bachelorette parties and bachelorette parties. Come discover magnificent landscapes and get your fill of adrenaline!"
    ],
    "it": [
      "Canyoning da Grenoble.  Canyon du Furon, canyon des Ecouges, canyon du Versoud, Canyon de l'infernet...\r\nSconti per gruppi, EVG e EVJF. Venite a scoprire paesaggi magnifici e a scaricare l'adrenalina!"
    ],
    "fr": [
      "Sortie et descente de canyons à partir de Grenoble.  Canyon du Furon, canyon des Ecouges, canyon du Versoud, Canyon de l'infernet...\r\nRéduction pour les groupes, les EVG et EVJF. Venez découvrir des paysages magnifiques et faites le plein d'adrénaline !"
    ],
    "nl": [
      "Canyoning vanuit Grenoble.  Canyon du Furon, canyon des Ecouges, canyon du Versoud, Canyon de l'infernet...\r\nKortingen voor groepen, EVG's en EVJF's. Kom prachtige landschappen ontdekken en laat je adrenaline pompen!"
    ],
    "es": [
      "Barranquismo desde Grenoble.  Canyon du Furon, canyon des Ecouges, canyon du Versoud, Canyon de l'infernet...\r\nDescuentos para grupos, EVG y EVJF. Venga a descubrir magníficos paisajes y a descargar adrenalina"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terra Nova Canyoning"
    ]
  },
