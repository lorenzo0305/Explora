  "rdfs:comment": {
    "de": [
      "Erlernen Sie das Klettern und Mountainbiken auf eine lustige und spielerische Art und Weise. Koalagrimpe ist der Spezialist für Anfänger und Kinder im Tal von Chamonix!"
    ],
    "en": [
      "Come and learn climbing and mountain biking in a fun and playful way. Koalagrimpe is the specialist for beginners and children in the Chamonix valley!"
    ],
    "it": [
      "Venite a cimentarvi con l'arrampicata e la mountain bike in modo divertente e simpatico. Koalagrimpe è lo specialista dei principianti e dei bambini nella valle di Chamonix!"
    ],
    "fr": [
      "Venez vous initier à l'escalade et au VTT de manière fun et ludique. Koalagrimpe est le spécialiste des débutants et des enfants dans la vallée de Chamonix!"
    ],
    "es": [
      "Ven a probar la escalada y la bicicleta de montaña de forma divertida y entretenida. ¡Koalagrimpe es el especialista para principiantes y niños en el valle de Chamonix!"
    ],
    "nl": [
      "Kom op een leuke en onderhoudende manier klimmen en mountainbiken. Koalagrimpe is de specialist voor beginners en kinderen in de vallei van Chamonix!"
    ]
  },
