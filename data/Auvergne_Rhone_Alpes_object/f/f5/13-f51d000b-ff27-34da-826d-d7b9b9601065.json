  "rdfs:comment": {
    "de": [
      "Die Sonnenuhr der Kirche Saint-Géraud in Saillans, die sich an der Südwand befindet, wurde von der Firma Annequin neu restauriert. Mit einem lateinischen Motto, dessen Übersetzung lautet: \"Ainsi s'enfuit l'ombre sous le soleil\" (So flieht der Schatten unter der Sonne)."
    ],
    "en": [
      "The sundial on the south wall of Saint-Géraud church in Saillans has recently been restored by Annequin. The Latin motto reads: \"Ainsi s'enfuit l'ombre sous le soleil\" (\"Thus flees the shadow under the sun\")."
    ],
    "it": [
      "La meridiana della chiesa di Saint-Géraud a Saillans, situata sulla parete sud, è stata recentemente restaurata dalla ditta Annequin. Con un motto in latino che si traduce in: \"Così fugge l'ombra sotto il sole\"."
    ],
    "fr": [
      "Le cadran solaire de l'église Saint-Géraud à Saillans, situé sur le mur Sud a été nouvellement restauré par l'entreprise Annequin. Avec une devise en latin dont la traduction est : « Ainsi s’enfuit l’ombre sous le soleil »."
    ],
    "es": [
      "El reloj de sol de la iglesia de Saint-Géraud de Saillans, situado en el muro sur, ha sido restaurado recientemente por la empresa Annequin. Con un lema en latín que se traduce como: \"Así huye la sombra bajo el sol\"."
    ],
    "nl": [
      "De zonnewijzer op de zuidelijke muur van de Saint-Géraud kerk in Saillans is onlangs gerestaureerd door Annequin. Het Latijnse motto luidt: \"Ainsi s'enfuit l'ombre sous le soleil\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cadran solaire"
    ]
  },
