  "rdfs:comment": {
    "de": [
      "Der Uhrenturm steht unter Denkmalschutz und geht auf die Errichtung einer alten Dorffestung zurück, die im 14. Jahrhundert angelegt wurde."
    ],
    "en": [
      "Listed on the historic monuments registry, the clock tower originated in a former village fort built in the 14th century."
    ],
    "it": [
      "Classificata come monumento storico, la torre dell'orologio risale a un'antica fortezza del villaggio costruita nel XIV secolo."
    ],
    "fr": [
      "Inscrite au titre des Monuments Historiques, la tour de l’horloge trouve son origine dans l’édification d’un ancien fort villageois aménagé au 14e siècle."
    ],
    "nl": [
      "De klokkentoren, die op de monumentenlijst staat, stamt uit een oud dorpsfort dat in de 14e eeuw werd gebouwd."
    ],
    "es": [
      "Catalogada como Monumento Histórico, la torre del reloj se remonta a una antigua fortaleza del pueblo construida en el siglo XIV."
    ]
  },
