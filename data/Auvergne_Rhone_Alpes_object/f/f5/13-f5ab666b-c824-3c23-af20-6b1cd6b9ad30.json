  "rdfs:comment": {
    "de": [
      "Willkommen im Ilot Swing, dem neuen Restaurant auf dem Golfplatz von L'Isle d'Abeau.\r\nDas gesamte Team empfängt Sie von Dienstag bis Sonntag von 9 bis 18 Uhr.\r\nWir freuen uns darauf, Sie kennenzulernen! Machen Sie eine Pause inmitten der Natur!"
    ],
    "en": [
      "Welcome to L'Ilot Swing, the new restaurant on the L'Isle d'Abeau golf course.\r\nThe whole team welcomes you Tuesday to Sunday, 9am to 6pm.\r\nWe look forward to meeting you! Come and take a break in the heart of nature!"
    ],
    "it": [
      "Benvenuti a l'Ilot Swing, il nuovo ristorante del campo da golf L'Isle d'Abeau.\r\nL'intero team è a disposizione per accogliervi dal martedì alla domenica, dalle 9.00 alle 18.00.\r\nNon vediamo l'ora di conoscervi! Venite a fare una pausa nel cuore della natura!"
    ],
    "fr": [
      "Bienvenue à l'Ilot Swing, le nouveau restaurant du golf de L'Isle d'Abeau.\r\nToute l'équipe vous accueille du mardi au dimanche de 9h à 18h. \r\nHâte de vous rencontrer ! Venez faire une pause en pleine nature !"
    ],
    "nl": [
      "Welkom bij l'Ilot Swing, het nieuwe restaurant op de golfbaan van L'Isle d'Abeau.\r\nHet hele team staat voor je klaar van dinsdag tot en met zondag, van 9.00 tot 18.00 uur.\r\nWe kijken ernaar uit je te ontmoeten! Kom en neem een pauze in het hart van de natuur!"
    ],
    "es": [
      "Bienvenido a l'Ilot Swing, el nuevo restaurante del campo de golf de L'Isle d'Abeau.\r\nTodo el equipo está a su disposición de martes a domingo, de 9.00 a 18.00 horas.\r\n¡Le esperamos! Venga a descansar en plena naturaleza"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L’ilôt Swing"
    ]
  },
