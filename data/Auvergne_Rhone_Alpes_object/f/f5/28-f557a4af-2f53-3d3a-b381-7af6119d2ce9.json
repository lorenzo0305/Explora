  "rdfs:comment": {
    "de": [
      "In Rimbercourt, 5 Min. von Noyon entfernt, bietet Herr Courboin folgende Produkte zum Verkauf an: Erdbeeren, Himbeeren, schwarze Johannisbeeren, Johannisbeeren, Heidelbeeren, Konfitüren, Erdbeerperlwein und Erdbeersirup.  Spargel auf Anfrage. Geöffnet von April bis Oktober täglich von 9 bis 19:30 Uhr und am Sonntagmorgen von 9 bis 13 Uhr."
    ],
    "en": [
      "In Rimbercourt, 5 min from Noyon, Mr Courboin offers for sale: strawberries, raspberries, blackcurrants, redcurrants, blueberries, jams, sparkling and strawberry syrup.  Asparagus on request. Open from April to October every day from 9am to 7.30pm and Sunday morning from 9am to 1pm."
    ],
    "it": [
      "A Rimbercourt, a 5 minuti da Noyon, M. Courboin offre in vendita: fragole, lamponi, ribes nero, ribes rosso, mirtilli, marmellate, spumante e sciroppo di fragole.  Asparagi su richiesta. Aperto da aprile a ottobre tutti i giorni dalle 9:00 alle 19:30 e la domenica mattina dalle 9:00 alle 13:00."
    ],
    "fr": [
      "A Rimbercourt, à 5 min de Noyon, M. Courboin propose à la vente : fraises, framboises, cassis, groseilles, myrtilles, confitures, pétillant et sirop de fraise.  Asperges sur demande. Ouverture d'avril à octobre tous les jours de 9h à 19h30 et le dimanche matin de 9h à 13h."
    ],
    "nl": [
      "In Rimbercourt, op 5 minuten van Noyon, biedt M. Courboin te koop aan: aardbeien, frambozen, zwarte bessen, rode bessen, bosbessen, jam, schuimwijn en aardbeiensiroop.  Asperges op aanvraag. Van april tot oktober dagelijks geopend van 9.00 tot 19.30 uur en op zondagochtend van 9.00 tot 13.00 uur."
    ],
    "es": [
      "En Rimbercourt, a 5 minutos de Noyon, M. Courboin ofrece a la venta: fresas, frambuesas, grosellas negras, grosellas rojas, arándanos, mermeladas, vino espumoso y jarabe de fresa.  Espárragos por encargo. Abierto de abril a octubre todos los días de 9:00 a 19:30 y los domingos por la mañana de 9:00 a 13:00."
    ]
  },
  "rdfs:label": {
