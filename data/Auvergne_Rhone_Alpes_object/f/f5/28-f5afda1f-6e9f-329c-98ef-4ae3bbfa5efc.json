  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d7b53e17-b43a-345d-92b5-6998e1ac51c7",
      "dc:description": {
        "de": [
          "Traditionelles Restaurant mit Spezialität aus Holzofenpizza. 3 geschmackvoll eingerichtete Räume. Schöne geschützte und beheizte Außenterrasse.\nDenken Sie daran, freitags und samstags zu reservieren.\nSonntag- und Montagmittag geschlossen."
        ],
        "en": [
          "Traditional restaurant specializing in wood-fired pizzas. 3 tastefully decorated rooms. Heated, sheltered outdoor terrace.\nReservations essential on Fridays and Saturdays.\nClosed Sunday and Monday lunchtime."
        ],
        "it": [
          "Ristorante tradizionale specializzato in pizze cotte a legna. 3 camere arredate con gusto. Bella terrazza esterna riparata e riscaldata.\nRicordarsi di prenotare il venerdì e il sabato.\nChiuso a pranzo la domenica e il lunedì."
        ],
        "fr": [
          "Restaurant traditionnel avec spécialité de pizzas cuites au feu de bois. 3 salles décorées avec goût. Belle terrasse extérieur abritée et chauffée.\nPensez à réserver les vendredis et samedis.\nFermeture le dimanche et le lundi midi."
        ],
        "nl": [
          "Traditioneel restaurant gespecialiseerd in houtovenpizza's. 3 smaakvol ingerichte kamers. Prachtig beschut en verwarmd buitenterras.\nVergeet niet te reserveren op vrijdag en zaterdag.\nGesloten voor lunch op zondag en maandag."
        ],
        "es": [
          "Restaurante tradicional especializado en pizzas al horno de leña. 3 habitaciones decoradas con gusto. Preciosa terraza exterior cubierta y climatizada.\nNo olvide reservar los viernes y sábados.\nCerrado los domingos y lunes."
        ]
      },
      "@type": [
        "Description"
      ],
