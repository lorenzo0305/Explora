  "rdfs:comment": {
    "de": [
      "Ich habe alte Parzellen mit einer schweren chemischen Vergangenheit übernommen, die vor langer Zeit gepflügt wurden."
    ],
    "en": [
      "A young winegrower since 2010 with 15 years' experience in viticulture, I have taken over old plots with a heavy chemical past that were ploughed a long time ago."
    ],
    "it": [
      "Giovane viticoltore insediato dal 2010 con 15 anni di esperienza in viticoltura, ho rilevato vecchie parcelle con un pesante passato chimico avendo conosciuto l'aratura molto tempo fa."
    ],
    "fr": [
      "Jeune vigneron installé depuis 2010 avec 15 ans d'expériences en viticulture, j'ai repris de vieilles parcelles au lourd passé chimique ayant connu les labours il y a fort longtemps."
    ],
    "es": [
      "Joven viticultor instalado desde 2010 con 15 años de experiencia en viticultura, me hice cargo de antiguas parcelas con un pasado químico muy fuerte habiendo conocido el arado hace mucho tiempo."
    ],
    "nl": [
      "Jonge wijnbouwer geïnstalleerd sinds 2010 met 15 jaar ervaring in de wijnbouw, ik heb oude percelen overgenomen met een zwaar chemisch verleden die lang geleden het ploegen hebben gekend."
    ]
  },
