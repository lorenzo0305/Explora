  "rdfs:comment": {
    "de": [
      "In der Bar garantiert Ihnen eine Auswahl bekannter Weingüter, die glasweise serviert werden, einen geselligen Moment rund um die Bar, die regelmäßig mit Live-Musik untermalt wird."
    ],
    "en": [
      "In the bar, a selection of wines by the glass from renowned vineyards will guarantee a convivial time around the bar with regular live music."
    ],
    "it": [
      "Al bar, una selezione di famosi vigneti serviti al bicchiere vi garantirà un momento di convivialità attorno al bancone regolarmente animato da musica dal vivo."
    ],
    "fr": [
      "Au bar, une sélection de vignobles réputés servis au verre vous garantiront un moment de convivialité autour du bar régulièrement animé par de la musique live."
    ],
    "es": [
      "En el bar, una selección de famosos viñedos servidos por copa le garantizará un momento de convivencia en torno a la barra animada regularmente por música en vivo."
    ],
    "nl": [
      "Aan de bar garandeert een selectie van beroemde wijngaarden geserveerd per glas u een moment van gezelligheid rond de bar regelmatig geanimeerd door live muziek."
    ]
  },
