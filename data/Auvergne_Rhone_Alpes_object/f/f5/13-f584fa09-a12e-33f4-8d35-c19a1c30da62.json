  "rdfs:comment": {
    "de": [
      "Ein offener, zum Entspannen einladender Raum, ein angenehmes und geselliges Ambiente. Hier finden Sie alles, um bei einem Geschäftstreffen oder einem Gläschen zwischen Freunden einen angenehmen Augenblick zu verbringen. Profitieren Sie von einer Pause..."
    ],
    "en": [
      "An airy space and a warm, welcoming atmosphere that offers a chance to unwind."
    ],
    "it": [
      "Uno spazio aperto che invita al relax, un'atmosfera dolce e cordiale. Per un appuntamento professionale o un bicchiere con gli amici, c'è tutto il necessario per trascorrere un piacevole momento. Concediti una pausa..."
    ],
    "fr": [
      "Un espace ouvert qui invite à la détente, une ambiance douce et chaleureuse."
    ],
    "es": [
      "Un espacio abierto que invita a la relación, con un ambiente cálido y acogedor. Reunimos todas las condiciones necesarias para compartir muchos buenos momentos, ya sea durante una reunión de trabajo o tomando una copa con los amigos. ¡El lugar perfecto para hacer una pausa!"
    ],
    "nl": [
      "Een open ruimte die uitnodigt om te ontspannen, met een zachte, warme sfeer."
    ]
  },
