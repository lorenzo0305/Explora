  "rdfs:comment": {
    "de": [
      "Am Fuß der steilen Hänge der AOC Condrieu und Côte-Rôtie liegt die wunderschöne Domaine Xavier Gérard mit dem Weinlager, das die Fässer enthält, und dem neuen Probierkeller, in dem die verschiedenen Jahrgänge vorgestellt werden."
    ],
    "en": [
      "At the foot of the steep hills of the Condrieu and Côte-Rôtie vineyards, the Domaine Xavier Gérard welcomes visitors to its wine storehouse,\r\nin a new tasting cellar with a chance to explore a range of Côte-Rôtie, Condrieu and St Joseph."
    ],
    "it": [
      "Situata ai piedi delle ripide colline delle AOC Condrieu e Côte-Rôtie, la tenuta Xavier Gérard vi accoglie nel cuore della sua barricaia, nella nuova sala di degustazione, per scoprire le sue diverse annate."
    ],
    "fr": [
      "Situé aux pieds des coteaux escarpés des AOC Condrieu et Côte-Rôtie, le domaine Xavier Gérard vous accueille au cœur de son chai à barriques, dans son nouveau caveau de dégustation à la découverte de ses différentes cuvées."
    ],
    "es": [
      "Situada al pie de las escarpadas laderas de las DOC Condrieu y Côte-Rôtie, la finca Xavier Gérard le acoge en el corazón de su bodega de barricas, en su nueva sala de degustación, para descubrir sus diferentes añadas."
    ],
    "nl": [
      "Aan de voet van de steile hellingen van de AOC Condrieu en Côte-Rôtie heet het domein Xavier Gérard u welkom in het hart van zijn vatenkelder, in zijn nieuwe proeflokaal, om zijn verschillende jaargangen te ontdekken."
    ]
  },
