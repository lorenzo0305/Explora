  "rdfs:comment": {
    "de": [
      "Entscheiden Sie sich für einen qualitativ hochwertigen Unterricht mit staatlich geprüften Skilehrern. Skikurse, Snowboard, Snowscoot, Freeride, Wettkampfkurse, Airboard, Snake Glisse, Yooner, Nachtausflüge, Skiclub."
    ],
    "en": [
      "Choose quality tuition from ski instructors with nationally recognised  qualifications.\r\nSki and snowboard, snowscoot, freeride, competition courses, airboard, snowka glisse, yooner, ski club."
    ],
    "it": [
      "Osate scegliere un insegnamento di qualità con maestri di sci certificati dallo Stato. Lezioni di sci, snowboard, snowscoot, freeride, corsi di competizione, airboard, snake Glisse, yooner, uscite notturne, sci club."
    ],
    "fr": [
      "Osez le choix d’un enseignement de qualité avec des moniteurs de ski brevetés d’État. Cours Ski, snowboard, snowscoot, freeride, stages compétition, airboard, snake Glisse, yooner, sortie nocturne, ski club."
    ],
    "nl": [
      "Kies voor kwaliteitsvolle lessen met staatsgediplomeerde leraren."
    ],
    "es": [
      "Atrévase a elegir una enseñanza de calidad con monitores de esquí titulados por el Estado. Clases de esquí, snowboard, snowscoot, freeride, cursos de competición, airboard, snake Glisse, yooner, salidas nocturnas, club de esquí."
    ]
  },
