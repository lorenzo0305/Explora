  "rdfs:comment": {
    "de": [
      "Vom Giebel der von Jean Nouvel neu gestalteten Oper blicken acht Musen auf Sie herab... aber wo ist die neunte geblieben? Der Besuch der Opéra de Lyon ist ein Spektakel für sich."
    ],
    "en": [
      "From the top of the pediment of the Opera revisited by Jean Nouvel, eight muses are watching you ... but where's the ninth? The visit of the Lyon Opera is a spectacle in itself."
    ],
    "it": [
      "Dall'alto del frontone dell'Opéra, rivisitato da Jean Nouvel, 8 muse vi guardano... ma dov'è finita la nona? Una visita all'Opéra di Lione è uno spettacolo in sé."
    ],
    "fr": [
      "Du haut du fronton de l'Opéra revisité par Jean Nouvel, 8 muses vous contemplent... mais où est passée la 9ème ? La visite de l'Opéra de Lyon est un spectacle en soi."
    ],
    "nl": [
      "Vanaf de top van het fronton van de Opera, dat door Jean Nouvel opnieuw is ontworpen, staren 8 muzen op je neer... maar waar is de 9e gebleven? Een bezoek aan de Opéra de Lyon is een spektakel op zich."
    ],
    "es": [
      "Desde lo alto del frontón de la Ópera, revisitado por Jean Nouvel, 8 musas le contemplan... ¿pero dónde se ha metido la novena? Visitar la Ópera de Lyon es un espectáculo en sí mismo."
    ]
  },
  "rdfs:label": {
