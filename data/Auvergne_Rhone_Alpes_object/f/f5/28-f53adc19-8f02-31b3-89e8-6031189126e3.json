      "rdfs:comment": {
        "de": [
          "Die Mikrobrauerei BrewZik vereint das Know-how einer Brauerei, Konzerte und eine gute Atmosphäre, um sich außerhalb des Alltags zu treffen und gleichzeitig den Moment zu genießen."
        ],
        "en": [
          "The BrewZik microbrewery combines brewery know-how, live music and a great atmosphere to take you away from everyday life and enjoy the moment at the same time."
        ],
        "it": [
          "Il microbirrificio BrewZik combina competenza nella produzione di birra, musica dal vivo e un'atmosfera fantastica per staccare dalla vita quotidiana e godersi il momento."
        ],
        "fr": [
          "La microbrasserie BrewZik réunit le savoir-faire de la brasserie, les concerts et une bonne ambiance pour se retrouver hors du quotidien et en même temps en pleine dégustation du moment présent."
        ],
        "es": [
          "La microcervecería BrewZik combina experiencia cervecera, música en directo y un gran ambiente para alejarte de la vida cotidiana y disfrutar del momento."
        ],
        "nl": [
          "De microbrouwerij BrewZik combineert brouwexpertise, livemuziek en een geweldige sfeer om je mee te nemen uit het dagelijkse leven en te genieten van het moment."
        ]
      },
