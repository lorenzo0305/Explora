  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e067b472-e3a8-3b27-8bed-52b829885136",
      "dc:description": {
        "de": [
          "Japanischer Garten mit Teepavillon ,Shinto- und Tori-Schrein ,japanischem Bad ,über 100 Pflanzenarten und Wasserfläche\nNur während des Festivals vom 09. bis 19. Mai 2024 besuchbar und nur für Festivalbesucher"
        ],
        "en": [
          "Japanese garden with tea pavilion, Shinto and Tori altar, Japanese bath, over 100 species of plants and pond\nVisitable only during the festival from May 09 to 19, 2024 and reserved for festival-goers"
        ],
        "it": [
          "Giardino giapponese con padiglione del tè, altare shintoista e tori, bagno giapponese, oltre 100 specie di piante e laghetto\nVisitabile solo durante il festival dal 09 al 19 maggio 2024 e riservato ai frequentatori del festival"
        ],
        "fr": [
          "Jardin japonais avec pavillon de thé ,autel shintoiste et tori ,bain japonais ,plus de 100 espèces de plantes et plan d'eau\nVisitable uniquement pendant le festival du 09 au 19 mai 2024 et réservé aux festivaliers"
        ],
        "es": [
          "Jardín japonés con pabellón de té, altar sintoísta y tori, baño japonés, más de 100 especies de plantas y estanque\nVisitable únicamente durante el festival, del 9 al 19 de mayo de 2024, y reservado a los asistentes al festival"
        ],
        "nl": [
          "Japanse tuin met theepaviljoen, Shinto- en Tori-altaar, Japans bad, meer dan 100 plantensoorten en vijver\nAlleen te bezoeken tijdens het festival van 09 tot 19 mei 2024 en voorbehouden aan festivalgangers"
        ]
      },
