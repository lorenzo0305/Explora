  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Canal de Savière, den Lac du Bourget und die kanalisierte Rhône an Bord unseres neuen Elektro-Solar-Bootes, dem ersten Boot dieser Art in der Region!"
    ],
    "en": [
      "Discover the Savière Canal, Lake Bourget and the canalized Rhône aboard our new electro-solar boat, the first of its kind in the region!"
    ],
    "it": [
      "Partite alla scoperta del Canal de Savière, del Lago del Bourget e del Rodano canalizzato a bordo della nostra nuova barca elettro-solare, la 1a barca di questo tipo sul territorio!"
    ],
    "fr": [
      "Partez à la découverte du Canal de Savière, du Lac du Bourget et du Rhône canalisé à bord de notre nouveau bateau électro-solaire, 1er bateau de ce type sur le territoire !"
    ],
    "nl": [
      "Ontdek het Canal de Savière, het Lac du Bourget en de gekanaliseerde Rhône aan boord van onze nieuwe elektro-zonneboot, de eerste in zijn soort in de regio!"
    ],
    "es": [
      "Descubra el Canal de Savière, el Lago de Bourget y el Ródano canalizado a bordo de nuestro nuevo barco electrosolar, ¡el primero de este tipo en la región!"
    ]
  },
  "rdfs:label": {
