  "rdfs:comment": {
    "de": [
      "Das Bergbistro La Rôtisserie im Hotel Les Barmes de l'Ours lädt Sie ein, in der authentischen Atmosphäre eines echten Bergchalets eine großzügige Gourmetküche zu genießen."
    ],
    "en": [
      "La Rôtisserie, the mountain bistro at Les Barmes de l'Ours hotel, invites you to enjoy delicious, generous cuisine in the authentic atmosphere of a real mountain chalet."
    ],
    "it": [
      "Bistrot di montagna dell'hotel Les Barmes de l'Ours, La Rôtisserie vi invita a gustare una cucina golosa e generosa, nell'atmosfera autentica di un vero chalet di montagna."
    ],
    "fr": [
      "Bistrot de montagne de l’hôtel Les Barmes de l’Ours, La Rôtisserie vous invite à savourer une cuisine gourmande et généreuse, dans l’atmosphère authentique d’un véritable chalet de montagne."
    ],
    "nl": [
      "La Rôtisserie, de bergbistro van hotel Les Barmes de l'Ours, nodigt je uit om te genieten van een gulle gastronomische keuken in de authentieke sfeer van een echt bergchalet."
    ],
    "es": [
      "El bistró de montaña del hotel Les Barmes de l'Ours, La Rôtisserie, le invita a saborear una generosa cocina gourmet en el auténtico ambiente de un auténtico chalet de montaña."
    ]
  },
