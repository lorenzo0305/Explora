  "rdfs:comment": {
    "de": [
      "Vorschläge für Kombinationen von Speisen und Weinen aus dem Rhône-Tal, seltene Weine, ausländische Weine, große Auswahl, Whisky und Champagner.\r\nGroße Auswahl an handwerklich gebrauten Bieren, Likören, Rum"
    ],
    "en": [
      "Food and wine pairings from the Rhone Valley, rare wines, foreign wines, large selection, whisky, and champagnes...\r\nLarge selection of craft beers, liqueurs, rums..."
    ],
    "it": [
      "Abbinamenti enogastronomici della Valle del Rodano, vini rari, vini stranieri, un'ampia selezione di whisky e champagne...\r\nAmpia scelta di birre artigianali, liquori e rum"
    ],
    "fr": [
      "Propositions accords mets & vins de la Vallée du Rhône, vins rares, vins étrangers, grand choix, whisky, et champagnes..\r\nGrand choix de bières artisanales, de liqueurs, de Rhums"
    ],
    "nl": [
      "Wijn-spijs combinaties uit de Rhône-vallei, zeldzame wijnen, buitenlandse wijnen, een brede selectie, whisky en champagne...\r\nRuime keuze aan ambachtelijke bieren, likeuren en rum."
    ],
    "es": [
      "Maridajes del Valle del Ródano, vinos raros, vinos extranjeros, una amplia selección, whisky y champán...\r\nAmplia selección de cervezas artesanales, licores y rones"
    ]
  },
