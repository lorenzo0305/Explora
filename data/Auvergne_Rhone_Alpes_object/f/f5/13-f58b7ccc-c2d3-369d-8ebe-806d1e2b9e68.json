  "rdfs:comment": {
    "de": [
      "Bei Issue Secrète entdecken Sie 4 Räume für Escape Games (Horror, Fantasy, Rettung der Menschheit und U-Boot), einen Raum für Gesellschaftsspiele mit über 100 Referenzen an Spielen zum Ausprobieren sowie ein Quiz Game zu verschiedenen Themen."
    ],
    "en": [
      "At Issue Secrète, you'll find 4 escape game rooms (horror, fantasy, rescue of humanity and submarine), a board game room with over 100 games to try out, and a Quiz Game on a variety of themes."
    ],
    "it": [
      "All'Issue Secrète troverete 4 sale di fuga (horror, fantasy, salvataggio dell'umanità e sottomarino), una sala giochi da tavolo con oltre 100 giochi da provare e un gioco a quiz su una vasta gamma di temi."
    ],
    "fr": [
      "Chez Issue Secrète, découvrez 4 salles d'escape game (horreur, fantastique, sauvetage de l'humanité et sous-marin), une salle de jeux de société avec plus de 100 références de jeux à tester ainsi qu'un Quiz Game sur des thèmes divers et variés."
    ],
    "es": [
      "En Issue Secrète, encontrará 4 salas de juegos de escape (terror, fantasía, salvar a la humanidad y submarino), una sala de juegos de mesa con más de 100 juegos para probar y un juego de preguntas y respuestas sobre temas muy variados."
    ],
    "nl": [
      "Bij Issue Secrète vind je 4 ontsnappingsspellenkamers (horror, fantasie, de mensheid redden en onderzeeër), een bordspellenkamer met meer dan 100 spellen om uit te proberen en een quiz over allerlei thema's."
    ]
  },
