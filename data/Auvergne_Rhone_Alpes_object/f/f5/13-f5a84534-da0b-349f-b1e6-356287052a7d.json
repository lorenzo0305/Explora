  "rdfs:comment": {
    "de": [
      "Ihre Begleitperson ab dem Relais du Lac Noir bringt Sie\r\ndas wilde Tal von Montsapey zwischen Lauzière und Grand Arc entdecken.\r\nEr bietet Ihnen Gourmet-Wanderungen mit Verkostung von Produkten aus der Region an\r\nlokalen Produkten, die aus dem Relais kommen."
    ],
    "en": [
      "Departing from the Relais du Lac Noir, your guide will take you\r\ndiscover the wild Montsapey valley between the Lauzière and Grand Arc mountains.\r\nHe offers gourmet hikes with tastings of local products\r\nlocal products from the Relais."
    ],
    "it": [
      "Partendo dal Relais du Lac Noir, la vostra guida vi condurrà a\r\nalla scoperta della selvaggia valle di Montsapey, tra i monti Lauzière e Grand Arc.\r\nVi proporrà escursioni gastronomiche con degustazioni di prodotti locali\r\nprodotti locali del Relais."
    ],
    "fr": [
      "Votre accompagnateur au départ du Relais du Lac Noir vous amènera\r\ndécouvrir la vallée sauvage de Montsapey entre la Lauzière et le Grand Arc.\r\nIl vous propose des randonnées gourmandes avec dégustation des\r\nproduits locaux sortis du Relais."
    ],
    "nl": [
      "Vertrekkend vanuit het Relais du Lac Noir, neemt je gids je mee om\r\nde wilde Montsapey vallei tussen de Lauzière en Grand Arc bergen ontdekken.\r\nHij stelt je gastronomische wandelingen voor met proeverijen van lokale producten\r\nlokale producten van het Relais."
    ],
    "es": [
      "Saliendo del Relais du Lac Noir, su guía le llevará a\r\ndescubrir el salvaje valle del Montsapey, entre las montañas de Lauzière y Grand Arc.\r\nLe propondrá excursiones gastronómicas con degustación de productos locales\r\nproductos locales del Relais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Alex Moleda"
    ]
  },
