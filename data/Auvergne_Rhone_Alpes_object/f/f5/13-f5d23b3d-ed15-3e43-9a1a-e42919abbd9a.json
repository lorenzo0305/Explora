  "rdfs:comment": {
    "de": [
      "Jacks besteht darin, Erinnerungen zu schaffen, sei es im Restaurant, an der Bar oder beim Tanzen auf einem Tisch beim Après-Ski. Jacks und mein Team freuen sich darauf, unsere gepflegte und hausgemachte internationale Küche zu teilen"
    ],
    "en": [
      "Jacks is all about creating memories, whether in the restaurant, at the bar or dancing on a table at après-ski. Jacks and my team look forward to sharing our meticulous, home-cooked international cuisine."
    ],
    "it": [
      "L'obiettivo di Jacks è creare ricordi, al ristorante, al bar o al tavolo del doposci. Jacks e il mio team non vedono l'ora di condividere la nostra cucina internazionale, preparata con cura e fatta in casa"
    ],
    "fr": [
      "Jacks consiste à créer des souvenirs, que ce soit au restaurant, au bar ou en dansant sur une table à l’après-ski. Jacks et mon équipe a hâte de pouvoir partager notre cuisine internationale soignée et faite maison"
    ],
    "es": [
      "En Jacks se trata de crear recuerdos, ya sea en el restaurante, en el bar o bailando en la mesa après-ski. Jacks y mi equipo están deseando compartir nuestra cocina internacional casera y cuidadosamente elaborada"
    ],
    "nl": [
      "Bij Jacks draait alles om het maken van herinneringen, of dat nu in het restaurant, de bar of dansend aan de après-ski tafel is. Jacks en mijn team kijken ernaar uit om onze zorgvuldig samengestelde, huisgemaakte internationale keuken te delen"
    ]
  },
