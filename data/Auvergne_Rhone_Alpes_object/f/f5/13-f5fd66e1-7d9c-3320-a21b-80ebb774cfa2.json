  "rdfs:comment": {
    "de": [
      "Dieser Parkplatz liegt an der Via Ardèche und ermöglicht es Ihnen, Ihr Auto stehen zu lassen, um mit dem Fahrrad zu fahren oder einen Spaziergang zu machen."
    ],
    "en": [
      "Located along the Via Ardèche, this car park allows you to leave your vehicle to go cycling and walking."
    ],
    "it": [
      "Situato lungo la Via Ardèche, questo parcheggio permette di lasciare il proprio veicolo per andare in bicicletta o a piedi."
    ],
    "fr": [
      "Situé le long de la Via Ardèche, ce parking permet de pouvoir laisser son véhicule pour partiquer le vélo et promenade."
    ],
    "es": [
      "Situado a lo largo de la Via Ardèche, este aparcamiento le permite dejar su vehículo y practicar ciclismo y senderismo."
    ],
    "nl": [
      "Op deze parkeerplaats langs de Via Ardèche kun je je auto achterlaten en fietsen en wandelen."
    ]
