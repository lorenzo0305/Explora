  "rdfs:comment": {
    "de": [
      "Das geheime Spa\r\nDas erhabene und mineralische Spa des V**** wurde von Pure Altitude mit all der Expertise gestaltet, die man seit 20 Jahren von ihnen in Bezug auf Pflegerituale mit Pflanzen aus den Bergen kennt."
    ],
    "en": [
      "The Secret Spa\r\nThe Spa du V ****, sublime and mineral, is signed by Pure Altitude with all the expertise that we have known for 20 years on care rituals based on mountain plants."
    ],
    "it": [
      "La Spa segreta\r\nLa Spa del V****, sublime e minerale, è firmata Pure Altitude con tutta la competenza che conosciamo da 20 anni di rituali di cura a base di piante di montagna."
    ],
    "fr": [
      "Le Spa Secret\r\nLe Spa du V****, sublime et minéral, est signé Pure Altitude avec toute l’expertise qu’on leur connaît depuis 20 ans sur les rituels de soins à base de plantes des montagnes."
    ],
    "es": [
      "El Spa Secreto\r\nEl Spa del V****, sublime y mineral, lleva la firma de Pura Altitud con toda la experiencia que conocemos gracias a 20 años de rituales de cuidados vegetales de montaña."
    ],
    "nl": [
      "De geheime spa\r\nDe Spa du V ****, subliem en mineraal, is ondertekend door Pure Altitude met alle expertise die we al 20 jaar kennen op het gebied van zorgrituelen op basis van bergplanten."
    ]
  },
