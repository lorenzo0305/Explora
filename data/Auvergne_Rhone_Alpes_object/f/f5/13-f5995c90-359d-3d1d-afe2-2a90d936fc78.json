  "rdfs:comment": {
    "de": [
      "Als traditionelles Restaurant bieten wir Ihnen eine lokale, gesunde und abwechslungsreiche Küche, bei der wir kurze Wege bevorzugen. Wir sind stolz darauf, Sie in unserem schönen mittelalterlichen Dorf begrüßen zu dürfen."
    ],
    "en": [
      "Traditional restaurant offering a local, varied and healthy cuisine with products straight from the producer. We are proud to welcome you to our pretty medieval village."
    ],
    "it": [
      "Ristorante tradizionale, vi offriamo una cucina locale, sana e varia, con particolare attenzione ai circuiti brevi. Siamo orgogliosi di darvi il benvenuto nel nostro bellissimo borgo medievale."
    ],
    "fr": [
      "Restaurant traditionnel, nous vous proposons une cuisine locale, saine et variée en privilégiant les circuits courts. Nous sommes fiers de vous accueillir dans notre beau village médiéval."
    ],
    "es": [
      "Restaurante tradicional, le ofrecemos una cocina local, sana y variada, centrada en los circuitos cortos. Estamos orgullosos de recibirle en nuestro hermoso pueblo medieval."
    ],
    "nl": [
      "Als traditioneel restaurant bieden we een lokale, gezonde en gevarieerde keuken. We zijn er trots op u te mogen verwelkomen in ons mooie middeleeuwse dorp."
    ]
  },
