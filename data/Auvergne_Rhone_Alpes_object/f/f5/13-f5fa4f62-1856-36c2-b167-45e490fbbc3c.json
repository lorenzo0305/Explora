  "rdfs:comment": {
    "de": [
      "Hier finden Sie Romane, Dokumentarfilme, Science Fiction, Krimis und Jugendliteratur.\r\nDie Bibliotheken bieten das ganze Jahr über Veranstaltungen an."
    ],
    "en": [
      "You will be able to find novels, documentaries, science fiction novels, crimes novels and children's literature."
    ],
    "it": [
      "Troverete romanzi, documentari, fantascienza, gialli e letteratura per bambini.\r\nLe biblioteche offrono attività durante tutto l'anno."
    ],
    "fr": [
      "Vous y trouverez des romans, des documentaires, de la science fiction, des policiers et de la littérature jeunesse.\r\nLes bibliothèques proposent des animations tout au long de l'année."
    ],
    "nl": [
