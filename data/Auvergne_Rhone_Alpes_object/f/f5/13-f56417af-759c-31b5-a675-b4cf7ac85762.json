  "rdfs:comment": {
    "de": [
      "EPONA ist ein Familienbauernhof mit Gemüseanbau und pädagogischen Angeboten, der im Norden der Isère in der Gemeinde Chatonnay liegt. Wir produzieren Saisongemüse mit Respekt vor der Erde und heißen Familien im Rahmen von Natur-/Pädagogik-Workshops willkommen."
    ],
    "en": [
      "A family farm where we raise ponies, chickens, ducks, pigs and goats in\r\na peaceful and natural environment which allows us to welcome special needs institutions, old people’s homes, and families for Nature activities, Teaching and Animal-assisted therapy."
    ],
    "it": [
      "EPONA è un orto e una fattoria didattica a conduzione familiare a Chatonnay, nel nord dell'Isère. Produciamo ortaggi di stagione nel rispetto della terra e accogliamo le famiglie per partecipare a laboratori naturalistici ed educativi."
    ],
    "fr": [
      "EPONA, c'est une ferme familiale maraîchère et pédagogique située dans le Nord Isère sur la commune de Chatonnay. Nous produisons des légumes de saison dans le respect de la terre et accueillons les familles dans le cadre d'ateliers nature/pédagogique."
    ],
    "nl": [
      "EPONA is een familietuin en educatieve boerderij in Chatonnay in het noorden van de Isère. We produceren seizoensgroenten met respect voor de aarde en verwelkomen gezinnen om deel te nemen aan natuur/educatieve workshops."
    ],
    "es": [
      "EPONA es una huerta familiar y una granja pedagógica situada en Chatonnay, en el norte de Isère. Producimos verduras de temporada de forma respetuosa con la tierra y acogemos a las familias para que participen en talleres educativos sobre la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Epona"
    ]
  },
