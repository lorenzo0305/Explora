  "rdfs:comment": {
    "de": [
      "Philippe THON ? Facteur d'Arcs (Bogenbauer)\r\nWerkstatt für die handwerkliche Herstellung von maßgefertigten Bögen vom Typ Semi-Longbow, Hybrid-Longbow und Recurve-Jagdbogen für die Bogenjagd und das Bogenschießen in der Freizeit und bei Wettkämpfen. Geschäft für Bogenschützen. Online-Shop"
    ],
    "en": [
      "Philippe THON ? Bow Makers\r\nHand-crafted workshop for custom-made Semi-Longbow, Longbow Hybrid and Recurve bows for bowhunting, recreational and competitive archery. Archery store. Store on line"
    ],
    "it": [
      "Philippe THON ? Costruttore di archi\r\nLaboratorio artigianale per la fabbricazione su misura di archi da caccia Semi-Longbow, Longbow Hybrid e Recurve per la caccia con l'arco, il tiro con l'arco da diporto e da competizione. Negozio di tiro con l'arco. Negozio on line"
    ],
    "fr": [
      "Philippe THON – Facteur d’Arcs\r\nAtelier de fabrication artisanale d’arcs sur mesure de type Semi-Longbow, Longbow Hybride et arc de chasse Recurve pour la chasse à l'arc et le tir à l'arc de loisir et de compétition. Magasin d'archerie. Boutique en ligne"
    ],
    "es": [
      "Philippe THON ? Fabricante de arcos\r\nTaller artesanal de fabricación a medida de arcos de caza semilargos, híbridos longbow y recurvos para la caza con arco y el tiro con arco recreativo y de competición. Tienda de tiro con arco. Tienda en línea"
    ],
    "nl": [
      "Philippe THON ? Bow Maker\r\nAmbachtelijke werkplaats voor de vervaardiging van op maat gemaakte semi-longbow, longbow hybride en recurve jachtbogen voor boogschieten en recreatief en wedstrijd boogschieten. Winkel in boogschieten. Online winkelen"
    ]
  },
