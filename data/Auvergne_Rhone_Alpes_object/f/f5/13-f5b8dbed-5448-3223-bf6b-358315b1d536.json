  "rdfs:comment": {
    "de": [
      "Charmante dörfliche Obstplantage im Herzen des Haut-Bugey (850 m Höhe). Freie und kostenlose Besichtigung der Herstellungswerkstatt anhand einer Galerie, mit Videoprojektion, darunter ein Film für Kinder (18-minütiger Film + Film für Kinder). Verkaufsladen."
    ],
    "en": [
      "a charming village situated in the heart of Haut-Bugey (850m altitude) where Comté cheese is manufactured every morning following traditional expertise. Free visits of the production dairy, which is visible from a public gallery, with a video"
    ],
    "it": [
      "Incantevole villaggio frutticolo nel cuore dell'Haut-Bugey (850 m di altitudine). Visita gratuita del laboratorio di produzione da una galleria, con proiezione di un film per bambini (film di 18 minuti + film per bambini). Negozio di vendita."
    ],
    "fr": [
      "Charmante fruitière villageoise au coeur du Haut-Bugey (850m d'altitude). Visite libre et gratuite de l'atelier de fabrication à partir d'une galerie, avec projection vidéo dont un film pour enfants (film de 18 min + film pour enfants). Magasin de vente."
    ],
    "es": [
      "Encantador pueblo frutero en el corazón del Haut-Bugey (850 m de altitud). Visita gratuita del taller de producción desde una galería, con proyección de vídeo que incluye una película para niños (película de 18 minutos + película para niños). Tienda de ventas."
    ],
    "nl": [
      "Charmant dorpsfruitbedrijf in het hart van de Haut-Bugey (850m hoogte). Gratis bezoek van het productieatelier vanuit een galerij, met videoprojectie inclusief een film voor kinderen (18 min. film + film voor kinderen). Verkoopwinkel."
    ]
  },
  "rdfs:label": {
