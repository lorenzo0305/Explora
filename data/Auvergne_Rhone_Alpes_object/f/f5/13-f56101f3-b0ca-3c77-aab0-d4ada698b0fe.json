  "rdfs:comment": {
    "de": [
      "Ein Team von Spielern versucht, mithilfe von Logik und Ausgrabungen in weniger als 60 Minuten aus einem Ort zu entkommen.\r\nSixty O'Lock bietet 3 Themenbereiche: Das Bourbonenversteck, Das U-Boot-Mysterium und Der Fluch des Drachen."
    ],
    "en": [
      "A team of players attempts to escape from a location in less than 60 minutes, using logic and search.\r\nSixty O'Lock offers 3 themes: Bourbon Dungeon, Submarine Mystery and Curse of the Dragon."
    ],
    "it": [
      "Una squadra di giocatori cerca di fuggire da un luogo in meno di 60 minuti usando la logica e la ricerca.\r\nSixty O'Lock ha 3 temi: The Bourbon Dungeon, The Mystery of the Submarine e The Curse of the Dragon."
    ],
    "fr": [
      "Une équipe de joueurs tente de s'échapper d'un lieu en moins de 60 minutes grâce à la logique et à la fouille.\r\nSixty O'Lock propose 3 thématiques : Le Cachot des Bourbons, Le Mystère du sous-marin et La Malédiction du Dragon."
    ],
    "es": [
      "Un equipo de jugadores intenta escapar de un lugar en menos de 60 minutos utilizando la lógica y la búsqueda.\r\nSixty O'Lock tiene 3 temas: La Mazmorra Bourbon, El Misterio del Submarino y La Maldición del Dragón."
    ],
    "nl": [
      "Een team van spelers probeert in minder dan 60 minuten uit een locatie te ontsnappen met behulp van logica en zoeken.\r\nSixty O'Lock heeft 3 thema's: The Bourbon Dungeon, The Mystery of the Submarine en The Curse of the Dragon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape game Sixty O'Lock"
