  "rdfs:comment": {
    "de": [
      "Die Kirche Notre Dame de l'Assomption wurde auf den Grundlagen des romanischen Stils gegründet und ist seit dem 6. April 1987 als historisches Denkmal klassifiziert.\r\nLernen Sie ihre Besonderheiten kennen."
    ],
    "en": [
      "The church of Notre Dame de l'Assomption, built in the Romanesque style, has been a listed monument since April 6, 1987.\r\nCome and discover its special features."
    ],
    "it": [
      "La chiesa di Notre Dame de l'Assomption, costruita in stile romanico, è stata dichiarata monumento storico il 6 aprile 1987.\r\nVenite a scoprire le sue particolarità."
    ],
    "fr": [
      "L'église Notre Dame de l'Assomption, fondée sur les bases du style roman, est classée Monument Historique depuis le 6 avril 1987.\r\nVenez découvrir ses particularités."
    ],
    "es": [
      "La iglesia de Notre Dame de l'Assomption, de estilo románico, está clasificada como monumento histórico desde el 6 de abril de 1987.\r\nVenga a descubrir sus particularidades."
    ],
    "nl": [
      "De kerk Notre Dame de l'Assomption, gebouwd in Romaanse stijl, werd op 6 april 1987 op de monumentenlijst geplaatst.\r\nKom en ontdek haar speciale kenmerken."
    ]
  },
