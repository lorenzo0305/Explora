  "rdfs:comment": {
    "de": [
      "Ich habe mich in Saint-Martin-en-Vercors niedergelassen und biete Wellness-Massagen nach der entspannenden und belebenden Manoki®-Methode an, die ich seit mehreren Jahren praktiziere und die sich an die Bedürfnisse jedes Einzelnen anpasst und für alle geeignet ist."
    ],
    "en": [
      "Based in Saint-Martin-en-Vercors, I offer well-being massage sessions using the relaxing and invigorating Manoki® method, which I've been practicing for several years, and which adapts to individual needs and is suitable for everyone."
    ],
    "it": [
      "Con sede a Saint-Martin-en-Vercors, offro sedute di massaggio del benessere con il metodo Manoki®, rilassante e tonificante, che pratico da diversi anni e che si adatta alle esigenze individuali ed è adatto a tutti."
    ],
    "fr": [
      "Installée à Saint-Martin-en-Vercors, je propose des séances de massage bien-être selon la méthode Manoki® relaxante et tonifiante, que je pratique depuis plusieurs années, qui s’adapte aux besoins de chacun et s'adresse à tous."
    ],
    "nl": [
      "Ik ben gevestigd in Saint-Martin-en-Vercors en bied welzijnsmassages volgens de ontspannende en verkwikkende Manoki®-methode, die ik al jaren toepas en die is aangepast aan individuele behoeften en geschikt is voor iedereen."
    ],
    "es": [
      "Establecida en Saint-Martin-en-Vercors, propongo sesiones de masaje de bienestar con el método relajante y tonificante Manoki®, que practico desde hace varios años y que se adapta a las necesidades individuales y es apto para todo el mundo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cabinet massage bien-être Manoki"
    ]
  },
