  "rdfs:comment": {
    "de": [
      "Die Domaine des Saveurs - Les Planons befindet sich auf einem ehemaligen landwirtschaftlichen Anwesen in Saint-Cyr-sur-Menthon und lädt Sie ein, die Traditionen & Geschmäcker der Bresse zu entdecken: ein großes Naturgebiet, das ein Museum und einen denkmalgeschützten bressanischen Bauernhof beherbergt."
    ],
    "en": [
      "Located on a former agricultural estate in Saint-Cyr-sur-Menthon, the Domaine des Saveurs - Les Planons invites you to discover Bresse traditions and flavours: a vast natural estate housing a museum and a listed Bresse farmhouse."
    ],
    "it": [
      "Situato in un'antica tenuta agricola a Saint-Cyr-sur-Menthon, il Domaine des Saveurs ? Les Planons vi invita a scoprire le tradizioni e i sapori della regione di Bresse: una vasta tenuta naturale che ospita un museo e una fattoria bresciana tutelata"
    ],
    "fr": [
      "Implanté sur un ancien domaine agricole à Saint-Cyr-sur-Menthon, le Domaine des Saveurs – Les Planons vous invite à découvrir les traditions & saveurs bressanes : un vaste domaine naturel abritant un musée et une ferme bressane classée monument historique"
    ],
    "es": [
      "Situado en una antigua finca agrícola de Saint-Cyr-sur-Menthon, el Domaine des Saveurs ? Les Planons le invita a descubrir las tradiciones y sabores de la región de Bresse: una vasta finca natural que alberga un museo y una granja de Bresse catalogada"
    ],
    "nl": [
      "Het Domaine des Saveurs ? Les Planons u uit om de tradities en smaken van de Bresse streek te ontdekken: een uitgestrekt natuurlandgoed met een museum en een geklasseerde Bresseboerderij"
    ]
  },
