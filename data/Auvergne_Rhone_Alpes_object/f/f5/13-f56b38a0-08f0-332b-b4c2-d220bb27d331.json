  "rdfs:comment": {
    "de": [
      "Die Domaine des Terres Noires liegt inmitten einer unberührten Natur, in der die sanfte Landschaft zum Träumen einlädt, und bietet eine authentische, lichtdurchflutete und poetische Umgebung."
    ],
    "en": [
      "Nestled in the heart of unspoilt countryside, where the gentle landscapes invite you to daydream, Domaine des Terres Noires offers an authentic setting, bathed in light and poetry."
    ],
    "it": [
      "Immerso nel cuore della campagna incontaminata, il Domaine des Terres Noires offre un ambiente autentico immerso nella luce e nella poesia."
    ],
    "fr": [
      "Niché au cœur d’une nature préservée où la douceur des paysages invite à la rêverie, le Domaine des Terres Noires offre un décor authentique, baigné de lumière et de poésie."
    ],
    "es": [
      "Situado en plena naturaleza, el Domaine des Terres Noires ofrece un marco auténtico bañado de luz y poesía."
    ],
    "nl": [
      "Het Domaine des Terres Noires ligt in het hart van het ongerepte platteland en biedt een authentieke omgeving die baadt in licht en poëzie."
    ]
  },
