      "dc:description": {
        "de": [
          "Picknick-/Parkplatz am Rande der D1001, von einer Hecke verdeckt. Verschiedene Einrichtungen: 4 Picknicktische, Parkplatz und 4 Mülleimer."
        ],
        "en": [
          "Picnic/parking area on the edge of the D1001, hidden by a hedge. Facilities include 4 picnic tables, parking and 4 litter garbage cans."
        ],
        "it": [
          "Area picnic/parcheggio ai margini della D1001, nascosta da una siepe. Varie strutture: 4 tavoli da picnic, parcheggio e 4 cestini per i rifiuti."
        ],
        "fr": [
          "Aire de pique-nique/ stationnement se situant au bord de la D1001, masquée par une haie . Divers équipements : 4 tables de pique-nique, parking et  4 poubelles."
        ],
        "es": [
          "Zona de picnic/aparcamiento al borde de la D1001, oculta por un seto. Diversas instalaciones: 4 mesas de picnic, aparcamiento y 4 papeleras."
        ],
        "nl": [
          "Picknick-/parkeerplaats aan de rand van de D1001, verborgen door een heg. Diverse faciliteiten: 4 picknicktafels, parkeerplaats en 4 afvalbakken."
        ]
