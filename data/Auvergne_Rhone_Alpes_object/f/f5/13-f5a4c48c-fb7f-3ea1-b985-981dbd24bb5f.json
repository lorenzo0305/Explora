  "rdfs:comment": {
    "de": [
      "Spezialitäten des Chefkochs: Rinderkotelett 800gr, Foie Gras-Burger, Challenge-Burger 1kg200, Kalbskopf und Rinderzunge, gereiftes Fleisch und Aubrac-Fleisch.\r\nTraiteur und Gerichte zum Mitnehmen."
    ],
    "en": [
      "A pleasant restaurant for meat lovers! You will find refined piece of  Aubrac beef. Home-made dishes using fresh local ingredients to introduce you to all the flavours of meat."
    ],
    "it": [
      "Specialità dello chef: costata di manzo 800gr, hamburger di foie gras, hamburger di sfida 1kg200, testa di vitello e lingua di manzo, carni stagionate e carne di Aubrac.\r\nCatering e pasti da asporto."
    ],
    "fr": [
      "Spécialités du chef : Côte de boeuf 800gr, burger foie gras, burger défi 1kg200, la tête de veau et la langue de bœuf, les viandes maturées et la viande d Aubrac.\r\nTraiteur et plats à emporter."
    ],
    "nl": [
      "Specialiteiten van de chef: Ribstuk van rund 800gr, foie gras burger, challenge burger 1kg200, kalfskop en rundertong, gerijpt vlees en Aubrac vlees.\r\nCatering en afhaalmaaltijden."
    ],
    "es": [
      "Especialidades del chef: Costilla de ternera 800gr, hamburguesa de foie gras, hamburguesa de desafío 1kg200, cabeza de ternera y lengua de ternera, carnes maduradas y carne de Aubrac.\r\nCatering y comidas para llevar."
    ]
  },
