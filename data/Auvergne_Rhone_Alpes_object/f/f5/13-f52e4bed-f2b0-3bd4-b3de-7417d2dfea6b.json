  "rdfs:comment": {
    "de": [
      "Willkommen in Jacques' Werkstatt für HOLZDRECHSLEREI.\nAnfertigung traditioneller, aber auch künstlerischer Stücke sowie hochtechnischer Kreationen. Arbeit auf trockenem oder grünem Holz.  Workshops und Spezialaufträge."
    ],
    "en": [
      "Welcome to Jacques' woodturning workshop.\nHe makes traditional pieces, but also artistic pieces and very technical creations.\nHe works on dry wood or green wood. Training courses and specific orders."
    ],
    "it": [
      "Benvenuti nel laboratorio di tornitura di Jacques.\r\nPezzi tradizionali, ma anche pezzi artistici e creazioni altamente tecniche.\r\nSi lavora su legno secco o verde.  \r\nCorsi e ordini speciali."
    ],
    "fr": [
      "Bienvenue dans l’atelier de TOURNAGE SUR BOIS de Jacques.\r\nRéalisation de pièces traditionnelles, mais aussi des pièces artistiques et de créations très techniques. \r\nTravail sur bois sec ou bois vert.  \r\nStages et commandes spécifiques."
    ],
    "nl": [
      "Welkom bij Jacques' houtdraaiatelier.\r\nTraditionele stukken, maar ook artistieke stukken en zeer technische creaties.\r\nWerk op droog hout of groen hout.  \r\nCursussen en speciale bestellingen."
    ],
    "es": [
      "Bienvenido al taller de torneado de madera de Jacques.\r\nPiezas tradicionales, pero también piezas artísticas y creaciones muy técnicas.\r\nTrabajo sobre madera seca o madera verde.  \r\nCursos y encargos especiales."
    ]
  },
