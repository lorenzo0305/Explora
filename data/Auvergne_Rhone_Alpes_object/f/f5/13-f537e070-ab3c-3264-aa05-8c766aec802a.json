  "rdfs:comment": {
    "de": [
      "Mange ton Bol ist ein Food Truck mit Poke Bol, der kurze Wege und Null-Abfall mit essbaren süßen und salzigen Schalen bevorzugt! Informieren Sie sich auf unserer Website über die Standorte. Wir sind auch für private Veranstaltungen unterwegs"
    ],
    "en": [
      "Mange ton Bol is a Poke Bol food truck that focuses on short circuits and zero waste, with edible sweet and savory bowls ! Check the website for locations. We also travel for private events"
    ],
    "it": [
      "Mange ton Bol è un food truck Poke Bol che si concentra su circuiti brevi e rifiuti zero, con ciotole commestibili dolci e salate! Controllate il sito web per conoscere le sedi. Viaggiamo anche per eventi privati"
    ],
    "fr": [
      "Mange ton Bol est un Food Truck de Poke Bol privilégiant le circuit court et le zéro déchet avec des bols sucrés et salés comestibles ! Consultez le site internet pour connaître les emplacements. Nous nous déplaçons aussi pour des événements privés"
    ],
    "nl": [
      "Mange ton Bol is een Poke Bol foodtruck die zich richt op kortsluiting en zero waste, met eetbare zoete en hartige bowls! Kijk op de website voor locaties. We reizen ook voor privé-evenementen"
    ],
    "es": [
      "Mange ton Bol es un camión de comida Poke Bol centrado en los circuitos cortos y los residuos cero, con cuencos comestibles dulces y salados Consulta el sitio web para conocer las ubicaciones. También nos desplazamos para eventos privados"
    ]
  },
  "rdfs:label": {
    "en": [
      "Eat your bowl"
    ],
    "fr": [
      "Mange ton bol"
    ]
  },
