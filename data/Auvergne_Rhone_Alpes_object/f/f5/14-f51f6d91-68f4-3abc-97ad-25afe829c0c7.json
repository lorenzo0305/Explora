  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b71c16c4-6984-3ac2-b0c2-d5a60af24203",
      "dc:description": {
        "de": [
          "Vermietung von Teichen unter der Woche oder am Wochenende, um Ruhe, Natur und Angeln zu tanken...\n2 Angelstrecken für Forellen. Vermietung von Ausrüstung\n\nAngeln für einen Tag, einen halben Tag, Unterkünfte in der Nähe"
        ],
        "en": [
          "Pond rental for weekdays or weekends to enjoy peace, nature and fishing...\n2 trout fishing trails. Equipment rental\n\nFishing by the day, half-day, accommodation nearby"
        ],
        "it": [
          "Noleggio del laghetto durante la settimana o il fine settimana per godere della pace e della tranquillità, della natura e della pesca...\n2 corsi di pesca alla trota. Attrezzature a noleggio\n\nPesca al giorno, mezza giornata, alloggio nelle vicinanze"
        ],
        "fr": [
          "Location d'étangs en semaine ou week-end pour faire le plein de calme, de nature et de pêche...\n2 parcours de pêche à la truite. Location de matériel\n\nPêche à la journée, demi journée, hébergements à proximité"
        ],
        "nl": [
          "Vijververhuur doordeweeks of in het weekend om te genieten van de rust, de natuur en het vissen...\n2 cursussen forelvissen. Uitrusting te huur\n\nVissen per dag, halve dag, accommodatie in de buurt"
        ],
        "es": [
          "Alquiler de estanques entre semana o los fines de semana para disfrutar de la tranquilidad, la naturaleza y la pesca...\n2 cursos de pesca de truchas. Alquiler de material\n\nPesca por días, medias jornadas, alojamiento en las proximidades"
        ]
      },
      "@type": [
        "Description"
      ],
