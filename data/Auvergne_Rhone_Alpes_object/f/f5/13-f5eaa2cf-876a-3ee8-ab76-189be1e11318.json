  "rdfs:comment": {
    "de": [
      "Seb & Nath verwöhnen Sie mit authentischer Küche: Spezialitäten aus der Ardèche, Pinsas vom Holzfeuer, Buchweizenpfannkuchen... In der warmen Jahreszeit können Sie die schattige Terrasse nutzen, während die Kinder sich in ihrem eigenen Bereich vergnügen."
    ],
    "en": [
      "Seb & Nath will delight you with their authentic cuisine: Ardèche specialities, wood-fired pinsas, buckwheat pancakes... In fine weather, enjoy the shaded terrace while the children play in their own play area."
    ],
    "it": [
      "Seb & Nath vi delizieranno con la loro cucina autentica, tra cui specialità dell'Ardèche, pinsas cotte a legna e frittelle di grano saraceno... Con il bel tempo, godetevi la terrazza ombreggiata mentre i bambini giocano nella loro area giochi."
    ],
    "fr": [
      "Seb & Nath vous régalent avec une cuisine authentique : spécialités ardéchoises, pinsas au feu de bois, galettes de sarrasin… À la belle saison, profitez de la terrasse ombragée pendant que les enfants s’amusent dans leur espace dédié."
    ],
    "nl": [
      "Seb & Nath zullen je verrukken met hun authentieke keuken, waaronder specialiteiten uit de Ardèche, houtgestookte pinsas en boekweitpannenkoeken... Geniet bij mooi weer van het schaduwrijke terras terwijl de kinderen spelen in hun eigen speeltuin."
    ],
    "es": [
      "Seb & Nath le deleitarán con su cocina auténtica, que incluye especialidades de Ardèche, pinsas a la leña y tortitas de trigo sarraceno Si hace buen tiempo, aproveche la terraza a la sombra mientras los niños juegan en su propia zona de juegos."
    ]
  },
