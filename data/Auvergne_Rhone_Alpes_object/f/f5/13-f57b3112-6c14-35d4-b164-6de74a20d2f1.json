  "rdfs:comment": {
    "de": [
      "Zu Fuß, mit Schneeschuhen, Schlitten oder Langlaufskiern? Machen Sie mit Ihrer Familie einen Spaziergang entlang des Bachs."
    ],
    "en": [
      "On foot, snowshoes, sledge, cross-country skis... enjoy a family outing by the stream."
    ],
    "it": [
      "A piedi, con le racchette da neve, con la slitta o con gli sci da fondo, fate una gita in famiglia lungo il torrente."
    ],
    "fr": [
      "A pied, en raquettes, en luge, en ski de fond… partez pour une balade le long du ruisseau, en famille."
    ],
    "nl": [
      "Maak te voet, met sneeuwschoenen, sleeën of langlaufski's een gezinsuitstapje langs de beek."
    ],
    "es": [
      "A pie, con raquetas de nieve, trineos o esquís de fondo, haga una excursión familiar a lo largo del arroyo."
    ]
  },
