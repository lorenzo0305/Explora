  "rdfs:comment": {
    "de": [
      "Auf dem Gelände des Aqualib'-Zentrums wird Sie das Restaurant l'Eden nicht enttäuschen: Qualitätsküche, Vorspeisenbuffet und reichhaltige Tagesgerichte. Genießen Sie ein Eis, einen Crêpe oder eine Waffel auf der angenehmen und großen Terrasse, die im Sommer Schatten spendet."
    ],
    "en": [
      "Within the Aqualib' center, the Eden restaurant will not disappoint you : quality cuisine, buffet of starters and hearty daily specials. Enjoy an ice cream, crêpe or waffle on the pleasantly large terrace, shaded in summer."
    ],
    "it": [
      "All'interno del centro Aqualib', non rimarrete delusi dal ristorante Eden, che propone una cucina di qualità, un buffet di antipasti e sostanziosi piatti del giorno. Gustate un gelato, una crêpe o un waffle sulla piacevole e ampia terrazza, ombreggiata in estate."
    ],
    "fr": [
      "Dans l'enceinte du centre Aqualib', le restaurant l'Eden ne vous décevra pas : cuisine de qualité, buffet d'entrées et plats du jour copieux. Vous profiterez d'une glace, d'une crêpe ou de gaufre sur une agréable et grande terrasse ombragée en été."
    ],
    "nl": [
      "In het Aqualib'-centrum zult u niet teleurgesteld zijn in restaurant Eden, dat kwaliteitsgerechten, een buffet met voorgerechten en stevige dagschotels serveert. Geniet van een ijsje, crêpe of wafel op het aangename, grote terras, met schaduw in de zomer."
    ],
    "es": [
      "Dentro del centro Aqualib', no le decepcionará el restaurante Eden, que sirve cocina de calidad, un bufé de entrantes y abundantes platos del día. Disfrute de un helado, un crêpe o un gofre en la agradable y amplia terraza, a la sombra en verano."
    ]
  },
