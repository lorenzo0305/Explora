  "rdfs:comment": {
    "de": [
      "Genießen Sie ein außergewöhnliches Konzert mit der Kavalleriekapelle der Republikanischen Garde in Anwesenheit der Feuerwehrmusik des Departements Allier im Gabrielle-Robinne-Theater in Montluçon."
    ],
    "en": [
      "Come and enjoy an exceptional concert with the cavalry band of the Republican Guard in the presence of the Allier Fire Brigade Band at the Théâtre Gabrielle Robinne in Montluçon."
    ],
    "it": [
      "Venite a godervi un concerto eccezionale con la banda di cavalleria della Guardia Repubblicana e la banda dei Vigili del Fuoco di Allier al Théâtre Gabrielle Robinne di Montluçon."
    ],
    "fr": [
      "Venez profiter d'un concert exceptionnel avec la fanfare de cavalerie de la garde républicaine en présence de la Musique des Sapeurs-Pompiers de l'Allier au Théâtre Gabrielle Robinne de Montluçon."
    ],
    "es": [
      "Venga a disfrutar de un concierto excepcional con la banda de caballería de la Guardia Republicana y la Banda del Cuerpo de Bomberos de Allier en el Théâtre Gabrielle Robinne de Montluçon."
    ],
    "nl": [
      "Kom genieten van een uitzonderlijk concert met de cavalerie van de Republikeinse Garde en de Allier Fire Brigade Band in het Théâtre Gabrielle Robinne in Montluçon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert exceptionnel de la fanfare de cavalerie de la garde républicaine"
    ]
  },
