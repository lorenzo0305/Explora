  "rdfs:comment": {
    "de": [
      "Das Team der Freiwilligen bietet Ihnen eine Auswahl von 5000 Medien. Sie finden Romane, Comics, CDs und Kinderbücher. Der Zugang ist frei und kostenlos. Sie können an einem Arbeitsplatz oder über WLAN auf das Internet zugreifen."
    ],
    "en": [
      "The team of volunteers offers you a choice of 5000 documents. You'll find novels, comics, CDs and children's books. Access is free of charge. You can access the Internet from a workstation or via Wifi."
    ],
    "it": [
      "Il team di volontari vi offre una scelta di 5000 documenti. Troverete romanzi, fumetti, CD e libri per bambini. L'accesso è gratuito. È possibile accedere a Internet da una postazione o tramite Wifi."
    ],
    "fr": [
      "L'équipe des bénévoles vous propose un choix de 5000 documents. Vous trouverez des romans, des bandes dessinées, des CD et des livres pour enfants. L'accès est libre et gratuit. Vous pouvez accéder à internet à partir d'un poste ou par Wifi."
    ],
    "nl": [
      "Het team van vrijwilligers biedt je een keuze uit 5000 documenten. Je vindt er romans, stripboeken, cd's en kinderboeken. De toegang is gratis. Je hebt toegang tot internet vanaf een werkplek of via Wifi."
    ],
    "es": [
      "El equipo de voluntarios le ofrece una selección de 5000 documentos. Encontrará novelas, cómics, CD y libros infantiles. El acceso es gratuito. Puede acceder a Internet desde un puesto de trabajo o por Wifi."
    ]
  },
