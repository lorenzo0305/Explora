  "rdfs:comment": {
    "de": [
      "Der Lebensmittelladen von Louroux-Hodement existiert seit über 60 Jahren im Herzen des Dorfes! Er ist mehrmals umgezogen und hat nun seinen Standort in der Nähe der Kirche gefunden."
    ],
    "en": [
      "The Louroux-Hodement grocery store has existed for over 60 years in the heart of the village! It has moved several times and is now located near the church."
    ],
    "it": [
      "Il negozio di alimentari di Louroux-Hodement esiste da oltre 60 anni nel cuore del villaggio! Trasferitosi più volte, ha ora trovato la sua nuova sede vicino alla chiesa."
    ],
    "fr": [
      "L’épicerie de Louroux-Hodement existe depuis plus de 60 ans au coeur de ce village ! Elle a plusieurs fois déménagé et a trouvé désormais son emplacement près de l’église."
    ],
    "es": [
      "La tienda de ultramarinos de Louroux-Hodement existe desde hace más de 60 años en el corazón del pueblo Se ha trasladado varias veces y ahora ha encontrado su nuevo hogar cerca de la iglesia."
    ],
    "nl": [
      "De kruidenierswinkel in Louroux-Hodement bestaat al meer dan 60 jaar in het hart van het dorp! Hij is verschillende keren verhuisd en heeft nu zijn nieuwe thuis gevonden in de buurt van de kerk."
    ]
  },
  "rdfs:label": {
