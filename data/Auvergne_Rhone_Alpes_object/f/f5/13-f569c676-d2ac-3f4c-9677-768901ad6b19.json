  "rdfs:comment": {
    "de": [
      "La table du Mont Quichat bietet Ihnen eine traditionelle Küche, die nach Möglichkeit aus lokalen Produkten zubereitet wird, wobei kurze Wege zu den Erzeugern bevorzugt werden.\r\nReservierung empfohlen (per Telefon)"
    ],
    "en": [
      "La table du Mont Quichat offers traditional cuisine, made as much as possible from local products, favoring short circuits with producers.\r\nBy reservation."
    ],
    "it": [
      "La table du Mont Quichat offre una cucina tradizionale, preparata il più possibile con prodotti locali, privilegiando i circuiti brevi con i produttori\r\nPrenotazione consigliata (per telefono)"
    ],
    "fr": [
      "La table du Mont Quichat vous propose une cuisine traditionnelle, élaborée dans la mesure du possible à partir de produits locaux, privilégiant les circuits courts auprès de producteurs. \r\nRéservation conseillée (par téléphone)"
    ],
    "es": [
      "La table du Mont Quichat propone una cocina tradicional, elaborada en la medida de lo posible con productos locales y centrada en circuitos cortos con los productores.\r\nSe recomienda reservar (por teléfono)"
    ],
    "nl": [
      "La table du Mont Quichat biedt een traditionele keuken, zoveel mogelijk bereid met lokale producten, met een voorkeur voor korte circuits met producenten\r\nReservering aanbevolen (telefonisch)"
    ]
  },
  "rdfs:label": {
