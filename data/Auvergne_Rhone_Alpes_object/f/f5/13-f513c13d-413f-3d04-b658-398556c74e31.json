  "rdfs:comment": {
    "de": [
      "Kreationen von Schmuck und Glasobjekten\r\nIndividuell gestaltete Kreationen\r\n- Schmuckstücke aus Glasperlen, die von Hand mit der Flamme hergestellt werden\r\n- Schmuckstücke aus Glasteilen, die mithilfe der Fusing-Technik hergestellt wurden.\r\n- Dekorationsgegenstände aus Glas"
    ],
    "en": [
      "Jewelry and glassware creations\r\nPersonalized creations\r\n- Jewelry made from hand-crafted glass beads using the flame technique\r\n- Jewelry composed of glass pieces created using the fusing technique\r\n- Decorative glass objects"
    ],
    "it": [
      "Creazioni di gioielleria e vetreria\r\nCreazioni personalizzate\r\n- Gioielli realizzati con perle di vetro lavorate a mano con la fiamma\r\n- Gioielli realizzati con pezzi di vetro creati con la tecnica della fusione\r\n- Oggetti decorativi in vetro"
    ],
    "fr": [
      "Créations de bijoux et d'objets en verre \r\nCréations personnalisées\r\n- Bijoux composés de perles de verre réalisés manuellement à la flamme\r\n- Bijoux composés de pièces en verre crées en utilisant la technique du fusing\r\n- Objets de décoration en verre"
    ],
    "nl": [
      "Creaties van sieraden en glaswerk\r\nGepersonaliseerde creaties\r\n- Sieraden van glazen kralen met de hand gemaakt met een vlam\r\n- Sieraden van glaswerk gemaakt met de fusing techniek\r\n- Decoratieve glasobjecten"
    ],
    "es": [
      "Creaciones de joyería y cristalería\r\nCreaciones personalizadas\r\n- Joyas de cuentas de vidrio hechas a mano con llama\r\n- Joyas realizadas a partir de piezas de vidrio creadas mediante la técnica del fusing\r\n- Objetos decorativos de vidrio"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Claire Sarma Créations"
    ]
