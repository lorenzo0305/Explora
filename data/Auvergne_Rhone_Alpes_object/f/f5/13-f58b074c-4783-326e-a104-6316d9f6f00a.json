  "rdfs:comment": {
    "de": [
      "Willkommen im neuen Gourmet-Hideaway 15 Minuten von Roanne entfernt. Hier glauben wir an Einfachheit und Großzügigkeit. Ob Sie auf einen Kaffee vorbeikommen, auf der Suche nach einem Snack sind oder eine komplette Mahlzeit zu sich nehmen möchten, wir heißen Sie herzlich willkommen."
    ],
    "en": [
      "Welcome to the new \"repaire gourmand\" 15 minutes from Roanne. Here, we believe in simplicity and generosity. Whether you're passing through for a coffee, a snack or a full meal, we'll give you a warm welcome."
    ],
    "it": [
      "Benvenuti nel nuovo ritrovo gastronomico a 15 minuti da Roanne. Qui crediamo nella semplicità e nella generosità. Che siate di passaggio per un caffè, uno spuntino o un pasto completo, vi daremo un caloroso benvenuto."
    ],
    "fr": [
      "Bienvenue au nouveau repaire gourmand à 15 min de Roanne. Ici, nous croyons en la simplicité et en la générosité. Que vous soyez de passage pour un café, à la recherche d'un casse-croûte ou pour un repas complet, nous vous réservons un accueil chaleureux."
    ],
    "nl": [
      "Welkom bij de nieuwe gastronomische plek op 15 minuten van Roanne. Hier geloven we in eenvoud en vrijgevigheid. Of je nu op doorreis bent voor een kopje koffie, een snack of een volledige maaltijd, we heten je van harte welkom."
    ],
    "es": [
      "Bienvenido al nuevo rincón gastronómico a 15 minutos de Roanne. Aquí creemos en la sencillez y la generosidad. Tanto si está de paso para tomar un café, un tentempié o una comida completa, le daremos una cálida bienvenida."
    ]
  },
  "rdfs:label": {
