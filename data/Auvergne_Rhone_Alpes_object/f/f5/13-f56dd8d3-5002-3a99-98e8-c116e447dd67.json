  "rdfs:comment": {
    "de": [
      "In der Gemeinde Cruet zwischen Montmélian und Saint-Pierre-d'Albigny vor den Toren des Parc des Bauges gelegen, empfängt Sie das gesamte Team des Reitzentrums in einer familiären Atmosphäre."
    ],
    "en": [
      "The staff of the riding school welcomes you into a family atmosphere and offers you several activities such as baby poney (from 3 years old), group or individual lessons for all levels, courses, rides..."
    ],
    "it": [
      "Situato nel comune di Cruet, tra Montmélian e Saint-Pierre-d'Albigny, alle porte del Parc des Bauges, l'intero team del centro di equitazione vi accoglie in un'atmosfera familiare."
    ],
    "fr": [
      "Situé sur la commune de Cruet entre Montmélian et Saint-Pierre-d'Albigny aux portes du Parc des Bauges, toute l'équipe du centre équestre vous accueille dans une ambiance familiale."
    ],
    "es": [
      "Situado en la comuna de Cruet, entre Montmélian y Saint-Pierre-d'Albigny, a las puertas del Parque de Bauges, todo el equipo del centro hípico le da la bienvenida en un ambiente familiar."
    ],
    "nl": [
      "Gelegen in de gemeente Cruet tussen Montmélian en Saint-Pierre-d'Albigny aan de poort van het Parc des Bauges, ontvangt het hele team van de manege u in een familiale sfeer."
    ]
  },
