  "rdfs:comment": {
    "de": [
      "Auf dem Place Buffaven (oder Place de la Mairie) im Zentrum von Nyons stehen 88 Parkplätze zur Verfügung.\r\nDas Parken ist kostenlos, aber die Parkdauer ist auf 2 Stunden begrenzt. Ziehen Sie ein Ticket am Parkscheinautomaten.\r\nÖffentliche Toiletten vorhanden."
    ],
    "en": [
      "88 parking spaces are available on Place Buffaven (or Place de la Mairie) in the center of Nyons.\r\nFree parking, but limited to 2 hours. Take a ticket at the pay and display machine.\r\nPublic WC available."
    ],
    "it": [
      "88 posti auto sono disponibili in Place Buffaven (o Place de la Mairie) nel centro di Nyons\r\nParcheggio gratuito ma limitato a 2 ore. Prendete una multa al parchimetro.\r\nSono disponibili servizi igienici pubblici."
    ],
    "fr": [
      "88 places de parking sont disponibles sur la Place Buffaven (ou Place de la Mairie) en plein centre de Nyons. \r\nParking gratuit mais durée limitée à 2h de stationnement. Prendre un ticket à l'horodateur.\r\nPrésence de WC publics."
    ],
    "es": [
      "hay 88 plazas de aparcamiento disponibles en la plaza Buffaven (o plaza de la Mairie) en el centro de Nyons\r\nAparcamiento gratuito pero limitado a 2 horas. Toma un billete en el parquímetro.\r\nHay aseos públicos."
    ],
    "nl": [
      "Er zijn 88 parkeerplaatsen beschikbaar op de Place Buffaven (of Place de la Mairie) in het centrum van Nyons.\r\nGratis parkeren, maar beperkt tot 2 uur. Neem een kaartje bij de betaalautomaat.\r\nOpenbare toiletten beschikbaar."
    ]
  },
