  "rdfs:comment": {
    "de": [
      "Unser Restaurant 1827 bietet Ihnen Grillküche, regionale Gerichte und Empfehlungen des Chefkochs Salvatore Paci je nach Marktangebot des Tages."
    ],
    "en": [
      "The Restaurant By Georgette welcomes you for lunch and dinner, serving cuisine based on fresh local produce in a warm and relaxed atmosphere."
    ],
    "it": [
      "Il Ristorante By Georgette vi accoglie a pranzo e a cena per offrirvi una cucina a base di prodotti freschi e locali in un'atmosfera calda e rilassata."
    ],
    "fr": [
      "Le Restaurant By Georgette vous accueille midi et soir pour vous proposer une cuisine à base de produits frais et locaux dans un cadre chaleureux et une ambiance décontractée."
    ],
    "nl": [
      "Het Restaurant By Georgette verwelkomt u voor lunch en diner en biedt u een keuken op basis van verse en lokale producten in een warme en ontspannen sfeer."
    ],
    "es": [
      "El Restaurante By Georgette le da la bienvenida para el almuerzo y la cena para ofrecerle una cocina basada en productos frescos y locales en un ambiente cálido y relajado."
    ]
  },
