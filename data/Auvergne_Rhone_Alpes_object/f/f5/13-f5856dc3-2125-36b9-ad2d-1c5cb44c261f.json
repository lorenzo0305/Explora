  "rdfs:comment": {
    "de": [
      "eier vom Bauernhof.\r\nFleisch von Rindern der Charolais-Rasse in Kisten.\r\nHühner und Perlhühner küchenfertig.\r\nKochfertige Truthähne am Jahresende.\r\nVerkauf auf Bestellung."
    ],
    "en": [
      "farm eggs.\r\nCharolais beef in boxes.\r\nReady-to-cook chickens and guinea fowl.\r\nReady-to-cook turkeys at the end of the year.\r\nSale to order."
    ],
    "it": [
      "uova di fattoria.\r\nCarne di manzo Charolais in box.\r\nPolli e faraone pronti per la cottura.\r\nTacchini pronti da cuocere a fine anno.\r\nVendita su ordinazione."
    ],
    "fr": [
      "Œufs fermiers.\r\nViande de bœuf de race charolaise en caissette.\r\nPoulets et pintades prêts à cuire.\r\nDindes prêtes à cuire en fin d’année.\r\nVente sur commande."
    ],
    "es": [
      "huevos de granja.\r\nCarne de vacuno Charolais en cajas.\r\nPollos y pintadas listos para cocinar.\r\nPavos listos para cocinar a finales de año.\r\nVenta por encargo."
    ],
    "nl": [
      "eieren van de boerderij.\r\nCharolais rundvlees in dozen.\r\nKookrijpe kippen en parelhoenders.\r\nKookklare kalkoenen aan het eind van het jaar.\r\nVerkoop op bestelling."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Perrier"
    ]
  },
