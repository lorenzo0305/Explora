  "rdfs:comment": {
    "de": [
      "Herberge im Herzen des Dorfes Montpezat im Regionalen Naturpark Monts d'Ardèche. Der Betrieb wurde 2015 renoviert. Traditionelles Restaurant mit Produkten aus der Region und Aromen aus anderen Ländern."
    ],
    "en": [
      "Inn located in the heart of the village of Montpezat in the Monts d'Ardèche Regional Nature Park. Renovated in 2015. Traditional restaurant with local products and flavors from elsewhere."
    ],
    "it": [
      "Locanda situata nel cuore del villaggio di Montpezat, nel Parco Naturale Regionale Monts d'Ardèche. Ristrutturata nel 2015. Ristorante tradizionale con prodotti locali e sapori d'altrove."
    ],
    "fr": [
      "Auberge située au cœur du village de Montpezat dans le Parc Naturel Régional des Monts d'Ardèche. Établissement rénové en 2015. Restaurant traditionnel avec produits du terroir et saveurs d'ailleurs."
    ],
    "es": [
      "Posada situada en el corazón del pueblo de Montpezat, en el Parque Natural Regional de Monts d'Ardèche. Renovado en 2015. Restaurante tradicional con productos locales y sabores de otros lugares."
    ],
    "nl": [
      "Herberg gelegen in het hart van het dorp Montpezat in het regionale natuurpark Monts d'Ardèche. Gerenoveerd in 2015. Traditioneel restaurant met lokale producten en smaken van elders."
    ]
  },
