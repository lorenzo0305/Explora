  "rdfs:comment": {
    "de": [
      "Zwischen Wettkämpfen auf höchstem Niveau, außergewöhnlichen Spielern und spannenden Finalen verspricht die Atmosphäre intensiv … und zugleich gesellig zu werden."
    ],
    "en": [
      "With high-level competition, exceptional players, and thrilling finals, the atmosphere promises to be intense… and friendly."
    ],
    "it": [
      "Con una competizione di alto livello, giocatori eccezionali e finali emozionanti, l'atmosfera promette di essere intensa e amichevole."
    ],
    "fr": [
      "Entre compétition de haut niveau, présence de joueurs d’exception et finales palpitantes, l’ambiance promet d’être intense… et conviviale."
    ],
    "nl": [
      "Met topcompetities, uitzonderlijke spelers en spannende finales belooft het een intense en vriendelijke sfeer te worden."
    ],
    "es": [
      "Con una competición de alto nivel, jugadores excepcionales y finales emocionantes, el ambiente promete ser intenso... y amistoso."
    ]
  },
