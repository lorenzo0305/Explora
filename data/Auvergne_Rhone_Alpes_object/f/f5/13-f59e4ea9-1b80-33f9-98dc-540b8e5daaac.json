  "rdfs:comment": {
    "de": [
      "Nach einigen Kilometern zwischen Brioude und Vieille-Brioude verlässt die Via Allier-Route endgültig die Limagne-Ebenen."
    ],
    "en": [
      "After a few kilometers between Brioude and Vieille-Brioude, the Via Allier route leaves the Limagne plains for good."
    ],
    "it": [
      "Dopo pochi chilometri tra Brioude e Vieille-Brioude, il percorso della Via Allier lascia definitivamente le pianure della Limagne."
    ],
    "fr": [
      "Après quelques kilomètres entre Brioude et Vieille-Brioude, l'itinéraire de la Via Allier quitte définitivement les plaines de Limagne."
    ],
    "es": [
      "Tras unos kilómetros entre Brioude y Vieille-Brioude, la ruta de la Via Allier abandona definitivamente las llanuras de Limagne."
    ],
    "nl": [
      "Na een paar kilometer tussen Brioude en Vieille-Brioude verlaat de Via Allier de vlakte van de Limagne voorgoed."
    ]
  },
