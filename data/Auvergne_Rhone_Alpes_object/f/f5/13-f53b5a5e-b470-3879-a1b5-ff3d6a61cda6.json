  "rdfs:comment": {
    "de": [
      "Ein authentisches Dekor, eine warme Atmosphäre, eine sensible Küche mit Blick auf den See von Annecy\r\nLa Table de Yoann Conte ist vor allem ein Ort, der den Emotionen gewidmet ist."
    ],
    "en": [
      "An authentic decor, a warm atmosphere, sensitive cuisine overlooking Lake Annecy\r\nLa Table de Yoann Conte is above all a place dedicated to emotion."
    ],
    "it": [
      "Un ambiente autentico, un'atmosfera calda, una cucina sensibile con vista sul lago di Annecy.\r\nLa Table de Yoann Conte è soprattutto un luogo dedicato alle emozioni."
    ],
    "fr": [
      "Un décor authentique, une ambiance chaleureuse, une cuisine sensible face au Lac d’Annecy.\r\nLa Table de Yoann Conte est avant tout un lieu dédié à l’émotion."
    ],
    "es": [
      "Un marco auténtico, un ambiente cálido, una cocina sensible con vistas al lago de Annecy.\r\nLa Table de Yoann Conte es ante todo un lugar dedicado a la emoción."
    ],
    "nl": [
      "Een authentiek kader, een warme sfeer, een gevoelige keuken met uitzicht op het meer van Annecy.\r\nLa Table de Yoann Conte is bovenal een plek gewijd aan emotie."
    ]
  },
