  "rdfs:comment": {
    "de": [
      "Begleite Charles, einen Teenager auf der Suche nach sich selbst, auf einer außergewöhnlichen Reise, bei der er sich danach sehnt, die größten Musicals unserer Zeit zu singen und auf der Bühne zu spielen!"
    ],
    "en": [
      "Join Charles, a teenager in search of himself, on an extraordinary journey where he aspires to sing and perform on stage the greatest musicals of our time!"
    ],
    "it": [
      "Unisciti a Charles, un adolescente alla ricerca di se stesso, in un viaggio straordinario mentre aspira a cantare e ad esibirsi sul palco dei più grandi musical del nostro tempo!"
    ],
    "fr": [
      "Accompagnez Charles, un adolescent à la recherche de lui-même, dans un voyage extraordinaire où il aspire à chanter et à jouer sur scène les plus grandes comédies musicales de notre temps !"
    ],
    "es": [
      "Únete a Charles, un adolescente en busca de sí mismo, en un viaje extraordinario en el que aspira a cantar e interpretar en el escenario los mejores musicales de nuestro tiempo"
    ],
    "nl": [
      "Ga mee met Charles, een tiener op zoek naar zichzelf, op een buitengewone reis als hij de grootste musicals van onze tijd wil zingen en uitvoeren!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "ANNULE  - Au choeur des comédies musicales"
    ]
  },
