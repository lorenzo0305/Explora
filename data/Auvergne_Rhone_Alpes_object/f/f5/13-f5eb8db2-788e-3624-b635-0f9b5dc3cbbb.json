  "rdfs:comment": {
    "de": [
      "Apotheke mit einer Sammlung von 84 Lyoner Steinguttöpfen mit einem blauen Dekor aus drei Haselnüssen und Holzvertäfelungen aus dem 18. Jahrhundert, die durch eine Glastür von der Eingangshalle des Krankenhauses aus zu sehen ist. Foto Francis Vauban"
    ],
    "en": [
      "Apothecary's dispensary, with a collection of 84 blue \"three hazelnut\"-pattern Lyon pottery jars and 18th-century wood panelling, which can be viewed through the glass doors from the entrance of the hospital."
    ],
    "it": [
      "Spezieria con una collezione di 84 vasi di terracotta di Lione decorati in tre blu nocciola e rivestimenti in legno del XVIII secolo, visibile dalla hall dell'ospedale attraverso la porta a vetri. Foto Francis Vauban"
    ],
    "fr": [
      "Apothicairerie dotée d'une collection de 84 pots en faïence de Lyon au décor bleu trois noisettes et de boiseries du 18è siècle, visible du hall de l'hôpital  par sa porte vitrée. Photo Francis Vauban"
    ],
    "es": [
      "Botica con una colección de 84 vasijas de barro de Lyon decoradas en tres tonos de azul avellana y revestimientos de madera del siglo XVIII, visible desde el vestíbulo del hospital a través de su puerta acristalada. Foto Francis Vauban"
    ],
    "nl": [
      "Apotheek met een collectie van 84 Lyon aardewerken potten versierd in drie hazelnootblauwe tinten en 18e-eeuwse houten lambrisering, zichtbaar vanuit de hal van het ziekenhuis door de glazen deur. Foto Francis Vauban"
    ]
  },
  "rdfs:label": {
    "en": [
      "Apothecary"
    ],
    "fr": [
      "Apothicairerie"
    ]
  },
