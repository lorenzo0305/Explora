      "@id": "https://data.datatourisme.fr/3160fe08-8cef-3746-a5ba-2c4719e8f7da",
      "dc:description": {
        "de": [
          "Der Verein À Petits Pas organisiert eine Foot Challenge im Fußballstadion Bigot in Fruges\nOffen für Jugendliche zwischen 16 und 30 Jahren\nDecathlon-Geschenkkarten zu gewinnen"
        ],
        "en": [
          "The association À Petits Pas is organizing a Foot Challenge at the Bigot soccer stadium in Fruges\nOpen to young people aged 16 to 30\nDécathlon gift cards to be won"
        ],
        "it": [
          "L'associazione À Petits Pas organizza una sfida a piedi presso lo stadio di calcio Bigot di Fruges\nAperto ai giovani dai 16 ai 30 anni\nIn palio carte regalo Décathlon"
        ],
        "fr": [
          "L'association À Petits Pas organise un Foot Challenge au stade de football Bigot de Fruges\nOuvert aux jeunes de 16 à 30 ans\nCartes cadeaux Décathlon à gagner"
        ],
        "es": [
          "La asociación À Petits Pas organiza un Foot Challenge en el estadio de fútbol Bigot de Fruges\nAbierto a jóvenes de 16 a 30 años\nTarjetas regalo del Decathlon"
        ],
        "nl": [
          "De vereniging À Petits Pas organiseert een Foot Challenge in het Bigot voetbalstadion in Fruges\nOpen voor jongeren van 16 tot 30 jaar\nDécathlon cadeaubonnen te winnen"
        ]
      },
