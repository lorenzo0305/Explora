  "rdfs:comment": {
    "de": [
      "Feiern Sie vier Tage lang das Abenteuer und die Entdeckung! Entdecken Sie die offizielle Auswahl der 11 Filme, die von einer außergewöhnlichen Jury und Ihnen, dem Publikum, beurteilt werden."
    ],
    "en": [
      "Celebrate adventure and discovery for four days! Discover the official selection of 11 films which will be judged by an exceptional jury and you, the public."
    ],
    "it": [
      "Festeggia l'avventura e la scoperta per quattro giorni! Scopri la selezione ufficiale di 11 film che saranno giudicati da una giuria d'eccezione e da te, il pubblico."
    ],
    "fr": [
      "Célébrez l'aventure et la découverte pendant quatre jours ! Découvrez la sélection officielle des 11 films qui seront jugés par un jury exceptionnel et vous, le public."
    ],
    "nl": [
      "Vier vier dagen lang avontuur en ontdekking! Ontdek de officiële selectie van 11 films die beoordeeld zullen worden door een uitzonderlijke jury en jou, het publiek."
    ],
    "es": [
      "Celebre la aventura y el descubrimiento durante cuatro días Descubra la selección oficial de 11 películas que serán valoradas por un jurado excepcional y por usted, el público."
    ]
  },
