  "rdfs:comment": {
    "de": [
      "Private Strecke der Couze Chambon, die sich von der Rivalet-Brücke (RD 996) bis zum Dorf Les Granges (7Km) erstreckt.\r\nHier werden regelmäßig Bachforellen ausgesetzt. Karte des örtlichen Angelvereins erforderlich."
    ],
    "en": [
      "Couze Chambon, private fishing"
    ],
    "it": [
      "Un tratto privato della Couze Chambon che si estende dal ponte di Rivalet (RD 996) al villaggio di Les Granges (7 km).\r\nLe trote fario vengono rilasciate regolarmente. È richiesta la tessera del club di pesca locale."
    ],
    "fr": [
      "Parcours privé de la couze Chambon qui s'étend du pont du Rivalet (RD 996) au village des Granges (7Km).\r\nDes lâchers de truite farios réguliers y sont effectués. Carte de la société de pêche locale obligatoire."
    ],
    "es": [
      "Tramo privado del Couze Chambon que se extiende desde el puente de Rivalet (RD 996) hasta el pueblo de Les Granges (7 km).\r\nSe sueltan truchas marrones con regularidad. Se requiere el carné del club de pesca local."
    ],
    "nl": [
      "Een privégedeelte van de Couze Chambon dat zich uitstrekt van de brug van Rivalet (RD 996) tot het dorp Les Granges (7 km).\r\nEr wordt regelmatig beekforel uitgezet. Lokale visclubkaart vereist."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site de pêche de la Couze Chambon à Saint-Nectaire"
    ]
  },
