  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum von Clermont-Ferrand steht Bougnat Burger für den ganzen Reichtum der Region Auvergne in köstlichen hausgemachten Burgern."
    ],
    "en": [
      "In the heart of downtown Clermont-Ferrand, Bougnat Burger offers all the riches of the Auvergne region in delicious homemade burgers."
    ],
    "it": [
      "Nel centro di Clermont-Ferrand, Bougnat Burger offre tutte le ricchezze della regione dell'Alvernia in deliziosi hamburger fatti in casa."
    ],
    "fr": [
      "En plein centre-ville de Clermont-Ferrand, Bougnat Burger c'est toutes les richesses de la région Auvergne dans de délicieux burgers maison."
    ],
    "nl": [
      "In het centrum van Clermont-Ferrand biedt Bougnat Burger alle rijkdommen van de Auvergne in heerlijke huisgemaakte hamburgers."
    ],
    "es": [
      "En el centro de Clermont-Ferrand, Bougnat Burger ofrece toda la riqueza de la región de Auvernia en deliciosas hamburguesas caseras."
    ]
  },
