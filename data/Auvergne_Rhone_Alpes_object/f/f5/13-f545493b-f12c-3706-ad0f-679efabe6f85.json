  "rdfs:comment": {
    "de": [
      "Der Dualski ist für Menschen mit Behinderungen der unteren Gliedmaßen gedacht. Er ermöglicht ihnen nach einer Einführung den Zugang zu den Freuden des Skifahrens und ermöglicht ihnen, selbstständig und leistungsstark Ski zu fahren."
    ],
    "en": [
      "Dualskis are intended for people with lower limb disability. They let you ski on your own and achieve the same results as the best able-bodied skiers."
    ],
    "it": [
      "Il Dualski è progettato per le persone con disabilità agli arti inferiori. Dopo un corso introduttivo, permette loro di accedere ai piaceri dello sci e di sciare in modo indipendente ed efficiente."
    ],
    "fr": [
      "Le Dualski est destiné aux personnes ayant une incapacité des membres inférieurs. Il leur permet après une initiation d'accéder aux plaisirs de la glisse et de skier de façon autonome et performante."
    ],
    "nl": [
      "Samoëns biedt speciale lessen voor gehandicapte skiers met gekwalificeerde instructeurs en speciaal aangepaste apparatuur."
    ],
    "es": [
      "El Dualski está diseñado para personas con discapacidades en los miembros inferiores. Tras un curso de iniciación, les da acceso a los placeres del esquí y les permite esquiar de forma autónoma y eficaz."
    ]
  },
  "rdfs:label": {
    "en": [
      "Dualski loan"
    ],
    "fr": [
      "Prêt Dualski"
    ],
    "nl": [
      "Dualski -uitrusting lenen"
    ]
  },
