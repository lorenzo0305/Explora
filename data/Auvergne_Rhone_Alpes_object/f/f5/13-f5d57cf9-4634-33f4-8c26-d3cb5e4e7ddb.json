  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Table de la Traye bei Ihrem Mittagessen und genießen Sie die Küche mit lokalen Aromen von Chefkoch Renaud Couston, während Sie den atemberaubenden Blick auf die umliegenden Berge bewundern. Nach vorheriger Reservierung."
    ],
    "en": [
      "Discover the Table de la Traye for lunch and savour the local cuisine of Chef Renaud Couston while admiring the breathtaking views of the surrounding mountains. Reservations required."
    ],
    "it": [
      "Scoprite la Table de la Traye per il pranzo e assaporate la cucina locale dello chef Renaud Couston ammirando la vista mozzafiato sulle montagne circostanti. È necessaria la prenotazione."
    ],
    "fr": [
      "Découvrez la Table de la Traye à l'occasion de vos déjeuners et savourez une cuisine aux saveurs locales du Chef Renaud Couston tout en admirant la vue imprenable sur les montagnes environnantes. Sur réservation."
    ],
    "nl": [
      "Ontdek de Table de la Traye voor de lunch en geniet van de lokale keuken van chef-kok Renaud Couston terwijl je het adembenemende uitzicht op de omringende bergen bewondert. Reserveren verplicht."
    ],
    "es": [
      "Descubra la Table de la Traye para almorzar y saborear la cocina local del Chef Renaud Couston mientras admira las impresionantes vistas de las montañas circundantes. Reserva obligatoria."
    ]
  },
