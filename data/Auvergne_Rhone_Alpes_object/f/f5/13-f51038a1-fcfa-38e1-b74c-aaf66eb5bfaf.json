  "rdfs:comment": {
    "de": [
      "In La Garde-Adhémar bietet unser Restaurant eine hausgemachte, einfache und leckere Küche, in der alle Produkte vor Ort aus rohen Zutaten bearbeitet und verarbeitet werden."
    ],
    "en": [
      "In La Garde-Adhémar, our restaurant offers simple, gourmet, home-cooked cuisine where all products are worked and processed on site using raw ingredients."
    ],
    "it": [
      "A La Garde-Adhémar, il nostro ristorante offre una cucina semplice, gourmet e casalinga, dove tutti i prodotti sono preparati e lavorati in loco con ingredienti grezzi."
    ],
    "fr": [
      "A La Garde-Adhémar, notre restaurant propose une cuisine faite maison, simple et gourmande où tous les produits sont travaillés et transformés sur place à partir d'ingrédients bruts."
    ],
    "nl": [
      "In La Garde-Adhémar biedt ons restaurant een eenvoudige, gastronomische, huisgemaakte keuken waar alle producten ter plekke worden bereid en verwerkt met rauwe ingrediënten."
    ],
    "es": [
      "En La Garde-Adhémar, nuestro restaurante ofrece una cocina sencilla, gastronómica y casera, en la que todos los productos se preparan y elaboran in situ a partir de materias primas."
    ]
  },
  "rdfs:label": {
