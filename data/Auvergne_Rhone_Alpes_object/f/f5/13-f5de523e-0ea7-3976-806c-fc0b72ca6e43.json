  "rdfs:comment": {
    "de": [
      "Ein Pumptrack ist eine Rundstrecke, die aus Buckeln und Steilkurven besteht und mit Mountainbikes, BMX-Rädern, Skateboards, Inlineskates oder Rollern befahren werden kann."
    ],
    "en": [
      "The pump track can be used by mountain bikes, BMX, rollerblades and scooters."
    ],
    "it": [
      "Una pump track è una pista ad anello composta da dossi e curve a gomito che può essere utilizzata da mountain bike, BMX, skateboard, rollerblade o monopattini."
    ],
    "fr": [
      "La pump track est une piste en boucle, constituée de bosses et de virages relevés et peut être utilisée en VTT, BMX, skateboard, rollers ou trottinettes."
    ],
    "es": [
      "Un pump track es una pista en bucle formada por baches y curvas peraltadas por la que pueden circular bicicletas de montaña, BMX, monopatines, patines o patinetes."
    ],
    "nl": [
      "Een pump track is een lusvormige baan met hobbels en scherpe bochten die gebruikt kan worden door mountainbikes, BMX-fietsen, skateboards, skeelers of scooters."
    ]
  },
