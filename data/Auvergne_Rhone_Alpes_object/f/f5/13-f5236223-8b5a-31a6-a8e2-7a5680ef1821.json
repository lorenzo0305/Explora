  "rdfs:comment": {
    "de": [
      "Es scheint, dass die Pfarrei 1152 unter der Herrschaft des Grafen von Savoyen, Humbert III. dem Seligen, von den Rodungsmönchen der nahe gelegenen Abtei von Entremont gegründet wurde."
    ],
    "en": [
      "It would appear that the parish was created in 1152, under the reign of Humbert III le Bienheureux, Count of Savoy, by pioneer monks from the Abbey of Entremont close by."
    ],
    "it": [
      "Sembra che la parrocchia sia stata creata nel 1152, sotto il regno del conte di Savoia Umberto III il Benedetto, dai monaci della vicina abbazia di Entremont."
    ],
    "fr": [
      "Il semble que la paroisse soit créée en 1152, sous le règne du comte de Savoie, Humbert III le Bienheureux, par les  moines défricheurs de l'Abbaye d'Entremont toute proche."
    ],
    "es": [
      "Parece ser que la parroquia fue creada en 1152, bajo el reinado del Conde de Saboya, Humberto III el Bendito, por los monjes de la cercana Abadía de Entremont."
    ],
    "nl": [
      "Het schijnt dat de parochie in 1152, onder het bewind van de graaf van Savoye, Humbert III de Gezegende, werd opgericht door de monniken van de nabijgelegen abdij van Entremont."
    ]
  },
