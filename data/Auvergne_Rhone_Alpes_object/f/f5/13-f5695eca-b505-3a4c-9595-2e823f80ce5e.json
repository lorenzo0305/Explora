  "rdfs:comment": {
    "de": [
      "Mountainbike-Tour auf den Ausläufern des Revermont für eine Entdeckungstour, bei der die Landschaft und das Kulturerbe im Vordergrund stehen.\r\nAU Anfang auf den Vorgebirgen und zum Schluss am Fuß der Berge."
    ],
    "en": [
      "A VTTAE circuit in the foothills of the Revermont region for a discovery ride that gives pride of place to the landscape and heritage.\nFrom the foothills to the foot of the mountains."
    ],
    "it": [
      "Sentiero VTTAE ai piedi del Revermont per una passeggiata alla scoperta del paesaggio e del patrimonio.\r\nDalla pedemontana ai piedi delle montagne."
    ],
    "fr": [
      "Circuit VTTAE sur les contreforts du Revermont pour une balade découverte qui fait la part belle au paysage et au patrimoine.\r\nAU début sur les contreforts et pour finir au pied des monts."
    ],
    "es": [
      "Sendero VTTAE en las estribaciones del Revermont para un paseo de descubrimiento que enorgullece el paisaje y el patrimonio.\r\nDe las estribaciones a los pies de las montañas."
    ],
    "nl": [
      "Een VTTAE parcours in de uitlopers van de Revermont voor een ontdekkingstocht die het landschap en het erfgoed eer aandoet.\r\nVan de uitlopers tot de voet van de bergen."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE circuit n°9 (red) Revers du Revermont"
    ],
    "fr": [
      "Circuit VTTAE n°9 (rouge) Revers du Revermont"
    ]
  },
