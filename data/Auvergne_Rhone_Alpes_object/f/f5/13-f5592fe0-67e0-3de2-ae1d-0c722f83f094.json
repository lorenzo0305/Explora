  "rdfs:comment": {
    "de": [
      "Der Palais des Congrès et des Expositions Jacques Chirac in Valence empfängt alle Ihre Geschäftsveranstaltungen, Ausstellungen, Messen und Ausstellungen im Herzen des Rhônetals.\r\n\r\n10 Minuten zu Fuß vom Bahnhof Valence ville entfernt.\r\nKostenloser Parkplatz mit 400 Plätzen."
    ],
    "en": [
      "The Palais des Congrès et des Expositions Jacques Chirac in Valence is the ideal venue for all your business events, exhibitions and trade fairs in the heart of the Rhône Valley. A 10-minute walk from Valence Ville train station. Free parking for 400 cars."
    ],
    "it": [
      "Il Palais des Congrès et des Expositions Jacques Chirac di Valence ospita tutti gli eventi aziendali, le mostre, le fiere e le esposizioni nel cuore della Valle del Rodano.\r\n\r\nA soli 10 minuti a piedi dalla stazione di Valence.\r\nParcheggio gratuito con 400 posti auto."
    ],
    "fr": [
      "Le Palais des Congrès et des Expositions Jacques Chirac de Valence accueille tous vos événements professionnels, expositions, foires et salons au cœur de la Vallée du Rhône. \r\n\r\nA 10 minutes à pied de la gare Valence ville. \r\nParking gratuit de 400 places."
    ],
    "nl": [
      "Het Palais des Congrès et des Expositions Jacques Chirac in Valence is de ideale locatie voor al uw zakelijke evenementen, tentoonstellingen, beurzen en vakbeurzen in het hart van de Rhônevallei. Op slechts 10 minuten lopen van het station van Valence. Gratis parkeerterrein met 400 plaatsen."
    ],
    "es": [
      "El Palacio de Congresos y Exposiciones Jacques Chirac de Valence acoge todos sus eventos empresariales, exposiciones, ferias y salones en el corazón del Valle del Ródano.\r\n\r\nA 10 minutos a pie de la estación de Valence.\r\nAparcamiento gratuito con 400 plazas."
    ]
  },
