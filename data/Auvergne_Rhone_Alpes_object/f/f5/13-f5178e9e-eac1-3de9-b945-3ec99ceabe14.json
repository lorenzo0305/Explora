  "rdfs:comment": {
    "de": [
      "Als sommerlicher Badeteich ist er auch ein angenehmer Angelteich mit zwei behindertengerechten Angelstegen, nur einen Steinwurf von Chambéry entfernt."
    ],
    "en": [
      "Not only is it a summer bathing lake, it's also a pleasant fishing lake just a stone's throw from Chambéry."
    ],
    "it": [
      "Questo lago balneabile estivo è anche un piacevole lago per la pesca a due passi da Chambéry."
    ],
    "fr": [
      "Plan d'eau de baignade estivale, il est aussi un agréable plan d'eau de pêche équipé de 2 pontons de pêche accessible aux personnes à mobilité réduite à deux pas de Chambéry."
    ],
    "es": [
      "Este lago de baño de verano es también un agradable lago de pesca con 2 pontones de pesca accesibles para personas con movilidad reducida, a dos pasos de Chambéry."
    ],
    "nl": [
      "Dit zomerse zwemmeer is ook een aangenaam vismeer op een steenworp afstand van Chambéry."
    ]
  },
  "rdfs:label": {
    "en": [
      "Family fishing course at Challes-les-Eaux lake"
    ],
    "it": [
      "Corso di pesca \"per famiglie\" al lago di Challes-les-Eaux"
    ],
    "fr": [
      "Parcours pêche \"famille\" du plan d’eau de Challes-les-Eaux"
    ],
    "nl": [
      "Cursus \"vissen met het gezin\" op het meer van Challes-les-Eaux"
    ]
  },
