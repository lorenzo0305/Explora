  "rdfs:comment": {
    "de": [
      "Das Restaurant La Corne d'Or in Corenc liegt hoch über der Stadt Grenoble und bietet einen außergewöhnlichen Blick auf das Belledonne-Massiv.\r\nDie Gäste können ihre Gerichte genießen, während sie sich an dem einzigartigen Panorama erfreuen, das ihnen geboten wird."
    ],
    "en": [
      "Overlooking the city of Grenoble from Corenc, the Corne d'Or restaurant  provides an amazing view over the Belledonne massif. The guests may enjoy their courses while reveling in the unique mountain sight."
    ],
    "it": [
      "Affacciato sulla città di Grenoble, il ristorante La Corne d'Or, situato a Corenc, offre una vista eccezionale sul massiccio di Belledonne.\r\nGli ospiti possono gustare i loro pasti ammirando un panorama unico."
    ],
    "fr": [
      "Surplombant la ville de Grenoble, le restaurant La Corne d'Or, situé à Corenc, offre une vue exceptionnelle sur le massif de Belledonne.\r\nLes convives peuvent savourer leurs plats tout en se délectant du panorama unique qui leur est proposé."
    ],
    "nl": [
      "Het restaurant La Corne d'Or in Corenc kijkt uit over de stad Grenoble en biedt een uitzonderlijk uitzicht op het massief van Belledonne.\r\nGasten kunnen genieten van hun maaltijden terwijl ze genieten van het unieke panorama."
    ],
    "es": [
      "Con vistas a la ciudad de Grenoble, el restaurante Corne d'Or de Corenc ofrece una vista excepcional del macizo de Belledonne.\r\nLos huéspedes pueden saborear sus platos mientras contemplan un panorama único."
    ]
  },
