  "rdfs:comment": {
    "de": [
      "Für eine Wellness-Pause oder eine Begleitung kümmere ich mich um Sie, bei einer Massage, einer energetischen Behandlung, einer Reflexologie oder einer Sophrologie-Sitzung.\nNach Vereinbarung."
    ],
    "en": [
      "For a wellness break or support, I'll take care of you with a massage, energetic treatment, reflexology or sophrology session.\nBy appointment only."
    ],
    "it": [
      "Per una pausa di benessere o di sostegno, mi prenderò cura di voi con un massaggio, un trattamento energetico, una riflessologia o una seduta di terapia di rilassamento.\nSolo su appuntamento."
    ],
    "fr": [
      "Pour une pause bien-être ou un accompagnement, je prendrai soin de vous, lors d'un massage, soin énérgétique, réfléxologie ou une séance de sophrologie.\nSur rendez-vous."
    ],
    "nl": [
      "Voor een wellnesspauze of ondersteuning zorg ik voor je met een massage, energetische behandeling, reflexologie of een sessie ontspanningstherapie.\nAlleen op afspraak."
    ],
    "es": [
      "Para una pausa de bienestar o de apoyo, le atenderé con un masaje, un tratamiento energético, reflexología o una sesión de terapia de relajación.\nSólo con cita previa."
    ]
  },
