  "rdfs:comment": {
    "de": [
      "In einem orientalischen Dekor können Sie türkische Spezialitäten genießen: verschiedene Sandwiches, Salate, Gegrilltes, Getränke und Gerichte zum Mitnehmen."
    ],
    "en": [
      "With its oriental décor, come and try Turkish specialities : various sandwiches, drinks and take away dishes."
    ],
    "it": [
      "Venite a gustare le specialità turche in un ambiente orientale: una varietà di panini, insalate, grigliate, bevande e piatti da asporto."
    ],
    "fr": [
      "Dans un décor oriental, venez déguster des spécialités turques : sandwich variés, salades, grillades, boissons et plats à emporter."
    ],
    "es": [
      "Venga a degustar especialidades turcas en un ambiente oriental: gran variedad de bocadillos, ensaladas, parrilladas, bebidas y comida para llevar."
    ],
    "nl": [
      "Kom genieten van Turkse specialiteiten in een oosterse omgeving: een verscheidenheid aan broodjes, salades, grillgerechten, drankjes en afhaalmaaltijden."
    ]
  },
