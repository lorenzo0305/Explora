  "rdfs:comment": {
    "de": [
      "Kletterfelsen mit 5 Sektoren und 51 Routen.\r\nSchwierigkeitsgrad von 3 bis 7b.\r\nmaximale Höhe von 15 m.\r\nAbseilen ist möglich.\r\nFelsen aus Granit.\r\nParkplatz und Toiletten vor Ort."
    ],
    "en": [
      "Climbing rock with 5 sectors and 51 routes.\r\nDifficulty levels from 3 to 7b.\r\nmaximum height 15m.\r\nAbseiling possible.\r\nGranite rock.\r\nParking and toilets on site."
    ],
    "it": [
      "Arrampicata su roccia con 5 settori e 51 vie.\r\nLivelli di difficoltà da 3 a 7b.\r\naltezza massima 15 m.\r\nPossibilità di discesa in corda doppia.\r\nRoccia di granito.\r\nParcheggio e servizi igienici in loco."
    ],
    "fr": [
      "Rocher d'escalade avec 5 secteurs et 51 voies. \r\nNiveau de difficulté de 3 à 7b.\r\n15m de hauteur maximum. \r\nRappel possible.\r\nRoche granite. \r\nParking et toilettes sur place."
    ],
    "nl": [
      "Rotsklimmen met 5 sectoren en 51 routes.\r\nMoeilijkheidsgraden van 3 tot 7b.\r\nmaximale hoogte 15m.\r\nAbseilen mogelijk.\r\nGranieten rots.\r\nParkeerplaats en toiletten op het terrein."
    ],
    "es": [
      "Escalada en roca con 5 sectores y 51 vías.\r\nNiveles de dificultad de 3 a 7b.\r\naltura máxima 15 m.\r\nPosibilidad de rápel.\r\nRoca de granito.\r\nAparcamiento y aseos."
    ]
  },
