  "rdfs:comment": {
    "de": [
      "Das Team der Mediathek in Valezan bietet dem Publikum eine breite Palette an Lesestoff. Ob Erwachsene oder Kinder, für jeden Geschmack ist etwas dabei!"
    ],
    "en": [
      "The Valezan public library offers a wide range of reading for everyone, adults and children!"
    ],
    "it": [
      "Il team della mediateca Valezan offre al pubblico un'ampia gamma di letture. Che siate adulti o bambini, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "L'équipe de la médiathèque de Valezan offre au public un large panel de lectures. Que l'on soit adulte ou enfant, il y en a pour tous les goûts !"
    ],
    "nl": [
      "Het team van de bibliotheek van Valezan biedt het publiek een breed scala aan leesmateriaal. Of u nu een volwassene of een kind bent, er is voor elk wat wils!"
    ],
    "es": [
      "El equipo de la mediateca valezana ofrece al público un amplio abanico de lecturas. Tanto para adultos como para niños, ¡hay para todos los gustos!"
    ]
