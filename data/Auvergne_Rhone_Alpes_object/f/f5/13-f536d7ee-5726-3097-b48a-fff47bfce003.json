  "rdfs:comment": {
    "de": [
      "ALEYRAC (450m alt): Versteckt in einer Talmulde, nicht weit von der Straße entfernt, entdeckt man die Ruinen der Kirche Notre-Dame-la-Brune (als historisches Monument klassifiziert), ein Überbleibsel des Priorats von Aleyrac, einem Monument der romanischen Provence."
    ],
    "en": [
      "ALEYRAC (450m alt): tucked away in a valley a short distance from the road are the ruins of Notre-Dame-la-Brune church (listed as a historic monument), the remains of the Aleyrac priory, a landmark of Romanesque Provence."
    ],
    "it": [
      "ALEYRAC (450 m s.l.m.): nascoste nella conca di una valle a poca distanza dalla strada, scoprirete le rovine della chiesa di Notre-Dame-la-Brune (classificata come monumento storico), i resti del priorato di Aleyrac, monumento del romanico provenzale."
    ],
    "fr": [
      "ALEYRAC (450m alt) : caché au creux d'un vallon à peu de distance de la route, on découvre les ruines de l'église Notre-Dame-la-Brune (classée Monument Historique), reste du prieuré d'Aleyrac, monument de la Provence romane."
    ],
    "nl": [
      "ALEYRAC (450m hoogte): verscholen in een vallei op korte afstand van de weg liggen de ruïnes van de kerk Notre-Dame-la-Brune (geklasseerd als Historisch Monument), de overblijfselen van de priorij van Aleyrac, een monument van de Romaanse Provence."
    ],
    "es": [
      "ALEYRAC (450 m de altitud): escondidas en la hondonada de un valle a poca distancia de la carretera, descubrirá las ruinas de la iglesia de Notre-Dame-la-Brune (clasificada como monumento histórico), los restos del priorato de Aleyrac, monumento del románico provenzal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village d'Aleyrac"
    ]
  },
