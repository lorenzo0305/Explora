  "rdfs:comment": {
    "de": [
      "Inmitten der Natur, zwischen Alpen und Rhône, nur wenige Schritte vom erstaunlichen Palais Idéal des Faktor Cheval entfernt, empfangen Sie Domitille und Jérôme, die neuen Besitzer des Ortes, in ihrem Etablissement mit Einfachheit, Raffinesse und Gastfreundschaft."
    ],
    "en": [
      "In the heart of nature, in between the Alps and the Rhône River, next to the surprising \"Palais Idéal du facteur Cheval\", the Graillat family welcomes you as friends, in an authentic and refined setting."
    ],
    "it": [
      "Nel cuore della natura, tra le Alpi e il Rodano, a due passi dal sorprendente Palais Idéal du facteur Cheval, Domitille e Jérôme, i nuovi proprietari, vi accolgono nella loro struttura con semplicità, raffinatezza e convivialità."
    ],
    "fr": [
      "En pleine nature, entre Alpes et Rhône, à deux pas de l'étonnant Palais Idéal du facteur Cheval, Domitille et Jérôme les nouveaux propriétaires des lieux, vous accueillent dans leur établissement avec simplicité, raffinement et convivialité."
    ],
    "nl": [
      "In het hart van de natuur, tussen de Alpen en de Rhône, op een steenworp afstand van het verbazingwekkende Palais Idéal du facteur Cheval, verwelkomen Domitille en Jérôme, de nieuwe eigenaren, je in hun etablissement met eenvoud, verfijning en gezelligheid."
    ],
    "es": [
      "En plena naturaleza, entre los Alpes y el Ródano, a dos pasos del sorprendente Palais Idéal du facteur Cheval, Domitille y Jérôme, los nuevos propietarios, le dan la bienvenida a su establecimiento con sencillez, refinamiento y cordialidad."
    ]
  },
