  "rdfs:comment": {
    "de": [
      "Die Avoriaz Snowboard School ist eine 100%ige Snowboard- und Freestyle-Schule mit Sitz in Avoriaz in der Haute-Savoie. Unser Ziel ist es, Ihnen unsere Leidenschaft zu vermitteln, Ihnen Fortschritte zu ermöglichen und Ihnen Spaß in einem spielerischen und idyllischen Rahmen zu bereiten!"
    ],
    "en": [
      "Avoriaz Snowboard School is a 100% Snowboard & Freestyle school based in Avoriaz, Haute-Savoie. Our mission is to share our passion with you, help you improve your skills, and ensure you enjoy every moment in a fun and idyllic setting!"
    ],
    "it": [
      "Avoriaz Snowboard School è una scuola di snowboard e freestyle al 100% con sede ad Avoriaz, in Alta Savoia. Il nostro obiettivo è condividere la nostra passione con voi, aiutarvi a progredire e a divertirvi in un ambiente divertente e idilliaco!"
    ],
    "fr": [
      "L’Avoriaz Snowboard School est une école 100% Snowboard & Freestyle basée à Avoriaz en Haute-Savoie. Notre objectif est de vous transmettre notre passion, de vous permettre de progresser et de vous faire plaisir dans un cadre ludique et idyllique !"
    ],
    "nl": [
      "Avoriaz Snowboard School is een 100% Snowboard & Freestyle-school gevestigd in Avoriaz, Haute-Savoie. Ons doel is om onze passie met je te delen, je te helpen vooruitgaan en je een geweldige tijd te bezorgen in een speelse en idyllische omgeving!"
    ],
    "es": [
      "Avoriaz Snowboard School es una escuela 100% Snowboard & Freestyle situada en Avoriaz, Alta Saboya. Nuestro objetivo es compartir nuestra pasión contigo, ayudarte a progresar y disfrutar en un entorno divertido e idílico"
    ]
  },
