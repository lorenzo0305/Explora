  "rdfs:comment": {
    "de": [
      "Es gibt Ihr Zuhause, Ihre Arbeit und den dritten Ort. Dieser Ort ist das Hotel Les Glycines. Ein eleganter und zugleich natürlicher Ort. Historisch beliebt, ist es ein aufrichtiger Ort, der den ganzen Tag über lebt."
    ],
    "en": [
      "There's your home, your work and the third place. That place is the Hotel Les Glycines. An elegant and natural place at the same time. Historically popular, it's a sincere place that lives all day long."
    ],
    "it": [
      "C'è la casa, il lavoro e il terzo posto. Questo posto è l'Hotel Les Glycines. Un luogo elegante e naturale al tempo stesso. Storicamente popolare, è un luogo autentico che vive tutto il giorno."
    ],
    "fr": [
      "Il y a chez vous, votre travail et le troisième lieu. Ce lieu, c'est l'hôtel Les Glycines. Un lieu élégant et naturel à la fois. Historiquement populaire, c'est un endroit sincère, qui vit toute la journée."
    ],
    "es": [
      "Está tu casa, tu trabajo y el tercer lugar. Ese lugar es el Hotel Les Glycines. Un lugar elegante y natural a la vez. Históricamente popular, es un lugar genuino que vive todo el día."
    ],
    "nl": [
      "Er is je huis, je werk en de derde plaats. Die plaats is het Hotel Les Glycines. Een plek die zowel elegant als natuurlijk is. Historisch gezien is het een echte plek die de hele dag leeft."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel les Glycines -Restaurant Les Hydropathes"
    ]
  },
