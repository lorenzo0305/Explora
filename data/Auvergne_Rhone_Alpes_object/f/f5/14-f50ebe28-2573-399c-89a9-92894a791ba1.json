  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6e35f930-612d-3ca5-995b-8ac434be30c7",
      "dc:description": {
        "de": [
          "Tibetische Küche, die den ursprünglichen Geschmack des Himalaya für alle Jahreszeiten anbietet. Hygiene, Frische und Qualität mit einem besseren Service bleiben unsere Prioritäten. Die Zufriedenheit der Kunden ist das, was zählt."
        ],
        "en": [
          "Tibetan cuisine offering the original taste of the Himalayas for all seasons. Hygiene, freshness, quality with a better service remain our priorities. Customer satisfaction is what counts."
        ],
        "it": [
          "La cucina tibetana offre il gusto originale dell'Himalaya per tutte le stagioni. Igiene, freschezza, qualità e un servizio migliore sono le nostre priorità. Ciò che conta è la soddisfazione del cliente."
        ],
        "fr": [
          "Cuisine tibétaine proposant le goût original de l'himalaya pour toutes les saisons. L'hygiène, la fraîcheur, la qualité avec un meilleur service restent nos priorités. La satisfaction de la clientèle est ce qui compte."
        ],
        "nl": [
          "De Tibetaanse keuken biedt de originele smaak van de Himalaya voor alle seizoenen. Hygiëne, versheid, kwaliteit en een betere service zijn onze prioriteiten. Klanttevredenheid is wat telt."
        ],
        "es": [
          "Cocina tibetana que ofrece el sabor original del Himalaya para todas las estaciones. La higiene, la frescura, la calidad y el mejor servicio son nuestras prioridades. La satisfacción del cliente es lo que cuenta."
        ]
      },
      "@type": [
