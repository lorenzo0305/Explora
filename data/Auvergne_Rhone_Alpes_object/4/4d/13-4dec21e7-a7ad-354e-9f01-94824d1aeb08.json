  "rdfs:comment": {
    "de": [
      "Indische und pakistanische Spezialitäten.\r\nShalimar bietet Ihnen eine Reise durch Indien und Pakistan mit Gerichten, die mit frischen Produkten und Zutaten aus Indien zubereitet werden."
    ],
    "en": [
      "Indian and Pakistani specialties.\r\nShalimar takes you on a tour of India and Pakistan with dishes prepared using fresh produce and ingredients straight from India."
    ],
    "it": [
      "Specialità indiane e pakistane.\r\nShalimar vi porta in giro per l'India e il Pakistan con piatti preparati con prodotti freschi e ingredienti provenienti direttamente dall'India."
    ],
    "fr": [
      "Spécialités indiennes et pakistanaises. \r\nShalimar vous propose de visiter l'Inde et le Pakistan au travers de ses plats cuisinés à bade de produits frais et d’ingrédients venant tout droit d'Inde."
    ],
    "nl": [
      "Indiase en Pakistaanse specialiteiten.\r\nShalimar neemt je mee op een reis door India en Pakistan met gerechten bereid met verse producten en ingrediënten rechtstreeks uit India."
    ],
    "es": [
      "Especialidades indias y pakistaníes.\r\nShalimar le lleva de viaje por la India y Pakistán con platos elaborados con productos frescos e ingredientes directamente de la India."
    ]
  },
  "rdfs:label": {
