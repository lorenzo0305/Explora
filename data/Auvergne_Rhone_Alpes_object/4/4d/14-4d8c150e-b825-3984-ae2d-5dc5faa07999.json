  "rdfs:comment": {
    "de": [
      "Unsere Tanz- und Musikkreation: Tzigane!\n12 Künstler auf der Bühne? Nicht zu übersehen! Eine Welle von Energie und Explosivität, die Herz und Seele berührt, um gegen die vorherrschende Düsternis dieser Zeit anzukämpfen!!!"
    ],
    "en": [
      "Our dance and music creation : Tzigane !\n12 artists on stage ... Unmissable! A wave of energy and explosiveness which touches the heart and the soul, to fight against the ambient gloom of the period!"
    ],
    "it": [
      "La nostra creazione di danza e musica: Tzigane!\n12 artisti sul palco? Un evento imperdibile! Un'ondata di energia ed esplosività che tocca il cuore e l'anima, per combattere la cupezza ambientale dei tempi!"
    ],
    "fr": [
      "Notre création danse et musique : Tzigane !\n12 artistes sur scène … Immanquable ! Une vague d’énergie et d’explosivité qui touche le cœur et l’âme, pour lutter contre la morosité ambiante de la période !!!"
    ],
    "nl": [
      "Onze dans- en muziekcreatie: Tzigane!\n12 artiesten op het podium? Een must-see! Een golf van energie en explosiviteit die het hart en de ziel raakt, om te vechten tegen de sfeerloze somberheid van deze periode!"
    ],
    "es": [
      "Nuestra creación de danza y música: ¡Tzigane!\n¿12 artistas en escena? ¡Una cita ineludible! Una ola de energía y explosividad que llega al corazón y al alma, ¡para luchar contra la penumbra ambiental de la época!"
    ]
  },
