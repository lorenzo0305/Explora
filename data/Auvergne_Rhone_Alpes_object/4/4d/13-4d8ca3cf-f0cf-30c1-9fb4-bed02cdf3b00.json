  "rdfs:comment": {
    "de": [
      "Das Ziel von Equicie ist es, jede Person mit dem Pferd auf dem Weg zu einem besseren Verständnis ihrer selbst und der Welt um sie herum zu begleiten."
    ],
    "en": [
      "The team's aim is to accompany each person, using the horse, towards a better understanding of themselves and the world around them."
    ],
    "it": [
      "L'obiettivo di equicie è quello di accompagnare ogni persona con il cavallo verso una migliore comprensione di se stessa e del mondo che la circonda."
    ],
    "fr": [
      "L’objectif de l’équicie est d’accompagner chaque personne avec le cheval vers une meilleure compréhension d'elle-même et du monde qui l’entoure."
    ],
    "nl": [
      "Het doel van equicie is om elke persoon met het paard te begeleiden naar een beter begrip van zichzelf en de wereld om hen heen."
    ],
    "es": [
      "El objetivo de Equicie es acompañar a cada persona con el caballo hacia una mejor comprensión de sí misma y del mundo que la rodea."
    ]
  },
