  "rdfs:comment": {
    "de": [
      "In diesem Berggasthof können Sie seine savoyischen Spezialitäten, aber auch seine Barschfilets entdecken. Eine Reservierung wird empfohlen.\r\n42 Gedecke im großen Saal, 10 Gedecke im kleinen Saal und 42 auf der Terrasse."
    ],
    "en": [
      "This mountain inn will make you discover its Savoyard specialties but also its nets of poles. Booking is recommended.\r\n42 people in the big room, 10 people in the little room and 42 in the terrace."
    ],
    "it": [
      "Questa locanda di montagna vi farà conoscere le sue specialità savoiarde e i suoi filetti di pesce persico. Si consiglia la prenotazione.\r\n42 coperti nella sala grande, 10 coperti nella sala piccola e 42 sulla terrazza."
    ],
    "fr": [
      "Cette auberge de montagne vous fera découvrir ses spécialités savoyardes mais aussi ses filets de perches. Réservation conseillée.\r\n42 couverts dans la grande salle, 10 couverts dans la petite et 42 en terrasse."
    ],
    "es": [
      "Este albergue de montaña le presentará sus especialidades saboyanas, así como sus filetes de perca. Se recomienda reservar.\r\n42 cubiertos en la sala grande, 10 cubiertos en la sala pequeña y 42 en la terraza."
    ],
    "nl": [
      "Deze bergherberg laat u kennismaken met zijn specialiteiten uit de Savoie en zijn baarsfilets. Reservering aanbevolen.\r\n42 couverts in de grote zaal, 10 couverts in de kleine zaal en 42 op het terras."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge Pointe du Midi"
    ],
    "fr": [
      "Auberge Pointe du Midi"
    ]
  },
