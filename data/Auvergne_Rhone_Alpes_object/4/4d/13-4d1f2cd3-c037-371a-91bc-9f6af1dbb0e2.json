  "rdfs:comment": {
    "de": [
      "Entdecken Sie Case'Graine in Vichy und seine traditionelle französische Küche. Ein originelles Konzept, bei dem die Gerichte in vakuumverpackten Gläsern serviert werden. Zum Mitnehmen oder vor Ort genießen. Ein Pfand (im Preis inbegriffen) generiert einen Rabatt, der beim nächsten Einkauf anwendbar ist."
    ],
    "en": [
      "Discover Case'Graine in Vichy and its traditional French cuisine. An original concept where dishes are served in vacuum-packed jars. Takeaway or eat-in. A deposit (included in the price) will generate a discount applicable to the next purchase."
    ],
    "it": [
      "Scoprite Case'Graine a Vichy e la sua cucina tradizionale francese. Un concetto originale in cui i piatti sono serviti in barattoli sottovuoto. Da portare via o da mangiare in casa. Un deposito (incluso nel prezzo) genererà uno sconto applicabile all'acquisto successivo."
    ],
    "fr": [
      "Découvrez Case'Graine à Vichy et sa cuisine traditionnelle française. Un concept original où les plats sont servis en bocaux sous vide. A emporter ou déguster sur place. Une consigne (incluse dans le prix) générera une remise applicable au prochain achat."
    ],
    "nl": [
      "Ontdek Case'Graine in Vichy en zijn traditionele Franse keuken. Een origineel concept waarbij gerechten worden geserveerd in vacuümpotten. Om mee te nemen of om op te eten. Een aanbetaling (inbegrepen in de prijs) genereert een korting die van toepassing is op de volgende aankoop."
    ],
    "es": [
      "Descubra Case'Graine en Vichy y su cocina tradicional francesa. Un concepto original en el que los platos se sirven en tarros al vacío. Para llevar o comer en casa. Un depósito (incluido en el precio) generará un descuento aplicable a la próxima compra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Case'Graine"
    ]
  },
