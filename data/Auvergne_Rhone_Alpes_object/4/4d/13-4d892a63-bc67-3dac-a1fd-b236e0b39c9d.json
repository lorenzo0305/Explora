  "rdfs:comment": {
    "de": [
      "Entdecken Sie seine frischen Nudeln und hausgemachten Gnocchi, sein hochwertiges Fleisch und seine savoyischen Spezialitäten, ohne sein frisches Brot und seine hausgemachten Desserts oder seinen vom Chef geräucherten Lachs zu vergessen."
    ],
    "en": [
      "Fresh homemade pasta, meat and traditional savoy food."
    ],
    "it": [
      "Venite a scoprire la nostra pasta fresca e gli gnocchi fatti in casa, le nostre carni di qualità e le specialità savoiarde, senza dimenticare il pane fresco e i dolci fatti in casa o il salmone affumicato dallo chef."
    ],
    "fr": [
      "Venez découvrir ses pâtes fraîches et gnocchis maison, ses viandes de qualité et spécialités savoyardes sans oublier son pain frais et desserts maison ou encore son saumon fumé par le chef."
    ],
    "es": [
      "Venga a descubrir su pasta fresca y sus ñoquis caseros, sus carnes de calidad y sus especialidades saboyanas, sin olvidar su pan fresco y sus postres caseros o su salmón ahumado por el chef."
    ],
    "nl": [
      "Kom en ontdek onze verse pasta en huisgemaakte gnocchi, ons kwaliteitsvlees en Savoyse specialiteiten, en niet te vergeten ons verse brood en huisgemaakte desserts of onze chef-gerookte zalm."
    ]
  },
