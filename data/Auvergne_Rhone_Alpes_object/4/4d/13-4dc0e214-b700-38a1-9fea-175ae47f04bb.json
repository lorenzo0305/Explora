  "rdfs:comment": {
    "de": [
      "Julie ist Konservatorin und Restauratorin für Kulturgüter mit Spezialisierung auf Bücher und grafische Dokumente (Zeichnungen, Drucke, Plakate usw.). Sie behandelt auch Objekte aus Leder und Pergament."
    ],
    "en": [
      "Julie is a heritage conservator-restorer specialising in books and graphic documents (drawings, prints, posters, etc.). She also works on leather and parchment objects."
    ],
    "it": [
      "Julie è una conservatrice-restauratrice specializzata in libri e documenti grafici (disegni, stampe, manifesti, ecc.). Si occupa anche di oggetti in pelle e pergamena."
    ],
    "fr": [
      "Julie est conservatrice-restauratrice du patrimoine spécialisée en livres et documents graphiques (dessin, estampes, affiches, etc.). Elle traite également les objets en cuir et parchemin."
    ],
    "nl": [
      "Julie is een erfgoedrestaurator gespecialiseerd in boeken en grafische documenten (tekeningen, prenten, posters, enz.). Ze houdt zich ook bezig met leren en perkamenten objecten."
    ],
    "es": [
      "Julie es conservadora-restauradora de patrimonio especializada en libros y documentos gráficos (dibujos, grabados, carteles, etc.). También se ocupa de objetos de cuero y pergamino."
    ]
  },
