  "rdfs:comment": {
    "de": [
      "Begleiten Sie uns zum unumgänglichen Termin des nordischen Skisports in Les Saisies. Der Etoile des Saisies, ein Volkslauf zum Abschluss der Marathonsaison, findet am Sonntag, den 29. März 2026 im wunderschönen olympischen Nordic-Walking-Gebiet von Les Saisies statt."
    ],
    "en": [
      "Join us for the unmissable event for Nordic skiing in Les Saisies. The Etoile des Saisies, a popular race that closes the marathon season, will take place on Sunday March, 29 of 2026 on the magnificent Olympic Nordic area of ​​Les Saisies"
    ],
    "it": [
      "Unitevi a noi per l'imperdibile evento di sci nordico a Les Saisies. L'Etoile des Saisies, la popolare gara che chiude la stagione delle maratone, si svolgerà domenica 29 marzo 2026 nella magnifica area olimpica dello sci nordico di Les Saisies."
    ],
    "fr": [
      "Rejoignez-nous pour le rendez-vous incontournable du ski nordique aux Saisies. L'Etoile des Saisies, course populaire qui clôt la saison des marathons aura lieu le dimanche 29 Mars 2026 sur le magnifique domaine nordique olympique des Saisies."
    ],
    "es": [
      "Únase a nosotros en la cita ineludible del esquí nórdico en Les Saisies. La Etoile des Saisies, la carrera popular que cierra la temporada de maratón, tendrá lugar el domingo 29 de marzo de 2026 en el magnífico dominio olímpico de esquí nórdico de Les Saisies."
    ],
    "nl": [
      "Doe mee met het niet te missen evenement voor langlaufen in Les Saisies. De Etoile des Saisies, een populaire race die het marathonseizoen afsluit, vindt plaats op zondag 29 march 2026 op het prachtige Olympische Nordic gebied van Les Saisies"
    ]
  },
