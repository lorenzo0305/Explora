  "rdfs:comment": {
    "de": [
      "Restaurant in der Ortschaft Valette: traditionelle Küche, die mit frischen und saisonalen Produkten zubereitet wird. Das Restaurant ist von Dienstagmittag bis Sonntagmittag geöffnet."
    ],
    "en": [
      "Restaurant in the village of Valette: traditional cuisine, made with fresh, seasonal produce. The restaurant is open from Tuesday lunchtime to Sunday lunchtime."
    ],
    "it": [
      "Ristorante nel villaggio di Valette: cucina tradizionale a base di prodotti freschi di stagione. Il ristorante è aperto dal martedì a pranzo alla domenica a pranzo."
    ],
    "fr": [
      "Restaurant dans le bourg de Valette : cuisine traditionnelle, confectionnée avec des produits frais et de saison. Le restaurant est ouvert du mardi midi au dimanche midi."
    ],
    "es": [
      "Restaurante en el pueblo de Valette: cocina tradicional elaborada con productos frescos de temporada. El restaurante abre de martes a mediodía a domingo a mediodía."
    ],
    "nl": [
      "Restaurant in het dorp Valette: traditionele keuken bereid met verse seizoensproducten. Het restaurant is geopend van dinsdagmiddag tot zondagmiddag."
    ]
