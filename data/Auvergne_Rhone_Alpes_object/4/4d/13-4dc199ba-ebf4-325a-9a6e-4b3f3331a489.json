  "rdfs:comment": {
    "de": [
      "Sie befindet sich in Pré-la-Joux und umfasst zwei separate, gesicherte Rodelbahnen: eine für Kinder von 2 bis 6 Jahren, die andere für Kinder ab 6 Jahren."
    ],
    "en": [
      "The Pré-la-Joux area is made up of two separate and safe sledging runs:\r\none for 2 to 6-year-olds and the other for children aged 6 and over,  a themed and play path and a game area."
    ],
    "it": [
      "Situato a Pré-la-Joux, dispone di due piste da slittino separate e sicure: una per i bambini dai 2 ai 6 anni, l'altra per i bambini dai 6 anni in su."
    ],
    "fr": [
      "Située à Pré-la-Joux, elle comprend deux pistes de luges distinctes et sécurisées : une pour les enfants de 2 à 6 ans, l'autre pour les enfants de 6 ans et plus."
    ],
    "es": [
      "Situado en Pré-la-Joux, cuenta con dos pistas de trineo separadas y seguras: una para niños de 2 a 6 años y otra para niños a partir de 6 años."
    ],
    "nl": [
      "Bij Pré-la-Joux vindt u 2 goed aangegeven en beveiligde sleebanen: één voor kinderen van 2 tot 6 jaar oud, de andere voor kinderen van 6 jaar en ouder."
    ]
  },
  "rdfs:label": {
