  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen Fastfood und traditionelle warme Gerichte an. Schöne Aussicht auf die Vanoise, das Haute Vallée de l'Arc, l'Ecot und die Grenzkette."
    ],
    "en": [
      "We offer fast food and traditional hot dishes. Beautiful views of the Vanoise, the Haute Vallée de l'Arc, l'Ecot and the border chain."
    ],
    "it": [
      "Offriamo fast food e piatti caldi tradizionali. Splendida vista sulla Vanoise, l'Haute Vallée de l'Arc, l'Ecot e la catena di confine."
    ],
    "fr": [
      "Nous vous proposons une restauration rapide et des plats chauds traditionnels. Belle vue sur la Vanoise, la Haute Vallée de l'Arc, l'Ecot et la chaîne frontalière."
    ],
    "nl": [
      "We bieden fastfood en traditionele warme gerechten. Prachtig uitzicht op de Vanoise, de Haute Vallée de l'Arc, l'Ecot en de grensketen."
    ],
    "es": [
      "Ofrecemos comida rápida y platos calientes tradicionales. Hermosa vista sobre la Vanoise, el Haute Vallée de l'Arc, el Ecot y la cadena fronteriza."
    ]
  },
