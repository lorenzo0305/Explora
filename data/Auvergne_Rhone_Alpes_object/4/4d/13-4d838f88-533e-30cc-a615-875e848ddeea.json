  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage der Kunsthandwerke öffnen zahlreiche Kunsthandwerker die Türen ihrer Werkstätten und ihres Wissens für die breite Öffentlichkeit. Besuchen Sie das Atelier von Tine Collard in der Lederwarenfabrik Nodie's.\r\nBesichtigung nach Vereinbarung."
    ],
    "en": [
      "As part of the Journées Européennes des Métiers d'Art, many artisans are opening the doors of their workshops and their knowledge to the general public. Come and discover Tine Collard's workshop at Nodie's leather goods.\r\nVisits by appointment."
    ],
    "it": [
      "Nell'ambito delle Journées Européennes des Métiers d'Art, molti artigiani aprono le porte dei loro laboratori e le loro conoscenze al grande pubblico. Venite a scoprire il laboratorio di Tine Collard presso la pelletteria di Nodie.\r\nVisite su appuntamento."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes des Métiers d'Art, de nombreux artisans ouvrent les portes de leurs atelier et de leur savoir au grand public. Venez découvrir l'atelier de Tine Collard à la maroquinerie Nodie's. \r\nVisite sur rendez-vous."
    ],
    "es": [
      "En el marco de las Journées Européennes des Métiers d'Art, numerosos artesanos abren las puertas de sus talleres y sus conocimientos al gran público. Venga a descubrir el taller de Tine Collard en Marroquinería Nodie.\r\nVisitas concertadas."
    ],
    "nl": [
      "Als onderdeel van de Journées Européennes des Métiers d'Art openen veel ambachtslieden de deuren van hun ateliers en hun kennis voor het grote publiek. Kom en ontdek het atelier van Tine Collard bij Nodie's lederwaren.\r\nBezoek op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de l'atelier de maroquinerie de Tine Collard - Journées Européennes des Métiers d'Art"
    ]
  },
