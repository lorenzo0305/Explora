  "rdfs:comment": {
    "de": [
      "Schlüpfen Sie in das Kleid der Marquise de Sévigné und machen Sie eine Pause für ein Selfie! Das Kleid wurde von der Association le Vertugadin Pailleté und den Schülern des BTS Mode-Kleidung des Lycée Argouges in Grenoble angefertigt. Im Rahmen von 2026, Sévigné-Jahr."
    ],
    "en": [
      "Put on the dress of the Marquise de Sévigné, and take a selfie! Created by the Vertugadin Pailleté association and BTS fashion-clothing students from Grenoble's Lycée Argouges. As part of 2026, Année Sévigné."
    ],
    "it": [
      "Indossate l'abito della Marchesa di Sévigné e fate una pausa per un selfie! Realizzato dall'associazione Vertugadin Pailleté e dagli studenti di moda e abbigliamento BTS del Lycée Argouges di Grenoble. Nell'ambito di 2026, Année Sévigné."
    ],
    "fr": [
      "Enfilez la robe de la Marquise de Sévigné, et prenez la pause le temps d'un selfie ! Tenue confectionnée par l'association le Vertugadin Pailleté et des élèves du BTS mode-vêtement du Lycée Argouges de Grenoble. Dans le cadre de 2026, Année Sévigné."
    ],
    "nl": [
      "Trek de jurk van de markiezin van Sévigné aan en neem een pauze voor een selfie! Gemaakt door de vereniging Vertugadin Pailleté en BTS studenten mode en kleding van het Lycée Argouges in Grenoble. In het kader van 2026, Année Sévigné."
    ],
    "es": [
      "Ponte el vestido de la marquesa de Sévigné, ¡y tómate un descanso para hacerte un selfie! Realizado por la asociación Vertugadin Pailleté y los estudiantes de moda y confección BTS del Liceo Argouges de Grenoble. En el marco de 2026, Année Sévigné."
    ]
  },
