  "rdfs:comment": {
    "de": [
      "Traditionelle Küche mit frischen, lokalen Produkten. Entdecken Sie das Restaurant Hostun Gourmand, das von dem jungen, aus der Region stammenden Küchenchef Anthony geführt wird!"
    ],
    "en": [
      "Traditional cuisine using fresh, local produce, come and discover the Hostun Gourmand restaurant run by young, local chef Anthony!"
    ],
    "it": [
      "Pasti consegnati a casa vostra ogni giorno con prodotti freschi.\r\nRistorazione in loco e pasti da asporto su prenotazione.\r\nVenite a scoprire il ristorante Hostun Gourmand gestito dal giovane chef Anthony, originario della regione!"
    ],
    "fr": [
      "Portage de repas à domicile tous les jours avec des produits frais.\r\nRestauration sur place et plats à emporter sur réservation uniquement.\r\nVenez découvrir le restaurant Hostun Gourmand tenu par le jeune chef Anthony originaire de la région !"
    ],
    "nl": [
      "Kom en ontdek het Hostun Gourmand restaurant, gerund door de jonge chef Anthony, een inwoner van de regio!"
    ],
    "es": [
      "Comida a domicilio diaria con productos frescos.\r\nCatering in situ y comida para llevar con reserva previa.\r\nVenga a descubrir el restaurante Hostun Gourmand, dirigido por el joven chef Anthony, natural de la región"
    ]
  },
