  "rdfs:comment": {
    "de": [
      "Alain Michel möchte seinen Kunden ein unvergessliches Erlebnis rund um den in seinem Naturkeller gereiften Käse bieten. Er stellt die besten Käsesorten, hausgemachte Spezialitäten und hochwertige Feinkostprodukte in den Vordergrund, um außergewöhnliche Kombinationen zu kreieren."
    ],
    "en": [
      "Alain Michel wants to offer his customers an unforgettable experience based around cheese matured in his natural cellar. He showcases the very best cheeses, home-made specialities and quality delicatessen products for exceptional pairings."
    ],
    "it": [
      "Alain Michel stagiona formaggi ad Annecy dal 1969 e offre una rigorosa selezione di formaggi a latte crudo, oltre a specialità interne, prodotti di gastronomia e vini per un'esperienza casearia da gourmet."
    ],
    "fr": [
      "Affineur fromager à Annecy depuis 1969, Alain Michel propose une sélection rigoureuse de fromages au lait cru, ainsi que des spécialités maison, épicerie fine et vins pour une expérience gourmande autour du fromage."
    ],
    "nl": [
      "Alain Michel rijpt al sinds 1969 kaas in Annecy en biedt een strenge selectie rauwmelkse kazen, maar ook huisgemaakte specialiteiten, delicatessen en wijnen voor een gastronomische kaaservaring."
    ],
    "es": [
      "Alain Michel madura quesos en Annecy desde 1969 y ofrece una rigurosa selección de quesos de leche cruda, así como especialidades de la casa, productos delicatessen y vinos para vivir una experiencia quesera gourmet."
    ]
  },
