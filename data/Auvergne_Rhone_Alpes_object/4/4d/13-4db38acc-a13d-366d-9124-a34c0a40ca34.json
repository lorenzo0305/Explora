  "rdfs:comment": {
    "de": [
      "Stärken Sie sich mit einem reichhaltigen Frühstück, schlemmen Sie sich durch ein großzügiges Mittagessen oder kommen Sie sogar bei uns vorbei, um eine Fondueprobe zu genießen, die Ihre Seele erwärmen wird."
    ],
    "en": [
      "Refuel with a hearty cooked breakfast, grab a generous portioned lunch or pop down to the bistro in the evening for a soul warming fondue. Between the kid’s menu, the gourmet burger, daily vegetarian specials, the Tav’s standout menu complements local specialties with modern bistro dining."
    ],
    "it": [
      "Ritempratevi con una ricca colazione, concedetevi un pranzo abbondante o fate un salto per una degustazione di fonduta che scalda l'anima."
    ],
    "fr": [
      "Restaurez-vous avec un petit déjeuner copieux, régalez-vous avec un déjeuner généreux ou même passez nous voir pour une dégustation de fondue qui réchauffera votre âme."
    ],
    "nl": [
      "Rust uit met een stevig ontbijt, trakteer uzelf op een royale lunch of kom zelfs langs voor een zielverwarmende fondueproeverij."
    ],
    "es": [
      "Recupérese con un buen desayuno, regálese un generoso almuerzo o incluso pase a degustar una fondue para calentar el alma."
    ]
  },
  "rdfs:label": {
