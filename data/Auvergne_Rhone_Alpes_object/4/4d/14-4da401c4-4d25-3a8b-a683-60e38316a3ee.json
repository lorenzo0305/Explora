  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7b4c73be-3727-3684-a6f6-84d718622942",
      "dc:description": {
        "de": [
          "Latteria Italiana bietet Ihnen Gerichte zum Mitnehmen und italienische Produkte.\n\nInformationen :\n\nProdukte: Besuchen Sie die Facebook-Seite\n\nÖffnungszeiten:\nDienstag bis Samstag: 9:30-19:00 Uhr\n\nTelefonische Bestellung möglich\n \n Abholung:\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Latteria Italiana offers takeaway food and Italian products.\n\nFor further information:\n\nProducts: Visit our Facebook page\n\nOpening days :\nTuesday to Saturday: 9:30am-7pm\n\nOrder by phone\n \n Collection :\nDuring store opening hours\n\n "
        ],
        "it": [
          "La Latteria Italiana offre pasti da asporto e prodotti italiani.\n\nPer ulteriori informazioni:\n\nProdotti: Visita la pagina Facebook\n\nGiorni di apertura :\nDa martedì a sabato: 9.30-19.00\n\nPossibilità di ordinare per telefono\n \n Ritiro :\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Latteria Italiana vous propose des plats à emporter et des produits italien.\n\nInformations :\n\nProduits: Consultez la page Facebook \n\nJours d'ouverture : \nDu mardi au samedi: 9h30-19h\n\nPossibilité de commander par téléphone\n \n Retrait :\nAux horaires d'ouverture du magasin \n\n "
        ],
        "es": [
          "Latteria Italiana ofrece comida para llevar y productos italianos.\n\nPara más información:\n\nProductos: Visite la página de Facebook\n\nDías de apertura :\nDe martes a sábado: de 9.30 a 19.00 horas\n\nPosibilidad de hacer pedidos por teléfono\n \n Recogida :\nDurante el horario de apertura de la tienda\n\n "
        ],
        "nl": [
          "Latteria Italiana biedt afhaalmaaltijden en Italiaanse producten.\n\nVoor meer informatie:\n\nProducten: Bezoek de Facebookpagina\n\nOpeningsdagen :\nDinsdag tot zaterdag: 9.30u-19u\n\nMogelijkheid om telefonisch te bestellen\n \n Afhalen :\nTijdens winkelopeningstijden\n\n "
        ]
      },
