  "rdfs:comment": {
    "de": [
      "Unsere staatlich geprüften Fachkräfte sind von ihrem Beruf begeistert und unterrichten Erwachsene und Kinder in allen aktuellen Disziplinen des Skifahrens: Alpinski und Snowboard."
    ],
    "en": [
      "Passionate about their profession, our state-certified professionals teach adults and children all the latest winter sports disciplines: downhill skiing and snowboarding."
    ],
    "it": [
      "Appassionati della loro professione, i nostri professionisti certificati dallo Stato insegnano ad adulti e bambini tutte le più recenti discipline sportive invernali: sci alpino e snowboard."
    ],
    "fr": [
      "Passionnés par leur métier, nos professionnels diplômés d'état enseignent aux adultes et aux enfants toutes les disciplines actuelles de glisse : le ski alpin et le snowboard."
    ],
    "nl": [
      "Onze professionals zijn gepassioneerd door hun vak en geven volwassenen en kinderen les in de nieuwste wintersportdisciplines: alpineskiën en snowboarden."
    ],
    "es": [
      "Apasionados por su profesión, nuestros profesionales con titulación estatal enseñan a adultos y niños todas las disciplinas más novedosas de los deportes de invierno: esquí alpino y snowboard."
    ]
  },
