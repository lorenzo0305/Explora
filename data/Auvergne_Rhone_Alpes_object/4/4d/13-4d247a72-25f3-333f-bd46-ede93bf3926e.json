  "rdfs:comment": {
    "de": [
      "Am Freitag findet ein gestikulierter Vortrag über häusliche Gewalt von Estelle Thareau statt.\r\nUm 20 Uhr: Résister von der Kompanie Inventer la Danse.\r\nAb 20:30 Uhr beginnt der Vortrag."
    ],
    "en": [
      "A gesticulated conference on domestic violence by Estelle Thareau will take place this Friday.\r\nAt 8pm, Resist by the Inventer la Danse company.\r\nThen at 8:30pm: start of the gesticulated conference."
    ],
    "it": [
      "Venerdì si terrà una conferenza gestuale sulla violenza domestica tenuta da Estelle Thareau.\r\nAlle 20.00, Resist della compagnia Inventer la Danse.\r\nPoi, alle 20.30, inizio della conferenza gesticolata."
    ],
    "fr": [
      "Une conférence gesticulée sur les violences conjugales par Estelle Thareau aura lieu ce vendredi.\r\nA 20 heures, Résister par la compagnie Inventer la Danse.\r\nPuis dès 20h30: début de la conférence gesticulée."
    ],
    "es": [
      "Este viernes tendrá lugar una conferencia gestual sobre la violencia doméstica a cargo de Estelle Thareau.\r\nA las 20.00 horas, Resist de la compañía Inventer la Danse.\r\nA las 20.30 h: comienzo de la conferencia gestual."
    ],
    "nl": [
      "Aanstaande vrijdag is er een gebarenlezing over huiselijk geweld door Estelle Thareau.\r\nOm 20.00 uur: Resist door het gezelschap Inventer la Danse.\r\nDaarna om 20.30 uur: start van de gebarenlezing."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence gesticulée sur les violences conjuguales"
    ]
  },
