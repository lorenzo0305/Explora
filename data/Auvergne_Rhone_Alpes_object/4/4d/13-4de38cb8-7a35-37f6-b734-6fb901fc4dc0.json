  "rdfs:comment": {
    "de": [
      "Eine angenehme Umgebung, eine raffinierte regionale Küche und eine Bar. Alles ist möglich, von den einfachsten Mahlzeiten bis hin zu gastronomischen Menüs, im Winter um einen großen Kamin herum und im Sommer auf der Terrasse."
    ],
    "en": [
      "Pleasant surroundings, fine and local cuisine and a wine bar. Anything is possible, from simple to gourmet meals around a large fireplace in the winter or on the terrace in summer."
    ],
    "it": [
      "Un ambiente piacevole, una raffinata cucina locale e un bar. Tutto è possibile, dai pasti più semplici ai menu gastronomici, intorno a un grande camino in inverno o sulla terrazza in estate."
    ],
    "fr": [
      "Un cadre agréable, une cuisine raffinée de terroir, et un bar. Tout est possible, des repas les plus simples aux menus gastronomiques, autour d’une vaste cheminée en hiver, ou bien sur la terrasse en période estivale."
    ],
    "es": [
      "Un entorno agradable, una cocina local refinada y un bar. Todo es posible, desde las comidas más sencillas hasta los menús gastronómicos, alrededor de una gran chimenea en invierno, o en la terraza en verano."
    ],
    "nl": [
      "Een aangename omgeving, een geraffineerde keuken en een bar. Alles is mogelijk, van de meeste eenvoudige maaltijden tot de meest gastronomische menu's, rondom een grote open haard in de winter, of op het terras in de zomer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Bonne Tabl'Hay"
    ]
  },
