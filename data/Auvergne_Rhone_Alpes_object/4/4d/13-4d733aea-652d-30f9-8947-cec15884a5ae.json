  "rdfs:comment": {
    "de": [
      "Hotel**** am Fuße der Pisten und Wanderwege gelegen. Typische Dekoration im Stil eines Savoyer Chalets. Eine herzliche und familiäre Atmosphäre, um einen angenehmen Aufenthalt zu verbringen. Entdecken Sie sein SPA und sein Restaurant, authentische savoyardische Küche."
    ],
    "en": [
      "4* hotel chalet at the foot of the pistes and footpaths. Typical Savoyard interior. A warm and family atmosphere for a pleasant stay. Come and discover its spa and its restaurant, with authentic, Savoyard and bistronomic cuisine."
    ],
    "it": [
      "Hotel**** situato ai piedi delle piste e dei sentieri. Arredamento tipico degli chalet savoiardi. Un'atmosfera calda e familiare per un soggiorno piacevole. Venite a scoprire la sua SPA e il suo ristorante, che offre un'autentica cucina savoiarda."
    ],
    "fr": [
      "Hôtel**** situé au pied des pistes et des sentiers. Décoration typiquement Chalet Savoyard. Une ambiance chaleureuse et familiale pour passer un agréable séjour. Venez découvrir son SPA et son restaurant, cuisine authentique et savoyarde."
    ],
    "es": [
      "Hotel**** situado a pie de pistas y senderos. Decoración típica de chalet saboyano. Un ambiente cálido y familiar para una estancia agradable. Venga a descubrir su SPA y su restaurante, que ofrece auténtica cocina saboyana."
    ],
    "nl": [
      "Hotel**** gelegen aan de voet van de pistes en wandelpaden. Typisch Savoyaardse chaletinrichting. Een warme, familiale sfeer voor een aangenaam verblijf. Ontdek de SPA en het restaurant met authentieke Savoyaardse keuken."
    ]
  },
