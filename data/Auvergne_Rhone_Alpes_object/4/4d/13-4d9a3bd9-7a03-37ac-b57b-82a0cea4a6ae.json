  "rdfs:comment": {
    "de": [
      "Ally: Kirche aus dem 12. Jahrhundert. Plateau von Ally in 1000 m Höhe\r\nbekannt für seinen Windpark, der mit 26 Windrädern einer der größten in Frankreich ist. Restaurierte Windmühlen, von denen drei besichtigt werden können. Silber- und Antimonminen können besichtigt werden. Panorama."
    ],
    "en": [
      "Ally: 12th-century church. Plateau d?Ally at 1000 m altitude\r\nknown for its wind farm, one of the largest in France with 26 turbines. Restored windmills, 3 of which are open to visitors. Silver and antimony mines. Panoramic views."
    ],
    "it": [
      "Ally: chiesa del XII secolo. Plateau d'Ally a 1000 m di altitudine\r\nfamoso per il suo parco eolico, uno dei più grandi di Francia con 26 turbine. Mulini a vento restaurati, 3 dei quali sono visitabili. Visita alle miniere di argento e antimonio. Viste panoramiche."
    ],
    "fr": [
      "Ally : Église du XIIe siècle. Plateau d’Ally à 1000 m d’altitude\r\nconnu pour son parc éolien, l’un des plus vastes de France avec 26 éoliennes. Moulins à vent restaurés dont 3 sont ouverts à la visite. Mines d’argent et d’antimoine à visiter. Panorama."
    ],
    "nl": [
      "Ally: kerk uit de 12e eeuw. Plateau d'Ally op 1000 m hoogte\r\nberoemd om zijn windmolenpark, een van de grootste in Frankrijk met 26 turbines. Gerestaureerde windmolens, waarvan er 3 open zijn voor bezoekers. Bezoek de zilver- en antimoonmijnen. Panoramisch uitzicht."
    ],
    "es": [
      "Ally: iglesia del siglo XII. Plateau d'Ally a 1000 m de altitud\r\nfamoso por su parque eólico, uno de los mayores de Francia con 26 turbinas. Molinos de viento restaurados, 3 de ellos visitables. Visita a las minas de plata y antimonio. Vistas panorámicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Ally"
    ]
  },
