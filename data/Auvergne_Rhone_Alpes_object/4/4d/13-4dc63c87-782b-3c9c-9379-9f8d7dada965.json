  "rdfs:comment": {
    "de": [
      "Ob allein, in der Gruppe oder mit der Familie: Entdecken Sie das Wasser- & Fitnesszentrum Le Nautile mit seinen Sport-, Spiel- und Außenbecken (ab Juni geöffnet), seiner Rutsche, seinen Fitness-, Kardio- und PMR-Räumen und seinem Wellnessbereich."
    ],
    "en": [
      "Whether you're alone, with a group or with your family, come and discover Le Nautile aquatic and fitness centre with its sports, leisure and outdoor pools (open from June), its water slide, its fitness, cardio-training and RPM rooms, and its wellness area."
    ],
    "it": [
      "Da soli, in gruppo o in famiglia, venite a scoprire il centro acquatico e fitness Le Nautile, con le sue piscine sportive, ricreative e all'aperto (aperte da giugno), l'acquascivolo, le sale fitness, cardio-muscolazione e RPM e l'area benessere."
    ],
    "fr": [
      "Seul, en groupe ou en famille, venez découvrir le centre aquatique & forme Le Nautile avec ses bassins sportif, ludique et extérieur (ouvert dès juin), son toboggan, ses salles fitness, cardio-musculation et RPM et son espace bien-être."
    ],
    "es": [
      "Solo, en grupo o en familia, venga a descubrir el centro acuático y de fitness Le Nautile, con sus piscinas deportivas, lúdicas y exteriores (abiertas a partir de junio), tobogán acuático, salas de fitness, cardio-musculación y RPM y espacio de bienestar."
    ],
    "nl": [
      "Kom alleen, met een groep of met het gezin het water- en fitnesscentrum Le Nautile ontdekken, met zijn sport-, recreatie- en buitenzwembaden (open vanaf juni), waterglijbaan, fitness-, cardiomusculatie- en RPM-ruimtes en wellnessruimte."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Nautile Aquatic Centre"
    ],
    "fr": [
      "Centre Aquatique & Forme Le Nautile"
    ]
  },
