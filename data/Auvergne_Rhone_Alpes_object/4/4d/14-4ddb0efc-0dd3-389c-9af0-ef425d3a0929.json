  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3b404574-4cfe-3ca2-bd28-d3500590b43d",
      "dc:description": {
        "de": [
          "Im Rahmen des gemeindeübergreifenden Projekts \"Rions\" laden die Städte Noyelles-sous-Lens, Harnes, Méricourt, Billy-Montigny und Mazingarbe Sie zur Aufführung \"A nous deux\" der Improvisationsliga von Marcq-en-Baroeul ein."
        ],
        "en": [
          "As part of the intercommunal \"Rions\" project, the towns of Noyelles-sous-Lens, Harnes, Méricourt, Billy-Montigny and Mazingarbe invite you to the \"A nous deux\" show by the Marcq-en-Baroeul improvisation league."
        ],
        "it": [
          "Nell'ambito del progetto intercomunale \"Rions\", i comuni di Noyelles-sous-Lens, Harnes, Méricourt, Billy-Montigny e Mazingarbe vi invitano allo spettacolo \"A nous deux\" della Lega di improvvisazione di Marcq-en-Baroeul."
        ],
        "fr": [
          "Dans le cadre du projet intercommunal \"Rions\", les villes de Noyelles-sous-Lens, Harnes, Méricourt, Billy-Montigny et Mazingarbe vous invitent au spectacle \"A nous deux\" de la ligue d'improvisation de Marcq-en-Baroeul."
        ],
        "nl": [
          "In het kader van het intercommunale project \"Rions\" nodigen de gemeenten Noyelles-sous-Lens, Harnes, Méricourt, Billy-Montigny en Mazingarbe u uit voor de voorstelling \"A nous deux\" van de improvisatiegroep van Marcq-en-Baroeul."
        ],
        "es": [
          "En el marco del proyecto intercomunal \"Rions\", las ciudades de Noyelles-sous-Lens, Harnes, Méricourt, Billy-Montigny y Mazingarbe le invitan al espectáculo \"A nous deux\" de la liga de improvisación de Marcq-en-Baroeul."
        ]
      },
