  "rdfs:comment": {
    "de": [
      "Als zertifizierter Coach und Krankenschwester und Gesundheitsberaterin begrüße ich Sie in der Domaine d'Hortulus in Lezoux. Ich biete Ihnen eine Begleitung an, die an einem Ort Outdoor-Coaching, Gesundheitsberatung und Wohlbefinden rund um aromatische Pflanzen miteinander verbindet."
    ],
    "en": [
      "Certified coach and health nurse consultant, I welcome you to the Domaine d'Hortulus in Lezoux. I offer you a unique combination of outdoor coaching and health and well-being advice based around aromatic plants."
    ],
    "it": [
      "Coach e infermiera diplomata, vi do il benvenuto al Domaine d'Hortulus di Lezoux. Offro una gamma di servizi che combinano il coaching all'aria aperta con consigli per la salute e il benessere basati sulle piante aromatiche."
    ],
    "fr": [
      "Coach certifiée et infirmière conseillère en santé, je vous accueille au Domaine d'Hortulus à Lezoux. Je vous propose un accompagnement qui relie dans un même lieu le coaching outdoor, le conseil en santé et bien-être autour des plantes aromatiques."
    ],
    "es": [
      "Coach diplomada y enfermera asesora en salud, le doy la bienvenida al Domaine d'Hortulus de Lezoux. Ofrezco una gama de servicios que combinan el coaching al aire libre con consejos de salud y bienestar en torno a las plantas aromáticas."
    ],
    "nl": [
      "Als gediplomeerd coach en verpleegkundige met gezondheidsconsulenten heet ik je welkom op het Domaine d'Hortulus in Lezoux. Ik bied een reeks diensten aan die outdoorcoaching combineren met gezondheids- en welzijnsadvies op basis van aromatische planten."
    ]
  },
  "rdfs:label": {
