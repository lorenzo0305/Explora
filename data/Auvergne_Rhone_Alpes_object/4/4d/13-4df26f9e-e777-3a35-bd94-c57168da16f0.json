  "rdfs:comment": {
    "de": [
      "Im Herzen der mittelalterlichen Stadt Crémieu bietet dieses Hotel 9 Zimmer, darunter 4 Familienzimmer, mit eigenem Bad.\r\nEin idealer Ausgangspunkt, um die Stadt zu erkunden, aber auch um den Voie Verte des Balcons und die ViaRhôna zu nutzen."
    ],
    "en": [
      "In the heart of the medieval town of Crémieu, this hotel offers 9 rooms, including 4 family rooms, all with private bathrooms. It is an ideal base for exploring the town as well as for enjoying the Voie Verte des Balcons and the ViaRhôna."
    ],
    "it": [
      "Nel cuore della città medievale di Crémieu, questo hotel offre 9 camere con bagno, tra cui 4 camere familiari.\r\nÈ la base ideale per esplorare la città e sfruttare la Voie Verte des Balcons e la ViaRhôna."
    ],
    "fr": [
      "Au cœur de la cité médiévale de Crémieu, cet hôtel propose 9 chambres dont 4 familiales, avec salle de bain privative. \r\nUn point de départ idéal pour découvrir la ville et mais aussi pour profiter de la Voie Verte des Balcons et de ViaRhôna."
    ],
    "nl": [
      "In het hart van de middeleeuwse stad Crémieu biedt dit hotel 9 kamers met eigen badkamer, waaronder 4 familiekamers.\r\nEen ideale uitvalsbasis om de stad te verkennen en te profiteren van de Voie Verte des Balcons en ViaRhôna."
    ],
    "es": [
      "En el corazón de la ciudad medieval de Crémieu, este hotel ofrece 9 habitaciones con baño, 4 de ellas familiares.\r\nUna base ideal para explorar la ciudad y aprovechar la Voie Verte des Balcons y ViaRhôna."
    ]
  },
  "rdfs:label": {
