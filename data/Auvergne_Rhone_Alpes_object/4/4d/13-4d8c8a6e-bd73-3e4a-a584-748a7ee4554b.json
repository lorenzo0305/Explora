  "rdfs:comment": {
    "de": [
      "Es ist die Jahreszeit, in der Sie die Presse wieder hervorholen und die Geheimnisse der handwerklichen Herstellung von frischem Apfelsaft lernen können. Ein köstlicher Genuss! Reservierung per SMS erforderlich 06 61 85 63 86"
    ],
    "en": [
      "This is the season to bring out the press and learn the secrets of making fresh apple juice by hand. A real treat! Reservations required by SMS 06 61 85 63 86"
    ],
    "it": [
      "Questa è la stagione per tirare fuori il torchio e imparare i segreti della produzione di succo di mela fresco in modo tradizionale. Una vera delizia! Prenotazione obbligatoria via SMS 06 61 85 63 86"
    ],
    "fr": [
      "C’est la saison pour ressortir le pressoir et apprendre les secrets de la fabrication artisanale du jus de pomme frais. Un délice ! Réservation nécessaire par SMS 06 61 85 63 86"
    ],
    "es": [
      "Esta es la época de sacar la prensa de manzanas y aprender los secretos de la elaboración tradicional de zumo de manzana fresco. Una auténtica delicia Reserva obligatoria por mensaje de texto 06 61 85 63 86"
    ],
    "nl": [
      "Dit is het seizoen om de appelpers tevoorschijn te halen en de geheimen te leren van het maken van vers appelsap op de traditionele manier. Een echte traktatie! Reserveren verplicht via sms 06 61 85 63 86"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier : Presse ton jus de pomme"
    ]
  },
