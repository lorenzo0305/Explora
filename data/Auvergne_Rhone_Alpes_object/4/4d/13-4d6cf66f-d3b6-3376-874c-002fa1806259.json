  "rdfs:comment": {
    "de": [
      "Müllerbauer, der Mehl, fermentierte Getränke, Nudeln, verarbeitetes Getreide, Marmeladen und Kompotte sowie Balsame, Öle, Hydrolate und ätherische Öle anbietet."
    ],
    "en": [
      "Farmer miller offering flour, fermented drinks, pasta, processed cereals, jams and compotes, as well as balms, oils, hydrolats and essential oils."
    ],
    "it": [
      "Il mugnaio contadino offre farina, bevande fermentate, pasta, cereali lavorati, marmellate e composte, oltre a balsami, oli, idrolati e oli essenziali."
    ],
    "fr": [
      "Paysan meunier qui propose de la farine, des boissons fermentées, des pâtes, des céréales transformées, confitures et compotes ainsi que des baumes, huiles, hydrolats et huiles essentielles."
    ],
    "nl": [
      "Boerenmolenaar die meel, gefermenteerde dranken, pasta, verwerkte granen, jam en compote en ook balsems, oliën, hydrolaten en essentiële oliën aanbiedt."
    ],
    "es": [
      "Agricultor molinero que ofrece harina, bebidas fermentadas, pasta, cereales procesados, mermeladas y compotas, así como bálsamos, aceites, hidrolatos y aceites esenciales."
    ]
  },
