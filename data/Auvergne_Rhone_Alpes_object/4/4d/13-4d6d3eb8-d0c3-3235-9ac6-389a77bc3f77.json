  "rdfs:comment": {
    "de": [
      "Neben den üblichen Auskünften im Zusammenhang mit der Organisation von Aufenthalten in La Mure oder Matheysine können die Besucher auf verschiedene Dienstleistungen zugreifen."
    ],
    "en": [
      "In addition to the usual information related to the organization of stays at La Mure or Matheysine, visitors can have access to various services."
    ],
    "it": [
      "Oltre alle informazioni abituali relative all'organizzazione di soggiorni a La Mure o in Matheysine, i visitatori possono avere accesso a diversi servizi."
    ],
    "fr": [
      "En plus des renseignements habituels liés à l’organisation de séjours à La Mure ou en Matheysine, les visiteurs peuvent avoir accès à différents services."
    ],
    "nl": [
      "Naast de gebruikelijke informatie over het organiseren van een verblijf in La Mure of de Matheysine, kunnen bezoekers toegang krijgen tot verschillende diensten."
    ],
    "es": [
      "Además de la información habitual sobre la organización de una estancia en La Mure o en la Matheysine, los visitantes pueden acceder a diversos servicios."
    ]
  },
