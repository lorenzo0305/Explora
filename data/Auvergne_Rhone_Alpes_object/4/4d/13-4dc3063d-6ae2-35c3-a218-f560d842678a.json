  "rdfs:comment": {
    "de": [
      "Camille und Magali bieten Ihnen in ihrer Boutique für kreative Kurzwaren Stoffe, Wolle, Kreativsets und Geschenke für Groß und Klein an. Sie bieten auch Nähworkshops für alle Altersgruppen an."
    ],
    "en": [
      "Camille and Magali offer in their creative haberdashery shop fabrics, wool, creative kits, gifts for young and old. They also offer sewing workshops for all ages."
    ],
    "it": [
      "Camille e Magali hanno un negozio di merceria creativa che vende tessuti, lana, kit creativi e regali per tutte le età. Offrono anche laboratori di cucito per tutte le età."
    ],
    "fr": [
      "Camille et Magali vous proposent dans leur boutique de mercerie créative des tissus, de la laine, des kits créatifs, des cadeaux pour petits et grands. Elles proposent aussi des ateliers de couture pour tous les âges."
    ],
    "es": [
      "Camille y Magali tienen una mercería creativa en la que venden telas, lana, kits creativos y regalos para todas las edades. También ofrecen talleres de costura para todas las edades."
    ],
    "nl": [
      "Camille en Magali hebben een creatieve fourniturenwinkel met stoffen, wol, creatieve pakketten en cadeautjes voor alle leeftijden. Ze bieden ook naaiworkshops voor alle leeftijden."
    ]
  },
