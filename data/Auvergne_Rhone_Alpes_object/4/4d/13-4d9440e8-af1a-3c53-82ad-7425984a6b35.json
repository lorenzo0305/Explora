  "rdfs:comment": {
    "de": [
      "Das Team der Domaine des Jardins Suspendus empfängt Sie jeden Tag, um Sie mit immer neuen überraschenden und köstlichen Gerichten zu verwöhnen. Ein gemütlicher und intimer Rahmen, ein herzlicher Service und eine Weinkarte, die Sie auf Reisen schickt!"
    ],
    "en": [
      "The Domaine des Jardins Suspendus team welcomes you every day to help you discover ever more surprising and gourmet dishes. A cosy, intimate setting, warm service and a wine list to take you on a journey!"
    ],
    "it": [
      "Il team del Domaine des Jardins Suspendus vi accoglie ogni giorno per farvi scoprire piatti sempre più sorprendenti e gourmet. Un ambiente intimo e accogliente, un servizio cordiale e una carta dei vini che vi farà viaggiare!"
    ],
    "fr": [
      "L'équipe du Domaine des Jardins Suspendus vous accueille tous les jours afin de vous faire découvrir des plats toujours plus surprenants et gourmands. Un cadre cosy et intimiste, un service chaleureux et une carte des vins qui fait voyager !"
    ],
    "nl": [
      "Het team van Domaine des Jardins Suspendus verwelkomt je elke dag om je steeds meer verrassende en gastronomische gerechten te laten ontdekken. Een gezellig, intiem kader, vriendelijke bediening en een wijnkaart die je meeneemt op reis!"
    ],
    "es": [
      "El equipo del Domaine des Jardins Suspendus le da la bienvenida cada día para hacerle descubrir platos cada vez más sorprendentes y golosos. Un ambiente íntimo y acogedor, un servicio amable y una carta de vinos que le hará viajar"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Les jardins suspendus"
    ]
  },
