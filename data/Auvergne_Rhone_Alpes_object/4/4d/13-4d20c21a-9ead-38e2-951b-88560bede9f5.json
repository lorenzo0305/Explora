  "rdfs:comment": {
    "de": [
      "Der Kiosk der Anlegestelle am Fuße der Standseilbahn bietet Ihnen ganztägig verschiedenes Fast Food auch zum Mitnehmen."
    ],
    "en": [
      "At the foot of the funicular, the kiosk on the pier offers you a fast service and all-day takeaway."
    ],
    "it": [
      "Ai piedi della funicolare, sul porto turistico, lo \"snack de l'embarcadère\" e \"Aux envies du Lac\" vi danno il benvenuto per soddisfare il vostro palato!"
    ],
    "fr": [
      "Au pied du funiculaire, sur le port de plaisance, le snack de l'embarcadère\" et \"Aux envies du Lac\" vous accueillent pour satisfaire vos papilles !"
    ],
    "es": [
      "Al pie del funicular, en el puerto deportivo, el \"snack de l'embarcadère\" y \"Aux envies du Lac\" le dan la bienvenida para satisfacer su paladar"
    ],
    "nl": [
      "Aan de voet van de kabelbaan, op de jachthaven, verwelkomen de \"snack de l'embarcadère\" en \"Aux envies du Lac\" je om je smaakpapillen te bevredigen!"
    ]
  },
  "rdfs:label": {
