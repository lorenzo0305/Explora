  "rdfs:comment": {
    "de": [
      "Als höchster Punkt des Departements Drôme erhebt er sein abgerundetes mineralisches Gesicht über das unter Naturschutz stehende Gebiet des Vallon de la Jarjatte auf 2453 Metern."
    ],
    "en": [
      "It is the highest point of the Drôme, its rounded rocky face towers high above the listed site of Vallon de la Jarjatte at 2,453m."
    ],
    "it": [
      "Punto più alto del dipartimento della Drôme, la sua parete minerale arrotondata si erge a 2453 metri sopra il sito classificato della valle dello Jarjatte."
    ],
    "fr": [
      "Point culminant du département de la Drôme, il dresse sa face minérale arrondie au dessus du site classé du vallon de la Jarjatte à 2453 mètres."
    ],
    "es": [
      "Punto más alto del departamento de la Drôme, su cara mineral redondeada se eleva sobre el lugar catalogado del valle del Jarjatte a 2453 metros."
    ],
    "nl": [
      "Hoogste punt van het departement de Drôme, hij steekt met zijn afgeronde mineralen zijde uit boven het geklasseerd gebied van de Jarjatte-vallei op 2453 meter."
    ]
  },
