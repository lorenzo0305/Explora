  "rdfs:comment": {
    "de": [
      "Der Salle Emilien Michoux ist ein Theater- und Kinosaal mit 189 Plätzen. Die Filmvorführungen sind vielfältig und richten sich an alle Zuschauer, ebenso das Theater."
    ],
    "en": [
      "The Salle Emilien Michoux is a 189-seat theatre and film theatre. Varied film screenings aimed at all audiences, as well as theatre."
    ],
    "it": [
      "La Salle Emilien Michoux è un teatro e cinema da 189 posti. Offre una varietà di proiezioni di film per tutti i tipi di pubblico, oltre a spettacoli teatrali."
    ],
    "fr": [
      "La salle Emilien Michoux est une salle Théâtrale et cinématographique de 189 places. Projections cinématographique variée s'adressant à tous les publics, de même pour le théâtre."
    ],
    "es": [
      "La Salle Emilien Michoux es un teatro y cine de 189 plazas. Ofrece una variedad de proyecciones de películas para todos los públicos, así como teatro."
    ],
    "nl": [
      "De Salle Emilien Michoux is een theater en bioscoop met 189 plaatsen. Het biedt een verscheidenheid aan filmvertoningen voor alle doelgroepen, evenals theater."
    ]
  },
