  "rdfs:comment": {
    "de": [
      "Schauspiel Le Loup en slip, humoristische Adaption des Comics, Auftakt des Jugendfestivals 2026 - 7. Ausgabe, organisiert von der Mediathek Chamonix, Freitag, 20. März, im Auditorium des EMDI, mit zwei Vorstellungen um 17 Uhr und 18.45 Uhr."
    ],
    "en": [
      "Le Loup en slip, a humorous adaptation of the comic strip, kicks off the Festival Jeunesse 2026 - 7th edition, organized by the Chamonix media library, on Friday March 20 at the EMDI auditorium, with two performances at 5pm and 6:45pm."
    ],
    "it": [
      "Le Loup en slip, adattamento umoristico del fumetto, inaugura la settima edizione del festival dei giovani 2026, organizzato dalla mediateca di Chamonix, venerdì 20 marzo nell'auditorium dell'EMDI, con due spettacoli alle 17.00 e alle 18.45."
    ],
    "fr": [
      "Spectacle Le Loup en slip, adaptation humoristique de la bande dessinée, coup d'envoi du festival jeunesse 2026 - 7ème édition, organisé par la médiathèque de Chamonix, vendredi 20 mars à l'auditorium de l'EMDI, avec deux représentations à 17h et 18h45."
    ],
    "nl": [
      "Le Loup en slip, een humoristische bewerking van het stripverhaal, vormt de aftrap van de 7e editie van het jeugdfestival 2026, georganiseerd door de mediatheek van Chamonix, op vrijdag 20 maart in het auditorium van EMDI, met twee voorstellingen om 17.00 en 18.45 uur."
    ],
    "es": [
      "Le Loup en slip, adaptación humorística del cómic, inaugura la 7ª edición del festival de la juventud 2026, organizado por la mediateca de Chamonix, el viernes 20 de marzo en el auditorio de la EMDI, con dos representaciones a las 17.00 y 18.45 horas."
    ]
  },
