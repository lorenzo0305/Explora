  "rdfs:comment": {
    "de": [
      "Kulturbar, kleine Snacks mit lokalen, originellen und saisonalen Produkten. Die Getränke, die wir anbieten, stammen aus der Listung eines unabhängigen Getränkelieferanten aus der Auvergne. Die Produkte stammen von erntenden Erzeugern"
    ],
    "en": [
      "Cultural bar, snack bar with local, original and seasonal products. Our beverages are sourced from an independent beverage supplier based in the Auvergne region of France. Products are sourced from local growers"
    ],
    "it": [
      "Bar culturale, snack bar con prodotti locali, originali e di stagione. Le bevande offerte provengono da un fornitore indipendente di bevande con sede in Alvernia. I prodotti provengono da produttori locali"
    ],
    "fr": [
      "Bar culturel, petite restauration aux produits locaux, originaux et de saison. Les boissons que nous proposons sont issus d'un référencement par un fournisseur de boissons indépendant situé en Auvergne. Les produits sont issus de producteurs récoltants"
    ],
    "nl": [
      "Cultuurbar, snackbar met lokale, originele en seizoensgebonden producten. De dranken die we aanbieden zijn afkomstig van een onafhankelijke drankenleverancier uit de Auvergne. De producten zijn afkomstig van lokale producenten"
    ],
    "es": [
      "Bar cultural, snack bar con productos locales, originales y de temporada. Las bebidas que ofrecemos proceden de un proveedor de bebidas independiente con sede en Auvernia. Los productos proceden de productores locales"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aux Trois Topines"
    ]
  },
