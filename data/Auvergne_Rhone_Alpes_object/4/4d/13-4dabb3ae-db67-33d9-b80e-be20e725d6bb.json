  "rdfs:comment": {
    "de": [
      "Nachdem Matt Pokora auf seiner 20-Jahre-Tournee die größten Hallen zum Kochen gebracht und mehr als 500.000 Zuschauer versammelt hat, kehrt er mit der \"ADRÉNALINE TOUR\" ins Jahr 2025 zurück."
    ],
    "en": [
      "After setting the world's biggest venues alight and attracting over 500,000 spectators on his 20 YEARS tour, Matt Pokora returns in 2025 with the \"ADRÉNALINE TOUR\"."
    ],
    "it": [
      "Dopo aver infiammato le più grandi sale del mondo e aver attirato oltre 500.000 spettatori con il suo tour 20 YEARS, Matt Pokora torna nel 2025 con l'\"ADRÉNALINE TOUR\"."
    ],
    "fr": [
      "Après avoir enflammé les plus grandes salles et réuni plus de 500 000 spectateurs lors de sa tournée des 20 ANS, Matt Pokora revient en 2025 avec « ADRÉNALINE TOUR »."
    ],
    "es": [
      "Tras incendiar los mayores recintos del mundo y atraer a más de 500.000 espectadores en su gira 20 YEARS, Matt Pokora regresa en 2025 con el \"ADRÉNALINE TOUR\"."
    ],
    "nl": [
      "Na de grootste podia ter wereld in vuur en vlam te hebben gezet en meer dan 500.000 toeschouwers te hebben getrokken tijdens zijn 20 YEARS tour, is Matt Pokora terug in 2025 met de \"ADRÉNALINE TOUR\"."
    ]
  },
  "rdfs:label": {
