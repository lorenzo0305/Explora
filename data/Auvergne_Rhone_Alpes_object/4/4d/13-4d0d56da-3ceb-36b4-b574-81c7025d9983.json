  "rdfs:comment": {
    "de": [
      "Die Promenade de Sablons öffnet sich weit auf den Charme der alten Rhône. Zu Fuß, mit dem Fahrrad oder auf Inline-Skates, sie ist für alle Praktiken geeignet. Am Ende des Kais ist ein Bereich mit Picknicktischen und Toiletten eingerichtet."
    ],
    "en": [
      "The Promenade de Sablons opens onto the charm of the ancient Rhône. On foot, by bike or on rollerblades, it is suitable for all types of activity. At the end of the quay, an area has been set aside with picnic tables and toilets."
    ],
    "it": [
      "La Promenade de Sablons si apre sul fascino dell'antico Rodano. A piedi, in bicicletta o con i rollerblade, è adatta a tutti i tipi di attività. Alla fine della banchina, c'è un'area con tavoli da picnic e servizi igienici."
    ],
    "fr": [
      "La promenade de Sablons ouvre largement sur le charme de l'ancien Rhône. A pied, à vélo, à roller, elle est adaptée à toutes les pratiques. Au bout du quai un espace est aménagé avec des tables de pique-nique et toilettes."
    ],
    "es": [
      "El paseo de Sablons se abre al encanto del antiguo Ródano. A pie, en bicicleta o en patines, es apto para todo tipo de actividades. Al final del muelle, hay una zona con mesas de picnic y aseos."
    ],
    "nl": [
      "De Promenade de Sablons opent zich naar de charme van de oude Rhône. Te voet, op de fiets of op skeelers, het is geschikt voor alle soorten activiteiten. Aan het einde van de kade is er een zone met picknicktafels en toiletten."
    ]
  },
  "rdfs:label": {
