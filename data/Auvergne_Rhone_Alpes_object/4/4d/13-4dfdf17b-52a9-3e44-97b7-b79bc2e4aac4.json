  "rdfs:comment": {
    "de": [
      "\"Chez Mimi\" empfängt Sie an 6 Tagen in der Woche (montags geschlossen) zum Frühstück, Mittag- und Abendessen in einer typisch regionalen, gemütlichen und gedämpften Atmosphäre."
    ],
    "en": [
      "\"Chez Mimi\" welcomes you 6 days a week (closed Mondays and Tuesdays), for breakfast, lunch and dinner, in a typically regional, warm and cosy atmosphere."
    ],
    "it": [
      "\"Chez Mimi\" vi accoglie 6 giorni alla settimana (chiuso il lunedì) per colazione, pranzo e cena, in un'atmosfera tipicamente regionale, calda e accogliente."
    ],
    "fr": [
      "« Chez Mimi » vous accueille 6 jours sur 7 (fermé le lundi), petit-déjeuner, déjeuner et diner, dans une atmosphère typiquement régionale, chaleureuse et feutrée."
    ],
    "nl": [
      "\"Chez Mimi\" verwelkomt je 6 dagen per week (maandag gesloten) voor ontbijt, lunch en diner, in een typisch regionale, warme en gezellige sfeer."
    ],
    "es": [
      "\"Chez Mimi\" le da la bienvenida 6 días a la semana (lunes y martes cerrado) para desayunar, comer y cenar, en un ambiente cálido y acogedor típico de la región."
    ]
  },
