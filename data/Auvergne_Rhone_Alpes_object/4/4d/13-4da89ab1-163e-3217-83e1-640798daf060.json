  "rdfs:comment": {
    "de": [
      "Zu seinem zehnten Geburtstag ehrt das Gitarrenfestival seinen Paten Roland Dyens und beginnt mit einem Eröffnungsabend, der fast ausschließlich seinen Kompositionen gewidmet ist."
    ],
    "en": [
      "For its tenth anniversary, the guitar festival pays tribute to its godfather Roland Dyens with an opening night devoted almost entirely to his compositions."
    ],
    "it": [
      "Per il suo decimo anniversario, il festival chitarristico rende omaggio al suo mecenate Roland Dyens con una serata di apertura dedicata quasi interamente alle sue composizioni."
    ],
    "fr": [
      "Pour son dixième anniversaire, le festival de guitares rend hommage à son parrain Roland Dyens en débutant par une soirée d’ouverture presque entièrement consacrée à ses compositions."
    ],
    "nl": [
      "Voor zijn tiende verjaardag brengt het gitaarfestival een eerbetoon aan zijn beschermheer Roland Dyens met een openingsavond die bijna volledig gewijd is aan zijn composities."
    ],
    "es": [
      "En su décimo aniversario, el festival de guitarra rinde homenaje a su mecenas Roland Dyens con una noche inaugural dedicada casi íntegramente a sus composiciones."
    ]
  },
  "rdfs:label": {
