  "rdfs:comment": {
    "de": [
      "Inmitten der Natur bietet diese ehemalige Pferdepoststation, die sorgfältig restauriert wurde, eine großzügige Küche in einem authentischen Rahmen."
    ],
    "en": [
      "Typical cheese omelette and the famous “truffade” are on the menu of this friendly and traditional restaurant."
    ],
    "it": [
      "In mezzo alla natura, questa ex stazione di posta per cavalli, accuratamente restaurata, offre una cucina generosa in un ambiente autentico."
    ],
    "fr": [
      "En pleine nature, cet ancien relais de poste à cheval, soigneusement restauré, offre une cuisine généreuse dans un cadre authentique."
    ],
    "nl": [
      "Midden in de natuur biedt dit met zorg gerestaureerde voormalige paardenpostkantoor een royale keuken in een authentiek kader."
    ],
    "es": [
      "En plena naturaleza, esta antigua oficina de correos de caballos, cuidadosamente restaurada, ofrece una cocina generosa en un entorno auténtico."
    ]
  },
  "rdfs:label": {
