  "rdfs:comment": {
    "de": [
      "Luz Casal, die rührende spanische Diva, singt immer noch von der Liebe und lädt zu einer weiblichen stimmlichen Weltreise ein."
    ],
    "en": [
      "Luz Casal, the moving Spanish diva, continues to sing about love and invites us on a vocal journey around the world with a feminine touch."
    ],
    "it": [
      "Luz Casal, l'emozionante diva spagnola, canta ancora e ancora l'amore e ci invita a un tour vocale del mondo femminile."
    ],
    "fr": [
      "Luz Casal, l’émouvante diva espagnole, chante encore et toujours l’amour et invite à un tour du monde vocal au féminin."
    ],
    "es": [
      "Luz Casal, la conmovedora diva española, canta al amor una y otra vez y nos invita a un recorrido vocal por el mundo femenino."
    ],
    "nl": [
      "Luz Casal, de ontroerende Spaanse diva, bezingt de liefde keer op keer en nodigt ons uit voor een vocale tour door de vrouwelijke wereld."
    ]
