  "rdfs:comment": {
    "de": [
      "Das Hotel Les Grangettes befindet sich im Herzen von Méribel und dem Ski- und Fahrradgebiet 3 Vallées. Es bietet einen herrlichen Blick auf das Tal von Méribel, einschließlich des Mont Vallon, des Saulire und der Olympischen Gipfel."
    ],
    "en": [
      "Hôtel Les Grangettes is located in the heart of Méribel, within the world-famous Les 3 Vallées. It offers views of the Méribel Valley, including Mont Vallon, Saulire and Olympic peaks."
    ],
    "it": [
      "L'Hotel Les Grangettes si trova nel cuore di Méribel e del comprensorio sciistico e ciclistico delle 3 Vallées. L'hotel offre una magnifica vista sulla valle di Méribel, tra cui Mont Vallon, La Saulire e le vette olimpiche."
    ],
    "fr": [
      "L'hôtel Les Grangettes est situé au coeur de Méribel et du domaine skiable et cyclable des 3 Vallées. L'établissement offre de magnifiques vues sur la vallée de Méribel, notamment sur le Mont Vallon, la Saulire et les sommets olympiques."
    ],
    "nl": [
      "Les Grangettes ligt in het hart van Méribel en het ski- en fietsgebied van de 3 Valleien. Het hotel biedt een prachtig uitzicht op de vallei van Meribel, inclusief Mont Vallon, La Saulire en de Olympische toppen."
    ],
    "es": [
      "El Hotel Les Grangettes está situado en el corazón de Méribel y de la zona de esquí y ciclismo de los 3 Vallées. El hotel ofrece magníficas vistas del valle de Méribel, incluidos el Mont Vallon, La Saulire y los picos olímpicos."
    ]
  },
