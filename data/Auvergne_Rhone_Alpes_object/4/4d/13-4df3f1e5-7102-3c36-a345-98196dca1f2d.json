  "rdfs:comment": {
    "de": [
      "Leidenschaft für Holz in all seinen Formen. Ich arbeite auf Anfrage, um Ihre Ideen zu verwirklichen.\r\nPraktika auf Anfrage anpassbar."
    ],
    "en": [
      "Passionate about wood in all its forms, I work on demand to realize your ideas.\r\nCustomized courses on request."
    ],
    "it": [
      "Appassionata del legno in tutte le sue forme, lavoro su commissione per dare vita alle vostre idee.\r\nI corsi possono essere personalizzati su richiesta."
    ],
    "fr": [
      "Passionné par le bois sous toutes ses formes je travaille à la demande pour réaliser vos idées.\r\nStages personnalisable sur demande."
    ],
    "nl": [
      "Gepassioneerd door hout in al zijn vormen, werk ik op bestelling om jouw ideeën tot leven te brengen.\r\nCursussen kunnen op verzoek worden aangepast."
    ],
    "es": [
      "Apasionado de la madera en todas sus formas, trabajo por encargo para dar vida a sus ideas.\r\nLos cursos se pueden personalizar a petición."
    ]
