  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Arbeit in den Weinbergen und die Lebensgewohnheiten der Bewohner des Forez mit Hilfe von Videos,\r\nAudiodateien, Modellen und Spielen in einem Schloss aus dem achtzehnten\r\nJahrhundert."
    ],
    "en": [
      "Catch a glimpse of life of Forez winegrowers at home and at work in a 18th century castle thanks to reconstructions, video and audio display."
    ],
    "it": [
      "Ospitato nello Château de Boën sur Lignon, costruito nel XVIII secolo, il Musée des Vignerons du Forez (Museo dei Vignaioli di Forez) presenta una collezione che ripercorre la vita dei vignaioli e il lavoro della vite a Forez dal XIX secolo al 1925."
    ],
    "fr": [
      "Au sein du château de Boën sur Lignon construit au 18e siècle, le musée des Vignerons du Forez présente une collection qui retrace la vie des vignerons et le travail de la vigne en Forez du 19e siècle jusqu'en 1925."
    ],
    "nl": [
      "Het Musée des Vignerons du Forez (Wijnbouwersmuseum van Forez) is gehuisvest in het kasteel van Boën sur Lignon, gebouwd in de 18e eeuw, en presenteert een collectie die het leven van de wijnbouwers en het werk van de wijnstokken in Forez van de 19e eeuw tot 1925 laat zien."
    ],
    "es": [
      "Alojado en el castillo de Boën sur Lignon, construido en el siglo XVIII, el Musée des Vignerons du Forez (Museo de los Viticultores de Forez) presenta una colección que recorre la vida de los viticultores y el trabajo de la vid en Forez desde el siglo XIX hasta 1925."
    ]
  },
