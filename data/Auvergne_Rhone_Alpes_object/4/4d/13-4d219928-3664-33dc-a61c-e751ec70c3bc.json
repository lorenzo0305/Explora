  "rdfs:comment": {
    "de": [
      "Wir bieten ausgestattete Räume für Bodybuilding und Fitness, Gruppenkurse (Body-Sculpt, Pilates, Stretching, Cardio-Training...), ein Hammam (auf Reservierung), eine persönliche Betreuung in Anwesenheit des Sporttrainers (bitte erkundigen Sie sich)."
    ],
    "en": [
      "We offer rooms equipped for bodybuilding and fitness, group lessons (body-sculpt, pilates, stretching, cardio-training...), a hammam (reservation required), a personalized accompaniment in the presence of the sports coach (ask for information)."
    ],
    "it": [
      "Offriamo sale attrezzate per l'allenamento con i pesi e il fitness, corsi di gruppo (body-sculpting, pilates, stretching, cardio-training...), un hammam (su prenotazione), un accompagnamento personalizzato in presenza del coach sportivo (chiedere informazioni)."
    ],
    "fr": [
      "Nous proposons des salles équipées pour la musculation et le fitness, des cours collectifs (body-sculpt, pilates, stretching, cardio-training...), un hammam (sur réservation), un accompagnement personnalisé en présence du coach sportif (se renseigner)."
    ],
    "nl": [
      "Wij bieden zalen voor krachttraining en fitness, groepslessen (body-sculpting, pilates, stretching, cardiotraining...), een hammam (op reservering), en persoonlijke begeleiding in aanwezigheid van een sportcoach (vraag om informatie)."
    ],
    "es": [
      "Ofrecemos salas equipadas para la musculación y el fitness, clases en grupo (body-sculpting, pilates, stretching, cardio-training...), un hammam (bajo reserva), y un acompañamiento personalizado en presencia de un coach deportivo (solicitar información)."
    ]
  },
