  "rdfs:comment": {
    "de": [
      "Bewundern Sie den außergewöhnlichen Ausblick auf \"den Gürtel\", den die Weinberge umgeben, soweit das Auge reicht."
    ],
    "en": [
      "Admire the exceptional view of the \"belt\" that surrounds the vines as far as the eye can see."
    ],
    "it": [
      "Ammirate la vista eccezionale della \"cintura\" circondata da vigneti a perdita d'occhio."
    ],
    "fr": [
      "Admirez le point de vue exceptionnel sur \"la ceinture\" qu'entoure les vignes à perte de vue."
    ],
    "nl": [
      "Bewonder het uitzonderlijke uitzicht op de \"gordel\" omgeven door wijnranken zover het oog reikt."
    ],
    "es": [
      "Admire la excepcional vista del \"cinturón\" rodeado de viñedos hasta donde alcanza la vista."
    ]
  },
