  "rdfs:comment": {
    "de": [
      "Eine warme und entspannte Atmosphäre, in der die Leidenschaft für Kaffee, gesundes Essen, Kunst und Fotografie im Vordergrund stehen. Entdecken Sie diese atypische Umgebung im Herzen von Chamonix!"
    ],
    "en": [
      "A warm, relaxed atmosphere where a passion for coffee, healthy food, art and photography take center stage. Come and discover this unusual setting in the heart of Chamonix!"
    ],
    "it": [
      "Un'atmosfera calda e rilassata dove la passione per il caffè, il cibo sano, l'arte e la fotografia sono al centro dell'attenzione. Venite a scoprire questo ambiente insolito nel cuore di Chamonix!"
    ],
    "fr": [
      "Une ambiance chaleureuse et décontractée où la passion du café, la nourriture saine, l’art et la photo sont à l’honneur. Venez découvrir ce cadre atypique en plein cœur de Chamonix!"
    ],
    "es": [
      "Un ambiente cálido y relajado donde la pasión por el café, la comida sana, el arte y la fotografía son los protagonistas. Venga a descubrir este marco insólito en el corazón de Chamonix."
    ],
    "nl": [
      "Een warme, ontspannen sfeer waar passie voor koffie, gezonde voeding, kunst en fotografie centraal staan. Kom en ontdek deze ongewone omgeving in het hart van Chamonix!"
    ]
  },
