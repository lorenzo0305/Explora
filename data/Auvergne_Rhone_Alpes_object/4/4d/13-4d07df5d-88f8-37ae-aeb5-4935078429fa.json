  "rdfs:comment": {
    "de": [
      "Neuheit Winter 2026 ? die morgendliche Inspiration\r\nBeginnen Sie den Tag mit einem süßen Moment:\r\ngourmet-Begrüßungskaffee\r\nentdeckungstasche Pure Altitude\r\n? 2 Stunden kostenloser Zugang zum Spa\r\n45 ? pro Person ? auf Vorbestellung"
    ],
    "en": [
      "New for Winter 2026 – Morning Inspiration\r\nStart your day with a moment of softness:\r\n• A gourmet welcome coffee\r\n• A Pure Altitude discovery kit\r\n• 2 hours of complimentary spa access\r\n\r\n€45 per person – by reservation"
    ],
    "it": [
      "Novità per l'inverno 2026? Ispirazione mattutina\r\nIniziate la giornata con un momento di piacere:\r\ncaffè di benvenuto gourmet\r\nkit di scoperta Pure Altitude\r\n2 ore di accesso gratuito alla spa\r\n45 ? per persona ? su prenotazione"
    ],
    "fr": [
      "Nouveauté Hiver 2026 – l’Inspiration Matinale\r\nCommencez la journée par un instant de douceur :\r\n•\tCafé d’accueil gourmand\r\n•\tTrousse découverte Pure Altitude\r\n•\t2 heures d’accès offertes au spa\r\n45 € par personne – sur réservation"
    ],
    "es": [
      "Novedades para el invierno 2026 Inspiración matutina\r\nComience el día con un momento de indulgencia:\r\ncafé gourmet de bienvenida\r\nkit de descubrimiento Pure Altitude\r\n? 2 horas de acceso gratuito al spa\r\n45 € por persona previa reserva"
    ],
    "nl": [
      "Nieuw in de winter van 2026 – De Ochtendinspiratie\r\nBegin uw dag met een moment van zachtheid:\r\n• Een heerlijke welkomstkoffie\r\n• Een Pure Altitude kennismakingsset\r\n• 2 uur gratis toegang tot de spa\r\n\r\n45 € per persoon – op reservatie"
    ]
  },
