  "rdfs:comment": {
    "de": [
      "Praktik: Gleitschirmfliegen, Orientierung: nc, Achtung Hochspannungsleitung entlang der Gemeindestraße von Troubois, daher ist das Gelände in seinem oberen Teil per Präfekturerlass verboten. Gelände unterhalb des Maisfeldes. Vorsicht beim Heuen."
    ],
    "en": [
      "Practice: paragliding, orienteering: nc, please note that the high-voltage power line runs along the Troubois road, so the upper part of the site is prohibited by prefectoral decree. Terrain below the cornfield. Watch out for hay."
    ],
    "it": [
      "Pratica: parapendio, orientamento: nc, attenzione linea ad alta tensione lungo la strada comunale di Troubois quindi terreno vietato nella sua parte alta per decreto prefettizio. Il terreno sotto il campo di grano. Attenzione alla fienagione."
    ],
    "fr": [
      "Pratique : parapente, orientation : nc, attention ligne à haute tension longeant la route communale de Troubois donc terrain interdit dans sa partie haute par arrêté préfectoral. Terrain en contrebas du champs de maïs. Attention aux foins."
    ],
    "nl": [
      "Praktijk: paragliding, oriëntatieloop: nc, pas op voor de hoogspanningsleiding die langs de lokale weg Troubois loopt, daarom is het bovenste deel van het veld verboden bij prefectoraal besluit. Terrein onder het maïsveld. Pas op voor het hooi."
    ],
    "es": [
      "Práctica: parapente, orientación: nc, atención línea de alta tensión a lo largo de la carretera comunal de Troubois así terreno prohibido en su parte alta por decreto prefectoral. Terreno bajo el maizal. Cuidado con el heno."
    ]
  },
  "rdfs:label": {
    "en": [
      "Troubois landing site"
    ],
    "fr": [
      "Terrain d'atterrissage de Troubois"
    ],
    "nl": [
      "Troubois landingsbaan"
    ]
  },
