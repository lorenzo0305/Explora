  "rdfs:comment": {
    "de": [
      "Oberhalb des Sees von Naussac bietet die alte Festungsstadt Pradelles mit ihren mittelalterlichen Gassen, die von im Laufe der Jahrhunderte erbauten Häusern gesäumt sind, einen spektakulären Blick auf das gesamte Tal des Haut-Allier."
    ],
    "en": [
      "High above Lake Naussac, the ancient fortified town of Pradelles, with its medieval streets lined with houses built over the centuries, offers spectacular views over the entire Haut-Allier valley."
    ],
    "it": [
      "Sopra il lago di Naussac, l'antica città fortificata di Pradelles, con le sue strade medievali fiancheggiate da case costruite nel corso dei secoli, offre una vista spettacolare sull'intera valle dell'Haut-Allier."
    ],
    "fr": [
      "Au dessus du lac de Naussac, l'ancienne cité fortifiée de Pradelles, avec ses ruelles médiévales bordées de maisons bâties au fil des siècles, offre une vue spectaculaire sur toute la vallée du Haut-Allier."
    ],
    "nl": [
      "Hoog boven het meer van Naussac biedt het oude versterkte stadje Pradelles, met zijn middeleeuwse straten omzoomd door huizen die door de eeuwen heen zijn gebouwd, een spectaculair uitzicht over de hele vallei van de Haut-Allier."
    ],
    "es": [
      "En lo alto del lago de Naussac, la antigua ciudad fortificada de Pradelles, con sus calles medievales bordeadas de casas construidas a lo largo de los siglos, ofrece unas vistas espectaculares de todo el valle del Haut-Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Pradelles |  Plus Beau Village de France"
    ]
  },
