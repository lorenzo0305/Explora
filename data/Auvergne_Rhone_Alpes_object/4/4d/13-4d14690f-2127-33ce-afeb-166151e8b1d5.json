  "rdfs:comment": {
    "de": [
      "Nachdem er ganz Frankreich, Belgien und die Schweiz mit einer Doppel-Tournee \"Johnny, vous & moi\" (elektrisch & unplugged n'roll) mit mehr als 130 Terminen in Schwingung versetzt hat; kehrt das Phänomen JEAN BAPTISTE GUEGAN mit einer ganz neuen Event-Show zurück."
    ],
    "en": [
      "After thrilling the whole of France, Belgium and Switzerland, with a double \"Johnny, vous & moi\" tour (electric & unplugged n'roll) of over 130 dates, the phenomenon JEAN BAPTISTE GUEGAN returns with a brand-new event show."
    ],
    "it": [
      "Dopo aver fatto il botto in Francia, Belgio e Svizzera con il suo doppio tour \"Johnny, vous & moi\" (elettrico e unplugged n'roll), che ha incluso più di 130 date, il fenomeno JEAN BAPTISTE GUEGAN torna con un nuovo spettacolo evento."
    ],
    "fr": [
      "Après avoir fait vibrer toute la France, Belgique et Suisse, avec une double tournée « Johnny, vous & moi » (électrique & unplugged n'roll), de plus de 130 dates ; le phénomène JEAN BAPTISTE GUEGAN revient avec un tout nouveau spectacle événement."
    ],
    "es": [
      "Tras arrasar en Francia, Bélgica y Suiza con su doble gira \"Johnny, vous & moi\" (n'roll eléctrico y desenchufado), que incluyó más de 130 fechas, el fenómeno JEAN BAPTISTE GUEGAN regresa con un nuevo espectáculo."
    ],
    "nl": [
      "Nadat hij met zijn dubbele \"Johnny, vous & moi\"-tournee (electric & unplugged n'roll), die meer dan 130 data omvatte, het huis plat kreeg in Frankrijk, België en Zwitserland, is het fenomeen JEAN BAPTISTE GUEGAN terug met een gloednieuwe show."
    ]
  },
