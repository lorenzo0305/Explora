  "rdfs:comment": {
    "de": [
      "Lassen Sie uns gemeinsam singen und mit der Stimme spielen, sich von den Zehenspitzen bis zu den Fingerspitzen bewegen und Instrumente für alle Hände ausprobieren... Alle Sinne werden geweckt, um Geschmack an der Musik zu finden! Musikworkshop unter der Leitung von Aurélie Cimen, Musikerin."
    ],
    "en": [
      "Let's share songs and voice games, movements from toe to fingertips, instruments for all hands... All the senses awakened to get a taste for music! Musical workshop led by Aurélie Cimen."
    ],
    "it": [
      "Insieme canteremo e suoneremo con la voce, ci muoveremo dalla punta dei piedi a quella delle dita, suoneremo strumenti per tutte le mani... Tutti i sensi saranno risvegliati mentre sviluppiamo il gusto per la musica! Laboratorio musicale condotto da Aurélie Cimen."
    ],
    "fr": [
      "Partageons ensemble chants et jeux de voix, mouvements du bout des pieds aux bout des doigts, des instruments pour toutes les mains...Tous les sens en éveil pour prendre goût à la musique ! Atelier musical animé par Aurélie Cimen, musicienne intervenante."
    ],
    "nl": [
      "Samen zingen en spelen we met onze stemmen, bewegen we van de toppen van onze tenen tot de toppen van onze vingers, bespelen we instrumenten voor alle handen... Alle zintuigen worden geprikkeld terwijl we de smaak voor muziek ontwikkelen! Muziekworkshop onder leiding van Aurélie Cimen."
    ],
    "es": [
      "Juntos cantaremos y tocaremos con la voz, nos moveremos de la punta de los pies a la punta de los dedos, tocaremos instrumentos para todas las manos... ¡Todos los sentidos se despertarán mientras desarrollamos el gusto por la música! Taller de música dirigido por Aurélie Cimen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Printemps des p'tites pousses - Éveil musical"
    ]
  },
