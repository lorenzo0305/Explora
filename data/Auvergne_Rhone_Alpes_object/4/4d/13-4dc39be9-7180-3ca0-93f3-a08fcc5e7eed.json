  "rdfs:comment": {
    "de": [
      "Unternehmen für Laserschnitt und -gravur. Herstellung von einzigartigen Objekten und Personalisierung.\r\nGravur von Jagdwaffen, Messern, Schneidebrettern, Bierdeckeln und vielen anderen Objekten"
    ],
    "en": [
      "Laser cutting and engraving company. Creation and personalization of unique objects.\r\nCross-engraving of hunting weapons, knives, cutting boards, coasters and many other objects!"
    ],
    "it": [
      "Azienda di taglio e incisione laser. Creazione di oggetti unici e personalizzazione.\r\nIncisione trasversale di fucili da caccia, coltelli, taglieri, sottobicchieri e molti altri oggetti!"
    ],
    "fr": [
      "Entreprise de decoupe et gravure laser. Création d'objets uniques, et personnalisation. \r\nGravure sur cross d'armes de chasse, couteau, planche à découper, sous-verre, et bon nombres d'objets !"
    ],
    "nl": [
      "Lasersnij- en graveerbedrijf. Creatie van unieke objecten en personalisatie.\r\nKruisgravures van jachtgeweren, messen, snijplanken, onderzetters en vele andere voorwerpen!"
    ],
    "es": [
      "Empresa de corte y grabado por láser. Creación de objetos únicos y personalización.\r\nGrabado en cruz de escopetas de caza, cuchillos, tablas de cortar, posavasos y muchos otros objetos"
    ]
  },
