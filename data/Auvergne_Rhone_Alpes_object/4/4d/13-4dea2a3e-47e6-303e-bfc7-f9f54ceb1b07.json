  "rdfs:comment": {
    "de": [
      "1 km lange Strecke für erfahrene Angler, die abwechselnd flache und strömungsreiche Abschnitte aufweist.\r\nNeuheit 2026: Fischereiaufseher, der der AAPPMA von Combronde zugewiesen ist und für die Überwachung der Angelstrecke „La Morge au Moulin de Morel” zuständig ist."
    ],
    "en": [
      "A 1 km stretch for experienced anglers, featuring alternating flat areas and currents.\r\nNew for 2026: Fishing warden assigned to the Combronde AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique - Approved Association for Fishing and Protection of the Aquatic Environment) and responsible for monitoring the fishing stretch - La Morge at the Moulin de Morel."
    ],
    "it": [
      "Percorso di 1 km per pescatori esperti, con alternanza di piane e correnti.\r\nNovità 2026: guardiano di pesca assegnato alla Combronde AAPPMA e responsabile della supervisione del corso di pesca - La Morge au Moulin de Morel"
    ],
    "fr": [
      "Parcours long d'1 km, pour pêcheurs confirmés, qui présente une alternance de plats et de courants.\r\nNouveauté 2026 : Garde de pêche affecté à l'AAPPMA de Combronde et en charge de la surveillance du parcours de pêche - La Morge au Moulin de Morel"
    ],
    "es": [
      "Recorrido de 1 km para pescadores experimentados, con alternancia de bajos y corrientes.\r\nNovedad para 2026: guarda de pesca asignado a la AAPPMA de Combronde y responsable de supervisar el curso de pesca - La Morge au Moulin de Morel"
    ],
    "nl": [
      "1 km lang parcours voor ervaren vissers, met afwisselend vlaktes en stromingen.\r\nNieuw in 2026: Vismeester toegewezen aan de Combronde AAPPMA en verantwoordelijk voor het toezicht op het visparcours - La Morge au Moulin de Morel"
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstrecke - La Morge au Moulin de Morel"
    ],
    "en": [
      "Fishing trail - La Morge at Moulin de Morel"
    ],
    "fr": [
      "Parcours de pêche - La Morge au Moulin de Morel"
    ]
  },
