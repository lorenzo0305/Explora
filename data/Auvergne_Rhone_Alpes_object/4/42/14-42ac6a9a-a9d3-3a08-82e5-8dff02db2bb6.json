  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6808cf95-fcb4-3596-bc0a-4f047e0a54ea",
      "dc:description": {
        "de": [
          "Reitstall der Besitzer-Dressurreiten in der iberischen Tradition\nEmpfang von durchreisenden Reitern und ihren Pferden\nmontag bis Samstag von 10 bis 12 Uhr und von 14.30 bis 19 Uhr"
        ],
        "en": [
          "Owners' stable-Dressage in the Iberian tradition\nWelcome to visiting riders and their horses\nmonday to Saturday, 10am to 12pm and 2.30pm to 7pm"
        ],
        "it": [
          "Scuderia di proprietà - Dressage nella tradizione iberica\nAccogliamo i cavalieri in visita e i loro cavalli\nda lunedì a sabato, dalle 10.00 alle 12.00 e dalle 14.30 alle 19.00"
        ],
        "fr": [
          "Ecurie de propriétaires-Dressage dans la tradition ibérique\nAccueil des cavaliers de passage et leur cheval\ndu lundi au samedi de 10h à 12h et de 14h30 à 19h"
        ],
        "nl": [
          "Eigenaren stal-Dressuur in de Iberische traditie\nWe verwelkomen bezoekende ruiters en hun paarden\nmaandag tot zaterdag van 10.00 tot 12.00 uur en van 14.30 tot 19.00 uur"
        ],
        "es": [
          "Cuadra de propietarios-Doma de tradición ibérica\nAcogemos a jinetes visitantes y a sus caballos\nde lunes a sábado, de 10h a 12h y de 14h30 a 19h"
        ]
      },
