      "@id": "https://data.datatourisme.fr/4ddc897c-8b38-36e1-9eb8-ec1f0dcfc5c5",
      "dc:description": {
        "de": [
          "Einführung in den Golfsport mit Le Golf d?Hardelot\n\nVon 6 bis 12 Jahren\n\nGolf d'Hardelot\n\nBeschreibung: Entdeckungsworkshop und Einführung in den Golfsport mit unserem Lehrer Pierre-Henri. 10?/Kind. Anmeldungen sind unbedingt erforderlich auf der Website www.hardelotgolfclub.com"
        ],
        "en": [
          "Golf initiation with Le Golf d?Hardelot\n\nFrom 6 to 12 years old\n\nHardelot Golf Club\n\nDescription: Golf discovery and initiation workshop with our instructor Pierre-Henri. 10 per child. Registration essential on www.hardelotgolfclub.com"
        ],
        "it": [
          "Introduzione al golf con Le Golf d'Hardelot\n\nDa 6 a 12 anni\n\nGolf Club Hardelot\n\nDescrizione: Laboratorio di scoperta e iniziazione al golf con il nostro maestro Pierre-Henri. 10 per bambino. È necessario iscriversi sul sito www.hardelotgolfclub.com"
        ],
        "fr": [
          "Initiation au Golf avec Le Golf d’Hardelot\n\nDe 6 à 12 ans\n\nGolf d’Hardelot\n\nDescriptif : Atelier découverte et initiation au Golf avec notre enseignant Pierre-Henri. 10€/enfant. Inscriptions indispensables sur le site internet www.hardelotgolfclub.com"
        ],
        "nl": [
          "Kennismaking met golf bij Golf d'Hardelot\n\nVan 6 tot 12 jaar\n\nGolfclub Hardelot\n\nOmschrijving: Golf ontdekking en initiatie workshop met onze leraar Pierre-Henri. 10 per kind. Inschrijven via de website www.hardelotgolfclub.com"
        ],
        "es": [
          "Iniciación al golf con Le Golf d'Hardelot\n\nDe 6 a 12 años\n\nClub de golf de Hardelot\n\nDescripción: Taller de iniciación y descubrimiento del golf con nuestro profesor Pierre-Henri. 10 por niño. Inscripción obligatoria en la página web www.hardelotgolfclub.com"
        ]
      },
