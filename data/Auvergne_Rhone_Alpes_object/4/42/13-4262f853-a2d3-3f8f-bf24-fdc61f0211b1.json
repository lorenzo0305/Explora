  "rdfs:comment": {
    "de": [
      "La ferme de l'Etoile Noire: die ersten Erzeuger von Bio-Black Angus in der Ardèche., aber auch von Freilandschweinen und Lämmern.\r\nZum Verkauf auf dem Bauernhof: Fleisch, Wurst, Terrinen..."
    ],
    "en": [
      "La ferme de l'Etoile Noire: the first producers of organic Black Angus in Ardèche, as well as free-range pork and lamb.\r\nOn sale at the farm: meats, sausages, terrines..."
    ],
    "it": [
      "La ferme de l'Etoile Noire: i primi produttori di Black Angus biologico nell'Ardèche, nonché di carne di maiale e agnello allevati all'aperto.\r\nIn vendita presso la fattoria: carne, salsicce, terrine, ecc."
    ],
    "fr": [
      "La ferme de l'Etoile Noire : les premiers producteurs de Black Angus Bio en Ardèche., mais également de porc plein air et d'agneaux.\r\nEn vente à la ferme : viandes, saucissons, terrines..."
    ],
    "es": [
      "La ferme de l'Etoile Noire: los primeros productores de Black Angus ecológico de Ardèche, así como de cerdo y cordero de granja.\r\nVenta en la granja: carne, salchichas, terrinas, etc."
    ],
    "nl": [
      "La ferme de l'Etoile Noire: de eerste producenten van biologische Black Angus in de Ardèche, evenals scharrelvarkensvlees en lamsvlees.\r\nVerkoop op de boerderij: vlees, worsten, terrines, enz."
    ]
  },
  "rdfs:label": {
