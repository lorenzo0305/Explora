  "rdfs:comment": {
    "de": [
      "Die Nacht der Museen ist eine Einladung, die Museen in einem anderen Licht zu entdecken...\r\nIn Oyonnax kleidet sich das Museum in eine besondere Hülle, die im Zeichen der Imitation steht!\r\nLassen Sie sich überraschen!"
    ],
    "en": [
      "Museum Night is an invitation to discover museums in a different light...\r\nIn Oyonnax, the museum is decked out in a special envelope of imitation!\r\nLet us surprise you!"
    ],
    "it": [
      "La Notte dei Musei è un invito a scoprire i musei sotto una luce diversa...\r\nA Oyonnax, il museo si veste di una speciale busta di imitazione!\r\nLasciatevi sorprendere!"
    ],
    "fr": [
      "La Nuit des musées est une invitation à découvrir les musées sous une autre lumière...\r\nÀ Oyonnax, le musée se pare d’une enveloppe particulière, sous le signe de l’imitation ! \r\nLaissez-vous surprendre !"
    ],
    "nl": [
      "Museumnacht is een uitnodiging om musea in een ander licht te ontdekken...\r\nIn Oyonnax wordt het museum aangekleed in een speciale imitatie-enveloppe!\r\nLaat je verrassen!"
    ],
    "es": [
      "La Noche de los Museos es una invitación a descubrir los museos bajo una luz diferente...\r\nEn Oyonnax, ¡el museo se viste de gala!\r\n¡Déjese sorprender!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nuit Européenne des Musées au Musée du Peigne"
    ]
  },
