  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cd4f2d5a-f207-38c8-8f45-c8ecadb4eab7",
      "dc:description": {
        "de": [
          "Mathieu bietet Ihnen einen Ausflug mit dem Zodiac-Boot an, um die Robben in der Somme-Bucht zu entdecken, je nach Gezeiten.\nDamit Sie die Stars der Baie de Somme, die Robben, sehen können!"
        ],
        "en": [
          "Depending on the tides, Mathieu will take you on a zodiac boat trip to discover the seals in the Baie de Somme.\nA chance to see the stars of the Baie de Somme, the seals!"
        ],
        "it": [
          "A seconda delle maree, Mathieu vi porterà in barca con lo zodiac alla scoperta delle foche della Baie de Somme.\nCosì potrete vedere le stelle della Baie de Somme, le foche!"
        ],
        "fr": [
          "Au gré des marées, Mathieu vous propose une excursion en bateau “zodiac” à la découverte des phoques en Baie de Somme.\nPour vous permettre de voir les stars de la Baie de Somme, qui sont les phoques!!"
        ],
        "es": [
          "Dependiendo de las mareas, Mathieu te llevará en zodiac a descubrir las focas de la bahía de Somme.\nAsí podrás ver a las estrellas de la Bahía de Somme, ¡las focas!"
        ],
        "nl": [
          "Afhankelijk van de getijden neemt Mathieu je mee op een zodiac-boottocht om de zeehonden in de Baie de Somme te ontdekken.\nZo zie je de sterren van de Baie de Somme, de zeehonden!"
        ]
      },
