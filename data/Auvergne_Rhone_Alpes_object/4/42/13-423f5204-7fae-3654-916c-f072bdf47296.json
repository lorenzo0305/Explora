  "rdfs:comment": {
    "de": [
      "\"La Roue Quine\", früher mit \"Enduro de Cellier\" betitelt, ist ein 5,9 Kilometer langer blauer Mountainbike-Trail in der Kategorie Enduro-Parcours mit einer Gesamtlänge von 69,1 Kilometern! Erreichbar über TC de Planchamp!"
    ],
    "en": [
      "\"La Roue Quine\", formerly known as \"Enduro de Cellier\", is a 5.9-kilometre blue MTB track in the Enduro Course category, with a total length of 69.1 kilometers! Accessible via TC de Planchamp!"
    ],
    "it": [
      "\"La Roue Quine\", precedentemente nota come \"Enduro de Cellier\", è un tracciato blu per MTB di 5,9 km della categoria Enduro Course con una lunghezza totale di 69,1 km! Accessibile via TC de Planchamp!"
    ],
    "fr": [
      "\"La Roue Quine\", anciennement intitulée \"Enduro de Cellier\" est une piste VTT bleue de 5,9 kilomètres dans la catégorie Parcours Enduro d'un total de 69,1 kilomètres ! Accessible via TC de Planchamp !"
    ],
    "es": [
      "¡\"La Roue Quine\", anteriormente conocida como \"Enduro de Cellier\", es una pista azul de BTT de 5,9 kilómetros en la categoría Enduro Course con una longitud total de 69,1 kilómetros! Accesible a través del TC de Planchamp"
    ],
    "nl": [
      "\"La Roue Quine\", vroeger bekend als de \"Enduro de Cellier\", is een 5,9 kilometer lang blauw MTB parcours in de categorie Enduro parcours met een totale lengte van 69,1 kilometer! Bereikbaar via TC de Planchamp!"
    ]
  },
