  "rdfs:comment": {
    "de": [
      "4. Generation für unser Familienweingut! Im Herzen der Pierres Dorées wissen wir, wie wir Ihnen unsere autentische Weinproduktion näher bringen können.\r\n\r\nWeinproben, Mâchon und Besichtigungen sind das ganze Jahr über nach Vereinbarung möglich."
    ],
    "en": [
      "We are the 4th generation of our family estate! Nestled in the heart of the Pierres Dorées, we invite you to discover our authentic wines.\r\n\r\nWine tastings, traditional \"mâchons\" (local feasts), and vineyard tours are available by appointment throughout the year."
    ],
    "it": [
      "quarta generazione per la nostra tenuta di famiglia! Nel cuore della regione delle Pierres Dorées, saremo lieti di mostrarvi i nostri vini autentici.\r\n\r\nDegustazioni, mâchon e visite sono disponibili su appuntamento durante tutto l'anno."
    ],
    "fr": [
      "4ème génération pour notre domaine familial ! Au coeur des Pierres Dorées, nous saurons vous faire découvrir notre production de vins authéntiques.\r\n\r\nDégustation, mâchon et visites possibles sur rendez-vous tout au long de l'année."
    ],
    "nl": [
      "4e generatie voor ons familiedomein! In het hart van de regio Pierres Dorées laten we je graag onze authentieke wijnen zien.\r\n\r\nProeverijen, mâchons en bezoeken zijn het hele jaar door mogelijk op afspraak."
    ],
    "es": [
      "4ª generación de nuestra explotación familiar En el corazón de la región de Pierres Dorées, estaremos encantados de mostrarle nuestros vinos auténticos.\r\n\r\nDegustaciones, mâchon y visitas están disponibles con cita previa durante todo el año."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bois du jour domain"
    ],
    "fr": [
      "Domaine du bois du jour"
    ]
  },
