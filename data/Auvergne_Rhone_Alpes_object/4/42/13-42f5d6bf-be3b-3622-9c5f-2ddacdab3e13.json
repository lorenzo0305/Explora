  "rdfs:comment": {
    "de": [
      "Sie wurde von Cité Création realisiert und am 18. Juni 2015 eingeweiht, dem Jahrestag des Aufrufs von General de Gaulle über die Wellen der BBC im Jahr 1940, einem Aufruf zum Widerstand gegen die Überlassung Frankreichs an die Nationalsozialisten."
    ],
    "en": [
      "Produced by Cité Création, it was inaugurated on June 18, 2015, the anniversary of General de Gaulle?s appeal on the BBC in 1940, a call to resist the abandonment of France to the Nazis."
    ],
    "it": [
      "Prodotto da Cité Création, è stato inaugurato il 18 giugno 2015, anniversario dell'appello del generale de Gaulle alla BBC nel 1940, un appello a resistere all'abbandono della Francia ai nazisti."
    ],
    "fr": [
      "Réalisée par Cité Création, elle est inaugurée le 18 juin 2015, anniversaire de l’appel du Général de Gaulle sur les ondes de la BBC en 1940, un appel à résister contre l’abandon de la France aux nazis."
    ],
    "es": [
      "Producido por Cité Création, se inauguró el 18 de junio de 2015, aniversario del llamamiento del general De Gaulle en la BBC en 1940, un llamamiento a resistir el abandono de Francia a los nazis."
    ],
    "nl": [
      "Het werd geproduceerd door Cité Création en ingehuldigd op 18 juni 2015, de verjaardag van de oproep van generaal de Gaulle op de BBC in 1940, een oproep om zich te verzetten tegen de overgave van Frankrijk aan de nazi's."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Mur de la Paix"
    ]
  },
