  "rdfs:comment": {
    "de": [
      "Im Herzen des historischen Zentrums von Riom empfängt Sie das Fremdenverkehrsamt Terra Volcana, das Ihnen die Reichtümer der Region vorstellen wird."
    ],
    "en": [
      "In the heart of the historic centre of Riom, the Terra Volcana Tourist Office welcomes you and will present you the richness of the territory."
    ],
    "it": [
      "Nel cuore del centro storico di Riom, l'Ufficio del Turismo Terra Volcana vi accoglie e vi farà conoscere le ricchezze della zona."
    ],
    "fr": [
      "En plein cœur du centre historique de Riom, l'Office de Tourisme Terra Volcana vous accueille et vous présentera les richesses du territoire."
    ],
    "nl": [
      "In het hart van het historische centrum van Riom heet het VVV-kantoor Terra Volcana u welkom en laat u kennismaken met de rijkdommen van de streek."
    ],
    "es": [
      "En el corazón del centro histórico de Riom, la Oficina de Turismo de Terra Volcana le da la bienvenida y le presenta las riquezas de la zona."
    ]
