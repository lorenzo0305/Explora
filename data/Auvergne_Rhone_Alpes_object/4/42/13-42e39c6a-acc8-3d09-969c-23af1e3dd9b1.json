  "rdfs:comment": {
    "de": [
      "Nadège begrüßt Sie auf ihrem Bauernhof, der von ihren 110 Schafen und ihren Lämmern umgeben ist. Verarbeitung der Vliese aus der Zucht zu natürlicher Schurwolle, Tischdecken zum Polstern oder Filzen, Dochtwolle zum Stricken und Seifen aus gefilzter Wolle."
    ],
    "en": [
      "Nadege welcomes you in her farm surrunded by 110 sheep and their lambs. Transformation of the fleece in a new natural wool, upholstery filling or milling, knitting wool."
    ],
    "it": [
      "Nadège vi accoglie nella sua fattoria circondata dalle sue 110 pecore e dai loro agnelli. Trasforma i velli della fattoria in lana vergine naturale, in tovaglie da imbottire o infeltrire, in lana da stoppino per maglieria e in saponi di lana infeltrita."
    ],
    "fr": [
      "Nadège vous accueille sur sa ferme entourée de ses 110 brebis et de leurs agneaux. Transformation des toisons de l'élevage en laine vierge naturelle, nappe de rembourrage ou feutrage, laine mèche à tricoter et savons en laine feutrée."
    ],
    "es": [
      "Nadège le recibe en su granja rodeada de sus 110 ovejas y sus corderos. Transforma los vellones de la granja en lana virgen natural, manteles para rellenar o afieltrar, lana de mecha para tejer y jabones de lana afieltrada."
    ],
    "nl": [
      "Nadège heet u welkom op haar boerderij, omringd door haar 110 ooien en hun lammeren. Zij verwerkt de vachten van de boerderij tot natuurlijke scheerwol, tafelkleden om te vullen of te vervilten, lontwol om te breien en vervilte wolzepen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des Belines"
    ]
  },
