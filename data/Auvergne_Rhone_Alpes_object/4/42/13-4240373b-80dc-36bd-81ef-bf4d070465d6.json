  "rdfs:comment": {
    "de": [
      "Französische Skischule, die sich im Zentrum des Dorfes Praz de Lys befindet.\r\n\r\nDie Skilehrer der ESF bieten Ihnen Skikurse, Gruppen- und Privatkurse an."
    ],
    "en": [
      "French Ski School located in the center of the village of Praz de Lys.\r\n\r\nESF ski instructors offer group and private ski and snowboard lessons."
    ],
    "it": [
      "Scuola di sci francese situata nel centro del villaggio di Praz de Lys.\r\n\r\nI maestri di sci di ESF offrono lezioni di gruppo e private di sci e di altri sport correlati."
    ],
    "fr": [
      "Ecole du Ski Français située au centre du village du Praz de Lys.\r\n\r\nLes moniteurs de ski de L’ESF vous proposent des cours de ski, et autres glisses assimilées, collectifs et particuliers ."
    ],
    "nl": [
      "Franse skischool in het centrum van het dorp Praz de Lys.\r\n\r\nDe ESF-skileraren bieden ski- en snowboardlessen in groepsverband en privélessen."
    ],
    "es": [
      "Escuela de esquí francesa situada en el centro del pueblo de Praz de Lys.\r\n\r\nLos monitores de esquí del FSE ofrecen clases grupales y privadas de esquí y otros deportes relacionados."
    ]
  },
