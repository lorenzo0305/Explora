  "rdfs:comment": {
    "de": [
      "Das Kunstatelier Quésako ist ein künstlerisches Atelier rund um die Stein- und Farbkunst. Steinskulptur, Modellieren, Emaillieren auf Lava, Zeichnen...verschiedene kreative Techniken werden hier erkundet."
    ],
    "en": [
      "The Quésako art workshop focuses on the arts of stone and colour. Stone sculpture, modelling, enamelling on lava, drawing... various creative techniques are explored."
    ],
    "it": [
      "Il laboratorio artistico di Quésako si concentra sulle arti della pietra e del colore. Si esplorano la scultura della pietra, la modellazione, la smaltatura sulla lava, il disegno e varie tecniche creative."
    ],
    "fr": [
      "L’atelier d’art Quésako est un atelier artistique autour des arts de la pierre et de la couleur. Sculpture sur pierre, modelage, émaillage sur lave, dessin…différentes techniques créatives y sont explorées."
    ],
    "es": [
      "El taller de arte Quésako se centra en las artes de la piedra y el color. Se explora la talla en piedra, el modelado, el esmaltado sobre lava, el dibujo... diversas técnicas creativas."
    ],
    "nl": [
      "De kunstworkshop in Quésako richt zich op de kunst van steen en kleur. Steenhouwen, boetseren, emailleren op lava, tekenen en verschillende creatieve technieken worden verkend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier d'art QUESAKO"
    ]
  },
