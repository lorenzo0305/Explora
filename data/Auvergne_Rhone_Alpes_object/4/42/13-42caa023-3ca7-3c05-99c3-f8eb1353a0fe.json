  "rdfs:comment": {
    "de": [
      "Ich begleite Pferde mithilfe von Shiatsu und einem angepassten Unterricht, der auf Zuhören basiert. Einführungskurse in Pferdemassagen und Workshops zum Wohlbefinden von Pferden. Pension für die Rekonvaleszenz. Berufstätig seit 2004."
    ],
    "en": [
      "Human and animal accompaniment with the horse in a personal approach to well-being. Boarding, convalescence with the possibility of treatments (massage, shiatsu, magnetism). Lessons or travel to customer's home. Professional since 2006."
    ],
    "it": [
      "Lavoro con i cavalli utilizzando lo shiatsu e un insegnamento adattato basato sull'ascolto. Corsi di introduzione al massaggio equino e workshop sul benessere equino. Pensione per la convalescenza. Professionista dal 2004."
    ],
    "fr": [
      "J’accompagne les chevaux grâce au shiatsu et à un enseignement adapté basé sur l’écoute. Stages d’initiation aux massages équins et ateliers de bien être équin. Pension convalescence. Professionnelle depuis 2004."
    ],
    "es": [
      "Trabajo con caballos utilizando el shiatsu y la enseñanza adaptada basada en la escucha. Cursos de iniciación al masaje equino y talleres de bienestar equino. Alojamiento para convalecencia. Profesional desde 2004."
    ],
    "nl": [
      "Ik werk met paarden met behulp van shiatsu en aangepast onderwijs op basis van luisteren. Inleidende cursussen in paardenmassage en workshops in paardenwelzijn. Pension voor herstel. Professioneel sinds 2004."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Enseignement, soins énergétiques, pension bien-être « les Sapins »"
    ]
  },
