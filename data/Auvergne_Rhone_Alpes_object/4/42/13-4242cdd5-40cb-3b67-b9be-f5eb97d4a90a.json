  "rdfs:comment": {
    "de": [
      "La Turbulente ist ein Gemeinschaftsatelier, in dem 10 Unternehmerinnen des Kollektivs Wom'Bat, Handwerkerinnen und Künstlerinnen zusammenarbeiten und Ihnen ihre Kreationen anbieten."
    ],
    "en": [
      "La Turbulente is a shared workshop where 10 entrepreneurs from the Wom'Bat collective, craftswomen and artists, work together to bring you their creations."
    ],
    "it": [
      "La Turbulente è un laboratorio condiviso in cui 10 imprenditrici del collettivo Wom'Bat, artigiane e artiste, lavorano insieme per portare le loro creazioni."
    ],
    "fr": [
      "La Turbulente est un atelier partagé dans lequel 10 entrepreneuses du collectif Wom'Bat, artisanes et artistes travaillent ensemble et vous proposent leurs créations."
    ],
    "nl": [
      "La Turbulente is een gedeelde werkplaats waar 10 ondernemers van het Wom'Bat collectief, ambachtsvrouwen en kunstenaars, samenwerken om je hun creaties te laten zien."
    ],
    "es": [
      "La Turbulente es un taller compartido donde 10 emprendedoras del colectivo Wom'Bat, artesanas y artistas, trabajan juntas para ofrecerte sus creaciones."
    ]
