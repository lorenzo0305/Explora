  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/41496073-be6d-365a-9f5f-88d48f5da8e2",
      "dc:description": {
        "de": [
          "BLFR Transport ist ein Taxiunternehmen mit Sitz in Neufchâtel-Hardelot, das Privat- und Geschäftsreisende bedient.\nEs bietet zuverlässige, pünktliche und komfortable Fahrten, sowohl im Nah- als auch im Fernverkehr. Dabei legt es besonderen Wert auf die Qualität der Dienstleistung und die Zufriedenheit der Kunden."
        ],
        "en": [
          "BLFR Transport is a cab company based in Neufchâtel-Hardelot, serving private and business customers.\nIt provides reliable, punctual and comfortable journeys for both local and long-distance trips, with a particular focus on service quality and customer satisfaction."
        ],
        "it": [
          "BLFR Transport è un'azienda di taxi con sede a Neufchâtel-Hardelot, che serve clienti privati e commerciali.\nOffre corse affidabili, puntuali e confortevoli sia per viaggi locali che a lunga distanza, con particolare attenzione alla qualità del servizio e alla soddisfazione del cliente."
        ],
        "fr": [
          "BLFR Transport est une société de taxi basée à Neufchâtel-Hardelot, au service des particuliers et des professionnels. \nElle assure des trajets fiables, ponctuels et confortables, aussi bien pour les déplacements locaux que les longues distances, avec une attention particulière portée à la qualité de service et à la satisfaction des clients."
        ],
        "nl": [
          "BLFR Transport is een taxibedrijf gevestigd in Neufchâtel-Hardelot, dat particuliere en zakelijke klanten bedient.\nHet bedrijf biedt betrouwbare, punctuele en comfortabele ritten voor zowel lokale als langeafstandsritten, met een bijzondere focus op kwaliteit van de dienstverlening en klanttevredenheid."
        ],
        "es": [
          "BLFR Transport es una empresa de taxis con sede en Neufchâtel-Hardelot, al servicio de clientes particulares y empresas.\nOfrece viajes fiables, puntuales y cómodos tanto para trayectos locales como de larga distancia, prestando especial atención a la calidad del servicio y a la satisfacción del cliente."
        ]
      },
      "@type": [
        "Description"
      ],
