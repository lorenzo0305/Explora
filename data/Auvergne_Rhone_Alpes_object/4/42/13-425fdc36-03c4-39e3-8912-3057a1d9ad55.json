  "rdfs:comment": {
    "de": [
      "Hotel auf einem klassifizierten 18-Loch-Golfplatz (Top 20 der französischen Golfplätze) im Isère-Tal, der von den majestätischen Gipfeln des Vercors und der Chartreuse gesäumt wird. Spezialist für Golfaufenthalte und die Organisation von Seminaren vor Ort."
    ],
    "en": [
      "3 star hotel close with an exceptional surrounding, package for golf break with 6 golf courses.\r\nGreen with spectacular views down the Isere Valley to the Mountains beyond, Golf Hotel Charmeil is waiting to welcome you. \r\nPerfect for your golfing holiday"
    ],
    "it": [
      "Hotel situato su un campo da golf a 18 buche classificato tra i primi 20 campi francesi, nella valle dell'Isère, delimitata dalle maestose cime del Vercors e della Chartreuse. Specializzato in soggiorni golfistici e seminari in loco."
    ],
    "fr": [
      "Hôtel situé sur un parcours de golf 18 trous classé (top 20 des parcours français), dans la vallée de l'Isère, bordé par les majestueux sommets du Vercors et de la Chartreuse. Spécialiste des séjours golfiques et  l'organisation de séminaires sur place."
    ],
    "es": [
      "Hotel situado en un campo de golf de 18 hoyos clasificado entre los 20 mejores campos franceses, en el valle del Isère, bordeado por las majestuosas cumbres del Vercors y la Chartreuse. Especializado en estancias de golf y seminarios in situ."
    ],
    "nl": [
      "Hotel gelegen aan een 18-holes golfbaan in de top 20 van Franse golfbanen, in de Isère-vallei, omringd door de majestueuze toppen van de Vercors en de Chartreuse. Gespecialiseerd in golfverblijven en seminars op locatie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Domaine de Charmeil - Golf Hôtel Grenoble"
    ],
