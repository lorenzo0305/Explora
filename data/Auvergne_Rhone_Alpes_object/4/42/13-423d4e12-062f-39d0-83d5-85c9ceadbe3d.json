  "rdfs:comment": {
    "de": [
      "Anlässlich der Europäischen Tage des Kulturerbes bietet die Festung Polignac ein spezielles Veranstaltungsprogramm mit zahlreichen Workshops an. Führungen am Samstag und Sonntag um 15:00 Uhr und ermäßigter Eintritt (3?)."
    ],
    "en": [
      "For the European Heritage Days, the Forteresse de Polignac is offering a special program of activities and workshops. Guided tours at 3:00 pm on Saturday and Sunday, with reduced admission (3?)."
    ],
    "it": [
      "In occasione delle Giornate Europee del Patrimonio, la Fortezza di Polignac propone un programma speciale di attività e laboratori. Visite guidate alle 15.00 di sabato e domenica, con ingresso ridotto (3?)."
    ],
    "fr": [
      "A l'occasion des Journées Européennes du Patrimoine, la Forteresse de Polignac propose un programme d'animations spécifique avec de nombreux ateliers. Visites guidées à 15h00 samedi et dimanche et entrée à tarif réduit (3€)."
    ],
    "nl": [
      "Ter gelegenheid van de Europese Erfgoeddagen biedt het fort van Polignac een speciaal programma met activiteiten en workshops. Rondleidingen om 15.00 uur op zaterdag en zondag, met gereduceerde toegangsprijs (3?)."
    ],
    "es": [
      "Con motivo de las Jornadas Europeas del Patrimonio, la Fortaleza de Polignac ofrece un programa especial de actividades y talleres. Visitas guiadas a las 15:00 h el sábado y el domingo, con entrada reducida (3?)."
    ]
  },
  "rdfs:label": {
