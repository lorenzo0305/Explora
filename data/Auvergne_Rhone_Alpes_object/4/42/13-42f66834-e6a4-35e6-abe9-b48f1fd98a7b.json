  "rdfs:comment": {
    "de": [
      "Seit März 2022 hat Biosphere die Wahl getroffen, sich der Genossenschaft Biocoop anzuschließen. Unser 345m² großes Geschäft bietet Ihnen eine große Auswahl an Bio- und Ökoprodukten mit über 5000 Artikeln, davon 200 lose Ware."
    ],
    "en": [
      "We offer a large variety of organic and ecological products with more than 5000 brands. A wide choice of organic products and ecoproducts with more than 5000 references available in our store of 345m²."
    ],
    "it": [
      "Fondata nel 2011, Biosphere si unirà alla cooperativa Biocoop nel 2022. Con 65 produttori locali, il nostro negozio di 345 m² offre un'ampia scelta di prodotti biologici ed ecoprodotti, con oltre 5.000 articoli, di cui 200 sfusi."
    ],
    "fr": [
      "Créé en 2011, Biosphere a fait le choix de rejoindre en 2022 la coopérative Biocoop. Fort de ses 65 producteurs locaux ,notre magasin de 345m² vous propose un large choix de produits bio et écoproduits avec plus de 5000 références dont 200 en vrac."
    ],
    "nl": [
      "Wij bieden u een grote keus aan biologische en ecologische producten met meer dan 5000 beschikbare referenties in onze winkel van 345m²."
    ],
    "es": [
      "Fundada en 2011, Biosphere se unirá a la cooperativa Biocoop en 2022. Con 65 productores locales, nuestra tienda de 345 m² ofrece una amplia selección de productos orgánicos y ecoproductos, con más de 5.000 artículos, incluidos 200 a granel."
    ]
  },
