  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Plateau de l'Arbaron und das P'tit Plateau auf der schwarzen Nordic-Ski-Piste \"Le Plateau\". Bewegen Sie sich auf einer präparierten Piste mit einem deutlichen Höhenunterschied, zwischen Tannen und Panoramablick."
    ],
    "en": [
      "Discover the Arbaron Plateau and the P’tit Plateau via the black Nordic skiing trail 'Le Plateau.' Enjoy a groomed trail with a significant elevation change, surrounded by fir trees and offering panoramic views."
    ],
    "it": [
      "Scoprite il Plateau de l'Arbaron e il Plateau P'tit sulla pista nera di sci nordico \"Le Plateau\". Scendete in pista su una pista preparata con una forte pendenza, circondata da abeti e viste panoramiche."
    ],
    "fr": [
      "Découvrez le plateau de l'Arbaron et le P'tit Plateau grâce à la piste noire de ski nordique \"Le Plateau\". Évoluez sur une piste damée au dénivelé marqué, entre sapins et vue panoramique."
    ],
    "nl": [
      "Ontdek het Arbaron-plateau en het P’tit Plateau via de zwarte nordic ski-route 'Le Plateau.' Geniet van een geprepareerd parcours met een aanzienlijke hoogteverschil, omgeven door sparren en met een panoramisch uitzicht."
    ],
    "es": [
      "Descubra el Plateau de l'Arbaron y el Plateau de P'tit en la pista negra de esquí nórdico \"Le Plateau\". Recorra una pista preparada con una pendiente pronunciada, rodeada de abetos y vistas panorámicas."
    ]
  },
  "rdfs:label": {
    "en": [
      "‘Le Plateau’ Black Cross-Country Ski Trail"
    ],
    "fr": [
      "Piste noire de ski nordique \"Le Plateau\""
    ],
    "nl": [
      "Zwarte langlaufpiste ‘Le Plateau’"
    ]
  },
