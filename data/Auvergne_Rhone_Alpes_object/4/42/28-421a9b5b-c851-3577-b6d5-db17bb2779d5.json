  "rdfs:comment": {
    "de": [
      "Die Familie Tenart empfängt Sie auf ihrem Bauernhof zum Verkauf ihrer Produkte aus dem Gemüseanbau.\nGemüse und Obst der Saison, kaltgepresstes Rapsöl, durchdachte und natürliche Anbaumethoden. Verkauf in kurzen Kreisläufen."
    ],
    "en": [
      "The Tenart family welcomes you to their farm to sell products from their market garden.\nSeasonal vegetables and fruit, cold-pressed rapeseed oil, natural and sustainable farming. Short-distance sales."
    ],
    "it": [
      "La famiglia Tenart vi accoglie nella sua azienda agricola per vendere i prodotti del suo orto.\nOrtaggi e frutta di stagione, olio di colza estratto a freddo, agricoltura naturale e sostenibile. Vendita a breve distanza."
    ],
    "fr": [
      "La famille Tenart vous accueille sur leur ferme pour une vente de leur produits issus de leurs cultures maraîchères .\nLégumes et Fruits de saison, Huile de colza extraite à froid, En culture raisonnée et naturelle. Vente en circuits courts."
    ],
    "es": [
      "La familia Tenart le da la bienvenida a su granja para vender los productos de su huerta.\nVerduras y frutas de temporada, aceite de colza extraído en frío, agricultura natural y sostenible. Venta a corta distancia."
    ],
    "nl": [
      "De familie Tenart heet je welkom op hun boerderij om producten uit hun moestuin te verkopen.\nSeizoensgroenten en -fruit, koolzaadolie van koude extractie, natuurlijke en duurzame landbouw. Verkoop op korte afstand."
    ]
  },
