  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Taverne Garden, den Ort für all Ihre Aperitifs und Afterworks! Diese stimmungsvolle Bar bietet Ihnen 14 verschiedene Biere vom Fass, Weine und Cocktails*, aber auch Käse- und Wurstbretter zum Teilen oder handgemachtes Eis."
    ],
    "en": [
      "Discover la Taverne Garden, the place to be for your pre-dinner drinks and afterwork parties! This bar offers 14 different types of draught beer, but also wine and cocktails*, but also cheese and cured meat trays to share or even artisanal ice cream."
    ],
    "it": [
      "Scoprite Taverne Garden, il luogo ideale per tutti gli aperitivi e gli afterwork! Questo suggestivo bar offre 14 diverse birre alla spina, vini e cocktail*, oltre a taglieri di formaggi e salumi da condividere e gelati artigianali."
    ],
    "fr": [
      "Découvrez la Taverne Garden, le lieu de tous vos apéros et afterworks ! Ce bar à ambiance vous propose 14 bières pression différentes, des vins et cocktails*, mais aussi des planches de fromage et charcuterie à partager ou encore des glaces artisanales."
    ],
    "nl": [
      "Ontdek Taverne Garden, the place to be voor al je aperitieven en afterworks! Deze sfeervolle bar biedt 14 verschillende bieren van het vat, wijnen en cocktails*, maar ook kaas- en vleeswarenplanken om te delen en huisgemaakt ijs."
    ],
    "es": [
      "Descubra Taverne Garden, el lugar ideal para sus aperitivos y afterworks Este atmosférico bar ofrece 14 tipos de cervezas de barril, vinos y cócteles*, así como tablas de quesos y embutidos para compartir y helados caseros."
    ]
  },
