  "rdfs:comment": {
    "de": [
      "Dieses Treffen bietet spielerische und gesellige Momente, die Sie mit der Familie, mit Freunden oder allein rund um Brettspiele erleben können.\r\nAb 4 Jahren, Anmeldung erforderlich."
    ],
    "en": [
      "This event offers fun and convivial board games for families, friends and solo players.\r\nAges 4 and up, registration required."
    ],
    "it": [
      "Un modo divertente e amichevole per famiglie, amici e singoli di giocare a giochi da tavolo.\r\nPer i bambini dai 4 anni in su, è richiesta l'iscrizione."
    ],
    "fr": [
      "Ce rendez-vous propose des moments ludiques et conviviaux à vivre en famille, entre amis ou en solo autour de jeux de plateau.\r\nÀ partir de 4 ans, sur inscription."
    ],
    "es": [
      "Se trata de una forma divertida y amistosa de jugar a juegos de mesa para familias, amigos y particulares.\r\nPara niños a partir de 4 años, inscripción obligatoria."
    ],
    "nl": [
      "Dit is een leuke en gezellige manier voor gezinnen, vrienden en individuen om bordspellen te spelen.\r\nVoor kinderen vanaf 4 jaar, inschrijven verplicht."
    ]
  },
