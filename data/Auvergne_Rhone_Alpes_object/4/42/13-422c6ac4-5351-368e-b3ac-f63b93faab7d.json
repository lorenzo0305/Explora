  "rdfs:comment": {
    "de": [
      "Das Relais de l'Aiguille, das höchstgelegene Bergrestaurant von La Clusaz, befindet sich auf dem Crêt du Loup in 1850 m Höhe und empfängt Sie seit 1957 während der gesamten Wintersaison."
    ],
    "en": [
      "Le Relais de l’Aiguille, the highest mountain restaurant in La Clusaz, is located on Crêt du Loup at 1,850 metres and has been welcoming guests throughout the winter season since 1957."
    ],
    "it": [
      "Il Relais de l'Aiguille, il ristorante più alto di La Clusaz, si trova sul Crêt du Loup a 1850 metri e vi accoglie dal 1957 per tutta la stagione invernale."
    ],
    "fr": [
      "Le Relais de l’Aiguille, restaurant d’altitude le plus élevé de la Clusaz, se situe sur le Crêt du Loup à 1850 mètres, et vous accueille pour toute la saison d’hiver depuis 1957."
    ],
    "nl": [
      "Le Relais de l'Aiguille, het hoogstgelegen restaurant van La Clusaz, ligt op de Crêt du Loup op 1850 meter hoogte en verwelkomt u sinds 1957 gedurende het hele winterseizoen."
    ],
    "es": [
      "El Relais de l'Aiguille, el restaurante de mayor altitud de La Clusaz, está situado en el Crêt du Loup, a 1850 metros, y le da la bienvenida durante toda la temporada de invierno desde 1957."
    ]
  },
