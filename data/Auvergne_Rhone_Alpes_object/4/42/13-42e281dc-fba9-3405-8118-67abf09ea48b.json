  "rdfs:comment": {
    "de": [
      "Auf einer sonnigen Terrasse des alten Rathausplatzes im Herzen der Altstadt genießen Sie Sophies süße und herzhafte Crêpes. Herzlicher und familiärer \r\nEmpfang, italienisches Eis, kalte Getränke, gemischte Platten und Ravioligratins."
    ],
    "en": [
      "In the heart of the old town, in the old Town Hall square, on a sundrenched terrace, discover Sophie’s crêpes and buckwheat pancakes. A warm family welcome, Italian ices, cold drinks, choice of aperitifs ... gratin de ravioles."
    ],
    "it": [
      "Situato nell'antica piazza del paese, questo affascinante ristorante gode di un ambiente tranquillo, con una terrazza soleggiata e ombreggiata perfetta per un momento di relax."
    ],
    "fr": [
      "Installé sur l’ancienne place du village, ce charmant restaurant profite d’un cadre paisible, avec une terrasse ensoleillée et ombragée, parfaite pour savourer un moment de détente."
    ],
    "es": [
      "Situado en la antigua plaza del pueblo, este encantador restaurante goza de un entorno tranquilo, con una terraza soleada y sombreada perfecta para un momento de relajación."
    ],
    "nl": [
      "In het hart van de oude stad, op het oude stadhuisplein, op een zonnig terras, ontdekt u de “crêpes” (flenjes) en “galettes” (boekweitpannenkoeken) van Sophie. Een warm familiaal ontvangst, Italiaans ijs, koude dranken, peritiefbord... ravioli gratin."
    ]
  },
