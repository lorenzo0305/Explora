  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt auf den Höhen von Valence und bietet Ihnen einen gepflegten Service und Gerichte aus rohen, saisonalen und hochwertigen Produkten."
    ],
    "en": [
      "Located on the heights of Valence, offering attentive service and dishes made from raw, seasonal, quality produce."
    ],
    "it": [
      "Situato sulle alture di Valencia, offre un servizio accurato e piatti a base di prodotti crudi, stagionali e di qualità."
    ],
    "fr": [
      "Situé sur les hauteurs de Valence, qui vous propose un service soigné et des mets à partir de produits bruts, de saison et de qualité."
    ],
    "es": [
      "Situado en las alturas de Valencia, que ofrece un servicio esmerado y platos a partir de productos crudos, de temporada y de calidad."
    ],
    "nl": [
      "Dit restaurant ligt op de hoogten van Valence en biedt attente service en gerechten gemaakt van seizoensgebonden kwaliteitsproducten."
    ]
  },
