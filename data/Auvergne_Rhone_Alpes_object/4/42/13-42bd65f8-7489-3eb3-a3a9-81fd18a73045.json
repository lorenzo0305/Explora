  "rdfs:comment": {
    "de": [
      "Ein einzigartiger Rahmen, offene Küche, Olivenbäume, große Holztische, Chesterfield, kleine, intime Räume, Schiefertafeln mit Vorschlägen, Kinderbereich..... Alles ist darauf ausgerichtet, dass Sie sich wohlfühlen.\r\nBurger, Salate, Grill."
    ],
    "en": [
      "Unique environment, open kitchen, olive trees, large wooden tables, Chesterfield, small intimate spaces, suggestion board, children's area…Everything is done to make you feel at home."
    ],
    "it": [
      "Un ambiente unico, cucina a vista, ulivi, grandi tavoli in legno, Chesterfield, piccoli spazi intimi, suggestione delle ardesie, area bambini? Tutto è fatto per farvi sentire bene.\r\nHamburger, insalate, grigliate."
    ],
    "fr": [
      "Un cadre unique, cuisine ouverte, oliviers, grandes tables en bois, Chesterfield, petits espaces intimes, ardoises de suggestions, espace enfants…. Tout est fait pour que vous vous sentiez bien.\r\nBurgers, salades, grill."
    ],
    "es": [
      "Un entorno único, cocina abierta, olivos, grandes mesas de madera, Chesterfield, pequeños espacios íntimos, pizarras de sugerencia, zona infantil... Todo se hace para que te sientas bien.\r\nHamburguesas, ensaladas, parrilla."
    ],
    "nl": [
      "Een unieke omgeving, open keuken, olijfbomen, grote houten tafels, Chesterfield, kleine intieme ruimtes, krijtborden met suggesties, kinderruimte, etc. Een sfeer waarin u zich snel thuis zult voelen."
    ]
  },
