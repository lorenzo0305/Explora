  "rdfs:comment": {
    "de": [
      "Bei Fabwé bedeutet Innovation in der Tradition, in die Vergangenheit zu reisen, um eine überzeugende Zukunft zu versprechen. Finden Sie einzigartige Geschenke, ob für drinnen oder draußen. Hier finden Groß und Klein etwas, das ihnen gefällt."
    ],
    "en": [
      "At Fabwé, innovation in tradition means going back in time to promise a convincing future. Find unique gifts for both indoors and outdoors. There's something for everyone."
    ],
    "it": [
      "Da Fabwé, innovare nella tradizione significa tornare indietro nel tempo per promettere un futuro convincente. Trovate regali unici per l'interno e l'esterno. Ce n'è per tutti i gusti."
    ],
    "fr": [
      "Chez Fabwé, Innover dans la tradition, c'est remonter dans le temps pour promettre un futur convaincant. Retrouvez des cadeaux uniques, que ce soit pour l'intérieur comme pour l'extérieur. Petits et grands trouveront leur bonheur."
    ],
    "es": [
      "En Fabwé, innovar en la tradición significa retroceder en el tiempo para prometer un futuro convincente. Encuentre regalos únicos para interior y exterior. Hay para todos los gustos."
    ],
    "nl": [
      "Bij Fabwé betekent innovatie in traditie teruggaan in de tijd om een overtuigende toekomst te beloven. Vind unieke cadeaus voor zowel binnen als buiten. Er is voor ieder wat wils."
    ]
  },
