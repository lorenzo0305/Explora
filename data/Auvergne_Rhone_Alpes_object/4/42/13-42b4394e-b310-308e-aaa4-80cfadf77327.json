  "rdfs:comment": {
    "de": [
      "Auf 2100 m Höhe können Skifahrer und Fußgänger auf der herrlichen Terrasse mit ihrem außergewöhnlichen Panorama und den schönen Räumen eines authentischen Chalets eine regionale Küche mit frischen Produkten, Schmorgerichten, Fleisch, Burgern, Pizzas und Gebäck genießen."
    ],
    "en": [
      "At 2100m, a magnificent terrace and its exceptional panorama combined with the spaciousness of an authentic chalet allow skiers and pedestrians to savor regional cuisine with fresh products, stews, meats, burgers, pizzas and pastries."
    ],
    "it": [
      "A 2100 m, la magnifica terrazza e il suo eccezionale panorama, uniti ai bei volumi di un autentico chalet, permettono a sciatori e pedoni di gustare una cucina locale con prodotti freschi, piatti cotti a fuoco lento, carni, hamburger, pizze e dolci."
    ],
    "fr": [
      "A 2100m, magnifique terrasse et son panorama exceptionnel alliés aux beaux volumes d’un chalet authentique permettent aux skieurs et piétons de savourer une cuisine terroir avec des produits frais, plats mijotés, viandes, burgers, pizzas et pâtisseries."
    ],
    "nl": [
      "Op 2100 meter hoogte, een prachtig terras en zijn uitzonderlijke panorama gecombineerd met de ruimtelijkheid van een authentiek chalet laten skiërs en voetgangers genieten van regionale gerechten met verse producten, stoofschotels, vleeswaren, hamburgers, pizza's en gebak."
    ],
    "es": [
      "A 2100 m, la magnífica terraza y su excepcional panorama, combinados con los bellos volúmenes de un auténtico chalet, permiten a esquiadores y peatones disfrutar de una cocina local con productos frescos, platos cocinados a fuego lento, carnes, hamburguesas, pizzas y pasteles."
    ]
  },
