  "rdfs:comment": {
    "de": [
      "Ein netter Foodtruck, ein herzlicher Empfang und Qualitätsprodukte: Das ist das Rezept für einen geselligen Moment!  Alice und David stehen für alle Veranstaltungen und Privatisierungen zur Verfügung. Willkommen bei Snackinblack!"
    ],
    "en": [
      "A friendly foodtruck, a warm welcome and quality products: that's the recipe for a convivial moment!  Alice and David are available for all events and privatizations. Welcome to Snackinblack!"
    ],
    "it": [
      "Un foodtruck divertente, un'accoglienza calorosa e prodotti di qualità: proprio quello che ci vuole per un momento di convivialità!  Alice e David sono disponibili per tutti gli eventi e le funzioni private. Benvenuti a Snackinblack!"
    ],
    "fr": [
      "Un foodtruck sympa, un accueil chaleureux et des produits de qualité : voilà la recette pour un moment convivial !  Alice et David sont disponibles pour tout événement et privatisation. Bienvenue chez Snackinblack !"
    ],
    "es": [
      "Un foodtruck divertido, una cálida acogida y productos de calidad: ¡lo justo para un momento de convivencia!  Alice y David están disponibles para todo tipo de eventos y funciones privadas. ¡Bienvenido a Snackinblack!"
    ],
    "nl": [
      "Een leuke foodtruck, een warm welkom en kwaliteitsproducten: precies wat je nodig hebt voor een gezellig moment!  Alice en David zijn beschikbaar voor alle evenementen en privéfeesten. Welkom bij Snackinblack!"
    ]
  },
  "rdfs:label": {
