  "rdfs:comment": {
    "de": [
      "Freie Besichtigung. Dieses stark umgebaute Gebäude weist Elemente aus dem 11. Jahrhundert auf. Der quadratische Glockenturm (MH - 12. Jh.) ist massiv und weist Mitra-Arkaden auf."
    ],
    "en": [
      "Open house. This very modified building presents elements of the 11th century. The square bell tower (MH - 12th century) is massive and has mitre arches."
    ],
    "it": [
      "Visita gratuita. Questo edificio, molto rinnovato, presenta elementi risalenti all'XI secolo. Il campanile quadrato (MH - XII secolo) è massiccio e presenta archi a sesto acuto."
    ],
    "fr": [
      "Visite libre. Cet édifice très remanié présente des éléments du XIe siècle. Le clocher carré (MH - XIIe) est massif et présente des arcades en mitre."
    ],
    "es": [
      "Visita gratuita. Este edificio, muy reformado, tiene elementos del siglo XI. El campanario cuadrado (MH - siglo XII) es macizo y tiene arcos de mitra."
    ],
    "nl": [
      "Gratis bezoek. Dit sterk gerenoveerde gebouw heeft elementen uit de 11e eeuw. De vierkante klokkentoren (MH - 12e eeuw) is massief en heeft mijterbogen."
    ]
  },
  "rdfs:label": {
