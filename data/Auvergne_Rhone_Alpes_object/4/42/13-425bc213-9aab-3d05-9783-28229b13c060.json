  "rdfs:comment": {
    "de": [
      "Regionale Küche. Spezialität: Kalbsbries mit Morcheln, flambiert mit Cognac\r\nEmpfang von Einzelpersonen und Gruppen.Auf GR400 gelegen\r\nTäglich von 7.30 bis 23 Uhr geöffnet. Motorradfahrer-Relais."
    ],
    "en": [
      "Regional cooking served in a dining room boasting a panoramic view of the Puy Mary.\r\nRecommended by the “Michelin guide” and the “guide du Routard”. Biker-hotel.\r\nGroups welcome."
    ],
    "it": [
      "Cucina regionale. Specialità: animelle di vitello con spugnole flambate nel cognac\r\nAccoglienza individuale e di gruppo. Situato sul GR400\r\nAperto dalle 7.30 alle 23.00, tutti i giorni. Relais Motard."
    ],
    "fr": [
      "Cuisine régionale. Spécialité les Ris de veau aux morilles flambés au cognac\r\nAccueil particuliers et groupes.Situé sur GR400\r\nOuvert de 7h30 à 23h, tous les jours. Relais Motard."
    ],
    "nl": [
      "Regionale keuken. Specialiteit: Kalfszwezerik met morilles geflambeerd in cognac\r\nIndividueel en groepen zijn welkom. Gelegen aan de GR400\r\nDagelijks geopend van 7.30 tot 23.00 uur. Relais Motard."
    ],
    "es": [
      "Cocina regional. Especialidad: mollejas de ternera con colmenillas flambeadas al coñac\r\nSe aceptan individuales y grupos. Situado en el GR400\r\nAbierto de 7h30 a 23h00, todos los días. Relais Motard."
    ]
  },
