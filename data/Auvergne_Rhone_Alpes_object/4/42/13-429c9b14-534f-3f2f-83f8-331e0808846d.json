  "rdfs:comment": {
    "de": [
      "Das Restaurant \"la traverse\" liegt im Zentrum des Dorfes und empfängt Sie das ganze Jahr über in einer gemütlichen Bergumgebung. Hier können Sie eine lokale, traditionelle und abwechslungsreiche Küche genießen."
    ],
    "en": [
      "Located in the center of the village, the restaurant \"la traverse\" welcomes you all year round in a warm mountain setting. Here you can enjoy a variety of traditional local cuisine."
    ],
    "it": [
      "Situato nel centro del villaggio, il ristorante \"la traverse\" vi accoglie tutto l'anno in un caldo ambiente di montagna. Qui potrete gustare un'ampia varietà di piatti della cucina tradizionale locale."
    ],
    "fr": [
      "Situé au centre du village, le restaurant \"la traverse\" vous accueille toute l'année dans un cadre chaleureux de montagne. Vous pourrez y apprécier une cuisine locale, traditionnelle et variée."
    ],
    "es": [
      "Situado en el centro del pueblo, el restaurante \"la traverse\" le da la bienvenida todo el año en un cálido ambiente de montaña. Aquí podrá degustar una amplia variedad de platos tradicionales de la cocina local."
    ],
    "nl": [
      "Het restaurant \"la traverse\" ligt in het centrum van het dorp en verwelkomt je het hele jaar door in een warme bergomgeving. Hier kun je genieten van een grote verscheidenheid aan traditionele lokale gerechten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Traverse"
    ]
  },
