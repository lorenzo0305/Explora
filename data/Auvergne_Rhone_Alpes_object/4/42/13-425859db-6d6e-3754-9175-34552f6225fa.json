  "rdfs:comment": {
    "de": [
      "Der in der Altstadt Vieux-Lyon gelegene Bouchon \"Les Lyonnais\" nimmt Sie mit auf eine Entdeckungsreise in die Welt des Kabaretts mit Künstlern des Kleinkunsttheaters."
    ],
    "en": [
      "Located in Old Lyon, the bouchon Les Lyonnais takes you to the world of cabaret show with live theater artists."
    ],
    "it": [
      "Localizzato nella Vecchio-Lione, il bouchon Les Lyonnais vi portano scoprire il mondo dello spettacolo di cabaret con gli artisti di caffè-teatro."
    ],
    "fr": [
      "Situé dans le Vieux-Lyon, le bouchon Les Lyonnais vous emmène découvrir le monde du spectacle de cabaret avec des artistes de café-théâtre."
    ],
    "es": [
      "El bouchon Les Lyonnais, situado en Vieux-Lyon, invita a descubrir el mundo del cabaret con artistas de café-teatro."
    ],
    "nl": [
      "De bouchon Les Lyonnais, gelegen in het Vieux-Lyon, neemt u mee om de wereld van de cabaretvoorstellingen met café-theaterartiesten te ontdekken."
    ]
