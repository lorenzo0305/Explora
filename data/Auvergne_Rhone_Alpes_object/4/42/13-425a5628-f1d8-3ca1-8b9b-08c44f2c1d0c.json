  "rdfs:comment": {
    "de": [
      "Entdecken Sie den neuen Raum, der Ihnen für Ihre beruflichen Aktivitäten zur Verfügung steht: den Coworking Space! 55 m² geteilte Büroräume, im Openspace oder in geschlossenen Räumen? Auch Besprechungsräume sind verfügbar!"
    ],
    "en": [
      "Discover the new space available for your professional activities: the coworking space! 55 m² of shared office space, openspace or closed room? Meeting rooms also available!"
    ],
    "it": [
      "Scoprite il nuovo spazio disponibile per le vostre attività professionali: lo spazio di coworking! 55 m² di uffici condivisi, a pianta aperta o in una stanza chiusa? Sono disponibili anche sale riunioni!"
    ],
    "fr": [
      "Découvrez le nouvel espace à disposition pour vos activités professionnelles : l'espace coworking ! 55 m² de bureaux partagés, en openspace ou pièce fermée… Salles de réunion disponibles également !"
    ],
    "nl": [
      "Ontdek de nieuwe ruimte voor uw professionele activiteiten: de coworking space! 55 m² gedeelde kantoorruimte, open of gesloten? Er zijn ook vergaderruimtes beschikbaar!"
    ],
    "es": [
      "Descubra el nuevo espacio disponible para sus actividades profesionales: ¡el espacio de coworking! 55 m² de espacio de oficinas compartidas, ya sean diáfanas o cerradas.. ¡Salas de reuniones también disponibles!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace coworking Tiers-Lieu Vita’Mine"
    ]
  },
