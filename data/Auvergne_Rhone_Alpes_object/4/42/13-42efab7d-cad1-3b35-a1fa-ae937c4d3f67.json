  "rdfs:comment": {
    "de": [
      "Der Jardin Sévigné wurde anlässlich des 300. Todestages der Marquise de Sévigné angelegt. Dieses grüne Minilabyrinth greift den Namen \"SEVIGNE\" in lateinischer Kalligraphie auf."
    ],
    "en": [
      "The Jardin Sévigné was created to mark the tercentenary of the death of the Marquise de Sévigné. This mini labyrinth of greenery takes the name \"SEVIGNE\" in Latin calligraphy."
    ],
    "it": [
      "Il Jardin Sévigné è stato creato in occasione del terzo centenario della morte della marchesa di Sévigné. Questo mini labirinto di verde prende il nome di \"SEVIGNE\" in calligrafia latina."
    ],
    "fr": [
      "Le Jardin Sévigné a été créé à l'occasion du tricentenaire de la mort de la Marquise de Sévigné. Ce mini labyrinthe de verdure reprend le nom de \"SEVIGNE\" en calligraphie latine."
    ],
    "es": [
      "El Jardín Sévigné se creó con motivo del tricentenario de la muerte de la marquesa de Sévigné. Este minilaberinto de vegetación lleva el nombre de \"SEVIGNE\" en caligrafía latina."
    ],
    "nl": [
      "De Jardin Sévigné werd aangelegd ter ere van de honderdste sterfdag van markiezin de Sévigné. Dit minidoolhof van groen draagt de naam \"SEVIGNE\" in Latijnse kalligrafie."
    ]
  },
  "rdfs:label": {
