  "rdfs:comment": {
    "de": [
      "Im Herzen des Skigebiets ist Chacha der festliche und gemütliche Treffpunkt am Pistenende."
    ],
    "en": [
      "Right in the heart of the resort, Chacha is the meeting place for outings to the slopes, festive and warm."
    ],
    "it": [
      "Proprio nel cuore della stazione, Chacha è il punto d'incontro per le gite sulle piste, festose e calorose."
    ],
    "fr": [
      "En plein coeur de la station, Chacha est le rendez-vous des sorties de pistes festif et chaleureux."
    ],
    "nl": [
      "Midden in het resort is Chacha een warme en feestelijke ontmoetingsplaats voor mensen die van de piste komen."
    ],
    "es": [
      "En pleno corazón de la estación, Chacha es un lugar de encuentro cálido y festivo para los que acaban de salir de las pistas."
    ]
  },
