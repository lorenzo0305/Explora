  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/babd1334-84a7-3fa7-98ab-740949161f18",
      "dc:description": {
        "de": [
          "Ausübung aller Arten des Teichangelns (Forelle, Karpfen, Karpfenfische, Weißfische). Ruhiger und angenehmer Ort, der den natürlichen Raum aufwertet.\nPrivatisierung der Teiche möglich"
        ],
        "en": [
          "All types of pond fishing (trout, carp, predators, whites) Quiet, pleasant setting that enhances the natural environment.\nPonds can be privatized"
        ],
        "it": [
          "Tutti i tipi di pesca in laghetto (trote, carpe, predatori, bianconi). Un luogo tranquillo e piacevole che valorizza l'ambiente naturale.\nStagni disponibili per uso privato"
        ],
        "fr": [
          "Pratique de toute pêche en étangs ( Truite, Carpe, Carnassiers, Blancs) Endroit calme et agréable qui valorise l'espace naturel. \nPrivatisation des étangs possible"
        ],
        "es": [
          "Todo tipo de pesca en estanques (trucha, carpa, depredadores, blancos). Un lugar tranquilo y agradable que realza el entorno natural.\nEstanques disponibles para uso privado"
        ],
        "nl": [
          "Alle soorten vijvervissen (forel, karper, roofvis, wijtingen). Een rustige, aangename plek die de natuurlijke omgeving versterkt.\nVijvers beschikbaar voor privégebruik"
        ]
      },
      "@type": [
        "Description"
