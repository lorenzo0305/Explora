  "rdfs:comment": {
    "de": [
      "Le Tour de Pizz ist eine Pizzeria zum Mitnehmen mit zwei 24-Stunden-Automaten, einem in St. Eloy und einem in Pionsat, sowie einem Food Truck, der wöchentlich seine Runden dreht."
    ],
    "en": [
      "Le Tour de Pizz is a takeaway pizzeria, and also two 24-hour vending machines, one in St Eloy and one in Pionsat, as well as a food truck that makes weekly rounds."
    ],
    "it": [
      "Le Tour de Pizz è una pizzeria da asporto a Saint Eloy les Mines, oltre a tre distributori automatici aperti 24 ore su 24, uno a St Eloy, Saint-Pardoux e Pionsat, e a un camion che fa il giro settimanale."
    ],
    "fr": [
      "Le Tour de Pizz, est une pizzeria \"pizza à emporter\" située à Saint Eloy les mines, mais aussi trois distributeurs 24h/24, un à St Eloy, à Saint-Pardoux et un à Pionsat, ainsi qu'un camion qui propose des tournées hebdomadaires."
    ],
    "nl": [
      "Le Tour de Pizz is een afhaalpizzeria, evenals twee automaten die 24 uur per dag geopend zijn, een in St Eloy en een in Pionsat, en een vrachtwagen die wekelijks rondrijdt."
    ],
    "es": [
      "Le Tour de Pizz es una pizzería para llevar en Saint Eloy les Mines, así como tres máquinas expendedoras 24 horas, una en St Eloy, otra en Saint-Pardoux y otra en Pionsat, y un camión que hace rondas semanales."
    ]
  },
