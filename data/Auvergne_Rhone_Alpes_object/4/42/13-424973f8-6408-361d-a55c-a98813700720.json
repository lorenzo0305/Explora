  "rdfs:comment": {
    "de": [
      "Im Herzen der Monts du Lyonnais, auf 800 m Höhe, weiden unsere Alpen-Gämsziegen zu jeder Jahreszeit und auf dem Hof befindet sich eine Käseverarbeitungswerkstatt."
    ],
    "en": [
      "In the heart of the Monts du Lyonnais, at an altitude of 800m, our Alpine chamois goats graze all year round, with a cheese-processing workshop on the farm."
    ],
    "it": [
      "Nel cuore dei Monts du Lyonnais, a 800 metri di altitudine, le nostre capre camosciate alpine pascolano tutto l'anno, con un laboratorio di lavorazione del formaggio in azienda."
    ],
    "fr": [
      "C'est au cœur des Monts du Lyonnais, à 800m d'altitude que pâturent nos chèvres alpines chamoisées en toute saison, avec un atelier de transformation fromagère sur la ferme."
    ],
    "nl": [
      "In het hart van de Monts du Lyonnais, op 800 meter hoogte, grazen onze alpengeiten het hele jaar door, met een kaasmakerij op de boerderij."
    ],
    "es": [
      "En el corazón de los Montes del Lyonnais, a 800 m de altitud, nuestras cabras gamuzas alpinas pastan todo el año, con un taller de transformación de quesos en la granja."
    ]
  },
  "rdfs:label": {
