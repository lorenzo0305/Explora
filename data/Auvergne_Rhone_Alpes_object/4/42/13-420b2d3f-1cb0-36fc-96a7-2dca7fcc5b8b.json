  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen Moment der absoluten Entspannung im Nuxe Spa des I.L.Y Hotels La Rosière. Zwischen entspannenden Massagen, Gesichtsbehandlungen und Momenten des Wohlbefindens in unserem Spa-Bereich mit Pool, Whirlpool, Sauna und Hammam."
    ],
    "en": [
      "Treat yourself to a moment of absolute relaxation at the Nuxe Spa of I.L.Y Hotels La Rosière. From soothing massages to rejuvenating facials and wellness experiences in our spa area with a heated pool, jacuzzis, sauna, and steam room, immerse yourself in a blissful escape in the heart of the mountains."
    ],
    "it": [
      "Concedetevi un momento di assoluto relax alla Spa Nuxe di I.L.Y Hotels La Rosière. Tra massaggi rilassanti, trattamenti viso rigeneranti e momenti di benessere nella nostra area spa con piscina riscaldata, vasche idromassaggio, sauna e hammam, immergetevi in un’oasi di benessere nel cuore delle montagne."
    ],
    "fr": [
      "Offrez-vous un instant de détente absolue au Spa Nuxe du I.L.Y Hotels La Rosière. Entre massages relaxants, soins visage et moments de bien-être dans notre espace spa avec piscine, bains à remous, sauna et hammam."
    ],
    "nl": [
      "Trakteer uzelf op een moment van absolute ontspanning in de Spa Nuxe van I.L.Y Hotels La Rosière. Geniet van ontspannende massages, gezichtsbehandelingen en momenten van welzijn in onze spa met zwembad, bubbelbaden, sauna en stoombad."
    ],
    "es": [
      "Regálese un momento de relajación absoluta en el Spa Nuxe de I.L.Y Hotels La Rosière. Disfrute de masajes relajantes, tratamientos faciales y momentos de bienestar en nuestra zona de spa con piscina, bañeras de hidromasaje, sauna y sala de vapor."
    ]
  },
  "rdfs:label": {
    "en": [
