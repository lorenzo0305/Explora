  "rdfs:comment": {
    "de": [
      "Laure-Lyne bietet Ihnen aktive Führungen mit Kleintieren, Verkostung von Produkten des Hofes, Kühemelken und verschiedene Workshops im Zusammenhang mit der Natur und Tieren für Kinder."
    ],
    "en": [
      "Come and meet Laure-Lynne in the heart of the three-barns farm, which offers a tailor-made programme with cooking classes, exchanges, learning, play-based activities and moments of tenderness with animals."
    ],
    "it": [
      "Laure-Lyne offre visite attive ai piccoli animali, degustazione di prodotti della fattoria, mungitura delle mucche e vari laboratori legati alla natura e agli animali per i bambini."
    ],
    "fr": [
      "Laure-Lyne vous propose des visites actives auprès des petits animaux, goûter des produits de la ferme, traite des vaches et ateliers divers en lien avec la nature et les animaux pour les enfants."
    ],
    "es": [
      "Transmisión e intercambios lúdicos y pedagógicos en el corazón de la Ferme aux Trois Granges.\r\nCon animales pequeños y grandes; para los golosos y los científicos en ciernes..."
    ],
    "nl": [
      "Florence verwelkomt u in de boerderij waar ze opgegroeid is. Transmissie en uitwisselingen op educatieve en ludieke manier in de \"boerderij met drie schuren\" . Met kleine en grote dieren; voor lekkerbekken en toekomstige wetenschappers ...."
    ]
  },
