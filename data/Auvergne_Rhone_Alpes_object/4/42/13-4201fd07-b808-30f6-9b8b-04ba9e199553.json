  "rdfs:comment": {
    "de": [
      "Jedes Jahr finden auf der Rennbahn drei Pferderennveranstaltungen mit gegenseitigen Wetten und 7 bis 8 Rennen pro Veranstaltung statt. Diese Rennen sind den Trabern vorbehalten und die besten Fahrer und Trainer der Region nehmen daran teil."
    ],
    "en": [
      "Every year, the racecourse hosts 3 horseracing meetings with pari-mutuel betting, and 7 to 8 races per meeting. These races are reserved for trotters, and the best drivers and trainers in the region take part."
    ],
    "it": [
      "Ogni anno l'ippodromo ospita 3 riunioni di corse di cavalli pari-mutuel e 7-8 corse per riunione. Queste corse sono riservate ai trottatori e vi partecipano i migliori guidatori e allenatori della regione."
    ],
    "fr": [
      "Tous les ans, l'hippodrome accueille 3 réunions de courses hippiques avec pari mutuel et 7 à 8 courses par réunion. Ces courses sont réservées aux trotteurs, et les meilleurs drivers et entraîneurs de la région y participent."
    ],
    "nl": [
      "De renbaan organiseert jaarlijks 3 bijeenkomsten voor paardenraces op basis van weddenschappen en 7 tot 8 races per bijeenkomst. Deze races zijn voorbehouden aan dravers, en de beste rijders en trainers uit de regio nemen eraan deel."
    ],
    "es": [
      "Cada año, el hipódromo acoge 3 reuniones de carreras de caballos pari-mutuel y de 7 a 8 carreras por reunión. Estas carreras están reservadas a los trotones, y en ellas participan los mejores pilotos y entrenadores de la región."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hippodrome de Lachamp - Gilbert Best"
    ]
  },
