  "rdfs:comment": {
    "de": [
      "Ein traditionelles Chalet, das mit Skiern oder zu Fuß erreichbar ist.\r\nDas Chalet des Colosses befindet sich neben der Talstation des Sessellifts Les Colosses. Es bietet eine schöne Terrasse im Sommer wie im Winter."
    ],
    "en": [
      "Restaurant"
    ],
    "it": [
      "Uno chalet tradizionale accessibile con gli sci o a piedi.\r\nLo Chalet des Colosses si trova vicino alla partenza della seggiovia Colosses. Offre una splendida terrazza in estate e in inverno."
    ],
    "fr": [
      "Un chalet traditionnel accessible à ski ou à pied.\r\nLe Chalet des Colosses se situe à côté du départ du télésiège des Colosses. Il offre une belle terrasse été comme hiver."
    ],
    "es": [
      "Un chalet tradicional al que se puede acceder esquiando o a pie.\r\nEl Chalet des Colosses está situado junto al inicio del telesilla Colosses. Ofrece una hermosa terraza en verano y en invierno."
    ],
    "nl": [
      "Een traditioneel chalet dat toegankelijk is op ski's of te voet.\r\nHet Chalet des Colosses ligt naast de start van de stoeltjeslift Colosses. Het heeft zowel in de zomer als in de winter een heerlijk terras."
    ]
  },
  "rdfs:label": {
