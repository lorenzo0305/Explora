  "rdfs:comment": {
    "de": [
      "Im Le Bel Horizon werden Sie das Beste der regionalen Gastronomie mit typischen Gerichten und hochwertigen Produkten entdecken. Der Speisesaal und seine großen Fensterfronten bieten Ihnen einen herrlichen Blick auf die Berge des Cantal."
    ],
    "en": [
      "At Le Bel Horizon, you'll discover the best of the region's gastronomy, with typical dishes and quality produce. The restaurant's large bay windows offer a superb view of the Cantal mountains."
    ],
    "it": [
      "Le Bel Horizon vi farà scoprire il meglio della gastronomia della regione con i suoi piatti tipici e prodotti di qualità. La sala ristorante e le sue grandi finestre vi offriranno una vista superba sulle montagne del Cantal."
    ],
    "fr": [
      "Le Bel Horizon vous fera découvrir le meilleur de la gastronomie de la région avec ses plats typiques et des produits de qualité. La salle de restaurant et ses grandes baies vitrées vous offriront une superbe vue sur les monts du Cantal."
    ],
    "nl": [
      "Le Bel Horizon laat u het beste van de gastronomie van de streek ontdekken met zijn typische gerechten en kwaliteitsproducten. De restaurantzaal met zijn grote ramen biedt u een prachtig uitzicht op de bergen van de Cantal."
    ],
    "es": [
      "En Le Bel Horizon, descubrirá lo mejor de la gastronomía de la región, con platos típicos y productos de calidad. La sala del restaurante y sus grandes ventanales ofrecen una magnífica vista de las montañas del Cantal."
    ]
  },
