  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in St Georges d'Esperanche. Wir können Sie für die Dauer eines Picknicks empfangen. Kontaktieren Sie vorher die Ansprechperson, die Ihnen Zugang zum Außenbereich gewährt."
    ],
    "en": [
      "Welcome to Relais Cyné in St Georges d'Esperanche. We can accommodate you for a picnic. Please contact the contact person beforehand, who will give you access to the outside area."
    ],
    "it": [
      "Benvenuti al Relais Cyné a St Georges d'Esperanche. Possiamo ospitarvi per un picnic. Vi preghiamo di contattare preventivamente la persona di riferimento, che vi darà accesso all'area esterna."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de St Georges d'Esperanche. Nous pouvons vous accueillir le temps d'un pique nique. Contacter préalablement la personne ressource qui vous donnera accès aux extérieurs."
    ],
    "nl": [
      "Welkom bij Relais Cyné in St Georges d'Esperanche. We kunnen u ontvangen voor een picknick. Neem van tevoren contact op met de resource persoon, die u toegang zal geven tot de buitenruimte."
    ],
    "es": [
      "Bienvenido al Relais Cyné en St Georges d'Esperanche. Podemos acogerle para un picnic. Por favor, póngase en contacto con la persona de recursos de antemano, que le dará acceso a la zona exterior."
    ]
  },
