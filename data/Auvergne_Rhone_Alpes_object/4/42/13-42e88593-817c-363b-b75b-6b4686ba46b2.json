  "rdfs:comment": {
    "de": [
      "Diese Tour wird Ihnen vom Fremdenverkehrsamt von Valencia angeboten. Ein Dokument ist in unseren Räumlichkeiten erhältlich!\r\nAuf der gesamten Strecke entlang dieser Wasserläufe können Sie eine ganze außergewöhnliche Tier- und Pflanzenwelt beobachten, und das mitten in der Stadt."
    ],
    "en": [
      "This tour is brought to you by the Valence Tourist Office. A brochure is available on our premises!\r\nAll along the route along these waterways, you'll be able to observe a whole world of exceptional animals and plants, right in the heart of the city."
    ],
    "it": [
      "Questo tour è offerto dall'Ufficio del Turismo di Valence. Un opuscolo è disponibile presso la nostra sede!\r\nLungo il percorso che costeggia questi corsi d'acqua, potrete osservare un intero mondo di animali e piante eccezionali, proprio nel cuore della città."
    ],
    "fr": [
      "Ce circuit vous est proposé par l'Office de Tourisme de Valence. Un document est disponible dans nos locaux !\r\nTout le long du parcours longeant ces cours d'eau, vous pourrez observer tout un monde animal, végétal exceptionnel, en plein cœur de la ville."
    ],
    "es": [
      "Esta visita es ofrecida por la Oficina de Turismo de Valence. El folleto está disponible en nuestros locales\r\nA lo largo del recorrido por estos cursos de agua, podrá observar todo un mundo de animales y plantas excepcionales, en pleno centro de la ciudad."
    ],
    "nl": [
      "Deze rondleiding wordt u aangeboden door het toeristenbureau van Valence. Een folder is verkrijgbaar bij ons kantoor!\r\nLangs deze waterwegen kunt u een hele wereld van bijzondere dieren en planten observeren, midden in de stad."
    ]
  },
