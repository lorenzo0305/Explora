  "rdfs:comment": {
    "de": [
      "Seit mehr als 40 Jahren bietet Ihnen die Agentur Province-Immobilier (FNAIM) ihre Dienstleistungen in den Bereichen Verkauf - Schätzung - Mietverwaltung in Saint Paul Trois Châteaux, Grignan, Suze la Rousse und Sainte Cécile Les Vignes an."
    ],
    "en": [
      "For more than 40 years, Agence ProvinceImmobilier (FNAIM) has provided services for Sales - Valuation - Rental Management for Saint Paul Trois Châteaux, Grignan, Suze la Rousse and Sainte Cécile Les Vignes."
    ],
    "it": [
      "L'Agence Province Immobilier ha 40 anni, una clientela internazionale e diverse agenzie nella Drôme Provençale e nell'Haut Vaucluse:\r\nSaint Paul 3 Châteaux, Grignan, Suze la Rousse e Ste Cécile les vignes."
    ],
    "fr": [
      "L' Agence Province Immobilier c'est 40 ans d’existence, une clientèle internationale et plusieurs agences en Drôme Provençale et Haut Vaucluse :\r\nSaint Paul 3 Châteaux, Grignan, Suze la Rousse et Ste Cécile les vignes."
    ],
    "nl": [
      "Al meer dan 40 jaar biedt het onroerend goed agentschap Provincie-Immobilier (FNAIM) u zijn diensten aan: Verkoop - Taxatie - Verhuurbeheer in Saint Paul Trois Châteaux, Grignan, Suze la Rousse en Sainte Cécile Les Vignes."
    ],
    "es": [
      "Agence Province Immobilier tiene 40 años, una clientela internacional y varias agencias en Drôme Provençale y Haut Vaucluse:\r\nSaint Paul 3 Châteaux, Grignan, Suze la Rousse y Ste Cécile les vignes."
    ]
  },
