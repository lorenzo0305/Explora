  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt liegt im Herzen von Panissières in den Montagnes du Matin und ist mit einem Parkplatz in der Nähe und einem für alle zugänglichen Eingang leicht zu erreichen. Hier finden Sie nach Themen geordnetes lokales, departementales und nationales Informationsmaterial"
    ],
    "en": [
      "Located in the heart of Panissières in the Montagnes du Matin, the Tourist Office is easy to reach with a car park nearby and an entrance accessible to all. You will find a local, departmental and national documentation classified by theme"
    ],
    "it": [
      "Situato nel cuore di Panissières, nelle Montagnes du Matin, l'Ufficio del Turismo è di facile accesso con un parcheggio nelle vicinanze e un ingresso accessibile a tutti. Troverete documentazione locale, dipartimentale e nazionale classificata per tema"
    ],
    "fr": [
      "Situé au coeur de Panissières dans les Montagnes du Matin, l'Office de Tourisme est facile d'accès avec un parking à proximité et une entrée accessible par tous. Vous y trouverez une documentation locale, départementale et nationale classée par thématique"
    ],
    "es": [
      "Situada en el corazón de Panissières, en las Montagnes du Matin, la Oficina de Turismo es de fácil acceso, con un aparcamiento cercano y una entrada accesible para todos. Encontrará documentación local, departamental y nacional clasificada por temas"
    ],
    "nl": [
      "Het VVV-kantoor ligt in het hart van Panissières in de Montagnes du Matin en is gemakkelijk bereikbaar met een parkeerplaats in de buurt en een voor iedereen toegankelijke ingang. U vindt lokale, departementale en nationale documentatie gerangschikt per thema"
    ]
  },
