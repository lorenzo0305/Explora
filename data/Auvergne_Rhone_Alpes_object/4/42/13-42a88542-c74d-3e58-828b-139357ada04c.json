  "rdfs:comment": {
    "de": [
      "Gilles und Jessica empfangen Sie das ganze Jahr über und bieten Ihnen eine traditionelle und familiäre Küche. Menü des Tages.\r\nJeden Freitag kommen Sie und genießen Sie den hausgemachten Kalbskopf.\r\nNeu: abends und am Wochenende Crêperie"
    ],
    "en": [
      "Gilles and Jessica welcome you all year round and offer traditional, family-style cuisine. Daily menu.\nEvery Friday, enjoy our home-cooked calf's head.\nNew: evenings and weekends crêperie"
    ],
    "it": [
      "Gilles e Jessica vi accolgono tutto l'anno e vi offrono una cucina tradizionale e familiare. Menu del giorno.\r\nOgni venerdì, venite a gustare la testa di vitello fatta in casa.\r\nNovità: creperia serale e del fine settimana"
    ],
    "fr": [
      "Gilles et Jessica vous accueillent toute l'année et vous proposent une cuisine traditionnelle et familiale. Menu du jour.\r\nTous les vendredis venez déguster la tête de veau préparée maison.\r\nNouveauté : soir et week-end crêperie"
    ],
    "es": [
      "Gilles y Jessica le dan la bienvenida todo el año y le ofrecen una cocina tradicional y familiar. Menú del día.\nTodos los viernes, venga a probar nuestra cabeza de ternera casera.\nNovedad: crepería nocturna y de fin de semana"
    ],
    "nl": [
      "Gilles en Jessica verwelkomen u het hele jaar door en bieden u een traditionele en familiale keuken. Menu van de dag.\r\nKom elke vrijdag de zelfgemaakte kalfskop proeven.\r\nNieuw: avond- en weekendcreperie"
    ]
  },
