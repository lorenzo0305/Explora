  "rdfs:comment": {
    "de": [
      "An der Südflanke des majestätischen Tanargue-Massivs gelegen, ist La Bastide de Sanilhac ein alter feudaler Wohnsitz. In 450 m Höhe blickt sie auf die Weinberge und Kastanienbäume des Bas Vivarais."
    ],
    "en": [
      "La Bastide de Sanilhac used to be a feudal residence on the south side of the majestic Le Tanargue hill. It towers over vineyards and chestnut trees in the Lower Vivarais region from its 450m high setting."
    ],
    "it": [
      "Situata sul versante meridionale del maestoso massiccio del Tanargue, La Bastide de Sanilhac è un'antica residenza feudale. A 450 metri di altitudine, si affaccia sui vigneti e sui castagni del Bas Vivarais."
    ],
    "fr": [
      "Situé sur le flanc sud du majestueux massif du Tanargue, La Bastide de Sanilhac est une ancienne demeure féodale. A 450 mètres d’altitude, elle contemple les vignes et les châtaigniers du Bas Vivarais."
    ],
    "es": [
      "Situada en el flanco sur del majestuoso macizo de Tanargue, La Bastide de Sanilhac es una antigua residencia feudal. A 450 metros de altitud, domina los viñedos y castaños del Bas Vivarais."
    ],
    "nl": [
      "La Bastide de Sanilhac ligt op de zuidelijke flank van het majestueuze Tanargue-massief en is een oude feodale residentie. Op 450 meter hoogte kijkt het uit over de wijngaarden en kastanjebomen van de Bas Vivarais."
    ]
  },
  "rdfs:label": {
    "en": [
