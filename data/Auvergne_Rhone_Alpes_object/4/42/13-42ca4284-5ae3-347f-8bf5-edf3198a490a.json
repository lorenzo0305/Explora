  "rdfs:comment": {
    "de": [
      "Erkunden Sie die dynamische Welt von Leygatech, in der 210 Talente zusammenarbeiten, um die Verpackung von morgen zu gestalten. Teilen Sie unsere Leidenschaft für nachhaltige Innovation bei einem spannenden Rundgang durch unsere Produktionsstätte."
    ],
    "en": [
      "Explore the dynamic world of Leygatech, where 210 talents come together to shape the packaging of tomorrow. Share our passion for sustainable innovation during a captivating tour of our production site."
    ],
    "it": [
      "Esplorate il mondo dinamico di Leygatech, dove 210 talenti si uniscono per dare forma al packaging di domani. Condividete la nostra passione per l'innovazione sostenibile con un emozionante tour del nostro sito produttivo."
    ],
    "fr": [
      "Explorez l'univers dynamique de Leygatech, où 210 talents s'unissent pour façonner l'emballage de demain. Partagez notre passion pour l'innovation durable lors d'une visite captivante de notre site de production."
    ],
    "nl": [
      "Ontdek de dynamische wereld van Leygatech, waar 210 talenten samenkomen om de verpakking van morgen vorm te geven. Deel onze passie voor duurzame innovatie tijdens een boeiende rondleiding door onze productiesite."
    ],
    "es": [
      "Explore el dinámico mundo de Leygatech, donde 210 talentos se unen para dar forma a los envases del mañana. Comparta nuestra pasión por la innovación sostenible en una emocionante visita a nuestro centro de producción."
    ]
  },
