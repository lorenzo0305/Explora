  "rdfs:comment": {
    "de": [
      "Die Brauerei hat sich mit drei Bierrezepten etabliert: einem hellen, einem bernsteinfarbenen und einem leichten IPA. Klassische Rezepte, die möglichst viele Gaumen überzeugen und wegen ihrer Persönlichkeit im Gedächtnis bleiben."
    ],
    "en": [
      "The brewery has established itself with three beer recipes: a blonde, an amber and a light IPA. These classic recipes are sure to win over the greatest number of palates, and capture the imagination with their personality."
    ],
    "it": [
      "Il birrificio si è affermato con tre ricette di birra: una bionda, un'ambrata e una IPA leggera. Si tratta di ricette classiche che conquistano il maggior numero di palati e conservano gli spiriti per la loro personalità."
    ],
    "fr": [
      "La brasserie s’est instaurée avec trois recettes de bière : une blonde, une ambrée et une IPA légère. Des recettes classiques qui sauront convaincre le plus grand nombre de palais, et retenir les esprits pour leur personnalité."
    ],
    "es": [
      "La cervecería se ha establecido con tres recetas de cerveza: una rubia, una ámbar y una IPA ligera. Se trata de recetas clásicas que conquistarán el mayor número de paladares y conservarán los espíritus por su personalidad."
    ],
    "nl": [
      "De brouwerij heeft zich gevestigd met drie bierrecepten: een blonde, een amber en een lichte IPA. Klassieke recepten die de meeste fijnproevers zullen overtuigen, en de geesten voor hun persoonlijkheid behouden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Brew-Vernet"
    ]
  },
