  "rdfs:comment": {
    "de": [
      "Ein Skatepark am Ufer der Loire\r\nDer Skatepark in Brives-Charensac befindet sich direkt neben dem städtischen Campingplatz am Ufer der Loire. Er verfügt über 6 Module: 2 Quarters, eine schiefe Ebene, einen Tisch und eine Slidebar."
    ],
    "en": [
      "A skatepark on the banks of the Loire\r\nThe Brives-Charensac skatepark is located right next to the municipal campsite on the banks of the Loire. It comprises 6 modules: 2 quarters, an inclined plane, a table and a slide bar."
    ],
    "it": [
      "Uno skatepark sulle rive della Loira\r\nLo skatepark di Brives-Charensac si trova accanto al campeggio comunale sulle rive della Loira. Dispone di 6 moduli: 2 quartieri, un piano inclinato, un tavolo e una barra di scorrimento."
    ],
    "fr": [
      "Un skatepark sur les bords de Loire\r\nLe skatepark de Brives-Charensac est situé juste à côté du camping municipal sur les bords de Loire. Il compte 6 modules : 2 quarters, un plan incliné, une table est une barre à slide."
    ],
    "es": [
      "Un skatepark a orillas del Loira\r\nEl skatepark de Brives-Charensac está situado junto al camping municipal, a orillas del Loira. Cuenta con 6 módulos: 2 quarters, un plano inclinado, una mesa y una barra de deslizamiento."
    ],
    "nl": [
      "Een skatepark aan de oevers van de Loire\r\nHet skatepark van Brives-Charensac ligt vlak naast de gemeentelijke camping aan de oevers van de Loire. Het heeft 6 modules: 2 kwartieren, een hellend vlak, een tafel en een glijstang."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Skate Parc"
    ]
  },
