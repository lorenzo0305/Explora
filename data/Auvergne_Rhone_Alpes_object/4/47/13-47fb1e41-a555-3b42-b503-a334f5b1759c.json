  "rdfs:comment": {
    "de": [
      "Teravelo bietet den Verleih von Mountainbikes UND VTTAE sowie kleine Fahrradreparaturen vor Ort oder unterwegs zur Pannenhilfe für Personen, die mit dem Fahrrad unterwegs sind."
    ],
    "en": [
      "Teravelo offers rental of mountain bikes and ATVs, as well as small-scale bike repairs on site or on the road for cyclists on the move."
    ],
    "it": [
      "Teravelo offre il noleggio di mountain bike e ATV, oltre a piccole riparazioni in loco o su strada per i ciclisti in movimento."
    ],
    "fr": [
      "Teravelo propose de la location de VTT ET VTTAE ainsi que de la petite réparation de vélo sur place ou en déplacement pour du dépannage pour les personnes en itinérance à vélo."
    ],
    "nl": [
      "Teravelo verhuurt mountainbikes en ATV's, en biedt kleinschalige fietsreparaties ter plaatse of onderweg voor fietsers die onderweg zijn."
    ],
    "es": [
      "Teravelo ofrece alquiler de bicicletas de montaña y todoterrenos, así como pequeñas reparaciones de bicicletas in situ o en la carretera para ciclistas en movimiento."
    ]
  },
