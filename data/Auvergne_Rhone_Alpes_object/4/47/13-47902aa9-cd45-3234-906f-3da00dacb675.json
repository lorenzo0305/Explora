  "rdfs:comment": {
    "de": [
      "Aquarock Aventure, das sind 10 Parcours zwischen Bäumen, Felsen und Fluss in der geschützten Umgebung des Eyrieux-Tals im Herzen der Ardèche. Ab 2 Jahren zugänglich. Sportschuhe erforderlich, Minderjährige in Begleitung. Aktivität nur mit Reservierung!"
    ],
    "en": [
      "Aquarock Adventure park has 10 courses of varying difficulty set out between rocks, trees and river. Located in the natural environment of the Eyrieux Valley in central Ardèche. From 2 years old upwards. Trainers essential, children must be accompanied by an adult. By advance booking only !"
    ],
    "it": [
      "Aquarock Aventure è costituito da 10 percorsi tra alberi, rocce e fiume, nella cornice preservata della Valle di Eyrieux, nel cuore dell'Ardèche. Accessibile a partire dai 2 anni. Scarpe sportive obbligatorie, minori accompagnati. Attività solo su prenotazione!"
    ],
    "fr": [
      "Aquarock Aventure, c'est 10 parcours entre arbres, rochers et rivière, dans le cadre préservé de la Vallée de l'Eyrieux au cœur de l'Ardèche. Accessible dès 2 ans. Chaussures de sports exigées, mineurs accompagnés. Activité sur réservation seulement !"
    ],
    "es": [
      "Aquarock Aventure son 10 recorridos entre árboles, rocas y río, en el marco preservado del Valle de Eyrieux, en el corazón de la Ardèche. Accesible a partir de los 2 años. Se requiere calzado deportivo, menores acompañados. Actividad sólo con reserva"
    ],
    "nl": [
      "Aquarock Aventure is niet zomaar een klimparcours, het is een avonturenpark boven het water en tussen rotsen. Bied het park u 10 parcouren met twee mega lange tokkelbanen van 250 et 300 meter. Denk er aan uw plaatsje te reserveren !"
    ]
  },
