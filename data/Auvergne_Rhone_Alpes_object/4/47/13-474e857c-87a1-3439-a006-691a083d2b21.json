  "rdfs:comment": {
    "de": [
      "Das authentische Dorf Châtel liegt im Herzen der Portes du Soleil, im wunderschönen Tal von Abondance, und lädt Sie ein, das Massagezentrum 'Authentique Voyage' im Hotel-Restaurant Macchi zu entdecken."
    ],
    "en": [
      "Located in the heart of Portes du Soleil, in the wonderful Abondance valley, Châtel, authentic village, invites you to discover the massage space 'Authentique Voyage' in the MACCHI Hotel."
    ],
    "it": [
      "Situato nel cuore delle Portes du Soleil, nella magnifica valle dell'Abondance, l'autentico villaggio di Châtel vi invita a scoprire il centro massaggi \"Authentique Voyage\" nell'hotel-ristorante Macchi."
    ],
    "fr": [
      "Situé au cœur des Portes du Soleil, dans la magnifique vallée d’Abondance, Châtel, village authentique, vous invite à découvrir le centre de massage 'Authentique Voyage' au sein de l’hôtel-restaurant Macchi."
    ],
    "es": [
      "Situado en el corazón de Portes du Soleil, en el magnífico valle de Abondance, el auténtico pueblo de Châtel le invita a descubrir el centro de masajes \"Authentique Voyage\" del hotel-restaurante Macchi."
    ],
    "nl": [
      "Het authentieke dorpje Châtel midden in Portes du Soleil, in de prachtige Abondance-vallei, nodigt u uit voor een bezoek aan de massage ruimte 'Authentique Voyage' , van Hotel-restaurant Macchi."
    ]
  },
  "rdfs:label": {
    "en": [
      "Massage Center 'Authentique Voyage'"
    ],
    "fr": [
      "Centre de Massage 'Authentique Voyage'"
    ],
    "nl": [
      "Massagecentrum 'Authentique Voyage'"
    ]
  },
