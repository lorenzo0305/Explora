  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Quatre Vallées bietet Ihnen eine traditionelle und savoyische Küche. Von Ihrem Tisch aus, auf der Terrasse oder im Saal, genießen Sie den Panoramablick auf den Lac du Bourget und entfliehen Sie dem Alltag während eines Mittagessens oder einer Gourmetpause..."
    ],
    "en": [
      "Les Quatre Vallées restaurant offers traditional Savoyard cuisine. From your table, on the terrace or in the dining room, enjoy the panoramic view of Lac du Bourget and escape for lunch or a gourmet break..."
    ],
    "it": [
      "Il ristorante Les Quatre Vallées propone una cucina tradizionale savoiarda. Approfittate della vista panoramica sul Lac du Bourget dal vostro tavolo, sulla terrazza o nella sala da pranzo, e scappate per un pranzo o una pausa gourmet..."
    ],
    "fr": [
      "Le restaurant Les Quatre Vallées vous propose une cuisine traditionnelle et savoyarde. Depuis votre table, en terrasse comme en salle, profitez de la vue panoramique sur le lac du Bourget pour vous évader le temps d'un déjeuner ou d'une pause gourmande.."
    ],
    "nl": [
      "Restaurant Les Quatre Vallées serveert traditionele Savoyaardse gerechten. Geniet van het panoramische uitzicht op het Lac du Bourget vanaf uw tafel, op het terras of in de eetzaal, en ontsnap voor de lunch of een gastronomische pauze..."
    ],
    "es": [
      "El restaurante Les Quatre Vallées sirve cocina tradicional saboyana. Aproveche la vista panorámica del Lac du Bourget desde su mesa, ya sea en la terraza o en el comedor, y escápese para almorzar o hacer una pausa gastronómica..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les 4 (quatre) Vallées"
    ]
  },
