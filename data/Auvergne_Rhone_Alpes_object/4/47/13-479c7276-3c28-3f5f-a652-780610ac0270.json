  "rdfs:comment": {
    "de": [
      "Erleben Sie die Vorteile der Ganzkörper-Kryotherapie und der Kryolipolyse. Unsere Wellnesseinrichtung bietet Ihnen Kryotherapie zu einem erschwinglichen Preis und mit der neuesten Technologie."
    ],
    "en": [
      "Come and discover the benefits of whole-body cryotherapy and Cryolipolysis. Our wellness center offers affordable cryotherapy sessions using the latest technology."
    ],
    "it": [
      "Venite a scoprire i benefici della crioterapia e della criolipolisi su tutto il corpo. Il nostro centro benessere offre sedute di crioterapia a prezzi accessibili, utilizzando le tecnologie più avanzate."
    ],
    "fr": [
      "Venez découvrir les bienfaits de la cryothérapie corps entier et de la Cryolipolyse. Notre établissement de bien-être vous propose des séances de cryothérapie à un prix abordable et avec les dernières technologies."
    ],
    "es": [
      "Venga y descubra los beneficios de la crioterapia de cuerpo entero y la criolipólisis. Nuestro centro de bienestar ofrece sesiones de crioterapia asequibles con la tecnología más avanzada."
    ],
    "nl": [
      "Kom en ontdek de voordelen van cryotherapie voor het hele lichaam en cryolipolyse. Ons wellnesscentrum biedt betaalbare cryotherapiesessies met de nieuwste technologie."
    ]
  },
  "rdfs:label": {
