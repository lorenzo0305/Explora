  "rdfs:comment": {
    "de": [
      "Entdecken Sie Buschspielzeug, das in wenigen Minuten im Wald hergestellt werden kann und Kinder und Erwachsene in Staunen versetzt."
    ],
    "en": [
      "Discover the wild toys that can be made in just a few minutes in the woods, to amaze young and old alike."
    ],
    "it": [
      "Scoprite i giocattoli nascosti che si possono costruire nel bosco in pochi minuti per deliziare grandi e piccini."
    ],
    "fr": [
      "Partez à la découverte des jouets buissonniers que l’on réalise au coin du bois en quelques minutes pour émerveiller petits et grands."
    ],
    "nl": [
      "Ontdek het verborgen speelgoed dat je in een paar minuten in het bos kunt maken om jong en oud te vermaken."
    ],
    "es": [
      "Descubre los juguetes ocultos que se pueden fabricar en el bosque en pocos minutos para hacer las delicias de grandes y pequeños."
    ]
  },
  "rdfs:label": {
    "fr": [
