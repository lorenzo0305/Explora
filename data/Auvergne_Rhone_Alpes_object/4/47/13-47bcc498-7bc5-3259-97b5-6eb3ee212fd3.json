  "rdfs:comment": {
    "de": [
      "Durch die Einrichtung von Nachbarschaftsbibliotheken dazu beitragen, dass das Lesen für alle zugänglich wird, den Empfang und das Zuhören bevorzugen und den Austausch zwischen den Generationen fördern. Verkauf von gebrauchten Büchern."
    ],
    "en": [
      "Helping to make reading accessible to all by creating local libraries, giving priority to welcoming and listening, and encouraging intergenerational exchange. Sale of second-hand books."
    ],
    "it": [
      "Contribuire a rendere la lettura accessibile a tutti creando biblioteche locali, facendo sentire le persone accolte, ascoltandole e incoraggiando lo scambio intergenerazionale. Vendita di libri di seconda mano."
    ],
    "fr": [
      "Contribuer à rendre la lecture accessible à tous en créant des bibliothèques de proximité, privilégier l'accueil, l'écoute, favoriser l'échange intergénérationnel. Vente de livres d'occasion."
    ],
    "nl": [
      "Helpen om lezen voor iedereen toegankelijk te maken door lokale bibliotheken te creëren, mensen zich welkom te laten voelen, naar hen te luisteren en uitwisseling tussen generaties aan te moedigen. Verkoop van tweedehands boeken."
    ],
    "es": [
      "Ayudar a que la lectura sea accesible para todos creando bibliotecas locales, haciendo que las personas se sientan bienvenidas, escuchándolas y fomentando el intercambio intergeneracional. Venta de libros de segunda mano."
    ]
  },
  "rdfs:label": {
