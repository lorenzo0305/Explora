  "rdfs:comment": {
    "de": [
      "Maison Gloria bietet eine Küche aus aller Welt in einem ebenso festlichen wie gemütlichen Ambiente. Geöffnet von Montag bis Sonntag mit durchgehendem Catering-Service von 11:45 bis 23:00 Uhr (außer Sonntagabend)."
    ],
    "en": [
      "Maison Gloria offers world cuisine in a warm, festive atmosphere."
    ],
    "it": [
      "La Maison Gloria offre una cucina mondiale in un'atmosfera calda e festosa. Aperto dal lunedì alla domenica con servizio ristorante continuo dalle 11.45 alle 23.00 (tranne la domenica sera)."
    ],
    "fr": [
      "Maison Gloria propose une cuisine du monde dans une ambiance aussi festive que chaleureuse. Ouvert du lundi au dimanche en service restauration continu de 11h45 à 23h00 (sauf dimanche soir)."
    ],
    "es": [
      "Maison Gloria ofrece cocina del mundo en un ambiente cálido y festivo. Abierto de lunes a domingo con servicio continuo de restaurante de 11.45 a 23.00 (excepto los domingos por la noche)."
    ],
    "nl": [
      "Maison Gloria biedt wereldkeuken in een warme en feestelijke sfeer. Geopend van maandag tot zondag met doorlopende restaurantservice van 11.45 tot 23.00 uur (behalve zondagavond)."
    ]
  },
  "rdfs:label": {
