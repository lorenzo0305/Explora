  "rdfs:comment": {
    "de": [
      "Wir, die handwerklichen Bäcker und Konditoren, bieten Ihnen eine Reihe von Produkten an, die vollständig von uns hergestellt werden! Wir laden Sie ein, alle unsere Patisserien, unsere berühmte Brioche mit Pralinen sowie alle unsere Spezialbrote zu probieren!"
    ],
    "en": [
      "As artisan bakers and patissiers, we offer you a range of products made entirely by us! We invite you to sample all our pastries, our famous praline brioche and all our special breads!"
    ],
    "it": [
      "In qualità di panettieri e pasticceri artigianali, vi offriamo una gamma di prodotti realizzati interamente da noi! Vi invitiamo ad assaggiare tutti i nostri dolci, la nostra famosa brioche pralinata e tutte le nostre specialità di pane!"
    ],
    "fr": [
      "Nous, artisans boulangers et pâtissiers, vous offrons une gamme de produits entièrement réalisés par nos soins ! Nous vous invitons à déguster toutes nos pâtisseries, notre fameuse brioche aux pralines ainsi que tous nos pains spéciaux !"
    ],
    "es": [
      "Como panaderos y pasteleros artesanos, le ofrecemos una gama de productos elaborados íntegramente por nosotros Le invitamos a degustar toda nuestra bollería, nuestro famoso brioche de praliné y todas nuestras especialidades de pan"
    ],
    "nl": [
      "Als ambachtelijke bakkers en patissiers bieden we je een assortiment producten die helemaal door ons zijn gemaakt! We nodigen je uit om al onze gebakjes, onze beroemde pralinebrioche en al onze speciale broden te proeven!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulangerie Passion et tradition"
    ]
  },
