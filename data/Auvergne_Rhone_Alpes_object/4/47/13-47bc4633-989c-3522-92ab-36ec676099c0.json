  "rdfs:comment": {
    "de": [
      "Die ZigZag-Skischule ist für ihren persönlichen Ansatz und ihr Engagement für Spitzenleistungen bekannt.  Ein Team von zertifizierten Skilehrern und Bergführern strebt nach Spitzenleistungen."
    ],
    "en": [
      "ZigZag Ski School is the Grand Massif's most popular ski school for English speakers and is highly reputed for its strong customer focus, high standards and commitment to excellence."
    ],
    "it": [
      "La scuola di sci ZigZag è nota per il suo approccio personalizzato e per il suo impegno verso l'eccellenza.  Un team di istruttori e guide certificati alla ricerca dell'eccellenza."
    ],
    "fr": [
      "L’École de Ski ZigZag est reconnue pour son approche personnalisée et son engagement envers l'excellence.  Une équipe de moniteurs et guides certifiés, à la poursuite de l'excellence."
    ],
    "es": [
      "La Escuela de Esquí ZigZag es conocida por su enfoque personalizado y su compromiso con la excelencia.  Un equipo de instructores y guías certificados en busca de la excelencia."
    ],
    "nl": [
      "De Zigzag Ski School wordt erkend voor de kwaliteit van haar onderwijs, haar moderne technieken, de aanpassing van pedagogie en vooral de glimlach!"
    ]
  },
  "rdfs:label": {
