  "rdfs:comment": {
    "de": [
      "Vermietung von Elektrischen Tretrollern - Drôme des Collines : Grüne Ausflüge (verschiedene Ausflüge, die an Ihr Niveau angepasst sind), Geschmackvolle Ausflüge (nach Wahl : Aperitif / Goûter en Trot...) & TrotX3-Ausflüge ( Challenge, Essouflante...)"
    ],
    "en": [
      "Rental of Electric Mountain Scooter - Drôme des Collines: Green Strolls (You can pick from Easy to Advanced), Gustatory Excursions (Aperitif /  Goûter...) & TrotX3 Outings (Challenge, Essouflante... )"
    ],
    "it": [
      "Noleggio di monopattini elettrici fuoristrada - Drôme des Collines: giri verdi (diversi giri adattati al vostro livello), giri gustativi (a scelta tra: aperitivo / spuntino al trotto...) e giri TrotX3 (sfida, mozzafiato...)"
    ],
    "fr": [
      "Location de Trottinettes Electriques Tout Terrain - Drôme des Collines : Balades Vertes (différentes balades adaptées à votre niveau), Balades Gustatives ( au choix : Apéritif / Goûter en Trot...) & Balades TrotX3 ( Challenge, Essouflante...)"
    ],
    "nl": [
      "Verhuur van all-terrain elektrische scooters in de Drôme des Collines: groene ritten, ontdekkingsritten (Apéritif of Picnic en Trot), TrotX3 uitstapjes!"
    ],
    "es": [
      "Alquiler de Scooters Eléctricos Todo Terreno - Drôme des Collines: Paseos Verdes (diferentes paseos adaptados a su nivel), Paseos Gustativos (a elegir entre: Aperitivo / Merienda Trot...) & Paseos TrotX3 (Desafío, Impresionante...)"
    ]
  },
