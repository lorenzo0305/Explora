  "rdfs:comment": {
    "de": [
      "Erbaut 1947, der Legende nach von einer Frau, die gelobt hatte, ein solches Gebäude zu errichten, wenn ihr gefangener Ehemann freigelassen würde."
    ],
    "en": [
      "Built in 1947, according to legend by a woman who vowed to build such an edifice if her imprisoned husband were released."
    ],
    "it": [
      "Costruito nel 1947, secondo la leggenda da una donna che aveva giurato di costruire un edificio simile se il marito imprigionato fosse stato rilasciato."
    ],
    "fr": [
      "Construite en 1947, d'après la légende par une femme qui avait fait voeu de construire un tel édifice si son mari prisonnier était libéré."
    ],
    "nl": [
      "Gebouwd in 1947, volgens de legende door een vrouw die had gezworen een dergelijk gebouw te bouwen als haar gevangen man zou worden vrijgelaten."
    ],
    "es": [
      "Construido en 1947, según la leyenda por una mujer que juró construirlo si liberaban a su marido encarcelado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La petite chapelle du Buis"
