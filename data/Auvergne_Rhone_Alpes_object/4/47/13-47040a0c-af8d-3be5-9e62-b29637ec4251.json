  "rdfs:comment": {
    "de": [
      "Pizzeria vor Ort oder zum Mitnehmen und Brasserie im Stadtzentrum. Mit regionalen Spezialitäten, Burgern aus der Auvergne, belegten Broten, Fleischgerichten, Salaten und Wraps, Crêpes, hausgemachten Waffeln. Menü für Kinder. Schattige Terrasse."
    ],
    "en": [
      "The 1886, café-restaurant, regional specialities. Terrace. Downtown"
    ],
    "it": [
      "Pizzeria e Brasserie in loco o da asporto nel centro della città, con specialità regionali, hamburger d'Alvernia, panini, carni, insalate e involucri, crêpes, waffles fatti in casa. Menu per bambini. Terrazza ombreggiata."
    ],
    "fr": [
      "Pizzeria sur place ou à emporter et Brasserie en centre-ville. proposant des Spécialités régionales, burgers Auvergnats, tartines, viandes, salades et wraps, crêpes, gaufres maison. Menu enfant. Terrasse ombragée."
    ],
    "nl": [
      "Ter plaatse of afhaalpizzeria en brasserie in het stadscentrum, met regionale specialiteiten, burgers uit de Auvergne, sandwiches, vleeswaren, salades en wraps, crêpes, huisgemaakte wafels. Kindermenu. Schaduwrijk terras."
    ],
    "es": [
      "Pizzería y Brasserie en el centro de la ciudad, para comer o llevar, con especialidades regionales, hamburguesas de Auvernia, bocadillos, carnes, ensaladas y wraps, crepes, gofres caseros. Menú infantil. Terraza a la sombra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Le 1886"
    ]
  },
