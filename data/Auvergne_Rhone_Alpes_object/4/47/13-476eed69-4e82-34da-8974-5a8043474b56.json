  "rdfs:comment": {
    "de": [
      "Von Saint-Jean-de-Maurienne aus können Sie mit dem Bus zu einem der größten pyrotechnischen Spektakel Europas aufbrechen! Gehen Sie an Bord eines Schiffes der Cie des bateaux d'Annecy, um eine kommentierte Bootsfahrt auf dem See zu unternehmen. Bewundern Sie die Show vom Boot aus!"
    ],
    "en": [
      "Take a bus from Saint-Jean-de-Maurienne to see one of Europe's greatest fireworks displays! Board a Cie des bateaux d'Annecy boat for a guided cruise on the lake. Watch the show from the boat!"
    ],
    "it": [
      "Partite in pullman da Saint-Jean-de-Maurienne per assistere a uno dei più grandi spettacoli pirotecnici d'Europa! Salite a bordo di un battello della Cie des bateaux d'Annecy per una crociera guidata sul lago. Assistete allo spettacolo dalla barca!"
    ],
    "fr": [
      "Depuis Saint-Jean-de-Maurienne, partez en car assister à l'un des plus grands spectacles pyrotechniques d'Europe ! Embarquement à bord d’un bateau de la Cie des bateaux d’Annecy pour une croisière commentée sur le lac. Admirez le show depuis le bateau !"
    ],
    "es": [
      "Tome un autobús desde Saint-Jean-de-Maurienne para asistir a uno de los mayores espectáculos pirotécnicos de Europa Suba a bordo de un barco de la Cie des bateaux d'Annecy para realizar un crucero guiado por el lago. Vea el espectáculo desde el barco"
    ],
    "nl": [
      "Neem een bus vanuit Saint-Jean-de-Maurienne om een van de grootste vuurwerkshows van Europa te zien! Stap aan boord van een boot van de Cie des bateaux d'Annecy voor een rondvaart over het meer met een gids. Bekijk de show vanaf de boot!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Excursion - Lake Annecy Festival"
    ],
    "fr": [
      "Excursion - Fête du lac d'Annecy"
    ]
  },
