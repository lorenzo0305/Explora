  "rdfs:comment": {
    "de": [
      "SPEZIALIST FÜR HOCHWERTIGE JAPANISCHE KÜCHE\r\nWIR STELLEN MIT LEIDENSCHAFT HOCHWERTIGE REZEPTE AUS AUSSCHLIESSLICH FRISCHEN ZUTATEN HER, UM IHRE SINNE BEI JEDER VERKOSTUNG ZU VERWÖHNEN."
    ],
    "en": [
      "SPECIALIST IN HIGH-END JAPANESE CUISINE\r\nWE'RE PASSIONATE ABOUT CREATING QUALITY RECIPES USING ONLY THE FRESHEST INGREDIENTS TO SATISFY YOUR SENSES AT EVERY TURN."
    ],
    "it": [
      "SPECIALISTA IN CUCINA GIAPPONESE DI ALTA GAMMA\r\nCI IMPEGNIAMO CON PASSIONE A CREARE RICETTE DI QUALITÀ UTILIZZANDO SOLO GLI INGREDIENTI PIÙ FRESCHI PER SODDISFARE I VOSTRI SENSI IN OGNI MOMENTO."
    ],
    "fr": [
      "SPECIALISTE DE LA CUISINE JAPONAISE HAUT DE GAMME\r\nNOUS ÉLABORONS AVEC PASSION DES RECETTES DE QUALITÉ EXCLUSIVEMENT A BASE DE PRODUITS FRAIS POUR SATISFAIRE VOS SENS A CHAQUE DÉGUSTATION."
    ],
    "nl": [
      "SPECIALIST IN DE JAPANSE KEUKEN VAN TOPKLASSE\r\nWE ZIJN GEPASSIONEERD OVER HET CREËREN VAN KWALITEITSRECEPTEN MET ALLEEN DE MEEST VERSE INGREDIËNTEN OM JE ZINTUIGEN TE BEVREDIGEN."
    ],
    "es": [
      "ESPECIALISTA EN COCINA JAPONESA DE ALTA GAMA\r\nNOS APASIONA CREAR RECETAS DE CALIDAD UTILIZANDO SÓLO LOS INGREDIENTES MÁS FRESCOS PARA SATISFACER SUS SENTIDOS EN TODO MOMENTO."
    ]
  },
