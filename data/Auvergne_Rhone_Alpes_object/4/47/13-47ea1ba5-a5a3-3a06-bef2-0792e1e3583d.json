  "rdfs:comment": {
    "de": [
      "Spezieller Freizeitpark für Kinder von 3 bis 12 Jahren im Wald mit zahlreichen Spielen: Baumklettern, Baumhäuser, Rutsche, unterirdische Welt, Netzmeer, Seilbahnen. Verleih von Mountainbikes und Elektrofahrrädern für Familienausflüge."
    ],
    "en": [
      "Leisure park specially designed for the 3 to 12 years old. In the woods there is a wide range of activities available: tree-top adventures and tree houses, slides, an underground world, bouncy nets and zip-lines. You can also rent mountain bikes and E-mountain bikes for family rides."
    ],
    "it": [
      "Parco ricreativo per bambini dai 3 ai 14 anni nel bosco con tanti giochi: case sugli alberi, scivoli, mondo sotterraneo, percorso a rete e mari, percorso a piedi nudi. Noleggio di mountain bike e biciclette elettriche per tutta la famiglia."
    ],
    "fr": [
      "Parc de loisirs spécial enfant de 3 à 14 ans en forêt avec de nombreux jeux : cabanes dans les arbres, toboggans, monde souterrain, sentier et mers de filet, sentier Pieds nus. Location de VTT et VTC électriques pour toute la famille."
    ],
    "nl": [
      "Recreatiepark voor kinderen van 3 tot 12 jaar, in het bos met veel spelletjes: boomklimmen, boomhutten, glijbaan, ondergrondse wereld, zee van netten, tokkelbanen. Verhuurbasis voor mountainbikes en elektrische mountainbikes voor uitstapjes met het gezin."
    ],
    "es": [
      "Parque de ocio para niños de 3 a 14 años en el bosque con muchos juegos: casas en los árboles, toboganes, mundo subterráneo, sendero de redes y mares, sendero para andar descalzo. Alquiler de bicicletas de montaña y eléctricas para toda la familia."
    ]
  },
