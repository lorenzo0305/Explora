  "rdfs:comment": {
    "de": [
      "Ein freundliches Personal, gemütliche und einladende Räumlichkeiten, komfortable Zimmer mit hochwertigen Betten und funktionellen Badezimmern... all das bietet Ihnen Ihr Hotel Prim'Hôtel."
    ],
    "en": [
      "A welcoming staff, friendly and warm spaces, comfortable rooms equipped with top-of-the-range bedding, functional bathrooms? this is what your Prim'Hôtel has in store for you."
    ],
    "it": [
      "Personale cordiale, spazi caldi e accoglienti, camere confortevoli con biancheria da letto di alta gamma, bagni funzionali: ecco cosa vi riserva il vostro Prim'Hôtel."
    ],
    "fr": [
      "Un personnel accueillant, des espaces conviviaux et chaleureux, des chambres confortables équipées d’une literie haut de gamme, des salles de bain fonctionnelles… voici tout ce que vous réserve votre hôtel Prim'Hôtel."
    ],
    "nl": [
      "Vriendelijk personeel, warme en gastvrije ruimtes, comfortabele kamers met topkwaliteit beddengoed, functionele badkamers? Dit is wat uw Prim'Hôtel voor u in petto heeft."
    ],
    "es": [
      "Personal amable, espacios cálidos y acogedores, habitaciones confortables con ropa de cama de alta gama, cuartos de baño funcionales... esto es lo que le reserva su Prim'Hôtel."
    ]
  },
