  "rdfs:comment": {
    "de": [
      "Vermietung von Eseln oder Ponys für einen halben Tag, einen ganzen Tag oder mehrere Tage.\r\nBegleitete Wanderungen mit Eseln oder Ponys.\r\nEselvermittlung / Angepasste Wanderungen für ALLE mit dem Esel.\r\nTracking Game, Escape Game im Freien.\r\nShiatsu"
    ],
    "en": [
      "Donkey or pony hire for 1/2 day, full day or several days.\r\n\r\nTracking Game, outdoor Escape Game\r\nShiatsu"
    ],
    "it": [
      "Noleggio di asini o pony per 1/2 giornata, giornata intera o più giorni.\r\nPasseggiate guidate con asini o pony.\r\nMediazione con gli asini / Passeggiate adattate per TUTTI con gli asini.\r\nTracking Game, gioco di fuga all'aperto.\r\nShiatsu"
    ],
    "fr": [
      "Location d'ânes ou poneys sur la 1/2 journée, journée ou sur plusieurs jours. \r\nRandonnées accompagnées avec ânes ou poneys .\r\nMédiation asine / Randonnées adaptées pour TOUS avec le ânes.\r\nTracking Game, Escape Game de plein air.\r\nShiatsu"
    ],
    "nl": [
      "Ezel- of ponyverhuur voor een 1/2 dag, een hele dag of meerdere dagen.\r\nBegeleide wandelingen met ezels of pony's.\r\nEzelbemiddeling / Aangepaste wandelingen voor ALLEN met ezels.\r\nSpeurspel, outdoor Escape Game.\r\nShiatsu"
    ],
    "es": [
      "Alquiler de burros o ponis para 1/2 día, día completo o varios días.\r\nPaseos guiados con burros o ponis.\r\nMediación con burros / Paseos adaptados para TODOS con burros.\r\nJuego de Rastreo, Juego de Escape al aire libre.\r\nShiatsu"
    ]
  },
