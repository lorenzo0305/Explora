  "rdfs:comment": {
    "de": [
      "Die Herausforderung? Ein Design ohne Abfall! Die Schülerinnen und Schüler der Gymnasien Pierre-Joël Bonté und Marie-Laurencin in Riom haben sie mit Bravour gemeistert, indem sie gemeinsam mit dem Designer Pierre Ménard aus Clermont-Ferrand Module für den Empfang von RLV Info Jeunes entworfen haben."
    ],
    "en": [
      "The challenge? Zero waste design! Students from Riom?s Pierre-Joël Bonté and Marie-Laurencin high schools brilliantly met the challenge, designing modules for the RLV Info Jeunes reception area with Clermont-Ferrand designer Pierre Ménard."
    ],
    "it": [
      "La sfida? Progettare a rifiuti zero! Gli studenti delle scuole secondarie Pierre-Joël Bonté e Marie-Laurencin di Riom hanno raccolto la sfida, progettando moduli per l'area di accoglienza di RLV Info Jeunes con il designer Pierre Ménard di Clermont-Ferrand."
    ],
    "fr": [
      "Le défi ? Un design zéro déchet ! Les élèves des lycées Pierre-Joël Bonté et Marie-Laurencin de Riom l’ont brillamment relevé en concevant des modules pour l’accueil de RLV Info Jeunes avec le designer clermontois Pierre Ménard."
    ],
    "es": [
      "¿El reto? Diseñar con cero residuos Los alumnos de los institutos Pierre-Joël Bonté y Marie-Laurencin de Riom han aceptado el reto, diseñando módulos para la zona de recepción de RLV Info Jeunes con el diseñador de Clermont-Ferrand Pierre Ménard."
    ],
    "nl": [
      "De uitdaging? Ontwerp zonder afval! Leerlingen van de middelbare scholen Pierre-Joël Bonté en Marie-Laurencin in Riom zijn de uitdaging aangegaan en hebben samen met Pierre Ménard, ontwerper uit Clermont-Ferrand, modules ontworpen voor de ontvangstruimte van RLV Info Jeunes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Design durable"
    ]
  },
