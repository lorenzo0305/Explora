  "rdfs:comment": {
    "de": [
      "Das Bistrot La Botte ist die unumgängliche Adresse, um italienische Spezialitäten zu probieren und ein Gläschen Wein zu trinken. Ein noch nie dagewesener Ort, in dem sich Geselligkeit mit einem beeindruckenden Weinkeller vereint!"
    ],
    "en": [
      "Le Bistrot de la Botte is the place to be right now if you want to enjoy Italian specialities and drink a glass of wine. An unusual location where conviviality goes hand-in-hand with an impressive cellar!"
    ],
    "it": [
      "Le Bistrot de la Botte è l'indirizzo imprescindibile del momento per gustare specialità italiane e bere un bicchiere di vino. Un luogo originale dove l'allegria si sposa con una cantina impressionante!"
    ],
    "fr": [
      "Le Bistrot de la Botte c'est l'adresse incontournable du moment pour déguster des spécialités italiennes et boire un verre de vin. Un lieu inédit où la convivialité se marie avec une impressionnante cave !"
    ],
    "nl": [
      "In de Bistrot de la Botte kunt u terecht voor Italiaanse specialiteiten en een glas wijn. Een unieke plek waar gezelligheid wordt gecombineerd met een indrukwekkende kelder!"
    ],
    "es": [
      "El Bistrot de la Botte es el lugar al que hay que ir para degustar especialidades italianas y una copa de vino. Un lugar único donde la convivencia se combina con una impresionante bodega"
    ]
  },
