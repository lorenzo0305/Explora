  "rdfs:comment": {
    "de": [
      "Willkommen im Gofun Center, einem Ort, an dem Unterhaltung auf Geselligkeit trifft, im Süden der Drôme!\r\nWir bieten Ihnen ein einzigartiges Erlebnis, das Quiz, Blindtest und Karaoke in einer warmen und festlichen Atmosphäre bei einem Drink an der Bar kombiniert."
    ],
    "en": [
      "Welcome to Gofun Center, where entertainment meets conviviality in the South Drôme!\r\nWe offer you a unique experience combining quiz, blindtest and karaoke in a warm, festive atmosphere over a drink at the bar."
    ],
    "it": [
      "Benvenuti al Gofun Center, il luogo dove il divertimento incontra la convivialità nella Drôme meridionale!\r\nVi offriamo un'esperienza unica che combina quiz, blindtest e karaoke in un'atmosfera calda e festosa davanti a un drink al bar."
    ],
    "fr": [
      "Bienvenue à Gofun Center, lieu où le divertissement rencontre la convivialité dans le Sud Drôme !\r\nNous vous offrons une expérience unique combinant quiz, blindtest et karaoké dans une ambiance chaleureuse et festive autour d'un verre à prendre au bar."
    ],
    "nl": [
      "Welkom bij Gofun Center, de plek waar entertainment en gezelligheid elkaar ontmoeten in de Zuid-Drôme!\r\nWij bieden u een unieke ervaring die quiz, blindtest en karaoke combineert in een warme en feestelijke sfeer onder het genot van een drankje aan de bar."
    ],
    "es": [
      "Bienvenido a Gofun Center, el lugar donde el entretenimiento se une a la convivencia en el sur de Drôme\r\nLe ofrecemos una experiencia única combinando quiz, blindtest y karaoke en un ambiente cálido y festivo tomando una copa en el bar."
    ]
  },
  "rdfs:label": {
