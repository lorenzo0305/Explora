  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/845dd9ee-7c2a-377d-94f4-6ccc8c08af45",
      "dc:description": {
        "de": [
          "Anhand von Berichten über reale und imaginäre Reisen sowie wissenschaftlichen und esoterischen Texten aus dem Mittelalter entdecken wir die enge Verbindung zwischen fantastischen Kreaturen und Magie."
        ],
        "en": [
          "Through tales of real and imaginary journeys, as well as scientific and esoteric texts from the Middle Ages, we discover the close links between fantastic creatures and magic."
        ],
        "it": [
          "Attraverso i racconti di viaggi reali e immaginari e i testi scientifici ed esoterici del Medioevo, scopriamo lo stretto legame tra creature fantastiche e magia."
        ],
        "fr": [
          "Grâce aux récits de voyages réels et imaginaires et aux textes scientifiques et ésotériques du Moyen Âge, découvrons les liens étroits entre les créatures fantastiques et la magie."
        ],
        "nl": [
          "Aan de hand van verslagen van echte en denkbeeldige reizen en wetenschappelijke en esoterische teksten uit de Middeleeuwen ontdekken we de nauwe banden tussen fantastische wezens en magie."
        ],
        "es": [
          "A través de relatos de viajes reales e imaginarios y de textos científicos y esotéricos de la Edad Media, descubrimos los estrechos vínculos existentes entre las criaturas fantásticas y la magia."
        ]
      },
      "@type": [
        "Description"
