  "rdfs:comment": {
    "de": [
      "Herstellung einer Kerze aus Pflanzenwachs und eines dekorativen Elements. Parallel dazu ein handwerkliches Atelier (bis das Wachs gefroren ist). Für 7/11-Jährige."
    ],
    "en": [
      "Production of a plant wax candle and decorative element. Manual workshop at the same time (until the wax sets). Materials supplied. For 7/11 year-olds."
    ],
    "it": [
      "Realizzazione di una candela di cera vegetale e di un elemento decorativo. Laboratorio manuale in contemporanea (fino a quando la cera non si sarà solidificata). Materiale fornito. Per bambini di 7/11 anni."
    ],
    "fr": [
      "Fabrication d’une bougie en cire végétale et élément décoratif. Atelier Manuel en parallèle (le temps que la cire fige) Matériel fourni. Pour les 7/11 ans."
    ],
    "es": [
      "Elaboración de una vela de cera vegetal y elemento decorativo. Taller manual al mismo tiempo (hasta que la cera haya fraguado). Materiales proporcionados. Para niños de 7/11 años."
    ],
    "nl": [
      "Een plantaardige waskaars en decoratief element maken. Handmatige workshop op hetzelfde moment (totdat de was is uitgehard). Materialen aanwezig. Voor kinderen van 7/11 jaar."
    ]
  },
