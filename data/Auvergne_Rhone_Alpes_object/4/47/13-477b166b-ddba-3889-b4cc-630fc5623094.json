  "rdfs:comment": {
    "de": [
      "Probieren Sie unsere hausgemachten Spezialitäten aus der Auvergne: Eintopf, Trüffel, Tartiflette und Saint-Nectairade. Hausgemachte Desserts zu jeder Stunde, aber auch unsere hausgemachten Crêpes von 16 bis 18 Uhr."
    ],
    "en": [
      "Restaurant-bar-brasserie : potée, truffade, saint-nectairade, pounti auvergnat, tartiflette auvergnate."
    ],
    "it": [
      "Venite a provare le nostre specialità d'Alvernia fatte in casa: potée, truffade, tartiflette e Saint-Nectairade. I dessert fatti in casa sono sempre disponibili, così come le nostre crêpes fatte in casa dalle 16.00 alle 18.00."
    ],
    "fr": [
      "Venez déguster nos spécialités auvergnates faits maison : potée, truffade, tartiflette et Saint-Nectairade. Desserts maison à toute heure mais aussi nos crêpes maison faites minute de 16h à 18h."
    ],
    "es": [
      "Venga a degustar nuestras especialidades caseras de Auvernia: potée, truffade, tartiflette y Saint-Nectairade. Los postres caseros están disponibles a todas horas, al igual que nuestras crêpes caseras de 16:00 a 18:00."
    ],
    "nl": [
      "Kom proeven van onze huisgemaakte specialiteiten uit de Auvergne: potée, truffade, tartiflette en Saint-Nectairade. Huisgemaakte desserts zijn altijd verkrijgbaar, net als onze huisgemaakte crêpes van 16.00 tot 18.00 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Français"
    ]
  },
