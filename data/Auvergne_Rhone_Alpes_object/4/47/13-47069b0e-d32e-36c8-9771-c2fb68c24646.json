  "rdfs:comment": {
    "de": [
      "Laurine de la Fée Nelda empfängt Sie von Dienstag bis Samstag in ihrem hübschen Laden! Ihre Kreationen werden auf umweltfreundliche Weise von einem kleinen Unternehmen hergestellt, einer thailändischen Familie, der Mutter und der Tochter."
    ],
    "en": [
      "Laurine de la Fée Nelda welcomes you to her pretty store from Tuesday to Saturday! Her creations are created in an eco-responsible way by a small company in particular, a Thai family, Mother and Daughter."
    ],
    "it": [
      "Laurine di La Fée Nelda vi accoglie dal martedì al sabato nel suo grazioso negozio! Le sue creazioni sono realizzate in modo eco-responsabile da una piccola azienda, una famiglia tailandese, madre e figlia."
    ],
    "fr": [
      "Laurine de la Fée Nelda vous accueille du mardi au samedi dans son joli magasin! Ses créations sont créées de manière éco-responsable par une petite entreprise plus particulièrement, une famille thaïlandaise, la Mère et la Fille."
    ],
    "nl": [
      "Laurine van La Fée Nelda heet je van dinsdag tot en met zaterdag welkom in haar mooie winkel! Haar creaties worden op een ecologisch verantwoorde manier gemaakt door een klein bedrijfje in het bijzonder, een Thaise familie, de Moeder en Dochter."
    ],
    "es": [
      "Laurine de la Fée Nelda te recibe de martes a sábado en su bonita tienda Sus creaciones son creadas de forma eco-responsable por una pequeña empresa, una familia tailandesa, la madre y la hija."
    ]
  },
