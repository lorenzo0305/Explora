  "rdfs:comment": {
    "de": [
      "Das Stadion Charles Mathon, das der Haut-Bugey Agglomération gehört, ist eine öffentliche Einrichtung im Freien, die bis zu 11.400 Personen aufnehmen kann, davon 10.230 Sitzplätze."
    ],
    "en": [
      "Owned by Haut-Bugey Agglomération, the Charles Mathon stadium is an open-air facility that can accommodate up to 11,400 people, including 10,230 seats."
    ],
    "it": [
      "Di proprietà dell'Haut-Bugey Agglomération, lo stadio Charles Mathon è un impianto all'aperto che può ospitare fino a 11.400 persone, di cui 10.230 posti a sedere."
    ],
    "fr": [
      "Propriété de Haut-Bugey Agglomération, le stade Charles Mathon est un établissement recevant du public de plein air pouvant accueillir jusqu’à 11 400 personnes, dont 10 230 places assises."
    ],
    "es": [
      "Propiedad de Haut-Bugey Agglomération, el estadio Charles Mathon es una instalación al aire libre con capacidad para 11.400 personas, de las cuales 10.230 son asientos."
    ],
    "nl": [
      "Het stadion Charles Mathon is eigendom van de agglomeratie Haut-Bugey en is een openluchtfaciliteit die plaats biedt aan 11.400 mensen, waarvan 10.230 zitplaatsen."
    ]
  },
