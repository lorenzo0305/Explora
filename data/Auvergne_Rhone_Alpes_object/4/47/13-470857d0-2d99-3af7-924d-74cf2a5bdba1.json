  "rdfs:comment": {
    "de": [
      "Die Goldschmiedin Julie Bonaldi bietet Ihnen die Möglichkeit, Ihr eigenes Schmuckstück herzustellen (Dauer: 2,5 Stunden)!\r\n\r\nWorkshop für Jugendliche oder Erwachsene, Anmeldung erforderlich (per E-Mail oder Telefon)."
    ],
    "en": [
      "Julie Bonaldi, jeweller, invites you to create your own piece of jewelry (duration: 2h30)!\r\n\r\nWorkshop for teens or adults, registration required (by e-mail or telephone)."
    ],
    "it": [
      "Julie Bonaldi, gioielliera, vi aiuterà a creare il vostro gioiello (durata: 2h30)!\r\n\r\nLaboratorio per adolescenti o adulti, con iscrizione obbligatoria (via e-mail o telefono)."
    ],
    "fr": [
      "Julie Bonaldi, bijoutière, vous propose de réaliser votre bijou (durée : 2h30) !\r\n\r\nAtelier ado ou adulte, sur inscription obligatoire (par e-mail ou téléphone)."
    ],
    "nl": [
      "Julie Bonaldi, juwelier, helpt je bij het maken van je eigen sieraad (duur: 2u30)!\r\n\r\nWorkshop voor tieners of volwassenen, inschrijving verplicht (per e-mail of telefoon)."
    ],
    "es": [
      "Julie Bonaldi, joyera, le ayudará a crear su propia joya (duración: 2h30)\r\n\r\nTaller para adolescentes o adultos, inscripción obligatoria (por correo electrónico o teléfono)."
    ]
  },
