  "rdfs:comment": {
    "de": [
      "Die 1878 erbaute Kirche Saint-Didier ist eine Erweiterung des bestehenden Heiligtums, das im 17. Jahrhundert repariert worden war und dessen Ursprung auf das 16. oder 17. Jahrhundert zurückgeht."
    ],
    "en": [
      "Built in 1878, the church of Saint-Didier is an extension of the existing sanctuary which had been repaired in the 17th century and whose origin dates back to the 16th or 17th century."
    ],
    "it": [
      "Costruita nel 1878, la chiesa di Saint-Didier è un'estensione del santuario esistente, che è stato riparato nel XVII secolo e la cui origine risale al XVI o XVII secolo."
    ],
    "fr": [
      "Construite en 1878, l'église Saint-Didier est une extension du sanctuaire existant qui avait été réparé au XVIIème siècle et dont l'origine remonte au XVIème ou XVIIème siècle."
    ],
    "nl": [
      "De kerk van Saint-Didier, gebouwd in 1878, is een uitbreiding van het bestaande heiligdom, dat in de 17e eeuw werd hersteld en waarvan de oorsprong teruggaat tot de 16e of 17e eeuw."
    ],
    "es": [
      "Construida en 1878, la iglesia de Saint-Didier es una ampliación del santuario existente, que fue reparado en el siglo XVII y cuyo origen se remonta a los siglos XVI o XVII."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Didier"
    ]
  },
