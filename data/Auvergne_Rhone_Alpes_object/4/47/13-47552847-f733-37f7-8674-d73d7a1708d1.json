  "rdfs:comment": {
    "de": [
      "Bergrestaurant an der Talstation des Sessellifts Plein Soleil.\r\nTraditionelle und savoyische Küche, frische Produkte aus der Region. Große, sonnige Südterrasse in ruhiger Lage."
    ],
    "en": [
      "High altitude restaurant located at the departure of the Plein Soleil chairlift.\r\nTraditional and Savoyard cuisine, fresh products from the region. Large sunny terrace facing south in a quiet area."
    ],
    "it": [
      "Ristorante d'alta quota situato alla partenza della seggiovia Plein Soleil.\r\nCucina tradizionale e savoiarda, prodotti freschi regionali. Ampia terrazza soleggiata esposta a sud in una zona tranquilla."
    ],
    "fr": [
      "Restaurant d’altitude situé au départ du télésiège de Plein Soleil.\r\nCuisine traditionnelle et savoyarde, produits frais de région. Grande terrasse ensoleillée plein sud au calme."
    ],
    "es": [
      "Restaurante de altura situado al inicio del telesilla Plein Soleil.\r\nCocina tradicional y saboyana, productos frescos de la región. Gran terraza soleada orientada al sur en una zona tranquila."
    ],
    "nl": [
      "Hooggelegen restaurant aan het begin van de stoeltjeslift Plein Soleil.\r\nTraditionele en Savoyaardse keuken, verse regionale producten. Groot zonnig terras op het zuiden in een rustige omgeving."
    ]
  },
