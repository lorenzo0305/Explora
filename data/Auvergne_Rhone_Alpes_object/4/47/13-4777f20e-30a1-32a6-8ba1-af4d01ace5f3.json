  "rdfs:comment": {
    "de": [
      "Willkommen im Barouf, dem brandneuen Bar-Restaurant, das das Zentrum von Vienne zum Beben bringt! Hier ist alles darauf ausgerichtet, gute Momente zu teilen: hausgemachte und herzhafte Küche am Mittag und eine entspannte und festliche Atmosphäre am Abend!"
    ],
    "en": [
      "Welcome to Le Barouf, the brand-new bar-restaurant that's got Vienna's city center buzzing! Here, everything is designed for sharing good times: hearty, home-cooked food at lunchtime, and a relaxed, festive atmosphere in the evening!"
    ],
    "it": [
      "Benvenuti a Le Barouf, il nuovissimo bar-ristorante che sta animando il centro di Vienne! L'obiettivo è quello di condividere i bei momenti: un'abbondante cucina casalinga a pranzo e un'atmosfera rilassata e festosa la sera!"
    ],
    "fr": [
      "Bienvenue au Barouf, le tout nouveau bar restaurant qui fait vibrer le centre de Vienne ! Ici, tout est pensé pour partager de bons moments : une cuisine maison et copieuse le midi, et une ambiance décontractée et festive le soir !"
    ],
    "nl": [
      "Welkom bij Le Barouf, het gloednieuwe bar-restaurant dat het centrum van Vienne in een stroomversnelling brengt! Hier draait alles om gezelligheid: 's middags een stevige maaltijd en 's avonds een ontspannen en feestelijke sfeer!"
    ],
    "es": [
      "Bienvenido a Le Barouf, el nuevo bar-restaurante que anima el centro de Vienne Se trata de compartir buenos momentos: comida casera al mediodía y un ambiente relajado y festivo por la noche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Restaurant Le Barouf"
    ]
  },
