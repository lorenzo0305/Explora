  "rdfs:comment": {
    "de": [
      "Im Herzen des Beaufortain, verbunden mit Les Saisies, befindet sich Ihr traditionsreiches Hotel-Chalet mit 8 Zimmern, 4 Suiten und einer großen Suite (= 13 Zimmer). Beheizter Außenpool, Jacuzzi, Sauna, Dampfbad, Massagen und ein gutes Restaurant, um sich mit Blick auf den Mont Blanc zu verwöhnen."
    ],
    "en": [
      "In the heart of Beaufortain, connected to Les Saisies, your Traditional Hotel-Chalet with 8 rooms, 4 suites and a grand suite in the mountains. Heated outdoor swimming pool, jacuzzi, sauna, hammam, massages and a good \"Maître Restaurateur\" table to enjoy facing Mont Blanc."
    ],
    "it": [
      "Nel cuore del Beaufortain, collegato a Les Saisies, il tuo Hotel-Chalet Tradizionale con 8 camere,  4 suite e una grande suite in montagna. Piscina esterna riscaldata, jacuzzi, sauna, hammam, massaggi e un buon tavolo \"Maître Restaurateur\" da godere di fronte al Monte Bianco."
    ],
    "fr": [
      "Au cœur du Beaufortain, relié aux Saisies, votre Hôtel-Chalet de Tradition de 8 chambres, 4 suites et une grande suite (= 13 chambres). Piscine extérieure chauffée, jacuzzi, sauna, hammam, massages et une bonne table pour se régaler face au Mont Blanc."
    ],
    "nl": [
      "In het hart van Beaufortain, verbonden met Les Saisies, uw traditionele hotel-chalet met 8 kamers, 4 suites en een grote suite in de bergen. Verwarmd buitenzwembad, jacuzzi, sauna, hamam, massages en een goede \"Maître Restaurateur\" tafel om van te genieten met uitzicht op de Mont Blanc."
    ],
    "es": [
      "En el corazón del Beaufortain, unido a Les Saisies, su tradicional Hôtel-Chalet con 8 habitaciones, 4 suites y una gran suite (= 13 habitaciones). Piscina exterior climatizada, jacuzzi, sauna, hammam, masajes y una exquisita gastronomía con vistas al Mont Blanc."
    ]
  },
  "rdfs:label": {
