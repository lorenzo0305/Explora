  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, am Fuße des Stadtmauergürtels von Laon unter Bäumen frische Luft zu schnappen und die Natur zu feiern?"
    ],
    "en": [
      "Want a breath of fresh air at the foot of the ramparts of Laon, under the shelter of the trees to celebrate nature?"
    ],
    "it": [
      "Avete voglia di una boccata d'aria fresca ai piedi dei bastioni di Laon, al riparo degli alberi per celebrare la natura?"
    ],
    "fr": [
      "Envie d'un bon bol d'air au pied de la ceinture des remparts de Laon, à l'abri des arbres pour fêter la nature ?"
    ],
    "es": [
      "¿Le apetece respirar aire puro al pie de las murallas de Laon, al abrigo de los árboles para celebrar la naturaleza?"
    ],
    "nl": [
      "Zin in een frisse neus aan de voet van de wallen van Laon, onder de beschutting van de bomen om de natuur te vieren?"
    ]
  },
