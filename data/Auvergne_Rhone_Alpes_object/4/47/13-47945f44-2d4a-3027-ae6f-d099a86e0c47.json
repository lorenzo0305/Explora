  "rdfs:comment": {
    "de": [
      "Der Verein betreibt diesen Ort, der der bildenden Kunst gewidmet ist, mit einer Dauerausstellung sowie einer Artothek und einer Fachbibliothek.\r\nJeden Monat findet eine temporäre Ausstellung eines professionellen Künstlers statt."
    ],
    "en": [
      "The association manages this permanent exhibition space dedicated to the plastic arts as well as an art library and a specialized library.\r\nA temporary exhibition takes place every month of a professional artist."
    ],
    "it": [
      "L'associazione gestisce questo spazio espositivo permanente dedicato alle arti visive, nonché una biblioteca d'arte e una biblioteca specializzata.\r\nOgni mese si tiene una mostra temporanea di un artista professionista."
    ],
    "fr": [
      "L'association gère ce lieu d'exposition permanente consacré aux arts plastiques ainsi qu'une artothèque et une bibliothèque spécialisée.\r\nUne exposition temporaire a lieu chaque mois d'un artiste professionnel."
    ],
    "es": [
      "La asociación gestiona este espacio de exposición permanente dedicado a las artes visuales, así como una biblioteca de arte y una biblioteca especializada.\r\nCada mes tiene lugar una exposición temporal de un artista profesional."
    ],
    "nl": [
      "De vereniging beheert deze permanente tentoonstellingsruimte gewijd aan de beeldende kunst, evenals een kunstbibliotheek en een gespecialiseerde bibliotheek.\r\nElke maand is er een tijdelijke tentoonstelling van een professionele kunstenaar."
    ]
  },
  "rdfs:label": {
