  "rdfs:comment": {
    "de": [
      "Holz, das von den Händen des Holzdrehers Simon hervorragend bearbeitet wird.\r\nSimon bietet Ihnen mittwochs kostenlose Vorführungen an und öffnet seinen Ausstellungsraum täglich für Sie."
    ],
    "en": [
      "Exquisite craftmanship from Simon the wood turner\r\nSimon proposes free demonstrations and opens his exhibition room during school holidays.\r\nShop.\r\nGroup on request."
    ],
    "it": [
      "Le abilità di Simon nella tornitura del legno sono eccezionali.\r\nSimon offre dimostrazioni gratuite il mercoledì e apre il suo showroom tutti i giorni."
    ],
    "fr": [
      "Le bois remarquablement travaillé par les mains de Simon, tourneur sur bois.\r\nSimon vous propose des démonstrations gratuites le Mercredi et vous ouvre sa salle d'exposition tous les jours."
    ],
    "nl": [
      "Simons vaardigheden als houtdraaier zijn uitstekend.\r\nSimon geeft gratis demonstraties op woensdag en is elke dag open in zijn showroom."
    ],
    "es": [
      "Las habilidades de Simon para tornear madera son excepcionales.\r\nSimon ofrece demostraciones gratuitas los miércoles y abre su sala de exposiciones todos los días."
    ]
  },
