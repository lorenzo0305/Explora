  "rdfs:comment": {
    "de": [
      "Machen Sie eine Pause... L'Horloge Gourmande, vor den Toren des Südens, bietet Ihnen die Möglichkeit, die Zeit für eine Mahlzeit, eine Nacht... anzuhalten."
    ],
    "en": [
      "For a break or a whole stay in Drome Provençale, come and enjoy the shade of cedars, the tasty cooking and warm atmosphere."
    ],
    "it": [
      "Fare una pausa? L'Horloge Gourmande, alle porte del Sud, vi propone di fermare il tempo per un pasto, una serata?"
    ],
    "fr": [
      "Faites une pause… L’Horloge Gourmande, aux portes du Sud, vous propose d’arrêter le temps pour un repas, une nuit…"
    ],
    "es": [
      "¿Tomar un descanso? L'Horloge Gourmande, a las puertas del Sur, le ofrece detener el tiempo para una comida, una noche.."
    ],
    "nl": [
      "Neem een pauze... L'Horloge Gourmande, aan de poort naar het zuiden, nodigt u uit om de tijd te stoppen voor een maaltijd, een nacht..."
    ]
