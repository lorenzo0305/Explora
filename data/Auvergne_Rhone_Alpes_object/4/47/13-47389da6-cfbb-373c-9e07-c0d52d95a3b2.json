  "rdfs:comment": {
    "de": [
      "Im Restaurant mit Panoramablick können Sie die Familienküche entdecken und die regionalen Spezialitäten probieren: Punti, Tripoux, Auvergne-Eintopf, Trüffel, Entrecôte mit Auvergne-Blaukäse. Mittags und abends geöffnet, außer im Juli und August nur abends"
    ],
    "en": [
      "The restaurant, with its panoramic view, serves family-style cuisine and regional specialties such as pounti, tripoux, potée auvergnate, truffade and entrecôte au bleu d'Auvergne. Open for lunch and dinner, except July and August evenings only."
    ],
    "it": [
      "Nel ristorante, con vista panoramica, potrete gustare la cucina casalinga e le specialità regionali come pounti, tripoux, potée auvergnate, truffade ed entrecôte au bleu d'Auvergne. Aperto a pranzo e a cena, tranne le sere di luglio e agosto"
    ],
    "fr": [
      "Le restaurant avec vue panoramique vous fera découvrir sa cuisine familiale et déguster les spécialités régionales : pounti, tripoux, potée auvergnate, truffade, entrecôte au bleu d'Auvergne. Ouvert midi et soir , sauf juillet et aout le soir uniquement"
    ],
    "nl": [
      "In het restaurant, met panoramisch uitzicht, kun je genieten van huisgemaakte gerechten en regionale specialiteiten zoals pounti, tripoux, potée auvergnate, truffade en entrecôte au bleu d'Auvergne. Open voor lunch en diner, behalve 's avonds in juli en augustus"
    ],
    "es": [
      "En el restaurante, con vistas panorámicas, podrá degustar cocina casera y especialidades regionales como pounti, tripoux, potée auvergnate, truffade y entrecôte au bleu d'Auvergne. Abierto para almuerzos y cenas, excepto las noches de julio y agosto."
    ]
  },
