  "rdfs:comment": {
    "de": [
      "Die Art Gallery zeigt eine Auswahl der reichen und vielfältigen Arbeit des Künstlers INIS. Auf drei Etagen können Sie die Arbeit dieses facettenreichen Künstlers (Malerei, Skulptur...) entdecken."
    ],
    "en": [
      "The \"Art Gallery\" presents a selection of the rich and varied work of the artist INIS. On three floors, come and discover the work of this multi-faceted artist (painting, sculpture...)."
    ],
    "it": [
      "La Galleria d'Arte presenta una selezione del ricco e variegato lavoro dell'artista INIS. Su tre piani, venite a scoprire le opere di questo artista poliedrico (pittura, scultura...)."
    ],
    "fr": [
      "L'Art Gallery présente une sélection du travail riche et varié de l'artiste INIS. Sur trois étages, venez découvrir le travail de cet artiste multi-facettes (peinture, sculpture...)."
    ],
    "es": [
      "La Galería de Arte presenta una selección de la rica y variada obra del artista INIS. En tres plantas, venga a descubrir la obra de este artista polifacético (pintura, escultura...)."
    ],
    "nl": [
      "De Art Gallery presenteert een selectie van het rijke en gevarieerde werk van de kunstenaar INIS. Kom op drie verdiepingen het werk van deze veelzijdige kunstenaar ontdekken (schilderen, beeldhouwen...)."
    ]
  },
