  "rdfs:comment": {
    "de": [
      "Chez Alex empfängt Sie in einer warmen und freundlichen Umgebung. Unsere Pizzeria liegt mitten im Stadtzentrum und ist der ideale Ort, um mit Freunden, der Familie oder Kollegen ein Essen mit authentischen und großzügigen Rezepten zu genießen!"
    ],
    "en": [
      "Chez Alex welcomes you in a warm and friendly atmosphere. Located right in the center of town, our pizzeria is the ideal place to share a meal with friends, family or colleagues, around authentic and generous recipes!"
    ],
    "it": [
      "Chez Alex offre un'accoglienza calorosa e amichevole. Situata in pieno centro, la nostra pizzeria è il luogo ideale per condividere un pasto con amici, familiari o colleghi, a base di ricette autentiche e generose!"
    ],
    "fr": [
      "Chez Alex vous accueille dans un cadre chaleureux et convivial. Située en plein centre-ville, notre pizzeria est le lieu idéal pour partager un repas entre amis, en famille ou entre collègues, autour de recettes authentiques et généreuses !"
    ],
    "es": [
      "Chez Alex le ofrece una cálida y amistosa bienvenida. Situada en pleno centro de la ciudad, nuestra pizzería es el lugar ideal para compartir una comida con amigos, familia o compañeros de trabajo, ¡a base de recetas auténticas y generosas!"
    ],
    "nl": [
      "Chez Alex biedt een warm en vriendelijk onthaal. Onze pizzeria ligt in het centrum van de stad en is de ideale plek om een maaltijd te delen met vrienden, familie of collega's, op basis van authentieke en royale recepten!"
    ]
  },
