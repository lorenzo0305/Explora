  "rdfs:comment": {
    "de": [
      "Von den keltischen Galliern bis zu den Arbeiterbauern erzählt dieser Rundgang die Geschichte von Pont-de-Barret. Ein hochgelegenes Dorf, das durch einen großen Zeugen seiner Geschichte vereint wird: die alte Brücke."
    ],
    "en": [
      "From the Celtic Gauls to the working peasants, this visit retraces the history of Pont-de-Barret. A perched village unified by a great witness of its history: the old bridge."
    ],
    "it": [
      "Dai Galli Celti ai contadini della classe operaia, questo tour ripercorre la storia di Pont-de-Barret. Un villaggio arroccato unificato da una grande testimonianza della sua storia: il vecchio ponte."
    ],
    "fr": [
      "Dès Gaulois celtes aux paysans.es ouvrièrs.es , cette visite retrace l’histoire de Pont-de-Barret. Un village perché unifié par un grand témoin de son histoire : Le vieux pont."
    ],
    "nl": [
      "Van de Keltische Galliërs tot de boeren uit de arbeidersklasse, deze tocht schetst de geschiedenis van Pont-de-Barret. Een hooggelegen dorp verenigd door een grote getuige van zijn geschiedenis: de oude brug."
    ],
    "es": [
      "Desde los celtas galos hasta los campesinos de la clase obrera, este recorrido recorre la historia de Pont-de-Barret. Un pueblo encaramado y unificado por un gran testigo de su historia: el viejo puente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée de Pont de Barret"
    ]
  },
