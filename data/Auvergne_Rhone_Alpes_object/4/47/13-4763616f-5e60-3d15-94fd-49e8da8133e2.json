  "rdfs:comment": {
    "de": [
      "Im Herzen von Monistrol bieten Ihnen Robin Carrot und sein Bruder Tom eine einzigartige Küche. Ein kulinarisches Erlebnis, um eine zeitgenössische Küche zu probieren. Reservierung empfohlen."
    ],
    "en": [
      "In the heart of Monistrol, Robin Carrot and his brother Tom offer a unique cuisine. A culinary experience for a taste of contemporary cuisine. Reservations recommended."
    ],
    "it": [
      "Nel cuore del Monistrol, Robin Carrot e suo fratello Tom propongono una cucina unica. Un'esperienza culinaria per assaggiare la cucina contemporanea. Si consiglia la prenotazione."
    ],
    "fr": [
      "En plein cœur de Monistrol, Robin Carrot et son frère Tom vous proposent une cuisine singulière. Une expérience culinaire pour goûter une cuisine contemporaine. Réservation conseillée."
    ],
    "nl": [
      "In het hart van Monistrol bieden Robin Carrot en zijn broer Tom een unieke keuken. Een culinaire ervaring om de hedendaagse keuken te proeven. Reserveren aanbevolen."
    ],
    "es": [
      "En el corazón de Monistrol, Robin Carrot y su hermano Tom ofrecen una cocina única. Una experiencia culinaria para degustar la cocina contemporánea. Se recomienda reservar."
    ]
  },
  "rdfs:label": {
