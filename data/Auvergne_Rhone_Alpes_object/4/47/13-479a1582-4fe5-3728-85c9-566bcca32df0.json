  "rdfs:comment": {
    "de": [
      "Komfortables Kino mit 3 Sälen, das ein vielfältiges und abwechslungsreiches Programm anbietet:\r\n- filme für das breite Publikum einerseits\r\n- filme aus der Vielfalt des Filmangebots andererseits, die von der Vereinigung Cinétoiles zusammengestellt werden"
    ],
    "en": [
      "A comfortable cinema with three theatres offering a diverse and varied range of programming:\r\n- mainstream films on the one hand\r\n- film from the diversity of the film offering on the other hand, brought by the association Cinétoiles"
    ],
    "it": [
      "Un confortevole cinema a 3 schermi che offre un programma vario e diversificato:\r\n- film mainstream da un lato\r\n- film provenienti dalla diversità dell'industria cinematografica, dall'altra parte, portati dall'associazione Cinétoiles"
    ],
    "fr": [
      "Cinéma grand confort de 3 salles proposant une programmation diverse et variée :\r\n- de films grand public d'une part\r\n- de film provenant de la diversité de l'offre cinématographique d'autre part, amenée par l'association Cinétoiles"
    ],
    "es": [
      "Un cómodo cine de 3 pantallas que ofrece una programación diversa y variada:\r\n- las películas convencionales, por un lado\r\n- películas de la diversidad de la industria cinematográfica, por otro lado, aportadas por la asociación Cinétoiles"
    ],
    "nl": [
      "Een comfortabele bioscoop met 3 zalen met een gevarieerd programma:\r\n- mainstream films enerzijds\r\n- films uit de diversiteit van de filmindustrie anderzijds, ingebracht door de vereniging Cinétoiles"
    ]
  },
  "rdfs:label": {
