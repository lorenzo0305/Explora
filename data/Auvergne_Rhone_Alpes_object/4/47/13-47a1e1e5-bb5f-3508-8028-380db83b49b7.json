  "rdfs:comment": {
    "de": [
      "Im Herzen von Montluçon und nur wenige Schritte von der mittelalterlichen Stadt entfernt bietet die Käserei \"Le Comptoir aux Fromages\" eine der besten Auswahlen an Käsesorten von hier und anderswo."
    ],
    "en": [
      "In the heart of Montluçon, just a stone?s throw from the medieval city, the creamery and cheese dairy \"Le Comptoir aux Fromages\" offers one of the best selections of cheeses from here and abroad."
    ],
    "it": [
      "Nel cuore di Montluçon, a pochi passi dalla città medievale, la cremeria e il caseificio \"Le Comptoir aux Fromages\" offrono una delle migliori selezioni di formaggi provenienti da qui e dall'estero."
    ],
    "fr": [
      "Au coeur de Montluçon et à deux pas de la cité médiévale, la crémerie-fromagerie « Le Comptoir aux Fromages » propose l’une des meilleures sélections de fromages d’ici et d’ailleurs."
    ],
    "nl": [
      "In het hart van Montluçon, op een steenworp afstand van de middeleeuwse stad, biedt de zuivelfabriek en kaasmakerij \"Le Comptoir aux Fromages\" een van de beste selecties kazen uit binnen- en buitenland."
    ],
    "es": [
      "En el corazón de Montluçon, a dos pasos de la ciudad medieval, la cremería y quesería \"Le Comptoir aux Fromages\" ofrece una de las mejores selecciones de quesos de aquí y del extranjero."
    ]
  },
  "rdfs:label": {
