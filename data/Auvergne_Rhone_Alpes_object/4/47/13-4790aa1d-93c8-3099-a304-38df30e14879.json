  "rdfs:comment": {
    "de": [
      "Indisches Restaurant, das jeden Tag geöffnet ist und Ihnen Spezialitäten des Landes anbietet.\r\nVerschiedene traditionelle Gerichte wie Chicken Tikka Masala, Kofta Tandoori, Cheese Nan.\r\nService, der auf den Kunden eingeht und immer nach seinen Wünschen handelt."
    ],
    "en": [
      "Indian restaurant open every day, serving local specialties.\r\nTraditional dishes such as chicken tikka masala, kofta tandoori and cheese nan.\r\nCustomer-focused service, always according to your wishes."
    ],
    "it": [
      "Ristorante indiano aperto tutti i giorni, che serve specialità locali.\r\nVari piatti tradizionali come pollo tikka masala, kofta tandoori e cheese nan.\r\nServizio che ascolta ogni desiderio del cliente."
    ],
    "fr": [
      "Restaurant indien ouvert tous les jours et qui vous propose des spécialités du pays.\r\nDifférents plats traditionnels tel que le poulet tikka masala, le kofta tandoori, le cheese nan. \r\nService à l'écoute du client, toujours selon ses désirs."
    ],
    "es": [
      "Restaurante indio abierto todos los días, que sirve especialidades locales.\r\nVarios platos tradicionales como pollo tikka masala, kofta tandoori y nan de queso.\r\nServicio atento a todos los deseos del cliente."
    ],
    "nl": [
      "Indiaas restaurant dat elke dag open is en lokale specialiteiten serveert.\r\nVerschillende traditionele gerechten zoals kip tikka masala, kofta tandoori en kaas nan.\r\nService die luistert naar elke wens van de klant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Taj Mahal"
    ]
  },
