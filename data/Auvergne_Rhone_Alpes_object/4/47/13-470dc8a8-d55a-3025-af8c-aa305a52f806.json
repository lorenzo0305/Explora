  "rdfs:comment": {
    "de": [
      "Der 2008 bei der Gestaltung des Viertels Saint-Martin (2000-2011) geschaffene Jardin des senteurs bietet im Herzen der Stadt ein bukolisches Erlebnis mit den Düften der Provence. Fokus-Tour vom Bauprojekt bis zum botanischen Aspekt."
    ],
    "en": [
      "Created in 2008 during the redevelopment of the Saint-Martin district (2000-2011), the garden of scents offers a bucolic experience with the scents of Provence in the heart of the city. Focus on the botanical aspects of the construction project."
    ],
    "it": [
      "Creato nel 2008 durante la riqualificazione del quartiere Saint-Martin (2000-2011), il giardino dei profumi offre un'esperienza bucolica con i profumi della Provenza nel cuore della città. Focus sugli aspetti botanici del progetto di costruzione."
    ],
    "fr": [
      "Créé en 2008 lors de l'aménagement du quartier Saint-Martin (2000-2011), le jardin des senteurs offre une expérience bucolique aux parfums de Provence dans le cœur de la ville. Visite focus du projet de construction à l'aspect botanique."
    ],
    "nl": [
      "De geurtuin, aangelegd in 2008 tijdens de herinrichting van de wijk Saint-Martin (2000-2011), biedt een bucolische ervaring met de geuren van de Provence in het hart van de stad. Focus op de botanische aspecten van het bouwproject."
    ],
    "es": [
      "Creado en 2008 durante la remodelación del barrio de Saint-Martin (2000-2011), el jardín de los aromas ofrece una experiencia bucólica con los aromas de la Provenza en el corazón de la ciudad. Concéntrese en los aspectos botánicos del proyecto de construcción."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin des senteurs"
    ]
  },
