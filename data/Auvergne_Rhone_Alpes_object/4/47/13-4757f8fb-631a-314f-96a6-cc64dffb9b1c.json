  "rdfs:comment": {
    "de": [
      "Wein- und Tapas-Bar im Herzen von Morzine. Vom Kaffee und Croissant am Morgen bis zum letzten Glas auf der Terrasse teilen Sie einfallsreiche Tapas, hausgemachte Pizzen und sorgfältig ausgewählte Weine in einer warmen und eleganten Atmosphäre."
    ],
    "en": [
      "Wine and tapas bar in the heart of Morzine. From coffee and croissants in the morning to a last drink on the terrace, enjoy inventive tapas, homemade pizzas and a carefully selected wine list in a warm and elegant atmosphere."
    ],
    "it": [
      "Wine and tapas bar nel cuore di Morzine. Dal caffè e dal croissant del mattino al bicchiere della staffa sulla terrazza, condividete tapas originali, pizze fatte in casa e vini accuratamente selezionati in un'atmosfera calda ed elegante."
    ],
    "fr": [
      "Bar à vins et tapas au cœur de Morzine. Du café et croissant du matin au dernier verre en terrasse, on partage tapas inventifs, pizzas maison et vins soigneusement sélectionnés, dans une ambiance chaleureuse et élégante."
    ],
    "nl": [
      "Dit gastronomische restaurant richt zich op seizoensgebonden regionale producten."
    ],
    "es": [
      "Bar de vinos y tapas en el corazón de Morzine. Desde un café y un cruasán por la mañana hasta una copa por la noche en la terraza, comparta tapas ingeniosas, pizzas caseras y vinos cuidadosamente seleccionados en un ambiente cálido y elegante."
    ]
  },
