  "rdfs:comment": {
    "de": [
      "Besuchen Sie unseren kleinen, familiengeführten Bio-Obsthof in Mirmande und kaufen Sie Ihr Obst: Kirschen, Aprikosen, Pfirsiche, Nektarinen, Pflaumen und Nektar, die Patrick mit viel Liebe an unserem Stand produziert. Bestellungen sind möglich."
    ],
    "en": [
      "At our small, family-run organic fruit farm in Mirmande, come and buy your fruit: cherries, apricots, peaches, nectarines, flat peaches, plums, and nectars lovingly produced by Patrick at our stand. Orders can be placed."
    ],
    "it": [
      "Venite a comprare la vostra frutta nella nostra piccola azienda agricola biologica a conduzione familiare di Mirmande: ciliegie, albicocche, pesche, nettarine, pesche piatte, prugne e nettari prodotti con amore da Patrick nel nostro stand. È possibile anche effettuare ordini."
    ],
    "fr": [
      "Sur notre petite exploitation familiale fruitière BIO à Mirmande venez acheter vos fruits : cerises, abricots, pêches, nectarines, pêches plates, prunes, et nectars produits avec amour par Patrick sur notre stand. Possibilité de passer vos commandes."
    ],
    "es": [
      "Venga a comprar su fruta a nuestra pequeña explotación frutícola ecológica familiar de Mirmande: cerezas, albaricoques, melocotones, nectarinas, paraguayos, ciruelas y néctares producidos con amor por Patrick en nuestro puesto. También se pueden hacer pedidos."
    ],
    "nl": [
      "Kom naar onze kleine, biologische familiefruitkwekerij in Mirmande en koop uw fruit: kersen, abrikozen, perziken, nectarines, platte perziken, pruimen en nectars die Patrick met liefde op onze stand heeft geteeld. U kunt ook bestellen."
    ]
  },
