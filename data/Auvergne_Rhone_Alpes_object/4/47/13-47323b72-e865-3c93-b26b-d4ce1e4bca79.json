  "rdfs:comment": {
    "de": [
      "Lassen Sie sich das Schloss Chavaniac-Lafayette bei einer Führung erzählen\r\ndie Geschichte des Schlosses und seiner berühmten Besitzer wird anhand zahlreicher Anekdoten erzählt."
    ],
    "en": [
      "Take a guided tour of the Château de Chavaniac-Lafayette\r\nguided tour Discover the history of the château and its illustrious owners through a wealth of anecdotes."
    ],
    "it": [
      "Partecipate alla visita guidata dello Château de Chavaniac-Lafayette e scoprite la sua storia e i suoi illustri proprietari\r\npartecipate a una visita guidata e scoprite la storia del castello e dei suoi illustri proprietari attraverso una serie di aneddoti."
    ],
    "fr": [
      "Laissez-vous raconter le château de Chavaniac-Lafayette le temps d’une\r\nvisite guidée C’est venir découvrir, à travers de nombreuses anecdotes, l’histoire du château et de ses illustres propriétaires."
    ],
    "es": [
      "Realice una visita guiada al castillo de Chavaniac-Lafayette y descubra su historia y a sus ilustres propietarios\r\nrealice una visita guiada y descubra la historia del castillo y de sus ilustres propietarios a través de un sinfín de anécdotas."
    ],
    "nl": [
      "Laat je rondleiden door het Château de Chavaniac-Lafayette en kom alles te weten over de geschiedenis en de illustere eigenaars\r\nvolg een rondleiding en ontdek de geschiedenis van het kasteel en zijn illustere eigenaars aan de hand van een schat aan anekdotes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visites guidées | Château Chavaniac-Lafayette"
    ]
  },
