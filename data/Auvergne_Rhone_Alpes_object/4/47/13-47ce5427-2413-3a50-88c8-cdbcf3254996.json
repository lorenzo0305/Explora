  "rdfs:comment": {
    "de": [
      "Dry-Tooling... oder die Kunst, mit Eispickeln und Steigeisen am Fels zu klettern.\r\nKommen Sie und üben Sie an einem ausgestatteten Felsen in Aussois: Hell Cave."
    ],
    "en": [
      "Dry-tooling... or the art of climbing on the rock with ice axes and crampons.\r\nCome and practice on an equipped cliff in Aussois: Hell Cave."
    ],
    "it": [
      "Dry-tooling... ovvero l'arte di arrampicare su roccia con piccozze e ramponi.\r\nVieni ad esercitarti su una falesia attrezzata ad Aussois: Grotta dell'Inferno."
    ],
    "fr": [
      "Le dry-tooling... ou l'art de grimper sur le rocher avec piolets et crampons. \r\nVenez pratiquer sur une falaise équipée à Aussois : Hell Cave."
    ],
    "nl": [
      "Dry-tooling... of de kunst van het klimmen op de rots met ijsbijlen en stijgijzers.\r\nKom oefenen op een uitgeruste klif in Aussois: Hell Cave."
    ],
    "es": [
      "Dry-tooling... o el arte de escalar en roca con piolet y crampones.\r\nVen a practicar en un acantilado equipado en Aussois: la Cueva del Infierno."
    ]
