  "rdfs:comment": {
    "de": [
      "Gewässer mit Aktivitätsbereich, Campingplatz, Freizeitchalets und Spielplatz.\r\nFläche von 10 ha 94.\r\nFisch: Karpfen, Plötze, Barsch, Schleie, Forelle, Weißfisch. Nachtangeln auf Karpfen. Raubfischangeln\r\nPrivate Verwaltung"
    ],
    "en": [
      "Body of water with activity area, campsite, leisure chalets and playground.\r\nArea of ​​10ha 94.\r\nFish: carp, roach, perch, tench, trout, white fish. Carp night fishing. predator fishing\r\nPrivate management"
    ],
    "it": [
      "Area acquatica con zona attività, campeggio, chalet per il tempo libero e parco giochi.\r\nSuperficie di 10 ha 94.\r\nPesci: carpa, lasca, persico, tinca, trota, coregone. Pesca notturna alla carpa. La pesca dei carnivori\r\nGestione privata"
    ],
    "fr": [
      "Plan d'eau avec zone d'activité, camping, chalets loisirs et aire de jeux.\r\nSurface de 10 ha 94.\r\nPoissons : carpes, gardons, perches, tanches, truites, poisson blanc. Pêche de nuit de la carpe. Pêche des carnassiers\r\nGestion privée"
    ],
    "es": [
      "Zona acuática con zona de actividades, camping, chalés de ocio y parque infantil.\r\nSuperficie de 10 ha 94.\r\nPeces: carpa, cucaracha, perca, tenca, trucha, pescado blanco. Pesca nocturna de carpas. Pesca de carnívoros\r\nGestión privada"
    ],
    "nl": [
      "Watergebied met activiteitenzone, camping, recreatiechalets en speeltuin.\r\nOppervlakte van 10 ha 94.\r\nVis: karper, voorn, baars, zeelt, forel, witvis. Nachtvissen op karper. Vissen op carnivoren\r\nParticulier beheer"
    ]
  },
