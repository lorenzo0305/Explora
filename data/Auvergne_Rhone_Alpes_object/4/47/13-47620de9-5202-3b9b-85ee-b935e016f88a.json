  "rdfs:comment": {
    "de": [
      "Ich bin Alexandra, eine Glasspinnerin mit Schneidbrenner und Designerin von Schmuck und Accessoires aus Glas.\r\nO' Douceurs des Arts spiegelt meine Persönlichkeit und mein Händchen für alles wider.\r\nHier können Sie Kreationen aus verschiedenen Materialien und Techniken entdecken."
    ],
    "en": [
      "I am Alexandra, glass spinner and creator of glass jewellery and accessories.\r\nO' Douceurs des Arts reflects my personality and my versatility.\r\nYou can discover creations in different materials and techniques."
    ],
    "it": [
      "Sono Alexandra, filatrice di vetro e creatrice di gioielli e accessori in vetro.\r\nO? Douceurs des Arts riflette la mia personalità e la mia passione per tutto.\r\nSi possono scoprire creazioni in diversi materiali e tecniche."
    ],
    "fr": [
      "Je suis Alexandra, fileuse de verre au chalumeau et créatrice de bijoux et accessoires en verre.\r\nO’ Douceurs des Arts reflète ma personnalité et mon touche à tout.\r\nVous pourrez y découvrir des créations dans différentes matières et techniques."
    ],
    "es": [
      "Soy Alexandra, hilandera de vidrio y creadora de joyas y accesorios de vidrio.\r\nO? Douceurs des Arts refleja mi personalidad y mi versatilidad.\r\nPodrá descubrir creaciones en distintos materiales y técnicas."
    ],
    "nl": [
      "Ik ben Alexandra, glasspinner en ontwerpster van glazen sieraden en accessoires.\r\nO' Douceurs des Arts weerspiegelt mijn persoonlijkheid en mijn passie voor alles.\r\nHier kun je creaties in verschillende materialen en technieken ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "O douceurs des Arts -  Lindorie Créations"
    ]
  },
