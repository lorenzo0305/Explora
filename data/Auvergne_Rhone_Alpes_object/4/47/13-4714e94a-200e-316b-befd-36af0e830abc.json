  "rdfs:comment": {
    "de": [
      "Acrylfarbe\r\nSpraydose\r\n\r\nVon Angesicht zu Angesicht maskierter Mensch / Fuchs, sie sind Teil derselben Welt.\r\nSie prangert die negativen Auswirkungen an, die der Mensch auf die Natur und das Tierreich hat."
    ],
    "en": [
      "acrylic paint\r\nspray can\r\n\r\nFace to face, masked man/fox, they're part of the same world.\r\nShe denounces man's negative impact on nature and the animal kingdom."
    ],
    "it": [
      "vernice acrilica\r\nbomboletta spray\r\n\r\nFaccia a faccia, uomo/volpe mascherato, appartengono allo stesso mondo.\r\nL'artista denuncia l'impatto negativo dell'uomo sulla natura e sul regno animale."
    ],
    "fr": [
      "peinture acrylique\r\nbombe\r\n\r\nFace à face homme / renard masqués, ils font partie du même monde.\r\nElle dénonce l'impact négatif qu'a l'homme sur la nature et le règne animal."
    ],
    "es": [
      "pintura acrílica\r\nbote de spray\r\n\r\nCara a cara, hombre/zorro enmascarado, pertenecen al mismo mundo.\r\nDenuncia el impacto negativo del hombre sobre la naturaleza y el reino animal."
    ],
    "nl": [
      "acrylverf\r\nspuitbus\r\n\r\nOog in oog, gemaskerde man/vos, ze behoren tot dezelfde wereld.\r\nZe hekelt de negatieve invloed van de mens op de natuur en het dierenrijk."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wandgemälde: \"Alors c'est qui l'plus fort?\" (Wer ist der Stärkste?)"
    ],
    "en": [
      "Fresco: \"So who's the strongest?\""
    ],
    "it": [
      "Fresco: \"Allora, chi è il più forte?"
    ],
    "fr": [
      "Fresque : \"Alors c'est qui l'plus fort ?\""
    ],
    "nl": [
      "Fresco: \"Dus wie is de sterkste?"
    ]
  },
