  "rdfs:comment": {
    "de": [
      "Der Club de Pêche à la mouche de Tence-Lignon-Velay organisiert wie üblich den Coup de la Haute-Loire auf dem Stausee der Moulins du Bouchat.\r\n\r\nSie können kommen und die besten Fliegenfischer bewundern!"
    ],
    "en": [
      "As usual, the Tence-Lignon-Velay fly-fishing club is organizing the Haute-Loire coup on the Moulins du Bouchat reservoir.\r\n\r\nCome and admire the best fly fishers!"
    ],
    "it": [
      "Come di consueto, il Tence-Lignon-Velay Fly Fishing Club organizza la Haute-Loire Cup sul lago artificiale di Moulins du Bouchat.\r\n\r\nPotrete venire ad ammirare i migliori pescatori a mosca!"
    ],
    "fr": [
      "Le Club de Pêche à la mouche de Tence-Lignon-Velay organise comme à son habitude la coup de de la Haute-Loire sur le réservoir des Moulins du Bouchat.\r\n\r\nVous pouvez venir admirer les meilleurs pêcheurs à la mouche !"
    ],
    "nl": [
      "Zoals gebruikelijk organiseert de Tence-Lignon-Velay Fly Fishing Club de Haute-Loire Cup op het stuwmeer van Moulins du Bouchat.\r\n\r\nJe kunt de beste vliegvissers komen bewonderen!"
    ],
    "es": [
      "Como de costumbre, el Club de Pesca a Mosca de Tence-Lignon-Velay organiza la Copa del Alto Loira en el embalse de Moulins du Bouchat.\r\n\r\n¡Puede venir a admirar a los mejores pescadores a mosca!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Coupe de Haute-Loire Pêche"
    ]
  },
