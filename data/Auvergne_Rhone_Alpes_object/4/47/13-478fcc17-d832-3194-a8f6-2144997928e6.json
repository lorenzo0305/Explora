  "rdfs:comment": {
    "de": [
      "Saboïa Vélo, ein Fahrrad-Basislager (Mountainbike-Betreuung, Reparatur und Verleih von Fahrrädern), liegt im Herzen eines außergewöhnlichen Spielplatzes mit klangvollen Namen (Bauges, Belledonne, Maurienne, Route des Grandes Alpes, Belle Via) für Mountainbike, Gravel und Wandertouren."
    ],
    "en": [
      "Saboïa Vélo is a leisure cycling company specializing in mountain biking, based in the heart of Savoie on the eastern slopes of the Bauges massif and proud to promote an exceptional playground and region."
    ],
    "it": [
      "Saboïa Vélo, un campo base per il ciclismo (coaching di mountain bike, riparazione e noleggio di biciclette), situato nel cuore di un eccezionale parco giochi dai nomi evocativi (Bauges, Belledonne, Maurienne, route des Grandes Alpes, Belle Via) per la mountain bike, lo sterrato e il touring."
    ],
    "fr": [
      "Saboïa Vélo, camp de base vélo (encadrement VTT, réparation et location cycles), situé au cœur d'un terrain de jeu d'exception aux noms évocateurs (Bauges, Belledonne, Maurienne, route des Grandes Alpes, Belle Via) pour le VTT, le Gravel et l'itinérance."
    ],
    "es": [
      "Saboïa Vélo, un campamento base de ciclismo (entrenamiento en bicicleta de montaña, reparación y alquiler de bicicletas), situado en el corazón de un excepcional terreno de juego con nombres evocadores (Bauges, Belledonne, Maurienne, route des Grandes Alpes, Belle Via) para la práctica de la bicicleta de montaña, gravel y touring."
    ],
    "nl": [
      "Saboïa Vélo, een fietsbasiskamp (mountainbikebegeleiding, fietsreparatie en -verhuur), gelegen in het hart van een uitzonderlijke speeltuin met suggestieve namen (Bauges, Belledonne, Maurienne, route des Grandes Alpes, Belle Via) voor mountainbiken, gravel en toeren."
    ]
  },
