  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte, das Kulturerbe und die kleinen Reichtümer unserer Gemeinden auf Spaziergängen\r\ndie vom Tourismusteam Somme Sud-Ouest kommentiert werden."
    ],
    "en": [
      "Discover the history, heritage and little treasures of our communes on guided walks\r\nguided by the Somme Sud-Ouest Tourism Team."
    ],
    "it": [
      "Scoprite la storia, il patrimonio e i piccoli tesori dei nostri comuni con le passeggiate guidate\r\nguidate dall'équipe turistica della Somme Sud-Ouest."
    ],
    "fr": [
      "Découvrez l'histoire, le patrimoine et les petites richesses de nos communes lors de balades\r\ncommentées par l'Équipe Tourisme Somme Sud-Ouest."
    ],
    "nl": [
      "Ontdek de geschiedenis, het erfgoed en de kleine schatten van onze gemeenten tijdens begeleide wandelingen\r\nbegeleid door het toerismeteam van Somme Sud-Ouest."
    ],
    "es": [
      "Descubra la historia, el patrimonio y los pequeños tesoros de nuestros municipios en paseos guiados\r\nguiados por el Equipo de Turismo de Somme Sud-Ouest."
    ]
  },
