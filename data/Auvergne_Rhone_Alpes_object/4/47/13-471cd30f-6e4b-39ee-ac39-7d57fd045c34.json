  "rdfs:comment": {
    "de": [
      "Die englisch-französische Fotojournalistin Suzanne Porter, die sich auf humanitäre Hilfe spezialisiert hat, gründete die Galerie CLIK, einen Ort, der der Fotografie gewidmet ist und im Juli 2023 eröffnet wird."
    ],
    "en": [
      "Grenoble's Clik gallery, founded by Franco-British photographer Suzanne Porter, is much more than just an exhibition space. It's a place where the art of photography meets the discovery of new destinations around the world."
    ],
    "it": [
      "La galleria Clik di Grenoble, fondata dalla fotografa franco-britannica Suzanne Porter, è molto più di un semplice spazio espositivo. È un luogo dove l'arte della fotografia incontra la scoperta di nuove destinazioni in tutto il mondo."
    ],
    "fr": [
      "La galerie Clik de Grenoble, fondée par la photographe franco-britannique Suzanne Porter, est bien plus qu'un simple espace d'exposition. C'est un lieu où l'art de la photographie se mêle à la découverte de nouvelles destinations à travers le monde."
    ],
    "es": [
      "Suzanne Porter, fotoperiodista franco-inglesa especializada en ayuda humanitaria, está detrás de la Galerie CLIK, un espacio dedicado a la fotografía que abrió sus puertas en julio de 2023."
    ],
    "nl": [
      "De Clik-galerie in Grenoble, opgericht door de Frans-Britse fotografe Suzanne Porter, is veel meer dan alleen een expositieruimte. Het is een plek waar de kunst van fotografie samenkomt met het ontdekken van nieuwe bestemmingen over de hele wereld."
    ]
  },
  "rdfs:label": {
