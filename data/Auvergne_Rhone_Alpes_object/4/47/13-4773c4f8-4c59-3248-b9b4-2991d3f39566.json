  "rdfs:comment": {
    "de": [
      "Auf der Spitze des Hügels scheint die Domaine Crêt de Garanches über ein Volk von Weinreben zu wachen.\r\nVerkostung und Verkauf der Appellationen auf der Domäne: Brouilly und Côte de Brouilly."
    ],
    "en": [
      "At the top of the hill, Domaine Crêt de Garanches seems to watch over the vineyards.\r\nTasting and sales of the \"domaine's\" wines: Brouilly and Côte de Brouilly."
    ],
    "it": [
      "In cima alla collina, il Domaine Crêt de Garanches sembra vegliare su un popolo di viticoltori.\r\nDegustazione e vendita delle denominazioni della tenuta: Brouilly e Côte de Brouilly."
    ],
    "fr": [
      "A la Cime de la colline, le Domaine Crêt de Garanches semble veiller sur un peuple de vignes.\r\nDégustation et vente des appellations au domaine : Brouilly et Côte de Brouilly."
    ],
    "nl": [
      "Op de top van de heuvel lijkt het Domaine Crêt de Garanches te waken over een volk van wijnstokken.\r\nProeverij en verkoop van de appellations op het domein: Brouilly en Côte de Brouilly."
    ],
    "es": [
      "En lo alto de la colina, el Domaine Crêt de Garanches parece vigilar a un pueblo de viñas.\r\nDegustación y venta de las denominaciones en la finca: Brouilly y Côte de Brouilly."
    ]
  },
  "rdfs:label": {
