  "rdfs:comment": {
    "de": [
      "Das Petit Resto bietet Ihnen eine schmackhafte Bistroküche, in der die Gerichte mit lokalen, frischen und saisonalen Produkten zubereitet werden.\r\nRestaurant mit dem Gütesiegel \"Goûtez l'Ardèche®\" (Schmecken Sie die Ardèche)"
    ],
    "en": [
      "Le Petit Resto serves tasty bistro dishes made using local, fresh and seasonal produce.\r\nRestaurant approved by Goûtez l'Ardèche®"
    ],
    "it": [
      "Le Petit Resto vi offre una gustosa cucina da bistrot dove i piatti sono preparati con prodotti locali, freschi e di stagione.\r\nRistorante con il marchio Goûtez l'Ardèche"
    ],
    "fr": [
      "Le Petit Resto vous propose une cuisine de bistrot goûteuse où les plats sont élaborés avec des produits locaux, frais et de saison.\r\nRestaurant labellisé Goûtez l'Ardèche®"
    ],
    "es": [
      "Le Petit Resto le ofrece una sabrosa cocina de bistró en la que los platos se preparan con productos locales, frescos y de temporada.\r\nRestaurante con la etiqueta Goûtez l'Ardèche®"
    ],
    "nl": [
      "Le Petit Resto biedt een smakelijke bistrokeuken waarbij de gerechten worden bereid met lokale, verse en seizoensgebonden producten.\r\nRestaurant met het Goûtez l'Ardèche® label"
    ]
  },
