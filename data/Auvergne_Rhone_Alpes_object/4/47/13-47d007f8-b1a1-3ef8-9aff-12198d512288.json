  "rdfs:comment": {
    "de": [
      "Eine thematische Führung, die der grünen Lunge der Stadt gewidmet ist, die im Jahr ... eingeweiht wurde. 1857 ! Die Gelegenheit, seine Entwicklung, seine Missgeschicke, aber auch seine Fauna und Flora nachzuvollziehen."
    ],
    "en": [
      "A themed tour of the city's green lung, inaugurated in... 1857 ! An opportunity to retrace its evolution and misadventures, as well as its flora and fauna."
    ],
    "it": [
      "Un tour tematico del polmone verde della città, inaugurato nel... 1857 ! È un'occasione per ripercorrere il suo sviluppo, le sue disavventure e anche la sua flora e fauna."
    ],
    "fr": [
      "Une visite thématique dédiée au poumon vert de la ville, inauguré en... 1857 ! L'occasion de retracer ses évolutions, ses mésaventures mais aussi sa faune et sa flore."
    ],
    "es": [
      "Un recorrido temático por el pulmón verde de la ciudad, inaugurado en... ¡1857 ! Es una oportunidad para recorrer su desarrollo, sus desventuras y también su flora y fauna."
    ],
    "nl": [
      "Een thematische rondleiding door de groene long van de stad, ingehuldigd in... 1857 ! Het is een kans om zijn ontwikkeling, zijn tegenslagen en ook zijn flora en fauna te volgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin public"
    ]
  },
