  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Betrieb mit Getreide, Geflügel, Freilandeiern, Nüssen, Futtermitteln? Die Spezialität des Hofes ist der Direktverkauf seiner Produkte: Freilandgeflügel (Hühner, Perlhühner, Enten?), Freilandeier von unseren Hühnern, lose oder filetierte Walnüsse."
    ],
    "en": [
      "Farm with cereals, poultry, free-range eggs, nuts, forage? The farm specifies direct sales of its products: free-range poultry (chickens, guinea fowl, cans, etc.), free-range eggs from our own hens, walnuts in bulk or fillets."
    ],
    "it": [
      "Azienda agricola con cereali, pollame, uova all'aperto, noci, foraggio, ecc L'azienda è specializzata nella vendita diretta dei suoi prodotti: pollame ruspante (polli, faraone, lattarini, ecc.), uova ruspanti di galline di nostra produzione, noci sfuse o in filetti."
    ],
    "fr": [
      "Exploitation agricole avec céréales, volailles, œufs plein air, noix, fourrage… La spécification de la ferme est la vente en directe de ses produits: volailles fermières (poulets, pintades, canettes….) oeufs plein air de nos poules, noix vrac ou filets."
    ],
    "es": [
      "Granja con cereales, aves de corral, huevos de corral, nueces, forraje, etc La granja está especializada en la venta directa de sus productos: aves de corral (pollos, pintadas, latas, etc.), huevos camperos de nuestras propias gallinas, nueces a granel o en filetes."
    ],
    "nl": [
      "Boerderij met granen, gevogelte, scharreleieren, noten, veevoeder, enz De boerderij is gespecialiseerd in de rechtstreekse verkoop van haar producten: scharrelpluimvee (kippen, parelhoenders, blikjes, enz.), scharreleieren van eigen kippen, walnoten in bulk of filets."
    ]
  },
