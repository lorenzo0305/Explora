  "rdfs:comment": {
    "de": [
      "Das Touristeninformationsbüro in La Chapelle d'Abondance steht Ihnen für alle verschiedenen Informationen über den Dorfort und seine umliegenden Dörfer im Pays d'Evian-vallée d'Abondance sowie in der benachbarten Schweiz zur Verfügung."
    ],
    "en": [
      "The tourist information office is at your disposal for all information about the resort-village and its surrounding villages in the Evian-Vallée d'Abondance region and neighboring Switzerland."
    ],
    "it": [
      "L'ufficio informazioni turistiche di La Chapelle d'Abondance è a vostra disposizione per tutte le informazioni sulla località e sui villaggi circostanti nella regione di Evian-Vallée d'Abondance e nella vicina Svizzera."
    ],
    "fr": [
      "Le bureau d'information touristique de La Chapelle d'Abondance est à votre disposition pour toutes les informations diverses concernant la station-village et ses villages environnants du pays d'Evian-vallée d'Abondance ainsi que de la Suisse voisine."
    ],
    "es": [
      "La oficina de turismo de La Chapelle d'Abondance está a su disposición para facilitarle toda la información que necesite sobre la estación y los pueblos de los alrededores, en la región de Evian-Vallée d'Abondance y la vecina Suiza."
    ],
    "nl": [
      "Het VVV-kantoor in La Chapelle d'Abondance staat tot je beschikking voor alle informatie die je nodig hebt over het resort en de omliggende dorpen in de regio Evian-Vallée d'Abondance en het aangrenzende Zwitserland."
    ]
  },
  "rdfs:label": {
