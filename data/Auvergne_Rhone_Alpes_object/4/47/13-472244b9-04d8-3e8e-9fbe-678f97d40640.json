  "rdfs:comment": {
    "de": [
      "Die Kessak bietet schmackhafte mediterrane und libanesische Küche. Der Koch ist glücklich, Ihnen Mezze und feine Küche mit frischen Produkten schmecken. kulinarische Reise garantiert!"
    ],
    "en": [
      "The Kessak offers a tasty Mediterranean and Lebanese cuisine. The chef is happy to make you taste mezze and refined dishes based on fresh products. Culinary travel assured!"
    ],
    "it": [
      "Il Kessak offre una gustosa cucina mediterranea e libanese. Lo chef è lieto di offrirvi mezze e piatti raffinati a base di prodotti freschi. Un viaggio culinario garantito!"
    ],
    "fr": [
      "Le Kessak vous propose une restauration savoureuse méditerranéenne et libanaise. Le chef se fait un plaisir de vous faire déguster des mezze et des plats raffinés à base de produits frais. Voyage culinaire assuré !"
    ],
    "es": [
      "El Kessak ofrece una sabrosa cocina mediterránea y libanesa. El chef está encantado de ofrecerle mezze y platos refinados elaborados con productos frescos. ¡Un viaje culinario garantizado!"
    ],
    "nl": [
      "De Kessak biedt een smakelijke mediterrane en Libanese keuken. De chef biedt u graag mezze en verfijnde gerechten van verse producten. Een culinaire reis gegarandeerd!"
    ]
  },
