  "rdfs:comment": {
    "de": [
      "Treffpunkt in den Gassen von Souvigny zum Feiern, Singen, Tanzen und Flanieren! Souvigny erstrahlt wieder in seinem alten Glanz und feiert neun Tage lang!"
    ],
    "en": [
      "Take to the streets of Souvigny to feast, sing, dance and stroll! Souvigny is back to its former glory for nine days of festivities!"
    ],
    "it": [
      "Per le strade di Souvigny si festeggia, si canta, si balla e si passeggia! Souvigny torna al suo antico splendore per nove giorni di festa!"
    ],
    "fr": [
      "Rendez-vous dans les ruelles de Souvigny pour festoyer, chanter, danser et flâner ! Souvigny retrouve son éclat d’antan pour neuf jours de fête !"
    ],
    "nl": [
      "Trek de straten van Souvigny in om te feesten, zingen, dansen en flaneren! Souvigny is terug in haar oude glorie voor negen dagen van festiviteiten!"
    ],
    "es": [
      "Salga a las calles de Souvigny para festejar, cantar, bailar y pasear Souvigny recupera su esplendor durante nueve días de fiesta"
    ]
  },
