  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f1409d32-7c6a-32e9-a9e6-74c4bf8d91f9",
      "dc:description": {
        "de": [
          "Gemüse der Saison, Erdbeeren aus Freilandanbau, Suppen\n\nAuf den Märkten von Berck-Plage mittwochs und samstags und auf dem Markt von Etaples dienstags und freitags vertreten."
        ],
        "en": [
          "Seasonal vegetables, field strawberries, soups\n\nPresent on the markets of Berck-Plage on Wednesday and Saturday, and on the market of Etaples on Tuesday and Friday."
        ],
        "it": [
          "Verdure di stagione, fragole, zuppe\n\nPresente sui mercati di Berck-Plage il mercoledì e il sabato, e sul mercato di Etaples il martedì e il venerdì."
        ],
        "fr": [
          "Légumes de saison, fraises de pleine terre, potages. \n\nPrésent sur les marchés de Berck-Plage le mercredi et le samedi, et sur le marché d'Etaples le mardi et le vendredi."
        ],
        "es": [
          "Verduras de temporada, fresas, sopas\n\nPresente en los mercados de Berck-Plage los miércoles y sábados, y en el de Etaples los martes y viernes."
        ],
        "nl": [
          "Seizoensgroenten, aardbeien, soepen\n\nAanwezig op de markten van Berck-Plage op woensdag en zaterdag, en op de markt van Etaples op dinsdag en vrijdag."
        ]
      },
      "@type": [
        "Description"
