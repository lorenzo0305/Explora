  "rdfs:comment": {
    "de": [
      "Bewohner des Vercors, Künstler, Handwerker, Landwirte, Kulturschaffende, Fremdenführer, Menschen, die versuchen, besser im Land zu leben, indem sie eine Materie produzieren und aufwerten, die uns ähnelt, die von Neugier, Vielfalt und Begegnungen durchdrungen sind ..."
    ],
    "en": [
      "Inhabitants of the Vercors, artists, craftsmen, farmers, cultural professionals, guides, people who seek to live better in the country by producing and valorizing a material that resembles us, full of curiosity, diversity, encounters..."
    ],
    "it": [
      "Residenti del Vercors, artisti, artigiani, agricoltori, professionisti della cultura, guide, persone che vogliono vivere meglio nella regione producendo e promuovendo un prodotto che rifletta ciò che siamo, pieno di curiosità, diversità e incontri..."
    ],
    "fr": [
      "Des habitants du Vercors, artistes, artisans, agriculteurs, professionnels de la culture, guides, des gens qui cherchent à mieux vivre au pays en produisant et valorisant une matière qui nous ressemble, pétris de curiosité, de diversité, de rencontres ..."
    ],
    "nl": [
      "Inwoners van de Vercors, kunstenaars, ambachtslieden, boeren, culturele professionals, gidsen, mensen die beter willen leven in de regio door het produceren en promoten van een product dat weerspiegelt wie we zijn, vol nieuwsgierigheid, diversiteit en ontmoetingen ..."
    ],
    "es": [
      "Habitantes del Vercors, artistas, artesanos, agricultores, profesionales de la cultura, guías, gente que quiere vivir mejor en la región elaborando y promocionando un producto que refleje lo que somos, llenos de curiosidad, diversidad y encuentros..."
    ]
  },
