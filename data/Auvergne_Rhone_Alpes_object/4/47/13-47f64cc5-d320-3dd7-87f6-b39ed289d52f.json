  "rdfs:comment": {
    "de": [
      "Traditionelles und savoyisches Restaurant, das \"hausgemacht\" und kurze Wege bevorzugt. Angeboten werden savoyische Spezialitäten, Fleisch aus Frankreich, vegetarische Produkte und Pizzen... Zögern Sie nicht, uns für weitere Informationen zu kontaktieren."
    ],
    "en": [
      "Traditional Savoyard restaurant with a focus on \"home-made\" and local produce, offering Savoyard specialties, French meats, vegetarian products and pizzas... Don't hesitate to contact us for more information."
    ],
    "it": [
      "Ristorante tradizionale savoiardo che privilegia il \"fatto in casa\" e i prodotti locali, offrendo specialità savoiarde, carni francesi, prodotti vegetariani e pizze... Non esitate a contattarci per maggiori informazioni."
    ],
    "fr": [
      "Restaurant traditionnel et savoyard privilégiant le « fait maison » et le circuit court, proposant spécialités savoyardes, viandes d’origine française, produits végétariens et pizzas... N’hésitez pas à nous contacter pour plus d'informations."
    ],
    "nl": [
      "Traditioneel Savoyaards restaurant met de nadruk op \"huisgemaakte\" en lokale producten, met Savoyaardse specialiteiten, Frans vlees, vegetarische producten en pizza's... Aarzel niet om contact met ons op te nemen voor meer informatie."
    ],
    "es": [
      "Restaurante tradicional y saboyano que privilegia lo \"casero\" y el circuito corto, ofreciendo especialidades saboyanas, carnes francesas, productos vegetarianos y pizzas... No dude en ponerse en contacto con nosotros para obtener más información."
    ]
  },
