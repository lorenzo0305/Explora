  "rdfs:comment": {
    "de": [
      "Wir: Ein einzigartiger Tisch, bis zu 12 Gedecke bei Privatisierungen und im Haus des Küchenchefs. Maßgeschneiderte Menüs, die nach den Wünschen des Kunden zusammengestellt werden und dabei die Saisonalität der Produkte und das lokale Know-how berücksichtigen."
    ],
    "en": [
      "Nous: a unique dining concept with private catering for up to 12 guests at the chef's home. Customized menus, designed in accordance with the client's wishes, produced using seasonal produce and local expertise."
    ],
    "it": [
      "Nous : una tavola unica, fino a 12 coperti in privato e a domicilio dello Chef. Menu su misura, creati in base ai desideri del cliente e rispettando i prodotti di stagione e il savoir-faire locale."
    ],
    "fr": [
      "Nous : une table unique, jusqu'à 12 couverts en privatisation et au domicile du chef. Des menus sur mesure, construits selon les envies du client et tout en respectant la saisonnalité des produits et les savoir-faire locaux."
    ],
    "nl": [
      "Wij : een unieke tafel, tot 12 couverts in privatisering en bij de chef thuis. Menu's op maat, samengesteld volgens de wensen van de klant en met respect voor de seizoensgebondenheid van de producten en de lokale knowhow."
    ],
    "es": [
      "Nosotros : una mesa única, hasta 12 cubiertos en privatización y en casa del chef. Menús a medida, elaborados según los deseos del cliente y respetando la estacionalidad de los productos y el saber hacer local."
    ]
  },
