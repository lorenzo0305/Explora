  "rdfs:comment": {
    "de": [
      "9h-18h00: Entdeckungsspaziergang mit Lesungen von J. Moulier und Vorträgen von Sismae. 18? 4h Wanderung. Picknick mitbringen.\r\n11 Uhr: Vorführung des Dokumentarfilms von Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G"
    ],
    "en": [
      "9am-6pm: Discovery walk with readings by J. Moulier and talks by Sismae. 18? 4h walk. Please bring a picnic.\r\n11am: Screening of Caroline Reussner's documentary \"Paul Ricoeur, philosophe de tous les dialogues\". G"
    ],
    "it": [
      "9.00-18.00: passeggiata di scoperta con letture di J. Moulier e conferenze di Sismae. 18? 4 ore di cammino. Si prega di portare un picnic.\r\nore 11: proiezione del documentario di Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G"
    ],
    "fr": [
      "9h-18h00 : Balade-découverte rythmée de lectures par J. Moulier et d'interventions par Sismae. 18€ 4h de marche. Prévoir pique-nique.\r\n11h : Projection du documentaire de Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G"
    ],
    "es": [
      "de 9.00 a 18.00 h: Paseo de descubrimiento con lecturas de J. Moulier y charlas de Sismae. 18? 4h de paseo. Se ruega traer un picnic.\r\n11h: Proyección del documental de Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G"
    ],
    "nl": [
      "9-18u: Ontdekkingswandeling met voordrachten van J. Moulier en lezingen van Sismae. 18? Wandeling van 4 uur. Breng een picknick mee.\r\n11u: Vertoning van de documentaire \"Paul Ricoeur, philosophe de tous les dialogues\" van Caroline Reussner. G"
    ]
  },
