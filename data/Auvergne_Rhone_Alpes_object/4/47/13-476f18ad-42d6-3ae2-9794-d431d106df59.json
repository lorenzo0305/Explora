  "rdfs:comment": {
    "de": [
      "Wir befinden uns in Usson in einem der schönsten Dörfer Frankreichs und empfangen Sie von Anfang April bis Ende September. Eine Szenografie lässt Sie in die Geschichte des Dorfes eintauchen, die von einer seiner prägenden Persönlichkeiten geprägt wurde: Königin Margot."
    ],
    "en": [
      "Located in Usson in one of the Most Beautiful Villages of France, we welcome you from the beginning of April until the end of September. A scenography immerses you in the history of the village marked by one of its outstanding characters: Queen Margot."
    ],
    "it": [
      "Situati a Usson, in uno dei più bei villaggi di Francia, vi accogliamo dall'inizio di aprile alla fine di settembre. Una scenografia vi immerge nella storia del villaggio segnata da uno dei suoi personaggi di spicco: la regina Margot."
    ],
    "fr": [
      "Situé à Usson dans l'un des Plus Beaux Villages de France, nous vous accueillons de début avril jusqu'à fin septembre. Une scénographie vous immerge dans l'histoire du village marqué par l'un de ses personnages marquants : la reine Margot."
    ],
    "es": [
      "Situado en Usson, en uno de los pueblos más bellos de Francia, le damos la bienvenida desde principios de abril hasta finales de septiembre. Una escenografía te sumerge en la historia del pueblo marcada por uno de sus personajes destacados: la reina Margot."
    ],
    "nl": [
      "Gelegen in Usson in een van de mooiste dorpen van Frankrijk, verwelkomen wij u van begin april tot eind september. Een scenografie dompelt u onder in de geschiedenis van het dorp, gekenmerkt door een van zijn markante personages: koningin Margot."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau de tourisme de Usson - Auvergne Pays d'Issoire"
    ]
  },
