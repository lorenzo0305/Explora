  "rdfs:comment": {
    "de": [
      "Alle Zimmer sind hell und verfügen über eine raffinierte Dekoration und modernen Komfort. Jeden Tag können Sie im Speisesaal ein Frühstück genießen.\r\nEin Zimmer ist für Personen mit eingeschränkter Mobilität ausgestattet."
    ],
    "en": [
      "All the bedrooms are bright, completely renovated and elegantly decorated, with modern comforts.\r\nYou can enjoy breakfast in the dining room each morning.\r\n1 room is equipped for disabled guests."
    ],
    "it": [
      "Tutte le camere sono luminose e presentano un arredamento raffinato e comfort moderni. La colazione viene servita ogni giorno nella sala da pranzo.\r\nUna camera è attrezzata per ospiti disabili."
    ],
    "fr": [
      "Toutes les chambres sont claires, bénéficient d'une décoration raffinée et d'un confort moderne. Chaque jour, vous pourrez savourer un petit-déjeuner dans la salle à manger.\r\nUne chambre est équipée pour les personnes à mobilité réduite."
    ],
    "es": [
      "Todas las habitaciones son luminosas y presentan una decoración refinada y comodidades modernas. El desayuno se sirve a diario en el comedor.\r\nUna de las habitaciones está adaptada para minusválidos."
    ],
    "nl": [
      "Alle kamers zijn licht en hebben een verfijnde inrichting en modern comfort. Het ontbijt wordt dagelijks geserveerd in de eetkamer.\r\nEén kamer is uitgerust voor gasten met een handicap."
    ]
  },
