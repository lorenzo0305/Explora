  "rdfs:comment": {
    "de": [
      "Das Château des Loges, ein Herrenhaus aus dem 18. Jahrhundert, empfängt Sie im Herzen der Weinberge des Beaujolais für einen kulinarischen Zwischenstopp im Restaurant oder einen Aufenthalt im Hotel inmitten der Weinberge. Ein raffinierter und herzlicher Rahmen in der Ruhe der Weindörfer."
    ],
    "en": [
      "The Château des Loges, an 18th century mansion, will welcome you in the heart of the Beaujolais vineyard for a gourmet stopover at the restaurant or a stay at the hotel in the middle of the vineyards. A refined and warm setting in peaceful wine villages."
    ],
    "it": [
      "Lo Château des Loges, residenza del XVIII secolo, vi accoglierà nel cuore dei vigneti del Beaujolais per una pausa gastronomica nel ristorante o un soggiorno nell'hotel in mezzo ai vigneti. Un ambiente raffinato e caldo, nella calma dei villaggi del vino."
    ],
    "fr": [
      "Le Château des Loges, demeure  XVIIIe siècle, saura vous recevoir au cœur du vignoble beaujolais pour une halte gastronomique au restaurant ou un séjour à l'hôtel en plein vignoble. Un cadre raffiné et chaleureux, dans le calme des villages viticoles."
    ],
    "nl": [
      "Het Château des Loges, een woning uit de 18e eeuw, verwelkomt u in het hart van de wijngaarden van de Beaujolais voor een gastronomische pauze in het restaurant of een verblijf in het hotel te midden van de wijngaarden. Een verfijnd en warm kader, in de rust van de wijndorpen."
    ],
    "es": [
      "El Château des Loges, una residencia del siglo XVIII, le acogerá en el corazón de los viñedos del Beaujolais para una escapada gastronómica en el restaurante o una estancia en el hotel en medio de los viñedos. Un entorno refinado y cálido, en la calma de los pueblos del vino."
    ]
  },
  "rdfs:label": {
    "en": [
      "Castle of Loges"
    ],
    "fr": [
      "Château des Loges"
    ]
  },
