  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné de Montferrat, wo Sie ein Picknick machen können. Ein Picknicktisch, eine Anbindestange für Pferde, ein Unterstand und ein Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Montferrat; we look forward to welcoming you for a picnic. Picnic tables, horse tie-downs, shelter and parking are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné de Montferrat; saremo lieti di accogliervi per un picnic. Abbiamo un tavolo da picnic, una barra per legare i cavalli, una tettoia e un parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Montferrat; nous vous accueillons le temps d'un pique nique. Table de pique-nique, barre d'attache pour les chevaux, abri et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné de Montferrat; we verwelkomen je graag voor een picknick. We hebben een picknicktafel, een stang voor paarden, een schuilhut en een parkeerplaats."
    ],
    "es": [
      "Bienvenido al Relais Cyné de Montferrat; estaremos encantados de recibirle para un picnic. Disponemos de una mesa de picnic, una barra de amarre para caballos, un refugio y un aparcamiento."
    ]
  },
