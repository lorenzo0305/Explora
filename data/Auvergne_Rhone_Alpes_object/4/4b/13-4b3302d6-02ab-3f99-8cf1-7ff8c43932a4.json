  "rdfs:comment": {
    "de": [
      "GATSBY eine gesellige und unterhaltsam!\r\nKommen Sie die regionalen Rezepte unseres Küchenchefs im Gatsby Restaurant probieren und entdecken Sie unsere verschiedenen Menüs ab 18,90€. Im Sommer können Sie auf der Terrasse oder am Rand des Schwimmbads essen."
    ],
    "en": [
      "GATSBY a convivial and entertaining place! Come and enjoy our Chef's regional cuisine at Gatsby restaurant and discover our various menus. In the summer, you can eat your lunch on the terrace by the pool."
    ],
    "it": [
      "GATSBY un conviviale e divertente!\r\nVieni a degustare le ricette regionali del nostro chef al Gatsby ristorante ; scoprirai le nostre diverse formule a partire da 18,90€. D'estate potrai pranzare all'aperto sul bordo della piscina."
    ],
    "fr": [
      "GATSBY un lieu de convivialité et de divertissement ! Venez déguster les recettes régionales du Chef et découvrir les différentes formules. En été, vous pourrez déjeuner sur la terrasse au bord de la piscine."
    ],
    "es": [
      "GATSBY un agradable y entretenido!\r\nEl Gatsby restaurante propone recetas regionales elaboradas por el chef y diferentes menús a partir de 18,90 euros. En verano disponemos de una terraza al borde de la piscina donde se puede desayunar."
    ],
    "nl": [
      "GATSBY een plaats van gezelligheid en vermaak! Kom proeven van de regionale recepten van de chef en ontdek de verschillende formules. In de zomer kunt u lunchen op het terras bij het zwembad."
    ]
  },
