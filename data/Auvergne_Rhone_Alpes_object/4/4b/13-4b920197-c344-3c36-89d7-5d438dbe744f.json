  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen Moment der Entspannung, der Flucht und des Wohlbefindens in unserem Spa PAYOT, das sich im Herzen der Prestige 4* Residenz und der Prestige 5* Hotelresidenz Odalys l'Eclose befindet."
    ],
    "en": [
      "Treat yourself to a moment of relaxation, escape and well-being in our PAYOT Spa, located in the heart of the 4* Prestige Residence & 5* Prestige Hotel Residence Odalys l'Eclose."
    ],
    "it": [
      "Concedetevi un momento di relax, evasione e benessere nella nostra PAYOT Spa, situata nel cuore del Prestige Residence 4* e del Prestige Hotel Residence Odalys l'Eclose 5*."
    ],
    "fr": [
      "Offrez-vous un moment de détente, évasion et bien être dans notre Spa PAYOT, situé au cœur de la Résidence Prestige 4* & la Résidence Hôtelière Prestige 5* Odalys l'Eclose."
    ],
    "nl": [
      "Trakteer uzelf op een moment van ontspanning, ontsnapping en welzijn in onze PAYOT Spa, gelegen in het hart van de 4* Prestige Residence & 5* Prestige Hotel Residence Odalys l'Eclose."
    ],
    "es": [
      "Regálese un momento de relajación, evasión y bienestar en nuestro Spa PAYOT, situado en el corazón de la Residencia 4* Prestige & 5* Prestige Hotel Residence Odalys l'Eclose."
    ]
  },
