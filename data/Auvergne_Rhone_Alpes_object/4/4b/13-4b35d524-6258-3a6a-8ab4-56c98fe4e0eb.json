  "rdfs:comment": {
    "de": [
      "Es ist ein Geheimnis, das seit Jahrhunderten streng gehütet wird … Hilf Madame de Sévigné, den Schwur von Réauville zu entdecken und zu schützen. Ein Schatzsuch- und Ermittlungsspiel. Ein Spiel von Planète Guides. Spiel auf Anfrage. Reservierung erforderlich."
    ],
    "en": [
      "It's a secret that's been closely guarded for centuries... Help Madame de Sévigné discover and protect the oath of Réauville. A treasure hunt and investigation game. Planète Guides game. Game on demand. Reservations required."
    ],
    "it": [
      "È stato un segreto ben custodito per secoli... Aiutate Madame de Sévigné a scoprire e proteggere il giuramento di Réauville. Un gioco di indizi e indagini. Gioco delle Guide Planetarie.  Gioco su richiesta.  Prenotazione obbligatoria."
    ],
    "fr": [
      "C'est un secret bien gardé depuis des siècles...Aidez madame de Sévigné à découvrir et protéger le serment de Réauville. Un jeu de pistes et d’enquête. Jeu Planète Guides.  Jeu à la demande.  Sur réservation."
    ],
    "nl": [
      "Het is al eeuwenlang een goed bewaard geheim... Help Madame de Sévigné de eed van Réauville te ontdekken en te beschermen. Een spel van aanwijzingen en onderzoek. Spel van Planet Guides.  Spel op aanvraag.  Reserveren noodzakelijk."
    ],
    "es": [
      "Ha sido un secreto bien guardado durante siglos... Ayuda a Madame de Sévigné a descubrir y proteger el juramento de Réauville. Un juego de pistas e investigación. Juego Planet Guides.  Juego bajo petición.  Reserva obligatoria."
    ]
  },
