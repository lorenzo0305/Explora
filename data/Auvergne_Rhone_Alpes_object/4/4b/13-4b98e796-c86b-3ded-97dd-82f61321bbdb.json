  "rdfs:comment": {
    "de": [
      "Direkt vom Bauernhof können Sie ganz in der Nähe des Sees von Annecy saisonales Gemüse und Beerenobst aus biologischem Anbau kaufen und verzehren."
    ],
    "en": [
      "Head right to the farm to purchase and enjoy eating organic seasonal fruits and vegetables just a stone's throw from Lake Annecy."
    ],
    "it": [
      "Direttamente dalla fattoria, potrete acquistare e mangiare verdure e bacche biologiche di stagione vicino al lago di Annecy."
    ],
    "fr": [
      "En direct de la ferme, vous pouvez acheter et consommer les légumes et les petits fruits de saison issus de l'agriculture biologique tout près du lac d'Annecy."
    ],
    "nl": [
      "Rechtstreeks van de boerderij kun je biologische seizoensgroenten en bessen kopen en eten in de buurt van het meer van Annecy."
    ],
    "es": [
      "Directamente de la granja, podrá comprar y comer verduras y bayas ecológicas de temporada cerca del lago de Annecy."
    ]
  },
