  "rdfs:comment": {
    "de": [
      "Laurent Karagueuzian bietet Ihnen schwarz-weiße Gemälde und Zeichnungen von Zweigen und Laub an. Er schöpft seine Inspiration aus der Natur, die ihn umgibt."
    ],
    "en": [
      "Laurent Karagueuzian offers black and white paintings and drawings of branches and foliage. He draws his inspiration from the natural world around him."
    ],
    "it": [
      "La sua ispirazione viene dal sognare ad occhi aperti sotto gli alberi. Nel corso del tempo, il suo lavoro si è evoluto verso un'espressione non figurativa. Visite su appuntamento nella sua casa-studio o nell'atelier Les Heures Bleues."
    ],
    "fr": [
      "Son inspiration prend sa source au cours d’une rêverie sous les arbres. Chemin faisant, son travail a évolué vers une expression non-figurative. Visite sur rendez-vous dans son atelier à domicile ou dans l'atelier les Heures Bleues."
    ],
    "nl": [
      "Zijn inspiratie komt van dagdromen onder de bomen. Gaandeweg is haar werk geëvolueerd naar een non-figuratieve expressie. Bezoek op afspraak in haar atelier thuis of in het atelier Les Heures Bleues."
    ],
    "es": [
      "Su inspiración le viene de soñar despierto bajo los árboles. A lo largo del tiempo, su obra ha evolucionado hacia una expresión no figurativa. Visitas concertadas en su casa-taller o en el estudio Les Heures Bleues."
    ]
  },
  "rdfs:label": {
