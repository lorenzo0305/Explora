  "rdfs:comment": {
    "de": [
      "Brauchen Sie Entspannung mit der Familie oder mit Freunden, allein oder zu zweit? Das Kino Rex in Courpière bietet Ihnen das ganze Jahr über ein abwechslungsreiches Programm. Profitieren Sie davon!"
    ],
    "en": [
      "Need to relax with family or friends, solo or duo? The Rex Cinema in Courpière offers you a varied programming throughout the year. Take advantage of it!"
    ],
    "it": [
      "Avete bisogno di rilassarvi con la famiglia o con gli amici, da soli o in coppia? Il cinema Rex di Courpière offre un programma vario tutto l'anno. Approfittatene!"
    ],
    "fr": [
      "Besoin de se détendre en famille ou entre amis, en solo ou en duo ? Le cinéma Rex, à Courpière, vous offre une programmation variée tout au long de l'année. Profitez-en !"
    ],
    "es": [
      "¿Necesita relajarse con la familia o los amigos, en solitario o a dúo? El cine Rex de Courpière ofrece una programación variada durante todo el año. ¡Aprovéchalo!"
    ],
    "nl": [
      "Ontspannen met familie of vrienden, alleen of als duo? De bioscoop Rex in Courpière biedt het hele jaar door een gevarieerd programma. Maak er gebruik van!"
    ]
  },
  "rdfs:label": {
