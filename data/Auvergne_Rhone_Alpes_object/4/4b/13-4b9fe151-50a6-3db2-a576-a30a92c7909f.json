  "rdfs:comment": {
    "de": [
      "Nutzen Sie die Vorteile der Traditionellen Chinesischen Medizin durch Massage und Stimulation von Akupunkturpunkten. Die Sitzungen werden auf der Grundlage einer Energiebilanz durchgeführt und zielen darauf ab, Ihre Energie zu lindern, zu entspannen und wieder in Schwung zu bringen."
    ],
    "en": [
      "Enjoy the benefits of Traditional Chinese Medicine through massage and stimulation of acupuncture points. Based on an energy assessment, sessions aim to relieve, relax and boost your energy."
    ],
    "it": [
      "Godete dei benefici della Medicina Tradizionale Cinese attraverso il massaggio e la stimolazione dei punti di agopuntura. Basate su una valutazione energetica, le sedute mirano a dare sollievo, rilassare e potenziare l'energia."
    ],
    "fr": [
      "Profitez des bienfaits de la Médecine Traditionnelle Chinoise par le massage et la stimulation des points d’acupuncture. Réalisées à partir d'un bilan énergétique, les séances visent à soulager, détendre et relancer votre énergie."
    ],
    "nl": [
      "Geniet van de voordelen van de Traditionele Chinese Geneeskunde door massage en stimulatie van acupunctuurpunten. De sessies zijn gebaseerd op een energiebeoordeling en hebben als doel je te verlichten, te ontspannen en je energie een boost te geven."
    ],
    "es": [
      "Disfrute de los beneficios de la Medicina Tradicional China a través del masaje y la estimulación de los puntos de acupuntura. Basadas en una evaluación energética, las sesiones tienen como objetivo aliviar, relajar y potenciar su energía."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tuina et bien-être"
    ]
  },
