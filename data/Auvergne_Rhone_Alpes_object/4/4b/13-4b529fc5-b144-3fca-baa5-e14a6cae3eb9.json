  "rdfs:comment": {
    "de": [
      "Suchen Sie ein Hotel? Dann sind Sie im Actuel Hôtel genau richtig! Dank seiner idealen Lage nahe dem Bahnhof Chambéry bietet Ihnen das Hotel ein Zuhause fernab von Zuhause. Das freundliche und hilfsbereite Team sorgt für einen unvergesslichen Aufenthalt!"
    ],
    "en": [
      "Looking for a hotel? Head to the Actuel Hôtel! Ideally located near Chambéry train station, the hotel guarantees a home-away-from-home experience. The friendly and responsive team will do everything to ensure an unforgettable stay!"
    ],
    "it": [
      "Cerchi un hotel? Scegli l'Actuel Hôtel! Situato in posizione ideale vicino alla stazione ferroviaria di Chambéry, l'hotel garantisce un'esperienza da casa lontano da casa. Il personale cordiale e disponibile farà tutto il possibile per garantirti un soggiorno indimenticabile!"
    ],
    "fr": [
      "Vous cherchez un hôtel ? Rendez-vous à l'Actuel Hôtel ! Idéalement situé près de la gare de Chambéry, l'hôtel vous garantit un séjour comme à la maison. L'équipe, souriante et réactive met tout en œuvre pour un séjour inoubliable."
    ],
    "es": [
      "¿Busca un hotel? Venga al Actuel Hôtel Idealmente situado cerca de la estación de Chambéry, el hotel le garantiza una estancia como en casa. El equipo, amable y atento, hará todo lo posible para que su estancia sea inolvidable."
    ],
    "nl": [
      "Op zoek naar een hotel? Ga dan naar Actuel Hôtel! Ideaal gelegen vlakbij treinstation Chambéry, garandeert het hotel een thuisgevoel. Het vriendelijke en behulpzame team zal er alles aan doen om uw verblijf onvergetelijk te maken!"
    ]
  },
