  "rdfs:comment": {
    "de": [
      "Reiseleiter, der Outdoor-Sportarten betreibt: Fahrrad, Motorrad und Flüsse. Ich bereise die Cevennen von der Ardèche bis zur Lozère vom Land, aus der Luft und vom Wasser aus zu allen vier Jahreszeiten."
    ],
    "en": [
      "Outdoor sports guide and coach : cycling, motorcycling and rivers."
    ],
    "it": [
      "Guida e istruttore di sport all'aria aperta: ciclismo, motociclismo e fiumi. Percorro le Cévennes dall'Ardèche alla Lozère da terra, dall'aria e dall'acqua, in tutte e quattro le stagioni."
    ],
    "fr": [
      "Guide moniteur de sports de plein air : vélo, moto et rivières. Je parcours les Cévennes de l’Ardèche à la Lozère depuis la terre, les airs et l’eau, aux 4 saisons."
    ],
    "es": [
      "Guía e instructor de deportes al aire libre: ciclismo, motociclismo y ríos. Recorro las Cevenas desde el Ardèche hasta el Lozère por tierra, aire y agua, en las cuatro estaciones."
    ],
    "nl": [
      "Gids en instructeur voor buitensporten: fietsen, motorrijden en rivieren. Ik doorkruis de Cevennen van de Ardèche tot de Lozère vanaf de grond, de lucht en het water, in alle vier de seizoenen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Gayral Edmond - Guide Coach"
    ],
    "fr": [
      "Gayral Edmond - Guide Moniteur"
    ]
  },
