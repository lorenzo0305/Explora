  "rdfs:comment": {
    "de": [
      "Im Herzen von Beauzac bietet Ihnen \"L'Inédit\" von Donnerstag bis Montag mittags und abends Snacks, Burger, Salate, Pizzas, Reibeplätzchen und Wurstwaren an. Vor Ort oder zum Mitnehmen. Bankkarte ab 15 Euro."
    ],
    "en": [
      "In the heart of Beauzac, \"L'Inédit\" offers snacks, burgers, salads, pizzas, grated cheese and charcuterie from Thursday to Monday lunchtime and evening. On site or takeaway. Credit card from 15 euros."
    ],
    "it": [
      "Nel cuore di Beauzac, \"L'Inédit\" serve snack, hamburger, insalate, pizze, formaggi grattugiati e salumi dal giovedì al lunedì a pranzo e la sera. Sul posto o da asporto. Carta di credito a partire da 15 euro."
    ],
    "fr": [
      "Au cœur de Beauzac \"L'Inédit\" vous propose snacks, burgers, salades, pizzas, râpé et charcuterie du jeudi au lundi midi et soir. Sur place ou à emporter. Carte Bancaire à partir de 15 euros."
    ],
    "nl": [
      "In het hart van Beauzac serveert \"L'Inédit\" van donderdag tot maandag 's middags en 's avonds snacks, hamburgers, salades, pizza's, geraspte kaas en vleeswaren. Ter plaatse of om mee te nemen. Creditcard vanaf 15 euro."
    ],
    "es": [
      "En el corazón de Beauzac, \"L'Inédit\" sirve bocadillos, hamburguesas, ensaladas, pizzas, queso rallado y charcutería de jueves a lunes al mediodía y por la noche. En el lugar o para llevar. Tarjeta de crédito a partir de 15 euros."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Restaurant L'Inedit"
    ]
  },
