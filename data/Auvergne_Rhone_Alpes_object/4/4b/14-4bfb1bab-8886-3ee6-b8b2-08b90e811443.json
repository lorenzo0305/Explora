  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9973f298-801e-3ec2-b351-29728664bc5a",
      "dc:description": {
        "de": [
          "Besuchen Sie die Ausstellung von Frau Brigitte Parmentier an diesem schönen Ort.\nTäglich von 15.00 bis 18.00 Uhr\naußer mittwochs und sonntags"
        ],
        "en": [
          "Come and discover Madame Brigitte Parmentier's exhibition in this beautiful setting.\nEvery day from 3.00 pm to 6.00 pm\nexcept Wednesdays and Sundays"
        ],
        "it": [
          "Venite a scoprire la mostra di Brigitte Parmentier in questa splendida cornice.\nTutti i giorni dalle 15.00 alle 18.00\ntranne il mercoledì e la domenica"
        ],
        "fr": [
          "Venez découvrir l'exposition de Madame Brigitte Parmentier dans ce bel endroit. \nTous les jours de 15 h 00 à 18 h 00\nsauf les mercredis et dimanches"
        ],
        "es": [
          "Venga a descubrir la exposición de Brigitte Parmentier en este bello marco.\nTodos los días de 15.00 a 18.00 horas\nexcepto miércoles y domingos"
        ],
        "nl": [
          "Kom en ontdek de tentoonstelling van Brigitte Parmentier in deze prachtige omgeving.\nElke dag van 15.00 tot 18.00 uur\nbehalve woensdag en zondag"
        ]
      },
