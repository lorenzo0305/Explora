  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten von Val Thorens bietet das Restaurant Beca ein entspanntes bistronomisches Erlebnis. Die hausgemachte, großzügige und ehrliche Küche von Chefkoch Samuel Neveu lädt dazu ein, Klassiker aus den Alpen und der Bistronomie zu entdecken."
    ],
    "en": [
      "At the foot of the Val Thorens slopes, the Beca restaurant offers a relaxed bistronomic experience. Chef Samuel Neveu's generous and sincere home cooking invites you to discover Alpine classics and bistronomy."
    ],
    "it": [
      "Ai piedi delle piste di Val Thorens, il ristorante Beca offre un'esperienza bistronomica rilassata. La cucina casalinga generosa e sincera dello chef Samuel Neveu invita a scoprire i classici alpini e la bistronomia."
    ],
    "fr": [
      "Au pied des pistes de Val Thorens, le restaurant Beca propose une expérience bistronomique décontractée. La cuisine maison, généreuse et sincère du Chef Samuel Neveu invite à découvrir des classiques des Alpes et de la bistronomie."
    ],
    "nl": [
      "Aan de voet van de pistes van Val Thorens biedt restaurant Beca een ontspannen bistronomische ervaring. De gulle en oprechte thuiskeuken van chef-kok Samuel Neveu nodigt je uit om Alpenklassiekers en bistronomie te ontdekken."
    ],
    "es": [
      "A los pies de las pistas de Val Thorens, el restaurante Beca ofrece una experiencia bistronómica relajada. La cocina casera, generosa y sincera del Chef Samuel Neveu le invita a descubrir los clásicos alpinos y la bistronomía."
    ]
  },
