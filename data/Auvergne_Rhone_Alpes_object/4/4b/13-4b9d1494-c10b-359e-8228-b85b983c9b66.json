  "rdfs:comment": {
    "de": [
      "Der Abenteuerpark Fort de Tamié liegt zwischen Albertville und Faverges, in der Nähe des Col de Tamié auf 1000 m Höhe. Auf einer Fläche von 8 Hektar können Sie hier Naturerfahrungen sammeln!"
    ],
    "en": [
      "Located between Albertville and Faverges, close to col de Tamié pass at a 1000m of altitude, the adventure park of Tamié Fort with a 8 hectares surface area allows you to enjoy exepriences in the midst of nature!"
    ],
    "it": [
      "Situato tra Albertville e Faverges, vicino al colle di Tamié, a 1000 metri di altitudine, il parco avventura Fort de Tamié si estende su una superficie di 8 ettari e vi permetterà di vivere un'esperienza all'aria aperta!"
    ],
    "fr": [
      "Situé entre Albertville et Faverges, proche du col de Tamié, à 1000 mètres d'altitude, le parc aventure du Fort de Tamié d’une superficie de 8 hectares vous permettra de vivre des expériences de pleine nature !"
    ],
    "es": [
      "Situado entre Albertville y Faverges, cerca del puerto de Tamié, a 1.000 metros de altitud, el parque de aventuras Fort de Tamié ocupa 8 hectáreas y le ofrece la posibilidad de vivir una experiencia al aire libre"
    ],
    "nl": [
      "Het avonturenpark Fort de Tamié, gelegen tussen Albertville en Faverges, vlakbij de pas van Tamié, op een hoogte van 1000 meter, beslaat 8 hectare en biedt u de mogelijkheid om de natuur te beleven!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Fort de Tamié adventure trail"
    ],
    "fr": [
      "Parcours aventure du Fort de Tamié"
    ]
  },
