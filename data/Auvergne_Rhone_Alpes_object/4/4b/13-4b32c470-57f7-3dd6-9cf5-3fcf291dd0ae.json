  "rdfs:comment": {
    "de": [
      "EINE NEUE ERFAHRUNG IN DER HÖHE: PopAlp la Plagne - 4* Hotel: Eine traumhafte Lage: im Herzen von La Plagne Centre, mit Zugang zu den Skiern bis zu den Füßen. Vergessen Sie die traditionellen Chalets: hier ist Platz für ein auffälliges Design und vibrierende Farben."
    ],
    "en": [
      "A NEW ALTITUDE EXPERIENCE: PopAlp La Plagne - 4* hotel: The perfect location: right in the centre of Plagne Centre, with ski-in, ski-out access. Forget chalets in traditional style: we have opted for a striking design and vibrant colours"
    ],
    "it": [
      "UNA NUOVA ESPERIENZA DI ALTITUDINE: PopAlp la Plagne - Hotel 4*: Una posizione da sogno: nel cuore di La Plagne Centre, con accesso ski-to-door. Dimenticate gli chalet tradizionali: qui l'accento è posto su un design sfolgorante e su colori vivaci."
    ],
    "fr": [
      "UNE NOUVELLE EXPERIENCE EN ALTITUDE  : PopAlp la Plagne - Hôtel 4* : Un emplacement de rêve : au cœur de La Plagne Centre, avec un accès skis aux pieds. Oubliez les chalets traditionnels : ici, place à un design éclatant et des couleurs vibrantes."
    ],
    "es": [
      "UNA NUEVA EXPERIENCIA DE ALTITUD: PopAlp la Plagne - Hotel 4*: Una ubicación de ensueño: en pleno centro de La Plagne, con acceso directo a las pistas de esquí. Olvídese de los chalés tradicionales: aquí se apuesta por un diseño deslumbrante y colores vibrantes."
    ],
    "nl": [
      "EEN NIEUWE ALTITUDE ERVARING: PopAlp la Plagne - 4* Hotel: Een droomlocatie: in het hart van La Plagne Centre, met ski-to-deur toegang. Vergeet de traditionele chalets: hier ligt de nadruk op oogverblindend design en levendige kleuren."
    ]
  },
