  "rdfs:comment": {
    "de": [
      "Die Region Pilat war aufgrund ihrer Lage in der Nähe von Lyon einer der Schwerpunkte der Musselinherstellung. Als Erben dieser Tradition bieten wir Schals aus Musselin, Crêpe und Schappes an."
    ],
    "en": [
      "The Pilat, because of its location near to Lyon, was one of the poles of the manufacture of silk muslin. Heir of this tradition, we propose scarves in muslin, crèpe, schappe."
    ],
    "it": [
      "Grazie alla sua vicinanza a Lione, Pilat era uno dei centri di produzione di mussole di seta. Ereditando questa tradizione, proponiamo sciarpe in chiffon, crèpe e schappe."
    ],
    "fr": [
      "Le Pilat, du fait de sa situation proche de Lyon fut un des pôles de la fabrication de la mousseline soie. Héritier de cette tradition, nous proposons foulards en mousseline, crèpe, schappe."
    ],
    "nl": [
      "Vanwege de nabijheid van Lyon was Pilat een van de centra voor de productie van zijden mousseline. In navolging van deze traditie bieden wij chiffon, crèpe en schappe sjaals aan."
    ],
    "es": [
      "Por su proximidad a Lyon, Pilat fue uno de los centros de producción de muselina de seda. Herederos de esta tradición, ofrecemos pañuelos de gasa, crèpe y schappe."
    ]
  },
  "rdfs:label": {
