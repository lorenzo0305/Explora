  "rdfs:comment": {
    "de": [
      "Place de a résistance, im Herzen von Allevard, hier finden Sie die Bar l'Escale. Mit ihrer großen Terrasse ist sie der ideale Ort für ein Getränk oder ein Eis in der Sonne."
    ],
    "en": [
      "Place de a résistance, in the heart of Allevard, this is where you will find Le bar l'Escale. With its large Terrace, it is the ideal place for a drink or an ice cream in the sun."
    ],
    "it": [
      "In Place de a résistance, nel cuore di Allevard, si trova il bar l'Escale che, con la sua ampia terrazza, è il luogo ideale per un drink o un gelato al sole."
    ],
    "fr": [
      "Place de a résistance, en plein cœur d'Allevard, c'est là que vous trouverez Le bar l'Escale. avec sa grande Terrasse, c'est l'endroit idéal pour une boisson ou une glace au soleil."
    ],
    "nl": [
      "Op de Place de a résistance, in het hart van Allevard, vindt u Le bar l'Escale. Met zijn grote terras is het de ideale plek voor een drankje of een ijsje in de zon."
    ],
    "es": [
      "En la Place de a résistance, en el corazón del Allevard, se encuentra el bar l'Escale. Con su amplia terraza, es el lugar ideal para tomar una copa o un helado al sol."
    ]
  },
