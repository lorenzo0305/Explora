  "rdfs:comment": {
    "de": [
      "Ein Restaurant im zeitgenössischen Stil, ein herzlicher Empfang, eine schmackhafte Küche, die ständig erneuert wird und bei der lokale Produkte im Vordergrund stehen. Spezialmenü des Michelin-Führers für 37?"
    ],
    "en": [
      "A contemporary style restaurant, a warm welcome, delicious cuisine constantly renewed with a priority on local products."
    ],
    "it": [
      "Un ristorante dallo stile contemporaneo, un'accoglienza calorosa, una cucina gustosa e costantemente rinnovata, con un'attenzione particolare ai prodotti locali. Menu speciale della Guida Michelin al 37?"
    ],
    "fr": [
      "Un restaurant au style contemporain, un accueil chaleureux, une cuisine savoureuse sans cesse renouvelée avec une priorité sur les produits locaux. Menu spécial Guide Michelin à 37 €."
    ],
    "es": [
      "Restaurante de estilo contemporáneo, cálida acogida, sabrosa cocina en constante renovación, centrada en los productos locales. Menú especial Guía Michelin a 37?"
    ],
    "nl": [
      "Een restaurant met een eigentijdse stijl, een warm welkom, een smakelijke keuken die voortdurend wordt vernieuwd, met de nadruk op lokale producten. Speciaal Michelin-gidsmenu op 37?"
    ]
  },
