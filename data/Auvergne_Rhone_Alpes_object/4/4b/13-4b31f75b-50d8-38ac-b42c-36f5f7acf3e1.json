  "rdfs:comment": {
    "de": [
      "Inmitten einer außergewöhnlichen Naturlandschaft bietet Ihnen der Espace Nature et Loisirs du Collet Multisportplätze für Tennis, Pickleball und andere Ballsportarten im Freien."
    ],
    "en": [
      "Set in a stunning natural environment, the Nature and Leisure Area of Le Collet offers multisport courts where you can enjoy tennis, pickleball, and other ball games in the open air"
    ],
    "it": [
      "Nel cuore di un contesto naturale eccezionale, l'Espace Nature et Loisirs du Collet offre campi polisportivi per il tennis, il pickleball e altri sport con la palla all'aperto."
    ],
    "fr": [
      "Au cœur d’un cadre naturel exceptionnel, l’Espace Nature et Loisirs du Collet vous propose des terrains multisports adaptés à la pratique du tennis, pickleball et d’autres sports de balle en plein air."
    ],
    "nl": [
      "In een prachtige natuurlijke omgeving biedt het Natuur- en Recreatiegebied van Le Collet multisportterreinen waar je kan tennissen, pickleball spelen of genieten van andere balspelen in de buitenlucht."
    ],
    "es": [
      "En el corazón de un entorno natural excepcional, el Espace Nature et Loisirs du Collet ofrece pistas polideportivas para practicar tenis, pickleball y otros deportes de pelota al aire libre."
    ]
  },
  "rdfs:label": {
    "en": [
