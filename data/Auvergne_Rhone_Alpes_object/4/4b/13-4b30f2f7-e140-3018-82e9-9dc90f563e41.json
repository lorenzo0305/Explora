  "rdfs:comment": {
    "de": [
      "Dieses Restaurant am Fuße der Skipisten bietet ein außergewöhnliches Panorama auf Belledonne, den Mont Blanc und die Dent de Crolles.\r\nSonnenterrasse, gut zubereitete und reichhaltige Gerichte, lokale Biere, Bouleplatz, Spiele für drinnen und draußen, Konzerte"
    ],
    "en": [
      "This restaurant is located at the foot of the ski slopes, offering panoramic views of the surrounding mountains and the Dent de Crolles. \r\nEnjoy the fresh mountain air and traditional dishes on the sunny terrace!"
    ],
    "it": [
      "Questo ristorante ai piedi delle piste da sci offre una vista eccezionale su Belledonne, il Monte Bianco e la Dent de Crolles.\r\nTerrazza soleggiata, piatti abbondanti, birre locali, campo da pétanque, giochi al coperto e all'aperto, concerti, ecc"
    ],
    "fr": [
      "Ce restaurant au pied des pistes de ski, offre un panorama exceptionnel sur Belledonne, le Mont Blanc et la Dent de Crolles.\r\nTerrasse ensoleillée, plats travaillés et copieux, bières locales, terrain de pétanques, jeux d'intérieur et d'extérieur, concerts"
    ],
    "nl": [
      "Restaurant aan de voet van de skipistes met panoramisch uitzicht op de omliggende bergen en de Dent de Crolles. \r\nGeniet van de frisse berglucht en traditionele gerechten op het zonnige terras!"
    ],
    "es": [
      "Este restaurante al pie de las pistas de esquí ofrece unas vistas excepcionales de Belledonne, el Mont Blanc y la Dent de Crolles.\r\nTerraza soleada, platos copiosos, cervezas locales, pista de petanca, juegos de interior y exterior, conciertos, etc"
    ]
  },
  "rdfs:label": {
    "en": [
