  "rdfs:comment": {
    "de": [
      "Der Abenteuerpark \"D'un arbre à l'autre\" bietet Parcours in den Bäumen für alle (ab 3 Jahren).\r\nIn 1500 m Höhe, zwischen Le Revard und La Féclaz, gibt es mehr als 135 Workshops und Spiele, verteilt auf 12 Parcours und 2 Kletterwerkstätten."
    ],
    "en": [
      "The \"D'un arbre à l'autre\" adventure park offers routes for all ages (from 3 years upwards).\r\nAt 1500m altitude, between Le Revard and La Féclaz, more than 135 workshops and games spread over 12 courses and 2 climbing workshops."
    ],
    "it": [
      "Il parco avventura \"D'un arbre à l'autre\" offre percorsi per tutte le età (dai 3 anni in su).\r\nA 1500m d'altitudine, tra Le Revard e La Féclaz, più di 135 laboratori e giochi ripartiti su 12 percorsi e 2 laboratori di arrampicata."
    ],
    "fr": [
      "Le Parc aventure \"D'un arbre à l'autre\" propose des parcours dans les arbres pour tous (dès 3 ans).\r\nÀ 1500m d'altitude, entre Le Revard et La Féclaz, plus de 135 ateliers et jeux repartis sur 12 parcours et 2 ateliers d'escalade."
    ],
    "nl": [
      "Het avonturenpark \"D'un arbre à l'autre\" biedt boomparcours voor alle leeftijden (vanaf 3 jaar).\r\nOp 1500 m hoogte, tussen Le Revard en La Féclaz, zijn er meer dan 135 workshops en spellen verdeeld over 12 parcours en 2 klimworkshops."
    ],
    "es": [
      "El parque de aventuras \"D'un arbre à l'autre\" ofrece recorridos en los árboles para todas las edades (a partir de 3 años).\r\nA 1500 m de altitud, entre Le Revard y La Féclaz, hay más de 135 talleres y juegos repartidos en 12 recorridos y 2 talleres de escalada."
    ]
  },
  "rdfs:label": {
