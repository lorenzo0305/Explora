  "rdfs:comment": {
    "de": [
      "In ihrer 17. Ausgabe bieten Ihnen die Celti'cimes ein großes Konzert! Im ersten Teil spielt der Schotte Calum Stewart am Dudelsack im Trio mit dem Bretonen Yann Le Bozec am Bouzouki und der Tänzerin Sophie Stephenson, bevor die Gruppe Solas auftritt!"
    ],
    "en": [
      "For their 17th edition, the Celti'cimes offer you a great concert! In the 1st half, Scotland's Calum Stewart on bagpipes in a trio with Breton Yann Le Bozec on bouzouki and dancer Sophie Stephenson, before giving way to the group Solas!"
    ],
    "it": [
      "Per la sua 17a edizione, Celti'cimes vi propone un grande concerto! Nel primo tempo, il pifferaio scozzese Calum Stewart in trio con il bretone Yann Le Bozec al bouzouki e la ballerina Sophie Stephenson, prima di lasciare spazio al gruppo Solas!"
    ],
    "fr": [
      "Pour leur 17ème édition, les Celti'cimes vous offrent un grand concert ! En 1ère partie l'écossais Calum Stewart à la cornemuse en trio avec le breton Yann Le Bozec au bouzouki et la danseuse Sophie Stephenson, avant de laisser place au groupe Solas !"
    ],
    "es": [
      "¡Para su 17ª edición, Celti'cimes le ofrece un gran concierto! En la 1ª parte, el gaitero escocés Calum Stewart en trío con el bretón Yann Le Bozec al buzuki y la bailarina Sophie Stephenson, ¡antes de dar paso al grupo Solas!"
    ],
    "nl": [
      "Voor haar 17e editie biedt Celti'cimes u een geweldig concert! In de 1e helft de Schotse piper Calum Stewart in een trio met de Bretoense Yann Le Bozec op de bouzouki en danseres Sophie Stephenson, om daarna plaats te maken voor de groep Solas!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Calum Stewart Trio concert with Yann Le Bozec & Sophie Stephenson and Solas - Celti'Cimes"
    ],
    "fr": [
      "Concert Calum Stewart Trio avec Yann Le Bozec & Sophie Stephenson et Solas - Celti'Cimes"
    ]
  },
