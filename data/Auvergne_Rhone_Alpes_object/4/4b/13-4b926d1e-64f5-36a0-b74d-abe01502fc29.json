  "rdfs:comment": {
    "de": [
      "Als emblematische Gruppe der Insel Beauté bieten I Messageri eine Klangreise zwischen Tradition und Moderne, die von kraftvollen Stimmen und einer reichhaltigen Instrumentierung getragen wird."
    ],
    "en": [
      "An iconic group from the Isle of Beauty, I Messageri offers a musical journey between tradition and modernity, carried by powerful voices and rich instrumentation."
    ],
    "it": [
      "Gruppo emblematico dell'isola della Bellezza, I Messageri propongono un viaggio sonoro tra tradizione e modernità, guidato da voci potenti e da una ricca strumentazione."
    ],
    "fr": [
      "Groupe emblématique de l'île de Beauté, I Messageri propose un voyage sonore entre tradition et modernité, porté par des voix puissantes et une instrumentation riche."
    ],
    "nl": [
      "I Messageri, een emblematische groep van het eiland Schoonheid, biedt een sonische reis tussen traditie en moderniteit, gedreven door krachtige stemmen en rijke instrumentatie."
    ],
    "es": [
      "Grupo emblemático de la isla de la Belleza, I Messageri ofrece un viaje sonoro entre la tradición y la modernidad, impulsado por potentes voces y una rica instrumentación."
    ]
