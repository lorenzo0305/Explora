  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9f67bb2c-f0ac-3375-83a9-873e1dbc07e3",
      "dc:description": {
        "de": [
          "La Loi des Cartes ist ein Club, der allen offen steht, um sich bei Gesellschaftsspielen und anderen spielerischen Aktivitäten auszutauschen und zu sympathisieren.\n\nAn den Wochenenden 14-17 Uhr oder 20-23 Uhr"
        ],
        "en": [
          "La Loi des Cartes is a club open to all to exchange and sympathize around board games and other fun activities.\n\nThe weekends 14h-17h or 20h-23h"
        ],
        "it": [
          "La Loi des Cartes è un club aperto a tutti per scambiare e condividere giochi da tavolo e altre attività divertenti.\n\nFine settimana dalle 14.00 alle 17.00 o dalle 20.00 alle 23.00"
        ],
        "fr": [
          "La Loi des Cartes est un club ouvert à tous pour échanger et sympathiser autour des jeux de société et autres activités ludiques.\n\nLes weekends 14h-17h ou 20h-23h"
        ],
        "nl": [
          "La Loi des Cartes is een club die openstaat voor iedereen om uit te wisselen en te sympathiseren rond gezelschapsspelen en andere leuke activiteiten.\n\nWeekends 14 tot 17 uur of 20 tot 23 uur"
        ],
        "es": [
          "La Loi des Cartes es un club abierto a todos para intercambiar y simpatizar en torno a los juegos de mesa y otras actividades divertidas.\n\nFines de semana 2-5pm o 8-11pm"
        ]
      },
