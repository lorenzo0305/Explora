  "rdfs:comment": {
    "de": [
      "Im Herzen des Weinbaugebiets Beaujolais, zwischen den Weinbergen des Cru Morgon, ist das Hotel ideal, um eine freundliche Atmosphäre, eine authentische Küche sowie einen Seminarbereich zu genießen."
    ],
    "en": [
      "In the heart of Beaujolais Winery, between the vines of cru Morgon, the hotel is ideal for enjoying a friendly atmosphere, an authentic cuisine, and a conference area."
    ],
    "it": [
      "Nel cuore dei vigneti del Beaujolais, tra le viti del cru Morgon, l'hotel è ideale per godere di un'atmosfera accogliente, di una cucina autentica e di un'area per seminari."
    ],
    "fr": [
      "Au cœur du vignoble Beaujolais, entre les vignes du cru Morgon, l'hôtel est idéal pour profiter d'une ambiance conviviale, une cuisine authentique, ainsi qu'un espace séminaire."
    ],
    "nl": [
      "In het hart van de Beaujolais wijngaarden, tussen de wijnstokken van de Morgon cru, is het hotel ideaal om te genieten van een vriendelijke sfeer, een authentieke keuken en een seminarieruimte."
    ],
    "es": [
      "En el corazón de los viñedos de Beaujolais, entre las vides del cru Morgon, el hotel es ideal para disfrutar de un ambiente acogedor, una cocina auténtica y un espacio para seminarios."
    ]
  },
