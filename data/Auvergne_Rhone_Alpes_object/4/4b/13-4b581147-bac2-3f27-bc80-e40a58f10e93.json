  "rdfs:comment": {
    "de": [
      "Dieses Design-Hotel mit  Blick auf den Golfplatz und die Forez-Ebene liegt fünf Minuten entfernt vom Stadtzentrum, Stadion Guichard, Zénith, Cité du Design, Musée d'Art Moderne, Parc des Expositions und Bahnhof Châteaucreux"
    ],
    "en": [
      "Hôtel Design has splendid views of the golf course and Plaine du Forez. Located just 5 minutes from the town centre, Zénith, Geoffroy Guichard stadium, Cité du Design, Musée d'Art Moderne, Parc des Expositions and Châteaucreux train station."
    ],
    "it": [
      "Hotel di design con vista panoramica sul campo da golf e sulla Plaine du Forez, si trova a cinque minuti dal centro città, dallo stadio G. Guichard, dallo Zénith, dalla Cité du Design, dal Museo d'Arte Moderna, dal Centro Esposizioni e dalla stazione TGV di Châteaucreux."
    ],
    "fr": [
      "Hôtel Design avec vue panoramique sur le golf et la Plaine du Forez, il est à cinq minutes du centre ville, du stade G. Guichard, du Zénith, de la Cité du Design, du Musée d'Art Moderne, du Parc des Expositions et de la gare TGV Châteaucreux."
    ],
    "es": [
      "Hotel de diseño con vistas panorámicas al campo de golf y a la Plaine du Forez, está a cinco minutos del centro de la ciudad, del estadio G. Guichard, del Zénith, de la Cité du Design, del Museo de Arte Moderno, del Centro de Exposiciones y de la estación de TGV de Châteaucreux."
    ],
    "nl": [
      "Designhotel met een panoramisch uitzicht op de golfbaan en het Plaine du Forez, op vijf minuten van het stadscentrum, het G. Guichard-stadion, het Zenith, de Cité du Design, het Museum voor Moderne Kunst, het expositiecentrum en het TGV-station van Châteaucreux."
    ]
  },
