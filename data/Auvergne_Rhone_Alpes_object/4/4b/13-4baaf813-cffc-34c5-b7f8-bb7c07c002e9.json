  "rdfs:comment": {
    "de": [
      "Spirulina La Craquante wird in der Ferme du Serre im Herzen der Ardèche produziert, geerntet, getrocknet und verpackt. Unsere Spirulina, ein Lebensmittel mit bemerkenswerten Nährwerten, wird in Form von Flocken oder Pulver angeboten."
    ],
    "en": [
      "La Craquante spirulina is produced, harvested, dried and packaged at Ferme du Serre, located in the heart of the the Ardèche department Our spirulina — a food with remarkable nutritional qualities — comes in flake or powder form."
    ],
    "it": [
      "La spirulina La Craquante è prodotta, raccolta, essiccata e confezionata alla Ferme du Serre, nel cuore dell'Ardèche. La nostra spirulina - un alimento dalle notevoli qualità nutrizionali - è disponibile in fiocchi o in polvere."
    ],
    "fr": [
      "La spiruline La Craquante est produite, récoltée, séchée,et conditionnée à la Ferme du Serre, située au cœur de l’Ardèche. Notre spiruline — aliment aux qualités nutritives remarquables — se présente sous forme de paillettes ou en poudre."
    ],
    "es": [
      "La espirulina La Craquante se produce, cosecha, seca y envasa en la Ferme du Serre, en el corazón de la Ardèche. Nuestra espirulina, un alimento con notables cualidades nutritivas, se presenta en copos o en polvo."
    ],
    "nl": [
      "De spirulina van La Craquante wordt geproduceerd, geoogst, gedroogd en verpakt in de Ferme du Serre, in het hart van de Ardèche. Onze spirulina - een voedingsmiddel met opmerkelijke voedingseigenschappen - is verkrijgbaar in vlokken of poeder."
    ]
  },
