      "@id": "https://data.datatourisme.fr/a31ba0d5-f7b9-368c-9183-86047d263462",
      "dc:description": {
        "de": [
          "Verkauf von Obst/Gemüse\nGetränke\nSelbst hergestelltes Eis\nLokale Produkte\nFeinkostladen\nSahnefabrik\nKurzer Weg\nLieferung nach Hause\nWorld Relay relay und Vinted go\n\nAnti-Verbraucher-Ansatz"
        ],
        "en": [
          "Fruit and vegetable sales\nBeverages\nHome-made ice creams\nLocal products\nDelicatessen\nCreamery\nCircuit court\nHome delivery\nRelais mondial relay and Vinted go\n\nAnti-gaspi\" approach"
        ],
        "it": [
          "Vendita di frutta e verdura\nBevande\nGelati artigianali\nProdotti locali\nGastronomia\nCremeria\nFiliera corta\nConsegna a domicilio\nRelais mondial e Vinted go\n\nApproccio \"anti-gaspi"
        ],
        "fr": [
          "Vente de fruits/légumes\nBoissons\nGlaces artisanaux\nProduits locaux\nEpicerie fine\nCrémerie\nCircuit court\nLivraison à domicile\nRelais mondial relay et Vinted go\n\nDémarche \"Anti-gaspi\""
        ],
        "es": [
          "Venta de frutas y hortalizas\nBebidas\nHelados caseros\nProductos locales\nCharcutería\nCremería\nCadena de suministro corta\nEntrega a domicilio\nRelais mondial relay y Vinted go\n\nEnfoque \"antigaspi"
        ],
        "nl": [
          "Groente- en fruitverkoop\nDranken\nHuisgemaakt ijs\nLokale producten\nDelicatessen\nSlagerij\nKorte leveringsketen\nThuisbezorging\nRelais mondial estafette en Vinted go\n\nAnti-gaspi\" aanpak"
        ]
      },
