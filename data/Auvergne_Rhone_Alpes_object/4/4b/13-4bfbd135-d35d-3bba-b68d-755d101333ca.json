  "rdfs:comment": {
    "de": [
      "Onsimé? begleitet Unternehmen, Event-Ersteller, Vereine und Körperschaften im Vercors und in der Region Grenoble bei ihrem ökologischen Wandel."
    ],
    "en": [
      "Onsimé? supports companies, event organizers, associations and local authorities in the Vercors and Grenoble regions in their ecological transition."
    ],
    "it": [
      "Onsimé? sostiene le imprese, gli organizzatori di eventi, le associazioni e le autorità locali delle regioni del Vercors e di Grenoble nei loro sforzi per passare a un futuro più verde."
    ],
    "fr": [
      "Onsimé ? accompagne les entreprises, créateurs d’évènements, associations et collectivités, dans le Vercors et sur la région grenobloise, dans leur démarche de transition écologique."
    ],
    "nl": [
      "Onsimé? ondersteunt bedrijven, organisatoren van evenementen, verenigingen en lokale overheden in de regio's Vercors en Grenoble bij hun inspanningen voor een groenere toekomst."
    ],
    "es": [
      "Onsimé? apoya a empresas, organizadores de eventos, asociaciones y autoridades locales de las regiones de Vercors y Grenoble en sus esfuerzos por hacer la transición hacia un futuro más ecológico."
    ]
  },
