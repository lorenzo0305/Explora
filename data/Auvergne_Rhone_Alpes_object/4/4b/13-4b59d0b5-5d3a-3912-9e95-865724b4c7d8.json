  "rdfs:comment": {
    "de": [
      "In diesem halbgastronomischen Restaurant in der historischen Oberstadt von Le Puy-en-Velay werden die regionalen Produkte gekonnt zu einer kreativen, raffinierten und farbenfrohen Küche verarbeitet."
    ],
    "en": [
      "In this semi-gastronomic restaurant in the historic upper town of Le Puy-en-Velay, regional products are skilfully worked into a creative, refined and colorful cuisine."
    ],
    "it": [
      "In questo ristorante semi-gastronomico nel centro storico di Le Puy-en-Velay, i prodotti regionali vengono sapientemente utilizzati per creare una cucina creativa, raffinata e colorata."
    ],
    "fr": [
      "Dans ce restaurant semi-gastronomique en haute ville historique du Puy-en-Velay les produits régionaux sont  savamment travaillés pour une cuisine créative, raffinée et colorée."
    ],
    "nl": [
      "In dit semi-gastronomische restaurant in het historische centrum van Le Puy-en-Velay worden regionale producten vakkundig gebruikt om een creatieve, verfijnde en kleurrijke keuken te creëren."
    ],
    "es": [
      "En este restaurante semigastronómico del centro histórico de Le Puy-en-Velay, los productos regionales se utilizan con maestría para crear una cocina creativa, refinada y colorista."
    ]
  },
  "rdfs:label": {
