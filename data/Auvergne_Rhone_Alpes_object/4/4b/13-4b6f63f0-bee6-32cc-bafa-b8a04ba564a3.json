  "rdfs:comment": {
    "de": [
      "Museum, das dem 20. Jahrhundert in der ländlichen Welt gewidmet ist (Landwirtschaft, ländliche Geschäfte und Berufe, Volkskunst und lokale Geschichte)."
    ],
    "en": [
      "Museum dedicated to the rural world in the 20th century: agriculture, trade, rural crafts, folk art and local history.\r\nExhibition until 5 July: ‘The Pastourelles of the League of Auvergne and from the Massif central’.\r\n3 exhibitions until 28 September: \r\n-‘Miniature Cantal’, models by Robert Goudergues, \r\n-‘Henri Favre, the 1950s of an advertising designer’,\r\n-‘Créations singulières’, the singular artists in the collection,\r\nAnd from 20 July, the exhibition ‘Fouchtra! The invention of the Auvergnat in 19th-century Paris’."
    ],
    "it": [
      "Museo dedicato al XX secolo nel mondo rurale (agricoltura, artigianato rurale, arte popolare e storia locale)."
    ],
    "fr": [
      "Musée consacré au XXe siècle dans le monde rural (agriculture, commerces et métiers ruraux, art populaire et histoire locale)."
    ],
    "nl": [
      "Museum gewijd aan de landelijke wereld in de 20e eeuw: landbouw, handel, landelijke ambachten, volkskunst en lokale geschiedenis.\r\nTot 5 juli, tentoonstelling ‘De Pastourelles van de Liga van Auvergne en uit het Centraal Massief’.\r\nTot 28 september, 3 tentoonstellingen:\r\n-“Miniatuur Cantal\", maquettes van Robert Goudergues, \r\n-“Henri Favre, de jaren 1950 van een reclameontwerper”,\r\n- “Créations singulières”, de bijzondere kunstenaars in de collectie,\r\nEn vanaf 20 juli de tentoonstelling “Fouchtra! De uitvinding van de Auvergnat in het 19e-eeuwse Parijs”."
    ],
    "es": [
      "Museo dedicado al siglo XX en el mundo rural (agricultura, oficios y artesanía rurales, arte popular e historia local)."
    ]
  },
