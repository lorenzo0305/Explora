  "rdfs:comment": {
    "de": [
      "Die Kirche, in der der heilige Franz von Sales getauft und zum Bischof geweiht wurde, hat ihren alten Chor aus dem 15."
    ],
    "en": [
      "The church in which Saint François de Sales was baptized and consecrated bishop has preserved its original 15th-century choir."
    ],
    "it": [
      "La chiesa in cui San Francesco di Sales fu battezzato e consacrato vescovo ha conservato l'antico coro del XV secolo."
    ],
    "fr": [
      "L'Eglise dans laquelle fut baptisé et consacré évêque Saint François de Sales a conservé son choeur ancien du 15ème siècle."
    ],
    "es": [
      "La iglesia en la que fue bautizado y consagrado obispo San Francisco de Sales conserva su antiguo coro del siglo XV."
    ],
    "nl": [
