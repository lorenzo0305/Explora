  "rdfs:comment": {
    "de": [
      "Picknickplatz mit einem Tisch auf einer Grasfläche. Er befindet sich in einer Sackgasse, die zu einem kleinen Weg führt, den man zu Fuß gehen kann."
    ],
    "en": [
      "Picnic area with a table on a grassy area. Located in a dead end street leading to a small path that can be used on foot."
    ],
    "it": [
      "Area picnic con tavolo su un'area erbosa. Si trova in una strada senza uscita che conduce a un piccolo sentiero pedonale."
    ],
    "fr": [
      "Aire de pique-nique aménagée d'une table sur un espace enherbé. Située dans une impasse menant à un petit chemin qu'il est possible d'emprunter à pied."
    ],
    "es": [
      "Área de picnic con una mesa en una zona de césped. Situado en una calle sin salida que conduce a un pequeño sendero."
    ],
    "nl": [
      "Picknickplaats met een tafel op een grasveld. Gelegen in een doodlopende straat die leidt naar een klein voetpad."
    ]
  },
