  "rdfs:comment": {
    "de": [
      "Im Herzen des Freizeitgebiets Hurongues gelegen, ist der gleichnamige See der ideale Ort für Spaziergänge und zum Angeln."
    ],
    "en": [
      "Located at the heart of the Hurongues leisure area, the lake of the same name is the ideal place for walking and fishing."
    ],
    "it": [
      "Situato nel cuore dell'area ricreativa di Hurongues, l'omonimo lago è il luogo ideale per passeggiate e pesca."
    ],
    "fr": [
      "Situé au cœur de la zone de loisir de Hurongues, le plan d’eau du même nom est le lieu idéal pour la promenade et la pêche."
    ],
    "es": [
      "Situado en el corazón de la zona de ocio de las Hurongues, el lago del mismo nombre es el lugar ideal para pasear y pescar."
    ],
    "nl": [
      "Het gelijknamige meer ligt in het hart van het recreatiegebied Hurongues en is de ideale plek om te wandelen en te vissen."
    ]
  },
