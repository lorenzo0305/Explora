  "rdfs:comment": {
    "de": [
      "Alban, Bénédicte, Laurie, Lola und Valérie heißen Sie das ganze Jahr über willkommen und helfen Ihnen, Ihren Aufenthalt in C?ur de Tarentaise in vollen Zügen zu genießen!"
    ],
    "en": [
      "Alban, Bénédicte, Laurie, Lola et Valérie welcome you all year long and will help you to enjoy your stay in the heart of the Tarentaise Valley !"
    ],
    "it": [
      "Alban, Bénédicte, Laurie, Lola e Valérie vi accolgono tutto l'anno e vi aiutano a sfruttare al meglio il vostro soggiorno nel cuore della Tarentaise!"
    ],
    "fr": [
      "Alban, Bénédicte, Laurie, Lola et Valérie vous accueillent toute l'année et vous aideront à profiter pleinement de votre séjour en Cœur de Tarentaise !"
    ],
    "es": [
      "Alban, Bénédicte, Laurie, Lola y Valérie le dan la bienvenida todo el año y le ayudarán a aprovechar al máximo su estancia en el corazón de la Tarentaise"
    ],
    "nl": [
      "Alban, Bénédicte, Laurie, Lola en Valérie verwelkomen je het hele jaar door en helpen je het beste te maken van je verblijf in het hart van de Tarentaise!"
    ]
  },
