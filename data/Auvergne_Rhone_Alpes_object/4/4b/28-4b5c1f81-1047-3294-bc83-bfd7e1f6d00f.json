  "rdfs:comment": {
    "de": [
      "Familienworkshop im Museum\n---------------------------\n\n### Anhand der Blumen, die Sie in den Museumsräumen betrachten, gestalten Sie mit der ganzen Familie einen farbenfrohen Strauß mit verschiedenen und gut gesetzten Pinselstrichen.\n\nAktivität ab 7 Jahren."
    ],
    "en": [
      "Family workshop at the museum\n---------------------------\n\n### Take a look at the flowers in the museum's rooms, and as a family, create a colorful bouquet using a variety of well-placed brushstrokes.\n\nFor ages 7 and up."
    ],
    "it": [
      "Laboratorio per famiglie al museo\n---------------------------\n\n### Osservando i fiori presenti nelle sale del museo, tutta la famiglia può creare un bouquet colorato usando una varietà di pennellate ben posizionate.\n\nPer bambini dai 7 anni in su."
    ],
    "fr": [
      "Atelier en famille au musée\n---------------------------\n\n### Au regard des fleurs observées dans les salles du musée, réalisez, en famille, un bouquet haut en couleurs grâce à des touches de pinceaux variées et bien posées.\n\nActivité à partir de 7 ans."
    ],
    "es": [
      "Taller familiar en el museo\n---------------------------\n\n### Observando las flores de las salas del museo, toda la familia puede crear un colorido ramo con pinceladas bien colocadas.\n\nPara niños a partir de 7 años."
    ],
    "nl": [
      "Familie workshop in het museum\n---------------------------\n\n### Kijkend naar de bloemen in de museumzalen kan het hele gezin een kleurrijk boeket maken met behulp van goed geplaatste penseelstreken.\n\nVoor kinderen vanaf 7 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dites-le avec des fleurs !"
    ]
  },
