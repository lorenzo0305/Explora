  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Lac de la Taillat in Meylan, ein Gewässer der 2. Kategorie, das ideal für Angelfreunde ist. Genießen Sie die friedliche Umgebung für einen perfekten Tag am Wasser."
    ],
    "en": [
      "Discover Lac de la Taillat in Meylan, a 2nd category lake, ideal for fishing enthusiasts. Enjoy a peaceful setting for a perfect day at the water's edge."
    ],
    "it": [
      "Scoprite il Lac de la Taillat a Meylan, un lago di seconda categoria, ideale per gli amanti della pesca. Godetevi un ambiente tranquillo per una giornata perfetta in riva al mare."
    ],
    "fr": [
      "Découvrez le Lac de la Taillat à Meylan, un plan d'eau classé en 2ème catégorie, idéal pour les amateurs de pêche. Profitez d'un cadre paisible pour une journée parfaite au bord de l'eau."
    ],
    "nl": [
      "Ontdek Lac de la Taillat in Meylan, een meer van de 2e categorie, ideaal voor visliefhebbers. Geniet van een rustige omgeving voor een perfecte dag aan het water."
    ],
    "es": [
      "Descubra el Lac de la Taillat en Meylan, un lago de 2ª categoría, ideal para los aficionados a la pesca. Disfrute de un entorno tranquilo para pasar un día perfecto a orillas del agua."
    ]
  },
