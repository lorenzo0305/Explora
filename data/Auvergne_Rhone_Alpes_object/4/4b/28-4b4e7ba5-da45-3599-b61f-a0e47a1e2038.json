  "rdfs:comment": {
    "de": [
      "Les Marais Chauds ist ein Ort, an dem man gerne einkehrt, sowohl wegen seiner familiären und herzlichen Atmosphäre als auch wegen der traditionellen Küche, die Hausmannskost aus frischen Zutaten bevorzugt."
    ],
    "en": [
      "Les Marais Chauds is a place where it is good to stop, both for its warm and family atmosphere and for the traditional cuisine which favours home-cooking based on fresh products."
    ],
    "it": [
      "Les Marais Chauds è un ottimo luogo di sosta, sia per la sua calda atmosfera familiare che per la cucina tradizionale che privilegia la cucina casalinga con prodotti freschi."
    ],
    "fr": [
      "Les Marais Chauds est un endroit où il fait bon s'arrêter, tant pour son ambiance familiale et chaleureuse que pour la cuisine traditionnelle qui favorise la cuisine maison à base de produits frais."
    ],
    "nl": [
      "Les Marais Chauds is een geweldige plek om te stoppen, zowel voor de warme familiale sfeer als voor de traditionele keuken die de voorkeur geeft aan huisgemaakte gerechten met verse producten."
    ],
    "es": [
      "Les Marais Chauds es un gran lugar para detenerse, tanto por su cálido ambiente familiar como por la cocina tradicional que favorece la cocina casera con productos frescos."
    ]
  },
