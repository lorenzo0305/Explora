  "rdfs:comment": {
    "de": [
      "Gruppenunterkunft mit Empfangsraum, im Herzen des Dorfes Ouroux, in einer sehr schönen ländlichen Umgebung.\r\nDer Saal wird nur zusammen mit der gesamten Unterkunft vermietet."
    ],
    "en": [
      "Group gite with reception room, in the heart of the village of Ouroux, in a beautiful country setting.\r\nRoom only rented with the whole gîte."
    ],
    "it": [
      "Gîte di gruppo con sala di ricevimento, nel cuore del villaggio di Ouroux, in una splendida cornice rurale.\r\nLa camera può essere affittata solo con l'intero gîte."
    ],
    "fr": [
      "Gîte de groupe avec salle de réception, au coeur du village d'Ouroux, dans un très beau cadre champêtre.\r\nSalle louée uniquement avec l'ensemble du gîte."
    ],
    "nl": [
      "Groepsgîte met ontvangstruimte, in het hart van het dorp Ouroux, in een prachtige landelijke omgeving.\r\nDe kamer kan alleen met de hele gîte gehuurd worden."
    ],
    "es": [
      "Casa rural para grupos con sala de recepción, en el corazón del pueblo de Ouroux, en un hermoso entorno rural.\r\nLa habitación sólo se puede alquilar con toda la casa rural."
    ]
  },
