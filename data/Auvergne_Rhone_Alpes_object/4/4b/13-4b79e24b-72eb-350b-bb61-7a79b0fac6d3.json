  "rdfs:comment": {
    "de": [
      "Der Tempel von Taulignan ist einer von zehn Rundtempeln, die es in Frankreich gibt. Er ersetzt den ersten Tempel, der im 17. Jahrhundert zerstört wurde. Er stammt aus dem dritten Viertel des 19. Er wurde am 30. Juli 1870 eingeweiht und im Laufe des 20. Jahrhunderts mehrmals umgebaut."
    ],
    "en": [
      "The Taulignan temple is one of ten round temples in France. It replaces the first temple destroyed in the 17th century. It dates from the 3rd quarter of the 19th century. It was inaugurated on July 30, 1870, and underwent numerous alterations during the 20th century."
    ],
    "it": [
      "Il tempio di Taulignan è uno dei dieci templi rotondi esistenti in Francia. Sostituisce il primo tempio distrutto nel XVII secolo. Risale al terzo quarto del XIX secolo. Inaugurato il 30 luglio 1870, è stato ridisegnato più volte nel corso del XX secolo."
    ],
    "fr": [
      "Le temple de Taulignan est l'un des dix temples ronds existants en France. Il remplace le premier temple détruit au XVIIe siècle . Il date lui du 3ème quart du XIXe siècle. Il sera inauguré le 30 juillet 1870 et remanié de nombreuses fois courant XXe."
    ],
    "es": [
      "El templo de Taulignan es uno de los diez templos redondos existentes en Francia. Sustituye al primer templo destruido en el siglo XVII. Data del tercer cuarto del siglo XIX. Se inauguró el 30 de julio de 1870 y se rediseñó varias veces durante el siglo XX."
    ],
    "nl": [
      "De tempel van Taulignan is een van de tien ronde tempels in Frankrijk. Hij vervangt de eerste tempel die in de 17e eeuw werd verwoest. Hij dateert uit het 3e kwart van de 19e eeuw. Hij werd ingehuldigd op 30 juli 1870 en onderging talrijke verbouwingen in de 20e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Temple"
    ]
  },
