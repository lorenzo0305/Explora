  "rdfs:comment": {
    "de": [
      "Gravur auf Holz, Bambus und anderen personalisierbaren Materialien, Dekoration aus Treibholz.\r\nBestellmöglichkeit für Gewerbetreibende und Körperschaften, die Goodies herstellen lassen möchten."
    ],
    "en": [
      "Engraving on wood, bamboo and other customizable materials, driftwood decoration.\r\nOrders can be placed for professionals and local authorities who need goodies made."
    ],
    "it": [
      "Incisione su legno, bambù e altri materiali personalizzabili, decorazione di legni alla deriva.\r\nÈ possibile effettuare ordini per i professionisti e gli enti locali che necessitano di realizzare delle chicche."
    ],
    "fr": [
      "Gravure sur bois, bambou et autres matériaux personnalisables, décoration en bois flotté.\r\nCommande possible pour professionnel et collectivités qui ont besoin de faire réaliser des goodies."
    ],
    "nl": [
      "Graveren op hout, bamboe en andere aanpasbare materialen, decoratie van drijfhout.\r\nBestellingen kunnen worden geplaatst voor professionals en lokale overheden die goodies moeten laten maken."
    ],
    "es": [
      "Grabado en madera, bambú y otros materiales personalizables, decoración con madera flotante.\r\nSe pueden hacer pedidos para profesionales y autoridades locales que necesiten que se les confeccionen golosinas."
    ]
  },
