  "rdfs:comment": {
    "de": [
      "Genießen Sie unsere große Terrasse oder unsere beiden modern eingerichteten Säle, die für Ihren Komfort sorgen. Es stehen Ihnen verschiedene Angebote zur Verfügung, von der Saisonkarte bis hin zum Mittagsmenü finden Sie bestimmt das Richtige für Ihren Geschmack."
    ],
    "en": [
      "Take advantage of our large terrace or our two contemporary dining rooms, designed with your comfort in mind. We have a range of menus to suit all tastes, from seasonal menus to lunchtime specials."
    ],
    "it": [
      "Approfittate della nostra ampia terrazza o delle nostre due sale da pranzo contemporanee, progettate pensando al vostro comfort. Abbiamo una gamma di menu per tutti i gusti, dai menu stagionali alle specialità per il pranzo."
    ],
    "fr": [
      "Profitez de notre grande terrasse ou de nos deux salles au décor contemporain, aménagées pour votre plus grand confort. Différentes formules sont à votre disposition, carte de saison, formules déjeuner vous trouverez forcément le menu adapté à vos envies."
    ],
    "nl": [
      "Geniet van ons grote terras of onze twee moderne eetzalen, ontworpen met uw comfort in het achterhoofd. We hebben verschillende menu's voor ieders smaak, van seizoensmenu's tot lunchspecialiteiten."
    ],
    "es": [
      "Aproveche nuestra amplia terraza o nuestros dos comedores contemporáneos, diseñados pensando en su comodidad. Tenemos una amplia gama de menús para todos los gustos, desde menús de temporada hasta platos especiales al mediodía."
    ]
  },
