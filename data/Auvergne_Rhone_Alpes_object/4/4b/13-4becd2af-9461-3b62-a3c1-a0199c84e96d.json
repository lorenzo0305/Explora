  "rdfs:comment": {
    "de": [
      "Entdecken Sie eines der bemerkenswertesten Bauwerke des Cantal. Die Kathedrale Saint-Pierre in Saint-Flour, die höchste Kathedrale der Auvergne, liegt im Herzen der historischen Stadt und ist ein gotisches Juwel."
    ],
    "en": [
      "Discover one of Cantal's most remarkable buildings. Saint-Pierre Cathedral in Saint-Flour, the tallest cathedral in Auvergne, set in the heart of the historic town, is a Gothic jewel."
    ],
    "it": [
      "Scoprite uno degli edifici più notevoli del Cantal. La Cattedrale di Saint-Pierre a Saint-Flour, la più alta dell'Alvernia, situata nel cuore della città storica, è un gioiello gotico."
    ],
    "fr": [
      "Découverte de l'un des édifices les plus remarquables du Cantal. La cathédrale Saint-Pierre à Saint-Flour, la plus haute d'Auvergne bien installée au cœur de la cité historique est un joyau gothique."
    ],
    "nl": [
      "Ontdek een van de meest opmerkelijke gebouwen van de Cantal. De kathedraal Saint-Pierre in Saint-Flour, de hoogste kathedraal van de Auvergne, ligt in het hart van de historische stad en is een gotisch juweeltje."
    ],
    "es": [
      "Descubra uno de los edificios más notables del Cantal. La catedral Saint-Pierre de Saint-Flour, la más alta de Auvernia, situada en el corazón de la ciudad histórica, es una joya gótica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "LA CATHÉDRALE SAINT-PIERRE"
    ]
  },
