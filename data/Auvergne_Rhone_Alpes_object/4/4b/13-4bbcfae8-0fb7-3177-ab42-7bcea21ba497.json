  "rdfs:comment": {
    "de": [
      "Céline begrüßt Sie in ihrer Praxis für Kinesiologie, einer sanften Methode, bei der mithilfe des Muskeltests Stress, Blockaden und Ungleichgewichte identifiziert werden."
    ],
    "en": [
      "Céline welcomes you to her kinesiology practice, a gentle method that uses muscle testing to identify stress, blockages and imbalances."
    ],
    "it": [
      "Céline vi dà il benvenuto nel suo studio di kinesiologia, un metodo delicato che utilizza il test muscolare per identificare stress, blocchi e squilibri."
    ],
    "fr": [
      "Céline vous accueille dans son cabinet de kinésiologie, une méthode douce qui utilise le test musculaire pour identifier stress, blocages et déséquilibres."
    ],
    "es": [
      "Céline te da la bienvenida a su consulta de kinesiología, un método suave que utiliza pruebas musculares para identificar estrés, bloqueos y desequilibrios."
    ],
    "nl": [
      "Céline heet je welkom in haar praktijk voor kinesiologie, een zachte methode die gebruik maakt van spiertesten om stress, blokkades en onevenwichtigheden op te sporen."
    ]
  },
  "rdfs:label": {
