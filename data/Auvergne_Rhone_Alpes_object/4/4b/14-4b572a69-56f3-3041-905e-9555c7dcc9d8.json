  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2a89ac9b-1f13-3d51-ba4b-b2b5eb13bdef",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag, Donnerstag, Freitag: 6.30 - 13.00 Uhr / 15.30 - 18.30 Uhr\nMittwoch: 6.30 - 13 Uhr\nSamstag: 7:00 - 13:00 Uhr\nSonntag: 7:00 - 12:00 Uhr\n\nLieferung für ältere Menschen möglich."
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday, Thursday, Friday: 6:30am - 1pm / 3:30pm - 6:30pm\nWednesday: 6.30am - 1pm\nSaturday: 7am - 1pm\nSunday: 7am - 12pm\n\nDelivery possible for seniors."
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nMartedì, giovedì e venerdì: 6.30-13.00 / 15.30-18.30\nMercoledì: 6.30-13.00\nSabato: dalle 7.00 alle 13.00\nDomenica: dalle 7.00 alle 12.00\n\nConsegna possibile per gli anziani."
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nMardi, jeudi, vendredi : 6h30 - 13h / 15h30 - 18h30\nMercredi : 6h30 - 13h\nSamedi : 7h - 13h\nDimanche : 7h - 12h\n\nLivraison possible pour les personnes agées."
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag, donderdag, vrijdag: 6u30 - 13u / 15u30 - 18u30\nWoensdag: 6.30 - 13.00\nZaterdag: 7.00 - 13.00\nZondag: 7.00 - 12.00\n\nBezorging mogelijk voor ouderen."
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nMartes, jueves y viernes: de 6.30 a 13.00 h. / de 15.30 a 18.30 h\nMiércoles: de 6.30 a 13.00 h\nSábado: de 7.00 a 13.00 horas\nDomingo: de 7.00 a 12.00\n\nPosibilidad de entrega para personas mayores."
        ]
      },
