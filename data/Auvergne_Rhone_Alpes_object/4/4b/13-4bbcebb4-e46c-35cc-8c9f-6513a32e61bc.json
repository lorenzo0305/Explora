  "rdfs:comment": {
    "de": [
      "Unser restauriertes Mas aus dem Jahr 1850 liegt mitten in der Natur und bietet einen beruhigenden Rahmen für Rückzugsmöglichkeiten und Wellness-Workshops."
    ],
    "en": [
      "Nestled in the heart of nature, our restored 1850 Mas offers a soothing setting for retreats and wellness workshops."
    ],
    "it": [
      "Immersa nel cuore della natura, la nostra casa colonica restaurata del 1850 offre un ambiente rilassante per ritiri e workshop sul benessere."
    ],
    "fr": [
      "Niché au cœur de la nature, notre Mas restauré de 1850 offre un cadre apaisant propice aux retraites et aux ateliers de bien-être."
    ],
    "nl": [
      "Onze gerestaureerde boerderij uit 1850 ligt midden in de natuur en biedt een rustgevende omgeving voor retraites en welzijnsworkshops."
    ],
