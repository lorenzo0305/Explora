  "rdfs:comment": {
    "de": [
      "Das Museum für zeitgenössische Kunst in Montélimar bietet\r\nwechselnde Ausstellungen rund um national und international bekannte Künstler."
    ],
    "en": [
      "The Musée d'Art Contemporain de Montélimar offers temporary exhibitions temporary exhibitions featuring artists of national and international and international renown."
    ],
    "it": [
      "Dopo il successo delle mostre di William Klein e Sebastião Salgado, nel 2026 il Musée d'Art Contemporain presenterà l'opera fotografica dello scrittore di viaggi svizzero Nicolas BOUVIER, basata sui suoi tre viaggi in Giappone tra il 1955 e il 1970."
    ],
    "fr": [
      "Le musée d'art contemporain, après le succès des expositions de William Klein et Sebastião Salgado, présente en 2026 l'œuvre photographique de l’écrivain voyageur suisse Nicolas BOUVIER, à travers ses trois séjours au Japon de 1955 à 1970."
    ],
    "es": [
      "Tras el éxito de las exposiciones de William Klein y Sebastião Salgado, el Museo de Arte Contemporáneo presentará en 2026 la obra fotográfica del escritor de viajes suizo Nicolas BOUVIER, basada en sus tres visitas a Japón entre 1955 y 1970."
    ],
    "nl": [
      "Het Musée d'Art Contemporain de Montélimar biedt tijdelijke tentoonstellingen aan tijdelijke tentoonstellingen met kunstenaars van nationale en internationale en internationale bekendheid."
    ]
  },
