  "rdfs:comment": {
    "de": [
      "Die Ferme Florale de Margeaubrac liegt auf den Höhen des Lac de Garabit, wo die Margeride und die Aubrac aufeinandertreffen. Sie ist ein Bauernhof mit dem Gütesiegel für biologische Landwirtschaft, der sich dem Anbau von Lavendel, Duft- und Aromapflanzen widmet."
    ],
    "en": [
      "Nestled on the heights of Lake Garabit, where the Margeride and Aubrac regions meet, Ferme Florale de Margeaubrac is an organic farm dedicated to the cultivation of lavender, aromatic plants and perfumes."
    ],
    "it": [
      "Adagiata sulle alture del lago Garabit, dove la Margeride incontra l'Aubrac, la Ferme Florale de Margeaubrac è un'azienda agricola biologica dedicata alla coltivazione di lavanda, piante aromatiche e profumi."
    ],
    "fr": [
      "Nichée sur les hauteurs du lac de Garabit, à la rencontre de la Margeride et de l'Aubrac, la Ferme Florale de Margeaubrac est une ferme labellisée agriculture biologique dédiée à la culture de la lavande, des plantes aromatiques et à parfums."
    ],
    "es": [
      "Enclavada en las alturas del lago Garabit, donde el Margeride se encuentra con el Aubrac, la Ferme Florale de Margeaubrac es una granja ecológica dedicada al cultivo de lavanda, plantas aromáticas y perfumes."
    ],
    "nl": [
      "De Ferme Florale de Margeaubrac, genesteld op de hoogten van het meer van Garabit, waar de Margeride en de Aubrac samenkomen, is een biologische boerderij gewijd aan het kweken van lavendel, aromatische planten en parfums."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme florale de la MargeAubrac"
    ]
  },
