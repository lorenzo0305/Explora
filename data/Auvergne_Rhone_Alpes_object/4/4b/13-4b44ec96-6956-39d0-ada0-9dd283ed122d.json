  "rdfs:comment": {
    "de": [
      "An der Grenze zwischen Bourbonnais, Berry und Marche bietet sich ein angenehmer Spaziergang durch die diskreten Windungen der Hohlwege der Bocage und des Arnon-Tals an."
    ],
    "en": [
      "On the borders of the Bourbonnais, Berry and Marche regions, a pleasant stroll along the meandering lanes of the bocage and Arnon valleys."
    ],
    "it": [
      "Ai confini delle regioni del Bourbonnais, del Berry e delle Marche, una piacevole passeggiata lungo i discreti meandri delle stradine incassate del bocage e della valle dell'Arnon."
    ],
    "fr": [
      "Aux confins du Bourbonnais, du Berry et de la Marche, une agréable promenade dans les méandres discrets des chemins creux du bocage et de la vallée de l’Arnon."
    ],
    "nl": [
      "Op de grens van de Bourbonnais, Berry en Marche, een aangename wandeling langs de discrete meanders van de holle wegen van de bocage en de vallei van de Arnon."
    ],
    "es": [
      "En los límites de las regiones de Bourbonnais, Berry y Marche, un agradable paseo por los discretos meandros de las hundidas callejuelas del bocage y el valle del Arnon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La chapelle Saint-Remy"
    ]
  },
