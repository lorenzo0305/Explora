  "rdfs:comment": {
    "de": [
      "Diese ehemalige Apotheke ist Teil des 1686 gegründeten Krankenhauses von Montpensier. Sie ist mit restaurierten Eichentäfelungen und einer Sammlung von 119 Steinguttöpfen aus dem 18. Jahrhundert geschmückt, die unter Denkmalschutz stehen."
    ],
    "en": [
      "Established in Trévoux in 1686, the \"apothicairerie\", or dispensary, of Montpensier hospital is a large, rectangular room with wood panelling dating from the 18th and 19th centuries."
    ],
    "it": [
      "Questa antica farmacia faceva parte dell'ospedale di Montpensier, fondato nel 1686. È ornata da pannelli di quercia restaurati e da una collezione di 119 vasi di terracotta del XVIII secolo, classificati come monumenti storici."
    ],
    "fr": [
      "Cette ancienne pharmacie est intégrée dans l'hôpital de Montpensier crée en 1686. Elle est parée de boiseries en chêne restaurées et d’une collection de 119 pots en faïence du 18ème siècle, classée aux monuments historiques."
    ],
    "es": [
      "Esta antigua farmacia forma parte del hospital Montpensier, fundado en 1686. Está adornada con paneles de roble restaurados y una colección de 119 vasijas de barro del siglo XVIII, catalogadas como monumentos históricos."
    ],
    "nl": [
      "Deze voormalige apotheek maakt deel uit van het ziekenhuis van Montpensier, opgericht in 1686. Het is versierd met gerestaureerde eiken lambrisering en een collectie van 119 aardewerken potten uit de 18e eeuw, die op de monumentenlijst staan."
    ]
  },
