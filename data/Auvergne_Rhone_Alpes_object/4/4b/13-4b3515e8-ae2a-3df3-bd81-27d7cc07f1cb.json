  "rdfs:comment": {
    "de": [
      "Eine außergewöhnliche Flugshow der Armee erwartet dich? Starke Gefühle sind garantiert!\r\nSeit 1999 organisiert das GAMSTAT eine Flugschau mit den besten Vorführungen."
    ],
    "en": [
      "An exceptional Army airshow awaits you? Thrills and spills guaranteed!\r\nSince 1999, GAMSTAT has been organizing an aerial event featuring some of the finest displays in the world."
    ],
    "it": [
      "Vi aspetta un eccezionale airshow dell'Esercito? Emozioni garantite!\r\nDal 1999, GAMSTAT organizza uno spettacolo aereo con alcune delle migliori dimostrazioni al mondo."
    ],
    "fr": [
      "Un meeting aérien exceptionnel de l’Armée de Terre t’attend… Sensations fortes garanties !\r\nDepuis 1999, le GAMSTAT organise un événement aérien rassemblant les plus belles démonstrations."
    ],
    "nl": [
      "Staat je een uitzonderlijke Army airshow te wachten? Sensatie gegarandeerd!\r\nSinds 1999 organiseert GAMSTAT een luchtshow met enkele van de beste demonstraties ter wereld."
    ],
    "es": [
      "Le espera un espectáculo aéreo excepcional? ¡Emociones garantizadas!\r\nDesde 1999, GAMSTAT organiza un espectáculo aéreo con algunas de las mejores demostraciones del mundo."
    ]
  },
  "rdfs:label": {
