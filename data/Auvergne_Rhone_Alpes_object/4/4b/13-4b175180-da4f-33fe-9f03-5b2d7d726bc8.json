  "rdfs:comment": {
    "de": [
      "Gehen Sie mit Baludik auf Entdeckungsreise in Valence und Romans! Eine mobile Anwendung, mit der die ganze Familie das alte Zentrum der beiden Städte entdecken und dabei Spaß haben kann!"
    ],
    "en": [
      "Discover Valence and Romans with Baludik! A mobile app that's fun for te whole family to discover the old town centers of both cities!"
    ],
    "it": [
      "Scoprite una passeggiata divertente e interattiva nei dintorni di Bourg-lès-Valence con Baludik, un'applicazione mobile innovativa ideale per tutta la famiglia."
    ],
    "fr": [
      "Découvrez une balade interactive et ludique à Bourg-lès-Valence avec Baludik, une application mobile innovante idéale pour toute la famille."
    ],
    "nl": [
      "Ontdek Valence en Rome met Baludik! Een mobiele applicatie die leuk is voor het hele gezin om de oude stadscentra van beide steden te verkennen!"
    ],
    "es": [
      "Descubra un paseo divertido e interactivo por Bourg-lès-Valence con Baludik, una innovadora aplicación móvil ideal para toda la familia."
    ]
