  "rdfs:comment": {
    "de": [
      "Oz 3300 ist ein familienfreundliches Skigebiet, das dank des Zugangs zu zwei grünen Pisten und der sanft abfallenden Schneefront im Herzen des Ortes ideal für Ski- und Snowboardanfänger ist."
    ],
    "en": [
      "Oz 3300 is an ideal family resort for beginners in skiing and snowboarding, thanks to the access to 2 green slopes and the gently sloping snow front in the heart of the resort."
    ],
    "it": [
      "Oz 3300 è un resort ideale per le famiglie, per sciatori e snowboarder principianti, con accesso a 2 piste verdi e un fronte di neve in leggera pendenza nel cuore del resort."
    ],
    "fr": [
      "Oz 3300 est une station familiale idéale pour les débutants en ski et en snowboard, grâce à l'accès à 2 pistes vertes et au front de neige en pente douce au cœur de la station."
    ],
    "nl": [
      "Oz 3300 is een ideaal familieresort voor beginnende skiërs en snowboarders, met toegang tot 2 groene pistes en een zacht glooiend sneeuwfront in het hart van het resort."
    ],
    "es": [
      "Oz 3300 es una estación familiar ideal para esquiadores y snowboarders principiantes, con acceso a 2 pistas verdes y un frente de nieve de suave pendiente en el corazón de la estación."
    ]
  },
  "rdfs:label": {
    "en": [
      "Beginner's Area - Snow Front"
    ],
    "fr": [
      "Front de neige - Espace débutant"
    ],
    "nl": [
      "Beginnerszone - Sneeuwfront"
    ]
  },
