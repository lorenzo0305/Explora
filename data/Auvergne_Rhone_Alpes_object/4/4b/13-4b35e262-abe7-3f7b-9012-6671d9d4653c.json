  "rdfs:comment": {
    "de": [
      "In ihrem Park, durch den ein Fluss fließt, bietet Ihnen die Moulin de Barette eine Unterkunft mit 20 Zimmern in Einzelpavillons, ein Restaurant, eine Bar, einen Minigolfplatz und mehrere Veranstaltungsräume, die sich ideal für Ihre privaten oder geschäftlichen Veranstaltungen eignen."
    ],
    "en": [
      "Set in parkland with a river running through it, the Moulin de Barette offers 20 rooms in individual pavilions, a restaurant, bar, mini-golf course and several function rooms, ideal for private or business events."
    ],
    "it": [
      "Immerso in un parco con un fiume che lo attraversa, il Moulin de Barette offre 20 camere in padiglioni individuali, un ristorante, un bar, un campo da minigolf e diverse sale riunioni, ideali per eventi privati o aziendali."
    ],
    "fr": [
      "Dans son parc, traversé par une rivière, le Moulin de Barette vous propose un hébergement de 20 chambres en pavillon individuel, un restaurant, un bar, un mini-golf et plusieurs salles de réception, idéales pour vos événements privés ou professionnels."
    ],
    "es": [
      "Situado en un parque atravesado por un río, el Moulin de Barette ofrece 20 habitaciones en pabellones individuales, un restaurante, un bar, un campo de minigolf y varias salas de actos, ideales para eventos privados o de negocios."
    ],
    "nl": [
      "De Moulin de Barette ligt in een park waar een rivier doorheen stroomt en biedt 20 kamers in individuele paviljoens, een restaurant, bar, minigolfbaan en verschillende zalen, ideaal voor privé- of zakelijke evenementen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant le Moulin de Barette"
    ]
  },
