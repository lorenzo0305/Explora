  "rdfs:comment": {
    "de": [
      "Gleitschirm-Tandemflüge mit Didier, der seit 2000 als professioneller Gleitschirmflieger in der Station tätig ist, um Sie bei der Entdeckung dieser unvergesslichen spielerischen Aktivität zu begleiten."
    ],
    "en": [
      "Tandem paragliding flights with Didier, a paragliding professional in the resort since 2000, to help you discover this unforgettable leisure activity."
    ],
    "it": [
      "Voli in parapendio in tandem con Didier, professionista del parapendio presente nella località dal 2000, per farvi scoprire questa indimenticabile attività ricreativa."
    ],
    "fr": [
      "Vols en parapente biplace avec Didier, professionnel  parapente depuis 2000 dans la station, pour vous accompagner dans la découverte de cette activité ludique inoubliable."
    ],
    "es": [
      "Vuelos en parapente biplaza con Didier, profesional del parapente en la estación desde el año 2000, para ayudarle a descubrir esta inolvidable actividad de ocio."
    ],
    "nl": [
      "Tandem paragliding vluchten met Didier, een paragliding professional in het resort sinds 2000, om je deze onvergetelijke vrijetijdsbesteding te laten ontdekken."
    ]
  },
