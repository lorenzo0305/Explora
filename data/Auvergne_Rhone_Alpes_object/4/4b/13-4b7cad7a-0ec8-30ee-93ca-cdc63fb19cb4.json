  "rdfs:comment": {
    "de": [
      "Sébastien Thête, Lehrer und Angelführer, bietet Ihnen die Möglichkeit, sich auf Seen und Flüssen führen zu lassen (Einführung in das Angeln mit dem Boot, auf Raubfische, Welsjagd usw.)"
    ],
    "en": [
      "Sébastien Thête, fishing guide instructor, offers you to let you guide on lakes and rivers (initiation to fishing with the blow, with the carnivorous ones in boat, with the tracking of the catfish etc)."
    ],
    "it": [
      "Sébastien Thête, istruttore e guida di pesca, è a disposizione per guidarvi nei laghi e nei fiumi (introduzione alla pesca subacquea, pesca di predatori dalla barca, ricerca di pesci gatto, ecc.)"
    ],
    "fr": [
      "Sébastien Thête, moniteur guide de pêche, vous propose de vous laisser guider sur les lacs et les rivières (initiation à la pêche au coup, aux carnassiers en bateau, à la traque du silure etc.)"
    ],
    "nl": [
      "Sébastien Thête, visinstructeur en gids, begeleidt je rond de meren en rivieren (kennismaking met speervissen, roofvissen vanuit een boot, meerval opsporen, enz.)"
    ],
    "es": [
      "Sébastien Thête, instructor y guía de pesca, está a su disposición para guiarle por los lagos y ríos (iniciación a la pesca submarina, pesca de depredadores desde embarcación, rastreo de siluros, etc.)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Wild immersion: Fishing Guide Instructor"
    ],
    "fr": [
      "Immersion sauvage : Moniteur Guide de Pêche"
    ]
  },
