  "rdfs:comment": {
    "de": [
      "Die elegante, von Galizien inspirierte Bar Copiña im Courchevel 1650 verführt mit kreativen Cocktails, streng ausgewählten Weinen und handwerklich gebrauten Bieren sowie einer einfallsreichen Tapas-Karte? und das alles in einer warmen und freundlichen Atmosphäre."
    ],
    "en": [
      "An elegant Galician-inspired bar at Courchevel 1650, Copiña features creative cocktails, carefully selected wines and craft beers, and an inventive tapas menu - all in a warm, friendly atmosphere."
    ],
    "it": [
      "Elegante bar ispirato alla Galizia a Courchevel 1650, Copiña offre cocktail creativi, vini e birre artigianali accuratamente selezionati e un menu di tapas inventivo, il tutto in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Bar élégant inspiré de la Galice, au Courchevel 1650, Copiña séduit par ses cocktails créatifs, ses vins et bières artisanales rigoureusement sélectionnés, et sa carte de tapas inventive – le tout dans une ambiance chaleureuse et conviviale."
    ],
    "es": [
      "Copiña, un elegante bar inspirado en Galicia en Courchevel 1650, ofrece cócteles creativos, vinos y cervezas artesanales cuidadosamente seleccionados y un inventivo menú de tapas... todo ello en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Copiña, een elegante bar geïnspireerd door Galicië in Courchevel 1650, biedt creatieve cocktails, zorgvuldig geselecteerde wijnen en ambachtelijke bieren, en een inventief tapasmenu in een warme en vriendelijke sfeer."
    ]
  },
