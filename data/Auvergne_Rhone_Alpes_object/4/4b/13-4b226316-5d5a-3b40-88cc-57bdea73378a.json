  "rdfs:comment": {
    "de": [
      "Fontanille Scop, ein französischer Hersteller von Puy-en-Velay-Spitzen und elastischen Bändern, öffnet seine Türen. Lassen Sie sich von ihrem Know-how überzeugen! Tauchen Sie ein in eine symbolträchtige Spitzenfabrik in der Stadt Le Puy-en-Velay."
    ],
    "en": [
      "Fontanille Scop, a French manufacturer of Puy-en-Velay lace and elastic ribbons, is opening its doors. Come and discover their know-how! Immerse yourself in an emblematic lace factory in the town of Le Puy-en-Velay."
    ],
    "it": [
      "Fontanille Scop, produttore francese di pizzi e nastri elastici di Puy-en-Velay, apre le sue porte. Venite a scoprire il loro know-how! Immergetevi in un'emblematica fabbrica di pizzi nella città di Le Puy-en-Velay."
    ],
    "fr": [
      "Fontanille Scop, fabricant français de dentelles du Puy-en-Velay et de rubans élastiques, ouvre ses portes. Venez découvrir leur savoir-faire ! Plongez en immersion dans une usine emblématique de dentelle de la ville du Puy-en-Velay."
    ],
    "es": [
      "Fontanille Scop, fabricante francés de encajes y cintas elásticas de Puy-en-Velay, abre sus puertas. ¡Venga a descubrir su saber hacer! Sumérjase en una emblemática fábrica de encajes de la ciudad de Le Puy-en-Velay."
    ],
    "nl": [
      "Fontanille Scop, een Franse fabrikant van Puy-en-Velay kant en elastische linten, opent haar deuren. Kom en ontdek hun knowhow! Dompel jezelf onder in een emblematische kantfabriek in de stad Le Puy-en-Velay."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite d'usine : Fontanille Scop, fabricant français de dentelle"
    ]
  },
