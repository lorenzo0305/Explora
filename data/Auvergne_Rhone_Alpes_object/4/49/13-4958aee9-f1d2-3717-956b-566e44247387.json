  "rdfs:comment": {
    "de": [
      "Das Hotel le Kandahar empfängt Sie am Eingang der Hauptstraße, nur 250 m von den Skipisten entfernt. Es befindet sich in einer günstigen Lage, um das \"Erlebnis Val d'Isère\" in vollen Zügen zu genießen."
    ],
    "en": [
      "The hotel Kandahar welcomes you at the entrance of the main street, only 250m away from the slopes. It is situated to live fully \" the Val d'Isère experience \"."
    ],
    "it": [
      "L'hotel Kandahar vi accoglie all'ingresso della strada principale, a soli 250 m dalle piste da sci. È situato per vivere appieno l'esperienza della \"Val d'Isère\"."
    ],
    "fr": [
      "L'hôtel le Kandahar vous accueille à l'entrée de la rue principale, à seulement 250m des pistes de ski. Il est situé pour vivre pleinement «l'expérience Val d'Isère»."
    ],
    "nl": [
      "Hotel Kandahar verwelkomt je bij de ingang van de hoofdstraat, op slechts 250 meter van de skipistes. Het is ideaal gelegen voor de Val d'Isère ervaring."
    ],
    "es": [
      "El hotel Kandahar le da la bienvenida a la entrada de la calle principal, a sólo 250 metros de las pistas de esquí. Su ubicación es ideal para vivir la experiencia Val d'Isère."
    ]
  },
