      "rdfs:comment": {
        "de": [
          "Verkauf von hausgemachten Marmeladen.\nAlle Marmeladen werden auf traditionelle Weise in einer Kupferbasine gekocht.\nProdukte zum Verkauf im Tourismusbüro."
        ],
        "en": [
          "Sale of home-made jams.\nAll jams are cooked in an old-fashioned copper basin.\nProducts on sale at the Tourist Office."
        ],
        "it": [
          "Vendita di marmellate fatte in casa.\nTutte le marmellate sono cotte in antichi recipienti di rame.\nProdotti in vendita presso l'Ufficio del Turismo."
        ],
        "fr": [
          "Vente de confitures faites maison.\nToutes les confitures sont cuites en basine en cuivre à l'ancienne.\nProduits en vente à l'Office de tourisme."
        ],
        "nl": [
          "Verkoop van zelfgemaakte jam.\nAlle jam wordt gekookt in ouderwetse koperen bekkens.\nProducten te koop bij het VVV-kantoor."
        ],
        "es": [
          "Venta de mermeladas caseras.\nTodas las mermeladas se cocinan en antiguos recipientes de cobre.\nProductos a la venta en la Oficina de Turismo."
        ]
      },
