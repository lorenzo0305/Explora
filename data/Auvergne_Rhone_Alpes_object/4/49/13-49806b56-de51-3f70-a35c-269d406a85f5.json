  "rdfs:comment": {
    "de": [
      "Laurent und seine Familie bewirtschaften 8 Hektar Weinberge in der Gemeinde Massignieu-de-Rives im Departement AIN, an der Grenze zu den beiden Savoyen und im äußersten Süden des Bugey-Gebiets."
    ],
    "en": [
      "Winegrowers from father to son for 4 generations, Laurent and his family cultivate 8 hectares of vines in the commune of Massignieu-de-Rives, located at the gateway to the two Savoie regions and in the extreme south of the Bugey."
    ],
    "it": [
      "Viticoltori di padre in figlio da 4 generazioni, Laurent e la sua famiglia coltivano 8 ettari di vigneto nel comune di Massignieu-de-Rives, nel dipartimento dell'Ain, alle porte delle due regioni della Savoia e all'estremità meridionale della regione del Bugey."
    ],
    "fr": [
      "Vignerons de père en fils depuis 4 générations, Laurent et sa famille exploitent 8 hectares de vignes sur la commune de Massignieu-de-Rives, Département de l'Ain, située aux portes des deux Savoie et à l'extrême Sud du Bugey."
    ],
    "es": [
      "Viticultores de padre a hijo desde hace 4 generaciones, Laurent y su familia cultivan 8 hectáreas de viñedos en la comuna de Massignieu-de-Rives, en el departamento de Ain, a las puertas de las dos regiones de Saboya y en el extremo sur de la región de Bugey."
    ],
    "nl": [
      "Laurent en zijn familie zijn al 4 generaties lang wijnbouwers van vader op zoon en cultiveren 8 hectare wijngaarden in de gemeente Massignieu-de-Rives, in het departement Ain, aan de poort van de twee Savoyse regio's en aan het zuidelijke uiteinde van de Bugey-streek."
    ]
  },
