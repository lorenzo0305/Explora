  "rdfs:comment": {
    "de": [
      "4000 m2 großer Teich, der zum Angeln von Forellen, Raubfischen, Karpfen und Frittieren genutzt wird. Forellen werden von Oktober bis Juni alle 14 Tage ausgesetzt.\r\nTeich der 2. Kategorie"
    ],
    "en": [
      "4 000m2 fishing pond dedicated to trout, carnivorous fish, carp and white bait. Trout are released from October to June every 2 weeks. Open all year round."
    ],
    "it": [
      "Un laghetto di 4000 m2 dedicato alla pesca di trote, predatori, carpe e avannotti. Le trote vengono rilasciate ogni 15 giorni da ottobre a giugno.\r\nLago di 2a categoria"
    ],
    "fr": [
      "Etang de 4000 m2 dédié à la pêche à la truite, aux carnassiers, carpe et friture. Des lâchers de truites sont effectués d’octobre à juin tous les 15 jours.\r\nEtang de 2ème catégorie"
    ],
    "es": [
      "Un estanque de 4000 m2 dedicado a la pesca de truchas, depredadores, carpas y alevines. Las truchas se sueltan cada 15 días de octubre a junio.\r\nLago de 2ª categoría"
    ],
    "nl": [
      "Een vijver van 4000 m2 voor het vissen op forel, roofvis, karper en pootvis. Forellen worden om de 15 dagen uitgezet van oktober tot juni.\r\nMeer van de 2e categorie"
    ]
  },
  "rdfs:label": {
