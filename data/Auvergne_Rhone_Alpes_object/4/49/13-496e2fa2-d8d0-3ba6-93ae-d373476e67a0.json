  "rdfs:comment": {
    "de": [
      "Ferme-Auberge in einem kurzen Kreislauf ...\r\nMahlzeiten am Abend, von Mittwoch bis Samstag\r\nHausgemacht"
    ],
    "en": [
      "In summer, we offer you a unique menu: the farmer's menu at 28€\r\nSunday noon with our “Farmer Brunch”, by reservation only.\r\n \r\nIn winter, we offer 3 menus."
    ],
    "it": [
      "In estate vi proponiamo un menù unico: il menù del contadino a 28€\r\nDomenica a mezzogiorno con il nostro “Farmer Brunch”, solo su prenotazione.\r\n \r\nIn inverno, offriamo 3 menu."
    ],
    "fr": [
      "Ferme-Auberge en circuit court... \r\nRepas le soir, du mercredi au samedi\r\nFait maison"
    ],
    "nl": [
      "In de zomer bieden wij u een uniek menu aan: het boerenmenu aan 28€\r\nZondagmiddag met onze “Boerenbrunch”, enkel op reservatie.\r\n \r\nIn de winter bieden wij 3 menu's aan."
    ],
    "es": [
      "Ferme-Auberge (albergue rural)...\r\nCenas de miércoles a sábado\r\nCocina casera"
    ]
  },
