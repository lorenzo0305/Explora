  "rdfs:comment": {
    "de": [
      "Brauchen Sie Entspannung und Sanftheit? Entdecken Sie das traditionelle Hammam mit seinen warmen und bezaubernden Farben und die finnische Sauna mit ihrem skandinavischen Dekor. Für absolute Entspannung bietet Les Jardins d'Amakrys westliche Massagen und Gesichtsbehandlungen an."
    ],
    "en": [
      "In need for a relaxing and soft moment? Let's discover our traditionnal hammam with its warm and bewitching colors...our finnish sauna as in scandinavian style. We offer you a massage of a face care, to provide you a moment of absolute peace."
    ],
    "it": [
      "Avete bisogno di rilassarvi e distendervi? Scoprite l'hammam tradizionale con i suoi colori caldi e ammalianti... la sauna finlandese con il suo arredamento scandinavo. Per un relax assoluto, Les Jardins d'Amakrys offre massaggi occidentali e trattamenti per il viso."
    ],
    "fr": [
      "Besoin de détente et de douceur? Découvrez le hammam traditionnel aux couleurs chaudes et envoûtantes... le sauna finlandais au décor scandinave. Pour une détente absolue, Les Jardins d'Amakrys  propose des massages occidentales, des soins du visage."
    ],
    "es": [
      "¿Necesita relajarse y desconectar? Descubra el hammam tradicional con sus colores cálidos y hechizantes... la sauna finlandesa con su decoración escandinava. Para una relajación absoluta, Les Jardins d'Amakrys ofrecen masajes occidentales y tratamientos faciales."
    ],
    "nl": [
      "Behoefte om te ontspannen en tot rust te komen? Ontdek de traditionele hammam met zijn warme, betoverende kleuren... de Finse sauna met zijn Scandinavische inrichting. Voor absolute ontspanning biedt Les Jardins d'Amakrys westerse massages en gezichtsbehandelingen."
    ]
  },
