  "rdfs:comment": {
    "de": [
      "Diese Enduro-Strecke, die vom Klettergarten 3 Pucelles aus zugänglich ist, folgt den Spuren von Nicolas Vouilloz, der in den 90er Jahren mit 10 Weltmeistertiteln ein Pionier des Downhill-Mountainbikens war und die Schaffung dieser Strecke initiiert hat."
    ],
    "en": [
      "Accessible from the 3 Pucelles climbing site, this enduro itinerary follows in the footsteps of Nicolas Vouilloz, a pioneer of downhill mountain biking in the 90s with 10 world championship titles, and the man behind the creation of this trail."
    ],
    "it": [
      "Accessibile dal sito di arrampicata delle 3 Pucelles, questo percorso di enduro segue le orme di Nicolas Vouilloz, pioniere della mountain bike da discesa negli anni '90 con 10 titoli mondiali all'attivo, e artefice della creazione di questo percorso."
    ],
    "fr": [
      "Accessible depuis le site d'escalade des 3 pucelles, cet itinéraire enduro part dans les traces de Nicolas Vouilloz, pionnier du VTT de descente dans les années 90 avec 10 titres de champions du monde et à l'origine de la création de cette piste."
    ],
    "nl": [
      "Deze enduro-route is toegankelijk vanaf de klimlocatie 3 Pucelles en volgt de voetsporen van Nicolas Vouilloz, een pionier van downhill mountainbiken in de jaren 90 met 10 wereldtitels op zijn naam, en de man achter de creatie van dit parcours."
    ],
    "es": [
      "Accesible desde el rocódromo de las 3 Pucelles, esta ruta de enduro sigue los pasos de Nicolas Vouilloz, pionero del descenso en bicicleta de montaña en los años 90, con 10 títulos de campeón del mundo a sus espaldas, y artífice de la creación de este sendero."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La DH du Tremplin - Spéciale VTT Enduro - Noir"
    ]
  },
