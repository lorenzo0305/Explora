  "rdfs:comment": {
    "de": [
      "Olivier Buisson, ein renommierter Konditor und Chocolatier, bietet Ihnen an, seine zahlreichen schokoladigen Leckereien und andere..."
    ],
    "en": [
      "Olivier Buisson has two passions :  pâtisserie and the art of sharing knowledge.  He has installed a workshop area next to his shop where all visitors are welcome. Courses in cookery are offered on Saturdays at  14h.\r\nThe workshop programme is available on  www.le-chardonbleu.com\r\nhttp://www.le-chardonbleu.com/"
    ],
    "it": [
      "Olivier Buisson, rinomato pasticcere e cioccolatiere, si offre di mostrarvi le sue numerose delizie al cioccolato e altre prelibatezze."
    ],
    "fr": [
      "Olivier Buisson, pâtissier-chocolatier de grande renommée propose de vous faire découvrir ses nombreuses gourmandises chocolatées et autres..."
    ],
    "es": [
      "Olivier Buisson, reputado pastelero y chocolatero, se ofrece a mostrarle sus numerosas delicias de chocolate y otros manjares."
    ],
    "nl": [
      "Olivier Buisson, een bekende banketbakker en chocolatier, biedt u de gelegenheid om zijn vele chocolade..."
    ]
