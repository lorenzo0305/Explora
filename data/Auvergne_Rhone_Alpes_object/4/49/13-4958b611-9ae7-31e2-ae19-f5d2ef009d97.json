  "rdfs:comment": {
    "de": [
      "Das 1976 gegründete Atelier des nationalen Spitzenkonservatoriums untersteht der französischen Nationalagentur Mobilier unter Leitung des Kultusministeriums und dient der Erhaltung der Klöppelspitzentechnik."
    ],
    "en": [
      "The National Conservatory Workshop for Lace was set up in 1976 as part of the Mobilier National administration and under the authority of the French Culture Ministry. Its task is to preserve the techniques of bobbin lace."
    ],
    "it": [
      "L'Atelier Conservatoire National de la Dentelle, creato nel 1976, è annesso all'amministrazione generale del Mobilier National, sotto la supervisione del Ministero della Cultura. È aperto ai visitatori e le merlettaie presentano i loro progetti."
    ],
    "fr": [
      "L’Atelier Conservatoire National de la Dentelle, créé en 1976, est rattaché à l’administration générale du Mobilier National, sous tutelle du Ministère de la Culture. Il est ouvert aux visites et les dentellières présentent leur projet."
    ],
    "nl": [
      "Het Atelier Conservatoire National de la Dentelle, opgericht in 1976, is verbonden aan de algemene administratie van de Mobilier National, onder toezicht van het Ministerie van Cultuur. Het is open voor bezoekers en de kantwerksters presenteren er hun projecten."
    ],
    "es": [
      "El Atelier Conservatoire National de la Dentelle, creado en 1976, depende de la administración general del Mobilier National, bajo la supervisión del Ministerio de Cultura. Está abierto a los visitantes, y las encajeras presentan sus proyectos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Conservatoire National de la Dentelle - Manufactures nationales - Sèvres et Mobilier national"
    ]
  },
