  "rdfs:comment": {
    "de": [
      "LE GABRIO hat es sich zur Aufgabe gemacht, Ihnen eine Berggastronomie mit lokalen Produkten anzubieten. Hinter dem Herd steht ein geschultes Team, das Ihre Pizzen mit hochwertigen Zutaten zubereitet und perfekt gebräunt"
    ],
    "en": [
      "LE GABRIO is committed to offering you a mountain restaurant made with local products. Behind the ovens, you will also find a team trained to make your pizzas perfectly browned and loaded with high quality products."
    ],
    "it": [
      "LE GABRIO si impegna a offrirvi una ristorazione in stile montano con prodotti locali. Dietro i fornelli, inoltre, troverete un team addestrato per rendere le vostre pizze perfettamente dorate e caricate con prodotti di alta qualità"
    ],
    "fr": [
      "LE GABRIO à cœur de vous proposer une restauration de Montagne réalisée avec des produits locaux. À l'arrière des fourneaux, vous trouverez également une équipe formée pour réaliser vos pizzas parfaitement dorées et chargées de produits de haute qualité"
    ],
    "nl": [
      "Restaurant “La Godille” u van dag tot dag."
    ],
    "es": [
      "LE GABRIO se compromete a ofrecerle un catering de montaña con productos locales. Detrás de los fogones, también encontrará un equipo formado para que sus pizzas estén perfectamente doradas y cargadas de productos de alta calidad"
    ]
  },
