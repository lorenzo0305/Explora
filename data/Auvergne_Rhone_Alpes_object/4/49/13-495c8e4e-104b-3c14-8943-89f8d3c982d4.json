  "rdfs:comment": {
    "de": [
      "Als ehemalige Spitzenathletin im Biathlon (Skilanglauf und Schießen) mit den Staatspatenten für nordischen Skilauf und Fitnessberufe biete ich Ihnen Sportcoaching für Einzelpersonen oder kleine Gruppen (max. 4 Personen) an."
    ],
    "en": [
      "A former top-level biathlon athlete (cross-country skiing and shooting) with Nordic skiing and fitness qualifications, I offer individual or small-group sports coaching sessions (4 people max)."
    ],
    "it": [
      "Ex atleta di biathlon di alto livello (sci di fondo e tiro) e titolare di qualifiche di sci nordico e fitness, offro sessioni di coaching sportivo individuali o per piccoli gruppi\ngruppi (massimo 4 persone)."
    ],
    "fr": [
      "Ancienne athlète de haut niveau en biathlon ( ski de fond et tir), titulaire des brevets d'état ski nordique et métiers de la forme, je vous propose des séances de coaching sportif individuelles ou en petit \ngroupe (4 personnes max)."
    ],
    "es": [
      "Antiguo atleta de biatlón de alto nivel (esquí de fondo y tiro) y titulado en esquí nórdico y fitness, ofrezco sesiones de coaching deportivo individuales o en grupos reducidos\ngrupos (máximo 4 personas)."
    ],
    "nl": [
      "Als voormalig biatlonatleet op topniveau (langlaufen en schieten) en houder van kwalificaties op het gebied van nordic skiën en fitness, bied ik individuele sportcoachingsessies of sessies in kleine groepen\ngroepen (max. 4 personen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Personal coaching by Sofie"
    ]
  },
