  "rdfs:comment": {
    "de": [
      "Im Rahmen des Festivals \"Jubilons!\" nehmen Sie Jean-Marc Phillips-Varjabédian, Violine, und Violaine Cochard, Cembalo, mit auf eine unerwartete Reise vom Barock bis zu Bartók."
    ],
    "en": [
      "As part of the \"Jubilons!\" festival, Jean-Marc Phillips-Varjabédian, violin, and Violaine Cochard, harpsichord, take you on an unexpected journey from Baroque to Bartók."
    ],
    "it": [
      "Nell'ambito del festival \"Jubilons!\", Jean-Marc Phillips-Varjabédian, violino, e Violaine Cochard, clavicembalo, vi accompagnano in un viaggio inaspettato dal barocco a Bartók."
    ],
    "fr": [
      "Dans le cadre du festival \"Jubilons !\", Jean-Marc Phillips-Varjabédian, violon, et Violaine Cochard, clavecin, vous entraînent dans un voyage inattendu, du baroque à Bartók."
    ],
    "nl": [
      "In het kader van het festival \"Jubilons!\" nemen Jean-Marc Phillips-Varjabédian, viool, en Violaine Cochard, klavecimbel, je mee op een onverwachte reis van de barok naar Bartók."
    ],
    "es": [
      "En el marco del festival \"¡Jubilons!\", Jean-Marc Phillips-Varjabédian, violín, y Violaine Cochard, clave, le llevarán en un viaje inesperado del Barroco a Bartók."
    ]
  },
  "rdfs:label": {
    "fr": [
