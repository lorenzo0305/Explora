  "rdfs:comment": {
    "de": [
      "Mob'attitude bietet Ihnen die Möglichkeit, Mopeds aus den 70er und 80er Jahren zu mieten, um während einer Fahrt die schönsten Straßen der Region zu entdecken."
    ],
    "en": [
      "Mob'attitude offers you the rental of mopeds from the 70s/80s and accompanies you for a ride on the most beautiful roads of Matheysine."
    ],
    "it": [
      "Mob'attitude vi propone il noleggio di ciclomotori dagli anni 70/80 e vi accompagna il tempo di una  passeggiata sulle più belle strada di La Matheysine."
    ],
    "fr": [
      "Mob'attitude vous propose de la location de mobylette des années 70/80 pour découvrir, le temps d'une balade, les plus belles routes de la région."
    ],
    "es": [
      "Mob'attitude le ofrece la posibilidad de alquilar un ciclomotor de los años 70/80 para descubrir las carreteras más bellas de la región."
    ],
    "nl": [
      "Mob'attitude biedt u de mogelijkheid om een 70/80's brommer te huren om de mooiste wegen van de regio te ontdekken."
    ]
  },
