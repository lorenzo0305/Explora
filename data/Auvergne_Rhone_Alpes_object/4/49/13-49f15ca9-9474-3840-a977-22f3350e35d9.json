  "rdfs:comment": {
    "de": [
      "Das Team aus 2 bis 6 Spielern ist eingeladen, Rätsel zu lösen, die mit der Entdeckung des berühmten Fossils von Lucy zusammenhängen, das von Yves Coppens entdeckt wurde.  Online-Reservierung oder vor Ort, die den Zugang zum gesamten Park ermöglicht. Ab 13 Jahren."
    ],
    "en": [
      "Teams of 2 to 6 players are invited to solve riddles linked to the famous Lucy fossil discovered by Yves Coppens.  Online or on-site booking for access to the entire park."
    ],
    "it": [
      "Squadre da 2 a 6 giocatori sono invitate a risolvere gli indovinelli legati alla scoperta del famoso fossile di Lucy da parte di Yves Coppens.  Prenotazione online o in loco per l'accesso all'intero parco. A partire dai 13 anni."
    ],
    "fr": [
      "L'équipe de 2 à 6 joueurs est invitée à résoudre des énigmes liées à la découverte du célèbre fossile de Lucy découvert par Yves Coppens.  Réservation en ligne ou sur place permettant l'accès à la totalité du parc. À partir de 13 ans."
    ],
    "nl": [
      "Teams van 2 tot 6 spelers worden uitgenodigd om raadsels op te lossen die verband houden met de ontdekking van het beroemde Lucy-fossiel door Yves Coppens.  Reserveer online of ter plaatse voor toegang tot het hele park. Vanaf 13 jaar."
    ],
    "es": [
      "Se invita a equipos de 2 a 6 jugadores a resolver enigmas relacionados con el descubrimiento del famoso fósil de Lucy por Yves Coppens.  Reserva en línea o in situ para acceder a todo el parque. A partir de 13 años."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game, la face cachée de Lucy"
    ]
  },
