  "rdfs:comment": {
    "de": [
      "BOLL bietet eine lokale Interpretation eines exotischen Rezepts: die Pokebowl. Alle unsere Bolls werden vor Ort vor Ihren Augen aus frischen, gesunden und saisonalen Zutaten zubereitet."
    ],
    "en": [
      "BOLL offers a local interpretation of an exotic recipe: the Pokebowl. All our bolls are made on the spot, in front of you, with fresh, healthy, seasonal produce."
    ],
    "it": [
      "BOLL offre un'interpretazione locale di una ricetta esotica: il Pokebowl. Tutte le nostre bolle sono fatte sul posto, davanti a voi, con prodotti freschi, sani e di stagione."
    ],
    "fr": [
      "BOLL propose une interprétation locale d’une recette exotique : le Pokebowl. Tout nos bolls sont réalisés sur place, devant vous, avec des produits frais, sains et de saison."
    ],
    "es": [
      "BOLL ofrece una interpretación local de una receta exótica: el Pokebowl. Todas nuestras bolitas se elaboran en el momento, delante de usted, con productos frescos, sanos y de temporada."
    ],
    "nl": [
      "BOLL biedt een lokale interpretatie van een exotisch recept: de Pokebowl. Al onze bollen worden ter plekke gemaakt, voor je neus, met verse, gezonde seizoensproducten."
    ]
  },
  "rdfs:label": {
