  "rdfs:comment": {
    "de": [
      "Über 1600 Artikel an Weinen, Spirituosen, Champagner und Bieren. Animationen und Kurse in Enologie. Größter Whiskykeller im Departement Allier und eigene Whisky- und Rummarke. Gewinner des Publikumspreises des Wettbewerbs \"Meilleur Caviste de France 2020\"."
    ],
    "en": [
      "1620 references of wines, spirits, champagnes, beers. Animations and oenology courses. The largest whisky cellar in the Allier region, plus our own brand of whiskies and rums. Winner of the People's Choice Award in the Best Caviste de France 2020 competition."
    ],
    "it": [
      "Oltre 1600 referenze di vini, liquori, champagne e birre. Attività e corsi di degustazione. La più grande cantina di whisky dell'Allier e il proprio marchio di whisky e rum. Vincitore del premio People's Choice nel concorso Best Caviste de France 2020."
    ],
    "fr": [
      "Plus de 1600 références de vins, spiritueux, champagnes, bières. Animations et cours d'œnologie. La plus grande cave à Whisky de l’Allier et propre marque de Whiskies et de Rhums. Lauréat du prix du public du concours du Meilleur Caviste de France 2020."
    ],
    "nl": [
      "Verkoop van wijnen en gedistilleerde dranken.\r\nGeïnformeerde advies- en oenologieworkshops. De grootste Whisky-kelder van de Allier!"
    ],
    "es": [
      "Más de 1600 referencias de vinos, licores, champanes y cervezas. Actividades y cursos de cata de vinos. La mayor bodega de whisky del Allier y su propia marca de whiskies y rones. Ganador del Premio del Público en el concurso Mejor Caviste de France 2020."
    ]
  },
