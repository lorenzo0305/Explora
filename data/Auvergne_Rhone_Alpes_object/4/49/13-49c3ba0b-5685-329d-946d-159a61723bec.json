  "rdfs:comment": {
    "de": [
      "Bienvenue à la Ferme de Séraussaix (4 km vom Ort entfernt in Richtung Morzine, auch auf Skiern über die Piste von Séraussaix erreichbar): eine Milchkuhzucht, die Besichtigungen und Verkostungen auf dem Bauernhof anbietet."
    ],
    "en": [
      "Welcome to the Ferme de Séraussaix (4 km from the resort toward Morzine, also accessible by ski via the Séraussaix slope): a dairy farm offering farm visits and tastings."
    ],
    "it": [
      "Benvenuti alla Ferme de Séraussaix (a 4 km dal resort in direzione Morzine, raggiungibile anche con gli sci attraverso la pista di Séraussaix): una fattoria di mucche da latte che offre visite alla fattoria e degustazioni."
    ],
    "fr": [
      "Bienvenue à la Ferme de Séraussaix (à 4 km de la station en direction de Morzine, accessible également à ski par la piste de Séraussaix) : un élevage de vaches laitières qui propose des visites et des dégustations à la ferme."
    ],
    "nl": [
      "Welkom bij de Ferme de Séraussaix (4 km van het resort richting Morzine, ook bereikbaar met de ski via de Séraussaix-piste): een melkveebedrijf dat rondleidingen en proeverijen op de boerderij aanbiedt."
    ],
    "es": [
      "Bienvenido a la Ferme de Séraussaix (a 4 km de la estación en dirección a Morzine, también accesible con esquís por la pista de Séraussaix): una explotación de vacas lecheras que ofrece visitas a la granja y degustaciones."
    ]
  },
  "rdfs:label": {
    "en": [
      "Seraussaix Farm"
    ],
    "fr": [
      "La Ferme de Seraussaix"
    ]
  },
