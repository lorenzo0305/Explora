  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c2cc6135-6b3b-376a-b7bf-65f9279c0234",
      "dc:description": {
        "de": [
          "Zugängliche Besichtigungen\nEntdecken Sie die Krypta ? Besuch mit LSF\nEntdecken Sie die Sammlungen und die Krypta mit einem Führer, der in die französische Gebärdensprache dolmetscht, für hörende und hörgeschädigte Besucher.\n\nRDV um 14.00 Uhr\nEintritt frei ? Reservierung empfohlen"
        ],
        "en": [
          "Accessible visits\nDiscover the Crypt ? LSF tour\nDiscover the collections and the Crypt with a French sign language interpreter, for hearing and hearing-impaired visitors.\n\nRDV at 2:00 pm\nFree admission ? Reservation recommended"
        ],
        "it": [
          "Visite accessibili\nScoprire la cripta? Visita LSF\nVisita alle collezioni e alla Cripta con un interprete della lingua dei segni francese, per visitatori udenti e ipoudenti.\n\nRDV alle 14:00\nIngresso gratuito? Prenotazione consigliata"
        ],
        "fr": [
          "Les visites accessibles\nDécouvrir la Crypte – Visite LSF\nDécouvrez les collections et la Crypte avec un guide interprète en langue des signes françaises, pour publics entendant et malentendant. \n\nRDV à 14h00\nGratuit – Réservation conseillée"
        ],
        "es": [
          "Visitas accesibles\nDescubrir la Cripta ? Visita LSF\nDescubra las colecciones y la Cripta con un intérprete de lengua de signos francesa, para visitantes oyentes y con discapacidad auditiva.\n\nRDV a las 14:00\nEntrada gratuita ? Se recomienda reservar"
        ],
        "nl": [
          "Toegankelijke bezoeken\nOntdek de Crypte? Rondleiding LSF\nOntdek de collecties en de Crypte met een tolk in Franse gebarentaal, voor slechthorende en slechthorende bezoekers.\n\nRDV om 14u00\nGratis toegang ? Reservering aanbevolen"
        ]
      },
      "@type": [
        "Description"
      ],
