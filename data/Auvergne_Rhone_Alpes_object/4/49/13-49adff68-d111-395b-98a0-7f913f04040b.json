  "rdfs:comment": {
    "de": [
      "Entdecken Sie Thonon in Ihrem eigenen Rhythmus, zu Fuß oder mit dem Fahrrad, durch seine Architektur und Wandkunst und reisen Sie so durch die Zeit, vom 19. Jahrhundert bis heute, über die 70er Jahre"
    ],
    "en": [
      "Discover Thonon at your own pace through its architecture and mural art, traveling through time from the 19th century to the present day, via the 1970s."
    ],
    "it": [
      "Scoprite Thonon al vostro ritmo, a piedi o in bicicletta, attraverso la sua architettura e la sua arte murale e viaggiate nel tempo, dal XIX secolo ai giorni nostri, passando per gli anni Settanta"
    ],
    "fr": [
      "Découvrez Thonon à votre rythme, à pieds ou à vélo, à travers son architecture et son art mural et voyager ainsi à travers le temps, du 19ème siècle à nos jours, en passant par les années 70"
    ],
    "nl": [
      "Ontdek Thonon op je eigen tempo, te voet of op de fiets, langs de architectuur en muurschilderingen en reis door de tijd, van de 19e eeuw tot nu, via de jaren 1970"
    ],
    "es": [
      "Descubra Thonon a su ritmo, a pie o en bicicleta, a través de su arquitectura y su arte mural y viaje en el tiempo, desde el siglo XIX hasta nuestros días, pasando por la década de 1970"
    ]
  },
  "rdfs:label": {
