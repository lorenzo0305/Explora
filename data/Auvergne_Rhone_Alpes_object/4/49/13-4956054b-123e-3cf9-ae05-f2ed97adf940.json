  "rdfs:comment": {
    "de": [
      "FRAZARIN ist ein französisch-italienisches Bistro, das Sie dazu bringt, die Geschichte von FRAZARIN zu entdecken, einem jungen Italiener, den wir auf seiner Initiationsreise durch Frankreich begleiten. Er ist neugierig auf die Geheimnisse und Techniken der Meister Escoffier, Paul Bocuse..."
    ],
    "en": [
      "FRAZARIN is a Franco-Italian Bistro, where you can discover the story of FRAZARIN, a young Italian who we follow on his journey of initiation through France, curious to discover the secrets and techniques of the masters Escoffier, Paul Bocuse..."
    ],
    "it": [
      "FRAZARIN è un bistrot franco-italiano, che vi porta a scoprire la storia di FRAZARIN, un giovane italiano che seguiamo nel suo viaggio iniziatico attraverso la Francia, curioso di scoprire i segreti e le tecniche dei maestri Escoffier, Paul Bocuse..."
    ],
    "fr": [
      "FRAZARIN est un Bistrot Franco-Italien, qui vous amène à découvrir l’histoire de FRAZARIN, jeune Italien que nous suivons dans son voyage initiatique à travers la France, curieux de découvrir les secrets et techniques des maîtres Escoffier, Paul Bocuse..."
    ],
    "nl": [
      "FRAZARIN is een Frans-Italiaanse Bistro, die u het verhaal laat ontdekken van FRAZARIN, een jonge Italiaan die we volgen in zijn inwijdingsreis door Frankrijk, nieuwsgierig naar de geheimen en technieken van de meesters Escoffier, Paul Bocuse..."
    ],
    "es": [
      "FRAZARIN es un bistró franco-italiano, que te lleva a descubrir la historia de FRAZARIN, un joven italiano al que seguimos en su viaje iniciático por Francia, curioso por descubrir los secretos y las técnicas de los maestros Escoffier, Paul Bocuse..."
    ]
  },
