  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum und in der Nähe des Strandes gelegen, mit einer Terrasse. Große Fensterfront. Einladender Raum mit herzlichem Empfang. Familiäre Atmosphäre. Traditionelle Küche, die vom Chefkoch angeboten wird. Fisch- und Fleischspezialitäten."
    ],
    "en": [
      "Situated in the town centre and close to the beach, with a terrace. Large bay window. Friendly room, with a warm welcome. Family atmosphere. Traditional cuisine proposed by the chef. Fish and meat specialities."
    ],
    "it": [
      "Situato nel centro della città e vicino alla spiaggia, con terrazza. Ampio bovindo. Camera accogliente, con un'accoglienza calorosa. Atmosfera familiare. Cucina tradizionale offerta dallo chef. Specialità di pesce e carne."
    ],
    "fr": [
      "Situe en centre ville et a proximite de la plage, avec une terrasse. Grande baie vitree. Salle accueillante, avec un accueil chaleureux. Ambiance familiale. Cuisine traditionnelle proposee par le chef. Specialites poissons et viandes."
    ],
    "es": [
      "Situado en el centro de la ciudad y cerca de la playa, con terraza. Gran ventanal. Habitación acogedora, con una cálida bienvenida. Ambiente familiar. Cocina tradicional ofrecida por el chef. Especialidades de pescado y carne."
    ],
    "nl": [
      "Gelegen in het stadscentrum en dicht bij het strand, met een terras. Grote erker. Gezellige kamer, met een warm welkom. Familiale sfeer. Traditionele keuken aangeboden door de chef. Vis- en vleesspecialiteiten."
    ]
  },
