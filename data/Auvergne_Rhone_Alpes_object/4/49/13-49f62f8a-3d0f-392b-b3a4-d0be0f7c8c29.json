  "rdfs:comment": {
    "de": [
      "Hersteller von Naturkosmetik mit Bio-Eselsmilch: kaltverseifte Seifen, Duschgels, Körpermilch, Peelingcreme, Bio-Feuchtigkeitsmaske, Bio-Make-up-Entferner. Vor Ort zu entdecken: Eselzucht und Verkostung von Eselsmilch."
    ],
    "en": [
      "Asses' milk cosmetics: soaps, shower gel, body lotion, body scrub cream, organic facial moisturizing mask, organic make-up remover..."
    ],
    "it": [
      "Creatore di cosmetici naturali a base di latte d'asina biologico: saponi saponificati a freddo, gel doccia, latti per il corpo, maschere idratanti, latte detergente. Le attività in loco comprendono l'allevamento di asini, la degustazione di latte d'asina e il massaggio egiziano."
    ],
    "fr": [
      "Créateur de cosmétiques naturels au lait d'ânesse bio : savons saponifié à froid , gels douches, laits corporels, masque hydratant, lait démaquillant. A découvrir sur place : l'élevage des ânes, la dégustation de lait d'ânesse et le massage égyptien."
    ],
    "es": [
      "Creador de cosméticos naturales elaborados con leche de burra ecológica: jabones saponificados en frío, geles de ducha, leches corporales, mascarillas hidratantes, leche limpiadora. Actividades in situ: cría de burras, degustación de leche de burra y masaje egipcio."
    ],
    "nl": [
      "Cosmetica op basis van ezelinnenmelk: zeep, douchegel, bodylotion, peelings, biologische hydraterende maskers, biologische reinigingsmelk, etc."
    ]
  },
