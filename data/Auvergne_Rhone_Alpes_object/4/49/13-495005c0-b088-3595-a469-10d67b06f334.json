  "rdfs:comment": {
    "de": [
      "Der Parkplatz \"Les Grands prés\" an der Straße nach Taulignan bietet Platz für 50 Fahrzeuge.\r\nAchtung: Das Parken ist für Wohnmobile und andere ausgestattete Fahrzeuge verboten."
    ],
    "en": [
      "The Parking des Grands prés on the Route de Taulignan can accommodate 50 vehicles.\r\nPlease note: parking is prohibited for campers and other converted vehicles."
    ],
    "it": [
      "Il parcheggio Grands prés sulla route de Taulignan può ospitare 50 veicoli.\r\nAttenzione: i camper e altri veicoli trasformati non possono parcheggiare qui."
    ],
    "fr": [
      "Le Parking des Grands prés situé sur la route de Taulignan peut accueillir 50 véhicules.\r\nAttention : le stationnement est interdit aux camping-cars et autres véhicules aménagés."
    ],
    "es": [
      "El aparcamiento de Grands prés, en la ruta de Taulignan, tiene capacidad para 50 vehículos.\r\nAtención: las autocaravanas y otros vehículos transformados no pueden aparcar aquí."
    ],
    "nl": [
      "De parkeerplaats Grands prés op de route de Taulignan biedt plaats aan 50 voertuigen.\r\nLet op: campers en andere omgebouwde voertuigen zijn niet toegestaan."
    ]
  },
  "rdfs:label": {
