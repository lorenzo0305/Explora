  "rdfs:comment": {
    "de": [
      "Der Küchenchef Hervé Crozier freut sich, Sie in seinem Restaurant begrüßen zu dürfen und Ihnen seine traditionelle französische Küche mit Gerichten voller Aromen vorzustellen, die Ihren Gaumen verzaubern werden."
    ],
    "en": [
      "Very beautiful setting"
    ],
    "it": [
      "Hervé Crozier, chef de cuisine, è lieto di darvi il benvenuto nel suo ristorante e di presentarvi la sua cucina tradizionale francese con piatti pieni di sapore che delizieranno il vostro palato."
    ],
    "fr": [
      "Hervé Crozier, chef de cuisine, a le plaisir de vous accueillir dans son restaurant et de vous faire découvrir sa cuisine traditionnelle française avec des mets pleins de saveurs qui enchanteront vos papilles."
    ],
    "nl": [
      "Hervé Crozier, chef de cuisine, verwelkomt u graag in zijn restaurant en laat u kennismaken met zijn traditionele Franse keuken met gerechten vol smaak die uw smaakpapillen zullen verrukken."
    ],
    "es": [
      "Hervé Crozier, chef de cocina, se complace en darle la bienvenida a su restaurante y presentarle su cocina tradicional francesa con platos llenos de sabor que harán las delicias de su paladar."
    ]
  },
