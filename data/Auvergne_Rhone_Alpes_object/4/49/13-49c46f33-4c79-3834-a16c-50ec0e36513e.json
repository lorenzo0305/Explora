  "rdfs:comment": {
    "de": [
      "Mein Name ist Agnes, ich bin Kosmetikerin seit 2000 und freue mich, Sie in einem schlichten und gemütlichen Raum im Herzen der Stadt begrüßen zu dürfen (seit 2006)."
    ],
    "en": [
      "My name is Agnès, and I've been a beautician since 2000. I'm delighted to welcome you to a warm, uncluttered space in the heart of the city (since 2006)."
    ],
    "it": [
      "Mi chiamo Agnès, lavoro come estetista dal 2000 e sono lieta di accogliervi in uno spazio caldo e ordinato nel cuore della città (dal 2006)."
    ],
    "fr": [
      "Je m'appelle Agnès, esthéticienne depuis 2000, et j'ai le plaisir de vous accueillir dans un espace épuré et chaleureux, au coeur de la ville (depuis 2006)."
    ],
    "nl": [
      "Mijn naam is Agnès en ik ben sinds 2000 werkzaam als schoonheidsspecialiste. Ik heet u van harte welkom in een warme, opgeruimde ruimte in het hart van de stad (sinds 2006)."
    ],
    "es": [
      "Me llamo Agnès y trabajo como esteticista desde el año 2000. Estoy encantada de recibirte en un espacio cálido y despejado en pleno centro de la ciudad (desde 2006)."
    ]
  },
