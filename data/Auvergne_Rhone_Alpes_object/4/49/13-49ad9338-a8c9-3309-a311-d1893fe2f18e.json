  "rdfs:comment": {
    "de": [
      "Pizzeria - Restaurant, in dem die Gaumenfreuden jeden Tag auf der Tagesordnung stehen.\r\nWir bieten Ihnen großzügige Pizzen, die mit frischen Zutaten und hausgemachtem Teig zubereitet werden, sowie ein täglich wechselndes Tagesmenü, das sich nach den aktuellen Inspirationen richtet."
    ],
    "en": [
      "Pizzeria - restaurant where gourmet delights are the order of the day.\r\nWe offer generous pizzas made with fresh produce and homemade dough, as well as a daily menu that changes according to the inspiration of the moment."
    ],
    "it": [
      "Pizzeria - ristorante dove le delizie gourmet sono all'ordine del giorno.\r\nOffriamo pizze generose preparate con prodotti freschi e pasta fatta in casa, oltre a un menu giornaliero che cambia in base all'ispirazione del momento."
    ],
    "fr": [
      "Pizzeria - restaurant où la gourmandise est au rendez-vous chaque jour.\r\nNous vous proposons des pizzas généreuses préparées avec des produits frais et une pâte maison, ainsi qu’un menu du jour qui change quotidiennement selon l’inspiration du moment."
    ],
    "nl": [
      "Pizzeria - restaurant waar gastronomische hoogstandjes aan de orde van de dag zijn.\r\nWe bieden royale pizza's gemaakt met verse producten en zelfgemaakt deeg, evenals een dagelijks menu dat verandert volgens de inspiratie van het moment."
    ],
    "es": [
      "Pizzería - restaurante donde las delicias gourmet están a la orden del día.\r\nOfrecemos generosas pizzas elaboradas con productos frescos y masa casera, así como un menú diario que cambia según la inspiración del momento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant pizzeria L'Authentique"
    ]
  },
