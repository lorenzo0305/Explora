      "@id": "https://data.datatourisme.fr/a4103faa-8d61-39cf-a65d-462bcdd5b3b4",
      "dc:description": {
        "de": [
          "Picknickplatz am Kreisverkehr von Chambors, auf der Höhe der Umleitung zwischen Trie-Château und Gisors.\nDieser Bereich ist der Ausgangspunkt für die Wanderung \"La Boucle du Dolmen\""
        ],
        "en": [
          "Picnic area located at the Chambors roundabout, on the detour between Trie-Château and Gisors.\nThis area is the starting point of the hike \"La Boucle du Dolmen\""
        ],
        "it": [
          "Area picnic situata alla rotonda di Chambors, sulla circonvallazione tra Trie-Château e Gisors.\nQuesta zona è il punto di partenza della passeggiata \"Boucle du Dolmen\""
        ],
        "fr": [
          "Aire de pique-nique se situant au rond-point de Chambors, au niveau la déviation entre Trie-Château et Gisors.\nCette aire est le point de départ de la randonnée \"La Boucle du Dolmen\""
        ],
        "es": [
          "Área de picnic situada en la rotonda de Chambors, en la circunvalación entre Trie-Château y Gisors.\nEsta zona es el punto de partida del paseo \"Boucle du Dolmen\""
        ],
        "nl": [
          "Picknickplaats gelegen aan de rotonde van Chambors, op de rondweg tussen Trie-Château en Gisors.\nDit gebied is het vertrekpunt van de wandeling \"Boucle du Dolmen\""
        ]
      },
