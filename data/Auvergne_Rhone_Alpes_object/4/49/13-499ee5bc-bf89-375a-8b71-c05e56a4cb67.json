  "rdfs:comment": {
    "de": [
      "Kleiner Sportparcours in der Nähe der Bergstation der Standseilbahn und des Freiflug-Starts, angrenzend an den Bike Parc und den Kiosk im Parc du Pré Lacour."
    ],
    "en": [
      "A small sports trail near the upper funicular station and the hang-gliding take-off point, adjacent to the Bike Parc and the Kiosque in the Parc du Pré Lacour."
    ],
    "it": [
      "Un piccolo percorso sportivo vicino alla stazione superiore della funicolare e al punto di decollo del deltaplano, adiacente al Bike Parc e al chiosco del Parco Pré Lacour."
    ],
    "fr": [
      "Petit parcours sportif à proximité de la gare haute du funiculaire et du décollage de vol libre, jouxtant le Bike Parc et le Kiosque du Parc du Pré Lacour."
    ],
    "es": [
      "Un pequeño sendero deportivo cerca de la estación superior del funicular y del despegue del ala delta, junto al Bike Parc y el Kiosco del Parque Pré Lacour."
    ],
    "nl": [
      "Een klein sportief parcours in de buurt van het bovenste kabelbaanstation en het vertrekpunt van de deltavliegers, naast het Bike Parc en de Kiosk in het Parc du Pré Lacour."
    ]
  },
  "rdfs:label": {
