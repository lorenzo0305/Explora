  "rdfs:comment": {
    "de": [
      "Le Grill Subtil empfängt Sie in einer familiären Atmosphäre mit hausgemachten Speisen und 30 Jahren Erfahrung!\r\nGruppenrestaurants nur auf Reservierung ab 10 Personen.\r\nLabel Maître-Artisan seit September 2018."
    ],
    "en": [
      "Le Grill Subtil welcomes you in a family atmosphere with homemade cuisine and 30 years of know-how!\r\nGroup catering by reservation only for groups of 10 or more.\r\nMaître-Artisan label since September 2018."
    ],
    "it": [
      "Le Grill Subtil vi accoglie in un'atmosfera familiare con una cucina casalinga e 30 anni di know-how!\r\nRistorazione collettiva su prenotazione per gruppi a partire da 10 persone.\r\nMarchio Maître-Artisan da settembre 2018."
    ],
    "fr": [
      "Le Grill Subtil vous accueille dans une ambiance familiale avec une cuisine faite maison et 30 ans de savoir-faire!\r\nRestauration de groupes uniquement sur réservation à partir de 10 pers.\r\nLabel Maître-Artisan depuis septembre 2018."
    ],
    "nl": [
      "Le Grill Subtil verwelkomt u in een familiale sfeer met een huisbereide keuken en 30 jaar knowhow!\r\nCatering voor groepen op reservering voor groepen vanaf 10 personen.\r\nMaître-Artisan label sinds september 2018."
    ],
    "es": [
      "Le Grill Subtil le da la bienvenida en un ambiente familiar con cocina casera y 30 años de saber hacer\r\nCatering para grupos solo con reserva previa para grupos de 10 personas o más.\r\nEtiqueta Maître-Artisan desde septiembre de 2018."
    ]
  },
