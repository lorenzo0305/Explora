  "rdfs:comment": {
    "de": [
      "Mit über 30 Jahren Erfahrung und als Sohn eines Messerschmieds bietet Ihnen Pierre Mondière eine große Auswahl an Messern aus französischer Herstellung, die Ihnen Qualitätsartikel garantieren."
    ],
    "en": [
      "With more than 30 years of experience and being the son of a knife maker, Pierre Mondière offers you a large choice of French-made knives which guarantees you quality items."
    ],
    "it": [
      "Con oltre 30 anni di esperienza e figlio di un coltellinaio, Pierre Mondière vi offre un'ampia gamma di coltelli di produzione francese che vi garantiscono articoli di qualità."
    ],
    "fr": [
      "Avec plus de 30 ans d'expérience et étant fils de coutelier, Pierre Mondière vous propose un grand choix de couteaux de fabrication française qui vous garantit des articles de qualité."
    ],
    "nl": [
      "Met meer dan 30 jaar ervaring en als zoon van een messenmaker biedt Pierre Mondière u een ruim assortiment messen van Franse makelij die u kwaliteit garanderen."
    ],
    "es": [
      "Con más de 30 años de experiencia y siendo hijo de un cuchillero, Pierre Mondière le ofrece una amplia gama de cuchillos de fabricación francesa que le garantizan artículos de calidad."
    ]
  },
  "rdfs:label": {
    "fr": [
