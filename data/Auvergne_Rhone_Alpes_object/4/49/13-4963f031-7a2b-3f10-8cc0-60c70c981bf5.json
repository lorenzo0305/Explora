  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Abondance empfängt Sie das ganze Jahr über in der Résidence des Alpes und bietet Ihnen eine Auswahl an Büchern für Kinder und Erwachsene. Die Bücher können kostenlos vor Ort eingesehen oder im Abonnement erworben werden."
    ],
    "en": [
      "The library of Abondance welcomes you all year round in the residence of the Alps and offers you a choice of books for children and adults. The books can be consulted free of charge on site or by subscription."
    ],
    "it": [
      "La biblioteca di Abondance vi accoglie tutto l'anno nella residenza delle Alpi e vi offre una scelta di libri per bambini e adulti. I libri possono essere consultati gratuitamente in loco o su abbonamento."
    ],
    "fr": [
      "La bibliothèque d'Abondance vous accueille toute l'année dans la résidence des Alpes et vous propose un choix de livres pour enfants et adultes. Les livres sont consultables gratuitement sur place ou sur abonnement."
    ],
    "es": [
      "La biblioteca de Abondance le acoge todo el año en la residencia de los Alpes y le ofrece una selección de libros para niños y adultos. Los libros pueden consultarse gratuitamente in situ o por suscripción."
    ],
    "nl": [
      "De bibliotheek van Abondance is het hele jaar door geopend in de Résidence des Alpes en biedt een selectie boeken voor kinderen en volwassenen. Boeken kunnen ter plekke gratis worden geraadpleegd of via een abonnement."
    ]
  },
  "rdfs:label": {
