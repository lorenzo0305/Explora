  "rdfs:comment": {
    "de": [
      "Ein Familienbauernhof mit biologischer Landwirtschaft, der sich im Regionalen Naturpark Vercors befindet. Im Hofladen werden verschiedene Produkte angeboten: Eier, Kichererbsen, Terrine, Rillettes, Öl, grüne Linsen..."
    ],
    "en": [
      "An organic family farm located in the Vercors Regional Nature Park. The farm shop offers a variety of products: eggs, chickpeas, terrine, rillettes, oil, green lentils, and more."
    ],
    "it": [
      "Azienda agricola biologica a conduzione familiare nel Parco Naturale Regionale del Vercors. Il negozio della fattoria vende una serie di prodotti: uova, ceci, terrine, rillettes, olio, lenticchie verdi, ecc."
    ],
    "fr": [
      "Une ferme familiale en Agriculture Biologique, située dans le Parc Naturel Régional du Vercors. La boutique de la ferme propose divers produits: œufs, pois chiches, terrine, rillettes, huile, lentilles vertes..."
    ],
    "es": [
      "Granja familiar ecológica situada en el Parque Natural Regional de Vercors. La tienda de la granja vende diversos productos: huevos, garbanzos, terrina, rillettes, aceite, lentejas verdes, etc."
    ],
    "nl": [
      "Een biologische familieboerderij in het regionale natuurpark van de Vercors. De boerderijwinkel verkoopt verschillende producten: eieren, kikkererwten, terrine, rillettes, olie, groene linzen, enz."
    ]
  },
