  "rdfs:comment": {
    "de": [
      "Die École des peintres de Murol(s) ist Teil der postimpressionistischen Bewegung.\r\nEntdecken Sie die einzigartigen Landschaften des Sancy-Massivs zu Beginn des 20. Jahrhunderts!"
    ],
    "en": [
      "The museum of the School of painters of Murol is located after the impressionism. It benefits from the \"Musée de France\" designation. Unique in Auvergne, come and discover the snowy landscapes of the Sancy at the beginning of the 20th century. A-musée you in family."
    ],
    "it": [
      "La Scuola dei pittori di Murol(s) fa parte del movimento post-impressionista.\r\nScoprite i paesaggi unici del massiccio del Sancy all'inizio del XX secolo!"
    ],
    "fr": [
      "L’École des peintres de Murol(s) s’inscrit dans le mouvement postimpressionniste.\r\nDécouvrez les paysages uniques du massif du Sancy du début du XX siècle !"
    ],
    "es": [
      "La Escuela de Pintores de Murol(s) se inscribe en el movimiento postimpresionista.\r\n¡Descubra los paisajes únicos del macizo de Sancy a principios del siglo XX!"
    ],
    "nl": [
      "De schildersschool van Murol(s) maakt deel uit van de post-impressionistische beweging.\r\nOntdek de unieke landschappen van het Sancy-massief aan het begin van de 20e eeuw!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "MÉM / Musée des peintres de l'École de Murol"
    ]
  },
