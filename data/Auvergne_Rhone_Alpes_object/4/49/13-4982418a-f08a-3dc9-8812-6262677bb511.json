  "rdfs:comment": {
    "de": [
      "Isabelle lebt und arbeitet in Vercheny, wo sie ihr Atelier für die Öffentlichkeit nur nach vorheriger Anmeldung öffnet. Sie lässt sich von der Natur inspirieren und hat einen kreativen Sinn für Skulpturen, Gemälde und Drucke, die einen gemeinsamen Nenner haben: die Farbe!"
    ],
    "en": [
      "Isabelle lives and works in Vercheny, where she opens her studio to the public by reservation only. Inspired by nature, her creative sense enables her to create scuptures, paintings and engravings with a common denominator: color!"
    ],
    "it": [
      "Isabelle vive e lavora a Vercheny, dove apre il suo laboratorio al pubblico su prenotazione. Ispirata dalla natura, il suo senso creativo le permette di creare sculture, dipinti e incisioni con un comune denominatore: il colore!"
    ],
    "fr": [
      "Isabelle vit et travaille à Vercheny où elle ouvre son atelier de créations au public sur réservation uniquement. S'inspirant de la nature, son sens créatif lui permet de réaliser scuptures, peintures, gravures avec un dénominateur commun : la couleur!"
    ],
    "nl": [
      "Isabelle woont en werkt in Vercheny, waar ze haar atelier alleen op afspraak openstelt voor publiek. Geïnspireerd door de natuur creëert ze met haar creatieve flair sculpturen, schilderijen en gravures met als gemene deler: kleur!"
    ],
    "es": [
      "Isabelle vive y trabaja en Vercheny, donde abre su taller al público sólo con reserva. Inspirada por la naturaleza, su sentido creativo le permite crear esculturas, pinturas y grabados con un denominador común: ¡el color!"
    ]
  },
