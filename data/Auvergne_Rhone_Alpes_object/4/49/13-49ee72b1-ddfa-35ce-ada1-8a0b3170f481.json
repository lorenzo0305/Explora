  "rdfs:comment": {
    "de": [
      "Der Laschamp-Teich liegt wenige Kilometer südlich der Stadt Manzat auf einer Höhe von 820 Metern. Es handelt sich um einen etwa 7 Hektar großen Naturteich in einem der seltenen Feuchtgebiete nördlich des Naturparks der Vulkane der Auvergne."
    ],
    "en": [
      "Laschamp pond is located a few kilometers south of the town of Manzat at an altitude of 820 meters. It is a natural pond of approximately 7 hectares located in one of the rare wetlands, to the north of the Auvergne volcanoes natural park."
    ],
    "it": [
      "L'Etang de Laschamp si trova a pochi chilometri a sud del villaggio di Manzat, a un'altitudine di 820 metri. Si tratta di uno stagno naturale di circa 7 ettari situato in una delle rare zone umide del nord del Parco Naturale dei Vulcani d'Alvernia."
    ],
    "fr": [
      "L'étang de Laschamp est situé à quelques kilomètres au sud du bourg de Manzat à 820 mètres d'altitude. C'est un étang naturel d'environ 7 hectares situé dans une des rares zones humides, au nord du parc naturel des volcans d'Auvergne."
    ],
    "nl": [
      "Het Etang de Laschamp ligt een paar kilometer ten zuiden van het dorp Manzat op een hoogte van 820 meter. Het is een natuurlijk meer van ongeveer 7 hectare in een van de zeldzame vochtige gebieden in het noorden van het natuurpark van de Vulkanen van de Auvergne."
    ],
    "es": [
      "El Etang de Laschamp se encuentra a unos kilómetros al sur del pueblo de Manzat, a 820 metros de altitud. Es un estanque natural de unas 7 hectáreas situado en uno de los raros humedales del norte del Parque Natural de los Volcanes de Auvernia."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Étang de Lachamp"
    ],
    "en": [
      "Fishing site - Étang de Lachamp"
    ],
    "fr": [
      "Site de pêche - Étang de Lachamp"
    ]
  },
