  "rdfs:comment": {
    "de": [
      "Le Diable au C?ur ist ein unumgängliches Reiseziel in den französischen Alpen, das mit Skiern oder zu Fuß (und im Sommer mit dem Fahrrad) über die Sessel- und Gondelbahnen von Le Diable erreichbar ist"
    ],
    "en": [
      "Le Diable au Cœur is a must-visit destination in the French Alps, accessible on skis or on foot (and by bike in summer) via the Diable chairlift–gondola lifts."
    ],
    "it": [
      "Le Diable au Cœur è una destinazione imperdibile delle Alpi francesi, accessibile sci ai piedi o a piedi (e in bici d’estate) tramite gli impianti seggiovia–telecabina del Diable."
    ],
    "fr": [
      "Le Diable au Cœur est une destination incontournable des Alpes Française, accessible à Ski ou en piéton (et en vélo l’été) par les télésièges-télécabines du Diable"
    ],
    "es": [
      "Le Diable au Cœur es un destino ineludible de los Alpes franceses, al que se puede acceder esquiando o a pie (y en bicicleta en verano) a través de los telesillas del Diable"
    ],
    "nl": [
      "Le Diable au C?ur is een niet te missen bestemming in de Franse Alpen, bereikbaar per ski of te voet (en in de zomer per fiets) via de Diable stoeltjesliften"
    ]
  },
  "rdfs:label": {
    "en": [
      "Mountain restaurant - Le Diable au Coeur - Alt. 2400m"
    ],
    "it": [
      "Ristorante di montagna - Le Diable au Coeur - Alt. 2400m"
    ],
    "fr": [
      "Restaurant d'altitude - Le Diable au Cœur - Alt 2400m"
    ]
  },
