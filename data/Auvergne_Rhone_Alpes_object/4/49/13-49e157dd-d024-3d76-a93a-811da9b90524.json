  "rdfs:comment": {
    "de": [
      "Finde mithilfe deiner Karte die Markierungen, die in den Gemeinden Bressieux, St Pierre de Bressieux und St Siméon de Bressieux aufgestellt wurden, um dort bemerkenswerte Orte zu entdecken."
    ],
    "en": [
      "With the help of your map, find the beacons installed in Bressieux, St Pierre de Bressieux, St Siméon de Bressieux, to discover remarkable sites."
    ],
    "it": [
      "Utilizzando la vostra mappa, trovate i cartelli segnaletici installati nei comuni di Bressieux, St Pierre de Bressieux e St Siméon de Bressieux e scoprite i siti degni di nota."
    ],
    "fr": [
      "A l'aide de votre carte, trouvez les balises installées sur les communes de Bressieux, St Pierre de Bressieux, St Siméon de Bressieux, pour y découvrir des sites remarquables."
    ],
    "nl": [
      "Zoek met je kaart de wegwijzers in de gemeenten Bressieux, St Pierre de Bressieux en St Siméon de Bressieux en ontdek de opmerkelijke plekjes."
    ],
    "es": [
      "Con ayuda de su mapa, localice los postes indicadores instalados en los municipios de Bressieux, St Pierre de Bressieux y St Siméon de Bressieux, y descubra los lugares notables."
    ]
  },
