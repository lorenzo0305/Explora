  "rdfs:comment": {
    "de": [
      "Der Weihnachtsmann hat das gesamte Team der Mediathek requiriert, um Ihnen einen festlichen und geselligen Nachmittag für die ganze Familie zu ermöglichen."
    ],
    "en": [
      "Santa Claus has commandeered the entire media library team for a festive afternoon of fun for all the family."
    ],
    "it": [
      "Babbo Natale ha incaricato l'intero team della mediateca di organizzare un pomeriggio di festa e divertimento per tutta la famiglia."
    ],
    "fr": [
      "Le père Noël a réquisitionné toute l'équipe de la médiathèque pour vous permettre de passer une après-midi festive et conviviale pour toute la famille."
    ],
    "es": [
      "Papá Noel ha convocado a todo el equipo de la mediateca para ofrecerle una tarde festiva de diversión para toda la familia."
    ],
    "nl": [
      "De kerstman heeft het hele mediatheekteam ingeroepen om je een feestelijke middag vol plezier voor het hele gezin te bezorgen."
