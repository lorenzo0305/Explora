  "rdfs:comment": {
    "de": [
      "Bei einer Entdeckungsreise auf dieser tief eingeschnittenen und sehr wilden Strecke können Sie sich für die Dauer einer Angelpartie von der Zivilisation abkoppeln."
    ],
    "en": [
      "By discovering this steep and very wild course, you will disconnect from civilization, the time of a fishing party."
    ],
    "it": [
      "Si tratta di un percorso molto selvaggio e aspro, dove è possibile staccare dalla civiltà e godersi una battuta di pesca."
    ],
    "fr": [
      "En partant à la découverte de ce parcours encaissé et très sauvage, vous vous déconnecterez de la civilisation, le temps d'une partie de pêche."
    ],
    "es": [
      "Se trata de un recorrido muy salvaje y agreste en el que podrá desconectar de la civilización y disfrutar de una excursión de pesca."
    ],
    "nl": [
      "Dit is een zeer wilde en ruige baan waar u zich kunt losmaken van de beschaving en kunt genieten van een vistocht."
    ]
  },
  "rdfs:label": {
    "fr": [
