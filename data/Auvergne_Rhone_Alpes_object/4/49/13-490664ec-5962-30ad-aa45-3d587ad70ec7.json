  "rdfs:comment": {
    "de": [
      "Das Hotel Die Gastfreundlichen, das Reizhotel, ist im alten Dorf von Poët-Laval eingerichtet, geordnet unter \" den schönsten Dörfern von Frankreich \"."
    ],
    "en": [
      "In the village of  \"Poët-Laval\", in Drôme Provençale, 5 kms from Dieulefit (village of potters), 20 kms from Montélimar, and at the top of one of France's most beautiful villages, this  charming Hotel and Restaurant, welcomes you with great care."
    ],
    "it": [
      "L'Hotel Les Hospitaliers, un albergo di charme, si trova nell'antico villaggio di Le Poët-Laval, classificato come uno dei \"più bei villaggi di Francia\"."
    ],
    "fr": [
      "L'Hôtel Les Hospitaliers, hôtel de charme, est aménagé dans le vieux village du Poët-Laval, classé parmi \"les plus beaux villages de France\"."
    ],
    "nl": [
      "Het Hotel ziekenhuismedewerkers, charmante hotel ligt in de oude dorpskern van Poët-Laval, ingedeeld onder \" de mooiste dorpen van Frankrijk\"."
    ],
    "es": [
      "El Hotel Les Hospitaliers, un hotel con encanto, está situado en el antiguo pueblo de Le Poët-Laval, clasificado como uno de los \"pueblos más bonitos de Francia\"."
    ]
  },
