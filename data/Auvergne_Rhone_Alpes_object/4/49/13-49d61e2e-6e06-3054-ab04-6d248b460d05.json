  "rdfs:comment": {
    "de": [
      "Atelier/Ausstellung in Dieulefit: Ölmalerei, Zeichnungen, Pastellkreide. Von figurativ bis abstrakt, von Landschaften bis zu Figuren, die Hand führt das Messer.\r\nZu Hause (48 chemin de la Montagne) in Francillon/Roubion."
    ],
    "en": [
      "Workshop/Exhibition in Dieulefit: oil paintings, drawings, pastels. Figurative to abstract art, landscapes to characters…"
    ],
    "it": [
      "Workshop/mostra a Dieulefit: pittura a olio, disegni, pastelli, dal figurativo all'astratto, dai paesaggi ai personaggi, la mano guida il coltello.\r\nIn casa (48 chemin de la Montagne) a Francillon/Roubion."
    ],
    "fr": [
      "Atelier /expo à Dieulefit : peinture à l’huile , dessins, pastels .Du figuratif à l’abstrait , des paysages aux personnages, la main guide le couteau.\r\nA domicile (48 chemin de la Montagne) à Francillon/Roubion."
    ],
    "nl": [
      "Workshop/tentoonstelling in Dieulefit: olieverfschilderijen, tekeningen, pastels, van figuratief tot abstract, van landschappen tot personages, de hand leidt het mes.\r\nThuis (48 chemin de la Montagne) in Francillon/Roubion."
    ],
    "es": [
      "Taller/exposición en Dieulefit: pintura al óleo, dibujos, pasteles, de lo figurativo a lo abstracto, de los paisajes a los personajes, la mano guía el cuchillo.\r\nEn casa (48 chemin de la Montagne) en Francillon/Roubion."
    ]
  },
