  "rdfs:comment": {
    "de": [
      "Golf 9 Löcher zu 35, auf mehr als 18 Hektar in der Landschaft der Provence. Zugänglich für jeden, Trainingsbereiche, Putting Green, Übungsplatz, Restaurant, Bar und Schwimmbad."
    ],
    "en": [
      "Golf 9 holes with 35, set on 18 acres of Provencal countryside. Open to all, training areas, putting green, driving range, restaurant, bar and swimming pool."
    ],
    "it": [
      "Sempre nella Drôme ma già in Provenza, circondato da ginestre, viti e ulivi, profumato di timo e lavanda, il campo di Clansayes offre fairway tecnici e green veloci."
    ],
    "fr": [
      "Encore dans la Drôme mais déjà en Provence, au milieu des genêts, des vignes et des oliviers, embaumé par les senteurs de thym et de lavande, le parcours de Clansayes vous fera profiter de sa technicité des fairways et de la vitesse de ses greens."
    ],
    "es": [
      "Todavía en la Drôme pero ya en Provenza, rodeado de retamas, viñas y olivos, perfumado de tomillo y lavanda, el campo de Clansayes ofrece calles técnicas y greens rápidos."
    ],
    "nl": [
      "Golf 9-holes tot 35, op een terrein van 18 hectare in de Provençaalse campagne. Voor iedereen toegankelijk, oefengedeelte, putting green, practice, restaurant, bar en Zwembad."
    ]
  },
