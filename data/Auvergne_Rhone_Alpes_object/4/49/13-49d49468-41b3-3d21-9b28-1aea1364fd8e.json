  "rdfs:comment": {
    "de": [
      "La Halle Hybride, was ist das?\r\nLa Halle ist ein Drittort, der einen kulturellen und künstlerischen Raum der Geselligkeit, des Teilens und des Austauschs bietet, der für alle offen ist."
    ],
    "en": [
      "What is the Hybrid Hall?\r\nLa Halle is a third place which proposes a cultural and artistic space of conviviality, sharing and exchanges opened to all."
    ],
    "it": [
      "Che cos'è La Halle Hybride?\r\nLa Halle è un terzo luogo che offre uno spazio culturale e artistico di convivialità, condivisione e scambio aperto a tutti."
    ],
    "fr": [
      "La Halle Hybride, c’est quoi ? \r\nLa Halle est un tiers-lieu qui propose un espace culturel et artistique de convivialité, de partage et d'échanges ouvert à tous."
    ],
    "es": [
      "¿Qué es La Halle Hybride?\r\nLa Halle es un tercer lugar que ofrece un espacio cultural y artístico de convivencia, puesta en común e intercambio abierto a todos."
    ],
    "nl": [
      "Wat is La Halle Hybride?\r\nLa Halle is een derde plaats die een culturele en artistieke ruimte biedt voor gezelligheid, delen en uitwisseling die voor iedereen openstaat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La halle hybride"
    ]
  },
