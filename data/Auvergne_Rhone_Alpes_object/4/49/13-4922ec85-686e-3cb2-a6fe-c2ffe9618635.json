  "rdfs:comment": {
    "de": [
      "5 Strecken von der Mini-Abfahrt bis zur 37 km langen Strecke mit Biwak, frei oder mit Begleitung. Empfang mit Kaffee, Tee und einem kleinen Roséwein aus dem Land, der bei der Rückkehr angeboten wird, direkter Start. Sicherheitsbriefing und detaillierte Informationen. Großer geschlossener Parkplatz, Motorradgarage, Duschen."
    ],
    "en": [
      "5 routes, from mini-descent to 37 km with bivouac, free or accompanied. Welcome with complimentary coffee, tea and local rosé, direct departure. Detailed safety briefing. Large enclosed parking area, motorcycle garage, showers."
    ],
    "it": [
      "5 percorsi, che vanno da una mini discesa a una discesa di 37 km con bivacco, liberi o accompagnati. Accoglienza con caffè, tè e rosé locale in omaggio e partenza diretta. Briefing dettagliato sulla sicurezza. Ampio parcheggio recintato, garage per le moto, docce."
    ],
    "fr": [
      "5 parcours de la mini descente à celle de 37 km avec bivouac, libres ou accompagnés. Accueil avec café, thé et petit rosé de pays offerts au retour, départ direct. Briefing sécurité et détaillé. Grand parking fermé, garage à moto, douches."
    ],
    "es": [
      "5 rutas, desde un mini descenso hasta un descenso de 37 km con vivac, libres o acompañadas. Bienvenida con café, té y rosado local de cortesía, y salida directa. Instrucciones de seguridad detalladas. Amplio aparcamiento cerrado, garaje para motos, duchas."
    ],
    "nl": [
      "5 routes, variërend van een minidaling tot een afdaling van 37 km met bivak, gratis of onder begeleiding. Ontvangst met gratis koffie, thee en lokale rosé, en direct vertrek. Gedetailleerde veiligheidsbriefing. Grote afgesloten parkeerplaats, motorstalling, douches."
    ]
  },
