  "rdfs:comment": {
    "de": [
      "Der Espace Découverte bietet einen ständigen szenografischen Rundgang über das Kulturerbe des Pays de L'Arbresle sowie wechselnde Ausstellungen. Er beherbergt auch ein Atelier-Musée du tissage (Weberei-Museum), in dem Materialien mit Zeugnissen und Filmen ausgestellt werden."
    ],
    "en": [
      "This Discovery Centre mirrors the heritage and culture of the area in and around L'Arbresle through a museographic trail that invites visitors to explore the territory, meet its inhabitants and discover the landscapes of this land of confluence."
    ],
    "it": [
      "L'Espace Découverte offre un percorso scenografico permanente del patrimonio del Pays de L'Arbresle e mostre temporanee. Ospita anche un museo-laboratorio di tessitura che presenta materiali accompagnati da testimonianze e filmati."
    ],
    "fr": [
      "L'Espace Découverte propose un parcours scénographique permanent sur le patrimoine du Pays de L'Arbresle ainsi que des expositions temporaires. Il abrite aussi un Atelier-musée du tissage présentant des matériels accompagnés de témoignages et de films."
    ],
    "es": [
      "El Espace Découverte ofrece un recorrido escenográfico permanente del patrimonio del Pays de L'Arbresle, así como exposiciones temporales. También alberga un museo-taller de tejido que presenta materiales acompañados de testimonios y películas."
    ],
    "nl": [
      "De Espace Découverte biedt een permanente scenografische rondleiding door het erfgoed van het Pays de L'Arbresle en tijdelijke tentoonstellingen. Het herbergt ook een weefmuseum-werkplaats waar materialen met getuigenissen en films worden gepresenteerd."
    ]
  },
