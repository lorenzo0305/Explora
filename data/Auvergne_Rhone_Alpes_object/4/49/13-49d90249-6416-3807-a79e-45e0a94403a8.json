  "rdfs:comment": {
    "de": [
      "Im L'Arboisie bestaunt man das Panorama auf das Dorf und die sonnigen Berge. Tanken Sie neue Energie und erleben Sie authentische und herzliche Bergmomente in einer der Suiten, im Restaurant, in der Bar, im Schwimmbad & im Wellnessbereich."
    ],
    "en": [
      "At L'Arboisie, you'll marvel at the panoramic views over the village and the sun-drenched mountains. Recharge your batteries and enjoy warm, authentic mountain moments in one of its Suites, restaurant, bar, pool & wellness facilities."
    ],
    "it": [
      "A L'Arboisie, ammirate la vista panoramica sul villaggio e sulle montagne assolate. Ricaricate le batterie e vivete autentiche e accoglienti esperienze di montagna in una delle sue suite, nel ristorante, nel bar, nella piscina e nel centro benessere."
    ],
    "fr": [
      "À L'Arboisie, on s’émerveille du panorama sur le village et les montagnes ensoleillées. Ressourcez-vous et vivez des moments de montagne authentiques et chaleureux dans l'une de ses suites, restaurant, bar, piscine & wellness."
    ],
    "es": [
      "En L'Arboisie, maravíllese con las vistas panorámicas sobre el pueblo y las montañas bañadas por el sol. Recargue las pilas y disfrute de cálidos y auténticos momentos de montaña en una de sus suites, restaurante, bar, piscina y zona de bienestar."
    ],
    "nl": [
      "Bewonder in L'Arboisie het panoramische uitzicht over het dorp en de zonovergoten bergen. Doe nieuwe energie op en geniet van warme, authentieke bergmomenten in een van de suites, het restaurant, de bar, het zwembad en de wellnessruimte."
    ]
  },
