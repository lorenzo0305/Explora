  "rdfs:comment": {
    "de": [
      "Rodolphe Dachard erfüllte sich mit dem Erwerb dieses 8 ha großen Weinguts einen Jugendtraum. Er ist ein Liebhaber seiner Region und möchte den Wein aus St-Pourçain in größerem Umfang bekannt machen. Kommen Sie auf das Weingut und probieren Sie die Cuvées."
    ],
    "en": [
      "Rodolphe Dachard has fulfilled a childhood dream by acquiring this 8-hectare estate. He loves his region and is keen to promote St-Pourçain wine on a wider scale. Come and taste the vintages at the estate."
    ],
    "it": [
      "Rodolphe Dachard ha realizzato il suo sogno d'infanzia acquistando questa tenuta di 8 ettari. È un amante della sua regione e vuole far conoscere il vino di St-Pourçain su scala più ampia. Venite a degustare le annate nella tenuta."
    ],
    "fr": [
      "Rodolphe Dachard a exaucé son rêve de jeunesse en acquérant ce domaine de 8ha. C'est un amoureux de sa région et il souhaite faire découvrir le vin de St-Pourçain à plus grande échelle. Venez déguster les cuvées au domaine."
    ],
    "nl": [
      "Rodolphe Dachard heeft zijn jeugddroom vervuld door dit landgoed van 8 ha te verwerven. Hij is een liefhebber van zijn streek en wil de wijn van St-Pourçain op grotere schaal bekend maken. Kom en proef de wijnen op het landgoed."
    ],
    "es": [
      "Rodolphe Dachard ha cumplido el sueño de su infancia al adquirir esta finca de 8 hectáreas. Es un amante de su región y quiere dar a conocer el vino de St-Pourçain a mayor escala. Venga a degustar las cosechas en la finca."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Les Roches"
    ]
  },
