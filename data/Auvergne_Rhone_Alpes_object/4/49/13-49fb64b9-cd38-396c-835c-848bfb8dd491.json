  "rdfs:comment": {
    "de": [
      "Das erste Reservoir, das dem Angeln von Großforellen mit Kunstködern gewidmet ist. Diese Spezialität ist in Italien und Japan weithin bekannt, wo manche Angler auf die damit verbundenen Sensationen schwören. Angeln im No-Kill-Verfahren."
    ],
    "en": [
      "The first reservoir dedicated to big trout fishing with lures. This specialty is widely recognized in Italy and Japan, where some anglers swear by the sensations it provides. Full no-kill fishing."
    ],
    "it": [
      "Il primo bacino dedicato alla pesca alla trota grossa con esche artificiali. Questa specialità è ampiamente riconosciuta in Italia e in Giappone, dove alcuni pescatori giurano sulle sensazioni che offre. Pesca completamente no-kill."
    ],
    "fr": [
      "Le premier réservoir dédié à la pêche de grosses truites aux leurres. Cette spécialité est largement reconnue en Italie ou aux Japon où certains pêcheurs ne jurent que par les sensations qu'elle procure. Pêche en no kill intégral."
    ],
    "nl": [
      "Het eerste reservoir gewijd aan het vissen op grote forel met kunstaas. Deze specialiteit wordt alom erkend in Italië en Japan, waar sommige vissers zweren bij de sensaties die het biedt. Volledig no-kill vissen."
    ],
    "es": [
      "El primer embalse dedicado a la pesca de grandes truchas con señuelos. Esta especialidad es ampliamente reconocida en Italia y Japón, donde algunos pescadores juran por las sensaciones que proporciona. Pesca sin muerte."
    ]
  },
  "rdfs:label": {
