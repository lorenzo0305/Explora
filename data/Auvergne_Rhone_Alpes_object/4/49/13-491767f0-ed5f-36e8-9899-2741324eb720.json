  "rdfs:comment": {
    "de": [
      "Individuelle Gestaltung von verschiedenen Trägern (Textilien, Leder, Holz), die von Hand für Ihre Erinnerungen dekoriert werden, und personalisierte Geschenke.\r\n\r\nMobiles Atelier: Durchführung von privaten kreativen Workshops für Gruppen (Familien, Freunde...).\r\nEin kreatives Erlebnis mit Ihren Lieben"
    ],
    "en": [
      "Customization of various materials (textile, leather, wood), hand-decorated for souvenirs and personalized gifts.\r\n\r\nMobile workshop: private creative workshops for groups (families, friends...).\r\nA creative experience with your loved ones"
    ],
    "it": [
      "Personalizzazione di vari materiali (tessuti, pelle, legno) decorati a mano per i vostri souvenir e regali personalizzati.\r\n\r\nLaboratorio mobile: laboratori creativi privati per gruppi (famiglie, amici, ecc.).\r\nUn'esperienza creativa con i vostri cari"
    ],
    "fr": [
      "Customisation de supports variés (textile, cuir, bois) décorés à la main pour vos souvenirs, et cadeaux personnalisés.\r\n\r\nAtelier mobile: animation d'ateliers créatifs privés pour les groupes (familles, amis...).\r\nUne expérience créative avec vos proches"
    ],
    "es": [
      "Personalización de diversos materiales (textil, cuero, madera) decorados a mano para sus recuerdos y regalos personalizados.\r\n\r\nTaller móvil: talleres creativos privados para grupos (familias, amigos, etc.).\r\nUna experiencia creativa con sus seres queridos"
    ],
    "nl": [
      "Customisatie van verschillende materialen (textiel, leer, hout) met de hand gedecoreerd voor je souvenirs en gepersonaliseerde geschenken.\r\n\r\nMobiele werkplaats: creatieve privéworkshops voor groepen (families, vrienden, enz.).\r\nEen creatieve ervaring met je geliefden"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Lab'Créatif"
    ]
  },
