  "rdfs:comment": {
    "de": [
      "Unser Leben besteht aus Unsicherheiten, Zweifeln, Umschwüngen und Verzicht, die eine einfache, aber radikale Frage aufwerfen: Woran halten wir fest?"
    ],
    "en": [
      "Our lives are made up of uncertainties, doubts, reversals and renunciations that raise a simple but radical question: what are we holding on to?"
    ],
    "it": [
      "La nostra vita è fatta di incertezze, dubbi, rovesci e rinunce che sollevano una domanda semplice ma radicale: a cosa ci aggrappiamo?"
    ],
    "fr": [
      "Nos vies sont faites d’incertitudes, de doutes, de revirements, de renoncements qui posent une question simple mais radicale : à quoi tenons-nous ?"
    ],
    "nl": [
      "Ons leven bestaat uit onzekerheden, twijfels, omkeringen en verloocheningen die een eenvoudige maar radicale vraag oproepen: waar houden we ons aan vast?"
    ],
    "es": [
      "Nuestra vida está hecha de incertidumbres, dudas, retrocesos y renuncias que plantean una pregunta sencilla pero radical: ¿a qué nos aferramos?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Nos vies sur la brèche, une pilosophie de l'intenable ?"
    ]
  },
