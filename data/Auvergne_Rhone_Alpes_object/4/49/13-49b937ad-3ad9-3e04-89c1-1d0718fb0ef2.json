  "rdfs:comment": {
    "de": [
      "Dieses ehemalige Kavalleriequartier, das unter Denkmalschutz steht, ist ein Ort der Exzellenz, der sich dem materiellen Erbe von Live-Darbietungen widmet. Es empfängt Sie für maßgeschneiderte Veranstaltungen!"
    ],
    "en": [
      "A place of excellence dedicated to the material heritage of live shows, this former cavalry quarter, classified as a Historic Monument, welcomes you for tailor-made events!"
    ],
    "it": [
      "Luogo di eccellenza dedicato al patrimonio materiale dello spettacolo dal vivo, questo ex quartiere di cavalleria, classificato come monumento storico, vi accoglie per eventi su misura!"
    ],
    "fr": [
      "Lieu d’excellence consacré au patrimoine matériel des spectacles vivants, cet ancien quartier de cavalerie classé Monument Historique vous accueille pour des événementiels sur-mesure !"
    ],
    "es": [
      "Lugar de excelencia dedicado al patrimonio material de los espectáculos en vivo, este antiguo barrio de la caballería, clasificado como monumento histórico, le da la bienvenida para eventos a medida"
    ],
    "nl": [
      "Dit voormalige cavaleriekwartier, geklasseerd als historisch monument, verwelkomt u voor evenementen op maat!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre national du costume et de la scène"
    ]
  },
