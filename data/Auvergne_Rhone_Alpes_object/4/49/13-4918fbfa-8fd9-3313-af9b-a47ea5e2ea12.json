  "rdfs:comment": {
    "de": [
      "Les Truites de la Vernaison bietet Ihnen das ganze Jahr über Regenbogen- und Bachforellen im Direktverkauf ab Hof an: frisch, geräuchert, als Filets oder Rillettes. Qualität und authentischer Geschmack sind garantiert!"
    ],
    "en": [
      "Les Truites de la Vernaison sells rainbow and fario trout direct from the farm all year round: fresh, smoked, filleted or rilletted. Quality and authentic flavors guaranteed!"
    ],
    "it": [
      "Les Truites de la Vernaison vende tutto l'anno trote iridee e fario direttamente dalla fattoria: fresche, affumicate, in filetti o rillettes. Qualità e sapori autentici garantiti!"
    ],
    "fr": [
      "Les Truites de la Vernaison vous proposent des truites arc-en-ciel et fario en vente directe à la ferme toute l’année : fraîches, fumées, en filets ou rillettes. Qualité et saveurs authentiques garanties !"
    ],
    "nl": [
      "Les Truites de la Vernaison verkoopt het hele jaar door regenboogforel en fario forel rechtstreeks van de kwekerij: vers, gerookt, in filets of rillettes. Kwaliteit en authentieke smaken gegarandeerd!"
    ],
    "es": [
      "Les Truites de la Vernaison vende truchas arco iris y fario directamente de la piscifactoría durante todo el año: frescas, ahumadas, en filetes o rillettes. Calidad y sabores auténticos garantizados"
    ]
  },
