  "rdfs:comment": {
    "de": [
      "Hotel ** nn Restaurant in Belleville sur sâone, an der Grenze zu den Beaujolais-Weinen gelegen, empfängt Sie der \"Ange Couronné\" für einen Zwischenstopp oder einen Aufenthalt."
    ],
    "en": [
      "Establishment dating from 1640, located in the centre of Belleville, at the gateway of Beaujolais area. The owner and chef as well proposes a varied cuisine ranging from local specialities to home specialities."
    ],
    "it": [
      "Hotel ** nn Ristorante a Belleville sur sâone, situato al limite dei crus del Beaujolais, l'Ange Couronné vi accoglie per una sosta o un soggiorno."
    ],
    "fr": [
      "Hôtel ** nn Restaurant à Belleville sur sâone, situé à la limite des crus du Beaujolais, l'Ange Couronné vous accueille pour une étape ou un séjour."
    ],
    "es": [
      "Hotel ** nn Restaurante en Belleville sur sâone, situado en el límite de los crus del Beaujolais, el Ange Couronné le acoge para una parada o una estancia."
    ],
    "nl": [
      "Hotel ** nn Restaurant in Belleville sur sâone, gelegen aan de grens van de Beaujolais crus, de Ange Couronné verwelkomt u voor een tussenstop of een verblijf."
    ]
