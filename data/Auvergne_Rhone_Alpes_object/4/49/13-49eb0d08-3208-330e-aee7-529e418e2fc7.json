  "rdfs:comment": {
    "de": [
      "Ich arbeite mit Silber, Gold und Messing, aber auch mit anderen Materialien. Jedes Stück, das ohne Guss hergestellt wird, ist ein Unikat. Ich arbeite auf Bestellung und kann ein Schmuckstück anfertigen, dessen Schöpfer Sie sind. Reparaturen Umarbeitungen."
    ],
    "en": [
      "I work in silver, gold and brass, as well as other materials. Each piece made without casting is unique. I work to order and can create a piece of jewellery for you. Repairs and alterations."
    ],
    "it": [
      "Lavoro in argento, oro e ottone, ma anche in altri materiali. Ogni pezzo realizzato senza fusione è unico. Lavoro su ordinazione e posso creare un gioiello per voi. Riparazioni e modifiche."
    ],
    "fr": [
      "Je travaille l'argent, l'or et le laiton mais aussi d'autres matériaux. Chaque pièce réalisée sans moulage est unique. Je travaille sur commande et peux réaliser un bijou dont vous serez le créateur. Réparations transformations."
    ],
    "es": [
      "Trabajo en plata, oro y latón, así como en otros materiales. Cada pieza realizada sin fundición es única. Trabajo por encargo y puedo crear una joya para usted. Reparaciones y arreglos."
    ],
    "nl": [
      "Ik werk in zilver, goud en messing, maar ook in andere materialen. Elk sieraad dat ik maak zonder te gieten is uniek. Ik werk op bestelling en kan een sieraad voor je maken. Reparaties en aanpassingen."
    ]
  },
