  "rdfs:comment": {
    "de": [
      "Reitausflüge von 1 bis 3 Stunden und von 1 Tag bis 5 Tage (Ausritte auf dem Plateau de retord mit Übernachtung in Ferienhäusern).\r\nPonyreiten für Kinder von 2 bis 8 Jahren, Pferdepension. Alle Niveaus"
    ],
    "en": [
      "Horseback riding from 1h to 3h and from 1 day to 5 days (rides on the Plateau de Retord with overnight stay in gîtes).\r\nPony rides for children from 2 to 8 years old, horse boarding. All levels"
    ],
    "it": [
      "Equitazione da 1h a 3h e da 1 giorno a 5 giorni (passeggiate sul Plateau de Retord con pernottamento in gîtes).\r\nPasseggiate su pony per bambini da 2 a 8 anni, pensione per cavalli. Tutti i livelli"
    ],
    "fr": [
      "Balades à cheval de 1h à 3h et de 1 journée à 5 jours (randonnées sur le Plateau de retord avec nuit en gîtes).\r\nPromenade en poney pour les enfants de 2 à 8 ans, pension chevaux. Tous niveaux"
    ],
    "es": [
      "Paseos a caballo de 1h a 3h y de 1 día a 5 días (paseos por el Plateau de Retord con pernoctación en casas rurales).\r\nPaseos en poni para niños de 2 a 8 años, pupilaje de caballos. Todos los niveles"
    ],
    "nl": [
      "Paardrijden van 1 tot 3 uur en van 1 dag tot 5 dagen (ritten op het Plateau de Retord met overnachting in gîtes).\r\nPonyritten voor kinderen van 2 tot 8 jaar, paardenpension. Alle niveaus"
    ]
  },
