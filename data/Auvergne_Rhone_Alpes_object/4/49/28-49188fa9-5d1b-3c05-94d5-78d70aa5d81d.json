      "rdfs:comment": {
        "de": [
          "Verkauf ab Hof: Bohnen aus Soissons, Kichererbsen..\nAuch auf dem Markt in Marigny-en-Orxois vertreten (jeden letzten Sonntag im Monat).\nFür Bestellungen wenden Sie sich bitte an Nicole und Nicolas Cordier.\nPlus: Möglichkeit des Versands."
        ],
        "en": [
          "Sale at the farm : Soissons beans, chickpeas..\nAlso present on the market of Marigny-en-Orxois (every last Sunday of the month).\nFor any order, contact Nicole and Nicolas Cordier.\nThe + : Possibility of shipping."
        ],
        "it": [
          "Vendita in fattoria: fagioli di Soissons, ceci..\nPresente anche al mercato di Marigny-en-Orxois (ogni ultima domenica del mese).\nPer tutti gli ordini, contattare Nicole e Nicolas Cordier.\nIl plus : Possibilità di spedizione."
        ],
        "fr": [
          "Vente à la ferme : haricots de Soissons, pois chiches... \nPrésent également sur le marché de Marigny-en-Orxois (chaque dernier dimanche du mois).\nPour toute commande, contacter Nicole et Nicolas Cordier.\nLe + : Possibilité d’expédition."
        ],
        "nl": [
          "Verkoop op de boerderij: Soissons bonen, kikkererwten..\nOok aanwezig op de markt van Marigny-en-Orxois (elke laatste zondag van de maand).\nVoor alle bestellingen, neem contact op met Nicole en Nicolas Cordier.\nHet voordeel: mogelijkheid tot verzending."
        ],
        "es": [
          "Venta en la granja: judías de Soissons, garbanzos..\nTambién está presente en el mercado de Marigny-en-Orxois (cada último domingo del mes).\nPara todos los pedidos, póngase en contacto con Nicole y Nicolas Cordier.\nEl plus : Posibilidad de envío."
        ]
      },
