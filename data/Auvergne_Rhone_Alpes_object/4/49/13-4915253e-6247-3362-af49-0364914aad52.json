  "rdfs:comment": {
    "de": [
      "Bruno ist selbstständiger Skilehrer. Er unterrichtet auf Englisch und Französisch im Skigebiet von Les Contamines Montjoie.\r\nKinder oder Erwachsene aller Niveaus."
    ],
    "en": [
      "Bruno is an independent ski instructor. He teaches in English and French in the ski area of Les Contamines Montjoie.\r\nChildren or adults of all levels."
    ],
    "it": [
      "Bruno è un maestro di sci indipendente. Insegna in inglese e francese nel comprensorio sciistico di Les Contamines Montjoie.\r\nBambini o adulti di tutti i livelli."
    ],
    "fr": [
      "Bruno est moniteur de ski indépendant. Il enseigne en anglais et en francais sur le domaine skiable des Contamines Montjoie.\r\nEnfants ou adultes de tous les niveaux."
    ],
    "nl": [
      "Bruno is een onafhankelijke skileraar. Hij geeft les in het Engels en Frans in het skigebied Les Contamines Montjoie.\r\nKinderen of volwassenen van alle niveaus."
    ],
    "es": [
      "Bruno es un instructor de esquí independiente. Imparte clases en inglés y francés en la zona de esquí de Les Contamines Montjoie.\r\nNiños o adultos de todos los niveles."
    ]
  },
