  "rdfs:comment": {
    "de": [
      "Der Mont Aiguille, der 45 Minuten südlich von Grenoble liegt und 1492 erstmals von Antoine de Ville erobert wurde, bietet 50 Kletterrouten. Es wird dringend empfohlen, einen Bergführer mitzunehmen, der Sie begleitet."
    ],
    "en": [
      "Located 45 minutes south of Grenoble, Mont Aiguille, first conquered in 1492 by Antoine de Ville, offers 50 climbing routes. We strongly recommend taking a mountain guide with you."
    ],
    "it": [
      "Situato a 45 minuti a sud di Grenoble, il Mont Aiguille, conquistato per la prima volta nel 1492 da Antoine de Ville, offre 50 vie di arrampicata. Si consiglia vivamente di portare con sé una guida alpina."
    ],
    "fr": [
      "Situé à 45 minutes au sud de Grenoble, le Mont Aiguille, conquit pour la première fois en 1492 par Antoine de Ville, offre 50 voies d'escalades. Fortement recommandé de prendre un guide de haute montagne de vous accompagner."
    ],
    "es": [
      "Situado a 45 minutos al sur de Grenoble, el Mont Aiguille, conquistado por primera vez en 1492 por Antoine de Ville, ofrece 50 vías de escalada. Le recomendamos encarecidamente que se haga acompañar de un guía de montaña."
    ],
    "nl": [
      "Op 45 minuten ten zuiden van Grenoble biedt de Mont Aiguille, voor het eerst veroverd in 1492 door Antoine de Ville, 50 klimroutes. We raden je sterk aan om een berggids mee te nemen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mont-Aiguille climbing routes"
    ],
    "fr": [
      "Voies d'escalade du Mont-Aiguille"
    ]
  },
