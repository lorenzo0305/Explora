  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom See entfernt, im Viertel Albigny, bietet Ihnen das Restaurant l'Assiette Rouge eine traditionelle französische Küche, die hausgemacht ist und aus frischen und saisonalen Produkten besteht."
    ],
    "en": [
      "Just a stone's throw from the lake, in the Albigny district, the restaurant l'Assiette Rouge offers traditional homemade French cuisine, using fresh and seasonal products."
    ],
    "it": [
      "A pochi passi dal lago, nel quartiere di Albigny, il ristorante l'Assiette Rouge offre una cucina tradizionale francese fatta in casa, utilizzando prodotti freschi e di stagione."
    ],
    "fr": [
      "A deux pas du lac, dans le quartier d'Albigny, le restaurant l'Assiette Rouge vous propose une cuisine traditionnelle française faite maison, à base de produits frais et de saison."
    ],
    "nl": [
      "Op een steenworp afstand van het meer, in de wijk Albigny, biedt het restaurant l'Assiette Rouge traditionele Franse huisgemaakte gerechten met verse en seizoensgebonden producten."
    ],
    "es": [
      "A dos pasos del lago, en el barrio de Albigny, el restaurante l'Assiette Rouge ofrece cocina casera tradicional francesa, con productos frescos y de temporada."
    ]
  },
