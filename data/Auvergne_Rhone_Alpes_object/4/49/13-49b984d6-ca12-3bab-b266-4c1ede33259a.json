  "rdfs:comment": {
    "de": [
      "Das Bureau des guides du Vercors bietet Ihnen das ganze Jahr über Abenteuer in den Bergen. Bergsteigen, Klettern, Skitouren, Eisklettern, Klettersteige, Via Ferrata, Via Corda... Erleben Sie die Berge mit einem Bergführer."
    ],
    "en": [
      "The Bureau des Guides du Vercors offers mountain adventures all year round. Mountaineering, climbing, ski touring, ice climbing, via ferrata, via corda? experience the mountains with a mountain guide."
    ],
    "it": [
      "Il Bureau des Guides du Vercors propone avventure in montagna tutto l'anno. Alpinismo, arrampicata, sci alpinismo, arrampicata su ghiaccio, via ferrata, via corda: vivete la montagna con una guida alpina."
    ],
    "fr": [
      "Le Bureau des guides du Vercors vous propose tout au long de l’année des aventures en montagne. Alpinisme, escalade, ski de randonnée, cascade de glace, via ferrata, via corda… faites l’expérience de la montagne avec un guide de haute montagne."
    ],
    "nl": [
      "Het Bureau des Guides du Vercors biedt het hele jaar door avonturen in de bergen. Bergbeklimmen, klimmen, toerskiën, ijsklimmen, via ferrata, via corda? Ervaar de bergen met een berggids."
    ],
    "es": [
      "El Bureau des Guides du Vercors ofrece aventuras en la montaña durante todo el año. Alpinismo, escalada, esquí de travesía, escalada en hielo, vía ferrata, vía corda... viva la montaña con un guía de montaña."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau des Guides de Montagne du Vercors"
    ]
  },
