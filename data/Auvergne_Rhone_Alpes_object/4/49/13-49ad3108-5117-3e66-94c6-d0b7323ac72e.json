  "rdfs:comment": {
    "de": [
      "Jérôme und Élodie heißen Sie ab 9 Uhr im Bistrot le J'EM willkommen.\r\nDas Restaurant ist nur mittags geöffnet und bietet hausgemachte Gerichte und Desserts!\r\nTeestube, hausgemachte Desserts am Nachmittag!"
    ],
    "en": [
      "Jérôme and Élodie welcome you to the Bistrot le J'EM from 9am.\r\nThe restaurant is open only for lunch, with home-made cuisine and desserts!\r\nAfternoon tea and homemade desserts!"
    ],
    "it": [
      "Jérôme ed Élodie vi accolgono dalle 9 del mattino al Bistrot le J'EM.\r\nIl ristorante è aperto solo a pranzo, con cibo e dolci fatti in casa!\r\nTè pomeridiano e dolci fatti in casa!"
    ],
    "fr": [
      "Jérôme et Élodie vous accueillent à partir de 9h au Bistrot le J'EM.\r\nLe restaurant est ouvert uniquement le midi avec une cuisine et dessert faits maison !\r\nSalon de thé, desserts maison l'après-midi !"
    ],
    "es": [
      "Jérôme y Élodie le dan la bienvenida desde las 9 de la mañana al Bistrot le J'EM.\r\nEl restaurante sólo abre para el almuerzo, ¡con comida y postres caseros!\r\n¡Té de la tarde y postres caseros!"
    ],
    "nl": [
      "Jérôme en Élodie heten je vanaf 9 uur 's ochtends welkom in Bistrot le J'EM.\r\nHet restaurant is alleen open voor de lunch, met huisgemaakte gerechten en desserts!\r\nAfternoon tea en huisgemaakte desserts!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot Le J'EM"
    ]
  },
