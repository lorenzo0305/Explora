  "rdfs:comment": {
    "de": [
      "Die Gerichte dieses Restaurants sind von Qualität und werden mit viel Freude zubereitet. Hausgemacht und aus frischen Zutaten mittags, serviert in  außergewöhnlichem Dekor. Abends originelle und erlesene Gerichte im Speisesaal mit zeitgenössischem Dekor."
    ],
    "en": [
      "A cuisine where discovery rhymes with pleasure and quality : at lunchtime, enjoy home made cuisine using fresh products. In the evening, in the contemporary dining room, it's time for originality and refinement, not forgetting local specialities."
    ],
    "it": [
      "Il ristorante Cocon des Neiges: un must delle 3 Vallées. Lo chef e il suo team propongono una cucina casalinga a base di prodotti freschi."
    ],
    "fr": [
      "Le restaurant le Cocon des Neiges : l'incontournable halte gourmande des 3 Vallées. Le chef et son équipe proposent une cuisine faite maison, à base de produits frais."
    ],
    "nl": [
      "Het restaurant biedt een keuken waar ontdekking rijmt met plezier en kwaliteit. Tijdens de lunch, in een uitzonderlijk kader, gerechten van het huis bereid met versproducten. 's Avonds in de moderne zaal, plaats aan originele en geraffineerde gerechten."
    ],
    "es": [
      "El restaurante Cocon des Neiges: una visita obligada en los 3 Vallées. El chef y su equipo ofrecen una cocina casera basada en productos frescos."
    ]
  },
