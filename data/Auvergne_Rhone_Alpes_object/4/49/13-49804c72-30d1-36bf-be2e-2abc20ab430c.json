  "rdfs:comment": {
    "de": [
      "La Clairière des Elfes ist ein spielerischer Boardercross, der speziell für Anfänger und junge Skifahrer konzipiert wurde. Er befindet sich in unmittelbarer Nähe des Anfängerlifts Les Verdets und bietet die Möglichkeit, die Sensationen des Boardercross zu entdecken."
    ],
    "en": [
      "La Clairière des Elfes is a fun boardercross specially designed for beginners and young skiers. Located in the immediate vicinity of the Verdets beginner ski lift, this course lets you discover the sensations of boardercross."
    ],
    "it": [
      "La Clairière des Elfes è un divertente percorso di boardercross progettato appositamente per i principianti e i giovani sciatori. Situato proprio accanto all'impianto di risalita per principianti di Verdets, questo percorso è un ottimo modo per scoprire le emozioni del boardercross."
    ],
    "fr": [
      "La Clairière des Elfes est un boardercross ludique spécialement conçu pour les débutants et les jeunes skieurs. Situé à proximité immédiate du téléski débutant des Verdets, ce parcours permet de découvrir les sensations du boardercross."
    ],
    "nl": [
      "La Clairière des Elfes is een leuke boardercrossbaan die speciaal is ontworpen voor beginners en jonge skiërs. Deze baan ligt direct naast de beginnerslift van Verdets en is een geweldige manier om de sensatie van boardercross te ontdekken."
    ],
    "es": [
      "La Clairière des Elfes es una divertida pista de boardercross especialmente diseñada para principiantes y jóvenes esquiadores. Situada justo al lado del remonte para principiantes de Verdets, esta pista es una excelente manera de descubrir las emociones del boardercross."
    ]
  },
  "rdfs:label": {
