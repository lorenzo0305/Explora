  "rdfs:comment": {
    "de": [
      "Das Restaurant Chez Mathilde bietet Ihnen eine Schiefertafel mit frischen, natürlichen und biologischen Produkten, die sich im Rhythmus der Lieferungen und der Jahreszeiten verändert.\r\n\r\nDie Atmosphäre ist freundlich und warm."
    ],
    "en": [
      "The Chez Mathilde restaurant offers a menu of fresh, natural and organic produce that changes with the seasons.\n\nA warm, friendly atmosphere."
    ],
    "it": [
      "Il ristorante Chez Mathilde offre una scelta di prodotti freschi, naturali e biologici che cambiano con le stagioni.\r\n\r\nUn'atmosfera calda e accogliente."
    ],
    "fr": [
      "Le restaurant Chez Mathilde vous propose leurs ardoise évoluant au rythme des arrivages et des saisons, composée de produits frais, naturels et bio. \r\n\r\nAtmosphère conviviale et chaleureuse."
    ],
    "nl": [
      "Het restaurant Chez Mathilde biedt je een keuze aan verse, natuurlijke en biologische producten die met de seizoenen mee veranderen.\r\n\r\nEen warme en vriendelijke sfeer."
    ],
    "es": [
      "El restaurante Chez Mathilde le ofrece una selección de productos frescos, naturales y ecológicos que cambia con las estaciones.\r\n\r\nUn ambiente cálido y acogedor."
    ]
  },
