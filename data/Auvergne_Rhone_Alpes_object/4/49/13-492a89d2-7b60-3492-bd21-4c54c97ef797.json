  "rdfs:comment": {
    "de": [
      "Diese Kirche aus dem 12. Jahrhundert dominiert die Touristenroute durch das Aumance-Tal. Die Kirche Saint-Pierre ist ein Juwel der romanischen Kunst und verfügt über breite Strebepfeiler. Zu entdecken gibt es: Kapitelle, Wandmalereien, Modillons, Skulpturen..."
    ],
    "en": [
      "This 12th-century church dominates the Aumance Valley tourist route. Saint-Pierre church is a jewel of Romanesque art, with wide buttresses. Discover its capitals, murals, modillions and sculptures..."
    ],
    "it": [
      "Questa chiesa del XII secolo domina l'itinerario turistico della Valle dell'Aumance. La chiesa di Saint-Pierre è un gioiello dell'arte romanica, con grandi contrafforti. Tra gli elementi di spicco figurano capitelli, pitture murali, modiglioni e sculture."
    ],
    "fr": [
      "Cette église du XIIe siècle domine la route touristique de la Vallée de l'Aumance. L'église Saint-Pierre est un joyau de l'art roman, elle est pourvue de larges contreforts. A découvrir : chapiteaux, peintures murales, modillons, sculptures..."
    ],
    "es": [
      "Esta iglesia del siglo XII domina la ruta turística del Valle de Aumance. La iglesia de Saint-Pierre es una joya del arte románico, con grandes contrafuertes. Destacan los capiteles, las pinturas murales, los modillones y las esculturas."
    ],
    "nl": [
      "Deze kerk uit de 12e eeuw domineert de toeristische route van de Aumance-vallei. De Saint-Pierre kerk is een juweel van Romaanse kunst, met grote steunberen. Hoogtepunten zijn de kapitelen, muurschilderingen, modillions en beeldhouwwerken."
    ]
  },
  "rdfs:label": {
