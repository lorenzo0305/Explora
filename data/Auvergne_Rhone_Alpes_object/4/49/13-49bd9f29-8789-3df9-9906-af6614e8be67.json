  "rdfs:comment": {
    "de": [
      "Spiel- und Entspannungsplatz im friedlichen Dorf Aubenasson in der Nähe eines Parkplatzes mit 4 Plätzen. Fahrradabstellplatz 2 Plätze. Tisch für ein Picknick. Tischtennisplatte. Touristische Informationstafel."
    ],
    "en": [
      "Play and relaxation area in the peaceful village of Aubenasson near a 4-space parking lot. Bicycle parking for 2 bikes. Picnic table. Ping-pong table. Tourist information board."
    ],
    "it": [
      "Area giochi e relax nel tranquillo villaggio di Aubenasson, vicino a un parcheggio da 4 posti. 2 posti per biciclette. Tavolo da picnic. Tavolo da ping pong, bacheca di informazioni turistiche."
    ],
    "fr": [
      "Aire de jeux et de détente dans le paisible village d'Aubenasson à proximité d'un parking 4 places. Stationnement vélo 2 emplacements. Table de pique-nique. Table de ping pong. panneau d'information touristique."
    ],
    "es": [
      "Zona de juegos y descanso en el tranquilo pueblo de Aubenasson, cerca de un aparcamiento de 4 plazas. 2 plazas de aparcamiento para bicicletas. Mesa de picnic. Mesa de ping-pong. Tablón de información turística."
    ],
    "nl": [
      "Speel- en ontspanningsruimte in het rustige dorpje Aubenasson in de buurt van een parkeerplaats met 4 plaatsen. 2 fietsenstallingen. Picknicktafel. Tafeltennis. Toeristisch informatiebord."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux et de pique nique"
    ]
  },
