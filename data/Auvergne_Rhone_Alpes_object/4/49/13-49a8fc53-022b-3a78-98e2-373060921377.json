  "rdfs:comment": {
    "de": [
      "Die Gaec Chavenon bietet Ihnen eine gute Gelegenheit, den Betrieb und ihren Beruf kennenzulernen und einen geselligen Moment zu verbringen. Gute Stimmung garantiert!"
    ],
    "en": [
      "The Gaec Chavenon is offering you a great opportunity to come and discover their farm and their profession, and to share a convivial moment. The atmosphere is guaranteed!"
    ],
    "it": [
      "Il Gaec Chavenon vi offre una grande opportunità di venire a conoscere la loro fattoria e il loro lavoro e di condividere un momento di convivialità. Una grande atmosfera garantita!"
    ],
    "fr": [
      "La Gaec Chavenon vous offre une belle occasion de venir découvrir l'exploitation, leur métier et de partager un moment convivial. Ambiance assurée !"
    ],
    "es": [
      "El Gaec Chavenon le ofrece una gran oportunidad para venir a descubrir su granja y su trabajo, y compartir un momento de convivencia. ¡Un gran ambiente garantizado!"
    ],
    "nl": [
      "De Gaec Chavenon biedt je een geweldige kans om meer te weten te komen over hun boerderij en hun werk, en om een gezellig moment te delen. Een geweldige sfeer gegarandeerd!"
    ]
  },
  "rdfs:label": {
