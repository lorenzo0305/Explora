  "rdfs:comment": {
    "de": [
      "In Vassieux-en-Vercors baut die Ferme de la Tosela Weizen und Roggen in biologischem Anbau an. Die Ernte wird vor Ort dank einer Steinmühle zu Mehl und anschließend zu Sauerteigbrot verarbeitet. Ein authentisches und lokales Know-how, das es zu entdecken gilt."
    ],
    "en": [
      "In Vassieux-en-Vercors, the Tosela farm grows wheat and rye organically. The harvest is transformed on site into flour using a stone mill, and then into sourdough bread. Discover authentic, local know-how."
    ],
    "it": [
      "L'azienda agricola Tosela di Vassieux-en-Vercors coltiva grano e segale in modo biologico. Il raccolto viene trasformato in farina con un mulino a pietra e poi in pane a lievitazione naturale. Scoprite l'autentico know-how locale."
    ],
    "fr": [
      "À Vassieux-en-Vercors, la ferme de la Tosela cultive blé et seigle en agriculture biologique. La récolte est transformée sur place en farine grâce à un moulin à meule de pierre, puis en pain au levain. Un savoir-faire authentique et local à découvrir."
    ],
    "es": [
      "La granja Tosela, en Vassieux-en-Vercors, cultiva trigo y centeno de forma ecológica. La cosecha se transforma in situ en harina mediante un molino de piedra y, a continuación, en pan de masa madre. Descubra el auténtico saber hacer local."
    ],
    "nl": [
      "De Tosela boerderij in Vassieux-en-Vercors verbouwt tarwe en rogge op biologische wijze. De oogst wordt ter plekke verwerkt tot meel met behulp van een stenen molen en vervolgens tot zuurdesembrood. Ontdek authentieke, lokale knowhow."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Tosela"
    ]
  },
