  "rdfs:comment": {
    "de": [
      "Typisches Chalet im Herzen des Waldes auf dem Gebiet von Savoie Grand Revard. Im Winter mit Langlaufski oder Schneeschuhen, im Sommer zu Fuß oder mit dem Mountainbike erreichbar."
    ],
    "en": [
      "Small chalet in the heart of the forest. Accessible by cross country skiing and snowshoes in winter, and by foot or VTT in summer."
    ],
    "it": [
      "Chalet tipico nel cuore della foresta del comprensorio sciistico Savoia Grand Revard. Accessibile con sci nordico o racchette da neve in inverno, a piedi o in mountain bike in estate."
    ],
    "fr": [
      "Chalet typique au cœur de la forêt sur le domaine de Savoie Grand Revard. Accessible en ski nordique ou en raquettes en hiver, à pied ou en VTT en été."
    ],
    "nl": [
      "Typisch chalet in het hart van het bos in het skigebied Savoie Grand Revard. Bereikbaar per nordic ski of sneeuwschoenen in de winter, te voet of met de mountainbike in de zomer."
    ],
    "es": [
      "Chalet típico en el corazón del bosque del dominio esquiable de Savoie Grand Revard. Accesible en esquí nórdico o raquetas de nieve en invierno, a pie o en bicicleta de montaña en verano."
    ]
  },
  "rdfs:label": {
