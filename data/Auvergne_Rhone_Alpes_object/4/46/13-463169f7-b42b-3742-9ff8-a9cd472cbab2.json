  "rdfs:comment": {
    "de": [
      "Auf der Anhöhe über dem Dorf St Sauveur en Diois, am Kalvarienberg von 3 Croix, steht ein Orientierungstisch, von dem aus man einen herrlichen Blick auf das Tal der Drôme, den Turm von Crest und die umliegenden Berge hat."
    ],
    "en": [
      "On the hill overlooking the village of St Sauveur en Diois, at the Calvaire de 3 Croix, stands an orientation table offering a magnificent panoramic view of the Drôme valley, the Tour de Crest and the surrounding mountains."
    ],
    "it": [
      "Sulla collina che domina il villaggio di St Sauveur en Diois, al Calvaire de 3 Croix, si trova un tavolo di orientamento che offre una magnifica vista panoramica sulla valle della Drôme, sul Tour de Crest e sulle montagne circostanti"
    ],
    "fr": [
      "Sur la butte qui domine le village de St Sauveur en Diois, au  calvaire de 3 Croix, se dresse une table d'orientation qui offre un magnifique panorama sur la vallée de la Drôme, la Tour de Crest et les montagnes environnantes"
    ],
    "nl": [
      "Op de heuvel boven het dorp St Sauveur en Diois, bij de Calvaire de 3 Croix, staat een oriëntatietafel met een prachtig panoramisch uitzicht op de Drôme vallei, de Tour de Crest en de omliggende bergen."
    ],
    "es": [
      "En la colina que domina el pueblo de St Sauveur en Diois, en el Calvaire de 3 Croix, hay una mesa de orientación que ofrece una magnífica vista panorámica del valle de la Drôme, el Tour de Crest y las montañas circundantes"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'orientation des 3 Croix"
    ]
  },
