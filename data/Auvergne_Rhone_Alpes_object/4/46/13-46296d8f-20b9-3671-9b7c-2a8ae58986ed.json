  "rdfs:comment": {
    "de": [
      "Restaurant, Café, gemütlicher Teesalon, in dem man allein, mit Freunden oder der Familie eine Pause einlegen kann. Lokale und saisonale Produkte, hausgemachte Süßigkeiten, gemütliche Atmosphäre... Ideal, um sich zu treffen, zu plaudern und den Augenblick zu genießen, vom Frühstück bis zum Nachmittagstee."
    ],
    "en": [
      "Cosy restaurant, café and tea room, where you can take a break on your own, with friends or family. Local and seasonal products, homemade sweets, warm atmosphere... Ideal for getting together, chatting and savoring the moment, from breakfast to afternoon tea."
    ],
    "it": [
      "Un ristorante, una caffetteria e una sala da tè accoglienti dove potrete godervi una pausa da soli, con gli amici o con la famiglia. Prodotti locali di stagione, dolci fatti in casa, atmosfera accogliente... Ideale per stare insieme, chiacchierare e assaporare il momento, dalla colazione al tè pomeridiano."
    ],
    "fr": [
      "Restaurant, café, salon de thé cosy, où l’on vient faire une pause seul, entre amis ou en famille. Produits locaux et de saison, douceurs maison, ambiance chaleureuse... Idéal pour se retrouver, discuter et savourer l’instant, du petit-déjeuner au goûter."
    ],
    "nl": [
      "Een gezellig restaurant, café en tearoom waar je kunt genieten van een pauze in je eentje, met vrienden of familie. Lokale seizoensproducten, huisgemaakte lekkernijen, warme sfeer... Ideaal om samen te komen, te kletsen en van het moment te genieten, van ontbijt tot afternoon tea."
    ],
    "es": [
      "Acogedor restaurante, cafetería y salón de té donde podrá disfrutar de un descanso solo, con amigos o en familia. Productos locales de temporada, dulces caseros, ambiente cálido... Ideal para reunirse, charlar y saborear el momento, desde el desayuno hasta la merienda."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Récré ô délices"
    ]
  },
