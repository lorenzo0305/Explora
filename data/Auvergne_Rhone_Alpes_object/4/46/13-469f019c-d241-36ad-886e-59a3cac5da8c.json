  "rdfs:comment": {
    "de": [
      "Bar/Brasserie mit traditioneller Küche aus frischen Produkten in einem warmen und gemütlichen Rahmen (Risottos, Kalbskopf...). Die Speisekarte ist zu jeder Jahreszeit anders.\r\nAn manchen Freitagabenden wird musikalische Unterhaltung angeboten."
    ],
    "en": [
      "Bar / brasserie offering traditional cuisine based on fresh products in a warm and friendly atmosphere (risottos, veal head ..). The menu changes each season.\r\nMusical entertainment offered some Friday nights."
    ],
    "it": [
      "Bar/brasserie che propone una cucina tradizionale a base di prodotti freschi in un ambiente caldo e accogliente (risotti, testina di vitello...). Il menu è diverso ogni stagione.\r\nAlcuni venerdì sera viene offerto un intrattenimento musicale."
    ],
    "fr": [
      "Bar/brasserie proposant une cuisine traditionnelle à base de produits frais dans un cadre chaleureux et convivial (risottos, tête de veau..). La carte est différente à chaque saison.\r\nAnimations musicales proposées certains vendredis soirs."
    ],
    "es": [
      "Bar/brasserie que ofrece una cocina tradicional basada en productos frescos en un ambiente cálido y acogedor (risottos, cabeza de ternera...). El menú es diferente cada temporada.\r\nAlgunos viernes por la noche se ofrece entretenimiento musical."
    ],
    "nl": [
      "Bar/brasserie met een traditionele keuken op basis van verse producten in een warm en vriendelijk kader (risotto's, kalfskop...). Het menu is elk seizoen anders.\r\nOp bepaalde vrijdagavonden wordt muzikaal entertainment aangeboden."
    ]
  },
