  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geheimnisse von Thonon in Ihrem eigenen Tempo und zu jeder Tageszeit. Für jeden Geschmack ist etwas dabei: historischer Rundgang durch das Stadtzentrum, Rundgang entlang der Uferpromenade, spielerischer Rundgang mit einer Schnitzeljagd und Audiodeskriptionsparcours."
    ],
    "en": [
      "Discover the mysteries of Thonon at your own pace when it suits you. There is something for everyone : city center tour or stroll along the quays."
    ],
    "it": [
      "Scoprite i misteri di Thonon al vostro ritmo e in qualsiasi momento. Ce n'è per tutti i gusti: un tour storico del centro città, un tour lungo le banchine, un tour divertente con una caccia al tesoro e un percorso con audiodescrizione."
    ],
    "fr": [
      "Découvrez les mystères de Thonon à votre rythme et à toute heure. Il y en a pour tous les goûts : visite historique du centre-ville, visite le long des quais, visite ludique avec un jeu de piste et parcours audiodescription."
    ],
    "nl": [
      "Ontdek de mysteries van Thonon in je eigen tempo en op elk moment. Er is voor elk wat wils: een historische rondleiding door het stadscentrum, een rondleiding langs de kades, een ludieke rondleiding met een schattenjacht en een route met audiobeschrijving."
    ],
    "es": [
      "Descubra los misterios de Thonon a su ritmo y en cualquier momento. Hay para todos los gustos: una visita histórica por el centro de la ciudad, un recorrido por los muelles, una visita lúdica con búsqueda del tesoro y un recorrido audiodescrito."
    ]
  },
  "rdfs:label": {
    "de": [
      "Touren mit audioguide für jeden"
    ],
    "en": [
      "Audio-guided tours of Thonon-Les-Bains"
    ],
    "fr": [
      "Visites audioguidées de Thonon-Les-Bains"
    ]
  },
