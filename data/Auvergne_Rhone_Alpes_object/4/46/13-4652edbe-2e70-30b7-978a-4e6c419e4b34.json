  "rdfs:comment": {
    "de": [
      "Am Ufer des Flusses liegt das Boudio in einer außergewöhnlichen Umgebung. Auf dem Programm stehen: schattiger Garten, Liegestuhl, einfache und reichhaltige Mahlzeiten, Spezialitäten der Auvergne, Salate, Crêpes."
    ],
    "en": [
      "On the banks of the river, La Boudio is situated in an exceptional setting. On the menu: shady garden, deckchairs, simple but hearty meals, Auvergne specialities, salads and crêpes."
    ],
    "it": [
      "Sulle rive del fiume, il Boudio è situato in un contesto eccezionale. In programma: giardino ombreggiato, sdraio, pasto semplice e abbondante, specialità dell'Alvernia, insalate, frittelle."
    ],
    "fr": [
      "Au bord de la rivière, la Boudio est située dans un cadre exceptionnel. Au programme : jardin ombragé, transat, repas simple et copieux, spécialités auvergnates, salades, crêpes."
    ],
    "nl": [
      "Aan de oever van de rivier ligt de Boudio in een uitzonderlijke omgeving. Op het programma: schaduwrijke tuin, ligstoel, eenvoudige en overvloedige maaltijd, specialiteiten uit de Auvergne, salades, pannenkoeken."
    ],
    "es": [
      "A orillas del río, el Boudio está situado en un entorno excepcional. En el programa: jardín sombreado, tumbona, comida sencilla y copiosa, especialidades de Auvernia, ensaladas, tortitas."
    ]
  },
