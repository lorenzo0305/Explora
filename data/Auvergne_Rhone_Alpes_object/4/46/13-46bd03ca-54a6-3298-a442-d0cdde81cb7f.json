  "rdfs:comment": {
    "de": [
      "Das Hôtel-Bar-Restaurant Les Dômes de Miage ist ein Wahrzeichen von Saint-Gervais und bietet seit 1966 eine außergewöhnliche Gastfreundschaft. Dieses Lokal, in dem Tradition und Moderne aufeinandertreffen, bietet eine \"hausgemachte\" Küche und eine lebhafte Bar, die für alle geöffnet ist."
    ],
    "en": [
      "Come enjoy the pleasures of the table, the restaurant is open to non-residents. Depending on the season, indoors or outdoors, treat yourself and enjoy moments of relaxation and indulgence."
    ],
    "it": [
      "Venite a godere dei piaceri del tavolo, il ristorante è aperto alla clientela esterna. A seconda delle stagioni, all’interno o all’esterno, lasciatevi tentare e godetevi momenti di relax e golosità."
    ],
    "fr": [
      "Lieu emblématique de Saint-Gervais, Hôtel-Bar-Restaurant Les Dômes de Miage offre une hospitalité exceptionnelle depuis 1966. Cet établissement, où tradition et modernité se rencontrent, propose une cuisine « maison » et un bar animé ouvert à tous."
    ],
    "es": [
      "Les Dômes de Miage Hotel-Bar-Restaurant ofrece una hospitalidad excepcional en Saint-Gervais desde 1966. Este establecimiento, donde la tradición se une a la modernidad, ofrece cocina casera y un animado bar abierto a todos."
    ],
    "nl": [
      "Les Dômes de Miage Hotel-Bar-Restaurant biedt sinds 1966 uitzonderlijke gastvrijheid in Saint-Gervais. Dit etablissement, waar traditie en moderniteit elkaar ontmoeten, biedt een huiselijke keuken en een levendige bar die voor iedereen toegankelijk is."
    ]
  },
