  "rdfs:comment": {
    "de": [
      "Die Pétanque San Paloune organisiert am 5. Juli 2026 einen Pétanque-Wettbewerb. Er findet auf dem Bouleplatz neben dem Fußballstadion statt und beginnt um 13:30 Uhr."
    ],
    "en": [
      "Petanque San Paloune is organizing a pétanque competition on July 5, 2026. It will take place at the petanque field next to the soccer stadium, starting at 1:30pm."
    ],
    "it": [
      "Il club di bocce di San Paloune organizza una gara di bocce il 5 luglio 2026. Si svolgerà presso il campo da petanque accanto allo stadio di calcio, a partire dalle 13.30."
    ],
    "fr": [
      "La pétanque San Paloune organise un concours de pétanque le 5 juillet 2026. Il aura lieu au terrain de pétanque à côté du stade de foot, à partir de 13h30."
    ],
    "es": [
      "El club de petanca San Paloune organiza una competición de petanca el 5 de julio de 2026. Tendrá lugar en el campo de petanca situado junto al estadio de fútbol, a partir de las 13.30 horas."
    ],
    "nl": [
      "De petanqueclub San Paloune organiseert een petanquewedstrijd op 5 juli 2026. Deze vindt plaats op het petanqueterrein naast het voetbalstadion en begint om 13.30 uur."
    ]
  },
