  "rdfs:comment": {
    "de": [
      "Der Verein Parenthèse betreibt eine Eingliederungsbaustelle (ACI) für biologischen Gemüseanbau und trägt heute drei Cocagne-Gärten in der Nähe von Valence und Romans."
    ],
    "en": [
      "The Parenthèse association, which operates an organic market garden as part of a work-integration program (ACI), currently runs three Cocagne gardens near Valence and Romans."
    ],
    "it": [
      "Parenthèse è un'associazione di orticoltura biologica che gestisce tre giardini di Cocagne vicino a Valence e a Romans."
    ],
    "fr": [
      "Exploitation en chantier d'insertion (ACI) en maraichage biologique, l'association Parenthèse porte aujourd'hui trois jardins de Cocagne à proximité de Valence et de Romans."
    ],
    "nl": [
      "Parenthèse is een biologische tuinderij die drie Cocagne tuinen beheert in de buurt van Valence en Rome."
    ],
    "es": [
      "Parenthèse es una asociación de horticultura ecológica que gestiona tres huertos de Cocagne cerca de Valence y Romans."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Parenthèse - Graine de Cocagne"
    ]
  },
