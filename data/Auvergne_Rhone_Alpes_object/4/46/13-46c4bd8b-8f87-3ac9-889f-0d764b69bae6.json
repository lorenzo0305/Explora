  "rdfs:comment": {
    "de": [
      "Außerhalb der Schulferien bietet die Ludothek Spieleabende an, die jeweils am 4. Donnerstag des Monats stattfinden. Kommen Sie zahlreich."
    ],
    "en": [
      "Beyond the school vacations, the Ludothèque offers Game Evenings on the 4? Thursday of each month. Come one, come all."
    ],
    "it": [
      "Oltre alle vacanze scolastiche, la Ludoteca organizza serate di gioco il quarto giovedì di ogni mese. Ci auguriamo di vedervi lì."
    ],
    "fr": [
      "Au-delà des vacances scolaires, la Ludothèque propose des Soirées jeux, organisées le 4ᵉ jeudi de chaque mois. Venez nombreux."
    ],
    "nl": [
      "Naast de schoolvakanties organiseert de Ludotheek elke 4de donderdag van de maand spelletjesavonden. We kijken ernaar uit je daar te zien."
    ],
    "es": [
      "Además de las vacaciones escolares, la Ludoteca organiza tardes de juegos el cuarto y cuarto jueves de cada mes. Esperamos contar con su presencia."
    ]
  },
  "rdfs:label": {
