  "rdfs:comment": {
    "de": [
      "Im Winter und nur zum Abendessen lädt Sie das L'Alpage dazu ein, die Spezialitäten Savoyens in einer gemütlichen Atmosphäre am Kaminfeuer zu entdecken."
    ],
    "en": [
      "During Winter time and only for dinner, l'Alpage restaurant is greeting you to discover the Alps specialities in a warm atmosphere by the fire place"
    ],
    "it": [
      "In inverno e solo per la cena, L'Alpage vi invita a scoprire le specialità della Savoia in un ambiente accogliento riscaldato dal fuoco del camino."
    ],
    "fr": [
      "En hiver et pour le dîner uniquement, l’Alpage vous invite à découvrir les spécialités de Savoie dans une ambiance chaleureuse près du feu de cheminée."
    ],
    "nl": [
      "In de winter en alleen voor het diner nodigt L'Alpage je uit om de specialiteiten uit de Savoie te ontdekken in een gezellige sfeer bij de open haard."
    ],
    "es": [
      "En invierno y sólo para cenar, L'Alpage le invita a descubrir las especialidades de Saboya en un ambiente acogedor junto a la chimenea."
    ]
  },
