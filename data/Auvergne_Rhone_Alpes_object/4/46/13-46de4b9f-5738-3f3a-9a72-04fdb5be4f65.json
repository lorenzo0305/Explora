  "rdfs:comment": {
    "de": [
      "Entdeckungsverkostung von Weinen und lokalen Produkten. Mit einer Spezialistin der Weinuniversität von Suze-la-Rousse diplomiert.  Es werden verschiedene Workshops vorgeschlagen. Animationen zu Hause oder in der Grotte von St Marcel."
    ],
    "en": [
      "Wine and local products tasting sessions with a specialist graduate of the Suze la Rousse wine college. Choose from a range of workshops. Tastings can also be organised in a pretty little garden in Bourg-Saint-Andéol or at your home."
    ],
    "it": [
      "Degustazione di vini e prodotti locali. Con uno specialista qualificato dell'università del vino di Suze la Rousse. Vari laboratori offerti. Attività in un piccolo giardino a Bourg-Saint-Andéol o in case private."
    ],
    "fr": [
      "Dégustation découverte de vins et de produits du terroir. Avec une spécialiste diplômée de l'université du vin de Suze la Rousse. Différents ateliers proposés. Animations dans un joli petit jardin à Bourg-Saint-Andéol ou chez des particuliers."
    ],
    "nl": [
      "Proeverij van wijn en lokale producten. Met een gekwalificeerde specialist van de wijnuniversiteit van Suze la Rousse. Verschillende workshops. Activiteiten in een mooie kleine tuin in Bourg-Saint-Andéol of bij particulieren thuis."
    ],
    "es": [
      "Degustación de vinos y productos locales. Con un especialista cualificado de la universidad del vino de Suze la Rousse. Se ofrecen varios talleres. Actividades en un bonito jardín de Bourg-Saint-Andéol o en casas particulares."
    ]
  },
