  "rdfs:comment": {
    "de": [
      "Unser Engagement : Pizzas zum Mitnehmen, aus frischen und lokalen Produkten, hausgemacht, im Holzofen gebacken,.\r\nDas Geheimnis einer guten Pizza liegt in ihren Zutaten! Wir verwenden nur frische und regionale Produkte!"
    ],
    "en": [
      "Our commitment: Takeaway pizzas, made with fresh, local produce, homemade, cooked over a wood fire.\r\nThe secret of a good pizza lies in its ingredients! We are committed to using a maximum of fresh, local produce!"
    ],
    "it": [
      "Il nostro impegno: Pizze da asporto realizzate con prodotti freschi e locali, fatte in casa e cotte a legna.\r\nIl segreto di una buona pizza sta negli ingredienti! Noi ci impegniamo a utilizzare il maggior numero possibile di prodotti freschi e locali!"
    ],
    "fr": [
      "Notre engagement : Des pizzas à emporter, à base de produits frais et locaux, faites maison, cuites au feu de bois,. \r\nLe secret d’une bonne pizza réside dans ses ingrédients ! Nous nous engageons à utiliser un maximum de produits frais et régionaux!"
    ],
    "nl": [
      "Onze belofte: Afhaalpizza's gemaakt met verse, lokale producten, zelfgemaakt en gebakken boven een houtvuur.\r\nHet geheim van een goede pizza zit hem in de ingrediënten! We doen er alles aan om zoveel mogelijk verse, lokale producten te gebruiken!"
    ],
    "es": [
      "Nuestro compromiso: Pizzas para llevar elaboradas con productos frescos y locales, hechas en casa y cocinadas al fuego de leña.\r\nEl secreto de una buena pizza está en sus ingredientes Nos comprometemos a utilizar el mayor número posible de productos frescos y locales"
    ]
  },
