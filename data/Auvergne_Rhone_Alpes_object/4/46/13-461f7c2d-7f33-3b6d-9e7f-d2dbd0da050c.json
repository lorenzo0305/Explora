  "rdfs:comment": {
    "de": [
      "Netzwerk von Erzeugern und Verarbeitern, die ihre biologischen und lokalen Produkte online anbieten.  \nDer Kunde wählt seine Produkte online unter den 16 Erzeugern aus und holt seine Bestellung am Dienstagabend zwischen 17.30 und 19 Uhr auf dem Vernas-Bauernhof in Chomérac ab."
    ],
    "en": [
      "Network of producers and processors offering their organic and local products online.  \nCustomers choose their products online from among 16 producers, and pick up their order on Tuesday evenings between 5:30 and 7pm at the Vernas farm in Chomérac."
    ],
    "it": [
      "Una rete di produttori e trasformatori che offrono online i loro prodotti biologici e locali.  \nI clienti scelgono i prodotti online tra 16 produttori e ritirano l'ordine il martedì sera tra le 17.30 e le 19.00 presso la fattoria Vernas di Chomérac."
    ],
    "fr": [
      "Réseau de producteurs et transformateurs proposant leurs produits bio et locaux en ligne.  \nLe client choisit ses produits en ligne parmi les 16 producteurs et vient chercher sa commande le mardi soir entre 17h30 à 19h à la ferme du Vernas à Chomérac."
    ],
    "es": [
      "Una red de productores y transformadores que ofrecen en línea sus productos ecológicos y locales.  \nLos clientes eligen sus productos en línea entre 16 productores y recogen su pedido los martes por la tarde, entre las 17.30 y las 19.00 horas, en la granja Vernas de Chomérac."
    ],
    "nl": [
      "Een netwerk van producenten en verwerkers die hun biologische en lokale producten online aanbieden.  \nKlanten kiezen hun producten online uit 16 producenten en halen hun bestelling op dinsdagavond tussen 17.30 en 19.00 uur op bij de boerderij van Vernas in Chomérac."
    ]
  },
  "rdfs:label": {
