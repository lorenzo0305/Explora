  "rdfs:comment": {
    "de": [
      "Sie suchen einen ungewöhnlichen Ort, um eine Konferenz, eine Versammlung oder ein Firmenseminar zu veranstalten?\r\nWie wäre es, wenn Sie das Manoir des livres und seine Einrichtungen kennenlernen!"
    ],
    "en": [
      "Are you looking for an unusual venue for a conference, meeting or corporate seminar?\r\nWhy not come and discover the Manoir des Livres and its facilities!"
    ],
    "it": [
      "Siete alla ricerca di un luogo insolito per organizzare una conferenza, una riunione o un seminario aziendale?\r\nVenite a scoprire il Manoir des Livres e le sue strutture!"
    ],
    "fr": [
      "Vous recherchez un lieu insolite pour organiser une conférence, une réunion, un séminaire d'entreprise ? \r\nEt si vous veniez découvrir le Manoir des livres et ses équipements !"
    ],
    "es": [
      "¿Busca un lugar insólito para organizar una conferencia, una reunión o un seminario de empresa?\r\nDescubra el Manoir des Livres y sus instalaciones"
    ],
    "nl": [
      "Bent u op zoek naar een bijzondere locatie om een conferentie, vergadering of bedrijfsseminar te organiseren?\r\nOntdek dan Manoir des Livres en zijn faciliteiten!"
    ]
  },
