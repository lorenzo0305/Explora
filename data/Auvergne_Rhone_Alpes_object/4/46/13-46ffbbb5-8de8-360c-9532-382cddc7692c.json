  "rdfs:comment": {
    "de": [
      "Bei Monts Restaurants finden Sie eine einfache und schmackhafte Erzeuger- und Regionalküche mit Produkten aus den Monts du Lyonnais. Alle Gerichte und Speisen werden vor Ort hausgemacht oder von unseren lokalen Produzenten zubereitet."
    ],
    "en": [
      "At Monts Restaurants, you'll find simple, tasty local cuisine made with products from the Monts du Lyonnais region. All dishes are prepared in-house or by our local producers."
    ],
    "it": [
      "Nei Ristoranti Monts troverete una cucina locale semplice e gustosa, realizzata con i prodotti dei Monts du Lyonnais. Tutti i piatti sono preparati in casa o dai nostri produttori locali."
    ],
    "fr": [
      "Chez Monts Restaurants, vous retrouverez une cuisine de producteurs et de terroir, simple et savoureuse, avec des produits issus des Monts du Lyonnais. Tous les plats et mets sont préparés maison sur place ou fait par nos producteurs locaux."
    ],
    "es": [
      "En los Restaurantes Monts, encontrará una cocina local sencilla y sabrosa elaborada con productos de los Monts du Lyonnais. Todos los platos son de elaboración propia o de nuestros productores locales."
    ],
    "nl": [
      "Bij Monts Restaurants vind je eenvoudige, smakelijke lokale gerechten bereid met producten uit de Monts du Lyonnais. Alle gerechten worden intern of door onze lokale producenten bereid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Monts Restaurant"
    ]
  },
