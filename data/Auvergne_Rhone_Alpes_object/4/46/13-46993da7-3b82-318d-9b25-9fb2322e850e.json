  "rdfs:comment": {
    "de": [
      "Leicht zugängliche Verbindung für den Aufstieg mit Tourenski, für den Zugang zur Route abseits der Piste bis zum Croix für erfahrene Skifahrer von etwa 1 km und 400 m Höhenunterschied.\r\nZugang: Casserousse (1400 m)."
    ],
    "en": [
      "Ski touring departure up to la Croix, link at the edge of the ski area for access to the off-piste track, for confirmed skiers. About 1km and 400 metres of ascent.\r\nAccess: Casserousse (1400 m)."
    ],
    "it": [
      "Collegamento di facile accesso per lo sci alpinismo, per accedere all'itinerario fuori pista fino alla Croix per sciatori esperti di circa 1 km e 400 metri di dislivello.\r\nAccesso : Casserousse (1400 m)."
    ],
    "fr": [
      "Liaison d'accès facile de montée en ski de randonnée, pour accès à l'itinéraire en hors-piste jusqu’à la Croix pour les pratiquants confirmés d'environ 1km et de 400 mètres de dénivelé.\r\nAccès : Casserousse (1400 m)."
    ],
    "nl": [
      "Gemakkelijke toegangsverbinding voor skitochten, voor toegang tot de off-piste route tot aan de Croix voor ervaren skiërs van ongeveer 1 km en 400 meter hoogteverschil.\r\nToegang : Casserousse (1400 m)."
    ],
    "es": [
      "Enlace de fácil acceso para el esquí de travesía, para acceder al itinerario fuera de pista hasta la Croix para esquiadores experimentados de aproximadamente 1km y 400 metros de desnivel.\r\nAcceso : Casserousse (1400 m)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Aufstiegsroute für Skitouren: Casserousse - ungesicherter Zugang abseits der Piste"
    ],
    "en": [
      "Ski touring track : Casserousse - Off-piste access not secured"
    ],
    "fr": [
      "Parcours de montée en ski de randonnée : Casserousse - accès hors-piste non sécurisé"
    ]
  },
