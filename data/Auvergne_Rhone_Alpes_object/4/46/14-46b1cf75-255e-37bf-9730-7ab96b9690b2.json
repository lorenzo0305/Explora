  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ac9cd7b8-9b52-36ec-ae1f-6e9ebc3d3510",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\nMontag bis Freitag von 8:30 bis 12:30 Uhr und von 13:30 bis 19:30 Uhr\n\nSamstags von 8:30 bis 13:00 Uhr und von 13:30 bis 17:00 Uhr\n\nSonntag geschlossen\n\nAbholung:\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Friday, 8:30am to 12:30pm and 1:30pm to 7:30pm\n\nSaturday 8:30am to 1:00pm and 1:30pm to 5:00pm\n\nClosed on Sunday\n\nPick-up :\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrari di apertura :\nDal lunedì al venerdì, dalle 8.30 alle 12.30 e dalle 13.30 alle 19.30\n\nSabato dalle 8.30 alle 13.00 e dalle 13.30 alle 17.00\n\nChiuso la domenica\n\nRitiro:\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu lundi au vendredi de 8h30 à 12h30 et de 13h30 à 19h30\n\nLe samedi de 8h30 à 13h00 et de 13h30 à 17h00\n\nFermeture le dimanche\n\nRetrait :\nAux horaires d'ouverture de l'officine\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningstijden :\nMaandag tot vrijdag van 8.30 tot 12.30 uur en van 13.30 tot 19.30 uur\n\nZaterdag van 8.30 tot 13.00 uur en van 13.30 tot 17.00 uur\n\nGesloten op zondag\n\nAfhalen:\nTijdens openingstijden van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nHorarios de apertura :\nDe lunes a viernes, de 8.30 a 12.30 h. y de 13.30 a 19.30 h\n\nSábado de 8h30 a 13h00 y de 13h30 a 17h00\n\nDomingos cerrado\n\nRecogida:\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
