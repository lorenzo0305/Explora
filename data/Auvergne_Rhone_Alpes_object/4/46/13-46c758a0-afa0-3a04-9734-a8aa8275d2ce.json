  "rdfs:comment": {
    "de": [
      "Im Rahmen des Vichy-Vitalitätsprogramms bietet Savate Boxe Vichy kostenlose Schnupperkurse an: Selbstverteidigungsworkshops.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Savate Boxe Vichy offers free discovery sessions: Self-Defense Workshops.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, la Savate Boxe Vichy offre sessioni introduttive gratuite: workshop di autodifesa.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Savate Boxe Vichy propose des séances gratuites de découverte :  Ateliers de Self-Défense.\r\nRenseignements et inscription par téléphone."
    ],
    "es": [
      "En el marco del programa Vichy Vitalidad, Savate Boxe Vichy propone sesiones gratuitas de iniciación: Talleres de defensa personal.\r\nInformación e inscripciones por teléfono."
    ],
    "nl": [
      "Als onderdeel van het vitaliteitsprogramma van Vichy biedt Savate Boxe Vichy gratis kennismakingssessies aan: workshops zelfverdediging.\r\nInformatie en inschrijving per telefoon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ateliers de Self-Défense - Savate Boxe - Vichy Vitalité"
    ]
  },
