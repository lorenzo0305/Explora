  "rdfs:comment": {
    "de": [
      "Kreationen aus eigener Herstellung. Eine Einführung in die emaillierte Lava wird nach Vereinbarung angeboten. Ich bin seit 18 Jahren Emailleurin und entwerfe und fertige dekorative und funktionelle Gegenstände aus emaillierter Lava."
    ],
    "en": [
      "Handcrafted creations. An introduction to enamelled lava is available by appointment. An enameller for 18 years, I create and produce decorative and functional objects in enamelled lava."
    ],
    "it": [
      "Creazioni artigianali. Su appuntamento è possibile assistere a un'introduzione alla lava smaltata. Smaltatrice da 18 anni, creo e produco oggetti decorativi e funzionali in lava smaltata."
    ],
    "fr": [
      "Créations artisanales. Une initiation à la lave émaillée est proposée sur rendez-vous. Emailleuse depuis 18 ans, je crée et réalise des objets décoratifs et fonctionnels en lave émaillée."
    ],
    "nl": [
      "Handgemaakte creaties. Een inleiding tot geëmailleerde lava is beschikbaar op afspraak. Ik ben al 18 jaar emailleur en creëer en produceer decoratieve en functionele objecten in geëmailleerde lava."
    ],
    "es": [
      "Creaciones artesanales. Una introducción a la lava esmaltada disponible con cita previa. Esmaltadora desde hace 18 años, creo y produzco objetos decorativos y funcionales en lava esmaltada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier expo-vente de lave émaillée"
    ]
  },
