  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Welt der Töpfer von Portout, die sich in der ersten Hälfte des 5. Jahrhunderts n. Chr. am Ufer des Canal de Savière niederließen. Eintritt frei."
    ],
    "en": [
      "Come and discover the world of the Portout potters who settled on the banks of the Savière Canal in the first half of the 5th century AD. Free admission."
    ],
    "it": [
      "Venite a scoprire il mondo dei vasai di Portout che si stabilirono sulle rive del canale della Savière nella prima metà del V secolo d.C. Ingresso libero."
    ],
    "fr": [
      "Venez découvrir l’univers des potiers de Portout installés au bord du Canal de Savière dans la première moitié du Ve siècle après Jésus-Christ. Entrée gratuite."
    ],
    "es": [
      "Venga a descubrir el mundo de los alfareros de Portout que se instalaron a orillas del canal de la Savière en la primera mitad del siglo V d.C. Entrada gratuita."
    ],
    "nl": [
      "Ontdek de wereld van de pottenbakkers van Portout die zich in de eerste helft van de 5e eeuw na Christus aan de oevers van het kanaal van Savière vestigden. Gratis toegang."
    ]
  },
  "rdfs:label": {
