  "rdfs:comment": {
    "de": [
      "Mit Haute Maurienne Ski Montagne Aventure können Sie mit Ihrer Familie, in der Gruppe, mit Freunden oder allein mit Ihrem Bergführer einzigartige Momente erleben und in die prachtvollen Landschaften eintauchen."
    ],
    "en": [
      "With Haute Maurienne Ski Montagne Aventure, as a family, in a group, with friends, alone with your guide, share unique moments, an immersion in the heart of sumptuous landscapes."
    ],
    "it": [
      "Con Haute Maurienne Ski Montagne Aventure, in famiglia, in gruppo, con gli amici, da soli con la vostra guida, condividete momenti unici, un'immersione nel cuore di paesaggi sontuosi."
    ],
    "fr": [
      "Avec Haute Maurienne Ski Montagne Aventure, en famille, en groupe, entre amis, seul avec votre guide, partagez des moments uniques, une immersion au cœur de paysages somptueux."
    ],
    "nl": [
      "Met Haute Maurienne Ski Montagne Aventure, met het gezin, in een groep, met vrienden, alleen met je gids, deel je unieke momenten, een onderdompeling in het hart van weelderige landschappen."
    ],
    "es": [
      "Con Haute Maurienne Ski Montagne Aventure, en familia, en grupo, con amigos, a solas con su guía, comparta momentos únicos, una inmersión en el corazón de paisajes suntuosos."
    ]
  },
