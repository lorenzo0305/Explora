  "rdfs:comment": {
    "de": [
      "Vereins- und Kulturbar, mittwochs von 8 bis 17 Uhr und samstags von 9 bis 14 Uhr und von 18 bis 22 Uhr geöffnet, mit Speisen und Getränken auf Vorbestellung.\r\nSonntags von 10 bis 14 Uhr.\r\nZwei Themenabende pro Monat."
    ],
    "en": [
      "Associative and cultural bar open Wednesdays 8am to 5pm, Saturdays 9am to 2pm and 6pm to 10pm, with food and drink available on reservation.\r\nSundays from 10am to 2pm.\r\nTwo themed evenings a month."
    ],
    "it": [
      "Bar associativo e culturale aperto il mercoledì dalle 8 alle 17 e il sabato dalle 9 alle 14 e poi dalle 18 alle 22, con cibo e bevande su prenotazione.\r\nDomenica dalle 10.00 alle 14.00.\r\nDue serate a tema al mese."
    ],
    "fr": [
      "Bar associatif et culturel ouvert les mercredis de 8h à 17h et les samedis de 9h à 14h puis de 18h à 22h avec restauration sur réservation. \r\nLe dimanche de 10h à 14h.\r\nDeux soirées à thèmes par mois."
    ],
    "es": [
      "Bar asociativo y cultural abierto los miércoles de 8.00 a 17.00 y los sábados de 9.00 a 14.00 y después de 18.00 a 22.00, con comida y bebida previa reserva.\r\nDomingos de 10.00 a 14.00 h.\r\nDos veladas temáticas al mes."
    ],
    "nl": [
      "Associatieve en culturele bar geopend op woensdag van 8.00 tot 17.00 uur en op zaterdag van 9.00 tot 14.00 uur en daarna van 18.00 tot 22.00 uur, met eten en drinken op reservering.\r\nOp zondag van 10.00 tot 14.00 uur.\r\nTwee thema-avonden per maand."
    ]
  },
  "rdfs:label": {
