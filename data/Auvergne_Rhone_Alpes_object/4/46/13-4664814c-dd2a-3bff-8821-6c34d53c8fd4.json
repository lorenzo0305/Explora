  "rdfs:comment": {
    "de": [
      "Zaino ristorante bietet Ihnen die Aromen der italienischen Gastronomie in einem eleganten und zugleich gemütlichen Rahmen. Probieren Sie unsere originellen Rezepte wie die Pinsa, eine authentische Pizza mit knusprigem und schmackhaftem Teig."
    ],
    "en": [
      "Zaino ristorante offers you the flavours of Italian gastronomy in an elegant and friendly setting. Come and try our original recipes such as the Pinsa, an authentic pizza with crispy and tasty dough."
    ],
    "it": [
      "Zaino ristorante vi offre i sapori della gastronomia italiana in un ambiente elegante e accogliente. Venite a provare le nostre ricette originali come la Pinsa, un'autentica pizza dall'impasto croccante e gustoso."
    ],
    "fr": [
      "Zaino ristorante vous propose les saveurs de la gastronomie italienne dans un cadre à la fois élégant et convivial. Venez tester nos recettes originales comme la Pinsa, une pizza authentique à la pâte croustillante et savoureuse."
    ],
    "es": [
      "Zaino ristorante le ofrece los sabores de la gastronomía italiana en un entorno elegante y acogedor. Venga a probar nuestras originales recetas, como la Pinsa, una auténtica pizza de masa crujiente y sabrosa."
    ],
    "nl": [
      "Zaino ristorante biedt u de smaken van de Italiaanse gastronomie in een elegant en vriendelijk kader. Kom en probeer onze originele recepten zoals de Pinsa, een authentieke pizza met knapperig en smakelijk deeg."
    ]
  },
