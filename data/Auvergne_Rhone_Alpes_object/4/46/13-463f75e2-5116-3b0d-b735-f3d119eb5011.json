  "rdfs:comment": {
    "de": [
      "Der Espace Renée VINAY ist ein Ausstellungsraum, der der Kunst und der Förderung lokaler Künstler gewidmet ist. Dieser Raum bietet von Juni bis September Ausstellungen aller Art: Gemälde, Skulpturen, Töpferwaren, Zeichnungen, Fotografien..."
    ],
    "en": [
      "The Renée VINAY space is an exhibition space dedicated to art and the promotion of local artists. During the year, this space offers exhibitions of all kinds: paintings, sculptures, pottery, drawings, photographs..."
    ],
    "it": [
      "L'Espace Renée VINAY è uno spazio espositivo dedicato all'arte e alla promozione degli artisti locali. Da giugno a settembre, lo spazio offre mostre di ogni genere: dipinti, sculture, ceramiche, disegni, fotografie, ecc."
    ],
    "fr": [
      "L'espace Renée VINAY est un espace d'exposition dédié à l'art et à la promotion d'artistes locaux. Cet espace propose de juin à septembre des expositions de toutes sortes : peintures, sculptures, poteries, dessins, photographies..."
    ],
    "nl": [
      "Espace Renée VINAY is een expositieruimte gewijd aan kunst en de promotie van lokale kunstenaars. Van juni tot september biedt de ruimte tentoonstellingen van allerlei aard: schilderijen, beeldhouwwerken, aardewerk, tekeningen, foto's, enz."
    ],
    "es": [
      "Espace Renée VINAY es un espacio de exposiciones dedicado al arte y a la promoción de artistas locales. De junio a septiembre, el espacio ofrece exposiciones de todo tipo: pinturas, esculturas, cerámica, dibujos, fotografías, etc."
    ]
  },
  "rdfs:label": {
