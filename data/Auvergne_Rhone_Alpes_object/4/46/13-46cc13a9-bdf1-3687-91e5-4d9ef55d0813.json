  "rdfs:comment": {
    "de": [
      "\"Sophrologie, helfende Beziehung und Techniken zur Optimierung des Potenzials: Kinder, Jugendliche, Erwachsene. Einzeln, in Gruppen, in der Praxis, zu Hause, per Videokonferenz. Sophro-Balade: geplant und auf Anfrage. Shiatsu-Massage in der Praxis und zu Hause"
    ],
    "en": [
      "\"Become an actor of your well-being\".Sophrology-Helping relationship and techniques for optimizing potential: children, teenagers, adults. In individual, group, office, home, video. Sophro-ride: planned and on request. Shiatsu massage practice-home"
    ],
    "it": [
      "\"Sofrologia - Tecniche di ottimizzazione della relazione d'aiuto e del potenziale: bambini, adolescenti, adulti\". In forma individuale, di gruppo, in ufficio, a casa, in video. Passeggiate a piedi: programmate e su richiesta. Massaggio shiatsu in ufficio o a casa"
    ],
    "fr": [
      "« Devenez acteur de votre bien-être ».Sophrologie-Relation d’aide et techniques d’optimisation du potentiel:enfants, ados, adultes. En individuel, groupe, cabinet, domicile, visio. Sophro-balade : planifiée et sur demande. Massage Shiatsu cabinet-domicile"
    ],
    "nl": [
      "\"Sophrologie en technieken voor het optimaliseren van potentieel: kinderen, tieners, volwassenen. Individueel, groep, praktijk, thuis, video. Sophro-balade: gepland en op aanvraag. Shiatsu massage in je praktijk of thuis"
    ],
    "es": [
      "\"Sofrología - Relación de ayuda y técnicas de optimización del potencial: niños, adolescentes, adultos. En individual, en grupo, en la oficina, en casa, en vídeo. Sofropaseo: previsto y a petición. Masaje Shiatsu en la oficina o en casa"
    ]
  },
  "rdfs:label": {
    "fr": [
