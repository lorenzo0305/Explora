  "rdfs:comment": {
    "de": [
      "Steilkurven, Woops, Mini-Slalom, Tunnel, Mini-Canyon, Glocken, Xylophon... Dank der spielerischen Pisten lernen Ihre Kinder mit Spaß!"
    ],
    "en": [
      "Raised turns, woops, mini-slalom, tunnel, mini-canyon, bells, xylophone… Thanks to the playful pistes, your children learn while having fun!"
    ],
    "it": [
      "Curve a gomito, woops, mini-slalom, tunnel, mini-canyon, campane, xilofono? Grazie alle tracce ludiche, i bambini impareranno divertendosi!"
    ],
    "fr": [
      "Virages relevés, woops, mini-slalom, tunnel, mini-canyon, cloches, xylophone… Grâce aux pistes ludiques, vos enfants apprennent en s'amusant !"
    ],
    "nl": [
      "Upswept turns, woops, mini-slalom, tunnel, mini-canyon, belletjes, xylofoon... Dankzij de speelse banen leren uw kinderen terwijl ze plezier hebben!"
    ],
    "es": [
      "Giros ascendentes, woops, minislalom, túnel, minicañón, campanas, xilófono.. Gracias a las pistas lúdicas, sus hijos aprenderán mientras se divierten"
    ]
  },
