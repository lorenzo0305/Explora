  "rdfs:comment": {
    "de": [
      "Die AAPPMA von Yssingeaux bietet Ihnen anlässlich der Eröffnung des Fischfangs einen geselligen Moment. Verkostung von (hausgemachten) Kutteln ab 9:30 Uhr an der Fußgängerbrücke von Chambonnet am Fluss Auze (Kutteln auf Reservierung)."
    ],
    "en": [
      "The AAPPMA of Yssingeaux invites you to share a convivial moment at the opening of the fishing season. Home-made tripe tasting from 9:30 am at the Chambonnet footbridge on the Auze river (Tripe on reservation)."
    ],
    "it": [
      "L'AAPPMA di Yssingeaux vi invita a condividere un momento di convivialità in occasione dell'apertura della stagione di pesca. Degustazione di trippa fatta in casa a partire dalle 9.30 presso la passerella di Chambonnet sul fiume Auze (trippa su prenotazione)."
    ],
    "fr": [
      "L'AAPPMA d'Yssingeaux vous propose de partager un moment convivial lors de l'ouverture de la pêche. Dégustation de Tripes (maison) à partir de 9h30 à la passerelle du Chambonnet sur la rivière l'Auze. (Tripes sur Réservation)."
    ],
    "es": [
      "La AAPPMA de Yssingeaux le invita a compartir un momento de convivencia en la apertura de la temporada de pesca. Degustación de callos caseros a partir de las 9.30 h en la pasarela de Chambonnet sobre el río Auze (Callos previa reserva)."
    ],
    "nl": [
      "De AAPPMA van Yssingeaux nodigt u uit voor een gezellig moment bij de opening van het visseizoen. Proeverij van huisbereide pens vanaf 9.30 uur aan de voetgangersbrug van Chambonnet op de Auze (pens op reservering)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ouverture de la pêche et dégustation de tripes"
    ]
  },
