  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt in Aussois informiert Sie über Aktivitäten, Veranstaltungen, Sehenswürdigkeiten, Verkehrsmittel, Wander- und Schneeschuhrouten des Ortes."
    ],
    "en": [
      "The reception team is at your disposal to inform you about activities, entertainment, the heritage to visit, hiking and snowshoeing itineraries and all the services of the resort so that your holidays in Aussois are the best!"
    ],
    "it": [
      "Il team della reception è a vostra disposizione per informarvi sulle attività, i divertimenti, il patrimonio da visitare, gli itinerari per le escursioni e le racchette da neve e tutti i servizi del resort affinché le vostre vacanze ad Aussois siano le migliori in assoluto!"
    ],
    "fr": [
      "L'Office du Tourisme à Aussois vous renseigne sur les activités, les animations, le patrimoine à visiter, les transports, les itinéraires randonnées et raquettes de la station."
    ],
    "es": [
      "La Oficina de Turismo de Aussois ofrece información sobre actividades, eventos, lugares que visitar, transportes, rutas de senderismo y raquetas de nieve en la estación."
    ],
    "nl": [
      "Het receptieteam staat tot uw beschikking om u te informeren over activiteiten, entertainment, het te bezoeken erfgoed, wandel- en sneeuwschoenroutes en alle diensten van het resort, zodat uw vakantie in Aussois de beste ooit zal zijn!"
    ]
  },
