  "rdfs:comment": {
    "de": [
      "Restaurant unter den Arkaden von Nyons, in dem die Küchenchefin Ihnen eine französisch-asiatische Küche auf der Grundlage lokaler Saisonprodukte in einem Wahlmenü am Mittag und à la carte am Abend serviert."
    ],
    "en": [
      "Restaurant located under the arcades of Nyons where the chef makes you discovering a Franco-Asian cuisine based on seasonal local products in a menu of your choice for lunch and \"a la carte\" in the evening. \r\nFood Guide Selections and Michelin Guide 1 fork."
    ],
    "it": [
      "Ristorante situato sotto i portici di Nyons dove lo chef vi farà scoprire una cucina franco-asiatica a base di prodotti locali di stagione con menù a scelta a pranzo e à la carte la sera."
    ],
    "fr": [
      "Restaurant situé sous les arcades de Nyons où la chef vous fera découvrir une cuisine franco-asiatique basée sur des produits locaux de saison dans un menu à choix le midi et à la carte le soir."
    ],
    "es": [
      "Restaurante situado bajo los soportales de Nyons donde el chef le hará descubrir una cocina franco-asiática basada en productos locales de temporada en un menú a elegir al mediodía y a la carta por la noche."
    ],
    "nl": [
      "Restaurant gelegen onder de booggewelven van Nyons waar de chef u zijn Frans-Aziatische keuken laat proeven, gebaseerd op lokale seizoensproducten in een lunchmenu naar keuze of à la carte 's avonds. Geselecteerd door de Fooding gids en in de Michelingids met 1 fourchette."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Verre à Soie"
    ],
    "fr": [
      "Le Verre à Soie"
    ]
  },
