  "rdfs:comment": {
    "de": [
      "Im Zentrum der Altstadt von St Symphorien sur Coise finden Sie die Atmosphäre eines freundlichen und geselligen Bar-Restaurants. Jeden Tag stehen verschiedene Fleisch- und Fischgerichte auf der Speisekarte. Gerichte zum Mitnehmen unter der Woche."
    ],
    "en": [
      "In the centre of the old town of St Symphorien sur Coise, discover the atmosphere of a friendly and hospitable bar and restaurant. Simple cuisine made with local produce."
    ],
    "it": [
      "Nel centro storico di St Symphorien sur Coise, troverete l'atmosfera di un accogliente bar ristorante. Ogni giorno nel menu, diversi piatti di carne e pesce. Pasti da asporto durante la settimana."
    ],
    "fr": [
      "Au centre de la vieille ville de St Symphorien sur Coise, retrouvez l'ambiance d'un bar restaurant sympathique et convivial. Tous les jours au menu, viande et poissons différents. Plats à emporter en semaine."
    ],
    "nl": [
      "In het centrum van het oude centrum van St Symphorien sur Coise vindt u de sfeer van een gezellige bar restaurant. Elke dag op het menu, verschillende vlees- en visgerechten. Afhaalmaaltijden tijdens de week."
    ],
    "es": [
      "En el centro del casco antiguo de St Symphorien sur Coise, encontrará el ambiente de un agradable bar restaurante. Cada día en el menú, diferentes platos de carne y pescado. Comida para llevar entre semana."
    ]
  },
