  "rdfs:comment": {
    "de": [
      "Am Flussufer, unterhalb des Dorfes Aiguebelette-le-Lac, gönnen Sie sich eine ölfreie Massage von 30 Minuten, 1 Stunde oder 1,5 Stunden."
    ],
    "en": [
      "By the river below the village of Aiguebelette-le-Lac, treat yourself to an oil-free massage lasting 30 minutes, 1 hour or 1.5 hours."
    ],
    "it": [
      "Sulle rive del fiume sotto il villaggio di Aiguebelette-le-Lac, concedetevi un massaggio senza olio di 30 minuti, 1 ora o 1 ora e 30 minuti."
    ],
    "fr": [
      "Au bord de la rivière, en contrebas du village d'Aiguebelette-le-Lac, offrez-vous un massage sans huile de 30 minutes, 1 heure ou 1 heure 30."
    ],
    "nl": [
      "Aan de oever van de rivier onder het dorp Aiguebelette-le-Lac kun je jezelf verwennen met een olievrije massage van 30 minuten, 1 uur of 1 uur 30 minuten."
    ],
    "es": [
      "A orillas del río, bajo el pueblo de Aiguebelette-le-Lac, regálese un masaje sin aceite de 30 minutos, 1 hora o 1 hora y media."
    ]
