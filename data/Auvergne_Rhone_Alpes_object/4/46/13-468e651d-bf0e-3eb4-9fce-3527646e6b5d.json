  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses neue Restaurant in Saint-Marcel-Bel-Accueil. Frédéric und Sandrine, die Geschäftsführer, bieten Ihnen eine traditionelle französische Küche, die aus frischen und hochwertigen Produkten zusammengestellt wird. Tagesgerichte unter der Woche, aber auch à la carte."
    ],
    "en": [
      "Discover this new restaurant in Saint-Marcel-Bel-Accueil. Frédéric and Sandrine, the owners, offer traditional French cuisine concocted from fresh, high-quality ingredients. Daily specials during the week, but also à la carte."
    ],
    "it": [
      "Scoprite questo nuovo ristorante a Saint-Marcel-Bel-Accueil. Frédéric e Sandrine, i proprietari, propongono una cucina tradizionale francese a base di prodotti freschi e di qualità. Specialità giornaliere durante la settimana, ma anche à la carte."
    ],
    "fr": [
      "Découvrez ce nouveau restaurant à Saint-Marcel-Bel-Accueil. Frédéric et Sandrine, les gérants, vous proposent une cuisine traditionnelle française concoctée à partir de produits frais et de qualité. Plats du jour en semaine mais également à la carte."
    ],
    "nl": [
      "Ontdek dit nieuwe restaurant in Saint-Marcel-Bel-Accueil. Frédéric en Sandrine, de eigenaars, bieden een traditionele Franse keuken met verse kwaliteitsproducten. Dagelijkse specials tijdens de week, maar ook à la carte."
    ],
    "es": [
      "Descubra este nuevo restaurante de Saint-Marcel-Bel-Accueil. Frédéric y Sandrine, los propietarios, proponen una cocina tradicional francesa elaborada con productos frescos y de calidad. Especialidades diarias durante la semana, pero también a la carta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Mêlée du Village"
    ]
  },
