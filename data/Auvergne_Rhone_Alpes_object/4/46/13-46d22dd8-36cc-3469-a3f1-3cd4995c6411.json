  "rdfs:comment": {
    "de": [
      "Öl- oder Acrylmalerei. Andeuten, ausradieren, Formfragmente zum Vorschein bringen, um nur das Wesentliche dem Blick derer zu überlassen, die die Leinwand zum Leben erwecken werden."
    ],
    "en": [
      "Modern art gallery."
    ],
    "it": [
      "Pittura ad olio o acrilica. Suggerire, cancellare, far apparire frammenti di forma, per lasciare solo l'essenziale agli occhi di chi darà vita alla tela."
    ],
    "fr": [
      "Peinture huile ou acrylique. Suggérer, effacer, faire apparaître des fragments de forme, pour ne laisser que l'essentiel au regard de ceux qui vont faire vivre la toile."
    ],
    "es": [
      "Pintura al óleo o acrílica. Sugerir, borrar, hacer aparecer fragmentos de formas, para dejar sólo lo esencial a los ojos de quienes darán vida al lienzo."
    ],
    "nl": [
      "Olie- of acrylverf. Suggereer, wis, onthul fragmenten van vorm, laat alleen het essentiële over voor degenen die het doek tot leven zullen brengen."
    ]
  },
