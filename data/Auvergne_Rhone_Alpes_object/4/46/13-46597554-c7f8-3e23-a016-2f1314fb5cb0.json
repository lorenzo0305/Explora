  "rdfs:comment": {
    "de": [
      "La Tarterie ist Ihr neuer Ort für Feinschmecker in Rovaltain: Hier finden Sie unsere salzigen und süßen Torten, Salate und Formeln, die aus frischen und saisonalen Produkten zubereitet werden."
    ],
    "en": [
      "La Tarterie is your new gourmet spot in Rovaltain: discover our sweet and savoury tarts, salads and formulas made with fresh, seasonal produce."
    ],
    "it": [
      "La Tarterie è il vostro nuovo punto di ristoro a Rovaltain: provate le nostre crostate dolci e salate, le insalate e le formule a base di prodotti freschi di stagione."
    ],
    "fr": [
      "La Tarterie est votre nouveau lieu gourmand à Rovaltain : retrouvez nos tartes salées et sucrées, nos salades et formules élaborées à base de produits frais et de saison."
    ],
    "nl": [
      "La Tarterie is je nieuwe gastronomische plek in Rovaltain: probeer onze zoete en hartige taarten, salades en formules gemaakt met verse seizoensproducten."
    ],
    "es": [
      "La Tarterie es su nuevo lugar gastronómico en Rovaltain: pruebe nuestras tartas dulces y saladas, ensaladas y fórmulas elaboradas con productos frescos de temporada."
    ]
  },
  "rdfs:label": {
