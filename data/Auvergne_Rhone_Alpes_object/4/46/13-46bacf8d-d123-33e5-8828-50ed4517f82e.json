  "rdfs:comment": {
    "de": [
      "Auf der Ferme de la Fournache, oberhalb von Saint-Jean-de-Maurienne, bauen Noélie und Thibaut auf einer kleinen, nicht mechanisierten Fläche frisches und vielfältiges Gemüse in biologischer Landwirtschaft an."
    ],
    "en": [
      "At the Ferme de la Fournache, on the heights of Saint-Jean-de-Maurienne, Noélie and Thibaut cultivate on a small non-mechanized area, fresh and diversified vegetables in organic farming."
    ],
    "it": [
      "Alla Ferme de la Fournache, sulle alture di Saint-Jean-de-Maurienne, Noélie e Thibaut coltivano ortaggi freschi e diversificati in Agricoltura Biologica su una piccola superficie non meccanizzata."
    ],
    "fr": [
      "À la Ferme de la Fournache, sur les hauteurs de Saint-Jean-de-Maurienne, Noélie et Thibaut cultivent sur une petite surface non mécanisée, des légumes frais et diversifiés en Agriculture Biologique."
    ],
    "nl": [
      "In de Ferme de la Fournache, op de hoogten van Saint-Jean-de-Maurienne, telen Noélie en Thibaut verse en gediversifieerde groenten in de biologische landbouw op een kleine niet-gemechaniseerde oppervlakte."
    ],
    "es": [
      "En la Ferme de la Fournache, en las alturas de Saint-Jean-de-Maurienne, Noélie y Thibaut cultivan hortalizas frescas y diversificadas en Agricultura Ecológica en una pequeña superficie no mecanizada."
    ]
  },
