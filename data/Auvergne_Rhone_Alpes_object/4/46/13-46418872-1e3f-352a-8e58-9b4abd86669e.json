  "rdfs:comment": {
    "de": [
      "Wie ein Vorgeschmack auf die Côte d'Azur wirkt dieser angelegte und bewachte Sand- und Rasenstrand. Im Restaurant können Matratzen gemietet werden."
    ],
    "en": [
      "Equipped and supervised beach, with sand and turf."
    ],
    "it": [
      "Spiaggia animata e sorvegliata, sabbia e prato."
    ],
    "fr": [
      "Comme un avant-goût de Côte d'Azur pour cette plage aménagée et surveillée en sable et gazon. Possibilité de louer des matelas au restaurant."
    ],
    "nl": [
      "Een voorproefje van de Côte d'Azur voor dit zand- en grasstrand met badmeesters. Matrassen kunnen worden gehuurd in het restaurant."
    ],
    "es": [
      "Como un anticipo de la Costa Azul, esta playa está equipada y vigilada con arena y césped. Se pueden alquilar colchones en el restaurante."
    ]
  },
