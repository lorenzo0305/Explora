  "rdfs:comment": {
    "de": [
      "Disc Golf basiert auf den Regeln des Golfspiels und ist ein Wurfspiel, das in natürlicher Umgebung gespielt werden kann, sobald man alt genug ist, um richtig zu laufen."
    ],
    "ru": [
      "Диск-гольф, основанный на правилах гольфа, - это игра, в которую можно играть в естественной среде, как только вы достаточно подрастете, чтобы правильно ходить."
    ],
    "en": [
      "Disc golf, based on the rules of golf, is a throwing game that can be played in natural surroundings as soon as you're old enough to walk properly."
    ],
    "it": [
      "Il disc golf, basato sulle regole del golf, è un gioco di lancio che può essere praticato in un ambiente naturale non appena si è abbastanza grandi per camminare correttamente."
    ],
    "fr": [
      "Le disc golf, basé sur les règles du golf, est un jeu de lancer qui se pratique en milieu naturel dès lors que l'on est en âge de marcher correctement."
    ],
    "zh": [
      "飞盘高尔夫以高尔夫规则为基础，是一种投掷游戏，只要你到了可以正常行走的年龄，就可以在自然环境中进行游戏。"
    ],
    "es": [
      "El disc golf, basado en las reglas del golf, es un juego de lanzamiento que puede practicarse en un entorno natural en cuanto se tiene edad para caminar correctamente."
    ],
    "nl": [
      "Disc golf, gebaseerd op de regels van golf, is een werpspel dat in een natuurlijke omgeving kan worden gespeeld zodra je oud genoeg bent om goed te kunnen lopen."
    ]
  },
  "rdfs:label": {
