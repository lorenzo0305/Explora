  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von einer Atmosphäre voller Lächeln mitreißen, in einem neuen, schlichten Rahmen, finden Sie eine großzügige, abwechslungsreiche und ehrliche Küche. Das Ganze mit einem Panoramablick auf das Giffre-Tal."
    ],
    "en": [
      "Let yourself be carried away by an atmosphere of smiles, In a new and uncluttered setting, find a generous, varied and honest cuisine. All with a panoramic view of the Giffre Valley."
    ],
    "it": [
      "Lasciatevi trasportare da un'atmosfera fatta di sorrisi, in un ambiente nuovo e raffinato, trovate una cucina generosa, varia e onesta. Il tutto con una vista panoramica sulla Valle di Giffre."
    ],
    "fr": [
      "Laissez-vous emporter par une ambiance faite de sourires, dans un cadre neuf et épuré, retrouver une cuisine généreuse, variée et honnête. Le tout avec une vue panoramique sur la Vallée du Giffre."
    ],
    "nl": [
      "Laat je meeslepen door een sfeer van glimlachen, In een nieuwe en overzichtelijke omgeving vindt u een royale, gevarieerde en eerlijke keuken. Allemaal met een panoramisch uitzicht op de Giffre-vallei."
    ],
    "es": [
      "Déjese llevar por un ambiente hecho de sonrisas, en un marco nuevo y refinado, encuentre una cocina generosa, variada y honesta. Todo ello con una vista panorámica del valle de Giffre."
    ]
  },
