  "rdfs:comment": {
    "de": [
      "Seit 1982 führt die Huilerie Beaujolaise die handwerkliche Herstellung von nativen Ölen fort, die zu 100 % aus der Frucht gewonnen werden; ein vollkommen natürliches Feinprodukt: eine Frucht?ein Öl."
    ],
    "en": [
      "Since 1982, Huilerie Beaujolaise have kept alive the traditional methods of manufacturing virgin 100% fruit oils, producing completely natural products: one fruit, one oil."
    ],
    "it": [
      "Dal 1982, la Huilerie Beaujolaise produce artigianalmente oli vergini al 100% a base di frutta, un prodotto pregiato e completamente naturale: un frutto, un olio."
    ],
    "fr": [
      "Depuis 1982, l'Huilerie Beaujolaise perpétue la fabrication artisanale d’huiles vierges 100 % du fruit ; un produit fin complètement naturel : un fruit…une huile."
    ],
    "nl": [
      "Sinds 1982 produceert Huilerie Beaujolaise met de hand 100% virgin oliën op basis van fruit, een fijn en volledig natuurlijk product: één vrucht?één olie."
    ],
    "es": [
      "Desde 1982, la Huilerie Beaujolaise produce artesanalmente aceites vírgenes 100% a base de fruta, un producto fino y totalmente natural: una fruta... un aceite."
    ]
  },
