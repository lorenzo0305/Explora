  "rdfs:comment": {
    "de": [
      "Biologisch bewirtschafteter Kleinstbauernhof, der eine große Vielfalt an saisonalem Gemüse, Kräutern und einigen Früchten produziert, die auf natürliche Weise in Gärten mit Bäumen und geschützten Flächen angebaut werden. Familienfreundliche, gesunde und umweltfreundliche Produktion."
    ],
    "en": [
      "Farmer selling direct."
    ],
    "it": [
      "Microagricoltura biologica che produce un'ampia gamma di ortaggi di stagione, erbe aromatiche e alcuni frutti, coltivati in modo naturale in giardini boscosi e incontaminati. Una produzione sana, a conduzione familiare e rispettosa dell'ambiente."
    ],
    "fr": [
      "Micro-ferme en agriculture biologique produisant une grande diversité de légumes de saison, d'aromatiques et quelques fruits, cultivés naturellement au sein de jardins arborés et préservés. Production familiale, saine et respectueuse de l'environnement."
    ],
    "es": [
      "Microexplotación ecológica que produce una amplia gama de hortalizas de temporada, hierbas aromáticas y algunas frutas, cultivadas de forma natural en huertos arbolados y vírgenes. Producción familiar, sana y respetuosa con el medio ambiente."
    ],
    "nl": [
      "Biologische micro-boerderij die een breed assortiment seizoensgroenten, kruiden en wat fruit produceert, op natuurlijke wijze verbouwd in beboste, ongerepte tuinen. Gezonde familieproductie met respect voor het milieu."
    ]
  },
  "rdfs:label": {
    "en": [
      "Beaulieu Gardens"
    ],
    "fr": [
      "Les jardins de Beaulieu"
    ]
  },
