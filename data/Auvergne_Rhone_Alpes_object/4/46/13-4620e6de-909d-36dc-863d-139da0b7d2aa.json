  "rdfs:comment": {
    "de": [
      "Ensemble aus Karussellmühlen und Schnecken- und Hebelpressen aus dem Jahr 1830, die früher zur Herstellung von Walnussöl, Apfel- und Beerensaft und Apfelwein verwendet wurden."
    ],
    "en": [
      "Collection of donkey mills, screw presses and lever presses dating from 1830 and formerly used to produce walnut oil, apple and berry fruit juice and cider."
    ],
    "it": [
      "Una serie di mulini con giostra e presse a vite e a leva risalenti al 1830 e utilizzati in passato per la produzione di olio di noci, succo di mela e di bacche e sidro."
    ],
    "fr": [
      "Ensemble de moulins à manège et pressoirs à vis et à leviers datant de 1830 et anciennement utilisés pour la fabrication de l'huile de noix, jus de pommes et petits fruits, cidre."
    ],
    "nl": [
      "Verzameling van rosmolens, schroefpersen en hefboompersen uit 1830 en vroeger gebruikt voor de productie van walnotenolie, appelsap, bessensap en cider."
    ],
    "es": [
      "Un conjunto de molinos con un tiovivo y prensas de tornillo y palanca que data de 1830 y que antiguamente se utilizaba para la producción de aceite de nuez, zumo de manzana y bayas y sidra."
    ]
  },
