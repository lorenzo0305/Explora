  "rdfs:comment": {
    "de": [
      "Restaurant, Kamin, Terrasse, Saal für Empfänge, Seminare, Veranstaltungen, 5 Min. von Roanne entfernt. Richtung Commelle-Vernay und See von Villerest. Traditionelle Küche mit Biofleisch und lokalen Produkten."
    ],
    "en": [
      "Restaurant, fireplace, terrace, reception room, seminars, events 5 min from Roanne. Direction Commelle-Vernay and Lac de Villerest. Traditional cuisine based on organic meat and local produce."
    ],
    "it": [
      "Ristorante, camino, terrazza, sala riunioni, seminari, eventi a 5 minuti da Roanne. Sulla strada per Commelle-Vernay e il lago di Villerest. Cucina tradizionale a base di carne biologica e prodotti locali."
    ],
    "fr": [
      "Restaurant, cheminée, terrasse, salle de réception, séminaires, évènementiels à 5 min de Roanne. Direction Commelle-Vernay et le lac de Villerest. Cuisine traditionnelle à base de viande bio et produits locaux."
    ],
    "es": [
      "Restaurante, chimenea, terraza, salón de actos, seminarios, eventos a 5 minutos de Roanne. De camino a Commelle-Vernay y al lago Villerest. Cocina tradicional a base de carne ecológica y productos locales."
    ],
    "nl": [
      "Restaurant, open haard, terras, feestzaal, seminars, evenementen op 5 minuten van Roanne. Op weg naar Commelle-Vernay en het meer van Villerest. Traditionele keuken op basis van biologisch vlees en lokale producten."
    ]
  },
