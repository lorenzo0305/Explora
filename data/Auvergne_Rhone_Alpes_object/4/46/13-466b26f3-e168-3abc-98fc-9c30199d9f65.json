  "rdfs:comment": {
    "de": [
      "Das Maya Altitude, ein unumgängliches Restaurant am Gipfel der Pisten von Les 3 Vallées, bietet ein einzigartiges Erlebnis.\r\n\r\nDieses gesellige Chalet bietet eine spektakuläre Aussicht auf 2300 m Höhe."
    ],
    "en": [
      "The Maya Altitude, an unmissable restaurant at the top of the slopes of the 3 Vallées, offers a unique experience.\r\n\r\nOpened in December 2021, this friendly chalet offers a spectacular view at 2,300 meters above sea level. Its warm decoration, menu combining Savoyard specialties and unique cooking techniques, as well as its festive atmosphere with a resident DJ, make it a place not to be missed for an exceptional culinary experience."
    ],
    "it": [
      "Maya Altitude, il ristorante imperdibile in cima alle piste delle 3 Vallées, offre un'esperienza unica.\r\n\r\nQuesto accogliente chalet offre una vista spettacolare a 2.300 metri di altitudine."
    ],
    "fr": [
      "Le Maya Altitude, restaurant incontournable au sommet des pistes des 3 Vallées, offre une expérience unique.\r\n\r\nCe chalet convivial propose une vue spectaculaire à 2 300 mètres d'altitude."
    ],
    "es": [
      "Maya Altitude, el restaurante de visita obligada en la cima de las pistas de 3 Vallées, ofrece una experiencia única.\r\n\r\nEste acogedor chalé ofrece unas vistas espectaculares a 2.300 metros de altitud."
    ],
    "nl": [
      "Das Maya Altitude, ein unverzichtbares Restaurant auf den Gipfeln der 3 Vallées, bietet ein einzigartiges Erlebnis.\r\n\r\nEröffnet im Dezember 2021, bietet dieses freundliche Chalet einen spektakulären Blick auf 2.300 Meter über dem Meeresspiegel. Seine warme Dekoration, eine Speisekarte, die Savoyer Spezialitäten und einzigartige Kochtechniken kombiniert, sowie seine festliche Atmosphäre mit einem Resident-DJ machen es zu einem Ort, den man für ein außergewöhnliches kulinarisches Erlebnis nicht verpassen sollte."
    ]
  },
