  "rdfs:comment": {
    "de": [
      "Die Stadtverwaltung stellt Cani-Bag-Spender für Hundehalter und ihre Hunde zur Verfügung, um die Stadt sauberer zu halten."
    ],
    "en": [
      "The Mairie provides distributors of cani bags for owners and their dogs to help keep the city cleaner."
    ],
    "it": [
      "Il Comune mette a disposizione dei proprietari e dei loro cani dei distributori di sacchetti per cani che aiutano a mantenere la città più pulita."
    ],
    "fr": [
      "La Mairie met à disposition des distributeurs de cani sacs à destination des maîtres et de leurs chiens pour une ville plus propre."
    ],
    "nl": [
      "Het stadhuis verstrekt verdelers van cani-zakjes voor baasjes en hun honden om de stad schoner te houden."
    ],
    "es": [
      "El Ayuntamiento pone a disposición de los dueños y sus perros distribuidores de bolsas caninas para ayudar a mantener la ciudad más limpia."
    ]
  },
