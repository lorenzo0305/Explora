  "rdfs:comment": {
    "de": [
      "der Hedonist (Adj.): bezeichnet einen Anhänger des Hedonismus, der das Vergnügen zu seinem wichtigsten Lebensziel macht. Eine Definition, die dieses Restaurant am Place Grenette in Saint-Étienne auf den Punkt bringt!"
    ],
    "en": [
      "‘Hedonist (adj.): said of a follower of hedonism, who makes pleasure his or her primary aim in life’. A definition that brilliantly sums up this restaurant on Place Grenette in Saint-Étienne!"
    ],
    "it": [
      "edonista (agg.): si dice di un seguace dell'edonismo, che fa del piacere il suo scopo principale nella vita? Una definizione che riassume brillantemente questo ristorante di Place Grenette a Saint-Étienne!"
    ],
    "fr": [
      "“L’hédoniste (adj.) : se dit du partisan de l’hédonisme, qui fait du plaisir son but premier dans la vie”. Une définition qui résume avec brio ce restau de la place Grenette à Saint-Étienne !"
    ],
    "es": [
      "hedonista (adj.): se dice del seguidor del hedonismo, que hace del placer su principal objetivo en la vida... Una definición que resume a la perfección este restaurante de la plaza Grenette de Saint-Étienne"
    ],
    "nl": [
      "hedonist (adj.): wordt gezegd van een aanhanger van het hedonisme, die van genot zijn of haar belangrijkste doel in het leven maakt? Een definitie die dit restaurant op de Place Grenette in Saint-Étienne perfect samenvat!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant L'Hédoniste"
    ],
    "fr": [
      "Restaurant L'Hédoniste"
    ]
  },
