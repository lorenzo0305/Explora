  "rdfs:comment": {
    "de": [
      "L'Herbier de Saint-Fiacre: Biologisch bewirtschafteter Betrieb für aromatische und medizinische Pflanzen. Entdeckungs- und pädagogischer Bauernhof, wo Tiere und Pflanzen in Harmonie auf über 32 ha landschaftlich gestalteter Fläche leben. Eine Bocage in der Sologne Bourbonnaise."
    ],
    "en": [
      "L'Herbier de Saint-Fiacre: organic farming of aromatic and medicinal plants. A discovery and educational farm where animals and plants live in harmony on over 32 hectares of landscaped grounds. A bocage in Sologne Bourbonnaise."
    ],
    "it": [
      "L'Herbier de Saint-Fiacre: agricoltura biologica di piante aromatiche e medicinali. Una fattoria didattica e di scoperta dove animali e piante vivono in armonia su oltre 32 ettari di terreno paesaggistico. Un bocage nella regione della Sologna."
    ],
    "fr": [
      "L'Herbier de Saint-Fiacre : exploitation en agriculture biologique de plantes aromatiques, médicinales. Ferme de découverte et pédagogique où animaux et plantes vivent en harmonie sur plus de 32 ha paysagers. Un bocage en sologne bourbonnaise."
    ],
    "es": [
      "L'Herbier de Saint-Fiacre: cultivo ecológico de plantas aromáticas y medicinales. Una granja de descubrimiento y educación donde animales y plantas viven en armonía en más de 32 hectáreas de terreno ajardinado. Un bocage en la región de Sologne."
    ],
    "nl": [
      "L'Herbier de Saint-Fiacre: biologische landbouw van aromatische en geneeskrachtige planten. Een ontdekkings- en educatieve boerderij waar dieren en planten in harmonie leven op meer dan 32 hectare aangelegd terrein. Een bocage in de Sologne."
    ]
  },
