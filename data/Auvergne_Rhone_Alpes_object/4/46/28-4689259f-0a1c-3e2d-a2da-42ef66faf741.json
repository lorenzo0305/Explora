  "rdfs:comment": {
    "de": [
      "Der Picknickplatz in Longueil-Sainte-Marie liegt in der Nähe des Voie Verte de la Plaine d'Estrées. Er ist schattig und mit Tischen, Mülleimern und einem Parkplatz in der Nähe ausgestattet."
    ],
    "en": [
      "Located near the Voie Verte de la Plaine d'Estrées, the picnic area of Longueil-Sainte-Marie is shaded and equipped with tables, bins and a car park nearby."
    ],
    "it": [
      "Situata vicino alla Voie Verte de la Plaine d'Estrées, l'area picnic di Longueil-Sainte-Marie è ombreggiata e attrezzata con tavoli, cestini e un parcheggio nelle vicinanze."
    ],
    "fr": [
      "Située à proximité de la Voie Verte de la Plaine d'Estrées, l'aire de pique-nique de Longueil-Sainte-Marie est ombragée et équipée de tables, poubelles et d'un parking à proximité."
    ],
    "es": [
      "Situada cerca de la Voie Verte de la Plaine d'Estrées, la zona de picnic de Longueil-Sainte-Marie está sombreada y equipada con mesas, papeleras y un aparcamiento cercano."
    ],
    "nl": [
      "De picknickplaats van Longueil-Sainte-Marie, gelegen nabij de Voie Verte de la Plaine d'Estrées, is schaduwrijk en voorzien van tafels, vuilnisbakken en een parkeerplaats in de buurt."
    ]
  },
  "rdfs:label": {
