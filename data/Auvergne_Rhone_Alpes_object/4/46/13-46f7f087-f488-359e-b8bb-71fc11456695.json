  "rdfs:comment": {
    "de": [
      "Weniger als 5 Minuten vom Stadtzentrum entfernt, ist der Golfplatz von Saint-Etienne als eine Einrichtung konzipiert, die für möglichst viele Menschen zugänglich ist und ihnen zur Verfügung steht."
    ],
    "en": [
      "The Saint-Etienne Golf Course is within easy reach: only 5 minutes' away from the city centre, it intends to serve the maximum number of people."
    ],
    "it": [
      "A meno di 5 minuti dal centro città, il Golf Club Saint-Etienne è stato concepito come una struttura alla portata del maggior numero possibile di persone."
    ],
    "fr": [
      "A moins de 5 minutes du centre ville, le Golf de Saint-Etienne est conçu comme un équipement à la portée et au service du plus grand nombre."
    ],
    "nl": [
      "De Saint-Etienne Golf Club ligt op minder dan 5 minuten van het stadscentrum en is ontworpen als een faciliteit binnen het bereik van zoveel mogelijk mensen."
    ],
    "es": [
      "A menos de 5 minutos del centro de la ciudad, el Club de Golf Saint-Etienne está concebido como una instalación al alcance del mayor número de personas posible."
    ]
  },
