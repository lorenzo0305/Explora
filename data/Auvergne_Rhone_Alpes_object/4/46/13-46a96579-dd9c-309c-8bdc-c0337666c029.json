  "rdfs:comment": {
    "de": [
      "Die MacQuart P.O.A. Ranch liegt eine halbe Stunde südlich von Le Puy-en-Velay und züchtet Angus-Bio-Rinder und amerikanische Ponys. Außergewöhnliches Rindfleisch, das mit Cidre verfeinert wird, wird ab Hof verkauft oder in Paketen in ganz Frankreich ausgeliefert. Unterkunft in Ferienhäusern und Gästezimmern."
    ],
    "en": [
      "Half an hour south of Le Puy-en-Velay, the MacQuart P.O.A. Ranch raises organic Angus cows and American ponies. Exceptional cider-finished beef, sold at the farm or in parcels delivered anywhere in France. Gîtes and chambres d?hôtes available."
    ],
    "it": [
      "A mezz'ora a sud di Le Puy-en-Velay, il MacQuart P.O.A. Ranch alleva vacche Angus biologiche e pony americani. Eccezionale carne di manzo rifinita al sidro, venduta in fattoria o in pacchi consegnati in tutta la Francia. Possibilità di pernottamento e prima colazione e gîtes."
    ],
    "fr": [
      "À une demi-heure au sud du Puy-en-Velay, le MacQuart P.O.A. Ranch élève des vaches Angus en bio et des poneys des Amériques. Bœuf d’exception fini au cidre, vente à la ferme ou en colis livrés partout en France. Accueil en gîtes et chambres d’hôtes."
    ],
    "nl": [
      "Een half uur ten zuiden van Le Puy-en-Velay fokt de MacQuart P.O.A. Ranch biologische Angus koeien en Amerikaanse pony's. Uitzonderlijk ciderrundvlees wordt op de boerderij verkocht of in pakketten overal in Frankrijk geleverd. Bed and breakfast en gîtes beschikbaar."
    ],
    "es": [
      "A media hora al sur de Le Puy-en-Velay, el rancho MacQuart P.O.A. cría vacas Angus ecológicas y ponis americanos. Carne de buey excepcional acabada a la sidra, vendida en la granja o en paquetes entregados en cualquier lugar de Francia. Posibilidad de alojamiento y desayuno y casas rurales."
    ]
  },
