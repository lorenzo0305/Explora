  "rdfs:comment": {
    "de": [
      "Als Schöpfer von Aktivitäten im Haut-Bréda-Tal und in Le Pleynet bietet Ihnen dieses Team aus Naturliebhabern und Menschen, die gerne teilen, die Möglichkeit, die Berge der Belledonne zu entdecken."
    ],
    "en": [
      "Creators of activities in the Haut Bréda valley and Le Pleynet, this team of nature-lovers and sharers invites you to discover the Belledonne mountains."
    ],
    "it": [
      "Creatore di attività nella valle dell'Haut Bréda e a Le Pleynet, questo team di amanti della natura e della condivisione vi invita a scoprire le montagne di Belledonne."
    ],
    "fr": [
      "Créateurs d’activités en vallée du Haut Bréda et au Pleynet, cette équipe de passionnés de nature et de partage vous propose de découvrir les montagnes de Belledonne."
    ],
    "nl": [
      "Dit team van natuurliefhebbers en delers, dat activiteiten organiseert in de vallei van de Haut Bréda en op Le Pleynet, nodigt je uit om de bergen van Belledonne te ontdekken."
    ],
    "es": [
      "Creadores de actividades en el valle del Haut Bréda y en Le Pleynet, este equipo de amantes de la naturaleza y del compartir le invita a descubrir las montañas de Belledonne."
    ]
  },
  "rdfs:label": {
    "en": [
      "Heart of Belledonne"
    ],
    "fr": [
      "Coeur de Belledonne"
    ]
  },
