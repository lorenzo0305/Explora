  "rdfs:comment": {
    "de": [
      "In der Nähe der Kirche steht noch ein schmiedeeisernes Kreuz aus dem 15. Jahrhundert. Es besteht aus zwei schmiedeeisernen Stangen, deren Enden gekugelt sind und auf die gezackte Blätter gelötet sind. In der Mitte ist ein Christus aus Bronze angebracht."
    ],
    "en": [
      "Near the church stands a 15th-century wrought-iron cross. It consists of two wrought-iron rods with bolted ends, to which serrated leaves are welded. A bronze Christ is affixed to the center."
    ],
    "it": [
      "Vicino alla chiesa si trova una croce in ferro battuto risalente al XV secolo. È costituita da due aste in ferro battuto con estremità imbullonate, alle quali sono saldate delle foglie dentellate. Al centro è affisso un Cristo in bronzo."
    ],
    "fr": [
      "A proximité de l'église subsiste une croix en fer forgé du XVème siècle. Elle se compose de deux tiges en fer forgé dont les extrémités sont boulées et sur lesquelles sont soudées des feuilles dentelées. Un Christ en bronze est apposé au centre."
    ],
    "es": [
      "Cerca de la iglesia se alza una cruz de hierro forjado que data del siglo XV. Consta de dos barras de hierro forjado con extremos atornillados, a los que están soldadas hojas dentadas. En el centro hay un Cristo de bronce."
    ],
    "nl": [
      "Bij de kerk staat een smeedijzeren kruis uit de 15e eeuw. Het bestaat uit twee smeedijzeren staven met geboute uiteinden waaraan getande bladen zijn gelast. In het midden is een bronzen Christus bevestigd."
    ]
  },
  "rdfs:label": {
