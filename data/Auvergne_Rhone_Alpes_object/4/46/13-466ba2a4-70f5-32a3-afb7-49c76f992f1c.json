  "rdfs:comment": {
    "de": [
      "Zucht von Highland Cattle-Mutterkühen.\r\nDirektverkauf von gefrorenem Fleisch und Bienenprodukten ab Hof.\r\nBesichtigung der Herde und der Bienenstöcke mit Honigverkostung.\r\n Nach vorheriger Anmeldung."
    ],
    "en": [
      "Breeding of Highlands Cattle.\r\nDirect farm sales of frozen meats and beekeeping products.\r\nVisit the herd and hives with honey tasting.\r\n Reservations required."
    ],
    "it": [
      "Allevamento di bovini delle Highlands.\r\nVendita diretta in azienda di carne congelata e prodotti apistici.\r\nVisita alla mandria e alle arnie con degustazione di miele.\r\n È necessaria la prenotazione."
    ],
    "fr": [
      "Élevage de vache allaitante Highlands Cattle.\r\nVente directe à la ferme de viandes surgelées et de produits apicoles.\r\nVisite du troupeau et des ruches avec dégustation de miel.\r\n Sur réservation."
    ],
    "nl": [
      "Fokken van Highlands-runderen.\r\nDirecte boerderijverkoop van bevroren vlees en bijenteeltproducten.\r\nBezoek de kudde en de bijenkorven met honingproeverij.\r\n Reserveren verplicht."
    ],
    "es": [
      "Cría de ganado vacuno de las Tierras Altas.\r\nVenta directa en granja de carne congelada y productos apícolas.\r\nVisita al rebaño y las colmenas con degustación de miel.\r\n Es necesario reservar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de ferme | Ferme des Val'Lands | St Christophe"
    ]
  },
