  "rdfs:comment": {
    "de": [
      "Das Gourmet-Restaurant Le M bietet Ihnen eine hochwertige, einfache und raffinierte regionale Küche, einen persönlichen Empfang, ein atemberaubendes Panorama und viele weitere Geheimnisse, die die Domaine des Avenières zu bieten hat."
    ],
    "en": [
      "The M, a gourmet restaurant, offers quality cuisine, simple and refined, a personalized welcome, a breathtaking panorama and many other secrets of which Domaine des Avenières is full."
    ],
    "it": [
      "Le M, ristorante gourmet, offre una cucina locale semplice, raffinata e di qualità, un'accoglienza personalizzata, una vista mozzafiato e molti altri segreti che il Domaine des Avenières ha da offrire."
    ],
    "fr": [
      "Le M, restaurant gourmand, vous propose une cuisine du terroir de qualité, simple et raffinée, un accueil personnalisé, un panorama à couper le souffle, et bien d’autres secrets dont regorge le Domaine des Avenières."
    ],
    "es": [
      "Le M, restaurante gastronómico, ofrece una cocina local sencilla, refinada y de calidad, una acogida personalizada, un panorama impresionante y muchos otros secretos que esconde el Domaine des Avenières."
    ],
    "nl": [
      "Le M, een gastronomisch restaurant, biedt een eenvoudige en verfijnde lokale keuken, een persoonlijk onthaal, een adembenemend panorama en vele andere geheimen die het Domaine des Avenières te bieden heeft."
    ]
  },
