  "rdfs:comment": {
    "de": [
      "Es heißt, dass man, über die Gorges de la Volane ankommend, im Verlauf der Kurven sieben Mal die Glocke von Antraigues sehen kann."
    ],
    "en": [
      "Be happy, be perched…this could be the motto for the Cévennes village perched above 3 rivers."
    ],
    "it": [
      "Per vivere felicemente, viviamo arroccati? Questo potrebbe essere il motto di questo villaggio delle Cévennes in equilibrio su 3 fiumi."
    ],
    "fr": [
      "Pour vivre heureux, vivons perchés… telle pourrait être la devise de ce village cévenol en équilibre au dessus de 3 rivières."
    ],
    "es": [
      "Para vivir felices, vivamos encaramados... ése podría ser el lema de este pueblo de las Cevenas en equilibrio sobre 3 ríos."
    ],
    "nl": [
      "Om gelukkig te leven, laten we hoog wonen? Dat zou het motto kunnen zijn van dit dorp in de Cevennen dat boven 3 rivieren balanceert."
    ]
  },
