  "rdfs:comment": {
    "de": [
      "Charles Varin-Bernier, Besitzer der Domaine Monin, ist Winzer, Erntehelfer und Käse-Affineur. Er empfängt Sie in seinem Weinkeller, in dem Sie seine gesamte Weinpalette entdecken können."
    ],
    "en": [
      "The EARL Domaine Monin is housed in an old Savoyard fortified manor house in the village of Vongnes.  Here M. Varin-Bernier will give you a warm welcome and offer advice about their choice of wines from their 400 year old vineyard."
    ],
    "it": [
      "Charles Varin-Bernier, proprietario del Domaine Monin, viticoltore, vendemmiatore e mastro casaro, vi accoglie nella sua cantina di degustazione AB-BIO nel cuore del villaggio di Vongnes, dove potrete scoprire tutta la sua gamma di vini."
    ],
    "fr": [
      "Viticulteur-Récoltant et Maitre artisan affineur fromager, Charles Varin-Bernier, propriétaire du Domaine Monin, vous accueille dans son caveau de dégustation, pour la découverte de l'ensemble de sa gamme de vins, au milieu du village, à Vongnes, AB-BIO."
    ],
    "es": [
      "Charles Varin-Bernier, propietario del Domaine Monin, viticultor, cosechero y maestro quesero, le da la bienvenida a su bodega de degustación AB-BIO, situada en el centro del pueblo de Vongnes, donde podrá descubrir toda su gama de vinos."
    ],
    "nl": [
      "Charles Varin-Bernier, eigenaar van Domaine Monin, is wijnbouwer, oogster en meester-kaasmaker. Hij heet je welkom in zijn AB-BIO proefkelder midden in het dorp Vongnes, waar je zijn hele wijnassortiment kunt ontdekken."
    ]
  },
