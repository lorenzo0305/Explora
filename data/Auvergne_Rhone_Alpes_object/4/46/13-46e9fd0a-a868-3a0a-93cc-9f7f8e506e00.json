  "rdfs:comment": {
    "de": [
      "Sechs mal pro Jahr wechselt die komplette Speisekarte, um dem Rhythmus der Saisons zu folgen. Unsere Menüs werden jede Woche erneuert."
    ],
    "en": [
      "Get away from it all at lunchtime and enjoy refined cuisine that follows the rhythm of the seasons. Menus are renewed on a weekly basis."
    ],
    "it": [
      "La carta viene interamente cambiata sei volte all'anno per seguire il ritmo delle stagioni e i nostri menù vengono rinnovati ogni settimana."
    ],
    "fr": [
      "Le changement complet de carte se fait six fois par an pour suivre le rythme des saisons et nos menus sont renouvelés chaque semaine."
    ],
    "es": [
      "La carta cambia por completo seis veces al año para seguir el ritmo de las temporadas, y nuestros menús se renuevan cada semana."
    ],
    "nl": [
      "Het hele menu wordt zes keer per jaar aangepast aan de seizoenen en onze menu's worden elke week vernieuwd."
    ]
  },
