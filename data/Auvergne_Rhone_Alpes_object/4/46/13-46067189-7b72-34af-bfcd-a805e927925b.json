  "rdfs:comment": {
    "de": [
      "Tricococréation und La Pépite d'Or: Kreative Maschen und Schätze aus vergangenen Zeiten. Willkommen in unserem gemeinsamen Raum im Herzen von Arvant, wo Kunsthandwerk auf Secondhand trifft. Dieser Ort bietet Ihnen ein ethisches, kreatives und freundliches Einkaufserlebnis."
    ],
    "en": [
      "Tricococréation and la Pépite d'Or: Creative knits and treasures of yesteryear. Welcome to our shared space in the heart of Arvant, where arts and crafts meet second-hand. We offer you an ethical, creative and friendly shopping experience."
    ],
    "it": [
      "Tricocréation e la Pépite d'Or: maglieria creativa e tesori d'altri tempi. Benvenuti nel nostro spazio condiviso nel cuore di Arvant, dove l'artigianato incontra l'usato. Questo luogo vi offre un'esperienza di shopping etico, creativo e amichevole."
    ],
    "fr": [
      "Tricococréation et la Pépite d'Or: Mailles créatives et trésors d'autrefois. Bienvenu dans notre espace partagé au cœur d'Arvant, où l'artisanat d'art rencontre la seconde main. Ce lieu vous offre une expérience shopping éthique, créative et conviviale."
    ],
    "es": [
      "Tricococréation y la Pépite d'Or: tejidos creativos y tesoros de antaño. Bienvenido a nuestro espacio compartido en el corazón de Arvant, donde el arte y la artesanía se encuentran con los artículos de segunda mano. Este lugar le ofrece una experiencia de compra ética, creativa y acogedora."
    ],
    "nl": [
      "Tricococréation en la Pépite d'Or: creatieve breisels en schatten van vroeger. Welkom in onze gemeenschappelijke ruimte in het hart van Arvant, waar kunst en ambacht hand in hand gaan met tweedehands goederen. Deze plek biedt je een ethische, creatieve en vriendelijke winkelervaring."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tricococréation"
    ]
  },
