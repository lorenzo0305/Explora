  "rdfs:comment": {
    "de": [
      "Genießen Sie mit Ihrer Familie das Rodelstadion Lou Madeliot, eine gesicherte und angelegte Piste mit einem überdachten Teppich für den Aufstieg!"
    ],
    "en": [
      "Secure sled stadium with covered carpet. Fee payable. \r\nOpening info on sledge areas on Sancy.com \r\nFor all requests for information, thank you to send an email or via the chatbox on the dedicated website."
    ],
    "it": [
      "Venite a divertirvi con tutta la famiglia allo stadio dello slittino Lou Madeliot, con una pista sicura e attrezzata e un impianto di risalita coperto!"
    ],
    "fr": [
      "Venez profiter en famille du stade de luge Lou Madeliot, une piste sécurisée et aménagée avec un tapis couvert pour la remontée !"
    ],
    "es": [
      "Ven a disfrutar con toda la familia del estadio de trineo Lou Madeliot, con su pista segura y totalmente equipada y su ascensor cubierto"
    ],
    "nl": [
      "Kom met het hele gezin genieten van het Lou Madeliot rodelstadion, met zijn veilige, volledig uitgeruste baan en overdekte lift!"
    ]
  },
