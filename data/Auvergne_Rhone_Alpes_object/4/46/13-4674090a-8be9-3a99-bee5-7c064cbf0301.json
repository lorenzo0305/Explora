  "rdfs:comment": {
    "de": [
      "Herstellung von hausgemachten Keksen. Lebensmittelgeschäft, Konditorei, Kaffeerösterei, Bar und Teesalon. Freizeitworkshops jeden Monat zum Thema \"selbstgemacht\" und \"0 Abfall\". Kostenloser Strick- und Nähtee-Treff am Donnerstagnachmittag."
    ],
    "en": [
      "Home-made biscuits. Grocery shop, patisserie, roastery, bar and tearoom. Monthly workshops on homemade and 0-waste products. Free knitting and sewing sessions on Thursday afternoons."
    ],
    "it": [
      "Biscotti fatti in casa. Negozio di alimentari, pasticceria, torrefazione, bar e sala da tè. Laboratori mensili su prodotti fatti in casa e a zero rifiuti. Sessioni gratuite di maglia e cucito il giovedì pomeriggio."
    ],
    "fr": [
      "Fabrication de biscuits maison. Epicerie, pâtisserie, torréfaction, bar et salon de thé. Ateliers loisirs tous les mois sur le \"fait maison\" et le 0 déchet. Rencontre tricot thé couture gratuit les jeudis après-midis."
    ],
    "nl": [
      "Zelfgemaakte koekjes. Kruidenierswinkel, patisserie, branderij, bar en tearoom. Maandelijkse workshops over zelfgemaakte en 0-afvalproducten. Gratis brei- en naaisessies op donderdagmiddag."
    ],
    "es": [
      "Galletas caseras. Tienda de comestibles, pastelería, asador, bar y salón de té. Talleres mensuales sobre productos caseros y de residuo cero. Sesiones gratuitas de punto y costura los jueves por la tarde."
    ]
  },
  "rdfs:label": {
    "en": [
      "Delicatessen Aux Délices de Babette"
    ],
    "fr": [
      "Epicerie fine Aux Délices de Babette"
    ]
  },
