  "rdfs:comment": {
    "de": [
      "Das Restaurant soll gesellig und familiär sein und lokale Produkte verwenden. Wir bieten Ihnen abends gastronomische und mittags bistronomische Gerichte an."
    ],
    "en": [
      "Villa Augusta offers gourmet cuisine with a chic and relaxed ambiance. \r\nChef Esteban Christin made a point of working with seasonal products, carefully selecting ingredients from local producers."
    ],
    "it": [
      "Villa Augusta offre una cucina gourmet in un'atmosfera chic e rilassata.\r\nClément Debilly si fa un punto d'onore di lavorare con prodotti di stagione, selezionando con cura gli ingredienti dei produttori locali."
    ],
    "fr": [
      "La Villa Augusta propose une cuisine gastronomique dans une ambiance chic et décontractée. \r\nClément Debilly met un point d'honneur à travailler avec des produits de saison, en sélectionnant minutieusement des ingrédients issus des producteurs locaux."
    ],
    "es": [
      "Villa Augusta ofrece cocina gourmet en un ambiente elegante y relajado.\r\nPara Clément Debilly es un honor trabajar con productos de temporada, seleccionando cuidadosamente los ingredientes de los productores locales."
    ],
    "nl": [
      "Het restaurant is ontworpen om vriendelijk en gezinsvriendelijk te zijn, met gebruik van lokale producten. We bieden 's avonds een gastronomisch diner en 's middags een bistronomische keuken."
    ]
  },
