      "@id": "https://data.datatourisme.fr/d0b1df59-ab5e-3e33-be7e-32459495c121",
      "dc:description": {
        "de": [
          "Zucht, Pension, Dressur, Fortbildungslehrgang, Show und Westernreiten. Empfang von Einzelpersonen und Gruppen das ganze Jahr über nach Vereinbarung von 10.00 bis 12.00 Uhr und von 14.00 bis 18.00 Uhr."
        ],
        "en": [
          "Breeding, boarding, dressage, advanced training, show and western. Individuals and groups welcome all year round by appointment from 10:00 to 12:00 and from 14:00 to 18:00."
        ],
        "it": [
          "Allevamento, pensione, dressage, addestramento avanzato, show e western. Singoli e gruppi sono benvenuti tutto l'anno su appuntamento dalle 10.00 alle 12.00 e dalle 14.00 alle 18.00."
        ],
        "fr": [
          "Elevage, pension, dressage, formation de perfectionnement, spectacle et western. Accueil individuel et groupe toute l'année sur rendez-vous de 10h00 à 12h00 et de 14h00 à 18h00."
        ],
        "nl": [
          "Fokkerij, pensionstalling, dressuur, gevorderde training, show en western. Individuen en groepen zijn het hele jaar door welkom op afspraak van 10.00 tot 12.00 uur en van 14.00 tot 18.00 uur."
        ],
        "es": [
          "Cría, pupilaje, doma, adiestramiento avanzado, show y western. Particulares y grupos bienvenidos todo el año con cita previa de 10h a 12h y de 14h a 18h."
        ]
      },
