  "rdfs:comment": {
    "de": [
      "Dorf Auvers: Kirche aus dem 19. und 20. Jahrhundert. Jahrhundert. Mehrere Kreuze in Nozeyrolles und am Eingang der Dörfer Auvers, Chanteloube und Lair."
    ],
    "en": [
      "Village of Auvers: 19th- and 20th-century church. Several crosses at Nozeyrolles and at the entrances to the villages of Auvers, Chanteloube and Lair."
    ],
    "it": [
      "Villaggio di Auvers: chiesa del XIX e XX secolo. Diverse croci a Nozeyrolles e all'ingresso dei villaggi di Auvers, Chanteloube e Lair."
    ],
    "fr": [
      "Village d'Auvers : Église des XIXe et XXe siècles. Plusieurs croix à Nozeyrolles et à l’entrée des villages d’Auvers, Chanteloube et Lair."
    ],
    "es": [
      "Pueblo de Auvers: iglesia de los siglos XIX y XX. Varias cruces en Nozeyrolles y a la entrada de los pueblos de Auvers, Chanteloube y Lair."
    ],
    "nl": [
      "Dorp Auvers: kerk uit de 19e en 20e eeuw. Verschillende kruisen in Nozeyrolles en bij de ingang van de dorpen Auvers, Chanteloube en Lair."
    ]
