  "rdfs:comment": {
    "de": [
      "Kinderbereich (Ronaldland). Kostenloses und unbegrenztes WLAN. Bestellterminals im Speisesaal. Frühstück. Mc Café von 7:30 bis 21:30 Uhr geöffnet."
    ],
    "en": [
      "Kids' play area (Ronaldland). Unlimited free wifi. Order your meal from the terminal in the restaurant. Breakfast available. The McCafé is open from 8:00 am to 9:30 pm."
    ],
    "it": [
      "Area bambini (Ronaldland). Wifi gratuito e illimitato. Terminali di controllo nella sala. La colazione è disponibile. Mc Café aperto dalle 7.30 alle 21.30."
    ],
    "fr": [
      "Espace enfants (Ronaldland). Wifi gratuit et illimité. Bornes de commandes en salle. Petit déjeuner. Mc Café ouvert de 7h30 à 21h30."
    ],
    "es": [
      "Zona infantil (Ronaldland). Wifi gratuito e ilimitado. Terminales de control en la sala. El desayuno está disponible. Mc Café abierto de 7.30 a 21.30."
    ],
