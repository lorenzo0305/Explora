  "rdfs:comment": {
    "de": [
      "Bei einem Rundgang durch den Teich können Sie ungewöhnliche Holzskulpturen entdecken. Sie wurden von Holzkünstlern während der traditionellen Feste des Bois de Sainte-Christine geschaffen."
    ],
    "en": [
      "The tour of the pond allows you to discover atypical wooden sculptures. They were created by wood artists during the traditional festivals of the Bois de Sainte-Christine."
    ],
    "it": [
      "Il tour del laghetto permette di scoprire sculture in legno atipiche. Sono stati creati da artisti del legno durante le feste tradizionali del Bois de Sainte-Christine."
    ],
    "fr": [
      "Le tour de l’étang permet de découvrir des sculptures en bois atypiques. Elles ont été créées par des artistes du bois lors des traditionnelles fêtes du Bois de Sainte-Christine."
    ],
    "nl": [
      "Tijdens de rondleiding door de vijver kunt u atypische houten beelden ontdekken. Ze zijn gemaakt door houtkunstenaars tijdens de traditionele feesten van het Bois de Sainte-Christine."
    ],
    "es": [
      "El recorrido por el estanque permite descubrir esculturas de madera atípicas. Fueron creados por artistas de la madera durante las fiestas tradicionales del Bois de Sainte-Christine."
    ]
  },
  "rdfs:label": {
    "en": [
      "Land Art Etang des Planches"
    ],
    "fr": [
      "Land Art Étang des Planches"
    ]
  },
