  "rdfs:comment": {
    "de": [
      "4-Sterne-Hotel, das 2015 vollständig renoviert wurde. Es befindet sich in Thiers, der Hauptstadt der Messerschmiedekunst, und ist 2 km von der Ausfahrt Nr. 29 entfernt. Kostenlose Wi-Fi-Verbindung in den Räumlichkeiten. Restaurant, Bar, von Bäumen gesäumter Park. Massagen können nach vorheriger Reservierung organisiert werden."
    ],
    "en": [
      "The Clos St Eloi is a 4-star hotel restaurant completely renovated in 2015. Located in Thiers cutlery capital it is 2 km from exit 29 of the A89 motorway. Free wi-fi connection in all premises. Restaurant, bar, tree-lined park. Massages can be arranged by reservation."
    ],
    "it": [
      "Hotel 4 stelle completamente rinnovato nel 2015. Situato a Thiers, la capitale delle posate, si trova a 2 km dall'uscita 29. Connessione Wi-Fi gratuita in loco. Ristorante, bar, parco alberato. Massaggi su richiesta."
    ],
    "fr": [
      "Hôtel 4 étoiles entièrement rénové en 2015. Situé à Thiers capitale de la coutellerie il est à 2km de la sortie n°29. Connexion Wi-Fi gratuite dans les locaux. Restaurant, bar, parc bordé d'arbres. Des massages peuvent être organisés sur réservation."
    ],
    "nl": [
      "Viersterrenhotel volledig gerenoveerd in 2015. Het ligt in Thiers, de bestekhoofdstad, op 2 km van afrit 29. Gratis Wi-Fi-verbinding op het terrein. Restaurant, bar, park met bomen. Massages kunnen op verzoek geregeld worden."
    ],
    "es": [
      "Hotel de 4 estrellas completamente renovado en 2015. Situado en Thiers, la capital de la cuchillería, está a 2 km de la salida 29. Conexión Wi-Fi gratuita en las instalaciones. Restaurante, bar, parque arbolado. Se pueden organizar masajes bajo petición."
    ]
  },
  "rdfs:label": {
