  "rdfs:comment": {
    "de": [
      "Unumgänglicher Ort und Naturwunder in der Auvergne-Rhône-Alpes. Entdecken Sie diesen spektakulären Canyon, in dem man sich auf einem in den Felsen befestigten Steg 25 m über dem Fluss fortbewegt."
    ],
    "en": [
      "A must-see site and a natural wonder in the Auvergne-Rhône-Alpes region. Come and discover this spectacular canyon, where you advance on a footbridge fixed in the rock 25m above the river."
    ],
    "it": [
      "Una visita indimenticabile in famiglia o in gruppo. Venite a scoprire questo canyon spettacolare, incamminandovi su una passerella nella roccia a 25 m dal fiume."
    ],
    "fr": [
      "Site incontournable et prodige de la nature en Auvergne-Rhône-Alpes. Venez découvrir ce canyon spectaculaire où l’on avance sur une passerelle fixée dans la roche à 25m au-dessus de la rivière."
    ],
    "es": [
      "Un lugar imprescindible y una maravilla natural en Auvernia-Ródano-Alpes. Venga a descubrir este espectacular cañón donde se camina sobre una pasarela fijada en la roca a 25 m por encima del río."
    ],
    "nl": [
      "Een onvergetelijk bezoek met het gezin of met een groep. Kom deze spectaculaire canyon ontdekken waar u over een brug loop die aan de rots is bevestigd, op 25 m boven de rivier."
    ]
  },
