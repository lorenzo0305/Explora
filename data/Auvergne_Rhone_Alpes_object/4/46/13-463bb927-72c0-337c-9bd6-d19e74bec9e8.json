  "rdfs:comment": {
    "de": [
      "Der größte Flug der 3 Vallées mit einem Tandem-Gleitschirm. Flug mit einem einzigartigen Panorama auf den Mont Blanc, der schönste Ausblick Courchevels."
    ],
    "ru": [
      "Самый длительный тандемный полет на параплане над Тремя Долинами. Полет с уникальной панорамой на Монблан, самой красивой в Куршевеле."
    ],
    "en": [
      "We offer the biggest tandem paragliding flight in the 3 Valleys. It's THE flight with a unique panorama of Mont Blanc, undoubtedly the most beautiful in Courchevel."
    ],
    "it": [
      "Il più grande volo di Les Trois Vallées in parapendio in tandem. Volo che offre un panorama unico sul Monte Bianco, il più bello di Courchevel."
    ],
    "fr": [
      "Nous proposons le plus grand vol des 3 Vallées en parapente tandem. C'est LE vol avec un panorama unique sur le mont Blanc, assurément le plus beau de Courchevel."
    ],
    "nl": [
      "Wij bieden de grootste tandem paragliding vlucht in de 3 Vallées. Het is DE vlucht met een uniek panorama op de Mont Blanc, ongetwijfeld de mooiste in Courchevel."
    ],
    "es": [
      "El vuelo más grande de Les 3 Vallées en parapente tándem. Vuelo con un panorama único del Mont Blanc, el más bonito de Courchevel."
    ]
  },
