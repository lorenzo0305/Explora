  "rdfs:comment": {
    "de": [
      "La Cafetera Roja lehnt Etiketten ab, sie sind nicht Rock, nicht Trip Hop, nicht Reggae, nicht Chanson, nicht Jazz, nicht Latin, ihr Gloubiboulga hat die Zeit gekocht, der ?globale Sound' ist eingeflossen\r\ndie Sprache haben sie sich selbst ausgedacht."
    ],
    "en": [
      "La Cafetera Roja refuses to be labeled. They're not rock, trip hop, reggae, chanson, jazz or Latino\r\ntheir language, they've invented it for themselves."
    ],
    "it": [
      "La Cafetera Roja rifiuta di essere etichettata: non è rock, trip hop, reggae, chanson, jazz o latina\r\nhanno inventato il loro linguaggio."
    ],
    "fr": [
      "La Cafetera Roja, c’est le refus des étiquettes, ils ne sont pas rock, pas trip hop, pas reggae, pas chanson, pas jazz, pas latino, leur gloubiboulga, c’est le temps qui l’a mijoté, la “sono\r\nmondiale” s’y est invitée, leur langage, ils se le sont inventé."
    ],
    "nl": [
      "La Cafetera Roja weigert een etiket opgeplakt te krijgen. Ze zijn geen rock, trip hop, reggae, chanson, jazz of latino\r\nze hebben hun eigen taal uitgevonden."
    ],
    "es": [
      "La Cafetera Roja se niega a ser etiquetada. No son rock, ni trip hop, ni reggae, ni chanson, ni jazz, ni latinos\r\nhan inventado su propio lenguaje."
    ]
  },
  "rdfs:label": {
    "fr": [
      "\"My path\" La cafetera roja"
    ]
  },
