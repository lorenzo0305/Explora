  "rdfs:comment": {
    "de": [
      "Im Südosten des Departements Haute-Loire, 50 km von Le Puy-en-Velay und Saint-Etienne entfernt. Unser Gebiet grenzt an das Departement Ardèche und umfasst die Gemeinden Chenereilles, Le Chambon-sur-Lignon, Le Mas de Tence, Le Mazet Saint-Voy, Saint-Jeures und Tence"
    ],
    "en": [
      "South-east of the Haute-Loire département, 50 km from Le Puy-en-Velay and Saint-Etienne. Our territory borders the Ardèche and includes the communes of Chenereilles, Le Chambon-sur-Lignon, Le Mas de Tence, Le Mazet Saint-Voy, Saint-Jeures and Tence"
    ],
    "it": [
      "A sud-est del dipartimento dell'Alta Loira, a 50 km da Le Puy-en-Velay e Saint-Etienne. La nostra regione confina con l'Ardèche e comprende i comuni di Chenereilles, Le Chambon-sur-Lignon, Le Mas de Tence, Le Mazet Saint-Voy, Saint-Jeures e Tence"
    ],
    "fr": [
      "Sud Est du département de la Haute-Loire, à 50 kms du Puy-en-Velay et Saint-Etienne. Notre territoire est limitrophe avec l’Ardèche et regroupe les communes de Chenereilles, Le Chambon-sur-Lignon, Le Mas de Tence, Le Mazet Saint-Voy, Saint-Jeures et Tence"
    ],
    "nl": [
      "Ten zuidoosten van het departement Haute-Loire, op 50 km van Le Puy-en-Velay en Saint-Etienne. Onze streek grenst aan de Ardèche en omvat de gemeenten Chenereilles, Le Chambon-sur-Lignon, Le Mas de Tence, Le Mazet Saint-Voy, Saint-Jeures en Tence"
    ],
    "es": [
      "Al sureste del departamento de Haute-Loire, a 50 km de Le Puy-en-Velay y Saint-Etienne. Nuestra región limita con Ardèche e incluye los municipios de Chenereilles, Le Chambon-sur-Lignon, Le Mas de Tence, Le Mazet Saint-Voy, Saint-Jeures y Tence"
    ]
  },
