  "rdfs:comment": {
    "de": [
      "Le Carré Gourmand empfängt Sie vom Frühstück bis zum Mittagessen und nicht zu vergessen den Nachmittagssnack. Wir bieten Ihnen eine große Auswahl an hausgemachten Gerichten und Desserts aus lokalen Produkten sowie zahlreiche Leckereien, darunter Crêpes und Waffeln."
    ],
    "en": [
      "Le Carré Gourmand welcomes you for breakfast, lunch and afternoon tea. We offer a wide choice of homemade dishes and desserts made with local produce, as well as a range of delicacies including crêpes and waffles."
    ],
    "it": [
      "Le Carré Gourmand vi accoglie dalla colazione al pranzo, senza dimenticare lo spuntino pomeridiano. Offriamo un'ampia scelta di piatti e dolci fatti in casa con prodotti locali, e molte prelibatezze tra cui pancake e waffle."
    ],
    "fr": [
      "Le Carré Gourmand vous accueille du petit déjeuner au déjeuner sans oublier le goûter. Nous vous proposons un large choix de plats et de desserts faits maison avec des produits locaux, et de nombreuses gourmandises dont des crêpes et des gaufres."
    ],
    "nl": [
      "Le Carré Gourmand serveert ontbijt, lunch en snacks. We bieden een ruime keuze aan huisgemaakte gerechten en desserts gemaakt met lokale producten, evenals een reeks zoete lekkernijen waaronder crêpes en wafels."
    ],
    "es": [
      "Le Carré Gourmand le da la bienvenida desde el desayuno hasta el almuerzo, sin olvidar la merienda. Le ofrecemos una amplia selección de platos y postres caseros elaborados con productos locales, así como numerosas delicias entre las que destacan las tortitas y los gofres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marques Avenue - Carré Gourmand"
    ]
  },
