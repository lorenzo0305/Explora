  "rdfs:comment": {
    "de": [
      "Holz- und Bronzebildhauer (im Ruhestand)\r\nDer lokale Künstler Serge Couvert hat im Wald von Monolithe zwischen Aussois und Sardières einen Rundgang mit 24 Skulpturen geschaffen.\r\nDauer des Besuchs: ca. zwei Stunden Fußmarsch. Freier Zugang."
    ],
    "en": [
      "Wood and bronze sculptor (retired)\r\nLocal artist Serge Couvert has created a trail of twenty-four sculptures in the Monolithe forest, between Aussois and Sardières.\r\nLength of visit: approx. two hours' walk. Free access."
    ],
    "it": [
      "Scultore del legno e del bronzo (in pensione)\r\nL'artista locale Serge Couvert ha creato un percorso di ventiquattro sculture nella foresta della Monolithe, tra Aussois e Sardières.\r\nDurata della visita: circa due ore di cammino. Accesso libero."
    ],
    "fr": [
      "Sculpteur sur bois et bronze (retraité)\r\nArtiste local, Serge Couvert a créé un parcours de vingt-quatre sculptures dans la forêt du Monolithe, entre Aussois et Sardières.\r\nDurée de la visite: environ deux heures de marche. Accès libre."
    ],
    "es": [
      "Escultor en madera y bronce (jubilado)\r\nEl artista local Serge Couvert ha creado un recorrido de veinticuatro esculturas en el bosque de Monolithe, entre Aussois y Sardières.\r\nDuración de la visita: unas dos horas a pie. Entrada gratuita."
    ],
    "nl": [
      "Beeldhouwer van hout en brons (gepensioneerd)\r\nDe plaatselijke kunstenaar Serge Couvert heeft een parcours van vierentwintig sculpturen aangelegd in het bos van Monolithe tussen Aussois en Sardières.\r\nDuur van het bezoek: ongeveer twee uur wandelen. Gratis toegang."
    ]
  },
