  "rdfs:comment": {
    "de": [
      "Das Hotel liegt in ruhiger Lage der Alpen in Bellevaux, 23 km vom Genfer See entfernt. Im Winter schnallt man sich vor dem Hotel die Skier an die Füße und schwingt sich auf die Pisten der Savoyer Alpen."
    ],
    "en": [
      "Located in the heart of Hirmentaz ski resort, find all the comfort you need in a 3-stars hotel, in a warm and friendly atmosphere."
    ],
    "it": [
      "A Bellevaux, l’hotel si trova nella calma degli alpeggi a 23 km dal lago Lemano. In inverno si mettono gli sci davanti all'hotel per lanciarsi lungo le piste del massiccio delle Alpi del Lemano."
    ],
    "fr": [
      "Niché au coeur de la station d’Hirmentaz vous trouverez tout le confort d’un établissement 3 étoiles dans un cadre chaleureux où règne une ambiance familiale."
    ],
    "nl": [
      "Genesteld in het hart van het resort Hirmentaz, vindt u alle comfort van een 3-sterren etablissement in een warme en familiale sfeer."
    ],
    "es": [
      "Enclavado en el corazón de la estación de Hirmentaz, encontrará todas las comodidades de un establecimiento de 3 estrellas en un ambiente cálido y familiar."
    ]
  },
