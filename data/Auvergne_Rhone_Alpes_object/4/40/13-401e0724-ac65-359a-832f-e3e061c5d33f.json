  "rdfs:comment": {
    "de": [
      "Willkommen, Teilen und Entdecken sind die Schlüsselwörter, die Marjorie und Edouard Ihnen in der Auberge de la Source bieten. Hier können Sie neue Energie tanken und ein Erlebnis erleben, Erinnerungen schaffen und erzählen."
    ],
    "en": [
      "Welcome, Sharing and Discovery are the key words that Marjorie and Edouard offer you to experience at the Auberge de la Source. Here you can recharge your batteries and have an experience to create and tell memories."
    ],
    "it": [
      "Accoglienza, condivisione e scoperta sono le parole d'ordine che Marjorie ed Edouard vi invitano a sperimentare all'Auberge de la Source. Qui potrete fare il pieno di energia e vivere un'esperienza che vi aiuterà a creare e condividere ricordi."
    ],
    "fr": [
      "Accueil, Partage et Découverte sont les maîtres mots que Marjorie et Edouard vous proposent de vivre à l’Auberge de la Source. Ici, vous pouvez vous ressourcer et vivre une expérience pour créer des souvenirs et les raconter."
    ],
    "nl": [
      "Welkom, delen en ontdekken zijn de sleutelwoorden waarmee Marjorie en Edouard je uitnodigen in de Auberge de la Source. Hier kun je nieuwe energie opdoen en genieten van een ervaring die je zal helpen herinneringen te creëren en te delen."
    ],
    "es": [
      "Acoger, compartir y descubrir son las palabras clave que Marjorie y Edouard le invitan a vivir en el Auberge de la Source. Aquí podrá recargar las pilas y disfrutar de una experiencia que le ayudará a crear y compartir sus recuerdos."
    ]
  },
