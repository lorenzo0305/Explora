  "rdfs:comment": {
    "de": [
      "Die Keramikerin Elisa Sabatier lädt Sie ein, ihr Atelier zu besichtigen (ohne Voranmeldung)! Sie wird Ihnen möglicherweise eine Vorführung des Drehens (Töpferscheibe) anbieten."
    ],
    "en": [
      "Ceramist Elisa Sabatier invites you to discover her workshop (no appointment necessary)! She'll be happy to give you a potter's wheel demonstration."
    ],
    "it": [
      "La ceramista Elisa Sabatier vi invita a visitare il suo laboratorio (senza appuntamento)! Sarà lieta di darvi una dimostrazione al tornio."
    ],
    "fr": [
      "Elisa Sabatier, céramiste, vous invite à découvrir son atelier (sans rendez-vous) ! Elle pourra vous proposer une démonstration de tournage (tour de potier)."
    ],
    "es": [
      "La ceramista Elisa Sabatier le invita a visitar su taller (sin cita previa) Estará encantada de hacerle una demostración en el torno alfarero."
    ],
    "nl": [
      "Keramist Elisa Sabatier nodigt je uit voor een bezoek aan haar atelier (geen afspraak nodig)! Ze geeft je graag een demonstratie op de pottenbakkersschijf."
    ]
  },
  "rdfs:label": {
