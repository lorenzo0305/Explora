      "@id": "https://data.datatourisme.fr/b9373874-9cac-3ba2-8f7c-86305891aaa1",
      "dc:description": {
        "de": [
          "Entre 2 B kümmert sich um alles: vom Empfang der Reisenden über die Verwaltung der Reservierungen bis hin zur Instandhaltung Ihrer Unterkunft."
        ],
        "en": [
          "Entre 2 B takes care of everything, from welcoming travelers to managing reservations and maintaining your accommodation."
        ],
        "it": [
          "Entre 2 B si occupa di tutto, dall'accoglienza dei viaggiatori alla gestione delle prenotazioni e alla cura del vostro alloggio."
        ],
        "fr": [
          "Entre 2 B s'occupe de tout : de l'accueil des voyageurs à l'entretien de votre logement, en passant par la gestion des réservations."
        ],
        "nl": [
          "Entre 2 B zorgt voor alles, van het verwelkomen van reizigers tot het beheren van boekingen en het verzorgen van je accommodatie."
        ],
        "es": [
          "Entre 2 B se encarga de todo, desde dar la bienvenida a los viajeros hasta gestionar las reservas y ocuparse de su alojamiento."
        ]
      },
