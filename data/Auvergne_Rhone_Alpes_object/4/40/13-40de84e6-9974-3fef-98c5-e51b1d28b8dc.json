  "rdfs:comment": {
    "de": [
      "In 892 m Höhe, im Herzen des Ortes, bietet Ihnen die Ferme-Auberge eine traditionelle Küche mit Produkten vom Bauernhof aus eigener Zucht oder von benachbarten Bauernhöfen, Milchkalbfleisch und hausgemachte Wurstwaren."
    ],
    "en": [
      "At an altitude of 892m, in the heart of the village, the farm hostel offers traditional cuisine based on farm products from their own or neighbouring farms, milk-fed veal and home-made charcuterie."
    ],
    "it": [
      "A 892 m di altitudine, nel cuore del villaggio, l'ostello della fattoria offre una cucina tradizionale a base di prodotti agricoli provenienti dalla propria fattoria o da quelle vicine, carne di vitello alimentata con latte e salumi fatti in casa."
    ],
    "fr": [
      "A 892m d'altitude, en plein cœur du bourg, la ferme-auberge vous propose une cuisine traditionnelle à base de produits fermiers issus de leur élevage ou des fermes avoisinantes, veau de lait et charcuterie maison."
    ],
    "nl": [
      "Op een hoogte van 892 m, in het hart van het dorp, biedt de herberg van de boerderij een traditionele keuken op basis van producten van de eigen of naburige boerderijen, met melk gevoed kalfsvlees en zelfgemaakte vleeswaren."
    ],
    "es": [
      "A 892 m de altitud, en el corazón del pueblo, el albergue agrícola ofrece una cocina tradicional basada en productos agrícolas de sus propias granjas o de las vecinas, ternera alimentada con leche y charcutería casera."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme-auberge Linossier"
    ]
  },
