  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Welt der hausgemachten Burger im Burger Toqué, Ihrer unumgänglichen Adresse in Les Vans, in der Ardèche. Bei uns ist jeder Burger eine einzigartige Kreation, die von unserem Chefkoch mit Leidenschaft und Know-how zubereitet wird."
    ],
    "en": [
      "Immerse yourself in the world of homemade burgers at Burger Toqué, your must-try address in Les Vans, Ardèche. At Burger Toqué, every burger is a unique creation, crafted with passion and expertise by our head chef."
    ],
    "it": [
      "Immergetevi nel mondo degli hamburger fatti in casa al Burger Toqué, il vostro indirizzo imperdibile a Les Vans, in Ardèche. Al Burger Toqué, ogni hamburger è una creazione unica, creata con passione e competenza dal nostro capo chef."
    ],
    "fr": [
      "Plongez dans l’univers du burger fait maison au Burger Toqué, votre adresse incontournable à Les Vans, en Ardèche. Chez nous, chaque burger est une création unique, élaborée avec passion et savoir-faire par notre chef cuisinier."
    ],
    "es": [
      "Sumérjase en el universo de las hamburguesas caseras en Burger Toqué, su dirección ineludible en Les Vans, Ardèche. En Burger Toqué, cada hamburguesa es una creación única, creada con pasión y maestría por nuestro jefe de cocina."
    ],
    "nl": [
      "Dompel jezelf onder in de wereld van huisgemaakte hamburgers bij Burger Toqué, jouw must-try adres in Les Vans, Ardèche. Bij Burger Toqué is elke burger een unieke creatie, met passie en expertise gemaakt door onze chef-kok."
    ]
  },
