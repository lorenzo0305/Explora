  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5ef46bc9-04b9-3a05-9564-1983e68ac431",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\nMontag bis Freitag von 9:00 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\nSamstags durchgehend von 9:00 bis 15:30 Uhr\n\nSonntags geschlossen\n \n Abholung:\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Friday, 9am to 12:30pm and 2pm to 7pm\nSaturday 9am to 3:30pm non-stop\n\nClosed on Sunday\n \n Pick-up :\nDuring opening hours of the pharmacy\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrari di apertura :\nDal lunedì al venerdì, dalle 9.00 alle 12.30 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 15.30 senza interruzioni\n\nChiuso la domenica\n \n Ritiro:\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu lundi au vendredi de 9h à 12h30 et de 14h à 19h\nLe samedi de 9h à 15h30 sans interruption\n\nFermeture le dimanche\n \n Retrait :\nAux horaires d'ouverture de l'officine\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningstijden :\nMaandag tot vrijdag van 9u tot 12u30 en van 14u tot 19u\nZaterdag van 9u tot 15u30 zonder onderbreking\n\nGesloten op zondag\n \n Afhalen:\nTijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nHorarios de apertura :\nDe lunes a viernes de 9h a 12h30 y de 14h a 19h\nSábados de 9h a 15h30 ininterrumpidamente\n\nDomingos cerrado\n \n Recogida:\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
