  "rdfs:comment": {
    "de": [
      "Le Perce Neige ist eine kleine Bar-Brasserie, die seit über 30 Jahren ihr Aushängeschild bewahrt hat. Genießen Sie die Terrasse und lassen Sie sich die frischen, vom Chefkoch hausgemachten Gerichte schmecken."
    ],
    "en": [
      "Le Perce Neige is a small bar-brasserie that has kept its name for over 30 years. Take advantage of the terrace and enjoy fresh, home-cooked dishes prepared by the chef."
    ],
    "it": [
      "Le Perce Neige è un piccolo bar-brasserie che mantiene il suo nome da oltre 30 anni. Godetevi la terrazza e venite a gustare i piatti freschi fatti in casa preparati dallo chef."
    ],
    "fr": [
      "Le Perce Neige est un petit bar-brasserie qui a gardé son enseigne depuis plus de 30 ans. Profitez de la terrasse et venez déguster les plats frais cuisinés maison par le Chef."
    ],
    "nl": [
      "Le Perce Neige is een kleine bar-brasserie die zijn naam al meer dan 30 jaar heeft behouden. Geniet van het terras en kom proeven van de verse huisgemaakte gerechten bereid door de chef-kok."
    ],
    "es": [
      "Le Perce Neige es un pequeño bar-brasserie que conserva su nombre desde hace más de 30 años. Aproveche la terraza y venga a degustar los platos caseros y frescos preparados por el Chef."
    ]
  },
  "rdfs:label": {
