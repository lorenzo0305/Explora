  "rdfs:comment": {
    "de": [
      "Dekorative und Gebrauchskeramik, Skulpturen und Schmuck - Fayence- und Raku-Techniken.\r\nOnline-Workshops über die Website.\r\nGanzjährige Töpferkurse für alle Techniken außer Drehen."
    ],
    "en": [
      "Decorative and utilitarian pottery, sculptures and jewelry - earthenware and raku techniques.\r\nOn-line courses via the website.\r\nYear-round pottery courses in all techniques except throwing."
    ],
    "it": [
      "Ceramiche decorative e utilitarie, sculture e gioielli - tecniche di terracotta e raku.\r\nCorsi on-line tramite il sito web.\r\nCorsi di ceramica durante tutto l'anno in tutte le tecniche, tranne che per il lancio."
    ],
    "fr": [
      "Poteries décoratives et utilitaires, sculptures et bijoux - techniques faïence et raku.\r\nStages  en ligne via le site.\r\nCours de poterie  à l'année toutes techniques sauf tournage."
    ],
    "nl": [
      "Decoratief en gebruiksaardewerk, sculpturen en sieraden - aardewerk en raku-technieken.\r\nOnline cursussen via de website.\r\nHet hele jaar door cursussen pottenbakken in alle technieken behalve werpen."
    ],
    "es": [
      "Cerámica decorativa y utilitaria, esculturas y joyas - técnicas de barro y raku.\r\nCursos en línea a través de la página web.\r\nCursos de alfarería durante todo el año en todas las técnicas, excepto el vaciado."
    ]
  },
