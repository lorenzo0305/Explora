  "rdfs:comment": {
    "de": [
      "Desiline Création ist eine leidenschaftliche Illustratorin, die Ihre persönlichen Porträts zeichnet und mit Mickaël Gesellschaftsspiele entwirft - alles, um schöne und originelle Geschenke für ihre Lieben zu machen."
    ],
    "en": [
      "Desiline Création is a passionate illustrator who draws your personalized portraits and creates board games with Mickaël, everything you need to make beautiful, original gifts for your loved ones."
    ],
    "it": [
      "Desiline Création è un'illustratrice appassionata che disegna i vostri ritratti personalizzati e crea giochi da tavolo con Mickaël, tutto ciò che serve per fare regali belli e originali ai vostri cari."
    ],
    "fr": [
      "Desiline Création c'est une illustratrice passionnée qui dessine vos portraits personnalisés et crée des jeux de société avec Mickaël, tout pour faire de beaux cadeaux originaux à ses proches."
    ],
    "nl": [
      "Desiline Création is een gepassioneerde illustrator die jouw persoonlijke portretten tekent en bordspellen maakt met Mickaël, alles wat je nodig hebt om mooie, originele cadeaus te maken voor je geliefden."
    ],
    "es": [
      "Desiline Création es una ilustradora apasionada que dibuja tus retratos personalizados y crea juegos de mesa con Mickaël, todo lo que necesitas para hacer regalos bonitos y originales a tus seres queridos."
    ]
  },
