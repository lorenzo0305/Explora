  "rdfs:comment": {
    "de": [
      "Ein unprätentiöses Restaurant, in dem man sich gerne mit Freunden trifft. Reichhaltige und gute Gerichte, ein effizienter und lächelnder Service. Was kann man mehr verlangen?"
    ],
    "en": [
      "An unpretentious restaurant where it is good to meet with friends. Copious and good dishes, an efficient and smiling service. What more could you ask for?"
    ],
    "it": [
      "Un ristorante senza pretese dove è bello incontrarsi con gli amici. Cibo abbondante e buono, servizio efficiente e sorridente. Cosa si può chiedere di più?"
    ],
    "fr": [
      "Un restaurant sans prétention où il fait bon de se retrouver entre amis. Des plats copieux et bons, un service efficace et souriant. Que demander de plus ?"
    ],
    "es": [
      "Un restaurante sin pretensiones donde es bueno reunirse con los amigos. Comida abundante y buena, servicio eficiente y sonriente. ¿Qué más se puede pedir?"
    ],
    "nl": [
      "Een pretentieloos restaurant waar het goed toeven is met vrienden. Hartig en goed eten, efficiënte en glimlachende bediening. Wat wil je nog meer?"
    ]
  },
  "rdfs:label": {
