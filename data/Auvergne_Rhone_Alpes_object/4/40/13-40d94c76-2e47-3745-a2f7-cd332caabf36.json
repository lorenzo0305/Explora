  "rdfs:comment": {
    "de": [
      "Bootsfahrt auf dem Kanal von Pont-de-Vaux, der Saône und der Seille bis nach La Truchère und zurück. Passieren Sie die Schleusen von Pont-de-Vaux und La Truchère. Mahlzeiten an Bord."
    ],
    "en": [
      "Departing from the Pont-de-Vaux marina, lunch cruise on the Canal de Pont-de-Vaux, the Saône and the Seille to La Truchère and back. Passage of the Pont-de-Vaux and La Truchère locks. Lunch on board."
    ],
    "it": [
      "Con partenza dal porto turistico di Pont-de-Vaux, crociera con pranzo sul canale di Pont-de-Vaux, la Saona e la Seille fino a La Truchère e ritorno. Passaggio attraverso le chiuse di Pont-de-Vaux e La Truchère. Pranzo a bordo."
    ],
    "fr": [
      "Au départ du port de plaisance de Pont-de-Vaux, croisière déjeuner sur le Canal de Pont-de-Vaux, la Saône et la Seille jusqu'à La Truchère et retour. Passage des écluses de Pont-de-Vaux et La Truchère. Repas à bord."
    ],
    "nl": [
      "Vertrek vanuit de jachthaven van Pont-de-Vaux, lunch op het kanaal van Pont-de-Vaux, de Saône en de Seille naar La Truchère en terug. Doorvaart door de sluizen van Pont-de-Vaux en La Truchère. Lunch aan boord."
    ],
    "es": [
      "Salida del puerto deportivo de Pont-de-Vaux, almuerzo crucero por el canal de Pont-de-Vaux, el Saona y el Seille hasta La Truchère y regreso. Paso por las esclusas de Pont-de-Vaux y La Truchère. Almuerzo a bordo."
    ]
  },
  "rdfs:label": {
    "de": [
