  "rdfs:comment": {
    "de": [
      "OorZone ist die Eventagentur, die Experte für grüne &amp; ökologisch verantwortungsvolle Firmenseminare ist."
    ],
    "en": [
      "OorZone is the expert in green and eco-responsible corporate seminars."
    ],
    "it": [
      "OorZone è l'agenzia di eventi specializzata in seminari aziendali verdi ed eco-responsabili."
    ],
    "fr": [
      "OorZone est le cabinet évènementiel expert des séminaires d’entreprise à impact, éco-responsables.\nConception, organisation et accompagnement de vos évènements d'entreprise à Chamonix, sur mesure."
    ],
    "nl": [
      "OorZone is het evenementenadviesbureau dat gespecialiseerd is in eco-verantwoorde bedrijfsseminars met een hoge impact.\nWij ontwerpen, organiseren en ondersteunen uw op maat gemaakte bedrijfsevenementen in Chamonix."
    ],
    "es": [
      "OorZone es la agencia de eventos especializada en seminarios corporativos verdes y eco-responsables."
    ]
  },
