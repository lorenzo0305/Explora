  "rdfs:comment": {
    "de": [
      "Les Deux Versants liegt im Herzen von Aime 2000 und ist ein gemütliches Bar-Restaurant, in dem man nach dem Skifahren gut essen, gut trinken und eine gute Zeit miteinander verbringen kann."
    ],
    "en": [
      "Located in the heart of Aime 2000, Les Deux Versants is a friendly bar-restaurant where you can enjoy good food, good drinks and a great time after skiing."
    ],
    "it": [
      "Situato nel cuore di Aime 2000, Les Deux Versants è un bar-ristorante accogliente dove si viene a mangiare, bere e condividere il divertimento dopo lo sci."
    ],
    "fr": [
      "Situé au cœur d’Aime 2000, Les Deux Versants est un bar-restaurant convivial où l’on vient bien manger, bien boire et partager un bon moment après le ski."
    ],
    "es": [
      "Situado en el corazón de Aime 2000, Les Deux Versants es un agradable bar-restaurante donde la gente viene a comer, beber y compartir un buen rato después de esquiar."
    ],
    "nl": [
      "Les Deux Versants, gelegen in het hart van Aime 2000, is een gezellige bar-restaurant waar mensen komen om te eten, drinken en een goede tijd te delen na het skiën."
    ]
  },
