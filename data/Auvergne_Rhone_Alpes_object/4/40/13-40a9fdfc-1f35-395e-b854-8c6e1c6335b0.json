  "rdfs:comment": {
    "de": [
      "Ludovic bietet Ihnen die Möglichkeit, Ihr Korbwarenobjekt (Korb, Korb aus Stroh, Bienenstock aus Stroh...) herzustellen. Es besteht die Möglichkeit, seine Objekte auf den Designer- und Kunsthandwerksmärkten der Region wiederzufinden."
    ],
    "en": [
      "Ludovic invites you to come and make your own basketry object (basket, straw basket, straw beehive, etc.). Ludovic's products can also be found at local craft and designer markets."
    ],
    "it": [
      "Ludovic vi invita a venire a realizzare il vostro oggetto di cesteria (cesto, cestino di paglia, alveare di paglia, ecc.). I prodotti di Ludovic si possono trovare anche nei mercati locali di artigianato e design."
    ],
    "fr": [
      "Ludovic vous propose de venir fabriquer votre objet en vannerie (panier, corbeille en paille, ruche en paille...). Possibilité de retrouver ses objets sur les marchés de créateurs, artisanaux de la région."
    ],
    "nl": [
      "Ludovic nodigt je uit om je eigen mandenobject te komen maken (mand, rieten mand, rieten bijenkorf, enz.). De producten van Ludovic zijn ook te vinden op lokale ambachtelijke en designermarkten."
    ],
    "es": [
      "Ludovic le invita a venir y fabricar su propio objeto de cestería (cesta, cesto de paja, colmena de paja, etc.). Los productos de Ludovic también se pueden encontrar en mercados locales de artesanía y diseño."
    ]
  },
