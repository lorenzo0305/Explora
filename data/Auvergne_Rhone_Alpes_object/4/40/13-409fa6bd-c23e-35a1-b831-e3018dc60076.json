  "rdfs:comment": {
    "de": [
      "Les Coutures de Céline bietet Ihnen verschiedene Kreationen (Taschen, Täschchen, Kartenhalter, Geburtsboxen, Kaffeefilter und Teebeutel aus Stoff, wiederverwendbare Malbücher, Schüttgutsäcke...)."
    ],
    "en": [
      "Les Coutures de Céline offers a variety of creations (bags, pouches, card holders, birth boxes, coffee filters and fabric tea bags, reusable coloring books, bulk bags ...)."
    ],
    "it": [
      "Les Coutures de Céline offre una varietà di creazioni (borse, sacchetti, portacarte, scatole per la nascita, filtri per il caffè e bustine per il tè in tessuto, libri da colorare riutilizzabili, borse sfuse, ecc.)"
    ],
    "fr": [
      "Les Coutures de Céline vous propose des créations variées (sacs, pochettes, portes cartes, coffrets naissance, filtres à café et sachets à thé en tissu, albums de coloriage réutilisables, sacs à vrac...)."
    ],
    "es": [
      "Les Coutures de Céline ofrece una gran variedad de creaciones (bolsos, bolsas, tarjeteros, cajas de nacimiento, filtros de café y bolsas de té de tela, libros de colorear reutilizables, bolsas a granel, etc.)."
    ],
    "nl": [
      "Les Coutures de Céline biedt verschillende creaties aan (tassen, zakjes, kaarthouders, geboortedoosjes, stoffen koffiefilters en theezakjes, herbruikbare kleurboeken, bulkzakken, enz.)"
    ]
  },
