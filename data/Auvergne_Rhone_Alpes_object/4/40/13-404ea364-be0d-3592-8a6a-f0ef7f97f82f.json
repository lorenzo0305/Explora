  "rdfs:comment": {
    "de": [
      "ADMR Bugey Colombier bietet seine Dienste in den Bereichen Kinderbetreuung, häusliche Pflege und Betreuung sowie Hilfe für Senioren und Menschen mit Behinderungen an."
    ],
    "en": [
      "ADMR Bugey Colombier offers its services for childcare, home maintenance and care, as well as assistance to senior citizens and the disabled."
    ],
    "it": [
      "L'ADMR Bugey Colombier offre i suoi servizi per la cura dei bambini, la manutenzione e la cura della casa, nonché l'assistenza agli anziani e ai disabili."
    ],
    "fr": [
      "L'ADMR Bugey Colombier propose ses services pour la garde d'enfants, l'entretien et les soins à domicile ainsi que l'aide aux seniors et aux personnes handicapées."
    ],
    "es": [
      "La ADMR Bugey Colombier ofrece sus servicios para el cuidado de los niños, el mantenimiento y el cuidado del hogar, así como la asistencia a las personas mayores y a los discapacitados."
    ],
    "nl": [
      "De ADMR Bugey Colombier biedt zijn diensten aan voor kinderopvang, onderhoud en verzorging van woningen, alsook hulp aan senioren en gehandicapten."
    ]
  },
