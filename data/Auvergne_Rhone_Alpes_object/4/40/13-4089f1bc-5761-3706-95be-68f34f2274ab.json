  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Familienrestaurant mit Bar und Teestube! An schönen Tagen empfängt Sie unsere schattige Terrasse auf dem Dorfplatz. Bei uns ist Genuss eine Tradition, die auf Gastfreundschaft, schönen Tellern und hochwertigen Produkten beruht."
    ],
    "en": [
      "Discover our family restaurant with bar and tea room! On sunny days, our shaded terrace welcomes you on the village square. With us, pleasure is a tradition based on the welcome, beautiful plates and quality products."
    ],
    "it": [
      "Scoprite il nostro ristorante familiare con bar e sala da tè! Con il bel tempo, la nostra terrazza ombreggiata vi accoglie nella piazza del paese. Da noi il piacere è una tradizione basata su un'accoglienza calorosa, buon cibo e prodotti di qualità."
    ],
    "fr": [
      "Découvrez notre restaurant familial avec bar et salon de thé ! Aux beaux jours, notre terrasse ombragée vous accueille sur la place du village. Chez nous, le plaisir est une tradition basée sur l'accueil, de belles assiettes et des produits de qualité."
    ],
    "nl": [
      "Ontdek ons familierestaurant met bar en tearoom! Bij mooi weer heet ons schaduwrijke terras je welkom op het dorpsplein. Bij ons is genieten een traditie gebaseerd op een warm onthaal, lekker eten en kwaliteitsproducten."
    ],
    "es": [
      "Descubra nuestro restaurante familiar con bar y salón de té Cuando hace buen tiempo, nuestra terraza a la sombra le da la bienvenida en la plaza del pueblo. Con nosotros, disfrutar es una tradición basada en una cálida bienvenida, buena comida y productos de calidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Gerbizon"
    ]
  },
