  "rdfs:comment": {
    "de": [
      "Diese Strecke ist ideal für mittlere bis erfahrene Wanderer (recht schwierige Route) und bietet am Gipfel der Seilbahn von Aup de Veran ein Panoramafinale über das gesamte Gebiet."
    ],
    "en": [
      "Ideal for intermediate to advanced hikers (fairly challenging route), this trail offers a panoramic finale overlooking the entire resort at the top of the Aup de Veran gondola."
    ],
    "it": [
      "Questo percorso, ideale per escursionisti di livello intermedio-avanzato (abbastanza difficile), offre un finale panoramico su tutto il comprensorio sciistico in cima alla funivia di Aup de Veran."
    ],
    "fr": [
      "Ce parcours, idéal pour les randonneurs de niveau intermédiaire à confirmé (itinéraire assez difficile), offre un final panoramique sur l'ensemble du domaine au sommet de la télécabine de l'Aup de Veran."
    ],
    "es": [
      "Esta ruta, ideal para excursionistas de nivel intermedio a avanzado (bastante difícil), ofrece un final panorámico sobre toda la zona de esquí en lo alto del teleférico de Aup de Veran."
    ],
    "nl": [
      "Deze route, ideaal voor gemiddelde tot ervaren wandelaars (vrij uitdagend parcours), biedt een panoramische finale met uitzicht over het hele gebied bij het bergstation van de Aup de Veran gondel."
    ]
  },
  "rdfs:label": {
    "en": [
      "Montée du Lapiaz ski touring itinerary"
    ],
    "fr": [
      "Itinéraire de ski de randonnée Montée du Lapiaz"
    ],
    "nl": [
      "Montée du Lapiaz toerskiroute"
    ]
  },
