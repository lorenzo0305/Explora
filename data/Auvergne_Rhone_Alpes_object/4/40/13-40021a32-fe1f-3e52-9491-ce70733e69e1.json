  "rdfs:comment": {
    "de": [
      "La Grande Échelle ist eine Ausstellung des Regionalen Naturparks Livradois-Forez, die vom Kollektiv Carton Plein gestaltet wurde. Sie richtet sich in der ehemaligen Ferienkolonie von Cervières ein, um die Erinnerung an den Ort wieder aufleben zu lassen und seine Zukunft zu hinterfragen."
    ],
    "en": [
      "La Grande Échelle is an exhibition of the Livradois-Forez Regional Nature Park, created by the Carton Plein collective. It takes up residence in the former summer camp at Cervières, reviving the memory of the site and questioning its future."
    ],
    "it": [
      "La Grande Échelle è una mostra organizzata dal Parco Naturale Regionale Livradois-Forez e realizzata dal collettivo Carton Plein. È stata allestita nell'ex campo vacanze di Cervières per far rivivere la memoria del sito e interrogarsi sul suo futuro."
    ],
    "fr": [
      "La Grande Échelle est une exposition du Parc Naturel régional Livradois-Forez, créée par le collectif Carton Plein. Elle s'installe dans l’ancienne colonie de vacances de Cervières pour faire revivre la mémoire des lieux et interroger leur devenir."
    ],
    "nl": [
      "La Grande Échelle is een tentoonstelling georganiseerd door het Parc Naturel Régional du Livradois-Forez en gemaakt door het collectief Carton Plein. De tentoonstelling is opgezet in het voormalige vakantiekamp van Cervières om de herinnering aan de plek nieuw leven in te blazen en de toekomst ervan in vraag te stellen."
    ],
    "es": [
      "La Grande Échelle es una exposición organizada por el Parque Natural Regional de Livradois-Forez y creada por el colectivo Carton Plein. Se ha instalado en la antigua colonia de vacaciones de Cervières para reavivar la memoria del lugar y cuestionar su futuro."
    ]
  },
