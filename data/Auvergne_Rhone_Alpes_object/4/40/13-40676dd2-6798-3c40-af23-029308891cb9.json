  "rdfs:comment": {
    "de": [
      "Ein Canyon für Anfänger. Einige tote Äste und Schrottstücke können sich am Boden der Gumpen befinden."
    ],
    "en": [
      "Canyoning is a fantastic way to experience the hidden treaures of Nyon Waterfall.  Some forest debris and old branches may be found on the river bed"
    ],
    "it": [
      "Un canyon introduttivo. Sul fondo delle pozze si possono trovare alcuni rami morti e pezzi di metallo."
    ],
    "fr": [
      "Un canyon d'initiation. Quelques branches mortes et morceaux de ferraille peuvent se trouver au fond des vasques."
    ],
    "es": [
      "Un cañón introductorio. En el fondo de las pozas pueden encontrarse algunas ramas muertas y trozos de chatarra."
    ],
    "nl": [
      "Een inleidende canyon. Op de bodem van de poelen liggen enkele dode takken en stukken schroot."
    ]
