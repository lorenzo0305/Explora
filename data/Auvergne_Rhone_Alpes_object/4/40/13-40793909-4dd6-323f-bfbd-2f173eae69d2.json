  "rdfs:comment": {
    "de": [
      "In der Petite Verrerie von Patrick Kimbert in Chambod im Departement Ain im grünen Jura wird die tausendjährige Kunst des Glasblasens weitergeführt."
    ],
    "en": [
      "Patrick Kimbert's Petite Verrerie perpetuates the age-old art of glassblowing in the verdant Jura region of France, at Chambod."
    ],
    "it": [
      "Immersa nel verde del Giura, a Chambod nell'Ain, la Petite Verrerie di Patrick Kimbert perpetua l'antica arte della soffiatura del vetro."
    ],
    "fr": [
      "Dans l’écrin de verdure du Jura, à Chambod dans l’Ain, la Petite Verrerie de Patrick Kimbert perpétue l’art millénaire du soufflage du verre."
    ],
    "nl": [
      "In het weelderige groen van de Jura, in Chambod in de Ain, houdt de Petite Verrerie van Patrick Kimbert de eeuwenoude kunst van het glasblazen in ere."
    ],
    "es": [
      "En medio de la exuberante vegetación del Jura, en Chambod (Ain), la Petite Verrerie de Patrick Kimbert perpetúa el arte milenario del soplado de vidrio."
    ]
  },
