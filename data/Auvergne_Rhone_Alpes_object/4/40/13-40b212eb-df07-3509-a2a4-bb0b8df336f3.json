  "rdfs:comment": {
    "de": [
      "Werden Sie an einem Nachmittag in der Festung von Polignac zum Steinmetz: Formen Sie Ihren eigenen Stein, inspiriert von den mittelalterlichen Baumeistern. Fun- und Geschichtsworkshop, in der Besichtigung inbegriffen. Workshop nur für Kinder und ohne vorherige Reservierung."
    ],
    "en": [
      "Become a stonecutter for an afternoon at Polignac Fortress: fashion your own stone inspired by medieval builders. Fun and historical workshop included in the tour. Workshop for children only, no advance booking required."
    ],
    "it": [
      "Diventate scalpellini per un pomeriggio alla Fortezza di Polignac: create la vostra pietra ispirandovi ai costruttori medievali. Laboratorio storico e divertente incluso nella visita. Questo laboratorio è riservato ai bambini e deve essere prenotato in anticipo."
    ],
    "fr": [
      "Devenez tailleur de pierre le temps d’un après-midi à la Forteresse de Polignac : façonnez votre propre pierre inspirée des bâtisseurs médiévaux. Atelier fun et historique, inclus dans la visite. Atelier réservé aux enfants et sans réservation préalable."
    ],
    "nl": [
      "Word een steenhouwer voor een middag in het fort van Polignac: maak je eigen steen geïnspireerd door middeleeuwse bouwers. Leuke en historische workshop inbegrepen in de rondleiding. Deze workshop is alleen voor kinderen en moet van tevoren worden geboekt."
    ],
    "es": [
      "Conviértase en cantero por una tarde en la fortaleza de Polignac: modele su propia piedra inspirándose en los constructores medievales. Taller lúdico e histórico incluido en la visita. Este taller es solo para niños y debe reservarse con antelación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier « Taille de pierre » à la Forteresse de Polignac"
    ]
  },
