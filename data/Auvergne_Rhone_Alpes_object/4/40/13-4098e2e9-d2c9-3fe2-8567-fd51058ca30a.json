  "rdfs:comment": {
    "de": [
      "Das Restaurant l'Eden bietet Ihnen lokale Produkte und eine hausgemachte Küche mit Fisch- und Meeresfrüchtespezialitäten. Sie können einen herrlichen Panoramablick auf die Berge Vercors und Chartreuse genießen."
    ],
    "en": [
      "The Eden restaurant serves local produce and home cooking, with fish and seafood specialities. Enjoy a magnificent panoramic view of the Vercors and Chartreuse mountains."
    ],
    "it": [
      "Il ristorante Eden serve prodotti locali e specialità casalinghe a base di pesce e frutti di mare. Godetevi una magnifica vista panoramica sulle montagne del Vercors e della Chartreuse."
    ],
    "fr": [
      "Le restaurant l'Eden vous propose des produits locaux et une cuisine maison aux spécialités de poissons et fruits de mer. Vous pourrez profiter d'une magnifique vue panoramique sur le Vercors et la Chartreuse."
    ],
    "nl": [
      "Het Eden restaurant serveert lokale producten en huisgemaakte vis- en zeevruchtenspecialiteiten. Geniet van een prachtig panoramisch uitzicht op de Vercors en de Chartreuse."
    ],
    "es": [
      "El restaurante Eden sirve productos locales y especialidades caseras de pescado y marisco. Disfrute de una magnífica vista panorámica de las montañas de Vercors y Chartreuse."
    ]
  },
