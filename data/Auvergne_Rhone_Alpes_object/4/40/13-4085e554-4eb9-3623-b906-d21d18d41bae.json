  "rdfs:comment": {
    "de": [
      "Café-Restaurant, Le Bistr'O bietet Pizzas, Burger, Pasta, Ravioli, die mit frischen Produkten zubereitet werden. Mittagsangebote ab 15,50 €. Burger und Tagesgericht. Snacks nachmittags, ganzjährig geöffnet."
    ],
    "en": [
      "Café-restaurant, Le Bistr'O offers pizzas, burgers, pasta and ravioli prepared with fresh produce. Lunch formulas from €15.50. Burger and dish of the day. Snacking in the afternoons, open all year round."
    ],
    "it": [
      "Il caffè-ristorante Le Bistr'O serve pizze, hamburger, pasta e ravioli preparati con prodotti freschi. Specialità a pranzo a partire da 15,50 €. Hamburger e piatto del giorno. Spuntino pomeridiano, aperto tutto l'anno."
    ],
    "fr": [
      "Café-restaurant, Le Bistr'O propose pizzas, burgers, pâtes, ravioles préparés avec des produits frais. Formules du midi dès 15,50 €. Burger et plat du jour. Snacking les après-midis, ouvert toute l'année."
    ],
    "es": [
      "El café-restaurante Le Bistr'O sirve pizzas, hamburguesas, pasta y raviolis elaborados con productos frescos. Ofertas de mediodía a partir de 15,50 €. Hamburguesa y plato del día. Merienda por la tarde, abierto todo el año."
    ],
    "nl": [
      "Café-restaurant Le Bistr'O serveert pizza's, hamburgers, pasta en ravioli gemaakt met verse producten. Lunchtime specials vanaf €15,50. Hamburger en dagschotel. Snacks in de namiddag, het hele jaar geopend."
    ]
  },
