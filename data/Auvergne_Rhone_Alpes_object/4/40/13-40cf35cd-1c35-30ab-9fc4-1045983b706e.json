  "rdfs:comment": {
    "de": [
      "Öffnen Sie neben der Bauernhalle die Tür zum botanischen Garten und entdecken Sie im Laufe der Jahreszeiten die Pflanzen der Bergstufe."
    ],
    "en": [
      "Next to the farm hall, open the door to the botanical garden and discover the plants of the mountainous region throughout the seasons."
    ],
    "it": [
      "Accanto alla sala della fattoria, aprite la porta del giardino botanico e scoprite le piante della regione montuosa nel corso delle stagioni."
    ],
    "fr": [
      "A côté de la halle fermière, ouvrez la porte du jardin botanique et découvrez au fil des saisons les plantes de l'étage montagnard."
    ],
    "nl": [
      "Open naast de hal van de boerderij de deur naar de botanische tuin en ontdek de planten van de bergstreek door de seizoenen heen."
    ],
    "es": [
      "Junto a la sala de la granja, abra la puerta del jardín botánico y descubra las plantas de la región montañosa a lo largo de las estaciones."
    ]
  },
  "rdfs:label": {
