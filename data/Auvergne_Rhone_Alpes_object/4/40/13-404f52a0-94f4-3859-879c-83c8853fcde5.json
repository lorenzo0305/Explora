  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Du Côté de Marjon\" lädt Sie in einer warmen und bukolischen Atmosphäre zu einem Gourmet-Ausflug ein. Der Chefkoch, Alain FABRE, Maître Restaurateur, bereitet eine authentische und raffinierte französische Küche zu."
    ],
    "en": [
      "The \"Du Côté de Marjon\" restaurant offers a warm, bucolic atmosphere for a gourmet getaway. Chef Alain FABRE, Maître Restaurateur, concocts authentic, refined French cuisine."
    ],
    "it": [
      "Il ristorante \"Du Côté de Marjon\" offre un'atmosfera calda e bucolica per una fuga gastronomica. Lo chef Alain FABRE, Maître Restaurateur, propone un'autentica e raffinata cucina francese."
    ],
    "fr": [
      "Le restaurant \"Du Côté de Marjon\" vous propose dans une ambiance chaleureuse et bucolique, une escapade des plus gourmandes. Le Chef, Alain FABRE, Maître Restaurateur, concocte une cuisine française authentique et raffinée."
    ],
    "nl": [
      "Het restaurant \"Du Côté de Marjon\" biedt een warme, landelijke sfeer voor een gastronomisch uitje. Chef Alain FABRE, Maître Restaurateur, bereidt authentieke, verfijnde Franse gerechten."
    ],
    "es": [
      "El restaurante \"Du Côté de Marjon\" ofrece un ambiente cálido y bucólico para una escapada gastronómica. El Chef Alain FABRE, Maître Restaurateur, elabora una cocina francesa auténtica y refinada."
    ]
  },
