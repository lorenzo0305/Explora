  "rdfs:comment": {
    "de": [
      "Verkauf von Sushi zum Mitnehmen, vor Ort und als Lieferservice. We Sushi hat es sich zur Aufgabe gemacht, seine Kunden auf eine Reise nach Japan mitzunehmen, indem es typische Gerichte aus dieser Region kocht. Know-how, Leidenschaft und Qualitätsprodukte sind die Leitlinie des Restaurants."
    ],
    "en": [
      "Sushi to go, on site and on delivery. We Sushi is committed to taking its customers on a journey to Japan, by cooking dishes typical of this region. Know-how, passion and quality products are the restaurant's guiding principles."
    ],
    "it": [
      "Sushi da asporto, sul posto e alla consegna. We Sushi si impegna a portare i suoi clienti in un viaggio in Giappone, cucinando piatti tipici giapponesi. Know-how, passione e prodotti di qualità sono i principi guida del ristorante."
    ],
    "fr": [
      "Vente de Sushi à emporter, sur place et en livraison. We Sushi s’engage à faire voyager ses clients au Japon, en cuisinant les plats typiques de cette région. Savoir-faire, passion et produits de qualités sont la ligne directrice du restaurant."
    ],
    "es": [
      "Sushi para llevar, in situ y a domicilio. We Sushi se compromete a llevar a sus clientes de viaje a Japón, cocinando platos típicos japoneses. El saber hacer, la pasión y los productos de calidad son los principios rectores del restaurante."
    ],
    "nl": [
      "Sushi om mee te nemen, ter plekke en bij bezorging. We Sushi wil zijn klanten meenemen op een reis naar Japan, door typisch Japanse gerechten te bereiden. Knowhow, passie en kwaliteitsproducten zijn de leidraad van het restaurant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "We Sushi"
    ]
  },
