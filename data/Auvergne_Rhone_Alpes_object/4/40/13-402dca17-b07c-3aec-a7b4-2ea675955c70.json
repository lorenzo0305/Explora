  "rdfs:comment": {
    "de": [
      "Auf dem Platz von Solre-le-Château können Sie eine kurze Pause einlegen und drinnen oder auf der Terrasse mit Blick auf den berühmten \"schiefen Kirchturm\" essen."
    ],
    "en": [
      "On Solre-le-Château?s town square, take a break for a bite to eat indoors or on the terrace, with a breathtaking view of the famous ?leaning bell tower?"
    ],
    "it": [
      "Sulla piazza di Solre-le-Château, fate una pausa per mangiare all'interno o sulla terrazza, con una vista mozzafiato sul famoso \"campanile pendente\"."
    ],
    "fr": [
      "Sur la place de Solre-le-Château, faites une pause d’un instant pour vous restaurer à l’intérieur ou en terrasse, avec une vue imprenable sur le fameux “clocher penché”."
    ],
    "nl": [
      "Op het plein van Solre-le-Château kun je binnen of op het terras een hapje eten, met een adembenemend uitzicht op de beroemde scheve klokkentoren."
    ],
    "es": [
      "En la plaza de Solre-le-Château, tómese un respiro para comer algo en el interior o en la terraza, con una impresionante vista del famoso \"campanario inclinado\"."
    ]
  },
  "rdfs:label": {
