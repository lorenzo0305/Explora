  "rdfs:comment": {
    "de": [
      "Lassen Sie sich am Ufer des Allier nieder und genießen Sie einen musikalischen Moment voller guter Laune! Bringen Sie Ihr Picknick mit und lassen Sie sich von der Stimmung tragen.\r\n Kostenloser Shuttle-Bus für eine entspannte Anreise!"
    ],
    "en": [
      "Settle down on the banks of the Allier for a musical moment full of good humor! Bring your own picnic and enjoy the atmosphere.\r\n Free shuttle bus for your peace of mind!"
    ],
    "it": [
      "Accomodatevi sulle rive dell'Allier per un momento musicale all'insegna del buonumore! Portate il vostro picnic e godetevi l'atmosfera.\r\n Bus navetta gratuito per la vostra tranquillità!"
    ],
    "fr": [
      "Installez-vous au bord de l’Allier pour un moment musical plein de bonne humeur ! Apportez votre pique-nique et laissez-vous porter par l’ambiance.\r\n Navette gratuite pour venir en toute sérénité !"
    ],
    "nl": [
      "Strijk neer aan de oevers van de Allier voor een muzikaal moment vol goed humeur! Neem je eigen picknick mee en geniet van de sfeer.\r\n Gratis pendelbus voor je gemoedsrust!"
    ],
    "es": [
      "Acomódese a orillas del Allier para disfrutar de un momento musical lleno de buen humor Traiga su propio picnic y disfrute del ambiente.\r\n Autobús lanzadera gratuito para su tranquilidad"
    ]
  },
  "rdfs:label": {
    "fr": [
      "9è édition Pique-Niques Concerts"
    ]
  },
