  "rdfs:comment": {
    "de": [
      "Die Stadt St-Julien bietet Ihnen im Weiler Ternier einen sportlichen und kulturellen Orientierungslauf an. Es gibt eine Erwachsenenversion dieses Parcours, aber auch eine Kinderversion!"
    ],
    "en": [
      "The town of St-Julien offers you an active walk interspersed with workshops, in a pleasant and natural environment."
    ],
    "it": [
      "La città di St-Julien offre un percorso di orientamento sportivo e culturale nella frazione di Ternier. Esiste una versione per adulti e una per bambini di questo percorso!"
    ],
    "fr": [
      "La ville de St-Julien vous propose un parcours d'orientation sportif et culturel au hameau du Ternier. Il existe la version adulte de ce parcours mais aussi la version enfant !"
    ],
    "es": [
      "La ciudad de St-Julien ofrece un recorrido deportivo y cultural de orientación en la aldea de Ternier. Existe una versión para adultos y otra para niños."
    ],
    "nl": [
      "De stad St-Julien biedt in het gehucht Ternier een sportief en cultureel oriëntatieparcours aan. Er is een volwassen versie van deze cursus en ook een kinderversie!"
    ]
  },
