  "rdfs:comment": {
    "de": [
      "Für 2025 schlägt die Stadt eine Veranstaltung rund um den Zauber von Weihnachten vor, mit einer Projektion auf die Kirche und einem Feuerwerk!"
    ],
    "en": [
      "For 2025, the town is proposing an event based on the magic of Christmas, with a projection on the church and a fireworks display!"
    ],
    "it": [
      "Per il 2025, la città sta progettando un evento basato sulla magia del Natale, con una proiezione sulla chiesa e uno spettacolo pirotecnico!"
    ],
    "fr": [
      "Pour 2025, la ville vous propose un événement autour de la magie de Noël avec une projection sur l'église et un feu d'artifice !"
    ],
    "nl": [
      "Voor 2025 plant de stad een evenement rond de magie van Kerstmis, met een projectie op de kerk en een vuurwerk!"
    ],
    "es": [
      "Para 2025, la ciudad planea un acontecimiento en torno a la magia de la Navidad, con una proyección sobre la iglesia y un espectáculo de fuegos artificiales"
    ]
  },
