  "rdfs:comment": {
    "de": [
      "Das Altayaki befindet sich im 5-Sterne-Hotel Altapura und bietet ein einzigartiges kulinarisches Erlebnis, das von Ostasien inspiriert und mit europäischen und lateinamerikanischen Einflüssen angereichert ist."
    ],
    "en": [
      "Located within the 5-star Altapura hotel, Altayaki offers a unique culinary experience, inspired by East Asia and enriched by European and Latin American touches."
    ],
    "it": [
      "Situato all'interno dell'hotel 5 stelle Altapura, Altayaki offre un'esperienza culinaria unica, ispirata all'Asia orientale e arricchita da tocchi europei e latinoamericani."
    ],
    "fr": [
      "Situé au sein de l'hôtel 5 étoiles Altapura, Altayaki propose une expérience culinaire unique, inspirée de l'Asie de l'Est et enrichie de touches européennes et latino-américaines."
    ],
    "es": [
      "Situado en el hotel de 5 estrellas Altapura, Altayaki ofrece una experiencia culinaria única, inspirada en Asia Oriental y enriquecida con toques europeos y latinoamericanos."
    ],
    "nl": [
      "Altayaki, gelegen in het 5-sterren Altapura hotel, biedt een unieke culinaire ervaring, geïnspireerd door Oost-Azië en verrijkt met Europese en Latijns-Amerikaanse accenten."
    ]
  },
