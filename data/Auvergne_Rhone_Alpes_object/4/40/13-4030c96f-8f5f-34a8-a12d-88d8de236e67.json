  "rdfs:comment": {
    "de": [
      "1870 wurde das Clos Saint-Joseph erbaut. Als Sanatorium nach dem Ersten Weltkrieg beherbergte es eine religiöse Gemeinschaft."
    ],
    "en": [
      "In 1870, Clos Saint-Joseph was built. A sanatorium after the First World War, it now houses a religious community."
    ],
    "it": [
      "Il Clos Saint-Joseph è stato costruito nel 1870. Sanatorio dopo la Prima Guerra Mondiale, oggi ospita una comunità religiosa."
    ],
    "fr": [
      "En 1870, fut construit le Clos Saint-Joseph. Sanatorium après la Première Guerre mondiale, il accueille une communauté religieuse."
    ],
    "nl": [
      "Clos Saint-Joseph werd gebouwd in 1870. Na de Eerste Wereldoorlog was het een sanatorium en nu is het de thuisbasis van een religieuze gemeenschap."
    ],
    "es": [
      "Clos Saint-Joseph se construyó en 1870. Sanatorio tras la Primera Guerra Mundial, alberga actualmente una comunidad religiosa."
    ]
