  "rdfs:comment": {
    "de": [
      "Die 1555 fertiggestellte Kirche Notre-Dame de l'Assomption in Samoëns ist ein architektonisches Zeugnis für das Werk der renommierten Steinmetze des Dorfes."
    ],
    "en": [
      "Completed in 1555, the church of Notre-Dame de l'Assumption in Samoëns is an architectural testimony of the work of the famous stonecutters of the village."
    ],
    "it": [
      "Completata nel 1555, la chiesa di Notre-Dame de l'Assomption a Samoëns è una testimonianza architettonica del lavoro dei rinomati scalpellini del villaggio."
    ],
    "fr": [
      "Achevée en 1555, l’église Notre-Dame de l’Assomption à Samoëns est un témoignage architectural de l’œuvre des renommés tailleurs de pierres du village."
    ],
    "nl": [
      "Voltooid in 1555, de kerk de Notre-Dame de l'Assomption in Samoëns is een architecturale getuigenis van het werk van de beroemde steengoten van het dorp."
    ],
    "es": [
      "Terminada en 1555, la iglesia de Notre-Dame de l'Assomption de Samoëns es un testimonio arquitectónico del trabajo de los renombrados canteros del pueblo."
    ]
  },
