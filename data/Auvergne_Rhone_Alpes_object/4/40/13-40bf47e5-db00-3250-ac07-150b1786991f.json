  "rdfs:comment": {
    "de": [
      "Bei Madame, Table de Cheffe trifft man auf Marinette, eine einzigartige und engagierte Chefin, die eine originelle Gourmetküche mit manchmal gewagten Kombinationen anbietet."
    ],
    "en": [
      "Behind Madame, Table de Cheffe, we meet Marinette, an ecologist chef who offers original gourmet cuisine with sometimes daring combinations."
    ],
    "it": [
      "Da Madame, Table de Cheffe, incontriamo Marinette, una chef singolare e impegnata, che propone una cucina gourmet originale con accostamenti talvolta audaci."
    ],
    "fr": [
      "Chez Madame, Table de Cheffe, on rencontre Marinette, une cheffe singulière et engagée, qui propose une cuisine gastronomique originale aux associations parfois audacieuses."
    ],
    "es": [
      "En Madame, Table de Cheffe, conocemos a Marinette, una chef singular y comprometida, que ofrece una cocina gastronómica original con combinaciones a veces atrevidas."
    ],
    "nl": [
      "Bij Madame, Table de Cheffe ontmoeten we Marinette, een bijzondere en toegewijde chef-kok, die originele gastronomische gerechten aanbiedt met soms gewaagde combinaties."
    ]
  },
