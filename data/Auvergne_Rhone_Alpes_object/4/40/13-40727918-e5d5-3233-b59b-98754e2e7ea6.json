  "rdfs:comment": {
    "de": [
      "Das Courtepaille-Restaurant im Hotel Mercure Valence Sud wird Sie mit seiner warmen und freundlichen Atmosphäre begeistern. Was gibt es Schöneres, als ein leckeres Grillgericht vor dem Kamin zu genießen!"
    ],
    "en": [
      "The Courtepaille restaurant at the Mercure Valence Sud Hotel will win you over with its warm and friendly atmosphere. What could be more pleasant than enjoying a delicious grilled meal in front of the fireplace?"
    ],
    "it": [
      "Il ristorante Courtepaille dell'Hotel Mercure Valence Sud vi conquisterà con la sua atmosfera calda e accogliente. Cosa c'è di più piacevole che gustare un delizioso pasto alla griglia davanti al camino!"
    ],
    "fr": [
      "Le restaurant Courtepaille de l'Hôtel Mercure Valence Sud saura vous séduire par son ambiance chaleureuse et sympathique. Quoi de plus agréable que de déguster une délicieuse grillade devant la cheminée !"
    ],
    "nl": [
      "Het Courtepaille restaurant van Hôtel Mercure Valence Sud zal je veroveren met zijn warme en vriendelijke sfeer. Wat is er aangenamer dan genieten van een heerlijke barbecue voor de open haard!"
    ],
    "es": [
      "El restaurante Courtepaille del hotel Mercure Valence Sud le seducirá con su ambiente cálido y acogedor. ¿Qué puede ser más agradable que disfrutar de una deliciosa comida a la parrilla frente a la chimenea?"
    ]
  },
