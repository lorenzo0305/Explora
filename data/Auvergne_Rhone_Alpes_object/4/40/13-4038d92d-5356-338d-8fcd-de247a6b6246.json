  "rdfs:comment": {
    "de": [
      "L'épicerie du Bonheur ist der Feinkostladen von zu Hause. Aus unserer Küche und aus der Ecke, entdecken Sie das lokale Essen und Trinken! Restaurant cuisine \"loqualité\" und utopisches Café."
    ],
    "en": [
      "Happiness Grocer’s shop is the local delicatessen. From our kitchen and region, discover local food and drink!"
    ],
    "it": [
      "L'épicerie du Bonheur è la nostra gastronomia locale. Dalla nostra cucina e dall'angolo, venite a scoprire cibi e bevande locali! Ristorante con cucina \"loqualité\" e caffè utopico."
    ],
    "fr": [
      "L'épicerie du Bonheur c'est l'épicerie fine de chez nous. De notre cuisine et du coin, venez découvrir le manger et boire local ! Restaurant cuisine \"loqualité\" et café utopique."
    ],
    "es": [
      "L'épicerie du Bonheur es nuestra tienda de delicatessen local. Desde nuestra cocina y el rincón, ¡venga a descubrir la comida y la bebida locales! Restaurante de cocina \"loqualité\" y café utópico."
    ],
    "nl": [
      "De épicerie Bonheur is de verfijnde kruidenier hier. Keuken van hier en omgeving, ontdek het lokale eten en drinken!"
    ]
  },
