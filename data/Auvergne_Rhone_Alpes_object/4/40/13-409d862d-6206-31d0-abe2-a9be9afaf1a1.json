  "rdfs:comment": {
    "de": [
      "Als Winzer seit mehreren Generationen, aus Tradition und als Erbe eines Know-hows und einer Leidenschaft, freut sich das Weingut, Sie zu empfangen, um Ihnen seine Weine, seine aromatischen Blasen und seine Fruchtsäfte zur Verkostung anzubieten."
    ],
    "en": [
      "As a family of wine growers who have been growing wine for several generations because of our traditions, legacy, know-how and passion, we'd be delighted to welcome you to taste our wines."
    ],
    "it": [
      "Viticoltori da diverse generazioni, per tradizione e per eredità di un know-how e di una passione, il Dominio è lieto di ricevervi per farvi degustare i suoi vini, le sue Bollicine aromatiche e i suoi succhi di frutta."
    ],
    "fr": [
      "Vignerons depuis plusieurs générations, par tradition et par héritage d'un savoir-faire et d'une passion, le Domaine est heureux de vous recevoir pour vous faire déguster ses vins, ses Bulles aromatiques et ses jus de fruits."
    ],
    "nl": [
      "Wijnbouwers sinds verschillende generaties, door traditie en door overerving van een knowhow en een passie, ontvangt het Domein u graag om u zijn wijnen, zijn aromatische Bubbels en zijn vruchtensappen te laten proeven."
    ],
    "es": [
      "Viticultores desde hace varias generaciones, por tradición y por herencia de un saber hacer y una pasión, el Dominio se complace en recibirles para hacerles degustar sus vinos, sus burbujas aromáticas y sus zumos de frutas."
    ]
  },
  "rdfs:label": {
