  "rdfs:comment": {
    "de": [
      "Entdecken Sie die natürliche Schönheit von Pont des Nants. Zwischen beruhigendem Wald und dem Rauschen des Wildbachs treffen Sie sich an einem symbolträchtigen Ort, an dem die Natur ihre Geschichte erzählt."
    ],
    "en": [
      "Come and discover the natural beauty of Pont des Nants. Between the soothing forest and the murmur of the torrent, meet in an emblematic place where nature tells its story."
    ],
    "it": [
      "Venite a scoprire le bellezze naturali del Pont des Nants. Tra la foresta rilassante e il mormorio del torrente, incontratevi in un luogo emblematico dove la natura racconta la sua storia."
    ],
    "fr": [
      "Venez découvrir la beauté naturelle du Pont des Nants. Entre forêt apaisante et murmure du torrent, rendez-vous dans un lieu emblématique où la nature raconte son histoire."
    ],
    "es": [
      "Venga a descubrir la belleza natural del Pont des Nants. Entre el bosque tranquilizador y el murmullo del torrente, reúnase en un lugar emblemático donde la naturaleza cuenta su historia."
    ],
    "nl": [
      "Kom en ontdek de natuurlijke schoonheid van de Pont des Nants. Ontmoet tussen het rustgevende bos en het ruisen van de beek een emblematische plek waar de natuur haar verhaal vertelt."
    ]
  },
