  "rdfs:comment": {
    "de": [
      "Silvester in Brides - Ein unvergesslicher Abend!\r\n\r\nFeiern Sie das neue Jahr in der zauberhaften Umgebung des Parc Thermal! Wir bieten Ihnen einen festlichen und geselligen Abend, um das Jahr 2026 mit Musik und Licht zu begrüßen."
    ],
    "en": [
      "New Year's Eve in Brides – An Unforgettable Evening!\r\n\r\nCelebrate the New Year in the enchanting setting of the Thermal Park! Join us for a festive and friendly evening to welcome 2026 with music and lights."
    ],
    "it": [
      "Capodanno in Sposa - Una serata indimenticabile!\r\n\r\nFesteggiate il nuovo anno nell'incantevole cornice del Parc Thermal! Vi offriamo una serata festosa e conviviale per dare il benvenuto al 2026 in musica e luce."
    ],
    "fr": [
      "Réveillon du Nouvel An à Brides - Une soirée inoubliable !\r\n\r\nCélébrez la nouvelle année dans le cadre enchanteur du Parc Thermal ! Nous vous proposons une soirée festive et conviviale pour accueillir 2026 en musique et en lumière."
    ],
    "nl": [
      "Oudejaarsavond in Bruiden - Een onvergetelijke avond!\r\n\r\nVier het nieuwe jaar in de betoverende omgeving van het Parc Thermal! We bieden je een feestelijke en gezellige avond om 2026 te verwelkomen in muziek en licht."
    ],
    "es": [
      "Nochevieja en Novias - ¡Una velada inolvidable!\r\n\r\nCelebre el Año Nuevo en el encantador marco del Parque Termal Le proponemos una velada festiva y distendida para dar la bienvenida al 2026 con música y luz."
    ]
  },
  "rdfs:label": {
    "en": [
      "New year eve"
    ],
    "fr": [
      "Nouvel an - Mercredi 31 décembre"
    ]
  },
