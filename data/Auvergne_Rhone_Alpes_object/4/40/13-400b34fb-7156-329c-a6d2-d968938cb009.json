  "rdfs:comment": {
    "de": [
      "Die Domaine d'Embraud (Eigentum des Vereins La Chavannée) überblickt wunderschön den Fluss Allier. Diese ehemalige \"louagerie\" besteht aus einem Wohnhaus und einer Scheune, die typisch für die Bocage Bourbonnais sind."
    ],
    "en": [
      "The domaine d'Embraud (property of the association La Chavannée) overlooks the river Allier magnificently. This former \"louagerie\" consists of a dwelling house and a barn typical of the Bourbonnais bocage."
    ],
    "it": [
      "Il Domaine d'Embraud (di proprietà dell'associazione La Chavannée) si affaccia magnificamente sul fiume Allier. Questa ex \"louagerie\" è costituita da una casa e da un fienile tipici del bocage del Bourbonnais."
    ],
    "fr": [
      "Le domaine d'Embraud (propriété de l'association La Chavannée) surplombe magnifiquement la rivière Allier. Cette ancienne \"louagerie\" se compose d'une maison d'habitation et d'une grange typique du bocage bourbonnais."
    ],
    "nl": [
      "Het Domaine d'Embraud (eigendom van de vereniging La Chavannée) kijkt prachtig uit over de rivier de Allier. Deze voormalige \"louagerie\" bestaat uit een huis en een schuur die typisch zijn voor de Bourbonnais bocage."
    ],
    "es": [
      "El Domaine d'Embraud (propiedad de la asociación La Chavannée) domina magníficamente el río Allier. Esta antigua \"louagerie\" consta de una casa y un granero típicos del bocage de Bourbonnais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison bourbonnaise d'Embraud"
    ]
  },
