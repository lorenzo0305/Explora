  "rdfs:comment": {
    "de": [
      "Le Signal, der beleuchtete Leuchtturm des Ortes, der einen einzigartigen Blick auf Alpe Alpe Alpe bietet\r\nalpe d'Huez und die umliegenden Bergmassive. Gepflegte Bistronomieküche mit frischen und lokalen Produkten.\r\nRestaurant Maître Restaurateur im Obergeschoss und Snacktheke im Erdgeschoss."
    ],
    "en": [
      "Le Signal, the resort's illuminated beacon with a unique view of\r\nAlpe d'Huez and the surrounding mountains. Bistronomic cuisine using fresh local produce"
    ],
    "it": [
      "Le Signal, il faro illuminato del resort con una vista unica sull'Alpe d'Huez e sulle montagne circostanti\r\nalpe d'Huez e sulle montagne circostanti. Cucina bistronomica con prodotti freschi locali.\r\nRistorante Maître restaurateur al piano superiore e snack bar al piano terra."
    ],
    "fr": [
      "Le Signal, véritable phare illuminé de la station bénéficiant d'une vue unique sur\r\nl'Alpe d'Huez et les massifs alentours. Cuisine bistronomique soignée de produits frais et locaux.\r\nRestaurant Maître restaurateur à l'étage et comptoir snack au RDC."
    ],
    "nl": [
      "Le Signal, het verlichte baken van het resort met een uniek uitzicht over\r\nAlpe d'Huez en de omliggende bergen. Bistronomische keuken met verse lokale producten"
    ],
    "es": [
      "Le Signal, el faro luminoso de la estación con una vista única sobre\r\nalpe d'Huez y las montañas circundantes. Cocina bistronómica con productos locales frescos.\r\nRestaurante Maître restaurateur en la planta superior y snack bar en la planta baja."
    ]
  },
