  "rdfs:comment": {
    "de": [
      "Charly&Kty empfängt Sie in ihrem Atelier und ihrer Boutique, um Ihnen ihre farbenfrohen und grafischen Schmuckkollektionen und ihre Leistungen im Bereich Imageberatung vorzustellen."
    ],
    "en": [
      "Charly&Kty welcomes you to its workshop-boutique to present its colorful, graphic jewelry collections and image consulting services."
    ],
    "it": [
      "Charly&Kty vi accoglie nel suo laboratorio-boutique per presentare le sue collezioni di gioielli colorati e grafici e i suoi servizi di consulenza d'immagine."
    ],
    "fr": [
      "Charly&Kty vous accueille dans son atelier-boutique afin de vous présenter ses collections de bijoux colorés et graphiques et ses prestations de conseil en image."
    ],
    "es": [
      "Charly&Kty le da la bienvenida a su taller-boutique para presentarle sus coloridas colecciones de joyas gráficas y sus servicios de asesoría de imagen."
    ],
    "nl": [
      "Charly&Kty heet je welkom in haar atelier-boutique om haar kleurrijke, grafische sieradencollecties en image consultancy diensten te tonen."
    ]
