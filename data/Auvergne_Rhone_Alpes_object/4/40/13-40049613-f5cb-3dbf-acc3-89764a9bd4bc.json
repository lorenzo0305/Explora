  "rdfs:comment": {
    "de": [
      "Auf Gumières wurde im September 2019 eine \"BIO\"-Geflügelzucht gegründet. \"Les deux petites fermes bio\" setzt, wie der Name schon sagt, vor allem auf Qualität."
    ],
    "en": [
      "Sur Gumières, un élevage de volailles « BIO » a vu en septembre 2019. « Les deux petites fermes bio », comme son nom l’indique, mise sur la qualité avant tout."
    ],
    "it": [
      "Un allevamento di pollame biologico ha aperto a Gumières nel settembre 2019. come suggerisce il nome, \"Les deux petites fermes bio\" punta tutto sulla qualità."
    ],
    "fr": [
      "Sur Gumières, un élevage de volailles « BIO » a vu le jour en septembre 2019. « Les deux petites fermes bio », comme son nom l’indique, mise sur la qualité avant tout."
    ],
    "nl": [
      "In september 2019 wordt in Gumières een biologisch pluimveebedrijf geopend. zoals de naam al doet vermoeden, draait het bij \"Les deux petites fermes bio\" om kwaliteit."
    ],
    "es": [
      "En septiembre de 2019 se inauguró en Gumières una granja avícola ecológica. como su nombre indica, \"Les deux petites fermes bio\" apuesta por la calidad."
    ]
  },
