  "rdfs:comment": {
    "de": [
      "Das Breizh Café Megève befindet sich im Herzen des Dorfes und verfügt über eine Terrasse mit Theke. Auf der Speisekarte steht das Beste aus der Bretagne mit den Crêpes und Galettes von Bertrand Larcher, einer sehr anspruchsvollen Auswahl an Cidres und Meeresfrüchten."
    ],
    "en": [
      "Breizh Café Megève is located right in the heart of the village, with a counter terrace. On the menu: the best of Brittany, with Bertrand Larcher's crêpes and galettes, a selection of ciders and seafood."
    ],
    "it": [
      "Il Breizh Café Megève si trova nel cuore del villaggio e dispone di una terrazza con bancone. Nel menu: il meglio della Bretagna con le crêpes e le galettes di Bertrand Larcher, una selezione molto speciale di sidri e frutti di mare."
    ],
    "fr": [
      "Breizh Café Megève est situé en plein cœur du village et dispose d’une terrasse comptoir. À la carte : le meilleur de la Bretagne avec les crêpes et les galettes de Bertrand Larcher, une sélection très pointue de cidres et des produits de la mer."
    ],
    "nl": [
      "Breizh Café Megève ligt in het hart van het dorp en heeft een tegenterras. Op het menu: het beste van Bretagne met de crêpes en galettes van Bertrand Larcher, een zeer speciale selectie ciders en zeevruchten."
    ],
    "es": [
      "Breizh Café Megève está situado en pleno centro del pueblo y dispone de una terraza con mostrador. En la carta: lo mejor de Bretaña con las crêpes y galettes de Bertrand Larcher, una selección muy especial de sidras y marisco."
    ]
  },
