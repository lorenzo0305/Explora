  "rdfs:comment": {
    "de": [
      "Der Freeride World Tour Qualifier ist die Referenzstrecke für erwachsene Rider, die nach Spitzenleistungen streben. Der Freeride World Tour Qualifier ist ein Sprungbrett zur Elite und bietet den besten Fahrern die Möglichkeit, an der legendären Freeride World Tour teilzunehmen."
    ],
    "en": [
      "The Freeride World Tour Qualifier is the benchmark circuit for adult riders in search of excellence. A veritable springboard to the elite, it offers the best competitors the opportunity to join the legendary Freeride World Tour."
    ],
    "it": [
      "Il Freeride World Tour Qualifier è il circuito di riferimento per i rider adulti alla ricerca dell'eccellenza. Vero e proprio trampolino di lancio verso l'élite, offre ai migliori concorrenti l'opportunità di entrare a far parte del leggendario Freeride World Tour."
    ],
    "fr": [
      "Le Freeride World Tour Qualifier est le circuit de référence pour les riders adultes en quête d’excellence. Véritable tremplin vers l’élite, il offre aux meilleurs compétiteurs l’opportunité d’accéder au mythique Freeride World Tour."
    ],
    "es": [
      "El Freeride World Tour Qualifier es el circuito de referencia para los riders adultos en busca de la excelencia. Auténtico trampolín hacia la élite, ofrece a los mejores competidores la oportunidad de unirse al legendario Freeride World Tour."
    ],
    "nl": [
      "De Freeride World Tour Qualifier is het benchmarkcircuit voor volwassen rijders die op zoek zijn naar uitmuntendheid. Het is een echte springplank naar de elite en biedt de beste deelnemers de kans om deel te nemen aan de legendarische Freeride World Tour."
    ]
  },
  "rdfs:label": {
