  "rdfs:comment": {
    "de": [
      "Ob allein, mit der Familie oder mit Freunden, in der Schneesportjagd organisieren wir Privatunterricht und individuelle Ausflüge, um Ihre Erwartungen perfekt zu erfüllen."
    ],
    "en": [
      "From snowplough, we cater for a diverse range of needs and look forward to sharing this beautiful resort with you. See our website below to discover the Tribe."
    ],
    "it": [
      "Che siate da soli, con la famiglia o con gli amici, possiamo organizzare lezioni private e uscite personalizzate per soddisfare ogni vostra esigenza."
    ],
    "fr": [
      "Seul, en famille ou entre amis, en chasse neige, nous organisons des leçons privées et des sorties personnalisées pour répondre parfaitement à vos attentes."
    ],
    "es": [
      "Ya sea solo, en familia o con amigos, podemos organizar clases particulares y salidas personalizadas para satisfacer todas sus necesidades."
    ],
    "nl": [
      "Of je nu alleen bent, met familie of vrienden, we kunnen privélessen en persoonlijke uitjes organiseren om aan al je wensen te voldoen."
    ]
  },
