  "rdfs:comment": {
    "de": [
      "Das Empfangsteam des Fremdenverkehrsamts von Lanslebourg informiert Sie über Veranstaltungen und Aktivitäten, damit Sie Ihren schönsten Urlaub in den Bergen planen und die Vorzüge der Region entdecken können."
    ],
    "en": [
      "The team at the Lanslebourg Tourist Office will keep you informed about events and activities to help you plan your best mountain holiday and discover the region's assets."
    ],
    "it": [
      "Il team dell'Ufficio del Turismo di Lanslebourg sarà lieto di fornirvi informazioni su eventi e attività per aiutarvi a pianificare la vostra migliore vacanza in montagna e a scoprire le ricchezze della regione."
    ],
    "fr": [
      "L'équipe d'accueil de l'Office de tourisme de Lanslebourg vous informe sur les événements et activités pour préparer vos plus belles vacances à la montagne et découvrir les atouts de la région."
    ],
    "nl": [
      "Het team van het Office du Tourisme van Lanslebourg geeft je graag informatie over evenementen en activiteiten om je te helpen je beste bergvakantie te plannen en de troeven van de regio te ontdekken."
    ],
    "es": [
      "El equipo de la Oficina de Turismo de Lanslebourg le mantendrá informado sobre eventos y actividades para ayudarle a planificar sus mejores vacaciones en la montaña y descubrir los activos de la región."
    ]
  },
