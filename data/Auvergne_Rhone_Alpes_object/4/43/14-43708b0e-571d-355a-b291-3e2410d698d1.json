  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3caad6eb-cb19-3383-8d3d-bc2a7588944a",
      "dc:description": {
        "de": [
          "Werfen Sie einen Blick auf den Art-déco-Stil in Boulogne-sur-Mer: Architekten, Fassaden und Motive stehen auf dem Programm.\n\nTreffpunkt vor der Schule Jules Ferry, Boulevard de Clocheville um 15:00 Uhr\n\nPreis: 5? pro Erwachsener\nKostenlos für Kinder unter 12 Jahren"
        ],
        "en": [
          "Take a look at Boulogne-sur-Mer's Art Deco style: architects, facades and motifs.\n\nMeet in front of école Jules Ferry, boulevard de Clocheville at 3:00 p.m\n\nPrice: 5? per adult\nFree for children under 12"
        ],
        "it": [
          "Date un'occhiata allo stile Art Déco a Boulogne-sur-Mer: architetti, facciate e motivi.\n\nAppuntamento davanti alla scuola Jules Ferry, boulevard de Clocheville alle 15.00\n\nPrezzo: 5 euro per adulto\nGratuito per i minori di 12 anni"
        ],
        "fr": [
          "Levez les yeux sur le style Art Déco à Boulogne-sur-Mer : architectes, façades et motifs au programme.\n\nRendez-vous devant l'école Jules Ferry, boulevard de Clocheville à 15h00\n\nTarif: 5€ par adulte\nGratuit pour les moins de 12 ans"
        ],
        "es": [
          "Eche un vistazo al estilo Art Déco en Boulogne-sur-Mer: arquitectos, fachadas y motivos.\n\nEncuentro frente a la escuela Jules Ferry, bulevar de Clocheville, a las 15:00\n\nPrecio: 5 euros por adulto\nGratis para menores de 12 años"
        ],
        "nl": [
          "Bekijk de Art Deco stijl in Boulogne-sur-Mer: architecten, gevels en motieven.\n\nVerzamelen voor de Jules Ferry school, boulevard de Clocheville om 15.00 uur\n\nPrijs: 5 euro per volwassene\nGratis voor kinderen onder de 12 jaar"
        ]
      },
