  "rdfs:comment": {
    "de": [
      "La Vallée des Sourires ist ein Weinkeller in der Rhône-Region. Von Côte-Rôtie bis Châteauneuf-du-Pape kommen Sie und entdecken Sie die Appellationen und Rebsorten unserer schönen Region."
    ],
    "en": [
      "La Vallée des Sourires is a wine cellar in the Rhône region. From Côte-Rôtie to Châteauneuf-du-Pape, come and discover the appellations and grape varieties of our beautiful region."
    ],
    "it": [
      "La Vallée des Sourires è una cantina della regione del Rodano. Dalla Côte-Rôtie allo Châteauneuf-du-Pape, venite a scoprire le denominazioni e i vitigni della nostra splendida regione."
    ],
    "fr": [
      "La Vallée des Sourires est une cave à vin de la région du Rhône. De Côte-Rôtie à Châteauneuf-du-Pape venez découvrir les appellations et cépages de notre belle région."
    ],
    "nl": [
      "La Vallée des Sourires is een wijnkelder in de Rhône. Van Côte-Rôtie tot Châteauneuf-du-Pape, kom en ontdek de appellations en druivenrassen van onze prachtige regio."
    ],
    "es": [
      "La Vallée des Sourires es una bodega de vinos de la región del Ródano. De Côte-Rôtie a Châteauneuf-du-Pape, venga a descubrir las denominaciones y variedades de uva de nuestra hermosa región."
    ]
  },
  "rdfs:label": {
