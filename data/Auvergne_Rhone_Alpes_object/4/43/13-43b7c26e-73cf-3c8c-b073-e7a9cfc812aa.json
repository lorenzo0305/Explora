  "rdfs:comment": {
    "de": [
      "Die Kirche von St Nizier, ein kleines romanisches Juwel, erscheint uns fest verankert am Fuße der Trois Pucelles, inmitten des Gemeindefriedhofs."
    ],
    "en": [
      "The church of St Nizier, a small Romanesque gem, stands firmly anchored at the foot of the Trois Pucelles, in the middle of the communal cemetery."
    ],
    "it": [
      "La chiesa di St Nizier, piccolo gioiello romanico, è saldamente ancorata ai piedi delle Trois Pucelles, nel mezzo del cimitero comunale."
    ],
    "fr": [
      "L'église de St Nizier, petit joyau roman, nous apparaît fermement ancrée au pied des Trois Pucelles, au milieu du cimetière communal."
    ],
    "es": [
      "La iglesia de San Nizier, pequeña joya románica, se alza firmemente anclada al pie de las Trois Pucelles, en pleno cementerio comunal."
    ],
    "nl": [
      "De kerk van St Nizier, een klein Romaans juweeltje, staat stevig verankerd aan de voet van de Trois Pucelles, midden op de gemeentelijke begraafplaats."
    ]
  },
