  "rdfs:comment": {
    "de": [
      "Bauern und Forscher mit dem Label Nature et Progrès. Geb-Nout bietet Produkte an, die das Gleichgewicht zwischen Mensch und Erde respektieren: Brot, fermentierte Getränke, Balsame, verarbeitetes Getreide, Konfitüren, Kompotte, Kräuter, Hydrolate und Gemmotherapie"
    ],
    "en": [
      "Farmers and researchers, labelled Nature et Progrès. Geb-Nout offers products that respect the balance of Man and the Earth: bread, fermented drinks, balms, processed cereals, jams, compotes, herbs, hydrolats and gemmotherapy"
    ],
    "it": [
      "Agricoltori e ricercatori, etichetta Nature et Progrès. Geb-Nout offre prodotti che rispettano l'equilibrio dell'uomo e della terra: pani, bevande fermentate, balsami, cereali lavorati, marmellate, composte, fitoterapia, idrolati e gemmoterapia"
    ],
    "fr": [
      "Paysans et chercheurs, labellisés Nature et Progrès. Geb-Nout propose des produits respectant l'équilibre de l'Homme et de la Terre: pains, boissons fermentées, baumes, céréales transformées, confitures, compotes, herboristerie, hydrolats et gemmothérapie"
    ],
    "nl": [
      "Boeren en onderzoekers, label Nature et Progrès. Geb-Nout biedt producten die het evenwicht tussen Mens en Aarde respecteren: broden, gefermenteerde dranken, balsems, verwerkte granen, jam, compotes, kruidengeneeskunde, hydrolaat en gemmotherapie"
    ],
    "es": [
      "Agricultores e investigadores, etiqueta Nature et Progrès. Geb-Nout ofrece productos que respetan el equilibrio del Hombre y la Tierra: panes, bebidas fermentadas, bálsamos, cereales procesados, mermeladas, compotas, hierbas medicinales, hidrolatos y gemoterapia"
    ]
  },
  "rdfs:label": {
    "fr": [
