  "rdfs:comment": {
    "de": [
      "Machen Sie einen Zeitsprung und entdecken Sie diese wunderschöne, geschichtsträchtige Stadt anhand ihrer Denkmäler, ihrer Architektur, ihrer Geheimnisse und ihrer wunderschönen Gassen im provenzalischen Stil"
    ],
    "en": [
      "Cross the time and discover this magnificent city full of history through the monuments, the architecture, the secrets and the magnificent Provençal alleys that it shelters"
    ],
    "it": [
      "Viaggiate nel tempo e scoprite questa magnifica città ricca di storia attraverso i suoi monumenti, la sua architettura, i suoi segreti e i suoi magnifici vicoli in stile provenzale"
    ],
    "fr": [
      "Traversez le temps et découvrez cette magnifique ville chargée d'histoire au travers des monuments, de l'architecture, des secrets et des magnifiques ruelles à la provençale qu'elle abrite"
    ],
    "es": [
      "Viaje en el tiempo y descubra esta magnífica ciudad cargada de historia a través de sus monumentos, su arquitectura, sus secretos y sus magníficas callejuelas de estilo provenzal"
    ],
    "nl": [
      "Reis door de tijd en ontdek deze prachtige stad vol geschiedenis via haar monumenten, architectuur, geheimen en prachtige steegjes in Provençaalse stijl"
    ]
  },
  "rdfs:label": {
    "en": [
      "Guided tour in old town of Nyons"
    ],
    "fr": [
      "Visite historique de Nyons"
    ],
    "nl": [
      "Geleide wandeling in Nyons"
    ]
  },
