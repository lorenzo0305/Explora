  "rdfs:comment": {
    "de": [
      "Einzige Restaurantmetzgerei in Clermont-Ferrand, die ihren Kunden eine große Vielfalt an Stücken bietet, die in herkömmlichen Restaurants nicht zu finden sind."
    ],
    "en": [
      "The only butcher's restaurant in Clermont-Ferrand that offers its customers a wide variety of cuts not found in classic restaurants."
    ],
    "it": [
      "L'unica macelleria di Clermont-Ferrand che offre ai suoi clienti un'ampia varietà di tagli che non si trovano nei ristoranti tradizionali."
    ],
    "fr": [
      "Seule boucherie restaurant de Clermont-Ferrand qui offre à sa clientèle une grande diversité de morceaux introuvables en restauration classique."
    ],
    "es": [
      "La única carnicería de Clermont-Ferrand que ofrece a sus clientes una gran variedad de cortes que no se encuentran en los restaurantes tradicionales."
    ],
    "nl": [
      "Het enige slagersrestaurant in Clermont-Ferrand dat zijn klanten een grote verscheidenheid aan stukken vlees biedt die niet in traditionele restaurants te vinden zijn."
    ]
  },
