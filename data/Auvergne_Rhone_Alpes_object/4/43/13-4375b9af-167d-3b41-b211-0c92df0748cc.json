  "rdfs:comment": {
    "de": [
      "Das Restaurant ist mit dem Gütesiegel \"OSPITALITÀ ITALIANA\" als authentischer Italiener zertifiziert und setzt mit seiner hausgemachten Küche auf Italien, das Heimatland des Küchenchefs Salvatore Li Vigni."
    ],
    "en": [
      "Certified authentic Italian by the label \"OSPITALITÀ ITALIANA\", the restaurant gives pride of place to Italy, the country of origin of Chef Salvatore Li Vigni, with its homemade cuisine."
    ],
    "it": [
      "Certificato come autentico italiano dal marchio \"OSPITALITÀ ITALIANA\", il ristorante è un fiore all'occhiello dell'Italia, paese d'origine dello chef Salvatore Li Vigni, con una cucina casalinga."
    ],
    "fr": [
      "Certifié Italien authentique par le label \"OSPITALITÀ ITALIANA\", le restaurant fait la part belle à l'Italie, pays d'origine du Chef Salvatore Li Vigni, avec une cuisine fait maison."
    ],
    "nl": [
      "Het restaurant is authentiek Italiaans verklaard door het label \"OSPITALITÀ ITALIANA\" en geeft met de huisgemaakte keuken een eerbetoon aan Italië, het land van herkomst van chef Salvatore Li Vigni."
    ],
    "es": [
      "Certificado como auténticamente italiano por la etiqueta \"OSPITALITÀ ITALIANA\", el restaurante da un lugar de honor a Italia, el país de origen del chef Salvatore Li Vigni, con una cocina casera."
    ]
  },
  "rdfs:label": {
