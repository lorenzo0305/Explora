  "rdfs:comment": {
    "de": [
      "Seit 2013 diplomierte Kosmetikerin und Wellness-Masseurin. Mit Freude und Leidenschaft biete ich meine Dienste in meiner Praxis in Châtillon-en-Diois an, nur nach Terminvereinbarung."
    ],
    "en": [
      "Certified Esthetician and Wellness Masseuse since 2013. It is with pleasure and passion that I offer my services in my practice in Châtillon-en-Diois, by appointment only."
    ],
    "it": [
      "Estetista e massaggiatrice qualificata dal 2013. È con piacere e passione che offro i miei servizi nel mio studio di Châtillon-en-Diois, solo su appuntamento."
    ],
    "fr": [
      "Esthéticienne Masseuse Bien-être diplômée depuis 2013. C'est avec plaisir et passion que je propose mes services dans mon cabinet, à Châtillon-en-Diois, sur rendez-vous uniquement."
    ],
    "nl": [
      "Gediplomeerd schoonheidsspecialiste en wellnessmasseuse sinds 2013. Met plezier en passie bied ik mijn diensten aan in mijn praktijk in Châtillon-en-Diois, alleen op afspraak."
    ],
    "es": [
      "Esteticista diplomada y masajista de bienestar desde 2013. Es con placer y pasión que ofrezco mis servicios en mi consulta de Châtillon-en-Diois, con cita previa."
    ]
  },
