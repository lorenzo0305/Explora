      "dc:description": {
        "de": [
          "Japanische Küche. Lieferung ab 18H, siehe auf der Website.\nAlle unsere Gerichte werden auf Bestellung mit frischen Produkten von guter Qualität zubereitet."
        ],
        "en": [
          "Japanese cuisine. Delivery from 6pm, see website.\nAll our dishes are prepared to order using fresh, high-quality ingredients."
        ],
        "it": [
          "Cucina giapponese. Consegna a partire dalle 18:00, vedi sito web.\nTutti i nostri piatti sono preparati su ordinazione con prodotti freschi e di alta qualità."
        ],
        "fr": [
          "Cuisine japonaise. Livraison à partir de 18H, voir sur le site internet. \nTous nos plats sont préparés sur commande avec des produits frais et de bonne qualité."
        ],
        "nl": [
          "Japanse keuken. Bezorging vanaf 18.00 uur, zie website.\nAl onze gerechten worden op bestelling bereid met verse producten van hoge kwaliteit."
        ],
        "es": [
          "Cocina japonesa. Reparto a partir de las 18.00 horas, consulte el sitio web.\nTodos nuestros platos se preparan por encargo con productos frescos y de alta calidad."
        ]
