  "rdfs:comment": {
    "de": [
      "Baptiste Vassy, der sich im Herzen der Drôme niedergelassen hat, bietet Ihnen Cocktails und Mixologie-Workshops für Ihre Veranstaltungen an.\r\nHochzeiten, Seminare, Geburtstage: Machen Sie den Menschen eine Freude, machen Sie Ihre Veranstaltungen berauschend!"
    ],
    "en": [
      "Located in the heart of the Drôme, Baptiste Vassy offers cocktails and mixology workshop for your events.\r\nWeddings, seminars, birthdays: Make people happy, make your events exhilarating!"
    ],
    "it": [
      "Con sede nel cuore della Drôme, Baptiste Vassy propone cocktail e laboratori di mixologia per i vostri eventi.\r\nMatrimoni, seminari, compleanni: rendete felici le persone, rendete esaltanti i vostri eventi!"
    ],
    "fr": [
      "Installé en cœur de Drôme, Baptiste Vassy vous propose des cocktails et ateliers mixologie pour vos événements. \r\nMariages, séminaires, anniversaires : Faites plaisir aux gens, rendez vos événements grisants !"
    ],
    "es": [
      "Situado en el corazón de la Drôme, Baptiste Vassy ofrece cócteles y talleres de mixología para sus eventos.\r\nBodas, seminarios, cumpleaños: ¡haga feliz a la gente, haga que sus eventos sean estimulantes!"
    ],
    "nl": [
      "Baptiste Vassy, ​​gelegen in het hart van de Drôme, biedt cocktails en mixologieworkshops voor uw evenementen.\r\nBruiloften, seminars, verjaardagen: maak mensen blij, maak uw evenementen spannend!"
    ]
  },
