  "rdfs:comment": {
    "de": [
      "In Châtillon-en-Diois zubereitete Rohkostschokolade aus Kakao aus Peru und Produkten aus unserer Region. Tiefgründiger, delikater Geschmack und gut für die Gesundheit. Wein- & Schokoladenverkostungen während des Festivals Arts et Vigne."
    ],
    "en": [
      "Raw chocolate made in Châtillon-en-Diois from Peruvian cocoa and local produce. Deep, delicate and healthy taste. Wine & chocolate tastings during the Arts et Vigne festival."
    ],
    "it": [
      "Cioccolato crudo prodotto a Châtillon-en-Diois, utilizzando cacao del Perù e dell'Ecuador e prodotti locali (noci di Diois, miele). Gusto intenso, delicato e fruttato. Degustazioni di vino e cioccolato durante il festival Arts et Vigne."
    ],
    "fr": [
      "Chocolat cru préparé à Châtillon-en-Diois, à base de cacao du Pérou, d’Équateur et de produits de notre terroir (noix du Diois, miel). Goût intense, délicat et fruité. Dégustations vins & chocolats pendant le festival Arts et Vigne."
    ],
    "nl": [
      "Rauwe chocolade gemaakt in Châtillon-en-Diois van Peruaanse cacao en lokale producten. Diepe, delicate en gezonde smaak. Wijn- en chocoladeproeverijen tijdens het Arts et Vigne festival."
    ],
    "es": [
      "Chocolate crudo elaborado en Châtillon-en-Diois, con cacao de Perú y Ecuador y productos locales (nueces de Diois, miel). Sabor intenso, delicado y afrutado. Degustaciones de vino y chocolate durante el festival Arts et Vigne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chocolat Cru Sauvage"
    ]
  },
