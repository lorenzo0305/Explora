  "rdfs:comment": {
    "de": [
      "Im Herzen von Vieux-Lyon empfängt Sie das Berthom zum Essen, Trinken und Diskutieren! Viel mehr als ein Ort des Konsums, ein Ort der Begegnung und der schönen Geschichten."
    ],
    "en": [
      "In the heart of Vieux-Lyon, the Berthoms welcome you to eat, drink, and chat! Much more than a place to eat, it's a place for meetings and wonderful stories."
    ],
    "it": [
      "Nel cuore della Vecchia Lione, Berthom vi accoglie per mangiare, bere e chiacchierare! È più di un semplice posto dove mangiare, è un luogo dove incontrare persone e raccontare storie."
    ],
    "fr": [
      "Au coeur du Vieux-Lyon, les Berthom vous accueille pour manger, boire et discuter ! Bien plus qu’un lieu de consommation, un lieu de rencontres et de belles histoires."
    ],
    "nl": [
      "In het hart van het oude Lyon heet Berthom je welkom om te eten, te drinken en te kletsen! Het is meer dan een plek om te eten, het is een plek om mensen te ontmoeten en verhalen te vertellen."
    ],
    "es": [
      "En el corazón del Viejo Lyon, Berthom le da la bienvenida para comer, beber y charlar Es más que un lugar para comer, es un lugar para conocer gente y contar historias."
    ]
  },
