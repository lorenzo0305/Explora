  "rdfs:comment": {
    "de": [
      "Befahren Sie die Rodelbahn mit kleinen Buckeln und Steilkurven allein oder im Doppelsitzer.\r\nFahren Sie dank des Förderbandes mühelos wieder nach oben."
    ],
    "en": [
      "Come and ride the luge track with small bumps and curves, solo or in tandem.\r\nCome back up effortlessly thanks to the conveyor belt."
    ],
    "it": [
      "Venite a percorrere la pista per slittini con i suoi piccoli dossi e le sue curve strette, da soli o in coppia.\r\nIl nastro trasportatore permette di salire senza fatica."
    ],
    "fr": [
      "Venez parcourir la piste de luge avec des petites bosses et virages relevés en solo ou en biplace.\r\nRemontez sans effort grâce au tapis roulant."
    ],
    "es": [
      "Ven a montarte en el tobogán con sus pequeños baches y curvas cerradas, solo o en pareja.\r\nLa cinta transportadora permite subir sin esfuerzo."
    ],
    "nl": [
      "Kom alleen of met een tandem de rodelbaan met kleine hobbels en scherpe bochten berijden.\r\nKom moeiteloos terug naar boven dankzij de transportband."
    ]
  },
  "rdfs:label": {
    "en": [
