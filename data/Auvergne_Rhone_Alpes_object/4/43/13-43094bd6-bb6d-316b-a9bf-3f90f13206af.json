  "rdfs:comment": {
    "de": [
      "Die Fitnessschleife richtet sich an gelegentliche oder regelmäßige Sportler, die mit einer umfassenden Übungsabfolge ihren Körper und ihre Gesundheit pflegen möchten."
    ],
    "en": [
      "The fitness loop is designed for occasional or regular sportsmen and women who want to maintain their body and health through a complete sequence of exercises."
    ],
    "it": [
      "L'anello di fitness si rivolge a sportivi occasionali o regolari che desiderano mantenere il proprio corpo e la propria salute attraverso una sequenza completa di esercizi."
    ],
    "fr": [
      "La boucle fitness s'adresse aux sportifs occasionnels ou réguliers qui souhaitent entretenir leur corps et leur santé grâce à un enchaînement d'exercices complet."
    ],
    "es": [
      "El bucle de fitness está dirigido a deportistas ocasionales o regulares que desean mantener su cuerpo y su salud mediante una secuencia completa de ejercicios."
    ],
    "nl": [
      "De fitnessloop is bedoeld voor gelegenheids- of regelmatige sporters die hun lichaam en gezondheid op peil willen houden door middel van een complete reeks oefeningen."
    ]
  },
