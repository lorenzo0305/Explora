  "rdfs:comment": {
    "de": [
      "Mit Liebe angebautes Gemüse und Kräuter, originelle und leckere Rezepte, handwerklich verarbeitete Gläser für den Gaumenschmaus!"
    ],
    "en": [
      "Lovingly grown vegetables and herbs, original, gourmet recipes, handcrafted jars to delight your taste buds!"
    ],
    "it": [
      "Verdure ed erbe aromatiche coltivate con amore, ricette originali e gourmet, vasetti fatti a mano per deliziare il vostro palato!"
    ],
    "fr": [
      "Des légumes et aromates cultivés avec amour, des recettes originales et gourmandes, des bocaux transformés artisanalement pour le plaisir des papilles !"
    ],
    "es": [
      "Verduras y hierbas cultivadas con esmero, recetas gastronómicas originales y tarros hechos a mano para deleitar su paladar"
    ],
    "nl": [
      "Groenten en kruiden met liefde geteeld, originele, gastronomische recepten, handgemaakte potjes om je smaakpapillen te verwennen!"
