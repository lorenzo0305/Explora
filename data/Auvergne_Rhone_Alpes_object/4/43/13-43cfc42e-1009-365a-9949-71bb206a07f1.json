  "rdfs:comment": {
    "de": [
      "Ihre neue Kletterhalle in Bourgoin-Jallieu, die dem Bouldern gewidmet ist!\r\n Klettern und Spaß haben... Ob allein, mit Freunden oder der Familie, hier können Sie das Bouldern erlernen oder perfektionieren."
    ],
    "en": [
      "Your new climbing gym dedicated to bouldering in Bourgoin-Jallieu!\r\n Climb and have fun... Alone, with friends or family; come and learn or improve your bouldering skills."
    ],
    "it": [
      "La vostra nuova palestra di arrampicata dedicata al bouldering a Bourgoin-Jallieu!\r\n Arrampicare e divertirsi... Da soli, con gli amici o con la famiglia, venite a imparare o a migliorare le vostre abilità nel bouldering."
    ],
    "fr": [
      "Votre nouvelle salle d’escalade dédiée à la pratique du bloc à Bourgoin-Jallieu!\r\n Grimper et s'amuser...Seuls, entre amis ou en famille; venez vous initier ou vous perfectionner à l’escalade de bloc."
    ],
    "nl": [
      "Uw nieuwe klimzaal gewijd aan het boulderen in Bourgoin-Jallieu!\r\n Alleen, met vrienden of familie; kom en leer of verbeter je bouldervaardigheden."
    ],
    "es": [
      "Tu nuevo rocódromo dedicado al búlder en Bourgoin-Jallieu\r\n Escala y diviértete... Solo, con amigos o con la familia; ven a aprender o a mejorar tus habilidades de búlder."
    ]
  },
