  "rdfs:comment": {
    "de": [
      "Der 8. März, der Internationale Tag der Frauenrechte, ist für die Stadt Valencia eine gute Gelegenheit, ihr Engagement für Gleichberechtigung und soziale Gerechtigkeit in Erinnerung zu rufen."
    ],
    "en": [
      "March 8, International Women?s Rights Day, is an opportunity for the City of Valence to reiterate its commitment to equality and social justice."
    ],
    "it": [
      "L'8 marzo, Giornata internazionale dei diritti della donna, è un'occasione per Valence di ribadire il suo impegno per l'uguaglianza e la giustizia sociale."
    ],
    "fr": [
      "Le 8 mars, journée internationale des droits des femmes, est l’occasion pour la Ville de Valence de rappeler son engagement en faveur de l’égalité et de la justice sociale."
    ],
    "es": [
      "El 8 de marzo, Día Internacional de los Derechos de la Mujer, es una oportunidad para que Valence reitere su compromiso con la igualdad y la justicia social."
    ],
    "nl": [
      "8 maart, de Internationale Dag van de Rechten van de Vrouw, is voor Valence een gelegenheid om haar engagement voor gelijkheid en sociale rechtvaardigheid te bevestigen."
    ]
  },
  "rdfs:label": {
