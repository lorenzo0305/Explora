  "rdfs:comment": {
    "de": [
      "Diese Route in der Michaille ist ideal für einen Mountainbikeausflug mit der Familie. Am Fuße des Plateau de Retord haben Sie schöne Ausblicke auf den Crêt d'Eau (siehe Mont-Blanc!). Breite, steinige Wege ohne große Schwierigkeiten."
    ],
    "en": [
      "This itinerary in the Michaille is ideal for a family mountain bike outing, at the foot of the Plateau de Retord, with lovely views of the Crêt d'Eau (and even Mont-Blanc!). Wide, stony trails with no major difficulties."
    ],
    "it": [
      "Questo percorso nel Michaille è ideale per una gita in mountain bike in famiglia, ai piedi del Plateau de Retord si gode di una bella vista sulla Crêt d'Eau (e anche sul Monte Bianco!). Sentieri larghi e sassosi senza grandi difficoltà."
    ],
    "fr": [
      "Cet itinéraire dans la Michaille est idéal pour une sortie VTT en famille, au pied du Plateau de Retord vous aurez de jolis points de vues sur le Crêt d'Eau  (voir le Mont-Blanc !). Chemins larges et caillouteux sans grandes difficultés."
    ],
    "es": [
      "Este itinerario de la Michaille es ideal para una salida familiar en bicicleta de montaña. Al pie del Plateau de Retord, disfrutarás de hermosas vistas de la Crêt d'Eau (¡e incluso del Mont Blanc!). Senderos anchos y pedregosos sin grandes dificultades."
    ],
    "nl": [
      "Deze route in de Michaille is ideaal voor een mountainbike-uitstapje met het gezin, aan de voet van het Plateau de Retord heb je prachtige uitzichten op de Crêt d'Eau (en zelfs op de Mont Blanc!). Brede, stenige paden zonder grote moeilijkheden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours VTTAE 21 vert- La Michaille / Vouvray - Espace FFC Ain Forestière"
    ]
  },
