  "rdfs:comment": {
    "de": [
      "Baptiste und Adeline sind seit 2020 Bauernhofproduzenten im Chartreuse-Tal und laden Sie ein, sie kennenzulernen und ihre Käse, Kuh- und Schafsmilchprodukte sowie Wurstwaren von Schwein und Schaf zu entdecken."
    ],
    "en": [
      "Baptiste and Adeline, farmers in the Chartreuse valley since 2020, invite you to come and meet them and discover their cheeses, cow and sheep dairy products and pork and sheep charcuterie."
    ],
    "it": [
      "Baptiste e Adeline, agricoltori nella valle della Chartreuse dal 2020, vi invitano a conoscerli e a scoprire i loro formaggi, i prodotti a base di latte di mucca e di pecora e i salumi di maiale e di pecora."
    ],
    "fr": [
      "Baptiste et Adeline producteurs fermiers en vallée de Chartreuse depuis 2020 vous invitent à venir les rencontrer et découvrir leurs fromages,produits laitiers de vache et brebis et charcuterie de porc et mouton."
    ],
    "es": [
      "Baptiste y Adeline, agricultores del valle de la Chartreuse desde 2020, le invitan a conocerles y a descubrir sus quesos, productos lácteos de vaca y oveja y charcutería de cerdo y oveja."
    ],
    "nl": [
      "Baptiste en Adeline, boeren in de Chartreuse vallei sinds 2020, nodigen je uit om hen te ontmoeten en hun kazen, koe- en schapenmelkproducten en varkens- en schapencharcuterie te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC La ferme de Miri'Bêle"
    ]
  },
