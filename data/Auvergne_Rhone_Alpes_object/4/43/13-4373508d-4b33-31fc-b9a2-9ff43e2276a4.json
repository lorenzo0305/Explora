  "rdfs:comment": {
    "de": [
      "Produzenten von Bauernhof-Schafskäse aus Rohmilch.\r\nVerkauf auf dem Bauernhof am Freitagmorgen nach 10 Uhr nach Vereinbarung.\r\nVerkauf auf dem Markt in Langeac am Dienstagmorgen, in Craponne am Samstagmorgen und am Montagmorgen in Paulhaguet.\r\n[joghurt - tommes - milchprodukte ]"
    ],
    "en": [
      "Producers of farmhouse ewe's milk cheeses.\r\nFarm sales Friday mornings after 10am by appointment.\r\nSales at Langeac market on Tuesday mornings, Craponne on Saturday mornings and Paulhaguet on Monday mornings.\r\n[ yogurts - tommes - lactiques ]"
    ],
    "it": [
      "Produttori di formaggi di pecora di fattoria.\r\nVendita in fattoria il venerdì mattina dopo le 10, su appuntamento.\r\nVendita al mercato di Langeac il martedì mattina, a Craponne il sabato mattina e a Paulhaguet il lunedì mattina.\r\n[ yoghurts - tommes - lactiques ]"
    ],
    "fr": [
      "Producteurs de fromages fermiers de brebis au lait cru.\r\nVente à la ferme le vendredi matin après 10h sur rendez-vous.\r\nVente sur le marché de Langeac le mardi matin, Craponne  le samedi matin et le lundi matin Paulhaguet.\r\n[ yaourts - tommes - lactiques ]"
    ],
    "es": [
      "Productores de quesos de oveja de granja.\r\nVenta en la granja los viernes por la mañana a partir de las 10h con cita previa.\r\nVenta en el mercado de Langeac los martes por la mañana, en Craponne los sábados por la mañana y en Paulhaguet los lunes por la mañana.\r\n[ yogures - tommes - lactiques ]"
    ],
    "nl": [
      "Producenten van boerenkazen van schapenmelk.\r\nVerkoop op de boerderij op vrijdagochtend na 10 uur op afspraak.\r\nVerkoop op de markt van Langeac op dinsdagochtend, Craponne op zaterdagochtend en Paulhaguet op maandagochtend.\r\n[yoghurts - tommes - lactiques ]"
    ]
  },
  "rdfs:label": {
