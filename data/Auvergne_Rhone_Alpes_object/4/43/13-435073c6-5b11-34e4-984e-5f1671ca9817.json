  "rdfs:comment": {
    "de": [
      "Die Herberge liegt im Herzen des nordischen Höhenskigebiets von Lans en Vercors und verfügt über einen Speisesaal, in dem bis zu 75 Personen in einer Bergatmosphäre Platz finden können."
    ],
    "en": [
      "This inn is located in the heart of the Nordic ski area of Lans-en-Vercors. It has a mountain-style dining room that can hold up to 75 people."
    ],
    "it": [
      "Situata nel cuore del comprensorio sciistico nordico di Lans en Vercors, la locanda dispone di una sala da pranzo che può ospitare fino a 75 persone in un'atmosfera di montagna."
    ],
    "fr": [
      "Située au cœur du domaine de ski nordique d'altitude de Lans en Vercors, l'auberge possède une salle à manger qui peut accueillir jusqu'à 75 personnes dans une ambiance montagnarde."
    ],
    "es": [
      "Situada en el corazón de la zona de esquí nórdico de Lans en Vercors, la posada dispone de un comedor con capacidad para 75 personas en un ambiente de montaña."
    ],
    "nl": [
      "Gelegen in het hart van het Noordse skigebied van Lans en Vercors, beschikt de herberg over een eetzaal die plaats biedt aan maximaal 75 personen in een bergsfeer."
    ]
  },
  "rdfs:label": {
