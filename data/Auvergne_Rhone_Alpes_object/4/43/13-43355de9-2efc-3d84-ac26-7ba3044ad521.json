  "rdfs:comment": {
    "de": [
      "Bei einem Spaziergang durch den charmanten kleinen Ort Bourdeau sollten Sie es wagen, die Abfahrt direkt unterhalb des prächtigen Schlosses zu nehmen: Unten angekommen, sind Sie da, im kleinsten und romantischsten aller Häfen am Lac du Bourget."
    ],
    "en": [
      "Charming little marina below the village of Bourdeau."
    ],
    "it": [
      "Piccolo porto affascinante in basso al villaggio di Bourdeau."
    ],
    "fr": [
      "Au détour d’une balade dans le charmant petit bourg de Bourdeau, osez emprunter la descente juste au dessous du magnifique château : arrivés en bas, vous y êtes, au plus petit et plus romantique de tous les ports du Lac du Bourget."
    ],
    "es": [
      "Mientras pasea por el encantador pueblecito de Bourdeau, atrévase a descender justo debajo del magnífico castillo: ahí está, en el más pequeño y romántico de todos los puertos del lago del Bourget."
    ],
    "nl": [
      "Als u door het charmante stadje Bourdeau wandelt, waag dan de afdaling net onder het prachtige kasteel: daar bent u, bij de kleinste en meest romantische van alle havens aan het Lac du Bourget."
    ]
  },
