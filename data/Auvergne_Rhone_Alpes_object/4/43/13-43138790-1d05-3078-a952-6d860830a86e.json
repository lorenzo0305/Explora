  "rdfs:comment": {
    "de": [
      "Le Speaker ist der erste Ort in Lyon, der zu 100 % dem Stand-up gewidmet ist! Finden Sie im Bereich Comedy Club humorvolle Bühnen mit 4 bis 6 Komikern, die eine Stunde lang einen Witz nach dem anderen reißen, um Sie zum Lachen zu bringen."
    ],
    "en": [
      "Le Speaker is Lyon's first venue entirely dedicated to stand-up comedy! Every day, enjoy the real comedy club experience and meet the city's best comedians."
    ],
    "it": [
      "Le Speaker è il primo locale al 100% dedicato alla stand-up comedy a Lione! Troverete spettacoli comici nell'area Comedy Club, con 4-6 comici che si esibiscono in una battuta dopo l'altra per un'ora per farvi ridere."
    ],
    "fr": [
      "Le Speaker, c'est le premier lieu 100% dédié au stand up à Lyon ! Retrouvez des plateaux d'humour dans l'espace Comedy Club avec 4 à 6 comédiens qui enchaînent les blagues pendant une heure pour vous faire rire."
    ],
    "nl": [
      "Le Speaker is de eerste zaal in Lyon die 100% gewijd is aan stand-upcomedy! Je vindt er comedyshows in het Comedy Club-gedeelte, met 4 tot 6 comedians die een uur lang de ene grap na de andere opvoeren om je aan het lachen te maken."
    ],
    "es": [
      "Le Speaker es el primer local 100% dedicado a la comedia en Lyon Encontrará espectáculos de comedia en la zona del Club de la Comedia, con entre 4 y 6 cómicos que interpretan un chiste tras otro durante una hora para hacerle reír."
    ]
  },
