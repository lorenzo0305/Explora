  "rdfs:comment": {
    "de": [
      "Yes We Canyon bietet Ausflüge zu Natursportarten an. Canyoning, Klettern, Klettersteige und Höhlenforschung in den Massiven des Vercors und der Chartreuse. Entdecken Sie diese wunderbaren Umgebungen mit zwei begeisterten Guides!"
    ],
    "en": [
      "Yes We Canyon offers nature sports outings. Canyoning, climbing, via ferrata and caving in the Vercors and Chartreuse massifs. Come and discover these wonderful environments with two passionate guides!"
    ],
    "it": [
      "Yes We Canyon propone escursioni sportive nella natura. Canyoning, arrampicata, via ferrata e speleologia nei massicci del Vercors e della Chartreuse. Venite a scoprire questi ambienti meravigliosi con due guide appassionate!"
    ],
    "fr": [
      "Yes We Canyon propose des sorties de sport de nature. Le canyoning, l'escalade, la via ferrata et la spéléologie dans les massifs du Vercors et de la Chartreuse. Venez découvrir ces merveilleux environnements avec deux guides passionnés !"
    ],
    "es": [
      "Yes We Canyon ofrece salidas deportivas en la naturaleza. Barranquismo, escalada, vía ferrata y espeleología en los macizos de Vercors y Chartreuse. Venga a descubrir estos maravillosos entornos con dos guías apasionados"
    ],
    "nl": [
      "Yes We Canyon biedt natuursportexcursies aan. Canyoning, klimmen, klettersteigen en speleologie in de Vercors en Chartreuse massieven. Kom en ontdek deze prachtige omgevingen met twee gepassioneerde gidsen!"
    ]
  },
