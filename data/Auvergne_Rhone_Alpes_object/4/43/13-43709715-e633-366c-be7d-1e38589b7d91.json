  "rdfs:comment": {
    "de": [
      "80 Jahre Nürnberger Prozesse in Anwesenheit der Historiker(innen) Annette Becker und Alexandre Sumpf sowie eines Juristen. Redebeiträge, Spaziergang, Versammlung im Tempel am Ende des Tages. Anmeldung erforderlich, um Fahrgemeinschaften zu bilden. Picknick vorsehen."
    ],
    "en": [
      "The 80th anniversary of the Nuremberg trials, in the presence of historians Annette Becker and Alexandre Sumpf and a jurist. Speeches, march, gathering at the Temple at the end of the day. Registration required for car pooling. Please bring a picnic."
    ],
    "it": [
      "L'80° anniversario dei processi di Norimberga alla presenza degli storici Annette Becker e Alexandre Sumpf e di un esperto di diritto. Discorsi, marcia, raduno al Tempio alla fine della giornata. È necessaria l'iscrizione per il car pooling. Si prega di portare un picnic."
    ],
    "fr": [
      "Les 80 ans du procès de Nuremberg en présence des historien(nes) Annette Becker,  Alexandre Sumpf et d'un juriste. Interventions, marche, rassemblement au Temple en fin de journée. Sur inscription pour le co-voiturage. Prévoir pique-nique."
    ],
    "nl": [
      "De 80e verjaardag van de processen van Neurenberg in aanwezigheid van historici Annette Becker en Alexandre Sumpf en een jurist. Toespraken, mars, bijeenkomst bij de Tempel aan het eind van de dag. Registratie vereist voor carpoolen. Breng een picknick mee."
    ],
    "es": [
      "80 aniversario de los juicios de Nuremberg en presencia de los historiadores Annette Becker y Alexandre Sumpf y de un jurista. Discursos, marcha, concentración en el Templo al final del día. Inscripción obligatoria para compartir coche. Se ruega traer un picnic."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journée de la Mémoire"
    ]
  },
