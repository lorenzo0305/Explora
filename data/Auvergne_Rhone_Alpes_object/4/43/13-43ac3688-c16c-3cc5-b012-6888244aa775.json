  "rdfs:comment": {
    "de": [
      "Das in Les Plans d'Hotonnes gelegene Village des Étoiles soll möglichst vielen Menschen die Astronomie näher bringen."
    ],
    "en": [
      "Located at the heart of Valromey, the Village des Étoiles is designed to introduce astronomy to the greatest number of people."
    ],
    "it": [
      "Situato a Les Plans d'Hotonnes, il Village des Étoiles è stato progettato per aiutare il maggior numero possibile di persone a scoprire l'astronomia."
    ],
    "fr": [
      "Situé aux Plans d'Hotonnes, le Village des Étoiles est destiné à faire découvrir l'astronomie au plus grand nombre."
    ],
    "es": [
      "Situado en Les Plans d'Hotonnes, el Village des Étoiles está concebido para ayudar al mayor número posible de personas a descubrir la astronomía."
    ],
    "nl": [
      "Het Village des Étoiles ligt in Les Plans d'Hotonnes en is ontworpen om zoveel mogelijk mensen de sterrenkunde te laten ontdekken."
    ]
