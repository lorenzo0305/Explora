  "rdfs:comment": {
    "de": [
      "Valérie Sautour ist Korbflechterin, nachdem sie eine lange Ausbildung an der einzigen nationalen Schule für Korbflechterei und Korbflechterei in Frankreich absolviert hat."
    ],
    "en": [
      "Valérie Sautour is an artisan basket-maker, following a lengthy diploma course at France?s only École Nationale d?Osiériculture et de Vannerie."
    ],
    "it": [
      "Valérie Sautour è una cestaia artigiana che ha seguito un lungo percorso di formazione che l'ha portata a diplomarsi presso l'unica Scuola Nazionale di Osiericoltura e Cesteria della Francia."
    ],
    "fr": [
      "Valérie Sautour est artisane vannière, suite à une longue formation diplômante dans l’unique École Nationale d’Osiériculture et de Vannerie en France."
    ],
    "nl": [
      "Valérie Sautour is een ambachtelijke mandenmaakster die een lange opleiding heeft gevolgd die leidde tot een diploma aan de enige nationale Franse school voor oesterteelt en mandenmaken."
    ],
    "es": [
      "Valérie Sautour es cestera artesana y ha seguido una larga formación para obtener un diploma en la única Escuela Nacional de Osiericultura y Cestería de Francia."
    ]
  },
