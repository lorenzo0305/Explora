  "rdfs:comment": {
    "de": [
      "Schwierige Route, die Erwachsenen und Jugendlichen vorbehalten ist. Sportliche und luftige Route mit mehreren vertikalen Passagen, die sowohl die Beine als auch die Arme beansprucht!"
    ],
    "en": [
      "Difficult route reserved for adults and teenagers. A sporty, aerial route with several vertical sections that challenge both legs and arms!"
    ],
    "it": [
      "Percorso difficile riservato ad adulti e ragazzi. Un percorso sportivo e aereo con diversi tratti verticali che mettono alla prova gambe e braccia!"
    ],
    "fr": [
      "Voie difficile réservé aux adultes et adolescents. Parcours sportif et aérien avec plusieurs passages verticaux qui sollicite autant les jambes que les bras !"
    ],
    "es": [
      "Recorrido difícil reservado a adultos y adolescentes. Una ruta deportiva y aérea con varios tramos verticales que suponen un reto tanto para las piernas como para los brazos"
    ],
    "nl": [
      "Moeilijke route gereserveerd voor volwassenen en tieners. Een sportieve, luchtige route met verschillende verticale secties die zowel benen als armen uitdagen!"
    ]
  },
  "rdfs:label": {
