  "rdfs:comment": {
    "de": [
      "Im Rahmen des Bibliotheksfrühlings 2026 laden die Bibliothèque départementale und die Bibliothek von Souvigny Sie ein, \"Et Pourtant elle tourne!\" der Kompanie Euphorik Mouvance zu entdecken"
    ],
    "en": [
      "As part of Printemps des Bibliothèques 2026, the departmental library and the Souvigny library invite you to discover \"Et Pourtant elle tourne!\" by the Euphorik Mouvance company"
    ],
    "it": [
      "Nell'ambito del Printemps des Bibliothèques 2026, la biblioteca dipartimentale e la biblioteca di Souvigny vi invitano a scoprire \"Et Pourtant elle tourne!\" della compagnia Euphorik Mouvance"
    ],
    "fr": [
      "Dans le cadre du Printemps des Bibliothèques 2026, la bibliothèque départementale et la bibliothèque de Souvigny vous invite à découvrir \"Et Pourtant elle tourne !\" de la compagnie Euphorik Mouvance"
    ],
    "nl": [
      "In het kader van Printemps des Bibliothèques 2026 nodigen de departementale bibliotheek en de bibliotheek van Souvigny je uit om \"Et Pourtant elle tourne! van het gezelschap Euphorik Mouvance te ontdekken"
    ],
    "es": [
      "En el marco de Printemps des Bibliothèques 2026, la biblioteca departamental y la biblioteca de Souvigny le invitan a descubrir \"Et Pourtant elle tourne! de la compañía Euphorik Mouvance"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Et pourtant elle tourne !"
    ]
  },
