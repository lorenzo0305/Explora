  "rdfs:comment": {
    "de": [
      "Feudales Schloss aus dem 13. Jahrhundert, im 17. Jahrhundert umgebaut. Der Bergfried bietet einen herrlichen Blick auf die Limagne, die Combrailles und die Monts Dore.\r\nDie Schatzsuche für eine weitere Entdeckung: Rätsel mit Beobachtung, Schlussfolgerung und Logik."
    ],
    "en": [
      "A 13th century feudal fortress which was remodelled in the 17th century. The keep offers magnificent views of the Limagne, the Combrailles and Mont Dore. During the\r\nsummer, enjoy treasure hunts and enigmas involving observation, deduction and logic."
    ],
    "it": [
      "Castello feudale del XIII secolo, ristrutturato nel XVII secolo. Il torrione offre una magnifica vista su Limagne, Combrailles e Monts Dore.\r\nUna caccia al tesoro per una scoperta diversa: indovinelli di osservazione, deduzione e logica. 1h30."
    ],
    "fr": [
      "Château féodal du XIIIème siècle remanié au XVIIéme. Le donjon offre des vues magnifiques sur la Limagne, les Combrailles et les Monts Dore. \r\nLa chasse au trésor pour une autre découverte : énigmes mettant en jeu observation, déduction et logique. 1h30."
    ],
    "nl": [
      "Feodaal kasteel uit de 13e eeuw, vernieuwd in de 17e eeuw. In de\r\nzomer met schat zoeken ter plaatse."
    ],
    "es": [
      "Castillo feudal del siglo XIII remodelado en el siglo XVII. La torre del homenaje ofrece magníficas vistas de Limagne, Combrailles y Monts Dore.\r\nUna búsqueda del tesoro para un descubrimiento diferente: enigmas de observación, deducción y lógica. 1h30."
    ]
  },
