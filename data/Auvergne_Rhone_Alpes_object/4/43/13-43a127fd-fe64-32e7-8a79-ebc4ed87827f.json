  "rdfs:comment": {
    "de": [
      "Im Eliospa by Hôtel des Dromonts genießen Sie die großen Klassiker der Marke Sothys, wie die 100% maßgeschneiderte Pflege, bei der Sie die Textur und den Duft für Ihre Massage auswählen können, oder die Gesichtspflege Intensivbehandlung Ausstrahlung."
    ],
    "en": [
      "At Eliospa by Hôtel des Dromonts, you can enjoy the great classics of the Sothys brand, including the 100% personalized treatment, where you can choose the texture and fragrance for your massage, as well as intensive radiance facial treatments."
    ],
    "it": [
      "Presso l'Eliospa by Hôtel des Dromonts potrete godere dei grandi classici del marchio Sothys, con il trattamento 100% su misura in cui potrete scegliere la texture e la fragranza del vostro massaggio, o il trattamento intensivo di luminosità per il viso."
    ],
    "fr": [
      "A l’Eliospa by Hôtel des Dromonts, vous profitez des grands classiques de la marque Sothys, avec le soin 100% sur mesure où vous pouvez choisir la texture et la fragrance pour vous faire masser, ou encore les soins visage traitement intensif éclat."
    ],
    "es": [
      "En Eliospa by Hôtel des Dromonts, podrá disfrutar de los grandes clásicos de la marca Sothys, con el tratamiento 100% a medida donde podrá elegir la textura y la fragancia para su masaje, o los tratamientos faciales intensivos de luminosidad."
    ],
    "nl": [
      "Bij Eliospa by Hôtel des Dromonts geniet je van de grote klassiekers van het merk Sothys, zoals de 100% op maat gemaakte behandeling, waarbij je de textuur en geur kunt kiezen voor je massage, evenals de intensieve stralingsgezichtsbehandelingen."
    ]
  },
