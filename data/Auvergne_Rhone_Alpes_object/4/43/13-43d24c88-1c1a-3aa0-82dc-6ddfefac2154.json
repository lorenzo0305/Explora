  "rdfs:comment": {
    "de": [
      "Der Circuit de Charade empfängt das ganze Jahr über die breite Öffentlichkeit bei Veranstaltungen und Wettbewerben. Außerdem empfängt sie Unternehmen und Fachleute im Rahmen von Seminaren, Schulungen, Testfahrten, Dreharbeiten usw."
    ],
    "en": [
      "The Charade circuit welcomes the general public throughout the year for events and competitions. It also welcomes companies and professionals for seminars, training, testing, filming, etc."
    ],
    "it": [
      "Il Circuit de Charade accoglie il pubblico in generale per eventi e gare durante tutto l'anno. Accoglie anche aziende e professionisti per seminari, formazione, test, riprese, ecc."
    ],
    "fr": [
      "Le Circuit de Charade accueille tout au long de l'année le grand public lors des événements et compétitions. Il reçoit également les entreprises et professionnels dans le cadre de séminaires, formations, essais, tournages, etc."
    ],
    "nl": [
      "Het Circuit de Charade verwelkomt het hele jaar door het grote publiek voor evenementen en wedstrijden. Het ontvangt ook bedrijven en professionals voor seminars, trainingen, testen, filmen, enz."
    ],
    "es": [
      "El Circuito de Charade acoge al público en general para eventos y competiciones durante todo el año. También acoge a empresas y profesionales para seminarios, formación, pruebas, rodajes, etc."
    ]
  },
