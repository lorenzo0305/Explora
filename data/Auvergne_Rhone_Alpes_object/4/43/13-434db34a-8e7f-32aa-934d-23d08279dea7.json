  "rdfs:comment": {
    "de": [
      "Stellen Sie Nachforschungen in Le Sappey en Chartreuse an!\r\nJustin hat einen Schlüssel gefunden, mit dem er nichts anzufangen weiß. Er durchstreift die Dörfer von Le Sappey und trifft sich mit verschiedenen lokalen Persönlichkeiten, damit sie ihm helfen, herauszufinden, was sein Schlüssel öffnen könnte."
    ],
    "en": [
      "Investigate in Le Sappey en Chartreuse!\r\nJustin has found a key he doesn't know what to do with; he's wandering the hamlets of Le Sappey, meeting various local characters to help him discover what his key might open."
    ],
    "it": [
      "Guida l'indagine in Sappey en Chartreuse!\r\nJustin ha trovato una chiave di cui non sa che farsene; viaggia per le frazioni di Sappey e incontra vari personaggi locali che lo aiutano a scoprire cosa potrebbe aprire la sua chiave."
    ],
    "fr": [
      "Menez l'enquête au Sappey en Chartreuse !\r\nJustin a trouvé une clef dont il ne sait que faire; il parcourt les hameaux du Sappey et part à la rencontre de divers personnages locaux pour qu'ils l'aident à découvrir ce que pourrait ouvrir sa clef."
    ],
    "es": [
      "¡Investiga en Le Sappey en Chartreuse!\r\nJustin ha encontrado una llave con la que no sabe qué hacer, así que se pasea por las aldeas de Le Sappey y se reúne con varios personajes locales para averiguar qué podría abrir la llave."
    ],
    "nl": [
      "Leid het onderzoek in Sappey en Chartreuse!\r\nJustin heeft een sleutel gevonden waarvan hij niet weet wat hij ermee moet doen; hij reist door de gehuchten van Sappey en ontmoet verschillende lokale personages zodat zij hem kunnen helpen ontdekken wat zijn sleutel zou kunnen openen."
    ]
  },
