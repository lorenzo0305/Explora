  "rdfs:comment": {
    "de": [
      "TOULABA OUTDOOR hat sich auf Aktivitäten in der freien Natur, Umweltbildung und verantwortungsbewussten Tourismus in der Auvergne spezialisiert und bietet spielerische und lehrreiche Ausflüge im Rhythmus der Jahreszeiten an.\r\nMikroabenteuer und pädagogische Interventionen."
    ],
    "en": [
      "Specializing in outdoor activities, environmental education and responsible tourism in the Auvergne, TOULABA OUTDOOR offers fun and educational outings in tune with the seasons.\r\nMicro-adventures and educational activities."
    ],
    "it": [
      "Specializzata in attività all'aria aperta, educazione ambientale e turismo responsabile in Alvernia, TOULABA OUTDOOR propone gite divertenti ed educative in sintonia con le stagioni.\r\nMicroavventure e attività educative."
    ],
    "fr": [
      "Spécialisé dans les activités de pleine nature, dans l'éducation à l'environnement et le tourisme responsable en Auvergne TOULABA OUTDOOR propose des sorties ludiques et éducatives au rythme des saisons. \r\nMicro-aventure et interventions pédagogiques."
    ],
    "nl": [
      "TOULABA OUTDOOR, gespecialiseerd in outdooractiviteiten, milieueducatie en verantwoord toerisme in de Auvergne, biedt ludieke en educatieve uitstapjes die afgestemd zijn op de seizoenen.\r\nMicro-avonturen en educatieve activiteiten."
    ],
    "es": [
      "Especialista en actividades al aire libre, educación medioambiental y turismo responsable en Auvernia, TOULABA OUTDOOR propone salidas lúdicas y pedagógicas en sintonía con las estaciones.\r\nMicroaventuras y actividades educativas."
    ]
  },
