  "rdfs:comment": {
    "de": [
      "Programm des Kinos: Filme, die landesweit in die Kinos kommen, Animationsfilme für Kinder oder auch Arthouse-Filme.\r\nDas ganze Jahr über werden zahlreiche Animationen sowie Festivals angeboten."
    ],
    "en": [
      "Cinema programming: films with national releases, animated films for children or art films.\r\nNumerous animations and festivals are offered throughout the year."
    ],
    "it": [
      "La programmazione del cinema comprende film di produzione nazionale, film d'animazione per bambini e film d'autore.\r\nNumerosi eventi e festival vengono proposti durante tutto l'anno."
    ],
    "fr": [
      "Programmations du cinéma : films en sortie nationale, films d'animation pour enfants ou encore films d'art et essai.\r\nDe nombreuses animations ainsi que des festivals sont proposés tout au long de l'année."
    ],
    "es": [
      "La programación del cine incluye películas de estreno nacional, películas de animación para niños y películas de autor.\r\nA lo largo del año se ofrecen numerosos eventos y festivales."
    ],
    "nl": [
      "Het programma van de bioscoop omvat nationale films, animatiefilms voor kinderen en arthousefilms.\r\nHet hele jaar door worden talrijke evenementen en festivals aangeboden."
    ]
  },
  "rdfs:label": {
