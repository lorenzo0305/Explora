  "rdfs:comment": {
    "de": [
      "Hier finden Sie Kebab-Sandwiches, Merguez, Rindergeschnetzeltes oder Hähnchenspieße, die mit Baguettebrot aus der Bäckerei Marcoux in Ramberto hergestellt werden, aber auch Hotdogs, Paninis, Cheeseburger, Nudelgerichte, Desserts und kalte Getränke."
    ],
    "en": [
      "You'll find kebab sandwiches, merguez, sliced beef and chicken kebabs, made with baguette bread from Rambert's Marcoux bakery, as well as hot dogs, paninis, cheeseburgers, pasta dishes, desserts and cold drinks."
    ],
    "it": [
      "Troverete panini kebab, merguez, manzo tritato e spiedini di pollo preparati con pane baguette del panificio Marcoux di Rambert, oltre a hot dog, panini, cheeseburger, piatti di pasta, dessert e bevande fredde."
    ],
    "fr": [
      "Retrouvez des sandwiches kebabs, merguez, émincés de bœuf ou brochettes de poulet, faits avec du pain baguette fabriqué par la boulangerie rambertoise Marcoux, mais aussi des hot-dogs, paninis, cheeseburgers, plats de pâtes, desserts et boissons fraîches."
    ],
    "nl": [
      "Je vindt er broodjes kebab, merguez, gehakt en kip kebab, gemaakt met stokbrood van bakkerij Marcoux in Rambert, en ook hotdogs, panini's, cheeseburgers, pastagerechten, desserts en koude dranken."
    ],
    "es": [
      "Encontrará bocadillos de kebab, merguez, carne picada y brochetas de pollo, hechos con pan baguette de la panadería Marcoux de Rambert, así como perritos calientes, paninis, hamburguesas con queso, platos de pasta, postres y bebidas frías."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La baguette du Rambertois grill"
    ]
  },
