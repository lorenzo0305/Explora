  "rdfs:comment": {
    "de": [
      "Führungen und Einführung in paläontologische Ausgrabungen. Beteiligen Sie sich an der Familie, mit einem Paläontologen, an der Suche nach Fossilien auf einer realen Ausgrabungsstätte, die 56 Millionen Jahre alt ist."
    ],
    "en": [
      "Discover paleontology, archeology. Introduction to excavations, on a real site dating up to 56 millions of years old."
    ],
    "it": [
      "Visite guidate e introduzione agli scavi paleontologici. Unisciti a una famiglia di paleontologi alla ricerca di fossili in un vero sito di scavo risalente a 56 milioni di anni fa."
    ],
    "fr": [
      "Visites guidées et initiation aux fouilles paléontologiques. Participez en famille, avec un paléontologue, aux recherches de fossiles sur un véritable chantier de fouilles de 56 millions d'années."
    ],
    "es": [
      "Visitas guiadas e introducción a las excavaciones paleontológicas. Únase en familia a un paleontólogo en la búsqueda de fósiles en una excavación real de 56 millones de años de antigüedad."
    ],
    "nl": [
      "Houdt u van de oudheid? Ga op archeologische en paleontologische\r\nontdekkingstocht met stag mogelijkheden voor beginners."
    ]
  },
