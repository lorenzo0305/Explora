  "rdfs:comment": {
    "de": [
      "Willkommen im Pachamama, der Indoor-Freizeit- und Jungle-Bar in Grenoble!\nEntdecken Sie einzigartige Minigolf-, Pétanque- und Dart-Aktivitäten sowie eine 300 m² große Themenbar!\nEinzigartig in Grenoble! Aktivitäten für alle!"
    ],
    "en": [
      "Welcome to Pachamama, Indoor Leisure and Jungle Bar in Grenoble!\r\nDiscover unique activities such as miniature golf, petanque and darts as well as a 100m² themed bar!\r\nUnique in Grenoble! Activities for all !"
    ],
    "it": [
      "Benvenuti al Pachamama, Indoor Leisure and Jungle Bar a Grenoble!\nScoprite attività uniche di minigolf, bocce e freccette, oltre a un bar a tema di 300 m²!\nUnico a Grenoble! Attività per tutti!"
    ],
    "fr": [
      "Bienvenue au Pachamama, Loisirs Indoor et Jungle Bar à Grenoble !\r\nDécouvrez des activités uniques de minigolf, pétanque et fléchettes ainsi qu'un bar à thème de 300m² !\r\nUnique à Grenoble ! Des activités pour tous !"
    ],
    "es": [
      "¡Bienvenido a Pachamama, ocio interior y bar de la jungla en Grenoble!\r\nDescubra actividades únicas como minigolf, petanca y dardos, así como un bar temático de 300 m².\r\n¡Único en Grenoble! Actividades para todos."
    ],
    "nl": [
      "Welkom bij Pachamama, Indoor Leisure en Jungle Bar in Grenoble!\nOntdek unieke minigolf-, jeu de boules- en dartactiviteiten, plus een themabar van 300 m²!\nUniek in Grenoble! Activiteiten voor iedereen!"
    ]
  },
  "rdfs:label": {
