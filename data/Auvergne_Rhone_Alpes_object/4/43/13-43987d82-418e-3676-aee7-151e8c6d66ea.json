  "rdfs:comment": {
    "de": [
      "Florent Augay ist Baumschulgärtner und Bienenzüchter."
    ],
    "en": [
      "Florent Augay is a nursery owner and beekeeper."
    ],
    "it": [
      "Florent Augay, vivaista e appassionato apicoltore, dal 2013 gestisce Alti Pep, un vivaio d'alta quota situato a Chalmazel nei Monts du Forez, nella regione di Auvergne-Rhône-Alpes."
    ],
    "fr": [
      "Florent Augay, pépiniériste et apiculteur passionné, est à la tête d’Alti Pep, une pépinière d’altitude située à Chalmazel dans les Monts du Forez en région Auvergne-Rhône-Alpes depuis 2013."
    ],
    "es": [
      "Florent Augay, viverista y apicultor apasionado, dirige desde 2013 Alti Pep, un vivero de altura situado en Chalmazel, en los Montes del Forez, en la región de Auvernia-Ródano-Alpes."
    ],
    "nl": [
      "Florent Augay, kweker en gepassioneerd imker, runt sinds 2013 Alti Pep, een hooggelegen kwekerij in Chalmazel in de Monts du Forez in de regio Auvergne-Rhône-Alpes."
    ]
  },
