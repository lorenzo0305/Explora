  "rdfs:comment": {
    "de": [
      "Bei Ravigote lieben wir die französische Küche. Wir sind stolz darauf, alle unsere Gerichte mit frischen und saisonalen Zutaten zuzubereiten, um Ihnen ein authentisches kulinarisches Erlebnis zu bieten."
    ],
    "en": [
      "At Ravigote, we are passionate about French cuisine. We are proud to prepare all our dishes from fresh and seasonal ingredients to offer you an authentic culinary experience."
    ],
    "it": [
      "Noi di Ravigote siamo appassionati di cucina francese. Siamo orgogliosi di preparare tutti i nostri piatti con ingredienti freschi e di stagione per offrirti un'esperienza culinaria autentica."
    ],
    "fr": [
      "Chez Ravigote, nous sommes passionnés par la cuisine française. Nous sommes fiers de préparer tous nos plats à partir d'ingrédients frais et de saison pour vous offrir une expérience culinaire authentique."
    ],
    "es": [
      "En Ravigote, nos apasiona la cocina francesa. Nos enorgullecemos de preparar todos nuestros platos con ingredientes frescos y de temporada para ofrecerle una auténtica experiencia culinaria."
    ],
    "nl": [
      "Bij Ravigote hebben we een passie voor de Franse keuken. We zijn er trots op dat we al onze gerechten bereiden met verse, seizoensgebonden ingrediënten om je een authentieke culinaire ervaring te geven."
    ]
  },
