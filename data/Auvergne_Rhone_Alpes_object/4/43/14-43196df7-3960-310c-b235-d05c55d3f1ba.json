      "@id": "https://data.datatourisme.fr/c5abb56a-309b-39a8-a6f5-8bb351599fb5",
      "dc:description": {
        "de": [
          "BEAUJOLAIS-Abend\nDonnerstag, 20. November um 19.30 Uhr\nIm Café Schirrer & La Cave de Montreuil\n-------------------------\nKommentierte Verkostung des neuen Beaujolais und anderer großer Beaujolais-Weine\n\nBegrenzte Plätze - Preis: 35? pro Person\nReservierungen sind erforderlich: 03 21 90 05 79\n\nCredit: Pixabay"
        ],
        "en": [
          "BEAUJOLAIS Evening\nThursday, November 20 at 7:30pm\nAt Café Schirrer & La Cave de Montreuil\n-------------------------\nGuided tastings of Beaujolais Nouveau and other great Beaujolais wines\n\nLimited seating - Price: 35? per person\nReservations essential 03 21 90 05 79\n\nCredit : Pixabay"
        ],
        "it": [
          "Serata BEAUJOLAIS\nGiovedì 20 novembre alle 19.30\nPresso il Café Schirrer e La Cave de Montreuil\n-------------------------\nDegustazione guidata di Beaujolais Nouveau e di altri grandi vini del Beaujolais\n\nPosti limitati - Prezzo: € 35 a persona\nPrenotazione obbligatoria 03 21 90 05 79\n\nCredito: Pixabay"
        ],
        "fr": [
          "Soirée BEAUJOLAIS\nJeudi 20 novembre à 19h30\nAu Café Schirrer & La Cave de Montreuil\n-------------------------\nDégustations commentées de Beaujolais nouveaux et autres grands Beaujolais\n\nPlaces limitées - Tarif : 35€ par personne\nRéservations obligatoires  03 21 90 05 79\n\nCrédit : Pixabay"
        ],
        "es": [
          "Velada BEAUJOLAIS\nJueves 20 de noviembre a las 19h30\nEn el Café Schirrer y La Cave de Montreuil\n-------------------------\nCatas comentadas de Beaujolais Nouveau y otros grandes vinos de Beaujolais\n\nPlazas limitadas - Precio: 35 euros por persona\nImprescindible reservar 03 21 90 05 79\n\nCrédito: Pixabay"
        ],
        "nl": [
          "BEAUJOLAIS Avond\nDonderdag 20 november om 19.30 uur\nIn Café Schirrer & La Cave de Montreuil\n-------------------------\nBegeleide proeverijen van Beaujolais Nouveau en andere grote Beaujolais wijnen\n\nBeperkt aantal plaatsen - Prijs: 35 euro per persoon\nReserveren noodzakelijk 03 21 90 05 79\n\nKrediet: Pixabay"
        ]
      },
