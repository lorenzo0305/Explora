  "rdfs:comment": {
    "de": [
      "Die Pizzeria El Paso Midi empfängt Sie in Largentière. Teigwaren, Soßen, Beläge: alles hausgemacht! Wir arbeiten so viel wie möglich mit lokalen Produkten und Händlern. Nur zum Mitnehmen."
    ],
    "en": [
      "Pizzeria El Paso Midi welcomes you to Largentière. Pasta, sauces, toppings: all homemade! We work as much as possible with local products and traders. Takeaway only."
    ],
    "it": [
      "La Pizzeria El Paso Midi vi dà il benvenuto a Largentière. Pasta, salse, condimenti: tutto fatto in casa! Lavoriamo il più possibile con prodotti e commercianti locali. Solo da asporto."
    ],
    "fr": [
      "La Pizzeria El Paso Midi vous accueille à Largentière. Pâtes, sauces, garnitures : tout fais maison ! Nous travaillons au maximum avec des produits et commerçants locaux. A emporter uniquement."
    ],
    "nl": [
      "Pizzeria El Paso Midi heet u welkom in Largentière. Pasta, sauzen, toppings: allemaal huisgemaakt! We werken zoveel mogelijk met lokale producten en handelaren. Alleen afhaalmaaltijden."
    ],
    "es": [
      "La pizzería El Paso Midi le da la bienvenida a Largentière. Pasta, salsas, aderezos: ¡todo casero! Trabajamos en la medida de lo posible con productos y comerciantes locales. Sólo para llevar."
    ]
  },
