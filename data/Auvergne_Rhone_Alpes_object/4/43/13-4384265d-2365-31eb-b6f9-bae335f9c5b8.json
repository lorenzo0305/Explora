  "rdfs:comment": {
    "de": [
      "Entdeckung und Verbesserung des Fliegenfischens in den Flüssen des Puy de Dôme (Sioule, Dordogne, Couze Pavin). Erlernen der verschiedenen Techniken (trocken, Nymphe, ertränkt...). Angeln auf Hecht im Teich von Chancelade (110 ha) mit dem Boot."
    ],
    "en": [
      "Discover and perfect fly fishing on the rivers of the Puy de Dôme (Sioule, Dordogne, Couze Pavin). Learn the different techniques (dry, nymph, drowned, etc.). Pike fishing on the Etang de Chancelade (110 ha) by boat."
    ],
    "it": [
      "Scoperta e miglioramento della pesca a mosca sui fiumi del Puy de Dôme (Sioule, Dordogna, Couze Pavin). Imparare diverse tecniche (secca, ninfa, annegata...). Pesca al luccio nello stagno di Chancelade (110 ha) in barca."
    ],
    "fr": [
      "Découverte et perfectionnement de la pêche à la mouche sur les Rivières du Puy de dôme (Sioule, Dordogne, Couze Pavin). Apprentissage des différentes techniques (sèche, nymphe, noyée...). Pêche du Brochet sur l'étang de Chancelade (110 ha) en bateau."
    ],
    "nl": [
      "Ontdekking en verbetering van het vliegvissen op de rivieren van de Puy de Dôme (Sioule, Dordogne, Couze Pavin). Het leren van verschillende technieken (droog, nimf, verdronken...). Snoekvissen op de vijver van Chancelade (110 ha) per boot."
    ],
    "es": [
      "Descubrimiento y mejora de la pesca con mosca en los ríos del Puy de Dôme (Sioule, Dordoña, Couze Pavin). Aprender diferentes técnicas (en seco, ninfa, ahogado...). Pesca del lucio en el estanque de Chancelade (110 ha) en barco."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelführe r- Baptiste Carrat"
    ],
