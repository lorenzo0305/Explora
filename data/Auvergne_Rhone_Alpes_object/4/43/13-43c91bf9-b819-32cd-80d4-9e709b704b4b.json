  "rdfs:comment": {
    "de": [
      "Das Hôtel d'Aureilhe (altes Schloss von Villeneuve), Wohnsitz der Aureilhe de Villeneuve im 15. und 16. Jahrhundert, ist ein befestigter Bereich aus dem Mittelalter, in dem die architektonischen Zeugnisse des Aufstiegs des Adels im feudalen Lembron erhalten sind."
    ],
    "en": [
      "The Hôtel d'Aureilhe (old castle of Villeneuve), residence of the Aureilhe de Villeneuve in the 15th and 16th centuries, is a fortified perimeter of the Middle Ages which preserves the architectural witnesses of the rise in power of the nobility in the feudal Lembron."
    ],
    "it": [
      "L'Hôtel d'Aureilhe (antico castello di Villeneuve), residenza degli Aureilhe di Villeneuve nel XV e XVI secolo, è un perimetro fortificato del Medioevo che conserva le testimonianze architettoniche dell'ascesa al potere della nobiltà nella Lembron feudale."
    ],
    "fr": [
      "L'hôtel d'Aureilhe (vieux château de Villeneuve), résidence des Aureilhe de Villeneuve aux XV° et XVI° siècles, est un périmètre fortifié du Moyen âge qui conserve les témoins architecturaux de la montée en puissance de la noblesse dans le Lembron féodal."
    ],
    "nl": [
      "Het Hôtel d'Aureilhe (oude kasteel van Villeneuve), residentie van de Aureilhe de Villeneuve in de 15e en 16e eeuw, is een versterkte omtrek uit de Middeleeuwen die de architectonische bewijzen bewaart van de opkomst van de macht van de adel in het feodale Lembron."
    ],
    "es": [
      "El Hôtel d'Aureilhe (antiguo castillo de Villeneuve), residencia de los Aureilhe de Villeneuve en los siglos XV y XVI, es un perímetro fortificado de la Edad Media que conserva los testimonios arquitectónicos del ascenso en el poder de la nobleza en el Lembron feudal."
    ]
  },
