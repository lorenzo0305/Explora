  "rdfs:comment": {
    "de": [
      "Seit über 40 Jahren steht der Traiteur la Maison Bourne mit seinem gesamten Team aus Traiteuren, Köchen, Metzgern, Konditoren, Oberkellnern, Kellnern und Verkaufsberatern im Dienste des Guten und Schönen mit einem hervorragenden Service."
    ],
    "en": [
      "For over 40 years, the Maison Bourne catering company and its entire team of caterers, cooks, butchers, pastry chefs, maitres d'hôtel, waiters and sales advisors have been serving good food, good taste and excellent service."
    ],
    "it": [
      "Da oltre 40 anni, l'azienda di catering Maison Bourne e tutto il suo team di ristoratori, cuochi, norcini, pasticceri, maitres d'hôtel, camerieri e consulenti di vendita servono buon cibo, buon gusto e un servizio eccellente."
    ],
    "fr": [
      "Depuis plus de 40 ans, le traiteur la Maison Bourne et toute son équipe de traiteurs, cuisiniers, charcutiers, pâtissiers, maitres d’hôtel, serveurs, conseillers de vente est au service du bon, du beau avec un service d’excellence."
    ],
    "nl": [
      "Het Maison Bourne cateringbedrijf en haar hele team van cateraars, koks, varkensslagers, patissiers, maitres d'hôtel, obers en verkoopadviseurs staan al meer dan 40 jaar garant voor lekker eten, goede smaak en uitstekende service."
    ],
    "es": [
      "Desde hace más de 40 años, la empresa de catering Maison Bourne y todo su equipo de restauradores, cocineros, charcuteros, pasteleros, maitres d'hôtel, camareros y asesores comerciales sirven buena comida, buen gusto y un servicio excelente."
    ]
  },
