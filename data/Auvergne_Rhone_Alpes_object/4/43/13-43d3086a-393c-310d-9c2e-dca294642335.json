  "rdfs:comment": {
    "de": [
      "Zwei Säle: 1 Saal mit 292 Plätzen und einer 10-Meter-Leinwand, der als Art et Essai eingestuft ist, und ein weiterer Saal mit 57 Plätzen. Digitale und 3D-Ausstattung. Ton: Dolby Digital Surround. Zugang für Behinderte-Klimatisierte Räume."
    ],
    "en": [
      "Large cinema – classified “Art et Essai” (art house), digital surround sound, air conditioning. Several showings with national release films. 3D screenings."
    ],
    "it": [
      "Due cinema: 1 cinema classificato Art et Essai con 292 posti e uno schermo di 10 metri, e un altro cinema con 57 posti. Attrezzatura digitale e 3D. Suono: Dolby Digital Surround. Accesso per disabili - Sale climatizzate."
    ],
    "fr": [
      "Deux salles : 1 salle classée Art et Essai de 292 places avec un écran de 10 mètres et une autre salle de 57 places. Equipement numérique et 3D. Son : Dolby Digital Surround. Accès handicapés-Salles climatisées."
    ],
    "es": [
      "Dos salas de cine: 1 sala calificada Art et Essai con 292 butacas y una pantalla de 10 metros, y otra sala con 57 butacas. Equipamiento digital y 3D. Sonido: Dolby Digital Surround. Acceso para minusválidos - Salas con aire acondicionado."
    ],
    "nl": [
      "3 filmvertoningen per dag. Bioscoop gesloten t/m 16 oktober vanwege de aanleg van een tweede bioscoopzaal. Tijdelijke heropening op 17 oktober."
    ]
  },
