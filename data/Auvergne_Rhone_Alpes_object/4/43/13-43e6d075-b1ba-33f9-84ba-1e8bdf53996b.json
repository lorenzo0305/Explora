  "rdfs:comment": {
    "de": [
      "Im Viertel Amara können Sie die schönste Terrasse von Avoriaz nutzen, um Grillgerichte und Gerichte mit asiatischen Noten zu genießen. Ein außergewöhnlicher Rahmen und eine 100% hausgemachte Küche, die Sie im Sommer wie im Winter entdecken können."
    ],
    "en": [
      "In the Amara district, enjoy Avoriaz’s most beautiful terrace while savoring barbecue-grilled meats and dishes with Asian-inspired flavors. An exceptional setting and 100% homemade cuisine to discover in both summer and winter."
    ],
    "it": [
      "Nel quartiere Amara, approfittate della più bella terrazza di Avoriaz per gustare carni alla brace e cucina asiatica. Un ambiente eccezionale e una cucina casalinga al 100% da scoprire sia in estate che in inverno."
    ],
    "fr": [
      "Dans le quartier Amara, profitez de la plus belle terrasse d’Avoriaz pour savourer grillades au barbecue et cuisine aux notes asiatiques. Un cadre exceptionnel et une cuisine 100% maison à découvrir été comme hiver."
    ],
    "nl": [
      "In de wijk Amara geniet je van het mooiste terras van Avoriaz, terwijl je proeft van barbecuegerechten en Aziatisch geïnspireerde smaken. Een uitzonderlijke locatie met 100% huisgemaakte gerechten, het hele jaar door te ontdekken – zomer én winter."
    ],
    "es": [
      "En el barrio de Amara, aproveche la mejor terraza de Avoriaz para degustar carnes a la brasa y cocina de estilo asiático. Un marco excepcional y una cocina 100% casera para descubrir tanto en verano como en invierno."
    ]
  },
  "rdfs:label": {
