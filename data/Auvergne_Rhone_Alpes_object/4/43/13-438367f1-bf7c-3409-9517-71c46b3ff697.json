  "rdfs:comment": {
    "de": [
      "La Citoyenne ist ein 120 m2 großer Saal für Vereine, Profis und Amateure. Ein Ort, an dem man sich um Residenzen für die Kreation von Live-Darbietungen, Schulungen, Workshops, Ausstellungen, Filmvorführungen usw. versammeln kann."
    ],
    "en": [
      "La Citoyenne is a 120 m2 venue for associations, professionals and amateurs. It's a meeting place for residencies, training courses, workshops, exhibitions, screenings and more."
    ],
    "it": [
      "La Citoyenne è una sala di 120 m2 per associazioni, professionisti e dilettanti. È un luogo di incontro per residenze creative per spettacoli dal vivo, formazione, workshop, mostre, proiezioni, ecc."
    ],
    "fr": [
      "La Citoyenne est une salle de 120 m2 destinée aux associations, aux professionnels et aux amateurs. Un lieu pour se retrouver autour de résidences de création de spectacles vivants, de formations, d'ateliers, d'expositions, de projections, etc."
    ],
    "nl": [
      "La Citoyenne is een ruimte van 120 m2 voor verenigingen, professionals en amateurs. Het is een plek om samen te komen voor creatieve residenties, trainingen, workshops, tentoonstellingen, screenings en meer."
    ],
    "es": [
      "La Citoyenne es una sala de 120 m2 para asociaciones, profesionales y aficionados. Es un lugar de encuentro para residencias creativas para actuaciones en directo, formación, talleres, exposiciones, proyecciones, etc."
    ]
  },
