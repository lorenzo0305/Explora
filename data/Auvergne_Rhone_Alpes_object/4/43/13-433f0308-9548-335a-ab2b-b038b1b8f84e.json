  "rdfs:comment": {
    "de": [
      "Von den Balkonen der Valserine bis zu den Balkonen der Semine führt diese Mountainbike-Tour auf rollenden Wegen und kleinen Pfaden durch Wälder, Wiesen, Bäche, kleine Weiler und verlassene Orte."
    ],
    "en": [
      "From the balcons de la Valserine to the balcons de la Semine, this mountain bike tour crosses forests, meadows, streams, small hamlets and abandoned places on rolling roads and small trails."
    ],
    "it": [
      "Dai Balcons de la Valserine ai Balcons de la Semine, questo tour in mountain bike vi porterà attraverso boschi, prati, ruscelli, piccole frazioni e aree abbandonate su strade ondulate e stretti sentieri."
    ],
    "fr": [
      "Des balcons de la Valserine au balcons de la Semine, ce tour en VTT traverse forêts, prairies, ruisseaux, petits hameaux et lieux abandonnés par des chemins roulants et des petits sentiers."
    ],
    "nl": [
      "Van de balcons de la Valserine tot de balcons de la Semine voert deze mountainbiketocht je door bossen, weiden, beekjes, kleine gehuchten en verlaten gebieden over glooiende wegen en smalle paadjes."
    ],
    "es": [
      "De los balcones de la Valserine a los balcones de la Semine, esta excursión en bicicleta de montaña le llevará a través de bosques, prados, arroyos, pequeñas aldeas y zonas abandonadas por carreteras onduladas y senderos estrechos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours VTTAE 29 rouge - Tour de Cruchon - Espace FFC Ain Forestière"
    ]
  },
