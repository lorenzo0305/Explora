  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine Hotelerfahrung in einer komfortablen und herzlichen Atmosphäre in unserem Hotel La Découverte, das mit unserem Haus Le Clos des Cimes*** verbunden ist, das nur einen Steinwurf von unserem Wellnessbereich entfernt gebaut wurde."
    ],
    "en": [
      "We offer you a warm, comfortable hotel experience in our La Découverte establishment, combined with our Le Clos des Cimes*** house, built just a stone's throw from our SPA."
    ],
    "it": [
      "Vi offriamo un'esperienza alberghiera calda e confortevole nel nostro stabilimento La Découverte, abbinato alla nostra casa Le Clos des Cimes***, costruita a pochi passi dalla nostra SPA."
    ],
    "fr": [
      "Nous vous proposons une expérience hôtelière dans une ambiance confortable et chaleureuse au sein de notre établissement La Découverte, associé à notre maison Le Clos des Cimes***, bâtie à quelques encablures de notre SPA."
    ],
    "nl": [
      "Wij bieden je een warme en comfortabele hotelervaring in ons etablissement La Découverte, gecombineerd met ons huis Le Clos des Cimes***, dat op een steenworp afstand van onze SPA is gebouwd."
    ],
    "es": [
      "Le ofrecemos una experiencia hotelera cálida y confortable en nuestro establecimiento La Découverte, combinado con nuestra casa Le Clos des Cimes***, construida a dos pasos de nuestro SPA."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel la Découverte"
    ]
  },
