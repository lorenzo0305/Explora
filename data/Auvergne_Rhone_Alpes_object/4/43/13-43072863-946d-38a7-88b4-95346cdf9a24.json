  "rdfs:comment": {
    "de": [
      "Ein idealer Spielplatz, um mit Buckeln und Steilkurven zu experimentieren ..... Hier haben Sie die Möglichkeit, Ihre Fähigkeiten auf dem Fahrrad zu verbessern und gleichzeitig Spaß zu haben."
    ],
    "en": [
      "An ideal playground for experimenting with bumps, banked turns and other modules. It's an opportunity to improve cycling skills while having fun."
    ],
    "it": [
      "Un terreno di gioco ideale per sperimentare i dossi e le curve a gomito .... È un ottimo modo per migliorare le proprie capacità ciclistiche e divertirsi allo stesso tempo."
    ],
    "fr": [
      "Un terrain de jeu idéal pour s'expérimenter sur des bosses, des virages relevés .... C'est l'occasion d'améliorer ses compétences en vélo tout en s'amusant."
    ],
    "es": [
      "Un terreno de juego ideal para experimentar con los baches y las curvas peraltadas .... Es una forma estupenda de mejorar tus habilidades ciclistas y divertirte al mismo tiempo."
    ],
    "nl": [
      "Een ideaal speelterrein om te experimenteren met hobbels en scherpe bochten .... Het is een geweldige manier om je fietsvaardigheden te verbeteren en tegelijkertijd plezier te hebben."
    ]
  },
