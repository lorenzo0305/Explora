  "rdfs:comment": {
    "de": [
      "Die Ferme du Perron bietet Ihnen authentische Produkte aus der Region: Rind-, Kalb- und Schweinefleisch aus Freilandhaltung, das vor Ort zerlegt wird, Wurstwaren und Fertiggerichte, Honig und hausgemachtes Lebkuchenbrot."
    ],
    "en": [
      "Authentic local products: farm beef, veal and pork meat cut on the spot, cooked meats, homemade honey and gingerbredad (producers - growers)."
    ],
    "it": [
      "La Ferme du Perron offre autentici prodotti locali: manzo, vitello e maiale di fattoria macellati in loco, salumi e piatti pronti, miele e pan di zenzero fatto in casa."
    ],
    "fr": [
      "La Ferme du Perron vous offre d'authentiques produits du terroir : viande de bœuf, veau et porc fermier découpée sur place, charcuterie et préparations cuisinées, miel et pain d'épices maison."
    ],
    "es": [
      "La Ferme du Perron ofrece auténticos productos locales: carne de buey, ternera y cerdo de granja sacrificados in situ, charcutería y platos preparados, miel y pan de especias casero."
    ],
    "nl": [
      "La Ferme du Perron biedt authentieke streekproducten: rundvlees, kalfsvlees en varkensvlees van de boerderij dat ter plekke wordt geslacht, vleeswaren en kant-en-klaarmaaltijden, honing en zelfgemaakte peperkoek."
    ]
  },
  "rdfs:label": {
