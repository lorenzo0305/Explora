  "rdfs:comment": {
    "de": [
      "Pizzeria zum Mitnehmen im Hotel le Chamois. Bestellen Sie eine köstliche Pizza, die Sie in der Bar Underground genießen können, oder nehmen Sie sie mit in Ihr Apartment.\r\nFinden Sie die Speisekarte auf unserer Website."
    ],
    "en": [
      "Pizzeria takeaway at Hôtel le Chamois. Order a delicious pizza to enjoy at the Underground bar or take it home with you. \r\nFind the menu on our website."
    ],
    "it": [
      "Pizzeria da asporto all'Hôtel le Chamois. Ordinate una deliziosa pizza da gustare al bar Underground o da portare a casa.\r\nTrovate il menu sul nostro sito web."
    ],
    "fr": [
      "Pizzeria à emporter à l'Hôtel le Chamois. Commandez une délicieuse pizza à déguster au bar Underground ou emportez là avec vous à l'appartement. \r\nRetrouvez le menu sur notre site Internet."
    ],
    "es": [
      "Pizzería para llevar en el Hôtel le Chamois. Pida una deliciosa pizza para disfrutar en el bar Underground o llévesela a casa.\r\nConsulte el menú en nuestro sitio web."
    ],
    "nl": [
      "Afhaalpizzeria in Hôtel le Chamois. Bestel een heerlijke pizza om van te genieten in de Underground bar of neem hem mee naar huis. \r\nVind het menu op onze website."
    ]
  },
