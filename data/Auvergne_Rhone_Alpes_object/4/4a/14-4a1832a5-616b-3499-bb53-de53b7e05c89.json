  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0b7534ed-fc20-37e7-bf57-f06092ab13af",
      "dc:description": {
        "de": [
          "Große Auswahl an Gemüse und roten Früchten der Saison. Spezialitäten: Salate, Radieschen, Bohnen, Spinat, Tomaten, Sandkartoffeln...und alle Kräuter (Basilikum, Minze, Petersilie, Estragon...), Obst der Saison."
        ],
        "en": [
          "Wide range of vegetables and red fruits in season. Specialties: salads, radishes, beans, spinach, tomatoes, sand potatoes...and all herbs (basil, mint, parsley, tarragon...), fruits in season."
        ],
        "it": [
          "Ampia scelta di verdure e frutti rossi di stagione. Specialità: insalate, ravanelli, fagioli, spinaci, pomodori, patate di sabbia... e tutte le erbe aromatiche (basilico, menta, prezzemolo, dragoncello...), frutta di stagione."
        ],
        "fr": [
          "Grande gamme de légumes et de fruits rouges de saison. Spécialités : salades, radis, haricots, épinards, tomates, pommes de terre de sable...et toutes les herbes (basilic, menthe, persil, estragon...), fruits de saison."
        ],
        "nl": [
          "Breed scala aan groenten en rood fruit in het seizoen. Specialiteiten: salades, radijsjes, bonen, spinazie, tomaten, zandaardappelen...en alle kruiden (basilicum, munt, peterselie, dragon...), seizoensfruit."
        ],
        "es": [
          "Amplia gama de verduras y frutos rojos de temporada. Especialidades: ensaladas, rábanos, judías, espinacas, tomates, patatas de arena... y todas las hierbas (albahaca, menta, perejil, estragón...), frutas de temporada."
        ]
      },
      "@type": [
        "Description"
      ],
