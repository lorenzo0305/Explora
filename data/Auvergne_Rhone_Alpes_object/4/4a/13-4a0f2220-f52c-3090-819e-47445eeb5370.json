  "rdfs:comment": {
    "de": [
      "Über den Tennisplätzen von Vallandry, Frisbee in der Hand, werden Sie auf einem freien Kurs mit 6 Koffern spielen und versuchen, es in einem minimalen Wurf zu tun."
    ],
    "en": [
      "Located above the tennis courts of Vallandry, frisbee in the hand you will play on a free course with 6 paniers, trying to do it in a mininum throw."
    ],
    "it": [
      "Tenendo in mano un frisbee, si corre su un percorso ad accesso libero di 6 canestri, cercando di effettuare il minor numero di lanci possibile."
    ],
    "fr": [
      "Frisbee à la main vous évoluerez sur un parcours libre d'accès composé de 6 paniers en tentant de réaliser un minimum de lancé."
    ],
    "nl": [
      "Met een frisbee in de hand leg je een vrij parcours af dat bestaat uit 6 manden en probeer je zo min mogelijk worpen te maken."
    ],
    "es": [
      "Con un frisbee en la mano, correrás por un recorrido de acceso libre de 6 canastas, intentando hacer el menor número posible de lanzamientos."
    ]
  },
