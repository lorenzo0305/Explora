  "rdfs:comment": {
    "de": [
      "Sie stellen Ihr Brot her und suchen nach authentischen Mehlen?\r\nIn der Haute Loire, in der Moulin du Lignon, bietet Ihnen ein handwerklicher Müller seine Mehle an!"
    ],
    "en": [
      "Do you make your own bread and are you looking for authentic flours?\r\nIn Haute Loire, at the Moulin du Lignon, an artisan miller offers you his flours!"
    ],
    "it": [
      "Fate il pane da soli e siete alla ricerca di farine autentiche?\r\nNell'Alta Loira, al Moulin du Lignon, un mugnaio artigiano vi offre le sue farine!"
    ],
    "fr": [
      "Vous fabriquez votre pain et vous recherchez des farines authentiques ?\r\nEn Haute Loire, au Moulin du Lignon, un artisan meunier vous propose ses farines !"
    ],
    "es": [
      "¿Hace usted su propio pan y busca harinas auténticas?\r\nEn el Alto Loira, en el Moulin du Lignon, un molinero artesano le ofrece sus harinas"
    ],
    "nl": [
      "Maakt u zelf uw brood en bent u op zoek naar authentiek meel?\r\nIn de Haute Loire, bij de Moulin du Lignon, biedt een ambachtelijke molenaar u zijn meel aan!"
    ]
  },
  "rdfs:label": {
