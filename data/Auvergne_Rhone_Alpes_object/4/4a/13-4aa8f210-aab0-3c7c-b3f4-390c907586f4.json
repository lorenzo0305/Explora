  "rdfs:comment": {
    "de": [
      "Im Jean-Perdrix-Park drehen sich die beiden spiralförmigen Türme um sich selbst und ragen über 50 Meter in die Höhe. Sie bieten den Besuchern, die sie umrunden, einen bewegten, immer wieder neuen Anblick."
    ],
    "en": [
      "In the Parc Jean-Perdrix, the two spiral-shaped towers twist in on themselves, rising to heights of over 50 metres. They offer a moving, ever-changing spectacle to visitors as they make their way around."
    ],
    "it": [
      "Nel Parco Jean-Perdrix, le due torri elicoidali si attorcigliano e raggiungono un'altezza di oltre 50 metri. Offrono uno spettacolo in movimento e in continua evoluzione ai visitatori che vi camminano intorno."
    ],
    "fr": [
      "Au parc Jean-Perdrix, les deux tours de forme hélicoïdale vrillent sur elles-mêmes et s’élèvent à plus de 50 mètres de hauteur. Elles offrent un spectacle mouvant, toujours différent, aux visiteurs qui en font le tour."
    ],
    "nl": [
      "In het Parc Jean-Perdrix draaien de twee spiraalvormige torens om zichzelf heen en bereiken een hoogte van meer dan 50 meter. Ze bieden bezoekers een bewegend, steeds veranderend spektakel."
    ],
    "es": [
      "En el parque Jean-Perdrix, las dos torres helicoidales giran y se elevan a más de 50 metros de altura. Ofrecen un espectáculo en movimiento y siempre cambiante a los visitantes que pasean a su alrededor."
    ]
  },
  "rdfs:label": {
