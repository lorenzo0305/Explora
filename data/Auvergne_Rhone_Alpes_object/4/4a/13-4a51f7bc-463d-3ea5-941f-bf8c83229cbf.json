  "rdfs:comment": {
    "de": [
      "Savoyardische Spezialitäten mit Geschmortem; Pizzas zum Mitnehmen; ganzjährig täglich geöffnet."
    ],
    "en": [
      "Mountain specialities cooked over a wood fire. Take-out pizza. Open 7d/7d year round."
    ],
    "it": [
      "Rifugiatevi con noi e scoprite la migliore cucina di montagna. I nostri prodotti sono cucinati con prodotti locali. Che siate principianti o esperti, scoprite la fonduta, la vercouline, la raclette e i ravioli gratinati."
    ],
    "fr": [
      "Trouvez refuge chez nous et découvrez quelques incontournables de la cuisine de montagne. Nos produits sont cuisinés à partir de produits locaux. Néophytes ou expert en la matière, découvrez fondue, vercouline, raclette et gratin de ravioles façon ranch."
    ],
    "nl": [
      "Schuil bij ons en ontdek de beste bergkeuken. Onze producten worden bereid met lokale producten. Of u nu een beginner of een expert bent, ontdek fondue, vercouline, raclette en gegratineerde ravioli in ranchstijl."
    ],
    "es": [
      "Refúgiese con nosotros y descubra la mejor cocina de montaña. Nuestros productos se cocinan con productos locales. Tanto si es principiante como experto, descubra la fondue, la vercouline, la raclette y los raviolis gratinados."
    ]
  },
