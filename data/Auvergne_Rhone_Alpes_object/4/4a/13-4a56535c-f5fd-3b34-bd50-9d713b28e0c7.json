  "rdfs:comment": {
    "de": [
      "Der Pumptrack ist ein Rundkurs mit Buckeln und Steilkurven, der vor allem von Mountainbikes, BMX-Rädern oder Rollern genutzt wird. Mehrere Strecken mit unterschiedlichen Schwierigkeitsgraden."
    ],
    "en": [
      "Pumptrack is a looped course of bumps and banked turns used by mountain bikes, BMX bikes and scooters. Several multi-level courses."
    ],
    "it": [
      "Il Pumptrack è un percorso ad anello composto da dossi e curve strette, utilizzato in particolare da mountain bike, BMX e scooter. Diversi percorsi a più livelli."
    ],
    "fr": [
      "Le Pumptrack est un parcours en boucle, constitué de bosses et de virages relevés qui est utilisé notamment par les VTT, les BMX ou les trottinettes. Plusieurs parcours multi niveaux."
    ],
    "nl": [
      "Pumptrack is een lusvormig parcours met hobbels en scherpe bochten, dat vooral wordt gebruikt door mountainbikes, BMX-fietsen en scooters. Verschillende parcours met meerdere niveaus."
    ],
    "es": [
      "El Pumptrack es un circuito formado por baches y curvas cerradas, utilizado sobre todo por bicicletas de montaña, BMX y scooters. Varios circuitos de varios niveles."
    ]
  },
