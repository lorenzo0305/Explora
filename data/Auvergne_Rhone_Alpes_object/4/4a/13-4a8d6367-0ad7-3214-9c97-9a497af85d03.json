  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung der Innenräume und der Außenanlagen. Das Schloss aus der Regency-Epoche, das zwischen dem 15. und 18. Jahrhundert aus polychromen Ziegeln erbaut wurde, ist eines der Juwelen der Architektur in Bourbonnaise."
    ],
    "en": [
      "Guided tour of interiors and exteriors. The Regency period castle built in polychrome bricks between the 15th and 18th centuries is one of the jewels of Bourbonnais architecture."
    ],
    "it": [
      "Visita guidata degli interni e degli esterni. Il castello della Reggenza, costruito in mattoni policromi tra il XV e il XVIII secolo, è uno dei gioielli dell'architettura borbonica."
    ],
    "fr": [
      "Visite guidée des intérieurs et des extérieurs. Le château d'époque Régence construit en briques polychromes entre le XVe et le XVIIIe siècle est l'un des joyaux de l'architecture bourbonnaise."
    ],
    "es": [
      "Visita guiada por el interior y el exterior. El castillo de la Regencia, construido en ladrillo policromado entre los siglos XV y XVIII, es una de las joyas de la arquitectura Bourbonnais."
    ],
    "nl": [
      "Rondleiding door het interieur en exterieur. Het Regency kasteel, gebouwd in polychrome baksteen tussen de 15e en 18e eeuw, is een van de juwelen van de Bourbonnais architectuur."
    ]
  },
