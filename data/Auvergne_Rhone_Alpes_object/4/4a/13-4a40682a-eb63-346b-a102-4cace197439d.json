  "rdfs:comment": {
    "de": [
      "Cave Noisel: Ein Unternehmen aus Royans, das sich für nachhaltige Entwicklung einsetzt. Ein soziales Unternehmen mit behinderten Arbeitnehmern, dessen Tätigkeit in der Herstellung von Nebenprodukten auf der Basis von Walnüssen besteht.\r\nEntdecken Sie die Kellerei bei einer geführten Besichtigung"
    ],
    "en": [
      "The walnut oil mill and cellar are right next door. Discover the virtues and grandeur of the magnificent walnut tree! Treat yourself to this gourmet stop which includes a short film and tasting. Nut-flavoured sweets."
    ],
    "it": [
      "Cave Noisel: un'azienda di Royans al centro dello sviluppo sostenibile. Un'impresa sociale composta da dipendenti disabili, la cui attività consiste nella produzione di sottoprodotti a base di noci.\r\nVisita guidata della cantina"
    ],
    "fr": [
      "Cave Noisel : Entreprise du Royans, au cœur du développement durable. Une entreprise sociale composée de salariés en situation de handicap dont l’activité est la fabrication de produits dérivés à base de Noix.\r\nDécouvrez la cave à travers la visite guidée"
    ],
    "nl": [
      "Van de oliemolen tot de kelder is maar een kleine stap. U ontdekt de krachten en waarde van deze prachtige boom, de walnotenboom! Een korte film en een proeverij, laat u verleiden door deze smakelijke plek. Lekkernijen op basis van noten."
    ],
    "es": [
      "Cave Noisel: una empresa royana en el corazón del desarrollo sostenible. Una empresa social formada por empleados discapacitados cuya actividad es la fabricación de subproductos a base de frutos secos.\r\nVisita guiada de la bodega"
    ]
  },
