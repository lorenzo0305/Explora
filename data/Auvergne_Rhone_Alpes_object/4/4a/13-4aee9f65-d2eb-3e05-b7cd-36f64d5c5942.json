  "rdfs:comment": {
    "de": [
      "Die neue Ausgabe 2025 des Festivals Musiques en Stock wird von der Stadtverwaltung von Scionzier in Zusammenarbeit mit dem Verein MACADAM organisiert! Das Festival bleibt kostenlos und findet im Stadtzentrum statt."
    ],
    "en": [
      "A new 2025 edition of the Musiques en Stock festival organized by the Municipality of Scionzier in collaboration with the MACADAM association! The festival remains free and will take place in the town center."
    ],
    "it": [
      "Nuova edizione 2025 del festival Musiques en Stock, organizzato dal Comune di Scionzier in collaborazione con l'associazione MACADAM! Il festival rimane gratuito e si svolgerà nel centro del paese."
    ],
    "fr": [
      "Nouvelle édition 2025 du festival Musiques en Stock organisée par la Municipalité de Scionzier en collaboration avec l’association MACADAM ! Le festival reste gratuit et se déroulera au centre ville."
    ],
    "es": [
      "Nueva edición 2025 del festival Musiques en Stock, organizado por el Ayuntamiento de Scionzier en colaboración con la asociación MACADAM. El festival seguirá siendo gratuito y tendrá lugar en el centro de la ciudad."
    ],
    "nl": [
      "Een nieuwe editie 2025 van het festival Musiques en Stock georganiseerd door de gemeente Scionzier in samenwerking met de vereniging MACADAM! Het festival blijft gratis en vindt plaats in het stadscentrum."
    ]
  },
