  "rdfs:comment": {
    "de": [
      "Restaurant - Brasserie - Glacier\r\nSerge und Sylvie begrüssen Sie jeden Tag auf den Allées Provençales.\r\nNachmittags Teestube mit Crêpes und diversen Desserts."
    ],
    "en": [
      "Restaurant - Brasserie - Ice-cream parlour"
    ],
    "it": [
      "Ristorante - Brasserie - Gelateria\r\nSerge e Sylvie vi accolgono ogni giorno nei vicoli provenzali.\r\nSala da tè tutti i pomeriggi con pancake e vari dessert."
    ],
    "fr": [
      "Restaurant - Brasserie - Glacier\r\nSerge et Sylvie vous accueillent sur les allées provençales tous les jours.\r\nSalon de thé toutes les après-midi avec crêpes et divers desserts."
    ],
    "es": [
      "Restaurante - Brasserie - Heladería\r\nSerge y Sylvie le dan la bienvenida a los callejones provenzales todos los días.\r\nSalón de té todas las tardes con tortitas y postres variados."
    ],
