  "rdfs:comment": {
    "de": [
      "Le chant des graines bietet Produkte des Bauernhofs zum Verkauf an, die nach den Richtlinien des ökologischen Landbaus zertifiziert sind: Setzlinge, Gemüse, verarbeitete Produkte, Eier, Heilpflanzen, Saatgut usw.\r\nEs ist auch ein pädagogischer Empfangsort mit verschiedenen organisierten Workshops."
    ],
    "en": [
      "Le chant des graines sells certified organic farm produce: seedlings, vegetables, processed products, eggs, medicinal plants, seeds, etc. \r\nIt's also an educational venue with a range of workshops."
    ],
    "it": [
      "Le chant des graines vende i prodotti della fattoria certificati biologici: piantine, ortaggi, prodotti trasformati, uova, piante medicinali, semi, ecc.\r\nÈ anche un centro educativo, con una serie di laboratori."
    ],
    "fr": [
      "Le chant des graines propose à la vente des produits de la ferme, certifiés Agriculture Biologique : plants, légumes, produits transformés, œufs, plantes médicinales, semences... \r\nC'est aussi un lieu d'accueil pédagogique avec divers ateliers organisés."
    ],
    "nl": [
      "Le chant des graines verkoopt producten van de boerderij die biologisch gecertificeerd zijn: zaailingen, groenten, verwerkte producten, eieren, medicinale planten, zaden, enz.\r\nHet is ook een educatief centrum met verschillende workshops."
    ],
    "es": [
      "Le chant des graines vende productos de la granja con certificación ecológica: plantones, hortalizas, productos transformados, huevos, plantas medicinales, semillas, etc.\r\nTambién es un centro educativo, con diversos talleres."
    ]
  },
