  "rdfs:comment": {
    "de": [
      "Bäckerei, Schokoladenfabrik, Süßwarenfabrik, Konditorei, Spezialbrot und Bio-Brot, Makronen und Makronenpyramiden, Vacherins, Eis, Quiches, Pizzas, Hochzeiten, Geburtstage... Ein Genuss für Augen und Gaumen!"
    ],
    "en": [
      "Bakery, chocolate-maker, confectionery, patisseries and cakes, special bread and Organic bread, macarons and macaron pyramids, vacherin desserts, ice creams, quiches, pizzas, wedding and anniversaries… A delight for both the eyes and taste buds!"
    ],
    "it": [
      "Panetteria, cioccolateria, pasticceria, pani speciali e pani biologici, amaretti e piramidi di amaretti, vacherin, gelati, quiche, pizze, matrimoni, compleanni... Una delizia per gli occhi e per le papille gustative!"
    ],
    "fr": [
      "Boulangerie, chocolaterie, confiserie, pâtisserie, pain spéciaux et pains Bio, macarons et pyramides de macarons, vacherins, glaces, quiches, pizzas, mariages, anniversaires... Un régal pour les yeux et les papilles !"
    ],
    "es": [
      "Panadería, chocolate, confitería, pastelería, panes especiales y panes ecológicos, macarrones y pirámides de macarrones, vacherins, helados, quiches, pizzas, bodas, cumpleaños... Un placer para la vista y el paladar"
    ],
    "nl": [
      "Bakker, chocolade, snoep, zoete lekkernijen, speciaal brood en biologische brood, macarons, macaronpyramides, schuimtaart, ijs, quiches, pizza's, huwelijken, verjaardagen, etc. Een genot voor ogen en mond!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au fournil Maison Clapot"
    ]
  },
