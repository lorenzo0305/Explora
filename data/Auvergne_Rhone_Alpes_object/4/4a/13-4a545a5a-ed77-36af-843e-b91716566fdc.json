  "rdfs:comment": {
    "de": [
      "OsKar bietet Ihnen die Möglichkeit, Ihre Sessel und Stühle mit traditionellen oder modernen Polsterungen neu zu beziehen. Wenn Sie die Kunst des Polsterns erlernen möchten, können Sie an den Kursen im OsKar-Atelier teilnehmen."
    ],
    "en": [
      "OsKar can refurbish your seats and armchairs with traditional or modern upholstery. If you'd like an introduction to upholstery and professional techniques, come and take part in the courses offered by the OsKar workshop."
    ],
    "it": [
      "OsKar può riparare i vostri sedili e poltrone con rivestimenti tradizionali o moderni. Se desiderate un'introduzione alla tappezzeria e alle tecniche professionali, venite a partecipare ai corsi offerti dal laboratorio OsKar."
    ],
    "fr": [
      "OsKar vous propose la réfection de vos sièges et fauteuils en garniture traditionnelle ou moderne. Si vous souhaitez vous initier à la tapisserie et aux gestes professionnels, venez participer aux cours proposés à l’atelier OsKar."
    ],
    "es": [
      "OsKar puede reparar sus asientos y sillones con tapicería tradicional o moderna. Si desea iniciarse en la tapicería y las técnicas profesionales, venga a participar en los cursos que se ofrecen en el taller de OsKar."
    ],
    "nl": [
      "OsKar kan je stoelen en fauteuils herstellen met traditionele of moderne stoffering. Wil je een introductie in stofferen en professionele technieken, kom dan deelnemen aan de cursussen die worden aangeboden in het OsKar atelier."
    ]
  },
  "rdfs:label": {
