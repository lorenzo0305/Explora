  "rdfs:comment": {
    "de": [
      "Ein frei zugänglicher Bouleplatz in einer grünen Umgebung mit Pumptrack, Spielplatz, Seilbahn, Tischtennis, Fitnessbereich, Ladestation? Perfekt zum Spielen, Bewegen und Entspannen in Largentière!"
    ],
    "en": [
      "An open-access petanque area in a green setting, with pumptrack, playground, zip line, table tennis, fitness area, recharging point? Perfect for playing, moving or relaxing in Largentière!"
    ],
    "it": [
      "Un campo da petanque ad accesso libero in un ambiente verdeggiante, con pumptrack, area giochi, teleferica, ping-pong, area fitness, punto di ricarica, ecc Il luogo ideale per giocare, muoversi o rilassarsi a Largentière!"
    ],
    "fr": [
      "Un terrain de pétanque en accès libre dans un cadre verdoyant, avec pumptrack, aire de jeux, tyrolienne, ping-pong, espace fitness, borne de recharge… Parfait pour jouer, bouger ou se détendre à Largentière !"
    ],
    "es": [
      "Un campo de petanca de libre acceso en un entorno frondoso, con pumptrack, zona de juegos, tirolina, ping-pong, zona de fitness, punto de recarga, etc ¡El lugar perfecto para jugar, moverse o relajarse en Largentière!"
    ],
    "nl": [
      "Een petanqueterrein met vrije toegang in een groene omgeving, met pumptrack, speeltuin, tokkelbaan, tafeltennis, fitnessruimte, oplaadpunt, enz De perfecte plek om te spelen, te bewegen of te ontspannen in Largentière!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terrain de pétanque"
    ]
  },
