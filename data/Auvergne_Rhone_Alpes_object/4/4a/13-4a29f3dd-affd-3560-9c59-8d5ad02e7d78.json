  "rdfs:comment": {
    "de": [
      "Das Vercors auf einem Plateau! Fahren Sie von einem der Sammelpunkte aus zur Skistation Font d'Urle! Eine umweltfreundlichere, günstigere und praktischere Art, zum Skifahren zu gehen."
    ],
    "en": [
      "The Vercors on a plateau! Take off for the Font d'Urle ski resort from one of our pick-up points! A more ecological, economical and practical way to go skiing."
    ],
    "it": [
      "Il Vercors su un altopiano! Partite per la stazione sciistica di Font d'Urle da uno dei punti di raccolta! È un modo più ecologico, più economico e più comodo di andare a sciare."
    ],
    "fr": [
      "Le Vercors sur un plateau ! Partez pour la station de Font d'Urle depuis l'un des points de ramassage ! Une façon plus écologique, plus économique et plus pratique d'aller faire du ski."
    ],
    "es": [
      "El Vercors en una meseta Despegue hacia la estación de esquí de Font d'Urle desde uno de los puntos de recogida Es una forma más ecológica, económica y cómoda de esquiar."
    ],
    "nl": [
      "De Vercors op een plateau! Vertrek naar het skigebied Font d'Urle vanaf een van de opstapplaatsen! Het is een groenere, goedkopere en handigere manier om te gaan skiën."
    ]
  },
  "rdfs:label": {
