  "rdfs:comment": {
    "de": [
      "L'Autre Lieu ist ein Theater, das sich für die Aufwertung des sprachlichen und kulturellen Erbes seiner Region einsetzt.\r\n Es bietet Aufführungen rund um den \"parler gaga\" und ein Programm mit französischen Chansons."
    ],
    "en": [
      "L?Autre Lieu is a theater that promotes the linguistic and cultural heritage of its region.\r\n It offers shows based on the gaga language, and a program of French chanson."
    ],
    "it": [
      "L'Autre Lieu è un teatro che promuove il patrimonio linguistico e culturale della sua regione.\r\n Offre spettacoli basati sulla lingua gaga e un programma di chanson francese."
    ],
    "fr": [
      "L’Autre Lieu est un théâtre qui revendique la mise en valeur du patrimoine linguistique et culturel de sa région.\r\n Il propose des spectacles autour du parler gaga, et une programmation chanson française."
    ],
    "nl": [
      "L'Autre Lieu is een theater dat het linguïstische en culturele erfgoed van de regio promoot.\r\n Het biedt voorstellingen gebaseerd op de gaga-taal en een programma met Franse chansons."
    ],
    "es": [
      "L'Autre Lieu es un teatro que promueve el patrimonio lingüístico y cultural de su región.\r\n Ofrece espectáculos basados en la lengua gaga y un programa de chanson francesa."
    ]
  },
