  "rdfs:comment": {
    "de": [
      "Das Boeuf d'Argent ist ein Familienunternehmen, das eine französisch-italienische Gourmetküche mit frischen Produkten im Rhythmus der Jahreszeiten und hausgemachten Speisen anbietet. Das angebotene Abenteuer erreicht seinen Höhepunkt mit dem Menü \"accords mets-vins\"."
    ],
    "en": [
      "Le Boeuf d'Argent is a family business that offers French-Italian bistro cuisine, fresh products following the rhythm of the seasons and homemade. The proposed adventure is at its peak with the food and wine pairing menu."
    ],
    "it": [
      "Le Boeuf d'Argent è un'azienda a conduzione familiare che offre una cucina gourmet franco-italiana con prodotti freschi di stagione e ingredienti fatti in casa. L'avventura culmina con il menu di abbinamento vino e cibo."
    ],
    "fr": [
      "Le Boeuf d'Argent est une entreprise familiale qui propose une cuisine gastronomique franco-italienne avec des produits frais suivant le rythme des saisons et du fait maison. L’aventure proposée est à l’apogée avec le menu accords mets-vins."
    ],
    "nl": [
      "Le Boeuf d'Argent is een familiebedrijf dat gastronomische Frans-Italiaanse gerechten aanbiedt met verse seizoensproducten en huisgemaakte ingrediënten. Het avontuur wordt tot een hoogtepunt gebracht met het wijn-spijs pairing menu."
    ],
    "es": [
      "Le Boeuf d'Argent es un negocio familiar que ofrece cocina gourmet franco-italiana con productos frescos de temporada e ingredientes caseros. La aventura culmina con el menú maridaje."
    ]
  },
