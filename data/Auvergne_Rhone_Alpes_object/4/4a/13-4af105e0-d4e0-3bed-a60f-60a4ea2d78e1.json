  "rdfs:comment": {
    "de": [
      "In der Auberge des Collines in der Region Drôme des Collines bietet Caty eine einfache, kreative Küche in einer freundlichen Atmosphäre oder einen ruhigen Aufenthalt in einem der sieben komfortablen Zimmer mit Blick auf einen privaten Park."
    ],
    "en": [
      "With their simple but still creative cooking based on local products, Caty and Luis offer you a quality service. Just enjoy the serenity of a site. 8 rooms in a small private and closed park. Private parking."
    ],
    "it": [
      "All'Auberge des Collines, nella Drôme des Collines, Caty offre una cucina semplice e creativa in un'atmosfera amichevole, oppure un soggiorno tranquillo in una delle 7 confortevoli camere con vista su un parco privato."
    ],
    "fr": [
      "A l'Auberge des Collines, en Drôme des Collines, Caty propose une cuisine simple, créative dans une ambiance conviviale, ou un séjour au calme, dans une des 7 chambres confortables donnant sur un parc privé."
    ],
    "nl": [
      "In de Auberge des Collines, in Drôme des Collines, biedt Caty een eenvoudige, creatieve keuken in een vriendelijke sfeer, of een rustig verblijf in een van de 7 comfortabele kamers met uitzicht op een privépark."
    ],
    "es": [
      "En el Auberge des Collines, en Drôme des Collines, Caty ofrece una cocina sencilla y creativa en un ambiente acogedor, o una estancia tranquila en una de las 7 cómodas habitaciones con vistas a un parque privado."
    ]
  },
