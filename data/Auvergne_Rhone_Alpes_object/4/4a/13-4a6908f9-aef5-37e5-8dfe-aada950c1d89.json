  "rdfs:comment": {
    "de": [
      "In der alten Schule von Chenereilles, die von der Gemeinde zur Verfügung gestellt wurde, am Place de la Mairie, gegenüber der Kirche, hat der neue Verein \"La Communauté de l'Asso\" sein Reparaturcafé eröffnet."
    ],
    "en": [
      "The new association \"La Communauté de l'Asso\" has opened its café-repair in the former Chenereilles school, made available by the municipality on Place de la Mairie, opposite the church."
    ],
    "it": [
      "La nuova associazione \"La Communauté de l'Asso\" ha aperto il suo bar-ristorante nell'ex scuola di Chenereilles messa a disposizione dal Comune in Place de la Mairie, di fronte alla chiesa."
    ],
    "fr": [
      "Dans l'ancienne école de Chenereilles mise à disposition par la municipalité, place de la Mairie, face à l’église, la nouvelle association \"La Communauté de l’Asso\" a ouvert son café-réparation."
    ],
    "es": [
      "La nueva asociación \"La Communauté de l'Asso\" ha abierto su café-reparación en la antigua escuela de Chenereilles cedida por el ayuntamiento, en la Place de la Mairie, frente a la iglesia."
    ],
    "nl": [
      "De nieuwe vereniging \"La Communauté de l'Asso\" heeft haar café-restaurant geopend in de voormalige school Chenereilles die door de gemeente ter beschikking is gesteld op de Place de la Mairie, tegenover de kerk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La vieille école : bar associatif"
    ]
  },
