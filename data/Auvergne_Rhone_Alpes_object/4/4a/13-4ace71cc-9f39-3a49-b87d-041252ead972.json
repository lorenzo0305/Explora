  "rdfs:comment": {
    "de": [
      "Die Boutique Saint Jean, ein Besuch im Herzen der regionalen Tradition. Ein idealer Ort, um alle Feinschmecker und Liebhaber authentischer, aus der Region stammender Rezepte zufrieden zu stellen."
    ],
    "en": [
      "Production and direct sale of ravioles, quenelles and fresh pasta in the Saint Jean shop, an ideal venue to please any gourmet or food fan looking for authentic locally-made dishes."
    ],
    "it": [
      "La boutique Saint Jean, una visita al cuore della tradizione regionale. È il luogo ideale per i buongustai e gli amanti delle autentiche ricette locali."
    ],
    "fr": [
      "La boutique Saint Jean, une visite au coeur de la tradition régionale. Un lieu idéal pour satisfaire tous les gourmands et les amateurs de recettes authentiques, issues du terroir."
    ],
    "nl": [
      "Vervaardiging en directe verkoop van raviole, quenelles en verse pasta. De Saint Jean boetiek, een bezoek aan het hart van de regionale tradities. Een ideale plek voor fijnproevers en liefhebbers van traditionele recepten uit de streek."
    ],
    "es": [
      "La boutique Saint Jean, una visita al corazón de la tradición regional. Es el lugar ideal para gourmets y amantes de las auténticas recetas locales."
    ]
  },
