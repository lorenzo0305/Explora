  "rdfs:comment": {
    "de": [
      "Das größte Escape Game in der Region Drôme-Ardéche!\r\n5 Räume, 5 Welten, 5 Szenarien. Erleben Sie einen einzigartigen Moment mitten im Stadtzentrum von Valence!"
    ],
    "en": [
      "The biggest escape game in Drôme-Ardéche!\r\n5 rooms, 5 universes, 5 scenarios. Come and have fun for a unique moment in the city center of Valence!"
    ],
    "it": [
      "Con la famiglia, gli amici o i colleghi, scoprite il primo escape game di Valence! L'escape game chiuso di Valence offre 3 divertenti missioni dedicate a misteri ed enigmi! E per i più audaci, offriamo anche 2 Dark Room!"
    ],
    "fr": [
      "Entre famille, entre amis, entre collègues, découvrez le premier escape game de Valence! Closed escape game Valence, c'est 3 missions ludiques dédiées aux mystères et aux énigmes! Et pour les plus audacieux, nous proposons également 2 Dark Rooms!"
    ],
    "nl": [
      "Het grootste ontsnappingsspel in Drôme-Ardéche!\r\n5 kamers, 5 werelden, 5 scenario's. Kom genieten van een unieke ervaring in het centrum van Valence!"
    ],
    "es": [
      "Con la familia, los amigos o los colegas, ¡descubra el primer juego de escape en Valence! El juego de escape cerrado Valence ofrece 3 divertidas misiones dedicadas a misterios y enigmas Y para los más atrevidos, ¡también ofrecemos 2 habitaciones oscuras!"
    ]
  },
  "rdfs:label": {
