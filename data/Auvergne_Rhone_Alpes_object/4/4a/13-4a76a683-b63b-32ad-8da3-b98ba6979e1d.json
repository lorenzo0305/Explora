  "rdfs:comment": {
    "de": [
      "Tischkultur, Sortiment an Gebrauchs- und Dekorationskeramik aus Steingut.\r\nHerstellung von personalisierten Stücken auf Bestellung, Geschenke zur Geburt, Hochzeit oder anderen Anlässen.\r\nKurse & Entdeckungsworkshops auf Reservierung."
    ],
    "en": [
      "Tableware, range of functional and decorative stoneware ceramics. \r\nCustom-made pieces, gifts for births, weddings or other occasions.\r\nCourses and introductory workshops available by appointment."
    ],
    "it": [
      "Vasellame, gamma di ceramiche utilitarie e decorative in gres.\r\nPezzi personalizzati realizzati su ordinazione, per regali di nascita, matrimonio o altre occasioni.\r\nCorsi e laboratori su prenotazione."
    ],
    "fr": [
      "Arts de la table, gamme de céramiques utilitaires et décoratives en grès. \r\nRéalisation sur commande de pièces personnalisées, cadeaux de naissance, mariage ou autres occasions.\r\nCours & ateliers découvertes sur réservation."
    ],
    "es": [
      "Vajilla, gama de cerámica de gres utilitaria y decorativa.\r\nPiezas personalizadas por encargo, para regalos de nacimientos, bodas u otras ocasiones.\r\nClases y talleres con cita previa."
    ],
    "nl": [
      "Servies, assortiment van gebruiks- en sierkeramiek.\r\nOp maat gemaakte stukken, voor geschenken voor geboortes, bruiloften of andere gelegenheden.\r\nLessen en workshops op afspraak."
    ]
  },
  "rdfs:label": {
    "en": [
