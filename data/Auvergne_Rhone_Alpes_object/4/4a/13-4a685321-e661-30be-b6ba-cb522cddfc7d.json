  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Museumsbereich, der der emblematischen gastronomischen Spezialität der Region Drôme gewidmet ist: der Raviole du Dauphiné!\r\nEin interaktiver Ausstellungsbereich für Groß und Klein, um ihre Geschichte zu entdecken und zu erfahren, wie man sie kocht."
    ],
    "en": [
      "Come and discover the museum space dedicated to the emblematic gastronomic specialty of the Drôme region: raviole du Dauphiné!\r\nAn interactive exhibition space for young and old to discover its history and learn how to cook it."
    ],
    "it": [
      "Venite a scoprire lo spazio museale dedicato alla specialità gastronomica emblematica della regione della Drôme: la raviole du Dauphiné!\r\nUno spazio espositivo interattivo per grandi e piccini per scoprire la sua storia e imparare a cucinarla."
    ],
    "fr": [
      "Venez découvrir l'espace muséographique consacré à l'emblématique spécialité gastronomique du terroir drômois : la raviole du Dauphiné !\r\nUn espace d'exposition interactive pour petits et grands pour découvrir son histoire et savoir comment la cuisiner."
    ],
    "es": [
      "Venga a descubrir el espacio museográfico dedicado a la especialidad gastronómica emblemática de la Drôme: ¡la raviole du Dauphiné!\r\nUn espacio de exposición interactivo para que grandes y pequeños descubran su historia y aprendan a cocinarla."
    ],
    "nl": [
      "Kom en ontdek de museumruimte gewijd aan de emblematische gastronomische specialiteit van de Drôme: raviole du Dauphiné!\r\nEen interactieve expositieruimte voor jong en oud om de geschiedenis te ontdekken en te leren koken."
    ]
  },
