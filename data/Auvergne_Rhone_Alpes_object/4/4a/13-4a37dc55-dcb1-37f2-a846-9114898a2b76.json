  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie von Montag bis Freitag in einer gemütlichen Atmosphäre zum Mittagessen. Allein, mit der Familie oder mit Freunden können Sie sich mit Gerichten der französischen Küche verwöhnen lassen."
    ],
    "en": [
      "We welcome you in a warm atmosphere at noon, Monday to Friday. Alone, with family or friends, you will be able to enjoy French cuisine."
    ],
    "it": [
      "Vi accogliamo in una calda atmosfera all'ora di pranzo, dal lunedì al venerdì. Da soli, in famiglia o con gli amici, potrete gustare la cucina francese."
    ],
    "fr": [
      "Nous vous accueillons dans une ambiance chaleureuse à midi, du lundi au vendredi. Seul, en famille ou entre amis, vous pourrez vous régaler avec des plats de la cuisine française."
    ],
    "nl": [
      "Wij ontvangen u in een warme sfeer tijdens de lunch, van maandag tot en met vrijdag. Alleen, met familie of vrienden, u kunt genieten van de Franse keuken."
    ],
    "es": [
      "Le damos la bienvenida en un ambiente cálido a la hora de comer, de lunes a viernes. Solo, en familia o con amigos, podrá disfrutar de la cocina francesa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Convivial"
    ]
  },
