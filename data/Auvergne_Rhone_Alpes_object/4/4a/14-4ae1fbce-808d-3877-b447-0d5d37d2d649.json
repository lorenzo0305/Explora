  "rdfs:comment": {
    "de": [
      "Mit Armour dekonstruiert das Akrobatentrio Arno Ferrera, Gilles Polet und Charlie Hession die Männlichkeit und öffnet die Arme für die Möglichkeiten einer pluralistischen Liebe."
    ],
    "en": [
      "With Armour, acrobatic trio Arno Ferrera, Gilles Polet and Charlie Hession deconstruct masculinity and open their arms to the possibilities of plural love."
    ],
    "it": [
      "In Armour, il trio di acrobati Arno Ferrera, Gilles Polet e Charlie Hession decostruisce la mascolinità e apre le braccia alle possibilità dell'amore plurale."
    ],
    "fr": [
      "Avec Armour, le trio d’acrobates Arno Ferrera, Gilles Polet et Charlie Hession déconstruit la masculinité et ouvre les bras aux possibilités d’un amour pluriel."
    ],
    "nl": [
      "In Armour deconstrueert het trio acrobaten Arno Ferrera, Gilles Polet en Charlie Hession mannelijkheid en openen ze hun armen voor de mogelijkheden van meervoudige liefde."
    ],
    "es": [
      "En Armour, el trío de acróbatas Arno Ferrera, Gilles Polet y Charlie Hession deconstruye la masculinidad y abre los brazos a las posibilidades del amor plural."
    ]
  },
