  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Konzert der Gruppe \"Petits Bonhommes\" in der Brasserie Motueka am Samstag, den 30. Mai ab 20 Uhr.\r\nLassen Sie sich von den Reggae- und Ska-Melodien der Band mitreißen.\r\nLassen Sie sich im Rhythmus ihrer aufrichtigen und tiefgründigen Texte mitreißen."
    ],
    "en": [
      "Come and see the \"Petits Bonhommes\" band in concert at Brasserie Motueka on Saturday May 30 from 8pm.\r\nLet yourself be carried away by the group's reggae and ska melodies.\r\nLet yourself vibrate to the rhythm of their sincere and profound lyrics."
    ],
    "it": [
      "Partecipate al concerto del gruppo \"Petits Bonhommes\" presso la Brasserie Motueka sabato 30 maggio a partire dalle 20.00.\r\nLasciatevi trasportare dalle melodie reggae e ska del gruppo.\r\nLasciatevi vibrare al ritmo dei loro testi sinceri e profondi."
    ],
    "fr": [
      "Venez assister au concert du groupe \"Petits Bonhommes\" à la Brasserie Motueka le samedi 30 mai à partir de 20h.\r\nLaissez-vous transporter par les mélodies reggae et ska du groupe.\r\nLaissez-vous vibrer au rythme de leurs paroles sincères et profondes."
    ],
    "nl": [
      "Kom zaterdag 30 mei vanaf 20.00 uur naar het concert van de groep \"Petits Bonhommes\" in Brasserie Motueka.\r\nLaat je meevoeren door de reggae en ska melodieën van de groep.\r\nLaat je meevoeren op het ritme van hun oprechte en diepgaande teksten."
    ],
    "es": [
      "Asista al concierto del grupo \"Petits Bonhommes\" en la Brasserie Motueka el sábado 30 de mayo a partir de las 20:00 horas.\r\nDéjese llevar por las melodías reggae y ska del grupo.\r\nDéjese vibrar al ritmo de sus letras sinceras y profundas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Petits BonHommes à la Brasserie Motueka"
    ]
  },
