  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in eine betörende Reise durch 5000 Jahre chinesischer Zivilisation, wo Tanz, Musik und Legenden in einer Show von himmlischer Schönheit lebendig werden: Shen Yun."
    ],
    "en": [
      "Immerse yourself in a spellbinding journey through 5000 years of Chinese civilization, where dance, music and legends come to life in a show of celestial beauty: Shen Yun."
    ],
    "it": [
      "Immergetevi in un viaggio incantato attraverso 5000 anni di civiltà cinese, dove danza, musica e leggende prendono vita in uno spettacolo di bellezza celestiale: Shen Yun."
    ],
    "fr": [
      "Plongez dans un voyage envoûtant à travers 5000 ans de civilisation chinoise, où danse, musique et légendes prennent vie dans un spectacle d'une beauté céleste : Shen Yun."
    ],
    "es": [
      "Sumérjase en un fascinante viaje a través de 5.000 años de civilización china, donde la danza, la música y las leyendas cobran vida en un espectáculo de belleza celestial: Shen Yun."
    ],
    "nl": [
      "Dompel jezelf onder in een betoverende reis door 5000 jaar Chinese beschaving, waar dans, muziek en legendes tot leven komen in een show van hemelse schoonheid: Shen Yun."
    ]
  },
  "rdfs:label": {
    "en": [
