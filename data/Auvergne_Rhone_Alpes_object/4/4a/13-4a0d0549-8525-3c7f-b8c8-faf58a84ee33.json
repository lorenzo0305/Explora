  "rdfs:comment": {
    "de": [
      "Die Schülerinnen und Schüler sowie die Lehrkräfte freuen sich, Sie nur mit Reservierung im Anwendungsrestaurant und in der Brasserie des Lycée Hôtelier begrüßen zu dürfen, und danken Ihnen für Ihre Teilnahme an ihrer Ausbildung."
    ],
    "en": [
      "Students and teachers are happy to welcome you to the Lycée Hôtelier's application restaurant and brasserie, by reservation only, and thank you for taking part in their training."
    ],
    "it": [
      "Gli studenti e gli insegnanti sono lieti di accogliervi nel ristorante di formazione e nella brasserie del Lycée Hôtelier, solo su prenotazione, e vi ringraziano per aver partecipato alla loro formazione."
    ],
    "fr": [
      "Les élèves et les professeurs sont heureux de vous accueillir uniquement sur réservation au sein du restaurant d'application et de la brasserie du Lycée Hôtelier et vous remercient de participer à leur formation."
    ],
    "es": [
      "Los alumnos y profesores se complacen en recibirle en el restaurante y la brasserie de formación del Lycée Hôtelier, únicamente con reserva previa, y le agradecen su participación en su formación."
    ],
    "nl": [
      "De studenten en docenten verwelkomen u graag in het opleidingsrestaurant en de brasserie van het Lycée Hôtelier, uitsluitend op reservering, en bedanken u voor uw deelname aan hun opleiding."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de Bellerive : Restaurant d'application et brasserie pédagogique"
    ]
  },
