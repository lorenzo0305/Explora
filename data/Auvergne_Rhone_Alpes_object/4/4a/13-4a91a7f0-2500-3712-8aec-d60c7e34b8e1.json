  "rdfs:comment": {
    "de": [
      "Handgefertigte und einzigartige Kreationen: Zen-Lampen, Deko-Objekte und Schmuck.\r\nCatherine stellt jedes Objekt mit Leidenschaft und Feingefühl her, um Ihnen Wohlbefinden zu schenken und das natürliche Material Bambus zu sublimieren."
    ],
    "en": [
      "Handcrafted and unique creations: Zen lamps, decorative objects and jewelry.\r\nCatherine makes each object with passion and delicacy in order to bring you well-being and to sublimate this natural material: Bamboo."
    ],
    "it": [
      "Creazioni artigianali uniche: lampade Zen, oggetti decorativi e gioielli.\r\nCatherine realizza ogni oggetto con passione e delicatezza per portare benessere e sublimare questo materiale naturale: il bambù."
    ],
    "fr": [
      "Créations artisanales et uniques : Lampes Zen, Objets déco et Bijoux.\r\nCatherine fabrique chaque objet avec passion et délicatesse afin de et vous apporter du bien-être, et sublimer cette matière naturelle : le Bambou."
    ],
    "nl": [
      "Unieke handgemaakte creaties: Zen lampen, decoratieve objecten en sieraden.\r\nCatherine maakt elk voorwerp met passie en delicatesse om u welzijn te brengen en dit natuurlijke materiaal te sublimeren: Bamboe."
    ],
    "es": [
      "Creaciones únicas hechas a mano: lámparas Zen, objetos de decoración y joyas.\r\nCatherine fabrica cada objeto con pasión y delicadeza para aportarle bienestar y sublimar este material natural: el bambú."
    ]
  },
