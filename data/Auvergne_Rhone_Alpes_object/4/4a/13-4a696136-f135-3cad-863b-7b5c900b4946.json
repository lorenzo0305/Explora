  "rdfs:comment": {
    "de": [
      "Ein unumgänglicher Ort für Liebhaber von Burgern (Hausspezialität), Tacos, Paninis und Salaten. Unsere Gerichte werden mit frischen Zutaten zubereitet. Wir bieten auch: verschiedene Getränke (Bier...), Eis (Granita, italienisches Eis im Sommer...)"
    ],
    "en": [
      "A must for lovers of burgers (house speciality), tacos, paninis and salads. Our dishes are cooked with fresh products. We also offer: various drinks (beers...), ice creams (granita, Italian ice cream in summer...)"
    ],
    "it": [
      "Un must per gli amanti di hamburger (specialità della casa), tacos, panini e insalate. I nostri piatti sono cucinati con prodotti freschi. Offriamo inoltre: bevande varie (birre...), gelati (granita, gelato italiano in estate...)"
    ],
    "fr": [
      "Un lieu incontournable pour les amateurs de burgers (spécialité maison), tacos, paninis et salades. Nos plats sont cuisinés à base de produits frais. Nous proposons aussi : boissons diverses (bières...), glaces (granités, glaces italiennes en été...)"
    ],
    "es": [
      "Imprescindible para los amantes de las hamburguesas (especialidad de la casa), los tacos, los paninis y las ensaladas. Nuestros platos se cocinan con productos frescos. También ofrecemos: bebidas variadas (cervezas...), helados (granizado, helado italiano en verano...)"
    ],
    "nl": [
      "Een must voor liefhebbers van hamburgers (specialiteit van het huis), taco's, panini's en salades. Onze gerechten worden gekookt met verse producten. Wij bieden ook: diverse dranken (bieren...), ijsjes (granita, Italiaans ijs in de zomer...)"
    ]
  },
