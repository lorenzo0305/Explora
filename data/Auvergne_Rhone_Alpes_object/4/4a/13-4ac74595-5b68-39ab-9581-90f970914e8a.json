  "rdfs:comment": {
    "de": [
      "Außergewöhnlicher Blick auf den Mont-Blanc. In einem warmen und gemütlichen Rahmen können Sie unsere Fondues, Raclettes und Pierrades sowie eine traditionellere Küche genießen. Gerne kümmern wir uns um Sie."
    ],
    "en": [
      "Exceptional views of Mont Blanc. In a warm and convivial setting, you will enjoy our fondues, raclettes and pierrades, as well as more traditional cuisine. We will be delighted to look after you."
    ],
    "it": [
      "Vista eccezionale sul Monte Bianco. In un'atmosfera calda e accogliente, potrete gustare le nostre fondute, raclettes e pierrades, oltre alla cucina più tradizionale. Saremo lieti di servirvi."
    ],
    "fr": [
      "Vue exceptionnelle sur le Mont-Blanc. Dans un cadre chaleureux et convivial vous pourrez apprécier nos fondues, raclettes et pierrades, ainsi qu'une cuisine plus traditionnelle. C'est avec plaisir que nous prendrons soin de vous."
    ],
    "es": [
      "Vista excepcional del Mont Blanc. En un ambiente cálido y acogedor, podrá disfrutar de nuestras fondues, raclettes y pierrades, así como de la cocina más tradicional. Estaremos encantados de atenderle."
    ],
    "nl": [
      "Fantastisch uitzicht op de Mont-Blanc. Dit restaurant met knusse en gezellige sfeer biedt een menukaart met kaasfondue, raclette, steengrillen en traditionele gerechten. Wij heten u graag van harte welkom."
    ]
  },
