  "rdfs:comment": {
    "de": [
      "Angelegter See in unmittelbarer Nähe der Stadt. Wasserfläche mit dem Gütesiegel Parcours Famille Pêche\" ausgezeichnet.\r\nAngeln das ganze Jahr über mit einer Bundeskarte: angepasster Steg für Angler im Rollstuhl."
    ],
    "en": [
      "A landscaped lake in the immediate vicinity of the town. Waterway with \"Parcours Famille Pêche\" label.\r\nYear-round fishing with a federal fishing card: pontoon adapted for wheelchair users."
    ],
    "it": [
      "Un lago paesaggistico situato nelle immediate vicinanze della città. Il lago ha ottenuto il marchio \"Parcours Famille Pêche\" (Percorso familiare di pesca).\r\nSi può pescare tutto l'anno con una licenza di pesca federale: pontile adattato alle persone in sedia a rotelle."
    ],
    "fr": [
      "Plan d'eau aménagé, situé à proximité immédiate de la ville. Plan d’eau labellisé Parcours Famille Pêche.\r\nPêche toute l'année avec une carte fédérale : ponton adapté pour pêcheurs en fauteuil roulant."
    ],
    "es": [
      "Un lago ajardinado situado en las inmediaciones de la ciudad. El lago ha obtenido la etiqueta \"Parcours Famille Pêche\" (Sendero Familiar de Pesca).\r\nPesca todo el año con licencia federal de pesca: pontón adaptado para personas en silla de ruedas."
    ],
    "nl": [
      "Een aangelegd meer in de onmiddellijke nabijheid van de stad. Het meer heeft het label \"Parcours Famille Pêche\".\r\nHet hele jaar door vissen met een federale visvergunning: ponton aangepast voor rolstoelgebruikers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plan d'eau des Ozières"
    ]
  },
