  "rdfs:comment": {
    "de": [
      "Fliegenfischerkurse in den Schluchten des Allier von Chanteuges bis Lavoute Chilhac mit dem erfahrenen Führer Mickaël Miclet, der an Wettkämpfen auf Flüssen und Stauseen teilgenommen hat. Auf Ihre Anfrage zugeschnittene Leistung."
    ],
    "en": [
      "Fly-fishing courses on the Allier gorges from Chanteuges to Lavoute Chilhac with experienced guide Mickaël Miclet, who has competed on both rivers and reservoirs. Services tailored to your needs."
    ],
    "it": [
      "Corsi di pesca a mosca nelle gole dell'Allier da Chanteuges a Lavoute Chilhac con la guida esperta Mickaël Miclet, che ha gareggiato sia su fiumi che su bacini artificiali. Servizi su misura per le vostre esigenze."
    ],
    "fr": [
      "Stages de pêche à la mouche sur les gorges de l'Allier de Chanteuges à Lavoute Chilhac avec le guide expérimenté  Mickaël Miclet, qui a pratiqué la compétition rivière et réservoir. Prestation adaptée à votre demande."
    ],
    "nl": [
      "Vliegviscursussen in de kloven van de Allier van Chanteuges tot Lavoute Chilhac met ervaren gids Mickaël Miclet, die zowel op rivieren als stuwmeren heeft gevist. Diensten op maat."
    ],
    "es": [
      "Cursos de pesca a mosca en las gargantas del Allier, desde Chanteuges hasta Lavoute Chilhac, con el experimentado guía Mickaël Miclet, que ha competido tanto en ríos como en embalses. Servicios adaptados a sus necesidades."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Moniteur-Guide de pêche | Mickaël Miclet"
    ]
  },
