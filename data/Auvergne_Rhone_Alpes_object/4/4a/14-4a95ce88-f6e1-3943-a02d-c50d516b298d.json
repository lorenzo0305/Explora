  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2c4f9dcc-b2ff-32f4-bbef-4d39d38d41db",
      "dc:description": {
        "de": [
          "300m² großer Lebensmittel-Supermarkt, 7 Tage die Woche von 7 bis 21 Uhr geöffnet. Über 7000 Artikel in den Bereichen Lebensmittel, Getränke, Frischwaren, Obst und Gemüse. Lieferung nach Hause."
        ],
        "en": [
          "300m² food supermarket open 7 days a week from 7am to 9pm. Over 7,000 references in groceries, drinks, fresh produce and fruit and vegetables. Home delivery."
        ],
        "it": [
          "Supermercato alimentare di 300 m² aperto 7 giorni su 7 dalle 7.00 alle 21.00. Oltre 7.000 articoli di drogheria, bevande, prodotti freschi e frutta e verdura. Consegna a domicilio."
        ],
        "fr": [
          "Supérette alimentaire de 300m² ouvert 7 jours sur 7 de 7h à 21h. Plus de 7000 références en épicerie, boissons, produits frais et fruits et légumes. Livraison à domicile."
        ],
        "es": [
          "Supermercado de alimentación de 300 m² abierto los 7 días de la semana de 7.00 a 21.00 horas. Más de 7.000 artículos de alimentación, bebidas, productos frescos y frutas y verduras. Entrega a domicilio."
        ],
        "nl": [
          "Levensmiddelenwinkel van 300 m², 7 dagen per week geopend van 7.00 tot 21.00 uur. Meer dan 7.000 kruidenierswaren, dranken, verse producten en groenten en fruit. Thuisbezorging."
        ]
      },
