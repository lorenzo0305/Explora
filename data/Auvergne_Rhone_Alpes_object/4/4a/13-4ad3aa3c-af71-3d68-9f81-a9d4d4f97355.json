  "rdfs:comment": {
    "de": [
      "In einer natürlichen und gemütlichen Umgebung laden Charlotte & Benjamin Sie dazu ein, Gerichte zu genießen, die vor Ort aus frischen und lokalen Produkten der Saison zubereitet werden, meist mit einer vegetarischen Option."
    ],
    "en": [
      "Charlotte and Benjamin welcome you in a warm and natural decor, to try and taste homemade fresh dishes, with locally produced and seasonal products. Vegetarian options are offered."
    ],
    "it": [
      "In un ambiente naturale e accogliente, Charlotte & Benjamin vi invitano a gustare piatti preparati sul posto con prodotti freschi e locali di stagione, di solito con un'opzione vegetariana."
    ],
    "fr": [
      "Dans un cadre naturel et chaleureux, Charlotte & Benjamin vous invitent à déguster des plats préparés sur place avec des produits de saison frais et locaux, avec généralement une option végétarienne."
    ],
    "nl": [
      "In een natuurlijk en warm kader nodigen Charlotte & Benjamin u uit om gerechten te proeven die ter plaatse worden bereid met verse en lokale seizoensproducten, meestal met een vegetarische optie."
    ],
    "es": [
      "En un entorno cálido y natural, Charlotte & Benjamin le invitan a degustar platos preparados in situ con productos frescos locales de temporada, normalmente con una opción vegetariana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez nous"
    ]
  },
