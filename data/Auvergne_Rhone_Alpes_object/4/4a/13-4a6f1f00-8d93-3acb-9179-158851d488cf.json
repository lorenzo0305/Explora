  "rdfs:comment": {
    "de": [
      "Öffentliche Arbeiten, Schneeräumung.\r\nS.T.R. ist im Département Savoie in den Bereichen Straßentransport, Erdbau und öffentliche Arbeiten tätig.\r\nDas Unternehmen besteht aus einem 20-köpfigen, erfahrenen Team und verfügt über modernste Ausrüstung."
    ],
    "en": [
      "Public works, snow removal.\r\nS.T.R. operates in the Savoie department in the fields of road transport, earthmoving, and public works.\r\nIt's a team of 20 experienced people and state-of-the-art equipment."
    ],
    "it": [
      "Lavori pubblici, sgombero neve.\r\nS.T.R opera nel dipartimento della Savoia nei settori del trasporto stradale, dei lavori di sterro e dei lavori pubblici.\r\nDispone di un team di 20 persone esperte e di attrezzature all'avanguardia."
    ],
    "fr": [
      "Travaux publics, déneigement.\r\nS.T.R intervient dans le département de la Savoie dans les domaines du transport routier, du terrassement et des travaux publics. \r\nC'est une équipe de 20 personnes expérimentées et du matériel à la pointe de la technologie."
    ],
    "nl": [
      "Openbare werken, sneeuwruimen.\r\nS.T.R is actief in het departement Savoie op het gebied van wegtransport, grondwerken en openbare werken.\r\nHet heeft een team van 20 ervaren mensen en ultramodern materieel."
    ],
    "es": [
      "Obras públicas, limpieza de nieve.\r\nS.T.R opera en el departamento de Savoie en los ámbitos del transporte por carretera, los movimientos de tierras y las obras públicas.\r\nCuenta con un equipo de 20 personas experimentadas y equipos de última generación."
    ]
  },
  "rdfs:label": {
