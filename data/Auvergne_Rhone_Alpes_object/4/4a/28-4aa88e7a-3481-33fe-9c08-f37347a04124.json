  "rdfs:comment": {
    "de": [
      "Das Le Castle bietet Ihnen eine hochwertige Küche mit frischen Produkten in einem modernen und schlichten Rahmen. Der Chefkoch liebt es, die Klassiker der französischen Küche neu zu erfinden. Sein Motto: \"Ihnen Freude bereiten\"."
    ],
    "en": [
      "The Castle offers quality cuisine with fresh products, in a modern and sober setting. The chef likes to reinvent the classics of French cuisine. His motto is \"Make you happy\"."
    ],
    "it": [
      "Il Castello offre una cucina di qualità con prodotti freschi in un ambiente moderno e sobrio. Lo chef ama reinventare i classici della cucina francese. Il suo motto è: \"Renditi felice\"."
    ],
    "fr": [
      "Le Castle vous propose une cuisine de qualité et de produits frais, dans un cadre moderne et sobre. Le chef aime réinventer les classiques de la cuisine française. Son mot d'ordre \"Vous faire plaisir\"."
    ],
    "nl": [
      "Het Kasteel biedt een kwaliteitskeuken met verse producten in een modern en sober kader. De chef houdt ervan de klassiekers van de Franse keuken opnieuw uit te vinden. Zijn motto is \"Maak je gelukkig\"."
    ],
    "es": [
      "El Castillo ofrece una cocina de calidad con productos frescos en un ambiente moderno y sobrio. Al chef le gusta reinventar los clásicos de la cocina francesa. Su lema es \"Hazte feliz\"."
    ]
  },
