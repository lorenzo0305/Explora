  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser neues Halal-Restaurant, das sich zwischen Portes Les Valence und Etoile sur Rhône befindet...\r\nEine Qualitätsküche aus frischen Produkten mit Grillspezialitäten, hausgemachten Pommes frites, hausgemachten Desserts und all dem in einem gemütlichen Rahmen!"
    ],
    "en": [
      "Come and discover our new halal restaurant located between Portes Les Valence and Etoile sur Rhône...\r\nQuality cuisine based on fresh produce, specializing in grilled meats, homemade fries and homemade desserts, all in a warm and welcoming setting!"
    ],
    "it": [
      "Venite a scoprire il nostro nuovo ristorante halal situato tra Portes Les Valence e Etoile sur Rhône...\r\nCucina di qualità a base di prodotti freschi, con specialità come carni alla griglia, patatine fritte e dolci fatti in casa, il tutto in un ambiente accogliente!"
    ],
    "fr": [
      "Venez découvrir notre nouveau restaurant halal situé entre Portes Les Valence et Etoile sur Rhône...\r\nUne cuisine de qualité à base de produits frais avec comme spécialités des grillades, frites maison,dessert maison et tout ça dans un cadre chaleureux !"
    ],
    "es": [
      "Venga a descubrir nuestro nuevo restaurante halal situado entre Portes Les Valence y Etoile sur Rhône...\r\nCocina de calidad basada en productos frescos, con especialidades como carnes a la brasa, patatas fritas caseras y postres caseros, ¡todo ello en un ambiente cálido y acogedor!"
    ],
    "nl": [
      "Kom en ontdek ons nieuwe halal restaurant gelegen tussen Portes Les Valence en Etoile sur Rhône...\r\nEen kwaliteitskeuken op basis van verse producten, met specialiteiten zoals gegrild vlees, huisgemaakte frietjes en huisgemaakte desserts, en dat alles in een gezellige sfeer!"
    ]
  },
