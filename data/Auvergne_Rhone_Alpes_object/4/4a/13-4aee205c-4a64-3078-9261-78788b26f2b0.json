  "rdfs:comment": {
    "de": [
      "Willkommen auf 1.800 m Höhe, im Herzen der Maroly-Almen im Sommer und auf den Skipisten im Winter. Zwei Farben, zwei Stimmungen, aber zu jeder Jahreszeit ein magischer Ort. Eine einfache, hausgemachte Küche, ein kulinarischer Zwischenstopp, großzügig und gesellig, jeden Mittag."
    ],
    "en": [
      "Welcome to an altitude of 1,800 metres, in the heart of the Maroly mountain pastures in summer and on the ski slopes in winter. Two colours, two atmospheres, but one magical place in every season. Simple, home-style cuisine, a gourmet stopover, generous and friendly every lunchtime."
    ],
    "it": [
      "Benvenuti a 1.800 metri di altitudine, nel cuore degli alpeggi di Maroly in estate e sulle piste da sci in inverno. Due colori, due atmosfere, ma un luogo magico in ogni stagione. Una cucina semplice e casalinga, una sosta gourmet generosa e amichevole ad ogni pranzo."
    ],
    "fr": [
      "Bienvenue à 1 800 m d’altitude, au coeur des alpages du Maroly en été, sur les pistes de ski l’hiver. Deux couleurs, deux ambiances mais un lieu magique chaque saison. Une cuisine simple et maison, halte gourmande, généreuse et conviviale tous les midis."
    ],
    "nl": [
      "Welkom op 1.800 m hoogte, in het hart van de bergweiden van Maroly in de zomer en op de skipistes in de winter. Twee kleuren, twee sferen, maar elk seizoen een magische plek. Eenvoudige, huisgemaakte keuken, een gulle, vriendelijke gastronomische tussenstop elke middag."
    ],
    "es": [
      "Bienvenido a 1.800 m de altitud, en el corazón de los pastos de la montaña de Maroly en verano y en las pistas de esquí en invierno. Dos colores, dos ambientes, pero un lugar mágico cada temporada. Cocina sencilla y casera, una parada gastronómica generosa y acogedora cada mediodía."
    ]
  },
  "rdfs:label": {
    "de": [
      "Bergrestaurant \"Les Terres Rouges\""
    ],
    "en": [
      "Altitude Restaurant Les Terres Rouges"
    ],
    "fr": [
      "Restaurant d'altitude Les Terres Rouges"
    ]
  },
