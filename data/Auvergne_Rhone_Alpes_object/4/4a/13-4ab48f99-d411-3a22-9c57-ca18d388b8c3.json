  "rdfs:comment": {
    "de": [
      "Auf der Route Napoléon sollten Sie sich diese historische, touristische und gastronomische Etappe nicht entgehen lassen. Entdecken Sie den See von Le Sautet und Notre Dame de la Salette. Genießen Sie die Qualität und Vielfalt der Hotels und Restaurants sowie die angebotenen Aktivitäten."
    ],
    "en": [
      "On the Napoleon road, don't miss this historical, touristic and gastronomic stop. Discover the lake of Sautet and Notre Dame de la Salette. Enjoy the quality and diversity of the hotels and restaurants, as well as the proposed activities."
    ],
    "it": [
      "Sulla Route Napoléon, non perdetevi questa tappa storica, turistica e gastronomica. Scoprite il Lac du Sautet e Notre Dame de la Salette. Godetevi la qualità e la diversità degli hotel e dei ristoranti, nonché le attività proposte."
    ],
    "fr": [
      "Sur la route Napoléon, ne manquez pas cette étape historique, touristique et gastronomique. Découvrez le lac du Sautet et Notre Dame de la Salette. Appréciez la qualité et la diversité des hôtels et restaurants, ainsi que les activités proposées."
    ],
    "nl": [
      "Op de Route Napoléon mag je deze historische, toeristische en gastronomische halteplaats niet missen. Ontdek het Lac du Sautet en de Notre Dame de la Salette. Geniet van de kwaliteit en diversiteit van de hotels en restaurants, evenals van de aangeboden activiteiten."
    ],
    "es": [
      "En la Ruta Napoleón, no se pierda esta parada histórica, turística y gastronómica. Descubra el Lac du Sautet y Notre Dame de la Salette. Disfrute de la calidad y diversidad de los hoteles y restaurantes, así como de las actividades que se ofrecen."
    ]
  },
