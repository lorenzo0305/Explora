  "rdfs:comment": {
    "de": [
      "2 Tennisplätze im unteren Teil des Dorfes Lélex, die vom Fluss Valserine gesäumt werden. Der Zugang ist kostenlos. Reservierung im Voraus, vor Ort, auf der Anzeigetafel vor den Plätzen."
    ],
    "en": [
      "2 tennis courts at the bottom of Lélex village, next to the Valserine river. Free access. Reservations in advance, on site, on the notice board in front of the courts."
    ],
    "it": [
      "2 campi da tennis situati nella parte bassa del villaggio di Lélex, costeggiati dalla Valserina. Accesso gratuito. Le prenotazioni devono essere effettuate in anticipo sulla bacheca di fronte ai campi."
    ],
    "fr": [
      "2 courts de tennis situés en bas du village de Lélex, bordés par la Valserine. Accès gratuit. Réservation au préalable, sur place, sur le panneau d'affichage devant les terrains."
    ],
    "nl": [
      "2 tennisbanen gelegen onderaan het dorp Lélex, begrensd door de Valserine. De toegang is gratis. Vooraf reserveren op het mededelingenbord voor de tennisbanen."
    ],
    "es": [
      "2 pistas de tenis situadas en la parte baja del pueblo de Lélex, bordeadas por el Valserine. Acceso gratuito. Es necesario reservar con antelación en el tablón de anuncios situado delante de las pistas."
    ]
  },
