  "rdfs:comment": {
    "de": [
      "Die Boutique Au Bazar des Marmottes bietet Ihnen eine große Auswahl an Souvenirs, Geschenken, Dekorationsartikeln und Produkten aus der Region Auvergne-Rhône-Alpes und dem Gebiet Mézenc Loire Meygal."
    ],
    "en": [
      "The Au Bazar des Marmottes store offers a wide range of souvenirs, gifts, decorative objects and products from the Auvergne-Rhône-Alpes region and the Mézenc Loire Meygal territory."
    ],
    "it": [
      "Il negozio Au Bazar des Marmottes offre un'ampia gamma di souvenir, regali, oggetti decorativi e prodotti della regione Auvergne-Rhône-Alpes e della zona Mézenc Loire Meygal."
    ],
    "fr": [
      "La boutique Au Bazar des Marmottes vous propose une large gamme de souvenirs, cadeaux, objets décoratifs et produits de la région Auvergne-Rhône-Alpes et du territoire Mézenc Loire Meygal."
    ],
    "es": [
      "La tienda Au Bazar des Marmottes ofrece una amplia gama de recuerdos, regalos, objetos de decoración y productos de la región de Auvernia-Ródano-Alpes y de la zona de Mézenc Loire Meygal."
    ],
    "nl": [
      "De winkel Au Bazar des Marmottes biedt een breed scala aan souvenirs, geschenken, decoratieve voorwerpen en producten uit de regio Auvergne-Rhône-Alpes en de streek Mézenc Loire Meygal."
    ]
  },
