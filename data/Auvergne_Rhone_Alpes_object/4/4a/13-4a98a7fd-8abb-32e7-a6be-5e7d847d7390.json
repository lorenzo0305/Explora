  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine authentische, traditionelle Küche. In einer Umgebung aus goldenen Steinen genießen Sie hausgemachte Gerichte, die überwiegend aus frischen Produkten zubereitet werden. Frische Frösche am Wochenende."
    ],
    "en": [
      "The establishment offers authentic, traditional cuisine. In a setting of golden stones, enjoy home-made dishes, prepared mainly with fresh products. Fresh frogs on the WE."
    ],
    "it": [
      "Il ristorante offre una cucina autentica e tradizionale. In una cornice di pietra dorata, gustate i piatti fatti in casa, preparati principalmente con prodotti freschi. Rane fresche sul WE."
    ],
    "fr": [
      "L’établissement vous propose une cuisine authentique, traditionnelle. Dans un cadre tout en pierres dorées, dégustez des plats faits-maison, et préparés majoritairement à base de produits frais. Grenouilles fraîches le WE."
    ],
    "nl": [
      "Het restaurant biedt een authentieke, traditionele keuken. In een gouden stenen decor geniet u van huisgemaakte gerechten, voornamelijk bereid met verse producten. Verse kikkers in het weekend."
    ],
    "es": [
      "El restaurante ofrece una cocina auténtica y tradicional. En un entorno de piedra dorada, disfrute de platos caseros, preparados principalmente con productos frescos. Ranas frescas en el WE."
    ]
  },
