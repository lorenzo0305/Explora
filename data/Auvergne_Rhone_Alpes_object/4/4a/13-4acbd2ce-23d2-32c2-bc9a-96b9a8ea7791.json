  "rdfs:comment": {
    "de": [
      "Erleben Sie mit Ihrer Familie ein Abenteuer mit Aerodream Paragliding! Guillaume und Alexis, leidenschaftliche Brüder, nehmen Sie für unvergessliche Flüge mit in die Lüfte. Authentizität, lokales Know-how und gute Laune sind garantiert. Wagen Sie den Traum, wagen Sie Aerodream!"
    ],
    "en": [
      "Enjoy a family adventure with Aerodream Parapente! Guillaume and Alexis, brothers who share the same passion, take you on unforgettable flights. Authenticity, local savoir-faire and good mood guaranteed. Dare to dream, dare Aerodream!"
    ],
    "it": [
      "Godetevi un'avventura in famiglia con Aerodream Parapente! Guillaume e Alexis, due fratelli appassionati, vi porteranno in aria per voli indimenticabili. Autenticità, know-how locale e buon umore garantiti. Osate sognare, osate volare con Aerodream!"
    ],
    "fr": [
      "Vivez l'aventure en famille avec Aerodream Parapente ! Guillaume et Alexis, frères passionnés, vous embarquent dans les airs pour des vols inoubliables. Authenticité, savoir-faire local et bonne humeur garantis. Osez le rêve, osez Aerodream !"
    ],
    "es": [
      "¡Disfrute de una aventura en familia con Aerodream Parapente! Guillaume y Alexis, dos hermanos apasionados, le llevarán por los aires en vuelos inolvidables. Autenticidad, saber hacer local y buen humor garantizados. Atrévase a soñar, atrévase a volar con Aerodream"
    ],
    "nl": [
      "Geniet van een gezinsavontuur met Aerodream Parapente! Guillaume en Alexis, twee gepassioneerde broers, nemen je mee de lucht in voor onvergetelijke vluchten. Authenticiteit, lokale knowhow en goed humeur gegarandeerd. Durf te dromen, durf te vliegen met Aerodream!"
    ]
  },
