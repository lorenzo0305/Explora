      "dc:description": {
        "de": [
          "Metzgerei, Wurstwaren, Traiteur, Rotisserie, Lebensmittelgeschäft, Primeur, in Ihrer Station im Stadtzentrum von Stella-plage.\nMit dem Gütesiegel \"Artisans en Or\" ausgezeichnet."
        ],
        "en": [
          "Butcher, delicatessen, delicatessen, rotisserie, grocer, greengrocer, in your resort in the heart of Stella-plage.\nCertified \"Artisans en Or\"."
        ],
        "it": [
          "Macelleria, salumeria, gastronomia, rosticceria, drogheria, fruttivendolo, nel vostro resort nel centro di Stella-plage.\nEtichettato come Artisans en Or."
        ],
        "fr": [
          "Boucherie, charcuterie, traiteur, rôtisserie, épicerie, primeur, dans votre station en plein centre ville de Stella-plage.\nLabellisé Artisans en Or."
        ],
        "nl": [
          "Slager, delicatessenzaak, delicatessenzaak, rotisserie, kruidenier, groenteboer, in uw resort in het centrum van Stella-plage.\nMet het label Artisans en Or."
        ],
        "es": [
          "Carnicería, charcutería, asador, ultramarinos, frutería, en su estación en el centro de Stella-plage.\nEtiquetado Artisans en Or."
        ]
      },
