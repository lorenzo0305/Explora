  "rdfs:comment": {
    "de": [
      "Freiberufler, Telearbeiter, Lehrer, Studenten..\r\nMitten im Dorf erwartet Sie unser Coworking Space, damit Sie hier in Quaix unabhängig, aber in einer Gemeinschaft arbeiten können."
    ],
    "en": [
      "Self-employed workers, teleworkers, teachers, students..\r\nIn the heart of the village, our coworking space awaits you to work here at Quaix, independently but in community."
    ],
    "it": [
      "Liberi professionisti, telelavoratori, insegnanti, studenti?\r\nNel cuore del villaggio, il nostro spazio di coworking vi aspetta per lavorare qui a Quaix, in modo indipendente ma in comunità."
    ],
    "fr": [
      "Travailleurs indépendants, télétravailleurs, professeurs, étudiants… \r\nEn plein coeur du village, notre espace de coworking vous attend pour travailler ici à Quaix, indépendamment mais en communauté."
    ],
    "es": [
      "¿Autónomos, teletrabajadores, profesores, estudiantes?\r\nEn el corazón del pueblo, nuestro espacio de coworking le espera para trabajar aquí en Quaix, de forma independiente pero en comunidad."
    ],
    "nl": [
      "Freelancers, telewerkers, leraren, studenten..\r\nIn het hart van het dorp wacht onze coworkingruimte op u om hier in Quaix te werken, zelfstandig maar in gemeenschap."
    ]
  },
