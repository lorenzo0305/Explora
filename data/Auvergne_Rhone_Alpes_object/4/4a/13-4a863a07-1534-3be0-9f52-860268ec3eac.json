  "rdfs:comment": {
    "de": [
      "Georges Blanc lädt Sie in sein Restaurant Place Bernard ein. Im Erdgeschoss des Hôtel de France empfängt er Sie in einem schlichten und raffinierten Rahmen. Entdecken Sie bei einem Geschäftsessen, mit der Familie oder mit Freunden eine schmackhafte Küche im Wechsel der Jahreszeiten."
    ],
    "en": [
      "Georges Blanc invites you to his restaurant Place Bernard. On the first floor of the Hôtel de France, he welcomes you in a sober and refined setting. Discover a tasty cuisine according to the seasons during a business meal, with family or friends."
    ],
    "it": [
      "Georges Blanc vi invita al suo ristorante Place Bernard. Al piano terra dell'Hôtel de France, vi accoglie in un ambiente sobrio e raffinato. Scoprite una cucina gustosa con le stagioni durante un pasto di lavoro, in famiglia o con gli amici."
    ],
    "fr": [
      "Georges Blanc vous invite dans son restaurant Place Bernard. Au rez-de-chaussée de l'hôtel de France, il vous reçoit dans un cadre sobre et raffiné. Découvrez une cuisine savoureuse au fil des saisons lors d'un repas d'affaires, en famille ou entre amis."
    ],
    "nl": [
      "Georges Blanc nodigt u uit in zijn restaurant Place Bernard. Op de begane grond van het Hôtel de France ontvangt hij u in een sober en verfijnd kader. Ontdek een smakelijke keuken met de seizoenen tijdens een zakendiner, met familie of vrienden."
    ],
    "es": [
      "Georges Blanc le invita a su restaurante Place Bernard. En la planta baja del Hôtel de France, le recibe en un ambiente sobrio y refinado. Descubra una cocina sabrosa con las estaciones durante una comida de negocios, con la familia o los amigos."
    ]
  },
