  "rdfs:comment": {
    "de": [
      "Charmantes ***Hotel mit Bar und Restaurant, ideal gelegen an Les Gorges de l'Ardéche, nur 300 Meter vom berühmten Pont d’Arc entfernt. Genießen Sie eine außergewöhnliche Umgebung, ganz in der Nähe der Strände und im Herzen der wunderschönen Gorges."
    ],
    "en": [
      "Charming *** hotel with bar and restaurant, ideally located on the road to the Gorges, just 300 meters from the famous Pont d’Arc. Enjoy an exceptional setting, only a short walk from the beaches and right in the heart of the magnificent Ardèche Gorges."
    ],
    "it": [
      "Incantevole hotel 3 stelle con bar e ristorante, situato in posizione ideale sulla strada delle Gole, a soli 300 metri dal famoso Pont d'Arc. Godetevi un ambiente eccezionale, a due passi dalle spiagge e nel cuore del magnifico scenario delle Gole dell'Ardèche."
    ],
    "fr": [
      "Hôtel *** de charme avec bar et restaurant, idéalement situé sur la route des Gorges, à seulement 300 mètres du célèbre Pont d’Arc. Profitez d’un cadre exceptionnel, à deux pas des plages et au cœur des magnifiques paysages des Gorges de l’Ardèche."
    ],
    "nl": [
      "Sfeervol ***hotel met bar en restaurant, ideaal gelegen aan de weg naar de Gorges, op slechts 300 meter van de beroemde Pont d’Arc. Geniet van een uitzonderlijke omgeving, dicht bij de stranden en in het hart van de prachtige Gorges de l’Ardèche."
    ],
    "es": [
      "Encantador hotel de 3 estrellas con bar y restaurante, idealmente situado en la carretera de las Gargantas, a sólo 300 metros del famoso Pont d'Arc. Disfrute de un entorno excepcional, a dos pasos de las playas y en el corazón de los magníficos paisajes de las Gargantas del Ardèche."
    ]
  },
