  "rdfs:comment": {
    "de": [
      "Dekorationswerkstatt(Dekorationsworkshop) in der Hand auf Keramiken und Gläsern. Schaffungsarbeiten, Reproduktion(Fortpflanzung) alten(ehemaligen), Arbeit(Werk) in der Weise, die Anfrage, Verwirklichungen nach Fotos folgt."
    ],
    "en": [
      "Decorating workshop of ceramic objects and glasses. Creation, ancient-like reproduction, different styles depending on the request, picture-taking of the artwork…"
    ],
    "it": [
      "Laboratorio di decorazione a mano su ceramica e vetro. Lavori creativi, riproduzione di pezzi antichi, lavori personalizzati su richiesta, lavori da fotografie. Tavolo di osservazione."
    ],
    "fr": [
      "Atelier de décoration à la main sur céramiques et verres. Travaux de création, reproduction d'ancien, travail à façon suivant demande, réalisations d'après photos. Table d'observation."
    ],
    "nl": [
      "Workshop(Studio) van decoratie in de hand op keramiek en glas. Werken op het gebied van creatie, reproductie van voormalige(oud), werken met manier volgende boekingsverzoek, realisaties volgens foto's."
    ],
    "es": [
      "Taller de decoración a mano en cerámica y vidrio. Trabajos creativos, reproducción de piezas antiguas, trabajos a medida por encargo, trabajos a partir de fotografías. Mesa de observación."
    ]
  },
