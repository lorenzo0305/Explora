  "rdfs:comment": {
    "de": [
      "\"Freiheit: Lebendige, entfaltete Kraft\"\r\n\r\nIm Rahmen des Dichterfrühlings 2026 lädt die Mediathek von Cusset Sie zu einem Workshop für kreative Poesie ein, der unter dem Motto \"Freiheit und innerer Antrieb\" steht."
    ],
    "en": [
      "\"Freedom: a living, unfolding force\"\r\n\r\nAs part of Printemps des Poètes 2026, the Médiathèque de Cusset invites you to a creative poetry workshop on the theme of freedom and inner drive."
    ],
    "it": [
      "\"La libertà: una forza viva e in divenire\"\r\n\r\nNell'ambito del Printemps des Poètes 2026, la Médiathèque de Cusset vi invita a partecipare a un laboratorio di poesia creativa sul tema della libertà e della forza interiore."
    ],
    "fr": [
      "« La liberté : Force vive, déployée »\r\n\r\nDans le cadre du Printemps des Poètes 2026, la Médiathèque de Cusset vous invite à un atelier de poésie créative placé sous le signe de la liberté et de l’élan intérieur."
    ],
    "nl": [
      "\"Vrijheid: een levende, ontvouwende kracht\"\r\n\r\nIn het kader van Printemps des Poètes 2026 nodigt de Médiathèque de Cusset je uit voor een creatieve poëzieworkshop rond het thema vrijheid en innerlijke gedrevenheid."
    ],
    "es": [
      "\"La libertad: una fuerza viva que se despliega\"\r\n\r\nEn el marco del Printemps des Poètes 2026, la Médiathèque de Cusset le invita a un taller de poesía creativa sobre el tema de la libertad y el impulso interior."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Printemps des Poètes • Atelier de poésie créative"
    ]
  },
