  "rdfs:comment": {
    "de": [
      "Im Herzen der Montagnes du Matin hat sich dieses Gasthaus in der einstigen «Petite école» des Weilers Bouchala eingenistet. Hier finden Sie traditionelle Gerichte aus Lyon und dem Forez."
    ],
    "en": [
      "The Auberge is set in a former small school in the hamlet of Bouchala. They serve traditional specialities of Lyon and Forez."
    ],
    "it": [
      "La locanda ha preso casa nell'ex piccola scuola della frazione di Bouchala. Celebra la tradizione culinaria francese con piatti locali preparati con passione.\r\nQui ci prendiamo il tempo per mangiare bene e condividere i momenti migliori."
    ],
    "fr": [
      "L'auberge a fait son nid dans l'ancienne petite école du hameau de Bouchala. Elle célèbre la tradition culinaire française avec des plats du terroir préparés avec passion..\r\nIci, on prend le temps de bien manger et de partager de bons moments."
    ],
    "es": [
      "La posada se ha instalado en la antigua escuelita de la aldea de Bouchala. Celebra la tradición culinaria francesa con platos locales preparados con pasión.\r\nAquí nos tomamos el tiempo para comer bien y compartir buenos momentos."
    ],
    "nl": [
      "De herberg is gevestigd in het voormalige schooltje in het gehucht Bouchala. Het viert de Franse culinaire traditie met lokale gerechten bereid met passie.\r\nHier nemen we de tijd om goed te eten en mooie momenten te delen."
    ]
  },
