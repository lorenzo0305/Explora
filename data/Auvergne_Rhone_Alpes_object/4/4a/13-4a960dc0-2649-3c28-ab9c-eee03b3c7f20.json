  "rdfs:comment": {
    "de": [
      "Ein Besuch lohnt sich: Die Skulpturen von Jean-Paul Six de Versilhac schmücken den Chor in Übereinstimmung mit dem Taufbecken und dem Beichtstuhl."
    ],
    "en": [
      "A visit is a must: scultpures by Jean-Paul Six de Versilhac adorn the choir in harmony with the baptismal font and confessional."
    ],
    "it": [
      "La visita è d'obbligo: il coro è ornato da sculture di Jean-Paul Six de Versilhac, in sintonia con il fonte battesimale e il confessionale."
    ],
    "fr": [
      "Une visite s'impose : les scultpures de Jean-Paul Six de Versilhac ornent le choeur en accord avec les fonds baptismaux et le confessionnal."
    ],
    "es": [
      "La visita es obligada: el coro está adornado con esculturas de Jean-Paul Six de Versilhac, en consonancia con la pila bautismal y el confesionario."
    ],
    "nl": [
      "Een bezoek is een must: het koor is versierd met beeldhouwwerken van Jean-Paul Six de Versilhac, net als het doopvont en de biechtstoel."
    ]
  },
