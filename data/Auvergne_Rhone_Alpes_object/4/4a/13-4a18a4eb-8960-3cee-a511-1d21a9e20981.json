  "rdfs:comment": {
    "de": [
      "Am Fuße der Weinberge und am Wasser gelegen, bieten wir Ihnen eine traditionelle französische Küche an.\r\nSie können hier ebenso gut einen Kaffee trinken, ein Eis essen oder unser Tagesmenü probieren..."
    ],
    "en": [
      "Situated at the foot of the vineyards and by the water, we offer traditional French cuisine.\r\nYou can also enjoy a coffee, an ice cream or our daily menu..."
    ],
    "it": [
      "Ai piedi dei vigneti e in riva al mare, serviamo una cucina francese tradizionale.\r\nPotete anche venire a prendere un caffè, un gelato o provare il nostro menu del giorno..."
    ],
    "fr": [
      "Situé au pied des vignes et au bord de l’eau, nous vous proposons une cuisine traditionnelle française.\r\nVous pouvez tout aussi bien venir prendre un café, manger une glace ou déguster notre menu du jour..."
    ],
    "es": [
      "Situado al pie de los viñedos y junto al agua, servimos cocina tradicional francesa.\r\nTambién puede venir a tomar un café, un helado o probar nuestro menú diario..."
    ],
    "nl": [
      "Aan de voet van de wijngaarden en aan het water serveren we traditionele Franse gerechten.\r\nJe kunt hier ook terecht voor een kopje koffie, een ijsje of probeer ons dagmenu..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les Frangines"
    ]
  },
