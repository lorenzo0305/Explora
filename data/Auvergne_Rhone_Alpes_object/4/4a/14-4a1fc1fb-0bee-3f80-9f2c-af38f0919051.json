  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8d6ec1e6-8afe-317d-a8dd-313af0ab6120",
      "dc:description": {
        "de": [
          "*** Abend Positive Erziehung und Persönliche Entwicklung **\n\nMöchten Sie mehr über positive Erziehung und persönliche Entwicklung erfahren?\nNehmen Sie an einem Abend des Austauschs in Fruges teil, von 19 bis 21 Uhr, der von einem Fachmann geleitet wird."
        ],
        "en": [
          "** Positive Education and Personal Development Evening ** (in French)\n\nWould you like to find out more about positive education and personal development?\nCome and join us for an evening of discussion in Fruges, from 7pm to 9pm, hosted by a professional."
        ],
        "it": [
          "** Serata di educazione positiva e sviluppo personale\n\nVolete saperne di più sull'educazione positiva e sullo sviluppo personale?\nUnitevi a noi per una serata di discussione a Fruges, dalle 19.00 alle 21.00, condotta da un professionista."
        ],
        "fr": [
          "** Soirée Éducation Positive et Développement Personnel **\n\nVous souhaitez en savoir plus sur l'éducation positive et le développement personnel ?\nVenez participer à une soirée d'échanges à Fruges, de 19h à 21h, animée par un professionnel."
        ],
        "es": [
          "** Tarde de educación positiva y desarrollo personal\n\n¿Quieres saber más sobre la educación positiva y el desarrollo personal?\nVen y únete a nosotros para una tarde de debate en Fruges, de 19:00 a 21:00, dirigida por un profesional."
        ],
        "nl": [
          "** Avond Positief Opvoeden en Persoonlijke Ontwikkeling\n\nWil je meer weten over positief opvoeden en persoonlijke ontwikkeling?\nKom dan naar Fruges voor een discussieavond van 19.00 tot 21.00 uur onder leiding van een professional."
        ]
      },
      "@type": [
        "Description"
      ],
