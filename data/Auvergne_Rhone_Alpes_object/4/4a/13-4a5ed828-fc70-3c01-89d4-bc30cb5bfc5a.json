  "rdfs:comment": {
    "de": [
      "In diesem Familienbetrieb, der seit vier Generationen besteht, können Sie nach Vereinbarung den Weinkeller und die Weinberge besichtigen. Die Weinprobe ist immer ein geselliger Moment für Gruppen und Familien"
    ],
    "en": [
      "Come and discover the cellar and vineyards of this 4-generation family business by appointment. Tasting is always a convivial moment for groups and families"
    ],
    "it": [
      "Venite a scoprire la cantina e i vigneti di questa azienda familiare di 4 generazioni su appuntamento. La degustazione è sempre un momento conviviale per gruppi e famiglie"
    ],
    "fr": [
      "Dans cette exploitation familiale depuis 4 générations, venez découvrir sur rendez vous la cave et le vignoble. La dégustation est toujours un moment convivial pour les groupes et les familles"
    ],
    "es": [
      "Venga a descubrir la bodega y los viñedos de esta empresa familiar de 4 generaciones con cita previa. La degustación es siempre un momento de convivencia para grupos y familias"
    ],
    "nl": [
      "Kom op afspraak de kelder en wijngaarden van dit familiebedrijf van 4 generaties ontdekken. De proeverij is altijd een gezellig moment voor groepen en families"
    ]
  },
