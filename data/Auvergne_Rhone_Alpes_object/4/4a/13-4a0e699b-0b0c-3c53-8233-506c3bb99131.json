  "rdfs:comment": {
    "de": [
      "Am 9. Juni findet im Stade des Alpes das letzte Qualifikationsspiel für die Fußballweltmeisterschaft der Frauen in Brasilien 2027 statt. Die Mannschaft von Laurent Bonadei trifft auf Irland, nachdem sie zuvor gegen Schweden, Polen und die Niederlande gespielt hat."
    ],
    "en": [
      "On June 9, the Stade des Alpes will host the final qualifying match for the Brazil 2027 Women's World Cup. Laurent Bonadei's Bleuettes will meet Ireland after taking on Sweden, Poland and the Netherlands."
    ],
    "it": [
      "Il 9 giugno, lo Stade des Alpes ospiterà l'ultima partita di qualificazione per la Coppa del Mondo femminile Brasile 2027. Le Bleuettes di Laurent Bonadei incontreranno l'Irlanda dopo aver affrontato Svezia, Polonia e Paesi Bassi."
    ],
    "fr": [
      "Le 9 juin prochain, le stade des Alpes accueillera le dernier match des qualifications pour la coupe du monde féminine de foot Brésil 2027. Les bleues de Laurent Bonadei rencontreront l'Irlande après avoir affronté la Suède, la Pologne et les Pays-Bas."
    ],
    "nl": [
      "Op 9 juni is het Stade des Alpes gastheer van de laatste kwalificatiewedstrijd voor het wereldkampioenschap voetbal voor vrouwen in Brazilië 2027. De Bleuettes van Laurent Bonadei ontmoeten Ierland na Zweden, Polen en Nederland."
    ],
    "es": [
      "El 9 de junio, el Stade des Alpes acogerá el último partido de clasificación para el Mundial femenino de Brasil 2027. Las Bleuettes de Laurent Bonadei se medirán a Irlanda tras enfrentarse a Suecia, Polonia y Holanda."
    ]
  },
  "rdfs:label": {
    "fr": [
      "France-Irlande : qualifications pour la coupe du monde de foot 2027"
    ]
  },
