  "rdfs:comment": {
    "de": [
      "Im Restaurant der Villa Cécile stehen lokale und saisonale Produkte aus dem Kurzstreckenhandel im Vordergrund, die eine Garantie für geschmackliche Qualität und Frische sind. Chefkoch Yann Le Fevre bietet eine schmackhafte und kreative Küche in einem idyllischen Rahmen."
    ],
    "en": [
      "Villa Cécile's restaurant focuses on local, seasonal produce, a guarantee of quality and freshness. Chef Yann Le Fevre offers tasty, creative cuisine in an idyllic setting."
    ],
    "it": [
      "Il ristorante Villa Cécile utilizza prodotti locali e di stagione per garantire qualità e freschezza. Lo chef Yann Le Fevre propone una cucina gustosa e creativa in un ambiente idilliaco."
    ],
    "fr": [
      "Le restaurant de la Villa Cécile  met à l’honneur les produits locaux et de saison en circuit court, garantie de qualité gustative et de fraîcheur. Le Chef Yann Le Fevre propose une cuisine savoureuse et créative dans un cadre idyllique."
    ],
    "nl": [
      "Het restaurant Villa Cécile gebruikt lokale, seizoensgebonden producten om kwaliteit en versheid te garanderen. Chef Yann Le Fevre biedt smakelijke, creatieve gerechten in een idyllische omgeving."
    ],
    "es": [
      "El restaurante Villa Cécile utiliza productos locales de temporada para garantizar la calidad y la frescura. El Chef Yann Le Fevre propone una cocina sabrosa y creativa en un marco idílico."
    ]
  },
