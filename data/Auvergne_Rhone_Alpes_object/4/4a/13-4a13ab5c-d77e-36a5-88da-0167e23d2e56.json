  "rdfs:comment": {
    "de": [
      "Die Abfahrt des Sessellifts von Seraussaix beginnt im Wald und endet auf den Bergrücken von Zore. Dieser kuppelbare 6-Sitzer ermöglicht es Ihnen, das außergewöhnliche Panorama auf die Monts du Chablais zu bewundern."
    ],
    "en": [
      "The departure of the Seraussaix chairlift starts in the forest and ends on the Zore ridge. This 6-seater detachable chairlift will allow you to admire the exceptional panorama of the Monts du Chablais."
    ],
    "it": [
      "La partenza della seggiovia Seraussaix inizia nel bosco e termina sulla cresta di Zore. Questa seggiovia staccabile a 6 posti vi permetterà di ammirare l'eccezionale panorama dei Monts du Chablais."
    ],
    "fr": [
      "Le départ du télésiège de Seraussaix commence dans la forêt et se termine sur les crêtes de Zore. Ce 6 places débrayables vous permettra d'admirer le panorama exceptionnel sur les Monts du Chablais."
    ],
    "es": [
      "La salida del telesilla de Seraussaix comienza en el bosque y termina en la cresta de Zore. Este telesilla desmontable de 6 plazas le permitirá admirar el excepcional panorama de los Montes del Chablais."
    ],
    "nl": [
      "Het vertrek van de stoeltjeslift Seraussaix begint in het bos en eindigt op de bergkam van Zore. Met deze 6-persoons afneembare stoeltjeslift kunt u het uitzonderlijke panorama van de Monts du Chablais bewonderen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Seraussaix chairlift"
    ],
    "fr": [
      "Télésiège de Séraussaix"
    ]
  },
