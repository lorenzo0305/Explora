      "@id": "https://data.datatourisme.fr/edc990b5-16d3-3caa-be2c-9ae484fda9bb",
      "dc:description": {
        "de": [
          "Ein traditionelles Karussell auf dem Place du Centenaire sorgt für Spaß bei Groß und Klein.\n\nTäglich von 10 bis 19 Uhr geöffnet."
        ],
        "en": [
          "A traditional merry-go-round on the Place du Centenaire for young and old to enjoy.\n\nOpen daily from 10am to 7pm."
        ],
        "it": [
          "Una giostra tradizionale sulla Place du Centenaire per il divertimento di grandi e piccini.\n\nAperta tutti i giorni dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Un manège traditionnel sur la Place du Centenaire pour le plaisir des petits et des grands.\n\nOuvert tous les jours de 10h à 19h."
        ],
        "es": [
          "Un tiovivo tradicional en la plaza del Centenario para disfrute de grandes y pequeños.\n\nAbierto todos los días de 10:00 a 19:00."
        ],
        "nl": [
          "Een traditionele draaimolen op de Place du Centenaire voor jong en oud.\n\nElke dag geopend van 10.00 tot 19.00 uur."
        ]
      },
