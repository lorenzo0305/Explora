  "rdfs:comment": {
    "de": [
      "In einer geschützten und sicheren natürlichen Umgebung mit einem Panoramablick auf den Mézenc und den Meygal. Jean-Noël heißt Sie herzlich willkommen, damit Sie seine Leidenschaft entdecken können: das Bogenschießen auf 24 tierische Zielscheiben in Originalgröße."
    ],
    "en": [
      "In a safe, unspoilt natural setting, with panoramic views of the Mezenc and Meygal mountains. Jean-Noël warmly welcomes you to discover his passion: archery on 24 life-size animal targets."
    ],
    "it": [
      "In un ambiente naturale sicuro e incontaminato, con vista panoramica sulle montagne Mézenc e Meygal. Jean-Noël vi accoglie calorosamente per farvi scoprire la sua passione: il tiro con l'arco su 24 bersagli animali a grandezza naturale."
    ],
    "fr": [
      "Dans un cadre naturel préservé et sécurisé, avec un point de vue panoramique sur le Mézenc et le Meygal. Jean-Noël vous accueille chaleureusement pour vous faire découvrir sa passion : le tir à l'arc sur 24 cibles animalières à taille réelle."
    ],
    "nl": [
      "In een veilige, ongerepte natuurlijke omgeving, met een panoramisch uitzicht op de bergen Mézenc en Meygal. Jean-Noël heet je van harte welkom om zijn passie te ontdekken: boogschieten op 24 levensgrote dierendoelen."
    ],
    "es": [
      "En un entorno natural seguro y virgen, con vistas panorámicas a los montes Mézenc y Meygal. Jean-Noël le da la bienvenida para que descubra su pasión: el tiro con arco en 24 dianas de animales a tamaño real."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Archers du Lou Poney"
    ]
  },
