  "rdfs:comment": {
    "de": [
      "Anlässlich ihres 40. Jubiläums bietet die Vereinigung Les Pléîades eine Show, Workshops, eine Ausstellung, Himmelsbeobachtungen und eine Leseecke für Groß und Klein.\r\nNicht verpassen!"
    ],
    "en": [
      "For their 40th anniversary, the Les Pléîades association is offering a show, workshops, exhibition, sky observation and a reading corner for young and old alike.\r\nNot to be missed!"
    ],
    "it": [
      "Per il suo 40° anniversario, l'associazione Les Pléîades organizza uno spettacolo, laboratori, mostre, osservazione del cielo e un angolo di lettura per grandi e piccini.\r\nDa non perdere!"
    ],
    "fr": [
      "Pour leur 40ème anniversaire, l'association Les Pléîades vous propose spectacle, ateliers, exposition, observation du ciel, coin lecture pour petits et grands.\r\nA ne pas manquer !"
    ],
    "nl": [
      "Voor hun 40-jarig bestaan organiseert de vereniging Les Pléîades een voorstelling, workshops, tentoonstelling, observatie van de hemel en een leeshoek voor jong en oud.\r\nNiet te missen!"
    ],
    "es": [
      "Con motivo de su 40 aniversario, la asociación Les Pléîades organiza un espectáculo, talleres, exposiciones, observación del cielo y un rincón de lectura para grandes y pequeños.\r\nNo se lo pierda"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'astronomie pour tous !"
    ]
  },
