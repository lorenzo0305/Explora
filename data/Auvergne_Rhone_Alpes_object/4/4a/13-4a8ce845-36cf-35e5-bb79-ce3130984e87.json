  "rdfs:comment": {
    "de": [
      "Bauer und Sammler Benoit Morge betreibt den Anbau und das Sammeln von aromatischen und medizinischen Pflanzen. Er baut auf einer Parzelle von einem halben Hektar etwa 50 dieser Kräuter an und sammelt weitere 30 Sorten wild."
    ],
    "en": [
      "Benoit Morge is a farmer-gatherer who grows and harvests aromatic and medicinal plants. He grows around fifty of them on a half-hectare plot and wild-picks around thirty other varieties."
    ],
    "it": [
      "L'agricoltore-raccoglitore Benoit Morge coltiva e raccoglie piante aromatiche e medicinali. Ne coltiva una cinquantina su un terreno di mezzo ettaro e ne raccoglie selvaggiamente una trentina di altre varietà."
    ],
    "fr": [
      "Paysan cueilleur, Benoit Morge pratique la culture et la cueillette de plantes aromatiques et médicinales. Il en cultive une cinquantaine sur une parcelle d'un demi hectare et pratique la cueillette sauvage d'une trentaine d'autres variétés."
    ],
    "es": [
      "El agricultor recolector Benoit Morge cultiva y recolecta plantas aromáticas y medicinales. Cultiva unas cincuenta en una parcela de media hectárea y recolecta de forma silvestre otras treinta variedades."
    ],
    "nl": [
      "Boer-plukker Benoit Morge kweekt en plukt aromatische en geneeskrachtige planten. Hij kweekt er ongeveer vijftig op een perceel van een halve hectare en plukt in het wild ongeveer dertig andere soorten."
    ]
  },
  "rdfs:label": {
