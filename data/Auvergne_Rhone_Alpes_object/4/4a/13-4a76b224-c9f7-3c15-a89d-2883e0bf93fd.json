  "rdfs:comment": {
    "de": [
      "Auf die Ernte von Wildpflanzen ausgerichtet und zertifizierte Bio-Landwirtschaft. Ätherische Öle von feinem Lavendel, Lavandin, Lavendel Aspik, Thymian, Rosmarin, Cade... Biokosmetik (Pflegecreme, Seife, Shampoo...). Thematische Führungen."
    ],
    "en": [
      "Harvesting of wild and certified organic plants. Essences of fine, hybrid and spike lavender, thyme, rosemary, juniper. Organic cosmetics (face cream, soap, shampoo …) Thematic tours."
    ],
    "it": [
      "Orientato alla raccolta di piante selvatiche e all'agricoltura biologica certificata. Oli essenziali di lavanda fine, lavandina, lavanda spiga, timo, rosmarino, cade... Cosmetici biologici (crema per la pelle, sapone, shampoo...). Visite a tema."
    ],
    "fr": [
      "Orienté vers les récoltes de plantes sauvages et agriculture bio certifiée. Huiles essentielles de lavande fine, lavandin, lavande aspic, thym, romarin, cade... Cosmétiques bio (crème de soin, savon, shampoing...). Visite à thème."
    ],
    "es": [
      "Orientado a la recolección de plantas silvestres y a la agricultura ecológica certificada. Aceites esenciales de lavanda fina, lavandín, espliego, tomillo, romero, cade... Cosméticos ecológicos (crema para la piel, jabón, champú...). Visitas temáticas."
    ],
    "nl": [
      "Gericht op het oogsten van wilde planten en gecontroleerde biologische landbouw. Etherische olieën van lavendel, spijk, thijn, rozemarijn, jeneverbessen... Biologische cosmetica (verzorgingscrème, zeep, shampoo...). Rondleidingen per thema."
    ]
  },
