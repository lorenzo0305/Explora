  "rdfs:comment": {
    "de": [
      "Sind Sie ein Fan von Nervenkitzel und träumen davon, in den Overall eines Rennfahrers zu schlüpfen? Der ELLIP6-Simulator wartet auf Sie und ermöglicht Ihnen den Übergang von der Formel 1 zum Rallyesport."
    ],
    "en": [
      "Are you a thrill-seeker who dreams of wearing a racing driver’s helmet? The ELLIP 6 driving simulator is perfect for you and will teach you everything from F1 to rally."
    ],
    "it": [
      "Sei un fan del brivido e sogni di indossare una tuta da pilota? Il simulatore ELLIP6 ti aspetta e ti permetterà di passare dalla F1 ai rally."
    ],
    "fr": [
      "Vous êtes fan de sensations fortes et rêvez d'endosser la combinaison d'un pilote de course ? Le simulateur ELLIP6 vous attend et vous permettra de passer de la F1 au rallye."
    ],
    "es": [
      "¿Le gustan las emociones fuertes y sueña con ponerse el traje de piloto de carreras? El simulador ELLIP6 te está esperando y te permitirá pasar de la F1 al rally."
    ],
    "nl": [
      "Bent u een sensatiezoeker en droomt u ervan een racepak aan te trekken? De ELLIP6-simulator staat voor u klaar en stelt u in staat om van F1 naar rally te gaan."
    ]
  },
  "rdfs:label": {
    "en": [
      "Driving Simulator"
    ],
