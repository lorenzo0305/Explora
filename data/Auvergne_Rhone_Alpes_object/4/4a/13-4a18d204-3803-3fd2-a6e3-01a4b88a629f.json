  "rdfs:comment": {
    "de": [
      "Verleih von Fahrrädern, Fahrrädern mit elektrischer Unterstützung und Mountainbikes. Direkter Zugang zum Grünen Weg. Für alle zugänglich\r\nMögliche Kombinationsformel: Kanu und Rückfahrt mit dem Fahrrad."
    ],
    "en": [
      "Rental of bicycles, electric-assisted bicycles and mountain bikes. Direct access to the green lane. Accessible to all\r\nCombined formula possible: canoeing and bike return."
    ],
    "it": [
      "Noleggio di biciclette, bici elettriche e mountain bike. Accesso diretto alla greenway. Accessibile a tutti\r\nPossibilità di formula combinata: ritorno in canoa e bicicletta."
    ],
    "fr": [
      "Location de vélos, de vélos à assistance électrique et de V.T.T.. Accès direct à la voie verte. Accessible à tous. \r\nFormule combinée possible : canoë et retour vélo."
    ],
    "nl": [
      "Verhuur van fietsen, elektrische fietsen en mountainbikes. Directe toegang tot de greenway. Toegankelijk voor iedereen\r\nGecombineerde formule mogelijk: terugkeer met kano en fiets."
    ],
    "es": [
      "Alquiler de bicicletas, bicicletas eléctricas y bicicletas de montaña. Acceso directo a la vía verde. Accesible para todos\r\nPosibilidad de fórmula combinada: regreso en canoa y bicicleta."
    ]
  },
