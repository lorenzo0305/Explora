  "rdfs:comment": {
    "de": [
      "Ma Nouvelle Bicyclette, Verleih, Reparatur und Verkauf von Elektrofahrrädern.\r\nEntdecken Sie unseren Verleihservice für Elektrofahrräder, je nachdem, für welchen Zeitraum Sie sich interessieren: einen halben Tag, einen ganzen Tag oder bis zu 10 Tage."
    ],
    "en": [
      "Ma Nouvelle Bicyclette, rental, repair and sale of electric bikes.\r\nDiscover our electric bike rental service and choose the period you're interested in: half-day, day or up to 10 days."
    ],
    "it": [
      "Ma Nouvelle Bicyclette, noleggio, riparazione e vendita di biciclette elettriche.\r\nScoprite il nostro servizio di noleggio di biciclette elettriche e scegliete il periodo che vi interessa: mezza giornata, giornata o fino a 10 giorni."
    ],
    "fr": [
      "Ma Nouvelle Bicyclette, location, réparation et vente de vélos électriques.\r\nDécouvrez notre service de location de vélos électriques en fonction de la période qui vous intéresse : demi-journée, journée ou jusqu'à 10 jours."
    ],
    "nl": [
      "Ma Nouvelle Bicyclette, verhuur, reparatie en verkoop van elektrische fietsen.\r\nOntdek onze service voor het huren van elektrische fietsen en kies de periode waarin je geïnteresseerd bent: halve dag, dag of tot 10 dagen."
    ],
    "es": [
      "Ma Nouvelle Bicyclette, alquiler, reparación y venta de bicicletas eléctricas.\r\nDescubra nuestro servicio de alquiler de bicicletas eléctricas y elija el periodo que le interese: medio día, un día o hasta 10 días."
    ]
  },
