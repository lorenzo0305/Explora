  "rdfs:comment": {
    "de": [
      "Patronatsfest in Couteuges mit Samstag, Petanque-Wettbewerb um 16 Uhr und Musikabend und Sonntag, ländliches Mittagessen und humorvolle Sketche und Lieder - Mikos und Bigoudi \"Casting de folie\"."
    ],
    "en": [
      "Couteuges patron saint's day with petanque competition at 4pm on Saturday and musical evening, and on Sunday, country-style lunch and comedy sketches and songs - Mikos and Bigoudi \"Casting de folie\"."
    ],
    "it": [
      "Festa patronale di Couteuges con gara di bocce alle 16.00 del sabato e serata musicale la domenica, seguita da un pranzo al sacco e da sketch comici e canzoni - Mikos e Bigoudi \"Casting de folie\"."
    ],
    "fr": [
      "Fête patronale de Couteuges avec samedi, concours de pétanque à 16h et soirée musicale et dimanche, repas champêtre le midi et sketches et chansons humoristiques - Mikos et Bigoudi \"Casting de folie\"."
    ],
    "nl": [
      "Patroonsfeest van Couteuges met petanquewedstrijd om 16u op zaterdag en muziekavond op zondag, gevolgd door een picknicklunch en komische sketches en liedjes - Mikos en Bigoudi \"Casting de folie\"."
    ],
    "es": [
      "Fiestas patronales de Couteuges con concurso de petanca a las 16h el sábado y velada musical el domingo, seguida de un almuerzo campestre y de sketches cómicos y canciones - Mikos y Bigoudi \"Casting de folie\"."
    ]
  },
  "rdfs:label": {
    "fr": [
