  "rdfs:comment": {
    "de": [
      "Gegenüber dem Eingang der Kapelle Notre-Dame öffnet sich die Tür des ehemaligen Klosters der Dominikanerbrüder unter dem Vorbau der Kapelle."
    ],
    "en": [
      "Opposite the entrance to Chapelle Notre-Dame, the door to the former Dominican friars' convent opens under the chapel porch."
    ],
    "it": [
      "Di fronte all'ingresso della Chapelle Notre-Dame, sotto il portico della cappella si apre la porta dell'ex convento dei frati domenicani."
    ],
    "fr": [
      "Face à l'entrée de la Chapelle Notre-Dame, la porte de l'ancien couvent des Frères Dominicains s'ouvre sous le porche de la Chapelle."
    ],
    "nl": [
      "Tegenover de ingang van de Chapelle Notre-Dame opent de deur van het voormalige klooster van de Dominicaanse broeders onder het portaal van de kapel."
    ],
    "es": [
      "Frente a la entrada de la Chapelle Notre-Dame, la puerta del antiguo convento de los frailes dominicos se abre bajo el pórtico de la capilla."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Portail de l'ancien couvent des Dominicains | Pradelles"
    ]
  },
