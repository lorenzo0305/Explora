  "rdfs:comment": {
    "de": [
      "Fast fünfundzwanzig Jahre nach Barbaras Tod verleiht die Schauspielerin Marie-Sophie Ferdane der \"langen braunen Dame\" Körper und Stimme.\r\nSu Reservierung unter 04 75 53 36 94"
    ],
    "en": [
      "Almost twenty-five years after Barbara's death, actress Marie-Sophie Ferdane gives body and voice to the \"long brunette lady\".\r\nFor bookings: 04 75 53 36 94"
    ],
    "it": [
      "A quasi venticinque anni dalla morte di Barbara, l'attrice Marie-Sophie Ferdane dà corpo e voce alla \"lunga signora bruna\".\r\nPer prenotazioni: 04 75 53 36 94"
    ],
    "fr": [
      "Près de vingt-cinq ans après la disparition de Barbara, la comédienne Marie-Sophie Ferdane donne corps et voix à la «longue dame brune». \r\nSu réservation au 04 75 53 36 94"
    ],
    "es": [
      "Casi veinticinco años después de la muerte de Barbara, la actriz Marie-Sophie Ferdane da cuerpo y voz a la \"larga dama morena\".\r\nPara reservas: 04 75 53 36 94"
    ],
    "nl": [
      "Bijna vijfentwintig jaar na Barbara's dood geeft actrice Marie-Sophie Ferdane lichaam en stem aan de \"lange brunette dame\".\r\nVoor boekingen: 04 75 53 36 94"
    ]
  },
