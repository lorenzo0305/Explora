  "rdfs:comment": {
    "de": [
      "Seit über 10 Jahren führt der Ruderclub Pierrelatte Jugendliche und Erwachsene in den Rudersport ein und bildet sie auf dem Plan d'eau von Pierrelatte aus."
    ],
    "en": [
      "For over 10 years, the Pierrelatte Rowing Club has been introducing and training youngsters and adults to rowing on the Pierrelatte lake."
    ],
    "it": [
      "Da oltre 10 anni, la Società Canottieri Pierrelatte avvia e forma giovani e adulti alla pratica del canottaggio sul livello dell'acqua del Pierrelatte."
    ],
    "fr": [
      "Depuis plus de 10 ans, le club d'Aviron Pierrelatte initie et forme jeunes et adultes, à la pratique de l'Aviron, sur le Plan d'eau de Pierrelatte."
    ],
    "es": [
      "Desde hace más de 10 años, el Club de Remo de Pierrelatte inicia y forma a jóvenes y adultos en la práctica del remo en el nivel del agua de Pierrelatte."
    ],
    "nl": [
      "Al meer dan 10 jaar introduceert en traint de Pierrelatte Rowing Club jongeren en volwassenen in het roeien op het meer van Pierrelatte."
    ]
  },
