  "rdfs:comment": {
    "de": [
      "Die Pastourelle 2000 findet im Herzen der Auvergne statt, im Land der roten Kühe mit demselben Namen SALERS. Es handelt sich um eine symbolträchtige Sportveranstaltung, die mehrere Disziplinen miteinander verbindet: Wandern, Mountainbiken, Rennen. Es werden Abendveranstaltungen organisiert."
    ],
    "en": [
      "The Pastourelle 2000 takes place in the heart of the Auvergne, in the land of the red cows of the same name, SALERS. This emblematic sporting event combines several disciplines: hiking, mountain biking and racing. Evening events are also organized."
    ],
    "it": [
      "La Pastourelle 2000 si svolge nel cuore dell'Alvernia, nella terra delle omonime mucche rosse, SALERS. Questo emblematico evento sportivo combina diverse discipline: escursionismo, mountain bike e corsa. Vengono organizzati anche eventi serali."
    ],
    "fr": [
      "La Pastourelle 2000 se déroule au cœur de l'Auvergne au pays des vaches rouges du même nom SALERS. C'est une manifestation sportive emblématique qui combine plusieurs disciplines : rando, VTT, courses. Des soirées sont mises en place."
    ],
    "es": [
      "La Pastourelle 2000 se celebra en el corazón de Auvernia, en la tierra de las vacas rojas del mismo nombre, SALERS. Este emblemático acontecimiento deportivo combina varias disciplinas: senderismo, bicicleta de montaña y carreras. También se organizan eventos nocturnos."
    ],
    "nl": [
      "De Pastourelle 2000 vindt plaats in het hart van de Auvergne, in het land van de rode koeien met dezelfde naam, SALERS. Dit emblematische sportevenement combineert verschillende disciplines: wandelen, mountainbiken en racen. Er worden ook avondevenementen georganiseerd."
    ]
  },
  "rdfs:label": {
