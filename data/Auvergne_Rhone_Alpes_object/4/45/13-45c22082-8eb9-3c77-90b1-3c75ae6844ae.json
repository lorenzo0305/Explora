  "rdfs:comment": {
    "de": [
      "Oasis ist :\r\n- Eine Unterkunft mit 16 Plätzen + 3 Wohnungen in Romans.\r\n- Eine Tagesstätte, die von Montag bis Samstag von 9 bis 14 Uhr geöffnet ist, im Winter bis 16 Uhr.\r\n\r\nAb Februar 2024 wird es auch Betten mit Gesundheitsversorgung geben."
    ],
    "en": [
      "Oasis is :\r\n- A 16-place accommodation center + 3 apartments in Romans\r\n- A day center open Monday to Saturday, 9am to 2pm, 4pm in winter\r\n\r\nFrom February 2024 onwards, there will also be health care beds."
    ],
    "it": [
      "Oasis è :\r\n-\tUn centro di accoglienza da 16 posti + 3 appartamenti a Romans\r\n-\tUn centro diurno aperto dal lunedì al sabato dalle 9.00 alle 14.00, alle 16.00 durante il periodo invernale\r\n\r\nA partire da febbraio 2024, ci saranno anche posti letto di assistenza sanitaria"
    ],
    "fr": [
      "Oasis c’est :\r\n-\tUn centre d’hébergement de 16 places + 3 appartements sur Romans\r\n-\tUn accueil de jour ouvert du lundi au samedi de 9H à 14H, 16 H pendant la période hivernale\r\n\r\nA partir de février 2024 il y aura aussi des lits halte soins santé"
    ],
    "nl": [
      "Oasis is :\r\n- Een opvangcentrum met 16 plaatsen + 3 appartementen in Romans\r\n- Een dagcentrum open van maandag tot zaterdag van 9u tot 14u, 16u tijdens de winterperiode.\r\n\r\nVanaf februari 2024 zullen er ook zorgbedden zijn."
    ],
    "es": [
      "Oasis es :\r\n-\tUn centro de alojamiento de 16 plazas + 3 pisos en Romans\r\n-\tUn centro de día abierto de lunes a sábado de 9h a 14h, 16h durante el periodo invernal\r\n\r\nA partir de febrero de 2024, también habrá camas sanitarias"
    ]
  },
  "rdfs:label": {
