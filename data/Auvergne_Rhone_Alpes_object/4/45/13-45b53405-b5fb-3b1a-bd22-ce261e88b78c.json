  "rdfs:comment": {
    "de": [
      "Dieses Jahr geht es ganz groß los!\r\nUm die festlichste Party des Jahres zu feiern, begrüßt Mamão NoName @groupenonamemusic für ein Live-Konzert, das den Saal vom ersten Riff bis zum letzten Refrain zum Beben bringen wird!"
    ],
    "en": [
      "This year, we're going all out!\r\nTo celebrate the most festive holiday of the year, Mamão welcomes NoName @groupenonamemusic for a live concert that promises to rock the house from the first riff to the last chorus!"
    ],
    "it": [
      "Quest'anno, ci diamo da fare!\r\nPer celebrare la festa più festosa dell'anno, Mamão dà il benvenuto ai NoName @gruppoenonamemusic per un concerto dal vivo che promette di spaccare la casa dal primo riff all'ultimo ritornello!"
    ],
    "fr": [
      "Cette année, on voit les choses en grand !\r\nPour célébrer la fête la plus festive de l’année, Mamão accueille NoName @groupenonamemusic pour un concert live qui promet de faire vibrer la salle du premier riff jusqu’au dernier refrain !"
    ],
    "es": [
      "Este año, ¡vamos a por todas!\r\nPara celebrar la fiesta más festiva del año, Mamão recibe a NoName @groupenonamemusic en un concierto en directo que promete arrasar desde el primer riff hasta el último estribillo"
    ],
    "nl": [
      "Dit jaar gaan we er helemaal voor!\r\nOm de meest feestelijke feestdag van het jaar te vieren, verwelkomt Mamão NoName @grouppenonamemusic voor een live concert dat belooft het huis te rocken van de eerste riff tot het laatste refrein!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert de la Saint Patrick - Mamão"
    ]
  },
