  "rdfs:comment": {
    "de": [
      "An diesem geschichtsträchtigen Ort (es war der erste Lebensmittelladen von Geoffroy Guichard in Feurs) treffen Sie auf die Küchenchefin Pauline, die Ihnen raffinierte und überraschende \"hausgemachte\" Gerichte vorschlägt."
    ],
    "en": [
      "In this place full of history (it was Geoffroy Guichard's first grocery store in Feurs), meet chef Pauline who suggests refined and surprising \"homemade\" dishes."
    ],
    "it": [
      "In un luogo ricco di storia (fu la prima drogheria di Geoffroy Guichard a Feurs), incontrate la chef Pauline, che propone piatti raffinati e sorprendenti fatti in casa."
    ],
    "fr": [
      "Dans ce lieu rempli d'histoire (ce fut la première épicerie de Geoffroy Guichard à Feurs), retrouvez la cheffe Pauline qui vous suggère des plats \"fait maison\", raffinés et surprenants."
    ],
    "nl": [
      "Op een plek met een rijke geschiedenis (het was de eerste kruidenierswinkel van Geoffroy Guichard in Feurs) maak je kennis met chef-kok Pauline, die verfijnde en verrassende huisgemaakte gerechten voorstelt."
    ],
    "es": [
      "En un lugar cargado de historia (fue la primera tienda de comestibles de Geoffroy Guichard en Feurs), conozca a la chef Pauline, que le propone platos caseros refinados y sorprendentes."
    ]
  },
