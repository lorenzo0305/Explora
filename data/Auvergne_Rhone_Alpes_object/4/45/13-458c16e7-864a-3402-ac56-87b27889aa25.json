  "rdfs:comment": {
    "de": [
      "Genießen Sie die unberührte Natur im Herzen der Chaine des Puys-Faille de Limagne, die von der UNESCO zum Weltkulturerbe erklärt wurde."
    ],
    "en": [
      "Enjoy unspoilt nature in the heart of the Chaine des Puys-Faille de Limagne, a UNESCO World Heritage site."
    ],
    "it": [
      "Godetevi la campagna incontaminata nel cuore della Chaine des Puys-Faille de Limagne, patrimonio mondiale dell'UNESCO."
    ],
    "fr": [
      "Profitez d'une nature préservée au cœur de la Chaine des Puys-Faille de Limagne, inscrite au patrimoine mondiale de l'UNESCO."
    ],
    "nl": [
      "Geniet van het ongerepte platteland in het hart van de Chaine des Puys-Faille de Limagne, dat op de Werelderfgoedlijst van UNESCO staat."
    ],
