  "rdfs:comment": {
    "de": [
      "Ich bin Kunsthandwerkerin und entwerfe Kleidung, Schürzen und Accessoires aus alten weißen Bettlaken, die ich in der Umgebung sammle, neu einfärbe und mit bunten Stoffen oder Stickereien verziere."
    ],
    "en": [
      "I'm a craftsman who creates garments, aprons and accessories from old white sheets that I salvage from the local area, re-dye and embellish with chamarré fabrics or embroidery."
    ],
    "it": [
      "Sono un artigiano e realizzo abiti, grembiuli e accessori con vecchie lenzuola bianche che raccolgo sul territorio, che tingo e abbellisco con tessuti colorati o ricami."
    ],
    "fr": [
      "Je suis artisan et je crée des vêtements, tabliers et accessoires à partir de vieux draps blanc que je récupère dans les environs, que je reteins et que j'agrémente de tissus chamarrés ou de broderie."
    ],
    "es": [
      "Soy artesano y confecciono ropa, delantales y accesorios con viejas sábanas blancas que recojo en la zona, que vuelvo a teñir y adorno con telas de colores o bordados."
    ],
    "nl": [
      "Ik ben handwerkster en maak kleding, schorten en accessoires van oude witte lakens die ik in de buurt verzamel, die ik opnieuw verf en versier met kleurrijke stoffen of borduurwerk."
    ]
  },
  "rdfs:label": {
