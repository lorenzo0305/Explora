  "rdfs:comment": {
    "de": [
      "Vielseitiger Möbeltischler, der sich mit alten Materialien für die Restaurierung von Möbeln und Einlegearbeiten ebenso wohl fühlt wie mit modernen Materialien wie Medium und Aluminium für Kreationen."
    ],
    "en": [
      "A multi-talented cabinetmaker, he is equally at ease with antique materials for furniture restorations and marquetry, and with modern materials such as medium and aluminum for creations."
    ],
    "it": [
      "Ebanista polivalente, si trova a suo agio sia nell'utilizzare materiali antichi per il restauro di mobili e intarsi, sia nell'utilizzare materiali moderni come il medium e l'alluminio per lavori creativi."
    ],
    "fr": [
      "Ébéniste multiple, aussi à l'aise avec les matériaux anciens pour les restaurations de meubles et marqueteries que les matériaux d'aujourd'hui comme le médium et l'aluminium pour des créations."
    ],
    "nl": [
      "Hij is een veelzijdige meubelmaker en gebruikt net zo graag antieke materialen voor het restaureren van meubels en inlegwerk als moderne materialen zoals medium en aluminium voor creatief werk."
    ],
    "es": [
      "Ebanista polifacético, se siente tan cómodo utilizando materiales antiguos para restaurar muebles y marquetería como materiales modernos, como el medium y el aluminio, para trabajos creativos."
    ]
  },
