  "rdfs:comment": {
    "de": [
      "Die Auberge de la Source liegt inmitten einer grünen Oase an den Ausläufern des regionalen Naturparks Livradois-Forez mit atemberaubendem Blick auf die Vulkankette der Auvergne und bietet eine bistronomische Küche."
    ],
    "en": [
      "Located in a green setting in the foothills of the Livradois-Forez regional nature park, with a breathtaking view of the Auvergne volcano range, the Auberge de la Source serves bistronomic cuisine."
    ],
    "it": [
      "Situato in un ambiente verde ai piedi del Parco Naturale Regionale Livradois-Forez, con una vista mozzafiato sui vulcani dell'Alvernia, l'Auberge de la Source serve una cucina bistronomica."
    ],
    "fr": [
      "Située dans un écrin de verdure sur les contreforts du parc naturel régional du Livradois-Forez, avec vue imprenable sur la chaîne des volcans d’Auvergne, l'Auberge de la Source propose une cuisine bistronomique."
    ],
    "es": [
      "Situado en un entorno verde en las estribaciones del Parque Natural Regional de Livradois-Forez, con una vista impresionante de los volcanes de Auvernia, el Auberge de la Source sirve cocina bistronómica."
    ],
    "nl": [
      "De Auberge de la Source ligt in een groene omgeving aan de voet van het regionale natuurpark Livradois-Forez, met een adembenemend uitzicht op de vulkanen van de Auvergne, en serveert een bistronomische keuken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'auberge de la source"
    ]
  },
