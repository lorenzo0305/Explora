  "rdfs:comment": {
    "de": [
      "La Vache Folle Dingue bietet Ihnen eine frische und qualitativ hochwertige Küche. Jede Woche werden die Burger und Tartines neu interpretiert, damit Sie gerne wiederkommen."
    ],
    "en": [
      "La Vache Folle Dingue offers fresh and quality cuisine. Every week, the burgers and sandwiches are revisited for the pleasure of seeing you return."
    ],
    "it": [
      "La Vache Folle Dingue offre una cucina fresca e di qualità. Ogni settimana, gli hamburger e i panini vengono rivisitati per il piacere di vedervi tornare."
    ],
    "fr": [
      "La Vache Folle Dingue vous propose une cuisine fraîche et de qualité. Toutes les semaines, les burgers et tartines sont revisités pour le plaisir de vous voir revenir."
    ],
    "es": [
      "La Vache Folle Dingue ofrece una cocina fresca y de calidad. Todas las semanas, las hamburguesas y los sándwiches se revisan por el placer de verlos regresar."
    ],
    "nl": [
      "La Vache Folle Dingue biedt een verse kwaliteitskeuken. Elke week worden de hamburgers en broodjes opnieuw bekeken voor het plezier."
    ]
  },
