  "rdfs:comment": {
    "de": [
      "Im Herzen des Städtchens Le Crest, 10 Minuten von Clermont-Fd entfernt, empfängt Sie das Weingut La Tour de Pierre nach Vereinbarung, um Ihnen seine Cuvées aus Auvergne-Weinen in Weiß, Rosé, Rot und Schaumweinen zur Verkostung anzubieten!"
    ],
    "en": [
      "Located in the heart of the village of Crest, 10 minutes from Clermont-Fd, the Domaine de La Tour de Pierre welcomes you by appointment to let you taste its vintages of Auvergne wines in White, Rosé, Red and sparkling!"
    ],
    "it": [
      "Situato nel cuore del villaggio di Le Crest, a 10 minuti da Clermont-Fd, il Domaine de La Tour de Pierre vi accoglie su appuntamento per degustare i suoi vini bianchi, rosati, rossi e spumanti d'Alvernia!"
    ],
    "fr": [
      "Situé au cœur du bourg du Crest, à 10 minutes de Clermont-Fd, le domaine de La Tour de Pierre vous accueille sur rendez-vous pour vous faire déguster ses cuvées de vins d'Auvergne en Blanc, Rosé, Rouge et effervescents !"
    ],
    "es": [
      "Situado en el corazón del pueblo de Le Crest, a 10 minutos de Clermont-Fd, el Domaine de La Tour de Pierre le da la bienvenida con cita previa para degustar sus vinos blancos, rosados, tintos y espumosos de Auvernia"
    ],
    "nl": [
      "Gelegen in het hart van het dorp Le Crest, op 10 minuten van Clermont-Fd, verwelkomt het Domaine de La Tour de Pierre u op afspraak om zijn witte, rosé, rode en mousserende Auvergne wijnen te proeven!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La tour de pierre"
    ],
