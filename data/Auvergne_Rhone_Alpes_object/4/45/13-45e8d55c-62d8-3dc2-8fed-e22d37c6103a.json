  "rdfs:comment": {
    "de": [
      "Die Vignerons de Valléon vereinen die Vielfalt der Appellationen, Terroirs und Rebsorten, um uns schmackhafte Entdeckungen zu bieten und den Wünschen und Erwartungen der Verbraucher gerecht zu werden."
    ],
    "en": [
      "The Vignerons de Valléon bring together the plurality of appellations, terroirs and grape varieties in order to offer us tasty discoveries and meet the desires and expectations of consumers."
    ],
    "it": [
      "I Vignerons de Valléon riuniscono la pluralità delle denominazioni, dei terroir e dei vitigni per offrirci gustose scoperte e soddisfare i desideri e le aspettative dei consumatori."
    ],
    "fr": [
      "Les Vignerons de Valléon mettent en commun la pluralité des appellations, des terroirs et des cépages afin de nous offrir de savoureuses découvertes et répondre aux envies et aux attentes des consommateurs."
    ],
    "es": [
      "Los Vignerons de Valléon reúnen la pluralidad de denominaciones, terruños y variedades de uva para ofrecernos sabrosos descubrimientos y satisfacer los deseos y expectativas de los consumidores."
    ],
    "nl": [
      "De Vignerons de Valléon brengen een breed scala aan appellations, terroirs en druivenrassen samen om ons smakelijke ontdekkingen te bieden en in te spelen op de wensen en verwachtingen van de consument."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Vignerons de Valléon"
    ]
  },
