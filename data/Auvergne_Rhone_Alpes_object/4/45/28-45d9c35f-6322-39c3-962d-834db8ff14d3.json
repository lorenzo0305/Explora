  "rdfs:comment": {
    "de": [
      "Die Ferme de la Belle Hourde in Carlepont bietet Kartoffeln, Äpfel und Birnen zum Verkauf an.  Geöffnet ist mittwochs und freitags von 9 bis 12 Uhr und von 14 bis 18.30 Uhr, aber auch samstags vormittags."
    ],
    "en": [
      "La Ferme de la Belle Hourde in Carlepont offers potatoes, apples and pears for sale.  Open on Wednesday and Friday from 9am to 12pm and from 2pm to 6.30pm and also on Saturday morning."
    ],
    "it": [
      "La Ferme de la Belle Hourde di Carlepont offre la vendita di patate, mele e pere.  Aperto il mercoledì e il venerdì dalle 9.00 alle 12.00 e dalle 14.00 alle 18.30, ma anche il sabato mattina."
    ],
    "fr": [
      "La Ferme de la Belle Hourde à Carlepont propose à la vente des pommes de terre, des pommes et des poires.  Ouverture le mercredi et le vendredi de 9h à 12h et de 14h à 18h30 mais aussi le samedi matin."
    ],
    "es": [
      "La Ferme de la Belle Hourde, en Carlepont, pone a la venta patatas, manzanas y peras.  Abierto los miércoles y viernes de 9 a 12 y de 14 a 18.30 horas, pero también los sábados por la mañana."
    ],
    "nl": [
      "De Ferme de la Belle Hourde in Carlepont biedt aardappelen, appels en peren te koop aan.  Geopend op woensdag en vrijdag van 9 tot 12 uur en van 14 tot 18.30 uur, maar ook op zaterdagochtend."
    ]
  },
  "rdfs:label": {
