  "rdfs:comment": {
    "de": [
      "In unserem Büro in Retournac finden Sie alle unsere Ideen für Aktivitäten, Besichtigungen, Spaziergänge und Animationen, um einen unvergesslichen Aufenthalt im Pays des Sucs zu verbringen."
    ],
    "en": [
      "At our Retournac office, you'll find all our ideas for activities, visits, walks and events to make your stay in the Pays des Sucs unforgettable."
    ],
    "it": [
      "Presso il nostro ufficio di Retournac troverete tutte le nostre idee per attività, visite, passeggiate ed eventi per rendere indimenticabile il vostro soggiorno nel Pays des Sucs."
    ],
    "fr": [
      "Au sein de notre bureau de Retournac, retrouvez toutes nos idées d'activités, de visites, de balades et d'animations pour passer un séjour inoubliable au Pays des Sucs."
    ],
    "nl": [
      "In ons kantoor in Retournac vind je al onze ideeën voor activiteiten, bezoeken, wandelingen en evenementen om je verblijf in het Pays des Sucs onvergetelijk te maken."
    ],
    "es": [
      "En nuestra oficina de Retournac, encontrará todas nuestras ideas de actividades, visitas, paseos y eventos para que su estancia en el Pays des Sucs sea inolvidable."
    ]
  },
  "rdfs:label": {
