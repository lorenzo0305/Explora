  "rdfs:comment": {
    "de": [
      "Restaurant, Pizzeria mit Holzofen, süße und herzhafte Crêperie (Buchweizenpfannkuchen nach bretonischer Art), savoyische Spezialitäten und eine große Auswahl an hausgemachten Desserts."
    ],
    "en": [
      "Restaurant, wood-fired pizzeria, sweet and savory crêperie (Breton-style buckwheat pancakes), Savoy specialties and a variety of homemade desserts."
    ],
    "it": [
      "Ristorante, pizzeria con forno a legna, crêperie dolci e salate (frittelle di grano saraceno in stile bretone), specialità savoiarde e una grande varietà di dolci fatti in casa."
    ],
    "fr": [
      "Restaurant, pizzeria au four à bois, crêperie sucré et salé ( galletes au sarrasin façon bretonne), spécialités Savoyardes et tout une variété des desserts fait maison."
    ],
    "es": [
      "Restaurante, pizzería de leña, crepería dulce y salada (tortitas de trigo sarraceno a la bretona), especialidades saboyanas y postres caseros variados."
    ],
    "nl": [
      "Restaurant, pizzeria met houtoven, zoete en hartige crêperie (Bretonse boekweitpannenkoeken), specialiteiten uit de Savoie en een ruime keuze aan huisgemaakte desserts."
    ]
  },
