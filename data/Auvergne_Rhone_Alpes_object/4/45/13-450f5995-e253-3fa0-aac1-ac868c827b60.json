  "rdfs:comment": {
    "de": [
      "Der Parc de la Biodiversité befindet sich am Fuße der Kirche Notre-Dame de la Salette. Hier gibt es Kinderspiele, Ouessant-Schafe, Lehrbienenstöcke, einen Teich und Picknicktische."
    ],
    "en": [
      "The Parc de la Biodiversité is located at the foot of the church Notre-Dame de la Salette. There are games for children, Ushant sheep, educational beehives, a pond and picnic tables."
    ],
    "it": [
      "Il Parco della Biodiversità si trova ai piedi della chiesa di Notre-Dame de la Salette. Ci sono giochi per bambini, pecore Ushant, arnie didattiche, uno stagno e tavoli da picnic."
    ],
    "fr": [
      "Le parc de la Biodiversité est situé au pied de l'église Notre-Dame de la Salette. Il y a des jeux pour enfants, des moutons d’Ouessant, des ruches pédagogiques, une mare et des tables de pique-nique."
    ],
    "nl": [
      "Het Biodiversiteitspark ligt aan de voet van de kerk Notre-Dame de la Salette. Er zijn spelletjes voor kinderen, Ushantschapen, educatieve bijenkorven, een vijver en picknicktafels."
    ],
    "es": [
      "El Parque de la Biodiversidad se encuentra al pie de la iglesia de Notre-Dame de la Salette. Hay juegos para niños, ovejas de Ushant, colmenas educativas, un estanque y mesas de picnic."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc de la Biodiversité"
    ]
  },
