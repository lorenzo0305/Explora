  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise zu den \"Brunnen & Becken\" von Dieulefit\r\nBegleitet von der Stimme der talentierten Schauspielerin Nadine Despert und der Fremdenführerin und Referentin Aline vom Office de Tourisme du Pays de Dieulefit-Bourdeaux.Mit Reservierung."
    ],
    "en": [
      "Discover Dieulefit's \"Fountains & Ponds\r\nAccompanied by the voice of talented actress Nadine Despert, and Aline, a guide from the Dieulefit-Bourdeaux Tourist Office."
    ],
    "it": [
      "Scoprire le \"fontane e le piscine\" di Dieulefit\r\nAccompagnati dalla voce della talentuosa attrice Nadine Despert e da Aline, una guida dell'Ufficio del Turismo di Dieulefit-Bourdeaux."
    ],
    "fr": [
      "Partez à la découverte des  « Fontaines & Bassins » de Dieulefit\r\nAccompagnés par la voix de la talentueuse Nadine Despert, comédienne, et d'Aline, guide-conférencière de l'Office de Tourisme du Pays de Dieulefit-Bourdeaux.Sur réservation."
    ],
    "nl": [
      "Ontdek de \"Fonteinen en zwembaden\" van Dieulefit\r\nBegeleid door de stem van de getalenteerde actrice Nadine Despert en Aline, een gids van het Office du Tourisme van Dieulefit-Bourdeaux."
    ],
    "es": [
      "Descubra las \"fuentes y estanques\" de Dieulefit\r\nAcompañado por la voz de la talentosa actriz Nadine Despert y Aline, guía de la Oficina de Turismo de Dieulefit-Bourdeaux."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée \"Fontaines et Bassins\" dans le cadre de Dieulefit dans son jardin"
    ]
  },
