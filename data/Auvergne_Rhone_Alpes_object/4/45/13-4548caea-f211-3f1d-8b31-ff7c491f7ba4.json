  "rdfs:comment": {
    "de": [
      "Brasserie am Fuße der Pisten von Megève Sektor Jaillet, das ganze Jahr über geöffnet.\r\nFamiliärer und festlicher Ort, traditionelle Restauration, lokale Produkte. Lächeln und gute Laune!"
    ],
    "en": [
      "Brasserie at the foot of the Megève pistes, near Jaillet, open all year round.\r\nLively, family-friendly venue, traditional food, local products. Smiles and a warm welcome!"
    ],
    "it": [
      "Birreria ai piedi delle piste di Megève, nel settore Jaillet, aperta tutto l'anno.\r\nUn luogo allegro e familiare, ristorazione tradizionale, prodotti locali. Sorriso e buonumore!"
    ],
    "fr": [
      "Brasserie au pied des pistes de Megève secteur Jaillet, ouverte toute l'année.\r\nLieu familial et festif, restauration traditionnelle, produits locaux. Sourire et bonne humeur !"
    ],
    "es": [
      "Brasserie al pie de las pistas de Megève, sector Jaillet, abierta todo el año.\r\nUn lugar festivo y familiar, con comida tradicional y productos locales. ¡Sonrisas y buen humor!"
    ],
    "nl": [
      "Brasserie aan de voet van de pistes van Megève, sector Jaillet, het hele jaar geopend.\r\nEen feestelijk familiepunt, met traditionele gerechten en lokale producten. Glimlach en goed humeur!"
    ]
  },
