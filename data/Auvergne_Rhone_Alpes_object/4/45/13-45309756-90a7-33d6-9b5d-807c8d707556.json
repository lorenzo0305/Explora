  "rdfs:comment": {
    "de": [
      "Betreten Sie diese ganz neue Erlebniswelt! Nase an Nase mit einem Gorilla oder Löwen! Dank der verglasten Gehege kein Problem!"
    ],
    "en": [
      "Explore a new world and experience new sensations. Get up close to gorillas and lions with our glass enclosures!"
    ],
    "it": [
      "L'Espace Zoologique, situato a metà strada tra St Etienne e Lione, si distingue per il suo particolare attaccamento ai felini e ai primati.\r\n\r\nScoprite più di 20 specie di primati ed entrate nelle serre tropicali per vedere oltre 1.000 animali."
    ],
    "fr": [
      "L'Espace Zoologique, situé à mi-chemin entre St Etienne et Lyon, se distingue par son attachement particulier aux félins et aux primates.\r\n\r\nDécouvrez plus de 20 espèces de primates et pénétrez dans les serres tropicales et observez plus de 1000 animaux."
    ],
    "nl": [
      "Het Espace Zoologique, gelegen halverwege St Etienne en Lyon, onderscheidt zich door zijn bijzondere aandacht voor katachtigen en primaten.\r\n\r\nOntdek meer dan 20 soorten primaten en ga de tropische kassen binnen om meer dan 1000 dieren te bekijken."
    ],
    "es": [
      "El Espace Zoologique, situado a medio camino entre St Etienne y Lyon, destaca por su particular apego a los felinos y primates.\r\n\r\nDescubra más de 20 especies de primates y entre en los invernaderos tropicales para ver más de 1.000 animales."
    ]
  },
