  "rdfs:comment": {
    "de": [
      "50.000 Dokumente auf zwei Ebenen. Die Mediathek verfügt über ein kleines \"Theater\", ein Atelier und ein Bürgercafé, in dem kulturelle Aktionen in Verbindung mit lokalen Vereinen entwickelt werden können."
    ],
    "en": [
      "50,000 documents on two levels. The multimedia library has a small \"theater\", a workshop and a citizen's café for developing cultural activities in conjunction with local associations."
    ],
    "it": [
      "50.000 documenti su due livelli. La biblioteca multimediale dispone di una sala per spettacoli e di un caffè cittadino per lo sviluppo di attività culturali in collaborazione con le associazioni locali."
    ],
    "fr": [
      "50 000 documents répartis sur deux niveaux. La médiathèque dispose d’une salle de spectacle et d’un café citoyen pour développer des actions culturelles en lien avec des associations locales."
    ],
    "es": [
      "50.000 documentos en dos niveles. La biblioteca multimedia cuenta con un auditorio y un café ciudadano para desarrollar actividades culturales en colaboración con las asociaciones locales."
    ],
    "nl": [
      "50.000 documenten op twee niveaus. De mediatheek heeft een klein \"theater\", een werkplaats en een burgercafé voor het ontwikkelen van culturele activiteiten in samenwerking met lokale verenigingen."
    ]
  },
  "rdfs:label": {
