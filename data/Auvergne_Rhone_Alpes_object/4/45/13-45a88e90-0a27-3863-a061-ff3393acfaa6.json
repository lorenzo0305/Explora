  "rdfs:comment": {
    "de": [
      "Robin Maxime, ein virtuoser Gitarrist mit einer tiefen Sensibilität, nimmt uns mit auf eine wunderbare Reise. Argentinien, Italien, Brasilien, Spanien, Deutschland, Paraguay... Ein besonders abwechslungsreiches Programm, das der junge Virtuose meisterhaft interpretiert."
    ],
    "en": [
      "Robin Maxime, a virtuoso guitarist with deep sensitivity, takes us on a wonderful journey. Argentina, Italy, Brazil, Spain, Germany, Paraguay... A particularly varied program, masterfully interpreted by this young virtuoso."
    ],
    "it": [
      "Robin Maxime, chitarrista virtuoso dalla profonda sensibilità, ci accompagna in un viaggio meraviglioso. Argentina, Italia, Brasile, Spagna, Germania, Paraguay... Un programma particolarmente vario, magistralmente interpretato da questo giovane virtuoso."
    ],
    "fr": [
      "Robin Maxime, guitariste virtuose doté d'une profonde sensibilité, nous entraîne dans un merveilleux voyage. Argentine, Italie, Brésil, Espagne, Allemagne, Paraguay... Programme particulièrement varié et magistralement interprété par le jeune virtuose."
    ],
    "es": [
      "Robin Maxime, guitarrista virtuoso de profunda sensibilidad, nos embarca en un viaje maravilloso. Argentina, Italia, Brasil, España, Alemania, Paraguay... Un programa particularmente variado, magistralmente interpretado por este joven virtuoso."
    ],
    "nl": [
      "Robin Maxime, een virtuoze gitarist met een diepe gevoeligheid, neemt ons mee op een prachtige reis. Argentinië, Italië, Brazilië, Spanje, Duitsland, Paraguay... Een bijzonder gevarieerd programma, meesterlijk vertolkt door deze jonge virtuoos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert - Robin Maxime - Chefs-d’œuvre classiques, espagnols et sud-américains"
    ]
  },
