  "rdfs:comment": {
    "de": [
      "Café und Brauerei – Sonntags geöffnet\r\nHausmannskost\r\nHausgemachter Nachtisch\r\nTee Raum\r\nGegenüber dem Bahnhof Valence Ville"
    ],
    "en": [
      "Café & Brasserie near the Valence central Train Station\r\nOpen everyday except Wednesday - Open on Sundays !\r\nBreakfast - Lunch - Dinner - Coffee - Cappucino - Hot chocolate - Tea etc\r\nHomemade Food - Burger - Salad - Côte de Boeuf - Fresh fish - homade dessert"
    ],
    "it": [
      "Caffetteria e birreria - Aperto domenica\r\nCucina casalinga\r\nDolce fatto in casa\r\nSala da tè\r\nDi fronte alla stazione ferroviaria di Valence Ville\r\nCostolette - Insalata - Hamburger - Pesce, ecc."
    ],
    "fr": [
      "Café & Brasserie face à la gare de Valence Ville - Salon de thé \r\nLe Siècle est ouvert tous les jours (sauf mercredi) Ouvert le dimanche !\r\nPetit déjeuner  - Cuisine maison - Café - Cappucino - Chocolat chaud - dessert maison etc"
    ],
    "nl": [
      "Café & Brasserie tegenover het station Valence Ville.\r\nThuiskeuken - Regionale producten - Lokale wijnen - Vegetarische gerechten & formules."
    ],
    "es": [
      "Café & Brasserie frente a la estación Valence Ville - Tearoom\r\nLe Siècle está abierto todos los días (excepto los miércoles) ¡Abierto los domingos!\r\nDesayuno - Comida casera - Café - Capuchino - Chocolate caliente - Postres caseros, etc"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Siècle"
    ]
  },
