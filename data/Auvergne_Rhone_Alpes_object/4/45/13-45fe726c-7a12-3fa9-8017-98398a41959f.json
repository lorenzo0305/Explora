  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von Parfümdüften leiten... und entdecken Sie die Ausstellung (neu) durch den Geruchssinn: Noten von Blättern, Moos und Mineralien.\r\nErweitern Sie Ihre Geruchspalette und tauschen Sie sich über Ihre Empfindungen und Empfindungen aus."
    ],
    "en": [
      "Let yourself be guided by the scents of perfumes... and (re)discover the exhibition by smell: notes of leaves, moss and minerals.\r\nEnrich your olfactory range and share your feelings and sensations."
    ],
    "it": [
      "Lasciatevi guidare dalle fragranze dei profumi... e (ri)scoprite la mostra con l'olfatto: note di foglie, muschio e minerali.\r\nArricchite la vostra gamma olfattiva e discutete i vostri sentimenti e le vostre sensazioni."
    ],
    "fr": [
      "Lassez-vous guider par des senteurs de parfums... et (re)découvrez l'exposition par l'odorat : notes de feuille, de mousse et de minéraux.\r\nEnrichissez votre gamme olfactive et échangez sur vos ressentis et sensations."
    ],
    "nl": [
      "Laat je leiden door de geuren van parfums... en (her)ontdek de tentoonstelling door te ruiken: noten van bladeren, mos en mineralen.\r\nVerrijk je reukzin en bespreek je gevoelens en sensaties."
    ],
    "es": [
      "Déjese guiar por los aromas de los perfumes... y (re)descubra la exposición a través del olfato: notas de hojas, musgo y minerales.\r\nEnriquece tu abanico olfativo y comenta tus sensaciones y sentimientos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite olfactive en famille"
    ]
  },
