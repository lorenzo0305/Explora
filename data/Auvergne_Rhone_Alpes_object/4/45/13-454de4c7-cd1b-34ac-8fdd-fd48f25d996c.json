  "rdfs:comment": {
    "de": [
      "BIGTOP ist ein neuer Freizeitbereich in GENAS im Departement Rhône. Ein Freizeitpark für Kinder bis zu 12 Jahren, ein Bereich für Kinder unter 3 Jahren und ein Imbiss für Essen und Erfrischungen."
    ],
    "en": [
      "BIGTOP is a new leisure area located in GENAS in the Rhône . A Leisure Park for children up to 12 years old, an area reserved for children under 3 years old and a snack bar to eat and refresh."
    ],
    "it": [
      "BIGTOP è un nuovo spazio per il tempo libero situato a GENAS, nel Rodano. Un parco divertimenti per bambini fino a 12 anni, un'area riservata ai bambini sotto i 3 anni e uno snack bar per rinfrescarsi."
    ],
    "fr": [
      "BIGTOP est un nouvel espace de loisirs situé à GENAS dans le Rhône . Un Parc de loisirs pour les enfants jusqu'à 12 ans, un espace réservé aux moins de 3 ans et un snack pour se restaurer et se rafraichir."
    ],
    "nl": [
      "BIGTOP is een nieuw recreatiegebied gelegen in GENAS in de Rhône. Een recreatiepark voor kinderen tot 12 jaar, een ruimte gereserveerd voor kinderen tot 3 jaar en een snackbar voor verfrissingen."
    ],
    "es": [
      "BIGTOP es un nuevo espacio de ocio situado en GENAS, en el Ródano. Un parque de ocio para niños de hasta 12 años, una zona reservada para niños menores de 3 años y un bar para refrescarse."
    ]
  },
