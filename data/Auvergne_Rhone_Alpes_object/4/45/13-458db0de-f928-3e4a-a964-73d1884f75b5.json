  "rdfs:comment": {
    "de": [
      "Wir sind ein unabhängiger Produzent und stellen AOP Côtes du Vivarais und IGP Ardèche aus biologischem Anbau her. Diese Weine können Sie in unserem Weinkeller entdecken, der sich im wunderschönen Ibie-Tal befindet, ganz in der Nähe der Schluchten der Ardèche."
    ],
    "en": [
      "Independent producer of 'AOP Côtes du Vivarais' and 'IGP Ardèche', with nearly all our wines certified organic. You can  discover all these wines, in our  wine cellar located in the Ibie Valley, close to the Gorges of Ardeche."
    ],
    "it": [
      "Siamo un produttore indipendente e produciamo vini biologici AOP Côtes du Vivarais e IGP Ardèche. Potete scoprire questi vini nella nostra cantina, situata nella magnifica Valle dell'Ibie, a due passi dalle Gole dell'Ardèche."
    ],
    "fr": [
      "Nous sommes producteur indépendant et produisons des AOP Côtes du Vivarais et IGP Ardèche en agriculture biologique. Ces vins sont à découvrir dans notre caveau, situé dans la magnifique Vallée de l'Ibie, à deux pas des Gorges de l'Ardèche."
    ],
    "nl": [
      "We zijn een onafhankelijke producent en maken biologische AOP Côtes du Vivarais en IGP Ardèche. Je kunt deze wijnen ontdekken in onze kelder, gelegen in de prachtige Ibie-vallei, op een steenworp afstand van de Gorges de l'Ardèche."
    ],
    "es": [
      "Somos un productor independiente y elaboramos vinos ecológicos AOP Côtes du Vivarais e IGP Ardèche. Podrá descubrir estos vinos en nuestra bodega, situada en el magnífico valle del Ibie, a dos pasos de las Gargantas del Ardèche."
    ]
  },
