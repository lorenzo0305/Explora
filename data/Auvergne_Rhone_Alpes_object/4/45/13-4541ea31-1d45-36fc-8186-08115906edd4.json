  "rdfs:comment": {
    "de": [
      "Lernende Abenteuer im Herzen der Berge. Wir laden Sie ein, einzigartige Trekking- und Mikroabenteuer zu erkunden, bei denen jeder Schritt eine Quelle der Inspiration ist. Eine unvergessliche Erfahrung, die Erkundung, Lernen und die Verbindung zur Natur miteinander verbindet."
    ],
    "en": [
      "Learning adventures in the heart of the mountains. We invite you to explore unique treks and micro-adventures, where every step is a source of inspiration. An unforgettable experience combining exploration, learning and connection to nature."
    ],
    "it": [
      "Avventure di apprendimento nel cuore delle montagne. Vi invitiamo a esplorare trekking e microavventure uniche, dove ogni passo è fonte di ispirazione. Un'esperienza indimenticabile che unisce esplorazione, apprendimento e connessione con la natura."
    ],
    "fr": [
      "Des aventures apprenantes au cœur des montagnes. Nous vous invitons à explorer des treks et micro-aventures uniques, où chaque pas est une source d'inspiration. Une expérience inoubliable alliant exploration, apprentissage et connexion à la nature."
    ],
    "nl": [
      "Leerzame avonturen in het hart van de bergen. We nodigen je uit voor unieke trektochten en micro-avonturen, waarbij elke stap een bron van inspiratie is. Een onvergetelijke ervaring die verkenning, leren en verbinding met de natuur combineert."
    ],
    "es": [
      "Aventuras de aprendizaje en el corazón de las montañas. Le invitamos a explorar caminatas y microaventuras únicas, donde cada paso es una fuente de inspiración. Una experiencia inolvidable que combina exploración, aprendizaje y conexión con la naturaleza."
    ]
  },
  "rdfs:label": {
    "de": [
