  "rdfs:comment": {
    "de": [
      "Auf der anderen Seite ist der temporäre Ausstellungsbereich des Hébert-Museums, der der Präsentation von Arbeiten zeitgenössischer regionaler oder nationaler Künstler gewidmet ist."
    ],
    "en": [
      "On the other side is the Musée Hébert's temporary exhibition space, dedicated to presenting the work of regional and national contemporary artists."
    ],
    "it": [
      "Dall'altro lato si trova lo spazio espositivo temporaneo del Musée Hébert, dedicato alla presentazione delle opere di artisti contemporanei regionali e nazionali."
    ],
    "fr": [
      "De l'autre côté est l'espace d'exposition temporaire du musée Hébert dédié à la présentation des travaux d'artistes contemporains régionaux ou nationaux."
    ],
    "zh": [
      "另一侧是赫伯特博物馆的临时展览空间，专门用于展示地区和国家当代艺术家的作品。"
    ],
    "es": [
      "Al otro lado se encuentra el espacio de exposiciones temporales del museo Hébert, dedicado a presentar la obra de artistas contemporáneos regionales y nacionales."
    ],
    "nl": [
      "Aan de andere kant bevindt zich de tijdelijke tentoonstellingsruimte van het Hébert Museum, gewijd aan de presentatie van het werk van regionale of nationale hedendaagse kunstenaars."
    ]
  },
  "rdfs:label": {
