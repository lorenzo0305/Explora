  "rdfs:comment": {
    "de": [
      "Pierre Vincent & sein Team heißen Sie in einem charmanten & charaktervollen Hotel im Herzen der Dombes willkommen. Genießen Sie die raffiniert servierte Gourmetküche des Küchenchefs, die von Lyon inspiriert ist. Ein geselliger Moment auf dem Land, in der Nähe von Lyon."
    ],
    "en": [
      "Pierre Vincent and his team welcome you in a charming hotel with a great deal of character. Situated on the Dombes area with its lovely pounds. Taste the gastronomic chef's cuisine: the inspiring influence is the lyonnaise cuisine. Refinement and conviviality in the countryside, close to Lyon."
    ],
    "it": [
      "Pierre Vincent e il suo team vi danno il benvenuto in un hotel di charme e carattere nel cuore delle Dombes. Assaporate la cucina gastronomica dello chef, ispirata a Lione, servita con raffinatezza. Un momento di convivialità in campagna, vicino a Lione."
    ],
    "fr": [
      "Pierre Vincent & son équipe vous accueillent dans un hôtel de charme & de caractère au coeur de la Dombes. Savourez la cuisine gastronomique du chef, d'inspiration lyonnaise, servie avec raffinement. Un moment de convivialité à la campagne, près de Lyon."
    ],
    "es": [
      "Pierre Vincent y su equipo le dan la bienvenida a un hotel con encanto y carácter en el corazón de las Dombes. Disfrute de la cocina gastronómica del chef, inspirada en Lyon, servida con refinamiento. Un momento de convivencia en el campo, cerca de Lyon."
    ],
    "nl": [
      "Pierre Vincent & zijn team heten u welkom in een charmant hotel met karakter in het hart van de Dombes. Geniet van de gastronomische keuken van de chef, geïnspireerd door Lyon, geserveerd met verfijning. Een moment van gezelligheid op het platteland, in de buurt van Lyon."
    ]
  },
