  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9fba7834-85f5-3cfc-82d7-b00d20e5ad75",
      "dc:description": {
        "de": [
          "Dôme architecture d'intérieur ist ein Designstudio mit Sitz in Le Touquet-Paris-Plage. Es ist auf maßgeschneiderte Inneneinrichtungen spezialisiert und bietet individuelle Lösungen für alle Arten von Projekten, von begehbaren Kleiderschränken bis hin zu kompletten Aufbewahrungssystemen. Das Team von Dôme begleitet seine Kunden vom Entwurf bis zur Fertigstellung, wobei der Schwerpunkt auf der Qualität der Materialien und der Verarbeitung liegt."
        ],
        "en": [
          "Dôme architecture d?intérieur is a design studio based in Le Touquet-Paris-Plage. Specializing in made-to-measure interior design, it offers customized solutions for all types of projects, from dressers to complete storage units. The Dôme team accompanies its customers from conception to completion, focusing on the quality of materials and finish."
        ],
        "it": [
          "Dôme architecture d'intérieur è uno studio di design con sede a Le Touquet-Paris-Plage. Specializzato nella progettazione di interni su misura, offre soluzioni personalizzate per tutti i tipi di progetto, dalle cabine armadio ai contenitori completi. Il team di Dôme assiste i clienti dalla concezione alla realizzazione, concentrandosi sulla qualità dei materiali e delle finiture."
        ],
        "fr": [
          "Dôme architecture d’intérieur est un studio de design basé au Touquet-Paris-Plage. Spécialisé dans l'aménagement intérieur sur mesure, il propose des solutions personnalisées pour tous types de projets, des dressings aux rangements complets. L'équipe de Dôme accompagne ses clients de la conception à la réalisation, en mettant l'accent sur la qualité des matériaux et la finition."
        ],
        "nl": [
          "Dôme architecture d'intérieur is een ontwerpstudio gevestigd in Le Touquet-Paris-Plage. Het is gespecialiseerd in interieurontwerp op maat en biedt oplossingen op maat voor alle soorten projecten, van inloopkasten tot complete opbergmeubels. Het team van Dôme begeleidt zijn klanten van ontwerp tot oplevering, waarbij de nadruk ligt op de kwaliteit van de materialen en de afwerking."
        ],
        "es": [
          "Dôme architecture d'intérieur es un estudio de diseño con sede en Le Touquet-Paris-Plage. Especializado en el diseño de interiores a medida, ofrece soluciones personalizadas para todo tipo de proyectos, desde vestidores hasta armarios completos. El equipo de Dôme acompaña a sus clientes desde la concepción hasta la realización, prestando especial atención a la calidad de los materiales y los acabados."
        ]
      },
