  "rdfs:comment": {
    "de": [
      "Diese beiden Bergseen in der Nähe von Montsapey und Argentinien werden ihre Salmoniden für Sportangler anbieten: Sie müssen zu Fuß gehen, um sie zu erreichen."
    ],
    "en": [
      "These two mountain lakes, located near Montsapey and Argentina, will offer their salmonids for sport fishermen: you have to walk to reach them."
    ],
    "it": [
      "Questi due laghi di montagna, situati vicino a Montsapey e all'Argentina, offriranno i loro salmonidi ai pescatori sportivi: per raggiungerli bisogna camminare."
    ],
    "fr": [
      "Ces deux lacs de montagne, situés près de Montsapey et Argentine, offriront leurs salmonidés pour les pêcheurs sportifs : il faut marcher pour les atteindre."
    ],
    "es": [
      "Estos dos lagos de montaña, situados cerca de Montsapey y Argentina, ofrecerán sus salmónidos a los pescadores deportivos: hay que caminar para llegar a ellos."
    ],
    "nl": [
      "Deze twee bergmeren, gelegen nabij Montsapey en Argentina, bieden hun zalmachtigen aan voor sportvissers: je moet lopen om ze te bereiken."
    ]
  },
  "rdfs:label": {
    "fr": [
