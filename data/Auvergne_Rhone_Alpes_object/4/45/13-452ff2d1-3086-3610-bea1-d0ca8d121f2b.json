  "rdfs:comment": {
    "de": [
      "Italienisches Restaurant mit frischer Pasta, Lasagne, Risotto und Desserts. Alles ist hausgemacht, vor Ort oder zum Mitnehmen. Catering-Service und kleiner Lebensmittelladen mit italienischen Produkten."
    ],
    "en": [
      "Italian restaurant with fresh pasta, lasagna, risotto, desserts. Everything is homemade on the spot or to take away. Catering service and small grocery store with Italian products."
    ],
    "it": [
      "Ristorante italiano con pasta fresca, lasagne, risotti e dessert. Tutto fatto in casa sul posto o da portare via. Servizio di catering e piccolo negozio di alimentari con prodotti italiani."
    ],
    "fr": [
      "Restaurant italien avec pâtes fraîches, lasagnes, risotto, desserts. Tout est fait maison sur place ou à emporter. Service traiteur et petite épicerie de produits italiens."
    ],
    "es": [
      "Restaurante italiano con pasta fresca, lasaña, risotto y postres. Todo casero en el momento o para llevar. Servicio de catering y pequeña tienda de comestibles con productos italianos."
    ],
    "nl": [
      "Italiaans restaurant met verse pasta, lasagne, risotto en desserts. Allemaal zelfgemaakt ter plekke of om mee te nemen. Cateringservice en kleine kruidenierswinkel met Italiaanse producten."
    ]
  },
