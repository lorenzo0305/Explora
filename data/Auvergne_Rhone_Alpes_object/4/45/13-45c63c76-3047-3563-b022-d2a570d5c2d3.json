  "rdfs:comment": {
    "de": [
      "Frédéric Fossaert, Autor und Herausgeber, wird das Leben des Vaters der großen Reportage nachzeichnen.\r\nHervé Brusini, Journalist und Präsident des Albert Londres-Preises, wird den renommiertesten Preis des französischen Journalismus vorstellen."
    ],
    "en": [
      "Frédéric Fossaert, author and publisher, will retrace the life of the father of great reportage.\r\nHervé Brusini, journalist and President of the Prix Albert Londres, will present the most prestigious prize in French journalism."
    ],
    "it": [
      "Frédéric Fossaert, autore ed editore, ripercorrerà la vita del padre del grande reportage.\r\nHervé Brusini, giornalista e presidente del Premio Albert Londres, presenterà il premio più prestigioso del giornalismo francese."
    ],
    "fr": [
      "Frédéric Fossaert, auteur et éditeur, retracera la vie du père du grand reportage.\r\nHervé Brusini, journaliste et président du prix Albert Londres, présentera ce prix le plus prestigieux du journalisme français."
    ],
    "nl": [
      "Frédéric Fossaert, schrijver en uitgever, zal teruggaan in het leven van de vader van de grote reportage.\r\nHervé Brusini, journalist en voorzitter van de Albert Londres Prijs, zal de meest prestigieuze prijs in de Franse journalistiek uitreiken."
    ],
    "es": [
      "Frédéric Fossaert, escritor y editor, repasará la vida del padre del gran reportaje.\r\nHervé Brusini, periodista y Presidente del Premio Albert Londres, entregará el galardón más prestigioso del periodismo francés."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Albert Londres hier et aujourd'hui, sur la voie du grand reportage"
    ]
  },
