  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf eine Explosion von Kreativität, verrückten Charakteren und Geschichten vor, die nur im Augenblick existieren. Die Givrés de Valence sind bereit wie nie zuvor, zu improvisieren und einen Moment puren Vergnügens mit Ihnen zu teilen."
    ],
    "en": [
      "Get ready for an explosion of creativity, zany characters, and stories that exist only in the moment. Les Givrés de Valence are more ready than ever to improvise and share a moment of pure pleasure with you."
    ],
    "it": [
      "Preparatevi a un'esplosione di creatività, a personaggi stravaganti e a storie che esistono solo nel momento. Les Givrés de Valence sono più che mai pronti a improvvisare e a condividere con voi un momento di puro piacere."
    ],
    "fr": [
      "Préparez-vous à une explosion de créativité, de personnages loufoques, et d'histoires qui n'existent que dans l'instant présent. Les Givrés de Valence sont plus prêts que jamais à improviser et à partager un moment de pur plaisir avec vous."
    ],
    "es": [
      "Prepárese para una explosión de creatividad, personajes alocados e historias que sólo existen en el momento. Les Givrés de Valence están más preparados que nunca para improvisar y compartir contigo un momento de puro placer."
    ],
    "nl": [
      "Bereid je voor op een explosie van creativiteit, maffe personages en verhalen die alleen in het moment bestaan. Les Givrés de Valence staan meer dan ooit klaar om te improviseren en een moment van puur plezier met je te delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Match d'impro avec les Givrés"
    ]
  },
