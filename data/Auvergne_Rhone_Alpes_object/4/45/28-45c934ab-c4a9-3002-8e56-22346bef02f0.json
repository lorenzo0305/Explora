  "rdfs:comment": {
    "de": [
      "Aufführungen (maßgeschneidert oder schlüsselfertig) - Animationen - Barockes Ballett - Fotoshooting in unseren Haute-Couture-Kostümen mit den Themen: historisch, märchenhaft und Cosplay.\n\nWorkshops zur französischen Lebenskunst (in Haute-Couture-Kostümen) - Heiratsanträge - Junggesellenabschiede - Souvenirs Made in France der Spitzenklasse (Accessoires und Prêt-à-porter-Mode zu bestimmten Themen aus unseren Universen)."
    ],
    "en": [
      "Shows (made-to-measure or turnkey) - Animations - Baroque ballets - Photo shoots in our Haute Couture themed costumes: historical, fairy-tale and cosplay.\n\nFrench art of living workshops (in Haute Couture costumes) - Wedding proposal - EVJF - High-end Made in France souvenirs (themed accessories and ready-to-wear from our universes)."
    ],
    "it": [
      "Spettacoli (su misura o chiavi in mano) - Animazione - Balletti barocchi - Servizi fotografici con i nostri costumi a tema Haute Couture: storici, fiabeschi e cosplay.\n\nLaboratori di arte di vivere francese (in costumi Haute Couture) - Proposta di matrimonio - EVJF - Souvenir Made in France di alta gamma (accessori a tema e prêt-à-porter dei nostri universi)."
    ],
    "fr": [
      "Spectacles (sur mesure ou clés en main) - Animations - Ballets baroques - Séance de photos dans nos costumes Haute Couture à thèmes : historique, féerique et cosplay.\n\nAteliers d'art de vivre à la française ( en costumes Haute Couture) - Demande en mariage - EVJF - Souvenirs Made in France haut de gamme (accessoires et prêt à porter à thème issus de nos univers)."
    ],
    "nl": [
      "Shows (op maat of kant-en-klaar) - Entertainment - Barokballetten - Fotoshoots in onze Haute Couture themakostuums: historisch, sprookjesachtig en cosplay.\n\nWorkshops Franse levenskunst (in Haute Couture kostuums) - Huwelijksaanzoek - EVJF - Made in France souvenirs van topkwaliteit (themaaccessoires en confectiekleding uit onze universums)."
    ],
    "es": [
      "Espectáculos (a medida o llave en mano) - Animación - Ballets barrocos - Sesiones fotográficas con nuestros trajes temáticos de Alta Costura: históricos, de cuento y cosplay.\n\nTalleres de arte de vivir a la francesa (con trajes de Alta Costura) - Propuesta de boda - EVJF - Recuerdos Made in France de alta gama (accesorios temáticos y prêt-à-porter de nuestros universos)."
    ]
  },
