  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet eine Speisekarte mit Vorspeisen, Hauptgerichten, Desserts und Käse. die je nach Jahreszeit und aktuellen Produkten wechselt. Französische Küche, die aus frischen Produkten zusammengestellt wird. Dazu gibt es eine Auswahl an Weinen von kleinen Produzenten."
    ],
    "en": [
      "The restaurant offers a menu with starters, main courses, desserts and cheeses. which changes according to the seasons and the products of the moment. French cuisine made from fresh products. To accompany, a selection of wines from small producers."
    ],
    "it": [
      "Il ristorante offre un menu con antipasti, piatti principali, dessert e formaggi, che cambia in base alle stagioni e ai prodotti del momento. Cucina francese a base di prodotti freschi. Per accompagnare il pasto, una selezione di vini di piccoli produttori."
    ],
    "fr": [
      "Le restaurant propose une carte avec entrées, plats, desserts et fromages. qui change selon les saisons et les produits du moment. Cuisine française composée à partir de produits frais. Pour accompagner, une sélection de vins de petits producteurs."
    ],
    "nl": [
      "Het restaurant biedt een menu met voorgerechten, hoofdgerechten, desserts en kazen, dat verandert naargelang de seizoenen en de producten van het moment. Franse keuken op basis van verse producten. Bij de maaltijd een selectie wijnen van kleine producenten."
    ],
    "es": [
      "El restaurante ofrece una carta con entrantes, platos principales, postres y quesos, que cambia según las estaciones y los productos del momento. Cocina francesa elaborada con productos frescos. Para acompañar la comida, una selección de vinos de pequeños productores."
    ]
  },
