  "rdfs:comment": {
    "de": [
      "Tout Doux lässt sich von unseren To-Do-Listen und dem Rhythmus, den sie erzeugen, inspirieren, um Bewegung und Spiel zu schaffen.\r\nSiehe weitere Informationen auf der Website des Rathauses von Livron"
    ],
    "en": [
      "Tout Doux draws inspiration from our to-do lists and the rhythm they generate to create movement and playfulness.\r\nSee more information on the Livron Town Hall website."
    ],
    "it": [
      "Tout Doux si ispira alle nostre liste di cose da fare e al ritmo che esse generano per creare movimento e gioco.\r\nMaggiori informazioni sul sito del Comune di Livron"
    ],
    "fr": [
      "Tout Doux s’inspire de nos to-do lists et du rythme qu’elles génèrent pour créer du mouvement et du jeu.\r\nVoir plus d'informations sur le site de la mairie de Livron"
    ],
    "es": [
      "Tout Doux se inspira en nuestras listas de tareas y en el ritmo que generan para crear movimiento y juego.\r\nMás información en la web del ayuntamiento de Livron"
    ],
    "nl": [
      "Tout Doux is geïnspireerd op onze to-do lijstjes en het ritme dat ze genereren om beweging en spel te creëren.\r\nBekijk meer informatie op de website van het gemeentehuis van Livron"
    ]
  },
