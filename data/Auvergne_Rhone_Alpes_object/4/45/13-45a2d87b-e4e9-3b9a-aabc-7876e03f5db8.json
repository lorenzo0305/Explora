  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Herzen der Monts du Lyonnais einen geselligen, entspannenden und modernen Ort, der in der Umgebung einzigartig ist. Das Team bietet Ihnen einen Weinkeller, eine Weinbar und einen Imbiss, um Ihre Abende mit Freunden oder der Familie zu genießen."
    ],
    "en": [
      "In the heart of the Monts du Lyonnais, come and discover a friendly, relaxing, modern and unique place in the area. Gathering a cellar, a wine bar, resto-tapas, the team offers you another way to enjoy your evenings with friends or family."
    ],
    "it": [
      "Nel cuore dei Monts du Lyonnais, venite a scoprire un luogo accogliente, rilassante, moderno e unico nella zona. Combinando una cantina, un'enoteca e un ristorante, il team vi offre un altro modo per godervi le vostre serate con gli amici o la famiglia."
    ],
    "fr": [
      "Au cœur des Monts du Lyonnais, venez découvrir un lieu convivial, de détente, moderne et unique aux alentours. Réunissant une cave, un bar à vin, resto-tapas, l’équipe vous propose une autre manière de profiter de vos soirées entre amis ou en famille."
    ],
    "nl": [
      "Kom in het hart van de Monts du Lyonnais een gezellige, ontspannende, moderne en unieke plek in de omgeving ontdekken. Het team combineert een kelder, een wijnbar en een restaurant en biedt u een andere manier om van uw avonden met vrienden of familie te genieten."
    ],
    "es": [
      "En el corazón de los Monts du Lyonnais, venga a descubrir un lugar acogedor, relajante, moderno y único en la zona. Combinando una bodega, un bar de vinos y un restaurante, el equipo le ofrece otra forma de disfrutar de sus veladas con los amigos o la familia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Vin et un Plat"
    ]
  },
