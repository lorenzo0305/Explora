  "rdfs:comment": {
    "de": [
      "Das Howard House ist ein neues Restaurant auf dem Flughafen Lyon-Bron, das dem berühmten Flieger Howard Hughes Tribut zollt. Das Lokal ist von einer Fluggastbrücke inspiriert und hat ein minimalistisches Design."
    ],
    "en": [
      "Howard House is a new restaurant at Lyon-Bron airport, paying tribute to the famous aviator Howard Hughes. Inspired by a boarding bridge, the minimalist design features raw concrete, glass and industrial colors"
    ],
    "it": [
      "Howard House è un nuovo ristorante dell'aeroporto di Lione-Bron che rende omaggio al famoso aviatore Howard Hughes. Il ristorante, ispirato a un ponte d'imbarco, ha un design minimalista."
    ],
    "fr": [
      "Howard House est un nouveau restaurant sur l’aéroport de Lyon-Bron, rendant hommage au célèbre aviateur Howard Hughes. Le lieu, inspiré d’une passerelle d’embarquement, adopte un design minimaliste."
    ],
    "nl": [
      "Howard House is een nieuw restaurant op de luchthaven Lyon-Bron, een eerbetoon aan de beroemde vliegenier Howard Hughes. Het restaurant, geïnspireerd op een instapbrug, heeft een minimalistisch ontwerp."
    ],
    "es": [
      "Howard House es un nuevo restaurante del aeropuerto de Lyon-Bron que rinde homenaje al famoso aviador Howard Hughes. El restaurante, inspirado en un puente de embarque, tiene un diseño minimalista."
    ]
  },
