  "rdfs:comment": {
    "de": [
      "Vom Frühstück bis zur Zwischenmahlzeit, zum Dessert oder Cocktail, Brioche Pasquier begleitet Sie bei all Ihren Gaumenfreuden. Entdecken Sie das gesamte Know-how von Brioche Pasquier in Brioche, Biscotte und Pâtisserie."
    ],
    "en": [
      "From breakfast to afternoon tea, for dessert or cocktails, Brioche Pasquier is your partner for all your gourmet desires. Come and discover Brioche Pasquier's expertise in Brioche, Biscotte and Patisserie."
    ],
    "it": [
      "Dalla colazione al tè pomeridiano, per un dessert o un cocktail, Brioche Pasquier vi accompagna in tutti i vostri desideri golosi. Venite a scoprire tutto il know-how di Brioche Pasquier in materia di Brioche, Biscotte e Pasticceria."
    ],
    "fr": [
      "Du petit déjeuner au goûter, pour un dessert ou un cocktail, Brioche Pasquier vous accompagne dans toutes vos envies gourmandes. Venez découvrir tout le savoir-faire Brioche Pasquier en Brioche, Biscotte et Pâtisserie."
    ],
    "nl": [
      "Van ontbijt tot afternoon tea, voor een dessert of een cocktail, Brioche Pasquier helpt je met al je gastronomische wensen. Kom en ontdek alle knowhow van Brioche Pasquier op het gebied van Brioche, Biscotte en Patisserie."
    ],
    "es": [
      "Desde el desayuno hasta el té de la tarde, para un postre o un cóctel, Brioche Pasquier le acompaña en todos sus deseos golosos. Venga a descubrir todo el saber hacer de Brioche Pasquier en Brioche, Biscotte y Pastelería."
    ]
  },
