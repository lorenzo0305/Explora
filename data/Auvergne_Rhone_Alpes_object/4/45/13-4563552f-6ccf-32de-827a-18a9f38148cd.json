      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/06c7617f-78b5-323f-9269-a15d4e6274e9",
          "schema:validFrom": "2026-12-28T00:00:00",
          "schema:validThrough": "2026-08-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Mittags von Mittwoch bis Sonntag + Samstagabend geöffnet.\r\nMontags und dienstags außer an Feiertagen geschlossen (Oster- und Pfingstmontag geöffnet), aber Dienstag und Mittwoch in diesen Wochen geschlossen.\r\nÖffnung an anderen Abenden für Gruppen von mindestens 30 Pers. möglich."
            ],
            "en": [
              "Open for lunch Wednesday to Sunday + Saturday evening.\r\nClosed Mondays and Tuesdays except public holidays (open Easter and Whitsun Mondays) but closed Tuesdays and Wednesdays of these weeks.\r\nOpen on other evenings for groups of 30 pers. minimum."
            ],
            "it": [
              "Aperto a pranzo da mercoledì a domenica + sabato sera.\r\nChiuso il lunedì e il martedì tranne i giorni festivi (aperto il lunedì di Pasqua e di Pentecoste), ma chiuso il martedì e il mercoledì di queste settimane.\r\nAperto le altre sere per gruppi di almeno 30 persone."
            ],
            "fr": [
              "Ouvert le midi du mercredi au dimanche + samedi soir. \r\nFermé les lundis et mardis sauf jours fériés (ouvert lundi de Pâques et de Pentecôte) mais fermé mardi et mercredi de ces semaines. \r\nOuverture possible les autres soirs pour des groupes de 30 pers. minimum."
            ],
            "nl": [
              "Open voor lunch van woensdag tot zondag + zaterdagavond.\r\nGesloten op maandag en dinsdag behalve op feestdagen (open op paas- en pinkstermaandag) maar gesloten op dinsdag en woensdag van deze weken.\r\nOpen op andere avonden voor groepen van minimaal 30 personen."
            ],
            "es": [
              "Abierto para el almuerzo de miércoles a domingo + sábado por la noche.\r\nCerrado los lunes y martes excepto los días festivos (abierto los lunes de Pascua y Pentecostés), pero cerrado los martes y miércoles de estas semanas.\r\nAbierto las demás noches para grupos de 30 personas como mínimo."
            ]
          },
