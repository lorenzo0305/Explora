  "rdfs:comment": {
    "de": [
      "\"Traditionelle Küche\r\nSpezialitäten: \r\n- Morcheln in Rahmsauce\r\n- Heidelbeertörtchen\r\nIm Winter Dienstags und Mittwochs geschlossen (außer in den Schulferien)\""
    ],
    "en": [
      "A former stone farmhouse, this family-run inn serves authentic, home-made local cuisine, including mountain charcuterie, creamy morels, frogs' legs and the famous blueberry tart!"
    ],
    "it": [
      "Antica casa colonica in pietra, questa locanda a conduzione familiare offre un'autentica cucina locale fatta in casa, tra cui salumi di montagna, spugnole cremose e la famosa crostata di mirtilli!"
    ],
    "fr": [
      "Ancienne ferme en pierre, cette auberge familiale vous propose une cuisine authentique et de terroir, de fabrication maison, avec entre autre charcuterie de montagne, morilles à la crème et la fameuse tarte aux myrtilles !"
    ],
    "nl": [
      "Deze door een familie gerunde herberg is een voormalige stenen boerderij en serveert authentieke, zelfgemaakte lokale gerechten, waaronder bergcharcuterie, romige morilles en de beroemde bosbessentaart!"
    ],
    "es": [
      "Antigua granja de piedra, esta posada familiar ofrece auténtica cocina local casera, que incluye embutidos de montaña, morillas cremosas y la famosa tarta de arándanos"
    ]
  },
