  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, frische Luft zu schnappen? Verbannen Sie sich in diesem freundlichen Hotel in die Berge und genießen Sie die belebende Umgebung und die Berglandschaft Savoyens in vollen Zügen."
    ],
    "en": [
      "You need fresh air? Come to the moutain in our welcoming hotel and enjoy the invigorating environment and the moutains of Savoy."
    ],
    "it": [
      "Cercate una boccata d'aria fresca? Esiliatevi in montagna in questo accogliente hotel e approfittate dell'ambiente rinvigorente e dei paesaggi montani della Savoia."
    ],
    "fr": [
      "Envie de prendre un bon bol d'air pur ? Exilez vous en montagne au sein de cet hôtel convivial pour profiter pleinement de l'environnement revigorant et des paysages montagneux de la Savoie."
    ],
    "es": [
      "¿Busca un soplo de aire fresco? Exíliese a la montaña en este acogedor hotel y aproveche al máximo el ambiente tonificante y los paisajes montañosos de Saboya."
    ],
    "nl": [
      "Behoefte aan een hap frisse lucht? Trek erop uit naar dit gezellige berghotel, geniet met volle teugen van de omgeving en de Savoyaanse berglandschappen en kom opnieuw op kracht."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hotel \"Le Grand Truc\""
    ],
    "fr": [
      "Le Grand Truc"
    ],
    "nl": [
      "Hotel \"Le Grand Truc\""
    ]
  },
