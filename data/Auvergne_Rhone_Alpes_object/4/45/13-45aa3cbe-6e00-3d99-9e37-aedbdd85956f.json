  "rdfs:comment": {
    "de": [
      "Der im Cantal geborene Anthony, ein Bergbegleiter, möchte mit Ihnen die Reichtümer des \"Landes\" teilen, wie die wilde Bergfauna, die Geschichte des Cantal-Vulkans, das menschliche Erbe, die Landwirtschaft von gestern und heute..."
    ],
    "en": [
      "A native of the Cantal, Anthony, a mountain guide, would like to share with you the riches of the \"pays\", such as mountain wildlife, the history of the Cantalien volcano, human heritage, agriculture past and present..."
    ],
    "it": [
      "Originario del Cantal, Anthony, guida alpina, desidera condividere con voi le ricchezze del \"paese\", come la fauna selvatica della montagna, la storia del vulcano Cantalien, il patrimonio umano, l'agricoltura di ieri e di oggi..."
    ],
    "fr": [
      "Natif du Cantal, Anthony, accompagnateur en montagne souhaite partager avec vous les richesses  du « pays » comme la faune sauvage de montagne, l'histoire du volcan cantalien, le patrimoine humain, l'agriculture d'hier et d'aujourd'hui..."
    ],
    "es": [
      "Oriundo del Cantal, Anthony, guía de montaña, desea compartir con usted las riquezas del \"país\", como la fauna salvaje de la montaña, la historia del volcán cantaliense, el patrimonio humano, la agricultura de ayer y de hoy..."
    ],
    "nl": [
      "Anthony, berggids en inwoner van de Cantal, wil je graag laten kennismaken met de rijkdommen van het \"land\", zoals de wilde fauna van de bergen, de geschiedenis van de vulkaan in de Cantal, het menselijk erfgoed, de landbouw van vroeger en nu..."
    ]
  },
