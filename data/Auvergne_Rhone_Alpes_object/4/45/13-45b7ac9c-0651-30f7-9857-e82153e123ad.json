  "rdfs:comment": {
    "de": [
      "Das Office de Tourisme Intercommunal befindet sich im Herzen des Ortes, in der Nähe der Thermen, des Theaters, des Kasinos und der Parks und steht Ihnen für alle Auskünfte und Informationen zur Verfügung."
    ],
    "en": [
      "Located in the heart of the resort, near the thermal baths, theater, casino and parks, the Intercommunal Tourist Office is at your disposal for all information."
    ],
    "it": [
      "Situato nel cuore della località, vicino alle terme, al teatro, al casinò e ai parchi, l'Ufficio Turistico Intercomunale è a vostra disposizione per qualsiasi informazione."
    ],
    "fr": [
      "Installé au cœur de la station, près des thermes, du théâtre, du casino et des parcs, l’Office de Tourisme Intercommunal est à votre écoute pour tous renseignements et informations."
    ],
    "es": [
      "Situada en el corazón de la estación, cerca de los baños termales, el teatro, el casino y los parques, la Oficina de Turismo Intercomunal está a su disposición para cualquier información que necesite."
    ],
    "nl": [
      "Het Intercommunaal Bureau voor Toerisme ligt in het hart van het resort, vlakbij de thermale baden, het theater, het casino en de parken, en staat tot je beschikking voor alle informatie die je nodig hebt."
    ]
  },
