  "rdfs:comment": {
    "de": [
      "Das Ensemble bietet einen Musical-Workshop zum Thema Kabarett an.\r\nAuf dem Programm stehen Gesang, Tanz und Theater sowie verschiedene Workshops.\r\nDie Nachmittage sind anderen Workshops wie Improvisation, Zumba, Street Dance gewidmet."
    ],
    "en": [
      "The company is offering a musical comedy workshop on the theme of cabaret.\r\nThe program includes singing, dance, theater and various workshops.\r\nAfternoons will be devoted to other workshops such as improvisation, zumba and street dance."
    ],
    "it": [
      "La compagnia offre un corso di commedia musicale sul tema del cabaret.\r\nIl programma prevede canto, danza, teatro e vari laboratori.\r\nI pomeriggi saranno dedicati ad altri laboratori come improvvisazione, zumba e street dance."
    ],
    "fr": [
      "La compagnie propose  un stage de comédie musicale sur le thème du cabaret. \r\nAu programme chant, danse et théâtre et divers ateliers. \r\nLes après-midi seront dédiés à d'autres ateliers comme de l'improvisation, zumba, Street Dance.."
    ],
    "es": [
      "La empresa ofrece un curso de comedia musical sobre el tema del cabaret.\r\nEl programa incluye canto, danza, teatro y diversos talleres.\r\nLas tardes se dedicarán a otros talleres como improvisación, zumba y street dance."
    ],
    "nl": [
      "Het bedrijf biedt een cursus muzikale komedie met als thema cabaret.\r\nOp het programma staan zang, dans, theater en verschillende workshops.\r\nDe middagen staan in het teken van andere workshops zoals improvisatie, zumba en streetdance."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage comédie musicale pour enfants"
