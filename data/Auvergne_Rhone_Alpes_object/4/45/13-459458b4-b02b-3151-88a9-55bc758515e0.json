  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Beruf des Verlegers und die Herstellung von Büchern, Demonstrationen des Drucks auf Buchdruckpressen und der Weiterverarbeitung. Buchhandlung vor Ort."
    ],
    "en": [
      "Discover the publishing profession and how books are made, with demonstrations of letterpress printing and finishing. Bookshop on site."
    ],
    "it": [
      "Scoprite il mestiere dell'editore e come nascono i libri, con dimostrazioni di stampa su macchine tipografiche e di finitura dei libri. Libreria in loco."
    ],
    "fr": [
      "Découverte du métier d'éditeur et de la fabrication des livres, démonstrations d'impression sur presses typographiques et de façonnage. Librairie sur place."
    ],
    "nl": [
      "Kom meer te weten over het uitgeversvak en hoe boeken worden gemaakt, met demonstraties van drukken op boekdrukmachines en boekafwerking. Boekwinkel ter plaatse."
    ],
    "es": [
      "Descubra la profesión de editor y cómo se hacen los libros, con demostraciones de impresión en tipografía y acabado de libros. Librería in situ."
    ]
  },
