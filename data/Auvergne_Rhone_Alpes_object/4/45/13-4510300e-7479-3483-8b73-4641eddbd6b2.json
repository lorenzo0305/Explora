  "rdfs:comment": {
    "de": [
      "Das Unternehmen wurde im März 2021 gegründet. Nachdem sie aufgrund der Gesundheitskrise ihren Arbeitsplatz verloren hatte, begann die Kunsthandwerkerin Léa, ihren eigenen Schmuck herzustellen, ein Hobby, das sie in sozialen Netzwerken teilt."
    ],
    "en": [
      "The company was created in March 2021. Following the loss of her job due to the health crisis Léa, Artisan d'Art, began creating her own jewelry, a hobby she shares on social networks."
    ],
    "it": [
      "L'azienda è stata creata nel marzo 2021. Dopo aver perso il lavoro a causa della crisi sanitaria, Léa, Artigiana d'Arte, ha iniziato a creare i propri gioielli, un hobby che condivide sui social network."
    ],
    "fr": [
      "L’entreprise a été créée en mars 2021. Suite à la perte de son emploi à cause de la crise sanitaire Léa, Artisan d'Art,  a commencé à créer ses propres bijoux, un passe-temps qu’elle partage sur les réseaux sociaux."
    ],
    "es": [
      "La empresa se creó en marzo de 2021. Tras perder su trabajo por la crisis sanitaria, Léa, Artisan d'Art, empezó a crear sus propias joyas, afición que comparte en las redes sociales."
    ],
    "nl": [
      "Het bedrijf is opgericht in maart 2021. Nadat ze haar baan verloor door de gezondheidscrisis, begon Léa, Artisan d'Art, haar eigen sieraden te maken, een hobby die ze deelt op sociale netwerken."
    ]
  },
