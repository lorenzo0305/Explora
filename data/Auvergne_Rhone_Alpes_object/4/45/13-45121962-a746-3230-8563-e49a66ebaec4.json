  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit unserer Galerie im Intermediär Transarc in die faszinierende Welt der Mineralien ein. Entdecken Sie eine außergewöhnliche Sammlung von Edelsteinen und seltenen Mineralien."
    ],
    "en": [
      "Immerse yourself in the fascinating world of minerals with our gallery located at the Intermédiaire Transarc. Discover an exceptional collection of precious stones and rare minerals."
    ],
    "it": [
      "Immergetevi nell'affascinante mondo dei minerali con la nostra galleria situata presso l'Intermédiaire Transarc. Scoprite un'eccezionale collezione di pietre preziose e minerali rari."
    ],
    "fr": [
      "Plongez dans le monde fascinant des minéraux avec notre galerie située à l'Intermédiaire Transarc. Découvrez une collection exceptionnelle de pierres précieuses et de minéraux rares."
    ],
    "es": [
      "Sumérjase en el fascinante mundo de los minerales con nuestra galería situada en el Intermédiaire Transarc. Descubra una excepcional colección de piedras preciosas y minerales raros."
    ],
    "nl": [
      "Dompel jezelf onder in de fascinerende wereld van mineralen in onze galerij in het Intermédiaire Transarc. Ontdek een uitzonderlijke collectie edelstenen en zeldzame mineralen."
    ]
  },
  "rdfs:label": {
