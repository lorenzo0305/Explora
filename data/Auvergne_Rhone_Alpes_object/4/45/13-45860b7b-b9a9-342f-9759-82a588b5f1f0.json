  "rdfs:comment": {
    "de": [
      "Victoria, Jules und ihr Team heißen Sie in ihrem neuen Restaurant herzlich willkommen. Traditionelle und lokale Küche, Qualitätsprodukte der Saison.\r\nTapas-Karte den ganzen Tag über erhältlich, um einen Aperitif zu begleiten."
    ],
    "en": [
      "Victoria, Jules and their team welcome you to their new restaurant. traditional and local cuisine, quality and seasonal products.\r\nTapas menu available all day to accompany an aperitif."
    ],
    "it": [
      "Victoria, Jules e il loro team vi danno il benvenuto nel loro nuovo ristorante. Cucina tradizionale e locale, prodotti di qualità e di stagione.\r\nMenu di tapas disponibile tutto il giorno per accompagnare un aperitivo."
    ],
    "fr": [
      "Victoria, Jules et leur équipe vous accueillent dans leur nouveau restaurant. Cuisine traditionnelle et locale, produits de qualité et de saison.\r\nCarte de tapas disponible toute la journée pour accompagner un apéro."
    ],
    "es": [
      "Victoria, Jules y su equipo le dan la bienvenida a su nuevo restaurante. Cocina tradicional y local, productos de calidad y de temporada.\r\nMenú de tapas disponible todo el día para acompañar un aperitivo."
    ],
    "nl": [
      "Victoria, Jules en hun team heten u welkom in hun nieuwe restaurant. traditionele en lokale keuken, kwaliteit en seizoensproducten.\r\nTapas-menu de hele dag beschikbaar om een aperitief te begeleiden."
    ]
  },
