  "rdfs:comment": {
    "de": [
      "Julien Soubeyre züchtet heute fast 8.000 Stück Geflügel pro Jahr: Hühner, Perlhühner, Enten, Entenenten, Hühner und Weihnachtsgeflügel wie Truthähne, Kapaune und Poularden."
    ],
    "en": [
      "Julien Soubeyre now raises around 8,000 birds a year: chickens, guinea fowl, ducks, ducklings, hens and Christmas poultry such as turkeys, capons and poulards."
    ],
    "it": [
      "Julien Soubeyre alleva oggi quasi 8.000 volatili all'anno, tra cui polli, faraone, anatre, anatroccoli, galline e pollame natalizio come tacchini, capponi e poulard."
    ],
    "fr": [
      "Julien Soubeyre élève aujourd’hui près de 8.000 volailles par an : des poulets, des pintades, des canards, des canettes, des poules et des volailles de Noël, comme les dindes, les chapons et les poulardes."
    ],
    "nl": [
      "Julien Soubeyre kweekt nu bijna 8.000 vogels per jaar, waaronder kippen, parelhoenders, eenden, eendjes, kippen en kerstpluimvee zoals kalkoenen, kapoenen en poelies."
    ],
    "es": [
      "Julien Soubeyre cría ahora casi 8.000 aves al año, entre pollos, pintadas, patos, patitos, gallinas y aves de Navidad como pavos, capones y poulards."
    ]
  },
