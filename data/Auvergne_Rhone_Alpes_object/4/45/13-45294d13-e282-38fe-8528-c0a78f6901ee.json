  "rdfs:comment": {
    "de": [
      "Julien und Anaïs sind Bio-Gemüsebauern. Verkauf ab Hof oder auf Märkten, genießen Sie schönes, saisonales und lokales Gemüse."
    ],
    "en": [
      "Julien and Anaïs are organic market gardeners. Selling at the farm or at markets, enjoy beautiful seasonal and local vegetables."
    ],
    "it": [
      "Julien e Anaïs sono ortisti biologici. Vendono i loro prodotti in fattoria o nei mercati, in modo che possiate godere di belle verdure di stagione e locali."
    ],
    "fr": [
      "Julien et Anaïs sont maraîchers biologiques. Vente à la ferme ou sur les marchés, profitez de beaux légumes de saison et locaux."
    ],
    "es": [
      "Julien y Anaïs son horticultores ecológicos. Venden sus productos en la granja o en los mercados, para que puedas disfrutar de hermosas verduras locales de temporada."
    ],
    "nl": [
      "Julien en Anaïs zijn biologische tuinders. Ze verkopen hun producten op de boerderij of op markten, zodat je kunt genieten van mooie, seizoensgebonden, lokale groenten."
    ]
  },
  "rdfs:label": {
