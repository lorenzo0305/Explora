  "rdfs:comment": {
    "de": [
      "Der Electro Club ist ein spielerischer und pädagogischer Workshop zur Einführung in die elektronische Musik, bei dem Kinder mithilfe von einfach zu bedienenden MIDI-Controllern live einen Song erstellen können."
    ],
    "en": [
      "Club Electro is a fun and educational introduction to electronic music, enabling children to create a live track using easy-to-use MIDI controllers."
    ],
    "it": [
      "Club Electro è un'introduzione divertente ed educativa alla musica elettronica, che permette ai bambini di creare un brano dal vivo utilizzando controller MIDI di facile utilizzo."
    ],
    "fr": [
      "Le Club Electro est un atelier ludique et pédagogique d'initiation aux musiques électroniques, permettant à des enfants de créer un morceau en direct à l'aide de contrôleurs MIDI simples à utiliser."
    ],
    "nl": [
      "Club Electro is een leuke en leerzame introductie tot elektronische muziek, waarbij kinderen een live track kunnen maken met behulp van eenvoudig te gebruiken MIDI-controllers."
    ],
    "es": [
      "Club Electro es una introducción divertida y educativa a la música electrónica, que permite a los niños crear una pista en directo utilizando controladores MIDI fáciles de usar."
    ]
  },
  "rdfs:label": {
