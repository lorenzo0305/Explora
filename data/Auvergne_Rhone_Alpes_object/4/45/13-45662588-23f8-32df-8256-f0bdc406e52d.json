  "rdfs:comment": {
    "de": [
      "Eine perfekte Einsteigerroute für Kinder und Erwachsene, um die Aktivität zu entdecken. Abwechslungsreiche Route über nicht ganz senkrechten Fels mit Stegen, einer kleinen Seilbrücke, einem Balken und Seilnetzen. Der Rückweg führt über einen Pfad."
    ],
    "en": [
      "A perfect introductory route for children and adults alike. A varied route over rock that is not completely vertical, with footbridges, a small monkey bridge, beams and rope nets. The way back is via a footpath."
    ],
    "it": [
      "Un percorso per principianti perfetto per bambini e adulti. Un percorso vario su roccia non completamente verticale, con passerelle, un piccolo ponte per scimmie, travi e reti di corda. Il ritorno avviene attraverso un sentiero."
    ],
    "fr": [
      "Voie d’initiation parfaite pour découvrir l’activité pour les enfants et les adultes. Parcours varié évoluant sur un rocher pas complètement vertical avec passerelles, petit pont de singe, poutre et filets de corde. Le retour se fait par un sentier."
    ],
    "es": [
      "La ruta de iniciación perfecta para niños y adultos. Recorrido variado sobre roca no totalmente vertical, con pasarelas, un pequeño puente mono, vigas y redes de cuerda. El regreso se realiza por un sendero."
    ],
    "nl": [
      "De perfecte beginnersroute voor kinderen en volwassenen. Een gevarieerde route over rotsen die niet helemaal verticaal zijn, met loopbruggen, een kleine apenbrug, balken en touwnetten. De terugweg is via een pad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Ferrata La Pitchouno"
    ]
  },
