  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant La Vieille Ferme empfängt Sie in einem typischen Ambiente mit komfortablen Zimmern für Ihre Aufenthalte. Der Küchenchef Valentin schlägt Ihnen vor, Savoyer Spezialitäten in einem authentischen Restaurant neben dem Kamin zu probieren."
    ],
    "en": [
      "The hotel restaurant La Vieille Ferme welcomes you in a typical local ambiance with 6 very confortable bedrooms for your stay. The chef Valentin offers you Savoyard specialities in an authentic restaurant by the fireplace."
    ],
    "it": [
      "L'hotel-ristorante La Vieille Ferme vi accoglie in un ambiente tipico con 6 camere confortevoli per tutti i vostri soggiorni. Lo chef Valentin vi invita a gustare le specialità savoiarde in un autentico ristorante accanto al camino."
    ],
    "fr": [
      "L'hôtel-restaurant La Vieille Ferme vous accueille dans un cadre typique avec 6 chambres tout confort pour tous vos séjours. Son chef Valentin vous propose de déguster les spécialités savoyardes dans un restaurant authentique auprès de la cheminée."
    ],
    "nl": [
      "Het hotel-restaurant La Vieille Ferme verwelkomt je in een typische omgeving met 6 comfortabele kamers voor al je verblijven. Chef Valentin nodigt je uit om Savoyaardse specialiteiten te proeven in een authentiek restaurant bij de open haard."
    ],
    "es": [
      "El hotel-restaurante La Vieille Ferme le acoge en un marco típico con 6 habitaciones confortables para todas sus estancias. El Chef Valentin le invita a degustar especialidades saboyanas en un auténtico restaurante junto a la chimenea."
    ]
  },
