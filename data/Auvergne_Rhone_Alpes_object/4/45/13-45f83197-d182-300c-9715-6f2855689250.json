  "rdfs:comment": {
    "de": [
      "Elfie, eine staatlich geprüfte Begleiterin, setzt sich dafür ein, dass Sie die Pracht der Haute Maurienne Vanoise entdecken."
    ],
    "en": [
      "Elfie, a qualified guide, will help you discover the splendour of the Haute Maurienne Vanoise and its thousand and one wonders."
    ],
