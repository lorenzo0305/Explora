  "rdfs:comment": {
    "de": [
      "Der einzige Jachthafen der Balcons du Dauphiné befindet sich in der Freizeitanlage Vallée Bleue. Er ist mit 120 Ringen mit Wasser- und Stromzugang ausgestattet, bietet einen kostenlosen Wasserstart, einen Empfangssteg und zahlreiche Dienstleistungen."
    ],
    "en": [
      "The only marina in the Balcons du Dauphiné, it is located at the Vallée Bleue leisure centre. It has 120 moorings with access to water and electricity, free launching, a reception pontoon and a host of services."
    ],
    "it": [
      "Unico porto turistico dei Balcons du Dauphiné, si trova presso il centro ricreativo Vallée Bleue. Dispone di 120 ormeggi con accesso all'acqua e all'elettricità, varo gratuito, pontile di accoglienza e numerosi servizi."
    ],
    "fr": [
      "Unique port de plaisance des Balcons du Dauphiné, ce port est situé sur la base de loisirs Vallée Bleue. Il est équipé de 120 anneaux avec accès à l'eau et à l'électricité, propose une mise à l'eau gratuite, un ponton d'accueil et de nombreux services."
    ],
    "es": [
      "Único puerto deportivo de los Balcons du Dauphiné, está situado en el centro de ocio Vallée Bleue. Dispone de 120 amarres con acceso a agua y electricidad, botadura gratuita, un pantalán de recepción y numerosos servicios."
    ],
    "nl": [
      "Het is de enige jachthaven in de Balcons du Dauphiné en ligt bij het recreatiecentrum Vallée Bleue. Het heeft 120 ligplaatsen met toegang tot water en elektriciteit, gratis tewaterlating, een ontvangstponton en een groot aantal diensten."
    ]
  },
