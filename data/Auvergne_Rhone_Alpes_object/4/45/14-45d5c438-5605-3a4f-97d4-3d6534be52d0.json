  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9be95bb8-6dc7-3713-8cdb-06e7004d9505",
      "dc:description": {
        "de": [
          "Die Ferme du Petit Parenty bietet Milchprodukte aus eigener Milchproduktion an: Joghurt vom Bauernhof, Quark, Faisselle, Bauernhof-Eis und Sorbet. Außerdem gibt es Konfitüre und Fruchtcoulis."
        ],
        "en": [
          "La Ferme du Petit Parenty offers dairy products from its milk production: farm yoghurts, cottage cheese, faisselle, farm ice cream and sorbet. You can also find jam and fruit coulis."
        ],
        "it": [
          "La Ferme du Petit Parenty offre prodotti caseari di produzione propria: yogurt di fattoria, fromage blanc, faisselle, gelati di fattoria e sorbetti. Ci sono anche marmellate e coulis di frutta."
        ],
        "fr": [
          "La Ferme du Petit Parenty propose des produits laitiers issus de sa production de lait : Yaourts fermiers, fromage blanc, faisselle, glaces fermières et sorbet. On trouve également confiture et coulis de fruits."
        ],
        "es": [
          "La Ferme du Petit Parenty ofrece productos lácteos de producción propia: yogures de granja, fromage blanc, faisselle, helados de granja y sorbetes. También hay mermeladas y coulis de frutas."
        ],
        "nl": [
          "De Ferme du Petit Parenty biedt zuivelproducten van eigen melkproductie: boerenyoghurt, fromage blanc, faisselle, boerenijs en sorbet. Er zijn ook jam en vruchtencoulis."
        ]
      },
