  "rdfs:comment": {
    "de": [
      "In einer freundlichen Atmosphäre bietet Ihnen Saveurs du Mekong eine einfache und qualitativ hochwertige thailändische Küche, bei der frische Produkte und kurze Transportwege bevorzugt werden."
    ],
    "en": [
      "In a friendly atmosphere, Saveurs du Mekong offers simple and quality Thai cuisine, with a focus on fresh products and short circuits."
    ],
    "it": [
      "In un'atmosfera amichevole, Saveurs du Mekong offre una cucina tailandese semplice e di qualità, con particolare attenzione ai prodotti freschi e alle filiere corte."
    ],
    "fr": [
      "Dans une ambiance conviviale, Saveurs du Mekong vous propose une cuisine thaïlandaise simple et de qualité, privilégiant produits frais et circuits courts."
    ],
    "nl": [
      "In een vriendelijke sfeer biedt Saveurs du Mekong eenvoudige Thaise kwaliteitsgerechten, met de nadruk op verse producten en korte leveringsketens."
    ],
    "es": [
      "En un ambiente acogedor, Saveurs du Mekong ofrece una cocina tailandesa sencilla y de calidad, con énfasis en los productos frescos y las cadenas de suministro cortas."
    ]
  },
