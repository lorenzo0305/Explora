  "rdfs:comment": {
    "de": [
      "Sattlerei und Kunsthandwerk.\r\nGlocken, verzierte Riemen.\r\nVerkauf von lokalem Kunsthandwerk rund um Leder (Geldbeutel, Schlüsselanhänger, Rose, Gürtel, Hundehalsband)\r\nThemenworkshops auf Anfrage für alle Altersgruppen und Betriebsräte."
    ],
    "en": [
      "Saddlery and handicrafts.\r\nDecorated bells and straps.\r\nLocal leather crafts (purses, key rings, roses, earrings).\r\nTheme workshops on request."
    ],
    "it": [
      "Selleria e artigianato.\r\nCampane e cinture decorate.\r\nVendita di artigianato locale in pelle (borsellini, portachiavi, rose, cinture, collari per cani)\r\nLaboratori tematici su richiesta per il pubblico e i consigli di fabbrica."
    ],
    "fr": [
      "Bourrellerie et artisanat.\r\nCloches, courroies décorées.\r\nVente d'artisanat local autour du cuir (bourse, porte-clé, rose, ceinture, collier chien)\r\nAtelier à thème sur demande pour tout public et comité d'entreprise."
    ],
    "nl": [
      "Zadelmakerij en handwerk.\r\nVersierde bellen en riemen.\r\nVerkoop van plaatselijke lederwaren (portemonnees, sleutelhangers, rozen, riemen, hondenhalsbanden)\r\nThemaworkshops op aanvraag voor het grote publiek en ondernemingsraden."
    ],
    "es": [
      "Talabartería y artesanía.\r\nCampanas y cinturones decorados.\r\nVenta de artesanía local en cuero (monederos, llaveros, rosas, cinturones, collares para perros)\r\nTalleres temáticos a petición del público y de los comités de empresa."
    ]
  },
