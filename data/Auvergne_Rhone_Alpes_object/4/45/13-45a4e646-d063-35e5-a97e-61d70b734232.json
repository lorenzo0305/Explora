  "rdfs:comment": {
    "de": [
      "Zucht von Highland Cattle-Mutterkühen.\r\nDirektverkauf von Fleisch und Bienenprodukten ab Hof.\r\nBesichtigung der Herde und der Bienenstöcke nach Voranmeldung montags und donnerstags von 14 bis 18 Uhr im Juli und August. Spaziergang mit der Pferdekutsche."
    ],
    "en": [
      "Breeding of Highlands Cattle.\r\nDirect farm sales of meat and beekeeping products.\r\nVisits to the herd and beehives by appointment on Mondays and Thursdays from 2 pm to 6 pm in July and August. Horse-drawn carriage rides."
    ],
    "it": [
      "Allevamento di bovini delle Highlands.\r\nVendita di carne e prodotti apistici direttamente dalla fattoria.\r\nVisite alla mandria e agli alveari su prenotazione il lunedì e il giovedì dalle 14.00 alle 18.00 in luglio e agosto. Gite in carrozza trainata da cavalli."
    ],
    "fr": [
      "Élevage de vache allaitante Highlands Cattle.\r\nVente directe à la ferme de viandes et de produits apicoles.\r\nVisite du troupeau et des ruches sur réservation le lundi et jeudi de 14h à 18h en juillet-août. Promenade en calèche."
    ],
    "nl": [
      "Fokken van Highlands vee.\r\nVlees en bijenteeltproducten worden rechtstreeks van de boerderij verkocht.\r\nBezoek aan de kudde en de bijenkorven op afspraak op maandag en donderdag van 14.00 tot 18.00 uur in juli en augustus. Paardenkoetsritten."
    ],
    "es": [
      "Cría de ganado vacuno de las Tierras Altas.\r\nVenta directa en la explotación de productos cárnicos y apícolas.\r\nVisitas al rebaño y a las colmenas con cita previa los lunes y jueves de 14:00 a 18:00 en julio y agosto. Paseos en coche de caballos."
    ]
  },
