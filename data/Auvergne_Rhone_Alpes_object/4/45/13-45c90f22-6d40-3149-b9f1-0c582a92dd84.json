  "rdfs:comment": {
    "de": [
      "Fabienne und Grégory freuen sich, Sie in Bernex am Fuße der Dent d'Oche begrüßen zu dürfen. Im schattigen Garten oder vor einem gemütlichen Kaminfeuer entdecken Sie die traditionelle Küche des Wirts Grégory sowie zahlreiche Savoyer Spezialitäten!"
    ],
    "en": [
      "Fabienne and Grégory are happy to welcome you to Bernex, at the foot of the Dent d'Oche. In the shady garden or in front of a nice fire, discover the traditional cuisine of the owner, Grégory, as well as many Savoyard specialities!"
    ],
    "it": [
      "Fabienne e Grégory sono lieti di accogliervi a Bernex, ai piedi della Dent d'Oche. Nel giardino ombreggiato o davanti a un bel fuoco, scoprite la cucina tradizionale del proprietario, Grégory, e molte specialità savoiarde!"
    ],
    "fr": [
      "Fabienne et Grégory sont heureux de vous accueillir  à Bernex, au pied de la Dent d'Oche. Dans le jardin ombragé ou au coin d'un bon feu de cheminée, découvrez la cuisine traditionnelle du patron, Grégory, ainsi que de nombreuses spécialités savoyardes !"
    ],
    "es": [
      "Fabienne y Grégory se complacen en recibirle en Bernex, al pie de la Dent d'Oche. En el sombreado jardín o frente a una agradable chimenea, descubra la cocina tradicional del propietario, Grégory, ¡así como numerosas especialidades saboyanas!"
    ],
    "nl": [
      "Fabienne en Grégory heten u van harte welkom in Bernex, aan de voet van de Dent d'Oche. Ontdek in de schaduwrijke tuin of voor een knapperend haardvuur de traditionele keuken van de eigenaar, Grégory, evenals vele Savoyaardse specialiteiten!"
    ]
  },
