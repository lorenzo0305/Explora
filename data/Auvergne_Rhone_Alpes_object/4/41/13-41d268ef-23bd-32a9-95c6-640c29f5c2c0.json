  "rdfs:comment": {
    "de": [
      "Dieses kleine Restaurant liegt in der Nähe der Pferderennbahn und bietet eine traditionelle und familiäre Küche. Céline, die Wirtin, empfängt Sie mit Geselligkeit und guter Laune."
    ],
    "en": [
      "Located near the Hippodrome, this small restaurant offers a traditional and family cuisine. Céline, the owner, will welcome you in a friendly and good mood."
    ],
    "it": [
      "Situato vicino all'Ippodromo, questo piccolo ristorante offre una cucina tradizionale e familiare. Céline, la proprietaria, vi accoglierà in modo amichevole e di buon umore."
    ],
    "fr": [
      "Situé près de l'Hippodrome, ce petit restaurant propose une cuisine traditionnelle et familiale. Céline, la patronne, vous accueillera dans la convivialité et la bonne humeur."
    ],
    "es": [
      "Situado cerca del Hipódromo, este pequeño restaurante ofrece cocina tradicional y familiar. Céline, la propietaria, le dará la bienvenida de forma amistosa y de buen humor."
    ],
    "nl": [
      "Dit kleine restaurant ligt vlakbij het Hippodrome en biedt een traditionele en familiale keuken. Céline, de eigenaresse, zal u vriendelijk en goedgemutst ontvangen."
    ]
  },
