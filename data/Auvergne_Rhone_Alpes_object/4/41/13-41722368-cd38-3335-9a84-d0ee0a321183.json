  "rdfs:comment": {
    "de": [
      "Auf diesem biologisch bewirtschafteten Bauernhof liefern Lacaune-Schafe und alpine Ziegen Milch, die zu Käse, Joghurt und Eis verarbeitet wird. Direktverkauf ab Hof, auf Märkten und in Bauernläden. Im Sommer werden Besichtigungen und Verkostungen angeboten."
    ],
    "en": [
      "On this organic farm, Lacaune ewes and Alpine goats produce milk transformed into cheeses, yoghurts and ice creams. Direct sales at the farm, at markets and in producers' stores. Tours and tastings available in summer."
    ],
    "it": [
      "In questa fattoria biologica, pecore e capre alpine di Lacaune producono latte che viene trasformato in formaggi, yogurt e gelati. Vendita diretta in fattoria, nei mercati e nei negozi dei produttori. Visite e degustazioni disponibili in estate."
    ],
    "fr": [
      "Dans cette ferme en agriculture biologique, brebis Lacaune et chèvres alpines fournissent un lait transformé en fromages, yaourts et glaces. Vente directe à la ferme, sur les marchés et en magasins de producteurs. Visites et dégustations proposées en été."
    ],
    "nl": [
      "Op deze biologische boerderij produceren Lacaune-schapen en Alpengeiten melk die wordt verwerkt tot kaas, yoghurt en ijs. Directe verkoop op de boerderij, op markten en in producentenwinkels. Rondleidingen en proeverijen in de zomer."
    ],
    "es": [
      "En esta granja ecológica, las ovejas Lacaune y las cabras Alpinas producen leche que se transforma en quesos, yogures y helados. Venta directa en la granja, en mercados y en tiendas de productores. Visitas y degustaciones en verano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Bergerie du vieux moulin"
    ]
  },
