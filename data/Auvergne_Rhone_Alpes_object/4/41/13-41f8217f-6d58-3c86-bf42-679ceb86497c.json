  "rdfs:comment": {
    "de": [
      "C'est Bien D'être bietet natürliche französische Kosmetika auf Pflanzenbasis und Aloe Vera, 100% französisches und natürliches Cbd (Kosmetika, Blumen, Öle und andere ) für Männer, Frauen und Tiere sowie Lebensmittel auf der Basis von französischem Hanf an."
    ],
    "en": [
      "C'est Bien D'être offers natural French cosmetics based on plants and Aloe Vera, 100% French and natural CBD (cosmetics, flowers, oils and more) for men, women and animals, and food products based on French hemp."
    ],
    "it": [
      "C'est Bien D'être offre cosmetici naturali francesi a base di piante e Aloe Vera, CBD 100% francese e naturale (cosmetici, fiori, oli e altro) per uomini, donne e animali, e prodotti alimentari a base di canapa francese."
    ],
    "fr": [
      "C'est Bien D'être propose des cosmétiques français naturels à base de plantes et Aloe Vera, du Cbd 100% Français et naturel (Cosmétiques, Fleurs, huiles et autres ) pour hommes, femmes et animaux et des produits alimentaires à base de chanvre français."
    ],
    "es": [
      "C'est Bien D'être ofrece cosmética natural francesa elaborada con plantas y Aloe Vera, CBD 100% francés y natural (cosméticos, flores, aceites y más) para hombres, mujeres y animales, y productos alimenticios elaborados con cáñamo francés."
    ],
    "nl": [
      "C'est Bien D'être biedt natuurlijke Franse cosmetica gemaakt van planten en Aloë Vera, 100% Franse en natuurlijke CBD (cosmetica, bloemen, oliën en meer) voor mannen, vrouwen en dieren, en voedingsproducten gemaakt van Franse hennep."
    ]
  },
  "rdfs:label": {
