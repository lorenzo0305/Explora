  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit einem authentischen und gemütlichen Rahmen. Sie werden eine französische, bodenständige und raffinierte Küche genießen. Willkommen bei Raphaëlle und Cédric!"
    ],
    "en": [
      "Traditional restaurant in a warm, authentic setting. Enjoy refined, local French cuisine. Welcome to Raphaëlle and Cédric!"
    ],
    "it": [
      "Un ristorante tradizionale dall'atmosfera calda e autentica. Gustate una cucina francese raffinata e locale. Benvenuti da Raphaëlle e Cédric!"
    ],
    "fr": [
      "Restaurant traditionnel au cadre authentique et chaleureux. Vous dégusterez une cuisine française, terroir et raffinée. Bienvenue chez Raphaëlle et Cédric !"
    ],
    "es": [
      "Un restaurante tradicional con un ambiente cálido y auténtico. Disfrute de la refinada cocina francesa local. ¡Bienvenidos a Raphaëlle y Cédric!"
    ],
    "nl": [
      "Een traditioneel restaurant met een warme, authentieke sfeer. Geniet van de verfijnde, lokale Franse keuken. Welkom bij Raphaëlle en Cédric!"
    ]
