  "rdfs:comment": {
    "de": [
      "Das Co-Libris-Team lädt Sie zu einem stimmungsvollen Spieleabend mit Ludo-Miam-Formel ein: Bringen Sie etwas zum Knabbern für ein gemeinsames Essen mit!"
    ],
    "en": [
      "The Co-Libris team invites you to join us for an evening of games and fun: bring a snack for a shared meal!"
    ],
    "it": [
      "Il team di Co-Libris vi invita a partecipare a una serata di giochi, con una formula di gioco divertente: portate uno spuntino e gustate un pasto insieme!"
    ],
    "fr": [
      "L’équipe Co-Libris vous propose de venir passer une soirée jeux d’ambiance avec formule ludo-miam : apportez de quoi grignoter pour un repas partagé !"
    ],
    "nl": [
      "Het Co-Libris team nodigt je uit om langs te komen voor een gezellige spelletjesavond, met een leuke spelformule: neem een snack mee en geniet samen van een maaltijd!"
    ],
    "es": [
      "El equipo de Co-Libris le invita a participar en una divertida velada de juegos, con una fórmula de juego muy divertida: ¡traiga un tentempié y disfrutemos juntos de una comida!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée jeux d'ambiance : Le coffre disparu"
    ]
  },
