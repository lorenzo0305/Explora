  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine internationale Küche mit frischen, hausgemachten Tagesgerichten. Genießen Sie eine Auswahl an Salaten, Suppen, Fleisch, Fisch und Desserts.  \r\nMahlzeiten auf Anfrage."
    ],
    "en": [
      "We offer international cuisine, with fresh, homemade daily specials. Enjoy a variety of salads, soups, meats, fish and desserts.  \r\nMeals on request."
    ],
    "it": [
      "Offriamo una cucina internazionale, con piatti del giorno freschi e fatti in casa. Venite a gustare una varietà di insalate, zuppe, carne, pesce e dessert.  \r\nPasti su richiesta."
    ],
    "fr": [
      "Nous vous offrons une cuisine internationale, avec des plats du jour frais et faits maison. Venez profiter d’ une variété de salades, soupes, viandes, poissons et desserts.  \r\nRepas sur demande."
    ],
    "nl": [
      "We bieden een internationale keuken, met verse, huisgemaakte dagschotels. Kom en geniet van een verscheidenheid aan salades, soepen, vlees, vis en desserts.  \r\nMaaltijden op aanvraag."
    ],
    "es": [
      "Ofrecemos cocina internacional, con platos frescos y caseros del día. Venga y disfrute de una gran variedad de ensaladas, sopas, carnes, pescados y postres.  \r\nComidas por encargo."
    ]
  },
