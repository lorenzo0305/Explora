    "de": [
      "Ein Oktopus: Eine Art, die aufgrund ihrer geschmacklichen Qualitäten und der Umweltverschmutzung vom Aussterben bedroht ist."
    ],
    "en": [
      "An octopus: a species on the brink of extinction because of its taste and pollution."
    ],
    "it": [
      "Un polpo: una specie sull'orlo dell'estinzione a causa del suo sapore e dell'inquinamento."
    ],
    "fr": [
      "Un poulpe : espèce en voie d'extinction à cause de ses qualités gustatives et de la pollution."
    ],
    "es": [
      "Un pulpo: una especie al borde de la extinción por su sabor y la contaminación."
    ],
    "nl": [
