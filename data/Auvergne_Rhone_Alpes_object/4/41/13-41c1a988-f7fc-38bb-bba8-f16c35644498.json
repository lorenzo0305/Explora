  "rdfs:comment": {
    "de": [
      "Am Fuße der 3 Becs, in einem Restaurant inmitten der Natur, erwartet Sie eine Gourmetküche von einem Chefkoch, der sich seinem Beruf verschrieben hat. Er bevorzugt frische und lokale Produkte sowie das Selbstgemachte; eine Küche ohne Kompromisse."
    ],
    "en": [
      "At the foot of the 3 Becs, in a restaurant in the heart of nature, gourmet cuisine by a chef devoted to his profession, who favors fresh, local produce and homemade dishes; a cuisine without concessions."
    ],
    "it": [
      "Ai piedi delle 3 Becs, in un ristorante immerso nella natura, una cucina gourmet di uno chef dedito alla sua professione che privilegia i prodotti freschi e locali, i cibi fatti in casa; una cucina senza concessioni."
    ],
    "fr": [
      "Au pied des 3 Becs, dans un restaurant en pleine nature, une cuisine gourmande par un chef dévoué à son corps de métier qui privilégie les produits frais et locaux, le fait-maison ; une cuisine sans concession."
    ],
    "es": [
      "Al pie de los 3 Becs, en un restaurante en plena naturaleza, una cocina gastronómica a cargo de un chef dedicado a su profesión que privilegia los productos frescos y locales, la comida casera; una cocina sin concesiones."
    ],
    "nl": [
      "Aan de voet van de 3 Becs, in een restaurant midden in de natuur, een gastronomische keuken van een chef-kok die toegewijd is aan zijn vak en de voorkeur geeft aan verse, lokale producten en huisgemaakte gerechten; een keuken zonder concessies."
    ]
  },
