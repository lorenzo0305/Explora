  "rdfs:comment": {
    "de": [
      "Lassen Sie sich vom königlichen Couscous, den duftenden Tajines und nicht zuletzt von den ausgezeichneten orientalischen Patisserien verführen, die mit einem Minztee serviert werden. Diese Gerichte verkörpern die Essenz der marokkanischen Küche ..."
    ],
    "en": [
      "Let yourself be seduced by royal couscous, fragrant tajines and excellent oriental pastries accompanied by mint tea, dishes that embody the very essence of Moroccan cuisine..."
    ],
    "it": [
      "Lasciatevi sedurre dal couscous reale, dalle fragranti tajine e dagli ottimi dolci orientali accompagnati dal tè alla menta, piatti che incarnano l'essenza stessa della cucina marocchina..."
    ],
    "fr": [
      "Laissez-vous séduire par le couscous royal, les tajines parfumés sans oublier les excellentes patisseries orientales accompagnées d'un thé à la menthe, des plats qui incarnent l'essence même de la cuisine marocaine ..."
    ],
    "nl": [
      "Laat je verleiden door de koninklijke couscous, geurige tajines en uitstekende oosterse gebakjes vergezeld van muntthee, gerechten die de essentie van de Marokkaanse keuken belichamen ..."
    ],
    "es": [
      "Déjese seducir por el cuscús real, los aromáticos tajines y la excelente repostería oriental acompañada de té a la menta, platos que encarnan la esencia misma de la cocina marroquí ..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Ahmed"
    ]
  },
