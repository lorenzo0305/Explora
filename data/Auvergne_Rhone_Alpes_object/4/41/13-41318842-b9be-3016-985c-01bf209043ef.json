  "rdfs:comment": {
    "de": [
      "Kino mit zwei Sälen, das von Mittwoch bis Montag ein allgemeines Programm mit durchschnittlich fünf Filmen pro Woche anbietet. Von Unterhaltungsfilmen über Animationsfilme bis hin zu Autorenfilmen und Dokumentarfilmen ist im Delta jeder Geschmack vertreten."
    ],
    "en": [
      "A two-screen cinema offering generalist programming from Wednesday to Monday with an average of 5 films shown per week. Entertainment, Animation, Author's Cinema, Documentary, all tastes are represented at the Delta."
    ],
    "it": [
      "Cinema a 2 schermi che offre una programmazione generalista dal mercoledì al lunedì con una media di 5 film a settimana. Spettacolo, animazione, film d'autore, documentari, tutti i gusti sono rappresentati al Delta."
    ],
    "fr": [
      "Cinéma de 2 salles proposant une programmation généraliste du mercredi au lundi avec en moyenne 5 films diffusés par semaine. Du Divertissement, des films d’Animation, du Cinéma d’Auteur, du Documentaire, tous les goûts sont représentés au Delta."
    ],
    "es": [
      "Un cine de 2 salas que ofrece una programación generalista de miércoles a lunes con una media de 5 películas proyectadas por semana. Entretenimiento, animación, cine de autor, documental, todos los gustos están representados en el Delta."
    ],
    "nl": [
      "Een bioscoop met 2 zalen die van woensdag tot maandag een algemeen programma biedt met gemiddeld 5 films per week. Entertainment, Animatie, Auteurfilms, Documentaires, alle smaken zijn vertegenwoordigd bij de Delta."
    ]
  },
