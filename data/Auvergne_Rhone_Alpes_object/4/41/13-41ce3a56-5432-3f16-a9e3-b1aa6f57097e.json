  "rdfs:comment": {
    "de": [
      "Gallo ist das Werk von Serge ROCA, einem Bildhauer aus Rom, der mit industriellen Stahlteilen verschiedener Herkunft arbeitet, die der Künstler abschneidet, zerlegt, hämmert, zerreißt, zusammensetzt, verschweißt..."
    ],
    "en": [
      "Gallo is the work of Serge ROCA, a Roman sculptor who works with industrial steel parts of various origins, which he cuts, hammers, tears, assembles and welds..."
    ],
    "it": [
      "Gallo è l'opera di Serge ROCA, scultore romano che lavora con pezzi di acciaio industriale di varia provenienza che l'artista taglia, martella, strappa, assembla, salda?"
    ],
    "fr": [
      "Gallo est l’œuvre de Serge ROCA, Sculpteur romanais qui travaille à partir de pièces d’acier industrielles de diverses origines que l’artiste tronçonne, découpe, martèle, déchire, assemble, soude…"
    ],
    "nl": [
      "Gallo is het werk van Serge ROCA, een beeldhouwer uit Rome die werkt met industriële stalen stukken van verschillende oorsprong die de kunstenaar snijdt, hamert, scheurt, monteert en last..."
    ],
    "es": [
      "Gallo es obra de Serge ROCA, escultor romano que trabaja con piezas de acero industrial de diversa procedencia que el artista corta, martilla, desgarra, ensambla, suelda.."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sculpture \"Gallo\", Le Coq de Serge Roca"
    ]
  },
