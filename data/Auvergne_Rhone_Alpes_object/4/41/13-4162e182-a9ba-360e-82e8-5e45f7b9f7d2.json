  "rdfs:comment": {
    "de": [
      "Sie befindet sich im Sportbereich Claudius Duport, gegenüber den neuen Rugbyplätzen.\r\nEs gibt mehrere Bahnen, die für alle Niveaus geeignet sind.\r\nSpeziell für Skateboarding, Rollerblades, Scooter, BMX, Mountainbikes und Draisinen."
    ],
    "en": [
      "Located at the Espace Sportif Claudius Duport, opposite the new rugby pitches.\r\nThere are several tracks for all levels.\r\nSpecially designed for skateboarding, rollerblading, scootering, BMX, mountain biking and draisienne."
    ],
    "it": [
      "Situato nell'Espace Sportif Claudius Duport, di fronte ai nuovi campi da rugby.\r\nCi sono diverse piste adatte a tutti i livelli.\r\nAppositamente progettate per skateboard, rollerblade, monopattino, BMX, mountain bike e draisienne."
    ],
    "fr": [
      "Situé à l'espace sportif Claudius Duport, en face des nouveaux terrains de rugby.\r\nIl y a plusieurs pistes adaptées à tous les niveaux.\r\nSpécialement conçus pour la pratique du skate, roller, trottinette, BMX, VTT et draisienne."
    ],
    "es": [
      "Situado en el Espace Sportif Claudius Duport, frente a los nuevos campos de rugby.\r\nHay varias pistas aptas para todos los niveles.\r\nEspecialmente diseñadas para skate, patinaje, scooter, BMX, bicicleta de montaña y draisienne."
    ],
    "nl": [
      "Gelegen in het Espace Sportif Claudius Duport, tegenover de nieuwe rugbyvelden.\r\nEr zijn verschillende banen geschikt voor alle niveaus.\r\nSpeciaal ontworpen voor skateboarden, skeeleren, steppen, BMX, mountainbiken en draisienne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pumptrack"
    ]
  },
