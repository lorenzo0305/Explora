  "rdfs:comment": {
    "de": [
      "Die Mediathek Salvert wurde erst kürzlich in das Schloss Salvert in Attignat verlegt und bietet auf über 200 m2 rund 8000 Dokumente für alle Zielgruppen."
    ],
    "en": [
      "Newly installed in Attignat's Château Salvert, the 200 m2 Salvert multimedia library offers some 8,000 documents for all publics."
    ],
    "it": [
      "Recentemente installata nello Château Salvert d'Attignat, la biblioteca multimediale Salvert si estende su oltre 200 m2 e mette a disposizione del pubblico circa 8.000 documenti."
    ],
    "fr": [
      "Tout récemment installée dans le château Salvert d'Attignat, la Médiathèque Salvert, avec plus de 200 m2, propose à destination de tous les publics quelques 8000 documents."
    ],
    "es": [
      "Recién instalada en el castillo Salvert d'Attignat, la biblioteca multimedia Salvert ocupa más de 200 m2 y pone a disposición del público unos 8.000 documentos."
