  "rdfs:comment": {
    "de": [
      "Ein landwirtschaftlicher Familienbetrieb im Herzen der Baronnies Provençales: Wir begrüßen Sie zu einer Besichtigung der Mühle und einer Kostprobe unseres Öls mit der geschützten Ursprungsbezeichnung AOP Nyons aus den Olivenhainen des Betriebs, die seit dem Jahr 2000 biologisch bewirtschaftet werden."
    ],
    "en": [
      "A family-run farm at the heart of the Baronnies Provençales region. Michel and Pascale will welcome you for a tour of the mill and a tasting of their oil AOP Nyons made from the olives grown in their organically farmed olive groves since 2000."
    ],
    "it": [
      "Una fattoria a conduzione familiare nel cuore delle Baronnies Provençales: saremo lieti di accogliervi per una visita al frantoio e una degustazione del nostro olio DOP di Nyons proveniente dagli oliveti della fattoria, coltivati in modo biologico dal 2000."
    ],
    "fr": [
      "Une exploitation agricole familiale au cœur des Baronnies Provençales : Nous vous accueillerons pour une visite du moulin et une dégustation de notre huile AOP Nyons issue des oliveraies de l'exploitation cultivées en Bio depuis l'année 2000."
    ],
    "es": [
      "Una explotación familiar en el corazón de las Baronnies provenzales: Estaremos encantados de recibirle para una visita de la almazara y una degustación de nuestro aceite DOP Nyons procedente de los olivares de la explotación, cultivados de forma ecológica desde el año 2000."
    ],
    "nl": [
      "Een agrarisch familiebedrijf in het hart van Baronnies Provençales: Michel en Pascale leiden u rond langs de molen en bieden een proeverij van hun AOP Nyons olie afkomstig uit de olijfbomen die er op biologische wijze verbouwd worden sinds 2000."
    ]
  },
