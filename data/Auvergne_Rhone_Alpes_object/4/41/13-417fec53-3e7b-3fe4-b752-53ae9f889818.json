  "rdfs:comment": {
    "de": [
      "Eine schöne Allee mit Kastanienbäumen führt zu diesem Herrenhaus von Louis XIII, das von Blaise Roze, einem wohlhabenden Bürger aus Riom, erbaut wurde. Zwei imposante Löwenskulpturen bewachen den Haupthof. 5 ha großer Park mit französischem Garten, entworfen von einem Studenten von Le Nôtre."
    ],
    "en": [
      "A beautiful drive lined with horse chestnut-trees leads to this Louis XIIIth manor-house, built by Blaise Roze, a rich nobleman from Riom. Two imposing sculptured lions guard the main courtyard. Park covering 5 hectares comprising a french-style garden designed by a pupil of Le Nôtre's."
    ],
    "it": [
      "Un bellissimo viale conduce a questo maniero Luigi XIII costruito da Blaise Roze, un ricco borghese di Riom. Due imponenti leoni scolpiti sorvegliano il cortile principale. Il parco di 5 ettari comprende un giardino formale progettato da un allievo di Le Nôtre."
    ],
    "fr": [
      "Une belle allée conduit à cette gentilhommière Louis XIII bâtie par Blaise Roze, riche bourgeois de Riom. Deux imposants lions sculptés gardent la cour d’honneur. Parc de 5 ha avec jardin à la Française dessiné par un élève de Le Nôtre."
    ],
    "es": [
      "Un hermoso camino de entrada conduce a esta casa solariega Luis XIII construida por Blaise Roze, un rico burgués de Riom. Dos imponentes leones esculpidos custodian el patio principal. El parque de 5 hectáreas cuenta con un jardín formal diseñado por un alumno de Le Nôtre."
    ],
    "nl": [
      "Een prachtige oprijlaan leidt naar dit Lodewijk XIII landhuis dat werd gebouwd door Blaise Roze, een rijke bourgeois uit Riom. Twee imposante gebeeldhouwde leeuwen bewaken de binnenplaats. In het park van 5 hectare ligt een formele tuin ontworpen door een leerling van Le Nôtre."
    ]
  },
