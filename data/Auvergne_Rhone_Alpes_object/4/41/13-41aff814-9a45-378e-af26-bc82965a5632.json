  "rdfs:comment": {
    "de": [
      "Eine typische Grenobler Brasserie mitten im Stadtzentrum, ein freundlicher Empfang, eine schöne Umgebung und Angebote zu jeder Tageszeit."
    ],
    "en": [
      "A typical Grenoble brasserie in the city center, reception, surroundings and formulas at all times."
    ],
    "it": [
      "Una tipica brasserie di Grenoble nel centro della città, un'accoglienza calorosa, un ambiente e una gamma di opzioni in ogni momento."
    ],
    "fr": [
      "Une brasserie typiquement grenobloise en plein centre-ville, un accueil, un cadre et des formules à toute heure."
    ],
    "es": [
      "Una brasserie típica de Grenoble en pleno centro de la ciudad, con una cálida acogida, un marco magnífico y una selección de menús a todas horas."
    ],
    "nl": [
      "Een typische brasserie uit Grenoble in het centrum van de stad, een warm onthaal, een decor en een waaier aan mogelijkheden op elk moment."
    ]
  },
