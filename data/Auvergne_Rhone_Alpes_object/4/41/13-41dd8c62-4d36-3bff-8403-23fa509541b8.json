  "rdfs:comment": {
    "de": [
      "In Grignan in der Drôme Provençale gelegen. Unsere junge und dynamische, 2023 gegründete\r\nBrauerei bietet hochwertige handwerkliche Biere an, die mit einer gewissen Ethik hergestellt werden."
    ],
    "en": [
      "Located in Grignan, Drôme Provençale. Launched in 2023, our young and dynamic\r\nbrewery offers quality craft beers made with a certain ethic."
    ],
    "it": [
      "Situato a Grignan, nella Drôme Provençale. Avviato nel 2023, il nostro giovane e dinamico birrificio\r\ngiovane e dinamico, offre birre artigianali di qualità prodotte con una certa etica."
    ],
    "fr": [
      "Située à Grignan en Drôme Provençale. Lancée en 2023 notre jeune et dynamique\r\nbrasserie propose des bières artisanales de qualité réalisées avec une certaine éthique."
    ],
    "es": [
      "Situada en Grignan, en la Drôme provenzal. Inaugurada en 2023, nuestra joven y dinámica\r\nofrece cervezas artesanales de calidad elaboradas con una cierta ética."
    ],
    "nl": [
      "Gelegen in Grignan in de Drôme Provençale. Gelanceerd in 2023, onze jonge en dynamische\r\nbrouwerij biedt ambachtelijke kwaliteitsbieren gemaakt met een bepaalde ethiek."
    ]
  },
  "rdfs:label": {
