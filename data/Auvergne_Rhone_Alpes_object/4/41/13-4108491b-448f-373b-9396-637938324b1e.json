  "rdfs:comment": {
    "de": [
      "Das Aquacime-Zentrum wurde entworfen, um die Vorteile des Wassers zu nutzen. 1200 m2 zum Entspannen und Relaxen, aufgeteilt in drei verschiedene Bereiche; Wasser, Wellness und Fitness."
    ],
    "en": [
      "Aquacime is a complex with an indoor wellness, fitness centre and an outdoor swimming pool and spaces specifically equipped for families and disabled. In Summer, two outdoor swimming pools."
    ],
    "it": [
      "Il centro Aquacime è stato progettato per godere dei benefici dell'acqua. 1200 m2 per rilassarsi e distendersi suddivisi in tre aree distinte: acqua, benessere e fitness."
    ],
    "fr": [
      "Le centre Aquacime a été conçu pour profiter des bienfaits de l'eau. 1200 m2 pour se détendre et se relaxer répartis en trois espaces distincts ; l'eau, le bien-être et la forme."
    ],
    "es": [
      "El centro Aquacime ha sido diseñado para disfrutar de los beneficios del agua. 1200 m2 para relajarse y desconectar divididos en tres áreas distintas: agua, bienestar y fitness."
    ],
    "nl": [
      "Aquacime is een complex met een overdekt wellnesscentrum , een fitnesscentrum en een buitenzwembad en een ruimte speciaal ingericht voor gezinnen en gehandicapten . In de zomer , twee buitenzwembaden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aquacime centre: swimming pool and spa"
    ],
    "fr": [
      "Aquacîme - Mountain Spa - Piscine - Fitness"
    ],
    "nl": [
      "Aquacime center : zwembad en spa"
    ]
  },
