  "rdfs:comment": {
    "de": [
      "Crêperie in den Bergen. Service zu jeder Tageszeit.\r\nVom Mittagessen bis zum Nachmittagsimbiss, im Saal oder auf der Terrasse am Fuße der Pisten.\r\nCrêperie in Chamrousse 1750: Herstellung von Crêpes und Galettes mit frischen, hausgemachten Produkten, zertifiziert und mit Liebe gemacht."
    ],
    "en": [
      "Mountain creperie. All-day service.\r\nFrom lunch to afternoon tea, indoors or on the terrace at the foot of the slopes.\r\nCrêperie located in Chamrousse 1750: homemade crepes and galettes made with fresh ingredients and certified made with love."
    ],
    "it": [
      "Creperia di montagna. Servizio a tutte le ore.\r\nDal pranzo al tè pomeridiano, all'interno o sulla terrazza ai piedi delle piste.\r\nCrêperie situata a Chamrousse 1750: crepes e galettes fatte in casa con prodotti freschi e certificati fatti con amore."
    ],
    "fr": [
      "Crêperie de montagne. Service à toute heure.\r\nDu déjeuner au goûter, en salle ou en terrasse au pied des pistes.\r\nCrêperie située à Chamrousse 1750 : confection de crêpes et galettes avec des produits frais et fait maison, certifiées faites avec amour."
    ],
    "es": [
      "Crepería de montaña. Servicio a todas horas.\r\nDesde el almuerzo hasta la merienda, en el interior o en la terraza a pie de pistas.\r\nCrêperie situada en Chamrousse 1750: crêpes y galettes caseras elaboradas con productos frescos y certificadas hechas con amor."
    ],
    "nl": [
      "Berg crêperie. Service op alle uren.\r\nVan lunch tot afternoon tea, binnen of op het terras aan de voet van de pistes.\r\nCrêperie gelegen in Chamrousse 1750: huisgemaakte crêpes en galettes gemaakt met verse producten en gecertificeerd met liefde gemaakt."
    ]
  },
