  "rdfs:comment": {
    "de": [
      "Auf der Website des Tennisclubs von Chamonix finden Sie : \r\n- 6 traditionelle Sandplätze\r\n- 2 Plätze mit künstlichem Sand (Red Plus)\r\n- 2 Quicks\r\n- 1 Green Set\r\n- 4 Hallen ( 2 Sandplätze und 2 Quicks)\r\n- 2 Squashplätze"
    ],
    "en": [
      "You will find on the site of the Tennis Club of Chamonix : \r\n- 6 traditional clay courts\r\n- 2 artificial clay courts (Red Plus)\r\n- 2 quicks\r\n- 1 green set\r\n- 4 Covered courts (2 clay and 2 quicks)\r\n- 2 Squash courts"
    ],
    "it": [
      "Troverete sul sito del Tennis Club di Chamonix : \r\n- 6 campi tradizionali in terra battuta\r\n- 2 campi in terra battuta artificiale (Red Plus)\r\n- 2 rapidi\r\n- 1 set verde\r\n- 4 campi coperti (2 in terra battuta e 2 in cemento)\r\n- 2 Campi da squash"
    ],
    "fr": [
      "Vous trouverez sur le site du Tennis club de Chamonix :  \r\n- 6 courts en terre battue traditionnelle\r\n- 2 courts terre battue artificielle (Red Plus)\r\n- 2 quicks\r\n- 1 Green set\r\n- 4 Couverts ( 2 en terre battue et 2 quicks)\r\n- 2 Terrains de squash"
    ],
    "nl": [
      "U vindt op de site van de Tennis Club van Chamonix \r\n- 6 traditionele gravelbanen\r\n- 2 kunstgrasvelden (Red Plus)\r\n- 2 vluggertjes\r\n- 1 groene set\r\n- 4 overdekte banen (2 klei en 2 quicks)\r\n- 2 squashbanen"
    ],
    "es": [
      "Encontrará en el sitio del Club de Tenis de Chamonix : \r\n- 6 pistas tradicionales de tierra batida\r\n- 2 pistas de tierra batida artificial (Red Plus)\r\n- 2 quicks\r\n- 1 juego verde\r\n- 4 pistas cubiertas (2 de tierra batida y 2 quicks)\r\n- 2 pistas de squash"
    ]
  },
