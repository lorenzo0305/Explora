      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nVon März bis Oktober: 10:00 bis 12:30 Uhr und 13:30 bis 19:00 Uhr\nNovember bis Februar: 10.00 bis 12.30 Uhr und 13.30 bis 18.00 Uhr\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMarch to October: 10am to 12:30pm and 1:30pm to 7pm\nNovember to February: 10am to 12:30pm and 1:30pm to 6pm\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa marzo a ottobre: dalle 10 alle 12.30 e dalle 13.30 alle 19\nDa novembre a febbraio: dalle 10 alle 12.30 e dalle 13.30 alle 18\n\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDe mars à octobre : 10h à 12h30 et 13h30 à 19h\nDe novembre à février : 10h à 12h30 et 13h30 à 18h\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaart tot oktober: 10u tot 12u30 en 13u30 tot 19u\nNovember tot februari: 10u tot 12u30 en 13u30 tot 18u\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe marzo a octubre: de 10.00 a 12.30 h. y de 13.30 a 19.00 h\nDe noviembre a febrero: de 10.00 a 12.30 h. y de 13.30 a 18.00 h\n\n\n "
