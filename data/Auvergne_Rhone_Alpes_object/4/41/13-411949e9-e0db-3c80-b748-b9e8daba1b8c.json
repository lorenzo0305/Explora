  "rdfs:comment": {
    "de": [
      "Die Schule Esprit Parapente ist eine professionelle Schule des FFVL und von Jeunesse et Sports.\r\nSie bietet Ihnen die Möglichkeit, die Welt des freien Fluges mithilfe des Gleitschirms zu entdecken.\r\nTandemflüge und Ausbildungskurse. Flugmöglichkeiten für Kinder."
    ],
    "en": [
      "Esprit Parapente is a professional FFVL and Jeunesse et Sports school.\r\nWe invite you to discover the world of free flight through paragliding.\r\nTandem flights and training courses. Possibility of flights for children."
    ],
    "it": [
      "Esprit Parapente è una scuola professionale FFVL e Jeunesse et Sports.\r\nOffre la possibilità di scoprire il mondo del volo libero attraverso il parapendio.\r\nVoli in tandem e corsi di formazione. Possibilità di voli per bambini."
    ],
    "fr": [
      "L'école Esprit Parapente est une école professionnelle FFVL et Jeunesse et Sports.\r\nElle vous propose de découvrir le milieu du vol libre au travers du parapente.\r\nVol en biplace et stage de formation. Possibilité de vol pour les enfants."
    ],
    "nl": [
      "Esprit Parapente is een professionele FFVL en Jeunesse et Sports school.\r\nHet biedt je de kans om de wereld van het vrije vliegen te ontdekken door middel van paragliding.\r\nTandemvluchten en stages. Mogelijkheid tot vluchten voor kinderen."
    ],
    "es": [
      "Esprit Parapente es una escuela profesional de FFVL y Jeunesse et Sports.\r\nTe ofrece la posibilidad de descubrir el mundo del vuelo libre a través del parapente.\r\nVuelos biplaza y cursos de formación. Posibilidad de vuelos para niños."
    ]
  },
