  "rdfs:comment": {
    "de": [
      "Hier bauen wir Weine auf, vereinen sie und füllen sie ab, die die Menschen zusammenbringen und glücklich machen sollen!"
    ],
    "en": [
      "Here we raise, blend and bottle wines that aim to bring people together and make them happy!"
    ],
    "it": [
      "Qui maturiamo, assembliamo e imbottigliamo vini che mirano a riunire le persone e a renderle felici!"
    ],
    "fr": [
      "Ici nous élevons, nous assemblons et nous mettons en bouteille des vins qui ont pour but de rassembler et de rendre les gens heureux !"
    ],
    "nl": [
      "Hier rijpen, mengen en bottelen we wijnen die bedoeld zijn om mensen samen te brengen en gelukkig te maken!"
    ],
    "es": [
      "Aquí maduramos, mezclamos y embotellamos vinos cuyo objetivo es unir a la gente y hacerla feliz"
    ]
  },
