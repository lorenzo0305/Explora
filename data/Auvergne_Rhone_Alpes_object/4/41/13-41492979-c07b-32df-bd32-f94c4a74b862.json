  "rdfs:comment": {
    "de": [
      "Für eingeweihte Mountainbiker, die auf der Suche nach Nervenkitzel sind, ist dieser Rundweg wie für Sie gemacht! Auf dem Programm stehen Wege, Singletrails und Unterholz. Entdecken Sie in der App die \"Application MHIKES"
    ],
    "en": [
      "For the initiated mountain bikers in search of strong sensations, this loop is made for you! On the program: paths, singles and undergrowth. To discover in the application Application MHIKES"
    ],
    "it": [
      "Se sei un mountain biker esperto in cerca di emozioni, questo è l'anello che fa per te! In programma: sentieri, single e sottobosco. Scopritelo sull'applicazione MHIKES."
    ],
    "fr": [
      "Pour les VTTistes initiés en quête de sensations fortes, cette boucle est faite pour vous ! Au programme : chemins, singles et sous-bois. A découvrir dans l'application Application MHIKES."
    ],
    "es": [
      "Si eres un ciclista de montaña experimentado en busca de emociones fuertes, ¡éste es tu bucle! En el programa: senderos, individuales y maleza. Descúbrelo en la aplicación MHIKES."
    ],
    "nl": [
      "Als je een ervaren mountainbiker bent die op zoek is naar sensatie, dan is dit de lus voor jou! Op het programma: paden, singles en kreupelhout. Ontdek de applicatie Application MHIKES."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La forêt de Mantaille"
    ]
  },
