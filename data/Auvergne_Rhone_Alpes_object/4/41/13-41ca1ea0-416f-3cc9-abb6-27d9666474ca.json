  "rdfs:comment": {
    "de": [
      "Dieses 4-Sterne-Hotel & Spa im Herzen von Alpe d'Huez mit Südlage ist der perfekte Ort für einen gelungenen Aufenthalt, bei dem Gastfreundlichkeit, Komfort und Wohlbefinden miteinander verschmelzen."
    ],
    "en": [
      "This 4-star Hotel & Spa, located in the heart of Alpe d'Huez and facing south, is the ideal place for a successful stay, combining conviviality, comfort and well-being."
    ],
    "it": [
      "Questo Hotel & Spa 4 stelle esposto a sud, nel cuore dell'Alpe d'Huez, è il luogo perfetto per un soggiorno di successo, che unisce convivialità, comfort e benessere."
    ],
    "fr": [
      "Cet Hôtel & Spa 4 étoiles, situé au coeur de l’Alpe d’Huez et orienté plein sud est le lieu rêvé pour un séjour réussi où se mélangent convivialité, confort et bien-être."
    ],
    "es": [
      "Este Hotel & Spa de 4 estrellas, orientado al sur y situado en el corazón de Alpe d'Huez, es el lugar perfecto para una estancia satisfactoria, combinando convivencia, confort y bienestar."
    ],
    "nl": [
      "Dit 4-sterren Hotel & Spa, gelegen in het hart van Alpe d'Huez en pal op het zuiden, is de ideale plek voor een geslaagd verblijf en combineert gezelligheid, comfort en welzijn."
    ]
  },
