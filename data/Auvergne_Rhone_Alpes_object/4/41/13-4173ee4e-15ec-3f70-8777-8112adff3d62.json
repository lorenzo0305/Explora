  "rdfs:comment": {
    "de": [
      "Theateraufführung des \"lebenden Mysteriums La Danse Macabre\" um 15 Uhr, angeboten von der Association D'Animation Cantonale (ADAC) auf dem Vorplatz der Abteikirche bei freiem Eintritt"
    ],
    "en": [
      "Theatrical performance of the \"living mystery of La Danse Macabre\" at 3pm, presented by the Association D'Animation Cantonale (ADAC) in front of the abbey church, free admission"
    ],
    "it": [
      "Rappresentazione teatrale del \"mistero vivente della Danse Macabre\" alle 15.00 a cura dell'Associazione d'Animazione Cantonale (ADAC) nel piazzale della chiesa abbaziale, ingresso libero"
    ],
    "fr": [
      "Spectacle théâtral du \"mystère vivant de La Danse Macabre\" à 15 proposé par l'Association D'Animation Cantonale (ADAC) sur le parvis de l'église abbatiale en accès libre"
    ],
    "nl": [
      "Theatrale voorstelling van het \"levende mysterie van La Danse Macabre\" om 15.00 uur door de Association D'Animation Cantonale (ADAC) op het voorplein van de abdijkerk, gratis toegang"
    ],
    "es": [
      "Representación teatral del \"misterio vivo de La Danse Macabre\" a las 15:00 h, a cargo de la Association D'Animation Cantonale (ADAC) en el patio de la iglesia abacial, entrada gratuita"
    ]
  },
  "rdfs:label": {
    "fr": [
      "\"Le mystère vivant de La Danse Macabre\""
    ]
  },
