  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist ein Ort der Kultur in Ihrer Nähe und bietet Ihnen Zugang zu allen Werken der Bibliotheken des Netzwerks Idélire sowie zu einem Programm mit kulturellen Veranstaltungen: Lesungen, Schreibworkshops, Illustrationsworkshops..."
    ],
    "en": [
      "The library offers you a local cultural space and gives you access to all the works of the network's libraries as well as a program of cultural activities: readings, writing workshops, illustration workshops ..."
    ],
    "it": [
      "La biblioteca offre uno spazio culturale locale e dà accesso a tutti i libri delle biblioteche della rete Idélire, oltre a un programma di eventi culturali: letture, laboratori di scrittura, workshop di illustrazione, ecc."
    ],
    "fr": [
      "La bibliothèque vous propose un espace de culture de proximité et vous donne accès à l'ensemble des ouvrages des bibliothèque du réseau Idélire ainsi qu'à un programme d'animations culturelles : lectures, ateliers d'écriture, ateliers d'illustration..."
    ],
    "es": [
      "La biblioteca le ofrece un espacio cultural de proximidad y le da acceso a todos los libros de las bibliotecas de la red Idélire, así como a un programa de actos culturales: lecturas, talleres de escritura, talleres de ilustración, etc."
    ],
    "nl": [
      "De bibliotheek biedt je een lokale culturele ruimte en geeft je toegang tot alle boeken in de bibliotheken van het Idélire-netwerk, evenals een programma met culturele evenementen: lezingen, schrijfworkshops, illustratieworkshops, enz."
    ]
  },
