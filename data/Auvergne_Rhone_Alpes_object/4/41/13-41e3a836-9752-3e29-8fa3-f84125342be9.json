  "rdfs:comment": {
    "de": [
      "Für einen sportlicheren Start sollten Sie diese 105 km lange Variante der Grande Traversée de l'Ardèche VTT bevorzugen. Von Tournon-sur-Rhône aus erreichen Sie auf halbem Hang Saint-Félicien, die Wiege der Ardéchoise, um dann ganz oben am Lac de Devesset zu enden."
    ],
    "en": [
      "For a sportier start, opt for this 105km variant of the Grande Traversée de l'Ardèche VTT. Starting from Tournon-sur-Rhône, you'll reach Saint-Félicien, cradle of the Ardéchoise, halfway up the slope, before finishing at the Devesset lake."
    ],
    "it": [
      "Per una partenza più sportiva, optate per questa variante di 105 km della Grande Traversée de l'Ardèche VTT. Partendo da Tournon-sur-Rhône, a metà percorso si raggiunge Saint-Félicien, luogo di nascita dell'Ardéchoise, per poi terminare al lago Devesset."
    ],
    "fr": [
      "Pour un départ plus sportif, privilégiez cette variante de 105km de la Grande Traversée de l'Ardèche VTT. Au départ de Tournon-sur-Rhône vous rejoindrez à mi-pente Saint-Félicien, berceau de l'Ardéchoise pour ensuite finir tout là-haut au lac de Devesset."
    ],
    "nl": [
      "Voor een sportievere start kies je voor deze 105 km lange variant van de Grande Traversée de l'Ardèche VTT. Startend vanuit Tournon-sur-Rhône bereik je halverwege de helling Saint-Félicien, de geboorteplaats van de Ardéchoise, om daar te eindigen bij het meer van Devesset."
    ],
    "es": [
      "Para un comienzo más deportivo, opte por esta variante de 105 km de la Grande Traversée de l'Ardèche VTT. Partiendo de Tournon-sur-Rhône, a mitad de la subida llegarás a Saint-Félicien, cuna de la Ardéchoise, antes de terminar allí en el lago de Devesset."
    ]
  },
  "rdfs:label": {
    "en": [
      "Grande Traversée de l'Ardèche VTT Variante de départ Stage 1 from Tournon-sur-Rhône to Saint-Félicien"
    ],
    "fr": [
      "Grande Traversée de l'Ardèche VTT Variante de départ Etape 1 de Tournon-sur-Rhône à Saint-Félicien"
    ]
  },
