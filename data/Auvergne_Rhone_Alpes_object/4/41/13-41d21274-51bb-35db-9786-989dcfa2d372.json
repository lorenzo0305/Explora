  "rdfs:comment": {
    "de": [
      "Biathlon im Sommer ist möglich! Tauschen Sie die Skier gegen ein Paar Turnschuhe. Es ist nicht so einfach, genau zu zielen, nachdem man um den ersten Platz gerannt ist. Ab 7 Jahren."
    ],
    "en": [
      "Discover biathlon in summer! Swap your skis for a pair of sneakers. It's not so easy to aim after running to be first. Ages 7 and up."
    ],
    "it": [
      "Scoprite il biathlon in estate! Sostituite gli sci con un paio di scarpe da ginnastica. Non è così facile puntare subito dopo la corsa al primo posto. A partire dai 7 anni."
    ],
    "fr": [
      "Découvrir le biathlon l’été, c’est possible ! Troquez les skis contre une paire de baskets. Pas si facile de viser juste après avoir couru pour être le premier. Dès 7 ans."
    ],
    "nl": [
      "Ontdek biatlon in de zomer! Verruil je ski's voor een paar sportschoenen. Het is niet zo gemakkelijk om je na het hardlopen meteen op de eerste plaats te richten. Vanaf 7 jaar."
    ],
    "es": [
      "Descubra el biatlón en verano Cambia los esquís por unas zapatillas. No es tan fácil aspirar a ser el primero después de correr. A partir de 7 años."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Biathlon d'été"
    ]
  },
