  "rdfs:comment": {
    "de": [
      "Strandbar auf dem Plankenweg: Terrasse mit den Füßen im Wasser und atemberaubender Aussicht im Obergeschoss. Es werden Bretter, Aufstriche und Tapas angeboten. Konzerte und musikalische Unterhaltung während des ganzen Sommers."
    ],
    "en": [
      "Beach bar located on the boardwalk: terrace with feet in the water and breathtaking view upstairs. Planks, spreads and tapas on offer. Concerts and musical entertainment throughout the summer."
    ],
    "it": [
      "Beach bar situato sul lungomare: terrazza con i piedi nell'acqua e vista mozzafiato dal primo piano. Offerta di tavole, spiedini e tapas. Concerti e intrattenimento musicale per tutta l'estate."
    ],
    "fr": [
      "Bar de plage situé sur le chemin de planches : terrasse les pieds dans l’eau et vue imprenable à l’étage. Planches, tartinades et tapas sont proposés. Concerts et animations musicales durant tout l’été."
    ],
    "nl": [
      "Strandbar aan de promenade: terras met de voeten in het water en een adembenemend uitzicht vanaf de eerste verdieping. Aanbod van planken, broodbeleg en tapas. Concerten en muzikaal entertainment gedurende de hele zomer."
    ],
    "es": [
      "Chiringuito situado en el paseo marítimo: terraza con los pies en el agua y una vista impresionante desde la primera planta. Oferta de tablas, untables y tapas. Conciertos y animación musical durante todo el verano."
    ]
  },
