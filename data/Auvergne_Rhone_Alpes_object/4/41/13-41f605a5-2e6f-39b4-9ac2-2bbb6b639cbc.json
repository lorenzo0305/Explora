  "rdfs:comment": {
    "de": [
      "Die Gondelbahn von Super Morzine verbindet Morzine mit Avoriaz. Ihre Wanderungen können Sie dann bis ins Tal von Abondance oder auf die Schweizer Seite der Portes du Soleil führen."
    ],
    "en": [
      "The Super Morzine Gondola links Morzine and Avoriaz.  This walk can lead you all the way to the Valley d'Abondance or into Switzerland enjoying the Portes de Soleil circuit."
    ],
    "it": [
      "La funivia Super Morzine collega Morzine ad Avoriaz. Le vostre passeggiate possono poi portarvi nella valle dell'Abondance o sul versante svizzero delle Portes du Soleil."
    ],
    "fr": [
      "La télécabine de Super Morzine relie Morzine à Avoriaz. Vos balades pourront ensuite vous conduire jusqu’à la vallée d’Abondance ou sur le versant suisse des Portes du Soleil."
    ],
    "es": [
      "El teleférico Super Morzine une Morzine con Avoriaz. Sus paseos pueden llevarle al valle de Abondance o a la vertiente suiza de Portes du Soleil."
    ],
    "nl": [
      "De Super Morzine kabelbaan verbindt Morzine met Avoriaz. Uw wandelingen kunnen u vervolgens naar de Abondance-vallei brengen of naar de Zwitserse kant van de Portes du Soleil."
    ]
  },
  "rdfs:label": {
    "en": [
      "Super Morzine Gondola"
    ],
    "fr": [
      "Télécabine de Super Morzine"
    ]
  },
