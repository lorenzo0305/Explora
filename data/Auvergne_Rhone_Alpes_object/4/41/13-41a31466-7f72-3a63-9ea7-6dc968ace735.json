  "rdfs:comment": {
    "de": [
      "Direktverkauf von CBD, Kombucha (ein sprudelndes, natürlich fermentiertes Getränk mit uralten Vorteilen) und Gemüsepflanzen von unseren Bio-Bauernhöfen auf lebendem Boden. Handwerkliche Herstellung von Vaporizern aus getrockneten Pflanzen aus Holz und Glas."
    ],
    "en": [
      "Direct sales of CBD, Kombucha (naturally fermented fizzy drink with ancestral benefits) and market garden plants from our organic farms on living soil. Hand-crafted dry herb vaporizers in wood and glass"
    ],
    "it": [
      "Vendita diretta di CBD, Kombucha (bevanda frizzante a fermentazione naturale con benefici ancestrali) e piante da orto provenienti dalle nostre fattorie biologiche su terreno vivo. Vaporizzatori artigianali per piante secche in legno e vetro"
    ],
    "fr": [
      "Vente directe de producteur de CBD, Kombucha (boisson pétillante fermente naturellement aux bienfaits ancestraux) et plants maraichers de nos fermes Bio sur sol vivant. Création artisanale de vaporisateur de plantes sèches bois et verre"
    ],
    "es": [
      "Venta directa de CBD, Kombucha (bebida efervescente de fermentación natural con beneficios ancestrales) y plantas de huerta de nuestras granjas ecológicas en suelo vivo. Vaporizadores artesanales de plantas secas en madera y cristal"
    ],
    "nl": [
      "Directe verkoop van CBD, Kombucha (natuurlijk gefermenteerde bruisende drank met voorouderlijke voordelen) en tuinplanten van onze biologische boerderijen op levende grond. Handgemaakte verdampers voor droge planten van hout en glas"
    ]
  },
  "rdfs:label": {
    "de": [
      "Lokaler und bäuerlicher In die K CBD-Shop"
    ],
    "en": [
      "Store In die K CBD local and farmer"
    ],
    "fr": [
      "Boutique In die K CBD local et paysan"
    ],
    "nl": [
      "In die K CBD buurt- en boerderijwinkel"
    ]
  },
