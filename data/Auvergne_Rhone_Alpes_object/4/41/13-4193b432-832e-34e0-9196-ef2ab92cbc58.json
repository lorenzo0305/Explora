  "rdfs:comment": {
    "de": [
      "Protestantische Baptistenkirche\r\nGottesdienst: sonntags um 10 Uhr\r\nBibelstudien: Donnerstags um 18:30 Uhr\r\nGebetstreffen: Am 1. Donnerstag des Monats\r\nJugendgruppe: jeden zweiten Samstag um 19.00 Uhr\r\nNachbarschaftsstudien: jeden ersten Dienstag im Monat in Le Gavot"
    ],
    "en": [
      "Baptist Protestant Church\r\nWorship service: Sundays at 10 a.m.\r\nBible study: Thursdays at 6:30 p.m.\r\nPrayer meeting: First Thursday of the month\r\nYouth group: Every other Saturday at 7 p.m.\r\nLocal studies: First Tuesday of the month at Le Gavot"
    ],
    "it": [
      "Chiesa protestante battista\r\nCulto: domenica alle 10.00\r\nStudio biblico: giovedì alle 18.30\r\nRiunione di preghiera: 1° giovedì del mese\r\nGruppo giovanile: ogni due sabati alle 19.00\r\nStudi comunitari: primo martedì del mese a Le Gavot"
    ],
    "fr": [
      "Eglise Protestante Baptiste\r\nCulte : les dimanches à 10h\r\nEtudes bibliques : les jeudis à 18h30\r\nRéunion de prières : Le 1er jeudi du mois \r\nGroupe de Jeunes : un samedi sur deux à 19h00 \r\nÉtudes de proximité : les premiers mardis du mois au Gavot"
    ],
    "nl": [
      "Protestantse Doopsgezinde Kerk\r\nAanbidding: zondags om 10 uur\r\nBijbelstudie: donderdag om 18.30 uur\r\nGebedsbijeenkomst: 1e donderdag van de maand\r\nJeugdgroep: om de zaterdag om 19.00 uur\r\nGemeenschapsstudies: eerste dinsdag van de maand in Le Gavot"
    ],
    "es": [
      "Iglesia Protestante Bautista\r\nCulto: domingos a las 10h\r\nEstudio bíblico: jueves a las 18.30\r\nReunión de oración: 1er jueves del mes\r\nGrupo de jóvenes: sábados alternos a las 19.00\r\nEstudios comunitarios: primer martes de mes en Le Gavot"
