  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d8b614d6-6c80-38ae-b9a4-778c53290eb2",
      "dc:description": {
        "de": [
          "Die Beethoven-Spezialistin Mari Kodama ist eine der wenigen Frauen, die alle Beethoven-Sonaten eingespielt hat, die sie mit dem Meister Alfred Brendel bearbeitet hat. Auch sie verrät einige Geheimnisse, um das Werk des genialen Komponisten zu verstehen."
        ],
        "en": [
          "A Beethoven specialist, Mari Kodama is one of the few women to have recorded the complete Beethoven sonatas, which she worked on with the master Alfred Brendel. In her turn, she will reveal some of the secrets of the great composer?s work."
        ],
        "it": [
          "Specialista di Beethoven, Mari Kodama è una delle poche donne ad aver registrato l'integrale delle sonate di Beethoven, a cui ha lavorato con il maestro Alfred Brendel. A sua volta, ci svelerà alcuni dei suoi segreti per comprendere l'opera del grande compositore."
        ],
        "fr": [
          "Spécialiste de Beethoven, Mari Kodama est l’une des rare femme à avoir enregistré l’intégralité des sonates de Beethoven, qu’elle a travaillées avec le maître Alfred Brendel. A son tour, elle livrera quelques secrets pour appréhender l’œuvre du génial compositeur."
        ],
        "nl": [
          "Mari Kodama is een Beethoven-specialist en een van de weinige vrouwen die de complete Beethoven-sonates heeft opgenomen, waaraan ze samenwerkte met meester Alfred Brendel. Op haar beurt zal ze enkele van haar geheimen voor het begrijpen van het werk van de grote componist onthullen."
        ],
        "es": [
          "Especialista en Beethoven, Mari Kodama es una de las pocas mujeres que ha grabado la integral de las sonatas de Beethoven, en las que trabajó con el maestro Alfred Brendel. A su vez, nos revelará algunos de sus secretos para comprender la obra del gran compositor."
        ]
      },
