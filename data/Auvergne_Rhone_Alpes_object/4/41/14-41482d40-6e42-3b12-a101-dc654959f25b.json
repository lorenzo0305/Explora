  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7350f629-ffc5-37c7-bb76-3e03316e9818",
      "dc:description": {
        "de": [
          "THE LOCH GAMES\n\nBesuchen Sie diesen Pub in schottischer Atmosphäre und genießen Sie bei einem Drink eine große Auswahl an Brettspielen, Videospielen, PC-Gaming und sogar Darts!\n\n7 rue Edmond Rostand, Boulogne-sur-Mer, Frankreich, 62200\n09 73 88 92 28"
        ],
        "en": [
          "THE LOCH GAMES\n\nCome and discover this pub in a Scottish atmosphere and enjoy a wide range of board games, video games, PC gaming, and even darts over a drink!\n\n7 rue Edmond Rostand, Boulogne-sur-Mer, France, 62200\n09 73 88 92 28"
        ],
        "it": [
          "I GIOCHI DEL LOCH\n\nVenite a scoprire questo pub dall'atmosfera scozzese e godetevi una vasta gamma di giochi da tavolo, videogiochi, giochi per PC e persino freccette davanti a un drink!\n\n7 rue Edmond Rostand, Boulogne-sur-Mer, Francia, 62200\n09 73 88 92 28"
        ],
        "fr": [
          "THE LOCH GAMES\n\nVenez découvrir ce pub dans une ambiance écossaise et profitez d'une large gamme de jeux de société, jeux vidéo, PC gaming, et même des fléchettes autour d'un verre !\n\n7 rue Edmond Rostand, Boulogne-sur-Mer, France, 62200\n09 73 88 92 28"
        ],
        "es": [
          "LOS JUEGOS DE LOCH\n\nVen a descubrir este pub de ambiente escocés y disfruta de una amplia gama de juegos de mesa, videojuegos, juegos de PC e incluso dardos ¡tomando una copa!\n\n7 rue Edmond Rostand, Boulogne-sur-Mer, Francia, 62200\n09 73 88 92 28"
        ],
        "nl": [
          "DE SPELLEN\n\nKom en ontdek deze pub in Schotse sfeer en geniet onder het genot van een drankje van een breed scala aan bordspellen, videospellen, pc-games en zelfs darts!\n\n7 rue Edmond Rostand, Boulogne-sur-Mer, Frankrijk, 62200\n09 73 88 92 28"
        ]
      },
