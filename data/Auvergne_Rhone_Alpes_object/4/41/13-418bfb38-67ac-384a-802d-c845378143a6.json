  "rdfs:comment": {
    "de": [
      "Anlässlich der Restaurierungsarbeiten an der Kirche Sainte-Madeleine in Cros-de-Montvert enthüllten die Gewölbe, Säulen und Kapitelle ihre ursprüngliche Polychromie aus dem 17. und 18."
    ],
    "en": [
      "During restoration work on the church of St. Magdalena in Cros-de-Montvert, the vaults, columns and capitals revealed their original 17th and 18th century polychromy."
    ],
    "it": [
      "Durante i lavori di restauro della chiesa di Sainte-Madeleine a Cros-de-Montvert, le volte, le colonne e i capitelli hanno rivelato la loro policromia originale del XVII e XVIII secolo."
    ],
    "fr": [
      "À l'occasion de travaux de restauration de l'église Sainte-Madeleine de Cros-de-Montvert, les voûtes, colonnes et chapiteaux ont révélé leur polychromie originelle des XVIIe et XVIIIe siècles."
    ],
    "es": [
      "Durante las obras de restauración de la iglesia Sainte-Madeleine de Cros-de-Montvert, las bóvedas, columnas y capiteles revelaron su policromía original de los siglos XVII y XVIII."
    ],
    "nl": [
      "Bij de restauratie van de Heilige Magdalenakerk in Cros-de-Montvert hebben de gewelven, zuilen en kapitelen hun oorspronkelijke polychromie uit de 17e en 18e eeuw teruggevonden."
    ]
  },
