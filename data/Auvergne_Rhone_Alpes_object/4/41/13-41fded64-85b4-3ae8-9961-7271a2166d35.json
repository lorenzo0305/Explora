  "rdfs:comment": {
    "de": [
      "Eine traditionelle Küche, die Sie den guten Geschmack der regionalen Produkte wiederfinden lässt. Sie werden den herzlichen Empfang der Wirtsleute zu schätzen wissen, die Ihnen eine saisonale Küche servieren."
    ],
    "en": [
      "A traditional cuisine that will give you a taste of delicious local products. You're sure to appreciate the Chef's warm welcome and he'll be delighted to cook a seasonal meal for you."
    ],
    "it": [
      "Una cucina tradizionale che vi farà riscoprire il buon gusto dei prodotti locali. Apprezzerete la calda accoglienza dei proprietari che vi faranno assaggiare una cucina di stagione."
    ],
    "fr": [
      "Une cuisine traditionnelle qui vous fera retrouver le bon goût des produits du terroir. Vous apprécierez l'accueil chaleureux des patrons qui vous feront déguster une cuisine de saison."
    ],
    "es": [
      "Una cocina tradicional que le hará redescubrir el buen sabor de los productos locales. Apreciará la cálida acogida de los propietarios que le harán degustar una cocina de temporada."
    ],
    "nl": [
      "Een traditionele keuken die u de goede smaak van lokale producten laat herontdekken. U zult het warme onthaal van de eigenaars waarderen, die u een seizoensgebonden keuken zullen laten proeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rod & Sève"
    ]
  },
