  "rdfs:comment": {
    "de": [
      "Entdecken Sie in der Kirche von Sallenôves die große Kuppel mit einem wunderschönen Fresko, das von Ferraris Giovanni di Campertogno gemalt wurde. Es wurde von M. Mantillerie renoviert und erzählt das Leben der Schutzheiligen."
    ],
    "en": [
      "In the church of Sallenôves, discover the vast dome adorned with a magnificent fresco painted by Ferraris Giovanni di Campertogno. Renovated by Mr. Mantillerie, it tells the story of the patron saints."
    ],
    "it": [
      "Nella chiesa di Sallenôves si trova una grande cupola con un magnifico affresco dipinto da Ferraris Giovanni di Campertogno. Ristrutturato da Mr Mantillerie, racconta la storia dei santi patroni."
    ],
    "fr": [
      "Découvrez dans l’église de Sallenôves la vaste coupole ornée d’une magnifique fresque peinte par Ferraris Giovanni di Campertogno. Rénovée par M. Mantillerie, elle raconte la vie des saints patrons."
    ],
    "nl": [
      "In de kerk van Sallenôves ontdekt u de enorme koepel versierd met een prachtig fresco geschilderd door Ferraris Giovanni di Campertogno. Gerenoveerd door de heer Mantillerie, vertelt het het verhaal van de beschermheiligen."
    ],
    "es": [
      "En la iglesia de Sallenôves, encontrará una gran cúpula decorada con un magnífico fresco pintado por Ferraris Giovanni di Campertogno. Renovada por el Sr. Mantillerie, cuenta la historia de los santos patronos."
    ]
  },
