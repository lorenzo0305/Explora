  "rdfs:comment": {
    "de": [
      "Das Maison Héméra in Sermérieu aux Balcons du Dauphiné lädt Sie ein, seine handgefertigten Keramikkreationen zu entdecken. Entscheiden Sie sich für Qualität und Schönheit!\r\nEntdecken Sie auch seine verschiedenen Workshops (Entdeckung, Einführung, Eltern-Kind-Duo...)."
    ],
    "en": [
      "Maison Héméra in Sermérieu on the Balcons du Dauphiné invites you to discover its handmade ceramic creations. Opt for quality and beauty!\r\nDiscover also its various workshops (discovery, initiation, parent-child duo...)."
    ],
    "it": [
      "La Maison Héméra di Sermérieu, nei Balcons du Dauphiné, vi invita a scoprire le sue creazioni artigianali in ceramica. Scegliete la qualità e la bellezza!\r\nTroverete anche una serie di laboratori (scoperta, iniziazione, duo genitori-figli, ecc.)."
    ],
    "fr": [
      "La Maison Héméra à Sermérieu aux Balcons du Dauphiné vous invite à découvrir ses créations céramiques réalisées à la main. Optez pour la qualité et la beauté ! \r\nDécouvrez aussi ses divers ateliers (découverte, initiation, duo parent-enfant...)."
    ],
    "nl": [
      "Maison Héméra in Sermérieu in de Balcons du Dauphiné nodigt je uit om zijn handgemaakte keramische creaties te ontdekken. Kies voor kwaliteit en schoonheid!\r\nJe vindt er ook verschillende workshops (ontdekking, initiatie, ouder-kind duo, enz.)."
    ],
    "es": [
      "La Maison Héméra de Sermérieu, en los Balcons du Dauphiné, le invita a descubrir sus creaciones de cerámica hechas a mano. ¡Apueste por la calidad y la belleza!\r\nTambién encontrará diversos talleres (descubrimiento, iniciación, dúo padres-hijos, etc.)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Héméra, artisan céramiste"
    ]
  },
