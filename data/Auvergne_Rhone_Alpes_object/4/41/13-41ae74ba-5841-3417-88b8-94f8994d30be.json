  "rdfs:comment": {
    "de": [
      "Dieses zeitgenössische Kunstwerk, das auf dem Jakobsweg liegt und von der lokalen Geologie inspiriert wurde, soll Wanderern als Zufluchtsort dienen.\r\nEs bietet einen atemberaubenden Blick auf die Sucs du Meygal."
    ],
    "en": [
      "Situated on the route to Santiago de Compostela, this contemporary work of art, inspired by local geology, serves as a refuge for walkers.\r\nIt offers a breathtaking view of the sucs du Meygal."
    ],
    "it": [
      "Situata sul cammino di Santiago de Compostela, quest'opera d'arte contemporanea, ispirata alla geologia locale, funge da rifugio per gli escursionisti.\r\nOffre una vista mozzafiato sul Sucs du Meygal."
    ],
    "fr": [
      "Située sur le chemin de Saint-Jacques de Compostelle, cette œuvre d’art contemporaine, inspirée de la géologie locale, a vocation d'œuvre d’art refuge pour les marcheurs. \r\nElle offre une vue imprenable sur les sucs du Meygal."
    ],
    "es": [
      "Situada en el camino de Santiago de Compostela, esta obra de arte contemporánea, inspirada en la geología local, sirve de refugio a los caminantes.\r\nOfrece una vista impresionante del sucs du Meygal."
    ],
    "nl": [
      "Dit hedendaagse kunstwerk, geïnspireerd door de plaatselijke geologie, ligt op de route naar Santiago de Compostela en dient als toevluchtsoord voor wandelaars.\r\nHet biedt een adembenemend uitzicht op de sucs du Meygal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Suchaillou"
    ]
  },
