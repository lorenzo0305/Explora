  "rdfs:comment": {
    "de": [
      "Das Zentrum für zeitgenössische Kunst befindet sich im Parc Montessuit. Es zeigt jedes Jahr 4 bis 5 Ausstellungen zeitgenössischer Künstler und bietet kommentierte Führungen für die ganze Familie an."
    ],
    "en": [
      "The contemporary art center is located in the Parc Montessuit. Each year, it presents 4 to 5 exhibitions by contemporary artists, and offers guided tours for the whole family."
    ],
    "it": [
      "Il centro d'arte contemporanea si trova nel Parc Montessuit. Ogni anno presenta 4 o 5 mostre di artisti contemporanei e offre visite guidate per tutta la famiglia."
    ],
    "fr": [
      "Le centre d'art contemporain est situé dans le Parc Montessuit. Il présente chaque année 4 à 5 expositions d'artistes contemporains et propose des visites commentées pour toute la famille."
    ],
    "nl": [
      "Het centrum voor hedendaagse kunst ligt in het Parc Montessuit. Elk jaar presenteert het 4 of 5 tentoonstellingen van hedendaagse kunstenaars en biedt het rondleidingen voor het hele gezin."
    ],
    "es": [
      "El centro de arte contemporáneo está situado en el Parc Montessuit. Cada año presenta 4 o 5 exposiciones de artistas contemporáneos y ofrece visitas guiadas para toda la familia."
    ]
  },
  "rdfs:label": {
