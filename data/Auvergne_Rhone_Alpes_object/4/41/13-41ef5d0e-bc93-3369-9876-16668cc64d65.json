  "rdfs:comment": {
    "de": [
      "Bar, die restauriert, Pizzéria, die Brauerei. Abend Konzert und Lebhaftigkeiten. Firmenseminare / Geschäftsmahlzeit /"
    ],
    "en": [
      "Pub/restaurant serving pizzas to eat-in or to take away. Large terrace. Close to a parking lot. Events and concerts during the evening. Perfect for company seminars, business lunches or family meals."
    ],
    "it": [
      "Ristorante, bar, pizzeria, hamburger da asporto, insalate, pizze.\r\nAmpia terrazza con parcheggio nelle vicinanze. Pasti di gruppo, sala e spazi per riunioni. Seminari e catering, serate a tema."
    ],
    "fr": [
      "Restaurant, bar, pizzéria, vente à emporter burger, salades, pizzas.\r\nGrande terrasse avec parking proche. Repas de groupes et espace lounge et de réunion. Séminaires et traiteur, soirées à thèmes."
    ],
    "es": [
      "Restaurante, bar, pizzería, hamburguesas para llevar, ensaladas, pizzas.\r\nAmplia terraza con aparcamiento cercano. Comidas para grupos y espacio para reuniones. Seminarios y catering, noches temáticas."
    ],
    "nl": [
      "Bar, restaurant, pizzeria, brasserie. Concertavond en activiteiten. Seminars voor bedrijven/zakelijke diners/familiediners. Afhaalpizza's."
    ]
  },
  "rdfs:label": {
