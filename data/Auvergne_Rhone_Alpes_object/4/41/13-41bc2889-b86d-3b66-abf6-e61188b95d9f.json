  "rdfs:comment": {
    "de": [
      "Performances Drive kann Sie in zwei verschiedenen Räumen empfangen und Ihnen verschiedene Leistungen für Ihre Sitzungen, Firmenseminare oder verschiedene Treffen anbieten. So wird es möglich sein, den Raum zu privatisieren."
    ],
    "en": [
      "Performances Drive can accommodate you in two different spaces and offer you a range of services for your meetings, corporate seminars or other gatherings. It will also be possible to privatize the space."
    ],
    "it": [
      "Performances Drive può ospitarvi in due aree diverse e offrire una serie di servizi per le vostre riunioni, seminari aziendali o altri incontri. Lo spazio può anche essere reso privato."
    ],
    "fr": [
      "Performances Drive peut vous accueillir dans deux espaces différents et vous proposer différentes prestations pour vos réunions, séminaires d'entreprises ou différentes rencontres. Il sera ainsi possible de privatiser l'espace."
    ],
    "es": [
      "Performances Drive puede acogerle en dos espacios diferentes y ofrecerle toda una gama de servicios para sus reuniones, seminarios de negocios u otros encuentros. El espacio también puede hacerse privado."
    ],
    "nl": [
      "Performances Drive biedt plaats aan u in twee verschillende ruimtes en biedt een scala aan diensten voor uw vergaderingen, zakelijke seminars of andere bijeenkomsten. De ruimte kan ook privé worden gemaakt."
    ]
  },
  "rdfs:label": {
    "en": [
