  "rdfs:comment": {
    "de": [
      "Der Orientierungslauf-Freizeitbereich (ELO) ist ein kartiertes und ausgestattetes Gelände, das eine spielerische Ausübung von Orientierungssport mit der Entdeckung des lokalen Kulturerbes verbindet. Der ELO in Dullin bietet einen kinderfreundlichen, spielerischen Parcours."
    ],
    "en": [
      "The Orienteering Leisure Area (ELO) is a mapped and equipped space designed for fun, accessible orienteering activities combined with discovering the local heritage. The Dullin ELO offers a playful route suitable for children."
    ],
    "it": [
      "L'Espace Loisirs Orienteering (ELO) è un'area cartografata dove è possibile praticare sport di orientamento e scoprire il patrimonio locale. L'ELO di Dullin offre un percorso ludico adatto ai bambini."
    ],
    "fr": [
      "L’espace loisirs orientation (ELO), est un espace aménagé et cartographié pour une pratique ludique des sports d’orientation alliée à la découverte du patrimoine local. L’ELO de Dullin propose un parcours ludique adapté aux enfants."
    ],
    "nl": [
      "Het recreatiegebied voor oriëntatielopen (ELO) is een ingerichte en in kaart gebrachte ruimte die op een speelse manier oriëntatiesport combineert met het ontdekken van het lokale erfgoed. De ELO van Dullin biedt een leuk parcours dat geschikt is voor kinderen."
    ],
    "es": [
      "El Espace Loisirs Orienteering (ELO) es una zona cartografiada donde se puede disfrutar de los deportes de orientación mientras se descubre el patrimonio local. El ELO de Dullin ofrece un recorrido lúdico apto para niños."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf-Freizeitgelände durch das Dorf Dullin"
    ],
    "en": [
      "Orienteering Leisure Area through the village of Dullin"
    ],
    "fr": [
      "Parcours ludique du village de Dullin"
    ],
    "nl": [
      "Recreatiegebied voor oriëntatielopen door het dorp Dullin"
    ]
  },
