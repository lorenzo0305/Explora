  "rdfs:comment": {
    "de": [
      "Bootsfahrt auf dem Kanal von Pont-de-Vaux und der Saône bis zum Zusammenfluss mit der Seille hin und zurück. Passieren der Schleuse von Pont-de-Vaux. Mahlzeiten an Bord."
    ],
    "en": [
      "Departing from the Pont-de-Vaux marina, a 3-hour lunch cruise on the Canal de Pont-de-Vaux and the Saône to the confluence with the Seille and back. Passage of the Pont-de-Vaux lock. Lunch on board."
    ],
    "it": [
      "Con partenza dal porto turistico di Pont-de-Vaux, crociera di 3 ore con pranzo sul canale di Pont-de-Vaux e sulla Saona fino alla confluenza con la Seille e ritorno. Passaggio attraverso la chiusa di Pont-de-Vaux. Pranzo a bordo."
    ],
    "fr": [
      "Au départ du port de Plaisance de Pont-de-Vaux, croisière déjeuner de 3 heures sur le Canal de Pont-de-Vaux et la Saône jusqu'à la confluence avec la Seille aller et retour. Passage de l'écluse de Pont-de-Vaux. Repas à bord."
    ],
    "nl": [
      "Vertrek vanuit de jachthaven van Pont-de-Vaux, een 3 uur durende lunch cruise op het Pont-de-Vaux kanaal en de Saône tot de samenvloeiing met de Seille en terug. Doorvaart van de sluis van Pont-de-Vaux. Lunch aan boord."
    ],
    "es": [
      "Con salida del puerto deportivo de Pont-de-Vaux, crucero de 3 horas con almuerzo por el canal de Pont-de-Vaux y el Saona hasta la confluencia con el Seille y regreso. Paso por la esclusa de Pont-de-Vaux. Almuerzo a bordo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kreuzfahrt Zusammenfluss von Saône und Seille"
    ],
    "en": [
      "Saône Seille confluence cruise"
    ],
    "fr": [
      "Croisière confluence Saône Seille"
    ],
    "nl": [
      "Saône Seille samenvloeiing cruise"
    ]
  },
