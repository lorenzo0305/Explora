  "rdfs:comment": {
    "de": [
      "Das Vokalensemble Crescendo und der Workshop für traditionelle Musik aus St. Marcel Les Valence unter der Leitung von Marie-Pierre Bégot laden Sie zu ihrem Konzert \"Amours et printemps\" in der Kirche St Martin in Peyrins ein."
    ],
    "en": [
      "The Crescendo vocal ensemble and the traditional music workshop of St Marcel Les Valence, directed by Marie-Pierre Bégot, invite you to their \"Amours et printemps\" concert at St Martin de Peyrins church."
    ],
    "it": [
      "L'ensemble vocale Crescendo e il laboratorio di musica tradizionale di St Marcel Les Valence, diretto da Marie-Pierre Bégot, vi invitano al concerto \"Amours et printemps\" nella chiesa di St Martin de Peyrins."
    ],
    "fr": [
      "L'ensemble vocal Crescendo et l'atelier de musique traditionnelle de St Marcel Les Valence dirigés par Marie-Pierre Bégot vous invite à leur concert \"Amours et printemps\" à l'église St Martin de Peyrins."
    ],
    "nl": [
      "Het vocaal ensemble Crescendo en de traditionele muziekworkshop van St Marcel Les Valence, onder leiding van Marie-Pierre Bégot, nodigen je uit voor hun concert \"Amours et printemps\" in de kerk van St Martin de Peyrins."
    ],
    "es": [
      "El conjunto vocal Crescendo y el taller de música tradicional de St Marcel Les Valence, dirigidos por Marie-Pierre Bégot, le invitan a su concierto \"Amours et printemps\" en la iglesia de St Martin de Peyrins."
    ]
  },
