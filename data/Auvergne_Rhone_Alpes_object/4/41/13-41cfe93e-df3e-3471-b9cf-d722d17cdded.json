  "rdfs:comment": {
    "de": [
      "Dieses anmutige Schloss liegt inmitten eines Parks in vollkommener Ruhe und bietet innerhalb seiner dicken Mauern den Komfort einer gediegenen Anlage, die auf Annehmlichkeiten, Entspannung und Lebensfreude ausgelegt ist."
    ],
    "en": [
      "Situated in the heart of a park, in a perfect tranquility, this graceful castle offers, within its thick walls, the comfort of a cosseted installation, conceived for the pleasure, the relaxation and the sweetness of living."
    ],
    "it": [
      "Situato nel cuore di un parco, in perfetta tranquillità, questo grazioso castello offre, tra le sue spesse mura, il comfort di una struttura accogliente, pensata per il piacere, il relax e la dolcezza della vita."
    ],
    "fr": [
      "Situé au cœur d'un parc, dans une parfaite tranquillité, ce gracieux château offre, au sein de ses épaisses murailles, le confort d'une installation cossue, conçue pour l'agrément, la détente et la douceur de vivre."
    ],
    "es": [
      "Situado en el corazón de un parque, en perfecta tranquilidad, este elegante castillo ofrece, dentro de sus gruesos muros, el confort de una instalación acogedora, pensada para el placer, la relajación y la dulzura de vivir."
    ],
    "nl": [
      "Gelegen in het hart van een park, in perfecte rust, biedt dit sierlijke kasteel, binnen zijn dikke muren, het comfort van een gezellige faciliteit, ontworpen voor plezier, ontspanning en zacht leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant Le Château Saint-Jean"
    ]
  },
