  "rdfs:comment": {
    "de": [
      "Die Snackbar liegt am Ufer des Neunteichs und bietet verschiedene Speisen an: ein Tagesgericht, Paninis, Sandwiches, Waffeln, heiße und kalte Getränke."
    ],
    "en": [
      "Situated on the banks of the Etang-Neuf, the snack bar offers a variety of food: a dish of the day, paninis, sandwiches, waffles, hot and cold drinks."
    ],
    "it": [
      "Situato sulle rive dell'Etang-Neuf, lo snack bar offre una varietà di cibi: un piatto del giorno, panini, sandwich, waffle, bevande calde e fredde."
    ],
    "fr": [
      "Situé sur les rives de l'étang-neuf, le snack propose une alimentation diverse : un plat du jour, paninis, sandwichs, gaufres, boissons chaudes et fraîches."
    ],
    "es": [
      "Situado a orillas del Etang-Neuf, el snack bar ofrece comida variada: plato del día, paninis, sándwiches, gofres, bebidas frías y calientes."
    ],
    "nl": [
      "De snackbar ligt aan de oever van de Etang-Neuf en biedt een verscheidenheid aan eten: een dagschotel, panini's, broodjes, wafels, warme en koude dranken."
    ]
  },
  "rdfs:label": {
