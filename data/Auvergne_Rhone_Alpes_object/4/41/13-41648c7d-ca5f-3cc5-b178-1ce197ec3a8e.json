  "rdfs:comment": {
    "de": [
      "Erleben Sie mit mir einen \"Entdeckungsspaziergang\", um sich mit der Natur und der Energie des Chamonix-Tals in einer erholsamen und dynamischen Umgebung zu verbinden."
    ],
    "en": [
      "Come and experience a \"discovery\" walk with me to connect with nature and the energy of the Chamonix valley in a restorative and energizing environment."
    ],
    "it": [
      "Unitevi a me in una passeggiata \"di scoperta\" per entrare in contatto con la natura e l'energia della valle di Chamonix in un ambiente rigenerante ed energizzante."
    ],
    "fr": [
      "Venez vivre avec moi l’expérience une balade « découverte » pour vous connectez avec la nature et l’énergie de la vallée de Chamonix dans un environnement réparateur et dynamisant."
    ],
    "nl": [
      "Ga met me mee op een \"ontdekkings\" wandeling om in contact te komen met de natuur en de energie van de vallei van Chamonix in een herstellende en verkwikkende omgeving."
    ],
    "es": [
      "Acompáñame en un paseo de \"descubrimiento\" para conectar con la naturaleza y la energía del valle de Chamonix en un entorno reparador y energizante."
    ]
  },
