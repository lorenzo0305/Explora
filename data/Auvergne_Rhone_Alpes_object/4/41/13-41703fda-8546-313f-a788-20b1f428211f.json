  "rdfs:comment": {
    "de": [
      "Willkommen im FiFi, einem geschichtsträchtigen Restaurant, das seine Türen mit einem Konzept der italienischen Küche wiedereröffnet, das von Thibault und Philippe getragen wird, die Sie jeden Abend von 19:00 bis 00:00 Uhr begrüßen."
    ],
    "en": [
      "Welcome to FiFi, a restaurant steeped in history that has reopened its doors with an Italian cuisine concept led by Thibault and Philippe, who welcome you every evening from 7pm to midnight."
    ],
    "it": [
      "Benvenuti al FiFi, un ristorante ricco di storia che ha riaperto le porte a un nuovo concetto di cucina italiana, guidato da Thibault e Philippe, che vi accoglieranno ogni sera dalle 19.00 a mezzanotte."
    ],
    "fr": [
      "Bienvenue chez FiFi, un restaurant chargé d’histoire qui réouvre ses portes dans un concept de cuisine italienne porté par Thibault et Philippe qui vous accueillent tous les soirs de 19h00 à 00h00."
    ],
    "nl": [
      "Welkom bij FiFi, een restaurant met een rijke geschiedenis dat zijn deuren heeft heropend met een nieuw concept in de Italiaanse keuken, onder leiding van Thibault en Philippe, die u elke avond van 19.00 tot middernacht verwelkomen."
    ],
    "es": [
      "Bienvenido a FiFi, un restaurante cargado de historia que ha reabierto sus puertas a un nuevo concepto de cocina italiana, de la mano de Thibault y Philippe, que le dan la bienvenida todas las tardes de 19:00 a 24:00."
    ]
  },
