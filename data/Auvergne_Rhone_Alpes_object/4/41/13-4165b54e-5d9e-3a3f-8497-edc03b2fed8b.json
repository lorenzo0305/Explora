  "rdfs:comment": {
    "de": [
      "Möchten Sie Ihren Rücken pflegen? Ihren Stress abbauen? Ihr Immunsystem stärken? Ich biete Ihnen Methoden an, die auf Ihre Bedürfnisse zugeschnitten sind: Massagen, Energieausgleich, Reflexologie, Pulsor, Zellanalyse und -information."
    ],
    "en": [
      "Do you want to heal your back ? Alleviate your stress ? Reboost your immune system ? I propose methods adapted to your needs: massages, energy rebalancing, reflexology, Pulsor, Cellular Analysis and Reinformation."
    ],
    "it": [
      "Volete curare la vostra schiena? Alleviare lo stress? Rafforzare il sistema immunitario? Vi offro metodi adatti alle vostre esigenze: massaggi, riequilibrio energetico, riflessologia, Pulsor, Analisi Cellulare e Reinformazione."
    ],
    "fr": [
      "Vous voulez soigner votre dos ? Alléger votre stress ? Rebooster votre système immunitaire ? Je vous propose des méthodes adaptées à vos besoins: massages, rééquilibrage énergétique, réfléxologie, Pulsor, Analyse et Réinformation Cellulaire."
    ],
    "es": [
      "¿Quieres tratar tu espalda? ¿Aliviar el estrés? ¿Reforzar su sistema inmunológico? Te ofrezco métodos adaptados a tus necesidades: masajes, reequilibrio energético, reflexología, Pulsor, Análisis Celular y Reinformación."
    ],
    "nl": [
      "Wil je je rug behandelen? Stress verlichten? Je immuunsysteem een boost geven? Ik bied een scala aan methoden die zijn afgestemd op jouw behoeften: massage, energieherbalancering, reflexologie, Pulsor, Cellulaire Analyse en Reinformatie."
    ]
  },
