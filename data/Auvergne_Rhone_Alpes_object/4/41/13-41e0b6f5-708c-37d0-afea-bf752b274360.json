  "rdfs:comment": {
    "de": [
      "Große Sonnenterrasse mit Blick auf den Mont Blanc und die Aravis. Lokale und moderne Küche. Nur im Winter geöffnet. Private Veranstaltungen auf Anfrage das ganze Jahr über."
    ],
    "en": [
      "Large sunny terrace with views of Mont Blanc and the Aravis mountains. Local and contemporary cuisine. Open only in winter. Private events on request all year round."
    ],
    "it": [
      "Ampia terrazza soleggiata con vista sul Monte Bianco e sui monti Aravis. Cucina locale e contemporanea. Aperto solo in inverno. Eventi privati su richiesta tutto l'anno."
    ],
    "fr": [
      "Grande terrasse ensoleillée vue sur le Mont Blanc et les Aravis. Cuisine saveurs locales et contemporaines. Ouvert uniquement l'hiver. Événements privatifs, sur demande toute l'année."
    ],
    "nl": [
      "Groot zonnig terras met uitzicht op de Mont Blanc en het Aravis-gebergte. Lokale en eigentijdse keuken. Alleen in de winter geopend. Privé-evenementen op aanvraag het hele jaar door."
    ],
    "es": [
      "Gran terraza soleada con vistas al Mont Blanc y a los montes Aravis. Cocina local y contemporánea. Abierto sólo en invierno. Eventos privados a petición durante todo el año."
    ]
  },
