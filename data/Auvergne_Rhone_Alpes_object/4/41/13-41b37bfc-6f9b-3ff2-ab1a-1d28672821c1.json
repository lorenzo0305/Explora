  "rdfs:comment": {
    "de": [
      "Jeden Tag bietet Ihnen Yannick hausgemachte Gerichte zum Mitnehmen an: Vorspeisen (Rohkost, Suppen, Salate je nach Saison), frisches Fleisch oder Fisch, Beilagen, Desserts (Kuchen, Torten, Fruchtmousse...), Wurstwaren, Weine..."
    ],
    "en": [
      "Every day, Yannick offers you home-made takeaway meals: starters (raw vegetables, soups, salads according to the season), fresh meat or fish, side dishes, desserts (tarts, cakes, fruit mousses...), cold meats, wines..."
    ],
    "it": [
      "Ogni giorno, Yannick vi offre pasti da asporto fatti in casa: antipasti (verdure crude, zuppe, insalate a seconda della stagione), carne o pesce freschi, contorni, dolci (crostate, torte, mousse di frutta...), salumi, vini..."
    ],
    "fr": [
      "Chaque jour, Yannick vous propose des plats à emporter entièrement faits maison: entrée (crudités, soupes, salades selon les saisons), viande ou poissons frais, accompagnements, desserts (tartes, gâteaux, mousses de fruits...), charcuterie, vins..."
    ],
    "es": [
      "Todos los días, Yannick le ofrece comidas caseras para llevar: entrantes (verduras crudas, sopas, ensaladas según la temporada), carne o pescado fresco, guarniciones, postres (tartas, pasteles, mousses de frutas...), embutidos, vinos..."
    ],
    "nl": [
      "Elke dag biedt Yannick je huisbereide meeneemgerechten: voorgerechten (rauwkost, soepen, salades afhankelijk van het seizoen), vers vlees of vis, bijgerechten, nagerechten (taarten, cakes, fruitmousses...), vleeswaren, wijnen..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez Yann"
    ],
    "fr": [
      "Chez Yann"
    ]
  },
