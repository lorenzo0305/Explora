  "rdfs:comment": {
    "de": [
      "Erleben Sie mit Ihrer Familie oder Ihren Freunden die besten Schützen Europas.\r\n\r\n Wettkämpfer: ein Parcours mit 30 Schüssen pro Teilnehmer rund um das Museum\r\n\r\nZuschauer: Sehen Sie sich diese Schießwettbewerbe mit prähistorischen Waffen an und genießen Sie die Animationen."
    ],
    "en": [
      "Come and discover Europe's best shooters with your family or friends.\r\n\r\n Competitors: a course of 30 shots per participant around the museum\r\n\r\nSpectators: come and watch these prehistoric weapons shooting competitions, and enjoy the entertainment."
    ],
    "it": [
      "Venite a scoprire i migliori tiratori d'Europa con la vostra famiglia o i vostri amici.\r\n\r\n Concorrenti: un percorso di 30 tiri per partecipante intorno al museo\r\n\r\nSpettatori: venite a vedere queste gare di tiro con armi preistoriche e godetevi l'intrattenimento."
    ],
    "fr": [
      "Venez découvrir en famille ou entre amis, les meilleurs tireurs européens. \r\n\r\n Compétiteurs : un parcours de 30 tirs par participant autour du musée\r\n\r\nSpectateurs : venez assister à ces épreuves de tir aux armes préhistoriques, et profitez des animations."
    ],
    "es": [
      "Venga a descubrir los mejores tiradores de Europa con su familia o amigos.\r\n\r\n Competidores: un recorrido de 30 disparos por participante alrededor del museo\r\n\r\nEspectadores: venga a presenciar estas competiciones de tiro con armas prehistóricas y disfrute del espectáculo."
    ],
    "nl": [
      "Kom en ontdek de beste schutters van Europa met je familie of vrienden.\r\n\r\n Deelnemers: een parcours van 30 schoten per deelnemer rond het museum\r\n\r\nToeschouwers: kom kijken naar deze schietwedstrijden met prehistorische wapens en geniet van het entertainment."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Championnat européen de tir aux armes préhistoriques"
    ]
  },
