  "rdfs:comment": {
    "de": [
      "Guy Tournier ist Maler aus Valence und leitet ein Kunstatelier in Montmeyran. Als Mitglied der Société des Peintres de Montagne stellt er seine Aquarelle und Bergbilder aus und arbeitet auch mit Stillleben und Landschaften aus seiner Heimatregion Drôme."
    ],
    "en": [
      "A painter from Valence, Guy Tournier runs a workshop in Montmeyran. A member of the Société des Peintres de Montagne (Society of Mountain Painters), he exhibits his watercolors and mountain paintings, and also works on still life and landscapes from his Drôme region."
    ],
    "it": [
      "Pittore della regione di Valence, Guy Tournier gestisce un laboratorio artistico a Montmeyran. Membro della Société des Peintres de Montagne (Società dei pittori di montagna), espone i suoi acquerelli e i suoi dipinti di montagna, ma lavora anche su nature morte e paesaggi della sua regione natale, la Drôme."
    ],
    "fr": [
      "Artiste peintre valentinois, Guy Tournier anime un atelier artistique à Montmeyran. Membre de la Société des Peintres de Montagne, il expose ses aquarelles et peintures de montagne et travaille aussi la nature morte et le paysage de sa région de la Drôme."
    ],
    "es": [
      "Pintor de la región de Valence, Guy Tournier dirige un taller de arte en Montmeyran. Miembro de la Société des Peintres de Montagne (Sociedad de Pintores de Montaña), expone sus acuarelas y pinturas de montaña, así como bodegones y paisajes de su región natal, la Drôme."
    ],
    "nl": [
      "Guy Tournier is een schilder uit de regio Valence en heeft een atelier in Montmeyran. Hij is lid van de Société des Peintres de Montagne (Vereniging van Bergschilders) en exposeert zijn aquarellen en bergschilderijen en werkt ook aan stillevens en landschappen uit zijn thuisregio de Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atelier des Trois Couleurs Guy TOURNIER"
    ]
  },
