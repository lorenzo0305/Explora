  "rdfs:comment": {
    "de": [
      "Die Mediathek bietet 30 000 Medien für alle Altersgruppen: Bücher, Comics, Zeitschriften, CD-Audios, CD-ROMs und DVDs. Sie ist mit den Mediatheken in Veyrins-Thuellin und Corbelin vernetzt."
    ],
    "en": [
      "The multimedia library boasts a collection of 30,000 items for all ages: books, comics, magazines, audio CDs, CD-Roms and DVDs. It networks with the libraries of Veyrins-Thuellin and Corbelin."
    ],
    "it": [
      "La mediateca dispone di 30.000 articoli per tutte le età: libri, fumetti, riviste, CD audio, CD-ROM e DVD. Opera in rete con le biblioteche di Veyrins-Thuellin e Corbelin."
    ],
    "fr": [
      "La médiathèque c'est 30 000 documents pour tous les âges : livres, bandes-dessinées, revues, cd-audio, cédéroms, et DVD. Elle fonctionne en réseau avec celles de Veyrins-Thuellin et Corbelin."
    ],
    "es": [
      "La mediateca cuenta con 30.000 ejemplares para todas las edades: libros, cómics, revistas, CD de audio, CD-ROM y DVD. Funciona en red con las bibliotecas de Veyrins-Thuellin y Corbelin."
    ],
    "nl": [
      "De mediatheek heeft 30.000 items voor alle leeftijden: boeken, strips, tijdschriften, audio-cd's, cd-roms en dvd's. Ze werkt in een netwerk met de bibliotheken in Veyrins-Thuellin en Corbelin."
    ]
  },
