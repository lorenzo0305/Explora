  "rdfs:comment": {
    "de": [
      "Arnaud Trivella ist stolz darauf, Sie beim Fliegen über Morzine oder beim Wandern zu begleiten, um die schönsten Landschaften unserer Berge zu bewundern."
    ],
    "en": [
      "Arnaud Trivella is proud to take you on a flight in the skies over Morzine or on a hike to discover the most beautiful landscapes of our mountain region."
    ],
    "it": [
      "Arnaud Trivella è orgoglioso di portarvi a sorvolare Morzine o a fare un'escursione per ammirare i più bei paesaggi delle nostre montagne."
    ],
    "fr": [
      "Arnaud Trivella est fière de vous emmener voler au-dessus de Morzine ou en randonnée pour admirer les plus beaux paysage de nos montagnes."
    ],
    "es": [
      "Arnaud Trivella se enorgullece de llevarle a sobrevolar Morzine o a hacer senderismo para admirar los paisajes más bellos de nuestras montañas."
    ],
    "nl": [
      "Arnaud Trivella is er trots op om je mee te nemen op een vliegreis boven Morzine of op een wandeltocht om de mooiste landschappen in onze bergen te bewonderen."
    ]
  },
  "rdfs:label": {
