  "rdfs:comment": {
    "de": [
      "100% hausgemacht, Qualitätsprodukte, in Zusammenarbeit mit unserem Metzger, unserem Bäcker und unserem Gemüsehändler. Wir bringen das zu 100 % lokale Know-how zur Geltung. Wir bieten Ihnen eine reichhaltige Speisekarte mit Menüs für den kleinen Hunger: Burger, Bagel, Box."
    ],
    "en": [
      "100% home-made, quality products, in collaboration with our butcher, baker and greengrocer. We emphasize 100% local know-how. We offer a menu rich in menus and snacks: burger, bagel, box."
    ],
    "it": [
      "prodotti 100% fatti in casa e di qualità, in collaborazione con il nostro macellaio, panettiere e fruttivendolo. Promuoviamo il know-how locale al 100%. Offriamo un'ampia gamma di menu e snack: hamburger, bagel, box."
    ],
    "fr": [
      "100% fait maison, des produits de qualités, en collaboration avec notre boucher, notre boulanger et notre primeur. Nous mettons en valeur le savoir-faire 100% local. Nous vous proposons une carte riche en menus et petites faims : burger, bagel, box."
    ],
    "es": [
      "productos 100% caseros y de calidad, en colaboración con nuestro carnicero, panadero y frutero. Promovemos el saber hacer 100% local. Ofrecemos una amplia gama de menús y bocadillos: hamburguesa, bagel, caja."
    ],
    "nl": [
      "100% zelfgemaakte kwaliteitsproducten, in samenwerking met onze slager, bakker en groenteboer. We promoten 100% lokale knowhow. We bieden een breed scala aan menu's en snacks: hamburger, bagel, box."
    ]
  },
