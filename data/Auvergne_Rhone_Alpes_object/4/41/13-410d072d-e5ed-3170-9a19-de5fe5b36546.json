  "rdfs:comment": {
    "de": [
      "Am Rande des Bossons-Gletschers gelegen, öffnet dieses sympathische Chalet mit seiner blumengeschmückten Terrasse den Blick für das grandiose Schauspiel der zerbrochenen Seracs und der unergründlichen Gletscherspalten."
    ],
    "en": [
      "Located on the edge of the Bossons Glacier, this friendly chalet with its flowered terrace opens your eyes to the grandiose spectacle of broken seracs and unfathomable crevasses."
    ],
    "it": [
      "Situato ai margini del Ghiacciaio dei Bossons, questo accogliente chalet con la sua terrazza fiorita apre gli occhi sul grandioso spettacolo di seracchi spezzati e crepacci insondabili."
    ],
    "fr": [
      "Situé aux abords du Glacier des Bossons, ce sympathique chalet avec sa terrasse fleurie ouvre le regard au spectacle grandiose des séracs brisés et des crevasses insondables."
    ],
    "es": [
      "Situado al borde del glaciar de Bossons, este acogedor chalet con su terraza llena de flores le abre los ojos al grandioso espectáculo de seracs rotos y grietas insondables."
    ],
    "nl": [
      "Gelegen aan de rand van de Bossons-gletsjer, opent dit vriendelijke chalet met een bloemrijk terras uw ogen voor het grandioze schouwspel van gebroken seracs en onpeilbare kloven."
    ]
  },
