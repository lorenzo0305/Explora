  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes, in unmittelbarer Nähe des Gemeindeplatzes: Spielmöglichkeiten, Petanque und Tischtennis. Kürzlich restaurierter Saal mit Platz für 150 Personen."
    ],
    "en": [
      "In the center of the village, right next to the village square: games, pétanque and ping pong available. Recently restored hall for 150 people."
    ],
    "it": [
      "Nel centro del villaggio, proprio accanto alla piazza del paese: giochi, pétanque e ping pong a disposizione. Sala recentemente restaurata con capacità di 150 persone."
    ],
    "fr": [
      "Au centre du village, à proximité immédiate de la place communale : possibilité de jeux, pétanque et ping pong. Salle récemment restaurée, pouvant accueillir 150 personnes."
    ],
    "nl": [
      "In het centrum van het dorp, direct naast het dorpsplein: spelletjes, petanque en tafeltennis beschikbaar. Onlangs gerestaureerde zaal met capaciteit voor 150 personen."
    ],
    "es": [
      "En el centro del pueblo, justo al lado de la plaza del pueblo: juegos, petanca y tenis de mesa disponibles. Sala recientemente restaurada con capacidad para 150 personas."
    ]
