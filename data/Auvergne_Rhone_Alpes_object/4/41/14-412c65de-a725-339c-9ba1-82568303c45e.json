      "dc:description": {
        "de": [
          "Baby Gym\nZwischen 10 und 12 Uhr im Salon Escoffier\nFür Kinder von 0-4 Jahren\n5 Euro pro Kind\nAnmeldungen sind unbedingt erforderlich im Büro der Touristeninformation: 03 21 83 51 02"
        ],
        "en": [
          "Baby Gym\nBetween 10am and 12pm at Salon Escoffier\nFor 0-4 year-olds\n5 euros per child\nRegistration essential at the tourist information office: 03 21 83 51 02"
        ],
        "it": [
          "Palestra per bambini\nTra le 10.00 e le 12.00 presso il Salon Escoffier\nPer bambini da 0 a 4 anni\n5 euro a bambino\nIscrizione obbligatoria presso l'ufficio informazioni turistiche: 03 21 83 51 02"
        ],
        "fr": [
          "Baby Gym\nEntre 10h et 12h au Salon Escoffier \nPour les 0-4 ans\n5 euros par enfant \nInscriptions indispensables au bureau d'information touristique : 03 21 83 51 02"
        ],
        "es": [
          "Gimnasia para bebés\nEntre las 10h y las 12h en el Salón Escoffier\nPara niños de 0 a 4 años\n5 euros por niño\nInscripción obligatoria en la oficina de turismo: 03 21 83 51 02"
        ],
        "nl": [
          "Baby gym\nTussen 10 en 12 uur in de Salon Escoffier\nVoor kinderen van 0-4 jaar\n5 euro per kind\nInschrijving verplicht bij het toeristenbureau: 03 21 83 51 02"
        ]
      },
