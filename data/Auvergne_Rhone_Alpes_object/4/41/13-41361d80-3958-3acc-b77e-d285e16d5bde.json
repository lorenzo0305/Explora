  "rdfs:comment": {
    "de": [
      "Allgemeine und besondere Buchhandlung. Literatur aller Art, Comics, Alben und Jugendromane, Poesie, aber auch praktische Bücher, Kochbücher, Fotografie, Soziologie, Philosophie, Geschichte... und ein wenig gebrauchte Bücher"
    ],
    "en": [
      "Bookshop selling new and used books. Literature of all kinds, comics, children's books and novels, poetry, but also practical books, cookery, photography, social studies, philosophy, history, etc."
    ],
    "it": [
      "Libreria generale e speciale. Letteratura di ogni genere, fumetti, libri e romanzi per bambini, poesia, ma anche libri pratici, cucina, fotografia, studi sociali, filosofia, storia... e una piccola selezione di libri di seconda mano"
    ],
    "fr": [
      "Librairie Généraliste et Particulière. Littérature en tout genres, Bandes Dessinées, albums et romans jeunesse, Poésie, mais aussi livres pratiques, cuisine, photo, socio, philo, histoire... et un petit peu de livres d'occasion"
    ],
    "es": [
      "Librería general y especializada. Literatura de todo tipo, cómics, libros y novelas infantiles, poesía, pero también libros prácticos, de cocina, fotografía, estudios sociales, filosofía, historia... y una pequeña selección de libros de segunda mano"
    ],
    "nl": [
      "Algemene en speciale boekhandel. Allerlei soorten literatuur, strips, kinderboeken en romans, poëzie, maar ook praktische boeken, kookboeken, fotografie, sociale studies, filosofie, geschiedenis... en een kleine selectie tweedehands boeken"
    ]
  },
