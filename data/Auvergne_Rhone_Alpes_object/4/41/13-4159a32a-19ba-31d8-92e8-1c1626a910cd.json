  "rdfs:comment": {
    "de": [
      "Nordic Team befindet sich auf den Hochebenen von Aubrac im Herzen des Skigebiets von Saint-Urcize. Sie können\r\njulien, einen professionellen Musher mit 29 Hunden, der seine Leidenschaft mit Ihnen teilen wird."
    ],
    "en": [
      "Nordic Team is located on the high Aubrac Plateaux in the heart of the Saint-Urcize ski resort. Here you can\r\nmeet Julien, a qualified professional musher and his 29 dogs, who will be delighted to share his passion with you."
    ],
    "it": [
      "Il Nordic Team ha sede sugli altopiani di Aubrac, nel cuore della stazione sciistica di Saint-Urcize. Qui potrete\r\nincontrare Julien, un musher professionista qualificato e i suoi 29 cani, che sarà lieto di condividere con voi la sua passione."
    ],
    "fr": [
      "Nordic Team est implanté sur les hauts Plateaux de l’Aubrac au cœur de la station de ski de Saint-Urcize. Vous pouvez\r\nretrouver Julien, musher professionnel diplômé et ses 29 chiens qui se fera un plaisir de vous partager sa passion."
    ],
    "es": [
      "Nordic Team tiene su sede en el altiplano de Aubrac, en el corazón de la estación de esquí de Saint-Urcize. Aquí podrá\r\nconocer a Julien, musher profesional cualificado, y a sus 29 perros, que estarán encantados de compartir su pasión con usted."
    ],
    "nl": [
      "Nordic Team is gevestigd op het hoogplateau van Aubrac, in het hart van het skigebied van Saint-Urcize. Hier kunt u\r\nkennismaken met Julien, een gediplomeerde professionele musher en zijn 29 honden, die met veel plezier zijn passie met je zullen delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nordic Team Musher"
    ]
  },
