  "rdfs:comment": {
    "de": [
      "Wunderschöne Enduro-Strecke, die im Herzen des Waldes von Montchavin liegt. Technische Passagen, Haarnadeln und \"Pif-paf\" nach Belieben werden Adrenalinjunkies begeistern."
    ],
    "en": [
      "A magnificent enduro route nestled in the heart of the Montchavin forest. Technical sections, hairpins and pif-pafs galore will delight adrenalin junkies."
    ],
    "it": [
      "Un magnifico percorso di enduro immerso nel cuore della foresta del Montchavin. Tratti tecnici, tornanti e curve a gomito a volontà faranno la gioia degli amanti dell'adrenalina."
    ],
    "fr": [
      "Magnifique itinéraire enduro niché au cœur de la forêt de Montchavin. Passages techniques, épingles et « pif-paf » à volonté raviront les admirateurs d’adrénaline."
    ],
    "es": [
      "Un magnífico recorrido de enduro en pleno bosque de Montchavin. Secciones técnicas, horquillas y pif-pafs en abundancia harán las delicias de los amantes de la adrenalina."
    ],
    "nl": [
      "Een prachtige enduro-route in het hart van het bos van Montchavin. Technische secties, haarspeldbochten en pif-pafs in overvloed zullen adrenalinejunkies verrukken."
    ]
  },
  "rdfs:label": {
