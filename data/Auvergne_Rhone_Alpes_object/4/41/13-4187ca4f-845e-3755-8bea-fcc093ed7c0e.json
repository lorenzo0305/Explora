  "rdfs:comment": {
    "de": [
      "Das 133 ist wie ein Privatstrand gestaltet und empfängt Sie für Afterwork-Partys, Aperitifs, Cocktails, Wein- und Champagnerbars. Beheizter Jacuzzi, Veranstaltungen...\r\nRund um den Pool, in einem 2 ha großen Park mit Liegestühlen, Sofas und Lounge-Sesseln."
    ],
    "en": [
      "Imagine a private beach…the 133 welcomes you around the swimming pool in the Château des Ayes, set in 2 hectares of grounds, with sun beds, sofas and armchairs, a cocktail, wine and champagne bar, ice-creams, smoothies, and breakfast from 8am"
    ],
    "it": [
      "Concepito come una spiaggia privata, il 133 vi accoglie per afterwork, aperitivi, cocktail, wine e champagne bar. Jacuzzi riscaldata, eventi...\r\nIntorno alla piscina, in un parco di 2 ettari con sdraio, divani e sedie a sdraio."
    ],
    "fr": [
      "Pensé à l'image d'une plage privée, le 133 vous accueille pour des afterworks, apéritifs, cocktails, bar à vin et champagne. Jacuzzi chauffé, événements...\r\nAutour de la piscine, dans un parc de 2ha avec transats, canapés et fauteuils lounge."
    ],
    "es": [
      "Diseñado como una playa privada, el 133 le da la bienvenida para afterworks, aperitivos, cócteles, bar de vinos y champán. Jacuzzi climatizado, eventos...\r\nAlrededor de la piscina, en un parque de 2 hectáreas con tumbonas, sofás y sillones."
    ],
    "nl": [
      "De 133 is ontworpen als een privéstrand en verwelkomt u voor afterworks, aperitieven, cocktails, wijn- en champagnebar. Verwarmde jacuzzi, evenementen...\r\nRondom het zwembad, in een park van 2ha met ligstoelen, banken en loungestoelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "133 bar plage lounge"
    ]
  },
