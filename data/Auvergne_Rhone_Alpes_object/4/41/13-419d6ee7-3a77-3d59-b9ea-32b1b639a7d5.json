  "rdfs:comment": {
    "de": [
      "Die Skilehrer und Skilehrerinnen der ESF von Les Contamines bieten Ihnen den ganzen Winter über Kurse für Alpinski, Snowboard, klassischen und Skating-Langlauf... aber auch Telemark, Skifahren abseits der Pisten, Skitouren..."
    ],
    "en": [
      "The ESF French Ski School in Les Contamines boasts 40 permanent instructors and seven different activities in the winter season: skiing, snowboarding, classic cross-country  and skating, telemark, off-piste skiing and ski touring. An ideal opportunity to safely discover the ski area !"
    ],
    "it": [
      "I maestri dell'ESF di Les Contamines vi offrono per tutto l'inverno corsi di sci alpino, snowboard, sci di fondo classico e skating... ma anche telemark, sci fuori pista, sci alpinismo..."
    ],
    "fr": [
      "Les moniteurs et monitrices de l'ESF des Contamines vous proposent tout l'hiver des cours de ski alpin, snowboard, ski de fond classique et skating... mais aussi télémark, ski hors piste, ski de randonnée..."
    ],
    "es": [
      "Los monitores de la ESF de Les Contamines le ofrecen durante todo el invierno cursos de esquí alpino, snowboard, esquí de fondo clásico y de patinaje... pero también telemark, esquí fuera de pista, esquí de travesía..."
    ],
    "nl": [
      "De instructeurs van de ESF in Les Contamines bieden u de hele winter cursussen alpineskiën, snowboarden, klassiek en skating langlaufen... maar ook telemark, off-piste skiën, skitouren..."
    ]
  },
