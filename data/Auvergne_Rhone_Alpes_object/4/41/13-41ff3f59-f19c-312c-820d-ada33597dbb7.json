  "rdfs:comment": {
    "de": [
      "Auf Ihre Agenden! Die Stadt Montélimar veranstaltet ihren traditionellen Karneval! Zu diesem Anlass sind alle kleinen und großen Montilianer eingeladen, sich zu verkleiden und an dem Umzug durch die Innenstadt bis zum Kiosk im öffentlichen Garten teilzunehmen."
    ],
    "en": [
      "Mark your calendars! The town of Montélimar is organizing its traditional carnival! For the occasion, the young and old of Montélimar are invited to dress up and take part in the procession through the town center to the bandstand in the public gardens."
    ],
    "it": [
      "Segnate i vostri calendari! La città di Montélimar organizza il suo tradizionale carnevale! Per l'occasione, i giovani e gli anziani di Montélimar sono invitati a mascherarsi e a partecipare al corteo che attraversa il centro della città fino al palco della banda nei giardini pubblici."
    ],
    "fr": [
      "À vos agendas ! La Ville de Montélimar organise son traditionnel carnaval ! Pour l'occasion, les petits et grands montiliens sont invités à se déguiser et participer à la déambulation en centre-ville, jusqu'au kiosque du jardin public."
    ],
    "es": [
      "¡Marque su calendario! La ciudad de Montélimar organiza su tradicional carnaval Para la ocasión, se invita a los jóvenes y mayores de Montélimar a disfrazarse y participar en el desfile por el centro de la ciudad hasta el quiosco de música de los jardines públicos."
    ],
    "nl": [
      "Noteer uw agenda! De stad Montélimar organiseert haar traditionele carnaval! Voor de gelegenheid worden jong en oud van Montélimar uitgenodigd om zich te verkleden en deel te nemen aan de optocht door het stadscentrum naar de muziektent in de openbare tuinen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Carnaval de Montélimar - Edition 2026"
    ]
  },
