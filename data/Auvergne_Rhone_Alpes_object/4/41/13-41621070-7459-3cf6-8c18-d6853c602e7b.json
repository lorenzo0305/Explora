  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek verfügt über eine umfangreiche Sammlung von Kunstwerken, Büchern für Pädagogen, Text- und Musikkassetten etc. Internet und Wifi sind frei zugänglich. Ausstellungen, verschiedene Animationen."
    ],
    "en": [
      "The municipal library has an important collection of art books, books for educators, text and music cassettes, etc. The library has a large collection of art books, books for educators, text and music cassettes, etc. Internet and free wifi access. Exhibitions, various animations."
    ],
    "it": [
      "La biblioteca comunale dispone di un'ampia collezione di libri d'arte, libri per educatori, cassette di testo e musicali, ecc. Internet e wifi disponibili gratuitamente. Mostre, attività varie."
    ],
    "fr": [
      "La bibliothèque municipale possède une collection importante d’ouvrages d'art, ouvrages pour éducateurs, cassettes de textes et de musique, etc. Internet et wifi en libre accès. Expositions, animations diverses."
    ],
    "es": [
      "La biblioteca municipal cuenta con una amplia colección de libros de arte, libros para educadores, cintas de texto y música, etc. Internet y wifi de libre acceso. Exposiciones, actividades diversas."
    ],
    "nl": [
      "De gemeentelijke bibliotheek heeft een uitgebreide collectie kunstboeken, boeken voor opvoeders, tekst- en muziekcassettes, enz. Internet en wifi vrij beschikbaar. Tentoonstellingen, diverse activiteiten."
    ]
