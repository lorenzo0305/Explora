      "dc:description": {
        "de": [
          "Ihr Experte für die Reparatur und den Austausch von Autoglas.\nVertrauen Sie Ihr Fahrzeug unserem Chef de Centre Matthieu an, um die Windschutzscheibe Ihres Autos zu ersetzen!"
        ],
        "en": [
          "Your expert in auto glass repair and replacement.\nEntrust your vehicle to our Matthieu Center Manager for windshield replacement!"
        ],
        "it": [
          "Il vostro esperto in riparazione e sostituzione di vetri per auto.\nAffidate il vostro veicolo al nostro responsabile del centro Matthieu per la sostituzione del parabrezza!"
        ],
        "fr": [
          "Votre Expert en réparation et remplacement de vitrage automobile. \nConfiez votre véhicule à notre Chef de centre Matthieu pour le remplacement du pare-brise de votre voiture !"
        ],
        "nl": [
          "Uw expert in reparatie en vervanging van autoruiten.\nVertrouw de vervanging van uw voorruit toe aan onze Matthieu Centre Manager!"
        ],
        "es": [
          "Su experto en reparación y sustitución de lunas de automóvil.\nConfíe la sustitución de su parabrisas a nuestro responsable del Centro Matthieu"
        ]
      },
