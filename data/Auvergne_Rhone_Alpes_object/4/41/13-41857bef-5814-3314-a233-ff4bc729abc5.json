  "rdfs:comment": {
    "de": [
      "Gilles HOUPEAU ist ein Kunsthandwerksmeister, der Inneneinrichtungen aus Holz entwirft und herstellt, damit Ihre Innenräume authentisch, einzigartig und warm bleiben. Entdecken Sie unsere Inneneinrichtungen: Ferienwohnungen, Schlafzimmer, Wohnzimmer, Möbel, Geschäfte, Bibliotheken..."
    ],
    "en": [
      "Gilles HOUPEAU is a Master Craftsman who creates and crafts wood interiors to ensure that your interior space remains authentic, unique and warm. Interiors to discover: gîtes, bedrooms, living rooms, furniture, stores, libraries..."
    ],
    "it": [
      "Gilles HOUPEAU è un Maestro Artigiano che progetta e crea interni in legno per garantire che i vostri interni rimangano autentici, unici e caldi. Interni da scoprire: gîtes, camere da letto, salotti, mobili, negozi, biblioteche..."
    ],
    "fr": [
      "Gilles HOUPEAU est un Maître Artisan d'Art qui crée et réalise des Intérieurs en Bois pour que votre espace intérieur demeure authentique, unique et chaleureux. Intérieurs à découvrir: gîtes, chambres, séjours, meubles, magasin, bibliothèques..."
    ],
    "nl": [
      "Gilles HOUPEAU is een meester-ambachtsman die houten interieurs ontwerpt en creëert om ervoor te zorgen dat uw interieur authentiek, uniek en warm blijft. Te ontdekken interieurs: gîtes, slaapkamers, woonkamers, meubels, winkels, bibliotheken..."
    ],
    "es": [
      "Gilles HOUPEAU es un Maestro Artesano que diseña y crea interiores de madera para que su interior siga siendo auténtico, único y cálido. Interiores por descubrir: casas rurales, dormitorios, salones, muebles, tiendas, bibliotecas..."
    ]
  },
