  "rdfs:comment": {
    "de": [
      "Verkauf von Kuh- und Ziegenmilchprodukten, Freilandeiern, Saisongemüse aus den Jardins du Badel, Fleisch vom Bauernhof, Wurstwaren, Honig, lokale Fruchtsäfte..."
    ],
    "en": [
      "Sale of cow and goat dairy products, free-range eggs, seasonal vegetables from the Jardins du Badel, farmhouse meats, cold cuts, honey, local fruit juices..."
    ],
    "it": [
      "Vendita di prodotti lattiero-caseari di mucca e capra, uova da allevamento all'aperto, verdure di stagione dei Jardins du Badel, carni di fattoria, salumi, miele, succhi di frutta locali..."
    ],
    "fr": [
      "Vente de produits laitiers vache et chèvre, œufs de plein air, légumes de saison des Jardins du Badel, viandes de la ferme, charcuterie, miel, jus de fruits locaux..."
    ],
    "nl": [
      "Verkoop van zuivelproducten van koeien en geiten, eieren met vrije uitloop, seizoensgroenten uit de Jardins du Badel, vlees van de boerderij, vleeswaren, honing, lokale vruchtensappen..."
    ],
    "es": [
      "Venta de productos lácteos de vaca y cabra, huevos de corral, verduras de temporada de los Jardines del Badel, carnes de granja, charcutería, miel, zumos de frutas locales..."
    ]
  },
