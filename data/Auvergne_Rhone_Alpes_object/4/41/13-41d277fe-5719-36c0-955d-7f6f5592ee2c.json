  "rdfs:comment": {
    "de": [
      "Der Bereich bietet Ihnen eine Vielzahl von Aktivitäten: olympische Eisbahn, Curlingbahn, Multisporthalle, Fitnessraum, Spa, Schwimmbad und Rutsche, Billard, Bowling und Bar. Er ist sowohl in der Winter- als auch in der Sommersaison geöffnet."
    ],
    "en": [
      "The recreation center offers a wide variety of activities to enjoy: a pool with a water slide, curling, an ice rink, a wellness center, a fitness center, billiards, bowling; and bar. Open in both summer and winter."
    ],
    "it": [
      "Il centro offre una serie di attività, tra cui una pista di ghiaccio olimpionica, una pista di curling, una sala polisportiva, una sala fitness, una spa, una piscina e uno scivolo, un biliardo, una pista da bowling e un bar. Aperto in inverno e in estate."
    ],
    "fr": [
      "L'espace vous propose une multitude d'activités : patinoire olympique, piste de curling, salle multisports, salle de fitness, spa, piscine et toboggan, billard, bowling et bar. Il est ouvert en saison d'hiver et d'été."
    ],
    "es": [
      "La zona propone multitud de actividades: pista de hielo olímpica, pista de curling, sala polideportiva, sala de fitness, spa, piscina y tobogán, billar, bolera y bar. Abierto en temporada de invierno y verano."
    ],
    "nl": [
      "Het centrum biedt tal van activiteiten, waaronder een ijsbaan van olympisch formaat, curlingbaan, multisporthal, fitnessruimte, spa, zwembad en waterglijbaan, biljart, bowlingbaan en bar. Geopend in de winter en de zomer."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Cristal - Vanoise Sports and Recreation Center"
    ],
    "fr": [
      "Le Cristal - Centre sportif de la Vanoise"
    ],
    "es": [
      "Le Cristal, centro deportivo de la Vanoise"
    ]
  },
