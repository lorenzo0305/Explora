  "rdfs:comment": {
    "de": [
      "Die Ausgabe 2026 des ökologischen Fotofestivals Picture For Nature kehrt vom 22. bis 24. Mai 2026 in das Theater von Cusset zurück. Rund 150 Fotografien werden auf einem umweltfreundlichen Medium präsentiert: einem Papier aus 100% recycelter und \"hausgemachter\" Baumwolle."
    ],
    "en": [
      "The 2026 edition of the ecological photography festival Picture For Nature returns to the Théâtre de Cusset from May 22 to 24, 2026. Nearly 150 photographs will be presented on an ecological medium: 100% recycled cotton paper."
    ],
    "it": [
      "L'edizione 2026 del festival di fotografia ecologica Picture For Nature torna al Théâtre de Cusset dal 22 al 24 maggio 2026. Circa 150 fotografie saranno presentate su carta ecologica realizzata al 100% con cotone riciclato."
    ],
    "fr": [
      "L’édition 2026 du festival écologique de photographie Picture For Nature est de retour au Théâtre de Cusset du 22 au 24 mai 2026. Près de 150 photographies seront présentées sur un support écologique : un papier 100% coton recyclé et « maison »."
    ],
    "es": [
      "La edición 2026 del festival de fotografía ecológica Picture For Nature vuelve al Théâtre de Cusset del 22 al 24 de mayo de 2026. Se presentarán cerca de 150 fotografías en papel ecológico fabricado con algodón 100% reciclado."
    ],
    "nl": [
      "De editie 2026 van het ecologische fotografiefestival Picture For Nature is terug in het Théâtre de Cusset van 22 tot 24 mei 2026. Bijna 150 foto's zullen worden gepresenteerd op milieuvriendelijk papier gemaakt van 100% gerecycled katoen."
    ]
  },
  "rdfs:label": {
