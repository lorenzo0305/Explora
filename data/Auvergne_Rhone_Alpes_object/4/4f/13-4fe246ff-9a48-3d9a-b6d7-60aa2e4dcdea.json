  "rdfs:comment": {
    "de": [
      "Im Dorf Allex zeugt die außergewöhnliche Sammlung afrikanischer Kunst des MUSAA von den Traditionen und Glaubensvorstellungen der Menschen im äquatorialen Afrika von einst. Geführte Besichtigungen, ein Rätselspiel oder ein Märchen für Kinder begleiten die Entdeckung..."
    ],
    "en": [
      "In the village of Allex, the Spiritan Museum of African Arts (MUSAA) is an exceptional testimony to the life, traditions and beliefs of the people of Equatorial Africa. The tale of Binda accompanies children in the discovery."
    ],
    "it": [
      "Visita guidata al Museo d'arte africana, inaugurato nel 2018. Filmato di presentazione, percorso di visita, gioco di fuga per i giovani."
    ],
    "fr": [
      "Visite commentée du Musée d'Art Africain ouvert en 2018. Film de présentation, parcours de visite, escape game pour les jeunes."
    ],
    "es": [
      "Visita guiada al Museo de Arte Africano, inaugurado en 2018. Película de presentación, recorrido turístico, juego de escape para jóvenes."
    ],
    "nl": [
      "In het dorp Allex getuigt de uitzonderlijke collectie Afrikaanse kunst van het MUSAA van de tradities en het geloof van de mensen van equatoriaal Afrika in lang vervlogen tijden. Rondleidingen, raadselspelletjes en kinderverhalen begeleiden de ontdekking..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Découverte du musée d'art africain d'Allex"
    ]
  },
