  "rdfs:comment": {
    "de": [
      "Das EST (Espace Scénique Transdisciplinaire) ist die zweite kulturelle Einrichtung der Universität Grenoble Alpes.\r\nEr umfasst einen Veranstaltungssaal mit 150 Plätzen, ein 150 m2 großes Probestudio und drei 50 m2 große Studios."
    ],
    "en": [
      "EST (Espace Scénique Transdisciplinaire) is the second cultural facility of Grenoble Alpes University.\r\nIt comprises an auditorium 150-seat auditorium, a 150 m2 rehearsal studio  and three 50 m2 rehersal studios."
    ],
    "it": [
      "L'EST (Espace Scénique Transdisciplinaire) è la seconda struttura culturale dell'Università di Grenoble Alpes.\r\nComprende un auditorium da 150 posti, una sala prove di 150 m2 e tre studi di 50 m2."
    ],
    "fr": [
      "L’EST (Espace Scénique Transdisciplinaire) est le second équipement culturel de l’Université Grenoble Alpes.\r\nIl comprend une salle de spectacle de 150 places, un studio de répétition de 150 m2 et trois studios de 50 m2."
    ],
    "es": [
      "El EST (Espace Scénique Transdisciplinaire) es el segundo equipamiento cultural de la Universidad de Grenoble Alpes.\r\nConsta de un auditorio de 150 plazas, una sala de ensayos de 150 m2 y tres estudios de 50 m2."
    ],
    "nl": [
      "EST (Espace Scénique Transdisciplinaire) is de tweede culturele faciliteit van de universiteit van Grenoble Alpes.\r\nHet bestaat uit een auditorium met 150 zitplaatsen, een repetitiestudio van 150 m2 en drie studio's van 50 m2."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'EST  - salle de spectacle Université Grenoble Alpes"
    ]
  },
