  "rdfs:comment": {
    "de": [
      "Hallenbad mit 25m×10m großem Schwimmbecken (4 Reihen), Tiefe 40cm bis 1,80m. Angrenzendes Planschbecken. Ausgestattet für Aquabike und zugänglich für Personen mit eingeschränkter Mobilität (Galgen). Animationen während der Schulferien. Badehose und Badekappe sind Pflicht."
    ],
    "en": [
      "Indoor pool 25m×10m (4 lines), depth 40cm to 1.80m. Adjoining paddling pool. Equipped for aquabike and handicapped access (gallows). School vacation activities. Bathing trunks and cap compulsory."
    ],
    "it": [
      "Piscina coperta, 25m x 10m (4 linee), profonda da 40cm a 1,80m. Piscina adiacente per bambini. Attrezzata per aquabike e accesso per disabili (forca). Attività durante le vacanze scolastiche. Costume e cuffia obbligatori."
    ],
    "fr": [
      "Piscine couverte avec bassin de 25m×10m (4 lignes), profondeur 40cm à 1,80m. Pataugeoire attenante. Équipée pour l'aquabike et accessible PMR (potence). Animations vacances scolaires. Slip de bain et bonnet obligatoires."
    ],
    "es": [
      "Piscina cubierta, 25 m x 10 m (4 líneas), de 40 cm a 1,80 m de profundidad. Piscina infantil adyacente. Equipada para aquabike y acceso para minusválidos (horca). Actividades durante las vacaciones escolares. Bañador y gorro obligatorios."
    ],
    "nl": [
      "Overdekt zwembad, 25m x 10m (4 lijnen), 40cm tot 1.80m diep. Aangrenzend peuterbad. Uitgerust voor aquabike en toegang voor gehandicapten (galgje). Activiteiten tijdens schoolvakanties. Badpak en badmuts verplicht."
    ]
  },
