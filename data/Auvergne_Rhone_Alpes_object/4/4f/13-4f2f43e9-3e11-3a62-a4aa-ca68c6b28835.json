  "rdfs:comment": {
    "de": [
      "Kurze Wege, lokale Produkte, hausgemachte Zubereitungen - das sind die Werte des Epicentre, mit einem Tagesgericht, Kuchen, Desserts, in einer freundlichen Atmosphäre, die bei wöchentlichen Veranstaltungen mit Kultur gewürzt wird."
    ],
    "en": [
      "Short supply chains, local produce, homemade preparations: these are the values of l'Épicentre, with a dish of the day, pies and desserts, in a convivial atmosphere spiced up with culture at weekly events."
    ],
    "it": [
      "Filiera corta, prodotti locali, piatti fatti in casa: questi sono i valori di Épicentre, con un piatto del giorno, torte e dessert, in un'atmosfera amichevole e condita di cultura durante gli eventi settimanali."
    ],
    "fr": [
      "Circuits courts, produits locaux, préparations faites maison, ce sont les valeurs de l'Épicentre, avec un plat du jour, des tartes, des desserts, dans une atmosphère conviviale pimentée de culture lors d'événements hebdomadaires."
    ],
    "nl": [
      "Korte toeleveringsketens, lokale producten, huisgemaakte gerechten - dat zijn de waarden van Épicentre, met een dagschotel, taarten en desserts, in een gezellige sfeer gekruid met cultuur tijdens wekelijkse evenementen."
    ],
    "es": [
      "Cadenas de suministro cortas, productos locales, platos caseros: estos son los valores de Épicentre, con un plato del día, tartas y postres, en un ambiente acogedor aderezado con cultura en los eventos semanales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Épicentre"
    ]
  },
