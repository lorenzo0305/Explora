  "rdfs:comment": {
    "de": [
      "In den Nebengebäuden des Château Dauphin Ausstellung (Dokumente, Werkzeuge, Modelle, Kristalle usw.) über die Gewinnung und Behandlung von silberhaltigem Bleierz (Bleiglanz). Geschichte, Bild, Rekonstruktion eines Bergwerkstollens."
    ],
    "en": [
      "In the grounds of the Dauphin Castle, an exhibition (documents, tools, models and crystals.....) relating to the extraction of lead silver. History, images and the reconstruction of a mine, history miners of Cornwalls."
    ],
    "it": [
      "Negli annessi di Château Dauphin, un'esposizione (documenti, strumenti, modelli, cristalli, ecc.) che racconta l'estrazione e la lavorazione del minerale di piombo argentato (galena). Storia, mineralogia, ricostruzione di una galleria mineraria, la prima turbina."
    ],
    "fr": [
      "Dans les communs du Château Dauphin, exposition (documents, outils, maquettes, cristaux...) relatant l'extraction, le traitement du minerai de plomb argentifère (galène). Historique, mineralogie, reconstitution d'une galerie de mine, la première Turbine."
    ],
    "nl": [
      "In de bijgebouwen van Château Dauphin een tentoonstelling (documenten, gereedschap, modellen, kristallen, enz.) over de winning en verwerking van zilverlooderts (galena). Geschiedenis, mineralogie, reconstructie van een mijngang, de eerste turbine."
    ],
    "es": [
      "En las dependencias del Château Dauphin, exposición (documentos, herramientas, maquetas, cristales, etc.) sobre la extracción y el tratamiento del mineral de plata-plomo (galena). Historia, mineralogía, reconstrucción de una galería minera, la primera turbina."
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum of Silver Mines"
    ],
    "fr": [
      "Musée des Mines d'Argent"
    ]
  },
