  "rdfs:comment": {
    "de": [
      "Nur einen Katzensprung von Grenoble entfernt, im Herzen des Pays Voironnais, empfängt Sie das Castel?Anne für alle Ihre Veranstaltungen. Genießen Sie den Charme eines Bürgerhauses aus dem 19. Jahrhundert, das von einem umzäunten Park mit Bäumen umgeben ist."
    ],
    "en": [
      "Just a stone's throw from Grenoble, in the heart of the Voironnais region, Le Castel?Anne welcomes you for all your events. Come and enjoy the charm of a 19th-century bourgeois house, surrounded by an enclosed park planted with trees."
    ],
    "it": [
      "A due passi da Grenoble, nel cuore della regione del Voironnais, Castel Anne vi accoglie per tutti i vostri eventi. Venite a godere del fascino di una dimora del XIX secolo circondata da un parco recintato."
    ],
    "fr": [
      "A deux pas de Grenoble, au cœur du Pays Voironnais, le Castel’Anne vous accueille pour tous vos événements. Venez profiter du charme d’une maison bourgeoise du 19 ème siècle, entourée d’un parc clos arboré."
    ],
    "nl": [
      "Op een steenworp van Grenoble, in het hart van de Voironnais-streek, verwelkomt Castel Anne u voor al uw evenementen. Kom genieten van de charme van een 19e-eeuws herenhuis omringd door een omheind park."
    ],
    "es": [
      "A dos pasos de Grenoble, en el corazón de la región de Voironnais, Castel'Anne le da la bienvenida para todos sus eventos. Venga a disfrutar del encanto de una mansión del siglo XIX rodeada de un parque cerrado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Castel'Anne"
    ]
  },
