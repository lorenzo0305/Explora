  "rdfs:comment": {
    "de": [
      "Das Netzwerk der Mediatheken Entre Dore et Allier bietet der Öffentlichkeit einen privilegierten Zugang zu Kultur, Wissen und Know-how, Information, Freizeit, neuen Technologien und Praktiken des kollektiven Teilens."
    ],
    "en": [
      "The intercommunal media library and its network offer the public a privileged access to the culture, information educa- tion, leisure, new technologies and more."
    ],
    "it": [
      "La rete di mediateche Entre Dore et Allier offre al pubblico un accesso privilegiato alla cultura, al sapere e al saper fare, all'informazione, alle attività del tempo libero, alle nuove tecnologie e alle pratiche di condivisione collettiva."
    ],
    "fr": [
      "Le réseau des médiathèques Entre Dore et Allier propose au public un accès privilégié à la culture, aux savoirs et savoir-faire, à l’information, aux loisirs, aux nouvelles technologies et aux pratiques de partage collectif."
    ],
    "es": [
      "La red de mediatecas de Entre Dore et Allier ofrece al público un acceso privilegiado a la cultura, al conocimiento y al saber, a la información, a las actividades de ocio, a las nuevas tecnologías y a las prácticas de intercambio colectivo."
    ],
    "nl": [
      "Het mediatheeknetwerk Entre Dore et Allier biedt het publiek bevoorrechte toegang tot cultuur, kennis en knowhow, informatie, vrijetijdsbesteding, nieuwe technologieën en collectieve uitwisselingspraktijken."
    ]
  },
