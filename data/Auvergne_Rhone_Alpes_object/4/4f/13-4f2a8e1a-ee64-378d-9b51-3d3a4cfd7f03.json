  "rdfs:comment": {
    "de": [
      "Willkommen bei C.Fitness Beynost mit seinen 3600 m², die Ihrem Wohlbefinden und Ihrer Gesundheit gewidmet sind. Unser Club stellt Ihnen moderne Geräte und Einrichtungen zur Verfügung. Wir erfüllen alle Ihre Bedürfnisse, egal ob Sie ein erfahrener Sportler oder ein Anfänger sind"
    ],
    "en": [
      "Welcome to C.Fitness Beynost with its 3600 m² dedicated to your well-being and health. Our club offers you modern equipment and facilities. We cater for all your needs, whether you're a seasoned athlete or a beginner"
    ],
    "it": [
      "Benvenuti al C.Fitness Beynost, con 3.600 m² dedicati alla vostra salute e al vostro benessere. Il nostro club vi offre attrezzature e strutture moderne. Ci occupiamo di tutte le vostre esigenze, sia che siate atleti esperti o principianti"
    ],
    "fr": [
      "Bienvenue chez C.Fitness Beynost avec ses 3600 m² dédiés à votre bien-être et à votre santé. Notre club met à votre disposition des équipements et installations modernes. Nous répondons à tous vos besoins que vous soyez un athlète chevronné ou un débutant"
    ],
    "nl": [
      "Welkom bij C.Fitness Beynost, met 3.600 m² gewijd aan jouw gezondheid en welzijn. Onze club biedt je moderne apparatuur en faciliteiten. We voldoen aan al je behoeften, of je nu een doorgewinterde sporter bent of een beginner"
    ],
    "es": [
      "Bienvenido a C.Fitness Beynost, con 3.600 m² dedicados a su salud y bienestar. Nuestro club le ofrece modernos equipos e instalaciones. Atendemos todas sus necesidades, tanto si es un deportista experimentado como un principiante"
    ]
  },
