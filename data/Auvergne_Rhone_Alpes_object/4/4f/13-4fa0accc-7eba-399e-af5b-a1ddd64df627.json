  "rdfs:comment": {
    "de": [
      "Entdecken Sie Satie in seinem Jahrhundert, ein einzigartiges Spektakel, bei dem Sie sich in die Welt des französischen Komponisten und Pianisten Érik Satie entführen lassen können. Ein Ereignis, das Sie nicht verpassen sollten!"
    ],
    "en": [
      "Discover Satie in his century, a unique show to transport you into the world of French composer and pianist Érik Satie. An event not to be missed!"
    ],
    "it": [
      "Scoprite Satie nel suo secolo, uno spettacolo unico che vi trasporterà nel mondo del compositore e pianista francese Érik Satie. Un evento da non perdere!"
    ],
    "fr": [
      "Découvrez Satie dans son siècle, un spectacle unique pour vous laisser transporter par l'univers du compositeur et pianiste français Érik Satie. Un événement à ne pas manquer !"
    ],
    "nl": [
      "Ontdek Satie in zijn eeuw, een unieke show die je meeneemt in de wereld van de Franse componist en pianist Érik Satie. Een evenement dat je niet mag missen!"
    ],
    "es": [
      "Descubra Satie en su siglo, un espectáculo único que le transportará al universo del compositor y pianista francés Érik Satie. ¡Un evento que no se puede perder!"
    ]
  },
  "rdfs:label": {
