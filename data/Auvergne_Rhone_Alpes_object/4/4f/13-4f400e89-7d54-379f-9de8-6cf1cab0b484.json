  "rdfs:comment": {
    "de": [
      "Die Jardiniers aux Marches du Velay organisieren ihren Pflanzenbasar im Maison des Associations (Haus der Vereine).\r\nAlle Privatpersonen können Gemüsepflanzen, Stecklinge, Stauden, Blumenzwiebeln und Samen tauschen"
    ],
    "en": [
      "Les Jardiniers aux Marches du Velay are holding their Plant Troc at the Maison des Associations.\r\nIndividuals can come and exchange vegetable plants, cuttings, perennial divisions, bulbs, seeds?"
    ],
    "it": [
      "Les Jardiniers aux Marches du Velay organizzano il loro scambio di piante presso la Maison des Associations.\r\nI privati possono venire a scambiare piante di ortaggi, talee, divisioni di piante perenni, bulbi, semi e altro ancora"
    ],
    "fr": [
      "Les Jardiniers aux Marches du Velay organise leur Troc aux Plantes à la Maison des Associations. \r\nChaque particulier peut venir échanger des plants de légumes, des boutures, des divisions de vivaces, des bulbes, des graines…"
    ],
    "es": [
      "Les Jardiniers aux Marches du Velay organizan un intercambio de plantas en la Maison des Associations.\r\nLos particulares podrán intercambiar plantas hortícolas, esquejes, divisiones de plantas vivaces, bulbos, semillas, etc"
    ],
    "nl": [
      "Les Jardiniers aux Marches du Velay houden hun plantenruil in het Maison des Associations.\r\nIndividuen kunnen langskomen om groenteplanten, stekken, vaste planten, bollen, zaden en nog veel meer te ruilen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Troc  Plantes"
    ]
  },
