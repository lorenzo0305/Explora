  "rdfs:comment": {
    "de": [
      "Entdecken Sie das beeindruckendste Viadukt der Region: das Belon-Viadukt, 400 m lang, 66 m hoch!\r\nEine unvergessliche Fahrt zwischen Lapeyrouse und Louroux-de-Bouble. Die Originalität einer \"Zugwanderung\": Hinfahrt mit dem Zug, Rückfahrt zu Fuß (oder umgekehrt)!"
    ],
    "en": [
      "Discover the region's most impressive viaduct: the Belon, 400 m long and 66 m high!\r\nAn unforgettable ride between Lapeyrouse and Louroux-de-Bouble. The originality of a \"train hike\": go by train, return on foot (or vice versa)!"
    ],
    "it": [
      "Scoprite il viadotto più impressionante della regione: il Belon, lungo 400 m e alto 66 m!\r\nUn viaggio indimenticabile tra Lapeyrouse e Louroux-de-Bouble. Un originale \"viaggio in treno\": andata in treno, ritorno a piedi (o viceversa)!"
    ],
    "fr": [
      "À la découverte du plus impressionnant viaduc de la région : le Belon, 400 m de long, 66 m de hauteur !\r\nUne balade inoubliable entre Lapeyrouse et Louroux-de-Bouble. L’originalité d’une « rando-train » : aller en train, retour à pied (ou l’inverse) !"
    ],
    "nl": [
      "Ontdek het meest indrukwekkende viaduct in de regio: de Belon, 400 m lang en 66 m hoog!\r\nEen onvergetelijke rit tussen Lapeyrouse en Louroux-de-Bouble. Een originele \"treinrit\": ga met de trein, keer te voet terug (of omgekeerd)!"
    ],
    "es": [
      "Descubra el viaducto más impresionante de la región: el Belon, ¡de 400 m de largo y 66 m de alto!\r\nUn paseo inolvidable entre Lapeyrouse y Louroux-de-Bouble. Un original \"paseo en tren\": ¡ir en tren, volver a pie (o viceversa)!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rando-Train Le Viaduc de La Bouble"
    ]
  },
