  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e3171b72-ebbf-3c81-9ed9-7372b3970393",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Backwaren und Konditoreiwaren.\n\nÖffnungszeiten:\n\nMontag bis Samstag: 5.30-13.00 Uhr / 16.00-19.00 Uhr\nSonntag: 5.30-12.30 Uhr\n\nDienstag geschlossen\n \n Bestellung :\nTelefonische Bestellung unter 03 21 73 19 62 möglich\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\n\n "
        ],
        "en": [
          "Information :\n\nProducts: bread, Viennese pastries and cakes.\n\nOpening days:\n\nMonday to Saturday: 5:30am-1pm / 4pm-7pm\nSunday: 5:30am-12:30pm\n\nClosed on Tuesday\n \n Ordering :\nOrder by phone 03 21 73 19 62\n\nCollection:\nTakeaway during bakery opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria viennese e torte.\n\nGiorni di apertura :\n\nDa lunedì a sabato: 5.30-13.00 / 16.00-19.00\nDomenica: 5.30-12.30\n\nChiuso il martedì\n \n Ordinazione :\nÈ possibile ordinare per telefono al numero 03 21 73 19 62\n\nRitiro:\nDa asporto durante gli orari di apertura della pasticceria\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: pains, vienoisseries et pâtisseries. \n\nJours d'ouverture : \n\nDu lundi au samedi: 5h30-13h / 16h-19h\nLe dimanche: 5h30-12h30\n\nFermeture le mardi\n \n Commande : \nPossibilité de commander par téléphone au 03 21 73 19 62\n\nRetrait :\nÀ emporter aux horaires d'ouverture de la boulangerie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, Weens gebak en taarten.\n\nOpeningsdagen :\n\nMaandag t/m zaterdag: 5.30-13.00 / 16.00-19.00\nZondag: 5.30-12.30 uur\n\nDinsdag gesloten\n \n Bestellen :\nJe kunt telefonisch bestellen op 03 21 73 19 62\n\nAfhalen:\nAfhalen tijdens de openingstijden van de bakkerij\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y pastelería.\n\nDías de apertura :\n\nDe lunes a sábado: de 5.30 a 13.00 h. / de 16.00 a 19.00 h\nDomingo: de 5.30 a 12.30 h\n\nMartes cerrado\n \n Pedidos :\nPuede hacer su pedido por teléfono llamando al 03 21 73 19 62\n\nRecogida:\nPara llevar durante el horario de apertura de la panadería\n\n "
        ]
      },
