  "rdfs:comment": {
    "de": [
      "Der Verein \"Je joue donc je suis, et je repioche\" bietet Ihnen spielerische Treffen rund um Gesellschaftsspiele in Chatuzange le Goubet in der Drôme an."
    ],
    "en": [
      "The association \"Je joue donc je suis, et je repioche\" (I play, therefore I am, and I'm back) offers you a series of playful meetings based around board games, in Chatuzange le Goubet, in the Drôme region."
    ],
    "it": [
      "L'associazione \"Je joue donc je suis, et je repioche\" (gioco quindi sono, e giocherò ancora) organizza a Chatuzange le Goubet, nella Drôme, una serie di incontri divertenti basati sui giochi da tavolo"
    ],
    "fr": [
      "L'association \"Je joue donc je suis, et je repioche\" vous propose des rencontres ludiques, autour du jeux de société, dans la Drôme, à Chatuzange le Goubet"
    ],
    "es": [
      "La asociación \"Je joue donc je suis, et je repioche\" (Juego, luego existo y volveré a jugar) organiza en Chatuzange le Goubet, en la Drôme, una serie de encuentros lúdicos en torno a los juegos de mesa"
    ],
    "nl": [
      "De vereniging \"Je joue donc je suis, et je repioche\" (Ik speel dus ik ben en ik zal weer spelen) organiseert een reeks ludieke bijeenkomsten rond gezelschapsspellen in Chatuzange le Goubet, in de Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association \"Je joue donc je suis... et je repioche\""
    ]
  },
