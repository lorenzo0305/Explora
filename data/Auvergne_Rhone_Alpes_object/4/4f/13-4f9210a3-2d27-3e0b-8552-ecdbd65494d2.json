  "rdfs:comment": {
    "de": [
      "Erlebe die authentische Atmosphäre einer echten Pommesbude bei Adrien und Anne-Charlotte, die direkt aus dem Norden kommen, um deine Geschmacksknospen zu verwöhnen!"
    ],
    "en": [
      "Experience the authentic atmosphere of a real French fry shack at Adrien and Anne-Charlotte?s, straight from the North to delight your taste buds!"
    ],
    "it": [
      "Provate l'atmosfera autentica di una vera baracca di patatine fritte da Adrien e Anne-Charlotte, venuti dal Nord per deliziare il vostro palato!"
    ],
    "fr": [
      "Vivez l’ambiance authentique d’une vraie cabane à frites chez Adrien et Anne-Charlotte, tout droit venus du Nord pour régaler vos papilles !"
    ],
    "nl": [
      "Ervaar de authentieke sfeer van een echte frietkraam bij Adrien en Anne-Charlotte, die helemaal uit het noorden komen om je smaakpapillen te verwennen!"
    ],
    "es": [
      "Disfrute del auténtico ambiente de un auténtico restaurante de patatas fritas en Adrien y Anne-Charlotte, que han venido desde el Norte para deleitar su paladar"
    ]
  },
