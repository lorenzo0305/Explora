  "rdfs:comment": {
    "de": [
      "Die Sainte-Chapelle in Vic-le-Comte, der Chor der Kirche Saint-Pierre, beherbergt ein herrliches geschnitztes Altarbild, das die Kardinal- und theologischen Tugenden darstellt, sowie wunderschöne alte Glasfenster, die Szenen aus dem Alten und Neuen Testament zeigen."
    ],
    "en": [
      "The Sainte-Chapelle de Vic-le-Comte, the choir of the church of Saint-Pierre, houses a splendid carved altarpiece representing the cardinal and theological virtues, as well as magnificent old stained glass windows depicting scenes from the Old and New Testament."
    ],
    "it": [
      "La Sainte-Chapelle di Vic-le-Comte, cuore della chiesa di Saint-Pierre, ospita una splendida pala d'altare scolpita che rappresenta le virtù cardinali e teologali, oltre a magnifiche vetrate antiche che raffigurano scene del Vecchio e del Nuovo Testamento."
    ],
    "fr": [
      "La Sainte-Chapelle de Vic-le-Comte, chœur de l'église Saint-Pierre, abrite un splendide retable sculpté représentant les vertus cardinales et théologales, ainsi que de magnifiques vitraux anciens figurant des scènes de l'Ancien et du Nouveau Testament."
    ],
    "es": [
      "La Sainte-Chapelle de Vic-le-Comte, el corazón de la iglesia de Saint-Pierre, alberga un espléndido retablo esculpido que representa las virtudes cardinales y teologales, así como magníficas vidrieras antiguas que representan escenas del Antiguo y del Nuevo Testamento."
    ],
    "nl": [
      "De Sainte-Chapelle in Vic-le-Comte, het koor van de kerk Saint-Pierre, herbergt een prachtig gebeeldhouwd altaarstuk dat de kardinale en theologische deugden voorstelt, evenals prachtige oude gebrandschilderde ramen met scènes uit het Oude en Nieuwe Testament."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Pierre church - Sainte Chapelle"
    ],
    "fr": [
      "Église Saint-Pierre dite Sainte Chapelle"
    ]
  },
