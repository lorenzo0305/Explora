  "rdfs:comment": {
    "de": [
      "Die Destillerie Terre Froide ist ein handwerklicher Hersteller von Spirituosen aus reinem Bio-Malz. Sie bietet Ihnen ihren Dutch Gin, ihren Génépi, ihren Anis und in einigen Jahren auch ihr Whisky-Sortiment an."
    ],
    "en": [
      "Artisanal producer of organic Pure Malt spirits, Terre Froide Distillery offers to you  Dutch Gin, Génépi,  Anisé and in a few years, his range of whisky."
    ],
    "it": [
      "Produttore tradizionale di liquori di puro malto biologico, la Distillerie Terre Froide offre Dutch Gin, Génépi, Anisé e, tra qualche anno, una gamma di whisky."
    ],
    "fr": [
      "Producteur artisanal de spiritueux Pur Malt Bio, La Distillerie Terre Froide vous propose son Dutch Gin, son Génépi, son Anisé et dans quelques années, sa gamme de whisky."
    ],
    "es": [
      "Productor tradicional de aguardientes de malta puros y ecológicos, Distillerie Terre Froide ofrece Dutch Gin, Génépi, Anisé y, dentro de unos años, una gama de whisky."
    ],
    "nl": [
      "Distillerie Terre Froide is een traditionele producent van zuivere biologische moutgeuren en biedt Nederlandse Gin, Génépi, Anisé en over een paar jaar ook een whiskylijn."
    ]
  },
