  "rdfs:comment": {
    "de": [
      "Von der Cie la Centrifugueuse (35). Ein zärtlich-freches Solo. Claire Morel spricht alles aus, was sie lange Zeit leise gedacht hat... Eineinhalb Stunden lang erzählt sie ihr ganzes, nicht immer aufregendes Sexualleben mit Feingefühl, Ironie und Selbstironie."
    ],
    "en": [
      "By Cie la Centrifugueuse (35). A tenderly sassy one-woman show. Claire Morel says everything she's ever thought to herself... For 1h30, she recounts her not always hectic sex life, with finesse, irony and self-mockery."
    ],
    "it": [
      "Di Cie la Centrifugueuse (35). Un one-woman show teneramente sfacciato. Claire Morel dice tutto quello che ha sempre pensato a se stessa... Per 1 ora e 30 minuti, racconta la sua vita sessuale, non sempre eccitante, con finezza, ironia e autoironia."
    ],
    "fr": [
      "Par la Cie la Centrifugueuse (35). Un seule en scène tendrement culottée. Claire Morel dit tout ce qu'elle a longtemps pensé tout bas... Pendant 1h30, elle racontera toute sa vie sexuelle, pas toujours trépidante, avec finesse, ironie et auto-dérision."
    ],
    "nl": [
      "Door Cie la Centrifugueuse (35). Een tedere, brutale one woman show. Claire Morel zegt alles wat ze ooit tegen zichzelf heeft gezegd... Gedurende 1 uur 30 minuten vertelt ze haar hele seksleven, niet allemaal even opwindend, met finesse, ironie en zelfspot."
    ],
    "es": [
      "De Cie la Centrifugueuse (35). Un espectáculo unipersonal tiernamente descarado. Claire Morel se dice a sí misma todo lo que ha pensado... Durante 1 hora y 30 minutos, relata toda su vida sexual, no siempre apasionante, con delicadeza, ironía y autoburla."
    ]
  },
  "rdfs:label": {
