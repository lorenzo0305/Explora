  "rdfs:comment": {
    "de": [
      "Die Domaine de Montine lädt Sie in ihr vorübergehendes Restaurant ein."
    ],
    "en": [
      "Domaine de Montine invites you to its restaurant Chez Colette in a warm and welcoming setting from Thursday evening to Sunday lunchtime.\r\nWe are committed to cooking seasonal products, giving priority to those from our own estate."
    ],
    "it": [
      "Il Domaine de Montine vi invita a gustare il suo ristorante Chez Colette in un ambiente accogliente dal giovedì sera alla domenica a pranzo.\r\nCi impegniamo a cucinare prodotti di stagione, privilegiando i prodotti della nostra azienda agricola."
    ],
    "fr": [
      "Le Domaine de Montine vous invite dans son restaurant Chez Colette dans un cadre chaleureux du jeudi soir au dimanche midi.\r\nNous avons à cœur de cuisiner des produits de saison en privilégiant les produits de notre exploitation."
    ],
    "es": [
      "El Domaine de Montine le invita a disfrutar de su restaurante Chez Colette en un ambiente cálido desde el jueves por la noche hasta el domingo al mediodía.\r\nNos comprometemos a cocinar productos de temporada, dando prioridad a los productos de nuestra propia granja."
    ],
    "nl": [
      "Domaine de Montine nodigt je uit in zijn tijdelijke restaurant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine de Montine - Restaurant chez Colette"
    ]
  },
