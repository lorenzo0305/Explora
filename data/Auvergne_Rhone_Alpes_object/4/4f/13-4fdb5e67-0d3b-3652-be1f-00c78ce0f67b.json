  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein ins Mittelalter, in das imaginäre kleine Dorf Besse, das sich um einen winzigen, geheimnisvollen See schmiegt: den Lac Pavin.\r\nDas Dorf ist in Gefahr! Das Wasser droht, alles zu verschlingen."
    ],
    "en": [
      "Immerse yourself in medieval times, in the imaginary village of Besse, nestled around a tiny, mysterious lake: Lac Pavin.\r\nThe village is in danger! The waters threaten to engulf everything."
    ],
    "it": [
      "Immergetevi nel Medioevo, nell'immaginario paesino di Besse, adagiato attorno a un piccolo e misterioso lago: il lago Pavin.\r\nIl villaggio è in pericolo! Le acque minacciano di inghiottire tutto."
    ],
    "fr": [
      "Plongez à l’époque médiévale, dans le petit village imaginaire de Besse, niché autour d’un minuscule lac mystérieux : le lac Pavin.\r\nLe village est en danger ! Les eaux menacent de tout engloutir."
    ],
    "es": [
      "Sumérgete en la época medieval, en el imaginario pueblecito de Besse, enclavado alrededor de un pequeño y misterioso lago: el lago Pavin.\r\nEl pueblo está en peligro Las aguas amenazan con engullirlo todo."
    ],
    "nl": [
      "Dompel je onder in de middeleeuwen, in het denkbeeldige dorpje Besse, genesteld rond een klein, mysterieus meer: het Pavin-meer.\r\nHet dorp is in gevaar! Het water dreigt alles te verzwelgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Explor Games® « L’incroyable histoire du lac Pavin »"
    ]
  },
