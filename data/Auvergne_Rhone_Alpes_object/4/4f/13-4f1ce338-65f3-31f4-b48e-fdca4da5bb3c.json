  "rdfs:comment": {
    "de": [
      "Seit 1830 wird die handwerkliche Herstellung von Walnussöl in der Moulin de Léon fortgesetzt. Lernen Sie dieses alte Handwerk kennen, wenn die Mühle in Betrieb ist."
    ],
    "en": [
      "Since 1830, the artisanal production of walnut oil has been perpetuated at the Moulin de Léon. Come and discover this old trade when the mill is in operation."
    ],
    "it": [
      "Dal 1830, la produzione tradizionale di olio di noce viene portata avanti al Moulin de Léon. Venite a scoprire questo antico mestiere quando il mulino è in funzione."
    ],
    "fr": [
      "Depuis 1830, la fabrication artisanale de l'huile de noix se perpétue au Moulin de Léon. Venez découvrir ce vieux métier lorsque le moulin est en activité."
    ],
    "nl": [
      "Sinds 1830 wordt in de Moulin de Léon op traditionele wijze walnootolie geproduceerd. Kom deze oude handel ontdekken als de molen in bedrijf is."
    ],
    "es": [
      "Desde 1830, en el Moulin de Léon se lleva a cabo la producción tradicional de aceite de nuez. Venga a descubrir este antiguo oficio cuando el molino esté en funcionamiento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Moulin de Léon"
    ]
  },
