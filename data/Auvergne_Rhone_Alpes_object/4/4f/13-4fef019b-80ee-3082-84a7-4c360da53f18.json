  "rdfs:comment": {
    "de": [
      "Jérôme und sein Team freuen sich, Sie im Restaurant La Samiane im Herzen von La Bresse begrüßen zu dürfen. Traditionelle Küche, frisch gekochte Produkte, Tagesmenü und Speisekarte. Spezialität: Frösche. La Samiane bietet Platz für bis zu 120 Personen."
    ],
    "en": [
      "Jérôme and his team are happy to welcome you to the Restaurant La Samiane in the heart of Bresse. Traditional cuisine, freshly cooked products, menu of the day and a la carte menu. Speciality: frogs. La Samiane can accommodate up to 120 people."
    ],
    "it": [
      "Jérôme e il suo team sono lieti di darvi il benvenuto al Ristorante La Samiane, nel cuore della Bresse. Cucina tradizionale, prodotti cucinati al momento, menù del giorno e alla carta. Specialità: rane. La Samiane può ospitare fino a 120 persone."
    ],
    "fr": [
      "Jérôme et son équipe sont heureux de vous accueillir au Restaurant La Samiane au coeur de la Bresse. Cuisine traditionnelle, produits frais cuisinés, menu du jour et carte. Spécialité : grenouilles. La Samiane peut accueillir jusqu’à 120 personnes."
    ],
    "es": [
      "Jérôme y su equipo se complacen en darle la bienvenida al Restaurante La Samiane en el corazón de Bresse. Cocina tradicional, productos recién cocinados, menú diario y a la carta. Especialidad: ranas. La Samiane puede acoger hasta 120 personas."
    ],
    "nl": [
      "Jérôme en zijn team heten u van harte welkom in Restaurant La Samiane in het hart van Bresse. Traditionele keuken, vers bereide producten, dagmenu en à la carte. Specialiteit: kikkers. La Samiane biedt plaats aan maximaal 120 personen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Samiane"
    ]
  },
