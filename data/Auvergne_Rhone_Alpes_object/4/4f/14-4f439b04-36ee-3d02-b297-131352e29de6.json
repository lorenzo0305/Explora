  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b87ff3e-0e4c-321c-9afa-9a1e1f409c76",
      "dc:description": {
        "de": [
          "Zusammenschluss von Trödlern, die in einem 400 m² großen Geschäft versammelt sind. Hier finden Sie Möbel, Dekorationen, Geschirr und Sammlerstücke aus Antiquitäten und Trödel.\n\nGeöffnet am Freitag, Samstag und Sonntag von 10 bis 19 Uhr"
        ],
        "en": [
          "A group of second-hand dealers in a 400 m² store. You'll find furniture, decoration, crockery, antiques and second-hand collectibles.\n\nOpen Friday, Saturday and Sunday from 10am to 7pm"
        ],
        "it": [
          "Un gruppo di commercianti di seconda mano in un negozio di 400 m². Troverete mobili, decorazioni, stoviglie, oggetti d'antiquariato e da collezione di seconda mano.\n\nAperto venerdì, sabato e domenica dalle 10.00 alle 19.00"
        ],
        "fr": [
          "Groupement de brocanteurs rassemblés dans un magasin de 400 m². Vous y trouverez du mobilier, de la décoration, de la vaisselle, des objets de collection en antiquités et brocante.\n\nOuverture le vendredi, samedi et le dimanche de 10h à 19h"
        ],
        "es": [
          "Un grupo de comerciantes de segunda mano en una tienda de 400 m². Encontrarás muebles, adornos, vajillas, antigüedades y objetos de colección de segunda mano.\n\nAbierto viernes, sábado y domingo de 10.00 a 19.00 h"
        ],
        "nl": [
          "Een groep tweedehandshandelaars in een winkel van 400 m². Je vindt er meubels, decoraties, serviesgoed, antiek en tweedehands verzamelobjecten.\n\nOpen op vrijdag, zaterdag en zondag van 10 tot 19 uur"
        ]
      },
      "@type": [
        "Description"
      ],
