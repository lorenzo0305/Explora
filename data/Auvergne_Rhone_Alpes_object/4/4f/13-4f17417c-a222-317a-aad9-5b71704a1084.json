  "rdfs:comment": {
    "de": [
      "Sowans Arbeit dreht sich um eine Reflexion über den Übergang zwischen dem immateriellen digitalen Bild, das er durch die Verwendung spezieller Software erzeugt, und seiner physischen und materiellen Umsetzung auf Wänden im öffentlichen Raum."
    ],
    "en": [
      "Sowan?s work revolves around a reflection on the transition between the immaterial digital image he creates using specific software, and its physical and material transposition onto walls in the public space."
    ],
    "it": [
      "Il lavoro di Sowan si concentra sulla transizione tra l'immagine digitale immateriale che crea utilizzando un software specifico e la sua trasposizione fisica e materiale sui muri dello spazio pubblico."
    ],
    "fr": [
      "Sowan propose un travail qui s’articule autour d’une réflexion sur le passage entre l’image numérique immatérielle qu’il crée par l’utilisa&on de logiciel spécifique et  sa transposition physique et matérielle sur des murs dans l’espace public."
    ],
    "nl": [
      "Sowans werk richt zich op de overgang tussen het immateriële digitale beeld dat hij creëert met behulp van specifieke software en de fysieke en materiële transpositie ervan op muren in de openbare ruimte."
    ],
    "es": [
      "La obra de Sowan se centra en la transición entre la imagen digital inmaterial que crea utilizando un software específico y su transposición física y material a las paredes del espacio público."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Street art de SOWAN - Wall & love"
    ]
  },
