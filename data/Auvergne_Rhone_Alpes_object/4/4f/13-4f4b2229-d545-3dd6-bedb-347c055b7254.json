  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant La Rose des Vents ist ideal gelegen, ruhig, im Grünen, mitten in der Natur, nur wenige Kilometer von den unumgänglichen Sehenswürdigkeiten und Wanderwegen entfernt, auf dem Gebiet, das zum UNESCO-Weltkulturerbe gehört."
    ],
    "en": [
      "The hotel-restaurant La Rose des Vents is ideally located in a quiet, green setting, in the middle of nature, a few kilometres from unmissable tourist sites and hiking trails, on the territory listed as a UNESCO World Heritage Site."
    ],
    "it": [
      "L'hotel-ristorante La Rose des Vents è situato in posizione ideale, in un ambiente tranquillo e verdeggiante, in mezzo alla natura, a pochi chilometri dai principali siti turistici e dai sentieri escursionistici, nella zona del Patrimonio Mondiale dell'UNESCO."
    ],
    "fr": [
      "L'hôtel-restaurant La Rose des Vents est idéalement situé au calme, dans la verdure, en pleine nature, à quelques kilomètres des sites touristiques incontournables et des sentiers de randonnée, sur le territoire inscrit au patrimoine mondial de l'UNESCO."
    ],
    "nl": [
      "Hotel-restaurant La Rose des Vents is ideaal gelegen in een rustige, groene omgeving, midden in de natuur, op enkele kilometers van de belangrijkste toeristische bezienswaardigheden en wandelpaden, in het UNESCO-werelderfgoedgebied."
    ],
    "es": [
      "El hotel-restaurante La Rose des Vents está idealmente situado en un entorno tranquilo y verde, en plena naturaleza, a pocos kilómetros de los principales lugares turísticos y de las rutas de senderismo, en la zona del Patrimonio Mundial de la UNESCO."
    ]
  },
