  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/af8f2441-53f2-34b0-b7a2-a8a3e5980489",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Kisten wird Ihnen saisonales Obst und Gemüse aus biologischem Anbau von lokalen Erzeugern angeboten.\n\nÖffnungstage:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nSeasonal organic fruit and vegetables from local producers are available in crates.\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nVi verranno offerti in cassette frutta e verdura di stagione coltivata con metodo biologico da produttori locali.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposés des fruits et légumes de saison issus de l'agriculture biologique et provenant de producteurs locaux.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nJe krijgt seizoensgebonden biologisch geteeld fruit en groenten van lokale producenten in kratten aangeboden.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nLe ofrecerán frutas y verduras de temporada cultivadas ecológicamente por productores locales en cajas.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
