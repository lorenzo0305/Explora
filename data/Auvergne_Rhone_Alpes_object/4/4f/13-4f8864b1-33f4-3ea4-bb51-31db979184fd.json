  "rdfs:comment": {
    "de": [
      "Dieser von EDF neu sanierte Aussichtspunkt bietet einen atemberaubenden Blick auf den Monteynard-Avignonet-Staudamm, das türkisfarbene Wasser des Sees und darüber hinaus auf die umliegenden Bergmassive. Er bietet die Möglichkeit, die Funktionsweise des Staudamms und seine Umgebung zu entdecken."
    ],
    "en": [
      "Newly refurbished by EDF, this lookout offers a breathtaking view of the Monteynard-Avignonet dam, the turquoise waters of the lake and beyond to the surrounding mountains. The viewpoint provides an insight into the workings of the dam and its environment."
    ],
    "it": [
      "Recentemente ristrutturato da EDF, questo belvedere offre una vista mozzafiato sulla diga di Monteynard-Avignonet, sulle acque turchesi del lago e, oltre, sui massicci circostanti. Permette di scoprire il funzionamento della diga e il suo ambiente."
    ],
    "fr": [
      "Nouvellement réhabilité par EDF, ce belvédère offre une vue imprenable sur le barrage de Monteynard-Avignonet, les eaux turquoises du lac et au-delà, sur les massifs environnants. Il permet de découvrir le fonctionnement du barrage et son environnement."
    ],
    "es": [
      "Recientemente renovado por EDF, este mirador ofrece una vista impresionante de la presa de Monteynard-Avignonet, las aguas turquesas del lago y, más allá, los macizos circundantes. Permite descubrir el funcionamiento de la presa y su entorno."
    ],
    "nl": [
      "Dit onlangs door EDF gerenoveerde uitkijkpunt biedt een adembenemend uitzicht op de stuwdam van Monteynard-Avignonet, het turquoise water van het meer en daarachter de omringende bergmassieven. Het stelt u in staat de werking van de dam en zijn omgeving te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Belvedere at Avignonet"
    ],
    "fr": [
      "Belvédère d'Avignonet"
    ]
  },
