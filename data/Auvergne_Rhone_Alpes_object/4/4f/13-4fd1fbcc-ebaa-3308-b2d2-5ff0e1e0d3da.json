  "rdfs:comment": {
    "de": [
      "Audacius by Prosneige Méribel, das ist eine Ski- und Snowboardschule. Privatunterricht, Gruppenkurse mit maximal 7 Schülern pro Gruppe für Groß und Klein, in allen Disziplinen."
    ],
    "ru": [
      "Prosneige Meribel - школа горнолыжного спорта и сноуборда. Индивидуальные уроки. Групповые занятия с максимум 7 учениками в группе для молодых и пожилых людей по всем дисциплинам."
    ],
    "en": [
      "Audacius by Prosneige Méribel is a ski and snowboard school. Private lessons, group lessons with a maximum of 7 students per group for young and old, in all disciplines."
    ],
    "it": [
      "Audacius by Prosneige Méribel è una scuola di sci e snowboard. Lezioni private, lezioni di gruppo con un massimo di 7 allievi per gruppo per giovani e meno giovani, in tutte le discipline."
    ],
    "fr": [
      "Audacius by Prosneige Méribel, c'est une école de ski et de snowboard. Des leçons privées, des cours collectifs de 7 élèves maximum par groupe pour les petits et les grands, dans toutes les disciplines."
    ],
    "nl": [
      "Prosneige Meribel is een ski- en snowboardschool. Privélessen. Groepslessen met maximaal 7 leerlingen per groep voor jong en oud, in alle disciplines."
    ],
    "es": [
      "Audacius by Prosneige Méribel es una escuela de esquí y snowboard. Clases particulares, clases en grupo con un máximo de 7 alumnos por grupo para jóvenes y mayores, en todas las disciplinas."
    ]
  },
