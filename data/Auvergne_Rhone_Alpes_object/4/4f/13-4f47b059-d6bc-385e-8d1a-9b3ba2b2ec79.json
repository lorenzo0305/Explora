  "rdfs:comment": {
    "de": [
      "Am Ufer des Allier wird das Haus der Binnenschifffahrt von der Vereinigung \"La Chavannée\" belebt, die seit Jahren an den Traditionen der Binnenschiffer arbeitet."
    ],
    "en": [
      "On the banks of the Allier, the Maison de la Batellerie is run by the association \"La Chavannée\", which has been working for years on boat-building traditions."
    ],
    "it": [
      "Sulle rive dell'Allier, la Maison de la Batellerie è gestita dall'associazione \"La Chavannée\", che da molti anni si occupa delle tradizioni delle imbarcazioni sul canale."
    ],
    "fr": [
      "Au bord de l'Allier, la maison de la Batellerie est animée par l'association \"La Chavannée\" qui travaille depuis des années sur les traditions batelières."
    ],
    "nl": [
      "Aan de oevers van de Allier wordt het Maison de la Batellerie beheerd door de vereniging \"La Chavannée\", die zich al vele jaren inzet voor de tradities van de kanaalboten."
    ],
    "es": [
      "A orillas del Allier, la Maison de la Batellerie está dirigida por la asociación \"La Chavannée\", que trabaja desde hace muchos años en las tradiciones de los barcos del canal."
    ]
  },
  "rdfs:label": {
