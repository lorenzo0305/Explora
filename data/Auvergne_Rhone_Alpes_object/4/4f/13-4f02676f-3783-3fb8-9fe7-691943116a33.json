  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Lans en Vercors, das sich im ehemaligen Straßenbahnbahnhof befindet, empfängt Sie das ganze Jahr über und hilft Ihnen dabei, das Drehbuch für Ihre Ausflüge ins Vercors-Massiv zu schreiben."
    ],
    "en": [
      "The Tourist Office of Lans en Vercors, located in the old tram station, welcomes you all year round and helps you to write the scenario of your escapades in the Vercors massif."
    ],
    "it": [
      "L'Ufficio del Turismo di Lans en Vercors, situato nella vecchia stazione dei tram, vi accoglie tutto l'anno e vi aiuta a scrivere il copione delle vostre escursioni nel massiccio del Vercors."
    ],
    "fr": [
      "L'Office de Tourisme de Lans en Vercors, situé dans l'ancienne gare de tram, vous accueille toute l'année et vous aide à écrire le scénario de vos escapades dans le massif du Vercors."
    ],
    "es": [
      "La Oficina de Turismo de Lans en Vercors, situada en la antigua estación de tranvía, le da la bienvenida todo el año y le ayuda a escribir el guión de sus escapadas en el macizo del Vercors."
    ],
    "nl": [
      "Het VVV-kantoor van Lans en Vercors, gevestigd in het oude tramstation, ontvangt u het hele jaar door en helpt u het draaiboek te schrijven voor uw escapades in het Vercors-massief."
    ]
  },
  "rdfs:label": {
    "de": [
