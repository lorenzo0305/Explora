  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aee51787-9a30-39d7-b8bd-6fa0f53379eb",
      "dc:description": {
        "de": [
          "Michel empfängt Sie in seinem Kino mit insgesamt 154 Plätzen, 86 im Parkett und 68 auf dem Balkon.\nDas Programm ist in den Geschäften von Guise erhältlich oder auf der Facebook-Seite: Cinéma Vox Guise (Programme, Nachrichten, Informationen). Wöchentliche Schließung: Donnerstag."
        ],
        "en": [
          "Michel welcomes you in his Cinema with 154 seats in total, 86 on the floor and 68 in the balcony.\nProgram available in the shops of Guise or on the Facebook page : Cinéma Vox Guise (programs, news, information). Weekly closing: Thursday."
        ],
        "it": [
          "Michel vi accoglie nel suo cinema con 154 posti a sedere in totale, 86 al piano e 68 in balconata.\nProgramma disponibile nei negozi di Guise o sulla pagina Facebook: Cinéma Vox Guise (programmi, notizie, informazioni). Chiusura settimanale: giovedì."
        ],
        "fr": [
          "Michel vous accueille dans son Cinéma de 154 places au total, 86 parterre et 68 au balcon.\nProgramme disponible dans les commerces de Guise ou sur la page Facebook : Cinéma Vox Guise (programmes, actualités, informations). Fermeture hebdomadaire : jeudi."
        ],
        "es": [
          "Michel le da la bienvenida a su cine con 154 asientos en total, 86 en el suelo y 68 en el balcón.\nPrograma disponible en las tiendas de Guise o en la página de Facebook: Cinéma Vox Guise (programas, noticias, información). Cierre semanal: jueves."
        ],
        "nl": [
          "Michel heet u welkom in zijn Cinema met in totaal 154 zitplaatsen, 86 op de vloer en 68 op het balkon.\nProgramma verkrijgbaar in de winkels in Guise of op de Facebookpagina: Cinéma Vox Guise (programma's, nieuws, informatie). Wekelijkse sluiting: donderdag."
        ]
      },
      "@type": [
        "Description"
      ],
