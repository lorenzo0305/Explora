          "additionalInformation": {
            "de": [
              "Besuchen Sie den Bauernhof mit allen Erklärungen zu unserer Arbeitsweise und probieren Sie die Produkte! Gutes Schuhwerk mitbringen.\r\nACHTUNG: Kein Verkauf auf dem Hof! Sie finden unsere Produkte im Laden Le Raccourci in Mens."
            ],
            "en": [
              "Visit the farm with full explanations of how we work and taste our products! Bring good shoes.\r\nATTENTION: no sales at the farm! Find our products at Le Raccourci store in Mens."
            ],
            "it": [
              "Visitate la fattoria e scoprite come lavoriamo e assaggiate i prodotti! Portare scarpe buone.\r\nATTENZIONE: non si vendono prodotti in fattoria! Potete acquistare i nostri prodotti presso il negozio Le Raccourci di Mens."
            ],
            "fr": [
              "Visite de la ferme avec toutes les explications sur notre façon de travailler et dégustation des produits ! Prévoir de bonnes chaussures.\r\nATTENTION : pas de vente à la ferme ! Retrouvez nos produits au magasin Le Raccourci à Mens."
            ],
            "es": [
              "Visite la granja, descubra cómo trabajamos y pruebe nuestros productos Traiga buen calzado.\r\nATENCIÓN: ¡no se vende en la granja! Puede comprar nuestros productos en la tienda Le Raccourci de Mens."
            ],
            "nl": [
              "Bezoek de boerderij en kom alles te weten over de manier waarop we werken en proef de producten! Neem goede schoenen mee.\r\nLET OP: geen verkoop op de boerderij! Je kunt onze producten kopen in de winkel Le Raccourci in Mens."
            ]
          },
