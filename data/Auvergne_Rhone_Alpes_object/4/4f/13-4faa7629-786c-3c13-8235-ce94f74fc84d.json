  "rdfs:comment": {
    "de": [
      "Die Ferme du Ser Clapi empfängt Sie, um Ihnen ihre Ziegenkäsesorten aus Rohmilch vom Bauernhof und ihre im Holzofen gebackenen Sauerteigbrote vorzustellen."
    ],
    "en": [
      "La Ferme du Ser Clapi welcomes you to discover its farmhouse goat's milk cheeses and sourdough breads baked over a wood fire.\r\nIn July and August, guided tours on Wednesday mornings from 10am to 11am. Bring good shoes!"
    ],
    "it": [
      "La Ferme du Ser Clapi vi accoglie per farvi scoprire i suoi formaggi di capra di fattoria e il pane a lievitazione naturale cotto sul fuoco a legna."
    ],
    "fr": [
      "La Ferme du Ser Clapi vous accueille pour vous faire découvrir ses fromages de chèvre fermiers au lait cru et ses pains au levain cuits au feu de bois."
    ],
    "es": [
      "La Ferme du Ser Clapi le da la bienvenida para que descubra sus quesos de leche de cabra de granja y sus panes de masa madre horneados al fuego de leña."
    ],
    "nl": [
      "La Ferme du Ser Clapi heet je welkom om zijn boerengeitenkazen en zuurdesembroden gebakken boven een houtvuur te ontdekken."
    ]
  },
  "rdfs:label": {
