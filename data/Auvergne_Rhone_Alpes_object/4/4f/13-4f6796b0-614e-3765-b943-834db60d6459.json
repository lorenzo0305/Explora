  "rdfs:comment": {
    "de": [
      "Bar, Restaurant Ski-in Ski-out.\r\nSonnenterrasse und Solarium.\r\nKarte, Menüs, Tagesgericht und savoyische Spezialitäten.\r\nPfannkuchen, Eis und Hot Dog für Après-Ski."
    ],
    "en": [
      "Bar, Restaurant Ski-in ski-out.\r\nSunny terrace, and solarium.\r\nCarte, menus, dish of the day, and Savoyard specialties.\r\nPancakes, ice cream and hot dog for après ski."
    ],
    "it": [
      "Bar, ristorante.\r\nTerrazza soleggiata e solarium.\r\nMenu, piatto del giorno e specialità savoiarde.\r\nCrêpes, gelati e hot dog dopo lo sci."
    ],
    "fr": [
      "Bar, Restaurant Skis aux pieds.\r\nTerrasse ensoleillée, et solarium.\r\nCarte, menus, plat du jour, et spécialités savoyardes.\r\nCrêpes, glaces et hot-dog pour l'après ski."
    ],
    "nl": [
      "Bar, restaurant Skiverhuur.\r\nZonnig terras en solarium.\r\nCarte, menu's, gerecht van de dag en specialiteiten uit de Savoie.\r\nPannenkoeken, ijs en hotdog voor après-ski."
    ],
    "es": [
      "Bar, Restaurante.\r\nTerraza soleada y solarium.\r\nMenú, plato del día y especialidades saboyanas.\r\nCrepes, helados y perritos calientes después de esquiar."
    ]
  },
