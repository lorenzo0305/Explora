    "de": [
      "Ehemalige Abtei aus dem 12. Jahrhundert, die von Saint-Gilbert, dem Schutzheiligen des Bourbonnais, gegründet wurde. Freie Besichtigung der Innen- und Außenbereiche mit Informationsheft."
    ],
    "en": [
      "Former 12th-century abbey founded by Saint-Gilbert, patron saint of the Bourbonnais region. Self-guided tour of interiors and exteriors with information booklet."
    ],
    "it": [
      "Ex abbazia del XII secolo fondata da Saint-Gilbert, patrono della regione di Bourbonnais. Visita gratuita degli interni e degli esterni, con opuscolo informativo."
    ],
    "fr": [
      "Ancienne abbaye du XIIe siècle fondée par Saint-Gilbert, Saint patron du Bourbonnais. Visite libre des intérieurs et des extérieurs avec livret d'information."
    ],
    "nl": [
      "Voormalige 12e-eeuwse abdij gesticht door Saint-Gilbert, beschermheilige van de Bourbonnais. Gratis rondleiding door het interieur en exterieur, met informatieboekje."
    ],
    "es": [
      "Antigua abadía del siglo XII fundada por San Gilberto, patrón de la región de Bourbonnais. Visita gratuita del interior y el exterior, con folleto informativo."
