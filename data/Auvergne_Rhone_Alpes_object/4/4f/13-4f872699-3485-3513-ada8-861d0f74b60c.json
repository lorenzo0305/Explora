  "rdfs:comment": {
    "de": [
      "Das Séquoia Redwood Spa ist ein 1500 m² großes Wellnesszentrum im Obergeschoss der Thermen von Vals-les-Bains, in einer außergewöhnlichen Welt aus Holz, Raum und Licht."
    ],
    "en": [
      "The Spa Séquoia Redwood is 1,500 m² of well-being nestled on the upper floor of the Thermes de Vals-les-Bains in an exceptional world of wood, space and light."
    ],
    "it": [
      "La Spa Séquoia Redwood è un'area benessere situata al piano superiore delle Thermes de Vals-les-Bains in un maestoso mondo di legno, acqua, spazio e luce."
    ],
    "fr": [
      "Le Spa Séquoia Redwood c'est un espace de bien-être niché à l'étage des Thermes de Vals-les-Bains dans un univers majestueux fait de bois, d'eau, d'espace et de lumière."
    ],
    "es": [
      "El Spa Séquoia Redwood es un espacio de bienestar situado en la planta superior de las Thermes de Vals-les-Bains, en un majestuoso mundo de madera, agua, espacio y luz."
    ],
    "nl": [
      "De Spa Séquoia Redwood is 1.500 m² welzijn genesteld op de bovenste verdieping van de Thermen van Vals-les-Bains in een uitzonderlijke wereld van hout, ruimte en licht."
    ]
  },
