  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Sidonie empfängt Sie in einem gemütlichen und intimen Ambiente mit Holztönen, damit Sie einen besonderen Moment mit der Familie, zu zweit oder mit Freunden verbringen können."
    ],
    "en": [
      "Le Sidonie restaurant welcomes you to a cosy, intimate woodland setting, where you can enjoy a special moment with family, friends or your partner."
    ],
    "it": [
      "Il ristorante Le Sidonie vi accoglie in un'atmosfera intima e accogliente dai toni boschivi, per farvi trascorrere un momento privilegiato con la vostra famiglia, il vostro partner o i vostri amici."
    ],
    "fr": [
      "Le restaurant Le Sidonie vous accueille au sein d’une ambiance cosy et intimiste aux tonalités boisées, pour que vous passiez un instant privilégié en famille, en duo ou entre amis."
    ],
    "nl": [
      "Het restaurant Le Sidonie ontvangt u in een gezellige en intieme sfeer met houttinten, zodat u een bevoorrecht moment kunt doorbrengen met uw gezin, uw partner of uw vrienden."
    ],
    "es": [
      "El restaurante Le Sidonie le acoge en un ambiente acogedor e íntimo con tonos amaderados, para que pase un momento privilegiado con su familia, su pareja o sus amigos."
    ]
  },
