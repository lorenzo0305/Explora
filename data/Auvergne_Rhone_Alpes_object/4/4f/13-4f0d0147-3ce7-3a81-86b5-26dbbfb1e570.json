  "rdfs:comment": {
    "de": [
      "Seit 30 Jahren empfängt Sie Les Gentianettes im Geist eines echten traditionellen Chalet-Hotels im Herzen dieses authentischen Savoyer Dorfes."
    ],
    "en": [
      "For 30 years, Les Gentianettes has welcomed you in the spirit of a traditional chalet hotel in the heart of this authentic Savoyard village."
    ],
    "it": [
      "Da 30 anni, Les Gentianettes vi accoglie nello spirito di un tradizionale hotel chalet nel cuore di questo autentico villaggio savoiardo."
    ],
    "fr": [
