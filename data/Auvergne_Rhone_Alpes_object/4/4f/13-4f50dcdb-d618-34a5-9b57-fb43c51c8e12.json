  "rdfs:comment": {
    "de": [
      "Café Joyeux ist die erste Familie von solidarischen und inklusiven Café-Restaurants, die Menschen mit geistiger und kognitiver Behinderung beschäftigt und ausbildet, mitten in unseren Städten und in unserem Leben."
    ],
    "en": [
      "Café Joyeux\tCafé Joyeux is a family of café-restaurants that support solidarity and inclusion. They provide jobs and training for people with mental and cognitive disabilities, with a central location in our city and our hearts."
    ],
    "it": [
      "Café Joyeux è la prima famiglia di bar-ristoranti inclusivi e solidali, che impiegano e formano persone con disabilità mentali e cognitive, nel cuore delle nostre città e delle nostre vite."
    ],
    "fr": [
      "Café Joyeux est la première famille de cafés-restaurants solidaires et inclusifs, qui emploie et forme des personnes en situation de handicap mental et cognitif, au cœur de nos villes et de nos vies."
    ],
    "nl": [
      "Café Joyeux is de eerste familie van inclusieve, solidaire café-restaurants die mensen met mentale en cognitieve handicaps in dienst nemen en opleiden, in het hart van onze steden en ons leven."
    ],
    "es": [
      "Café Joyeux es la primera familia de cafés-restaurantes inclusivos y solidarios, que emplean y forman a personas con discapacidades mentales y cognitivas, en el corazón de nuestras ciudades y nuestras vidas."
    ]
  },
