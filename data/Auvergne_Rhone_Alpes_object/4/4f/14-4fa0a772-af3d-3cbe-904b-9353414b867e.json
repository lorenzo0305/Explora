  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/92d59d27-d250-3938-993c-cbe2fa41ba89",
      "dc:description": {
        "de": [
          "Große Ostereiersuche und Einweihung des Maskottchens zum 100. Geburtstag des Caddy.\nVon 10.00 bis 12.00 Uhr im Parc des Pins.\n\nWanderbauernhof - Hüpfburgen - Schminkstand."
        ],
        "en": [
          "Easter egg hunt and unveiling of the Caddy 100th anniversary mascot.\nFrom 10am to 12pm at Parc des Pins.\n\nTravelling farm - Inflatable structures - Face painting stand."
        ],
        "it": [
          "Caccia alle uova di Pasqua e svelamento della mascotte del Caddy 100° anniversario.\nDalle 10.00 alle 12.00 al Parc des Pins.\n\nFattoria itinerante - Strutture gonfiabili - Stand di face painting."
        ],
        "fr": [
          "Grande chasse aux oeufs de Pâques et inauguration e la mascotte des 100 ans du Caddy.\nDe 10h à 12h au Parc des Pins.\n\nFerme itinérante - Structures gonflables - Stand maquillage."
        ],
        "nl": [
          "Paaseieren zoeken en onthulling van de mascotte van de 100e verjaardag van Caddy.\nVan 10.00 tot 12.00 uur in Parc des Pins.\n\nReizende boerderij - Opblaasbare structuren - Stand met schmink."
        ],
        "es": [
          "Búsqueda de huevos de Pascua y presentación de la mascota del centenario de Caddy.\nDe 10:00 a 12:00 en el Parc des Pins.\n\nGranja ambulante - Estructuras hinchables - Puesto de pintura de caras."
        ]
      },
      "@type": [
        "Description"
      ],
