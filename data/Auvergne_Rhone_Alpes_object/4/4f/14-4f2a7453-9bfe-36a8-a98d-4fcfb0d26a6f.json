      "dc:description": {
        "de": [
          "Die TDA (Tournée des As) kehrt zurück, um Reiter, Trainer und Eltern zu begeistern.\nAusstellerdorf - Freier Zugang ? kostenloser Eintritt."
        ],
        "en": [
          "The TDA (Tournée des As) returns to delight riders, coaches and parents.\nExhibitors' village - Free access ? free entry."
        ],
        "it": [
          "Il TDA (Tournée des As) è tornato, per la gioia di cavalieri, allenatori e genitori.\nVillaggio degli espositori - Accesso libero e ingresso gratuito."
        ],
        "fr": [
          "La TDA (Tournée des As) revient pour le plus grand plaisir des cavaliers, coachs et parents.\nVillage exposants - Accès libre – entrée gratuite."
        ],
        "es": [
          "Vuelve la TDA (Tournée des As), para regocijo de jinetes, entrenadores y padres.\nPueblo de los expositores - Acceso libre y gratuito."
        ],
        "nl": [
          "De TDA (Tournée des As) is terug, tot grote vreugde van ruiters, coaches en ouders.\nExposantendorp - Gratis toegang?"
        ]
      },
