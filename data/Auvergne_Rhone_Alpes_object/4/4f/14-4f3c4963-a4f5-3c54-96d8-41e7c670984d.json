      "dc:description": {
        "de": [
          "La Dolce Vita ist eine Cocktailbar in Sainte Cécile in der Nähe des Strandes. Schlürfen Sie auf der Terrasse einen leckeren Cocktail."
        ],
        "en": [
          "La Dolce Vita is a cocktail bar located in Sainte Cécile near the beach. Come and sip a delicious cocktail on the terrace."
        ],
        "it": [
          "La Dolce Vita è un cocktail bar situato a Sainte Cécile, vicino alla spiaggia. Venite a sorseggiare un delizioso cocktail sulla terrazza."
        ],
        "fr": [
          "La Dolce Vita est un bar à cocktails situé à Sainte Cécile à proximité de la plage. Venez siroter en terrasse un délicieux cocktail."
        ],
        "nl": [
          "La Dolce Vita is een cocktailbar in Sainte Cécile vlak bij het strand. Kom een heerlijke cocktail drinken op het terras."
        ],
        "es": [
          "La Dolce Vita es una coctelería situada en Sainte Cécile, cerca de la playa. Venga a saborear un delicioso cóctel en la terraza."
        ]
      },
