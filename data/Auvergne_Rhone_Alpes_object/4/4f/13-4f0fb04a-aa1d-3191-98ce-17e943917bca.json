  "rdfs:comment": {
    "de": [
      "Traditionelle Verpflegung\r\nHausgemachte Küche mit frischen Produkten\r\nSchattige Terrasse, Kinderspielplatz im Freien\r\nBouleplatz und Tischtennisplatte stehen zur Verfügung\r\nGroßer Privatparkplatz"
    ],
    "en": [
      "Traditional catering\r\nHome cooking using fresh produce\r\nShaded terrace, outdoor children's play area\r\nPétanque court & Ping-Pong table available\r\nAmple private parking"
    ],
    "it": [
      "Ristoranti tradizionali\r\nCucina casalinga con prodotti freschi\r\nTerrazza ombreggiata, area giochi per bambini all'aperto\r\nCampo da bocce e ping pong a disposizione\r\nAmpio parcheggio privato"
    ],
    "fr": [
      "Restauration traditionnelle \r\nCuisine maison à base de produits frais \r\nTerrasse ombragée, aire de jeux enfants à l’extérieur \r\nTerrain de Pétanque & Table de Ping Pong à disposition \r\nGrand parking privé"
    ],
    "nl": [
      "Traditionele restaurants\r\nThuis koken met verse producten\r\nSchaduwrijk terras, kinderspeelplaats buiten\r\nJeu de boules baan en tafeltennis beschikbaar\r\nGrote privéparkeerplaats"
    ],
    "es": [
      "Restaurantes tradicionales\r\nCocina casera con productos frescos\r\nTerraza sombreada, zona de juegos para niños al aire libre\r\nPista de petanca y tenis de mesa\r\nAmplio aparcamiento privado"
    ]
  },
