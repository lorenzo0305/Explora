  "rdfs:comment": {
    "de": [
      "Das Stelsia Casino in Châtel-Guyon lädt Sie ein, Momente einzigartiger Unterhaltung zu erleben. Entdecken Sie 75 Spielautomaten, elektronisches Roulette und Black Jack. Verlängern Sie das Erlebnis mit unserer Bar / Snack und dem Place des Etoiles."
    ],
    "en": [
      "The Stelsia Casino in Châtel-Guyon invites you to experience unique moments of entertainment. Discover 75 slot machines, electronic roulette and Black Jack. Extend the experience with our bar/snack bar and the Place des Etoiles."
    ],
    "it": [
      "Il Casinò Stelsia di Châtel-Guyon vi invita a vivere momenti di intrattenimento unici. Scoprite 75 slot machine, roulette elettronica e Black Jack. Per prolungare l'esperienza, il nostro bar/snack bar e la Place des Etoiles sono a vostra disposizione."
    ],
    "fr": [
      "Le Stelsia Casino de Châtel-Guyon vous invite à vivre des moments de divertissement unique. Découvrez 75 machines à sous, la roulette électronique et le Black Jack. Prolongez l’expérience avec notre bar / snack et la Place des Etoiles."
    ],
    "nl": [
      "Het Stelsia Casino in Châtel-Guyon nodigt je uit om unieke momenten van entertainment te beleven. Ontdek 75 speelautomaten, elektronische roulette en Black Jack. Breid de ervaring uit met onze bar / snackbar en de Place des Etoiles."
    ],
    "es": [
      "El Casino Stelsia de Châtel-Guyon le invita a vivir momentos únicos de entretenimiento. Descubra 75 máquinas tragaperras, ruleta electrónica y Black Jack. Amplíe la experiencia con nuestro bar / snack bar y la Place des Etoiles."
    ]
  },
