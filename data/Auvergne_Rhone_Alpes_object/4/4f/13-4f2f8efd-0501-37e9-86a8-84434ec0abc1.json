  "rdfs:comment": {
    "de": [
      "Verkauf von geschmiedeten Klappmessern, feststehenden Messern und Besteck.\r\nJedes Messer, das ich im Atelier 1871 herstelle, ist das Ergebnis eines handwerklichen Prozesses."
    ],
    "en": [
      "Sale of forged folding knives, fixed knives and cutlery courses.\r\nEvery knife I create at Atelier 1871 is the fruit of an entirely artisanal process."
    ],
    "it": [
      "Vendita di coltelli pieghevoli forgiati, coltelli fissi e corsi di coltelleria.\r\nOgni coltello che creo all'Atelier 1871 è il frutto di un processo interamente tradizionale."
    ],
    "fr": [
      "Vente de couteaux forgés pliant,fixe et stage de coutellerie. \r\nChaque couteau que je crée au seins d’Atelier 1871 est le fruit d’un processus entièrement artisanal."
    ],
    "nl": [
      "Verkoop van gesmede vouwmessen, vaste messen en bestekcursussen.\r\nElk mes dat ik maak bij Atelier 1871 is het resultaat van een volledig traditioneel proces."
    ],
    "es": [
      "Venta de cuchillos plegables forjados, cuchillos fijos y cursos de cuchillería.\r\nCada cuchillo que creo en Atelier 1871 es fruto de un proceso totalmente artesanal."
    ]
  },
