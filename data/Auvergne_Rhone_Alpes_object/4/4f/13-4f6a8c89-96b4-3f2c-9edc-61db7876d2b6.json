  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel eines großen Parks mit Bäumen überragt L'Incomparable den Lac du Bourget, umgeben von den Bergen. Das ideal gelegene Haus ist hedonistisch. Das Wohlbefinden wird innen und außen gelebt?"
    ],
    "en": [
      "High in a large wooded park, L'Incomparable overlooks Lake Bourget, surrounded by mountains. Ideally located, the house is luxurious. Well-being both indoors and outdoors..."
    ],
    "it": [
      "Sulla cima di un grande parco alberato, L'Incomparable domina il Lago del Bourget, circondato dalle montagne. La casa edonistica gode di una posizione ideale. Benessere all'interno e all'esterno..."
    ],
    "fr": [
      "Au sommet d’un grand parc arboré, L'Incomparable surplombe le Lac du Bourget, entouré par les montagnes. Idéalement située, la maison est hédoniste. Le bien-être se vit à l’intérieur et à l’extérieur…"
    ],
    "nl": [
      "Op de top van een groot bebost park kijkt L'Incomparable uit over het Lac du Bourget, omgeven door bergen. Ideaal gelegen, is dit een huis voor levensgenieters. Het welzijn wordt van binnen en buiten ervaren"
    ],
    "es": [
      "En lo alto de un gran parque arbolado, L'Incomparable domina el Lac du Bourget, rodeado de montañas. Idealmente situada, es una casa para hedonistas. El bienestar se experimenta por dentro y por fuera?"
    ]
  },
