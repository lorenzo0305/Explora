  "rdfs:comment": {
    "de": [
      "Magnetismus & Bioresonanz: Sofortige Linderung.\r\nAls gebürtige Magnetiseurin und Bioresonanzpraktikerin praktiziere ich seit 20 Jahren und kann körperliche und geistige Spannungen sowie tiefe emotionale Blockaden (in der Seele geprägt) lindern."
    ],
    "en": [
      "Magnetism & Bioresonance: Immediate relief.\nA born magnetizer and Bioresonance practitioner, I've been practicing for 20 years and can relieve physical and mental tensions, as well as deep emotional blockages (marked in the soul)."
    ],
    "it": [
      "Magnetismo e biorisonanza: sollievo immediato.\r\nMagnetizzatore e biorisonante nato, pratico da 20 anni e sono in grado di alleviare tensioni fisiche e mentali, nonché blocchi emotivi profondi (segnati nell'anima)."
    ],
    "fr": [
      "Magnétisme & Biorésonance : Soulagement Immédiat.\r\nMagnétiseur de naissance et praticien en Biorésonance, je pratique depuis 20 ans et peux soulager les tensions physiques, mentales, ainsi que les blocages émotionnels profonds (marqués dans l'âme)."
    ],
    "es": [
      "Magnetismo y Biorresonancia: Alivio inmediato.\r\nMagnetizadora nata y practicante de biorresonancia, llevo 20 años practicando y puedo aliviar tensiones físicas y mentales, así como bloqueos emocionales profundos (marcados en el alma)."
    ],
    "nl": [
      "Magnetisme & Bioresonantie: onmiddellijke verlichting.\nIk ben een geboren magnetiseur en bioresonantiebeoefenaar, ik beoefen dit al 20 jaar en kan fysieke en mentale spanning verlichten, evenals diepe emotionele blokkades (gemarkeerd in de ziel)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Alexis Pigneur - Magnetizer"
    ],
    "fr": [
      "Alexis Pigneur - Magnétiseur"
    ],
    "nl": [
      "Alexis Pigneur - Magnetiseur"
    ]
  },
