  "rdfs:comment": {
    "de": [
      "Den Berg zum Leben erwecken. Entdecken Sie ihn auf der Seite von Spaß und Farbe neu. Ihn draußen fröhlich lieben und drinnen die Fröhlichkeit verlängern: Das ist die vitaminreiche Version, die das Hotel Ormelune anbietet"
    ],
    "en": [
      "Let the mountains shake up your senses. Explore another dimension, jam-packed with vibrant fun and intense colour. Capture the thrill of the great outdoors and haul it inside to prolong the pleasure: recharge your batteries, discover the pepped up version of the mountain holiday on offer at the Hotel Ormelune, in Val d’Isère, Savoie."
    ],
    "it": [
      "Risvegliare la montagna. Riscoprirla in modo divertente e colorato. Amarla con gioia all'esterno e prolungare l'allegria all'interno: questa è la versione vitaminica offerta dall'hotel Ormelune"
    ],
    "fr": [
      "Réveiller la montagne. La redécouvrir versant fun & couleur. L'aimer joyeusement dehors et prolonger la gaité dedans : c'est la version vitaminée que propose l'hôtel Ormelune"
    ],
    "nl": [
      "Wakker worden in de bergen. Herontdek de leuke en kleurrijke kant. Buiten genieten en het plezier binnen uitbreiden: dat is de vitaminerijke versie die wordt aangeboden in hotel Ormelune"
    ],
    "es": [
      "Despertar de las montañas. Redescubrir el lado divertido y colorido. Amar el exterior y prolongar la alegría en el interior: esa es la versión vitaminada que ofrece el hotel Ormelune"
    ]
  },
