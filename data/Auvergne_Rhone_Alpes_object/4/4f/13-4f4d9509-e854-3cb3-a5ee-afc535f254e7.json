  "rdfs:comment": {
    "de": [
      "Das Hammam ist ganz dem Wellness gewidmet und heißt Sie in seinen Räumlichkeiten in Pierrelatte willkommen. Lassen Sie sich von der Magie und Atmosphäre unseres Instituts (Hammam - Sauna) verzaubern."
    ],
    "en": [
      "Located in Pierrelatte, the Hamman is dedicated to relaxation and wellness. Indulge in the magic and peaceful atmosphere of our spa (hammam - sauna)."
    ],
    "it": [
      "Area benessere a Pierrelatte.\r\nServizi di benessere con accesso all'hammam, alla sauna e alla vasca idromassaggio. Sala per trattamenti singoli o in coppia. Modellamento rilassante da 30 a 60 minuti. Trattamenti viso. Trattamenti di bellezza. Pacchetti e carte regalo."
    ],
    "fr": [
      "Espace bien être à Pierrelatte. \r\nPrestations de bien être avec accès au hammam, sauna et bain à remous. Cabine de soin solo ou duo. Modelage détente de 30 à 60 minutes. Soin du visage. Soin esthétique. Coffrets et Cartes cadeaux."
    ],
    "es": [
      "Zona de bienestar en Pierrelatte.\r\nServicios de bienestar con acceso al hammam, la sauna y la bañera de hidromasaje. Sala de tratamientos en solitario o en dúo. Modelado relajante de 30 a 60 minutos. Tratamientos faciales. Tratamientos de belleza. Packs y tarjetas regalo."
    ],
    "nl": [
      "Hammam in Pierrelatte, een echte wellnessruimte. Laat u vervoeren door de \r\nmagie en de sfeer van ons instituut (hammam-sauna)."
    ]
  },
