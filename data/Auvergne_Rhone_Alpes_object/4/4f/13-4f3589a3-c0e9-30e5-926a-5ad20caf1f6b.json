  "rdfs:comment": {
    "de": [
      "Das Restaurant Bonté Divine in Roanne ist ein kulinarisches Juwel, das eine einfallsreiche und schmackhafte Küche aus frischen Produkten anbietet. Das Restaurant befindet sich im Stadtzentrum und ist eine unumgängliche Adresse."
    ],
    "en": [
      "The Bonté Divine restaurant in Roanne is a culinary gem, offering inventive, tasty cuisine based on fresh produce. Located in the city center, this restaurant is a must."
    ],
    "it": [
      "Il ristorante Bonté Divine di Roanne è un vero gioiello culinario che offre una cucina inventiva e gustosa a base di prodotti freschi. Situato nel centro della città, questo ristorante è una tappa obbligata."
    ],
    "fr": [
      "Le restaurant Bonté Divine à Roanne est un véritable joyau culinaire, proposant une cuisine inventive et savoureuse à base de produits frais. Situé dans le centre-ville, ce restaurant est une adresse incontournable."
    ],
    "nl": [
      "Het restaurant Bonté Divine in Roanne is een echt culinair juweeltje met een inventieve, smakelijke keuken op basis van verse producten. Dit restaurant ligt in het stadscentrum en is een aanrader."
    ],
    "es": [
      "El restaurante Bonté Divine de Roanne es una auténtica joya culinaria que ofrece una cocina creativa y sabrosa basada en productos frescos. Situado en el centro de la ciudad, este restaurante es una visita obligada."
    ]
  },
