  "rdfs:comment": {
    "de": [
      "Am Eingang der Stadt Sallanches erwartet Sie das Hotel Ibis.\r\nWir kümmern uns um Sie: ein Team, das Ihnen Tag und Nacht zuhört, Ihr Schlaf ist unsere Priorität mit einem modernen und schallisolierten Zimmer."
    ],
    "en": [
      "Hôtel Ibis awaits on the edge of Sallanches.\r\nWe'll take care of you: a team is here for you day and night, your restful sleep is our priority, enjoy a modern sound-proof room."
    ],
    "it": [
      "All'ingesso della città di Sallanches, l'hotel Ibis vi attende.\r\nCi prendiamo cura di voi: un team a vostra disposizione giorno e notte, il vostro riposo è la nostra priorità, grazie a camere moderne e insonorizzate."
    ],
    "fr": [
      "A l'entrée de la ville de Sallanches, l'hôtel Ibis vous attend.\r\nNous prenons soin de vous: une équipe à votre écoute jour et nuit, votre sommeil est notre priorité avec une chambre moderne et insonorisée."
    ],
    "nl": [
      "Bij de ingang van de stad Sallanches wacht het Ibis hotel op u.\r\nWij zorgen voor u: een team dat dag en nacht naar u luistert, uw nachtrust is onze prioriteit met een moderne en geluiddichte kamer."
    ],
    "es": [
      "A la entrada de la ciudad de Sallanches, el hotel Ibis le espera.\r\nCuidamos de ti: un equipo que te escucha día y noche, tu sueño es nuestra prioridad con una habitación moderna e insonorizada."
    ]
  },
