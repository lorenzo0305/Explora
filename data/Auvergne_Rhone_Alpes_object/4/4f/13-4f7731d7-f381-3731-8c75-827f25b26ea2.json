  "rdfs:comment": {
    "de": [
      "Die Hütte von Père Tasse in Chamrousse 1750 - Roche Béranger wurde zu einem Bergrestaurant auf den Pisten.\r\nDie Chalet du Père Tasse ist ein Überbleibsel des lokalen Kulturerbes, ein Symbol der Berggeschichte und des Aufschwungs des Tourismus in den Alpen."
    ],
    "en": [
      "The Père Tasse refuge at Chamrousse 1750 - Roche Béranger, has become a high-altitude restaurant on the slopes called \"La Croisette\" (formerly the Malamute).\r\nThe Chalet du Père Tasse is a vestige of local cultural heritage, a symbol of mountain history and the rise of tourism in the Alps."
    ],
    "it": [
      "Il rifugio del Père Tasse a Chamrousse 1750 - Roche Béranger è diventato un ristorante di montagna sulle piste. Lo Chalet du Père Tasse è una testimonianza del patrimonio culturale locale, un simbolo della storia della montagna e dello sviluppo del turismo."
    ],
    "fr": [
      "Le refuge du Père Tasse situé à Chamrousse 1750 - Roche Béranger, est devenu un restaurant d’altitude sur les pistes. Le Chalet du Père Tasse est un vestige du patrimoine culturel local, un symbole de l'histoire montagnarde et de l'essor du tourisme."
    ],
    "es": [
      "El refugio del Père Tasse en Chamrousse 1750 - Roche Béranger se ha convertido en un restaurante de montaña en las pistas. El Chalet du Père Tasse es un vestigio del patrimonio cultural local, un símbolo de la historia de la montaña y del desarrollo del turismo."
    ],
    "nl": [
      "De berghut Père Tasse in Chamrousse 1750 - Roche Béranger is een bergrestaurant op de piste geworden. Het Chalet du Père Tasse is een overblijfsel van het lokale culturele erfgoed, een symbool van de berggeschiedenis en de ontwikkeling van het toerisme."
    ]
  },
  "rdfs:label": {
