      "@id": "https://data.datatourisme.fr/7c4b451c-184d-3dfe-a501-09991b7489b7",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\nFinden Sie die Produkte von L'étoile d'A auf seiner Website und seiner Facebook-Seite\n \n Verkauf zum Mitnehmen :\n\nAbholung im Atelier nach telefonischer Vereinbarung unter 06 63 56 57 80\n\nPostversand :\n\n4? Versandkosten\n\nInformationen unter 06 63 56 57 80\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\nFind L'étoile d'A products on its website and Facebook page\n \n Takeaway:\n\nPick-up at the workshop by appointment by phone 06 63 56 57 80\n\nPostal delivery:\n\n4? postage\n\nFor further information, call 06 63 56 57 80\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\nTrovate i prodotti L'étoile d'A sul suo sito web e sulla sua pagina Facebook\n \n Da asporto:\n\nRitiro presso l'atelier su appuntamento telefonico al numero 06 63 56 57 80\n\nConsegna postale :\n\n4? affrancatura\n\nPer ulteriori informazioni, chiamare il numero 06 63 56 57 80\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits :\nRetrouvez les produits de L'étoile d'A sur son site internet et sa page Facebook\n \n Vente à emporter :\n\nRetrait à l'atelier sur rendez-vous par téléphone au 06 63 56 57 80\n\nEnvoi postal : \n\n4€ de frais de port\n\nRenseignements au 06 63 56 57 80\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\nVind de producten van L'étoile d'A op haar website en Facebook-pagina\n \n Meenemen:\n\nAfhalen in het atelier na telefonische afspraak op 06 63 56 57 80\n\nPostbezorging :\n\n4? porto\n\nVoor meer informatie, bel 06 63 56 57 80\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\nEncuentre los productos de L'étoile d'A en su sitio web y en su página de Facebook\n \n Para llevar:\n\nRecogida en el estudio previa cita en el teléfono 06 63 56 57 80\n\nEntrega por correo :\n\nportes de 4?\n\nPara más información, llame al 06 63 56 57 80\n\n "
        ]
      },
