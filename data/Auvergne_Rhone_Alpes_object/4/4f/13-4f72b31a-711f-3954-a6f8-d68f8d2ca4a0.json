  "rdfs:comment": {
    "de": [
      "Kino mit Digitaltechnik, 3D, Fidelio-System für hörgeschädigte und blinde Menschen.\r\nAnerkannter Saal \"ART & ESSAI\". und Teil des Netzwerks Auvergne der unabhängigen Kinos \"Plein champ\"."
    ],
    "en": [
      "Cinema equipped with digital technology, 3D, Fidélio system for the hearing-impaired and blind.\r\nRecognized as an \"ART & ESSAI\" cinema and part of the Auvergne network of independent \"Plein champ\" cinemas."
    ],
    "it": [
      "Cinema dotato di tecnologia digitale, 3D, sistema Fidélio per audiolesi e non vedenti.\r\nRiconosciuto come cinema \"ART & ESSAI\" e parte della rete di cinema indipendenti \"Plein champ\" dell'Alvernia."
    ],
    "fr": [
      "Cinéma équipé en numérique, 3D, système Fidélio pour les personnes malentendantes et aveugles.\r\nSalle reconnue « ART & ESSAI ».  et  faisant partie du réseau Auvergne des cinémas indépendants \"Plein champ\"."
    ],
    "es": [
      "Cine equipado con tecnología digital, 3D, sistema Fidélio para sordos e invidentes.\r\nReconocido como cine \"ART & ESSAI\" y parte de la red Auvergne de cines independientes \"Plein champ\"."
    ],
    "nl": [
      "Bioscoop uitgerust met digitale technologie, 3D, Fidélio-systeem voor slechthorenden en blinden.\r\nErkend als \"ART & ESSAI\" bioscoop en deel van het Auvergne netwerk van onafhankelijke \"Plein champ\" bioscopen."
    ]
  },
