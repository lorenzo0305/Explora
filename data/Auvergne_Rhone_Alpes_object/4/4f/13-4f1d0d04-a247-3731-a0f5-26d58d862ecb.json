  "rdfs:comment": {
    "de": [
      "Entlang des Kurzwanderwegs \"Les collines de Mazerier\" befinden sich die Rasen der Diagots, die reich an wilden Orchideen sind und im Frühling beobachtet werden können."
    ],
    "en": [
      "Along the small hiking route \"the hills of Mazerier\" (on the communes of Jenzat, Mazerier and Saulzet), 3 reading tables invite to discover the steppe lawns of the plateaus."
    ],
    "it": [
      "Lungo il breve sentiero escursionistico \"Les collines de Mazerier\" si trovano i prati di Diagots, ricchi di orchidee selvatiche da ammirare in primavera."
    ],
    "fr": [
      "Le long de l'itinéraire de petite randonnée \"Les collines de Mazerier\" se trouvent les pelouses des Diagots riches en orchidées sauvages à observer au printemps."
    ],
    "nl": [
      "Langs de korte wandelroute \"Les collines de Mazerier\" liggen de Diagots grasvelden, rijk aan wilde orchideeën die in de lente te zien zijn."
    ],
    "es": [
      "A lo largo de la corta ruta de senderismo \"Les collines de Mazerier\" se encuentran los prados de Diagots, ricos en orquídeas silvestres que se pueden contemplar en primavera."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hike"
    ],
    "fr": [
      "Pelouses des Diagots"
    ]
  },
