  "rdfs:comment": {
    "de": [
      "Die Bar des Hotels la Chaudanne ist der ideale Ort, um einen Moment der Entspannung mit Freunden oder der Familie zu genießen ... nach einem Tag voller Aktivitäten im Freien, Aperitif oder auch Snacks!"
    ],
    "en": [
      "The bar of la Chaudanne hotel is a perfect way to relax with friends or with family... tea time after a skiing day, apéritif or snacking!"
    ],
    "it": [
      "Il bar dell'hotel La Chaudanne è il luogo ideale per rilassarsi con gli amici o la famiglia... dopo una giornata di attività all'aperto, un aperitivo o uno spuntino!"
    ],
    "fr": [
      "Le bar de l'hôtel la Chaudanne est le lieu idéal pour profiter d’un moment de détente entre amis ou en famille ... après votre journée d'activités extérieures, apéritif ou encore snacking !"
    ],
    "es": [
      "El bar del hotel La Chaudanne es el lugar ideal para relajarse con los amigos o la familia... después de un día de actividades al aire libre, ¡un aperitivo o un tentempié!"
    ],
    "nl": [
      "De bar van hotel la Chaudanne is de ideale plek voor een ontspannen moment met vrienden of familie ... theetijd na een dag skiën, aperitief of snacken!"
    ]
  },
