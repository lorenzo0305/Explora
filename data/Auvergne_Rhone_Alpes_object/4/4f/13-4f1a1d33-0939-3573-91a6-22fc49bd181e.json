  "rdfs:comment": {
    "de": [
      "Die Pizzeria Squadretta bietet Ihnen neapolitanische Pizzen, die von A bis Z hausgemacht sind, mit lokalen Produkten und direkt aus Italien! Sie befindet sich nur 3 km vom Bahnhof Vichy entfernt. Die Pizzen können Sie vor Ort genießen oder mitnehmen."
    ],
    "en": [
      "Pizzeria Squadretta offers home-made Neapolitan pizzas from A to Z, using local produce direct from Italy! It's just 3 kilometers from the Vichy train station. Pizzas are available to eat in or take away."
    ],
    "it": [
      "La Pizzeria Squadretta vi offre pizze napoletane fatte in casa dalla A alla Z, utilizzando prodotti locali direttamente dall'Italia! Si trova a soli 3 chilometri dalla stazione di Vichy. Le pizze sono disponibili per il consumo o per l'asporto."
    ],
    "fr": [
      "La Pizzeria Squadretta vous propose des pizzas Napolitaines faites maison de A à Z, avec des produits locaux et directement venus d'Italie ! Elle se situe à seulement 3 kilomètres de la gare de Vichy. Les pizzas sont à déguster sur place ou à emporter."
    ],
    "nl": [
      "Pizzeria Squadretta biedt u huisgemaakte Napolitaanse pizza's van A tot Z, met lokale producten rechtstreeks uit Italië! Het ligt op slechts 3 kilometer van het station van Vichy. Pizza's zijn beschikbaar om te eten of om mee te nemen."
    ],
    "es": [
      "La Pizzería Squadretta le ofrece pizzas napolitanas caseras de la A a la Z, elaboradas con productos locales directamente de Italia Está a sólo 3 kilómetros de la estación de Vichy. Las pizzas están disponibles para comer en el restaurante o para llevar."
    ]
  },
