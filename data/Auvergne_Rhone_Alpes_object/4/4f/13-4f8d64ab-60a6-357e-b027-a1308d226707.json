  "rdfs:comment": {
    "de": [
      "Handgemachte Kreationen mit Leidenschaft!\r\ngravuren\r\npersonalisierung auf verschiedenen Medien\r\nschmuck, Kugelschreiber, Uhren, Gemälde, Fächer, Lesezeichen, Zeichnungen, etc.\r\nholz, Harz, Blumen, Cyanotypie\r\n? Atelier\r\nKreation anhand Ihrer Erwartungen auf Anfrage"
    ],
    "en": [
      "Handmade with passion!\r\nengravings\r\nmulti-media personalization\r\njewelry, pens, clocks, paintings, fans, bookmarks, drawings, etc.\r\nwood, resin, flowers, cyanotype\r\n? Workshop\r\nCreation to your specifications on request"
    ],
    "it": [
      "Fatti a mano con passione!\r\nincisioni\r\npersonalizzazione su più supporti\r\ngioielli, penne, orologi, quadri, ventagli, segnalibri, disegni, ecc.\r\nlegno, resina, fiori, cianotipia\r\n? Officina\r\nCreazione su misura su richiesta"
    ],
    "fr": [
      "Créations faites mains et avec passion!\r\n☆Gravures\r\n☆Personnalisation multi-support\r\n☆Bijoux, stylo, horloge, peinture, éventail, marque page, dessin, etc.\r\n☆Bois, résine, fleurs, cyanotype\r\n☆ Atelier\r\nCréation à partir de vos attentes sur demande"
    ],
    "es": [
      "Hecho a mano con pasión\r\ngrabados\r\npersonalización multisoporte\r\njoyas, bolígrafos, relojes, cuadros, abanicos, marcapáginas, dibujos, etc.\r\nmadera, resina, flores, cianotipia\r\n? Taller\r\nCreación a medida previa solicitud"
    ],
    "nl": [
      "Handgemaakt met passie!\r\ngravures\r\npersonalisatie met meerdere dragers\r\nsieraden, pennen, klokken, schilderijen, waaiers, boekenleggers, tekeningen, enz.\r\nhout, hars, bloemen, cyanotype\r\n? Werkplaats\r\nCreatie volgens uw specificaties op aanvraag"
    ]
  },
