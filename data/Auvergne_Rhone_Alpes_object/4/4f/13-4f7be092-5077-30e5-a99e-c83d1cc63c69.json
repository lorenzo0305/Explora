  "rdfs:comment": {
    "de": [
      "Diese romanische Kirche aus Kasadien hat die Besonderheit, dass sie am Eingang einen Zehntenstein in Form einer Gabel hat."
    ],
    "en": [
      "This roman church’s main feature is a tithe stone in the shape of the local cheese (la ‘fourme’) at the church entrance."
    ],
    "it": [
      "Questa chiesa romanica casadese ha la particolarità di avere una pietra della decima a forma di \"fourme\" all'ingresso."
    ],
    "fr": [
      "Cette église romane casadéenne a la particularité d'avoir une pierre de dîme en forme de fourme à l'entrée."
    ],
    "es": [
      "Esta iglesia románica casadea tiene la particularidad de tener una piedra del diezmo en forma de \"fourme\" en la entrada."
    ],
    "nl": [
      "Deze romaanse Casadeense kerk heeft als bijzonderheid dat bij de ingang een tiendsteen in de vorm van een \"fourme\" staat."
    ]
  },
