  "rdfs:comment": {
    "de": [
      "Organisiert von der städtischen Kulturabteilung, unter Mitwirkung des Vereins En faim de contes.\r\nIm Anschluss an den Kreativworkshop können Sie sich mit Märchen, die von der Vereinigung En Faim de Contes ausgewählt und erzählt werden, in das Thema Karneval vertiefen."
    ],
    "en": [
      "Organised by the municipal cultural department, with the participation of the En faim de contes association.\r\nFollowing the creative workshop, get into the carnival spirit with stories selected and narrated by the En faim de contes association."
    ],
    "it": [
      "Organizzato dal servizio culturale comunale, con la partecipazione dell'associazione En faim de contes.\r\nDopo il laboratorio creativo, entrate nello spirito carnevalesco con le fiabe scelte e raccontate dall'associazione En Faim de Contes."
    ],
    "fr": [
      "Organisé par le service culturel municipal, avec la participation de l’association En faim de contes.\r\nÀ la suite de l’atelier créatif, entrez dans la thématique du carnaval avec des contes choisis et contés par l’association en Faim de Contes."
    ],
    "es": [
      "Organizado por el servicio cultural municipal, con la participación de la asociación En faim de contes.\r\nTras el taller creativo, sumérgete en el espíritu carnavalesco con cuentos elegidos y narrados por la asociación En Faim de Contes."
    ],
    "nl": [
      "Georganiseerd door de gemeentelijke culturele dienst, met medewerking van de vereniging En faim de contes.\r\nKom na de creatieve workshop in de carnavalsstemming met verhalen die zijn uitgekozen en verteld door de vereniging En Faim de Contes."
    ]
  },
