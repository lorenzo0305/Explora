  "rdfs:comment": {
    "de": [
      "Die Kapelle befindet sich auf einem 696 m hohen Vorsprung. Sie wurde auf und mit den Steinen des Schlosses Saint-Jacques erbaut und kürzlich restauriert. Ein angenehmer Pfad führt von Saint Marcel zu ihr."
    ],
    "en": [
      "The chapel culminates on a promontory at 696 m. It was built on and with the stones of the castle Saint-Jacques and was recently restored. A pleasant path allows access to the site from Saint Marcel."
    ],
    "it": [
      "La cappella culmina su un promontorio a 696 metri. È stata costruita sulle e con le pietre del castello Saint-Jacques ed è stata recentemente restaurata. Un piacevole sentiero pedonale conduce al sito da Saint Marcel."
    ],
    "fr": [
      "La chapelle culmine sur un promontoire à 696 m. Elle fût construite sur et avec les pierres du château Saint-Jacques et fût restaurée récemment. Un sentier agréable permet d'accéder au site depuis Saint Marcel."
    ],
    "es": [
      "La capilla culmina en un promontorio a 696 m. Fue construida sobre y con las piedras del castillo Saint-Jacques y restaurada recientemente. Un agradable sendero conduce al lugar desde Saint Marcel."
    ],
    "nl": [
      "De kapel culmineert op een kaap op 696 m hoogte. Ze werd gebouwd op en met de stenen van het kasteel Saint-Jacques en werd onlangs gerestaureerd. Een aangenaam wandelpad leidt naar de site vanuit Saint Marcel."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Jacques chapel"
    ],
    "fr": [
      "La chapelle Saint-Jacques"
    ]
  },
