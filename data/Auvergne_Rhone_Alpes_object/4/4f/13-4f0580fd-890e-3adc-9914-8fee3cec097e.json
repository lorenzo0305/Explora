  "rdfs:comment": {
    "de": [
      "Privater Gemeinschaftsteich von 1 ha Größe, in dem hauptsächlich Forellen, Fritten und Karpfen leben. Geöffnet für die Öffentlichkeit mit Jahres- oder Tageskarte.\r\n10 Forellensafaris werden von März bis Juni organisiert und sind mit der Jahreskarte kostenlos."
    ],
    "en": [
      "A private pond size of 1 ha open to the public with a daily or annual fishing permit. Ten trout safaris orga nized per year, free with the annual fishing permit."
    ],
    "it": [
      "Laghetto privato comunale di 1 ha con prevalenza di trote, avannotti e carpe. Aperto al pubblico con tessera annuale o giornaliera.\r\n10 safari alla trota organizzati da marzo a giugno, gratuiti con la tessera annuale."
    ],
    "fr": [
      "Etang communal privé de 1ha avec à l'intérieur principalement  des truites, fritures et carpes. Ouvert au public détenteur de la carte annuelle ou journalière.\r\n10 safaris de truites organisés de mars a juin gratuit avec la carte annuelle."
    ],
    "nl": [
      "Gemeenschappelijke privévijver van 1ha met voornamelijk forel, pootvis en karper. Open voor publiek met jaar- of dagkaart.\r\n10 forelsafari's georganiseerd van maart tot juni, gratis met jaarkaart."
    ],
    "es": [
      "Estanque comunitario privado de 1ha con truchas, alevines y carpas principalmente. Abierto al público con pase anual o de un día.\r\nse organizan 10 safaris de trucha de marzo a junio, gratuitos con el pase anual."
    ]
  },
