  "rdfs:comment": {
    "de": [
      "Im touristischen und fußläufigen Herzen der Altstadt in einem gemütlichen Dekor bietet das Restaurant eine Speisekarte mit frischen und saisonalen Produkten. Die Kunst des guten Essens und Trinkens wird hier gepflegt!"
    ],
    "en": [
      "In the tourist and pedestrian heart of the old town, in a cosy setting, the restaurant offers a menu featuring fresh, seasonal produce. The art of eating and drinking well is cultivated here!"
    ],
    "it": [
      "Nel cuore turistico e pedonale della città vecchia, in un ambiente accogliente, il ristorante offre un menu con prodotti freschi e di stagione. Qui si coltiva l'arte di mangiare e bere bene!"
    ],
    "fr": [
      "Dans le cœur touristique et piéton de la vieille ville dans un décor cosy, le restaurant vous propose une carte avec des produits frais et de saison. L'art du bien manger et du bien boire y est cultivé ici !"
    ],
    "nl": [
      "In het autovrije toeristische hart van de oude stad, in een gezellige omgeving, biedt het restaurant een menu met verse seizoensproducten. Hier wordt de kunst van het goed eten en drinken gecultiveerd!"
    ],
    "es": [
      "En el corazón turístico y peatonal del casco antiguo, en un ambiente acogedor, el restaurante ofrece una carta con productos frescos y de temporada. ¡Aquí se cultiva el arte de comer y beber bien!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Tire-Bouchon"
    ]
  },
