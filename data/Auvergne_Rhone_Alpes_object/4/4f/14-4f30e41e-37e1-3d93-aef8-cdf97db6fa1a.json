      "@id": "https://data.datatourisme.fr/c9bb92a5-4186-35dd-8142-728e27d0c9dc",
      "dc:description": {
        "de": [
          "Organisiert vom Festkomitee\nSamstag, 15. November von 13.30 bis 17.30 Uhr\nEspace Spinétois - Lepine\n--------------------------\nVeranstaltung im Innenbereich\n2 Meter pro Aussteller - Selbstgemachte Crêpes\n\nPreis: 2? für Aussteller/kostenlos für Besucher\nReservierungen: 06 10 24 24 73 - Per E-Mail: lepinecomitedesfetes@gmail.com\n\nKredit: Comité des fêtes Lépine"
        ],
        "en": [
          "Organized by the Comité des Fêtes\nSaturday, November 15 from 1:30 pm to 5:30 pm\nEspace Spinétois - Lépine\n--------------------------\nIndoor event\n2 meters per exhibitor - Home-made crepes\n\nPrice: 2? for exhibitors/Free for visitors\nReservations: 06 10 24 24 73 - By e-mail: lepinecomitedesfetes@gmail.com\n\nCredit: Comité des fêtes Lépine"
        ],
        "it": [
          "Organizzato dal Comitato delle Feste\nSabato 15 novembre dalle 13.30 alle 17.30\nSpazio Spinétois - Lépine\n--------------------------\nEvento al coperto\n2 metri per espositore - Crêpes fatte in casa\n\nPrezzo: 2? per gli espositori / gratuito per i visitatori\nPrenotazioni: 06 10 24 24 73 - Per e-mail: lepinecomitedesfetes@gmail.com\n\nCrediti: Comitato delle feste di Lépine"
        ],
        "fr": [
          "Organisé par le Comité des Fêtes\nSamedi 15 novembre de 13h30 à 17h30\nEspace Spinétois - Lépine\n--------------------------\nManifestation en intérieur\n2 mètres par exposant - Crêpes maison\n\nTarif : 2€ pour les exposants/Gratuit pour les visiteurs\nRéservations : 06 10 24 24 73 - Par mail : lepinecomitedesfetes@gmail.com\n\nCrédit : Comité des fêtes Lépine"
        ],
        "es": [
          "Organizado por el Comité de Fiestas\nSábado 15 de noviembre de 13.30 a 17.30 horas\nEspacio Spinétois - Lépine\n--------------------------\nEvento en interior\n2 metros por expositor - Crepes caseros\n\nPrecio: 2? para expositores/Gratis para visitantes\nReservas: 06 10 24 24 73 - Por correo electrónico: lepinecomitedesfetes@gmail.com\n\nCrédito: Comité des fêtes Lépine"
        ],
        "nl": [
          "Georganiseerd door het Comité des Fêtes\nZaterdag 15 november van 13.30 tot 17.30 uur\nEspace Spinétois - Leipine\n--------------------------\nBinnenevenement\n2 meter per standhouder - Huisgemaakte crêpes\n\nPrijs: 2? voor exposanten/Gratis voor bezoekers\nReserveren: 06 10 24 24 73 - Per e-mail: lepinecomitedesfetes@gmail.com\n\nKrediet: Comité des fêtes Lépine"
        ]
      },
