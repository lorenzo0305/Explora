  "rdfs:comment": {
    "de": [
      "L'Ecu de France Logis Restaurant Gourmand, ehemaliges Postrelais, in einem authentischen und gemütlichen Rahmen. Entdecken Sie eine semi-gastronomische, traditionelle oder vegetarische Küche sowie Produkte aus der Region."
    ],
    "en": [
      "In a cosy and authentic setting, come and savour a semi-gourmet, traditional and regional cuisine. Made with local produce, we also invite you to discover our vegetarian cuisine."
    ],
    "it": [
      "L'Ecu de France Logis Restaurant Gourmand, ex Relais de Poste, in un ambiente autentico e accogliente, venite a scoprire una cucina semi-gastronomica, tradizionale o vegetariana e i prodotti locali."
    ],
    "fr": [
      "L'Ecu de France Logis Restaurant Gourmand, ancien Relais de Poste, dans un cadre authentique et cosy, venez découvrir une cuisine semi-gastronomique, traditionnelle ou végétarienne ainsi que des produits du terroir."
    ],
    "nl": [
      "L'Ecu de France Logis Restaurant Gourmand, voormalig Relais de Poste, in een authentiek en gezellig kader, kom een semi-gastronomische, traditionele of vegetarische keuken en streekproducten ontdekken."
    ],
    "es": [
      "L'Ecu de France Logis Restaurant Gourmand, antiguo Relais de Poste, en un entorno auténtico y acogedor, venga a descubrir una cocina semigastronómica, tradicional o vegetariana, así como productos locales."
    ]
  },
