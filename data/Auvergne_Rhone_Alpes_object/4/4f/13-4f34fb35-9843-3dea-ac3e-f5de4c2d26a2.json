  "rdfs:comment": {
    "de": [
      "Die Domaine de Saint-Clair ist eine außergewöhnliche Anlage mit 54 geräumigen und hellen Zimmern, die sich im Herzen eines 18-Loch-Golfplatzes befindet."
    ],
    "en": [
      "Domaine de Saint Clair is an amazing spot in the middle of an 18-hole golf course: 54 modern rooms and apartments conceived for your comfort. There are also a 1 star restaurant, a bar and a wellness centre."
    ],
    "it": [
      "Il Domaine de Saint-Clair è un sito eccezionale con 54 camere spaziose e luminose, situato nel cuore di un campo da golf a 18 buche."
    ],
    "fr": [
      "Le Domaine de Saint-Clair est un site d’exception avec 54 chambres spacieuses et lumineuses situé au cœur d’un golf de 18 trous."
    ],
    "nl": [
      "Het Domaine de Saint-Clair is een uitzonderlijke locatie met 54 ruime en lichte kamers gelegen in het hart van een 18-holes golfbaan."
    ],
    "es": [
      "El Domaine de Saint-Clair es un lugar excepcional con 54 habitaciones amplias y luminosas situado en el corazón de un campo de golf de 18 hoyos."
    ]
  },
