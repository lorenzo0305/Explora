      "@id": "https://data.datatourisme.fr/d5c511a2-24e4-3e49-b678-54dcbb081b23",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Besuchen Sie die Facebook-Seite von Hermant Blumen\n\nAn welchen Tagen sind wir geöffnet?\nMontag: 14h-18h\nDienstag bis Samstag: 9h-12h30 / 14h-18h\n\nSonntag geschlossen\n \n  Bestellungen:\nTelefonische Auskunft: 03 21 07 14 61 oder 06 38 17 18 24\n\nLieferung:\nAuf Anfrage auch Lieferung nach Hause möglich\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Visit the Hermant fleurs Facebook page\n\nOpening days:\nMonday: 14h-18h\nTuesday to Saturday: 9h-12h30 / 14h-18h\n\nClosed on Sunday\n \n  Orders :\nInformation by phone: 03 21 07 14 61 or 06 38 17 18 24\n\nDelivery:\nHome delivery on request\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Visita la pagina Facebook di Hermant fleurs\n\nGiorni di apertura:\nLunedì: 14h-18h\nDa martedì a sabato: 9.00-12.30 / 14.00-18.00\n\nChiuso la domenica\n \n  Ordini :\nInformazioni telefoniche: 03 21 07 14 61 o 06 38 17 18 24\n\nConsegna:\nConsegna a domicilio su richiesta\n\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: Consultez la page Facebook d'Hermant fleurs\n\nJours d'ouverture: \nLe lundi: 14h-18h\nDu mardi au samedi: 9h-12h30 / 14h-18h\n\nFermeture le dimanche\n \n  Commandes :\nRenseignements par téléphone :  03 21 07 14 61  ou 06 38 17 18 24\n\nLivraison : \nPossibilité de livrer à domicile sur demande\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Bezoek de Facebook-pagina van Hermant fleurs\n\nOpeningsdagen:\nMaandag: 14u-18u\nDinsdag tot zaterdag: 9u-12u30 / 14u-18u\n\nGesloten op zondag\n \n  Bestellingen :\nInformatie per telefoon: 03 21 07 14 61 of 06 38 17 18 24\n\nLevering:\nThuisbezorging op aanvraag\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Visite la página Facebook de Hermant fleurs\n\nDías de apertura:\nLunes: 14h-18h\nDe martes a sábado: 9h-12h30 / 14h-18h\n\nDomingos cerrado\n \n  Pedidos :\nInformación por teléfono: 03 21 07 14 61 o 06 38 17 18 24\n\nEntrega a domicilio:\nEntrega a domicilio previa solicitud\n\n\n "
        ]
      },
