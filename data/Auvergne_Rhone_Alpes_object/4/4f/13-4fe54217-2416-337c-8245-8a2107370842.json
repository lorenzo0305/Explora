  "rdfs:comment": {
    "de": [
      "Sophie ist Landwirtin und bietet Ihnen die Möglichkeit, ihre Pferde zu mieten, um die Landschaften und Wanderwege rund um Montcombroux-les-Mines zu erkunden. Möglichkeit von Einzel- oder Gruppenunterricht"
    ],
    "en": [
      "Sophie is a farmer and gives you the opportunity to rent her horses to discover the landscapes and hiking trails around Montcombroux-les-Mines. Possibility of individual or group lessons"
    ],
    "it": [
      "Sophie è un'allevatrice e vi offre la possibilità di noleggiare i suoi cavalli per scoprire i paesaggi e i sentieri intorno a Montcombroux-les-Mines. possibilità di lezioni individuali o di gruppo"
    ],
    "fr": [
      "Sophie est exploitante agricole et vous donne la possibilité de louer ses chevaux pour découvrir les paysages et les chemins de randonnée autour de Montcombroux-les-Mines. possibilité de cours individuel ou collectif"
    ],
    "nl": [
      "Sophie is boerin en biedt u de mogelijkheid haar paarden te huren om de landschappen en wandelpaden rond Montcombroux-les-Mines te ontdekken. mogelijkheid tot individuele of groepslessen"
    ],
    "es": [
      "Sophie es agricultora y le ofrece la posibilidad de alquilar sus caballos para descubrir los paisajes y las rutas de senderismo de los alrededores de Montcombroux-les-Mines. posibilidad de clases individuales o en grupo"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Écuries de la Côte - Location d'équidés"
    ]
  },
