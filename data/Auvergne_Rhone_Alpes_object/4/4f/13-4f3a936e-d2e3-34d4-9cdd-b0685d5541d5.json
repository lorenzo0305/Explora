  "rdfs:comment": {
    "de": [
      "5000m² großer Privatgarten, der wie ein Gemälde gestaltet ist und verschiedene Stimmungen bietet.\r\nZen-Wasserbecken mit Teepavillon, englische Mixed-Borders mit zahlreichen seltenen Stauden, hundert alte und moderne Rosen und seltene Sträucher..."
    ],
    "en": [
      "Private, 5,000m² garden laid out like a painting with different atmospheres."
    ],
    "it": [
      "Giardino privato di 5000m², concepito come un quadro, con diverse atmosfere.\r\nVasca d'acqua zen e relativo padiglione del tè, bordure miste all'inglese con numerose piante perenni rare, un centinaio di rose antiche e moderne e arbusti rari..."
    ],
    "fr": [
      "Jardin privé de 5000m², conçu comme un tableau, avec différentes ambiances.\r\nBassin aquatique zen et son pavillon de thé, mixed-borders à l'anglaise agrémentés de nombreuse vivaces rares, une centaine de rosiers anciens et modernes et arbustes rares..."
    ],
    "nl": [
      "Privé-tuin van 5000 m², ontworpen als schilderij, met verschillende sferen."
    ],
    "es": [
      "Jardín privado de 5000m², diseñado como un cuadro, con diferentes ambientes.\r\nPiscina de agua zen y su pabellón de té, bordes mixtos de estilo inglés con numerosas plantas perennes raras, un centenar de rosales antiguos y modernos y arbustos raros..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Garden La Palette des Couleurs"
    ],
    "fr": [
      "Jardin La Palette des Couleurs"
    ]
  },
