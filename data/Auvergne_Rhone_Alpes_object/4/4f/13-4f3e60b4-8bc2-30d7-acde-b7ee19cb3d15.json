  "rdfs:comment": {
    "de": [
      "Die Kirche von Randens gehört zur Pfarrei Saint-Christophe Porte de Maurienne. Sie wurde auf den Überresten der Stiftskirche Sainte-Catherine wiederaufgebaut, von der sie einige gotische Elemente bewahrt hat."
    ],
    "en": [
      "The church at Randens is part of the parish of Saint-Christophe Porte de Maurienne. It was rebuilt on the remains of the collegiate church of Sainte-Catherine, of which it retains some Gothic features."
    ],
    "it": [
      "La chiesa di Randens fa parte della parrocchia di Saint-Christophe Porte de Maurienne. È stata ricostruita sui resti della collegiata di Sainte-Catherine, di cui conserva alcune caratteristiche gotiche."
    ],
    "fr": [
      "L'église de Randens fait partie de la paroisse Saint-Christophe Porte de Maurienne. Elle a été reconstruite sur les restes de la collégiale Sainte-Catherine, dont elle conserve quelques éléments gothiques."
    ],
    "es": [
      "La iglesia de Randens pertenece a la parroquia de Saint-Christophe Porte de Maurienne. Fue reconstruida sobre los restos de la colegiata de Sainte-Catherine, de la que conserva algunos elementos góticos."
    ],
    "nl": [
      "De kerk van Randens maakt deel uit van de parochie Saint-Christophe Porte de Maurienne. Ze werd herbouwd op de resten van de collegiale kerk van Sainte-Catherine, waarvan ze nog enkele gotische kenmerken heeft."
    ]
  },
