  "rdfs:comment": {
    "de": [
      "Sorgfältig hergestellte hausgemachte Pizzas. \r\n+ Salate und Desserts.\r\nAutomat mit unseren hausgemachten Pizzen rund um die Uhr.\r\nZum Mitnehmen oder vor Ort"
    ],
    "en": [
      "Homemade pizzas + Salads and desserts\r\nVending machine with our artisan pizzas available 24/7.\r\nTakeaway or eat in."
    ],
    "it": [
      "Pizze fatte in casa con cura.\r\n+ Insalate e dessert\r\nDistributore automatico con le nostre pizze fatte in casa 24 ore su 24 e 7 giorni su 7.\r\nDa asporto o in loco"
    ],
    "fr": [
      "Pizzas maisons confectionnées avec soin. \r\n+ Salades et desserts\r\nDistributeur Automatique avec nos pizzas artisanales 24/24 et 7/7.\r\nA emporter ou sur place"
    ],
    "es": [
      "Pizzas caseras hechas con esmero.\r\n+ Ensaladas y postres\r\nMáquina expendedora automática con nuestras pizzas caseras 24 horas al día, 7 días a la semana.\r\nPara llevar o in situ"
    ],
    "nl": [
      "Huisgemaakte pizza's met zorg bereid.\r\n+ Salades en desserts\r\nAutomaat met onze huisgemaakte pizza's 24/7.\r\nOm mee te nemen of ter plaatse"
    ]
  },
  "rdfs:label": {
    "de": [
