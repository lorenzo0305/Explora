  "rdfs:comment": {
    "de": [
      "2010 beschlossen Nathalie und Franck, mit ihren Töchtern alles hinter sich zu lassen und nach Saint-Ennemond zu ziehen, um dort ein Geschäft zu übernehmen."
    ],
    "en": [
      "In 2010, Nathalie and Franck decide to leave everything with their daughters to settle in Saint-Ennemond, to take over a business in order to work together after several years of work each on their side."
    ],
    "it": [
      "Nel 2010, Nathalie e Franck hanno deciso di lasciare tutto con le loro figlie e di trasferirsi a Saint-Ennemond per rilevare un'azienda e lavorare insieme dopo diversi anni di lavoro in proprio."
    ],
    "fr": [
      "En 2010, Nathalie et Franck décident de tout quitter avec leurs filles pour s’installer à Saint-Ennemond, afin de reprendre un commerce dans le but de travailler ensemble après plusieurs années de travail chacun de leur côté."
    ],
    "nl": [
      "In 2010 besloten Nathalie en Franck om met hun dochters alles achter te laten en naar Saint-Ennemond te verhuizen om daar een zaak over te nemen en na enkele jaren alleen te hebben gewerkt samen te werken."
    ],
    "es": [
      "En 2010, Nathalie y Franck decidieron dejarlo todo con sus hijas y trasladarse a Saint-Ennemond para hacerse cargo de un negocio y poder trabajar juntos después de varios años trabajando por su cuenta."
    ]
  },
