  "rdfs:comment": {
    "de": [
      "Für alle Tanz-, Zumba- und Fitnessbegeisterten: Kommen Sie mit mir und teilen Sie meine Leidenschaft im Palais des Sports in Morzine! Kurse mit guter Laune!"
    ],
    "en": [
      "For all the Zumba and fitness enthusiasts, come and share my passion at the Morzine Palais des Sports! Great atmosphere classes"
    ],
