      "@id": "https://data.datatourisme.fr/82742348-7db7-36c5-a21b-2d56260fa716",
      "dc:description": {
        "de": [
          "Die Einnahmen gehen an die Vereine \"Le Royaume d'Arthur\" und \"Gina Princesse exceptionnelle\" . Informationen auf der Facebook-Seite \"Coeur de Rock'Heurt\"\nTreffpunkt im Saal Yves Montand ab 17.30 Uhr. Preis: 5 ? Reservierung durch Flashen des Qr Code ( direkte Seite auf der Website helloasso.com)."
        ],
        "en": [
          "Profits donated to the associations \"Le Royaume d'Arthur\" and \"Gina Princesse exceptionnelle\" . Information on facebook \"Coeur de Rock'Heurt\"\nMeet at Salle Yves Montand from 5:30pm. Price: 5 ? . Reservations by flashing the Qr Code ( direct page on helloasso.com)."
        ],
        "it": [
          "Utili devoluti alle associazioni \"Le Royaume d'Arthur\" e \"Gina Princesse exceptionnelle\". Informazioni su facebook \"Coeur de Rock'Heurt\"\nAppuntamento alla Salle Yves Montand dalle 17.30. Prezzo: 5? Per prenotare, lampeggiare il Qr Code (pagina diretta sul sito helloasso.com)."
        ],
        "fr": [
          "Bénéfices reversés aux associations \"Le Royaume d'Arthur\" et \"Gina Princesse exceptionnelle\" . Renseignements sur le facebook \"Coeur de Rock'Heurt\"\nRendez-vous à la salle Yves Montand dès 17h30. Tarif : 5 € . Réservation en flashant le Qr Code ( page direct sur le site helloasso.com)."
        ],
        "nl": [
          "De winst gaat naar de verenigingen \"Le Royaume d'Arthur\" en \"Gina Princesse exceptionnelle\". Informatie op facebook \"Coeur de Rock'Heurt\"\nVerzamelen in de Salle Yves Montand vanaf 17.30 uur. Prijs: 5? Om te reserveren, flash de Qr Code (directe pagina op de helloasso.com website)."
        ],
        "es": [
          "Beneficios donados a las asociaciones \"Le Royaume d'Arthur\" y \"Gina Princesse exceptionnelle\". Información en facebook \"Coeur de Rock'Heurt\"\nEncuentro en la Salle Yves Montand a partir de las 17.30 h. Precio: 5? Para reservar, parpadee el código Qr (página directa en el sitio web helloasso.com)."
        ]
      },
