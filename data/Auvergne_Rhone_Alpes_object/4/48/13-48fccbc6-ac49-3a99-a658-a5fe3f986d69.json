  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, die vom Chefkoch und seiner Küchenbrigade zubereitet wird. Jedes Gericht wird vor Ort in unserer Küche zubereitet. Wir bevorzugen saisonale Produkte mit vorzugsweise lokaler Bezugsquelle."
    ],
    "en": [
      "Traditional cuisine prepared by our chef and his team in our kitchens. We use local and seasonal ingredients whenever possible. Truffle-based menu in season."
    ],
    "it": [
      "Cucina tradizionale preparata dallo chef e dalla sua brigata. Ogni piatto viene preparato in loco nelle nostre cucine. Privilegiamo i prodotti di stagione, preferibilmente di provenienza locale."
    ],
    "fr": [
      "Cuisine traditionnelle élaborée par le chef et sa brigade. Chaque plat est préparé sur place dans nos cuisines. Nous privilégions les produits de saison avec un approvisionnement local de préférence."
    ],
    "nl": [
      "Traditionele keuken bereid door de chef en zijn team. Elk gerecht wordt ter plaatse bereid in onze keukens. Wij geven de voorkeur aan lokale seizoensproducten."
    ],
    "es": [
      "Cocina tradicional preparada por el chef y su brigada. Cada plato se prepara in situ en nuestras cocinas. Preferimos los productos de temporada, preferiblemente de origen local."
    ]
  },
