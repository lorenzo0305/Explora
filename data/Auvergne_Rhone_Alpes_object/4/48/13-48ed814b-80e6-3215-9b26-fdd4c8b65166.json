  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Skifahren, machen Sie Fortschritte und perfektionieren Sie Ihr Können in Begleitung eines Skilehrers, denn Spaß kann man lernen!"
    ],
    "en": [
      "Come and discover skiing, progress and perfect your technique with an instructor. We make it a pleasure to learn!"
    ],
    "it": [
      "Venite a scoprire lo sci, a progredire e a perfezionare la vostra tecnica con un istruttore, perché dovete imparare a divertirvi!"
    ],
    "fr": [
      "Venez découvrir le ski, progresser et perfectionnez-vous accompagné d’un moniteur, parce que le plaisir ça s’apprend !"
    ],
    "es": [
      "Ven a descubrir el esquí, progresa y perfecciona tu técnica con un monitor, ¡porque hay que aprender para disfrutar!"
    ],
    "nl": [
      "Kom en ontdek het skiën, boek vooruitgang en perfectioneer je techniek met een instructeur, want je moet leren om plezier te hebben!"
    ]
  },
