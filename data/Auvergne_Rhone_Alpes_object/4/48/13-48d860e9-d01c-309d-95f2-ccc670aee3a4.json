  "rdfs:comment": {
    "de": [
      "Mamma Mia ist ein kleines italienisches Restaurant und eine Trattoria mit entspannter Atmosphäre in der charmanten französischen Stadt Sallanches, nur wenige Schritte vom Bahnhof entfernt."
    ],
    "en": [
      "Mamma Mia is a small, relaxed Italian restaurant and trattoria located in the charming French town of Sallanches, just steps from the train station."
    ],
    "it": [
      "Mamma Mia è un piccolo ristorante e trattoria italiana dall'atmosfera rilassata, situato nell'affascinante cittadina francese di Sallanches, a pochi passi dalla stazione ferroviaria."
    ],
    "fr": [
      "Mamma Mia est un petit restaurant italien et une trattoria à l’atmosphère détendue, situé dans la charmante ville française de Sallanches, à quelques pas de la gare."
    ],
    "nl": [
      "Mamma Mia is een klein Italiaans restaurant en trattoria met een ontspannen sfeer, gelegen in het charmante Franse stadje Sallanches, op een steenworp afstand van het treinstation."
    ],
    "es": [
      "Mamma Mia es un pequeño restaurante y trattoria italiana de ambiente relajado, situado en la encantadora localidad francesa de Sallanches, a pocos pasos de la estación de tren."
    ]
  },
