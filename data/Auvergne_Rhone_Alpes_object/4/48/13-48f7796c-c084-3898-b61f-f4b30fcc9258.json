  "rdfs:comment": {
    "de": [
      "Wasserfläche von 1,5 Hektar 2. Kategorie. Angeln mit den Karten mineure, découverte, majeure und réciprocité. Praktisch für alle eine Rute. Einfacher Haken ohne Widerhaken No-kill-Angeln. Regelung vor Ort."
    ],
    "en": [
      "1,5 ha lake 2nd category. No-kill fishing ; one fishing rod. Fishing regulations on site."
    ],
    "it": [
      "1,5 ettari di acqua di 2ª categoria. Pesca con carte minori, scoperta, maggiore e reciproca. Pratica per tutti una canna. Amo singolo senza ardiglione. Pesca no-kill. Regolamento sul posto."
    ],
    "fr": [
      "Plan d'eau d'une surface de 1,5 hectares 2e catégorie. Pêche avec cartes mineure, découverte, majeure et réciprocité. Pratique pour tous une canne. Hameçon simple sans ardillon   Pêche no-kill. Réglementation sur place."
    ],
    "nl": [
      "1,5 hectare water van de 2e categorie. Vissen met kleine, ontdekkings-, grote en wederkerige kaarten. Oefenen voor iedereen met een hengel. Enkelvoudige weerhaakloze haak. No-kill vissen. Reglement ter plaatse."
    ],
    "es": [
      "1,5 hectáreas de agua de 2ª categoría. Pesca con tarjeta menor, descubierta, mayor y recíproca. Práctica para todos de una caña. Anzuelo simple sin púas. Pesca sin muerte. Reglamento in situ."
    ]
  },
  "rdfs:label": {
    "en": [
      "Maurice pond lake"
    ],
    "fr": [
      "Parcours découverte du plan d'eau Bassin Maurice"
    ]
  },
