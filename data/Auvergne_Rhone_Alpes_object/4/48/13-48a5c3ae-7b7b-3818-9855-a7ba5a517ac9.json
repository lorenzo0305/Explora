  "rdfs:comment": {
    "de": [
      "Am Fuße der Stadtmauern von Montferrand, ein Ort mit Charakter. Speisekarte nach Saison und den Wünschen des Küchenchefs. An schönen Tagen kleine Terrasse im Hof."
    ],
    "en": [
      "At the foot of the ramparts of Montferrand, a place of character. Menu according to the seasons and the chef's desires. On sunny days, small terrace overlooking the courtyard."
    ],
    "it": [
      "Ai piedi dei bastioni di Montferrand, un luogo di carattere. Menu in base alle stagioni e ai desideri dello chef. Nella bella stagione, piccola terrazza sul cortile."
    ],
    "fr": [
      "Au pied des remparts de Montferrand, lieu de caractère. Carte selon saisons et envies du chef. Dès les beaux jours, petite terrasse sur cour."
    ],
    "es": [
      "Al pie de las murallas de Montferrand, un lugar con carácter. Menú según las estaciones y los deseos del chef. Cuando hace buen tiempo, pequeña terraza en el patio."
    ],
    "nl": [
      "Aan de voet van de wallen van Montferrand, een plaats met karakter. Menu volgens de seizoenen en de wensen van de chef. Bij mooi weer, klein terras op de binnenplaats."
    ]
  },
