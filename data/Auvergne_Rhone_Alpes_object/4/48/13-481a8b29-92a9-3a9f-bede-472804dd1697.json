  "rdfs:comment": {
    "de": [
      "Le Bruit Qui Court ist ein Café-Restaurant, das unter anderem darauf abzielt, die lokale Landwirtschaft durch das Angebot von Produkten aus der Umgebung aufzuwerten, sinnstiftende Vereins- und Gemeinschaftsinitiativen zu vermitteln, ein Ort des künstlerischen Ausdrucks zu sein..."
    ],
    "en": [
      "Le Bruit Qui Court is a café-restaurant aiming, among other things, to enhance local agriculture through the supply of local products, to take over from associative and collective initiatives that carry meaning, to be a place of artistic expression..."
    ],
    "it": [
      "Le Bruit Qui Court è un caffè-ristorante che si propone, tra l'altro, di promuovere l'agricoltura locale attraverso l'offerta di prodotti locali, di essere un luogo di rilancio di iniziative associative e collettive significative, di essere un luogo di espressione artistica..."
    ],
    "fr": [
      "Le Bruit Qui Court est un café-restaurant visant, entre autres, à valoriser l’agriculture locale par l’offre de produits de proximité, se faire relais d’initiatives associatives et collectives porteuses de sens, être un lieu d’expression artistique..."
    ],
    "nl": [
      "Le Bruit Qui Court is een café-restaurant dat onder andere tot doel heeft de lokale landbouw te promoten door lokale producten aan te bieden, een steunpunt te zijn voor zinvolle associatieve en collectieve initiatieven, een plaats te zijn voor artistieke expressie..."
    ],
    "es": [
      "Le Bruit Qui Court es un café-restaurante que pretende, entre otras cosas, promover la agricultura local ofreciendo productos de la tierra, ser un relevo de iniciativas asociativas y colectivas significativas, ser un lugar de expresión artística..."
    ]
  },
  "rdfs:label": {
