  "rdfs:comment": {
    "de": [
      "Genießen Sie eine Stunde Pilates und anschließend eine Stunde Entspannung in der Sauna, im Dampfbad und im Jacuzzi des Wassersportzentrums L'O'des Sucs. es werden 2 Zeiten angeboten: von 17 bis 19 Uhr und von 18:30 bis 20:30 Uhr. Reservierung an der Rezeption des Wassersportzentrums oder auf der Website."
    ],
    "en": [
      "Enjoy 1h of Pilates followed by 1h of relaxation in the sauna, hammam and jacuzzi at the O'des Sucs aquatic center. 2 times available: from 5pm to 7pm and from 6:30pm to 8:30pm. Reservations required at the aquatic center reception desk or on their website."
    ],
    "it": [
      "Godetevi 1 ora di Pilates seguita da 1 ora di relax nella sauna, nell'hammam e nella jacuzzi del centro acquatico O'des Sucs. 2 orari disponibili: dalle 17.00 alle 19.00 e dalle 18.30 alle 20.30. Prenotazione obbligatoria presso la reception del centro acquatico o sul sito web."
    ],
    "fr": [
      "Profitez d’1h de Pilates suivie d’1h de détente au sauna, hammam et jacuzzi au centre aquatique  l'O'des Sucs. 2 horaires proposés : de 17h à 19h et de 18h30 à 20h30. Sur réservation à l'accueil du centre aquatique ou sur leur site internet."
    ],
    "nl": [
      "Geniet van 1 uur Pilates gevolgd door 1 uur ontspanning in de sauna, hammam en jacuzzi in het O'des Sucs aquacentrum. 2 tijden beschikbaar: van 17.00 tot 19.00 uur en van 18.30 tot 20.30 uur. Reserveren verplicht bij de receptie van het aquacentrum of via hun website."
    ],
    "es": [
      "Disfrute de 1 hora de Pilates seguida de 1 hora de relajación en la sauna, el hammam y el jacuzzi del centro acuático O'des Sucs. 2 horarios disponibles: de 17:00 a 19:00 y de 18:30 a 20:30. Reserva obligatoria en la recepción del centro acuático o en su página web."
    ]
  },
  "rdfs:label": {
    "fr": [
      "1h de Pilates suivie d’1h de détente au sauna, hammam et jacuzzi."
    ]
  },
