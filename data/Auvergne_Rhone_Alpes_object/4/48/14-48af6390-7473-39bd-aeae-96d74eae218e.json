  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/95724c41-f441-358b-9151-982543496832",
      "dc:description": {
        "de": [
          "Start: Montreuil (Esplanade de la Citadelle)\n18,5 km - 4,30 Std\nWandern Sie entlang der Canche durch die Sümpfe von Grenouillère bis zum Communal de Sorrus, wo Wälder, Wiesen, Heiden, Tümpel und Quellen sich die 20 ha dieses geschützten Gebietes teilen."
        ],
        "en": [
          "Start : Montreuil (Esplanade de la Citadelle)\n18.5km - 4h30\nWalk along the Canche through the Grenouillère marshes to the Communal de Sorrus, where woods, meadows, moors, ponds and springs share the 20ha of this protected site."
        ],
        "it": [
          "Partenza : Montreuil (Esplanade de la Citadelle)\n18,5 km - 4h30\nPasseggiata lungo la Canche, attraverso le paludi della Grenouillère, fino al Communal de Sorrus, dove boschi, prati, brughiere, stagni e sorgenti condividono i 20 ettari di questo sito protetto."
        ],
        "fr": [
          "Départ : Montreuil (Esplanade de la Citadelle)\n18,5km - 4h30\nLongez la Canche à travers les marais de la Grenouillère, jusqu'au Communal de Sorrus où bois, prairies, landes, mares et sources se partagent les 20ha de ce site protégé."
        ],
        "nl": [
          "Start : Montreuil (Esplanade de la Citadelle)\n18,5 km - 4u30\nWandeling langs de Canche door de moerassen van Grenouillère naar de Communal de Sorrus, waar bossen, weiden, heide, vijvers en bronnen de 20 ha van dit beschermde gebied delen."
        ],
        "es": [
          "Salida : Montreuil (Esplanade de la Citadelle)\n18,5 km - 4h30\nRecorra a pie el Canche a través de las marismas de la Grenouillère hasta el Communal de Sorrus, donde bosques, praderas, páramos, estanques y manantiales comparten las 20 ha de este lugar protegido."
        ]
      },
