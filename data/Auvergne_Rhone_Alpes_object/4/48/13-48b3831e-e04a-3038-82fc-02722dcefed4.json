  "rdfs:comment": {
    "de": [
      "Es befindet sich im ehemaligen Jesuitenkolleg, dessen Ehrentreppe eine Sonnenuhr mit Reflexionszifferblatt (1673) beherbergt, die in der Welt einzigartig ist. Jahrhundert die ehemalige École Centrale, an der Stendhal von 1796 bis 1799 Schüler war."
    ],
    "en": [
      "It occupies the former Jesuit college, whose grand staircase houses a sundial clock with reflection dial (1673), the only one of its kind in the world. Formerly the Ecole Centrale in the 18th century, Stendhal was a student there from 1796 to 1799."
    ],
    "it": [
      "Occupa l'ex collegio dei Gesuiti, la cui scalinata principale ospita una meridiana con quadrante a riflessione (1673), unica al mondo. Ex Ecole Centrale nel XVIII secolo, Stendhal vi fu studente dal 1796 al 1799."
    ],
    "fr": [
      "Il occupe l’ancien collège  des Jésuites dont l’escalier d’honneur abrite une horloge solaire à cadran à réflexion (1673), unique au monde. Ancienne école Centrale  au XVIIIe, Stendhal y a été élève de 1796 à 1799."
    ],
    "es": [
      "Ocupa el antiguo colegio jesuita, cuya gran escalinata alberga un reloj de sol con esfera reflectante (1673), único en el mundo. Stendhal estudió aquí de 1796 a 1799."
    ],
    "nl": [
      "Het is ondergebracht in het voormalige jezuïetencollege, waarvan de hoofdtrap een zonnewijzer met reflectiewijzer (1673) herbergt, de enige in zijn soort ter wereld. In de 18e eeuw was dit de Ecole Centrale, waar Stendhal van 1796 tot 1799 studeerde."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lycée Stendhal"
    ]
  },
