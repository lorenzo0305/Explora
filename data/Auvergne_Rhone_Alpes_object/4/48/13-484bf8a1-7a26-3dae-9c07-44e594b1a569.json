  "rdfs:comment": {
    "de": [
      "Ein echtes kulinarisches Erlebnis, das von einem jungen, talentierten Küchenchef inszeniert wird.\r\nAuf dem Menüplan stehen ein Teller voller Aromen und ein farbenfroher Ausblick!"
    ],
    "en": [
      "A true culinary experience orchestrated by a talented young chef.\r\nOn the menu: a plate full of flavors and a colorful view!"
    ],
    "it": [
      "Una vera e propria esperienza culinaria orchestrata da un giovane chef di talento.\r\nNel menu: un piatto pieno di sapore e una vista colorata!"
    ],
    "fr": [
      "Une véritable expérience culinaire orchestrée par un jeune chef de talent. \r\nAu menu : une assiette pleine de saveurs et une vue haute en couleur !"
    ],
    "es": [
      "Una auténtica experiencia culinaria orquestada por un joven chef de talento.\r\nEn el menú: ¡un plato lleno de sabor y una vista colorida!"
    ],
    "nl": [
      "Een ware culinaire ervaring georkestreerd door een getalenteerde jonge chef-kok.\r\nOp het menu: een bord vol smaak en een kleurrijk uitzicht!"
    ]
  },
