  "rdfs:comment": {
    "de": [
      "In der Guinguette CLAC stößt man auf schöne Werte an, Bio-Produkte, lokale Produkte, Anti-Verschwendung in einer herzlichen und entspannten Atmosphäre."
    ],
    "en": [
      "At Guinguette CLAC, we toast to good values, organic, local, anti-gaspi products in a warm, relaxed atmosphere."
    ],
    "it": [
      "Alla Guinguette CLAC si può brindare ai buoni valori, ai prodotti biologici, locali e anti-gaspi in un'atmosfera calda e rilassata."
    ],
    "fr": [
      "À la Guinguette CLAC on trinque aux belles valeurs, produits bio, locaux, anti-gaspi dans une ambiance chaleureuse et décontracté."
    ],
    "nl": [
      "In de Guinguette CLAC kun je proosten op biologische, lokale en antigasproducten in een warme, ontspannen sfeer."
    ],
    "es": [
      "En el CLAC de Guinguette podrá brindar por los buenos valores, los productos ecológicos, locales y antigaspi en un ambiente cálido y relajado."
    ]
