  "rdfs:comment": {
    "de": [
      "Die Ermitage du Grand Bois bietet im Sommer Wellness-Workshops an. Ihr Wellness-Moment:Finden Sie zu sich selbst! Entdecken Sie Ihre Ressourcen wieder, entspannen Sie sich, lassen Sie los, atmen Sie und erleben Sie..."
    ],
    "en": [
      "L'ermitage du Grand Bois offers summer wellness workshops. Your moment of well-being:Find yourself! Rediscover your resources, relax, let go, breathe and relive..."
    ],
    "it": [
      "L'ermitage du Grand Bois propone laboratori di benessere in estate. Il vostro momento di benessere: ritrovate voi stessi! Riscoprire le proprie risorse, rilassarsi, lasciarsi andare, respirare e rivivere..."
    ],
    "fr": [
      "L'ermitage du Grand Bois propose en été des ateliers bien-être. Votre moment bien-être :Retrouvez-vous ! Redécouvrez vos ressources, Détendez-vous, Lâchez prise, Respirez, et Revivez..."
    ],
    "es": [
      "L'ermitage du Grand Bois ofrece talleres de bienestar en verano. Tu momento de bienestar: ¡Encuéntrate a ti mismo! Redescubra sus recursos, relájese, déjese llevar, respire y reviva..."
    ],
    "nl": [
      "L'ermitage du Grand Bois biedt welzijnsworkshops in de zomer. Jouw moment van welzijn: jezelf vinden! Herontdek je bronnen, ontspan, laat los, haal adem en herbeleef..."
    ]
  },
