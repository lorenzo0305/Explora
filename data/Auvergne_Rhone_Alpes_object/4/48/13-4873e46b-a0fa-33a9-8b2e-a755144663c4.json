  "rdfs:comment": {
    "de": [
      "Ein hausgemachter Imbiss in der Bastille.\r\nEr befindet sich auf dem zentralen Platz der Festung. Hier finden Sie frische, lokale und abwechslungsreiche Produkte."
    ],
    "en": [
      "A home-made snack bar at the Bastille.\r\nLocated on the Fort's central square, you'll find fresh, local and varied produce."
    ],
    "it": [
      "Uno snack bar casalingo alla Bastiglia.\r\nSituato nella piazza centrale del Forte, vi troverete prodotti freschi, locali e variegati."
    ],
    "fr": [
      "Un snack fait maison à la Bastille.\r\nSitué sur la place centrale du Fort, vous y trouverez des produits frais, locaux et variés."
    ],
    "es": [
      "Un tentempié casero en la Bastilla.\r\nSituado en la plaza central del Fuerte, encontrará productos frescos, locales y variados."
    ],
