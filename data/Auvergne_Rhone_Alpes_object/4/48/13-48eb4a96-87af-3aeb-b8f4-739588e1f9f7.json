  "rdfs:comment": {
    "de": [
      "Flohmarkt mit Verkauf verschiedener alter Gegenstände: Schallplatten, Bücher, Bilder, Drucke, Dekorationsgegenstände, Geschirr, Keramik, Glaswaren, alte Werkzeuge, alte Papiere und alte Postkarten."
    ],
    "en": [
      "Flea market with sale of various old items: records, books, paintings, engravings, decorative objects, crockery, ceramics, glassware, old tools, old papers and postcards."
    ],
