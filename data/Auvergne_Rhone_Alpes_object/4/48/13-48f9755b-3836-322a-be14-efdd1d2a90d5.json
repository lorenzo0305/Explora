  "rdfs:comment": {
    "de": [
      "Modernes, traditionelles Familienrestaurant in den Pierres Dorées, 10 Minuten von Villefranche-sur-Saône entfernt. Ruhige und angenehme Umgebung mit einer schattigen, blumengeschmückten Terrasse, die ideal für Familienessen ist, und einem Empfangsraum."
    ],
    "en": [
      "A modern, family-friendly traditional restaurant in the Pierres Dorées region, 10 minutes from Villefranche-sur-Saône. A peaceful and pleasant setting with a shaded terrace decorated with flowers, ideal for family meals, and a reception room."
    ],
    "it": [
      "Ristorante familiare moderno e tradizionale nella regione delle Pierres Dorées, a 10 minuti da Villefranche-sur-Saône. Ambiente tranquillo e piacevole, con una terrazza ombreggiata e fiorita ideale per pranzi e cene in famiglia e una sala per ricevimenti."
    ],
    "fr": [
      "Restaurant traditionnel moderne et familial dans les Pierres Dorées à 10 minutes de Villefranche-sur-Saône. Cadre calme et agréable avec une terrasse ombragée et fleurie idéale pour les repas de famille, et une salle de réception."
    ],
    "es": [
      "Restaurante familiar moderno y tradicional en la región de Pierres Dorées, a 10 minutos de Villefranche-sur-Saône. Entorno tranquilo y agradable con una terraza sombreada y florida, ideal para comidas familiares, y un salón de actos."
    ],
    "nl": [
      "Modern, traditioneel familierestaurant in de streek Pierres Dorées, op 10 minuten van Villefranche-sur-Saône. Rustige, aangename omgeving met een schaduwrijk, bloemrijk terras ideaal voor familiemaaltijden, en een feestzaal."
    ]
  },
  "rdfs:label": {
