  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt 7 km von Bourg d'Oisans entfernt und bietet das ganze Jahr über schnelle und qualitativ hochwertige Speisen mit Blick auf die Berggipfel."
    ],
    "en": [
      "Located 7km away from Bourg d'Oisans, the Hôtel Belledonne restaurant offers local dishes and a stunning view over the surrounding mountains."
    ],
    "it": [
      "Situato a 7 km da Bourg d'Oisans, il ristorante offre tutto l'anno piatti veloci e un servizio di qualità con vista sulle cime."
    ],
    "fr": [
      "Situé à 7 km de Bourg d'Oisans, le restaurant propose toute l'année une restauration rapide et de qualité avec vue sur les sommets."
    ],
    "es": [
      "Situado a 7 km de Bourg d'Oisans, el restaurante ofrece comida rápida y un servicio de calidad durante todo el año con vistas a las cumbres."
    ],
    "nl": [
      "Hotel Belledonne is gelegen op 7 km van Bourg d'Oisans en beschikt over een restaurant-grill met streekgerechten en een bar met zicht op de bergen."
    ]
  },
