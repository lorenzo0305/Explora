  "rdfs:comment": {
    "de": [
      "Als Lebensmittelgeschäft und Supermarkt bietet Ihnen Carrefour Contact die Möglichkeit, seine Feinkost-, Wurst- und Käseabteilungen sowie eine Vielzahl an lokalen Produkten zu entdecken! Zahlreiche Dienstleistungen in der Nähe, Paketstation, frischer Orangensaft, Kaffee und Salatbar."
    ],
    "en": [
      "A general grocery store and supermarket, Carrefour Contact features delicatessen, charcuterie, cheese and a host of local products! Numerous local services, parcel relay, fresh orange juice, coffee and salad bar."
    ],
    "it": [
      "Carrefour Contact è un negozio di generi alimentari e un supermercato con specialità gastronomiche, carni cotte, formaggi e una serie di prodotti locali! Molti servizi locali, consegna pacchi, succo d'arancia fresco, caffè e salad bar."
    ],
    "fr": [
      "Alimentation générale et supermarché, Carrefour Contact vous propose de découvrir ses rayons traiteurs, charcuterie, fromage et une multitude de produits locaux ! Nombreux services de proximité, relais colis, jus d'orange frais, café et salade bar."
    ],
    "nl": [
      "Carrefour Contact is een algemene levensmiddelenwinkel en supermarkt met delicatessen, vleeswaren, kaas en veel lokale producten! Veel lokale diensten, pakketpost, verse jus d'orange, koffie en een saladebar."
    ],
    "es": [
      "Carrefour Contact es una tienda de alimentación general y un supermercado con charcutería, carnes cocinadas, quesos y un sinfín de productos locales. Numerosos servicios locales, servicio de paquetería, zumo de naranja natural, café y bar de ensaladas."
    ]
  },
