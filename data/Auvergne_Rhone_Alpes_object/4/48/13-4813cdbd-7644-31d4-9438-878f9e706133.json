  "rdfs:comment": {
    "de": [
      "Céline empfängt Sie in ihrem Lokal und verwöhnt Sie mit regionalen Spezialitäten, im klimatisierten Panoramarestaurant oder auf der Terrasse."
    ],
    "en": [
      "Céline welcomes you to her establishment and offers you to discover the regional specialties, in her panoramic air-conditioned restaurant or on the terrace."
    ],
    "it": [
      "Céline vi dà il benvenuto nella sua struttura e vi propone di scoprire le specialità regionali nel suo ristorante panoramico climatizzato o sulla terrazza."
    ],
    "fr": [
      "Céline vous accueille dans son établissement et vous propose de vous faire découvrir les spécialités régionales, dans son restaurant panoramique climatisé ou en terrasse."
    ],
    "es": [
      "Céline le da la bienvenida a su establecimiento y le propone descubrir las especialidades regionales en su restaurante panorámico climatizado o en la terraza."
    ],
    "nl": [
      "Céline heet u welkom in haar zaak en biedt u de mogelijkheid om de regionale specialiteiten te ontdekken in haar panoramisch restaurant met airconditioning of op het terras."
    ]
  },
