  "rdfs:comment": {
    "de": [
      "Die Künstlerinnen der Barbaque Compagnie, Caroline und Vaïssa, werden die erste Woche der Aprilferien bei uns verbringen und einen Workshop rund um das Stück \"La princesse qui n'aimait pas...\" anbieten."
    ],
    "en": [
      "The artists of Barbaque Compagnie, Caroline and Vaïssa, will spend the first week of April vacations with us and will propose a workshop around the show \"The princess who didn't like...\"."
    ],
    "it": [
      "Le artiste della Barbaque Compagnie, Caroline e Vaïssa, trascorreranno con noi la prima settimana delle vacanze di aprile e proporranno un laboratorio basato sullo spettacolo \"La princesse qui n'aimait pas...\"."
    ],
    "fr": [
      "Les artistes de Barbaque Compagnie, Caroline et Vaïssa, passeront la 1ère semaine des vacances d’avril avec nous et proposeront un atelier autour du spectacle «La princesse qui n’aimait pas...»."
    ],
    "es": [
      "Las artistas de Barbaque Compagnie, Caroline y Vaïssa, pasarán con nosotros la 1ª semana de las vacaciones de abril y ofrecerán un taller basado en el espectáculo \"La princesse qui n'aimait pas...\"."
    ],
    "nl": [
      "De artiesten van Barbaque Compagnie, Caroline en Vaïssa, zullen de 1e week van de aprilvakantie bij ons doorbrengen en een workshop geven gebaseerd op de voorstelling \"La princesse qui n'aimait pas...\"."
    ]
  },
  "rdfs:label": {
