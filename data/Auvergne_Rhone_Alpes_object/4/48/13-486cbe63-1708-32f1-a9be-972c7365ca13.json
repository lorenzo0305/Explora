  "rdfs:comment": {
    "de": [
      "Die Schicksale einer Großmutter und ihrer Enkelin. Eine Reise, die alles verändert, Geheimnisse, die das Herz berühren. Eine moderne Aufführung mit Retro-Farben, eine kühne Inszenierung, ein unvergessliches Abenteuer."
    ],
    "en": [
      "The destinies of a grandmother and her granddaughter. A journey that changes everything, secrets that touch the heart. A resolutely modern show with retro colors, bold staging and an unforgettable adventure."
    ],
    "it": [
      "I destini di una nonna e di sua nipote. Un viaggio che cambia tutto, segreti che toccano il cuore. Uno spettacolo decisamente moderno dai colori retrò, messo in scena con audacia per un'avventura indimenticabile."
    ],
    "fr": [
      "Les destins d'une grand-mère et de sa petite fille. Un voyage qui changera tout, des secrets qui touchent le cœur. Un spectacle résolument moderne aux couleurs rétro, une mise en scène audacieuse, une aventure inoubliable."
    ],
    "es": [
      "Los destinos de una abuela y su nieta. Un viaje que lo cambia todo, secretos que llegan al corazón. Un espectáculo decididamente moderno en colores retro, audazmente puesto en escena para una aventura inolvidable."
    ],
    "nl": [
      "Het lot van een grootmoeder en haar kleindochter. Een reis die alles verandert, geheimen die het hart raken. Een resoluut moderne show in retrokleuren, gedurfd geënsceneerd voor een onvergetelijk avontuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Comédie Musicale Nationale 7 : \"Les destins de Manon et Jeannette\""
    ]
  },
