  "rdfs:comment": {
    "de": [
      "Die Komödie zum Sonntag! Die Geschichte ? Rachid und Marie-Sophie, zwei unsterbliche Verliebte, träumen davon, zu heiraten. Er ist Muslim, sie Katholikin."
    ],
    "en": [
      "Sunday comedy! The story? Rachid and Marie-Sophie, two star-crossed lovers, dream of getting married. He's Muslim, she's Catholic."
    ],
    "it": [
      "La commedia della domenica! La storia? Rachid e Marie-Sophie, due innamorati incrociati, sognano di sposarsi. Lui è musulmano, lei cattolica."
    ],
    "fr": [
      "La comédie du dimanche ! L’histoire ? Rachid et Marie-Sophie, deux amoureux transis, rêvent de se marier. Lui, est musulman, elle, catholique."
    ],
    "nl": [
      "Zondagse komedie! Het verhaal? Rachid en Marie-Sophie, twee geliefden die elkaar in de haren vliegen, dromen van trouwen. Hij is moslim, zij katholiek."
    ],
    "es": [
      "La comedia del domingo ¿El argumento? Rachid y Marie-Sophie, dos enamorados sin rumbo, sueñan con casarse. Él es musulmán, ella católica."
    ]
  },
  "rdfs:label": {
