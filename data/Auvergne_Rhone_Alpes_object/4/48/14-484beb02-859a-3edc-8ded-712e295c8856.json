  "rdfs:comment": {
    "de": [
      "Wie wäre es, wenn wir die Geschichte der Frau, des Mannes und ihrer Beziehungen im Lichte der Genderfrage neu betrachten würden?"
    ],
    "en": [
      "How about revisiting the history of women, men and their relationships from a gender perspective?"
    ],
    "it": [
      "Che ne dite di rivisitare la storia delle donne, degli uomini e delle loro relazioni da una prospettiva di genere?"
    ],
    "fr": [
      "Et si on revisitait l'histoire de la femme, de l'homme et de leurs relations à l'aune des questions de genre ?"
    ],
    "es": [
      "¿Qué tal si revisamos la historia de las mujeres, los hombres y sus relaciones desde una perspectiva de género?"
    ],
    "nl": [
