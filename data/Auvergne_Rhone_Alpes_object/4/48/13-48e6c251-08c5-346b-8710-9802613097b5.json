  "rdfs:comment": {
    "de": [
      "Die Volkshochschule lädt Sie in ihre Räumlichkeiten ein, um die vom Künstler André Charbonneau ausgewählten Aquarelle zu entdecken! Kommen Sie und entdecken Sie seine Darstellungen von Panoramen und Lebensszenen an den Ufern der Rhône..."
    ],
    "en": [
      "The Université Populaire invites you to its premises to discover the watercolors selected by artist André Charbonneau! Come and discover his representations of panoramas and scenes of life on the banks of the Rhône..."
    ],
    "it": [
      "L'Université Populaire vi invita nei suoi locali per scoprire gli acquerelli selezionati dall'artista André Charbonneau! Venite a scoprire le sue rappresentazioni di panorami e scene di vita sulle rive del Rodano..."
    ],
    "fr": [
      "L'Université Populaire vous invite dans ses locaux pour découvrir les aquarelles sélectionnées par l'artiste André Charbonneau ! Venez découvrir ses représentations de panoramas et de scènes de vie sur les bords du Rhône..."
    ],
    "es": [
      "La Université Populaire le invita a sus locales para descubrir las acuarelas seleccionadas por el artista André Charbonneau Venga a descubrir sus representaciones de panoramas y escenas de la vida a orillas del Ródano..."
    ],
    "nl": [
      "De Université Populaire nodigt je uit om de aquarellen van de kunstenaar André Charbonneau te komen bekijken! Kom en ontdek zijn voorstellingen van panorama's en scènes uit het leven aan de oevers van de Rhône..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : scènes de vies dans le couloir Rhôdanien par André Charbonneau"
    ]
  },
