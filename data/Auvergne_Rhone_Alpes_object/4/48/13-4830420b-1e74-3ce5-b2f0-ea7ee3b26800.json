  "rdfs:comment": {
    "de": [
      "Die Skilehrer der ESF von Auris begleiten Sie während Ihres gesamten Aufenthalts, unabhängig von Ihrem Niveau, beim Skifahren, Snowboarden oder anderen Wintersportarten."
    ],
    "en": [
      "The ESF instructors at Auris will accompany you throughout your stay, whatever your level of skiing, snowboarding or other snow sports."
    ],
    "it": [
      "Gli istruttori ESF di Auris vi guideranno durante il vostro soggiorno, qualunque sia il vostro livello, nello sci, nello snowboard o in altri sport sulla neve."
    ],
    "fr": [
      "Les moniteurs de l’ESF d’Auris vous accompagnent tout au long de votre séjour, quel que soit votre niveau, en ski, snowboard ou autres activités de glisse."
    ],
    "es": [
      "Los monitores de FSE de Auris le guiarán durante toda su estancia, sea cual sea su nivel, en esquí, snowboard u otros deportes de nieve."
    ],
    "nl": [
      "De ESF-instructeurs van Auris begeleiden je tijdens je verblijf, ongeacht je niveau op het gebied van skiën, snowboarden of andere sneeuwsporten."
    ]
  },
