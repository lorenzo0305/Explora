  "rdfs:comment": {
    "de": [
      "Victoria, Sommelière, und ihr Partner Thomas in der Küche empfangen Sie in ihrer gastronomischen Weinbar mit 400 Weinsorten und Gerichten aus hochwertigen Produkten.\nVorteil: Sonntag- und Montagabend geöffnet"
    ],
    "en": [
      "Victoria, sommelier, and her partner Thomas in the kitchen welcome you to their gourmet wine bar, with its 400 wine references and dishes to share made from quality products.\nOpen Sunday and Monday evenings"
    ],
    "it": [
      "Victoria, sommelier, e il suo socio Thomas in cucina vi danno il benvenuto nella loro enoteca gourmet, con 400 referenze di vini e piatti da condividere a base di prodotti di qualità.\nAperto domenica e lunedì sera"
    ],
    "fr": [
      "Victoria, sommelière & son compagnon Thomas en cuisine vous accueillent dans leur  bar à vin gastronomique, avec leurs 400 références de vin et leurs mets à partager composer de produits de qualité.\nLe plus, Ouvert dimanche et lundi soir"
    ],
    "es": [
      "Victoria, sumiller, y su socio Thomas en la cocina le dan la bienvenida a su vinoteca gastronómica, con sus 400 referencias de vinos y platos para compartir elaborados con productos de calidad.\nAbierto los domingos y lunes por la noche"
    ],
    "nl": [
      "Victoria, sommelier, en haar partner Thomas in de keuken heten je welkom in hun gastronomische wijnbar, met zijn 400 wijnreferenties en gerechten om te delen gemaakt van kwaliteitsproducten.\nZondag- en maandagavond geopend"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Toque & Vin"
    ]
  },
