  "rdfs:comment": {
    "de": [
      "Familienfreundlicher und spielerischer Spieleparcours im Wald von Nances zum Thema Astronomie. Um zu spielen, besorge dir das Spielset, das im Tourismusbüro Pays du Lac d'Aiguebelette erhältlich ist (5 ?)."
    ],
    "en": [
      "Family game circuit in the forest of Nances on the theme of astronomy. In order to play, you can buy the kit at the Pays du Lac d'Aiguebelette tourist office (5€)."
    ],
    "it": [
      "Un divertente percorso di gioco per famiglie nella foresta di Nances, sul tema dell'astronomia. Per giocare, procurarsi il kit di gioco in vendita presso l'Ufficio del Turismo del Pays du Lac d'Aiguebelette (5 euro)."
    ],
    "fr": [
      "Parcours jeu familial et ludique en forêt de Nances, sur le thème de l'astronomie. Pour jouer, procure-toi le kit de jeu en vente à l’Office de tourisme Pays du Lac d’Aiguebelette (5 €)."
    ],
    "es": [
      "Un divertido recorrido de juegos en familia en el bosque de Nances, sobre el tema de la astronomía. Para jugar, consigue el kit de juego a la venta en la Oficina de Turismo del País del Lago de Aiguebelette (5 €)."
    ],
    "nl": [
      "Een leuk familiespelparcours in het bos van Nances, met als thema astronomie. Om te spelen kun je een spelkit kopen bij het Office du Tourisme du Pays du Lac d'Aiguebelette (€5)."
    ]
  },
  "rdfs:label": {
    "en": [
      "La grotte du loup et le mystère du Disque Céleste"
    ],
    "fr": [
      "La grotte du loup et le mystère du Disque Céleste"
    ]
  },
