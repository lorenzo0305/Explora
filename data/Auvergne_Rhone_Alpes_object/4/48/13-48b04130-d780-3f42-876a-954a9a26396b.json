  "rdfs:comment": {
    "de": [
      "Das Château de Durette ist ein familiengeführtes Weingut im Herzen der Crus du Beaujolais. Die Crus du Beaujolais weisen eine starke Persönlichkeit auf, die einen Umweg wert ist. Ein Genuss für jeden Augenblick!"
    ],
    "en": [
      "Château de Durette is a family-run estate in the heart of the Beaujolais Crus. The Crus du Beaujolais have a strong personality and are well worth a visit. A pleasure at all times!"
    ],
    "it": [
      "Lo Château de Durette è una tenuta a conduzione familiare nel cuore dei Crus del Beaujolais. I Crus du Beaujolais hanno una forte personalità e meritano una visita. Un piacere in ogni momento!"
    ],
    "fr": [
      "Le Château de Durette est une propriété de type familiale, située au cœur des Crus du Beaujolais. Les Crus du Beaujolais présentent une forte personnalité qui mérite le détour. Un plaisir de tous les instants !"
    ],
    "es": [
      "El Château de Durette es una propiedad familiar situada en el corazón de los Crus del Beaujolais. Los Crus del Beaujolais tienen una fuerte personalidad y bien merecen una visita. ¡Un placer en todo momento!"
    ],
    "nl": [
      "Château de Durette is een familiedomein in het hart van de Crus de Beaujolais. De Crus du Beaujolais hebben een sterke persoonlijkheid en zijn zeker een bezoek waard. Altijd een plezier!"
    ]
  },
