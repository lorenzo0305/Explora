  "rdfs:comment": {
    "de": [
      "Le Comptoir ist eine Einladung, jeden Augenblick des Tages in einer warmen und geselligen Umgebung im Herzen von Morzine zu genießen (genießen)."
    ],
    "en": [
      "Le Comptoir is an invitation to enjoy every moment of the day in a warm and friendly setting in the heart of Morzine."
    ],
    "it": [
      "Le Comptoir è un invito a godersi ogni momento della giornata in un ambiente caldo e accogliente nel cuore di Morzine."
    ],
    "fr": [
      "Le Comptoir est une invitation à savourer (profiter) de chaque instant de la journée dans un cadre chaleureux et convivial, au cœur de Morzine."
    ],
    "nl": [
      "Le Comptoir is een uitnodiging om van elk moment van de dag te genieten in een warme en vriendelijke omgeving in het hart van Morzine."
    ],
    "es": [
      "Le Comptoir es una invitación a disfrutar de cada momento del día en un ambiente cálido y acogedor en el corazón de Morzine."
    ]
  },
