  "rdfs:comment": {
    "de": [
      "Parkplätze für Reisebusse gibt es auf der Promenade de la Digue Est, gegenüber der Distillerie et de la Vinaigrerie im Zentrum von Nyons.\nVorhandensein von öffentlichen WCs (Trockentoiletten)."
    ],
    "en": [
      "Coach parking is available on the Promenade de la Digue Est, opposite the Distillerie et de la Vinaigrerie in the center of Nyons.\nPublic toilets (dry toilets)."
    ],
    "it": [
      "I parcheggi per i pullman sono disponibili sulla Promenade de la Digue Est, di fronte alla Distilleria e alla Vinaigrerie nel centro di Nyons\nSono disponibili servizi igienici pubblici (bagni a secco)."
    ],
    "fr": [
      "Des places de parking pour autocars sont disponibles sur la Promenade de la Digue Est, en face de la Distillerie et de la Vinaigrerie en plein centre de Nyons. \nPrésence de WC publics (toilettes sèches)."
    ],
    "es": [
      "Hay plazas de aparcamiento para autocares en el paseo de la Digue Est, frente a la destilería y la vinería, en el centro de Nyons\nHay aseos públicos (aseos secos)."
    ],
    "nl": [
      "Er is parkeergelegenheid voor bussen op de Promenade de la Digue Est, tegenover de Distillerie et de la Vinaigrerie in het centrum van Nyons.\nOpenbare toiletten (droge toiletten) zijn beschikbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parking autocars de la Promenade de la Digue Est"
    ]
  },
