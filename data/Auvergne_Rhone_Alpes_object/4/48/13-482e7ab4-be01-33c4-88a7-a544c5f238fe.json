  "rdfs:comment": {
    "de": [
      "Historische Überreste in einem Dorf, das als eines der \"schönsten Dörfer Frankreichs\" und als \"Village Auvergnat de caractère\" klassifiziert ist.\r\nGeführte Besichtigungen täglich vom 1. Juli bis 31. August von 14:00 bis 18:00 Uhr."
    ],
    "en": [
      "Historic remains in a village listed as one of \"France's most beautiful villages\" and \"Village Auvergnat de caractère\".\r\nGuided tour every day from July 1 to August 31, 2 - 6 pm."
    ],
    "it": [
      "Resti storici in un villaggio classificato come uno dei \"più bei villaggi di Francia\" e come \"villaggio di carattere dell'Alvernia\".\r\nVisite guidate tutti i giorni dal 1° luglio al 31 agosto, dalle 14.00 alle 18.00."
    ],
    "fr": [
      "Vestiges historiques dans un village classé parmi \"les plus beaux villages de France\" et \"Village Auvergnat de caractère\".\r\nVisite guidée tous les jours du 1er juillet au 31 août de 14h à 18h."
    ],
    "es": [
      "Restos históricos en un pueblo catalogado como uno de los \"pueblos más bonitos de Francia\" y como \"pueblo con carácter de Auvernia\".\r\nVisitas guiadas todos los días del 1 de julio al 31 de agosto, de 14:00 a 18:00 h."
    ],
    "nl": [
      "Historische overblijfselen in een dorp dat geklasseerd staat als een van de \"mooiste dorpen van Frankrijk\" en als een \"karaktervol dorp in de Auvergne\".\r\nRondleidingen elke dag van 1 juli tot 31 augustus, 14u tot 18u."
    ]
  },
