  "rdfs:comment": {
    "de": [
      "Notouristischer Ort, der bis zu 120 Personen beherbergen kann.\r\nVerkostung von Weinen mit Bio-Label, Rebsorten Viognier, Gamay, Syrah, Gewürztraminer, Roussanne. Besichtigung des Weinguts und des Weinkellers auf Anfrage möglich, begleitet von lokalen Wurstwaren."
    ],
    "en": [
      "Tourist site for up to 120 people.\r\nOrganic wine tasting of Viognier, Gamay, Syrah, Gewurztraminer and Roussanne grapes. Tours of the estate and cellar available on request, accompanied by local charcuterie."
    ],
    "it": [
      "Sito turistico per un massimo di 120 persone.\r\nDegustazione di vini biologici Viognier, Gamay, Syrah, Gewurztraminer e Roussanne. Visite alla tenuta e alla cantina su richiesta, accompagnate da salumi locali."
    ],
    "fr": [
      "Site œnotouristique pouvant accueillir jusqu'à 120 personnes. \r\nDégustation des vins labellisés Bio, cépage Viognier, Gamay, Syrah, Gewurztraminer, Roussanne. Possibilité de visite du domaine et du caveau sur demande accompagnée de charcuterie locale."
    ],
    "nl": [
      "Toeristische locatie voor maximaal 120 personen.\r\nBiologische wijnproeverij van Viognier, Gamay, Syrah, Gewurztraminer en Roussanne. Rondleidingen over het landgoed en de kelder op aanvraag, vergezeld van lokale vleeswaren."
    ],
    "es": [
      "Sitio turístico para un máximo de 120 personas.\r\nDegustación de vinos ecológicos Viognier, Gamay, Syrah, Gewurztraminer y Roussanne. Visitas a la finca y a la bodega a petición, acompañadas de embutidos locales."
    ]
  },
