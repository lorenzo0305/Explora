  "rdfs:comment": {
    "de": [
      "Grand Cru-Kaffees, außergewöhnliche Tees, frisch gepresste Säfte, klassische Getränke, Gourmetgetränke (heiß oder eisgekühlt), Gebäck, Snacks..\r\nWir erfüllen die Bedürfnisse von Gourmets zu jeder Tageszeit."
    ],
    "en": [
      "Grand cru coffees, exceptional teas, pressed juices, classic drinks, gourmet drinks (hot or iced), pastries, snacks..\r\nWe meet the gourmet needs of every moment of the day."
    ],
    "it": [
      "Caffè Grand Cru, tè eccezionali, succhi di frutta, bevande classiche, bevande gourmet (calde o ghiacciate), pasticcini, snack?\r\nSoddisfiamo le esigenze gastronomiche di ogni momento della giornata."
    ],
    "fr": [
      "Cafés grands crus, thés d’exception, jus pressés, boissons classiques, boissons gourmandes (chaudes ou glacées), pâtisseries, snacking…\r\nNous répondons aux besoins gourmands de chaque moment de la journée."
    ],
    "nl": [
      "Grand cru koffie, uitzonderlijke thee, geperste sappen, klassieke dranken, gastronomische dranken (warm of met ijs), gebak, snacks..\r\nWij voorzien in de gastronomische behoeften van elk moment van de dag."
    ],
    "es": [
      "Cafés Grand Cru, tés excepcionales, zumos exprimidos, bebidas clásicas, bebidas gourmet (calientes o heladas), bollería, aperitivos..\r\nSatisfacemos las necesidades gourmet de cada momento del día."
    ]
  },
  "rdfs:label": {
