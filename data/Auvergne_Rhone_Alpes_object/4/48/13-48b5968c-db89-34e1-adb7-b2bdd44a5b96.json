  "rdfs:comment": {
    "de": [
      "Riom, die Verwaltungshauptstadt der königlichen Ländereien der Auvergne seit dem 13. Jahrhundert, ist Zentrum des Pays d'art et d'histoire de Riom, das als geschützter Sektor eingestuft ist und nicht weniger als 16 klassifizierte Denkmäler und 57 im Zusatzinventar eingetragene Bauwerke aufweist."
    ],
    "en": [
      "Riom has been the administrative capital of the Royal Lands of Auvergne since the 13th century, and is the center of Riom's Pays d'art et d'histoire. The town is listed as a protected area, and boasts no fewer than 16 listed monuments and 57 on the supplementary inventory."
    ],
    "it": [
      "Riom, capitale amministrativa delle Terre Reali d'Alvernia dal XIII secolo, è il centro del Pays d'art et d'histoire di Riom ed è classificato come area protetta, con non meno di 16 monumenti classificati e 57 nell'inventario supplementare."
    ],
    "fr": [
      "Capitale administrative des Terres royales d'Auvergne dès le XIIIème siècle, Riom, ville centre du Pays d'art et d'histoire de Riom, est classé secteur sauvegardé et ne compte pas moins de 16 monuments classés et 57 inscrits à l'inventaire supplémentaire."
    ],
    "nl": [
      "Riom, sinds de 13e eeuw de administratieve hoofdstad van de Koninklijke Landen van Auvergne, is het centrum van het Pays d'art et d'histoire van Riom en staat op de lijst van beschermde gebieden, met niet minder dan 16 beschermde monumenten en 57 op de aanvullende inventaris."
    ],
    "es": [
      "Riom, capital administrativa de las Tierras Reales de Auvernia desde el siglo XIII, es el centro del Pays d'art et d'histoire de Riom, y está catalogada como zona protegida, con no menos de 16 monumentos catalogados y 57 en el inventario suplementario."
    ]
  },
  "rdfs:label": {
    "de": [
      "Riom, historische Hauptstadt des Auvergne"
    ],
    "en": [
      "Riom, historic capital of Auvergne"
    ],
    "fr": [
      "Riom, capitale historique de l'Auvergne"
