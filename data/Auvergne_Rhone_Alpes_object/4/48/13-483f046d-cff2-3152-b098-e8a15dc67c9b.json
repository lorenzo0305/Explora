  "rdfs:comment": {
    "de": [
      "Da der Winzer oft im Freien arbeitet, ist es ratsam, vor Ihrem Besuch einen Termin zu vereinbaren.\r\nVerkostung und Verkauf der Appellationen auf dem Weingut: Beaujolais und Côte de Brouilly."
    ],
    "en": [
      "The winegrower often works outdoors, it is best to make an appointment before your visit.\r\nTasting and sale of the appellations on the estate: Beaujolais and Côte de Brouilly."
    ],
    "it": [
      "L'enologo lavora spesso all'aperto, quindi è meglio fissare un appuntamento prima della visita.\r\nDegustazione e vendita delle denominazioni della tenuta: Beaujolais e Côte de Brouilly."
    ],
    "fr": [
      "Le vigneron travaille souvent en extérieur, il est préférable de prendre rendez-vous avant votre visite.\r\nDégustation et vente des appellations au domaine : Beaujolais et Côte de Brouilly."
    ],
    "es": [
      "El enólogo suele trabajar al aire libre, por lo que es mejor concertar una cita antes de la visita.\r\nDegustación y venta de las denominaciones de la finca: Beaujolais y Côte de Brouilly."
    ],
    "nl": [
      "De wijnmaker werkt vaak buiten, dus u kunt het beste een afspraak maken voor uw bezoek.\r\nProeverij en verkoop van de appellations op het domein: Beaujolais en Côte de Brouilly."
    ]
  },
  "rdfs:label": {
