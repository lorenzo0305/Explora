  "rdfs:comment": {
    "de": [
      "Entdecken Sie neue Geschmacksrichtungen der typisch libanesischen Küche wie hausgemachten Hummus, Auberginenkaviar, Chawarma und noch viele andere Spezialitäten, die Sie mit wenigen Bissen auf eine Reise schicken!"
    ],
    "en": [
      "Come and discover new flavors of typical Lebanese cuisine such as homemade hummus, eggplant caviar, chawarmas and other specialties that will make you travel in a few bites !"
    ],
    "it": [
      "Venite a scoprire nuovi sapori della cucina tipica libanese come l'hummus fatto in casa, il caviale di melanzane, il chawarmas e altre specialità che vi faranno viaggiare in pochi bocconi!"
    ],
    "fr": [
      "Venez découvrir de nouvelles saveurs de la cuisine typiquement libanaise telles que le houmous maison, le caviar d'aubergine, les chawarmas et encore d'autres spécialités qui vous feront voyager en quelques bouchées !!"
    ],
    "es": [
      "Venga a descubrir nuevos sabores de la cocina típica libanesa, como el humus casero, el caviar de berenjena, los chawarmas y otras especialidades que le harán viajar en pocos bocados"
    ],
    "nl": [
      "Kom en ontdek nieuwe smaken van de typisch Libanese keuken zoals zelfgemaakte hummus, auberginekaviaar, chawarmas en andere specialiteiten die u in een paar happen op reis doen gaan!"
    ]
  },
  "rdfs:label": {
