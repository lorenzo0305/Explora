  "rdfs:comment": {
    "de": [
      "Auswahl aus 25 Pizzen, Salaten zum Zusammenstellen, Brettern zum Teilen, Desserts.\r\nPizzas zum Mitnehmen in 31 und 26 cm. Der Teig ist hausgemacht, die Zutaten stammen aus der lokalen und französischen Region."
    ],
    "en": [
      "Choice of 25 pizzas, salads to compose, boards to share, desserts.\r\nTakeaway pizzas in 31 and 26cm. All dough is homemade, and ingredients are sourced locally and in France."
    ],
    "it": [
      "Scelta di 25 pizze, insalate a volontà, taglieri da condividere, dessert.\r\nPizze da asporto da 31 e 26 cm. L'impasto è fatto in casa e gli ingredienti sono di provenienza locale e francese."
    ],
    "fr": [
      "Choix de 25 pizzas, salades à composer, planches à partager, desserts.\r\nPizzas à emporter en 31 et 26cm. La pâte est faite maison, les ingrédients proviennent du terroir local et français."
    ],
    "es": [
      "Selección de 25 pizzas, ensaladas a elegir, tablas para compartir, postres.\r\nPizzas para llevar de 31 y 26 cm. La masa es casera y los ingredientes proceden de la región y de Francia."
    ],
    "nl": [
      "Keuze uit 25 pizza's, salades om uit te kiezen, borden om te delen, desserts.\r\nAfhaalpizza's van 31 en 26 cm. Het deeg is huisgemaakt en de ingrediënten worden lokaal en in Frankrijk ingekocht."
    ]
  },
