  "rdfs:comment": {
    "de": [
      "Der Pétanque-Club Dunièrese freut sich, jeden Freitagabend einen Pétanque-Wettbewerb für alle zu organisieren. Kommen Sie und teilen Sie einen geselligen Moment rund um dieses beliebte Spiel!"
    ],
    "en": [
      "The Dunièrese Petanque Club is pleased to organize a petanque competition every Friday evening, open to all. Come and share a convivial moment around this popular game!"
    ],
    "it": [
      "Il Club Petanque Dunièrese è lieto di organizzare ogni venerdì sera una gara di petanque aperta a tutti. Venite a divertirvi con questo gioco popolare!"
    ],
    "fr": [
      "Le club de pétanque Dunièrese a le plaisir d'organiser tous les vendredis soir un concours de pétanque ouvert à tous. Venez partager un moment convivial autour de ce jeu populaire !"
    ],
    "es": [
      "El Club de Petanca Dunièrese se complace en organizar todos los viernes por la tarde una competición de petanca abierta a todos. ¡Venga a disfrutar de este popular juego!"
    ],
    "nl": [
      "De Dunièrese Petanque Club organiseert elke vrijdagavond een petanquewedstrijd die voor iedereen toegankelijk is. Kom genieten van dit populaire spel!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concours de pétanque"
    ]
  },
