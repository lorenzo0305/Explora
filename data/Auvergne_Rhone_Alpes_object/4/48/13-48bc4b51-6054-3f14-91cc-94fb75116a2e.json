  "rdfs:comment": {
    "de": [
      "Die Laiterie Gérentes enthüllt sich? und bietet Ihnen zwei Besucherkorridore, um unsere Region und unsere Werkstätten mit Blick auf die Käseherstellung zu entdecken."
    ],
    "en": [
      "Laiterie Gérentes unveils itself? and offers you two corridors to discover our terroir and our workshops with views of cheese-making."
    ],
    "it": [
      "Laiterie Gérentes si sta rivelando e vi offre due corridoi per scoprire il nostro terroir e i nostri laboratori con vista sul processo di caseificazione."
    ],
    "fr": [
      "La Laiterie Gérentes  se dévoile… et vous propose deux couloirs de visite pour découvrir notre terroir et nos ateliers avec vues sur la fabrication des fromages."
    ],
    "es": [
      "Laiterie Gérentes se revela... y le ofrece dos pasillos para descubrir nuestro terruño y nuestros talleres con vistas al proceso de fabricación del queso."
    ],
    "nl": [
      "Laiterie Gérentes onthult zichzelf en biedt je twee gangen om ons terroir en onze ateliers met uitzicht op het kaasmaakproces te ontdekken."
    ]
  },
  "rdfs:label": {
