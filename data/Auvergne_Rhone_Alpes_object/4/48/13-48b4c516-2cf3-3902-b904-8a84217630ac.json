  "rdfs:comment": {
    "de": [
      "Als leidenschaftlicher Fotograf mit Sitz in der Gemeinde Viuz-en-Sallaz in der Haute-Savoie liebe ich es, hinter der Linse zu stehen und Ihre kostbaren Augenblicke festzuhalten."
    ],
    "en": [
      "A passionate photographer based in Viuz-en-Sallaz in the Haute-Savoie region, I love being behind the lens to capture your precious moments."
    ],
    "it": [
      "Come appassionata fotografa di Viuz-en-Sallaz, nella regione francese dell'Alta Savoia, amo mettermi dietro l'obiettivo per catturare i vostri momenti preziosi."
    ],
    "fr": [
      "Photographe passionné situé en Haute-Savoie dans la commune de Viuz-en-Sallaz, j'aime être derrière l'objectif pour capturer vos instants précieux."
    ],
    "es": [
      "Como fotógrafa apasionada afincada en Viuz-en-Sallaz, en la región francesa de Alta Saboya, me encanta ponerme detrás del objetivo para captar tus momentos más preciados."
    ],
    "nl": [
      "Als gepassioneerd fotograaf gevestigd in Viuz-en-Sallaz in de Haute-Savoie regio van Frankrijk, sta ik graag achter de lens om jullie dierbare momenten vast te leggen."
    ]
  },
