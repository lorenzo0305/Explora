  "rdfs:comment": {
    "de": [
      "Im Süden des Sees von Annecy ist dieses markierte Gebiet ein unumgänglicher Treffpunkt für Freiflieger. Es ist auch der Ort für alle, die eine Taufe mit einem Tandem-Gleitschirm, einem Delta oder einem Ultraleichtflugzeug unter professioneller Anleitung suchen."
    ],
    "en": [
      "South of lake Annecy, this delineated area is the meeting point of free flight. This is also the place for those who would like to experience a tandem, hang gliding or microlight first flight with a professional."
    ],
    "it": [
      "A sud del lago di Annecy, quest'area segnalata è un punto d'incontro essenziale per gli appassionati di deltaplano. È anche il posto giusto per chi vuole fare un'esperienza di parapendio, deltaplano o ultraleggero in tandem con un professionista."
    ],
    "fr": [
      "Au sud du lac d'Annecy, cette zone balisée est un point de rendez-vous incontournable du vol libre. C'est aussi le lieu pour tous ceux qui cherchent à faire un baptême en parapente biplace, delta ou ulm avec un professionnel."
    ],
    "nl": [
      "Ten zuiden van het meer van Annecy is dit bewegwijzerde gebied een essentieel trefpunt voor deltavliegers. Het is ook de plek waar je moet zijn als je op zoek bent naar een tandem paragliding, deltavliegen of microlight ervaring met een professional."
    ],
    "es": [
      "Al sur del lago de Annecy, esta zona señalizada es un punto de encuentro imprescindible para los aficionados al ala delta. También es el lugar ideal para vivir una experiencia en parapente biplaza, ala delta o ultraligero con un profesional."
    ]
  },
  "rdfs:label": {
    "en": [
      "Paragliding landing - Doussard"
    ],
    "fr": [
      "Aire d'atterrissage de Doussard"
    ]
  },
