  "rdfs:comment": {
    "de": [
      "Das Anwesen umfasst ca. 32 Hektar Weinberge, deren Produktion aus Beaujolais AOC, Brouilly, Moulin à Vent, aber auch Gamaret, Viognier, Côteaux Bourguignons und prickelnde Roséweine, Bourgogne Blancs und Blancs de Blancs besteht."
    ],
    "en": [
      "The property covers approximately 32 hectares of vines, whose production is made up of Beaujolais AOC, Brouilly, Moulin à Vent, as well as Gamaret, Viognier, Côteaux Bourguignons and sparkling rosés, Bourgogne Blancs and Blancs de Blancs."
    ],
    "it": [
      "La proprietà si estende su circa 32 ettari di vigneti, che producono Beaujolais AOC, Brouilly, Moulin à Vent, ma anche Gamaret, Viognier, Côteaux Bourguignons e spumanti rosé, Bourgogne Blancs e Blancs de Blancs."
    ],
    "fr": [
      "La propriété regroupe 32 hectares de vignes environ, dont la production est constituée de Beaujolais AOC, Brouilly, Moulin à Vent, mais aussi de Gamaret, Viognier, Côteaux Bourguignons et rosés pétillants, Bourgogne Blancs et Blancs de Blancs."
    ],
    "es": [
      "La propiedad abarca aproximadamente 32 hectáreas de viñedos, que producen Beaujolais AOC, Brouilly, Moulin à Vent, pero también Gamaret, Viognier, Côteaux Bourguignons y espumosos rosados, Bourgogne Blancs y Blancs de Blancs."
    ],
    "nl": [
      "Het domein omvat ongeveer 32 hectare wijngaarden, die Beaujolais AOC, Brouilly, Moulin à Vent, maar ook Gamaret, Viognier, Côteaux Bourguignons en mousserende rosés, Bourgogne Blancs en Blancs de Blancs produceren."
    ]
  },
