  "rdfs:comment": {
    "de": [
      "Dieser wunderschöne, 11 Hektar große See der 2. Kategorie ist ein Paradies für Angler. Hier kann man Blackbass, Karpfen, Schleie und Rotauge angeln. Es handelt sich um einen See mit geschlossenem Gewässer und besonderen Vorschriften."
    ],
    "en": [
      "This magnificent 11 hectare lake, classified as category 2, is a paradise for fishermen. You can catch black bass, carp, tench, and roach here."
    ],
    "it": [
      "Questo magnifico lago di 11 ettari di seconda categoria è un paradiso per i pescatori. Si possono pescare black bass, carpe, tinche e lasche. È un lago chiuso con un regolamento specifico."
    ],
    "fr": [
      "Ce magnifique lac de 2ème catégorie de 11 hectares fait le paradis des pêcheurs. On peut y pêcher le black-bass, la carpe, la tanche et le gardon. C'est un lac en eau close avec une réglementation spécifique."
    ],
    "es": [
      "Este magnífico lago de 2ª categoría de 11 hectáreas es un paraíso para los pescadores. Se pueden pescar black bass, carpas, tencas y cucarachas. Es un lago cerrado con normas específicas."
    ],
    "nl": [
      "Dit prachtige meer van 11 hectare in de 2e categorie is een paradijs voor vissers. Je kunt hier vissen op black bass, karper, zeelt en voorn. Het is een gesloten meer met specifieke regels."
    ]
  },
