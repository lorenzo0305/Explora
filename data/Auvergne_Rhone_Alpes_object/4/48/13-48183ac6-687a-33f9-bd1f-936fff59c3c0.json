  "rdfs:comment": {
    "de": [
      "Die Terminals sind mit oder ohne Abonnement zugänglich. Abonnenten: mit dem eborn-Pass oder einem Smartphone im Online-Modus. Nicht-Abonnenten: mit einem Smartphone oder per kontaktloser Bankkarte an bestimmten Terminals, mit dem Pass eines anderen Mobilitätsanbieters."
    ],
    "en": [
      "The terminals are accessible with or without a subscription. Subscribers: with eborn pass or smartphone in connected mode. Non-subscribers: with a smartphone or contactless bank card for certain kiosks, or with another mobility operator's pass."
    ],
    "it": [
      "I chioschi sono accessibili con o senza abbonamento. Abbonati: con l'eborn pass o con uno smartphone in modalità connessa. Non abbonati: con uno smartphone o una carta bancaria contactless per alcuni chioschi, con il pass di un altro operatore di mobilità."
    ],
    "fr": [
      "Les bornes sont accessibles avec ou sans abonnement. Abonnés : avec le pass eborn ou un smartphone en mode connecté. Non-abonnés : avec un smartphone ou par carte bancaire sans contact pour certaines bornes, avec le pass d'un autre opérateur de mobilité."
    ],
    "es": [
      "Los quioscos son accesibles con o sin abono. Abonados: con el pase eborn o un smartphone en modo conectado. No abonados: con un smartphone o una tarjeta bancaria sin contacto para determinados quioscos, con el pase de otro operador de movilidad."
    ],
    "nl": [
      "De terminals zijn toegankelijk met of zonder abonnement. Abonnees: met de eborn pas of een smartphone in connected modus. Niet-abonnees: met een smartphone of contactloze bankkaart voor bepaalde kiosken, of met een pas van een andere mobiliteitsoperator."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Borne de recharge pour véhicule électrique - Réseau e-born"
    ]
  },
