  "rdfs:comment": {
    "de": [
      "Das Morricone ist ein Restaurant mit Saloon-Atmosphäre und einem freundlichen und herzlichen Rahmen, das Ihnen seine savoyischen Spezialitäten, BBQ und Planchas, Spezialburger, Pizzas und vegetarische Gerichte, Snacks, Take-away, am Fuße der Pisten anbietet."
    ],
    "en": [
      "Le Morricone is a saloon-style restaurant with a warm and friendly atmosphere, offering Savoyard specialities, BBQs and planchas, special burgers, pizzas and vegetarian dishes, snacking and take-away at the foot of the slopes."
    ],
    "it": [
      "Le Morricone è un ristorante con un'atmosfera da saloon e un'atmosfera calda e amichevole, che offre specialità savoiarde, barbecue e planchas, hamburger speciali, pizze e piatti vegetariani, snack e take-away ai piedi delle piste."
    ],
    "fr": [
      "Le Morricone est un restaurant à l'ambiance Saloon et au cadre convivial et chaleureux vous proposant ses spécialités savoyardes, BBQ et planchas, burgers spéciaux , pizzas et plats végétariens, snacking, vente à emporter, en pied de pistes."
    ],
    "nl": [
      "Le Morricone is een restaurant met een salonsfeer en een warme, vriendelijke sfeer, met Savoyaardse specialiteiten, BBQ's en plancha's, speciale hamburgers, pizza's en vegetarische gerechten, snacks en afhaalmaaltijden aan de voet van de pistes."
    ],
    "es": [
      "Le Morricone es un restaurante con ambiente de salón y una atmósfera cálida y acogedora, que ofrece especialidades saboyanas, barbacoas y planchas, hamburguesas especiales, pizzas y platos vegetarianos, tentempiés y comida para llevar a pie de pistas."
    ]
  },
