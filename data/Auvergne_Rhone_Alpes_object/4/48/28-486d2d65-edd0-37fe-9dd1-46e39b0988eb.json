  "rdfs:comment": {
    "de": [
      "Entdecken Sie hier die Wunder der Art Forain, eine immersive Erfahrung im Herzen des Jahrmarkts von einst, zwischen alter Ästhetik und Industriearchitektur."
    ],
    "en": [
      "Discover the wonders of Art Forain, an immersive experience at the heart of the funfair of yesteryear, between ancient aesthetics and industrial architecture."
    ],
    "it": [
      "Qui potrete scoprire le meraviglie dell'arte da fiera, un'esperienza immersiva nel cuore del luna park di un tempo, che unisce estetica antica e architettura industriale."
    ],
    "fr": [
      "Découvrez ici les merveilles de l'Art Forain, une expérience immersive au cœur de la fête foraine d'antan, entre esthétique ancienne et architecture industrielle."
    ],
    "nl": [
      "Hier kun je de wonderen van de kermiskunst ontdekken, een meeslepende ervaring in het hart van de kermis van weleer, een combinatie van oude esthetiek en industriële architectuur."
    ],
    "es": [
      "Aquí podrá descubrir las maravillas del arte ferial, una experiencia inmersiva en el corazón del parque de atracciones de antaño, que combina la estética antigua y la arquitectura industrial."
    ]
