  "rdfs:comment": {
    "de": [
      "Eingebettet in das unendliche Weiß des Skigebiets Paradiski® empfängt Sie das Chalet du Friolin mit seinem Restaurant, seiner Bar und seinen Gästezimmern in 1800 m Höhe auf den Pisten von La Plagne Montchavin-Les Coches."
    ],
    "en": [
      "Nestling in the white infinity of the Paradiski® ski area, Chalet du Friolin welcomes you to its restaurant bar and guest rooms 1,800 metres above sea level on the slopes of La Plagne Montchavin-Les Coches."
    ],
    "it": [
      "Immerso nel bianco infinito del dominio Paradiski®, lo Chalet du Friolin vi accoglie nel suo ristorante-bar e nelle sue camere a 1800 metri di altitudine sulle piste di La Plagne Montchavin-Les Coches."
    ],
    "fr": [
      "Niché dans l’infini blanc du domaine Paradiski®, le chalet du Friolin vous accueille dans son restaurant-bar et ses chambres d’hôtes à 1800 mètres d’altitude sur les pistes de La Plagne Montchavin-Les Coches."
    ],
    "nl": [
      "Le Chalet du Friolin, gelegen in de eindeloze witte vlakte van het domein Paradiski, verwelkomt U in zijn bar-restaurant en zijn gastenkamers, op een hoogte van 1800 meters op de skipistes van La Plagne Montchavin-Les Coches."
    ],
    "es": [
      "Enclavado en el blanco infinito del dominio Paradiski®, el Chalet du Friolin le da la bienvenida a su restaurante-bar y a sus habitaciones de huéspedes a 1.800 metros de altitud en las pistas de La Plagne Montchavin-Les Coches."
    ]
  },
