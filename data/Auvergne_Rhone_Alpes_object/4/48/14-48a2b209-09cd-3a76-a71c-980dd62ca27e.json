      "@id": "https://data.datatourisme.fr/1b094b45-f4a7-3573-9fa2-91c9c26480fd",
      "dc:description": {
        "de": [
          "Von 14h bis 16h ? Lass dich von einem DJ in die Welt der Plattenspieler einführen ? Front de mer à Sainte Cécile - Ab 6 Jahren ? Anmeldung im Office de Tourisme ? Kostenlos"
        ],
        "en": [
          "From 2pm to 4pm ? Come and learn to turn the decks with a DJ ? Seafront in Sainte Cécile - From 6 years old ? Registration at the Tourist Office ? Free"
        ],
        "it": [
          "Dalle 14.00 alle 16.00? Venite a cimentarvi ai giradischi con un DJ? Lungomare di Sainte Cécile - Da 6 anni ? Registrazione presso l'Ufficio del Turismo ? Gratuito"
        ],
        "fr": [
          "De 14h à 16h – Viens t’initier aux platines avec un DJ – Front de mer à Sainte Cécile - A partir de 6 ans – Inscription à l’Office de Tourisme – Gratuit"
        ],
        "nl": [
          "Van 14.00 tot 16.00 uur ? Kom en probeer je hand op de draaitafels met een DJ ? Sainte Cécile Boulevard - Vanaf 6 jaar ? Inschrijving bij het VVV-kantoor ? Gratis"
        ],
        "es": [
          "De 14:00 a 16:00 ? Ven a probar los platos con un DJ ? Paseo marítimo de Sainte Cécile - A partir de 6 años ? Inscripción en la Oficina de Turismo ? Gratis"
        ]
      },
