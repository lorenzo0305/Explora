  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/61832d37-5f38-3696-b66b-f15f037106de",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n \nMontag bis Freitag von 8:15 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\n\nSamstags von 8:15 bis 12:30 Uhr und von 14:00 bis 17:00 Uhr\n \n Abholung :\n\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n \nMonday to Friday, 8.15am to 12.30pm and 2pm to 7pm\n\nSaturday 8.15am to 12.30pm and 2pm to 5pm\n \n Collection:\n\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n \nDal lunedì al venerdì, dalle 8.15 alle 12.30 e dalle 14.00 alle 19.00\n\nSabato dalle 8.15 alle 12.30 e dalle 14.00 alle 17.00\n \n Ritiro:\n\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n \nDu lundi au vendredi de 8h15 à 12h30 et de 14h00 à 19h00\n\nLe samedi de 8h15 à 12h30 et de 14h00 à 17h00\n \n Retrait :\n\nAux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n \nMaandag tot vrijdag van 8.15 tot 12.30 uur en van 14.00 tot 19.00 uur\n\nZaterdag 8.15 tot 12.30 en 14 tot 17 uur\n \n Ophalen:\n\nTijdens openingstijden van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n \nDe lunes a viernes de 8h15 a 12h30 y de 14h00 a 19h00\n\nSábados de 8.15 a 12.30 y de 14.00 a 17.00 horas\n \n Recogida:\n\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
