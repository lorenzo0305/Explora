  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein originelles Konzept von Multiaktivitäten für unterwegs: Bubble Bump - Archery Bump - Laser Bump. Entdecken Sie unsere Versionen von Fußball, Bogenschießen und Laserspielen."
    ],
    "en": [
      "Come and discover an original concept in mobile multi-activity: Bubble Bump - Archery Bump - Laser Bump. Discover our versions of soccer, archery and laser bumping."
    ],
    "it": [
      "Venite a scoprire un concetto originale di multiattività nomade: Bubble Bump - Archery Bump - Laser Bump. Scoprite le nostre versioni di calcio, tiro con l'arco e laser bumping."
    ],
    "fr": [
      "Venez découvrir un concept original de multi-activité nomade: Bubble Bump - Archery Bump - Laser Bump. Partez à la découverte de nos versions du foot, tir à l’arc et jeu de laser."
    ],
    "es": [
      "Venga a descubrir un concepto original de multiactividad móvil: Bubble Bump - Archery Bump - Laser Bump. Descubre nuestras versiones de fútbol, tiro con arco y bumping láser."
    ],
    "nl": [
      "Kom en ontdek een origineel concept van mobiele multi-activiteit: Bubble Bump - Archery Bump - Laser Bump. Ontdek onze versies van voetbal, boogschieten en lasergames."
    ]
