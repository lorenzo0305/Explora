  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais durch ein spielerisches Geocaching-Erlebnis: eine Schatzsuche, die Sie mit der ganzen Familie erleben können!\r\nErforschen Sie in Vaux-en-Beaujolais mit dem Gnolu Kloche die Geheimnisse des Freskos von Clochermerle."
    ],
    "en": [
      "Discover the Beaujolais region through a fun geocaching experience: a treasure hunt for the whole family!\r\nIn Vaux-en-Beaujolais, explore the secrets of the Clochermerle fresco with the Gnolu Kloche."
    ],
    "it": [
      "Scoprite la regione del Beaujolais attraverso una divertente esperienza di geocaching: una caccia al tesoro per tutta la famiglia!\r\nA Vaux-en-Beaujolais, scoprite i segreti dell'affresco di Clochermerle con la Gnolu Kloche."
    ],
    "fr": [
      "Découvrez le Beaujolais à travers une expérience ludique de géocaching : une chasse aux trésors à vivre en famille ! \r\nÀ Vaux-en-Beaujolais, explorez les secrets de la fresque de Clochermerle avec le Gnolu Kloche."
    ],
    "nl": [
      "Ontdek de Beaujolais via een leuke geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nOntdek in Vaux-en-Beaujolais de geheimen van het fresco van Clochermerle met de Gnolu Kloche."
    ],
    "es": [
      "Descubra la región del Beaujolais a través de una divertida experiencia de geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn Vaux-en-Beaujolais, explore los secretos del fresco de la Clochermerle con el Gnolu Kloche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Quelque chose qui cloche..."
    ]
  },
