  "rdfs:comment": {
    "de": [
      "Das Hotel Alexane bietet 33 Suiten, in denen Komfort, Eleganz und Authentizität im Vordergrund stehen.  Lassen Sie sich vom Wellnesszentrum, den Behandlungen im Spa Montagnes du Monde ® und der italienischen Gastronomie im Restaurant verwöhnen."
    ],
    "en": [
      "The hotel Alexane offers 33 suites with comfort, elegance and authenticity. Let yourself be tempted by the Wellness Center, the beauty treatments of the Spa Montagnes du Monde ® and the Italian gastronomy of the restaurant."
    ],
    "it": [
      "L'Hotel Alexane offre 33 suite che mettono in risalto comfort, eleganza e autenticità.  Lasciatevi tentare dal Centro Benessere, dai trattamenti della Montagnes du Monde ® Spa e dalla gastronomia italiana del ristorante."
    ],
    "fr": [
      "L’hôtel Alexane offre 33 suites privilégiant confort, élégance et authenticité.  Laissez-vous tenter par le Centre Wellness, les soins du Spa Montagnes du Monde ® et la gastronomie italienne du restaurant."
    ],
    "nl": [
      "Hotel ‘’Alexane’ telt 33 uitermate comfortabele suites die stijlvol en authentiek zijn ingericht. Op-en-top ontspanning: laat je verleiden door het wellnesscentrum, de verzorgingen in de Spa Montagnes du Monde® en de Italiaanse gastronomie van het restaurant."
    ],
    "es": [
      "El Hotel Alexane ofrece 33 suites que destacan por su comodidad, elegancia y autenticidad.  Déjese tentar por el Centro de Bienestar, los tratamientos del Spa Montagnes du Monde ® y la gastronomía italiana del restaurante."
    ]
  },
