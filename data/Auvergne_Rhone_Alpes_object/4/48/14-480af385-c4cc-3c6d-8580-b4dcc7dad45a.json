  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Kits, mit denen Sie Geschichte spielerisch entdecken können.\nEs gibt zwei Optionen: ein Erkundungsset, das größtenteils vor Ort durchgeführt werden kann, und ein Aktivitätenset, das zu Hause durchgeführt werden kann."
    ],
    "en": [
      "Come and discover our kits for a fun way to learn about history.\nTwo options are available: an exploration kit to be done mainly on site, and an activity kit to be done at home."
    ],
    "it": [
      "Venite a scoprire i nostri kit per imparare la Storia divertendosi.\nSono disponibili due opzioni: un kit di esplorazione da fare principalmente sul posto e un kit di attività da fare a casa."
    ],
    "fr": [
      "Venez découvrir nos kits pour découvrir l'Histoire en s'amusant. \nDeux options sont disponibles : un kit d'exploration à faire majoritairement sur place et un kit d'activités à faire chez soi."
    ],
    "es": [
      "Venga a descubrir nuestros kits para aprender Historia divirtiéndose.\nHay dos opciones disponibles: un kit de exploración para realizar principalmente in situ y un kit de actividades para realizar en casa."
    ],
    "nl": [
      "Kom en ontdek onze kits om op een leuke manier over geschiedenis te leren.\nEr zijn twee opties beschikbaar: een ontdekkingskit die je voornamelijk ter plekke doet en een activiteitenkit die je thuis doet."
    ]
  },
  "rdfs:label": {
    "fr": [
