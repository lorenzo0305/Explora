  "rdfs:comment": {
    "de": [
      "Das Casino-Restaurant bietet Ihnen qualitative Brasserie-Küche, die den meisten unter Ihnen mit Sicherheit gefallen wird."
    ],
    "en": [
      "The casino restaurant offers high-quality brasserie-style cuisine which most people will undoubtedly fi nd delightful."
    ],
    "it": [
      "Il ristorante del casinò e il suo chef offrono una cucina di qualità in stile brasserie che senza dubbio affascinerà il maggior numero di persone\r\nRicevimenti, seminari, riunioni, cocktail, pasti in famiglia o con gli amici."
    ],
    "fr": [
      "Le restaurant du casino et son  chef vous proposent une cuisine de type brasserie de qualité qui saura sans conteste, charmer le plus grand nombre. \r\nRéceptions, séminaires, réunions, cocktails, repas en famille ou entre amis."
    ],
    "nl": [
      "Het restaurant van het casino en zijn chef bieden een kwaliteitsvolle keuken in brasseriestijl die ongetwijfeld de meeste mensen zal bekoren\r\nRecepties, seminars, vergaderingen, cocktails, maaltijden met familie of vrienden."
    ],
    "es": [
      "El restaurante del casino y su chef ofrecen una cocina de calidad al estilo brasserie que, sin duda, encantará al mayor número de personas\r\nRecepciones, seminarios, reuniones, cócteles, comidas en familia o con amigos."
    ]
  },
