  "rdfs:comment": {
    "de": [
      "Bildende Künstlerin\r\nMischtechniken, Malerei, Collage, Cyanotypie.\r\nspuren meiner Erinnerungen, meiner vergangenen oder geträumten Reisen, abstrakte Landschaften, gedankliche Wanderungen oder poetische Mechaniken entstehen. Kommen Sie und reisen Sie in mein blaues Universum!"
    ],
    "en": [
      "Visual artist\r\nMixed media, painting, collage, cyanotype.\r\ntraces of my memories, past or dreamed travels, abstract landscapes, mental wanderings or poetic mechanics take shape. Come and journey into my blue universe!"
    ],
    "it": [
      "Artista visivo\r\nTecnica mista, pittura, collage, cianotipia.\r\ntracce dei miei ricordi, viaggi passati o sogni, paesaggi astratti, vagabondaggi mentali o meccaniche poetiche prendono forma. Venite a viaggiare nel mio mondo blu!"
    ],
    "fr": [
      "Artiste plasticienne\r\nTechniques mixtes, peinture, collage, cyanotype.\r\n​Traces de mes mémoires, de mes voyages passés ou rêvés, paysages abstraits, déambulations mentales, ou mécaniques poétiques se dessinent. Venez voyager dans mon univers bleu!"
    ],
    "nl": [
      "Beeldend kunstenaar\r\nGemengde techniek, schilderen, collage, cyanotypie.\r\nsporen van mijn herinneringen, voorbije reizen of dromen, abstracte landschappen, mentale omzwervingen of poëtische mechanica krijgen vorm. Kom en reis mee in mijn blauwe wereld!"
    ],
    "es": [
      "Artista visual\r\nTécnica mixta, pintura, collage, cianotipia.\r\ntrazos de mis recuerdos, viajes o sueños pasados, paisajes abstractos, vagabundeos mentales o mecánicas poéticas toman forma. ¡Ven y viaja a mi mundo azul!"
    ]
  },
