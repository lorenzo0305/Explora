  "rdfs:comment": {
    "de": [
      "Können Sie die Briefe der Marquise de Sévigné entziffern? Ein Workshop, um sich mit dem Lesen alter Schriften vertraut zu machen. Der Workshop wird von den Archives départementales de la Drôme im Rahmen von 2026, Année Sévigné angeboten."
    ],
    "en": [
      "Can you decipher the letters of the Marquise de Sévigné? A workshop to learn how to read ancient scripts. Workshop offered by the Archives départementales de la Drôme as part of 2026, Année Sévigné."
    ],
    "it": [
      "Sapete decifrare le lettere della Marchesa di Sévigné? Un laboratorio per imparare a leggere le antiche scritture. Questo laboratorio è organizzato dagli Archives départementales de la Drôme nell'ambito di 2026, Année Sévigné."
    ],
    "fr": [
      "Saurez-vous déchiffrer les lettres de la Marquise de Sévigné ? Un atelier pour se familiariser avec la lecture des écritures anciennes. Atelier proposé par les Archives départementales de la Drôme dans le cadre de 2026, Année Sévigné."
    ],
    "es": [
      "¿Puede descifrar las letras de la marquesa de Sévigné? Un taller para aprender a leer escrituras antiguas. Este taller está organizado por los Archives départementales de la Drôme en el marco de 2026, Année Sévigné."
    ],
    "nl": [
      "Kun jij de letters van de markiezin van Sévigné ontcijferen? Een workshop om oude schriften te leren lezen. Workshop georganiseerd door de Archives départementales de la Drôme in het kader van 2026, Année Sévigné."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier paléographie - Lecture des lettres anciennes"
    ]
  },
