  "rdfs:comment": {
    "de": [
      "Marie-Claude Pezet, Guy Pezet und Luc Dumontier, die seit über 20 Jahren in Flaine staatlich geprüfte Skilehrer sind, können sich auf Ihr technisches und körperliches Niveau einstellen, egal ob Sie Anfänger, mittlerer oder fortgeschrittener Skifahrer sind."
    ],
    "en": [
      "Marie-Claude Pezet, Guy Pezet and Luc Dumontier, who have over 20 years' experience in Flaine, will adapt to your technical and physical level, whether you're a beginner, intermediate or advanced skier."
    ],
    "it": [
      "Marie-Claude Pezet, Guy Pezet e Luc Dumontier, tutti sciatori qualificati con oltre 20 anni di esperienza a Flaine, si adatteranno al vostro livello tecnico e fisico, sia che siate principianti, intermedi o avanzati."
    ],
    "fr": [
      "Marie-Claude Pezet, Guy Pezet et Luc Dumontier, diplômés d’état depuis plus de 20 ans à Flaine,  sauront s’adapter à votre niveau technique et physique, que vous soyez skieur débutant, moyen ou confirmé."
    ],
    "es": [
      "Marie-Claude Pezet, Guy Pezet y Luc Dumontier, todos ellos esquiadores titulados con más de 20 años de experiencia en Flaine, se adaptarán a tu nivel técnico y físico, ya seas principiante, esquiador intermedio o avanzado."
    ],
    "nl": [
      "Marie-Claude Pezet, Guy Pezet en Luc Dumontier, die meer dan 20 jaar ervaring hebben in Flaine, passen zich aan je technische en fysieke niveau aan, of je nu een beginner, gevorderde of vergevorderde skiër bent."
    ]
  },
  "rdfs:label": {
