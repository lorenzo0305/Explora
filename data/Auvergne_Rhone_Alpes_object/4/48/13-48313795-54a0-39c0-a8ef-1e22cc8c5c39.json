  "rdfs:comment": {
    "de": [
      "Restaurant La Lozde, sorgfältig und authentisch renovierter Almbauernhof. Entdecken Sie unsere originelle und schmackhafte Küche an der Kreuzung der Skigebiete von Praz sur Arly und Flumet, am Gipfel des Skilifts Les Bernards. Zugang mit Skiern oder Schneeschuhen."
    ],
    "en": [
      "Restaurant La Lozde, an alpine farmhouse renovated with care and authenticity.\r\nCome and discover our original and tasty cuisine at the junction of the Praz sur Arly and Flumet ski areas, at the top of the Bernards ski lift. Access by ski or snowshoes."
    ],
    "it": [
      "Ristorante La Lozde, un casale alpino ristrutturato con cura e autenticità. Venite a scoprire la nostra cucina originale e gustosa all'incrocio dei comprensori sciistici di Praz sur Arly e Flumet, in cima all'impianto di risalita dei Bernards. Accesso con gli sci o con le racchette da neve."
    ],
    "fr": [
      "Restaurant La Lozde, ferme d'alpage rénovée avec soin et authenticité. Venez découvrir notre cuisine originale et savoureuse à la jonction du domaine skiable de Praz sur Arly et de Flumet, au sommet du téléski des Bernards. Accès en ski ou en raquettes."
    ],
    "es": [
      "Restaurante La Lozde, una granja alpina renovada con esmero y autenticidad. Venga a descubrir nuestra cocina original y sabrosa en el cruce de las estaciones de esquí de Praz sur Arly y Flumet, en lo alto del telesilla de Bernards. Acceso con esquís o raquetas de nieve."
    ],
    "nl": [
      "Restaurant La Lozde, een met zorg en authenticiteit gerenoveerde alpenboerderij.\r\nKom en ontdek onze originele en smakelijke keuken op de kruising van de skigebieden Praz sur Arly en Flumet\r\nvan Praz sur Arly en Flumet, bovenaan de skilift Bernards.\r\nToegang met ski's of sneeuwschoenen."
    ]
  },
