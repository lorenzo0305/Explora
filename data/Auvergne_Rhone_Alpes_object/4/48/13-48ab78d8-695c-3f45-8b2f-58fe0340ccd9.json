  "rdfs:comment": {
    "de": [
      "Champclause, eine Gemeinde mit zwei Dörfern, hat seine Pfarrkirche im Hauptort auf dem Plateau, während Boussoulet, ein größeres Dorf, das sich an der Straße Le Puy - Valence angesiedelt hat, ebenfalls eine Kirche besitzt."
    ],
    "en": [
      "Champclause, a commune of two villages, has its parish church in the chief town, on the plateau, while Boussoulet, a larger village on the Le Puy - Valence road, also has a church."
    ],
    "it": [
      "Champclause, un comune con due villaggi, ha la sua chiesa parrocchiale nel capoluogo sull'altopiano, mentre Boussoulet, un villaggio più grande sulla strada Le Puy - Valence, ha anch'esso una chiesa."
    ],
    "fr": [
      "Champclause, commune à deux villages, a son église paroissiale au chef-lieu, sur le plateau, alors que Boussoulet, village plus important, installé sur la route Le Puy - Valence possède aussi une église."
    ],
    "es": [
      "Champclause, un municipio con dos pueblos, tiene su iglesia parroquial en la ciudad principal de la meseta, mientras que Boussoulet, un pueblo más grande en la carretera Le Puy - Valence, también tiene una iglesia."
    ],
    "nl": [
      "Champclause, een gemeente met twee dorpen, heeft zijn parochiekerk in de hoofdplaats op het plateau, terwijl Boussoulet, een groter dorp aan de weg Le Puy - Valence, ook een kerk heeft."
    ]
  },
