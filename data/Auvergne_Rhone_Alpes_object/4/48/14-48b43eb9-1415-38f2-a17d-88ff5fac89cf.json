      "@id": "https://data.datatourisme.fr/f3f60056-6ba2-34fd-9df7-996323dc6ca0",
      "dc:description": {
        "de": [
          "1-Beratung, Verkauf, Verleih von medizinischen Geräten, Rollstühlen und Kundendienst\n2-Beratung, Verkauf, Kundendienst von Fahrrädern mit und ohne elektrische Unterstützung\n\nDeponierung von Batterien bei Fachleuten"
        ],
        "en": [
          "1-Advice, sales, rental of medical equipment, wheelchairs and after-sales service\n2-Advice, sales, after-sales service for bicycles with and without electrical assistance\n\nProfessional battery removal"
        ],
        "it": [
          "1-Consulenza, vendita, noleggio di attrezzature mediche, sedie a rotelle e assistenza post-vendita\n2-Consulenza, vendita, assistenza post-vendita di biciclette con e senza assistenza elettrica\n\nRimozione di batterie da locali professionali"
        ],
        "fr": [
          "1-Conseils, ventes, locations de matériel médical, fauteuils roulants et SAV\n2-Conseils, ventes, SAV de vélos avec et sans assistance éléctrique\n\nDéposes des batteries chez des professionnels"
        ],
        "es": [
          "1-Asesoramiento, venta, alquiler de equipos médicos, sillas de ruedas y servicio posventa\n2-Asesoramiento, venta, servicio posventa de bicicletas con y sin asistencia eléctrica\n\nRetirada de baterías de locales profesionales"
        ],
        "nl": [
          "1-Advies, verkoop, verhuur van medische apparatuur, rolstoelen en service na verkoop\n2-Advies, verkoop, service na verkoop voor fietsen met en zonder elektrische ondersteuning\n\nVerwijderen van batterijen uit professionele ruimten"
        ]
      },
