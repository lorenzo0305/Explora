  "rdfs:comment": {
    "de": [
      "Dieser Workshop ist ein Einstieg in die faszinierende Welt der Parfümkreation. Das Studium der Rohstoffe und das Erlernen von Akkorden stehen auf dem Programm."
    ],
    "en": [
      "This workshop is an introduction to the fascinating world of perfume creation. The program includes a study of raw materials and learning how to match them."
    ],
    "it": [
      "Questo workshop è un'introduzione all'affascinante mondo della creazione di profumi. Il programma prevede lo studio delle materie prime e l'apprendimento dell'abbinamento delle fragranze."
    ],
    "fr": [
      "Cet atelier est une entrée dans l’univers fascinant de la création parfumée. Etude des matières premières et apprentissage des accords au programme."
    ],
    "es": [
      "Este taller es una introducción al fascinante mundo de la creación de perfumes. El programa incluye un estudio de las materias primas y el aprendizaje de cómo combinar fragancias."
    ],
    "nl": [
      "Deze workshop is een introductie in de fascinerende wereld van parfumcreatie. Het programma omvat een studie van grondstoffen en leren hoe geuren bij elkaar passen."
    ]
  },
