  "rdfs:comment": {
    "de": [
      "Machen Sie einen Ausflug durch die Sammlungen des Museums, besuchen Sie das Tal und erfahren Sie mehr über seine touristische Bestimmung. Geschichten, Anekdoten und gute Stimmung sind garantiert!"
    ],
    "en": [
      "Take a tour of the museum's collections, visit the valley and discover its tourist destiny. Stories, anecdotes and a good time are guaranteed!"
    ],
    "it": [
      "Fate un viaggio tra le collezioni del museo, visitate la valle e scoprite il suo destino turistico. Storie, aneddoti e divertimento a volontà!"
    ],
    "fr": [
      "Partez en excursion au milieu des collections du musée, visitez la vallée et découvrez sa destinée touristique. Histoires, anecdotes et bonne ambiance seront au rendez-vous !"
    ],
    "nl": [
      "Maak een reis door de collecties van het museum, bezoek de vallei en ontdek de toeristische bestemming. Verhalen, anekdotes en een leuke tijd!"
    ],
    "es": [
      "Haga un recorrido por las colecciones del museo, visite el valle y descubra su destino turístico. Historias, anécdotas y diversión a raudales"
    ]
  },
  "rdfs:label": {
