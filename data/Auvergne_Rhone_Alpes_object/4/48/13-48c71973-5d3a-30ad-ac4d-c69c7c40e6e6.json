  "rdfs:comment": {
    "de": [
      "Künstlerin und Keramikerin. Kreationen von Gebrauchskeramik.\r\nMarie Laure ist auf zahlreichen Kreativmärkten vertreten.\r\nIhr Atelier ist jeden Donnerstag von 10:00 bis 18:00 Uhr geöffnet."
    ],
    "en": [
      "Ceramic artist. Creations of utilitarian pottery.\r\nMarie Laure takes part in many creative markets.\r\nHer studio is open every Thursday from 10am to 6pm."
    ],
    "it": [
      "Artista della ceramica. Creazione di ceramiche utilitarie.\r\nMarie Laure partecipa a numerosi mercati creativi.\r\nIl suo studio è aperto tutti i giovedì dalle 10.00 alle 18.00."
    ],
    "fr": [
      "Artisane céramiste. Créations de poteries utilitaires.\r\nMarie Laure est présente sur de nombreux marchés de création.\r\nSon atelier est ouvert tous les jeudis de 10h à 18h."
    ],
    "nl": [
      "Keramisch kunstenaar. Creatie van gebruiksaardewerk.\r\nMarie Laure neemt deel aan vele creatieve markten.\r\nHaar atelier is elke donderdag open van 10 tot 18 uur."
    ],
    "es": [
