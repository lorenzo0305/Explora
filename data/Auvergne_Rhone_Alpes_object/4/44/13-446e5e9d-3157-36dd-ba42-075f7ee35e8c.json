  "rdfs:comment": {
    "de": [
      "Aus Getreide und lokalen und saisonalen Früchten hergestellte Biere. Dieser Produzent bietet Biere an, die von Goûtez l'Ardèche ausgewählt wurden. Besichtigung nach Absprache möglich."
    ],
    "en": [
      "Beers produced from cereales and local fruits."
    ],
    "it": [
      "Birre prodotte con cereali e frutta locali e di stagione. Questo produttore offre birre selezionate da Goûtez l'Ardèche. Visite su appuntamento."
    ],
    "fr": [
      "Bières élaborées à partir de céréales et de fruits locaux et de saison. Ce producteur, propose des bières sélectionnées par Goûtez l'Ardèche. Visite possible sur rendez-vous."
    ],
    "es": [
      "Cervezas elaboradas con cereales y frutas locales y de temporada. Este productor ofrece cervezas seleccionadas por Goûtez l'Ardèche. Visitas concertadas."
    ],
    "nl": [
      "Bieren gemaakt van lokale en seizoensgebonden granen en fruit. Deze producent biedt bieren geselecteerd door Goûtez l'Ardèche. Bezoek op afspraak."
    ]
  },
