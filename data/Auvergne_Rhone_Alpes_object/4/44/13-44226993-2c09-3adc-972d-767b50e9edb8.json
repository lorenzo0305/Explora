  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Château de la Cheyrelle, ein Herrenhaus aus dem 19. Jahrhundert, das zwischen 1903 und 1910 nach den Prinzipien des Lütticher Dekorateurs und Meisters des Jugendstils Gustave Serrurier-Bovy und seines Partners, des Architekten René Dulong, umgebaut und neu dekoriert wurde."
    ],
    "en": [
      "Visit Château de la Cheyrelle, a 19th-century mountain manor refurbished and redecorated between 1903 and 1910 according to the principles of Liège decorator and Art Nouveau master Gustave Serrurier-Bovy and his partner, architect René Dulong."
    ],
    "it": [
      "Visitate lo Château de la Cheyrelle, una casa padronale di montagna del XIX secolo, ristrutturata e ridecorata tra il 1903 e il 1910 secondo i principi del decoratore e maestro dell'Art Nouveau di Liegi, Gustave Serrurier-Bovy, e del suo socio, l'architetto René Dulong."
    ],
    "fr": [
      "Visitez le Château de la Cheyrelle, manoir de montagne du XIXè s,  réaménagé et redécoré entre 1903 et 1910 selon les principes du décorateur liégeois, maître de l'art nouveau, Gustave Serrurier-Bovy et de son associé, l'architecte René Dulong."
    ],
    "es": [
      "Visite el Château de la Cheyrelle, una casa solariega de montaña del siglo XIX, reformada y redecorada entre 1903 y 1910 según los principios del decorador y maestro del Art Nouveau de Lieja, Gustave Serrurier-Bovy, y su socio, el arquitecto René Dulong."
    ],
    "nl": [
      "Bezoek Château de la Cheyrelle, een 19e-eeuws landhuis in de bergen, gerenoveerd en opnieuw ingericht tussen 1903 en 1910 volgens de principes van de Luikse decorateur en meester van de Art Nouveau, Gustave Serrurier-Bovy, en zijn partner, de architect René Dulong."
    ]
  },
