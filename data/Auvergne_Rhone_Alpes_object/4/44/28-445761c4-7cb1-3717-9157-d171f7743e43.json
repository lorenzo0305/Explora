  "rdfs:comment": {
    "de": [
      "Restaurant in einem historischen Gebäude aus dem Jahr 1681. Genießen Sie die gedämpfte Atmosphäre eines Speisesaals mit alten Backsteinwänden und freiliegenden Holzbalken."
    ],
    "en": [
      "Restaurant located in a historic building dating from 1681. Enjoy the cosy ambience of a dining room with old brick walls and exposed beams."
    ],
    "it": [
      "Ristorante situato in un edificio storico risalente al 1681. Godetevi l'atmosfera accogliente di una sala da pranzo con vecchie pareti in mattoni e travi a vista."
    ],
    "fr": [
      "Restaurant situé dans un bâtiment historique datant de 1681. Vous pourrez apprécier l'ambiance feutrée d'une salle à manger aux murs de briques anciennes et de poutres apparentes."
    ],
    "es": [
      "Restaurante situado en un edificio histórico que data de 1681. Disfrute del acogedor ambiente de un comedor con antiguas paredes de ladrillo y vigas vistas."
    ],
    "nl": [
      "Restaurant gevestigd in een historisch gebouw uit 1681. Geniet van de gezellige sfeer van een eetzaal met oude bakstenen muren en balkenplafond."
    ]
  },
