  "rdfs:comment": {
    "de": [
      "Unser Restaurant bietet eine traditionelle Küche: Savoyer Spezialitäten, Fleisch/Fisch, Salate, Burger, Eis und hausgemachte Desserts.  Kindermenüs für die Kleinsten! Finden Sie unsere Pizzas vor Ort oder nur abends zum Mitnehmen."
    ],
    "en": [
      "Our restaurant offers traditional cuisine: Savoyard specialties, meat / fish, salads, burgers, ice cream and homemade desserts. Children's menus for the little ones! Find our pizzas on site or to take away only in the evening."
    ],
    "it": [
      "Il nostro ristorante offre una cucina tradizionale: specialità savoiarde, carne/pesce, insalate, hamburger, gelati e dolci fatti in casa.  Menu per bambini per i più piccoli! Potete trovare le nostre pizze sul posto o da asporto solo la sera."
    ],
    "fr": [
      "Notre restaurant propose une cuisine traditionnelle : spécialités savoyardes, viandes/poissons, salades, burgers, glaces et desserts maison.  Menus enfants pour les plus petits ! Retrouvez nos pizzas sur place ou à emporter uniquement le soir."
    ],
    "nl": [
      "Ons restaurant biedt traditionele gerechten: Savoyaardse specialiteiten, vlees/vis, salades, hamburgers, ijs en huisgemaakte desserts. Kindermenu's voor de kleintjes! Vind onze pizza's ter plaatse of om alleen 's avonds mee te nemen."
    ],
    "es": [
      "Nuestro restaurante ofrece cocina tradicional: especialidades de Saboya, carne/pescado, ensaladas, hamburguesas, helados y postres caseros.  Menús infantiles para los más pequeños Puede encontrar nuestras pizzas en el lugar o para llevar sólo por la noche."
    ]
  },
