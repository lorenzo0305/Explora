  "rdfs:comment": {
    "de": [
      "Zeitgenössische Ölbilder. Abstrakt (Glasur, Materialien, Grafiken, Schüttungen). Warme/ kalte Farben: Helligkeit, Transparenz, Flüssigkeit. Verschiedene Leinwandformate, Aufträge möglich. Aktuelle Arbeit: Farben. Einzel- und \r\nGruppenausstellungen auf Kunstmessen und in Galerien (Frankreich/Ausland)."
    ],
    "en": [
      "Oil paintings. Creations of contemporary works: Abstracts (oil glaze, texturing, graphic design, flow technique). Warm/cold colours: luminosity, transparency, fluidity. All formats. Current work on COLOUR. Personal/collective exhibitions in \r\ngalleries (France/abroad)."
    ],
    "it": [
      "Scoprite i dipinti contemporanei di Valérie Polizzano sul suo sito web.\r\nPresentazione press-book e opere."
    ],
    "fr": [
      "Découvrez les peintures contemporaines proposées par Valérie Polizzano sur son Site Internet.\r\nPrésentation press-book et œuvres."
    ],
    "nl": [
      "Olieverfschilderijen. Creatie van hedendaagse werken: Abstract (glazuren, materie, grafiek, afgietsels). Warme/koude kleuren: helderheid, transparantie, vloeibaarheid. Alle formaten. Actueel werk over KLEUR. Persoonlijke/\r\ncollectieve tentoonstellingen in kunstbeurzen, galerijen (Frankrijk/buitenland)."
    ],
    "es": [
      "Descubra la pintura contemporánea de Valérie Polizzano en su página web.\r\nPresentación press-book y obras."
    ]
  },
