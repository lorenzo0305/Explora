  "rdfs:comment": {
    "de": [
      "Ihr neuer Waschsalon in Valence, im Departement Drôme, bietet Ihnen in einem modernen und gemütlichen Ambiente einen optimalen Waschservice dank seiner Industriemaschinen der neuesten Generation."
    ],
    "en": [
      "Your new laundromat in Valence, in the Drôme region of France, offers you a modern, friendly setting and optimum washing service thanks to its latest-generation industrial machines."
    ],
    "it": [
      "La vostra nuova lavanderia a Valence, nella regione della Drôme, vi offre un ambiente moderno e accogliente e un servizio di lavaggio ottimale grazie alle sue macchine industriali di ultima generazione."
    ],
    "fr": [
      "Votre nouvelle laverie à Valence, dans la Drôme vous propose, dans un cadre moderne et chaleureux un service de lavage optimal grâce à ses machines industrielles de dernière génération."
    ],
    "es": [
      "Su nueva lavandería de Valence, en el departamento de Drôme, le ofrece un entorno moderno y acogedor y un servicio de lavado óptimo gracias a sus máquinas industriales de última generación."
    ],
    "nl": [
      "Je nieuwe wasserette in Valence, in het departement Drôme, biedt je een moderne, vriendelijke omgeving en een optimale wasservice dankzij de industriële machines van de laatste generatie."
    ]
  },
