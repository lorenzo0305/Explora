  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage der Kunsthandwerke öffnet Ihnen die Cité de la Chaussure die Türen des Made In Romans durch den Besuch von zwei Schuhproduktionsstätten."
    ],
    "en": [
      "As part of the Journées Européennes des Métiers d'Art, La Cité de la Chaussure opens the doors to Made In Romans with a visit to two shoe production workshops."
    ],
    "it": [
      "Nell'ambito delle Journées Européennes des Métiers d'Art, La Cité de la Chaussure apre le porte al Made In Romans con una visita a due laboratori di produzione di scarpe."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes des Métiers d'Art, La Cité de la Chaussure vous ouvre les portes du Made In Romans à travers la visite de deux ateliers de production de chaussures."
    ],
    "es": [
      "En el marco de las Journées Européennes des Métiers d'Art, La Cité de la Chaussure abre las puertas del Made In Romans con una visita a dos talleres de producción de calzado."
    ],
    "nl": [
      "Als onderdeel van de Journées Européennes des Métiers d'Art opent La Cité de la Chaussure de deuren van Made In Romans met een bezoek aan twee schoenmakerijen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de deux ateliers de la Cité de la Chaussure avec Cécile Rambaud et Lisa Corinini - Journées Européennes des Métiers d'Art"
    ]
  },
