  "rdfs:comment": {
    "de": [
      "Vom Rond-point aus können Sie den Sessellift Adret nehmen, um zu den Pisten zu gelangen, ohne erneut die Schneefront von Chaudanne passieren zu müssen."
    ],
    "en": [
      "From the Rond-Point, choose the Adret chairlift to access the slopes without going back to the snow front of Chaudanne."
    ],
    "it": [
      "Dal punto Rond, scegliete la seggiovia Adret per accedere alle piste senza dover tornare sul fronte della neve di Chaudanne."
    ],
    "fr": [
      "Depuis le Rond-point, optez pour le télésiège de l'Adret pour accéder aux pistes sans repasser par le front de neige de la Chaudanne."
    ],
    "nl": [
      "Vanaf het Rond-punt neemt u de Adret stoeltjeslift om op de pistes te komen zonder terug te moeten naar het sneeuwfront van Chaudanne."
    ],
    "es": [
      "Desde el punto Rond, opte por el telesilla Adret para acceder a las pistas sin tener que volver al frente de nieve de Chaudanne."
    ]
  },
  "rdfs:label": {
