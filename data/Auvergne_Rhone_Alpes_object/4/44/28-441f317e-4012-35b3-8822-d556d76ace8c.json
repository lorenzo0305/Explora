  "rdfs:comment": {
    "de": [
      "Wenn Sie auf dem Chemin des Dames zu Fuß, mit dem Fahrrad oder dem Motorrad unterwegs sind, wird Sie Le Poilu herzlich willkommen heißen!"
    ],
    "en": [
      "If you're visiting the Chemin des Dames on foot, by bike or motorcycle, Le Poilu will give you a warm welcome!"
    ],
    "it": [
      "Se passate dallo Chemin des Dames per una passeggiata a piedi, in bicicletta o in moto, Le Poilu vi darà un caloroso benvenuto!"
    ],
    "fr": [
      "Si vous êtes de passage sur le Chemin des Dames pour une balade à pied, à vélo ou en moto, Le Poilu vous accueillera chaleureusement !"
    ],
    "es": [
      "Si está de paso por el Chemin des Dames para pasear a pie, en bicicleta o en moto, Le Poilu le dará una calurosa bienvenida"
    ],
    "nl": [
      "Als je de Chemin des Dames passeert voor een wandeling, fietstocht of motortocht, heet Le Poilu je van harte welkom!"
    ]
  },
