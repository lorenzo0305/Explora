      "dc:description": {
        "de": [
          "Eine atypische Bar-Brasserie auf dem Kamm des Chemin des Dames. Auf der Speisekarte stehen Spezialitäten, die aus Kanada stammen, wie z. B. Poutines!"
        ],
        "en": [
          "An atypical bar-brewery located on the crest of Chemin des Dames, offering à la carte specialties from Canada, such as poutines for example!"
        ],
        "it": [
          "Un bar-birreria atipico, situato sulla cresta dello Chemin des Dames, che offre nel suo menu specialità canadesi come la poutine!"
        ],
        "fr": [
          "Un bar-brasserie atypique situé sur la crête du Chemin des Dames, et qui propose à la carte des spécialités originaires du Canada, comme des poutines par exemple !"
        ],
        "es": [
          "Un bar-cervecería atípico situado en la cresta del Chemin des Dames, que ofrece en su carta especialidades canadienses, como las poutines"
        ],
        "nl": [
          "Een atypische bar-brouwerij op de Chemin des Dames heuvelrug, die Canadese specialiteiten, zoals poutines, op de kaart heeft staan!"
        ]
      },
