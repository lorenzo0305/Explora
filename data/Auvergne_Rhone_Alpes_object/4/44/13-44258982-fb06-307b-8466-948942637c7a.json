  "rdfs:comment": {
    "de": [
      "Im Restaurant gibt es eine kurze Speisekarte, die je nach Anlieferung, Jahreszeit und aktueller Inspiration variiert. Genießen Sie frische, möglichst lokale und hausgemachte Produkte."
    ],
    "en": [
      "Regarding the restaurant, the short menu varies depending on the seasons and the chef's inspiration. Enjoy fresh products, mostly local and homemade cooked."
    ],
    "it": [
      "Nel ristorante, il menu breve varia a seconda della stagione e dell'ispirazione del momento. Gustate prodotti freschi, locali e fatti in casa."
    ],
    "fr": [
      "Côté restaurant, la carte courte varie au fil des arrivages, des saisons et de l’inspiration du moment. Profitez de produits frais, le plus locaux possibles et cuisinés maison."
    ],
    "nl": [
      "In het restaurant varieert het korte menu naargelang het seizoen en de inspiratie van het moment. Geniet van verse, lokale en huisgemaakte producten."
    ],
    "es": [
      "En el restaurante, el menú corto varía según la temporada y la inspiración del momento. Disfrute de productos frescos, locales y caseros."
    ]
  },
