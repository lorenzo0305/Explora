  "rdfs:comment": {
    "de": [
      "Das Reitzentrum in Braille, das jetzt von Michael Duc geleitet wird, heißt Sie das ganze Jahr über willkommen, sei es für Kurse, Praktika, Ponyausritte oder Reittouren."
    ],
    "en": [
      "The Braille equestrian center, now run by Michael Duc, welcomes you all year round, whether for lessons, courses, pony rides or horseback excursions."
    ],
    "it": [
      "Il centro di equitazione di Braille, ora gestito da Michael Duc, vi accoglie tutto l'anno per lezioni, corsi, passeggiate con i pony e cavalcate."
    ],
    "fr": [
      "Le centre équestre de Braille, maintenant dirigé par Michael Duc, vous accueille toute l'année, que ce soit pour des cours, des stages, des balades en poney ou randonnées à cheval."
    ],
    "nl": [
      "In de manege Braille, die nu wordt gerund door Michael Duc, kun je het hele jaar door terecht voor lessen, cursussen, ponyritten en paardrijtochten."
    ],
    "es": [
      "El centro ecuestre Braille, ahora dirigido por Michael Duc, le da la bienvenida todo el año para clases, cursos, paseos en poni y a caballo."
    ]
