  "rdfs:comment": {
    "de": [
      "Val Thorens hat einen Mythos. Der eines der allerersten Hotels des Ortes in den 1970er Jahren. Ein epischer Ort mit einer blubbernden XXL-Terrasse und einem atemberaubenden Blick auf die Pisten."
    ],
    "en": [
      "Le Val Thorens is the story of a legend reborn. Built in the 1970s and one of the resort’s first hotels, this epic building has been completely renovated in contemporary retro style."
    ],
    "it": [
      "A Val Thorens esiste un mito. Quello di uno dei primissimi hotel della località, negli anni Settanta. Epico, con la sua terrazza XXL e una vista mozzafiato sulle piste."
    ],
    "fr": [
      "Le Val Thorens nourrit le mythe. Celui d’un des tout premiers hôtels de la station, époque 1970. Épique, entre terrasse XXL bouillonnante et vue à couper le souffle sur les pistes."
    ],
    "nl": [
      "Val Thorens koestert een mythe. Die van een van de allereerste hotels in het resort, in de jaren 1970. Epic, met een bubbelend XXL-terras en een adembenemend uitzicht op de pistes."
    ],
    "es": [
      "Val Thorens alimenta un mito. El de uno de los primeros hoteles de la estación, en los años setenta. Épico, con su burbujeante terraza XXL y sus impresionantes vistas a las pistas."
    ]
  },
