  "rdfs:comment": {
    "de": [
      "Lust auf eine süße oder herzhafte Pause? Verwöhnen Sie sich mit unseren Churros, Crêpes, Waffeln, Eiscreme, Softeis und verschiedenen Getränken. \r\nPaninis, Galettes und herzhafte Crêpes bieten wir Ihnen zu jeder Tageszeit an."
    ],
    "en": [
      "For a sweet or savoury break, come and treat yourself to our churros, crêpes, waffles, ice creams, Italian-style ice creams and a variety of drinks. \r\nWe also offer paninis, galettes and savoury crêpes at all hours."
    ],
    "it": [
      "Per una pausa dolce o salata, venite a gustare i nostri churros, crêpes, waffles, gelati, gelati all'italiana e una varietà di bevande.\r\nOffriamo anche panini, galette e crêpes salate a tutte le ore."
    ],
    "fr": [
      "Envie d'une pause sucrée ou salée, venez vous régaler avec nos churros, crêpes, gaufres, glaces, glaces à l'italienne et boissons diverses. \r\nNous vous proposons des paninis, galettes et crêpes salées à toute heure."
    ],
    "es": [
      "Para una pausa dulce o salada, venga a deleitarse con nuestros churros, crêpes, gofres, helados, helados a la italiana y bebidas variadas.\r\nTambién ofrecemos paninis, galettes y crêpes salados a todas horas."
    ],
    "nl": [
      "Kom voor een zoete of hartige pauze en verwen jezelf met onze churros, crêpes, wafels, ijsjes, ijs in Italiaanse stijl en diverse drankjes.\r\nWe bieden ook panini's, galettes en hartige crêpes op alle uren."
    ]
  },
  "rdfs:label": {
