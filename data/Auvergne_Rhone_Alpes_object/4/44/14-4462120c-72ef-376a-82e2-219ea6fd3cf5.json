  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/94f17f90-642c-3a5e-a65a-888147f931a6",
      "dc:description": {
        "de": [
          "Boutique mit mehreren liebevoll ausgewählten Prêt-à-porter-Marken und Accessoires. Hartford, Bellerose, Izipizi, Aigle, Sessùn, Moismont, Bensimon...\n\nTäglich außer Montag und Dienstag (außer in den Schulferien) von 10 bis 13 Uhr und von 15 bis 19 Uhr im Sommer / von 10.30 bis 13 Uhr und von 15 bis 18.30 Uhr im Winter geöffnet."
        ],
        "en": [
          "Multi-brand ready-to-wear & accessories boutique selected with love. Hartford, Bellerose, Izipizi, Aigle, Sessùn, Moismont, Bensimon...\n\nOpen every day except Monday and Tuesday (except school vacations) from 10am to 1pm and 3pm to 7pm in summer / from 10:30am to 1pm and 3pm to 6:30pm in winter."
        ],
        "it": [
          "Una boutique di prêt-à-porter e accessori multimarca selezionati con amore. Hartford, Bellerose, Izipizi, Aigle, Sessùn, Moismont, Bensimon...\n\nAperto tutti i giorni tranne il lunedì e il martedì (tranne durante le vacanze scolastiche) dalle 10.00 alle 13.00 e dalle 15.00 alle 19.00 in estate / dalle 10.30 alle 13.00 e dalle 15.00 alle 18.30 in inverno."
        ],
        "fr": [
          "Boutique multi-marques prêt-à-porter & accessoires sélectionnées avec amour. Hartford, Bellerose, Izipizi, Aigle, Sessùn, Moismont, Bensimon... \n\nOuvert tous les jours sauf lundi et mardi (hors vacances scolaires) de 10h à 13h et de 15h à 19h l’été / de 10h30 à 13h et de 15h à 18h30 l’hiver."
        ],
        "es": [
          "Una boutique multimarca de prêt-à-porter y accesorios seleccionados con amor. Hartford, Bellerose, Izipizi, Aigle, Sessùn, Moismont, Bensimon...\n\nAbierto todos los días excepto lunes y martes (salvo durante las vacaciones escolares) de 10:00 a 13:00 y de 15:00 a 19:00 en verano / de 10:30 a 13:00 y de 15:00 a 18:30 en invierno."
        ],
        "nl": [
          "Een met liefde geselecteerde boetiek met kant-en-klare kleding en accessoires van verschillende merken. Hartford, Bellerose, Izipizi, Aigle, Sessùn, Moismont, Bensimon...\n\nElke dag geopend behalve maandag en dinsdag (behalve tijdens schoolvakanties) van 10.00 tot 13.00 en van 15.00 tot 19.00 in de zomer / van 10.30 tot 13.00 en van 15.00 tot 18.30 in de winter."
        ]
      },
