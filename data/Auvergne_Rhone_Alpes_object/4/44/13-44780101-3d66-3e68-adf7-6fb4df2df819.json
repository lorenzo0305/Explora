  "rdfs:comment": {
    "de": [
      "Finden Sie erneuertes Kunsthandwerk und eine Auswahl an Delikatessen: Mohairknäuel und -kreationen, Wollaccessoires, Papierwaren, Postkarten, Seifen, Honig, Oliven, Einkorn und Clairette de Die..."
    ],
    "en": [
      "Find a renewed craftsmanship as well as a selection of delicatessen: mohair balls and creations, jewelry and accessories, leather bags, floral stationery, soaps, balms and lotions, lavender honey, spelt and Clairette de Die..."
    ],
    "it": [
      "Nuovi prodotti artigianali e una selezione di articoli di gastronomia: gomitoli e creazioni in mohair, accessori in lana, cartoleria, cianotipi, cartoline, gemmoterapia, ceramica, tisane, saponi, miele, petit épeautre e clairette de Die..."
    ],
    "fr": [
      "Un artisanat renouvelé et une sélection d'épicerie fine : pelotes et créations en mohair, accessoires en laine, papeterie, cyanotypes, cartes postales, gemmothérapie, céramique, tisanes, savons, miel, petit épeautre et clairette de Die..."
    ],
    "nl": [
      "U vindt er een vernieuwde ambachtelijke artikelen en ook een selectie van fijne kruidenierswaren: mohairballen en creaties, juwelen en accessoires, lederen tassen, bloemrijke schrijfwaren, zepen, balsems en lotions, lavendelhoning, petit épeautre en clairette de Die..."
    ],
    "es": [
      "Novedades artesanales y una selección de artículos delicatessen: ovillos y creaciones de mohair, accesorios de lana, papelería, cianotipos, postales, gemoterapia, cerámica, tisanas, jabones, miel, petit épeautre y clairette de Die..."
    ]
  },
  "rdfs:label": {
