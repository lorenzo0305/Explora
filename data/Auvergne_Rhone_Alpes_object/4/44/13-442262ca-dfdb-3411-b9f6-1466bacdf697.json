  "rdfs:comment": {
    "de": [
      "In einem gepflegten Rahmen mit einem dynamischen Team entdecken Sie die Küche des Küchenchefs, gefolgt von einem Dessertbuffet - so viel Sie wollen!"
    ],
    "en": [
      "In a neat setting, with a dynamic team, you will discover the chef's cuisine followed by the all-you-can-eat dessert buffet!"
    ],
    "it": [
      "In un ambiente curato, con un team dinamico, scoprirete la cucina dello chef seguita da un buffet di dolci, a volontà!"
    ],
    "fr": [
      "Dans un cadre soigné, avec une équipe dynamique, vous découvrirez la cuisine du chef suivie du buffet de desserts, à volonté !"
    ],
    "nl": [
      "In een verzorgd kader, met een dynamisch team, ontdekt u de keuken van de chef, gevolgd door een dessertbuffet, zoveel u wilt!"
    ],
    "es": [
      "En un entorno cuidado, con un equipo dinámico, descubrirá la cocina del chef seguida de un buffet de postres, ¡todo lo que quiera!"
    ]
