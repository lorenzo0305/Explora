  "rdfs:comment": {
    "de": [
      "Die Jäger von Tence laden Sie zu ihrem Boule-Wettbewerb ein. Verlosung der Tombola, gefolgt von einer Kohlsuppe am Abend."
    ],
    "en": [
      "The Tence hunters invite you to their petanque competition. Tombola draw followed by cabbage soup in the evening."
    ],
    "it": [
      "I cacciatori di Tence vi invitano alla loro gara di petanque. Estrazione di una tombola seguita da una zuppa di cavoli la sera."
    ],
    "fr": [
      "Les chasseurs de Tence vous invite à leur concours de pétanque. Tirage au sort de la tombola suivi de la soupe aux choux en soirée."
    ],
    "es": [
      "Los cazadores de Tence te invitan a su competición de petanca. Sorteo de tómbola seguido de sopa de col por la noche."
    ],
