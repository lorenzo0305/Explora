  "rdfs:comment": {
    "de": [
      "Hochseilgarten auf der Freizeitanlage von Sougey mit einem atemberaubenden Blick auf den See von Aiguebelette. Auf einer Länge von über 1,6 km können Sie beim Sprung ins Leere, an der Kletterwand oder auf einer der 17 Seilrutschen Adrenalin tanken!"
    ],
    "en": [
      "High ropes course, located on the Sougey leisure base, with a stunning view on Lake Aiguebelette."
    ],
    "it": [
      "Un percorso a corde alte nel centro ricreativo di Sougey, con una vista mozzafiato sul lago di Aiguebelette. Su un percorso di oltre 1,6 km, fate il pieno di adrenalina con un paracadute, una parete di arrampicata o una delle 17 teleferiche!"
    ],
    "fr": [
      "Parcours acrobatique en hauteur, situé sur la base de loisirs du Sougey avec une vue imprenable sur le lac d’Aiguebelette. Sur plus d'1,6 km, faites le plein d'adrénaline avec le saut dans le vide, le mur d’escalade ou l'une des 17 tyroliennes !"
    ],
    "es": [
      "Un circuito de cuerdas altas en el centro de ocio Sougey, con una vista impresionante del lago Aiguebelette. A lo largo de más de 1,6 km, descarga adrenalina con un salto en paracaídas, un rocódromo o una de las 17 tirolinas"
    ],
    "nl": [
      "Een hoog touwenparcours in het recreatiecentrum van Sougey, met een adembenemend uitzicht over het meer van Aiguebelette. Laat je adrenaline stromen over meer dan 1,6 km met een parachutesprong, een klimmuur of een van de 17 tokkelbanen!"
    ]
  },
