  "rdfs:comment": {
    "de": [
      "Zwischen Lens und Arras konzentriert das Reiseziel Collines et Plaines d'Artois eine beeindruckende Anzahl an Gedenkstätten, die jedes Jahr ein Publikum aus der ganzen Welt anziehen, um sich zu erinnern."
    ],
    "en": [
      "Between Lens and Arras, the Collines et Plaines d?Artois region boasts an impressive number of remembrance sites, attracting visitors from all over the world every year."
    ],
    "it": [
      "Tra Lens e Arras, la regione di Collines et Plaines d'Artois vanta un numero impressionante di siti commemorativi, che attirano ogni anno visitatori da tutto il mondo."
    ],
    "fr": [
      "Entre Lens et Arras, la destination Collines et Plaines d’Artois concentre un nombre impressionnant de sites de mémoire, qui attirent chaque année un public venu du monde entier pour se souvenir."
    ],
    "nl": [
      "Tussen Lens en Arras heeft de regio Collines et Plaines d'Artois een indrukwekkend aantal herdenkingsplaatsen die elk jaar bezoekers van over de hele wereld aantrekken."
    ],
    "es": [
      "Entre Lens y Arras, la región de Collines et Plaines d'Artois cuenta con un impresionante número de lugares conmemorativos que atraen cada año a visitantes de todo el mundo."
    ]
