  "rdfs:comment": {
    "de": [
      "Emeline begleitet Sie in der freien Natur auf dem Weg des Wohlbefindens nur für Sie oder zum Teilen mit der Familie, unter Freunden... Spaziergänge, Meditation, bewusstes Gehen, Entdeckung essbarer Pflanzen, Workshops und spielerische und kreative Animationen."
    ],
    "en": [
      "Emeline accompanies you in the heart of nature on the path to well-being, just for you or to share with family and friends... Walks, meditation, mindfulness walking, discovery of edible plants, fun and creative workshops and activities."
    ],
    "it": [
      "Emeline vi accompagnerà in un viaggio di benessere nel cuore della natura, solo per voi o da condividere con la famiglia e gli amici... Passeggiate, meditazione, mindful walking, scoperta di piante commestibili, laboratori ed eventi divertenti e creativi."
    ],
    "fr": [
      "Emeline vous accompagne en pleine nature sur le chemin du bien-être rien que pour vous ou à partager en famille, entre amis...Balades, méditation, marche en conscience, découverte des plantes comestibles, ateliers et animations ludiques et créatives."
    ],
    "nl": [
      "Emeline neemt je mee op een reis van welzijn in het hart van de natuur, alleen voor jou of om te delen met familie en vrienden... Wandelingen, meditatie, mindfulness wandelen, ontdekking van eetbare planten, leuke en creatieve workshops en evenementen."
    ],
    "es": [
      "Emeline le llevará a un viaje de bienestar en plena naturaleza, sólo para usted o para compartir con familiares y amigos... Paseos, meditación, mindful walking, descubrimiento de plantas comestibles, talleres y eventos divertidos y creativos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Samadhi Travel - EFT Pleine Nature"
    ]
  },
