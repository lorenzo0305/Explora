  "rdfs:comment": {
    "de": [
      "Ich schlage Ihnen einige Ideen für Ausflüge in Savoyen und Hochsavoyen vor, um sanft zu wandern und unsere Berge zu entdecken - zur Freude von Groß und Klein!"
    ],
    "en": [
      "Here are a few ideas for outings in Savoie and Haute-Savoie to discover our mountains, for the pleasure of young and old alike!"
    ],
    "it": [
      "Propongo gite nella Savoia e nell'Alta Savoia, per farvi scoprire le nostre montagne con una dolce escursione, per la gioia di grandi e piccini!"
    ],
    "fr": [
      "Je vous propose des sorties en Savoie et Haute-Savoie pour randonner en douceur et découvrir nos montagnes, pour le plaisir des petits et des grands !"
    ],
    "es": [
      "Propongo salidas en las regiones de Saboya y Alta Saboya, para disfrutar de una excursión suave y descubrir nuestras montañas, ¡para deleite de grandes y pequeños!"
    ],
    "nl": [
      "Ik bied uitstapjes aan in de Savoie en Haute-Savoie, zodat je kunt genieten van een rustige wandeling en onze bergen kunt ontdekken, tot groot genoegen van jong en oud!"
    ]
  },
