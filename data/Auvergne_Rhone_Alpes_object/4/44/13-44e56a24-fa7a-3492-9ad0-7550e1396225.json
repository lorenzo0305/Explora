  "rdfs:comment": {
    "de": [
      "Paragliding Addict bietet Ihnen ein einzigartiges Erlebnis in Peisey-Vallandry! \r\nTandemflüge auf Skiern oder Snowboard, 10 bis 40 Minuten, unter der Aufsicht zertifizierter Fluglehrer. \r\nErinnerungsvideo und Adrenalin pur für alle Abenteuerlustigen!"
    ],
    "en": [
      "Paragliding Addict offers you a unique experience in Peisey-Vallandry!\r\nTandem flights on skis or a snowboard, from 10 to 40 minutes, supervised by certified instructors. \r\nSouvenir video and adrenaline-pumping option for thrill-seekers!"
    ],
    "it": [
      "Parapente Addict vi offre un'esperienza unica a Peisey-Vallandry!\r\nVoli in tandem su sci o snowboard, da 10 a 40 minuti, sotto la supervisione di istruttori qualificati.\r\nUn video ricordo e un'opzione adrenalinica per gli amanti del brivido!"
    ],
    "fr": [
      "Parapente Addict vous fait vivre un moment unique à Peisey-Vallandry ! \r\nVols biplaces à ski ou snowboard, de 10 à 40 minutes, encadrés par des moniteurs diplômés. \r\nVidéo souvenir et option adrénaline pour les amateurs de sensations fortes !"
    ],
    "es": [
      "¡Parapente Addict le ofrece una experiencia única en Peisey-Vallandry!\r\nVuelos en tándem sobre esquís o snowboard, de 10 a 40 minutos, supervisados por instructores cualificados.\r\nVídeo de recuerdo y opción de adrenalina para los amantes de las emociones fuertes"
    ],
    "nl": [
      "Parapente Addict biedt je een unieke ervaring in Peisey-Vallandry!\r\nTandemvluchten op ski's of snowboard, van 10 tot 40 minuten, begeleid door gekwalificeerde instructeurs.\r\nVideo-souvenir en adrenaline-optie voor sensatiezoekers!"
    ]
  },
