  "rdfs:comment": {
    "de": [
      "Sylvie Giron, eine Choreografin mit zahlreichen Erfahrungen, stellt Ihnen im Rahmen eines Vortrags mit dem Titel \"Ein Blick auf den zeitgenössischen Tanz von den 80er Jahren bis heute\" ihre Sicht auf die Entwicklung des zeitgenössischen Tanzes seit den 80er Jahren vor."
    ],
    "en": [
      "Sylvie Giron, a choreographer with a wealth of experience, offers her insight into the development of contemporary dance since the 80s, in a talk entitled \"A look at contemporary dance from the 80s to the present day\"."
    ],
    "it": [
      "Sylvie Giron, coreografa di grande esperienza, condividerà il suo punto di vista sullo sviluppo della danza contemporanea a partire dagli anni '80, in un intervento intitolato \"Uno sguardo sulla danza contemporanea dagli anni '80 a oggi\"."
    ],
    "fr": [
      "Sylvie Giron, chorégraphe aux nombreuses expériences, vous propose son regard sur le développement de la danse contemporaine depuis les années 80, à l'occasion d'une conférence intitulée \"Un regard sur la danse contemporaine des années 80 à nos jours\"."
    ],
    "es": [
      "Sylvie Giron, coreógrafa con una dilatada experiencia, compartirá su punto de vista sobre la evolución de la danza contemporánea desde los años 80, en una conferencia titulada \"Una mirada a la danza contemporánea desde los años 80 hasta nuestros días\"."
    ],
    "nl": [
      "Sylvie Giron, choreografe met een schat aan ervaring, geeft haar visie op de ontwikkeling van de hedendaagse dans sinds de jaren 1980 in een lezing getiteld \"Een blik op de hedendaagse dans van de jaren 1980 tot nu\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Un regard sur la danse contemporaine des années 80 à nos jours"
    ]
  },
