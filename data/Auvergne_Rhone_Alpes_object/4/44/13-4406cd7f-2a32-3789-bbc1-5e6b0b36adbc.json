  "rdfs:comment": {
    "de": [
      "Zwischen Bergen und Natur bietet Ihnen SOHALIA ayurvedische Massagen, Reflexologie, TNC und Yoga. Mini-Kuren und Retreats, um den Körper zu beruhigen, den Geist zu wecken und einen echten Moment des Wohlbefindens zu erleben."
    ],
    "en": [
      "Between mountains and nature, SOHALIA offers ayurvedic massage, reflexology, TNC and yoga. Mini cures and retreats to soothe the body, awaken the spirit and experience a true moment of well-being."
    ],
    "it": [
      "Circondato da montagne e natura, SOHALIA offre massaggi ayurvedici, riflessologia, TNC e yoga. Mini cure e ritiri per lenire il corpo, risvegliare la mente e vivere un vero momento di benessere."
    ],
    "fr": [
      "Entre montagne et nature, SOHALIA vous offre massages ayurvédiques, réflexologie, TNC et yoga. Mini cures et retraites pour apaiser le corps, éveiller l'esprit et vivre un vrai moment de bien-être."
    ],
    "es": [
      "Rodeado de montañas y naturaleza, SOHALIA ofrece masajes ayurvédicos, reflexología, TNC y yoga. Mini curas y retiros para calmar el cuerpo, despertar la mente y vivir un verdadero momento de bienestar."
    ],
    "nl": [
      "Omgeven door bergen en natuur biedt SOHALIA Ayurvedische massage, reflexologie, TNC en yoga. Minikuren en retraites om het lichaam te kalmeren, de geest wakker te schudden en een waar moment van welzijn te ervaren."
    ]
  },
