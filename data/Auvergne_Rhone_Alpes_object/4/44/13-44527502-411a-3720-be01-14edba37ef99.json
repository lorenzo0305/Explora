  "rdfs:comment": {
    "de": [
      "Ein Lauf, um Menschen zusammenzubringen, zu vereinen, Spaß zu haben und mehr über die Verwaltung und Aufwertung des Wassers in der Viehzucht im Departement Haute-Loire zu erfahren - das ist das Ziel des H2O Trail des JA!"
    ],
    "en": [
      "The aim of the H2O Trail des JA is to bring people together to have fun and learn more about water management and development in livestock farming in the Haute-Loire region"
    ],
    "it": [
      "L'obiettivo del Sentiero H2O des JA è quello di riunire le persone, unirle, divertirsi e scoprire di più sulla gestione e l'utilizzo dell'acqua negli allevamenti della Haute-Loire!"
    ],
    "fr": [
      "Une course pour rassembler, fédérer, s'amuser et en savoir plus sur la gestion et la valorisation de l'eau en élevage dans la Haute-Loire, tel est l'objectif de l'H2O Trail des JA !"
    ],
    "nl": [
      "Het doel van het H2O Trail des JA is om mensen samen te brengen, te verenigen, plezier te maken en meer te weten te komen over het beheer en gebruik van water in de veehouderij in de Haute-Loire!"
    ],
    "es": [
      "El objetivo del H2O Trail des JA es reunir a la gente, unirla, divertirse y conocer mejor la gestión y el uso del agua en la ganadería del Alto Loira"
    ]
  },
  "rdfs:label": {
    "fr": [
      "H2O Trail - De ville en fermes"
    ]
  },
