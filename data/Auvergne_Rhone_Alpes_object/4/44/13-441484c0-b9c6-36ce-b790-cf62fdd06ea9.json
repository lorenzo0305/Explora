  "rdfs:comment": {
    "de": [
      "La Rotonde, seit 1933 eine Institution in Aix, empfängt Sie im Herzen des Parc de Verdure in einem einzigartigen Art-déco-Rahmen. Genießen Sie einen hellen Saal, einen gemütlichen Loungebereich und eine schattige Terrasse, um Cocktails, Tapas und Feinschmeckergerichte zu genießen!"
    ],
    "en": [
      "La Rotonde, a local institution since 1933, welcomes you to the heart of the Parc de Verdure in a unique Art Deco setting. Enjoy a bright room, a cosy lounge area and a shady terrace for cocktails, tapas and gourmet dishes!"
    ],
    "it": [
      "La Rotonde, un'istituzione di Aix dal 1933, vi accoglie nel cuore del Parc de Verdure in un ambiente Art Déco unico. Godetevi una sala luminosa, un'accogliente area lounge e una terrazza ombreggiata per cocktail, tapas e piatti gourmet!"
    ],
    "fr": [
      "La Rotonde, institution aixoise depuis 1933, vous accueille au cœur du Parc de Verdure dans un cadre Art déco unique. Profitez d’une salle lumineuse, d’un espace lounge cosy et d’une terrasse ombragée pour savourer cocktails, tapas et plats gourmands !"
    ],
    "es": [
      "La Rotonde, una institución de Aix desde 1933, le da la bienvenida en el corazón del Parc de Verdure en un marco Art Déco único. Disfrute de una luminosa sala, un acogedor salón y una terraza a la sombra para degustar cócteles, tapas y platos gastronómicos"
    ],
    "nl": [
      "La Rotonde, een instituut in Aix sinds 1933, verwelkomt u in het hart van het Parc de Verdure in een uniek art-decokader. Geniet van een lichte kamer, een gezellige zithoek en een schaduwrijk terras voor cocktails, tapas en gastronomische gerechten!"
    ]
  },
