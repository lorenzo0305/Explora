          "additionalInformation": {
            "de": [
              "Von Freitag bis Sonntag mittags auf Margériaz (Aillons-Margériaz 1400) und abends auf Bestellung in der Correrie -Val d'Aillon (Aillons-Margériaz 1000) geöffnet."
            ],
            "en": [
              "Friday to Sunday, open for lunch at Margériaz (Aillons-Margériaz 1400) and evenings to order at Correrie -Val d'Aillon (Aillons-Margériaz 1000)."
            ],
            "it": [
              "Da venerdì a domenica, aperto a pranzo a Margériaz (Aillons-Margériaz 1400) e la sera su ordinazione a La Correrie -Val d'Aillon (Aillons-Margériaz 1000)."
            ],
            "fr": [
              "Du vendredi au dimanche, ouvert le midi sur Margériaz (Aillons-Margériaz 1400) et le soir sur commande à la Correrie -Val d'Aillon (Aillons-Margériaz 1000)."
            ],
            "nl": [
              "Van vrijdag tot zondag geopend voor de lunch bij Margériaz (Aillons-Margériaz 1400) en 's avonds te bestellen bij La Correrie -Val d'Aillon (Aillons-Margériaz 1000)."
            ],
            "es": [
              "De viernes a domingo, abierto para comer en Margériaz (Aillons-Margériaz 1400) y por la noche por encargo en La Correrie -Val d'Aillon (Aillons-Margériaz 1000)."
            ]
