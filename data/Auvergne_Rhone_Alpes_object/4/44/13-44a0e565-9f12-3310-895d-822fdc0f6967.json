  "rdfs:comment": {
    "de": [
      "Chez Chri-Chri Food truck bietet Ihnen eine einfache, aber verbesserte Verpflegung mit regionalen, frischen und vor allem mit viel Liebe selbstgemachten Produkten."
    ],
    "en": [
      "Chez Chri-Chri Food truck offers a simple but improved catering service using fresh local produce, and above all homemade with a lot of love."
    ],
    "it": [
      "Il Food truck Chez Chri-Chri vi offre pasti semplici ma ottimizzati, realizzati con prodotti freschi locali e, soprattutto, fatti in casa con tanto amore."
    ],
    "fr": [
      "Chez Chri-Chri Food truck vous propose une restauration simple mais améliorée avec des produits du terroir, frais et surtout fait maison avec beaucoup d'amour."
    ],
    "es": [
      "Chez Chri-Chri Food truck le ofrece platos sencillos pero perfeccionados, elaborados con productos locales frescos y, sobre todo, hechos en casa con mucho amor."
    ],
    "nl": [
      "Chez Chri-Chri Food truck biedt je eenvoudige maar verbeterde maaltijden gemaakt met verse lokale producten en vooral zelfgemaakt met veel liefde."
    ]
  },
