  "rdfs:comment": {
    "de": [
      "Das Restaurant Villa Garden bietet Ihnen von Dienstag bis Freitag ein Tagesmenü, das nur mittags erhältlich ist, und von Donnerstag bis Samstag abends eine Speisekarte.  Hausgemachte Tapas, Salate, warme Gerichte, Woks und Burger. Details und Reservierungen unter 06 46 12 02 34."
    ],
    "en": [
      "The Villa Garden restaurant offers a daily menu from Tuesday to Friday, available only at lunchtime, and an à la carte menu in the evenings from Thursday to Saturday.  Homemade tapas, salads, hot dishes, woks, burgers... Details and reservations on 06 46 12 02 34."
    ],
    "it": [
      "Il ristorante Villa Garden offre un menu giornaliero dal martedì al venerdì, disponibile solo a pranzo, e un menu à la carte la sera dal giovedì al sabato.  Tapas fatte in casa, insalate, piatti caldi, wok, hamburger... Dettagli e prenotazioni al numero 06 46 12 02 34."
    ],
    "fr": [
      "Le restaurant Villa Garden vous propose un menu du jour du mardi au vendredi disponible uniquement le midi et une carte les soirs du jeudi au samedi.  Tapas maison, salades, plats chauds, woks, burgers.. Détails et réservations au 06 46 12 02 34."
    ],
    "nl": [
      "Het Villa Garden restaurant biedt een dagmenu van dinsdag tot vrijdag, alleen beschikbaar tijdens lunchtijd, en een à la carte menu 's avonds van donderdag tot zaterdag.  Huisgemaakte tapas, salades, warme gerechten, wokken, hamburgers... Details en reserveringen op 06 46 12 02 34."
    ],
    "es": [
      "El restaurante Villa Garden ofrece un menú diario de martes a viernes, disponible sólo al mediodía, y un menú a la carta por las noches de jueves a sábado.  Tapas caseras, ensaladas, platos calientes, woks, hamburguesas... Detalles y reservas en el 06 46 12 02 34."
    ]
  },
