  "rdfs:comment": {
    "de": [
      "Gute Adresse, an der frische Produkte je nach Jahreszeit treffend zubereitet werden. Denken Sie daran, zu reservieren, da die Adresse bekannt ist!"
    ],
    "en": [
      "Very nice adress where we cook fresh products to vary seasonally with finess. Think to make a reservation because the address is known."
    ],
    "it": [
      "Un buon indirizzo dove i prodotti freschi sono cucinati con precisione secondo le stagioni. Non dimenticate di prenotare perché l'indirizzo è molto conosciuto!"
    ],
    "fr": [
      "Bonne adresse où l'on cuisine des produits frais au gré des saisons avec justesse. Pensez à réserver car l'adresse est connue !"
    ],
    "es": [
      "Una buena dirección donde se cocinan con precisión productos frescos según las estaciones. No te olvides de reservar porque la dirección es muy conocida"
    ],
    "nl": [
