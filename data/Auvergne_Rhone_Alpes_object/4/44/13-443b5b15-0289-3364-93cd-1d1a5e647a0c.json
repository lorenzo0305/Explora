  "rdfs:comment": {
    "de": [
      "Ingrid & Luc freuen sich, Sie im Rieutord begrüßen zu dürfen: leckere hausgemachte Gerichte, lokale Produkte, Top-Atmosphäre! Tagsüber Animationen (Lotto, Belote...) und festliche Abende (Konzerte, Karaoke...) für alle."
    ],
    "en": [
      "Ingrid & Luc are delighted to welcome you to Le Rieutord: delicious homemade dishes, local produce, and a great atmosphere! Daytime entertainment (lotto, belote, etc.) and festive evenings (concerts, karaoke, etc.) are available for everyone."
    ],
    "it": [
      "Ingrid & Luc sono lieti di darvi il benvenuto a Le Rieutord: pasti gustosi cucinati in casa, prodotti locali e una grande atmosfera! Animazione durante il giorno (bingo, belote...) e serate di festa (concerti, karaoke...) per tutti."
    ],
    "fr": [
      "Ingrid & Luc sont heureux de vous accueillir au Rieutord : plats maison savoureux, produits locaux, ambiance au top ! Animations en journée (loto, belote...) et soirées festives (concerts, karaokés...) pour tous."
    ],
    "es": [
      "Ingrid y Luc están encantados de darle la bienvenida a Le Rieutord: sabrosa comida casera, productos locales y un gran ambiente Entretenimiento durante el día (bingo, belote...) y noches festivas (conciertos, karaoke...) para todos."
    ],
    "nl": [
      "Ingrid & Luc heten je van harte welkom in Le Rieutord: lekkere huisgemaakte maaltijden, lokale producten en een geweldige sfeer! Overdag animatie (bingo, belote...) en feestavonden (concerten, karaoke...) voor iedereen."
    ]
  },
