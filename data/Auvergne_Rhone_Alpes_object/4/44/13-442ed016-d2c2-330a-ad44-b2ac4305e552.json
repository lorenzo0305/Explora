  "rdfs:comment": {
    "de": [
      "Ein idealer Ort zum Entspannen und Schlemmen!\r\nOriginelle und hausgemachte \"Gourmet\"-Tapas, Brettchen, Meeresfrüchte ...\r\nCocktailbar\r\nDurchgehender Service\r\nGesellige und festliche Atmosphäre."
    ],
    "en": [
      "The ideal place to relax and enjoy yourself!\r\nOriginal, homemade gourmet tapas, platters, seafood ...\r\ncocktail bar\r\nContinuous service\r\nFriendly, festive atmosphere."
    ],
    "it": [
      "Ottimo posto per rilassarsi e divertirsi!\r\nTapas \"gourmet\" originali e fatte in casa, vassoi, frutti di mare...\r\ncocktail bar\r\nServizio continuo\r\nAtmosfera amichevole e festosa."
    ],
    "fr": [
      "Endroit idéal pour se détendre et se régaler !\r\nTapas \"gourmet\" originaux et faits maison, planches, fruits de mer ...\r\nbar-cocktails \r\nService en continu\r\nAmbiance conviviale et festive."
    ],
    "nl": [
      "Geweldige plek om te ontspannen en te genieten!\r\nOriginele en zelfgemaakte \"gastronomische\" tapas, schotels, zeevruchten...\r\nCocktailbar\r\nContinue service\r\nVriendelijke en feestelijke sfeer."
    ],
    "es": [
      "El lugar perfecto para relajarse y disfrutar\r\nTapas gourmet originales y caseras, bandejas, marisco ...\r\nbar de cócteles\r\nServicio continuo\r\nAmbiente acogedor y festivo."
    ]
  },
