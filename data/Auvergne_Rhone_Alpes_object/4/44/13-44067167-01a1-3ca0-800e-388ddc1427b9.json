  "rdfs:comment": {
    "de": [
      "Ein heiterer und zugleich spielerischer Rahmen, ideal für den Empfang Ihrer beruflichen oder privaten Veranstaltungen...(Seminare, Teambuilding, Schulungen, Hochzeiten, Familienfeste...)\r\nGreifen Sie auf 7 Säle zu, die von Empfängen über Versammlungen bis hin zu Aufführungen reichen."
    ],
    "en": [
      "A setting that is both serene and fun, ideal for hosting your professional or private events ... (seminars, team building, training, family celebrations ...)\r\n7 rooms + 3 outdoor spaces for rent"
    ],
    "it": [
      "Un ambiente sereno e divertente al tempo stesso, ideale per ospitare i vostri eventi aziendali o privati (seminari, team building, formazione, matrimoni, celebrazioni familiari, ecc.)\r\nAccesso a 7 sale, dai ricevimenti agli spettacoli e alle riunioni."
    ],
    "fr": [
      "Un cadre à la fois serein et ludique, idéal pour l'accueil de vos événements professionnels ou privés…(séminaires, team building, formation, mariage, fêtes de famille…)\r\nAccédez à 7 salles de la réception au spectacle en passant par la réunion."
    ],
    "es": [
      "Un entorno a la vez sereno y divertido, ideal para acoger sus eventos profesionales o privados (seminarios, team building, formación, bodas, celebraciones familiares, etc.)\r\nAcceso a 7 salas, desde recepciones hasta espectáculos y reuniones."
    ],
    "nl": [
      "Een omgeving die zowel sereen als leuk is, ideaal voor het organiseren van uw zakelijke of privé-evenementen (seminars, teambuilding, training, bruiloften, familiefeesten, enz.)\r\nToegang tot 7 zalen voor recepties, shows en vergaderingen."
    ]
  },
