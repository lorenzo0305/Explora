  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Bibliothek, die sich nicht weit von der Krippe entfernt befindet. Freiwillige Helfer empfangen Sie und stehen Ihnen während der Sprechstunden zur Verfügung."
    ],
    "en": [
      "Come and discover our library, located not far from the crèche. Volunteers are on hand to welcome you and listen to your needs."
    ],
    "it": [
      "Venite a scoprire la nostra biblioteca, situata non lontano dall'asilo nido. I volontari sono a disposizione per accogliervi e ascoltare le vostre esigenze."
    ],
    "fr": [
      "Venez découvrir notre bibliothèque située pas loin de la crèche, des bénévoles vous accueils et sont à votre écoute durant les permanences."
    ],
    "es": [
      "Venga a descubrir nuestra biblioteca, situada no lejos de la guardería. Los voluntarios están a su disposición para acogerle y escuchar sus necesidades."
    ],
    "nl": [
      "Kom en ontdek onze bibliotheek, niet ver van de crèche. Vrijwilligers staan klaar om je te verwelkomen en naar je behoeften te luisteren."
    ]
  },
