  "rdfs:comment": {
    "de": [
      "Mitten im Weinbaugebiet Côte-Rôtie liegt dieses einzigartige Anwesen, das großen Weinen aus dem Rhonetal, Kultur, Kulturerbe und Pop-up-Gastronomie gewidmet ist."
    ],
    "en": [
      "Welcome to the Caveau du Château, a unique place in the heart of the Côte-Rôtie vineyards, dedicated to the fine wines and appellations of the Rhône Valley."
    ],
    "it": [
      "Scoprite un luogo unico situato nel cuore del vigneto della Côte-Rôtie, dedicato ai grandi vini della Valle del Rodano, alla cultura, al patrimonio e alla gastronomia effimera."
    ],
    "fr": [
      "Découvrez un lieu unique situé au cœur du vignoble de Côte-Rôtie, dédié aux grands vins de la Vallée du Rhône, à la Culture, au Patrimoine et à la Gastronomie éphémère."
    ],
    "nl": [
      "Ontdek een unieke plek gelegen in het hart van de Côte-Rôtie wijngaard, gewijd aan de grote wijnen van de Rhône-vallei, aan Cultuur, aan Erfgoed en aan de kortstondige Gastronomie."
    ],
    "es": [
      "Descubra un lugar único situado en el corazón del viñedo de la Côte-Rôtie, dedicado a los grandes vinos del Valle del Ródano, a la Cultura, al Patrimonio y a la Gastronomía efímera."
    ]
  },
