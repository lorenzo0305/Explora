  "rdfs:comment": {
    "de": [
      "Die Hostellerie Charles de Foucauld liegt ideal im Rhône-Tal, in der Nähe bekannter Touristenorte, und empfängt Sie für die Organisation von Versammlungen und Kongressen. Verpflegung in Selbstbedienung oder am Tisch serviert."
    ],
    "en": [
      "Ideally located in the Rhône Valley, not far from several wellknown tourist attractions. The newly-renovated Diocesan Centre can organize meetings and congresses. Self- or waiter-service."
    ],
    "it": [
      "Situata in posizione ideale nella Valle del Rodano, vicino a famosi siti turistici, l'Hostellerie Charles de Foucauld vi accoglie per l'organizzazione di riunioni e conferenze. Ristorazione self-service o al piatto."
    ],
    "fr": [
      "Idéalement située dans la vallée du Rhône, proche de lieux touristiques réputés, l'hostellerie Charles de Foucauld vous accueille pour l'organisation d'assemblées, de congrès. Restauration en self ou à l'assiette."
    ],
    "nl": [
      "Ideaal gelegen in de Rhône-vallei, dicht bij beroemde toeristische plekken, verwelkomt het diocesane huis je, het restaurant is volledig gerenoveerd. Voor de organisatie van vergaderingen en congressen. Self service of restaurant service."
    ],
    "es": [
      "Con una ubicación ideal en el Valle del Ródano, cerca de famosos lugares turísticos, la Hostellerie Charles de Foucauld le da la bienvenida para la organización de reuniones y conferencias. Autoservicio o catering en plato."
    ]
  },
