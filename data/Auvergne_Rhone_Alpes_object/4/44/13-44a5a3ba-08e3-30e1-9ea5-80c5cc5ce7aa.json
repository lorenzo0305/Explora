  "rdfs:comment": {
    "de": [
      "Strecke mit 4 Körben + 1 Trainingskorb, in den Bergen, in einer wunderschönen Naturumgebung. Ideal für einen schönen Moment mit der Familie oder mit Freunden.\r\nLassen Sie die Frisbees fliegen für garantiertes Gelächter!"
    ],
    "en": [
      "Course with 4 baskets + 1 training basket, in the mountains, in a magnificent natural setting. Ideal for a good time with family and friends.\r\nKeep the Frisbees flying for guaranteed laughs!"
    ],
    "it": [
      "Percorso con 4 canestri + 1 canestro di allenamento, in montagna, in un magnifico contesto naturale. Ideale per divertirsi con la famiglia e gli amici.\r\nLasciate volare i frisbee per una risata assicurata!"
    ],
    "fr": [
      "Parcours de 4 corbeilles + 1 d'entrainement, en montagne, dans un cadre nature magnifique. Idéal pour un bon moment en famille ou entre amis.\r\nFaites voler les frisbee pour des fous rires garanties !"
    ],
    "nl": [
      "Parcours met 4 korven + 1 trainingskorf, in de bergen, in een prachtige natuurlijke omgeving. Ideaal voor een leuke tijd met familie en vrienden.\r\nLaat de frisbees vliegen voor gegarandeerd gegiechel!"
    ],
    "es": [
      "Campo con 4 canastas + 1 canasta de entrenamiento, en la montaña, en un magnífico entorno natural. Ideal para pasar un buen rato en familia o entre amigos.\r\nDeje volar los frisbees para reírse a carcajadas"
    ]
  },
  "rdfs:label": {
