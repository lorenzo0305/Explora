  "rdfs:comment": {
    "de": [
      "Vincent und Patrick freuen sich, Sie in ihrer Tapas-Bar und ihrem Restaurant in einer gemütlichen Atmosphäre begrüßen zu dürfen.\r\nTapas, Bretter Steak Angus frittiert Salat, Fish and Chips Salat, geriebene Wurstwaren Salat..."
    ],
    "en": [
      "Vincent and Patrick will be delighted to welcome you to their tapas bar-restaurant in a friendly atmosphere.\r\nTapas, steak angus frite salade, fish and chips salade, grated charcuterie salade..."
    ],
    "it": [
      "Vincent e Patrick saranno lieti di accogliervi nel loro bar-ristorante di tapas in un'atmosfera calda e accogliente.\r\nTapas, bistecche di Angus fritte e vassoi di insalata, insalata di fish and chips, insalata di salumi grattugiati..."
    ],
    "fr": [
      "Vincent et Patrick seront heureux de vous accueillir dans leur bar à tapas-restaurant dans une ambiance chaleureuse.\r\nTapas, planches steak angus frite salade, fish and chips salade, râpée charcuterie salade..."
    ],
    "es": [
      "Vincent y Patrick estarán encantados de recibirle en su bar-restaurante de tapas en un ambiente cálido y acogedor.\r\nTapas, filete Angus frito y platos de ensalada, ensalada de pescado y patatas fritas, ensalada de embutidos rallados..."
    ],
    "nl": [
      "Vincent en Patrick heten je van harte welkom in hun tapasbar-restaurant in een warme en vriendelijke sfeer.\r\nTapas, gebakken Angus steak en salade schotels, fish and chips salade, geraspte vleeswaren salade..."
    ]
  },
  "rdfs:label": {
