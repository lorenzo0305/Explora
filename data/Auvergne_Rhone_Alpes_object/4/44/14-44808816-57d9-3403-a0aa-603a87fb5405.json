      "dc:description": {
        "de": [
          "Benoit de Bretagne bietet zusätzlich zu seiner Geigenbauwerkstatt auch den Verkauf und die Einstellung von Gitarren und Ukulelen an."
        ],
        "en": [
          "In addition to his lutherie workshop, Benoit de Bretagne also sells and adjusts guitars and ukuleles."
        ],
        "it": [
          "Oltre al suo laboratorio di liuteria, Benoit de Bretagne vende e aggiusta chitarre e ukulele."
        ],
        "fr": [
          "Benoit de Bretagne propose également en plus de son atelier de lutherie, la vente, les réglages de guitare et ukulélé."
        ],
        "nl": [
          "Naast zijn lutherie-atelier verkoopt en verstelt Benoit de Bretagne ook gitaren en ukeleles."
        ],
        "es": [
          "Además de su taller de luthería, Benoit de Bretagne también vende y ajusta guitarras y ukeleles."
        ]
