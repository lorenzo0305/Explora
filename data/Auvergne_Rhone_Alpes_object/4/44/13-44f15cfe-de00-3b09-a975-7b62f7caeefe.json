  "rdfs:comment": {
    "de": [
      "Die SERMA (Société d'Exploitation des Remontées Mécaniques de Morzine-Avoriaz) ist ein Familienunternehmen, das seit 1994 das Skigebiet von Avoriaz verwaltet.\r\nDie SERMA hat erfolgreich eine Sommeraktivität rund um das Downhill-Mountainbiking entwickelt."
    ],
    "en": [
      "SERMA (Société d'Exploitation des Remontées Mécaniques de Morzine-Avoriaz) is a family business that has been managing the Avoriaz ski area since 1994.\r\nSERMA has also successfully developed downhill mountain biking as a summer activity in the area."
    ],
    "it": [
      "SERMA (Société d'Exploitation des Remontées Mécaniques de Morzine-Avoriaz) è un'azienda familiare che gestisce il comprensorio sciistico di Avoriaz dal 1994.\r\nSERMA ha sviluppato con successo un'attività estiva intorno alla mountain bike da discesa."
    ],
    "fr": [
      "La SERMA (Société d'Exploitation des Remontées Mécaniques de Morzine-Avoriaz) est une entreprise familiale qui gère le domaine d’Avoriaz depuis 1994.\r\nLa SERMA a développé avec succès une activité estivale autour de la pratique du VTT de descente."
    ],
    "nl": [
      "SERMA (Société d'Exploitation des Remontées Mécaniques de Morzine-Avoriaz) is een familiebedrijf dat sinds 1994 het skigebied van Avoriaz beheert.\r\nSERMA heeft met succes een zomeractiviteit ontwikkeld rond downhill mountainbiken."
    ],
    "es": [
      "SERMA (Société d'Exploitation des Remontées Mécaniques de Morzine-Avoriaz) es una empresa familiar que gestiona el dominio esquiable de Avoriaz desde 1994.\r\nEl SERMA ha desarrollado con éxito una actividad de verano en torno al descenso en bicicleta de montaña."
    ]
  },
