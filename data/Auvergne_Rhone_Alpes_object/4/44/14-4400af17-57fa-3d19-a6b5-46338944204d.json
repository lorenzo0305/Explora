      "@id": "https://data.datatourisme.fr/9f62dfe2-e292-32de-869a-7b89771687bb",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\nMittwoch bis Samstag von 11:30 bis 13:30 Uhr und von 18:30 bis 20:30 Uhr\n\nBestellungen:\nKontaktieren Sie die Pommesbude vorher telefonisch unter 03 21 22 02 44.\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nWednesday to Saturday, 11:30am to 1:30pm and 6:30pm to 8:30pm\n\nOrders:\nContact the French fry shop in advance by telephone on 03 21 22 02 44.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\nDa mercoledì a sabato, dalle 11.30 alle 13.30 e dalle 18.30 alle 20.30\n\nOrdinazioni:\nContattare il negozio di patatine in anticipo telefonando al numero 03 21 22 02 44.\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu mercredi au samedi de 11h30 à 13h30 et de 18h30 à 20h30\n\nCommandes :\nContacter la friterie au préalable par téléphone au 03 21 22 02 44.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\nWoensdag tot zaterdag van 11u30 tot 13u30 en van 18u30 tot 20u30\n\nBestellen:\nNeem vooraf telefonisch contact op met de friettent op 03 21 22 02 44.\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\nDe miércoles a sábado, de 11.30 a 13.30 h. y de 18.30 a 20.30 h\n\nPedidos:\nPóngase en contacto con la tienda de patatas fritas por teléfono llamando al 03 21 22 02 44.\n\n "
        ]
      },
