  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bed50f81-3c18-3164-bdc8-f1c973461bd1",
      "dc:description": {
        "de": [
          "Der landwirtschaftliche Betrieb ist auf die Zucht von Rindern der Rasse Blonde d'Aquitaine spezialisiert.\nProduzent und Züchter von Fleisch, Fleischkuh\nVerkauf von Rindfleisch, Kalbfleisch, Rindfleisch"
        ],
        "en": [
          "The farm specialises in breeding blonde Aquitaine cattle.\nMeat producer and breeders, meat cow\nSale of beef, veal, bovine meat"
        ],
        "it": [
          "L'azienda è specializzata nell'allevamento di bovini di razza Blonde d'Aquitaine.\nProduttore e allevatore di carne, vacca da carne\nVendita di carne di manzo, vitello e prodotti a base di carne bovina"
        ],
        "fr": [
          "L'exploitation agricole est spécialisée dans l'élevage de bovins de race blonde d'Aquitaine.\nProducteur et éleveurs de viandes, vache à viandes\nVente de viandes de boeuf, de veau, bovines"
        ],
        "es": [
          "La explotación está especializada en la cría de ganado de la raza Blonde d'Aquitaine.\nProductor y criador de carne, vaca de carne\nVenta de carne de vacuno y productos derivados"
        ],
        "nl": [
          "Het bedrijf is gespecialiseerd in het fokken van runderen van het ras Blonde d'Aquitaine.\nProducent en fokker van vlees, vleeskoe\nVerkoop van rundvlees en rundvleesproducten"
        ]
      },
      "@type": [
        "Description"
      ],
