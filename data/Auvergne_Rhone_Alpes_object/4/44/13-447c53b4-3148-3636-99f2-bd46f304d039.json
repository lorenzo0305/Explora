  "rdfs:comment": {
    "de": [
      "L'Arrière cour ist ein Ort, an dem das Leitmotiv darin besteht, alte Möbel wieder ins Rampenlicht zu rücken, nachdem sie nicht renoviert, sondern vielmehr komplett neu gestaltet wurden, und zwar mit Vintage-Möbeln oder -Objekten."
    ],
    "en": [
      "L'Arrière cour is a place where the leitmotiv is to bring antique furniture back into the limelight after not a renovation, but rather a complete overhaul of vintage furniture or objects."
    ],
    "it": [
      "L'Arrière cour è un luogo in cui il leitmotiv è riportare alla ribalta vecchi mobili dopo non una ristrutturazione, ma piuttosto una revisione completa di mobili o oggetti vintage."
    ],
    "fr": [
      "L'Arrière cour, c'est un lieu où le leitmotiv est de remettre sur le devant de la scène du mobilier ancien après non pas une rénovation, mais plutôt un refonte complète de meubles ou objets vintage."
    ],
    "nl": [
      "L'Arrière cour is een plek waar het leidmotief is om oude meubels weer op de voorgrond te brengen na niet een renovatie, maar eerder een complete revisie van vintage meubels of voorwerpen."
    ],
    "es": [
      "L'Arrière cour es un lugar en el que el leitmotiv es volver a poner en primer plano muebles antiguos tras no una renovación, sino una revisión completa de muebles u objetos vintage."
    ]
  },
  "rdfs:label": {
