  "rdfs:comment": {
    "de": [
      "Das Dach Europas, das drittmeistbesuchte Naturgebiet der Welt, zieht weiterhin jedes Jahr Millionen von Besuchern und Tausende von Bergsteigern an."
    ],
    "en": [
      "The roof of Europe, the third most visited natural site in the world, continues to attract millions of visitors and thousands of climbers every year."
    ],
    "it": [
      "Il tetto d'Europa, il terzo sito naturale più visitato al mondo, continua ad attrarre ogni anno milioni di visitatori e migliaia di scalatori."
    ],
    "fr": [
      "Le toit de l'Europe, troisième site naturel le plus visité au monde, continue chaque année d'attirer des millions de visiteurs et des milliers d'alpinistes."
    ],
    "nl": [
      "Het dak van Europa, het derde meest bezochte natuurgebied ter wereld, blijft jaarlijks miljoenen bezoekers en duizenden klimmers aantrekken."
    ],
    "es": [
      "El techo de Europa, el tercer sitio natural más visitado del mundo, sigue atrayendo a millones de visitantes y miles de escaladores cada año."
    ]
