  "rdfs:comment": {
    "de": [
      "Selbstständiger Weintourismusführer in der Gegend von Tain l'Hermitage und Tournon sur Rhône, Dolmetscherautor der Wine Man Show und Beauftragter für Weintourismus von Familienweingütern im nördlichen Rhônetal."
    ],
    "en": [
      "Freelance wine tourism guide in the Tain l'Hermitage and Tournon sur Rhône regions, Wine Man Show author and wine tourism manager for family estates in the northern Rhône valley."
    ],
    "it": [
      "Guida enoturistica indipendente nella regione di Tain l'Hermitage e Tournon sur Rhône, autore e interprete di Wine Man Show e responsabile dell'enoturismo nelle tenute familiari della Valle del Rodano settentrionale"
    ],
    "fr": [
      "Guide oenotouristique indépendant dans la region de Tain l’Hermitage et de Tournon sur Rhône, auteur interprete de Wine Man Show  et chargé du tourisme viticole de domaines familiaux dans la vallée du Rhône Nord"
    ],
    "nl": [
      "Onafhankelijke gids voor wijntoerisme in de regio van Tain l'Hermitage en Tournon sur Rhône, auteur en vertolker van Wine Man Show en verantwoordelijk voor wijntoerisme op familielandgoederen in de Noordelijke Rhônevallei."
    ],
    "es": [
      "Guía independiente de enoturismo en la región de Tain l'Hermitage y Tournon sur Rhône, autor e intérprete de Wine Man Show y responsable de enoturismo en fincas familiares del Valle del Ródano Norte"
    ]
  },
