  "rdfs:comment": {
    "de": [
      "Das Team des Méliès Café empfängt Sie das ganze Jahr über für Momente voller Entspannung und Genuss. Das Café ist täglich geöffnet und wartet mit einer schönen Terrasse in anregendem Ambiente rund um das Kino an der Place Jean Jaurès auf Sie."
    ],
    "en": [
      "The team at Le Méliès Café invites you take time out and enjoy a drink, any time of the year. It’s open seven days a week in the lively setting near the cinema, and has a pleasant terrace on the Place Jean Jaurès."
    ],
    "it": [
      "Il team del Méliès Café vi accoglie per un momento di relax e degustazione durante tutto l'anno. Aperto 7 giorni su 7, offre un ambiente rinfrescante intorno al cinema e una bella terrazza su Place Jean Jaurès."
    ],
    "fr": [
      "L’Équipe du Méliès Café vous accueille pour un moment de détente et de dégustation tout au long de l'année. Ouvert 7j sur 7, vous trouverez un cadre rafraîchissant autour du cinéma ainsi qu'une belle terrasse place Jean Jaurès."
    ],
    "nl": [
      "Het team van Méliès Café heet u het hele jaar door welkom voor een moment van ontspanning en proeverij. Het is 7 dagen per week geopend en biedt een verfrissende omgeving rond de bioscoop en een heerlijk terras op Place Jean Jaurès."
    ],
    "es": [
      "El equipo del Café Méliès le da la bienvenida para un momento de relajación y degustación durante todo el año. Abierto los 7 días de la semana, encontrará un ambiente refrescante alrededor del cine, así como una encantadora terraza en la plaza Jean Jaurès."
    ]
  },
