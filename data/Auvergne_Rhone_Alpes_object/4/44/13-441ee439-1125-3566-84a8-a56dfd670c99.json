  "rdfs:comment": {
    "de": [
      "Im Herzen der Drôme Provençale, in einer ländlichen Umgebung und im Mittelgebirge gelegen, befindet sich die Mountainbike-Basis des Pays de Dieulefit? Bourdeaux bietet abwechslungsreiche Strecken: Balkonwege, Wege mit freier Aussicht, geschütztes Unterholz und Wälder."
    ],
    "en": [
      "Situated in the heart of the Drôme Provençale, in a countryside and mid-mountain setting, the Base VTT du Pays de Dieulefit ? Bourdeaux offers a wide variety of routes, including balcony trails, paths with unobstructed views, and unspoilt undergrowth and forests."
    ],
    "it": [
      "Situata nel cuore della Drôme Provençale, in un ambiente di campagna e di media montagna, la Base VTT du Pays de Dieulefit ? Bourdeaux offre un'ampia gamma di percorsi, da sentieri e percorsi panoramici con viste ininterrotte a boschi e sottoboschi incontaminati."
    ],
    "fr": [
      "Situé au coeur de la Drôme Provençale, dans un décor de campagne et moyenne montagne, la Base VTT du Pays de Dieulefit – Bourdeaux offre des parcours variés : sentiers en balcons, chemins avec vues dégagées, sous-bois et forêts préservés."
    ],
    "es": [
      "Situada en el corazón de la Drôme provenzal, en un entorno campestre y de media montaña, la Base VTT du Pays de Dieulefit ? Bourdeaux ofrece un amplio abanico de rutas, desde senderos panorámicos y caminos con vistas ininterrumpidas hasta sotobosques y bosques vírgenes."
    ],
    "nl": [
      "De Base VTT du Pays de Dieulefit ? Bourdeaux een breed scala aan routes, van schilderachtige wandelpaden en paden met ononderbroken uitzichten tot ongerept kreupelhout en bossen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Base de VTT de Dieulefit-Bourdeaux"
    ]
  },
