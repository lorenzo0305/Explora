  "rdfs:comment": {
    "de": [
      "Schattige Wasserfläche, Zugang zum Fluss zum Baden und Picknicktische. Einkaufsmöglichkeiten in der Nähe.\r\nKürzlich renovierte Hartplatztennisplätze und Fußballplätze."
    ],
    "en": [
      "Shaded lake, river access for swimming and picnic tables. Shops nearby.\r\nRecently renovated hard tennis courts and soccer field."
    ],
    "it": [
      "Lago ombreggiato, accesso al fiume per nuotare e tavoli da picnic. Negozi nelle vicinanze.\r\nCampi da tennis e da calcio rigidi recentemente ristrutturati."
    ],
    "fr": [
      "Plan d'eau ombragé, accès à la rivière pour la baignade et tables de pique nique. Commerces à proximité. \r\nTerrains de tennis en dur récemment rénovés et de foot."
    ],
    "nl": [
      "Schaduwrijk meer, toegang tot de rivier om te zwemmen en picknicktafels. Winkels in de buurt.\r\nOnlangs gerenoveerde harde tennisbanen en voetbalveld."
    ],
    "es": [
      "Lago sombreado, acceso al río para bañarse y mesas de picnic. Tiendas cercanas.\r\nPistas de tenis duras y campo de fútbol recientemente renovados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de loisirs d'Antraïgues"
    ]
  },
