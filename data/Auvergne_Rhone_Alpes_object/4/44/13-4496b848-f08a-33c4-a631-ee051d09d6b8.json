  "rdfs:comment": {
    "de": [
      "Das Haras de Préjeurin organisiert (mittwochs, samstags und sonntags) für Familien oder Freunde begleitete Reitausflüge in den Pilat. Für die Kleinsten sind ½- oder 1-stündige Ausritte \"an der Hand\" möglich. Vergessen Sie nicht zu reservieren!"
    ],
    "en": [
      "The Haras de Prejeurin stables welcome you in the Pilat Natural Park. A private stable, horse riding centre, equestrian training centre and breeder with functional infrastructures, qualified trainers, French Jeunesse & Sport accreditation and an approved establishment."
    ],
    "it": [
      "L'Haras de Préjeurin organizza (mercoledì, sabato e domenica) per famiglie o amici passeggiate a cavallo accompagnate nel Pilat. Per i più piccoli sono possibili corse di ½ ora o di 1 ora. Non dimenticate di prenotare!"
    ],
    "fr": [
      "Le Haras de Préjeurin organise (mercredi, samedi & dimanche) pour les familles ou entre amis des randonnées équestres accompagnées dans le Pilat. Pour les plus petits, des balades \"en main\" d’ ½ heure ou d’1 heure sont possible. N’oubliez pas de réserver!"
    ],
    "es": [
      "El Haras de Préjeurin organiza (los miércoles, sábados y domingos) para familias o amigos paseos a caballo acompañados en el Pilat. Para los más pequeños, son posibles los paseos de ½ hora o 1 hora. No se olvide de reservar"
    ],
    "nl": [
      "De Haras de Préjeurin organiseert (woensdag, zaterdag & zondag) voor families of vrienden begeleide paardrijtochten in de Pilat. Voor de kleintjes zijn ritten \"in de hand\" van ½ uur of 1 uur mogelijk. Vergeet niet te reserveren!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Haras de Préjeurin"
    ]
  },
