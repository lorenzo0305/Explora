  "rdfs:comment": {
    "de": [
      "Erleben Sie das Besondere mit Blugeon Hélicoptères mit 40 Jahren Erfahrung: Panoramaflüge zum Mont Blanc, Transfers von Flughäfen wie Genf zu den Skigebieten, Hubschrauberlandeplätze. Ein Familienunternehmen, das Komfort, Sicherheit und Leidenschaft im Herzen der Alpen vereint."
    ],
    "en": [
      "Blugeon Helicopters has been a local, family-owned helicopter company for over 40 years.\nChristian BLUGEON is the founder of the company and has trained his 3 sons who work with him as a pilot + his daughter who manage the communication and marketing of the company.\nBased in Morzine, BLUGEON HELICOPTERS work everywhere in the Alps and in France."
    ],
    "it": [
      "Vivete un'esperienza eccezionale con Blugeon Hélicoptères, con 40 anni di esperienza: voli panoramici sul Monte Bianco, trasferimenti dagli aeroporti come Ginevra alle località turistiche, eliporti. Un'azienda familiare che unisce comfort, sicurezza e passione nel cuore delle Alpi."
    ],
    "fr": [
      "Vivez l’exception avec Blugeon Hélicoptères avec 40 ans d'expérience : vols panoramiques au Mont Blanc, transferts aéroport comme Genève vers les stations, héliportage. Une entreprise familiale qui allie confort, sécurité et passion au cœur des Alpes."
    ],
    "es": [
      "Viva una experiencia excepcional con Blugeon Hélicoptères, con 40 años de experiencia: vuelos panorámicos al Mont Blanc, traslados desde aeropuertos como Ginebra a las estaciones, helipuertos. Una empresa familiar que combina confort, seguridad y pasión en el corazón de los Alpes."
    ],
    "nl": [
      "Blugeon Hélicoptères is al meer dan 38 jaar een lokaal helikopterbedrijf in familiebeheer."
    ]
  },
