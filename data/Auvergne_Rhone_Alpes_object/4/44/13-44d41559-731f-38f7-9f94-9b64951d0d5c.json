  "rdfs:comment": {
    "de": [
      "Die GAEC du Chastel mit Sitz in Saint-Floret freut sich, Ihnen ein vielfältiges Angebot an Obst für den Direktverkauf und das Pflücken vom Baum anbieten zu können."
    ],
    "en": [
      "Based in Saint-Floret, the GAEC du Chastel is pleased to offer you a varied range of fruit for direct sale and tree-picking."
    ],
    "it": [
      "Con sede a Saint-Floret, il GAEC du Chastel è lieto di offrirvi un'ampia gamma di frutta per la vendita diretta e la raccolta di alberi."
    ],
    "fr": [
      "Basé à Saint-Floret, le GAEC du Chastel a le plaisir de vous proposer une gamme variée de fruits en vente directe et cueillette sur l’arbre."
    ],
    "nl": [
      "De GAEC du Chastel, gevestigd in Saint-Floret, biedt je een breed assortiment fruit voor directe verkoop en boompluk."
    ],
    "es": [
      "Con sede en Saint-Floret, el GAEC du Chastel se complace en ofrecerle una amplia gama de frutas para la venta directa y la recolección en el árbol."
    ]
  },
