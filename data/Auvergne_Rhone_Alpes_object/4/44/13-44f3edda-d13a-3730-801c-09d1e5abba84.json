  "rdfs:comment": {
    "de": [
      "Direktverkauf von Bauernhofprodukten: Käse (reiner Ziegenkäse, Halbziegenkäse und reiner Kuhkäse), Eier und hausgemachte Marmelade. Aus eigener Herstellung. Erster mit Blumen geschmückter Bauernhof des Departements."
    ],
    "en": [
      "Direct sale of farm products: cheeses (pure goat, half goat and pure cow), eggs and homemade jam. Home-made products. First flowered farm in the department."
    ],
    "it": [
      "Vendita diretta dei prodotti dell'azienda: formaggi (puro latte di capra, mezzo latte di capra e puro latte di mucca), uova e marmellate fatte in casa. Prodotti fatti in casa. Prima azienda floricola del dipartimento."
    ],
    "fr": [
      "Vente directe de produits fermiers : fromages (pur chèvre, mi-chèvre et pur vache), oeufs et confiture maison. Fabrication artisanale. Première ferme fleurie du département."
    ],
    "es": [
      "Venta directa de productos de la granja: quesos (de pura leche de cabra, de media leche de cabra y de pura leche de vaca), huevos y mermelada casera. Productos caseros. Primera granja de flores del departamento."
    ],
    "nl": [
      "Directe verkoop van boerderijproducten: kazen (zuivere geitenmelk, halfgeitenmelk en zuivere koemelk), eieren en zelfgemaakte jam. Zelfgemaakte producten. Eerste bloemenkwekerij in het departement."
    ]
  },
  "rdfs:label": {
