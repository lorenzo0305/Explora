  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte von La Chaise-Dieu anhand seiner Steine, seiner mit Maskarons, Brettern, Befestigungen und Wappen geschmückten Fassaden... die Außenseiten der Abteigebäude und des Turms Clémentine sowie das Refektorium, das zur Chapelle des Pénitents wurde."
    ],
    "en": [
      "An introduction to the history of La Chaise-Dieu through the town’s stones, the façades decorated with mascarons, its brattices, fortifications and coats of arms... The outer walls of the Abbey, the Clementine Tower and the Penitents Chapel."
    ],
    "it": [
      "Scoprite la storia di La Chaise-Dieu attraverso le sue pietre, le facciate decorate con mascarons, bretèches, fortificazioni e stemmi... gli esterni degli edifici abbaziali e della Tour Clémentine, nonché il refettorio che divenne la Chapelle des Pénitents."
    ],
    "fr": [
      "Découvrez l'histoire de la Chaise-Dieu à travers ses pierres, ses façades ornées de mascarons, bretèches, fortifications et blasons... les extérieurs des bâtiments abbatiaux et de la Tour Clémentine ainsi que le réfectoire devenu Chapelle des Pénitents."
    ],
    "nl": [
      "Ontdek de geschiedenis van La Chaise-Dieu via het metselwerk, de gevels versierd met mascarons, bretèches, vestingwerken en wapenschilden... de buitenkant van de abdijgebouwen en de Tour Clémentine, evenals de refter die de Chapelle des Pénitents werd."
    ],
    "es": [
      "Descubra la historia de La Chaise-Dieu a través de su cantería, sus fachadas decoradas con mascarones, bretones, fortificaciones y escudos... los exteriores de los edificios abaciales y de la Tour Clémentine, así como el refectorio que se convirtió en la Chapelle des Pénitents."
    ]
  },
  "rdfs:label": {
    "en": [
      "Medieval village tour"
    ],
    "fr": [
      "Visite libre du bourg médiéval de la Chaise-Dieu"
    ]
  },
