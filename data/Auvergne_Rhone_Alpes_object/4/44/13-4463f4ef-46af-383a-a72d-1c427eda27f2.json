  "rdfs:comment": {
    "de": [
      "Die Ferme des Rives (biologischer Landbau) bietet Nudeln aus dem Weizen der Farm an, die mit zwei Mehlsorten T65 weiß und T80 halbvollkorn zubereitet werden."
    ],
    "en": [
      "Ferme des Rives (organic farming) offers pasta made with the farm's own wheat, prepared with two types of flour: T65 white and T80 semi-complete."
    ],
    "it": [
      "La Ferme des Rives (agricoltura biologica) offre pasta di grano proveniente dall'azienda agricola, preparata con due tipi di farina: T65 bianca e T80 semi integrale."
    ],
    "fr": [
      "La Ferme des Rives (agriculture biologique) propose des pâtes fabriquées avec le blé de la ferme, préparées avec deux types de farine T65 blanche et T80 semi complète."
    ],
    "es": [
      "La Ferme des Rives (agricultura ecológica) ofrece pasta elaborada con trigo de la explotación, preparada con dos tipos de harina: T65 blanca y T80 semiintegral."
    ],
    "nl": [
      "Ferme des Rives (biologische landbouw) biedt pasta gemaakt met tarwe van de boerderij, bereid met twee soorten meel: T65 wit en T80 halfvolkoren."
    ]
  },
