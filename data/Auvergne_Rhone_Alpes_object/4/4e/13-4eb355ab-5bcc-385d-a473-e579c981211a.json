  "rdfs:comment": {
    "de": [
      "In einem beruhigenden und erholsamen Rahmen und zur Freude der Geschmacksknospen treten Sie ein und genießen Sie traditionelle Gerichte, gastronomische Menüs mit regionalen Aromen und dem unumgänglichen Maroilles."
    ],
    "en": [
      "In a soothing and relaxing setting and for the pleasure of your taste buds, come in and taste traditional dishes, gastronomic menus with local flavors and the unavoidable Maroilles."
    ],
    "it": [
      "In un ambiente rilassante e per il piacere delle vostre papille gustative, venite a gustare piatti tradizionali, menu gastronomici con sapori locali e le imperdibili Maroilles."
    ],
    "fr": [
      "Dans un cadre apaisant et ressourçant et pour le plaisir des papilles, entrez et dégustez des plats traditionnels, des menus gastronomiques aux saveurs du terroir avec l’incontournable Maroilles."
    ],
    "nl": [
      "Kom in een rustgevend en ontspannen kader en voor het genot van uw smaakpapillen proeven van traditionele gerechten, gastronomische menu's met lokale smaken en de niet te missen Maroilles."
    ],
    "es": [
      "En un entorno relajante y para el placer de su paladar, venga a degustar platos tradicionales, menús gastronómicos con sabores locales y el imperdible Maroilles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge Les Etangs des Moines"
    ]
  },
