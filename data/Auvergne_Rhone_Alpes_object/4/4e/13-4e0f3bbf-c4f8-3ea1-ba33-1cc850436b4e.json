  "rdfs:comment": {
    "de": [
      "La Brasserie, im Herzen von Avoriaz, ist ein Restaurant mit einer großzügigen und geselligen Küche. Genießen Sie abwechslungsreiche Gerichte auf einer Panoramaterrasse mit Blick auf das Skigebiet von Avoriaz,"
    ],
    "en": [
      "La Brasserie, located in the heart of Avoriaz, is a restaurant offering generous and convivial cuisine. Enjoy a variety of dishes on a panoramic terrace overlooking the Avoriaz ski area."
    ],
    "it": [
      "La Brasserie, nel cuore di Avoriaz, è un ristorante che offre una cucina generosa e accogliente. Potrete gustare una varietà di piatti su una terrazza panoramica con vista sul comprensorio sciistico di Avoriaz,"
    ],
    "fr": [
      "La Brasserie, en plein cœur d’Avoriaz, est un restaurant avec une cuisine généreuse et conviviale. Dégustez des plats variés sur une terrasse panoramique face au domaine skiable d'Avoriaz,"
    ],
    "nl": [
      "La Brasserie, gelegen in het hart van Avoriaz, is een restaurant met een royale en gezellige keuken. Geniet van gevarieerde gerechten op een panoramisch terras met uitzicht op het skigebied van Avoriaz."
    ],
    "es": [
      "La Brasserie, en el corazón de Avoriaz, es un restaurante que ofrece una cocina generosa y acogedora. Disfrute de una gran variedad de platos en una terraza panorámica con vistas al dominio esquiable de Avoriaz,"
    ]
  },
