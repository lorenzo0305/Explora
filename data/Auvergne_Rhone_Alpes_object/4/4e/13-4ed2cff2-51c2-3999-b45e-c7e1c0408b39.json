  "rdfs:comment": {
    "de": [
      "Der runde Hügel von Montclar-sur-Gervanne erhebt sich wie ein Pilz mitten im Gervanne-Tal. Dieser Aussichtspunkt stimmt uns nachdenklich... Ebenfalls einen Besuch wert ist das Château de Vachères am Fuße des Dorfes."
    ],
    "en": [
      "The rounded hill of Montclar-sur-Gervanne sprouts like a mushroom in the middle of the Gervanne Valley. This veritable lookout point leaves us pensive... Also worth a visit is the Château de Vachères at the foot of the village."
    ],
    "it": [
      "La collina arrotondata di Montclar sur Gervanne cresce come un fungo nel mezzo della valle di Gervanne. Questo vero e proprio punto panoramico vi lascerà a bocca aperta? Merita una visita anche lo Château de Vachères, ai piedi del villaggio."
    ],
    "fr": [
      "La butte arrondie de Montclar sur- Gervanne pousse comme un champignon au milieu de vallée de la Gervanne. Ce véritable mirador nous laisse songeur… A visiter également, le Château de Vachères au pied du village."
    ],
    "es": [
      "La colina redondeada de Montclar sur Gervanne crece como una seta en medio del valle de Gervanne. Este auténtico mirador le dejará boquiabierto.. También merece una visita el castillo de Vachères, a los pies del pueblo."
    ],
    "nl": [
      "De ronde heuvel van Montclar-sur-Gervanne rijst als een paddenstoel op in het midden van de Gervannevallei. Dit ware uitkijkpunt laat ons even nadenken... Ook een bezoek waard is het Château de Vachères aan de voet van het dorp."
    ]
  },
