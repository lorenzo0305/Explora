  "rdfs:comment": {
    "de": [
      "Die Brauerei stellt vor Ort handwerklich hergestellte Biere und Limonaden mit Quellwasser her, die AB-zertifiziert sind. Unsere Biere werden aus Getreide gebraut, das in der Auvergne angebaut und gemälzt wird. Sie werden weder gefiltert noch pasteurisiert."
    ],
    "en": [
      "Our unfiltered, unpasteurised beers are made from cereals grown and malted in\r\nAuvergne. Come meet us at our brewery and discover our craft."
    ],
    "it": [
      "Il birrificio produce sul posto birre artigianali e limonate con acqua di sorgente, certificata AB. Le nostre birre sono prodotte con cereali coltivati e maltati in Alvernia. Non sono né filtrati né pastorizzati."
    ],
    "fr": [
      "La brasserie produit sur place des bières et limonades artisanales à l’eau de source, certifiées AB. Nos bières sont brassées à partir de céréales cultivées et maltées en Auvergne. Elles ne sont ni filtrées ni pasteurisées."
    ],
    "es": [
      "La cervecería produce cervezas artesanales y limonadas in situ con agua de manantial, certificada AB. Nuestras cervezas se elaboran con cereales cultivados y malteados en Auvernia. No están filtrados ni pasteurizados."
    ],
    "nl": [
      "De brouwerij produceert ambachtelijke bieren en limonades met bronwater, gecertificeerd AB. Onze bieren worden gebrouwen op basis van in de Auvergne geteelde en gemoute granen. Ze worden niet gefilterd of gepasteuriseerd."
    ]
  },
  "rdfs:label": {
