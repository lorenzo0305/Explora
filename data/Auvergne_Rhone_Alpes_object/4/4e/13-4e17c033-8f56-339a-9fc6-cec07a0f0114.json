  "rdfs:comment": {
    "de": [
      "Im gleichen Geist wie das comptoir des Dombes in Lapeyrouse wird Ihnen hier eine lokale und traditionelle Küche angeboten. Ausgewählte Produkte aus der Region, die zu 100 % hausgemacht sind."
    ],
    "ru": [
      "В том же духе, что и в comptoir des Dombes в Lapeyrouse, мы предлагаем традиционную местную кухню. Отборные местные продукты, 100% домашнего приготовления."
    ],
    "en": [
      "In the same spirit as the comptoir des Dombes in Lapeyrouse, we offer traditional local cuisine. Selected local products, 100% homemade."
    ],
    "it": [
      "Nello stesso spirito del comptoir des Dombes di Lapeyrouse, proponiamo una cucina tradizionale locale. Prodotti locali selezionati, 100% fatti in casa."
    ],
    "fr": [
      "Dans le même esprit que le comptoir des Dombes à Lapeyrouse, une cuisine locale et traditionnelle vous est proposée. Produits du terroir sélectionnés, 100% faits maison."
    ],
    "zh": [
      "我们秉承拉佩鲁兹（Lapeyrouse）Dombes 餐馆的精神，提供传统的当地美食。精选当地产品，100% 自制。"
    ],
    "nl": [
      "In dezelfde geest als het comptoir des Dombes in Lapeyrouse bieden we traditionele streekgerechten. Geselecteerde lokale producten, 100% huisgemaakt."
    ],
    "es": [
      "Con el mismo espíritu que el comptoir des Dombes de Lapeyrouse, le proponemos una cocina local tradicional. Productos locales seleccionados, 100% caseros."
    ]
  },
