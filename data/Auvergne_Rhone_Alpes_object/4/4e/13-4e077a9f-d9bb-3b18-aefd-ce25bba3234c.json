  "rdfs:comment": {
    "de": [
      "Die Grand Laval Farm ist ein kleiner Bio-Bauernhof mit Mischkulturen (Obstplantagen, Ackerbau, Viehzucht), der die Besonderheit hat, dass er das Wildleben vollständig in das Herz seines Raumes und seiner landwirtschaftlichen Praktiken integriert."
    ],
    "en": [
      "The Grand Laval farm is a small, organic, mixed farming operation (orchard, field crops, livestock) that has the particularity of fully integrating wildlife into the heart of its space and farming practices."
    ],
    "it": [
      "La fattoria Grand Laval è una piccola azienda agricola biologica mista (frutteto, seminativi, allevamento) che ha la particolarità di integrare pienamente la fauna selvatica nel cuore del suo territorio e delle sue pratiche agricole."
    ],
    "fr": [
      "La ferme de Grand Laval est une petite exploitation agricole bio en polyculture élevage (verger, grandes cultures, élevage) qui a la particularité d’intégrer pleinement la vie sauvage au cœur de son espace et des ses pratiques agricoles."
    ],
    "es": [
      "La granja Grand Laval es una pequeña explotación mixta ecológica (huerto, cultivos herbáceos, ganadería) que tiene la particularidad de integrar plenamente la fauna y la flora en el corazón de su espacio y sus prácticas agrícolas."
    ],
    "nl": [
      "De Grand Laval boerderij is een klein biologisch gemengd landbouwbedrijf (boomgaard, akkerbouwgewassen, vee) dat de bijzonderheid heeft om wilde dieren volledig te integreren in zijn omgeving en landbouwpraktijken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme du Grand Laval"
    ]
  },
