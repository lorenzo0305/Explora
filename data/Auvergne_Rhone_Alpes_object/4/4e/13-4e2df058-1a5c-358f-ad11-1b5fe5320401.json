  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser neues Lokal, das Geselligkeit und Gaumenfreuden verbindet! Profitieren Sie ab sofort von unserer Bar und unseren großzügigen Brettern. Das Restaurant bietet eine gesellige Mittagsformel mit einer einfachen und schmackhaften Familienküche."
    ],
    "en": [
      "Discover our new establishment combining conviviality and gourmet delights! Take advantage of our bar and generous platters. The restaurant offers a convivial lunchtime menu with simple, tasty home cooking."
    ],
    "it": [
      "Scoprite il nostro nuovo locale che unisce convivialità e delizie gastronomiche! Approfittate del nostro bar e dei generosi taglieri. Il ristorante offre un menù amichevole a pranzo con una cucina casalinga semplice e gustosa."
    ],
    "fr": [
      "Découvrez notre nouvel établissement alliant convivialité et gourmandise ! Profitez dès maintenant de notre bar et de nos planches généreuses. Le restaurant propose une formule du midi conviviale avec une cuisine familiale, simple et savoureuse."
    ],
    "nl": [
      "Ontdek ons nieuwe etablissement dat gezelligheid en gastronomische hoogstandjes combineert! Geniet van onze bar en royale schotels. Het restaurant biedt een vriendelijk lunchmenu met eenvoudige, smakelijke huisgemaakte gerechten."
    ],
    "es": [
      "Descubra nuestro nuevo establecimiento que combina convivencia y delicias gastronómicas Aproveche nuestro bar y nuestras generosas bandejas. El restaurante ofrece un menú de mediodía acogedor con una cocina casera, sencilla y sabrosa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atypik"
    ]
  },
