  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist froh Sie in einem gemütlichen und geselligen Umfeld zu begrüßen. Der Küchenchef bietet Ihnen eine traditionelle Lyoner Küche, zubereitet mit frischen Produkten, an, die je nach Saison variiert."
    ],
    "en": [
      "This Bouchon Lyonnais is delighted to welcome you in a warm and friendly setting. The chef proposes constantly changing traditional and Lyonnais seasonal dishes prepared using fresh products."
    ],
    "it": [
      "Questo ristorante è lieto di accoglierti in un'ambientazione accogliente e cordiale.  Lo Chef ti propone una cucina lionese tradizionale che cambia seguendo il ritmo delle stagioni a base di prodotti freschi."
    ],
    "fr": [
      "Ce bouchon lyonnais dans le deuxième arrondissement est heureux de vous accueillir dans un cadre chaleureux et convivial. Le Chef vous propose une cuisine lyonnaise de tradition évolutive en fonction des saisons avec des produits frais."
    ],
    "es": [
      "Este restaurante ofrece un entorno cálido y agradable. El chef propone una cocina lionesa de tradición evolutiva en función de la temporada y elaborada a base de productos frescos."
    ],
    "nl": [
      "Deze Lyonnaise \"bouchon\" in het tweede arrondissement heet u van harte welkom in zijn warme en vriendelijke omgeving. De chef biedt een traditionele Lyonnaise keuken die verandert met de seizoenen, met verse producten."
    ]
  },
