  "rdfs:comment": {
    "de": [
      "Unter dem Fresko der Crémolans entdecken Sie diesen gemütlichen Ort, an dem Sie sonntags brunchen oder unter der Woche eine Feinschmeckerkarte entdecken können. Wenn Sie auf der schattigen Terrasse etwas trinken wollen, erwartet Sie eine Karte mit Mocktails und anderen Köstlichkeiten."
    ],
    "en": [
      "Under the Crémolans fresco, discover this cosy place where you can brunch on Sundays or discover a gourmet menu during the week. If you come for a drink on the shady terrace, a menu of mocktails and other delights awaits you."
    ],
    "it": [
      "Sotto l'affresco di Crémolans, scoprite questo luogo accogliente dove potrete fare il brunch la domenica o scoprire un menu gourmet durante la settimana. Se venite a bere un drink sulla terrazza ombreggiata, vi aspetta un menu di mocktail e altre delizie."
    ],
    "fr": [
      "Sous la fresque des Crémolans, découvrez cet endroit cosy où vous pourrez bruncher le dimanche ou découvrir une carte gourmande en semaine. Si vous venez pour prendre un verre sur la terrasse ombragée, une carte de mocktails et autres délices vous attend."
    ],
    "nl": [
      "Ontdek onder de fresco van Crémolans deze gezellige plek waar je op zondag kunt brunchen of doordeweeks een gastronomisch menu kunt ontdekken. Als je voor een drankje op het schaduwrijke terras komt, staat er een menu met mocktails en andere lekkernijen op je te wachten."
    ],
    "es": [
      "Bajo el fresco de Crémolans, descubra este acogedor lugar donde podrá tomar el brunch los domingos o descubrir un menú gastronómico entre semana. Si viene a tomar una copa en la terraza a la sombra, le espera una carta de mocktails y otras delicias."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fresque"
    ]
  },
