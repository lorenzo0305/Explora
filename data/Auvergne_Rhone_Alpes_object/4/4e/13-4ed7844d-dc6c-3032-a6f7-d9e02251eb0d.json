  "rdfs:comment": {
    "de": [
      "Das Reitzentrum Horeseland empfängt Sie in seiner idyllischen Umgebung mit 500 Hektar Wald, von denen ein Teil als Natura 2000 eingestuft ist. Kurse, Praktika, Pensionen, Ausritte, aber auch Verkauf von Pferden."
    ],
    "en": [
      "In the heart of the Vallée d'Amby, come and discover aperfect setting, with 500 hectares of wooded land, part of which is a Natura2000 site. Lessons, hacks, sale of horses."
    ],
    "it": [
      "Il centro ippico Horeseland vi accoglie in un ambiente idilliaco, con 500 ettari di bosco, parte dei quali classificati Natura 2000. Lezioni, corsi, pensioni, passeggiate e vendita di cavalli."
    ],
    "fr": [
      "Le centre équestre Horeseland vous accueille dans son cadre idyllique, avec 500 hectares de bois dont une partie classée Natura 2000. Cours, stages, pensions, balades mais aussi vente de chevaux."
    ],
    "es": [
      "El centro ecuestre de Horeseland le da la bienvenida a su idílico entorno, con 500 hectáreas de bosque, parte del cual está clasificado Natura 2000. Clases, cursos, pensiones, paseos y venta de caballos."
    ],
    "nl": [
      "De manege Horeseland heet je welkom in zijn idyllische omgeving, met 500 hectare bos, waarvan een deel is geclassificeerd als Natura 2000. Lessen, cursussen, pensioenen, ritten en verkoop van paarden."
    ]
  },
  "rdfs:label": {
