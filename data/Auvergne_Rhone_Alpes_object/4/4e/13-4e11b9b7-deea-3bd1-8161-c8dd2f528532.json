  "rdfs:comment": {
    "de": [
      "Wir bereiten eine marktfrische und saisonale Küche in einem einzigartigen Menü zu. Das Restaurant ist nur auf Reservierung geöffnet (über die Website oder telefonisch unter 06 21 69 71 30). Wir kochen mit einem Holzofen, der sich im Saal des Restaurants befindet."
    ],
    "en": [
      "We offer seasonal, market-fresh cuisine in a unique menu. Restaurant open by reservation only (via the website or by telephone on 06 21 69 71 30). We cook with a wood-burning stove in the restaurant's dining room."
    ],
    "it": [
      "Serviamo una cucina stagionale e fresca di mercato in un menu unico. Ristorante aperto solo su prenotazione (tramite il sito web o telefonicamente al numero 06 21 69 71 30). Cuciniamo su un fornello a legna nella sala da pranzo del ristorante."
    ],
    "fr": [
      "Nous réalisons une cuisine du marché et de saison dans un menu unique. Restaurant ouvert uniquement sur réservation (via le site ou par téléphone au 06 21 69 71 30). Nous cuisinons avec une cuisinière à bois qui se trouve dans la salle du restaurant."
    ],
    "nl": [
      "We serveren seizoensgebonden, marktverse gerechten in een uniek menu. Restaurant alleen geopend op reservering (via de website of telefonisch op 06 21 69 71 30). We koken op een houtgestookt fornuis in de eetzaal van het restaurant."
    ],
    "es": [
      "Servimos cocina de temporada y de mercado en un menú único. Restaurante abierto sólo con reserva previa (a través de la página web o por teléfono al 06 21 69 71 30). Cocinamos en cocina de leña en el comedor del restaurante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les oies sauvages"
    ]
  },
