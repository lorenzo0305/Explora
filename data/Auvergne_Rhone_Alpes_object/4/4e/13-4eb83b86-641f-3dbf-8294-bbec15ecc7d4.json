  "rdfs:comment": {
    "de": [
      "Aus Liebe zu den Reben ist Pierre von einem Mischbetrieb zu einem Weingut übergegangen: AOP Saint-Joseph, Condrieu, IGP Viognier. Ein Weingut, das auf eine durchdachte Landwirtschaft mit Respekt vor dem Terroir, den Böden und den Reben ausgerichtet ist."
    ],
    "en": [
      "By love of the vine, 20 years ago, Pierre moved from the farm to the winery. Visit with tasting for groups and school groups."
    ],
    "it": [
      "Grazie al suo amore per la vite, Pierre è passato da un'attività agricola mista a un'azienda vinicola: AOP Saint-Joseph, Condrieu, IGP Viognier. L'azienda si basa su un'agricoltura sostenibile, nel rispetto del terroir, del suolo e delle viti."
    ],
    "fr": [
      "Par amour de la vigne, Pierre est passé d'une exploitation polyculture à un domaine viticole : AOP Saint-Joseph, Condrieu, IGP Viognier. Un domaine axé sur une agriculture raisonnée avec le respect du terroir, des sols et de la vigne."
    ],
    "es": [
      "Gracias a su amor por la viña, Pierre ha pasado de una explotación agrícola mixta a una explotación vitícola: AOP Saint-Joseph, Condrieu, IGP Viognier. La explotación se basa en una agricultura sostenible, respetuosa con el terruño, el suelo y las viñas."
    ],
    "nl": [
      "Door zijn liefde voor wijnstokken is Pierre van een gemengd landbouwbedrijf uitgegroeid tot een wijndomein: AOP Saint-Joseph, Condrieu, IGP Viognier. Het landgoed is gebaseerd op duurzame landbouw, met respect voor het terroir, de bodem en de wijnstokken."
    ]
  },
