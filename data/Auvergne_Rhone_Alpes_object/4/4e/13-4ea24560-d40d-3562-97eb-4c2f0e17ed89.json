  "rdfs:comment": {
    "de": [
      "Der Entspannungsgarten ist ein Ort, der dem Loslassen, dem Auftanken und der Harmonie von Körper und Geist durch Massage, Yoga und Energiebehandlungen gewidmet ist"
    ],
    "en": [
      "The relaxation garden is a space dedicated to letting go, rejuvenation and harmony of body and mind through massage, yoga and energy treatments"
    ],
    "it": [
      "Il Giardino del Relax è uno spazio dedicato al lasciarsi andare, al ringiovanimento e all'armonia del corpo e della mente attraverso massaggi, yoga e trattamenti energetici"
    ],
    "fr": [
      "Le jardin de détente est un espace dédié au lâcher prise, au ressourcement et à l’harmonie du corps et de l’esprit à travers le massage, le yoga et les soins énergétiques"
    ],
    "es": [
      "El Jardín de la Relajación es un espacio dedicado a dejarse llevar, rejuvenecer y armonizar cuerpo y mente mediante masajes, yoga y tratamientos energéticos"
    ],
    "nl": [
      "De Tuin van Ontspanning is een ruimte gewijd aan loslaten, verjonging en harmonie van lichaam en geest door middel van massage, yoga en energiebehandelingen"
    ]
  },
