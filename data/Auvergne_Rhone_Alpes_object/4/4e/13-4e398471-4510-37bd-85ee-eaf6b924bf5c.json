  "rdfs:comment": {
    "de": [
      "Hier sind Sie am Ufer der Isère.\r\nDie Isère. Sie ist es, die der Stadt ihre besondere Form verleiht und teilweise ihre Grenzen definiert."
    ],
    "en": [
      "Here you are on the banks of the Isère.\r\nThe Isère. It's the river that gives the town its distinctive shape, and partly defines its boundaries."
    ],
    "it": [
      "Eccovi sulle rive dell'Isère.\r\nL'Isère. È il fiume che dà alla città la sua forma caratteristica e ne definisce in parte i confini."
    ],
    "fr": [
      "Vous voici sur les quais de l’Isère.\r\nL’Isère. C’est elle qui donne sa forme si particulière à la Ville et qui définit en partie ses limites."
    ],
    "nl": [
      "Hier sta je aan de oever van de Isère.\r\nDe Isère. Het is de rivier die de stad haar kenmerkende vorm geeft en deels haar grenzen bepaalt."
    ],
    "es": [
      "Aquí está, a orillas del Isère.\r\nEl Isère. Es el río que da a la ciudad su forma distintiva y define en parte sus límites."
    ]
  },
  "rdfs:label": {
    "fr": [
