  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro von Valmorel und den Tälern von Aigueblanche empfängt Sie, um Sie das ganze Jahr über über alle Aktivitäten der Gegend zu informieren."
    ],
    "en": [
      "The tourist office of Valmorel and the Aigueblanche valleys welcomes you to inform you about all the activities of the area all year round."
    ],
    "it": [
      "L'ufficio turistico delle valli di Valmorel e Aigueblanche vi accoglie per informarvi su tutte le attività della zona durante tutto l'anno."
    ],
    "fr": [
      "L'office de tourisme de Valmorel et des vallées d'Aigueblanche vous accueille pour vous renseigner sur toutes les activités du territoire tout au long de l'année."
    ],
    "es": [
      "La oficina de turismo de los valles de Valmorel y Aigueblanche le da la bienvenida para informarle sobre todas las actividades de la zona durante todo el año."
    ],
    "nl": [
      "Het VVV-kantoor van Valmorel en de Aigueblanche-valleien verwelkomt u om u het hele jaar door te informeren over alle activiteiten in de omgeving."
