  "rdfs:comment": {
    "de": [
      "Im Augusta laden wir Sie ein, den Geschmack des Einzigartigen wiederzuentdecken, den Geschmack des wunderbaren Augenblicks einer Creme, die Sie umhaut, einen Duft von Brot, eine Scheibe Erdbeere, die Sie transportiert... Konzentrieren Sie sich auf das Wesentliche!!"
    ],
    "en": [
      "At Augusta, we invite you to rediscover the taste of the unique, the taste of the wonderful moment of a cream that knocks you down, a smell of bread, a slice of strawberry that transports you... Focus on the essentials!!"
    ],
    "it": [
      "Ad Augusta vi invitiamo a riscoprire il gusto dell'unico, il sapore del momento meraviglioso di una crema che vi travolge, di un profumo di pane, di una fetta di fragola che vi trasporta... Concentratevi sull'essenziale!"
    ],
    "fr": [
      "Chez Augusta, nous vous invitons à retrouver le goût de l'unique, le goût de l'instant merveilleux d'une crème qui vous renverse, d'une odeur de pain, d'une part de fraisier qui vous transporte... Se concentrer sur l'essentiel !!"
    ],
    "es": [
      "En Augusta, te invitamos a redescubrir el sabor de lo único, el sabor del momento maravilloso de una crema que te arrastra, un olor a pan, una rodaja de fresa que te transporta... ¡Concéntrese en lo esencial!"
    ],
    "nl": [
      "Bij Augusta nodigen we je uit om de smaak van het unieke te herontdekken, de smaak van het heerlijke moment van een crème die je van je voeten veegt, een geur van brood, een plakje aardbei die je meevoert... Concentreer je op wat essentieel is!"
    ]
  },
