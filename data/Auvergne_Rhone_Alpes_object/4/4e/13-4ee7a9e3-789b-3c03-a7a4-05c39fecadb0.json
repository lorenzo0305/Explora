  "rdfs:comment": {
    "de": [
      "My Beers bietet Ihnen einen Keller mit über 400 verschiedenen Flaschenbieren aus aller Welt, Fässern, Kästen und Bierzapfanlagen. Entdecken Sie eine Bar, in der das Bier König ist."
    ],
    "en": [
      "My Beers offers you a cellar with more than 400 references of bottled beers from all over the world, casks, boxes and beer tappers. Come and discover a bar where beer is queen."
    ],
    "it": [
      "My Beers vi offre una cantina con oltre 400 referenze di birre in bottiglia provenienti da tutto il mondo, fusti, casse e spillatori di birra. Venite a scoprire un bar dove la birra è il re."
    ],
    "fr": [
      "My Beers vous offre une cave de plus de 400 références de bières bouteilles du monde entier, des fûts, des coffrets et des tireuses à bière. Venez découvrir un bar où la bière est reine."
    ],
    "es": [
      "My Beers le ofrece una bodega de más de 400 referencias de cervezas embotelladas de todo el mundo, barriles, cajas y grifos de cerveza. Venga a descubrir un bar donde la cerveza es el rey."
    ],
    "nl": [
      "My Beers biedt u een kelder met meer dan 400 referenties van flessenbieren uit de hele wereld, vaten, dozen en biertaps. Kom en ontdek een bar waar bier koning is."
    ]
  },
