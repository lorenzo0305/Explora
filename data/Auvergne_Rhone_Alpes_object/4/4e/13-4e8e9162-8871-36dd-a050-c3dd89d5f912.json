  "rdfs:comment": {
    "de": [
      "Inmitten der Natur und leicht erreichbar bietet das Restaurant Colette einen erholsamen und gastronomischen Halt; auf der Terrasse oder im Saal, das sichere Versprechen eines geselligen Moments rund um raffinierte Gerichte."
    ],
    "en": [
      "In the heart of the countryside and within easy reach, the Colette restaurant offers a restful gastronomic stopover; on the terrace or in the dining room, the promise of a convivial moment around refined dishes."
    ],
    "it": [
      "Nel cuore della campagna e facilmente raggiungibile, il ristorante Colette offre una pausa di riposo e gastronomia; sulla terrazza o nella sala da pranzo, la promessa di un momento conviviale attorno a piatti raffinati."
    ],
    "fr": [
      "En pleine nature et facile d'accès, le restaurant Colette offre une halte reposante et gastronomique ; en terrasse ou en salle, la promesse assurée d'un moment convivial autour de plats raffinés."
    ],
    "nl": [
      "In het hart van het platteland en binnen handbereik biedt het restaurant Colette een rustgevende en gastronomische pauze; op het terras of in de eetzaal, de belofte van een gezellig moment rond verfijnde gerechten."
    ],
    "es": [
      "En plena naturaleza y a un paso de todo, el restaurante Colette le ofrece una pausa reposada y gastronómica; en la terraza o en el comedor, la promesa de un momento de convivencia en torno a platos refinados."
    ]
  },
