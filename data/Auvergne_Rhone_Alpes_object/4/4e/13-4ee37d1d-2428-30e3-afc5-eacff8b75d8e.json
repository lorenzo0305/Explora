  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel eines großen Parks mit Bäumen überblickt das unvergleichliche Haus den Lac du Bourget, umgeben von den Bergen. Das Haus ist epikureisch und hedonistisch. Das Gourmetrestaurant lädt dazu ein, sich mitnehmen und überraschen zu lassen..."
    ],
    "en": [
      "High in a wooded park, the L'Incomparable overlooks Lake Bourget, surrounded by mountains, in a setting dedicated to gourmet luxury. The gastronomic restaurant invites you on a journey, let yourself be surprised..."
    ],
    "it": [
      "In cima a un grande parco alberato, L'Incomparable domina il Lago del Bourget, circondato dalle montagne. La casa è epicurea, edonistica. Il ristorante gastronomico invita a lasciarsi trasportare e sorprendere...."
    ],
    "fr": [
      "Au sommet d'un grand parc arboré, l'incomparable surplombe le Lac du Bourget, entouré par les montagnes. La maison est épicurienne, hédoniste. Le restaurant gastronomique invite à se laisser transporter et surprendre..."
    ],
    "nl": [
      "Op de top van een groot bebost park, kijkt het onvergelijkbare huis uit over het Lac du Bourget, omgeven door de bergen. Het huis is epicuristisch, hedonistisch. Het gastronomische restaurant nodigt u uit om u te laten vervoeren en verrassen..."
    ],
    "es": [
      "En lo alto de un gran parque arbolado, la incomparable casa domina el lago del Bourget, rodeado de montañas. La casa es epicúrea, hedonista. El restaurante gastronómico le invita a dejarse transportar y sorprender..."
    ]
  },
