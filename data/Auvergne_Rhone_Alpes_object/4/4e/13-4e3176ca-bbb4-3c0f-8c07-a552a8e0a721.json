  "rdfs:comment": {
    "de": [
      "Mit seinen 52 m Höhe lädt Sie der höchste Bergfried Frankreichs ein, 900 Jahre Geschichte zu erleben: ein mittelalterlicher Bergfried (12.-15. Jh.), der später zum Gefängnisturm (15.-19. Jh.) wurde. Verpassen Sie nicht die historischen Rekonstruktionen und das herrliche Panorama."
    ],
    "en": [
      "The Crest tower stands proudly at the door of the Vercors. The highest medieval tower in France (52m) offers her history and a striking view of the Drôme Valley."
    ],
    "it": [
      "Dall'alto dei suoi 52 metri, il più alto sotterraneo di Francia vi invita a rivivere 900 anni di storia: un sotterraneo medievale (XII-XV secolo), divenuto poi una torre-prigione (XV-XIX secolo). Da non perdere: ricostruzioni storiche e un magnifico panorama."
    ],
    "fr": [
      "Du haut de ses 52 m, le plus haut donjon de France vous invite à revivre 900 ans d'histoire : un donjon médiéval (XIIe-XVe), devenu ensuite Tour prison (XVe-XIXe). À ne pas manquer : reconstitutions historiques et magnifique panorama."
    ],
    "es": [
      "Desde lo alto de sus 52 m, la mazmorra más alta de Francia le invita a revivir 900 años de historia: una mazmorra medieval (siglos XII-XV), que más tarde se convirtió en una torre prisión (siglos XV-XIX). No te pierdas: reconstrucciones históricas y un magnífico panorama."
    ],
    "nl": [
      "De hoogste donjon in Frankrijk, met 52 m, nodigt u uit om 900 jaar geschiedenis te herbeleven: een middeleeuwse donjon (12e-15e eeuw), die later als gevangenistoren (15e-19e eeuw) wordt gebruikt. Wat u ook niet mag missen: originele muuropschriften en een prachtig panorama."
    ]
  },
