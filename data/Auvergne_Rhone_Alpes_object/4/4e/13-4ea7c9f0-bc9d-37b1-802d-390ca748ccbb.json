  "rdfs:comment": {
    "de": [
      "Autonomer Bauernhof, Anbau von aromatischen und medizinischen Pflanzen, die mit tierischem Antrieb mit dem Esel Chausset' und dem Maultier Anatole bearbeitet werden. Direktverkauf ab Hof: ätherische Öle, Blütenwasser, Ölmazerate, Kräutertees, Aromaten, Kräuter der Provence."
    ],
    "en": [
      "Autonomous farm, cultivation of aromatic and medicinal plants using animal traction with the donkey Chausset' and the mule Anatole. Direct farm sales: essential oils, floral waters, oily macerates, herbal teas, aromatics, Provencal herbs."
    ],
    "it": [
      "Azienda agricola autonoma, coltivazione di piante aromatiche e medicinali a trazione animale con l'asino Chausset' e il mulo Anatole. Vendita diretta in azienda: oli essenziali, acque floreali, macerati oleosi, tisane, erbe di Provenza"
    ],
    "fr": [
      "Ferme autonome, cultures de plantes aromatiques et médicinales travaillées en traction animale avec l'âne Chausset' et le mulet Anatole. Vente directe à la ferme : huiles essentielles, eaux florales, macérats huileux, tisanes, aromates, herbes de provence"
    ],
    "nl": [
      "Zelfvoorzienende boerderij, waar aromatische en geneeskrachtige planten worden geteeld met behulp van dierlijke tractie met de ezel Chausset' en de muilezel Anatole. Directe verkoop vanaf de boerderij: etherische oliën, bloemenwaters, olieachtige maceraten, kruidenthee, aromaten, Provençaalse kruiden, enz."
    ],
    "es": [
      "Granja autónoma, cultivo de plantas aromáticas y medicinales con tracción animal con el burro Chausset' y la mula Anatole. Venta directa en la explotación: aceites esenciales, aguas florales, macerados oleosos, tisanas, hierbas de Provenza"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mulâne 26"
    ]
  },
