  "rdfs:comment": {
    "de": [
      "BRestaurant-Boutique der Domaine du Colombier, untergebracht in der ehemaligen Gendarmerie von Bourg-Saint-Andéol. Authentische und verantwortungsbewusste Küche der Ardèche, gesellige Atmosphäre und elegant renoviertes Ambiente."
    ],
    "en": [
      "Domaine du Colombier restaurant-boutique in the former gendarmerie in Bourg-Saint-Andéol. Authentic, responsible Ardéchois cuisine, friendly atmosphere and elegantly renovated surroundings."
    ],
    "it": [
      "Ristorante di charme nel Domaine du Colombier, ospitato nell'ex gendarmeria di Bourg-Saint-Andéol. Cucina autentica e responsabile dell'Ardèche, atmosfera accogliente e ambiente elegantemente rinnovato."
    ],
    "fr": [
      "Restaurant-boutique du Domaine du Colombier, installé dans l’ancienne gendarmerie de Bourg-Saint-Andéol. Cuisine ardéchoise authentique et responsable, atmosphère conviviale et cadre rénové avec élégance."
    ],
    "es": [
      "Restaurante boutique en el Domaine du Colombier, ubicado en la antigua gendarmería de Bourg-Saint-Andéol. Una cocina de Ardèche auténtica y responsable, un ambiente acogedor y un entorno elegantemente renovado."
    ],
    "nl": [
      "Boutique restaurant in het Domaine du Colombier, gehuisvest in de voormalige gendarmerie in Bourg-Saint-Andéol. Authentieke, verantwoorde keuken uit de Ardèche, een vriendelijke sfeer en een elegant gerenoveerd decor."
    ]
  },
