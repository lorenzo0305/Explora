  "rdfs:comment": {
    "de": [
      "Les Deux Têtes, das ist schon ein Berg!\r\nEin außergewöhnliches Panorama zwischen dem Mont Blanc und Lauzière bietet sich den Kletterern, die sich die Mühe gemacht haben, bis hierher zu kommen."
    ],
    "en": [
      "Les Deux Têtes is already a mountain!\r\nAn exceptional panorama between Mont Blanc and Lauzière awaits climbers who have taken the trouble to get here."
    ],
    "it": [
      "Les Deux Têtes è già la montagna!\r\nUn panorama eccezionale tra il Monte Bianco e la Lauzière è offerto agli scalatori che si sono presi la briga di venire qui."
    ],
    "fr": [
      "Les Deux Têtes, c'est déjà la montagne! \r\nUn panorama exceptionnel entre le Mont Blanc et  Lauzière s'offre aux grimpeurs qui se sont donnés la peine de venir jusqu'ici."
    ],
    "es": [
      "¡Les Deux Têtes ya es la montaña!\r\nUn panorama excepcional entre el Mont Blanc y la Lauzière se ofrece a los escaladores que se han tomado la molestia de venir hasta aquí."
    ],
    "nl": [
      "Les Deux Têtes is al de berg!\r\nEen uitzonderlijk panorama tussen de Mont Blanc en de Lauzière wordt geboden aan klimmers die de moeite hebben genomen om hierheen te komen."
    ]
  },
  "rdfs:label": {
    "en": [
      "2 têtes climbing route"
    ],
    "fr": [
      "Voie d'escalade des 2 têtes"
    ]
  },
