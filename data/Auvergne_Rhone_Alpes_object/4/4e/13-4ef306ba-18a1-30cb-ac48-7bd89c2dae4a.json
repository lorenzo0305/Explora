  "rdfs:comment": {
    "de": [
      "Yogaunterricht: Gruppenkurse und Einzelunterricht.\n\nAyurvedische Massagepraktikerin: Begleitung zu einem körperlichen, emotionalen und psychischen Gleichgewicht durch Massage und den ayurvedischen und energetischen Ansatz."
    ],
    "en": [
      "Yoga teaching: group and private classes.\r\n\r\nAyurvedic massage practitioner: accompaniment towards physical, emotional and psychic balance through massage and the art of Ayurveda."
    ],
    "it": [
      "Insegnamento dello yoga: lezioni di gruppo e private.\n\nOperatore di massaggio ayurvedico: accompagnamento verso l'equilibrio fisico, emotivo e psicologico attraverso il massaggio e un approccio ayurvedico ed energetico."
    ],
    "fr": [
      "Enseignement de Yoga : cours collectifs et cours particuliers. \n\nPraticienne en massages Ayurvédiques : accompagnement vers un équilibre physique, émotionnel et psychique par le massage et l'approche ayurvedique et énergétique."
    ],
    "nl": [
      "Yogalessen: groeps- en privélessen.\n\nAyurvedisch massagetherapeut: begeleiding naar fysiek, emotioneel en psychisch evenwicht door massage en een Ayurvedische en energetische benadering."
    ],
    "es": [
      "Enseñanza de yoga: clases en grupo y particulares.\n\nMasajista ayurvédico: acompañamiento hacia el equilibrio físico, emocional y psicológico a través del masaje y de un enfoque ayurvédico y energético."
    ]
  },
  "rdfs:label": {
    "en": [
      "Inhale... Exhale... Yoga teaching and Ayurvedic massages"
    ],
    "it": [
      "Inspirare... Espirare... Insegnamento di massaggi yoga e ayurvedici"
    ],
    "fr": [
      "Inhale... Exhale... Enseignement du Yoga et Massages Ayurvédiques"
    ]
  },
