  "rdfs:comment": {
    "de": [
      "Peer Gynt ist eine der bekanntesten symphonischen Suiten des klassischen Repertoires. Der große Erfolg dieser Melodien entschied ihren Komponisten, den Norweger Edvard Grieg, dazu, Transkriptionen für Klavier solo anzufertigen."
    ],
    "en": [
      "Peer Gynt is one of the best-known symphonic suites in the classical repertoire. The immense success of these melodies led its composer, the Norwegian Edvard Grieg, to make transcriptions for solo piano."
    ],
    "it": [
      "Peer Gynt è una delle suite sinfoniche più conosciute del repertorio classico. L'immenso successo di queste melodie spinse il suo compositore, il norvegese Edvard Grieg, a farne delle trascrizioni per pianoforte solo."
    ],
    "fr": [
      "Peer Gynt est une des suites symphoniques les plus connues du répertoire classique. L'immense succès de ces mélodies décidera son compositeur, le norvégien Edvard Grieg, à en faire des transcriptions pour piano seul."
    ],
    "nl": [
      "Peer Gynt is een van de bekendste symfonische suites uit het klassieke repertoire. Het immense succes van deze melodieën bracht de componist, de Noor Edvard Grieg, ertoe om transcripties te maken voor piano solo."
    ],
    "es": [
      "Peer Gynt es una de las suites sinfónicas más conocidas del repertorio clásico. El inmenso éxito de estas melodías llevó a su compositor, el noruego Edvard Grieg, a realizar transcripciones para piano solo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Christophe Petit joue Peer Gynt"
    ]
  },
