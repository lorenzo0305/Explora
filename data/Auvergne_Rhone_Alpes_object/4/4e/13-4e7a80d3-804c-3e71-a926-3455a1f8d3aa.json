  "rdfs:comment": {
    "de": [
      "Im Freizeitpark Vallée Bleue, nur 45 Minuten von Lyon entfernt, bietet Espace Aventure Outdoor-Aktivitäten für alle: Baumwipfelpfade, Kajakfahren, Stand-Up-Paddling und Tretboote. Ein idealer Ort für Familien, Gruppen und Naturliebhaber."
    ],
    "en": [
      "Located at the Vallée Bleue Leisure Park, 45 minutes from Lyon, Espace Aventure offers outdoor activities accessible to all: treetop adventure courses, kayaking, paddleboarding, and pedal boats. An ideal site for families, groups, and nature lovers."
    ],
    "it": [
      "Situato nel parco divertimenti Vallée Bleue, a 45 minuti da Lione, l'Espace Aventure offre attività all'aria aperta accessibili a tutti, tra cui arrampicata sugli alberi, kayak, paddle boarding e pedalò. Un sito ideale per famiglie, gruppi e amanti della natura."
    ],
    "fr": [
      "Situé sur la Base de Loisirs de la Vallée Bleue, à 45 minutes de Lyon, l'Espace Aventure propose des activités de plein air accessibles à tous : accrobranche, kayak, paddle ou encore pédalo. Un site idéal pour les familles, groupes et amateurs de nature."
    ],
    "es": [
      "Situado en el parque de ocio Vallée Bleue, a 45 minutos de Lyon, Espace Aventure ofrece actividades al aire libre accesibles a todos, como escalada de árboles, kayak, paddle boarding y barca a pedales. Un sitio ideal para familias, grupos y amantes de la naturaleza."
    ],
    "nl": [
      "Espace Aventure ligt in het recreatiepark Vallée Bleue, op 45 minuten van Lyon, en biedt buitenactiviteiten die voor iedereen toegankelijk zijn, zoals boomklimmen, kajakken, paddleboarden en waterfietsen. Een ideale plek voor gezinnen, groepen en natuurliefhebbers."
    ]
  },
  "rdfs:label": {
    "de": [
      "Abenteuerpark im Vallée Bleue"
    ],
    "en": [
      "Vallée Bleue Adventure Centre"
    ],
    "fr": [
      "Espace Aventure de la Vallée Bleue"
    ]
  },
