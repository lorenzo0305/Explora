  "rdfs:comment": {
    "de": [
      "Unser Restaurant-Pizzéria liegt im Herzen des Dorfes und bietet Ihnen eine Auswahl an hausgemachten Gerichten und Pizzen zum Verzehr vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Located in the heart of the village, our Restaurant-Pizzeria offers a range of dishes and homemade pizzas, to eat in or take away."
    ],
    "it": [
      "Situato nel cuore del villaggio, il nostro ristorante-pizzeria offre una gamma di piatti e pizze fatti in casa, da mangiare o da portare via."
    ],
    "fr": [
      "Situé au cœur du village, notre Restaurant-Pizzéria vous propose une gamme de plats et pizzas faits maison, à consommer sur place ou à emporter."
    ],
    "es": [
      "Situado en el corazón del pueblo, nuestro Restaurante-Pizzería ofrece una gran variedad de platos caseros y pizzas, para comer en casa o para llevar."
    ],
    "nl": [
      "Gelegen in het hart van het dorp, biedt ons Restaurant-Pizzeria een scala aan huisgemaakte gerechten en pizza's, om te eten of mee te nemen."
    ]
  },
  "rdfs:label": {
