  "rdfs:comment": {
    "de": [
      "20 Jahre nach der Veröffentlichung von \"Le Chemin\", der ersten Singleauskopplung aus dem gleichnamigen Album, wird die Band KYO dieses Jubiläum auf ihrer 20-Jahre-Tour live feiern."
    ],
    "en": [
      "20 years after unveiling \"Le Chemin\", the first single from their album of the same name, KYO will be celebrating this anniversary on stage during their 20th anniversary tour."
    ],
    "it": [
      "20 anni dopo aver presentato il brano \"Le Chemin\", primo singolo estratto dall'omonimo album, i KYO celebreranno questo anniversario sul palco durante il loro tour del ventennale."
    ],
    "fr": [
      "20 ans après avoir dévoilé le titre « Le Chemin », premier extrait de l’album du même nom, le groupe KYO partira célébrer sur scène cet anniversaire lors de la tournée des 20 ans."
    ],
    "nl": [
      "20 jaar na de onthulling van het nummer \"Le Chemin\", de eerste single van het gelijknamige album, viert KYO dit jubileum op het podium tijdens hun 20-jarige jubileumtournee."
    ],
    "es": [
      "20 años después de presentar el tema \"Le Chemin\", primer sencillo del álbum homónimo, KYO celebrará este aniversario sobre el escenario durante su gira 20 aniversario."
    ]
  },
