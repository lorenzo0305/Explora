  "rdfs:comment": {
    "de": [
      "In einer Cocooning-Atmosphäre, die Wohlbefinden und Schönheit miteinander verbindet, nimmt Sie das Spa Les Oliviers mit auf eine Reise, die von rhythmischen Behandlungen und Massagen geprägt ist, die von den Ritualen der Welt inspiriert sind."
    ],
    "en": [
      "In a cocooning atmosphere that combines well-being and beauty, the Spa Les Oliviers takes you on a journey punctuated by treatments and massages, inspired by rituals from around the world."
    ],
    "it": [
      "In un'atmosfera avvolgente che unisce benessere e bellezza, la Spa Les Oliviers vi accompagna in un viaggio di trattamenti e massaggi ispirati ai rituali di tutto il mondo."
    ],
    "fr": [
      "Dans une ambiance cocooning qui mêle bien-être et beauté, le Spa Les Oliviers vous emmène dans un voyage rythmé de soins et massages, inspirés des rituels du monde."
    ],
    "nl": [
      "In een cocooning sfeer die welzijn en schoonheid combineert, neemt Spa Les Oliviers je mee op een reis van behandelingen en massages geïnspireerd door rituelen uit de hele wereld."
    ],
    "es": [
      "En un ambiente envolvente que combina bienestar y belleza, el Spa Les Oliviers le invita a un viaje de tratamientos y masajes inspirados en rituales de todo el mundo."
    ]
  },
