  "rdfs:comment": {
    "de": [
      "Ein schöner Rundweg, der Sie über die Hänge führt, um das Schloss von Goutelas und das Schloss Ste-Anne zu entdecken, bevor Sie wieder auf den Gipfel von Montverdun hinabsteigen und entlang des Lignon nach La Bâtie d'Urfé weitergehen."
    ],
    "en": [
      "A lovely circuit that takes you up the hills to discover the Château de Goutelas and the Château Ste-Anne, before descending to the Pic de Montverdun and continuing along the Lignon to reach La Bâtie d'Urfé."
    ],
    "it": [
      "Questo suggestivo percorso vi porta in collina alla scoperta dello Château de Goutelas e dello Château Ste-Anne, prima di scendere verso la cima del Montverdun e proseguire lungo il Lignon per raggiungere La Bâtie d'Urfé."
    ],
    "fr": [
      "Un joli circuit qui vous entraîne sur les coteaux à la découverte du château de Goutelas et du château Ste-Anne, avant de redescendre sur le pic de Montverdun et de poursuivre en longeant le Lignon pour rejoindre la Bâtie d'Urfé."
    ],
    "es": [
      "Este atractivo sendero le llevará por las colinas para descubrir el Castillo de Goutelas y el Castillo Ste-Anne, antes de descender al pico de Montverdun y continuar por el Lignon hasta llegar a La Bâtie d'Urfé."
    ],
    "nl": [
      "Deze aantrekkelijke route neemt je mee de heuvels op om het Château de Goutelas en het Château Ste-Anne te ontdekken, voordat je afdaalt naar de top van de Montverdun en verder gaat langs de Lignon om La Bâtie d'Urfé te bereiken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vignoble et patrimoine - Boucle LF 3"
    ]
  },
