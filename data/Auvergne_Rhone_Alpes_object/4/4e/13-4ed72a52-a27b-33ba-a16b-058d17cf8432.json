  "rdfs:comment": {
    "de": [
      "Sehr schöne Wanderung auf dem Massif du Margériaz. Der Mont Blanc ist zum Greifen nah! Die Hauptgipfel der Bauges enthüllen sich vor Ihnen, ebenso wie die Belledonne-Kette und nicht zu vergessen die Massive der Chartreuse und der Vanoise."
    ],
    "en": [
      "A beautiful hike through Le Massif du Margériaz with Mont Blanc just a stone's throw away! Along the way, you will see all the major peaks in Les Bauges, as well as getting a good look at the Belledonne, La Chartreuse and La Vanoise ranges."
    ],
    "it": [
      "Escursione molto bella sul massiccio del Margériaz. Il Monte Bianco è a portata di mano! Le principali cime delle Bauges si rivelano davanti a voi, così come la catena di Belledonne, senza dimenticare i massicci della Chartreuse e della Vanoise."
    ],
    "fr": [
      "Très belle randonnée sur le Massif du Margériaz. Le Mont Blanc est à portée de main ! Les principaux sommets des Bauges se dévoilent devant vous, ainsi que la chaîne de Belledonne, sans oublier les massifs de la Chartreuse et de la Vanoise."
    ],
    "nl": [
      "Zeer mooie wandeling op het massief van Margériaz. De Mont Blanc is binnen handbereik! De belangrijkste toppen van de Bauges liggen voor u, evenals de keten van Belledonne, zonder het massief van de Chartreuse en de Vanoise te vergeten."
    ],
    "es": [
      "Muy bonita excursión por el macizo del Margériaz. El Mont Blanc está al alcance de la mano Los principales picos de las Bauges se revelan ante usted, así como la cadena de la Belledonne, sin olvidar los macizos de la Chartreuse y la Vanoise."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski mountaineering route \"Les Crêtes\""
    ],
    "fr": [
      "Itinéraire balisé de ski de randonnée \"Les Crêtes\""
    ]
  },
