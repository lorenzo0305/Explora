  "rdfs:comment": {
    "de": [
      "Assoziative Spielbar, geöffnet von Mittwoch bis Sonntag.\r\nMehr als 200 Spiele stehen zur Verfügung.\r\nGetränke und kleine Snacks.\r\nDie Spielbar ist nicht geöffnet, wenn abends Konzerte oder Aufführungen geplant sind."
    ],
    "en": [
      "Community games bar open from Wednesday to Sunday.\r\nMore than 200 games available.\r\nDrink and light meals.\r\nThe games bar will not be open when concerts or shows are planned in the evening."
    ],
    "it": [
      "Bar dei giochi aperto dal mercoledì alla domenica.\r\nOltre 200 giochi disponibili.\r\nBevande e snack.\r\nIl bar giochi non sarà aperto quando la sera sono previsti concerti o spettacoli."
    ],
    "fr": [
      "Bar à jeux associatif ouvert du mercredi au dimanche.\r\nPlus de 200 jeux à disposition. \r\nBoisson et petite restauration.\r\nLe bar à jeux ne sera pas ouvert lorsque des concerts ou spectacles sont prévus le soir."
    ],
    "nl": [
      "Spelletjesbar open van woensdag tot zondag.\r\nMeer dan 200 spellen beschikbaar.\r\nDrankjes en snacks.\r\nDe spelletjesbar is niet open als er 's avonds concerten of shows zijn."
    ],
    "es": [
      "Bar de juegos abierto de miércoles a domingo.\r\nMás de 200 juegos disponibles.\r\nBebidas y aperitivos.\r\nEl bar de juegos no estará abierto cuando haya conciertos o espectáculos programados por la noche."
    ]
  },
