  "rdfs:comment": {
    "de": [
      "Traditionelles und gemütliches Restaurant mit Spezialitäten der Côte d'Opale, die es am Wochenende zu entdecken gilt, sowie einer Plus-Karte mit großen Klassikern. Mutter und Töchter freuen sich, Sie hier begrüßen zu dürfen."
    ],
    "en": [
      "Discover at the weekend this traditional, friendly restaurant with specialities from la Côte d'Opale offering entertainement once a month."
    ],
    "it": [
      "Un ristorante tradizionale e accogliente, con specialità della Côte d'Opale da scoprire nel fine settimana, oltre a un menu \"plus\" con grandi classici. Madre e figlia sono liete di accogliervi."
    ],
    "fr": [
      "Restaurant traditionnel et convivial, avec des spécialités de la Côte d'Opale à découvrir le week-end ainsi qu'une carte plus avec de grands classiques, Mère et filles ont le plaisir de vous y accueillir."
    ],
    "es": [
      "Un restaurante tradicional y acogedor, con especialidades de la Côte d'Opale para descubrir los fines de semana, así como un menú \"plus\" con grandes clásicos. Madre e hija estarán encantadas de recibirle."
    ],
    "nl": [
      "Een traditioneel en gezellig restaurant, met specialiteiten uit de Côte d'Opale om te ontdekken in het weekend, maar ook een \"plus\" menu met grote klassiekers. Moeder en dochter heten u van harte welkom."
    ]
  },
