  "rdfs:comment": {
    "de": [
      "Bei dieser Veranstaltung werden zwei Naturläufe auf Waldwegen und Halden angeboten: eine 16 km lange Strecke mit einem positiven Höhenunterschied von 162 m und eine 8 km lange Strecke mit 93 m Höhenunterschied."
    ],
    "en": [
      "This event features two nature races on forest paths and slag heaps: a 16km course with a 162m elevation gain, and an 8km course with a 93m elevation gain."
    ],
    "it": [
      "L'evento prevede due gare naturalistiche su sentieri forestali e cumuli di scorie: un percorso di 16 km con una pendenza positiva di 162 m e un percorso di 8 km con una pendenza di 93 m."
    ],
    "fr": [
      "Cet événement propose deux courses nature sur chemins en forêt et terrils : un parcours de 16 km avec un dénivelé positif de 162 m, et un autre de 8 km avec 93 m de dénivelé."
    ],
    "es": [
      "Este evento presenta dos carreras naturales por caminos forestales y escombreras: un recorrido de 16 km con una pendiente positiva de 162 m, y un recorrido de 8 km con una pendiente de 93 m."
    ],
    "nl": [
      "Dit evenement bestaat uit twee natuurraces over bospaden en terrils: een parcours van 16 km met een positieve helling van 162 m en een parcours van 8 km met een helling van 93 m."
    ]
  },
