  "rdfs:comment": {
    "de": [
      "Die Nouveaux Jardins de la Solidarité beschäftigen ca. 30 Integrationshelfer in den Bereichen Bio-Gemüseanbau, Grünflächen, Gartenbau und Baumschule. Verkauf von Gemüsekörben, kleiner Markt vor Ort, Setzlinge im Frühjahr ..."
    ],
    "en": [
      "Les Nouveaux Jardins de la Solidarité employs around 30 people on subsidized employment contracts in organic market gardening, green spaces, horticulture and nursery. Sale of vegetable baskets, small on-site market, spring planting, etc."
    ],
    "it": [
      "Les Nouveaux Jardins de la Solidarité impiega una trentina di persone in programmi di integrazione sociale nel settore dell'orticoltura biologica, degli spazi verdi, dell'orticoltura e del vivaismo. Vendita di cesti di verdure, piccolo mercato in loco, piantine in primavera..."
    ],
    "fr": [
      "Les Nouveaux Jardins de la Solidarité emploient une trentaine de salariés en insertion sur des activités de maraîchage bio, espaces verts, horticulture et pépinière. Vente de paniers de légumes, petit marché sur place, plants au printemps ..."
    ],
    "nl": [
      "Les Nouveaux Jardins de la Solidarité stelt een dertigtal mensen te werk in het kader van sociale integratie in biologische tuinbouw, groenteteelt, tuinbouw en boomkwekerij. Verkoop van groentemanden, kleine markt ter plaatse, zaailingen in de lente..."
    ],
    "es": [
      "Les Nouveaux Jardins de la Solidarité emplea a una treintena de personas en régimen de inserción social en horticultura ecológica, espacios verdes, horticultura y vivero de árboles. Venta de cestas de verduras, pequeño mercado in situ, plantones en primavera..."
    ]
  },
  "rdfs:label": {
