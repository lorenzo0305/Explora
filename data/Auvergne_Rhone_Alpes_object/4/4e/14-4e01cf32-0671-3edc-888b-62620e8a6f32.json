  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d3f007cc-94fc-3b3f-930c-fdf7f727154b",
      "dc:description": {
        "de": [
          "KOMM UND MACH DEINEN FILM\nWorkshop zur Erstellung eines Kurzfilms zum Thema Frauen\nMit dem Regisseur David Ferré und Cécile Jarsaillon vom 11. bis 15.3\nvon 10.00 bis 12.00 Uhr und von 14.30 bis 16.30 Uhr\nVorführung von Kurzfilmen und deines Films am Samstag, den 16. März um 15.00 Uhr in der Mediathek während des Kreativfrühlings\nKostenlos offen für alle"
        ],
        "en": [
          "COME AND MAKE YOUR OWN FILM\nWorkshop to create a short film on the theme of women\nWith director David Ferré and Cécile Jarsaillon March 11 to 15\nfrom 10:00 to 12:00 and from 14:30 to 16:30\nScreening of short films and your film Saturday March 16 at 3:00 pm at the media library during the Printemps des créatives event\nFree, open to all"
        ],
        "it": [
          "VIENI A FARE IL TUO FILM\nWorkshop per creare un cortometraggio sul tema delle donne\nCon il regista David Ferré e Cécile Jarsaillon dall'11 al 15 marzo\ndalle 10.00 alle 12.00 e dalle 14.30 alle 16.30\nProiezione dei cortometraggi e del vostro film sabato 16 marzo alle 15.00 presso la biblioteca multimediale durante il festival Printemps des créatives\nGratuito e aperto a tutti"
        ],
        "fr": [
          "VIENS FAIRE TON FILM\nAtelier de création d'un court métrage sur le thème des femmes\nAvec le réalisateur David Ferré et Cécile Jarsaillon du 11 au 15 Mars \nde 10h00 à 12h00 et de 14h30 à 16h30\nProjection de courts métrages et de ton film samedi 16 mars à 15h00 à la médiathèque pendant le Printemps des créatives\nGratuit ouvert à tous"
        ],
        "es": [
          "VEN A HACER TU PELÍCULA\nTaller para crear un cortometraje sobre el tema de la mujer\nCon el director David Ferré y Cécile Jarsaillon del 11 al 15 de marzo\nde 10.00 a 12.00 h y de 14.30 a 16.30 h\nProyección de cortometrajes y de su película el sábado 16 de marzo a las 15.00 h en la mediateca durante el festival Printemps des créatives\nGratuito y abierto a todos"
        ],
        "nl": [
          "KOM EN MAAK JE FILM\nWorkshop korte film over vrouwen\nMet regisseur David Ferré en Cécile Jarsaillon van 11 tot 15 maart\n10.00 tot 12.00 uur en 14.30 tot 16.30 uur\nVertoning van korte films en jouw film op zaterdag 16 maart om 15.00 uur in de mediatheek tijdens het Printemps des créatives festival\nGratis toegankelijk voor iedereen"
        ]
      },
