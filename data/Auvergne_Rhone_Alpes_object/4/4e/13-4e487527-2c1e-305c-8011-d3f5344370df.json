  "rdfs:comment": {
    "de": [
      "Die Ski- und Snowboardschule Oxyski (Starski), die sich in Le Chinaillon befindet, bietet Ihnen Ski- und Snowboardkurse, privat oder in der Gruppe, für Groß und Klein. Entdecken Sie Le Grand Bornand auf andere Weise, indem Sie sich im Speed Riding oder auch im Paragliding versuchen."
    ],
    "en": [
      "Oxyski (Starski) offers group lessons for adults and children in small groups for a more personalised experience. You can also book private lessons and guiding with our passionate and knowledgeable instructors for a more bespoke experience. Do you want to experience something new? Join us for a speedriding or paragliding session."
    ],
    "it": [
      "La scuola di sci e snowboard Oxyski (Starski) di Le Chinaillon offre lezioni private e di gruppo di sci e snowboard per grandi e piccini. Scoprite Le Grand Bornand in modo diverso, cimentandovi nello Speed Riding o nel parapendio."
    ],
    "fr": [
      "L'école de ski & snowboard Oxyski (Starski), située au Chinaillon vous propose des cours de ski et snowboard, privés ou collectifs, pour petits et grands. Découvrez le Grand Bornand autrement, en vous essayant au Speed Riding ou encore en parapente."
    ],
    "es": [
      "La escuela de esquí y snowboard Oxyski (Starski) de Le Chinaillon ofrece clases particulares y en grupo de esquí y snowboard para jóvenes y mayores. Descubra Le Grand Bornand de una forma diferente, probando el Speed Riding o el parapente."
    ],
    "nl": [
      "De Oxyski (Starski) ski- en snowboardschool in Le Chinaillon biedt privé- en groepslessen skiën en snowboarden voor jong en oud. Ontdek Le Grand Bornand op een andere manier door Speed Riding of paragliding te proberen."
    ]
  },
