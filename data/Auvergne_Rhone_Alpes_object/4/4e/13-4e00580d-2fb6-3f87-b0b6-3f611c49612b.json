  "rdfs:comment": {
    "de": [
      "Eine 1,5-stündige Wanderung von 5 km, 10 km hin und zurück im Herzen des Jauron-Tals, die in Espirat beginnt. Die offene Strecke bietet sehr schöne Ausblicke auf die umliegende Landschaft mit den alten vulkanischen Puys von Courcourt, Pileyre oder Turluron."
    ],
    "en": [
      "A 1 hr 30 min, 5 km, 10 km return walk in the heart of the Jauron valley, starting from Espirat. The open route offers beautiful views over the surrounding countryside, with the ancient volcanic puys of Courcourt, Pileyre and Turluron."
    ],
    "it": [
      "Una passeggiata di 1,5 ore e 5 km (10 km andata e ritorno) nel cuore della valle del Jauron, partendo da Espirat. Il percorso aperto offre splendidi panorami sulla campagna circostante e sulle antiche puys vulcaniche di Courcourt, Pileyre e Turluron."
    ],
    "fr": [
      "Une balade d'1 h 30 de 5 km, 10 km A/R au cœur de la vallée du Jauron au départ d'Espirat. Le parcours dégagé offre de très belles vues sur la campagne environnante avec les anciens puys volcaniques de Courcourt, du Pileyre ou du Turluron."
    ],
    "nl": [
      "Een 1,5 uur durende wandeling van 5 km (10 km heen en terug) in het hart van de Jauron vallei, met vertrek in Espirat. De open route biedt prachtige uitzichten op het omringende landschap en de oude vulkanische ruïnes van Courcourt, Pileyre en Turluron."
    ],
    "es": [
      "Caminata de 1,5 horas y 5 km (10 km ida y vuelta) en el corazón del valle de Jauron, partiendo de Espirat. La ruta abierta ofrece hermosas vistas de los alrededores y de los antiguos puys volcánicos de Courcourt, Pileyre y Turluron."
    ]
  },
  "rdfs:label": {
    "fr": [
