  "rdfs:comment": {
    "de": [
      "Willkommen in der einzigartigen Welt von zwei Juweliersammlern!\r\nZwischen Kunst und Handwerk bietet Ihnen das Haus Taillandier eine originelle und exklusive Entdeckung eines unbekannten Know-hows."
    ],
    "en": [
      "Welcome to the unique world of two jewellery collectors!\r\nBetween art and craftsmanship, Taillandier offers you an original and exclusive discovery of little-known know-how."
    ],
    "it": [
      "Benvenuti nel mondo unico di due collezionisti di gioielli!\r\nA metà strada tra arte e artigianato, Taillandier vi propone una scoperta originale ed esclusiva di un know-how poco conosciuto."
    ],
    "fr": [
      "Bienvenue dans l’univers singulier de deux joailliers collectionneurs !\r\nEntre art et artisanat la maison Taillandier vous propose une découverte originale et exclusive d’un savoir-faire méconnu."
    ],
    "es": [
      "¡Bienvenido al mundo único de dos coleccionistas de joyas!\r\nA medio camino entre el arte y la artesanía, Taillandier le propone un descubrimiento original y exclusivo de un saber hacer poco conocido."
    ],
    "nl": [
      "Welkom in de unieke wereld van twee juwelenverzamelaars!\r\nErgens tussen kunst en vakmanschap biedt Taillandier je een originele en exclusieve ontdekking van weinig bekende knowhow."
    ]
  },
