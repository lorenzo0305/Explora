  "rdfs:comment": {
    "de": [
      "Restaurant rund um die afrikanische und karibische Küche geöffnet von 18:00 bis 1:00 Uhr von Mittwoch- bis Samstagabend. Rumbar mit einer originellen Auswahl an Cocktails. Jeden Freitag- und Samstagabend wird ein Afro-Gericht angeboten. Stimmungsvolle Musik und Gesellschaftsspiele."
    ],
    "en": [
      "African and West Indian cuisine open from 6pm to 1am Wednesday to Saturday evenings. Rum bar with an original choice of cocktails. Every Friday and Saturday evening, an Afro dish is offered. Background music and board games."
    ],
    "it": [
      "Cucina africana e indiana occidentale aperta dalle 18.00 all'1.00, dal mercoledì al sabato sera. Rum bar con un'originale scelta di cocktail. Ogni venerdì e sabato sera viene servito un piatto afro. Musica di sottofondo e giochi da tavolo."
    ],
    "fr": [
      "Restauration autour de la cuisine africaine et antillaise ouvert de 18h à 1h du mercredi au samedi soir. Bar à rhum avec un choix original de cocktails. Chaque vendredi et samedi soir, un plat afro est proposé. Musique d'ambiance et jeux de société."
    ],
    "es": [
      "Cocina africana y antillana abierta de 18.00 a 1.00 h, de miércoles a sábado por la noche. Bar de ron con una original selección de cócteles. Todos los viernes y sábados por la noche se sirve un plato afro. Música ambiental y juegos de mesa."
    ],
    "nl": [
      "Afrikaanse en West-Indische keuken geopend van 18.00 tot 01.00 uur, woensdag- tot zaterdagavond. Rumbar met een originele keuze aan cocktails. Elke vrijdag- en zaterdagavond wordt er een Afro-gerecht geserveerd. Achtergrondmuziek en gezelschapsspellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Rhum-Riz"
    ]
  },
