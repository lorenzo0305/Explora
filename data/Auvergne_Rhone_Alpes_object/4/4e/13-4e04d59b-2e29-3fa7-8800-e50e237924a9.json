  "rdfs:comment": {
    "de": [
      "Lieben Sie den Nervenkitzel? Sind Sie ein erfahrener Experte? Dann ist Vertical Xperience - Tournier Couloir mit einer Steigung von über 37° genau das Richtige für Sie! Eine der anspruchsvollsten Pisten der 3 Vallées!"
    ],
    "en": [
      "Do you like thrills? Are you an expert skier or snowboarder? The Vertical Xperience - Tournier couloir is made for you with a 37° steep couloir ! One of the most challenging slopes in the 3 Vallées !"
    ],
    "it": [
      "Siete amanti del brivido? Siete esperti confermati? Allora Vertical Xperience - couloir Tournier fa al caso vostro, con i suoi 37° di pendenza! Una delle piste più impegnative delle 3 Vallées!"
    ],
    "fr": [
      "Vous aimez les sensations fortes ? Vous êtes un expert confirmé ? Alors Vertical Xperience - couloir Tournier est fait pour vous avec sa pente à plus de 37° ! Une des pistes plus engagée des 3 Vallées !"
    ],
    "es": [
      "¿Le gustan las emociones fuertes? ¿Eres un experto confirmado? Entonces Vertical Xperience - couloir Tournier es para ti, ¡con sus 37° de pendiente! Uno de los descensos más desafiantes de los 3 Valles"
    ],
    "nl": [
      "Hou je van sensatie? Ben je een bevestigd expert? Dan is Vertical Xperience - couloir Tournier iets voor jou met zijn 37° helling! De meest uitdagende afdaling in de 3 Vallées!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Vertical Xperience - Tournier Couloir"
    ],
    "fr": [
      "Vertical Xperience - Couloir Tournier"
    ],
