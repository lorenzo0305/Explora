  "rdfs:comment": {
    "de": [
      "Im Herzen von Sainté, in der Fußgängerzone der Rue des Martyrs de Vingré, ist die Boutique Up Arty ein beliebter Treffpunkt für Liebhaber der Popkultur."
    ],
    "en": [
      "Right in the heart of Sainté, on the pedestrian Rue des Martyrs de Vingré, the Up Arty boutique has established itself as the HQ for pop culture lovers."
    ],
    "it": [
      "Nel cuore di Sainté, nella pedonale Rue des Martyrs de Vingré, la boutique Up Arty è il luogo ideale per gli appassionati di cultura pop."
    ],
    "fr": [
      "En plein cœur de Sainté, dans la rue piétonne des Martyrs de Vingré, la boutique Up Arty s’impose comme le QG des amoureux de pop culture."
    ],
