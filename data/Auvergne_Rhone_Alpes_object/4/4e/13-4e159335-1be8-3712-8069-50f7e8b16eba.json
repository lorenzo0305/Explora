  "rdfs:comment": {
    "de": [
      "La perche bietet Ihnen seit über 25 Jahren lokale Küche, geschmorte Brasseriegerichte, Spezialitäten aus Savoyen und vom See, Tagesvorschläge auf der Kreidetafel ab 20 Euro, bistronomische Gourmetgerichte."
    ],
    "en": [
      "La perche has been serving local cuisine for over 25 years, with simmered brasserie dishes, Savoyard and lake specialties, daily blackboard suggestions starting at 20 euros, and gourmet bistro dishes."
    ],
    "it": [
      "La Perche propone da oltre 25 anni una cucina locale con piatti di brasserie a fuoco lento, specialità savoiarde e lacustri, proposte giornaliere alla lavagna a partire da 20 euro e piatti da bistrot gourmet."
    ],
    "fr": [
      "La perche vous propose une cuisine locale depuis plus de 25 ans, des mets de brasserie mijotés, des spécialités savoyardes et du lac, des suggestions du jour sur tableau noir à partir de 20 euros, des plats gourmands bistronomiques."
    ],
    "nl": [
      "La perche serveert al meer dan 25 jaar lokale gerechten, met gestoofde brasseriegerechten, specialiteiten uit de Savoie en het meer, dagelijkse suggesties op het schoolbord vanaf €20 en gastronomische bistrogerechten."
    ],
    "es": [
      "La perche lleva más de 25 años sirviendo cocina local, con platos de brasserie cocinados a fuego lento, especialidades saboyanas y del lago, sugerencias diarias de pizarra a partir de 20 € y platos de bistró gourmet."
    ]
  },
