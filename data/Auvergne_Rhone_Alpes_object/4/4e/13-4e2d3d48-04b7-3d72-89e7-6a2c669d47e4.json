  "rdfs:comment": {
    "de": [
      "Herstellung von Bio-Kosmetik aus Eselsmilch. Ohne synthetische Produkte oder synthetische Duftstoffe, 100% biologisch abbaubare Seifen. Wir begrenzen den Abfall mit den ökologischen Auswirkungen unserer Produkte."
    ],
    "en": [
      "Production of organic donkey milk cosmetics. No synthetic products or perfumes, 100% biodegradable soaps. We limit waste and the ecological impact of our products."
    ],
    "it": [
      "Produzione di cosmetici biologici a base di latte d'asina. Nessun prodotto sintetico o profumo, saponi biodegradabili al 100%. Limitiamo i rifiuti e l'impatto ecologico dei nostri prodotti."
    ],
    "fr": [
      "Production de cosmétiques bio au lait d'ânesses. Sans produits synthétiques ni parfums de synthèse, savons 100% biodégradables. Nous limitons les déchets avec l’impact écologique de nos produits."
    ],
    "nl": [
      "Productie van biologische ezelinnenmelkcosmetica. Geen synthetische producten of parfums, 100% biologisch afbreekbare zepen. We beperken het afval en de ecologische impact van onze producten."
    ],
    "es": [
      "Producción de cosméticos ecológicos a base de leche de burra. Sin productos sintéticos ni perfumes, jabones 100% biodegradables. Limitamos los residuos y el impacto ecológico de nuestros productos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ferme de l'âne vert cosmétiques bio"
    ]
  },
