  "rdfs:comment": {
    "de": [
      "Verbringen Sie eine schöne Zeit in diesem Indoor-Park, der für Kinder von 0 bis 12 Jahren konzipiert wurde. Röhrenstrukturen mit Ninja-Parcours, ein Ballbecken, zahlreiche Rutschen, kleine Elektromotorräder und viele andere Spiele warten auf Ihre Kinder."
    ],
    "en": [
      "Have a good time in this indoor park designed for children from 0 to 12 years old. Tubular structures with a ninja course, a ball pool, many slides, small electric motorcycles, and many other games await your children."
    ],
    "it": [
      "Divertitevi in questo parco al coperto progettato per bambini da 0 a 12 anni. Strutture tubolari con un percorso ninja, una piscina di palline, numerosi scivoli, piccole moto elettriche e molti altri giochi attendono i vostri bambini."
    ],
    "fr": [
      "Passez un bon moment dans ce parc indoor conçu pour les enfants de 0 à 12 ans. Des structures tubulaires avec parcours ninja, une piscine à balles, de nombreux toboggans, des petites motos électrique, et bien d'autres jeux attendent vos enfants."
    ],
    "es": [
      "Diviértete en este parque cubierto diseñado para niños de 0 a 12 años. Estructuras tubulares con recorrido ninja, piscina de bolas, numerosos toboganes, pequeñas motos eléctricas y muchos otros juegos esperan a tus hijos."
    ],
    "nl": [
      "Beleef een geweldige tijd in dit overdekte park voor kinderen van 0 tot 12 jaar. Buisstructuren met een ninja parcours, een ballenbad, talrijke glijbanen, kleine elektrische motoren en vele andere spelen wachten op uw kinderen."
    ]
  },
  "rdfs:label": {
