  "rdfs:comment": {
    "de": [
      "In einer provenzalischen Umgebung, die den Pferden, dem Sport und der Natur gewidmet ist, empfängt Sie Marthe, um den Reitsport auszuüben. Reitunterricht, Kurse und Ausflüge werden das ganze Jahr über angeboten, auf Ponys oder Pferden, bei Wettkämpfen oder in der Freizeit, vom Anfänger bis zum Reiter Galop 7 und höher."
    ],
    "en": [
      "In a green oasis, devoted to horses, sport and nature, Mathe welcoms you to pratice horse riding accessible to all. Open all year round, riding on horseback or poney, cours, internship, stroll and walks are proposed to beginners and to riders galop 7+."
    ],
    "it": [
      "In un ambiente provenzale dedicato ai cavalli, allo sport e alla natura, Marthe vi accoglie per praticare l'equitazione. Lezioni, corsi e passeggiate sono disponibili tutto l'anno, su pony o cavallo, da competizione o da diporto, dai principianti al galop 7+"
    ],
    "fr": [
      "Dans un écrin provençal consacré aux chevaux, au sport et à la nature, Marthe vous accueille pour pratiquer l'équitation. Leçons, stages et balades sont proposés toute l'année, à poney ou à cheval, compétition ou loisir, du débutant au cavalier galop 7et+"
    ],
    "nl": [
      "In een Provençaalse omgeving gewijd aan paarden, sport en natuur, verwelkomt Marthe u om paardrijden te beoefenen dat voor iedereen toegankelijk is. Het hele jaar geopend, met pony of paard, lessen, cursussen, ritten aangeboden van beginners tot galop 7+ ruiters."
    ],
    "es": [
      "En un entorno provenzal dedicado a los caballos, el deporte y la naturaleza, Marthe le da la bienvenida para practicar la equitación. Se ofrecen clases, cursos y paseos durante todo el año, en poni o a caballo, de competición o de ocio, desde principiante hasta galope 7+"
    ]
  },
