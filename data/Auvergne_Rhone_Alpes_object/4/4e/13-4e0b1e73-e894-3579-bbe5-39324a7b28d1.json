  "rdfs:comment": {
    "de": [
      "Überdachter Empfangsraum: LE WEKO. Dieser Saal liegt im Herzen des Waldes, in der Mitte des Anwesens. Er grenzt an die Guinguette-Bar und an den Sanitärblock für die Bequemlichkeit. Kapazität: 80 Personen stehend / 60 Plätze für sitzende Mahlzeiten.\r\nPrivater Parkplatz."
    ],
    "en": [
      "Covered function room: LE WEKO. In the heart of the woods, in the center of the Domaine, this room is adjacent to the Guinguette-Bar, and next to the Sanitary Block for conveniences. Capacity: 80 people standing / 60 places for seated meals.\r\nPrivate parking."
    ],
    "it": [
      "Sala coperta: LE WEKO. Nel cuore della foresta, al centro della tenuta, questa sala è adiacente al Guinguette-Bar e al blocco dei servizi igienici. Capacità di 80 persone in piedi / 60 posti per pasti seduti.\r\nParcheggio privato."
    ],
    "fr": [
      "Salle de réception couverte: LE WEKO. Au cœur du Bois, au centre du Domaine, cette salle est attenante à la Guinguette-Bar, et jouxte le Bloc Sanitaire pour les commodités. Capacité de 80 pers debout / 60 places pour repas servis assis.\r\nParking privé."
    ],
    "es": [
      "Sala de actos cubierta: LE WEKO. En el corazón del bosque, en el centro de la finca, esta sala se encuentra junto a la Guinguette-Bar, y al lado del bloque de aseos para las comodidades. Capacidad para 80 personas de pie / 60 plazas para comidas sentadas.\r\nAparcamiento privado."
    ],
    "nl": [
      "Overdekte feestzaal: LE WEKO. In het hart van het bos, in het midden van het domein, ligt deze zaal naast de Guinguette-Bar en naast het sanitairblok voor de voorzieningen. Capaciteit voor 80 personen staand / 60 plaatsen voor zittende maaltijden.\r\nPrivé parkeerplaats."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ermitage du Grand Bois"
    ]
  },
