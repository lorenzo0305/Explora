  "rdfs:comment": {
    "de": [
      "Am Fuße des Puy Mary, Buron, der sich in den Cirque d'Eylac schmiegt. Auvergnatische Küche, Crêperie. Verkauf von Bauernprodukten und Imbiss im Freien. Spezialitäten des Burons: Wurstwaren, Bourriols, Käse, Pachades. Terrasse und magische Umgebung!"
    ],
    "en": [
      "At the foot of Puy Mary, buron nestled in the Eylac cirque. Auvergne cuisine, crêperie. Farm produce sales and open-air snack bar. Buron specialities: charcuterie, bourriols, cheeses, pachades. Terrace and magical setting!"
    ],
    "it": [
      "Ai piedi del Puy Mary, il Buron è incastonato nel circo di Eylac. Cucina d'Alvernia, crêperie. Vendita di prodotti agricoli e snack bar all'aperto. Specialità del buron: salumi, bourriols, formaggi, pachades. Terrazza e ambiente magico!"
    ],
    "fr": [
      "Au pied du Puy Mary, buron blotti dans le cirque d'Eylac. Cuisine auvergnate, crêperie. Vente de produits fermiers et casse-croûte en plein air. Spécialités du buron : charcuterie, bourriols, fromages, pachades. Terrasse et cadre magique!!!"
    ],
    "es": [
      "Al pie del Puy Mary, burón enclavado en el circo de Eylac. Cocina de Auvernia, crepería. Venta de productos agrícolas y merendero al aire libre. Especialidades del burón: embutidos, bourriols, quesos, pachades. ¡Terraza y entorno mágico!"
    ],
    "nl": [
      "Aan de voet van Puy Mary, buron genesteld in het Eylac keteldal. Auvergne keuken, crêperie. Verkoop van boerderijproducten en snackbar in de open lucht. Specialiteiten van de buron: vleeswaren, bourriols, kazen, pachades. Terras en magische omgeving!"
    ]
  },
  "rdfs:label": {
