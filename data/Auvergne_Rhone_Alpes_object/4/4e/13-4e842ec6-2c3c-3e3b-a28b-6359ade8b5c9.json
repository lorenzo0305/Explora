  "rdfs:comment": {
    "de": [
      "Der Weizen wird je nach Qualität in der Region Auvergne eingekauft. Wir bieten Ihnen eine große Auswahl an Mehlsorten, wie z. B. unsere natürlichen Mehle ohne Zusatzstoffe."
    ],
    "en": [
      "Wheat is purchased in the Auvergne region, depending on quality. We offer a wide range of flours, such as our natural additive-free flours."
    ],
    "it": [
      "Il grano viene acquistato nella regione dell'Alvernia, a seconda della sua qualità. Offriamo un'ampia gamma di farine, comprese le nostre farine naturali senza additivi."
    ],
    "fr": [
      "Le blé est acheté dans la région Auvergne en fonction de la qualité. Nous vous proposons une large gamme de farines telles que nos farines naturelles sans additifs."
    ],
    "es": [
      "El trigo se compra en la región de Auvernia, en función de su calidad. Ofrecemos una amplia gama de harinas, incluidas nuestras harinas naturales sin aditivos."
    ],
    "nl": [
      "De tarwe wordt aangekocht in de Auvergne, afhankelijk van de kwaliteit. We bieden een ruim assortiment meel, waaronder onze natuurlijke meel zonder additieven."
    ]
  },
  "rdfs:label": {
