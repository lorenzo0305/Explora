  "rdfs:comment": {
    "de": [
      "Genießen Sie einen 25-Meter-Pool und einen Außenbereich.\r\nIm Schwimmbad von Saint-Eloy-les-Mines werden das ganze Jahr über zahlreiche Aktivitäten für Erwachsene und Kinder angeboten."
    ],
    "en": [
      "Enjoy a 25-meter pool and an outdoor space.\r\nMany activities are offered for adults and children at the Saint-Eloy-les-Mines swimming pool throughout the year."
    ],
    "it": [
      "Godetevi una piscina di 25 metri e un'area esterna.\r\nLa piscina di Saint-Eloy-les-Mines offre una vasta gamma di attività per adulti e bambini durante tutto l'anno."
    ],
    "fr": [
      "Profitez d'un bassin de 25 mètres et d'un espace extérieur. \r\nDe nombreuses activités sont proposées pour les adultes et les enfants à la piscine de Saint-Eloy-les-Mines tout au long de l'année."
    ],
    "nl": [
      "Geniet van een zwembad van 25 meter en een buitenruimte.\r\nHet zwembad van Saint-Eloy-les-Mines biedt het hele jaar door allerlei activiteiten voor volwassenen en kinderen."
    ],
    "es": [
      "Disfrute de una piscina de 25 metros y de una zona al aire libre.\r\nLa piscina de Saint-Eloy-les-Mines ofrece una amplia gama de actividades para adultos y niños durante todo el año."
    ]
  },
