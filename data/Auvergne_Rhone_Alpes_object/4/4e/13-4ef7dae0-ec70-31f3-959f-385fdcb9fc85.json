  "rdfs:comment": {
    "de": [
      "In einer geselligen Atmosphäre ist das Jamais Vu gleichzeitig eine handwerkliche Brasserie, ein Pub mit Essensmöglichkeiten vor Ort, ein Programm mit Jazz- und Elektrokonzerten, Clubbing-Abenden und ein Seminarraum mit maßgeschneiderten Angeboten."
    ],
    "en": [
      "In a friendly atmosphere, Jamais Vu is a traditional brasserie, a pub with on-site dining, a program of jazz and electro concerts, clubbing evenings and a seminar room with tailor-made formulas."
    ],
    "it": [
      "In un'atmosfera amichevole, il Jamais Vu offre una brasserie tradizionale, un pub con cucina in loco, un programma di concerti jazz ed elettro, serate in discoteca e una sala seminari con pacchetti su misura."
    ],
    "fr": [
      "Dans une ambiance conviviale, le Jamais Vu, c'est à la fois une brasserie artisanale, un pub avec de quoi se restaurer sur place, une programmation de concerts jazz, électro, des soirées Clubbing et une salle de séminaire avec des formules sur mesure."
    ],
    "nl": [
      "In een gezellige sfeer biedt de Jamais Vu een traditionele brasserie, een pub met eten ter plaatse, een programma met jazz- en elektroconcerten, clubavonden en een seminarruimte met pakketten op maat."
    ],
    "es": [
      "En un ambiente acogedor, el Jamais Vu es una brasserie tradicional, un pub con comida in situ, un programa de conciertos de jazz y electro, noches de club y una sala de seminarios con paquetes a medida."
    ]
  },
