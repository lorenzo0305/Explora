  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Kreationen der Domaine Lilian Bertrand mit ihren IGP-Weinen Syrah und Viognier , begleitet von unseren AOP Saint-Joseph-Weinen, die als Rot- und Weißweine erhältlich sind. Unser Weingut befindet sich in Ozon und überragt majestätisch das Rhône-Tal."
    ],
    "en": [
      "Discover the creations of Domaine Lilian Bertrand, offering organic IGP Syrah and Viognier selections, accompanied by our AOP Saint-Joseph wines, available in red and white. Located in Ozon, our estate majestically overlooks the Rhône Valley."
    ],
    "it": [
      "Scoprite le creazioni del Domaine Lilian Bertrand, che propone selezioni di Syrah e Viognier IGP, accompagnate dai nostri vini AOP Saint-Joseph, disponibili in rosso e bianco. Situata a Ozon, la nostra tenuta domina maestosamente la Valle del Rodano."
    ],
    "fr": [
      "Découvrez les créations du Domaine Lilian Bertrand, proposant des sélections en IGP Syrah et Viognier , accompagnées de nos vins AOP Saint-Joseph, disponibles en rouge et blanc. Situé à Ozon, notre domaine surplombe majestueusement la vallée du Rhône."
    ],
    "nl": [
      "Ontdek de creaties van Domaine Lilian Bertrand, met selecties IGP Syrah en Viognier, vergezeld van onze AOP Saint-Joseph wijnen, verkrijgbaar in rood en wit. Ons domein ligt in Ozon en kijkt majestueus uit over de Rhônevallei."
    ],
    "es": [
      "Descubra las creaciones del Domaine Lilian Bertrand, que ofrece selecciones de IGP Syrah y Viognier, acompañadas de nuestros vinos AOP Saint-Joseph, disponibles en tinto y blanco. Situado en Ozon, nuestro dominio domina majestuosamente el valle del Ródano."
    ]
  },
  "rdfs:label": {
