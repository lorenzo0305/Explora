  "rdfs:comment": {
    "de": [
      "Erleben Sie eine einzigartige Skitour unter den Sternen! Starten Sie von Les Communailles aus zu einem Aufstieg bei Sonnenuntergang mit Blick auf den Mont-Blanc.\r\nWenn Sie den Gipfel erreicht haben, machen Sie sich mit Ihrer Stirnlampe bereit für eine Abfahrt unter den Sternen."
    ],
    "en": [
      "Enjoy a unique ski touring experience under the stars! Set off from Les Communailles for a climb at sunset facing Mont Blanc.\r\nOnce at the summit, get ready for a descent under the stars with your headlamp."
    ],
    "it": [
      "Vivete un'esperienza unica di sci alpinismo sotto le stelle! Partite da Les Communailles per una salita al tramonto di fronte al Monte Bianco.\r\nUna volta in cima, preparatevi per una discesa sotto le stelle con la vostra lampada frontale."
    ],
    "fr": [
      "Vivez une expérience unique de ski de randonnée sous les étoiles ! Partez des Communailles pour une montée au coucher du soleil face au Mont-Blanc.\r\nUne fois au sommet, préparez-vous pour une descente sous les étoiles avec votre lampe frontale."
    ],
    "nl": [
      "Geniet van een unieke toerski-ervaring onder de sterren! Vertrek vanuit Les Communailles voor een beklimming bij zonsondergang tegenover de Mont Blanc.\r\nEenmaal op de top, maak je je klaar voor een afdaling onder de sterren met je hoofdlamp."
    ],
    "es": [
      "Disfrute de una experiencia única de esquí de travesía bajo las estrellas Salga de Les Communailles para un ascenso al atardecer frente al Mont Blanc.\r\nUna vez en la cima, prepárate para un descenso bajo las estrellas con tu linterna frontal."
    ]
  },
