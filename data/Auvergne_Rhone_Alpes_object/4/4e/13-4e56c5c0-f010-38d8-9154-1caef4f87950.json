  "rdfs:comment": {
    "de": [
      "Im Herzen des Arve-Tals, in einem modernen und gemütlichen Rahmen, lädt Chez Mosse Sie ein, einen Moment der Gaumenfreuden zu teilen. Die raffinierte Küche richtet sich nach den Jahreszeiten und den Anlieferungen unserer Produzenten."
    ],
    "en": [
      "In the heart of the Arve Valley, Chez Mosse invites you to share a moment of indulgence in a warm, modern setting. Our refined cuisine follows the seasons and the arrival of our producers."
    ],
    "it": [
      "Nel cuore della Valle dell'Arve, in un ambiente moderno e caloroso, Chez Mosse vi invita a condividere un momento di indulgenza. Una cucina raffinata viene proposta in base alle stagioni e all'arrivo dei nostri produttori."
    ],
    "fr": [
      "Au cœur de la vallée de l’Arve, dans un cadre moderne et chaleureux, Chez Mosse vous invite à partager un moment de gourmandise. Une cuisine raffinée se décline au fil des saisons et des arrivages de nos producteurs."
    ],
    "nl": [
      "In het hart van het Arve-dal, in een modern en warm kader, nodigt Chez Mosse u uit voor een moment van verwennerij. Een verfijnde keuken wordt aangeboden volgens de seizoenen en de komst van onze producenten."
    ],
    "es": [
      "En el corazón del Valle del Arve, en un entorno moderno y cálido, Chez Mosse le invita a compartir un momento de indulgencia. Se ofrece una cocina refinada según las estaciones y la llegada de nuestros productores."
    ]
  },
