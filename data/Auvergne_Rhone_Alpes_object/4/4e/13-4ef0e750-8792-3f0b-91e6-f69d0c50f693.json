  "rdfs:comment": {
    "de": [
      "Die Auberge Napoléon empfängt Sie für eine Mahlzeit im Herzen des Dorfes Laffrey, einer legendären Etappe des Kaisers. Sie befindet sich nur wenige Schritte von der Prairie de la Rencontre und der Napoleon-Statue entfernt."
    ],
    "en": [
      "The Auberge Napoléon welcomes you for a meal in the heart of the village of Laffrey, a legendary stopover for the Emperor. It is located just a few steps away from the Prairie de la Rencontre and the statue of Napoleon."
    ],
    "it": [
      "L'Auberge Napoléon vi accoglie il tempo di un pranzo nel cuore del villaggio di Laffrey, una fase mitica dall'Imperatore. Si situa a qualche passi dal Prate dell'incontra e della statuta di Napoleone."
    ],
    "fr": [
      "L'Auberge Napoléon vous accueille le temps d'un repas au cœur du village de Laffrey, étape mythique de l'Empereur. Elle se situe à quelques pas de la Prairie de la Rencontre et de la statue de Napoléon."
    ],
    "es": [
      "El Auberge Napoléon le da la bienvenida para una comida en el corazón del pueblo de Laffrey, escala legendaria del Emperador. Está a dos pasos de la Prairie de la Rencontre y de la estatua de Napoleón."
    ],
    "nl": [
      "De Auberge Napoléon verwelkomt je voor een maaltijd in het hart van het dorp Laffrey, een legendarische halte van de keizer. Het ligt op een steenworp afstand van de Prairie de la Rencontre en het standbeeld van Napoleon."
    ]
  },
  "rdfs:label": {
