  "rdfs:comment": {
    "de": [
      "Besuch des Museums: Nachstellung von Szenen vom Anfang des Jahrhunderts zum Thema Weinbau, Wein und Traditionen der Dioises. Verkostung unserer Produkte. Besichtigung des Weinkellers unter der Woche nach Vereinbarung."
    ],
    "en": [
      "The Clairette Interpretive Centre: an entertaining and informative visit unveiling the unique traditions of wine making in the Diois region."
    ],
    "it": [
      "Visita al museo: rievocazione di scene di inizio secolo sul tema della vite, del vino e delle tradizioni di Diois. Degustazione dei nostri prodotti. Visita della cantina durante la settimana su appuntamento."
    ],
    "fr": [
      "Visite du musée : reconstitution de scènes du début du siècle sur le thème de la vigne, du vin et des traditions Dioises. Dégustation de nos produits. Visite de Cave en semaine sur rendez-vous."
    ],
    "es": [
      "Visita al museo: recreación de escenas de principios de siglo sobre el tema de la viña, el vino y las tradiciones de Diois. Degustación de nuestros productos. Visita de la bodega durante la semana con cita previa."
    ],
    "nl": [
      "Bezoek aan het Museum de la Clairette: reconstructie van scènes van het begin van de eeuw rondom het thema wijngaarden, wijn, het vak wijnboer en de tradities uit de omgeving van Die."
    ]
  },
