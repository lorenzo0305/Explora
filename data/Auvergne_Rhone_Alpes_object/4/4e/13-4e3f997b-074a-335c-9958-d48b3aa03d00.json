  "rdfs:comment": {
    "de": [
      "Le Caviste Gourmand bietet Ihnen nicht nur Wein, sondern auch Spirituosen und eine große Auswahl an Feinkost an.\r\nHier finden Sie eine große Auswahl an regionalen, französischen und ausländischen Weinen sowie lokale und internationale Feinkostprodukte."
    ],
    "en": [
      "Le Caviste Gourmand sales wine, spirits, and a large choice of delicatessen. You will find here a great range of regional, french and foreign wines, but also local and international delicatessen."
    ],
    "it": [
      "Le Caviste Gourmand offre vini, liquori e una vasta gamma di prodotti di gastronomia.\r\nTroverete un'ampia gamma di vini regionali, francesi ed esteri, oltre a prodotti di gastronomia locale e internazionale."
    ],
    "fr": [
      "Le Caviste Gourmand vous propose du vin, mais aussi des spiritueux et un grand choix d'épicerie fine. \r\nVous y trouverez une large gamme de vins régionaux, français et étrangers, et des produits d'épicerie fine locaux et internationaux."
    ],
    "es": [
      "Le Caviste Gourmand ofrece vinos, licores y una amplia gama de productos delicatessen.\r\nEncontrará una amplia gama de vinos regionales, franceses y extranjeros, así como productos delicatessen locales e internacionales."
    ],
    "nl": [
      "Le Caviste Gourmand biedt wijn, sterke drank en een breed assortiment delicatessen.\r\nJe vindt hier een breed scala aan regionale, Franse en buitenlandse wijnen, evenals lokale en internationale delicatessenproducten."
    ]
  },
