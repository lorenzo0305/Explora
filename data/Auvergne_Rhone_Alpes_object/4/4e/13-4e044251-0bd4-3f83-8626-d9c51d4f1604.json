  "rdfs:comment": {
    "de": [
      "Im Zentrum von Roanne bietet das La Place Rouge typisch russische Spezialitäten in einem gemütlichen und festlichen Ambiente. Vom Wodka über Goldflitter bis hin zu den sorgfältig zubereiteten Gerichten ist alles da, um eine gute Zeit zu verbringen?"
    ],
    "en": [
      "Right in the center of Roanne, La Place Rouge offers typical Russian specialties in a warm and festive setting. From vodka and gold flakes to carefully prepared dishes, everything is done to ensure you have a good time?"
    ],
    "it": [
      "Nel pieno centro di Roanne, La Place Rouge offre specialità tipiche russe in un ambiente caldo e festoso. Dalla vodka ai fiocchi d'oro, fino ai piatti preparati con cura, tutto è fatto per farvi divertire?"
    ],
    "fr": [
      "En plein centre de Roanne, La Place Rouge propose des spécialités typiquement russes dans un lieu chaleureux et festif. De la vodka aux paillettes d'or en passant par des plats soigneusement préparés, tout est fait pour passer un bon moment…"
    ],
    "nl": [
      "La Place Rouge ligt in het centrum van Roanne en biedt typisch Russische specialiteiten in een warme en feestelijke omgeving. Van wodka en goudvlokken tot zorgvuldig bereide gerechten, alles wordt in het werk gesteld om het u naar de zin te maken?"
    ],
    "es": [
      "En pleno centro de Roanne, La Place Rouge ofrece especialidades típicas rusas en un ambiente cálido y festivo. Desde vodka y copos de oro hasta platos preparados con esmero, todo está hecho para que lo pases bien.."
    ]
  },
