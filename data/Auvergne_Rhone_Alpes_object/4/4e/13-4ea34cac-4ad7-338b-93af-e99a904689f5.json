  "rdfs:comment": {
    "de": [
      "In dieser Käserei werden der Tome des Bauges, der Valbleu, der Monpela, der Boudane und der Margériaz (Gruyère des Bauges) hergestellt und verkauft.\r\nAuch andere lokale Produkte werden zum Verkauf angeboten.\r\n\r\nBrotverkauf täglich außer mittwochs."
    ],
    "en": [
      "Shop with hand made cheese and local products."
    ],
    "it": [
      "Il caseificio produce e vende Tome des Bauges, Valbleu, Monpela, Boudane e Margériaz (Bauges Gruyère).\r\nSono in vendita anche altri prodotti locali.\r\n\r\nPane disponibile tutti i giorni tranne il mercoledì."
    ],
    "fr": [
      "Dans cette fromagerie, on fabrique et on vend la Tome des Bauges, le Valbleu, le Monpela, la Boudane et le Margériaz (gruyère des Bauges).\r\nD'autres produits locaux sont également disponibles à la vente.\r\n\r\nDépôt de pain tous les jours sauf le mercredi."
    ],
    "nl": [
      "Verkoop van Tomes des Bauges en andere kazen die ter plekke wordt gemaakt: Margériaz, Monpela, Valbleu...\r\nEen selectie aan lokale producten."
    ],
    "es": [
      "La quesería produce y vende Tome des Bauges, Valbleu, Monpela, Boudane y Margériaz (Gruyère de Bauges).\r\nTambién se venden otros productos locales.\r\n\r\nPan disponible todos los días excepto el miércoles."
    ]
  },
  "rdfs:label": {
