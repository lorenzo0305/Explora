  "rdfs:comment": {
    "de": [
      "Das Ziel des 109 ist es, dem Publikum das Beste der regionalen, nationalen und internationalen Musikszene zu präsentieren, aber auch aufstrebende unabhängige Kreationen zu unterstützen und aufzuwerten."
    ],
    "en": [
      "The 109 aims to present the best of the regional, national and international music scene to the public, but also to support and promote independent creation in the making."
    ],
    "it": [
      "Il 109 si propone di presentare al pubblico il meglio della scena musicale regionale, nazionale e internazionale, ma anche di sostenere e promuovere la creazione indipendente emergente."
    ],
    "fr": [
      "Le 109 a pour but de présenter au public le meilleur de la scène musicale régionale, nationale et internationale, mais également de soutenir et valoriser la création indépendante en devenir."
    ],
    "es": [
      "El 109 pretende presentar al público lo mejor del panorama musical regional, nacional e internacional, pero también apoyar y promover la creación independiente emergente."
    ],
    "nl": [
      "De 109 wil het beste van de regionale, nationale en internationale muziekscene aan het publiek presenteren, maar ook opkomende onafhankelijke creatie ondersteunen en promoten."
    ]
  },
  "rdfs:label": {
