  "rdfs:comment": {
    "de": [
      "Audrey und Teddy sind leidenschaftliche Naturliebhaber und lieben körperliche Aktivitäten in den Bergen. Jeder von ihnen hat einen Beruf, der mit der Begleitung zu tun hat. teddy im sportlichen Bereich, Audrey im Bereich der Elternschaft und des Wohlbefindens."
    ],
    "en": [
      "Audrey and Teddy are passionate about nature and physical activities in the mountains. They each have a job related to coaching. teddy is involved in sports, Audrey in parenting and well-being."
    ],
    "it": [
      "Audrey e Teddy sono appassionati di natura e di attività fisiche in montagna. Ognuno di loro ha un lavoro legato al coaching. teddy si occupa di sport e Audrey di genitorialità e benessere."
    ],
    "fr": [
      "Audrey et Teddy, passionnés de nature, d'activités physiques en montagne. Ils ont chacun un métier en lien avec l'accompagnement. : Teddy sur le plan sportif, Audrey, autour de la parentalité et du bien-être."
    ],
    "nl": [
      "Audrey en Teddy hebben een passie voor de natuur en fysieke activiteiten in de bergen. Ze hebben elk een baan die gerelateerd is aan coaching. teddy houdt zich bezig met sport en Audrey met ouderschap en welzijn."
    ],
    "es": [
      "A Audrey y Teddy les apasiona la naturaleza y las actividades físicas en la montaña. Cada uno tiene un trabajo relacionado con el entrenamiento. teddy se dedica al deporte y Audrey a la crianza y el bienestar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Coaching de la Vallée"
    ]
  },
