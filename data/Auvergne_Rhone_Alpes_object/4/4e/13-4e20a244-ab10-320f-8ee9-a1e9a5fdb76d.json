  "rdfs:comment": {
    "de": [
      "Von der Zucht bis auf den Teller: Entdecken Sie die Bio-Helikopterzucht und ihre Kosmetika! Spezielle Animation zum Thema Wasser: Präsentation des Wasserkreislaufs, der auf dem Bauernhof genutzt wird. Schneckenteller für 12?"
    ],
    "en": [
      "From breeding to the plate, come and discover organic heliciculture and its cosmetics! Special water animation: presentation of the water cycle used on the farm. Snail platter at 12?"
    ],
    "it": [
      "Dalla riproduzione al piatto, venite a scoprire l'elicicoltura biologica e la sua cosmesi! Evento speciale sull'acqua: presentazione del ciclo dell'acqua utilizzato in azienda. Piatto di lumache alle 12?"
    ],
    "fr": [
      "De la reproduction à l'assiette, venez découvrir l'héliciculture bio et ses cosmétiques ! Animation spéciale autour de l'eau : présentation du cycle de l'eau utilisé à la ferme. Assiette d'escargot à 12€"
    ],
    "nl": [
      "Van voortplanting tot op het bord, kom en ontdek de biologische helikopterteelt en zijn cosmetica! Speciaal evenement over water: presentatie van de waterkringloop op de boerderij. Slakkenbord op 12?"
    ],
    "es": [
      "De la reproducción al plato, ¡venga a descubrir la helicicultura ecológica y sus cosméticos! Evento especial sobre el agua: presentación del ciclo del agua utilizado en la granja. Plato de caracoles a las 12?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de la ferme aux escargots de Ferme en Ferme"
    ]
  },
