  "rdfs:comment": {
    "de": [
      "CEDER ist in den Bereichen erneuerbare Energien, Wasser- und Energiesparen, ökologisches Bauen, Holzenergie, Öko-Konsum, Mobilität, Wasser... tätig."
    ],
    "en": [
      "The CEDER takes action in renewable energies, economies of water and energy, eco-construction, energy-wood, eco-consumption, mobility, water..."
    ],
    "it": [
      "Il CEDER è attivo nei settori delle energie rinnovabili, del risparmio idrico ed energetico, dell'eco-edilizia, dell'energia del legno, dell'eco-consumo, della mobilità, dell'acqua?"
    ],
    "fr": [
      "Le CEDER intervient dans les domaines des énergies renouvelables, les économies d’eau et d’énergie, l’éco-construction, le bois-énergie, l'éco consommation, la mobilité, l'eau…"
    ],
    "es": [
      "El CEDER trabaja en los ámbitos de las energías renovables, el ahorro de agua y energía, la ecoconstrucción, la dendroenergía, el ecoconsumo, la movilidad, el agua.."
    ],
    "nl": [
      "De CEDER bemiddelt in het domein van duurzame energiebronnen, van besparingen van water en energie, ecologishce bouw, ecologishce verbruik, mobiliteit, water..."
