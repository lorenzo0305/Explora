  "rdfs:comment": {
    "de": [
      "Atelier, Boutique, Galerie...\r\n\r\nWechselnde Künstler etwa alle 3 Monate.\r\n\r\nIn dieser Kunstboutique finden Sie die Werke der Keramikkünstlerin Monique Chaulet, aber auch die Werke anderer Künstler, Maler, Bildhauer und Fotografen."
    ],
    "en": [
      "Workshop, Shop, Gallery...\r\n\r\nRotating artists every 3 months or so.\r\n\r\nYou will find in this art shop, the creations of Monique Chaulet, Artisan Ceramist, but also, the works of other artists, painters, sculptors and photographers."
    ],
    "it": [
      "Officina, negozio, galleria...\r\n\r\nArtisti a rotazione ogni 3 mesi circa.\r\n\r\nIn questo negozio d'arte troverete le creazioni di Monique Chaulet, artigiana ceramista, ma anche le opere di altri artisti, pittori, scultori e fotografi."
    ],
    "fr": [
      "Atelier, Boutique, Galerie...\r\n\r\nArtistes tournants tous les 3 mois environ.\r\n\r\nVous trouverez dans cette boutique d'art, les créations de Monique Chaulet, Artisan Céramiste, mais aussi, les œuvres d’autres artistes, peintres, sculpteurs et photographes."
    ],
    "nl": [
      "Werkplaats, winkel, galerie...\r\n\r\nOm de 3 maanden of zo.\r\n\r\nIn deze kunstwinkel vindt u de creaties van Monique Chaulet, ambachtelijk keramiste, maar ook het werk van andere kunstenaars, schilders, beeldhouwers en fotografen."
    ],
    "es": [
      "Taller, tienda, galería...\r\n\r\nRotación de artistas cada 3 meses más o menos.\r\n\r\nEn esta tienda de arte, encontrará las creaciones de Monique Chaulet, Ceramista Artesana, pero también, las obras de otros artistas, pintores, escultores y fotógrafos."
    ]
  },
  "rdfs:label": {
