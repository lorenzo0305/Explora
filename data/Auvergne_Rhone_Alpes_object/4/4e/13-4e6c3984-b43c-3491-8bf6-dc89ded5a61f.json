  "rdfs:comment": {
    "de": [
      "Das Museum von Souvigny, das in den ehemaligen Scheunen des angrenzenden Priorats untergebracht ist, zeigt eine Sammlung, die dem archäologischen Erbe gewidmet ist. Jedes Jahr werden hier wechselnde Ausstellungen gezeigt. Der Besuch kann mit der Entdeckung des Gartens der Priorei verbunden werden."
    ],
    "en": [
      "The Souvigny museum, housed in the former barns of the adjoining priory, presents a collection devoted to archaeological heritage. Temporary exhibitions are held there every year. Visit coupled by the discovery of the garden of the priory."
    ],
    "it": [
      "Il museo di Souvigny, ospitato negli ex granai dell'adiacente priorato, presenta una collezione dedicata al patrimonio archeologico. Ogni anno vi si tengono mostre temporanee. Visita abbinata alla scoperta del giardino del priorato."
    ],
    "fr": [
      "Le musée de Souvigny, aménagé dans les anciennes granges du prieuré attenant, présente une collection consacrée au patrimoine archéologique. Des expositions temporaires y sont proposées chaque année. Visite couplée par la découverte du jardin du prieuré."
    ],
    "nl": [
      "Het museum van Souvigny, gevestigd in de voormalige schuren van de aangrenzende priorij, presenteert een collectie gewijd aan het archeologisch erfgoed. Elk jaar worden er tijdelijke tentoonstellingen gehouden. Bezoek gekoppeld aan de ontdekking van de priorijtuin."
    ],
    "es": [
      "El museo de Souvigny, ubicado en los antiguos graneros del priorato contiguo, presenta una colección dedicada al patrimonio arqueológico. Todos los años se celebran allí exposiciones temporales. Visita acompañada del descubrimiento del jardín del priorato."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée du Grand site clunisien de Souvigny"
    ]
  },
