  "rdfs:comment": {
    "de": [
      "Dorf Lempdes/Allagnon: Romanische Kirche mit geschnitzten Kapitellen und Modillons, Piétà aus dem 17. Jahrhundert. Halbkreisförmige Markthalle aus dem 19.\r\nGroße einbogige Brücke aus dem 18. Jahrhundert. Ehemalige Getreidemühlen entlang des Béal."
    ],
    "en": [
      "Village of Lempdes/Allagnon: Romanesque church with carved capitals and modillions, 17th-century Piétà. 19th-century semi-circular covered market.\r\n18th-century single-arch bridge. Former grain mills along the Béal."
    ],
    "it": [
      "Villaggio di Lempdes/Allagnon: chiesa romanica con capitelli e modiglioni scolpiti, Pietà del XVII secolo. Sala del mercato semicircolare del XIX secolo.\r\nGrande ponte ad arcata unica del XVIII secolo. Antichi mulini per il grano lungo il Béal."
    ],
    "fr": [
      "Village de Lempdes/Allagnon : Église romane avec chapiteaux et modillons sculptés, Piétà du XVIIe siècle. Halle semi-circulaire du XIXe siècle.\r\nGrand pont à une seule arche du XVIIIe siècle. Anciens moulins à grains le long du Béal."
    ],
    "es": [
      "Pueblo de Lempdes/Allagnon: iglesia románica con capiteles esculpidos y modillones, Piedad del siglo XVII. Mercado semicircular del siglo XIX.\r\nGran puente de un solo arco del siglo XVIII. Antiguos molinos de grano a lo largo del Béal."
    ],
    "nl": [
      "Dorp Lempdes/Allagnon: Romaanse kerk met gebeeldhouwde kapitelen en modillions, 17e-eeuwse Pietà. Halfronde markthal uit de 19e eeuw.\r\nGrote brug met één boog uit de 18e eeuw. Oude graanmolens langs het Béal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Lempdes-sur-Allagnon"
    ]
  },
