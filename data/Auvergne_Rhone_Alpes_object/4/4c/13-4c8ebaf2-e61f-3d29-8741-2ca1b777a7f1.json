  "rdfs:comment": {
    "de": [
      "Der Saal Ange Oscar in Blou empfängt Sie für Ihre Seminare, Arbeitstreffen. Auf Anfrage bei der Gemeindeverwaltung von Thueyts. Kapazität: 50 Sitzplätze."
    ],
    "en": [
      "The Salle Ange Oscar de Blou is available for seminars and business meetings. On request from Thueyts town hall. Seating capacity: 50 people."
    ],
