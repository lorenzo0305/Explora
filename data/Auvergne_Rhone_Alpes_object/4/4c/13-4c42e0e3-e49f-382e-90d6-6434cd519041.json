  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais durch ein spielerisches und kostenloses Geocaching-Erlebnis! In Chevrières begeben Sie sich auf die Jagd nach Graâl, der in Sachen Geschichte und Sehenswürdigkeiten unerschöpflich ist. Er und die anderen Gnolus werden Ihnen die Geschichte des Dorfes näher bringen."
    ],
    "en": [
      "Discover the Monts du Lyonnais through a fun and free geocaching experience! In Chevrières, go on a hunt for Graâl, who knows nothing about history and monuments. He and the other Gnolus will help you discover the history of the village."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais attraverso un'esperienza di geocaching divertente e gratuita! A Chevrières, andate a caccia di Graâl, che non sa nulla di storia e monumenti. Lui e gli altri Gnolus vi aiuteranno a scoprire la storia del villaggio."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais à travers une expérience ludique et gratuite de géocaching ! A Chevrières, partez à la chasse de Graâl, incollable sur l'histoire et les monuments. Lui et les autres Gnolus vous feront découvrir l'histoire du village."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais via een leuke en gratis geocaching-ervaring! Ga in Chevrières op jacht naar Graâl, die niets weet van geschiedenis en monumenten. Hij en de andere Gnolus zullen je helpen de geschiedenis van het dorp te ontdekken."
    ],
    "es": [
      "Descubra los Montes del Lyonnais a través de una experiencia de geocaching divertida y gratuita En Chevrières, vaya a la caza de Graâl, que no sabe nada de historia ni de monumentos. Él y los otros Gnolus te ayudarán a descubrir la historia del pueblo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Le roi, c'est moi !"
    ]
  },
