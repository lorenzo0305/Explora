  "rdfs:comment": {
    "de": [
      "Die Boutique artisane umfasst ein lokales Kollektiv von Handwerkern und Künstlern aus CHaise-Dieu (das CLAACH), das zahlreiche Aktivitäten ausübt (Kostüme, Illustration, Gravur....). Entdecken Sie ihr Atelier."
    ],
    "en": [
      "La Boutique Artisane is a Local Collective of Craftsmen and Artists of the CHaise-dieu (CLAACH) practicing many activities (costumes, illustration, engraving....). Discover their workshop."
    ],
    "it": [
      "La Boutique Artisane è un Collettivo Locale di Artigiani e Artisti di La CHaise-dieu (CLAACH) che pratica numerose attività (costumi, illustrazione, incisione....). Scoprite il loro laboratorio."
    ],
    "fr": [
      "La Boutique artisane regroupe un Collectif Local d'Artisans et d'Artistes de la CHaise-dieu (le CLAACH) pratiquant de nombreuses activités (costumes, illustration, gravure....). Découvrez leur atelier."
    ],
    "nl": [
      "La Boutique Artisane is een Plaatselijk Collectief van Ambachtslieden en Kunstenaars van het CHaise-dieu (CLAACH) dat vele activiteiten uitoefent (kostuums, illustratie, gravure....). Ontdek hun werkplaats."
    ],
    "es": [
      "La Boutique Artisane es un Colectivo Local de Artesanos y Artistas del CHaise-dieu (CLAACH) que practica numerosas actividades (vestuario, ilustración, grabado....). Descubra su taller."
    ]
  },
