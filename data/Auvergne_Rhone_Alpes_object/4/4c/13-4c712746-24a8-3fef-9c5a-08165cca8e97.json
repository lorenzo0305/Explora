  "rdfs:comment": {
    "de": [
      "Entdecken Sie den hohen Norden im Herzen des Waldes des Altiports. Erleben Sie mit Ihrer Familie einen Slalom zwischen den Spielgeräten und Tieren des Packeises und genießen Sie dann eine wohlverdiente Pause im Dorf, wo die Inuit Groß und Klein mit unvergesslichen Animationen erwarten."
    ],
    "ru": [
      "Проведите незабываемые моменты в семейном кругу на трассе Инуитов! Ваши дети не перестанут фантазировать!"
    ],
    "en": [
      "Discover the Far North in the heart of the Altiport forest. Slalom between the games and peak ice animals, then have a break on the village, where the Inuits will welcome you with games and entertainments."
    ],
    "it": [
      "Scoprite l'Estremo Nord nel cuore della foresta di Altiport. Fate lo slalom con la vostra famiglia tra i giochi e gli animali della banchisa, poi godetevi una meritata sosta nel villaggio dove gli Inuit aspettano grandi e piccini con un'animazione indimenticabile."
    ],
    "fr": [
      "Découvrez le Grand Nord au cœur de la forêt de l'Altiport. Slalomez en famille entre les jeux et animaux de la banquise puis profitez d'une halte bien méritée sur le village où les Inuits attendent petits et grands autour d'animations inoubliables."
    ],
    "nl": [
      "Ontdek het Grote Noorden in het hart van het bos van Altiport. Slalom met uw gezin tussen de spelen en dieren van de ijsschots, en geniet vervolgens van een welverdiende stop in het dorp waar de Inuit jong en oud opwachten met onvergetelijk entertainment."
    ],
    "es": [
      "Descubra el Lejano Norte en el corazón del bosque de Altiport. Practica el eslalon en familia entre los juegos y animales de la banquisa, y luego disfruta de una merecida parada en el pueblo, donde los inuit esperan a grandes y pequeños con espectáculos inolvidables."
    ]
  },
  "rdfs:label": {
    "ru": [
      "Трасса Инуитов"
    ],
    "en": [
      "The Inuits Piste"
    ],
