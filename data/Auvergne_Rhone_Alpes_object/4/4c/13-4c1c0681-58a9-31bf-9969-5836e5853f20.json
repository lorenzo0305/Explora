  "rdfs:comment": {
    "de": [
      "Das Théâtre des Pénitents ist das Echo einer lebendigen lokalen Musik- und Theaterszene und bietet ein qualitativ hochwertiges, vielfältiges Programm, in dem viele bekannte und anerkannte Künstler auftreten."
    ],
    "en": [
      "“Penitents” theatre, a musical and theatre scene offer quality performances with renowned and well known artists."
    ],
    "it": [
      "Il Théâtre des Pénitents riflette l'effervescente scena musicale e teatrale locale attraverso un programma di qualità e diversificato, con una serie di artisti noti e riconosciuti."
    ],
    "fr": [
      "Le Théâtre des Pénitents se fait l'écho d'une scène musicale et théâtrale locale effervescente à travers une programmation de qualité, diversifiée où se côtoient bon nombre d'artistes connus et reconnus."
    ],
    "nl": [
      "Het Théâtre des Pénitents weerspiegelt de bruisende lokale muziek- en theaterwereld door middel van een kwalitatief en gediversifieerd programma met een aantal bekende en erkende artiesten."
    ],
    "es": [
      "El Théâtre des Pénitents refleja la efervescencia de la escena musical y teatral local a través de una programación de calidad y diversificada que cuenta con numerosos artistas conocidos y reconocidos."
    ]
  },
