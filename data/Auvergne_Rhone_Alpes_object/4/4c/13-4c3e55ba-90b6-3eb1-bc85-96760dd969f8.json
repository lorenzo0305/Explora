          "additionalInformation": {
            "de": [
              "Spa das ganze Jahr über geöffnet\r\nIn der Sommer- und Wintersaison täglich von 9:30 bis 19:30 Uhr\r\nIn der Zwischensaison (April bis Juni und September bis Dezember) freitags, samstags und sonntags auf Reservierung geöffnet"
            ],
            "en": [
              "Spa open all year round\r\nIn summer and winter, daily from 9:30 a.m. to 7:30 p.m\r\nIn the off-season (April to June and September to December), open Fridays, Saturdays and Sundays by prior arrangement"
            ],
            "it": [
              "Spa aperta tutto l'anno\r\nIn estate e in inverno, tutti i giorni dalle 9.30 alle 19.30\r\nFuori stagione (da aprile a giugno e da settembre a dicembre), aperto il venerdì, il sabato e la domenica su prenotazione"
            ],
            "fr": [
              "Spa ouvert toute l’année \r\nEn Saison été et hiver, tous les jours de 9 h 30 à 19 h 30 \r\nEn inter-saison (d’avril à juin et de septembre à décembre), ouverts les vendredis, samedis et dimanches sur réservation"
            ],
            "nl": [
              "Spa het hele jaar geopend\r\nIn zomer en winter, elke dag van 9.30 tot 19.30 uur\r\nBuiten het seizoen (april tot juni en september tot december), open op vrijdag, zaterdag en zondag op afspraak"
            ],
            "es": [
              "Spa abierto todo el año\r\nEn verano e invierno, todos los días de 9.30 a 19.30 h\r\nFuera de temporada (de abril a junio y de septiembre a diciembre), abierto viernes, sábados y domingos con cita previa"
            ]
          },
