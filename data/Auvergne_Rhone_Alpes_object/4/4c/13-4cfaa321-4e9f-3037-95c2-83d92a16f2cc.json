  "rdfs:comment": {
    "de": [
      "Skischule für Alpin- und Langlaufski, Snowboard, Schneeschuhwandern und Telemarken. \r\nZwei Büros stehen Ihnen zur Verfügung: eins im Dorfzentrum von Crest-Voland (hinter der Kirche) und ein Büroanbau auf der Place du Cernix. Die Kurse starten in Cernix und in Crest-Voland."
    ],
    "en": [
      "Ski and snowboard school. Cross-country skiing, snowshoeing, telemarking also available.  There are two offices, one in the centre of Crest-Voland (behind the church) and a sub-office at Place du Cernix.  Assembly points for lessons are at both Cernix and Crest-Voland."
    ],
    "it": [
      "Sci alpino e di fondo, snowboard, racchette da neve e telemark.\r\nDue uffici a disposizione: uno nel centro del villaggio di Crest-Voland (dietro la chiesa) e un secondo ufficio in Place du Cernix. Le lezioni iniziano a Cernix e a Crest-Voland."
    ],
    "fr": [
      "Ecole de ski alpin et fond, snowboard, raquettes, télémark.\r\nDeux bureaux à votre disposition : un au centre-village de Crest-Voland (derrière l'église) et un bureau annexe sur la place du Cernix. Les départs des cours ont lieu au Cernix et à Crest-Voland."
    ],
    "nl": [
      "Skiën, langlaufen, snowboarden, sneeuwschoenwandelen en telemarken.\r\nTwee kantoren tot uw beschikking: één in het dorpscentrum van Crest-Voland (achter de kerk) en een tweede kantoor op de Place du Cernix. De lessen beginnen bij Cernix en Crest-Voland."
    ],
    "es": [
      "Escuela de esquí alpino y de fondo, de snowboard, de raquetas de nieve y de telemark.\r\nDos oficinas a su disposición: una en el centro del pueblo de Crest-Voland (detrás de la iglesia) y una segunda oficina en la Place du Cernix. Las clases comienzan en Cernix y Crest-Voland."
    ]
  },
  "rdfs:label": {
