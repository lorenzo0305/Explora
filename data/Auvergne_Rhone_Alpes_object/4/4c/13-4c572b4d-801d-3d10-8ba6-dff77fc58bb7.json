  "rdfs:comment": {
    "de": [
      "Im Espace de Vie Sociale beginnt das neue Schuljahr und es werden wieder die üblichen Workshops angeboten, darunter Stricken und Häkeln.\r\nJeden ersten Mittwoch im Monat."
    ],
    "en": [
      "It's back to work at the Espace de Vie Sociale, with recurring workshops including knitting and crochet.\r\nEvery first Wednesday of the month."
    ],
    "it": [
      "All'Espace de Vie Sociale si ricomincia a lavorare e tornano i laboratori regolari, tra cui quelli di maglia e uncinetto.\r\nOgni primo mercoledì del mese."
    ],
    "fr": [
      "C’est la rentrée à l’Espace de Vie Sociale, on retrouve les ateliers récurrents  dont le tricot et crochet.\r\nTous les premiers mercredis de chaque mois."
    ],
    "es": [
      "Vuelve el trabajo al Espace de Vie Sociale, y vuelven los talleres habituales, incluidos los de punto y ganchillo.\r\nTodos los primeros miércoles de mes."
    ],
    "nl": [
      "Er wordt weer gewerkt in de Espace de Vie Sociale en de reguliere workshops zijn weer terug, inclusief breien en haken.\r\nElke eerste woensdag van de maand."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cafébib'-atelier tricot et crochet"
    ]
  },
