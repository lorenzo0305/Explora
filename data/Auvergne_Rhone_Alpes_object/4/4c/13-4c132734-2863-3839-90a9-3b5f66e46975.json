  "rdfs:comment": {
    "de": [
      "Hochzeit, Geburtstag, Einweihungsparty... Genießen Sie Ihre Veranstaltung ganz entspannt und teilen Sie leckere Galettes mit Ihren Gästen. Die mobile Crêperie ist vollständig ausgestattet und autonom. Buchen Sie es jetzt!"
    ],
    "en": [
      "Weddings, birthdays, house-warmings... Enjoy your event with peace of mind, sharing gourmet galettes with your guests. The mobile crêperie is fully equipped and self-contained. Book it now!"
    ],
    "it": [
      "Matrimonio, compleanno, festa di inaugurazione della casa? Godetevi il vostro evento in tutta tranquillità, condividendo pancake gourmet con i vostri ospiti. La crêperie mobile è completamente attrezzata e autonoma. Prenotate subito!"
    ],
    "fr": [
      "Mariage, anniversaire, crémaillère… Profitez de votre évènement sereinement, en partageant des galettes gourmandes avec vos invités. La crêperie mobile est entièrement équipée et autonome. Réservez-là dès maintenant !"
    ],
    "es": [
      "¿Boda, cumpleaños, fiesta de inauguración? Disfrute de su evento con tranquilidad, compartiendo tortitas gourmet con sus invitados. La crepería móvil está totalmente equipada y es autónoma. ¡Resérvelo ahora!"
    ],
    "nl": [
      "Bruiloften, verjaardagen, house-warming party's... Geniet met een gerust hart van uw evenement en deel met uw gasten heerlijke pannenkoeken. De mobiele crêperie is volledig uitgerust en autonoom. Boek het nu!"
    ]
  },
