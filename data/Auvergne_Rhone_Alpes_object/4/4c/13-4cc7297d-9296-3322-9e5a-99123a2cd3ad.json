  "rdfs:comment": {
    "de": [
      "Handwerkliches Besteck, Hersteller des Messers \"Le Murat\". Das Messer \"Le Murat\" ist ein Modell und eine eingetragene Marke, die es als Taschenmesser, Korkenzieher, Tafelmesser, aber auch als Tafelgabeln gibt."
    ],
    "en": [
      "Artisan cutlery, manufacturer of the \"Le Murat\" knife. The \"Le Murat\" knife is a registered design and trademark, available in pocket knives, corkscrews, table knives and table forks."
    ],
    "it": [
      "Coltelleria artigianale, produttrice del coltello \"Le Murat\". Il coltello \"Le Murat\" è un modello e un marchio registrato, disponibile in coltelli da tasca, cavatappi, coltelli da tavola, ma anche in forchette da tavola."
    ],
    "fr": [
      "Coutellerie artisanale, fabricant du couteau \"Le Murat\". Le couteau \"Le Murat\" est un modèle et une marque déposée, décliné en couteaux de poches, en tire-bouchons, en couteaux de table, mais également en fourchettes de table."
    ],
    "es": [
      "Cuchillería artesanal, fabricante del cuchillo \"Le Murat\". La navaja \"Le Murat\" es un modelo y una marca registrada, disponible en navajas, sacacorchos y cuchillos de mesa, pero también en tenedores de mesa."
    ],
    "nl": [
      "Ambachtelijk bestek, fabrikant van het \"Le Murat\" mes. Het \"Le Murat\" mes is een model en een gedeponeerd handelsmerk, verkrijgbaar in zakmessen, kurkentrekkers, tafelmessen, maar ook in tafelvorken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Murat\" cutlery"
    ],
    "fr": [
      "Coutellerie \"Le Murat\""
    ]
  },
