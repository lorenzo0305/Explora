  "rdfs:comment": {
    "de": [
      "Mit diesem Bus können Sie von Saint-Étienne (vor dem SNCF-Bahnhof) zu den Gemeinden Chambon-sur-Lignon (Place des Balayes) und Tence (Place de l'Hôtel de Ville) fahren"
    ],
    "en": [
      "This bus takes you from Saint-Étienne (in front of the SNCF train station) to Le Chambon-sur-Lignon (place des Balayes) and Tence (place de l'Hôtel de Ville)"
    ],
    "it": [
      "Questo autobus vi porterà da Saint-Étienne (davanti alla stazione SNCF) a Le Chambon-sur-Lignon (place des Balayes) e a Tence (place de l'Hôtel de Ville)"
    ],
    "fr": [
      "Ce bus vous permet de vous rendre depuis Saint-Étienne (devant la gare SNCF)  à la commune du Chambon-sur-Lignon (place des Balayes) et de Tence  (place de l'Hôtel de Ville)"
    ],
    "es": [
      "Este autobús le llevará desde Saint-Étienne (frente a la estación SNCF) hasta Le Chambon-sur-Lignon (place des Balayes) y Tence (place de l'Hôtel de Ville)"
    ],
    "nl": [
