  "rdfs:comment": {
    "de": [
      "In Begleitung des Vereins \"Robins des dunes\" (Dünenroboter) kannst du diese symbolträchtige Aktivität des Ortes ausprobieren.\n\nAb einem Alter von 7 Jahren.\nAnmeldung im Tourismusbüro."
    ],
    "en": [
      "In the company of the Robins des Dunes association, come and try out this emblematic activity of the resort.\n\nFrom 7 years old.\nRegistration at the Tourist Office."
    ],
    "it": [
      "In compagnia dell'associazione Robins des dunes, venite a provare questa attività emblematica della località.\n\nPer bambini a partire dai 7 anni.\nIscrizione presso l'Ufficio del Turismo."
    ],
    "fr": [
      "En compagnie de l'association des Robins des dunes, viens tester cette activité emblématiques de la station.\n\nA partir de 7ans.\nInscription à l'Office de Tourisme."
    ],
    "nl": [
      "Kom in gezelschap van de vereniging Robins des dunes deze emblematische activiteit van het resort uitproberen.\n\nVoor kinderen vanaf 7 jaar.\nInschrijving bij het toeristenbureau."
    ],
    "es": [
      "En compañía de la asociación Robins des dunes, venga a probar esta actividad emblemática de la estación.\n\nPara niños a partir de 7 años.\nInscripciones en la Oficina de Turismo."
    ]
  },
