  "rdfs:comment": {
    "de": [
      "Das ideal am Fuße der Piste gelegene L'Escale empfängt Sie mittags für schnelle Mahlzeiten oder regionale Gerichte für die Feinschmecker unter Ihnen.\r\nAbends bieten wir Ihnen savoyische Spezialitäten und eine abwechslungsreiche Speisekarte."
    ],
    "en": [
      "Ideally located at the foot of the slope, l'Escale welcomes you at lunchtime for quick meals, or for regional dishes for the more gourmet.\r\nIn the evening we offer Savoyard specialities and a varied menu."
    ],
    "it": [
      "Situato in posizione ideale ai piedi della pista, l'Escale vi accoglie all'ora di pranzo per pasti veloci o per piatti regionali per i più golosi.\r\nLa sera offriamo specialità savoiarde e un menù vario."
    ],
    "fr": [
      "Idéalement situé en pied de piste, l’Escale vous accueille le midi pour des repas rapides, ou pour des plats régionaux pour les plus gourmands.\r\nLe soir nous vous proposons des spécialités savoyardes et une carte très variée."
    ],
    "es": [
      "Idealmente situado a pie de pista, l'Escale le acoge a la hora del almuerzo para comidas rápidas, o para platos regionales para los más sibaritas.\r\nPor la noche, ofrecemos especialidades saboyanas y un menú variado."
    ],
    "nl": [
      "Ideaal gelegen aan de voet van de piste, verwelkomt l'Escale u 's middags voor een snelle maaltijd, of voor streekgerechten voor de meer fijnproevers.\r\ns Avonds bieden wij u specialiteiten uit de Savoie en een gevarieerd menu."
    ]
  },
