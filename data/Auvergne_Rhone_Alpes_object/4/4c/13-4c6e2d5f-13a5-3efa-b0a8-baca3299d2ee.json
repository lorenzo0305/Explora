  "rdfs:comment": {
    "de": [
      "Das Comité d'Animation de Saint-Nazaire-en-Royans ist ein dynamischer Verein, der sich der Organisation von Veranstaltungen und kulturellen, sportlichen und festlichen Aktivitäten widmet, um das örtliche Leben zu beleben. Durch Feste, Märkte und Konzerte schafft das Komitee Verbindungen."
    ],
    "en": [
      "The Comité d'Animation de Saint-Nazaire-en-Royans is a dynamic association dedicated to organizing cultural, sporting and festive events and activities to liven up local life. Through festivals, markets and concerts, the committee creates links."
    ],
    "it": [
      "Il Comitato di animazione di Saint-Nazaire-en-Royans è un'associazione dinamica che si dedica all'organizzazione di eventi e attività culturali, sportive e festive per animare la vita locale. Attraverso festival, mercati e concerti, il comitato crea legami tra le persone."
    ],
    "fr": [
      "Le Comité d'Animation de Saint-Nazaire-en-Royans est une association dynamique dédiée à l'organisation d'événements et d'activités culturelles, sportives et festives pour animer la vie locale. À travers fêtes, marchés et concerts le comité crée du lien."
    ],
    "nl": [
      "Het Comité d'Animation de Saint-Nazaire-en-Royans is een dynamische vereniging die culturele, sportieve en feestelijke evenementen en activiteiten organiseert om het plaatselijke leven te verlevendigen. Door middel van festivals, markten en concerten creëert het comité banden tussen mensen."
    ],
    "es": [
      "El Comité de Animación de Saint-Nazaire-en-Royans es una asociación dinámica dedicada a organizar eventos y actividades culturales, deportivas y festivas para animar la vida local. A través de festivales, mercados y conciertos, el comité crea vínculos entre las personas."
    ]
  },
