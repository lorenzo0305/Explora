  "rdfs:comment": {
    "de": [
      "Selbstbedienungsrestaurant mit Bar, Panoramablick; Lage auf 1720 m Höhe, erreichbar für Wanderer und Skiläufer mit der Kabinenbahn „Cote 2000“."
    ],
    "en": [
      "Located 1720 m away and accessible to pedestrians and skiers via the Cote 2000 gondola lift: Self-service restaurant, bar, panoramic view."
    ],
    "it": [
      "Un appuntamento in cima! Sia d'estate che d'inverno, in cima alla telecabina Cote 2000, a 1720 m, nel dominio alpino, è possibile accedere facilmente a questo ristorante di montagna ben curato. Solarium, bar, terrazza, sala panoramica, ristorante di montagna, giochi per bambini."
    ],
    "fr": [
      "Un rendez-vous au sommet ! Été comme hiver, au sommet de la télécabine Cote 2000, 1720 m, sur le domaine alpin, accédez facilement à ce restaurant d'altitude soigné. Solarium, bar, terrasse, salle panoramique, restauration de montagne, jeux d'enfants."
    ],
    "es": [
      "¡Una cita en la cima! Tanto en verano como en invierno, en la cima del telecabina Cote 2000, a 1720 m, en el dominio alpino, podrá acceder fácilmente a este cuidado restaurante de montaña. Solarium, bar, terraza, sala panorámica, restaurante de montaña, juegos para niños."
    ],
    "nl": [
      "Een rendez-vous op de top! Zowel in de zomer als in de winter, bovenaan de gondel Cote 2000, op 1720 m, in het domein van de Alpen, kunt u dit verzorgde bergrestaurant gemakkelijk bereiken. Solarium, bar, terras, panoramazaal, bergrestaurant, kinderspelen."
    ]
  },
