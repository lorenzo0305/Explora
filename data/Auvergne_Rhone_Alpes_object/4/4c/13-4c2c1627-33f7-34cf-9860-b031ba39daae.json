  "rdfs:comment": {
    "de": [
      "Dieser Klettersteig ist der erste in Savoir ausgestattete Klettersteig im Herzen von Valloire. Er ist ideal für Anfänger mit Kindern. Er bietet Ihnen zwei Ausstiegsmöglichkeiten.\r\nEs gibt zwei mögliche Routen: die Höhlenroute und die Plattenroute."
    ],
    "en": [
      "In the heart of Valloire, this via ferrata is ideal for beginners, with children. It will offer you two exit options.\r\nTwo routes are possible, the cave route and the slab route."
    ],
    "it": [
      "La prima via ferrata attrezzata in Savoir, nel cuore di Valloire, è ideale per i principianti e i bambini. Offre due possibilità di uscita.\r\nSono possibili due percorsi, quello in grotta e quello in lastra."
    ],
    "fr": [
      "Première via ferrata équipée en Savoir, au cœur de Valloire, ce parcours est idéal pour l'initiation, avec des enfants. Elle vous offrira deux options de sortie.\r\nDeux voies sont possible, la voie de la grotte et la voie des dalles."
    ],
    "es": [
      "Primera vía ferrata equipada en Savoir, en el corazón de Valloire, este recorrido es ideal para principiantes con niños. Le ofrecerá dos opciones de salida.\r\nDos recorridos son posibles, el de la cueva y el de las losas."
    ],
    "nl": [
      "De eerste klettersteig in Savoir, in het hart van Valloire, is ideaal voor beginners met kinderen. Het biedt twee uitstapmogelijkheden.\r\nEr zijn twee routes mogelijk, de grotroute en de plaatroute."
    ]
  },
  "rdfs:label": {
    "en": [
      "Poingt Ravier via ferrata"
    ],
    "fr": [
      "Via ferrata de Poingt Ravier"
    ],
    "nl": [
      "Klettersteig bij Poingt Ravier"
    ]
  },
