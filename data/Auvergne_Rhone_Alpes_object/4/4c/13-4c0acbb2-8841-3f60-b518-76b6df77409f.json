  "rdfs:comment": {
    "de": [
      "Shopping-Fans aufgepasst, die besten Schnäppchen gibt es in der Marques Avenue!\r\nDas Marques-Dorf vor den Toren der Provence! 90 Boutiquen für Mode und Hausrat: Konfektionskleidung, Schuhe, Dessous, Lederwaren, Accessoires, Hausrat..."
    ],
    "en": [
      "If you're a shopping enthusiast, you'll find great deals at Marques Avenue!\r\nThe village of Marques at the gateway to Provence! More of 80 fashion and home boutiques: ready-to-wear, shoes, lingerie, leather goods, accessories, home furnishings..."
    ],
    "it": [
      "Se siete appassionati di shopping, a Marques Avenue potrete fare affari!\r\nIl villaggio di Marques alle porte della Provenza! Oltre 80 boutique di moda e articoli per la casa: prêt-à-porter, scarpe, lingerie, pelletteria, accessori, arredamento..."
    ],
    "fr": [
      "Avis aux amateurs de shopping, les bonnes affaires sont à Marques Avenue !\r\nLe village de Marques aux portes de la Provence ! Plus de 80 boutiques mode et maison : Prêt à porter, chaussures, lingerie, maroquinerie, accessoires, équipement de la maison..."
    ],
    "es": [
      "Si le gustan las compras, ¡en la avenida Marques encontrará gangas!\r\nEl pueblo de Marques, a las puertas de la Provenza Más de 80 boutiques de moda y hogar: prêt-à-porter, zapatos, lencería, marroquinería, accesorios, menaje del hogar..."
    ],
    "nl": [
      "Als je van winkelen houdt, kun je een koopje doen in Marques Avenue!\r\nHet dorp Marques aan de poort van de Provence! 90 mode- en woonboetieks: confectie, schoenen, lingerie, lederwaren, accessoires, woninginrichting..."
    ]
  },
