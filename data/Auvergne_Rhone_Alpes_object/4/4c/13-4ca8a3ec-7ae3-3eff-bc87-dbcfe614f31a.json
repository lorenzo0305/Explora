  "rdfs:comment": {
    "de": [
      "Das Département Drôme bietet in den Bibliotheken und Mediatheken der Region Drôme einen Schreibwettbewerb an. In der Mediathek Drôme des collines wird ein Schreibzimmer angeboten, um den Schreibwettbewerb, bei dem Ihre Worte zum Leben erweckt werden, aufzuwerten."
    ],
    "en": [
      "The Département de la Drôme is offering a writing competition in its libraries and media libraries. A writing room will be available at the Drôme des collines media library to promote the writing competition, where your words come to life."
    ],
    "it": [
      "Il Dipartimento della Drôme propone un concorso di scrittura nelle sue biblioteche e mediateche. Presso la mediateca Drôme des collines sarà allestita una sala di scrittura per presentare il concorso di scrittura, dove le vostre parole prenderanno vita."
    ],
    "fr": [
      "Le Département de la Drôme propose un concours d'écriture dans les bibliothèques et médiathèques drômoises. Une chambre d'écriture sera proposée à la médiathèque Drôme des collines pour valoriser le concours d’écriture où vos mots prennent vie."
    ],
    "nl": [
      "Het departement Drôme organiseert een schrijfwedstrijd in zijn bibliotheken en mediatheken. In de mediatheek van Drôme des collines zal een schrijfzaal worden ingericht om de schrijfwedstrijd te presenteren, waar je woorden tot leven komen."
    ],
    "es": [
      "El Département de la Drôme propone un concurso de escritura en sus bibliotecas y mediatecas. En la mediateca de la Drôme des collines se ofrecerá una sala de escritura para presentar el concurso de escritura, donde tus palabras cobran vida."
    ]
  },
  "rdfs:label": {
    "fr": [
