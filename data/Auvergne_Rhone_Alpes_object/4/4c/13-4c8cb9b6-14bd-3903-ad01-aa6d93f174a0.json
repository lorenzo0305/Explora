  "rdfs:comment": {
    "de": [
      "Das Refuge du Lachat liegt im Herzen des Gemeindewaldes von Crest-Voland in der Nähe der blauen Piste Les Bâches und bietet den idealen Rahmen für eine kulinarische Auszeit mit Ihren Lieben. Familiäre Atmosphäre, sonnige Terrasse und hausgemachte Küche."
    ],
    "en": [
      "Located in the heart of the Crest-Voland communal forest near the blue run of Les Bâches, the Refuge du Lachat offers the ideal setting for a gourmet break with your loved ones. Family atmosphere, sunny terrace and home cooking."
    ],
    "it": [
      "Situato nel cuore della foresta comunale di Crest-Voland, vicino alla pista blu di Bâches, il Refuge du Lachat offre la cornice ideale per una pausa gourmet con i vostri cari. Atmosfera familiare, terrazza soleggiata e cucina casalinga."
    ],
    "fr": [
      "Situé au cœur de la forêt communale de Crest-Voland proche de la piste bleue des Bâches, le Refuge du Lachat offre le cadre idéal pour une pause gourmande avec ceux que vous aimez. Ambiance familiale, terrasse ensoleillée et cuisine maison."
    ],
    "es": [
      "Situado en el corazón del bosque municipal de Crest-Voland, cerca de la pista azul de Bâches, el Refuge du Lachat ofrece el marco ideal para una escapada gastronómica con los suyos. Ambiente familiar, terraza soleada y cocina casera."
    ],
    "nl": [
      "De Refuge du Lachat, gelegen in het hart van het gemeentebos van Crest-Voland, vlakbij de blauwe piste van Bâches, biedt de ideale omgeving voor een gastronomische vakantie met uw geliefden. Familiale sfeer, zonnig terras en huiselijke keuken."
    ]
  },
