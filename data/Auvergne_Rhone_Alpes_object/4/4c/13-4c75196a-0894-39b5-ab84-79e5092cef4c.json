  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit Ihrer Familie das Kulturerbe des Allier auf spielerische und pädagogische Weise mit PÉPIT!\r\nLaden Sie die App herunter, wählen Sie den Spaziergang in Montaiguët-en-Forez, beantworten Sie die Rätsel und finden Sie den Schatz!"
    ],
    "en": [
      "Discover the Allier region's heritage in a fun and educational way with PÉPIT!\r\nDownload the app, select the Montaiguët-en-Forez walk, answer the riddles and find the treasure!"
    ],
    "it": [
      "Scoprite il patrimonio dell'Allier in famiglia in modo divertente ed educativo con PÉPIT!\r\nScaricate l'applicazione, selezionate la passeggiata Montaiguët-en-Forez, rispondete agli indovinelli e trovate il tesoro!"
    ],
    "fr": [
      "Découvrez le patrimoine de l'Allier en famille de façon ludique et pédagogique avec PÉPIT !\r\nTéléchargez l'application, sélectionnez la balade de Montaiguët-en-Forez, répondez aux énigmes et trouvez le trésor !"
    ],
    "es": [
      "¡Descubra el patrimonio del Allier en familia de forma lúdica y pedagógica con PÉPIT!\r\nDescargue la aplicación, seleccione el paseo de Montaiguët-en-Forez, responda a las adivinanzas y ¡encuentre el tesoro!"
    ],
    "nl": [
      "Ontdek met het gezin het erfgoed van de Allier op een leuke en leerzame manier met PÉPIT!\r\nDownload de applicatie, kies de wandeling Montaiguët-en-Forez, beantwoord de raadsels en vind de schat!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "PÉPIT : Sauvez la Bénisson-Dieu"
    ]
  },
