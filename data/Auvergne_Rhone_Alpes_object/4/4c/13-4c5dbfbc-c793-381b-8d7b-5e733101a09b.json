  "rdfs:comment": {
    "de": [
      "Der Fluss \"Allier\" ist ein wichtiger Bestandteil des Departements und hat seinen wilden und freien Charakter bewahrt. Er ist im Bereich von Saint-Loup bis Toulon s/Allier als Naturschutzgebiet ausgewiesen."
    ],
    "en": [
      "Major element of the department, the river \"Allier\" has kept its wild and free character. It is classified as a natural reserve in the sector of Saint-Loup in Toulon s/Allier."
    ],
    "it": [
      "Elemento fondamentale del dipartimento, il fiume \"Allier\" ha mantenuto il suo carattere selvaggio e libero. È classificata come riserva naturale nel settore di Saint-Loup a Tolone s/Allier."
    ],
    "fr": [
      "Élément majeur du département, la rivière \"Allier\" a gardé son caractère sauvage et libre. Elle est classée en Réserve naturelle sur le secteur de Saint-Loup à Toulon s/Allier."
    ],
    "es": [
      "Elemento principal del departamento, el río \"Allier\" ha conservado su carácter salvaje y libre. Está clasificada como reserva natural en el sector de Saint-Loup en Toulon s/Allier."
    ],
    "nl": [
      "Een belangrijk element van het departement, de rivier \"Allier\" heeft zijn wilde en vrije karakter behouden. Het is geklasseerd als natuurreservaat in de sector Saint-Loup in Toulon s/Allier."
    ]
  },
  "rdfs:label": {
