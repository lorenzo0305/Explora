  "rdfs:comment": {
    "de": [
      "Vom Caveau de Chautagne in Ruffieux aus können Sie einen Rundgang zum Thema Weinbau und Wein in der Chautagne \"von den Ursprüngen bis heute\" unternehmen.\r\nHistorische und architektonische Besichtigung der Kirche bei besonderen Anlässen: Nacht der Kirchen, Tage des Kulturerbes..."
    ],
    "en": [
      "From the Caveau de Chautagne in Ruffieux, a tour on the theme of Vines and wine in Chautagne \"from the origins to today\".\r\nHistorical and architectural tours of the church on special occasions: Nuit des églises, Journées du Patrimoine..."
    ],
    "it": [
      "Dal Caveau de Chautagne di Ruffieux, una visita sul tema della vite e del vino nella regione della Chautagne \"dalle origini ai giorni nostri\".\r\nVisite storiche e architettoniche della chiesa in occasioni speciali: Notte della Chiesa, Giornate del Patrimonio, ecc."
    ],
    "fr": [
      "A partir du Caveau de Chautagne à Ruffieux, visite sur le thème de la Vigne et le vin en Chautagne « des origines à aujourd'hui ».\r\nVisite historique et architecturale de l'église lors d'occasion particulières : Nuit des églises, Journées du Patrimoine..."
    ],
    "nl": [
      "Vanuit de Caveau de Chautagne in Ruffieux, een rondleiding over het thema wijnstokken en wijn in de Chautagne \"van de oorsprong tot nu\".\r\nHistorische en architecturale rondleidingen in de kerk bij speciale gelegenheden: Kerkennacht, Open Monumentendagen, enz."
    ],
    "es": [
      "Desde el Caveau de Chautagne en Ruffieux, visita sobre el tema de la vid y el vino en Chautagne \"desde los orígenes hasta hoy\".\r\nVisita histórica y arquitectónica de la iglesia en ocasiones especiales: Noche de la Iglesia, Jornadas del Patrimonio..."
    ]
  },
