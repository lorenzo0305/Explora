      "@id": "https://data.datatourisme.fr/e1b5a9cc-0e9b-3d57-9b3a-7130dab27b94",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 12:00 Uhr\n\nSonntag geschlossen\n\nAbholung :\n\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Friday, 9am to 12pm and 2pm to 7pm\nSaturday from 9h to 12h\n\nClosed on Sunday\n\nPick-up :\n\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 12.00\n\nChiuso la domenica\n\nRitiro:\n\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au vendredi de 9h à 12h et de 14h à 19h\nLe samedi de 9h à 12h\n\nFermeture le dimanche\n\nRetrait :\n\nAux horaires d'ouverture de l'officine\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot vrijdag van 9u tot 12u en van 14u tot 19u\nZaterdag van 9u tot 12u\n\nZondag gesloten\n\nOphalen:\n\nTijdens openingstijden van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a viernes de 9h a 12h y de 14h a 19h\nSábado de 9h a 12h\n\nDomingo cerrado\n\nRecogida:\n\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
