  "rdfs:comment": {
    "de": [
      "Die Auberge de Planzolles liegt auf den schattigen Terrassen eines uralten Kastanienwaldes und bietet Ihnen eine Küche mit lokalen Aromen, eine Bar mit hausgemachten Cocktails, Weinen und Bieren aus der Region sowie einen Lebensmittelladen."
    ],
    "en": [
      "The Auberge de Planzolles, nestled on the shady terraces of an ancestral chestnut grove, offers a restaurant with local flavors, a bar with house cocktails, wines and beers from the region, and a grocery store."
    ],
    "it": [
      "L'Auberge de Planzolles, adagiato sulle terrazze ombreggiate di un castagneto ancestrale, offre cucina locale, un bar con cocktail della casa, vini e birre regionali e un negozio di alimentari."
    ],
    "fr": [
      "L’Auberge de Planzolles, nichée sur les terrasses ombragées d’une châtaigneraie ancestrale, vous propose une cuisine aux saveurs locales, un bar avec cocktails maison, vins et bières de la région, ainsi qu'une épicerie."
    ],
    "es": [
      "El Auberge de Planzolles, situado en las sombreadas terrazas de un castañar ancestral, ofrece cocina local, un bar con cócteles de la casa, vinos y cervezas regionales y una tienda de comestibles."
    ],
    "nl": [
      "De Auberge de Planzolles, genesteld op de schaduwrijke terrassen van een voorouderlijk kastanjebos, biedt lokale gerechten, een bar met huiscocktails, regionale wijnen en bieren, en een kruidenierswinkel."
    ]
  },
