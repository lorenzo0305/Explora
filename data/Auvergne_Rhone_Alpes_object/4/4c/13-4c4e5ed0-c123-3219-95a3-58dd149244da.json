  "rdfs:comment": {
    "de": [
      "In einer ruhigen Umgebung, in der Nähe des Parks Walibi Rhône-Alpes und der Fahrradroute ViaRhôna, bietet dieses familiäre und traditionelle Hotel-Restaurant atypische, geräumige und komfortable Zimmer in einer ehemaligen napoleonischen Poststation."
    ],
    "en": [
      "Situated in a peaceful setting close to the Walibi Rhône-Alpes park and the ViaRhôna cycle route, this traditional family-run hotel-restaurant offers intimate yet spacious and comfortable rooms."
    ],
    "it": [
      "In un ambiente tranquillo, vicino al parco Walibi Rhône-Alpes e alla pista ciclabile ViaRhôna, questo tradizionale hotel-ristorante a conduzione familiare offre camere spaziose e confortevoli in un'insolita ex locanda napoleonica."
    ],
    "fr": [
      "Dans un environnement calme, à proximité du parc Walibi Rhône-Alpes et de l'itinéraire cyclable ViaRhôna, cet hôtel-restaurant familial et traditionnel propose des chambres atypiques, spacieuses et confortables dans un ancien relais de poste napoléonien."
    ],
    "es": [
      "En un entorno tranquilo, cerca del parque Walibi Rhône-Alpes y de la ruta ciclista ViaRhôna, este tradicional hotel-restaurante familiar ofrece habitaciones espaciosas y confortables en una antigua posada napoleónica."
    ],
    "nl": [
      "Dit traditionele hotel-restaurant wordt door een familie beheerd en ligt in een rustige omgeving dicht bij het Walibi Rhône-Alpes park en de ViaRhôna fietsroute. Het biedt ruime, comfortabele kamers in een bijzondere voormalige Napoleontische herberg."
    ]
  },
