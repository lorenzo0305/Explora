  "rdfs:comment": {
    "de": [
      "Diesen Winter begrüßt Megève eine neue Adresse, die die Codes der alpinen Gastronomie auf den Kopf stellt: TIGRR POP, ein asiatisches Neo-Bistro, in dem die Geschmäcker Asiens auf die festliche Stimmung der Berge treffen."
    ],
    "en": [
      "This winter, Megève welcomes a new hotspot shaking up the codes of Alpine dining: TIGRR POP, a neo-Asian bistro where Asian flavours meet the mountains festive spirit."
    ],
    "it": [
      "Quest'inverno Megève dà il benvenuto a un nuovo locale che rivoluziona i codici della ristorazione alpina: TIGRR POP, un neo-bistrot asiatico dove i sapori dell'Asia incontrano lo spirito festoso della montagna."
    ],
    "fr": [
      "Cet hiver, Megève accueille une nouvelle adresse qui bouscule les codes de la restauration alpine : TIGRR POP, un néo-bistrot asiatique où les saveurs d’Asie rencontrent l’esprit festif de la montagne."
    ],
    "es": [
      "Este invierno, Megève acoge una nueva dirección que sacude los códigos de la restauración alpina: TIGRR POP, un neobistró asiático donde los sabores asiáticos se encuentran con el espíritu festivo de la montaña."
    ],
    "nl": [
      "Deze winter verwelkomt Megève een nieuw adres dat de codes van Alpenrestaurants opschudt: TIGRR POP, een Aziatische neobistro waar Aziatische smaken samenkomen met de feestelijke geest van de bergen."
    ]
  },
