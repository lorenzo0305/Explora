  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/975fc5d8-1ae5-3e9a-bfca-8208832b7813",
      "dc:description": {
        "de": [
          "Bei Gilles Fourmentin bekommen Sie Welsch, Fisch, Fleisch, Pasta, Pizza und Tartiflette. Eine ganz einfache Küche mit Tagesgerichten und Vorschlägen für die Woche (Verkauf zum Mitnehmen).\nAußenterrasse"
        ],
        "en": [
          "With Gilles Fourmentin you will have welsch, fish, meat, pasta, pizza and tartiflettes. A very simple kitchen with daily dishes and suggestions of the week (take away sale).\nOutdoor terrace"
        ],
        "it": [
          "Con Gilles Fourmentin avrete welsch, pesce, carne, pasta, pizze e tartiflettes. Una cucina molto semplice con piatti del giorno e proposte settimanali (da asporto).\nTerrazza esterna"
        ],
        "fr": [
          "Avec Gilles Fourmentin vous aurez du welsch, du poisson, des viandes, des pâtes, des pizzas et des tartiflettes. Une cuisine toute simple avec plats du jour et suggestions de la semaine (vente à emporter).\nTerrasse extérieure"
        ],
        "es": [
          "Con Gilles Fourmentin tendrá welsch, pescado, carne, pasta, pizzas y tartiflettes. Una cocina muy sencilla con platos diarios y sugerencias semanales (para llevar).\nTerraza al aire libre"
        ],
        "nl": [
          "Bij Gilles Fourmentin heeft u welsch, vis, vlees, pasta, pizza's en tartiflettes. Een zeer eenvoudige keuken met dagschotels en wekelijkse suggesties (afhaalmaaltijden).\nBuitenterras"
        ]
      },
      "@type": [
        "Description"
      ],
