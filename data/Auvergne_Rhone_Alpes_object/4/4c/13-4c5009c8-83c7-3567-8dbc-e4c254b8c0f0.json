  "rdfs:comment": {
    "de": [
      "Die Planchamp-Gondelbahn ist Sommer wie Winter geöffnet und bringt Sie auf den höchsten Punkt des Skigebiets auf 1900 m Höhe!"
    ],
    "en": [
      "The Planchamp gondola lift is open in summer and winter to take you to the top of the resort, at an altitude of 1900m!"
    ],
    "it": [
      "La cabinovia di Planchamp è aperta sia in estate che in inverno per portarvi in cima al resort, a 1900 metri di altitudine!"
    ],
    "fr": [
      "La télécabine de Planchamp est ouverte été comme hiver pour vous emmener sur le haut du domaine, à 1900m d'altitude !"
    ],
    "es": [
      "El telecabina de Planchamp, abierto tanto en verano como en invierno, le llevará a la cima de la estación, a 1.900 metros de altitud"
    ],
    "nl": [
      "De Planchamp gondellift is zowel in de zomer als in de winter geopend om je naar de top van het resort te brengen, op een hoogte van 1900m!"
    ]
