  "rdfs:comment": {
    "de": [
      "Papa Pizza Arc 2000 – Ihr Restaurant mit Blick auf den Mont Blanc! Genießen Sie unsere Pizzen, Pastagerichte, Burger, Salate und hausgemachten Desserts in herzlicher Atmosphäre. Ihre Pizzeria in Les Arcs 2000 – mit regionalen Weinen und Bieren für ein genussvolles Bergerlebnis!"
    ],
    "en": [
      "Papa Pizza Arc 2000, a restaurant facing Mont Blanc! Enjoy our pizzas, pastas, burgers, salads, and homemade desserts in a warm and welcoming atmosphere. Your pizzeria in Les Arcs 2000, with local wines and beers for a delicious mountain experience!"
    ],
    "it": [
      "Papa Pizza Arc 2000, un ristorante di fronte al Monte Bianco! Gustate le nostre pizze, pasta, hamburger, insalate e dessert fatti in casa in un'atmosfera calda e accogliente. La vostra pizzeria a Les Arcs 2000, con vini e birre locali per una deliziosa esperienza di montagna!"
    ],
    "fr": [
      "Papa Pizza Arc 2000, restaurant face au Mont Blanc ! Dégustez nos pizzas, pâtes, burgers, salades et desserts maison dans une ambiance chaleureuse. Votre pizzeria aux Arcs 2000, avec vins et bières locales pour un moment gourmand à la montagne !"
    ],
    "nl": [
      "Papa Pizza Arc 2000, een restaurant met uitzicht op de Mont Blanc! Geniet van onze pizza's, pasta's, burgers, salades en huisgemaakte desserts in een warme en gastvrije sfeer. Uw pizzeria in Les Arcs 2000, met lokale wijnen en bieren voor een heerlijke bergervaring!"
    ],
    "es": [
      "Papa Pizza Arc 2000, ¡restaurante frente al Mont Blanc! Disfrute de nuestras pizzas, pastas, hamburguesas, ensaladas y postres caseros en un ambiente cálido y acogedor. ¡Su pizzería en Les Arcs 2000, con vinos y cervezas locales para un momento gourmet en la montaña!"
    ]
  },
