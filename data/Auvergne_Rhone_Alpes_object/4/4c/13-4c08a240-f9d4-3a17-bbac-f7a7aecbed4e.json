  "rdfs:comment": {
    "de": [
      "Treten Sie ein in die Geschichte der königlichen Abtei von Hautecombe, einem einzigartigen Ort in Savoyen. Entdecken Sie mithilfe einer Audioführung durch die Kirche ihr reiches Erbe, ihre außergewöhnliche Architektur und ihre Kunstschätze."
    ],
    "en": [
      "Explore the history of the Royal Abbey of Hautecombe, a unique place in Savoy. Discover its rich heritage, its exceptional architecture and its artistic treasures."
    ],
    "it": [
      "Entrate nella storia dell'Abbazia reale di Hautecombe, un luogo unico della Savoia. Scoprite il ricco patrimonio, l'architettura straordinaria, i suoi tesori artistici."
    ],
    "fr": [
      "Entrez dans l'histoire de l'Abbaye royale d'Hautecombe, un lieu unique en Savoie. Découvrez à l'aide d'une visite audio-guidée de l'église son riche patrimoine, son architecture d'exception, ses trésors artistiques."
    ],
    "nl": [
      "Treed binnen in de geschiedenis van de Koninklijke Abdij van Hautecombe, een unieke plaats in de Savoie. Ontdek het rijke erfgoed, de uitzonderlijke architectuur en de artistieke schatten met behulp van een audiorondleiding door de kerk."
    ],
    "es": [
      "Entre en la historia de la Abadía Real de Hautecombe, un lugar único en Saboya. Descubra su rico patrimonio, su excepcional arquitectura y sus tesoros artísticos con la ayuda de una visita audioguiada a la iglesia."
    ]
  },
