  "rdfs:comment": {
    "de": [
      "Für eine Partie Tennis mit der Familie oder Kollegen stellt Ihnen der Tennisclub von Verchaix-Morillon 2 Tennisplätze zur Verfügung. Diese können in der Touristeninformation reserviert und gemietet werden."
    ],
    "en": [
      "For a game of tennis with family or friends, the tennis-club of Verchaix-Morillon offers you 2 tennis courts. These can be booked and hired at the tourist office."
    ],
    "it": [
      "Per una partita a tennis in famiglia o con i colleghi, il Tennis Club Verchaix-Morillon offre 2 campi da tennis. Questi possono essere prenotati e noleggiati presso l'ufficio turistico."
    ],
    "fr": [
      "Pour une partie de tennis en famille ou entre collègues, le tennis-club de Verchaix-Morillon met à votre disposition 2 courts de tennis. Ceux-ci peuvent être réservés et loués à l'office de tourisme."
    ],
    "nl": [
      "Voor een partijtje tennis met familie of collega's biedt de Verchaix-Morillon Tennis Club 2 tennisbanen. Deze kunnen worden gereserveerd en gehuurd bij het toeristenbureau."
    ],
    "es": [
      "Para jugar al tenis en familia o con los colegas, el Club de Tenis de Verchaix-Morillon ofrece 2 pistas de tenis. Se pueden reservar y alquilar en la oficina de turismo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tennis court in Verchaix"
    ],
    "fr": [
      "Terrains de tennis à Verchaix"
    ]
  },
