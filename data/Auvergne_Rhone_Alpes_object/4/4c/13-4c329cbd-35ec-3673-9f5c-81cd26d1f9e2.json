  "rdfs:comment": {
    "de": [
      "Erleben Sie im Iglu-Dorf Les Arcs eine einzigartige und zugleich ungewöhnliche Erfahrung: eine handgeschnitzte Eishöhle, eine vereiste Bar, ein savoyisches Fondue-Dinner oder auch eine Nacht im Iglu. Unvergessliche Erinnerungen mit der Familie, mit Freunden oder zu zweit!"
    ],
    "en": [
      "Enjoy a unique and unusual experience at the Village Igloo des Arcs: a hand-carved ice cave, a frosted bar, a Savoyard fondue dinner or a night under an igloo. Unforgettable memories for families, friends and couples!"
    ],
    "it": [
      "Godetevi un'esperienza unica e insolita al Villaggio Igloo di Les Arcs: una grotta di ghiaccio scolpita a mano, un bar ghiacciato, una cena a base di fonduta savoiarda o una notte in igloo. Ricordi indimenticabili con la famiglia, gli amici o il partner!"
    ],
    "fr": [
      "Vivez une expérience à la fois unique et insolite au Village Igloo des Arcs : une grotte de glace sculptée à la main, un bar givré, un dîner fondue savoyarde ou encore une nuit sous igloo. Des souvenirs inoubliables en famille, entre amis ou en couple !"
    ],
    "nl": [
      "Geniet van een unieke en ongewone ervaring in het Igloo Village in Les Arcs: een met de hand uitgesneden ijsgrot, een ijskoude bar, een Savoyaards fonduediner of een nacht in een iglo. Onvergetelijke herinneringen met je familie, vrienden of partner!"
    ],
    "es": [
      "Disfrute de una experiencia única e insólita en el Igloo Village de Les Arcs: una cueva de hielo tallada a mano, un bar helado, una cena de fondue saboyana o una noche en un iglú. ¡Recuerdos inolvidables con su familia, amigos o pareja!"
    ]
  },
