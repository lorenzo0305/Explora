  "rdfs:comment": {
    "de": [
      "Unser Restaurant bietet Ihnen 180 Plätze für alle Ihre Veranstaltungen:\r\n- mittags unter der Woche, eine Auswahl an Tagesgerichten und hausgemachten Desserts\r\n- abends und am Wochenende, Gruppenessen, Cocktails auf Reservierung."
    ],
    "en": [
      "Our restaurant offers 180 seats for all your events:\r\n- weekday lunchtime, a choice of daily specials and homemade desserts\r\n- evenings and weekends, group meals and cocktails by prior arrangement."
    ],
    "it": [
      "Il nostro ristorante offre 180 posti per tutti i vostri eventi:\r\n- a pranzo durante la settimana, una scelta di piatti del giorno e di dolci fatti in casa\r\n- serate e weekend, pasti di gruppo, cocktail su prenotazione."
    ],
    "fr": [
      "Notre restaurant vous propose 180 places pour tous vos événements :\r\n- le midi en semaine, un choix de plats du jour et de desserts maison\r\n- le soir et week-end, repas de groupes, cocktails sur réservation."
    ],
    "nl": [
      "Ons restaurant biedt 180 plaatsen voor al uw evenementen:\r\n- tijdens de lunch tijdens de week, een keuze uit de dagschotels en huisbereide desserts\r\n- s avonds en in het weekend, groepsmaaltijden, cocktails op reservering."
    ],
    "es": [
      "Nuestro restaurante ofrece 180 plazas para todos sus eventos:\r\n- a la hora de comer entre semana, una selección de platos del día y postres caseros\r\n- noches y fines de semana, comidas en grupo, cócteles bajo reserva."
    ]
  },
