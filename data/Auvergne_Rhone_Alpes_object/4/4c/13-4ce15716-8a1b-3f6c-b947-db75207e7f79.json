  "rdfs:comment": {
    "de": [
      "Fachgeschäft für japanische Popkultur mit Abteilungen für Mangas, Figuren, Goodies, japanisches Essen, Poster, Katanas, Disney und Harry Potter! Zögern Sie nicht, den Laden zu besuchen und sich von uns beraten zu lassen!"
    ],
    "en": [
      "Store specializing in Japanese pop culture, with sections for manga, figurines, goodies, Japanese food, posters, katanas, Disney and Harry Potter! Don't hesitate to come and discover the store and ask us for advice!"
    ],
    "it": [
      "Negozio specializzato in cultura pop giapponese, con sezioni dedicate a manga, figurine, gadget, cibo giapponese, poster, katane, Disney e Harry Potter! Non esitate a venire a vedere il negozio e a chiederci consigli!"
    ],
    "fr": [
      "Magasin spécialisé dans la pop culture nippone, avec des rayons pour les mangas, figurines, goodies, nourriture japonaise, posters, katanas, Disney et Harry Potter ! N'hésitez pas a venir découvrir la boutique et nous demander des conseils !"
    ],
    "nl": [
      "Winkel gespecialiseerd in Japanse popcultuur, met afdelingen voor manga, beeldjes, goodies, Japans eten, posters, katana's, Disney en Harry Potter! Aarzel niet om de winkel te komen bekijken en vraag ons om advies!"
    ],
    "es": [
