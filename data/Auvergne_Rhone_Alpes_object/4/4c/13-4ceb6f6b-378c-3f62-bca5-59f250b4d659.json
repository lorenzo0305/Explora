  "rdfs:comment": {
    "de": [
      "Betreten Sie einen 3000 m² großen Park mit Bäumen. Bewegen Sie sich inmitten der Tiere: Ziegen, Schweine, Gallinas, Hasenartige, Nagetiere, Reptilien, Insekten. Auf Reservierung werden verschiedene Aktivitäten angeboten, die zum Staunen anregen, um besser respektieren zu können."
    ],
    "en": [
      "Enter a 3000 m² park planted with trees. Enjoy the company of goats, pigs, gallinaceous animals, lagomorphs, rodents, reptiles and insects. A range of activities are available on reservation, to help you discover the wonders of respect."
    ],
    "it": [
      "Entrate in un parco alberato di 3000 m². Passeggiate tra gli animali: capre, maiali, gallinacei, lagomorfi, roditori, rettili e insetti. Una serie di attività sono disponibili su prenotazione, per farvi scoprire la meraviglia e il rispetto degli animali."
    ],
    "fr": [
      "Entrez dans un parc de 3000 m² arborés. Évoluez au milieu des animaux : caprins, porcins, gallinacés, lagomorphes, rongeurs, reptiles, insectes. Diverses activités sont proposées sur réservation afin de s'émerveiller pour mieux respecter."
    ],
    "es": [
      "Entre en un parque de 3000 m² plantado de árboles. Pasee entre los animales: cabras, cerdos, gallináceas, lagomorfos, roedores, reptiles e insectos. Previa reserva, se ofrecen diversas actividades para descubrir el asombro y el respeto por los animales."
    ],
    "nl": [
      "Betreed een park van 3000 m² beplant met bomen. Maak een wandeling tussen de dieren: geiten, varkens, haasachtigen, haasachtigen, knaagdieren, reptielen en insecten. Op reservering zijn er verschillende activiteiten mogelijk om je te laten kennismaken met de verwondering over en het respect voor de dieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Path'O calme : mini ferme d'animations"
    ]
  },
