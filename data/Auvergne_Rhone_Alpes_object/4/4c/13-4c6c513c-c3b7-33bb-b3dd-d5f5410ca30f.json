  "rdfs:comment": {
    "de": [
      "Der Gnolus Kompett, eine große Athletin der Gnolympischen Spiele, fordert Sie heraus, ihr beim Sturm auf die Bewaldeten Zinnen zu folgen! Sie müssen Mut beweisen, um sich in dieses sensible Naturgebiet zu wagen."
    ],
    "en": [
      "The Gnolus Kompett, great athlete of the Gnolympic Games, challenges you to follow her on the assault on the wooded ridges! You'll have to be brave to venture into this sensitive natural area."
    ],
    "it": [
      "Lo Gnolus Kompett, il grande atleta dei Giochi Gnolimpici, vi sfida a seguirlo mentre affronta le creste boscose! Dovrete essere coraggiosi per avventurarvi in questa delicata area naturale."
    ],
    "fr": [
      "Le Gnolus Kompett, grande athlète des Jeux Gnolympiques vous lance le défi de la suivre à l'assaut des crêts Boisés ! Vous allez devoir faire preuve de courage pour s'aventurer dans cet espace naturel sensible."
    ],
    "es": [
      "El Gnolus Kompett, el gran atleta de los Juegos Gnolímpicos, te desafía a que le sigas mientras se enfrenta a las crestas boscosas Tendrás que ser valiente para aventurarte en esta delicada zona natural."
    ],
    "nl": [
      "De Gnolus Kompett, de grote atleet van de Gnolympische Spelen, daagt je uit om hem te volgen terwijl hij de beboste bergkammen beklimt! Je moet dapper zijn om je in dit kwetsbare natuurgebied te wagen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : A vos marques, crêt, partez !"
    ]
  },
