  "rdfs:comment": {
    "de": [
      "Vor Ort oder zum Mitnehmen bietet La Galinette handwerklich hergestellte Pizzen und Burger, insbesondere den mit Gänseleber oder Kalbsbries, die mit frischen und lokalen Produkten zubereitet werden."
    ],
    "en": [
      "On site or to take away, La Galinette offers pizzas and artisanal burgers, including foie gras and veal sweetbreads, made with fresh, local produce, as well as its tenderloin with blue cheese sauce, fries and salad."
    ],
    "it": [
      "Che si scelga di mangiare all'interno o di portar via, La Galinette offre pizze e hamburger fatti in casa, tra cui foie gras e animelle di vitello, preparati con prodotti freschi locali."
    ],
    "fr": [
      "Sur place ou à emporter, La Galinette propose des pizzas et des burgers artisanaux, notamment celui au foie gras ou au ris de veau, préparés avec des produits frais et locaux."
    ],
    "es": [
      "Tanto para comer en el restaurante como para llevar, La Galinette ofrece pizzas y hamburguesas caseras, que incluyen foie gras y mollejas de ternera, elaboradas con productos frescos de la zona."
    ],
    "nl": [
      "Of je nu kiest om te eten of om mee te nemen, La Galinette biedt huisgemaakte pizza's en hamburgers, waaronder foie gras en kalfszwezerik, gemaakt met verse lokale producten."
    ]
  },
