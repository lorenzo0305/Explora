  "rdfs:comment": {
    "de": [
      "Dieser 2,5 km lange Vierjahreszeiten-Wanderweg führt über Waldwege vom Col de Font de Cère, 1,5 km von der Station Lioran entfernt, in Richtung des Weilers Les Chazes."
    ],
    "en": [
      "This 2.5 km four-season hiking trail follows forest tracks from the Col de Font de Cère, 1.5 km from the resort of Le Lioran, towards the hamlet of Les Chazes."
    ],
    "it": [
      "Questo sentiero di 2,5 km per quattro stagioni segue i sentieri forestali dal Col de Font de Cère, a 1,5 km dalla località di Le Lioran, verso la frazione di Les Chazes."
    ],
    "fr": [
      "Ce parcours de randonnée quatre saisons  de 2,5 km, emprunte des pistes forestières au départ du Col de Font de Cère à 1.5 km de la station du Lioran, en direction du hameau des Chazes."
    ],
    "es": [
      "Esta ruta de senderismo de 2,5 km para las cuatro estaciones sigue pistas forestales desde el Col de Font de Cère, a 1,5 km de la estación de Le Lioran, hacia la aldea de Les Chazes."
    ],
    "nl": [
      "Deze 2,5 km lange wandelroute voor vier seizoenen volgt bospaden vanaf de Col de Font de Cère, op 1,5 km van het resort Le Lioran, richting het gehucht Les Chazes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade de Font de Cère"
    ]
  },
