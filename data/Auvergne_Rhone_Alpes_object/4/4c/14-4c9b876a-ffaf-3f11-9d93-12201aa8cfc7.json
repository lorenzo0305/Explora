  "rdfs:comment": {
    "de": [
      "Dans mon jardin ist eine Freiluftbar, die sich am Fuße der Halde Pinchonvalles in Avion im Garten eines ehemaligen Porionhauses befindet.\nSylvain und Martine heißen Sie in der schönen Jahreszeit herzlich willkommen!"
    ],
    "en": [
      "Dans mon jardin is an open-air bar located at the foot of the Pinchonvalles slag heap in Avion, in the garden of a former porion house.\nSylvain and Martine welcome you in fine weather!"
    ],
    "it": [
      "Dans mon jardin è un bar all'aperto situato ai piedi della discarica di Pinchonvalles ad Avion, nel giardino di una vecchia casa di portinai.\nSylvain e Martine vi accolgono tutto l'anno!"
    ],
    "fr": [
      "Dans mon jardin est un bar de plein air, situé au pied du terril de Pinchonvalles, à Avion, dans le jardin d'une ancienne maison de porion.\nSylvain et Martine vous accueillent à la belle saison !"
    ],
    "nl": [
      "Dans mon jardin is een openluchtbar aan de voet van de terril van Pinchonvalles in Avion, in de tuin van een oud portiershuis.\nSylvain en Martine verwelkomen je het hele jaar door!"
    ],
    "es": [
      "Dans mon jardin es un bar al aire libre situado al pie del escorial de Pinchonvalles, en Avion, en el jardín de una antigua casa de portero.\nSylvain y Martine le dan la bienvenida todo el año"
    ]
  },
