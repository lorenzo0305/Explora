  "rdfs:comment": {
    "de": [
      "In Miribel-les Echelles bietet sich ein außergewöhnliches Panorama auf das Massiv der westlichen Grande Chartreuse und die letzten Ausläufer der Jurakette von l'épine."
    ],
    "en": [
      "At Miribel-les Echelles, an exceptional panorama of the western Grande Chartreuse massif and the last foothills of the Jura chain of thorns."
    ],
    "it": [
      "A Miribel-les Echelles, un panorama eccezionale sul massiccio occidentale della Grande Chartreuse e sugli ultimi contrafforti della catena del Giura."
    ],
    "fr": [
      "A Miribel-les Echelles, un panorama exceptionnel sur le massif de la Grande Chartreuse occidentale et les derniers contreforts de la chaîne jurassienne de l'épine."
    ],
    "nl": [
      "In Miribel-les Echelles, een uitzonderlijk panorama op het westelijke massief van de Grande Chartreuse en de laatste uitlopers van de Juraketen van de épine."
    ],
    "es": [
      "En Miribel-les Echelles, un panorama excepcional del macizo de la Grande Chartreuse occidental y de las últimas estribaciones de la cadena del Jura de la épine."
    ]
  },
