  "rdfs:comment": {
    "de": [
      "Sie marschiert an der Spitze des Kavallerieregiments bei den großen nationalen Feierlichkeiten am 14. Juli, 11. November und 8. Mai."
    ],
    "en": [
      "A forty-strong mounted musical group, it marches at the head of the cavalry regiment on national occasions such as July 14th, November 11th and May 8th."
    ],
    "it": [
      "Un gruppo musicale a cavallo di quaranta elementi, che marcia alla testa del reggimento di cavalleria nelle principali occasioni nazionali come il 14 luglio, l'11 novembre e l'8 maggio."
    ],
    "fr": [
      "Formation musicale montée, forte de quarante exécutants, elle défile en tête du régiment de cavalerie lors des grands rendez-vous nationaux, le 14 Juillet, 11 Novembre, 8 Mai."
    ],
    "nl": [
      "Deze veertigkoppige muziekgroep te paard marcheert aan het hoofd van het cavalerieregiment bij grote nationale gelegenheden zoals 14 juli, 11 november en 8 mei."
    ],
    "es": [
      "Agrupación musical a caballo de cuarenta miembros, marcha a la cabeza del regimiento de caballería en las grandes ocasiones nacionales, como el 14 de julio, el 11 de noviembre y el 8 de mayo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fanfare de la Cavalerie de la Garde républicaine"
    ]
  },
