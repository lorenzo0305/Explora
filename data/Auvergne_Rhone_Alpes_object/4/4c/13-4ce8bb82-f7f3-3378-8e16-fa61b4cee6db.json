  "rdfs:comment": {
    "de": [
      "Die Jardins de la Sauge befinden sich im Herzen von Bugey auf 800 m Höhe. Die in einer geschützten Umgebung angebauten und gepflückten Pflanzen bieten Ihnen Kräutertees und andere AB-zertifizierte Produkte, die auf handwerkliche Weise hergestellt werden."
    ],
    "en": [
      "Les Jardins de la Sauge, an artisanal company, was founded by a woman to create herbal teas, honey and vinegars of exceptional quality. Organic products, handmade from seed to bag."
    ],
    "it": [
      "Les Jardins de la Sauge si trova nel cuore della regione di Bugey, a 800 metri di altitudine. Le piante vengono coltivate e raccolte in un ambiente incontaminato per produrre tisane e altri prodotti certificati AB, creati con metodi tradizionali."
    ],
    "fr": [
      "Les Jardins de la Sauge sont situés au coeur du Bugey à 800m d'altitude. Les plantes cultivées et cueillies dans un environnement préservé vous offrent des tisanes et autres produits certifiés AB, créés de manière artisanale."
    ],
    "nl": [
      "Les Jardins de la Sauge ligt in het hart van de Bugey streek op 800m hoogte. De planten worden geteeld en geoogst in een ongerepte omgeving om kruidenthee en andere AB-gecertificeerde producten te produceren, gemaakt met behulp van traditionele methoden."
    ],
    "es": [
      "Les Jardins de la Sauge están situados en el corazón de la región de Bugey, a 800 m de altitud. Las plantas se cultivan y cosechan en un entorno virgen para elaborar tisanas y otros productos con certificado AB, creados con métodos tradicionales."
    ]
  },
  "rdfs:label": {
