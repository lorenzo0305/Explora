  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses neue, in Frankreich einzigartige Konzept!"
    ],
    "en": [
      "Discover this new concept, unique in France! BistroBoul is the perfect place to combine conviviality, good food and fun!  With its gourmet boards, beer giraffes and pétanque court, enjoy a unique moment with friends or family in a warm, festive atmosphere."
    ],
    "it": [
      "Scoprite questo nuovo concetto, unico in Francia! Il BistroBoul è il luogo perfetto per unire convivialità, buon cibo e divertimento!  Con i suoi piatti gourmet, le giraffe di birra e il campo da pétanque, vi divertirete un mondo!"
    ],
    "fr": [
      "Découvrez ce nouveau concept unique en France ! Le BistroBoul, c’est le lieu parfait pour allier convivialité, bonne cuisine et fun !  Avec ses planches gourmandes, ses girafes de bière et son terrain de pétanque, profitez d’un moment unique !"
    ],
    "nl": [
      "Ontdek dit nieuwe concept, uniek in Frankrijk!"
    ],
    "es": [
      "Descubra este nuevo concepto, único en Francia BistroBoul es el lugar perfecto para combinar convivencia, buena comida y diversión  Con sus platos gourmet, sus jirafas de cerveza y su campo de petanca, ¡lo pasará en grande!"
    ]
  },
  "rdfs:label": {
