  "rdfs:comment": {
    "de": [
      "Lokales Kunsthandwerksgeschäft. Textil, Leder, Holz, Keramik... hier sublimieren wir das Material!\r\nAlle 6 Monate versammelt eine neue Ausstellung eine Auswahl an vielfältigen Kreationen, von kleinen Geschenken bis hin zu außergewöhnlichen Stücken, die aus authentischem Know-how resultieren."
    ],
    "en": [
      "Local arts and crafts shop. Textile, leather, wood, pottery... here, we sublimate the material!\r\nEvery 6 months, a new exhibition brings together a selection of varied creations, from small gifts to exceptional pieces resulting from authentic know-how."
    ],
    "it": [
      "Scoprire, creare, sostenere... regalatevi un momento di curiosità, venite a conoscerci!\r\nQui si sublima la materia!\r\nL'associazione vi accoglie tutto l'anno per scoprire il know-how locale e l'artigianato."
    ],
    "fr": [
      "Découvrez, créez, soutenez... offrez vous un moments de curiosité, venez nous rencontrer! \r\nIci, on sublime la matière!\r\nL'association vous accueille toute l'année, à la découverte des savoirs faires et de l'artisanat d'art local."
    ],
    "nl": [
      "Ontdekken, creëren, ondersteunen... trakteer jezelf op een moment van nieuwsgierigheid, kom en ontmoet ons!\r\nHier sublimeren we het materiaal!\r\nDe vereniging verwelkomt je het hele jaar door om de lokale knowhow en kunstnijverheid te ontdekken."
    ],
    "es": [
      "Descubrir, crear, apoyar... regálese un momento de curiosidad, ¡venga a conocernos!\r\n¡Aquí sublimamos la materia!\r\nLa asociación le da la bienvenida todo el año para descubrir el saber hacer y la artesanía locales."
    ]
  },
  "rdfs:label": {
    "de": [
      "Das Haus der Art'isans"
    ],
    "en": [
      "The House of Art'isans"
    ],
    "fr": [
      "La Maison des Art'isans"
    ]
  },
