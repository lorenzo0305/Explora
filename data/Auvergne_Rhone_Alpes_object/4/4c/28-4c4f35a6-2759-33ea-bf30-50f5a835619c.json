  "rdfs:comment": {
    "de": [
      "Arythmi Music Band, eine herrlich vibrierende Formation, ein Quartett, das sich zu den englischen und französischen Pop-Rock-Einflüssen der letzten vierzig Jahre bekennt. Eine tolle Atmosphäre, talentierte Musiker und ein hoffentlich begeistertes Publikum!"
    ],
    "en": [
      "Arythmi Music Band, a delightfully vibrant quartet with English and French pop-rock influences from the last forty years. A superb atmosphere, talented musicians and an audience of fans that we hope will be there!"
    ],
    "it": [
      "Arythmi Music Band, un gruppo deliziosamente vivace, un quartetto che rivendica le influenze pop-rock inglesi e francesi degli ultimi quarant'anni. Si preannuncia un'atmosfera superba, con musicisti di talento e un pubblico di appassionati che speriamo si presenti numeroso!"
    ],
    "fr": [
      "Arythmi Music Band, une formation délicieusement vibrante, un quatuor qui revendique des influences pop-rock anglaises et françaises de ces quarante dernières années. Une superbe ambiance à coup sûr, des musiciens de talent et un public de fans que l’on espère au rendez-vous !"
    ],
    "es": [
      "Arythmi Music Band, un grupo deliciosamente vibrante, un cuarteto que reivindica las influencias del pop-rock inglés y francés de los últimos cuarenta años. El ambiente será inmejorable, con músicos de gran talento y un público que esperamos que acuda en masa"
    ],
    "nl": [
      "Arythmi Music Band, een heerlijk levendige groep, een kwartet dat aanspraak maakt op Engelse en Franse poprockinvloeden van de afgelopen veertig jaar. Het wordt zeker een geweldige sfeer, met getalenteerde muzikanten en een publiek van fans dat hopelijk in groten getale zal komen opdagen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Scène d'Été au Centre Bourg : Arythmi Music Band"
    ]
  },
