  "rdfs:comment": {
    "de": [
      "Das Domaine Boustigue empfängt Sie während der gesamten Sommersaison in der Süd-Dauphiné und im Champsaur. Das Hotel befindet sich oberhalb des Dorfes Corps und in der Nähe von Notre Dame de La Salette."
    ],
    "en": [
      "Boustigue welcomes you during all summer in the south of Dauphiné and Champsaur. The hotel is located over the village of Corps and near Notre-Dame de La Salette"
    ],
    "it": [
      "Il Domaine Boustigue vi accoglie per tutta la stagione estiva nel Delfinato meridionale e nello Champsaur. L'hotel si trova sopra il villaggio di Corps e vicino a Notre Dame de La Salette."
    ],
    "fr": [
      "Le domaine Boustigue vous accueille toute la saison d'été dans le sud Dauphiné et le Champsaur. L'hôtel est situé au dessus du village de Corps et a proximité de Notre Dame de La Salette."
    ],
    "nl": [
      "Het domein Boustigue verwelkomt u gedurende de hele zomerperiode  gelegen in het zuiden van de Dauphine aan de grens met de Champsaur. Het hotel bevindt zich in het stadscentrum van Corps op enkele kilometers van Notre Dame de La Salette."
    ],
    "es": [
      "El Domaine Boustigue le da la bienvenida durante toda la temporada de verano en el sur del Dauphiné y Champsaur. El hotel está situado por encima del pueblo de Corps y cerca de Notre Dame de La Salette."
    ]
  },
