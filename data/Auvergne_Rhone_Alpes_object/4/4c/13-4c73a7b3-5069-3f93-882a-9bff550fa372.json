  "rdfs:comment": {
    "de": [
      "Die familiengeführte Creperie \"chez Zonzon\" befindet sich seit 1984 auf dem Plateau von Plaine-Joux gegenüber den Kassen. Auf der Sonnenterrasse oder zum Mitnehmen können Sie süße und herzhafte Crêpes, Paninis und Aperitifbretter genießen."
    ],
    "en": [
      "The family pancake restaurant \"chez Zonzon\" has been installed since 1984 on the Plaine-Joux nordic ski area. On its sunny terrace or take away, you can enjoy sweet and savoury pancakes, paninis..."
    ],
    "it": [
      "La creperia \"chez Zonzon\", a conduzione familiare, si trova dal 1984 sull'altopiano di Plaine-Joux, di fronte alle casse. Sulla terrazza soleggiata o da asporto, potrete gustare crêpes dolci e salate, panini e taglieri di aperitivi."
    ],
    "fr": [
      "La Creperie familiale « chez Zonzon » est installée depuis 1984 sur le plateau de Plaine-Joux face aux caisses. Sur sa terrasse ensoleillée ou à emporter , vous pourrez déguster des crêpes salées et sucrées, des paninis et des planches apéro."
    ],
    "es": [
      "La crepería familiar \"chez Zonzon\" está establecida desde 1984 en la meseta de Plaine-Joux, frente a las cajas. En su soleada terraza o para llevar, podrá disfrutar de crepes dulces y salados, paninis y tablas de aperitivos."
    ],
    "nl": [
      "De familiecreperie \"chez Zonzon\" is sinds 1984 gevestigd op het plateau van Plaine-Joux tegenover de kassa's. Op het zonnige terras of om mee te nemen, kunt u genieten van zoete en hartige crêpes, panini's en aperitiefplankjes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pancake restaurant"
    ],
    "fr": [
      "Crêperie chez Zonzon"
    ]
  },
