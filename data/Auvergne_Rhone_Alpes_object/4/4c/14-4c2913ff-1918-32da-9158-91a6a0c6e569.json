      "dc:description": {
        "de": [
          "25. November ab 16 Uhr :\nAméplaisirs, Schmuckdesignerin...\n\n2. Dezember ab 15 Uhr:\nLowa Konate, Bildhauerin\n\n9. Dezember ab 15h\nLa Fabrique du Héron, Biskuitfabrik.\n\n16. Dezember ab 15 Uhr :\nAtelier Verre and Cie, geschmolzenes Glas\n\n17. Dezember von 10h bis 12h :\nPause in Poesie mit Charlotte His\n\n50 rue Carnot in Berck\nInformationen: bonjour@causettes.fr"
        ],
        "en": [
          "november 25 from 4pm:\nAméplaisirs, jewelry designer...\n\ndecember 2 from 3pm:\nLowa Konate, sculptor\n\ndecember 9 from 3pm\nLa Fabrique du Héron, cookie maker.\n\ndecember 16 from 3pm :\nVerre and Cie workshop, fused glass\n\ndecember 17 from 10am to 12pm:\nPoetry break with Charlotte His\n\n50 rue Carnot, Berck\nInformation: bonjour@causettes.fr"
        ],
        "it": [
          "25 novembre dalle 16.00:\nAméplaisirs, designer di gioielli...\n\n2 dicembre dalle 15:00:\nLowa Konate, scultore\n\n9 dicembre dalle 15:00\nLa Fabrique du Héron, fabbrica di biscotti.\n\n16 dicembre dalle 15.00:\nLaboratorio Verre et Cie, vetro fuso\n\n17 dicembre dalle 10.00 alle 12.00 :\nPausa di poesia con Charlotte His\n\n50 rue Carnot, Berck\nInformazioni: bonjour@causettes.fr"
        ],
        "fr": [
          "25 novembre dès 16h : \nAméplaisirs, créatrice de bijoux..\n\n2 décembre dès 15h: \nLowa  Konate, sculpteur\n\n9 décembre dès 15h\nLa Fabrique du Héron, biscuiterie.\n\n16 décembre dès 15h : \nAtelier Verre and Cie, verre fusionné\n\n17 décembre de 10h à 12h : \nPause en poésies avec Charlotte His \n\n50 rue Carnot à Berck \nRenseignements : bonjour@causettes.fr"
        ],
        "nl": [
          "25 november vanaf 16.00 uur:\nAméplaisirs, juwelenontwerper...\n\n2 december vanaf 15u:\nLowa Konate, beeldhouwer\n\n9 december vanaf 15u\nLa Fabrique du Héron, koekjesfabriek.\n\n16 december vanaf 15u :\nVerre en Cie workshop, gesmolten glas\n\n17 december van 10u tot 12u :\nPoëziepauze met Charlotte His\n\n50 rue Carnot, Berck\nInformatie: bonjour@causettes.fr"
        ],
        "es": [
          "25 de noviembre a partir de las 16h:\nAméplaisirs, diseñador de joyas...\n\n2 de diciembre a partir de las 15.00 h\nLowa Konate, escultor\n\n9 de diciembre a partir de las 15.00 h\nLa Fabrique du Héron, fábrica de galletas.\n\n16 de diciembre a partir de las 15.00 h :\nTaller Verre et Cie, vidrio fundido\n\n17 de diciembre de 10h a 12h :\nPausa poética con Charlotte His\n\n50 rue Carnot, Berck\nInformación: bonjour@causettes.fr"
        ]
      },
