  "rdfs:comment": {
    "de": [
      "Am Eingang des Viertels La Falaise bietet Ihnen dieses gemütliche Restaurant eine großzügige Küche mit savoyischen, elsässischen und italienischen Akzenten. Sonnenterrasse am Mittag, gesellige Atmosphäre mit der Familie oder mit Freunden."
    ],
    "en": [
      "At the entrance to the Falaise district, this welcoming restaurant offers generous cuisine with Savoyard, Alsatian, and Italian influences.\r\nEnjoy the sunny terrace at lunchtime and a friendly, family-style atmosphere with friends or loved ones."
    ],
    "it": [
      "All'ingresso del quartiere di Falaise, questo accogliente ristorante propone una generosa cucina savoiarda, alsaziana e italiana. Una terrazza soleggiata a pranzo e un'atmosfera amichevole per la famiglia e gli amici."
    ],
    "fr": [
      "À l’entrée du quartier de la Falaise, ce restaurant chaleureux vous propose une cuisine généreuse aux accents savoyards, alsaciens et italiens. Terrasse ensoleillée le midi, ambiance conviviale en famille ou entre amis."
    ],
    "nl": [
      "Aan de ingang van de wijk Falaise biedt dit gezellige restaurant een royale keuken met Savoyaardse, Elzasser en Italiaanse accenten.\r\n’s Middags kun je genieten van het zonnige terras, en ’s avonds van een gemoedelijke sfeer met familie of vrienden."
    ],
    "es": [
      "A la entrada del barrio de Falaise, este acogedor restaurante sirve una generosa cocina saboyana, alsaciana e italiana. Una terraza soleada a la hora de comer y un ambiente agradable para la familia y los amigos."
    ]
  },
  "rdfs:label": {
