  "rdfs:comment": {
    "de": [
      "Herstellung von trockenen Nudeln auf dem Bauernhof und Vollkornmehl. Verkauf vor Ort oder in zahlreichen Geschäften für regionale Produkte .\r\nHerstellung von Raps- und Sonnenblumenöl.\r\nHerstellung von Hartweizenmehl"
    ],
    "en": [
      "Farm-made dry pasta and whole-wheat flour. Sales on site or in many local produce stores.\r\nRapeseed and sunflower oil production\r\nProduction of durum wheat flour"
    ],
    "it": [
      "Produzione di pasta secca e farina integrale in azienda. Vendita in loco o in molti negozi di prodotti locali.\r\nProduzione di olio di colza e di girasole\r\nProduzione di farina di grano duro"
    ],
    "fr": [
      "Fabrication de pâtes sèches à la Ferme et farine de blé complet. Vente sur place ou dans de nombreux magasins de produits du terroir .\r\nFabrication d'huile de colza et de tournesol\r\nFabrication de farines de blé dur"
    ],
    "nl": [
      "Productie van gedroogde pasta en volkorenmeel op de boerderij. Verkoop ter plaatse of in veel plaatselijke winkels.\r\nProductie van koolzaad- en zonnebloemolie\r\nProductie van meel van harde tarwe"
    ],
    "es": [
      "Producción de pasta seca y harina integral en la explotación. Venta in situ o en numerosas tiendas de productos locales.\r\nProducción de aceite de colza y de girasol\r\nProducción de harina de trigo duro"
    ]
