  "rdfs:comment": {
    "de": [
      "Die Angelstrecke ohne zu töten auf dem Lignon in Poncins in der 2. Kategorie, diese Strecke wird regelmäßig mit Regenbogenforellen gefüttert, die zur Freude der Angler ausgesetzt werden."
    ],
    "en": [
      "The no-kill fishing course on the 2nd category Lignon at Poncins is regularly stocked with rainbow trout, much to the delight of anglers."
    ],
    "it": [
      "Il corso di pesca no-kill sul Lignon di 2a categoria a Poncins viene regolarmente rifornito di trote iridee, per la gioia dei pescatori."
    ],
    "fr": [
      "Le parcours de pêche sans tuer sur le Lignon à Poncins en 2ème catégorie, ce parcours est régulièrement alimenté en truite arc-en-ciel déversées pour le plus grand plaisir des pêcheurs."
    ],
    "nl": [
      "Het no-kill visparcours van de 2e categorie Lignon bij Poncins wordt regelmatig gevuld met regenboogforel, tot grote vreugde van de vissers."
    ],
    "es": [
      "El curso de pesca sin muerte del Lignon, de 2ª categoría, en Poncins, se abastece regularmente de truchas arco iris, para deleite de los pescadores."
    ]
  },
  "rdfs:label": {
