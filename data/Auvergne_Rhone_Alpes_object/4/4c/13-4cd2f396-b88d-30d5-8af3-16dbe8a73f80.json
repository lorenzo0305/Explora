  "rdfs:comment": {
    "de": [
      "Im Herzen des Bourbonnais, in Saint-Pourçain, bewirtschaften wir ein 25 Hektar großes Weingut, das sich über acht Gemeinden der Appellation Saint-Pourçain erstreckt. Wir sind seit fünf Generationen mit unserem Land verbunden und bewirtschaften unsere Weinberge biologisch."
    ],
    "en": [
      "In the heart of the Bourbonnais region, in Saint-Pourçain, we manage an estate of 25 hectares of vines located in 8 communes of the Saint-Pourçain appellation area. Attached to our land for 5 generations, we cultivate our vines organically."
    ],
    "it": [
      "Nel cuore della regione del Bourbonnais, a Saint-Pourçain, gestiamo una tenuta di 25 ettari di vigneti situati in 8 comuni della zona di denominazione Saint-Pourçain. Legati alla nostra terra da 5 generazioni, coltiviamo le nostre viti in modo biologico."
    ],
    "fr": [
      "Au cœur du Bourbonnais, à Saint-Pourçain, nous exploitons un domaine de 25 hectares de vignes situé sur 8 communes de l’aire de l’appellation de Saint-Pourçain. Attachés à nos terres depuis 5 générations, nous cultivons nos vignes en culture biologique."
    ],
    "nl": [
      "Witte en rode wijnen, rosé en mousserende wijnen."
    ],
    "es": [
      "En el corazón de la región de Bourbonnais, en Saint-Pourçain, gestionamos una finca de 25 hectáreas de viñedos situados en 8 municipios de la zona de denominación de Saint-Pourçain. Vinculados a nuestra tierra desde hace 5 generaciones, cultivamos nuestros viñedos de forma ecológica."
    ]
  },
