  "rdfs:comment": {
    "de": [
      "Jahrhundert mit einem Glockenturm im romanisch-byzantinischen Stil, der 1870 nach einer Verlängerung des Kirchenschiffs wieder aufgebaut wurde. Der größte Reichtum: Die Arkaden der romanischen Apsis bilden 7 Arkaden, von denen 4 mit Wandfresken aus dem 12."
    ],
    "en": [
      "Church of the XIIth century with a bell tower of Romanesque-Byzantine style, rebuilt in 1870 on extension of the nave. Main wealth: arcature of its Romanesque apse forming 7 arcades, 4 of which are adorned with wall frescoes of the 12th century discovered and restored."
    ],
    "it": [
      "Chiesa del XII secolo con campanile romanico-bizantino, ricostruita nel 1870 ampliando la navata centrale. La sua caratteristica principale è l'arcata dell'abside romanica, che forma 7 arcate, 4 delle quali sono decorate con affreschi murali del XII secolo che sono stati scoperti e restaurati."
    ],
    "fr": [
      "Église du XIIe siècle avec clocher de style romano-byzantin, reconstruit en 1870 sur allongement de la nef. Principale richesse: arcature de son abside romane formant 7 arcades dont 4 ornées de fresques murales du XIIe siècle découvertes et restaurées."
    ],
    "nl": [
      "Kerk uit de 12e eeuw met een Romaans-Byzantijnse klokkentoren, herbouwd in 1870 door het schip uit te breiden. Het belangrijkste kenmerk is de arcatuur van de romaanse apsis met 7 arcades, waarvan er 4 zijn versierd met 12e-eeuwse muurschilderingen die zijn ontdekt en gerestaureerd."
    ],
    "es": [
      "Iglesia del siglo XII con campanario románico-bizantino, reconstruida en 1870 ampliando la nave. Su característica principal es la arquería de su ábside románico, que forma 7 arcadas, 4 de las cuales están decoradas con frescos murales del siglo XII que han sido descubiertos y restaurados."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church of Illiat and its wall frescoes"
    ],
    "fr": [
      "Église Saint-Symphorien et ses fresques"
    ]
  },
