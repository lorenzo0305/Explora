  "rdfs:comment": {
    "de": [
      "Entdecken Sie ihre Welt der bunten Wachsstoffe. Sie teilt ihre Liebe zu diesen schimmernden Farben und bietet Ihnen Taschen und Accessoires, die Ihren Alltag verschönern. Sie lädt Sie ein, sie in ihrem bescheidenen Haus/Werkstatt zu treffen."
    ],
    "en": [
      "Discover her world of colourful wax fabrics. She shares her love of these shimmering colours and offers you bags and accessories to brighten up your everyday life. She invites you to meet her in her modest home/workshop."
    ],
    "it": [
      "Scoprite il suo mondo di tessuti colorati a cera. Condivide il suo amore per questi colori scintillanti e vi propone borse e accessori per rallegrare la vostra vita quotidiana. Vi invita a incontrarla nella sua modesta casa/laboratorio."
    ],
    "fr": [
      "Découvrez son univers de bâtisseuse avec des tissus de wax colorés. Elle partage avec amour ces couleurs chatoyantes et vous propose des sacs et accessoires pour illuminer votre quotidien. Elle vous invite à la rencontrer dans son modeste atelier/ maison."
    ],
    "nl": [
      "Ontdek haar wereld van kleurrijke waxstoffen. Ze deelt haar liefde voor deze glinsterende kleuren en biedt je tassen en accessoires om je dagelijks leven op te fleuren. Ze nodigt je uit om haar te ontmoeten in haar bescheiden huis/atelier."
    ],
    "es": [
      "Descubre su mundo de coloridas telas de cera. Comparte su amor por estos colores brillantes y le ofrece bolsos y accesorios para alegrar su vida cotidiana. Te invita a conocerla en su modesta casa-taller."
    ]
  },
