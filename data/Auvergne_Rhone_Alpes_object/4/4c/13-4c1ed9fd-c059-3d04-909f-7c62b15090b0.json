  "rdfs:comment": {
    "de": [
      "Unabhängiges, familiengeführtes Restaurant seit 1986.\r\nIn einem einzigartigen Rahmen,\r\nLe Miami bietet Ihnen eine hausgemachte, großzügige und authentische Küche.\r\nKostenloser Privatparkplatz, Holzterrasse, Cocktailbar, Kinderspielplatz im Freien."
    ],
    "en": [
      "Independent, family-run restaurant since 1986. \r\nIn a unique setting, Le Miami offers generous, authentic home cooking.\r\nFree parking, wood terrace, cocktails bar, outside kids area."
    ],
    "it": [
      "Ristorante indipendente a conduzione familiare dal 1986.\r\nIn un ambiente unico,\r\nLe Miami offre una cucina casalinga generosa e autentica.\r\nParcheggio privato gratuito, terrazza in legno, cocktail bar, area giochi per bambini all'aperto."
    ],
    "fr": [
      "Restaurant indépendant et familial depuis 1986. \r\nDans un cadre unique, \r\nLe Miami vous propose une cuisine maison, généreuse et authentique. \r\nParking privé gratuit, terrasse en bois, bar à cocktails, espace jeux enfants en extérieur."
    ],
    "es": [
      "Restaurante independiente y familiar desde 1986.\r\nEn un marco incomparable,\r\nLe Miami ofrece una cocina casera, generosa y auténtica.\r\nAparcamiento privado gratuito, terraza de madera, bar de cócteles, zona de juegos infantil al aire libre."
    ],
    "nl": [
      "Onafhankelijk familierestaurant sinds 1986. In een unieke omgeving,\r\nLe Miami biedt een royale, authentieke keuken.\r\nHet heeft ook een cocktailbar."
    ]
  },
