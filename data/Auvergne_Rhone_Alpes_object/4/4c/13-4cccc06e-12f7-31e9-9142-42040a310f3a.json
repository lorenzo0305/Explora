  "rdfs:comment": {
    "de": [
      "Dieses zeitgenössische Restaurant im gemütlichen Industrial-Dekor bietet eine traditionelle Marktküche, die erfinderisch und einzigartig ist und mit der sehr umfangreichen Karte feiner Weine kombiniert wird."
    ],
    "en": [
      "This contemporary restaurant with an industrial and cozy decor offers traditional market cuisine, inventive and unique, combined with the very large wine list."
    ],
    "it": [
      "Questo ristorante contemporaneo dall'arredamento accogliente offre una cucina di mercato tradizionale, inventiva e unica, abbinata a una carta di vini pregiati molto ampia."
    ],
    "fr": [
      "Ce restaurant contemporain à la déco indus et cosy propose une cuisine traditionnelle du marché, inventive et singulière, associée  à la très large carte des vins fins."
    ],
    "es": [
      "Este restaurante contemporáneo, con su acogedora decoración indus, ofrece una cocina de mercado tradicional a la vez inventiva y única, combinada con una extensa carta de vinos finos."
    ],
    "nl": [
      "Dit eigentijdse restaurant met een gezellig indus decor biedt een traditionele, inventieve en unieke marktkeuken, gecombineerd met een zeer uitgebreide fijne wijnkaart."
    ]
  },
  "rdfs:label": {
