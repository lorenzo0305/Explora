  "rdfs:comment": {
    "de": [
      "Eine recht anspruchsvolle Route für erfahrene Mountainbiker, die zahlreiche Aussichtspunkte mit Blick auf das Dorf Châtel, das Vallée d'Abondance und die benachbarte Schweiz bietet."
    ],
    "en": [
      "A fairly challenging route for experienced mountain bikers, with plenty of views over the village of Châtel, the Vallée d'Abondance and neighbouring Switzerland."
    ],
    "it": [
      "Un percorso abbastanza impegnativo per gli appassionati di mountain bike esperti, con ampie vedute sul villaggio di Châtel, sulla Vallée d'Abondance e sulla vicina Svizzera."
    ],
    "fr": [
      "Un itinéraire assez difficile réservé aux vététistes expérimentés qui offre de nombreux points de vue sur le village de Châtel, la Vallée d'Abondance et la Suisse voisine."
    ],
    "es": [
      "Una ruta bastante exigente para ciclistas de montaña experimentados, con abundantes vistas sobre el pueblo de Châtel, el Valle de Abondance y la vecina Suiza."
    ],
    "nl": [
      "Een redelijk uitdagende route voor ervaren mountainbikers, met volop uitzicht over het dorp Châtel, de Vallée d'Abondance en het aangrenzende Zwitserland."
    ]
  },
  "rdfs:label": {
