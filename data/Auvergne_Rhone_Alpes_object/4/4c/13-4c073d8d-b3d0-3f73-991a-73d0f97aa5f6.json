  "rdfs:comment": {
    "de": [
      "In einer bergigen Umgebung finden Sie in La Marie Jeanne alle Zutaten, um Ihren Gaumen zu befriedigen und eine angenehme Zeit mit Freunden oder der Familie zu verbringen."
    ],
    "en": [
      "With its mountain setting, La Marie Jeanne has everything you need to satisfy your taste buds and spend a pleasant moment with friends or family."
    ],
    "it": [
      "In un ambiente di montagna, a La Marie Jeanne troverete tutti gli ingredienti necessari per soddisfare il vostro palato e trascorrere un piacevole momento con gli amici o la famiglia."
    ],
    "fr": [
      "Dans un cadre montagnard, vous trouverez à la Marie Jeanne tous les ingrédients pour satisfaire vos papilles et passer un moment agréable entre amis ou en famille."
    ],
    "nl": [
      "In een bergachtige omgeving vind je bij La Marie Jeanne alle ingrediënten om je smaakpapillen te bevredigen en een aangenaam moment door te brengen met vrienden of familie."
    ],
    "es": [
      "En un entorno de montaña, en La Marie Jeanne encontrará todos los ingredientes para satisfacer su paladar y pasar un momento agradable con los amigos o la familia."
    ]
  },
