  "rdfs:comment": {
    "de": [
      "Ein Unternehmen, das sich seit sieben Generationen auf die Herstellung von Wollmatratzen spezialisiert hat. Ein anerkanntes, einzigartiges Know-how, eine lokale Verankerung und eine leidenschaftliche Familie machen die Besonderheit des Unternehmens Cardelaine aus, um gut zu schlafen."
    ],
    "en": [
      "A company specializing in the manufacture of wool mattresses for 7 generations. Recognized, unique know-how, local roots and a passionate family are what make Cardelaine a unique company for a good night's sleep."
    ],
    "it": [
      "Un'azienda specializzata nella produzione di materassi in lana da 7 generazioni. Un'esperienza unica e riconosciuta, radici locali e una famiglia appassionata sono le caratteristiche dell'approccio unico di Cardelaine al dormire bene."
    ],
    "fr": [
      "Une entreprise spécialisée dans la fabrication des matelas en laine depuis 7 générations. Un savoir-faire reconnu, unique, un ancrage local, une famille passionnée, font la particularité de l'entreprise Cardelaine pour bien dormir."
    ],
    "es": [
      "Una empresa especializada en la fabricación de colchones de lana desde hace 7 generaciones. Una experiencia reconocida y única, raíces locales y una familia apasionada son las señas de identidad del enfoque único de Cardelaine para dormir bien."
    ],
    "nl": [
      "Een bedrijf dat al 7 generaties lang gespecialiseerd is in de productie van wollen matrassen. Erkende, unieke expertise, lokale wortels en een gepassioneerde familie zijn de kenmerken van Cardelaine's unieke benadering van lekker slapen."
    ]
  },
