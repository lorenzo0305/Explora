  "rdfs:comment": {
    "de": [
      "Wir heißen Sie auf unserem Betrieb willkommen, um Ihnen unsere Freude am Beruf des Landwirts zu vermitteln und Sie für unsere Umwelt sowie deren Auswirkungen auf unseren Beruf zu sensibilisieren."
    ],
    "en": [
      "We welcome you to our farm to share with you our love of farming, to make you aware of our environment and its impact on our profession."
    ],
    "it": [
      "Vi diamo il benvenuto nella nostra azienda agricola per condividere il nostro amore per l'agricoltura, per farvi conoscere l'ambiente e il suo impatto sulla nostra professione."
    ],
    "fr": [
      "Nous vous accueillons dans notre exploitation pour vous faire partager notre goût du métier d'agriculteur, pour vous sensibiliser à notre environnement ainsi que son impact sur notre métier."
    ],
    "nl": [
      "Wij heten u welkom op onze boerderij om onze liefde voor de landbouw te delen en u bewust te maken van ons milieu en de gevolgen daarvan voor ons beroep."
    ],
    "es": [
      "Le damos la bienvenida a nuestra granja para compartir nuestro amor por la agricultura, para que sea consciente de nuestro entorno y de su impacto en nuestra profesión."
    ]
  },
