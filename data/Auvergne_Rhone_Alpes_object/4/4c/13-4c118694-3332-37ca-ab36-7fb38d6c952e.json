  "rdfs:comment": {
    "de": [
      "Liebhaber von Wasser- und Natursportarten sind hier genau richtig: Genießen Sie die Freuden der Wassersportaktivitäten in einer natürlichen und einladenden Umgebung."
    ],
    "en": [
      "If you love water sports and nature sports, this is the place for you: come and enjoy the pleasures of water sports in a natural, welcoming setting."
    ],
    "it": [
      "Se siete amanti degli sport acquatici e della natura, questo è il sito che fa per voi: venite a godervi i piaceri degli sport acquatici in un ambiente naturale e accogliente."
    ],
    "fr": [
      "Amoureux des sports nautiques et des sports nature, le site est fait pour vous : venez profitez des plaisirs des activités nautique dans un cadre naturel et accueillant."
    ],
    "es": [
      "Si le gustan los deportes náuticos y de naturaleza, éste es su sitio: venga a disfrutar de los placeres de los deportes náuticos en un entorno natural y acogedor."
    ],
    "nl": [
      "Als je van watersport en natuur houdt, is dit de plek voor jou: kom genieten van de geneugten van watersport in een natuurlijke en gastvrije omgeving."
    ]
  },
