  "rdfs:comment": {
    "de": [
      "Galerie, in der Sie die Geschichte und das Kulturerbe unseres Tals entdecken können.\r\nGroße animierte Modelle von Häusern, Chalets, Sägewerk, Mühle usw.\r\nAlte Fotografien,. Ausstellung und Dokumentationsfonds durchsuchbar."
    ],
    "en": [
      "Discover the history and heritage of our valley.\r\nLarge animated models of houses, cottages, sawmills, mills, etc.\r\nOld photographs,. exhibition and documentary collections available for consultation."
    ],
    "it": [
      "Scoprite la storia e il patrimonio della nostra valle in questa galleria.\r\nGrandi modelli animati di case, chalet, segherie, mulini, ecc.\r\nFotografie d'epoca, collezioni espositive e documentarie disponibili per la consultazione."
    ],
    "fr": [
      "Galerie pour découvrir l'histoire et le patrimoine de notre vallée.\r\nGrandes maquettes animées de maisons, chalets, scierie, moulin, etc. \r\nPhotographies anciennes,. exposition et fonds documentaires consultables."
    ],
    "nl": [
      "Ontdek de geschiedenis en het erfgoed van onze vallei in deze galerij.\r\nGrote geanimeerde modellen van huizen, chalets, houtzagerijen, molens, enz.\r\nOude foto's, tentoonstellingen en documentaire collecties beschikbaar voor raadpleging."
    ],
    "es": [
      "Descubra la historia y el patrimonio de nuestro valle en esta galería.\r\nGrandes maquetas animadas de casas, chalets, serrerías, molinos, etc.\r\nFotografías antiguas, exposición y fondos documentales disponibles para consulta."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Amis du Val de Thônes Hall of Miniatures"
    ],
    "fr": [
      "Salle des maquettes des Amis du Val de Thônes"
    ]
  },
