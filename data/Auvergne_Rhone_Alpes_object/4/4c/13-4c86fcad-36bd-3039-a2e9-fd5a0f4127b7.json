  "rdfs:comment": {
    "de": [
      "Tauchen Sie in eine gemütliche Atmosphäre ein und entdecken Sie eine großzügige, leckere und gut gelaunte Speisekarte. Nutzen Sie die Terrasse am Fuße der Pisten für Ihre Mittagspause und lassen Sie es sich schmecken!"
    ],
    "en": [
      "Plunge into the welcoming atmosphere of our restaurant and discover a fun, gourmet menu. Make the most of our terrace at the foot of the ski slopes and enjoy your meal!"
    ],
    "it": [
      "Immergetevi in un'atmosfera calorosa e scoprite un menu generoso, gustoso e pieno di buonumore. Approfittate della terrazza ai piedi delle piste per la vostra pausa pranzo e fatevi un regalo!"
    ],
    "fr": [
      "Plongez dans une ambiance chaleureuse, et découvrez une carte généreuse, gourmande et pleine de bonne humeur. Profitez de la terrasse au pied des pistes pour la pause déjeuner et régalez vous !"
    ],
    "es": [
      "Sumérjase en un ambiente cálido y descubra una carta generosa, sabrosa y llena de buen humor. Aproveche la terraza a pie de pista para almorzar y darse un capricho"
    ],
    "nl": [
      "Dompel jezelf onder in de warme sfeer en ontdek een royaal, smakelijk menu vol goed humeur. Profiteer van het terras aan de voet van de pistes voor je lunchpauze en trakteer jezelf!"
    ]
  },
  "rdfs:label": {
    "en": [
      "PopAlp restaurant"
    ],
    "fr": [
      "PopAlp restaurant"
    ]
  },
