  "rdfs:comment": {
    "de": [
      "In bretonischem Ambiente genießen Sie Buchweizen- und Weizencrêpes, Salate und Eiscreme sowie Whisky aus schwarzem Weizen. Denken Sie an unsere Geschenkgutscheine!"
    ],
    "en": [
      "In a Breton setting, you will enjoy buckwheat and wheat crêpes, salads and ice cream, as well as black-wheat whisky. Don’t forget our gift vouchers!"
    ],
    "it": [
      "Gustate crêpes di grano saraceno e di frumento, insalate, gelati e whisky di grano saraceno in un ambiente bretone. Non dimenticate i nostri buoni regalo!"
    ],
    "fr": [
      "Dans un cadre breton, vous dégusterez des crêpes au sarrasin, au froment, des salades et des glaces ainsi que du whisky au blé noir. Pensez à nos bons cadeaux !"
    ],
    "nl": [
      "Geniet van boekweit- en tarwe crêpes, salades, ijsjes en boekweitwhisky in een Bretonse setting. Vergeet onze cadeaubonnen niet!"
    ],
    "es": [
      "Disfrute de tortitas de trigo sarraceno y trigo, ensaladas, helados y whisky de trigo sarraceno en un ambiente bretón. ¡No olvide nuestros cheques regalo!"
    ]
  },
