  "rdfs:comment": {
    "de": [
      "VERKAUF- DIENSTLEISTUNGEN- VERMIETUNG Clip Immobilier richtet sich an anspruchsvolle Kunden, die im Tal von Chamonix Mont-Blanc kaufen, verkaufen, vermieten oder sich dort niederlassen möchten."
    ],
    "en": [
      "Clip Immobilier caters to a demanding clientele wishing to sell, buy or let in the Chamonix Valley."
    ],
    "it": [
      "VENDITA- SERVIZI- AFFITTI Clip Immobilier si rivolge a una clientela esigente che desidera acquistare, vendere, affittare o stabilirsi nella valle di Chamonix Mont-Blanc."
    ],
    "fr": [
      "VENTE- SERVICES- LOCATION Clip Immobilier répond à une clientèle exigeante souhaitant acheter, vendre, louer ou s'installer dans la vallée de Chamonix Mont-Blanc."
    ],
    "nl": [
      "VERKOOP- DIENSTEN- VERHUUR Clip Immobilier bedient een veeleisend cliënteel dat wil kopen, verkopen, huren of zich vestigen in de vallei van Chamonix Mont-Blanc."
    ],
    "es": [
      "VENTA - SERVICIOS - ALQUILER Clip Immobilier atiende a una clientela exigente que desea comprar, vender, alquilar o instalarse en el valle de Chamonix Mont-Blanc."
    ]
  },
