  "rdfs:comment": {
    "de": [
      "Freie und kostenlose Besichtigung einer Ziegenfarm, die eine Verbindung zwischen dem Tier und seiner Heimat herstellt. Von Mitte März bis Mitte Dezember: Besichtigung jeden Vormittag von 9 bis 12 Uhr."
    ],
    "en": [
      "Free visit of a goat farm which will help you understand the link between the animal and its 'terroir'. In July-August: visit every morning from 9am to noon."
    ],
    "it": [
      "Visita gratuita di un allevamento di capre che permette di creare un legame tra l'animale e la sua terra. Da metà marzo a metà dicembre: visita ogni mattina dalle 9.00 alle 12.00."
    ],
    "fr": [
      "Visite libre et gratuite d'une exploitation caprine qui permet de faire le lien entre l'animal et son terroir. De mi-mars à mi-décembre: visite tous les matins de 9h à 12h."
    ],
    "es": [
      "Visita gratuita a una granja de cabras que permite establecer el vínculo entre el animal y su tierra. De mediados de marzo a mediados de diciembre: visita todas las mañanas de 9 a 12 horas."
    ],
    "nl": [
      "Een geitenexploitatie die het dier met het landschap verbindt, vrij te bezoeken (gratis). In juli-augustus: elke ochtend te bezoeken van 9.00 tot 12.00 u."
    ]
  },
  "rdfs:label": {
