  "rdfs:comment": {
    "de": [
      "Wir bieten eine große Auswahl an japanischen Spezialitäten: Sushi, Maki, California Rolls, Udon, Onirigi, Poke Bowls, Ramen und japanische Gerichte, die mit frischen und qualitativ hochwertigen Produkten zubereitet werden. Bestellen Sie online, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "We offer a wide variety of Japanese specialties: sushi, maki, california rolls, Udon, onirigi, poke bowls, ramen and other Japanese dishes, prepared with fresh, high-quality ingredients. Order online, on site or to take away."
    ],
    "it": [
      "Offriamo un'ampia varietà di specialità giapponesi: sushi, maki, california rolls, Udon, onirigi, poke bowls, ramen e piatti giapponesi, preparati con prodotti freschi e di qualità. Ordinate online, sul posto o da asporto."
    ],
    "fr": [
      "Nous proposons une large variété de spécialités japonaises : sushis, makis, california rolls, Udon, onirigi, poke bowls, ramens et plats japonais, préparés avec des produits frais et de qualité. Commande en ligne, sur place et à emporter."
    ],
    "nl": [
      "We bieden een grote verscheidenheid aan Japanse specialiteiten: sushi, maki, california rolls, udon, onirigi, poke bowls, ramen en Japanse gerechten, bereid met verse kwaliteitsproducten. Bestel online, ter plaatse of om mee te nemen."
    ],
    "es": [
      "Ofrecemos una amplia variedad de especialidades japonesas: sushi, maki, california rolls, Udon, onirigi, poke bowls, ramen y platos japoneses, preparados con productos frescos y de calidad. Haz tu pedido online, en el momento o para llevar."
    ]
  },
