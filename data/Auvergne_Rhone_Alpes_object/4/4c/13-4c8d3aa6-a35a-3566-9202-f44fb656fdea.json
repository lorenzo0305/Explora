  "rdfs:comment": {
    "de": [
      "Primeur- und Lebensmittelgeschäft mit bäuerlichen, saisonalen und lokalen Produkten.\r\n\r\nHier finden Sie Obst, Gemüse, Käse, verschiedene Gläser, Nudeln, Fruchtsäfte, Wein, Bier, Honig, Mehl, Öl, Shortbread, Schokolade, Kräutertee, Kompott, Milchprodukte, Eier und Brot!"
    ],
    "en": [
      "Fresh produce and grocery store selling farm, seasonal and local produce.\r\n\r\nFruits, vegetables, cheeses, various jars, pasta, fruit juices, wines, beers, honey, flour, oils, shortbread, chocolate, herbal tea, compote, dairy products, eggs and bread!"
    ],
    "it": [
      "Negozio di prodotti freschi e alimentari che vende prodotti di fattoria, di stagione e locali.\r\n\r\nTroverete frutta, verdura, formaggi, vasetti vari, pasta, succhi di frutta, vino, birra, miele, farina, olio, frollini, cioccolato, tisane, composte, latticini, uova e pane!"
    ],
    "fr": [
      "Primeur et épicerie de produits fermiers, de saison et locaux.\r\n\r\nRetrouvez fruits, légumes, fromages, bocaux divers, pâtes, jus de fruits, vins, bières, miel, farine, huiles, sablés, chocolat, tisane, compote, produits laitiers, œufs et pain !"
    ],
    "nl": [
      "Verse producten en kruidenierswinkel met producten van de boerderij, seizoensgebonden en lokale producten.\r\n\r\nJe vindt er fruit, groenten, kaas, diverse potten, pasta, vruchtensap, wijn, bier, honing, meel, olie, zandkoekjes, chocolade, kruidenthee, compote, zuivelproducten, eieren en brood!"
    ],
    "es": [
      "Tienda de comestibles y productos frescos de granja, de temporada y locales.\r\n\r\nEncontrarás fruta, verdura, queso, tarros variados, pasta, zumo de fruta, vino, cerveza, miel, harina, aceite, galletas de mantequilla, chocolate, infusiones, compotas, productos lácteos, huevos y pan"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Filles du Potager"
    ]
  },
