  "rdfs:comment": {
    "de": [
      "Das Retour aux Sources wurde 2005 von zwei Brüdern als Hommage an ihre Großeltern gegründet und hat sich in den letzten 20 Jahren zu einem vollwertigen Betrieb entwickelt. Originalität und Genuss sind an der Tagesordnung."
    ],
    "en": [
      "Created in 2005 by 2 brothers as a tribute to their grandparents, Retour aux Sources has become a fully-fledged operation in 20 years. Originality and pleasure are the order of the day."
    ],
    "it": [
      "Creato nel 2005 da due fratelli in omaggio ai loro nonni, Retour aux Sources è diventato in 20 anni un'attività a tutti gli effetti. Originalità e piacere sono all'ordine del giorno."
    ],
    "fr": [
      "Créé en 2005 par 2 frères, en hommage à leurs grands-parents, le Retour aux Sources est devenu en 20 ans une exploitation à part entière. Originalité et plaisir sont au rendez-vous."
    ],
    "nl": [
      "In 2005 opgericht door 2 broers als eerbetoon aan hun grootouders, is Retour aux Sources in 20 jaar uitgegroeid tot een volwaardige onderneming. Originaliteit en plezier zijn aan de orde van de dag."
    ],
    "es": [
      "Creada en 2005 por 2 hermanos en homenaje a sus abuelos, Retour aux Sources se ha convertido en 20 años en una empresa de pleno derecho. La originalidad y el placer están a la orden del día."
    ]
  },
  "rdfs:label": {
