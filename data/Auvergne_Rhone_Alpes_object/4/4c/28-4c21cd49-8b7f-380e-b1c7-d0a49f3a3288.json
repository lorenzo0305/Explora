  "rdfs:comment": {
    "de": [
      "Der Wochenmarkt von Hazebrouck findet jeden Sonntagmorgen auf dem Place du Général de Gaulle statt. Dieser Markt ist ein Ort des Lebens par excellence und bietet Ihnen die Möglichkeit, bei den lokalen Erzeugern und Händlern authentische Geschmäcker und Produkte zu entdecken."
    ],
    "en": [
      "Hazebrouck's weekly market takes place on Sunday mornings in the Place du Général de Gaulle. A lively place par excellence, this market lets you discover authentic flavors and products from local producers and merchants."
    ],
    "it": [
      "Il mercato settimanale di Hazebrouck si svolge la domenica mattina in Place du Général de Gaulle. Luogo vivace per eccellenza, questo mercato permette di scoprire sapori e prodotti autentici di produttori e commercianti locali."
    ],
    "fr": [
      "Le marché hebdomadaire d'Hazebrouck se déroule le dimanche matin sur la place du Général de Gaulle. Lieu de vie par excellence, ce marché vous permettra de découvrir des saveurs et produits authentiques auprès des producteurs et commerçants locaux."
    ],
    "es": [
      "El mercado semanal de Hazebrouck tiene lugar los domingos por la mañana en la Place du Général de Gaulle. Lugar animado por excelencia, este mercado le ofrece la oportunidad de descubrir sabores y productos auténticos de productores y comerciantes locales."
    ],
    "nl": [
      "De wekelijkse markt van Hazebrouck vindt plaats op zondagochtend op de Place du Général de Gaulle. Deze levendige markt bij uitstek biedt je de kans om authentieke smaken en producten van lokale producenten en handelaars te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
