  "rdfs:comment": {
    "de": [
      "Die Bibliothek Cultur'Évasion besitzt mehrere hundert Bücher( Romane, Comics, Zeitschriften, Dokumentarfilme), die Sie mit Groß und Klein teilen können.  Unsere Bibliothek ? Ein Raum zum Teilen, eine Leseoase auf dem Fluss der 4 Flüsse."
    ],
    "en": [
      "The Cultur'Evasion library has hundreds of books, novels , comics, magazines, journals, to share with young and old ."
    ],
    "it": [
      "La biblioteca di Cultur'Évasion dispone di centinaia di libri (romanzi, fumetti, riviste, documentari) da condividere con grandi e piccini.  La nostra biblioteca? Un luogo di condivisione, un'oasi di lettura sui 4 fiumi."
    ],
    "fr": [
      "La Bibliothèque Cultur'Évasion possède plusieurs centaines de livres( romans, bandes dessinées, magazines, documentaires) à partager avec les grands et les petits.  Notre bibliothèque ? Un espace de partage, un havre de lecture sur le flot des 4 rivières."
    ],
    "es": [
      "La biblioteca Cultur'Évasion cuenta con cientos de libros (novelas, cómics, revistas, documentales) para compartir con grandes y pequeños.  ¿Nuestra biblioteca? Un lugar para compartir, un refugio para la lectura en los 4 ríos."
    ],
    "nl": [
      "De Cultur'Évasion-bibliotheek heeft honderden boeken (romans, strips, tijdschriften, documentaires) om te delen met jong en oud.  Onze bibliotheek? Een plek om te delen, een toevluchtsoord om te lezen op de 4 rivieren."
    ]
  },
