  "rdfs:comment": {
    "de": [
      "Ausstellungen, Verkauf, Kurse und Workshops in Bildhauerei, Modellieren von Sandstein-Ton, für alle Altersgruppen und jedes Niveau (ab 6 Jahren). Entwickeln Sie Ihre Kreativität mithilfe von Ton in einem Atelier in einem charmanten kleinen Bergdorf."
    ],
    "en": [
      "Sculpture, modeling of stoneware clays. Classes for all ages from 6 years old. \r\nCome and develop your creativity in a workshop in a small village."
    ],
    "it": [
      "Mostre, vendita, lezioni e laboratori di scultura e modellazione dell'argilla in gres, per tutte le età e i livelli (dai 6 anni in su). Venite a sviluppare la vostra creatività attraverso l'argilla, in un laboratorio in un incantevole paesino di montagna."
    ],
    "fr": [
      "Expos vente, cours et ateliers de sculpture, modelage d'argiles de grès, pour tout âge et tout niveau (à partir de 6 ans.). Venez développer votre créativité à travers l'argile, dans un atelier au sein d'un charmant petit village de montagne."
    ],
    "nl": [
      "Tentoonstellingen, verkoop, lessen en workshops in beeldhouwen en steengoed boetseren, voor alle leeftijden en niveaus (vanaf 6 jaar). Kom je creativiteit ontwikkelen met klei, in een workshop in een charmant bergdorpje."
    ],
    "es": [
      "Exposiciones, venta, clases y talleres de escultura y modelado en gres, para todas las edades y niveles (a partir de 6 años). Ven a desarrollar tu creatividad a través de la arcilla, en un taller situado en un encantador pueblecito de montaña."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Natures d'Argiles et de Grès"
    ]
  },
