  "rdfs:comment": {
    "de": [
      "Die Freude am Malen, frei, ohne Druck oder Urteil, in einem Raum, der von äußeren Blicken geschützt ist, um das Vertrauen in den Abend und in seine spontane Linienführung zu bewahren."
    ],
    "en": [
      "The pleasure of painting, freely, without pressure or judgement, in a contained space away from outside scrutiny, to maintain confidence in yourself and your spontaneous line."
    ],
    "it": [
      "Il piacere di dipingere, liberamente, senza pressioni o giudizi, in uno spazio chiuso e lontano da sguardi esterni, in modo da avere fiducia in se stessi e nella propria linea spontanea."
    ],
    "fr": [
      "Le plaisir de peindre, librement, sans pression ni jugement, dans un espace contenant et à l'abri des regards extérieurs pour garder confiance en soir et en son tracé spontané."
    ],
    "nl": [
      "Het plezier van schilderen, vrij, zonder druk of oordeel, in een afgesloten ruimte, weg van de buitenwereld, zodat je vertrouwen kunt hebben in jezelf en je spontane lijn."
    ],
    "es": [
      "El placer de pintar, libremente, sin presiones ni juicios, en un espacio contenido y alejado de miradas ajenas, para poder confiar en uno mismo y en su trazo espontáneo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jouer à peindre et à modeler"
    ]
  },
