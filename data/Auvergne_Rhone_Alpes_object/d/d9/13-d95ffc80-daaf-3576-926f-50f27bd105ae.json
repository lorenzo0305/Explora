  "rdfs:comment": {
    "de": [
      "Produktion von Gemüse, Honig und Eiern aus biologischem Anbau auf einem kleinen Bauernhof in den Combrailles."
    ],
    "en": [
      "Organic vegetables, honey and eggs, on a little farm in Combrailles."
    ],
    "it": [
      "Produzione biologica di ortaggi, uova e miele in una piccola azienda agricola nella regione di Combrailles.\nI nostri ortaggi sono in vendita il martedì e il sabato mattina dalle 8.00 alle 12.00 presso la Place des Anciens Combattants di Giat e alle fiere di Giat."
    ],
    "fr": [
      "Production de légumes, œuf et miel en agriculture biologique, dans une petite ferme des Combrailles.\nRetrouvez nos légumes à la vente mardi et samedi matin 8h-12h place des anciens combattants à Giat, ainsi que sur les foires de Giat."
    ],
    "es": [
      "Producción ecológica de verduras, huevos y miel en una pequeña granja de la región de Combrailles.\nNuestras verduras están a la venta los martes y sábados por la mañana de 8 a 12 h en la Place des Anciens Combattants de Giat, y en las ferias de Giat."
    ],
    "nl": [
      "Biologische productie van groenten, eieren en honing op een kleine boerderij in de Combrailles.\nOnze groenten zijn te koop op dinsdag- en zaterdagochtend van 8.00 tot 12.00 uur op de Place des Anciens Combattants in Giat en op beurzen in Giat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de la Folle Avoine"
    ]
  },
