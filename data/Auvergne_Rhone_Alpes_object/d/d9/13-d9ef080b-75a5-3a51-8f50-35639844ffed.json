  "rdfs:comment": {
    "de": [
      "Gotische Kirche aus dem 13. Neun Steinstatuen (Ende 15. Jh. - Anfang 16. Jh.), die 1908 und 1916 unter Denkmalschutz gestellt wurden, und Wandmalereien aus dem Jahr 1535, die 1987 unter Denkmalschutz gestellt wurden."
    ],
    "en": [
      "Gothic church of the 13th century. Nine stone statues (late 15th - early 16th century), classified as Historic Monuments in 1908 and 1916, and the wall paintings of 1535, classified as Historic Monuments in 1987."
    ],
    "it": [
      "Chiesa gotica del XIII secolo. Nove statue in pietra (fine XV - inizio XVI secolo), classificate come monumenti storici nel 1908 e nel 1916, e le pitture murali del 1535, classificate come monumenti storici nel 1987."
    ],
    "fr": [
      "Eglise gothique du XIIIème. Neuf statues en pierres (fin XVè - début XVIè), classées Monuments Historiques en 1908 et 1916, et les peintures murales de 1535, classées Monuments Historiques en 1987."
    ],
    "es": [
      "Iglesia gótica del siglo XIII. Nueve estatuas de piedra (finales del siglo XV - principios del XVI), clasificadas como Monumentos Históricos en 1908 y 1916, y las pinturas murales de 1535, clasificadas como Monumentos Históricos en 1987."
    ],
    "nl": [
      "13e eeuwse gotische kerk. Negen stenen beelden (eind 15e - begin 16e eeuw), geclassificeerd als Historisch Monument in 1908 en 1916, en de muurschilderingen uit 1535, geclassificeerd als Historisch Monument in 1987."
    ]
  },
