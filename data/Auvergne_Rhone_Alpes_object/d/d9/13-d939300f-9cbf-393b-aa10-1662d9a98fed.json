  "rdfs:comment": {
    "de": [
      "Kochkurs mit Chefkoch Gilles Roux: Beherrschen Sie das Niedertemperaturgaren von Fleisch und Fisch! Von 15:00 bis 18:30 Uhr lernen Sie seine Techniken kennen und teilen einen Moment der Gaumenfreude. 60? mit 2 Portionen zum Mitnehmen. Reservierung: 04 71 66 86 66"
    ],
    "en": [
      "Cooking classes with Chef Gilles Roux: master low-temperature cooking of meat & fish! From 3 pm to 6:30 pm, discover his techniques and share a gourmet moment. 60? with 2 portions to take away. Reservations: 04 71 66 86 66"
    ],
    "it": [
      "Corsi di cucina con lo chef Gilles Roux: padroneggiate la cottura a bassa temperatura di carne e pesce! Dalle 15.00 alle 18.30, scoprite le sue tecniche e condividete un momento gourmet. 60? con 2 porzioni da portare via. Prenotazioni: 04 71 66 86 66"
    ],
    "fr": [
      "Cours de cuisine avec le Chef Gilles Roux : maîtrisez la cuisson basse température viande & poisson ! De 15h à 18h30, découvrez ses techniques et partagez un moment gourmand. 60€ avec 2 portions à emporter. Réservation : 04 71 66 86 66"
    ],
    "nl": [
      "Kooklessen met chef-kok Gilles Roux: leer op lage temperatuur vlees en vis bereiden! Ontdek van 15.00 tot 18.30 uur zijn technieken en deel een gastronomisch moment. 60? met 2 porties om mee te nemen. Reserveren: 04 71 66 86 66"
    ],
    "es": [
      "Clases de cocina con el Chef Gilles Roux: ¡dominio de la cocción a baja temperatura de carnes y pescados! De 15:00 a 18:30, descubra sus técnicas y comparta un momento gourmet. 60? con 2 raciones para llevar. Reservas: 04 71 66 86 66"
    ]
  },
