  "rdfs:comment": {
    "de": [
      "Wer war der Gefangene im Sarazenenturm? Eine Suche nach Hinweisen führt Sie in die Verliese des Schlosses - wenn Sie alle Rätsel lösen!"
    ],
    "en": [
      "A funny discovery of the castle searching for clues to resolve an enigma : \"Who was the Tour Sarrazine prisoner ?\"."
    ],
    "it": [
      "Chi era il prigioniero nella Torre dei Saraceni? Una ricerca di indizi vi condurrà nelle segrete del castello... se riuscirete a risolvere tutti gli enigmi!"
    ],
    "fr": [
      "Qui était le prisonnier de la Tour Sarrasine ? Une quête d'indices vous mènera aux oubliettes du château... si vous résolvez toutes les énigmes !"
    ],
    "es": [
      "¿Quién era el prisionero de la Torre Sarracena? Una búsqueda de pistas te llevará a las mazmorras del castillo... ¡si consigues resolver todos los enigmas!"
    ],
    "nl": [
      "Wie was de gevangene in de Saraceense toren? Een zoektocht naar aanwijzingen leidt je naar de kerkers van het kasteel... als je alle raadsels kunt oplossen!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Enigma : \"The secret of the Tour Sarrazine prisoner\""
    ],
    "fr": [
      "Énigme « Le secret du prisonnier de la Tour Sarrasine »"
    ]
  },
