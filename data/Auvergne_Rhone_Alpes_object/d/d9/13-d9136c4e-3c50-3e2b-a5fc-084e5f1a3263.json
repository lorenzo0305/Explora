  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Spot empfängt Sie am Ufer des Sees von Monteynard mit einer Küche aus frischen und lokalen Produkten. Die schattige Terrasse mit Blick auf den Strand und den See ermöglicht einen angenehmen Moment der Entspannung in einer natürlichen und geselligen Umgebung."
    ],
    "en": [
      "Le Spot restaurant welcomes you to the shores of Lake Monteynard, with cuisine based on fresh, local produce. The shaded terrace overlooks the beach and the lake, making for a pleasant moment of relaxation in a natural, friendly setting."
    ],
    "it": [
      "Il ristorante Le Spot vi accoglie sulle rive del lago di Monteynard con una cucina a base di prodotti freschi e locali. La terrazza ombreggiata con vista sulla spiaggia e sul lago offre un piacevole momento di relax in un ambiente naturale e accogliente."
    ],
    "fr": [
      "Le restaurant Le Spot vous accueille sur les rives du lac de Monteynard avec une cuisine issue de produits frais et locaux. La terrasse ombragée avec vue sur la plage et le lac permet un moment de détente agréable dans un cadre naturel et convivial."
    ],
    "nl": [
      "Het restaurant Le Spot verwelkomt u aan de oevers van het meer van Monteynard met een keuken op basis van verse en lokale producten. Het schaduwrijke terras met uitzicht op het strand en het meer biedt een aangenaam moment van ontspanning in een natuurlijke en vriendelijke omgeving."
    ],
    "es": [
      "El restaurante Le Spot le da la bienvenida a orillas del lago Monteynard con una cocina basada en productos frescos y locales. La terraza sombreada con vistas a la playa y al lago ofrece un agradable momento de relajación en un entorno natural y acogedor."
    ]
  },
