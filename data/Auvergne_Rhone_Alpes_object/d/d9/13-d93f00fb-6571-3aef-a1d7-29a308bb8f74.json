  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration von 11 bis 15 Uhr. Kleine Brasserie von 7 bis 11 Uhr und von 15 bis 24 Uhr. Mezzanin, französische Decke, Holzvertäfelung. Kartel-Mobiliar (Philippe Stark): neoklassische Stühle & Tische. Terrasse das ganze Jahr über. Englisch gesprochen."
    ],
    "en": [
      "Traditional catering from 11am to 3pm. Small brasserie from 7am to 11am and from 3pm to midnight. Mezzanine, French ceiling, woodwork. Kartel furniture (Philippe Stark): neo-classical chairs & tables. Year-round terrace. English spoken."
    ],
    "it": [
      "Ristorante tradizionale dalle 11.00 alle 15.00. Piccola brasserie dalle 7 alle 11 e dalle 15 a mezzanotte. Soppalco, soffitto alla francese, boiserie. Mobili Kartel (Philippe Stark): sedie e tavoli neoclassici. Terrazza tutto l'anno. Inglese parlato."
    ],
    "fr": [
      "Restauration traditionnelle de 11h à 15h. Petite brasserie de 7h à 11h et de 15h à minuit. Mezzanine, plafond à la française, boiseries. Mobilier Kartel (Philippe Stark) : chaises & tables néo-classiques. Terrasse à l'année. Anglais parlé."
    ],
    "nl": [
      "Traditioneel restaurant van 11 tot 15 uur. Kleine brasserie van 7 tot 11 uur en van 15 tot middernacht. Mezzanine, Frans plafond, houtwerk. Kartelmeubelen (Philippe Stark): neoklassieke stoelen en tafels. Terras het hele jaar door. Engels gesproken."
    ],
    "es": [
      "Restaurante tradicional de 11 a 15 horas. Pequeña brasserie de 7 a 11 horas y de 15 a 24 horas. Entresuelo, techo francés, carpintería. Muebles Kartel (Philippe Stark): sillas y mesas neoclásicas. Terraza durante todo el año. Se habla inglés."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Friendly Café"
    ]
  },
