  "rdfs:comment": {
    "de": [
      "Diese speziell für Fahrräder konzipierte Mission führt durch den schönsten Eichenwald Europas.\r\nUm zu spielen, laden Sie die kostenlose mobile App \"PÉPIT\" herunter."
    ],
    "en": [
      "This mission, specially designed for bikes, allows you to discover the most beautiful oak forest in Europe.\r\nTo play, download the free \"PÉPIT\" mobile application."
    ],
    "it": [
      "Questa missione è stata progettata appositamente per le biciclette e permette di scoprire il più bel querceto d'Europa.\r\nPer giocare, scaricare l'applicazione mobile gratuita \"PÉPIT\"."
    ],
    "fr": [
      "Cette mission spécialement conçue pour les vélos permet de découvrir la plus belle chênaie d'Europe.\r\nPour jouer, téléchargez l’application mobile gratuite \"PÉPIT\"."
    ],
    "es": [
      "Esta misión, especialmente diseñada para bicicletas, le permitirá descubrir el robledal más hermoso de Europa.\r\nPara jugar, descárgate la aplicación móvil gratuita \"PÉPIT\"."
    ],
    "nl": [
      "Deze missie is speciaal ontworpen voor fietsen, zodat je het mooiste eikenbos van Europa kunt ontdekken.\r\nDownload om te spelen de gratis mobiele applicatie \"PÉPIT\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PÉPIT : Drôlement « futaie » ces forestiers !"
    ]
  },
