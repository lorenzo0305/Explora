  "rdfs:comment": {
    "de": [
      "Pizza- und Grillspezialitäten. In der Nähe des Schlosses in einer charaktervollen Gasse, die typisch für die alte Stadt ist. 81 Pizzen aus dem Holzofen, die von Sebastian meisterhaft zubereitet werden, und traditionelle Gerichte. Panoramablick auf die Umgebung. Spätdienst am Abend."
    ],
    "en": [
      "Restaurant close to the castle, tucked away in a narrow street of character in the medieval historic centre. \r\nPizzas skillfully prepared by Sébastien, in a wood-fired oven. 81 different toppings.\r\nTraditional French dishes and local specialities such as the renowned potato crique. Panoramic view.\r\nLate evening service."
    ],
    "it": [
      "Specialità pizza e griglia. Vicino al castello, in una stradina tipica della città vecchia. 81 pizze cotte a legna offerte e sapientemente eseguite da Sébastien, e piatti tradizionali. Vista panoramica. Servizio fino a tarda notte."
    ],
    "fr": [
      "Spécialités pizzas et grill. Proche du château dans une ruelle de caractère typique de la vieille cité. 81 pizzas au feu de bois proposées et exécutées de mains de Maître par Sébastien, et des plats traditionnels. Vue panoramique. Service tardif le soir."
    ],
    "nl": [
      "Pizza's en grillspecialiteiten. Vlakbij het kasteel, in een karakteristiek steegje van de oude stad. 81 houtgestookte pizza's vakkundig bereid door Sébastien, plus traditionele gerechten. Panoramisch uitzicht. Service tot laat in de avond."
    ],
    "es": [
      "Especialidad en pizzas y parrilla. Cerca del castillo, en una calle estrecha típica del casco antiguo. 81 pizzas a la leña ofrecidas y ejecutadas con maestría por Sébastien, y platos tradicionales. Vista panorámica. Servicio nocturno."
    ]
  },
