  "rdfs:comment": {
    "de": [
      "Bauernhof mit Mischkultur und Viehzucht im Kollektiv. Milchviehhaltung mit dem Label bleu blanc coeur.  Apfel-Birnen-Obstgarten in Bio-Landwirtschaft, Bio-Gemüseanbau. Kulturelle und landwirtschaftliche Veranstaltungen mit dem Verein Terre de Sens Bermeries."
    ],
    "en": [
      "Mixed-crop breeding farm. Label bleu blanc coeur dairy farm.  Organic apple and pear orchard, organic market gardening. Cultural and agricultural events with the Terre de Sens Bermeries association."
    ],
    "it": [
      "Azienda agricola con colture e allevamenti misti. Etichetta bleu blanc coeur azienda lattiero-casearia.  Meleto e pereto biologici, orticoltura biologica. Eventi culturali e agricoli con l'associazione Terre de Sens Bermeries."
    ],
    "fr": [
      "Ferme polyculture élevage en collectif. Elevage laitier en label bleu blanc coeur.  Verger pomme poire en agriculture bio, maraichage bio. Evénement culturel et agricole avec l'association Terre de Sens Bermeries."
    ],
    "nl": [
      "Gemengd landbouw- en veeteeltbedrijf. Label bleu blanc coeur melkveebedrijf.  Biologische appel- en perenboomgaard, biologische tuinbouw. Culturele en agrarische evenementen met de vereniging Terre de Sens Bermeries."
    ],
    "es": [
      "Explotación agrícola y ganadera mixta. Label bleu blanc coeur granja lechera.  Huerto ecológico de manzanas y peras, horticultura ecológica. Eventos culturales y agrícolas con la asociación Terre de Sens Bermeries."
    ]
  },
