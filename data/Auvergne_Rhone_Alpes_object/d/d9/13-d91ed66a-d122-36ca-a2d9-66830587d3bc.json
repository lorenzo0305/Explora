  "rdfs:comment": {
    "de": [
      "Traditionelle Küche mit saisonalem Gemüse, das in der Umgebung geerntet wird. \"Le Berger\" (Alain) kocht und \"Sosso\" (Solange) empfängt Sie mit Herzlichkeit.\r\nHausgemachte Pizzas vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Traditional cuisine with seasonal vegetables harvested in the area. \"Le Berger\" (Alain) cooks and \"Sosso\" (Solange) welcomes you with warmth.\nHome-made pizzas on the spot or to take away."
    ],
    "it": [
      "Cucina tradizionale con verdure di stagione raccolte nella zona. \"Le Berger\" (Alain) cucina e \"Sosso\" (Solange) vi accoglie con calore.\r\nPizze fatte in casa sul posto o da asporto."
    ],
    "fr": [
      "Cuisine traditionnelle avec légumes de saison récoltés dans les environs. \"Le Berger\" (Alain) cuisine et \"Sosso\" (Solange) vous accueillent avec chaleur.\r\nPizzas maison sur place ou à emporter."
    ],
    "nl": [
      "Traditionele keuken met seizoensgebonden groenten uit de streek. \"Le Berger\" (Alain) kookt en \"Sosso\" (Solange) ontvangt u met warmte.\r\nZelfgemaakte pizza's ter plaatse of om mee te nemen."
    ],
    "es": [
      "Cocina tradicional con verduras de temporada cosechadas en la zona. \"Le Berger\" (Alain) cocina y \"Sosso\" (Solange) te acoge con calidez.\r\nPizzas caseras al momento o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez le Berger"
    ]
  },
