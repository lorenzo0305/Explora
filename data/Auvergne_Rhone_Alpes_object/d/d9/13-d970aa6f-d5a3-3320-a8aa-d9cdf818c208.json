  "rdfs:comment": {
    "de": [
      "Das Caquetoire ist ein Raum der Aufregung und des kollektiven Handelns, um Kontakte zu knüpfen, die Bedürfnisse des Territoriums zu erkennen und zu versuchen, darauf zu reagieren. Mittwochs und samstags ist es auch ein Café für einen Drink."
    ],
    "en": [
      "The Caquetoire is a space for collective action, to build links, identify the needs of the territory and try to respond to them. It's also a café for a drink on Wednesday and Saturday mornings."
    ],
    "it": [
      "Il Caquetoire è uno spazio di eccitazione e azione collettiva, per creare connessioni, identificare i bisogni del territorio e cercare di rispondere ad essi. È anche un bar per un drink il mercoledì e il sabato."
    ],
    "fr": [
      "Le Caquetoire est un espace d'effervescence et d'action collective, pour faire du lien, identifier les besoins du territoire et tenter d'y répondre. C'est aussi un café pour boire un verre les mercredis et samedis."
    ],
    "nl": [
      "Le Caquetoire is een plek waar mensen samen kunnen komen om contacten te leggen, lokale behoeften te identificeren en te proberen daarin te voorzien. Het is ook een café voor een drankje op woensdag en zaterdag."
    ],
    "es": [
      "Le Caquetoire es un lugar donde la gente puede reunirse para establecer contactos, identificar las necesidades locales e intentar satisfacerlas. También es un café para tomar algo los miércoles y sábados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café associatif le Caquetoire"
    ]
  },
