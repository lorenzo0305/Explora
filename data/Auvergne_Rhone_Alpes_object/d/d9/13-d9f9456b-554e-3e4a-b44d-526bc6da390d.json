  "rdfs:comment": {
    "de": [
      "Das NH Lyon Airport ist im neuen Vintage-Chic-Stil eingerichtet und verfügt über 245 Zimmer, 13 Tagungsräume, 2 Bars und das Restaurant Les 100 Ciels\". Es ist der ideale Ort, um vom Flughafen Lyon Saint-Exupéry abzufliegen oder dort anzukommen."
    ],
    "en": [
      "Featuring a brand new Vintage chic style, the NH Lyon Airport has 245 rooms, 13 meeting rooms, 2 bars and a restaurant ‘Les 100 Ciels’. It is the ideal place to stay on departure from or arrival at Lyon Saint-Exupéry airport."
    ],
    "it": [
      "Caratterizzato da un nuovissimo stile Vintage chic, l'NH Lyon Airport dispone di 245 camere, 13 sale riunioni, 2 bar e un ristorante \"Les 100 Ciels\". È il luogo ideale per soggiornare all'arrivo o alla partenza dall'aeroporto di Lione Saint-Exupéry."
    ],
    "fr": [
      "Doté d’un tout nouveau style Vintage chic, le NH Lyon Airport dispose de 245 chambres, 13 salles de réunion, 2 bars et un restaurant « Les 100 Ciels ». C’est le lieu idéal au départ ou à l’arrivée de l’aéroport de Lyon Saint-Exupéry."
    ],
    "nl": [
      "Het NH Lyon Airport heeft een gloednieuwe Vintage chic stijl en beschikt over 245 kamers, 13 vergaderzalen, 2 bars en een restaurant \"Les 100 Ciels\". Het is de ideale plek om te verblijven bij aankomst of vertrek vanaf de luchthaven Lyon Saint-Exupéry."
    ],
    "es": [
      "Con un nuevo estilo Vintage chic, el NH Lyon Aeropuerto dispone de 245 habitaciones, 13 salas de reuniones, 2 bares y un restaurante \"Les 100 Ciels\". Es el lugar ideal para alojarse a la llegada o salida del aeropuerto de Lyon Saint-Exupéry."
    ]
  },
