  "rdfs:comment": {
    "de": [
      "Das Shakesbeer weiht den Place de Bérulle als Hochburg des Grenobler Nachtlebens ein. Mit seiner kleinen, sehr angenehmen Terrasse und seinem gemütlichen Saal (Petit Futé 2024)"
    ],
    "en": [
      "Le Shakesbeer has established the Place de Bérulle as one of Grenoble's nightlife hotspots. With its pleasant little terrace and cosy dining room (Petit Futé 2024)"
    ],
    "it": [
      "Lo Shakesbeer ha fatto della Place de Bérulle uno dei punti di riferimento della vita notturna di Grenoble. Con la sua piacevole terrazzina e l'accogliente sala da pranzo (Petit Futé 2024)"
    ],
    "fr": [
      "Le Shakesbeer consacre la place de Bérulle comme une place forte des sorties nocturnes grenobloises. Avec sa petite terrasse des plus agréable et sa salle chaleureuse (Petit Futé 2024)"
    ],
    "es": [
      "El Shakesbeer ha consolidado la plaza de Bérulle como uno de los puntos neurálgicos de la vida nocturna de Grenoble. Con su agradable terracita y su acogedor comedor (Petit Futé 2024)"
    ],
    "nl": [
      "De Shakesbeer heeft de Place de Bérulle gevestigd als een van de hotspots voor het nachtleven van Grenoble. Met zijn aangename kleine terras en gezellige eetzaal (Petit Futé 2024)"
    ]
  },
