  "rdfs:comment": {
    "de": [
      "Ein Event im Pays Berjallien, ein 2200m² großer Komplex mit 16 fluoreszierenden Bowlingbahnen.\r\nAlles ist darauf ausgerichtet, Ihnen einen Moment der Entspannung und Freizeitgestaltung zu bieten, mit Freunden oder Kollegen oder auch mit der Familie in einer exotischen und kosmischen Atmosphäre."
    ],
    "en": [
      "An event in the Berjallian country, a 2200m² complex with 16 fluorescent bowling lanes.\r\nEverything is thought to offer you a moment of relaxation and leisure, with friends or colleagues or with your family in an exotic and cosmic atmosphere."
    ],
    "it": [
      "Un evento nel paese di Berjallian, un complesso di 2200 m² con 16 piste da bowling fluorescenti.\r\nTutto è pensato per offrirvi un momento di relax e svago, con gli amici o i colleghi o con la vostra famiglia, in un'atmosfera esotica e cosmica."
    ],
    "fr": [
      "Un événement dans le pays Berjallien, un complexe de 2200m² avec 16 pistes  de bowling fluorescentes.\r\nTout est pensé pour vous offrir un moment de détente et de loisirs, entre amis ou collègues ou bien en famille dans une ambiance exotique et cosmique."
    ],
    "es": [
      "Un evento en el campo berjalliano, un complejo de 2200m² con 16 pistas de bolos fluorescentes.\r\nTodo está pensado para ofrecerle un momento de relajación y ocio, con amigos o colegas o con su familia, en un ambiente exótico y cósmico."
    ],
    "nl": [
      "Een evenement in het Berjalliaanse land, een complex van 2200m² met 16 fluorescerende bowlingbanen.\r\nAlles is erop gericht u een moment van ontspanning en vrije tijd te bieden, met vrienden of collega's of met uw gezin in een exotische en kosmische sfeer."
    ]
  },
