  "rdfs:comment": {
    "de": [
      "Langlaufen und dabei die Ruhe der Umgebung genießen. In Apremont können Sie die Vielfalt der Landschaften genießen, indem Sie durch Wälder, Täler und Wiesen wandern."
    ],
    "en": [
      "Enjoy cross-country skiing in a peaceful environment. In Apremont, enjoy the diversity of landscapes as you cross undergrowth, combs and meadows."
    ],
    "it": [
      "Godetevi lo sci di fondo in un ambiente tranquillo. Ad Apremont, godetevi la diversità dei paesaggi attraversando boschi, colline e prati."
    ],
    "fr": [
      "Pratiquer le ski de fond tout en savourant la quiétude de l'environnement. A Apremont, appréciez la diversité des paysages en traversant sous bois, combe et prés."
    ],
    "nl": [
      "Geniet van langlaufen in een rustige omgeving. Geniet in Apremont van de verscheidenheid aan landschappen terwijl je door bossen, heuvels en weiden trekt."
    ],
    "es": [
      "Disfrute del esquí de fondo en un entorno tranquilo. En Apremont, disfruta de la diversidad de paisajes mientras atraviesas bosques, colinas y praderas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Apremont - Piste rouge de ski nordique"
    ]
  },
