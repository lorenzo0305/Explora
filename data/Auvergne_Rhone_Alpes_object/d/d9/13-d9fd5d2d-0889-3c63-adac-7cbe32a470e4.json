  "rdfs:comment": {
    "de": [
      "Produktion und Verkauf von Saisongemüse, Eiern und Nüssen aus biologischem Anbau. Verkauf von Bioprodukten anderer lokaler Erzeuger (Obst, Brot, Ziegenkäse, Fruchtsäfte, Wein, Honig). Verkauf auf dem Bauernhof jeden Mittwoch und Freitag. Präsenz von 2 Eseln auf dem Hof."
    ],
    "en": [
      "Production of seasonal vegetables, organic eggs and nuts. Sale of products from other local producers (fruit, goat's cheese, bread, wine, fruit juice, honey). 2 donkeys on the farm. Self-guided tour with descriptive panels of the farm."
    ],
    "it": [
      "Produzione e vendita di verdure di stagione, uova e noci biologiche. Vendita di prodotti biologici di altri produttori locali (frutta, pane, formaggio di capra, succo di frutta, vino, miele). Vendite in fattoria ogni mercoledì e venerdì. 2 asini nella fattoria."
    ],
    "fr": [
      "Production et vente de légumes de saison, œufs et noix bio. Vente de produits bio d'autres producteurs locaux (fruits, pain, fromage de chèvre, jus de fruits, vin, miel). Vente à la ferme tous les mercredis et vendredis. Présence de 2 ânes sur la ferme."
    ],
    "nl": [
      "Productie en verkoop van seizoensgroenten, biologische eieren en noten. Verkoop van biologische producten van andere lokale producenten (fruit, brood, geitenkaas, vruchtensap, wijn, honing). Boerderijverkoop elke woensdag en vrijdag. 2 ezels op de boerderij."
    ],
    "es": [
      "Producción y venta de verduras de temporada, huevos ecológicos y frutos secos. Venta de productos ecológicos de otros productores locales (fruta, pan, queso de cabra, zumo de fruta, vino, miel). Venta en la granja todos los miércoles y viernes. 2 burros en la granja."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sale of seasonal vegetables, eggs and organic nuts at Jardins du Coteau"
    ],
    "fr": [
      "Vente de légumes de saison, oeufs et noix bio aux Jardins du Coteau"
    ]
  },
