  "rdfs:comment": {
    "de": [
      "Das auf dem Flugplatz von Corbas gelegene Luftfahrtmuseum lädt Sie ein, im Rahmen von Führungen seine Sammlungen von Flugzeugen, Motoren und Luftfahrtausrüstungen zu entdecken, die mehr als 100 Jahre französische Luftfahrt von 1908 bis heute repräsentieren."
    ],
    "en": [
      "Located on Corbas airfield, south of Lyon, the aviation museum “clément Ader” proposes to discover, from guided tours only (no free visits allowed), a large collection of aircrafts, engines and equipments representing a century of French Aviation, from 1908 to present."
    ],
    "it": [
      "Situato sul campo d'aviazione di Corbas, il Museo dell'Aviazione vi invita a scoprire le sue collezioni di aerei, motori e attrezzature aeronautiche che rappresentano più di 100 anni di aviazione francese, dal 1908 a oggi, attraverso visite guidate."
    ],
    "fr": [
      "Situé sur l’aérodrome de Corbas le musée de l’aviation vous invite à découvrir, sous la forme de visites guidées, ses collections d’aéronefs, de moteurs et d’équipements aéronautiques représentant plus de 100 ans d’aviation française, de 1908 à nos jours."
    ],
    "es": [
      "Situado en el aeródromo de Corbas, el Museo de la Aviación le invita a descubrir sus colecciones de aviones, motores y material aeronáutico que representan más de 100 años de aviación francesa, desde 1908 hasta nuestros días, a través de visitas guiadas."
    ],
    "nl": [
      "Het Luchtvaartmuseum, gelegen op het vliegveld van Corbas, nodigt u uit om zijn collecties vliegtuigen, motoren en luchtvaartapparatuur te ontdekken die meer dan 100 jaar Franse luchtvaart vertegenwoordigen, van 1908 tot heden, door middel van rondleidingen."
    ]
  },
