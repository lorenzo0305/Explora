  "rdfs:comment": {
    "de": [
      "Dieser große Strand bietet einen atemberaubenden Blick auf den See von Aiguebelette. Mehrere Bäume und sein grüner Park bieten angenehmen Schatten und Kühle. Vor Ort: Snack und Verleih von Tretbooten, Kanus, Kajaks und Stand-up-Paddles."
    ],
    "en": [
      "This large beach offers a breathtaking view of the lac d'Aiguebelette. Several trees and a green park provide welcome shade and freshness. On-site: snack bar and rental of pedal boats, canoes, kayaks, and stand-up paddles."
    ],
    "it": [
      "Questa grande spiaggia offre una vista mozzafiato sul lago di Aiguebelette. Numerosi alberi e un parco verde offrono ombra e refrigerio. In loco: snack bar e noleggio di pedalò, canoe, kayak e pagaie."
    ],
    "fr": [
      "Cette grande plage offre une vue imprenable sur le lac d'Aiguebelette. Plusieurs arbres et son parc de verdure offrent une ombre et une fraîcheur appréciables. Sur place : snack et location de pédalos, canoës, kayaks et stand up paddles."
    ],
    "es": [
      "Esta gran playa ofrece una vista impresionante del lago de Aiguebelette. Varios árboles y un parque verde proporcionan sombra y frescor. En el lugar: snack bar y alquiler de pedales, canoas, kayaks y stand-up paddles."
    ],
    "nl": [
      "Dit grote strand biedt een adembenemend uitzicht op het meer van Aiguebelette. Verschillende bomen en een groen park zorgen voor welkome schaduw en koelte. Ter plaatse: snackbar en verhuur van waterfietsen, kano's, kajaks en stand-up paddles."
    ]
  },
  "rdfs:label": {
    "en": [
      "Beach at Sougey leisure centre"
    ],
    "fr": [
      "Plage de la base de loisirs du Sougey"
    ]
  },
