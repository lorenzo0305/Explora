  "rdfs:comment": {
    "de": [
      "Ein unvergesslicher Fahrt, um Le Grand-Bornand zu entdecken.\r\nDie Buchung einer Kutschfahrten mit einer Bauernhofbesichtigung und einer Reblochon-Probe ist ebenfalls möglich."
    ],
    "en": [
      "An unforgettable ride to discover Le Grand-Bornand.\r\nPossibility to book a ride with a farm visit and a reblochon tasting."
    ],
    "it": [
      "Una passeggiata indimenticabile alla scoperta di Le Grand-Bornand.\r\nPossibilità su prenotazione di una passeggiata con visita della fattoria e degustazione del reblochon."
    ],
    "fr": [
      "Une promenade inoubliable pour découvrir Le Grand-Bornand.\r\nPossibilité sur réservation de promenade avec visite de ferme et dégustation du reblochon."
    ],
    "es": [
      "Un paseo inolvidable para descubrir Le Grand-Bornand.\r\nPosibilidad, previa reserva, de un paseo con visita a la granja y degustación del reblochon."
    ],
    "nl": [
      "Een onvergetelijke wandeling om Le Grand-Bornand te ontdekken.\r\nMogelijkheid op reservering van een wandeling met bezoek aan de boerderij en het proeven van de reblochon."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kutschfahrten mit Claude"
    ],
    "en": [
      "Rides in Claude's carriage"
    ],
    "fr": [
      "Balades avec la calèche de Claude"
    ]
  },
