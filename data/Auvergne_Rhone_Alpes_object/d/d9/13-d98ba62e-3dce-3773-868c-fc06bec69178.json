  "rdfs:comment": {
    "de": [
      "Foodtruck mit gesunder und freundlicher Küche, ideal für Mittagspausen, Firmen- und Privatveranstaltungen. Mit einem Anhänger im Airstream-Stil bieten Sie Ihren Teams, Kunden oder Gästen ein einzigartiges Erlebnis!"
    ],
    "en": [
      "Healthy, convivial foodtruck, ideal for lunch breaks, corporate and private events. With an Airstream-style trailer, offer your teams, customers or guests a unique experience!"
    ],
    "it": [
      "Un foodtruck sano e conviviale, ideale per pause pranzo, eventi aziendali e privati. Con un rimorchio in stile Airstream, regalate ai vostri team, clienti o ospiti un'esperienza unica!"
    ],
    "fr": [
      "Foodtruck de cuisine saine et conviviale, idéal pour les pauses déjeuner, événements d’entreprise et privé. Avec une remorque style Airstream, offrez à vos équipes, clients ou invités une expérience unique !"
    ],
    "es": [
      "Un foodtruck sano y agradable, ideal para almuerzos, eventos corporativos y privados. Con un remolque estilo Airstream, ¡ofrezca a sus equipos, clientes o invitados una experiencia única!"
    ],
    "nl": [
      "Een gezonde, gezellige foodtruck, ideaal voor lunchpauzes, bedrijfs- en privé-evenementen. Met een trailer in Airstream-stijl geef je je teams, klanten of gasten een unieke ervaring!"
    ]
  },
  "rdfs:label": {
