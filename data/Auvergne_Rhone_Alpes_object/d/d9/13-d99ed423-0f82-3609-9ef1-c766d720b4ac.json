  "rdfs:comment": {
    "de": [
      "Entdecken Sie die wunderschönen Landschaften der Auvergne, wie Sie sie noch nie zuvor gesehen haben! Randorespi begleitet Sie auf aufregenden Wanderungen auf den Wegen des Pays Cantalien."
    ],
    "en": [
      "Discover the magnificent landscapes of the Auvergne as you've never seen them before! Randorespi accompanies you on exhilarating hikes along the trails of the Cantalien region."
    ],
    "it": [
      "Scoprite i magnifici paesaggi dell'Alvernia come non li avete mai visti prima! Randorespi vi accompagna in emozionanti escursioni lungo i sentieri della regione di Cantalien."
    ],
    "fr": [
      "Découvrez les magnifiques paysages d’Auvergne comme vous ne les avez jamais vus ! Randorespi vous accompagne lors de randonnées exaltantes sur les chemins du pays cantalien."
    ],
    "nl": [
      "Ontdek de prachtige landschappen van de Auvergne zoals u ze nog nooit heeft gezien! Randorespi begeleidt u op opwindende wandelingen langs de paden van de Cantalien."
    ],
    "es": [
      "Descubra los magníficos paisajes de Auvernia como nunca antes los había visto Randorespi le acompaña en estimulantes excursiones por los senderos de la región de Cantalien."
    ]
  },
