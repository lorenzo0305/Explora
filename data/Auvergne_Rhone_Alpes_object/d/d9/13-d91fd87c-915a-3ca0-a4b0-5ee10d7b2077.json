  "rdfs:comment": {
    "de": [
      "Die wunderbare Welt der Wichtel und der Zauberwald: Elfen, Trolle, Gnome; drinnen, draußen, sie sind überall. Innenbesichtigung und spielerischer Rundgang mit Rätseln im Wald... Die Anlage ist das ganze Jahr über geöffnet!"
    ],
    "en": [
      "The Wonderful World of Elves and the Enchanted Forest: elves, trolls, gnomes; inside, outside, they're everywhere. Indoor visit and fun trail with riddles in the forest. The site is open all year round!"
    ],
    "it": [
      "Le Monde merveilleux des Lutins, un luogo unico nel cuore della natura, dove vivono troll, elfi, streghe e draghi, oltre ad asini, alpaca e altri animali che vi accoglieranno con amore."
    ],
    "fr": [
      "Le Monde merveilleux des Lutins, un lieu unique en pleine nature, où vivent trolls, elfes, sorcières, dragons, mais aussi des ânes, alpagas et autres animaux qui vous accueillent avec amour."
    ],
    "es": [
      "Le Monde merveilleux des Lutins, un lugar único en plena naturaleza, hogar de trolls, elfos, brujas y dragones, así como de burros, alpacas y otros animales que le recibirán con cariño."
    ],
    "nl": [
      "De wondere wereld van elfen en het betoverde bos: elfen, trollen, kabouters; binnen, buiten, ze zijn overal. Indoor bezoek en leuke speurtocht met raadsels in het bos. De site is het hele jaar geopend!"
    ]
  },
