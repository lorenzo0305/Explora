  "rdfs:comment": {
    "de": [
      "Marthe ROBIN ist 16 Jahre alt, als bei ihr die ersten Symptome einer Enzephalitis auftreten. Diese Krankheit lähmt ihre vier Gliedmaßen und sie verliert ihr Augenlicht. Ihr ganzes Leben lang nahm sie jeden Freitag an der Passion Christi teil."
    ],
    "en": [
      "Marthe ROBIN was 16 when she suffered the first symptoms of encephalitis. The disease paralyzed her 4 limbs, and she lost her sight. For the rest of her life, she took part in the Passion of Christ every Friday."
    ],
    "it": [
      "Marthe ROBIN aveva 16 anni quando ha avuto i primi sintomi dell'encefalite. Questa malattia le paralizzerà i 4 arti e perderà la vista. Per tutta la vita, ogni venerdì, ha partecipato alla passione di Cristo."
    ],
    "fr": [
      "Marthe ROBIN a 16 ans lorsqu’elle a les premiers symptômes de l'encéphalite. Cette maladie paralysera ses 4 membre et elle en perdra la vue. Durant toute sa vie, chaque vendredi, elle participera à la passion du Christ."
    ],
    "nl": [
      "Marthe ROBIN was 16 toen ze de eerste symptomen van encefalitis kreeg. Deze ziekte verlamde haar 4 ledematen en ze verloor haar gezichtsvermogen. De rest van haar leven nam ze elke vrijdag deel aan het lijdensverhaal van Christus."
    ],
    "es": [
      "Marthe ROBIN tenía 16 años cuando tuvo los primeros síntomas de encefalitis. Esta enfermedad paralizará sus 4 extremidades y perderá la vista. A lo largo de su vida, cada viernes, participó en la pasión de Cristo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Marthe ROBIN"
    ]
  },
