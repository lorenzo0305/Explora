  "rdfs:comment": {
    "de": [
      "Ich lade Sie ein, bei pädagogischen und spielerischen Führungen, die auf junge Zielgruppen zugeschnitten sind, historische Reichtümer zu entdecken."
    ],
    "en": [
      "Emmanuelle Roch invites you to discover historical treasures during classical or thematic guided visits. She offers you tailor-made itineraries suited to your cravings and shares with you secrets and anecdotes making for fascinating discoveries."
    ],
    "it": [
      "Vorrei invitarvi a scoprire la ricchezza della storia con visite guidate educative e divertenti, adatte a un pubblico giovane."
    ],
    "fr": [
      "Je vous invite à découvrir des richesses historiques lors de visites pédagogiques et ludiques, adaptées aux jeunes publics."
    ],
    "es": [
      "Les invito a descubrir tesoros históricos en visitas educativas y divertidas, adaptadas al público infantil."
    ],
    "nl": [
      "Ik nodig je graag uit om de rijkdom van de geschiedenis te ontdekken tijdens leerzame en leuke rondleidingen, op maat gemaakt voor een jong publiek."
    ]
  },
  "rdfs:label": {
