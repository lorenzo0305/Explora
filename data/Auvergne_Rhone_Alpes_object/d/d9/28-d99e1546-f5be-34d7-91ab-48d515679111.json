  "rdfs:comment": {
    "de": [
      "Le Grenier de Lau, eine kleine Oase in Senlis, die sich der losen Ware, dem Null-Abfall, Bio und schönen Fundstücken verschrieben hat: ein Feinkostladen, in dem man außergewöhnliche Kaffees und Tees, Naturkosmetik und umweltfreundliche Haushaltsprodukte findet... alles, um sich mit gutem Gewissen etwas Gutes zu tun."
    ],
    "en": [
      "Le Grenier de Lau, a little Senlisian haven dedicated to bulk, zero-waste, organics and great finds: a fine grocery store where you can find exceptional coffees and teas, natural cosmetics and eco-friendly home products? enough to indulge yourself? with a clear conscience."
    ],
    "it": [
      "Le Grenier de Lau, un piccolo rifugio nel quartiere di Senlis dedicato allo sfuso, ai rifiuti zero, ai prodotti biologici e alle grandi scoperte: una gastronomia dove trovare caffè e tè eccezionali, cosmetici naturali e prodotti per la casa eco-compatibili, tutto ciò che serve per trattarsi con la coscienza pulita."
    ],
    "fr": [
      "Le Grenier de Lau, un petit havre senlisien dédié au vrac, au zéro déchet, au bio et aux belles trouvailles : une épicerie fine où l’on trouve cafés et thés d’exception, cosmétiques naturels et produits maison écolo — de quoi se faire plaisir…en toute conscience."
    ],
    "es": [
      "Le Grenier de Lau, un pequeño paraíso en el barrio de Senlis dedicado a los productos a granel, de residuo cero, ecológicos y grandes hallazgos: una tienda delicatessen donde encontrará cafés y tés excepcionales, cosmética natural y productos ecológicos para el hogar... todo lo que necesita para darse un capricho... con la conciencia tranquila."
    ],
    "nl": [
      "Le Grenier de Lau, een klein toevluchtsoord in de buurt van Senlis gewijd aan bulk, zero waste, biologische producten en geweldige vondsten: een delicatessenwinkel waar je uitzonderlijke koffie en thee, natuurlijke cosmetica en milieuvriendelijke huishoudelijke producten vindt? alles wat je nodig hebt om jezelf te verwennen? met een zuiver geweten."
    ]
  },
