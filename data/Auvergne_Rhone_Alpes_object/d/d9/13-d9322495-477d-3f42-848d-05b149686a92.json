  "rdfs:comment": {
    "de": [
      "Innerhalb der Residenz CGH Le Cristal de l'Alpe. Gesichts- und Körperpflegebehandlungen von 30 bis 90 Minuten mit der Marke Sothys. Kinderbehandlungen mit der Marke Nougatine. Massagen und Rituale mit der Marke Charme d'Orient."
    ],
    "en": [
      "In the CGH Le Cristal de l'Alpe residence. Facial and body treatments from 30 to 90 minutes with the Sothys brand. Children's treatments with the Nougatine brand. Massages and rituals with the Charme d'Orient brand."
    ],
    "it": [
      "Presso la residenza CGH Le Cristal de l'Alpe. Trattamenti viso e corpo da 30 a 90 minuti con il marchio Sothys. Trattamenti per bambini con il marchio Nougatine. Massaggi e rituali con il marchio Charme d'Orient."
    ],
    "fr": [
      "Au sein de la résidence CGH Le Cristal de l’Alpe. Soins du visage et du corps de 30 à 90 minutes avec la marque Sothys. Soins enfants réalisés avec la marque Nougatine. Massages et rituels avec la marque Charme d’Orient."
    ],
    "nl": [
      "In de CGH residentie Le Cristal de l'Alpe. Gezichts- en lichaamsbehandelingen van 30 tot 90 minuten met het merk Sothys. Kinderbehandelingen van het merk Nougatine. Massages en rituelen van het merk Charme d'Orient."
    ],
    "es": [
      "En la residencia CGH Le Cristal de l'Alpe. Tratamientos faciales y corporales de 30 a 90 minutos con la marca Sothys. Tratamientos infantiles con la marca Nougatine. Masajes y rituales con la marca Charme d'Orient."
    ]
  },
