  "rdfs:comment": {
    "de": [
      "Die Pianistin Sophia Liu, ein Wunderkind unter 20 Jahren, kehrt nach Lyon zurück, dieses Mal auf die große Bühne der Oper: die Entdeckung einer atemberaubenden und inspirierenden Künstlerin!"
    ],
    "en": [
      "An under-20 prodigy, pianist Sophia Liu returns to the Lyon Opera – this time on the main stage. Discover a stunning and inspiring artist !"
    ],
    "it": [
      "Prodigio sotto i 20 anni, la pianista Sophia Liu torna a Lione, questa volta sul grande palcoscenico dell'Opéra: la scoperta di un'artista mozzafiato e stimolante!"
    ],
    "fr": [
      "Prodige de moins de 20 ans, la pianiste Sophia Liu revient à Lyon, cette fois-ci sur la grande scène de l’Opéra : la découverte d’une artiste époustouflante et inspirante !"
    ],
    "es": [
      "Prodigio con menos de 20 años, la pianista Sophia Liu vuelve a Lyon, esta vez en el gran escenario de la Ópera: ¡el descubrimiento de una artista impresionante e inspiradora!"
    ],
    "nl": [
      "Als wonderkind van nog geen 20 jaar keert pianiste Sophia Liu terug naar Lyon, dit keer op het grote podium van de Opéra: de ontdekking van een adembenemende en inspirerende artieste!"
    ]
  },
