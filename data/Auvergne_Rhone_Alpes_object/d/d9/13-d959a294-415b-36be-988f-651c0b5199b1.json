  "rdfs:comment": {
    "de": [
      "Das GAC ist ein Ort für zeitgenössische Kunst und bietet ein jährliches Programm, Unterstützung für die künstlerische Produktion, die Herausgabe von Drucken sowie Vermittlungs- und Sensibilisierungsmaßnahmen für ein breites Publikum."
    ],
    "en": [
      "Contemporary Art Center located in the heart of the town in Annonay, near Tourist Office. Le GAC offer six exhibitions each year in his gallery : (works, performances, artistic residencies) as well as the \"Rendez-vous au GAC\" (meeting, lectures)."
    ],
    "it": [
      "Il GAC, centro d'arte contemporanea, sviluppa le sue attività attraverso una programmazione annuale, il sostegno alla produzione artistica, la pubblicazione di stampe e iniziative di promozione e sensibilizzazione di un pubblico ampio."
    ],
    "fr": [
      "Le GAC, lieu d'art contemporain, déploie ses activités à travers une programmation annuelle , un soutien à la production artistique, l’édition d’estampes et des actions de médiation et de sensibilisation auprès des publics les plus larges."
    ],
    "nl": [
      "Het GAC, een centrum voor hedendaagse kunst, ontwikkelt zijn activiteiten door middel van een jaarlijkse programmering, ondersteuning van artistieke productie, de publicatie van prints en initiatieven ter promotie en bewustmaking van een breed publiek."
    ],
    "es": [
      "El GAC, centro de arte contemporáneo, desarrolla sus actividades a través de una programación anual, el apoyo a la producción artística, la publicación de grabados e iniciativas de promoción y sensibilización de públicos muy diversos."
    ]
  },
