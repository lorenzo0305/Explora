  "rdfs:comment": {
    "de": [
      "Das JOA-Kasino bietet Ihnen 142 Spielautomaten und seinen Tischspielsalon, der Tradition und Moderne miteinander verbindet. Sie können die Sportbar und ein Restaurant mit freiem Zugang sowie das Unterhaltungsprogramm mit einem Showroom nutzen."
    ],
    "en": [
      "JOA casino proposes you 170 gambling machines, its playroom of table which allies tradition and modernity. Its lounge bar and its restaurant in free access, its animations with its quite new theater and its 250 places for your receptions."
    ],
    "it": [
      "Il casinò JOA offre 142 slot machine e una sala giochi da tavolo che unisce tradizione e modernità. Potrete usufruire di un bar sportivo e di un ristorante ad accesso gratuito, oltre che dell'intrattenimento con un auditorium."
    ],
    "fr": [
      "Le casino JOA vous propose 142 machines à sous, son salon de jeux de table qui allie tradition et modernité. Vous pourrez profiter du bar des sports et d'un restaurant en accès libre ainsi que des animations avec une salle de spectacles."
    ],
    "nl": [
      "Het JOA-casino biedt 142 gokautomaten en een speelzaal die traditie en moderniteit combineert. Je kunt genieten van de sportbar en een restaurant met gratis toegang, evenals entertainment met een auditorium."
    ],
    "es": [
      "El casino JOA ofrece 142 máquinas tragaperras y una sala de juegos de mesa que combina tradición y modernidad. Podrá disfrutar del bar deportivo y de un restaurante de acceso gratuito, así como de entretenimiento con un auditorio."
    ]
  },
