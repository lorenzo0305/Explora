  "rdfs:comment": {
    "de": [
      "Zwanzig Jahre nach ihrem ersten Tonaustausch vereinen der malische Kora-Meister Ballaké Sissoko und der englisch-italienische Dichter Piers Faccini erneut ihr Talent auf der Bühne."
    ],
    "en": [
      "Twenty years after they first exchanged notes, Malian kora master Ballaké Sissoko and Anglo-Italian poet Piers Faccini join forces once again on stage."
    ],
    "it": [
      "A vent'anni dal loro primo scambio di note, il maestro di kora maliano Ballaké Sissoko e il poeta anglo-italiano Piers Faccini uniscono nuovamente i loro talenti sul palco."
    ],
    "fr": [
      "Vingt ans après leurs premières notes échangées, le maître malien de la kora, Ballaké Sissoko et le poète anglo-italien, Piers Faccini unissent à nouveau leur talent sur scène."
    ],
    "es": [
      "Veinte años después de intercambiar sus primeras notas, el maestro maliense de la kora Ballaké Sissoko y el poeta angloitaliano Piers Faccini vuelven a unir sus talentos sobre el escenario."
    ],
    "nl": [
      "Twintig jaar nadat ze voor het eerst notities uitwisselden, combineren de Malinese kora-meester Ballaké Sissoko en de Engels-Italiaanse dichter Piers Faccini opnieuw hun talenten op het podium."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert: Ballaké Sissoko & Piers Faccini"
    ]
  },
