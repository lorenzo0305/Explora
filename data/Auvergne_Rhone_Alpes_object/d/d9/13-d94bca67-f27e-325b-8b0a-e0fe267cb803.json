  "rdfs:comment": {
    "de": [
      "Direkt gegenüber des Family-Kinos heißen Sie Liliane und Charles in ihrem Lokal willkommen, um Pizzen zu genießen -aber nicht nur! Zahlreiche italienische Spezialitäten werden angeboten."
    ],
    "en": [
      "Just opposite the Family Cinema, Liliane and Charles welcome you to their restaurant serving pizzas, but not only! You’ll also find a whole multitude of Italian specialities."
    ],
    "it": [
      "Proprio accanto al Family Cinema, Gérald e Pascale saranno lieti di accogliervi con le loro pizze... ma non solo! Vi offriranno anche un'ampia gamma di specialità italiane."
    ],
    "fr": [
      "Tout près du Family cinéma, Gérald et Pascale vous accueillent dans leur espace, pour déguster des pizzas... mais pas que ! De nombreuses spécialités italiennes vous seront aussi proposées."
    ],
    "es": [
      "Justo al lado del Cine Familiar, Gérald y Pascale estarán encantados de darle la bienvenida a sus pizzas... ¡pero eso no es todo! También ofrecen una amplia gama de especialidades italianas."
    ],
    "nl": [
      "Gérald et Pascle ontvangen u in hun nieuwe pizerria, waar niet alleen pizzas worden geserveerd, maar ook andere heerlijke italiaanse gerechten. Kom en laat u zich vooral verleiden. Voor de mensen die haast hebben is er een dag menu"
    ]
  },
