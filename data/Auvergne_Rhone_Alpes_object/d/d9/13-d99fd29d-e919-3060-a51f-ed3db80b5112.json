  "rdfs:comment": {
    "de": [
      "Wunderschöne Terrasse mit Panoramablick auf den Mont Blanc.\r\nHausgemachte, freundliche und raffinierte Küche mit frischen Produkten, Mittag- und Abendservice.\r\nWir bieten Ihnen auch Gerichte zum Mitnehmen an: Croziflette, Tartiflette, Fondue, Raclette, Burger etc."
    ],
    "en": [
      "Magnificent terrace with panoramic view of Mont Blanc.\r\nHomemade, friendly and refined cuisine made with fresh products, lunch and dinner service.\r\nWe offer take-away meals: Croziflette, Tartiflette, Fondue, Raclette, Burgers etc ..."
    ],
    "it": [
      "Magnifica terrazza con vista panoramica sul Monte Bianco.\r\nCucina casalinga, conviviale e raffinata, preparata con prodotti freschi, servizio pranzo e cena.\r\nOffriamo piatti da asporto: Croziflette, Tartiflette, Fondue, Raclette, Hamburger ecc ..."
    ],
    "fr": [
      "Magnifique terrasse vue panoramique sur le Mont Blanc.\r\nUne cuisine maison, conviviale et raffinée travaillée avec des produits frais, service midi et soir.\r\nNous vous proposons des plats à emporter:Croziflette, Tartiflette, Fondue, Raclette, Burgers etc..."
    ],
    "nl": [
      "Prachtig terras met panoramisch uitzicht op de Mont Blanc.\r\nHuisgemaakte, gezellige en verfijnde keuken gemaakt met verse producten, lunch en diner.\r\nWij bieden afhaalmaaltijden aan: Croziflette, Tartiflette, Fondue, Raclette, Burgers enz ..."
    ],
    "es": [
      "Magnífica terraza con vista panorámica del Mont Blanc.\r\nCocina casera, amable y refinada con productos frescos, servicio de comidas y cenas.\r\nLe ofrecemos comidas para llevar: Croziflette, Tartiflette, Fondue, Raclette, Hamburguesas, etc."
    ]
  },
