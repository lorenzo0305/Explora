  "rdfs:comment": {
    "de": [
      "Der neue Spielplatz an der Promenade du Fori bietet Aktivitäten für Kinder von 1 bis 12 Jahren (Rutschen, Schaukeln, Klettern...) und eine komplette Landschaftsgestaltung mit öffentlichen Bänken."
    ],
    "en": [
      "The new play area on the Promenade du Fori offers activities for children aged 1 to 12 (slides, swings, climbing wall...) and complete landscaping with public benches."
    ],
    "it": [
      "La nuova area giochi sulla Promenade du Fori offre attività per bambini da 1 a 12 anni (scivoli, altalene, arrampicate...) e una sistemazione completa con panchine pubbliche."
    ],
    "fr": [
      "La nouvelle aire de jeux de la promenade du Fori  propose des activités pour les enfants de 1 à 12 ans (toboggans, balançoires, escalade…) et un aménagement paysager complet avec bancs publics"
    ],
    "es": [
      "La nueva zona de juegos de la Promenade du Fori ofrece actividades para niños de 1 a 12 años (toboganes, columpios, escalada...) y un completo ajardinamiento con bancos públicos."
    ],
    "nl": [
      "De nieuwe speeltuin op de Promenade du Fori biedt activiteiten voor kinderen van 1 tot 12 jaar (glijbanen, schommels, klimmen, enz.) en een compleet landschap met openbare banken"
    ]
  },
