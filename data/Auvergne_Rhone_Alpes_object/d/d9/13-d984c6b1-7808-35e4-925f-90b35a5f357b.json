  "rdfs:comment": {
    "de": [
      "Auf dem Land, in der Nähe eines Teichs, am Rande der D2009, empfängt Sie dieses rustikale Haus mit dem Dekor einer Berghütte aus den 70er Jahren das ganze Jahr über (Reservierung erwünscht)."
    ],
    "en": [
      "In the countryside, near a pond and on the edge of the D2009, this rustic house is home to a family-run hotel and a restaurant serving home-grown vegetables and home-cooked regional products."
    ],
    "it": [
      "In campagna, vicino a uno stagno, ai margini della D2009, questa casa rustica arredata come uno chalet di montagna degli anni '70 vi accoglie tutto l'anno (prenotazione obbligatoria)."
    ],
    "fr": [
      "A la campagne, près d'un étang, en bordure de la D2009, cette maison rustique au décor de chalet de montagne des années 70, vous accueille toute l'année (réservation souhaitable)."
    ],
    "nl": [
      "Op het platteland, naast een vijver, aan de rand van de D2009, verwelkomt dit rustieke huis ingericht als een bergchalet uit de jaren 70 je het hele jaar door (reserveren noodzakelijk)."
    ],
    "es": [
      "En plena naturaleza, junto a un estanque, al borde de la D2009, esta casa rústica decorada como un chalet de montaña de los años 70 le da la bienvenida todo el año (imprescindible reservar)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de l'Étang"
    ]
  },
