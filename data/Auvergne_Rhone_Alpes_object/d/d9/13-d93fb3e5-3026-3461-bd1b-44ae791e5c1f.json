  "rdfs:comment": {
    "de": [
      "Handwerkliche Herstellung von einzigartigem Marmorpapier durch die Marmorierungstechnik mit Farbe und Öl. Herstellung von originellen künstlerischen Notizbüchern, Malerei (Monotypien), Collagen."
    ],
    "en": [
      "Handcrafted creation of unique marbled papers using the paint and oil marbling technique. Crafting original artistic notebooks, painting (monotypes), and collages through bookbinding."
    ],
    "it": [
      "Produzione artigianale di carte marmorizzate uniche con la tecnica della marmorizzazione a vernice e olio. Creazione di quaderni artistici originali, pittura (monotipi), collage."
    ],
    "fr": [
      "Confection artisanale de papiers marbrés uniques grâce à la technique de marbrure à la peinture et à l'huile. Réalisation de carnets artistiques originaux, peinture (monotypes), collages."
    ],
    "es": [
      "Producción artesanal de papeles jaspeados únicos mediante la técnica del jaspeado con pintura y aceite. Creación de cuadernos artísticos originales, pintura (monotipos), collages."
    ],
    "nl": [
      "Ambachtelijk vervaardigen van unieke gemarmerde papieren door middel van de verf- en olieverfmarmeringstechniek. Creatie van originele kunstnotitieboekjes, schilderijen (monotypes) en collages door kartonnage."
    ]
  },
