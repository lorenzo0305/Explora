  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet verschiedene kulturelle Medien wie Bücher, CDs und DVDs zur Ausleihe oder zur Einsichtnahme vor Ort an.\r\nSie ist für alle zugänglich, von Kleinkindern bis zu Senioren, und bietet auch einen kostenlosen Internetanschluss."
    ],
    "en": [
      "The library offers books, CDs and DVDs for loan or on-site consultation.\r\nThe library is open to all, from toddlers to senior citizens, and offers free Internet access."
    ],
    "it": [
      "La biblioteca offre una serie di supporti culturali in prestito o in consultazione: libri, CD e DVD.\r\nÈ aperta a tutti, dai bambini agli anziani, e offre anche una connessione internet gratuita."
    ],
    "fr": [
      "La bibliothèque propose au prêt ou a la consultation sur place différents supports culturels : livres, CD, DVD.\r\nElle accueille tous les publics des tout-petits au séniors et propose également une connexion internet gratuite."
    ],
    "es": [
      "La biblioteca ofrece diversos soportes culturales en préstamo o para consulta in situ: libros, CD y DVD.\r\nEstá abierta a todos, desde niños pequeños hasta personas mayores, y también ofrece conexión gratuita a internet."
    ],
    "nl": [
      "De bibliotheek biedt een scala aan culturele media te leen of ter plekke te raadplegen: boeken, cd's en dvd's.\r\nDe bibliotheek is toegankelijk voor iedereen, van peuters tot senioren, en biedt ook een gratis internetverbinding."
    ]
  },
  "rdfs:label": {
    "en": [
