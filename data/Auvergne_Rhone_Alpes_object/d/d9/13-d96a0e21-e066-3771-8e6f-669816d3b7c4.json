  "rdfs:comment": {
    "de": [
      "Die GAEC Les Clochettes bietet hauptsächlich Formages von Bioziegen an, aber auch Mehl, grüne Linsen und Rapsöl.\r\nVerkauf ab Hof nach Vereinbarung oder auf dem Markt in Le Puy-en-Velay am Samstagmorgen!"
    ],
    "en": [
      "GAEC Les Clochettes mainly sells organic goat cheese, but also flour, green lentils and rapeseed oil.\r\nSales at the farm by appointment, or at the Puy-en-Velay market on Saturday mornings!"
    ],
    "it": [
      "Il GAEC Les Clochettes vende principalmente formaggio di capra biologico, ma anche farina, lenticchie verdi e olio di colza.\r\nVendita in fattoria su appuntamento o al mercato di Puy-en-Velay il sabato mattina!"
    ],
    "fr": [
      "Le GAEC Les Clochettes propose principalement des formages de chèvre bio mais aussi de la farine, des lentilles vertes et de l'huile de colza.\r\nVente à la ferme sur rendez-vous ou au marché du Puy-en-Velay le samedi matin !"
    ],
    "nl": [
      "GAEC Les Clochettes verkoopt voornamelijk biologische geitenkaas, maar ook meel, groene linzen en koolzaadolie.\r\nVerkoop op de boerderij op afspraak of op de markt van Puy-en-Velay op zaterdagochtend!"
    ],
    "es": [
      "El GAEC Les Clochettes vende principalmente queso de cabra ecológico, pero también harina, lentejas verdes y aceite de colza.\r\nVenta en la granja con cita previa o en el mercado de Puy-en-Velay los sábados por la mañana"
    ]
  },
