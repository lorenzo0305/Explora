  "rdfs:comment": {
    "de": [
      "Der Place des Charmettes befindet sich auf der Bonconseil-Seite des Ortes, nur wenige Schritte von der Schneefront entfernt.\r\n\r\nDer Place des Charmettes ist eines der Herzen des Skiortes und verfügt über mehrere Geschäfte und Dienstleistungen."
    ],
    "en": [
      "The Place des Charmettes is on the Bonconseil side of the resort, a stone's throw from the snow front. \r\n\r\nThe Place des Charmettes has several shops and services."
    ],
    "it": [
      "Place des Charmettes si trova sul lato Bonconseil del resort, a due passi dal fronte neve.\r\n\r\nPlace des Charmettes è uno dei punti nevralgici del resort, con una vasta gamma di negozi e servizi."
    ],
    "fr": [
      "La Place des Charmettes se trouve du côté de Bonconseil de la station, à deux pas du front de neige. \r\n\r\nLa Place des Charmettes est l'un des cœurs de la station, elle dispose de plusieurs commerces et services."
    ],
    "es": [
      "La Place des Charmettes está en el lado Bonconseil de la estación, a tiro de piedra del frente de nieve.\r\n\r\nLa Place des Charmettes es uno de los corazones de la estación, con una amplia gama de tiendas y servicios."
    ],
    "nl": [
      "De Place des Charmettes ligt aan de kant van Bonconseil, op korte loopafstand van het sneeuwfront. \r\n\r\nDe Place des Charmettes heeft verschillende winkels en diensten."
    ]
  },
