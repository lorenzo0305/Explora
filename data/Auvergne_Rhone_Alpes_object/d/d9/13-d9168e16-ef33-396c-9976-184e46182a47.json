  "rdfs:comment": {
    "de": [
      "Als Glasmaler und Keramiker biete ich auch Einführungskurse für Glasmalerei und Modellieren an. Als leidenschaftliche Kunstliebhaberin haben sich Keramik und Glasmalerei auf meinem künstlerischen Weg begegnet."
    ],
    "en": [
      "I am a stained glass and ceramics artist, I also offer introductory courses in stained glass and modelling. Passionate about art, ceramics and stained glass have been at the crossroads of my artistic development."
    ],
    "it": [
      "Artista della vetrata e della ceramica, offro anche corsi di introduzione alla vetrata e alla modellazione. Ho una passione per l'arte e la ceramica e la vetrata sono state il crocevia del mio sviluppo artistico."
    ],
    "fr": [
      "Vitrailliste et céramiste, je propose également des stages d'initiation au vitrail et au modelage. Passionnée d’Art, la céramique et le vitrail ont été à la rencontre de mon cheminement artistique."
    ],
    "nl": [
      "Ik ben kunstenaar van gebrandschilderd glas en keramiek en geef ook inleidende cursussen gebrandschilderd glas en boetseren. Ik heb een passie voor kunst, en keramiek en glas-in-lood hebben op het kruispunt van mijn artistieke ontwikkeling gestaan."
    ],
    "es": [
      "Artista vidriera y ceramista, también ofrezco cursos de iniciación a la vidriera y al modelado. Me apasiona el arte, y la cerámica y las vidrieras han estado en la encrucijada de mi desarrollo artístico."
    ]
  },
  "rdfs:label": {
    "en": [
      "Terres en lumière - ceramics and stained glass"
    ],
    "fr": [
      "Terres en lumière - céramiques et vitrail"
    ],
    "nl": [
      "Terres en lumière - keramiek en glas in lood"
    ]
  },
