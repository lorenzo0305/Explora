  "rdfs:comment": {
    "de": [
      "Auf Vorbestellung :\r\n- Wanderungen mit gestockten Eseln.\r\n- Schatzsuche \"Auf dem Weg der Esel\".\r\n- Kinderanimation \"Das Frühstück der Tiere\" (im Juli und August).\r\n\r\nVor Ort: Imbissbude \"À la bosse gourmande\", die je nach Besucherzahl geöffnet ist."
    ],
    "en": [
      "By reservation: \r\n- Hikes with pack donkeys.\r\n- Treasure hunt \"On the donkey trail\".\r\n- Playful animation for children \"Breakfast with the animals\" (in July and August).\r\n\r\nOn site : refreshment bar \"À la bosse gourmande\" opened depending on the number of visitors."
    ],
    "it": [
      "Solo su prenotazione:\r\n- Passeggiate con gli asini.\r\n- Caccia al tesoro \"Sulle tracce degli asini\".\r\n- Animazione per bambini \"colazione con gli animali\" (luglio e agosto).\r\n\r\nIn loco: bar ristoro \"À la bosse gourmande\" aperto in base al numero di visitatori."
    ],
    "fr": [
      "Sur réservation :\r\n- Randonnées avec des ânes bâtés.\r\n- Chasse au trésor \"Sur le chemin des ânes\".\r\n- Animation pour enfants \"Le petit-déjeuner des animaux\" (en juillet et août).\r\n\r\nSur place : buvette \"À la bosse gourmande\" ouverte en fonction de l'affluence."
    ],
    "es": [
      "Sólo con reserva previa:\r\n- Paseos en burro.\r\n- Búsqueda del tesoro \"Por el camino de los burros\".\r\n- Animación infantil \"Desayuno con animales\" (julio y agosto).\r\n\r\nEn las instalaciones: bar \"À la bosse gourmande\" abierto en función del número de visitantes."
    ],
    "nl": [
      "Alleen op reservering:\r\n- Wandelingen met ezels.\r\n- Schattenjacht \"Op het ezelspad\".\r\n- Dierenontbijt\" kinderanimatie (juli en augustus).\r\n\r\nTer plaatse: verfrissingsbar \"À la bosse gourmande\" open naargelang het aantal bezoekers."
    ]
  },
