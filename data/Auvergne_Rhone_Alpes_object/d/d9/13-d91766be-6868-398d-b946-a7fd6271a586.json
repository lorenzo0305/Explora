  "rdfs:comment": {
    "de": [
      "Das Vercors ist für sein unterirdisches Netz und die daraus resultierende reiche und vielfältige \"Höhlenforschungs\"-Aktivität bekannt. Mit dieser Struktur können Sie spielerisch und in aller Sicherheit die Vertikale entdecken!"
    ],
    "en": [
      "The Vercors is renowned for its underground network and the rich and varied caving activity that results from it. Thanks to this structure, discover the verticality in complete safety and in a fun way!"
    ],
    "it": [
      "Il Vercors è rinomato per la sua vasta rete sotterranea e per la ricchezza della sua attività speleologica. Grazie al tour speleologico, potrete scoprire la verticale in tutta sicurezza e in modo divertente!"
    ],
    "fr": [
      "Le Vercors est réputé pour son vaste réseau souterrain et pour la richesse de son activité spéléologique. Grâce à la spéléo tour, découvrez la verticalité en toute sécurité et de façon ludique !"
    ],
    "es": [
      "El Vercors es famoso por su vasta red subterránea y por la riqueza de su actividad espeleológica. Gracias al recorrido de espeleología, podrá descubrir la vertical con total seguridad y ¡de forma divertida!"
    ],
    "nl": [
      "De Vercors staat bekend om zijn enorme ondergrondse netwerk en om de rijkdom van zijn speleologie. Dankzij het speleologieparcours kun je het verticale in alle veiligheid en op een leuke manier ontdekken!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Künstliche Struktur für Höhlenforschung - Spéléo'Tour José Mulot"
    ],
    "en": [
      "Artificial caving structure - Spéléo'Tour José Mulot"
    ],
    "fr": [
      "Structure artificielle de spéléologie - Spéléo'Tour José Mulot"
    ]
  },
