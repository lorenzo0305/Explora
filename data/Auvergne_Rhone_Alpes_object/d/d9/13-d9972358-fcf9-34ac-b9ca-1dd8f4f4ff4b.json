  "rdfs:comment": {
    "de": [
      "Die Pizzeria Mac Dowel bietet Ihnen das ganze Jahr über frische italienische Pizzen und Pasta sowie andere Spezialitäten aus Italien.Vor Ort oder zum Mitnehmen, Menü, À-la-carte-Gerichte und Kindermenü."
    ],
    "en": [
      "All year round, the Mac Dowel pizzeria serves pizza and fresh Italian pasta, as well as other specialities from Italy. Set meals, à-la-carte dishes and special menus for children, to eat in or take away."
    ],
    "it": [
      "La pizzeria Mac Dowel serve pizze e paste fresche italiane e altre specialità italiane tutto l'anno. In loco e da asporto."
    ],
    "fr": [
      "La pizzeria Mac Dowel vous propose tout au long de l’année des pizzas et pâtes fraîches italiennes ainsi que d’autres spécialités d’Italie. Sur place et à emporter."
    ],
    "nl": [
      "Mac Dowel pizzeria serveert het hele jaar door verse Italiaanse pizza's en pasta's en andere Italiaanse specialiteiten. Ter plekke en om mee te nemen."
    ],
    "es": [
      "La pizzería Mac Dowel sirve pizzas y pastas italianas frescas y otras especialidades italianas durante todo el año. En el local y para llevar."
    ]
  },
