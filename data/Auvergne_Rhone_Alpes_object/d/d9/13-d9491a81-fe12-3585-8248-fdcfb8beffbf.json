  "rdfs:comment": {
    "de": [
      "Der BDF empfängt Sie in einer freundlichen Atmosphäre! Verkauf von lokalen Weinen, aber auch von Weinen aus verschiedenen Regionen, Wein im Glas, lokale und italienische Wurstbretter!"
    ],
    "en": [
      "The BDF welcomes you in a friendly atmosphere! Local and regional wines for sale, wine by the glass, local and Italian charcuterie boards!"
    ],
    "it": [
      "Il BDF vi accoglie in un'atmosfera amichevole! Vendita di vini locali e regionali, vino al bicchiere, taglieri di salumi locali e italiani!"
    ],
    "fr": [
      "Le BDF vous accueille dans une ambiance conviviale ! Vente de vins locaux mais aussi de différentes régions, vin au verre, planches de charcuteries locales et italiennes  !"
    ],
    "es": [
      "El BDF le da la bienvenida en un ambiente acogedor Venta de vinos locales y regionales, vino por copas y tablas de embutidos locales e italianos"
    ],
    "nl": [
      "BDF verwelkomt je in een gezellige sfeer! Lokale en regionale wijnen te koop, wijn per glas, lokale en Italiaanse vleeswarenplanken!"
    ]
