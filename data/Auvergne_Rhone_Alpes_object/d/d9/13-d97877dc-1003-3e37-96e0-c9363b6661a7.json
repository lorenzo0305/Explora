  "rdfs:comment": {
    "de": [
      "Essen Sie sorgfältig angebautes Gemüse aus einer lokalen und umweltfreundlichen Landwirtschaft.\r\nWählen Sie Ihre Formel mit maßgeschneiderten Körben, die aus saisonalem Gemüse bestehen und direkt auf dem Bauernhof abgeholt werden können."
    ],
    "en": [
      "Eat carefully-grown vegetables from local, environmentally-friendly agriculture.\r\nChoose your formula with customized baskets of seasonal vegetables, to be picked up directly at the farm."
    ],
    "it": [
      "Mangiate verdure coltivate con cura da aziende agricole locali ed ecologiche.\r\nScegliete la vostra formula con cesti su misura di verdure di stagione, da ritirare direttamente in azienda."
    ],
    "fr": [
      "Mangez des légumes cultivés avec soin, issus d'une agriculture locale et respectueuse de l'environnement.\r\nChoisissez votre formule avec des paniers sur mesure, composés de légumes de saisons, à retirer directement à la ferme."
    ],
    "nl": [
      "Eet zorgvuldig geteelde groenten van lokale, milieuvriendelijke boerderijen.\r\nKies je formule met op maat gemaakte manden met seizoensgroenten, direct af te halen bij de boerderij."
    ],
    "es": [
      "Coma verduras cultivadas con esmero en granjas locales respetuosas con el medio ambiente.\r\nElija su fórmula con cestas a medida de verduras de temporada, que se recogerán directamente en la granja."
    ]
  },
