  "rdfs:comment": {
    "de": [
      "Der Gesundheitsparcours befindet sich in der Rue de la Loire und verläuft entlang des Wasserspiegels von Chambéon. Dieser Parcours verfügt über 10 Übungen. Eine Ballonwand, Balancierbalken, Parallelbarren, Bauchtrainerplatten, Riesenschritte, Hängeleitern, etc."
    ],
    "en": [
      "Located on rue de la Loire, the fitness trail runs alongside the Chambéon lake. The course features 10 exercises. A ball wall, balance beams, parallel bars, abdominal trays, giant steps, suspension ladders and more..."
    ],
    "it": [
      "Situato in rue de la Loire, il percorso fitness costeggia il lago di Chambéon. Il percorso prevede 10 esercizi. Un muro di palline, travi d'equilibrio, parallele, vassoi per addominali, scale giganti, scale di sospensione, ecc..."
    ],
    "fr": [
      "Situé rue de la Loire, le parcours de santé longe le plan d'eau de Chambéon. Ce parcours possède 10 exercices. Un mur à ballons, des poutres d'équilibre, des barres parallèles, des plateaux abdominaux, des pas de géants, des échelles de suspension, etc..."
    ],
    "es": [
      "Situado en la rue de la Loire, el recorrido de fitness bordea el lago de Chambéon. El recorrido cuenta con 10 ejercicios. Un muro de bolas, vigas de equilibrio, barras paralelas, bandejas abdominales, escalones gigantes, escaleras colgantes, etc..."
    ],
    "nl": [
      "Het fitnessparcours ligt in de rue de la Loire en loopt langs het meer van Chambéon. Het parcours bevat 10 oefeningen. Een ballenmuur, evenwichtsbalken, parallelle stangen, buikspierbakken, reuzentrappen, hangladders, enz..."
    ]
  },
