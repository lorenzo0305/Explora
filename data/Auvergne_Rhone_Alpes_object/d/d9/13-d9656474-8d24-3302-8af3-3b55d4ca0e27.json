  "rdfs:comment": {
    "de": [
      "Eine gewisse Sanftheit bemächtigt sich dieser Fahrradetappe auf der Via Allier, die durch Schwemmlandebenen und Wälder führt."
    ],
    "en": [
      "A certain gentleness pervades this cycling stage of the Via Allier, which crosses alluvial plains and forests."
    ],
    "it": [
      "Una certa dolcezza pervade questa tappa dell'itinerario ciclistico Via Allier, che attraversa pianure alluvionali e foreste."
    ],
    "fr": [
      "Une certaine douceur s'empare de cette étape vélo de la Via Allier qui traverse plaines alluviales et forêts."
    ],
    "es": [
      "Una cierta dulzura impregna esta etapa de la ruta ciclista Via Allier, que atraviesa llanuras aluviales y bosques."
    ],
    "nl": [
      "Deze etappe van de fietsroute Via Allier, die door alluviale vlakten en bossen loopt, wordt gekenmerkt door een zekere zachtheid."
    ]
  },
