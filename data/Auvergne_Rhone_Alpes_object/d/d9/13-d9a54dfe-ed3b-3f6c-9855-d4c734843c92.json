  "rdfs:comment": {
    "de": [
      "Pferdeschlittenfahrten auf einer märchenhaften Strecke durch den Wald des Altiports. Mit der Familie oder mit Freunden treffen Sie sich beim Restaurant le Blanchot in der Nähe der Shuttle-Haltestelle."
    ],
    "en": [
      "Horse-drawn sleigh rides on a magical trail through the Altiport forest. With family or friends, meet at the Blanchot restaurant near the shuttle stop."
    ],
    "it": [
      "Gite in slitta trainata da cavalli su un percorso magico attraverso la foresta dell'Altiport. Con la famiglia o gli amici, incontratevi al ristorante Blanchot, vicino alla fermata del bus navetta."
    ],
    "fr": [
      "Balades en traineau à cheval dans un parcours féerique dans la forêt de l'Altiport. En famille ou entre amis, rendez-vous au niveau du restaurant le Blanchot à proximité de l'arrêt de navette."
    ],
    "es": [
      "Paseos en trineo tirado por caballos por un sendero mágico a través del bosque de Altiport. En familia o con amigos, reúnete en el restaurante Blanchot, cerca de la parada del autobús lanzadera."
    ],
    "nl": [
      "Paardensleetochten over een magisch pad door het bos van Altiport. Spreek met familie of vrienden af in restaurant Blanchot bij de halte van de pendelbus."
    ]
  },
