  "rdfs:comment": {
    "de": [
      "ERÖFFNUNG SEPTEMBER 2025\r\nRomuald und Dorothée empfangen Sie unter der Woche mit einem Arbeitermenü zu 17 ? Am Wochenende wird eine Karte mit traditionellen Gerichten im Laufe des Jahres wechseln, zwischen 25 und 35 ?"
    ],
    "en": [
      "OPENING SEPTEMBER 2025\r\nRomuald and Dorothée welcome you on weekdays with a workers? menu at 17? At weekends, a menu of traditional dishes will change throughout the year, between 25 and 35 ?."
    ],
    "it": [
      "APERTURA SETTEMBRE 2025\r\nRomuald e Dorothée vi accolgono durante la settimana con un menu dei lavoratori a 17 euro. Nel fine settimana, un menu di piatti tradizionali cambierà durante l'anno, da 25 a 35 euro."
    ],
    "fr": [
      "OUVERTURE SEPTEMBRE 2025\r\nRomuald et Dorothée vous accueille en semaine avec un menu ouvrier à 17 €. Le week-end une carte de plats traditionnels changera au fil de l’année, entre 25 et 35 €."
    ],
    "nl": [
      "OPENING SEPTEMBER 2025\r\nRomuald en Dorothée verwelkomen u tijdens de week met een arbeidersmenu aan 17 €. In het weekend verandert de kaart met traditionele gerechten het hele jaar door, van 25 tot 35 ?"
    ],
    "es": [
      "APERTURA SEPTIEMBRE 2025\r\nRomuald y Dorothée le dan la bienvenida durante la semana con un menú obrero a 17€. Los fines de semana, un menú de platos tradicionales cambiará a lo largo del año, de 25 a 35€."
    ]
  },
