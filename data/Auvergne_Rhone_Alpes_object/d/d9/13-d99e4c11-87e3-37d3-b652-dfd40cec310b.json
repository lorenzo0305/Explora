  "rdfs:comment": {
    "de": [
      "Das Kino Le Rex in Villard-de-Lans empfängt Sie in seinen zwei komfortablen Sälen (287 und 85 Plätze) mit einer vielfältigen Filmauswahl von Les Cinémas Associés.\r\nGenießen Sie Kino auf großer Leinwand in gemütlicher Atmosphäre!"
    ],
    "en": [
      "The Cinéma Le Rex in Villard-de-Lans welcomes you to its two comfortable theaters (287 and 85 seats) with a diverse selection of films by Les Cinémas Associés.\r\nEnjoy the big screen experience in a friendly atmosphere!"
    ],
    "it": [
      "Il Cinéma Le Rex di Villard-de-Lans vi accoglie nelle sue 2 confortevoli sale (287 e 85 posti) per un programma vario selezionato da Les Cinémas Associés.\r\nVivete il cinema sul grande schermo in un'atmosfera amichevole!"
    ],
    "fr": [
      "Le Cinéma Le Rex à Villard-de-Lans vous accueille dans ses 2 salles confortables (287 et 85 places) pour une programmation variée sélectionnée par Les Cinémas Associés.\r\nVivez le cinéma sur grand écran dans une ambiance conviviale !"
    ],
    "es": [
      "El Cinéma Le Rex de Villard-de-Lans le da la bienvenida en sus 2 cómodas salas (287 y 85 plazas) para disfrutar de una variada programación seleccionada por Les Cinémas Associés.\r\nDisfrute del cine en pantalla grande en un ambiente agradable"
    ],
    "nl": [
      "Cinéma Le Rex in Villard-de-Lans verwelkomt je in zijn 2 comfortabele zalen (287 en 85 plaatsen) voor een gevarieerd programma geselecteerd door Les Cinémas Associés.\r\nBeleef cinema op het grote scherm in een gezellige sfeer!"
    ]
  },
  "rdfs:label": {
    "de": [
