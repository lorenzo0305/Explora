      "dc:description": {
        "de": [
          "Komplett renoviertes Restaurant im Herzen des Stadtzentrums in einer Fußgängerzone. Eine Dekoration, eine Küche, eine frische und vitaminreiche Atmosphäre."
        ],
        "en": [
          "Completely renovated restaurant located in the heart of the city centre in a pedestrian street. A decoration, a kitchen, a fresh and lively atmosphere."
        ],
        "it": [
          "Ristorante completamente rinnovato situato nel cuore del centro città in una via pedonale. Un arredamento, una cucina, un'atmosfera fresca e vitaminizzata."
        ],
        "fr": [
          "Restaurant entièrement rénové situé au coeur du centre ville dans une rue piétonne. Une déco, une cuisine, une ambiance fraîche et vitaminée."
        ],
        "nl": [
          "Volledig gerenoveerd restaurant gelegen in het hart van het stadscentrum in een voetgangersstraat. Een decor, een keuken, een frisse en gevitamineerde sfeer."
        ],
        "es": [
          "Restaurante completamente renovado situado en el corazón del centro de la ciudad en una calle peatonal. Una decoración, una cocina, un ambiente fresco y vitaminado."
        ]
      },
