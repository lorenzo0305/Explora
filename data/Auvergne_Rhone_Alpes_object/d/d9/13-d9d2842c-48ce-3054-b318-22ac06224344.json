  "rdfs:comment": {
    "de": [
      "Ein digitales Museum mit mehreren tausend Meisterwerken aus nationalen und internationalen Museen. Navigieren Sie mithilfe von Tablets durch die Werke des Museums und entdecken Sie eine Auswahl zum Thema Madame de Sévigné und das 17."
    ],
    "en": [
      "A digital museum featuring thousands of masterpieces from national and international museums. Use your tablets to browse through the museum's works, and discover a selection on the theme of Madame de Sévigné and the 17th century."
    ],
    "it": [
      "Un museo digitale che riunisce diverse migliaia di capolavori provenienti da musei nazionali e internazionali. Utilizzate i vostri tablet per navigare tra le opere del museo e scoprire una selezione sul tema Madame de Sévigné e il XVII secolo."
    ],
    "fr": [
      "Musée numérique qui réunit plusieurs milliers de chefs-d’œuvre provenant de musées nationaux et internationaux. Naviguez à l'aide de tablettes, parmi les œuvres du musée et découvrez une sélection ayant pour thème Madame de Sévigné et le XVIIe siècle."
    ],
    "es": [
      "Un museo digital que reúne varios miles de obras maestras procedentes de museos nacionales e internacionales. Utilice sus tabletas para navegar por las obras del museo y descubrir una selección sobre el tema de Madame de Sévigné y el siglo XVII."
    ],
    "nl": [
      "Een digitaal museum dat enkele duizenden meesterwerken uit nationale en internationale musea samenbrengt. Gebruik je tablets om door de werken in het museum te bladeren en ontdek een selectie met als thema Madame de Sévigné en de 17e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée numérique de la Microfolie Dieulefit-Montélimar"
    ]
  },
