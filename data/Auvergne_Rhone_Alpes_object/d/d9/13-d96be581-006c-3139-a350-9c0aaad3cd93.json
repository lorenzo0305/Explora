  "rdfs:comment": {
    "de": [
      "Besse en Oisans ist ein Dorf mit authentischem Charakter par excellence. Alle Häuser dieses charmanten Dorfes sind mit Steinen aus dem Oisans und Holz verkleidet. Seine so besondere und erhaltene Architektur macht es zu einem einzigartigen Ort in Oisans."
    ],
    "en": [
      "Besse en Oisans, the perfect example of an authentic mountain village. All the houses of this charming village are made in wood and stone. A unique place in Oisans thanks to its typical and preserved architecture."
    ],
    "it": [
      "Besse en Oisans è un villaggio dal carattere autentico per eccellenza. Tutte le case di questo incantevole villaggio sono realizzate in pietra e legno dell'Oisans. La sua architettura particolare e conservata lo rende un luogo unico nell'Oisans."
    ],
    "fr": [
      "Besse en Oisans est un village au caractère authentique par excellence. Toutes les maisons de ce charmant village sont habillées de pierres de l’Oisans et de bois. Son architecture si particulière et préservée en fait un lieu unique en Oisans."
    ],
    "nl": [
      "Besse en Oisans is een authentiek dorp bij uitstek. Alle huizen in dit charmante dorp zijn bekleed met steen en hout uit de Oisans. De kenmerkende, goed bewaarde architectuur maakt het tot een unieke plek in de Oisans."
    ],
    "es": [
      "Besse en Oisans es un pueblo con un carácter auténtico por excelencia. Todas las casas de este encantador pueblo son de piedra y madera de Oisans. Su arquitectura particular y conservada lo convierte en un lugar único en Oisans."
    ]
  },
  "rdfs:label": {
