  "rdfs:comment": {
    "de": [
      "Das Mumbaï Café ist eine sehr schöne Entdeckung. Man findet dort eine Aufrichtigkeit in dem Bemühen, die Geschmäcker anderer Länder zu teilen und entdecken zu lassen."
    ],
    "en": [
      "The Mumbai Café is a beautiful discovery, that makes discover and share the flavors of elsewhere."
    ],
    "it": [
      "Il Mumbaï Café è una scoperta meravigliosa. C'è una sincerità nell'approccio alla condivisione e alla scoperta di sapori di altri luoghi."
    ],
    "fr": [
      "Le Mumbaï Café est une très belle découverte. On y trouve une sincérité dans la démarche de partager et faire découvrir les saveurs d'ailleurs."
    ],
    "nl": [
      "Het Mumbaï Café is een prachtige ontdekking. De aanpak om smaken van elders te delen en te ontdekken is oprecht."
    ],
    "es": [
      "El Mumbaï Café es un maravilloso descubrimiento. Hay una sinceridad en el enfoque de compartir y descubrir sabores de otros lugares."
    ]
  },
