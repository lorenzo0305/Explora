  "rdfs:comment": {
    "de": [
      "Die Gemeinde Lavoine, eingebettet am Fuße des Puy du Montoncel (1287 m) und des Puy Snidre (1232 m), ist die höchstgelegene Gemeinde der Montagne Bourbonnaise."
    ],
    "en": [
      "The commune of Lavoine, nestled at the foot of the Puy du Montoncel (1287 m) and the Puy Snidre (1232 m), is the highest commune in the Montagne Bourbonnaise."
    ],
    "it": [
      "Il comune di Lavoine, situato ai piedi del Puy du Montoncel (1287 m) e del Puy Snidre (1232 m), è il comune più alto della Montagne Bourbonnaise."
    ],
    "fr": [
      "La commune de Lavoine, nichée au pied du Puy du Montoncel (1287 m) et du Puy Snidre (1232 m), est la commune la plus élevée de la Montagne Bourbonnaise."
    ],
    "es": [
      "El municipio de Lavoine, enclavado al pie del Puy du Montoncel (1287 m) y del Puy Snidre (1232 m), es el municipio más alto de la Montaña Bourbonnaise."
