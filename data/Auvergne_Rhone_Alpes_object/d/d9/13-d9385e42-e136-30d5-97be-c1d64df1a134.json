  "rdfs:comment": {
    "de": [
      "Fairer Handel direkt von unseren Bauernhöfen und Werkstätten lokaler Handwerker!\r\nObst, Gemüse der Saison, Eier, Wurstwaren, Käse, Brot, Joghurt, Getreide, Bier, Fruchtsäfte, Marmeladen, Kräuter, ätherische Öle, Olivenöl..."
    ],
    "en": [
      "Collective point of sale created and self-managed by a group of local producers.\r\nFruits, seasonal vegetables, eggs, cold meats, cheeses, yogurts, cereals, beers, fruit juices, jams, aromatic plants, essential oils ..."
    ],
    "it": [
      "Commercio equo e solidale direttamente dalle nostre fattorie e botteghe artigiane locali!\r\nFrutta, verdura di stagione, uova, salumi, formaggi, pane, yogurt, cereali, birre, succhi di frutta, confetture, piante aromatiche, oli essenziali, olio d'oliva..."
    ],
    "fr": [
      "Commerce équitable en direct de nos fermes et ateliers d'artisans locaux !\r\nFruits, légumes de saison, œufs, charcuterie, fromages, pains,  yaourts, céréales, bières, jus de fruits, confitures, plantes aromatiques, huiles essentielles, huile d'olive.."
    ],
    "es": [
      "¡Comercio justo directamente de nuestras granjas y talleres artesanos locales!\r\nFrutas, verduras de temporada, huevos, embutidos, quesos, panes, yogures, cereales, cervezas, zumos de frutas, mermeladas, plantas aromáticas, aceites esenciales, aceite de oliva..."
    ],
    "nl": [
      "Gezamenlijk verkooppunt gecreerd en beheerd door een groep locale producenten. Fruit, seizoensgroenten, eieren, vleeswaren, kazen, yoghurts, granen, bieren, vruchtensappen, jams, aromatische planten, etherische oliën en andere streekproducten..."
    ]
  },
