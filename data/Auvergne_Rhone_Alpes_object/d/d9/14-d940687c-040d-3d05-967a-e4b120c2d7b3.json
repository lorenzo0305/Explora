      "dc:description": {
        "de": [
          "Immobilienagentur, spezialisiert auf Kauf und Verkauf\nHaus, Wohnung, Grundstück, Neubauprogramm, kostenlose Schätzung in weniger als 48 Stunden\n7 Tage die Woche geöffnet, einschließlich Sonn- und Feiertage"
        ],
        "en": [
          "Real estate agency specializing in buying and selling\nHouse, apartment, land, new program, free estimate in less than 48 hours\nOpen 7 days a week, including Sundays and public holidays"
        ],
        "it": [
          "Agenzia immobiliare specializzata nella compravendita\nCasa, appartamento, terreno, nuovo sviluppo, valutazione gratuita in meno di 48 ore\nAperta 7 giorni su 7, comprese le domeniche e i giorni festivi"
        ],
        "fr": [
          "Agence immobilière spécialiste achat-vente\nMaison, appartement, terrain, programme neuf, estimation gratuite en moins de 48 heures\nOuvert 7j/7, dimanche et jours fériés inclus"
        ],
        "nl": [
          "Makelaar gespecialiseerd in kopen en verkopen\nHuis, appartement, grond, nieuwbouw, gratis waardebepaling in minder dan 48 uur\n7 dagen per week geopend, inclusief zon- en feestdagen"
        ],
        "es": [
          "Agencia inmobiliaria especializada en compraventa\nCasa, piso, terreno, obra nueva, tasación gratuita en menos de 48 horas\nAbierto 7 días a la semana, incluidos domingos y festivos"
        ]
      },
