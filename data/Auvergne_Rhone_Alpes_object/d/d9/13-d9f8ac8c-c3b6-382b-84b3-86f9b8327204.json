  "rdfs:comment": {
    "de": [
      "Mit dem Office de Tourisme de La Plagne Vallée, das sich in Aime befindet, können Sie eine Auswahl an Animationen und Aktivitäten entdecken, die Sie während Ihres Aufenthalts unternehmen können."
    ],
    "en": [
      "With the La Plagne Vallée tourist office in Aime, discover a selection of events and activities to enjoy during your stay."
    ],
    "it": [
      "Con l'Ufficio del Turismo di La Plagne Vallée, situato ad Aime, scoprite una selezione di attività da svolgere durante il vostro soggiorno."
    ],
    "fr": [
      "Avec l'Office de Tourisme de La Plagne Vallée, situé à Aime, découvrez une sélection d'animations et d'activités à faire durant votre séjour."
    ],
    "nl": [
      "Met het Office de Tourisme van la Vallée, gelegen te Aime, ontdek een selectie animaties die U kan doen tijdens uw verblijf.\r\nBlijf zomer en winter op de hoogte van de evenementen en activiteiten."
    ],
    "es": [
      "Con la Oficina de Turismo de La Plagne Vallée, situada en Aime, descubra una selección de actividades para realizar durante su estancia."
    ]
  },
