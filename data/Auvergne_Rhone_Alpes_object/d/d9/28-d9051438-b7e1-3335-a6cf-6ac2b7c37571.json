  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/056752b7-c6f4-33d2-9cee-873947e25e09",
      "dc:description": {
        "de": [
          "Die Kirche St. Peter ist mehrere hundert Jahre alt und wurde im Laufe der Zeit und durch Brände zerstört und wieder aufgebaut."
        ],
        "en": [
          "The church of Sainte-Pierre dates back hundreds of years and has been destroyed and rebuilt through the vagaries of time and fire. It still has splendid woodwork and Gothic lettering."
        ],
        "it": [
          "La chiesa di Sainte-Pierre risale a diverse centinaia di anni fa ed è stata distrutta e ricostruita nel corso del tempo e degli incendi; conserva ancora splendide decorazioni in legno e iscrizioni in caratteri gotici."
        ],
        "fr": [
          "L'église Sainte-Pierre date de plusieurs centaines d'années et à été détruite et reconstruite au fil des aléas du temps et des incendies. elle conserve cependant de splendides boiseries et des inscriptions en lettres gothiques."
        ],
        "es": [
          "La iglesia de Sainte-Pierre data de hace varios siglos y ha sido destruida y reconstruida con el paso del tiempo y los incendios. Conserva espléndidas carpinterías e inscripciones en letra gótica."
        ],
        "nl": [
          "De kerk van Sainte-Pierre dateert van enkele honderden jaren geleden en is in de loop der tijd en door brand verwoest en herbouwd. Het heeft nog steeds prachtig houtwerk en opschriften in gotische letters."
        ]
      },
