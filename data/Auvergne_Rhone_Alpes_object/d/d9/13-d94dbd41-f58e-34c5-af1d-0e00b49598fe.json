  "rdfs:comment": {
    "de": [
      "Der Glasbläser Pierre Marion wartet auf Sie mit einer kommentierten Vorführung. Er stellt vor ihren Augen Unikate her und verrät Ihnen die Geheimnisse der Glasbläserei."
    ],
    "en": [
      "Pierre Marion is a Master Glassmaker. He will be pleased to give you a demonstration. Before your very eyes he will create unique objects and share with you the secrets of their creation."
    ],
    "it": [
      "Pierre Marion, maestro vetraio, vi accoglie nel suo laboratorio per una dimostrazione guidata. Realizza oggetti unici davanti ai vostri occhi e vi svela i suoi segreti di creazione."
    ],
    "fr": [
      "Pierre Marion, maître verrier, vous accueille dans son atelier pour une démonstration commentée. Il fabrique devant vos yeux des objets uniques et vous dévoile ses secrets de création."
    ],
    "nl": [
      "Pierre Marion, meester-glasblazer, ontvangt u in zijn atelier voor een geleide demonstratie. Hij maakt voor uw ogen unieke objecten en onthult zijn scheppingsgeheimen."
    ],
    "es": [
      "Pierre Marion, maestro vidriero, le recibe en su taller para una demostración guiada. Realiza ante sus ojos objetos únicos y le desvela sus secretos de creación."
    ]
  },
