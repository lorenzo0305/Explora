  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6df74e7-38b2-3580-9ba2-686f754c5413",
      "dc:description": {
        "de": [
          "Sébastien Bailleul, Bäcker und Konditor in Audruicq, verwöhnt den Gaumen mit seinen Kreationen auf Zichorienbasis: den Zichorienkeksen und seinem Kuchen: dem Audruicquois."
        ],
        "en": [
          "Sébastien Bailleul, a baker, pastry and chocolate maker in Audruicq, delights the taste buds with his chicory-based creations: chicory biscuits and his cake: the audruicquois."
        ],
        "it": [
          "Sébastien Bailleul, panettiere e cioccolatiere di Audruicq, delizia il palato con le sue creazioni a base di cicoria: i biscotti di cicoria e la sua torta: l'Audruicquois."
        ],
        "fr": [
          "Sébastien Bailleul, boulanger-pâtissier chocolatier à Audruicq régale les papilles avec ses créations à base de chicorée: les biscuits à la chicorée et son gâteau: l'audruicquois."
        ],
        "es": [
          "Sébastien Bailleul, panadero y chocolatero de Audruicq, deleita el paladar con sus creaciones a base de achicoria: galletas de achicoria y su pastel: el Audruicquois."
        ],
        "nl": [
          "Sébastien Bailleul, bakker en chocolatier in Audruicq, verwent de smaakpapillen met zijn creaties op basis van witlof: witlofkoekjes en zijn taart: de Audruicquois."
        ]
      },
