  "rdfs:comment": {
    "de": [
      "Das LaserGame Chamonix freut sich, Sie auf seinem Spielplatz begrüßen zu dürfen: Ausgestattet mit einer Waffe mit Infrarot-Zielvorrichtung und einem Empfängerhelm können Sie ein lebensgroßes Videospiel spielen!"
    ],
    "en": [
      "The LaserGame Chamonix is happy to welcome you to its playground: Equipped with an infrared weapon and a headset, come and play a life-size video game!"
    ],
    "it": [
      "Il LaserGame Chamonix è lieto di accogliervi nel suo parco giochi: muniti di un'arma a infrarossi e di una cuffia, venite a giocare a un videogioco a grandezza naturale!"
    ],
    "fr": [
      "Le LaserGame extérieur de Chamonix est heureux de vous accueillir sur son aire de jeu : muni d’une arme à visée infra rouge et d’un casque récepteur, venez jouer à un jeu vidéo grandeur nature !"
    ],
    "es": [
      "El LaserGame Chamonix se complace en darle la bienvenida a su patio de recreo: equipado con un arma de infrarrojos y unos auriculares, ¡venga a jugar a un videojuego a tamaño real!"
    ],
    "nl": [
      "De outdoor LaserGame in Chamonix verwelkomt je graag in zijn speelruimte: gewapend met een infrarood wapen en een headset kun je een levensgroot videospel komen spelen!"
    ]
  },
