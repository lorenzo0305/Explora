  "rdfs:comment": {
    "de": [
      "Entdecken Sie L'Atelier d'Eric, die schicke Brasserie des Hotels Koh-I Nor, die Sie in einer gemütlichen und raffinierten Umgebung empfängt. Die Atmosphäre ist warm und gemütlich, ideal, um eine spritzige und kreative Küche zu genießen."
    ],
    "en": [
      "Discover L'Atelier d'Eric, the chic brasserie of the Koh-I Nor hotel, which welcomes you in a cosy and refined setting. The atmosphere is warm and friendly, ideal for savouring cuisine that is both sparkling and creative."
    ],
    "it": [
      "Scoprite L'Atelier d'Eric, la brasserie chic dell'hotel Koh-I Nor, che vi accoglie in un ambiente accogliente e raffinato. L'atmosfera è calda e amichevole, ideale per assaporare una cucina frizzante e creativa."
    ],
    "fr": [
      "Découvrez L’Atelier d’Eric, la brasserie chic de l’hôtel du Koh-I Nor, qui vous accueille dans un cadre cosy et raffiné. L’ambiance y est chaleureuse et conviviale, idéale pour savourer une cuisine à la fois pétillante et créative."
    ],
    "nl": [
      "Ontdek L'Atelier d'Eric, de chique brasserie van het Koh-I Nor hotel, die u verwelkomt in een gezellige en verfijnde omgeving. De sfeer is warm en vriendelijk, ideaal om te genieten van een sprankelende en creatieve keuken."
    ],
    "es": [
      "Descubra L'Atelier d'Eric, la elegante brasserie del hotel Koh-I Nor, que le acoge en un ambiente acogedor y refinado. El ambiente es cálido y acogedor, ideal para saborear una cocina a la vez chispeante y creativa."
    ]
  },
