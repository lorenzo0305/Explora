  "rdfs:comment": {
    "de": [
      "Auf 2000 m² vermietet das Coworking Village Roanne 18 Büros und 12 Hightech-Meetingräume (Videokonferenzen, Wifi pro), von 17 bis 100 m² (2 bis 80 Personen). Die Miete ist flexibel. Patio mit Bäumen, Entspannungsbereiche. Zugang für Behinderte. Parkplatz."
    ],
    "en": [
      "The 2000 m² Coworking Village Roanne rents out 18 offices and 12 high-tech meeting rooms (videoconferencing, Wifi pro), from 17 to 100 m² (2 to 80 people). Flexible rental. Patio with trees, relaxation areas. Disabled access. Parking."
    ],
    "it": [
      "Il Coworking Village Roanne, con una superficie di 2000 m², affitta 18 uffici e 12 sale riunioni high-tech (videoconferenza, pro Wifi), da 17 a 100 m² (da 2 a 80 persone). Affitto flessibile. Patio alberato, aree relax. Accesso per disabili. Parcheggio."
    ],
    "fr": [
      "Sur 2000 m², le Coworking Village Roanne loue 18 bureaux et 12 salles de réunion high tech (visio-conférence, Wifi pro), de 17 à 100 m² (2 à 80 personnes). Location flexible. Patio arboré, espaces détente. Accès handicapés. Parking."
    ],
    "nl": [
      "Het 2000 m² grote Coworking Village Roanne verhuurt 18 kantoren en 12 hightech vergaderzalen (videoconferencing, pro Wifi), van 17 tot 100 m² (2 tot 80 personen). Flexibele verhuur. Patio met bomen, ontspanningsruimtes. Toegang voor gehandicapten. Parkeerplaats."
    ],
    "es": [
      "El Coworking Village Roanne, de 2000 m², alquila 18 despachos y 12 salas de reuniones de alta tecnología (videoconferencia, pro Wifi), de 17 a 100 m² (de 2 a 80 personas). Alquiler flexible. Patio arbolado, zonas de descanso. Acceso para minusválidos. Aparcamiento."
    ]
  },
