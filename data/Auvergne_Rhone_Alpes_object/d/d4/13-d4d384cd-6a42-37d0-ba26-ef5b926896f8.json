  "rdfs:comment": {
    "de": [
      "Mahogo & Co ist eine Dessertbar im Stadtzentrum, die sich auf herzhafte und süße Pancake-Fluffys spezialisiert hat und hausgemachte Waffeln und Crêpes anbietet.\r\nAll dies in einem modernen und gemütlichen Ambiente, das ideal für ein aufmunterndes Mittagessen ist."
    ],
    "en": [
      "Mahogo & Co is a downtown dessert bar specializing in sweet and savory pancake fluffys, as well as homemade waffles and crepes.\r\nAll in a warm, modern atmosphere, ideal for a comforting lunch."
    ],
    "it": [
      "Mahogo & Co è un dessert bar del centro città specializzato in soffici pancake dolci e salati, waffle e crêpe fatti in casa.\r\nIl tutto in un'atmosfera calda e moderna, ideale per un pranzo rassicurante."
    ],
    "fr": [
      "Mahogo & Co est un bar à dessert situé dans le centre ville spécialisé dans les fluffys pancakes  salés et sucrés et propose des gaufres et des crêpes faites maison.\r\nTout cela dans une ambiance moderne et chaleureuse, idéale pour un déjeuner réconfortant."
    ],
    "nl": [
      "Mahogo & Co is een dessertbar in het centrum van de stad, gespecialiseerd in zoete en hartige pannenkoeken en huisgemaakte wafels en crêpes.\r\nAlles in een warme, moderne sfeer, ideaal voor een gezellige lunch."
    ],
    "es": [
      "Mahogo & Co es un bar de postres del centro de la ciudad especializado en esponjosas tortitas dulces y saladas y gofres y crêpes caseros.\r\nTodo en un ambiente cálido y moderno, ideal para un reconfortante almuerzo."
    ]
  },
