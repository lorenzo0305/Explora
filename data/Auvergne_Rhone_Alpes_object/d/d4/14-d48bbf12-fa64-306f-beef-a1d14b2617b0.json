  "rdfs:comment": {
    "de": [
      "An der Grenze der Konzession angesiedelt, steht er in unmittelbarer Nähe des metallischen Fördergerüstes der Grube Nr. 3 der Société des Mines de Lens."
    ],
    "en": [
      "Located at the edge of the concession, it stands in the immediate vicinity of the metal headframe of pit no. 3 belonging to Société des Mines de Lens."
    ],
    "it": [
      "Situato al confine della concessione, si trova nelle immediate vicinanze della testata metallica del pozzo n. 3 della Société des Mines de Lens."
    ],
    "fr": [
      "Implanté en limite de concession, il se tient à proximité immédiate du chevalement métallique de la fosse n° 3 de la Société des Mines de Lens."
    ],
    "es": [
      "Situada en el límite de la concesión, se encuentra en las inmediaciones de la cabecera metálica del pozo nº 3 perteneciente a la Société des Mines de Lens."
    ],
    "nl": [
      "Het ligt op de grens van de concessie en bevindt zich in de onmiddellijke nabijheid van het metalen geraamte van mijn nr. 3 van de Société des Mines de Lens."
    ]
  },
