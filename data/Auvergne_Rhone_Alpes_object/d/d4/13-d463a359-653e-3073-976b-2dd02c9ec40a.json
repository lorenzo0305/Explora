  "rdfs:comment": {
    "de": [
      "Bar-Restaurant im Herzen des Dorfes Lanslevillard, in der Nähe des Kinos und der Kirche. Hausgemachte und savoyische Spezialitäten, Salate, Pizzas, Eisbecher und hausgemachte Desserts. Terrasse, WLAN, behindertengerechter Zugang und Toiletten."
    ],
    "en": [
      "Bar-restaurant in the heart of the village of Lanslevillard, close to the cinema and church. Home-made and Savoyard specialities, salads, pizzas, ice cream sundaes and home-made desserts. Terrace, wifi, disabled access and toilets."
    ],
    "it": [
      "Bar-ristorante nel cuore del villaggio di Lanslevillard, vicino al cinema e alla chiesa. Specialità casalinghe e savoiarde, insalate, pizze, coppe di gelato e dolci fatti in casa. Terrazza, wifi, accesso per disabili e servizi igienici."
    ],
    "fr": [
      "Bar-Restaurant au cœur du village de Lanslevillard, proche du cinéma et de l'église. Spécialités maison et savoyardes, salades, pizzas, coupes glacées et desserts maison. Terrasse, wifi, accès et toilettes adaptés aux personnes à mobilité réduite."
    ],
    "es": [
      "Bar-restaurante en el corazón del pueblo de Lanslevillard, cerca del cine y de la iglesia. Especialidades caseras y saboyanas, ensaladas, pizzas, helados y postres caseros. Terraza, wifi, acceso para minusválidos y aseos."
    ],
    "nl": [
      "Bar-restaurant in het hart van het dorp Lanslevillard, vlakbij de bioscoop en de kerk. Huisgemaakte en Savoyaardse specialiteiten, salades, pizza's, ijscoupes en huisgemaakte desserts. Terras, wifi, toegang voor gehandicapten en toiletten."
    ]
  },
