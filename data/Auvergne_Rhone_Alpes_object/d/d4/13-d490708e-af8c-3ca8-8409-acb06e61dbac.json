  "rdfs:comment": {
    "de": [
      "Willkommen in unserem Institut!\r\nIm Herzen unseres Bergdorfes lassen Sie sich von zwei qualifizierten Kosmetikerinnen verwöhnen. Für uns ist jede Kundin einzigartig."
    ],
    "en": [
      "Welcome to the institute! \r\nIn the heart of our mountain setting, let yourself be pampered by two qualified beauticians. For us, each client is unique."
    ],
    "it": [
      "Benvenuti all'istituto!\r\nNel cuore del nostro ambiente montano, lasciatevi coccolare da due estetiste qualificate. Per noi ogni cliente è unico."
    ],
    "fr": [
      "Bienvenue à l’institut ! \r\nAu cœur de notre écrin montagnard, laissez-vous chouchouter par deux esthéticiennes qualifiées. Pour nous, chaque cliente est unique."
    ],
    "es": [
      "¡Bienvenido al instituto!\r\nEn el corazón de nuestro entorno de montaña, déjese mimar por dos esteticistas cualificadas. Para nosotros, cada cliente es único."
    ],
    "nl": [
      "Welkom bij het instituut! \r\nLaat u in het hart van onze bergomgeving verwennen door twee gekwalificeerde schoonheidsspecialisten. Voor ons is elke klant uniek."
    ]
  },
