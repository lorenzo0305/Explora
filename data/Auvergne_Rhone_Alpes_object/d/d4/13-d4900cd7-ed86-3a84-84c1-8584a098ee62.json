  "rdfs:comment": {
    "de": [
      "Die Karosseriewerkstatt Gauthier bietet Ihnen ihre Dienste in den Bereichen Mechanik und Karosserie für Fahrzeuge aller Marken an. Wir bieten außerdem: Karcher-Waschanlage rund um die Uhr, Karcher-Roller, Service für den Fahrzeugschein."
    ],
    "en": [
      "Carrosserie Gauthier offers mechanical and bodywork services for all makes of vehicle. We also offer a 24-hour karcher car wash, karcher rollers and vehicle registration services."
    ],
    "it": [
      "La carrozzeria Gauthier vi offre i suoi servizi di meccanica e carrozzeria per tutte le marche di veicoli. Offriamo anche: lavaggio auto con karcher 24 ore su 24, rullo karcher, servizio di immatricolazione auto."
    ],
    "fr": [
      "La carrosserie Gauthier vous propose ses services en mécanique et en carrosserie pour les véhicules de toutes marques. Nous proposons également : Station de lavage karcher 24h/24, rouleau Karcher, service carte grise."
    ],
    "es": [
      "El taller de carrocería Gauthier le ofrece sus servicios de mecánica y carrocería para todas las marcas de vehículos. También ofrecemos: lavado de coches con karcher 24 horas, rodillo karcher, servicio de registro de coches."
    ],
    "nl": [
      "Carrosserie Gauthier biedt mechanische en carrosseriediensten voor alle merken voertuigen. We bieden ook een 24-uurs karcher car wash, karcher rollers en voertuigregistratiediensten."
    ]
  },
