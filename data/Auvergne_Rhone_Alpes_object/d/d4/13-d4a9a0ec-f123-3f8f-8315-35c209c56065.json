  "rdfs:comment": {
    "de": [
      "Schlendern Sie durch Niervèze, das im Herzen des großen Vulkans Cantalien liegt. Die Hufschmiedearbeit, der Gemeindeofen, die Strohdächer, die Mühle... Die Zeit scheint in diesem Weiler mit seiner außergewöhnlichen Umgebung stehen geblieben zu sein! Ein Orientierungstisch bietet einen herrlichen Ausblick"
    ],
    "en": [
      "Come and stroll through Niervèze, in the heart of the great Cantalien volcano. The horseshoeing machine, the communal oven, the thatched roofs, the mill... Time seems to have stood still in this hamlet with its exceptional setting! An orientation table offers a magnificent view."
    ],
    "it": [
      "Venite a passeggiare a Niervèze, nel cuore del grande vulcano cantaliano. La ferriera, il forno comune, i tetti di paglia, il mulino... Il tempo sembra essersi fermato in questo borgo in un contesto eccezionale! Un tavolo di orientamento offre una vista magnifica"
    ],
    "fr": [
      "Venez flâner à Niervèze, au coeur du grand volcan cantalien. Le travail à ferrer, le four banal, les toits de chaume, le moulin...Le temps semble s'être arrêté dans ce hameau au cadre exceptionnel ! Une table d'orientation offre un magnifique point de vue"
    ],
    "es": [
      "Venga a pasear por Niervèze, en el corazón del gran volcán cantaliense. La ferrería, el horno comunal, los tejados de paja, el molino... ¡El tiempo parece haberse detenido en esta aldea situada en un marco excepcional! Una mesa de orientación ofrece una magnífica vista."
    ],
    "nl": [
      "Kom en wandel door Niervèze, in het hart van de grote vulkaan van de Cantalien. De ijzerfabriek, de gemeenschappelijke oven, de rieten daken, de molen... De tijd lijkt te hebben stilgestaan in dit gehucht in een uitzonderlijke omgeving! Een oriëntatietafel biedt een prachtig uitzicht"
    ]
  },
  "rdfs:label": {
    "en": [
      "The hamlet of Niervèze"
    ],
    "fr": [
      "Le Hameau de Niervèze"
    ],
    "es": [
      "Aldea de Nierveze"
    ]
  },
