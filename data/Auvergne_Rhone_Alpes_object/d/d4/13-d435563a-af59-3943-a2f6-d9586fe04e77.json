  "rdfs:comment": {
    "de": [
      "GIMS kehrt am 2. November 2026 für ein außergewöhnliches Konzert in die LDLC Arena in Lyon-Décines zurück. Erleben Sie einen Abend im Rhythmus seiner größten Hits und eine unvergessliche Show."
    ],
    "en": [
      "GIMS is back at the LDLC Arena in Lyon-Décines on 2 November 2026 for an exceptional concert. Come and enjoy an evening filled with his greatest hits and an unforgettable show."
    ],
    "it": [
      "GIMS torna all'Arena LDLC di Lione-Décines il 2 novembre 2026 per un concerto eccezionale. Venite a godervi una serata al ritmo dei suoi più grandi successi e uno spettacolo indimenticabile."
    ],
    "fr": [
      "GIMS est de retour à LDLC Arena de Lyon-Décines, le 2 novembre 2026, pour un concert exceptionnel. Venez vivre une soirée au rythme de ses plus grands hits et un show inoubliable."
    ],
    "es": [
      "GIMS vuelve al LDLC Arena de Lyon-Décines el 2 de noviembre de 2026 para ofrecer un concierto excepcional. Venga a disfrutar de una velada al ritmo de sus grandes éxitos y de un espectáculo inolvidable."
    ],
    "nl": [
      "GIMS is terug in de LDLC Arena in Lyon-Décines op 2 november 2026 voor een uitzonderlijk concert. Kom genieten van een avond op het ritme van zijn grootste hits en een onvergetelijke show."
    ]
  },
