  "rdfs:comment": {
    "de": [
      "Die berühmten Küchenchef Arnaud Leclercq liefert eine einfache und wohlschmeckende Küche, welche von französischen Traditionen inspiriert ist, damit Sie sich wie zuhause fühlen."
    ],
    "en": [
      "The chef Arnaud Leclercq cooks up simple and tasty dishes inspired by French tradition. The sort of cooking you would normally only get at home."
    ],
    "it": [
      "il chef Arnaud Leclercq propongono una cucina semplice e saporita ispirata alle tradizioni francesi per farti sentire come a casa."
    ],
    "fr": [
      "Le chef Arnaud Leclercq livre une cuisine simple et savoureuse, inspirée des traditions françaises pour que vous vous sentiez comme à la maison."
    ],
    "es": [
      "El chef Arnaud Leclercq ofrece una cocina sencilla y sabrosa, inspirada en las tradiciones francesas para que los comensales se sientan como en casa."
    ],
    "nl": [
      "Chef Arnaud Leclercq biedt een eenvoudige en smakelijke keuken, geïnspireerd door Franse tradities, zodat u zich thuis voelt."
    ]
  },
