  "rdfs:comment": {
    "de": [
      "Eine Route, die von der Spitze des Sessellifts von Gonçon über die Piste der kleinen Wölfe abwärts führt und Ihnen eine sehr schöne Aussicht auf Méaudre und seine Umgebung bietet."
    ],
    "en": [
      "A downhill itinerary from the top of the Gonçon chairlift via the \"Little Wolves\" slope, offering magnificent views of Méaudre and the surrounding area."
    ],
    "it": [
      "Un itinerario di discesa dalla cima della seggiovia Gonçon attraverso la pista dei Piccoli Lupi, che offre una splendida vista su Méaudre e dintorni."
    ],
    "fr": [
      "Un itinéraire descendant depuis le haut du télésiège du Gonçon par la piste des petits loups qui vous fera profiter d'une très belle vue sur Méaudre et ses alentours."
    ],
    "es": [
      "Itinerario de descenso desde lo alto del telesilla de Gonçon por la pista de los Pequeños Lobos, que ofrece una hermosa vista de Méaudre y sus alrededores."
    ],
    "nl": [
      "Een afdaling vanaf de top van de Gonçon stoeltjeslift via de Little Wolves piste, met een prachtig uitzicht op Méaudre en de omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Petits Loups - Itinéraire VTT Descendant - vert"
    ]
  },
