  "rdfs:comment": {
    "de": [
      "Willkommen in Ihrem Lokal: Easy-Rider empfängt Sie ab 9 Uhr zum Frühstück oder zu einem einfachen Kaffee. Das Mittagessen beginnt um 11.30 Uhr. Genießen Sie eine breite und weitläufige Terrasse oder ein großzügiges und gemütliches Cosy Interior."
    ],
    "en": [
      "Welcome to your establishment: Easy-Rider welcomes you from 9am for breakfast or a simple coffee. Lunch starts at 11.30am, come and enjoy a wide and spacious terrace or a cosy and comfortable interior."
    ],
    "it": [
      "Benvenuti nella vostra struttura: Easy-Rider vi accoglie dalle 9 del mattino per una colazione o un semplice caffè. Il pranzo inizia alle 11.30, venite a godervi un'ampia e spaziosa terrazza o un interno accogliente e confortevole."
    ],
    "fr": [
      "Bienvenue dans votre établissement : Easy-Rider vous accueille dès 9h pour un petit-déjeuner ou un simple café. Le déjeuner commence à 11h30, venez profiter d’une terrasse large et espacée ou d’un intérieur cosy généreux et confortable."
    ],
    "nl": [
      "Welkom in uw zaak: Easy-Rider verwelkomt u vanaf 9 uur voor een ontbijt of een eenvoudige koffie. De lunch begint om 11.30 uur, kom genieten van een breed en ruim terras of een gezellig en comfortabel interieur."
    ],
    "es": [
      "Bienvenido a su establecimiento: Easy-Rider le da la bienvenida desde las 9 de la mañana para desayunar o tomar un simple café. El almuerzo comienza a las 11.30 horas, venga a disfrutar de una amplia y espaciosa terraza o de un interior acogedor y confortable."
    ]
  },
  "rdfs:label": {
    "de": [
      "Easy Rider - Bar-restaurant"
    ],
    "en": [
      "Easy Rider - Bar-restaurant"
    ],
    "fr": [
      "Easy Rider - Bar-restaurant"
    ]
  },
