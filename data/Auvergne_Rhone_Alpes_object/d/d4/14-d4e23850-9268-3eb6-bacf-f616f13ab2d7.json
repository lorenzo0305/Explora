      "dc:description": {
        "de": [
          "Das Café des Sports, seit 1911 eine legendäre Brasserie in Le Touquet, bietet Ihnen das ganze Jahr über Spezialitäten mit traditionellen und jodhaltigen Aromen."
        ],
        "en": [
          "The Café des Sports, a mythical brasserie in Le Touquet since 1911, offers you specialities with traditional and iodine flavours all year round."
        ],
        "it": [
          "Il Café des Sports, mitica brasserie di Le Touquet dal 1911, vi offre tutto l'anno specialità tradizionali e iodate."
        ],
        "fr": [
          "Les Café des Sports, brasserie mythique du Touquet depuis 1911, vous propose tout au long de l’année des spécialités aux saveurs traditionnelles et iodées."
        ],
        "nl": [
          "Het Café des Sports, een mythische brasserie in Le Touquet sinds 1911, biedt u het hele jaar door traditionele en jodiumhoudende specialiteiten."
        ],
        "es": [
          "El Café des Sports, mítica brasserie de Le Touquet desde 1911, le ofrece especialidades tradicionales y yodadas durante todo el año."
        ]
