  "rdfs:comment": {
    "de": [
      "\"Pierre Angenieux, der Mann, der das erste Zoomobjektiv industrialisierte, zwei Oscars von der Hollywood Academy erhielt und die Objektive entwarf, die im Juli 1969 die ersten Bilder vom Mond übertrugen\"."
    ],
    "en": [
      "\"Pierre Angenieux, the man who industrialized the first zoom lens, received 2 Oscars from the Hollywood Academy and designed the lenses that transmitted the first images of the moon in July 1969\"."
    ],
    "it": [
      "\"Pierre Angenieux, l'uomo che ha industrializzato il primo obiettivo zoom, ha vinto 2 Oscar dall'Accademia di Hollywood e ha progettato le lenti che hanno trasmesso le prime immagini della luna nel luglio 1969\"."
    ],
    "fr": [
      "\"Pierre Angenieux, l'homme qui a industrialisé le premier zoom, a reçu 2 Oscars de l’Académie d’Hollywood et a conçu les objectifs qui ont retransmis les premières images de la lune en juillet 1969\"."
    ],
    "es": [
      "\"Pierre Angenieux, el hombre que industrializó el primer objetivo zoom, ganó 2 Oscar de la Academia de Hollywood y diseñó los objetivos que transmitieron las primeras imágenes de la Luna en julio de 1969\"."
    ],
    "nl": [
      "\"Pierre Angenieux, de man die de eerste zoomlens industrialiseerde, 2 Oscars won van de Hollywood Academy en de lenzen ontwierp die de eerste beelden van de maan doorgaven in juli 1969\"."
    ]
  },
