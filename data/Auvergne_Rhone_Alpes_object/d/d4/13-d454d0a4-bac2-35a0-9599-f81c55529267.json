  "rdfs:comment": {
    "de": [
      "In diesen vier Bergseen in der Basse-Maurienne gibt es Bach- und Regenbogenforellen. Schöne Sitzungen und entspannende Momente in Aussicht, in einer natürlichen und wilden Umgebung."
    ],
    "en": [
      "These four mountain lakes in the Basse-Maurienne contain fario and rainbow trout. Nice sessions and relaxing moments in perspective, in a natural and wild setting."
    ],
    "it": [
      "Questi quattro laghi di montagna della Bassa Maurienne contengono trote fario e iridee. Belle sessioni e momenti di relax in prospettiva, in un ambiente naturale e selvaggio."
    ],
    "fr": [
      "Ces quatre lacs de montagne de Basse-Maurienne contiennent de la truite fario et arc-en-ciel. De jolies sessions et moments de détente en perspective, dans un cadre naturel et sauvage."
    ],
    "es": [
      "Estos cuatro lagos de montaña de la Basse-Maurienne contienen truchas fario y arco iris. Bonitas sesiones y momentos de relajación en perspectiva, en un entorno natural y salvaje."
    ],
    "nl": [
      "Deze vier bergmeren in de Basse-Maurienne bevatten fario en regenboogforel. Mooie sessies en momenten van ontspanning in perspectief, in een natuurlijke en wilde omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les lacs du Bacheux, des Balmettes, Sambuis et de la Croix"
    ]
  },
