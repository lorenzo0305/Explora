  "rdfs:comment": {
    "de": [
      "Das Acerola in Issoire ist die Adresse für alle, die eine Marktküche mit frischen Saisonprodukten lieben, die einfach und effizient verarbeitet werden, und für jedes Mittagessen mit Kollegen oder Freunden."
    ],
    "en": [
      "Acerola in Issoire is the address for all those who love market cuisine with fresh seasonal produce, worked with simplicity and efficiency, for lunches with colleagues or friends."
    ],
    "it": [
      "L'Acerola in Issoire è il posto giusto per chi ama la cucina di mercato con prodotti freschi di stagione, preparati in modo semplice ed efficiente, per pranzi con colleghi o amici."
    ],
    "fr": [
      "Acerola à Issoire est l’adresse de tous ceux qui raffolent d’une cuisine de marché avec des produits de saison frais, travaillés avec simplicité et efficacité, de tous les déjeuners entre collègues ou entre amis."
    ],
    "es": [
      "Acerola, en Issoire, es el lugar ideal para los amantes de la cocina de mercado con productos frescos de temporada, preparados de forma sencilla y eficaz, para almuerzos con colegas o amigos."
    ],
    "nl": [
      "Acerola in Issoire is de plek voor iedereen die houdt van de marktkeuken met verse seizoensproducten, eenvoudig en efficiënt bereid, voor lunches met collega's of vrienden."
    ]
  },
