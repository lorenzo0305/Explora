  "rdfs:comment": {
    "de": [
      "Dicke rote Samtsessel, die zu den Wänden dieses Multiplexkinos passen, in dem sowohl Autorenfilme als auch Filme für das breite Publikum gezeigt werden."
    ],
    "en": [
      "Thick red velvet armchairs match the walls of this multiplex showing both auteur and mainstream films."
    ],
    "it": [
      "Spesse poltrone di velluto rosso in tinta con le pareti di questa multisala che proietta film d'autore e per il grande pubblico."
    ],
    "fr": [
      "Épais fauteuils de velours rouge assortis aux murs de ce multiplexe diffusant films d'auteur et grand public."
    ],
    "es": [
      "Gruesas butacas de terciopelo rojo a juego con las paredes de este multicine que proyecta películas de autor y para el gran público."
    ],
    "nl": [
      "Dikke rood fluwelen fauteuils die passen bij de muren van deze multiplex waar films van auteurs en voor het grote publiek worden vertoond."
    ]
  },
