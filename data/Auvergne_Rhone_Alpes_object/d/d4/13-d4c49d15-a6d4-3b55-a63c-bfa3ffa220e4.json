  "rdfs:comment": {
    "de": [
      "Die Haute Route ist das weltweit prestigeträchtigste 3- oder 7-tägige Etappenrennen für Amateurradfahrer.\r\nBei seiner 15. Ausgabe wird Megève Etappenstadt sein."
    ],
    "en": [
      "For the 15th edition, the Haute Route Alpes is raising the bar for this three or seven-day stage race with new destinations that will guarantee a great route with iconic climbs."
    ],
    "it": [
      "Per l'15esima edizione, la Haute Route Alpes alza la posta in gioco per questa gara a tappe di tre o sette giorni con nuove destinazioni che garantiranno un itinerario d'elezione con salite leggendarie."
    ],
    "fr": [
      "La Haute Route est l'événement à étapes de 3 ou 7 jours le plus prestigieux au monde pour les cyclistes amateurs.\r\nLors de sa 15ème édition, Megève sera ville étape."
    ],
    "es": [
      "La Haute Route es la prueba por etapas de 3 o 7 días para ciclistas aficionados más prestigiosa del mundo.\r\nEn su 15ª edición, Megève será una ciudad etapa."
    ],
    "nl": [
      "De Haute Route is 's werelds meest prestigieuze 3- of 7-daagse etappewedstrijd voor amateurwielrenners.\r\nVoor de 15e editie is Megève een etappestad."
    ]
  },
