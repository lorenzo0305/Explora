  "rdfs:comment": {
    "de": [
      "Stéphane bietet Ihnen Ausflüge in einer Kutsche an, die von seinem Zugpferd Drakkar geführt wird, im Herzen der Natur, im Rhythmus der Hufe in einer grünen Umgebung."
    ],
    "en": [
      "Stéphane offers horse-drawn carriage rides with his Drakkar draught horse, in the heart of nature, to the rhythm of hooves in a verdant setting."
    ],
    "it": [
      "Stéphane propone passeggiate in carrozza guidate dal suo cavallo da tiro Drakkar, nel cuore della natura al ritmo degli zoccoli in un ambiente verdeggiante."
    ],
    "fr": [
      "Stéphane vous propose des balades en calèche menée par son cheval de trait Drakkar, au cœur de la nature au rythme des sabots dans un cadre verdoyant."
    ],
    "es": [
      "Stéphane ofrece paseos en carruaje conducido por su caballo de tiro Drakkar, en plena naturaleza al ritmo de los cascos en un entorno verde y exuberante."
    ],
    "nl": [
      "Stéphane biedt koetsritten aan onder leiding van zijn Drakkar trekpaard, midden in de natuur op het ritme van hoeven in een weelderige groene omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
