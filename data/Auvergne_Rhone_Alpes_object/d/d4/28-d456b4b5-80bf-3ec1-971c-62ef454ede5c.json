  "rdfs:comment": {
    "de": [
      "Der Kalksaum von Béthisy-Saint-Martin, auch La Sablonnière genannt, ist ein Larris von geringer Fläche (0,41 ha), das ein außergewöhnliches Kulturerbe beherbergt. Seine erhöhte Lage bietet einen Panoramablick auf das Automne-Tal."
    ],
    "en": [
      "The Béthisy-Saint-Martin limestone rim, also known as the Sablonnière, is a small (0.41 ha) larris that is home to an exceptional heritage. Its location in height offers a panorama of the Valley of Autumn."
    ],
    "it": [
      "La brughiera calcarea di Béthisy-Saint-Martin, nota anche come Sablonnière, è una piccola area (0,41 ettari) che custodisce un patrimonio eccezionale. La sua posizione elevata offre una vista panoramica sulla Valle dell'Automne."
    ],
    "fr": [
      "L'Ourlet calcaire de Béthisy-Saint-Martin, aussi appelé la Sablonnière, est un larris de surface restreinte (0,41 ha) qui abrite un patrimoine exceptionnel. Sa situation en hauteur offre un panorama sur la Vallée de l'Automne."
    ],
    "es": [
      "El brezal calcáreo de Béthisy-Saint-Martin, también conocido como la Sablonnière, es una pequeña zona (0,41 ha) que alberga un patrimonio excepcional. Su ubicación elevada ofrece una vista panorámica del valle de Automne."
    ],
    "nl": [
      "De kalksteenheide van Béthisy-Saint-Martin, ook bekend als de Sablonnière, is een klein gebied (0,41 ha) dat een uitzonderlijk erfgoed herbergt. De verhoogde ligging biedt een panoramisch uitzicht op de Automne-vallei."
    ]
  },
  "rdfs:label": {
