  "rdfs:comment": {
    "de": [
      "Lederwerkstatt, Schuhherstellung, Taschen und Gürtel."
    ],
    "en": [
      "Leather studio, shoe, bag and belt making."
    ],
    "it": [
      "La Manouvrière si trova nell'affascinante cittadina di Joyeuse. Specializzata nella produzione e nella vendita all'ingrosso di articoli in pelle di alta qualità, l'azienda è orgogliosa di offrire prodotti autentici e durevoli."
    ],
    "fr": [
      "La Manouvrière est située dans la charmante ville de Joyeuse. Spécialisée dans la fabrication et la vente en gros d'articles en cuir de haute qualité, cette entreprise est fière de proposer des produits authentiques et durables."
    ],
    "es": [
      "La Manouvrière está situada en la encantadora ciudad de Joyeuse. Especializada en la fabricación y venta al por mayor de artículos de cuero de alta calidad, la empresa se enorgullece de ofrecer productos auténticos y duraderos."
    ],
    "nl": [
      "Atelier van leder, vervaardiging van schoenen, tassen en riemen."
    ]
  },
