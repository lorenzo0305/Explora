  "rdfs:comment": {
    "de": [
      "Chez Totor ist eine unumgängliche Adresse, wo Großzügigkeit mit dem Herzen gekocht wird! Dieses im Herzen von Publier gelegene Restaurant bietet von 12 bis 18 Uhr kleine traditionelle Gerichte an, eine gesellige Atmosphäre ist garantiert. Freitag- und Samstagabend Diskothek."
    ],
    "en": [
      "Chez Totor, an unmissable address where generosity comes from the heart! Nestled in the heart of Publier, this restaurant serves traditional snacks from 12pm to 6pm, ensuring a convivial atmosphere. Discotheque on Friday and Saturday evenings."
    ],
    "it": [
      "Chez Totor, un indirizzo imperdibile dove la generosità viene dal cuore! Situato nel cuore di Publier, questo ristorante serve spuntini tradizionali dalle 12.00 alle 18.00, garantendo un'atmosfera conviviale. Discoteca il venerdì e il sabato sera."
    ],
    "fr": [
      "Chez Totor, une adresse incontournable où la générosité se cuisine avec le cœur ! Niché au cœur de Publier, ce restaurant propose une petite restauration traditionnelle de 12h à 18h, ambiance conviviale assurée. Discothèque les vendredi et samedi soirs."
    ],
    "es": [
      "Chez Totor, una dirección ineludible donde la generosidad sale del corazón Situado en el corazón de Publier, este restaurante sirve aperitivos tradicionales de 12:00 a 18:00, en un ambiente agradable. Discoteca los viernes y sábados por la noche."
    ],
    "nl": [
      "Chez Totor, een niet te missen adres waar gulheid uit het hart komt! Dit restaurant in het hart van Publier serveert traditionele hapjes van 12 tot 18 uur en zorgt voor een gezellige sfeer. Discotheek op vrijdag- en zaterdagavond."
    ]
  },
