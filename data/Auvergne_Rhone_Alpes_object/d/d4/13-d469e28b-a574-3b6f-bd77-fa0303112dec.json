  "rdfs:comment": {
    "de": [
      "Villard-de-Lans, ein Ganzjahresziel im Herzen des Vercors. Skifahren, Wandern, Familienaktivitäten und unberührte Natur für unvergessliche Ferien das ganze Jahr über."
    ],
    "en": [
      "Villard-de-Lans, a year-round destination in the heart of the Vercors. Skiing, hiking, family activities, and preserved nature for unforgettable holidays throughout the year."
    ],
    "it": [
      "Villard-de-Lans, una destinazione per 4 stagioni nel cuore del Vercors. Sci, escursioni, attività per famiglie e natura incontaminata per vacanze indimenticabili tutto l'anno."
    ],
    "fr": [
      "Villard-de-Lans, destination 4 saisons au cœur du Vercors. Ski, randonnées, activités familiales et nature préservée pour des vacances inoubliables toute l'année."
    ],
    "es": [
      "Villard-de-Lans, un destino de 4 estaciones en el corazón del Vercors. Esquí, senderismo, actividades familiares y naturaleza virgen para unas vacaciones inolvidables todo el año."
    ],
    "nl": [
      "Villard-de-Lans, een 4-seizoenenbestemming in het hart van de Vercors. Skiën, wandelen, gezinsactiviteiten en ongerepte natuur voor een onvergetelijke vakantie het hele jaar door."
    ]
  },
