  "rdfs:comment": {
    "de": [
      "Das Restaurant des Platanes empfängt Sie das ganze Jahr über von Montag bis Freitag mittags in Satolas und Bonce. Genießen Sie hier die Spezialitäten des Küchenchefs.\r\nAuch Bar/Tabak."
    ],
    "en": [
      "The Restaurant des Platanes welcomes you all year round from Monday to Friday lunchtime in Satolas and Bonce. Come and taste the chef's specialities.\r\nAlso Bar/Tobacco."
    ],
    "it": [
      "Il Ristorante des Platanes vi accoglie tutto l'anno dal lunedì al venerdì a pranzo a Satolas e Bonce. Venite a gustare le specialità dello chef.\r\nAnche Bar/Tabac."
    ],
    "fr": [
      "Le Restaurant des Platanes vous accueille toute l'année du lundi au vendredi midi à Satolas et Bonce. Venez y déguster les spécialités du chef.\r\nEgalement Bar/Tabac."
    ],
    "nl": [
      "Het Restaurant des Platanes ontvangt u het hele jaar door van maandag tot vrijdag tijdens de lunch in Satolas en Bonce. Kom en proef de specialiteiten van de chef.\r\nOok Bar/Tabac."
    ],
    "es": [
      "El Restaurante des Platanes le acoge todo el año de lunes a viernes a la hora de comer en Satolas y Bonce. Venga a probar las especialidades del chef.\r\nTambién Bar/Tabac."
    ]
  },
