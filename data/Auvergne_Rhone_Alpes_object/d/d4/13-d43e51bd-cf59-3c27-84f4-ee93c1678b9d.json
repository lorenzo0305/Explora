  "rdfs:comment": {
    "de": [
      "La Ronde des Pioupioux organisiert das Fest des MAM (Maison d'Assistant Maternel)! Kommen Sie zahlreich, um an diesem schönen Tag voller Animationen teilzunehmen: Zoes Bauernhof, ein Zauberer? in Anwesenheit von Micky und Minnie!"
    ],
    "en": [
      "La Ronde des Pioupioux organizes the Fête de la MAM (Maison d'Assistant Maternel)! Come one, come all to take part in this great day, full of entertainment: Zoé's Farm, a magician? and Mickey and Minnie!"
    ],
    "it": [
      "La Ronde des Pioupioux organizza la Festa della MAM (Maison d'Assistant Maternel)! Venite tutti a partecipare a questa grande giornata ricca di intrattenimenti: la Fattoria di Zoé, un mago? e Topolino e Minnie!"
    ],
    "fr": [
      "La Ronde des Pioupioux organise la Fête de la MAM (Maison d'Assistant Maternel) ! Venez nombreux pour participer à cette belle journée, pleine d'animations : la Ferme de Zoé, un magicien… en présence de Mickey et Minnie !"
    ],
    "es": [
      "¡La Ronde des Pioupioux organiza la Fête de la MAM (Maison d'Assistant Maternel)! Venid todos a participar en esta gran jornada llena de animaciones: la Granja de Zoé, un mago... ¡y Mickey y Minnie!"
    ],
    "nl": [
      "La Ronde des Pioupioux organiseert het Fête de la MAM (Maison d'Assistant Maternel)! Komt allen om deel te nemen aan deze geweldige dag vol entertainment: Zoé's Farm, een goochelaar? en Mickey en Minnie!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête de la MAM"
    ]
  },
