  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Gourmetrestaurant, das von Chefkoch Olivier Cloteau und Sternekoch Xavier Taffart geleitet wird. Die unerwartete Verbindung der Aromen des Cantal mit jodhaltigen Gerichten. Das Zusammenspiel von Land und Meer ist das Herzstück des Know-hows dieses Teams.\r\n(Bib Gourmand 2023)"
    ],
    "en": [
      "Discover this gourmet restaurant run by chef Olivier Cloteau and Michelin-starred chef Xavier Taffart. The unexpected alliance of Cantal flavors and iodized dishes. The combination of land and sea is at the heart of this team?s savoir-faire.\r\n(Bib Gourmand 2023)"
    ],
    "it": [
      "Scoprite questo ristorante gourmet gestito dallo chef Olivier Cloteau e dallo chef stellato Xavier Taffart. Una combinazione inaspettata di sapori del Cantal e di frutti di mare. La combinazione di terra e mare è al centro del savoir-faire di questo team.\r\n(Bib Gourmand 2023)"
    ],
    "fr": [
      "Découvrez ce restaurant gastronomique dirigé par le chef Olivier Cloteau et le chef étoilé Xavier Taffart. L’alliance inattendue des saveurs du Cantal et des mets iodés. L’accord terre et mer au cœur du savoir-faire de cette équipe.\r\n(Bib Gourmand 2023)"
    ],
    "nl": [
      "Ontdek dit gastronomische restaurant van chef-kok Olivier Cloteau en met een Michelin-ster bekroonde chef-kok Xavier Taffart. Een onverwachte combinatie van smaken uit de Cantal en zeevruchten. De combinatie van land en zee staat centraal in de savoir-faire van dit team.\r\n(Bib Gourmand 2023)"
    ],
    "es": [
      "Descubra este restaurante gastronómico dirigido por el chef Olivier Cloteau y el chef Xavier Taffart, galardonado con una estrella Michelin. Una inesperada combinación de sabores cantálicos y marinos. La combinación de tierra y mar está en el corazón del savoir-faire de este equipo.\r\n(Bib Gourmand 2023)"
    ]
  },
  "rdfs:label": {
