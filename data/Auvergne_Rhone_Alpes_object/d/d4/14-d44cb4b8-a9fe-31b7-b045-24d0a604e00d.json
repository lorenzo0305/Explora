  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6291c509-d9bb-38ed-9a2d-7d95dfa84810",
      "dc:description": {
        "de": [
          "Angeleitete Praxis und Gruppen-/Individualworkshops. Yoga für alle Altersgruppen und Erfahrungsstufen geeignet. In Symbiose mit den äußeren Elementen, auf der Suche nach innerem Frieden."
        ],
        "en": [
          "Guided practice and group/individual workshops. Yoga for all ages and experience levels. In symbiosis with the external elements, in search of inner peace."
        ],
        "it": [
          "Pratica guidata e laboratori di gruppo/individuali. Yoga per tutte le età e per tutti i livelli di esperienza. In armonia con gli elementi esterni, alla ricerca della pace interiore."
        ],
        "fr": [
          "Pratique guidée et ateliers de groupe/individuel. Yoga adapté à tout âge et niveau d'expérience. En symbiose avec les éléments extérieurs, en recherche de la paix intérieure."
        ],
        "es": [
          "Práctica guiada y talleres en grupo e individuales. Yoga para todas las edades y niveles de experiencia. En armonía con los elementos externos, en busca de la paz interior."
        ],
        "nl": [
          "Begeleide oefeningen en workshops voor groepen/individuen. Yoga voor alle leeftijden en ervaringsniveaus. In harmonie met de externe elementen, op zoek naar innerlijke rust."
        ]
      },
