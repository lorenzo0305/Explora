  "rdfs:comment": {
    "de": [
      "Das Le Peyrinois ist ein traditionelles französisches Restaurant mit einem Tagesmenü am Mittag und einer anspruchsvolleren Küche am Abend, die aus frischen und hausgemachten Produkten hergestellt wird."
    ],
    "en": [
      "Le Peyrinois is a traditional French restaurant with a daily menu at lunchtime and more elaborate cuisine in the evening, based on fresh, homemade products."
    ],
    "it": [
      "Le Peyrinois è un ristorante tradizionale francese con un menu per tutto il giorno a pranzo e una cucina più elaborata la sera con ingredienti freschi e fatti in casa."
    ],
    "fr": [
      "Le Peyrinois est un restaurant traditionnel français avec menu du jour les midis et une cuisine plus élaborée le soir réalisée à base de produits frais et faits maison."
    ],
    "nl": [
      "Le Peyrinois is een traditioneel Frans restaurant met 's middags een dagmenu en 's avonds een meer uitgebreide keuken met verse, zelfgemaakte ingrediënten."
    ],
    "es": [
      "Le Peyrinois es un restaurante tradicional francés con un menú para todo el día al mediodía y una cocina más elaborada por la noche con ingredientes frescos y caseros."
    ]
  },
