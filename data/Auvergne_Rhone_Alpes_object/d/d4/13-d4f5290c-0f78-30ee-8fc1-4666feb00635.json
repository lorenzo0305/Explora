  "rdfs:comment": {
    "de": [
      "Das vom Staat geförderte, vom Kulturministerium überwachte und von La Villette begleitete Projekt Micro-Folie besteht darin, ein digitales Museum in eine bereits bestehende Einrichtung zu integrieren."
    ],
    "en": [
      "Supported by the State, supervised by the Ministry of Culture and accompanied by La Villette, the Micro-Folie system consists of integrating a Digital Museum into the heart of an already existing facility."
    ],
    "it": [
      "Sostenuto dallo Stato, supervisionato dal Ministero della Cultura e accompagnato da La Villette, il progetto Micro-Folie consiste nell'integrazione di un Museo Digitale nel cuore di una struttura esistente."
    ],
    "fr": [
      "Soutenu par l’État, supervisé par le Ministère la Culture et accompagné par La Villette, le dispositif Micro-Folie consiste à intégrer un Musée Numérique au cœur d’un équipement déjà existant."
    ],
    "nl": [
      "Met steun van de staat, onder toezicht van het ministerie van Cultuur en begeleid door La Villette, bestaat het Micro-Folie project uit de integratie van een digitaal museum in een bestaande faciliteit."
    ],
    "es": [
      "Apoyado por el Estado, supervisado por el Ministerio de Cultura y acompañado por La Villette, el proyecto Micro-Folie consiste en integrar un Museo Digital en el corazón de un equipamiento existente."
    ]
  },
