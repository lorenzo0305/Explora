  "rdfs:comment": {
    "de": [
      "Das Seminar- und Kongresszentrum Les Foréziales bietet 1 Std. von Lyon und 30 Min. von Roanne und Saint Etienne entfernt Räumlichkeiten und Dienstleistungen für geschäftliche oder private SémZusammenkünfte."
    ],
    "en": [
      "Les Foréziales convention centre provides rooms and services to bring companies and the general public together. It is 1 hour from Lyon or 30 minutes from Roanne and Saint Etienne."
    ],
    "it": [
      "Il centro per seminari e conferenze Les Foréziales offre spazi e servizi per aziende e privati a un'ora da Lione (Roanne e St-Étienne a 30 minuti). Al centro della Loira, nel cuore dell'Auvergne Rhône-Alpes, la sua posizione centrale è un luogo ideale per organizzare le vostre riunioni."
    ],
    "fr": [
      "Le centre de séminaires congrès Les Foréziales offre espaces & services pour les entreprises et particuliers à 1h de Lyon (Roanne, St-Étienne à 30mn). Au centre de la Loire, au cœur d'Auvergne Rhône-Alpes, sa centralité est un point fort pour vous réunir."
    ],
    "nl": [
      "Het seminar- en conferentiecentrum Les Foréziales biedt ruimte en diensten voor bedrijven en particulieren op slechts 1 uur van Lyon (Roanne en St-Étienne op 30 minuten). In het centrum van de Loire, in het hart van Auvergne Rhône-Alpes, is de centrale ligging een geweldige plek om uw bijeenkomsten te houden."
    ],
    "es": [
      "El centro de seminarios y conferencias Les Foréziales ofrece espacios y servicios para empresas y particulares a sólo 1 hora de Lyon (Roanne y St-Étienne a 30 minutos). En el centro del Loira, en el corazón de Auvergne Rhône-Alpes, su céntrica ubicación es un lugar ideal para celebrar sus reuniones."
    ]
  },
