  "rdfs:comment": {
    "de": [
      "Im Herzen des Beaujolais laden Sie der Chefkoch Cyril Roméro und seine Brigade ein, ihre in der Region verankerte Gourmetküche zu entdecken. Das Restaurant bietet Ihnen eine große Auswahl an Gerichten à la carte oder in Form von Menüs sowie eine Auswahl an großen Weinen."
    ],
    "en": [
      "In the middle of Beaujolais, the restaurant Faisan Doré invites you to discover and to taste the cuisine, the French gastronomy. It offers you a big choice of menus or à la carte meals as well as a wide range of wines."
    ],
    "it": [
      "Nel cuore della regione del Beaujolais, lo chef Cyril Roméro e il suo team vi invitano a scoprire la loro cucina gastronomica, radicata nella regione. Il ristorante offre un'ampia scelta di piatti e menu à la carte, oltre a una selezione di vini pregiati."
    ],
    "fr": [
      "Au cœur du Beaujolais, le Chef Cyril Roméro et sa brigade vous invite à découvrir leur table gastronomique ancrée dans son territoire. Le restaurant vous propose un grand choix de plats à la carte ou en menus ainsi qu'une sélection de grands vins."
    ],
    "nl": [
      "In het hart van de Beaujolais-streek nodigen chef-kok Cyril Roméro en zijn team u uit om hun gastronomische keuken, geworteld in de regio, te ontdekken. Het restaurant biedt een ruime keuze aan à la carte gerechten en menu's, evenals een selectie heerlijke wijnen."
    ],
    "es": [
      "En el corazón de la región de Beaujolais, el Chef Cyril Roméro y su equipo le invitan a descubrir su cocina gastronómica, arraigada en la región. El restaurante ofrece una amplia selección de platos y menús a la carta, así como una selección de excelentes vinos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Faisan Doré"
    ],
    "fr": [
      "Le Faisan Doré"
    ]
  },
