  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Haus auf eigene Faust.\r\nMöglichkeit, den Besuch mit dem Maison Mantin zu koppeln.\r\nDas Museum Anne-de-Beaujeu befindet sich in dem von Anne de France und Pierre de Beaujeu um 1500 erbauten Renaissancepavillon, der den Hof des prestigeträchtigen Palastes der Herzöge von Bourbon abschloss."
    ],
    "en": [
      "Self-guided tour.\r\nCan be combined with the Maison Mantin.\r\nThe Musée Anne-de-Beaujeu is housed in the Renaissance pavilion built by Anne de France and Pierre de Beaujeu around 1500 to enclose the courtyard of the prestigious palace of the Dukes of Bourbon."
    ],
    "it": [
      "Visita autoguidata.\r\nPossibilità di visita combinata con la Maison Mantin.\r\nIl Museo Anne-de-Beaujeu è ospitato nel padiglione rinascimentale costruito da Anne de France e Pierre de Beaujeu intorno al 1500 per racchiudere il cortile del prestigioso palazzo dei duchi di Borbone."
    ],
    "fr": [
      "Visite libre. \r\nPossibilité de visite couplée avec la Maison Mantin. \r\nLe musée Anne-de-Beaujeu occupe le pavillon renaissance construit par Anne de France et Pierre de Beaujeu vers 1500 qui venait clore la cour du prestigieux palais des ducs de Bourbon."
    ],
    "es": [
      "Visita autoguiada.\r\nPosibilidad de visita combinada con la Maison Mantin.\r\nEl museo Ana de Beaujeu se encuentra en el pabellón renacentista construido por Ana de Francia y Pierre de Beaujeu hacia 1500 para cerrar el patio del prestigioso palacio de los duques de Borbón."
    ],
    "nl": [
      "Rondleiding op eigen gelegenheid.\r\nMogelijkheid tot een gecombineerd bezoek met het Maison Mantin.\r\nHet Anne-de-Beaujeu museum is gevestigd in het renaissancepaviljoen dat Anne de France en Pierre de Beaujeu rond 1500 bouwden om de binnenplaats van het prestigieuze paleis van de hertogen van Bourbon af te sluiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée Anne de Beaujeu"
    ]
  },
