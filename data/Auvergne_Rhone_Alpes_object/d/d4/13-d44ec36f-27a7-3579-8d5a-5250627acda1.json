  "rdfs:comment": {
    "de": [
      "Die Bar ist der zentrale Punkt, an dem eine gesellige Atmosphäre bei einem Glas aus der reichhaltigen Weinkarte herrscht. Den ganzen Tag über geöffnet, passt sich dieser Ort Ihren Wünschen nach Entspannung, Unterhaltung oder Austausch an."
    ],
    "en": [
      "The Bar is the focal point of the restaurant, where you can enjoy a glass of wine from our extensive wine list in a convivial atmosphere. Open all day long, it's the perfect place to relax, have fun or socialize."
    ],
    "it": [
      "Il Bar è il punto centrale dove si può gustare un bicchiere di vino dalla nostra ampia carta dei vini in un'atmosfera amichevole. Aperto tutto il giorno, è un luogo dove rilassarsi, divertirsi o chiacchierare."
    ],
    "fr": [
      "Le Bar est le point central où règne une atmosphère conviviale autour d'un verre de la riche carte des vins. Ouvert tout au long de la journée, ce lieu s'adapte à vos envies de détente, de divertissement ou d'échanges."
    ],
    "es": [
      "El Bar es el punto central donde podrá disfrutar de una copa de vino de nuestra amplia carta en un ambiente agradable. Abierto todo el día, es un lugar para relajarse, divertirse o charlar."
    ],
    "nl": [
      "De Bar is het centrale punt waar je in een gezellige sfeer kunt genieten van een glas wijn van onze uitgebreide wijnkaart. De bar is de hele dag geopend en is een plek om te ontspannen, plezier te maken of een praatje te maken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bar - Ibis Oullins"
    ]
  },
