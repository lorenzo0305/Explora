  "rdfs:comment": {
    "de": [
      "Hervé bietet Ihnen spielerische und moderne Lehrmethoden, egal ob Sie Anfänger oder erfahrener Skifahrer sind, und das für Groß und Klein!"
    ],
    "en": [
      "Hervé offers fun and modern teaching techniques, whether you are a beginner or an advanced skier, for children & adults!"
    ],
    "it": [
      "Hervé vi offre tecniche di insegnamento moderne e divertenti, sia che siate principianti o esperti, per grandi e piccini!"
    ],
    "fr": [
      "Hervé vous propose des techniques pédagogiques ludiques et modernes, que vous soyez débutant ou skieur chevronné et ce pour petit et grand!"
    ],
    "es": [
      "Hervé te ofrece técnicas de enseñanza modernas y divertidas, tanto para principiantes como para esquiadores experimentados, para jóvenes y mayores"
    ],
