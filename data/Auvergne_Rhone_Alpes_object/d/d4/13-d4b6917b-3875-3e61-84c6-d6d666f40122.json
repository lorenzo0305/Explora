  "rdfs:comment": {
    "de": [
      "Das stilvoll und designbetont renovierte Hotel Terminus du Forez wartet mit zahlreichen Serviceleistungen auf: rund um die Uhr geöffneter, gebührenfreier Parkplatz, erlesene Küche, Roomservice, Canal+ (Pay-TV), Klimaanlage, Minibar, kostenloses WLAN etc."
    ],
    "en": [
      "The renovated Terminus du Forez hotel, \"Style et Design\", offers various services: free parking, 24 hours, refined cuisine, room service, Canal +, air conditioning, minibar, free wifi..."
    ],
    "it": [
      "L'Hotel Terminus du Forez, ristrutturato, \"Style and Design\", offre numerosi servizi: parcheggio gratuito, 24/24, cucina raffinata, servizio in camera, Canal+, aria condizionata, minibar, wifi gratuito..."
    ],
    "fr": [
      "L'Hôtel Terminus du Forez, rénové, \"Style et Design\", vous propose de nombreux services : parking gratuit, 24/24, cuisine raffinée, room service, Canal +, clim, minibar, wifi gratuit..."
    ],
    "nl": [
      "Het Hotel Terminus du Forez, gerenoveerd, \"Stijl en Design\", biedt vele diensten: gratis parkeren, 24/24, verfijnde keuken, roomservice, Canal +, airconditioning, minibar, gratis wifi..."
    ],
    "es": [
      "El Hotel Terminus du Forez, renovado, \"Estilo y Diseño\", ofrece numerosos servicios: aparcamiento gratuito, 24/24, cocina refinada, servicio de habitaciones, Canal +, aire acondicionado, minibar, wifi gratuito..."
    ]
  },
