  "rdfs:comment": {
    "de": [
      "Die Bio-Farm Margerie bietet eine Reihe von reinen, handwerklich hergestellten, biologischen und GOURMAND-Fruchtsäften an!\r\nMachen Sie Ihre Säfte und Nektare aus Ihren Früchten auf der Bio-Farm Margerie!"
    ],
    "en": [
      "The Margerie organic farm offers a range of pure, handcrafted, organic, GOURMAND fruit juices!\r\nMake your own juices and nectars from your own fruit at Ferme bio Margerie!"
    ],
    "it": [
      "La fattoria biologica Margerie offre una gamma di succhi di frutta puri, fatti in casa, biologici e GOURMAND!\r\nPreparate i vostri succhi e nettari con la vostra frutta alla fattoria biologica Margerie!\r\nSi prega di notare che non vendiamo frutta."
    ],
    "fr": [
      "La ferme bio des Margerie propose une gamme de purs jus de fruits artisanaux, bio, et GOURMAND !\r\nFaites vos jus et vos nectars avec vos fruits à la Ferme bio Margerie!\r\nAttention pas de vente de fruits."
    ],
    "es": [
      "¡La granja ecológica Margerie ofrece una gama de zumos de frutas puros, caseros, ecológicos y GOURMAND!\r\n¡Prepare sus propios zumos y néctares a partir de su propia fruta en la granja ecológica Margerie!\r\nTenga en cuenta que no vendemos fruta."
    ],
    "nl": [
      "De biologische boerderij Margerie biedt een assortiment pure, zelfgemaakte, biologische, GOURMET vruchtensappen!\r\nMaak je eigen sappen en nectars van je eigen fruit bij Margerie Organic Farm!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Margerie"
    ]
  },
