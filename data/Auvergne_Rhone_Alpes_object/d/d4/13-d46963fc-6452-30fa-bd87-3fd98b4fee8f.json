  "rdfs:comment": {
    "de": [
      "Ein heller Raum und ein Team, das immer gute Ratschläge gibt!\r\nDie Bibliothek wurde 2005 von einem dynamischen Team gegründet und verfügt über eine Sammlung von ca. 3000 Büchern, von denen 1/3 von Savoie Biblio ausgeliehen werden."
    ],
    "en": [
      "A bright space and a team that's always ready to help!\r\nCreated in 2005 by a dynamic team, the library boasts a collection of around 3,000 books, 1/3 of which are loaned from Savoie Biblio."
    ],
    "it": [
      "Uno spazio luminoso e un team sempre pronto ad aiutare!\r\nCreata nel 2005 da un team dinamico, la biblioteca dispone di una collezione di circa 3.000 libri, di cui 1/3 in prestito da Savoia Biblio."
    ],
    "fr": [
      "Un espace lumineux et une équipe toujours de bons conseils !\r\nCrée en 2005 par une équipe dynamique, elle est dotée d’une collection d’environ 3000 ouvrages, dont  1/3  provient des prêts de Savoie Biblio."
    ],
    "es": [
      "Un espacio luminoso y un equipo siempre dispuesto a ayudar\r\nCreada en 2005 por un equipo dinámico, la biblioteca cuenta con una colección de unos 3.000 libros, 1/3 de los cuales son préstamos de Savoie Biblio."
    ],
    "nl": [
      "Een lichte ruimte en een team dat altijd klaarstaat om te helpen!\r\nDe bibliotheek is in 2005 opgericht door een dynamisch team en heeft een collectie van ongeveer 3000 boeken, waarvan 1/3 wordt geleend van Savoie Biblio."
    ]
  },
