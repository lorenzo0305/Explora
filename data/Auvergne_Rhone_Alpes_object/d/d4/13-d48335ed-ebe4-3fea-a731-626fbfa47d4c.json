  "rdfs:comment": {
    "de": [
      "Sind Sie bereit für ein Abenteuer, das Sie in die Welt der Spione und Geheimagenten eintauchen lässt? Begeben Sie sich auf eine spannende Mission, bei der Sie als Elite-Agenten die Stadt vor einer drohenden Katastrophe retten müssen.\r\nCa. 3 Stunden und 3,5 km"
    ],
    "en": [
      "Ready for an adventure that plunges you into the world of spies and secret agents? Embark on a thrilling mission as elite agents determined to save the city from impending disaster.\r\nApprox. 3h and 3.5km"
    ],
    "it": [
      "Siete pronti per un'avventura che vi immergerà nel mondo delle spie e degli agenti segreti? Partite per una missione emozionante nei panni di agenti d'élite decisi a salvare la città da un disastro imminente.\r\nCirca 3 ore e 3,5 km"
    ],
    "fr": [
      "Prêt pour une aventure qui vous plonge dans l'univers des espions et des agents secrets? Lancez-vous dans une mission palpitante où vous incarnez des agents d'élite déterminés à sauver la ville d'une catastrophe imminente.\r\nEnv. 3h et 3,5km"
    ],
    "es": [
      "¿Listo para una aventura que te sumerge en el mundo de los espías y los agentes secretos? Embárquese en una emocionante misión como agentes de élite decididos a salvar la ciudad de un desastre inminente.\r\nAprox. 3 horas y 3,5 km"
    ],
    "nl": [
      "Klaar voor een avontuur dat je onderdompelt in de wereld van spionnen en geheim agenten? Ga op een spannende missie als elite-agenten die vastbesloten zijn om de stad te redden van een dreigend onheil.\r\nCa. 3 uur en 3,5 km"
    ]
  },
  "rdfs:label": {
    "fr": [
      "My City Hunt - Escape Game"
    ]
  },
