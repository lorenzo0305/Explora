  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von einer bistronomischen Küche mit Gerichten zum Probieren oder Teilen verführen, die von unserem Chefkoch Sébastien Ponsot zubereitet werden. Glutenfreie und vegetarische Menüs werden ebenfalls angeboten."
    ],
    "en": [
      "Let yourself be tempted by a bistronomic cuisine with dishes to taste or share, prepared by our Chef Sébastien Ponsot. Gluten-free and vegetarian menus are also available."
    ],
    "it": [
      "Lasciatevi tentare da una cucina bistronomica con piatti da gustare o da condividere, preparati dal nostro chef Sébastien Ponsot. Sono disponibili anche menu senza glutine e vegetariani."
    ],
    "fr": [
      "Laissez-vous tenter par une cuisine bistronomique avec des plats à goûter ou à partager, élaborés par notre Chef Sébastien Ponsot. Des menus sans gluten et végétarien sont également proposés."
    ],
    "nl": [
      "Laat u verleiden door een bistronomische keuken met gerechten om te proeven of te delen, bereid door onze chef Sébastien Ponsot. Glutenvrije en vegetarische menu's zijn ook beschikbaar."
    ],
    "es": [
      "Déjese tentar por una cocina bistronómica con platos para degustar o compartir, preparados por nuestro Chef Sébastien Ponsot. También hay menús vegetarianos y sin gluten."
    ]
  },
