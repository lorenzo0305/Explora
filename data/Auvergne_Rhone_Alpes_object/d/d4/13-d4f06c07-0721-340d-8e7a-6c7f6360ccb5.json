  "rdfs:comment": {
    "de": [
      "Der Palais des Congrès et des Spectacles bietet Ihnen verschiedene Säle, um Sie bestmöglich zu empfangen und Ihre Erwartungen dank der großen Flexibilität und Anpassungsfähigkeit der Räume zu erfüllen."
    ],
    "en": [
      "The Palais des Congrès et des Spectacles is a venue with a wide range of rooms, guaranteed to give you a great welcome and to meet all your needs. The congress centre facilities are flexible and adaptable."
    ],
    "it": [
      "Il Palais des Congrès et des Spectacles vi offre diversi ambienti per accogliervi al meglio e soddisfare le vostre aspettative grazie a una grande flessibilità e adattabilità degli spazi."
    ],
    "fr": [
      "Le Palais des Congrès et des Spectacles vous propose différentes salles afin de vous accueillir au mieux et de répondre à vos attentes grâce à une grande flexibilité et une adaptabilité des espaces."
    ],
    "nl": [
      "Het Palais des Congrès et des Spectacles biedt u verschillende zalen om u optimaal te ontvangen en aan uw verwachtingen te voldoen dankzij een grote flexibiliteit en aanpasbaarheid van de ruimtes."
    ],
    "es": [
      "El Palais des Congrès et des Spectacles le ofrece diferentes salas para acogerle de la mejor manera posible y responder a sus expectativas gracias a una gran flexibilidad y adaptabilidad de los espacios."
    ]
  },
  "rdfs:label": {
