  "rdfs:comment": {
    "de": [
      "Im Rahmen von Oper im Kino zeigt das Ciné Planète eine Aufzeichnung von Eugen Onegin durch die Metropolitan Opera, die in HD gefilmt wurde. Musikalische Leitung von Timur Zangiev, mit einer Inszenierung von Deborah Warner mit Musik von Pjotr Iljitsch Tschaikowski."
    ],
    "en": [
      "As part of Opéra au Cinéma, Ciné Planète presents the Metropolitan Opera's recording of Eugene Onegin, filmed in HD. Musical direction by Timur Zangiev, with staging by Deborah Warner to music by Pyotr Ilyich Tchaikovsky."
    ],
    "it": [
      "Nell'ambito del programma Opéra au Cinéma, Ciné Planète presenta una registrazione dell'Eugene Onegin del Metropolitan Opera, girata in HD. Condotta da Timur Zangiev e diretta da Deborah Warner su musiche di Pëtr Il'ič Čajkovskij."
    ],
    "fr": [
      "Dans le cadre d'Opéra au Cinéma, le Ciné Planète propose une captation de Eugène Onéguine par le Metropolitan Opera, filmé en HD. Direction musicale par Timur Zangiev, avec une mise en scène de Deborah Warner sur une musique de Piotr Ilitch Tchaïkovski."
    ],
    "es": [
      "En el marco del programa Opéra au Cinéma, Ciné Planète proyecta una grabación de Eugene Onegin de la Metropolitan Opera, filmada en HD. Bajo la dirección de Timur Zangiev y Deborah Warner, con música de Piotr Ilich Chaikovski."
    ],
    "nl": [
      "Als onderdeel van het programma Opéra au Cinéma vertoont Ciné Planète een opname van Eugene Onegin door de Metropolitan Opera, gefilmd in HD. Gedirigeerd door Timur Zangiev en geregisseerd door Deborah Warner op muziek van Pjotr Iljitsj Tsjaikovski."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Opéra au Cinéma - Eugène Onéguine"
    ]
  },
