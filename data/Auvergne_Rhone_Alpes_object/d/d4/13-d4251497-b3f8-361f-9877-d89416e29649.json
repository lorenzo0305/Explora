  "rdfs:comment": {
    "de": [
      "Suchen Sie Nervenkitzel und Spaß in der freien Natur? AN Rafting heißt Sie zu unvergesslichen Abfahrten auf der Dranse willkommen, zwischen stürmischen Stromschnellen und alpinen Landschaften!"
    ],
    "en": [
      "Looking for thrills and fun in the great outdoors? AN Rafting welcomes you for unforgettable descents on the Dranse River, between tumultuous rapids and alpine landscapes!"
    ],
    "it": [
      "Cercate emozioni e divertimento all'aria aperta? AN Rafting vi accoglie per indimenticabili discese sulla Dranse, tra rapide tumultuose e paesaggi alpini!"
    ],
    "fr": [
      "Envie de sensations et de fun en pleine nature ? AN Rafting vous accueille pour des descentes inoubliables sur la Dranse, entre rapides tumultueux et paysages alpins !"
    ],
    "es": [
      "¿Busca emociones y diversión al aire libre? AN Rafting le da la bienvenida para descensos inolvidables en el Dranse, entre rápidos tumultuosos y paisajes alpinos"
    ],
    "nl": [
      "Op zoek naar sensatie en plezier in de vrije natuur? AN Rafting verwelkomt je voor onvergetelijke afdalingen op de Dranse, tussen tumultueuze stroomversnellingen en Alpenlandschappen!"
    ]
  },
