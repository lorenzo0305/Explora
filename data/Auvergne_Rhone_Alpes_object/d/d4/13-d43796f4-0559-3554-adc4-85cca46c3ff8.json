  "rdfs:comment": {
    "de": [
      "In den Kleingärten des Planet können Annemassianer eine Parzelle mieten und dort ihr eigenes Obst und Gemüse anbauen."
    ],
    "en": [
      "The allotment gardens at Le Planet enable Annemasse residents to rent a plot and grow their own fruit and vegetables."
    ],
    "it": [
      "Gli orti di Le Planet consentono ai residenti di Annemasse di affittare un terreno e di coltivare la propria frutta e verdura."
    ],
    "fr": [
      "Les jardins familiaux du Planet permettent aux annemassiens de louer une parcelle et d'y cultiver leurs fruits et légumes."
    ],
    "nl": [
      "Met de volkstuinen van Le Planet kunnen bewoners van Annemasse een stuk grond huren en hun eigen fruit en groenten verbouwen."
    ],
    "es": [
      "Los huertos del Planet permiten a los residentes de Annemasse alquilar una parcela y cultivar sus propias frutas y verduras."
    ]
  },
