  "rdfs:comment": {
    "de": [
      "Im Rahmen des Bibliotheksfrühlings 2026 laden die Bibliothèque départementale und die Mediathek Léo Ferré von Désertines Sie ein, \"MUSEUM\", das zoopoetische Kuriositätenkabinett des Petit Théâtre Dakôté, zu entdecken."
    ],
    "en": [
      "As part of Printemps des Bibliothèques 2026, the departmental library and the Léo Ferré media library in Désertines invite you to discover \"MUSEUM\", the Petit Théâtre Dakôté's cabinet of zoopoetic curiosities."
    ],
    "it": [
      "Nell'ambito del Printemps des Bibliothèques 2026, la biblioteca dipartimentale e la mediateca Léo Ferré di Désertines vi invitano a scoprire \"MUSEUM\", il gabinetto delle curiosità zoologiche del Petit Théâtre Dakôté."
    ],
    "fr": [
      "Dans le cadre du Printemps des Bibliothèques 2026, la bibliothèque départementale et la médiathèque Léo Ferré de Désertines vous invitent à découvrir \"MUSEUM\", le cabinet de curiosités zoopoétiques du Petit Théâtre Dakôté."
    ],
    "nl": [
      "In het kader van Printemps des Bibliothèques 2026 nodigen de departementale bibliotheek en de mediatheek Léo Ferré in Désertines u uit om \"MUSEUM\" te ontdekken, het rariteitenkabinet van de dierentuin in het Petit Théâtre Dakôté."
    ],
    "es": [
      "En el marco del Printemps des Bibliothèques 2026, la biblioteca departamental y la mediateca Léo Ferré de Désertines le invitan a descubrir \"MUSEUM\", el gabinete de curiosidades zoopoéticas del Petit Théâtre Dakôté."
    ]
  },
  "rdfs:label": {
    "fr": [
