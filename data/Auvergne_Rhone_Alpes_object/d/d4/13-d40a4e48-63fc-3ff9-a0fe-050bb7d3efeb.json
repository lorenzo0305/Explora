  "rdfs:comment": {
    "de": [
      "Christian Menut empfängt Sie in seinem Dorfrestaurant, Bar und Tabac \"La Terrasse\". Er bietet Ihnen eine traditionelle französische Gastronomie, insbesondere ein Froschmenü, das auf Bestellung erhältlich ist. Im Sommer profitieren Sie von seiner großen Terrasse."
    ],
    "en": [
      "Christian Menut welcomes you to his village restaurant-bar-tabac \"La Terrasse\". He offers traditional French gastronomy, including a frog menu available to order. In summer, take advantage of his large terrace."
    ],
    "it": [
      "Christian Menut vi dà il benvenuto nel suo ristorante-bar-tobac \"La Terrasse\". Offre una cucina tradizionale francese, tra cui un menu di rane disponibile su ordinazione. In estate, approfittate dell'ampia terrazza."
    ],
    "fr": [
      "Christian Menut vous accueille dans son restaurant-bar-tabac de village \"La Terrasse\". Il vous propose une gastronomie traditionnelle française avec notamment un menu grenouilles disponible sur commande. L'été, profitez de sa grande terrasse."
    ],
    "es": [
      "Christian Menut le da la bienvenida a su restaurante-bar-tobac de pueblo \"La Terrasse\". Ofrece cocina tradicional francesa, incluido un menú de rana disponible por encargo. En verano, aproveche la gran terraza."
    ],
    "nl": [
      "Christian Menut heet je welkom in zijn dorpsrestaurant-bar-tobac \"La Terrasse\". Hij biedt traditionele Franse gerechten, waaronder een kikkermenu dat op bestelling verkrijgbaar is. Profiteer in de zomer van het grote terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Terrasse"
    ]
  },
