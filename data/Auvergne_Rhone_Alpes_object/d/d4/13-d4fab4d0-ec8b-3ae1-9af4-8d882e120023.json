  "rdfs:comment": {
    "de": [
      "In der Drôme Provençale, in der Nähe von touristischen Dörfern, ruhig in einem charmanten Dorf gelegen, empfangen Sie die Reisenden in ihrem familiengeführten Hotel-Restaurant."
    ],
    "en": [
      "Located in Drôme Provençale in a calm and lovely village, “Les Voyageurs” welcomes you in their family owned hotel/restaurant."
    ],
    "it": [
      "Situati nella Drôme Provençale, vicino ai villaggi turistici, nella pace e nella tranquillità di un incantevole villaggio, i viaggiatori vi danno il benvenuto nel loro hotel ristorante a conduzione familiare."
    ],
    "fr": [
      "Situé en Drôme provençale, à proximité de villages touristiques, au calme dans un charmant village, les voyageurs vous accueillent dans leur hôtel restaurant familial."
    ],
    "es": [
      "Situado en la Drôme provenzal, cerca de los pueblos turísticos, en la tranquilidad de un pueblo encantador, los viajeros le dan la bienvenida a su hotel restaurante de gestión familiar."
    ],
    "nl": [
      "Gelegen in de Drôme Provençale, in de nabijheid van toeristische dorpen, in de rust van een charmant dorp, heten de reizigers u welkom in hun familiaal hotel-restaurant."
    ]
  },
