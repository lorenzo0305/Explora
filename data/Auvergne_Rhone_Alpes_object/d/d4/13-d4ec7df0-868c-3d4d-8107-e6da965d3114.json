      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/9d25846b-a6ab-39ea-b0cb-59f6e2856f2f",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "1. Oktober bis 31. Mai: 10:00 - 12:00 Uhr und 14:00 - 17:00 Uhr\r\n\r\nVom 1. Juni bis 30. September: 10:30 - 18:00 Uhr\r\n\r\nAn folgenden Feiertagen geschlossen: 1. Januar, Ostersonntag und -montag, 1. Mai, 1. November, 11. November, 25. Dezember.\r\n\r\nDie letzten Eintrittskarten werden 45 Minuten vor Schließung ausgegeben.\r\n\r\nDas Château d'Annecy und der Palais de l'Île sind von Oktober bis Mai am ersten Sonntag des Monats kostenlos zu besichtigen."
            ],
            "en": [
              "October 1 to May 31: 10:00 a.m. - 12:00 p.m. and 2:00 p.m. - 5:00 p.m\r\n\r\nJune 1 to September 30: 10:30 a.m. - 6:00 p.m\r\n\r\nClosed on public holidays: January 1, Easter Sunday and Monday, May 1, November 1, November 11, December 25.\r\n\r\nThe last tickets are issued 45 minutes before closing time.\r\n\r\nThe Château d'Annecy and Palais de l'Île are free on the first Sunday of the month from October to May."
            ],
            "it": [
              "Dal 1° ottobre al 31 maggio: dalle 10.00 alle 12.00 e dalle 14.00 alle 17.00\r\n\r\nDal 1° giugno al 30 settembre: dalle 10:30 alle 18:00\r\n\r\nChiuso nei giorni festivi: 1° gennaio, domenica e lunedì di Pasqua, 1° maggio, 1° novembre, 11 novembre, 25 dicembre.\r\n\r\nGli ultimi biglietti vengono emessi 45 minuti prima della chiusura.\r\n\r\nIl Château d'Annecy e il Palais de l'Île sono gratuiti la prima domenica del mese da ottobre a maggio."
            ],
            "fr": [
              "Du 1er octobre au 31 mai  : 10 h - 12 h et 14 h - 17 h\r\n\r\nDu 1er juin au 30 septembre  : 10 h 30 - 18 h\r\n\r\nFermeture les jours fériés : 1er janvier, dimanche et lundi de Pâques, 1er mai, 1er novembre, 11 novembre, 25 décembre.\r\n\r\nLes derniers billets sont délivrés 45 minutes avant la fermeture.\r\n\r\nLe Château d’Annecy et Palais de l’Île sont gratuits le premier dimanche du mois d’octobre à mai."
            ],
            "es": [
              "Del 1 de octubre al 31 de mayo: de 10 a 12 horas y de 14 a 17 horas\r\n\r\nDel 1 de junio al 30 de septiembre: de 10:30 a 18:00 horas\r\n\r\nCerrado los días festivos: 1 de enero, domingo y lunes de Pascua, 1 de mayo, 1 de noviembre, 11 de noviembre y 25 de diciembre.\r\n\r\nLos últimos billetes se expiden 45 minutos antes del cierre.\r\n\r\nEl Castillo de Annecy y el Palacio de la Isla son gratuitos el primer domingo del mes de octubre a mayo."
            ],
            "nl": [
              "1 oktober tot 31 mei: 10.00 - 12.00 uur en 14.00 - 17.00 uur\r\n\r\n1 juni tot 30 september: 10:30 - 18:00 uur\r\n\r\nGesloten op feestdagen: 1 januari, paaszondag en -maandag, 1 mei, 1 november, 11 november, 25 december.\r\n\r\nDe laatste tickets worden 45 minuten voor sluitingstijd uitgegeven.\r\n\r\nHet Château d'Annecy en het Palais de l'Île zijn gratis toegankelijk op de eerste zondag van de maand van oktober tot mei."
            ]
          },
