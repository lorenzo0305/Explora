  "rdfs:comment": {
    "de": [
      "Das Logis und der Tour Perrière sind vom See von Annecy aus zu sehen und dominieren die alte Alpenstraße, die heutige Côte Perrière. Der Turm Perrière besitzt noch immer seinen Maschikulikranz und seine Bogenschützen, die auf den Vorort und die Porte Perrière gerichtet sind."
    ],
    "en": [
      "Visible from Lake Annecy, the dwelling and the Perrière Tower dominate the old road to the Alps, the current Côte Perrière. The Perrière tower still retains its crown of machicolation and its archers directed towards the suburb and the Perrière gate."
    ],
    "it": [
      "Visibili dal lago di Annecy, la dimora e la Torre Perrière dominano l'antica strada alpina, l'attuale Côte Perrière. La torre Perrière conserva ancora la sua corona di caditoie e le sue arcate dirette verso il borgo e la porta Perrière."
    ],
    "fr": [
      "Visibles depuis le lac d'Annecy, le logis et la Tour Perrière dominent l'ancienne route des Alpes, l'actuelle côte Perrière. La tour Perrière conserve encore sa couronne de mâchicoulis et ses archères dirigées sur le faubourg et la porte Perrière."
    ],
    "nl": [
      "Zichtbaar vanaf het meer van Annecy, domineren de woning en de toren van Perrière de oude Alpenweg, de huidige Côte Perrière. De toren van Perrière heeft nog steeds zijn kroon van machicoulis en zijn bogen naar de voorstad en de poort van Perrière."
    ],
    "es": [
      "Visible desde el lago de Annecy, la vivienda y la Torre Perrière dominan la antigua carretera alpina, la actual Côte Perrière. La torre de la Perrière conserva su corona de matacanes y sus arcos dirigidos hacia el barrio y la puerta de la Perrière."
    ]
  },
