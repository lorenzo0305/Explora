  "rdfs:comment": {
    "de": [
      "Eiscreme, Vollfruchtsorbet, Magloul (Eis am Stiel), Crêpes oder Waffeln. Die Cabane des Lutins bietet Ihnen jeden Nachmittag hausgemachte süße Leckereien an. Salzige Neuheiten für Feinschmecker: Croques und Panini mit regionalen Produkten"
    ],
    "en": [
      "Ice creams, full-fruit sorbets, Magloul (ice cream sticks), pancakes or waffles. La Cabane des Lutins offers you home-made sweet treats every afternoon. Savoury novelties for gourmets, croques and panini with regional products"
    ],
    "it": [
      "Gelati, sorbetti alla frutta, Magloul (bastoncini di gelato), pancakes o waffles. La Cabane des Lutins vi propone ogni pomeriggio dei dolci fatti in casa. Novità salate per i buongustai, croque e panini con prodotti regionali"
    ],
    "fr": [
      "Crèmes glacées, sorbets plein fruits, Magloul (bâtonnets glacés), crêpes ou gaufres. La Cabane des Lutins vous propose des plaisirs sucrées faits maison tous les après-midi. Des nouveautés salées pour les gourmands,croques et panini aux produits régionaux"
    ],
    "nl": [
      "IJsjes, sorbets met volle vruchten, Magloul (ijsstokjes), pannenkoeken of wafels. La Cabane des Lutins biedt u elke middag zelfgemaakte zoete lekkernijen. Hartige nieuwigheden voor fijnproevers, croques en panini met streekproducten"
    ],
    "es": [
      "Helados, sorbetes completos, Magloul (palitos de helado), tortitas o gofres. La Cabane des Lutins le ofrece dulces caseros todas las tardes. Novedades saladas para gourmets, croques y panini con productos regionales"
    ]
  },
  "rdfs:label": {
