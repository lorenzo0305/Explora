  "rdfs:comment": {
    "de": [
      "Das monumentale Gebäude stammt aus dem späten 19. Jahrhundert und ist von der Neogotik inspiriert. Es beeindruckt durch seine Größe, die Vielzahl der Volumen und die Qualität der verwendeten Materialien."
    ],
    "en": [
      "Dating from the late 19th century, this neo-Gothic building is monumental in scale, with a multiplicity of volumes and the quality of the materials used."
    ],
    "it": [
      "Risalente alla fine del XIX secolo, questo edificio neogotico è monumentale e impressionante per le sue dimensioni, la molteplicità dei volumi e la qualità dei materiali utilizzati."
    ],
    "fr": [
      "Datant de la fin du XIXe siècle, d'inspiration néo-gothique, l’édifice est monumental et impressionne par sa taille, par la multiplicité des volumes et la qualité des matériaux employés."
    ],
    "nl": [
      "Dit neogotische gebouw dateert uit het einde van de 19e eeuw en is monumentaal en indrukwekkend vanwege zijn omvang, de veelheid aan volumes en de kwaliteit van de gebruikte materialen."
    ],
    "es": [
      "De finales del siglo XIX, este edificio neogótico es monumental e impresionante por su tamaño, la multiplicidad de sus volúmenes y la calidad de los materiales utilizados."
    ]
  },
