  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/595b1e69-4b90-31d8-b835-82af3f6f750b",
      "dc:description": {
        "de": [
          "\"Ort, der zum regionalen Kulturerbe gehört.\nKulturelle Einrichtung, in der zahlreiche künstlerische Aktivitäten organisiert werden: Schreibwerkstätten, Aufführungen, Ausstellungen...\nDas ganze Jahr über geöffnet, außer zwischen Weihnachten und Neujahr\""
        ],
        "en": [
          "\"Place registered in the Regional Heritage.\nCultural establishment where many artistic activities are organized: writing workshops, shows, exhibitions...\nOpen all year round except between Christmas and New Year.\""
        ],
        "it": [
          "\"Sito del patrimonio regionale.\nStabilimento culturale in cui si organizzano numerose attività artistiche: laboratori di scrittura, spettacoli, mostre, ecc.\nAperto tutto l'anno, tranne tra Natale e Capodanno\""
        ],
        "fr": [
          "\"Lieu inscrit au Patrimoine Régional.\nÉtablissement culturel où de nombreuses activités artistiques sont organisées : ateliers d'écriture, spectacles, expo...\nOuvert toute l'année sauf entre Noël et Nouvel An.\""
        ],
        "nl": [
          "\"Regionaal erfgoed.\nCultureel etablissement waar talrijke artistieke activiteiten worden georganiseerd: schrijfworkshops, voorstellingen, tentoonstellingen, enz.\nHet hele jaar geopend, behalve tussen Kerstmis en Nieuwjaar.\""
        ],
        "es": [
          "\"Patrimonio regional.\nEstablecimiento cultural donde se organizan numerosas actividades artísticas: talleres de escritura, espectáculos, exposiciones, etc.\nAbierto todo el año excepto entre Navidad y Año Nuevo\""
        ]
      },
      "@type": [
        "Description"
