  "rdfs:comment": {
    "de": [
      "Der Chefkoch bietet asiatische Spezialitäten, die mit frischen Zutaten zubereitet und am Tisch serviert werden. Das Dragon d'Or nimmt Sie mit auf eine Reise ans andere Ende der Welt und verleiht der authentischen chinesischen Küche gleichzeitig einen modernen Touch."
    ],
    "en": [
      "The chef offers Asian specialties cooked with fresh produce and served at the table. Le Dragon d'Or takes you on a journey to the other side of the world, bringing a modern touch to authentic Chinese cuisine."
    ],
    "it": [
      "Lo chef propone specialità asiatiche cucinate con prodotti freschi e servite al tavolo. Le Dragon d'Or vi porta in un viaggio dall'altra parte del mondo, aggiungendo un tocco moderno all'autentica cucina cinese."
    ],
    "fr": [
      "Le chef propose des spécialités asiatiques cuisinées avec des produits frais et servies à table. Le Dragon d'Or vous embarque pour un voyage à l'autre bout du monde tout en apportant sa touche de modernité à la cuisine authentique chinoise."
    ],
    "es": [
      "El chef ofrece especialidades asiáticas cocinadas con productos frescos y servidas en la mesa. Le Dragon d'Or le lleva de viaje al otro lado del mundo, al tiempo que añade un toque moderno a la auténtica cocina china."
    ],
    "nl": [
      "De chef biedt Aziatische specialiteiten bereid met verse producten en geserveerd aan tafel. Le Dragon d'Or neemt je mee op reis naar de andere kant van de wereld en voegt een modern tintje toe aan de authentieke Chinese keuken."
    ]
  },
  "rdfs:label": {
    "en": [
