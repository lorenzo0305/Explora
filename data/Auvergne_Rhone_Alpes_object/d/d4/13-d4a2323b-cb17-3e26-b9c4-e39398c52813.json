  "rdfs:comment": {
    "de": [
      "Die Bibliothek kooperiert mit der Bibliothek des Départements und verleiht kostenlos Bücher gegen eine Kaution. Werke aller Genres, Comics, Romane, Bücher für Erwachsene und für Kinder..."
    ],
    "en": [
      "Lending library (in partnership with the regional library), books loaned in return for deposit.  All types of books, including cartoons, novels, books for adults and children…"
    ],
    "it": [
      "Biblioteca in collaborazione con la biblioteca dipartimentale, prestito gratuito di libri contro deposito. Libri di ogni genere, fumetti, romanzi, libri per adulti e bambini... Dal 2026, la biblioteca sarà situata nell'ex ufficio postale locale."
    ],
    "fr": [
      "Bibliothèque en partenariat avec la bibliothèque départementale, prêt de livres gratuits contre caution. Des ouvrages de tous genres, BD, romans, livres pour adultes, enfants ... À partir de 2026, elle sera située dans l'ancienne agence postale communale."
    ],
    "nl": [
      "Bibliotheek in samenwerking met de afdelingsbibliotheek, gratis uitlening van boeken tegen borg. Boeken van alle genres, strips, romans, boeken voor volwassenen en kinderen... Vanaf 2026 is de bibliotheek gevestigd in het voormalige plaatselijke postkantoor."
    ],
    "es": [
      "Biblioteca en colaboración con la biblioteca departamental, préstamo gratuito de libros contra depósito. Libros de todos los géneros, cómics, novelas, libros para adultos, niños, etc. A partir de 2026, la biblioteca se ubicará en la antigua oficina de correos local."
    ]
  },
