  "rdfs:comment": {
    "de": [
      "In der Boutique des Maison de la Rivière Allier finden Sie verschiedene symbolträchtige Artikel aus unserer Region, Bücher über die Fauna und Flora des Flusses Allier sowie handwerkliche Produkte."
    ],
    "en": [
      "The Maison de la Rivière Allier store offers a range of items emblematic of our region, books on the flora and fauna of the Allier River, and handicrafts."
    ],
    "it": [
      "Il negozio della Maison de la Rivière Allier propone una serie di articoli emblematici della nostra regione, oltre a libri sulla flora e la fauna del fiume Allier e oggetti di artigianato."
    ],
    "fr": [
      "La boutique de la Maison de la Rivière Allier vous propose différents articles emblématiques de notre région, des livres sur la faune et la flore de la Rivière Allier, ainsi que des produits artisanaux."
    ],
    "es": [
      "La tienda de la Maison de la Rivière Allier vende diversos artículos emblemáticos de nuestra región, así como libros sobre la flora y la fauna del río Allier y artesanía."
    ],
    "nl": [
      "In de winkel van Maison de la Rivière Allier vind je allerlei voorwerpen die kenmerkend zijn voor onze regio, maar ook boeken over de flora en fauna van de rivier de Allier en handwerk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique de la Maison de la Rivière Allier"
    ]
  },
