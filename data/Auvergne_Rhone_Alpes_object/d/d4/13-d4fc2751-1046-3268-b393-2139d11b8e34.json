  "rdfs:comment": {
    "de": [
      "Multi-Sport-Spielplatz gegenüber dem Kinderspielplatz \"Les Petits Robins\". Umfasst einen Multi-Aktivitätsplatz mit Basketballkörben, Fußballkäfigen, ... und einer Laufstrecke."
    ],
    "en": [
      "Multi-Sports playground located opposite the children's playground at Les Petits Robins. Includes a multi-activity court with basketball baskets, soccer cages and a running track."
    ],
    "it": [
      "Area giochi multisport situata di fronte all'area giochi per bambini di Les Petits Robins. Comprende un'area multiattività con canestri da basket, gabbie da calcio, ecc. e una pista da corsa"
    ],
    "fr": [
      "Aire de jeux Multi-Sports situé en face de l'aire de jeux pour enfants aux Petits Robins. Comprend un terrain multi-activités avec paniers de basket, cages de foot,... et piste de course"
    ],
    "es": [
      "Zona de juegos polideportiva situada frente a la zona de juegos infantiles de Les Petits Robins. Incluye una zona multiactividades con canastas de baloncesto, jaulas de fútbol, etc. y una pista de atletismo"
    ],
    "nl": [
      "Multisportterrein tegenover het kinderspeelterrein van Les Petits Robins. Omvat een multi-activiteitengebied met basketbalkorven, voetbalkooien, enz. en een atletiekbaan."
    ]
  },
  "rdfs:label": {
