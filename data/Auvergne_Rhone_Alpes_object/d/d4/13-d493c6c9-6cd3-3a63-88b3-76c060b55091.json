  "rdfs:comment": {
    "de": [
      "Genießen Sie unseren schnellen Service zum Mittagessen auf einer großen Terrasse mit Seeblick oder einen Abend in unserem kürzlich renovierten Bar-Restaurant."
    ],
    "en": [
      "Enjoy our fast paced lunch service on a large terrace overlooking the lake, or an evening in our new refurbished bar and restaurant"
    ],
    "it": [
      "Godetevi un pranzo veloce sulla nostra grande terrazza con vista sul lago o una serata nel nostro bar-ristorante recentemente rinnovato."
    ],
    "fr": [
      "Profitez de notre service rapide pour le déjeuner sur une grande terrasse avec vue sur le lac, ou d'une soirée dans notre bar-restaurant récemment rénové."
    ],
