  "rdfs:comment": {
    "de": [
      "Kreation, Verkauf von Schmuck auf Zinn-/Emaillebasis und aus Silber mit Mineralien, keltische Gravur auf Messing, Edelstahl.\r\nVerkauf von Rohmineralien aus der Auvergne.\r\nVerkauf von Feen, Drachen und Kobolden.\r\nHerstellung und Verkauf von Messern.\r\nPaket-Relaispunkt."
    ],
    "en": [
      "Creation, sale of silver jewelry with minerals, Celtic engraving on brass, stainless steel.\r\nSale of raw minerals from Auvergne.\r\nSale of fairies, dragon, elves.\r\nCreation and sale of knives."
    ],
    "it": [
      "Creazione e vendita di gioielli in peltro/smalto e argento con minerali, incisione celtica su ottone e acciaio inossidabile.\r\nVendita di minerali grezzi dell'Alvernia.\r\nVendita di fate, draghi, folletti.\r\nCreazione e vendita di coltelli.\r\nPunto di smistamento pacchi."
    ],
    "fr": [
      "Création, vente de bijoux base étain/émaux et en argent avec minéraux, gravure celtique sur laiton, inox.\r\nVente de minéraux bruts d'Auvergne.\r\nVente de fées, dragons, lutins.\r\nCréation et vente de couteaux.\r\nPoint relais colis."
    ],
    "nl": [
      "Creatie en verkoop van tinnen/emaille en zilveren sieraden met mineralen, Keltisch graveren op messing en roestvrij staal.\r\nVerkoop van ruwe mineralen uit de Auvergne.\r\nVerkoop van elfjes, draken, kabouters.\r\nCreatie en verkoop van messen.\r\nDoorgeefpunt voor pakketten."
    ],
    "es": [
      "Creación y venta de joyas de peltre/esmalte y plata con minerales, grabado celta sobre latón y acero inoxidable.\r\nVenta de minerales en bruto de Auvernia.\r\nVenta de hadas, dragones, duendes.\r\nCreación y venta de cuchillos.\r\nPunto de relevo de paquetes."
    ]
  },
