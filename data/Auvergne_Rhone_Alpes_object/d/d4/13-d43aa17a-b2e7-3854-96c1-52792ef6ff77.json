  "rdfs:comment": {
    "de": [
      "Mehrere lokale Bauernhöfe organisieren die Abholung einer Bio-Kiste, die jede Woche bestellt und jeden Dienstag in La Salle-en-Beaumont abgeholt werden kann."
    ],
    "en": [
      "Several local farms are organizing the collection of an organic crate, to be ordered every week and collected every Tuesday at La Salle-en-Beaumont."
    ],
    "it": [
      "Diverse aziende agricole locali stanno organizzando la raccolta di una cassa biologica, da ordinare ogni settimana e da ritirare ogni martedì a La Salle-en-Beaumont."
    ],
    "fr": [
      "Plusieurs  fermes locales, organisent le retrait d'une cagette bio, à commander chaque semaine et à venir récupérer tous les mardis, à la Salle-en-Beaumont."
    ],
    "nl": [
      "Verschillende lokale boerderijen organiseren de inzameling van een biologische krat, die elke week wordt besteld en elke dinsdag wordt opgehaald in La Salle-en-Beaumont."
    ],
    "es": [
      "Varias granjas locales organizan la recogida de una caja de productos ecológicos, que se encarga cada semana y se recoge todos los martes en La Salle-en-Beaumont."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cagette Bio Matheysine - La Salle-en-Beaumont"
    ]
  },
