  "rdfs:comment": {
    "de": [
      "Kommen Sie Ihre Mut mal prüfen, und zwar mit einer Dose Adrenalins. Dafür einfach an Bord eines Raftings gehen, und auf dem stürmischen \"Doron de Bozel\" fahren. Der Gebirgsbach stürzt durch Bäume und schattige Ufer hinunter. Kühle und Gänsehaut garantiert."
    ],
    "en": [
      "Test your courage and come take a shot of adrenaline as you raft down the tumultuous Doron river. A mountain stream (gone wild) which runs between trees and shady shores. Freshness and thrills guaranteed."
    ],
    "it": [
      "Mettete alla prova il vostro coraggio e fate un'iniezione di adrenalina con il rafting sulle acque tumultuose del Doron de Bozel. Un torrente di montagna che si snoda tra alberi e rive ombrose. Freschezza ed emozioni garantite."
    ],
    "fr": [
      "Testez votre courage et venez prendre un bol d’adrénaline en dévalant les flots tumultueux du Doron de Bozel en rafting. Un torrent de montagne qui défile entre arbres et rives ombragées. Fraîcheur et sensations fortes garanties."
    ],
    "nl": [
      "Test je moed en krijg een shot adrenaline door met een raft het woeste water van de Doron de Bozel af te zakken. Een bergstroom die zich een weg baant tussen bomen en schaduwrijke oevers. Frisheid en sensatie gegarandeerd."
    ],
    "es": [
      "Ponga a prueba su valor y reciba una inyección de adrenalina descendiendo en balsa por las tumultuosas aguas del Doron de Bozel. Un torrente de montaña que serpentea entre árboles y riberas sombrías. Frescor y emoción garantizados."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ausflug 5 - Rafting mit Adrenalin"
    ],
    "en": [
      "Excursion 5 – Rafting Adrenaline"
    ],
    "fr": [
      "Excursion 5 – Rafting Adrénaline"
    ]
  },
