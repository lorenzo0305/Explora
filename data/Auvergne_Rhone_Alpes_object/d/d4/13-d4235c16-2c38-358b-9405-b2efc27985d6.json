  "rdfs:comment": {
    "de": [
      "Diese Bar für handwerklich gebrautes Bier befindet sich in Crémieu, in der ehemaligen Kirche des Ursulinenklosters aus dem 18. Der ideale Ort, um ein hochwertiges handwerklich gebrautes Bier zu trinken und am Wochenende mit einem abwechslungsreichen Programm guten Sound zu hören!"
    ],
    "en": [
      "This craft beer bar is located in Crémieu, in the former church of the 18th-century Ursuline convent. It's the ideal place to drink a quality craft beer and listen to some great music at the weekend, with a varied programme!"
    ],
    "it": [
      "Questo bar di birra artigianale si trova a Crémieu, nell'ex chiesa del convento delle Orsoline del XVIII secolo. È il luogo ideale per bere una birra artigianale di qualità e ascoltare dell'ottima musica nel fine settimana, con un programma molto vario!"
    ],
    "fr": [
      "Ce bar à bières artisanales est situé à Crémieu, dans l'ancienne église du couvent des Ursulines du XVIIIe siècle. L'endroit idéal pour boire une bière artisanale de qualité et pour écouter du bon son le week-end avec une programmation  diversifiée !"
    ],
    "es": [
      "Este bar de cerveza artesanal está situado en Crémieu, en la antigua iglesia del convento de las Ursulinas del siglo XVIII. Es el lugar ideal para tomar una cerveza artesanal de calidad y escuchar buena música los fines de semana, ¡con una programación variada!"
    ],
    "nl": [
      "Dit ambachtelijke biercafé ligt in Crémieu, in de voormalige kerk van het 18e-eeuwse Ursulinenklooster. Het is de ideale plek om een ambachtelijk kwaliteitsbier te drinken en in het weekend naar leuke muziek te luisteren, met een gevarieerd programma!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Ursulines - Beer bar"
    ],
    "fr": [
      "Les Ursulines - Bar à bières"
    ]
  },
