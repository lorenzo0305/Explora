  "rdfs:comment": {
    "de": [
      "Ehemalige Almhütte, die in ein gemütliches Bergrestaurant umgewandelt wurde. Im Corbeleys vermischen sich die Erinnerungen an eine Familie aus Bellevilloise mit der Pracht der Berge und einer traditionellen savoyischen Küche"
    ],
    "en": [
      "A former alpine chalet transformed into a cosy high-altitude restaurant. At Le Corbeleys, memories of a Bellevilloise family mingle with the splendor of the mountains and traditional Savoyard cuisine."
    ],
    "it": [
      "Un ex chalet d'alpeggio trasformato in un accogliente ristorante di montagna. Al Corbeleys, i ricordi di una famiglia Bellevilloise si mescolano allo splendore delle montagne e alla cucina tradizionale savoiarda"
    ],
    "fr": [
      "Ancien chalet d'alpage transformé en agréable restaurant d'altitude. Au Corbeleys les souvenirs d'une famille Bellevilloise se mêlent à la splendeur des montagnes et à une cuisine traditionnelle savoyarde"
    ],
    "es": [
      "Un antiguo chalet de pastos de montaña transformado en un acogedor restaurante de montaña. En Corbeleys, los recuerdos de una familia de Bellevilloise se mezclan con el esplendor de la montaña y la cocina tradicional saboyana"
    ],
    "nl": [
      "Een voormalig almchalet omgetoverd tot een gezellig bergrestaurant. In Corbeleys vermengen herinneringen aan een familie uit Bellevilloise zich met de pracht van de bergen en de traditionele Savoyaardse keuken"
    ]
  },
