  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf eine Lufttaufe mit dem Gleitschirm in Val Cenis? Dann heben Sie in aller Ruhe ab. Pierre-Olivier, ein staatlich geprüfter Profi, bietet Ihnen ein geselliges und persönliches Erlebnis. Genießen Sie einen beschaulichen oder sportlichen Flug, ganz nach Ihren Wünschen."
    ],
    "en": [
      "Fancy a first paragliding flight in Val Cenis? Then take to the skies with complete peace of mind. Pierre-Olivier, a qualified professional, offers you a friendly, personalised experience. Enjoy a contemplative or sporty flight, as you wish."
    ],
    "it": [
      "Volete fare un primo volo in parapendio in Val Cenis? Allora prendete il volo in tutta tranquillità. Pierre-Olivier, professionista qualificato, vi offre un'esperienza amichevole e personalizzata. Godetevi un volo contemplativo o sportivo, come preferite."
    ],
    "fr": [
      "Envie d'un baptême de l'air en parapente à Val Cenis ? Alors envolez vous en toute sérénité. Pierre-Olivier, professionnel diplômé d'état, vous propose une expérience conviviale et personnalisée. Profitez d'un vol contemplatif ou sportif selon vos envies."
    ],
    "es": [
      "¿Te apetece un primer vuelo en parapente en Val Cenis? Surca los cielos con toda tranquilidad. Pierre-Olivier, un profesional cualificado, le ofrece una experiencia agradable y personalizada. Disfrute de un vuelo contemplativo o deportivo, como desee."
    ],
    "nl": [
      "Zin in een eerste paragliding vlucht in Val Cenis? Ga dan met een gerust hart de lucht in. Pierre-Olivier, een gekwalificeerde professional, biedt u een vriendelijke, persoonlijke ervaring. Geniet van een contemplatieve of sportieve vlucht, zoals u wilt."
    ]
  },
