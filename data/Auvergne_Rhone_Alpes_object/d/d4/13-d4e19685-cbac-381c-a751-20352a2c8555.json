  "rdfs:comment": {
    "de": [
      "Café-Restaurant im Herzen des Waldes von Cormaranche en Bugey mit Südterrasse, herzlichem Empfang und regionaler Küche.\r\nStart einer Loipe für nordische Skifahrer und Schneeschuhwanderer."
    ],
    "en": [
      "Café restaurant in the heart of the Cormaranche en Bugey forest with south-facing terrace, warm welcome and local cuisine.\r\nDeparture point for Nordic skiing and snowshoeing."
    ],
    "it": [
      "In un'antica casa colonica di Bugiste del XVII secolo, venite a gustare una cucina stagionale autentica e senza pretese. Fabrice, maestro ristoratore, propone carne alla brace, piatti a base di formaggio, stufati tradizionali e dolci fatti in casa."
    ],
    "fr": [
      "Dans une vieille ferme Bugiste du XVIIe  siècle, venez déguster une cuisine authentique sans prétention et au rythme des saisons. Fabrice, maître restaurateur vous propose viandes sur ardoise, mets au fromage, plats mijotés à  l'ancienne, desserts maison."
    ],
    "nl": [
      "Kom in een oude 17e-eeuwse boerderij in Bugiste genieten van een pretentieloze, authentieke seizoenskeuken. Fabrice, meester-restaurateur, biedt vlees op de lei, kaasgerechten, traditionele stoofpotten en huisgemaakte desserts."
    ],
    "es": [
      "En una antigua granja bugiste del siglo XVII, venga a disfrutar de una cocina de temporada auténtica y sin pretensiones. Fabrice, maestro restaurador, propone carnes a la pizarra, platos de queso, guisos tradicionales y postres caseros."
    ]
  },
  "rdfs:label": {
    "de": [
