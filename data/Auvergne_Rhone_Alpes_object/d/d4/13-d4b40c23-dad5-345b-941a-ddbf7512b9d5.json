  "rdfs:comment": {
    "de": [
      "Sonnenterrasse mit Blick auf den Mont Pourri, Zugang mit den Skiern oder zu Fuß. Leckere, hausgemachte Küche: Tagesgericht, Burger, Spezialitäten, Pizza, Veggie, leckere Desserts, Snacks & Après-Ski."
    ],
    "en": [
      "Sunny terrace with views of Mont Pourri, ski-in/ski-out or pedestrian access. Tasty home-cooked cuisine: daily specials, burgers, specialities, pizzas, vegetarian dishes, gourmet desserts, snacks & après ski."
    ],
    "it": [
      "Terrazza soleggiata con vista sul Mont Pourri, accessibile con gli sci ai piedi o a piedi. Cucina gustosa e fatta in casa: piatto del giorno, hamburger, specialità, pizze, piatti vegetariani, dessert golosi, snack e après-ski."
    ],
    "fr": [
      "Terrasse ensoleillée avec vue sur le Mont Pourri, accès skis aux pieds ou piéton. Cuisine savoureuse et faite maison : plat du jour, burgers, spécialités, pizzas, veggie, desserts gourmands, snack & après ski."
    ],
    "nl": [
      "Zonnig terras met uitzicht op de Mont Pourri, ski-in/ski-out of toegang voor voetgangers. Smakelijke huisgemaakte keuken: dagschotels, hamburgers, specialiteiten, pizza's, groenten, gastronomische desserts, snacks & après-ski."
    ],
    "es": [
      "Terraza soleada con vistas al Mont Pourri, ski-in/ski-out o acceso peatonal. Sabrosa cocina casera: platos del día, hamburguesas, especialidades, pizzas, verduras, postres gourmet, aperitivos y après ski."
    ]
  },
