  "rdfs:comment": {
    "de": [
      "FoxaGliss Excursions canoë ist Ihr Anbieter für Ihre Kanu- und Kajakaktivitäten im südlichen Bugey. Kommen Sie und testen Sie einen ihrer 5 Parcours."
    ],
    "en": [
      "Discover the world of the track or paddle on the Cuchet and Rhône bodies of water. Sailing courses, kayaking down the wild Rhône or stand up paddle. A place to find your happiness!"
    ],
    "it": [
      "FoxaGliss Excursions canoë è il vostro fornitore di servizi per la canoa e il kayak nella regione meridionale di Bugey. Venite a provare uno dei loro 5 corsi."
    ],
    "fr": [
      "FoxaGliss Excursions canoë est votre prestataire pour vos activités canoë kayak dans le bugey sud, venez tester un de leur 5 parcours."
    ],
    "es": [
      "FoxaGliss Excursions canoë es su proveedor de servicios de piragüismo y kayak en el sur de la región de Bugey. Venga a probar uno de sus 5 recorridos."
    ],
    "nl": [
      "FoxaGliss Excursies kanoë is uw dienstverlener voor kanoën en kajakken in de zuidelijke Bugey regio. Kom en probeer een van hun 5 cursussen uit."
    ]
  },
