  "rdfs:comment": {
    "de": [
      "Im Herzen von denen die Geburt des siebten Kunst sah, begrüßt Tabata Bonardi Sie zu seiner Villa in den frühen zwanzigsten Jahrhunderts, gehört zu Marguerite und Auguste Lumière und renoviert von Designer Alain Vavro."
    ],
    "en": [
      "In the heart of the Lumière disctrict, Restaurant Marguerite serves up authentic cuisine that combines tradition and modernity in equal measure. Dine in the historical setting of Auguste and Marguerite Lumière's former home."
    ],
    "it": [
      "In pieno centro del quartiere Lumière, Marguerite Restaurant propone una cucina genuina tra tradizione e modernità; nell'ambientazione storica dell'antica residenza di Auguste e Marguerite Lumière."
    ],
    "fr": [
      "Au cœur du quartier Lumière, le Restaurant Marguerite propose une cuisine authentique entre tradition et modernité, dans le cadre historique de l'ancienne maison d'Auguste et Marguerite Lumière."
    ],
    "nl": [
      "In het hart van de wijk Lumière biedt Restaurant Marguerite een authentieke keuken die traditie en moderniteit combineert, in het historische kader van het voormalige huis van Auguste en Marguerite Lumière."
    ],
    "es": [
      "En el corazón del barrio Lumière, Marguerite Restaurant propone una cocina auténtica entre tradición y modernidad, en el marco histórico de la antigua casa de Auguste y Marguerite Lumière."
    ]
  },
