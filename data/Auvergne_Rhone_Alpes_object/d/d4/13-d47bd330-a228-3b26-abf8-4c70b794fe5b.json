  "rdfs:comment": {
    "de": [
      "Das Restaurant le Monchu bietet Ihnen seine savoyischen Spezialitäten vom Grill, aber auch eine traditionelle Bistro-Küche."
    ],
    "en": [
      "The Monchu restaurant offers Savoyard specialities cooked over an open fire, as well as traditional bistro cuisine."
    ],
    "it": [
      "Il ristorante Monchu offre specialità savoiarde alla griglia e cucina tradizionale da bistrot."
    ],
    "fr": [
      "Le restaurant le Monchu vous propose ses spécialités savoyardes à la braise mais aussi une cuisine de bistrot traditionnelle"
    ],
