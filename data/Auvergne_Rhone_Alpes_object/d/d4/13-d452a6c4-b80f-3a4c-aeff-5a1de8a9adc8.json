  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel des Petit Salève sind noch die Spuren einer befestigten Anlage zu erkennen. Es handelt sich um ein allobroger Lager aus dem 5. bis 1."
    ],
    "en": [
      "At the summit of the Petit Salève, traces of a fortified enclosure can still be seen. This is an Allobroge camp dating from the 5th to 1st centuries BC."
    ],
    "it": [
      "Sulla cima del Petit Salève sono ancora visibili le tracce di un recinto fortificato. Si tratta di un accampamento allobroge risalente al V-I secolo a.C.."
    ],
    "fr": [
      "Au sommet du Petit Salève, on distingue encore les traces d'une enceinte fortifiée. Il s'agit d'un camp allobroge datant du Vème au Ier siècle avant J.C."
    ],
    "nl": [
      "Op de top van de Petit Salève zijn nog sporen van een versterkte ommuring te zien. Dit is een Allobroge-kamp uit de 5e tot 1e eeuw voor Christus."
    ],
    "es": [
      "En la cima de la Petit Salève, todavía se pueden ver restos de un recinto fortificado. Se trata de un campamento allobroge que data de los siglos V a I a.C."
    ]
  },
  "rdfs:label": {
    "de": [
      "Das Lager der Allobroger"
    ],
    "en": [
      "The Allobroges camp"
    ],
    "it": [
      "Il campo degli Allobroges"
    ],
    "fr": [
      "Le camp des Allobroges"
    ],
    "nl": [
      "Het Allobroges-kamp"
    ]
  },
