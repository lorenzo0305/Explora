  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/37c3a80e-be02-3500-83b3-ca2eb3553cc4",
      "dc:description": {
        "de": [
          "In dieser Show erleben Sie die großen Momente des Kampfes der Bergarbeiter, die Männer und Frauen, die die Sozialgeschichte der Region geprägt haben."
        ],
        "en": [
          "Through this show, relive the great moments of the miners? struggle, and the men and women who left their mark on the region?s social history."
        ],
        "it": [
          "In questa mostra si rivivono i grandi momenti della lotta dei minatori e gli uomini e le donne che hanno segnato la storia sociale della regione."
        ],
        "fr": [
          "A travers ce spectacle, revivez les grands moments de la lutte des mineurs, les hommes et femmes qui ont marqué l’histoire sociale de la région."
        ],
        "es": [
          "Reviva en este espectáculo los grandes momentos de la lucha de los mineros y los hombres y mujeres que dejaron su huella en la historia social de la región."
        ],
        "nl": [
          "In deze show herbeleef je de grote momenten van de mijnwerkersstrijd en de mannen en vrouwen die hun stempel hebben gedrukt op de sociale geschiedenis van de regio."
        ]
      },
