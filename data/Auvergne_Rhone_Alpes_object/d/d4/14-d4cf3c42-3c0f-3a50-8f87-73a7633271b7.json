  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/01c71973-a65f-3c05-a93f-4e85152ec452",
      "dc:description": {
        "de": [
          "Von 14.00 bis 17.00 Uhr\n\nZeit, sich zu amüsieren! Ein besonderer Moment für die ganze Familie mit Gesellschaftsspielen, um über Kunst zu sprechen, umgeben von Kunstwerken und gemütlich im Kleinen Salon sitzend.\n\nKostenlos - Ohne Termin"
        ],
        "en": [
          "From 2:00 pm to 5:00 pm\n\nTime to have fun! A special moment for the whole family to play board games and talk about art, surrounded by works of art, comfortably seated in the heart of the Petit Salon.\n\nFree - No appointment necessary"
        ],
        "it": [
          "Dalle 14:00 alle 17:00\n\nÈ tempo di divertirsi! Un momento speciale in famiglia per giocare a giochi da tavolo e parlare d'arte, circondati da opere d'arte e comodamente seduti nel cuore del Petit Salon.\n\nGratuito - Non è necessario un appuntamento"
        ],
        "fr": [
          "De 14h00 à 17h00\n\nC’est l’heure de s’amuser ! Un moment privilégié en famille autour de jeux de société, pour parler d’art, entourés d’œuvres et confortablement installés au cœur du Petit Salon.\n\nGratuit - Sans rendez-vous"
        ],
        "nl": [
          "Van 14.00 tot 17.00 uur\n\nTijd voor plezier! Een speciaal familiemoment om bordspelletjes te spelen en over kunst te praten, omringd door kunstwerken en comfortabel zittend in het hart van de Petit Salon.\n\nGratis - Geen afspraak nodig"
        ],
        "es": [
          "De 14:00 a 17:00\n\n¡Tiempo para divertirse! Un momento especial en familia para jugar a juegos de mesa y hablar de arte, rodeados de obras de arte y cómodamente sentados en el corazón del Petit Salon.\n\nGratis - Sin cita previa"
        ]
      },
      "@type": [
        "Description"
      ],
