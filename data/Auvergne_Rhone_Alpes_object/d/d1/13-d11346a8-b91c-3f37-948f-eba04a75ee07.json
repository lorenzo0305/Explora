  "rdfs:comment": {
    "de": [
      "Der größte Bio-Olivenhain der Ardèche (nach Vielfalt und Fläche), seine Olivenbäume, die in Agrarökologie auf den Terrassen ohne Bewässerung geführt werden, seine Ölmühle, sein Obstgarten mit Erhaltungszüchtung (30 Sorten)."
    ],
    "en": [
      "The largest organic olive grove in Ardèche (in terms of diversity and surface area), with olive trees grown using agro-ecology on terraces without irrigation, an oil mill and a conservatory orchard (30 varieties)."
    ],
    "it": [
      "Il più grande oliveto biologico dell'Ardèche (in termini di diversità e superficie), i suoi olivi coltivati in agro-ecologia su terrazze senza irrigazione, il suo frantoio e il suo frutteto conservatore (30 varietà)."
    ],
    "fr": [
      "La plus grande oliveraie biologique d'Ardèche (par sa diversité et sa surface), ses oliviers conduits en agro-écologie sur les terrasses sans irrigation, son moulin à huile, son verger conservatoire (30 variétés)."
    ],
    "es": [
      "El mayor olivar ecológico de Ardèche (en términos de diversidad y superficie), sus olivos cultivados de forma agroecológica en terrazas sin riego, su almazara y su huerto conservatorio (30 variedades)."
    ],
    "nl": [
      "De grootste biologische olijfgaard in de Ardèche (in termen van diversiteit en oppervlakte), zijn olijfbomen geteeld met agro-ecologie op terrassen zonder irrigatie, zijn oliemolen en zijn serre boomgaard (30 variëteiten)."
    ]
  },
  "rdfs:label": {
