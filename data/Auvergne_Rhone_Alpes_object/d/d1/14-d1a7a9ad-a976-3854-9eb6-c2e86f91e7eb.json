  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2bd11316-d358-30b8-8b10-af9f93bb7d43",
      "dc:description": {
        "de": [
          "Fête de la Paille, ein Festival, das am 20. Juli 2024 in mehreren Gemeinden im Tal der Créquoise und Embryenne stattfindet.\n\nProgramm :\n\n- Strohskulpturen in jeder Gemeinde\n- Animationen in den Dörfern\n- Festliche Mahlzeiten\n- Feuerwerk"
        ],
        "en": [
          "Fête de la Paille, a festival to be held on July 20, 2024 in several towns in the Créquoise and Embryenne valleys.\n\nProgram :\n\n- Straw sculptures in each commune\n- Village entertainment\n- Festive meals\n- Fireworks display"
        ],
        "it": [
          "Fête de la Paille, una festa che si terrà il 20 luglio 2024 in diversi comuni delle valli Créquoise ed Embryenne.\n\nProgramma :\n\n- Sculture di paglia in ogni villaggio\n- Animazione nei villaggi\n- Pasti festivi\n- Spettacolo pirotecnico"
        ],
        "fr": [
          "Fête de la Paille, un festival qui se déroulera le 20 juillet 2024 dans plusieurs communes de la vallée de la Créquoise et de l'Embryenne.\n\nProgramme :\n\n- Sculptures de paille dans chaque commune\n- Animations dans les villages\n- Repas festifs\n- Feux d'artifice"
        ],
        "es": [
          "Fête de la Paille, fiesta que se celebrará el 20 de julio de 2024 en varios municipios de los valles de Créquoise y Embryenne.\n\nPrograma :\n\n- Esculturas de paja en cada pueblo\n- Animaciones en los pueblos\n- Comidas festivas\n- Fuegos artificiales"
        ],
        "nl": [
          "Fête de la Paille, een festival dat op 20 juli 2024 wordt gehouden in verschillende gemeenten in de valleien van Créquoise en Embryenne.\n\nProgramma :\n\n- Strofiguren in elk dorp\n- Animaties in de dorpen\n- Feestelijke maaltijden\n- Vuurwerk"
        ]
      },
