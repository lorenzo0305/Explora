  "rdfs:comment": {
    "de": [
      "Sportlicher Raid ohne Zeitmessung im Duo (auch solo möglich) Laufen, Kanu, Mountainbike. Anmeldung auf Sports'N Connect. Nach der Anstrengung Möglichkeit zum Essen und kostenloses Konzert."
    ],
    "en": [
      "Non-timed sports raid in duo (solo possible) running, canoeing, mountain biking. Registration on Sports'N Connect. After the race, lunch and a free concert."
    ],
    "it": [
      "Raid sportivi non cronometrati a coppie (possibilità di assolo): corsa, canoa, mountain bike. Iscrizioni su Sports'N Connect. Dopo la gara, potrete gustare un pasto e un concerto gratuito."
    ],
    "fr": [
      "Raid sportif non chronométré en duo (possibilité en solo) course à pied, canoë, VTT. Inscriptions sur Sports'N Connect. Après l'effort possibilité de repas et concert gratuit."
    ],
    "es": [
      "Raid deportivo no cronometrado por parejas (posible en solitario): carrera a pie, piragüismo, bicicleta de montaña. Inscripción en Sports'N Connect. Después de la carrera, podrás disfrutar de una comida y un concierto gratuito."
    ],
    "nl": [
      "Niet-getimede sportinval in duo's (solo mogelijk): hardlopen, kanoën, mountainbiken. Inschrijven via Sports'N Connect. Na de wedstrijd kun je genieten van een maaltijd en een gratis concert."
    ]
  },
