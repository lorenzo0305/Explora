  "rdfs:comment": {
    "de": [
      "Die USEP vermittelt verschiedene sportliche Aktivitäten und Einführungen (Schwimmbad, Mountainbike, Wandern, ...). Die USEP nimmt Kinder der Schulen J.J. Rousseau und J. Ferry im Alter von 6 bis 12 Jahren auf."
    ],
    "en": [
      "USEP introduces children to a range of sporting activities (swimming, mountain biking, hiking, etc.). USEP welcomes children aged 6 to 12 from J.J. ROUSSEAU and J. FERRY schools."
    ],
    "it": [
      "L'USEP introduce i bambini a varie attività e iniziazioni sportive (piscina, mountain bike, escursioni, ...). L'USEP accoglie i bambini delle scuole J.J. ROUSSEAU e J. FERRY dai 6 ai 12 anni."
    ],
    "fr": [
      "L'USEP fait découvrir diverses activités et initiations sportives (piscine, vtt, rando, ...). L'USEP accueille des enfants des écoles J.J. ROUSSEAU et J. FERRY âgés de 6 à 12 ans."
    ],
    "nl": [
      "USEP laat kinderen kennismaken met verschillende sportieve activiteiten (zwemmen, mountainbiken, wandelen, enz.). USEP verwelkomt kinderen van 6 tot 12 jaar van de scholen J.J. ROUSSEAU en J. FERRY."
    ],
    "es": [
      "La USEP introduce a los niños en diversas actividades deportivas y de iniciación (piscina, bicicleta de montaña, senderismo, ...). La USEP acoge a los niños de las escuelas J.J. ROUSSEAU y J. FERRY de 6 a 12 años."
    ]
  },
