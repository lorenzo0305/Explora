  "rdfs:comment": {
    "de": [
      "Entdeckungsflug an Bord eines Ultraleichtflugzeugs über die Baronnies oder ein anderes Gebiet.\r\nEine originelle Art, das Naturerbe der Baronnies zu entdecken."
    ],
    "en": [
      "Discovery flight over the Baronnies or another area in a microlight.\r\nAn original way to discover the natural heritage of the Baronnies."
    ],
    "it": [
      "Sorvolate le montagne in un ultraleggero a cabina chiusa per scoprire in modo originale il patrimonio naturale e le catene montuose delle Baronnies. Un'esperienza magica all'alba o al tramonto!"
    ],
    "fr": [
      "Promenades aériennes en montagne à bord d'un ULM à cockpit fermé pour découvrir de façon originale le patrimoine naturel et les massifs montagneux des Baronnies. Des moments magiques au lever ou au coucher du soleil !"
    ],
    "es": [
      "Sobrevuele las montañas en un ultraligero de cabina cerrada para descubrir de forma original el patrimonio natural y las cadenas montañosas de las Baronnies. Una experiencia mágica al amanecer o al atardecer"
    ],
    "nl": [
      "Een ontdekkingsvlucht in een microlight boven de Baronnies of een ander gebied.\r\nEen originele manier om het natuurlijke erfgoed van de Baronnies te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "An Unusual way to Discover the Baronnies Region onboard a Plane for a 30 min Flight"
    ],
    "fr": [
      "Vol découverte en ULM au-dessus des Baronnies"
    ]
  },
