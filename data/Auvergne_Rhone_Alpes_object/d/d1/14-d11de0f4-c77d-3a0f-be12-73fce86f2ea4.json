  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d55b5de6-7f19-3277-b0a3-10a7024f2bc9",
      "dc:description": {
        "de": [
          "Beach Fitness von 18:00 bis 19:00 Uhr\nAb 16 mit elterlicher Erlaubnis.\nTreffpunkt an der Strandhütte mit Ihrem Handtuch oder Ihrer Matte und Ihrer Wasserflasche.\nKostenlos."
        ],
        "en": [
          "Beach Fitness from 6pm to 7pm\nFrom 16 with parental permission.\nMeet at the beach chalet with your towel or mat and bottle of water.\nFree admission."
        ],
        "it": [
          "Beach Fitness dalle 18.00 alle 19.00\nA partire dai 16 anni con il permesso dei genitori.\nRitrovo allo chalet della spiaggia con asciugamano o tappetino e una bottiglia d'acqua.\nGratuito."
        ],
        "fr": [
          "Beach Fitness de 18h à 19h\nA partir de 16 avec autorisation parentale.\nRendez-vous au chalet de plage avec votre serviette ou votre tapis et votre bouteille d'eau.\nGratuit."
        ],
        "es": [
          "Fitness en la playa de 18:00 a 19:00\nA partir de 16 años con autorización paterna.\nCita en el chalet de la playa con tu toalla o esterilla y una botella de agua.\nGratuito."
        ],
        "nl": [
          "Beach Fitness van 18.00 tot 19.00 uur\nVanaf 16 jaar met toestemming van de ouders.\nVerzamelen bij het strandchalet met je handdoek of matje en een fles water.\nGratis."
        ]
      },
