  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Weingut einmal anders, bei einem kalten, leckeren und gekochten Picknick, das in den Kellern der Domaine Dupasquier geteilt wird!"
    ],
    "en": [
      "Discover the estate in a different way, over a cold, gourmet, cooked picnic shared in the Domaine Dupasquier cellars!"
    ],
    "it": [
      "Scoprite la tenuta in modo diverso, con un picnic gourmet, cotto e freddo, condiviso nelle cantine del Domaine Dupasquier!"
    ],
    "fr": [
      "Découvrir le domaine autrement, autour d'un pique nique froid, gourmand et cuisiné, partagé dans les caves du Domaine Dupasquier !"
    ],
    "nl": [
      "Ontdek het landgoed op een andere manier, tijdens een gastronomische, gekookte, koude picknick gedeeld in de kelders van Domaine Dupasquier!"
    ],
    "es": [
      "Descubra la finca de una forma diferente, con un picnic gourmet, cocinado y frío, compartido en las bodegas del Domaine Dupasquier"
    ]
  },
