  "rdfs:comment": {
    "de": [
      "Genießen Sie ein einzigartiges gastronomisches Erlebnis! In einer ländlichen und authentischen Umgebung, im Herzen eines Bauernhofs in der Ardèche, werden Mahlzeiten mit lokalen Produkten vom Bauernhof zubereitet und im Holzofen zubereitet."
    ],
    "en": [
      "Indulge in a local farm-to-table feast, a gastronomic delight featuring meticulously crafted meals. Nestled in countryside tranquility, this spot offers a charming setting with a summer terrace and a cozy fireplace, perfect for all seasons."
    ],
    "it": [
      "Godetevi un'esperienza gastronomica unica! In un autentico ambiente rurale, nel cuore di una fattoria dell'Ardèche, gustate i pasti preparati con prodotti agricoli locali e cotti nel forno a legna."
    ],
    "fr": [
      "Profitez d'une expérience gastronomique unique ! Dans un cadre champêtre et authentique, au cœur d'une ferme ardéchoise, des repas élaborés avec des produits locaux de la ferme et cuis au four à bois."
    ],
    "nl": [
      "Een unieke culinaire ervaring met lokale boerderijproducten. Gelegen in plattelandshart, biedt charmante omgeving, zomerterras en winterse haard."
    ],
    "es": [
      "Disfrute de una experiencia gastronómica única En un entorno rural auténtico, en el corazón de una granja de Ardèche, disfrute de comidas preparadas con productos agrícolas locales y cocinadas en un horno de leña."
    ]
  },
