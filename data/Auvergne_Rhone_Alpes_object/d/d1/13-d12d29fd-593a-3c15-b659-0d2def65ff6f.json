  "rdfs:comment": {
    "de": [
      "Das Hotel liegt auf 1500m Höhe. Pisten und Wanderung liegen nahe dasHotel. 15 ruhige und bequeme Zimmer. Hertzliche Atmosphäre."
    ],
    "en": [
      "Hotel restaurant at an altitude of 1500 m, at the foot of the ski slopes, and hiking paths. 15 confortable and quiet bedrooms. Hotel in the form of a large chalet. Warm and friendly atmosphere."
    ],
    "it": [
      "Hotel-ristorante a 1500 m di altitudine, ai piedi delle piste e dei sentieri escursionistici.                   15 camere confortevoli e tranquille. Grande hotel in stile chalet. Atmosfera calda."
    ],
    "fr": [
      "Hôtel-restaurant à 1500 m d'altitude au pied des pistes et des randonnées.                   15 chambres tout confort et calmes. Hôtel de style grand chalet. Ambiance chaleureuse."
    ],
    "es": [
      "Hotel-restaurante a 1500 m de altitud a pie de pistas y rutas de senderismo.                   15 habitaciones cómodas y tranquilas. Gran hotel de estilo chalet. Ambiente cálido."
    ],
    "nl": [
      "Hotel-restaurant op 1500 m hoogte aan de voet van de pistes en wandelpaden.                   15 comfortabele en rustige kamers. Groot hotel in chaletstijl. Warme sfeer."
    ]
  },
