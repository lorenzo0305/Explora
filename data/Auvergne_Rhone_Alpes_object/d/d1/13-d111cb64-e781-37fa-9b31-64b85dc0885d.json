  "rdfs:comment": {
    "de": [
      "Eine Kulturerbeführerin öffnet Ihnen die wunderschöne Barockkirche St. Thomas-Becket, eines der schönsten Zeugnisse der Barockkunst, die unsere Bergtäler säumt, in jeder unserer mit Gold, Licht und Farben geschmückten Kirchen."
    ],
    "en": [
      "A heritage guide will open the magnificent baroque church of Saint Thomas-Becket, one of the most beautiful testimonies of baroque art in our mountain valleys, in each of our churches decorated with gold, light and color."
    ],
    "it": [
      "Una guida del patrimonio aprirà la magnifica chiesa barocca di St. Thomas-Becket, uno degli esempi più belli dell'arte barocca nelle nostre valli di montagna, in ogni chiesa decorata con oro, luce e colore."
    ],
    "fr": [
      "Une guide du patrimoine vous ouvrira la magnifique église baroque Saint Thomas-Becket, un des plus beaux témoignages d'art baroque qui jalonne nos vallées de montagne, dans chacune de nos églises décorées d'or, de lumière et de couleurs."
    ],
    "es": [
      "Un guía del patrimonio le abrirá la magnífica iglesia barroca de St. Thomas-Becket, uno de los más bellos ejemplos del arte barroco en nuestros valles de montaña, en cada una de nuestras iglesias decoradas con oro, luz y color."
    ],
    "nl": [
      "Een erfgoedgids opent de prachtige barokkerk St. Thomas-Becket, een van de mooiste voorbeelden van barokkunst in onze bergdalen, in elk van onze kerken versierd met goud, licht en kleur."
    ]
  },
