  "rdfs:comment": {
    "de": [
      "Neuheit 2025: Erkunden Sie die Hänge von Chamrousse auf eine neue Art und Weise mit dem Schienenschlitten!\r\nDiese moderne und gesicherte Rodelbahn ermöglicht es den Besuchern, mit hoher Geschwindigkeit die Hänge hinunter zu sausen und dabei ein außergewöhnliches Panorama zu genießen."
    ],
    "en": [
      "New for 2025: explore Chamrousse's slopes in a new way with rail tobogganing!\r\nThis modern, safe toboggan run lets visitors hurtle down the slopes at high speed, while enjoying exceptional panoramic views."
    ],
    "it": [
      "Novità 2025: esplorate le piste di Chamrousse in modo nuovo con lo slittino su rotaia!\r\nQuesta moderna e sicura pista per slittini permette ai visitatori di sfrecciare sulle piste ad alta velocità, godendo di un panorama eccezionale."
    ],
    "fr": [
      "Nouveauté 2025 : explorez les pentes de Chamrousse d'une nouvelle manière avec la luge sur rail !\r\nCette piste de luge moderne et sécurisée permet aux visiteurs de dévaler les pentes à grande vitesse, tout en profitant d'un panorama exceptionnel."
    ],
    "es": [
      "Novedad para 2025: ¡explore las pistas de Chamrousse de una forma nueva con el trineo sobre raíles!\r\nEsta pista de trineo moderna y segura permite a los visitantes descender a gran velocidad por las pistas mientras disfrutan de un panorama excepcional."
    ],
    "nl": [
      "Nieuw in 2025: verken de pistes van Chamrousse op een nieuwe manier met railrodelen!\r\nDeze moderne, veilige rodelbaan laat bezoekers met hoge snelheid van de hellingen afglijden, terwijl ze genieten van een uitzonderlijk panorama."
    ]
  },
  "rdfs:label": {
    "de": [
      "Rodelpark - Rodelcoaster (Rodeln auf Schienen)"
    ],
    "en": [
      "Luge Park - Luge Coaster (luge on rails)"
    ],
    "fr": [
      "Luge Park - Luge Coaster (luge sur rail)"
    ]
  },
