  "rdfs:comment": {
    "de": [
      "Ländliche und gepflegte Küche. Einheimische Spezialitäten, Eintopf, Riesenkartoffeln mit Grillfleisch und Leckereien. Das Restaurant ist ein Chalet mit für das Gebirge typischem Dekor, wo Sie von der Belleville-Einwohnerin Servanne empfangen werden."
    ],
    "en": [
      "Valley local, Servanne Jay, offers  traditional cuisine in a warm and welcoming setting,  including Savoyard specialities, casseroles and grilled meats, using quality produce from local producers.\r\nKid's menus and colouring books.\r\n\r\n."
    ],
    "it": [
      "Servanne Jay, originaria della valle di Belleville, vi offre specialità tradizionali savoiarde, stufati e carni alla griglia in un ambiente caldo e autentico."
    ],
    "fr": [
      "Servanne Jay, native de la vallée des Belleville, vous propose dans un cadre authentique et chaleureux, une cuisine traditionnelle en mettant en avant les spécialités savoyardes, mijotés et viandes grillées."
    ],
    "nl": [
      "Verzorgde boerenkeuken, te ontdekken via de streekspecialiteiten, stoofschotels, grote gevulde aardappels, gegrild vlees en overige lekkernijen. In dit, als een bergchalet ingericht restaurant wordt u verwelkomd door Servanne, inwoonster van Belleville."
    ],
    "es": [
      "Servanne Jay, oriunda del valle de Belleville, le ofrece especialidades tradicionales de Saboya, guisos y carnes a la parrilla en un ambiente cálido y auténtico."
    ]
  },
