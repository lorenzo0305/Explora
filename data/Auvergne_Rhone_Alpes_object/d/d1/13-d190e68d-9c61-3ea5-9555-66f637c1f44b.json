  "rdfs:comment": {
    "de": [
      "Loïc empfängt Sie mit Wohlwollen und Professionalität, damit Sie neue Energie tanken und sich um sich selbst kümmern können, mit Entspannungsmassagen oder Massagen mit spezifischeren Zielen, oder auch für eine energetische Betreuung."
    ],
    "en": [
      "Loïc welcomes you with kindness and professionalism in order to recharge your batteries and take care of you with relaxing or more specific massages, or for an energetic follow-up."
    ],
    "it": [
      "Loïc vi accoglie con gentilezza e professionalità per ricaricarvi e prendersi cura di voi con massaggi rilassanti o più specifici, o per un follow-up energetico."
    ],
    "fr": [
      "Loïc vous accueille avec bienveillance et professionnalisme afin de vous ressourcer et de prendre soin de vous avec des massages de détente ou à visée plus spécifique, ou bien pour un suivi énergétique."
    ],
    "nl": [
      "Loïc verwelkomt u met vriendelijkheid en professionaliteit om uw batterijen weer op te laden en u te verzorgen met ontspannende of meer specifieke massages, of voor een energieke follow-up."
    ],
    "es": [
      "Loïc le recibe con amabilidad y profesionalidad para recargarle las pilas y cuidarle con masajes relajantes o más específicos, o para un seguimiento energético."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Meriem massage & énergie"
    ]
  },
