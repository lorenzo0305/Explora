  "rdfs:comment": {
    "de": [
      "Leicht erreichbar, 10 Minuten vom historischen Zentrum und den Kongresszentren entfernt, 130 Meter von der Straßenbahnlinie E und in der Nähe der Autobahnzufahrten. Das Kyriad Grenoble Centre stellt Ihnen seinen privaten, sicheren und kostenlosen Parkplatz zur Verfügung (begrenzte Parkplätze)."
    ],
    "en": [
      "Easily accessible, 10 minutes from the historic center and convention centers, 130 meters from Tram E, and close to motorway access. The Kyriad Grenoble Centre offers free, secure, private parking (spaces are limited)."
    ],
    "it": [
      "Facilmente raggiungibile, a 5 minuti dal centro storico e dai centri congressi, a 50 metri dal Tram E, e vicino agli accessi autostradali, il Kyriad Grenoble Centre mette alla Sua disposizione il suo parcheggio privato, custodito e gratuito (posti limitati)."
    ],
    "fr": [
      "Facilement accessible, à 10 minutes du centre historique et des centres de congrès, à 130 mètres du Tram E, et à proximité des accès autoroutiers. Le Kyriad Grenoble Centre met à votre disposition son parking privé, sécurisé et gratuit (places limitées)."
    ],
    "nl": [
      "Gemakkelijk bereikbaar, op 10 minuten van het historische centrum en de congrescentra, op 130 meter van de Tram E, en dicht bij de snelweg. Het Kyriad Grenoble Centre beschikt over een eigen, beveiligde en gratis parkeerplaats (beperkte plaatsen)."
    ],
    "es": [
      "Fácilmente accesible, a 10 minutos del centro histórico y de los palacios de congresos, a 130 metros del tranvía E y cerca del acceso a la autopista. El Kyriad Grenoble Centre dispone de un aparcamiento privado, seguro y gratuito (plazas limitadas)."
    ]
  },
