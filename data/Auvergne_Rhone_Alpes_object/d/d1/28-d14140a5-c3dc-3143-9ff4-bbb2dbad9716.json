  "rdfs:comment": {
    "de": [
      "Sie werden die erholsame Umgebung dieses Restaurants zu schätzen wissen. Eine große Terrasse lädt Sie an schönen Tagen zum Mittagessen ein. Die Küche ist einfach und schmackhaft und wird ausschließlich aus frischen Zutaten zubereitet."
    ],
    "en": [
      "You will appreciate the restful setting of this restaurant. A large terrace will welcome you for a lunch during the nice days. The cuisine is simple and tasty and prepared only with fresh products."
    ],
    "it": [
      "Apprezzerete l'ambiente rilassante di questo ristorante. Un'ampia terrazza vi accoglierà per il pranzo durante le belle giornate. La cucina è semplice e gustosa, preparata solo con prodotti freschi."
    ],
    "fr": [
      "Vous apprécierez le cadre reposant de ce restaurant. Une grande terrasse vous accueillera le temps d’un déjeuner pendant les beaux jours. La cuisine est simple et savoureuse et uniquement préparée à partir de produits frais."
    ],
    "nl": [
      "U zult de ontspannende omgeving van dit restaurant waarderen. Een groot terras zal u verwelkomen voor de lunch tijdens de mooie dagen. De keuken is eenvoudig en smakelijk en uitsluitend bereid met verse producten."
    ],
    "es": [
      "Apreciará el ambiente relajante de este restaurante. Una gran terraza le acogerá para comer durante los días agradables. La cocina es sencilla y sabrosa y se prepara sólo con productos frescos."
    ]
  },
