  "rdfs:comment": {
    "de": [
      "Restaurant mit Blick auf den See von Annecy und die Tournette, das eine Speisekarte mit hausgemachten Produkten rund um regionale und traditionelle Aromen anbietet, aber auch andere Horizonte im Laufe der Jahreszeiten."
    ],
    "en": [
      "Restaurant with views of Lake Annecy and La Tournette offering a menu with homemade products featuring regional and traditional flavors, but also other flavors as the seasons change."
    ],
    "it": [
      "Ristorante con vista sul lago di Annecy e su La Tournette, con un menu a base di prodotti fatti in casa e sapori regionali e tradizionali, oltre a piatti provenienti da altri orizzonti al variare delle stagioni."
    ],
    "fr": [
      "Restaurant avec vue sur le lac d'Annecy et la Tournette proposant une carte avec des produits fait maison autour de saveurs régionales et traditionnelles mais aussi d'autres horizons au fil des saisons."
    ],
    "es": [
      "Restaurante con vistas al lago de Annecy y a La Tournette, con una carta en la que destacan los productos caseros y los sabores regionales y tradicionales, así como platos de otros horizontes según cambian las estaciones."
    ],
    "nl": [
      "Restaurant met uitzicht op het meer van Annecy en La Tournette, met een menu met huisgemaakte producten en regionale en traditionele smaken, maar ook gerechten van andere horizonten als de seizoenen veranderen."
    ]
  },
