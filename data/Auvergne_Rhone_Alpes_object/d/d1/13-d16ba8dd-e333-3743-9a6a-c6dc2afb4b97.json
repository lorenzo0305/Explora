  "rdfs:comment": {
    "de": [
      "Jeder Bissen ist eine perfekte Verschmelzung von Frische und delikaten Aromen. Genießen Sie eine vielfältige Auswahl an Sashimi, Sushi, Maki und anderen japanischen Köstlichkeiten, die alle aus den frischesten und hochwertigsten Zutaten hergestellt werden."
    ],
    "en": [
      "Each bite is a perfect fusion of freshness and delicate flavors. Enjoy a varied selection of sashimi, sushi, maki and other Japanese delights, all made from the freshest, highest-quality ingredients."
    ],
    "it": [
      "Ogni boccone è una fusione perfetta di freschezza e sapori delicati. Gustate una variegata selezione di sashimi, sushi, maki e altre delizie giapponesi, tutte preparate con ingredienti freschissimi e di alta qualità."
    ],
    "fr": [
      "Chaque bouchée est une fusion parfaite de fraîcheur et de saveurs délicates. Dégustez une sélection variée de sashimis, sushis, makis et autres délices japonais, tous confectionnés à partir des ingrédients les plus frais et de la plus haute qualité."
    ],
    "nl": [
      "Elk hapje is een perfecte samensmelting van versheid en delicate smaken. Geniet van een gevarieerde selectie sashimi, sushi, maki en andere Japanse lekkernijen, allemaal gemaakt van de meest verse ingrediënten van de hoogste kwaliteit."
    ],
    "es": [
      "Cada bocado es una fusión perfecta de frescura y delicados sabores. Disfrute de una variada selección de sashimi, sushi, maki y otras delicias japonesas, todas ellas elaboradas con los ingredientes más frescos y de mayor calidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Oky Sushi"
    ]
  },
