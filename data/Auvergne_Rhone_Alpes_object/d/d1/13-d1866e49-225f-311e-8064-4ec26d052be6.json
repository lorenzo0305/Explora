  "rdfs:comment": {
    "de": [
      "Das Nahversorgungsschwimmbad im Norden der Metropolregion, ideal zum Schwimmen in Ruhe, zum Lernen von klein auf, für Vereine und zur Entspannung mit der Familie."
    ],
    "en": [
      "The local pool in the north of the Metropole, ideal for quiet swimming, learning from an early age, associations and family relaxation."
    ],
    "it": [
      "La piscina locale a nord del Metropole, ideale per nuotare in tranquillità, per imparare fin da piccoli, per le associazioni e per rilassarsi con la famiglia."
    ],
    "fr": [
      "La piscine de proximité du nord de la Métropole, idéale pour nager au calme, l’apprentissage des le plus jeune âge, les associations et la détente en famille."
    ],
    "es": [
      "La piscina local en el norte del Metropole, ideal para nadar con tranquilidad, para aprender desde pequeños, para asociaciones y para relajarse en familia."
    ],
