  "rdfs:comment": {
    "de": [
      "Das Holidays Bowling ist ein Ort der Freizeitgestaltung und Entspannung mit der Familie oder mit Freunden. Täglich von 16H bis 2H morgens geöffnet ( 14H bei schlechtem Wetter )."
    ],
    "en": [
      "Le Holidays Bowling is a place for leisure and relaxation with family and/or friends. Open daily from 14:00 to 02:00."
    ],
    "it": [
      "Il bowling Holidays è un luogo dove rilassarsi e divertirsi con la famiglia e gli amici. Aperto tutti i giorni dalle 16:00 alle 2:00 (14:00 in caso di maltempo)"
    ],
    "fr": [
      "Le Holidays bowling est un espace de loisirs et de détente en famille ou entre amis. Ouvert tous les jours de 16H à 2H du matin. ( 14H en cas de mauvais temps )"
    ],
    "es": [
      "La bolera Holidays es un lugar para relajarse y disfrutar con la familia y los amigos. Abierto todos los días de 16:00 a 2:00 (14:00 con mal tiempo)"
    ],
    "nl": [
      "De Holidays bowling is een ruimte voor vrije tijd en ontspanning met familie of vrienden. Open elke dag van 14 u tot 2 uur 's morgens."
    ]
