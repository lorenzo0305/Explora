  "rdfs:comment": {
    "de": [
      "\"L'Enduro Folie's\" ist eine blaue Enduro-Strecke von 17,8 Kilometern und über 1500 m negativen Höhenunterschied vom Gipfel des TC de Planchamp! Single spielerisch und abwechslungsreich bis in den Talboden."
    ],
    "en": [
      "\"L'Enduro Folie's\" is a 17.8 kilometer blue enduro route with over 1500 m of negative altitude difference from the top of the TC de Planchamp! A fun and varied single track down to the valley floor."
    ],
    "it": [
      "l'\"Enduro Folie's\" è un percorso enduro blu di 17,8 chilometri con oltre 1.500 metri di salita e discesa dalla cima del TC de Planchamp! Un single divertente e vario fino al fondovalle."
    ],
    "fr": [
      "\"L'Enduro Folie's\" est un itinéraire enduro bleu de 17,8 kilomètres et plus de 1500 m de dénivelé négatif depuis le sommet de la TC de Planchamp  ! Single ludique et varié jusqu'en bas de vallée."
    ],
    "nl": [
      "de \"Enduro Folie's\" is een 17,8 kilometer lange blauwe enduro route met meer dan 1.500 meter klimmen en dalen vanaf de top van de TC de Planchamp! Een leuke en afwisselende single naar de bodem van het dal."
    ],
    "es": [
      "¡El \"Enduro Folie's\" es una ruta de enduro azul de 17,8 kilómetros con más de 1.500 metros de ascenso y descenso desde la cima del TC de Planchamp! Un single divertido y variado hasta el fondo del valle."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours VTT enduro \"L'Enduro Folie's\""
    ]
  },
