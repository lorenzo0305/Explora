  "rdfs:comment": {
    "de": [
      "Lust auf ein köstliches italienisches Essen? Dann sind Sie hier an der richtigen Adresse. Sie können davon träumen, an der römischen Straße La Via Emilia zu stehen und die guten Sachen aus der Region Emilia-Romagna zu probieren."
    ],
    "en": [
      "Fancy a delicious Italian meal? You've come to the right place. You can dream of being on the Roman road La Via Emilia and tasting the good things of the Emilia-Romagna region."
    ],
    "it": [
      "Avete voglia di un delizioso pasto italiano? Siete nel posto giusto. Potete sognare di essere sulla strada romana della Via Emilia e di godere delle bellezze della regione Emilia Romagna."
    ],
    "fr": [
      "Envie d’un délicieux repas italien ? Vous êtes à la bonne adresse. Vous pouvez rêver d’être au bord de la route romaine La Via Emilia et déguster les bonnes choses de la région Emilie-Romagne."
    ],
    "es": [
      "¿Te apetece una deliciosa comida italiana? Ha venido al lugar adecuado. Puede soñar con estar en la calzada romana La Via Emilia y degustar lo bueno de la región de Emilia-Romaña."
    ],
    "nl": [
      "Zin in een heerlijke Italiaanse maaltijd? Je bent aan het juiste adres. U kunt ervan dromen op de Romeinse weg La Via Emilia te zijn en te genieten van het goede van de regio Emilia Romagna."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Via Emilia"
    ]
  },
