  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Dorfes, das die Geschmacksknospen empfängt, um moderne, hausgemachte Gerichte mit frischen Zutaten zu genießen. Eine moderne, schlichte Dekoration und eine große Außenterrasse sorgen für das Vergnügen der Urlauber."
    ],
    "en": [
      "Restaurant located in the heart of the village that welcomes the taste buds to enjoy modern dishes, home-made and with fresh products. A modern and refined decoration, and a large outdoor terrace for the pleasure of holidaymakers."
    ],
    "it": [
      "Ristorante situato nel cuore del villaggio che accoglie le vostre papille gustative per assaporare piatti moderni e fatti in casa con prodotti freschi. Una decorazione moderna e ordinata e un'ampia terrazza esterna per il massimo piacere dei vacanzieri."
    ],
    "fr": [
      "Restaurant situé en plein coeur du village qui accueille les papilles pour déguster des plats modernes, faits maison et avec des produits frais. Une décoration moderne et épurée, et une grande terrasse extérieure pour le plus grand plaisir des vacanciers."
    ],
    "es": [
      "Restaurante situado en el corazón del pueblo que da la bienvenida a su paladar para disfrutar de platos modernos y caseros elaborados con productos frescos. Una decoración moderna y desenfadada, y una gran terraza exterior para el mayor placer de los veraneantes."
    ],
    "nl": [
      "Restaurant gelegen in het hart van het dorp dat de smaakpapillen verwelkomt om moderne gerechten te proeven, zelfgemaakt en met verse producten. Een moderne en verfijnde inrichting, en een groot buitenterras voor het grootste plezier van de vakantiegangers."
    ]
  },
