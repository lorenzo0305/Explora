  "rdfs:comment": {
    "de": [
      "Eine absteigende Route, die von der Route Forestière de Servagnet aus zugänglich ist und nach Méaudre hinunterführt. Eine spielerische und verspielte Route für erfahrene Radfahrer. Diese absteigende Route trifft auf die FFC-Route Nr. 21."
    ],
    "en": [
      "Downhill route accessible from the Route Forestière de Servagnet and descending to Méaudre. A playful route for experienced riders. This downhill route joins FFC circuit no. 21."
    ],
    "it": [
      "Percorso in discesa accessibile dalla Route Forestière de Servagnet e che scende a Méaudre. Un percorso divertente e impegnativo per ciclisti esperti. Questo percorso in discesa si collega al circuito FFC n. 21."
    ],
    "fr": [
      "Itinéraire descendant accessible depuis la route Forestière de Servagnet et redescendant sur Méaudre. Itinéraire ludique et joueur pour des pratiquants confirmés. Cet itinéraire descendant rejoint le circuit FFC n°21."
    ],
    "es": [
      "Ruta de descenso accesible desde la Route Forestière de Servagnet y que desciende hasta Méaudre. Una ruta divertida y desafiante para ciclistas experimentados. Esta ruta de descenso enlaza con el circuito nº 21 del FFC."
    ],
    "nl": [
      "Afdalingsroute die toegankelijk is vanaf de Route Forestière de Servagnet en afdaalt naar Méaudre. Een leuke en uitdagende route voor ervaren fietsers. Deze afdaling sluit aan op FFC-route nr. 21."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roller Coaster - Spéciale VTT Enduro - Rouge"
    ]
  },
