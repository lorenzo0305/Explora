  "rdfs:comment": {
    "de": [
      "Am Fuße der Seilbahn von Aup de Véran und des Slalomstadions von Flaine bietet Ihnen unser Chefkoch eine großzügige, originelle und ehrliche Küche aus lokalen und saisonalen Produkten zum Mittagessen an."
    ],
    "en": [
      "At the foot of the Aup de Véran cable car and the Flaine slalom stadium, our chef, offers generous, original and sincere cuisine based on local and seasonal produce, for lunch."
    ],
    "it": [
      "Ai piedi della funivia dell'Aup de Véran e dello stadio di slalom di Flaine, il nostro chef propone a pranzo una cucina generosa, originale e sincera, a base di prodotti locali e di stagione."
    ],
    "fr": [
      "Au pied de la télécabine d’Aup de Véran et du stade de slalom de Flaine, notre chef, vous propose une cuisine généreuse, originale et sincère faite de produits locaux et de saison, pour le déjeuner."
    ],
    "nl": [
      "Aan de voet van de Aup de Véran kabelbaan en het Flaine slalom stadion, onze chef-kok, een genereuze, originele en oprechte keuken op basis van lokale en seizoensgebonden producten, voor lunch."
    ],
    "es": [
      "A los pies del teleférico de Aup de Véran y del estadio de eslalon de Flaine, nuestro chef le propone una cocina de mediodía generosa, original y sincera, elaborada con productos locales de temporada."
    ]
  },
