  "rdfs:comment": {
    "de": [
      "Dorf Ouides: Steinkreuz aus dem 15. Jahrhundert stammende Kirche. Überreste des Schlosses von Agrain aus dem 13. Jahrhundert, befestigtes Haus aus dem 15. Jahrhundert in Prunet (privat)."
    ],
    "en": [
      "Village of Ouides: 15th-century stone cross. Nineteenth-century church. Remains of 13th-century Château d'Agrain, 15th-century fortified house at Prunet (private)."
    ],
    "it": [
      "Villaggio di Ouides: croce in pietra del XV secolo. Chiesa del XIX secolo. Resti del castello d'Agrain del XIII secolo, casa fortificata di Prunet del XV secolo (privata)."
    ],
    "fr": [
      "Village de Ouides : Croix en pierre du XVe siècle. Église du XIXe siècle. Vestiges du château d’Agrain du XIIIe siècle, maison forte du XVe siècle à Prunet (privée)."
    ],
    "es": [
      "Pueblo de Ouides: cruz de piedra del siglo XV. Iglesia del siglo XIX. Restos del castillo de Agrain del siglo XIII, casa fortificada de Prunet del siglo XV (privada)."
    ],
    "nl": [
      "Dorp Ouides: stenen kruis uit de 15e eeuw. Kerk uit de 19e eeuw. Overblijfselen van het kasteel van Agrain uit de 13e eeuw, versterkte woning uit de 15e eeuw in Prunet (privé)."
    ]
  },
  "rdfs:label": {
