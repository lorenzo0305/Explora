  "rdfs:comment": {
    "de": [
      "Direktverkauf nach Vereinbarung. Vom Imker in Chazelles-sur-Lyon und Umgebung gesammelter Honig. Die Bienenstöcke befinden sich in geschützten Naturgebieten auf dem Gelände eines landwirtschaftlichen Betriebs mit BIO-Label."
    ],
    "en": [
      "Direct sales by appointment. Honey harvested by the beekeeper in and around Chazelles-sur-Lyon. The apiaries are located in protected natural areas, on organic farmland."
    ],
    "it": [
      "Vendita diretta su appuntamento. Miele raccolto dall'apicoltore a Chazelles-sur-Lyon e dintorni. Gli apiari sono situati in aree naturali incontaminate su terreni agricoli biologici."
    ],
    "fr": [
      "Vente en direct sur rendez-vous. Miels récoltés par l’apiculteur à Chazelles-sur-Lyon et ses alentours. Les ruchers se situent dans des zones naturelles préservées, sur des terrains d’exploitation agricole labellisée BIO."
    ],
    "es": [
      "Venta directa con cita previa. Miel recolectada por el apicultor en Chazelles-sur-Lyon y sus alrededores. Los colmenares están situados en zonas naturales vírgenes, en tierras de cultivo ecológico."
    ],
    "nl": [
      "Directe verkoop op afspraak. Honing geoogst door de imker in Chazelles-sur-Lyon en omgeving. De bijenstallen bevinden zich in ongerepte natuurgebieden op biologische landbouwgrond."
    ]
  },
