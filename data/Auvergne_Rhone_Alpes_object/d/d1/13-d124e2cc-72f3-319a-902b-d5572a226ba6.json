  "rdfs:comment": {
    "de": [
      "Ponyclub ab 2 Jahren, vom Anfänger bis zum fortgeschrittenen Reiter. Angebotene Kurse während der Schulferien. Ausflüge zu Wettbewerben. Spaziergänge, Spiele, Wanderungen, Equifeel. Diplomierte Reitlehrer mit Erfahrung."
    ],
    "en": [
      "Pony club from 2 years old from beginner to advanced. School holiday courses.\r\nCompetition outings. Riding, games, hiking, equifeel\r\nQualified instructors with experience."
    ],
    "it": [
      "Pony club per principianti e avanzati dai 2 anni in su. Corsi disponibili durante le vacanze scolastiche. Uscite di competizione. Cavalcate, giochi, escursioni, equitazione. Istruttori qualificati ed esperti."
    ],
    "fr": [
      "Poney club à partir de 2 ans du cavalier débutant au confirmé. Stages proposés pendant les vacances scolaires. Sorties en compétition. Balades, jeux, randonnées, equifeel. Moniteurs diplômés avec expérience."
    ],
    "nl": [
      "Ponyclub voor beginners tot gevorderde ruiters vanaf 2 jaar. Cursussen beschikbaar tijdens de schoolvakanties. Competitie-uitstapjes. Ritten, spelletjes, wandelingen, equifeel. Gekwalificeerde en ervaren instructeurs."
    ],
    "es": [
      "Pony club para principiantes y jinetes avanzados a partir de 2 años. Cursos durante las vacaciones escolares. Salidas de competición. Paseos, juegos, excursiones, equifeel. Monitores cualificados y experimentados."
    ]
  },
