  "rdfs:comment": {
    "de": [
      "Mit Außenterrasse. Im Dorfzentrum, ganz in der Nähe des Museums „Retour sur le passé“ und des Lebensmittelladens „Greg et Sab“. Ausgangspunkt für zwei Wanderungen in den Sioulet-Schluchten. Zehn Autominuten von zwei Stränden am Lac des Fades entfernt."
    ],
    "en": [
      "With an outdoor terrace. In the village centre, close to the Retour sur le Passé museum and Greg et Sab grocery store. Starting point for two hikes in the Sioulet Gorges. Ten minutes by car from two beaches on Lake Fades."
    ],
    "it": [
      "Con una terrazza all'aperto. Nel centro del villaggio, vicino al museo Retour sur le passé e al negozio di alimentari Greg e Sab. Inizio di due escursioni nelle gole del Sioulet. A dieci minuti d'auto da due spiagge sul Lac des Fades."
    ],
    "fr": [
      "Avec une terrasse extérieure. Dans le centre du village, tout proche du musée Retour sur le passé et l'épicerie Greg et Sab. Départ de deux randonnées dans les gorges du Sioulet. À dix minutes en voiture de deux plages du lac des Fades."
    ],
    "nl": [
      "Met buitenterras. In het centrum van het dorp, vlakbij het museum Retour sur le passé en de kruidenierswinkel Greg en Sab. Start van twee wandelingen in de kloven van Sioulet. Op tien minuten rijden van twee stranden aan het Lac des Fades."
    ],
    "es": [
      "Con terraza exterior. En el centro del pueblo, cerca del museo Retour sur le passé y de la tienda de comestibles Greg y Sab. Inicio de dos excursiones por las gargantas del Sioulet. A 10 minutos en coche de dos playas del lago des Fades."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar et restaurant le Rochecivière"
    ]
  },
