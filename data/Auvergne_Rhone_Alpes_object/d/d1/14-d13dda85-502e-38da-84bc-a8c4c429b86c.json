  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2844e4a0-e4dc-3c56-981c-1c8695c1bd85",
      "dc:description": {
        "de": [
          "Tauchen Sie ein in die Geschichte, indem Sie das Leben der deutschen Soldaten in einer Schießbatterie, einem der Bunker der Todt-Batterie, kennen lernen.\nSecond World War Museum / Museum des Zweiten Weltkriegs / Museum van de Tweede Wereldoorlog"
        ],
        "en": [
          "Plunge into the heart of history by discovering the life of German soldiers in a firing battery, one of the bunkers of the Todt Battery.\nSecond World War Museum / Museum des Zweiten Welt Krieges / Museum van de Tweede Wereldoorlog"
        ],
        "it": [
          "Immergetevi nella storia scoprendo la vita dei soldati tedeschi in una batteria di tiro, uno dei bunker della Batteria Todt.\nMuseo della Seconda Guerra Mondiale / Museum des Zweiten Welt Krieges / Museum van de Tweede Wereldoorlog"
        ],
        "fr": [
          "Plongez au cœur de l'histoire en découvrant la vie des soldats allemands dans une batterie de tir, un des bunkers de la Batterie Todt.\nSecond World War Museum / Museum des Zweiten Welt Krieges / Museum van de Tweede Wereldoorlog"
        ],
        "es": [
          "Sumérjase en la historia descubriendo la vida de los soldados alemanes en una batería de tiro, uno de los búnkeres de la Batería Todt.\nMuseo de la Segunda Guerra Mundial / Museum des Zweiten Welt Krieges / Museum van de Tweede Wereldoorlog"
        ],
        "nl": [
          "Dompel jezelf onder in de geschiedenis door het leven van Duitse soldaten te ontdekken in een vuurbatterij, een van de bunkers van de Todt Batterij.\nTweede Wereldoorlog Museum des Zweiten Welt Krieges / Museum van de Tweede Wereldoorlog"
        ]
      },
      "@type": [
        "Description"
      ],
