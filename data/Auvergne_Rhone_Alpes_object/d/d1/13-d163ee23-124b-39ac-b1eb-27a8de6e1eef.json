  "rdfs:comment": {
    "de": [
      "Hauptprodukt: Parfum d'Adline, Clairette de Die aus 100 % Muskat, mit außergewöhnlichem Charakter und in weißen Flaschen abgefüllt. Die Ernte erfolgt von alten Rebstöcken mit sehr geringem Ertrag (einige Trauben pro Rebstock, von Hand gelesen und sortiert)."
    ],
    "en": [
      "Star product: Parfum d'Adline, Clairette de Die 100% muscat, with an exceptional character inside a white bottle. The harvest is done on old vines with low yield (some clusters per plant, harvested and selected by hand)."
    ],
    "it": [
      "Prodotto di punta: Parfum d'Adline, un 100% Muscat Clairette de Die di carattere eccezionale, presentato in bottiglia bianca. Le uve sono raccolte da vecchie vigne con rese molto basse (pochi grappoli per vite, raccolti e selezionati a mano)."
    ],
    "fr": [
      "Produit phare : Parfum d'Adline, Clairette de Die 100% muscat, au caractère exceptionnel et présentée en bouteille blanche. La récolte se fait sur des vieilles vignes à très faible rendement (quelques grappes par cep, vendangées et triées à la main)."
    ],
    "nl": [
      "Vlaggenschip product: Parfum d'Adline, een 100% Muscat Clairette de Die met een uitzonderlijk karakter, gepresenteerd in een witte fles. De druiven worden geoogst van oude wijnstokken met een zeer lage opbrengst (slechts enkele trossen per wijnstok, met de hand geoogst en gesorteerd)."
    ],
    "es": [
      "Producto estrella: Parfum d'Adline, un 100% Muscat Clairette de Die de carácter excepcional, presentado en botella blanca. Las uvas proceden de viñas viejas con rendimientos muy bajos (sólo unos pocos racimos por cepa, vendimiados y seleccionados a mano)."
    ]
  },
