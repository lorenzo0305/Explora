  "rdfs:comment": {
    "de": [
      "Das Restaurant le zénith de mon père im Herzen des historischen Stadtzentrums der Stadt Clermont-Ferrand bietet Ihnen eine hochwertige Küche in einem Bistro-Rahmen und einer freundlichen Atmosphäre."
    ],
    "en": [
      "Located in the heart of Clermont-Ferrand's historic city center, le zénith de mon père restaurant offers quality cuisine in a bistro setting and friendly atmosphere."
    ],
    "it": [
      "Il ristorante \"le zénith de mon père\", situato nel cuore del centro storico di Clermont-Ferrand, offre una cucina di qualità in un ambiente bistrot e un'atmosfera amichevole."
    ],
    "fr": [
      "Le restaurant le zénith de mon père situé au cœur du centre ville historique de la ville de Clermont-Ferrand vous propose une cuisine de qualité dans un cadre bistrot et une ambiance conviviale."
    ],
    "nl": [
      "Het restaurant \"le zénith de mon père\" gelegen in het hart van het historische stadscentrum van Clermont-Ferrand biedt u een kwaliteitskeuken in een bistrosfeer en een gezellige sfeer."
    ],
    "es": [
      "El restaurante \"le zénith de mon père\", situado en el corazón del centro histórico de Clermont-Ferrand, ofrece una cocina de calidad en un entorno de bistró y un ambiente acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le zénith de mon père"
    ]
  },
