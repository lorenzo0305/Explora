  "rdfs:comment": {
    "de": [
      "Tanken Sie neue Energie mit Aventure Sensation und erleben Sie intensive Momente beim Canyoning, Rafting oder auf der Via Ferrata. Sie werden mit Denis, einem Bergführer, außergewöhnliche Naturgebiete entdecken."
    ],
    "en": [
      "Experience intense moments in canyoning, rafting or via Ferrata. You will discover exceptional natural sites with Denis, mountain guide."
    ],
    "it": [
      "Ricaricatevi con Aventure sensation e provate l'emozione del canyoning, del rafting o della via ferrata. Scoprite siti naturali eccezionali con Denis, una guida alpina."
    ],
    "fr": [
      "Ressourcez-vous avec Aventure sensation et vivez des moments intenses en canyoning, rafting ou via Ferrata. Vous découvrirez des sites naturels exceptionnels avec Denis, guide de haute montagne."
    ],
    "es": [
      "Recargue las pilas con Aventure sensation y viva la emoción del barranquismo, el rafting o la vía Ferrata. Descubre parajes naturales excepcionales con Denis, guía de montaña."
    ],
    "nl": [
      "Doe nieuwe energie op met Aventure sensation en beleef de sensatie van canyoning, rafting of via Ferrata. Ontdek uitzonderlijke natuurgebieden met Denis, een berggids."
    ]
  },
