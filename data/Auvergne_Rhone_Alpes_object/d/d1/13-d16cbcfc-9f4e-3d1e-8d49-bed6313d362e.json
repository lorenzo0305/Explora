  "rdfs:comment": {
    "de": [
      "In einer ländlichen Umgebung bietet Ihnen das Pado eine Vielzahl von Variationen (Tagesgerichte, Burger, Aperitifbretter, Fruchtsäfte, Eis), wobei lokale und/oder biologische Produkte bevorzugt werden."
    ],
    "en": [
      "In a rural setting, Le Pado offers a wide range of dishes (daily specials, burgers, aperitif platters, fruit juices, ice creams), all using local and/or organic produce."
    ],
    "it": [
      "Immerso nella campagna, Le Pado offre una vasta gamma di piatti (specialità del giorno, hamburger, aperitivi, succhi di frutta, gelati), tutti a base di prodotti locali e/o biologici."
    ],
    "fr": [
      "Dans un cade champêtre, le Pado vous propose une multitude de déclinaisons (plats du jour, burgers, planches apéro, jus de fruits, glaces), le tout en privilégiant des produits locaux et/ou bio."
    ],
    "nl": [
      "Le Pado ligt op het platteland en biedt een breed scala aan gerechten (dagschotels, hamburgers, aperitiefschotels, vruchtensappen, ijs), allemaal met lokale en/of biologische producten."
    ],
    "es": [
      "En plena naturaleza, Le Pado ofrece una amplia gama de platos (platos del día, hamburguesas, aperitivos, zumos de frutas, helados), elaborados con productos locales y/o ecológicos."
    ]
  },
  "rdfs:label": {
    "de": [
      "Le Pado, Restaurant im Freien"
    ],
    "en": [
      "Le Pado, open-air restaurant"
    ],
    "fr": [
      "Le Pado, restaurant de plein air"
    ]
  },
