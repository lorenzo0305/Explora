  "rdfs:comment": {
    "de": [
      "Mythischer Lauf/ einzige französische Etappe des Berglauf-Weltcups.\r\nNeue Ausgabe, neue Strecke.\r\n\r\nAnmeldung offen\r\n\r\nStart: Parc Thermal du Fayet\r\nZiel: Bellevue\r\nDistanz: 19,5 KM\r\nHöhenunterschied : 2000 D+"
    ],
    "en": [
      "19.5 KM for 2000 D +\r\nA very athletic race crossing the alpine floors to arrive at the gateway to mountaineering Mont-Blanc\r\n\r\nFollow the event's news on the @monteeduniddaigle Facebook page.\r\nRegistration are open"
    ],
    "it": [
      "Ai piedi del Monte Bianco\r\nDa 580m di altitudine in valle...A 2407m alle porte dell’Alta Montagna...L’avventura del Nid d'Aigle vi aspetta, correndo o camminando."
    ],
    "fr": [
      "Course mythique/ seule étape française de coupe du monde de course en montagne.\r\nNouvelle édition, nouveau parcours.\r\n\r\nInscription ouverte\r\n\r\nDépart : Parc Thermal du Fayet \r\nArrivée : Bellevue \r\nDistance : 19,5 KM\r\nDénivelé : 2000 D+"
    ],
    "nl": [
      "Legendarische race/ Frankrijks enige wereldbekerwedstrijd berglopen.\r\nNieuwe editie, nieuw parcours.\r\n\r\nInschrijving geopend\r\n\r\nStart : Thermalpark du Fayet\r\nFinish : Bellevue\r\nAfstand : 19,5 KM\r\nHoogteverschil : 2000 D+"
    ],
    "es": [
      "Carrera legendaria/única etapa francesa de la Copa del Mundo de Carreras por Montaña.\r\nNueva edición, nuevo recorrido.\r\n\r\nInscripciones abiertas\r\n\r\nSalida : Parc Thermal du Fayet\r\nLlegada : Bellevue\r\nDistancia : 19,5 KM\r\nDesnivel : 2000 D+"
    ]
  },
