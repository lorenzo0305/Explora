    "de": [
      "Gut gelegenes Restaurant am Eingang des historischen Zentrums.\r\nRegionale Spezialitäten, Trüffel, Menü und Tagesgericht. Küche, die mit frischen lokalen Produkten arbeitet."
    ],
    "en": [
      "Restaurant well located, at the entrance of the historical center.\r\nRegional specialties, truffade, menu and dish of the day. Cuisine made with fresh local products."
    ],
    "it": [
      "Ristorante ben situato all'ingresso del centro storico.\r\nSpecialità regionali, tartufi, menu e piatto del giorno. Cucina a base di prodotti freschi locali."
    ],
    "fr": [
      "Restaurant bien situé, à l'entrée du centre historique.\r\nSpécialités régionales, truffade, menu et plat du jour. Cuisine travaillée avec des produits frais locaux."
    ],
    "es": [
      "Restaurante bien situado a la entrada del centro histórico.\r\nEspecialidades regionales, trufada, menú y plato del día. Cocina elaborada con productos frescos de la zona."
    ],
    "nl": [
      "Goed gelegen restaurant bij de ingang van het historische centrum.\r\nRegionale specialiteiten, truffel, menu en dagschotel. Keuken gemaakt met verse lokale producten."
    ]
