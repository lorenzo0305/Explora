  "rdfs:comment": {
    "de": [
      "Blaue, endurotypische Route, die die DH von Marsupilami mit dem unteren Teil der Station Arc 1800 verbindet.\r\nAngenehmer Waldweg, umgeben von den berühmten, für Arc 1600 typischen spitzen Chalets."
    ],
    "en": [
      "Entrance route witch join the DH route Marsupilami to the Arc 1800.\r\nPleasant path in the forest surrounded by the famous pointed chalets typical of Arc 1600."
    ],
    "it": [
      "Un percorso blu in stile enduro che collega la Marsupilami DH alla parte inferiore della stazione Arc 1800.\r\nUn piacevole percorso nel bosco circondato dai famosi chalet a punta tipici di Arc 1600."
    ],
    "fr": [
      "Itinéraire bleu typé enduro qui relie la DH de Marsupilami au bas de la station d’Arc 1800.\r\nAgréable chemin en forêt cerné par les fameux chalets pointus typiques d’Arc 1600."
    ],
    "es": [
      "Una ruta azul de estilo enduro que une el DH de Marsupilami con la parte baja de la estación de Arc 1800.\r\nUna agradable pista forestal rodeada de los famosos chalés puntiagudos típicos de Arc 1600."
    ],
    "nl": [
      "Een blauwe route in enduro-stijl die de Marsupilami DH verbindt met de onderkant van het Arc 1800 resort.\r\nEen aangenaam bospad omringd door de beroemde puntige chalets die typisch zijn voor Arc 1600."
    ]
  },
  "rdfs:label": {
    "en": [
      "Golf - Enduro"
    ],
    "fr": [
      "Golf - Enduro"
    ]
  },
