  "rdfs:comment": {
    "de": [
      "6 km von La Roche entfernt, in der Gemeinde Cornier am Ort Châtelet, lässt der Müller noch immer jeden Frühling das Rad auf den Mühlsteinen drehen, um ein schönes goldenes Walnussöl herzustellen."
    ],
    "en": [
      "6 km from La Roche, in the commune of Cornier at a place called Le Châtelet, the miller still turns the wheel on the millstones every spring to produce a beautiful golden walnut oil."
    ],
    "it": [
      "A 6 km da La Roche, nel comune di Cornier, in una località chiamata Le Châtelet, il mugnaio fa ancora girare la ruota sulle macine ogni primavera per produrre un bellissimo olio di noce dorato."
    ],
    "fr": [
      "A 6 km de La Roche, sur la commune de Cornier au lieu-dit du Châtelet, le meunier fait encore chaque printemps tourner la roue sur les meules pour produire une belle huile de noix dorée."
    ],
    "nl": [
      "Op 6 km van La Roche, in de gemeente Cornier op een plek die Le Châtelet heet, draait de molenaar nog steeds elk voorjaar het rad op de molenstenen om een prachtige gouden walnootolie te produceren."
    ],
    "es": [
      "A 6 km de La Roche, en el municipio de Cornier, en un lugar llamado Châtelet, el molinero sigue haciendo girar la rueda de los molinos cada primavera para producir un hermoso aceite de nuez dorado."
    ]
  },
  "rdfs:label": {
