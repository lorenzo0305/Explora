  "rdfs:comment": {
    "de": [
      "Französische Skischule am Fuße der Pisten von Sommand gelegen.\r\n\r\nDie Skilehrer der ESF bieten Ihnen Gruppen- und Privatkurse für Ski und andere Sportarten an."
    ],
    "en": [
      "Collective lessons for adults, collective lessons for children, Piou Piou from 3 to 5 years old, collectives snowboard and Freestyle Ski lessons . Private lessons of biathlon and Alpine skiing with video correction. \r\nSnowshoeing, ski touring and skiing for disabled peaople."
    ],
    "it": [
      "Scuola di sci francese situata ai piedi delle piste di Sommand.\r\n\r\nI maestri di sci di ESF offrono lezioni di gruppo e private di sci e di altri sport correlati."
    ],
    "fr": [
      "Ecole du Ski Français située au pied des pistes de Sommand.\r\n\r\nLes moniteurs de ski de L’ESF vous proposent des cours de ski, et autres glisses assimilées, collectifs et particuliers ."
    ],
    "nl": [
      "Franse skischool aan de voet van de pistes van Sommand.\r\n\r\nDe ESF-skileraren bieden ski- en snowboardlessen in groepsverband en privélessen."
    ],
    "es": [
      "Escuela de esquí francesa situada a pie de las pistas de Sommand.\r\n\r\nLos monitores de esquí del FSE ofrecen clases grupales y privadas de esquí y otros deportes relacionados."
    ]
  },
