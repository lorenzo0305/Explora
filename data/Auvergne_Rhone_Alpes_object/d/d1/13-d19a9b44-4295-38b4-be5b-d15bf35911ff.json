  "rdfs:comment": {
    "de": [
      "Isabelle, Designerin für Strohmarketerie in Crémieu, arbeitet mit Materialien wie Roggenstroh, Holz und Metall, um einzigartige Stücke zu schaffen. Entdecken Sie ihre Boutique und lassen Sie sich in den Workshops, die zweimal im Monat angeboten werden, in diese Kunst einführen."
    ],
    "en": [
      "Isabelle, a straw marquetry designer based in Crémieu, works with materials such as rye straw, wood and metal to create unique pieces. Discover her shop and learn about this art form at the workshops she offers twice a month."
    ],
    "it": [
      "Isabelle, designer di intarsi in paglia con sede a Crémieu, lavora con materiali come la paglia di segale, il legno e il metallo per creare pezzi unici. Scoprite il suo negozio e cimentatevi in questa forma d'arte durante i laboratori che si tengono due volte al mese."
    ],
    "fr": [
      "Isabelle, créatrice en marqueterie de paille à Crémieu, travaille des matériaux comme la paille de seigle, le bois et le métal pour créer des pièces uniques. Découvrez sa boutique et initiez-vous à cet art lors des ateliers proposés 2 fois par mois."
    ],
    "nl": [
      "Isabelle, een ontwerpster van inlegwerk met stro, gevestigd in Crémieu, werkt met materialen zoals roggestro, hout en metaal om unieke stukken te creëren. Ontdek haar winkel en probeer deze kunstvorm zelf uit tijdens workshops die twee keer per maand worden gehouden."
    ],
    "es": [
      "Isabelle, diseñadora de marquetería de paja afincada en Crémieu, trabaja materiales como la paja de centeno, la madera y el metal para crear piezas únicas. Descubra su tienda y pruebe este arte en los talleres que se organizan dos veces al mes."
    ]
  },
