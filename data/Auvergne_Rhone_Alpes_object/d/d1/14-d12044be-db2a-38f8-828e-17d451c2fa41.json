      "@id": "https://data.datatourisme.fr/96c906f2-d2ee-345f-a822-9e0732377bc1",
      "dc:description": {
        "de": [
          "Die Schule Jean Moulin in Etaples-sur-Mer organisiert das traditionelle Lottospiel.\nVerbringen Sie einen Moment mit der Familie oder mit Freunden und versuchen Sie, schöne Preise zu gewinnen."
        ],
        "en": [
          "The Jean Moulin school in Etaples-sur-mer is organizing its traditional lotto game.\nCome along with family and friends for a chance to win some great prizes."
        ],
        "it": [
          "La scuola Jean Moulin di Etaples-sur-mer organizza la tradizionale tombola.\nVenite con la vostra famiglia o i vostri amici per avere la possibilità di vincere fantastici premi."
        ],
        "fr": [
          "L'école Jean Moulin d'Etaples-sur-mer organise le traditionnel jeu de loto.\nVenez passer un moment en famille ou entre amis pour tenter de remporter de beaux lots."
        ],
        "es": [
          "La escuela Jean Moulin de Etaples-sur-mer organiza su tradicional partida de bingo.\nVen con tu familia o amigos y podrás ganar fantásticos premios."
        ],
        "nl": [
          "De Jean Moulin school in Etaples-sur-mer organiseert haar traditionele bingospel.\nKom langs met je familie of vrienden en maak kans op mooie prijzen."
        ]
      },
