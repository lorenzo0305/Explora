  "rdfs:comment": {
    "de": [
      "Als Einzelmenü bieten wir Ihnen unsere aktuellen Rezepte an, bei denen Bio- und lokale Produkte eine wichtige Rolle spielen. Sie werden eine gesunde und leckere Küche genießen, die besonders für Sportler geeignet ist."
    ],
    "en": [
      "Zecamp's dietetic cuisine is above all geared towards sportsmen and women who want to eat as much as they want and simply. To eat or to hydrate yourself, come and spend a pleasant moment in a magnificent setting."
    ],
    "it": [
      "In un formato a menu unico, vi proponiamo le nostre ricette del momento, che privilegiano i prodotti biologici e locali. Potrete gustare una cucina sana e gustosa, particolarmente adatta agli sportivi."
    ],
    "fr": [
      "En formule menu unique, nous vous proposons nos recettes du moment, qui font la part belle aux produits bio et locaux. Vous apprécierez une cuisine saine et gourmande, particulièrement adaptée aux sportifs."
    ],
    "nl": [
      "In één menu bieden we je onze recepten van het moment, waarin biologische en lokale producten centraal staan. Je zult genieten van een gezonde, smakelijke keuken die bijzonder geschikt is voor sportliefhebbers."
    ],
    "es": [
      "En un formato de menú único, le ofrecemos nuestras recetas del momento, en las que priman los productos ecológicos y locales. Disfrutará de una cocina sana y sabrosa, especialmente indicada para los amantes del deporte."
    ]
  },
  "rdfs:label": {
