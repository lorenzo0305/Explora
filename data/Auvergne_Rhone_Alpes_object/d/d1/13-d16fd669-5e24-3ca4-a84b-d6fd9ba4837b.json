  "rdfs:comment": {
    "de": [
      "Diese Route ist in der Nähe des Skigebiets von Cordon markiert. Sie befindet sich auf 1550 m oberhalb von Cordon, am Fuße des Tête du Planet. Ein ziemlich direkter und freier Aufstieg, Sonne und Aussicht als Bonus."
    ],
    "en": [
      "This route is signposted close to the Cordon ski area, at 1550 m on the Cordon heights, at the foot of the Tête du Planet. A fairly straightforward, unobstructed ascent, with sunshine and views to boot."
    ],
    "it": [
      "Questo percorso è segnalato nei pressi dell'area sciistica di Cordon, a 1550 metri sulle alture di Cordon, ai piedi della Tête du Planet. La salita è abbastanza semplice e chiara, con sole e panorama."
    ],
    "fr": [
      "Cet itinéraire est balisé à proximité du domaine skiable de Cordon, à  1550 mètres sur les hauteurs de Cordon, au pied de la Tête du Planet. Une montée assez directe et dégagée, soleil et vue en prime."
    ],
    "es": [
      "Esta ruta está señalizada cerca de la estación de esquí de Cordon, a 1.550 metros en las alturas de Cordon, al pie de la Tête du Planet. La subida es bastante sencilla y despejada, con sol y vistas."
    ],
    "nl": [
      "Deze route staat aangegeven bij het skigebied van Cordon, op 1550 meter hoogte op de hoogten van Cordon, aan de voet van de Tête du Planet. De klim is vrij eenvoudig en helder, met zon en uitzichten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski touring itinerary - Le Chanté"
    ],
    "it": [
      "Percorso di sci alpinismo - Le Chanté"
    ],
    "fr": [
      "Itinéraire ski de randonnée - Le Chanté"
    ]
  },
