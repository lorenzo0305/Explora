  "rdfs:comment": {
    "de": [
      "Der Zufall führte Stephan Eicher vor das Théâtre du Rond-Point. Er wollte es betreten und die Menschen kennenlernen, die dort arbeiten."
    ],
    "en": [
      "Chance led Stephan Eicher to the Théâtre du Rond-Point. He felt compelled to enter and meet the people who work there."
    ],
    "it": [
      "Per caso, Stephan Eicher si è imbattuto nel Théâtre du Rond-Point. Si è sentito in dovere di entrare e incontrare le persone che vi lavorano."
    ],
    "fr": [
      "Le hasard a conduit Stephan Eicher devant le Théâtre du Rond-Point. Il a éprouvé le désir d’y entrer et de faire connaissance avec celles et ceux qui y travaillent."
    ],
    "es": [
      "Stephan Eicher se encontró por casualidad con el Théâtre du Rond-Point. Se sintió obligado a entrar y conocer a las personas que trabajan allí."
    ],
    "nl": [
      "Bij toeval stuitte Stephan Eicher op het Théâtre du Rond-Point. Hij voelde zich geroepen om naar binnen te gaan en de mensen die er werken te ontmoeten."
    ]
  },
  "rdfs:label": {
