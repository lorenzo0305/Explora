  "rdfs:comment": {
    "de": [
      "Marlou Bleu, eine Malerin, die sich für Farben und die Natur begeistert, setzt ihr Wissen in \"Ma Fresque Murale\" um."
    ],
    "en": [
      "Marlou Bleu, a painter with a passion for color and nature, puts her skills to work at Ma Fresque Murale."
    ],
    "it": [
      "Marlou Bleu, pittrice con la passione per il colore e la natura, utilizza le sue capacità per creare Ma Fresque Murale."
    ],
    "fr": [
      "Marlou Bleu, artiste peintre, passionnée par les couleurs et la Nature, elle mets en oeuvre son savoir-faire au sein de Ma Fresque Murale."
    ],
    "es": [
      "Marlou Bleu, pintora apasionada por el color y la naturaleza, utiliza sus habilidades para crear Ma Fresque Murale."
    ],
