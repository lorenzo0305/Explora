  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fc79987b-aea1-3eb9-ab04-da66b58f8f36",
      "dc:description": {
        "de": [
          "Ganz in der Nähe des Schlosses von Chantilly, gegenüber den Grandes Écuries, l'Étrier bietet Ihnen den ganzen Tag über die Möglichkeit, einen geselligen und herzlichen Moment zu verbringen.\nService rund um die Uhr: Brasserie, Tabakwaren, Bar, warme und kalte Sandwiches.\nSpezielle Menüs für Gruppen auf Reservierung."
        ],
        "en": [
          "Located close to the Château de Chantilly, opposite the Grandes Écuries, l?Étrier invites you to share a warm and friendly moment throughout the day.\nServices at all hours: Brasserie, Tabac, Bar, hot and cold sandwich shop.\nSpecial menus for groups on reservation."
        ],
        "it": [
          "Situato vicino al Castello di Chantilly, di fronte alle Grandes Écuries, l'Étrier vi invita a condividere un momento di calore e amicizia durante tutta la giornata.\nServizi in ogni momento: Brasserie, Tabac, Bar, paninoteca calda e fredda.\nMenù speciali per gruppi su prenotazione."
        ],
        "fr": [
          "Situé tout près du château de Chantilly, face aux Grandes Écuries, l’Étrier vous propose de partager un moment convivial et chaleureux tout au long de la journée. \nServices à toutes heures : Brasserie, Tabac, Bar, sandwicherie chaud ou froid. \nMenus spéciaux pour groupes sur réservation."
        ],
        "es": [
          "Situado cerca del Château de Chantilly, frente a las Grandes Écuries, l'Étrier le invita a compartir un momento cálido y acogedor durante todo el día.\nServicios a todas horas: Brasserie, Tabac, Bar, tienda de bocadillos fríos y calientes.\nMenús especiales para grupos previa concertación."
        ],
        "nl": [
          "Dichtbij het Château de Chantilly, tegenover de Grandes Écuries, nodigt l'Étrier u uit voor een warm en gezellig moment de hele dag door.\nDiensten: Brasserie, Tabac, Bar, warme en koude broodjeszaak.\nSpeciale menu's voor groepen op afspraak."
        ]
      },
      "@type": [
        "Description"
      ],
