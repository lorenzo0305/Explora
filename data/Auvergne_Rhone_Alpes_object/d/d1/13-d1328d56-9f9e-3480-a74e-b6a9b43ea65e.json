  "rdfs:comment": {
    "de": [
      "4 km von der A75 Ausfahrt 22 und 7 km von Brioude entfernt liegt das Hôtel-Restaurant & Spa Le Baudière im Herzen der Auvergne zwischen den Bergen Cantal und Livradois, in der Nähe der AOC-Käse-Straße und der Via Arverna. Raffinierte französische Küche."
    ],
    "en": [
      "4 km from A75 exit 22 and 7 km from Brioude, Hôtel-Restaurant & Spa Le Baudière is located in the heart of the Auvergne between the Monts du Cantal and Livradois, close to the AOC cheese route and via Arverna. Refined French cuisine."
    ],
    "it": [
      "A 4 km dall'uscita 22 della A75 e a 7 km da Brioude, l'Hôtel-Restaurant & Spa Le Baudière si trova nel cuore dell'Alvernia, tra i Monts du Cantal e Livradois, vicino alla strada del formaggio AOC e alla Via Arverna. Cucina francese raffinata."
    ],
    "fr": [
      "A 4 km de l'A75 sortie 22 et 7 km de Brioude, l'Hôtel-Restaurant & Spa Le Baudière est situé au cœur de l’Auvergne entre les Monts du Cantal et du Livradois, à proximité de la route des fromages AOC et de la via Arverna. Cuisine française et raffinée."
    ],
    "nl": [
      "Op 4 km van de A75 afslag 22 en 7 km van Brioude ligt Hôtel-Restaurant & Spa Le Baudière in het hart van de Auvergne tussen de Monts du Cantal en Livradois, dicht bij de AOC kaasroute en de Via Arverna. Verfijnde Franse keuken."
    ],
    "es": [
      "A 4 km de la salida 22 de la A75 y a 7 km de Brioude, el Hôtel-Restaurant & Spa Le Baudière está situado en el corazón de Auvernia, entre los Montes del Cantal y Livradois, cerca de la ruta del queso AOC y de la Vía Arverna. Cocina francesa refinada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel et SPA Le Baudière"
    ]
  },
