  "rdfs:comment": {
    "de": [
      "Eine Rodelbahn, die sich gegenüber dem Fremdenverkehrsamt hinter den Kinderspielen befindet.\r\nUnter der Verantwortung der Eltern oder Begleitpersonen.\r\nGeöffnet unter Vorbehalt der Schneebedingungen."
    ],
    "en": [
      "A toboggan run located in front of the Tourist Office, behind the children’s playground.\r\nUnder the responsibility of the parents or accompanying persons.\r\nOpen subject to snow conditions."
    ],
    "it": [
      "Pista per slittini di fronte all'Ufficio del Turismo, dietro l'area giochi per bambini.\r\nSotto la responsabilità dei genitori o degli accompagnatori.\r\nAperta in base alle condizioni di innevamento."
    ],
    "fr": [
      "Une piste de luge située en face de l'Office de Tourisme, derrière les jeux pour enfants.\r\nSous la responsabilité des parents ou accompagnants.\r\nOuvert sous réserve des conditions de neige."
    ],
    "es": [
      "Pista de trineo frente a la Oficina de Turismo, detrás de la zona de juegos infantiles.\r\nBajo la responsabilidad de los padres o cuidadores.\r\nAbierto en función de las condiciones de la nieve."
    ],
    "nl": [
      "Een rodelbaan voor het VVV-kantoor, achter de kinderspeelplaats.\r\nOnder verantwoordelijkheid van de ouders of begeleiders.\r\nOpen onder sneeuwomstandigheden."
    ]
  },
  "rdfs:label": {
