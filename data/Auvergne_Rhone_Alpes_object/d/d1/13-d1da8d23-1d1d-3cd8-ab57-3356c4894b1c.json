  "rdfs:comment": {
    "de": [
      "Erleben Sie eine aufregende Abfahrt mit dem Schienenschlitten in Alpe d'Huez!\r\nIm Sommer wie im Winter können Sie sich auf ein spannendes Abenteuer zwischen Kurven, Buckeln und Tunneln begeben!"
    ],
    "en": [
      "Experience the thrill of rail tobogganing at Alpe d'Huez!\r\nSummer and winter alike, embark on a thrilling adventure of bends, bumps and tunnels!"
    ],
    "it": [
      "Provate un'emozionante discesa con lo slittino su rotaia dell'Alpe d'Huez!\r\nSia d'estate che d'inverno, lanciatevi in un'emozionante avventura di curve, dossi e tunnel!"
    ],
    "fr": [
      "Vivez une descente riche en sensations avec la luge sur rail de l’Alpe d’Huez !\r\nÉté comme hiver, embarquez pour une aventure palpitante entre virages, bosses et tunnels !"
    ],
    "es": [
      "Viva un emocionante descenso en el trineo sobre raíles de Alpe d'Huez\r\nTanto en verano como en invierno, embárquese en una emocionante aventura de curvas, baches y túneles"
    ],
    "nl": [
      "Beleef een spannende afdaling op de railrodelbaan van Alpe d'Huez!\r\nZowel in de zomer als in de winter beleef je een spannend avontuur vol bochten, hobbels en tunnels!"
    ]
  },
  "rdfs:label": {
    "en": [
      "sledge on rail"
    ],
    "fr": [
      "Luge sur rail"
    ],
    "nl": [
      "slee op rail"
    ]
  },
