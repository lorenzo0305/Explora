  "rdfs:comment": {
    "de": [
      "Im Park Accro'Sioule Kids finden Sie: 9 Rätsel, die es zu lösen gilt, um geheime Codes zu finden. Spiele aus Holz, die auf handwerkliche Weise hergestellt werden. Und natürlich eine mit Wundern gefüllte Schatztruhe!"
    ],
    "en": [
      "At the Accro'Sioule Kids park: 9 riddles to solve to find secret codes. Handcrafted wooden games. And, of course, a treasure chest full of wonders!"
    ],
    "it": [
      "Su Accro'Sioule Kids troverete: 9 indovinelli da risolvere per trovare i codici segreti. Giochi in legno fatti a mano. E naturalmente uno scrigno pieno di meraviglie!"
    ],
    "fr": [
      "Retrouvez au parc Accro'Sioule Kids : 9 énigmes à résoudre pour trouver des codes secrets. Des jeux en bois fabriqués de manière artisanale. Et bien sûr un coffre au trésor rempli de merveilles !"
    ],
    "es": [
      "En Accro'Sioule Kids encontrarás: 9 acertijos que resolver para encontrar códigos secretos. Juegos de madera hechos a mano. Y, por supuesto, ¡un cofre del tesoro lleno de maravillas!"
    ],
    "nl": [
      "Bij Accro'Sioule Kids vind je: 9 raadsels om op te lossen en geheime codes te vinden. Handgemaakte houten spelletjes. En natuurlijk een schatkist vol wonderen!"
    ]
  },
  "rdfs:label": {
