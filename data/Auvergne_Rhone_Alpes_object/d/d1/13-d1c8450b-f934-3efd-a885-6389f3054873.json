  "rdfs:comment": {
    "de": [
      "Relais von Bio- und lokalen Erzeugern\r\nVerkauf auf dem Bauernhof jeden Mittwoch 15h-18h30\r\nFleisch Obst Gemüse Eier Milchprodukte Käse Kuh Ziege Schaf Getränk Brot...usw"
    ],
    "en": [
      "Relay of organic and local producers\r\nFarm sales every Wednesday 3pm-6.30pm\r\nMeat fruit vegetables eggs dairy cheese cow goat sheep drink bread...etc"
    ],
    "it": [
      "Staffetta di produttori biologici e locali\r\nVendita in fattoria ogni mercoledì dalle 15.00 alle 18.30\r\nCarne frutta verdura uova latticini formaggio mucca capra pecora bevanda pane...etc"
    ],
    "fr": [
      "Relais de producteurs bio et locaux\r\nVente à la ferme tous les mercredis 15h-18h30\r\nViande fruits légumes œufs laitage fromage vache chèvre brebis boisson pain...etc"
    ],
    "es": [
      "Relevo de productores ecológicos y locales\r\nVenta en granjas todos los miércoles de 15.00 a 18.30 horas\r\nCarne fruta verduras huevos lácteos queso vaca cabra oveja bebida pan...etc"
    ],
    "nl": [
      "Estafette van biologische en lokale producenten\r\nBoerderijverkoop elke woensdag van 15.00 tot 18.30 uur\r\nVlees fruit groenten eieren zuivel kaas koe geit schaap drinken brood...etc"
    ]
  },
