  "rdfs:comment": {
    "de": [
      "Barcelonne ist eine naturreiche Gemeinde, die Wanderungen rund um ihren schönen Turm anbietet, von dem aus Sie eine schöne Aussicht haben werden!"
    ],
    "en": [
      "Barcelonne is a commune rich in natural beauty, offering hiking trails around its beautiful Tower, which will give you a great view!"
    ],
    "it": [
      "Barcelonne è un comune ricco di natura che offre escursioni intorno alla sua bella Torre che vi permetterà di godere di una splendida vista!"
    ],
    "fr": [
      "Barcelonne est une commune riche en nature qui propose de la randonnée autour de sa belle Tour qui elle vous permettra d'avoir une belle vue !"
    ],
    "es": [
      "¡Barcelonne es un municipio rico en naturaleza que ofrece excursiones alrededor de su hermosa Torre que le permitirá tener una hermosa vista!"
    ],
    "nl": [
      "Barcelonne is een gemeente rijk aan natuurlijke schoonheid en biedt wandelingen rond de prachtige toren, die je een geweldig uitzicht zal geven!"
    ]
  },
