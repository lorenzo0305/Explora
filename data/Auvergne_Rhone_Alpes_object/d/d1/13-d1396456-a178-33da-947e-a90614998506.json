  "rdfs:comment": {
    "de": [
      "Das Drak-art, das von der Leidenschaft seines Betreibers Amine Larabi mitgerissen wird, präsentiert sowohl eine originelle Location als auch Musikveranstaltungen für jeden Geschmack. Es ist sowohl ein Club als auch ein Veranstaltungsort."
    ],
    "en": [
      "Drak-art, driven by the passion of its manager Amine Larabi, presents both an original venue and musical events to suit all tastes. It's both a club and a venue."
    ],
    "it": [
      "Il Drak-art, guidato dalla passione del suo direttore Amine Larabi, presenta sia un locale originale che eventi musicali per tutti i gusti. Si tratta di un club e di uno spazio per spettacoli."
    ],
    "fr": [
      "Le Drak-art, emporté par la passion de son gérant Amine Larabi, présente à la fois un lieu original et des évènements musicaux pour tous les goûts. C'est à la fois un club et une salle de spectacle."
    ],
    "es": [
      "Drak-art, impulsado por la pasión de su director, Amine Larabi, ofrece a la vez un local original y eventos musicales para todos los gustos. Es a la vez un club y un local."
    ],
    "nl": [
      "De Drak-art, gedreven door de passie van zijn manager Amine Larabi, presenteert zowel een originele zaal als muzikale evenementen voor alle smaken. Het is zowel een club als een uitvoeringsruimte."
    ]
  },
