  "rdfs:comment": {
    "de": [
      "Das neue AC by Marriott-Hotel in Saint-Julien-en-Genevois eröffnet Anfang März 2022."
    ],
    "en": [
      "A new AC Hotel by Marriott in Saint-Julien-en-Genevois, open beginning of March 2022."
    ],
    "it": [
      "Sede elegante e raffinata per le vostre riunioni di lavoro, con tutti i comfort e la modernità necessari per lavorare in tutta tranquillità, l'AC Hôtel by Marriott è l'indirizzo perfetto per i vostri eventi professionali."
    ],
    "fr": [
      "Un lieu élégant et raffiné pour vos réunions d'affaires, en bénéficiant du confort et de la modernité nécessaire pour travailler en toute sérénité, l'AC Hôtel by Marriott est l'adresse parfaite pour vos évènements professionnels."
    ],
    "es": [
      "Un lugar elegante y refinado para sus reuniones de negocios, con todo el confort y la modernidad que necesita para trabajar con total tranquilidad, el AC Hôtel by Marriott es la dirección perfecta para sus eventos profesionales."
    ],
    "nl": [
      "Het AC Hôtel by Marriott is een elegante en verfijnde locatie voor uw zakelijke bijeenkomsten, met alle comfort en moderniteit die u nodig hebt om met een gerust hart te kunnen werken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "AC Hôtel by Marriott Saint-Julien-en-Genevois - Espaces de travail"
    ]
  },
