  "rdfs:comment": {
    "de": [
      "Vom Anfänger bis zum Galopp 7, ein breites Spektrum an Aktivitäten rund um die Leidenschaft des Pferdes: Reitschule, Kurse für Pferde und Ponys, Ausritte und Praktika mit oder ohne Unterkunft, eidgenössische Galoppprüfungen, interne Wettbewerbe, TREC."
    ],
    "en": [
      "From beginner to galop 7, a wide range of activities based on a passion for horses: riding school, horse and pony lessons, treks and training courses with or without accommodation, federal galop exams, in-house competitions, TREC."
    ],
    "it": [
      "Dai principianti al galoppo 7, una vasta gamma di attività basate sulla passione per i cavalli: scuola di equitazione, lezioni di cavalli e pony, passeggiate e corsi con o senza alloggio, esami federali di galoppo, concorsi interni, TREC."
    ],
    "fr": [
      "Du débutant au galop 7, un large panel d’activité autour de la passion du cheval : école d’équitation, cours cheval et poneys, randonnées et stages avec ou sans hébergement, passages de galop fédéraux, concours internes, TREC."
    ],
    "nl": [
      "Van beginners tot galop 7, een breed scala aan activiteiten gebaseerd op een passie voor paarden: manege, paarden- en ponylessen, buitenritten en cursussen met of zonder accommodatie, federale galopexamens, interne wedstrijden, TREC."
    ],
    "es": [
      "Desde principiantes hasta galope 7, una amplia gama de actividades en torno a la pasión por los caballos: escuela de equitación, clases de caballos y ponis, paseos y cursos con o sin alojamiento, exámenes federales de galope, competiciones internas, TREC."
    ]
  },
  "rdfs:label": {
