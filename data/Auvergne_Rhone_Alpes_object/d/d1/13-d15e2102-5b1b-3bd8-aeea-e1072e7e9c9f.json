  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine spannende Schatzsuche! Entdecken Sie die Kirche Notre-Dame d'Espérance und das historische Museum von Allard. Lösen Sie gemeinsam komplexe Rätsel und entschlüsseln Sie geheimnisvolle Codes, um den verborgenen Schatz zu finden.\r\nCa. 2,5 Stunden und 3,5 km"
    ],
    "en": [
      "Set off on an exciting treasure hunt! Discover the Notre-Dame d?Espérance church and the Musée historique d?Allard. Together, solve complex riddles and decipher mysterious codes to find the hidden treasure.\r\nApprox. 2h30 and 3.5km"
    ],
    "it": [
      "Partite per un'emozionante caccia al tesoro! Scoprite la chiesa di Notre-Dame d'Espérance e il Musée historique d'Allard. Insieme, risolvete enigmi complessi e decifrate codici misteriosi per trovare il tesoro nascosto.\r\nCirca 2h30 e 3,5km"
    ],
    "fr": [
      "Partez pour une chasse au trésor passionnante ! Découvrez l'église Notre-Dame d’Espérance et le musée historique d’Allard. Ensemble, résolvez des énigmes complexes et déchiffrez des codes mystérieux pour trouver le trésor caché.\r\nEnv. 2h30 et 3,5km"
    ],
    "nl": [
      "Ga op een spannende schattenjacht! Ontdek de kerk Notre-Dame d'Espérance en het Musée historique d'Allard. Los samen complexe raadsels op en ontcijfer mysterieuze codes om de verborgen schat te vinden.\r\nCa. 2u30 en 3,5 km"
    ],
    "es": [
      "Embárquese en una emocionante búsqueda del tesoro Descubre la iglesia de Notre-Dame d'Espérance y el Musée historique d'Allard. Juntos, resuelvan enigmas complejos y descifren códigos misteriosos para encontrar el tesoro escondido.\r\nAprox. 2h30 y 3,5km"
    ]
  },
  "rdfs:label": {
    "fr": [
      "My City Hunt - Chasse au trésor"
    ]
  },
