  "rdfs:comment": {
    "de": [
      "La Cachette de Linette, der Concept-Store in Chambéry, ist der französischen Herstellung gewidmet. Hier können Sie sich kleiden, dekorieren und (sich) mit einer raffinierten Auswahl an Marken Made in France verwöhnen lassen. Eine Einladung, Ethik und Ästhetik im Alltag miteinander in Einklang zu bringen."
    ],
    "en": [
      "La Cachette de Linette, Chambéry's concept-store dedicated to French manufacturing for dressing, decorating and pampering yourself with a refined selection of Made in France brands. An invitation to reconcile ethics and aesthetics in everyday life."
    ],
    "it": [
      "La Cachette de Linette, il concept store di Chambéry dedicato alla manifattura francese per vestirsi, decorarsi e coccolarsi con una raffinata selezione di marchi Made in France. Un invito a conciliare etica ed estetica nella vita di tutti i giorni."
    ],
    "fr": [
      "La Cachette de Linette, le concept-store de Chambéry dédié à la fabrication française pour s'habiller, décorer et (vous) faire plaisir grâce à une sélection raffinée de marques Made in France. Une invitation à concilier éthique et esthétique au quotidien."
    ],
    "es": [
      "La Cachette de Linette, el concept store de Chambéry dedicado a la fabricación francesa para vestirse, decorarse y mimarse con una refinada selección de marcas Made in France. Una invitación a conciliar ética y estética en la vida cotidiana."
    ],
    "nl": [
      "La Cachette de Linette, de conceptwinkel in Chambéry gewijd aan Frans fabricaat om je aan te kleden, te decoreren en te verwennen met een verfijnde selectie Made in France merken. Een uitnodiging om ethiek en esthetiek in het dagelijks leven met elkaar te verzoenen."
    ]
  },
  "rdfs:label": {
