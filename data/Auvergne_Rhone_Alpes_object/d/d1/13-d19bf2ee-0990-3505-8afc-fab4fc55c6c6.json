  "rdfs:comment": {
    "de": [
      "L'Express ist ein Ski-Restaurant in Avoriaz, das qualitativ hochwertige Schnellgerichte auf den Pisten anbietet: Burger, Pizza und Salate in einer Good Food, Fast Mood-Atmosphäre. Täglich geöffnet für eine kulinarische Pause nach dem Skifahren."
    ],
    "en": [
      "L’Express is a ski-in ski-out restaurant in Avoriaz, offering high-quality fast food on the slopes: burgers, pizzas and salads in a “Good Food, Fast Mood” atmosphere. Open every day for a tasty break after skiing."
    ],
    "it": [
      "L'Express è un ristorante ski-in/ski-out di Avoriaz che offre fast food di qualità sulle piste: hamburger, pizze e insalate in un'atmosfera \"Good Food, Fast Mood\". Aperto tutti i giorni per una pausa gourmet dopo lo sci."
    ],
    "fr": [
      "L’Express est un restaurant skis aux pieds à Avoriaz, proposant une restauration rapide de qualité sur les pistes : burgers, pizzas et salades dans une ambiance “Good Food, Fast Mood”. Ouvert tous les jours pour une pause gourmande après la glisse."
    ],
    "nl": [
      "L’Express is een ski-in ski-out restaurant in Avoriaz en biedt kwalitatieve fastfood op de pistes: burgers, pizza’s en salades in een “Good Food, Fast Mood”-sfeer. Dagelijks geopend voor een smakelijke pauze na het skiën."
    ],
    "es": [
      "L'Express es un restaurante de esquí en Avoriaz que ofrece comida rápida de calidad en las pistas: hamburguesas, pizzas y ensaladas en un ambiente de buena comida y comida rápida. Abierto todos los días para una pausa gastronómica después de esquiar."
    ]
  },
