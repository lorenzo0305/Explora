  "rdfs:comment": {
    "de": [
      "Die Elternvereinigung (Association des Parents d'Élèves, APE) von Saint-Martin und Saint-Julien-en-Vercors unterstützt die Schulen der beiden Dörfer durch die Organisation von Veranstaltungen, um Bildungsprojekte, Schulausflüge und außerschulische Aktivitäten zu finanzieren."
    ],
    "en": [
      "The Association des Parents d'Élèves (APE) of Saint-Martin and Saint-Julien-en-Vercors supports the schools in both villages by organizing events to finance educational projects, school outings and extracurricular activities."
    ],
    "it": [
      "L'Association des Parents d'Élèves (APE) di Saint-Martin e Saint-Julien-en-Vercors sostiene le scuole dei due villaggi organizzando eventi per finanziare progetti educativi, gite scolastiche e attività extrascolastiche."
    ],
    "fr": [
      "L'Association des Parents d'Élèves (APE) de Saint-Martin et Saint-Julien-en-Vercors soutient les écoles des deux villages en organisant des événements pour financer des projets éducatifs, sorties scolaires et activités extrascolaires."
    ],
    "es": [
      "La Asociación de Padres de Alumnos (APE) de Saint-Martin y Saint-Julien-en-Vercors apoya a las escuelas de los dos pueblos organizando actos para financiar proyectos educativos, salidas escolares y actividades extraescolares."
    ],
    "nl": [
      "De Association des Parents d'Élèves (APE) van Saint-Martin en Saint-Julien-en-Vercors steunt de scholen in de twee dorpen door evenementen te organiseren om onderwijsprojecten, schoolreisjes en buitenschoolse activiteiten te financieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "APE SAINT MARTIN ET SAINT JULIEN EN VERCORS"
    ]
  },
