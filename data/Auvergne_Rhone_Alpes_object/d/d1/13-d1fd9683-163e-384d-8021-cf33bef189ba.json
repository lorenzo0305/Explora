  "rdfs:comment": {
    "de": [
      "Sie sind nur nach Vereinbarung und am Wochenende zu einer kosmischen Reise zwischen den Sternbildern eingeladen, um die Sterne und ihre protoplanetaren Scheiben zu entdecken: Kommen Sie ab 16.30 Uhr zu einem sternenreichen Austausch in Marie-Jos Atelier."
    ],
    "en": [
      "You are invited, by appointment only and at weekends, to take a cosmic journey between the constellations to discover the stars and their protoplanetary disks : come along from 4,30 pm for a starry-eyed sharing in Marie-Jo studio."
    ],
    "it": [
      "Su appuntamento e nei fine settimana, siete invitati a fare un viaggio cosmico tra le costellazioni alla scoperta delle stelle e dei loro dischi protoplanetari: venite a trovarci dalle 16.30 per un pomeriggio stellato nello studio di Marie-Jo"
    ],
    "fr": [
      "Vous êtes invités, uniquement sur rendez-vous et le week-end, à un voyage cosmique entre les constellations à la découverte des étoiles et de leurs disques protoplanétaires : venez à partir de 16h30 pour un partage étoilé dans l'atelier de Marie-Jo"
    ],
    "nl": [
      "Marie-Jo leidt u rond door haar schildersatelier. Ze exposeert er recente werken van groot formaat rondom het thema astronomie, natuur- en scheikunde, en oudere werken geïnspireerd op de landschappen in de Vallon de la Jarjatte."
    ],
    "es": [
      "Con cita previa y los fines de semana, le invitamos a realizar un viaje cósmico entre las constelaciones para descubrir las estrellas y sus discos protoplanetarios: venga a partir de las 16.30 h para pasar una tarde estrellada en el estudio de Marie-Jo"
    ]
  },
  "rdfs:label": {
    "de": [
      "Atelier Malerei Marie-Jo Parron"
    ],
    "en": [
      "Marie-Jo Parron Painting Workshop"
    ],
    "fr": [
      "Atelier Peinture Marie-Jo Parron"
    ],
    "nl": [
      "Marie-Jo Parron Schilderworkshop"
    ]
  },
