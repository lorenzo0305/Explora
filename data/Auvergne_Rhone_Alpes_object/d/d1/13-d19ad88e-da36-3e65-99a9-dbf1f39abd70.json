  "rdfs:comment": {
    "de": [
      "Private Weinkellerei, freiberuflicher Winzer, Weinverkauf und -verkostung. Landwein aus den Coteaux de l'Ardèche (rot, rosé, weiß, lieblich), AOC Côtes du Vivarais. Produzent von Obst und Gemüse. Verkauf von regionalen Produkten vor Ort im Weinkeller."
    ],
    "en": [
      "Private wine house, independant wine grower, sale and tasting of 'Vin de pays des coteaux de l'Ardèche' and 'AOC Côtes du Vivarais'.  Sale local products and fruit and vegetables as well old variety of tomatoes."
    ],
    "it": [
      "Viticoltore indipendente, produzione, degustazione e vendita di vino in azienda. Produttore di IGP Ardèche e AOC Côtes du Vivarais.\r\n Produttore di frutta e verdura. Vendita di prodotti regionali in cantina."
    ],
    "fr": [
      "Vigneron indépendant, production, dégustation et vente de vin sur le domaine. Producteur IGP Ardèche et AOC Côtes du Vivarais.\r\n Producteur de fruits et légumes. Vente de produits régionaux sur place au caveau."
    ],
    "es": [
      "Viticultor independiente, producción, degustación y venta de vino en la finca. Productor de IGP Ardèche y AOC Côtes du Vivarais.\r\n Productor de frutas y verduras. Venta de productos regionales en la bodega."
    ],
    "nl": [
      "Onafhankelijke wijnboer, verkoop en degustatie van Vin de pays des coteaux de l'Ardèche en AOC côtes du Vivarais. Verkoopt eigen geteelde groenten en fruit en andere streekproducten."
    ]
  },
