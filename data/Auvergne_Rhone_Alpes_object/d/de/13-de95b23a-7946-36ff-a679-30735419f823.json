  "rdfs:comment": {
    "de": [
      "Lassen Sie sich verführen und genießen Sie die traditionsreiche französische Küche. Genießen Sie die hervorragenden regionalen Gerichte und die hausgemachte Küche, die von unseren Köchen mit Liebe kreiert werden. Außerdem verfügen wir über einen separaten Raucherbereich."
    ],
    "en": [
      "Let yourself be seduced by French cuisine, rich in tradition. Enjoy excellent local dishes and homemade cuisine, lovingly created by our chefs. We also have a separate smoking area."
    ],
    "it": [
      "Lasciatevi sedurre e godetevi la cucina francese ricca di tradizione. Assaporate gli ottimi piatti locali e la cucina casalinga creata con amore dai nostri chef. Disponiamo anche di un parcheggio privato e di un'ampia terrazza."
    ],
    "fr": [
      "Laissez-vous séduire et profitez de la cuisine française riche en traditions. Savourez les excellents plats du terroir et la cuisine faite maison, créés avec amour par nos cuisiniers. Nous disposons en plus d’un parking privé et d'une grande terrasse."
    ],
    "nl": [
      "Laat je verleiden en geniet van de traditionele Franse keuken. Proef de uitstekende streekgerechten en huisgemaakte gerechten die met liefde zijn gemaakt door onze koks. We hebben ook een aparte rokersruimte."
    ],
    "es": [
      "Déjese seducir y disfrute de una cocina francesa rica en tradición. Saboree los excelentes platos locales y la cocina casera creada con amor por nuestros chefs. También disponemos de aparcamiento privado y una amplia terraza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistrot de Chatô"
    ]
  },
