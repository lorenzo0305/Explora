  "rdfs:comment": {
    "de": [
      "Träumen Sie von vertikalen Abenteuern, erfrischenden Abfahrten oder schneebedeckten Gipfeln? Mit meiner dreifachen Erfahrung als Bergführer, Skilehrer und Ausbilder an der Ensa biete ich Ihnen eine maßgeschneiderte Begleitung für alle Ihre Ausflüge in die Natur."
    ],
    "en": [
      "Do you dream of vertical adventures, refreshing descents or snowy summits? As a mountain guide, ski instructor and teacher at Ensa, I can offer you tailor-made support for all your outdoor adventures."
    ],
    "it": [
      "Sognate avventure verticali, discese rinfrescanti o cime innevate? Sono una guida alpina, un maestro di sci e un insegnante dell'Ensa, quindi posso creare le vostre escursioni all'aperto su misura per voi."
    ],
    "fr": [
      "Vous rêvez d'aventures verticales, de descentes rafraîchissantes ou de sommets enneigés ? Fort de ma triple casquette de guide de haute montagne, moniteur de ski, et formateur à l’Ensa, j'offre du sur mesure pour toutes vos escapades en pleine nature."
    ],
    "es": [
      "¿Sueñas con aventuras verticales, descensos refrescantes o cumbres nevadas? Soy guía de montaña, monitor de esquí y profesor en Ensa, así que puedo confeccionar todas tus escapadas al aire libre a tu medida."
    ],
    "nl": [
      "Droom je van verticale avonturen, verfrissende afdalingen of besneeuwde toppen? Ik ben berggids, skileraar en leraar bij Ensa, dus ik kan al je outdooravonturen op maat maken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fred Chabert - guide montagne"
    ]
  },
