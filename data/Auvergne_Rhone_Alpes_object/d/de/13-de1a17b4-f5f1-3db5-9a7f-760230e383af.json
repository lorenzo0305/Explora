  "rdfs:comment": {
    "de": [
      "Romanische Kirche (11.-12. Jh.) - Architektur aus der Auvergne und burgundische Skulptur. Seltenes geschnitztes Tympanon: Majestätischer Christus in einer Mandorla, die von zwei Engeln getragen wird. Sturz: Das letzte Abendmahl und die Fußwaschung. Spirituelle Etappe Ihrer Pilgerreise."
    ],
    "en": [
      "This 12th century building illustrates the Auvergnat-Romanesque style with its architecture, and the Burgundian style with its sculpture."
    ],
    "it": [
      "Chiesa romanica (XI-XII sec.) - Architettura dell'Alvernia e scultura della Borgogna. Raro timpano scolpito: Cristo in maestà in una mandorla portato da due angeli. Architrave: l'Ultima Cena e la lavanda dei piedi. Una tappa spirituale del vostro pellegrinaggio."
    ],
    "fr": [
      "Église romane (XIe-XIIe s.) - Architecture auvergnate et sculpture bourguignonne. Rare tympan sculpté : Christ en majesté dans une mandorle portée par deux anges. Linteau : la Cène et le lavement des pieds. Étape spirituelle de votre pèlerinage."
    ],
    "nl": [
      "Romaanse kerk (11e-12e eeuw) - Auvergne-architectuur en Bourgondische beeldhouwkunst. Zeldzaam gebeeldhouwd timpaan: Christus in majesteit in een mandorla gedragen door twee engelen. Bovendorpel: het Laatste Avondmaal en de voetwassing. Een spirituele halte op uw pelgrimstocht."
    ],
    "es": [
      "Iglesia románica (s. XI-XII) - Arquitectura de Auvernia y escultura de Borgoña. Raro tímpano esculpido: Cristo en majestad en una mandorla llevado por dos ángeles. Dintel: la Última Cena y el lavatorio de los pies. Una parada espiritual en su peregrinación."
    ]
  },
