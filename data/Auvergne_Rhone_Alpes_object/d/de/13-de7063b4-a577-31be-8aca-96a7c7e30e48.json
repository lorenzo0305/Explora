  "rdfs:comment": {
    "de": [
      "Ein unvergessliches asiatisches kulinarisches Erlebnis!\r\nEntdecken Sie das Jojo Sushi Restaurant, in dem japanische und chinesische Aromen aufeinandertreffen und frisch auf Bestellung zubereitete Speisen serviert werden.\r\nReservieren Sie jetzt!"
    ],
    "en": [
      "An unforgettable Asian culinary experience!\r\nDiscover the Jojo Sushi restaurant, where Japanese and Chinese flavors meet, with cuisine freshly prepared to order.\r\nMake your reservation now!"
    ],
    "it": [
      "Un'esperienza culinaria asiatica indimenticabile!\r\nScoprite il ristorante Jojo Sushi, dove i sapori giapponesi e cinesi si incontrano, con una cucina preparata al momento su ordinazione.\r\nPrenotate subito!"
    ],
    "fr": [
      "Une expérience culinaire asiatique inoubliable !\r\nDécouvrez le restaurant Jojo Sushi où les saveurs japonaises et chinoises se rencontrent, avec une cuisine fraîchement préparée sur commande. \r\nRéservez dès maintenant !"
    ],
    "es": [
      "Una experiencia culinaria asiática inolvidable\r\nDescubra el restaurante Jojo Sushi, donde confluyen los sabores japonés y chino, con cocina recién preparada al momento.\r\n¡Haga ya su reserva!"
    ],
    "nl": [
      "Een onvergetelijke Aziatische culinaire ervaring!\r\nOntdek het Jojo Sushi restaurant, waar Japanse en Chinese smaken elkaar ontmoeten, met gerechten die vers op bestelling worden bereid.\r\nReserveer nu!"
    ]
  },
  "rdfs:label": {
