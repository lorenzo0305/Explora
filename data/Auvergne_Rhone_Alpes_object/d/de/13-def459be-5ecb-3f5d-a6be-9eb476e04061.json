  "rdfs:comment": {
    "de": [
      "Modernes Weingut der Rhône. Zwischen Ostern und Allerheiligen. Verkostung \r\nim Weinkeller. Jeden Montag im Juli und August: Gratisbesuch. Konzerte in der Saison. Mehr Informationen auf Facebook."
    ],
    "en": [
      "Modern wine cellar in the middle of the Grand Bois surrounded by vineyards."
    ],
    "it": [
      "La famiglia Vermeersch offre vini rossi, rosati e bianchi Vin de Soif, Côtes du Rhône nel cuore della gamma, poi vini GT di alta gamma, Côtes du Rhône village Suze la Rousse, potenti e corposi in una tenuta di 20 ettari."
    ],
    "fr": [
      "La Famille Vermeersch vous propose des rouges, rosés et blancs en Vin de Soif,  Côtes du Rhône en coeur de Gamme puis en Haut de Gamme avec les vins GT, Côtes du Rhône village Suze la Rousse puissants et charpentés sur un domaine de 20 ha."
    ],
    "nl": [
      "Wijnhuis van de moderne Rhône. Van Pasen tot Allerheiligen: proeverij in de kelder. In juli en augustus elke maandag om 17 uur: gratis rondleiding. Organisator van concerten in het seizoen, meer info op facebook."
    ],
    "es": [
      "La familia Vermeersch le ofrece vinos tintos, rosados y blancos Vin de Soif, Côtes du Rhône en el centro de la gama, y después vinos GT de gama alta, Côtes du Rhône village Suze la Rousse, potentes y con cuerpo en una finca de 20 hectáreas."
    ]
  },
