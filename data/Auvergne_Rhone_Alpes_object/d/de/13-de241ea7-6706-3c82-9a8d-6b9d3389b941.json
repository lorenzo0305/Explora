  "rdfs:comment": {
    "de": [
      "Dieses Atelier bietet eine farbenfrohe, pflanzliche und traumhafte Welt. Originalwerke, Kunstdrucke, Papierwaren und Textilien im Siebdruckverfahren, die von Hand gefertigt werden. Eine helle und inspirierende Adresse, die eine Mischung aus Galerie, Atelier und Laden für lokales Kunsthandwerk ist."
    ],
    "en": [
      "This workshop offers a colourful, plant-filled and dreamlike world. Original works, art prints, stationery and screen-printed textiles, all handmade. A bright and inspiring place, at the crossroads between a gallery, workshop and local craft shop."
    ],
    "it": [
      "Questo laboratorio offre un universo colorato, vegetale e onirico. Opere originali, stampe d'arte, articoli di cancelleria fatti a mano e tessuti serigrafati. Un indirizzo luminoso e stimolante, un incrocio tra galleria, laboratorio e negozio di artigianato locale."
    ],
    "fr": [
      "Cet atelier propose un univers coloré, végétal et onirique. Oeuvres originales, tirages d’art, papeterie et textiles sérigraphiés, réalisés à la main. Une adresse lumineuse et inspirante, à la croisée entre galerie, atelier et boutique d’artisanat local."
    ],
    "es": [
      "Este taller ofrece un universo colorista, vegetal y onírico. Obras originales, impresiones artísticas, artículos de papelería hechos a mano y textiles serigrafiados. Una dirección luminosa e inspiradora, a caballo entre galería, taller y tienda de artesanía local."
    ],
    "nl": [
      "Deze workshop biedt een kleurrijk, plantaardig en dromerig universum. Originele werken, kunstdrukken, handgemaakt briefpapier en gezeefdrukt textiel. Een helder en inspirerend adres, een kruising tussen galerie, werkplaats en ambachtswinkel."
    ]
  },
