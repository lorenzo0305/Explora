  "rdfs:comment": {
    "de": [
      "Die Schule bietet Kurse oder einzelne Sitzungen zur Einführung und Verbesserung des Kitesurfens in kleinen Gruppen (zwei oder drei Personen) an, um einen schnellen Lernprozess zu ermöglichen."
    ],
    "en": [
      "The school offers introductory and advanced kitesurfing courses in small groups (two or three people), assisted by a safety boat and a radio link."
    ],
    "it": [
      "La scuola offre corsi di kitesurf introduttivi e avanzati e sessioni in piccoli gruppi (due o tre persone), con una barca di sicurezza e un collegamento radio per aiutarvi a imparare rapidamente."
    ],
    "fr": [
      "L'école propose des stages ou des séances ponctuelles, d'initiation et de perfectionnement au kitesurf, en effectif restreint ( deux ou trois personnes), pour un apprentissage rapide, assisté par un bateau de sécurité et une liaison radio."
    ],
    "es": [
      "La escuela ofrece cursos y sesiones de iniciación y perfeccionamiento al kitesurf en grupos reducidos (dos o tres personas), con una embarcación de seguridad y un enlace por radio para facilitar el rápido aprendizaje."
    ],
    "nl": [
      "De school biedt cursussen kitesurfen voor beginners en gevorderden en sessies in kleine groepen (twee of drie personen), met een veiligheidsboot en een radioverbinding om je te helpen snel te leren."
    ]
  },
