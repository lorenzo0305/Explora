  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/67cf4b40-6a9e-3759-9548-343f0976eda6",
      "dc:description": {
        "de": [
          "Sportliche Strecke\nFreitag, 20. März - Start um 20:30 Uhr\nSchule von La Calotterie\n------------------------\n35 km lange Strecke\n\nAnmeldung vor Ort ab 19 Uhr\nVerpflegung auf halber Strecke und am Ziel.\n\nLichthelm und reflektierende Weste sind Pflicht!\n\nCredit: Pixabay"
        ],
        "en": [
          "Sports trail\nFriday March 20 - Departure at 8:30pm\nLa Calotterie School\n------------------------\n35 kms course\n\nOn-site registration from 7pm\nRefreshments at mid-course and finish.\n\nLight helmet and reflective vest compulsory!\n\nCredit : Pixabay"
        ],
        "it": [
          "Percorso sportivo\nVenerdì 20 marzo - Inizio alle 20.30\nScuola La Calotterie\n------------------------\nPercorso di 35 km\n\nIscrizioni in loco dalle 19.00\nRistoro a metà percorso e all'arrivo.\n\nCasco leggero e gilet riflettente obbligatori!\n\nCredito: Pixabay"
        ],
        "fr": [
          "Parcours sportif\nVendredi 20 mars - Départ à 20h30\nEcole de La Calotterie\n------------------------\nParcours de 35 kms\n\nInscriptions sur place à partir de 19h\nRavitaillement à mi-parcours et à l’arrivée.\n\nCasque lumière et gilet réfléchissant obligatoire !\n\nCrédit : Pixabay"
        ],
        "nl": [
          "Sportief parcours\nVrijdag 20 maart - Aanvang 20.30 uur\nLa Calotterie School\n------------------------\n35 km parcours\n\nRegistratie ter plaatse vanaf 19.00 uur\nVersnaperingen halverwege het parcours en bij de finish.\n\nLichte helm en reflecterend vest verplicht!\n\nFoto: Pixabay"
        ],
        "es": [
          "Recorrido deportivo\nViernes 20 de marzo - Comienzo a las 20.30 horas\nEscuela La Calotterie\n------------------------\nRecorrido de 35 km\n\nInscripciones in situ a partir de las 19h\nRefrescos a mitad del recorrido y en la meta.\n\nCasco ligero y chaleco reflectante obligatorios\n\nCrédito: Pixabay"
        ]
      },
