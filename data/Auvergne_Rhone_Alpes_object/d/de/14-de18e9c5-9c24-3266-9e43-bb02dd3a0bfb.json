      "dc:description": {
        "de": [
          " Informationen :\n\nÖffnungstage:\n \nMontag bis Freitag von 8:30 bis 12:15 Uhr und von 14:30 bis 19:30 Uhr\n\nSamstags von 8:15 bis 14:00 Uhr\n \n Abholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          " Information :\n\nOpening days:\n \nMonday to Friday, 8:30am to 12:15pm and 2:30pm to 7:30pm\n\nSaturday from 8.15am to 2.00pm\n \n Collection:\n\nDuring store opening hours\n\n "
        ],
        "it": [
          " Ulteriori informazioni :\n\nGiorni di apertura:\n \nDal lunedì al venerdì, dalle 8.30 alle 12.15 e dalle 14.30 alle 19.30\n\nSabato dalle 8.15 alle 14.00\n \n Raccolta:\n\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          " Informations :\n\nJours d'ouverture:\n \nDu lundi au vendredi de 8h30 à 12h15 et de 14h30 à 19h30\n\nLe samedi de 8h15 à 14h00\n \n Retrait :\n\nAux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          " Meer informatie :\n\nOpeningsdagen:\n \nMaandag tot vrijdag van 8u30 tot 12u15 en van 14u30 tot 19u30\n\nZaterdag van 8.15 tot 14.00 uur\n \n Ophalen:\n\nTijdens openingstijden van de winkel\n\n "
        ],
        "es": [
          " Más información :\n\nDías de apertura:\n \nDe lunes a viernes, de 8.30 a 12.15 h. y de 14.30 a 19.30 h\n\nSábado de 8.15 a 14.00 horas\n \n Recogida:\n\nDurante el horario de apertura de la tienda\n\n "
        ]
      },
