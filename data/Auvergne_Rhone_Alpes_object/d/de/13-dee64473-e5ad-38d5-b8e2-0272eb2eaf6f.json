  "rdfs:comment": {
    "de": [
      "Es liegt im unteren Tal der Drôme, zwischen Crest und Livron. Das Naturschutzgebiet Les Ramières ist eines von 20 Fluss-Naturschutzgebieten in Frankreich.\r\nAuf der gesamten Strecke lädt Sie der Fluss dazu ein, eine vielfältige Flora und Fauna zu entdecken."
    ],
    "en": [
      "Situated in the lower Drôme valley, between Crest and Livron, the Ramières nature reserve is one of 20 river bank nature reserves in France. Throughout the length of the reserve, the river invites you to discover its very varied flora and fauna."
    ],
    "it": [
      "Situato nella bassa valle della Drôme, tra Crest e Livron. La riserva naturale di Ramières è una delle 20 riserve naturali fluviali della Francia.\r\nLungo tutto il percorso, il fiume invita a scoprire una fauna e una flora diversificate."
    ],
    "fr": [
      "Située en basse Vallée de la Drôme, entre Crest et Livron. La réserve naturelle des Ramières est l'une des 20 réserves naturelles fluviales de France.\r\nTout au long du parcours, la rivière vous invite à découvrir une faune et une flore  diversifiées."
    ],
    "es": [
      "Situada en el bajo valle de la Drôme, entre Crest y Livron. La reserva natural de Ramières es una de las 20 reservas naturales fluviales de Francia.\r\nA lo largo de todo el recorrido, el río invita a descubrir una fauna y una flora diversificadas."
    ],
    "nl": [
      "Gelegen in de lagere Drôme vallei, tussen Crest en Livron. Het natuurreservaat Ramières is een van de 20 riviernatuurreservaten in Frankrijk.\r\nLangs het hele traject nodigt de rivier je uit om zijn gevarieerde flora en fauna te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Réserve naturelle nationale des Ramières Val de Drôme"
    ]
  },
