  "rdfs:comment": {
    "de": [
      "Kochkurs mit dem Chefkoch Gilles Roux: Meistern Sie die Entenstopfleber! Lernen Sie von 15:00 bis 18:30 Uhr seine außergewöhnlichen Techniken kennen und genießen Sie einen raffinierten Moment. 80? mit 2 Portionen zum Mitnehmen. Begrenzte Anzahl von Plätzen. Reservierung: 04 71 66 86 86."
    ],
    "en": [
      "Cooking classes with Chef Gilles Roux: master duck foie gras! From 3 pm to 6:30 pm, learn his exceptional techniques and share a refined moment. 80? with 2 portions to take away. Places limited. Reservations: 04 71 66 86 86."
    ],
    "it": [
      "Corso di cucina con lo chef Gilles Roux: maestro del foie gras d'anatra! Dalle 15.00 alle 18.30, imparate le sue tecniche eccezionali e condividete un momento di raffinatezza. 80? con 2 porzioni da portare via. Posti limitati. Prenotazioni: 04 71 66 86 86."
    ],
    "fr": [
      "Cours de cuisine avec le Chef Gilles Roux : maîtrisez le foie gras de canard ! De 15h à 18h30, apprenez ses techniques d'exception et partagez un moment raffiné. 80€ avec 2 portions à emporter. Places limitées. Réservation : 04 71 66 86 86."
    ],
    "nl": [
      "Kooklessen met chef Gilles Roux: meester eend foie gras! Leer van 15.00 tot 18.30 uur zijn uitzonderlijke technieken en deel een verfijnd moment. 80? met 2 porties om mee te nemen. Plaatsen beperkt. Reserveren: 04 71 66 86 86."
    ],
    "es": [
      "Clases de cocina con el Chef Gilles Roux: ¡el maestro del foie gras de pato! De 15:00 a 18:30 h, aprenda sus técnicas excepcionales y comparta un momento refinado. 80? con 2 raciones para llevar. Plazas limitadas. Reservas: 04 71 66 86 86."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de cuisine: le foie gras de canard"
    ]
  },
