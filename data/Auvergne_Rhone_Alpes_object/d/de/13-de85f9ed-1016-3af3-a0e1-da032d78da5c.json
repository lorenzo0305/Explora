  "rdfs:comment": {
    "de": [
      "Die Kirche von Seyssel Haute-Savoie wurde an der Stelle eines Tempels errichtet, der Jupiter - Tonnant gewidmet war.\r\nSeyssel war im 6. Jahrhundert eine Pfarrei. Die Sarazenen zerstörten\r\ndie Kirche um 750."
    ],
    "en": [
      "The Church of Seyssel Haute-Savoie was built on the site of a temple dedicated to Jupiter - Tonnant.\r\nSeyssel was a parish in the 6th century. The Saracens destroyed\r\nthe church around 750."
    ],
    "it": [
      "La chiesa di Seyssel Alta Savoia è stata costruita sul sito di un tempio dedicato a Giove Tonante.\r\nSeyssel era una parrocchia nel VI secolo. I Saraceni distrussero\r\nla chiesa intorno al 750."
    ],
    "fr": [
      "L’Eglise de Seyssel Haute-Savoie a été construite sur l’emplacement d’un temple dédié à Jupiter - Tonnant.\r\nSeyssel était une paroisse au VIème siècle. Les Sarrasins détruisirent \r\nl’église vers 750."
    ],
    "es": [
      "La iglesia de Seyssel Haute-Savoie fue construida en el emplazamiento de un templo dedicado a Júpiter - Tronador.\r\nSeyssel era una parroquia en el siglo VI. Los sarracenos destruyeron\r\nla iglesia alrededor del año 750."
    ],
    "nl": [
      "De kerk van Seyssel Haute-Savoie werd gebouwd op de plaats van een tempel gewijd aan Jupiter - Donderaar.\r\nSeyssel was een parochie in de 6e eeuw. De Saracenen vernietigden\r\nde kerk rond 750."
    ]
  },
