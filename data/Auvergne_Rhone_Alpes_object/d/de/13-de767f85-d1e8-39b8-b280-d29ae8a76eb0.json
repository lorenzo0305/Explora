  "rdfs:comment": {
    "de": [
      "Herstellung und Verkauf von Gebrauchs- und Dekorationskeramik. Herstellung von Schmuck aus Porzellan und Silber. Einzigartige Stücke. Zusammenschluss von neun Töpfern das ganze Jahr über."
    ],
    "en": [
      "Production and sales of useful and decorative pottery. Manufacture of porcelain and silver jewelry. Unique pieces. Pool of nine potters year-round."
    ],
    "it": [
      "Produzione e vendita di ceramiche utilitarie e decorative. Produzione di porcellana e gioielli in argento. Pezzi unici. Raggruppamento di nove ceramisti per tutto l'anno."
    ],
    "fr": [
      "Fabrication vente de poteries utilitaires et décoratives. Fabrication de bijoux en porcelaine et argent. Pièces uniques. Regroupement de neuf potiers toute l'année."
    ],
    "nl": [
      "Productie en verkoop van gebruiks- en sieraardewerk. Vervaardiging van porselein en zilveren sieraden. Unieke stukken. Negen pottenbakkers werken het hele jaar door samen."
    ],
    "es": [
      "Fabricación y venta de cerámica utilitaria y decorativa. Fabricación de porcelana y joyas de plata. Piezas únicas. Agrupación de nueve alfareros durante todo el año."
    ]
  },
