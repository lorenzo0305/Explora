  "rdfs:comment": {
    "de": [
      "Lust auf Flucht und Abenteuer?\r\nIch nehme Sie in aller Sicherheit mit auf eine Entdeckungsreise durch unsere wilden und unberührten Berge im Giffre-Tal."
    ],
    "en": [
      "Looking for escape and adventure?\r\nI'll take you, in complete safety, to discover the wild and unspoilt mountains of the Giffre valley."
    ],
    "it": [
      "Siete alla ricerca di evasione e avventura?\r\nVi porterò, in tutta sicurezza, alla scoperta delle nostre montagne selvagge e preservate della valle di Giffre."
    ],
    "fr": [
      "Envie d'évasion et d'aventure ? \r\nJe vous emmène, en toute sécurité, à la découverte de nos montagnes sauvages et préservées de la vallée du Giffre."
    ],
    "es": [
      "¿Busca evasión y aventura?\r\nTe llevaré, con total seguridad, a descubrir nuestras montañas salvajes y preservadas del valle del Giffre."
    ],
    "nl": [
      "Op zoek naar ontsnapping en avontuur?\r\nIk neem je mee op een veilige ontdekkingstocht door onze wilde en ongerepte bergen in de Vallée du Giffre."
    ]
  },
