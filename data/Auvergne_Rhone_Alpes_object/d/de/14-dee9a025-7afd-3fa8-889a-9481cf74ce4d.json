  "rdfs:comment": {
    "de": [
      "Anlässlich der Europäischen Tage des Denkmals zeigen Ihnen die Fachleute des Museums die verschiedenen Wege, die die Werke nehmen, um zu uns zu gelangen."
    ],
    "en": [
      "On the occasion of the European Heritage Days, museum professionals reveal the different routes taken by works of art to reach us."
    ],
    "it": [
      "In occasione delle Giornate Europee del Patrimonio, i professionisti dei musei sveleranno i diversi percorsi seguiti dalle opere d'arte per arrivare fino a noi."
    ],
    "fr": [
      "A l'occasion des Journées européennes du patrimoine, les professionnels du musée vous révèlent les différents parcours qu'empruntent les œuvres pour nous parvenir."
    ],
    "nl": [
      "Ter gelegenheid van de Europese Erfgoeddagen laten museumprofessionals zien welke verschillende routes kunstwerken afleggen om ons te bereiken."
    ],
    "es": [
      "Con motivo de las Jornadas Europeas del Patrimonio, los profesionales de los museos desvelarán las diferentes rutas que siguen las obras de arte para llegar hasta nosotros."
    ]
  },
  "rdfs:label": {
