  "rdfs:comment": {
    "de": [
      "Die Atmosphäre eines gemütlichen, modernen Pariser Bistros.\r\nDas Bistrot Georges V bietet Ihnen auch eine große Terrasse mit zehn Tischen für schöne Sommertage."
    ],
    "en": [
      "The look and feel of a welcoming, modern Parisian bistro.\r\nThe Bistrot Georges V also features a large terrace with a dozen tables for those fine summer days."
    ],
    "it": [
      "L'aspetto e l'atmosfera di un accogliente e moderno bistrot parigino.\r\nIl Bistrot Georges V dispone anche di un'ampia terrazza con una decina di tavoli per le belle giornate estive."
    ],
    "fr": [
      "Aspect et ambiance d’un bistrot parisien accueillant et moderne. \r\nLe Bistrot Georges V vous propose également une large terrasse disposant d’une dizaine de tables  pour les belles journées d’été."
    ],
    "es": [
      "El aspecto de un bistró parisino moderno y acogedor.\r\nEl Bistrot Georges V también dispone de una amplia terraza con una decena de mesas para los días de verano."
    ],
    "nl": [
      "De uitstraling van een gezellige, moderne Parijse bistro.\r\nBistrot Georges V heeft ook een groot terras met ongeveer tien tafels voor mooie zomerdagen."
    ]
  },
