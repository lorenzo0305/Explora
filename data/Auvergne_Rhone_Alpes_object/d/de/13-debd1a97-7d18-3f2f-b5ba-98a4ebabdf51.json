  "rdfs:comment": {
    "de": [
      "DAS Restaurant des Altiports. Kaffee am Morgen, Mittagessen am Rand der Piste, heiße Getränke in den Lounges oder Liegestühlen und Abendessen mit Freunden am Wochenende. Traditionelle Qualitätsküche mit lokalen Produkten. Neu ist der Couscous-Abend jeden Freitag."
    ],
    "en": [
      "THE Altiport restaurant. Morning Coffee, trackside lunch, hot drinks in the lounges or deckchairs and dinners with friends at weekends. Traditional, high-quality cuisine with local produce. Cuckoo night every Friday."
    ],
    "it": [
      "Il ristorante dell'Altiport. Caffè mattutino, pranzo a bordo pista, bevande calde nei saloni o sulle sdraio e cene con gli amici nel fine settimana. Cucina tradizionale e di qualità con prodotti locali. Novità: serata couscous ogni venerdì."
    ],
    "fr": [
      "LE restaurant de l’Altiport. Café le matin, déjeuner en bord de piste, boisson chaude dans les salons ou transats et dîners entre amis le weekend. Cuisine traditionnelle de qualité, produits locaux. Nouveauté soirée couscous chaque vendredi."
    ],
    "nl": [
      "Het restaurant van Altiport. Ochtendkoffie, lunch op het spoor, warme drankjes in de lounges of ligstoelen en diners met vrienden in het weekend. Traditionele keuken van hoge kwaliteit met lokale producten. Nieuw: elke vrijdag couscousavond."
    ],
    "es": [
      "EL restaurante de Altiport. Café por la mañana, almuerzo a pie de pista, bebidas calientes en los salones o en las tumbonas y cenas con amigos los fines de semana. Cocina tradicional de calidad elaborada con productos locales. Novedad: noche de cuscús todos los viernes."
    ]
  },
