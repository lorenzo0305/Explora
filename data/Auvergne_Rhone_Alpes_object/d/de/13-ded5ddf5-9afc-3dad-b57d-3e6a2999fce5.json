  "rdfs:comment": {
    "de": [
      "Seit zwei Jahren arbeitet der Fotoclub Dunlop-SNCF mit dem Thema der Buchstaben des Alphabets.\r\n30 Mitglieder des Clubs haben das Spiel mitgespielt und werden eine Auswahl von 150 Fotos präsentieren."
    ],
    "en": [
      "For the past 2 years, the Dunlop-SNCF Photo Club has been working on the theme of the letters of the alphabet.\r\n30 club members have taken up the challenge and will be presenting a selection of 150 photos."
    ],
    "it": [
      "Negli ultimi due anni, il Foto Club Dunlop-SNCF ha lavorato sul tema delle lettere dell'alfabeto.\r\n30 soci del club hanno accettato la sfida e presenteranno una selezione di 150 foto."
    ],
    "fr": [
      "Depuis 2 ans, le club photo Dunlop-SNCF travaille sur le thème des lettres de l'alphabet.\r\n30 membres du club ont joué le jeu et présenteront une sélection de 150 photos."
    ],
    "es": [
      "Desde hace 2 años, el Foto Club Dunlop-SNCF trabaja sobre el tema de las letras del alfabeto.\r\n30 miembros del club han aceptado el reto y presentarán una selección de 150 fotos."
    ],
    "nl": [
      "De afgelopen 2 jaar heeft de Dunlop-SNCF fotoclub gewerkt rond het thema van de letters van het alfabet.\r\n30 leden van de club zijn de uitdaging aangegaan en zullen een selectie van 150 foto's presenteren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition photographique : Les Lettres prennent la pose"
    ]
  },
