  "rdfs:comment": {
    "de": [
      "Im Rahmen des Sévigné-Jahres veranstaltet die in Nyons ansässige Médiathèque Départementale Drôme Provençale in Zusammenarbeit mit dem Verein La Compagnie des Remarquables eine Postkunstausstellung."
    ],
    "en": [
      "As part of the Sévigné year, the Médiathèque Départementale Drôme Provençale in Nyons is hosting a postal art exhibition in partnership with the Compagnie des Remarquables association."
    ],
    "it": [
      "Nell'ambito dell'anno del Sévigné, la Médiathèque Départementale Drôme Provençale di Nyons ospita una mostra di arte postale in collaborazione con l'associazione Compagnie des Remarquables."
    ],
    "fr": [
      "Dans le cadre de l'année Sévigné, la Médiathèque Départementale Drôme Provençale située à Nyons accueille une exposition d'art postal en partenariat avec l'association la Compagnie des Remarquables."
    ],
    "nl": [
      "In het kader van het Sévigné-jaar organiseert de Médiathèque Départementale Drôme Provençale in Nyons een tentoonstelling van postale kunst in samenwerking met de vereniging Compagnie des Remarquables."
    ],
    "es": [
      "En el marco del año Sévigné, la Médiathèque Départementale Drôme Provençale de Nyons acoge una exposición de arte postal en colaboración con la asociación Compagnie des Remarquables."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition d'art postal"
    ]
  },
