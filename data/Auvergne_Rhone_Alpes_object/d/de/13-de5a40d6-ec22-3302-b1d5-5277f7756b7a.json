  "rdfs:comment": {
    "de": [
      "Aconit widmet sich seit 1985 dem Schutz und der Aufwertung des Computererbes - Maschinen, Software und Dokumente. von der Berechnung bis zur Digitalisierung mit einem Retro-Gaming-Bereich, der die verschiedenen Generationen von Besuchern miteinander verbindet. wissen, woher man kommt...."
    ],
    "en": [
      "Since 1985, Aconit has been dedicated to safeguarding and promoting computer heritage - machines, software and documents. from computing to digital, with a retro gaming area linking different generations of visitors. knowing where we come from...."
    ],
    "it": [
      "Dal 1985, Aconit si dedica alla salvaguardia e alla promozione del patrimonio informatico: macchine, software e documenti. dall'informatica al digitale con un'area di gioco retrò che collega le diverse generazioni di visitatori. sapere da dove vieni...."
    ],
    "fr": [
      "Aconit se consacre, depuis 1985 à la sauvegarde, la valorisation du patrimoine informatique – machines, logiciels et documents. du calcul au numérique avec un espace rétro gaming reliant les différentes générations de visiteurs. savoir d'où l'on vient...."
    ],
    "nl": [
      "Sinds 1985 zet Aconit zich in voor het behoud en de promotie van het computererfgoed ? machines, software en documenten. van computer tot digitaal met een retro gaming ruimte die de verschillende generaties bezoekers met elkaar verbindt. weet waar je vandaan komt...."
    ],
    "es": [
      "Desde 1985, Aconit se dedica a preservar y promover nuestro patrimonio informático -máquinas, programas y documentos-, desde la informática hasta la tecnología digital, con una zona de juegos retro que une a distintas generaciones de visitantes. saber de dónde vienes...."
    ]
  },
