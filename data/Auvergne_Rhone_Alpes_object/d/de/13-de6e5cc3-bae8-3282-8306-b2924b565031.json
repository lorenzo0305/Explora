  "rdfs:comment": {
    "de": [
      "Familienrestaurant, das unter der Woche ein Arbeitermenü anbietet.  Freitags und samstags italienische Küche. Wir organisieren regelmäßig Abende mit einem bestimmten Gericht und auch Abende mit musikalischer Unterhaltung."
    ],
    "en": [
      "Family restaurant offering a weekday lunch special.  Italian cuisine on Fridays and Saturdays. We regularly organize evenings featuring a specific dish, as well as evenings with musical entertainment."
    ],
    "it": [
      "Ristorante a conduzione familiare che offre un menu di tipo lavorativo durante la settimana.  Il venerdì e il sabato cucina italiana. Organizziamo regolarmente serate con piatti specifici e serate con intrattenimento musicale."
    ],
    "fr": [
      "Restaurant familial proposant en semaine un menu ouvrier.  Le vendredi et samedi une cuisine italienne. Régulièrement nous organisons des soirées proposant un plat spécifique et aussi des soirées avec des animations musicales."
    ],
    "es": [
      "Restaurante familiar que ofrece un menú obrero entre semana.  Viernes y sábados cocina italiana. Organizamos regularmente veladas con un plato específico, así como veladas con animación musical."
    ],
    "nl": [
      "Familierestaurant met een doordeweeks werkmenu.  Vrijdag en zaterdag Italiaanse keuken. We organiseren regelmatig avonden met een specifiek gerecht, maar ook avonden met muzikale omlijsting."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Rêve Bleu"
    ]
  },
