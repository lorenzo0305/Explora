  "rdfs:comment": {
    "de": [
      "Christophe und Steeve heißen Sie im Weiler Bonnenuit willkommen, um ihre Käsesorten zu entdecken.\r\nBitte besuchen Sie den Laden \"La Crèmerie\", wenn Sie Käse kaufen möchten.\r\nKein Direktverkauf auf dem Bauernhof."
    ],
    "en": [
      "Christophe and Steeve welcome you to the hamlet of Bonnenuit all summer long, to discover their cheeses. The store is open all year round."
    ],
    "it": [
      "Christophe e Steeve vi danno il benvenuto nella frazione di Bonnenuit per tutta l'estate, per scoprire i loro formaggi. Il negozio è aperto tutto l'anno."
    ],
    "fr": [
      "Christophe et Steeve vous accueillent au hameau de Bonnenuit, afin de découvrir leurs fromages. \r\nMerci de vous rendre à la boutique \"La Crèmerie\" pour tout achat de fromage.\r\nPas de vente direct à la ferme."
    ],
    "es": [
      "Christophe y Steeve le dan la bienvenida a la aldea de Bonnenuit para que descubra sus quesos.\r\nPara cualquier compra de queso, visite la tienda \"La Crèmerie\".\r\nNo hay venta directa en la granja."
    ],
    "nl": [
      "Christophe en Steeve verwelkomen u de hele zomer in het gehucht Bonnenuit om hun kazen te ontdekken. De winkel is het hele jaar geopend."
    ]
  },
