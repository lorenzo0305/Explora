  "rdfs:comment": {
    "de": [
      "Die Mediathek Louise Michel bietet eine freie Konsultation von Multimediasammlungen und verschiedene Dienstleistungen an. In Verbindung mit dem soziokulturellen Zentrum von Meythet und den Vereinsinitiativen fungiert sie als Informationsstelle für die Öffentlichkeit."
    ],
    "en": [
      "The Louise Michel media library offers free consultation of multimedia collections and various services. In relation with the socio-cultural center of Meythet and associative initiatives, it is an information point for the public."
    ],
    "it": [
      "La mediateca Louise Michel offre la consultazione gratuita delle collezioni multimediali e vari servizi. In relazione al centro socio-culturale di Meythet e alle iniziative associative, è un punto di informazione per il pubblico."
    ],
    "fr": [
      "La médiathèque Louise Michel propose une libre consultation de collections multimédias et de services variés. En relation avec le centre socio-culturel de Meythet et les initiatives associatives, elle se place en point d'information pour le public."
    ],
    "es": [
      "La mediateca Louise Michel ofrece la consulta gratuita de colecciones multimedia y diversos servicios. En relación con el centro sociocultural de Meythet y las iniciativas asociativas, es un punto de información para el público."
    ],
    "nl": [
      "De mediatheek Louise Michel biedt gratis raadpleging van multimediacollecties en diverse diensten. In verband met het sociaal-cultureel centrum van Meythet en associatieve initiatieven is het een informatiepunt voor het publiek."
    ]
  },
