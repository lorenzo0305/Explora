  "rdfs:comment": {
    "de": [
      "Der durchgehend geöffnete, freundlichste Ort in Morzine mit dem \"spaßigsten\" Service des Ortes. Eine hohe Qualität der Speisen und eine \"riesige\" Auswahl!"
    ],
    "en": [
      "L'Etale Restaurant"
    ],
    "it": [
