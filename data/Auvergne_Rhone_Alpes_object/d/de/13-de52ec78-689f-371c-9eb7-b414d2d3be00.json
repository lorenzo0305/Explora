  "rdfs:comment": {
    "de": [
      "Die Galerie Mikaleff wird von Jean-Louis Mikaleff (Eigentümer und Galerist) geleitet und stellt Maler, Fotografen und Bildhauer aus.\r\nDie Galerie empfängt die Künstler auf der Grundlage des Mäzenatentums: keine Eintrittsgebühr und kein Anteil am Verkauf eines Kunstwerks."
    ],
    "en": [
      "The Mikaleff Gallery is managed by Jean-Louis Mikaleff and exhibits paintings, photographs and sculptures.\r\nThe Gallery exhibits works without receiving any fees from the artists or percentages on sales of art works."
    ],
    "it": [
      "La Galleria Mikaleff è gestita da Jean-Louis Mikaleff (proprietario-gallerista) ed espone pittori, fotografi e scultori.\r\nLa Galleria riceve gli artisti su base di mecenatismo: nessuna tassa d'ingresso o percentuale sulla vendita di un'opera."
    ],
    "fr": [
      "La Galerie Mikaleff est gérée par Jean-Louis Mikaleff (propriétaire-galeriste) et expose peintres, photographes et sculpteurs.\r\nLa Galerie reçoit les Artistes sur le mode du Mécénat : aucun droit d'entrée ni pourcentage sur la vente d'une oeuvre."
    ],
    "es": [
      "La Galería Mikaleff está dirigida por Jean-Louis Mikaleff (propietario-galerista) y expone pintores, fotógrafos y escultores.\r\nLa Galería recibe a los artistas en régimen de mecenazgo: no hay cuota de entrada ni porcentaje sobre la venta de una obra."
    ],
    "nl": [
      "De Mikaleff Gallery wordt beheerd door Jean-Louis Mikaleff (eigenaar-galerist) en stelt schilders, fotografen en beeldhouwers tentoon.\r\nDe Galerie ontvangt kunstenaars op basis van mecenaat: geen entreegeld of percentage op de verkoop van een werk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Galerie Mikaleff"
    ]
  },
