  "rdfs:comment": {
    "de": [
      "In der Brasserie Alpine LA BARATTE, einem gemütlichen Museum für Volkskunst aus den Bergen, können Sie traditionelle Käsespezialitäten, Pierrades mit 4 Fleischsorten und hausgemachte Desserts von unserem Chef Claude Trincaz probieren."
    ],
    "en": [
      "In a welcoming museum of popular mountain art, at the brasserie Alpine LA BARATTE you will taste in a traditional way: cheese specialties, 4-meat pierrades as well as desserts ENTIRELY homemade by our Chef Claude Trincaz."
    ],
    "it": [
      "In un caldo museo dell'arte popolare di montagna, alla brasserie alpina LA BARATTE potrete gustare specialità tradizionali a base di formaggio, 4 pierre di carne e dessert interamente fatti in casa dal nostro chef Claude Trincaz."
    ],
    "fr": [
      "Dans un chaleureux musée d’art populaire montagnard, à la brasserie Alpine LA BARATTE vous goûterez de façon traditionnelle : spécialités fromagères, pierrades aux 4 viandes ainsi que les desserts ENTIEREMENT faits maison par notre Chef Claude Trincaz."
    ],
    "nl": [
      "In een gezellig museum van populaire bergkunst kun je in de Alpenbrasserie LA BARATTE genieten van traditionele gerechten zoals kaasspecialiteiten, 4-vleespierrades en desserts die ENTIJD door onze chef-kok Claude Trincaz zijn gemaakt."
    ],
    "es": [
      "En un cálido museo de arte popular de montaña, en la brasserie alpina LA BARATTE degustará especialidades tradicionales de queso, 4 pierrades de carne y postres TOTALMENTE caseros elaborados por nuestro Chef Claude Trincaz."
    ]
  },
