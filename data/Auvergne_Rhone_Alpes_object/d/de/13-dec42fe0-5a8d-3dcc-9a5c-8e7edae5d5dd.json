  "rdfs:comment": {
    "de": [
      "Restaurant, Bar und Snack mit 2 Terrassen, Panoramablick, Südlage, an der Schneefront neben der ESF-Sammelstelle gelegen.\r\nUnsere Brasserie und unsere Snackbar heißen Sie täglich den ganzen Tag über willkommen."
    ],
    "en": [
      "Restaurant, bar and snack bar with 2 terraces, panoramic view, south facing, located on the snow front next to the ESF meeting point.\r\nOur brasserie and snack bar welcome you every day, all day long."
    ],
    "it": [
      "Ristorante, bar e snack bar con 2 terrazze, vista panoramica, esposto a sud, situato sul fronte della neve accanto al punto di incontro del FSE.\r\nLa nostra brasserie e il nostro snack bar vi accolgono ogni giorno, tutto il giorno."
    ],
    "fr": [
      "Restaurant, bar et snack avec 2 terrasses, vue panoramique, plein sud, situés sur le front de neige à côté du rassemblement ESF.\r\nNotre brasserie et notre snack vous accueillent tous les jours, toute la journée."
    ],
    "es": [
      "Restaurante, bar y snack bar con 2 terrazas, vista panorámica, orientación sur, situado en el frente de la nieve junto al punto de encuentro del FSE.\r\nNuestra brasserie y nuestro snack bar le dan la bienvenida todos los días, durante todo el día."
    ],
    "nl": [
      "Restaurant, café en snackbar met 2 terrassen, breed uitzicht, op het zuiden, gelegen aan het sneeuwplein naast het verzamelpunt van de ESF.\r\nOnze brasserie en snackbar verwelkomen je elke dag, de hele dag door."
    ]
  },
  "rdfs:label": {
