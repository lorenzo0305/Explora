  "rdfs:comment": {
    "de": [
      "Im Herzen der Domaine können Sie den großen, von Glasfenstern umgebenen Saal mit Blick auf das Panorama und den nahe gelegenen Wald nutzen und eine großzügige, saisonale Küche genießen."
    ],
    "en": [
      "At the heart of the Domaine, you can enjoy a large glass-roofed dining room, opening onto both the panorama and the neighboring forest, and savor generous, seasonal cuisine."
    ],
    "it": [
      "Nel cuore del Domaine si trova un'ampia sala da pranzo circondata da tetti di vetro, che si aprono sul panorama e sulla foresta vicina, dove si può gustare una cucina generosa e di stagione."
    ],
    "fr": [
      "Au cœur du Domaine, Vous pouvez profiter d’une grande salle ceinte de verrières, ouvrant à la fois sur le panorama et la forêt voisine, et déguster une cuisine généreuse et de saison."
    ],
    "nl": [
      "In het hart van het Domaine kun je genieten van een grote eetzaal omringd door glazen daken, met uitzicht op zowel het panorama als het aangrenzende bos, en genieten van de royale, seizoensgebonden keuken."
    ],
    "es": [
      "En el corazón del Domaine, podrá disfrutar de un gran comedor rodeado de techos acristalados, abiertos tanto al panorama como al bosque vecino, y saborear una generosa cocina de temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Saint Roch Hôtel & Spa"
    ]
  },
