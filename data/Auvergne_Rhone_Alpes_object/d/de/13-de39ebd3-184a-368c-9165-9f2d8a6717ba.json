  "rdfs:comment": {
    "de": [
      "Das Relais du Châtel liegt im Herzen des Forez, in Marcilly-le-Châtel, und bietet Ihnen Spezialitäten auf der Grundlage des Fourme de Montbrison, aber auch einige sehr gute Desserts dank der Konditorausbildung des Chefs."
    ],
    "en": [
      "Located in the heart of Le Forez, in Marcilly-le-Châtel, Le Relais du Châtel offers you specialities based on fourme de Montbrison (Montbrison famous round cheese), but also some very good desserts thanks to the chef's training as a pastry chef."
    ],
    "it": [
      "Situato nel cuore di Forez, il Relais du Châtel offre specialità a base di formaggio Fourme de Montbrison, ma anche ottimi dessert grazie alla formazione dello chef come pasticcere. Vivien Crozet lavora con prodotti di stagione, per lo più freschi."
    ],
    "fr": [
      "Situé en plein cœur du Forez, le Relais du Châtel vous propose des spécialités à base de fourme de Montbrison, mais aussi de bons desserts grâce à la formation de pâtissier du chef. Vivien Crozet travaille des produits de saison, majoritairement frais."
    ],
    "es": [
      "Situado en el corazón de Forez, el Relais du Châtel ofrece especialidades a base de queso Fourme de Montbrison, pero también buenos postres gracias a la formación del chef como pastelero. Vivien Crozet trabaja con productos de temporada, principalmente frescos."
    ],
    "nl": [
      "Het Relais du Châtel, gelegen in het hart van Forez, biedt specialiteiten op basis van de Fourme de Montbrison kaas, maar ook goede desserts dankzij de opleiding van de chef als patissier. Vivien Crozet werkt met seizoensgebonden producten, meestal vers."
    ]
  },
