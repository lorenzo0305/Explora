  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant und Arbeitermahlzeit. Themenmenü jeden ersten Samstagmittag im Monat, mit Spezialitäten wie Kalbskopf und Charolais, schneller Service.\r\nTake-away-Verkauf an allen Öffnungstagen möglich."
    ],
    "en": [
      "Traditional restaurant and worker's meal. Theme menu on the first Saturday of each month, with a speciality of calf's head and Charolais, quick service.\r\nTakeaway sales possible every day we are open."
    ],
    "it": [
      "Ristorante tradizionale e pasto dei lavoratori. Menù a tema il primo sabato a pranzo di ogni mese, con specialità di testina di vitello e Charolais, servizio rapido.\r\nPossibilità di asporto tutti i giorni di apertura."
    ],
    "fr": [
      "Restaurant traditionnel et repas ouvrier. Menu à thème le premier samedi midi de chaque mois, avec spécialité de tête de veau et de charolais, service rapide.\r\nVentes à emporter possible tous les jours d'ouverture."
    ],
    "nl": [
      "Traditioneel restaurant en arbeidersmaaltijd. Themamenu op de eerste zaterdagmiddag van elke maand, met specialiteit kalfskop en Charolais, snelle bediening.\r\nTakeaway beschikbaar elke dag dat we open zijn."
    ],
    "es": [
      "Restaurante tradicional y comida de trabajadores. Menú temático el primer sábado de cada mes, con especialidad en cabeza de ternera y Charolais, servicio rápido.\r\nComida para llevar disponible todos los días que estamos abiertos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Memenn"
    ]
  },
