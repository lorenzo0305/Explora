  "rdfs:comment": {
    "de": [
      "Vincent und Sébastien begrüßen Sie in ihrem neuen traditionellen Restaurant in Veyre-Monton in einer herzlichen Atmosphäre. Sie bieten eine \"hausgemachte\" Bistroküche, die frische und lokale Produkte aufwertet."
    ],
    "en": [
      "In a warm atmosphere, Vincent and Sébastien welcome you, in Veyre-Monton, in their new traditional restaurant. They will offer \"home-made\" bistro cuisine highlighting fresh and local products."
    ],
    "it": [
      "Vincent e Sébastien vi danno il benvenuto nel loro nuovo ristorante tradizionale a Veyre-Monton. Serviranno una cucina bistrot casalinga a base di prodotti freschi locali."
    ],
    "fr": [
      "Dans une ambiance chaleureuse, Vincent et Sébastien vous accueillent, à Veyre-Monton, dans leur nouveau restaurant traditionnel. Ils proposeront une cuisine bistro « faite maison » valorisant les produits frais et locaux."
    ],
    "es": [
      "Vincent y Sébastien le dan la bienvenida a su nuevo restaurante tradicional de Veyre-Monton. Servirán cocina de bistró casera elaborada con productos locales frescos."
    ],
    "nl": [
      "Vincent en Sébastien heten je welkom in hun nieuwe traditionele restaurant in Veyre-Monton. Ze serveren huisgemaakte bistrogerechten met verse streekproducten."
    ]
  },
