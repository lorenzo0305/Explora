  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/508562aa-d9ba-3bb5-9901-cc84af4b6735",
      "dc:description": {
        "de": [
          "Eine außergewöhnliche Geburtstagsfeier für Ihr Kind und seine Freunde (bis zu 9 Kinder - ab 6 Jahren). Au pré de l'âne bietet Ihnen eine Geburtstagsfeier mit Aktivitäten rund um die Welt des Esels, einer Kutschenfahrt und einem Imbiss an."
        ],
        "en": [
          "An exceptional birthday snack for your child and his/her friends (up to 9 children - from 6 years old). Au pré de l'âne offers you a birthday snack with activity on the theme of the donkey's world with a carriage ride and a snack."
        ],
        "it": [
          "Una festa di compleanno eccezionale per il vostro bambino e i suoi amici (fino a 9 bambini - a partire da 6 anni). Au pré de l'âne propone una festa di compleanno con attività sul tema del mondo degli asini con un giro in carrozza e una merenda."
        ],
        "fr": [
          "Un goûter anniversaire exceptionnel pour votre enfant et ses copains copines (jusqu’à 9 enfants- à partir de 6 ans). Au pré de l'âne vous propose un goûter d'an'niversaire avec activité sur la thématique du monde de l'âne avec balade en calèche et goûter."
        ],
        "es": [
          "Una fiesta de cumpleaños excepcional para su hijo y sus amigos (hasta 9 niños - a partir de 6 años). Au pré de l'âne ofrece una fiesta de cumpleaños con actividades sobre el tema del mundo del burro con un paseo en carroza y una merienda."
        ],
        "nl": [
          "Een uitzonderlijk verjaardagsfeestje voor uw kind en zijn vriendjes (tot 9 kinderen - vanaf 6 jaar). Au pré de l'âne biedt een verjaardagsfeestje met activiteiten rond het thema van de wereld van de ezel met een ritje in een koets en een snack."
        ]
      },
