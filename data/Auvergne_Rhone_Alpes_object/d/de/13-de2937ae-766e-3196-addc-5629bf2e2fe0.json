  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten von Sommand bietet Ihnen Le Refuge eine Sonnenterrasse. Traditionelle Küche, Brasserie, Tagesgericht, hausgemachte Pizzas, Salate, Fleisch, Waffeln... Non-Stop-Service!"
    ],
    "en": [
      "At the bottom of the slopes of Sommand, The Refuge proposes you a sunny terrace. Bar, pizzas..."
    ],
    "it": [
      "Ai piedi delle piste di Sommand, il Rifugio offre una terrazza soleggiata. Cucina tradizionale, brasserie, piatti del giorno, pizze fatte in casa, insalate, carni, waffle... Servizio non-stop!"
    ],
    "fr": [
      "Au pied des pistes de Sommand, le Refuge vous propose une terrasse ensoleillée. Cuisine traditionnelle, brasserie, plat du jour, pizzas maison, salades, viandes, gaufres... Service non stop !"
    ],
    "es": [
      "Al pie de las pistas de Sommand, el Refugio ofrece una terraza soleada. Cocina tradicional, brasserie, plato del día, pizzas caseras, ensaladas, carnes, gofres... Servicio ininterrumpido"
    ],
    "nl": [
      "Aan de voet van de pistes van Sommand heeft Le Refuge een zonnig terras. Traditionele keuken, brasserie, dagschotel, huisgemaakte pizza's, salades, vleeswaren, wafels... Non-stop service!"
    ]
  },
