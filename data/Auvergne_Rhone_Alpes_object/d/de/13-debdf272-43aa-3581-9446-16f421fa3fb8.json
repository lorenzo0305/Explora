  "rdfs:comment": {
    "de": [
      "La Carline, ein genossenschaftlicher biologischer und lokaler Lebensmittelladen, ist seit über 30 Jahren ein Schaufenster der biologischen Landwirtschaft im Diois. Sie bietet eine breite Palette an Produkten von Erzeugern und Handwerkern aus dem Departement Drôme an."
    ],
    "en": [
      "La Carline is a local, organic produce cooperative that has been showcasing the Diois organic farming production for almost 30 years. The shop offers a wide range of products grown and made in Drôme by local producers and artisans."
    ],
    "it": [
      "La Carline, una cooperativa locale di prodotti alimentari biologici, è da oltre 30 anni una vetrina per l'agricoltura biologica nella regione di Diois. Offre un'ampia gamma di prodotti di produttori e artigiani locali."
    ],
    "fr": [
      "La Carline, épicerie coopérative biologique et locale, est une vitrine de l'agriculture biologique du Diois depuis plus de 30 ans. Elle propose une large gamme de produits issus de producteurs et artisans drômois."
    ],
    "nl": [
      "La Carline, een niet-commerciële biologische lokale coöperatie, is een uithangbord voor de landbouw in de omgeving van Die (Diois). Er is een ruim assortiment van biologische boerenproducten afkomstig van producenten en ambachtslieden uit de Drôme: fruit, groente, kaas, brood, kruidenier AB, etc."
    ],
    "es": [
      "La Carline, cooperativa local de alimentación ecológica, es desde hace más de 30 años un escaparate de la agricultura ecológica en la región de Diois. Ofrece una amplia gama de productos de productores y artesanos locales."
    ]
  },
