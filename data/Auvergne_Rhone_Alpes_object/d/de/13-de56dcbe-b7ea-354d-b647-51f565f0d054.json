  "rdfs:comment": {
    "de": [
      "In einer warmen und freundlichen Atmosphäre empfangen wir Sie auf unserer großen Sonnenterrasse am Fuße der Piste. Tagesgericht, Spezialitäten, abwechslungsreiche Gerichte und Snacks den ganzen Tag über."
    ],
    "en": [
      "In a warm and friendly atmosphere, we welcome you to our large sunny terrace at the foot of the slope. Daily specials, specialties, varied dishes, and snack all day long."
    ],
    "it": [
      "In un'atmosfera calda e accogliente, vi diamo il benvenuto nella nostra grande terrazza soleggiata ai piedi della pista. Piatti del giorno, specialità, piatti variegati e spuntini tutto il giorno."
    ],
    "fr": [
      "Dans une ambiance chaleureuse et conviviale, nous vous accueillons sur notre grande terrasse ensoleillée en pied de piste. Plat du jour, spécialités, plats variés et snack toute la journée."
    ],
    "nl": [
      "In een warme en vriendelijke sfeer verwelkomen wij u op ons grote zonnige terras aan de voet van de helling. Dagschotels, specialiteiten, gevarieerde gerechten en snacks de hele dag door."
    ],
    "es": [
      "En un ambiente cálido y acogedor, le damos la bienvenida a nuestra gran terraza soleada a pie de pista. Platos del día, especialidades, platos variados y tentempiés durante todo el día."
    ]
  },
