  "rdfs:comment": {
    "de": [
      "Entdecken Sie das völlig neue Konzept des Restaurants Tipi, das ideal an der Piste von L'Aigle gelegen ist. Genießen Sie eine herrliche, nach Süden ausgerichtete Terrasse, auf der die Atmosphäre durch Auftritte von Sängern, Künstlern und DJs bestimmt wird."
    ],
    "en": [
      "Discover the brand-new concept of Restaurant Tipi, ideally located on the Aigle slope. Enjoy a magnificent south-facing terrace, where the atmosphere is punctuated by performances by singers, artists and DJs."
    ],
    "it": [
      "Scoprite il nuovissimo concept del Tipi Restaurant, situato in posizione ideale sulla pista di Aigle. Godetevi la magnifica terrazza esposta a sud, dove l'atmosfera è scandita da esibizioni di cantanti, artisti e DJ."
    ],
    "fr": [
      "Découvrez le tout nouveau concept du Restaurant Tipi, idéalement situé sur la piste de l'Aigle. Profitez d'une magnifique terrasse exposée plein sud, où l'ambiance est rythmée par des performances de chanteurs, artistes et DJs."
    ],
    "nl": [
      "Ontdek het gloednieuwe concept van het Tipi Restaurant, ideaal gelegen aan de piste van Aigle. Geniet van een prachtig terras op het zuiden, waar de sfeer wordt onderbroken door optredens van zangers, artiesten en dj's."
    ],
    "es": [
      "Descubra el nuevo concepto del Restaurante Tipi, idealmente situado en la pista de Aigle. Disfrute de una magnífica terraza orientada al sur, donde el ambiente se anima con actuaciones de cantantes, artistas y DJ."
    ]
  },
