  "rdfs:comment": {
    "de": [
      "Ich arbeite mit unbewegten und bewegten Bildern. Mit meinen Fotografien und Filmen versuche ich, eine Realität zu zeigen oder eine Vorstellung zu offenbaren."
    ],
    "en": [
      "I work with still and moving images. Through my photographs and films, I seek to show a reality or reveal an imaginary world."
    ],
    "it": [
      "Lavoro con immagini fisse e in movimento. Attraverso le mie fotografie e i miei film, cerco di mostrare una realtà o di rivelare un mondo immaginario."
    ],
    "fr": [
      "Je travaille l’image fixe et animée. A travers mes photographies et mes films, je cherche à montrer une réalité ou à révéler un imaginaire."
    ],
    "es": [
      "Trabajo con imágenes fijas y en movimiento. A través de mis fotografías y películas, intento mostrar una realidad o revelar un mundo imaginario."
    ],
    "nl": [
      "Ik werk met stilstaande en bewegende beelden. Via mijn foto's en films probeer ik een werkelijkheid te tonen of een denkbeeldige wereld te onthullen."
    ]
  },
