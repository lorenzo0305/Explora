  "rdfs:comment": {
    "de": [
      "Am Ursprung der Hospize von Lyon... (Wieder-)Entdecken Sie die Intimität zweier symbolträchtiger Gebäude auf der Lyoner Halbinsel: die Charité, die in den 1930er Jahren verschwand, und das Hôtel-Dieu, das erst kürzlich renoviert wurde."
    ],
    "en": [
      "At the origin of the hospices of Lyon... (Re)Discover the intimacy of two emblematic buildings of the Lyon peninsula: the Charité, which disappeared in the 1930s, and the Hôtel-Dieu, more recently renovated."
    ],
    "it": [
      "All'origine degli Hospices de Lyon... (Ri)scoprire l'intimità di due edifici emblematici della penisola lionese: la Charité, scomparsa negli anni '30, e l'Hôtel-Dieu, ristrutturato di recente."
    ],
    "fr": [
      "À l'origine des hospices de Lyon... (Re)Découvrez l'intimité de deux bâtiments emblématiques de la Presqu'île lyonnaise : la Charité, disparue dans les années 30, et l'Hôtel-Dieu, plus récemment rénové."
    ],
    "es": [
      "En el origen de los Hospices de Lyon... (Re)descubra la intimidad de dos edificios emblemáticos de la península de Lyon: la Charité, desaparecida en los años 30, y el Hôtel-Dieu, renovado más recientemente."
    ],
    "nl": [
      "Aan de oorsprong van de Hospices de Lyon... (Her)ontdek de intimiteit van twee emblematische gebouwen van het schiereiland Lyon: de Charité, die in de jaren 1930 verdween, en het Hôtel-Dieu, dat onlangs werd gerenoveerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dans l'intimité de l'Hôtel-Dieu et de la charité"
    ]
  },
