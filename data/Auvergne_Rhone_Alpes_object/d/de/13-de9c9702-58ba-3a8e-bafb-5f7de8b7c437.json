  "rdfs:comment": {
    "de": [
      "Benötigen Sie einen Rat, eine Idee für einen Ausflug oder eine Unterkunft? Diskutieren Sie mit uns. Sie erhalten alle Unterlagen und Empfehlungen, die Sie für einen perfekten Aufenthalt am Reiseziel benötigen!"
    ],
    "en": [
      "Looking for advice, an idea for a day out or accommodation? Come and talk to us, and we'll give you all the information and recommendations you need for a perfect stay in the destination!"
    ],
    "it": [
      "Avete bisogno di un consiglio, di un'idea per una gita o di un alloggio? Venite a parlare con noi, riceverete tutta la documentazione e le raccomandazioni necessarie per un soggiorno perfetto nella destinazione!"
    ],
    "fr": [
      "Envie d'un conseil, d'une idée sortie ou d'un hébergement ? Venez discuter avec nous, vous recevrez toute la documentation et les recommandations dont vous avez besoin pour un séjour parfait sur la destination !"
    ],
    "es": [
      "¿Necesita consejo, una idea para una excursión o alojamiento? Venga a hablar con nosotros, recibirá toda la documentación y las recomendaciones que necesita para una estancia perfecta en el destino"
    ],
    "nl": [
      "Heeft u advies, een idee voor een uitje of accommodatie nodig? Kom met ons praten, u krijgt alle documentatie en aanbevelingen die u nodig heeft voor een perfect verblijf op de bestemming!"
    ]
  },
