  "rdfs:comment": {
    "de": [
      "Das Enduro verspricht ein Gipfeltreffen auf fünf Wertungsprüfungen, die auf den besten Spots der Skigebiete Samoëns und Morillon ausgetragen werden."
    ],
    "en": [
      "The Enduro promises to be a summit event, with 5 special stages on the best spots in the Samoëns and Morillon resorts."
    ],
    "it": [
      "L'Enduro promette di essere una corsa al vertice, con 5 prove speciali nei migliori luoghi delle località di Samoëns e Morillon."
    ],
    "fr": [
      "L’Enduro promet une épreuve au sommet sur un format de 5 spéciales tracées sur les meilleurs spots des stations de Samoëns et Morillon."
    ],
    "es": [
      "El Enduro promete ser una carrera hasta la cima, con 5 etapas especiales en los mejores lugares de las estaciones de Samoëns y Morillon."
    ],
    "nl": [
      "De Enduro belooft een race naar de top te worden, met 5 speciale etappes op de beste plekken in de resorts Samoëns en Morillon."
    ]
  },
