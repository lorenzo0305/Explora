  "rdfs:comment": {
    "de": [
      "Die Auberge du Vieux Moulin bietet Ihnen eine traditionelle und großzügige Küche. Auf dem Teller werden Ihnen tausend Geschmacksrichtungen angeboten, die sich nach den Jahreszeiten und den Wünschen des Küchenchefs richten. Lassen Sie sich von der mediterranen und regionalen Küche verzaubern."
    ],
    "en": [
      "The Auberge du Vieux Moulin offers generous, traditional cuisine. On the plate, a thousand flavors are offered according to the seasons and the chef's whims. Between the Mediterranean and the terroir, let yourself be transported."
    ],
    "it": [
      "L'Auberge du Vieux Moulin offre una cucina tradizionale e generosa. Nel piatto, mille sapori vi vengono offerti in base alle stagioni e ai desideri dello chef. Tra il Mediterraneo e la terra, lasciatevi trasportare."
    ],
    "fr": [
      "L'Auberge du Vieux Moulin vous propose une cuisine traditionnelle et généreuse. Dans l'assiette, milles saveurs vous sont proposées au fil des saisons et des envies du chef. Entre méditerranée et terroir, laissez-vous transporter."
    ],
    "es": [
      "El Auberge du Vieux Moulin ofrece una cocina tradicional y generosa. En el plato, se le ofrecen mil sabores según las estaciones y los deseos del chef. Entre el Mediterráneo y la tierra, déjese transportar."
    ],
    "nl": [
      "De Auberge du Vieux Moulin biedt een genereuze, traditionele keuken. Op het bord worden duizend smaken aangeboden volgens de seizoenen en de grillen van de chef. Laat je meevoeren tussen de Middellandse Zee en het terroir."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Auberge du Vieux Moulin"
    ]
  },
