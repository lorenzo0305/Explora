  "rdfs:comment": {
    "de": [
      "Der blaue Weg ist ein für Fußgänger und Fahrräder bestimmter Weg, der 12 Kilometer Spaziergänge am Ufer der Rhône zwischen Soyons, Guilherand-Granges und Châteaubourg bietet."
    ],
    "en": [
      "This 12km trail for walkers and cyclists runs alongside the Rhone between Guilherand-Granges and Châteaubourg."
    ],
    "it": [
      "La \"voie bleue\" è un percorso dedicato a pedoni e ciclisti, che offre 12 chilometri di passeggiate lungo le rive del Rodano tra Soyons, Guilherand-Granges e Châteaubourg."
    ],
    "fr": [
      "La voie bleue est un cheminement dédié aux piétons et aux vélos qui offre 12 kilomètres de balade au bord du Rhône entre Soyons, Guilherand-Granges et Châteaubourg."
    ],
    "es": [
      "La \"voie bleue\" es un sendero dedicado a peatones y ciclistas que ofrece 12 kilómetros de paseos a orillas del Ródano entre Soyons, Guilherand-Granges y Châteaubourg."
    ],
    "nl": [
      "De \"voie bleue\" is een wandel- en fietspad van 12 kilometer langs de oevers van de Rhône tussen Soyons, Guilherand-Granges en Châteaubourg."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Blue Trail"
    ],
    "fr": [
      "La Voie Bleue"
    ]
  },
