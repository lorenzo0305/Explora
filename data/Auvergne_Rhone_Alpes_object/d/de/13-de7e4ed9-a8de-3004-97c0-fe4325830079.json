  "rdfs:comment": {
    "de": [
      "Interhome, der Spezialist für Ferienvermietungen, bietet eine große Auswahl an Unterkünften für Ferien oder Kurzaufenthalte in Chamonix, im Chamonix-Tal und anderswo in Europa."
    ],
    "en": [
      "Interhome, the vacation rental specialist, offers a wide choice of accommodation for vacations and short breaks in Chamonix, the Chamonix valley and elsewhere in Europe."
    ],
    "it": [
      "Interhome, lo specialista degli affitti turistici, offre un'ampia gamma di alloggi per vacanze e brevi soggiorni a Chamonix, nella Valle di Chamonix e altrove in Europa."
    ],
    "fr": [
      "Interhome, spécialiste de la location de vacances offre un grand choix d’hébergements pour des vacances ou courts séjours à Chamonix, dans la vallée de Chamonix et ailleurs en Europe."
    ],
    "es": [
      "Interhome, el especialista en alquileres vacacionales, ofrece una amplia gama de alojamientos para vacaciones y escapadas en Chamonix, el valle de Chamonix y otros lugares de Europa."
    ],
    "nl": [
      "Interhome, de specialist in vakantieverhuur, biedt een breed scala aan accommodaties voor vakanties en korte vakanties in Chamonix, de vallei van Chamonix en elders in Europa."
    ]
  },
