  "rdfs:comment": {
    "de": [
      "Der Museumsbereich des Caveau du Château lässt den Besucher in die Geschichte der Weinberge und Winzer des Rhônetals seit der Antike eintauchen."
    ],
    "en": [
      "The museographic space of the Caveau du Château plunges the visitor into the history of the vineyards and the winegrowers of the Rhone Valley since antiquity."
    ],
    "it": [
      "Lo spazio museografico del Caveau du Château immerge il visitatore nella storia dei vigneti e dei viticoltori della Valle del Rodano fin dall'antichità."
    ],
    "fr": [
      "L’espace muséographique du Caveau du Château plonge le visiteur dans l’histoire des vignobles et des vignerons de la Vallée du Rhône depuis l’antiquité."
    ],
    "es": [
      "El espacio museográfico del Caveau du Château sumerge al visitante en la historia de los viñedos y viticultores del valle del Ródano desde la antigüedad."
    ],
    "nl": [
      "De museografische ruimte van de Caveau du Château dompelt de bezoeker onder in de geschiedenis van de wijngaarden en wijnbouwers van de Rhône-vallei sinds de oudheid."
    ]
  },
