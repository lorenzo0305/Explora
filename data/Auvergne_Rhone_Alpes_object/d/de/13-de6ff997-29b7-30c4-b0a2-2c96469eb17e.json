  "rdfs:comment": {
    "de": [
      "Ilaria Ferrando bietet Ihnen einzigartigen Schmuck und Accessoires aus Naturstein, die der Lithotherapie gewidmet sind. Entdecken Sie in ihrem Geschäft auch lokale Designer und Kunsthandwerker mit Workshops zu Lithotherapie und Wellness."
    ],
    "en": [
      "Ilaria Ferrando offers unique jewelry and accessories in natural stone, dedicated to lithotherapy. In her boutique, you can also discover local designers and artisans, with workshops in lithotherapy and well-being."
    ],
    "it": [
      "Ilaria Ferrando propone gioielli e accessori unici in pietra naturale, dedicati alla litoterapia. La sua boutique propone anche designer e artigiani locali, con laboratori di litoterapia e benessere."
    ],
    "fr": [
      "Ilaria Ferrando vous propose des bijoux et accessoires uniques en pierre naturelle, dédiés à la lithothérapie. Dans sa boutique, découvrez aussi des créateurs et artisans locaux, avec ateliers de lithothérapie et bien-être."
    ],
    "es": [
      "Ilaria Ferrando ofrece joyas y accesorios únicos en piedra natural, dedicados a la litoterapia. Su boutique también cuenta con diseñadores y artesanos locales, con talleres de litoterapia y bienestar."
    ],
    "nl": [
      "Ilaria Ferrando biedt unieke sieraden en accessoires van natuursteen, gewijd aan lithotherapie. In haar boetiek vind je ook lokale ontwerpers en ambachtslieden, met workshops in lithotherapie en welzijn."
    ]
  },
