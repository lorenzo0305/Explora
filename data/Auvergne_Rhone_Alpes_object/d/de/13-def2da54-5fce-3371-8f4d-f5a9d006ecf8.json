  "rdfs:comment": {
    "de": [
      "Acht Bouleplätze befinden sich auf der Schneefront im Zentrum des Ortes, die neben den Bars und Restaurants für alle zugänglich sind.\r\nSchießen oder punkten, Sie haben die Wahl!\r\nFreier Zugang ohne Reservierung."
    ],
    "en": [
      "Eight petanque courts are located on the snow front in the centre of the resort, accessible to all next to the bars and restaurants.\r\nShoot or point, the choice is yours!\r\nFree access without reservation."
    ],
    "it": [
      "Otto campi da bocce sono situati sul fronte neve nel centro del resort, accessibili a tutti accanto ai bar e ai ristoranti.\r\nSparare o puntare, la scelta è vostra!\r\nAccesso gratuito senza prenotazione."
    ],
    "fr": [
      "Huit terrains de pétanque sont situés sur le front de neige du centre de la station, accessibles à tous à côté des bars et restaurants.\r\nTirez ou pointez, à vous de choisir !\r\nAccès libre sans réservation."
    ],
    "es": [
      "Ocho pistas de petanca están situadas en el frente de la nieve, en el centro de la estación, accesibles para todos junto a los bares y restaurantes.\r\nDisparar o apuntar, ¡la elección es tuya!\r\nAcceso gratuito sin reserva."
    ],
    "nl": [
      "Acht petanquebanen bevinden zich op het sneeuwdek in het centrum van het skioord, voor iedereen toegankelijk naast de bars en restaurants.\r\nSchiet of richt, de keuze is aan jou!\r\nVrije toegang zonder reservatie."
    ]
  },
