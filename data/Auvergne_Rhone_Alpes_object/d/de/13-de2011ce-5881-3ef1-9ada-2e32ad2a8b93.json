  "rdfs:comment": {
    "de": [
      "Einleitender Text :\r\nWir begrüßen Sie zum Frühstück, Mittagessen, Snacks und sonntags zum Brunch.\r\nWir verfügen über 30 Plätze auf 2 Etagen, einen Flohmarktbereich (Geschirr, Kleinmöbel)..."
    ],
    "en": [
      "Introductory text:\r\nWe welcome you for breakfast, lunch, afternoon tea and Sunday brunch.\r\nWe have 30 places on 2 floors, a second-hand goods area (crockery, small furniture)..."
    ],
    "it": [
      "Testo introduttivo:\r\nVi diamo il benvenuto per la colazione, il pranzo, il tè pomeridiano e il brunch domenicale.\r\nAbbiamo 30 posti su 2 piani, un'area dedicata all'usato (stoviglie, piccoli mobili)..."
    ],
    "fr": [
      "Texte d’introduction :\r\nNous vous accueillons pour le petit déjeuner, le déjeuner, le goûter, et pour le brunch le dimanche.\r\nNous disposons de 30 places sur 2 étages, un espace brocante (vaisselle, petits meubles)..."
    ],
    "es": [
      "Texto introductorio:\r\nLe damos la bienvenida para el desayuno, el almuerzo, el té de la tarde y el brunch del domingo.\r\nDisponemos de 30 plazas en 2 plantas, una zona de artículos de segunda mano (vajilla, pequeños muebles)..."
    ],
    "nl": [
      "Inleidende tekst:\r\nJe bent bij ons welkom voor ontbijt, lunch, afternoon tea en zondagse brunch.\r\nWe hebben 30 plaatsen op 2 verdiepingen, een ruimte voor tweedehands goederen (servies, klein meubilair)..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salon de thé : Mémé Lucette"
    ]
  },
