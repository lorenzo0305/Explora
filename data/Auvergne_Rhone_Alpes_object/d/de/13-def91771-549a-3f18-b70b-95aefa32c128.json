  "rdfs:comment": {
    "de": [
      "Dieser Kindergarten der französischen Skischule, der mit einem Förderband ausgestattet ist, befindet sich im unteren Teil des Ortes am Fuße des Sessellifts Carrets. Er bietet Kindern im Alter von 3 bis 4,5 Jahren eine erste Einführung in den Skisport."
    ],
    "en": [
      "This French Ski School kindergarten, equipped with a conveyor belt, is located at the bottom of the resort at the foot of the Carrets chairlift. It offers a first introduction to skiing for children aged 3 to 4 and a half."
    ],
    "it": [
      "Questo asilo della scuola di sci francese, dotato di un nastro trasportatore, si trova in fondo alla stazione, ai piedi della seggiovia Carrets. Offre un'introduzione allo sci per bambini dai 3 ai 4 anni e mezzo."
    ],
    "fr": [
      "Ce jardin d'enfants de l'Ecole de Ski Français, équipé d'un tapis roulant est situé en bas de station au pied du télésiège des Carrets. Il propose une première initiation au ski pour les enfants de 3 à 4 ans et demi."
    ],
    "es": [
      "Esta guardería de la Escuela Francesa de Esquí, equipada con una cinta transportadora, está situada en la parte baja de la estación, al pie del telesilla de Carrets. Ofrece una iniciación al esquí para niños de 3 a 4 años y medio."
    ],
    "nl": [
      "Deze kleuterschool van de Franse skischool, uitgerust met een lopende band, ligt onderaan het resort aan de voet van de stoeltjeslift Carrets. Het biedt een introductie tot skiën voor kinderen van 3 tot 4 en een half jaar."
    ]
  },
  "rdfs:label": {
    "en": [
      "ESF Les Saisies Carrets area kinder garden"
