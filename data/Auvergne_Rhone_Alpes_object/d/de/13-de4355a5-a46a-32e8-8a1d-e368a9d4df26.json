  "rdfs:comment": {
    "de": [
      "Japanische Estaminette, die traditionelle Familiengerichte zum Mitnehmen oder vor Ort anbietet. Le Bento jeden Mittag unter der Woche und Sushi und Maki am Wochenende. Lebensmittelgeschäft und Verkauf von handgefertigten Produkten."
    ],
    "en": [
      "Small japanese café with family traditional dishes, eat-in or take-away. Bento every weekday at lunch, sushi and maki on weekends. Sale of delicatessen and artisanal products."
    ],
    "it": [
      "Ristorante giapponese che offre piatti tradizionali della famiglia da asporto o da mangiare a casa. Bento a pranzo durante la settimana e sushi e maki nel fine settimana. Negozio di alimentari e vendita di prodotti artigianali."
    ],
    "fr": [
      "Estaminette japonaise proposant des plats traditionnels familiaux à emporter ou sur place. Le Bento tous les midis en semaine et sushi et maki le week-end. Epicerie et vente de produits artisanaux."
    ],
    "es": [
      "Restaurante japonés que ofrece platos familiares tradicionales para llevar o comer en casa. Bento todos los días entre semana y sushi y maki los fines de semana. Tienda de alimentación y venta de productos artesanales."
    ],
    "nl": [
      "Japans restaurant met traditionele familiegerechten om mee te nemen of om te eten. Bento elke middag op weekdagen en sushi en maki in het weekend. Kruidenierswinkel en verkoop van zelfgemaakte producten."
    ]
  },
