  "rdfs:comment": {
    "de": [
      "Ein Rätselspiel in den Straßen des Dorfes Albiez. Der Zauberer Ténébris hat Charlock mit einem Amnesie-Fluch belegt! Glücklicherweise haben 9 Feen, die im Dorf versteckt sind, ihre Geheimnisse bewahrt. Wenn du sie entschlüsselst, kannst du Charlocks Gedächtnis wiederherstellen"
    ],
    "en": [
      "A game of riddles in the streets of the village of Albiez. The sorcerer Ténébris has cast an amnesia spell on Charlock! Fortunately, 9 fairies hidden in the village have kept their secrets. By deciphering them, you should be able to restore Charlock's memory..."
    ],
    "it": [
      "Un gioco di enigmi per le strade del villaggio di Albiez. Lo stregone Ténébris ha lanciato un incantesimo di amnesia su Charlock! Fortunatamente, 9 fate nascoste nel villaggio hanno conservato i loro segreti: decifrandoli, sarete in grado di far tornare la memoria a Charlock?"
    ],
    "fr": [
      "Un jeu d'énigmes dans les rues du village d'Albiez. Le sorcier Ténébris a jeté un sort d’amnésie à Charlock ! Heureusement, 9 fées dissimulées dans le village ont gardé leurs secrets, en les déchiffrant, tu devrais pouvoir redonner la mémoire à Charlock…"
    ],
    "es": [
      "Un juego de acertijos en las calles del pueblo de Albiez. El brujo Ténébris ha hechizado a Charlock con amnesia Afortunadamente, 9 hadas escondidas en el pueblo han guardado sus secretos. Descifrándolos, deberías poder devolverle la memoria a Charlock?"
    ],
    "nl": [
      "Een raadselspel in de straten van het dorp Albiez. De tovenaar Ténébris heeft Charlock betoverd met geheugenverlies! Gelukkig hebben 9 feeën, verborgen in het dorp, hun geheimen bewaard. Door ze te ontcijferen, zou je Charlocks geheugen moeten kunnen herstellen?"
    ]
  },
  "rdfs:label": {
    "en": [
      "Charlock's riddles - Memory in flight"
    ],
    "fr": [
      "Les énigmes de Charlock - La mémoire envolée"
    ]
  },
