  "rdfs:comment": {
    "de": [
      "Mit mehr als 20 Jahren Erfahrung im Bereich der Fotografie wird Marianne Louge, Meilleur Ouvrier de France, Sie ins rechte Licht rücken, was auch immer Ihr Projekt sein mag."
    ],
    "en": [
      "With over 20 years' experience in photography, Marianne Louge, Meilleur Ouvrier de France, is sure to bring out the best in you, whatever your project."
    ],
    "it": [
      "Con oltre 25 anni di esperienza nel campo della fotografia, Marianne Louge, Meilleur Ouvrier de France, punterà i riflettori su di voi, qualunque sia il vostro progetto."
    ],
    "fr": [
      "Avec plus de 25 ans dans le domaine de la photographie, Marianne Louge, Meilleur Ouvrier de France, saura vous mettre en lumière quel que soit votre projet."
    ],
    "nl": [
