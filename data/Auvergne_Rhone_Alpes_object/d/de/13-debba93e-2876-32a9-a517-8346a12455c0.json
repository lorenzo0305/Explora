  "rdfs:comment": {
    "de": [
      "Pizzawagen, der eine große Auswahl an Pizzen mit Tomaten und Sahne anbietet"
    ],
    "en": [
      "Pizza truck proposing a wide range of tomato- and cream-based pizzas."
    ],
    "it": [
      "Pizza truck che offre un'ampia scelta di pizze al pomodoro e alla crema.\r\nAperto il martedì a St-Hilaire-Cusson-la Valmitte, il venerdì a Périgneux e la domenica a La Tourette."
    ],
    "fr": [
      "Camion pizza qui offre un large de choix de pizzas à base de tomates et crème.\r\nPrésent le mardi à St-Hilaire-Cusson-la Valmitte, vendredi à Périgneux et Dimanche à La Tourette."
    ],
    "nl": [
      "Pizzawagen met een ruime keuze aan pizza's op basis van tomaten en room.\r\nOp dinsdag geopend in St-Hilaire-Cusson-la Valmitte, op vrijdag in Périgneux en op zondag in La Tourette."
    ],
    "es": [
      "Pizza truck que ofrece una amplia selección de pizzas a base de tomate y nata.\r\nAbierto los martes en St-Hilaire-Cusson-la Valmitte, los viernes en Périgneux y los domingos en La Tourette."
    ]
  },
