  "rdfs:comment": {
    "de": [
      "Überhängende Aussichtsplattform mit erhabenem Blick auf den See von Mont-Cenis und weit darüber hinaus. Im Winter ist sie nur für Skifahrer zugänglich (Gipfel des Skigebiets), im Sommer für Wanderer und Mountainbiker, vom Sessellift Solert aus."
    ],
    "en": [
      "Panoramic platform overhanging with sublime views of Lake Mont-Cenis and beyond. In winter, it is accessible by the ski slopes, and in summer, it is accessible on foot, for hikers, from the chairlift of Solert."
    ],
    "it": [
      "Piattaforma panoramica a strapiombo con vista sublime sul Lago di Mont-Cenis e oltre. In inverno, è accessibile dalle piste da sci e, in estate, è accessibile a piedi, per escursionisti, dalla seggiovia di Solert."
    ],
    "fr": [
      "Plateforme panoramique en surplomb avec vue sublime sur le lac du Mont-Cenis et bien au-delà. En hiver, elle est accessible aux skieurs uniquement (sommet du domaine skiable) et en été, aux randonneurs et vététistes, depuis le télésiège du Solert."
    ],
    "es": [
      "Una plataforma panorámica con vistas al lago de Mont-Cenis y más allá. En invierno, es accesible sólo para los esquiadores (parte superior de la zona de esquí) y en verano, para los excursionistas y ciclistas de montaña, desde el telesilla de Solert."
    ],
    "nl": [
      "Overhangend panoramisch platform met een subliem uitzicht op het meer van Mont-Cenis en ver daarbuiten. In de winter is het alleen toegankelijk voor skiërs (top van het skigebied) en in de zomer voor ervaren wandelaars vanaf de Solert-stoeltjeslift."
    ]
  },
