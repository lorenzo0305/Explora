  "rdfs:comment": {
    "de": [
      "Die GAEC du Domaine des Cuins ist ein Familienbetrieb, der seit 1944 besteht. Er ist auf den Anbau von Mais für Kleintierfutter (pet food) und menschliche Ernährung (Grieß) spezialisiert."
    ],
    "en": [
      "The GAEC du Domaine des Cuins is a family business that has been in existence since 1944. It specializes in corn for small animals (pet food) and human consumption (semolina)."
    ],
    "it": [
      "La GAEC du Domaine des Cuins è un'azienda familiare che esiste dal 1944. È specializzata in mais per piccoli animali (cibo per animali) e per il consumo umano (semola)."
    ],
    "fr": [
      "Le GAEC du Domaine des Cuins est une exploitation familiale qui existe depuis 1944. Il est spécialisé dans le maïs à destination de l’alimentation des petits animaux (pet food) et l’alimentation humaine (semoulerie)."
    ],
    "es": [
      "El GAEC du Domaine des Cuins es una empresa familiar que existe desde 1944. Está especializada en maíz para pequeños animales (alimentos para mascotas) y consumo humano (sémola)."
    ],
    "nl": [
      "De GAEC du Domaine des Cuins is een familiebedrijf dat al sinds 1944 bestaat. Het is gespecialiseerd in maïs voor kleinvee (petfood) en menselijke consumptie (griesmeel)."
    ]
  },
  "rdfs:label": {
    "fr": [
