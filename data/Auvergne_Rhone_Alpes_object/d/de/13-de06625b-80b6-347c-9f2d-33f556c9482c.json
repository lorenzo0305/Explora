  "rdfs:comment": {
    "de": [
      "Val, eine professionelle Fotografin, bietet Ihnen natürliche und lebendige Porträts, weit weg von statischen Posen und erzwungenem Lächeln. Mit der Familie, als Paar, allein oder zu mehreren, mit Ihrem Haustier..."
    ],
    "en": [
      "Val, a professional photographer, offers you natural, lively portraits, far from static poses and forced smiles. As a family, a couple, alone or together, with your pet..."
    ],
    "it": [
      "Val, fotografa professionista, vi offre ritratti naturali e vivaci, lontani da pose statiche e sorrisi forzati. In famiglia, in coppia, da soli o con gli amici, con il vostro animale domestico..."
    ],
    "fr": [
      "Val, photographe professionnelle, vous propose des portraits naturels et vivants, loin des poses statiques et des sourires forcés. En famille, en couple, seul(e) ou à plusieurs, avec votre animal de compagnie..."
    ],
    "es": [
      "Val, fotógrafa profesional, te ofrece retratos naturales y llenos de vida, alejados de poses estáticas y sonrisas forzadas. En familia, en pareja, solo o con amigos, con tu mascota..."
    ],
    "nl": [
      "Val, een professionele fotografe, biedt je natuurlijke, levendige portretten, ver weg van statische poses en geforceerde glimlachen. Als gezin, als koppel, alleen of met vrienden, met je huisdier..."
    ]
  },
