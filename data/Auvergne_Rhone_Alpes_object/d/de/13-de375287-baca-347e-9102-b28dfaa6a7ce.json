  "rdfs:comment": {
    "de": [
      "Mountainbike-Fans finden ihr Glück im Espace VTT du Massif des Bois Noirs, einem bemerkenswerten Naturgebiet, das ständig 76 Strecken und ein 1520 km langes Netz von ausgeschilderten, gepflegten und mit dem FFC-Label versehenen Strecken anbietet, die in 26 Gemeinden beginnen."
    ],
    "en": [
      "Mountain bikers will be delighted with the Espace VTT du Massif des Bois Noirs, a remarkable natural site offering 76 permanent circuits and a network of 1,520 km of signposted, maintained, FFC-approved routes starting from 26 communes."
    ],
    "it": [
      "Gli appassionati di mountain bike saranno entusiasti dell'Espace VTT du Massif des Bois Noirs, un sito naturale straordinario che offre 76 circuiti permanenti e una rete di 1.520 km di percorsi segnalati, mantenuti e approvati dalla FFC che partono da 26 comuni."
    ],
    "fr": [
      "Les amateurs de VTT trouveront leur bonheur avec l’Espace VTT du Massif des Bois Noirs, un site naturel remarquable, offre en permanence 76 circuits et un réseau de 1520 kms de circuits fléchés, entretenus et labellisés FFC au départ de 26 communes."
    ],
    "nl": [
      "Mountainbikers kunnen hun hart ophalen in het Espace VTT du Massif des Bois Noirs, een opmerkelijk natuurgebied met 76 permanente circuits en een netwerk van 1.520 km bewegwijzerde, onderhouden en door het FFC goedgekeurde routes vanuit 26 gemeenten."
    ],
    "es": [
      "Los ciclistas de montaña estarán encantados con el Espace VTT du Massif des Bois Noirs, un extraordinario paraje natural que ofrece 76 circuitos permanentes y una red de 1.520 km de rutas señalizadas, mantenidas y homologadas por la FFC que parten de 26 municipios."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace VTT-FFC du Massif des Bois Noirs"
    ]
  },
