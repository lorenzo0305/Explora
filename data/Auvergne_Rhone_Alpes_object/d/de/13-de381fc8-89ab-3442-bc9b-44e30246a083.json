  "rdfs:comment": {
    "de": [
      "La porte de l'Orient in Courchevel im Hotel Saint Joseph. Die Dekoration erinnert an das Shanghai der 30er Jahre und in der Küche zeigt sich das Talent des Küchenchefs Koy, der ein Meister in der delikaten Kochkunst mit exotischen Geschmäckern ist."
    ],
    "ru": [
      "Ресторан Porte de l'Orient в Куршевеле в отеле Saint Joseph. Интерьер напоминает Шанхай 1930-х годов, а на кухне проявляется весь талант шеф-повара Коя, мастера тонкого искусства экзотических ароматов."
    ],
    "en": [
      "Oriental flavour in Courchevel at the Saint Joseph hotel. Decoration reminiscent of the Shanghai of the 1930s and, in the kitchen, all the talent of Chef Koy, a master in the delicate art of exotic flavors."
    ],
    "it": [
      "La porta dell'Oriente a Courchevel si trova all'Hotel Saint Joseph. La decorazione si ispira alla Shangai degli anni ‘30. Nella cucina, troverete tutto il talento dello chef Koy, maestro della delicata arta dei sapori esotici."
    ],
    "fr": [
      "La porte de l'Orient à Courchevel à l'hôtel Saint Joseph. Décoration rappelant le Shangai des années 30 et, en cuisine, tout le talent du chef Koy, passé maître dans l'art délicat des saveurs exotiques."
    ],
    "zh": [
      "Saint Joseph是高雪维尔通向东方之门。内部装修令人忆起30年代的上海，大厨Koy则是精致异国风味的烹饪大师。"
    ],
    "es": [
      "La Porte de l'Orient en Courchevel en el hotel Saint Joseph. Por un lado, la decoración evoca el Shanghái de los años 30; por otro lado, la cocina cuenta con todo el talento del chef Koy, un gran maestro en el delicado arte de los sabores exóticos."
    ],
    "nl": [
      "De poort naar het Oosten in Courchevel in Hôtel Saint Joseph. De keuken is ingericht in een stijl die doet denken aan het Shanghai van de jaren 1930 en wordt gekenmerkt door het talent van chef-kok Koy, een meester in de delicate kunst van exotische smaken."
    ]
  },
