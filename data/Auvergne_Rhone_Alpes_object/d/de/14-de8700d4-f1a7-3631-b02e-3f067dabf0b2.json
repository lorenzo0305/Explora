  "rdfs:comment": {
    "de": [
      "Die Verwandlung der Störche ist die gewalttätige und leichtfüßige Geschichte eines Mannes, der in vier Wänden eingesperrt ist und vor einem leeren Becher steht."
    ],
    "en": [
      "The Metamorphosis of the Storks is the violent and light story of a man locked between four walls facing an empty cup."
    ],
    "it": [
      "La metamorfosi delle cicogne è la storia violenta e scanzonata di un uomo intrappolato tra quattro pareti davanti a una tazza vuota."
    ],
    "fr": [
      "La Métamorphose des cigognes est l’histoire violente et légère d’un homme enfermé entre quatre murs face à un gobelet vide."
    ],
    "es": [
      "La metamorfosis de las cigüeñas es la historia violenta y desenfadada de un hombre atrapado entre cuatro paredes frente a una copa vacía."
    ],
    "nl": [
      "De Metamorfose van de Ooievaars is het gewelddadige en lichtvoetige verhaal van een man die gevangen zit tussen vier muren voor een lege beker."
    ]
  },
