  "rdfs:comment": {
    "de": [
      "Traditionelle Käserei und Feinkostladen. Käsebar jeden Mittag und Abendservice freitags und samstags. Verkostung von Fondue, Raclette, Käseplatte."
    ],
    "en": [
      "Traditional cheese shop and delicatessen. Cheese bar every lunchtime and evening service on Fridays and Saturdays. Fondue, raclette and cheese platter tastings."
    ],
    "it": [
      "Negozio di formaggi e gastronomia tradizionale. Cheese bar a pranzo e servizio serale il venerdì e il sabato. Degustazione di fonduta, raclette e taglieri di formaggi."
    ],
    "fr": [
      "Fromagerie traditionnelle et épicerie fine. Bar à fromages tous les midis et service le soir les vendredis et samedis. Dégustation de fondue, raclette, plateau de fromages."
    ],
    "nl": [
      "Traditionele kaaswinkel en delicatessenzaak. Kaasbar elke middag en avondbediening op vrijdag en zaterdag. Proeverij van fondue, raclette en kaasplateaus."
    ],
    "es": [
      "Quesería y charcutería tradicional. Barra de quesos todos los mediodías y servicio nocturno los viernes y sábados. Degustación de fondue, raclette y tabla de quesos."
    ]
  },
