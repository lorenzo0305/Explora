  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Aux 2 coqs\" Rotisserie und großes All-you-can-eat-Buffet ideal für Ihr Mittagessen mit der Familie, in der Gruppe oder beruflich. Große Terrasse im Park in ruhiger und angenehmer Lage hinter dem Restaurant an den Ufern der Loire."
    ],
    "en": [
      "Restaurant \"Aux 2 coqs\" rotisserie and large all-you-can-eat buffet ideal for family, group or business lunches. Large terrace in the quiet park behind the restaurant on the banks of the Loire."
    ],
    "it": [
      "Ristorante \"Aux 2 coqs\" con rosticceria e grande buffet a volontà, ideale per pranzi in famiglia, di gruppo o di lavoro. Ampia terrazza nel parco, in un ambiente tranquillo e piacevole dietro il ristorante sulle rive della Loira."
    ],
    "fr": [
      "Le Restaurant \"Aux 2 coqs\" rôtisserie et grand buffet à volonté idéal pour vos déjeuners en famille, en groupe ou professionnels. Grande terrasse dans le parc situé au calme et dans un cadre agréable à l'arrière du restaurant des bords de Loire."
    ],
    "es": [
      "Restaurante \"Aux 2 coqs\" asador y gran buffet libre ideal para comidas familiares, de grupo o de negocios. Gran terraza en el parque, en un entorno tranquilo y agradable detrás del restaurante a orillas del Loira."
    ],
    "nl": [
      "Restaurant \"Aux 2 coqs\" rotisserie en groot all-you-can-eat buffet ideaal voor familie-, groeps- of zakenlunches. Groot terras in het park, in een rustige en aangename omgeving achter het restaurant aan de oevers van de Loire."
    ]
  },
