  "rdfs:comment": {
    "de": [
      "Die Köchin Ryma Prost-Romand serviert Gerichte, die von ihrer Herkunft und ihren Studienreisen in Skandinavien inspiriert sind: eine Fusionsküche zwischen Mittelmeer und Nordsee."
    ],
    "en": [
      "Ryma Prost-Romand is a chef creating dishes inspired by her origins and her trips and studies to Scandinavia: fusion cuisine combining the Mediterranean and the North Sea."
    ],
    "it": [
      "Ryma Prost-Romand è una chef che propone piatti ispirati alle sue origini e ai suoi viaggi di studio in Scandinavia: una fusione tra Mediterraneo e mari del Nord, con un occhio di riguardo ai prodotti di stagione."
    ],
    "fr": [
      "Ryma Prost-Romand est une cheffe qui propose des plats inspirés de ses origines et de ses voyages d’études en Scandinavie : une cuisine fusion entre les mers Méditerranée et du Nord en prenant soin de travailler en respectant la saisonnalité."
    ],
    "nl": [
      "Ryma Prost-Romand is een chef-kok die gerechten serveert die geïnspireerd zijn door haar afkomst en haar studiereizen naar Scandinavië: een samensmelting van de Middellandse Zee en de Noordzee, met oog voor seizoensproducten."
    ],
    "es": [
      "Ryma Prost-Romand es una chef que ofrece platos inspirados en sus orígenes y en sus viajes de estudios a Escandinavia: una fusión del Mediterráneo y los mares del Norte, con la mirada puesta en los productos de temporada."
    ]
  },
