  "rdfs:comment": {
    "de": [
      "Das BEST WESTERN l'Atelier 117 Hotel & Restaurant verfügt über einen Designrahmen mit 42 komfortablen und funktionalen Zimmern.\r\nSie werden von einem hilfsbereiten Team, das Ihnen zuhört, mit Begeisterung empfangen."
    ],
    "en": [
      "The BEST WESTERN l'Atelier 117 Hotel & Restaurant offers a designer setting, with 42 comfortable, functional rooms.\r\nYou'll be warmly welcomed by our friendly and attentive staff."
    ],
    "it": [
      "Il BEST WESTERN l'Atelier 117 Hotel & Restaurant ha un ambiente di design con 42 camere confortevoli e funzionali.\r\nSarete accolti con entusiasmo da un team pronto ad ascoltarvi."
    ],
    "fr": [
      "Le BEST WESTERN l'Atelier 117 Hotel & Restaurant dispose d'un cadre design comprenant 42 chambres confortables et fonctionnelles.\r\nVous serez accueilli avec enthousiasme par une équipe disponible et à votre écoute."
    ],
    "nl": [
      "Het BEST WESTERN l'Atelier 117 Hotel & Restaurant heeft een designomgeving met 42 comfortabele en functionele kamers.\r\nU wordt enthousiast ontvangen door een team dat klaarstaat om naar u te luisteren."
    ],
    "es": [
      "El BEST WESTERN l'Atelier 117 Hotel & Restaurant dispone de un entorno de diseño con 42 habitaciones cómodas y funcionales.\r\nSerá recibido con entusiasmo por un equipo dispuesto a escucharle."
    ]
  },
