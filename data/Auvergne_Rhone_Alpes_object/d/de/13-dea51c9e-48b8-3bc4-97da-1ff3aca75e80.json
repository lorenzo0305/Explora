  "rdfs:comment": {
    "de": [
      "Bar-Restaurant im Weiler La Chal.\r\nHandwerkliche und regionale Küche auf der Grundlage von Qualitätsprodukten.\r\nHausgemachte Crêpes, handgemachtes Eis, Bio-Kräutertees aus Arves, Weine, Käse und Wurstwaren aus der Region, die Sie auf einer herrlichen Panoramaterrasse genießen können."
    ],
    "en": [
      "Bar-restaurant in the hamlet of La Chal.\r\nTraditional, regional cuisine made with quality ingredients.\r\nHomemade crêpes, artisanal ice cream, organic herbal teas from Les Arves, local wines, cheeses and charcuterie to enjoy on a superb panoramic terrace."
    ],
    "it": [
      "Bar-ristorante nella frazione di La Chal.\r\nCucina tradizionale e regionale a base di prodotti di qualità.\r\nCrepes fatte in casa, gelati artigianali, tisane biologiche di Arves, vini locali, formaggi e salumi da gustare sulla splendida terrazza panoramica."
    ],
    "fr": [
      "Bar-restaurant au hameau de La Chal. \r\nCuisine artisanale et régionale à base de produits de qualité. \r\nCrêpes maison, glaces artisanales, infusions bio des Arves, vins, fromages et charcuteries du terroir à déguster sur une superbe terrasse panoramique."
    ],
    "es": [
      "Bar-restaurante en la aldea de La Chal.\r\nCocina tradicional y regional basada en productos de calidad.\r\nCrepes caseros, helados artesanos, tisanas ecológicas de Arves, vinos locales, quesos y embutidos para degustar en la magnífica terraza panorámica."
    ],
    "nl": [
      "Bar-restaurant in het gehucht La Chal.\r\nAmbachtelijke en regionale keuken op basis van kwaliteitsproducten.\r\nHuisgemaakte crêpes, ambachtelijk ijs, biologische kruidenthee uit Les Arves, wijnen, kazen en vleeswaren uit de streek om van te genieten op een prachtig panoramisch terras."
    ]
  },
