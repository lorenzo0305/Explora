  "rdfs:comment": {
    "de": [
      "Entdecken Sie das innere Gleichgewicht mit Kundalini Yoga, Pränatal Yoga und Yoga auf dem Stuhl. Doula, Coach für ayurvedische Ernährung, Gruppenkurse im Maison Be-sun, Pränatales Yoga im Phenix-Zentrum. Doula-Betreuung und personalisierte Kurse zu Hause für Mütter und Familien."
    ],
    "en": [
      "Discover inner balance with Kundalini Yoga, Prenatal Yoga and Chair Yoga. Doula, ayurvedic nutrition coach, group classes at Maison Be-sun, prenatal yoga at the Phenix center. Follow-up doula and personalized home classes for moms and families"
    ],
    "it": [
      "Scoprite l'equilibrio interiore con il Kundalini Yoga, lo Yoga Prenatale e il Chair Yoga. Doula, coach nutrizionale ayurvedico, corsi di gruppo alla Maison Be-sun, yoga prenatale al centro Phenix. Doula di follow-up e lezioni a domicilio personalizzate per madri e famiglie"
    ],
    "fr": [
      "Découvrez l'équilibre intérieur avec Yoga Kundalini, Yoga Prénatal et Yoga sur chaise. Doula, coach nutrition ayurvédique, cours collectifs à Maison Be-sun, Yoga Prénatal au centre Phenix. Suivi doula et cours personnalisés à domicile pour mamans familles"
    ],
    "nl": [
      "Ontdek innerlijke balans met Kundalini Yoga, prenatale yoga en stoelyoga. Doula, ayurvedische voedingscoach, groepslessen in Maison Be-sun, prenatale yoga in het Phenix-centrum. Follow-up doula en gepersonaliseerde thuislessen voor moeders en gezinnen"
    ],
    "es": [
      "Descubra el equilibrio interior con Kundalini Yoga, yoga prenatal y yoga en silla. Doula, coach de nutrición ayurvédica, clases en grupo en la Maison Be-sun, yoga prenatal en el centro Phenix. Doula de seguimiento y clases personalizadas a domicilio para madres y familias"
    ]
  },
