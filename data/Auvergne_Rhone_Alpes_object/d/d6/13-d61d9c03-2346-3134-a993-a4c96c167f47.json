  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt bietet folgende Dienstleistungen an:\r\n- Touristeninformationen\r\n- Kartenverkauf für Aufführungen\r\n- Verkauf von Angelscheinen und Zugang zu Tennisplätzen\r\n- Geführte Besichtigungen\r\n- Kostenloser Wifi-Zugang\r\n- Verkauf von einigen Artikeln (Bücher, Masken...)"
    ],
    "en": [
      "The Tourist Office offers the following services:\r\n- Tourist information\r\n- Tickets for shows\r\n- Sale of fishing permits and access to tennis courts\r\n- Guided tours\r\n- Free Wifi access\r\n- Sale of certain items (books, masks, etc.)"
    ],
    "it": [
      "L'Ufficio del Turismo offre i seguenti servizi\r\n- Informazioni turistiche\r\n- Biglietteria per gli spettacoli\r\n- Vendita di permessi di pesca e accesso ai campi da tennis\r\n- Visite guidate\r\n- Accesso Wifi gratuito\r\n- Vendita di alcuni articoli (libri, maschere...)"
    ],
    "fr": [
      "L'Office de Tourisme propose les services suivants :\r\n- Informations touristiques\r\n- Billetterie spectacles\r\n- Vente de permis de pêche et accès aux terrains de tennis\r\n- Visites guidées\r\n- Accès Wifi gratuit\r\n- Vente de quelques articles (livres, masques...)"
    ],
    "es": [
      "La Oficina de Turismo ofrece los siguientes servicios\r\n- Información turística\r\n- Venta de entradas para espectáculos\r\n- Venta de permisos de pesca y acceso a las pistas de tenis\r\n- Visitas guiadas\r\n- Acceso Wifi gratuito\r\n- Venta de algunos artículos (libros, máscaras...)"
    ],
    "nl": [
      "Het VVV-kantoor biedt de volgende diensten:\r\n- Toeristische informatie\r\n- Tickets voor voorstellingen\r\n- Verkoop van visvergunningen en toegang tot tennisbanen\r\n- Rondleidingen met gids\r\n- Gratis Wi-Fi-toegang\r\n- Verkoop van bepaalde artikelen (boeken, maskers, enz.)"
    ]
  },
