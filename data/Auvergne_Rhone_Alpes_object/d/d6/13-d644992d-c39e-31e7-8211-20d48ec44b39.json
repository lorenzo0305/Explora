  "rdfs:comment": {
    "de": [
      "Das Village by CA Centre-Est empfängt Sie, um Ihre Veranstaltungen in einem einzigartigen und individuell gestaltbaren Rahmen zu organisieren. Das Auditorium und die Tagungsräume sind ideal für Ihre Plenarsitzungen, Workshops oder Cocktailpartys."
    ],
    "en": [
      "The Village by CA Centre-Est welcomes you to organise your events in a unique and customisable setting. The auditorium and meeting rooms are ideal for your plenary sessions, workshops or cocktail parties."
    ],
    "it": [
      "Il Village by CA Centre-Est vi accoglie per organizzare i vostri eventi in un ambiente unico e personalizzabile. L'auditorium e le sale riunioni sono ideali per le vostre sessioni plenarie, i workshop o i cocktail party."
    ],
    "fr": [
      "Le Village by CA Centre-Est vous accueille pour organiser vos événements dans un cadre unique et personnalisable. L’auditorium et les salles de réunion sont idéaux pour vos plénières, ateliers ou cocktails."
    ],
    "nl": [
      "The Village by CA Centre-Est verwelkomt u om uw evenementen te organiseren in een unieke en aanpasbare omgeving. Het auditorium en de vergaderzalen zijn ideaal voor uw plenaire sessies, workshops of cocktailparty's."
    ],
    "es": [
      "El Village by CA Centre-Est le da la bienvenida para organizar sus eventos en un marco único y personalizable. El auditorio y las salas de reuniones son ideales para sus sesiones plenarias, talleres o cócteles."
    ]
  },
