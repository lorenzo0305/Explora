  "rdfs:comment": {
    "de": [
      "Le Monde du Macaron bietet handgemachte Makronen, Schokolade, Kekse und Heißgetränke an. Genießen Sie sie vor Ort in einem Cocooning-Bereich oder nehmen Sie sie für einen Schlemmerspaziergang mit."
    ],
    "en": [
      "Le Monde du Macaron offers artisan macaroons, chocolates, cookies and hot drinks. Enjoy them on site in a cocooning space, or take them away for a gourmet stroll."
    ],
    "it": [
      "Le Monde du Macaron offre macaron tradizionali, cioccolatini, biscotti e bevande calde. Potete gustarli in uno spazio accogliente o portarli via per una gita gastronomica."
    ],
    "fr": [
      "Le Monde du Macaron propose macarons artisanaux, chocolats, biscuits et boissons chaudes. À déguster sur place dans un espace cocooning ou à emporter pour une balade gourmande."
    ],
    "es": [
      "Le Monde du Macaron ofrece macarons tradicionales, chocolates, galletas y bebidas calientes. Puede disfrutarlos en un espacio acogedor o llevárselos para una salida gourmet."
    ],
    "nl": [
      "Le Monde du Macaron biedt traditionele macarons, bonbons, koekjes en warme dranken. Geniet ervan in een gezellige ruimte of neem ze mee voor een gastronomisch uitje."
    ]
  },
