  "rdfs:comment": {
    "de": [
      "Die seit 2021 in Autrans ansässige Destillerie L'Entropie bietet Kräuterspirituosen an. David und Léa liegt es am Herzen, die Destillation, ihren Destillierapparat und die Verfahren zur Herstellung ihrer Getränke zu präsentieren."
    ],
    "en": [
      "Established in Autrans in 2021, l’Entropie distillery offers plant-based spirits. David and Léa are keen to showcase distillation, their still and the processes involved in making their drinks."
    ],
    "it": [
      "Fondata ad Autrans nel 2021, la distilleria Entropie produce liquori a base vegetale. Il team è intenzionato a mostrare i processi di distillazione, alambicco e produzione di bevande della distilleria."
    ],
    "fr": [
      "Installée à Autrans depuis 2021, la distillerie l'Entropie propose des spiritueux de plantes. L'équipe a à cœur de présenter la distillation, l'alambic et les procédés de fabrication des boissons de la distillerie."
    ],
    "es": [
      "Fundada en Autrans en 2021, la destilería Entropie produce bebidas espirituosas de origen vegetal. El equipo quiere mostrar los procesos de destilación, alambique y elaboración de bebidas de la destilería."
    ],
    "nl": [
      "De distilleerderij Entropie, opgericht in Autrans in 2021, produceert gedistilleerde dranken op plantaardige basis. Het team wil graag de distillatie-, distilleer- en drankproductieprocessen van de distilleerderij laten zien."
    ]
  },
  "rdfs:label": {
    "de": [
      "L'Entropie - wilde Destillerie"
    ],
    "en": [
      "L’Entropie - wild distillery"
    ],
    "fr": [
      "L'Entropie - distillerie sauvage"
    ]
  },
