  "rdfs:comment": {
    "de": [
      "In Partnerschaft mit dem territorialen Leseservice und dem CADA von Langeac. Jeder kann mit einem Text in einer Sprache von hier oder anderswo kommen, zum Lesen, zum Singen, um unsere Ohren zu kitzeln."
    ],
    "en": [
      "In partnership with the territorial reading service and CADA Langeac. Everyone can come along with a text in a local or foreign language, to read or sing, to tickle our ears."
    ],
    "it": [
      "In collaborazione con il servizio di lettura territoriale e la CADA di Langeac. Tutti possono venire con un testo in lingua locale o straniera, da leggere o cantare, per solleticare le nostre orecchie."
    ],
    "fr": [
      "En partenariat avec le service lecture territorial et le CADA de Langeac. Chacun peut venir avec un texte dans une langue d'ici ou d'ailleurs, à lire, à chanter, pour chatouiller nos oreilles."
    ],
    "nl": [
      "In samenwerking met de Territoriale Voorleesdienst en het CADA in Langeac. Iedereen kan meekomen met een tekst in een lokale of vreemde taal, om voor te lezen of te zingen, om onze oren te prikkelen."
    ],
    "es": [
      "En colaboración con el servicio territorial de lectura y el CADA de Langeac. Todo el mundo puede venir con un texto en una lengua local o extranjera, para leer o cantar, para hacernos cosquillas en los oídos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poésie sans frontière"
    ]
  },
