  "rdfs:comment": {
    "de": [
      "La Parenthèse, ein einzigartiges Spa auf 1600m²: Sothys-Behandlungen für eine Wohlfühlpause, ein Aqua-Entspannungsbereich für totale Entspannung und ein Aqua-Spielbereich für unvergessliche Momente mit der Familie. Gönnen Sie sich einen zeitlosen Moment im Herzen von Aix Riviera."
    ],
    "en": [
      "La Parenthèse, a unique 1,600m² spa: Sothys treatments for a wellness break, an aqua-relaxation area for total relaxation and an aqua-play area for unforgettable family moments. Treat yourself to a timeless moment in the heart of the Aix Riviera."
    ],
    "it": [
      "La Parenthèse, una spa unica di 1.600 m²: trattamenti Sothys per una pausa di benessere, un'area acquatica per un relax totale e un'area giochi acquatici per momenti indimenticabili in famiglia. Concedetevi un momento senza tempo nel cuore della Riviera di Aix."
    ],
    "fr": [
      "La Parenthèse, un spa unique de 1600m² : soins Sothys pour une pause bien-être, espace aqua-détente pour une relaxation totale et espace aqua-ludique pour des moments inoubliables en famille. Offrez-vous un instant hors du temps au cœur de Aix Riviera."
    ],
    "es": [
      "La Parenthèse, un spa único de 1.600 m²: tratamientos Sothys para una pausa de bienestar, zona de relajación acuática para una relajación total y zona de diversión acuática para momentos inolvidables en familia. Regálese un momento intemporal en el corazón de la Riviera de Aix."
    ],
    "nl": [
      "La Parenthèse, een unieke spa van 1600 m²: behandelingen van Sothys voor een wellnessvakantie, een aqua-ontspanningsruimte voor totale ontspanning en een aqua-plezierruimte voor onvergetelijke gezinsmomenten. Trakteer jezelf op een tijdloos moment in het hart van de Aix Riviera."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Parenthèse - Spa/Well-being Centre"
    ],
    "it": [
      "La Parenthèse - Spa / Centro benessere"
    ],
    "fr": [
      "Spa La Parenthèse"
    ]
  },
