  "rdfs:comment": {
    "de": [
      "Die Boutique Constellation stellt Handwerker & Künstler und ihr Know-how an einem warmen und einladenden Ort in der Fußgängerzone in der Oberstadt von Laon ins Rampenlicht. Einzelstücke oder Kleinserien, die von lokalen Handwerkern und Künstlern hergestellt werden!"
    ],
    "en": [
      "The Constellation boutique showcases artisans & artists and their skills in a warm and welcoming location on the pedestrian street in Laon's upper town. One-of-a-kind pieces or small series made by local craftsmen and artists!"
    ],
    "it": [
      "La boutique Constellation mette in mostra artigiani e artisti e le loro abilità in un ambiente caldo e accogliente nella via pedonale della città alta di Laon. Pezzi unici o piccole serie realizzate da artigiani e artisti locali!"
    ],
    "fr": [
      "La boutique Constellation met en lumière des artisans & des artistes et leur savoir-faire dans un lieu chaleureux et accueillant de la rue piétonne située en ville haute de Laon. Des pièces uniques ou en petites séries réalisées par des artisans et des artistes locaux !"
    ],
    "es": [
      "La boutique Constellation presenta a artesanos y artistas y sus habilidades en un ambiente cálido y acogedor en la calle peatonal de la parte alta de Laon. Piezas únicas o pequeñas series realizadas por artesanos y artistas locales"
    ],
    "nl": [
      "De Constellation boetiek toont ambachtslieden en kunstenaars en hun vaardigheden in een warme en gastvrije omgeving in de autovrije straat in de bovenstad van Laon. Unieke stukken of kleine series gemaakt door lokale ambachtslieden en kunstenaars!"
    ]
  },
