  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant an der Bergstation der Seilbahn Floria. \r\nSonnenterasse mit Sicht auf das Tal.\r\nFußgänger- und Skifahrerzugang über die Seilbahn Floria."
    ],
    "en": [
      "Traditional cooking and fast food at the top of La Floria chair lift. Sunny terrace overlooking the valley. Access by ski or foot with La Floria chair lift."
    ],
    "it": [
      "Ristorante tradizionale e fast-food in cima alla seggiovia Floria. Terrazza soleggiata con vista sulla valle.\r\nAccesso pedonale e per sciatori tramite la seggiovia Floria."
    ],
    "fr": [
      "Restauration traditionnelle et rapide au sommet du télésiège de la Floria. Terrasse ensoleillée avec vue dominante sur la vallée.\r\nAccès piétons et skieurs par le télésiège de la Floria."
    ],
    "nl": [
      "Traditioneel en fastfoodrestaurant bovenaan de stoeltjeslift Floria. Zonnig terras met uitzicht over de vallei.\r\nToegang voor voetgangers en skiërs via de stoeltjeslift Floria."
    ],
    "es": [
      "Restaurante tradicional y de comida rápida en lo alto del telesilla Floria. Terraza soleada con vistas al valle.\r\nAcceso peatonal y para esquiadores por el telesilla Floria."
    ]
  },
  "rdfs:label": {
