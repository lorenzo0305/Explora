  "rdfs:comment": {
    "de": [
      "Manon ist eine junge Bergführerin aus Allemond, die hier geboren wurde und seit ihrer Kindheit in den Bergen unterwegs ist. Sie bietet Ihnen verschiedene geführte Schneeschuhwanderungen an."
    ],
    "en": [
      "Manon is a young mountain leader based in Allemond; she was born here and has been hiking these mountains since she was a child, offering a variety of supervised snowshoe outings."
    ],
    "it": [
      "Manon è una giovane guida di montagna con sede ad Allemond; è nata qui e percorre queste montagne fin da bambina, proponendo una serie di escursioni con le racchette da neve supervisionate."
    ],
    "fr": [
      "Manon  est une toute jeune accompagnatrice en montagne basée à Allemond; elle est née ici et parcourt ces montagnes depuis sa plus tendre enfance.Elle vous propose diverses sorties en raquettes encadrées."
    ],
    "nl": [
      "Manon is een jonge bergleidster uit Allemond. Ze is hier geboren en reist al van jongs af aan door deze bergen en biedt een reeks begeleide sneeuwschoenwandelingen aan."
    ],
    "es": [
      "Manon es una joven guía de montaña afincada en Allemond; nació aquí y lleva recorriendo estas montañas desde que era niña, ofreciendo una serie de salidas supervisadas con raquetas de nieve."
    ]
  },
