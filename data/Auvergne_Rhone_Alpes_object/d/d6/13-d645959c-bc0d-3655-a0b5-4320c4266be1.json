  "rdfs:comment": {
    "de": [
      "Das Hallenbad in Modane verfügt über zwei Becken (1 großes 25-m-Becken mit 6 Wasserlinien und ein weiteres 15-m-Becken) sowie einen Spielparcours. Es bietet Aquaform-Aktivitäten und Themenabende an. Die Becken sind für alle zugänglich."
    ],
    "en": [
      "The indoor swimming pool of Modane has two pools (25 m and 15 m). A fun course, aquaform activities and offers theme nights. Pools accessible to all, 1 large pool of 25m with 6 lines of water."
    ],
    "it": [
      "La piscina coperta di Modane ha due piscine (25 m e 15 m). Un corso divertente, attività di aquaform e offerte serate a tema. Piscine accessibili a tutti, 1 grande piscina di 25 metri con 6 linee d'acqua."
    ],
    "fr": [
      "La piscine couverte de Modane dispose de deux bassins (1 grand bassin de 25 m avec 6 lignes d’eau et un autre de 15 m), ainsi qu'un parcours ludique. Elle propose des activités aquaform et des soirées à thème. Bassins accessibles à tous."
    ],
    "nl": [
      "Modane Das Hallenbad. Es verfügt über zwei Pools (25 m und 15 m). Ein Spaß Kurse, Aqua-Fitness-Aktivitäten, Außen Rasen und bietet zur Verfügung thème.Bassins Abende überhaupt ."
    ],
    "es": [
      "La piscina cubierta de Modane cuenta con dos piscinas (una grande de 25 m con 6 líneas de flotación y otra de 15 m), así como un recorrido lúdico. Ofrece actividades de aquaform y veladas temáticas. Piscinas accesibles para todos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Intermunicipal Modane Swimming Pool"
    ],
    "it": [
      "Piscina intercomunale di Modane"
    ],
    "fr": [
      "Piscine intercommunale de Modane"
    ],
    "nl": [
      "Intergemeentelijk  Zwembad van Modane"
    ]
  },
