      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Kleidung, Schmuck und Accessoires für Männer und Frauen\n \nTage der Öffnung:\n\nMontag: 14:00-19:00 Uhr\nDienstag bis Samstag: 10:00-19:00 Uhr\n\nSonntag geschlossen\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Clothing, jewelry and accessories for men and women\n \nOpening days:\n\nMonday: 2pm-7pm\nTuesday to Saturday: 10am-7pm\n\nClosed on Sunday\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Abbigliamento, gioielli e accessori per uomo e donna\n \nGiorni di apertura:\n\nLunedì: 14.00-19.00\nDa martedì a sabato: 10.00-19.00\n\nChiuso la domenica\n\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : Vêtements, bijoux et accessoires pour homme et femme\n \nJours d'ouverture:\n\nLundi: 14h-19h\nDu mardi au samedi: 10h-19h\n\nFermeture le dimanche\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Kleding, sieraden en accessoires voor dames en heren\n \nOpeningsdagen:\n\nMaandag: 14u-19u\nDinsdag tot zaterdag: 10u-19u\n\nZondag gesloten\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Ropa, bisutería y accesorios para hombre y mujer\n \nDías de apertura:\n\nLunes: 14.00-19.00\nDe martes a sábado: de 10.00 a 19.00\n\nDomingos cerrado\n\n\n "
        ]
      },
