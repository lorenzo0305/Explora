  "rdfs:comment": {
    "de": [
      "Träumende und hüpfende Seelen, schließen Sie sich der poetischen Wanderung von Camille Lécuyer und Salomé Duperray an.\r\nWir starten am Samstag, den 15. März um 13:30 Uhr, und gehen in den Herbst. Eine Route in Chamonix, durch die Lärchen und die Poesie von Emily Dickinson."
    ],
    "en": [
      "Join Camille Lécuyer and Salomé Duperray on their poetic hike.\r\nStarting Saturday March 15 at 1:30 pm, let's enter autumn, an itinerary in Chamonix, through the larch trees and the poetry of Emily Dickinson."
    ],
    "it": [
      "Unitevi a Camille Lécuyer e Salomé Duperray nella loro passeggiata poetica.\r\nA partire da sabato 15 marzo alle 13.30, entriamo nell'autunno, un percorso attraverso Chamonix, tra i larici e la poesia di Emily Dickinson."
    ],
    "fr": [
      "Ames rêveuses et gambadeuses, rejoignez la randonnée poétique de Camille Lécuyer et Salomé Duperray. \r\nOn démarre samedi 15 mars à 13h30, entrons dans l'automne, un itinéraire à Chamonix, travers les mélèzes et la poésie d'Emily Dickinson."
    ],
    "nl": [
      "Ga mee met Camille Lécuyer en Salomé Duperray op hun poëtische wandeling.\r\nVanaf zaterdag 15 maart om 13.30 uur gaan we de herfst in, een route door Chamonix, langs de lariksbomen en de poëzie van Emily Dickinson."
    ],
    "es": [
      "Acompañe a Camille Lécuyer y Salomé Duperray en su paseo poético.\r\nA partir del sábado 15 de marzo a las 13:30, adentrémonos en el otoño, una ruta por Chamonix, a través de los alerces y la poesía de Emily Dickinson."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée poétique"
    ]
  },
