  "rdfs:comment": {
    "de": [
      "Die Stadt Brioude und der Tir sportif Brivadois haben die Ehre, das Finale der französischen Vereinsmeisterschaft, dem Vorzeigewettbewerb des französischen Schießsports, am 14. und 15. März 2026 in der Hale des Sports auszurichten."
    ],
    "en": [
      "The town of Brioude and the Tir sportif Brivadois are honored to host the final of the French Club Championship, the flagship competition of French shooting sports, on March 14 and 15, 2026 at the Hale des Sports."
    ],
    "it": [
      "La città di Brioude e il Tir sportif Brivadois hanno l'onore di ospitare la finale del Campionato francese per club, la competizione di punta del tiro sportivo francese, il 14 e 15 marzo 2026 presso l'Hale des Sports."
    ],
    "fr": [
      "La Ville de Brioude et le Tir sportif Brivadois ont l’honneur d’accueilir la finale du Championnat de France des Clubs, compétition phare du tir sportif français, le 14 et 15 mars 2026 à la Hale des Sports."
    ],
    "es": [
      "La ciudad de Brioude y el Tir sportif Brivadois tienen el honor de acoger la final del Campeonato de Francia de Clubes, competición emblemática del tiro deportivo francés, los días 14 y 15 de marzo de 2026 en el Hale des Sports."
    ],
    "nl": [
      "De stad Brioude en het Tir sportif Brivadois hebben de eer om gastheer te zijn van de finale van het Franse Clubkampioenschap, de vlaggenschipcompetitie van de Franse schietsport, op 14 en 15 maart 2026 in de Hale des Sports."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Finale du Championnat de France des clubs de tir"
    ]
  },
