  "rdfs:comment": {
    "de": [
      "Die Entdeckung des Yooners ermöglicht es, sich mit diesem modernen und spielerischen Schlitten vertraut zu machen. Eine zugängliche Fun-Aktivität, um das Gefühl des Gleitens auf andere Weise zu genießen."
    ],
    "en": [
      "Discovering the Yooner allows you to try out this modern and fun sled. A fun and accessible activity to enjoy the thrill of sliding in a different way."
    ],
    "it": [
      "Scoprite lo Yooner e imparate a usare questo slittino moderno e divertente. È un modo divertente e accessibile per provare l'emozione di scivolare in un modo diverso."
    ],
    "fr": [
      "La découverte du Yooner permet de s’initier à cette luge moderne et ludique. Une activité fun et accessible pour profiter des sensations de glisse autrement."
    ],
    "nl": [
      "Met de Yooner kunt u kennismaken met deze moderne en leuke slee. Een leuke en toegankelijke activiteit om op een andere manier van het glijden te genieten."
    ],
    "es": [
      "Descubre el Yooner y aprende a utilizar este moderno y divertido tobogán. Es una forma divertida y accesible de disfrutar de la emoción de deslizarse de una manera diferente."
    ]
  },
  "rdfs:label": {
