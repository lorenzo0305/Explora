  "rdfs:comment": {
    "de": [
      "Bistrot Concept Store Atelier: Entdecken Sie einen geselligen Ort, an dem Kunsthandwerk, Trends und Gastronomie zusammenkommen, um Ihnen ein einzigartiges Erlebnis zu bieten. Lassen Sie sich von morgens bis abends von unserem vielfältigen kulinarischen Angebot verführen."
    ],
    "en": [
      "Bistrot Concept Store Atelier: Discover a friendly place where crafts, trends and gastronomy come together to offer you a unique experience. From morning to evening, let yourself be seduced by our varied culinary offer."
    ],
    "it": [
      "Bistrot Concept Store Atelier: scoprite un luogo conviviale dove artigianato, tendenze e gastronomia si fondono per offrirvi un'esperienza unica. Dalla mattina alla sera, lasciatevi sedurre dalla nostra variegata offerta culinaria."
    ],
    "fr": [
      "Bistrot Concept Store Atelier : Découvrez un lieu de vie convivial où l'artisanat, la tendance et la gastronomie se réunissent pour vous offrir une expérience unique. Du matin au soir, laissez-vous séduire par notre offre culinaire variée."
    ],
    "nl": [
      "Bistrot Concept Store Atelier: Ontdek een vriendelijke leefruimte waar ambacht, mode en gastronomie samenkomen om u een unieke ervaring te bieden. Laat u van 's ochtends tot' s avonds verleiden door ons gevarieerde culinaire aanbod."
    ],
    "es": [
      "Bistrot Concept Store Atelier: Descubra un lugar de convivencia donde artesanía, tendencias y gastronomía se unen para ofrecerle una experiencia única. De la mañana a la noche, déjese seducir por nuestra variada oferta culinaria."
    ]
  },
