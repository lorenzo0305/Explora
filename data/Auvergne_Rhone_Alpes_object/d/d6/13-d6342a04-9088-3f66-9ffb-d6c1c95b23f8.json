  "rdfs:comment": {
    "de": [
      "Claude und Stéphanie haben Anfang 2023 die Vermarktung von Les Vérités übernommen. Dieses gefüllte Karamell, das 1923 kreiert wurde, erlebt eine Renaissance: Restaurierung der Maschine zum Überziehen der Karamellbonbons, Kreation neuer Geschmacksrichtungen und eines neuen Bonbons."
    ],
    "en": [
      "Claude and Stéphanie took over the marketing of Vérités at the beginning of 2023. This filled caramel, created in 1923, is in the midst of a renaissance: restoration of the caramel coating machine, creation of new flavors and a new candy."
    ],
    "it": [
      "Claude e Stéphanie hanno rilevato la commercializzazione di Vérités all'inizio del 2023. Questo caramello ripieno, creato nel 1923, è in piena fase di rinascita: restauro della macchina per la copertura del caramello, creazione di nuovi gusti e di un nuovo dolce."
    ],
    "fr": [
      "Claude et Stéphanie ont repris début 2023 la commercialisation des Vérités. Ce caramel fourré, créé en 1923, est en pleine renaissance : restauration de la machine à enrober les caramels, création de nouveaux parfums, d'un nouveau bonbon."
    ],
    "es": [
      "Claude y Stéphanie se hicieron cargo de la comercialización de Vérités a principios de 2023. Este caramelo relleno, creado en 1923, está en pleno renacimiento: restauración de la máquina de recubrimiento de caramelo, creación de nuevos sabores y de un nuevo dulce."
    ],
    "nl": [
      "Claude en Stéphanie hebben begin 2023 de marketing van Vérités overgenomen. Deze gevulde karamel, gecreëerd in 1923, zit midden in een renaissance: restauratie van de karamelcoatingmachine, creatie van nieuwe smaken en een nieuw snoepje."
    ]
  },
  "rdfs:label": {
    "en": [
      "Au Puy des Vérités"
    ],
    "fr": [
      "Au Puy des Vérités"
    ]
  },
