  "rdfs:comment": {
    "de": [
      "Pastorale Aufzucht von Freilandlämmern, ethische Schlachtung und Merino-Wolle im Direktverkauf!\r\nUnsere Herde ist durch Ecocert für biologische Landwirtschaft zertifiziert, Erwähnung Nauture&Progrès und Marque valeurs Parc naturel régional des Baronnies provençales."
    ],
    "en": [
      "Pastoral breeding of free-range lambs, ethical slaughtering and Merinos wool for direct sale!\r\nOur flock is certified Organic Agriculture by Ecocert, Nauture&Progrès and Marque valeurs Parc naturel régional des Baronnies provençales."
    ],
    "it": [
      "Allevamento pastorale di agnelli all'aperto, macellazione etica e vendita diretta di lana Merinos!\r\nIl nostro gregge è certificato Agricoltura Biologica da Ecocert, Nauture&Progrès e Marque valeurs Parc naturel régional des Baronnies provençales"
    ],
    "fr": [
      "Elevage pastoral d'agneaux de plein air, abattage éthique et laine Merinos en vente directe !\r\nNotre troupeau est certifié Agriculture biologique par Ecocert, mention Nauture&Progrès et Marque valeurs Parc naturel régional des Baronnies provençales"
    ],
    "nl": [
      "Pastorale opfok van lammeren met vrije uitloop, ethisch slachten en directe verkoop van Merinoswol!\r\nOnze kudde is biologisch gecertificeerd door Ecocert, Nauture&Progrès en Parc naturel régional des Baronnies provençales."
    ],
    "es": [
      "Cría de corderos en libertad, sacrificio ético y venta directa de lana de merino\r\nNuestro rebaño está certificado como Agricultura Ecológica por Ecocert, Nauture&Progrès y Marque valeurs Parc naturel régional des Baronnies provençales"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La colline aux moutons"
    ]
  },
