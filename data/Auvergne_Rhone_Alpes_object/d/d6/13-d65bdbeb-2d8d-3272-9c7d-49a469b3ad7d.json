  "rdfs:comment": {
    "de": [
      "\"BABET\" (Boutique Ateliers Bien-Être et Tisanes) bietet Ihnen eine Auswahl an qualitativen Produkten, mit denen Sie sich pflegen und verwöhnen können.\r\nEs werden Workshops (Lithotherapie, Seifen, Meditation, ...) organisiert! Fragen Sie nach dem Programm!"
    ],
    "en": [
      "\"BABET (Boutique Ateliers Bien-Être et Tisanes) offers a selection of quality products to pamper and cocoon you.\r\nWorkshops (lithotherapy, soaps, meditation, etc.) are also organized! Ask for the program!"
    ],
    "it": [
      "\"BABET\" (Boutique Ateliers Bien-Être et Tisanes) vi propone una selezione di prodotti di qualità per coccolarvi e cocooning.\r\nVengono anche organizzati dei laboratori (litoterapia, saponi, meditazione, ecc.)! Chiedete il programma!"
    ],
    "fr": [
      "\"BABET\" (Boutique Ateliers Bien-Être et Tisanes) vous propose une sélection de produits qualitatifs pour prendre soin de vous et vous cocooner.\r\nDes ateliers (lithothérapie, savons, méditation, ...) sont organisés ! Demandez le programme!"
    ],
    "es": [
      "\"BABET (Boutique Ateliers Bien-Être et Tisanes) le ofrece una selección de productos de calidad para mimarse y relajarse.\r\nTambién se organizan talleres (litoterapia, jabones, meditación, etc.) Solicite el programa"
    ],
    "nl": [
      "\"BABET (Boutique Ateliers Bien-Être et Tisanes) biedt je een selectie kwaliteitsproducten om jezelf te verwennen en te cocoonen.\r\nEr worden ook workshops georganiseerd (lithotherapie, zeep, meditatie, enz.)! Vraag naar het programma!"
    ]
  },
