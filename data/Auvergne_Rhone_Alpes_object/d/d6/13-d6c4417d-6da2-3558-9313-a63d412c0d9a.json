  "rdfs:comment": {
    "de": [
      "Freibad mit großem Becken, Sprungturm, Liegewiese und Entspannungsbereich, Planschbecken (für Kinder unter 6 Jahren), Bar und Caféteria. Traditionelles Schwimmbad im Herzen der Stadt, Becken für erfahrene Schwimmer und Taucher oder Anfänger."
    ],
    "en": [
      "Outdoor swimming pool with diving board and large pool, lawn, relaxing space, paddling pool, bar and cafeteria. Let's enjoy the charm of a traditionnal swimming-pool in the heart of the city, with its pools and diving boards for accomplished swimmers as well as unaccomplished."
    ],
    "it": [
      "Piscina all'aperto con grande vasca, trampolino, prato e zona relax, vasca per bambini (per bambini sotto i 6 anni), bar e caffetteria. Piscina tradizionale nel cuore della città, vasche per nuotatori e subacquei esperti o principianti."
    ],
    "fr": [
      "Piscine extérieure avec grand bassin, plongeoir,  pelouse et espace détente, pataugeoire (pour les - de 6 ans), bar et caféteria. Piscine traditionnelle au coeur de la ville, bassins pour nageurs et plongeurs confirmés ou débutants."
    ],
    "es": [
      "Piscina exterior con gran vaso, trampolín, césped y zona de relax, piscina infantil (para menores de 6 años), bar y cafetería. Piscina tradicional en el corazón de la ciudad, con piscinas para nadadores y buceadores experimentados y principiantes."
    ],
    "nl": [
      "Buitenzwembad met groot bad, duikplank, ligweide en ontspanningsruimte, kikkerbad (voor kinderen tot 6 jaar), bar en cafetaria. Traditioneel zwembad in het hart van de stad, zwembaden voor ervaren zwemmers en duikers of beginners."
    ]
  },
