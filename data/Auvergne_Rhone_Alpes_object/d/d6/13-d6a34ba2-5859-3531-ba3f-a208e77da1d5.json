  "rdfs:comment": {
    "de": [
      "Genossenschaft im Zentrum des Dorfes Les Adrets, La Marmite des Adrets empfängt Sie in einer herzlichen Atmosphäre.\r\nBio-Lebensmittelgeschäft, frisches Obst und Gemüse, Käse und Wurstwaren."
    ],
    "en": [
      "Cooperative society in the center of the village of Les Adrets, La Marmite des Adrets welcomes you in a warm atmosphere.\r\nOrganic grocery, fresh fruits and vegetables, cheeses and delicatessen."
    ],
    "it": [
      "Cooperativa nel centro del villaggio di Les Adrets, La Marmite des Adrets vi accoglie in una calda atmosfera.\r\nDrogheria biologica, frutta e verdura fresca, formaggi e salumi."
    ],
    "fr": [
      "Société coopérative au centre du village des Adrets, La Marmite des Adrets vous accueille dans une ambiance chaleureuse.\r\nÉpicerie Bio, fruits et légumes frais, fromages et charcuterie."
    ],
    "nl": [
      "Een coöperatie in het centrum van het dorp Les Adrets, La Marmite des Adrets verwelkomt u in een warme sfeer.\r\nBiologische kruidenierswinkel, verse groenten en fruit, kaas en vleeswaren."
    ],
    "es": [
      "Cooperativa situada en el centro del pueblo de Les Adrets, La Marmite des Adrets le da la bienvenida en un ambiente acogedor.\r\nTienda de comestibles ecológicos, frutas y verduras frescas, quesos y charcutería."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Marmite des Adrets"
    ]
  },
