  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8cd75553-31cf-3763-8ace-bf9f18c8adbd",
      "dc:description": {
        "de": [
          "Die Stadtverwaltung wollte die Bergleute und unsere schöne Region Hauts-de-France im Rahmen der Feierlichkeiten zu Sainte-Barbe mit dem Programm des Musicals Fleurs des Corons ehren."
        ],
        "en": [
          "As part of the Sainte-Barbe festivities, the town council decided to pay tribute to the miners and our beautiful region of Hauts-de-France by programming the musical comedy Fleurs des Corons."
        ],
        "it": [
          "Nell'ambito dei festeggiamenti di Sainte-Barbe, il Comune ha voluto rendere omaggio ai minatori e alla nostra bella regione degli Hauts-de-France mettendo in scena il musical Fleurs des Corons."
        ],
        "fr": [
          "La municipalité a souhaité rendre hommage aux mineurs et à notre belle région des Hauts-de-France dans le cadre des festivités de la Sainte-Barbe en programmant la comédie musicale Fleurs des Corons."
        ],
        "es": [
          "En el marco de las fiestas de Sainte-Barbe, el ayuntamiento quiso rendir homenaje a los mineros y a nuestra hermosa región de Hauts-de-France poniendo en escena el musical Fleurs des Corons."
        ],
        "nl": [
          "Als onderdeel van de festiviteiten in Sainte-Barbe wilde het gemeentebestuur eer betonen aan de mijnwerkers en onze mooie regio Hauts-de-France door de musical Fleurs des Corons op te voeren."
        ]
      },
