  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine originelle Geschichte, in der sich die Gegenwart mit der Vergangenheit in einem Musical vermischt, das den Bergleuten und den Reichtümern unserer Region Tribut zollt."
    ],
    "en": [
      "Discover an original story where the present blends with the past in a musical comedy paying tribute to the miners and the riches of our region."
    ],
    "it": [
      "Scoprite una storia originale in cui il presente si fonde con il passato in un musical che rende omaggio ai minatori e alle ricchezze della nostra regione."
    ],
    "fr": [
      "Découvrez une histoire originale où le présent se mêle au passé dans une comédie musicale rendant hommage aux mineurs et aux richesses de notre région."
    ],
    "nl": [
      "Ontdek een origineel verhaal waarin het heden zich vermengt met het verleden in een musical die een eerbetoon is aan de mijnwerkers en de rijkdommen van onze regio."
    ],
    "es": [
      "Descubra una historia original donde el presente se mezcla con el pasado en un musical que rinde homenaje a los mineros y a las riquezas de nuestra región."
    ]
  },
  "rdfs:label": {
