  "rdfs:comment": {
    "de": [
      "Traditionelle Verpflegung mit Produkten vom Bauernhof oder frischen Produkten, die vor Ort verarbeitet werden. Empfang von Gruppen im Saal des Gasthauses (Kapazität 35 Gedecke). Spezialitäten: Coq au Vin, Schinken in Madeira."
    ],
    "en": [
      "Traditional restaurant based on fresh and local products. Large groups and banquets welcome in a large annex with the possibility of music and videoprojecter. Specialities: coq au vin, ham in madiera sauce."
    ],
    "it": [
      "Ristorazione tradizionale a base di prodotti della fattoria o di prodotti freschi lavorati in loco. Gruppi benvenuti nella sala da pranzo della locanda (capacità 35 coperti). Specialità: coq au vin, jambon au madère."
    ],
    "fr": [
      "Restauration traditionnelle à base de produits fermiers ou produits frais transformés sur place. Accueil des groupes dans la salle de l'auberge (capacité 35 couverts). Spécialités : coq au vin, jambon au madère."
    ],
    "nl": [
      "Traditionele catering op basis van producten van de boerderij of verse producten die ter plekke worden verwerkt. Groepen zijn welkom in de eetzaal van de herberg (capaciteit 35 couverts). Specialiteiten: coq au vin, jambon au madère."
    ],
    "es": [
      "Restauración tradicional a base de productos de la granja o productos frescos elaborados in situ. Acogida de grupos en el comedor del albergue (capacidad 35 cubiertos). Especialidades: coq au vin, jambon au madère."
    ]
  },
