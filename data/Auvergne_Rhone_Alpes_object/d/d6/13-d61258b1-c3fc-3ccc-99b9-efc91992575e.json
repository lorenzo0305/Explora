  "rdfs:comment": {
    "de": [
      "Neben dem Verleih und der Konsultation zahlreicher Dokumente für Kinder und Erwachsene bietet die Mediathek Bernard Pivot regelmäßig kulturelle Aktionen für Groß und Klein an"
    ],
    "en": [
      "In addition to lending and consulting a wide range of documents for children and adults, the Bernard Pivot multimedia library regularly offers cultural events for young and old"
    ],
    "it": [
      "Oltre al prestito e alla consultazione di un'ampia gamma di documenti per bambini e adulti, la biblioteca multimediale Bernard Pivot organizza regolarmente eventi culturali per grandi e piccini"
    ],
    "fr": [
      "Outre le prêt et la consultation de nombreux documents pour enfants et adultes la médiathèque Bernard Pivot propose régulièrement des actions culturelles pour petits et grands"
    ],
    "nl": [
      "Naast het uitlenen en raadplegen van een breed scala aan documenten voor kinderen en volwassenen, organiseert de Bernard Pivot mediatheek regelmatig culturele evenementen voor jong en oud"
    ],
    "es": [
      "Además de prestar y consultar una amplia gama de documentos para niños y adultos, la biblioteca multimedia Bernard Pivot organiza regularmente actos culturales para grandes y pequeños"
    ]
