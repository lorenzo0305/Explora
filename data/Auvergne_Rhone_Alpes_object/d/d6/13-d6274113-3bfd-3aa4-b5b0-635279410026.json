  "rdfs:comment": {
    "de": [
      "Die Rôtisserie bietet All-you-can-eat-Buffetformeln mit frischen Produkten von lokalen Produzenten aus der Region.\r\nAlle Gerichte werden vor Ort zubereitet und gekocht und mit hausgemachtem Gebäck serviert."
    ],
    "en": [
      "The rotisserie offers all-you-can-eat buffet formulas with fresh produce from local producers in the region.\r\nAll dishes are prepared and cooked on site with homemade pastries."
    ],
    "it": [
      "La rosticceria offre buffet a volontà con prodotti freschi provenienti da produttori locali della regione.\r\nTutti i piatti sono preparati e cucinati in loco con dolci fatti in casa."
    ],
    "fr": [
      "La rôtisserie propose des formules buffet à volonté avec des produits frais issus de producteurs locaux de la région.\r\nTous les plats sont préparés et cuisinés sur place avec des pâtisseries faites maison."
    ],
    "es": [
      "El asador ofrece buffets de todo tipo con productos frescos de los productores locales de la región.\r\nTodos los platos se preparan y cocinan en el lugar, con repostería casera."
    ],
    "nl": [
      "De rotisserie biedt all-you-can-eat buffetten met verse producten van lokale producenten uit de regio.\r\nAlle gerechten worden ter plaatse bereid en gekookt met zelfgemaakt gebak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Champ du Coq"
    ]
  },
