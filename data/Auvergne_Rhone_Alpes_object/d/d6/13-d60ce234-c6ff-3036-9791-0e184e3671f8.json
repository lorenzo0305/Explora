  "rdfs:comment": {
    "de": [
      "Patronatsfest in Reilhac mit folgendem Programm: Verkauf von im Ofen gebackenen Brotkugeln, Flohmarkt, Essen, Disco-Ball mit Folly Night und 80er-Jahre-Ball, Boule-Wettbewerb, Boom und Animationen für Kinder. Getränke und Snacks das ganze Wochenende über."
    ],
    "en": [
      "Fête Patronale in Reilhac with baked bread balls for sale, garage sale, meal, disco ball with Folly Night and 80s ball, pétanque competition, boom and children's entertainment. Refreshments and snacks all weekend."
    ],
    "it": [
      "Festa Patronale a Reilhac con vendita di palline di pane al forno, vendita di garage, pasto, disco dance con Folly Night e ballo anni '80, gara di pétanque, boom e animazione per bambini. Rinfreschi e spuntini per tutto il fine settimana."
    ],
    "fr": [
      "Fête Patronale à Reilhac avec au programme, vente de boules de pain cuites au four, vide grenier, repas, bal disco animé par Folly Night et bal années 80, concours de pétanque, boom et animations pour les enfants. Buvette et snack tout le weekend."
    ],
    "nl": [
      "Fête Patronale in Reilhac met gebakken broodballen te koop, garageverkoop, maaltijd, discodans met Folly Night en 80s dance, jeu de boules wedstrijd, boom en entertainment voor kinderen. Versnaperingen en snacks het hele weekend."
    ],
    "es": [
      "Fête Patronale en Reilhac con venta de bolas de pan horneadas, venta de garaje, comida, baile disco con Folly Night y baile de los 80, competición de petanca, boom y animación para niños. Refrescos y aperitivos todo el fin de semana."
    ]
  },
