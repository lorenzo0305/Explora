  "rdfs:comment": {
    "de": [
      "Der MOS PUB Mercière empfängt Sie auf seiner Terrasse mit 100 Plätzen oder in seinem trendigen und geräumigen Inneren. Die von Chefkoch Antoine Bastia angebotene Flammenküche wird Sie an ein gutes Barbecue mit Freunden erinnern."
    ],
    "en": [
      "The MOS PUB Mercière welcomes you on its 100-seat terrace or inside its trendy, spacious interior. Chef Antoine Bastia's flame-fired cuisine will remind you of a good barbecue with friends."
    ],
    "it": [
      "Il MOS PUB Mercière vi accoglie sulla sua terrazza da 100 posti o all'interno dei suoi spaziosi locali alla moda. La cucina alla fiamma dello chef Antoine Bastia vi ricorderà un buon barbecue con gli amici."
    ],
    "fr": [
      "Le MOS PUB Mercière vous accueille sur sa terrasse d’une centaine de places ou au sein de son intérieur tendance et spacieux. La cuisine à la flamme proposée par le Chef Antoine Bastia vous rappellera le bon barbecue entre copains."
    ],
    "es": [
      "El MOS PUB Mercière le da la bienvenida en su terraza de 100 plazas o en su interior moderno y espacioso. La cocina a la llama del Chef Antoine Bastia le recordará a una buena barbacoa entre amigos."
    ],
    "nl": [
      "De MOS PUB Mercière verwelkomt je op het terras met 100 zitplaatsen of binnen in het trendy, ruime interieur. De vurige keuken van chef-kok Antoine Bastia doet je denken aan een goede barbecue met vrienden."
    ]
  },
