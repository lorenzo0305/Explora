  "rdfs:comment": {
    "de": [
      "Berg-Brasserie am Fuße der Pisten von Rochebrune, am Ausgangspunkt der Seilbahn, Südterrasse, abwechslungsreiche Küche \"Fait Maison\". Durchgehender Service bis 16 Uhr."
    ],
    "en": [
      "Mountain bistro, located at the foot of the Rochebrune cable car and slopes, south-facing terrace, varied and homemade cooking. Non-stop service until 4p.m."
    ],
    "it": [
      "Brasserie di montagna, situata ai piedi delle piste di Rochebrune, alla partenza della funivia, terrazza esposta a sud, cucina variegata \"fatta in casa\". Servizio continuo fino alle 16:00."
    ],
    "fr": [
      "Brasserie de montagne, située au pied des pistes de Rochebrune, au départ du téléphérique, terrasse plein sud, cuisine variée \"Fait Maison \". Service continu jusqu'à 16h."
    ],
    "es": [
      "Brasserie de montaña, situada al pie de las pistas de Rochebrune, al inicio del teleférico, terraza orientada al sur, cocina \"casera\" variada. Servicio continuo hasta las 16 h."
    ],
    "nl": [
      "Bergbrasserie, gelegen aan de voet van de hellingen van Rochebrune, aan het begin van de kabelbaan, terras op het zuiden, gevarieerde \"huisbereide\" keuken. Doorlopende bediening tot 16.00 uur."
    ]
  },
  "rdfs:label": {
