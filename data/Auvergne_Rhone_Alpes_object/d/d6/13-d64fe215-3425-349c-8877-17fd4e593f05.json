  "rdfs:comment": {
    "de": [
      "Angelin Preljocaj erforscht die Begegnung in verschiedenen Formen in diesem Triptychon, in dem er Umarmungen, Duelle und verpasste Verabredungen durch einen präzisen und ausdrucksstarken Tanz miteinander verbindet. Ballett Preljocaj, in drei Stücken."
    ],
    "en": [
      "Angelin Preljocaj explores encounters in a variety of forms in this triptych, in which he blends embraces, duels and missed rendezvous through precise, expressive dance. Ballet Preljocaj, in 3 pieces."
    ],
    "it": [
      "Angelin Preljocaj esplora gli incontri in forme diverse in questo trittico, in cui mescola abbracci, duelli e occasioni mancate attraverso una danza precisa ed espressiva. Balletto Preljocaj, in 3 pezzi."
    ],
    "fr": [
      "Angelin Preljocaj explore la rencontre sous différentes formes dans ce triptyque où il mêle étreintes, duels et rendez-vous manqués à travers une danse précise et expressive. Ballet Preljocaj, en 3 pièces."
    ],
    "nl": [
      "Angelin Preljocaj verkent ontmoetingen in verschillende vormen in dit drieluik, waarin hij omhelzingen, duels en gemiste kansen mengt door middel van precieze, expressieve dans. Ballet Preljocaj, in 3 stukken."
    ],
    "es": [
      "Angelin Preljocaj explora los encuentros de diferentes formas en este tríptico, en el que mezcla abrazos, duelos y oportunidades perdidas a través de una danza precisa y expresiva. Ballet Preljocaj, en 3 piezas."
    ]
  },
  "rdfs:label": {
    "fr": [
