  "rdfs:comment": {
    "de": [
      "Versuchen Sie Ihr Glück im Casino von Hauteville-Lompnes! Das Casino ist täglich von 11 Uhr bis 2 Uhr geöffnet und verfügt über 72 Spielautomaten und mehrere elektronische Roulette- und Black-Jack-Maschinen, 2 Black-Jack-Tische , eine Bar und ein Restaurant."
    ],
    "en": [
      "Try your luck at the Hauteville-Lompnes Casino! Open from 11:00 until 02:00 daily the casino has 71 slot machines and several roulette and blackjack tables in addition to a bar and restaurant."
    ],
    "it": [
      "Aperto tutti i giorni dalle 11.00 alle 2.00, il casinò di Hauteville-Lompnes dispone di 72 slot machine, diverse roulette e blackjack elettronici, 2 tavoli da blackjack, un bar e un ristorante."
    ],
    "fr": [
      "Tentez votre chance au casino de Hauteville-Lompnes ! ouvert de 11h à 2h tous les jours, le casino dispose de 72 machines à sous et de plusieurs machines de roulette et de black-jack électroniques, 2 tables de Black Jack , un bar et un restaurant."
    ],
    "es": [
      "El casino de Hauteville-Lompnes, abierto todos los días de 11.00 a 2.00 h, cuenta con 72 máquinas tragaperras, varias ruletas electrónicas, blackjack, 2 mesas de blackjack, bar y restaurante."
    ],
    "nl": [
      "Beproef uw geluk in het casino van Hauteville-Lompnes! Het casino is dagelijks geopend van 11 tot 2 uur en beschikt over 72 speelautomaten en verschillende elektronische roulette- en blackjackmachines, 2 blackjacktafels, een bar en een restaurant."
    ]
  },
