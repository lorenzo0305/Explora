  "rdfs:comment": {
    "de": [
      "Der Villerest-Staudamm dient der Hochwasserkappung und trägt maßgeblich zur Verringerung des Hochwasserrisikos flussabwärts bei."
    ],
    "en": [
      "The Villerest dam is designed for flood control and makes a significant contribution to reducing the risk of downstream flooding."
    ],
    "it": [
      "La diga di Villerest è stata progettata per il controllo delle inondazioni e contribuisce in modo significativo a ridurre il rischio di inondazioni a valle."
    ],
    "fr": [
      "Le barrage de Villerest a pour vocation l’écrêtement des crues et contribue significativement à la réduction du risque d’inondation à l’aval."
    ],
    "es": [
      "La presa de Villerest está diseñada para controlar las inundaciones y contribuye significativamente a reducir el riesgo de inundaciones aguas abajo."
    ],
    "nl": [
      "De Villerest-dam is ontworpen voor overstromingsbeheer en levert een belangrijke bijdrage aan het verminderen van het risico op overstromingen stroomafwaarts."
    ]
  },
