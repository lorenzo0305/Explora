  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/56c1ff31-0756-320e-9896-0410a78878a5",
      "dc:description": {
        "de": [
          "rund um die Pfanne Food Truck\n\nL'Art de la Pizza, l'Éclat du Traiteur: Ein Gourmet-Duo aus Holzfeuer und Riesenpfannen !?\n\nWarum ist Autour de la poêle außergewöhnlich? Handgemachte Holzofenpizza, Riesenpfannen, monumentale Gerichte, unvergessliche Events."
        ],
        "en": [
          "autour de la poele Food truck\n\nL'Art de la Pizza, l'Éclat du Traiteur: A Gourmet Duo with Wood Fired Stoves and Giant Pans! ?\n\nWhy Autour de la poêle is extraordinary? Artisanal wood-fired pizzas, giant stoves, monumental dishes, unforgettable events."
        ],
        "it": [
          "camioncino intorno ai fornelli\n\nL'Art de la Pizza, l'Éclat du Traiteur: un duo di gourmet con fuochi a legna e padelle giganti?\n\nPerché Autour de la poêle è straordinario? Pizze artigianali cotte a legna, padelle giganti, piatti monumentali, eventi indimenticabili."
        ],
        "fr": [
          "autour de la poele  Food truck\n\nL’Art de la Pizza, l’Éclat du Traiteur : Un Duo Gourmand au Feu de Bois et Poêles Géantes ! ?\n\nPourquoi Autour de la poêle est extraordinaire ? Pizzas au feu de bois artisanales, Poêles géantes plats monumentaux, Evénements inoubliables."
        ],
        "nl": [
          "rond het fornuis Voedseltruck\n\nL'Art de la Pizza, l'Éclat du Traiteur: een fijnproeversduo met houtvuren en reuzenpannen! ?\n\nWaarom Autour de la poêle buitengewoon is? Ambachtelijke houtgestookte pizza's, reusachtige bakpannen, monumentale gerechten, onvergetelijke evenementen."
        ],
        "es": [
          "alrededor de los fogones Food truck\n\nL'Art de la Pizza, l'Éclat du Traiteur: un dúo gourmet con fuego de leña y sartenes gigantes ?\n\n¿Por qué Autour de la poêle es extraordinario? Pizzas artesanales a la leña, sartenes gigantes, platos monumentales, eventos inolvidables."
        ]
      },
