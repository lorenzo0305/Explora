  "rdfs:comment": {
    "de": [
      "La Mère Colette liebt die französische Gastronomie: Sie wird ihre Liebe zu ihrer typischen Lyoner Küche mit Ihnen teilen. Alle Gerichte auf der Speisekarte sind \"hausgemacht\" und werden aus frischen Zutaten zubereitet."
    ],
    "en": [
      "La Mère Colette loves French gastronomy: She will share with you her love for her typical Lyonnais cuisine. All the dishes on the menu are \"home-made\" and made with fresh products."
    ],
    "it": [
      "La Mère Colette ama la gastronomia francese: condividerà con voi l'amore per la sua cucina tipicamente lionese. Tutti i piatti del menu sono \"fatti in casa\" e realizzati con prodotti freschi."
    ],
    "fr": [
      "La Mère Colette aime la gastronomie française : Elle vous fera partager son amour pour sa cuisine typiquement lyonnaise. Tous les plats de la carte sont \"fait maison\" et élaborés à partir de produits frais."
    ],
    "nl": [
      "La Mère Colette houdt van de Franse gastronomie: ze zal haar liefde voor haar typisch Lyonnaise keuken met u delen. Alle gerechten op de kaart zijn \"home-made\" en gemaakt van verse producten."
    ],
    "es": [
      "La Mère Colette ama la gastronomía francesa: compartirá con usted su amor por la cocina típicamente lionesa. Todos los platos de la carta son \"caseros\" y están elaborados con productos frescos."
    ]
  },
  "rdfs:label": {
