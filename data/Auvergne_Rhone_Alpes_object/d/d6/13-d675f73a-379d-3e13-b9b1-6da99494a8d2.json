  "rdfs:comment": {
    "de": [
      "Das Chalet de Caron ist ein Selbstbedienungsrestaurant im Stil der Berge, das Schnelligkeit und qualitativ hochwertige Küche miteinander verbindet."
    ],
    "en": [
      "Restaurant on the slopes located below the resort, Le Chalet de Caron is a self-service restaurant, combining speed and quality cuisine."
    ],
    "it": [
      "Ristorante sulle piste da sci situato ai piedi della stazione, lo Chalet de Caron è un self-service in stile montano che ha la particolarità di combinare rapidità e cucina di qualità."
    ],
    "fr": [
      "Restaurant sur les pistes situé en contrebas de la station, le Chalet de Caron est un self-service façon montagne, qui a la particularité d’associer rapidité et cuisine de qualité."
    ],
    "nl": [
      "Het Chalet de Caron is een restaurant aan de skipistes onderaan het skigebied. Het is een zelfbedieningsrestaurant in bergstijl dat snelheid combineert met een uitstekende keuken."
    ],
    "es": [
      "El Chalet de Caron, un restaurante situado en las pistas de esquí, debajo de la estación, es un autoservicio de estilo montañés que se caracteriza por combinar rapidez y cocina de calidad."
    ]
