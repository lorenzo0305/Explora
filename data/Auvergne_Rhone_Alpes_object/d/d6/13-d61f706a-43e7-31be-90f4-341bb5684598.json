  "rdfs:comment": {
    "de": [
      "Ein familiärer und geselliger Imbiss, der auch für Gäste geöffnet ist, die nicht auf dem Campingplatz wohnen. Probieren Sie große gemischte Salate, Paninis, Croque Monsieur, Cocktails, Aperitifbretter, Frühstück, Eisbecher, 100% natürliche Smoothies, Kaffee..."
    ],
    "en": [
      "A family-friendly, welcoming snack bar also open to people not staying at the campsite. Enjoy large mixed salads, paninis, toasted sandwiches, cocktails, appetizer boards, breakfasts, ice cream sundaes, 100% natural smoothies, and coffee."
    ],
    "it": [
      "Un accogliente snack bar per famiglie, aperto anche a chi non soggiorna in campeggio. Potrete gustare insalatone miste, panini, croque-monsieur, cocktail, aperitivi, colazioni, gelati, frullati 100% naturali, caffè..."
    ],
    "fr": [
      "Un snack familial et convivial ouvert aussi aux personnes ne résidant pas dans le camping. Dégustez grandes salades composées, paninis, croque-monsieur, cocktails, planches apéro, petits-déjeuners, coupes de glaces, smoothies 100% naturels, café..."
    ],
    "es": [
      "Un agradable snack bar familiar, abierto también a las personas no alojadas en el camping. Disfrute de grandes ensaladas mixtas, paninis, sándwiches tostados, cócteles, bandejas de aperitivos, desayunos, helados, batidos 100% naturales, café..."
    ],
    "nl": [
      "Een gezellige snackbar voor het hele gezin, ook open voor mensen die niet op de camping verblijven. Geniet van grote gemengde salades, panini's, croque-monsieur sandwiches, cocktails, aperitiefschotels, ontbijtjes, ijsjes, 100% natuurlijke smoothies, koffie..."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Arbaz"
    ],
    "fr": [
      "L'Arbaz - Snack / Bar / Glacier"
    ]
  },
