  "rdfs:comment": {
    "de": [
      "Diese Aufführung, die eine Mischung aus klassisch-poppiger Taschenoper, musikalischem Märchen und burleskem Duett ist, verspricht ein kleines Juwel der Bühnenerfindung zu werden. Ein fröhlicher Ausflug, der die Türen der Phantasie weit öffnet."
    ],
    "en": [
      "Halfway between classico-pop pocket opera, musical tale and burlesque duo, this show promises to be a little gem of scenic invention. A joyful escapade to open wide the doors of the imagination."
    ],
    "it": [
      "A metà strada tra l'opera classica-pop tascabile, il racconto musicale e il duo burlesco, questo spettacolo promette di essere un piccolo gioiello di invenzione scenica. Una gioiosa evasione per spalancare le porte dell'immaginazione."
    ],
    "fr": [
      "À mi-chemin entre opéra de poche classico-pop, conte musical et duo burlesque, ce spectacle s’annonce comme un petit bijou d’invention scénique. Une escapade joyeuse pour ouvrir grand les portes de l’imaginaire."
    ],
    "nl": [
      "Halverwege classico-pop pocketopera, muzikaal sprookje en burlesk duo, belooft deze show een juweeltje van toneeluitvinding te worden. Een vrolijke escapade die de deuren van de verbeelding wijd open zet."
    ],
    "es": [
      "A medio camino entre la ópera clásica-pop de bolsillo, el cuento musical y el dúo burlesco, este espectáculo promete ser una pequeña joya de la invención escénica. Una alegre escapada para abrir de par en par las puertas de la imaginación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre musical - L’Épatante Épopée - Cie La Vagabonde"
    ]
  },
