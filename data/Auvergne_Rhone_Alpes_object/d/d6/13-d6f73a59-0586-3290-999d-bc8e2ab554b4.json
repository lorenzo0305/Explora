  "rdfs:comment": {
    "de": [
      "Das Land, auf dem sie immer gelebt hat, dann Tierparks und Reisen nach Afrika haben Tania Boucard ermöglicht, in der Nähe von Tieren zu leben."
    ],
    "en": [
      "The countryside where she has always lived, followed by animal parks and trips to Africa, have enabled Tania Boucard to live close to animals."
    ],
    "it": [
      "La campagna, dove ha sempre vissuto, seguita dai parchi animali e dai viaggi in Africa, hanno permesso a Tania Boucard di vivere a stretto contatto con gli animali."
    ],
    "fr": [
      "La campagne où elle a toujours vécu, puis les parcs animaliers et les voyages en Afrique ont permis à Tania Boucard de vivre près des animaux."
    ],
    "nl": [
      "Het platteland, waar ze altijd heeft gewoond, gevolgd door dierenparken en reizen naar Afrika, hebben Tania Boucard in staat gesteld om dicht bij dieren te leven."
    ],
    "es": [
      "El campo, donde siempre ha vivido, seguido de los parques de animales y los viajes a África, han permitido a Tania Boucard vivir cerca de los animales."
    ]
  },
