  "rdfs:comment": {
    "de": [
      "Paléopolis, der Dinosaurierhügel in Gannat (03), ist ein Themenpark, der der Paläontologie gewidmet ist und die faszinierendste aller Geschichten erzählt: die der Entwicklung des Lebens. Im Jahr 2025 präsentiert der Park 5 neue große, animierte Skulpturen von prähistorischen Tieren!"
    ],
    "en": [
      "A theme park dedicated to paleontology, Paléopolis, the dinosaur hill in Gannat (03), tells the most fascinating story of all: the evolution of life. In 2025, the park will present 5 new large animated sculptures of prehistoric animals!"
    ],
    "it": [
      "Tuffatevi nella storia della vita a Paléopolis, il parco dei dinosauri di Gannat! Novità per il 2026: vivete la T.REX MANIA con creature gigantesche, un film spettacolare e un'esperienza virtuale mozzafiato di fronte al re dei predatori!"
    ],
    "fr": [
      "Plongez dans l'histoire de la vie à Paléopolis, le parc aux dinosaures de Gannat ! Nouveauté 2026 : vivez la T.REX MANIA avec des créatures géantes, un film spectaculaire et une expérience virtuelle époustouflante face au roi des prédateurs !"
    ],
    "es": [
      "¡Sumérgete en la historia de la vida en Paléopolis, el parque de dinosaurios de Gannat! Novedad para 2026: ¡vive la T.REX MANIA con criaturas gigantes, una película espectacular y una experiencia virtual impresionante enfrentándote al rey de los depredadores!"
    ],
    "nl": [
      "Het park gewijd aan paleontologie waar je de dinosaurussen op een plezierige manier leert kennen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Paléopolis,"
    ],
    "fr": [
      "Paléopolis, la colline aux dinosaures"
    ],
    "nl": [
