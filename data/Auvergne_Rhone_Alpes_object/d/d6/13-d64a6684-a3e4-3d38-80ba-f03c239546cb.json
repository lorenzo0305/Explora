  "rdfs:comment": {
    "de": [
      "Patricia und Bertrand, die Besitzer dieses farbenfrohen Lokals, bereiten Ihnen einen herzlichen Empfang. Auf dem Teller finden Sie eine authentische Küche, die aus frischen und hochwertigen Produkten zubereitet wird.\r\nNur mittags geöffnet. Gerichte zum Mitnehmen."
    ],
    "en": [
      "Patricia and Bertrand, the owners of this colorful establishment, offer you a warm welcome. On the plate, authentic cuisine made from fresh, quality products.\r\nOpen only for lunch. Take away food."
    ],
    "it": [
      "Patricia e Bertrand, i proprietari di questa colorata struttura, vi offrono un caloroso benvenuto. Nel piatto, una cucina autentica elaborata con prodotti freschi e di qualità.\r\nAperto solo a pranzo. Piatti da asporto."
    ],
    "fr": [
      "Patricia et Bertrand, les propriétaires de cet établissement haut en couleurs, vous proposent une accueil chaleureux. Dans l'assiette, une cuisine authentique élaborée à partir de produits frais et de qualité.\r\nOuvert uniquement le midi. Plats à emporter."
    ],
    "es": [
      "Patricia y Bertrand, los propietarios de este colorido establecimiento, le ofrecen una cálida bienvenida. En el plato, una auténtica cocina elaborada a partir de productos frescos y de calidad.\r\nAbierto sólo a la hora de comer. Platos para llevar."
    ],
    "nl": [
      "Patricia en Bertrand, de eigenaren van dit kleurrijke etablissement, heten u van harte welkom. In het bord, een authentieke keuken uitgewerkt met verse en kwaliteitsvolle producten.\r\nAlleen 's middags geopend. Afhaalgerechten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Bistrot d'ici"
    ],
    "fr": [
      "Le Bistrot d'ici"
    ]
  },
