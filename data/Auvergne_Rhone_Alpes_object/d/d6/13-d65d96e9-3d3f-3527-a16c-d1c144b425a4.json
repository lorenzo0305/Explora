  "rdfs:comment": {
    "de": [
      "Workshop unter der Leitung von Nassim DJ: Mixen, entdecken, teilen! Ein einzigartiger Tag, um in die Welt des DJing einzutauchen, zwischen musikalischer Praxis und Kultur\r\nhip-Hop."
    ],
    "en": [
      "Workshop led by Nassim DJ: mix, discover, share! A unique day to immerse yourself in the world of DJing, between musical practice and hip-hop culture\r\nhip-hop culture."
    ],
    "it": [
      "Workshop guidato da Nassim DJ: mixare, scoprire e condividere! Una giornata unica per addentrarsi nel mondo del DJing, combinando pratica musicale e cultura hip-hop\r\ncultura hip-hop."
    ],
    "fr": [
      "Atelier animé par Nassim DJ : mixe, découvre, partage ! Une journée unique pour plonger dans l’univers du DJing, entre pratique musicale et culture\r\nhip-hop."
    ],
    "nl": [
