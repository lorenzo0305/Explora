  "rdfs:comment": {
    "de": [
      "Ein 11 Meter hoher, 1 Hektar großer Staudamm aus dem Jahr 1872, der von den Bergleuten errichtet wurde, um Wasserdampf für den Betrieb mechanischer Geräte, die Verhüttung der Stollen und das Waschen von Eisenpyriterz zu erzeugen."
    ],
    "en": [
      "Former dam of one hectare, 11 meters high, dating from 1872, built by the miners to make steam, to operate mechanized equipment, to bru-mise the galleries and to wash the iron pyrite ore."
    ],
    "it": [
      "Un'ex diga di un ettaro, alta 11 metri e risalente al 1872, costruita dai minatori per produrre vapore per far funzionare le attrezzature meccanizzate, ammaccare le gallerie e lavare il minerale di pirite ferrosa."
    ],
    "fr": [
      "Ancien barrage d'un hectare, de 11 mètres de haut datant de 1872 réalisé par les mineurs pour fabriquer de la vapeur d'eau, afin de faire marcher des équipement mécanisés, bru-miser les galeries et laver le minerai de pyrite de fer."
    ],
    "es": [
      "Una antigua presa de una hectárea y 11 metros de altura que data de 1872, construida por los mineros para producir vapor con el fin de hacer funcionar los equipos mecanizados, machacar las galerías y lavar el mineral de pirita de hierro."
    ],
    "nl": [
      "Een voormalige dam van een hectare en 11 meter hoog uit 1872, gebouwd door de mijnwerkers om stoom te produceren voor gemechaniseerde apparatuur, het kneuzen van de galerijen en het wassen van het ijzerpyrieterts."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bassin de la Falconnière"
    ]
  },
