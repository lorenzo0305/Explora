  "rdfs:comment": {
    "de": [
      "Das Dorf Peillonnex birgt einen Schatz, der die Zeiten überdauert hat. Betreten Sie sein Priorat aus dem 12. Jahrhundert und entdecken Sie seinen wunderschönen barocken Chorhintergrund mit einem Ton- und Lichtspiel von seltener Qualität."
    ],
    "en": [
      "The town of Peillonnex conceals a treasure that has survived the ages. Enter his Priory of the XII century and discover its magnificent baroque choir background with a sound and light of a rare quality ."
    ],
    "it": [
      "Il villaggio di Peillonnex ospita un tesoro che ha superato la prova del tempo. Entrate nel Priorato del XII secolo e scoprite il suo magnifico coro barocco con uno spettacolo di suoni e luci di rara qualità."
    ],
    "fr": [
      "Le village de Peillonnex recèle un trésor qui a su traverser les âges. Entrez dans son Prieuré du XII siècle et découvrez son magnifique fond de chœur baroque avec un son et lumière d'une qualité rare."
    ],
    "nl": [
      "Het dorp Peillonnex herbergt een schat die de tand des tijds heeft doorstaan. Ga de 12e-eeuwse priorij binnen en ontdek het prachtige barokkoor met een klank- en lichtspel van zeldzame kwaliteit."
    ],
    "es": [
      "El pueblo de Peillonnex alberga un tesoro que ha resistido el paso del tiempo. Entre en el Priorato del siglo XII y descubra su magnífico coro barroco con un espectáculo de luz y sonido de rara calidad."
    ]
  },
  "rdfs:label": {
