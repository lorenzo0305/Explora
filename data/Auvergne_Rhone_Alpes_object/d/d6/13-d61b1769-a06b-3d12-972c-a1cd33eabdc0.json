  "rdfs:comment": {
    "de": [
      "Mathilde und Sébastien freuen sich, Sie in ihrem Restaurant \"Le p'tit Châtillon\" begrüßen zu dürfen\r\nLassen Sie sich mittags mit einer authentischen und traditionellen Küche verwöhnen.\r\nAm Abend ein moderneres Konzept mit Tapas und Bruschettas."
    ],
    "en": [
      "Mathilde and Sébastien are pleased to welcome you in their restaurant \"Le p'tit Châtillon\"\r\nCome and enjoy an authentic and traditional cuisine for lunch.\r\nIn the evening a more modern concept with tapas and bruschettas."
    ],
    "it": [
      "Mathilde e Sébastien sono lieti di darvi il benvenuto nel loro ristorante \"Le p'tit Châtillon\"\r\nVenite a gustare una cucina autentica e tradizionale a pranzo.\r\nLa sera un concetto più moderno con tapas e bruschette."
    ],
    "fr": [
      "Mathilde et Sébastien ont la joie de vous accueillir dans leur restaurant \"Le p'tit Châtillon\". \r\nVenez vous régaler avec une cuisine authentique et traditionnelle le midi.\r\nLe soir un concept plus moderne avec tapas et bruschettas."
    ],
    "es": [
      "Mathilde y Sébastien se complacen en darle la bienvenida a su restaurante \"Le p'tit Châtillon\"\r\nVenga a disfrutar de una cocina auténtica y tradicional a la hora de comer.\r\nPor la noche un concepto más moderno con tapas y bruschettas."
    ],
    "nl": [
      "Mathilde en Sébastien heten u van harte welkom in hun restaurant \"Le p'tit Châtillon\"\r\nKom 's middags genieten van een authentieke en traditionele keuken.\r\nS Avonds een moderner concept met tapas en bruschetta's."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le p'tit Châtillon"
    ]
  },
