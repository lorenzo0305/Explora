  "rdfs:comment": {
    "de": [
      "Ihr werdet es mögen: diese grüne Oase nur wenige Schritte von der Kathedrale von Amiens entfernt und im Herzen der Hortillonnages gelegen"
    ],
    "en": [
      "You'll love this oasis of greenery just a stone's throw from Amiens Cathedral, nestled in the heart of the Hortillonnages"
    ],
    "it": [
      "Vi piacerà: questa oasi di verde a due passi dalla Cattedrale di Amiens, nel cuore degli Hortillonnages"
    ],
    "fr": [
      "Vous aimerez : cette oasis de verdure située à quelques pas de la cathédrale d'Amiens et nichée au cœur des Hortillonnages"
    ],
    "es": [
      "Le encantará: este oasis de verdor a dos pasos de la catedral de Amiens, enclavado en el corazón de los Hortillonnages"
    ],
    "nl": [
      "Je zult ervan houden: deze oase van groen op een steenworp afstand van de kathedraal van Amiens, genesteld in het hart van de Hortillonnages"
    ]
  },
