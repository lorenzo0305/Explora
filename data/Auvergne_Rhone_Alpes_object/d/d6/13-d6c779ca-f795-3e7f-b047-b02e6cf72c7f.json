  "rdfs:comment": {
    "de": [
      "WOZU SOLL ICH DAS TUN?\r\n    Gegenstände, Know-how, Ideen, Dienstleistungen austauschen...\r\n    Die Fähigkeiten jedes Einzelnen entdecken und nutzen.\r\n    Tauschen, unabhängig von der materiellen Situation\r\n    Sich begegnen\r\n    Solidarität entwickeln\r\n    Zwischen Generationen teilen"
    ],
    "en": [
      "WHAT FOR?\r\n    Exchange objects, know-how, ideas, services...\r\n    Discover and use each other's skills\r\n    Exchange, whatever your material situation\r\n    Meet new people\r\n    Develop solidarity\r\n    Share between generations"
    ],
    "it": [
      "PER COSA?\r\n    Scambio di oggetti, know-how, idee, servizi...\r\n    Scoprire e utilizzare le competenze degli altri\r\n    Scambio, qualunque sia la vostra situazione materiale\r\n    Incontrarsi\r\n    Sviluppare la solidarietà\r\n    Condivisione tra generazioni"
    ],
    "fr": [
      "POUR QUOI FAIRE ?\r\n    Echanger objets, savoir-faire, idées, services...\r\n    Découvrir et utiliser les compétences de chacun\r\n    Echanger, quelle que soit sa situation matérielle\r\n    Se rencontrer\r\n    Développer la solidarité\r\n    Partager entre générations"
    ],
    "es": [
      "¿PARA QUÉ?\r\n    Intercambiar objetos, conocimientos, ideas, servicios...\r\n    Descubrir y utilizar las habilidades de los demás\r\n    Intercambio, sea cual sea su situación material\r\n    Conocerse entre sí\r\n    Desarrollar la solidaridad\r\n    Compartir entre generaciones"
    ],
    "nl": [
      "WAARVOOR?\r\n    Uitwisselen van voorwerpen, knowhow, ideeën, diensten...\r\n    Elkaars vaardigheden ontdekken en gebruiken\r\n    Uitwisselen, ongeacht je materiële situatie\r\n    Elkaar ontmoeten\r\n    Solidariteit ontwikkelen\r\n    Delen tussen generaties"
    ]
  },
  "rdfs:label": {
    "fr": [
      "SEL (Système d'Echange Local) des Deux Rives"
