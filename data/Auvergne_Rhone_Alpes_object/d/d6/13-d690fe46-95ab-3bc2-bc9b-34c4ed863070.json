  "rdfs:comment": {
    "de": [
      "Die Herausforderung Bressan mit dem Mountainbike oder Gravel, die GST eine sehr große Schleife auf den Wegen der Haute Bresse mit dem einzigen Ziel, dieses Terroir in einem totalen Eintauchen zu genießen."
    ],
    "en": [
      "Le défi bressan à VTT, or à Gravel, the GST, a very long loop on the trails of Haute Bresse with the sole aim of enjoying this terroir in total immersion."
    ],
    "it": [
      "Le défi bressan à VTT, o à Gravel, il GST è un lunghissimo giro sui sentieri della Haute Bresse con l'unico obiettivo di godere di questo terroir in totale immersione."
    ],
    "fr": [
      "Le défi bressan à VTT, ou à Gravel, la GST une très grande boucle sur les chemins de la Haute Bresse avec pour seul objectif, profiter de ce terroir dans une immersion totale."
    ],
    "es": [
      "Le défi bressan à VTT, ou à Gravel, el GST es un bucle muy largo por los senderos de Haute Bresse con el único objetivo de disfrutar de este terruño en inmersión total."
    ],
    "nl": [
      "Le défi bressan à VTT, of à Gravel, de GST is een zeer lange lus over de paden van de Haute Bresse met als enige doel te genieten van dit terroir in totale onderdompeling."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit Gravel n°23 (black) La Grande Sarrasine Tour"
    ],
    "fr": [
      "Circuit Gravel n°23 (noir) La Grande Sarrasine Tour"
    ]
  },
