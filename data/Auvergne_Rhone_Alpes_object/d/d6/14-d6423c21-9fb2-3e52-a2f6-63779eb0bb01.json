  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6a9b2ad2-1e70-3d4a-b9fe-e1cb5081165c",
      "dc:description": {
        "de": [
          "Ein Vogelfutterhäuschen, eine Geldbörse, ein Papierkorb oder eine clevere Aufbewahrung?lernen Sie, wie Sie aus Dingen, die Sie nicht mehr brauchen, etwas herstellen können."
        ],
        "en": [
          "A bird feeder, a purse, a wastepaper basket or a clever storage unit?learn how to make something out of things you no longer need."
        ],
        "it": [
          "Una mangiatoia per uccelli, una borsetta, un cestino per la carta straccia o un ingegnoso portaoggetti? Imparate a creare qualcosa con gli oggetti che non vi servono più."
        ],
        "fr": [
          "Une mangeoire à oiseau, un porte-monnaie, une corbeille à papier ou un range tout malin…apprenez à fabriquer un objet avec des choses dont vous n’avez plus besoin."
        ],
        "es": [
          "Un comedero para pájaros, un monedero, una papelera o un ingenioso mueble de almacenaje... aprende a hacer algo con cosas que ya no necesitas."
        ],
        "nl": [
          "Een vogelvoederhuisje, een tasje, een prullenmand of een slim opbergmeubel? Leer hoe je iets kunt maken van dingen die je niet meer nodig hebt."
        ]
      },
