  "rdfs:comment": {
    "de": [
      "Das Maison Legate vereint das Restaurant Le Vieux Four, das ***Hotel Le Baudière sowie das Institut und SPA \"A corps des sens\". NEU 2025: Diese Einrichtung ist mit dem Gütesiegel ACCUEIL VELO ausgezeichnet!"
    ],
    "en": [
      "La Maison Legate includes the Le Vieux Four restaurant, the *** Le Baudière hotel and the \"A corps des sens\" Institute and SPA. NEW for 2025: This establishment has been awarded the \"ACCUEIL VELO\" label!"
    ],
    "it": [
      "La Maison Legate comprende il ristorante Le Vieux Four, l'hotel *** Le Baudière e l'Istituto e SPA \"A corps des sens\". NOVITÀ per il 2025: questa struttura ha ottenuto il marchio \"ACCUEIL VELO\"!"
    ],
    "fr": [
      "La Maison Legate rassemble, le restaurant Le Vieux Four,  l'hôtel *** Le Baudière ainsi que l'Institut et SPA \"A corps des sens\". NOUVEAUTE 2025 : Cet établissement est labellisé ACCUEIL VELO !"
    ],
    "nl": [
      "La Maison Legate omvat het restaurant Le Vieux Four, het hotel *** Le Baudière en het instituut en de SPA \"A corps des sens\". NIEUW voor 2025: dit etablissement heeft het label \"ACCUEIL VELO\" gekregen!"
    ],
    "es": [
      "La Maison Legate incluye el restaurante Le Vieux Four, el hotel *** Le Baudière y el Instituto y SPA \"A corps des sens\". Novedad para 2025: ¡este establecimiento ha obtenido la etiqueta \"ACCUEIL VELO\"!"
    ]
  },
