  "rdfs:comment": {
    "de": [
      "Es ist ein Gasthaus im Herzen eines der schönsten Dörfer Frankreichs. Zu den Augenfreuden, die Ihnen unsere Lage bietet, kommen dank der Küche von Georges, Maître Restaurateur, noch die Gaumenfreuden hinzu."
    ],
    "en": [
      "It is a hostel in the heart of one of the Most Beautiful Villages in France. To the pleasures of the eyes that our location offers you, will be added that of the taste buds thanks to the cuisine of Georges, master restaurateur."
    ],
    "it": [
      "È una locanda nel cuore di uno dei più bei villaggi della Francia. I piaceri della vista offerti dalla nostra location saranno completati dai piaceri del palato grazie alla cucina di Georges, maestro ristoratore."
    ],
    "fr": [
      "C'est une auberge au cœur d'un des Plus Beaux Villages de France. Aux plaisirs des yeux que vous offre notre emplacement, s'ajoutera celui des papilles grâce à la cuisine de Georges, maître restaurateur."
    ],
    "nl": [
      "Het is een herberg in het hart van een van de mooiste dorpen van Frankrijk. Naast de geneugten van het oog die onze locatie biedt, zult u ook genieten van de smaakpapillen dankzij de keuken van Georges, meester-restaurateur."
    ],
    "es": [
      "Es una posada en el corazón de uno de los pueblos más bellos de Francia. Los placeres de la vista que ofrece nuestra ubicación se verán complementados por los placeres del paladar gracias a la cocina de Georges, maestro restaurador."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de Margot"
    ]
  },
