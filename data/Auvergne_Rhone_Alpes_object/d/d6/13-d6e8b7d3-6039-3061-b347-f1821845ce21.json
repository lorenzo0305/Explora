  "rdfs:comment": {
    "de": [
      "La Corniche heißt Sie willkommen, um eine savoyische Küche zu genießen.\r\nEin geselliger, gemütlicher und bergischer Ort."
    ],
    "en": [
      "La Corniche welcomes you to enjoy Savoyard cuisine. \r\nA friendly, warm, and mountain-like place."
    ],
    "it": [
      "La Corniche vi accoglie per gustare la cucina savoiarda. \r\nUn luogo accogliente, caldo e montano."
    ],
    "fr": [
      "La Corniche vous accueille pour déguster une cuisine savoyarde. \r\nUn lieu convivial, chaleureux et montagnard."
    ],
    "es": [
      "La Corniche le da la bienvenida para saborear la cocina de Saboya.\r\nUn entorno de montaña cálido y acogedor."
    ],
