  "rdfs:comment": {
    "de": [
      "Eine sehr rollende Strecke mit einer sehr spielerischen Abfahrt durch den Wald von Malissol. Ideal für einen erlebnisreichen Ausflug. Strecke Nr. 13 mit schwarzer Markierung.\r\nStart Camping des Cordeliers Pierre Châtel"
    ],
    "en": [
      "A pleasant trip  that drives well trough the forest of Malissol. Ideal for great emotions. Itinerary 13, difficulty level : black."
    ],
    "it": [
      "Un circuito molto veloce con una discesa molto divertente nella foresta di Malissol. Ideale per una gita emozionante. L'itinerario n. 13 è tracciato in nero.\r\nPartenza dal campeggio Cordeliers di Pierre Châtel"
    ],
    "fr": [
      "Circuit très roulant comportant une descente très ludique dans la forêt de Malissol. Idéal pour une sortie forte en émotions. Parcours n°13 balisé en noir.\r\nDépart camping des Cordeliers Pierre Châtel"
    ],
    "es": [
      "Un circuito muy rápido con un descenso muy divertido en el bosque de Malissol. Ideal para una excursión emocionante. Ruta n°13 marcada en negro.\r\nSalida del camping Cordeliers en Pierre Châtel"
    ],
    "nl": [
      "Een ludieke en makkelijk rijdende tocht in het woud \"de Malissol\". Ideaal voor een tochtje rijk aan emoties. Parcours   : zwart."
    ]
  },
