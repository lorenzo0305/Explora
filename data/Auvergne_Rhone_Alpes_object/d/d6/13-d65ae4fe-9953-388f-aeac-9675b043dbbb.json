  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant l'Estampille befindet sich am Fuße der Festung von Saint Vidal auf dem Platz des charaktervollen Dorfes. Starten Sie von diesem warmen und geselligen Ort aus zu zahlreichen Wanderungen und Aktivitäten, entdecken Sie unsere Region und ihr reiches Kulturerbe."
    ],
    "en": [
      "The Estampille hotel-restaurant is located at the foot of the Saint Vidal fortress, on the village square. Set off from this warm and friendly place for many hikes and activities, and discover our region and its rich heritage."
    ],
    "it": [
      "L'hotel-ristorante l'Estampille si trova ai piedi della fortezza di Saint Vidal, sulla piazza del paese. Partite da questo luogo caldo e accogliente per una vasta gamma di passeggiate e attività, e scoprite la nostra regione e il suo ricco patrimonio."
    ],
    "fr": [
      "L'hôtel-restaurant l'Estampille se trouve au pied de la forteresse de Saint Vidal sur la place du village de caractère. Partez de ce lieu chaleureux et convivial pour de nombreuses randonnées et activités, découvrez notre région et son riche patrimoine."
    ],
    "nl": [
      "Hotel-restaurant l'Estampille ligt aan de voet van het fort van Saint Vidal op het dorpsplein. Vertrek vanuit deze warme en gezellige plek voor tal van wandelingen en activiteiten, en ontdek onze streek en haar rijke erfgoed."
    ],
    "es": [
      "El hotel-restaurante l'Estampille está situado al pie de la fortaleza de Saint Vidal, en la plaza del pueblo. Salga de este lugar cálido y acogedor para realizar numerosos paseos y actividades, y descubra nuestra región y su rico patrimonio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel L'Estampille"
    ]
  },
