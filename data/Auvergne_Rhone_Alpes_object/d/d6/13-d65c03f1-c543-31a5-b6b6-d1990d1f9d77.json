  "rdfs:comment": {
    "de": [
      "Bauernherberge, in der die Produktion des Bauernhofs gekocht wird: Gemüse, Obst, Geflügel, Honig. Zur Ergänzung werden lokale Bioprodukte angeboten: Käse, Brot, Mehl....Nach oder vor dem Essen werden Spaziergänge zu den Tieren angeboten."
    ],
    "en": [
      "Auberge paysanne (country inn) where we cook the farm's produce: vegetables, fruit, poultry, honey, with local organic products such as cheese, bread and flour....After or before the meal, we offer walks to see the animals."
    ],
    "it": [
      "Auberge paysanne (locanda di campagna) dove si possono cucinare i prodotti della fattoria: verdura, frutta, pollame e miele, con prodotti biologici locali come formaggio, pane e farina per completare il pasto....A o prima del pasto, si può fare una passeggiata per vedere gli animali."
    ],
    "fr": [
      "Auberge paysanne où l'on cuisine la production de la ferme : légumes, fruits, volaille, miel, avec pour compléter, des produits bio locaux : fromages, pain, farine....Après ou avant le repas, des promenades pour aller voir les animaux sont proposées."
    ],
    "nl": [
      "Auberge paysanne (plattelandsherberg) waar je kunt koken met de producten van de boerderij: groenten, fruit, gevogelte en honing, met lokale biologische producten zoals kaas, brood en meel om de maaltijd af te ronden....Afsluitend of voor de maaltijd kun je een wandeling maken om de dieren te zien."
    ],
    "es": [
      "Auberge paysanne (albergue rural) donde podrá cocinar los productos de la granja: verduras, frutas, aves de corral y miel, con productos ecológicos locales como queso, pan y harina para completar la comida....A o antes de la comida, podrá dar un paseo para ver los animales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table de Vailhac"
    ]
  },
