  "rdfs:comment": {
    "de": [
      "Entdecken Sie Wild- und Heilpflanzen, lernen Sie, wie man sie sammelt und vor Ort zu natürlichen Heilmitteln verarbeitet.\r\nThema des Tages : Essig aus frischen Pflanzen"
    ],
    "en": [
      "Discover wild and medicinal plants, learn how to pick them and transform them into natural remedies on the spot.\r\nToday's theme: Fresh plant vinegar"
    ],
    "it": [
      "Scoprite le piante selvatiche e medicinali, imparate a raccoglierle e a trasformarle in rimedi naturali sul posto.\r\nIl tema di oggi: Aceto di piante fresche"
    ],
    "fr": [
      "Découvrez les plantes sauvages et médicinales, apprenez à les cueillir et les transformer en remède naturel sur place. \r\nThème du jour : Vinaigre de plante fraîche"
    ],
    "nl": [
      "Ontdek wilde en geneeskrachtige planten, leer ze te plukken en verander ze ter plekke in natuurlijke remedies.\r\nThema van vandaag: Verse plantenazijn"
    ],
    "es": [
      "Descubra plantas silvestres y medicinales, aprenda a recolectarlas y a transformarlas en remedios naturales sobre el terreno.\r\nEl tema de hoy: Vinagre de plantas frescas"
    ]
  },
  "rdfs:label": {
