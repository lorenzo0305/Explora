  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen angenehmen Abend in Aurec!\r\nDas Rathaus von Aurec-sur-Loire und GALA organisieren die Fête de la Musique im Stadtzentrum. Mehrere Aurecoiser Einrichtungen werden an der Veranstaltung teilnehmen.\r\nKommen Sie zahlreich!"
    ],
    "en": [
      "Come and enjoy an evening in Aurec!\r\nThe Mairie d'Aurec-sur-Loire and GALA are organizing the Fête de la Musique in the town center. Several Aurec establishments will be taking part.\r\nCome one, come all!"
    ],
    "it": [
      "Venite a godervi una serata ad Aurec!\r\nLa Mairie d'Aurec-sur-Loire e GALA organizzano un festival musicale nel centro della città. Diversi locali di Aurec vi parteciperanno.\r\nNon mancate!"
    ],
    "fr": [
      "Venez passer une agréable soirée à Aurec ! \r\nLa Mairie d'Aurec-sur-Loire et GALA organisent la fête de la musique dans le centre-ville. Plusieurs établissements aurécois participeront à l'événement.\r\nVenez nombreux !"
    ],
    "nl": [
      "Kom genieten van een avond in Aurec!\r\nDe Mairie d'Aurec-sur-Loire en GALA organiseren een muziekfestival in het stadscentrum. Verschillende etablissementen in Aurec doen mee.\r\nMis het niet!"
    ],
    "es": [
      "Disfrute de una velada en Aurec\r\nEl ayuntamiento de Aurec-sur-Loire y GALA organizan un festival de música en el centro de la ciudad. Varios establecimientos de Aurec participarán en él.\r\n¡No se lo pierda!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête de la musique"
    ]
  },
