  "rdfs:comment": {
    "de": [
      "Sie ist Eigentum der Gemeinde, liegt eingebettet im alten Dorf in der Nähe des Schlosses und wurde 1509 nach einem Besuch des Bischofs erbaut."
    ],
    "en": [
      "Owned by the commune and set in the old village near the castle, it was built in 1509, following a visit by the bishop."
    ],
    "it": [
      "Di proprietà del Comune, si trova nel borgo antico vicino al castello e fu costruito nel 1509, in seguito a una visita del vescovo."
    ],
    "fr": [
      "Propriété de la commune, enclavée dans le vieux village près du château, elle a été construite en 1509, suite à une visite épiscopale."
    ],
    "nl": [
      "Het is eigendom van de gemeente en ligt in het oude dorp vlakbij het kasteel. Het werd gebouwd in 1509, na een bezoek van een bisschop."
    ],
    "es": [
      "Es propiedad del municipio y se encuentra en el antiguo pueblo, cerca del castillo. Se construyó en 1509, tras una visita del obispo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "l'église de Saint Pierre aux liens"
    ]
  },
