  "rdfs:comment": {
    "de": [
      "1. 100% hausgemachte Boutique im Allier.\r\nBei Doonut finden Sie eine Auswahl an Donuts, New York Rolls und Cookies. Die Backwaren werden jeden Tag hausgemacht, mit lokalen und saisonalen Rohstoffen."
    ],
    "en": [
      "1st 100% home-made store in Allier.\r\nAt Doonut, you'll find a range of donuts, New York rolls and cookies. The pastries are homemade every day, using local, seasonal ingredients."
    ],
    "it": [
      "il primo negozio 100% artigianale dell'Allier.\r\nDoonut offre una gamma di ciambelle, panini newyorkesi e biscotti. I dolci sono fatti in casa ogni giorno, con ingredienti locali e di stagione."
    ],
    "fr": [
      "1ère boutique 100% fait maison dans l'Allier.\r\nChez Doonut, retrouvez une gamme de donuts, New York roll et cookies. Les pâtisseries sont faite maison chaque jour, avec des matières premières locales et de saison."
    ],
    "es": [
      "la 1ª tienda 100% artesanal del Allier.\r\nDoonut ofrece una gama de donuts, panecillos de Nueva York y galletas. La bollería se elabora artesanalmente todos los días, con ingredientes locales y de temporada."
    ],
    "nl": [
      "de 1e 100% huisgemaakte winkel in de Allier.\r\nDoonut biedt een assortiment donuts, New Yorkse broodjes en koekjes. Het gebak wordt elke dag zelfgemaakt met lokale en seizoensgebonden ingrediënten."
    ]
  },
  "rdfs:label": {
