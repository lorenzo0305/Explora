  "rdfs:comment": {
    "de": [
      "Ancien Crossey (Crossey 1) ist eine historische Stätte, die im PDESI des Département de l'Isère eingetragen ist. Der Zugang wurde von diesem eingerichtet. Es handelt sich um einen Teilbereich des Klettergebiets Gorges de Crossey, das jüngeren Datums ist."
    ],
    "en": [
      "The Old Crossey (Crossey 1) is a historic site registered with the PDESI of the Department of Isère. The access was arranged by the latter."
    ],
    "it": [
      "L'Ancien Crossey (Crossey 1) è un sito storico inserito nel PDESI del dipartimento dell'Isère. L'accesso al sito è stato fornito dal Dipartimento. È un sotto-settore del più recente sito di arrampicata delle Gorges de Crossey."
    ],
    "fr": [
      "L'Ancien Crossey (Crossey 1) est un site historique inscrit au PDESI du Département de l'Isère. L'accès a été aménagé par ce dernier. Il s'agit d'un sous-secteur du site d'escalade des Gorges de Crossey, plus récent."
    ],
    "nl": [
      "Ancien Crossey (Crossey 1) is een historische site die is opgenomen in de PDESI van het departement Isère. Toegang tot de site werd verleend door het departement. Het is een subsector van de recentere klimlocatie Gorges de Crossey."
    ],
    "es": [
      "Ancien Crossey (Crossey 1) es un sitio histórico inscrito en el PDESI del departamento de Isère. El acceso al sitio fue facilitado por el Département. Es un subsector del más reciente sitio de escalada Gorges de Crossey."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing site – Crossey 1"
    ],
    "fr": [
      "Site d'escalade - Crossey 1"
    ]
  },
