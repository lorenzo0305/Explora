  "rdfs:comment": {
    "de": [
      "Marches liegt auf einer Anhöhe, die die Ebene überragt, und ist ein blumenreiches Dorf: Bäume, Blumenbeete und makellose Rasenflächen bieten den Häusern eine besondere Kulisse."
    ],
    "en": [
      "Set on a hill overlooking the plain, Marches is a village in bloom: trees, flowerbeds and impeccable lawns provide a privileged backdrop for the houses."
    ],
    "it": [
      "Situato su una collina che domina la pianura, Marche è un villaggio fiorito: alberi, aiuole e prati impeccabili fanno da cornice privilegiata alle case."
    ],
    "fr": [
      "Etabli sur une éminence dominant la plaine, Marches est un village fleuri : arbres, parterres de fleurs, pelouses impeccables offrent aux maisons un décor privilégié."
    ],
    "nl": [
      "Marches kijkt vanaf de heuveltop over de vlakte uit. Het is een uitermate groen dorp vol geuren en kleuren, met rond alle huizen een pracht aan bloemen en planten, talrijke boomsoorten, mooie gazons..."
    ],
    "es": [
      "Establecido en una colina que domina la llanura, Marches es un pueblo florido: árboles, parterres y céspedes impecables proporcionan un entorno privilegiado a las casas."
    ]
  },
