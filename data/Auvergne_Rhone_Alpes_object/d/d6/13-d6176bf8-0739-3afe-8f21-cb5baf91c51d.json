  "rdfs:comment": {
    "de": [
      "Grand Angle ist ein Reisebüro, das sich auf Wanderungen, Radtouren, Skitouren und Schneeschuhwanderungen spezialisiert hat; in begleiteten Gruppen oder auf eigene Faust, in Frankreich und in Europa."
    ],
    "en": [
      "Grand Angle is a travel agency specialising in hiking, biking, skiing and snowshoeing; in accompanied groups or on your own, in France and Europe."
    ],
    "it": [
      "Grand Angle è un'agenzia di viaggi specializzata in escursioni a piedi, in bicicletta, sugli sci e con le racchette da neve, in gruppi guidati o da soli, in Francia e in Europa."
    ],
    "fr": [
      "Grand Angle est une agence de voyages spécialiste de la randonnée à pied, à vélo, à ski et en raquettes ; en groupe accompagné ou en liberté, en France et en Europe."
    ],
    "nl": [
      "Grand Angle is een reisbureau gespecialiseerd in wandelen, fietsen, skiën en sneeuwschoenwandelen; in groepsverband of op eigen gelegenheid, in Frankrijk en Europa."
    ],
    "es": [
      "Grand Angle es una agencia de viajes especializada en senderismo, ciclismo, esquí y excursiones con raquetas de nieve; en grupos guiados o por tu cuenta, en Francia y Europa."
    ]
  },
