  "rdfs:comment": {
    "de": [
      "Die Stadtverwaltung von Plateau-des-Petites-Roches stellt den Hors-Sac-Saal gemäß der unten aufgeführten Preisliste jedermann zur Verfügung.\r\n\r\nDer Raum kann als Versammlungsraum, Hörsaal oder für Feiern genutzt werden."
    ],
    "en": [
      "The Plateau-des-Petites-Roches Town Hall makes the Hors-Sac room available to the general public at the rates shown below.\r\n\r\nThis room can be used as a meeting room, an audition room or for festivities."
    ],
    "it": [
      "Il Municipio di Plateau-des-Petites-Roches mette a disposizione del pubblico la sala Hors-Sac alle tariffe indicate di seguito.\r\n\r\nQuesta sala può essere utilizzata come sala riunioni, sala audizioni o sala per festeggiamenti."
    ],
    "fr": [
      "La Mairie du Plateau-des-Petites-Roches met à disposition de tout public la salle Hors-Sac, selon la tarification présentée ci-dessous.\r\n\r\nCette salle peut être utilisée comme une salle de réunion, une salle d’audition ou salle pour des festivités."
    ],
    "nl": [
      "Het gemeentehuis van Plateau-des-Petites-Roches stelt de zaal Hors-Sac beschikbaar voor het grote publiek tegen de onderstaande tarieven.\r\n\r\nDeze zaal kan gebruikt worden als vergaderzaal, auditiezaal of feestzaal."
    ],
    "es": [
      "El Ayuntamiento de Plateau-des-Petites-Roches pone a disposición del público la sala Hors-Sac con las tarifas que se indican a continuación.\r\n\r\nEsta sala puede utilizarse como sala de reuniones, sala de audiciones o sala para fiestas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle Hors Sac - Saint Hilaire du Touvet"
    ]
  },
