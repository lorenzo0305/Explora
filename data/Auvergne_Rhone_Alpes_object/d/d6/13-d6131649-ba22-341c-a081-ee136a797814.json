  "rdfs:comment": {
    "de": [
      "Les Tontons, Ihr Treffpunkt für Genießer, am Fuße der Pisten, im Herzen von La Daille in Val d'Isère.\r\nEin komplett renovierter Ort mit einer warmen und entspannten Atmosphäre, wo man sich trifft, um gut zu essen, gut zu trinken und vor allem eine gute Zeit zu verbringen."
    ],
    "en": [
      "Les Tontons, your go-to spot for good living, at the foot of the slopes, in the heart of La Daille in Val d’Isère. A fully renovated place with a warm and relaxed atmosphere, where people gather to eat well, drink well, and above all, have a great time."
    ],
    "it": [
      "Les Tontons, il vostro punto di riferimento per chi ama la buona vita, ai piedi delle piste, nel cuore di La Daille a Val d’Isère. Un luogo completamente ristrutturato, con un'atmosfera calda e rilassata, dove ci si ritrova per mangiare bene, bere bene e soprattutto trascorrere un buon momento."
    ],
    "fr": [
      "Les Tontons, votre repère des bons vivants, au pied des pistes, au cœur de La Daille à Val d’Isère.\r\nUn lieu entièrement rénové, à l’ambiance chaleureuse et décontractée, où l’on se retrouve pour bien manger, bien boire et surtout passer un bon moment."
    ],
    "es": [
      "Les Tontons, el lugar de los \"bon vivants\", al pie de las pistas, en el corazón de La Daille, en Val d'Isère.\r\nUn local totalmente renovado, con un ambiente cálido y distendido, donde se come bien, se bebe bien y, sobre todo, se pasa un buen rato."
    ],
    "nl": [
      "Les Tontons, de place to be voor levensgenieters, aan de voet van de pistes, in het hart van La Daille in Val d'Isère.\r\nEen volledig gerenoveerde locatie met een warme, ontspannen sfeer, waar je goed kunt eten, goed kunt drinken en vooral veel plezier kunt hebben."
    ]
  },
  "rdfs:label": {
