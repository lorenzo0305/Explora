  "rdfs:comment": {
    "de": [
      "Produktionshof für BIO-Gemüseanbau in Rencurel auf 750 m Höhe gelegen. Verkauf ab Hof samstags im Juli und August. Körbe à la carte mittwochs mit 3 Lieferpunkten. Veranstaltungen und Besuche auf dem Bauernhof."
    ],
    "en": [
      "Organic market-gardening farm located in Rencurel at 750 m altitude. Saturday farm sales in July and August. A la carte baskets on Wednesdays with 3 delivery points. Events and visits to the farm."
    ],
    "it": [
      "Azienda agricola biologica a conduzione familiare situata a Rencurel, a 750 m di altitudine. Vendita alla porta della fattoria il sabato in luglio e agosto. Cesti alla carta il mercoledì con 3 punti di consegna. Eventi e visite alla fattoria."
    ],
    "fr": [
      "Ferme de production en maraîchage BIO située à Rencurel à 750 m d'altitude. Vente à la ferme les samedis en juillet et août. Paniers à la carte les mercredis avec 3 points de livraison. Événements et visites à la Ferme."
    ],
    "es": [
      "Granja de horticultura ecológica situada en Rencurel, a 750 m de altitud. Venta a domicilio los sábados de julio y agosto. Cestas a la carta los miércoles con 3 puntos de entrega. Eventos y visitas a la granja."
    ],
    "nl": [
      "Biologische tuinderij in Rencurel op 750 m hoogte. Boerderijverkoop op zaterdag in juli en augustus. Manden à la carte op woensdag met 3 leveringspunten. Evenementen en bezoeken aan de boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme des Sisampas"
    ]
  },
