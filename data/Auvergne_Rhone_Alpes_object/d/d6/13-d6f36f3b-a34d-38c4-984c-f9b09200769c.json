  "rdfs:comment": {
    "de": [
      "Ihr Restaurant lädt Sie ein, eine abwechslungsreiche Speisekarte mit Sandwiches, Salaten, Pasta und warmen Gerichten zu entdecken, die Sie vor Ort verzehren, mitnehmen oder sich liefern lassen können. Unser Catering-Angebot begleitet Sie den ganzen Tag über Frühstück, Lunchpakete und Cocktails."
    ],
    "en": [
      "Your restaurant invites you to discover a varied menu of sandwiches, salads, pastas and hot dishes to eat in, take away or deliver. Our catering service is available all day long for breakfasts, lunch boxes and cocktails."
    ],
    "it": [
      "Il vostro ristorante vi invita a scoprire un menu vario di panini, insalate, pasta e piatti caldi da consumare in casa, da asporto o da consegnare. La nostra offerta di ristorazione vi accompagna per tutto il giorno: colazione, lunch box, cocktail."
    ],
    "fr": [
      "Votre restaurant vous invite à découvrir une carte variée de sandwichs, salades, pâtes et plats chauds à consommer sur place , à emporter ou en livraison . Notre offre traiteur vous accompagne toute la journée  petit déjeuner , coffrets repas , cocktail ."
    ],
    "es": [
      "Su restaurante le invita a descubrir una variada carta de sándwiches, ensaladas, pasta y platos calientes para comer en casa, para llevar o para entregar. Nuestra oferta de restauración le acompaña durante todo el día: desayunos, cajas de almuerzo, cócteles."
    ],
    "nl": [
      "Je restaurant nodigt je uit om een gevarieerd menu van sandwiches, salades, pasta en warme gerechten te ontdekken om te eten, mee te nemen of te bezorgen. Onze traiteurdienst is de hele dag beschikbaar voor ontbijt, lunchpakketten en cocktails."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Class'Croute"
    ]
  },
