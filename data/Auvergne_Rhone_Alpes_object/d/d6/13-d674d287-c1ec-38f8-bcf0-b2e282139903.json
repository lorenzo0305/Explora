  "rdfs:comment": {
    "de": [
      "Die legendäre, aus Holz gefertigte Statuette des Heiligen Grelichon soll Frauen von Unfruchtbarkeit heilen."
    ],
    "en": [
      "The legendary wooden statuette of St. Gretchen is reputed to heal women from sterility."
    ],
    "it": [
      "La leggendaria statuetta di legno di San Relichon si dice che guarisca le donne dalla sterilità."
    ],
    "fr": [
      "La légendaire statuette de Saint-Grelichon faite de bois est réputée pour guérir les femmes de la stérilité."
    ],
    "es": [
      "Se dice que la legendaria estatuilla de madera de San Relicón cura a las mujeres de la esterilidad."
    ],
    "nl": [
      "Het legendarische houten beeldje van St. Relichon zou vrouwen genezen van onvruchtbaarheid."
