      "@id": "https://data.datatourisme.fr/97c00741-2c41-31f3-96a0-c4b314aa0f19",
      "dc:description": {
        "de": [
          "Gehen Sie auf Entdeckungsreise durch den Parc de la Glissoire von gestern und heute. Entdecken Sie die Geschichte des Ortes und genießen Sie die außergewöhnliche Landschaft."
        ],
        "en": [
          "Discover the Parc de la Glissoire, past and present. Discover the history of the site while enjoying an exceptional landscape."
        ],
        "it": [
          "Scoprite il Parc de la Glissoire, passato e presente. Scoprite la storia del sito godendo di uno scenario eccezionale."
        ],
        "fr": [
          "Partez à la découverte du parc de la Glissoire d’hier et d’aujourd’hui. Découvrez l’histoire du lieu tout en profitant d’un paysage d’exception."
        ],
        "nl": [
          "Ontdek het Parc de la Glissoire, vroeger en nu. Ontdek de geschiedenis van de site terwijl je geniet van het uitzonderlijke landschap."
        ],
        "es": [
          "Descubra el Parque de la Glissoire, pasado y presente. Descubra la historia del lugar mientras disfruta de un paisaje excepcional."
        ]
      },
