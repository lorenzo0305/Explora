  "rdfs:comment": {
    "de": [
      "Einführungskurs in die Töpferei in einem Künstleratelier im Herzen der Combrailles. Üben Sie Ihre Kreativität und entdecken Sie die Keramik in einer sehr angenehmen natürlichen Umgebung."
    ],
    "en": [
      "Introductory course in pottery in an artist's studio, in the heart of the Combrailles. Come exercise your creativity and discover ceramics in a very pleasant natural setting."
    ],
    "it": [
      "Corso introduttivo di ceramica in un atelier d'artista nel cuore della regione di Combrailles. Venite a mettere in pratica la vostra creatività e a scoprire la ceramica in un ambiente naturale molto piacevole."
    ],
    "fr": [
      "Stage d'initiation à la poterie dans un atelier d'artiste, au cœur des Combrailles. Venez exercer votre créativité et découvrir la céramique dans un cadre naturel très agréable."
    ],
    "nl": [
      "Inleidende cursus pottenbakken in een kunstenaarsatelier in het hart van de Combrailles. Kom en oefen je creativiteit en ontdek keramiek in een zeer aangename natuurlijke omgeving."
    ],
    "es": [
      "Curso de iniciación a la cerámica en el taller de un artista en el corazón de la región de Combrailles. Venga a practicar su creatividad y a descubrir la cerámica en un entorno natural muy agradable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marilys Ménal Céramiques"
    ]
  },
