  "rdfs:comment": {
    "de": [
      "Direkt von unseren Bauernhöfen und das ganze Jahr über! Direktverkaufsstelle für bäuerliche und/oder biologische Produkte von etwa 30 Bauernhöfen aus dem Pays de Bouvières, dem Eygues-Tal und den Baronnies."
    ],
    "en": [
      "Direct from our farms, all year round! Direct sales of farmhouse and/or organic produce from around thirty farms in the Bouvières, Eygues Valley and Baronnies regions."
    ],
    "it": [
      "Direttamente dalle nostre fattorie, tutto l'anno! Punto di vendita diretta di prodotti agricoli e/o biologici provenienti da una trentina di aziende agricole della regione di Bouvières, della valle dell'Eygues e delle Baronnies."
    ],
    "fr": [
      "En direct de nos fermes, et toute l’année ! Point de vente directe de produits fermiers et/ou biologiques d’une trentaine de fermes du pays de Bouvières, de la vallée de l’Eygues et des Baronnies."
    ],
    "nl": [
      "Rechtstreeks van onze boerderijen, het hele jaar door! Directe verkoop van boerderij- en/of bioproducten van een dertigtal boerderijen in de Bouvières, de vallei van de Eygues en de Baronnies."
    ],
    "es": [
      "Directamente de nuestras granjas, ¡todo el año! Punto de venta directa de productos agrícolas y/o ecológicos procedentes de una treintena de granjas de la región de Bouvières, valle de Eygues y Baronnies."
    ]
  },
  "rdfs:label": {
