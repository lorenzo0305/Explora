  "rdfs:comment": {
    "de": [
      "Seit ihrer Gründung bietet Ihnen die französische Skischule in Belle Plagne eine persönliche Betreuung beim Skifahren, Snowboarden, Handiskiing, Paragliding, Multi-Sliding-Kursen und Skifahren abseits der Pisten."
    ],
    "en": [
      "Belle Plagne ESF offers ski and snowboard lessons, lessons for disabled skiers, paragliding, multi-discipline courses and off-piste skiing."
    ],
    "it": [
      "Fin dalla sua creazione, la scuola di sci francese di Belle Plagne offre una guida personalizzata per lo sci, lo snowboard, l'handiski, il parapendio, i corsi multislitta e lo sci fuori pista."
    ],
    "fr": [
      "Depuis sa création, l'école du ski français de Belle Plagne vous propose un accompagnement personnalisé en ski, snowboard, handiski, parapente, stages multi-glisses et ski hors piste."
    ],
    "nl": [
      "Sinds zijn oprichting biedt de franse Skischool van Belle Plagne U een gepersonaliseerde begeleiding op ski's, snowboard, handiski, paragliding, stages van meerdere ski-disciplines en off-piste ski."
    ],
    "es": [
      "Desde su creación, la escuela de esquí francesa de Belle Plagne ofrece un asesoramiento personalizado en esquí, snowboard, handiski, parapente, cursos de multiesquí y esquí fuera de pista."
    ]
  },
