  "rdfs:comment": {
    "de": [
      "Die Kompanie FépalGuguss bietet das ganze Jahr über Zirkusaktivitäten an: Jonglieren, Balancieren, große Stelzen, Erstellen von Aufführungen, um die Kreativität Ihrer Kinder zu entwickeln."
    ],
    "en": [
      "The company FépalGuguss offers you its circus activities all year round: juggling, balance, big stilts, show creation to develop your children's creativity."
    ],
    "it": [
      "La compagnia FépalGuguss vi offre le sue attività circensi durante tutto l'anno: giocoleria, equilibrismo, grandi trampoli, creazione di spettacoli per sviluppare la creatività dei vostri bambini."
    ],
    "fr": [
      "La compagnie FépalGuguss vous propose ses activités cirque tout au long de l'année : jonglerie, équilibre, grandes échasses, création de spectacle pour développer la créativité de vos enfants."
    ],
    "es": [
      "La compañía FépalGuguss le ofrece sus actividades circenses durante todo el año: malabares, equilibrios, grandes zancos, creación de espectáculos para desarrollar la creatividad de sus hijos."
    ],
    "nl": [
      "Het bedrijf FépalGuguss biedt u het hele jaar door circusactiviteiten aan: jongleren, balanceren, grote stelten, creatie van shows om de creativiteit van uw kinderen te ontwikkelen."
    ]
  },
  "rdfs:label": {
    "fr": [
