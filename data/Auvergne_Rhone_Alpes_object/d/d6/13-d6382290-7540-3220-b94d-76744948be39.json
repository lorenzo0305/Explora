  "rdfs:comment": {
    "de": [
      "Super'b'Immo steht Ihnen für Ihre Suche nach Miet- oder Kaufobjekten zur Verfügung.\r\nFür weitere Informationen wenden Sie sich bitte an Sandra Servières, Immobilienberaterin für den Sektor Saugues-Langeac."
    ],
    "en": [
      "Super'b'Immo is here to help you find properties to rent or for sale.\r\nFor more information, please contact Sandra Servières, real estate advisor for the Saugues-Langeac area."
    ],
    "it": [
      "Super'b'Immo è qui per aiutarvi a trovare immobili in affitto o in vendita.\r\nPer maggiori informazioni, contattate Sandra Servières, agente immobiliare della zona di Saugues-Langeac."
    ],
    "fr": [
      "Super'b'Immo est à votre écoute pour vos recherches de biens en locations ou à la vente. \r\nPour plus d'information, contacter Sandra Servières conseillère immobilière du secteur Saugues-Langeac."
    ],
    "nl": [
      "Super'b'Immo is er om je te helpen bij het vinden van huur- of koopwoningen.\r\nNeem voor meer informatie contact op met Sandra Servières, makelaar voor de regio Saugues-Langeac."
    ],
    "es": [
      "Super'b'Immo está aquí para ayudarle a encontrar propiedades en alquiler o en venta.\r\nPara obtener más información, póngase en contacto con Sandra Servières, agente inmobiliario de la zona de Saugues-Langeac."
    ]
  },
