  "rdfs:comment": {
    "de": [
      "Stoßen Sie die Tür von So'Brunch x L'Atelier des Alpes auf! Ein Feinkostladen, ein Partyservice für Ihre Veranstaltungen, ein Brunch-Konzept zum Mitnehmen, köstliche handgemachte Kekse, Kuchen aus Savoyen... alles in Yenne, Place Charles Dullin, zusammengestellt"
    ],
    "en": [
      "Push the door of So'Brunch x L'Atelier des Alpes! A delicatessen, a catering service for your events, a concept of brunches to take away, delicious artisanal biscuits, Gâteau de Savoie... all concocted in Yenne, Place Charles Dullin"
    ],
    "it": [
      "Aprite la porta di So'Brunch x L'Atelier des Alpes! Una gastronomia, un servizio di catering per i vostri eventi, un concetto di brunch da asporto, deliziosi biscotti fatti in casa, torte savoiarde... il tutto realizzato a Yenne, in Place Charles Dullin"
    ],
    "fr": [
      "Poussez la porte de So'Brunch x L'Atelier des Alpes ! Une épicerie fine, un service traiteur pour vos événements, un concept de brunchs à emporter, de délicieux biscuits artisanaux, des gâteaux de Savoie...  le tout concocté à Yenne, Place Charles Dullin"
    ],
    "es": [
      "¡Abra la puerta a So'Brunch x L'Atelier des Alpes! Una tienda de delicatessen, un servicio de catering para sus eventos, un concepto de brunch para llevar, deliciosas galletas caseras, pasteles de Saboya... todo preparado en Yenne, Place Charles Dullin"
    ],
    "nl": [
      "Open de deur van So'Brunch x L'Atelier des Alpes! Een delicatessenzaak, een traiteurdienst voor uw evenementen, een meeneembrunchconcept, heerlijke zelfgemaakte koekjes, Savooiengebak... allemaal bedacht in Yenne, op de Place Charles Dullin"
    ]
  },
