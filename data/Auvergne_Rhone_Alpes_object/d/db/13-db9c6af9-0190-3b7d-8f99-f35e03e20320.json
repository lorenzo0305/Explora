  "rdfs:comment": {
    "de": [
      "Entdecken Sie das SPA La Parenthèse im Herzen von Aix-les-Bains. Eine einzigartige Erfahrung der Entspannung und Raffinesse in einem Ort, der Ihnen eine zeitlose Parenthese bieten soll."
    ],
    "en": [
      "Discover La Parenthèse Spa in the heart of Aix-les-Bains. A unique experience of relaxation and refinement in a place designed to offer you a timeless escape."
    ],
    "it": [
      "Scoprite la SPA La Parenthèse nel cuore di Aix-les-Bains. Un'esperienza unica all'insegna del relax e della raffinatezza in un luogo pensato per offrirvi una parentesi fuori dal tempo."
    ],
    "fr": [
      "Découvrez Le SPA La Parenthèse au cœur d’Aix-les-Bains. Une expérience unique de détente et de raffinement dans un lieu pensé pour vous offrir une Parenthèse hors du temps."
    ],
    "nl": [
      "Ontdek de SPA La Parenthèse in het hart van Aix-les-Bains. Een unieke ervaring van ontspanning en verfijning op een plek die is ontworpen om je een moment buiten de tijd te bieden."
    ],
    "es": [
      "Descubra el SPA La Parenthèse en el corazón de Aix-les-Bains. Una experiencia única de relajación y refinamiento en un lugar diseñado para ofrecerle un momento fuera del tiempo."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Parenthèse – Aquatic Leisure Area"
    ],
    "it": [
      "La Parenthèse – Aquatic Leisure Center"
    ],
    "fr": [
      "La Parenthèse - Espace Aqualudique"
    ]
  },
