  "rdfs:comment": {
    "de": [
      "Le Cinémateur ist eine Vereinigung von Filmliebhabern, die sich Filme ansehen, bevor sie in die Kinos kommen (Links von Verleihern, Festivals...) und ein originelles Programm, Art et Essai oder nicht, im Kino La Grenette in Bourg-en-Bresse ausstrahlen."
    ],
    "en": [
      "Le Cinémateur is an association of cinephiles who view films before their theatrical release (distributor links, festivals...) and present original programming, Art et Essai or not, at the La Grenette cinema in Bourg-en-Bresse."
    ],
    "it": [
      "Le Cinémateur è un'associazione di cinefili che guarda i film prima della loro uscita nelle sale (con collegamenti a distributori, festival, ecc.) e proietta programmi originali, d'essai o meno, al cinema La Grenette di Bourg-en-Bresse."
    ],
    "fr": [
      "Le Cinémateur est une association de cinéphiles qui visionnent les films, avant leur sortie en salle (liens des distributeurs, festivals...) et diffuse une programmation originale, Art et Essai ou non, au cinéma La Grenette à Bourg-en-Bresse."
    ],
    "nl": [
      "Le Cinémateur is een vereniging van bioscoopbezoekers die films bekijkt voordat ze worden uitgebracht in bioscopen (met links naar distributeurs, festivals, enz.) en originele programma's vertoont, arthouse of anderszins, in de La Grenette-bioscoop in Bourg-en-Bresse."
    ],
    "es": [
      "Le Cinémateur es una asociación de cinéfilos que ven películas antes de su estreno en las salas (con enlaces a distribuidores, festivales, etc.) y proyectan programas originales, de arte y ensayo o no, en el cine La Grenette de Bourg-en-Bresse."
    ]
  },
