  "rdfs:comment": {
    "de": [
      "Erforschen Sie das Herz eines echten Vulkans...\r\nIm Zentrum der tektonischen Hochburg \"Chaîne des Puys - Faille de Limagne\", die von der UNESCO zum Weltkulturerbe erklärt wurde, bieten wir Ihnen die einzigartige und ungewöhnliche Entdeckung des Inneren eines 100% natürlichen Vulkans."
    ],
    "en": [
      "Explore the heart of a real volcano...\r\nLocated at the center of the tectonic \"Chaîne des Puys - Faille de Limagne\" UNESCO World Heritage Site, we offer you the unique and unusual opportunity to discover the inside of a 100% natural volcano."
    ],
    "it": [
      "Esplorate il cuore di un vero vulcano...\r\nSituato al centro dell'altopiano tettonico \"Chaîne des Puys? Faille de Limagne\", patrimonio mondiale dell'UNESCO, vi proponiamo la scoperta unica e insolita dell'interno di un vulcano naturale al 100%."
    ],
    "fr": [
      "Explorez le cœur d'un vrai volcan...\r\nSitué au centre du haut lieu tectonique « Chaîne des Puys – Faille de Limagne » inscrit au Patrimoine Mondial de l’UNESCO, nous vous proposons la découverte unique et insolite de l'intérieur d’un Volcan 100% naturel."
    ],
    "nl": [
      "Verken het hart van een echte vulkaan...\r\nGelegen in het centrum van de tektonische hoogvlakte \"Chaîne des Puys - Faille de Limagne\" die op de werelderfgoedlijst van de UNESCO staat, bieden wij u de unieke en ongewone ontdekking van het binnenste van een 100% natuurlijke vulkaan."
    ],
    "es": [
      "Explore el corazón de un verdadero volcán...\r\nSituado en el centro del punto alto tectónico \"Chaîne des Puys ? En la \"Faille de Limagne\", declarada Patrimonio de la Humanidad por la UNESCO, le ofrecemos el descubrimiento único e insólito del interior de un volcán 100% natural."
    ]
  },
  "rdfs:label": {
