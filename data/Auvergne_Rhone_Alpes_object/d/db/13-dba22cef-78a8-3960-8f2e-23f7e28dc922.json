  "rdfs:comment": {
    "de": [
      "Als Tochter der Eisenbahn wurde die Gemeinde durch die Schaffung der Strecke Paris-Lyon-Mittelmeer, der sie ihre Entwicklung verdankt, buchstäblich auf das Taufbecken gehoben."
    ],
    "en": [
      "A daughter of the railways, the town was literally baptized by the creation of the Paris-Lyon-Méditerranée line, to which it owes its development."
    ],
    "it": [
      "Figlia delle ferrovie, la città è stata letteralmente battezzata dalla creazione della linea Parigi-Lione-Mediterraneo, alla quale deve il suo sviluppo."
    ],
    "fr": [
      "Fille du rail, la commune a été littéralement portée sur les fonts baptismaux par la création de la ligne Paris-Lyon-Méditerranée à qui elle doit son développement."
    ],
    "es": [
      "Hija del ferrocarril, la ciudad fue literalmente bautizada por la creación de la línea París-Lyon-Mediterráneo, a la que debe su desarrollo."
    ],
    "nl": [
      "Als dochter van de spoorwegen werd de stad letterlijk gedoopt door de aanleg van de lijn Parijs-Lyon-Méditerranée, waaraan ze haar ontwikkeling te danken heeft."
    ]
  },
