  "rdfs:comment": {
    "de": [
      "L'Intégral ist ein Theater im Departement Ain, das ein vielfältiges kulturelles Programm in den wichtigsten künstlerischen Disziplinen Theater, Musik, Tanz und Humor anbietet."
    ],
    "en": [
      "L'Intégral is a theatre located in the Ain region which offers, between September and June, a diversified cultural programme in the main artistic disciplines of theatre, music, dance and humour."
    ],
    "it": [
      "L'Intégral è un luogo di spettacolo del dipartimento di Ain, che offre una programmazione culturale diversificata nelle principali discipline artistiche del teatro, della musica, della danza e della commedia."
    ],
    "fr": [
      "L'Intégral est une salle de spectacle située dans l'Ain qui propose une programmation culturelle diversifiée dans les principales disciplines artistiques que sont le théâtre, la musique, la danse et l’humour."
    ],
    "nl": [
      "L'Intégral is een podium in het departement Ain en biedt een gevarieerde culturele programmering in de belangrijkste artistieke disciplines: theater, muziek, dans en comedy."
    ],
    "es": [
      "L'Intégral es un centro de espectáculos del departamento de Ain que ofrece una variada programación cultural en las principales disciplinas artísticas: teatro, música, danza y comedia."
    ]
  },
