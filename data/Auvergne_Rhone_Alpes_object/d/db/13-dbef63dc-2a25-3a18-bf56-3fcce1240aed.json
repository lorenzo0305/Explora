  "rdfs:comment": {
    "de": [
      "Eine echte Outdoor-Kartbahn mit einer Länge von 1014 m, die von der FFSA CAT 1 zugelassen ist, um Sie in aller Geselligkeit und Sicherheit zu empfangen. Unser professionelles Team stellt Ihnen seine 20-jährige Erfahrung zur Verfügung."
    ],
    "en": [
      "A real outdoor karting track, 1014 m long, FFSA CAT 1 approved, to welcome you in complete safety and conviviality. Our team of professionals has 20 years' experience at your disposal."
    ],
    "it": [
      "Un vero e proprio kartodromo all'aperto di 1014 m approvato dalla FFSA CAT 1, per accogliervi in tutta convivialità e sicurezza. Il nostro team di professionisti vanta 20 anni di esperienza."
    ],
    "fr": [
      "Une vraie piste extérieure de karting de 1014 m homologuée FFSA CAT 1, pour vous accueillir en toute convivialité et sécurité. Notre équipe de professionnels met à votre disposition ses 20 ans d’expérience."
    ],
    "es": [
      "Una verdadera pista de karting al aire libre de 1014 m homologada por la FFSA CAT 1, para acogerle en toda convivencia y seguridad. Nuestro equipo de profesionales cuenta con 20 años de experiencia."
    ],
    "nl": [
      "Een echte outdoor kartbaan van 1014 m goedgekeurd door de FFSA CAT 1, om u vriendelijk en veilig te ontvangen. Ons team van professionals stelt zijn 20 jaar ervaring tot uw beschikking."
    ]
  },
