  "rdfs:comment": {
    "de": [
      "Die Auberge du Jacquelin ist ein traditionelles Restaurant mit Menüs zu 17? mittags und Freitagabend sowie samstags bei Gruppenreservierungen und 28? sonntags mittags."
    ],
    "en": [
      "L'Auberge du Jacquelin is a traditional restaurant with menus at 17? for lunch and Friday evenings and Saturdays for group bookings, and 28? for Sunday lunch."
    ],
    "it": [
      "L'Auberge du Jacquelin è un ristorante tradizionale con menù a 17? per il pranzo e il venerdì sera e il sabato per le prenotazioni di gruppo, e a 28? per il pranzo della domenica."
    ],
    "fr": [
      "L'Auberge du Jacquelin est un restaurant traditionnel avec des menus à 17€ le midi et vendredi soir et samedi sur réservation de groupe et 28€ le dimanche midi."
    ],
    "es": [
      "El Auberge du Jacquelin es un restaurante tradicional con menús a 17? para el almuerzo y los viernes por la noche y los sábados para reservas de grupos, y a 28? para el almuerzo del domingo."
    ],
    "nl": [
      "De Auberge du Jacquelin is een traditioneel restaurant met menu's op 17? voor de lunch en vrijdagavond en zaterdag voor groepsreserveringen, en 28? voor de lunch op zondag."
    ]
  },
