  "rdfs:comment": {
    "de": [
      "Eine Mischung aus Holz und Stein, begleitet von einem Kamin. Erleben Sie einen Moment des Teilens von savoyardischen oder traditionellen Geschmäckern mit der Familie oder mit Freunden!"
    ],
    "en": [
      "A mix of wood and stone, accompanied by a fireplace, come and share a moment of Savoyard or traditional flavours with family or friends!"
    ],
    "it": [
      "Un mix di legno e pietra, accompagnato da un camino, venite a godervi un momento di condivisione di sapori savoiardi o tradizionali con la vostra famiglia o i vostri amici!"
    ],
    "fr": [
      "Un mélange de bois, de pierre, accompagnée d'une cheminée, venez vivre un moment de partage de saveurs savoyardes ou traditionnelles en famille ou entre amis !"
    ],
    "es": [
      "Mezcla de madera y piedra, acompañada de una chimenea, ¡venga a disfrutar de un momento para compartir sabores saboyanos o tradicionales con su familia o amigos!"
    ],
    "nl": [
      "Een mix van hout en steen, vergezeld van een open haard, kom en deel een moment van Savoyaardse of traditionele smaken met je familie of vrienden!"
    ]
  },
  "rdfs:label": {
