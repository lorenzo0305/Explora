  "rdfs:comment": {
    "de": [
      "Im Herzen des historischen Zentrums, im Alten Bischofshaus, befindet sich die Touristeninformation von Saint-Jean-de-Maurienne. Hier finden Sie gute Ratschläge vom Empfangsdienst und touristische Unterlagen für Ihren Aufenthalt!"
    ],
    "en": [
      "The Tourist Office is located in the center of St-Jean-de-Maurienne. A place where you will always find good advice about the city and the area."
    ],
    "it": [
      "L'Ufficio del Turismo di Saint-Jean-de-Maurienne si trova nel cuore del centro storico, nell'Ancien Évêché. Troverete buoni consigli dal servizio di accoglienza e documentazione turistica per il vostro soggiorno!"
    ],
    "fr": [
      "Au cœur du centre historique, au sein de l'Ancien Évêché, se tient l'office de tourisme de Saint-Jean-de-Maurienne. Vous trouverez de bons conseils de la part du service accueil et de la documentation touristique pour votre séjour !"
    ],
    "es": [
      "La Oficina de Turismo de Saint-Jean-de-Maurienne está situada en pleno centro histórico, en el Ancien Évêché. Encontrará buenos consejos en el servicio de recepción y documentación turística para su estancia"
    ],
    "nl": [
      "Het VVV-kantoor van Saint-Jean-de-Maurienne ligt in het hart van het historische centrum, in het Ancien Évêché. Je vindt er goed advies van de receptiedienst en toeristische documentatie voor je verblijf!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Tourist Office - Saint-Jean-de-Maurienne Office"
    ],
    "fr": [
      "Office de tourisme - Bureau Saint-Jean-de-Maurienne"
    ]
  },
