  "rdfs:comment": {
    "de": [
      "Höhlenforschung, Klettern, Canyoning, Via Corda, Nordische Skitouren usw.\r\nVom Vercors bis nach Lappland - lassen Sie sich führen und erleben Sie zu jeder Jahreszeit ein abwechslungsreiches Vergnügen!"
    ],
    "en": [
      "Caving, climbing, canyoning, Via Corda, Nordic ski mountaineering etc.\r\nFrom the Vercors to Lapland, let us be your guide and enjoy a variety of pleasures all year round!"
    ],
    "it": [
      "Speleologia, arrampicata, canyoning, via corda, sci nordico...\r\nDal Vercors alla Lapponia, lasciatevi guidare e godetevi una vasta gamma di attività tutto l'anno!"
    ],
    "fr": [
      "Spéléologie, escalade, descente de canyon, via corda, ski de randonnée nordique...\r\nDu Vercors à la Laponie, laissez-vous guider et variez les plaisirs en toute saison!"
    ],
    "nl": [
      "Speleologie, klimmen, canyoning, via corda, toerskiën...\r\nVan de Vercors tot Lapland, laat ons je gids zijn en geniet het hele jaar door van een breed scala aan activiteiten!"
    ],
    "es": [
      "Espeleología, escalada, barranquismo, vía corda, esquí nórdico de travesía...\r\nDel Vercors a Laponia, déjese guiar por nosotros y disfrute de un amplio abanico de actividades durante todo el año"
    ]
  },
