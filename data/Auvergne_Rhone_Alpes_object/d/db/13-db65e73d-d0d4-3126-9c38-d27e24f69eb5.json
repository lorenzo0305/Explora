  "rdfs:comment": {
    "de": [
      "Produktion und Verarbeitung von Duft-, Aroma- und Medizinalpflanzen PPAM aus biologischem Anbau.\r\n(Kräutertees, Gelees mit Pflanzen, Gewürze, Pflanzensirup)\r\nVerkauf von Setzlingen.\r\nBotanische Besuche des Gartens, Schulungen."
    ],
    "en": [
      "Production and processing of organically grown aromatic and medicinal plants (PPAM).\r\n(herbal teas, herbal jellies, condiments, plant syrups)\r\nPlant sales.\r\nBotanical tours of the garden, training courses."
    ],
    "it": [
      "Produzione e lavorazione biologica di piante aromatiche e medicinali.\r\n(tisane, gelatine vegetali, condimenti, sciroppi vegetali)\r\nVendita di piante.\r\nVisite botaniche al giardino, corsi di formazione."
    ],
    "fr": [
      "Production et transformation de Plantes à Parfum Aromatiques et Médicinales PPAM en agriculture biologique. \r\n(tisanes, gelées aux plantes, condiments, sirops de plante)\r\nVente de plants.\r\nVisites botaniques du jardin, formations."
    ],
    "es": [
      "Producción ecológica y transformación de plantas aromáticas y medicinales.\r\n(infusiones, jaleas de plantas, condimentos, jarabes de plantas)\r\nVenta de plantas.\r\nVisitas botánicas al jardín, cursos de formación."
    ],
    "nl": [
      "Biologische productie en verwerking van aromatische en geneeskrachtige planten.\r\n(kruidenthee, plantaardige gelei, specerijen, plantensiropen)\r\nVerkoop van planten.\r\nBotanische rondleidingen door de tuin, cursussen."
    ]
  },
