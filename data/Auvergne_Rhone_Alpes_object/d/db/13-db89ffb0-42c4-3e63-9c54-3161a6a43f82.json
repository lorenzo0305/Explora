  "rdfs:comment": {
    "de": [
      "Chamrousse profitiert von einer außergewöhnlichen Umwelt und heute erwartet Sie das Maison de l'Environnement, um Ihnen mit seinen Ausstellungen alle Facetten dieser Umwelt zu präsentieren!"
    ],
    "en": [
      "Chamrousse enjoys an exceptional environment and today the Environment Centre is waiting for you to present you all facets of it through its exhibitions!"
    ],
    "it": [
      "Chamrousse beneficia di un ambiente eccezionale e oggi la Casa dell'Ambiente vi aspetta per mostrarvi tutte le sue sfaccettature attraverso le sue mostre!"
    ],
    "fr": [
      "Chamrousse bénéficie d’un environnement d’exception et aujourd’hui la Maison de l’Environnement vous attend pour vous en présenter toutes les facettes à travers ses expositions !"
    ],
    "es": [
      "Chamrousse se beneficia de un entorno excepcional y hoy la Casa del Medio Ambiente le espera para mostrarle todas sus facetas a través de sus exposiciones"
    ],
    "nl": [
      "Chamrousse profiteert van een uitzonderlijke omgeving en vandaag staat het Maison de l'Environnement klaar om u al haar facetten te laten zien via haar tentoonstellingen!"
    ]
  },
