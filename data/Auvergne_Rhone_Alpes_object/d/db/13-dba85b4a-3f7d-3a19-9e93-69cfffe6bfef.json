  "rdfs:comment": {
    "de": [
      "Regionale Küche von hoher Qualität. Wir bieten Ihnen Menüs und eine Speisekarte, deren einfache, aber raffinierte Gerichte Sie begeistern werden. Sie werden den Speisesaal oder die Veranda und den Panoramablick auf die Monts du Lyonnais genießen."
    ],
    "en": [
      "Quality regional cuisine. We offer set and à la carte menus with simple but refined dishes sure to delight you. You will enjoy the dining room or veranda and a panoramic view over the Monts du Lyonnais."
    ],
    "it": [
      "Cucina regionale di qualità. Offriamo menù e una carta con piatti semplici ma raffinati che vi delizieranno. Potrete godere della sala ristorante o della veranda e di una vista panoramica sui Monts du Lyonnais."
    ],
    "fr": [
      "Cuisine régionale de qualité. Nous vous proposons des menus et une carte dont les plats simples mais raffinés sauront vous ravir. Vous profiterez de la salle de restaurant ou véranda et d'une vue panoramique sur les Monts du Lyonnais."
    ],
    "nl": [
      "Regionale kwaliteitskeuken. Wij bieden menu's en een kaart met eenvoudige maar verfijnde gerechten die u in vervoering zullen brengen. U zult genieten van de restaurantzaal of de veranda en een panoramisch uitzicht op de Monts du Lyonnais."
    ],
    "es": [
      "Cocina regional de calidad. Ofrecemos menús y una carta con platos sencillos pero refinados que le encantarán. Disfrutará de la sala del restaurante o de la veranda y de una vista panorámica de los Montes del Lyonnais."
    ]
  },
