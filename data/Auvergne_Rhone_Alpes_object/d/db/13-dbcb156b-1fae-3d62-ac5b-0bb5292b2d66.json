  "rdfs:comment": {
    "de": [
      "Im Herzen der Pisten, direkt am Sessellift der 3 Seen gelegen, ist das Saint S'o das richtige Restaurant für Sie. Es bietet eine abwechslungsreiche Speisekarte, schnellen Service von 10:30 bis 16:30 Uhr, eine Südterrasse und ein Solarium, ein Kaminzimmer, Crêpes und Waffeln zu jeder Tageszeit."
    ],
    "en": [
      "In the heart of the slopes, located at the start of the 3 Lacs chairlift, the Saint S'o is the restaurant you need with its varied menu, its fast service from 10.30am to 4.30pm, its terrace and south-facing solarium, a room with a fireplace, and pancakes and waffles at any time."
    ],
    "it": [
      "Nel cuore delle piste, alla partenza della seggiovia 3 Lacs, il Saint S'o è il ristorante che fa per voi, con il suo menu variegato, il servizio rapido dalle 10.30 alle 16.30, la terrazza e il solarium esposti a sud, la sala da pranzo con camino, le crêpes e i waffles tutto il giorno."
    ],
    "fr": [
      "Au cœur des pistes, situé au départ du télésiège des 3 Lacs, le Saint S'o est le resto qu'il vous faut avec sa carte variée, son service rapide de 10h30 à 16h30, sa terrasse et son solarium plein sud, salle avec cheminée, crêpes et gaufres à toute heure."
    ],
    "nl": [
      "Tussen de pistes ligt restaurant Saint S'o bij het vertrek van stoeltjeslift Trois Lacs. Dé plek die je zoekt, met zijn gevarieerde menukaart, zijn snelle service van 10.30 tot 16.30 uur, zijn terras en zijn zonneterras op het zuiden, een restaurantzaal met open haard en de hele dag door pannenkoeken en wafels."
    ],
    "es": [
      "En el corazón de las pistas, al inicio del telesilla 3 Lacs, Saint S'o es su restaurante: carta variada, servicio rápido de 10.30 a 16.30 h, terraza y solárium orientados al sur, comedor con chimenea, crêpes y gofres durante todo el día."
    ]
  },
  "rdfs:label": {
