  "rdfs:comment": {
    "de": [
      "Willkommen im L'APEROSET, einem neuen Raum in Chamroussia, der dem Aperitif gewidmet ist. Aber Vorsicht, der verantwortungsvolle Aperitif, der handwerklich hergestellte Aperitif."
    ],
    "en": [
      "Welcome to L'APEROSET, a new space in Chamrousse dedicated to aperitifs. But beware, the responsible aperitif, the artisanal aperitif."
    ],
    "it": [
      "Benvenuti a L'APEROSET, un nuovo spazio camorristico dedicato all'aperitivo. Ma attenzione, l'aperitivo responsabile, l'aperitivo artigianale."
    ],
    "fr": [
      "Bienvenue à L’APEROSET, un nouvel espace Chamroussien dédié à l’apéritif. Mais attention, l’apéritif responsable, l’apéritif artisanal."
    ],
    "nl": [
      "Welkom bij L'APEROSET, een nieuwe Chamroussische ruimte gewijd aan aperitieven. Maar pas op, het verantwoorde aperitief, het ambachtelijke aperitief."
    ],
    "es": [
      "Bienvenido a L'APEROSET, un nuevo espacio de Chamroussian dedicado a los aperitivos. Pero cuidado, el aperitivo responsable, el aperitivo artesanal."
    ]
