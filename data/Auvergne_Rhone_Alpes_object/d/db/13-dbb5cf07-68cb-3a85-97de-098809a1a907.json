  "rdfs:comment": {
    "de": [
      "Der um 20–10 v. Chr. erbaute Tempel des Forums in Vienne war dem Kult von Rom und Augustus gewidmet. In diesem Sinne ähnelt er dem Maison Carrée in Nîmes. Da er in eine Kirche umgebaut wurde, konnte er erhalten bleiben."
    ],
    "en": [
      "The Vienne forum temple was built in about 20-10 BC and was dedicated to the cult of Rome and Augustus. It can be compared to the Maison Carrée in Nîmes. The temple owes its survival to a later transformation into a church."
    ],
    "it": [
      "Costruito intorno al 20-10 a.C., il Tempio del Foro di Vienna era dedicato al culto di Roma e di Augusto. Costruito in più fasi, misura 24 metri per 14,25 metri. Fu trasformato in chiesa a partire dal V secolo, consentendo la sua sopravvivenza fino ai giorni nostri."
    ],
    "fr": [
      "Édifié vers 20-10 avant J-C, le Temple du forum de Vienne fut dédié au culte de Rome et d'Auguste. Construit en plusieurs phases, ses dimensions font 24m sur 14.25m. Il est reconverti en église à partir du Ve siècle, ce qui permet sa survie jusqu'à nous."
    ],
    "nl": [
      "De Forum Tempel in Wenen werd rond 20-10 voor Christus gebouwd en was gewijd aan de cultus van Rome en Augustus. Hij werd in verschillende fasen gebouwd en meet 24 bij 14,25 meter. Vanaf de 5e eeuw werd hij omgebouwd tot kerk, waardoor hij tot op de dag van vandaag bewaard is gebleven."
    ],
    "es": [
      "Construido hacia el 20-10 a.C., el Templo del Foro de Viena estaba dedicado al culto de Roma y Augusto. Construido en varias fases, mide 24 m por 14,25 m. A partir del siglo V se convirtió en iglesia, lo que le ha permitido sobrevivir hasta nuestros días."
    ]
  },
  "rdfs:label": {
