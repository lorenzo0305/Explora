  "rdfs:comment": {
    "de": [
      "Entdecken Sie die hausgemachte Küche mit frischen und lokalen Produkten. Genießen Sie die Terrasse mit ihrem Blick auf die triumphierende Natur in einem privilegierten Rahmen? Ein Ort? Eine Geschichte!"
    ],
    "en": [
      "Discover an homemade cuisine, with fresh and local products. Enjoy the terrace with its view in the heart of a triumphant nature for a privileged setting ... A place ... A story!"
    ],
    "it": [
      "Scoprite la cucina casalinga, con prodotti freschi e locali. Approfittate della terrazza con vista sulla natura trionfale? Un luogo? Una storia!"
    ],
    "fr": [
      "Découvrez une cuisine maison, avec des produits frais et locaux. Profitez de la terrasse avec sa vue au cœur d'une nature triomphante pour un cadre privilégié… Un lieu… Une histoire !"
    ],
    "nl": [
      "Ontdek de thuiskeuken met verse, lokale producten. Geniet van het terras, met uitzicht op de triomfantelijke natuur? Een plek? Een verhaal!"
    ],
    "es": [
      "Descubra la cocina casera, elaborada con productos frescos y locales. Disfrute de la terraza, con vistas a la naturaleza triunfante.. ¿Un lugar? Una historia"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Auberge des Seiglières"
    ]
  },
