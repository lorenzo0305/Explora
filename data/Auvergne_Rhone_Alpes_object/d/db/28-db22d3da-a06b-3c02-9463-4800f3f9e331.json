  "rdfs:comment": {
    "de": [
      "Bar / Brasserie mit 80 Plätzen, 50 Meter vom Strand entfernt, mit zwei Terrassen mit je 50 Plätzen.\nDie einzige Brasserie in Quend Plage, die 16 verschiedene Zubereitungsarten von Moules de Bouchots anbietet.\nVielfältige Speisekarte (Fleisch, Fisch, Salate, ...).\nNeu: Pizzas, Hamburger vor Ort oder zum Mitnehmen"
    ],
    "en": [
      "Bar / Brasserie with 80 places at 50 meters from the beach with 2 terraces of 50 places each.\nThe only brewery at Quend Plage has 16 different ways of cooking bouchot mussels.\nVarious menu (meat, fish, salads, ...).\nNew : pizzas, hamburgers on the spot or to take away"
    ],
    "it": [
      "Bar / Brasserie con 80 posti a sedere a 50 metri dalla spiaggia con 2 terrazze da 50 posti ciascuna.\nL'unica brasserie di Quend Plage che offre 16 modi diversi di cucinare le cozze.\nMenù vario (carne, pesce, insalate, ...).\nNovità : pizze, hamburger sul posto o da portare via"
    ],
    "fr": [
      "Bar / Brasserie de 80 places a 50 metres de la plage avec 2 terrasses de 50 places chacune.\nLa seule brasserie de Quend Plage a proposer 16 facons differentes de cuisiner les moules de bouchots.\nCarte diverse (viandes, poissons, salades, ...).\nNouveau : pizzas, hamburgers sur place ou a emporter"
    ],
    "nl": [
      "Bar / Brasserie met 80 zitplaatsen op 50 meter van het strand met 2 terrassen van elk 50 zitplaatsen.\nDe enige brasserie in Quend Plage die 16 verschillende manieren aanbiedt om mosselen te bereiden.\nDivers menu (vlees, vis, salades, ...).\nNieuw : pizza's, hamburgers ter plaatse of om mee te nemen"
    ],
    "es": [
      "Bar / Brasserie con 80 asientos a 50 metros de la playa con 2 terrazas de 50 asientos cada una.\nLa única brasserie de Quend Plage que ofrece 16 formas diferentes de cocinar los mejillones.\nMenú variado (carne, pescado, ensaladas, ...).\nNuevo : pizzas, hamburguesas en el lugar o para llevar"
    ]
  },
