  "rdfs:comment": {
    "de": [
      "Greg, ein Bergführer, schlägt Ihnen vor, seine Leidenschaft zu teilen, indem Sie die Aktivitäten, die uns die Berge bieten, (wieder) entdecken..."
    ],
    "en": [
      "Greg, a mountain guide, invites you to share his passion by (re) discovering the activities offered by the mountains."
    ],
    "it": [
      "Greg, guida alpina, vi invita a condividere la sua passione e a (ri)scoprire le attività che la montagna ha da offrire..."
    ],
    "fr": [
      "Greg, guide de haute montagne, vous propose de venir partager sa passion en (re)découvrant les activités que nous offre la montagne..."
    ],
    "es": [
      "Greg, guía de alta montaña, te invita a venir y compartir su pasión por (re)descubrir las actividades que nos ofrece la montaña..."
    ],
    "nl": [
      "Greg, een berggids, nodigt je uit om zijn passie te komen delen door de activiteiten die de berg ons biedt te (her)ontdekken..."
    ]
  },
