  "rdfs:comment": {
    "de": [
      "Die Grande Traversée du Volcan mit dem Fahrrad ist das Versprechen einer schönen Reise durch die Berge des Cantal. Vom Lot-Tal bis zum Allier-Tal durchqueren Sie den ältesten Vulkan Europas."
    ],
    "en": [
      "The Grande Traversée du Volcan by bike - GT2V (Cycling across Cantal) is the promise of a beautiful journey through the heart of the Mounts of Cantal."
    ],
    "it": [
      "La Grande Traversée du Volcan in bicicletta è la promessa di un bellissimo viaggio nel cuore delle montagne del Cantal. Dalla Valle del Lot alla Val d'Allier, attraverserete il vulcano più antico d'Europa."
    ],
    "fr": [
      "La Grande Traversée du Volcan à vélo c'est la promesse d'un beau voyage au cœur des monts du Cantal. De la Vallée du Lot au Val d'Allier, vous traversez le plus vieux volcan d'Europe."
    ],
    "es": [
      "La Grande Traversée du Volcan en bicicleta es la promesa de un hermoso viaje al corazón de las montañas del Cantal. Desde el valle del Lot hasta el Val d'Allier, atravesarás el volcán más antiguo de Europa."
    ],
    "nl": [
      "De Grande Traversée du Volcan à Vélo - GT2V (Fietsen door heel Cantal) is de belofte van een prachtige tocht door het hart van de Cantal. Van de Lot-vallei de Allier-vallei, doorkruist u de oudste vulkaan van Europa."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cycling across Cantal - GT2V"
    ],
    "fr": [
      "La Grande Traversée du Volcan à Vélo - GT2V"
    ],
    "nl": [
      "Fietsen door heel Cantal - GT2V"
    ]
  },
