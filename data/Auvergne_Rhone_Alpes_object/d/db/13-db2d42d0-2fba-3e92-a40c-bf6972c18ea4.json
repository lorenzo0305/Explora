  "rdfs:comment": {
    "de": [
      "Hausmannskost, Mittag- und Abendessen, eine gemütliche Atmosphäre drinnen und draußen in der Nähe unserer feurigen Tische."
    ],
    "en": [
      "Homemade cuisine, lunch and dinner. A warm atmosphere both indoors and outdoors, near our flaming tables."
    ],
    "it": [
      "Cucina casalinga, pranzo e cena. Un’atmosfera accogliente sia all’interno che all’esterno, vicino ai nostri tavoli infuocati."
    ],
    "fr": [
      "Cuisine maison, déjeuner et diner, une ambiance chaleureuse à l'intérieur comme à l'extérieur à proximité de nos tables enflammées."
    ],
    "nl": [
      "Thuis koken, lunch en diner, een warme sfeer zowel binnen als buiten, dicht bij onze vlammende tafels."
    ],
    "es": [
      "Cocina casera, comidas y cenas, un ambiente cálido tanto en el interior como en el exterior, cerca de nuestras flamantes mesas."
    ]
