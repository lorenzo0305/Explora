  "rdfs:comment": {
    "de": [
      "Die Galerie du Roure liegt inmitten eines kleinen Dorfes in der Ardèche und bietet Dauer- und Wechselausstellungen. Sie beherbergt Maler, Fotografen, Bildhauer und Dichter."
    ],
    "en": [
      "Nestled in the heart of a small Ardèche village, Galerie du Roure offers permanent and temporary exhibitions. It welcomes painters, photographers, sculptors and poets."
    ],
    "it": [
      "Situata nel cuore di un piccolo villaggio dell'Ardèche, la Galerie du Roure offre mostre permanenti e temporanee. Accoglie pittori, fotografi, scultori e poeti."
    ],
    "fr": [
      "Nichée dans l'écrin d'un petit village ardéchois, la galerie du Roure propose des expositions permanentes et temporaires. Elle accueille peintres, photographes, sculpteurs et poètes."
    ],
    "es": [
      "Enclavada en el corazón de un pequeño pueblo de Ardèche, la Galerie du Roure ofrece exposiciones permanentes y temporales. Acoge a pintores, fotógrafos, escultores y poetas."
    ],
    "nl": [
      "De Galerie du Roure, genesteld in het hart van een klein dorpje in de Ardèche, biedt permanente en tijdelijke tentoonstellingen. Schilders, fotografen, beeldhouwers en dichters zijn welkom."
    ]
  },
