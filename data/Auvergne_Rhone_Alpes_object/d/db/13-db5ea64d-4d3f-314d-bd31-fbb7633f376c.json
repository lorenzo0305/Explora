  "rdfs:comment": {
    "de": [
      "Treffen Sie die 10 besten Skifahrer der Welt bei der Zeremonie der Startnummernauslosung für den Super-G und feiern Sie die Preisverleihung für das Abfahrtspodium in der Eishalle des Forums."
    ],
    "en": [
      "Come and celebrate the top 10 skiers in the world at the Super-G bib draw ceremony, and enjoy the Downhill podium awards ceremony at the Forum ice rink."
    ],
    "it": [
      "Unitevi ai 10 migliori sciatori del mondo per la cerimonia di estrazione dei pettorali del Super-G e festeggiate la premiazione del podio della Discesa libera sulla pista di ghiaccio del Forum."
    ],
    "fr": [
      "Retrouvez les 10 meilleurs skieurs mondiaux pour la cérémonie du tirage au sort des dossards du Super-G et célébrez la remise des prix du podium de la Descente à la patinoire du Forum."
    ],
    "es": [
      "Únase a los 10 mejores esquiadores del mundo en la ceremonia de sorteo de dorsales del Super-G y celebre la entrega de premios del podio de Descenso en la pista de hielo del Forum."
    ],
    "nl": [
      "Doe mee met de 10 beste skiërs ter wereld tijdens de ceremonie van de loting van de Super-G en vier de prijsuitreiking van het Downhill-podium op de ijsbaan van het Forum."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cérémonie du tirage au sort des dossards et podium de la Coupe du Monde de ski"
    ]
  },
