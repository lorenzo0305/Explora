  "rdfs:comment": {
    "de": [
      "Der Familienbauernhof am Fuße des Vercors bietet seine landwirtschaftlichen Produkte zum Direktverkauf an:\r\nRind-, Kalb- und Schweinefleisch\r\nZiegenkäse, Fässer, Joghurt .\r\nWalnüsse, Walnussöl, Nussprodukte."
    ],
    "en": [
      "Family farm located at the foot of the Vercors mountains, offering farm products for direct sale:\r\nBeef, veal and pork\r\nGoat's cheese, faisselles, yogurts.\r\nWalnuts, walnut oil, walnut-based by-products."
    ],
    "it": [
      "Azienda agricola a conduzione familiare situata ai piedi del Vercors che offre i suoi prodotti agricoli per la vendita diretta:\r\nManzo, vitello e maiale\r\nFormaggio di capra, faisselles, yogurt.\r\nNoci, olio di noci, sottoprodotti a base di noci."
    ],
    "fr": [
      "Ferme Familiale située au pied du Vercors proposant ses produits fermiers à la vente en directe : \r\nViande de bœuf , veau et porc \r\nFromage de chèvre , faisselles , yaourts .\r\nNoix , huile de noix , produits dérivés à base noix ."
    ],
    "es": [
      "Granja familiar situada al pie del Vercors que ofrece sus productos agrícolas para la venta directa:\r\nCarne de vacuno, ternera y cerdo\r\nQuesos de cabra, faisselles, yogures.\r\nNueces, aceite de nueces, subproductos a base de nueces."
    ],
    "nl": [
      "Familieboerderij aan de voet van de Vercors met boerderijproducten voor directe verkoop:\r\nRund-, kalfs- en varkensvlees\r\nGeitenkaas, faisselles, yoghurt.\r\nWalnoten, walnootolie, bijproducten op basis van walnoten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme Rodet"
    ]
  },
