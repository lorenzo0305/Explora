  "rdfs:comment": {
    "de": [
      "Ob mit der Familie, zu zweit oder mit Freunden, genießen Sie die herrliche Umgebung gegenüber der Mont-Blanc-Kette und entdecken Sie diesen Minigolfplatz."
    ],
    "en": [
      "Whether you're a family, a couple or a group of friends, come and discover this minigolf  in a magnificent setting overlooking the Mont Blanc range."
    ],
    "it": [
      "Che siate una famiglia, una coppia o un gruppo di amici, venite a scoprire questo campo da minigolf in una magnifica cornice con vista sulla catena del Monte Bianco."
    ],
    "fr": [
      "En couple, en famille, ou entre amis, venez profiter d’un cadre magnifique face à la chaine du Mont-Blanc pour découvrir ce minigolf."
    ],
    "nl": [
      "Of je nu met z'n tweeën bent, met het gezin of met een groep vrienden, kom deze minigolfbaan ontdekken in een prachtige omgeving met uitzicht op de Mont Blanc."
    ],
    "es": [
      "En pareja, en familia o en grupo de amigos, venga a descubrir este minigolf en un magnífico entorno con vistas a la cordillera del Mont Blanc."
    ]
  },
