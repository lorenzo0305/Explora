  "rdfs:comment": {
    "de": [
      "Der Foron ist ein Bach, der auf dem Plateau von Plaine Joux entspringt und durch die Unterlieger von Fillinges fließt, bevor er in den Menoge mündet. Er verfügt über einen Angelparcours, um die aquatische Biodiversität, die in der Unterwasserwelt lebt, zu verstehen."
    ],
    "en": [
      "The Foron is a stream that flows through the lower reaches of the main town of Fillinges before emptying into the Menoge. It rises on the Plaine Joux plateau. It features a fishing trail to help visitors understand the aquatic biodiversity that inhabits the underwater world."
    ],
    "it": [
      "Il Foron è un torrente che nasce sull'altopiano della Plaine Joux e scorre nella parte bassa di Fillinges prima di sfociare nel Menoge. È dotato di un percorso di pesca che aiuta a comprendere la biodiversità acquatica che vive nel mondo sommerso."
    ],
    "fr": [
      "Le Foron est un ruisseau qui prend source sur le plateau de Plaine Joux et traverse les contrebas de Fillinges avant de se jeter dans la Menoge. Il est doté d'un parcours pêche pour comprendre la biodiversité aquatique qui habite dans le monde sous-marin."
    ],
    "es": [
      "El Foron es un arroyo que nace en la meseta de Plaine Joux y atraviesa la parte baja de Fillinges antes de desembocar en el Menoge. Cuenta con un sendero de pesca que le ayudará a comprender la biodiversidad acuática que vive en el mundo submarino."
    ],
    "nl": [
      "De Foron is een beek die ontspringt op het plateau van de Plaine Joux en door de benedenloop van Fillinges stroomt voordat hij uitmondt in de Menoge. Er is een vispad om de aquatische biodiversiteit die in de onderwaterwereld leeft beter te leren begrijpen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Educational fishing trail"
    ],
    "fr": [
      "Parcours de pêche didactique"
    ]
  },
