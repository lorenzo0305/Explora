  "rdfs:comment": {
    "de": [
      "Anlässlich des zweijährigen Jubiläums der Site Le Corbusier in Firminy präsentiert Döppel Studio SOLAIRE, eine sensible Odyssee, eine immersive Erfahrung, die die Interaktionen zwischen Licht, Architektur und Sinneswahrnehmung erforscht."
    ],
    "en": [
      "To mark the double anniversary of the Site Le Corbusier in Firminy, Döppel Studio presents SOLAIRE, a sensitive odyssey, an immersive experience exploring the interactions between light, architecture and sensory perception."
    ],
    "it": [
      "In occasione del doppio anniversario del Site Le Corbusier di Firminy, Döppel Studio presenta SOLAIRE, un'odissea sensibile, un'esperienza immersiva che esplora le interazioni tra luce, architettura e percezione sensoriale."
    ],
    "fr": [
      "À l’occasion du double anniversaire du Site Le Corbusier à Firminy, Döppel Studio présente SOLAIRE, une odyssée sensible, une expérience immersive qui explore les interactions entre lumière, architecture et perception sensorielle."
    ],
    "nl": [
      "Ter gelegenheid van de dubbele verjaardag van de Site Le Corbusier in Firminy presenteert Döppel Studio SOLAIRE, een gevoelige odyssee, een meeslepende ervaring waarin de wisselwerking tussen licht, architectuur en zintuiglijke waarneming wordt onderzocht."
    ],
    "es": [
      "Con motivo del doble aniversario del Site Le Corbusier de Firminy, Döppel Studio presenta SOLAIRE, una odisea sensible, una experiencia inmersiva que explora las interacciones entre luz, arquitectura y percepción sensorial."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition \"SOLAIRE, une odyssée sensible\""
    ]
  },
