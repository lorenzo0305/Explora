  "rdfs:comment": {
    "de": [
      "Großer Park von 24 Hektar, in dessen Mitte die Wassertürme des Architekten Philolaos stehen. Er verfügt über eine große Wasserfläche, ein Amphitheater und einen Orientierungslauf."
    ],
    "en": [
      "A large 24-hectare park with water towers designed by the architect Philolaos. It features a vast lake, an amphitheater and an orienteering course."
    ],
    "it": [
      "Un grande parco di 24 ettari al centro del quale si trovano le torri d'acqua dell'architetto Philolaos. Ha un grande lago, un anfiteatro e un percorso di orientamento."
    ],
    "fr": [
      "Grand parc de 24 hectares au milieu duquel se trouve les châteaux d’eau de l'architecte Philolaos. Il dispose d'un vaste plan d'eau, d'un amphithéâtre et d'un parcours d'orientation."
    ],
    "es": [
      "Un gran parque de 24 hectáreas, en cuyo centro se encuentran las torres de agua del arquitecto Philolaos. Cuenta con un gran lago, un anfiteatro y un campo de orientación."
    ],
    "nl": [
      "Een groot park van 24 hectare met in het midden de watertorens ontworpen door de architect Philolaos. Het heeft een groot meer, een amfitheater en een oriëntatieroute."
    ]
  },
