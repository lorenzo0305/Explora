  "rdfs:comment": {
    "de": [
      "Radtour entlang des Vulkanmassivs Coiron, von authentischen Dörfern zu atemberaubenden Panoramen.\r\nStart in St jean le centenier."
    ],
    "en": [
      "Bike loop along the Coiron volcanic massif, from authentic villages to breathtaking panoramas.\r\nDeparture from St Jean le Centenier."
    ],
    "it": [
      "Pedalate lungo il massiccio vulcanico del Coiron, passando per villaggi autentici e panorami mozzafiato.\r\nPartenza da St Jean le Centenier."
    ],
    "fr": [
      "Boucle à vélo le long du massif volcanique du Coiron, de villages authentiques en panoramas à couper le souffle.\r\nDépart de St jean le centenier."
    ],
    "es": [
      "Pedalee a lo largo del macizo volcánico de Coiron, pasando por pueblos auténticos y panoramas impresionantes.\r\nSalida desde St jean le centenier."
    ],
    "nl": [
      "Fiets langs het vulkanische Coiron-massief, langs authentieke dorpjes en adembenemende panorama's.\r\nVertrek vanuit St jean le centenier."
    ]
