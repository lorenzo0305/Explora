  "rdfs:comment": {
    "de": [
      "Die alte Kirche in Le Mollard war seit dem 18. Jahrhundert in schlechtem Zustand, sodass 1841 eine neue Kirche gebaut wurde."
    ],
    "en": [
      "The old church at Le Mollard had been in a poor state of repair since the 18th century when the current church was built in 1841."
    ],
    "it": [
      "La vecchia chiesa di Le Mollard era in cattive condizioni dal XVIII secolo e la nuova fu costruita nel 1841."
    ],
    "fr": [
      "L'ancienne église du Mollard était en mauvais état depuis le XVIIIe siècle, la nouvelle fût construite en 1841."
    ],
    "es": [
      "La antigua iglesia de Le Mollard estaba en mal estado desde el siglo XVIII, y la nueva se construyó en 1841."
    ],
    "nl": [
      "De oude kerk van Le Mollard verkeerde sinds de 18e eeuw in slechte staat, en de nieuwe werd in 1841 gebouwd."
    ]
  },
