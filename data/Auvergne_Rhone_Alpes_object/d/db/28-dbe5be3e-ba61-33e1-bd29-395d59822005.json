  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/008dafae-d482-3a3d-9456-7d0373245ee7",
      "dc:description": {
        "de": [
          "Willkommen bei La Boucherie, Mini-Preis & Maxi-Vergnügen!\n\nUnd die Restaurants der Kette wurden gerade zur Besten Ladenkette des Jahres 2026 in der Kategorie Gastronomie gewählt."
        ],
        "en": [
          "Welcome to La Boucherie, mini prices & maxi pleasure!\n\nAnd the chain's restaurants have just been voted Best Chain Store of the Year 2026 in the Restaurant category."
        ],
        "it": [
          "Benvenuti a La Boucherie, per prezzi bassi e massimo piacere!\n\nI ristoranti della catena sono stati appena eletti Miglior catena di negozi dell'anno 2026 nella categoria Ristoranti."
        ],
        "fr": [
          "Bienvenue à La Boucherie, prix mini & plaisir maxi !\n\nEt les restaurants de la chaîne viennent d'être élus Meilleure Chaîne de Magasins de l'année 2026 dans la catégorie Restauration."
        ],
        "nl": [
          "Welkom bij La Boucherie, voor lage prijzen en maximaal plezier!\n\nEn de restaurants van de keten zijn net verkozen tot Beste Winkelketen van het Jaar 2026 in de categorie Restaurant."
        ],
        "es": [
          "Bienvenido a La Boucherie, ¡para precios bajos y máximo placer!\n\nY los restaurantes de la cadena acaban de ser elegidos Mejor Cadena de Tiendas del Año 2026 en la categoría Restaurante."
        ]
      },
      "@type": [
        "Description"
      ],
