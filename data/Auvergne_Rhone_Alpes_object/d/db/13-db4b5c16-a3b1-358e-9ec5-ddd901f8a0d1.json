  "rdfs:comment": {
    "de": [
      "Chantal Montcher ist seit 1984 Caviste und arbeitet in ihrem Keller am Fuße des Schlosses in der Stadt Monistrol-sur-Loire, wo sie Sie nach Ihren Bedürfnissen und Ihrem Budget berät und Ihnen ihre Favoriten vorstellt."
    ],
    "en": [
      "Chantal Montcher has been a wine merchant since 1984, in her cellar at the foot of the castle in the town of Monistrol-sur-Loire, where she will advise you judiciously according to your needs and your budget, and will help you discover her favourites."
    ],
    "it": [
      "Chantal Montcher è commerciante di vini dal 1984, nella sua cantina ai piedi del castello nella città di Monistrol-sur-Loire, dove vi consiglierà con giudizio in base alle vostre esigenze e al vostro budget e vi mostrerà i suoi preferiti."
    ],
    "fr": [
      "Caviste depuis 1984, Chantal Montcher officie dans sa cave au pied du château de la ville de Monistrol-sur-Loire.Elle vous conseillera judicieusement selon vos besoins et votre budget, et vous fera découvrir ses coups de cœur."
    ],
    "nl": [
      "Chantal Montcher is sinds 1984 wijnhandelaar en werkt vanuit haar kelder aan de voet van het kasteel in het stadje Monistrol-sur-Loire, waar zij u gedegen advies geeft op basis van uw behoeften en budget, en u haar favorieten laat zien."
    ],
    "es": [
      "Chantal Montcher es comerciante de vinos desde 1984, y trabaja en su bodega al pie del castillo de la ciudad de Monistrol-sur-Loire, donde le aconsejará según sus necesidades y su presupuesto, y le mostrará sus favoritos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cave du château"
    ]
  },
