  "rdfs:comment": {
    "de": [
      "Die Show \"Les Comédies Musicales fêtent la Musique\" ist eine Sommertournee, die ein Live-Konzert bietet, das die größten Hits aus französischen und internationalen Musicals vereint."
    ],
    "en": [
      "Les Comédies Musicales fêtent la Musique\" is a summer tour featuring a live concert of the greatest hits from French and international musicals."
    ],
    "it": [
      "Les Comédies Musicales fêtent la Musique\" è un tour estivo che propone un concerto dal vivo dei più grandi successi dei musical francesi e internazionali."
    ],
    "fr": [
      "Le spectacle « Les Comédies Musicales fêtent la Musique » est une tournée estivale qui propose un concert live, réunissant les plus grands tubes des comédies musicales françaises et internationales."
    ],
    "nl": [
      "Les Comédies Musicales fêtent la Musique\" is een zomertournee met een live concert van de grootste hits uit Franse en internationale musicals."
    ],
    "es": [
      "Les Comédies Musicales fêtent la Musique\" es una gira de verano que ofrece un concierto en directo de los grandes éxitos de los musicales franceses e internacionales."
    ]
  },
