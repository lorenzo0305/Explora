  "rdfs:comment": {
    "de": [
      "Le Cerizet Taka, Ihr Restaurant mit Bar in Boisset- lès-Montrond,empfängt Sie in freundlicher Atmosphäre und lässt Sie traditionelle Küche und hausgemachte Gerichte entdecken."
    ],
    "en": [
      "Le Cerizet Taka, your restaurant and bar in Boisset-lès-Montrond, proposes a friendly and welcoming setting in which to enjoy traditional dishes prepared in-house."
    ],
    "it": [
      "Il Cerizet Taka, il vostro ristorante-bar a Boisset-lès-Montrond, vi accoglie in un'atmosfera calda e amichevole e vi offre una cucina tradizionale e piatti fatti in casa."
    ],
    "fr": [
      "Le Cerizet Taka, votre restaurant-bar à Boisset-lès-Montrond vous accueille dans une ambiance chaleureuse et conviviale, et vous fait découvrir une cuisine traditionnelle et des plats faits maison."
    ],
    "es": [
      "El Cerizet Taka, su restaurante-bar en Boisset-lès-Montrond, le acoge en un ambiente cálido y acogedor y le ofrece cocina tradicional y platos caseros."
    ],
    "nl": [
      "De Cerizet Taka, uw restaurant-bar in Boisset-lès-Montrond, ontvangt u in een warme en vriendelijke sfeer en biedt u traditionele gerechten en huisgemaakte gerechten."
    ]
  },
