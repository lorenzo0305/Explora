  "rdfs:comment": {
    "de": [
      "Eine Ausbildung bei der CECOF bedeutet, seinen zukünftigen Beruf mit anerkannten Fachleuten zu erlernen, indem man moderne Ausrüstungen und technische Plattformen nutzt."
    ],
    "en": [
      "Training with CECOF means learning your future trade with recognized professionals using modern equipment and technical facilities."
    ],
    "it": [
      "Formarsi con CECOF significa imparare la propria futura professione con professionisti riconosciuti, utilizzando attrezzature e strutture tecniche moderne."
    ],
    "fr": [
      "Se former avec le CECOF c’est apprendre son futur métier avec des professionnels reconnus en utilisant des équipements et des plateaux techniques modernes."
    ],
    "es": [
      "Formarse con el CECOF significa aprender su futura profesión con profesionales reconocidos, utilizando equipos e instalaciones técnicas modernas."
    ],
    "nl": [
      "Een opleiding bij CECOF betekent dat je je toekomstige beroep leert met erkende professionals die gebruik maken van moderne apparatuur en technische faciliteiten."
    ]
  },
