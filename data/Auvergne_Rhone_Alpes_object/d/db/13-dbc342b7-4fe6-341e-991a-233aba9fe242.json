  "rdfs:comment": {
    "de": [
      "Produktion und Ernte von aromatischen und medizinischen Pflanzen aus biologischem Anbau. Handverarbeitete Pflanzen und selbst hergestellte Produkte: Kräutertees, Aromaten, Sirups und eine Reihe von 100% natürlichen Kosmetika."
    ],
    "en": [
      "Production and harvesting of aromatic and medicinal plants in organic farming. Handcrafted plants and products made by us: herbal teas, herbs & spices, syrups and a range of 100% natural cosmetics."
    ],
    "it": [
      "Produzione e raccolta di piante aromatiche e medicinali in agricoltura biologica. Piante e prodotti artigianali realizzati da noi: tisane, aromi, sciroppi e una gamma di cosmetici 100% naturali."
    ],
    "fr": [
      "Production et cueillette de plantes aromatiques et médicinales en agriculture biologique. Des plantes travaillées à la main et des produits fabriqués par nos soins : tisanes, aromates, sirops et une gamme de cosmétiques 100% naturels."
    ],
    "nl": [
      "Productie en oogst van aromatische en geneeskrachtige planten in de biologische landbouw. Handgemaakte planten en producten: kruidenthee, aromaten, siropen en een assortiment 100% natuurlijke cosmetica."
    ],
    "es": [
      "Producción y recolección de plantas aromáticas y medicinales en la agricultura ecológica. Plantas y productos artesanales elaborados por nosotros: infusiones, aromáticas, jarabes y una gama de cosmética 100% natural."
    ]
  },
