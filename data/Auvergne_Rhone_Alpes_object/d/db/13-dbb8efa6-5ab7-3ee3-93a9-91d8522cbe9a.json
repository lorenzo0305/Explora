  "rdfs:comment": {
    "de": [
      "Das Dorf EYMEUX liegt am Rande des Vercors und am Fuße des Isère-Tals. Es nimmt das linke Flussufer oberhalb des Staudamms von Pizançon ein."
    ],
    "en": [
      "The village of EYMEUX lies on the edge of the Vercors and at the foot of the Isère valley. It lies on the left bank of the river, upstream from the Pizançon dam."
    ],
    "it": [
      "Il villaggio di EYMEUX si trova ai margini del Vercors e ai piedi della valle dell'Isère. Si trova sulla riva sinistra del fiume, a monte della diga del Pizançon."
    ],
    "fr": [
      "Le village d'EYMEUX est situé aux confins du Vercors et au pied de la vallée de l'Isère. Il occupe la rive gauche de la rivière, en amont du barrage de Pizançon."
    ],
    "nl": [
      "Het dorp EYMEUX ligt aan de rand van de Vercors en aan de voet van de Isère-vallei. Het ligt op de linkeroever van de rivier, stroomopwaarts van de stuwdam van Pizançon."
    ],
    "es": [
      "El pueblo de EYMEUX está situado al borde del Vercors y al pie del valle del Isère. Se encuentra en la orilla izquierda del río, aguas arriba de la presa de Pizançon."
    ]
  },
