  "rdfs:comment": {
    "de": [
      "Verteidigung der Rechte von Unfallopfern, Behinderten, Solidarität, Unterstützung, administrative und rechtliche Hilfe, Trost. Monatliche Permanenz und Begleitung zur Gruppierung. Animationen (Mahlzeiten), Hausbesuche."
    ],
    "en": [
      "Defending the rights of the disabled, solidarity, support, administrative and legal assistance, comfort. Monthly office hours and support for the group. Activities (meals), home visits."
    ],
    "it": [
      "Difesa dei diritti dei disabili, solidarietà, sostegno, assistenza amministrativa e legale, conforto. Incontri mensili e sostegno al gruppo. Attività (pasti), visite a domicilio."
    ],
    "fr": [
      "Défense des droits des accidentés de la vie, handicapés, solidarité, soutien, aide administrative et juridique, réconfort. Permanence mensuelle et accompagnement au groupement. Animations (repas), visites à domicile."
    ],
    "nl": [
      "Opkomen voor de rechten van mensen met een ongeval of handicap, solidariteit, ondersteuning, administratieve en juridische bijstand, troost. Maandelijkse aanwezigheid en ondersteuning van de groep. Activiteiten (maaltijden), huisbezoeken."
    ],
    "es": [
      "Defensa de los derechos de los discapacitados, solidaridad, apoyo, asistencia administrativa y jurídica, comodidad. Reuniones mensuales y apoyo al grupo. Actividades (comidas), visitas a domicilio."
    ]
  },
