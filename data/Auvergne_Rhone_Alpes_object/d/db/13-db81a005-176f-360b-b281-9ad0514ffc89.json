  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, einen Drink bei Sonnenuntergang zu genießen?\r\noder in den Bergen zu entspannen?"
    ],
    "en": [
      "Want to have a drink at sunset? Or to relax in a mountain atmosphere in the middle of the mountain pastures? The Banne refuge will be the place for small mountain snacks.\r\nOpen in summer."
    ],
    "it": [
      "Avete voglia di bere un drink al tramonto\r\no di rilassarsi in montagna?"
    ],
    "fr": [
      "Envie de savourer un verre au coucher du soleil \r\nou de vous détendre en montagne ?"
    ],
    "es": [
      "¿Te apetece tomar algo al atardecer\r\no relajarse en la montaña?"
    ],
