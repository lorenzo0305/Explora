  "rdfs:comment": {
    "de": [
      "Lassen Sie uns die Wanderwege, die Fauna und Flora, die uns umgeben, entdecken. Bergbegleiterin und Naturanimateurin, machen wir Ihre Ausflüge zu einem Erlebnis!"
    ],
    "en": [
      "Let's discover the hiking trails, flora and fauna that surround us. As a mountain leader and nature guide, we'll make your outings an experience!"
    ],
    "it": [
      "Scopriamo i sentieri, la flora e la fauna che ci circondano. Come guida alpina e naturalistica, faremo delle vostre uscite un'esperienza!"
    ],
    "fr": [
      "Partons à la découverte des sentiers de randonnée, de la faune et de la flore qui nous entourent. Accompagnatrice en montagne et animatrice nature, faisons de vos sorties une expérience !"
    ],
    "nl": [
      "Laten we de wandelpaden, flora en fauna om ons heen ontdekken. Als berggids en natuurleider maken we van je uitstapjes een belevenis!"
    ],
    "es": [
      "Descubramos las rutas de senderismo, la flora y la fauna que nos rodean. Como guía de montaña y guía de naturaleza, ¡haremos de tus salidas toda una experiencia!"
    ]
  },
  "rdfs:label": {
