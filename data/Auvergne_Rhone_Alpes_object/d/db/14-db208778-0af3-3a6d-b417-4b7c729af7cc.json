  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b81af312-c924-3e44-9c10-fe9793715a4e",
      "dc:description": {
        "de": [
          "Mittwoch, 25. Februar\n--------------------------------------\nAktivität \"Nachmittags Gesellschaftsspiele\", angeboten vom CCAS\nIn der Mehrzweckhalle von Merlimont am Bahnhofsplatz, von 14:30 bis 17:00 Uhr\nKostenlos und offen für alle\n\nSie können sich beim Service Animation im Office de Tourisme von Merlimont anmelden: 70 Avenue du Centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Wednesday, February 25\n--------------------------------------\nAfternoon Board Games\" activity organized by the CCAS\nAt the Merlimont multi-purpose hall in place de la gare, from 2.30pm to 5pm\nFree and open to all\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Mercoledì 25 febbraio\n--------------------------------------\nPomeriggio di giochi da tavolo\" organizzato dal CCAS\nPresso la sala polivalente Merlimont in place de la gare, dalle 14.30 alle 17.00\nGratuito e aperto a tutti\n\nÈ possibile iscriversi presso il Servizio Animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Mercredi 25 février\n--------------------------------------\nActivité \"Après-Midi Jeux de société\" proposée par le CCAS\nA la salle polyvalente de Merlimont à la place de la gare, de 14h30 à 17h\nGratuit et ouvert à tous\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Woensdag 25 februari\n--------------------------------------\nMiddagactiviteit gezelschapsspellen georganiseerd door het CCAS\nIn de polyvalente zaal van Merlimont, place de la gare, van 14u30 tot 17u00\nGratis en open voor iedereen\n\nU kunt zich inschrijven bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, van maandag tot vrijdag van 9 tot 12 uur\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Miércoles 25 de febrero\n--------------------------------------\nTarde de juegos de mesa\", actividad organizada por la CCAS\nEn la sala polivalente Merlimont de la place de la gare, de 14h30 a 17h00\nGratuita y abierta a todos\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9.00 a 12.00 h\nCONTACTO: 03 21 94 72 18\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ]
      },
