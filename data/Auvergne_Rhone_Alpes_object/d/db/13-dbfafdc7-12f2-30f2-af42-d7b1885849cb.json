  "rdfs:comment": {
    "de": [
      "Durchgehende Bewirtung von 9 bis 22 Uhr vor einem der schönsten Postkartenmotive des Sees in Doussard.\r\nBistro-Küche, die von qualifizierten Fachleuten zu 100% hausgemacht und aus frischen Produkten zubereitet wird. Fisch aus dem See und Meeresfisch."
    ],
    "en": [
      "Eat at any time from 9 am to 10 pm, facing one of Doussard's most picturesque views of the lake. 100 % homemade refined bistro cuisine made with fresh fish and produce, by qualified professionals. Choose from both lake and sea fish."
    ],
    "it": [
      "Ristorazione continua dalle 9 alle 22 di fronte a una delle più belle cartoline del lago di Doussard.\r\nCucina bistrot preparata da professionisti qualificati, 100% casalinga e a base di prodotti freschi. Pesce di lago e di mare."
    ],
    "fr": [
      "Restauration continue de 9h à 22h devant l'une des plus jolies cartes postales du lac à Doussard.\r\nCuisine de Bistrot élaborée par des professionnels qualifiés, 100% maison et à base des produits frais. Poissons du lac et poissons de mer."
    ],
    "nl": [
      "Doorlopend dineren van 9 tot 22 uur voor een van de mooiste ansichtkaarten aan het meer in Doussard.\r\nBistrokeuken bereid door gekwalificeerde professionals, 100% huisgemaakt en op basis van verse producten. Vis uit het meer en de zee."
    ],
    "es": [
      "Cena continua de 9 a 22 h frente a una de las postales más bonitas del lago de Doussard.\r\nCocina bistró elaborada por profesionales cualificados, 100% casera y a base de productos frescos. Pescados de lago y de mar."
    ]
  },
