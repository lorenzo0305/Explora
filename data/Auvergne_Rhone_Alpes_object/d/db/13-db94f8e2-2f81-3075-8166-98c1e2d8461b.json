  "rdfs:comment": {
    "de": [
      "Auf einem Boden aus Seidenpapier entführen zwei Schauspieler die Kleinsten auf eine Reise der Sinne. Klänge, Formen und Landschaften aus Papier erwachen zum Leben, ganz nah am Publikum, und laden Kinder und Erwachsene zum Fühlen, Träumen und Spielen ein."
    ],
    "en": [
      "On a floor of tissue paper, two actors take toddlers on a sensory journey. Sounds, shapes and paper landscapes come to life, close to the audience, inviting children and adults to feel, dream and play."
    ],
    "it": [
      "Su un pavimento di carta di seta, due attori accompagnano i bambini in un viaggio sensoriale. Suoni, forme e paesaggi di carta prendono vita, vicino al pubblico, invitando bambini e adulti a sentire, sognare e giocare."
    ],
    "fr": [
      "Sur un sol de papiers de soie, deux comédiens entraînent les tout-petits dans un voyage sensoriel. Sons, formes et paysages de papier prennent vie, proches du public, invitant enfants et adultes à ressentir, rêver et jouer."
    ],
    "es": [
      "Sobre un suelo de papel de seda, dos actores llevan a los niños en un viaje sensorial. Sonidos, formas y paisajes de papel cobran vida, cerca del público, invitando a niños y adultos a sentir, soñar y jugar."
    ],
    "nl": [
      "Op een vloer van zijdepapier nemen twee acteurs peuters mee op een zintuiglijke reis. Geluiden, vormen en papieren landschappen komen tot leven, dicht bij het publiek, en nodigen kinderen en volwassenen uit om te voelen, te dromen en te spelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Sous la neige"
    ]
  },
