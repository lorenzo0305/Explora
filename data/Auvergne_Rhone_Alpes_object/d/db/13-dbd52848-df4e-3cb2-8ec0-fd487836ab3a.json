  "rdfs:comment": {
    "de": [
      "Das Hotel der Familie TRINCAZ pflegt seit 1957 die Kunst der Gastfreundschaft. Ihre Gastgeber, Jacky, Françoise und Matthieu, bereiten Ihnen den besten Empfang, damit Ihr Urlaub in Châtel sich auf Sanftheit und Gelassenheit reimt."
    ],
    "en": [
      "The Trincaz family's hotel has made hospitality an art form since 1957. Your hosts, Jacky, Françoise and Matthieu, will give you a warm welcome for a relaxing and peaceful holiday in Châtel."
    ],
    "it": [
      "L'hotel della famiglia TRINCAZ coltiva l'arte dell'ospitalità dal 1957. I padroni di casa, Jacky, Françoise e Matthieu, vi daranno il più caloroso benvenuto affinché le vostre vacanze a Châtel facciano rima con dolcezza e serenità."
    ],
    "fr": [
      "L'hôtel de la famille TRINCAZ cultive l'art de recevoir depuis 1957. Vos hôtes, Jacky, Françoise et Matthieu, vous réservent le meilleur accueil pour que vos vacances à Châtel riment avec douceur et sérénité."
    ],
    "nl": [
      "Het familiehotel TRINCAZ houdt zich al sinds 1957 bezig met gastvrijheid. Uw gastvrouw en gastheren, Françoise, Jacky en Matthieu, heten u van harte welkom en zorgen ervoor dat uw vakantie in Châtel er één wordt van rust en kalmte."
    ],
    "es": [
      "El hotel familiar TRINCAZ lleva cultivando el arte de la hospitalidad desde 1957. Sus anfitriones, Jacky, Françoise y Matthieu, le darán la más cálida bienvenida para que sus vacaciones en Châtel rimen con dulzura y serenidad."
    ]
  },
