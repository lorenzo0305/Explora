  "rdfs:comment": {
    "de": [
      "Vom 13. bis 15. März kehrt die legendäre Piste L'Eclipse auf die große internationale Bühne zurück. Die besten Skifahrer der Welt versammeln sich zu zwei rasanten Wettkämpfen.\r\nExtreme Empfindungen und voller Einsatz."
    ],
    "en": [
      "From March 13 to March 15, the magic of ski racing comes to the legendary L’Éclipse slope, stage of the 2023 World Championships.\r\nThe world’s best skiers will face off in three thrilling speed events.\r\nOn the program: dizzying speed, total commitment, and guaranteed emotions!"
    ],
    "it": [
      "Dal 13 al 15 marzo, la leggendaria pista L'Eclipse torna sulla scena internazionale. I migliori sciatori del mondo si riuniscono per due eventi di velocità.\r\nEmozioni estreme e impegno totale."
    ],
    "fr": [
      "Du 13 au 15 mars, la piste légendaire de L'Eclipse retrouve la grande scène internationale. Les meilleurs skieurs du monde se rassemblent pour deux épreuves de vitesse.\r\nSensations extrêmes et d'engagement total."
    ],
    "nl": [
      "Van 13 tot 15 maart keert de legendarische piste L'Eclipse terug op het internationale toneel. De beste skiërs ter wereld komen samen voor twee snelheidsevenementen.\r\nExtreme sensatie en totale inzet."
    ],
    "es": [
      "Del 13 al 15 de marzo, la legendaria pista de L'Eclipse vuelve a la escena internacional. Los mejores esquiadores del mundo se reúnen en dos pruebas de velocidad.\r\nEmociones extremas y entrega total."
    ]
  },
  "rdfs:label": {
    "en": [
      "Men's Alpine Skiing World Cup - Audi FIS Ski World Cup"
    ],
    "fr": [
      "Coupe du Monde hommes de ski alpin - Audi FIS Ski World Cup"
    ]
  },
