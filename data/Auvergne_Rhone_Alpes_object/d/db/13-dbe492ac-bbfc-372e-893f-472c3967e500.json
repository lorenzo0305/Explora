  "rdfs:comment": {
    "de": [
      "Cathy bietet Ihnen die Möglichkeit, ihren Bauernhof \"à La Bonne Fourche\" zu entdecken. Während des Besuchs können Sie die Miniponys, den Esel, die Kühe, Kälber, Kaninchen und nicht zu vergessen die Meerschweinchen und Zwergziegen streicheln."
    ],
    "en": [
      "Cathy invites you to discover her farm \"à La Bonne Fourche\". During your visit, you'll enjoy mini ponies, a donkey, cows, calves and rabbits, not to mention petting guinea pigs and miniature goats."
    ],
    "it": [
      "Cathy vi invita a scoprire la sua fattoria \"à La Bonne Fourche\". Durante la visita, potrete ammirare mini pony, un asino, mucche, vitelli e conigli, oltre ad accarezzare porcellini d'India e capre in miniatura."
    ],
    "fr": [
      "Cathy vous propose de découvrir sa ferme \"à La Bonne Fourche\". Lors de la visite vous profiterez des mini-poneys, de l'âne, des vaches, veaux, lapins, sans oublier les caresses aux cobayes et chèvres naines."
    ],
    "nl": [
      "Cathy nodigt je uit om haar boerderij \"à La Bonne Fourche\" te komen ontdekken. Tijdens je bezoek kun je genieten van minipony's, een ezel, koeien, kalveren en konijnen, en niet te vergeten het aaien van cavia's en dwerggeiten."
    ],
    "es": [
      "Cathy le invita a descubrir su granja \"à La Bonne Fourche\". Durante su visita, podrá disfrutar de mini ponis, un burro, vacas, terneros y conejos, sin olvidar acariciar cobayas y cabras en miniatura."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC à La Bonne Fourche"
    ]
  },
