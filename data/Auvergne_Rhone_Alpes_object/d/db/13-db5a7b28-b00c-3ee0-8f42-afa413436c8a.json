  "rdfs:comment": {
    "de": [
      "Schulungen, um sein Fahrrad zu elektrifizieren und eine Batterie herzustellen.\r\neAska bietet Schulungen an, um seinen Schülern zu helfen, ihr Auto zu verlassen."
    ],
    "en": [
      "Training to electrify your bike and build your own battery.\r\neAska offers training courses to help its trainees leave their cars behind."
    ],
    "it": [
      "Formazione per elettrificare la bicicletta e costruire la batteria.\r\neAska offre corsi di formazione per aiutare i suoi corsisti a lasciare serenamente la propria auto."
    ],
    "fr": [
      "Des formations pour électrifier son vélo et fabriquer sa batterie.\r\neAska propose des formations pour aider ses stagiaires à quitter sereinement leur voiture."
    ],
    "nl": [
      "Training om je fiets te elektrificeren en je eigen accu te bouwen.\r\neAska biedt trainingen aan om cursisten te helpen met een gerust hart de auto achter zich te laten."
    ],
    "es": [
      "Entrenamiento para electrificar su bicicleta y construir su batería.\r\neAska ofrece cursos de formación para ayudar a sus alumnos a dejar sus coches con serenidad."
    ]
  },
