  "rdfs:comment": {
    "de": [
      "In einer trendigen Afterwork-Atmosphäre können Sie hier einen guten Moment bei einem Glas mit einem Aperitifbrett aus dem Land verbringen. Bier-, Wein-, Cocktail-, Pizza- und Fastfood-Bar."
    ],
    "en": [
      "In afterwork and trendy atmosphere, come to share a good moment around glass with locals products."
    ],
    "it": [
      "In un'atmosfera di tendenza e post-lavoro, venite a condividere un buon momento davanti a un drink accompagnato da un aperitivo locale. Birra, vino, cocktail, pizza e fast food."
    ],
    "fr": [
      "Dans une ambiance afterwork et branchée, venez partager un bon moment autour d'un verre accompagné d'une planche apéro du pays. Bar à bière, vin, cocktail, pizza et restauration rapide ."
    ],
    "nl": [
      "Kom in een trendy sfeer na het werk een goed moment delen onder het genot van een aperitief met een lokale borrelplank. Bier, wijn, cocktail, pizza en fast food bar."
    ],
    "es": [
      "En un ambiente afterwork y de moda, venga a compartir un buen momento tomando una copa acompañada de una tabla de aperitivos locales. Bar de cerveza, vino, cócteles, pizza y comida rápida."
    ]
  },
