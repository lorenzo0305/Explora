  "rdfs:comment": {
    "de": [
      "Herzlicher Empfang in einem alten Gewölbekeller, in dem roter, roséfarbener und weißer Beaujolais-Villages, Régnié, Chardonnay nach traditioneller Methode, prickelnder aromatischer Rosé, Beaujolais-Villages Nouveau produziert werden. Besichtigung des Weinkellers und des Weinbergs."
    ],
    "en": [
      "Warm welcome in an old vaulted cellar producing red, rosé and white Beaujolais-Villages, Régnié, Chardonnay traditional method, sparkling aromatic rosé, Beaujolais-Villages Nouveau. Visit of the cellar and the vineyard."
    ],
    "it": [
      "Un'accoglienza calorosa in un'antica cantina a volta che produce Beaujolais-Villages rosso, rosé e bianco, Régnié, chardonnay metodo tradizionale, rosé frizzante aromatico, Beaujolais-Villages Nouveau. Visita della cantina e del vigneto."
    ],
    "fr": [
      "Accueil chaleureux dans une cave voûtée et ancienne produisant du Beaujolais-Villages rouge, rosé et blanc, Régnié, chardonnay méthode traditionnelle, rosé arômatique pétillant, Beaujolais-Villages Nouveau. Visite de la cave et du vignoble."
    ],
    "es": [
      "Una cálida bienvenida en una antigua bodega abovedada que produce Beaujolais-Villages tinto, rosado y blanco, Régnié, chardonnay de método tradicional, rosado espumoso aromático, Beaujolais-Villages Nouveau. Visita a la bodega y al viñedo."
    ],
    "nl": [
      "Een warm welkom in een oude gewelfde kelder waar rode, rosé en witte Beaujolais-Villages, Régnié, chardonnay volgens de traditionele methode, aromatische sprankelende rosé, Beaujolais-Villages Nouveau worden geproduceerd. Bezoek aan de kelder en de wijngaard."
    ]
  },
  "rdfs:label": {
