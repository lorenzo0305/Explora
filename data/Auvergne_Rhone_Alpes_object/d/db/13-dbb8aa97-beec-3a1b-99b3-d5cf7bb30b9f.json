  "rdfs:comment": {
    "de": [
      "Vélorail auf der ehemaligen Bahnstrecke Livradois Forez: Fahren Sie von Allègre aus mit Muskelkraft auf dieser historischen Strecke, auf der es viel zu entdecken gibt, bis nach Malaguet. Hin- und Rückfahrt mit einer Gesamtlänge von 15 km."
    ],
    "en": [
      "Velorail on the old Livradois Forez railroad line : from Allègre, ride by calf power on this historical line, rich in discoveries, to Malaguet. A round trip of a total distance of 15 km."
    ],
    "it": [
      "Velorail sulla vecchia linea ferroviaria Livradois Forez: da Allègre, pedalate a forza di polpacci su questa linea storica, ricca di scoperte, fino a Malaguet. Un viaggio di andata e ritorno per una distanza totale di 15 km."
    ],
    "fr": [
      "Vélorail sur l’ancienne ligne ferroviaire Livradois Forez :  depuis Allègre, roulez à la force des mollets sur cette ligne historique, riche en découvertes, jusqu’à Malaguet. Un aller-retour d’une distance totale de 15 km."
    ],
    "nl": [
      "Velorail op de oude spoorlijn Livradois Forez: vanuit Allègre rijdt u op kuitkracht over deze historische lijn, rijk aan ontdekkingen, naar Malaguet. Een rondreis met een totale afstand van 15 km."
    ],
    "es": [
      "Velorail en la antigua línea de ferrocarril de Livradois Forez: desde Allègre, recorra a lomos de un ternero esta línea histórica, rica en descubrimientos, hasta Malaguet. Un viaje de ida y vuelta de una distancia total de 15 km."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vélorail d'Allègre"
    ]
  },
