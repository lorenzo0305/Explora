  "rdfs:comment": {
    "de": [
      "Der Y-Punkt ist die gängige Bezeichnung für eine Kreuzung, die durch die Kreuzung mehrerer Kanäle gebildet wird. Tergnier markiert somit die Kreuzung dreier Flussrouten."
    ],
    "en": [
      "Point Y is the name commonly given to the crossroads formed by the intersection of several canals. Tergnier thus marks the junction between three river routes."
    ],
    "it": [
      "Il Punto Y è il nome comunemente dato al crocevia formato dall'intersezione di diversi canali. Il Tergnier segna quindi l'incrocio tra tre percorsi fluviali."
    ],
    "fr": [
      "Le point Y, c'est le nom couramment donné au carrefour formé par le croisement de plusieurs canaux. Tergnier marque ainsi la jonction entre trois routes fluviales."
    ],
    "es": [
      "Punto Y es el nombre que se da comúnmente al cruce formado por la intersección de varios canales. Tergnier marca así el cruce entre tres vías fluviales."
    ],
    "nl": [
      "Punt Y is de naam die gewoonlijk wordt gegeven aan het kruispunt gevormd door de kruising van verschillende kanalen. Tergnier markeert dus de kruising van drie rivierroutes."
    ]
  },
  "rdfs:label": {
