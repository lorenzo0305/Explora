  "rdfs:comment": {
    "de": [
      "Escape Game: Fluchtspiel in Lebensgröße"
    ],
    "en": [
      "You don't know the concept of a life-size escape game yet?\r\nOur primary ambition: to offer, through our games, total immersion, vibrant emotions, original puzzles and unparalleled pleasure!"
    ],
    "it": [
      "Non conoscete ancora il concetto di giochi di fuga a grandezza naturale?\r\nLa nostra ambizione principale: offrire un'immersione totale, emozioni vibranti, enigmi originali e un divertimento senza pari attraverso i nostri giochi!"
    ],
    "fr": [
      "Vous ne connaissez pas encore le concept de jeu d’évasion grandeur nature ?\r\nNotre ambition première : offrir grâce à nos jeux une immersion totale, des émotions vibrantes, des énigmes originales et un plaisir inégalable !"
    ],
    "es": [
      "¿Aún no conoces el concepto de los juegos de escape a tamaño real?\r\nNuestra principal ambición: ofrecer una inmersión total, emociones vibrantes, rompecabezas originales y una diversión sin igual a través de nuestros juegos"
    ],
    "nl": [
      "Ken je het concept van levensgrote ontsnappingsspellen nog niet?\r\nOnze voornaamste ambitie: totale onderdompeling, levendige emoties, originele puzzels en ongeëvenaard plezier bieden via onze spellen!"
    ]
  },
  "rdfs:label": {
