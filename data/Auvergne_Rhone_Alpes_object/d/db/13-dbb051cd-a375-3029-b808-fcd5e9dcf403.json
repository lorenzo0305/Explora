  "rdfs:comment": {
    "de": [
      "Die Bar, Bistrot de la Croix de Chamrousse liegt auf 2250 m Höhe und ist im Winter wie im Sommer mit der Gondelbahn erreichbar. Sie bietet Ihnen traditionelle Gerichte, die am Tisch serviert werden, und eine Self-Service-Formel."
    ],
    "en": [
      "Located at 2250m of altitude and accessible by gondola, the bar/restaurant of La Croix de Chamrousse and its team offers traditional food with table service and a self-service option."
    ],
    "it": [
      "Situato a 2250 metri di altitudine e accessibile con la funivia in inverno e in estate, il Bar, Bistrot de la Croix de Chamrousse offre un servizio tradizionale al tavolo e un'opzione self-service."
    ],
    "fr": [
      "Situé à 2250m d’altitude et accessible par la télécabine hiver comme été, le Bar, Bistrot de la Croix de Chamrousse vous propose une restauration traditionnelle servie à table et une formule Self."
    ],
    "es": [
      "Situado a 2250 m de altitud y accesible por el teleférico en invierno y en verano, el bar Bistrot de la Croix de Chamrousse ofrece un servicio de mesa tradicional y una opción de autoservicio."
    ],
    "nl": [
      "De Bar, Bistrot de la Croix de Chamrousse ligt op 2250 m hoogte en is 's winters en 's zomers bereikbaar met de kabelbaan. Hij biedt traditionele bediening aan tafel en zelfbediening."
    ]
  },
