    "de": [
      "Besuche die Überreste der riesigen Burg von Coucy mit ihren unterirdischen Räumen und Aussichtspunkten auf die Umgebung. Nicht verpassen!"
    ],
    "en": [
      "Visit the remains of the gigantic Coucy castle with its underground rooms and its viewpoints on the surroundings. Not to be missed!"
    ],
    "it": [
      "Visitate i resti del gigantesco castello di Coucy con le sue stanze sotterranee e la vista sulla zona circostante. Da non perdere!"
    ],
    "fr": [
