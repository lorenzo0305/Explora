  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c1214e4c-cd61-31a6-83c9-aa59d420fd1f",
      "dc:description": {
        "de": [
          "Die beeindruckenden Überreste des Schlosses von Coucy dominieren das Tal der Ailette. Auf einem Felsvorsprung mit weitem Panorama entdecken Sie auf fast 4 Hektar die Überreste der einst gigantischsten Feudalburg des gesamten Christentums!"
        ],
        "en": [
          "The impressive vestiges of the Castle of Coucy dominate the Valley of the Ailette. On a spur offering a vast panorama, discover, on nearly 4 hectares, the vestiges of what was the most gigantic feudal castle of all Christendom!"
        ],
        "it": [
          "Gli imponenti resti del Castello di Coucy dominano la Valle dell'Ailette. Su uno sperone che offre un vasto panorama, scoprite i resti di quello che un tempo era il più grande castello feudale di tutta la cristianità su una superficie di quasi 4 ettari!"
        ],
        "fr": [
          "Les impressionnants vestiges du Château de Coucy dominent la Vallée de l'Ailette. Sur un éperon offrant un vaste panorama, découvrez, sur près de 4 hectares, les vestiges de ce qui a été le plus gigantesque château féodal de toute la chrétienté !"
        ],
        "es": [
          "Los impresionantes restos del castillo de Coucy dominan el valle de Ailette. En un espolón que ofrece un amplio panorama, descubra los restos de lo que fue el mayor castillo feudal de toda la cristiandad en una superficie de casi 4 hectáreas"
        ],
        "nl": [
          "De indrukwekkende overblijfselen van het kasteel van Coucy domineren de vallei van de Ailette. Ontdek op een uitloper met een weids uitzicht de overblijfselen van wat eens het grootste feodale kasteel van het hele christendom was, op een oppervlakte van bijna 4 hectare!"
        ]
      },
      "@type": [
        "Description"
      ],
