  "rdfs:comment": {
    "de": [
      "Entdecken Sie die erste Episode einer neuen, unveröffentlichten Serie, die nach Ihrem Lieblingsrezept zusammengestellt wurde! 4 Freunde und ein Sofa, um eine völlig improvisierte Sitcom zu kreieren!"
    ],
    "en": [
      "Come and discover the first episode of a new series, made to measure with your favorite recipe! 4 Friends and a Couch, to create a totally improvised sitcom!"
    ],
    "it": [
      "Venite a scoprire il primo episodio di una nuova serie, realizzata su misura con la vostra ricetta preferita! 4 amici e un divano, per creare una sitcom totalmente improvvisata!"
    ],
    "fr": [
      "Venez découvrir le premier épisode d'une nouvelle série inédite, composée sur mesure avec votre recette favorite ! 4 Amis et un canapé, pour créer une sitcom totalement improvisée !"
    ],
    "es": [
      "Venga a descubrir el primer episodio de una nueva serie, ¡hecha a medida con su receta favorita! 4 Friends y un sofá, ¡para crear una sitcom totalmente improvisada!"
    ],
    "nl": [
      "Kom en ontdek de eerste aflevering van een nieuwe serie, op maat gemaakt met jouw favoriete recept! 4 Vrienden en een bank, om een totaal geïmproviseerde sitcom te maken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "SitCom - la série improvisée"
    ]
  },
