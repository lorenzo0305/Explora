  "rdfs:comment": {
    "de": [
      "400 m vom Zentrum des Skiortes Châtel entfernt liegt das Hotel-Restaurant\r\n\"Le Castellan\" ist ideal gelegen, damit Sie einen angenehmen Urlaub verbringen können.\r\nSo tanken Sie Entspannung und Freizeitvergnügen."
    ],
    "en": [
      "400 m from the ski resort of Châtel, the hotel-restaurant \"Le Castellan\" is ideally located to allow you to enjoy a pleasant holiday."
    ],
    "it": [
      "A 400 m dal centro della stazione sciistica di Châtel, l'hotel ristorante\r\n\"Le Castellan\" è situato in posizione ideale per trascorrere una piacevole vacanza.\r\nPer un soggiorno rilassante e piacevole."
    ],
    "fr": [
      "A 400 m du centre de la station de ski de Châtel, l'hôtel-restaurant\r\n\" Le Castellan \" est idéalement situé pour vous permettre de passer des vacances agréables.\r\nPour faire le plein de détente et de loisirs."
    ],
    "nl": [
      "Op slechts 400 m van het centrum van het skigebied van Châtel ligt het hotel-restaurant\r\n\"Le Castellan\" ideaal gelegen voor een aangename vakantie.\r\nEen plek om te ontspannen en te genieten van uw vrije tijd."
    ],
    "es": [
      "A 400 m del centro de la estación de esquí de Châtel, el hotel-restaurante\r\n\"Le Castellan\" está idealmente situado para pasar unas vacaciones agradables.\r\nPara una estancia relajada y sin prisas."
    ]
  },
