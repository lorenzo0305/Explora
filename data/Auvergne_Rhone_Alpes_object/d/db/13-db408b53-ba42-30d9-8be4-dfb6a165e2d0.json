  "rdfs:comment": {
    "de": [
      "Im Herzen des Ortes, gegenüber dem Place de L'Eglise, empfängt Sie La Grange.\r\nBrasserie, savoyische Spezialitäten und bretonische Galettes stehen auf der Speisekarte!"
    ],
    "en": [
      "In the heart of the resort, opposite Place de l'Eglise, La Grange welcomes you.\nBrasserie, Savoyard specialities and Breton galettes are on the menu!"
    ],
    "it": [
      "Nel cuore della località, di fronte alla Place de l'Eglise, La Grange vi dà il benvenuto.\nBrasserie, specialità savoiarde e galettes bretoni sono nel menu!"
    ],
    "fr": [
      "Au coeur de la station, en face de la place de L'Eglise, La Grange vous accueille.\r\nBrasserie, spécialités savoyardes et galettes bretonnes sont à la carte !"
    ],
    "nl": [
      "In het hart van het resort, tegenover de Place de l'Eglise, heet La Grange je welkom.\nBrasserie, Savoyaardse specialiteiten en Bretonse galettes staan op het menu!"
    ],
