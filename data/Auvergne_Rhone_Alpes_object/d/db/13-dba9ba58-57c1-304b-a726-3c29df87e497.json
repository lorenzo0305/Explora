  "rdfs:comment": {
    "de": [
      "Familiärer Landgasthof, Spezialitäten: Froschschenkel, Ukeleifritüre, Entrecôte Charolaise, Produkte vom Bauernhof und hausgemachte Desserts. Eine große, einladende und schattige Terrasse."
    ],
    "en": [
      "Family-run country inn, specializing in frogs' legs, fried ablette, Charolais entrecôte, farm produce and homemade desserts. Large, welcoming, shaded terrace."
    ],
    "it": [
      "Locanda di campagna a conduzione familiare, specialità: cosce di rana, ablette fritte, entrecôte di Charolais, prodotti della fattoria e dolci fatti in casa. Ampia e accogliente terrazza all'ombra."
    ],
    "fr": [
      "Auberge familiale de campagne, spécialités : cuisses de grenouilles, fritures d'ablette, entrecôte charolaise, produits de la ferme et desserts maison. Une grande terrasse accueillante et ombragée."
    ],
    "es": [
      "Posada rural familiar, especialidades: ancas de rana, ablette frita, entrecot de Charolais, productos de la granja y postres caseros. Amplia y acogedora terraza a la sombra."
    ],
    "nl": [
      "Familiale herberg op het platteland, specialiteiten: kikkerbilletjes, gebakken ablette, Charolais entrecôte, producten van de boerderij en huisgemaakte desserts. Groot, gezellig terras in de schaduw."
    ]
  },
  "rdfs:label": {
