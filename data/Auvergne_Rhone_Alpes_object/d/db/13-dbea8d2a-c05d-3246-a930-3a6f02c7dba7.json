  "rdfs:comment": {
    "de": [
      "Die Nutzung vor Ort ist kostenlos; für die Ausleihe ist eine Mitgliedskarte erforderlich.\r\nDer Jahresbeitrag beträgt 20 ? pro Familie und 5 ? pro Kind mit Wohnsitz im Gebiet der Communauté Loire Semène."
    ],
    "en": [
      "Consultation on site is free; borrowing requires a membership card.\r\nThe annual fee is fixed at 20 ? per family and 5 ? per child residing on the territory of the Loire Semène Community."
    ],
    "it": [
      "La consultazione in loco è gratuita; per il prestito è necessaria una tessera associativa.\r\nLa quota associativa annuale è fissata a 20 € per famiglia e 5 € per bambino residente nella Comunità della Loira Semène."
    ],
    "fr": [
      "La consultation sur place est gratuite; les emprunts nécessitent une carte d'adhérent.\r\nLa cotisation annuelle est fixée à 20 € par famille et 5 € par enfant résidants sur le territoire de la Communauté Loire Semène."
    ],
    "es": [
      "La consulta in situ es gratuita; el préstamo requiere el carné de socio.\r\nLa cuota anual de socio está fijada en 20 € por familia y 5 € por niño residente en la Comunidad de Loire Semène."
    ],
    "nl": [
      "De raadpleging ter plaatse is gratis; voor het lenen is een lidkaart nodig.\r\nDe jaarlijkse bijdrage is vastgesteld op 20 € per gezin en 5 € per kind dat in de Gemeenschap Loire Semène woont."
    ]
  },
  "rdfs:label": {
