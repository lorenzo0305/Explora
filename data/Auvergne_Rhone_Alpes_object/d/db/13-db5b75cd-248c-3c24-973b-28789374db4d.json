  "rdfs:comment": {
    "de": [
      "Ich habe mich auf die Konservierung und Restaurierung alter vergoldeter Hölzer spezialisiert und halte mich dabei an traditionelle Techniken. Ich biete Ihnen Informationen und Beratung, wie Sie Ihre vergoldeten Holzobjekte erhalten, restaurieren und aufwerten können."
    ],
    "en": [
      "Specializing in the conservation and restoration of antique gilded wood using traditional techniques, I can provide you with information and advice on how to preserve, restore and enhance your gilded wood objects."
    ],
    "it": [
      "Specializzata nella conservazione e nel restauro del legno dorato antico con tecniche tradizionali, mi offro di informarvi e consigliarvi su come conservare, restaurare e valorizzare i vostri oggetti in legno dorato."
    ],
    "fr": [
      "Spécialisé dans la conservation et la restauration des bois dorés anciens en respectant les techniques traditionnelles, je vous propose de vous informer et vous conseiller, sur les moyens de préserver, restaurer et valoriser vos objets en  bois dorés."
    ],
    "nl": [
      "Ik ben gespecialiseerd in het conserveren en restaureren van antiek verguld hout met behulp van traditionele technieken. Ik kan je informatie en advies geven over hoe je verguld houten voorwerpen kunt conserveren, restaureren en verfraaien."
    ],
    "es": [
      "Especializada en la conservación y restauración de madera dorada antigua mediante técnicas tradicionales, me ofrezco a informarle y asesorarle sobre cómo conservar, restaurar y mejorar sus objetos de madera dorada."
    ]
  },
