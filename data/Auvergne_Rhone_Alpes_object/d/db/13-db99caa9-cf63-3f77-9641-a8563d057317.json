  "rdfs:comment": {
    "de": [
      "Haben Sie sich für den permanenten Orientierungslauf im Dorf Cevins entschieden? Finden Sie alle Hinweise, die Sie zu den verschiedenen Markierungen im Dorf führen, und gehen Sie auf Entdeckungsreise durch sein Kulturerbe! Genießen Sie den Parcours!"
    ],
    "en": [
      "Have you chosen the permanent orienteering course in the village of Cevins? Find all the clues that will lead you to the various markers around the village and discover its heritage! Enjoy the course!"
    ],
    "it": [
      "Avete scelto il percorso di orientamento permanente del villaggio di Cevins? Trovate tutti gli indizi che vi condurranno ai vari indicatori posti nel villaggio e partite alla scoperta del suo patrimonio! Godetevi il percorso!"
    ],
    "fr": [
      "Vous avez choisit le parcours d'orientation permanent dans le village de Cevins ? Retrouvez tous les indices qui vous mèneront aux différentes balises disposées dans le village et partez à la découverte de son patrimoiene ! Profitez bien du parcours !"
    ],
    "es": [
      "¿Has elegido el recorrido de orientación permanente del pueblo de Cevins? Encuentre todas las pistas que le llevarán a los distintos hitos colocados en el pueblo y ¡parta a descubrir su patrimonio! ¡Disfrute del recorrido!"
    ],
    "nl": [
      "Heb jij het permanente oriëntatieparcours in het dorp Cevins gekozen? Vind alle aanwijzingen die je naar de verschillende markeringen in het dorp leiden en ga op ontdekkingstocht naar het erfgoed! Veel plezier op de route!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours permanent d'orientation - Cevins"
    ]
  },
