  "rdfs:comment": {
    "de": [
      "Musikalische Lesung \"La Brûlure\" mit Brigitte Giraud (Text, Stimme) und Christophe Langlade (Musik, Gitarre), gefolgt von einem Treffen mit den Künstlern, Autor von Carte de séjour. Eine Rockband im süßen Frankreich der 1980er Jahre."
    ],
    "en": [
      "Musical reading \"La Brûlure\" with Brigitte Giraud (text, voice) and Christophe Langlade (music, guitar) followed by a meeting with the artists, author of Carte de séjour. A rock band in the gentle France of the 1980s."
    ],
    "it": [
      "Lettura musicale de \"La Brûlure\" con Brigitte Giraud (testo, voce) e Christophe Langlade (musica, chitarra) seguita da un incontro con gli artisti, autori di Carte de séjour. Un gruppo rock nella Francia gentile degli anni Ottanta."
    ],
    "fr": [
      "Lecture musicale « La Brûlure » avec Brigitte Giraud (texte, voix) et Christophe Langlade (musique, guitare) suivie d’une rencontre avec les artistes, auteur de Carte de séjour. Un groupe rock dans la douce France des années 1980."
    ],
    "nl": [
      "Muzikale lezing van \"La Brûlure\" met Brigitte Giraud (tekst, zang) en Christophe Langlade (muziek, gitaar) gevolgd door een ontmoeting met de artiesten, auteur van Carte de séjour. Een rockband in het zachte Frankrijk van de jaren 1980."
    ],
    "es": [
      "Lectura musical de \"La Brûlure\" con Brigitte Giraud (texto, voz) y Christophe Langlade (música, guitarra) seguida de un encuentro con los artistas, autores de Carte de séjour. Un grupo de rock en la apacible Francia de los años 80."
