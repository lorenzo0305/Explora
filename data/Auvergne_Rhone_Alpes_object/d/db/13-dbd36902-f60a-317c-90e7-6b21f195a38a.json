  "rdfs:comment": {
    "de": [
      "In der warmen und authentischen Umgebung eines alten Bauernhofs empfängt Sie das Personal des Restaurants, um seine traditionelle Küche und seine savoyischen Spezialitäten à la Braise zu genießen."
    ],
    "en": [
      "In the warm, authentic setting of an old farmhouse, the restaurant staff welcome you to sample their traditional cuisine and Savoyard specialities à la Braise."
    ],
    "it": [
      "Nell'ambiente caldo e autentico di un'antica fattoria, il personale del ristorante vi accoglie per farvi assaggiare la sua cucina tradizionale e le specialità savoiarde à la Braise."
    ],
    "fr": [
      "Dans le cadre chaleureux et authentique d'une vieille ferme, le personnel du restaurant vous accueille pour venir déguster sa cuisine traditionnelle et ses spécialités savoyardes à la Braise."
    ],
    "nl": [
      "In de warme, authentieke omgeving van een oude boerderij heet het personeel van het restaurant je welkom om hun traditionele keuken en Savoyaardse specialiteiten à la Braise te proeven."
    ],
    "es": [
      "En el marco cálido y auténtico de una antigua granja, el personal del restaurante le da la bienvenida para degustar su cocina tradicional y las especialidades saboyanas à la Braise."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Vieille Ferme"
    ]
  },
