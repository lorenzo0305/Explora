  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen einzigartigen Ort über das befestigte alpine Kulturerbe.\r\nAuf dem Programm stehen: Führungen, Schnitzeljagd für Kinder, Escape Game, Souvenirladen. Pädagogische Workshops für Schulklassen."
    ],
    "en": [
      "Discover a unique place on the fortified alpine heritage. \r\nOn the programme: guided tours, treasure hunts for children, escape game, souvenir shop. Educational workshops for schools."
    ],
    "it": [
      "Scoprite un luogo unico nel patrimonio alpino fortificato.\r\nIn programma: visite guidate, caccia al tesoro per bambini, gioco di fuga, negozio di souvenir. Laboratori didattici per le scuole."
    ],
    "fr": [
      "Découvrez un lieu unique sur le patrimoine alpin fortifié. \r\nAu programme : visites guidées, jeux de piste pour les enfants, escape game, boutique de souvenirs. Ateliers pédagogiques pour scolaires."
    ],
    "nl": [
      "Ontdek een unieke plek op het versterkte alpenerfgoed. \r\nOp het programma: rondleidingen, speurtochten voor kinderen, ontsnappingsspel, souvenirwinkel. Educatieve workshops voor scholen."
    ],
    "es": [
      "Descubra un lugar único en el patrimonio alpino fortificado.\r\nEn el programa: visitas guiadas, búsqueda del tesoro para niños, juego de escape, tienda de recuerdos. Talleres educativos para colegios."
    ]
  },
