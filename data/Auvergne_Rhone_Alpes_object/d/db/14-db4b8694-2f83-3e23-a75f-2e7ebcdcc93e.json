      "@id": "https://data.datatourisme.fr/cce5d927-ef4a-361e-9ef0-6144fd7312c4",
      "dc:description": {
        "de": [
          "Edith Piaf-Konzert, gesungen von Gvantsa\nEin Konzert mit dem Repertoire von Edith Piaf, gesungen von Gvantsa und erzählt von André. Treffpunkt um 20 Uhr Diese Show greift das Leben von Edith Piaf auf...\nKostenlos"
        ],
        "en": [
          "Concert Edith Piaf sung by Gvantsa\nConcert on the repertoire of Edith Piaf sung by Gvantsa and told by André. RDV at 8pm This show takes up the life of Edith Piaf...\nFree"
        ],
        "it": [
          "Concerto di Edith Piaf cantato da Gvantsa\nConcerto basato sul repertorio di Edith Piaf cantato da Gvantsa e raccontato da André. RDV ore 20.00 Questo spettacolo riprende la vita di Edith Piaf...\nGratuito"
        ],
        "fr": [
          "Concert Edith Piaf chanté par Gvantsa\nConcert sur le répertoire d’ Edith Piaf chantée par Gvantsa et contée par André. RDV à 20h Ce spectacle reprend la vie d’Edith Piaf...\nGratuit"
        ],
        "nl": [
          "Edith Piaf concert gezongen door Gvantsa\nConcert gebaseerd op het repertoire van Edith Piaf, gezongen door Gvantsa en verteld door André. RDV om 20.00 uur Deze voorstelling gaat in op het leven van Edith Piaf...\nGratis"
        ],
        "es": [
          "Concierto de Edith Piaf cantado por Gvantsa\nConcierto basado en el repertorio de Edith Piaf cantado por Gvantsa y narrado por André. RDV a las 20.00 h Este espectáculo retoma la vida de Edith Piaf...\nGratis"
        ]
      },
