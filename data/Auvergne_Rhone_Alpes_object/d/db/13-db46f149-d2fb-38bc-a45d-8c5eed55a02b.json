  "rdfs:comment": {
    "de": [
      "Christophe, Mélanie, Karine und Hugo freuen sich, Sie in einer gemütlichen Umgebung begrüßen zu dürfen. Genießen Sie eine traditionelle Lyoner Küche, die mit frischen, lokalen Produkten und viel Liebe zubereitet wird!"
    ],
    "en": [
      "Christophe, Mélanie, Karine and Hugo are delighted to welcome you in a warm setting to enjoy a traditional Lyon cuisine, cooked with fresh, local products and a lot of love!"
    ],
    "it": [
      "Christophe, Mélanie, Matthias, Hélène e Mathis sono lieti di accogliervi in un'atmosfera calorosa per farvi gustare la tradizionale cucina lionese, cucinata con prodotti freschi e locali e con tanto amore!"
    ],
    "fr": [
      "Christophe, Mélanie, Matthias, Hélène et Mathis sont ravis de vous accueillir dans un cadre chaleureux pour profiter d’une cuisine traditionnelle lyonnaise, cuisinée avec des produits frais, locaux et beaucoup d’amour !"
    ],
    "es": [
      "Christophe, Mélanie, Matthias, Hélène y Mathis están encantados de recibirle en un ambiente acogedor para degustar la cocina tradicional lionesa, elaborada con productos frescos de la tierra y mucho amor"
    ],
    "nl": [
      "Christophe, Mélanie, Matthias, Hélène en Mathis ontvangen je graag in een warme sfeer om te genieten van de traditionele Lyonnaise keuken, bereid met verse, lokale producten en heel veel liefde!"
    ]
  },
