  "COVID19SpecialMeasures": {
    "de": [
      "Die Agentur Arthur Loyd Lille begleitet Sie bei Ihrer Suche nach Unternehmensimmobilien in allen Departements des Nordens und des Pas de Calais.\n\nBüros, Geschäftsräume, Lagerhallen, Grundstücke, Gewerbeimmobilien oder Investitionen - unser Team steht Ihnen jederzeit zur Verfügung."
    ],
    "en": [
      "The Arthur Loyd Lille agency accompanies you in your search for commercial real estate throughout the Nord and Pas de Calais departments.\n\nWhether you're looking for offices, business premises, warehouses, land, commercial premises or investment property, our team is at your service."
    ],
    "it": [
      "L'agenzia Arthur Loyd Lille vi accompagna nella ricerca di immobili commerciali in tutti i dipartimenti del Nord e del Pas de Calais.\n\nChe siate alla ricerca di uffici, locali commerciali, magazzini, terreni, locali commerciali o investimenti, il nostro team è al vostro servizio."
    ],
    "fr": [
      "L'agence Arthur Loyd Lille vous accompagne dans vos recherches en immobilier d'entreprise sur l'ensemble des départements du Nord et du Pas de Calais.\n\nBureaux, Locaux d'Activité, Entrepôts, Terrains, Locaux commerciaux ou Investissement, notre équipe de est à votre écoute."
    ],
    "es": [
      "La agencia Arthur Loyd Lille le acompaña en su búsqueda de inmuebles comerciales en todos los departamentos de Nord y Pas de Calais.\n\nTanto si busca oficinas, locales comerciales, almacenes, terrenos, locales comerciales o inversiones, nuestro equipo está a su servicio."
    ],
    "nl": [
      "Het Arthur Loyd agentschap in Lille begeleidt u in uw zoektocht naar commercieel vastgoed in de departementen Nord en Pas de Calais.\n\nOf u nu op zoek bent naar kantoren, bedrijfsruimten, magazijnen, terreinen, commerciële ruimten of investeringen, ons team staat voor u klaar."
    ]
  },
