  "rdfs:comment": {
    "de": [
      "Einführung in den Biathlon mit Luftgewehr oder 22 long rifle im Stadion Raphaël Poirée in Vassieux oder im nordischen Gebiet von font d'urle\r\nZu allen Jahreszeiten.\r\nAls Berg- und Mountainbikebegleiter kann ich Sie mitnehmen, um das Massiv zu entdecken."
    ],
    "en": [
      "Introduction to biathlon with air rifle or 22 long rifle at the Raphaël Poirée stadium in Vassieux or the Nordic domain of Font d'urle\r\nAll seasons.\r\nMountain guide and mountain bike I can take you to discover the massif."
    ],
    "it": [
      "Introduzione al biathlon con carabina ad aria compressa o carabina lunga 22 presso lo stadio Raphaël Poirée di Vassieux o l'area nordica di Font d'urle\r\nTutte le stagioni.\r\nGuida alpina e mountain biker, posso accompagnarvi alla scoperta del massiccio."
    ],
    "fr": [
      "Initiation au biathlon avec carabine à air comprimé ou 22 long rifle au stade Raphaël Poirée à Vassieux ou domaine nordique de font d'urle. \r\nToutes saisons.\r\nAccompagnateur en montagne et VTT je peux vous emmener découvrir le massif."
    ],
    "nl": [
      "Kennismaking met biatlon met luchtgeweer of 22 lang geweer in het Raphaël Poirée stadion in Vassieux of het Nordic gebied van Font d'urle\r\nAlle seizoenen.\r\nBerggids en mountainbiker kan ik u meenemen om het massief te ontdekken."
    ],
    "es": [
      "Iniciación al biatlón con rifle de aire o rifle 22 largo en el estadio Raphaël Poirée de Vassieux o en la zona nórdica de Font d'urle\r\nTodas las estaciones.\r\nGuía de montaña y ciclista de montaña puedo llevarte a descubrir el macizo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vercors Biathlon"
    ]
  },
