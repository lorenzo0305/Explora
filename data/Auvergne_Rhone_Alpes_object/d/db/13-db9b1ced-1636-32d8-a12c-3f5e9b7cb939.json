  "rdfs:comment": {
    "de": [
      "Im Herzen von Herbeys, einem kleinen, ländlichen und gastfreundlichen Dorf in den Hügeln von Grenoble.\r\nEin neuer Ort des Austauschs und der Verkostung auf einer 500m2 großen Gartenterrasse mit einem atypischen Blick auf die Belledonne-Kette und den Taillefer."
    ],
    "en": [
      "In the heart of Herbeys, a small welcoming rural village nestled on the heights of Grenoble.\r\nA new place for exchanges and tastings set on a 500m2 garden terrace, with an atypical view of the Belledonne range and the Taillefer"
    ],
    "it": [
      "Nel cuore di Herbeys, un piccolo e accogliente villaggio di campagna immerso nelle colline sopra Grenoble, scoprite questo nuovo luogo di incontro e degustazione situato in un giardino terrazzato di 500 m² con una vista insolita su Belledonne e Taillefer."
    ],
    "fr": [
      "Au cœur d’Herbeys, petit village champêtre et accueillant niché sur les hauteurs de Grenoble, découvrez ce nouveau lieu d’échanges et de dégustations posé sur un jardin terrasse de 500m², doté d’une vue atypique sur Belledonne et le Taillefer."
    ],
    "nl": [
      "Ontdek in het hart van Herbeys, een klein, gastvrij plattelandsdorpje in de heuvels boven Grenoble, deze nieuwe ontmoetings- en degustatieplek in een terrastuin van 500 m² met een bijzonder uitzicht op Belledonne en Taillefer."
    ],
    "es": [
      "En el corazón de Herbeys, pequeño y acogedor pueblo rural situado en las colinas de Grenoble.\r\nUn nuevo lugar de encuentro y degustación situado en una terraza-jardín de 500 m2, con una vista insólita de la cordillera Belledonne y de Taillefer."
    ]
  },
  "rdfs:label": {
    "en": [
      "At the Uriage Relay"
    ],
    "fr": [
      "Au Relais d'Uriage"
    ]
  },
