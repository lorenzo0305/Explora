  "rdfs:comment": {
    "de": [
      "Das L'Origan bietet eine erfinderische Gourmetküche, die sich nach den Jahreszeiten richtet.\r\nNach einer Partie Squash können Sie auch in aller Ruhe am Bachufer unter den Platanen die köstlichen Gerichte genießen, die Patrick Marche für Sie zubereitet hat. Weinkeller"
    ],
    "en": [
      "L'Origan serves an inventive, gourmet menu of seasonal dishes. Sample at your leisure, perhaps after a good game of squash, Patrick Marche's succulent dishes under the plane trees by the stream. Wine cellar."
    ],
    "it": [
      "L'Origan propone una cucina franco-argentina.\nDopo una bella partita a squash, potrete anche gustare i succulenti piatti preparati dal nostro team sotto i platani vicino al ruscello. Cantina e sale riunioni"
    ],
    "fr": [
      "L'Origan propose une cuisine Franco Argentine . \nVous pourrez aussi, après une bonne partie de squash, déguster tranquillement, au bord du ruisseau, sous les platanes, les succulents plats concoctés par notre équipe. Cave à vins et salles de reunion"
    ],
    "es": [
      "L'Origan sirve cocina franco-argentina.\nDespués de una buena partida de squash, también podrá disfrutar de los suculentos platos elaborados por nuestro equipo bajo los plátanos junto al arroyo. Bodega y salas de reuniones"
    ],
    "nl": [
      "L'Origan biedt een inventieve gastronomische keuken die met de seizoenen meegaat. \r\nU kunt na een lekker partijtje squash rustig langs het beekje onder de platanen genieten van de heerlijk bereide gerechten van Patrick Marche. Wijnkelder"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Origan"
    ]
  },
