  "rdfs:comment": {
    "de": [
      "10 Jahre YOGA-Unterricht.\r\nIch biete das ganze Jahr über Sitzungen und Praktika in Räumen und an schönen Tagen auch im Freien an.\r\nIch fahre an Ihren Urlaubsort (40 km um Crest) oder empfange Sie für Privatstunden."
    ],
    "en": [
      "10 years of teaching YOGA.\r\nI offer sessions and internships throughout the year indoors and outdoors during the summer. \r\nI move to your holiday location (40 km around Crest) or I welcome you for private lessons."
    ],
    "it": [
      "10 anni di insegnamento dello YOGA.\r\nOffro sessioni e corsi durante tutto l'anno al chiuso e all'aperto con il bel tempo.\r\nPosso recarmi nella vostra località di vacanza (40 km intorno a Crest) o accogliervi per lezioni private."
    ],
    "fr": [
      "10 ans d'enseignement du YOGA.\r\nJe propose des séances et des stages tout au long de l'année en salle et en extérieur pendant les beaux jours. \r\nJe me déplace sur votre lieu de vacances (40 km autour de Crest) ou je vous accueille pour des cours privés."
    ],
    "nl": [
      "10 jaar YOGA-les.\r\nIk bied het hele jaar door sessies en cursussen aan, zowel binnen als buiten bij mooi weer.\r\nIk kan naar je vakantiebestemming reizen (40 km rond Crest) of je ontvangen voor privélessen."
    ],
    "es": [
      "10 años enseñando YOGA.\r\nOfrezco sesiones y cursos durante todo el año en el interior y al aire libre cuando hace buen tiempo.\r\nPuedo desplazarme a tu destino de vacaciones (40 km alrededor de Crest) o recibirte para clases particulares."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Danse avec ton Souffle - Yoga"
    ]
  },
