  "rdfs:comment": {
    "de": [
      "Der Musikpavillon auf dem Champ de Mars wurde 1862 vom Architekten Eugène Poitoux entworfen und wurde 1942 dank des Illustrators Raymond Peynet berühmt."
    ],
    "en": [
      "The Champ de Mars bandstand was designed in 1862 by architect Eugène Poitoux and became famous in 1942 thanks to illustrator Raymond Peynet."
    ],
    "it": [
      "Il palco della banda sul Campo di Marte fu creato nel 1862 dall'architetto Eugène Poitoux e divenne famoso nel 1942 grazie all'illustratore Raymond Peynet."
    ],
    "fr": [
      "Le Kiosque à musique du Champ de Mars a été créé en 1862 par l'architecte Eugène Poitoux et deviendra célèbre en 1942 grâce à l'illustrateur Raymond Peynet."
    ],
    "es": [
      "El quiosco de música del Campo de Marte fue creado en 1862 por el arquitecto Eugène Poitoux y se hizo famoso en 1942 gracias al ilustrador Raymond Peynet."
    ],
    "nl": [
      "De muziektent op het Champ de Mars werd in 1862 ontworpen door architect Eugène Poitoux en werd in 1942 beroemd dankzij illustrator Raymond Peynet."
