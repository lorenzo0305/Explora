  "rdfs:comment": {
    "de": [
      "Als Obst- und Gemüseproduzent empfangen wir Sie direkt auf unserem Anwesen. Entdecken Sie die zum Verkauf angebotenen Bio-Kiwis, für die wir bekannt sind\r\nBesuchen Sie uns und lassen Sie sich verwöhnen. Finden Sie unsere Produktion bei unseren Partnern in der Region."
    ],
    "en": [
      "Producer of fruits and vegetables, we receive you directly at the property. Discover the organic kiwis for sale that have made our reputation\r\nCome and visit us and treat yourself. Find our production at our partners in the area."
    ],
    "it": [
      "Produttore di frutta e verdura, vi diamo il benvenuto direttamente nella proprietà. Scoprite i kiwi biologici in vendita che hanno fatto la nostra reputazione\r\nVenite a trovarci e divertitevi. Trovate la nostra produzione presso i nostri partner della zona."
    ],
    "fr": [
      "Producteur de fruits et légumes, nous vous recevons directement à la propriété. Découvrez les kiwis bio à la vente qui ont fait notre renommée. \r\nVenez nous rendre visite et vous régaler. Retrouver notre production chez nos partenaires sur le territoire."
    ],
    "es": [
      "Productor de frutas y verduras, le damos la bienvenida directamente a la propiedad. Descubra los kiwis orgánicos en venta que han hecho nuestra reputación\r\nVen a visitarnos y disfruta. Encuentre nuestra producción en nuestros socios de la zona."
    ],
    "nl": [
      "Fruit en groenten producent, wij verwelkomen u direct op het terrein. Ontdek de biologische kiwi's te koop die onze reputatie hebben gemaakt\r\nKom ons bezoeken en geniet. Vind onze productie bij onze partners in de regio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Taga fruits"
    ]
  },
