  "rdfs:comment": {
    "de": [
      "Augustine begleitet Sie auf Wanderungen.\r\nAls Bergbegleiterin hat sie ein festgelegtes Programm oder sie hört Ihnen zu, um auf Ihre persönlichen Wünsche à la carte einzugehen."
    ],
    "en": [
      "Augustine accompanies you on hikes.\r\nAs a mountain guide, she has an established program or she is at your disposal to answer your personalized requests."
    ],
    "it": [
      "Augustine vi accompagna nelle escursioni.\r\nCome guida alpina, ha un programma prestabilito o è a vostra disposizione per soddisfare le vostre esigenze individuali."
    ],
    "fr": [
      "Augustine vous accompagne en randonnées.\r\nAccompagnatrice en montagne, elle a un programme établi ou elle est à votre écoute pour répondre à vos demandes personnalisées à la carte."
    ],
    "nl": [
      "Augustine vergezelt je op wandelingen.\r\nAls berggids heeft zij een vast programma of staat zij tot uw beschikking om aan uw individuele wensen te voldoen."
    ],
    "es": [
      "Augustine te acompaña en las excursiones.\r\nComo guía de montaña, tiene un programa establecido o está a su disposición para satisfacer sus necesidades individuales."
    ]
  },
