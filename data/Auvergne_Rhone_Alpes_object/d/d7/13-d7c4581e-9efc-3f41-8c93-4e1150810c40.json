  "rdfs:comment": {
    "de": [
      "Am Fuße der mythischen Face de Bellevarde enthüllt das Centre Aquasportif 5000 m2 spielerisches, belebendes und entspannendes Vergnügen in einem warmen Zen-Rahmen, der vollkommen zur Entspannung einlädt."
    ],
    "en": [
      "At the foot of the legendary Face de Bellevarde, the Aquasportif Center offers 5000 m2 of fun, invigoration and relaxation in a friendly and chilled-out setting that is perfect for winding down."
    ],
    "it": [
      "Ai piedi del mitico Face de Bellevarde, il Centro Aquasportif rivela 5000 m2 di piaceri divertenti, tonificanti e rilassanti in un ambiente zen e caloroso che favorisce totalmente il relax."
    ],
    "fr": [
      "Au pied de la mythique Face de Bellevarde, le Centre Aquasportif dévoile 5000 m2 de plaisirs ludiques, toniques et relaxants dans un cadre zen et chaleureux totalement propice à la détente."
    ],
    "es": [
      "Al pie de la legendaria Face de Bellevarde, el Centre Aquasportif desvela 5.000 m2 de placeres lúdicos, tonificantes y relajantes en un entorno cálido y zen totalmente propicio a la relajación."
    ],
    "nl": [
      "Aan de voet van de legendarische Face de Bellevarde onthult het Centre Aquasportif 5.000 m2 plezier, stimulerend en ontspannend plezier in een warme, zen omgeving die volledig bevorderlijk is voor ontspanning."
    ]
  },
  "rdfs:label": {
