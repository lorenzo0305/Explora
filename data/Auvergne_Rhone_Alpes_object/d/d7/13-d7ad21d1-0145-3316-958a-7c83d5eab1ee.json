  "rdfs:comment": {
    "de": [
      "Genießen Sie eine Gourmetmahlzeit, die von Küchenchef Loïc Picamal zubereitet wird. Hier finden Sie das ganze Jahr über eine große Auswahl an Gourmetgerichten aus frischen, lokalen und saisonalen Produkten. Ein wahrer Genuss für den Gaumen!"
    ],
    "en": [
      "Enjoy a gastronomic meal prepared by the chef Loïc Picamal. All year round, you will find a wide choice of gourmet dishes made with fresh, local and seasonal products. A real pleasure for the taste buds!"
    ],
    "it": [
      "Godetevi un pasto gastronomico preparato dallo chef Loïc Picamal. Tutto l'anno troverete un'ampia scelta di piatti gourmet a base di prodotti freschi, locali e di stagione. Un vero piacere per le papille gustative!"
    ],
    "fr": [
      "Savourez un repas gastronomique élaboré par le chef Loïc Picamal. Retrouvez toute l'année un large choix de mets gourmands à base de produits frais, locaux et de saison. Un vrai plaisir pour les papilles !"
    ],
    "nl": [
      "Geniet van een gastronomische maaltijd bereid door chef-kok Loïc Picamal. Het hele jaar door vindt u er een ruime keuze aan gastronomische gerechten op basis van verse, lokale en seizoensgebonden producten. Een waar genot voor de smaakpapillen!"
    ],
    "es": [
      "Disfrute de una comida gastronómica preparada por el chef Loïc Picamal. Durante todo el año, encontrará una amplia selección de platos gourmet elaborados con productos frescos, locales y de temporada. ¡Un auténtico placer para las papilas gustativas!"
    ]
  },
