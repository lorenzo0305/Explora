  "rdfs:comment": {
    "de": [
      "Das Gabion empfängt Fischliebhaber in einem zugleich erstaunenden wie authentischen Dekor: Kiesel der Rhône an den Wänden, rote und gedämpfte Beleuchtung, eine beruhigende Atmosphäre."
    ],
    "en": [
      "Le Gabion looks forward to welcoming fish lovers in a setting which is as astonishing as it is authentic including walls decorated with pebbles from the Rhône, red, subdued lighting, and a relaxing atmosphere."
    ],
    "it": [
      "Il Gabion accoglie gli amanti del pesce in una decorazione sorprendente e autentica: ciottoli del Rodano sui muri, una illuminazione soffusa sui toni del rosso, un'atmosfera rassicurante."
    ],
    "fr": [
      "Le Gabion accueille les amateurs de poissons dans un décor à la fois étonnant et authentique : aux murs des galets du Rhône, un éclairage rouge et tamisé, une atmosphère rassurante."
    ],
    "es": [
      "Le Gabion recibe a los amantes del pescado en un espacio decorado de forma sorprendente y auténtica al mismo tiempo: paredes cubiertas de guijarros del Ródano, lámparas rojas de luz tenue y una atmósfera reconfortante."
    ],
    "nl": [
      "De Gabion ontvangt visliefhebbers in een decor dat zowel verrassend als authentiek is: de muren bestaan uit kiezelstenen uit de Rhône, de verlichting is rood en gedempt en de sfeer is geruststellend."
    ]
  },
