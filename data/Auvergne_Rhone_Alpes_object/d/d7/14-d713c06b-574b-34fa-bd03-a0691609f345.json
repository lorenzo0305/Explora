  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f6100e84-98dd-357b-86e7-8a946f9bdb40",
      "dc:description": {
        "de": [
          "7 Tage die Woche geöffnet.\nVon 11.00 bis 18.30 Uhr\nParcours mit Rätseln\nNEU: Aufblasbare Struktur\nPonyreiten nach Plan\nAutomat: Gemüse und Geflügel - Schließfächer zur Selbstbedienung 7/7"
        ],
        "en": [
          "Open 7 days a week.\n11:00 a.m. to 6:30 p.m\nEnigma course\nNEW: inflatable structure\nPony rides according to schedule\nDistributor: Vegetables and Poultry - self-service lockers 7/7"
        ],
        "it": [
          "Aperto 7 giorni su 7.\nDalle 11.00 alle 18.30\nPercorso Enigma\nNUOVO: struttura gonfiabile\nPasseggiate con i pony secondo gli orari\nDistributore: verdure e pollame - armadietti self-service 7/7"
        ],
        "fr": [
          "Ouvert  7 jours sur 7.\nDe 11h 00 à 18h30 \nParcours d'énigmes \nNOUVEAU :  structure gonflable \nBalades en poney selon planning \nDistributeur : Légumes et Volailles - casiers libre service 7/7"
        ],
        "es": [
          "Abierto los 7 días de la semana.\nDe 11.00 a 18.30 h\nRecorrido Enigma\nNOVEDAD: estructura hinchable\nPaseos en poni según horario\nDistribuidor: verduras y aves de corral - taquillas de autoservicio 7/7"
        ],
        "nl": [
          "7 dagen per week geopend.\nVan 11.00 tot 18.30 uur\nEnigma parcours\nNIEUW: opblaasbare structuur\nPonyrijden volgens schema\nDistributeur: Groenten en gevogelte - zelfbedieningskluisjes 7/7"
        ]
      },
      "@type": [
        "Description"
