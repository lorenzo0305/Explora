  "rdfs:comment": {
    "de": [
      "Wunderschönes Plateau mit Blick auf die Matheysine. Die Landschaft ist abwechselnd frühlingsgrün, weizengolden und flammend rot und wird Sie wahrscheinlich in Ihrem sportlichen Elan, sich im Vierfüßlerstand zu entwickeln, unterbrechen.\r\nKönigreich der 5 und 6A."
    ],
    "en": [
      "Magnificent place over the Matheysine. Tour after tour green spring, golden like wheat and burning, the lanscape may break you evolution sportive launch .\r\nRealm from 5 to 6A"
    ],
    "it": [
      "Magnifica piattaforma sopra la Matheyine. Sia verde primavera che dorato come i grani e fiambiante, il paessaggio vi togliera nel elancio sportivo in quadrupediea.\r\nReal 5 a 6A."
    ],
    "fr": [
      "Magnifique plateau surplombant la Matheysine. Tour à tour vert printanier, doré comme les blés et flamboyant, le paysage risque de vous couper dans votre élan sportif d'évolution en quadrupédie.\r\nRoyaume du 5 et du 6A."
    ],
    "es": [
      "Una magnífica meseta que domina el Matheysine. Verde primaveral, dorado y flamígero, el paisaje puede detenerle en su avance en cuadrúpedo.\r\nReino de los 5 y 6A."
    ],
    "nl": [
      "Massief : Taillefer - Matheysine\r\nIGN : 3336 OT\r\nOrientation : nord, sud\r\nkalkrots\r\n45 klimwegen\r\nminimale hoogte : 20m\r\nmaximale hoogte : 25 m\r\nCota : 3 tot 6c\r\nType : rotsflanken, V stelling en V spant"
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing spot of Versennat"
    ],
    "it": [
      "Sito arrampicata di Versenat"
    ],
    "fr": [
      "Site d’escalade de Versenat"
    ],
    "nl": [
      "Sportklimgebied \"Versenat\""
    ]
  },
