  "rdfs:comment": {
    "de": [
      "Produzent von Bio-Milch und grünen Bio-Linsen. Verkauf direkt auf dem Bauernhof nach telefonischer Reservierung. Im Sommer auf dem Bauernmarkt in Boisset und von April bis September in Usson en Forez am Sonntagmorgen vertreten."
    ],
    "en": [
      "Producer of organic milk and organic green lentils. On sale directly from the farm by telephone reservation. Present at the farmers' market in Boisset in summer and Usson en Forez from April to September on Sunday mornings."
    ],
    "it": [
      "Produttore di latte biologico e lenticchie verdi biologiche. Vendita diretta in azienda su prenotazione telefonica. Presente al mercato contadino di Boisset in estate e di Usson en Forez da aprile a settembre la domenica mattina."
    ],
    "fr": [
      "Producteur de lait bio et de lentilles vertes bio. En vente directement à la ferme sur réservation par téléphone. Présent sur le marché de producteurs à Boisset en été et Usson en Forez d'avril à septembre le dimanche matin."
    ],
    "es": [
      "Productor de leche ecológica y lentejas verdes ecológicas. Venta directa en la granja previa reserva telefónica. Presente en el mercado agrícola de Boisset en verano y de Usson en Forez de abril a septiembre los domingos por la mañana."
    ],
    "nl": [
      "Producent van biologische melk en biologische groene linzen. Rechtstreeks van de boerderij te koop na telefonische reservering. Aanwezig op de boerenmarkt in Boisset in de zomer en Usson en Forez van april tot september op zondagochtend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec de la Bienvenue"
    ]
  },
