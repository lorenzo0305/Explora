  "rdfs:comment": {
    "de": [
      "Eugène und Geneviève empfangen Sie herzlich in der hübschen Ortschaft Le Falgoux, die sich in das Tal des Mars schmiegt, am Fuße des berühmten Puy Mary....."
    ],
    "en": [
      "Eugène and Geneviève welcome you in a friendly atmosphere in the pretty village of Falgoux nestled in the hollow of the Mars valley, at the foot of the famous Puy Mary…."
    ],
    "it": [
      "Eugène e Geneviève vi accolgono amichevolmente nel grazioso villaggio di Le Falgoux, immerso nella conca della valle del Mars, ai piedi del famoso Puy Mary?"
    ],
    "fr": [
      "Eugène et Geneviève vous accueillent en toute convivialité dans le joli bourg du Falgoux blotti au creux de la vallée du Mars, au pied du célèbre Puy Mary…."
    ],
    "es": [
      "Eugène y Geneviève le dan la bienvenida de forma amistosa al bonito pueblo de Le Falgoux, enclavado en la hondonada del valle de Marte, a los pies del famoso Puy Mary?"
    ],
    "nl": [
      "Eugène en Geneviève ontvangen u in een vriendelijke sfeer in het mooie dorp Le Falgoux, genesteld in de holte van de Marsvallei, aan de voet van de beroemde Puy Mary....."
    ]
  },
