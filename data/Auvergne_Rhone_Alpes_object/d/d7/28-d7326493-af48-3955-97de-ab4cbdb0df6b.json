  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen das ganze Jahr über eine tägliche Anlieferung von Fisch, Muscheln und Krustentieren von den Schiffen aus den Häfen von Boulogne/Mer und Le Tréport."
    ],
    "en": [
      "All year round, we offer a daily supply of fish, shellfish and crustaceans from boats in the ports of Boulogne/Mer and Le Tréport."
    ],
    "it": [
      "Durante tutto l'anno, offriamo una fornitura giornaliera di pesce, molluschi e crostacei provenienti dalle barche dei porti di Boulogne/Mer e Le Tréport."
    ],
    "fr": [
      "Nous vous proposons toute l’année un arrivage quotidien de poissons, coquillages et crustacés issus des bateaux des ports de Boulogne/Mer et du Tréport."
    ],
    "nl": [
      "Het hele jaar door bieden wij dagelijks vis, schaal- en schelpdieren aan vanaf boten in de havens van Boulogne/Mer en Le Tréport."
    ],
    "es": [
      "Durante todo el año, ofrecemos un suministro diario de pescado, marisco y crustáceos procedentes de los barcos de los puertos de Boulogne/Mer y Le Tréport."
    ]
  },
