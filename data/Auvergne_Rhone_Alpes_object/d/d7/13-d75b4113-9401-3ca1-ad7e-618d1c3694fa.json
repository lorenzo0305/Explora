  "rdfs:comment": {
    "de": [
      "Diese Route bietet Ihnen eine neue Art, sich dem Col du Mollard zu nähern, indem Sie eine Reihe von Pisten abseits der ausgetretenen Pfade in einer wilden Atmosphäre wählen."
    ],
    "en": [
      "This itinerary offers a new way of approaching the Col du Mollard via a series of trails, far off the beaten track and in a wilderness setting."
    ],
    "it": [
      "Questo itinerario propone un nuovo modo di avvicinarsi al Col du Mollard attraverso una serie di sentieri, lontano dalle piste battute e in un ambiente selvaggio."
    ],
    "fr": [
      "Cet itinéraire vous propose une nouvelle manière d’aborder le col du Mollard par une série de pistes, loin des sentiers battus dans une ambiance sauvage."
    ],
    "es": [
      "Este itinerario ofrece una nueva forma de acercarse al Col du Mollard a través de una serie de senderos, lejos de los caminos trillados y en un entorno salvaje."
    ],
    "nl": [
      "Deze route biedt een nieuwe manier om de Col du Mollard te benaderen via een reeks paden, ver van de gebaande paden en in een ongerepte omgeving."
    ]
  },
  "rdfs:label": {
    "en": [
