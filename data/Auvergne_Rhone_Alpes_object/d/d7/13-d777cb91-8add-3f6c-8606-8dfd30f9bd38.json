  "rdfs:comment": {
    "de": [
      "Boutique-Bistro des Vereins OPPORTUNITY FOR WOMEN.\r\nSchönes handgemachtes Kunsthandwerk von hier und anderswo.\r\nTapas des Baronnies - Bio-Spezialitäten von lokalen Produzenten. Handwerklich hergestellte Biere, Sodas und Kombuchas. Auswahl an Bio- und Naturweinen aus der Region."
    ],
    "en": [
      "Boutique-Bistrot from the OPPORTUNITY FOR WOMEN association\r\nBeautiful handmade crafts from here and abroad\r\nTapas des Baronnies - organic specialties from local producers. Artisanal beers, sodas and kombuchas. Selection of organic and natural wines from the region."
    ],
    "it": [
      "Boutique-Bistrot dell'associazione OPPORTUNITA' PER LE DONNE\r\nBellissimi prodotti artigianali provenienti da qui e dall'estero\r\nTapas des Baronnies - specialità biologiche di produttori locali. Birre artigianali, bibite e kombuchas. Selezione di vini biologici e naturali della regione."
    ],
    "fr": [
      "Boutique-Bistrot de l'association OPPORTUNITY FOR WOMEN\r\nBel artisanat fait main d'ici et d'ailleurs\r\nTapas des Baronnies - spécialités bio de producteurs locaux. Bières, Sodas et Kombuchas artisanaux. Sélection de vins bio et naturels de la région."
    ],
    "nl": [
      "Boutique-Bistrot van de vereniging OPPORTUNITY FOR WOMEN\r\nPrachtige handgemaakte kunstnijverheid uit binnen- en buitenland\r\nTapas des Baronnies - biologische specialiteiten van lokale producenten. Ambachtelijke bieren, frisdranken en kombuchas. Selectie van biologische en natuurlijke wijnen uit de regio."
    ],
    "es": [
      "Boutique-Bistrot de la asociación OPORTUNIDAD PARA LA MUJER\r\nPreciosa artesanía hecha a mano aquí y en el extranjero\r\nTapas des Baronnies - especialidades ecológicas de productores locales. Cervezas artesanales, refrescos y kombuchas. Selección de vinos ecológicos y naturales de la región."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Yakan le Comptoir"
    ]
  },
