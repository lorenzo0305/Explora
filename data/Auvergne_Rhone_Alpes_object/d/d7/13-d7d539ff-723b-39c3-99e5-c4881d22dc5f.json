  "rdfs:comment": {
    "de": [
      "Mit Freunden, der Familie, zu zweit, im Business, beim Geschäftsessen oder einfach nur auf ein Glas empfängt Sie das Bistrot du Saint Georges.\r\nkellerbuch- Cocktail - Aperitif- Digestif\r\nBrett -Formel Bistrot und Karte Bistrot -Ravieren"
    ],
    "en": [
      "With friends, family, as a duo, for business, a business meal or just for a drink, the Bistrot du Saint Georges welcomes you.\r\nlivre de cave- Cocktail -apéritif- digestif\r\nBistro board and menu -ravioles"
    ],
    "it": [
      "Con gli amici, in famiglia, in coppia, per affari, per un pranzo di lavoro o semplicemente per un drink, il Bistrot du Saint Georges vi accoglie.\r\nlibro di cantina- Cocktail -apéritif- digestif\r\nTavola - formula bistrot e menu bistrot - ravioli"
    ],
    "fr": [
      "Entre amis, en famille, en duo, en business, repas affaires ou juste pour un verre le Bistrot du Saint Georges vous accueille.\r\nlivre de cave- Cocktail -apéritif- digestif\r\nPlanche -formule bistrot et carte bistrot -ravioles"
    ],
    "nl": [
      "Met vrienden, familie, als duo, voor zaken, een zakendiner of gewoon voor een drankje, de Bistrot du Saint Georges heet u welkom.\r\nkelderboek - cocktail - aperitief - digestief\r\nBord - bistroformule en bistromenu - ravioli"
    ],
    "es": [
      "Con amigos, en familia, a dúo, por negocios, una comida de negocios o simplemente para tomar una copa, el Bistrot du Saint Georges le da la bienvenida.\r\nbodega - cóctel - aperitivo - digestivo\r\nTabla - fórmula bistro y menú bistro - ravioli"
    ]
  },
  "rdfs:label": {
