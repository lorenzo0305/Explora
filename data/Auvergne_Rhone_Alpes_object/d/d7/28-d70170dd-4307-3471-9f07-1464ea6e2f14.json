  "rdfs:comment": {
    "de": [
      "In der Brasserie Lounge können Sie sich entspannen. Ihre Geschmacksknospen werden die Gerichte mit regionalen Aromen genießen. Probieren Sie die Spezialität, den Globusburger!"
    ],
    "en": [
      "The brasserie lounge invites you to relax. Your taste buds will savor the dishes with local flavors. Taste the speciality : the globe burger !"
    ],
    "it": [
      "La brasserie lounge vi invita a rilassarvi. Le vostre papille gustative assaporeranno i piatti dai sapori locali. Provate la specialità del globe burger!"
    ],
    "fr": [
      "La brasserie lounge vous propose de vous détendre. Vos papilles savoureront les plats aux saveurs du terroir. Goûtez la spécialité le globe burger !"
    ],
    "es": [
      "El salón de la brasserie le invita a relajarse. Sus papilas gustativas saborearán los platos con sabores locales. Pruebe la especialidad globe burger"
    ],
    "nl": [
      "De brasserie lounge nodigt u uit om te ontspannen. Uw smaakpapillen zullen smullen van de gerechten met lokale smaken. Probeer de specialiteit van de wereldburger!"
    ]
  },
