      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/00820a0c-8350-3c1a-bf65-40d5a7f35c09",
          "schema:validFrom": "2026-12-31T00:00:00",
          "schema:validThrough": "2026-12-30T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Montag, Dienstag, Freitag, Samstag, Sonntag: 12:30 bis 15:50 Uhr\n\nNach telefonischer Voranmeldung. An allen Feiertagen geöffnet. Öffnet sehr leicht abends, morgens für Mâchon, für mindestens 8 Gäste!\nDenken Sie daran, sich die Öffnungszeiten des Bistrot à Jaja anzusehen, gleiche Struktur, andere Öffnungszeiten."
            ],
            "en": [
              "Monday, Tuesday, Friday, Saturday, Sunday: 12:30 to 3:50 p.m\n\nReservations by phone. Open on all public holidays. Easily open evenings and mornings for mâchon, for at least 8 guests!\nDon't forget to check Bistrot à Jaja's opening times, same structure, different hours."
            ],
            "it": [
              "Lunedì, martedì, venerdì, sabato, domenica: dalle 12.30 alle 15.50\n\nPrenotazioni telefoniche. Aperto tutti i giorni festivi. Molto facile da aprire la sera, la mattina per il mâchon, per almeno 8 ospiti!\nNon dimenticate di controllare gli orari di apertura del Bistrot à Jaja, stessa struttura, orari diversi."
            ],
            "fr": [
              "Lundi, Mardi, Vendredi, Samedi, Dimanche : 12h30 à 15h50\n\nSur réservation par téléphone. Ouvert tous les jours fériés. Ouvre très facilement le soir, matin pour mâchon, pour 8 convives au moins !\nPensez à regarder les horaires du Bistrot à Jaja, même structure, horaires différent."
            ],
            "nl": [
              "Maandag, dinsdag, vrijdag, zaterdag, zondag: 12.30 tot 15.50 uur\n\nTelefonisch reserveren. Open op alle feestdagen. Heel gemakkelijk te openen 's avonds, 's ochtends voor mâchon, voor minstens 8 gasten!\nVergeet niet de openingstijden van Bistrot à Jaja te controleren, zelfde structuur, verschillende openingstijden."
            ],
            "es": [
              "Lunes, martes, viernes, sábado y domingo: de 12.30 a 15.50 horas\n\nReservas por teléfono. Abierto todos los días festivos. Muy fácil de abrir por la noche, por la mañana para mâchon, ¡para al menos 8 comensales!\nNo olvide consultar los horarios de apertura del Bistrot à Jaja, misma estructura, diferentes horarios."
            ]
          },
