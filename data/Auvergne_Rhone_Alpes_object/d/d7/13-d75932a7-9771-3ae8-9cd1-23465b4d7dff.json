  "rdfs:comment": {
    "de": [
      "Ideal gelegenes Hotel am Stadtrand von Romans und am Fuße des Vercors. Perfekt für einen Zwischenstopp auf dem Weg in den Urlaub oder für Ihre Geschäftsreisen, in einem warmen Dekor und einer ruhigen Umgebung.\r\nLabels Qualité Tourisme & Hôtel de France"
    ],
    "en": [
      "Ideally located hotel on the outskirts of Romans and at the foot of the Vercors mountains. Perfect for a stopover on the way to your vacation or business trip, in a warm and peaceful setting.\r\nQualité Tourisme & Hôtel de France labels"
    ],
    "it": [
      "Hotel situato in posizione ideale alla periferia di Romans e ai piedi del Vercors. Perfetto per una sosta durante il viaggio verso la meta delle vostre vacanze o per viaggi d'affari, in un ambiente accogliente e tranquillo.\r\nMarchi di qualità Qualité Tourisme & Hôtel de France"
    ],
    "fr": [
      "Hôtel idéalement situé, en périphérie de Romans et au pied du Vercors. Parfait pour une escale sur la route des vacances ou pour vos déplacements professionnels, dans un décor chaleureux et un environnement calme.\r\nLabels Qualité Tourisme & Hôtel de France"
    ],
    "nl": [
      "Ideaal gelegen hotel aan de rand van Rome en aan de voet van de Vercors. Perfect voor een tussenstop op weg naar uw vakantiebestemming of voor zakenreizen, in een warme en rustige omgeving.\r\nQualité Tourisme & Hôtel de France kwaliteitslabels"
    ],
    "es": [
      "Hotel idealmente situado a las afueras de Romans y a los pies del Vercors. Perfecto para hacer una parada de camino a su destino de vacaciones o para viajes de negocios, en un entorno cálido y tranquilo.\r\nSellos de calidad Qualité Tourisme & Hôtel de France"
    ]
  },
