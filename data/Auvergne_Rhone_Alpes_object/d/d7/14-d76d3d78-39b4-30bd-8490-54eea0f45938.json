  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ed3e42c6-cd6d-32d4-9177-df6cea1143f0",
      "dc:description": {
        "de": [
          "Fischgeschäft, spezialisiert auf lokale Bouchot-Muscheln: Fisch / Krustentiere / Muscheln Meeresfrüchte / Delikatessen / lokale Produkte\nWochenenden = Freitag, Samstag, Sonntag und Montag: 9H-12H30 und nachmittags 15h-19h ( außer montags )"
        ],
        "en": [
          "Fishmonger specializing in local Bouchot mussels: fish / shellfish / seafood / delicatessen / local products\nWeekends = Friday, Saturday, Sunday and Monday: 9am-12.30pm and afternoons 3pm-7pm (except Mondays)"
        ],
        "it": [
          "Pescheria specializzata in cozze locali Bouchot: pesce / crostacei / frutti di mare / gastronomia / prodotti locali\nFine settimana = venerdì, sabato, domenica e lunedì: 9.00-12.30 e pomeriggio 15.00-19.00 (tranne il lunedì)"
        ],
        "fr": [
          "Poissonnerie spécialisé dans la moule de bouchot locale : poissons / crustacés / coquillages épicerie de la mer / épicerie fine / produits locaux\nLes week-ends = vendredi, samedi, dimanche et lundi : 9H-12H30 et l'après midi 15h-19h ( sauf le lundi )"
        ],
        "nl": [
          "Visboer gespecialiseerd in lokale Bouchot mosselen: vis / schelpdieren / zeevruchten / delicatessen / lokale producten\nWeekends = vrijdag, zaterdag, zondag en maandag: 9u-12u30 en 's middags 15u-19u (behalve maandag)"
        ],
        "es": [
          "Pescadería especializada en mejillones de Bouchot: pescado / marisco / productos del mar / delicatessen / productos locales\nFines de semana = viernes, sábado, domingo y lunes: de 9:00 a 12:30 y por la tarde de 15:00 a 19:00 (excepto los lunes)"
        ]
      },
