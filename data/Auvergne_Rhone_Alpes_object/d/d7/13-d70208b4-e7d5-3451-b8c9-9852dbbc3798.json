  "rdfs:comment": {
    "de": [
      "Eingebettet im Grünen, am Rande des mittelalterlichen Dorfes Besse en Chandesse, in einer Oase des Friedens und der Stille. Das Hotel Le Clos, das 2023 von Emilie und Eric übernommen wurde, heißt Sie im Sommer wie im Winter herzlich willkommen."
    ],
    "en": [
      "Nestled in the greenery, on the edge of the medieval village of Besse en Chandesse, in a haven of peace and silence."
    ],
    "it": [
      "Immerso nel verde ai margini del borgo medievale di Besse en Chandesse, in un'oasi di pace e silenzio. L'Hôtel Le Clos, rilevato nel 2023 da Emilie ed Eric, vi accoglie sia in estate che in inverno."
    ],
    "fr": [
      "Niché dans la verdure, à l'orée du village médiéval de Besse en Chandesse, dans un havre de paix et de silence. L'Hôtel Le Clos, repris en 2023 par Emilie et Eric, vous accueillent été comme hiver."
    ],
    "nl": [
      "Genesteld in het groen aan de rand van het middeleeuwse dorp Besse en Chandesse, in een oase van rust en stilte. Hôtel Le Clos, in 2023 overgenomen door Emilie en Eric, verwelkomt je zomer en winter."
    ],
    "es": [
      "En medio de la vegetación, en las afueras del pueblo medieval de Besse en Chandesse, en un remanso de paz y silencio. El Hôtel Le Clos, adquirido en 2023 por Emilie y Eric, le da la bienvenida tanto en verano como en invierno."
    ]
  },
  "rdfs:label": {
