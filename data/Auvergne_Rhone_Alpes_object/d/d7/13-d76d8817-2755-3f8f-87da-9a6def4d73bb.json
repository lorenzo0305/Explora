  "rdfs:comment": {
    "de": [
      "Angehende Ermittler, Liebhaber kleiner Wanderungen, begeisterte Anhänger der Via Fluvia, dieses Spiel ist für Sie! Diese Schatzsuche führt Sie zwischen Champagne und Serrière, um die Ufer der Rhône und die Via Fluvia zu entdecken."
    ],
    "en": [
      "Whether you're a budding investigator, a keen hiker or a Via Fluvia enthusiast, this game is for you! This treasure hunt will take you from Champagne to Serrière to discover the banks of the Rhône and the Via Fluvia."
    ],
    "it": [
      "Se siete investigatori in erba, appassionati di trekking o di Via Fluvia, questo gioco fa per voi! Questa caccia al tesoro vi porterà dalla Champagne alla Serrière per scoprire le rive del Rodano e la Via Fluviale."
    ],
    "fr": [
      "Enquêteurs en herbe, amateurs de petite randonnée, fervent pratiquants de la Via Fluvia, ce jeu est pour vous ! Cette chasse aux trésors vous emmènera entre Champagne et Serrière afin de découvrir les berges du Rhône et la Via Fluvia."
    ],
    "es": [
      "Si es un investigador en ciernes, un senderista entusiasta o un apasionado de la Vía Fluvial, ¡este juego es para usted! Esta búsqueda del tesoro le llevará de Champagne a Serrière para descubrir las orillas del Ródano y la Vía Fluvia."
    ],
    "nl": [
      "Of je nu een aankomend onderzoeker, een fervent wandelaar of een Via Fluvia liefhebber bent, dit spel is voor jou! Deze speurtocht brengt je van Champagne naar Serrière om de oevers van de Rhône en de Via Fluvia te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fun bike tour N°6: The spell of the Via Fluvia and the banks of the Rhône"
    ],
    "fr": [
      "Enquête ludique à vélo N°6 : Le sortilège de la Via Fluvia et des berges du Rhône"
    ]
  },
