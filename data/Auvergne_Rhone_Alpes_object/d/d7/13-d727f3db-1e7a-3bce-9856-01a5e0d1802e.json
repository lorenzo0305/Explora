  "rdfs:comment": {
    "de": [
      "Restaurant Grill House in Valfréjus: Das Versprechen einer geselligen und atypischen Mahlzeit in einer finnischen Kota inmitten der Natur.\r\nEin ungewöhnlicher, intimer und kuscheliger Ort.\r\nEine kleine Rückkehr zur Einfachheit und Authentizität."
    ],
    "en": [
      "Grill House Restaurant in Valfréjus. The promise of a friendly and atypical meal in our Finnish wilderness Kota. An unusual place, intimidating and cocooning. A small return to simplicity and authenticity."
    ],
    "it": [
      "Ristorante Grill House a Valfréjus: la promessa di un pasto conviviale e insolito in una Kota finlandese nel cuore della natura.\r\nUn luogo insolito, intimo e accogliente.\r\nUn ritorno alla semplicità e all'autenticità."
    ],
    "fr": [
      "Restaurant Grill House à Valfréjus : la promesse d’un repas convivial et atypique dans un Kota finlandais en pleine nature. \r\nUn lieu insolite, intimiste et cocooning. \r\nUn petit retour à la simplicité et à l’authenticité."
    ],
    "es": [
      "Restaurante Grill House en Valfréjus: la promesa de una comida convivial e insólita en una Kota finlandesa en plena naturaleza.\r\nUn lugar insólito, íntimo y acogedor.\r\nUna vuelta a la sencillez y la autenticidad."
    ],
    "nl": [
      "Herstel Steakhouse huis naar Valfréjus. De belofte van een vriendelijke en atypische maaltijd in onze Finse Kota in de middle of nowhere. Een ongewone, intimistisch en cocooning. Een kleine terug in de eenvoud en de authenticiteit."
    ]
  },
