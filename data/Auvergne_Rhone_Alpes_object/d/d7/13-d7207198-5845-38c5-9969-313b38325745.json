  "rdfs:comment": {
    "de": [
      "Biologin und Naturheilpraktikerin, Begleiterin für natürliche Gesundheit. Christine ist Spezialistin für Heilpflanzen und bietet Ihnen individuelle Beratungen und Gesundheitsworkshops zur Vorbeugung, Behandlung und Heilung an."
    ],
    "en": [
      "Naturopathic biologist, natural health coach. Christine, a specialist in medicinal plants, offers individual consultations and health workshops to help prevent, treat and heal."
    ],
    "it": [
      "Biologa naturopata e coach di salute naturale. Christine è specializzata in piante medicinali e offre consulenze individuali e seminari sulla salute per aiutarvi a prevenire, curare e guarire."
    ],
    "fr": [
      "Biologiste naturopathe, accompagnatrice en santé naturelle. Christine spécialiste des plantes médicinales,  vous propose des consultations en individuel et des ateliers santé pour prévenir, soigner et guérir."
    ],
    "nl": [
      "Natuurgeneeskundig bioloog en natuurlijk gezondheidscoach. Christine is gespecialiseerd in geneeskrachtige planten en biedt één-op-één consulten en gezondheidsworkshops om je te helpen voorkomen, behandelen en genezen."
    ],
    "es": [
      "Bióloga naturópata y coach de salud natural. Christine está especializada en plantas medicinales y ofrece consultas individuales y talleres de salud para ayudarle a prevenir, tratar y curar."
    ]
  },
  "rdfs:label": {
