  "rdfs:comment": {
    "de": [
      "Handwerklich hergestellte Pizzas aus frischen und lokalen Produkten, Spezialitäten aus Bessans: Farçi de Bessans, Raclette, Tartiflette, Croziflette, Matouille, Fondue... Mindestens 1 Stunde im Voraus bestellen (8h-13h/14h30-20h30)."
    ],
    "en": [
      "Homemade pizzas made with fresh local produce, Bessans specialties: farçi de Bessans, raclette, tartiflette, croziflette, matouille, fondue... order at least 1 hour in advance (8am-1pm/14.30pm-8.30pm)."
    ],
    "it": [
      "Pizze fatte in casa con prodotti freschi locali, specialità di Bessans: farçi de Bessans, raclette, tartiflette, croziflette, matouille, fondue... da ordinare con almeno 1 ora di anticipo (8-13/14.30-20.30)."
    ],
    "fr": [
      "Pizzas artisanales à base de produits frais et locaux, spécialités bessannaises : farçi de Bessans, raclette, tartiflette, croziflette, matouille, fondue... à commander au minimum 1h à l'avance (8h-13h/14h30-20h30)."
    ],
    "es": [
      "Pizzas caseras elaboradas con productos frescos de la región, especialidades de Bessans: farçi de Bessans, raclette, tartiflette, croziflette, matouille, fondue... que deben encargarse con al menos 1 hora de antelación (de 8:00 a 13:00 y de 14:30 a 20:30)."
    ],
    "nl": [
      "Huisgemaakte pizza's met verse streekproducten, specialiteiten uit Bessans: farçi de Bessans, raclette, tartiflette, croziflette, matouille, fondue... ten minste 1 uur van tevoren te bestellen (8.00-1.00/14.30-8.30)."
    ]
  },
  "rdfs:label": {
