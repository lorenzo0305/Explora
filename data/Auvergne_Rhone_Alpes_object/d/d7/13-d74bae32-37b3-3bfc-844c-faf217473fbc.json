  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Marie-Madeleine wurde 1872 fertiggestellt und weist eine schöne architektonische Einheit auf. Sie beherbergt ein Ensemble von 7 Gemälden des Malers Daniel Sarrabat, die Maria Magdalena, der Schutzpatronin der Gemeinde, gewidmet sind\r\nBesichtigungen für Gruppen nach Vereinbarung."
    ],
    "en": [
      "Completed in 1872, the Church of Saint Mary Magdalene presents a beautiful architectural unity. It houses a set of 7 paintings by the painter Daniel Sarrabat, dedicated to Mary Magdalene, patron saint of the town.\r\nVisits for groups by appointment."
    ],
    "it": [
      "Completata nel 1872, la chiesa di Saint Marie-Madeleine è un bell'esempio di unità architettonica. Ospita 7 dipinti di Daniel Sarrabat, dedicati a Maria Maddalena, patrona del comune\r\nVisite di gruppo su appuntamento."
    ],
    "fr": [
      "Achevée en 1872, l'Eglise  Saint Marie-Madeleine présente une belle unité architecturale. Elle abrite un ensemble de 7 toiles du peintre Daniel Sarrabat, consacrées à Marie-Madeleine, patrone de la commune\r\nVisites pour les groupes sur RDV."
    ],
    "es": [
      "Terminada en 1872, la iglesia de Santa María Magdalena es un bello ejemplo de unidad arquitectónica. Alberga 7 cuadros de Daniel Sarrabat, dedicados a María Magdalena, patrona del municipio\r\nVisitas en grupo con cita previa."
    ],
    "nl": [
      "De kerk Saint-Marie-Madeleine werd in 1872 voltooid en is een mooi voorbeeld van architectonische eenheid. Er hangen 7 schilderijen van Daniel Sarrabat, gewijd aan Maria Magdalena, de beschermheilige van de gemeente\r\nGroepsbezoeken op afspraak."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church \"Sainte-Marie Madeleine\""
    ],
    "fr": [
      "Église \"Sainte Marie-Madeleine\""
    ]
  },
