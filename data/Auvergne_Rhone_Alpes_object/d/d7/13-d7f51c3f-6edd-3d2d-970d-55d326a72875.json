  "rdfs:comment": {
    "de": [
      "Die Domaine des Ayards in der AOP Grignan-les-Adhémar ist ein junges Weingut, das sich dem biologischen Weinbau verschrieben hat. Besichtigung und Verkostung auf dem Bauernhof, an einem Ort voller Charme. Verkauf von Wein, ätherischem Lavandinöl und Trüffeln."
    ],
    "en": [
      "Domaine des Ayards, located in the Grignan-les-Adhémar PDO, is a young winegrowing estate committed to organic viticulture. Visit and taste at the farm, in a charming setting. Sale of wine, lavandin essential oil and truffles."
    ],
    "it": [
      "Il Domaine des Ayards, situato nella DOP Grignan-les-Adhémar, è una giovane azienda vitivinicola impegnata nella viticoltura biologica. Visita e degustazione in azienda, in un ambiente incantevole. Vendita di vino, olio essenziale di lavandina e tartufi."
    ],
    "fr": [
      "Le Domaine des Ayards, situé en AOP Grignan-les-Adhémar, est un jeune domaine viticole engagé en viticulture biologique. Visite et dégustation à la ferme, dans un lieu plein de charme. Vente de vin, huile essentielle de lavandin et de truffes."
    ],
    "nl": [
      "Het Domaine des Ayards, gelegen in de BOB Grignan-les-Adhémar, is een jong wijndomein dat zich inzet voor biologische wijnbouw. Bezoek en proeverij op de boerderij, in een charmant kader. Verkoop van wijn, etherische olie van lavandin en truffels."
    ],
    "es": [
      "El Domaine des Ayards, situado en la DOP Grignan-les-Adhémar, es una joven explotación vitícola comprometida con la viticultura ecológica. Visita y degustación en la explotación, en un marco encantador. Venta de vino, aceite esencial de lavandín y trufas."
    ]
  },
  "rdfs:label": {
