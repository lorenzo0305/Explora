  "rdfs:comment": {
    "de": [
      "Wandermonat in den Schluchten der Loire. Wanderurlaub entlang des GR 3, täglich wechselnde Termine den ganzen Oktober über: Mykolorando, singende Wanderung, Feinschmeckerwanderung, Naturbeobachtung - das Programm 2026 verspricht erlebnisreich zu werden"
    ],
    "en": [
      "Hiking month in the Loire Gorges. An itinerant trip along the GR 3, with a variety of events every day throughout October: mycolorando, singing hikes, gourmet walks, nature observation, the 2026 program promises to be full of emotion"
    ],
    "it": [
      "Mese dell'escursionismo nelle Gole della Loira. Un viaggio itinerante lungo il GR3, con una varietà di attività ogni giorno per tutto il mese di ottobre: micolando, escursioni canore, passeggiate gastronomiche, osservazione della natura - il programma 2026 si preannuncia entusiasmante"
    ],
    "fr": [
      "Mois de la rando dans les Gorges de la Loire. Séjour itinérant le long du GR 3, rendez-vous variés chaque jour tout le mois d'octobre : mycolorando, rando chantante, balade gourmande, observation de la nature, le programme 2026 s'annonce riche en émotions"
    ],
    "nl": [
      "Wandelmaand in de Gorges de la Loire. Een rondtrekkende tocht over de GR3, met elke dag in oktober verschillende activiteiten: mycolorando, zangwandelingen, gastronomische wandelingen, natuurobservatie - het programma van 2026 belooft een boeiend programma te worden"
    ],
    "es": [
      "Mes del senderismo en las Gargantas del Loira. Un viaje itinerante a lo largo del GR3, con actividades variadas todos los días durante todo el mes de octubre: mycolorando, caminatas cantadas, paseos gastronómicos, observación de la naturaleza... el programa de 2026 promete ser apasionante"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Octobre, le mois de la Randonnée"
    ]
  },
