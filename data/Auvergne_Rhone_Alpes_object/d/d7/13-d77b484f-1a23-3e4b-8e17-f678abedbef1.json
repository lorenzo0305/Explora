  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich im Herzen von Saurier, einem Dorf, das wegen seiner mittelalterlichen Brücke über die Couze Pavin fotografiert wurde. Nicht weit vom Pic de Brionnet, einem der schönsten Panoramen auf das Vulkanmassiv Sancy, entfernt."
    ],
    "en": [
      "The restaurant is located in the heart of Saurier, a village photographed for its medieval bridge over the Couze Pavin. Not far from the Pic de Brionnet, one of the most beautiful panoramas on the volcanic massif of Sancy."
    ],
    "it": [
      "Il ristorante si trova nel cuore di Saurier, un villaggio famoso per il suo ponte medievale sul Couze Pavin. Non lontano dal Pic de Brionnet, una delle più belle viste sul massiccio vulcanico di Sancy."
    ],
    "fr": [
      "Le restaurant est situé au cœur de Saurier, village photographié pour son pont médiéval au-dessus de la Couze Pavin. Non loin du Pic de Brionnet, l'un des plus beaux panoramas sur le massif volcanique du Sancy."
    ],
    "nl": [
      "Het restaurant ligt in het hart van Saurier, een dorp dat beroemd is om zijn middeleeuwse brug over de Couze Pavin. Niet ver van de Pic de Brionnet, een van de mooiste uitzichten op het vulkaanmassief van Sancy."
    ],
    "es": [
      "El restaurante está situado en el corazón de Saurier, un pueblo famoso por su puente medieval sobre el Couze Pavin. No muy lejos del Pic de Brionnet, una de las más bellas vistas del macizo volcánico de Sancy."
    ]
  },
  "rdfs:label": {
    "fr": [
