  "rdfs:comment": {
    "de": [
      "Restaurant, das auf Hühnchen spezialisiert ist: Tacos, gebratenes Hühnchen, Burger, Tapas, Pokes, Salate, Sandwiches, Pommes frites... Sie können sich in einem Raum im Obergeschoss niederlassen."
    ],
    "en": [
      "Restaurant specializing in chicken: tacos, fried chicken, burgers, tapas, pokes, salads, sandwiches, fries... You can sit down in a room upstairs."
    ],
    "it": [
      "Ristorante specializzato in pollo: tacos, pollo fritto, hamburger, tapas, pokes, insalate, panini, patatine, ecc. È possibile sedersi in una sala al piano superiore."
    ],
    "fr": [
      "Restaurant spécialisé dans le poulet : tacos, poulet frit, burgers, tapas, pokes, salades, sandwichs, frites... Vous pourrez vous installer dans une salle à l’étage."
    ],
    "es": [
      "Restaurante especializado en pollo: tacos, pollo frito, hamburguesas, tapas, pinchos, ensaladas, bocadillos, patatas fritas, etc. Puedes sentarte en una sala en el piso de arriba."
    ],
    "nl": [
      "Restaurant gespecialiseerd in kip: taco's, gebakken kip, burgers, tapas, pokes, salades, broodjes, friet, enz. Je kunt boven in een ruimte gaan zitten."
    ]
  },
