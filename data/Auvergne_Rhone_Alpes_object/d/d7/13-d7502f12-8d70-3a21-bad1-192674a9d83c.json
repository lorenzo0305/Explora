  "rdfs:comment": {
    "de": [
      "Gemütliches Bistro. Familienküche mit frischen und lokalen Produkten. Unter der Woche bieten wir Ihnen ein Mittagsmenü an, am Abend und am Wochenende eine Karte mit Salaten, Burgern und Grillgerichten, die Spezialität unseres Küchenchefs."
    ],
    "en": [
      "Friendly bistro. Family cuisine based on fresh and local products. We offer, during the week, lunch, a menu of the day; evenings and weekends, a menu composed of salads, burgers and grills, the specialty of our chef."
    ],
    "it": [
      "Bistrot accogliente. Cucina casalinga con prodotti freschi locali. Offriamo un menu del giorno a pranzo durante la settimana e un menu gourmet la sera e nei fine settimana!"
    ],
    "fr": [
      "Bistrot convivial. Cuisine familiale à base de produits frais et locaux. Nous vous proposons, en semaine, les midis, un menu du jour;  soirs et les week-ends un carte gourmande !!!"
    ],
    "nl": [
      "Vriendelijke bistro. Huiselijke keuken met verse, lokale producten. Doordeweeks bieden we een dagmenu voor de lunch en 's avonds en in het weekend een menu met salades, hamburgers en gegrild vlees, de specialiteit van onze chef."
    ],
    "es": [
      "Bistro acogedor. Cocina casera con productos frescos de la zona. Ofrecemos un menú del día a mediodía durante la semana y un menú gourmet por la noche y los fines de semana"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Central"
    ]
  },
