  "rdfs:comment": {
    "de": [
      "Die GAEC des Gentianes ist ein Bauernhof mit 60 Milchkühen, Laurie und Rémi produzieren Bio-Milch. Verarbeitungsworkshops (Faselle oder Butter), Organisation von Geburtstagen oder 'Aperitif'-Besuchen, Entdeckung von Kühen, Ziegen, Schafen und Schweinen."
    ],
    "en": [
      "The GAEC des Gentianes is a 60-cow dairy farm where Laurie and Rémi produce organic milk. Processing workshops (faisselles or butter), organization of birthday parties or 'aperitif' visits, discovery of cows, goats, sheep and pigs."
    ],
    "it": [
      "Il GAEC des Gentianes è un'azienda agricola con 60 mucche da latte. Laurie e Rémi producono latte biologico. Laboratori di trasformazione (faisselles o burro), organizzazione di compleanni o visite \"aperitivo\", scoperta di mucche, capre, pecore e maiali."
    ],
    "fr": [
      "Le GAEC des Gentianes est une ferme de 60 vaches laitières, Laurie et Rémi produisent du lait bio. Ateliers transformation (faisselles ou beurre), organisation d'anniversaire ou visites 'apéritif', découverte des vaches, chèvres, moutons, cochons."
    ],
    "es": [
      "El GAEC des Gentianes es una granja con 60 vacas lecheras. Laurie y Rémi producen leche ecológica. Talleres de transformación (faisselles o mantequilla), organización de cumpleaños o visitas \"aperitivo\", descubrimiento de vacas, cabras, ovejas y cerdos."
    ],
    "nl": [
      "De GAEC des Gentianes is een boerderij met 60 melkkoeien. Laurie en Rémi produceren biologische melk. Verwerkingsworkshops (faisselles of boter), organisatie van verjaardagen of 'aperitief'-bezoeken, ontdekking van koeien, geiten, schapen en varkens."
    ]
  },
