  "rdfs:comment": {
    "de": [
      "6H55 Mouvement Moutonneux ist eine engagierte Marke aus dem Departement Haute-Loire, die Bettwaren aus Schafwolle anbietet, die aus lokaler Zucht stammen und handwerklich hergestellt werden, um eine gesündere und natürlichere Alternative zu bieten."
    ],
    "en": [
      "6H55 Mouvement Moutonneux is a committed brand based in the Haute-Loire region of France, offering bedding made from sheep?s wool sourced from local farms and handcrafted for a healthier, more natural alternative."
    ],
    "it": [
      "6H55 Mouvement Moutonneux è un marchio impegnato, con sede nella regione francese dell'Alta Loira, che offre biancheria da letto in lana di pecora proveniente da allevamenti locali, prodotta con metodi tradizionali per un'alternativa più sana e naturale."
    ],
    "fr": [
      "6H55 Mouvement Moutonneux est une marque engagée, installée en Haute-Loire qui propose des articles de literie en Laine de mouton issus d’élevages locaux et fabriqués de manières artisanales, pour une alternative plus saine et plus naturelle."
    ],
    "nl": [
      "6H55 Mouvement Moutonneux is een toegewijd merk, gevestigd in de Haute-Loire regio in Frankrijk, dat beddengoed aanbiedt gemaakt van schapenwol van lokale boerderijen, geproduceerd volgens traditionele methoden voor een gezonder, natuurlijker alternatief."
    ],
    "es": [
      "6H55 Mouvement Moutonneux es una marca comprometida, con sede en la región francesa del Alto Loira, que ofrece ropa de cama de lana de oveja procedente de granjas locales, producida con métodos tradicionales para una alternativa más sana y natural."
    ]
  },
