  "rdfs:comment": {
    "de": [
      "Um auf den Gipfel der Pisten zu gelangen, das Panorama über das Arve-Tal zu bewundern, eine Kostprobe von der Alm zu nehmen oder sogar den Mont-Blanc zu sehen, bringt Sie die Gondelbahn im Sommer wie im Winter auf den Gipfel."
    ],
    "en": [
      "Access to the DH mountain bike trails, hike or bike trails, paragliding, admire the stunning views of the Arve valley, have a break at the Airon pasture or else admire the Mont Blanc, the telecabine transports ou."
    ],
    "it": [
      "Per raggiungere la cima delle piste, per ammirare il panorama della valle dell'Arve, per gustare gli alpeggi o per vedere il Monte Bianco, la funivia vi porta in cima sia in estate che in inverno."
    ],
    "fr": [
      "Pour accéder au sommet des pistes, admirer le panorama sur la vallée de l'Arve, goûter à l'alpage ou bien encore pour voir le Mont-Blanc, la télécabine vous transporte au sommet en été comme en hiver."
    ],
    "es": [
      "Para llegar a la cima de las pistas, admirar el panorama del valle del Arve, degustar los pastos de montaña o ver el Mont-Blanc, el teleférico le lleva a la cima tanto en verano como en invierno."
    ],
    "nl": [
      "Om de top van de pistes te bereiken, het panorama van het Arve-dal te bewonderen, de bergweiden te proeven of de Mont-Blanc te zien, brengt de kabelbaan u zowel in de zomer als in de winter naar de top."
    ]
  },
  "rdfs:label": {
    "en": [
