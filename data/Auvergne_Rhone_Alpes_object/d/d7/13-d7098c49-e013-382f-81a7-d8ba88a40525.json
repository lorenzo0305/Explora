  "rdfs:comment": {
    "de": [
      "Geschäft von lokalen Designern: Nähen, Illustrationen, Tasche, Magnete, Schlüsselanhänger, Kerzen, Raumduft, Blumendeko, Kekse, Holzschmuck,... Die Artikel ändern regelmäßig, da die Designer über einen Zeitraum von 34Monaten ausstellen."
    ],
    "en": [
      "Shop of local designers: sewing, illustrations, bag, magnets, key rings, candles, perfume, floral decor, biscuits, wooden jewelry,... The articles rotate regularly because the creators exhibit on periods of 4 months."
    ],
    "it": [
      "Negozio di designer locali: cucito, illustrazioni, borse, magneti, portachiavi, candele, profumi per la casa, decorazioni floreali, biscotti, gioielli in legno, ecc. Gli articoli vengono ruotati regolarmente e i designer espongono a cicli di 4 mesi."
    ],
    "fr": [
      "Boutique de créateurs locaux : couture, illustrations, sac, magnets, porte clés, bougies, parfum d'ambiance, déco florales, biscuits, bijoux en bois,... Les articles tournent régulièrement car les créateurs exposent sur des cycles de 4 mois."
    ],
    "nl": [
      "Winkel voor lokale ontwerpers: naaiwerk, illustraties, tassen, magneten, sleutelhangers, kaarsen, huisparfums, bloemdecoraties, koekjes, houten sieraden, enz. Items worden regelmatig gerouleerd, met ontwerpers die in een cyclus van 4 maanden exposeren."
    ],
    "es": [
      "Tienda de diseñadores locales: costura, ilustraciones, bolsos, imanes, llaveros, velas, fragancias para el hogar, adornos florales, galletas, bisutería de madera, etc. Los artículos rotan regularmente, y los diseñadores exponen en ciclos de 4 meses."
    ]
  },
