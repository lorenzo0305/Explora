  "rdfs:comment": {
    "de": [
      "Konzerte, Emotionen, Bewusstseinsbildung: Content Content ist mehr als ein einfaches Festival. Die fünfte Ausgabe steht ganz im Zeichen musikalischer Entdeckungen (Pop, Rock und Elektro) und stellt die aufstrebende französische Szene in den Vordergrund."
    ],
    "en": [
      "Concerts, emotions, awareness: Content Content is much more than just a festival. This fifth edition is all about musical discovery (pop, rock and electro), with the spotlight on the emerging French scene."
    ],
    "it": [
      "Concerti, emozioni, consapevolezza: Content Content è molto più di un semplice festival. Questa quinta edizione è all'insegna delle scoperte musicali (pop, rock ed electro) e mette in luce la scena francese emergente."
    ],
    "fr": [
      "Concerts, émotions, prises de conscience : le Content Content, c’est bien plus qu’un simple festival. Cette cinquième édition sera placée sous le signe de la découverte musicale (pop, rock et électro) et met à l’honneur la scène émergente française."
    ],
    "es": [
      "Conciertos, emociones, concienciación: Content Content es mucho más que un festival. Esta quinta edición se centra en los descubrimientos musicales (pop, rock y electro) y pone de relieve la escena emergente francesa."
    ],
    "nl": [
      "Concerten, emoties, bewustwording: Content Content is veel meer dan zomaar een festival. Deze vijfde editie staat in het teken van muzikale ontdekkingen (pop, rock en electro) en zet de opkomende Franse scene in de schijnwerpers."
    ]
  },
  "rdfs:label": {
