  "rdfs:comment": {
    "de": [
      "Verleih/Verkauf von Fahrrädern mit Elektro-/Muskelunterstützung. Marke RAYVOLT: retro-futuristischer Look, Originalität, Qualität, Spitzentechnologie IRBS, französisches Design, Reichweite 80 km. Mietpark mit ca. 15 Fahrrädern. In der Nähe der Dolce Via gelegen."
    ],
    "en": [
      "Electric bikes for hire and for sale. RAYVOLT brand: retro-futurist look, originality, quality, latest technology, 80km battery autonomy. \r\n15 bikes available. Easy access to the popular Dolce Via cycle path."
    ],
    "it": [
      "Noleggio/vendita di biciclette elettriche/di assistenza muscolare. Marchio RAYVOLT: look retro-futuristico, originalità, qualità, tecnologia IRBS all'avanguardia, design francese, autonomia di 80 km. Flotta a noleggio di circa 15 biciclette. Situato vicino alla Dolce Via."
    ],
    "fr": [
      "Location/vente de vélos à assistance électrique/musculaire. Marque RAYVOLT : look rétro-futuriste, originalité, qualité, technologie de pointe IRBS, conception française, autonomie 80 km. Parc locatif d'environ 15 vélos. Situé à proximité de la Dolce Via."
    ],
    "nl": [
      "Verhuur/verkoop van elektrische/spierondersteunende fietsen. Merk RAYVOLT: retro-futuristische look, originaliteit, kwaliteit, ultramoderne IRBS-technologie, Frans design, actieradius van 80 km. Verhuurvloot van ongeveer 15 fietsen. Dichtbij de Dolce Via."
    ],
    "es": [
      "Alquiler y venta de bicicletas eléctricas y de asistencia muscular. Marca RAYVOLT: estética retrofuturista, originalidad, calidad, tecnología IRBS de última generación, diseño francés, autonomía de 80 km. Flota de alquiler de unas 15 bicicletas. Situado cerca de la Dolce Via."
    ]
  },
