  "rdfs:comment": {
    "de": [
      "Direkt hinter der Kathedrale Notre Dame, im Zentrum von Bourg en Bresse, ist Butin ein gemischtes Projekt mit Schwerpunkt auf lokalen Produkten, das von einem handwerklichen und lokalen Sandwichladen getragen wird, an den sich ein Feinkostladen und ein Weinkeller anschließt."
    ],
    "en": [
      "Just behind Notre Dame Co-Cathedral, Butin is a mixed-use project, featuring a local, artisanal sandwich shop with a delicatessen and wine cellar."
    ],
    "it": [
      "Situato dietro la Concattedrale di Notre Dame, nel centro di Bourg en Bresse, il Butin è un progetto a uso misto incentrato sui prodotti locali, con una paninoteca tradizionale, una gastronomia e una cantina."
    ],
    "fr": [
      "Juste derrière la Co-cathédrale Notre Dame, en plein centre de Bourg en Bresse, Butin est un projet mixte centré sur les produits locaux, porté par une sandwicherie artisanale et locale à laquelle s’adosse une partie épicerie fine et cave à vins."
    ],
    "nl": [
      "Vlak achter de Notre Dame-kathedraal, in het centrum van Bourg en Bresse, is Butin een ontwikkeling voor gemengd gebruik met de nadruk op lokale producten, met een lokale, traditionele broodjeszaak en een delicatessenzaak en wijnkelder."
    ],
    "es": [
      "Justo detrás de la concatedral de Notre Dame, en el centro de Bourg en Bresse, Butin es un proyecto de uso mixto centrado en los productos locales, con una bocatería tradicional, una tienda de delicatessen y una bodega."
    ]
  },
  "rdfs:label": {
    "en": [
      "Butin - traditional sandwich shop"
    ],
    "fr": [
      "Butin - sandwicherie artisanale"
    ]
  },
