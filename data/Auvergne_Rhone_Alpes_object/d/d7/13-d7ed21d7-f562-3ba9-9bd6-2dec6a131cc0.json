  "rdfs:comment": {
    "de": [
      "Der Kreuzweg von Valchevrière ist eine Gruppe von Ädikulen, die alle 500 Meter entlang der Straße nach Bois Barbu (später Straße nach Herbouilly) errichtet wurden, vom Kreisverkehr der D 215c bis zur Kapelle im Weiler Valchevrière."
    ],
    "en": [
      "The Valchevrière Way of the Cross is a series of aediculae built every 500 meters along the Bois Barbu road (then the Herbouilly road), from the D 215c traffic circle to the chapel in the hamlet of Valchevrière."
    ],
    "it": [
      "La Via Crucis di Valchevrière è una serie di edicole costruite ogni 500 metri lungo la strada del Bois Barbu (poi strada di Herbouilly), dalla rotonda D 215c alla cappella della frazione di Valchevrière."
    ],
    "fr": [
      "Le chemin de croix de Valchevrière est un ensemble d'édicules édifiés tous les 500 mètres le long de la route de Bois Barbu (puis route d'Herbouilly),  depuis le rond-point de la D 215c jusqu'à la chapelle du hameau de Valchevrière."
    ],
    "es": [
      "El Vía Crucis de Valchevrière es una serie de edículos construidos cada 500 metros a lo largo de la carretera de Bois Barbu (luego carretera de Herbouilly), desde la rotonda D 215c hasta la capilla de la aldea de Valchevrière."
    ],
    "nl": [
      "De kruisweg van Valchevrière is een reeks aediculae die om de 500 meter zijn gebouwd langs de weg van Bois Barbu (toen de weg van Herbouilly), vanaf de rotonde D 215c tot aan de kapel in het gehucht Valchevrière."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chemin de croix de Valchevrière"
    ]
  },
