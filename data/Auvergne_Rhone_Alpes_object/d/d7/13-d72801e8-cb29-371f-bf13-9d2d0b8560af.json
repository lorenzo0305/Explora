  "rdfs:comment": {
    "de": [
      "Klettern Sie in dieser neuen Kletterhalle in Le Fayet, im Herzen des Pays du Mont Blanc. Eine Halle mit Bouldern und Routen bis zu 15 m Höhe, die für alle und das ganze Jahr über geöffnet ist. Ein echtes Basislager für Kletterer!"
    ],
    "en": [
      "Come and climb in this new climbing gym in Le Fayet, in the heart of the Mont Blanc region. A climbing gym with boulders and routes up to 15 m high, open to all all year round. A real base camp for climbers!"
    ],
    "it": [
      "Venite ad arrampicare in questa nuova palestra di arrampicata a Le Fayet, nel cuore della regione del Monte Bianco. Una palestra di arrampicata con massi e vie fino a 15 m di altezza, aperta a tutti tutto l'anno. Un vero e proprio campo base per gli scalatori!"
    ],
    "fr": [
      "Venez grimper dans cette nouvelle salle d'escalade située au Fayet, au cœur du Pays du Mont Blanc. Une salle de blocs et de voies jusqu'à 15 m de hauteur, ouverte à tous et toute l'année. Un véritable camp de base pour les grimpeurs !"
    ],
    "es": [
      "Venga a escalar a este nuevo rocódromo de Le Fayet, en el corazón del Mont Blanc. Un rocódromo con bloques y vías de hasta 15 m de altura, abierto a todos durante todo el año. Un auténtico campamento base para escaladores"
    ],
    "nl": [
      "Kom klimmen in deze nieuwe klimzaal in Le Fayet, in het hart van de Mont Blanc-regio. Een klimzaal met boulders en routes tot 15 m hoog, het hele jaar door toegankelijk voor iedereen. Een echt basiskamp voor klimmers!"
    ]
  },
