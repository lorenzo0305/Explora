  "rdfs:comment": {
    "de": [
      "In diesem Wasserpark, der Entspannungsbecken, Sportbecken, Spiel- und Wellnessbereich vereint, können Sie angenehme Momente mit der Familie oder mit Freunden verbringen!"
    ],
    "en": [
      "This aquatic space combining swimming pool, play area and well being will allow you to spend pleasant moments of sharing and relaxation with family or friends."
    ],
    "it": [
      "Questa area acquatica combina una piscina per il relax, una piscina sportiva, un'area giochi e un'area benessere, per trascorrere del tempo di qualità con la famiglia o gli amici!"
    ],
    "fr": [
      "Cet espace aquatique alliant bassin détente, bassin sportif, espace ludique et bien-être vous permettra de passer d’agréables moments en famille ou entre amis !"
    ],
    "es": [
      "Esta zona acuática combina una piscina de relajación, una piscina deportiva, una zona de juegos y una zona de bienestar, para que pueda pasar un rato agradable con su familia o amigos"
    ],
    "nl": [
      "Deze aquatische ruimte combineert een ontspanningsbad, een sportbad, een speelruimte en een wellnessruimte, zodat je wat quality time kunt doorbrengen met je familie of vrienden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre ludo-sportif Les Hermines : Espace aquatique"
    ]
  },
