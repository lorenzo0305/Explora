  "rdfs:comment": {
    "de": [
      "Permanenter Orientierungsparcours im Stadtzentrum von Albertville. Finden Sie alle Hinweise, die Sie zu den verschiedenen Markierungen führen, die in den Straßen im Zentrum der Stadt aufgestellt sind. Entdecken Sie das Kulturerbe von Albertville, wie Sie es noch nie gesehen haben."
    ],
    "en": [
      "Permanent orienteering course in Albertville town center. Find all the clues that will lead you to the different markers set out in the streets in the center of town. Discover Albertville's heritage as you've never seen it before."
    ],
    "it": [
      "Un percorso di orientamento permanente nel centro di Albertville. Trovate tutti gli indizi che vi condurranno ai diversi indicatori collocati nelle strade del centro della città. Scoprite il patrimonio di Albertville come non l'avete mai visto prima."
    ],
    "fr": [
      "Parcours d'orientation permanent dans le centre-ville d'Albertville. Retrouvez tous les indices qui vous mèneront aux différentes balises disposées dans les rues au centre de la ville. Découvrez le patrimoine d'Albertville comme vous ne l'avez jamais vu."
    ],
    "es": [
      "Un recorrido de orientación permanente en el centro de Albertville. Encuentre todas las pistas que le conducirán a las diferentes balizas colocadas en las calles del centro de la ciudad. Descubra el patrimonio de Albertville como nunca antes lo había visto."
    ],
    "nl": [
      "Een permanent oriëntatieparcours in het centrum van Albertville. Vind alle aanwijzingen die je naar de verschillende markeringen in de straten in het centrum van de stad leiden. Ontdek het erfgoed van Albertville zoals je het nog nooit hebt gezien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours permanent d'orientation - Centre-ville d'Albertville"
    ]
  },
