  "rdfs:comment": {
    "de": [
      "Spielplatz bestehend aus einem Bereich für 0-3-Jährige mit einer Rutsche, 2 Ballpools, Schaumstoffspielen... und einem riesigen Parcours für 4-12-Jährige mit Affenbrücke, riesigem Ballpool, 2 Rutschen, einem Trampolin... Ein Lasergame-Bereich."
    ],
    "en": [
      "A play area for 0-3 year olds with a slide, 2 ball pools, foam games... and a giant course for 4-12 year olds with a monkey bridge, giant ball pool, 2 slides, trampoline... A laser-game area."
    ],
    "it": [
      "Un'area giochi per bambini da 0 a 3 anni con scivolo, 2 piscine di palline, giochi di schiuma... e un percorso gigante per bambini da 4 a 12 anni con ponte delle scimmie, piscina di palline giganti, 2 scivoli, trampolino... Un'area per i giochi laser."
    ],
    "fr": [
      "Aire de jeux composée d'un espace pour les 0-3 ans avec un toboggan, 2 piscines à balles, des jeux en mousse... et d'un parcours géant pour les 4-12 ans avec pont de singes, piscine à balles géante, 2 toboggans, un trampoline... Un espace laser game."
    ],
    "es": [
      "Una zona de juegos para niños de 0 a 3 años con un tobogán, 2 piscinas de bolas, juegos de espuma... y un recorrido gigante para niños de 4 a 12 años con un puente mono, una piscina de bolas gigante, 2 toboganes, una cama elástica... Una zona de juegos láser."
    ],
    "nl": [
      "Een speelzone voor kinderen van 0-3 jaar met een glijbaan, 2 ballenbaden, schuimspellen... en een reuzenparcours voor kinderen van 4-12 jaar met een apenbrug, reuzenballenbad, 2 glijbanen, een trampoline... Een lasergamezone."
    ]
  },
