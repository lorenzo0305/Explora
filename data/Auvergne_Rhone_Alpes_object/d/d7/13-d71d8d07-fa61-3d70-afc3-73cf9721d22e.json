  "rdfs:comment": {
    "de": [
      "Die Kirche liegt im Regionalen Naturpark Livradois-Forez und ist dem Heiligen Julian von Brioude geweiht. Das Gebäude aus dem 12. Jahrhundert war Teil eines Komplexes aus Schloss, Kirche und Bauernhof, der ursprünglich romanisch war und später in der gotischen Epoche umgebaut wurde."
    ],
    "en": [
      "The church Saint-Julien, mid-Romanesque mid gothic, has a beautiful porch with rib casements. A wide landscape, clear and rolling, typical from the first foothills of the Livradois, surrounds you. Visit of the outside only."
    ],
    "it": [
      "Situata nel Parco Naturale Regionale Livradois-Forez, la chiesa è dedicata a Saint-Julien de Brioude. L'edificio del XII secolo faceva parte di un complesso castello-chiesa-fattoria, originariamente romanico e poi rimaneggiato in epoca gotica."
    ],
    "fr": [
      "Situé dans le Parc Naturel Régional du Livradois-Forez, l'église est dédiée à Saint-Julien de Brioude. L'édifice du 12ème faisait partie d'un ensemble Château-Eglise-Ferme, à l'origine roman puis remanié à l'époque gothique."
    ],
    "es": [
      "Situada en el Parque Natural Regional de Livradois-Forez, la iglesia está dedicada a Saint-Julien de Brioude. El edificio del siglo XII formaba parte de un complejo castillo-iglesia-finca, originalmente románico y luego reformado en el periodo gótico."
    ],
    "nl": [
      "De kerk ligt in het regionale natuurpark Livradois-Forez en is gewijd aan Saint-Julien de Brioude. Het gebouw uit de 12e eeuw maakte deel uit van een kasteel-kerk-boerderij complex, oorspronkelijk Romaans en vervolgens bewerkt in de gotische periode."
    ]
  },
  "rdfs:label": {
