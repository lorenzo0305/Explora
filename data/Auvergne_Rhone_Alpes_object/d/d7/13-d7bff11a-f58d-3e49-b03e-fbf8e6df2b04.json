  "rdfs:comment": {
    "de": [
      "Der Verein Zentao Macon bietet die Entwicklung der Praxis von Do in, Shiatsu, Qi Gong und Meditation in Charnay-Lès-Mâcon an und organisiert Kuren in der Gemeinde Albiez-Montrond."
    ],
    "en": [
      "The Zentao Macon association develops the practice of do in, shiatsu, qi gong and meditation in Charnay-Lès-Mâcon and organizes cures in Albiez-Montrond."
    ],
    "it": [
      "L'associazione Zentao Macon propone di sviluppare la pratica del do in, dello shiatsu, del qi gong e della meditazione a Charnay-Lès-Mâcon e organizza cure ad Albiez-Montrond."
    ],
    "fr": [
      "L'association Zentao Macon propose de développer la pratique du do in, du shiatsu, du qi gong et de la méditation à Charnay-Lès-Mâcon et organise des cures sur la commune d'Albiez-Montrond."
    ],
    "es": [
      "La asociación Zentao Macon propone desarrollar la práctica del do in, el shiatsu, el qi gong y la meditación en Charnay-Lès-Mâcon y organiza curas en Albiez-Montrond."
    ],
    "nl": [
      "De vereniging Zentao Macon biedt de ontwikkeling van do in, shiatsu, qi gong en meditatie in Charnay-Lès-Mâcon en organiseert kuren in Albiez-Montrond."
    ]
  },
