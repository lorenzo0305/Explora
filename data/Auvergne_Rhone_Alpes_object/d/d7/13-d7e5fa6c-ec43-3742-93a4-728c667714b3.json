  "rdfs:comment": {
    "de": [
      "Das Herrenhaus ist seit 1987 im Zusatzinventar der historischen Monumente eingetragen und ist ein schönes zweistöckiges Gebäude, das laut einer dendrochronologischen Analyse auf das Jahr 1497 datiert wird."
    ],
    "en": [
      "Listed in the Inventaire supplémentaire des Monuments historiques since 1987, this manor is a beautiful two-story building dated 1497, according to a dendrochronological analysis."
    ],
    "it": [
      "Iscritta nell'Inventario supplementare dei monumenti storici dal 1987, questa casa padronale è un bell'edificio a due piani datato 1497, secondo un'analisi dendrocronologica."
    ],
    "fr": [
      "Inscrit à l'Inventaire supplémentaire des Monuments historiques depuis 1987, ce manoir est un bel édifice à deux étages daté de 1497, selon une analyse dendrochronologique."
    ],
    "es": [
      "Inscrita en el Inventario Suplementario de Monumentos Históricos desde 1987, esta casa solariega es un bello edificio de dos plantas fechado en 1497, según un análisis dendrocronológico."
    ],
    "nl": [
      "Dit herenhuis, dat sinds 1987 op de Aanvullende Inventaris van Monumenten staat, is een prachtig gebouw met twee verdiepingen dat volgens een dendrochronologische analyse uit 1497 dateert."
    ]
  },
