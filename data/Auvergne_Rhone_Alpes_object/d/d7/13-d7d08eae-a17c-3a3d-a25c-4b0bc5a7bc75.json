  "rdfs:comment": {
    "de": [
      "Als Ort des Genusses und des Austauschs bietet Ihnen das Florès eine umfangreiche Karte mit Cocktails, Weinen, Spirituosen und alkoholfreien Getränken.\r\nFlammkuchen, Tapas, traditionelle Gerichte, hausgemachte Konditoreiwaren und ganztägiger Restaurantservice. Frühstücksangebote am Morgen"
    ],
    "en": [
      "A place for gourmandise and sharing, the Florès offers a wide range of cocktails, wines, spirits and non-alcoholic beverages.\r\nTarte flambées, tapas, traditional dishes, home-made pastries and all-day catering. Morning breakfast formulas"
    ],
    "it": [
      "Il Florès offre un'ampia gamma di cocktail, vini, liquori e bevande analcoliche\r\nTarte flambée, tapas, piatti tradizionali, dolci fatti in casa e servizio di ristorazione tutto il giorno. Opzioni per la colazione mattutina"
    ],
    "fr": [
      "Lieu de gourmandise et de partage, le Florès vous propose sa large carte de cocktails, vins, spiritueux et sans alcool\r\nTarte flambée, tapas, plats traditionnels, pâtisseries maison et service restauration toute la journée. Formules petit-déjeuner le matin"
    ],
    "es": [
      "El Florès ofrece una amplia gama de cócteles, vinos, licores y bebidas sin alcohol\r\nTarte flambée, tapas, platos tradicionales, repostería casera y servicio de restaurante durante todo el día. Opciones de desayuno por la mañana"
    ],
    "nl": [
      "De Florès biedt een breed scala aan cocktails, wijnen, sterke dranken en niet-alcoholische dranken\r\nTarte flambée, tapas, traditionele gerechten, huisgemaakt gebak en restaurantservice gedurende de hele dag. Ochtendontbijt"
    ]
  },
