      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/8d574ddc-e4d4-326c-998b-74059ddc5c35",
          "schema:validFrom": "2026-02-08T00:00:00",
          "schema:validThrough": "2026-11-12T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Von Mitte Juni bis Anfang September Sonntagabend und Mittwoch geschlossen\r\n\r\nRest des Jahres außerhalb der Schulferien Sonntagabend, Montagabend, Dienstag und Mittwoch geschlossen.\r\n\r\nVolle Karte von 12 bis 15 Uhr und von 19 bis 21 Uhr, reduzierte Karte den ganzen Tag."
            ],
            "en": [
              "Mid-June to early September closed Sunday evening and Wednesday\r\n\r\nThe rest of the year, except during school vacations, closed Sunday evening, Monday evening, Tuesday and Wednesday.\r\n\r\nFull menu from 12pm to 3pm and from 7pm to 9pm, reduced menu all day."
            ],
            "it": [
              "Da metà giugno a inizio settembre chiuso la domenica sera e il mercoledì\r\n\r\nIl resto dell'anno, escluse le vacanze scolastiche, chiuso domenica sera, lunedì sera, martedì e mercoledì.\r\n\r\nMenu completo dalle 12.00 alle 15.00 e dalle 19.00 alle 21.00, menu ridotto tutto il giorno."
            ],
            "fr": [
              "De mi-juin à début septembre fermé dimanche soir et mercredi\r\n\r\nLe reste de l’année hors vacances scolaires fermé dimanche soir, lundi soir, mardi et mercredi.\r\n\r\nCarte complète de 12h à 15h et de 19h à 21h, carte réduite toute la journée."
            ],
            "nl": [
              "Van half juni tot begin september gesloten op zondagavond en woensdag\r\n\r\nDe rest van het jaar, met uitzondering van de schoolvakanties, gesloten op zondagavond, maandagavond, dinsdag en woensdag.\r\n\r\nVolledig menu van 12.00 tot 15.00 uur en van 19.00 tot 21.00 uur, gereduceerd menu de hele dag."
            ],
            "es": [
              "De mediados de junio a principios de septiembre cerrado los domingos por la noche y los miércoles\r\n\r\nEl resto del año, salvo vacaciones escolares, cerrado el domingo por la noche, el lunes por la noche, el martes y el miércoles.\r\n\r\nMenú completo de 12h a 15h y de 19h a 21h, menú reducido todo el día."
            ]
          },
