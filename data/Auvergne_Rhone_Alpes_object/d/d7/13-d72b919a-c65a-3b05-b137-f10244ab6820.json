          "additionalInformation": {
            "de": [
              "Sonntag und Feiertage geschlossen\r\n- Schulferien (außer Schulferien im April) :\r\nMontag bis Samstag von 10:00 bis 12:00 Uhr und von 16:00 bis 19:00 Uhr geöffnet\r\n- Außerhalb der Schulferien + Schulferien im April\r\nGeöffnet: Montag bis Samstag von 16:00 bis 19:00 Uhr\r\n- An Feiertagen geschlossen"
            ],
            "en": [
              "Closed Sundays and public holidays\r\n- School vacations (except April school vacations):\r\nOpen Monday to Saturday, 10am to 12pm and 4pm to 7pm\r\n- Outside school vacations + April school vacations\r\nOpen Monday to Saturday, 4pm to 7pm\r\n- Closed on public holidays"
            ],
            "it": [
              "Chiuso la domenica e i giorni festivi\r\n- Vacanze scolastiche (tranne le vacanze scolastiche di aprile) :\r\nAperto dal lunedì al sabato, dalle 10.00 alle 12.00 e dalle 16.00 alle 19.00\r\n- Fuori dalle vacanze scolastiche + vacanze scolastiche di aprile\r\nAperto dal lunedì al sabato dalle 16.00 alle 19.00\r\n- Chiuso nei giorni festivi"
            ],
            "fr": [
              "Fermé dimanche et jours fériés\r\n- Vacances scolaires (hors vacances scolaires d'avril) :\r\nOuvert du lundi au samedi de 10h à 12h et de 16h à 19h  \r\n- Hors vacances scolaires + vacances scolaires d'avril\r\nOuvert du lundi au samedi de 16h à 19h\r\n- Fermé les jours fériés"
            ],
            "nl": [
              "Gesloten op zon- en feestdagen\r\n- Schoolvakanties (behalve in april) :\r\nOpen van maandag tot zaterdag, van 10u tot 12u en van 16u tot 19u\r\n- Buiten de schoolvakanties + schoolvakantie in april\r\nOpen van maandag tot zaterdag van 16u tot 19u\r\n- Gesloten op feestdagen"
            ],
            "es": [
              "Cerrado los domingos y días festivos\r\n- Vacaciones escolares (excepto vacaciones escolares de abril) :\r\nAbierto de lunes a sábado, de 10.00 a 12.00 h. y de 16.00 a 19.00 h\r\n- Fuera de las vacaciones escolares + vacaciones escolares de abril\r\nAbierto de lunes a sábado de 16.00 a 19.00 h\r\n- Cerrado los días festivos"
            ]
