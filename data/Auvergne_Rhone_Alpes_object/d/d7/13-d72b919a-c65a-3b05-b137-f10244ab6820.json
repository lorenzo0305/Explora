  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Bauernhof der GAEC la Touvière: Familienbetrieb mit Milchkuhhaltung. Jean François, Serge und Kevin bieten Ihnen ihre Käseherstellung an: Tomme, Abondance, Raclette von Kühen vom Bauernhof."
    ],
    "en": [
      "Welcome to our farm, La Touviere (GAEC), on the outskirts of Essert-Romand when arriving from Saint Jean d’Aulps. Jean François, Serge and Kevin are proud to offer you their range of cheeses: Tomme, Abondance, Raclette made with farm-reared cows’ milk."
    ],
    "it": [
      "Benvenuti alla Fattoria GAEC la Touvière: un'azienda lattiero-casearia a conduzione familiare. Jean François, Serge e Kevin vi offrono i loro formaggi: Tomme, Abondance, Raclette da mucche di fattoria."
    ],
    "fr": [
      "Bienvenue à la Ferme du GAEC la Touvière : exploitation familiale d'élevage de vaches laitières. Jean François, Serge et Kevin vous proposent leurs fabrications de fromages : Tomme, Abondance, Raclette de vache fermière."
    ],
    "nl": [
      "Welkom op de boerderij GAEC la Touvière: een familiale melkveehouderij. Jean François, Serge en Kevin bieden u hun kazen aan: Tomme, Abondance, Raclette van koeien van de boerderij."
    ],
    "es": [
      "Bienvenido a la granja del GAEC la Touvière: una granja lechera familiar. Jean François, Serge y Kevin le ofrecen sus quesos: Tomme, Abondance, Raclette de vacas de granja."
    ]
  },
