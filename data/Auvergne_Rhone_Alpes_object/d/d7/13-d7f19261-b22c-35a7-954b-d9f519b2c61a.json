  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Rencurel empfängt Sie das Hotel Le Marronnier in einer warmen und freundlichen Atmosphäre. Es ist der ideale Ort, um sich zu entspannen und neue Kraft zu tanken."
    ],
    "en": [
      "In the heart of the village of Rencurel, the hotel Le Marronnier welcomes you in a warm and friendly atmosphere. It is the ideal place to relax and recharge your batteries."
    ],
    "it": [
      "Nel cuore del villaggio di Rencurel, l'hotel Le Marronnier vi accoglie in un'atmosfera calda e accogliente. È il luogo ideale per rilassarsi e ricaricare le batterie."
    ],
    "fr": [
      "Au coeur du village de Rencurel, l'hôtel Le Marronnier vous accueille dans une ambiance chaleureuse et conviviale. C'est le lieu idéal pour vous détendre et vous ressourcer."
    ],
    "nl": [
      "In het hart van het dorp Rencurel ontvangt hotel Le Marronnier u in een warme en vriendelijke sfeer. Het is de ideale plek om te ontspannen en nieuwe energie op te doen."
    ],
    "es": [
      "En el corazón del pueblo de Rencurel, el hotel Le Marronnier le da la bienvenida en un ambiente cálido y acogedor. Es el lugar ideal para relajarse y recargar las pilas."
    ]
  },
