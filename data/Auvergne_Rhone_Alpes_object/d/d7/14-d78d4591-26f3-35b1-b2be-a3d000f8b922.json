  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3d76346d-bd6a-3615-a554-c38a8c0d757e",
      "dc:description": {
        "de": [
          "Prêt-à-porter und Accessoires für Damenmode.\n\nTäglich außer dienstags von 10:30 bis 12:30 Uhr und von 15:00 bis 19:00 Uhr geöffnet.\n\nLust, eine Bestellung aufzugeben?\nFinden Sie die Must-Haves der Boutique, indem Sie auf die Schaltfläche \"Reservieren\" klicken"
        ],
        "en": [
          "Women's ready-to-wear and fashion accessories.\n\nOpen every day except Tuesday from 10.30am to 12.30pm and from 3pm to 7pm.\n\nWant to place an order?\nClick on the \"Reserve\" button to find out more about the boutique's must-haves"
        ],
        "it": [
          "Abbigliamento donna e accessori moda.\n\nAperto tutti i giorni, tranne il martedì, dalle 10.30 alle 12.30 e dalle 15.00 alle 19.00.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Prenota\" per vedere tutti i must-have del negozio"
        ],
        "fr": [
          "Prêt à porter et accessoires de mode féminin.\n\nOuvert tous les jours sauf le mardi de 10h30 à 12h30 et de 15h00 à 19h00.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "es": [
          "Prêt-à-porter femenino y accesorios de moda.\n\nAbierto todos los días, excepto el martes, de 10.30 a 12.30 y de 15.00 a 19.00.\n\n¿Quiere hacer un pedido?\nHaga clic en el botón \"Reservar\" para ver todos los artículos imprescindibles de la tienda"
        ],
        "nl": [
          "Dameskleding en modeaccessoires.\n\nElke dag geopend behalve dinsdag van 10.30 tot 12.30 uur en van 15.00 tot 19.00 uur.\n\nWilt u een bestelling plaatsen?\nKlik op de knop \"Reserveren\" om alle must-have artikelen van de winkel te bekijken"
        ]
      },
      "@type": [
        "Description"
      ],
