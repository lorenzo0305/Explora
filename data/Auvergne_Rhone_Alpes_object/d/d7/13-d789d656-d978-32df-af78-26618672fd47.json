  "rdfs:comment": {
    "de": [
      "Der Aqua-Entspannungsbereich (ohne Reservierung): Schwimmbad, Sauna, Hammam, Panoramaterrasse mit Whirlpools, eine kostenlose Wassergymnastikstunde (14:45 Uhr). Wir bieten außerdem mit Reservierung: Wellness- und Schönheitsbehandlungen, Aquagymnastik, Aquabike und Babyschwimmen."
    ],
    "en": [
      "Aqua relaxation area (no reservation required): swimming pool, sauna, steam room, panoramic terrace with Jacuzzis, free aquagym class (2:45 p.m.). Also available on reservation: wellness and beauty treatments, aquagym sessions, aquabike and baby swimmers."
    ],
    "it": [
      "Area relax Aqua (senza prenotazione): piscina, sauna, bagno turco, terrazza panoramica con idromassaggio, una lezione gratuita di aquagym (ore 14.45). Offriamo anche trattamenti benessere e di bellezza, sessioni di aquagym, aquabike e sessioni di nuoto per bambini (su prenotazione)"
    ],
    "fr": [
      "L’espace aqua détente (sans réservation) : piscine, sauna, hammam, terrasse panoramique avec jacuzzis, un cours d'aquagym offert (14h45). Nous proposons également sur réservation : soins bien-être et esthétiques, séances aquagym, aquabike et bébés nageurs"
    ],
    "nl": [
      "Ontspanningsruimte (Reserveren niet nodig): zwembad, sauna, stoombad, panoramaterras met bubbelbaden, één gratis aquagymles (14.45 uur). We bieden ook wellness- en schoonheidsbehandelingen, aquagymlessen, aquafietsen en babyzwemsessies (reserveren verplicht)."
    ],
    "es": [
      "Espacio de relajación acuática (sin reserva previa): piscina, sauna, baño turco, terraza panorámica con jacuzzis, una clase gratuita de aquagym (14.45 h). También ofrecemos tratamientos de bienestar y belleza, sesiones de aquagym, aquabike y sesiones de natación para bebés (previa reserva)"
    ]
  },
