  "rdfs:comment": {
    "de": [
      "Kirche aus dem 12. Jahrhundert und Überreste des Schlosses (privat) mit befestigtem Tor. Dolmen mit dem Namen \"Le Palet de Gargantua\" in Le Villar (privat). Brunnen mit Oratorium Sainte-Anne. In Bonnefond zahlreiche Elemente des kleinen ländlichen Kulturerbes. Geschnitztes Kreuz aus dem 15."
    ],
    "en": [
      "12th-century church and remains of castle (private) with fortified gate. Dolmen known as \"Le Palet de Gargantua\" at Le Villar (private). Sainte-Anne oratory fountain. In Bonnefond, numerous elements of small-scale rural heritage. 15th-century sculpted cross."
    ],
    "it": [
      "Chiesa del XII secolo e resti del castello (privato) con porta fortificata. Dolmen detto \"Le Palet de Gargantua\" a Le Villar (privato). Fontana dell'oratorio di Sainte-Anne. A Bonnefond, numerosi piccoli elementi del patrimonio rurale. Croce scolpita del XV secolo."
    ],
    "fr": [
      "Église du XIIe siècle et vestiges du château (privé) avec porte fortifiée. Dolmen dit « Le Palet de Gargantua » au Villar (privé). Fontaine-oratoire Sainte-Anne. À Bonnefond, nombreux éléments de petit patrimoine rural. Croix sculptée du XVe siècle."
    ],
    "nl": [
      "Kerk uit de 12e eeuw en overblijfselen van het kasteel (privé) met versterkte poort. Dolmen bekend als \"Le Palet de Gargantua\" in Le Villar (privé). Fontein van het Sainte-Anne oratorium. In Bonnefond, talrijke kleine landelijke erfgoedelementen. Gebeeldhouwd kruis uit de 15e eeuw."
    ],
    "es": [
      "Iglesia del siglo XII y restos del castillo (privado) con puerta fortificada. Dolmen conocido como \"Le Palet de Gargantua\" en Le Villar (privado). Fuente del oratorio Sainte-Anne. En Bonnefond, numerosos pequeños elementos del patrimonio rural. Cruz esculpida del siglo XV."
    ]
  },
