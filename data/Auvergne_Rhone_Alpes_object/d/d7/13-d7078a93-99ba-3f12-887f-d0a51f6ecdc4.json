  "rdfs:comment": {
    "de": [
      "Ein monatliches Treffen zum Plaudern, Spaß haben und Entdecken!\r\nErforsche die Lebenswege unglaublicher Frauen und Geschichten, die dich zum Nachdenken oder Schmunzeln bringen. Finde deine Favoritin des Tages, indem du liest und dich mit anderen austauschst!"
    ],
    "en": [
      "A monthly rendez-vous to chat, have fun and discover!\r\nExplore incredible women's journeys and stories that make you think or smile. Read and share, and find your favorite woman of the day!"
    ],
    "it": [
      "Un appuntamento mensile per chiacchierare, divertirsi e scoprire!\r\nEsplorate le storie di donne incredibili e le storie che vi fanno riflettere o sorridere. Leggete e condividete, e trovate la vostra donna preferita del giorno!"
    ],
    "fr": [
      "Un rendez-vous mensuel pour papoter, s’amuser et découvrir !\r\nExplore des parcours de femmes incroyables et des histoires qui font réfléchir ou sourire. Entre lectures et partages, trouve ton coup de cœur féminin du jour !"
    ],
    "es": [
      "Una cita mensual para charlar, divertirse y descubrir\r\nExplora las historias de mujeres increíbles y las historias que te hacen pensar o sonreír. Lee y comparte, ¡y encuentra a tu mujer favorita del día!"
    ],
    "nl": [
      "Een maandelijks rendez-vous om te kletsen, plezier te maken en te ontdekken!\r\nOntdek de verhalen van ongelooflijke vrouwen en verhalen die je aan het denken zetten of doen glimlachen. Lees en deel, en vind je favoriete vrouw van de dag!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Book and chill: Herstory - ados"
    ]
  },
