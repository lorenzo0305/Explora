  "rdfs:comment": {
    "de": [
      "Beeindruckende Kalksteinfelsen, die den Süden des Vercors-Massivs markieren. Ein markierter Wanderweg führt in 2,5 Stunden um ihn herum (Start im Dorf Archiane - folgen Sie ''Les Carnets d'Archiane'' und der gelb-grünen Markierung)."
    ],
    "en": [
      "It’s an imposing cirque of limestone cliffs marking the South of the Vercors. One marked path makes the round in 2h30 (starting from the village of Arhiane - follow “Les Carnets d’Archiane”  with yellow and green trail marks)."
    ],
    "it": [
      "Un impressionante circo di falesie calcaree che segna la parte meridionale del massiccio del Vercors. Un sentiero segnalato vi gira intorno in 2 ore (si parte dal villaggio di Archiane - seguire i cartelli gialli e verdi)."
    ],
    "fr": [
      "Impressionnant cirque de falaises calcaires marquant le sud du massif du Vercors. Un sentier balisé en fait faire le tour en 2h30 (départ du village d’Archiane - suivre ‘‘Les Carnets d’Archiane’’ et le balisage jaune et vert)."
    ],
    "es": [
      "Un impresionante circo de acantilados calcáreos que marca el sur del macizo del Vercors. Un sendero señalizado lo rodea en 2 horas y media (se parte del pueblo de Archiane - seguir las señales amarillas y verdes)."
    ],
    "nl": [
      "Indrukwekkende kalkkliffen die het begin van het zuidelijke deel van het Vercors-massief aangeven. Via een aangeduide route van 2.30 u (vertrek in het dorp Archiane - \"Les Carnets d'Archiane\" en de gele en groene markeringen volgen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cirque d'Archiane"
    ]
  },
