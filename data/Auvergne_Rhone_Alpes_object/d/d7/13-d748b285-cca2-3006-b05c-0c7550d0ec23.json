  "rdfs:comment": {
    "de": [
      "1919 richtete Fernand Reignier sein Käseunternehmen am linken Ufer des Thiou, unterhalb nach der Pont-Neuf, ein. Die Molke wird somit direkt in den Fluss geleitet."
    ],
    "en": [
      "In 1919, Fernand Reignier set up his cheese factory on the left bank of the Thiou, below the Pont-Neuf. The whey is thus poured directly into the river."
    ],
    "it": [
      "Nel 1919, Fernand Reignier impiantò il suo caseificio sulla riva sinistra del Thiou, sotto il Pont-Neuf. Il siero viene così versato direttamente nel fiume."
    ],
    "fr": [
      "En 1919, Fernand Reignier installe son entreprise fromagère sur la rive gauche du Thiou, en contrebas après le Pont-Neuf. Le petit lait est ainsi déversé directement dans la rivière."
    ],
    "nl": [
      "In 1919 vestigde Fernand Reignier zijn kaasmakerij op de linkeroever van de Thiou, onder de Pont-Neuf. De wei wordt zo rechtstreeks in de rivier gegoten."
    ],
    "es": [
      "En 1919, Fernand Reignier instaló su empresa quesera en la orilla izquierda del Thiou, bajo el Pont-Neuf. Así, el suero se vierte directamente en el río."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fromagerie Reignier"
    ]
  },
