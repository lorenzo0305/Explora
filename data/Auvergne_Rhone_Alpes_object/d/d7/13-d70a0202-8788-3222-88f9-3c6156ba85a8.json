  "rdfs:comment": {
    "de": [
      "Das Netzwerk ÉCuME Médiathèques umfasst die 23 Mediatheken des Gebiets Entre Bièvre et Rhône.\r\nIhre Hauptaufgabe besteht darin, den Zugang zum Lesen und im weiteren Sinne zur Kultur und zum Wissen für alle Bevölkerungsgruppen zu fördern."
    ],
    "en": [
      "The écume médiathèques network groups together the 23 media libraries of the Entre Bièvre et Rhône territory\r\nTheir main mission is to promote access to reading and, more broadly, to culture and knowledge for all publics."
    ],
    "it": [
      "La rete ÉCuME Médiathèques riunisce le 23 mediateche dell'area Entre Bièvre et Rhône.\r\nLa loro missione principale è promuovere l'accesso alla lettura e, più in generale, alla cultura e alla conoscenza per tutti."
    ],
    "fr": [
      "Le réseau ÉCuME Médiathèques regroupe les 23 médiathèques du territoire Entre Bièvre et Rhône. \r\nLeur mission principale est de favoriser l'accès à la lecture et plus largement à la culture et aux savoirs pour tous les publics."
    ],
    "es": [
      "La red ÉCuME Médiathèques reúne a las 23 mediatecas de la región de Entre Bièvre et Rhône.\r\nSu misión principal es promover el acceso a la lectura y, más ampliamente, a la cultura y el conocimiento para todos los ciudadanos."
    ],
    "nl": [
      "Het netwerk ÉCuME Médiathèques verenigt de 23 mediatheken in de regio Entre Bièvre et Rhône.\r\nHun belangrijkste missie is het bevorderen van de toegang tot lezen en, in bredere zin, tot cultuur en kennis voor iedereen."
    ]
  },
  "rdfs:label": {
