  "rdfs:comment": {
    "de": [
      "La Table des Canuts ist ein traditioneller Lyoner Bouchon mit authentischer lokaler Küche. Dieses Restaurant ist ein Muss für alle Liebhaber der Lyoner Gastronomie."
    ],
    "en": [
      "La Table des Canuts is a traditional Lyonnais bouchon serving authentic local cuisine. This restaurant is a must for all lovers of Lyonnais gastronomy."
    ],
    "it": [
      "La Table des Canuts è un tradizionale bouchon lionese che serve un'autentica cucina locale. Questo ristorante è un must per tutti gli amanti della gastronomia lionese."
    ],
    "fr": [
      "La Table des Canuts est un bouchon lyonnais traditionnel avec une cuisine locale authentique. Ce restaurant est un incontournable pour tous les amoureux de la gastronomie lyonnaise."
    ],
    "nl": [
      "La Table des Canuts is een traditionele Lyonnais bouchon waar authentieke lokale gerechten worden geserveerd. Dit restaurant is een must voor alle liefhebbers van de gastronomie van Lyonnais."
    ],
    "es": [
      "La Table des Canuts es un bouchon tradicional lionés que sirve auténtica cocina local. Este restaurante es una visita obligada para todos los amantes de la gastronomía lionesa."
