  "rdfs:comment": {
    "de": [
      "La Vague ist ein sehr moderner Wassersportkomplex mit 5426 m² überdachter Fläche und 1500 m² Wasserflächen, der den Benutzern dank eines Ozon-Wasseraufbereitungssystems einen unvergleichlichen Komfort bietet."
    ],
    "en": [
      "This is a very modern complex with 5426 m² indoors and 1500 m² of water areas outside. There are three indoor pools and one outside pool, a paddling pool, a relaxation area, a fun water park area and a spa."
    ],
    "it": [
      "La Vague è un modernissimo complesso acqualudico con 5.426 m² di spazio coperto e 1.500 m² di acqua, che offre agli utenti un comfort ineguagliabile grazie a un sistema di trattamento dell'acqua con ozono."
    ],
    "fr": [
      "La Vague est un complexe aqualudique très moderne avec 5426  m² couvert et 1500 m² de plans d'eau offre un confort incomparable aux usagers grâce à un système de traitement d'eau à l'ozone."
    ],
    "nl": [
      "La Vague is een ultramodern aqualudicacomplex met 5.426 m² overdekte ruimte en 1.500 m² water, dat gebruikers een ongeëvenaard comfort biedt dankzij een ozonwaterbehandelingssysteem."
    ],
    "es": [
      "La Vague es un complejo acualúdico ultramoderno de 5.426 m² cubiertos y 1.500 m² de agua, que ofrece a los usuarios un confort inigualable gracias a un sistema de tratamiento del agua con ozono."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre Aqualudique La Vague"
    ]
  },
