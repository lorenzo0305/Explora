  "rdfs:comment": {
    "de": [
      "Im Herzen der Diois-Berge gelegen, mit einem meisterhaften Tiefblick auf das Roanne-Tal, ein Feinschmeckergasthof mit regionaler Küche zwischen Drôme und Provence."
    ],
    "en": [
      "Located at the heart of the Diois Mountains, with a remarquable bird's eye view of the Roanne Valley, our gourmet inn offers traditional cooking with Drôme and Provençal influences."
    ],
    "it": [
      "Situata nel cuore delle montagne di Diois e sulle vie della lavanda, con una vista mozzafiato sulla valle di Roanne, questa è una locanda gourmet a conduzione familiare tra la Drôme e la Provenza che lavora su un circuito breve."
    ],
    "fr": [
      "Située au cœur des montagnes du Diois et sur les Routes de la Lavande, offrant une vue magistrale et plongeante sur la Vallée de la Roanne, une auberge gourmande, familiale et terroir entre Drôme et Provence qui travaille en circuit court."
    ],
    "es": [
      "Situada en el corazón de las montañas de Diois y en las Rutas de la Lavanda, con una vista impresionante sobre el valle de Roanne, es una posada gastronómica, familiar y local entre las regiones de Drôme y Provenza que funciona en circuito corto."
    ],
    "nl": [
      "Een gulle, traditionele herberg tussen Drôme en Provence. Fantastische ligging in de bergen in de omgeving van Die met uitzicht op het dal van de Roanne."
    ]
  },
  "rdfs:label": {
