  "rdfs:comment": {
    "de": [
      "Vera BRAUN kehrt mit einer zweiten Ausstellung zurück, die von den Amis du Domaine de Maubourg organisiert wird. Diese zeigt eher figurative Zeichnungen und Werke; ein anderer Zugang zu Veras immensem Talent. Die Ausstellung ist während der Öffnungszeiten des Rathauses zu sehen."
    ],
    "en": [
      "Vera BRAUN is back with a 2nd exhibition, organized by the Friends of the Domaine de Maubourg. The exhibition features more figurative drawings and works, offering another insight into Vera?s immense talent. Exhibition on view during Town Hall opening hours."
    ],
    "it": [
      "Vera BRAUN torna con una seconda mostra, organizzata dagli Amici del Domaine de Maubourg. Questa mostra presenta più disegni e opere figurative, offrendo un'ulteriore visione dell'immenso talento di Vera. La mostra può essere visitata durante gli orari di apertura del Municipio."
    ],
    "fr": [
      "Vera BRAUN est de retour avec une 2ème exposition, proposée par les Amis du Domaine de Maubourg. Celle-ci présente des dessins et œuvres plus figuratives ; une autre approche de l’immense talent de Vera. Expo visible aux heures d'ouverture de la Mairie."
    ],
    "es": [
      "Vera BRAUN vuelve con una 2ª exposición, organizada por los Amigos del Domaine de Maubourg. Esta exposición presenta más dibujos y obras figurativas, ofreciendo otra visión del inmenso talento de Vera. La exposición puede visitarse durante el horario de apertura del Ayuntamiento."
    ],
    "nl": [
      "Vera BRAUN is terug met een 2e tentoonstelling, georganiseerd door de Vrienden van het Domaine de Maubourg. Deze tentoonstelling bevat meer figuratieve tekeningen en werken en biedt een nieuwe kijk op Vera's immense talent. De tentoonstelling is te bezichtigen tijdens de openingstijden van het stadhuis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Vera BRAUN"
    ]
  },
