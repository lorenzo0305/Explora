  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek \"Au Fil des Pages\" empfängt Sie in einem Raum, in dem Sie Dokumente aus ihrem eigenen Bestand, aus den Magazinen der Mediathek des Departements Rhône und aus dem COMMONLY-Verbund der Bibliotheken der Monts du Lyonnais finden können."
    ],
    "en": [
      "The \"Au Fil des Pages\" municipal library welcomes you to a space where you can find documents from its own collection, from the Médiathèque du Département du Rhône and from the COMMONLY network of Monts du Lyonnais libraries."
    ],
    "it": [
      "La biblioteca municipale \"Au Fil des Pages\" vi accoglie in uno spazio in cui potrete trovare i documenti della propria collezione, della biblioteca multimediale del dipartimento del Rodano e della rete COMMONLY delle biblioteche di Monts du Lyonnais."
    ],
    "fr": [
      "La Bibliothèque Municipale \"Au Fil des Pages\"  vous accueille dans un espace où vous trouverez des documents parmi son fonds propre, les dépôts de la Médiathèque du Département du Rhône et le Réseau COMMONLY des bibliothèques des Monts du Lyonnais."
    ],
    "es": [
      "La biblioteca municipal \"Au Fil des Pages\" le da la bienvenida a un espacio en el que podrá encontrar documentos de su propia colección, de la biblioteca multimedia del departamento del Ródano y de la red COMÚN de bibliotecas de los Monts du Lyonnais."
    ],
    "nl": [
      "De gemeentelijke bibliotheek \"Au Fil des Pages\" verwelkomt je in een ruimte waar je documenten kunt vinden uit de eigen collectie, uit de mediatheek van het departement Rhône en uit het COMMONLY-netwerk van bibliotheken in de Monts du Lyonnais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque Municipale \"Au Fil des Pages\""
    ]
  },
