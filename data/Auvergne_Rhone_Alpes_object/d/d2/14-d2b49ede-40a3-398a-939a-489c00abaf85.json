  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dfabe156-3c02-38d6-bdaf-5ff2c8ad40c5",
      "dc:description": {
        "de": [
          "Das Centre Audrey Bartier organisiert einen orientalischen Abend für Familien\n\nDieser Abend wird zugunsten kultureller Projekte für Senioren organisiert, die Mitglieder des soziokulturellen Zentrums Audrey Bartier sind\n\nTreffpunkt ist um 19.30 Uhr\nWir erwarten Sie zahlreich."
        ],
        "en": [
          "Center Audrey Bartier organizes an oriental evening for families\n\nThis evening is organized to benefit cultural projects for senior members of the Audrey Bartier social and cultural center\n\nMeet at 7:30 p.m\nWe look forward to seeing many of you."
        ],
        "it": [
          "Il Centro Audrey Bartier organizza una serata orientale per le famiglie\n\nQuesta serata è organizzata a favore di progetti culturali per i membri anziani del Centro sociale e culturale Audrey Bartier\n\nAppuntamento alle 19.30\nCi auguriamo di vedervi lì."
        ],
        "fr": [
          "Le Centre Audrey Bartier organise une soirée orientale en destination des familles \n\nCette soirée est organisée au profit des projets culturelles à destination des seniors adhérents du centre socioculturel Audrey Bartier\n\nRDV à 19 h 30\nOn vous attend nombreux et nombreuse."
        ],
        "nl": [
          "Het Centre Audrey Bartier organiseert een Oriëntaalse avond voor gezinnen\n\nDeze avond wordt georganiseerd ter ondersteuning van culturele projecten voor oudere leden van het sociaal en cultureel centrum Audrey Bartier\n\nBijeenkomst om 19.30 uur\nGraag tot ziens."
        ],
        "es": [
          "El Centro Audrey Bartier organiza una velada oriental para familias\n\nEsta velada se organiza en beneficio de los proyectos culturales de las personas mayores del Centro Social y Cultural Audrey Bartier\n\nCita a las 19.30\nLe esperamos."
        ]
      },
