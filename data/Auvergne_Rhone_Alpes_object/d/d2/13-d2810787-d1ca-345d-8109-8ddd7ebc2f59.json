  "rdfs:comment": {
    "de": [
      "Auf dem sanierten Gelände der ehemaligen Feuerwehrkaserne von Crest ist das Centre d'Art eine 200 m² große städtische Einrichtung, die wechselnden Ausstellungen gewidmet ist."
    ],
    "en": [
      "Municipal facility dedicated to temporary exhibitions, it invites you to discover the diversity of artistic expressions between modern times, artistic crafts and contemporary art. A variety of activities allows these themes to be shared with all audiences."
    ],
    "it": [
      "Struttura comunale dedicata alle mostre temporanee, invita i visitatori a scoprire la diversità delle espressioni artistiche, dall'artigianato all'arte contemporanea e alla cultura scientifica e tecnica."
    ],
    "fr": [
      "Équipement municipal dédié aux expositions temporaires, il invite à découvrir la diversité des expressions artistiques des métiers d'art à l'art contemporain en passant par la culture scientifique et technique."
    ],
    "nl": [
      "Op de gerestaureerde locatie van de voormalige brandweerkazerne Crest is het Centre d'Art een gemeentelijk gebouw van 200 m² gewijd aan tijdelijke tentoonstellingen."
    ],
    "es": [
      "Instalación municipal dedicada a exposiciones temporales, invita a los visitantes a descubrir la diversidad de las expresiones artísticas, desde la artesanía al arte contemporáneo, pasando por la cultura científica y técnica."
    ]
  },
