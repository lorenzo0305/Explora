  "rdfs:comment": {
    "de": [
      "Innerhalb des Einkaufszentrums Hyper U, ein einzigartiges Restauranterlebnis, das mit seinen unschlagbaren Preisen und der Freiheit der Selbstbedienung operiert.\r\nSelbstbedienungsbuffet, Gemüse nach Belieben. Mehrere Formeln verfügbar."
    ],
    "en": [
      "At the heart of the Super U shopping mall, a unique dining experience with unbeatable prices and self-service freedom.\nSelf-service buffet, unlimited vegetables. Several formulas available."
    ],
    "it": [
      "Nel centro commerciale Super U meilleux, un'esperienza gastronomica unica con prezzi imbattibili e self-service gratuito.\nBuffet self-service, verdure illimitate. Diverse formule disponibili."
    ],
    "fr": [
      "Au sein du centre commercial Super U meilleux, une expérience unique de restauration qui opère par ses prix imbattables et sa liberté du libre service.\nBuffet libre service, légumes à volonté. Plusieurs formules disponibles."
    ],
    "es": [
      "En el centro comercial Super U meilleux, una experiencia gastronómica única con precios inmejorables y autoservicio gratuito.\nBuffet autoservicio, verduras ilimitadas. Varias fórmulas disponibles."
    ],
    "nl": [
      "Dit unieke restaurant in het Hyper U winkelcentrum biedt onverslaanbare prijzen en gratis zelfbediening.\r\nZelfbedieningsbuffet, onbeperkt groenten. Verschillende formules beschikbaar."
    ]
  },
  "rdfs:label": {
