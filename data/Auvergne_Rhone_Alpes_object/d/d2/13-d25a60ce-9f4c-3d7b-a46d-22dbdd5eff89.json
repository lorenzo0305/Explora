  "rdfs:comment": {
    "de": [
      "Gemütlicher Raum, intimer Keller, außergewöhnliche Terrasse, die sich über den Garten erstreckt. Vollständig hausgemachte Gerichte aus frischen und hochwertigen Produkten."
    ],
    "en": [
      "Warm room, intimate cellar, exceptional terrace extending into the garden. Dishes entirely homemade from fresh, quality products."
    ],
    "it": [
      "Ambiente caldo, cantina intima, terrazza eccezionale che si estende nel giardino. Piatti interamente fatti in casa con prodotti freschi e di qualità."
    ],
    "fr": [
      "Salle chaleureuse, cave intimiste, terrasse exceptionnelle s'étalant dans le jardin. Plats entièrement fait maison à base de produits frais et de qualité."
    ],
    "nl": [
      "Warme kamer, intieme kelder, uitzonderlijk terras dat doorloopt in de tuin. Gerechten volledig huisgemaakt van verse en kwaliteitsproducten."
    ],
    "es": [
      "Sala cálida, bodega íntima, terraza excepcional que se prolonga en el jardín. Platos totalmente caseros con productos frescos y de calidad."
    ]
  },
