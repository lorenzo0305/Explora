  "rdfs:comment": {
    "de": [
      "Die erste romanische Kirche stammt aus dem 10. Jahrhundert. Sie wurde 1770 und 1783 erweitert, aber 1860 schließlich zerstört, da sie zu klein und zu baufällig war. Die neue Kirche wurde 1862 im neogotischen Stil erbaut."
    ],
    "en": [
      "The first Romanesque church dates back to the 10th century. Enlarged in 1770 and again in 1783, it was finally demolished in 1860, deemed too small and dilapidated. A second life then began for the new neo-Gothic church built in 1862."
    ],
    "it": [
      "La prima chiesa romanica risale al X secolo. Ampliata nel 1770 e di nuovo nel 1783, fu infine demolita nel 1860, ritenuta troppo piccola e fatiscente. La nuova chiesa neogotica, costruita nel 1862, ebbe una seconda vita."
    ],
    "fr": [
      "La première église d’art roman, date du Xe siècle. Agrandie en 1770 puis en 1783, elle sera finalement détruite en 1860 jugée trop exigüe et trop délabrée. Une deuxième vie commence alors pour la nouvelle église de style néo-gothique construite en 1862."
    ],
    "es": [
      "La primera iglesia románica data del siglo X. Ampliada en 1770 y de nuevo en 1783, fue finalmente demolida en 1860, por considerarse demasiado pequeña y ruinosa. Una segunda vida comenzó entonces para la nueva iglesia neogótica construida en 1862."
    ],
    "nl": [
      "De eerste Romaanse kerk dateert uit de 10e eeuw. Ze werd uitgebreid in 1770 en opnieuw in 1783, maar werd uiteindelijk afgebroken in 1860 omdat ze te klein en vervallen werd geacht. Een tweede leven begon toen voor de nieuwe neogotische kerk die in 1862 werd gebouwd."
    ]
  },
