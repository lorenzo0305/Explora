  "rdfs:comment": {
    "de": [
      "Auf zu den Kostümen! Poloche wird am Samstag, den 18. April, durch die Straßen des Dorfes ziehen. Begleiten Sie die Blaskapelle des Dorfes: Fanfare Viv'Long.  Treffpunkt um 14:30 Uhr auf dem Rathausplatz."
    ],
    "en": [
      "Get your costumes on! Poloche will parade through the village on Saturday, April 18. Come and join the village brass band: Fanfare Viv'Long.  See you at 2.30pm on the Place de la Mairie."
    ],
    "it": [
      "Preparate i vostri costumi! La Poloche sfilerà per le strade del paese sabato 18 aprile. Unitevi alla banda musicale del villaggio: Fanfare Viv'Long.  Appuntamento alle 14.30 in Place de la Mairie."
    ],
    "fr": [
      "A vos costumes ! Poloche défilera dans les rue du village le samedi  18 avril. Venez accompagner la fanfare du village : Fanfare Viv'Long.  Rendez-vous à 14h30, sur la place de la Mairie."
    ],
    "es": [
      "¡Prepara tus disfraces! Poloche desfilará por las calles del pueblo el sábado 18 de abril. Ven y únete a la banda de música del pueblo: Fanfare Viv'Long.  Nos vemos a las 14:30 en la Place de la Mairie."
    ],
    "nl": [
      "Maak je kostuums klaar! Poloche zal op zaterdag 18 april door de straten van het dorp paraderen. Kom en sluit je aan bij de fanfare van het dorp: Fanfare Viv'Long.  Verzamelen om 14.30 uur op de Place de la Mairie."
    ]
  },
