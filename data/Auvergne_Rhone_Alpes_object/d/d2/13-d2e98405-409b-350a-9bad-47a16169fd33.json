  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Bahnhof entfernt befindet sich das Multiplexkino, eine innovative und zeitgemäße Kinostruktur. Das Multiplex verfügt über 9 Säle mit 29 bis 278 Sitzplätzen (d. h. 1073 Sessel)."
    ],
    "en": [
      "Just a stone's throw from the station, the multiplex is an innovative and trendy cinematic structure. This multiplex has 9 cinemas with 29 to 278 seats (1073 seats)."
    ],
    "it": [
      "A pochi passi dalla stazione, il multiplex è una struttura cinematografica innovativa e contemporanea. Questo multiplex dispone di 9 sale da 29 a 278 posti (1073 posti)."
    ],
    "fr": [
      "À deux pas de la gare, le multiplexe est une structure cinématographique innovante et dans l'air du temps. Ce multiplexe dispose de 9 salles de 29 à 278 places (soit 1073 fauteuils)."
    ],
    "nl": [
      "De multiplex, op een steenworp afstand van het station, is een innovatieve en hedendaagse bioscoopstructuur. Deze multiplex heeft 9 bioscopen met 29 tot 278 plaatsen (1073 plaatsen)."
    ],
    "es": [
      "A un paso de la estación, el multicine es una estructura cinematográfica innovadora y contemporánea. Este multicine cuenta con 9 salas de 29 a 278 asientos (1073 asientos)."
    ]
  },
