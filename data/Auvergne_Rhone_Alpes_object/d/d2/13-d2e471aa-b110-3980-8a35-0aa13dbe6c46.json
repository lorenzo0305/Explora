  "rdfs:comment": {
    "de": [
      "Secondhand-Laden: Paradies für englische Kleidung, neue Damen- und Herrenbekleidung (unverkaufte Bestände).\r\nAuch Accessoires und italienische Marken. und manchmal auch einige Brautkleider."
    ],
    "en": [
      "Friperie: English clothing paradise, new women's and men's clothing (unsold stock).\r\nAlso accessories and Italian brands and sometimes a few wedding dresses."
    ],
    "it": [
      "Negozio dell'usato: paradiso dell'abbigliamento inglese, abiti nuovi da donna e da uomo (stock invenduti).\r\nAnche accessori e marchi italiani e talvolta qualche abito da sposa."
    ],
    "fr": [
      "Friperie : paradis des vêtements anglais, des vêtements neufs pour femmes et hommes (stock invendus).\r\nÉgalement accessoires et marques italiennes et parfois quelques robes de mariées."
    ],
    "es": [
      "Tienda de segunda mano: paraíso de la ropa inglesa, ropa nueva de señora y caballero (existencias sin vender).\r\nTambién accesorios y marcas italianas y a veces algún vestido de novia."
    ],
    "nl": [
      "Kringloopwinkel: Engels kledingparadijs, nieuwe dames- en herenkleding (onverkochte voorraad).\r\nOok accessoires en Italiaanse merken en soms wat trouwjurken."
    ]
  },
