  "rdfs:comment": {
    "de": [
      "Unser Geschäft befindet sich in der Zone Artisanale les Lebreyres und ist für alle Menschen ohne Bedingungen zugänglich. Dienstag bis Freitag von 09:00 bis 11:45 Uhr und von 14:00 bis 16:45 Uhr. Samstags von 08:45 bis 11:45 Uhr."
    ],
    "en": [
      "Our store is located in the Zone Artisanale les Lebreyres, and is open to everyone, no strings attached. Tuesday to Friday from 09h to 11h45 and from 14h to 16h45. Saturday from 08h45 to 11h45."
    ],
    "it": [
      "Il nostro negozio si trova nella Zona Artigianale les Lebreyres ed è aperto a tutti. Da martedì a venerdì dalle 09:00 alle 11:45 e dalle 14:00 alle 16:45. Sabato dalle 08:45 alle 11:45."
    ],
    "fr": [
      "Notre magasin est situé dans la Zone Artisanale les Lebreyres, il est ouvert à tous et sans condition. Du mardi au vendredi de 09h à 11h45 et de 14h à 16h45. Le samedi de 08h45 à 11h45."
    ],
    "nl": [
      "Onze winkel bevindt zich in de Zone Artisanale les Lebreyres en is voor iedereen toegankelijk. Dinsdag tot en met vrijdag van 09.00 tot 11.45 uur en van 14.00 tot 16.45 uur. Zaterdag van 08.45 tot 11.45 uur."
    ],
    "es": [
      "Nuestra tienda está situada en la Zone Artisanale les Lebreyres, y está abierta a todos. De martes a viernes de 09h00 a 11h45 y de 14h00 a 16h45. Sábado de 08h45 a 11h45."
    ]
  },
  "rdfs:label": {
