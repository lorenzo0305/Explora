  "rdfs:comment": {
    "de": [
      "Informationen über die Region, ein Laden mit lokalen Produkten und ein Raum mit einer Dauerausstellung über die Geschichte und das lokale Erbe (Fauna und Flora des Saône-Tals, landwirtschaftliche Berufe, Möbel aus der Bresse, Modelle von Bauernhöfen aus der Bresse...)"
    ],
    "en": [
      "Touristic information, an artisanal shop with local products offers honey, coffee, wrought iron, ceramics. A permanent exhibition explains local history and aspects of life in Bresse. Temporary Exhibitions throughout the year."
    ],
    "it": [
      "Informazioni sulla regione, un negozio di prodotti locali e una sala espositiva permanente sulla storia e il patrimonio locale (fauna e flora della Val de Saône, mestieri agricoli, mobili della Bresse, modelli di fattorie della Bresse, ecc.)"
    ],
    "fr": [
      "Des informations sur la région, une boutique de produits locaux et une salle d'exposition permanente sur l'histoire et le patrimoine local (faune et flore du Val de Saône, métiers agricoles, mobilier bressan, maquettes de fermes bressanes…)"
    ],
    "nl": [
      "Informatie over de streek, een winkel met streekproducten en een permanente tentoonstellingsruimte over de plaatselijke geschiedenis en het erfgoed (fauna en flora van de Val de Saône, landbouwambachten, Bresse-meubels, modellen van Bresse-boerderijen, enz.)"
    ],
    "es": [
      "Información sobre la región, una tienda de productos locales y una sala de exposición permanente sobre la historia y el patrimonio locales (fauna y flora del Val de Saône, oficios agrícolas, muebles de Bresse, maquetas de granjas de Bresse, etc.)"
    ]
  },
