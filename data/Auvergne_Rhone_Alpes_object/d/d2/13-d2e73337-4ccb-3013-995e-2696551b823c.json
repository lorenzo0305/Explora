  "rdfs:comment": {
    "de": [
      "Sommer: Wander- und Mountainbike-Urlaub, begleitet oder auf eigene Faust.\r\nWinter: Schneeschuhwanderungen, Skilanglauf, Skating und nordische Skitouren, in Begleitung oder auf eigene Faust.\r\nDas ganze Jahr über: Fitness- und Wellnessaufenthalte."
    ],
    "en": [
      "Summer: Hiking and mountain biking trips, accompanied or unaccompanied.\r\nWinter: Snowshoeing, cross-country skiing, skating and Nordic ski mountaineering trips, accompanied or unaccompanied.\r\nAll year round: fitness and well-being stays."
    ],
    "it": [
      "Inverno: vacanze con le racchette da neve, sci di fondo, pattinaggio e sci alpinismo nordico, con o senza accompagnatore.\r\nEstate: vacanze all'insegna dell'escursionismo e della mountain bike, con o senza accompagnatore.\r\nTutto l'anno: soggiorni fitness e benessere."
    ],
    "fr": [
      "Hiver : Séjours raquettes, ski de fond, skating et ski de randonnée nordique, en accompagné ou en liberté.\r\nÉté : Séjours randonnée et VTT, accompagnés ou en liberté.\r\nToute l'année : Séjours forme et bien-être."
    ],
    "nl": [
      "Winter: sneeuwschoenwandelen, langlaufen, schaatsen en toerskiën, met of zonder begeleiding.\r\nZomer: wandel- en mountainbiketochten, met of zonder begeleiding.\r\nHet hele jaar door: fitness- en wellnessvakanties."
    ],
    "es": [
      "Invierno: raquetas de nieve, esquí de fondo, patinaje y esquí nórdico de travesía, con o sin acompañante.\r\nVerano: vacaciones de senderismo y bicicleta de montaña, con o sin acompañante.\r\nTodo el año: estancias de fitness y bienestar."
    ]
  },
