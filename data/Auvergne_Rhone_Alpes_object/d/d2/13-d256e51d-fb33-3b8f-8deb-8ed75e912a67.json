  "rdfs:comment": {
    "de": [
      "Restaurant am Hafen von Aiguebelette mit Speisesaal auf Pfählen, atemberaubender Blick auf den See, blumengeschmückte Terrasse, die von hundertjährigen Bäumen beschattet wird. Traditionelle Restauration am Seeufer: Friture, Seefisch."
    ],
    "en": [
      "Restaurant located at Aiguebelette’s port,  with restaurant sitting on stilts, an unrestricted view of the lake, flower bedecked terraces that are shaded by age-old trees.  Traditional lakeside menu."
    ],
    "it": [
      "Ristorante situato sul porto di Aiguebelette con sala ristorante su palafitte, vista ininterrotta sul lago, terrazza fiorita e ombreggiata da alberi secolari. Cucina tradizionale lacustre: pesce fritto, pesce di lago."
    ],
    "fr": [
      "Restaurant situé sur le port d’Aiguebelette avec salle de restaurant sur pilotis, vue imprenable sur le lac, terrasse fleurie et ombragée par des arbres centenaires. Restauration traditionnelle de bord de lac : friture, poissons de lac."
    ],
    "es": [
      "Restaurante situado en el puerto de Aiguebelette con sala de restaurante sobre pilotes, vista ininterrumpida del lago, terraza plantada de flores y sombreada por árboles centenarios. Cocina tradicional lacustre: pescado frito, pescado de lago."
    ],
    "nl": [
      "Restaurant gelegen aan de haven van Aiguebelette met restaurantzaal op palen, ononderbroken uitzicht op het meer, terras beplant met bloemen en schaduw van eeuwenoude bomen. Traditionele gerechten aan het meer: gebakken vis, vis uit het meer."
    ]
  },
  "rdfs:label": {
