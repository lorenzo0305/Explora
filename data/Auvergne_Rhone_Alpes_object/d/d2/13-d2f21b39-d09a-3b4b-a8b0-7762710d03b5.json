  "rdfs:comment": {
    "de": [
      "Anne de Beaujeu hatte Guillonne de Breuil eine ihrer schönsten Halsketten anvertraut. Diese versteckte sie in der ehemaligen Kirche Saint-André in Taxat-Senat. Heute liegt es an Ihnen, sie mit Familie oder Freunden zu suchen. Alle Spieler von 7 bis 97 Jahren."
    ],
    "en": [
      "Anne de Beaujeu had entrusted one of her most beautiful necklaces to Guillonne de Breuil. She hid it in the former Saint-André church in Taxat-Senat. Now, with family or friends, it's up to you to find it. All ages from 7 to 97."
    ],
    "it": [
      "Anne de Beaujeu affidò una delle sue collane più belle a Guillonne de Breuil. La nascose nell'antica chiesa di Saint-André a Taxat-Senat. Oggi, con la famiglia o con gli amici, tocca a voi ritrovarla. Per tutte le età, dai 7 ai 97 anni."
    ],
    "fr": [
      "Anne de Beaujeu avait confié l'un de ses plus beaux colliers à Guillonne de Breuil. Celle-ci l'a caché dans l'ancienne église Saint-André à Taxat-Senat. Aujourd'hui, en famille ou entre amis, c'est à vous de le rechercher. Tous joueurs de 7 à 97 ans."
    ],
    "nl": [
      "Anne de Beaujeu vertrouwde een van haar mooiste halskettingen toe aan Guillonne de Breuil. Ze verborg het in de voormalige kerk Saint-André in Taxat-Senat. Vandaag is het aan jou om het te vinden, met familie of vrienden. Alle leeftijden van 7 tot 97 jaar."
    ],
    "es": [
      "Anne de Beaujeu confió uno de sus collares más hermosos a Guillonne de Breuil. Ella lo escondió en la antigua iglesia de Saint-André, en Taxat-Senat. Hoy, en familia o entre amigos, le toca a usted encontrarlo. Para todas las edades, de 7 a 97 años."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game \"Le collier d'Anne de Beaujeu\""
    ]
  },
