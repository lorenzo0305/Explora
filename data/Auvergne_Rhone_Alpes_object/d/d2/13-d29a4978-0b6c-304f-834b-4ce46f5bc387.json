  "rdfs:comment": {
    "de": [
      "Trattorien sind mehr als nur eine Mahlzeit. Es ist eine italienische Lebensart!\r\nEin gemütlicher Ort, an dem man sich um einfache und authentische Gerichte versammelt."
    ],
    "en": [
      "Trattorias are much more than just a meal. It's an Italian way of life!\r\nA warm place where people gather to enjoy simple, authentic dishes."
    ],
    "it": [
      "Le trattorie sono molto più di un semplice pasto. È uno stile di vita italiano!\r\nUn luogo accogliente dove le persone si riuniscono per gustare piatti semplici e autentici."
    ],
    "fr": [
      "Les trattorias, c’est bien plus qu’un simple repas. C’est un art de vivre à l’italienne ! \r\nUn lieu chaleureux où l’on se rassemble autour de plats simples et authentiques."
    ],
    "nl": [
      "Trattoria's zijn veel meer dan alleen een maaltijd. Het is een Italiaanse manier van leven!\r\nEen warme plek waar mensen samenkomen om te genieten van eenvoudige, authentieke gerechten."
    ],
    "es": [
      "Las trattorias son mucho más que una comida. Es una forma de vida italiana\r\nUn lugar cálido donde la gente se reúne para disfrutar de platos sencillos y auténticos."
    ]
  },
  "rdfs:label": {
