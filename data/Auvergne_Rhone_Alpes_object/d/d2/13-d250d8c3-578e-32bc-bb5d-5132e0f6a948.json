  "rdfs:comment": {
    "de": [
      "Am Fuße des Tour des Anglais im mittelalterlichen Stadtkern von Saugues gelegen,\r\ndas Bistrot Coquelicot empfängt Sie auf seiner Terrasse mit seinen Spezialitäten (Pasta, Salate, Bruschetta, Bretter...), Weinen und regionalen Bieren."
    ],
    "en": [
      "Located at the foot of the Tour des Anglais in the medieval heart of Saugues,\r\nthe Bistrot Coquelicot welcomes you on its terrace with its specialities (pasta, salads, bruschettas, platters...), wines and regional beers."
    ],
    "it": [
      "Situato ai piedi della Tour des Anglais, nel cuore medievale di Saugues,\r\nil Bistrot Coquelicot vi accoglie sulla sua terrazza con le sue specialità (pasta, insalate, bruschette, taglieri...), vini e birre regionali."
    ],
    "fr": [
      "Situé au pied de la Tour des Anglais dans le cœur médiéval de Saugues, \r\nle Bistrot Coquelicot vous accueille sur sa terrasse avec ses spécialités (pâtes, salades, bruschettas, planches...), vins et bières régionales."
    ],
    "es": [
      "Situado al pie de la Tour des Anglais, en el corazón medieval de Saugues,\r\nel Bistrot Coquelicot le recibe en su terraza con sus especialidades (pasta, ensaladas, bruschettas, bandejas...), vinos y cervezas regionales."
    ],
    "nl": [
      "Gelegen aan de voet van de Tour des Anglais in het middeleeuwse hart van Saugues,\r\nverwelkomt de Bistrot Coquelicot u op zijn terras met zijn specialiteiten (pasta, salades, bruschetta's, schotels...), wijnen en streekbieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistrot Coquelicot"
    ]
  },
