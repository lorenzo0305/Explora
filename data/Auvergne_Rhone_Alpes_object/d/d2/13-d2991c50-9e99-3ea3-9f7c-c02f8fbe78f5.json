  "rdfs:comment": {
    "de": [
      "Nuggets Lodges & Spas ? Außergewöhnliche Erlebnisse im Herzen der Natur\r\nIn Prémilhat, in der Nähe von Montluçon, erfindet Pépites Lodges & Spas die Kunst der Flucht neu mit unabhängigen Lodges, jede mit eigenem Spa und einer einzigartigen sinnlichen Atmosphäre."
    ],
    "en": [
      "Pépites Lodges & Spas ? An exceptional experience in the heart of nature\r\nIn Prémilhat, near Montluçon, Pépites Lodges & Spas reinvents the art of escape with independent lodges, each with its own private spa and unique sensory ambience."
    ],
    "it": [
      "Pépites Lodges & Spas? Un'esperienza eccezionale nel cuore della natura\r\nA Prémilhat, vicino a Montluçon, Pépites Lodges & Spas reinventa l'arte dell'evasione con lodge indipendenti, ognuno con la propria spa privata e un ambiente sensoriale unico."
    ],
    "fr": [
      "Pépites Lodges & Spas – Expérience d’exception au cœur de la nature\r\nÀ Prémilhat, près de Montluçon, Pépites Lodges & Spas réinvente l’art de l’évasion avec des lodges indépendants, chacun doté de son spa privé et d’une ambiance sensorielle unique."
    ],
    "es": [
      "Pépites Lodges & Spas ? Una experiencia excepcional en plena naturaleza\r\nEn Prémilhat, cerca de Montluçon, Pépites Lodges & Spas reinventa el arte de la evasión con lodges independientes, cada uno con su propio spa privado y un ambiente sensorial único."
    ],
    "nl": [
      "Pépites Lodges & Spa's ? Een uitzonderlijke ervaring in het hart van de natuur\r\nIn Prémilhat, in de buurt van Montluçon, vindt Pépites Lodges & Spas de kunst van het ontsnappen opnieuw uit met onafhankelijke lodges, elk met een eigen spa en een unieke zintuiglijke sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pépites Lodges et Spas - Hôtel"
    ]
  },
