  "rdfs:comment": {
    "de": [
      "Das Fest der Jakobsmuschel, das im Laufe der Jahre zu einem unumgänglichen gastronomischen Ereignis geworden ist, kehrt für seine 17. Ausgabe nach Villard de Lans zurück.\r\nAnimationen von großen Küchenchefs, Verkostungen und Verkauf, bretonische Spezialitäten, Konzerte."
    ],
    "en": [
      "Over the years, it has become an unmissable gastronomic event, the Scallop Festival is back for its 17th edition in Villard de Lans on March 28 & 29.\r\nAnimations by great Chefs, tastings and sales, Breton specialities, concerts."
    ],
    "it": [
      "La 17ª edizione della Sagra della capasanta di Villard de Lans è diventata negli anni un appuntamento gastronomico da non perdere.\r\nCon l'intrattenimento di grandi chef, degustazioni e vendite, specialità bretoni e concerti."
    ],
    "fr": [
      "Devenu au fil des ans, un rendez-vous incontournable de la gastronomie, la Fête de la Coquille Saint Jacques revient pour sa 17e édition à Villard de Lans. \r\nAnimations par de grands Chefs, dégustations et vente, spécialités bretonnes, concerts."
    ],
    "es": [
      "La 17ª edición de la Fiesta de la Vieira de Villard de Lans se ha convertido con los años en una cita gastronómica ineludible.\r\nCon animaciones de grandes chefs, degustaciones y ventas, especialidades bretonas y conciertos."
    ],
    "nl": [
      "De 17e editie van het Sint-Jakobsschelpfestival in Villard de Lans is in de loop der jaren een gastronomisch evenement geworden dat je niet mag missen.\r\nMet entertainment door topkoks, proeverijen en verkoop, Bretonse specialiteiten en concerten."
    ]
  },
