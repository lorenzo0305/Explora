  "rdfs:comment": {
    "de": [
      "Zeitgemäßes Hotel auf dem Land, am Waldrand, 15 Min. vom \"Lac des Sapins\" entfernt.\r\nEinfallsreiche Küche im Rhythmus der Jahreszeiten.\r\nNeu: Bouleplatz mit zwei Bahnen\r\nNeue schattige Terrasse und Sommersitzecke im Freien."
    ],
    "en": [
      "Hotel in the country, in the air of time, in edge of forest, in 15 min of the \"Lac des Sapins\".\r\nInventive cuisine according to the seasons.\r\nNew: petanque court with two tracks\r\nNew shaded terrace and outdoor summer lounge area."
    ],
    "it": [
      "Hotel in campagna, nell'aria del tempo, ai margini della foresta, a 15 minuti dal \"Lac des Sapins\".\r\nCucina inventiva in base alle stagioni.\r\nNovità: campo da bocce con due piste\r\nNuova terrazza ombreggiata e area lounge estiva all'aperto."
    ],
    "fr": [
      "Hôtel à la campagne, dans l'air du temps, en bordure de forêt, à 15 min du \"Lac des Sapins\".\r\nCuisine inventive au rythme des saisons.\r\nNouveauté : terrain de pétanque de deux pistes. \r\nNouvelle terrasse ombragée et coin salon d'été extérieur."
    ],
    "nl": [
      "Hotel op het platteland, in de lucht van de tijd, aan de rand van het bos, op 15 minuten van het \"Lac des Sapins\".\r\nInventieve keuken volgens de seizoenen.\r\nNieuw: petanquebaan met twee banen\r\nNieuw schaduwrijk terras en zomerse buitenlounge."
    ],
    "es": [
      "Hotel en el campo, en el aire del tiempo, en el borde del bosque, a 15 minutos del \"Lac des Sapins\".\r\nUna cocina creativa en función de las estaciones.\r\nNuevo: pista de petanca con dos pistas\r\nNueva terraza sombreada y zona de salón de verano al aire libre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant \"Le Pavillon\""
    ]
  },
