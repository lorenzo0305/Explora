  "rdfs:comment": {
    "de": [
      "Notre-Dame de la Neylière ist ein religiöses Maristenhaus, das der Öffentlichkeit zugänglich ist und Sie zu einem Mittagessen mit Freunden, Familie oder Geschäftsessen einlädt."
    ],
    "en": [
      "Notre-Dame de la Neylière is a Marist religious house open to the public, which welcomes you for lunches with friends, family or business meals."
    ],
    "it": [
      "Notre-Dame de la Neylière è una casa religiosa marista aperta al pubblico, che vi accoglie per pranzi con amici, in famiglia o di lavoro."
    ],
    "fr": [
      "Notre-Dame de la Neylière est une maison religieuse Mariste ouverte au public qui vous acceuille pour vos déjeuners entre amis, en famille ou vos repas d'affaire."
    ],
    "nl": [
      "Notre-Dame de la Neylière is een religieus Maristenhuis dat open is voor het publiek en waar je welkom bent voor een lunch met vrienden, familie of zakenmaaltijden."
    ],
    "es": [
      "Notre-Dame de la Neylière es una casa religiosa marista abierta al público, que le acoge para almuerzos con amigos, en familia o comidas de negocios."
