  "rdfs:comment": {
    "de": [
      "Wir bieten alle Arten von Personentransport für Ihre beruflichen, privaten und/oder medizinischen Fahrten mit Taxi, Minibus. Kostenlose Reservierung für alle Abholorte (zu Hause, Bahnhof und andere)."
    ],
    "en": [
      "We provide all passenger transportation, for professional, private and/or medical trips, by taxi or minibus. Free reservation from all departure points (home, railway station or other)"
    ],
    "it": [
      "Con sede a Pierrelatte, forniamo tutti i tipi di trasporto passeggeri per i vostri viaggi d'affari, privati e/o medici in taxi o minibus a 9 posti.\r\nPrenotazione gratuita per tutte le partenze (casa, stazione e altro) 24 ore al giorno."
    ],
    "fr": [
      "Entreprise basée sur Pierrelatte, nous assurons tous types de transport de personnes, pour vos déplacements professionnels, privés et/ou médicaux en taxi ou minibus 9 places. \r\nRéservation gratuite pour tous départs (domicile, gare et autres) 24h/24h."
    ],
    "nl": [
      "Wij verzorgen alle soorten vervoer voor uw professionele, privé en/of medische reizen per taxi of minibus. Gratis reservering voor alle vertrekken (huis, station en andere bestemmingen)."
    ],
    "es": [
      "Con sede en Pierrelatte, le ofrecemos todo tipo de transporte de pasajeros para sus desplazamientos profesionales, privados y/o médicos en taxi o minibús de 9 plazas.\r\nReserva gratuita para todas las salidas (domicilio, estación y otros) las 24 horas del día."
    ]
  },
