  "rdfs:comment": {
    "de": [
      "Didier Marinet, Lehrer und Bergbegleiter, lädt Sie das ganze Jahr über ein, je nach Jahreszeit verschiedene Aktivitäten auszuüben: Paragliding-Taufe, Wanderungen, Schneeschuhwanderungen an den Orten der Haute Chaîne du Jura."
    ],
    "en": [
      "Didier Marinet, instructor and mountain guide, invites you throughout the year to practice various activities depending on the season: paragliding, hiking, snowshoeing on the sites of the Haute Chaine du Jura."
    ],
    "it": [
      "Didier Marinet, istruttore e guida alpina, vi invita tutto l'anno a praticare diverse attività a seconda della stagione: parapendio, escursioni, ciaspolate sui siti della Haute Chaîne du Jura."
    ],
    "fr": [
      "Didier Marinet, moniteur et accompagnateur en montagne, vous invite tout au long de l'année à pratiquer diverses activités selon les saisons : baptême de parapente, randonnées pédestres, randonnées en raquettes sur les sites de la Haute Chaîne du Jura."
    ],
    "es": [
      "Didier Marinet, instructor y guía de montaña, le invita a lo largo del año a practicar diversas actividades según la temporada: parapente, senderismo, raquetas de nieve en los parajes de la Haute Chaîne du Jura."
    ],
    "nl": [
      "Didier Marinet, instructeur en berggids, nodigt u het hele jaar door uit voor verschillende activiteiten, afhankelijk van het seizoen: paragliding, wandelen, sneeuwschoenwandelen op de terreinen van de Haute Chaîne du Jura."
    ]
  },
