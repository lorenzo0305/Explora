  "rdfs:comment": {
    "de": [
      "Kommen Sie und stellen Sie Ihre Kreation her! Eine leidenschaftliche Künstlerin zeigt Ihnen die Kunst des Mosaiks in einem dreistufigen Entdeckungsworkshop (Präsentation, Gestaltung und Fertigstellung)."
    ],
    "en": [
      "Come and make your own creation! An enthusiast makes you discover the art of mosaic via a discovery workshop in 3 stages (presentation, creation and finishing)."
    ],
    "it": [
      "Venite a realizzare la vostra creazione! Un appassionato vi introdurrà all'arte del mosaico in un laboratorio in tre parti (presentazione, creazione e finitura)."
    ],
    "fr": [
      "Venez fabriquer votre création ! Une passionnée vous fait découvrir l'art de la mosaïque via un atelier de découverte en 3 temps (présentation, création et finition)."
    ],
    "es": [
      "¡Venga y haga su propia creación! Un aficionado le iniciará en el arte del mosaico en un taller de tres partes (presentación, creación y acabado)."
    ],
    "nl": [
      "Kom je eigen creatie maken! Een enthousiasteling laat je in een driedelige workshop (presentatie, creatie en afwerking) kennismaken met de kunst van het mozaïeken."
    ]
  },
  "rdfs:label": {
    "de": [
