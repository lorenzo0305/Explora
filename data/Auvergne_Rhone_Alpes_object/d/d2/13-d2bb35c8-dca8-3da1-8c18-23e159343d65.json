  "rdfs:comment": {
    "de": [
      "Brasserie mit schattiger Terrasse.\r\nVor Ort oder zum Mitnehmen.\r\nLionel & Sylvia freuen sich, Sie während der Saison von Montag- bis Samstagabend begrüßen zu dürfen."
    ],
    "en": [
      "Brasserie with shaded terrace.\r\nOn the spot or to take away.\r\nLionel & Sylvia are pleased to welcome you Monday to Saturday evenings in season."
    ],
    "it": [
      "Brasserie con terrazza ombreggiata.\r\nIn loco o da asporto.\r\nLionel & Sylvia sono lieti di accogliervi dal lunedì al sabato sera in stagione."
    ],
    "fr": [
      "Brasserie avec terrasse ombragée.\r\nSur place ou à emporter.\r\nLionel & Sylvia ont le plaisir de vous accueillir du lundi au samedi soir en saison."
    ],
    "nl": [
      "Brasserie met schaduwrijk terras.\r\nTer plaatse of om mee te nemen.\r\nLionel & Sylvia verwelkomen je graag van maandag- tot zaterdagavond in het seizoen."
    ],
    "es": [
      "Brasería con terraza a la sombra.\r\nEn el establecimiento o para llevar.\r\nLionel y Sylvia le dan la bienvenida de lunes a sábado por la noche en temporada."
