  "rdfs:comment": {
    "de": [
      "La Bâtie Rolland ist von den beiden Flüssen Jabron und Vermenon umgeben und liegt in einer grünen Umgebung, die zu Spaziergängen und zum Ausruhen einlädt."
    ],
    "en": [
      "La Bâtie Rolland, surrounded by its two rivers, the Jabron and the Vermenon, is set in lush greenery, inviting you to stroll and relax."
    ],
    "it": [
      "La Bâtie Rolland, circondata dai suoi due fiumi, lo Jabron e il Vermenon, è situata in un ambiente verde e invita a fare una passeggiata e a rilassarsi."
    ],
    "fr": [
      "La Bâtie Rolland entouré par ses deux rivières le Jabron et le Vermenon situé dans un cadre de verdure vous invite à la balade et au repos."
    ],
    "es": [
      "La Bâtie Rolland, rodeada por sus dos ríos, el Jabron y el Vermenon, está situada en un entorno verde y le invita a pasear y relajarse."
    ],
    "nl": [
      "La Bâtie Rolland, omringd door zijn twee rivieren, de Jabron en de Vermenon, ligt in weelderig groen en nodigt uit tot een wandeling en ontspanning."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les rivières du Jabron et du Vermenon"
    ]
  },
