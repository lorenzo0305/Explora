  "rdfs:comment": {
    "de": [
      "Relais der interkommunalen Mediathek des Kantons Valgorge. Mitglied eines Netzwerks, das von den Gemeinden und dem Gemeindeverband Pays Beaume-Drobie organisiert wird. Mehr als 60.000 Werke, Bücher, CDs, DVDs, Hörbücher oder digitale Bücher erwarten Sie dort."
    ],
    "en": [
      "Relay of the Intercommunity Media Library of the Canton of Valgorge. Member of a network organized by the communes and the community of communes of the Pays Beaume-Drobie. More than 60,000 books, CDs, DVDs, audio books or digital books are waiting for you."
    ],
    "it": [
      "Rilancio della Mediateca Intercomunale del Cantone di Valgorge. Membro di una rete organizzata dai comuni e dalla comunità dei comuni del Pays Beaume-Drobie. Sono disponibili oltre 60.000 libri, CD, DVD, audiolibri e libri digitali."
    ],
    "fr": [
      "Relais de la Médiathèque Intercommunale du Canton de Valgorge. Membre d'un réseau organisé par les communes et la communauté de communes du Pays Beaume-Drobie. Plus de 60000 ouvrages, livres, CD, DVD, livres audio ou livres numériques, vous y attendent."
    ],
    "es": [
      "Relevo de la Mediateca Intercomunitaria del Cantón de Valgorge. Miembro de una red organizada por los municipios y la comunidad de municipios del Pays Beaume-Drobie. Hay más de 60.000 libros, CDs, DVDs, audiolibros y libros digitales disponibles."
    ],
    "nl": [
      "Bijgebouw van de intergemeentelijke mediatheek van het kanton Valgorge. Bibliotheek onderdeel van het netwerk van gemeentes in het Pays Beaume-Drobie. Meer dan 60.000 werken: boeken, cd's, dvd's, luisterboeken, e-boeken."
    ]
  },
