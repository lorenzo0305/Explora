  "rdfs:comment": {
    "de": [
      "Eine persönliche Initiative von Robert DURAND, einem leidenschaftlichen Sammler aus St Clair de la Tour, der seine Sammlungen in der alten Schule, in der seine Kinder zur Schule gegangen sind, für alle zugänglich macht."
    ],
    "en": [
      "A personal initiative of Robert DURAND, a passionate native of St Clair de la Tour, who opens his collections to all, in the former school of his children."
    ],
    "it": [
      "Un'iniziativa personale di Robert DURAND, un appassionato nativo di St Clair de la Tour, che apre le sue collezioni a tutti, nella vecchia scuola dove i suoi figli andavano a scuola."
    ],
    "fr": [
      "Une initiative personnel de Robert DURAND, un passionné natif de St Clair de la Tour, qui ouvre ses collections à tous, dans l’ancienne école dans laquelle ses enfants ont effectué leur scolarité."
    ],
    "es": [
      "Una iniciativa personal de Robert DURAND, apasionado nativo de St Clair de la Tour, que abre sus colecciones a todos, en la antigua escuela a la que iban sus hijos."
    ],
    "nl": [
      "Een persoonlijk initiatief van Robert DURAND, een gepassioneerde inwoner van St Clair de la Tour, die zijn collecties openstelt voor iedereen, in de oude school waar zijn kinderen naar school gingen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Passions museum - Le Foulon"
    ],
