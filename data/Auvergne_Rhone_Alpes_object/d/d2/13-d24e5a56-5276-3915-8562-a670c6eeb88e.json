  "rdfs:comment": {
    "de": [
      "? Hausgemachte Burger von hoher Qualität?\r\nHausgemachte Pommes frites\r\nHausgemachtes Fleisch Französisch (Hauptsächlich lokal)\r\nBio-Brot vom Handwerker\r\nKäse mit g.U. und Rohmilch\r\nHausgemachte Soßen"
    ],
    "en": [
      "? Quality homemade burgers ?\r\nHome fries\r\nHomemade French meats (mostly local)\r\nOrganic artisan bread\r\nPDO cheese and raw milk\r\nHomemade sauces"
    ],
    "it": [
      "? Hamburger di qualità fatti in casa?\r\nPatatine fritte fatte in casa\r\nCarni francesi fatte in casa (principalmente locali)\r\nPane biologico artigianale\r\nFormaggio DOP e latte crudo\r\nSalse fatte in casa"
    ],
    "fr": [
      "� Burger maison de qualité �\r\nFrites maison\r\nViandes maison Française (Principalement local)\r\nPain bio de l'artisan\r\nFromage AOP et lait cru\r\nSauces maison"
    ],
    "nl": [
      "? Kwaliteitsvolle zelfgemaakte hamburgers ?\r\nHuisgemaakte frietjes\r\nHuisgemaakte vleeswaren (voornamelijk lokaal)\r\nBiologisch brood van de ambachtsman\r\nBOB kaas en rauwe melk\r\nHuisgemaakte sauzen"
    ],
    "es": [
      "? Hamburguesas caseras de calidad ?\r\nPatatas fritas caseras\r\nCarnes francesas caseras (principalmente locales)\r\nPan ecológico artesano\r\nQuesos DOP y leche cruda\r\nSalsas caseras"
    ]
  },
