  "rdfs:comment": {
    "de": [
      "Das gesamte Team des Fremdenverkehrsamts steht Ihnen zur Verfügung, um Ihnen bei der Organisation Ihres Aufenthalts in der Region zu helfen, Sie über Feierlichkeiten und Sehenswürdigkeiten zu informieren..."
    ],
    "en": [
      "The whole team at the Tourist Office is at your disposal to help you organize your stay in the area, provide information on festivities and sites to visit..."
    ],
    "it": [
      "L'intero team dell'Ufficio del Turismo è a vostra disposizione per aiutarvi a organizzare il vostro soggiorno nella zona, per informarvi sulle feste e sui siti da visitare..."
    ],
    "fr": [
      "Toute l'équipe de l'Office de Tourisme se tient à votre disposition pour vous aider à organiser votre séjour sur le territoire, vous renseigner sur les festivités et les sites à visiter..."
    ],
    "es": [
      "Todo el equipo de la Oficina de Turismo está a su disposición para ayudarle a organizar su estancia en la zona, para informarle sobre las fiestas y los sitios a visitar..."
    ],
    "nl": [
      "Het hele team van het Office du Tourisme staat klaar om je te helpen bij het organiseren van je verblijf in de omgeving, geeft informatie over festiviteiten en plaatsen om te bezoeken..."
    ]
  },
