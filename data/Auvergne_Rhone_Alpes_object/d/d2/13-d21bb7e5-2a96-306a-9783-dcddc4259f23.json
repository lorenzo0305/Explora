  "rdfs:comment": {
    "de": [
      "Pomélou Bourgoin-Jallieu ist ein Spielzimmer für Kleinkinder ab 10 Monaten bis 6 Jahren, das der Förderung der Entwicklung und der Motorik gewidmet ist.\r\n\r\n."
    ],
    "en": [
      "Pomélou Bourgoin-Jallieu is an early-learning and motor skills playroom for toddlers from 10 months to 6 years.\r\n\r\n."
    ],
    "it": [
      "Pomélou Bourgoin-Jallieu è una ludoteca per l'apprendimento precoce e le abilità motorie dei bambini dai 10 mesi ai 6 anni.\r\n\r\n."
    ],
    "fr": [
      "Pomélou Bourgoin-Jallieu est une salle de jeux d'éveil et de motricité dédiée aux tout-petits dès 10 mois et jusqu'à 6 ans. \r\n\r\n."
    ],
    "nl": [
      "Pomélou Bourgoin-Jallieu is een speelzaal voor vroegtijdig leren en motoriek voor peuters van 10 maanden tot 6 jaar.\r\n\r\n."
