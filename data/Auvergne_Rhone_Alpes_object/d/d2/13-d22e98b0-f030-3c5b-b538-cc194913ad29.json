  "rdfs:comment": {
    "de": [
      "Nur 15 Minuten vom Zentrum Lyons bietet die Cuisine-à-manger des Ermitage einen verblüffenden Rahmen zum \"besser essen\". Ein Saal und zahlreiche Terrassen mit Panoramablick, eine erfinderische Küche, welche die Saisons respektiert."
    ],
    "en": [
      "Located just 15 minutes from Lyon city centre, the Cuisine-à-manger de l’Ermitage offers a breathtaking setting for lovers of fine food, dining room and numerous terraces with panoramic views, an inventive cuisine designed to match the seasons."
    ],
    "it": [
      "A soli 15 minuti dal centro di Lione, la Cuisine-à-manger dell'Ermitage offre un'ambientazione sorprendente per «mangiar meglio». Una sala e numerose terrazze con viste panoramiche, una cucina inventiva che rispetta il ritmo delle stagioni."
    ],
    "fr": [
      "À seulement 15 minutes du centre de Lyon, la Cuisine-à-manger de l’Ermitage offre un cadre époustouflant pour « mieux manger », une salle et de nombreuses terrasses aux vues panoramiques, une cuisine inventive qui respecte les saisons."
    ],
    "nl": [
      "Op slechts 15 minuten van het centrum van Lyon biedt de Cuisine-à-manger de l'Ermitage een adembenemend kader voor \"beter eten\", een zaal en talrijke terrassen met panoramisch uitzicht, en een inventieve keuken die de seizoenen respecteert."
    ],
    "es": [
      "A tan sólo 15 minutos del centro de Lyon, el restaurante Cuisine-à-manger del Ermitage ofrece un entorno asombroso para \"comer mejor\". Ofrecemos a nuestros clientes una sala y varias terrazas con vistas panorámicas, además de una cocina inventiva que respeta las estaciones."
    ]
  },
