  "rdfs:comment": {
    "de": [
      "Base Nature Vercors ist ein Verein, der die Freude am Leben in der Natur fördert und die lokale Bevölkerung dafür sensibilisiert, die Biodiversität, von der wir alle ein Teil sind, zu respektieren.  Der Verein organisiert regelmäßig kulturelle Veranstaltungen."
    ],
    "en": [
      "Base Nature Vercors is an association that promotes the joy of living in the great outdoors, and raises awareness among the local population of the need to respect biodiversity, of which we are all a part.  It regularly organizes cultural events."
    ],
    "it": [
      "Base Nature Vercors è un'associazione che promuove le gioie della vita all'aria aperta e incoraggia la popolazione locale a rispettare la biodiversità, di cui tutti facciamo parte.  Organizza regolarmente eventi culturali."
    ],
    "fr": [
      "Base Nature Vercors est une association qui promeut la joie de vivre en pleine nature et sensibilise la population locale à respecter la biodiversité, dont tous, en-faisons partie.  Elle organise régulièrement des événements culturels."
    ],
    "nl": [
      "Base Nature Vercors is een vereniging die het plezier van het buitenleven promoot en de lokale bevolking aanmoedigt om de biodiversiteit, waar we allemaal deel van uitmaken, te respecteren.  Er worden regelmatig culturele evenementen georganiseerd."
    ],
    "es": [
      "Base Nature Vercors es una asociación que promueve el placer de vivir al aire libre y anima a la población local a respetar la biodiversidad, de la que todos formamos parte.  Organiza regularmente actos culturales."
    ]
  },
  "rdfs:label": {
