  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Jean-Baptiste de Rac dominiert die Ebene von Malataverne. Sie wurde zunächst als Taufkirche genutzt, bevor sie zur Pfarrkirche wurde. Die Kirche ist etwa acht Jahrhunderte alt und hat verschiedene Bau- und Renovierungsphasen durchlaufen."
    ],
    "en": [
      "The church of Saint Jean-Baptiste de Rac overlooks the plain of Malataverne. It was originally a baptismal church before becoming a parish church. Around eight centuries old, it has undergone various periods of construction and renovation."
    ],
    "it": [
      "La chiesa di Saint Jean-Baptiste de Rac domina la piana di Malataverne. Prima di diventare parrocchia, era una chiesa battesimale. Ha circa otto secoli e ha subito vari periodi di costruzione e ristrutturazione."
    ],
    "fr": [
      "L’église Saint Jean-Baptiste de Rac domine la plaine de Malataverne. Elle fut d’abord baptismale avant d’être paroissiale. Âgée d’environ huit siècles, elle a traversé différentes périodes de construction et de rénovation."
    ],
    "es": [
      "La iglesia de San Juan Bautista de Rac domina la llanura de Malataverne. Primero fue una iglesia bautismal antes de convertirse en una iglesia parroquial. Tiene unos ocho siglos de antigüedad y ha pasado por varios periodos de construcción y renovación."
    ],
    "nl": [
      "De kerk Saint Jean-Baptiste de Rac kijkt uit over de vlakte van Malataverne. Het was oorspronkelijk een doopkerk voordat het een parochiekerk werd. Ze is ongeveer acht eeuwen oud en heeft verschillende bouw- en renovatieperiodes gekend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hameau du RAC"
    ]
  },
