  "rdfs:comment": {
    "de": [
      "Ein kreativer, gastronomisch inspirierter Tisch, frische und lokale Produkte, eine saisonal wechselnde Speisekarte, eine Gourmet-Parenthese in einem neuen, auf die umliegenden Seen geöffneten Schmuckkästchen"
    ],
    "en": [
      "A gourmet-inspired creative table, fresh local produce, a menu that changes with the seasons, a gourmet interlude in a new setting overlooking the surrounding mountains"
    ],
    "it": [
      "Un ristorante creativo di ispirazione gastronomica, prodotti freschi locali, un menu che cambia con le stagioni, una parentesi gourmet in un nuovo ambiente con vista sulle montagne circostanti"
    ],
    "fr": [
      "Une table créative d'inspiration gastronomique, des produits frais et locaux, une carte renouvelée au fil des saisons, une parenthèse gourmande dans un nouvel écrin ouvert sur les sucs environnants"
    ],
    "es": [
      "Un restaurante de inspiración gastronómica creativa, productos locales frescos, un menú que cambia con las estaciones, un interludio gourmet en un nuevo entorno con vistas a las montañas circundantes"
    ],
    "nl": [
      "Een creatief, gastronomisch geïnspireerd restaurant, verse lokale producten, een menu dat met de seizoenen mee verandert, een gastronomisch intermezzo in een nieuwe omgeving met uitzicht op de omliggende bergen"
    ]
  },
  "rdfs:label": {
