  "rdfs:comment": {
    "de": [
      "Architektin, Malerin und Kunsthistorikerin, ausgebildet am Centre International du Vitrail de Chartres, arbeite ich an der Restaurierung des Glasmalerei-Erbes sowie an der Gestaltung von Glasmalereien. Ich biete auch Fortbildungskurse und Projektbegleitung an."
    ],
    "en": [
      "Architect, painter and art historian, trained at the Centre International du Vitrail de Chartres, I work on the restoration of stained glass heritage as well as on its creation. I also offer training courses and project follow-up."
    ],
    "it": [
      "Architetto, pittore e storico dell'arte formatosi al Centre International du Vitrail de Chartres, mi occupo del restauro del patrimonio vetrario e di lavori creativi. Offro anche corsi di formazione e follow-up di progetti."
    ],
    "fr": [
      "Architecte, peintre et historienne de l’art,  formée au Centre International du Vitrail de Chartres, j'interviens en restauration du patrimoine vitrail ainsi qu'en création. Je propose également des stages de formations et des suivis de projets."
    ],
    "es": [
      "Arquitecto, pintor e historiador del arte formado en el Centre International du Vitrail de Chartres, me dedico a la restauración del patrimonio vitral, así como a la creación. También ofrezco cursos de formación y seguimiento de proyectos."
    ],
    "nl": [
      "Als architect, schilder en kunsthistoricus, opgeleid aan het Centre International du Vitrail de Chartres, werk ik zowel aan de restauratie van glas-in-lood erfgoed als aan creatief werk. Ik bied ook opleidingen en projectopvolging aan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Entre Verre et Lumière"
    ]
  },
