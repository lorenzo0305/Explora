  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes Villard de Lans findet im Grand Hôtel de Paris ein Qualitätsrestaurant mit dem statt, in dem Sie Ihr Abendessen als Liebhaber, Ihr Familientreffen, Ihre Mahlzeiten mit Freunden begrüssen***."
    ],
    "en": [
      "In the center of Villard de Lans, a high quality restaurant  welcomes your romantic dinner, your family reunion, your meal with friends in the majestic setting of the Grand Hotel de Paris***."
    ],
    "it": [
      "Un ristorante di qualità con il marchio \"Maître Restaurateur\" accoglie le vostre cene romantiche, le riunioni di famiglia e i pasti con gli amici nella maestosa cornice del Best Western Grand Hôtel de Paris."
    ],
    "fr": [
      "Un restaurant de qualité labellisé \"Maître Restaurateur\" accueille vos dîners en amoureux, vos retrouvailles familiales, vos repas entre amis, dans le cadre majestueux du Best Western Grand Hôtel de Paris."
    ],
    "es": [
      "Un restaurante de calidad con el sello \"Maître Restaurateur\" acoge sus cenas románticas, reuniones familiares y comidas con amigos en el majestuoso marco del Best Western Grand Hôtel de Paris."
    ],
    "nl": [
      "Een kwaliteitsrestaurant met het label \"Maître Restaurateur\" verwelkomt uw romantische diners, familiereünies en maaltijden met vrienden in de majestueuze omgeving van het Best Western Grand Hôtel de Paris."
    ]
  },
