  "rdfs:comment": {
    "de": [
      "Im Mittelalter war die Rue Mercière eine der wichtigsten Straßen Lyons. Heute ist sie eine belebte Straße, die an die Renaissance-Vergangenheit der Halbinsel erinnert."
    ],
    "en": [
      "One of the most important streets of Lyon in the Middle Ages, Mercière street is today a lively street that recalls the Renaissance past of the Presqu'île."
    ],
    "it": [
      "Una delle vie più importanti di Lione nel Medioevo, rue Mercière è oggi una strada vivace che ricorda il passato rinascimentale della Presqu'île."
    ],
    "fr": [
      "Une des plus importantes rues de Lyon au Moyen-Age, la rue Mercière est aujourd'hui une rue animée qui rappelle le passé Renaissance de la Presqu'île."
    ],
    "es": [
      "La calle Mercière, una de las más importantes de Lyon en la Edad Media, es hoy una animada calle que recuerda el pasado renacentista de la Presqu'île."
    ],
    "nl": [
      "De rue Mercière, een van de belangrijkste straten van Lyon in de middeleeuwen, is tegenwoordig een levendige straat die herinnert aan het renaissanceverleden van het Presqu'île."
    ]
  },
