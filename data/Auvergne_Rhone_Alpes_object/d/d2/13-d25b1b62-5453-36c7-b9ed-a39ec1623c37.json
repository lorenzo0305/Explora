  "rdfs:comment": {
    "de": [
      "Der Bauernhof \"Le vent des cimes\" zeichnet sich durch eine traditionelle Bewirtschaftung und den Einsatz moderner Techniken aus, die die Umwelt, die Tiere und die Menschen respektieren."
    ],
    "en": [
      "The farm \"Le vent des cimes\" is distinguished by traditional management and the use of modern techniques that respect the environment, animals and people."
    ],
    "it": [
      "La fattoria \"Le vent des cimes\" si distingue per la sua gestione tradizionale e l'uso di tecniche moderne che rispettano l'ambiente, gli animali e le persone."
    ],
    "fr": [
      "La ferme «Le vent des cimes» se distingue par une gestion traditionnelle et l’utilisation de techniques modernes respectueuses de l’environnement, des animaux et des hommes."
    ],
    "es": [
      "La granja \"Le vent des cimes\" se distingue por su gestión tradicional y el uso de técnicas modernas que respetan el medio ambiente, los animales y las personas."
    ],
    "nl": [
      "De boerderij \"Le vent des cimes\" onderscheidt zich door zijn traditionele beheer en het gebruik van moderne technieken die het milieu, de dieren en de mensen respecteren."
    ]
  },
