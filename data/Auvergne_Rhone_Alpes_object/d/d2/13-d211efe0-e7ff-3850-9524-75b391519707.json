  "rdfs:comment": {
    "de": [
      "Barrierefreie Route, Crête de la Série und Pierre Rousse beginnt im symbolträchtigen Dorf Puygiron, bevor es über den Crête de la Série in Richtung des Schlosses von Rochefort-en-Valdaine geht. Ein spielerischer Weg mit mehreren Aussichtspunkten."
    ],
    "en": [
      "An accessible route, Crête de la Série and Pierre Rousse starts from the emblematic village of Puygiron before heading towards the Château de Rochefort-en-Valdaine via the Crête de la Série. A fun trail with several viewpoints."
    ],
    "it": [
      "Percorso accessibile, Crête de la Série e Pierre Rousse parte dall'emblematico villaggio di Puygiron per poi dirigersi verso il Castello di Rochefort-en-Valdaine attraverso la Crête de la Série. Un percorso divertente con diversi punti di osservazione."
    ],
    "fr": [
      "Itinéraire accessible, Crête de la Série et Pierre Rousse part du village emblématique de Puygiron avant de se diriger vers le Château de Rochefort-en-Valdaine par la crête de la Série. Un chemin ludique avec plusieurs points de vue."
    ],
    "es": [
      "Una ruta accesible, la Crête de la Série y Pierre Rousse parte del emblemático pueblo de Puygiron antes de dirigirse hacia el Château de Rochefort-en-Valdaine por la Crête de la Série. Un divertido sendero con varios miradores."
    ],
    "nl": [
      "Crête de la Série en Pierre Rousse is een toegankelijke route die begint in het emblematische dorp Puygiron en vervolgens naar het kasteel van Rochefort-en-Valdaine gaat via de Crête de la Série. Een leuke route met verschillende uitkijkpunten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crête de la Série de Pierre Rousse"
    ]
  },
