  "rdfs:comment": {
    "de": [
      "Baludik ist eine lebensgroße Schnitzeljagd im Herzen des Kartäuserklosters Sainte-Croix-en-Jarez. Die Anwendung kann direkt von der Website von Baludik heruntergeladen werden. Sie ist das ganze Jahr über verfügbar."
    ],
    "en": [
      "Baludik is a life-size treasure hunt at the heart of the Sainte-Croix-en-Jarez Chartreuse site. The application can be downloaded directly from the Baludik website. It is therefore available all year round, independently."
    ],
    "it": [
      "Baludik è una caccia al tesoro a grandezza naturale nel cuore della Certosa di Sainte-Croix-en-Jarez. L'applicazione può essere scaricata direttamente dal sito web di Baludik. È quindi disponibile tutto l'anno, in autonomia."
    ],
    "fr": [
      "Baludik, c’est un jeu de piste grandeur nature au cœur du Site de la Chartreuse Sainte-Croix-en-Jarez. L’application se télécharge directement sur le site de Baludik. Elle est donc disponible toute l’année, en autonomie."
    ],
    "nl": [
      "Baludik is een levensgrote schattenjacht in het hart van het Charterhuis van Sainte-Croix-en-Jarez. De applicatie kan rechtstreeks van de website van Baludik worden gedownload. Het is dus het hele jaar door beschikbaar, in je eentje."
    ],
    "es": [
      "Baludik es una búsqueda del tesoro a tamaño real en el corazón de la Cartuja de Sainte-Croix-en-Jarez. La aplicación puede descargarse directamente del sitio web de Baludik. Así que está disponible todo el año, por su cuenta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baludik : le jeu de piste familial"
    ]
  },
