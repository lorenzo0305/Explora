      "@id": "https://data.datatourisme.fr/2c689335-6cdf-3bc8-b8a9-1056693d1b6a",
      "dc:description": {
        "de": [
          "Dienstleistungen :\n-  Tabak, elektronische Zigaretten und Flüssigkeiten,\n-  Lotto, Amigo, Rubbelspiele FDJ, Pmu,\n-  Presse,\n-  Lebensmittelgeschäft\n-  Brötchenaufbewahrung ,\n-  Poststation, Pick up-Relais,\n - Nickel-Konto,\n-  Nahbezahlung Steuern, Kindergarten,\n-  Steuermarken und Bußgelder."
        ],
        "en": [
          "Services :\n-  Tobacco, E-cigarettes and liquids,\n-  Loto, amigo, FDJ scratch cards, Pmu,\n-  Press,\n-  Grocery\n-  Bread depot ,\n-  Relais Poste, Relais Pick up,\n - Nickel account,\n-  Local tax payments, crèche...,\n-  Tax stamps and fines."
        ],
        "it": [
          "Servizi :\n-  Tabacco, sigarette elettroniche e liquidi,\n-  Loto, amigo, gratta e vinci FDJ, Pmu,\n-  Giornali,\n-  Drogheria\n-  Deposito pane ,\n-  Relais Poste, Relais Pick up,\n - Conto Nickel,\n-  Pagamento tasse locali, asilo nido...,\n-  Bolli e multe."
        ],
        "fr": [
          "Services : \n-  Tabac,  Cigarettes électroniques et les liquides, \n-  Loto, amigo, jeux à gratter FDJ, Pmu, \n-  Presse, \n-  Épicerie\n-  Dépôt de pains , \n-  Relais Poste,  Relais Pick up, \n - Compte Nickel, \n-  Paiement de proximité impôts,  crèche...,\n-  Timbres fiscaux et amendes."
        ],
        "es": [
          "Servicios :\n-  Tabaco, E-cigarrillos y líquidos,\n-  Loto, amigo, tarjetas rasca y gana FDJ, Pmu,\n-  Periódicos,\n-  Alimentación\n-  Depósito de pan ,\n-  Relais Poste, Relais Pick up,\n - Cuenta de níquel,\n-  Pago de impuestos locales, guardería..,\n-  Sellos fiscales y multas."
        ],
        "nl": [
          "Diensten :\n-  Tabak, E-sigaretten en vloeistoffen,\n-  Loto, amigo, FDJ krasloten, Pmu,\n-  Kranten,\n-  Kruidenierswinkel\n-  Brooddepot ,\n-  Relais Poste, Relais Pick up,\n - Nikkel rekening,\n-  Lokale belastingbetalingen, crèche...,\n-  Belastingzegels en boetes."
        ]
      },
