  "rdfs:comment": {
    "de": [
      "Kommunaler Standort, der das ganze Jahr über zugänglich ist. Start der Rundwege von der Wasserfläche aus. Zugang abends für Autos gesperrt. Baden ist nicht erlaubt. Tische für Picknicks. Überdachter und offener Hors-Sac-Raum. Teich: 60 m lang, 3 m breit, 9 m tief."
    ],
    "en": [
      "Site devoted to walks and fishing with picnic tables. Swimming is forbidden. Covered but open area to eat your own picnic. No access to cars in the evening. Many walks start here."
    ],
    "it": [
      "Sito locale accessibile tutto l'anno. Le escursioni partono dal lago. Accesso chiuso alle auto la sera. Divieto di balneazione. Tavoli da picnic. Sala hors-sac coperta e aperta. Laghetto lungo 60 m, largo 3 m, profondo 9 m."
    ],
    "fr": [
      "Site communal accessible toute l'année. Départ des circuits depuis le plan d'eau. Accès  fermé en soirée pour les voitures. Baignade interdite. Tables de pique-nique. Salle hors-sac couverte et ouverte. Étang de 60m de long, 3m de large, 9m de profondeur."
    ],
    "es": [
      "Sitio local accesible todo el año. Las excursiones parten del lago. Acceso cerrado a los coches por la noche. Prohibido bañarse. Mesas de picnic. Hors-sac cubierto y abierto. Estanque de 60 m de largo, 3 m de ancho y 9 m de profundidad."
    ],
    "nl": [
      "Lokale site die het hele jaar door toegankelijk is. Rondleidingen vertrekken vanaf het meer. Toegang 's avonds gesloten voor auto's. Zwemmen verboden. Picknicktafels. Overdekte en open hors-sac ruimte. Vijver 60m lang, 3m breed, 9m diep."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lake"
    ],
    "fr": [
      "Plan d'eau"
    ]
  },
