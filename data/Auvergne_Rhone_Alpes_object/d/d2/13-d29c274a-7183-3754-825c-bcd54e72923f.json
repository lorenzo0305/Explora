  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einem Musikkurs mit dem Ensemble Varsågod teil, der sich auf das traditionelle skandinavische Repertoire konzentriert. Ensemblemusik, Nyckelharpa und die Arbeit am gemeinsamen Spiel: ein Eintauchen für Musiker, die ihre Praxis bereichern und einen Moment teilen möchten."
    ],
    "en": [
      "Join the Varsågod ensemble for music workshops based on the traditional Scandinavian repertoire. Ensemble music, nyckelharpa and collective playing: an immersion for musicians wishing to enrich their practice and share a moment."
    ],
    "it": [
      "Partecipate ai corsi di musica basati sul repertorio tradizionale scandinavo con l'ensemble Varsågod. Musica d'insieme, nyckelharpa e suono di gruppo: un'esperienza coinvolgente per i musicisti che vogliono migliorare le proprie capacità e condividere un momento con gli altri."
    ],
    "fr": [
      "Participez à des stages de musique autour du répertoire traditionnel scandinave avec l’ensemble Varsågod. Musique d’ensemble, nyckelharpa et travail du jeu collectif : une immersion pour musiciens souhaitant enrichir leur pratique et partager un moment."
    ],
    "es": [
      "Participe en cursos de música basados en el repertorio tradicional escandinavo con el conjunto Varsågod. Música de conjunto, nyckelharpa e interpretación en grupo: una experiencia envolvente para músicos que quieran mejorar sus habilidades y compartir un momento con los demás."
    ],
    "nl": [
      "Neem deel aan muziekcursussen gebaseerd op het traditionele Scandinavische repertoire met het Varsågod ensemble. Ensemblemuziek, nyckelharpa en samenspel: een meeslepende ervaring voor muzikanten die hun vaardigheden willen verbeteren en een moment met anderen willen delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de musique avec Varsagod"
    ]
  },
