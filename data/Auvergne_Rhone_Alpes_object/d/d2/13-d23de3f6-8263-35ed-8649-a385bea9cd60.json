  "rdfs:comment": {
    "de": [
      "In unserem Shop finden Sie unsere frischen Tommes, unsere Dieulefit-Köstlichkeiten, und unsere Picodons in der art  von Dieulefit sowie eine Auswahl regionaler Produkte."
    ],
    "en": [
      "We sell a wide range of products in our shop: tome cheese, picodons as well as regional products."
    ],
    "it": [
      "Nel nostro negozio troverete le nostre tome fresche, le nostre delizie di Dieulefit, i nostri picodons e picodons méthode de Dieulefit e una selezione di prodotti regionali."
    ],
    "fr": [
      "Dans notre boutique vous trouverez nos tommes fraîches, nos délices de Dieulefit, nos picodons et picodons méthode de dieulefit ainsi qu'une sélection de produits régionaux."
    ],
    "nl": [
      "In onze winkel vind je onze verse tommes, onze Dieulefit lekkernijen, onze picodons en picodons méthode de dieulefit, evenals een selectie van regionale producten."
    ],
    "es": [
      "En nuestra tienda encontrará nuestros tommes frescos, nuestras delicias de Dieulefit, nuestros picodons y picodons méthode de Dieulefit, así como una selección de productos regionales."
    ]
  },
