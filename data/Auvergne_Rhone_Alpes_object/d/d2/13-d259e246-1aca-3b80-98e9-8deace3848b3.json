  "rdfs:comment": {
    "de": [
      "Das gesamte Fondus-Team freut sich, Sie in dieser neuen Saison begrüssen zu dürfen.\r\nEntdecken Sie die Atmosphäre und den Charme der Berge in diesem savoyischen Restaurant."
    ],
    "en": [
      "The whole Fondus team is pleased to welcome you for this new season.\r\nRediscover the atmosphere and charm of the mountains thanks to this Savoyard restaurant."
    ],
    "it": [
      "Vivete l'atmosfera e il fascino delle montagne in questo ristorante savoiardo. L'arredamento interno ed esterno vi farà immergere direttamente nell'atmosfera delle stazioni sciistiche."
    ],
    "fr": [
      "Retrouvez l’ambiance et le charme des montagnes grâce à ce restaurant savoyard. La décoration intérieure et extérieure vous plongera directement dans l’ambiance des stations de ski."
    ],
    "es": [
      "Viva el ambiente y el encanto de la montaña en este restaurante saboyano. La decoración interior y exterior le sumergirá directamente en el ambiente de las estaciones de esquí."
    ],
    "nl": [
      "Herontdek de sfeer en charme van de bergen in dit Savoyaardse restaurant. De binnen- en buitendecoratie dompelt u direct onder in de sfeer van de skigebieden."
    ]
  },
