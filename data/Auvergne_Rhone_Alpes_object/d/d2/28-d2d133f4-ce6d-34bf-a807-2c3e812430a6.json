  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Hotel in der Nähe von AMIENS mit herzlichem Empfang, das sich sowohl für Familienaufenthalte als auch für Geschäftsreisen eignet."
    ],
    "en": [
      "Discover this hotel, close to AMIENS, with its warm welcome and suitable for family stays and business trips."
    ],
    "it": [
      "Scoprite questo hotel, vicino ad AMIENS, dall'accoglienza calorosa e adatto a soggiorni in famiglia e viaggi d'affari."
    ],
    "fr": [
      "Découvrez cet hôtel, proche d'AMIENS à l'accueil chaleureux et adapté pour les séjours en famille et les déplacements professionnels."
    ],
    "nl": [
      "Ontdek dit hotel, dicht bij AMIENS, met zijn warme onthaal en geschikt voor familieverblijven en zakenreizen."
    ],
    "es": [
      "Descubra este hotel, cerca de AMIENS, con su cálida acogida y adecuado para estancias familiares y viajes de negocios."
    ]
