  "rdfs:comment": {
    "de": [
      "Willkommen im Repaire de Pré Argent, einem überwachten Strand für alle Altersgruppen. Wasser- und Landspielbereiche, Verleih von riesigen Schwimmmatten und Mini-Booten. Freizeitbereich, Volleyballfeld. Picknicktische im schattigen Park."
    ],
    "en": [
      "Welcome to Le Repaire de Pré Argent, a supervised beach for all ages. Water and land play areas, giant floating mat and mini-boat rentals. Leisure space, volleyball court. Picnic tables in the shaded park."
    ],
    "it": [
      "Benvenuti a Le Repaire de Pré Argent, una spiaggia sorvegliata per tutte le età. Aree di gioco in acqua e a terra, materassini galleggianti giganti e mini-imbarcazioni a noleggio. Area ricreativa, campo da pallavolo. Tavoli da picnic nel parco ombreggiato."
    ],
    "fr": [
      "Bienvenue au Repaire de Pré Argent, une plage surveillée pour tous les âges. Aire de jeux aquatiques et terrestres, location de tapis flottants géants et mini-bateaux. Espace de loisirs, terrain de volley. Tables de pique-nique dans le parc ombragé."
    ],
    "nl": [
      "Welkom bij Le Repaire de Pré Argent, een bewaakt strand voor alle leeftijden. Water- en landspelzones, verhuur van gigantische drijvende matten en mini-boten. Recreatiegebied, volleybalveld. Picknicktafels in het schaduwrijke park."
    ],
    "es": [
      "Bienvenido a Le Repaire de Pré Argent, una playa vigilada para todas las edades. Zonas de juegos acuáticos y terrestres, colchonetas flotantes gigantes y minibotes de alquiler. Zona de ocio, pista de voleibol. Mesas de picnic en el parque a la sombra."
    ]
  },
  "rdfs:label": {
