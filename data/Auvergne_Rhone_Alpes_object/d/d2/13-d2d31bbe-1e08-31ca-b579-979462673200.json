  "rdfs:comment": {
    "de": [
      "Mittags und abends hausgemachte Küche aus biologischen, frischen und lokalen Produkten.\r\nNachmittags Erfrischungen, Eis und Gebäck.\r\nReservierung erwünscht 07.44.99.41.55\r\n."
    ],
    "en": [
      "Lunch and dinner, home cooking with organic, fresh and local produce\r\nAfternoon refreshments, ice creams and pastries\r\nReservations required 07.44.99.41.55\r\n."
    ],
    "it": [
      "Pranzo e cena: piatti cucinati in casa con prodotti freschi, locali e biologici.\r\nRinfresco pomeridiano, gelati e dolci.\r\nPrenotazione obbligatoria.\r\n."
    ],
    "fr": [
      "Midi et soir, cuisine maison de produits bio, frais et locaux. \r\nL'après-midi, rafraichissements, glaces et pâtisseries.\r\nRéservation souhaitée.\r\n."
    ],
    "nl": [
      "Lunch en diner: huisgemaakte gerechten met biologische, verse en lokale producten\r\nMiddag verfrissingen, ijs en gebak\r\nReserveren noodzakelijk 07.44.99.41.55\r\n."
    ],
    "es": [
      "Comida y cena: platos caseros con productos frescos, locales y ecológicos.\r\nRefrescos por la tarde, helados y pasteles.\r\nEs necesario reservar.\r\n."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cabanon du Poët"
    ]
  },
