          "additionalInformation": {
            "de": [
              "Mittwoch: 14.30 bis 22.30 Uhr\r\nGeöffnet von Ostern bis Ende September, außer an Tagen mit schlechtem Wetter, da der Cabanon nur über eine Außenterrasse verfügt."
            ],
            "en": [
              "Wednesday: 2:30 pm to 10:30 pm\r\nOpen from Easter to the end of September, except on bad weather days, as the Cabanon has only an outdoor terrace."
            ],
            "it": [
              "Mercoledì: dalle 14.30 alle 22.30\r\nAperto da Pasqua a fine settembre, tranne nei giorni di maltempo, poiché il Cabanon dispone solo di una terrazza esterna."
            ],
            "fr": [
              "Mercredi : 14h30 à 22h30\r\nOuverture de Pâques à fin septembre, en dehors des jours de mauvais temps car le Cabanon ne dispose que d'une terrasse extérieure."
            ],
            "nl": [
              "Woensdag: 14.30 tot 22.30 uur\r\nGeopend van Pasen tot eind september, behalve op dagen met slecht weer, want Cabanon heeft alleen een buitenterras."
            ],
            "es": [
              "Miércoles: de 14.30 h a 22.30 h\r\nAbierto de Semana Santa a finales de septiembre, excepto los días de mal tiempo, ya que el Cabanon sólo dispone de terraza exterior."
            ]
          },
