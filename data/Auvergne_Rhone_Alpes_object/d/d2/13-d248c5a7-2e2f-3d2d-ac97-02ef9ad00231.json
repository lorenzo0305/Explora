  "rdfs:comment": {
    "de": [
      "Fest in La Gravière mit Flohmarkt, Boule-Wettbewerb um 14 Uhr und Konzert um 16 Uhr.\r\nEssen und Trinken vor Ort und verschiedene Animationen\r\nAm Abend kostenloser Ball und Karaoke"
    ],
    "en": [
      "Fête à la Gravière with garage sale, pétanque competition at 2pm and concert at 4pm.\r\nCatering and refreshments on site, plus various entertainment\r\nIn the evening, free dance and karaoke"
    ],
    "it": [
      "Festa alla Gravière con vendita di garage, gara di bocce alle 14:00 e concerto alle 16:00.\r\nStand gastronomici e di ristoro sul posto e intrattenimento vario\r\nIn serata, ballo e karaoke gratuiti"
    ],
    "fr": [
      "Fête à la Gravière avec vide grenier, concours de pétanque à 14h et concert à 16h. \r\nRestauration et buvette sur place et divers animations\r\nEn soirée bal gratuit et karaoké"
    ],
    "es": [
      "Fiesta en La Gravière con venta de garaje, concurso de petanca a las 14h y concierto a las 16h.\r\nPuestos de restauración y refrescos in situ y diversas animaciones\r\nPor la noche, baile libre y karaoke"
    ],
    "nl": [
      "Festival in La Gravière met een garageverkoop, petanquewedstrijd om 14.00 uur en concert om 16.00 uur.\r\nCatering- en drankkraampjes op het terrein en verschillende animaties\r\nS Avonds gratis dans en karaoke"
    ]
