  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4fbd18d5-2efe-32db-b268-913b88194e31",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Besuchen Sie die Website von Le Cellier des Arcades\n\n\nTage der Öffnung:\nMontags von 15:00 bis 18:30 Uhr\nDienstag bis Samstag von 9.30 bis 19 Uhr\nSonntag von 9:30 bis 12:30 Uhr\n\nBestellungen :\n\nBestellungen können über die Website von Le Cellier des Arcades oder telefonisch unter 03 21 23 09 28 aufgegeben werden\n\nLieferung :\n\nKontaktieren Sie den Händler, um die Liefermodalitäten je nach Ihrer Situation zu erfahren\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Visit the Le Cellier des Arcades website\n\n\nOpening days:\nMonday from 3pm to 6:30pm\nTuesday to Saturday, 9:30am to 7pm\nSunday from 9:30 am to 12:30 pm\n\nOrders :\n\nOrders can be placed via the Le Cellier des Arcades website or by telephone on 03 21 23 09 28\n\nDelivery :\n\nContact the shopkeeper for delivery details according to your situation\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Visita il sito web di Le Cellier des Arcades\n\n\nGiorni di apertura:\nLunedì dalle 15.00 alle 18.30\nDa martedì a sabato dalle 9.30 alle 19.00\nDomenica dalle 9.30 alle 12.30\n\nOrdini :\n\nLe ordinazioni possono essere effettuate sul sito web di Le Cellier des Arcades o per telefono al numero 03 21 23 09 28\n\nConsegna :\n\nContattare il negoziante per conoscere le modalità di consegna in base alla propria situazione\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: Consultez le site internet Le Cellier des Arcades\n\n\nJours d'ouverture: \nLe lundi de 15h à 18h30\nDu mardi au samedi de 9h30 à 19h\nLe dimanche de 9h30 à 12h30\n\nCommandes :\n\nLes commandes se font sur le site internet Le Cellier des Arcades ou par téléphone au 03 21 23 09 28\n\nLivraison :\n\nContacter le commerçant pour connaître les modalités de livraison en fonction de votre situation\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Bezoek de website van Le Cellier des Arcades\n\n\nOpeningsdagen:\nMaandag van 15.00 tot 18.30\nDinsdag tot zaterdag van 9.30 tot 19.00 uur\nZondag van 9.30 tot 12.30 uur\n\nBestellingen :\n\nBestellen kan via de website van Le Cellier des Arcades of telefonisch op 03 21 23 09 28\n\nLevering :\n\nNeem contact op met de winkelier voor informatie over de leveringsvoorwaarden in jouw situatie\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Visite la página web de Le Cellier des Arcades\n\n\nDías de apertura:\nLunes de 15:00 a 18:30\nDe martes a sábado de 9.30 h a 19 h\nDomingo de 9.30 h a 12.30 h\n\nPedidos :\n\nLos pedidos pueden realizarse en la página web de Le Cellier des Arcades o por teléfono llamando al 03 21 23 09 28\n\nEntrega :\n\nPóngase en contacto con el comerciante para informarse sobre las modalidades de entrega en función de su situación\n\n "
        ]
      },
