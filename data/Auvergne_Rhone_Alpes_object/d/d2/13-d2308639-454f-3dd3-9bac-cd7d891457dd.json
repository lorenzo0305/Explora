  "rdfs:comment": {
    "de": [
      "OnlyKart: ultra-moderne Innenkomplex für ein elektrische Kart-Erfahrung. OnlySki: Skihalle das ganze Jahr geöffnet. Thrills garantiert, weniger als 20 Minuten von Lyon! OnlyBowling"
    ],
    "en": [
      "OnlyKart: ultra-modern indoor complex for an electric karting experience.\r\nOnlySki: indoor ski slope open all year. \r\nOnlyBowling since April 2018. \r\nThrills guaranteed, less than 20 min. from Lyon!"
    ],
    "it": [
      "OnlyKart: ultra-moderno complesso al coperto per sperimentare il kart elettrico. OnlySki : pista da sci al coperto aperto tutto l'anno. Emozioni garantite, a meno di 20 minuti da Lione! OnlyBowling"
    ],
    "fr": [
      "Nouveauté 2023 : Entièrement insonorisées et climatisées de 1 à 10 personnes, nos salles sont équipées de matériel haut de gamme dernière génération. Choisissez votre chanson parmi plus de 50 000 titres grâce à un écran tactile et un logiciel intuitif."
    ],
    "es": [
      "OnlyKart: Complejo de cubierta ultra-moderno para experimentar el kart eléctrico. OnlySki: pista de esquí cubierta abierta todo el año. Emociones garantizadas, a menos de 20 minutos de Lyon! OnlyBowling"
    ],
    "nl": [
      "Nieuw in 2023: Onze zalen zijn volledig geluiddicht en voorzien van airconditioning voor 1 tot 10 personen en zijn uitgerust met de nieuwste apparatuur van topklasse. Kies je nummer uit meer dan 50.000 titels met behulp van een touchscreen en intuïtieve software."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Only Karaoké"
    ]
  },
