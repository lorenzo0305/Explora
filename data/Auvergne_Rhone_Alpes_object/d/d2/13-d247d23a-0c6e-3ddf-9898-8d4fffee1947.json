  "rdfs:comment": {
    "de": [
      "Nicht überdachtes, solarbeheiztes öffentliches Schwimmbad, das im Sommer täglich geöffnet ist. Zugang für Personen mit eingeschränkter Mobilität mit einem Sessel, der ins Wasser gelassen wird, zur Verfügung. Empfang von Gruppen und Schulklassen möglich. Schwimmunterricht für Erwachsene und Kinder."
    ],
    "en": [
      "Uncovered, solar-heated municipal pool open daily in summer. Disabled access with wheelchair available. Groups and schools welcome. Swimming lessons for adults and children."
    ],
    "it": [
      "Piscina comunale scoperta, riscaldata a energia solare, aperta tutti i giorni in estate. Accesso per disabili con sedia a rotelle. Accoglienza di gruppi e scuole. Corsi di nuoto per adulti e bambini."
    ],
    "fr": [
      "Piscine municipale non couverte, chauffée au solaire, ouverte tous les jours en été. Accès personnes à mobilité réduite avec fauteuil de mise à l'eau à disposition. Accueil des groupes et scolaires possible. Leçons de natation adultes ou enfants."
    ],
    "es": [
      "Piscina municipal descubierta, climatizada con energía solar, abierta todos los días en verano. Acceso para minusválidos con silla de ruedas. Se admiten grupos y colegios. Clases de natación para adultos y niños."
    ],
    "nl": [
      "Niet overdekt, door zonne-energie verwarmd gemeentelijk zwembad, elke dag geopend in de zomer. Toegankelijk voor gehandicapten met rolstoel. Groepen en scholen zijn welkom. Zwemlessen voor volwassenen en kinderen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Gresse en Vercors municipal swimming pool"
    ],
    "fr": [
      "Piscine municipale de Gresse en Vercors"
    ]
  },
