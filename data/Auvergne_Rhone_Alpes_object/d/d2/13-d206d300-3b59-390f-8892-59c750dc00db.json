  "rdfs:comment": {
    "de": [
      "Landhotel, 20 km von Bourg en Bresse und 30 km von Oyonnax entfernt, am Fuße der Petite Montagne gelegen.\r\nEin charmantes Logis-Hotel mit 8 Zimmern, ideal für Touristen- und Geschäftsreisen im Zentrum eines ruhigen Dorfes mit PMR-Zugang."
    ],
    "en": [
      "Country hotel, 20 km from Bourg en Bresse and 30 km from Oyonnax, at the foot of the Petite Montagne.\r\nA charming 8-room Logis hotel, ideal for tourism and business trips, in the center of a quiet village with PMR accessibility."
    ],
    "it": [
      "Albergo di campagna, situato a 20 km da Bourg en Bresse e a 30 km da Oyonnax, ai piedi della Petite Montagne\r\nUn hotel Logis di charme con 8 camere, ideale per turismo e viaggi d'affari, nel centro di un tranquillo villaggio con accessibilità PRM."
    ],
    "fr": [
      "Hôtel de campagne, situé à 20 km de Bourg en Bresse et 30 km d'Oyonnax, au pied de la petite Montagne\r\nUn charmant hôtel Logis de 8 chambres, idéal pour voyages de tourisme et d’affaires au centre d'un village tranquille avec une accessibilité PMR."
    ],
    "nl": [
      "Landelijk hotel, gelegen op 20 km van Bourg en Bresse en 30 km van Oyonnax, aan de voet van de Petite Montagne\r\nEen charmant Logis hotel met 8 kamers, ideaal voor toerisme en zakenreizen in het centrum van een rustig dorp met PRM bereikbaarheid."
    ],
    "es": [
      "Hotel rural, situado a 20 km de Bourg en Bresse y a 30 km de Oyonnax, al pie de la Petite Montagne\r\nUn encantador hotel Logis de 8 habitaciones, ideal para el turismo y los viajes de negocios en el centro de un tranquilo pueblo con accesibilidad para PMR."
    ]
  },
