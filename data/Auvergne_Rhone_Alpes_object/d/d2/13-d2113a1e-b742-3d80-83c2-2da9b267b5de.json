  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die magische Atmosphäre des Festivals Ô Mille et Une Note. Genießen Sie Konzerte unter freiem Himmel, köstliche lokale Spezialitäten und Aktivitäten für alle.\r\nMusik, Geselligkeit und Entdeckungen warten auf Sie!"
    ],
    "en": [
      "Immerse yourself in the magical atmosphere of the Ô Mille et Une Note Festival. Enjoy open-air concerts, delicious local specialities and activities for all.\r\nMusic, conviviality and discovery await you!"
    ],
    "it": [
      "Immergetevi nella magica atmosfera del Festival Ô Mille et Une Note. Godetevi i concerti all'aperto, le deliziose specialità locali e le attività per tutti.\r\nMusica, convivialità e scoperte garantite!"
    ],
    "fr": [
      "Plongez dans l’atmosphère magique du Festival Ô Mille et Une Note. Profitez de concerts en plein air, de délicieuses spécialités locales et d’activités pour tous.\r\nMusique, convivialité et découvertes au rendez-vous !"
    ],
    "es": [
      "Sumérjase en la mágica atmósfera del Festival Ô Mille et Une Note. Disfrute de conciertos al aire libre, deliciosas especialidades locales y actividades para todos.\r\nMúsica, convivencia y descubrimientos garantizados"
    ],
    "nl": [
      "Dompel jezelf onder in de magische sfeer van het Ô Mille et Une Note Festival. Geniet van openluchtconcerten, heerlijke lokale specialiteiten en activiteiten voor iedereen.\r\nMuziek, gezelligheid en ontdekkingen gegarandeerd!"
    ]
  },
  "rdfs:label": {
