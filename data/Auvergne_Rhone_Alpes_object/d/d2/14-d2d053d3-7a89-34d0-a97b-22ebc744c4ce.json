      "@id": "https://data.datatourisme.fr/da1e3a8b-5efa-3c5d-bd18-e27604167f08",
      "dc:description": {
        "de": [
          "Geselliges Clubhaus-Restaurant in einer außergewöhnlichen natürlichen Umgebung mit einer ehrlichen und geschmackvollen Küche - Restaurant und Bar sind für alle geöffnet. Reservierung erwünscht"
        ],
        "en": [
          "Convivial clubhouse restaurant in an exceptional natural setting, with sincere, tasteful cuisine - the restaurant and bar are open to all. Reservations required"
        ],
        "it": [
          "Un ristorante accogliente in un ambiente naturale eccezionale, che serve una cucina sincera e di buon gusto - il ristorante e il bar sono aperti a tutti. Prenotazione obbligatoria"
        ],
        "fr": [
          "Restaurant de club house convivial situé dans un cadre naturel exceptionnel avec une cuisine sincère et de goût - le restaurant et le bar sont ouverts à tous. Réservation souhaitée"
        ],
        "es": [
          "Un acogedor restaurante situado en un entorno natural excepcional, que sirve una cocina sincera y de buen gusto. El restaurante y el bar están abiertos a todos. Es necesario reservar"
        ],
        "nl": [
          "Een vriendelijk clubhuisrestaurant in een uitzonderlijke natuurlijke omgeving, waar oprechte, smaakvolle gerechten worden geserveerd - het restaurant en de bar zijn voor iedereen toegankelijk. Reserveren verplicht"
        ]
      },
