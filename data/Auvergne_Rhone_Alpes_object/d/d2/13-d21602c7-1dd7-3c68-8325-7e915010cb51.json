  "rdfs:comment": {
    "de": [
      "Mietverwaltung, Ferienvermietung, Verwaltung von Miteigentümern. Mathieu Clier und sein Team sind seit 35 Jahren auf die Verwaltung Ihres Eigentums spezialisiert und stehen Ihnen jederzeit zur Verfügung."
    ],
    "en": [
      "Rental management, seasonal rentals, condominium management. Mathieu Clier and his team have been specializing in property management for 35 years."
    ],
    "it": [
      "Gestione di affitti, affitti stagionali, gestione di comproprietà. Da 35 anni, Mathieu Clier e il suo team sono specializzati nella gestione dei vostri immobili e sono a vostra disposizione."
    ],
    "fr": [
      "Gestion locative, location saisonnière, syndic de copropriétés. Depuis 35 ans, spécialisés dans la gestion de vos biens, Mathieu Clier et son équipe sont à votre disposition."
    ],
    "nl": [
      "Huurbeheer, seizoensverhuur, beheer van mede-eigendom. Mathieu Clier en zijn team zijn al 35 jaar gespecialiseerd in vastgoedbeheer."
