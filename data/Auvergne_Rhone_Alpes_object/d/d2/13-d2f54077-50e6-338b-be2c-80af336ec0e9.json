  "rdfs:comment": {
    "de": [
      "Der See von Lastioulles liegt auf 800 m Höhe und verfügt über einen Sandstrand, der sich für sommerliche Wassersportaktivitäten wie Schwimmen, Segeln oder Kanufahren eignet."
    ],
    "en": [
      "Perched at an altitude of 800 metres, Lac de Lastioulles boasts a sandy beach ideal for summer water sports such as swimming, sailing and canoeing."
    ],
    "it": [
      "Situato a 800 metri di altitudine, il Lac de Lastioulles vanta una spiaggia di sabbia fine ideale per praticare sport acquatici estivi come il nuoto, la vela e la canoa."
    ],
    "fr": [
      "Perché à 800 mètres d’altitude, le lac de Lastioulles possède une plage de sable fin propice aux activités nautiques estivales comme la baignade, la voile ou le canotage."
    ],
    "es": [
      "Situado a 800 metros de altitud, el lago de Lastioulles cuenta con una playa de arena fina ideal para practicar en verano deportes náuticos como natación, vela y piragüismo."
    ],
    "nl": [
      "Lac de Lastioulles ligt op 800 meter hoogte en heeft een fijn zandstrand dat ideaal is voor zomerse watersporten zoals zwemmen, zeilen en kanoën."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Lastioulles\" beach"
    ],
    "fr": [
      "Plage de Lastioulles"
    ]
  },
