  "rdfs:comment": {
    "de": [
      "Im Dienste Ihres Zweitwohnsitzes in den Baronnies. Der Hausmeisterservice Le Tilleul ist das ganze Jahr über vor Ort, um Sie bei der Verwaltung Ihres Wohnsitzes diskret zu begleiten."
    ],
    "en": [
      "At the service of your second home in Baronnies. The Le Tilleul concierge is your agent on site all year round to assist you in the management of your residence in complete discretion."
    ],
    "it": [
      "Assistenza alla vostra casa vacanze nelle Baronnies. Il servizio di portineria di Le Tilleul è a disposizione tutto l'anno per aiutarvi a gestire la vostra casa con la massima discrezione."
    ],
    "fr": [
      "Au service de votre résidence secondaire en Baronnies. La conciergerie Le Tilleul est sur place toute l’année afin de vous accompagner dans la gestion de votre résidence en toute discrétion."
    ],
    "nl": [
      "Ten dienste van uw buitenverblijf in de Baronnies. De conciërge Le Tilleul is het hele jaar door uw agent ter plaatse om u te helpen uw woning in alle discretie te beheren."
    ],
    "es": [
      "Al servicio de su casa de vacaciones en las Baronnies. El servicio de conserjería de Le Tilleul está a su disposición todo el año para ayudarle a gestionar su casa con total discreción."
    ]
  },
  "rdfs:label": {
    "en": [
      "Concierge service le Tilleul"
    ],
