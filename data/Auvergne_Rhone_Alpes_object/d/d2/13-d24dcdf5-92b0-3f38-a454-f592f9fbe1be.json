  "rdfs:comment": {
    "de": [
      "Restaurant, das eine Geschmacksreise durch Spezialitäten aus Ägypten, der Schweiz, den USA und den Golfstaaten anbietet. Jeder Teller zelebriert die Frische der Produkte aus der Region und die Exzellenz des authentischen Know-hows."
    ],
    "en": [
      "Restaurant offering a gustatory journey through specialties from Egypt, Switzerland, the United States and the Gulf States. Each plate celebrates the freshness of local produce and the excellence of authentic savoir-faire."
    ],
    "it": [
      "Un ristorante che offre un viaggio gustativo attraverso le specialità dell'Egitto, della Svizzera, degli Stati Uniti e degli Stati del Golfo. Ogni piatto celebra la freschezza dei prodotti locali e l'eccellenza dell'autentico savoir-faire."
    ],
    "fr": [
      "Restaurant proposant un voyage gustatif à travers des spécialités d'Egypte, de Suisse, des Etats-Unis, et des Pays du Golfe. Chaque assiette célèbre la fraîcheur des produits du terroir et l’excellence d’un savoir-faire authentique."
    ],
    "es": [
      "Un restaurante que ofrece un viaje gustativo a través de especialidades de Egipto, Suiza, Estados Unidos y los países del Golfo. Cada plato celebra la frescura de los productos locales y la excelencia del auténtico saber hacer."
    ],
    "nl": [
      "Een restaurant dat een culinaire reis aanbiedt langs specialiteiten uit Egypte, Zwitserland, de Verenigde Staten en de Golfstaten. Elk gerecht viert de versheid van lokale producten en de uitmuntendheid van authentieke savoir-faire."
    ]
  },
