      "dc:description": {
        "de": [
          "Das Fort ist von 14:30 bis 17:30 Uhr geöffnet\nLetzter Einlass ist um 16:45 Uhr\nSelbstständige Besichtigung ab 14.30 Uhr\nGeführte Besichtigung, Beginn 15.00 Uhr"
        ],
        "en": [
          "The fort is open from 2:30 p.m. to 5:30 p.m\nLast admission at 4:45 pm\nSelf-guided tour from 2:30 pm\nGuided tour starts at 3:00 pm"
        ],
        "it": [
          "Il forte è aperto dalle 14.30 alle 17.30\nUltimo ingresso alle 16.45\nVisita autoguidata dalle 14.30\nLa visita guidata inizia alle 15.00"
        ],
        "fr": [
          "Le fort est ouvert de 14 h 30 à 17 h 30 \nDernière entrée à 16 h 45\nVisite en autonomie à partir de 14 h 30\nVisite guidée, début de visite 15 h 00"
        ],
        "nl": [
          "Het fort is open van 14.30 tot 17.30 uur\nLaatste toegang om 16.45 uur\nRondleiding met gids vanaf 14.30 uur\nRondleiding begint om 15.00 uur"
        ],
        "es": [
          "El fuerte está abierto de 14.30 a 17.30 h\nÚltima entrada a las 16.45\nVisita autoguiada a partir de las 14.30 h\nVisita guiada a partir de las 15.00 h"
        ]
      },
