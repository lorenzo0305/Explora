  "rdfs:comment": {
    "de": [
      "Versammlung/Ausstellung von mehr als 400 außergewöhnlichen Oldtimern (Autos, Motorräder, Lastwagen) im historischen Zentrum. Börse für Ersatzteile. Oldtimer zu gewinnen und viele andere Preise. Zahlreiche Animationen."
    ],
    "en": [
      "Gathering/exhibition of over 400 exceptional vintage vehicles (cars, motorcycles, trucks) in the historic center. Spare parts market. Collector's car to be won and many other prizes. Lots of entertainment."
    ],
    "it": [
      "Raduno/esposizione di oltre 400 eccezionali veicoli d'epoca (auto, moto, camion) nel centro storico. Mercato dei ricambi. Vince un'auto da collezione e molti altri premi. Tanti intrattenimenti."
    ],
    "fr": [
      "Rassemblement / expo de plus de 400 véhicules anciens d'exception (auto, moto, camion) dans le centre historique. Bourse aux pièces détachées. Voiture de collection à gagner  et de nombreux autres lots. Nombreuses animations."
    ],
    "nl": [
      "Verzameling/tentoonstelling van meer dan 400 bijzondere oldtimers (auto's, motoren, vrachtwagens) in het historische centrum. Onderdelenmarkt. Te winnen verzamelauto en vele andere prijzen. Veel entertainment."
    ],
    "es": [
      "Concentración/exposición de más de 400 vehículos de época excepcionales (coches, motos, camiones) en el centro histórico. Mercado de piezas de recambio. Coche de colección para ganar y muchos otros premios. Mucha animación."
    ]
  },
  "rdfs:label": {
