  "rdfs:comment": {
    "de": [
      "Das Natura-2000-Gebiet Printegarde liegt entlang der Rhône in den Gemeinden Livron und La Voulte sowie Le Pouzin und beherbergt zahlreiche Zugvögel und über 100 Libellenarten."
    ],
    "en": [
      "Located along the Rhône in the communes of Livron, La Voulte and Le Pouzin, the Printegarde Natura 2000 site is home to numerous migratory birds and over a hundred species of dragonfly."
    ],
    "it": [
      "Situato lungo il Rodano nei comuni di Livron, La Voulte e Le Pouzin, il sito Natura 2000 di Printegarde ospita numerosi uccelli migratori e oltre cento specie di libellule."
    ],
    "fr": [
      "Situé le long du Rhône sur les communes de Livron et La Voulte et Le Pouzin, le site Natura 2000 de Printegarde accueille de nombreux oiseaux migrateurs et plus d’une centaine d’espèces de libellules."
    ],
    "es": [
      "Situado a orillas del Ródano, en los municipios de Livron, La Voulte y Le Pouzin, el espacio Natura 2000 de Printegarde alberga numerosas aves migratorias y más de un centenar de especies de libélulas."
    ],
    "nl": [
      "Het Natura 2000-gebied Printegarde, gelegen langs de Rhône in de gemeenten Livron, La Voulte en Le Pouzin, herbergt veel trekvogels en meer dan honderd libellensoorten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site Natura 2000 Printegarde"
    ]
  },
