  "rdfs:comment": {
    "de": [
      "Der Aeroclub bietet eine von zwei Fluglehrern geleitete Flugschule und Lufttaufen an. Seine außergewöhnliche geografische Lage ermöglicht es, den Piloten sehr unterschiedliche Flüge anzubieten."
    ],
    "en": [
      "The flying club offers a flying school run by two instructors, as well as first flights. Its exceptional geographical location offers pilots a wide variety of flight options."
    ],
    "it": [
      "L'aeroclub offre una scuola di volo con due istruttori e primi voli. La sua eccezionale posizione geografica le permette di offrire ai piloti un'ampia varietà di voli."
    ],
    "fr": [
      "L’aéroclub propose une école de pilotage animée par deux instructeurs et des baptêmes de l’air. Sa situation géographique exceptionnelle permet d’offrir aux pilotes des vols très variés."
    ],
    "es": [
      "El aeroclub ofrece una escuela de vuelo con dos instructores y primeros vuelos. Su excepcional situación geográfica le permite ofrecer a los pilotos una gran variedad de vuelos."
    ],
    "nl": [
      "De vliegclub biedt een vliegschool onder leiding van twee instructeurs en eerste vluchten. De uitzonderlijke geografische ligging biedt piloten een grote verscheidenheid aan vluchten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aéro-Club de Romans"
    ]
