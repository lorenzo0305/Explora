  "rdfs:comment": {
    "de": [
      "Die Ferme du Lignon stellt auf traditionelle Weise Gruyère-Käse aus der Milch von Abondance- und Ferrandaise-Kühen her, die auf 40 ha Naturwiesen biologisch gehalten werden. Sie können die Produkte auf dem Hof kaufen."
    ],
    "en": [
      "La Ferme du Lignon produces traditional Gruyère cheeses from the milk of Abondance and Ferrandaise cows, raised organically on 40 hectares of natural meadows. Find them on sale at the farm."
    ],
    "it": [
      "La Ferme du Lignon produce i tradizionali formaggi Gruyère con il latte di mucche Abondance e Ferrandaise, allevate con metodo biologico su 40 ettari di prati naturali. È possibile acquistarli presso la fattoria."
    ],
    "fr": [
      "La Ferme du Lignon produit de manière traditionnelle des fromages de la famille des Gruyères à partir du lait de vaches Abondance et Ferrandaise, élevées en agriculture biologique, sur 40 Ha de prairies naturelles. Retrouvez-les en vente à la ferme."
    ],
    "es": [
      "La Ferme du Lignon produce quesos Gruyère tradicionales a partir de la leche de vacas Abondance y Ferrandaise, criadas ecológicamente en 40 hectáreas de prados naturales. Puede comprar estos quesos en la granja."
    ],
    "nl": [
      "La Ferme du Lignon maakt traditionele Gruyère kazen van de melk van Abondance en Ferrandaise koeien, die biologisch worden gehouden op 40 hectare natuurlijke weiden. Je kunt ze kopen op de boerderij."
    ]
  },
