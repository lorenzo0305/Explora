  "rdfs:comment": {
    "de": [
      "Traditionelles Brotfest im Banalofen des Dorfes Farges, organisiert von der Vereinigung Horizon Siaugues. Backen von Brot im alten Ofen. Buffet und Getränke.  Reservierung unter 06 37 27 82 27 oder horizonsiaugues@gmail.com vor dem 14. August."
    ],
    "en": [
      "Traditional bread festival in the village of Farges, organized by the Horizon Siaugues association. Bread baking in the communal oven. Buffet and refreshments.  Reservations on 06 37 27 82 27 or horizonsiaugues@gmail.com before August 14th."
    ],
    "it": [
      "Festa del pane tradizionale nel villaggio di Farges, organizzata dall'associazione Horizon Siaugues. Cottura del pane nel forno comune. Buffet e rinfreschi.  Prenotazioni allo 06 37 27 82 27 o a horizonsiaugues@gmail.com entro il 14 agosto."
    ],
    "fr": [
      "Traditionnelle Fête du pain au four banal du village de Farges organisée par l'association Horizon Siaugues. Cuisson de pains dans le four banal. Buffet et Buvette.  Réservation au 06 37 27 82 27 ou horizonsiaugues@gmail.com avant le 14 août."
    ],
    "nl": [
      "Traditioneel broodfeest in het dorp Farges, georganiseerd door de vereniging Horizon Siaugues. Brood bakken in de gemeenschappelijke oven. Buffet en versnaperingen.  Reserveren op 06 37 27 82 27 of horizonsiaugues@gmail.com voor 14 augustus."
    ],
    "es": [
      "Fiesta del pan tradicional en el pueblo de Farges, organizada por la asociación Horizon Siaugues. Cocción del pan en el horno comunal. Buffet y refrescos.  Reservas en el 06 37 27 82 27 o en horizonsiaugues@gmail.com antes del 14 de agosto."
    ]
  },
  "rdfs:label": {
    "fr": [
