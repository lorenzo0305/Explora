  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geheimnisse der Herstellung des SEQUOIA Single Malt Whiskys.\r\nBetreten Sie die Gebäude und entdecken Sie alle Etappen der Umwandlung von Gerste in Whisky (Bier, Destillierapparate, Lagerräume).\r\nBesichtigung mit anschließender Verkostung der Séquoia-Abfüllungen."
    ],
    "en": [
      "Nestled in the heart of the green Royans valley, in the Vercors Regional Natural Park, the Vercors Distillery is located at 30 minutes from Valence and 1h30 from Lyon. It produces organic SEQUOIA whiskeys, brewed, distilled, aged and bottled on site. Come to visit us and discover the steps and secrets of creating our Whisky Single Malt."
    ],
    "it": [
      "Scoprite i segreti della produzione del whisky single malt SEQUOIA.\r\nEntrate negli edifici e scoprite tutte le fasi della trasformazione dell'orzo in whisky (birra, alambicchi, cantine).\r\nVisita seguita da una degustazione delle bottiglie Sequoia."
    ],
    "fr": [
      "Découverte des secrets de fabrication du Whisky Single Malt SEQUOIA.\r\nEntrez dans les bâtiments et découvrez toutes les étapes de la transformation de l’orge en whisky (bière, alambics, chais).\r\nVisite suivie d’une dégustation des embouteillages Séquoia."
    ],
    "nl": [
      "Ontdek de geheimen van het maken van SEQUOIA Single Malt Whisky.\r\nGa de gebouwen binnen en ontdek alle stadia van de verwerking van gerst tot whisky (bier, distilleerketels, kelders).\r\nBezoek gevolgd door een proeverij van de Sequoia bottelingen."
    ],
    "es": [
      "Descubra los secretos de la elaboración del whisky SEQUOIA Single Malt.\r\nEntre en los edificios y descubra todas las etapas de la transformación de la cebada en whisky (cerveza, alambiques, bodegas).\r\nVisita seguida de una degustación de las botellas de Sequoia."
    ]
  },
  "rdfs:label": {
