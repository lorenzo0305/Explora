  "rdfs:comment": {
    "de": [
      "Exo 73, der Wasserskilift in einer angenehmen Umgebung auf dem Gabelin-See, empfängt Sie, um Wassersportgefühle zu tanken."
    ],
    "en": [
      "Discover cable skiing in a lovely atmosphere on the lake of Gabelin or enjoy other activities. There is a snack over the lake that gives you a constant spectacle on the water and the mountains."
    ],
    "it": [
      "Exo 73, l'impianto di risalita per sci nautico in un ambiente piacevole sul lago di Gabelin, vi dà il benvenuto per godere di tutte le sensazioni nautiche."
    ],
    "fr": [
      "Exo 73, le téléski nautique dans un cadre agréable sur le lac de Gabelin vous accueille pour faire le plein de sensations nautiques."
    ],
    "es": [
      "Exo 73, el remonte de esquí acuático en un entorno agradable en el lago de Gabelin le da la bienvenida para disfrutar de todas las sensaciones náuticas."
    ],
    "nl": [
      "Exo 73, de waterskilift in een aangename omgeving op het meer van Gabelin heet u welkom om te genieten van alle nautische sensaties."
    ]
  },
