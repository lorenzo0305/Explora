  "rdfs:comment": {
    "de": [
      "Als \"Étapes savoureuses d'Ardèche®\" und \"Pôle thématique du Parc des Monts d'Ardèche\" gekennzeichneter Besuchsort. Rund zwanzig Bauernhofproduzenten und Affineure von Ziegenkäse und Picodon AOP erzählen Ihnen während eines Besuchs von ihrem Know-how."
    ],
    "en": [
      "Twenty goat cheese/Picodon AOP makers and ripeners are opening their doors onto their craftmanship; from their farm to your plate. Visit length: 40 minutes. Terra Cabra is part of the “Ardeche gourmet food trail” promoted by the Ardèche Mountains Regional Nature Park. English tours available, Deutch bezuch, Bezoek in het Nederlands."
    ],
    "it": [
      "Il sito ha ottenuto il marchio \"Étapes savoureuses d'Ardèche®\" e il marchio \"Pôle thématique du Parc des Monts d'Ardèche\". Una ventina di produttori agricoli e stagionatori di formaggio di capra e Picodon DOP raccontano il loro know-how durante una visita."
    ],
    "fr": [
      "Site de visite identifié \"Étapes savoureuses d'Ardèche®\", et \"Pôle thématique du Parc des Monts d'Ardèche\". Une vingtaine de producteurs fermiers et affineurs de fromage de chèvre et Picodon AOP vous racontent leur savoir-faire le temps d'une visite."
    ],
    "es": [
      "El lugar ha obtenido la etiqueta \"Étapes savoureuses d'Ardèche®\" y la etiqueta \"Pôle thématique du Parc des Monts d'Ardèche\". Una veintena de granjeros productores y maduradores de queso de cabra y Picodon DOP le contarán todo sobre su saber hacer durante una visita."
    ],
    "nl": [
      "De site is bekroond met het label \"Étapes savoureuses d'Ardèche®\" en het label \"Pôle thématique du Parc des Monts d'Ardèche\". Een twintigtal producenten en rijpers van geitenkaas en Picodon BOB vertellen je alles over hun knowhow tijdens een bezoek."
    ]
  },
  "rdfs:label": {
