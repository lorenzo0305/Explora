  "rdfs:comment": {
    "de": [
      "Die Orangerie empfängt Sie von Donnerstag bis Sonntag in ihrem neuen Schmuckstück am Rande der Terrasse und des Parks, um eine schmackhafte und authentische Küche zu genießen."
    ],
    "en": [
      "From Thursday to Sunday, L'Orangerie welcomes you to its new setting on the edge of the terrace and park, to enjoy tasty, authentic cuisine."
    ],
    "it": [
      "Da giovedì a domenica, L'Orangerie vi accoglie nel suo nuovo ambiente ai margini della terrazza e del parco per gustare una cucina gustosa e autentica."
    ],
    "fr": [
      "L'Orangerie vous accueille du jeudi au dimanche dans son nouvel écrin en bord de terrasse et du parc pour déguster une cuisine savoureuse et authentique."
    ],
    "nl": [
      "Van donderdag tot zondag verwelkomt L'Orangerie je in zijn nieuwe setting aan de rand van het terras en het park om te genieten van smakelijke, authentieke gerechten."
    ],
    "es": [
      "De jueves a domingo, L'Orangerie le recibe en su nuevo emplazamiento, al borde de la terraza y del parque, para degustar una cocina sabrosa y auténtica."
    ]
  },
