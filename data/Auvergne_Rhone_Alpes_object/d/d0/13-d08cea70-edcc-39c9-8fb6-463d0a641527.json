  "rdfs:comment": {
    "de": [
      "Riesensolarium für einen Moment der Entspannung und/oder der Kontemplation im Herzen des Gebiets Haute Maurienne Vanoise auf dem Weg des kleinen Glücks. Lassen Sie sich auf diesem Weg von seiner gelben Farbe leiten, um ans Ende zu gelangen."
    ],
    "en": [
      "Giant solarium for a moment of relaxation and/or contemplation in the heart of Haute Maurienne Vanoise on the chemin du petit bonheur. Along the way, let the yellow color guide you to the end."
    ],
    "it": [
      "Solarium gigante per un momento di relax e/o contemplazione nel cuore della Haute Maurienne Vanoise, sul Chemin du Petit Bonheur. Lungo tutto il percorso, lasciatevi guidare dal colore giallo fino alla fine."
    ],
    "fr": [
      "Solarium géant pour un moment de détente et/ou de contemplation au coeur du territoire Haute Maurienne Vanoise sur le chemin du petit bonheur. Tout au long de ce chemin, laissez vous guider par sa couleur jaune pour arriver au bout."
    ],
    "es": [
      "Solarium gigante para un momento de relajación y/o contemplación en el corazón de Haute Maurienne Vanoise, en el Chemin du Petit Bonheur. A lo largo de todo el camino, déjese guiar por el color amarillo hasta el final."
    ],
    "nl": [
      "Reusachtig solarium voor een moment van ontspanning en/of bezinning in het hart van de Haute Maurienne Vanoise op de Chemin du Petit Bonheur. Laat je onderweg leiden door de kleur geel."
    ]
  },
