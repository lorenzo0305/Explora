  "rdfs:comment": {
    "de": [
      "Ein friedlicher Ort, ein schattiger Platz am Ufer des Étang de la Croisière für ein erholsames Picknick! 10 Minuten zu Fuß vom Stadtzentrum entfernt."
    ],
    "en": [
      "A peaceful, shady spot on the banks of the Etang de la Croisière for a rejuvenating picnic! A 10-minute walk from the town center."
    ],
    "it": [
      "Un luogo tranquillo e ombreggiato sulle rive dell'Etang de la Croisière per un picnic rigenerante! A 10 minuti a piedi dal centro città."
    ],
    "fr": [
      "Un lieu paisible, espace ombragé au bord de l'étang de la Croisière pour un pique-nique ressourçant ! A 10 minutes à pied du centre ville."
    ],
    "es": [
      "Un lugar tranquilo y sombreado a orillas del Etang de la Croisière para un picnic rejuvenecedor A 10 minutos a pie del centro de la ciudad."
    ],
    "nl": [
      "Een rustige, schaduwrijke plek aan de oevers van het Etang de la Croisière voor een verkwikkende picknick! Op 10 minuten lopen van het stadscentrum."
    ]
  },
  "rdfs:label": {
