      "rdfs:comment": {
        "de": [
          "Wachsendes Projekt für Bio-Gemüseanbau in Permakultur.\nDerzeit besteht die Möglichkeit, Obst- und Gemüsekörbe, Weizen- und Buchweizenmehl, Gewürze... zu bestellen."
        ],
        "en": [
          "Project in full expansion of organic market gardening in permaculture.\nCurrently, it is possible to order baskets of fruits and vegetables, wheat and buckwheat flour, spices..."
        ],
        "it": [
          "Un progetto di orticoltura biologica in permacultura in crescita.\nAttualmente è possibile ordinare cesti di frutta e verdura, farina di grano e grano saraceno, spezie..."
        ],
        "fr": [
          "Projet en pleine expansion de maraîchage bio en permaculture.\nActuellement possibilité de commander des paniers de fruits et légumes, de la farine de blé et de sarrasin, épices..."
        ],
        "es": [
          "Un proyecto de horticultura orgánica de permacultura en crecimiento.\nActualmente es posible encargar cestas de frutas y verduras, harina de trigo y alforfón, especias, etc."
        ],
        "nl": [
          "Een groeiend permacultuur biologisch tuinbouwproject.\nMomenteel is het mogelijk om manden fruit en groenten, tarwe- en boekweitmeel, kruiden, enz. te bestellen."
        ]
      },
