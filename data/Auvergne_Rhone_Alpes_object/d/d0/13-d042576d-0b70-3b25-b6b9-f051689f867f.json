  "rdfs:comment": {
    "de": [
      "Atelier und Laden für emaillierte Lava. Kostenlose Besichtigung (Werkstatt und Laden) ohne Kaufverpflichtung. Céline erklärt Ihnen die Schritte der Herstellung dieser Stücke, die alle einzigartig sind."
    ],
    "en": [
      "Enamelled lava atelier-boutique."
    ],
    "it": [
      "Laboratorio e negozio di lava smaltata. Visita gratuita (laboratorio e negozio) senza obbligo di acquisto. Céline spiegherà le fasi di realizzazione di questi pezzi unici."
    ],
    "fr": [
      "Atelier-boutique de lave émaillée. Visite gratuite (atelier et boutique) sans obligation d'achat. Céline vous expliquera les étapes de fabrication de ces pièces qui sont toutes uniques."
    ],
    "es": [
      "Taller y tienda de lava esmaltada. Visita gratuita (taller y tienda) sin obligación de compra. Céline le explicará las etapas de fabricación de estas piezas únicas."
    ],
    "nl": [
      "Geëmailleerde lava werkplaats en winkel. Gratis bezoek (atelier en winkel) zonder koopverplichting. Céline geeft uitleg over de stappen die nodig zijn om deze unieke stukken te maken."
    ]
  },
