  "rdfs:comment": {
    "de": [
      "Vollständige Freiland-Schweinehaltung und diversifizierter Gemüseanbau.\r\nBauernhof in biologischer Landwirtschaft.\r\ndirektverkauf auf den Märkten von Bourdeaux und Bouvières und auf dem Hof nach Vereinbarung"
    ],
    "en": [
      "Free-range pig farming and diversified market gardening.\r\nOrganic farming.\r\ndirect sales at Bourdeaux and Bouvières markets and at the farm by appointment"
    ],
    "it": [
      "Allevamento di suini all'aperto e orticoltura diversificata.\r\nAgricoltura biologica.\r\nvendita diretta ai mercati di Bourdeaux e Bouvières e in azienda su appuntamento"
    ],
    "fr": [
      "Élevage de porc en plein air intégral et maraîchage diversifié. \r\nFerme en agriculture biologique. \r\nvente directe marchés de Bourdeaux et de Bouvières et à la ferme sur rendez-vous"
    ],
    "nl": [
      "Varkenshouderij met vrije uitloop en gediversifieerde tuinbouw.\r\nBiologische landbouw.\r\ndirecte verkoop op de markten van Bourdeaux en Bouvières en op de boerderij op afspraak"
    ],
    "es": [
      "Cría de cerdos camperos y horticultura diversificada.\r\nAgricultura ecológica.\r\nventa directa en los mercados de Burdeos y Bouvières y en la granja con cita previa"
    ]
  },
