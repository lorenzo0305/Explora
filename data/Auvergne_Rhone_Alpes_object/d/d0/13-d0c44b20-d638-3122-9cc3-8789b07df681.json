  "rdfs:comment": {
    "de": [
      "Kommen Sie und teilen Sie schöne Momente bei einem Glas oder einem Gericht. Eine warme, festliche und charaktervolle Atmosphäre. Es finden zahlreiche Themenabende statt. Jeden Freitagabend Karaoke und Wurst- und Käseplatten."
    ],
    "en": [
      "Come and share good times over a drink or a dish. A warm, festive atmosphere full of character. Many theme evenings are coming up. Every Friday evening karaoke and charcuterie and cheese platters."
    ],
    "it": [
      "Venite a condividere un buon momento davanti a un drink o a un pasto. L'atmosfera è calda, festosa e piena di carattere. Sono in programma molte serate a tema. Ogni venerdì sera karaoke e taglieri di salumi e formaggi."
    ],
    "fr": [
      "Venez partager de bons moments autour d’un verre ou bien d’un plat. Ambiance chaleureuse, festive et pleine de caractère. De nombreuses soirées à thèmes arrivent. Tous les vendredis soir karaoké et assiettes charcuterie et fromages."
    ],
    "es": [
      "Venga a compartir un buen rato tomando una copa o comiendo. El ambiente es cálido, festivo y con carácter. Se organizan muchas veladas temáticas. Todos los viernes por la noche karaoke y bandejas de embutidos y quesos."
    ],
    "nl": [
      "Kom gezellig iets drinken of eten. De sfeer is warm, feestelijk en vol karakter. Er komen veel thema-avonden aan. Elke vrijdagavond karaoke en charcuterie- en kaasplankjes."
    ]
  },
