  "rdfs:comment": {
    "de": [
      "Haras Cheval évasion Familienreitzentrum, betreut von Martine mit einem BPJEPS-Diplom für Reittourismus /ATE/COMPORTEMENTALISTE EQUIN\r\nKurse für alle Niveaus Pferde und Ponys /Arbeit zu Fuß/Balladen/Randos/Balladen mit Ponys.\r\nPension"
    ],
    "en": [
      "Haras Cheval évasion family equestrian center supervised by Martine, BPJEPS equestrian tourism graduate /ATE/COMPORTEMENTALISTE EQUIN\r\nLessons for all levels on horses and ponies /work on foot/rides/randos/pony rides.\r\nPension"
    ],
    "it": [
      "Centro equestre familiare Haras Cheval évasion supervisionato da Martine con diploma BPJEPS in turismo equestre /ATE/COMPORTEMENTALISTE EQUIN\r\nLezioni per tutti i livelli su cavalli e pony /lavoro a piedi /cavalcate/randos/cavalcate su pony.\r\nPensione"
    ],
    "fr": [
      "Haras Cheval évasion centre equestre familiale encadré par Martine diplômé d'un  BPJEPS tourisme équestre /ATE/COMPORTEMENTALISTE EQUIN\r\nCours tous niveaux chevaux et poneys /travail à pied/ballades/randos/ballades en poneys.\r\nPension"
    ],
    "nl": [
      "Haras Cheval évasion familie manege begeleid door Martine met een BPJEPS diploma in hippisch toerisme /ATE/COMPORTEMENTALISTE EQUIN\r\nLessen voor alle niveaus op paarden en pony's /werk te voet/ritten/rando's/ritten op pony's.\r\nPension"
    ],
    "es": [
      "Haras Cheval évasion centro ecuestre familiar supervisado por Martine con diploma BPJEPS en turismo ecuestre /ATE/COMPORTEMENTALISTE EQUIN\r\nClases para todos los niveles a caballo y poni /trabajo a pie/ paseos/randos/ paseos en poni.\r\nPensión"
