  "rdfs:comment": {
    "de": [
      "Emmanuel und Marie-Agnès Barou heißen Sie herzlich willkommen, um Ihnen ihre Weine und Früchte vorzustellen, die aus biologischem Anbau zertifiziert wurden: Landweine Syrah, Marsanne, Viognier, AOC Saint-Joseph und Condrieu. Verkauf von Kirschen, Aprikosen und Pfirsichen."
    ],
    "en": [
      "Emmanuel & Marie-Agnès welcome you to make you discover their wines and fruits certified organic agriculture : wines from grape varieties : Syrah, Marsanne, Viognier, AOC Saint Joseph  and Condrieu."
    ],
    "it": [
      "Emmanuel e Marie-Agnès Barou vi accolgono per farvi scoprire i loro vini e frutti biologici certificati: vins de pays Syrah, Marsanne, Viognier, AOC Saint-Joseph e Condrieu. Vendita di ciliegie, albicocche e pesche."
    ],
    "fr": [
      "Emmanuel et Marie-Agnès Barou vous accueillent pour vous faire découvrir leurs vins et fruits certifiés en agriculture biologique : vins de pays Syrah, Marsanne, Viognier, AOC Saint-Joseph et Condrieu. Vente de cerises, abricots, pêches."
    ],
    "es": [
      "Emmanuel y Marie-Agnès Barou le dan la bienvenida para que descubra sus vinos y frutas ecológicos certificados: vins de pays Syrah, Marsanne, Viognier, AOC Saint-Joseph y Condrieu. Venta de cerezas, albaricoques y melocotones."
    ],
    "nl": [
      "Emmanuel en Marie-Agnès Barou heten je welkom om hun gecertificeerde biologische wijnen en fruit te ontdekken: vins de pays Syrah, Marsanne, Viognier, AOC Saint-Joseph en Condrieu. Verkoop van kersen, abrikozen en perziken."
    ]
  },
