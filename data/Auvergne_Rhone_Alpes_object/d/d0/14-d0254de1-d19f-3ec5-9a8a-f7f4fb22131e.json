  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/90995ec9-fcf5-36f8-bdb2-b42224ee73b1",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck\n\nTage der Öffnung:\n\nDienstag bis Freitag: 7:00 - 19:15 Uhr\nSamstag: 7h - 19h\nSonntag: 7:00-13:00 Uhr\n\nMontag geschlossen\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nLieferung:\n\nTäglich ambulante Bäckerei-Touren in der Gegend von Achicourt, Arras und Beaurains.\n\n \n Bestellungen:\n\nTelefonische Bestellungen unter 03 21 55 25 50 möglich\n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries\n\nOpening days:\n\nTuesday to Friday: 7am - 7:15pm\nSaturday: 7am - 7pm\nSunday: 7am - 1pm\n\nClosed on Monday\n \n Collection :\n\nTakeaway during store opening hours\n\nDeliveries:\n\nMobile bakery tour of the Achicourt, Arras and Beaurains areas, every day.\n\n \n Ordering :\n\nOrder by phone 03 21 55 25 50\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria\n\nGiorni di apertura:\n\nDa martedì a venerdì: 7.00-19.15\nSabato: dalle 7.00 alle 19.00\nDomenica: dalle 7.00 alle 13.00\n\nChiuso il lunedì\n \n Raccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nConsegna: da asporto\n\nTour di panetteria mobile nelle zone di Achicourt, Arras e Beaurains, tutti i giorni.\n\n \n Ordini :\n\nÈ possibile ordinare per telefono al numero 03 21 55 25 50\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, pâtisseries \n\nJours d'ouverture:\n\nDu mardi au vendredi : 7h - 19h15\nLe samedi : 7h - 19h\nLe dimanche: 7h-13h\n\nFermeture le lundi\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nLivraison:\n\nTournée de boulangerie ambulante sur le secteur d'Achicourt, d'Arras et Beaurains, tous les jours.\n\n \n Commandes :\n\nPossibilité de commander par téléphone au  03 21 55 25 50\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak\n\nOpeningsdagen:\n\nDinsdag tot vrijdag: 7u - 19u15\nZaterdag: 7u - 19u\nZondag: 7.00 - 13.00\n\nMaandag gesloten\n \n Ophalen :\n\nAfhalen tijdens openingstijden winkel\n\nLevering: Om mee te nemen\n\nElke dag een mobiele bakkerij in de omgeving van Achicourt, Arras en Beaurains.\n\n \n Bestellingen :\n\nU kunt telefonisch bestellen op 03 21 55 25 50\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería\n\nDías de apertura:\n\nDe martes a viernes: de 7.00 a 19.15 h\nSábado: 7h - 19h\nDomingo: de 7.00 a 13.00 horas\n\nLunes cerrado\n \n Recogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nEntrega: Para llevar\n\nRecorridos de panadería móvil en las zonas de Achicourt, Arras y Beaurains, todos los días.\n\n \n Pedidos :\n\nPuede hacer sus pedidos por teléfono llamando al 03 21 55 25 50\n\n "
        ]
      },
