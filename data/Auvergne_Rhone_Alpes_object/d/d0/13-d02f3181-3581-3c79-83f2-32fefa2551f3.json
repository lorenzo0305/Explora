  "rdfs:comment": {
    "de": [
      "Julie und Tristan verarbeiten die Milch ihrer Ziegen und Schafe zu Bio-Käse (Picodon AOP, Tomme, Käse vom Typ Morbier, Fasel, Joghurt, Quark usw.). Sie bieten auch Pasteten und Fertiggerichte an."
    ],
    "en": [
      "Julie and Tristan transform the milk from their goats and ewes into organic cheeses (Picodon AOP, tomme, Morbier-type cheese, faisselle, yoghurts, fromage frais, etc.). They also offer pâtés and ready-made meals."
    ],
    "it": [
      "Julie e Tristan trasformano il latte delle loro capre e pecore in formaggi biologici (Picodon DOP, tomme, formaggio tipo Morbier, faisselle, yogurt, fromage frais, ecc.) Producono anche paté e piatti pronti."
    ],
    "fr": [
      "Julie et Tristan transforment le lait de leurs chèvres et de leurs brebis en fromages bio (Picodon AOP, tomme, fromage type Morbier, faisselle, yaourts, fromage blanc etc...). Ils proposent aussi des pâtés et des plats cuisinés."
    ],
    "es": [
      "Julie y Tristan transforman la leche de sus cabras y ovejas en quesos ecológicos (Picodon DOP, tomme, queso tipo Morbier, faisselle, yogures, queso fresco, etc.). También elaboran patés y platos preparados."
    ],
    "nl": [
      "Julie en Tristan verwerken de melk van hun geiten en ooien tot biologische kazen (Picodon BOB, tomme, kaas van het type Morbier, faisselle, yoghurt, fromage frais, enz.) Ze maken ook patés en kant-en-klaarmaaltijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Mas d'Ambane"
    ]
  },
