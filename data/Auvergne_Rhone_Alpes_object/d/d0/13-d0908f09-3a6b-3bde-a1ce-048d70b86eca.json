  "rdfs:comment": {
    "de": [
      "Côté Forme, ein Fitnesscenter, das Folgendes bietet\r\n? Einen Fitnessbereich\r\n? Einen Kardiobereich\r\n? Gruppenkurse (Step, Hilo, Zumba, Pilates, Bike, sanfte Gymnastik?)\r\n? Ein Barbereich\r\n? Eine fürsorgliche Betreuung und eine familiäre Atmosphäre?\r\nTesten und adoptieren Sie!"
    ],
    "en": [
      "Côté Forme is a fitness center that offers\r\n- A weight training area\r\n- A cardio area\r\n- Group classes (Step, Hilo, Zumba, Pilates, Bike, soft gym ...)\r\n- A bar area"
    ],
    "it": [
      "Côté Forme, un centro fitness che offre\r\n? Un'area pesi\r\n? Un'area cardio\r\n? Corsi di gruppo (step, Hilo, Zumba, Pilates, Bike, ginnastica dolce)?\r\n? Un'area bar\r\n? Personale cordiale e atmosfera familiare\r\nProvatelo e adottatelo!"
    ],
    "fr": [
      "Côté Forme, centre de remise en forme qui propose\r\n• Un espace musculation\r\n• Un espace cardio\r\n• Des cours collectifs (step, Hilo, Zumba, Pilates, Bike, gym douce …)\r\n• Un espace bar\r\n• Un encadrement bienveillant et une ambiance familiale\r\nTestez et adoptez !"
    ],
    "es": [
      "Côté Forme, un centro de fitness que ofrece\r\n? Un espacio de musculación\r\n? Un espacio cardio\r\n? Clases colectivas (step, Hilo, Zumba, Pilates, Bike, gimnasia suave...)\r\n? Una zona de bar\r\n? Personal amable y ambiente familiar\r\n¡Pruébalo y adóptalo!"
    ],
    "nl": [
      "Côté Forme, een fitnesscentrum met\r\n? Een gewichtenruimte\r\n? Een cardioruimte\r\n? Groepslessen (step, Hilo, Zumba, Pilates, Bike, gentle gym?)\r\n? Een bar\r\n? Vriendelijk personeel en een familiale sfeer\r\nProbeer het uit en adopteer het!"
    ]
  },
