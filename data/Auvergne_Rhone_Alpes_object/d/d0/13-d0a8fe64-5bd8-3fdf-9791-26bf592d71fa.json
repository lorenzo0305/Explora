  "rdfs:comment": {
    "de": [
      "Valérie und Marie-Flore heißen Sie herzlich willkommen in der Auberge Le Télémark, wo hausgemachte Gerichte in einer geselligen Atmosphäre serviert werden.\r\nNeuheit 2026: Genießen Sie ab 16 Uhr köstliche heiße Maronen für einen gemütlichen Après-Ski!"
    ],
    "en": [
      "Valérie and Marie-Flore warmly welcome you to Le Télémark inn, where homemade dishes are served in a friendly atmosphere.\r\nNew for 2026: Enjoy delicious hot chestnuts from 4pm for a cosy après-ski experience!"
    ],
    "it": [
      "Valérie e Marie-Flore vi danno un caloroso benvenuto alla locanda Le Télémark, dove vengono serviti piatti fatti in casa in un'atmosfera amichevole.\r\nNovità 2026: dalle 16.00 potrete gustare deliziose castagne calde per un accogliente après-ski!"
    ],
    "fr": [
      "Valérie et Marie-Flore vous accueillent chaleureusement à l’auberge Le Télémark, où des plats faits maison sont servis dans une ambiance conviviale. \r\nNouveauté 2026 : Savourez de délicieux marrons chauds dès 16h pour un après-ski chaleureux !"
    ],
    "es": [
      "Valérie y Marie-Flore le dan una calurosa bienvenida a la posada Le Télémark, donde se sirven platos caseros en un ambiente acogedor.\r\nNovedad para 2026: ¡disfrute de deliciosas castañas calientes a partir de las 16:00 para un acogedor après-ski!"
    ],
    "nl": [
      "Valérie en Marie-Flore heten je van harte welkom in herberg Le Télémark, waar huisgemaakte gerechten worden geserveerd in een gezellige sfeer.\r\nNieuw in 2026: Geniet vanaf 16.00 uur van heerlijke warme kastanjes voor een gezellige après-ski!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Gasthaus Le Télémark"
    ],
    "en": [
      "Auberge Le Télémark"
    ],
    "fr": [
      "Auberge Le Télémark"
    ]
  },
