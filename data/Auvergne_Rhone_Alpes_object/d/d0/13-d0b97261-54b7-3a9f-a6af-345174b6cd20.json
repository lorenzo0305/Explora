  "rdfs:comment": {
    "de": [
      "¨Mein Sommer auf dem Bauernhof Haute-Loire¨\r\nZucht von Prim'holstein-Kühen, Produktion von Milch der Marke Montlait. Grüne Linse von Puy AOP.\r\nBesuch des Betriebs, Melken...\r\nAuf Reservierung"
    ],
    "en": [
      "¨Mon été à la ferme Haute-Loire¨ (My summer on the farm in Haute-Loire)\r\nPrim'holstein cow breeding, Montlait brand milk production. Green Puy PDO lentils.\r\nFarm visit, milking...\r\nOn reservation"
    ],
    "it": [
      "la mia estate in fattoria nell'Alta Loira\r\nAllevamento di vacche Prim'holstein, produzione di latte a marchio Montlait. Lenticchie verdi di Puy DOP.\r\nVisita della fattoria, mungitura...\r\nSolo su prenotazione"
    ],
    "fr": [
      "¨Mon été à la ferme Haute-Loire¨\r\nElevage de vache Prim'holstein, production de lait de la marque Montlait. Lentille verte du Puy AOP.\r\nVisite d'exploitation, traite...\r\nSur réservation"
    ],
    "nl": [
      "¨Mijn zomer op de boerderij Haute-Loire¨\r\nPrim'holstein koehouderij, Montlait merk melkproductie. Groene Puy BOB linzen.\r\nBezoek aan de boerderij, melken...\r\nAlleen op reservering"
    ],
    "es": [
      "¨Mi verano en la granja Haute-Loire¨\r\nCría de vacas Prim'holstein, producción de leche marca Montlait. Lentejas verdes de Puy DOP.\r\nVisita de la granja, ordeño...\r\nSólo con reserva"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de ferme | Gaec Julien | Le Bouchet St Nicolas"
    ]
  },
