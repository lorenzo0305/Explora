  "rdfs:comment": {
    "de": [
      "Traditionelle Bäckerei mit geknetetetem Natursauerteig, Gebäck, Feingebäck und Snacks aus lokaler Herstellung.\r\nHeiße Getränke, Entspannungsbereich und gemütlicher Saal, alles zum Verzehr vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Traditional bakery with kneaded natural sourdough, locally-made pastries, viennoiseries and snacks.\r\nHot beverages, relaxation area and welcoming lounge, all to eat in or take away."
    ],
    "it": [
      "Panetteria tradizionale a lievitazione naturale impastata, pasticceria di produzione locale, viennoiseries e snack.\r\nBevande calde, un'area relax e un'accogliente sala da pranzo, tutto disponibile per il consumo interno o da asporto."
    ],
    "fr": [
      "Boulangerie traditionnelle au levain naturel pétri, pâtisseries, viennoiseries et snackings de fabrication locale. \r\nBoisson chaude, espace détente et salle accueillante, le tout à consommer sur place ou à emporter."
    ],
    "nl": [
      "Traditionele bakkerij met gekneed natuurlijk zuurdesem, lokaal gemaakt gebak, viennoiseries en snacks.\r\nWarme dranken, een ontspanningsruimte en een gezellige eetzaal, alles beschikbaar om te eten of mee te nemen."
    ],
    "es": [
      "Panadería tradicional con levadura natural amasada, bollería de elaboración local, viennoiseries y bocadillos.\r\nBebidas calientes, zona de relajación y un acogedor comedor, todo disponible para comer en casa o para llevar."
    ]
  },
  "rdfs:label": {
