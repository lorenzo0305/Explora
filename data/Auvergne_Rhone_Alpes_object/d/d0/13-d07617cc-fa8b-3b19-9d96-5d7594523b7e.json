  "rdfs:comment": {
    "de": [
      "In Chambost Longessaigne ist das Huhn Jacotte, genannt Cocotte, verschwunden! Helfen Sie uns, sie in Begleitung der Gnolus zu finden. Auf ihren Spuren können die Spieler das Dorf und seine alten Tätigkeiten wie die der Eierbechermacher kennenlernen."
    ],
    "en": [
      "In Chambost Longessaigne, the hen Jacotte, nicknamed Cocotte, has disappeared! Help us find her with the Gnolus. Following in her footsteps, players will discover the village and its ancient activities, such as the egg-cellar trade."
    ],
    "it": [
      "A Chambost Longessaigne, la gallina Jacotte, soprannominata Cocotte, è scomparsa! Aiutateci a ritrovarla con l'aiuto dello Gnolus. Seguendo le sue tracce, i giocatori potranno scoprire il villaggio e le sue attività di un tempo, come il commercio delle uova in cantina."
    ],
    "fr": [
      "A Chambost Longessaigne, la poule Jacotte surnommée Cocotte a disparu ! Aidez-nous à la retrouver en compagnie des Gnolus. Sur ses traces, les joueurs pourront découvrir le village et ses activités anciennes comme l’activité des coquetiers."
    ],
    "nl": [
      "In Chambost Longessaigne is de kip Jacotte, bijgenaamd Cocotte, verdwenen! Help ons haar te vinden met de hulp van de Gnolus. In haar voetsporen kunnen spelers het dorp en de activiteiten van weleer ontdekken, zoals de handel in eieren."
    ],
    "es": [
      "En Chambost Longessaigne, la gallina Jacotte, apodada Cocotte, ¡ha desaparecido! Ayúdanos a encontrarla con la ayuda de los Gnolus. Siguiendo sus pasos, los jugadores podrán descubrir el pueblo y sus actividades de antaño, como el comercio de hueveras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : T'as la côte, cocotte !"
    ]
  },
