  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2f563c35-359b-3989-86da-45606fc27648",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDas Geschäft ist dienstags bis samstags von 9:00 bis 13:00 Uhr und von 16:00 bis 19:00 Uhr sowie sonntags von 9:30 bis 13:00 Uhr und von 17:00 bis 19:00 Uhr geöffnet.\n\nDrive :\n\nEin Drive-In wird in Kürze von der Casino-Gruppe eingerichtet. Weitere Informationen finden Sie auf der Website.\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nThe store is open Tuesday to Saturday from 9am to 1pm and from 4pm to 7pm, and on Sundays from 9:30am to 1pm and from 5pm to 7pm.\n\nDrive :\n\nGroupe Casino will soon be launching a drive-through service. For further information, please visit the website.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nIl negozio è aperto dal martedì al sabato dalle 9.00 alle 13.00 e dalle 16.00 alle 19.00 e la domenica dalle 9.30 alle 13.00 e dalle 17.00 alle 19.00.\n\nGuida:\n\nIl Groupe Casino organizzerà a breve una raccolta di fondi. Per ulteriori informazioni, visitare il sito web.\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture:\n\nLe magasin est ouvert du mardi au samedi de 9h à 13h et de 16h à 19h et le dimanche de 9h30 à 13h et de 17h à 19h.\n\nDrive :  \n\nUn drive sera mis en place prochainement pas le Groupe Casino. Pour plus d'informations, vous pouvez vous rendre sur le site internet.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDe winkel is geopend van dinsdag tot en met zaterdag van 9.00 tot 13.00 uur en van 16.00 tot 19.00 uur en op zondag van 9.30 tot 13.00 uur en van 17.00 tot 19.00 uur.\n\nRijden :\n\nGroupe Casino organiseert binnenkort een inzamelingsactie. Ga voor meer informatie naar de website.\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nLa tienda abre de martes a sábado de 9:00 a 13:00 y de 16:00 a 19:00 y los domingos de 9:30 a 13:00 y de 17:00 a 19:00.\n\nConducción :\n\nEl Grupo Casino organizará próximamente una colecta. Para más información, visite el sitio web.\n\n "
        ]
      },
