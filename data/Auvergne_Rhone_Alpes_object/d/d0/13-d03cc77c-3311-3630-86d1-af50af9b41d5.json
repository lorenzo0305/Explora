  "rdfs:comment": {
    "de": [
      "Arbeiten Sie in einer ruhigen und freundlichen Atmosphäre inmitten einer außergewöhnlichen Umgebung. Treffen Sie Fachleute aus der Region, denen ihre Heimat am Herzen liegt!"
    ],
    "en": [
      "Come and work in a calm and friendly atmosphere, in the midst of exceptional surroundings. Meet local professionals who care about their region!"
    ],
    "it": [
      "Venite a lavorare in un'atmosfera tranquilla e amichevole, in un ambiente eccezionale. Incontrate professionisti locali che hanno a cuore la loro regione!"
    ],
    "fr": [
      "Venez travailler dans une ambiance calme et conviviale, au milieu d’un cadre exceptionnel. Rencontrez des professionnels de la région ayant leur territoire au cœur !"
    ],
    "es": [
      "Venga a trabajar en un ambiente tranquilo y agradable, en un marco excepcional. ¡Conozca a profesionales locales que llevan su región en el corazón!"
    ],
    "nl": [
      "Kom werken in een rustige en vriendelijke sfeer, in een uitzonderlijke omgeving. Ontmoet lokale professionals die hun regio een warm hart toedragen!"
    ]
  },
  "rdfs:label": {
