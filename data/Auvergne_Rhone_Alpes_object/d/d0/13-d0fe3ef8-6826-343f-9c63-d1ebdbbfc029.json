  "rdfs:comment": {
    "de": [
      "Das Maison du Doyenné ist ein Herrenhaus aus dem 15. Jahrhundert, das vor allem für seine Fassade zum Hof hin bekannt ist.\r\nUm es zu entdecken, gehen Sie in die Rue François Péron 26 und wenden Sie sich an die Librairie Devaux! Nur nach Terminvereinbarung."
    ],
    "en": [
      "The Maison du Doyenné is a 15th-century town house, best known for its courtyard façade.\r\nTo discover it, go to 26 rue François Péron and visit Librairie Devaux! By appointment only."
    ],
    "it": [
      "La Maison du Doyenné è una casa di città del XV secolo, nota soprattutto per la sua facciata a corte.\r\nPer scoprirla, recatevi al 26 di rue François Péron e visitate la Librairie Devaux! Solo su appuntamento."
    ],
    "fr": [
      "La Maison du Doyenné est un hôtel particulier du XVème siècle, connu notamment pour sa façade sur cour. \r\nPour la découvrir, passez au 26 rue François Péron et adressez-vous à la Librairie Devaux ! Sur rendez-vous uniquement."
    ],
    "es": [
      "La Maison du Doyenné es una casa urbana del siglo XV, conocida sobre todo por su fachada con patio.\r\nPara descubrirla, vaya al 26 rue François Péron y visite la Librairie Devaux Sólo con cita previa."
    ],
    "nl": [
      "Het Maison du Doyenné is een 15e-eeuws herenhuis, vooral bekend om zijn binnenplaatsgevel.\r\nOm het te ontdekken, ga naar 26 rue François Péron en bezoek de Librairie Devaux! Alleen op afspraak."
    ]
  },
