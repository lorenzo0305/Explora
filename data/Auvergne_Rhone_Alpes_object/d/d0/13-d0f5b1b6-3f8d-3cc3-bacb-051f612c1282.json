  "rdfs:comment": {
    "de": [
      "Verein, der Obdachlosen in Madagaskar hilft, indem er sie nach einer Ausbildung in für sie organisierten Dörfern wieder eingliedert und ihre Kinder bis zur Hochschulreife einschulen lässt."
    ],
    "en": [
      "Association helping the homeless of Madagascar by reintegrating them after training in villages organized for them and by educating their children up to university level."
    ],
    "it": [
      "Un'associazione che aiuta i senzatetto in Madagascar reintegrandoli dopo la formazione in villaggi organizzati per loro e istruendo i loro figli fino al livello universitario."
    ],
    "fr": [
      "Association venant en aide aux sans abris de Madagascar en les réinsérant après formation dans des villages organisés pour eux et en scolarisant leurs enfants jusqu'aux études supérieures."
    ],
    "nl": [
      "Een vereniging die daklozen in Madagaskar helpt door ze te re-integreren na een opleiding in dorpen die voor hen worden georganiseerd, en door hun kinderen tot universitair niveau op te leiden."
    ],
    "es": [
      "Asociación que ayuda a los sin techo de Madagascar reinsertándolos tras una formación en aldeas organizadas para ellos, y educando a sus hijos hasta el nivel universitario."
    ]
  },
