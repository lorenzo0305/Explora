  "rdfs:comment": {
    "de": [
      "Das Team des Sportgeschäfts Valetmont befindet sich am Col de Merdassier und empfängt Sie, um Sie zu beraten und Ihnen die besten Dienstleistungen für Ihren Urlaub anzubieten."
    ],
    "en": [
      "Located at the Col de Merdassier, the Valetmont sports shop team welcomes you to advise you and offer you the best services for your holidays."
    ],
    "it": [
      "Situato sul Col de Merdassier, il team del negozio sportivo Valetmont sarà lieto di consigliarvi e offrirvi i migliori servizi per le vostre vacanze."
    ],
    "fr": [
      "Situé au Col de Merdassier, l'équipe du magasin de sport Valetmont vous accueille pour vous conseiller et vous offrir les meilleurs services pour vos vacances."
    ],
    "es": [
      "Situada en el Col de Merdassier, el equipo de la tienda de deportes Valetmont estará encantado de aconsejarle y ofrecerle los mejores servicios para sus vacaciones."
    ],
    "nl": [
      "Het team van de sportwinkel van Valetmont, gelegen op de Col de Merdassier, geeft je graag advies en biedt je de beste diensten voor je vakantie."
    ]
  },
