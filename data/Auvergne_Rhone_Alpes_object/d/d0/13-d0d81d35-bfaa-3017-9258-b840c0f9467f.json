  "rdfs:comment": {
    "de": [
      "Dieses gemütlich eingerichtete Restaurant ist die einzige Crêperie der Auvergne im Herzen des historischen Zentrums von Montluçon. Es bietet Ihnen Galettes, die vor allem von den Bourioles Cantaliennes inspiriert sind und aus lokalen Produkten bestehen, sowie süße Gourmet-Crêpes."
    ],
    "en": [
      "The only crêperie in the Auvergne region, in the heart of Montluçon's historic center, this cosy restaurant offers galettes inspired by Cantalien bourioles and made with local produce, and gourmet sweet crêpes."
    ],
    "it": [
      "L'unica crêperie della regione dell'Alvernia, nel cuore del centro storico di Montluçon, questo accogliente ristorante offre galettes ispirate alle bourioles cantalesi e realizzate con prodotti locali, e crêpes dolci da gourmet."
    ],
    "fr": [
      "Unique crêperie auvergnate au cœur du centre historique de Montluçon, ce restaurant à la décoration cosy vous propose des galettes notamment inspirées des bourioles cantaliennes et composées de produits locaux, et des crêpes sucrées gourmandes."
    ],
    "es": [
      "Única crepería de la región de Auvernia, en pleno centro histórico de Montluçon, este acogedor restaurante ofrece galettes inspiradas en las bourioles cantálicas y elaboradas con productos locales, así como crepes dulces gourmet."
    ],
    "nl": [
      "Dit gezellige restaurant, de enige crêperie in de Auvergne in het hart van het historische centrum van Montluçon, biedt galettes geïnspireerd op bourioles uit de Cantalien en gemaakt met lokale producten, en zoete crêpes voor fijnproevers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Karadoc - Crêperie auvergnate"
    ]
  },
