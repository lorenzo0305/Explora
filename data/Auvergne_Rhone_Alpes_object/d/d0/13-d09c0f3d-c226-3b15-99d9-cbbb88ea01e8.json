  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek von Vercheny wird von der Assocation \"Lire pour grandir\" verwaltet. Sie können bis zu 3 Bücher für 3 Wochen ausleihen (Verlängerung möglich)."
    ],
    "en": [
      "The Vercheny communal library is run by the \"Lire pour grandir\" association. You can borrow up to 3 books for 3 weeks (extension possible)."
    ],
    "it": [
      "La biblioteca comunale di Vercheny è gestita dall'associazione \"Lire pour grandir\". È possibile prendere in prestito fino a 3 libri per 3 settimane (possibilità di proroga)."
    ],
    "fr": [
      "La bibliothèque communale de Vercheny est gérée par l'Assocation \"Lire pour grandir\". Vous pouvez emprunter jusqu'à 3 livres pour 3 semaines (prolongation possible)."
    ],
    "es": [
      "La biblioteca municipal de Vercheny está gestionada por la asociación \"Lire pour grandir\". Puedes tomar prestados hasta 3 libros durante 3 semanas (se puede ampliar)."
    ],
    "nl": [
      "De gemeenschapsbibliotheek van Vercheny wordt beheerd door de vereniging \"Lire pour grandir\". Je kunt maximaal 3 boeken lenen voor 3 weken (verlenging mogelijk)."
    ]
  },
