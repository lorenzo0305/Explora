  "rdfs:comment": {
    "de": [
      "- Terrasse in Südlage mit Panoramablick\r\n- Herzlicher Empfang\r\n- Außenwohnzimmer mit riesigen Poufs und Braséro.\r\n- Vintage- und atypische Innenatmosphäre\r\n- Spielbereich für Kinder\r\n- Museum des Skisports\r\n- Musikalische Themennachmittage\r\n- Bügelschloss für Ihre Skier zur Verfügung"
    ],
    "en": [
      "- Panoramic south-facing terrace\r\n- Warm welcome\r\n- Outdoor lounge with giant poufs and brazier\r\n- Vintage and atypical interior ambience\r\n- Children's play area\r\n- Ski museum\r\n- Themed musical afternoons\r\n- Ski lock available"
    ],
    "it": [
      "- Terrazza panoramica esposta a sud\r\n- Accoglienza calorosa\r\n- Salotto all'aperto con pouf giganti e braciere\r\n- Atmosfera interna vintage e atipica\r\n- Area giochi per bambini\r\n- Museo dello sci\r\n- Pomeriggi musicali a tema\r\n- Blocco sci disponibile"
    ],
    "fr": [
      "- Terrasse plein Sud panoramique\r\n- Accueil chaleureux\r\n- Salon extérieur avec poufs géants et braséro\r\n- Ambiance intérieure vintage et atypique\r\n- Zone de jeux pour enfants\r\n- Musée du ski\r\n- Après-midis musicaux à thèmes\r\n- Antivol pour vos skis à dispo"
    ],
    "es": [
      "- Terraza panorámica orientada al sur\r\n- Cálida bienvenida\r\n- Salón exterior con pufs gigantes y brasero\r\n- Ambiente interior vintage y atípico\r\n- Zona de juegos para niños\r\n- Museo del esquí\r\n- Tardes musicales temáticas\r\n- Guardaesquís disponible"
    ],
    "nl": [
      "- Panoramisch terras op het zuiden\r\n- Warm welkom\r\n- Outdoor lounge met reusachtige poefs en vuurkorf\r\n- Vintage en atypisch interieur\r\n- Speelruimte voor kinderen\r\n- Skimuseum\r\n- Themamiddagen met muziek\r\n- Skislot beschikbaar"
    ]
  },
