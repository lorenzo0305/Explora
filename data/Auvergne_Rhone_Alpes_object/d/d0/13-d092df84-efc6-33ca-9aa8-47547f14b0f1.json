  "rdfs:comment": {
    "de": [
      "Französisches Lederwarenhaus mit Handtaschen, Accessoires und Kleinlederwaren. Unsere Mission besteht vollständig in Romans sur Isere darin, Eleganz erschwinglich und verantwortungsvoll zu machen."
    ],
    "en": [
      "French leather goods house offering handbags, accessories and small leather goods. Made entirely in Romans sur Isere, our mission is to make elegance affordable and responsible."
    ],
    "it": [
      "Casa francese di pelletteria che offre borse, accessori e piccola pelletteria. Realizzati interamente a Romans sur Isere, la nostra missione è rendere l'eleganza accessibile e responsabile."
    ],
    "fr": [
      "Maison de maroquinerie Française proposant sacs à main, accessoires et petite maroquinerie. Fabriqué intégralement  à Romans sur Isere, notre mission est de rendre l'élégance abordable et responsable."
    ],
    "nl": [
      "Frans lederwarenhuis met handtassen, accessoires en kleine lederwaren. Volledig gemaakt in Romans sur Isere, onze missie is om elegantie betaalbaar en verantwoord te maken."
    ],
    "es": [
      "Empresa francesa de marroquinería que ofrece bolsos, accesorios y pequeña marroquinería. Fabricados íntegramente en Romans sur Isere, nuestra misión es hacer que la elegancia sea asequible y responsable."
