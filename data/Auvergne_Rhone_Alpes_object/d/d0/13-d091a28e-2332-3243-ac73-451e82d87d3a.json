  "rdfs:comment": {
    "de": [
      "Produzent von Salers-Rindfleisch: Direktverkauf bei Besuchen auf dem Bauernhof oder in Erzeugerläden in Le Mazet St Voy.\r\nUnterkunft auf dem Bauernhof. Frischfleisch, gekochte Kutteln, Terrinen, Rinderwurst, regionale Burger für Veranstaltungen."
    ],
    "en": [
      "Producer of Salers beef: direct sales during farm visits or in producers' stores at Le Mazet St Voy.\r\nFarm cottage. Fresh meat, cooked tripe, terrines, beef sausages, local burgers for special events."
    ],
    "it": [
      "Produttore di carne bovina di Salers: vendita diretta durante le visite alla fattoria o nei negozi dei produttori a Le Mazet St Voy.\r\nGite in fattoria. Carne fresca, trippa cotta, terrine, salsicce di manzo, hamburger locali per eventi."
    ],
    "fr": [
      "Producteur de viande de bœuf Salers : vente directe lors de visites à la ferme ou en magasins de producteurs au Mazet St Voy.\r\nGite à la ferme. Viande fraiche, tripes cuisinées, terrines, saucissons de bœuf, burgers du terroir en évènementiel."
    ],
    "es": [
      "Productor de carne de vacuno de Salers: venta directa durante las visitas a la granja o en las tiendas de los productores de Le Mazet St Voy.\r\nCasa rural en la granja. Carne fresca, callos cocidos, terrinas, salchichas de ternera, hamburguesas locales para eventos."
    ],
    "nl": [
      "Producent van rundvlees uit Salers: directe verkoop tijdens boerderijbezoeken of in de winkel van de producent in Le Mazet St Voy.\r\nGite op de boerderij. Vers vlees, gekookte pens, terrines, runderworstjes, hamburgers uit de streek voor evenementen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Salers et Bol d'Air"
    ]
  },
