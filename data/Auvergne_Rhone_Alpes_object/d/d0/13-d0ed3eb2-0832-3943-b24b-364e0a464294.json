  "rdfs:comment": {
    "de": [
      "Die Auberge le pas de l'Alpette ist eine gemütliche Naturherberge, in der Sie die Berge und das Chartreuse-Massiv entdecken können. Ein gemütlicher Zwischenstopp und Ideen für Ihren Aufenthalt, um in die weiten Naturräume der Berge zu gelangen."
    ],
    "en": [
      "A comfortable, natural hostel from which you can explore the mountains and the Chartreuse massif. A cosy stopover with ideas for trips into the wide open spaces of the mountains. The end of the world on your doorstep."
    ],
    "it": [
      "Le Pas de l'Alpette è un ostello naturale e confortevole per scoprire le montagne e il massiccio della Chartreuse, una sosta accogliente e idee per un soggiorno all'aria aperta in montagna."
    ],
    "fr": [
      "L'auberge le pas de l'Alpette est une auberge nature et confortable pour découvrir la montagne et le massif de Chartreuse, une halte douillette et des idées de séjours pour aller vers les grands espaces nature de la montagne."
    ],
    "es": [
      "Le Pas de l'Alpette es un albergue natural y confortable donde podrá descubrir las montañas y el macizo de Chartreuse, una parada acogedora e ideas para una estancia en la gran naturaleza de las montañas."
    ],
    "nl": [
      "Een natuurlijke en comfortabele herberg om de bergen en het Chartreuse-massief te ontdekken. Een gezellige tussenstop en ideeën voor uitstapjes in de bergen. Het einde van de wereld voor de deur."
    ]
  },
  "rdfs:label": {
