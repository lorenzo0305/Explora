  "rdfs:comment": {
    "de": [
      "Produkte aus der Region. Besuchen Sie auch die Bauernhoftiere (Ziegen, Schafe, Hühner, Enten usw.), aus denen sich der kleine Hühnerhof zusammensetzt."
    ],
    "en": [
      "Regional products. Come and discover the farm animals (goats, sheep, chickens, ducks, etc.) that make up the small farmyard."
    ],
    "it": [
      "Prodotti regionali. Venite a scoprire gli animali della fattoria (capre, pecore, galline, anatre, ecc.) che compongono la piccola aia."
    ],
    "fr": [
      "Produits régionaux. Venez également y découvrir les animaux de ferme (chèvres, moutons, poules, canard, etc.) qui composent la petite basse-cour."
    ],
    "nl": [
      "Streekproducten. Kom en ontdek de boerderijdieren (geiten, schapen, kippen, eenden, enz.) die het kleine boerenerf vormen."
    ],
    "es": [
      "Productos regionales. Venga a descubrir los animales de granja (cabras, ovejas, gallinas, patos, etc.) que componen el pequeño corral."
    ]
