  "rdfs:comment": {
    "de": [
      "Sind Sie bereit zu reisen? Der Ozean im Herzen von Lyon. Von den winzigen Demoiselles bis zum imposanten Wels, von den zarten Seepferdchen bis zu den schelmischen Clownfischen, mehr als 310 Arten, 3500 Fische und 42 Ökosysteme."
    ],
    "en": [
      "Ready to travel? The ocean in the heart of Lyon. From tiny damselfish to imposing sheatfish, delicate seahorses to mischievous clownfish, over 300 species, 3,000 fish and 39 ecosystems."
    ],
    "it": [
      "Pronti a viaggiare? L'oceano nel cuore di Lione. Dalle minuscole castagnole agli imponenti pesci gatto, dai delicati cavallucci marini ai dispettosi pesci pagliaccio, oltre 310 specie, 3.500 pesci e 42 ecosistemi."
    ],
    "fr": [
      "Prêts à voyager ? L'océan au cœur de Lyon. Des minuscules Demoiselles à l’imposant Silure, des délicats hippocampes au malicieux poissons-clowns, plus de 310 espèces, 3500 poissons et 42 écosystèmes."
    ],
    "es": [
      "¿Listo para viajar? El océano en el corazón de Lyon. Del diminuto pez damisela al imponente pez cabra, del delicado caballito de mar al travieso pez payaso, más de 310 especies, 3.500 peces y 42 ecosistemas."
    ],
    "nl": [
      "Klaar om te reizen? De oceaan in het hart van Lyon. Van kleine waterjuffers tot imposante zeeduivels, van delicate zeepaardjes tot ondeugende clownsvissen, meer dan 310 soorten, 3500 vissen en 42 ecosystemen."
    ]
  },
