  "rdfs:comment": {
    "de": [
      "Eine ehemalige Käserei, die in zwei Teile umgebaut wurde: einen Kennenlern-Shop mit Käse- und Wurstverkauf, und ein Restaurant, in dem man regionale Gerichte probieren kann."
    ],
    "en": [
      "A former cheese farm has been divided into two sections: one is a shop to discover and buy the cheeses and meats on offer, and the other is a restaurant to taste the regional specialities."
    ],
    "it": [
      "Un ex caseificio trasformato in due sezioni: un negozio dove acquistare formaggi e salumi e un ristorante dove gustare piatti regionali.\r\ni cani non sono ammessi"
    ],
    "fr": [
      "Une ancienne fromagerie qui a été transformée en deux parties: une partie boutique pour la découverte et vente de fromage, charcuterie, et une partie restaurant pour déguster les mets régionaux.\r\nles chiens ne sont pas acceptés"
    ],
    "nl": [
      "Een voormalige kaasfabriek die in twee delen is veranderd: een winkel voor de ontdekking en verkoop van kaas en vleeswaren, en een restaurant om de regionale gerechten te proeven.\r\nhonden zijn niet toegestaan"
    ],
    "es": [
      "Antigua quesería reconvertida en dos secciones: una tienda donde comprar quesos y embutidos, y un restaurante donde degustar platos regionales.\r\nno se admiten perros"
    ]
  },
