  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/66c674dc-55de-3e62-b5df-9adf27787a62",
      "dc:description": {
        "de": [
          "Breaking ist ein akrobatischer Tanzstil, der vom Hip-Hop abstammt und seit den 70er Jahren für Furore sorgt. Romuald Brizolier und die Kompanie Art Track haben sich für den Louvre-Lens ein maßgeschneidertes Programm rund um Break und Foot ausgedacht."
        ],
        "en": [
          "An additional sport of the Paris 2024 Olympics, breaking is an acrobatic dance style derived from hip-hop that has been causing a sensation since the 1970s. Romuald Brizolier and the Art Track company have devised a tailor-made program for Louvre-Lens based on breaking and soccer."
        ],
        "it": [
          "Il breaking, uno stile di danza acrobatica derivato dall'hip-hop che ha fatto scalpore fin dagli anni '70, sarà uno sport aggiuntivo alle Olimpiadi di Parigi 2024. Romuald Brizolier e la società Art Track hanno ideato un programma su misura per Louvre-Lens basato sul breaking e sul calcio."
        ],
        "fr": [
          "Sport additionnel des JO de Paris 2024, le breaking est un style de danse acrobatique dérivé du hip-hop qui fait sensation depuis les années 70. Romuald Brizolier et la compagnie Art Track ont imaginé un programme sur mesure pour le Louvre-Lens autour du Break et du Foot."
        ],
        "es": [
          "El breaking, un estilo de danza acrobática derivado del hip-hop que causa sensación desde los años 70, será un deporte más en los Juegos Olímpicos de París 2024. Romuald Brizolier y la empresa Art Track han ideado para Louvre-Lens un programa a medida basado en el breaking y el fútbol."
        ],
        "nl": [
          "Breaking, een van hiphop afgeleide acrobatische dansstijl die al sinds de jaren 1970 furore maakt, wordt een extra sport op de Olympische Spelen van 2024 in Parijs. Romuald Brizolier en het bedrijf Art Track hebben voor Louvre-Lens een op maat gemaakt programma bedacht op basis van breaking en voetbal."
        ]
      },
