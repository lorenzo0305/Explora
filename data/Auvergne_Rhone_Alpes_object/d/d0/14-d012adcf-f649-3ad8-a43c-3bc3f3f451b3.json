      "@id": "https://data.datatourisme.fr/08a36479-3d5b-311a-b240-2f515d7413d3",
      "dc:description": {
        "de": [
          "Treten Sie durch die Türen eines der ältesten Geschäfte in Wimereux und entdecken Sie die Produkte, die in dieser Käserei und Molkerei angeboten werden."
        ],
        "en": [
          "Step through the doors of one of Wimereux's oldest shops and discover the products on offer at this cheese and creamery."
        ],
        "it": [
          "Varcate le porte di uno dei più antichi negozi di Wimereux e scoprite i prodotti offerti da questo caseificio e cremeria."
        ],
        "fr": [
          "Franchissez les portes de l'un des plus anciens commerces de Wimereux et découvrez les produits proposés par cette fromagerie-crèmerie."
        ],
        "nl": [
          "Stap door de deuren van een van de oudste winkels van Wimereux en ontdek de producten die deze kaas- en zuivelfabriek aanbiedt."
        ],
        "es": [
          "Atraviese las puertas de una de las tiendas más antiguas de Wimereux y descubra los productos de esta quesería y cremería."
        ]
      },
