  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine sehr schöne Auswahl an Weinen von hier und anderswo, die Sie vor Ort probieren oder mitnehmen können Vor Ort,\r\nunsere Weinkarte wird durch ein Feinschmeckerangebot an Tapas zwischen Land und Meer oder gekochten Speisen ergänzt."
    ],
    "en": [
      "Come and discover a fine selection of local and international wines to taste on the premises or to take away... On the premises, a gourmet range of tapas from land to sea, or cooked dishes, completes our wine list."
    ],
    "it": [
      "Venite a scoprire una raffinata selezione di vini locali e internazionali da degustare sul posto o da portare via... Sul posto,\r\nla nostra carta dei vini è completata da una selezione gourmet di tapas di terra e di mare o di piatti cucinati."
    ],
    "fr": [
      "Venez découvrir une très belle sélection de vins d’ici et d’ailleurs à déguster sur place ou à emporter… Sur place,\r\nune offre gourmande de tapas entre terre et mer ou cuisinées vient compléter notre carte des vins."
    ],
    "es": [
      "Venga a descubrir una magnífica selección de vinos de aquí y del extranjero para degustar en el establecimiento o para llevar.. En el local,\r\nnuestra carta de vinos se complementa con una selección gourmet de tapas de la tierra y el mar, o platos cocinados."
    ],
    "nl": [
      "Kom elke dag vanaf 18.00 uur een fijne selectie lokale en internationale wijnen ontdekken om ter plekke te proeven of mee te nemen... Onze wijnkaart wordt aangevuld met een gastronomische selectie tapas van land en zee of gekookte gerechten."
    ]
  },
  "rdfs:label": {
