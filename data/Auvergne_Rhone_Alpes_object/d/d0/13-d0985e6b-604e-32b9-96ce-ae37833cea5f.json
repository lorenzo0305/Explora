  "rdfs:comment": {
    "de": [
      "In Cros de Ronesque im Cantal, 7/7 geöffnet. Zwei Säle mit 28 Gedecken und 12 Gedecken, die für Personen mit eingeschränkter Mobilität zugänglich sind. Reservierung wird empfohlen.\r\nBAR (Lizenz IV) mit alkoholischen und nicht-alkoholischen Getränken"
    ],
    "en": [
      "At Cros de Ronesque in the Cantal region, open 7/7. Two 28-cover and 12-cover rooms accessible to people with reduced mobility. Reservations recommended.\r\nBar (license IV) with alcoholic and non-alcoholic beverages."
    ],
    "it": [
      "A Cros de Ronesque nel Cantal, aperto 7/7. Due sale da pranzo con 28 coperti e 12 coperti, accessibili alle persone con mobilità ridotta. Si consiglia la prenotazione.\r\nBar (licenza IV) con bevande alcoliche e analcoliche"
    ],
    "fr": [
      "A Cros de Ronesque dans le cantal, ouvert 7/7. Deux salles de 28 couverts et  12 couverts accessibles aux personnes à mobilité réduite. Réservation recommandée.\r\nBAR (licence IV) avec boissons alcoolisées et non alcoolisées"
    ],
    "nl": [
      "In Cros de Ronesque in de Cantal, open 7/7. Twee eetzalen met 28 couverts en 12 couverts, toegankelijk voor mensen met beperkte mobiliteit. Reserveren aanbevolen.\r\nBar (vergunning IV) met alcoholische en niet-alcoholische dranken"
    ],
    "es": [
      "En Cros de Ronesque, en el Cantal, abierto 7/7. Dos comedores con 28 cubiertos y 12 cubiertos, accesibles a personas con movilidad reducida. Se recomienda reservar.\r\nBar (licencia IV) con bebidas alcohólicas y no alcohólicas."
    ]
  },
