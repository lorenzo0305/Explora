  "rdfs:comment": {
    "de": [
      "Besichtigung eines Bauernhofs mit Highland-Rindern"
    ],
    "en": [
      "Visit a Highland Cattle farm. Experience unique moments and share my profession, my passion. Laur'Highland offers two formulas, \"Discovery visit\" and \"Farmer for a day\"."
    ],
    "it": [
      "Visitare una fattoria che alleva bovini delle Highlands, le robuste mucche scozzesi che sembrano orsacchiotti. Vivete momenti unici e condividete la mia professione, la mia passione."
    ],
    "fr": [
      "Visitez une ferme d'élevage de Highland Cattle, ces vaches écossaises rustiques aux allures de nounours. Vivez des instants uniques et partagez ma profession, ma passion."
    ],
    "es": [
      "Visite una granja que cría ganado Highland, esas robustas vacas escocesas que parecen ositos de peluche. Viva momentos únicos y comparta mi profesión, mi pasión."
    ],
    "nl": [
      "Bezoek een boerderij die Highland Cattle fokt, die stoere Schotse koeien die eruitzien als teddyberen. Beleef unieke momenten en deel mijn beroep, mijn passie."
    ]
  },
  "rdfs:label": {
    "de": [
