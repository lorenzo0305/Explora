  "rdfs:comment": {
    "de": [
      "Ballonfahrten über die Haute-Savoie!\r\nStarten Sie in der Nähe von Annecy, La Clusaz oder Châtel und genießen Sie das Vergnügen des freien Fliegens, während Sie die Berge, Seen und Dörfer aus der Luft bewundern!"
    ],
    "en": [
      "Hot air balloon flights over the Haute-Savoie!\r\nFrom the surroundings of Annecy, La Clusaz, or Châtel, come and taste the pleasure of free flight while admiring mountains, lakes and villages from the sky!"
    ],
    "it": [
      "Voli in mongolfiera sull'Alta Savoia!\nPartendo dalla zona di Annecy, dal Lago di Ginevra, dalla Vallée Verte, da La Clusaz o da Châtel, venite a provare il piacere del volo libero ammirando le montagne, i laghi e i villaggi dal cielo!"
    ],
    "fr": [
      "Vols en montgolfière au-dessus de la Haute-Savoie !\nAu départ des alentours d'Annecy, du Lac Léman, de la Vallée Verte, de La Clusaz, ou encore de Châtel, venez goûter au plaisir du vol libre tout en admirant montagnes, lacs et villages vus du ciel !"
    ],
    "es": [
      "¡Vuelos en globo sobre la Alta Saboya!\nDesde Annecy, el lago Lemán, el Valle Verde, La Clusaz o Châtel, disfrute del placer del vuelo libre admirando las montañas, los lagos y los pueblos desde el cielo"
    ],
    "nl": [
      "Luchtballonvaarten boven de Haute-Savoie!\nKom vanuit de omgeving van Annecy, het meer van Genève, de Vallée Verte, La Clusaz of Châtel genieten van het plezier van een vrije vlucht terwijl je de bergen, meren en dorpen vanuit de lucht bewondert!"
    ]
  },
