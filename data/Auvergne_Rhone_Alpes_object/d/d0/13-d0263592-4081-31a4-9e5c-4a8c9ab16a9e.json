  "rdfs:comment": {
    "de": [
      "Die Brasserie des tilleuls braut mit Leidenschaft und Engagement einfache, aber auch sehr technische Biere. Wir lieben unseren Beruf als Brauer und freuen uns, ihn Ihnen näher bringen zu können."
    ],
    "en": [
      "La brasserie des tilleuls brews simple but highly technical beers with passion and commitment. We love our craft and are happy to share it with you."
    ],
    "it": [
      "Il birrificio des tilleuls produce con passione e impegno birre semplici ma molto tecniche. Amiamo il nostro lavoro di birrai e siamo felici di aiutarvi a scoprirlo."
    ],
    "fr": [
      "La brasserie des tilleuls brasse avec passion et engagement des bières simples mais aussi très techniques. Nous aimons notre métier de brasseur et nous sommes heureux de vous le faire découvrir."
    ],
    "es": [
      "La cervecería des tilleuls elabora con pasión y compromiso cervezas sencillas pero muy técnicas. Nos encanta nuestro trabajo como cerveceros y estamos encantados de ayudarte a descubrirlo."
    ],
    "nl": [
      "De Brasserie des Tilleuls brouwt eenvoudige maar zeer technische bieren met passie en toewijding. We houden van ons werk als brouwers en delen het graag met jou."
    ]
  },
