  "rdfs:comment": {
    "de": [
      "Véloplato ist ein lokales Geschäft in La Chapelle-en-Vercors. Er ist auf den Verkauf und die Reparatur von Fahrrädern spezialisiert und bietet auch den Verleih von elektrischen Mountainbikes an."
    ],
    "en": [
      "Véloplato is a convenience store located in La Chapelle-en-Vercors. Specializing in cycle sales and repairs, it also offers electric mountain bike rental services."
    ],
    "it": [
      "Véloplato è un negozio locale a La Chapelle-en-Vercors. Specializzato nella vendita e riparazione di biciclette, offre anche servizi di noleggio di mountain bike elettriche."
    ],
    "fr": [
      "Véloplato est un magasin de proximité situé à La Chapelle-en-Vercors. Spécialisé dans la vente et la réparation de cycles, il propose également des services de location de VTT électriques."
    ],
    "nl": [
      "Véloplato is een plaatselijke winkel in La Chapelle-en-Vercors. De winkel is gespecialiseerd in fietsverkoop en -reparaties en verhuurt ook elektrische mountainbikes."
    ],
    "es": [
      "Véloplato es una tienda local de La Chapelle-en-Vercors. Especializada en la venta y reparación de bicicletas, también ofrece servicios de alquiler de bicicletas eléctricas de montaña."
    ]
  },
