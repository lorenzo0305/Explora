  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage der Kunsthandwerke 2026 lädt Alice Rivière Sie ein, die Technik des Tufting an ihrem Arbeitsplatz zu entdecken."
    ],
    "en": [
      "As part of the 2026 edition of the Journées Européennes des Métiers d'Art, Alice Rivière invites you to discover the tufting technique at her workplace."
    ],
    "it": [
      "Nell'ambito dell'edizione 2026 delle Journées Européennes des Métiers d'Art, Alice Rivière vi invita a scoprire la tecnica del tufting nel suo luogo di lavoro."
    ],
    "fr": [
      "Dans le cadre de l'édition 2026 des Journées Européennes des Métiers d'Art, Alice Rivière vous propose de découvrir la technique du Tufting, ou touffetage, sur son lieu de travail."
    ],
    "nl": [
      "In het kader van de editie 2026 van de Journées Européennes des Métiers d'Art nodigt Alice Rivière je uit om de tufttechniek in haar werkplaats te ontdekken."
    ],
    "es": [
      "En el marco de la edición 2026 de las Journées Européennes des Métiers d'Art, Alice Rivière le invita a descubrir la técnica del tufting en su lugar de trabajo."
    ]
  },
  "rdfs:label": {
