  "rdfs:comment": {
    "de": [
      "Sie ist leicht zugänglich und bietet die Möglichkeit, mit Bergführern zu lernen oder selbstständig zu trainieren. Niveau: Anfänger bis Experte. Für alle zugänglich, je nach Zugangsbedingungen und Nutzungscharta."
    ],
    "en": [
      "Easy to access, it allows you to learn with high mountain guides or to train independently. Beginner to expert level (dry tooling). Open to everyone provided they are insured for the activity. Registration-reservation at the Carreley space."
    ],
    "it": [
      "Di facile accesso, potete imparare con le guide alpine o allenarvi da soli. I livelli vanno dal principiante all'esperto. Aperto a tutti, soggetto alle condizioni di accesso e alla carta d'uso."
    ],
    "fr": [
      "Facile d’accès, elle permet de s’initier avec les guides de haute montagne ou de s’entrainer en autonomie. Niveau débutant à expert. Ouverte à tous selon conditions d’accès et charte d’utilisation."
    ],
    "nl": [
      "Het is gemakkelijk toegankelijk en stelt u in staat om te leren met berggidsen of om zelfstandig te trainen. Beginner tot expert niveau (dry tooling). Open voor iedereen op voorwaarde dat ze verzekerd zijn voor de activiteit. Registratie-reservering bij de Carreley-ruimte."
    ],
    "es": [
      "De fácil acceso, puede aprender con los guías de montaña o entrenarse por su cuenta. Los niveles van de principiante a experto. Abierto a todos, sujeto a las condiciones de acceso y a la carta de usuario."
    ]
  },
  "rdfs:label": {
    "en": [
      "Barmette Rocks semi aritficial icefall"
    ],
    "fr": [
      "Cascade de glace semi artificielle"
    ],
    "nl": [
      "Half-kunstmatige ijswaterval van Le Rocher de la Barmette"
    ]
  },
