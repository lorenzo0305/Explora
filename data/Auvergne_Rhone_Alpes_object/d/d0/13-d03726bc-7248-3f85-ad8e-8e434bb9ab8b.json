  "rdfs:comment": {
    "de": [
      "Im Herzen des Bourbonnais tauchen Sie in unserem Spa in eine intime und warme Welt ein. In dem atypischen und authentischen Dekor der Krypten der Kapelle."
    ],
    "en": [
      "In the heart of the Bourbonnais, our Spa plunges you into an intimate and warm universe. In the atypical and authentic decoration of the crypts of the chapel."
    ],
    "it": [
      "Nel cuore della regione del Bourbonnais, la nostra Spa vi immerge in un universo intimo e caloroso. Nell'arredamento atipico e autentico delle cripte della cappella."
    ],
    "fr": [
      "Au coeur du Bourbonnais, notre Spa vous plonge dans un univers intimiste et chaleureux. Dans le décor atypique et authentique des cryptes de la chapelle."
    ],
    "nl": [
      "In het hart van de Bourbonnais dompelt onze Spa u onder in een intiem en warm universum. In het atypische en authentieke decor van de crypten van de kapel."
    ],
    "es": [
      "En el corazón de la región de Bourbonnais, nuestro Spa le sumerge en un universo íntimo y cálido. En la atípica y auténtica decoración de las criptas de la capilla."
    ]
  },
