  "rdfs:comment": {
    "de": [
      "Tabakwaren, Presse, Souvenirs, Geschenke, Eis, Lotto, Rubbelspiele, Behindertengerechter Zugang, WIFI-Zugang. Auf unserer Terrasse können Sie einen Kaffee, ein Getränk und Eis genießen. Bereich für Geschenke/Souvenirs.\r\nCASHBACK BIS ZU 60€ MÖGLICH"
    ],
    "en": [
      "Tobacconist, newsagent, souvenirs, gifts, ice cream, Lotto, scratch cards, disabled access, WIFI access. You can enjoy coffee, drinks and ice creams on our terrace. Gift/souvenir area.\r\nCASHBACK POSSIBLE UP TO 60€."
    ],
    "it": [
      "Tabacchi, giornali, souvenir, regali, gelati, Lotto, gratta e vinci, accesso per disabili, accesso WIFI. È possibile gustare caffè, bevande e gelati sulla nostra terrazza. Area regali/souvenir.\r\nCASHBACK POSSIBILE FINO A 60?"
    ],
    "fr": [
      "Tabac, presse, souvenirs, cadeaux, glaces, Loto, jeux de grattage, Accès handicapé, accès WIFI. Vous pouvez déguster un café, une boisson et des glaces sur notre terrasse. Espace cadeaux/souvenirs. \r\nCASHBACK POSSIBLE JUSQU'A 60€"
    ],
    "nl": [
      "Tabak, kranten, souvenirs, cadeaus, ijsjes, Lotto, krasloten, toegang voor gehandicapten, WIFI. U kunt genieten van koffie, drankjes en ijsjes op ons terras. Ruimte voor geschenken en souvenirs.\r\nCASHBACK MOGELIJK TOT €60"
    ],
    "es": [
      "Tabaco, prensa, souvenirs, regalos, helados, lotería, tarjetas rasca y gana, acceso para discapacitados, acceso WIFI. Podrá disfrutar de café, bebidas y helados en nuestra terraza. Zona de regalos/souvenirs.\r\nCASHBACK POSIBLE HASTA 60?"
    ]
  },
