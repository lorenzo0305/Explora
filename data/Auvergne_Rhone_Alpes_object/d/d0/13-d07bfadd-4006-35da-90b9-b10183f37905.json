  "rdfs:comment": {
    "de": [
      "Die Lifte im Sommer (für Fußgänger,Mountainbiker oder Gleitschirmflieger)  in Peisey-Vallandry erlauben Ihnen auf die Gipfel \"zu klettern\" ohne sich zu ermüden."
    ],
    "en": [
      "In summer, whether you are a walker, a mountain biker or a paraglider, the ski lifts in Peisey-Vallandry will enable you to \"climb\" without getting tired and will open up spledid view points."
    ],
    "it": [
      "La seggiovia vi porta senza fatica da 1550 a 2129 metri."
    ],
    "fr": [
      "Le télésiège permet de grimper de 1550 à 2129 m d'altitude sans efforts."
    ],
    "es": [
      "El telesilla sube sin esfuerzo de 1550 a 2129 metros."
    ],
    "nl": [
      "De stoeltjeslift brengt je moeiteloos van 1550 naar 2129 meter."
    ]
  },
