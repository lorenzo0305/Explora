  "rdfs:comment": {
    "de": [
      "Bob Appelmans ist ein Bildhauer und Künstler. Er bietet auch individuelle Modellierkurse oder Kurse in kleinen Gruppen für alle Niveaus an.\r\nZögern Sie nicht, die Tür seines Galerieateliers im Dorf Meyras aufzustoßen."
    ],
    "en": [
      "Bob Appelmans is an artist and sculptor. He also offers individual or small-group modelling courses at all levels.\r\nDon't hesitate to drop in at his gallery in the village of Meyras."
    ],
    "it": [
      "Bob Appelmans è un artista e scultore. Offre anche corsi di modellazione individuali o per piccoli gruppi a tutti i livelli.\r\nNon esitate a visitare la sua galleria nel villaggio di Meyras."
    ],
    "fr": [
      "Bob Appelmans est un artiste sculpteur. Il propose aussi des cours de modelage individuels ou en petits groupes de tous niveaux.\r\nN'hésitez pas pousser la porte de son atelier galerie dans le village de Meyras."
    ],
    "nl": [
      "Bob Appelmans is kunstenaar en beeldhouwer. Hij biedt ook individuele boetseercursussen of boetseercursussen in kleine groepen op alle niveaus.\r\nAarzel niet om langs te komen in zijn galerie in het dorp Meyras."
    ],
    "es": [
      "Bob Appelmans es artista y escultor. También ofrece cursos de modelado individuales o en pequeños grupos de todos los niveles.\r\nNo dudes en pasarte por su galería en el pueblo de Meyras."
    ]
  },
