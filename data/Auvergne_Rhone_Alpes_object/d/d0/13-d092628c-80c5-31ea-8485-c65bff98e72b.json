  "rdfs:comment": {
    "de": [
      "Walnussproduzent seit 4 Generationen\r\nDirektverkauf auf dem Bauernhof: Trockennüsse, Nussöl, Nusskerne, karamellisierte und gesalzene Nüsse, Nussknacker, Geschenksets.\r\nVerkauf von Beerenfrüchten in der Saison: Erdbeeren, Himbeeren, Johannisbeeren und Heidelbeeren."
    ],
    "en": [
      "Walnut producer for 4 generations\r\nDirect farm sales: dried walnuts, walnut oil, walnut kernels, caramelized and salted walnuts, nutcrackers, gift boxes.\r\nSales of red berries in season: strawberries, raspberries, redcurrants and blueberries."
    ],
    "it": [
      "Produttore di noci da 4 generazioni\r\nVendita diretta dalla fattoria: noci secche, olio di noci, gherigli di noci, noci caramellate e salate, schiaccianoci, confezioni regalo.\r\nVendita di frutti rossi di stagione: fragole, lamponi, ribes e mirtilli."
    ],
    "fr": [
      "Producteur de noix depuis 4 générations \r\nVente directe a la ferme :  Noix sèches, huile de noix, cerneaux, noix caramélisées et salées, casse-noix, coffrets cadeaux.\r\nVentes de petits fruits rouges en saison : fraises, framboises, groseilles et myrtilles."
    ],
    "es": [
      "Productor de nueces desde hace 4 generaciones\r\nVenta directa desde la explotación: nueces secas, aceite de nuez, nueces en grano, nueces caramelizadas y saladas, cascanueces, cajas de regalo.\r\nVenta de frutos rojos de temporada: fresas, frambuesas, grosellas y arándanos."
    ],
    "nl": [
      "Notenproducent sinds 4 generaties\r\nDirecte verkoop vanaf de boerderij: gedroogde walnoten, walnootolie, walnootpitten, gekarameliseerde en gezouten walnoten, notenkrakers, geschenkdozen.\r\nVerkoop van rode bessen in het seizoen: aardbeien, frambozen, rode bessen en bosbessen."
    ]
  },
  "rdfs:label": {
