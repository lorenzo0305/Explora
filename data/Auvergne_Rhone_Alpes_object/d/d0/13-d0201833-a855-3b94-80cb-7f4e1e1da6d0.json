  "rdfs:comment": {
    "de": [
      "Unsere Montbéliardes, die mit dem auf unserem Familienbetrieb geernteten Futter gefüttert werden, produzieren eine reichhaltige Milch, die von uns zu Rohmilchkäse und Joghurt verarbeitet wird."
    ],
    "en": [
      "Our Montbéliardes, fed on forage harvested on our family farm, produce rich milk that we transform into raw-milk cheeses and yoghurts."
    ],
    "it": [
      "Le nostre Montbéliardes, alimentate con il foraggio della nostra fattoria di famiglia, producono un latte ricco che trasformiamo in formaggi e yogurt a latte crudo."
    ],
    "fr": [
      "Nos Montbéliardes nourries avec les fourrages récoltés sur notre exploitation familiale produisent un lait riche transformé par nos soins en fromages au lait cru et en yaourts."
    ],
    "nl": [
      "Onze Montbéliardes, gevoed met voeder van onze familieboerderij, produceren rijke melk die wij verwerken tot rauwmelkse kazen en yoghurts."
    ],
    "es": [
      "Nuestras Montbéliardes, alimentadas con forrajes de nuestra granja familiar, producen una rica leche que transformamos en quesos y yogures de leche cruda."
    ]
  },
  "rdfs:label": {
