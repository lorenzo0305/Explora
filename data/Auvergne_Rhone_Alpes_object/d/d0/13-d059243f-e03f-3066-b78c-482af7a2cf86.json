  "rdfs:comment": {
    "de": [
      "Wir servieren traditionelle Küche, aber nicht nur! Der Chefkoch hat aufgrund unserer Reisen und Lektüre Einflüsse aus der Weltküche. Alle unsere Gerichte sind hausgemacht und werden aus frischen, saisonalen und lokalen Produkten zubereitet."
    ],
    "en": [
      "We serve traditional cuisine but that's not all! World cuisine has inspired our chef during his travels or gleaned from books. Our dishes are homemade from fresh, seasonal, locally-sourced ingredients. Our bistro-restaurant reflects our personalities and our inspirations."
    ],
    "it": [
      "Serviamo cucina tradizionale, ma non solo! Lo chef ha influito sulla cucina mondiale grazie ai nostri viaggi e alle nostre letture. Tutti i nostri piatti sono fatti in casa con prodotti freschi, stagionali e locali."
    ],
    "fr": [
      "Nous servons une cuisine traditionnelle mais pas que ! Le chef a des influences de cuisine du monde de part nos voyages, lectures. Tous nos plats sont faits maison à partir de produits frais, de saison et locaux."
    ],
    "nl": [
      "Wij serveren traditionele gerechten, maar niet alleen! De chef heeft invloeden van de wereldkeuken van onze reizen en lezen. Al onze gerechten zijn huisgemaakt van verse, seizoensgebonden en lokale producten."
    ],
    "es": [
      "Servimos cocina tradicional, ¡pero no sólo! El chef tiene influencias de la cocina mundial a partir de nuestros viajes y lecturas. Todos nuestros platos son caseros, con productos frescos, de temporada y locales."
    ]
  },
