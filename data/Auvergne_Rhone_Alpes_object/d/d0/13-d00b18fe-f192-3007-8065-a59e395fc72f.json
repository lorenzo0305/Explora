  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie im Herzen des Grand Massif, inmitten einer grünen Oase. Entdecken Sie einen zeitlosen Ort mitten auf der Alm. Fünf gemütliche Zimmer und eine Restaurant-Bar empfangen Sie für einen Aufenthalt voller Energie."
    ],
    "en": [
      "We welcome you in the heart of the Grand Massif, in a green setting. Come and discover a timeless place in the middle of pasture. Five cozy rooms and a restaurant bar welcome you for a stay full of healing."
    ],
    "it": [
      "Vi diamo il benvenuto nel cuore del Grand Massif, in un ambiente verde. Venite a scoprire un luogo senza tempo in mezzo ai pascoli di montagna. Cinque camere accoglienti e un ristorante-bar vi accolgono per un soggiorno all'insegna del relax."
    ],
    "fr": [
      "Nous vous accueillons au cœur du Grand Massif, dans un écrin de verdure. Venez découvrir un lieu hors du temps en plein alpage. Cinq chambres douillettes et un restaurant bar vous accueillent pour un séjour plein de ressourcement."
    ],
    "nl": [
      "Wij heten u welkom in het hart van het Grand Massif, in een groene omgeving. Kom en ontdek een tijdloze plek in volle weiland. Vijf gezellige kamers en een restaurant bar verwelkomen u voor een verblijf vol genezing."
    ],
    "es": [
      "Le damos la bienvenida al corazón del Gran Macizo, en un entorno verde. Venga a descubrir un lugar intemporal en medio de los pastos de montaña. Cinco acogedoras habitaciones y un bar-restaurante le dan la bienvenida para una estancia llena de relax."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lake Gers Refuge"
    ],
    "fr": [
      "Refuge du Lac de Gers"
    ],
    "nl": [
      "Toevluchtsoord Gers meer"
    ]
  },
