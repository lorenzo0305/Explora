  "rdfs:comment": {
    "de": [
      "Bistro für Feinschmecker. Spezialitäten aus Savoyen. Burger. Salate. Traditionelle Küche. Produkte aus der Region. Gericht zum Mitnehmen. Leistung als Feinkosthändler.\r\nEmpfang von Gruppen. Relais für Motorradfahrer.\r\nGroße Terrasse im Sommer."
    ],
    "en": [
      "Foodie bistro. Savoyard specialities. Burgers. Salads. Traditional cuisine. Local products. Takeaway. Catering service.\r\nAfternoon food service.\r\nGroups welcome. Motorbike race.\r\nLarge terrace in summer."
    ],
    "it": [
      "Bistrot gourmet. Specialità savoiarde. Hamburger. Insalate. Cucina tradizionale. Prodotti locali. Pasti da asporto. Servizio di catering.\r\nAccoglienza gruppi. Sosta per le moto.\r\nAmpia terrazza in estate."
    ],
    "fr": [
      "Bistrot gourmand. Spécialités savoyardes. Burgers. Salades. Cuisine traditionnelle. Produits du terroir. Plat à emporter. Prestation traiteur.\r\nAccueil groupes. Relais motard.\r\nGrande terrasse l'été."
    ],
    "nl": [
      "Bistro voor fijnproevers. Savoyaardse specialiteiten. Burgers. Salades. Traditionele keuken. Lokale producten. Afhaalmaaltijden. Catering.\r\nGroepen welkom. Tussenstop voor motoren.\r\nGroot terras in de zomer."
    ],
    "es": [
      "Bistró gastronómico. Especialidades de Saboya. Hamburguesas. Ensaladas. Cocina tradicional. Productos locales. Comida para llevar. Servicio de catering.\r\nAdmite grupos. Parada de motos.\r\nAmplia terraza en verano."
    ]
  },
