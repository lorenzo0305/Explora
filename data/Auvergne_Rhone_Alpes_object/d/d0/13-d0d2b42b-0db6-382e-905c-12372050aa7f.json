  "rdfs:comment": {
    "de": [
      "Die Seifenfabrik \"Doux Voyage\" empfängt Sie das ganze Jahr über für den Verkauf von handgefertigten Seifen.\r\nWir bieten außerdem Herstellungsworkshops, einen Raum für Designer/Kunsthandwerker ."
    ],
    "en": [
      "The \"Doux Voyage\" soap shop is pleased to welcome you all year round with its handmade soaps work.\r\nWe are waiting for you for handmade soap craft activities, in a special handcraft room."
    ],
    "it": [
      "Il saponificio Doux Voyage vi accoglie tutto l'anno per vendere i suoi saponi fatti a mano.\r\nOffriamo anche laboratori e uno spazio per designer e artigiani locali."
    ],
    "fr": [
      "La Savonnerie “Doux Voyage” vous accueille tout au long de l’année pour la vente de savons artisanaux.\r\nNous proposons également des ateliers de fabrication,  et un espace créateurs/artisans locaux."
    ],
    "es": [
      "La fábrica de jabones Doux Voyage le da la bienvenida todo el año para vender sus jabones artesanales.\r\nTambién ofrecemos talleres y un espacio para diseñadores y artesanos locales."
    ],
    "nl": [
      "De zeepfabriek Doux Voyage verwelkomt je het hele jaar door om haar handgemaakte zepen te verkopen.\r\nWe bieden ook workshops en een ruimte voor lokale ontwerpers en ambachtslieden."
    ]
  },
  "rdfs:label": {
    "de": [
      "Savonnerie Doux Voyage, Boutique mit lokalen Designern und Handwerkern"
    ],
    "en": [
      "Doux Voyage soap shop, creators and local handcrafted shop"
    ],
    "fr": [
      "Savonnerie Doux Voyage, Boutique de créateurs et artisans locaux"
    ]
  },
