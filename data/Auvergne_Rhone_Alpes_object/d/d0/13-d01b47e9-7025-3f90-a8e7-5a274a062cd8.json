  "rdfs:comment": {
    "de": [
      "Das Restaurant Hôtel du Vercors ist das Zusammentreffen eines symbolträchtigen Ortes zwischen der Gemeinde St Martin en Vercors und einer Familie, die leidenschaftlich und definitiv in die Region verliebt ist."
    ],
    "en": [
      "The Restaurant Hôtel du Vercors is the meeting of an emblematic place between the commune of St Martin en Vercors and a family with a passion for the area."
    ],
    "it": [
      "Il Ristorante Hôtel du Vercors nasce dall'incontro tra un luogo emblematico del comune di St Martin en Vercors e una famiglia appassionata del territorio."
    ],
    "fr": [
      "Le Restaurant Hôtel du Vercors, c’est la rencontre d’un lieu emblématique entre la commune de St Martin en Vercors et une famille passionnée et définitivement amoureuse du territoire."
    ],
    "nl": [
      "Restaurant Hôtel du Vercors is het resultaat van een ontmoeting tussen een emblematische locatie in de gemeente St Martin en Vercors en een familie met een passie voor het gebied."
    ],
    "es": [
      "El Restaurante Hôtel du Vercors es el resultado del encuentro entre un lugar emblemático de la comuna de St Martin en Vercors y una familia apasionada por la zona."
    ]
  },
