  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/de01048a-7d5f-38c8-b691-7976cc4339c7",
      "dc:description": {
        "de": [
          "Die Brasserie Bois de la Chapelle in Torcy im Departement Pas de Calais bietet Ihnen eine Reihe von authentischen Bauernbieren, die mit dem Getreide des landwirtschaftlichen Betriebs gebraut und vor Ort abgefüllt werden!"
        ],
        "en": [
          "Brasserie Bois de la Chapelle in Torcy, Pas de Calais, offers a range of authentic farmhouse beers, brewed with the farm's own grain and bottled on site!"
        ],
        "it": [
          "La Brasserie Bois de la Chapelle di Torcy, nel Pas de Calais, offre una gamma di autentiche birre di fattoria, prodotte con i cereali della fattoria e imbottigliate in loco!"
        ],
        "fr": [
          "La Brasserie Bois de la Chapelle située à Torcy dans le Pas de Calais, vous propose une gamme de bières fermières, authentiques, brassées avec les céréales de l'exploitation agricole et embouteillées sur place !"
        ],
        "es": [
          "La Brasserie Bois de la Chapelle, en Torcy, Pas de Calais, ofrece una gama de auténticas cervezas de granja, elaboradas con cereales de la granja y embotelladas in situ"
        ],
        "nl": [
          "De Brasserie Bois de la Chapelle in Torcy, Pas de Calais, biedt een assortiment authentieke boerderijbieren, gebrouwen met granen van de boerderij en ter plekke gebotteld!"
        ]
      },
