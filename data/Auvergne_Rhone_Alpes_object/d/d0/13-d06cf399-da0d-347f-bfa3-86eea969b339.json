  "rdfs:comment": {
    "de": [
      "Ein atypischer Abend im Nomadenmodus!\r\nDas Essen wird von Ihnen bereitgestellt. Wir kümmern uns darum, die Jurte für Ihren Komfort zu heizen.\r\n15 Minuten zu Fuß oder mit Schneeschuhen, um diese Jurten zu erreichen, die sich mitten in den Wald schmiegen."
    ],
    "en": [
      "An atypical evening in a nomadic way!\r\nYou provide your own meal. We take care of heating the yurt for your comfort.\r\n15 minutes walk, on foot or with snowshoes, to reach these yurts nestled in the heart of the forest."
    ],
    "it": [
      "Una serata atipica in modalità nomade!\r\nIl pasto è a carico dell'utente. Ci occupiamo noi di riscaldare la yurta per il vostro comfort.\r\n15 minuti di cammino, a piedi o con le ciaspole, per raggiungere queste yurte immerse nel cuore della foresta."
    ],
    "fr": [
      "Une soirée atypique en mode nomade !\r\nLe repas est fourni par vos soins. Nous nous occupons de chauffer la yourte pour votre confort.\r\n15 minutes de marche, à pied ou en raquettes, pour atteindre ces yourtes nichées en plein coeur de la forêt."
    ],
    "es": [
      "¡Una noche atípica en modo nómada!\r\nLa comida la pones tú. Nos encargamos de calentar la yurta para su comodidad.\r\n15 minutos a pie o con raquetas de nieve para llegar a estas yurtas enclavadas en el corazón del bosque."
    ],
    "nl": [
      "Een ongewone avond in nomadenstijl!\nDe maaltijd wordt door jou verzorgd. Wij zorgen voor de verwarming van de yurt voor jouw comfort.\nHet is 15 minuten lopen, te voet of op sneeuwschoenen, naar deze yurts in het hart van het bos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Yurts for rent"
    ],
    "fr": [
      "Location de Yourtes"
    ],
    "nl": [
      "Yurts te huur"
    ]
  },
