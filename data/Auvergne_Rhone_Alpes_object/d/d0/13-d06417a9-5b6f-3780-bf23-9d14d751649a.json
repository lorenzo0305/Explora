  "rdfs:comment": {
    "de": [
      "Orientierungstisch im Herzen des Dorfes auf dem Platz vor der alten Kirche, der insbesondere der hochgelegenen Synklinale von Saoû gegenüberliegt. Die Landschaft, die sich über 180° erstreckt, ist wunderschön. Sie erstreckt sich von den Klippen des Vercors bis zum Wald von Marsanne."
    ],
    "en": [
      "Orientation table in the heart of the village on the square in front of the old church, facing the perched syncline of Saoû. The scenery, over 180°, is superb. It stretches from the cliffs of the Vercors to the Marsanne forest."
    ],
    "it": [
      "Tavolo di orientamento nel cuore del villaggio, sulla piazza della vecchia chiesa, di fronte alla sinclinale arroccata di Saoû. Il paesaggio, a 180°, è superbo. Si estende dalle falesie del Vercors alla foresta di Marsanne."
    ],
    "fr": [
      "Table d'orientation au cœur du village sur la placette devant l'ancienne église face notamment au synclinal perché de Saoû. Le paysage, sur plus de 180°, est superbe. Il s’étend des falaises du Vercors à la forêt de Marsanne."
    ],
    "nl": [
      "Oriëntatietafel in het hart van het dorp op het pleintje voor de oude kerk, met uitzicht op de hooggelegen synclinale van Saoû. Het 180° panorama is prachtig. Het strekt zich uit van de kliffen van de Vercors tot het bos van Marsanne."
    ],
    "es": [
      "Mesa de orientación en el corazón del pueblo, en la plaza frente a la antigua iglesia, frente al sinclinal encaramado de Saoû. El paisaje, a más de 180°, es soberbio. Se extiende desde los acantilados del Vercors hasta el bosque de Marsanne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'Orientation"
    ]
  },
