  "rdfs:comment": {
    "de": [
      "Der Mini-Bauernhof von Navas: ein lebendiges Eintauchen in die Ardèche!\r\nTreffen Sie eine Stunde lang Miniaturziegen, Anglo-Nubische Ziegen, Kaninchen, Schweine, Geflügel und sogar Insekten! Nur mit Reservierung!"
    ],
    "en": [
      "La Mini ferme de Navas: a lively immersion in the heart of the Ardèche!\r\nFor 1 hour, come and meet miniature goats, Anglo-Nubian goats, rabbits, pigs, poultry and even insects! Reservations required!"
    ],
    "it": [
      "La mini-fattoria Navas: un'esperienza vivace nel cuore dell'Ardèche!\r\nPer 1 ora, venite a conoscere capre in miniatura, capre anglo-nubiane, conigli, maiali, pollame e persino insetti! Solo su prenotazione!"
    ],
    "fr": [
      "La Mini ferme de Navas : une immersion vivante au cœur de l'Ardèche ! \r\nPendant 1 h  venez rencontrez chèvres miniatures, chèvres Anglo-Nubienne, lapins, cochon, volailles et même des insectes ! Sur réservation uniquement !"
    ],
    "es": [
      "La minigranja de Navas: ¡una inmersión viviente en el corazón de Ardèche!\r\nDurante 1 hora, venga a conocer cabras en miniatura, cabras anglo-nubias, conejos, cerdos, aves de corral ¡e incluso insectos! Sólo con reserva previa"
    ],
    "nl": [
      "De Minifarm Navas: een levende onderdompeling in het hart van de Ardèche!\r\nKom gedurende 1 uur kennismaken met dwerggeiten, Anglo-Nubische geiten, konijnen, varkens, pluimvee en zelfs insecten! Alleen op reservering!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mini ferme de Navas"
    ]
  },
