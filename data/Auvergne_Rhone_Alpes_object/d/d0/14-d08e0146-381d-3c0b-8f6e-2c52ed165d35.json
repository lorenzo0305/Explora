  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1d988415-89a0-3313-8987-90b9e859d60d",
      "dc:description": {
        "de": [
          "Willkommen bei SevenRoses!\nBoutique für Prêt-à-porter-Frauenmode. Hier finden Sie eine große Auswahl an Kleidung, Schmuck und Accessoires.\n\nUnser Team ist immer auf der Suche nach Trends und erneuert die Kollektionen jede Woche, um Ihnen immer etwas Neues zu bieten!"
        ],
        "en": [
          "Welcome to SevenRoses\nSevenRoses is a women's ready-to-wear boutique offering a wide range of clothing, jewelry and accessories.\n\nAlways on the lookout for the latest trends, our team renews the collections every week to bring you what's new!"
        ],
        "it": [
          "Benvenuti a SevenRoses\nUna boutique di prêt-à-porter femminile che offre un'ampia gamma di abbigliamento, gioielli e accessori.\n\nSempre alla ricerca delle ultime tendenze, il nostro team rinnova le collezioni ogni settimana per portarvi qualcosa di nuovo!"
        ],
        "fr": [
          "Bienvenue chez SevenRoses \nBoutique de prêt-à-porter féminin, vous pouvez retrouver une large gamme de vêtements, bijoux et accessoires. \n\nÀ l'affut des tendances, notre équipe renouvelle les collections chaque semaine afin de toujours vous proposer des nouveautés !"
        ],
        "nl": [
          "Welkom bij SevenRoses\nEen kant-en-klare damesboetiek met een breed assortiment kleding, sieraden en accessoires.\n\nAltijd op zoek naar de laatste trends, vernieuwt ons team elke week de collecties om je iets nieuws te brengen!"
        ],
        "es": [
          "Bienvenido a SevenRoses\nUna boutique de prêt-à-porter femenino que ofrece una amplia gama de ropa, joyas y accesorios.\n\nSiempre al acecho de las últimas tendencias, nuestro equipo renueva las colecciones cada semana para ofrecerte algo nuevo"
        ]
      },
      "@type": [
        "Description"
      ],
