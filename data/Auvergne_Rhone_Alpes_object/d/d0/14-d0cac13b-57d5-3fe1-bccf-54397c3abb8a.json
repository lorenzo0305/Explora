  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b38d04fe-0874-3b73-a55a-027b74723d61",
      "dc:description": {
        "de": [
          "Gemüseanbau und Aufzucht von Bioschweinen im Freien. Die Ferme d'Aja befindet sich in Ambricourt im Herzen des Haut Pays d'Opale."
        ],
        "en": [
          "Market gardening and organic free-range pig farming. Ferme d'Aja is located in Ambricourt, in the heart of the Haut Pays d'Opale region."
        ],
        "it": [
          "Orticoltura e allevamento biologico di suini all'aperto. La Ferme d'Aja si trova ad Ambricourt, nel cuore della regione dell'Haut Pays d'Opale."
        ],
        "fr": [
          "Activité de maraîchage et d'élevage de porcs bio en plein air. La Ferme d'Aja se situe à Ambricourt au coeur du Haut Pays d'Opale."
        ],
        "nl": [
          "Tuinbouw en biologische scharrelvarkenshouderij. Ferme d'Aja ligt in Ambricourt in het hart van de regio Haut Pays d'Opale."
        ],
        "es": [
          "Horticultura y cría ecológica de cerdos camperos. La Ferme d'Aja está situada en Ambricourt, en el corazón del Haut Pays d'Opale."
        ]
      },
