  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Praz-sur-Arly wird von einer Vereinigung ehrenamtlicher Mitarbeiter verwaltet und bietet eine interessante Auswahl an literarischen Werken (Romane, Krimis, Comics, Kinderbücher...). Dank regelmäßiger Erneuerung finden Sie hier jeden Monat neue Bücher."
    ],
    "en": [
      "Managed by an association of volunteers, the Praz-sur-Arly library offers an interesting choice of literary works (novels, detective stories, comics, children's books...). New titles are added regularly, every month."
    ],
    "it": [
      "Gestita da un'associazione di volontari, la biblioteca di Praz-sur-Arly offre un'interessante scelta di opere letterarie (romanzi, gialli, fumetti, libri per bambini, ecc.). Ogni mese vengono aggiunti regolarmente nuovi libri."
    ],
    "fr": [
      "Gérée par une association de bénévoles, la bibliothèque de Praz-sur-Arly offre un choix intéressant d'oeuvres littéraires (romans, policiers, BD, livres pour enfants...). Un renouvellement régulier permet d'y trouver des nouveautés chaque mois."
    ],
    "es": [
      "Gestionada por una asociación de voluntarios, la biblioteca de Praz-sur-Arly ofrece una interesante selección de obras literarias (novelas, novelas policíacas, cómics, libros infantiles, etc.). Cada mes se añaden nuevos libros."
    ],
    "nl": [
      "De bibliotheek van Praz-sur-Arly wordt beheerd door een vereniging van vrijwilligers en biedt een interessante keuze aan literaire werken (romans, detectiveverhalen, strips, kinderboeken, etc.). Elke maand komen er nieuwe boeken bij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque Praline"
    ]
  },
