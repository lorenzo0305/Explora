  "rdfs:comment": {
    "de": [
      "2 Filme: Wie der tödliche Smog in London die Vorschriften zur Luftreinhaltung hervorbrachte. Wie wir heute unsere Mobilität überdenken, um besser atmen zu können."
    ],
    "en": [
      "2 films: one about the killer smog in London and how it gavie birth to clean air policies.\r\nToday, let's rethink how we travel to breathe better."
    ],
    "it": [
      "2 film: come lo smog assassino di Londra ha dato origine alle normative sull'aria pulita. Oggi ripensiamo la nostra mobilità per respirare meglio."
    ],
    "fr": [
      "2 films: comment le smog tueur de Londres donna naissance à la réglementation sur la propreté de l'air. Aujourd'hui, repensons notre mobilité pour mieux respirer."
    ],
    "es": [
      "2 películas: cómo la niebla tóxica de Londres dio origen a la normativa sobre aire limpio. Repensemos hoy nuestra movilidad para respirar mejor."
    ],
    "nl": [
      "2 films: hoe de dodelijke smog in Londen aanleiding gaf tot regelgeving voor schone lucht. Laten we vandaag onze mobiliteit heroverwegen om makkelijker te ademen."
    ]
  },
  "rdfs:label": {
