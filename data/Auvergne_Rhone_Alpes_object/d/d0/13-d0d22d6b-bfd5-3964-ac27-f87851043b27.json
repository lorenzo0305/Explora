  "rdfs:comment": {
    "de": [
      "Das Vergnügen, allein, zu zweit oder zu mehreren zu tanzen. Es ist auch die Gelegenheit, Bekanntschaften zu machen, sich auszutauschen, zu lachen und Lust zu bekommen... wiederzukommen."
    ],
    "en": [
      "The pleasure of dancing alone, in pairs or in groups. It's also an opportunity to meet new people, to share, to laugh and to want to come back... again."
    ],
    "it": [
      "Il piacere di ballare da soli, in coppia o in gruppo. È anche un'occasione per conoscere nuove persone, condividere, ridere e desiderare di tornare... ancora."
    ],
    "fr": [
      "Le plaisir de danser seul, à deux ou à plusieurs. C'est l'occasion aussi de faire des rencontres, de partager, de rire et d'avoir envie.. de revenir."
    ],
    "nl": [
      "Het plezier om alleen, met z'n tweeën of in een groep te dansen. Het is ook een kans om nieuwe mensen te ontmoeten, te delen, te lachen en terug te komen... opnieuw."
    ],
    "es": [
      "El placer de bailar solo, en pareja o en grupo. También es una oportunidad para conocer gente nueva, compartir, reír y querer volver... otra vez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Thé dansant"
    ]
  },
