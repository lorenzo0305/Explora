  "rdfs:comment": {
    "de": [
      "Bio-Bauernhof in Vaulnaveys-lel-Haut mit Milchschafen, Beeren und Eiern. Verkauf von Käse, Joghurt, Marmelade, Lammfleisch..."
    ],
    "en": [
      "GAEC la Bermotine is an organic dairy sheep farm in Vaulnaveys-le-Haut. You'll find berries, eggs and the sale of cheeses, yoghurts, ice creams, jams, sorbets, lamb and pork meat, depending on the season."
    ],
    "it": [
      "GAEC la Bermotine è un allevamento biologico di pecore da latte a Vaulnaveys-le-Haut. Troverete bacche, uova e la vendita di formaggi, yogurt, gelati, marmellate, sorbetti, agnello, maiale e manzo a seconda della stagione."
    ],
    "fr": [
      "Le GAEC la Bermotine est une ferme bio en brebis laitières située à Vaulnaveys-le-Haut. Vous y trouverez des petits fruits, des œufs et la vente de fromages, yaourts, glaces, confitures, sorbets, viande d'agneau, de porc, et de bœuf selon la saison."
    ],
    "es": [
      "Granja ecológica situada en Vaulnaveys-lel-Haut con ovejas lecheras, bayas y huevos, venta de quesos, yogures, mermeladas, carne de cordero..."
    ],
    "nl": [
      "GAEC la Bermotine is een biologisch melkschapenbedrijf in Vaulnaveys-le-Haut. Je vindt er bessen, eieren en de verkoop van kazen, yoghurt, ijs, jam, sorbets, lams- en varkensvlees, afhankelijk van het seizoen."
    ]
  },
  "rdfs:label": {
