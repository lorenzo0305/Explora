  "rdfs:comment": {
    "de": [
      "20 Minuten von Clermont-Fd entfernt liegt der Fahrradverleih im Herzen der Puy-Kette.\r\nEntdecken Sie die Freuden des Mountainbike- und Rennradfahrens oder essen Sie einfach auf unserer Terrasse am Ufer des größten Natursees der Auvergne."
    ],
    "en": [
      "Located 20 min from Clermont-Fd, bike rental in the heart of the Chaîne des Puys.\r\nCome and discover the joys of mountain biking and road biking, or simply enjoy a meal on our terrace on the shores of the largest natural lake in Auvergne."
    ],
    "it": [
      "A 20 minuti da Clermont-Fd, noleggio biciclette nel cuore della Chaîne des Puys.\r\nVenite a scoprire le gioie della mountain bike e del ciclismo su strada, o semplicemente a gustare un pasto sulla nostra terrazza accanto al più grande lago naturale dell'Alvernia."
    ],
    "fr": [
      "Situé à 20 min de Clermont-Fd,  location de vélo située au cœur de la chaîne des puys.\r\nVenez découvrir les joies du VTT et du vélo de route ou simplement vous restaurer sur notre terrasse située au bord du plus grand lac naturel d'Auvergne."
    ],
    "es": [
      "Situado a 20 minutos de Clermont-Fd, alquiler de bicicletas en el corazón de la Chaîne des Puys.\r\nVenga a descubrir las alegrías de la bicicleta de montaña y ciclismo de carretera, o simplemente disfrutar de una comida en nuestra terraza junto al lago natural más grande de Auvernia."
    ],
    "nl": [
      "Op 20 minuten van Clermont-Fd, fietsverhuur in het hart van de Chaîne des Puys.\r\nKom en ontdek de geneugten van mountainbiken en fietsen op de weg, of gewoon genieten van een maaltijd op ons terras naast het grootste natuurlijke meer van de Auvergne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La roue verte"
    ]
  },
