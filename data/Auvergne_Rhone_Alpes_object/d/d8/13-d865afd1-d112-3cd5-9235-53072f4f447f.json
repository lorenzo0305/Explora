  "rdfs:comment": {
    "de": [
      "Im Rahmen seines Künstleraufenthalts in Brioude stellt der Fotograf und Autor Yixi Tian seine Werke aus. Diese Initiative wird vom Festival der Fotografie und der Stadt Brioude getragen"
    ],
    "en": [
      "As part of his artist residency in Brioude, photographer-author Yixi Tian exhibits his work, an initiative supported by the Festival of Photography and the City of Brioude"
    ],
    "it": [
      "Nell'ambito della sua residenza d'artista a Brioude, il fotografo e autore Yixi Tian espone le sue opere, un'iniziativa sostenuta dal Festival della Fotografia e dalla città di Brioude"
    ],
    "fr": [
      "Dans le cadre de sa résidence d'artiste à Brioude, le photographe-auteur Yixi Tian expose ses œuvres, une initiative portée par le Festival de la photographie et la Ville de Brioude"
    ],
    "es": [
      "En el marco de su residencia artística en Brioude, el fotógrafo y escritor Yixi Tian expone su obra, una iniciativa apoyada por el Festival de Fotografía y la ciudad de Brioude"
    ],
    "nl": [
      "Als onderdeel van zijn residentie in Brioude, exposeert fotograaf en auteur Yixi Tian zijn werk, een initiatief dat wordt ondersteund door het Festival van de Fotografie en de stad Brioude"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Yixi Tian \"Dire aux montagnes que nous ne partons jamais\" Exposition"
    ]
  },
