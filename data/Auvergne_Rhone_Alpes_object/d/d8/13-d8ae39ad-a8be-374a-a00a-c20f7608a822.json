  "rdfs:comment": {
    "de": [
      "Willkommen im RockyPop Flaine!\r\nIm Herzen von Flaine befindet sich das RockyPop Flaine in einem komplett renovierten, denkmalgeschützten Gebäude. Die DNA von RockyPop ist Unterhaltung und die Erfahrung des Zusammenlebens in einer ausgesprochen spielerischen Atmosphäre."
    ],
    "en": [
      "Welcome to RockyPop Flaine!\r\nRockyPop Flaine is located in the heart of Flaine, in a completely renovated listed building. RockyPop's DNA is entertainment and the experience of living together in a resolutely fun atmosphere."
    ],
    "it": [
      "Benvenuti al RockyPop Flaine!\r\nIl RockyPop Flaine si trova nel cuore di Flaine, in un edificio storico completamente ristrutturato. Il DNA del RockyPop è l'intrattenimento e l'esperienza di convivenza in un'atmosfera decisamente divertente."
    ],
    "fr": [
      "Bienvenue au RockyPop Flaine !\r\nC’est au cœur de Flaine que se trouve le RockyPop Flaine, dans un bâtiment classé totalement rénové. L’ADN RockyPop, c’est le divertissement et l’expérience du vivre ensemble dans une ambiance résolument ludique."
    ],
    "nl": [
      "Welkom bij RockyPop Flaine!\r\nRockyPop Flaine is gevestigd in het hartje van Flaine, in een volledig gerenoveerd monumentaal pand. Het RockyPop DNA draait om plezier maken en samen het leven beleven in een leuke sfeer."
    ],
    "es": [
      "Bienvenido a RockyPop Flaine\r\nRockyPop Flaine está situado en el corazón de Flaine, en un edificio protegido totalmente renovado. El ADN de RockyPop es el entretenimiento y la convivencia en un ambiente decididamente lúdico."
    ]
  },
  "rdfs:label": {
