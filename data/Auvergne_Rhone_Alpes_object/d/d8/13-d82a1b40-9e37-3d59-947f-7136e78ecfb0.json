  "rdfs:comment": {
    "de": [
      "Hier sind Einfachheit und Freundlichkeit angesagt, wir sind wie eine Familie in der Auberge de Montalivet.mit frischen Produkten unserer Produzenten, alle und hausgemacht!"
    ],
    "en": [
      "Here, simplicity and conviviality are the order of the day. We're a family at the Auberge de Montalivet, with fresh produce from our producers, all home-made!"
    ],
    "it": [
      "Qui semplicità e convivialità sono all'ordine del giorno, siamo in famiglia alla locanda Montalivet. Con prodotti freschi dei nostri produttori, tutti fatti in casa!"
    ],
    "fr": [
      "Ici la simplicité et la convivialité sont de mises, nous sommes en famille à l’auberge de Montalivet.avec des produits fraisde nos producteurs, tous et fait maison !!"
    ],
    "nl": [
      "Hier zijn eenvoud en gezelligheid aan de orde van de dag, we zijn een familie in de Auberge de Montalivet, met verse producten van onze producenten, alles zelfgemaakt!"
    ],
    "es": [
      "Aquí la sencillez y la convivencia están a la orden del día, estamos en familia en la posada de Montalivet. Con productos frescos de nuestros productores, ¡todo casero!"
    ]
  },
