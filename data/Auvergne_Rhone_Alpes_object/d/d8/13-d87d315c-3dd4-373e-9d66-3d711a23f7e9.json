  "rdfs:comment": {
    "de": [
      "Wir organisieren mit Unterstützung der Gemeindeverwaltung von Rochegude am Mittwoch, den 1. April 2026, eine Eierjagd.\r\nDieses Jahr verschenken wir 10 zusätzliche Pralinen, also insgesamt 70!"
    ],
    "en": [
      "With the support of Rochegude town council, we're organizing an egg hunt on Wednesday, April 1, 2026.\r\nThis year we're giving away an extra 10 chocolates, for a total of 70!"
    ],
    "it": [
      "Con il sostegno del Comune di Rochegude, organizziamo una caccia alle uova mercoledì 1° aprile 2026.\r\nQuest'anno regaleremo 10 cioccolatini in più, per un totale di 70!"
    ],
    "fr": [
      "Nous organisons, avec le soutien de la mairie de Rochegude, une chasse aux œufs le mercredi 1er avril 2026.\r\nCette année nous offrons 10 chocolats supplémentaires, soit 70 au total !"
    ],
    "nl": [
      "Met de steun van het stadhuis van Rochegude organiseren we een eierspeurtocht op woensdag 1 april 2026.\r\nDit jaar geven we 10 extra chocolaatjes weg, dus in totaal 70!"
    ],
    "es": [
      "Con el apoyo del Ayuntamiento de Rochegude, organizamos una búsqueda del huevo el miércoles 1 de abril de 2026.\r\nEste año regalaremos 10 bombones más, ¡un total de 70!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse aux oeufs"
    ]
  },
