  "rdfs:comment": {
    "de": [
      "Das Museum erzählt Ihnen die Geschichte unseres schönen Ortes und derer, die ihn zu dem gemacht haben, was er ist. Interaktiv und spielerisch, gehen Sie nicht daran vorbei, das Museum ist einen Umweg wert!"
    ],
    "en": [
      "The museum tells you the story of our beautiful resort and of those who made it that way. Interactive and fun, don't miss it, the museum is worth the detour!"
    ],
    "it": [
      "Il Museo racconta la storia della nostra splendida località e delle persone che l'hanno resa tale. Interattivo e divertente, non perdetelo: il museo merita una visita!"
    ],
    "fr": [
      "Le Musée vous raconte l’histoire de notre belle station et de ceux et celles qui l’ont faite ainsi. Interactif et ludique, ne passez pas à côté, le musée vaut le détour !"
    ],
    "nl": [
      "Het museum vertelt u de geschiedenis van ons mooie vakantieoord en van degenen die het zo gemaakt hebben. Interactief en leuk, mis het niet, het museum is een bezoek waard!"
    ],
    "es": [
      "El museo te cuenta la historia de nuestro hermoso complejo turístico y de aquellos que lo hicieron posible. Interactivo y divertido, no se lo pierda, ¡el museo merece una visita!"
    ]
  },
