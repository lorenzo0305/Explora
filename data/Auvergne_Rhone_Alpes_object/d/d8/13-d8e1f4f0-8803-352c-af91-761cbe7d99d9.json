  "rdfs:comment": {
    "de": [
      "2 nicht überdachte Tennisplätze aus Porenbeton, die 2019 neu gemacht werden.\r\nUm den Schlüssel abzuholen, müssen Sie sich per E-Mail an den Tennisverein wenden."
    ],
    "en": [
      "2 uncovered poreaux concrete tennis courts to be refurbished in 2019.\r\nTo collect the key, please contact the tennis association by e-mail."
    ],
    "it": [
      "2 campi da tennis scoperti, in porali di cemento, da ristrutturare nel 2019.\r\nPer ottenere la chiave è necessario contattare l'associazione di tennis per posta."
    ],
    "fr": [
      "2 courts de tennis non couverts, en béton poreaux refaits à neuf en 2019.\r\nPour récupérer la clé il faut contacter par mail l'association de tennis."
    ],
    "es": [
      "2 pistas de tenis descubiertas de hormigón poroso que se renovarán en 2019.\r\nPara obtener la llave, póngase en contacto con la asociación de tenis por correo electrónico."
    ],
    "nl": [
      "2 onoverdekte tennisbanen, in betonnen portalen, op te knappen in 2019.\r\nOm de sleutel te krijgen moet je per mail contact opnemen met de tennisbond."
    ]
  },
