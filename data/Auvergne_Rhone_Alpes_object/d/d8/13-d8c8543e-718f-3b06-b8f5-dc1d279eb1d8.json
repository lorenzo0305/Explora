  "rdfs:comment": {
    "de": [
      "Ich bin seit 2010 Keramikerin und fertige Einzelstücke aus Steingut oder Porzellan mit einem figurativen und poetischen Dekor, das mit der Nadel eingraviert wird."
    ],
    "en": [
      "Ceramist since 2010, I create unique pieces in stoneware or porcelain with a figurative and poetic needle engraved decoration."
    ],
    "it": [
      "Ceramista dal 2010, creo pezzi unici in gres o porcellana con una decorazione figurativa e poetica incisa ad ago."
    ],
    "fr": [
      "Céramiste depuis 2010, je réalise des pièces uniques en grès ou en porcelaine avec un décor figuratif et poétique gravé à l’aiguille."
    ],
    "nl": [
      "Keramist sinds 2010, ik creëer unieke stukken in steengoed of porselein met een figuratieve en poëtische decoratie gegraveerd met een naald."
    ],
