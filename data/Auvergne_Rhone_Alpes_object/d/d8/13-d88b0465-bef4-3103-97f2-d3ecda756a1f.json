  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses atypische Restaurant in einer grünen Oase am Rande des Grünzugs, 200 m vom See von Doussard und den Campingplätzen entfernt. Genießen Sie auf einer schattigen Terrasse ein Gericht, das auf dem Braséro zubereitet wird, oder ein gutes kleines hausgemachtes Gericht aus frischen und lokalen Produkten."
    ],
    "en": [
      "Discover this atypical restaurant in a green setting on the edge of the greenway, 200m from Lac de Doussard and the campsites. Enjoy a dish cooked on the brazier or a home-cooked meal made with fresh local produce on a shady terrace."
    ],
    "it": [
      "Scoprite questo ristorante atipico in un ambiente verde ai margini della greenway, a 200 m dal Lac de Doussard e dai campeggi. Godetevi un piatto cucinato sul braciere o un gustoso pasto fatto in casa con prodotti freschi locali sulla terrazza ombreggiata."
    ],
    "fr": [
      "Découvrez ce restaurant atypique dans un écrin de verdure au bord de la voie vert, à 200m du Lac de Doussard et des campings. Déguster sur une terrasse ombragée un plat cuisiné sur le braséro ou un bon petit plat maison à base de produits frais et locaux."
    ],
    "nl": [
      "Ontdek dit atypische restaurant in een groene omgeving aan de rand van de greenway, op 200m van het Lac de Doussard en de campings. Geniet op het schaduwrijke terras van een gerecht op het vuur of van een lekkere huisgemaakte maaltijd met verse streekproducten."
    ],
    "es": [
      "Descubra este restaurante atípico en un entorno verde al borde de la vía verde, a 200 m del Lac de Doussard y de los campings. Disfrute de un plato cocinado en el brasero o de una sabrosa comida casera elaborada con productos locales frescos en la terraza a la sombra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Base  Lathuile"
    ]
  },
