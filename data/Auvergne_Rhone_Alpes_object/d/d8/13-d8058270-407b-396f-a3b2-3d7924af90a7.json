  "rdfs:comment": {
    "de": [
      "Solidarisches Restaurant und Kulturcafé: Hausgemachte Mahlzeiten, die mit gesammelten Produkten aus lokalen Partnerschaften zubereitet werden. Kommen Sie zu uns für eine köstliche Mahlzeit in einer herzlichen und solidarischen Atmosphäre!"
    ],
    "en": [
      "Restaurant Solidaire and Café Culturel: homemade meals prepared with recycled products from local partnerships. Join us for a delicious meal in a warm, supportive atmosphere!"
    ],
    "it": [
      "Restaurant Solidaire e Café Culturel: pasti preparati in casa con prodotti riciclati provenienti da collaborazioni locali. Unitevi a noi per un pasto delizioso in un'atmosfera calda e solidale!"
    ],
    "fr": [
      "Restaurant Solidaire et Café Culturel : repas faits maison, préparés avec des produits récupérés et issus de partenariats locaux. Rejoignez-nous pour un délicieux repas dans une ambiance chaleureuse et solidaire !"
    ],
    "es": [
      "Restaurant Solidaire y Café Culturel: comidas caseras preparadas con productos reciclados procedentes de asociaciones locales. ¡Únase a nosotros para disfrutar de una deliciosa comida en un ambiente cálido y solidario!"
    ],
    "nl": [
      "Restaurant Solidaire en Café Culturel: huisgemaakte maaltijden bereid met gerecyclede producten van lokale partnerschappen. Schuif aan voor een heerlijke maaltijd in een warme en ondersteunende sfeer!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'élabo de Paulette"
    ]
  },
