  "rdfs:comment": {
    "de": [
      "Die Marinet Familie bietet viele komfortabel Zimmer in Michaille und zu Füssen des Plateau de Retord seit 1889 an."
    ],
    "en": [
      "The Marinet family offers many comfortable rooms in the heart of the Michaille and at the foot of the Plateau de Retord since 1889."
    ],
    "it": [
      "Dal 1889, la famiglia Marinet offre camere confortevoli nel cuore della Michaille e ai piedi dell'altopiano di Retord.  Godrete di un ambiente relativamente tranquillo, lontano dal trambusto della città, per un soggiorno piacevole."
    ],
    "fr": [
      "Depuis 1889, la famille Marinet vous propose des chambres tout confort au cœur de la Michaille et au pied du Plateau de Retord.  Vous profiterez d'un environnement relativement calme, loin des nuisances de la ville, pour passer un agréable moment."
    ],
    "nl": [
      "Sinds 1889 biedt de familie Marinet comfortabele kamers aan in het hart van de Michaille en aan de voet van het Plateau de Retord.  Je geniet er van een relatief rustige omgeving, ver van de drukte van de stad, voor een aangenaam verblijf."
    ],
    "es": [
      "Desde 1889, la familia Marinet ofrece cómodas habitaciones en el corazón de la Michaille y a los pies de la meseta de Retord.  Disfrutará de un entorno relativamente tranquilo, lejos del bullicio de la ciudad, para una estancia agradable."
    ]
  },
  "rdfs:label": {
