  "rdfs:comment": {
    "de": [
      "Als ihre Eltern sie dringend zu sich rufen, befürchten Pierre, Jules und Louise das Schlimmste, bevor eine unerwartete Ankündigung die Familienharmonie sprengt.\r\nChers Parents ist eine schrille Komödie über Liebe, Geld und Familienbande."
    ],
    "en": [
      "When their parents urgently summon them, Pierre, Jules and Louise fear the worst? before an unexpected announcement shatters family harmony.\r\nDear Parents is a wry comedy about love, money and family ties."
    ],
    "it": [
      "Quando i genitori li convocano d'urgenza, Pierre, Jules e Louise temono il peggio, prima che un annuncio inaspettato sconvolga l'armonia familiare.\r\nCari genitori è una commedia ironica sull'amore, il denaro e i legami familiari."
    ],
    "fr": [
      "Quand leurs parents les convoquent d’urgence, Pierre, Jules et Louise craignent le pire… avant qu’une annonce inattendue ne fasse exploser l’harmonie familiale.\r\nChers Parents est une comédie grinçante sur l’amour, l’argent et les liens familiaux."
    ],
    "nl": [
      "Wanneer hun ouders hen dringend oproepen, vrezen Pierre, Jules en Louise het ergste? voordat een onverwachte mededeling de harmonie binnen het gezin verbrijzelt.\r\nLieve ouders is een komedie over liefde, geld en familiebanden."
    ],
    "es": [
      "Cuando sus padres les convocan urgentemente, Pierre, Jules y Louise se temen lo peor... antes de que un anuncio inesperado rompa la armonía familiar.\r\nQueridos padres es una comedia irónica sobre el amor, el dinero y los lazos familiares."
    ]
  },
  "rdfs:label": {
    "fr": [
