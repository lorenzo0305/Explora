  "rdfs:comment": {
    "de": [
      "Holen Sie sich die Karte dieses Orientierungslaufs an der Rezeption des Fremdenverkehrsamts von Combloux und entdecken Sie die Wunder des Kulturerbes unseres schönen Dorfes, indem Sie diesen frei zugänglichen Parcours absolvieren."
    ],
    "en": [
      "Get the map of this orientation course from the reception of the Tourist Office of Combloux and discover some heritage wonders of our beautiful village, by making this free access course."
    ],
    "it": [
      "Ritirate la mappa di questo percorso di orientamento presso l'Ufficio del Turismo di Combloux e scoprite le meraviglie del patrimonio del nostro bel villaggio su questo percorso liberamente accessibile."
    ],
    "fr": [
      "Récupérez la carte de ce parcours d'orientation auprès de l'accueil de l'Office de Tourisme de Combloux et découvrez les merveilles patrimoniales de notre beau village, en réalisant ce parcours en libre accès."
    ],
    "es": [
      "Recoger el mapa de este recorrido de orientación en la recepción de la Oficina de Turismo de Combloux y descubrir algunas maravillas patrimoniales de nuestro hermoso pueblo, realizando este recorrido en libre acceso."
    ],
    "nl": [
      "Haal een kaart van dit oriëntatieparcours bij de Dienst voor Toerisme van Combloux en ontdek de wonderen van het erfgoed van ons mooie dorp op dit vrij toegankelijke parcours."
    ]
  },
  "rdfs:label": {
    "en": [
      "Orientation course for adults"
    ],
    "fr": [
      "Parcours d'orientation adultes"
    ],
    "es": [
      "Itinerario de orientación patrimonial para adultos"
    ]
  },
