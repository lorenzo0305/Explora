  "rdfs:comment": {
    "de": [
      "Fluoreszierende Minigolfanlage 18-Loch-Parcours . Eine magische Reise, die Sie mit der Familie oder mit Freunden entdecken können. Unglaubliche 3D-Dekorationen, Interaktivität, Soundeffekte. Die Urzeit und ihre riesigen Dinosaurier erwarten Sie."
    ],
    "en": [
      "18-hole fluorescent mini golf course. A magical journey to discover with family and friends. Incredible 3D decorations, interactivity, sound effects. Prehistory and its giant dinosaurs await you."
    ],
    "it": [
      "Campo da minigolf fluorescente a 18 buche. Un viaggio magico da scoprire con la famiglia e gli amici. Incredibili decorazioni 3D, interattività, effetti sonori. La preistoria e i suoi giganteschi dinosauri vi aspettano."
    ],
    "fr": [
      "Mini golf fluorescent parcours de 18 trous . Un voyage magique à découvrir en famille ou entre amis. Décorations 3D incroyables, interactivité, effets sonores. La préhistoire et ses dinosaures géants vous attendent."
    ],
    "es": [
      "Minigolf fluorescente de 18 hoyos. Un viaje mágico para descubrir con la familia y los amigos. Increíbles decoraciones en 3D, interactividad, efectos de sonido. La prehistoria y sus gigantescos dinosaurios te esperan."
    ],
    "nl": [
      "18-holes fluorescerende minigolfbaan. Een magische reis om samen met familie en vrienden te ontdekken. Ongelooflijke 3D-decoraties, interactiviteit en geluidseffecten. De prehistorie en zijn reusachtige dinosaurussen wachten op je."
    ]
  },
