  "rdfs:comment": {
    "de": [
      "Als ehemaliger Berater von France Services kommt Richaud info zu Ihnen nach Hause, um Ihnen zu helfen, Ihre Geräte in den Griff zu bekommen: PC, MAC, Smartphone, Tablet."
    ],
    "en": [
      "A former France Services consultant, Richaud info can come to your home to help you get to grips with your PC, MAC, smartphone or tablet."
    ],
    "it": [
      "Un ex consulente di France Services, Richaud info, può venire a casa vostra per aiutarvi a familiarizzare con il vostro PC, MAC, smartphone o tablet."
    ],
    "fr": [
      "Ancien conseiller France Services, Richaud info intervient à domicile pour vous aider à prendre en main vos appareils : PC, MAC, Smartphone, tablette."
    ],
    "nl": [
      "Richaud info, een voormalig adviseur van France Services, kan bij je thuis komen om je te helpen je pc, MAC, smartphone of tablet onder de knie te krijgen."
    ],
    "es": [
      "Antiguo asesor de France Services, Richaud info puede desplazarse a su domicilio para ayudarle a familiarizarse con su PC, MAC, smartphone o tableta."
    ]
  },
