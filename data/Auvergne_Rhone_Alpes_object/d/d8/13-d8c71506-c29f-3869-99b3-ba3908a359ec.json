  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein unvergessliches Abenteuer in unmittelbarer Nähe von Annecy!\r\nErkunden Sie unsere vielfältigen Aktivitäten, die für jedes Alter und jedes Niveau geeignet sind, und machen Sie einzigartige Erfahrungen inmitten der Natur, hoch über dem See von Annecy."
    ],
    "en": [
      "Discover an unforgettable adventure just a stone's throw from Annecy!\r\nCome and explore our wide range of activities for all ages and abilities, and enjoy unique experiences in the heart of nature, high above Lake Annecy."
    ],
    "it": [
      "Scoprite un'avventura indimenticabile a due passi da Annecy!\r\nVenite a scoprire la nostra vasta gamma di attività per tutte le età e le capacità e vivete esperienze uniche nel cuore della natura, sopra il lago di Annecy."
    ],
    "fr": [
      "Découvrez une aventure inoubliable à deux pas d’Annecy !\r\nVenez explorer nos multiples activités adaptées à tous les âges et à tous les niveaux, et vivez des expériences uniques en pleine nature, sur les hauteurs du lac d'Annecy."
    ],
    "nl": [
      "Ontdek een onvergetelijk avontuur op een steenworp afstand van Annecy!\r\nOntdek ons brede aanbod aan activiteiten voor alle leeftijden en niveaus, en geniet van unieke ervaringen midden in de natuur, hoog boven het meer van Annecy."
    ],
    "es": [
      "Descubra una aventura inolvidable a dos pasos de Annecy\r\nVenga a descubrir nuestra amplia gama de actividades para todas las edades y capacidades, y disfrute de experiencias únicas en plena naturaleza, en lo alto del lago de Annecy."
    ]
  },
