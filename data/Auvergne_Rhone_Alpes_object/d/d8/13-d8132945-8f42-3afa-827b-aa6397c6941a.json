  "rdfs:comment": {
    "de": [
      "Das Dorf liegt an der Quelle des grünen und authentischen Goul-Tals und bewahrt seinen Charakter von früher."
    ],
    "en": [
      "Situated at the source of the green and authentic Goul valley, this village has preserved all its old-fashioned character."
    ],
    "it": [
      "Situato alle sorgenti della verde e autentica valle del Goul, questo villaggio ha conservato tutto il suo carattere del passato."
    ],
    "fr": [
      "Situé à la source de la vallée du Goul verte et authentique, ce village conserve tout son caractère d'autrefois."
    ],
    "es": [
      "Situado en el nacimiento del verde y auténtico valle del Goul, este pueblo ha conservado todo el carácter de antaño."
    ],
    "nl": [
      "Dit dorp, gelegen aan de bron van de groene en authentieke Goul-vallei, heeft al zijn karakter uit het verleden behouden."
    ]
  },
