  "rdfs:comment": {
    "de": [
      "L'Alpin ist DAS Steakhaus in Les Menuires, aber nicht nur! L'Alpin ist auch eine authentische, hausgemachte Pizzeria und immer ein paar köstliche Spezialitäten aus Savoyen."
    ],
    "en": [
      "L'Alpin is THE Steak House of Les Menuires, but not only! L'Alpin is not just a steak house, it's also an authentic homemade pizzeria, as well as a number of delicious Savoyard specialities."
    ],
    "it": [
      "L'Alpin è LA bisteccheria di Les Menuires, ma non solo! l'Alpin non è solo una bisteccheria a Les Menuires, ma anche un'autentica pizzeria casalinga e propone sempre deliziose specialità savoiarde."
    ],
    "fr": [
      "L'alpin est LE Steak House des Menuires, mais pas que ! : Au delà des viandes de race ou d'exception et de notre Rôtisserie géante, l'Alpin est aussi une authentique Pizzeria faites maison, et aussi toujours quelques délicieuses spécialités savoyardes."
    ],
    "nl": [
      "L'alpin is hét steakhouse in Les Menuires, maar niet alleen! L'Alpin is niet alleen een steakhouse in Les Menuires, het is ook een authentieke huisgemaakte pizzeria en heeft altijd heerlijke Savoyaardse specialiteiten."
    ],
    "es": [
      "L'alpin es EL asador de Les Menuires, ¡pero no sólo eso! l'Alpin no es sólo un asador en Les Menuires, también es una auténtica pizzería casera, y siempre tiene deliciosas especialidades de Saboya."
    ]
  },
