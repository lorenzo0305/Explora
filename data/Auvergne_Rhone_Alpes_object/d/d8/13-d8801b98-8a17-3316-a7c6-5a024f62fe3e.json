  "rdfs:comment": {
    "de": [
      "Erlernen Sie das Schießen mit dem Lasergewehr.\r\nSchießen Sie auf ein elektronisches Ziel in 10 m Entfernung, die Ausrüstung wird während der Animation zur Verfügung gestellt. Offen für alle.\r\n20 Minuten Aktivität mit Briefing"
    ],
    "en": [
      "Introduce yourself to Laser Rifle Shooting.\r\nShooting on an electronic target at 10m, equipment provided during the event. Open to all.\r\n20-minute activity with briefing"
    ],
    "it": [
      "Imparare a sparare con un fucile laser.\r\nTiro su un bersaglio elettronico a 10m, attrezzatura fornita durante l'evento. Aperto a tutti.\r\nattività di 20 minuti con briefing"
    ],
    "fr": [
      "Initiez-vous au Tir à la Carabine Laser.\r\nTir sur cible électronique à 10m, matériel fourni le temps de l’animation. Ouvert à tous.\r\n20 minutes activité avec briefing"
    ],
    "nl": [
      "Leren schieten met een lasergeweer.\r\nSchieten op een elektronisch doel op 10m, uitrusting wordt tijdens het evenement verstrekt. Voor iedereen toegankelijk.\r\nactiviteit van 20 minuten met briefing"
    ],
    "es": [
      "Aprenda a disparar con un rifle láser.\r\nTiro sobre una diana electrónica a 10 m, equipo proporcionado durante el evento. Abierto a todos.\r\nactividad de 20 minutos con sesión informativa"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tir à la Carabine Laser Hiver"
    ]
  },
