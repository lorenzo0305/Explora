  "rdfs:comment": {
    "de": [
      "Bouchon Lyonnais seit 1867. Vincent Julliand, am Herd seit 2022, wird Ihnen lyoner und bürgerliche Gerichte in einem liebevoll bewahrten Dekor zubereiten."
    ],
    "en": [
      "This traditional 'bouchon' restaurant in Lyon was founded in 1867. In the kitchen, Vincent Julliand prepares specialities of Lyon and some of the great French classics in a marvellously preserved setting."
    ],
    "it": [
      "Bouchon lionese dal 1867, Vincent Julliand ai fornelli fin dal 2022 cucinerà per te piatti di cucina lionese e borghese in una decorazione accuratamente conservata."
    ],
    "fr": [
      "Bouchon lyonnais depuis 1867 ! Vincent Julliand, aux fourneaux depuis 2022, vous cuisinera ses plats lyonnais et bourgeois, dans un décor pieusement conservé."
    ],
    "es": [
      "En este \"bouchon\" lionés, en funcionamiento desde 1867, Brigitte Josserand, al mando de los fogones desde 1974, prepara platos lioneses en un decorado conservado con devoción."
    ],
    "nl": [
      "Een Lyonnais bouchon sinds 1867! Vincent Julliand, die sinds 2022 aan het roer staat van de keuken, zal zijn gerechten uit de Lyonnais en de bourgeoisie bereiden in een vroom bewaard decor."
    ]
  },
