  "rdfs:comment": {
    "de": [
      "Nur 2 Minuten von der A89 entfernt ist die Auberge du Palais der perfekte Zwischenstopp auf dem Weg in die Alpen und an die Côte d'Azur."
    ],
    "en": [
      "L'auberge du Palais is at Celles sur Durolle (12 km of Thiers, capital of the cutlery). Perfect stopover on the road of the Alps and the Riviera."
    ],
    "it": [
      "A soli 2 minuti dall'autostrada A89, l'Auberge du Palais è la tappa perfetta per raggiungere le Alpi e la Costa Azzurra."
    ],
    "fr": [
      "À 2 minutes de l'A89, l'Auberge du Palais est l'escale parfaite sur la route des Alpes et de la Côte d'Azur."
    ],
    "nl": [
      "Op slechts 2 minuten van de snelweg A89 is de Auberge du Palais de perfecte tussenstop op weg naar de Alpen en de Franse Rivièra."
    ],
    "es": [
      "A 2 minutos de la autopista A89, el Auberge du Palais es la parada perfecta de camino a los Alpes y a la Costa Azul."
    ]
  },
