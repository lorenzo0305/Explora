  "rdfs:comment": {
    "de": [
      "Gehen Sie mit dem Verein AP2800 an Bord des blauen Zuges des Südens, um die Gorges de l'Allier auf der legendären Cevennen-Linie zu entdecken. An jedem Halt gibt es etwas zu entdecken: Baden, Kanu fahren, Rad fahren, Wandern, Besichtigungen, Essen gehen!"
    ],
    "en": [
      "Embark with the AP2800 Association on the Train Bleu du Sud, to discover the Gorges de l'Allier on the legendary Cévennes line. At each stop, a new discovery: swimming, canoeing, biking, hiking, sightseeing, dining!"
    ],
    "it": [
      "Unitevi all'Associazione AP2800 sul Train Bleu du Sud per scoprire le Gole dell'Allier sulla leggendaria linea delle Cévennes. A ogni fermata scoprirete qualcosa di nuovo: nuoto, canoa, bicicletta, escursioni, visite turistiche e ristorazione!"
    ],
    "fr": [
      "Embarquez avec l'Association AP2800 dans le train bleu du Sud, pour découvrir les Gorges de l'Allier sur la mythique ligne des Cévennes. A chaque arrêt, une découverte : baignade, canoë, vélo, rando, visite, resto !"
    ],
    "es": [
      "Únase a la Asociación AP2800 en el Tren Azul del Sur para descubrir las Gargantas del Allier en la legendaria línea de las Cevenas. En cada parada descubrirá algo nuevo: natación, piragüismo, ciclismo, senderismo, visitas turísticas y gastronomía"
    ],
    "nl": [
      "Ga mee met de AP2800 Association op de Train Bleu du Sud en ontdek de Gorges de l'Allier op de legendarische lijn door de Cevennen. Bij elke halte ontdek je iets nieuws: zwemmen, kanoën, fietsen, wandelen, bezienswaardigheden en uit eten gaan!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gorges du Haut-Allier - Train voyage touristique"
    ]
  },
