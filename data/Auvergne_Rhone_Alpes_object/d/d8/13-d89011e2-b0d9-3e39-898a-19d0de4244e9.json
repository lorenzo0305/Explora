  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Vertiges\" befindet sich direkt im Herzen der Bergstation der Salève-Seilbahn und bietet einen atemberaubenden Blick auf den Genfersee."
    ],
    "en": [
      "Located in the very heart of the Salève cable car arrival station, the \"Vertiges\" restaurant offers a breathtaking view of Lake Geneva."
    ],
    "it": [
      "Situato nel cuore della stazione di arrivo della funivia di Salève, il ristorante Vertiges offre una vista mozzafiato sul Lago di Ginevra."
    ],
    "fr": [
      "Situé au cœur même de la gare d’arrivée du téléphérique du Salève, le restaurant « Vertiges » offre une vue à couper le souffle sur le Léman."
    ],
    "es": [
      "Situado en pleno corazón de la estación de llegada del teleférico de Salève, el restaurante Vertiges ofrece una vista impresionante del lago Lemán."
    ],
    "nl": [
      "Het restaurant Vertiges ligt in het hart van het aankomststation van de kabelbaan Salève en biedt een adembenemend uitzicht op het meer van Genève."
    ]
  },
