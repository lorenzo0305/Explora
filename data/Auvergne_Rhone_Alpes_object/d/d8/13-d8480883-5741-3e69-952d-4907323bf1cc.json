  "rdfs:comment": {
    "de": [
      "Kletterkurse im Sommer vom 18. Juli bis zum 20. August und das ganze Jahr über in der Drôme und Umgebung, entdecken Sie das Klettern in unserem schönen Tal!"
    ],
    "en": [
      "Climbing sessions this summer from July 18 to August 20 and all year round in and around the Drôme, come and discover climbing in our beautiful valley!"
    ],
    "it": [
      "Sessioni di arrampicata quest'estate dal 18 luglio al 20 agosto e tutto l'anno nella Drôme e dintorni, venite a scoprire l'arrampicata nella nostra bella valle!"
    ],
    "fr": [
      "Séance d’escalade cet été du 18 juillet au 20 août et à l’année en Drôme et alentours , venez découvrir l’escalade dans notre belle vallée !"
    ],
    "es": [
      "Sesiones de escalada este verano del 18 de julio al 20 de agosto y durante todo el año en la Drôme y sus alrededores, ¡venga a descubrir la escalada en nuestro hermoso valle!"
    ],
    "nl": [
      "Klimsessies deze zomer van 18 juli tot 20 augustus en het hele jaar door in en rond de Drôme, kom en ontdek het klimmen in onze mooie vallei!"
    ]
  },
