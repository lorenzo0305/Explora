  "rdfs:comment": {
    "de": [
      "In diesem gemütlichen und originellen Rahmen erwartet Sie eine je nach Saison wechselnde Speisekarte mit \"hausgemachten\" Gerichten (frische Frösche, Fisch aus der Dombes...)."
    ],
    "en": [
      "In this warm and original setting, a menu that changes according to the seasons with \"homemade\" dishes (fresh frogs, fish from Dombes...)."
    ],
    "it": [
      "In questo ambiente caldo e originale, un menu che cambia a seconda della stagione con piatti \"fatti in casa\" (rane fresche, pesce Dombes...)."
    ],
    "fr": [
      "Dans ce cadre chaleureux et original, une carte qui change suivant les saisons avec des plats \"fait maison\" (Grenouilles fraîches, poissons de Dombes...)."
    ],
    "nl": [
      "In dit warme en originele kader, een menu dat verandert volgens het seizoen met \"huisbereide\" gerechten (verse kikkers, Dombes vis...)."
    ],
    "es": [
      "En este marco cálido y original, un menú que cambia según la temporada con platos \"caseros\" (ranas frescas, pescado de Dombes...)."
    ]
  },
