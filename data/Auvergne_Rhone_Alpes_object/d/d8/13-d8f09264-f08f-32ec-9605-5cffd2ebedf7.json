  "rdfs:comment": {
    "de": [
      "Wiedereröffnung auf der Terrasse am 20. Mai.\r\nEntdecken Sie die traditionelle und familiäre Küche dieses Café-Restaurants im mittelalterlichen Dorf Chamalières im Herzen der Loire-Schluchten."
    ],
    "en": [
      "Reopening in terrace on May 20th.\r\nDiscover the traditional and family cuisine of this Café-Restaurant in the medieval village of Chamalières in the heart of the Loire Gorges."
    ],
    "it": [
      "Riapertura della terrazza il 20 maggio.\r\nScoprite la cucina tradizionale e familiare di questo Café-Restaurant nel villaggio medievale di Chamalières, nel cuore delle Gole della Loira."
    ],
    "fr": [
      "Réouverture en terrasse le 20 mai.\r\nDécouvrez la cuisine traditionnelle et familiale de ce Café-Restaurant dans le village médiéval de Chamalières au cœur des gorges de la Loire."
    ],
    "es": [
      "Reapertura en la terraza el 20 de mayo.\r\nDescubra la cocina tradicional y familiar de este Café-Restaurante en el pueblo medieval de Chamalières, en el corazón de las Gargantas del Loira."
    ],
    "nl": [
      "Heropening op het terras op 20 mei.\r\nOntdek de traditionele en familiale keuken van dit Café-Restaurant in het middeleeuwse dorp Chamalières in het hart van de Gorges de la Loire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Simone"
    ]
  },
