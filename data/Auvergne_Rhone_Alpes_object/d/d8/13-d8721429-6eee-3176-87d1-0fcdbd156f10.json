  "rdfs:comment": {
    "de": [
      "Die Mediathek empfängt Sie montags, mittwochs, freitags und samstags. Hier finden Sie eine große Auswahl an Dokumenten, Büchern, Zeitschriften, CDs und DVDs."
    ],
    "en": [
      "The Médiathèque welcomes you on Mondays, Wednesdays, Fridays and Saturdays. You'll find a wide selection of books, magazines, CDs and DVDs."
    ],
    "it": [
      "La biblioteca multimediale è aperta il lunedì, mercoledì, venerdì e sabato. Vi troverete un'ampia scelta di libri, riviste, CD e DVD."
    ],
    "fr": [
      "La Médiathèque vous accueille les lundis, mercredis, vendredis et samedis. Vous y trouverez un large choix de documents, livres, magazines, CD et DVD."
    ],
    "es": [
      "La biblioteca multimedia abre los lunes, miércoles, viernes y sábados. Encontrarás una amplia selección de libros, revistas, CD y DVD."
    ],
    "nl": [
      "De mediatheek is geopend op maandag, woensdag, vrijdag en zaterdag. Je vindt er een ruime keuze aan boeken, tijdschriften, cd's en dvd's."
    ]
