  "rdfs:comment": {
    "de": [
      "Thierry Lacroix ist ein Fotograf, der seine Karriere in den 1980er Jahren bei der Agentur Sipa Press als Laborant begann.\r\nAls er sich entschied, nach Südafrika zu gehen, wurde er Freelancer, um die Situation der Schwarzen während der Apartheid zu dokumentieren."
    ],
    "en": [
      "Thierry Lacroix is a photographer who began his career at Agence Sipa Press as a laboratory assistant in the 1980s.\r\nDeciding to move to South Africa, he went freelance to document the condition of blacks during the Apartheid period."
    ],
    "it": [
      "Thierry Lacroix è un fotografo che ha iniziato la sua carriera alla Sipa Press come assistente di laboratorio negli anni Ottanta.\r\nDecidendo di trasferirsi in Sudafrica, ha iniziato a lavorare come freelance per documentare la condizione dei neri durante il periodo dell'Apartheid."
    ],
    "fr": [
      "Thierry Lacroix est un photographe qui a débuté sa carrière à l'Agence Sipa Press comme laborantin dans les années 1980.\r\nDécidé à partir en Afrique du Sud, il devient freelance pour témoigner de la condition des Noirs pendant la période de l'Apartheid."
    ],
    "nl": [
      "Thierry Lacroix is een fotograaf die zijn carrière begon bij Sipa Press als laborant in de jaren 1980.\r\nHij besloot naar Zuid-Afrika te verhuizen en ging als freelancer aan de slag om de situatie van zwarte mensen tijdens de Apartheid te documenteren."
    ],
    "es": [
      "Thierry Lacroix es un fotógrafo que empezó su carrera en Sipa Press como ayudante de laboratorio en los años ochenta.\r\nDecidió trasladarse a Sudáfrica y trabajó como freelance para documentar la situación de la población negra durante el Apartheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Des journées entières - Thierry Lacroix"
    ]
  },
