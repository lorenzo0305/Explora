  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a5540bfc-6576-3917-a399-6bce313ebaa6",
      "dc:description": {
        "de": [
          "In Beutin ist der gemischte Friseursalon Hair Studio 18 eine Referenz für viele Koketten und Gentlemen. Hier wird mit Leidenschaft und Schwung frisiert, geschnitten, geglättet und gefärbt, um gewagte Looks zu kreieren, die immer im Trend liegen."
        ],
        "en": [
          "In Beutin, the Hair Studio 18 mixed-use salon is a benchmark for coquettes and gentlemen alike. Here, hair is styled, cut, smoothed and colored with passion and gusto, to create daring looks that are always in tune with the times."
        ],
        "it": [
          "A Beutin, il salone di parrucchieri misti Hair Studio 18 è un punto di riferimento per molte coquettes e gentiluomini. Qui acconciamo, tagliamo, stiriamo e coloriamo con passione e gusto, per creare look audaci e sempre al passo con i tempi."
        ],
        "fr": [
          "A Beutin, le salon de coiffure mixte Hair Studio 18 est une référence pour bien des coquettes et des gentlemen. Ici on coiffe, on coupe, on lisse et on colore avec passion  et entrain, pour créer des looks audacieux, et toujours dans l'air du temps."
        ],
        "nl": [
          "In Beutin is de gemengde kapsalon Hair Studio 18 een referentie voor vele coquettes en heren. Hier stylen, knippen, steilen en kleuren we met passie en verve, om gedurfde looks te creëren die altijd bij de tijd horen."
        ],
        "es": [
          "En Beutin, la peluquería mixta Hair Studio 18 es un punto de referencia para muchas coquetas y caballeros. Aquí peinamos, cortamos, alisamos y coloreamos con pasión y gusto, para crear looks atrevidos siempre en sintonía con los tiempos."
        ]
      },
      "@type": [
        "Description"
      ],
