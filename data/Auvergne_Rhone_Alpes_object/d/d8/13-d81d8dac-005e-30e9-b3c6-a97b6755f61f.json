  "rdfs:comment": {
    "de": [
      "Gare à la faim befindet sich neben dem Bahnhof von Montluel und bietet Ihnen hausgemachte Sandwiches, Salate, Desserts und warme Tagesgerichte zum Mitnehmen! Die Speisekarte wechselt jede Woche!"
    ],
    "en": [
      "Located next to the Montluel train station, Gare à la faim offers homemade sandwiches, salads, desserts and hot daily specials to take away! The menu changes every week!"
    ],
    "it": [
      "Situata accanto alla stazione di Montluel, la Gare à la Faim serve panini fatti in casa, insalate, dessert e piatti caldi del giorno da portare via! Il menu cambia ogni settimana!"
    ],
    "fr": [
      "Situé à côté de la gare de Montluel, Gare à la faim vous propose des sandwichs, salades, desserts et plats du jour chauds faits maison et à emporter ! Le menu change toutes les semaines !"
    ],
    "es": [
      "Situada junto a la estación de Montluel, la Gare à la Faim sirve sándwiches caseros, ensaladas, postres y platos calientes del día para llevar El menú cambia cada semana"
    ],
    "nl": [
      "Gare à la Faim ligt naast het station van Montluel en serveert huisgemaakte sandwiches, salades, desserts en warme dagschotels om mee te nemen! Het menu verandert elke week!"
    ]
  },
  "rdfs:label": {
