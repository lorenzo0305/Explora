  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Bauernhof, streicheln Sie Esel, lernen Sie die Eselzucht kennen und erfahren Sie, wie Seife hergestellt wird.\r\n\r\nDer Bauernhof organisiert Eselreiten für Kinder (nur nach Voranmeldung)!"
    ],
    "en": [
      "Come and visit the farm, stroke the donkeys, learn about donkey breeding and soap-making.\r\n\r\nThe farm organizes donkey rides for children (by reservation only)!"
    ],
    "it": [
      "Venite a visitare la fattoria, ad accarezzare gli asini, a scoprire l'allevamento e la produzione di sapone.\r\n\r\nLa fattoria organizza passeggiate con gli asini per i bambini (su prenotazione)!"
    ],
    "fr": [
      "Venez visiter la ferme, caresser les ânons, découvrir l'élevage d'ânes et la fabrication du savon. \r\n\r\nLa ferme organise des balades à dos d'âne pour les enfants (uniquement sur réservation) !"
    ],
    "es": [
      "Venga a visitar la granja, acaricie a los burros, infórmese sobre la cría de burros y la fabricación de jabón.\r\n\r\nLa granja organiza paseos en burro para niños (previa reserva)"
    ],
    "nl": [
      "Kom de boerderij bezoeken, aai de ezels, kom meer te weten over het fokken van ezels en het maken van zeep.\r\n\r\nDe boerderij organiseert ezeltochten voor kinderen (reserveren verplicht)!"
    ]
  },
