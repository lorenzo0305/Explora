  "rdfs:comment": {
    "de": [
      "Das Team von La Puce a L'Oreille und die Stadt Mozac freuen sich, Ihnen im Rahmen des Festivals Arts en Territoire im Salle de l'Arlequin in Mozac Folgendes präsentieren zu können: Marcel et son Orchestre + Poesie Zero"
    ],
    "en": [
      "The team at La Puce a L'Oreille and the town of Mozac are pleased to present the following shows at the Salle de l'Arlequin in Mozac, as part of the Arts en Territoire festival: Marcel et son Orchestre + Poesie Zero"
    ],
    "it": [
      "Il team de La Puce a L'Oreille e la città di Mozac sono lieti di presentare Marcel et son Orchestre + Poesie Zero alla Salle de l'Arlequin di Mozac nell'ambito del festival Arts en Territoire"
    ],
    "fr": [
      "L'équipe de La Puce a L'Oreille et la ville de Mozac ont le plaisir de vous présenter à la salle de l'Arlequin à Mozac, dans le cadre du festival Arts en Territoire : Marcel et son Orchestre + Poesie Zero"
    ],
    "nl": [
      "Het team van La Puce a L'Oreille en de stad Mozac zijn verheugd om Marcel et son Orchestre + Poesie Zero te presenteren in de Salle de l'Arlequin in Mozac als onderdeel van het Arts en Territoire festival"
    ],
    "es": [
      "El equipo de La Puce a L'Oreille y la ciudad de Mozac se complacen en presentar Marcel et son Orchestre + Poesie Zero en la Salle de l'Arlequin de Mozac, en el marco del festival Arts en Territoire"
    ]
  },
