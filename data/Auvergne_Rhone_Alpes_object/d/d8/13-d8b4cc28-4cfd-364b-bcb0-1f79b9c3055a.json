  "rdfs:comment": {
    "de": [
      "Dies ist ein Lauf/Marsch, der zur finanziellen Unterstützung des Espace d'Accompagnement Thérapeutique in Moulins organisiert wird, das kostenlose Behandlungen für Menschen mit Krebs anbietet."
    ],
    "en": [
      "It's a run/walk organized to financially support the Espace d'Accompagnement Thérapeutique de Moulins, which offers free care to cancer sufferers."
    ],
    "it": [
      "Si tratta di una corsa/camminata organizzata per sostenere finanziariamente l'Espace d'Accompagnement Thérapeutique de Moulins, che offre cure gratuite ai malati di cancro."
    ],
    "fr": [
      "C'est une course/marche organisée pour soutenir financièrement l'Espace d'Accompagnement Thérapeutique de Moulins, qui offre des soins gratuits aux personnes atteintes de cancer."
    ],
    "es": [
      "Se trata de una carrera/marcha organizada para ayudar económicamente al Espace d'Accompagnement Thérapeutique de Moulins, que ofrece atención gratuita a enfermos de cáncer."
    ],
    "nl": [
      "Dit is een hardloopwedstrijd die wordt georganiseerd om de Espace d'Accompagnement Thérapeutique de Moulins financieel te steunen, die gratis zorg biedt aan kankerpatiënten."
    ]
  },
