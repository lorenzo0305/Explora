  "rdfs:comment": {
    "de": [
      "Willkommen auf den Heritage-Orientierungsläufen von Macot La Plagne! \r\n4 Parcours aller Niveaus grün, blau, rot und schwarz, wählen Sie Ihren!"
    ],
    "en": [
      "Welcome to the orienteering course focusing on the heritage of Macot La Plagne!\r\n4 courses, all levels, green, blue, red and black for you to choose from!"
    ],
    "it": [
      "Benvenuti sui percorsi di orienteering del patrimonio di Macot La Plagne!\r\n4 percorsi per tutti i livelli, verde, blu, rosso e nero, scegliete il vostro!"
    ],
    "fr": [
      "Bienvenue sur les parcours d'orientation patrimoine de Macot La Plagne ! \r\n4 parcours de tous niveaux vert, bleu, rouge et noir, choisissez le votre !"
    ],
    "nl": [
      "Welkom bij de oriëntatieloop van Macot La Plagne!\r\n4 parcours voor alle niveaus - groen, blauw, rood en zwart - kies het jouwe!"
