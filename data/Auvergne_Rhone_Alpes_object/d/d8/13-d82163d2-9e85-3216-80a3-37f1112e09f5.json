  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, mit Ihrer Familie einen Moment in der Natur zu verbringen?\r\nIm Haras du Châtelet begrüßen wir Groß und Klein von 3 bis 99 Jahren, ob Anfänger oder erfahrener Reiter, in einer freundlichen, wohlwollenden und familiären Atmosphäre."
    ],
    "en": [
      "Want to share a natural moment with your family?\r\nAt the Haras du Châtelet, we welcome young and old alike, from 3 to 99 years old, whether you're a beginner or an experienced rider, in a friendly, caring, family atmosphere."
    ],
    "it": [
      "Volete condividere un momento di natura con la vostra famiglia?\r\nAll'Haras du Châtelet accogliamo tutte le età, dai 3 ai 99 anni, sia che siate principianti o esperti, in un'atmosfera amichevole, premurosa e familiare."
    ],
    "fr": [
      "Envie de partager un moment nature en famille ?\r\nAu Haras du Châtelet, nous accueillons petits et grands de 3 à 99 ans, que vous soyez débutants ou cavaliers confirmés, dans une ambiance conviviale, bienveillante et familiale."
    ],
    "es": [
      "¿Le gustaría compartir un momento natural con su familia?\r\nEn el Haras du Châtelet, acogemos a todas las edades, de 3 a 99 años, tanto a principiantes como a jinetes experimentados, en un ambiente familiar y acogedor."
    ],
    "nl": [
      "Wil je een natuurlijk moment delen met je familie?\r\nOp de Haras du Châtelet verwelkomen we alle leeftijden van 3 tot 99 jaar, of je nu een beginner of een ervaren ruiter bent, in een vriendelijke, zorgzame en familiale sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Haras du Châtelet – Centre Équestre & Poney-Club"
    ]
  },
