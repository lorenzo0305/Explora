  "rdfs:comment": {
    "de": [
      "1083 ist eine französische Jeansmarke, die auch Schuhe, Jacken, T-Shirts und Accessoires anbietet, die im Umkreis von 1083 von Ihrem Wohnort hergestellt werden! Die Jeans bestehen aus Bio-Baumwolle, die GOTS-zertifiziert ist."
    ],
    "en": [
      "1083 is a French jeans brand that also offers shoes, jackets, t-shirts and accessories made less than 1083 from home! The jeans are made from GOTS-certified organic cotton."
    ],
    "it": [
      "1083 è un marchio francese di jeans che offre anche scarpe, giacche, magliette e accessori realizzati a casa vostra! I jeans sono realizzati in cotone biologico, certificato GOTS."
    ],
    "fr": [
      "1083 est une marque de jeans français qui propose également des chaussures, vestes, t-shirts et accessoires fabriqués à moins de 1083 de chez vous ! Les jeans sont en coton bio, certifié GOTS."
    ],
    "nl": [
      "1083 is een Frans jeansmerk dat ook schoenen, jassen, t-shirts en accessoires aanbiedt die minder dan 1083 van huis uit maakt! De jeans zijn gemaakt van GOTS-gecertificeerd biologisch katoen."
    ],
    "es": [
      "1083 es una marca francesa de vaqueros que también ofrece zapatos, chaquetas, camisetas y accesorios ¡hechos en 1083 de tu casa! Los vaqueros están hechos de algodón orgánico, certificado GOTS."
