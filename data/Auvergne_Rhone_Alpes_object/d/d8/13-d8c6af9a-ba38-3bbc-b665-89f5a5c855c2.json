  "rdfs:comment": {
    "de": [
      "Der Pub Barney's bietet Ihnen jeden Mittag einen Catering-Service! Jeden Mittag können Sie Aperitifplatten, Burger, Salate oder andere belegte Brote genießen!\r\nKindermenü für die Jüngsten."
    ],
    "en": [
      "Here, you will find for lunch burger, salade or \"tartine\" ! Enjoy your meal !"
    ],
    "it": [
      "Il Barney's pub è aperto ogni ora di pranzo! Ogni ora di pranzo, gustate un aperitivo, un hamburger, un'insalata o un panino!\r\nMenu per bambini per i più piccoli."
    ],
    "fr": [
      "Le pub Barney's vous propose tous les midis un service de restauration ! Tous les midis, déguster des planches apéro, burger, salade ou autres tartines ! \r\nMenu enfant pour les plus jeunes."
    ],
    "es": [
      "El pub Barney's abre todos los mediodías Todos los mediodías, disfrute de un aperitivo, una hamburguesa, una ensalada o un sándwich\r\nMenú infantil para los más pequeños."
    ],
    "nl": [
      "Barney's pub is elke middag geopend! Geniet elke middag van een aperitief, hamburger, salade of sandwich!\r\nKindermenu voor de jongere gasten."
    ]
  },
