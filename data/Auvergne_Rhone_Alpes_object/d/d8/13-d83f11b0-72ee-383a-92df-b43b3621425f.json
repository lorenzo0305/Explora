  "rdfs:comment": {
    "de": [
      "Am Sonntag, den 29. März um 17 Uhr findet in der Kathedrale Notre-Dame in Le Puy-en-Velay ein außergewöhnliches Konzert zur Fastenzeit statt, das vom Zentrum für Kirchenmusik in Le Puy-en-Velay angeboten wird."
    ],
    "en": [
      "On Sunday March 29 at 5pm, Notre-Dame Cathedral in Le Puy-en-Velay will host a special Lenten concert by the Centre de Musique Sacrée du Puy-en-Velay."
    ],
    "it": [
      "Domenica 29 marzo alle ore 17.00, la Cattedrale di Notre-Dame di Le Puy-en-Velay ospiterà un concerto eccezionale per la stagione quaresimale, organizzato dal Centre de musique sacrée di Le Puy-en-Velay."
    ],
    "fr": [
      "Le dimanche 29 mars à 17h, la cathédrale Notre-Dame du Puy-en-Velay accueillera un concert exceptionnel pour le Temps du Carême, proposé par le Centre de musique sacrée du Puy-en-Velay."
    ],
    "nl": [
      "Op zondag 29 maart om 17.00 uur organiseert de kathedraal Notre-Dame in Le Puy-en-Velay een bijzonder concert voor de vastentijd, georganiseerd door het Centre de musique sacrée in Le Puy-en-Velay."
    ],
    "es": [
      "El domingo 29 de marzo a las 17:00 horas, la catedral de Notre-Dame de Le Puy-en-Velay acogerá un concierto excepcional de Cuaresma, organizado por el Centre de musique sacrée de Le Puy-en-Velay."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Le Stabat Mater de Pergolèse"
    ]
  },
