  "rdfs:comment": {
    "de": [
      "3 feste Holztische, die von einer großen Trauerweide beschattet werden, neben einem Kinderspielplatz, einer Wasserstelle und dem Parkplatz. Rasenfläche."
    ],
    "en": [
      "3 fixed wooden tables, shaded by a large weeping willow, next to a children's play area, water point and parking lot. Grassed area."
    ],
    "it": [
      "3 tavoli fissi in legno, all'ombra di un grande salice piangente, accanto a un parco giochi per bambini, a un punto d'acqua e al parcheggio. Area erbosa."
    ],
    "fr": [
      "3 tables fixes en bois, ombragées par un grand saule pleureur, à côté d'une aire de jeux pour enfants, d'un point d'eau et du parking. Aire gazonnée."
    ],
    "nl": [
      "3 vaste houten tafels, in de schaduw van een grote treurwilg, naast een speeltuin, waterpunt en parkeerplaats. Grasveld."
    ],
    "es": [
      "3 mesas fijas de madera, a la sombra de un gran sauce llorón, junto a un parque infantil, un punto de agua y el aparcamiento. Zona de césped."
    ]
  },
  "rdfs:label": {
    "fr": [
