  "rdfs:comment": {
    "de": [
      "Der Lac de la Pisserotte ist leicht zugänglich und liegt in einer ländlichen Umgebung, nur wenige Meter vom Fluss Hyères entfernt. Er bietet Ihnen tolle Angelerlebnisse, egal ob Sie Anfänger oder erfahrener Angler sind."
    ],
    "en": [
      "Easily accessible and in a rural setting, just a few meters from the Hyères river, Lac de la Pisserotte offers great fishing thrills, whether you're a beginner or an experienced angler."
    ],
    "it": [
      "Facilmente accessibile e situato in un ambiente rurale, a pochi metri dal fiume Hyères, il Lac de la Pisserotte offre un'ottima pesca, sia che siate principianti che esperti."
    ],
    "fr": [
      "Facile d'accès et dans un cadre rural, à quelques mètres de l'Hyères, le Lac de la Pisserotte vous offrira de belles sensations en pêche, que vous soyez pêcheur débutant ou confirmé."
    ],
    "nl": [
      "Het Lac de la Pisserotte is gemakkelijk toegankelijk en ligt in een landelijke omgeving, op slechts een paar meter van de rivier de Hyères. Je kunt er geweldig vissen, of je nu een beginner of een ervaren visser bent."
    ],
    "es": [
      "De fácil acceso y en un entorno rural, a pocos metros de Hyères, el lago de la Pisserotte le ofrecerá grandes sensaciones de pesca, tanto si es un principiante como un pescador experimentado."
    ]
  },
  "rdfs:label": {
