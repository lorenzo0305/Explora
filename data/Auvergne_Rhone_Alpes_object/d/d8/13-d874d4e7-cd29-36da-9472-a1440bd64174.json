  "rdfs:comment": {
    "de": [
      "La Renaissance, das 1982 eröffnete Theater der Stadt Oullins, eine Bühne von nationalem Interesse, Kunst und Kreation Scènes & musiques, befindet sich im Herzen des Großraums Lyon. Drei Räume stehen dem Publikum und den Künstlern zur Verfügung."
    ],
    "en": [
      "Inaugurated in 1982, La Renaissance, the Théâtre de la Ville d?Oullins, a nationally-renowned Scènes & Musiques stage, is at the heart of the Lyon urban area. Three spaces are available to audiences and artists."
    ],
    "it": [
      "Inaugurato nel 1982, La Renaissance, il Théâtre de la Ville d'Oullins, palcoscenico di fama nazionale per le arti e la creazione di Scènes & Musiques, si trova nel cuore dell'area urbana di Lione. Tre spazi sono a disposizione del pubblico e degli artisti."
    ],
    "fr": [
      "Inauguré en 1982, La Renaissance, théâtre de la Ville d’Oullins, scène conventionnée d’intérêt national, art et création Scènes & musiques, est au cœur de l’agglomération lyonnaise. Trois espaces sont la disposition du public et des artistes."
    ],
    "nl": [
      "La Renaissance, het Théâtre de la Ville d'Oullins, een nationaal bekend podium voor de kunsten en de creatie van Scènes & Musiques, werd in 1982 geopend en ligt in het hart van het stadsgebied van Lyon. Er zijn drie ruimtes beschikbaar voor publiek en artiesten."
    ],
    "es": [
      "Inaugurado en 1982, La Renaissance, el Théâtre de la Ville d'Oullins, escenario de renombre nacional para las artes y la creación de Scènes & Musiques, se encuentra en el corazón de la zona urbana de Lyon. Tres espacios están a disposición del público y de los artistas."
    ]
  },
