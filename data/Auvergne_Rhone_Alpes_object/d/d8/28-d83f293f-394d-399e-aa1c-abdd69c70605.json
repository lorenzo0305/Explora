  "rdfs:comment": {
    "de": [
      "Eine Geschichte von Mutter Natur im Herzen des Dorfes Bonneil mit MG-Champagner, gehen Sie auf eine Rundwanderung mit Picknick in der Hand."
    ],
    "en": [
      "A story of Mother Nature in the heart of the village of Bonneil with the MG champagne, leave for a walking tour with picnic in hand."
    ],
    "it": [
      "Una storia di Madre Natura nel cuore del villaggio di Bonneil con champagne MG, partenza per un tour a piedi con picnic in mano."
    ],
    "fr": [
      "Une histoire de Dame nature au coeur du village de Bonneil avec le champagne MG, partez pour circuit de randonnée pique-nique en main."
    ],
    "es": [
      "Una historia de la Madre Naturaleza en el corazón del pueblo de Bonneil con champán MG, emprenda un recorrido a pie con picnic en mano."
    ],
    "nl": [
      "Een verhaal van Moeder Natuur in het hart van het dorp Bonneil met MG champagne, op stap met picknick in de hand."
