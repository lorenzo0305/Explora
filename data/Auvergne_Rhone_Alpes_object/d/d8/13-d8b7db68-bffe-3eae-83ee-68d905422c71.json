  "rdfs:comment": {
    "de": [
      "Gemeindebibliothek, die für alle mit einem Abonnement zugänglich ist. Im Herzen des Dorfes gelegen, ist der Jugendbestand über Saint Hugues zugänglich."
    ],
    "en": [
      "Municipal library accessible to all by subscription. Located in the heart of the village, the youth fund is accessible on Saint Hugues."
    ],
    "it": [
      "Biblioteca comunale accessibile a tutti tramite abbonamento. Situata nel cuore del villaggio, la collezione giovanile è accessibile da Saint Hugues."
    ],
    "fr": [
      "Bibliothèque municipale accessible à tous sur abonnement. Située en plein coeur du village le fond jeunesse est accessible sur Saint Hugues."
    ],
    "nl": [
      "Gemeentelijke bibliotheek voor iedereen toegankelijk via een abonnement. Gelegen in het hart van het dorp, is de jeugdcollectie toegankelijk op Saint Hugues."
    ],
    "es": [
      "Biblioteca municipal accesible a todos por suscripción. Situada en el corazón del pueblo, la colección para jóvenes es accesible por Saint Hugues."
