  "rdfs:comment": {
    "de": [
      "Gehen Sie vom Opinel-Platz aus über einen befahrbaren Weg mit geringer Steigung in Richtung des Weilers La Colonne."
    ],
    "en": [
      "Leaving Place Opinel, head for the hamlet of La Colonne on a gently sloping, passable track."
    ],
    "it": [
      "Da Place Opinel, ci si dirige verso la frazione di La Colonne lungo un sentiero in leggera pendenza adatto ai veicoli."
    ],
    "fr": [
      "Au départ de la place Opinel, partez en direction du hameau de la Colonne par une piste carrossable et de faible pente."
    ],
    "nl": [
      "Ga vanaf Place Opinel in de richting van het gehucht La Colonne over een licht glooiend pad dat geschikt is voor voertuigen."
    ],
    "es": [
      "Desde la Place Opinel, diríjase hacia la aldea de La Colonne por una pista en suave pendiente apta para vehículos."
    ]
  },
