  "rdfs:comment": {
    "de": [
      "Freie Besichtigung oder geführte Besichtigung. Entdeckung der mittelalterlichen Stadt, des Glockenturms Saint-Sauveur (quadratischer Glocken- und Torbogen aus dem 13. Jh.. ISMH), des alten Schlosses, Sitz der Bourbonen im 12. Jh., der Stadttore und der alten Häuser..."
    ],
    "en": [
      "Self-guided or guided tour. Discover the medieval town, the Saint-Sauveur bell tower (13th-century square bell tower-porch, ISMH), the former castellany, seat of the Bourbons in the 12th century, the town gates and old houses..."
    ],
    "it": [
      "Visita autonoma o guidata. Scoprite la città medievale, il campanile di Saint-Sauveur (campanile-portico quadrato del XIII secolo. ISMH), l'antico castello, sede dei Borboni nel XII secolo, le porte della città e le vecchie case..."
    ],
    "fr": [
      "Visite libre ou visite guidée. Découverte de la cité médiévale, du clocher Saint-Sauveur (clocher-porche carré du XIIIe siècle. ISMH), de l'ancienne châtellenie, siège des Bourbons au XIIè siècle, des portes de ville et des maisons anciennes..."
    ],
    "es": [
      "Visita autoguiada o guiada. Descubra la ciudad medieval, el campanario de Saint-Sauveur (campanario-porche cuadrado del siglo XIII. ISMH), la antigua castellanía, sede de los Borbones en el siglo XII, las puertas de la ciudad y las casas antiguas..."
    ],
    "nl": [
      "Rondleiding met of zonder gids. Ontdek de middeleeuwse stad, de klokkentoren van Saint-Sauveur (vierkante klokkentoren-poort uit de 13e eeuw. ISMH), het voormalige kasteel, zetel van de Bourbons in de 12e eeuw, de stadspoorten en oude huizen..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hérisson, Petite Cité de Caractère ®"
    ]
  },
