  "rdfs:comment": {
    "de": [
      "Schöne Strecke häufig im Wald und am Flussufer entlang. Durchqueren Sie mehrere typische Weiler, darunter Bonnenuit, das sich am Fuße des Grand Galibier eingenistet hat."
    ],
    "en": [
      "Nice route frequently in the forest and along the river. Cross several typical hamlets including that of Bonnenuit, nestled at the foot of the Grand Galibier."
    ],
    "it": [
      "Un percorso grazioso, spesso nei boschi e lungo il fiume. Si attraversano diversi borghi tipici, tra cui Bonnenuit, adagiato ai piedi del Grand Galibier."
    ],
    "fr": [
      "Joli parcours fréquemment en forêt et en bordure de rivière. Traversez plusieurs hameaux typiques dont celui de Bonnenuit, niché au pied du Grand Galibier."
    ],
    "es": [
      "Un bonito recorrido, a menudo entre bosques y junto al río. Atraviesa varias aldeas típicas, como Bonnenuit, a los pies del Grand Galibier."
    ],
    "nl": [
      "Een mooie route, vaak door bossen en langs de rivier. U passeert verschillende typische gehuchten, waaronder Bonnenuit, genesteld aan de voet van de Grand Galibier."
    ]
  },
