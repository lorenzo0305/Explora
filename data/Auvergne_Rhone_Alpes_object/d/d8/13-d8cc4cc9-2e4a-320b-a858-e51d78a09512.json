  "rdfs:comment": {
    "de": [
      "Die Bibliothek empfängt Sie in einem hellen und freundlichen Raum mit über 5000 Medien für jedes Publikum.\r\n Krimis, Comics, Bilderbücher, Zeitschriften, CDs, DVDs ...."
    ],
    "en": [
      "The library is a bright and friendly space with more than 5,000 documents for everyone. Crime novels, comics, albums, magazines, CDs, DVDs etc."
    ],
    "it": [
      "La biblioteca vi accoglie in uno spazio luminoso e accogliente con oltre 8.000 articoli per tutte le età.\r\n Romanzi, gialli, documenti, letteratura locale, fumetti, album, riviste, DVD ...."
    ],
    "fr": [
      "La bibliothèque vous accueille dans un espace clair et convivial proposant plus de 8000 documents pour tout public.\r\n Romans, romans policiers, documents, fonds local, BD, albums, revues, DVD ...."
    ],
    "es": [
      "La biblioteca le da la bienvenida a un espacio luminoso y acogedor con más de 8.000 artículos para todas las edades.\r\n Novelas, novelas policíacas, documentos, literatura local, cómics, álbumes, revistas, DVD ...."
    ],
    "nl": [
      "De bibliotheek verwelkomt je in een lichte, vriendelijke ruimte met meer dan 8000 items voor alle leeftijden.\r\n Romans, detectiveverhalen, documenten, lokale literatuur, strips, albums, tijdschriften, dvd's ...."
    ]
  },
