  "rdfs:comment": {
    "de": [
      "Wir betreiben Wanderimkerei in einem Umkreis von 100 km und produzieren verschiedene einblütige Honigsorten: Akazie aus der Drôme des collines, Lavendel aus der Drôme provençale, Kastanie aus der nördlichen Drôme... Wir entwickeln auch die Ernte von Gelée Royale."
    ],
    "en": [
      "We practice transhumance within a 100 km radius, and produce a variety of single-flower honeys: acacia from the Drôme des collines, lavender from the Drôme provençale, chestnut from the northern Drôme... We are also developing the harvesting of royal jelly."
    ],
    "it": [
      "Pratichiamo la transumanza in un raggio di 100 km e produciamo diversi mieli monoflorali: acacia della Drôme des collines, lavanda della Drôme provençale, castagno del nord della Drôme... Stiamo anche sviluppando la raccolta della pappa reale."
    ],
    "fr": [
      "Nous pratiquons la transhumance dans un rayon de 100 km, et produisons divers miels mono-floraux : acacia de la Drôme des collines, lavande de la Drôme provençale, châtaignier du nord Drôme... Nous développons aussi la récolte de la gelée royale."
    ],
    "nl": [
      "We maken gebruik van transhumance binnen een straal van 100 km en produceren een reeks honingsoorten met één bloem: acacia uit de Drôme des collines, lavendel uit de Drôme provençale, kastanje uit het noorden van de Drôme... We ontwikkelen ook de oogst van koninginnengelei."
    ],
    "es": [
      "Practicamos la trashumancia en un radio de 100 km y producimos varias mieles monoflorales: acacia de la Drôme des collines, lavanda de la Drôme provençale, castaña del norte de la Drôme... También estamos desarrollando la cosecha de jalea real."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les ruchers d'Ulysse"
    ]
  },
