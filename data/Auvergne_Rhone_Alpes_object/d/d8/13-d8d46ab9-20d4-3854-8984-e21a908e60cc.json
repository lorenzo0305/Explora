  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Différents mais ensemble (Anders, aber gemeinsam) lädt dich das PIJ zu einem Austausch über Behinderung, Unterschiede und das Zusammenleben ein."
    ],
    "en": [
      "As part of the \"Different but together\" program, the PIJ invites you to come and talk about disability, differences and living together."
    ],
    "it": [
      "Nell'ambito del programma Different but Together, il PIJ vi invita a venire a parlare di disabilità, differenze e convivenza."
    ],
    "fr": [
      "Dans le cadre du programme Différents mais ensemble, le PIJ te propose de venir échanger autour du Handicap, des différences et vivre ensemble."
    ],
    "es": [
      "En el marco del programa Diferentes pero Juntos, el PIJ le invita a venir a hablar de discapacidad, diferencias y convivencia."
    ],
    "nl": [
      "Als onderdeel van het programma Anders maar samen nodigt de PIJ je uit om te komen praten over handicaps, verschillen en samenleven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parlons ensemble du handicap"
    ]
  },
