  "rdfs:comment": {
    "de": [
      "Sommerfest in Félines mit den Sources de la Borne (2 Rennen über 12 und 25 km, 1 Kinderrennen, Mountainbike- und Wandertouren) und den ganzen Tag über angebotenen Animationen: Flohmarkt, Essen, Boule-Wettbewerb und Seifenkistenabfahrt..."
    ],
    "en": [
      "Summer festival in Félines with the Sources de la Borne (2 races of 12 and 25 km, 1 children's race, mountain bike and pedestrian hikes) and events throughout the day: garage sale, meal, pétanque competition and soapbox raid..."
    ],
    "it": [
      "Festa d'estate a Félines con le Sources de la Borne (2 gare di 12 e 25 km, 1 gara per bambini, percorsi per mountain bike ed escursionismo) ed eventi durante tutta la giornata: vendita di garage, pasto, gara di pétanque e gara di soapbox..."
    ],
    "fr": [
      "Fête d'été à Félines avec les Sources de la Borne (2 courses de 12 et 25 km, 1 course enfant, rando VTT et pédestre) et des animations proposées tout au long de la journée : vide-grenier, repas, concours de pétanque et descente de caisses à savon..."
    ],
    "nl": [
      "Zomerfeest in Félines met de Sources de la Borne (2 wedstrijden van 12 en 25 km, 1 kinderwedstrijd, mountainbike- en wandelroutes) en evenementen gedurende de hele dag: garageverkoop, maaltijd, petanquewedstrijd en zeepkistenrace..."
    ],
    "es": [
      "Fiesta del verano en Félines con las Sources de la Borne (2 carreras de 12 y 25 km, 1 carrera infantil, rutas de BTT y senderismo) y eventos durante todo el día: venta de garaje, comida, competición de petanca y carrera de soapbox..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête d'été \"Les Sources de la Borne\""
    ]
  },
