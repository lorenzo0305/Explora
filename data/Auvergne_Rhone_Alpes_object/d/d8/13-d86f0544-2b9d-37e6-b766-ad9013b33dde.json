  "rdfs:comment": {
    "de": [
      "Das Hotel le Lac des Graves*** befindet sich im Herzen eines 40 ha großen Parks. Im Jordanne-Tal, 15 Minuten von Aurillac, 25 Minuten vom Puy Mary und 1 Stunde von Salers entfernt."
    ],
    "en": [
      "The hotel is located in the heart of 40 hectares of grounds in the Jordanne Valley."
    ],
    "it": [
      "L'Hotel le Lac des Graves*** si trova nel cuore di un parco di 40 ettari nella valle del Jordanne, a 15 minuti da Aurillac, 25 minuti da Puy Mary e 1 ora da Salers."
    ],
    "fr": [
      "L’Hôtel le Lac des Graves*** se situe au cœur d’un parc de 40 ha. dans la vallée de la Jordanne à 15 minutes d’Aurillac, à 25 mn du Puy Mary et à 1h de Salers."
    ],
    "nl": [
      "Hotel le Lac des Graves*** ligt in het hart van een park van 40 ha in de vallei van de Jordanne, op 15 minuten van Aurillac, 25 minuten van Puy Mary en 1 uur van Salers."
    ],
    "es": [
      "El Hotel se encuentra en el corazón de un parque de 40 hectáreas en el valle del Jordanne."
    ]
  },
