  "rdfs:comment": {
    "de": [
      "Möchten Sie Ihre Kleinen auf einen Ausflug mitnehmen? Der Pavillon du Tourisme vermietet mechanische Fahrräder mit Babytragen, sodass Sie die ViaRhôna mit der ganzen Familie genießen können!"
    ],
    "en": [
      "Fancy taking your little ones for a ride? The Pavillon du tourisme has mechanical bicycles equipped with baby carriers for hire, so you can enjoy the ViaRhôna as a family!"
    ],
    "it": [
      "Volete portare i vostri piccoli a fare un giro? Il Pavillon du tourisme mette a disposizione biciclette meccaniche dotate di portabambini, per godersi la ViaRhôna in famiglia!"
    ],
    "fr": [
      "Envie d’emmener vos tout-petits en balade ? Le Pavillon du tourisme propose à la location des vélos mécaniques équipés de porte-bébés qui vous permettront de profiter en famille de la ViaRhôna !"
    ],
    "es": [
      "¿Quiere pasear con los más pequeños? El Pavillon du tourisme alquila bicicletas mecánicas equipadas con portabebés para que pueda disfrutar de la ViaRhôna en familia"
    ],
    "nl": [
      "Wil je je kleintjes meenemen voor een ritje? Bij het Pavillon du tourisme kun je mechanische fietsen met kinderdragers huren, zodat je met het hele gezin van de ViaRhôna kunt genieten!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Mechanischer Fahrradverleih mit Babytrage in Vienne"
    ],
    "en": [
      "Mechanical bicycle rental with baby carrier in Vienne"
    ],
    "fr": [
      "Location de vélos mécaniques avec porte-bébé à Vienne"
    ]
  },
