  "rdfs:comment": {
    "de": [
      "ein neuer Stil erweckt das Restaurant La Veyrie seit über zehn Jahren zu neuem Leben. Die großzügige Gourmetküche schöpft weitgehend aus regionalen Produkten."
    ],
    "en": [
      "A new style has been breathing new life into La Veyrie restaurant for the past 9 years. Their generous, gourmet cuisine draws heavily on regional produce."
    ],
    "it": [
      "da oltre 10 anni, il ristorante La Veyrie è stato arricchito da un nuovo stile. La loro cucina generosa e gourmet attinge a piene mani dai prodotti regionali."
    ],
    "fr": [
      "un nouveau style redonnent vie au Restaurant La Veyrie depuis plus de 10 ans. Une cuisine gourmande et généreuse puisant largement dans les produits du terroir régional."
    ],
    "nl": [
      "een nieuwe stijl die Restaurant La Veyrie de afgelopen 9 jaar nieuw leven heeft ingeblazen. Royale, gastronomische keuken op basis van regionale producten."
    ],
    "es": [
      "desde hace más de 10 años, el Restaurante La Veyrie respira un nuevo estilo. Su cocina, generosa y gastronómica, se basa en gran medida en los productos regionales."
    ]
  },
