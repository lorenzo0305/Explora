  "rdfs:comment": {
    "de": [
      "Das Plateau d'Ambel erstreckt sich über eine Fläche von 1231 Hektar, die zwischen Weiden und Wäldern aufgeteilt ist. Mit seinem reichen historischen und natürlichen Erbe und seinen drei frei zugänglichen Hütten heißt Ambel Sie herzlich willkommen und bietet Ihnen zahlreiche Möglichkeiten, die Natur zu entdecken."
    ],
    "en": [
      "The Plateau d'Ambel covers 1231 hectares, divided between pastures and forests. With its rich historical and natural heritage, and three huts open to the public, Ambel offers a wide range of opportunities to discover nature."
    ],
    "it": [
      "L'altopiano dell'Ambel si estende per 1231 ettari, suddivisi tra pascoli e foreste. Con il suo ricco patrimonio storico e naturale, i suoi tre rifugi ad accesso gratuito, Ambel vi accoglie e vi offre molte possibilità di scoprire la natura."
    ],
    "fr": [
      "Le Plateau d’Ambel s’étend sur 1231 hectares, partagées entre pâturages et forêts. Riche de son patrimoine historique et naturel, de ses trois refuges en libre accès, Ambel vous accueille et vous offre de nombreuses possibilités de découvertes nature."
    ],
    "es": [
      "La meseta de Ambel abarca 1231 hectáreas, divididas entre pastos y bosques. Con su rico patrimonio histórico y natural, sus tres refugios de libre acceso, Ambel le da la bienvenida y le ofrece muchas posibilidades de descubrir la naturaleza."
    ],
    "nl": [
      "Het Plateau d'Ambel beslaat 1231 hectare, verdeeld over weilanden en bossen. Met zijn rijke historische en natuurlijke erfgoed en zijn drie hutten die open zijn voor het publiek, is Ambel de perfecte plek om de natuur te ontdekken."
    ]
  },
