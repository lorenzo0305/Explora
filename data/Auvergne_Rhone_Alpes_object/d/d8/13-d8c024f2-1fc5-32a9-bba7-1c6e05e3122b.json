  "rdfs:comment": {
    "de": [
      "Praxis: Paragliding\r\nOrientierung: N, E, W\r\nBemerkungen/Gefahren: Benutzen, wenn die Wiesen gemäht sind. Nicht in geringer Höhe über Häuser in der Nähe des Landeplatzes fliegen. Auf angrenzende Grundstücke achten, nicht mit dem Auto fahren."
    ],
    "en": [
      "Practice: paragliding\r\nDirection: N, E, W\r\nObservations / Dangers: Use when the meadows are mown. Do not fly over houses at low altitude near the landing area. Be careful of adjacent land, no cars."
    ],
    "it": [
      "Pratica : parapendio\r\nDirezione: N, E, W\r\nOsservazioni / Pericoli: utilizzare quando i prati sono falciati. Non sorvolare le case a bassa quota vicino all'area di atterraggio. Fate attenzione al terreno confinante, non è consentito l'accesso alle auto."
    ],
    "fr": [
      "Pratique : parapente\r\nOrientation : N, E, O\r\nObservations / Dangers : Utiliser lorsque les près sont fauchés. Pas de survol des maisons à basse altitude près de l'atterro. Faire attention aux terrains limitrophes, pas de voiture."
    ],
    "nl": [
      "Praktijk: paragliding\r\nRichting: N, E, W\r\nObservaties/gevaren: Gebruik de weiden wanneer ze gemaaid zijn. Vlieg niet op lage hoogte over huizen in de buurt van de landingsplaats. Let op het naburige land, geen auto's."
    ],
    "es": [
      "Práctica : parapente\r\nDirección: N, E, W\r\nObservaciones / Peligros: Utilizar cuando los prados están segados. No se puede volar sobre las casas a baja altura cerca de la zona de aterrizaje. Cuidado con los terrenos colindantes, no hay coches."
    ]
  },
  "rdfs:label": {
