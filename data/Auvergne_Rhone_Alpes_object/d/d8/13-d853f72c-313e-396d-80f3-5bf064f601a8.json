  "rdfs:comment": {
    "de": [
      "Vermietung, Verkauf und Reparatur von Skiausrüstung, Fahrrädern, Elektro-Mountainbikes, Rollern...\r\nGeführte Fahrradtouren das ganze Jahr über\r\nBoot-fitting für Ski- und Sportschuhe\r\nVerkauf von Kleidung, Ski- und Snowboardausrüstung.\r\nWiederverkäufer der Fahrradmarke Cube"
    ],
    "en": [
      "Summer : rental & retail of climbing & walking equipment, tennis & skateboard gear. Sportswear."
    ],
    "it": [
      "Noleggio, vendita e riparazione di attrezzature da sci, biciclette, mountain bike elettriche, scooter, ecc.\r\nEscursioni guidate in bicicletta tutto l'anno\r\nCalzatura di sci e scarpe sportive\r\nVendita di abbigliamento, attrezzatura da sci e snowboard.\r\nRivenditore del marchio di biciclette Cube"
    ],
    "fr": [
      "Location, vente, réparation de matériel de ski, vélo, VTT électrique, trottinettes...\r\nSorties guidées en vélo toute l'année\r\nBoot-fitting pour chaussure ski et sport\r\nVente de vêtements, équipements ski, snowboard.\r\nRevendeur de la marque de vélo Cube"
    ],
    "nl": [
      "Verhuur, verkoop en reparatie van skimateriaal, fietsen, elektrische mountainbikes, scooters, enz.\r\nBegeleide fietstochten het hele jaar door\r\nPassen van skischoenen en sportschoenen\r\nVerkoop van kleding, ski- en snowboarduitrusting.\r\nWederverkoper van het fietsmerk Cube"
    ],
    "es": [
      "Alquiler, venta y reparación de material de esquí, bicicletas, bicicletas eléctricas de montaña, patinetes, etc.\r\nExcursiones guiadas en bicicleta durante todo el año\r\nCalzado para esquís y calzado deportivo\r\nVenta de ropa y material de esquí y snowboard\r\nDistribuidor de la marca de bicicletas Cube"
    ]
  },
