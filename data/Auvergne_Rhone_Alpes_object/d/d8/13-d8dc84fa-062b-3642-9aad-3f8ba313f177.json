  "rdfs:comment": {
    "de": [
      "Marie und Phil gründeten die Distillerie du Bugey im Herzen von Saint-Martin-de-Bavel im Departement Ain, Maries Heimatdorf, in einem Gebäude mit starkem architektonischem Charakter."
    ],
    "en": [
      "Marie and Phil created the Distillerie du Bugey in the heart of Saint-Martin-de-Bavel in the Ain, Marie's home village, in a building with a strong architectural character."
    ],
    "it": [
      "Marie e Phil hanno creato la Distillerie du Bugey nel cuore di Saint-Martin-de-Bavel nell'Ain, il villaggio natale di Marie, in un edificio dal forte carattere architettonico.\r\nVenite a visitare questo luogo vivace dove si fondono produzione tradizionale, degustazione e passione!"
    ],
    "fr": [
      "Marie et Phil ont créé la Distillerie du Bugey au cœur de Saint-Martin-de-Bavel dans l’Ain, village natal de Marie, dans un bâtiment à fort cachet architectural.\r\nVenez visiter ce lieu vivant où production artisanale dégustation et passion se rencontrent !"
    ],
    "es": [
      "Marie y Phil crearon la Distillerie du Bugey en el corazón de Saint-Martin-de-Bavel, en el Ain, el pueblo natal de Marie, en un edificio de fuerte carácter arquitectónico.\r\nVenga a visitar este lugar lleno de vida donde se unen la producción tradicional, la degustación y la pasión"
    ],
    "nl": [
      "Marie en Phil hebben de Distillerie du Bugey opgericht in het hart van Saint-Martin-de-Bavel in de Ain, het geboortedorp van Marie, in een gebouw met een sterk architecturaal karakter.\r\nKom en bezoek deze levendige plek waar traditionele productie, proeven en passie samenkomen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Destillerie von Bugey"
    ],
    "en": [
      "La Distillerie du Bugey"
    ],
    "fr": [
      "La Distillerie du Bugey"
    ]
  },
