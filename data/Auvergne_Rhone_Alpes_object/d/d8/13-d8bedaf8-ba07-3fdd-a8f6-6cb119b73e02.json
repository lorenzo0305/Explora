  "rdfs:comment": {
    "de": [
      "Ma frère, der erste Spielfilm von Lise Akoka und Romane Gueret, erzählt die Geschichte von Shaï und Djeneba, zwei Teenagerinnen, zwischen denen sich alles unterscheidet. Ihre Begegnung während eines Theaterkurses bringt Wut, Solidarität und den Wunsch nach Emanzipation zum Vorschein."
    ],
    "en": [
      "Ma frère (My Brother), the first feature film by Lise Akoka and Romane Gueret, tells the story of Shaï and Djeneba, two teenagers who have nothing in common. Their meeting during a theater workshop gives rise to anger, solidarity and a desire for emancipation."
    ],
    "it": [
      "Ma frère (Mio fratello), primo lungometraggio di Lise Akoka e Romane Gueret, racconta la storia di Shaï e Djeneba, due adolescenti che non hanno nulla in comune. Quando si incontrano in un laboratorio teatrale, emergono la loro rabbia, la solidarietà e il desiderio di emancipazione."
    ],
    "fr": [
      "Ma frère, premier long métrage de Lise Akoka et Romane Gueret, raconte l’histoire de Shaï et Djeneba, deux adolescentes que tout oppose. Leur rencontre lors d’un stage de théâtre fait émerger colères, solidarités et désirs d’émancipation."
    ],
    "nl": [
      "Ma frère (Mijn Broer), de eerste speelfilm van Lise Akoka en Romane Gueret, vertelt het verhaal van Shaï en Djeneba, twee tienermeisjes die niets met elkaar gemeen hebben. Wanneer ze elkaar ontmoeten op een theaterworkshop, komen hun woede, solidariteit en verlangen naar emancipatie naar boven."
    ],
    "es": [
      "Ma frère (Mi hermano), el primer largometraje de Lise Akoka y Romane Gueret, cuenta la historia de Shaï y Djeneba, dos adolescentes que no tienen nada en común. Cuando se conocen en un taller de teatro, afloran su rabia, su solidaridad y su deseo de emancipación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cinéma \"Ma frère\""
    ]
  },
