  "rdfs:comment": {
    "de": [
      "Clermont Auvergne Volcans erstreckt sich von der Chaîne des Puys mit ihrem emblematischen Puy de Dôme über den Lac d'Aydat, das Plateau von Gergovie, den Kurort Royat Chamalières, Clermont und die Petites Cités de Caractères ® bis hin zu den Ufern des Allier."
    ],
    "en": [
      "Clermont Auvergne Volcans stretches from the Chaîne des Puys and its emblematic puy de Dôme to the banks of the Allier, via Lac d'Aydat, the Gergovie plateau, the Royat Chamalières spa, Clermont and the Petites Cités de Caractères ®."
    ],
    "it": [
      "Clermont Auvergne Volcans si estende dalla Chaîne des Puys e dal suo emblematico Puy de Dôme fino alle rive dell'Allier, passando per il lago Aydat, l'altopiano di Gergovie, le terme di Royat Chamalières, Clermont e le Petites Cités de Caractères®."
    ],
    "fr": [
      "Clermont Auvergne Volcans s'étend de la Chaîne des Puys et son emblématique puy de Dôme aux rives de l'Allier, en passant par le lac d'Aydat, le plateau de Gergovie, la station thermale de Royat Chamalières, Clermont et des Petites Cités de Caractères ®."
    ],
    "nl": [
      "Clermont Auvergne Volcans strekt zich uit van de Chaîne des Puys en zijn emblematische Puy de Dôme tot de oevers van de Allier, via het meer van Aydat, het plateau van Gergovie, het kuuroord Royat Chamalières, Clermont en de Petites Cités de Caractères ®."
    ],
    "es": [
      "Clermont Auvergne Volcans se extiende desde la Chaîne des Puys y su emblemático Puy de Dôme hasta las orillas del Allier, pasando por el lago de Aydat, la meseta de Gergovie, el balneario de Royat Chamalières, Clermont y las Petites Cités de Caractères ®."
    ]
  },
