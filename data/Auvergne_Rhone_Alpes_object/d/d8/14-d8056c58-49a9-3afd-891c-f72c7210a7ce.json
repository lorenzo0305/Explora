  "rdfs:comment": {
    "de": [
      "Im Rahmen der 27. Ausgabe von Polar Lens organisiert Lens Tourisme seine traditionelle Ermittlungsrallye. Das diesjährige Rätsel stammt aus der Feder der Krimiautorin Céline Ghys."
    ],
    "en": [
      "As part of the 27th edition of Polar Lens, Lens Tourisme is organizing its traditional rally-enquête. This year?s riddle comes from the pen of mystery writer Céline Ghys."
    ],
    "it": [
      "Nell'ambito del 27° festival Polar Lens, Lens Tourisme organizza il suo tradizionale raduno del mistero. Quest'anno l'enigma nasce dalla penna della scrittrice di gialli Céline Ghys."
    ],
    "fr": [
      "Dans le cadre de la 27e édition de Polar Lens, Lens Tourisme organise son traditionnel rallye-enquête. L’énigme proposée cette année est issue de la plume de l’autrice de polars Céline Ghys."
    ],
    "nl": [
      "In het kader van het 27e Polar Lens festival organiseert Lens Tourisme zijn traditionele mysterierally. Dit jaar komt het raadsel uit de pen van misdaadauteur Céline Ghys."
    ],
    "es": [
      "En el marco de la 27ª edición del festival Polar Lens, Lens Tourisme organiza su tradicional rally del misterio. El enigma de este año viene de la pluma de la escritora de novelas policíacas Céline Ghys."
    ]
  },
  "rdfs:label": {
    "fr": [
