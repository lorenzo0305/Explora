  "rdfs:comment": {
    "de": [
      "Naisseur-engraisseur von 80 Limousin-Kühen. Unsere Kühe werden mit Flachs, Heu und Futterrüben gefüttert. Verkauf von Kisten ab Hof auf Bestellung."
    ],
    "en": [
      "Fattener of 80 limousines. Our cows are fed flax, hay and fodder beets. Sales of farm boxes on order."
    ],
    "it": [
      "Un allevatore-ingrassatore con 80 vacche di razza Limousin. Le nostre mucche sono alimentate con lino, fieno e barbabietole da foraggio. Vendita di casse in azienda su ordinazione."
    ],
    "fr": [
      "Naisseur-engraisseur de 80 limousines. Nos vaches sont nourries au lin, foin et betteraves fouragères. Ventes de caissettes à la ferme sur commande."
    ],
    "nl": [
      "Wij zijn een veehouder met 80 Limousin koeien. Onze koeien worden gevoerd met vlas, hooi en voederbieten. Verkoop van kratten op de boerderij op bestelling."
    ],
    "es": [
      "Un granjero-engordador con 80 vacas Limousin. Nuestras vacas se alimentan de lino, heno y remolacha forrajera. Venta de cajas en la granja por encargo."
    ]
  },
  "rdfs:label": {
