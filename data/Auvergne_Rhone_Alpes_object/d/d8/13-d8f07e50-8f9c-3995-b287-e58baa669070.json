  "rdfs:comment": {
    "de": [
      "ABEILHA ist auf die Herstellung von gepresstem Honig und Bio-Honig in Bruchstücken spezialisiert."
    ],
    "en": [
      "ABEILHA specialises in the production of pressed honey and organic honeycomb honey."
    ],
    "it": [
      "ABEILHA è specializzata nella produzione di mieli biologici pressati e fermentati. Lavoriamo con apiari stanziali situati nei dipartimenti del Puy de Dôme, dell'Allier e della Creuse, ancora privilegiati per la loro flora."
    ],
    "fr": [
      "ABEILHA est spécialisé dans la production de miels pressés et miels en brèche BIO. Nous fonctionnons avec des ruchers sédentaires basés dans le Puy de Dôme, l’Allier et la Creuse, des départements encore privilégiés pour leur flore."
    ],
    "nl": [
      "ABEILHA is gespecialiseerd in de productie van biologische geperste en gebrouwen honing. We werken met sedentaire bijenstallen in de departementen Puy de Dôme, Allier en Creuse, die nog steeds geliefd zijn om hun flora."
    ],
    "es": [
      "ABEILHA está especializada en la producción de mieles ecológicas prensadas y fermentadas. Trabajamos con colmenares sedentarios situados en los departamentos de Puy de Dôme, Allier y Creuse, que siguen siendo privilegiados por su flora."
    ]
  },
