  "rdfs:comment": {
    "de": [
      "In den Gorges de la Sioule ist das Restaurant ein Ort wie kein anderer. Es ist ein Restaurant- und Bar-Konzertsaal rund um die Themen Motorräder und Musik. Seit 30 Jahren treten dort Bands auf und Biker aus ganz Europa treffen sich dort."
    ],
    "en": [
      "In the Gorges de la Sioule, the restaurant is a place like no other. It is a restaurant and bar concert hall around the themes of motorcycles and music. For 30 years, bands have been performing there and bikers from all over Europe meet there."
    ],
    "it": [
      "Ristorante e bar a tema motociclistico e musicale. Qui si tengono concerti da 30 anni. Qui si riuniscono motociclisti da tutta Europa. Solo su prenotazione, almeno 5 giorni prima."
    ],
    "fr": [
      "Restaurant et bar autour des thématiques moto et musique. Depuis 30 ans des concerts ont lieu ici. S'y rejoignent les motards de toute l'Europe. Sur réservation uniquement, au moins 5 jours avant."
    ],
    "es": [
      "Restaurante y bar de temática motera y musical. Aquí se celebran conciertos desde hace 30 años. Aquí se reúnen moteros de toda Europa. Sólo con reserva, al menos con 5 días de antelación."
    ],
    "nl": [
      "Restaurant en bar met een motor- en muziekthema. Hier worden al 30 jaar concerten gehouden. Motorrijders uit heel Europa komen hier samen. Alleen op reservering, minstens 5 dagen van tevoren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Camping Moto Route 99"
    ]
  },
