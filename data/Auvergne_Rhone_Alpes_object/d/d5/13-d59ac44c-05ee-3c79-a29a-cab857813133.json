  "rdfs:comment": {
    "de": [
      "/!\\/leer, Achtung, Bauarbeiten zwischen Uzer und Largentière/!\\/leer\r\nVia Ardèche, der sanfte Weg der Ardèche.\r\nDie Via Ardèche ist ein echtes Rückgrat für die Entdeckung der südlichen Ardèche und bietet bemerkenswerte Panoramen auf die Ebenen, den Fluss Ardèche und die Cevennen-Berge."
    ],
    "en": [
      "On foot or by bike, discover Via Ardèche®, the new greenway. From the recreation area of ​​Uzer, take advantage of an old railroad track developed as far as Grospierres via Vogüe."
    ],
    "it": [
      "/Attenzione, lavori stradali tra Uzer e Largentière/!\r\nVia Ardèche, la dolce via dell'Ardèche.\r\nLa Via Ardèche, spina dorsale dell'Ardèche meridionale, offre notevoli viste panoramiche sulle pianure, sul fiume Ardèche e sulle montagne di Cevennes."
    ],
    "fr": [
      "/!\\ Attention, travaux entre Uzer et Largentière/!\\ \r\nVia Ardèche, voie douce d'Ardèche.\r\nVéritable colonne vertébrale de découverte du sud Ardèche, Via Ardèche offre des panoramas remarquables sur les plaines, la rivière Ardèche et les montagnes cévenoles."
    ],
    "es": [
      "/Precaución, obras entre Uzer y Largentière\r\nVía Ardèche, el camino suave de Ardèche.\r\nEspina dorsal de la Ardèche meridional, la Via Ardèche ofrece vistas panorámicas notables sobre las llanuras, el río Ardèche y las montañas de Cevennes."
    ],
    "nl": [
      "/Let op, wegwerkzaamheden tussen Uzer en Largentière\r\nVia Ardèche, de zachte weg van de Ardèche.\r\nDe Via Ardèche is de ruggengraat van de zuidelijke Ardèche en biedt opmerkelijke panoramische uitzichten over de vlaktes, de rivier de Ardèche en de bergen van de Cevennen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Green Lane - Via Ardèche to Uzer"
    ],
    "fr": [
      "Voie verte - Via Ardèche à Uzer"
    ]
  },
