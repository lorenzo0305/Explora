      "dc:description": {
        "de": [
          "TEKNO-Abend\nSamstag, 25. Oktober von 19 Uhr bis 2 Uhr morgens\nOrt: La Maison des Faiseurs ? Montreuil\n----------------------------\nMit der Zusammenarbeit von Chaotik und Omahatek\n\nVerpflegung vor Ort - Bar vor Ort\nConfig Sound System\nGroßer kostenloser Parkplatz\nEintrittspreis: 3?\n\nTreffpunkt: 5 Place de la Gare\nKredit: La Maison des Faiseurs"
        ],
        "en": [
          "TEKNO Evening\nSaturday, October 25, 7pm to 2am\nLocation: La Maison des Faiseurs ? Montreuil\n----------------------------\nWith the collaboration of Chaotik and Omahatek\n\nCatering on site - Bar on site\nConfig sound system\nAmple free parking\nAdmission: 3?\n\nMeeting point: 5 Place de la Gare\nCredit: La Maison des Faiseurs"
        ],
        "it": [
          "Serata TEKNO\nSabato 25 ottobre dalle 19.00 alle 2.00\nLuogo: La Maison des Faiseurs? Montreuil\n----------------------------\nCon la collaborazione di Chaotik e Omahatek\n\nCatering in loco - Bar in loco\nSistema audio configurato\nAmpio parcheggio gratuito\nIngresso: 3?\n\nPunto d'incontro: 5 Place de la Gare\nCredito: La Maison des Faiseurs"
        ],
        "fr": [
          "Soirée TEKNO\nSamedi 25 octobre de 19h à 2h du matin\nLieu : La Maison des Faiseurs – Montreuil\n----------------------------\nAvec la collaboration de Chaotik et Omahatek\n\nRestauration sur place - Bar sur place\nConfig sound système\nGrand parking gratuit\nTarif :  3€ l’entrée\n\nRendez-vous : 5 Place de la Gare \nCrédit : La Maison des Faiseurs"
        ],
        "nl": [
          "TEKNO Avond\nZaterdag 25 oktober van 19u tot 2u\nPlaats: La Maison des Faiseurs ? Montreuil\n----------------------------\nMet de medewerking van Chaotik en Omahatek\n\nCatering ter plaatse - Bar ter plaatse\nConfiguratie geluidsinstallatie\nGrote gratis parking\nToegangsprijs: 3?\n\nTrefpunt: 5 Place de la Gare\nKrediet: La Maison des Faiseurs"
        ],
        "es": [
          "Noche TEKNO\nSábado 25 de octubre de 19:00 a 02:00\nLugar: La Maison des Faiseurs ? Montreuil\n----------------------------\nCon la colaboración de Chaotik y Omahatek\n\nCatering in situ - Bar in situ\nSistema de sonido configurado\nAmplio aparcamiento gratuito\nEntrada: 3?\n\nPunto de encuentro: 5 Place de la Gare\nCrédito: La Maison des Faiseurs"
        ]
      },
