  "rdfs:comment": {
    "de": [
      "Die 1841 wieder aufgebaute Halle von Mens liegt im Herzen des Dorfes und beherbergt heute den Wochenmarkt sowie die verschiedenen Veranstaltungen des Dorfes Mens."
    ],
    "en": [
      "Rebuilt in 1841, the Halle de Mens, located in the heart of the village, now houses the weekly market and the various events of the village of Mens."
    ],
    "it": [
      "Ricostruita nel 1841, la Halle de Mens, situata nel cuore del villaggio, ospita oggi il mercato settimanale e i vari eventi del villaggio di Mens."
    ],
    "fr": [
      "Reconstruite en 1841, la Halle de Mens, située au coeur du village, abrite aujourd'hui le marché hebdomadaire, et les différentes manifestations du village de Mens."
    ],
    "es": [
      "Reconstruida en 1841, la Halle de Mens, situada en el corazón del pueblo, alberga actualmente el mercado semanal y los diversos eventos del pueblo de Mens."
    ],
    "nl": [
      "De in 1841 herbouwde Halle de Mens, gelegen in het hart van het dorp, herbergt nu de wekelijkse markt en de verschillende evenementen van het dorp Mens."
    ]
  },
