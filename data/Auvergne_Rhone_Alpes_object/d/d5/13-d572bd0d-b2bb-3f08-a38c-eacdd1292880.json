  "rdfs:comment": {
    "de": [
      "Lydie, Keramikkünstlerin und Kunsthandwerkerin, schafft symbolische Skulpturen, die das Herz der Emotionen berühren..... Entdecken Sie ihre Skulpturen in ihrem Atelier. Besichtigung des Ateliers nach Vereinbarung. Verkauf ihrer Werke."
    ],
    "en": [
      "Ceramic artist and Artisan d'Art, Lydie creates symbolic sculptures that touch the heart of emotions.... Come and discover her sculptures in her studio. Studio visit by appointment. Sale of her works."
    ],
    "it": [
      "Artista della ceramica e Artigiana d'Arte, Lydie crea sculture simboliche che toccano il cuore delle emozioni.... Venite a scoprire le sue sculture nel suo studio. Visite all'atelier su appuntamento. Vendita delle sue opere."
    ],
    "fr": [
      "Artiste céramiste et Artisan d'Art., Lydie crée des sculptures symboliques qui viennent toucher au cœur des émotions.... Venez découvrir ses sculptures dans son atelier. Visite de l'atelier sur rendez-vous. Vente de ses oeuvres."
    ],
    "nl": [
      "Keramisch kunstenares en Artisan d'Art, Lydie creëert symbolische sculpturen die het hart van emoties raken .... Kom haar sculpturen ontdekken in haar atelier. Bezoek aan het atelier op afspraak. Verkoop van haar werk."
    ],
    "es": [
      "Ceramista y Artisan d'Art, Lydie crea esculturas simbólicas que tocan el corazón de las emociones.... Venga a descubrir sus esculturas en su taller. Visitas al taller con cita previa. Venta de sus obras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lydie Thonnerieux - Céramiste"
    ]
  },
