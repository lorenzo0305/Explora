  "rdfs:comment": {
    "de": [
      "Kochen mit natürlichen und lokalen Produkten, würzige, süße, duftende und schmackhafte Gerichte. Lokale,regionale Produkte und hausgemachte Getränke."
    ],
    "en": [
      "Cuisine based on local, natural products. Spicy, mild and deliciously flavoured dishes. Local, regional products and traditional beverages."
    ],
    "it": [
      "Ogni giorno, Laëtitia prepara un menu a base di prodotti locali, freschi e diversi per ogni portata. La nostra tavola è una passeggiata sulla quale tracciamo dei percorsi gustativi, tenendo conto delle vostre specificità."
    ],
    "fr": [
      "Chaque jour, Laëtitia vous mijote un menu de produits de Pays, frais et différent à chaque service. Notre table est une balade sur laquelle nous balisons quelques sentiers gustatifs, tenant compte de vos spécificités."
    ],
    "nl": [
      "Laëtitia kookt elke dag een menu van lokale producten, vers en verschillend voor elke gang. Onze tafel is een wandeling waarop we enkele smaakpaden uitstippelen, rekening houdend met uw specifieke kenmerken."
    ],
    "es": [
      "Cada día, Laëtitia prepara un menú a base de productos locales, frescos y diferentes para cada plato. Nuestra mesa es un paseo en el que marcamos unos caminos gustativos, teniendo en cuenta sus especificidades."
    ]
  },
