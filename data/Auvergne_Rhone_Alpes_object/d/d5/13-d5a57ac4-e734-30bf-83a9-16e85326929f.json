  "rdfs:comment": {
    "de": [
      "Verleih von Skiern, Snowboards, AE-Mountainbikes im Sommer, Babytragen, 4x4-Kinderwagen.\r\nReparatur und Wartung aller Arten von Fahrrädern. Verkauf von Streetwear-Artikeln (Picture Organic Clothing), Fahrradmaterial (Trek, Giant, Scott, Rocky Mountain, Commençal..)."
    ],
    "en": [
      "Ski rental, snowboard, mountain bike AE in summer, baby carrier, 4x4 stroller.\r\nRepair and maintenance of all types of bicycles. Sale of streetwear (Picture Organic Clothing), bicycle equipment (Trek, Giant, Scott, Rocky Mountain, Commençal..)."
    ],
    "it": [
      "Noleggio di sci, snowboard, mountain bike AE in estate, marsupi, passeggini 4x4.\r\nRiparazione e manutenzione di tutti i tipi di biciclette. Vendita di abbigliamento da strada (Picture Organic Clothing), attrezzatura da ciclismo (Trek, Giant, Scott, Rocky Mountain, Commençal...)."
    ],
    "fr": [
      "Location de ski, snowboard, de VTT AE l'été, porte-bébé, poussette 4x4.\r\nRéparation et entretien de tous types de vélos. Vente d'articles streetwear (Picture Organic Clothing), matériel de vélo (Trek, Giant, Scott, Rocky Mountain, Commençal..)."
    ],
    "nl": [
      "Verhuur van ski's, snowboards, AE mountainbikes in de zomer, babydragers, 4x4 kinderwagens.\r\nReparatie en onderhoud van alle soorten fietsen. Verkoop van streetwear (Picture Organic Clothing), fietsmateriaal (Trek, Giant, Scott, Rocky Mountain, Commençal...)."
    ],
    "es": [
      "Alquiler de esquí, snowboard, bicicleta de montaña AE en verano, portabebés, cochecito 4x4.\r\nReparación y mantenimiento de todo tipo de bicicletas. Venta de artículos streetwear (Picture Organic Clothing), material de bicicleta."
    ]
  },
