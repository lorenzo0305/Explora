  "rdfs:comment": {
    "de": [
      "Schuhe, die zu 100% in Romans hergestellt werden.\r\nKreation von Modellen auch auf Anfrage und nach Maß.\r\nBietet Workshops für Kinder (Kreationen von Schlüsselanhängern für Schuhe) und Erwachsene (Kreationen von Sandalen oder Turnschuhen) an.\r\nLabel \"Véritable Chaussure de Romans\" (Echter Schuh aus Romans)."
    ],
    "en": [
      "Shoes 100% made in Romans\r\nDesigns also available on request and made-to-measure.\r\nOffers workshops for children (creation of shoe key rings) and adults (creation of sandals or sneakers).\r\nVéritable Chaussure de Romans label."
    ],
    "it": [
      "Scarpe 100% made in Romans\r\nDisegni disponibili anche su richiesta e su misura.\r\nOffre laboratori per bambini (creazione di portachiavi) e adulti (creazione di sandali o scarpe da ginnastica).\r\nMarchio Véritable Chaussure de Romans."
    ],
    "fr": [
      "Chaussures 100% fabriquées à Romans\r\nCréation de modèles également à la demande et sur mesure.\r\nPropose des ateliers pour enfants( créations porte clé chaussure) et adultes (création sandale ou basket).\r\nLabel Véritable Chaussure de Romans."
    ],
    "es": [
      "Zapatos 100% fabricados en Roma\r\nDiseños disponibles por encargo y a medida.\r\nTalleres para niños (creación de llaveros) y adultos (creación de sandalias o zapatillas).\r\nEtiqueta Véritable Chaussure de Romans."
    ],
    "nl": [
      "Schoenen 100% gemaakt in Rome\r\nOok ontwerpen op aanvraag en op maat.\r\nBiedt workshops aan voor kinderen (sleutelhanger maken) en volwassenen (sandaal of trainer maken).\r\nLabel Véritable Chaussure de Romans."
    ]
  },
