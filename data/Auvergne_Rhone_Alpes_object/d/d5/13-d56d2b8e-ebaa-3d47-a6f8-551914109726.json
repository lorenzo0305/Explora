  "rdfs:comment": {
    "de": [
      "Les petites coutures de G-LO bietet Ihnen 100% biologische und handgefertigte Produkte. Alle Kreationen werden vollständig aus Bio-Baumwolle hergestellt, um Ihnen qualitativ hochwertige Produkte zu fertigen."
    ],
    "en": [
      "Les petites coutures de G-LO offers you 100% organic, hand-crafted products. All our creations are made entirely from organic cotton, to ensure the highest quality."
    ],
    "it": [
      "Les petites coutures de G-LO vi offre prodotti 100% biologici e fatti a mano. Tutte le nostre creazioni sono realizzate interamente in cotone biologico, per garantirvi prodotti di qualità."
    ],
    "fr": [
      "Les petites coutures de G-LO vous propose des produits 100% bio et artisanaux. Toutes les créations sont entièrement réalisées avec du coton bio afin de vous confectionner des produits de qualité."
    ],
    "es": [
      "Les petites coutures de G-LO le ofrece productos 100% ecológicos y hechos a mano. Todas nuestras creaciones están elaboradas íntegramente con algodón orgánico, para garantizarle productos de calidad."
    ],
    "nl": [
      "Les petites coutures de G-LO biedt je 100% biologische en handgemaakte producten. Al onze creaties zijn volledig gemaakt van biologisch katoen, zodat je verzekerd bent van kwaliteitsproducten."
    ]
  },
