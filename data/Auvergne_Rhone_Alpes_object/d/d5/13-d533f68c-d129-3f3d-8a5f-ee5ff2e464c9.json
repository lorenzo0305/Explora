  "rdfs:comment": {
    "de": [
      "Die 1888 erbaute und 2004 restaurierte Kirche ist Johannes dem Täufer geweiht. Sie ersetzt eine mittelalterliche Kirche, die an derselben Stelle stand."
    ],
    "en": [
      "Built in 1888 and restored in 2004, the church is dedicated to Saint-Jean-Baptiste. It replaces a medieval church that stood on the same site."
    ],
    "it": [
      "Costruita nel 1888 e restaurata nel 2004, la chiesa è dedicata a Saint-Jean-Baptiste. Sostituisce una chiesa medievale che sorgeva nello stesso luogo."
    ],
    "fr": [
      "L’église construite en 1888 et restaurée en 2004, est dédiée à Saint-Jean-Baptiste. Elle remplace une église médiévale qui s’élevait au même emplacement."
    ],
    "nl": [
      "De kerk werd gebouwd in 1888 en gerestaureerd in 2004 en is gewijd aan Saint-Jean-Baptiste. Ze vervangt een middeleeuwse kerk die op dezelfde plaats stond."
    ],
    "es": [
      "Construida en 1888 y restaurada en 2004, la iglesia está dedicada a San Juan Bautista. Sustituye a una iglesia medieval situada en el mismo lugar."
    ]
  },
  "rdfs:label": {
