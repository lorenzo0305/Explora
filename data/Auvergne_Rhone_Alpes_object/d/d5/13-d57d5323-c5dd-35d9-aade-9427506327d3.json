  "rdfs:comment": {
    "de": [
      "Im Wintersportgebiet La Côte d'Aime-Valezan werden im Winter Nordic Walking-Routen gespurt und markiert.\r\nGenießen Sie das sonnige Panorama des Isère-Tals gegenüber den Gipfeln der Vanoise."
    ],
    "en": [
      "In the winter activity area at La Côte d'Aime-Valezan, nordic trails are groomed and marked in winter.\r\nCome and enjoy this sunny environment with its panoramic views over the Isère valley and to the peaks of the Vanoise."
    ],
    "it": [
      "Nell'area invernale di La Côte d'Aime-Valezan, gli itinerari nordici sono battuti e tracciati in inverno.\r\nVenite a godervi questo ambiente panoramico e soleggiato sulla Valle dell'Isère, di fronte alle cime della Vanoise."
    ],
    "fr": [
      "Sur l'espace hivernal de La Côte d'Aime-Valezan, des itinéraires nordiques sont damées et balisées l'hiver.\r\nVenez profiter de cet environnement panoramique et ensoleillé sur la Vallée de l’Isère face aux sommets de la Vanoise."
    ],
    "nl": [
      "In het wintergebied van La Côte d'Aime-Valezan worden in de winter nordic routes geprepareerd en bewegwijzerd.\r\nKom genieten van deze panoramische, zonnige omgeving met uitzicht op de Isère-vallei en de toppen van de Vanoise."
    ],
    "es": [
      "En la zona invernal de La Côte d'Aime-Valezan, los itinerarios nórdicos están preparados y señalizados en invierno.\r\nVenga a disfrutar de este entorno panorámico y soleado en el valle del Isère frente a las cumbres de la Vanoise."
    ]
  },
  "rdfs:label": {
    "en": [
      "Nordic trails La Côte d'Aime Valezan"
    ],
    "fr": [
      "Itinéraires nordiques La Côte d'Aime Valezan"
    ],
    "nl": [
      "Noordse routes La Côte d'Aime Valezan"
    ]
  },
