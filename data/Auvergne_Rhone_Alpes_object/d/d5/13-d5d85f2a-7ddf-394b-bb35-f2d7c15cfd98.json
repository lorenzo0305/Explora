  "rdfs:comment": {
    "de": [
      "NM3-Basketballspiel in Grenoble: Unterstützen Sie die Herrenmannschaft von Grenoble Basket 38 bei einem Spiel der nationalen Meisterschaft. Gesellige Atmosphäre, Animationen und Getränke vor Ort."
    ],
    "en": [
      "NM3 basketball match in Grenoble: come and support the Grenoble Basket 38 men?s team in a national championship match. Friendly atmosphere, entertainment and refreshments on site."
    ],
    "it": [
      "Partita di basket NM3 a Grenoble: venite a sostenere la squadra maschile del Grenoble Basket 38 in una partita del campionato nazionale. Atmosfera amichevole, intrattenimento e rinfreschi in loco."
    ],
    "fr": [
      "Match de basket NM3 à Grenoble : venez soutenir l’équipe masculine du Grenoble Basket 38 lors d’une rencontre de championnat national. Ambiance conviviale, animations et buvette sur place."
    ],
    "es": [
      "Partido de baloncesto NM3 en Grenoble: venga a apoyar al equipo masculino Grenoble Basket 38 en un partido del campeonato nacional. Ambiente agradable, animación y refrescos in situ."
    ],
    "nl": [
      "NM3 basketbalwedstrijd in Grenoble: kom en steun het Grenoble Basket 38 herenteam in een nationale kampioenswedstrijd. Gezellige sfeer, entertainment en drankjes ter plaatse."
    ]
  },
