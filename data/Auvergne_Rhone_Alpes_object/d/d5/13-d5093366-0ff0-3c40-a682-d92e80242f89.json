  "rdfs:comment": {
    "de": [
      "Der Sessellift von Mossettes ermöglicht den Zugang zum Pointe des Mossettes mit seinem Panoramablick und zum Schweizer Ferienort Les Crosets., Zugänglich für Mountainbikes (nur Aufstieg) und Fußgänger (Auf- und Abstieg)"
    ],
    "en": [
      "The Mossettes chairlift provides access to the Pointe des Mossettes and its panoramic view, and to the Swiss resort of Les Crosets. It is accessible to mountain bikes (ascent only) and pedestrians (ascent and descent)."
    ],
    "it": [
      "La seggiovia Mossettes consente di accedere alla Pointe des Mossettes, con le sue viste panoramiche, e alla località svizzera di Les Crosets, accessibile alle mountain bike (solo salita) e ai pedoni (salita e discesa)"
    ],
    "fr": [
      "Le télésiège des Mossettes permet d'accéder à la Pointe des Mossettes et sa vue panoramique et à la station Suisse des Crosets., Accessible aux vtt (uniquement pour la montée) et aux piétons (montée et descente)"
    ],
    "es": [
      "El telesilla de Mossettes da acceso a la Pointe des Mossettes, con sus vistas panorámicas, y a la estación suiza de Les Crosets, accesible para bicicletas de montaña (sólo subida) y peatones (subida y bajada)"
    ],
    "nl": [
      "De stoeltjeslift Mossettes biedt toegang tot de Pointe des Mossettes met panoramisch uitzicht en tot het Zwitserse skioord Les Crosets, toegankelijk voor mountainbikes (alleen beklimming) en voetgangers (beklimming en afdaling)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Mossettes France chairlifts"
    ],
    "fr": [
      "Télésiège des Mossettes"
    ]
  },
