  "rdfs:comment": {
    "de": [
      "Als Keller und Afterwork-Bierbar bietet Oh! Mouss'Aillons auch Animationen wie Themenabende, Konzerte und die Übertragung von Sportereignissen auf Großbildleinwand. Auf der Speisekarte: hausgemachte Cocktails, Burger/Pommes frites, Tagesmenü, Tapas-Platten."
    ],
    "en": [
      "Oh! Mouss'Aillons is a cellar and beer bar for after-work parties, as well as offering events such as themed evenings, concerts and sports broadcasts on giant screens. On the menu: house cocktails, burger/fries, menu of the day, tapas platters."
    ],
    "it": [
      "Il Mouss'Aillons è una cantina e una birreria per feste dopo il lavoro, oltre a proporre eventi come serate a tema, concerti e trasmissioni sportive su schermi giganti. Il menu: cocktail della casa, hamburger e patatine fritte, menu del giorno, taglieri di tapas."
    ],
    "fr": [
      "Cave et bar à bières en afterwork, Oh ! Mouss'Aillons propose aussi des animations comme les soirées à thème, les concerts et la diffusion d'évènements sportifs sur écran géant. Au menu : cocktails maison, burger/frites, menu du jour, planches tapas."
    ],
    "nl": [
      "Oh! Mouss'Aillons is een kelder- en bierbar voor after-work parties, maar biedt ook evenementen zoals thema-avonden, concerten en sportuitzendingen op gigantische schermen. Op het menu: huiscocktails, hamburger/frietjes, dagmenu, tapasschotels."
    ],
    "es": [
      "Oh! Mouss'Aillons es una bodega y cervecería para fiestas después del trabajo, además de ofrecer eventos como noches temáticas, conciertos y retransmisiones deportivas en pantallas gigantes. En la carta: cócteles de la casa, hamburguesas y patatas fritas, menú del día y tapas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Oh ! Mouss'Aillons"
    ],
    "fr": [
      "Oh ! Mouss'Aillons"
    ]
  },
