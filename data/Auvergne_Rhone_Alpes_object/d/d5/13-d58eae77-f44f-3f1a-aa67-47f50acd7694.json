  "rdfs:comment": {
    "de": [
      "Air Jey' Filets ist eine riesige Spielwelt inmitten der Natur für die ganze Familie: Hochsitzhütten, hängende Netze, Rutschen, Air Jump und Panda Warrior-Herausforderungen. Ein spielerischer, sicherer und generationenübergreifender Park. Wasserbereich im Juli/August."
    ],
    "en": [
      "Air Jey' Filets is a vast universe of outdoor games for the whole family: perched huts, suspended nets, slides, Air Jump and Panda Warrior challenges. A safe, fun park for all generations. Aquatic zone in July/August."
    ],
    "it": [
      "A Ruoms, alle porte delle Gole dell'Ardèche, Air Jey? Filets è un vasto mondo di giochi all'aperto: capanne arroccate, reti sospese, scivoli, sfide AirJump e Panda Warrior. Un parco divertente e adatto a tutte le generazioni. Zona acquatica in estate"
    ],
    "fr": [
      "À Ruoms, aux portes des Gorges de l’Ardèche, Air Jey’ Filets est un vaste univers de jeux en pleine nature : cabanes perchées, filets suspendus, toboggans, AirJump et défis Panda Warrior. Parc ludique, familial et intergénérationnel. Zone aquatique en été"
    ],
    "es": [
      "En Ruoms, a las puertas de las gargantas del Ardèche, Air Jey? Filets es un vasto mundo de juegos al aire libre: cabañas encaramadas, redes suspendidas, toboganes, AirJump y desafíos Panda Warrior. Un parque lúdico y familiar para todas las generaciones. Zona acuática en verano"
    ],
    "nl": [
      "Air Jey' Filets is een uitgestrekt universum van buitenspelen voor het hele gezin: hangende hutten, hangende netten, glijbanen, Air Jump en Panda Warrior-uitdagingen. Een leuk en veilig park voor alle generaties. Waterpark in juli en augustus."
    ]
  },
