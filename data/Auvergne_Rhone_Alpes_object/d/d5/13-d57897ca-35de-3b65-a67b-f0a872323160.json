  "rdfs:comment": {
    "de": [
      "Imkerei in Warré-Bienenstöcken mit Bio-Zertifizierung.\nProdukte aus dem Bienenstock, Honig, frischer Pollen, schwarzer Nougat und Lebkuchen.\nVerkauf im Honigraum am Mittwochnachmittag von 14 bis 18 Uhr oder nach Vereinbarung."
    ],
    "en": [
      "Beekeeping with certified organic Warré hives\nHive products, honeys, fresh pollen, black nougat and gingerbread.\nSales at the honey house on Wednesday afternoons from 2pm to 6pm, or by appointment."
    ],
    "it": [
      "Apicoltura con arnie Warré certificate biologiche\n\nMieli di fiori di Chartreuse, Foret de Chartreuse e Lavanda\nPolline fresco, cera per cosmetici\n\nVendita presso la casa del miele il mercoledì pomeriggio dalle 14.00 alle 18.00 o su appuntamento."
    ],
    "fr": [
      "Apiculture en ruche Warré certifiée Bio\n\nMiels de fleurs de Chartreuse, Foret de Chartreuse et Lavande\nPollen frais, cire pour cosmétiques\n\nVente à la miellerie les mercredi après-midi de 14h à 18h ou sur rendez-vous."
    ],
    "nl": [
      "Bijenteelt met gecertificeerde biologische bijenkasten van Warré\n\nChartreuse, Foret de Chartreuse en lavendelbloemenhoning\nVers stuifmeel, was voor cosmetica\n\nVerkoop in het honinghuis op woensdagnamiddag van 14u tot 18u of op afspraak."
    ],
    "es": [
      "Apicultura con colmenas Warré ecológicas certificadas\nProductos de la colmena, mieles, polen fresco, turrón negro y pan de especias\nVenta en la casa de la miel los miércoles por la tarde de 14:00 a 18:00 o con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Miellerie du Peuple Zélé"
    ]
  },
