  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist ein Ort, der es jedem ermöglicht, sich zu informieren, sich weiterzubilden, sich zu entfalten, andere zu treffen, Güter und Know-how zu teilen."
    ],
    "en": [
      "The library is a resource place that allows everyone to be informed, to learn, to develop, to meet others, to share goods and know-how."
    ],
    "it": [
      "La biblioteca è un centro di risorse dove le persone possono trovare informazioni, imparare, svilupparsi, incontrare altri e condividere beni e know-how."
    ],
    "fr": [
      "La bibliothèque est un lieu ressource qui permet à chacun de s’informer, se former, de s’épanouir, de rencontrer l’autre,  de partager des biens, des savoirs faire."
    ],
    "es": [
      "La biblioteca es un centro de recursos donde las personas pueden encontrar información, aprender, desarrollarse, conocer a otras y compartir bienes y conocimientos."
    ],
    "nl": [
      "De bibliotheek is een informatiecentrum waar mensen informatie kunnen vinden, kunnen leren, zich kunnen ontwikkelen, anderen kunnen ontmoeten en goederen en knowhow kunnen delen."
    ]
  },
