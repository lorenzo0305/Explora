  "rdfs:comment": {
    "de": [
      "Eine Bar, eine einzigartige Atmosphäre!\r\n\r\nSeit Weihnachten 2012 hat das Bellevue seine brandneue Bar unter freiem Himmel eingeweiht: das Aprèski! Das Konzept stammt von der festlichen Stimmung in den großen österreichischen Skiorten während der alpinen Skiweltcups."
    ],
    "ru": [
      "Бар с уникальной атмосферой!\r\nНа Рождество 2012 года ресторан «Бельвю» открыл новый бар под открытым небом: L'AprèSki! В основе идеи этого бара — праздничная атмосфера, царящая на известных австрийских курортах в периоды проведения этапов Кубков мира по горнолыжному спорту."
    ],
    "en": [
      "A bar with a unique atmosphere!\r\n\r\nSince Christmas 2012, the Bellevue has inaugurated its brand new open-air bar: the Aprèski! The concept comes from the festive atmosphere of the major Austrian resorts during the Alpine Ski World Cups."
    ],
    "it": [
      "Un bar dall'atmosfera unica!\r\n\r\nDa Natale 2012, il Bellevue ha inaugurato il suo nuovissimo bar all'aperto: l'Aprèski! Il concetto nasce dall'atmosfera festosa delle grandi stazioni sciistiche austriache durante la Coppa del Mondo di sci alpino."
    ],
    "fr": [
      "Un bar, une ambiance unique !\r\n\r\nDepuis Noël 2012, le Bellevue a inauguré son tout nouveau bar à ciel ouvert : l’Aprèski ! Le concept vient de l’ambiance festive des grandes stations autrichiennes lors des Coupes du Monde de ski alpin."
    ],
    "es": [
      "¡Un bar con un ambiente único!\r\n\r\n¡Desde la Navidad de 2012, el Bellevue ha inaugurado su flamante bar al aire libre: el Aprèski! El concepto proviene del ambiente festivo de las grandes estaciones de esquí austriacas durante la Copa del Mundo de esquí alpino."
    ],
    "nl": [
      "Een bar met een unieke sfeer!\r\n\r\nLe Bellevue heeft sinds de Kerst van 2012 een geheel nieuwe bar in de buitenlucht: l’Aprèski! Het concept komt van de feestelijke sfeer in de belangrijkste Oostenrijkse skioorden tijdens de Wereldkampioenschappen Alpine Skiën."
    ]
  },
