  "rdfs:comment": {
    "de": [
      "Restaurant, das eine kreative Küche mit frischen und lokalen Gerichten sowie eine gepflegte Weinkarte anbietet. Unser Lokal besteht aus zwei Sälen (einer davon mit Gewölbedecke) und einer schattigen Terrasse mit Panoramablick auf die 3 Becs."
    ],
    "en": [
      "Restaurant offering creative cuisine with fresh, local dishes and a carefully-crafted wine list. Our restaurant has two dining rooms (one vaulted) and a shaded terrace with panoramic views of the 3 Becs."
    ],
    "it": [
      "Ristorante che offre una cucina creativa con piatti freschi e locali e una carta dei vini curata. Il nostro ristorante dispone di due sale da pranzo (di cui una a volta) e di una terrazza ombreggiata con vista panoramica sulle 3 Bec."
    ],
    "fr": [
      "Restaurant proposant une cuisine créative avec des mets frais et locaux ainsi qu’une carte des vins soignée. Notre établissement est composé de deux salles (dont une voûtée) et d’une terrasse ombragée avec vue panoramique sur les 3 Becs."
    ],
    "es": [
      "Restaurante que ofrece una cocina creativa con platos frescos y locales y una cuidada carta de vinos. Nuestro restaurante cuenta con dos comedores (uno de ellos abovedado) y una terraza sombreada con vistas panorámicas a los 3 Becs."
    ],
    "nl": [
      "Restaurant met een creatieve keuken met verse, lokale gerechten en een zorgvuldig samengestelde wijnkaart. Ons restaurant heeft twee eetzalen (waarvan één gewelfd) en een schaduwrijk terras met een panoramisch uitzicht op de 3 Becs."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge restaurant de Mathu"
    ]
  },
