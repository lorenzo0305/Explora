  "rdfs:comment": {
    "de": [
      "Sie lieben Honig auf Ihrem Butterbrot? Dann holen Sie ihn sich bei Pascale!\nSie öffnet ihre Türen für Sie!"
    ],
    "en": [
      "If you like honey on your toast, come and get it from Pascale!\nShe opens her doors to you!"
    ],
    "it": [
      "Se vi piace il miele sul pane tostato, venite a prenderlo da Pascale!\nSarà lieta di aprirvi le sue porte!"
    ],
    "fr": [
      "Vous aimez le miel sur vos tartines, venez le chercher chez Pascale !\nElle vous ouvre ses portes !"
    ],
    "es": [
      "Si le gusta la miel en las tostadas, venga a buscarla a Pascale\nEstará encantada de abrirle sus puertas"
    ],
    "nl": [
      "Als je van honing op je toast houdt, kom het dan halen bij Pascale!\nZe zal met plezier haar deuren voor je openen!"
    ]
  },
