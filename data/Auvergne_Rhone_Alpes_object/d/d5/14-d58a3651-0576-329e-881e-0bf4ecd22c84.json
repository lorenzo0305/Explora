      "dc:description": {
        "de": [
          "Der Verein Vivre à Neuville hat zum Ziel, verschiedene Aktivitäten und Veranstaltungen zu organisieren (bürgerschaftlich, gesellig, künstlerisch, kulturell, sportlich, festlich, ...)"
        ],
        "en": [
          "The association Vivre à Neuville aims to organize various activities and events (citizen, friendly, artistic, cultural, sports, festive, ...)"
        ],
        "it": [
          "L'associazione Vivre à Neuville si propone di organizzare varie attività ed eventi (cittadini, conviviali, artistici, culturali, sportivi, di festa, ecc.)"
        ],
        "fr": [
          "L'association Vivre à Neuville à pour but  d'organiser des activités et manifestations diverses (citoyennes, conviviales,  artistiques, culturelles, sportives, festives,...)"
        ],
        "es": [
          "La asociación Vivre à Neuville tiene como objetivo organizar diversas actividades y eventos (ciudadanos, de convivencia, artísticos, culturales, deportivos, festivos, etc.)"
        ],
        "nl": [
          "De vereniging Vivre à Neuville wil verschillende activiteiten en evenementen organiseren (burgerlijk, gezellig, artistiek, cultureel, sportief, feestelijk, ...)"
        ]
