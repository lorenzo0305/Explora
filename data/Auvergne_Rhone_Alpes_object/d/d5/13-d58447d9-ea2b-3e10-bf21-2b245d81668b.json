  "rdfs:comment": {
    "de": [
      "Unser Restaurant in Clermont-Ferrand lebt im Rhythmus seines Mottos: \"Essen (gut), Lieben (viel)\".\r\nDieses Versprechen lösen wir im Herzen der Stadt ein."
    ],
    "en": [
      "Our restaurant in Clermont-Ferrand lives by its motto: \"Manger (bon), Aimer (beaucoup)\".\r\nIt's a promise we keep, in the heart of the city."
    ],
    "it": [
      "Il nostro ristorante di Clermont-Ferrand vive secondo il suo motto: \"Manger (bon), Aimer (beaucoup)\".\r\nÈ una promessa che manteniamo, nel cuore della città."
    ],
    "fr": [
      "Notre restaurant à Clermont-Ferrand vit au rythme de sa devise : « Manger (bon), Aimer (beaucoup) ». \r\nC’est une promesse que nous tenons, au cœur de la ville."
    ],
    "nl": [
      "Ons restaurant in Clermont-Ferrand leeft volgens zijn motto: \"Manger (bon), Aimer (beaucoup)\".\r\nHet is een belofte die we nakomen, in het hart van de stad."
    ],
    "es": [
      "Nuestro restaurante de Clermont-Ferrand vive según su lema: \"Manger (bon), Aimer (beaucoup)\".\r\nEs una promesa que cumplimos, en el corazón de la ciudad."
    ]
  },
  "rdfs:label": {
