      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag von 6:00 bis 19:00 Uhr.\n\nBestellungen:\n\nKontaktieren Sie den Laden per Telefon unter 03 21 51 11 06\n\n\n\n\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday, 6am to 7pm.\n\nOrders :\n\nContact the store by telephone on 03 21 51 11 06\n\n\n\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al sabato dalle 6.00 alle 19.00.\n\nOrdini :\n\nContattare il negozio per telefono al numero 03 21 51 11 06\n\n\n\n\n\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu lundi au samedi de 6h à 19h.\n\nCommandes :\n\nContacter le magasin par téléphone au 03 21 51 11 06\n\n\n\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag van 6 tot 19 uur.\n\nBestellingen :\n\nNeem telefonisch contact op met de winkel op 03 21 51 11 06\n\n\n\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado de 6h a 19h.\n\nPedidos :\n\nPóngase en contacto con la tienda por teléfono en el 03 21 51 11 06\n\n\n\n\n\n\n "
