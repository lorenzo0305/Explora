  "rdfs:comment": {
    "de": [
      "Solo oder in einer Gruppe von bis zu vier Skifahrern können Sie die Steilkurven, Woops, Buckel und engen Kurven des Expertenparcours bewältigen"
    ],
    "en": [
      "Alone or in a group of up to four spatula enthusiasts, measure yourself against the banked turns, woops, bumps and tight curves of the expert course!"
    ],
    "it": [
      "Da soli o in un gruppo di massimo quattro appassionati di skateboard, affrontate le curve ripide, i woops, i bumps e le curve strette del percorso per esperti!"
    ],
    "fr": [
      "En solo ou en groupe jusqu'à quatre énervés de la spatule, mesurez-vous aux virages relevés, woops, bosses et courbes serrées du parcours expert !"
    ],
    "es": [
      "Solo o en un grupo de hasta cuatro entusiastas del monopatín, enfréntate a los giros pronunciados, los woops, los baches y las curvas cerradas del circuito para expertos"
    ],
    "nl": [
      "Alleen of in een groep van maximaal vier skateboarders, neem de steile bochten, woops, hobbels en scherpe bochten van het expertparcours op je!"
    ]
  },
