  "rdfs:comment": {
    "de": [
      "Ein brandneues Klettergebiet in voller Expansion...\r\nGroße Wand, die sich für das sogenannte \"moderne\" Klettern eignet. Ein einfacher Zugangsweg, guter Fels, zuverlässige und reichlich vorhandene Ausrüstung! Bereits fast 55 Seillängen von 5c bis 7a warten auf Sie."
    ],
    "en": [
      "A brand new climbing site in full expansion\r\nA great wall for the climbing calle \"modern\". An easy acces way, great rock, a trustful equipment. Already near to 55 lenghts from 5c to 7a await you."
    ],
    "it": [
      "Un nuovo sito di arrampicata in espansione...\r\nUna grande parete ideale per l'arrampicata moderna. Facile accesso, ottima roccia, attrezzatura affidabile e abbondante! Vi aspettano già quasi 55 tiri dal 5c al 7a vi aspettano."
    ],
    "fr": [
      "Un tout nouveau site d'escalade en pleine expansion...\r\nGrande paroi propice à l'escalade dite \"moderne\". Un chemin d'accès facile, du bon rocher, un équipement fiable et abondant ! Déjà près de 55 longueurs du 5c au 7a vous attendent."
    ],
    "es": [
      "Un nuevo sitio de escalada en plena expansión...\r\nGran pared apta para la escalada \"moderna\". Una ruta de fácil acceso, buena roca, ¡equipos fiables y abundantes! Ya le esperan 55 largos de 5c a 7a."
    ],
    "nl": [
      "Een nieuwe plaats waar je kan sportklimmen in volledige uitbouw.\r\nGrote rotsflanken waar je het zo genoemde \"modern sportklimmen\" kan uit oefen.  Makkelijk bereikbaar met een heel vertrouwbare uitrusting. Reeds 55m lengte van 5b tot 7b."
    ]
  },
  "rdfs:label": {
