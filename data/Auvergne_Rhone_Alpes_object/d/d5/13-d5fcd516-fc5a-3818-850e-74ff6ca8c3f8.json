  "rdfs:comment": {
    "de": [
      "Diese Pizzeria liegt im Herzen des Dorfes Ars und bietet den Bewohnern des Dorfes, aber auch den Touristen, eine neue schnelle Mahlzeit zum Mitnehmen."
    ],
    "en": [
      "PIZZERIA: ARS PIZZA in Ars-sur-Formans\r\nLocated in the heart of Ars village, this pizzeria offers takeaway options for both locals and tourists.\r\nAdrien and Marie serve pizzas inspired by Italian traditions, made with fresh ingredients from both Italy and the local area."
    ],
    "it": [
      "Situata nel cuore del villaggio di Ars, questa pizzeria offre un nuovo servizio di fast-food da asporto per i residenti locali e i turisti."
    ],
    "fr": [
      "Situé au coeur du village d'Ars, cette pizzéria vous offre une nouvelle restauration rapide à emporter aux habitants du village mais aussi aux touristes."
    ],
    "es": [
      "Situada en el corazón del pueblo de Ars, esta pizzería ofrece un nuevo servicio de comida rápida para llevar tanto a los residentes locales como a los turistas."
    ],
    "nl": [
      "Deze pizzeria ligt in het hart van het dorp Ars en biedt een nieuwe fastfood afhaalservice voor zowel inwoners als toeristen."
    ]
  },
