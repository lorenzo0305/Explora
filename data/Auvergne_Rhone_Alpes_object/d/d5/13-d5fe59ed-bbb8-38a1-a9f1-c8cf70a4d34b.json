  "rdfs:comment": {
    "de": [
      "Die Mühle Morand liegt in Le Pont d'Arith, im Herzen des regionalen Naturparks Massif des Bauges, und ist eine authentische Ölmühle aus dem Jahr 1896."
    ],
    "en": [
      "Located at the Pont d'Arith, near Nant de St-François, this building was created in 1896. Although it is commonly known as a sawmill, this multi-purpose structure actually serves as a sawmill, apple press and nut press."
    ],
    "it": [
      "Situato al Pont d'Arith, nei pressi del Nant de St-François, l'edificio fu realizzato nel 1896. Il termine segheria è il più utilizzato, ma si tratta di una struttura polifunzionale: segheria, torchiatura di mele e noci."
    ],
    "fr": [
      "Situé au Pont d'Arith, au cœur du parc naturel régional du massif des Bauges, le moulin Morand est une authentique huilerie de 1896."
    ],
    "es": [
      "Situado en Pont d'Arith, en el corazón del Parque Natural Regional del Macizo de las Bauges, el molino de Morand es un auténtico molino de aceite que data de 1896."
    ],
    "nl": [
      "Bij de Pont d'Arith, vlak bij de Nant de St-François ligt dit gebouw dat in 1896 opgericht werd. Alhoewel het een zagerij wordt genoemd, gaat het eigenlijk om meerdere activiteiten: zagerij, appelpers en notenpers."
    ]
  },
