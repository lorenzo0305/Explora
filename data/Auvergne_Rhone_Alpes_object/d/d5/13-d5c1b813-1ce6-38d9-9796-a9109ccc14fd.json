  "rdfs:comment": {
    "de": [
      "Bewachter Strand am Ufer des Sees von Aiguebelette mit Sand und Grün, dessen herrliches Panorama zum Entspannen einlädt."
    ],
    "en": [
      "Supervised beach on the edge of Lac d’Aiguebelette : sand, greenery and calm."
    ],
    "it": [
      "Una spiaggia sorvegliata sulle rive del Lac d'Aiguebelette, con sabbia e verde e un panorama superbo che invita al relax."
    ],
    "fr": [
      "Plage surveillée au bord du lac d'Aiguebelette, avec sable et verdure, dont le superbe panorama invite à la détente."
    ],
    "es": [
      "Una playa vigilada a orillas del Lac d'Aiguebelette, con arena y vegetación y un magnífico panorama que invita a relajarse."
    ],
    "nl": [
      "Een bewaakt strand aan de oever van het Lac d'Aiguebelette, met zand en groen en een prachtig panorama dat uitnodigt tot ontspanning."
    ]
  },
