  "rdfs:comment": {
    "de": [
      "Sie werden von Geneviève eingeladen, die Geheimnisse der Umwandlung von Früchten in Alkohol zu entdecken. Außerhalb der Schulferien finden Besichtigungen nur auf Anfrage statt."
    ],
    "en": [
      "You are invited to discover the secrets behind transforming fruit into alcohol. Outside school holidays visits are upon request only."
    ],
    "it": [
      "Siete invitati da Geneviève a scoprire i segreti della trasformazione della frutta in alcol. Al di fuori delle vacanze scolastiche, le visite sono disponibili solo su richiesta."
    ],
    "fr": [
      "Vous êtes invités par Geneviève à découvrir les secrets de la transformation des fruits en alcool. En dehors des vacances scolaires, les visites se font uniquement sur demande."
    ],
    "nl": [
      "Geneviève nodigt je uit om de geheimen te ontdekken van het omzetten van fruit in alcohol. Buiten de schoolvakanties zijn rondleidingen alleen beschikbaar op aanvraag."
    ],
    "es": [
      "Geneviève le invita a descubrir los secretos de la transformación de la fruta en alcohol. Fuera de las vacaciones escolares, las visitas sólo pueden solicitarse."
    ]
  },
