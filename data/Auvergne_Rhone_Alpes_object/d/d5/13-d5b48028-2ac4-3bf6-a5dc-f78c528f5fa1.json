  "rdfs:comment": {
    "de": [
      "Concept Store seit 2008, wo man den alpinen Augenblick in einer Deko-Boutique genießt! La table sucrée-salée BIO: Teesalon & Leckereien (auch gluten-/laktosefrei), Originelle Getränke, Suppenbar (Winter), Salate, handwerklich hergestelltes Eis (Sommer)"
    ],
    "en": [
      "Concept store since 2008 where you can taste the alpine moment in a decoration shop! The ORGANIC sweet and salty table: Tea room & delicacies (also gluten/lactose free), Original drinks, Soup bar (winter), Salads, homemade ice cream (summer)"
    ],
    "it": [
      "Concept store dal 2008 dove assaporare il momento alpino in un negozio di arredamento! La tavola del dolce e del salato BIOLOGICO: Tea room & prelibatezze (anche gluten/lattosio free), Original drinks, Soup bar (inverno), Insalate, Gelato artigianale (estate)"
    ],
    "fr": [
      "Concept store depuis 2008 où l’on déguste l’instant alpin dans une boutique déco ! La table sucrée-salée BIO : Salon de thé & gourmandises (aussi sans gluten/lactose), Boissons originales, Bar à soupes (hiver), Salades, glaces artisanales (été)"
    ],
    "es": [
      "¡Concepto de tienda desde 2008 donde se puede disfrutar del momento alpino en una tienda de decoración! La table sucrée-salée BIO : Salón de té y delicias (también sin gluten/lactosa), Bebidas originales, Bar de sopas (invierno), Ensaladas, helados artesanales (verano)"
    ],
    "nl": [
      "Concept store sinds 2008 waar je het alpine moment proeft in een decoratiewinkel! De BIO zoetzure tafel: Theesalon & delicatessen (ook gluten-/lactosevrij), Originele dranken, Soepreep (winter), Salades, huisgemaakt ijs (zomer)"
    ]
  },
