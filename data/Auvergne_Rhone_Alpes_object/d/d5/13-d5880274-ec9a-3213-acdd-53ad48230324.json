  "rdfs:comment": {
    "de": [
      "Restaurant direkt am Wasser mit herrlichem Blick auf den See. Traditionelle hausgemachte Küche, viele Cocktails. Ein Hauch von Urlaub in einer ruhigen und friedlichen Umgebung."
    ],
    "en": [
      "Restaurant feet in the water with a magnificent view of the lake. Traditional home cooking, many cocktails. A holiday atmosphere in a quiet and peaceful setting."
    ],
    "it": [
      "Ristorante direttamente sull'acqua con una magnifica vista sul lago. Cucina casalinga tradizionale (filetti di pesce persico, tagliate di macelleria, ecc.), numerosi cocktail. Un'atmosfera di vacanza in un ambiente calmo e tranquillo."
    ],
    "fr": [
      "Restaurant les pieds dans l'eau avec une vue magnifique sur le lac. Cuisine traditionnelle maison (filets de perche, pièce du boucher,...), nombreux cocktails. Un air de vacances dans un cadre calme et paisible."
    ],
    "es": [
      "Restaurante a orillas del agua con magníficas vistas al lago. Cocina casera tradicional (filetes de perca, cortes de carnicero, etc.), numerosos cócteles. Ambiente de vacaciones en un entorno tranquilo y apacible."
    ],
    "nl": [
      "Restaurant direct aan het water met een prachtig uitzicht op het meer. Traditionele keuken (baarsfilets, slagersvlees, enz.), veel cocktails. Een vakantiesfeer in een rustige en vredige omgeving."
    ]
  },
