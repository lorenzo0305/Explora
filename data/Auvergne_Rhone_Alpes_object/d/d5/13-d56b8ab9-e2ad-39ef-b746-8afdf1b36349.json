  "rdfs:comment": {
    "de": [
      "Vollständig auf biologischen Landbau umgestelltes Weingut (Beaujolais Rosé und Beaujolais Rouge). 250 Jahre alter ehemaliger Weinkeller mit Gewölbekeller auf 280 m2. Südlage, jahrhundertealte Reben."
    ],
    "en": [
      "Our tasting cellar is in the hamlet of Graves, in the middle of the Pierres Dorées (golden stone) region. The vines are just below the building, facing full south."
    ],
    "it": [
      "Tenuta interamente convertita all'agricoltura biologica (Beaujolais Rosé e Beaujolais Red). Antica sala tinaia di 250 anni con 280 m2 di cantina a volta. Esposizione a sud, viti secolari."
    ],
    "fr": [
      "Domaine entièrement converti à l'Agriculture Biologique (Beaujolais Rosé et Beaujolais Rouge). Ancien cuvage de 250 ans avec cave voûtée sur 280 m2. Exposition plein sud, vignes centenaires."
    ],
    "nl": [
      "Landgoed volledig omgebouwd naar biologische landbouw (Beaujolais Rosé en Beaujolais Red). Oude 250 jaar oude kuiperij met 280 m2 gewelfde kelder. Op het zuiden gelegen, eeuwenoude wijnstokken."
    ],
    "es": [
      "Finca totalmente reconvertida a la agricultura ecológica (Beaujolais Rosé y Beaujolais Red). Antigua sala de cubas de 250 años con 280 m2 de bodega abovedada. Vinos centenarios orientados al sur."
    ]
  },
