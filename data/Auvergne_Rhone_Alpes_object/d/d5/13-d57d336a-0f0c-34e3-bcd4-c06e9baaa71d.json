  "rdfs:comment": {
    "de": [
      "Die Université Nyonsaise du Temps Libre (UNTL) hat die Aufgabe, eine ständige Weiterbildung in Form von Kursen, Workshops und Konferenzen in verschiedenen Bereichen des kulturellen Lebens anzubieten."
    ],
    "en": [
      "The Université Nyonsaise du Temps Libre (UNTL) continuously offers training courses, workshops and conferences linked with diverse cultural themes."
    ],
    "it": [
      "La missione dell'Université Nyonsaise du Temps Libre (UNTL) è quella di fornire una formazione permanente sotto forma di corsi, workshop e conferenze in vari campi della vita culturale."
    ],
    "fr": [
      "L'Université Nyonsaise du Temps Libre (UNTL) a pour mission de délivrer une formation permanente sous forme de cours, d'ateliers et de conférences dans divers domaine de la vie culturelle."
    ],
    "es": [
      "La misión de la Université Nyonsaise du Temps Libre (UNTL) es ofrecer formación permanente en forma de cursos, talleres y conferencias en diversos ámbitos de la vida cultural."
    ],
    "nl": [
      "Deze Nyonse Vrije Tijd Universiteit , heeft als doel permanente vorming te bieden in de vorm van  cursussen, ateliers  en conferenties in het brede  gebied van  het culturele leven."
    ]
  },
