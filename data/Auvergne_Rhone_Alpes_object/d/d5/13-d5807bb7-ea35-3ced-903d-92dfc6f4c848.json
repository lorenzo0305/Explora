  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Herz der Verwertung Ihrer Abfälle. Das Centre d'Immersion Educatif et Ludique des SIVALOR wird Sie mit einer explosiven Mischung aus Klängen, Licht und Interaktivität in eine völlig neue Erfahrung versetzen."
    ],
    "en": [
      "Dive into the heart of waste recovery. SIVALOR's Centre d'Immersion Educatif et Ludique (Educational and Fun Immersion Center) will take you on a unique experience through an explosive mix of sound, light and interactivity."
    ],
    "it": [
      "Immergetevi nel cuore del recupero dei rifiuti. Il Centro Immersivo Educativo e Divertente di SIVALOR vi farà vivere un'esperienza unica attraverso un mix esplosivo di suoni, luci e interattività."
    ],
    "fr": [
      "Plongez au cœur de la valorisation de vos déchets. Le Centre d'Immersion Educatif et Ludique du SIVALOR vous fera vivre une expérience inédite à travers un détonnant mélange de sons, de lumières et d'interactivité."
    ],
    "es": [
      "Sumérjase en el corazón de la recuperación de residuos. El Centro de Inmersión Educativa y Lúdica de SIVALOR le hará vivir una experiencia única a través de una mezcla explosiva de sonido, luz e interactividad."
    ],
    "nl": [
      "Duik in het hart van afvalterugwinning. Het educatieve en ludieke onderdompelingscentrum van SIVALOR geeft je een unieke ervaring door een explosieve mix van geluid, licht en interactiviteit."
    ]
  },
  "rdfs:label": {
    "de": [
      "Besuch des Centre d'Immersion Educatif et Ludique (CIEL)"
    ],
    "en": [
      "Visit to the Centre d'Immersion Educatif et Ludique (CIEL)"
    ],
    "it": [
      "Visita al Centre d'Immersion Educatif et Ludique (CIEL)"
    ],
    "fr": [
      "Visite du Centre d'Immersion Educatif et Ludique (CIEL)"
    ],
    "es": [
      "Visita al Centro de Inmersión Educativa y Lúdica (CIEL)"
    ]
  },
