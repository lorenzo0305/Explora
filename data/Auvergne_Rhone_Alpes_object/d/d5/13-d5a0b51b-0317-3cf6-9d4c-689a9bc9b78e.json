  "rdfs:comment": {
    "de": [
      "Restaurant am Seeufer, gegenüber dem Sessellift La Forêt und der Gondelbahn Praz, 6 Min. von Courchevel 1850 entfernt, mit Skiern zu erreichen. \r\nRestaurant mit Gerichten zum Teilen: Gerichte für mehrere Personen, die in der Mitte des Tisches zum Teilen bereitstehen. Warmer und gemütlicher Rahmen."
    ],
    "ru": [
      "Ресторан на берегу озера, напротив подъемников Форе и Ле-Пра, в 6 минутах от Куршевеля-1850, можно доехать на лыжах. \r\nРесторан с радушной атмосферой: блюда в центре стола на несколько человек. Уютный интерьер."
    ],
    "en": [
      "The Bistrot du Praz is accessible by ski, and located opposite to the Forêt ski lift and le Praz gondola. At 6 minutes of Courchevel 1850 by lift, on the banks of the lake. This restaurant offers hearty, traditional cuisine such as leg of lamb and prime rib of beef to be shared in a warm and cosy ambiance."
    ],
    "it": [
      "Ristorante in riva al lago, di fronte alla funivia della Forêt e alla seggiovia del Praz, a 6 minuti da Courchevel 1850, accessibile in sci. \r\nRistorante per gruppi, con generosi piatti da condividere al centro tavola. Ambiente caloroso e amichevole."
    ],
    "fr": [
      "Restaurant au bord du lac, face au télésiège de la Forêt et de la télécabine du Praz, à 6 mn de Courchevel 1850, accessible à ski. \r\nRestaurant de partage : plats conviviaux à partager au milieu de la table. Cadre chaleureux et cosy."
    ],
    "es": [
      "Restaurante junto al lago, frente al telesilla de La Forêt y la telecabina de Le Praz, a seis minutos de Courchevel 1850, accesible mediante esquí. \r\nRestaurante para compartir platos en el centro de la mesa. Ambiente cálido y acogedor."
    ],
    "nl": [
      "Restaurant aan het meer, tegenover de stoeltjeslift Forêt en de kabelbaan Praz, op 6 minuten van Courchevel 1850, bereikbaar per ski\r\nRestaurant om te delen: vriendelijke gerechten om te delen in het midden van de tafel. Warme en gezellige omgeving."
    ]
  },
