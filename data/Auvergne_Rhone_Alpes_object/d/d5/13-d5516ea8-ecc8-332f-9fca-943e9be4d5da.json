  "rdfs:comment": {
    "de": [
      "Die Pedalkarts sind für Kinder ab 3 Jahren frei zugänglich und bieten eine lustige und energiegeladene Erfahrung in der Natur."
    ],
    "en": [
      "Pedal go-karts are freely available for children aged 3 and over, offering a fun and energetic experience in the heart of nature."
    ],
    "it": [
      "I go-kart a pedali sono disponibili gratuitamente per i bambini dai 3 anni in su, offrendo un'esperienza divertente ed energica nel cuore della natura."
    ],
    "fr": [
      "Les Karts à pédales sont proposés en libre accès aux enfants de plus de 3 ans, et offrent une expérience amusante et énergique au cœur de la nature."
    ],
    "es": [
      "Los karts a pedales están disponibles gratuitamente para niños a partir de 3 años, ofreciendo una experiencia divertida y llena de energía en plena naturaleza."
    ],
    "nl": [
      "Kinderen vanaf 3 jaar kunnen gratis skelters huren voor een leuke en energieke ervaring midden in de natuur."
    ]
