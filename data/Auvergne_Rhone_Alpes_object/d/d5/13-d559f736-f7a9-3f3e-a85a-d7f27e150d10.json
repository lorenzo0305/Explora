  "rdfs:comment": {
    "de": [
      "Buis-les-Baronnies, die ehemalige Hauptstadt der Barone von Mévouillon, ist ein hübsches, von Olivenhainen und Bergen umgebenes Städtchen und gilt heute als Heimat des \"Honigbaums\", der Linde."
    ],
    "en": [
      "A pretty village surrounded by olive groves and mountains, Buis-les-Baronnies, former capital of the Barons of Mévouillon, is known today as the home of the \"honey tree\": the lime tree."
    ],
    "it": [
      "Buis-les-Baronnies è l'antica capitale medievale dei Baroni di Mévouillon, con le sue incantevoli stradine. Gole naturali e scogliere mozzafiato punteggiano il paesaggio selvaggio, offrendo un parco giochi eccezionale per gli amanti della natura."
    ],
    "fr": [
      "Buis-les-Baronnies est l'ancienne capitale médiévale des barons de Mévouillon, aux ruelles de charme. Gorges naturelles et falaises vertigineuses ponctuent le paysage sauvage, dévoilant un terrain de jeu exceptionnel pour les amateurs de pleine nature."
    ],
    "nl": [
      "Buis-les-Baronnies, de voormalige hoofdstad van de baronnen van Mévouillon, is een mooi dorp omringd door olijfgaarden en bergen en staat vandaag de dag bekend om de \"honingboom\": de linde."
    ],
    "es": [
      "Buis-les-Baronnies es la antigua capital medieval de los barones de Mévouillon, con sus encantadoras callejuelas. Las gargantas naturales y los impresionantes acantilados salpican el agreste paisaje, ofreciendo un patio de recreo excepcional para los amantes de la naturaleza."
    ]
  },
