  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Außenanlagen oder geführte Besichtigung nach Vereinbarung ab 20 Personen.\r\nSchloss aus dem 19. Jahrhundert mit französischem und englischem Garten inmitten eines Parks in Moulins."
    ],
    "en": [
      "Self-guided tour of the exterior or guided tour by appointment for groups of 20 or more.\r\n19th-century château with French and English gardens, set in a park in Moulins."
    ],
    "it": [
      "Visita autogestita degli esterni o visita guidata su prenotazione per gruppi di almeno 20 persone.\r\nCastello del XIX secolo con giardini formali e all'inglese, immerso in un parco a Moulins."
    ],
    "fr": [
      "Visite libre des extérieurs ou visite guidée sur rendez-vous à partir de 20 personnes.\r\nChâteau du XIXème siècle avec jardin à la française et jardin à l’anglaise, au milieu d'un parc à Moulins."
    ],
    "nl": [
      "Zelf rondleiding door de buitenkant of rondleiding op afspraak voor groepen van 20 of meer.\r\n19e-eeuws kasteel met formele en Engelse tuinen, gelegen in een park in Moulins."
    ],
    "es": [
      "Visita exterior autoguiada o visita guiada con cita previa para grupos a partir de 20 personas.\r\nCastillo del siglo XIX con jardines formales e ingleses, situado en un parque en Moulins."
    ]
  },
