  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8c85667c-d364-3498-87a0-cbb29ee3872f",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Je nach Produktion, siehe Facebook-Seite\n\nÖffnungstage:\n\nMontag bis Samstag: 9:00 - 19:00 Uhr\n\nSonntag geschlossen\n\nAbholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nMöglichkeit, auf der Website des Ladens zu bestellen\n \n \n \n\n "
        ],
        "en": [
          "Information :\n\nProducts: According to production, see Facebook page\n\nOpening days:\n\nMonday to Saturday: 9am - 7pm\n\nClosed on Sunday\n\nCollection:\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrders can be placed on the store's website\n \n \n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: A seconda della produzione, consultare la pagina Facebook\n\nGiorni di apertura:\n\nDa lunedì a sabato: dalle 9.00 alle 19.00\n\nChiuso la domenica\n\nRitiro:\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nÈ possibile ordinare sul sito web del negozio\n \n \n \n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : Selon production, voir la page Facebook \n\nJours d'ouverture:\n\nDu lundi au samedi : 9h - 19h\n\nFermeture le dimanche\n\nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander sur le site du magasin\n \n \n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Afhankelijk van de productie, zie de Facebook-pagina\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 9u - 19u\n\nZondag gesloten\n\nOphalen:\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nJe kunt bestellen op de website van de winkel\n \n \n \n\n "
        ],
        "es": [
          "Más información :\n\nProductos: En función de la producción, consulte la página de Facebook\n\nDías de apertura:\n\nDe lunes a sábado: de 9.00 a 19.00 horas\n\nDomingos cerrado\n\nRecogida:\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nPuede hacer su pedido en el sitio web de la tienda\n \n \n \n\n "
        ]
      },
