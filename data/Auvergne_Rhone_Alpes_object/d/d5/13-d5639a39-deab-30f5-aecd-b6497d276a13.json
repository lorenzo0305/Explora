  "rdfs:comment": {
    "de": [
      "Romanisch-byzantinische Kirche Saint-Martin oder Saint- Men aus dem 12. Jahrhundert mit einem einzigen Schiff, das durch einen Chor verlängert wird, dessen rechtes Joch von einer halbkugelförmigen Kuppel mit Rüssel überragt wird, die den Glockenturm trägt."
    ],
    "en": [
      "Art lovers are spoilt when visiting the 12th c. Romano-Bysantine church St. Men. Its only one knave goes into the chancel spanning a hemispherical dome with a squinch supporting the steeple."
    ],
    "it": [
      "La chiesa romanico-bizantina di Saint-Martin o Saint-Men, risalente al XII secolo, è a navata unica prolungata da un coro, la cui campata destra è sormontata da una cupola emisferica su una tromba che sostiene il campanile."
    ],
    "fr": [
      "Eglise romano-byzantine saint-Martin ou Saint- Men du 12ème, à nef unique prolongée par un choeur dont la travée droite est surmontée d’une coupole hémisphérique sur trompe supportant le clocher."
    ],
    "es": [
      "La iglesia románico-bizantina de Saint-Martin o Saint-Men, del siglo XII, tiene una sola nave prolongada por un coro, cuya crujía derecha está rematada por una cúpula semiesférica sobre una trompeta que sostiene el campanario."
    ],
    "nl": [
      "De 12e-eeuwse Romaans-Byzantijnse kerk Saint-Martin of Saint-Men heeft één schip dat wordt verlengd door een koor, waarvan de rechtertravee wordt bekroond door een halfronde koepel op een trompet die de klokkentoren ondersteunt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Martin church"
    ],
    "fr": [
      "Eglise saint-Martin"
    ]
  },
