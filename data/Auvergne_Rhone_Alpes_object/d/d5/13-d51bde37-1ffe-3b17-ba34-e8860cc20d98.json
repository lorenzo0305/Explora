  "rdfs:comment": {
    "de": [
      "La Paillote de Tignes ist der Strand in den Bergen. Genießen Sie köstliche Cocktails, nordfranzösische Biere und Weine in einer tropischen und geselligen Atmosphäre."
    ],
    "en": [
      "La Paillote de Tignes is clearly the beach in the mountains. Come and taste delicious cocktails, northern beers and wines in a tropical and friendly atmosphere."
    ],
    "it": [
      "La Paillote de Tignes è la spiaggia in montagna. Venite a gustare deliziosi cocktail, birre e vini del nord in un'atmosfera amichevole e tropicale."
    ],
    "fr": [
      "La Paillote de Tignes c'est la plage à la montagne. Venez déguster de délicieux cocktails, bières du Nord et vins dans une ambiance tropicale et conviviale."
    ],
    "nl": [
      "La Paillote de Tignes is het strand in de bergen. Kom genieten van heerlijke cocktails, noordelijke bieren en wijnen in een vriendelijke, tropische sfeer."
    ],
    "es": [
      "La Paillote de Tignes es la playa en la montaña. Venga a disfrutar de deliciosos cócteles, cervezas del norte y vinos en un ambiente agradable y tropical."
    ]
  },
  "rdfs:label": {
