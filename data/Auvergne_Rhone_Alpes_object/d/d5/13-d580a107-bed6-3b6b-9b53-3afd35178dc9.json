  "rdfs:comment": {
    "de": [
      "Sie gestalten ein kleines Kirchenfenster aus kleinen Glasstücken, die bei 800° durch Aufkleben auf einen ausgewählten Untergrund verschmolzen werden. Sie gehen mit Ihrer Kreation nach Hause."
    ],
    "en": [
      "You create a small stained glass window with small pieces of glass fused at 800° by gluing on a chosen support. You leave with your creation."
    ],
    "it": [
      "Si crea una piccola vetrata con piccoli pezzi di vetro fusi a 800° e incollati su un supporto scelto. Si esce con la propria creazione."
    ],
    "fr": [
      "Vous créez un petit vitrail avec des petits bouts de verre fusionnés à 800° par collage sur un support choisi. Vous repartez avec votre création."
    ],
    "nl": [
      "U maakt een klein glas-in-loodraam met kleine stukjes glas die bij 800° worden versmolten door ze op een gekozen drager te plakken. U vertrekt met uw creatie."
    ],
    "es": [
      "Creas una pequeña vidriera con pequeños trozos de vidrio fundidos a 800° pegándolos sobre un soporte elegido. Te marchas con tu creación."
    ]
