  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Welt des Bistro du Regain mit seiner schönen Vintage-Dekoration, seinen antiken Gegenständen und Möbeln, die den Ort charmant und sogar tröstlich machen."
    ],
    "en": [
      "Discover the world of Bistro du Regain, with its beautiful vintage decor and antique objects and furniture that make the place charming and even comforting."
    ],
    "it": [
      "Scoprite il mondo del Bistro du Regain con il suo splendido arredamento vintage, gli oggetti e i mobili antichi che rendono il luogo affascinante e persino confortante."
    ],
    "fr": [
      "Allez découvrir l'univers du Bistro du Regain avec sa belle décoration vintage, ses objets et meubles anciens chinés  qui rendent le lieu plein de charme et même réconfortant ."
    ],
    "nl": [
      "Ontdek de wereld van de Bistro du Regain met zijn prachtige vintage inrichting, antieke voorwerpen en meubels die de plek charmant en zelfs troostend maken."
    ],
    "es": [
      "Descubra el mundo del Bistro du Regain con su hermosa decoración vintage, objetos y muebles antiguos que hacen que el lugar resulte encantador e incluso reconfortante."
    ]
  },
