          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Montag, Dienstag, Mittwoch, Donnerstag, Freitag, Samstag: 09:00 bis 12:00 Uhr, 14:00 bis 18:00 Uhr\r\n\r\nNach vorheriger Vereinbarung.\r\nFür eventuell andere Zeiten zögern Sie nicht, anzurufen.\r\nFür die Sommerspaziergänge können sich die Zeiten ändern (früher am Morgen oder später am Abend)."
            ],
            "en": [
              "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday: 09h to 12h, 14h to 18h\r\n\r\nBy appointment only.\r\nFor other times, please call.\r\nFor summer rides, times may change (earlier in the morning or later in the evening)."
            ],
            "it": [
              "Lunedì, martedì, mercoledì, giovedì, venerdì, sabato: dalle 09:00 alle 12:00, dalle 14:00 alle 18:00\r\n\r\nSolo su appuntamento.\r\nPer altri orari si prega di telefonare.\r\nPer le passeggiate estive, gli orari possono cambiare (al mattino presto o alla sera)."
            ],
            "fr": [
              "Lundi, Mardi, Mercredi, Jeudi, Vendredi, Samedi : 09h à 12h, 14h à 18h\r\n\r\nSur rendez-vous.\r\nPour éventuellement d'autre horaire n'hésitez pas à appeler.\r\nPour les balades d'été les horaires peuvent changer (plus tôt le matin ou plus tard le soir)."
            ],
            "nl": [
              "Maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag: 09u tot 12u, 14u tot 18u\r\n\r\nAlleen op afspraak.\r\nVoor andere tijden kunt u bellen.\r\nVoor zomerwandelingen kunnen de tijden veranderen (vroeger in de ochtend of later op de avond)."
            ],
            "es": [
              "Lunes, martes, miércoles, jueves, viernes, sábado: 09h a 12h, 14h a 18h\r\n\r\nSólo con cita previa.\r\nPara otros horarios, llame por teléfono.\r\nPara los paseos de verano, los horarios pueden cambiar (más temprano por la mañana o más tarde por la noche)."
            ]
          },
