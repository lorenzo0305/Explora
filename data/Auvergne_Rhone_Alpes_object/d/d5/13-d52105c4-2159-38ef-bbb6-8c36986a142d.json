  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration - Weinbar und Bar.\r\nUnsere talentierten Köche empfangen Sie mit Freude und guter Laune, um Ihnen Gerichte mit authentischem Geschmack zu servieren."
    ],
    "en": [
      "Traditional restaurant - Wine bar and bar.\r\nOur talented chefs will be delighted to welcome you and help you discover our authentic dishes."
    ],
    "it": [
      "Ristorante tradizionale - Wine bar e bar.\r\nI nostri chef di talento saranno lieti di accogliervi e di farvi scoprire i nostri piatti autentici."
    ],
    "fr": [
      "Restauration traditionnelle - Bar à vins et bar. \r\nNos talentueux chefs vous accueillent dans la joie et la bonne humeur pour vous faire découvrir des plats aux goûts authentiques."
    ],
    "nl": [
      "Traditioneel restaurant - Wijnbar en bar.\r\nOnze getalenteerde chef-koks heten je van harte welkom en laten je kennismaken met onze authentieke gerechten."
    ],
    "es": [
      "Restaurante tradicional - Vinoteca y bar.\r\nNuestros talentosos chefs estarán encantados de darle la bienvenida y ayudarle a descubrir nuestros auténticos platos."
    ]
