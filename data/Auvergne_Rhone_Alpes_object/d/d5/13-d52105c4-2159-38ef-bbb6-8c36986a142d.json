          "additionalInformation": {
            "de": [
              "Außerhalb der Saison\r\nvon Montag bis einschließlich Samstag\r\nMontag und Mittwoch nur mittags\r\nDienstag, Donnerstag, Freitag und Samstag mittags und abends\r\nIn der Saison (ab Ende Juni)\r\nvon Montag bis einschließlich Samstag (mittags und abends)\r\nSonntags (je nach Festlichkeiten geöffnet)"
            ],
            "en": [
              "Low season\r\nmonday to Saturday inclusive\r\nMonday and Wednesday lunchtime only\r\nTuesday, Thursday, Friday and Saturday lunch and dinner\r\nIn season (from late June)\r\nmonday to Saturday (lunch and dinner)\r\nSundays (open according to festivities)"
            ],
            "it": [
              "Bassa stagione\r\nda lunedì a sabato incluso\r\nLunedì e mercoledì solo a pranzo\r\nMartedì, giovedì, venerdì e sabato a pranzo e a cena\r\nIn stagione (da fine giugno)\r\nda lunedì a sabato (pranzo e cena)\r\nDomenica (aperto secondo le festività)"
            ],
            "fr": [
              "Hors saison\r\ndu Lundi au samedi inclus\r\nLundi et mercredi uniquement le midi\r\nMardi, Jeudi, vendredi et samedi midi et soir\r\nEn saison (à partir de fin juin)\r\ndu Lundi au samedi inclus (midi et soir)\r\nLes dimanches (ouvert selon festivités)"
            ],
            "es": [
              "Temporada baja\r\nde lunes a sábado inclusive\r\nLunes y miércoles sólo a mediodía\r\nMartes, jueves, viernes y sábado, almuerzo y cena\r\nEn temporada (desde finales de junio)\r\nde lunes a sábado (almuerzo y cena)\r\nDomingos (abierto según festividades)"
            ],
            "nl": [
              "Laagseizoen\r\nmaandag tot en met zaterdag\r\nAlleen lunch op maandag en woensdag\r\nDinsdag, donderdag, vrijdag en zaterdag lunch en diner\r\nIn het seizoen (vanaf eind juni)\r\nmaandag tot zaterdag (lunch en diner)\r\nZondag (open afhankelijk van festiviteiten)"
            ]
          },
