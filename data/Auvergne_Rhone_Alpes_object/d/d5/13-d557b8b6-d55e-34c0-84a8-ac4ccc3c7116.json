  "rdfs:comment": {
    "de": [
      "Treten Sie ein in eine ruhige und charmante Umgebung im Herzen des Bergbaubeckens, um sich mit einer traditionellen und hausgemachten Küche zu stärken."
    ],
    "en": [
      "Enter in a quiet and charming setting in the heart of the mining basin, to restore you with traditional and homemade cuisine."
    ],
    "it": [
      "Entrate in un ambiente tranquillo e affascinante nel cuore del bacino minerario, per gustare una cucina tradizionale e casalinga."
    ],
    "fr": [
      "Entrez dans un cadre tranquille et charmant au cœur du bassin minier, pour vous restaurer avec une cuisine traditionnelle et faite maison."
    ],
    "nl": [
      "Treed binnen in een rustige en charmante omgeving in het hart van het mijnbekken, om te genieten van traditionele en huisgemaakte gerechten."
    ],
    "es": [
      "Entre en un entorno tranquilo y encantador en el corazón de la cuenca minera, para disfrutar de una cocina tradicional y casera."
    ]
  },
