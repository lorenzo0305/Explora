  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt und die französischen Skischulen bieten Ihnen die Möglichkeit, Ihr Skiniveau zu testen!\r\nZugänglich für alle, in ESF-Kursen oder als Einzelperson."
    ],
    "en": [
      "The Tourist Office and the French Ski School invites you to test your skiing level on the Resort's two slalom courses."
    ],
    "it": [
      "L'Ufficio del Turismo e le scuole di sci francesi vi offrono la possibilità di mettere alla prova le vostre abilità sciistiche!\r\nAccessibile a tutti, nelle lezioni FSE o individualmente."
    ],
    "fr": [
      "L'Office de Tourisme et les Ecoles de Ski Français vous proposent de tester votre niveau de ski !\r\nAccessible à tous, en cours ESF ou en tant qu'individuel."
    ],
    "es": [
      "La Oficina de Turismo y las Escuelas Francesas de Esquí le ofrecen la posibilidad de poner a prueba sus habilidades como esquiador\r\nAccesible a todos, en clases de FSE o a título individual."
    ],
    "nl": [
      "De Dienst voor Toerisme en de Franse Skischolen bieden u de kans om uw skivaardigheden te testen!\r\nToegankelijk voor iedereen, in ESF-lessen of als individu."
    ]
  },
