  "rdfs:comment": {
    "de": [
      "Individuelles Coaching von Emmanuelle Dumolard, Wakeboard-Weltmeisterin 2002, mit neuem Audiosystem für schnellen und spielerischen Fortschritt.\r\nPrivatkurs auf Ihrem Boot.\r\nKurse für mehrere Gleitsportarten und Aktivitäten, Teambuildings, Junggesellenabschiede ..."
    ],
    "en": [
      "Customised coaching with Emmanuelle Dumolard, the 2002 World Wakeboard Champion, who uses a new audio system to ensure rapid progress and plenty of fun.\r\nPrivate lessons on your own boat.\r\nWatersports tuition, multi-activity packages, wakesurf, paddle boat rental..etc."
    ],
    "it": [
      "Coaching personalizzato a opera di Emmanuelle Dumolard, Campionessa del mondo di Wakeboard nel 2002, con un nuovo sistema audio per un miglioramento rapido e ludico.\r\nLezione privata sulla vostra barca.\r\nStage multi-scivolo, multi-attività, comitati aziendali, addio al celibato e al nubilato..."
    ],
    "fr": [
      "Coaching personnalisé par Emmanuelle Dumolard Championne du monde de Wakeboard 2002 avec un nouveau système audio pour une progression rapide et ludique.\nCours privatif sur votre bateau. Stages multi-glisses, multi-activités, wakesurf, location de paddle."
    ],
    "nl": [
      "Persoonlijke coaching door Emmanuelle Dumolard: wereldkampioene Wakeboard 2002 met een nieuw audio systeem voor een snelle en speelse vordering.\r\nPrivélessen op een boot.\r\nMultiglijsporten, diverse activiteiten, vrijgezellenfeestjes, teambuilding..."
    ],
    "es": [
      "Entrenamiento personalizado por Emmanuelle Dumolard, campeona del mundo de wakeboard en 2002, con un nuevo sistema de audio para una progresión rápida y divertida.\nClases particulares en su barco. Cursos de multipistas y multiactividad, wakesurf, alquiler de remos."
    ]
  },
