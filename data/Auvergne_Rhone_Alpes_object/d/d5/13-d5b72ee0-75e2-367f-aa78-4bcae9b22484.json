  "rdfs:comment": {
    "de": [
      "Kirche, deren östlicher Teil der romanischen Epoche zuzuordnen ist. Sie besitzt ein vorspringendes Querschiff, das sich durch einen Spitzbogen zu einer Apsis mit flachem Kopfende öffnet."
    ],
    "en": [
      "Church whose eastern part belongs to the Romanesque period. It has a projecting transept, which opens onto a flat chevet apse through a broken arch."
    ],
    "it": [
      "La parte orientale della chiesa appartiene al periodo romanico. Presenta un transetto sporgente, che si apre su un'abside con chevet piatto attraverso un arco spezzato."
    ],
    "fr": [
      "Église dont la partie orientale appartient à l'époque romane. Elle comprend un transept saillant, qui ouvre sur une abside à chevet plat par une arcade brisée."
    ],
    "es": [
      "La parte oriental de la iglesia pertenece al periodo románico. Tiene un crucero saliente, que se abre a un ábside con una cabecera plana a través de un arco roto."
    ],
    "nl": [
      "Het oostelijke deel van de kerk behoort tot de Romaanse periode. Het heeft een uitspringend transept, dat via een gebroken boog uitkomt op een apsis met een vlakke chevet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Martin"
    ]
  },
