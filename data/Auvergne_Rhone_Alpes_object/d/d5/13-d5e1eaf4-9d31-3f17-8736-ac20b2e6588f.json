  "rdfs:comment": {
    "de": [
      "Das Restaurant du Dahu bietet eine traditionelle und gepflegte Küche, die von einer jungen, leidenschaftlichen Chefin kreativ überarbeitet wird."
    ],
    "en": [
      "The Restaurant du Dahu offers traditional, carefully prepared cuisine creatively reinterpreted by a passionate young chef."
    ],
    "it": [
      "Il Restaurant du Dahu offre una cucina tradizionale, preparata con cura e reinventata in modo creativo da un giovane chef appassionato."
    ],
    "fr": [
      "Le Restaurant du Dahu propose une cuisine traditionnelle et soignée revisitée avec créativité par une jeune cheffe passionnée."
    ],
    "nl": [
      "Het Restaurant du Dahu biedt traditionele, zorgvuldig bereide gerechten die creatief opnieuw zijn uitgevonden door een gepassioneerde jonge chef-kok."
    ],
    "es": [
      "El Restaurant du Dahu ofrece una cocina tradicional cuidadosamente elaborada y reinventada de forma creativa por un joven y apasionado chef."
    ]
  },
