  "rdfs:comment": {
    "de": [
      "Klettern Sie in einem 64 m² großen Raum. Unterstützen Sie den Verein Oé'Scalade mit einer Spende. Schlüssel am Empfang des Maison d'Aussois erhältlich, Sitzung max. 1h25 (gegen Entlastung), je nach Verfügbarkeit und für eine volljährige Person."
    ],
    "en": [
      "Climb into a 64 m² room. Support the Oé'Scalade association by making a donation. Key available at Maison d'Aussois reception, session 1h25 max (against discharge), subject to availability and for adults."
    ],
    "it": [
      "Salite in una camera di 64 m². Sostenete l'associazione Oé'Scalade con una donazione. Chiave disponibile presso la reception della Maison d'Aussois, sessione di 1h25 max (in cambio di un deposito), in base alla disponibilità e per adulti."
    ],
    "fr": [
      "Grimpez dans une salle de 64 m². Soutenez l'association Oé'Scalade en faisant un don. Clé disponible à l'accueil de la Maison d'Aussois, séance 1h25 max (contre  décharge), sous réserve de disponibilité et pour une personne majeure."
    ],
    "es": [
      "Suba a una habitación de 64 m². Apoye a la asociación Oé'Scalade haciendo un donativo. Llave disponible en la recepción de la Maison d'Aussois, sesión de 1h25 como máximo (a cambio de una fianza), según disponibilidad y para adultos."
    ],
    "nl": [
      "Klim in een kamer van 64 m². Steun de vereniging Oé'Scalade met een donatie. Sleutel verkrijgbaar bij de receptie van het Maison d'Aussois, sessie max. 1u25 (tegen borg), afhankelijk van beschikbaarheid en voor volwassenen."
    ]
  },
  "rdfs:label": {
    "en": [
