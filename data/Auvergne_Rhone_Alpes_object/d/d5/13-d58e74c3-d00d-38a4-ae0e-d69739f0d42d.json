  "rdfs:comment": {
    "de": [
      "Mieten Sie einen Posten, der in einer ehemaligen Kiesgrube eingerichtet wurde, um das nächtliche Sportangeln mit No-kill zu praktizieren oder zu entdecken. Jeder Posten verfügt über einen Picknicktisch, einen Grill und eine Trockentoilette. Minimale Session von 24 Stunden. Zugang zu Wasser und Strom."
    ],
    "en": [
      "Rent a station in a former gravel pit, for a day or more, to practice or discover no-kill fishing. Each station has a picnic table, barbecue and dry toilets. Access to water and electricity.\r\nPossibility to fish at night. \r\nPlaces are limited, by reservation only. \r\nPrivate pond rental possible."
    ],
    "it": [
      "Noleggiate un posto barca in un'ex cava di ghiaia per praticare o scoprire la pesca notturna no-kill. Ogni posto barca è dotato di tavolo da picnic, barbecue e servizi igienici a secco. Sessione minima di 24 ore. Accesso all'acqua e all'elettricità."
    ],
    "fr": [
      "Louez un poste aménagé dans une ancienne gravière, pour pratiquer ou découvrir la pêche sportive de nuit en no-kill. Chaque poste dispose d'une table de pique-nique, barbecue et toilettes sèches. Session minimum de 24h. Accès à l'eau et l'électricité."
    ],
    "nl": [
      "Huur een ligplaats in een voormalige grindgroeve om te oefenen of kennis te maken met no-kill nachtvissen. Elke ligplaats heeft een picknicktafel, barbecue en droge toiletten. Minimale sessie 24 uur. Toegang tot water en elektriciteit."
    ],
    "es": [
      "Alquile un amarre en una antigua gravera para practicar o descubrir la pesca nocturna sin muerte. Cada amarre dispone de mesa de picnic, barbacoa y aseos secos. Sesión mínima de 24 horas. Acceso al agua y a la electricidad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Havana : fishing pond"
    ],
    "fr": [
      "Havana : étangs de pêche"
    ]
  },
