  "rdfs:comment": {
    "de": [
      "Gourmetrestaurant: einfallsreiche Küche, die saisonale Produkte bevorzugt. Schöne und relevante Weinkarte. Parkmöglichkeit gegenüber der Unterpräfektur. Menü \"Retour du Marché\" wechselt täglich und die Abendkarte wechselt 2 Mal pro Saison. Privatisierung des Saals auf Anfrage."
    ],
    "en": [
      "Gastronomic restaurant: inventive cuisine with a focus on seasonal products. Beautiful and relevant wine list. Possibility of parking in front of the sub-prefecture. Menu \"Retour du Marché\" changes every day and the evening menu changes twice a season. Privatization of the room on request."
    ],
    "it": [
      "Ristorante gastronomico: cucina inventiva con particolare attenzione ai prodotti di stagione. Bella e pertinente la carta dei vini. Parcheggio disponibile di fronte alla sottoprefettura. Il menu \"Retour du Marché\" cambia ogni giorno e il menu serale cambia due volte a stagione. Uso privato della camera su richiesta."
    ],
    "fr": [
      "Restaurant gastronomique : cuisine inventive privilégiant les produits de saison. Belle carte des vins pertinente. Possibilité de parking face à la sous-préfecture. Menu \"Retour du Marché\" change tous les jours et la carte du soir change 2 fois par saison. Privatisation de la salle sur demande."
    ],
    "es": [
      "Restaurante gastronómico: cocina inventiva centrada en los productos de temporada. Bonita y relevante carta de vinos. Aparcamiento disponible frente a la subprefectura. El menú \"Retour du Marché\" cambia cada día y el menú de la noche cambia dos veces por temporada. Uso privado de la sala bajo petición."
    ],
    "nl": [
      "Gastronomisch restaurant: inventieve keuken met aandacht voor seizoensproducten. Mooie en relevante wijnkaart. Parkeerplaats beschikbaar tegenover de onderprefectuur. Het menu \"Retour du Marché\" verandert elke dag en het avondmenu verandert twee keer per seizoen. Privégebruik van de kamer op aanvraag."
    ]
  },
