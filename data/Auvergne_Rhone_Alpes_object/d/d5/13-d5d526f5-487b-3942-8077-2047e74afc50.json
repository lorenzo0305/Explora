  "rdfs:comment": {
    "de": [
      "Charlotte Bompard ist Imkerin und bietet Honig und daraus gewonnene Produkte (Nougat, Lebkuchen und Propolis) an. Sie hat sich dafür entschieden, ihren Betrieb als biologischen Landbau zu kennzeichnen und erhält die Auszeichnung Nature & Progrès. Direktverkauf im Ort!"
    ],
    "en": [
      "Charlotte Bompard is a beekeeper, offering honey and by-products (nougat, gingerbread and propolis). She has chosen to label her operation as Organic Farming and has obtained the Nature & Progrès label. Local direct sales!"
    ],
    "it": [
      "Charlotte Bompard è un'apicoltrice che offre miele e prodotti derivati (torrone, panpepato e propoli). Ha scelto di etichettare la sua azienda come Agricoltura Biologica e ha ottenuto il marchio Nature & Progrès. Vendita diretta in loco!"
    ],
    "fr": [
      "Charlotte Bompard est apicultrice, elle propose miels et produits dérivés (nougat, pain d'épice et propolis). Elle a fait le choix de labelliser son exploitation en Agriculture Biologique et obtiens la mention Nature & Progrès. Vente directe en local !"
    ],
    "nl": [
      "Charlotte Bompard is imker en biedt honing en bijproducten aan (nougat, peperkoek en propolis). Ze heeft ervoor gekozen om haar boerderij te labelen als biologische landbouw en heeft het label Nature & Progrès gekregen. Directe lokale verkoop!"
    ],
    "es": [
      "Charlotte Bompard es apicultora y ofrece miel y subproductos (turrón, pan de especias y propóleo). Ha optado por etiquetar su explotación como Agricultura Ecológica y ha obtenido el sello Nature & Progrès. ¡Venta local directa!"
    ]
  },
  "rdfs:label": {
