          "additionalInformation": {
            "de": [
              "direktverkauf :\r\n\r\ndienstag, Donnerstag, Freitag und Samstag Bauernladen l'Epinette in Langeac\r\n\r\nDienstagabend 17:00 Uhr 19:00 Uhr Bauernmarkt in La Chomette\r\n\r\nDonnerstagmorgen 8 Uhr 12 Uhr Wochenmarkt in Langeac"
            ],
            "en": [
              "direct sales :\r\n\r\ntuesday, thursday, friday and saturday l'Epinette farm store in Langeac\r\n\r\nTuesday evening, 5pm - 7pm, La Chomette farmers' market\r\n\r\nThursday mornings 8am-12pm Langeac weekly market"
            ],
            "it": [
              "vendite dirette :\r\n\r\nmartedì, giovedì, venerdì e sabato presso il negozio della fattoria Epinette a Langeac\r\n\r\nMartedì sera, dalle 17.00 alle 19.00, presso il mercato locale di La Chomette\r\n\r\nGiovedì mattina, ore 8-12, mercato settimanale di Langeac"
            ],
            "fr": [
              "vente directe :\r\n\r\nmardi, jeudi, vendredi et samedi magasin de producteurs l'Epinette à Langeac\r\n\r\nMardi soir 17h 19h marché de pays de La Chomette\r\n\r\nJeudi matin 8h 12h marché hebdo de Langeac"
            ],
            "es": [
              "venta directa :\r\n\r\nmartes, jueves, viernes y sábados en la tienda de la granja Epinette de Langeac\r\n\r\nMartes por la tarde, de 17.00 a 19.00 h en el mercado local de La Chomette\r\n\r\nJueves por la mañana, de 8.00 a 12.00 h Mercado semanal de Langeac"
            ],
            "nl": [
              "rechtstreekse verkoop :\r\n\r\ndinsdag, donderdag, vrijdag en zaterdag in de boerderijwinkel van Epinette in Langeac\r\n\r\nDinsdagavond, 17.00 - 19.00 uur op de plaatselijke markt in La Chomette\r\n\r\nDonderdagochtend 8.00-12.00 uur wekelijkse markt Langeac"
            ]
          },
