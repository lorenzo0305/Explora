  "rdfs:comment": {
    "de": [
      "Raffinierte Küche mit frischen und grösstenteils regionalen Produkten. Obst und Gemüse der Saison. Musikalische Unterhaltung an einigen Freitagabenden ab Juni. Themenmenüs in der Saison: Trüffel."
    ],
    "en": [
      "Refined and sophisticated cuisine based on fresh and largely local produce. Seasonal fruits and vegetables. Musical entertainment on some Friday evenings from June onwards. Themed menus: Seasonal truffles."
    ],
    "it": [
      "Il nostro ristorante offre una cucina raffinata ed elaborata a base di prodotti regionali di stagione e di carne e pesce accuratamente selezionati dal nostro Chef."
    ],
    "fr": [
      "Notre restaurant vous propose une cuisine raffinée et élaborée à partir des produits régionaux de saison mais également de viandes et poissons sélectionnés attentivement par notre Chef."
    ],
    "nl": [
      "Verfijnde keuken op basis van verse en vooral regionale producten. Seizoensgebonden fruit en groenten. Muzikale animatie op bepaalde vrijdagavonden vanaf juni. Themamenu’s: truffels in het seizoen."
    ],
    "es": [
      "Nuestro restaurante ofrece una cocina refinada y elaborada basada en productos regionales de temporada, así como en carnes y pescados cuidadosamente seleccionados por nuestro Chef."
    ]
  },
