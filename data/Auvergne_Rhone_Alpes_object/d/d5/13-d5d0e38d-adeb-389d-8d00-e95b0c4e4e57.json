  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Lullin stellt Ihnen mehr als 3600 Bücher zur Verfügung. Die Anmeldung ist kostenlos und berechtigt zur Ausleihe von 3 Büchern für 3 Wochen."
    ],
    "en": [
      "The library of Lullin provides you with more than 3600 works. The inscription is free and allows to borrow 3 books for 3 weeks."
    ],
    "it": [
      "La biblioteca di Lullin dispone di oltre 3.600 libri da prendere in prestito. L'iscrizione è gratuita e consente di prendere in prestito 3 libri per 3 settimane."
    ],
    "fr": [
      "La bibliothèque de Lullin met à votre disposition plus de 3 600 ouvrages. L’inscription est gratuite et permet d’emprunter 3 livres pour 3 semaines."
    ],
    "es": [
      "La biblioteca de Lullin cuenta con más de 3.600 libros que puedes tomar prestados. La inscripción es gratuita y te permite tomar prestados 3 libros durante 3 semanas."
    ],
    "nl": [
      "De Lullin bibliotheek heeft meer dan 3.600 boeken die je kunt lenen. Inschrijven is gratis en je kunt 3 boeken lenen voor 3 weken."
    ]
  },
