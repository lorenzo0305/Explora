  "rdfs:comment": {
    "de": [
      "Das SEM verwaltet das Skigebiet Les Portes du Mont-Blanc, zu dem die Skigebiete Megève-Jaillet, Combloux, La Giettaz und Cordon gehören, 29 Skilifte für 65 Pisten."
    ],
    "en": [
      "The SEM manages Les Portes du Mont-Blanc ski area, which includes the ski resorts of Megève-Jaillet, Combloux, La Giettaz and Cordon, 29 ski lifts for 65 slopes."
    ],
    "it": [
      "La SEM Les Portes du Mont-Blanc gestisce il comprensorio sciistico Les Portes du Mont-Blanc, che comprende le stazioni sciistiche di Megève-Jaillet, Combloux, La Giettaz e Cordon, ovvero 29 impianti di risalita per 65 piste."
    ],
    "fr": [
      "La SEM Les Portes du Mont-Blanc gère le domaine skiable Les Portes du Mont-Blanc, qui regroupe les stations de ski de Megève-Jaillet, Combloux, La Giettaz et Cordon, soit 29 remontées mécaniques pour 65 pistes."
    ],
    "nl": [
      "SEM Les Portes du Mont-Blanc beheert het skigebied Les Portes du Mont-Blanc, dat de skigebieden Megève-Jaillet, Combloux, La Giettaz en Cordon omvat, met 29 liften en 65 afdalingen."
    ],
    "es": [
      "La SEM Les Portes du Mont-Blanc gestiona el dominio esquiable Les Portes du Mont-Blanc, que incluye las estaciones de esquí de Megève-Jaillet, Combloux, La Giettaz y Cordon, es decir, 29 remontes para 65 pistas."
    ]
  },
