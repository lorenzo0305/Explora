  "rdfs:comment": {
    "de": [
      "Das 1928 bietet Ihnen eine Küche mit frisch zubereiteten Produkten von lokalen Herstellern, aber auch frischen Fisch und Spezialitäten aus Savoyen."
    ],
    "ru": [
      "Ресторан Le 1928 предлагает блюда из качественных продуктов, поставляемых местными производителями, а также свежую рыбу и савойские деликатесы."
    ],
    "en": [
      "The 1928 offers a varied cuisine with fresh products from local artisans, but also fresh fish and savoyardes specialties."
    ],
    "it": [
      "Il 1928 propone una cucina a base di prodotti freschi locali, pesce fresco e specialità savoiarde."
    ],
    "fr": [
      "Le 1928 vous propose une cuisine à base de produits frais provenant d'artisans locaux, mais aussi des poissons frais et des spécialités savoyardes."
    ],
    "es": [
      "Le 1928 ofrece una cocina basada en productos frescos de artesanos locales, así como pescado fresco y especialidades saboyanas."
    ],
    "nl": [
      "Le 1928 biedt een keuken gebaseerd op verse producten van plaatselijke ambachtslieden, evenals verse vis en Savoyaardse specialiteiten."
    ],
    "zh": [
      "1928餐厅的美食均采用当地供应的新鲜产品烹饪而成，也供应新鲜鱼类和萨瓦风味特色菜。"
    ]
  },
