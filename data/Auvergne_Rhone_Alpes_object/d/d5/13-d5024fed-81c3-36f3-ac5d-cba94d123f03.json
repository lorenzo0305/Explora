  "rdfs:comment": {
    "de": [
      "Von 10:00 bis 21:00 Uhr können Sie die originellen Kreationen unserer Barkeeper probieren. Genießen Sie von Ihrem bequemen Sessel aus einen Moment der Entspannung nach einem anstrengenden Tag mit Blick auf den See von Tignes und den Gletscher von Grande Motte."
    ],
    "en": [
      "From 10:00 am to 9:00 pm, come and taste the original creations of our bartenders. From your armchair, comfortably installed, enjoy a moment of comfort after a busy day facing the Lake of Tignes and the Grande Motte Glacier."
    ],
    "it": [
      "Dalle 10.00 alle 21.00, venite a gustare le originali creazioni dei nostri barman. Dalla comodità della vostra poltrona, godetevi un momento di benessere dopo una giornata intensa con vista sul Lac de Tignes e sul ghiacciaio della Grande Motte."
    ],
    "fr": [
      "De 10h00 à 21h00, venez déguster les créations originales de nos barmans. Depuis votre fauteuil, confortablement installé, profitez d'un moment de réconfort après une journée bien remplie face au Lac de Tignes et au Glacier de la Grande Motte."
    ],
    "nl": [
      "Kom van 10 tot 21 uur proeven van de originele creaties van onze barmannen. Geniet vanuit je luie stoel van een moment van comfort na een drukke dag met uitzicht op het Lac de Tignes en de gletsjer Grande Motte."
    ],
    "es": [
      "De 10:00 a 21:00, venga a degustar las originales creaciones de nuestros barmans. Desde la comodidad de su sillón, disfrute de un momento de confort tras un día ajetreado con vistas al Lac de Tignes y al glaciar de la Grande Motte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Lounge le Pompon"
    ]
  },
