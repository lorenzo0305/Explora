  "rdfs:comment": {
    "de": [
      "Möchten Sie ein einzigartiges Abenteuer erleben?\r\nDie Trans?Aventure ist eine außergewöhnliche Erfahrung, die Sie mit dem Mountainbike inmitten der atemberaubenden Landschaft der provenzalischen Baronnies erleben können!"
    ],
    "en": [
      "Looking for a unique adventure?\r\nThe Trans?Aventure is an exceptional mountain-biking experience in the heart of the breathtaking landscapes of the Baronnies provençales!"
    ],
    "it": [
      "Siete alla ricerca di un'avventura unica?\r\nLa Trans?Aventure è un'esperienza eccezionale in mountain bike nel cuore dei paesaggi mozzafiato delle Baronnies provençales!"
    ],
    "fr": [
      "Vous souhaitez vivre une aventure unique ?\r\nLa Trans’Aventure est une expérience exceptionnelle à vivre en VTT au cœur des paysages époustouflants des Baronnies provençales !"
    ],
    "es": [
      "¿Busca una aventura única?\r\nLa Transaventura es una experiencia excepcional en bicicleta de montaña en el corazón de los impresionantes paisajes de las Baronías Provenzales"
    ],
    "nl": [
      "Op zoek naar een uniek avontuur?\r\nDe Trans?Aventure is een uitzonderlijke mountainbike ervaring in het hart van de adembenemende landschappen van de Baronnies provençales!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trans'aventure vtt l'aventure : raid vtt en baronnies"
    ]
  },
