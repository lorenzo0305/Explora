  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8fd48f31-3251-3921-b318-47014bbef556",
      "dc:description": {
        "de": [
          "Das Tourismusteam nimmt Sie mit auf die Wege durch unsere charmanten Dörfer: Entdecken Sie die kleinen Reichtümer von Bergicourt. ? Kostenlos ? Begrenzte Plätze mit Reservierung ? Maskenpflicht."
        ],
        "en": [
          "The Tourism Team takes you on a tour of our charming villages: come and discover the little treasures of Bergicourt ? Free of charge ? Limited places on reservation ? Mask required."
        ],
        "it": [
          "L'équipe del turismo vi accompagna in un tour dei nostri incantevoli villaggi: venite a scoprire i piccoli tesori di Bergicourt? Gratuito? Posti limitati su prenotazione ? È richiesta la maschera."
        ],
        "fr": [
          "L’Équipe Tourisme vous emmène sur les chemins de nos charmants villages : venez découvrir les petites richesses de Bergicourt. – Gratuit – Places limitées sur réservation – Masque obligatoire."
        ],
        "nl": [
          "Het Team Toerisme neemt u mee op een tocht door onze charmante dorpjes: kom en ontdek de kleine schatten van Bergicourt ? Gratis ? Beperkte plaatsen op reservering ? Masker verplicht."
        ],
        "es": [
          "El equipo de Turismo le lleva a recorrer nuestros encantadores pueblos: venga a descubrir los pequeños tesoros de Bergicourt ? Gratuito ? Plazas limitadas previa reserva ? Se requiere máscara."
        ]
      },
