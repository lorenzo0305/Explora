  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes bietet Ihnen Le Delizio rund 20 Pizzen, die Sie vor Ort genießen oder mitnehmen können. An schönen Tagen kann man sich auf der Terrasse niederlassen und die Atmosphäre des Dorfes genießen."
    ],
    "en": [
      "In the heart of the village, Le Delizio offers twenty pizzas to enjoy on site or take away. On sunny days you can sit on the terrace to enjoy the atmosphere of the village."
    ],
    "it": [
      "Nel cuore del paese, Le Delizio vi propone una ventina di pizze da gustare in loco o da asporto. Nei giorni di sole ci si mette in terrazza per godere dell’atmosfera del villaggio."
    ],
    "fr": [
      "Au cœur du village, Le Delizio vous propose une vingtaine de pizzas à savourer sur place ou à emporter. Aux beaux jours on s’installe en  terrasse pour profiter de l’ambiance du village."
    ],
    "nl": [
      "In het hart van het dorp biedt Le Delizio een twintigtal pizza's om te eten of mee te nemen. Bij mooi weer kun je buiten op het terras zitten en genieten van de dorpssfeer."
    ],
    "es": [
      "En el corazón del pueblo, Le Delizio ofrece una veintena de pizzas para comer en el restaurante o para llevar. Cuando hace buen tiempo, puede sentarse en la terraza y disfrutar del ambiente del pueblo."
    ]
  },
