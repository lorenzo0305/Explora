  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Herzen des Dorfes Hauterives, in der Region Drôme des Collines,\r\nnur wenige Schritte vom idealen Palast des Facteur Cheval entfernt, freut sich der Palais des Glaces, Bar, Eisdiele, Restaurant, Sie seit dem 1. Juni 2021 begrüßen zu dürfen."
    ],
    "en": [
      "Located in the heart of the village of Hauterives, in the Drôme des collines,\r\na few steps away from the ideal Palace of the Facteur Cheval,\r\nLe Palais des Glaces, bar, ice cream parlour, restaurant, PMU, is happy to welcome you since June 1st 2021."
    ],
    "it": [
      "Situato nel cuore del villaggio di Hauterives, nella Drôme des Collines,\r\na due passi dal Palais idéal del Facteur Cheval, il Palais des Glaces, bar, gelateria e ristorante, è lieto di accogliervi dal 1° giugno 2021."
    ],
    "fr": [
      "Situé au coeur du village d'Hauterives, dans la Drôme des Collines,\r\nà quelques pas du Palais idéal du Facteur Cheval, le Palais des Glaces, bar, glacier, restaurant, est heureux de vous accueillir depuis le 1er juin 2021."
    ],
    "es": [
      "Situado en el corazón del pueblo de Hauterives, en la Drôme des Collines,\r\na dos pasos del Palais idéal del Facteur Cheval, el Palais des Glaces, bar, heladería y restaurante, está encantado de recibirle desde el 1 de junio de 2021."
    ],
    "nl": [
      "Gelegen in het hart van het dorp Hauterives, in de Drôme des Collines,\r\nop een steenworp afstand van het Palais idéal van Facteur Cheval, verwelkomt het Palais des Glaces, bar, ijssalon en restaurant, u met veel plezier sinds 1 juni 2021."
    ]
  },
