  "rdfs:comment": {
    "de": [
      "Den Kult des Gedenkens aufrechterhalten. An Gedenkfeiern teilnehmen und diese mitgestalten. Den Mitgliedern und ihren Familien helfen, ihre Probleme lösen und Kameradschaft pflegen."
    ],
    "en": [
      "Perpetuate the cult of remembrance. Participate in and lead commemorative ceremonies. Help members and their families, follow up on their problems and maintain bonds of comradeship."
    ],
    "it": [
      "Per perpetuare il culto della memoria. Partecipare e condurre cerimonie commemorative. Aiutare i membri e le loro famiglie, seguire i loro problemi e mantenere i legami di amicizia"
    ],
    "fr": [
      "Perpétuer le culte du souvenir. Participer et animer les cérémonies commémoratives. Venir en aide aux adhérents et à leur famille, suivre la liquidation de leurs problèmes et maintenir des liens de camaraderie"
    ],
    "es": [
      "Para perpetuar el culto al recuerdo. Participar y dirigir ceremonias conmemorativas. Ayudar a los afiliados y a sus familias, hacer un seguimiento de sus problemas y mantener los lazos de camaradería"
    ],
    "nl": [
      "De cultus van het gedenken in stand houden. Deelnemen aan herdenkingsplechtigheden en deze leiden. Leden en hun families helpen, toezien op de oplossing van hun problemen en banden van kameraadschap onderhouden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association des Anciens Combattants et Victimes de Guerre"
    ]
  },
