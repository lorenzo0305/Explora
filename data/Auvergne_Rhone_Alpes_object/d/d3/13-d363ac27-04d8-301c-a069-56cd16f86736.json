  "rdfs:comment": {
    "de": [
      "Umzug der 6. Klassen, gefolgt von einem prächtigen Feuerwerk und einem festlichen Ball auf dem Platz vor der Sporthalle.  Für das leibliche Wohl sorgen Getränke und Speisen"
    ],
    "en": [
      "Parade of classes in 6; followed by a magnificent fireworks display and a festive ball on the gymnasium square.  Refreshments and catering on site to liven up the evening"
    ],
    "it": [
      "Sfilata delle classi in 6, seguita da un magnifico spettacolo pirotecnico e da un ballo festoso nel piazzale della palestra.  Rinfresco e catering in loco per animare la serata"
    ],
    "fr": [
      "Défilé des classes en 6; suivi d'un magnifique feu d'artifice et d'un bal festif sur la place du gymnase.  Buvette et restauration sur place pour agrémenter la soirée"
    ],
    "nl": [
      "Parade van klassen in 6, gevolgd door een prachtig vuurwerk en een feestelijke dans op het gymnastiekplein.  Versnaperingen en catering ter plaatse om de avond op te vrolijken"
    ],
    "es": [
      "Desfile de clases en 6, seguido de un magnífico espectáculo de fuegos artificiales y un baile festivo en la plaza del gimnasio.  Refrescos y catering in situ para amenizar la velada"
    ]
  },
  "rdfs:label": {
    "fr": [
