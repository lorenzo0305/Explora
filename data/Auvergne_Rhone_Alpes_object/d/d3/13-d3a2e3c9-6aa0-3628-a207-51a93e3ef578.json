  "rdfs:comment": {
    "de": [
      "Das Bureau Montagne des Arves gibt es seit 1989 in Saint Jean d'Arves und St Sorlin d'Arves. Es besteht aus 3 Bergbegleitern, die Ihnen jede Woche mehr als 16 Themen für Ausflüge vorschlagen, um das Tal zu entdecken."
    ],
    "en": [
      "Mountain leaders are present in Saint Jean d'Arves and St Sorlin d'Arves since 1989. They are 3 Mountain Guides."
    ],
    "it": [
      "Il Bureau Montagne des Arves ha sede a Saint Jean d'Arves e St Sorlin d'Arves dal 1989. È composto da 3 guide alpine che propongono ogni settimana più di 16 uscite diverse per farvi scoprire la valle."
    ],
    "fr": [
      "Le Bureau Montagne des Arves est présent à Saint Jean d'Arves et St Sorlin d'Arves depuis 1989. Il est composé de 3 Accompagnateurs en Montagne qui vous proposent chaque semaine plus de 16 thèmes de sorties pour découvrir la vallée."
    ],
    "nl": [
      "Kantoor geopend in 1989 bestaat uit 3 erkende berggidsen actief op het grondgebied van Saint Jean d'Arves en St Sorlin d'Arves"
    ],
    "es": [
      "El Bureau Montagne des Arves tiene su sede en Saint Jean d'Arves y St Sorlin d'Arves desde 1989. Está formado por 3 monitores de montaña que proponen cada semana más de 16 salidas diferentes para descubrir el valle."
    ]
  },
