  "rdfs:comment": {
    "de": [
      "In einer angenehmen Umgebung im Herzen der Natur bietet Ihnen der Poney Club de l'Ain einen 30-minütigen bis 1-stündigen Ausritt an der Hand eines Ponys auf einem 1,5 km langen Rundweg für Kinder!"
    ],
    "en": [
      "In a pleasant setting at the heart of the nature, the Pony Club of Ain proposes you a playful stroll in hands to pony of 30 min at 1 hour, on a circuit of 1,5km, for the children !"
    ],
    "it": [
      "In un ambiente piacevole nel cuore della natura, il Pony Club de l'Ain vi propone un giro in pony da 30 minuti a 1 ora, su un circuito di 1,5 km, per i bambini!"
    ],
    "fr": [
      "Dans un cadre agréable au cœur de la nature, le Poney Club de l'Ain vous propose une balade en main à poney de 30 min à 1h, sur un circuit d'1,5km, pour les enfants !"
    ],
    "nl": [
      "In een aangename omgeving midden in de natuur biedt de Pony Club de l'Ain u een ponyrit van 30 minuten tot 1 uur, op een circuit van 1,5 km, voor kinderen!"
    ],
    "es": [
      "En un entorno agradable en plena naturaleza, el Pony Club de l'Ain le propone un paseo en poni de 30 minutos a 1 hora, en un circuito de 1,5 km, ¡para niños!"
    ]
  },
  "rdfs:label": {
