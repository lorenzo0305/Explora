  "rdfs:comment": {
    "de": [
      "Les Carrés Jardin ist ein atypischer Ort, an dem Sie Ihre Geschäfts- oder Privatveranstaltungen, Geburtstage usw. mit Animation und Verpflegung organisieren können."
    ],
    "en": [
      "Les Carrés Jardin is an atypical venue where you can organize your business or private events, birthdays, etc., with entertainment and catering options."
    ],
    "it": [
      "Les Carrés Jardin è un luogo atipico dove è possibile organizzare eventi aziendali o privati, compleanni, ecc. con strutture di intrattenimento e catering."
    ],
    "fr": [
      "Les Carrés Jardin, c'est un lieu atypique dans lequel vous pouvez organiser vos évènements professionnels, particuliers, anniversaires…. avec des possibilités d'animation et de restauration."
    ],
    "nl": [
      "Les Carrés Jardin is een atypische locatie waar je je zakelijke of privé-evenementen, verjaardagen, enz. kunt organiseren met entertainment en cateringfaciliteiten."
    ],
    "es": [
      "Les Carrés Jardin es un lugar atípico donde podrá organizar sus eventos de empresa o privados, cumpleaños, etc. con instalaciones de entretenimiento y catering."
    ]
