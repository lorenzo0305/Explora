  "rdfs:comment": {
    "de": [
      "Nicolas, Ihr Chefkoch, legt seine ganze Leidenschaft in seine Gerichte. Er bietet Ihnen eine hausgemachte Küche mit lokalen Produkten an. Das Ganze findet in einem sehr sympathischen Rahmen mit einer herzlichen Atmosphäre statt."
    ],
    "en": [
      "Nicolas, your chef, puts all his passion in his dishes. He proposes you a home-made cooking with local products, the whole in a very sympathetic frame with a warm atmosphere."
    ],
    "it": [
      "Nicolas, il vostro chef, mette tutta la sua passione nei suoi piatti. Vi offre una cucina casalinga con prodotti locali, il tutto in un ambiente molto accogliente e con un'atmosfera calorosa."
    ],
    "fr": [
      "Nicolas, votre chef, met toute sa passion dans ses plats. Il vous propose une cuisine fait maison avec des produits locaux, le tout  dans un cadre très sympathique avec une ambiance chaleureuse."
    ],
    "nl": [
      "Nicolas, uw chef-kok, legt al zijn passie in zijn gerechten. Hij biedt u een huisgemaakte keuken met lokale producten, dit alles in een zeer vriendelijke omgeving met een warme sfeer."
    ],
    "es": [
      "Nicolas, su chef, pone toda su pasión en sus platos. Te ofrece cocina casera con productos locales, todo ello en un entorno muy acogedor con un ambiente cálido."
    ]
  },
  "rdfs:label": {
    "fr": [
