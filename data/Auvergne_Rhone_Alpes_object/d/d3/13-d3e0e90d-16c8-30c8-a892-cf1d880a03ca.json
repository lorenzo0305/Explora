  "rdfs:comment": {
    "de": [
      "Das Kino \"le Novelty\" empfängt Sie in einem Saal, der mit einer Monoleinwand ausgestattet ist. Es verfügt über einen Saal mit 176 Sitzen und ist für Personen mit eingeschränkter Mobilität zugänglich."
    ],
    "en": [
      "The cinema \"le Novelty\" welcomes you in a room equipped with a mono screen. It has 176 seats and is accessible to people with reduced mobility."
    ],
    "it": [
      "Il cinema \"le Novelty\" vi accoglie in una sala dotata di schermo mono. Ha 176 posti a sedere ed è accessibile alle persone con mobilità ridotta."
    ],
    "fr": [
      "Le cinéma \"le Novelty\" vous accueille dans une salle équipée d'un mono écran. Il est doté d'une salle de 176 sièges et il est accessible aux personnes à mobilité réduite."
    ],
    "es": [
      "El cine \"le Novelty\" le da la bienvenida en una sala equipada con una pantalla mono. Tiene 176 plazas y es accesible para personas con movilidad reducida."
    ],
    "nl": [
      "De bioscoop \"le Novelty\" ontvangt u in een zaal uitgerust met een mono-scherm. Het heeft 176 zitplaatsen en is toegankelijk voor mensen met beperkte mobiliteit."
    ]
  },
