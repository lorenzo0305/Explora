  "rdfs:comment": {
    "de": [
      "Lassen Sie Ihrer Kreativität freien Lauf, dank der Erde. Lernen Sie zu modellieren, zu formen und die Materie unter Ihren Fingern zu spüren ... in einer freundlichen und entspannten Atmosphäre."
    ],
    "en": [
      "Unleash your creativity with clay. Learn to model, shape and feel the material under your fingers ... in a relaxed, friendly atmosphere."
    ],
    "it": [
      "Liberate la vostra creatività con l'argilla. Imparate a modellare, modellare e sentire la materia sotto le dita... in un'atmosfera amichevole e rilassata."
    ],
    "fr": [
      "Libérez votre créativité, grâce à la terre. Apprenez à modeler, façonner et ressentir la matière sous vos doigts ... dans une ambiance conviviale et detendue."
    ],
    "nl": [
      "Laat je creativiteit de vrije loop met klei. Leer boetseren, vormen en voel het materiaal onder je vingers... in een vriendelijke, ontspannen sfeer."
    ],
    "es": [
      "Da rienda suelta a tu creatividad con la arcilla. Aprende a modelar, dar forma y sentir el material bajo tus dedos... en un ambiente agradable y relajado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier découverte de la terre par le modelage"
    ]
  },
