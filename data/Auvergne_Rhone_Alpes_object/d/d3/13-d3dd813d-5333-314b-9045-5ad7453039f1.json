  "rdfs:comment": {
    "de": [
      "Große Auswahl an Ski-, Snowboard- und Tourenskiausrüstung für alle Niveaus. Ob mit der Familie, mit Freunden oder allein, unser Team begleitet Sie, um die ideale Ausrüstung zu finden, die perfekt auf Ihre Morphologie und Ihre Wünsche abgestimmt ist."
    ],
    "en": [
      "Wide range of alpine skiing equipment, snowboard and ski touring, suitable for all levels. With family, friends or solo, our team will assist you in finding the ideal equipment, perfectly adjusted to your body shape and your desires."
    ],
    "it": [
      "Un'ampia gamma di attrezzature per lo sci alpino, lo snowboard e lo sci alpinismo adatte a tutti i livelli. Che siate in famiglia, con gli amici o da soli, il nostro team vi aiuterà a trovare l'attrezzatura ideale, perfettamente adatta alla vostra forma fisica e ai vostri desideri."
    ],
    "fr": [
      "Large gamme de matériel de ski alpin, snowboard et ski de randonnée, adaptée à tous les niveaux. En famille, entre amis ou en solo, notre équipe vous accompagne pour trouver l’équipement idéal, parfaitement ajusté à votre morphologie et à vos envies."
    ],
    "es": [
      "Una amplia gama de equipos de esquí alpino, snowboard y esquí de travesía para todos los niveles. Ya sea en familia, con amigos o solo, nuestro equipo le ayudará a encontrar el equipo ideal, perfectamente adaptado a la forma de su cuerpo y a sus deseos."
    ],
    "nl": [
      "Breed scala aan alpine ski-uitrusting, snowboard- en skitochten, geschikt voor alle niveaus. Met familie, vrienden of solo helpt ons team u bij het vinden van de ideale uitrusting, perfect aangepast aan uw morfologie en uw wensen."
    ]
  },
