  "rdfs:comment": {
    "de": [
      "Im Maison de Saint Gervais im Stadtzentrum sind das Tourismusbüro, die Compagnie des Guides et Accompagnateurs, die Skilifte und die ESF untergebracht."
    ],
    "en": [
      "The Maison de Saint Gervais in the town centre houses the tourist office, the Compagnie des Guides et Accompagnateurs (guide and tour leader company), the ski lift company and the ESF (French Ski School)."
    ],
    "it": [
      "La Maison de Saint Gervais nel centro città raggruppa l’ufficio turistico, la Compagnia delle Guide e accompagnatori, le Pedane Meccaniche e l’ESF."
    ],
    "fr": [
      "La Maison de Saint Gervais au centre-ville regroupe l'office de tourisme, la Compagnie des Guides et Accompagnateurs, les Remontées Mécaniques et l'ESF."
    ],
    "es": [
      "La Maison de Saint Gervais, en el centro de la ciudad, alberga la oficina de turismo, la Compagnie des Guides et Accompagnateurs, los remontes y el ESF."
