  "rdfs:comment": {
    "de": [
      "Eine kleine Zen-Blase, um Muskeln aufzubauen, den Körper zu lockern und zu entspannen... und den Geist! Für mehr Komfort sollten Sie eine Gymnastikmatte oder ein Handtuch mitbringen."
    ],
    "en": [
      "A little Zen bubble to strengthen, soften and relax your body? and your mind! For added comfort, remember to bring a gym mat or towel."
    ],
    "it": [
      "Una piccola bolla zen per tonificare, sciogliere e rilassare il corpo e la mente! Per un maggiore comfort, ricordate di portare con voi un tappetino da ginnastica o un asciugamano."
    ],
    "fr": [
      "Une petite bulle zen pour muscler, assouplir, détendre son corps… et son esprit ! Pour plus de confort, pensez à apporter un tapis de gym ou une serviette."
    ],
    "es": [
      "Una pequeña burbuja zen para tonificar, aflojar y relajar el cuerpo... ¡y la mente! Para mayor comodidad, recuerde traer una esterilla o toalla de gimnasia."
    ],
    "nl": [
      "Een kleine Zen-bubbel om strakker te worden, los te komen en je lichaam en geest te ontspannen! Neem voor extra comfort een turnmatje of handdoek mee."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Séance de yoga : Les p'tits Yogis"
    ]
  },
