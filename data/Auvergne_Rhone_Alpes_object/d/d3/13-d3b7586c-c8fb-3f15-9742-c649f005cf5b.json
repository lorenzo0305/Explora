  "rdfs:comment": {
    "de": [
      "Willkommen in Dizimieu, einem charmanten Dorf im Süden der Balcons du Dauphiné in der Region Nord-Isère. Dizimieu, das eine mittelalterliche Burg beherbergt, bietet eine ländliche und friedliche Lebensumgebung."
    ],
    "en": [
      "Welcome to Dizimieu, a charming village south of the Balcons du Dauphiné in Nord-Isère. Home to a medieval castle, Dizimieu offers a peaceful, rural setting."
    ],
    "it": [
      "Benvenuti a Dizimieu, un incantevole villaggio nel sud dei Balcons du Dauphiné, nel Nord-Isère. Sede di un castello medievale, Dizimieu offre un ambiente tranquillo e rurale."
    ],
    "fr": [
      "Bienvenue à Dizimieu, charmant village au sud des Balcons du Dauphiné, en Nord-Isère. Dizimieu, qui abrite un château médiéval, offre un cadre de vie rural et paisible."
    ],
    "nl": [
      "Welkom in Dizimieu, een charmant dorpje in het zuiden van de Balcons du Dauphiné, in Nord-Isère. Dizimieu heeft een middeleeuws kasteel en biedt een rustige, landelijke omgeving."
    ],
    "es": [
      "Bienvenido a Dizimieu, un encantador pueblo al sur de los Balcons du Dauphiné, en Nord-Isère. Dizimieu, que alberga un castillo medieval, ofrece un entorno tranquilo y rural."
    ]
  },
