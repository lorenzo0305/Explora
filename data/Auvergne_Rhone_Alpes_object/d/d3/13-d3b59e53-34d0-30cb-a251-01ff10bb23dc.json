  "rdfs:comment": {
    "de": [
      "Traditionelle Küche. Mehrere Essräume, die von der Bar getrennt sind. Schneller Service. Übertragung der Fußballspiele des ASSE.\r\nJeden letzten Donnerstag im Monat Couscous im Restaurant oder zum Mitnehmen. Privatraum und spezielles Menü zum Feiern Ihrer\r\nEreignisse (Taufen, Kommunionen, Geburtstage, Junggesellen- oder Junggesellinnenabschiede ...)."
    ],
    "en": [
      "Traditional dishes. Several dining areas separate to bar. Express service. ASSE match screenings. Couscous to eat in or take away on\r\nthe last Thursday of the month. Function room and menu on request to celebrate your events (christenings, communions, birthdays,\r\nhen or stag parties etc.)."
    ],
    "it": [
      "Cucina tradizionale. Diverse sale da pranzo, separate dal bar.\r\nSala privata e menu su richiesta per festeggiare i vostri eventi (battesimi, comunioni, compleanni, addii al celibato e al nubilato, ecc.)"
    ],
    "fr": [
      "Cuisine traditionnelle. Plusieurs salles de restauration, séparées du bar.\r\nSalle privatisée et menu sur demande pour célébrer vos événements (baptêmes, communions, anniversaires, enterrements de vie de jeune fille ou jeune garçon...)"
    ],
    "nl": [
      "Traditionele keuken. Verschillende eetzalen, gescheiden van de bar.\r\nPrivézaal en menu op aanvraag om uw evenementen te vieren (doopfeesten, communies, verjaardagen, vrijgezellenfeesten, enz.)"
    ],
    "es": [
      "Cocina tradicional. Varios comedores, separados del bar.\r\nSalón privado y menú bajo petición para celebrar sus eventos (bautizos, comuniones, cumpleaños, despedidas de soltero, etc.)"
    ]
  },
