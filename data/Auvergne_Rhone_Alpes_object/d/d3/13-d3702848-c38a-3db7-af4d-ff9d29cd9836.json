  "rdfs:comment": {
    "de": [
      "Im Winter hält Lappland Einzug in Peisey-Nancroix und bietet Ihnen ein außergewöhnliches Erlebnis mit diesen Tieren des hohen Nordens. Ob im bequemen Schlitten oder bei einer Schneeschuhwanderung – kommen Sie und lernen Sie mehr über Rentiere!"
    ],
    "en": [
      "In winter, Lapland comes to Peisey-Nancroix, offering you an extraordinary experience with these animals of the Far North. Whether in a sleigh, seated comfortably, or on a snowshoeing excursion, come and learn more about reindeer!"
    ],
    "it": [
      "In inverno, la Lapponia vi invita a Peisey-Nancroix per un'esperienza straordinaria con questi animali dell'estremo Nord. In slitta, comodamente seduti o con le racchette da neve, venite a conoscere meglio le renne!"
    ],
    "fr": [
      "En hiver, la Laponie s'invite à Peisey-Nancroix et vous propose de vivre un moment hors du commun avec ces animaux du grand Nord. Dans un traîneau, assis confortablement ou en sortie raquette, venez en apprendre plus sur les rennes !"
    ],
    "nl": [
      "In de winter nodigt Lapland je uit in Peisey-Nancroix voor een buitengewone ervaring met deze dieren uit het hoge noorden. Kom in een arrenslee, comfortabel zittend of op sneeuwschoenen meer te weten over rendieren!"
    ],
    "es": [
      "En invierno, Laponia le invita a Peisey-Nancroix para vivir una experiencia extraordinaria con estos animales del Lejano Norte. En trineo, cómodamente sentado o en una excursión con raquetas de nieve, ¡ven y aprende más sobre los renos!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Les rennes du Baudet Malin"
    ],
    "en": [
      "Les rennes du Baudet Malin"
    ],
    "fr": [
      "Les rennes du Baudet Malin"
    ]
  },
