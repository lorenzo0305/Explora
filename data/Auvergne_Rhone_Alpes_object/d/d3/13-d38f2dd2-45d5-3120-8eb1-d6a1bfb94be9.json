  "rdfs:comment": {
    "de": [
      "Sous l'eau ist ein Clownsolo. Caf? setzt seinen Körper ein, um den Kreislauf des Wassers zu erklären, bis die Sprache unerlässlich wird."
    ],
    "en": [
      "Sous l?eau is a clown solo. Using his body, Caf? explores the water cycle until speech becomes indispensable."
    ],
    "it": [
      "Sous l'eau è un assolo di clown. Utilizzando il suo corpo, Caf? esplora il ciclo dell'acqua finché la parola diventa indispensabile."
    ],
    "fr": [
      "Sous l’eau est un solo de clown. En utilisant son corps, Caf’ aborde le cycle de l’eau jusqu’à ce que la parole devienne indispensable."
    ],
    "nl": [
      "Sous l?eau is een clownsolo. Met behulp van zijn lichaam verkent Caf? de waterkringloop totdat spraak onmisbaar wordt."
    ],
    "es": [
      "Sous l'eau es un solo de clown. Utilizando su cuerpo, Caf? explora el ciclo del agua hasta que el habla se vuelve indispensable."
    ]
  },
