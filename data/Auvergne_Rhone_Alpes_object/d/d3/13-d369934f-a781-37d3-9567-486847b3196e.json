  "rdfs:comment": {
    "de": [
      "Entdecken Sie diesen neuen Bereich, der für das Radfahren eingerichtet wurde! Ein echter Spielplatz. Mehrere Übungsbereiche warten auf Sie: von Anfängern bis zu den schwierigsten."
    ],
    "en": [
      "Discover this new cycling area! A real playground. Several practice areas await you: from beginners to the most challenging."
    ],
    "it": [
      "Scoprite questa nuova area ciclistica! Un vero e proprio parco giochi. Ci sono diverse aree da utilizzare, da quelle per principianti a quelle più impegnative."
    ],
    "fr": [
      "Découvrez cette nouvelle zone aménagé pour la pratique du vélo ! Un véritable terrain de jeux. Plusieurs espaces de pratique vous attendent : du débutant au plus difficile."
    ],
    "nl": [
      "Ontdek dit nieuwe fietsgebied! Een echte speeltuin. Er zijn verschillende gebieden waar je gebruik van kunt maken, van beginners tot de meest uitdagende."
    ],
    "es": [
      "Descubra esta nueva zona ciclista Un auténtico parque infantil. Hay varias zonas diferentes para que las utilices, desde principiantes hasta las más exigentes."
    ]
  },
