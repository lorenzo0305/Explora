  "rdfs:comment": {
    "de": [
      "Die Brauerei von Pater Saint'Oy liefert eine Reihe von Bieren, die von Geschichten und Reisen inspiriert sind, für Liebhaber authentischer und vielfältiger Genüsse."
    ],
    "en": [
      "The Père Saint'Oy brewery delivers a range of beers inspired by history and travel for lovers of authentic and varied pleasures."
    ],
    "it": [
      "Il birrificio Father Saint'Oy offre una gamma di birre ispirate a storie e viaggi per chi ama i piaceri autentici e variegati."
    ],
    "fr": [
      "La brasserie du Père Saint'Oy livre une gamme de bières inspirées d'histoires et de voyages pour les amateurs de plaisirs authentiques et variés."
    ],
    "es": [
      "La cervecería Father Saint'Oy ofrece una gama de cervezas inspiradas en historias y viajes para los amantes de los placeres auténticos y variados."
    ],
    "nl": [
      "De Pater Saint'Oy Brouwerij levert een gamma bieren geïnspireerd door verhalen en reizen voor wie houdt van authentiek en gevarieerd genot."
    ]
