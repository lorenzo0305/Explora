  "rdfs:comment": {
    "de": [
      "Die Domaine de Fond-Vieille ist ein kleiner Familienweinbaubetrieb von 10 ha, der in der wunderschönen Region der \"Pierres Dorées\" des Beaujolais in Oingt liegt, einem Dorf, das zu den schönsten Frankreichs zählt."
    ],
    "en": [
      "Domaine de Fond-Vieille is a family wine estate covering 14 ha in the heart of the magnificent Pierres Dorées region in Oingt, a village listed as one of the most beautiful in France."
    ],
    "it": [
      "Il Domaine de Fond-Vieille è una piccola azienda vitivinicola a conduzione familiare di 10 ettari, situata nella magnifica regione delle \"Pierres Dorées\" del Beaujolais a Oingt, un villaggio classificato come uno dei più belli di Francia."
    ],
    "fr": [
      "Le Domaine de Fond-Vieille est une petite exploitation viticole familiale de 10 ha, située dans la magnifique région des \"Pierres Dorées\" du Beaujolais à Oingt, village classé parmi les plus beaux de France."
    ],
    "es": [
      "El Domaine de Fond-Vieille es una pequeña explotación vitícola familiar de 10 hectáreas, situada en la magnífica región de \"Pierres Dorées\" del Beaujolais, en Oingt, pueblo catalogado como uno de los más bellos de Francia."
    ],
    "nl": [
      "Domaine de Fond-Vieille is een klein, familiaal wijndomein van 10 hectare, gelegen in de prachtige \"Pierres Dorées\" streek van de Beaujolais in Oingt, een dorp dat geklasseerd staat als één van de mooiste van Frankrijk."
    ]
  },
