  "rdfs:comment": {
    "de": [
      "Maître Restaurateur, ideal gelegen gegenüber der Markthalle. Alle Gerichte werden hausgemacht und aus sorgfältig ausgewählten Produkten zubereitet. Wir bevorzugen stets frische, saisonale Produkte, die mit Liebe zubereitet werden.\r\nVor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Maître Restaurateur, ideally located opposite the market hall. All dishes are homemade, using carefully selected products. We always favor fresh, seasonal products, concocted with love.\r\nOn site or to take away."
    ],
    "it": [
      "Maître Restaurateur, situato in posizione ideale di fronte al mercato. Tutti i piatti sono fatti in casa, con prodotti accuratamente selezionati. Privilegiamo sempre prodotti freschi e di stagione, preparati con amore.\r\nSul posto o da portare via."
    ],
    "fr": [
      "Maître Restaurateur, idéalement situé en face de la halle. Tous les plats sont préparés maison, à partir de produits sélectionnés avec soin. Nous privilégions toujours les produits frais, de saison, concoctés avec amour.\r\nSur place ou à emporter."
    ],
    "es": [
      "Maître Restaurateur, idealmente situado frente al mercado. Todos los platos son caseros, con productos cuidadosamente seleccionados. Siempre privilegiamos los productos frescos y de temporada, preparados con amor.\r\nEn el acto o para llevar."
    ],
    "nl": [
      "Maître Restaurateur, ideaal gelegen tegenover de markthal. Alle gerechten zijn huisgemaakt, met zorgvuldig geselecteerde producten. Wij geven altijd de voorkeur aan verse, seizoensgebonden producten, met liefde bereid.\r\nTer plaatse of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Vin de 5"
    ],
    "fr": [
      "Le Vin de 5"
    ]
  },
