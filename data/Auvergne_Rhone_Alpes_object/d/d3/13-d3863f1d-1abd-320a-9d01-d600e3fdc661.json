  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser SPA in Argonay, 5 Minuten von Annecy entfernt. Es umfasst einen Whirlpool, ein Dampfbad, eine Sauna und einen Entspannungsbereich mit Kräutertee. Der Zugang ist nur privat und auf Reservierung möglich."
    ],
    "en": [
      "Come and discover our SPA in Argonay, 5 minutes from Annecy. It includes a whirlpool bath, hammam, sauna and relaxation area with herbal tea. Access is by privatization and reservation only."
    ],
    "it": [
      "Venite a scoprire la nostra SPA ad Argonay, a 5 minuti da Annecy, che comprende vasca idromassaggio, bagno turco, sauna e area relax con tisane. L'accesso è solo su prenotazione e deve essere effettuato in anticipo."
    ],
    "fr": [
      "Venez découvrir notre SPA situé à Argonay à 5 min d’Annecy, il comprend un bain à remous, un hammam, un sauna, un espace détente avec tisanière. L’accès est uniquement en privatisation et sur réservation."
    ],
    "es": [
      "Venga a descubrir nuestro SPA en Argonay, a 5 minutos de Annecy, que incluye bañera de hidromasaje, baño de vapor, sauna y zona de relajación con tisanas. El acceso es solo mediante alquiler privado y debe reservarse con antelación."
    ],
    "nl": [
      "Kom en ontdek onze SPA in Argonay, op 5 minuten van Annecy, met een bubbelbad, stoombad, sauna en ontspanningsruimte met kruidenthee. Toegang is alleen op privébasis en moet van tevoren worden gereserveerd."
    ]
  },
