  "rdfs:comment": {
    "de": [
      "Le Bouchon Ardéchois ist ein gemütliches Restaurant, in dem Gäste großzügige, authentische Küche genießen können. Auf der Speisekarte stehen traditionelle Gerichte mit modernem Touch, saisonale Produkte und Gourmet-Rezepte, serviert in einer warmen und authentischen Atmosphäre."
    ],
    "en": [
      "Le Bouchon Ardéchois is a friendly restaurant where guests come to share generous, authentic cuisine. On the menu: traditional dishes with a modern twist, seasonal produce and gourmet recipes, served in a warm and authentic atmosphere."
    ],
    "it": [
      "Le Bouchon Ardéchois è un ristorante accogliente dove si può gustare una cucina generosa e sincera. Nel menu: piatti tradizionali rivisitati, prodotti di stagione e ricette gourmet, in un'atmosfera calda e autentica."
    ],
    "fr": [
      "Le Bouchon Ardéchois est un restaurant convivial où l’on vient partager une cuisine généreuse et sincère. Au menu : des plats traditionnels revisités, des produits de saison et des recettes gourmandes, dans une ambiance chaleureuse et authentique."
    ],
    "nl": [
      "Le Bouchon Ardéchois is een gezellig restaurant waar u kunt genieten van een gulle, oprechte keuken. Op het menu: traditionele gerechten, seizoensproducten en gastronomische recepten, in een warme en authentieke sfeer."
    ],
    "es": [
      "Le Bouchon Ardéchois es un restaurante acogedor donde podrá disfrutar de una cocina generosa y sincera. En el menú: platos tradicionales revisitados, productos de temporada y recetas gourmet, en un ambiente cálido y auténtico."
    ]
  },
