  "rdfs:comment": {
    "de": [
      "Douceur d'hÔme - Nährstoffe\r\nEmmanuel und Anne, die sich in einer ehemaligen Schule niedergelassen haben, laden Sie zu einem neugierigen und entspannten Eintauchen in ihr Atelier mit Boutique und Imbiss ein.\r\nSie werden die Wolle, ihre Filztechnik und ihre Kreationen entdecken."
    ],
    "en": [
      "Douceur d?hÔme - Feutriers\r\nHoused in a former schoolhouse, Emmanuel and Anne invite you to take a relaxed, inquisitive look at their boutique-bouvette workshop.\r\nDiscover wool, their felting techniques and their creations."
    ],
    "it": [
      "Douceur d'hÔme - Feutriers\r\nOspitati in un'ex scuola, Emmanuel e Anne vi invitano a dare un'occhiata rilassata e curiosa al loro laboratorio, alla boutique e al bar.\r\nScoprite la lana, le tecniche di infeltrimento e le loro creazioni."
    ],
    "fr": [
      "Douceur d’hÔme - Feutriers\r\nInstallés dans une ancienne école, Emmanuel et Anne vous proposent une immersion curieuse et détendue dans leur atelier boutique buvette. \r\nVous découvrirez la laine, leur technique de feutrage, leurs créations."
    ],
    "es": [
      "Douceur d'hÔme - Feutriers\r\nUbicados en una antigua escuela, Emmanuel y Anne le invitan a recorrer con calma y curiosidad su taller, su boutique y su bar.\r\nDescubra la lana, sus técnicas de fieltro y sus creaciones."
    ],
    "nl": [
      "Douceur d'hÔme - Feutriers\r\nEmmanuel en Anne zijn gevestigd in een voormalige school en nodigen je uit voor een ontspannen en nieuwsgierige blik in hun atelier, boetiek en verfrissingsbar.\r\nOntdek de wol, hun vilttechnieken en hun creaties."
    ]
  },
