  "rdfs:comment": {
    "de": [
      "Eine freundliche Mediathek, in der die Kultur zum Leben erwacht! Kommen Sie und leihen Sie Bücher und Musikinstrumente aus, hören Sie Musik, spielen Sie Videospiele, besuchen Sie verschiedene Aufführungen, haben Sie Zugang zu digitalen Medien und vieles mehr."
    ],
    "en": [
      "A friendly media library where culture comes to life! Come and borrow books and musical instruments, listen to music, play video games, attend a variety of shows, access digital technology and much more."
    ],
    "it": [
      "Un'accogliente biblioteca multimediale dove la cultura prende vita! Venite a prendere in prestito libri e strumenti musicali, ascoltate musica, giocate ai videogiochi, assistete a una serie di spettacoli, accedete alla tecnologia digitale e molto altro ancora."
    ],
    "fr": [
      "Une médiathèque conviviale où la culture prend vie ! Venez emprunter des livres et des instruments de musique, écouter de la musique, jouer à des jeux vidéo, assister à des spectacles variés, accéder au numérique et bien plus encore."
    ],
    "es": [
      "Una biblioteca multimedia acogedora donde la cultura cobra vida Venga a tomar prestados libros e instrumentos musicales, escuche música, juegue a videojuegos, asista a espectáculos variados, acceda a la tecnología digital y mucho más."
    ],
    "nl": [
      "Een gezellige mediatheek waar cultuur tot leven komt! Kom boeken en muziekinstrumenten lenen, luister naar muziek, speel videogames, woon verschillende voorstellingen bij, maak gebruik van digitale technologie en nog veel meer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque L'échappée belle"
    ]
  },
