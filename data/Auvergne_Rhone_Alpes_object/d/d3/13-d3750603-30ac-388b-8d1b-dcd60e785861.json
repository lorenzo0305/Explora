  "rdfs:comment": {
    "de": [
      "Jean-Marc Rubatier empfängt Sie in seiner Kreativwerkstatt \"Au Clou par Clou\".\r\nKreation von Statuetten aus Nägeln, Möglichkeit von personalisierten Geschenken, aber auch Schweißen auf Aluminium, Stahl und Edelstahl. Realisierungen für Privatpersonen und Fachleute."
    ],
    "en": [
      "Jean-Marc Rubatier welcomes you to his creative workshop \"Au Clou par Clou\".\r\nCreation of statuettes in nails, possibility of personalized gifts but also welding on aluminum, steel, stainless steel. Achievements for individuals and professionals."
    ],
    "it": [
      "Jean-Marc Rubatier vi dà il benvenuto nel suo laboratorio \"Au Clou par Clou\".\r\nCreazione di statuette in chiodi, possibilità di regali personalizzati ma anche saldatura su alluminio, acciaio, acciaio inox. Creazioni per privati e professionisti."
    ],
    "fr": [
      "Jean-Marc Rubatier vous accueille dans son atelier de création \"Au Clou par Clou\".\r\nCréation de statuettes en clous, possibilité de cadeaux personnalisés mais aussi soudure sur aluminium, acier, inox. Réalisations pour particuliers et professionnels."
    ],
    "es": [
      "Jean-Marc Rubatier le da la bienvenida a su taller creativo \"Au Clou par Clou\".\r\nCreación de estatuillas en clavos, posibilidad de regalos personalizados pero también soldadura en aluminio, acero, acero inoxidable. Creaciones para particulares y profesionales."
    ],
    "nl": [
      "Jean-Marc Rubatier heet u welkom in zijn atelier \"Au Clou par Clou\".\r\nCreatie van beeldjes in spijkers, mogelijkheid van gepersonaliseerde geschenken maar ook lassen op aluminium, staal, roestvrij staal. Creaties voor particulieren en professionals."
    ]
  },
  "rdfs:label": {
    "en": [
      "Au Clou par Clou! Artisan of Art with Blacksmith's Nails"
    ],
    "fr": [
      "Au Clou par Clou"
    ]
  },
