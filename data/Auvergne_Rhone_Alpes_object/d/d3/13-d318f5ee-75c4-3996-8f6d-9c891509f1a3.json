  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Laser Game Evolution in Grenoble, einen immersiven Spielbereich, der mit unserer Lasertechnologie der neuesten Generation ausgestattet ist und sich auf zwei mehrstufige Labyrinthe verteilt, um immer strategischere und dynamischere Spiele zu ermöglichen."
    ],
    "en": [
      "Come and discover Grenoble's Laser Game Evolution, an immersive play area equipped with our latest-generation Laser technology, spread over 2 multi-level mazes for ever more strategic and dynamic games."
    ],
    "it": [
      "Venite a scoprire il Laser Game Evolution di Grenoble, un'area di gioco coinvolgente dotata della nostra tecnologia laser di ultima generazione, distribuita su 2 labirinti multilivello per giochi sempre più strategici e dinamici."
    ],
    "fr": [
      "Venez découvrir le Laser Game Evolution de Grenoble, un espace de jeu immersif équipé de notre technologie Laser de dernière génération, réparti sur 2 labyrinthes multi-niveaux pour des parties toujours plus stratégiques et dynamiques."
    ],
    "es": [
      "Venga a descubrir el Laser Game Evolution de Grenoble, un espacio de juego inmersivo equipado con nuestra tecnología láser de última generación, repartido en 2 laberintos multinivel para juegos cada vez más estratégicos y dinámicos."
    ],
    "nl": [
      "Kom en ontdek de Laser Game Evolution in Grenoble, een meeslepende speelruimte uitgerust met onze nieuwste lasertechnologie, verspreid over 2 doolhoven met meerdere niveaus voor steeds strategischer en dynamischer spelen."
    ]
  },
