  "rdfs:comment": {
    "de": [
      "Spirulina in der Ardèche? Eine unerwartete Entdeckung!\r\nEvelyne und Pascal begrüßen Sie zu einer Führung durch ihren Spirulina-Anbaubetrieb.\r\nLassen Sie sich in eine hypnotische Wasserwelt entführen, eingelullt vom Klang des Wassers."
    ],
    "en": [
      "Spirulina in Ardèche? An unexpected discovery!\r\nEvelyne and Pascal welcome you for a guided tour of their spirulina farm. \r\nLet yourself be transported into a hypnotic aquatic world, rocked by the sound of water."
    ],
    "it": [
      "Spirulina nell'Ardèche? Una scoperta inaspettata!\r\nEvelyne e Pascal vi accolgono in una visita guidata alla loro fattoria di spirulina.\r\nLasciatevi trasportare in un mondo acquatico ipnotico, cullati dal suono dell'acqua."
    ],
    "fr": [
      "La spiruline en Ardèche ? Une découverte inattendue !\r\nEvelyne et Pascal vous accueillent pour une visite guidée de leur ferme de culture de spiruline. \r\nLaissez-vous transporter dans un monde aquatique et hypnotique, bercés par le son de l’eau."
    ],
    "es": [
      "¿Espirulina en Ardèche? ¡Un descubrimiento inesperado!\r\nEvelyne y Pascal le dan la bienvenida en una visita guiada a su granja de espirulina.\r\nDéjese transportar a un mundo acuático hipnótico, arrullado por el sonido del agua."
    ],
    "nl": [
      "Spirulina in de Ardèche? Een onverwachte ontdekking!\r\nEvelyne en Pascal verwelkomen je op een rondleiding door hun spirulina kwekerij.\r\nLaat je meevoeren naar een hypnotiserende waterwereld, gesust door het geluid van water."
    ]
  },
  "rdfs:label": {
    "en": [
      "Spiruline des monts d'Ardèche"
    ],
    "fr": [
      "Spiruline des monts d'Ardèche"
    ]
  },
