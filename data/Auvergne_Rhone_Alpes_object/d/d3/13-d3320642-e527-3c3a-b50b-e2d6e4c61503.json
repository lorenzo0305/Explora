  "rdfs:comment": {
    "de": [
      "Die Domaine de Mercoire ist ein familiengeführter Gemüse- und Weinbaubetrieb in der Ardèche aus biologischem Anbau (AB). Sie finden alle frischen Obst- und Gemüsesorten der Saison auf den Märkten oder im Laden."
    ],
    "en": [
      "Domaine de Mercoire is a family-run organic (AB) market-garden and wine-growing farm in the Ardèche. You can find all our fresh seasonal fruit and vegetables at the markets or in our stores."
    ],
    "it": [
      "Il Domaine de Mercoire è un'azienda agricola a conduzione familiare sulle alture di Rosières, che coltiva ortaggi e frutta biologici. Potete trovare tutta la frutta e la verdura fresca di stagione nei mercati o nei negozi."
    ],
    "fr": [
      "Le Domaine de Mercoire est une ferme familiale sur les hauteurs de Rosières en maraichage et arboriculture en BIO. Vous pouvez retrouver tous les fruits et légumes frais de saisons sur les marchés ou en magasin."
    ],
    "es": [
      "El Domaine de Mercoire es una granja familiar situada en las alturas de Rosières que cultiva verduras y frutas ecológicas. Encontrará todas las frutas y verduras frescas de temporada en los mercados o en las tiendas."
    ],
    "nl": [
      "Domaine de Mercoire is een familieboerderij op de hoogten van Rosières die biologische groenten en fruit verbouwt. Je vindt alle verse seizoensgroenten en -fruit op de markten of in de winkels."
    ]
  },
