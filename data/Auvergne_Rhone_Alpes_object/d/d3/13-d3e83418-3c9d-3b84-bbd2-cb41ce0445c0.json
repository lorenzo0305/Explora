  "rdfs:comment": {
    "de": [
      "Das Zugrestaurant Muttertagsspecial ist eine originelle Idee, um unsere Mütter zu ehren: Genießen Sie ein gemütliches Mittagessen an Bord des Restaurantzuges der Chemin de Fer du Haut-Forez auf einer Fahrt zwischen Craponne-sur-Arzon und Usson-en-Forez."
    ],
    "en": [
      "The special Mother's Day Train Restaurant is an original way to honor our Mothers: enjoy a comfortable lunch on board the Chemin de Fer du Haut-Forez Train Restaurant on a journey between Craponne-sur-Arzon and Usson-en-Forez."
    ],
    "it": [
      "Il treno ristorante speciale per la Festa della Mamma è un modo originale per onorare le nostre mamme: godetevi un pranzo confortevole a bordo del treno ristorante Chemin de Fer du Haut-Forez durante il viaggio tra Craponne-sur-Arzon e Usson-en-Forez."
    ],
    "fr": [
      "Le train restaurant Spécial Fêtes des Mères est une idée originale d’honorer nos Mamans : déjeunez confortablement à bord du Train Restaurant du Chemin de Fer du Haut-Forez au cours d'un voyage entre Craponne-sur-Arzon et Usson-en-Forez."
    ],
    "nl": [
      "Het speciale treinrestaurant Moederdag is een originele manier om onze moeders te eren: geniet van een comfortabele lunch aan boord van het treinrestaurant Chemin de Fer du Haut-Forez op een reis tussen Craponne-sur-Arzon en Usson-en-Forez."
    ],
    "es": [
      "El tren restaurante especial Día de la Madre es una forma original de honrar a nuestras madres: disfrute de un cómodo almuerzo a bordo del tren restaurante Chemin de Fer du Haut-Forez en un trayecto entre Craponne-sur-Arzon y Usson-en-Forez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Train Restaurant de la fête des Mères"
    ]
  },
