  "rdfs:comment": {
    "de": [
      "Die Stadtverwaltung von Aurec-sur-Loire, die FNACA und die UFAC organisieren eine Versammlung zum Gedenken an den 64. Jahrestag des \"Cessez le feu en Algérie\" auf dem Place de l'Eglise."
    ],
    "en": [
      "The Mairie d'Aurec-sur-Loire, FNACA and UFAC are organizing a gathering to commemorate the 64th anniversary of the \"Cessez le feu in Algeria\" on the Place de l'Église."
    ],
    "it": [
      "Il Municipio di Aurec-sur-Loire, la FNACA e l'UFAC organizzano un incontro per commemorare il 64° anniversario del cessate il fuoco in Algeria sulla Place de l'Église."
    ],
    "fr": [
      "La mairie d'Aurec-sur-Loire, la FNACA et l'UFAC organise un rassemblement de commémoration du 64ème anniversaire du \"Cessez le feu en Algérie\" sur la place de l'Église."
    ],
    "nl": [
      "Het gemeentehuis van Aurec-sur-Loire, de FNACA en de UFAC organiseren een bijeenkomst op de Place de l'Église om de 64e verjaardag van het staakt-het-vuren in Algerije te herdenken."
    ],
    "es": [
      "El ayuntamiento de Aurec-sur-Loire, la FNACA y la UFAC organizan en la plaza de la Iglesia un encuentro para conmemorar el 64 aniversario del alto el fuego en Argelia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Commémoration du cessez-le-feu en Algérie"
    ]
  },
