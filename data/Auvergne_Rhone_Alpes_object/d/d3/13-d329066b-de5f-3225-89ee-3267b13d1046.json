  "rdfs:comment": {
    "de": [
      "Zen-Ambiente, 30°-Atmosphäre, orientalisches Hammam mit Marmormosaiken, Jacuzzi, Hallenbad, Duftgarten für das Erwachen der Sinne, nicht zu vergessen die Massagen mit ätherischen Ölen für eine absolute Entspannung."
    ],
    "en": [
      "Zen atmosphere, 86°F (30°C), oriental hammam with mosaics, marble, hot tub, indoor pool, garden of fragrances and massages with essential oils for an absolute decontraction."
    ],
    "it": [
      "Atmosfera zen, atmosfera a 30°C, hammam orientale in mosaico di marmo, jacuzzi, piscina coperta, giardino di profumi per risvegliare i sensi, senza dimenticare i massaggi con oli essenziali per un relax assoluto."
    ],
    "fr": [
      "Ambiance zen, atmosphère 30°, hammam oriental en mosaïques de marbre, jacuzzi, piscine intérieure, jardin des senteurs pour l'éveil des sens, sans oublier les massages aux huiles essentielles pour une détente absolue."
    ],
    "nl": [
      "Zen sfeer, temperatuur van 30°, oriëntaalse hammam met mozaïek van marmer, jacuzzi, binnenzwembad, geurtuin voor de zintuigen, en niet te vergeten de massages met essentiële oliën voor een totale ontspanning."
    ],
    "es": [
      "Ambiente zen, atmósfera de 30°C, hammam oriental en mosaicos de mármol, jacuzzi, piscina cubierta, jardín de aromas para despertar los sentidos, sin olvidar los masajes con aceites esenciales para una relajación absoluta."
    ]
  },
