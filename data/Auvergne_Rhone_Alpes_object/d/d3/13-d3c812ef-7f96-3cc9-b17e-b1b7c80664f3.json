  "rdfs:comment": {
    "de": [
      "Mehr als ein Hotel, ein Familienhaus .... Am Fuße der Pisten der Rückkehr von Pléney-Nyon gelegen\r\nGästetisch für Kinder während der Schulferien, traditionelle, überarbeitete und leichtere Restaurierung nach dem Geschmack des Tages."
    ],
    "en": [
      "Situated in a quiet place at the bottom of the slope of Pleney Nyon return."
    ],
    "it": [
      "Più che un albergo, una casa famiglia .... Situato ai piedi delle piste di Pléney-Nyon\r\nTable d'hôtes per bambini durante le vacanze scolastiche, cibo tradizionale, rivisitato e alleggerito secondo il gusto del giorno."
    ],
    "fr": [
      "Plus qu'un hôtel, une maison de famille .... Situé aux pieds des pistes du retour de Pléney-Nyon\r\nTable d'hôtes pour les enfants pendant les vacances scolaires, restauration traditionnelle, revisitée et allégées au goût du jour."
    ],
    "nl": [
      "Meer dan een hotel, een familie thuis .... Gelegen aan de voet van de skipistes van Pléney-Nyon\r\nTable d'hôtes voor kinderen tijdens de schoolvakanties, traditionele keuken, herwerkt en verlicht naar de smaak van de dag."
    ],
    "es": [
      "Más que un hotel, una casa familiar .... Situado al pie de las laderas de Pléney-Nyon\r\nTable d'hôtes para niños durante las vacaciones escolares, comida tradicional, revisada y aligerada al gusto del día."
    ]
  },
