      "dc:description": {
        "de": [
          "Organisiert von den Spatzen der Calotterie\nSamstag, den 8. November um 14 Uhr\nPlace de l'Eglise - La Calotterie (Platz der Kirche)\n---------------------------------\nAnimation ab 6 Jahren\n\nTeilnahme an der Veranstaltung: 5? - Kostenloser Imbiss - Begrenzte Anzahl an Plätzen\nReservierung per SMS: 07 69 79 79 83\n\nKredit: Les Moineaux de la Calotterie (Die Spatzen der Calotterie)"
        ],
        "en": [
          "Organized by Les Moineaux de la Calotterie\nSaturday November 8th at 2pm\nPlace de l'Eglise - La Calotterie\n---------------------------------\nEntertainment for ages 6 and up\n\nParticipation: 5? - Snack offered - Places limited\nReservation by SMS: 07 69 79 79 83\n\nCredit: Les Moineaux de la Calotterie"
        ],
        "it": [
          "A cura di Les Moineaux de la Calotterie\nSabato 8 novembre alle 14.00\nPiazza dell'Eglise - La Calotterie\n---------------------------------\nAnimazione per bambini dai 6 anni in su\n\nPartecipazione: 5? - Merenda offerta - Posti limitati\nPrenotazione via SMS: 07 69 79 79 83\n\nCredito: Les Moineaux de la Calotterie"
        ],
        "fr": [
          "Organisé par les Moineaux de la Calotterie\nSamedi 8 novembre à 14h\nPlace de l’Eglise - La Calotterie\n---------------------------------\nAnimation à partir de 6 ans\n\nParticipation : 5€ - Goûter offert - Places limitées\nRéservation par SMS : 07 69 79 79 83 \n\nCrédit : Les Moineaux de la Calotterie"
        ],
        "es": [
          "Organizado por Les Moineaux de la Calotterie\nSábado 8 de noviembre a las 14.00 horas\nPlaza de la Iglesia - La Calotterie\n---------------------------------\nAnimación para niños a partir de 6 años\n\nParticipación: 5? - Merienda ofrecida - Plazas limitadas\nReserva por SMS: 07 69 79 79 83\n\nCrédito: Les Moineaux de la Calotterie"
        ],
        "nl": [
          "Georganiseerd door Les Moineaux de la Calotterie\nZaterdag 8 november om 14u\nKerkplein - La Calotterie\n---------------------------------\nAnimatie voor kinderen vanaf 6 jaar\n\nDeelname: 5? - Snack aangeboden - Plaatsen beperkt\nReserveer per sms: 07 69 79 79 83\n\nKrediet: Les Moineaux de la Calotterie"
        ]
      },
