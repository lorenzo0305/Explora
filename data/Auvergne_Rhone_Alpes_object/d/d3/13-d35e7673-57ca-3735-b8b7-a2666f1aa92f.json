  "rdfs:comment": {
    "de": [
      "Produktion von Beeren und Obstbäumen in biologischem Anbau (Himbeeren, Erdbeeren, Aprikosen, Pflaumen, Kiwis) und handwerkliche Herstellung von Säften, Konfitüren und Fruchtpasten."
    ],
    "en": [
      "Production of small fruits and fruit trees in Organic Agriculture (raspberries, strawberries, apricots, plums, kiwis) and traditional production of jams and fruit jellies."
    ],
    "it": [
      "Produzione biologica di bacche e alberi da frutto (lamponi, fragole, ribes, albicocche, mele cotogne, prugne, kiwi) e succhi, marmellate e gelatine di frutta fatti in casa."
    ],
    "fr": [
      "Production de petits fruits et arbres fruitiers en Agriculture Biologique (framboises, fraises, groseilles, abricots, coings, prunes, kiwis) et fabrication artisanale de jus, confitures et pâtes de fruits."
    ],
    "es": [
      "Producción ecológica de bayas y frutales (frambuesas, fresas, grosellas, albaricoques, membrillos, ciruelas, kiwis) y zumos caseros, mermeladas y jaleas de frutas."
    ],
    "nl": [
      "Biologische productie van bessen en fruitbomen (frambozen, aardbeien, abrikozen, pruimen, kiwi's) en zelfgemaakte sappen, jam en vruchtengelei."
    ]
  },
