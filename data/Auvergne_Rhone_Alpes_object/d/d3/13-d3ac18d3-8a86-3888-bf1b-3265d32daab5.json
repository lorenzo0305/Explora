  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Lac du Bourget entfernt, zwischen Lyon, Genf und Turin, vereint unser 4-Sterne-Hotel zeitgenössische Eleganz und gehobenen Komfort. Es liegt im Herzen von Aix-les-Bains, nur 200 m vom Bahnhof entfernt, und bietet Ihnen eine ruhige Umgebung mit einem grünen Garten."
    ],
    "en": [
      "Near the Lac du Bourget, between Lyon, Geneva and Turin, the 4-star Hotel Le Golden TulipAix les Bains upscale services and its ideal location in the city-centre, 200 m from the train station."
    ],
    "it": [
      "Nei pressi del lago del Bourget, tra Lione, Ginevra e Torino, l'Hotel 4 stelle Le  Golden Tulip Aix les Bains vi conquisterà con la qualità delle sue prestazioni di prim'ordine e la sua posizione strategica in centro, a 200 m dalla stazione ferroviaria."
    ],
    "fr": [
      "À deux pas du lac du Bourget, entre Lyon, Genève et Turin, notre hôtel 4★ allie élégance contemporaine et confort haut de gamme. Niché au cœur d’Aix-les-Bains, à seulement 200 m de la gare, il vous offrira un cadre paisible bordé d’un jardin verdoyant."
    ],
    "nl": [
      "Op een steenworp afstand van het Lac du Bourget, tussen Lyon, Genève en Turijn, combineert ons 4 sterren hotel eigentijdse elegantie met topklasse comfort. Het is genesteld in het hart van Aix-les-Bains, op slechts 200 meter van het treinstation, en biedt een rustige omgeving omringd door een weelderige tuin."
    ],
    "es": [
      "A dos pasos del lago Bourget, entre Lyon, Ginebra y Turín, nuestro hotel de 4 estrellas combina elegancia contemporánea y confort de alta gama. Situado en el corazón de Aix-les-Bains, a sólo 200 m de la estación de tren, ofrece un entorno tranquilo rodeado de un exuberante jardín."
    ]
  },
