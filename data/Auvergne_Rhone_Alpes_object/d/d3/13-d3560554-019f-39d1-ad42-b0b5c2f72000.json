  "rdfs:comment": {
    "de": [
      "Der Bau der Kirche von Seytroux wurde 1811 dank einer Subskription bei den Einwohnern von Seytroux abgeschlossen, die auch die für den Bau benötigten Materialien bereitgestellt und transportiert hatten."
    ],
    "en": [
      "Construction of the church in Seytroux was completed in 1811 thanks to a subscription from the people of Seytroux, who also supplied and transported the materials needed for its construction."
    ],
    "it": [
      "La costruzione della chiesa di Seytroux fu completata nel 1811 grazie a una sottoscrizione degli abitanti di Seytroux, che fornirono e trasportarono anche i materiali necessari per la costruzione."
    ],
    "fr": [
      "La construction de l'église de Seytroux s'est terminée en 1811 grâce à une souscription auprès des habitants de Seytroux qui avaient également fourni et transporté les matériaux nécessaires à sa construction."
    ],
    "es": [
      "La construcción de la iglesia de Seytroux finalizó en 1811 gracias a una suscripción de los habitantes de Seytroux, que también suministraron y transportaron los materiales necesarios para su construcción."
    ],
    "nl": [
      "De bouw van de kerk in Seytroux werd voltooid in 1811 dankzij een bijdrage van de inwoners van Seytroux, die ook de materialen leverden en vervoerden die nodig waren voor de bouw."
    ]
  },
