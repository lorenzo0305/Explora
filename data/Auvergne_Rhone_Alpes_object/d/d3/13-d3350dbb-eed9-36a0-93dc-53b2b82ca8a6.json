  "rdfs:comment": {
    "de": [
      "Unser Restaurant bietet eine Feinschmeckerküche aus der Region. Es liegt 4 km von Volvic entfernt und ist ein gut erreichbares Ziel für Besucher, die auf der Suche nach einer guten Mahlzeit in einer grünen Umgebung und in Ruhe sind."
    ],
    "en": [
      "Our restaurant offers gourmet and local cuisine. Located 4 km from Volvic, it is a very accessible destination for visitors looking for a good meal in a green and quiet environment."
    ],
    "it": [
      "Il nostro ristorante offre una cucina gourmet e locale. Situato a 4 km da Volvic, è una destinazione molto accessibile per i visitatori che cercano un buon pasto in un ambiente verde e tranquillo."
    ],
    "fr": [
      "Notre restaurant propose une cuisine gourmande et de terroir. Situé à 4 km de Volvic, c'est une destination très accessible pour les visiteurs en quête d'un bon repas dans un environnement verdoyant et dans le calme."
    ],
    "nl": [
      "Ons restaurant biedt gastronomische en lokale gerechten. Gelegen op 4 km van Volvic, is het een zeer toegankelijke bestemming voor bezoekers die op zoek zijn naar een goede maaltijd in een groene en rustige omgeving."
    ],
    "es": [
      "Nuestro restaurante ofrece cocina gourmet y local. Situado a 4 km de Volvic, es un destino muy accesible para los visitantes que buscan una buena comida en un entorno verde y tranquilo."
    ]
  },
