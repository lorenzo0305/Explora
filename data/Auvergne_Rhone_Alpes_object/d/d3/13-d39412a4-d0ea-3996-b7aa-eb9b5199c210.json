  "rdfs:comment": {
    "de": [
      "Der Spot in Chantelle bietet 3 Strecken in einer diskreten Naturkulisse im Herzen der Schluchten von La Bouble: Les passerelles 5,5km D+ 160m / Les moulins 9,2km D+ 250m / De la Bouble à Giverzat 17km D+ 370m."
    ],
    "en": [
      "The Chantelle spot offers 3 routes in a discreet natural setting in the heart of the Bouble gorges: Les passerelles 5.5km D+ 160m / Les moulins 9.2km D+ 250m / De la Bouble à Giverzat 17km D+ 370m."
    ],
    "it": [
      "Il punto Chantelle offre 3 percorsi in un ambiente naturale discreto nel cuore delle gole di La Bouble: Les passerelles 5,5km D+ 160m / Les moulins 9,2km D+ 250m / De la Bouble à Giverzat 17km D+ 370m."
    ],
    "fr": [
      "Le spot de Chantelle offre 3 parcours dans un écrin naturel discret au cœur des gorges de La Bouble : Les passerelles 5,5km D+ 160m  / Les moulins 9,2km D+ 250m / De la Bouble à Giverzat 17km D+ 370m."
    ],
    "es": [
      "El paraje de Chantelle ofrece 3 recorridos en un discreto entorno natural en el corazón de las gargantas de la Bouble: Les passerelles 5,5km D+ 160m / Les moulins 9,2km D+ 250m / De la Bouble à Giverzat 17km D+ 370m."
    ],
    "nl": [
      "De plek Chantelle biedt 3 routes in een discrete natuurlijke omgeving in het hart van de kloven van La Bouble: Les passerelles 5,5 km D+ 160m / Les moulins 9,2 km D+ 250m / De la Bouble à Giverzat 17 km D+ 370m."
    ]
  },
