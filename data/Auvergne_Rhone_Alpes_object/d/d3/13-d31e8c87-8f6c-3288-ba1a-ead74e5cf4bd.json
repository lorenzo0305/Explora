  "rdfs:comment": {
    "de": [
      "Die Ölmühle ist von Anfang Dezember bis Ende März an zwei Tagen pro Woche für die Öffentlichkeit zugänglich und ist ein echtes Ecomusée Vivant de la fabrication de l'huile de noix (Lebendiges Ökomuseum der Nussölherstellung) mit einer Präsentation der althergebrachten Praktiken der Nussölherstellung."
    ],
    "en": [
      "Open to the public two days a week from the beginning of December to the end of March, the oil mill is a veritable Living Ecomuseum of walnut oil production, presenting ancestral walnut oil-making practices."
    ],
    "it": [
      "Aperto al pubblico due giorni alla settimana dall'inizio di dicembre alla fine di marzo, il frantoio è un vero e proprio Ecomuseo vivente della produzione di olio di noce, con una presentazione delle pratiche ancestrali di produzione dell'olio di noce."
    ],
    "fr": [
      "Ouvert au public deux jours par semaine, de début décembre à fin mars, le moulin à huile est un véritable Ecomusée Vivant de la fabrication de l’huile de noix  avec présentation des pratiques ancestrales  de la fabrication de l’huile de noix."
    ],
    "nl": [
      "De oliemolen is van begin december tot eind maart twee dagen per week geopend voor het publiek en is een echt levend ecomuseum voor de productie van walnootolie, met een presentatie van voorouderlijke praktijken voor de productie van walnootolie."
    ],
    "es": [
      "Abierta al público dos días a la semana desde principios de diciembre hasta finales de marzo, la almazara es un auténtico Ecomuseo Viviente de la producción de aceite de nuez, con una presentación de las prácticas ancestrales de producción de aceite de nuez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Écomusée moulin à huile de  Revel"
    ]
  },
