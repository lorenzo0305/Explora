  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch den Ort Oz-en-Oisans und seine Umgebung, um an jeder Markierung seine Besonderheiten und sein Erbe zu entdecken."
    ],
    "en": [
      "Explore the Oz 3300 resort and its vicinity with the help of your mapto discover its particularities and heritage at each marker."
    ],
    "it": [
      "Con l'aiuto della mappa, spostatevi nella località di Oz-en-Oisans e nei suoi dintorni per scoprire le sue particolarità e il suo patrimonio a ogni tappa."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous dans la station d'Oz-en-Oisans et ses alentours pour découvrir ses particularités et son patrimoine à chaque balise."
    ],
    "nl": [
      "Verplaats u met behulp van uw kaart door de badplaats Oz-en-Oisans en omgeving om bij elke markering de bijzonderheden en het erfgoed te ontdekken."
    ],
    "es": [
      "Con la ayuda de su mapa, muévase por la estación de Oz-en-Oisans y sus alrededores para descubrir sus particularidades y su patrimonio en cada marcador."
    ]
  },
  "rdfs:label": {
