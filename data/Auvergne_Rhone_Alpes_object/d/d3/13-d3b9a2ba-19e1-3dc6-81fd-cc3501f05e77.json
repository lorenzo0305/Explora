  "rdfs:comment": {
    "de": [
      "\"La table du Bugey\" bietet Ihnen eine saisonale Speisekarte mit frischen und lokalen Produkten. Genießen Sie ein Mittag- oder Abendessen auf der Terrasse im Stadtzentrum."
    ],
    "en": [
      "Buffets formulas, grilled meats, salads, Spanish-style grilled meats and local specialities."
    ],
    "it": [
      "\"La Table du Bugey\" offre un menu stagionale a base di prodotti freschi locali. Venite a godervi la terrazza per un pranzo o una cena nel centro della città."
    ],
    "fr": [
      "« La table du Bugey » vous propose sa carte au fil des saisons de produits frais et locaux. Venez profiter de la terrasse pour un déjeuner ou un dîner en centre ville."
    ],
    "es": [
      "\"La Table du Bugey\" ofrece un menú de temporada a base de productos locales frescos. Venga a disfrutar de la terraza para comer o cenar en el centro de la ciudad."
    ],
    "nl": [
      "\"La Table du Bugey biedt een seizoensgebonden menu met verse lokale producten. Kom genieten op het terras voor lunch of diner in het stadscentrum."
    ]
  },
