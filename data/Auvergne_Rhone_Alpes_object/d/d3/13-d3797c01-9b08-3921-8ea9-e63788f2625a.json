  "rdfs:comment": {
    "de": [
      "Winzer, der roten AOC Côtes d'Auvergne Boudes, weißen AOC Côtes d'Auvergne und Roséwein erntet. Kellerbesichtigung und Informationen über die Appellation und die verwendeten Weinbereitungsmethoden."
    ],
    "en": [
      "Winemaker producing AOC Côtes d'Auvergne Boudes red, AOC Côtes d'Auvergne white and rosé. Cellar visit and information on the appellation and winemaking methods used."
    ],
    "it": [
      "Viticoltore che produce il rosso AOC Côtes d'Auvergne Boudes, il bianco AOC Côtes d'Auvergne e il rosé. Visita della cantina e informazioni sulla denominazione e sui metodi di vinificazione utilizzati."
    ],
    "fr": [
      "Vigneron récoltant AOC Côtes d'Auvergne Boudes rouge, AOC Côtes d'Auvergne blanc et rosé. Visite de cave et renseignements sur l'appellation et les modes de vinification utilisés."
    ],
    "nl": [
      "Wijnboer die AOC Côtes d'Auvergne Boudes rood, AOC Côtes d'Auvergne wit en rosé produceert. Kelderrondleiding en informatie over de appellation en de gebruikte vinificatiemethoden."
    ],
    "es": [
      "Viticultor que produce la DOC Côtes d'Auvergne Boudes tinto, la DOC Côtes d'Auvergne blanco y rosado. Visita de la bodega e información sobre la denominación y los métodos de vinificación utilizados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Charmensat"
    ]
