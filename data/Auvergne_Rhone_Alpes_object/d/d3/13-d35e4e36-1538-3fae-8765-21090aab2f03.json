  "rdfs:comment": {
    "de": [
      "In Bernex bietet die Familie Blanc das ganze Jahr über Ausritte zu Pferd oder auf Ponys (je nach Alter) an. Für die Jüngsten gibt es einen Ausritt an der Pony-Longe.\r\nVorherige Reservierung erforderlich.\r\nNeu: Geburtstag auf der Ranch feiern! Nach vorheriger Reservierung."
    ],
    "en": [
      "In Bernex, all year round, the Blanc family offers horse or pony rides (depending on age), and pony rides for younger children.\r\nPrior booking required.\r\nNew: celebrate your birthday at the ranch! Reservations required."
    ],
    "it": [
      "A Bernex, tutto l'anno, la famiglia Blanc offre passeggiate a cavallo o su pony (a seconda dell'età), e passeggiate su pony per i bambini più piccoli.\r\nÈ necessaria la prenotazione.\r\nNovità: festeggiate il vostro compleanno al ranch! Prenotazione obbligatoria."
    ],
    "fr": [
      "A Bernex, toute l'année, la famille Blanc propose des promenades à cheval ou à poney (selon l'âge), promenade en longe à poney pour les plus jeunes.\r\nRéservation préalable obligatoire. \r\nNouveauté : fêter son anniversaire au ranch ! Sur réservation."
    ],
    "nl": [
      "In Bernex biedt de familie Blanc het hele jaar door tochten te paard of op een pony (afhankelijk van de leeftijd), en ponyritjes voor jongere kinderen.\r\nVooraf reserveren verplicht.\r\nNieuw: vier je verjaardag op de ranch! Reserveren verplicht."
    ],
    "es": [
      "En Bernex, durante todo el año, la familia Blanc ofrece paseos a caballo o en poni (según la edad), y paseos en poni para los más pequeños.\r\nSe requiere reserva previa.\r\nNovedad: ¡celebre su cumpleaños en el rancho! Reserva obligatoria."
    ]
  },
  "rdfs:label": {
    "en": [
      "Riding stable"
    ],
    "fr": [
      "Ranch équestre de Bernex"
    ],
    "nl": [
      "Boerderij van Bernex"
    ]
  },
