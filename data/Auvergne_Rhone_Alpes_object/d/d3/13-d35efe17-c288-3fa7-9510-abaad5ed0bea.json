  "rdfs:comment": {
    "de": [
      "Raum, der der zeitgenössischen Kunst und den visuellen Künsten gewidmet ist: Verbreitung zeitgenössischer Werke, monografische oder kollektive Ausstellungen, Residenzen, Treffen mit Künstlern, Vermittlungsaktionen. Regelmäßige Veranstaltungen im Hof André Malraux."
    ],
    "en": [
      "A space dedicated to contemporary art and the visual arts: distribution of contemporary works, monographic or group exhibitions, residencies, meetings with artists, mediation activities. Regular events in the André Malraux courtyard."
    ],
    "it": [
      "Uno spazio dedicato all'arte contemporanea e alle arti visive: diffusione di opere contemporanee, mostre monografiche o collettive, residenze, incontri con artisti, attività di mediazione. Eventi regolari nel cortile di André Malraux."
    ],
    "fr": [
      "Espace dédié à l'art contemporain et aux arts visuels : diffusion d’œuvres contemporaines, expositions monographiques ou collectives, résidences, rencontres avec les artistes, actions de médiation. Manifestations régulières dans la cour André Malraux."
    ],
    "es": [
      "Un espacio dedicado al arte contemporáneo y a las artes visuales: difusión de obras contemporáneas, exposiciones monográficas o colectivas, residencias, encuentros con artistas, actividades de mediación. Eventos regulares en el patio André Malraux."
    ],
    "nl": [
      "Een ruimte gewijd aan hedendaagse kunst en beeldende kunst: verspreiding van hedendaagse werken, monografische of groepstentoonstellingen, residenties, ontmoetingen met kunstenaars, bemiddelingsactiviteiten. Regelmatige evenementen op de binnenplaats van André Malraux."
    ]
  },
  "rdfs:label": {
