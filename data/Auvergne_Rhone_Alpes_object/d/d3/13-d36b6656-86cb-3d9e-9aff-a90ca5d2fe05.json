  "rdfs:comment": {
    "de": [
      "\"Die Marquise lädt sich ins Museum ein, die Verbindung zwischen Schrift und Kunst\"\r\nJeden zweiten Samstag im Monat um 11:30 Uhr"
    ],
    "en": [
      "\"La marquise s?invite au musée, the link between writing and art\"\r\nEvery second Saturday of the month at 11:30 am"
    ],
    "it": [
      "\"La Marchesa si invita al museo\": il legame tra scrittura e arte\r\nOgni secondo sabato del mese alle 11.30"
    ],
    "fr": [
      "« La marquise s’invite au musée, le lien entre l’écriture et l’art » \r\nChaque deuxième samedi du mois à 11h30"
    ],
    "es": [
      "\"La Marquesa se invita a sí misma al museo: el vínculo entre escritura y arte\r\nCada segundo sábado del mes a las 11.30 h"
    ],
