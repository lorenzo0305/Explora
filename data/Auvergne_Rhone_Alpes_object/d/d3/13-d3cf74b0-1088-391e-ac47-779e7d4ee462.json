  "rdfs:comment": {
    "de": [
      "Vor Ort anzutreffen sind: der Fischladen \"le lamparo\", der Bauernhof \"ferme de Loustaniol\", der Bauernhof \"Gaec de la chèvre blanche\", der Bauernhof \"GAEC Les Jardins de Jurlhes\" und die Metzgerei und Wurstfabrik \"La Hautmontoise\"."
    ],
    "en": [
      "On-site: Le Lamparo fishmonger, Loustaniol farm, Gaec de la Chèvre Blanche, GAEC Les Jardins de Jurlhes and La Hautmontoise butcher."
    ],
    "it": [
      "Sul posto: la pescheria Lamparo, la fattoria Loustaniol, il Gaec de la chèvre blanche, il GAEC Les Jardins de Jurlhes e la macelleria e salumeria \"La Hautmontoise\"."
    ],
    "fr": [
      "A retrouver sur place : la poissonnerie le lamparo, la ferme de Loustaniol, le Gaec de la chèvre blanche, le GAEC Les Jardins de Jurlhes et la boucherie-charcuterie \"La Hautmontoise\"."
    ],
    "nl": [
      "Ter plaatse: de viswinkel Lamparo, de boerderij Loustaniol, de Gaec de la chèvre blanche, de GAEC Les Jardins de Jurlhes en de slagerij en delicatessenwinkel \"La Hautmontoise\"."
    ],
    "es": [
      "En el lugar: la pescadería Lamparo, la granja Loustaniol, el Gaec de la chèvre blanche, el GAEC Les Jardins de Jurlhes y la carnicería y charcutería \"La Hautmontoise\"."
    ]
  },
