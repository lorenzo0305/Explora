  "rdfs:comment": {
    "de": [
      "Kirche im neogotischen Stil aus dem 18. Jahrhundert. Jahrhundert. Ihr Längsgrundriss mit einem nicht vorspringenden Querschiff wird von einem flachen Kopfende abgeschlossen."
    ],
    "en": [
      "Neo-Gothic style church dating from the 18th century. Its longitudinal plan with a non protruding transept is finished by a flat chevet."
    ],
    "it": [
      "Chiesa neogotica del XVIII secolo. La sua pianta longitudinale con transetto non sporgente è rifinita da un chevet piatto."
    ],
    "fr": [
      "Eglise de style néo-gothique datant du XVIII° siècle. Son plan longitudinal à transept non saillant est terminé par un chevet plat."
    ],
    "nl": [
      "Neogotische kerk uit de 18e eeuw. De plattegrond in de lengterichting met een niet uitspringend dwarsschip is afgewerkt met een vlakke chevet."
    ],
    "es": [
      "Iglesia neogótica del siglo XVIII. Su planta longitudinal con un crucero no proyectado está terminada con una cabecera plana."
    ]
  },
