  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/67824e19-880e-3db5-884d-34aab000358e",
      "dc:description": {
        "de": [
          "Konzert im Rahmen des Tages der Frauenrechte.\nUm 16 Uhr im Museum Opale Sud, ab 10 Jahren.\nPreis: 15 (Normaltarif) / 5 (Jugendliche von 13 bis 26 Jahren, Arbeitssuchende, RSA-Empfänger, Personen mit eingeschränkter Mobilität) / kostenlos (unter 12 Jahren, Begleitperson von Personen mit eingeschränkter Mobilität)\nInfos unter www.musica-nigella.fr und Reservierungen unter reservation@musicanigella.fr"
        ],
        "en": [
          "Concert as part of Women's Rights Day.\nAt 4pm at the Musée Opale Sud, ages 10 and up.\nPrice: ?15 (normal rate) / ?5 (young people aged 13 to 26, jobseekers, RSA recipients, persons with reduced mobility) / free (under 12s, accompanying persons with reduced mobility)\nInformation at www.musica-nigella.fr and booking at reservation@musicanigella.fr"
        ],
        "it": [
          "Concerto nell'ambito della Giornata dei diritti della donna.\nAlle 16.00 al Musée Opale Sud, per bambini a partire dai 10 anni.\nPrezzo: € 15 (prezzo normale) / € 5 (giovani dai 13 ai 26 anni, persone in cerca di lavoro, beneficiari di RSA, persone a mobilità ridotta) / gratuito (minori di 12 anni, accompagnatori di persone a mobilità ridotta)\nDettagli su www.musica-nigella.fr e prenotazioni su reservation@musicanigella.fr"
        ],
        "fr": [
          "Concert dans le cadre de la journée des droits de la femme. \nA 16h au musée Opale Sud, à partir 10ans. \nTarif : 15€ (tarif normal) / 5€ (jeune de 13 à 26 ans, demandeur d’emploi, bénéficiaire du RSA, personne à mobilité réduite) / gratuit (moins de 12 ans, accompagnateur de personne à mobilité réduite)\nInfos sur www.musica-nigella.fr et réservation à l’adresse reservation@musicanigella.fr"
        ],
        "es": [
          "Concierto con motivo del Día de los Derechos de la Mujer.\nA las 16.00 h en el Museo Opale Sud, para niños a partir de 10 años.\nPrecio: 15 euros (tarifa normal) / 5 euros (jóvenes de 13 a 26 años, solicitantes de empleo, beneficiarios de la RSA, personas con movilidad reducida) / gratis (menores de 12 años, acompañantes con movilidad reducida)\nDetalles en www.musica-nigella.fr y reservas en reservation@musicanigella.fr"
        ],
        "nl": [
          "Concert in het kader van de Dag van de Rechten van de Vrouw.\nOm 16.00 uur in het Musée Opale Sud, voor kinderen vanaf 10 jaar.\nPrijs: 15 euro (normale prijs) / 5 euro (jongeren van 13-26 jaar, werkzoekenden, RSA-ontvangers, personen met beperkte mobiliteit) / gratis (kinderen onder de 12 jaar, begeleiders met beperkte mobiliteit)\nDetails op www.musica-nigella.fr en boekingen op reservation@musicanigella.fr"
        ]
      },
