  "rdfs:comment": {
    "de": [
      "Le Refuge des Gourmets, ein Gourmet-Tisch mit einem Stern im Guide Michelin und ein Bistro, bietet Ihnen eine saisonale Küche.\r\nLassen Sie sich von der Küche des Küchenchefs Hubert und dem von Fanny geführten Service zu einem kulinarischen Erlebnis entführen."
    ],
    "en": [
      "Le Refuge des Gourmets, a gourmet restaurant with one Michelin star and a bistro, offers seasonal cuisine.\r\nLet yourself be transported by Chef Hubert's cuisine and Fanny's guided service for a culinary experience."
    ],
    "it": [
      "Le Refuge des Gourmets è un ristorante gourmet e bistrot stellato Michelin che propone una cucina stagionale.\r\nLasciatevi trasportare dalla cucina dello chef Hubert e dal servizio guidato di Fanny per un'esperienza culinaria."
    ],
    "fr": [
      "Le Refuge des Gourmets, table gastronomique avec une étoile au Guide Michelin et un bistro, vous propose une cuisine de saison.\r\nLaissez-vous transporter par la cuisine d'Hubert Chanove et le service guidé par Fanny pour vivre une expérience culinaire."
    ],
    "nl": [
      "Le Refuge des Gourmets, een gastronomisch restaurant en bistro met een Michelin-ster, biedt een seizoensgebonden keuken.\r\nLaat je door de keuken van Hubert Chanove en de begeleide service van Fanny meevoeren naar een culinaire ervaring."
    ],
    "es": [
      "Le Refuge des Gourmets es un restaurante gastronómico y bistró con una estrella Michelin que sirve cocina de temporada.\r\nDéjese transportar por la cocina del Chef Hubert y el servicio guiado de Fanny para vivir una experiencia culinaria."
    ]
  },
