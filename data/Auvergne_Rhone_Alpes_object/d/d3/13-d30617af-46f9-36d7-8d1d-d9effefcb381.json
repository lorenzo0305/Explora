  "rdfs:comment": {
    "de": [
      "Antoine, Charles und Théo sind ein kleines Team von drei begeisterten Piloten, die Sie mitnehmen, um das Vergnügen des Gleitschirmfliegens über dem See von Annecy zu entdecken. Gesellige Momente und gute Laune sind garantiert!"
    ],
    "en": [
      "Antoine, Charles and Théo make a nice little team of three passionate pilots who love to help you discover the pleasure of flying in a paraglider above lake Annecy. A friendly time in a good mood for sure!"
    ],
    "it": [
      "Antoine, Charles e Theo formano un piccolo team di tre piloti appassionati che vi porteranno a scoprire il piacere del parapendio sopra il lago di Annecy. Momenti di amicizia e buon umore garantiti!"
    ],
    "fr": [
      "Antoine, Charles et Théo forment une petite équipe de trois pilotes passionnés qui vous emmène découvrir le plaisir de voler en parapente au-dessus du lac d'Annecy. Moment convivial et bonne humeur assurés !"
    ],
    "es": [
      "Antoine, Charles y Theo forman un pequeño equipo de tres pilotos apasionados que te llevarán a descubrir el placer de volar en parapente sobre el lago de Annecy. ¡Un momento amistoso y de buen humor garantizado!"
    ],
    "nl": [
      "Antoine, Charles en Theo vormen een klein team van drie gepassioneerde piloten die u meenemen om het plezier van het vliegen met een paraglider boven het meer van Annecy te ontdekken. Een vriendelijk moment en goed humeur gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Wefly Parapente"
    ],
