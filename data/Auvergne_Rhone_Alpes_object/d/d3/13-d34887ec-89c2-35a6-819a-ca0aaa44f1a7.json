  "rdfs:comment": {
    "de": [
      "Agentur, die sich auf die Mietverwaltung, die Vermietung und die Verwaltung von Eigentumswohnungen spezialisiert hat. Sie haben eine Immobilie zu verwalten oder suchen eine Mietwohnung? Mathieu CLIER und sein Team stehen zu Ihren Diensten."
    ],
    "en": [
      "Real estate specialized in rentals and property managing. Mathieu CLIER and his team are at your service."
    ],
    "it": [
      "Agenzia specializzata nella gestione di affitti, locazioni e comproprietà. Avete un immobile da gestire, siete alla ricerca di un affitto? Mathieu CLIER e il suo team sono al vostro servizio."
    ],
    "fr": [
      "Agence spécialisée dans la gestion locative, la location et le syndic de copropriété. Vous avez un bien à gérer, vous cherchez une location ? Mathieu CLIER et son équipe sont à votre service."
    ],
    "nl": [
      "Makelaar gespecialiseerd in het beheer van verhuur, seizoensverhuur en de beheer van gedeeld eigenaarschap. Heeft u een object voor de verhuur of zoekt u iets om te huren in het seizoen of jaarrond? Mathieu CLIER en zijn team staan tot uw dienst."
    ],
    "es": [
      "Agencia especializada en la gestión de alquileres, arrendamiento y copropiedad. ¿Tiene una propiedad que gestionar, busca un alquiler? Mathieu CLIER y su equipo están a su servicio."
    ]
  },
