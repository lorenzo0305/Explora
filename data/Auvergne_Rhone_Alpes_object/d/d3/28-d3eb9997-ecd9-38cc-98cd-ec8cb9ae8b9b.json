  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/078667b8-754e-338c-9e1e-20fa49ef260a",
      "dc:description": {
        "de": [
          "Das Café de la Couronne - A la Forge, das als Cafe-Rando ausgezeichnet ist, empfängt Sie in einem gemütlichen Rahmen in der Gemeinde Staple. Grillabende, Geburtstage, Firmenseminare... was auch immer der Grund ist, finden Sie sich an diesem Ort ein, der einen gelungenen Moment verspricht!"
        ],
        "en": [
          "The Café de la Couronne - A la Forge, with its Cafe-Rando label, welcomes you to a warm and inviting setting in the commune of Staple. Grilled evenings, birthdays, company seminars... whatever the occasion, this is the place to be!"
        ],
        "it": [
          "Il Café de la Couronne - A la Forge, con il marchio Cafe-Rando, vi accoglie in un ambiente caldo e accogliente nel comune di Staple. Serate grill, compleanni, seminari aziendali... qualunque sia l'occasione, questo è il posto giusto!"
        ],
        "fr": [
          "Le Café de la Couronne - A la Forge, labellisé Cafe-Rando, vous accueille dans un cadre chaleureux dans la commune de Staple. Soirées grillades, anniversaires, séminaires d'entreprise...quelque soit le motif, retrouvez-vous dans ce lieu, promesse d'un moment réussi !"
        ],
        "es": [
          "El Café de la Couronne - A la Forge, con su sello Cafe-Rando, le da la bienvenida en un ambiente cálido y acogedor en la comuna de Staple. Veladas a la parrilla, cumpleaños, seminarios de empresa... sea cual sea la ocasión, ¡éste es el lugar ideal!"
        ],
        "nl": [
          "Café de la Couronne - A la Forge, met het label Café-Rando, verwelkomt u in een warme en gezellige sfeer in de gemeente Staple. Grillavonden, verjaardagen, bedrijfsseminaries... wat de gelegenheid ook is, hier moet u zijn!"
        ]
      },
      "@type": [
        "Description"
      ],
