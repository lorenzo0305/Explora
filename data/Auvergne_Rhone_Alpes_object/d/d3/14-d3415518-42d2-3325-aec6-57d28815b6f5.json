      "@id": "https://data.datatourisme.fr/84136d79-a6f5-3080-a1b8-d9df705ccbdf",
      "dc:description": {
        "de": [
          "Die Gemeinde organisiert einen Abend bei den Funken im Tal des Rennens\nVerkostung von Crêpes und Waffeln, die über dem Holzfeuer gebacken werden"
        ],
        "en": [
          "The Commune organizes an evening during the Sparks of the Course Valley\nTasting of wood-fired pancakes and waffles"
        ],
        "it": [
          "Il Comune organizza una serata durante le Scintille della Valle del Corso\nDegustazione di frittelle e cialde cotte sul fuoco a legna"
        ],
        "fr": [
          "La Commune organise une soirée lors des étincelles de la Vallée de la Course\nDégustation de crêpes et gaufres cuites au feu de bois"
        ],
        "es": [
          "La Comuna organiza una velada durante las Chispas del Valle del Curso\nDegustación de crepes y gofres cocinados al fuego de leña"
        ],
        "nl": [
          "De Commune organiseert een avond tijdens de Vonken van de Koervallei\nProeverij van pannenkoeken en wafels op houtvuur"
        ]
      },
