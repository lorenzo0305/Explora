  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e989ecc2-0fda-3def-9836-f46869e684ca",
      "dc:description": {
        "de": [
          "Genießen Sie einen generationenübergreifenden Ausflug zum Weihnachtsmarkt in Gravelines\nEine gute Gelegenheit, die Beleuchtung, die Schlemmer- und Kunsthandwerkerhütten zu entdecken und die gemütliche Atmosphäre der Feiertage zu genießen."
        ],
        "en": [
          "Enjoy an intergenerational outing to the Gravelines Christmas Market\nA great opportunity to discover the illuminations, gourmet and artisanal chalets, and enjoy the warm atmosphere of the festive season."
        ],
        "it": [
          "Gita intergenerazionale al mercatino di Natale di Gravelines\nUna grande opportunità per scoprire le luminarie, le bancarelle di cibo e artigianato e godere della calda atmosfera festiva."
        ],
        "fr": [
          "Profitez d'une sortie Intergénérationnelle au Marché de Noël de Gravelines\nUne belle occasion de découvrir les illuminations, les chalets gourmands et artisanaux, et de profiter de l’ambiance chaleureuse des fêtes."
        ],
        "nl": [
          "Geniet van een intergenerationeel uitje naar de kerstmarkt van Gravelines\nEen geweldige kans om de verlichting, de eet- en ambachtskraampjes te ontdekken en te genieten van de warme feestelijke sfeer."
        ],
        "es": [
          "Disfrute de una excursión intergeneracional al Mercado de Navidad de Gravelines\nUna gran oportunidad para descubrir las iluminaciones, los puestos de comida y artesanía, y disfrutar del cálido ambiente festivo."
        ]
      },
