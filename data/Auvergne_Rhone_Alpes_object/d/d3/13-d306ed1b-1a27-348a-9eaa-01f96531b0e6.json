  "rdfs:comment": {
    "de": [
      "Verbringen Sie eine gute Zeit und lernen Sie einen spielerischen Sport kennen. Driving Range, 3-Loch-Golfplatz, Green und Übungsbunker stehen allen offen, egal ob Anfänger oder Fortgeschrittene... Golfkurse."
    ],
    "en": [
      "A 260 m practice range, the longest in Haute-Savoie, and a 3-hole course. Golf lessons, mini golf. Restaurant area, meeting rooms."
    ],
    "it": [
      "Divertitevi a scoprire uno sport divertente. Pratica del golf, campo a 3 buche, green e bunker di pratica aperto a tutti, principianti o giocatori esperti... Lezioni di golf."
    ],
    "fr": [
      "Passez un bon moment en découvrant un sport ludique. Practice de golf, parcours 3 trous, green et bunker d'entrainement ouverts à tous, débutants ou confirmés... Cours de golf."
    ],
    "nl": [
      "Veel plezier bij het ontdekken van een leuke sport. Golfoefeningen, 3 holes baan, green en oefenbunker open voor iedereen, beginners of ervaren spelers... Golflessen."
    ],
    "es": [
      "Pásalo en grande descubriendo un deporte divertido. Práctica de golf, campo de 3 hoyos, green y búnker de prácticas abierto a todos, principiantes o jugadores experimentados... Clases de golf."
    ]
  },
