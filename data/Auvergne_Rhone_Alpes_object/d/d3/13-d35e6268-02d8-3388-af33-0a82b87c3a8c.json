  "rdfs:comment": {
    "de": [
      "Von einem ehemaligen Bauernhof ist nur noch dieses Wohnhaus erhalten, das im Kataster von 1806 aufgeführt ist."
    ],
    "en": [
      "There is only this house left from an old farm, listed on the cadastre of 1806."
    ],
    "it": [
      "Di un'antica fattoria, riportata nel catasto del 1806, rimane solo questa casa."
    ],
    "fr": [
      "Il reste seulement ce logis d'une ancienne ferme, figurant sur le cadastre de 1806."
    ],
    "nl": [
      "Van een oude boerderij, die voorkomt in het kadaster van 1806, is alleen dit huis overgebleven."
    ],
