  "rdfs:comment": {
    "de": [
      "Großzügiges Restaurant mit asiatischem Ambiente und herzlichem Empfang. Es bietet raffinierte chinesische und vietnamesische Küche in einem schönen Saal mit Holzbalken aus dem 15."
    ],
    "en": [
      "Spacious restaurant with an Asian atmosphere and a warm welcome, offering refined Chinese and Vietnamese cuisine in a beautiful room with exposed beams from the 15th century."
    ],
    "it": [
      "Ampio ristorante dall'atmosfera asiatica e dall'accoglienza calorosa, che offre una raffinata cucina cinese e vietnamita in una splendida sala con travi a vista del XV secolo."
    ],
    "fr": [
      "Restaurant spacieux à l'ambiance asiatique et à l'accueil chaleureux, proposant une cuisine chinoise et vietnamienne raffinée dans une belle salle avec poutres apparentes du XVe siècle."
    ],
    "nl": [
      "Ruim restaurant met een Aziatische sfeer en een warm welkom, met een verfijnde Chinese en Vietnamese keuken in een prachtige 15e-eeuwse balkenzaal."
    ],
    "es": [
      "Amplio restaurante de ambiente asiático y cálida acogida, que ofrece una refinada cocina china y vietnamita en una hermosa sala con vigas del siglo XV."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Dragon d'Or"
    ]
  },
