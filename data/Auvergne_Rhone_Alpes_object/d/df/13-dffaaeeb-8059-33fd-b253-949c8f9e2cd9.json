    "de": [
      "Gemütliches Bistro und Restaurant auf dem Dorfplatz von Clelles! Wir beziehen unsere Produkte von ultra-lokalen Produzenten. Organisation von Veranstaltungen, Animationen und Themenabenden."
    ],
    "en": [
      "Friendly bistro and restaurant on the village square in Clelles! We source our produce from ultra-local producers. We organize events, entertainment and themed evenings."
    ],
    "it": [
      "Bistrot e ristorante accogliente sulla piazza del villaggio di Clelles! Ci riforniamo di cibo da produttori locali. Organizzazione di eventi, intrattenimento e serate a tema."
    ],
    "fr": [
      "Bistrot et restaurant convivial sur la place du village de Clelles! Nous nous fournissons auprès de nos producteurs ultra locaux. Organisation d'événements, d'animations et soirées thématiques."
    ],
    "nl": [
      "Vriendelijke bistro en restaurant op het dorpsplein in Clelles! Onze gerechten zijn afkomstig van lokale producenten. Organisatie van evenementen, animaties en thema-avonden."
    ],
    "es": [
      "Acogedor bistró y restaurante en la plaza del pueblo de Clelles Nos abastecemos de productores locales. Organización de eventos, animaciones y veladas temáticas."
    ]
