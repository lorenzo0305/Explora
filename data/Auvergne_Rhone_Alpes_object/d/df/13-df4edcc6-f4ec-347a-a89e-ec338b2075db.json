  "rdfs:comment": {
    "de": [
      "Am Rande der RN104 gelegen, sind unsere Aktivitäten vielfältig: Spaziergänge, Wanderungen, Kurse und Praktika, die von einem staatlich geprüften Lehrer betreut werden."
    ],
    "en": [
      "The equestrian center has been established for many years in Chandolas. We offer all horse enthusiasts walks, hikes, introductory and advanced courses in a quiet setting surrounded nature. Our cativity remains family-friendly and is aimed at riders of all ages. Our geographical location allows us to go into countryside directly from the equestrian center. In 2 hours, we can reach the banks of the river Chassezac."
    ],
    "it": [
      "Situate ai margini della RN104, le nostre attività sono varie: passeggiate, escursioni, corsi e corsi di formazione sotto la supervisione di un istruttore qualificato..."
    ],
    "fr": [
      "Situé en bordure de la RN104, nos activités sont variées : balades, randonnées, cours et stages encadrés par un moniteur diplômé d'état.."
    ],
    "es": [
      "Situados al borde de la RN104, nuestras actividades son variadas: paseos, excursiones, cursos y cursillos supervisados por un monitor diplomado por el Estado..."
    ],
    "nl": [
      "Gelegen aan de rand van de RN104 zijn onze activiteiten gevarieerd: wandelingen, trektochten, cursussen en opleidingen onder begeleiding van een gediplomeerde instructeur..."
    ]
  },
