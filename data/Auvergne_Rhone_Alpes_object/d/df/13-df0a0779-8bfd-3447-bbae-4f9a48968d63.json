  "rdfs:comment": {
    "de": [
      "Achtung: Mehrere Bachüberquerungen auf der Strecke (Möglichkeit, Fußgängerbrücken zu benutzen, aber zum Preis, dass man sein Mountainbike einige Meter anheben muss)"
    ],
    "en": [
      "Beware of several stream crossings along the way (pedestrian bridges can be used, but at the cost of lifting your mountain bike a few metres)"
    ],
    "it": [
      "Attenzione a diversi attraversamenti di torrenti lungo il percorso (è possibile utilizzare passerelle pedonali, ma a costo di sollevare la mountain bike di qualche metro)"
    ],
    "fr": [
      "Attention plusieurs traversées de ruisseaux présents  sur le parcours (possibilité d'emprunter les passerelles piétonnes mais au prix de soulever son VTT sur quelques mètres)"
    ],
    "nl": [
      "Pas op voor verschillende rivieroversteken op de route (voetgangersbruggen kunnen worden gebruikt, maar dat kost je mountainbike een paar meter tillen)"
    ],
    "es": [
      "Cuidado con varios cruces de arroyos en la ruta (se pueden utilizar pasarelas peatonales, pero a costa de levantar la bicicleta de montaña unos metros)"
    ]
  },
