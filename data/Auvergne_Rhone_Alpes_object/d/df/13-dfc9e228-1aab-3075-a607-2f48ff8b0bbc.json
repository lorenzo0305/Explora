  "rdfs:comment": {
    "de": [
      "Eine spielerische Abfahrtsroute vom oberen Ende des Gonçon-Sessellifts durch den Wald, die am unteren Ende der Pisten endet und Ihnen einen sehr schönen Ausblick auf Méaudre und seine Umgebung bietet."
    ],
    "en": [
      "A fun downhill itinerary from the top of the Gonçon chairlift through the forest, ending at the bottom of the slopes for a beautiful view of Méaudre and the surrounding area."
    ],
    "it": [
      "Una divertente discesa dalla cima della seggiovia Gonçon attraverso il bosco, che termina in fondo alle piste con una splendida vista su Méaudre e dintorni."
    ],
    "fr": [
      "Un itinéraire descendant ludique depuis le haut du télésiège du Gonçon par la forêt  qui se finit sur le bas des pistes pour vous faire profiter d'une très belle vue sur Méaudre et ses alentours."
    ],
    "es": [
      "Una divertida ruta de descenso desde lo alto del telesilla Gonçon a través del bosque, que termina al pie de las pistas con una hermosa vista de Méaudre y sus alrededores."
    ],
    "nl": [
      "Een leuke afdaling vanaf de top van de stoeltjeslift Gonçon door het bos, eindigend onderaan de piste met een prachtig uitzicht op Méaudre en de omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Forêt - Itinéraire VTT descendant - Bleu"
    ]
  },
