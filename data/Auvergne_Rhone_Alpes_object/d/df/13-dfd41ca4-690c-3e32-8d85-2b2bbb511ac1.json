  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt stellt Ihnen Folgendes zur Verfügung: touristische Dokumentation über die Destination Monts du Lyonnais und Umgebung (Lyon, Beaujolais, ...), Wanderkarten, Mountainbike-Routen, etc."
    ],
    "en": [
      "Our Tourist Office welcomes you to the Pays de L'Arbresle, in the Beaujolais and Coteaux du Lyonnais regions. Come and visit us to discover the must-see sites, the tours on offer and browse the Espace Découverte."
    ],
    "it": [
      "L'Ufficio del Turismo può fornirvi informazioni turistiche sui Monts du Lyonnais e sui dintorni (Lione, Beaujolais, ecc.), mappe escursionistiche, percorsi per mountain bike, ecc."
    ],
    "fr": [
      "L’Office de Tourisme met à votre disposition : documentation touristique sur la Destination Monts du Lyonnais et alentours (Lyon, Beaujolais, ...), cartes de randonnées pédestres, circuits VTT, etc."
    ],
    "es": [
      "La Oficina de Turismo puede facilitarle información turística sobre los Montes del Lyonnais y sus alrededores (Lyon, Beaujolais, etc.), mapas de senderismo, rutas en bicicleta de montaña, etc."
    ],
    "nl": [
      "Het Office du Tourisme kan je voorzien van toeristische informatie over de Monts du Lyonnais en de omgeving (Lyon, Beaujolais, enz.), wandelkaarten, mountainbikeroutes, enz."
    ]
  },
