  "rdfs:comment": {
    "de": [
      "Ruinen des herrschaftlichen Anwesens der Naucaze vom 12. bis zum 17. Jahrhundert.\r\nDas Schloss wird derzeit restauriert. Es besitzt noch einen\r\nturm aus dem 12. Jahrhundert, der das älteste architektonische Element darstellt."
    ],
    "en": [
      "Ruins of the estate of Naucaze built from the 12th to the 17th century."
    ],
    "it": [
      "Rovine del maniero di Naucaze, risalenti al XII-XVII secolo.\r\nIl castello è attualmente in fase di restauro. Ha ancora una torre del 12° secolo, che è l'elemento architettonico più\r\nxII, che è l'elemento architettonico più antico."
    ],
    "fr": [
      "Ruines du domaine seigneurial des Naucaze du XIIe au XVIIe siècle.\r\nLe château est actuellement en cours de restauration. Il possède encore une\r\ntour du XIIe siècle qui est l’élément architectural le plus ancien."
    ],
    "es": [
      "Ruinas del señorío de Naucaze que datan de los siglos XII al XVII.\r\nEl castillo está siendo restaurado. Conserva una torre del siglo XII\r\ndel siglo XII, que es el elemento arquitectónico más antiguo."
    ],
    "nl": [
      "Ruïnes van de heerlijkheid Naucaze uit de 12e tot de 17e eeuw."
    ]
  },
  "rdfs:label": {
    "en": [
      "Naucaze Castle"
    ],
    "fr": [
      "Château de Naucaze"
    ],
    "nl": [
      "Kasteel van Naucaze"
    ]
  },
