  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist für alle offen. Mit Ihrer kostenlosen Mitgliedschaft können Sie eine große Auswahl an: Romanen, Alben, Comics, Zeitschriften und Magazinen, Dokumentarfilmen, Hörbüchern, CDs und DVDs für Erwachsene und Kinder nutzen."
    ],
    "en": [
      "The library is open to all. With your free membership, you can consult a wide choice of: novels, albums, comics, magazines, documentaries, audio books, CDs and DVDs for adults and children."
    ],
    "it": [
      "La biblioteca è aperta a tutti. Con la vostra iscrizione gratuita, potrete consultare un'ampia selezione di: romanzi, album, fumetti, riviste, documentari, audiolibri, CD e DVD per adulti e bambini."
    ],
    "fr": [
      "La bibliothèque est ouverte à tous. Avec votre adhésion gratuite, vous pourrez consulter un large choix de : romans, albums, bandes dessinées, revues et magazines, des documentaires, des livres audio, des CD et des DVD pour les adultes et les enfants."
    ],
    "es": [
      "La biblioteca está abierta a todos. Con tu abono gratuito, podrás consultar una amplia selección de: novelas, álbumes, cómics, revistas, documentales, audiolibros, CD y DVD para adultos y niños."
    ],
    "nl": [
      "De bibliotheek is voor iedereen toegankelijk. Met je gratis lidmaatschap kun je een uitgebreide selectie raadplegen van: romans, albums, strips, tijdschriften, documentaires, luisterboeken, cd's en dvd's voor volwassenen en kinderen."
    ]
  },
