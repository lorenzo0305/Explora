  "rdfs:comment": {
    "de": [
      "Micro-Folie bietet allen einen kostenlosen Zugang zu Tausenden von digitalisierten Kunstwerken! Dieser Ort kann auch Animationen und Veranstaltungen anbieten, um die Kultur lebendig zu halten"
    ],
    "en": [
      "Micro-Folie offers free access to thousands of digitized works of art! The site can also be used to host events and other cultural activities"
    ],
    "it": [
      "Micro-Folie offre accesso gratuito a migliaia di opere d'arte digitalizzate! Il sito offre anche una serie di eventi e attività per far vivere la cultura"
    ],
    "fr": [
      "Micro-Folie offre à tous un accès gratuit à des milliers d’œuvres d’art numérisées ! Ce lieu peut aussi offrir des animations et évènements pour faire vivre la culture"
    ],
    "es": [
      "Micro-Folie ofrece acceso gratuito a miles de obras de arte digitalizadas El sitio también ofrece una serie de eventos y actividades para dar vida a la cultura"
    ],
    "nl": [
      "Micro-Folie biedt gratis toegang tot duizenden gedigitaliseerde kunstwerken! De site biedt ook een reeks evenementen en activiteiten om cultuur tot leven te brengen"
    ]
  },
