      "dc:description": {
        "de": [
          "Zombillénium ist ein Comic, bevor er ein Animationsfilm wird. Mit dem Workshop \"Bubbles\" können Sie Ihren eigenen Comic erstellen."
        ],
        "en": [
          "Zombillénium is a comic book before being an animated film. With the \"Bubbles\" workshop, come and create your own comic book."
        ],
        "it": [
          "Zombillénium è un fumetto prima di essere un film d'animazione. Con il corso \"Bubbles\", venite a creare il vostro fumetto personale."
        ],
        "fr": [
          "Zombillénium est une bande dessinée avant d’être un film d’animation. Avec le stage « Bulles », venez créer votre propre BD."
        ],
        "nl": [
          "Zombillénium is een stripverhaal voordat het een animatiefilm is. Met de cursus \"Bubbels\" kun je je eigen stripverhaal maken."
        ],
        "es": [
          "Zombillénium es un cómic antes que una película de animación. Con el curso \"Burbujas\", ven a crear tu propio cómic."
        ]
      },
