  "rdfs:comment": {
    "de": [
      "Der Glockenturm hat eine Art Vorhalle, der Eingang befindet sich im Westen. Er hatte ein Dach, das von vier Glockentürmen flankiert wurde, und eine Spitze mit einem Hahn auf der Spitze. Das Ganze wurde 1871 von einem Sturm weggefegt."
    ],
    "en": [
      "The bell tower is porch-style, with a west-facing entrance. It had a roof flanked by 4 belfries and topped by a spire bearing a rooster. The whole structure was swept away by a storm in 1871."
    ],
    "it": [
      "Il campanile è del tipo a portico, con ingresso a ovest. Aveva un tetto fiancheggiato da quattro campane e sormontato da una guglia con un gallo. Il tutto fu spazzato via da una tempesta nel 1871."
    ],
    "fr": [
      "Le clocher est de type porche, l'entrée se fait à l'ouest. Il était pourvu d'un toit flanqué de 4 clochetons et surmonté d'une flèche porteuse d'un coq. Le tout fût emporté par une tempête en 1871."
    ],
    "es": [
      "El campanario es de tipo porche, con la entrada al oeste. Tenía un tejado flanqueado por cuatro campanas y rematado por una aguja con un gallo. El conjunto fue arrasado por una tormenta en 1871."
    ],
    "nl": [
      "De klokkentoren is portiekvormig, met een ingang op het westen. Het dak werd geflankeerd door 4 klokkentorens en werd bekroond door een spits met een haan. Hij werd weggeslagen door een storm in 1871."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Clocher Saint Andéol"
    ]
  },
