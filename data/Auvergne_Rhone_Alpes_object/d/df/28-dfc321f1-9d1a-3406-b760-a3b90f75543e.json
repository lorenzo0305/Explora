      "@id": "https://data.datatourisme.fr/45b143b5-9754-3c90-bc4a-c34ac5430e88",
      "dc:description": {
        "de": [
          "Vorstellung des Weinbergs und des Marne-Tals, Besichtigung der Einrichtungen und anschließend kommentierte Verkostung der auf dem Weingut hergestellten Champagner."
        ],
        "en": [
          "Presentation of the vineyard and the Marne Valley, tour of the facilities and guided tasting of champagnes produced at the estate."
        ],
        "it": [
          "Presentazione dei vigneti e della Valle della Marna, visita delle strutture e degustazione guidata degli champagne prodotti nella tenuta."
        ],
        "fr": [
          "Présentation du vignoble et de la Vallée de la Marne, visite des installations puis dégustation commentée des champagnes produits à la propriété."
        ],
        "nl": [
          "Presentatie van de wijngaarden en de Marnevallei, rondleiding door de faciliteiten en begeleide proeverij van de champagnes die op het landgoed worden geproduceerd."
        ],
        "es": [
          "Presentación de los viñedos y del valle del Marne, visita de las instalaciones y degustación guiada de los champanes producidos en la finca."
        ]
      },
