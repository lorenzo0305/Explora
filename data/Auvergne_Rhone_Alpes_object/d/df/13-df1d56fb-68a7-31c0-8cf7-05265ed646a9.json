  "rdfs:comment": {
    "de": [
      "HEAT ist eine Mischung aus Foodcourt und Drittort und beherbergt 4 Seecontainer, die dem Streetfood gewidmet sind, sowie ein Veranstaltungsprogramm, das von lokalen Kollektiven getragen wird."
    ],
    "en": [
      "Heat, Confluence’s food hall, lies within a huge depot and houses 4 containers whose tenants change throughout the year."
    ],
    "it": [
      "A metà strada tra un foodcourt e un terzo luogo, HEAT ospita 4 container marittimi dedicati allo street food, oltre a un programma di eventi organizzati da gruppi locali."
    ],
    "fr": [
      "À mi-chemin entre foodcourt et tiers-lieu, HEAT accueille 4 containers maritimes dédiés à la street food ainsi qu'une programmation événementielle portée par des collectifs locaux."
    ],
    "nl": [
      "HEAT, dat het midden houdt tussen een foodcourt en een third place, herbergt 4 zeecontainers gewijd aan straatvoedsel en een programma van evenementen georganiseerd door lokale groepen."
    ],
    "es": [
      "A medio camino entre un patio de comidas y un tercer local, HEAT alberga 4 contenedores marítimos dedicados a la comida callejera, así como un programa de actos organizados por grupos locales."
    ]
  },
  "rdfs:label": {
