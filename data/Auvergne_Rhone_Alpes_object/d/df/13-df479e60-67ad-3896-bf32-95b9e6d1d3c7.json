  "rdfs:comment": {
    "de": [
      "Ein spielerischer und pädagogischer Parcours, der am Kreisverkehr von Les Fayes im Wald von Colettes beginnt. Gehen Sie mit Anweisungen, Kartografie und Fragen los, die Sie auf der Website www.valdesioule.com herunterladen können. Dauer: 1 Stunde 15 Minuten."
    ],
    "en": [
      "Fun and educational trail starting from the Fayes traffic circle in the Colettes forest. Set off with instructions, map and questions downloadable from www.valdesioule.com. Duration 1h15."
    ],
    "it": [
      "Un percorso divertente ed educativo che parte dalla rotonda di Fayes nella foresta di Colettes. Istruzioni, mappe e domande possono essere scaricate dal sito www.valdesioule.com. Durata: 1 ora e 15 minuti."
    ],
    "fr": [
      "Parcours ludique et pédagogique au départ du rond-point des Fayes en forêt des Colettes. Partir avec consignes, cartographie et questions en téléchargement sur le site www.valdesioule.com. Durée 1h15."
    ],
    "es": [
      "Recorrido lúdico y pedagógico que parte de la rotonda de Fayes, en el bosque de Colettes. Las instrucciones, mapas y preguntas pueden descargarse de www.valdesioule.com. Duración: 1 hora y 15 minutos."
    ],
    "nl": [
      "Oriëntatielopen race"
    ]
  },
