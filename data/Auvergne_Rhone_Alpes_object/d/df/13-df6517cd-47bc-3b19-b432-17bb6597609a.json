  "rdfs:comment": {
    "de": [
      "Alt(Ehemalig) limonaderie mit seinem hundertjährigen glycine, der Terrasse, Garten. Traditionelle Karte von Gegend. Bio hergestellt(herbeigeführt), kurze Umkreise(Rundreisen)."
    ],
    "en": [
      "Former lemonade factory with its hundred-year-old wisteria, terrace, garden. Traditional menu made with local produce . Organic products from local food network. New: pizzas to eat-in or to take away. Business meals, banquets, weddings and family events. Contact us for more information. Venue rental. Restaurant-boutique, sale of local produce."
    ],
    "it": [
      "Antica limonaia con glicine secolare, terrazza. Cucina tradizionale con un tocco orientale. Tajine, couscous, ravioli gratinati, insalate. Hamburger e patatine fritte, insalate, alimentari, prodotti locali."
    ],
    "fr": [
      "Ancienne limonaderie avec sa glycine centenaire, terrasse. Cuisine traditionnelle avec une touche orientale. Tajines, couscous, gratins de ravioles, salades. Burger et frites maison, salades, épicerie, produits locaux."
    ],
    "nl": [
      "Voormalige limonaderie met een honderd jaar oude blauweregen en terras. Traditionele kaart met streekgerechten en pizza's. Biologische producten, directe verkoop. Nieuw: pizza om ter plaatse op te eten of om mee te nemen. Vanaf mei: restaurant-winkel, de verkoop van streekproducten."
    ],
    "es": [
      "Antigua limonería con su glicinia centenaria, terraza. Cocina tradicional con un toque oriental. Tajines, cuscús, raviolis gratinados, ensaladas. Hamburguesas y patatas fritas caseras, ensaladas, comestibles, productos locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant-bar Le Poët-Laval"
    ]
  },
