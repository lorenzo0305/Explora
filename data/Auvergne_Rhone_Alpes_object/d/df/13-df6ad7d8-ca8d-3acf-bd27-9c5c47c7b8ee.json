  "rdfs:comment": {
    "de": [
      "Filmvorführung mit anschließendem Austausch über unsere Beziehung zum Leben und zu Pflanzen mit Corinne Bourgery, Agraringenieurin aus Montilienne und Baumspezialistin.\r\nRegie: Ildiko Enyedi\r\nMit Tony Leung Chiu-Wai, Léa Seydoux, Luna Wedler\r\nDeutschland, Ungarn"
    ],
    "en": [
      "Screening followed by a discussion on our relationship with living beings and plants with Corinne Bourgery, an agricultural engineer from Montilienne specializing in trees.\r\nDirected by Ildiko Enyedi\r\nWith Tony Leung Chiu-Wai, Léa Seydoux, Luna Wedler\r\nGermany, Hungary"
    ],
    "it": [
      "Proiezione seguita da una discussione sul nostro rapporto con gli esseri viventi e le piante con Corinne Bourgery, ingegnere agricolo di Montili, specializzata in alberi.\r\nDiretto da Ildiko Enyedi\r\nCon Tony Leung Chiu-Wai, Léa Seydoux, Luna Wedler\r\nGermania, Ungheria"
    ],
    "fr": [
      "Projection suivie d’un échange sur notre rapport au vivant et aux plantes avec Corinne Bourgery, ingénieure agronome montilienne, spécialiste des arbres.\r\nRéalisé par Ildiko Enyedi\r\nAvec Tony Leung Chiu-Wai, Léa Seydoux, Luna Wedler\r\nAllemagne, Hongrie"
    ],
    "nl": [
      "Vertoning gevolgd door een discussie over onze relatie met levende wezens en planten met Corinne Bourgery, landbouwingenieur uit Montili, gespecialiseerd in bomen.\r\nRegie: Ildiko Enyedi\r\nMet Tony Leung Chiu-Wai, Léa Seydoux, Luna Wedler\r\nDuitsland, Hongarije"
    ],
    "es": [
      "Proyección seguida de un debate sobre nuestra relación con los seres vivos y las plantas con Corinne Bourgery, ingeniera agrónoma de Montili, especializada en árboles.\r\nDirigida por Ildiko Enyedi\r\nCon Tony Leung Chiu-Wai, Léa Seydoux, Luna Wedler\r\nAlemania, Hungría"
    ]
  },
  "rdfs:label": {
