  "rdfs:comment": {
    "de": [
      "Das Ecomusée du Lac d'Annecy bietet ein originelles und immersives Erlebnis, bei dem Sie den Savoyern des 19. Jahrhunderts am See von Annecy begegnen... mit verschiedenen Aktivitäten, Rätselspielen und spielerischen Rundgängen, die Sie allein, zu zweit, mit Freunden oder mit der Familie erleben können."
    ],
    "en": [
      "The Ecomusée du Lac d'Annecy offers an original and immersive experience to meet the Savoyards of the 19th century on the shores of Lake Annecy... with a variety of activities, puzzles and fun trails to enjoy on your own, as a duo, with friends or as a family."
    ],
    "it": [
      "Un lago, degli uomini, un territorio... Lasciatevi sorprendere dalla vita dei savoiardi del XIX secolo, lungo il lago di Annecy!"
    ],
    "fr": [
      "L'Ecomusée du Lac d'Annecy propose une expérience originale et immersive à la rencontre des Savoyards du 19e siècle au bord du lac d'Annecy... avec diverses activités, jeux-énigmes et parcours ludiques à vivre en solo, en duo, entre amis ou en famille."
    ],
    "es": [
      "El Ecomuseo del Lago de Annecy propone una experiencia original y envolvente para conocer a los saboyanos del siglo XIX a orillas del lago de Annecy... con diversas actividades, acertijos y divertidos recorridos para disfrutar solo, en pareja, con amigos o en familia."
    ],
    "nl": [
      "Een meer, mensen, een gebied... Laat u verrassen door het leven van de Savoyards in de 19de eeuw, aan de oever van het meer van Annecy!"
    ]
  },
