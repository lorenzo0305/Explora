  "rdfs:comment": {
    "de": [
      "Nordisches Gebiet von Mézenc: 52 km markierte Loipen, die sowohl für Alternative als auch für Skating gespurt sind.\r\nSchneeschuhwandern auf 4 markierten und gesicherten Pisten.\r\nRodeln auf einem gesicherten und eingezäunten Gelände.\r\nBetrieb vom 01/12 bis zum 24/03. Kostenpflichtiger Bereich."
    ],
    "en": [
      "Domaine nordique du Mézenc: 52 km of marked, alternating and skating trails.\r\nSnowshoeing on 4 marked, secure trails.\r\nSledging in a secure, enclosed area.\r\nOpen from 01/12 to 24/03. Paying area."
    ],
    "it": [
      "Il comprensorio di sci nordico del Mézenc: 52 km di piste segnalate, alternate e per skating.\r\nEscursioni con le racchette da neve su 4 percorsi segnalati e sicuri.\r\nSlittino in un'area sicura e recintata.\r\nAperto dal 01/12 al 24/03. Area a pagamento."
    ],
    "fr": [
      "Domaine nordique du Mézenc : 52 km de pistes à la fois balisées, tracées pour l’alternatif et le skating.\r\nRaquettes à neige sur 4 pistes balisées et sécurisées.\r\nLuge sur un espace sécurisé et clos. \r\nFonctionnement du 01/12 jusqu'au 24/03. Domaine payant."
    ],
    "nl": [
      "Noords skigebied Mézenc: 52 km gemarkeerde, afwisselende en skatingloipes.\r\nSneeuwschoenwandelen op 4 gemarkeerde en beveiligde paden.\r\nSleeën in een veilig, afgesloten gebied.\r\nGeopend van 01/12 tot 24/03. Betaald gebied."
    ],
    "es": [
      "El dominio de esquí nórdico de Mézenc: 52 km de pistas balizadas, alternas y de patinaje.\r\nRaquetas de nieve en 4 pistas balizadas y seguras.\r\nTrineo en una zona segura y cerrada.\r\nAbierto del 01/12 al 24/03. Zona de pago."
    ]
  },
  "rdfs:label": {
