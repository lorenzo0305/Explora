  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Aiguilles de Péclet bietet Ihnen einen magischen Ort und eine raffinierte Küche in 3000 m Höhe, am Fuße des Péclet-Gletschers. Die schöne Terrasse liegt in der Sonne und bietet einen herrlichen Panoramablick."
    ],
    "en": [
      "Les Aiguilles de Péclet restaurant offers a magical setting and refined cuisine at 3000m altitude, at the foot of the Péclet glacier. The beautiful terrace is bathed in sunshine, with a magnificent panoramic view."
    ],
    "it": [
      "Il ristorante Les Aiguilles de Péclet offre un ambiente magico e una cucina raffinata a 3000 metri di altitudine, ai piedi del ghiacciaio di Péclet. La splendida terrazza è inondata di sole, con una magnifica vista panoramica."
    ],
    "fr": [
      "Le restaurant Les Aiguilles de Péclet vous propose un lieu magique et une cuisine raffinée à 3000m d'altitude, au pied du glacier de Péclet. La belle terrasse est située en plein soleil, avec une magnifique vue panoramique."
    ],
    "nl": [
      "Het restaurant Les Aiguilles de Péclet biedt een magische omgeving en een verfijnde keuken op 3000 meter hoogte, aan de voet van de gletsjer van Péclet. Het prachtige terras baadt in de zon, met een prachtig panoramisch uitzicht."
    ],
    "es": [
      "El restaurante Les Aiguilles de Péclet ofrece un marco mágico y una cocina refinada a 3000 m de altitud, a los pies del glaciar de Péclet. La hermosa terraza está bañada por el sol, con una magnífica vista panorámica."
    ]
  },
