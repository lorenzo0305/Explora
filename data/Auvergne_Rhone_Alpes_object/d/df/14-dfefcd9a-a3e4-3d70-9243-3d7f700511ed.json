  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73ddde2d-dbe1-31e8-be43-b4cd31562d10",
      "dc:description": {
        "de": [
          "Entdecken Sie in unserem Feinkostladen unsere regionalen Produkte (Rum, Spirituosen, Bier, Käse, Terrinen aus Land und Meer ...) und unser lokales Kunsthandwerk (Geschenke, Deko, Souvenirs ...)"
        ],
        "en": [
          "Come and discover in our delicatessen our regional products (rums, spirits, beers, cheeses, terrines terre et mer...) and our local crafts (gifts, decoration, souvenirs...)"
        ],
        "it": [
          "Venite alla nostra gastronomia per scoprire i nostri prodotti regionali (rum, liquori, birre, formaggi, terrine di terra e di mare...) e il nostro artigianato locale (regali, decorazioni, souvenir...)"
        ],
        "fr": [
          "Venez découvrir dans notre épicerie fine nos produits régionaux (rhums, spiritueux, bières, fromages, terrines terre et mer...)et notre artisanat local (cadeaux, déco, souvenirs ...)"
        ],
        "es": [
          "Venga a nuestra charcutería para descubrir nuestros productos regionales (ron, licores, cervezas, quesos, terrinas de tierra y mar...) y nuestra artesanía local (regalos, decoración, recuerdos...)"
        ],
        "nl": [
          "Kom naar onze delicatessenwinkel en ontdek onze regionale producten (rum, sterke drank, bier, kaas, terrines van land en zee...) en onze lokale ambachten (cadeaus, decoratie, souvenirs...)"
        ]
      },
      "@type": [
