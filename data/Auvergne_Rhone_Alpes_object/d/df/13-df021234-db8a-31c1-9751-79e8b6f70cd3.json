  "rdfs:comment": {
    "de": [
      "8. STROL MOTOR SHOW, organisiert von Monistrol animation.\r\nMit Ausstellung von Lastwagen, Oldtimern, Motorrädern usw. und Akrobatikvorführungen.\r\nStände im Inneren der Sporthalle.\r\nLkw-Parade in der Stadt am Samstag (Start um 16 Uhr auf dem Gelände von Le Mazel)."
    ],
    "en": [
      "8th STROL MOTOR SHOW organized by Monistrol animation.\r\nWith exhibition of trucks, vintage vehicles, motorcycles, etc. and acrobatics demonstrations.\r\nStands inside the gymnasium.\r\nTruck parade through town on Saturday (departure at 4pm from the Mazel site)."
    ],
    "it": [
      "8° STROL MOTOR SHOW organizzato dall'animazione Monistrol.\r\nCon esposizione di camion, veicoli d'epoca, moto, ecc. e dimostrazioni di acrobazie.\r\nStand all'interno della palestra.\r\nSfilata di camion attraverso la città il sabato (a partire dalle 16.00 dal sito di Mazel)."
    ],
    "fr": [
      "8ème STROL MOTOR SHOW organisé par Monistrol animation. \r\nAvec exposition de camions, véhicules anciens, motos, etc. et démonstrations d'acrobaties.\r\nStands à l’intérieur du gymnase.\r\nParade de camions dans la ville le samedi (départ à 16h du site du Mazel)."
    ],
    "nl": [
      "8e STROL MOTOR SHOW georganiseerd door Monistrol animatie.\r\nMet tentoonstelling van vrachtwagens, oldtimers, motoren enz. en acrobatiekdemonstraties.\r\nStands in het gymnasium.\r\nOptocht van vrachtwagens door de stad op zaterdag (vanaf 16.00 uur vanaf de Mazel-site)."
    ],
    "es": [
      "8º STROL MOTOR SHOW organizado por la animación Monistrol.\r\nCon exposición de camiones, vehículos antiguos, motos, etc. y demostraciones de acrobacia.\r\nStands en el interior del gimnasio.\r\nDesfile de camiones por la ciudad el sábado (salida a las 16.00 h del recinto de Mazel)."
    ]
  },
