  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8da2504e-fea0-39e7-b342-b9af0032d8e4",
      "dc:description": {
        "de": [
          "GOLDMEN, von Tausenden Fans gefeiert und von den Medien gefeiert, belebt die Bühnen und verteidigt stolz das Repertoire von Jean-Jacques GOLDMAN.\nTüröffnung um 16.30 Uhr"
        ],
        "en": [
          "Acclaimed by thousands of fans and endorsed by the media, GOLDMEN have taken to the stage proudly defending the repertoire of Jean-Jacques GOLDMAN.\nDoors open at 4.30pm"
        ],
        "it": [
          "Acclamati da migliaia di fan e lodati dai media, i GOLDMEN salgono sul palco orgogliosi di difendere il repertorio di Jean-Jacques GOLDMAN.\nApertura porte alle 16.30"
        ],
        "fr": [
          "Plébiscité par des milliers de fans et adoubé par les médias, GOLDMEN écime les scènes en défendant fièrement le répertoire de Jean-Jacques GOLDMAN.\nOuverture des portes à 16h30"
        ],
        "nl": [
          "GOLDMEN, bejubeld door duizenden fans en geprezen door de media, betreden met trots het podium om het repertoire van Jean-Jacques GOLDMAN te verdedigen.\nDeuren open om 16.30 uur"
        ],
        "es": [
          "Aclamados por miles de fans y elogiados por los medios de comunicación, los GOLDMEN suben al escenario defendiendo con orgullo el repertorio de Jean-Jacques GOLDMAN.\nApertura de puertas a las 16.30 h"
        ]
      },
      "@type": [
        "Description"
