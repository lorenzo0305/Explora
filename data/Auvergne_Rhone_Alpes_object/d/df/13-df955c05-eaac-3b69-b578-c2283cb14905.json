  "rdfs:comment": {
    "de": [
      "Entdecken Sie Arandon-Passins, ein Dorf im Südosten der Balcons du Dauphiné: ein erhaltenes bauliches Erbe und den Espace Naturel Sensible de la Save, für einen Ausflug in die Natur in Nord-Isère."
    ],
    "en": [
      "Discover Arandon-Passins, a village in the south-east of the Balcons du Dauphiné: a preserved built heritage and the Espace Naturel Sensible de la Save, for a nature getaway in Nord-Isère."
    ],
    "it": [
      "Scoprite Arandon-Passins, un villaggio a sud-est dei Balcons du Dauphiné: un patrimonio edilizio preservato e l'Espace Naturel Sensible de la Save, per una vacanza nella natura nel Nord-Isère."
    ],
    "fr": [
      "Découvrez Arandon-Passins, un village au sud-est des Balcons du Dauphiné : un patrimoine bâti préservé et l'Espace Naturel Sensible de la Save, pour une escapade nature en Nord-Isère."
    ],
    "nl": [
      "Ontdek Arandon-Passins, een dorp in het zuidoosten van de Balcons du Dauphiné: een beschermd gebouwd erfgoed en het Espace Naturel Sensible de la Save, voor een natuurvakantie in Nord-Isère."
    ],
    "es": [
      "Descubra Arandon-Passins, pueblo del sureste de los Balcones del Dauphiné: un patrimonio edificado preservado y el Espacio Natural Sensible de la Save, para una escapada en plena naturaleza en Nord-Isère."
    ]
  },
