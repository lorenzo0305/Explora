  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e2f5a8be-cb0e-3f6f-a5cf-77c1fb74f8e0",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 8:30 - 18:00 Uhr\nSamstags um 17 Uhr geschlossen\n\nSonntag geschlossen\n \n Pannenhilfe und Intervention :\n\nFür alle dringenden Anfragen besteht die Möglichkeit, unter der Nummer 03 21 59 77 77 einzugreifen\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 8:30am - 6pm\nCloses at 5pm on Saturday\n\nClosed on Sunday\n \n Breakdown service and intervention :\n\nFor all urgent requests, please call 03 21 59 77 77\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato: 8.30-18.00\nIl sabato chiude alle 17.00\n\nChiuso la domenica\n \n Servizio guasti e interventi :\n\nPer riparazioni urgenti, chiamare il numero 03 21 59 77 77\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi : 8h30 - 18h \nFermeture à 17h le samedi\n\nFermeture le dimanche\n \n Dépannage et intervention :\n\nPour toutes demandes urgentes, possibilité d'intervenir en appelant au 03 21 59 77 77\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 8.30 - 18u\nSluit om 17u op zaterdag\n\nGesloten op zondag\n \n Pechverhelping en interventie :\n\nVoor dringende reparaties, bel 03 21 59 77 77\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado: de 8h30 a 18h00\nLos sábados cierra a las 17h\n\nDomingos cerrado\n \n Servicio de averías e intervención :\n\nPara reparaciones urgentes, llame al 03 21 59 77 77\n\n "
        ]
      },
