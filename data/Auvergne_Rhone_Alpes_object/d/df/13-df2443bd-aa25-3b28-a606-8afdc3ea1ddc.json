  "rdfs:comment": {
    "de": [
      "Die Déôme fließt auf einer Länge von 29,2 km durch sechs Gemeinden in zwei Departements (Loire und Ardèche). Im Departement Loire wird der Fluss Déôme genannt, in seinem Teil in der Ardèche heißt er Deûme."
    ],
    "en": [
      "The Déôme flows for 29.2 km through six communes in two départements (Loire and Ardèche). Called Déôme in the Loire department, the river is called Deûme in the Ardèche."
    ],
    "it": [
      "La Déôme scorre per 29,2 km attraverso sei comuni in due dipartimenti (Loira e Ardèche). Chiamato Déôme nel dipartimento della Loira, il fiume è conosciuto come Deûme nell'Ardèche."
    ],
    "fr": [
      "La Déôme coule sur 29,2 km et traverse six communes situées dans deux départements (Loire et Ardèche). Appelée Déôme dans le département de la Loire, la rivière est appelée Deûme dans sa partie ardéchoise."
    ],
    "es": [
      "El Déôme recorre 29,2 km a través de seis municipios de dos departamentos (Loira y Ardèche). Llamado Déôme en el departamento del Loira, el río se conoce como Deûme en el de Ardèche."
    ],
    "nl": [
      "De Déôme stroomt over een afstand van 29,2 km door zes gemeenten in twee departementen (Loire en Ardèche). In het departement Loire heet de rivier Déôme, in de Ardèche Deûme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche dans la rivière Déôme"
    ]
  },
