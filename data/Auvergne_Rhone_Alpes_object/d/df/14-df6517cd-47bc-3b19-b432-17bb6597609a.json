  "rdfs:comment": {
    "de": [
      "Reift in seinen Reifekellern in der Zitadelle von Arras seine traditionellen und handwerklich hergestellten Bauernkäse von bester Qualität."
    ],
    "en": [
      "Ripens its premium quality traditional and farmhouse cheeses in its maturing cellars in the Citadelle of Arras."
    ],
    "it": [
      "Matura i suoi formaggi tradizionali e di fattoria di prima qualità nelle sue cantine di stagionatura nella Citadelle di Arras."
    ],
    "fr": [
      "Affine dans ses caves d'affinage dans la Citadelle d'Arras ses fromages de tradition et fermiers artisanaux de première qualité."
    ],
    "nl": [
      "Rijpt zijn traditionele kazen en boerenkazen van topkwaliteit in zijn rijpingskelders in de Citadelle van Arras."
    ],
    "es": [
      "Madura sus quesos tradicionales y de granja de primera calidad en sus bodegas de maduración de la Citadelle de Arras."
    ]
