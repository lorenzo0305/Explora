  "rdfs:comment": {
    "de": [
      "Atelier Kunsthandwerkliche Boutique von Mes Amulettes, Juwelierin Joaillière.\r\nDer Arty Concept Store in Saisies stellt lokales Qualitätshandwerk in den Vordergrund und bietet Ihnen die Möglichkeit, sich in mehreren Workshops in die Kunst des Handwerks einführen zu lassen.\r\nMit dem Label Artisan d'Art ausgezeichnet"
    ],
    "en": [
      "Atelier Boutique d?artisanat d?art de Mes Amulettes, Bijoutière Joaillière.\r\nThe arty concept store in Les Saisies showcases quality local craftsmanship, and offers you the chance to learn its art in a series of workshops.\r\nLabellisée Artisan d?Art"
    ],
    "it": [
      "Mes Amulettes Laboratorio di gioielleria e boutique di artigianato artistico.\r\nIl concept store artistico di Les Saisies mette in mostra l'artigianato locale di qualità e vi offre la possibilità di cimentarvi con la sua arte in una serie di laboratori.\r\nArtigiano d'arte certificato"
    ],
    "fr": [
      "Atelier Boutique d’artisanat d’art de Mes Amulettes, Bijoutière Joaillière.\r\nLe concept store arty des Saisies met en valeur l’artisanat local de qualité et vous propose de venir vous initier à son art lors de plusieurs ateliers.\r\nLabellisée Artisan d’Art"
    ],
    "nl": [
      "Mes Amulettes juweliersatelier en kunstnijverheidsboetiek.\r\nDe kunstzinnige conceptwinkel in Les Saisies laat lokaal vakmanschap van hoge kwaliteit zien en biedt je de kans om zelf aan de slag te gaan in een reeks workshops.\r\nGecertificeerd ambachtsman"
    ],
    "es": [
      "Mes Amulettes Taller de joyería y tienda de artesanía.\r\nEste concepto de tienda artística de Les Saisies exhibe artesanía local de calidad y le ofrece la oportunidad de probar su arte en una serie de talleres.\r\nArtesano certificado"
    ]
  },
  "rdfs:label": {
