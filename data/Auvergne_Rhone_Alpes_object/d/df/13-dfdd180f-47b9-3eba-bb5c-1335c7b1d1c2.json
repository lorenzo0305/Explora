  "rdfs:comment": {
    "de": [
      "LE SAINT CLÉMENT, ein charmantes Hotel im Herzen des grünen Beaujolais, verfügt über 8 Zimmer mit allem Komfort, die mit allen notwendigen Einrichtungen für Ihren Aufenthalt im Departement Rhône ausgestattet sind."
    ],
    "en": [
      "LE SAINT CLÉMENT, a charming hotel in the heart of the green Beaujolais region, has 8 comfortable rooms, with all the facilities you need for your stay in the Rhône department."
    ],
    "it": [
      "LE SAINT CLÉMENT, un hotel di charme nel cuore della verde regione del Beaujolais, dispone di 8 camere confortevoli con tutti i servizi necessari per il vostro soggiorno nel dipartimento del Rodano."
    ],
    "fr": [
      "LE SAINT CLÉMENT, hôtel de charme au cœur du Beaujolais vert, dispose de 8 chambres tout confort, bénéficiant de tous les équipements nécessaires à votre séjour dans le département du Rhône."
    ],
    "es": [
      "LE SAINT CLÉMENT, un hotel con encanto en el corazón de la verde región del Beaujolais, dispone de 8 cómodas habitaciones con todas las instalaciones necesarias para su estancia en el departamento del Ródano."
    ],
    "nl": [
      "LE SAINT CLÉMENT, een charmant hotel in het hart van de groene Beaujolais streek, heeft 8 comfortabele kamers met alle faciliteiten die je nodig hebt voor je verblijf in het departement Rhône."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Restaurant LE SAINT CLÉMENT"
    ]
  },
