  "rdfs:comment": {
    "de": [
      "Alle Bahnen sind mit Gittern für Kinder ab 3 Jahren ausgestattet. Videospiele, Tischfußball, Billardtische und viele andere Spiele. Bei schlechtem Wetter ab 10 Uhr geöffnet."
    ],
    "en": [
      "All lanes are equipped with gates for children aged 3 and over. Video games, table soccer, billiards and many other games. Open from 10 a.m. in case of bad weather."
    ],
    "it": [
      "Tutte le piste sono dotate di barriere per i bambini dai 3 anni in su. Videogiochi, calcio balilla, tavoli da biliardo e molti altri giochi. Aperto dalle 10 in caso di maltempo."
    ],
    "fr": [
      "Toutes les pistes sont équipées de barrières pour les enfants à partir de 3 ans. Jeux vidéos, babyfoot, billards et beaucoup d’autres jeux. Ouverture à partir de 10h en cas de mauvais temps."
    ],
    "es": [
      "Todas las pistas están equipadas con barreras para niños a partir de 3 años. Videojuegos, futbolín, mesas de billar y muchos otros juegos. Abierto a partir de las 10 de la mañana en caso de mal tiempo."
    ],
    "nl": [
      "Alle banen zijn uitgerust met slagbomen voor kinderen vanaf 3 jaar. Videogames, tafelvoetbal, pooltafels en vele andere spellen. Geopend vanaf 10 uur bij slecht weer."
    ]
  },
