  "rdfs:comment": {
    "de": [
      "Im Winter am Fuße der Pisten, im Sommer inmitten der Natur. Familienfreundliches Chalet-Hotel mit Gourmet-Restaurant, lebhaftem Après-Ski, Spa, beheiztem Hallenbad, Sauna und Fitness."
    ],
    "en": [
      "At the foot of the slopes in winter, in the heart of nature in summer. Family-run chalet-hotel with gourmet restaurant, lively après-ski, spa, heated indoor pool, sauna and fitness center."
    ],
    "it": [
      "Ai piedi delle piste in inverno, nel cuore della natura in estate. Chalet hotel a conduzione familiare con ristorante gourmet, vivace après-ski, spa, piscina interna riscaldata, sauna e centro fitness."
    ],
    "fr": [
      "Au pied des pistes l’hiver, au cœur de la nature l’été. Hôtel-chalet familial avec restaurant gourmand, après-ski animé, spa, piscine couverte chauffée, sauna et fitness."
    ],
    "es": [
      "Al pie de las pistas en invierno, en plena naturaleza en verano. Chalet hotel familiar con restaurante gastronómico, animado après-ski, spa, piscina cubierta climatizada, sauna y gimnasio."
    ],
    "nl": [
      "Aan de voet van de pistes in de winter, midden in de natuur in de zomer. Familiehotel met gastronomisch restaurant, levendige après-ski, spa, verwarmd binnenzwembad, sauna en fitnesscentrum."
    ]
  },
