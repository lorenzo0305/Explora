  "rdfs:comment": {
    "de": [
      "Diese Brasserie bietet Ihnen ein vielfältiges Angebot an Speisen: von einfachen Snacks bis hin zu aufwendigeren Gerichten! Muscheln mit Pommes frites, Andouillettes, Schnitzel Milanaise, große Auswahl an Salaten... Sonntags Brunch!"
    ],
    "en": [
      "This brasserie proposes a varied range of meals, from simple snacks to more elaborate dishes! These include mussels with chips, andouillettes (chitterling sausage) and breaded veal cutlets to name but a few! Try the Sunday brunch."
    ],
    "it": [
      "Questa brasserie offre una varietà di ristoranti: dai semplici spuntini alla cucina più elaborata! Cozze fritte, andouillettes, cotolette alla milanese, un'ampia scelta di insalate? Brunch la domenica!"
    ],
    "fr": [
      "Cette brasserie vous propose une restauration variée : du simple snack à une cuisine plus élaborée ! Moules frites, andouillettes, escalopes milanaises, grand choix de salades… Brunch le dimanche !"
    ],
    "es": [
      "Esta brasserie ofrece una variedad de restaurantes: ¡desde simples aperitivos hasta cocina más elaborada! Mejillones fritos, andouillettes, escalopes a la milanesa, una amplia selección de ensaladas.. ¡El brunch de los domingos!"
    ],
    "nl": [
      "Deze brasserie biedt een verscheidenheid aan restaurants: van eenvoudige snacks tot een meer uitgebreide keuken! Gebakken mosselen, andouillettes, Milanese schnitzels, een ruime keuze aan salades... Brunch op zondag!"
    ]
  },
