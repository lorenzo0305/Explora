  "rdfs:comment": {
    "de": [
      "Berggasthof im Herzen des Chartreuse-Massivs und am Fuße des Ferienortes Désert d'Entremont, am Ausgangspunkt zahlreicher Wanderungen. Genießen Sie die herrliche Aussicht auf die umliegenden Berge und die hausgemachten Gerichte aus frischen Produkten."
    ],
    "en": [
      "At the foot of the slopes of the Desert d'Entremont resort, on the plateau, facing Mont Blanc and Granier, enjoy our specialties."
    ],
    "it": [
      "Locanda di montagna nel cuore del massiccio della Chartreuse e ai piedi del Désert d'Entremont, alla partenza di numerose escursioni. Venite a godere di una vista superba sulle montagne circostanti e di piatti fatti in casa con prodotti freschi."
    ],
    "fr": [
      "Auberge de montagne au cœur du massif de Chartreuse et au pied de la station du Désert d'Entremont, au départ de nombreuses randonnées. Venez profitez d'une superbe vue sur les montagnes environnantes et de plats faits maison à base de produits frais."
    ],
    "es": [
      "Posada de montaña en el corazón del macizo de la Chartreuse y al pie de la estación del Désert d'Entremont, al inicio de numerosas excursiones. Venga a disfrutar de una magnífica vista de las montañas circundantes y de platos caseros elaborados con productos frescos."
    ],
    "nl": [
      "Bergherberg in het hart van het massief van de Chartreuse en aan de voet van het skioord Désert d'Entremont, aan het begin van talrijke wandelingen. Kom genieten van een prachtig uitzicht op de omliggende bergen en huisgemaakte gerechten van verse producten."
    ]
  },
  "rdfs:label": {
