  "rdfs:comment": {
    "de": [
      "Das Museum Cour des Potiers zeigt Ihnen die Arbeit mit der Erde in Ferrière la petite von 1718 bis heute und zeugt von einer reichen und farbenfrohen Volkskunst."
    ],
    "en": [
      "The Cour des Potiers museum allows you to discover the work of the earth in Ferrière la petite from 1718 to today and testifies to a rich and colorful popular art."
    ],
    "it": [
      "Il museo Cour des Potiers presenta la lavorazione dell'argilla a Ferrière la Petite dal 1718 a oggi e testimonia un'arte popolare ricca e colorata."
    ],
    "fr": [
      "Le musée de la Cour des Potiers vous fait découvrir le travail de la terre à Ferrière la petite de 1718 à nos jours et témoigne d'un art populaire riche et coloré."
    ],
    "nl": [
      "Het Cour des Potiers museum laat u kennismaken met het kleiwerk in Ferrière la Petite van 1718 tot heden en getuigt van een rijke en kleurrijke volkskunst."
    ],
    "es": [
      "El museo de la Cour des Potiers le presenta el trabajo del barro en Ferrière la Petite desde 1718 hasta la actualidad y es testigo de un arte popular rico y colorido."
    ]
  },
