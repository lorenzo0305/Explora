      "@id": "https://data.datatourisme.fr/d77a475e-2649-3c94-bc35-d62bb788a199",
      "dc:description": {
        "de": [
          "Ein Workshop - Entdeckung rund um die Ausstellung für einen fröhlichen Moment unter Kindern!\nMontags um 14:30 Uhr. Ab 6 Jahren. Dauer: 2 Stunden. Preis: 3,50 ? pro Kind. Reservierung empfohlen: 03 21 10 02 20"
        ],
        "en": [
          "A workshop - discovery around the exhibition for a joyful moment between children!\nMondays at 2.30pm. Ages 6 and up. Duration: 2h00. Price: 3.50? per child. Reservations recommended 03 21 10 02 20"
        ],
        "it": [
          "Un laboratorio di scoperta basato sulla mostra per divertirsi con i bambini!\nLunedì alle 14.30. Dai 6 anni in su. Durata: 2 ore. Prezzo: 3,50 euro a bambino. Prenotazione consigliata 03 21 10 02 20"
        ],
        "fr": [
          "Un atelier - découverte autour de l'exposition pour un moment joyeux entre enfants !\nLes lundis à 14h30. Dès 6 ans. Durée : 2h00. Tarif : 3,50€ par enfant. Réservation conseillée 03 21 10 02 20"
        ],
        "es": [
          "Un taller de descubrimiento en torno a la exposición para divertirse con los niños\nLos lunes a las 14.30 h. A partir de 6 años. Duración: 2h00. Precio: 3,50 euros por niño. Se recomienda reservar 03 21 10 02 20"
        ],
        "nl": [
          "Een ontdekkingsworkshop rond de tentoonstelling voor een leuke tijd met de kinderen!\nMaandag om 14.30 uur. Vanaf 6 jaar. Duur: 2u00. Prijs: €3,50 per kind. Reserveren aanbevolen 03 21 10 02 20"
        ]
      },
