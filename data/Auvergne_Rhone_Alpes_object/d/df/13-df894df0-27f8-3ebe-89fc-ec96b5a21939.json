  "rdfs:comment": {
    "de": [
      "Einzigartige Partylocation dank der beeindruckenden 600m² großen Terrasse unter freiem Himmel, auf der Sie in Skischuhen und mit einem Pint Bier in der Hand zu den größten Rock- und Pop-Hits tanzen und singen können."
    ],
    "en": [
      "A unique party venue with an impressive 600m² open-air terrace, where you can dance and sing in ski boots, with a pint of beer in hand, to the sounds of the greatest rock and pop hits."
    ],
    "it": [
      "Un luogo di festa unico, con un'impressionante terrazza all'aperto di 600 m² dove potrete ballare e cantare con gli scarponi da sci e una pinta di birra in mano al suono dei più grandi successi rock e pop."
    ],
    "fr": [
      "Lieu de fête unique en son genre grâce à son impressionnante terrasse de 600m² à ciel ouvert où vous pouvez danser et chanter en chaussures de ski une pinte de bière à la main au son des plus grands tubes de rock et de pop."
    ],
    "es": [
      "Un lugar de fiesta único con una impresionante terraza al aire libre de 600 m² donde podrás bailar y cantar con tus botas de esquí y una pinta de cerveza en la mano al son de los grandes éxitos del rock y el pop."
    ],
    "nl": [
      "Een unieke feestlocatie met een indrukwekkend openluchtterras van 600 m² waar je kunt dansen en zingen in je skischoenen met een pint bier in de hand op de klanken van de grootste rock- en pophits."
    ]
  },
  "rdfs:label": {
