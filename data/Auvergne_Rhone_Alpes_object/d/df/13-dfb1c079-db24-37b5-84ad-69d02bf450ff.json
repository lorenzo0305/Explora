  "rdfs:comment": {
    "de": [
      "Das Mas de Bérianne heißt Sie willkommen! Vor der Haustür der Provence, bei der Ausfahrt zur Autobahn A7 Montélimar Nord, begrüsst Sie unser Restaurant in ruhiger und gemütlicher Atmosphäre für eine frische Küche."
    ],
    "en": [
      "The Mas de Bérianne welcomes you! Situated on the doorstep of Provence, not far from the Montélimar Nord exit on the A7 motorway, our restaurant welcomes you in a warm and friendly atmosphere to savour cuisine based on fresh products."
    ],
    "it": [
      "Benvenuti al Mas de Bérianne! Situato alle porte della Provenza, appena fuori dall'autostrada A7 Montélimar Nord, il nostro ristorante vi accoglie in un'atmosfera accogliente e amichevole per gustare una cucina a base di prodotti freschi."
    ],
    "fr": [
      "Le Mas de Bérianne vous souhaite la bienvenue ! Situé aux portes de la Provence, à la sortie de l'autoroute A7 Montélimar Nord, notre restaurant vous accueille dans une ambiance feutrée et conviviale pour déguster une cuisine basée sur des produits frais."
    ],
    "es": [
      "¡Bienvenido al Mas de Bérianne! Situado a las puertas de la Provenza, justo al lado de la autopista A7 Montélimar Nord, nuestro restaurante le acoge en un ambiente acogedor y agradable para disfrutar de una cocina basada en productos frescos."
    ],
    "nl": [
      "De Mas de Bérianne heet u welkom! Aan de rand van de Provence, bij de afslag van de A7 richting Montélimar Nord heet ons restaurant u welkom in een gezellige sfeervolle setting voor het proeven van gerechten op basis van verse producten."
    ]
  },
