  "rdfs:comment": {
    "de": [
      "Bauernhof mit Gemüse- und Obstanbau vom Vater an die Tochter\r\n\r\nLandwirtschaft mit nachhaltigem Anbau und biologischem Kampf. Wir produzieren als Familie Obst und Gemüse und verkaufen es auf vier Märkten, im \"Primeur du Chantre\" und an Gastronomen in der Umgebung."
    ],
    "en": [
      "Farming vegetables and fruit from father to daughter\n\nWe grow our fruit and vegetables as a family and sell them at four markets, at Le Primeur du Chantre and to local restaurateurs."
    ],
    "it": [
      "Coltivazione di ortaggi e frutta da padre a figlia\r\n\r\nColtiviamo la nostra frutta e verdura come una famiglia e la vendiamo in quattro mercati, a Le Primeur du Chantre e ai ristoratori locali."
    ],
    "fr": [
      "Ferme en maraichage et arboriculture de père en fille\r\n\r\nAgriculture en culture raisonnée et lutte biologique, nous produisons des fruits et légumes en famille et les vendons sur quatre marchés, au Primeur du Chantre et à des restaurateurs du territoire."
    ],
    "nl": [
      "Groente- en fruitteelt van vader op dochter\n\nWe telen onze groenten en fruit als een familie en verkopen ze op vier markten, bij Le Primeur du Chantre en aan lokale restauranthouders."
    ],
    "es": [
      "Cultivo de hortalizas y frutas de padres a hijas\r\n\r\nCultivamos nuestras frutas y verduras en familia y las vendemos en cuatro mercados, en Le Primeur du Chantre y a los restauradores locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Belle"
    ]
  },
