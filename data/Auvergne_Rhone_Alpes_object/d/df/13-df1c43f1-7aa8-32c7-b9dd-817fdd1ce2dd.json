  "rdfs:comment": {
    "de": [
      "In Chaudeyrolles bietet die GAEC du Signon Label Rouge-Eier von Hühnern an, die im Freien gehalten werden. Direktverkauf ab Hof für Qualitätseier."
    ],
    "en": [
      "In Chaudeyrolles, GAEC du Signon offers Label Rouge eggs from free-range hens. Quality eggs sold direct from the farm."
    ],
    "it": [
      "A Chaudeyrolles, il GAEC du Signon offre uova Label Rouge da galline allevate a terra. Uova di qualità vendute direttamente dalla fattoria."
    ],
    "fr": [
      "À Chaudeyrolles, le GAEC du Signon propose des œufs Label Rouge issus de poules élevées en plein air. Vente directe à la ferme pour des œufs de qualité."
    ],
    "nl": [
      "In Chaudeyrolles biedt de GAEC du Signon Label Rouge eieren van kippen met vrije uitloop. Kwaliteitseieren die rechtstreeks van de boerderij worden verkocht."
    ],
    "es": [
      "En Chaudeyrolles, el GAEC du Signon propone huevos Label Rouge de gallinas criadas en libertad. Huevos de calidad vendidos directamente en la granja."
    ]
  },
