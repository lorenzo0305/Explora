  "rdfs:comment": {
    "de": [
      "Kunsthandwerk: Skulpturen aus Keramik.\r\nAnouck Valois bietet Ihnen die Möglichkeit, ihre Welt zu entdecken: ein realistisches oder imaginäres Bestiarium. Alle Skulpturen sind Einzelstücke aus Steingut und Porzellan."
    ],
    "en": [
      "Arts and crafts: ceramic sculptures. Anouck Valois invites you to discover her varied and intimate universe: realistic or imaginary bestiary, characters... All the sculptures are unique pieces made in stoneware and porcelain."
    ],
    "it": [
      "Arti e mestieri: sculture in ceramica.\r\nAnouck Valois vi invita a scoprire il suo mondo: un bestiario realistico o immaginario. Tutte le sculture sono pezzi unici realizzati in gres e porcellana."
    ],
    "fr": [
      "Artisanat d'art : sculptures en céramique.\r\nAnouck Valois vous propose de découvrir son univers : un bestiaire réaliste ou imaginaire. Toutes les sculptures sont des pièces uniques réalisées en grès et porcelaine."
    ],
    "es": [
      "Artesanía: esculturas de cerámica.\r\nAnouck Valois le invita a descubrir su mundo: un bestiario realista o imaginario. Todas las esculturas son piezas únicas realizadas en gres y porcelana."
    ],
    "nl": [
      "Ambachtelijke productie van objecten in keramiek: sculpturen, schalen, vazen..."
    ]
  },
  "rdfs:label": {
