  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/410640b7-d05d-371c-a245-7faebd3b4f8e",
      "dc:description": {
        "de": [
          "Picknickplatz befindet sich neben der Kirche und in der Nähe des grünen Weges von Ormoy-Villers nach Mareuil-sur-Ourcq. Verschiedene Ausstattungen: Picknicktische, Parkplatz und Mülleimer\n\nIn der Nähe: Einkaufsmöglichkeiten."
        ],
        "en": [
          "Picnic area located next to the church and close to the greenway from Ormoy-Villers to Mareuil-sur-Ourcq. Various equipment: picnic tables, parking and garbage cans\n\nNearby: shops."
        ],
        "it": [
          "Area pic-nic accanto alla chiesa e vicino alla greenway da Ormoy-Villers a Mareuil-sur-Ourcq. Varie strutture: tavoli da picnic, parcheggio e cestini\n\nNelle vicinanze: negozi."
        ],
        "fr": [
          "Aire de pique-nique se situant à côté de l'église et à proximité de la voie verte d'Ormoy-Villers à Mareuil-sur-Ourcq. Divers équipement :  tables de pique-nique, parking et poubelles. \n\nA proximité : commerces."
        ],
        "es": [
          "Área de picnic junto a la iglesia y cerca de la vía verde de Ormoy-Villers a Mareuil-sur-Ourcq. Varias instalaciones: mesas de picnic, aparcamiento y papeleras\n\nCerca: tiendas."
        ],
        "nl": [
          "Picknickplaats naast de kerk en bij de groene weg van Ormoy-Villers naar Mareuil-sur-Ourcq. Diverse voorzieningen: picknicktafels, parkeerplaats en vuilnisbakken\n\nIn de buurt: winkels."
        ]
      },
