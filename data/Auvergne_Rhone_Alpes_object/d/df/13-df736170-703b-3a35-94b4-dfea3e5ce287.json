  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum neben dem Tourismusbüro, Ausstellungsraum bestehend aus 3 Räumen von ca. 85 m2 mit Gewölbedecke. Kleiner Weinkeller. Detailliertes Programm auf der Website www.ville-tournon.com."
    ],
    "en": [
      "In the city center next to the Tourist Office, showroom consists of 3 areas of about 85 m2 vaulted. Detail program on the website: www.ville-tournon.com."
    ],
    "it": [
      "Nel centro città, accanto all'Ufficio del Turismo, una sala espositiva composta da 3 spazi di circa 85 m2 con soffitto a volta. Piccola cantina. Programma dettagliato sul sito www.ville-tournon.com."
    ],
    "fr": [
      "En centre ville à côté de l'Office de Tourisme, salle d'exposition composée de 3 espaces d'environ 85 m2 voutée. Petit caveau. Programme détaillé sur le site www.ville-tournon.com."
    ],
    "nl": [
      "In het stadscentrum naast het VVV-kantoor, expositieruimte bestaande uit 3 ruimtes van ongeveer 85 m2 met gewelfde plafonds. Kleine kelder. Gedetailleerd programma op www.ville-tournon.com."
    ],
    "es": [
      "En el centro de la ciudad, junto a la Oficina de Turismo, una sala de exposiciones que consta de 3 espacios de unos 85 m2 con techo abovedado. Pequeña bodega. Programa detallado en el sitio web www.ville-tournon.com."
    ]
  },
