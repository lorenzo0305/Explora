  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1fccfd11-bac2-3e47-b248-9b1620e22083",
      "dc:description": {
        "de": [
          "Gemeinsam feiern wir den Sommer!\nZahlreiche Veranstaltungen werden den Rhythmus der Woche von Noyelles en fête bestimmen, für alle Altersgruppen und alle Wünsche."
        ],
        "en": [
          "Celebrate summer together!\nThe Noyelles en fête week will be packed with events for all ages and tastes."
        ],
        "it": [
          "Festeggiamo insieme l'estate!\nLa settimana di Noyelles en fête sarà ricca di eventi per tutte le età e per tutti i gusti."
        ],
        "fr": [
          "Ensemble fêtons l'été ! \nDe nombreux événements rythmeront la semaine de Noyelles en fête, pour tous les âges et toutes les envies."
        ],
        "nl": [
          "Samen de zomer vieren!\nDe Noyelles en fête-week zit boordevol evenementen voor alle leeftijden en smaken."
        ],
        "es": [
          "Celebrar juntos el verano\nLa semana Noyelles en fête estará repleta de eventos para todas las edades y gustos."
        ]
      },
