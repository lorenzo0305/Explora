  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in einer neuen, völlig überarbeiteten Welt. Speisekarte mit Gerichten und Weinen aus der Region. Auf Fisch spezialisiertes Restaurant. Erstaunliche und überraschende kulinarische Zubereitungen, die Frische, Qualität und Herkunft der Produkte garantieren."
    ],
    "en": [
      "We welcome you in a new universe, totally revisited. Restaurant specialize in fish, guadranterr fresh quality and origin of the product."
    ],
    "it": [
      "Vi diamo il benvenuto in un nuovo universo, totalmente rivisitato. Menu enogastronomico locale. Ristorante specializzato in pesce. Preparazioni culinarie sorprendenti e sorprendenti, che garantiscono la freschezza, la qualità e l'origine dei prodotti."
    ],
    "fr": [
      "Nous vous accueillons dans un nouvel univers, totalement revisité. Carte de mets et de vins du terroir. Restaurant spécialisé en poissons. Préparations culinaires étonnantes et surprenantes, garantissant fraîcheur, qualité et origine des produits."
    ],
    "nl": [
      "We heten je welkom in een nieuwe, totaal vernieuwde wereld. Lokaal eten en wijnmenu. Restaurant gespecialiseerd in vis. Verrassende culinaire bereidingen, met garantie voor de versheid, kwaliteit en herkomst van de producten."
    ],
    "es": [
      "Le damos la bienvenida a un nuevo universo, totalmente revisado. Carta de alimentos y vinos locales. Restaurante especializado en pescado. Preparaciones culinarias sorprendentes, garantizando la frescura, la calidad y el origen de los productos."
    ]
  },
  "rdfs:label": {
    "en": [
      "La table du grand lac"
    ],
    "fr": [
      "La table du grand lac"
    ],
    "nl": [
      "De tafel van het grote meer"
    ]
  },
