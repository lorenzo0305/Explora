  "rdfs:comment": {
    "de": [
      "Der Voice verte des Tattes ist ein Fuß- und Radweg, der Prévessin-Moëns mit Ornex verbindet und eine sichere Route für die sanfte Mobilität bietet."
    ],
    "en": [
      "The voie verte des Tattes is a pedestrian and cycle path linking Prévessin-Moëns to Ornex, offering a safe route for soft mobility."
    ],
    "it": [
      "La greenway di Tattes è un percorso pedonale e ciclabile che collega Prévessin-Moëns a Ornex, offrendo un percorso sicuro per la mobilità dolce."
    ],
    "fr": [
      "La voie verte des Tattes est une piste piétonne et cyclable qui relie Prévessin-Moëns à Ornex, offrant un itinéraire sécurisé pour les mobilités douces."
    ],
    "es": [
      "La vía verde de Tattes es una senda peatonal y ciclista que une Prévessin-Moëns con Ornex y ofrece un itinerario seguro para la movilidad suave."
    ],
    "nl": [
      "De Tattes greenway is een voetgangers- en fietspad dat Prévessin-Moëns met Ornex verbindt en een veilige route biedt voor zachte mobiliteit."
