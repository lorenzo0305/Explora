  "rdfs:comment": {
    "de": [
      "Ob Sie nun kultur-, geschichts-, architektur-, kunst- oder sogar liebesverrückt sind, machen Sie sich auf, um dieses in Frankreich einzigartige Bauwerk zu entdecken! Ein Ort, der vor fünf Jahrhunderten aus der Liebe einer außergewöhnlichen Frau, Margarete von Österreich, zu ihrem verstorbenen Ehemann entstand."
    ],
    "en": [
      "Whether you're mad about culture, history, architecture, art or even love, discover this unique monument in France! Born 5 centuries ago from the love of an exceptional woman, Marguerite of Austria, for her late husband."
    ],
    "it": [
      "Se siete amanti della cultura, della storia, dell'architettura, dell'arte o anche dell'amore, venite a scoprire questo monumento unico in Francia! Nato 5 secoli fa dall'amore di una donna eccezionale, Margherita d'Austria, per il suo defunto marito."
    ],
    "fr": [
      "Que vous soyez fous de culture, d’histoire, d’architecture, d’art ou même d’amour, partez à la découverte de ce monument unique en France ! Un lieu né il y a 5 siècles de l’amour d’une femme exceptionnelle, Marguerite d’Autriche, pour son défunt mari."
    ],
    "es": [
      "Si le apasiona la cultura, la historia, la arquitectura, el arte o incluso el amor, vaya a descubrir este monumento único en Francia Un lugar nacido hace 5 siglos del amor de una mujer excepcional, Margarita de Austria, por su difunto marido."
    ],
    "nl": [
      "Of je nu een passie hebt voor cultuur, geschiedenis, architectuur, kunst of zelfs liefde, kom en ontdek dit unieke monument in Frankrijk! 5 eeuwen geleden ontstaan uit de liefde van een uitzonderlijke vrouw, Marguerite van Oostenrijk, voor haar overleden echtgenoot."
    ]
  },
