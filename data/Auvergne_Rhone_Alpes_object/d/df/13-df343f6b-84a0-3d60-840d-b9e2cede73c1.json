  "rdfs:comment": {
    "de": [
      "Im Herzen des Skigebiets Grand Domaine zwischen Saint François Longchamp und Valmorel oder auf dem legendären Col de la Madeleine gelegen, empfängt Sie La Banquise 2000 jeden Tag."
    ],
    "en": [
      "At the very heart of the ski area Le Grand Domaine, between Saint François Longchamp and Valmorel, and at the legendary Col de la Madeleine, the restaurant La Banquise 2000 welcomes you every day."
    ],
    "it": [
      "Nel cuore del comprensorio sciistico del Grand Domaine, tra Saint François Longchamp e Valmorel, o sul mitico Col de la Madeleine, Banquise 2000 vi accoglie ogni giorno."
    ],
    "fr": [
      "Au cœur du domaine skiable du Grand Domaine entre Saint François Longchamp et Valmorel, ou situé sur le mythique Col de la Madeleine, la Banquise 2000 vous accueille tous les jours."
    ],
    "nl": [
      "Gelegen in het hartje van het skigebied Grand Domaine tussen Saint François Longchamp en Valmorel, of tijdens de zomer op de mythische Col de la Madeleine, la Banquise 2000 is dagelijks voor u geopend."
    ],
    "es": [
      "En el corazón del dominio esquiable del Grand Domaine, entre Saint François Longchamp y Valmorel, o situado en el mítico Col de la Madeleine, Banquise 2000 le da la bienvenida todos los días."
    ]
  },
