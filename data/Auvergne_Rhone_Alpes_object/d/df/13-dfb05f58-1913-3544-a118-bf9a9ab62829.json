  "rdfs:comment": {
    "de": [
      "Im Herzen von Saint Colomban des Villards empfängt Sie die Auberge du Coin das ganze Jahr über auf Reservierung in einer herzlichen und geselligen Atmosphäre."
    ],
    "en": [
      "In the heart of Saint Colomban des Villards, the Auberge du Coin welcomes you all year round by reservation in a warm and friendly atmosphere."
    ],
    "it": [
      "Nel cuore di Saint Colomban des Villards, l'Auberge du Coin vi accoglie tutto l'anno, su prenotazione, in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Au cœur de Saint Colomban des Villards, l’Auberge du Coin vous accueille toute l’année sur réservation dans une ambiance chaleureuse et conviviale."
    ],
    "nl": [
      "In het hart van Saint Colomban des Villards ontvangt de Auberge du Coin je het hele jaar door op afspraak in een warme en vriendelijke sfeer."
    ],
    "es": [
      "En el corazón de Saint Colomban des Villards, el Auberge du Coin le da la bienvenida todo el año, previo acuerdo, en un ambiente cálido y acogedor."
    ]
  },
