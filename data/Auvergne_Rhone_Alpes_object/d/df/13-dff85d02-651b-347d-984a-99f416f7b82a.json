  "rdfs:comment": {
    "de": [
      "Elisabeth und Bernard Perrot sind Gemüsebauern in der fünften Generation und widmen ihr Leben seit 37 Jahren der umweltfreundlichen Produktion von authentischem Obst und Gemüse."
    ],
    "en": [
      "Market gardeners for 5 generations, Elisabeth and Bernard Perrot have devoted their lives for 37 years to producing authentic fruit and vegetables in an environmentally-friendly way."
    ],
    "it": [
      "Giardinieri da 5 generazioni, Elisabeth e Bernard Perrot hanno dedicato la loro vita per 37 anni alla produzione di frutta e verdura autentica nel rispetto dell'ambiente."
    ],
    "fr": [
      "Maraîchers depuis 5 générations, Elisabeth et Bernard Perrot consacrent leur vie depuis 37 ans à produire dans le respect de l'environnement des fruits et des légumes authentiques."
    ],
    "es": [
      "Horticultores desde hace 5 generaciones, Elisabeth y Bernard Perrot llevan 37 años dedicados a la producción de frutas y hortalizas auténticas y respetuosas con el medio ambiente."
    ],
    "nl": [
      "Elisabeth en Bernard Perrot, tuinders sinds 5 generaties, wijden hun leven al 37 jaar aan het produceren van authentieke groenten en fruit op een milieuvriendelijke manier."
    ]
  },
