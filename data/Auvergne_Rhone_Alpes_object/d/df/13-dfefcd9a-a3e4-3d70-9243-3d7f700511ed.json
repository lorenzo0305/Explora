  "rdfs:comment": {
    "de": [
      "Nicolas empfängt Sie im Herzen seines Familienbetriebs. Er ist Walnussproduzent in Saint-Romans. Auf dem 11 Hektar großen Betrieb mit Walnussbäumen wird ein seit vier Generationen überliefertes Know-how gepflegt."
    ],
    "en": [
      "Nicolas welcomes you to the heart of his family business. A walnut producer in Saint-Romans, this 11-hectare walnut farm perpetuates a know-how handed down through four generations."
    ],
    "it": [
      "Nicolas vi dà il benvenuto nel cuore dell'azienda di famiglia. Coltivatore di noci a Saint-Romans, questa azienda di 11 ettari continua una tradizione tramandata da quattro generazioni."
    ],
    "fr": [
      "Nicolas vous accueille au cœur de son exploitation familiale. Producteur de noix à Saint-Romans, cette exploitation de 11 hectares de noyers perpétue un savoir-faire transmis depuis quatre générations."
    ],
    "es": [
      "Nicolas le da la bienvenida al corazón de su empresa familiar. Cultivador de nogales en Saint-Romans, esta explotación de nogales de 11 hectáreas continúa una tradición transmitida a lo largo de cuatro generaciones."
    ],
    "nl": [
      "Nicolas heet je welkom in het hart van zijn familiebedrijf. Deze notenboerderij van 11 hectare in Saint-Romans zet een traditie voort die al vier generaties lang wordt doorgegeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de Férie NICONOIX"
    ]
  },
