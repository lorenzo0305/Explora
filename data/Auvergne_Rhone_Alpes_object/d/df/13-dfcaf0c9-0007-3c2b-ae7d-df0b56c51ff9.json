  "rdfs:comment": {
    "de": [
      "Valmeinier ist eine Gemeinde in einem Mittelgebirge im Herzen des Maurienne-Tals. Valmeinier und seine zahlreichen Weiler werden das ganze Jahr über von einer Gemeindebevölkerung von 525 Einwohnern bewohnt."
    ],
    "en": [
      "Valmeinier is a mid-mountain commune in the heart of the Maurienne valley. Valmeinier and its many hamlets are inhabited year-round by a municipal population of 525."
    ],
    "it": [
      "Valmeinier è un villaggio di montagna di medie dimensioni nel cuore della valle della Maurienne. Valmeinier e le sue numerose frazioni sono abitate tutto l'anno da una popolazione comunale di 525 abitanti."
    ],
    "fr": [
      "Valmeinier est une commune de moyenne montagne située au cœur de la vallée de la Maurienne. Valmeinier et ses nombreux hameaux sont habités à l’année par une population municipale de 525 habitants."
    ],
    "nl": [
      "Valmeinier is een middelgroot bergdorp in het hart van de Maurienne-vallei. Valmeinier en zijn vele gehuchten worden het hele jaar door bewoond door 525 inwoners."
    ],
    "es": [
      "Valmeinier es un municipio de montaña de tamaño medio situado en el corazón del valle de la Maurienne. Valmeinier y sus numerosas aldeas están habitadas todo el año por una población municipal de 525 habitantes."
    ]
  },
