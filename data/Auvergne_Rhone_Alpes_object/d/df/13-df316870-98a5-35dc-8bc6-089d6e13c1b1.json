  "rdfs:comment": {
    "de": [
      "Julie bietet Ihnen Restaurants, Snacks, einen Lebensmittelladen und eine Brotverkaufsstelle. Bar- Restaurant - Lebensmittelgeschäft in einem atypischen Ort unter dem Zeichen des Wohlwollens und des Teilens."
    ],
    "en": [
      "Julie offers catering, snacking, a grocery store, a bread store, openings,etc ...\r\nBar-Restaurant - Local grocery store in an atypical place under the sign of benevolence and sharing."
    ],
    "it": [
      "Julie offre ristoranti, snack bar, un negozio di alimentari e un deposito di pane. Un bar-ristorante-gastronomia locale in un ambiente atipico dove vi sentirete accolti e incoraggiati a condividere."
    ],
    "fr": [
      "Julie vous propose de la restauration, du snacking, une épicerie, un dépôt de pain. Bar- Restaurant - Épicerie de proximité dans un lieu atypique sous le signe de la bienveillance et du partage."
    ],
    "es": [
      "Julie ofrece restaurantes, bares, una tienda de comestibles y un depósito de pan. Un bar-restaurante-tienda de comestibles local en un entorno atípico donde te sentirás bienvenido y animado a compartir."
    ],
    "nl": [
      "Julie biedt restaurants, snackbars, een kruidenierswinkel en een brooddepot. Een lokale bar-restaurant-kruidenierswinkel in een atypische omgeving waar je je welkom voelt en aangemoedigd wordt om te delen."
    ]
  },
