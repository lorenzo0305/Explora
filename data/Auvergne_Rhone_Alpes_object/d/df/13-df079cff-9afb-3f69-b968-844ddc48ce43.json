  "rdfs:comment": {
    "de": [
      "Geschichten vom König, von Kindern, absurde Geschichten, von Reisen und Begegnungen... gemischt mit Drahtseilen, Messerwerfen, Glaslaufen, halsbrecherischen Hebefiguren..."
    ],
    "en": [
      "Stories of kings, children, absurd stories, travels and encounters... mixed with wire, knife throwing, glass walking, acrobatic lifts..."
    ],
    "it": [
      "Storie di re, di bambini, storie assurde, viaggi e incontri... mescolate a fili, lanci di coltelli, camminate sul vetro, ascensori acrobatici..."
    ],
    "fr": [
      "Histoires de roi, d'enfants, histoires absurdes, de voyages et de rencontres... mêlées au fil de fer, lancé de couteaux, marche sur le verre, portés accrobatiques..."
    ],
    "nl": [
      "Verhalen over koningen, kinderen, absurde verhalen, reizen en ontmoetingen... vermengd met draad, messenwerpen, lopen over glas, acrobatische liften..."
    ],
    "es": [
      "Historias de reyes, niños, historias absurdas, viajes y encuentros... mezclados con alambre, lanzamiento de cuchillos, caminar sobre cristales, elevaciones acrobáticas..."
    ]
  },
