  "rdfs:comment": {
    "de": [
      "Riesiges Diktat : Anlässlich des 400. Geburtstages von Madame de Sévigné findet in der Mediathek ein Riesendiktat statt, eine Übertragung des Diktats, das am Vortag im Schloss von Grignan stattgefunden hat."
    ],
    "en": [
      "Giant dictation: To mark the 400th anniversary of the birth of Madame de Sévigné, the mediatheque will be hosting a giant dictation, a retransmission of the dictation that took place the day before at the Château de Grignan."
    ],
    "it": [
      "Dettatura gigante: In occasione del 400° anniversario della nascita di Madame de Sévigné, la mediateca ospiterà una dettatura gigante, una ritrasmissione della dettatura avvenuta il giorno prima al Castello di Grignan."
    ],
    "fr": [
      "Dictée géante : À l’occasion du 400e anniversaire de la naissance de Madame de Sévigné, la médiathèque vous accueillera pour une dictée géante, retransmission de la dictée qui se sera déroulée la veille au château de Grignan."
    ],
    "nl": [
      "Reuzendictee: Ter gelegenheid van de 400e geboortedag van Madame de Sévigné organiseert de mediatheek een reuzendictee, een heruitzending van het dictee dat de dag ervoor plaatsvond in het Château de Grignan."
    ],
    "es": [
      "Dictado gigante: Con motivo del 400 aniversario del nacimiento de Madame de Sévigné, la mediateca acogerá un dictado gigante, retransmisión del dictado que tuvo lugar la víspera en el castillo de Grignan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dictée géante à la Médiathèque Départementale"
    ]
  },
