  "rdfs:comment": {
    "de": [
      "Das Hotel liegt ideal am Ausgangspunkt der Sessellifte von Pré la Joux, Pierre Longue und seinen Skiliften und ist leicht zu erreichen. Das 3-Sterne-Hotel mit 10 Zimmern liegt mitten im Herzen der Portes du Soleil."
    ],
    "en": [
      "The Perdrix Blanche hotel is ideally located at the departure of Pré la Joux, Pierre-Longue chairlifts and  skilifts. 3 stars hotel with 10 bedrooms in the heart of the Portes du Soleil."
    ],
    "it": [
      "Situato in posizione ideale alla partenza delle seggiovie Pré la Joux e Pierre Longue, l'hotel è facilmente raggiungibile. Hotel 3 stelle con 10 camere, nel cuore delle Portes du Soleil."
    ],
    "fr": [
      "Idéalement situé au départ des télésièges de Pré la Joux, de Pierre Longue et ses téléskis,l'hôtel bénéficie d'une grande facilité d'accès. Hôtel 3 étoiles de 10 chambres, plein cœur des Portes du Soleil."
    ],
    "es": [
      "Idealmente situado al inicio de los telesillas Pré la Joux y Pierre Longue, el hotel es fácilmente accesible. Hotel de 3 estrellas con 10 habitaciones, en el corazón de Portes du Soleil."
    ],
    "nl": [
      "Het hotel heeft een ideale ligging aan het vertrekpunt van de stoeltjesliften Pré la Joux en Pierre Longue. 3-sterrenhotel met 10 kamers, in het hart van de Portes du Soleil."
    ]
  },
