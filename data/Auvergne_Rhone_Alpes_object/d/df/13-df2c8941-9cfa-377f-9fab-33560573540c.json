  "rdfs:comment": {
    "de": [
      "Das Hotel Le Centre liegt im Dorf Brides-les-Bains in der Nähe des größten Skigebiets der Welt, Les Trois Vallées."
    ],
    "ru": [
      "Отель Le Centre находится в деревне Брид-ле-Бен рядом с самой большим в мире горнолыжным курортом «Три долины»."
    ],
    "en": [
      "Le Centre is located in the village of Brides-les-Bains, close to the largest ski area in the world, Les 3 Vallées."
    ],
    "it": [
      "Il Centro si trova nel villaggio di Brides-les-Bains, vicino al comprensorio sciistico più grande del mondo, Les 3 Vallées."
    ],
    "fr": [
      "Le Centre est situé dans le village de Brides-les-Bains, à proximité du plus grand domaine skiable du monde, les 3 Vallées."
    ],
