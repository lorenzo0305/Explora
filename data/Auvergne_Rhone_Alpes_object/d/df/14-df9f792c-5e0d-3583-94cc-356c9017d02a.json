  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/840847a5-562e-370a-afa0-3b5957ff1f0b",
      "dc:description": {
        "de": [
          "Ideale Lage im Stadtzentrum in der Fußgängerzone, 2 Schritte vom Theater entfernt, Sonnenterrasse. Schneller Service und herzlicher Empfang. Hausgemachte Küche."
        ],
        "en": [
          "Ideally located in the heart of the city in the pedestrian street, 2 steps from the theatre, sunny terrace. Fast service and warm welcome . Home made kitchen."
        ],
        "it": [
          "In posizione ideale nel cuore della città, nella via pedonale, a 2 passi dal teatro, terrazza soleggiata. Servizio veloce e accoglienza calorosa. Cibo fatto in casa."
        ],
        "fr": [
          "Idéalement placé en cœur de ville dans la rue piétonne à 2 pas du théâtre, terrasse ensoleillée. Service rapide et accueille chaleureux . Cuisine faite maison."
        ],
        "es": [
          "Idealmente situado en el corazón de la ciudad en la calle peatonal, a 2 pasos del teatro, terraza soleada. Servicio rápido y cálida acogida. Comida casera."
        ],
        "nl": [
          "Ideaal gelegen in het hart van de stad in de voetgangersstraat, op 2 stappen van het theater, zonnig terras. Snelle service en warme ontvangst. Zelfgemaakt voedsel."
        ]
      },
