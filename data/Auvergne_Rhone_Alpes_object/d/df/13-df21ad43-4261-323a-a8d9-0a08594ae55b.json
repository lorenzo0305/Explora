  "rdfs:comment": {
    "de": [
      "Favela Val Thorens, das ist lateinamerikanisches Streetfood, Signature-Cocktails und ausgelassene Stimmung auf 2300 m Höhe! Tacos, Burritos, Empanadas? alles, was das Herz begehrt, bevor es zum Feiern geht."
    ],
    "en": [
      "Favela Val Thorens is all about Latino street food, signature cocktails and a supercharged atmosphere at 2300 m! Tacos, burritos, empanadas... everything you need to feast before partying."
    ],
    "it": [
      "Il Favela Val Thorens è tutto cibo di strada latino-americano, cocktail d'autore e un'atmosfera super carica a 2300 m! Tacos, burritos, empanadas... tutto ciò che serve per rifocillarsi prima di festeggiare."
    ],
    "fr": [
      "Favela Val Thorens, c’est street food latino, cocktails signature et ambiance survoltée à 2300 m ! Tacos, burritos, empanadas… tout pour se régaler avant de faire la fête."
    ],
    "es": [
      "Favela Val Thorens es todo comida callejera latina, cócteles de autor y un ambiente sobrealimentado a 2300 m de altitud. Tacos, burritos, empanadas... todo lo necesario para darse un festín antes de salir de fiesta."
    ],
    "nl": [
      "Bij Favela Val Thorens draait alles om Latino street food, cocktails en een supercharged sfeer op 2300 m! Taco's, burrito's, empanadas... alles wat je nodig hebt om jezelf te verwennen voor het feest."
    ]
  },
