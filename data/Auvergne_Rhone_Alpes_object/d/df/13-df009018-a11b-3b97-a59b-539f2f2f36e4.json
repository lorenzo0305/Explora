  "rdfs:comment": {
    "de": [
      "Seit 2021 entwickelt das Théâtre de Cusset ein innovatives Kreationsprojekt, das jede Saison ein künstlerisches Team einlädt, an der Seite der Einwohner in den Ort und sein Gebiet zu investieren."
    ],
    "en": [
      "Since 2021, the Théâtre de Cusset has been developing an innovative creative project, inviting an artistic team each season to invest the venue and its territory alongside local residents."
    ],
    "it": [
      "Dal 2021, il Théâtre de Cusset sviluppa un progetto creativo innovativo, invitando ogni stagione un'équipe artistica a investire nello spazio e nel territorio insieme ai residenti locali."
    ],
    "fr": [
      "Depuis 2021, le Théâtre de Cusset développe un projet de création innovant, invitant chaque saison une équipe artistique à investir le lieu et son territoire aux côtés des habitants."
    ],
    "nl": [
      "Sinds 2021 ontwikkelt het Théâtre de Cusset een innovatief creatief project, waarbij elk seizoen een artistiek team wordt uitgenodigd om samen met de buurtbewoners te investeren in de locatie en het grondgebied."
    ],
    "es": [
      "Desde 2021, el Théâtre de Cusset desarrolla un proyecto creativo innovador, invitando cada temporada a un equipo artístico a invertir en el lugar y su territorio junto a los residentes locales."
    ]
  },
  "rdfs:label": {
