  "rdfs:comment": {
    "de": [
      "Anne-Sophie Pic hat im April 2016 ihr neues Restaurant „ANDRE\" Histoire(s) de Cuisine eröffnet, als Hommage an die Familiendynastie mit den legendären Gerichten ihres Vaters, Großvaters und ihrer Urgroßmutter."
    ],
    "en": [
      "André is a historic establishment with a story to tell. It is the story of a culinary adventure that four generations of very talented chefs have embarked upon over the years, an establishment that acts as an outlet for their vision of the world, by showcasing their generous and down-to-earth cuisine."
    ],
    "it": [
      "In un'atmosfera calda e accogliente, il Bistrot André prosegue con autenticità lo spirito della Maison Pic."
    ],
    "fr": [
      "Dans une ambiance chaleureuse et conviviale, le Bistrot André prolonge l’esprit de la Maison Pic avec authenticité."
    ],
    "es": [
      "En un ambiente cálido y acogedor, el Bistrot André continúa con autenticidad el espíritu de la Maison Pic."
    ],
    "nl": [
      "André is een plek van geschiedenis en verhalen... De culinaire geschiedenis van vier generaties koks die hun stempel op hun tijd hebben gedrukt en hun visie op de wereld met grote vrijgevigheid en terughoudendheid hebben gedeeld."
    ]
  },
  "rdfs:label": {
    "en": [
      "André - The Maison Pic bistro"
    ],
    "fr": [
      "André - Le bistrot de la Maison Pic"
    ]
  },
