      "@id": "https://data.datatourisme.fr/dba4cd86-3c7f-3701-95d1-8c312f7ccfaa",
      "dc:description": {
        "de": [
          "Erdbeeren, Fruchtsäfte vom Bauernhof, Limousin-Fleisch. Verkauf im Laden vert de terre und am Automaten in Wirwignes."
        ],
        "en": [
          "Strawberries, farm juices, Limousin meat. Sales at the vert de terre store and vending machine in Wirwignes."
        ],
        "it": [
          "Fragole, succo di frutta di fattoria, carne del Limousin. Disponibile presso il negozio vert de terre e il distributore automatico di Wirwignes."
        ],
        "fr": [
          "Fraises, jus de fruits de la ferme, viande limousine. Vente au magasin vert de terre et au distributeur automatique à Wirwignes."
        ],
        "es": [
          "Fresas, zumo de frutas de granja, carne de Limousin. Disponibles en la tienda vert de terre y en la máquina expendedora de Wirwignes."
        ],
        "nl": [
          "Aardbeien, vruchtensap van de boerderij, vlees van de Limousin. Verkrijgbaar in de winkel vert de terre en de automaat in Wirwignes."
        ]
      },
