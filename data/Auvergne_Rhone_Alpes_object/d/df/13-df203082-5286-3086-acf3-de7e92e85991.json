  "rdfs:comment": {
    "de": [
      "Stadt Langeac: Stiftskirche aus dem 15. Jahrhundert, Grablegung aus polychromem Holz aus dem 15. Jahrhundert, Chorgestühl aus dem 16. Kloster Sainte-Catherine mit Kapelle und Schrein der Seligen Mutter Agnes."
    ],
    "en": [
      "Ville de Langeac: 15th-century collegiate church, 15th-century polychrome wooden tomb, 16th-century stalls. Sainte-Catherine monastery with chapel and shrine of Blessed Mother Agnès."
    ],
    "it": [
      "Langeac: chiesa collegiata del XV secolo, tomba in legno policromo del XV secolo, stalli del coro del XVI secolo. Monastero di Sainte-Catherine con cappella e santuario della Beata Madre Agnés."
    ],
    "fr": [
      "Ville de Langeac : Collégiale du XVe siècle, mise au tombeau en bois polychrome du XVe siècle, stalles du XVIe siècle. Monastère Sainte-Catherine avec chapelle et châsse de la Bienheureuse Mère Agnès."
    ],
    "nl": [
      "Langeac: kapittelkerk uit de 15e eeuw, polychroom houten grafmonument uit de 15e eeuw, koorgestoelte uit de 16e eeuw. Klooster Sainte-Catherine met kapel en schrijn van de Heilige Moeder Agnès."
    ],
    "es": [
      "Langeac: colegiata del siglo XV, sepulcro de madera policromada del siglo XV, sillería del coro del siglo XVI. Monasterio Sainte-Catherine con capilla y santuario de la Beata Madre Agnès."
    ]
  },
