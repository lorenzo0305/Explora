  "rdfs:comment": {
    "de": [
      "Bar-Restaurant am Ufer der Saône auf dem Treidelpfad, am unteren Hafen.\r\nDie Chefin kocht hausgemachte Gerichte, eine kreative Speisekarte, frische Frösche und Pommes frites in der Saison, Crêpes, Eis, Cocktails.\r\nPrivatisierung möglich"
    ],
    "en": [
      "\"La Maison Bleue is a restaurant and bar located near the River Saône's docks and towpath. The chef serves up creative fare as well as the traditional frogs' legs and fried bleak (small freshwater fish) typical of any restaurant located along the Saône."
    ],
    "it": [
      "Bar ristorante situato sulle rive della Saona, sull'alzaia in fondo al porto.\r\nCucina casalinga dello chef, menu creativo, rane fresche e patatine fritte in stagione. Crepes, gelati, cocktail.\r\nPossibilità di privatizzazione"
    ],
    "fr": [
      "Bar restaurant situé en bord de Saône sur le chemin de halage , bas port .\r\nLa cheffe cuisine maison , carte créative ,grenouilles fraîches et fritures en saison .crèpes, glaces , cocktails. \r\nPrivatisation possible"
    ],
    "es": [
      "Bar restaurante situado a orillas del Saona, en el camino de sirga del fondo del puerto.\r\nCocina casera del chef, menú creativo, ranas frescas y patatas fritas en temporada. Crepes, helados, cócteles.\r\nPrivatización posible"
    ],
    "nl": [
      "Bar restaurant gelegen aan de oevers van de Saône op het jaagpad onderaan de haven.\r\nHuisgemaakte keuken van de chef, creatief menu, verse kikkers en frietjes in het seizoen. Crêpes, ijsjes, cocktails.\r\nPrivatisering mogelijk"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Bar : La Maison Bleue"
    ]
  },
