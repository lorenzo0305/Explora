  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf handgemachte Kekse , Kuchen für ein Essen, einen Geburtstag, eine Party oder einen Snack?\r\nLa Boîte à Gâteaux stellt auf Anfrage Ihre handgefertigten Kekse her! Brownies, Macarons, Canistrelli, Cakes ... entdecken Sie auch bei Grain de Luce"
    ],
    "en": [
      "Looking for artisanal cookies and cakes for a meal, a birthday, a party or a tea party?\r\nLa Boîte à Gâteaux makes your own handcrafted cookies on request! Brownies, Macarons, Canistrelli, Cakes... also available from Grain de Luce"
    ],
    "it": [
      "Desiderate biscotti o torte artigianali per un pranzo, un compleanno, una serata o un tè?\r\nLa Boîte à Gâteaux prepara i vostri biscotti artigianali su richiesta! Brownies, Macaron, Canistrelli, Torte... disponibili anche da Grain de Luce"
    ],
    "fr": [
      "Une envie de biscuits artisanaux , de gâteaux pour un repas, un anniversaire, une soirée, un goûter ?\r\nLa Boîte à Gâteaux fabrique sur demande vos biscuits artisanaux ! Brownies, Macarons, Canistrelli, Cakes... à découvrir aussi chez Grain de Luce"
    ],
    "es": [
      "¿Desea galletas o pasteles artesanales para una comida, un cumpleaños, una velada o una merienda?\r\nLa Boîte à Gâteaux elabora sus propias galletas artesanales por encargo Brownies, Macarrones, Canistrelli, Tartas... también disponibles en Grain de Luce"
    ],
    "nl": [
      "Wil je ambachtelijke koekjes of taarten voor een maaltijd, een verjaardag, een avond of een theekransje?\r\nLa Boîte à Gâteaux maakt je eigen handgemaakte koekjes op aanvraag! Brownies, Macarons, Canistrelli, Taarten... ook verkrijgbaar bij Grain de Luce"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La boîte à gâteaux"
    ]
  },
