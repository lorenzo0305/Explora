  "rdfs:comment": {
    "de": [
      "Japanisches Restaurant, das sich auf Sushi spezialisiert hat.\r\nDas gute Produkt und die Frische sind die Trümpfe, die Ihren Genuss garantieren.\r\nRamen jeden Mittwoch im Winter. Pokebowl im Sommer."
    ],
    "en": [
      "Japanese restaurant specializing in sushi.\r\nThe right product and freshness are the assets that guarantee your pleasure.\r\nRamen every Wednesday."
    ],
    "it": [
      "Ristorante giapponese specializzato in sushi.\r\nProdotti buoni e freschezza sono le chiavi del vostro divertimento.\r\nRamen ogni mercoledì in inverno. Pokebowl in estate."
    ],
    "fr": [
      "Restaurant japonais spécialisé dans les sushis.\r\nLe bon produit et la fraîcheur sont les atouts qui garantissent votre plaisir.\r\nRamen tous les mercredis en hiver. Pokebowl en été."
    ],
    "es": [
      "Restaurante japonés especializado en sushi.\r\nEl buen producto y la frescura son las claves de su disfrute.\r\nRamen todos los miércoles en invierno. Pokebowl en verano."
    ],
    "nl": [
      "Japans restaurant gespecialiseerd in sushi.\r\nGoede producten en versheid zijn de sleutels tot uw plezier.\r\nRamen elke woensdag in de winter. Pokebowl in de zomer."
    ]
  },
