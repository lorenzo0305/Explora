  "rdfs:comment": {
    "de": [
      "Rose Desmaisons fertigt Kreationen aus emaillierter Lava der Volcans d'Auvergne an. Das Rohe der Lava und das Kostbare der Emails vermischen sich bei hohen Temperaturen. Die Magie wirkt und bietet ein unveränderliches Material."
    ],
    "en": [
      "Rose Desmaisons creates enameled lava from the Auvergne Volcanoes. The roughness of the lava and the preciousness of the enamels blend together in a high-temperature fusion. The magic happens, creating an inalterable material."
    ],
    "it": [
      "Rose Desmaisons crea lava smaltata dai vulcani dell'Alvernia. La ruvidità della lava e la preziosità degli smalti si mescolano durante la fusione ad alta temperatura. La magia avviene, offrendo un materiale inalterabile."
    ],
    "fr": [
      "Rose Desmaisons réalise des créations en lave émaillée des Volcans d'Auvergne. Le brut de la lave et le précieux des émaux se mélangent lors d'une fusion haute température. La magie opère offrant un matériau inaltérable."
    ],
    "es": [
      "Rose Desmaisons crea lava esmaltada a partir de los volcanes de Auvernia. La rugosidad de la lava y la preciosidad de los esmaltes se mezclan durante una fusión a alta temperatura. La magia se produce, ofreciendo un material inalterable."
    ],
    "nl": [
      "Rose Desmaisons creëert geëmailleerde lava uit de vulkanen van de Auvergne. De ruwheid van de lava en de kostbaarheid van het glazuur worden vermengd tijdens een fusie bij hoge temperatuur. De magie gebeurt, met een onveranderlijk materiaal."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pépite de Lave - Lave émaillée"
    ],
    "fr": [
      "Pépite de Lave - Lave émaillée"
    ]
  },
