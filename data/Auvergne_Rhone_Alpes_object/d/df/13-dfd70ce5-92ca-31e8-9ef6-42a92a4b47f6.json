  "rdfs:comment": {
    "de": [
      "Gemeinnütziger Verein, der vom französischen Institut für Tiertherapie als Aufnahmezentrum ausgezeichnet wurde.\r\nPädagogischer Bauernhof für eine spezialisierte Betreuung, Tiervermittlung, um auf angepasste Weise die jüngsten und ältesten Personen zu empfangen."
    ],
    "en": [
      "Non-profit organization accredited as a reception center by the French institute of zootherapy.\r\nEducational farm for specialized care, animal mediation to welcome the youngest to the oldest."
    ],
    "it": [
      "Associazione senza scopo di lucro certificata come centro di accoglienza dall'Istituto Francese di Terapia Animale.\r\nFattoria didattica per un'accoglienza specializzata, mediazione animale per accogliere in modo adeguato dai più giovani ai più anziani."
    ],
    "fr": [
      "Association à but no lucratif labellisé comme centre d'accueil par l'institut français de zoothérapie.\r\nFerme pédagogique pour un accueil spécialisé, médiation animale pour accueillir de façon adapté des personnes les plus jeunes aux plus agées."
    ],
    "nl": [
      "Vereniging zonder winstoogmerk, erkend als opvangcentrum door het Franse instituut voor dierentherapie.\r\nEducatieve boerderij voor gespecialiseerde zorg, dierenbemiddeling om mensen van jong tot oud op te vangen."
    ],
    "es": [
      "Asociación sin ánimo de lucro certificada como centro de acogida por el Instituto Francés de Terapia con Animales.\r\nGranja educativa para una acogida especializada, mediación animal para acoger de forma adaptada a los más jóvenes a los más mayores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "O Tour des animaux"
    ]
  },
