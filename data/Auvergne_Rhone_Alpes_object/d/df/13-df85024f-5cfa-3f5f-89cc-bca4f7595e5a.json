  "rdfs:comment": {
    "de": [
      "Juliette, Mathilde, Brice und Charlotte freuen sich, Sie in einer herzlichen und wohlwollenden Atmosphäre zu empfangen. Sie finden uns das ganze Jahr über in unseren Praxen in Plagne Centre oder Belle-Plagne, wo wir Ihnen eine auf Ihre Bedürfnisse zugeschnittene Behandlung anbieten."
    ],
    "en": [
      "Juliette, Mathilde, Brice & Charlotte are pleased to see you at their clinics in Plagne Centre and Belle-Plagne, open year round."
    ],
    "it": [
      "Juliette, Mathilde, Brice e Charlotte sono liete di accogliervi in un'atmosfera calda e premurosa. Venite a trovarci tutto l'anno nei nostri studi di Plagne Centre o Belle-Plagne, dove riceverete trattamenti su misura per voi."
    ],
    "fr": [
      "Juliette, Mathilde, Brice & Charlotte sont ravis de vous recevoir dans une ambiance chaleureuse & bienveillante. Retrouvez-nous toute l'année sur les cabinets de Plagne Centre ou Belle-Plagne, où des soins adaptés à vos besoins vous serons prodigués."
    ],
    "es": [
      "Juliette, Mathilde, Brice y Charlotte están encantados de recibirle en un ambiente cálido y atento. Venga a vernos todo el año a nuestras consultas de Plagne Centre o Belle-Plagne, donde recibirá tratamientos adaptados a sus necesidades."
    ],
    "nl": [
      "Juliette, Mathilde, Brice & Charlotte heten je van harte welkom in hun kantoren in Plagne Centre en Belle-Plagne, die het hele jaar door geopend zijn."
    ]
  },
  "rdfs:label": {
