  "rdfs:comment": {
    "de": [
      "Als kleines Unternehmen in Grenoble konnte es sich als lokale Referenz in seinem Bereich durchsetzen: Großhändler für Milchprodukte. Seine alteingesessene Kundschaft, die aus Fachleuten der Gastronomie bestand, suchte vor allem nach Qualität."
    ],
    "en": [
      "A small Grenoble-based company, it has established itself as a local benchmark in its field: wholesaler of dairy products. Its long-standing clientele, made up of professionals in the catering trade, was above all looking for quality."
    ],
    "it": [
      "Piccola azienda con sede a Grenoble, si è affermata come punto di riferimento locale nel suo settore, come grossista di prodotti lattiero-caseari. La sua clientela di lunga data, composta da professionisti della ristorazione, cercava soprattutto la qualità."
    ],
    "fr": [
      "Petite entreprise grenobloise, elle a su s’imposer comme une référence locale dans son domaine : grossiste en produits laitiers. Sa clientèle historique, composée de professionnels des métiers de bouche, recherchait avant tout la qualité."
    ],
    "es": [
      "Pequeña empresa con sede en Grenoble, se ha impuesto como una referencia local en su sector, como mayorista de productos lácteos. Su clientela, compuesta desde hace tiempo por profesionales del sector alimentario, busca ante todo la calidad."
    ],
    "nl": [
      "Als klein bedrijf gevestigd in Grenoble heeft het zich gevestigd als een lokale referentie op zijn gebied, als groothandelaar in zuivelproducten. Zijn jarenlange klantenkring, bestaande uit professionals in de horeca, was vooral op zoek naar kwaliteit."
    ]
  },
  "rdfs:label": {
