  "rdfs:comment": {
    "de": [
      "Hier werden Rohprodukte, Weine und Gerichte mit Charakter gefeiert. Eine großzügige und elegante Bistroküche, Weine aus Leidenschaft und vor allem ein geselliger Ort, an dem man gut essen, gut trinken und sich wohlfühlen kann."
    ],
    "en": [
      "Here we celebrate raw produce, wines and dishes with character. Generous, elegant bistro cuisine, passionate wines and, above all, a convivial place where you can eat well, drink well and feel good."
    ],
    "it": [
      "Qui si celebrano prodotti crudi, vini e piatti di carattere. Una cucina bistrot generosa ed elegante, vini appassionati e, soprattutto, un luogo accogliente dove mangiare bene, bere bene e sentirsi bene."
    ],
    "fr": [
      "Ici on célèbre les produits bruts, les vins et les plats de caractère. Une cuisine bistrot généreuse et élégante, des vins de passion et surtout un lieu convivial où l'on mange bien, on boit bien et on se sent bien."
    ],
    "nl": [
      "Hier vieren we rauwe producten, wijnen en gerechten met karakter. Een royale, elegante bistrokeuken, gepassioneerde wijnen en bovenal een vriendelijke plek waar je goed kunt eten, drinken en je goed voelen."
    ],
    "es": [
      "Aquí celebramos los productos crudos, los vinos y los platos con carácter. Cocina de bistró generosa y elegante, vinos apasionados y, sobre todo, un lugar acogedor donde comer bien, beber bien y sentirse bien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Dame Jeanne"
    ]
  },
