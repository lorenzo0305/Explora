  "rdfs:comment": {
    "de": [
      "Cru de la Drôme Provençale. Entdecken Sie unser gesamtes Sortiment: unsere Landweine, unsere AOC Côtes du Rhône und unsere AOC Cru Vinsobres.\r\n\"La Vinsobraise, die Kunst des Weins\"."
    ],
    "en": [
      "Vintage of Drome Provençale. Come discover all our products: Vins de Pays, CDO Côtes du Rhône and CDO Vinsobres."
    ],
    "it": [
      "Cru della Drôme Provenzale. Venite a scoprire tutta la nostra gamma: i nostri vins de Pays, i nostri AOC Côtes du Rhône e i nostri AOC Cru Vinsobres.\r\n\"La Vinsobraise, l'Art du Vin\"."
    ],
    "fr": [
      "Cru de la Drôme Provençale. Venez découvrir l'ensemble de notre gamme : nos vins de Pays, nos AOC Côtes du Rhône et notre AOC Cru Vinsobres.\r\n\"La Vinsobraise, l'Art du Vin\"."
    ],
    "nl": [
      "Cru in de Drôme Provençale. Ontdek ons assortiment met wijnen: onze Vins de Pays, AOC Côtes du Rhône en AOC Cru Vinsobres."
    ],
    "es": [
      "Cru de la Drôme Provençale. Venga a descubrir toda nuestra gama: nuestros Vins de Pays, nuestros AOC Côtes du Rhône y nuestros AOC Cru Vinsobres.\r\n\"La Vinsobraise, l'Art du Vin\"."
    ]
  },
