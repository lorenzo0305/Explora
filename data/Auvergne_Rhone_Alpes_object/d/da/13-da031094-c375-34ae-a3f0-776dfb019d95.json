  "rdfs:comment": {
    "de": [
      "Kurz- und langfristiger Verleih von Mountainbikes und städtischen Elektrofahrrädern. Auf Anfrage können Fahrräder tageweise oder über mehrere Monate für Privatpersonen, Geschäftsleute, Gruppen und Seminare gemietet werden."
    ],
    "en": [
      "Short- and long-term rental of VTTAE and urban electric bikes. Bikes can be rented by the day or over several months, for individuals, professionals, groups and seminars, on request."
    ],
    "it": [
      "Noleggio a breve e lungo termine di biciclette da città elettriche e VTTAE. Le biciclette possono essere noleggiate al giorno o per diversi mesi, per singoli, professionisti, gruppi e seminari, su richiesta."
    ],
    "fr": [
      "Location courte et longue durée de VTTAE et vélos électriques urbains. Possibilité de louer des vélos à la journée ou sur plusieurs mois, pour des particuliers, professionnels, groupes et séminaires, sur demande."
    ],
    "nl": [
      "Verhuur op korte en lange termijn van VTTAE en elektrische stadsfietsen. Fietsen kunnen per dag of voor meerdere maanden gehuurd worden, voor individuen, professionals, groepen en seminars, op aanvraag."
    ],
    "es": [
      "Alquiler a corto y largo plazo de bicicletas urbanas VTTAE y eléctricas. Las bicicletas pueden alquilarse por días o durante varios meses, para particulares, profesionales, grupos y seminarios, previa solicitud."
    ]
  },
