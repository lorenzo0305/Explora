  "rdfs:comment": {
    "de": [
      "Kleiner angelegter Teich von 800 m², der in den Freizeitbereich integriert ist.\r\nDieser Wasserspiegel wird nicht überwacht und gilt nicht als Badeort. Der Belag kann rutschig sein und zu Stürzen führen."
    ],
    "en": [
      "800 m² water body situated in the recreational area\r\nThis body of water is not monitored and is not considered a swimming area. The surface may be slippery and may cause falls."
    ],
    "it": [
      "Piccolo lago paesaggistico di 800 m², parte dell'area ricreativa.\r\nQuesto specchio d'acqua non è sorvegliato e non è considerato un'area balneabile. La superficie può essere scivolosa e può provocare cadute."
    ],
    "fr": [
      "Petit plan d'eau aménagé de 800 m², intégré à l'aire de loisirs.\r\nCe plan d’eau n’est pas surveillé et n’est pas considéré comme un lieu de baignade. Le revêtement peut être glissant et peut entraîner des chutes."
    ],
    "es": [
      "Pequeño lago ajardinado de 800 m² que forma parte de la zona de ocio.\r\nEste tramo de agua no está vigilado y no se considera zona de baño. La superficie puede ser resbaladiza y provocar caídas."
    ],
    "nl": [
      "Kleine ingerichte zwemvijver van 800 m².\r\nDit waterlichaam wordt niet bewaakt en wordt niet als een zwemgebied beschouwd. Het oppervlak kan glad zijn en valpartijen veroorzaken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Water body"
    ],
    "fr": [
      "Plan d'eau"
    ],
    "nl": [
      "Zwemvijver"
    ]
  },
