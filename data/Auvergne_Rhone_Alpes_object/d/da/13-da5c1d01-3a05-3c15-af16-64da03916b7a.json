  "rdfs:comment": {
    "de": [
      "Organisieren Sie Ihre Meetings, Seminare, Hauptversammlungen, Workshops und Konferenzen in einem ganz besonderen Ambiente, mitten auf unserem agroökologischen Bauernhof, umgeben von Natur, dank unserer zwei ökologischen Tagungsräume, die Platz für bis zu 60 Personen bieten."
    ],
    "en": [
      "Organize your meetings, seminars, AGMs, workshops, conferences in a truly different setting, in the heart of our agroecological farm surrounded by nature, thanks to our two ecological meeting rooms that can accommodate up to 60 people."
    ],
    "it": [
      "Organizzate le vostre riunioni, seminari, assemblee generali, workshop e conferenze in un ambiente davvero diverso, nel cuore della nostra fattoria agro-ecologica nel cuore della natura, grazie alle nostre due sale riunioni ecologiche che possono ospitare fino a 60 persone."
    ],
    "fr": [
      "Organisez vos réunions, séminaires, AG, workshops, conférences dans un cadre vraiment différent, au cœur de notre ferme en agroécologie en pleine nature, grâce à nos deux salles de réunions écologiques pouvant accueillir jusqu'à 60 personnes."
    ],
    "nl": [
      "Organiseer uw vergaderingen, seminars, algemene ledenvergaderingen, workshops en conferenties in een werkelijk unieke omgeving, midden in onze agro-ecologische boerderij, omgeven door de natuur, dankzij onze twee ecologische vergaderruimtes die plaats bieden aan maximaal 60 personen."
    ],
    "es": [
      "Organice sus reuniones, seminarios, asambleas generales, talleres y conferencias en un marco realmente diferente, en el corazón de nuestra granja agroecológica en plena naturaleza, gracias a nuestras dos salas de reuniones ecológicas que pueden acoger hasta 60 personas."
    ]
  },
  "rdfs:label": {
