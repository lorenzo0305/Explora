  "rdfs:comment": {
    "de": [
      "La St Martin, eine Anspielung auf das Bresse-Lied, eine Mountainbike-CTV-Runde als Ode an die Bresse mit dem Fahrrad \"auf den kleinen Feldwegen\"! Land der Geflügelpäpste der Bresse ein Eintauchen in diese typischen Landschaften mit ihrem traditionellen Habitat."
    ],
    "en": [
      "La St Martin, a nod to the Bresse song, a mountain bike loop as an ode to Bresse by bicycle \"on the little dirt roads\"! Land of the popes of Bresse poultry, an immersion in these typical landscapes with their traditional habitat."
    ],
    "it": [
      "La St Martin, un cenno alla canzone bresciana, un giro in mountain bike come ode alla regione della Bresse in bicicletta \"sulle piccole strade sterrate\"! Terra dei papi del pollame di Bresse, questo tour vi immerge nei paesaggi tipici della Bresse e nelle case tradizionali."
    ],
    "fr": [
      "La St Martin, clin d'œil à la chanson bressane, une boucle VTT-VTC comme ode à la Bresse à bicyclette \"sur les petits chemins de terre\" ! Pays des papes de la volaille de la Bresse une immersion dans ces paysages typiques avec son habitat traditionnel."
    ],
    "es": [
      "La St Martin, un guiño a la canción de Bresse, un bucle en bicicleta de montaña como oda a la región de Bresse en bicicleta \"por los caminitos de tierra\" Tierra de los papas de las aves de corral de Bresse, este recorrido le sumerge en los paisajes típicos de Bresse y en sus casas tradicionales."
    ],
    "nl": [
      "La St Martin, een knipoog naar het Bresse-lied, een mountainbikeroute als ode aan de Bresse met de fiets \"over de kleine zandweggetjes\"! Deze tocht, het land van de Bressepausen en het Bressepluimvee, dompelt je onder in typische Bresse-landschappen en traditionele huizen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit Gravel n°24 (red) - La St Martin"
    ],
    "fr": [
      "Circuit Gravel n°24 (rouge) - La St Martin"
    ]
  },
