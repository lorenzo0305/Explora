  "rdfs:comment": {
    "de": [
      "10 Loch Parcours und Pitch & Putt-Golfplatz: die ideale Umgebung, um den Golfsport zu entdecken."
    ],
    "en": [
      "A 9-hole course of 1,550 m, a 200-metre driving range and a 10-hole pitch-and-putt course (the perfect place to discover golf and improve your skills).\r\n20 seats including 6 covered seats, a training bunker and a putting green. A flat and a 200 m long driving range."
    ],
    "it": [
      "Percorso 10 fori e percorso compatto 5 fori: spazio ideale per scoprire il golf."
    ],
    "fr": [
      "Parcours 9 trous de 1550 m, practice long de 200 m et parcours pitch&putt 10 trous (espace idéal pour découvrir le golf et se perfectionner).\r\n20 postes dont 6 couverts, un bunker d'entraînement et un putting green. Practice plat et long de 200 m."
    ],
    "es": [
      "Recorrido 10 hoyos y recorrido compacto 5 hoyos para descubrir el golf."
    ],
    "nl": [
      "9-holes baan van 1.550 m, 200 m lange driving range en 10-holes pitch&putt baan (ideale ruimte om golf te ontdekken en te verbeteren).\r\n20 posten, waarvan 6 overdekt, een oefenbunker en een putting green. Vlak, 200 m lang rijbereik."
    ]
  },
