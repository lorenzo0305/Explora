  "rdfs:comment": {
    "de": [
      "Bestellen Sie Ihr kreolisches, reunionesisches Essen! Perfekt für alle Gelegenheiten. Zum Mitnehmen (geliefert oder abgeholt)."
    ],
    "en": [
      "Event planning & Réunionese culture: enjoy my cuisine (takeaway snacks, catering, private chef services) and experience Creole culture through my culinary workshops, dance classes, and performances.\r\nI also organize tailor-made events for you from A to Z."
    ],
    "it": [
      "Eventi e cultura della Réunion: godetevi la mia cucina (snack da asporto, catering, chef a domicilio) e vivete la cultura creola attraverso i miei laboratori culinari, i corsi di danza e gli spettacoli.\r\nPosso anche organizzare tutti i vostri eventi su misura dalla A alla Z."
    ],
    "fr": [
      "Événementiel & culture réunionnaise: savourez ma cuisine (snack à emporter, traiteur, cheffe à domicile) et vivez la culture créole via mes ateliers culinaires, stages de danse et spectacles. \r\nJ'organise aussi tous vos événements sur mesure A à Z."
    ],
    "es": [
      "Eventos y cultura de la Reunión: disfrute de mi cocina (aperitivos para llevar, catering, chef a domicilio) y viva la cultura criolla a través de mis talleres culinarios, cursos de baile y espectáculos.\r\nTambién puedo organizar todos sus eventos a medida de la A a la Z."
    ],
    "nl": [
      "Bestel uw Creoolse, Reunionese maaltijd! Perfect voor alle gelegenheden. Afhalen (bezorgd of afgehaald)."
    ]
  },
