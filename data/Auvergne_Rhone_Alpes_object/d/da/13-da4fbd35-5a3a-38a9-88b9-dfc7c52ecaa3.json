  "rdfs:comment": {
    "de": [
      "Atelier/Boutique für Kunsthandwerk. Holzschmuck und dekorative Malerei auf Möbeln, ich kreiere aus 100% natürlichen Materialien. Ich biete Ihnen einzigartige Kreationen, personalisierte Kreationen und Entdeckungskurse an."
    ],
    "en": [
      "Arts and crafts workshop/shop. Wooden jewelry and decorative painting on furniture, I create from 100% natural materials. I offer one-off creations, personalized creations and discovery workshops."
    ],
    "it": [
      "Studio/negozio di artigianato artistico. Gioielli in legno e pittura decorativa su mobili, creo con materiali naturali al 100%. Offro creazioni uniche, creazioni personalizzate e corsi introduttivi."
    ],
    "fr": [
      "Atelier/boutique d'artisanat d'art. Bijoux en bois et peinture décorative sur mobilier, je crée à partir de matières 100% naturelles. Je vous propose des créations uniques, des créations personnalisées et des stages de découverte."
    ],
    "nl": [
      "Kunstnijverheidsstudio/winkel. Ik maak houten sieraden en decoratief schilderwerk op meubels van 100% natuurlijke materialen. Ik bied eenmalige creaties, gepersonaliseerde creaties en introductiecursussen."
    ],
    "es": [
      "Estudio/tienda de artesanía. Joyas de madera y pintura decorativa sobre muebles, creo a partir de materiales 100% naturales. Ofrezco creaciones únicas, creaciones personalizadas y cursos de iniciación."
    ]
  },
