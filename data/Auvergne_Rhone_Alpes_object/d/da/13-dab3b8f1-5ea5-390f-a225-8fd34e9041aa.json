  "rdfs:comment": {
    "de": [
      "Authentische Tafel und gesellige Küche im Dauerbetrieb.\r\nGenießen Sie unseren Südblick und entdecken Sie unsere Raclettes und Savoyer Spezialitäten vom Grill, frische hausgemachte Nudeln, gereiftes Fleisch, texanisches BBQ. Zum Nachtisch gibt es Crêpes, Brioche perdue etc"
    ],
    "en": [
      "Authentic table and friendly cuisine in continuous service.\r\nTake advantage of our south-facing view and discover our raclettes and Savoyard specialties grilled on a charcoal, fresh homemade pasta, matured meats, Texan BBQ. To taste it, pancakes, lost brioche etc."
    ],
    "it": [
      "Tavola genuina e cucina amichevole in servizio continuo.\r\nApprofitta della nostra vista a sud e scopri le nostre raclette e specialità savoiarde alla griglia, pasta fresca fatta in casa, carni stagionate, barbecue texano. Per assaggiarlo, frittelle, brioche perse ecc."
    ],
    "fr": [
      "Table authentique et cuisine conviviale en service continu.\r\nProfitez de notre vue plein sud et découvrez nos raclettes et spécialités savoyardes à la braise, pâtes fraiches maison, viandes maturées, BBQ  texan. Pour le gouter, crêpes, brioche perdue etc"
    ],
    "nl": [
      "Authentieke tafel en vriendelijke keuken in continue bediening.\r\nProfiteer van ons uitzicht op het zuiden en ontdek onze raclettes en Savoyaardse specialiteiten gegrild op de grill, verse zelfgemaakte pasta, gerijpt vlees, Texaanse barbecue. Om het te proeven, pannenkoeken, verloren brioche etc."
    ],
    "es": [
      "Auténtica mesa y cocina de convivencia en servicio continuo.\r\nAproveche nuestra vista orientada al sur y descubra nuestras raclettes y especialidades saboyanas, pasta fresca casera, carnes maduradas, barbacoa tejana. Para aperitivos, crepes, brioche perdue, etc"
    ]
  },
