  "rdfs:comment": {
    "de": [
      "Aurélie schätzt zeitgenössische Keramik. Sie stellt Gegenstände aus farbigem, durchgefärbtem Porzellan her. Der Schwerpunkt ihrer Produktion liegt auf Tischkultur, aber Sie finden in ihrem Geschäft auch dekorative Stücke und einige Schmuckstücke."
    ],
    "en": [
      "Aurélie appreciates contemporary ceramics. She makes objects in colored, body-tinted porcelain. Her production focuses on tableware, but you'll also find decorative pieces and some jewelry in her boutique."
    ],
    "it": [
      "Aurélie ama la ceramica contemporanea. Realizza oggetti in porcellana colorata, tinta in massa. La sua produzione si concentra sulle stoviglie, ma nel suo negozio si trovano anche pezzi decorativi e alcuni gioielli."
    ],
    "fr": [
      "Aurélie apprécie la céramique contemporaine. Elle fabrique des objets en porcelaine colorée, teintée dans la masse. Sa production est axée sur les arts de la table, mais vous trouverez également dans sa boutique des pièces décoratives et quelques bijoux."
    ],
    "nl": [
      "Aurélie houdt van hedendaagse keramiek. Ze maakt objecten van gekleurd porselein, gekleurd in de massa. Haar productie richt zich op servies, maar je vindt ook decoratieve stukken en enkele sieraden in haar winkel."
    ],
    "es": [
      "A Aurélie le encanta la cerámica contemporánea. Realiza objetos en porcelana coloreada, teñida en la masa. Su producción se centra en la vajilla, pero en su tienda también encontrarás piezas decorativas y algunas joyas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A.N.G Céramique"
    ]
  },
