  "rdfs:comment": {
    "de": [
      "Außergewöhnlich durch den Reichtum seines Kulturerbes: natürlich mit dem Berg Glandasse, dem Fluss Bez und den Weinbergen; gebaut mit seinem mittelalterlichen Zentrum und seinen Violen; botanisch mit seiner Sammlung von Pflanzen, die im ganzen Dorf verteilt sind."
    ],
    "en": [
      "Châtillon-en-Diois has much to offer to the visitor:  Nature is generous with le Glandasse Mountain and the river Bez. Vineyards surround the locality and a botanical trail span across the village. The town also offers a good representation of traditional architecture with its narrow medieval streets and houses."
    ],
    "it": [
      "Eccezionale per la ricchezza del suo patrimonio: naturale con la montagna Glandasse, il fiume Bez, i vigneti; costruito con il suo centro medievale e i suoi violini; botanico con la sua collezione di piante diffuse in tutto il villaggio."
    ],
    "fr": [
      "Exceptionnel par la richesse de son patrimoine : naturel avec la montagne de Glandasse, la rivière le Bez, les vignes ; bâti avec son centre médiéval et ses viols ; botanique avec sa collection de végétaux répartis dans le village."
    ],
    "nl": [
      "Uitzonderlijk vanwege het rijke erfgoed; natuurlijk vanwege de berg de Glandasse, de rivier de Bez en de wijngaarden; middeleeuws vanwege het historische centrum en de steegjes ('viols' in de volksmond); botanisch dankzij de weldaad aan groen in het dorp."
    ],
    "es": [
      "Excepcional por la riqueza de su patrimonio: natural con el monte Glandasse, el río Bez, los viñedos; construido con su centro medieval y sus violas; botánico con su colección de plantas repartidas por todo el pueblo."
    ]
  },
