  "rdfs:comment": {
    "de": [
      "Dorf Cronce: Kirche mit Kammglockenturm aus dem 16. bis 17. Jahrhundert, mit Altarbild aus dem 18. Überreste der Schlösser von Cronce und Gilbertès. Blick auf das Tal des Flusses Cronce."
    ],
    "en": [
      "Village of Cronce: 16th-17th-century church with comb bell tower and 18th-century altarpiece. Remains of the Cronce and Gilbertès castles. View over the Cronce valley."
    ],
    "it": [
      "Villaggio di Cronce: chiesa con campanile a pettine del XVI e XVII secolo, con pala d'altare del XVIII secolo. Resti dei castelli di Cronce e Gilbertès. Vista sulla valle di Cronce."
    ],
    "fr": [
      "Village de Cronce : Église à clocher peigne des XVIe-XVIIe siècles, avec retable du XVIIIe siècle. Vestiges des châteaux de Cronce et du Gilbertès. Vue sur la vallée de la Cronce."
    ],
    "es": [
      "Pueblo de Cronce: Iglesia con campanario peinado de los siglos XVI y XVII, con un retablo del siglo XVIII. Restos de los castillos de Cronce y Gilbertès. Vista sobre el valle de Cronce."
    ],
    "nl": [
      "Dorp Cronce: Kerk met gekamde klokkentoren uit de 16e en 17e eeuw, met een altaarstuk uit de 18e eeuw. Overblijfselen van de kastelen van Cronce en Gilbertès. Uitzicht over de vallei van Cronce."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Cronce"
    ]
  },
