  "rdfs:comment": {
    "de": [
      "Als selbstständiger Skilehrer gibt Pascal gerne seine Fähigkeiten weiter und teilt sie mit Ihnen und vermittelt Ihnen eine gute Grundlage. Seine Methode ist einfach und um Ihre Sicherheit herum strukturiert."
    ],
    "en": [
      "Independent ski instructor, Pascal likes to pass on and share his skills and gives you a good grounding. His method is simple and structured around your safety."
    ],
    "it": [
      "Pascal, maestro di sci freelance, ama trasmettere e condividere le sue competenze e darvi una buona base. Il suo metodo è semplice e strutturato in base alla vostra sicurezza."
    ],
    "fr": [
      "Moniteur de ski indépendant, Pascal aime transmettre et partager ses compétences et vous donne de bonnes bases. Sa méthode est simple et structurée autour de votre sécurité."
    ],
    "es": [
      "Instructor de esquí autónomo, a Pascal le gusta transmitir y compartir sus conocimientos y darte una buena base. Su método es sencillo y estructurado en torno a tu seguridad."
    ],
    "nl": [
      "Als freelance skileraar geeft Pascal graag zijn vaardigheden door, deelt ze met anderen en geeft je een goede basis. Zijn methode is eenvoudig en gestructureerd rond jouw veiligheid."
    ]
  },
