  "rdfs:comment": {
    "de": [
      "Restaurant Gourmand (Feinschmecker). Abwechslungsreiche und raffinierte Küche, Geselligkeit, gedämpfter Rahmen; Lounge-Bereich. Große Auswahl auf der Karte. Burger und Salatmahlzeiten mittags unter der Woche. Gerichte zum Mitnehmen. Empfohlen von Le Petit Futé und TripAdvisor."
    ],
    "en": [
      "Gourmet Restaurant. Varied and refined cuisine, conviviality, cozy setting; Lounge area. Wide choice à la carte. Burger and salad lunch on weekdays. Take away food. Recommended by Le Petit Futé and TripAdvisor."
    ],
    "it": [
      "Ristorante gourmet. Cucina varia e raffinata, convivialità, ambiente accogliente; area lounge. Ampia scelta alla carta. Pasti a base di hamburger e insalate a pranzo durante la settimana. Pasti da asporto. Consigliato dal Petit Futé e da TripAdvisor."
    ],
    "fr": [
      "Restaurant Gourmand. Cuisine variée et raffinée, convivialité, cadre feutré ; Espace Lounge. Large choix à la carte. Burger et salade repas le midi en semaine. Plats à emporter. Recommandé par le Petit Futé et TripAdvisor."
    ],
    "es": [
      "Restaurante gastronómico. Cocina variada y refinada, convivencia, ambiente acogedor; Zona de estar. Amplia oferta a la carta. Comidas de hamburguesas y ensaladas a la hora del almuerzo durante la semana. Comidas para llevar. Recomendado por el Petit Futé y TripAdvisor."
    ],
    "nl": [
      "Gourmet restaurant. Gevarieerde en verfijnde keuken, gezelligheid, gezellig kader; Ontspanningsruimte. Ruime keuze à la carte. Lunch met hamburger en salade op weekdagen. Afhaalmaaltijden. Aanbevolen door Le Petit Futé en TripAdvisor."
    ]
  },
  "rdfs:label": {
