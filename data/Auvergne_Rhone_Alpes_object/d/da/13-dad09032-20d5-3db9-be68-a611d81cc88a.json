  "rdfs:comment": {
    "de": [
      "La Loko bietet Ihnen eine familiäre und traditionelle Küche in einer geselligen Atmosphäre. Genießen Sie unter der Woche unsere reichhaltigen Tagesmenüs. An den Wochenenden verwöhnen Sie Ihre Familie mit unseren Spezialitäten: Rahmflecken, Frösche..."
    ],
    "en": [
      "La Loko offers traditional family cuisine in a friendly atmosphere. During the week, enjoy our hearty daily menus. On weekends, treat your family to our specialities: grated meat, frogs..."
    ],
    "it": [
      "La Loko offre una cucina familiare tradizionale in un'atmosfera amichevole. Durante la settimana, gustate i nostri sostanziosi menu giornalieri. Nel fine settimana, concedetevi le nostre specialità per voi e la vostra famiglia: carne grattugiata, rane..."
    ],
    "fr": [
      "La Loko vous propose une cuisine familiale et traditionnelle dans une ambiance conviviale. En semaine, savourez nos menus du jour copieux. Les week-ends, régalez-vous en famille avec nos spécialités : râpées, grenouilles..."
    ],
    "es": [
      "La Loko ofrece cocina familiar tradicional en un ambiente acogedor. Durante la semana, disfrute de nuestros abundantes menús diarios. Los fines de semana, deléitese usted y su familia con nuestras especialidades: carne rallada, ranas..."
    ],
    "nl": [
      "La Loko biedt een traditionele familiekeuken in een gezellige sfeer. Geniet doordeweeks van onze stevige dagmenu's. Verwen jezelf en je familie in het weekend met onze specialiteiten: geraspt vlees, kikkers..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Loko Gîte Resto"
    ]
  },
