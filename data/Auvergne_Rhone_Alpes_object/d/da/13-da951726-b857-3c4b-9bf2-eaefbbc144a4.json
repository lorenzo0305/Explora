  "rdfs:comment": {
    "de": [
      "Marie, die Enkelin von \"Père Louis\", hat die Straußenfarm ihrer Großeltern übernommen und einen pädagogischen Bauernhof integriert.\r\nWallabys, Pfauen, Schafe, Ziegen, Kaninchen... sind hier zu finden, um mit der ganzen Familie zu lernen und zu staunen."
    ],
    "en": [
      "Marie, granddaughter of “Père Louis”, has taken over her grandparents' ostrich farm and integrated it into an educational farm. \r\nWallabies, peacocks, sheep, goats, rabbits... are all there for the family to learn and marvel at."
    ],
    "it": [
      "Marie, nipote di \"Père Louis\", ha rilevato l'allevamento di struzzi dei nonni e vi ha aggiunto una fattoria didattica.\r\nWallabies, pavoni, pecore, capre, conigli... sono a disposizione di tutta la famiglia per imparare e stupirsi."
    ],
    "fr": [
      "Marie, petite fille du \"Père Louis\" a reprit l'élevage d'autruches de ses grands parents en y intégrant une ferme pédagogique. \r\nWallabies, paons, moutons, chèvres, lapins... sont présents pour apprendre et s'émerveiller en famille."
    ],
    "es": [
      "Marie, nieta de \"Père Louis\", se ha hecho cargo de la granja de avestruces de sus abuelos y le ha añadido una granja educativa.\r\nWallabies, pavos reales, ovejas, cabras, conejos... están allí para que toda la familia aprenda y se maraville."
    ],
    "nl": [
      "Marie, kleindochter van \"Père Louis\", heeft de struisvogelboerderij van haar grootouders overgenomen en er een educatieve boerderij aan toegevoegd.\r\nWallaby's, pauwen, schapen, geiten, konijnen... zijn er voor het hele gezin om te leren en te bewonderen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Father Louis' Educational Farm"
    ],
    "fr": [
      "Ferme pédagogique du Père Louis"
    ]
  },
