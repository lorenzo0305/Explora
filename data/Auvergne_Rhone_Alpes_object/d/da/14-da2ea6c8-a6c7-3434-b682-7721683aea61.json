  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/74d69fa5-6beb-33fd-af55-bc56e3290f72",
      "dc:description": {
        "de": [
          "Von 9H bis 18H. Der Eintritt ist frei.\nMehr als 40 Aussteller.\nHistoriker, historische Romanautoren, Verleger, Archivare, Genealogen, Schutzvereine, Sammler, Kunsthandwerker rund um das geschriebene Wort...\nSignierstunden, Hilfen zum Lesen alter Dokumente, Verkauf neuer und gebrauchter Geschichtsbücher...\n2 Vorträge:\n10H - 10H30: \"Geschichte des Rathauses von Boulogne-sur-Mer\" von Madame Clauzel.\n14H - 14H30: \"Die Dekoration des Rathauses von Boulogne-sur-Mer\" von Herrn Parenty."
        ],
        "en": [
          "From 9H to 18H. Free admission.\nOver 40 exhibitors.\nHistorians, historical novelists, publishers, archivists, genealogists, preservation associations, collectors, craftspeople working with the written word...\nSignings, help with reading old documents, sales of new and second-hand history books...\n2 lectures:\n10am - 10:30am: \"History of Boulogne-sur-Mer Town Hall\" by Madame Clauzel.\n14H - 14H30: \"The decoration of Boulogne-sur-Mer Town Hall\" by Monsieur Parenty."
        ],
        "it": [
          "Dalle 9H alle 18H. Ingresso libero.\nPiù di 40 espositori.\nStorici, romanzieri storici, editori, archivisti, genealogisti, associazioni di conservazione, collezionisti, artigiani della parola scritta...\nSessioni di autografi, aiuto nella lettura di vecchi documenti, vendita di libri di storia nuovi e usati...\n2 conferenze:\n10.00 - 10.30: \"Storia del Municipio di Boulogne-sur-Mer\" di Madame Clauzel.\n14.00-14.30: \"La decorazione del Municipio di Boulogne-sur-Mer\" di Parenty."
        ],
        "fr": [
          "De 9H à 18H. Entrée gratuite.\nPlus de 40 exposants. \nHistoriens, romanciers historiques, éditeurs, archivistes, généalogistes, associations de sauvegarde, collectionneurs, artisans d'art autour de l'écrit...\nDédicaces, aides à la lecture des documents anciens, ventes de livres d'histoire neufs et d'occasion...\n2 conférences : \n10H - 10H30 : \" Histoire de l'Hôtel de Ville de Boulogne-sur-Mer \" par Madame Clauzel.\n14H - 14H30 : \" La décoration de l'Hôtel de Ville de Boulogne-sur-Mer par Monsieur Parenty."
        ],
        "nl": [
          "Van 9 tot 18 uur. Gratis toegang.\nMeer dan 40 exposanten.\nHistorici, historische romanschrijvers, uitgevers, archivarissen, genealogen, behoudsverenigingen, verzamelaars, ambachtslui die met het geschreven woord werken...\nSigneersessies, hulp bij het lezen van oude documenten, verkoop van nieuwe en tweedehands geschiedenisboeken...\n2 lezingen:\n10.00 - 10.30 uur: \"Geschiedenis van het stadhuis van Boulogne-sur-Mer\" door Madame Clauzel.\n14.00 - 14.30 uur: \"De decoratie van het stadhuis van Boulogne-sur-Mer\" door de heer Parenty."
        ],
        "es": [
          "De 9H a 18H. Entrada gratuita.\nMás de 40 expositores.\nHistoriadores, novelistas históricos, editores, archiveros, genealogistas, asociaciones de conservación, coleccionistas, artesanos de la palabra escrita...\nSesiones de firmas, ayuda a la lectura de documentos antiguos, venta de libros de historia nuevos y de ocasión...\n2 conferencias:\n10.00 h - 10.30 h: \"Historia del Ayuntamiento de Boulogne-sur-Mer\" por Madame Clauzel.\n14.00 h - 14.30 h: \"La decoración del Ayuntamiento de Boulogne-sur-Mer\" por el Sr. Parenty."
        ]
      },
