  "rdfs:comment": {
    "de": [
      "Das Tourismusinformationsbüro von Abondance empfängt Sie und informiert Sie über kulturelle und sportliche Aktivitäten in Abondance und der Region. Wir geben Ihnen auch Auskunft über Unterkünfte für eine Woche oder ein paar Tage."
    ],
    "en": [
      "Abondance Tourism welcome you and inform about the cultural and sportive activites in Abondance and in the region. We give you advices about the accomodation for one week ou several days."
    ],
    "it": [
      "L'ufficio informazioni turistiche di Abondance vi accoglie e vi informa sulle attività culturali e sportive di Abondance e della regione. Possiamo anche fornirvi informazioni sull'alloggio per una settimana o pochi giorni."
    ],
    "fr": [
      "Le bureau d'information touristique d'Abondance vous accueille et vous informe sur les activités culturelles et sportives  à Abondance et dans la région. Nous vous renseignons également sur les hébergements à la semaine ou pour quelques jours."
    ],
    "es": [
      "La oficina de turismo de Abondance le da la bienvenida y le informa sobre las actividades culturales y deportivas de Abondance y de la región. También podemos informarle sobre alojamiento para una semana o unos días."
    ],
    "nl": [
      "Het toeristenbureau van Abondance heet je welkom en geeft informatie over culturele en sportieve activiteiten in Abondance en omgeving. We kunnen je ook informatie geven over accommodatie voor een week of een paar dagen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Abondance Tourist Information Office"
    ],
    "fr": [
      "Bureau d'Information Touristique d'Abondance"
    ],
    "nl": [
      "Toeristische dienst van Abondance"
    ]
  },
