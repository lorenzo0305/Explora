  "rdfs:comment": {
    "de": [
      "Restaurant , Bar lounge in einer gemütlichen Atmosphäre, l'Eden wird Ihren Gaumen mit hausgemachten und saisonalen Gerichten verwöhnen, am Ufer des Wassers."
    ],
    "en": [
      "Restaurant, lounge bar in a cozy atmosphere, Eden will delight your taste buds with homemade and seasonal cuisine, at the water's edge."
    ],
    "it": [
      "Ristorante e lounge bar dall'atmosfera accogliente, l'Eden delizierà il vostro palato con una cucina casalinga e stagionale, proprio sull'acqua."
    ],
    "fr": [
      "Restaurant , Bar lounge dans une ambiance cosy, l'Eden saura ravir vos papilles avec une cuisine maison et de saison, au bord de l'eau."
    ],
    "es": [
      "Restaurante y bar salón en un ambiente acogedor, el Edén deleitará su paladar con una cocina casera y de temporada, justo en el agua."
    ],
    "nl": [
      "Restaurant en loungebar in een gezellige sfeer, Eden zal uw smaakpapillen verwennen met huisgemaakte en seizoensgebonden gerechten, direct aan het water."
    ]
  },
