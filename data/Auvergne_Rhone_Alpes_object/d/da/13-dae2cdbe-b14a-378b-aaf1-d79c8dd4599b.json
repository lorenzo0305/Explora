  "rdfs:comment": {
    "de": [
      "Die Kirche von Chevrières bildet eine harmonische Einheit aus der spätgotischen Architektur und der Architektur der frühen Renaissance. An der Außenseite zeigen die Basen der Strebepfeiler noch Überreste von Fantasietieren."
    ],
    "en": [
      "The church at Chevrières is a harmonious blend of late-Gothic and early-Renaissance architecture. On the exterior, the bases of the buttresses still show the remains of fantastical animals."
    ],
    "it": [
      "La chiesa di Chevrières è un'armoniosa fusione di architettura tardo-gotica e primo rinascimentale. All'esterno, le basi dei contrafforti mostrano ancora i resti di animali fantastici."
    ],
    "fr": [
      "L’église de Chevrières fait un tout harmonieux avec l’architecture gothique finissante et l’architecture du début de la Renaissance. À l’extérieur, les bases des contreforts montrent encore des vestiges d’animaux fantastiques."
    ],
    "es": [
      "La iglesia de Chevrières es una armoniosa mezcla de arquitectura gótica tardía y renacentista temprana. En el exterior, las bases de los contrafuertes conservan restos de animales fantásticos."
    ],
    "nl": [
      "De kerk van Chevrières is een harmonieuze mix van laatgotische en vroegrenaissance architectuur. Aan de buitenkant vertonen de bases van de steunberen nog steeds de overblijfselen van fantasiedieren."
    ]
  },
  "rdfs:label": {
