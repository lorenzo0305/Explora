  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fc7d12f6-39f2-360f-996d-36fba792ffc5",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte:\nDie Produkte können Sie auf der Facebook-Seite einsehen.\n\nTage der Öffnung :\nDer Laden ist nur geöffnet, um Ihre Bestellung abzuholen.\n\nBestellungen:\nSie können die Produkte telefonisch unter 03 21 07 17 79 oder per Messenger bestellen.\nAuch eine Lieferung ist möglich.\n\n "
        ],
        "en": [
          "Information :\n\nProducts:\nYou can view the products on the Facebook page.\n\nOpening days:\nThe store is only open to pick up your order.\n\nOrdering:\nYou can order products by telephone on 03 21 07 17 79 or by messenger.\nDelivery is also possible.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\nÈ possibile visualizzare i prodotti sulla pagina Facebook.\n\nGiorni di apertura:\nIl negozio è aperto solo per ritirare l'ordine.\n\nOrdini:\nÈ possibile ordinare i prodotti per telefono al numero 03 21 07 17 79 o tramite messaggeria.\nÈ possibile anche la consegna.\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits :\nVous pouvez consulter les produits sur la page Facebook.\n\nJours d'ouverture : \nLe magasin est ouvert uniquement pour venir rechercher votre commande. \n\nCommandes : \nVous pouvez commander les produits par téléphone au 03 21 07 17 79 ou sur messenger.\nLa livraison est possible.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\nU kunt de producten bekijken op de Facebook-pagina.\n\nOpeningsdagen:\nDe winkel is alleen geopend om je bestelling af te halen.\n\nBestellen:\nJe kunt producten telefonisch bestellen op 03 21 07 17 79 of per bode.\nLevering is ook mogelijk.\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\nPuede ver los productos en la página de Facebook.\n\nDías de apertura:\nLa tienda sólo está abierta para recoger su pedido.\n\nPedidos:\nPuede pedir productos por teléfono llamando al 03 21 07 17 79 o por mensajero.\nTambién es posible el envío a domicilio.\n\n "
        ]
      },
