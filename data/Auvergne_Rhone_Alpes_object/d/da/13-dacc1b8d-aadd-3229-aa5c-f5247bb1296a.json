  "rdfs:comment": {
    "de": [
      "10.30 Uhr: Treffen mit M. Desbiolles und P. Hanus, rund um ihre Bücher \"Chardons ardents\" \"Carte de séjour\". Exile, Grenzen, ...\r\n16.00 bis 17.45 Uhr: Spaziergang mit Lesungen über den italienischen Schriftsteller M. Rigoni Stern von L. Soffiati. Wanderung 45 Minuten."
    ],
    "en": [
      "10:30am: Meeting with M. Desbiolles and P. Hanus, about their books \"Chardons ardents\" and \"Carte de séjour\". Exiles, borders...\r\n4pm to 5:45pm: A walk punctuated by readings of Italian writer M. Rigoni Stern by L. Soffiati. 45-minute walk."
    ],
    "it": [
      "10.30: Incontro con M. Desbiolles e P. Hanus, sui loro libri \"Chardons ardents\" e \"Carte de séjour\". Esili, frontiere...\r\n16.00-17.45: Passeggiata intervallata da letture sullo scrittore italiano M. Rigoni Stern a cura di L. Soffiati. Passeggiata di 45 minuti."
    ],
    "fr": [
      "10h30 : rencontre avec M. Desbiolles et P. Hanus, autour de leurs livres \"Chardons ardents\" \"Carte de séjour\". Exils, frontières, ...\r\nDe 16h à 17h45 : Balade ponctuée de lectures autour de l'écrivain italien M. Rigoni Stern par L. Soffiati. Marche 45mn."
    ],
    "nl": [
      "10.30 uur: Ontmoeting met M. Desbiolles en P. Hanus, over hun boeken \"Chardons ardents\" en \"Carte de séjour\". Ballingen, grenzen...\r\n16u tot 17u45: Wandeling onderbroken door lezingen over de Italiaanse schrijver M. Rigoni Stern door L. Soffiati. Wandeling van 45 minuten."
    ],
    "es": [
      "10.30 h: Encuentro con M. Desbiolles y P. Hanus, a propósito de sus libros \"Chardons ardents\" y \"Carte de séjour\". Exilios, fronteras...\r\nDe 16.00 a 17.45 h: Paseo amenizado con lecturas sobre el escritor italiano M. Rigoni Stern a cargo de L. Soffiati. Paseo de 45 minutos."
    ]
  },
