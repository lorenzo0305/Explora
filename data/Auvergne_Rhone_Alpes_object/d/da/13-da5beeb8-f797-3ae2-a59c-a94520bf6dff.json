  "rdfs:comment": {
    "de": [
      "Bio-Beeren und Spezialitäten:\r\n-Heidelbeeren, Erdbeeren, Johannisbeeren…\r\n-Marmeladen, Fruchtpürees, Kompotte, Sirupe, Cremesuppen, Kräutertees und Honig – alles aus eigener Ernte.\r\nErhältlich im Direktverkauf, Großhandel oder zum Selberpflücken auf dem Hof."
    ],
    "en": [
      "Organic red fruits and specialty products:\r\n-Blueberries, strawberries, currants…\r\n-Jams, fruit purées, compotes, syrups, creamy soups, herbal teas, and honey, all made from our own harvest.\r\nAvailable for direct sale, wholesale, or pick-your-own at the farm."
    ],
    "it": [
      "Produttore di frutta rossa e specialità biologiche:\r\n-Mirtilli, fragole, ribes...\r\n-Marmellate, coulis, composte, sciroppi, vellutate, tisane e miele, tutti prodotti internamente.\r\n\r\nVendita diretta, all'ingrosso e per asporto."
    ],
    "fr": [
      "Producteur de fruits rouges bio et de spécialités : \r\n-Myrtilles, fraises, groseilles...\r\n-Confitures, coulis, compotes, sirops, veloutés, tisanes et miel, issus de la production.\r\n\r\nVente en direct, demi-gros et ramasse au champ."
    ],
    "es": [
      "Productor de frutos rojos ecológicos y especialidades:\r\n-Arándanos, fresas, grosellas...\r\n-Mermeladas, coulis, compotas, siropes, terciopelos, tisanas y miel, todo de producción propia.\r\n\r\nVenta directa, al por mayor y pick-your-own."
    ],
    "nl": [
      "Producent van biologisch rood fruit en specialiteiten:\r\n-Bosbessen, aardbeien, rode bessen...\r\n-Jam, coulis, compote, siroop, fluweel, kruidenthee en honing, allemaal zelf geproduceerd.\r\n\r\nDirecte verkoop, groothandel en zelf plukken."
    ]
  },
  "rdfs:label": {
