      "rdfs:comment": {
        "de": [
          "Je nach Saison Verkauf von Erdbeeren und Weihnachtsbäumen - am Automaten 7 Tage die Woche oder auf dem Markt in Songeons am Donnerstag von 8:30 bis 12:30 Uhr"
        ],
        "en": [
          "Depending on the season, strawberry and Christmas tree sales - at the vending machine 7 days a week or at the Songeons market on Thursdays from 8:30 a.m. to 12:30 p.m"
        ],
        "it": [
          "A seconda della stagione, vendita di fragole e alberi di Natale - dai distributori automatici 7 giorni su 7 o al mercato di Songeons il giovedì dalle 8.30 alle 12.30"
        ],
        "fr": [
          "Selon la saison ventes de fraises et de sapin de Noël - au distributeur  automatique 7j/7 ou au Marché de Songeons le jeudi de 8h30 à 12h30"
        ],
        "es": [
          "Según la temporada, venta de fresas y árboles de Navidad en máquinas expendedoras los 7 días de la semana o en el mercado de Songeons los jueves de 8.30 a 12.30 h"
        ],
        "nl": [
          "Afhankelijk van het seizoen, verkoop van aardbeien en kerstbomen - uit automaten 7 dagen per week of op de markt van Songeons op donderdag van 8.30 tot 12.30 uur"
        ]
      },
