  "rdfs:comment": {
    "de": [
      "als erstes Natursportdorf der Loire bietet St-Régis-du-Coin spezielle Strecken für Trailrunning, Cani-Cross, Nordic Walking (Station Nordik Walk) + eine Trainingszone für die Trainingseinheiten.\r\nIm Dorf wurde ein Empfangsraum für Sportler eingerichtet."
    ],
    "en": [
      "st-Régis-du-Coin is the 1st Village Sport Nature in the Loire region, with trails dedicated to trail running, cani-cross, Nordic walking (Station Nordik Walk) + a training zone for workouts.\r\nA sports reception area has been set up in the village."
    ],
    "it": [
      "st-Régis-du-Coin è il 1° villaggio sportivo naturale della regione della Loira, con percorsi dedicati al trail running, al cani-cross, al nordic walking (stazione di Nordik Walk) e una zona per gli allenamenti.\r\nNel villaggio è stata allestita un'area di accoglienza sportiva."
    ],
    "fr": [
      "1er Village Sport Nature de la Loire, St-Régis-du-Coin propose des parcours dédiés au trail, cani-cross, marche nordique (Station Nordik Walk) + une training zone pour les séances d'entraînement.\r\nUne salle d'accueil des sportifs a été aménagée au village."
    ],
    "nl": [
      "st-Régis-du-Coin is het 1e natuursportdorp in de Loirestreek, met paden voor trail running, cani-cross, nordic walking (Nordik Walk station) en een trainingszone voor trainingen.\r\nIn het dorp is een sportontvangstruimte ingericht."
    ],
    "es": [
      "st-Régis-du-Coin es el 1er pueblo deportivo natural de la región del Loira, con senderos dedicados al trail running, al cani-cross, a la marcha nórdica (estación Nordik Walk) y una zona de entrenamiento para las sesiones de entrenamiento.\r\nEn el pueblo se ha instalado un área de recepción deportiva."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pôle Trail"
    ]
  },
