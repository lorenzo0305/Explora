  "rdfs:comment": {
    "de": [
      "Cruseilles und sein Espace de loisirs des Dronières bieten Ihnen die Möglichkeit, Groß und Klein einen Sport in der freien Natur zu entdecken und in diesen einzuführen: den Orientierungslauf."
    ],
    "en": [
      "Cruseilles and its Dronières Leisure Area offers you to discover and initiate young and old to a sport in the great outdoors: orienteering."
    ],
    "it": [
      "Cruseilles e il suo Espace de loisirs des Dronières vi offrono l'opportunità di scoprire e avvicinare grandi e piccini a uno sport all'aria aperta: l'orienteering."
    ],
    "fr": [
      "Cruseilles et son Espace de loisirs des Dronières vous propose de découvrir et d'initier petits et grands à un sport de pleine nature : la course d'orientation."
    ],
    "es": [
      "Cruseilles y su Espace de loisirs des Dronières le ofrecen la oportunidad de descubrir e iniciar a jóvenes y mayores en un deporte al aire libre: la orientación."
    ],
    "nl": [
      "Cruseilles en zijn Espace de loisirs des Dronières bieden u de mogelijkheid om jong en oud kennis te laten maken met een buitensport: oriëntatielopen."
    ]
  },
  "rdfs:label": {
