  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/27ef1358-8a14-3df9-9120-b1a308c1edd4",
      "dc:description": {
        "de": [
          "Kreative Geschichten\nKomm und entdecke die Welt von Barroux, dem Autor und Illustrator des Monats!\n\n\"Auf die Art von Barroux\": Hühner, Vögel, Fische... Du bist dran mit Zeichnen.\n\nBibliothek der Annonciades, Bereich Jugend und Jugendliche\nSamstag, 16. November, um 15 Uhr\nAb 5 Jahren mit einem Erwachsenen.\nKostenlos, nach Anmeldung"
        ],
        "en": [
          "Creative stories\nCome and discover the world of Barroux, this month's author-illustrator!\n\n\"In the manner of Barroux\", chickens, birds, fish... it's up to you to draw.\n\nAnnonciades Library, Youth Sector\nSaturday November 16, at 3pm\nAges 5 and up, with an adult.\nFree, with registration"
        ],
        "it": [
          "Storie creative\nVenite a scoprire il mondo di Barroux, autore e illustratore di questo mese!\n\n\"Alla maniera di Barroux\", galline, uccelli, pesci... sta a voi disegnare.\n\nBiblioteca Annonciades, Settore Giovani\nSabato 16 novembre, ore 15.00\nPer bambini dai 5 anni in su, accompagnati da un adulto.\nGratuito, previa iscrizione"
        ],
        "fr": [
          "Histoires créatives\nViens découvrir l'univers de Barroux, l'auteur-illustrateur du mois !\n\n\"A la manière de Barroux\", poules, oiseaux, poissons... à toi de dessiner.\n\nBibliothèque des Annonciades, Secteur Jeunesse-Ados\nSamedi 16 novembre, à 15h\nA partir de 5 ans avec un adulte.\nGratuit, sur inscription"
        ],
        "es": [
          "Cuentos creativos\nVen a descubrir el universo de Barroux, el autor e ilustrador de este mes\n\n\"A la manera de Barroux\", gallinas, pájaros, peces... te toca dibujar.\n\nBiblioteca Annonciades, Sector Juventud\nSábado 16 de noviembre, a las 15 h\nPara niños a partir de 5 años, acompañados de un adulto.\nGratuito, previa inscripción"
        ],
        "nl": [
          "Creatieve verhalen\nKom en ontdek de wereld van Barroux, de auteur en illustrator van deze maand!\n\n\"Op de manier van Barroux\", kippen, vogels, vissen... aan jou om te tekenen.\n\nBibliotheek Annonciades, Sector Jeugd\nZaterdag 16 november om 15.00 uur\nVoor kinderen vanaf 5 jaar, onder begeleiding van een volwassene.\nGratis, op inschrijving"
        ]
      },
