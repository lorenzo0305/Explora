  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Heritage-Orientierungslauf in Valezan-Montméry!\r\nEine Strecke für die Sportlichsten von 4 km mit 200mD+ und 11 Markierungen. Entdecken Sie diese beiden typischen Weiler des Versant du Soleil."
    ],
    "en": [
      "Welcome to the orienteering course focusing on the heritage of Valezan!-Montméry. \r\nA sporty course of 4 km and 200m elevation gain, with 11 markers.\r\nDiscover these two traditional hamlets on the Versant du Soleil."
    ],
    "it": [
      "Benvenuti sul percorso di orientamento del patrimonio Valezan-Montméry!\r\nUn percorso di 4 km con 200 mD+ e 11 marcatori per i più sportivi. Scoprite questi due borghi tipici del Versant du Soleil."
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation patrimoine de Valezan-Montméry !\r\nUn parcours pour les plus sportifs de 4km avec 200mD+ et ses 11 balises. Découvrez ces deux hameaux typiques du Versant du Soleil."
    ],
    "nl": [
      "Welkom op het oriëntatieparcours van Valezan-Montméry!\r\nEen parcours van 4 km met meer dan 200 m en 11 markeringen voor de sportievelingen. Ontdek deze twee typische gehuchten in de Versant du Soleil."
    ],
    "es": [
      "Bienvenido al recorrido de orientación del patrimonio de Valezan-Montméry\r\nUn recorrido de 4km con 200mD+ y 11 balizas para los más deportistas. Descubra estas dos aldeas típicas del Versant du Soleil."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Kulturerbe von Valezan Montméry - roter Parcours"
    ],
    "en": [
      "Orienteering course - Heritage of Valezan Montméry - red level"
    ],
    "fr": [
      "Parcours d'orientation Patrimoine de Valezan Montméry - parcours rouge"
    ],
    "nl": [
      "Valezan Montméry erfgoed oriëntatieloop - rode route"
    ]
  },
