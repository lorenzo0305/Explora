  "rdfs:comment": {
    "de": [
      "In einem traditionellen Weiler bietet Ihnen der Gaec du Mont Chauffé einen Abondance-Käse an, der auf der Landwirtschaftsmesse in Paris mehrfach ausgezeichnet wurde."
    ],
    "en": [
      "In a traditional hamlet, the Mont Chauffé Gaec propose you the Abondance cheese. Abondance chees rewarded many times at the show of agriculture of Paris."
    ],
    "it": [
      "Situato in un borgo tradizionale, il Gaec du Mont Chauffé produce un formaggio d'Abondance che ha vinto numerosi premi al Salone dell'Agricoltura di Parigi."
    ],
    "fr": [
      "Dans un hameau traditionnel, le Gaec du Mont Chauffé vous propose un fromage Abondance récompensé de nombreuses fois au salon de l'agriculture de Paris."
    ],
    "es": [
      "Situado en una aldea tradicional, el Gaec du Mont Chauffé produce un queso de Abondance que ha ganado numerosos premios en el Salón Agrícola de París."
    ],
    "nl": [
      "De Gaec du Mont Chauffé, gelegen in een traditioneel gehucht, produceert een Abondance kaas die vele prijzen heeft gewonnen op de Parijse Landbouwbeurs."
    ]
  },
