  "rdfs:comment": {
    "de": [
      "Rachel erforscht die intime Beziehung zwischen Mensch und Pflanze in einer außergewöhnlichen Umgebung, die Heilpflanzengärten und endemische Wälder miteinander verbindet. Sie wird auf Ihre Beschwerden eingehen und Sie beraten."
    ],
    "en": [
      "Rachel explores the intimate relationship between Man and Plant, in the heart of an exceptional site combining medicinal plant gardens and endemic forest. She will be able to answer your questions and advise you."
    ],
    "it": [
      "Rachel esplora l'intima relazione tra l'uomo e le piante, in un ambiente eccezionale che combina giardini di piante medicinali e foreste endemiche. Sarà in grado di rispondere alle vostre domande e consigliarvi."
    ],
    "fr": [
      "Rachel explore la relation intime entre l’Homme et le Végétal, au sein d’un site exceptionnel alliant jardins de plantes médicinales et forêt endémique, Elle saura répondre à vos maux et vous conseiller."
    ],
    "nl": [
      "Rachel verkent de intieme relatie tussen mensen en planten, in een uitzonderlijke omgeving van medicinale plantentuinen en inheems bos. Ze kan je vragen beantwoorden en advies geven."
    ],
    "es": [
      "Rachel explora la íntima relación entre el ser humano y las plantas, en un marco excepcional que combina jardines de plantas medicinales y bosques endémicos. Podrá responder a sus preguntas y aconsejarle."
    ]
  },
  "rdfs:label": {
