  "rdfs:comment": {
    "de": [
      "Mit Komödien von Lachen bis Emotionen, originellen Kreationen und Humor empfängt Sie das Rikiki, um Sie zu unterhalten, zu staunen und zu lachen. Das größte der kleinen Theater in Lyon!"
    ],
    "en": [
      "With laugh-out-loud comedies, original creations and humour, Au Rikiki welcomes you to be entertained, amazed and laughing. Lyon's biggest tiny theater !"
    ],
    "it": [
      "Con commedie piene di risate ed emozioni, creazioni originali e umorismo, Rikiki vi accoglie per farvi divertire, stupire e ridere. Il più grande teatrino di Lione!"
    ],
    "fr": [
      "Avec des comédies de rires en émotions, des créations originales, de l’humour, le Rikiki vous accueille pour vous divertir, vous émerveiller et rire. Le plus grand des petits théâtres lyonnais !"
    ],
    "nl": [
      "Met komedies vol lach en emotie, originele creaties en humor, verwelkomt Rikiki je om je te laten vermaken, verbazen en uitlachen. Het grootste kleine theater van Lyon!"
    ],
    "es": [
      "Con comedias llenas de risa y emoción, creaciones originales y humor, Rikiki le da la bienvenida para divertirle, asombrarle y hacerle reír. ¡El pequeño teatro más grande de Lyon!"
    ]
  },
