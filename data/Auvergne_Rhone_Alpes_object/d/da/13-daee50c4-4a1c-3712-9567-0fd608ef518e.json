  "rdfs:comment": {
    "de": [
      "Das Herrenhaus bietet Platz für bis zu 280 Sitzplätze. Es ist ein Ort mit romantischem Charme in einem 30 Hektar großen Park. Es hat seinen authentischen Charakter bewahrt und wird Liebhaber von alten Steinen und der Natur begeistern."
    ],
    "en": [
      "The manor house can accommodate up to 280 seated guests. It's a place of romantic charm set in 30 hectares of parkland. It has retained its authentic character and will appeal to lovers of old stones and nature."
    ],
    "it": [
      "Il maniero può ospitare fino a 280 persone sedute. È un ambiente romantico immerso in 30 ettari di parco. Ha mantenuto il suo carattere autentico e piacerà agli amanti della pietra antica e della natura."
    ],
    "fr": [
      "Le manoir peut accueillir jusqu'à 280 personnes assises. C'est un lieu au charme romantique dans un parc de 30 hectares. Il a conservé son caractère authentique et séduira les amateurs de vieilles pierres et de nature."
    ],
    "es": [
      "La casa solariega tiene capacidad para 280 invitados sentados. Es un lugar romántico situado en un parque de 30 hectáreas. Ha conservado su carácter auténtico y atraerá a los amantes de la piedra antigua y la naturaleza."
    ],
    "nl": [
      "Het landhuis biedt plaats aan 280 zittende gasten. Het is een romantische locatie in 30 hectare park. Het heeft zijn authentieke karakter behouden en zal liefhebbers van oude stenen en natuur aanspreken."
    ]
  },
