  "rdfs:comment": {
    "de": [
      "Die Ecurie du Serre bietet Ihnen im Sommer jeden Abend unter der Woche Ausritte und ab 2 Jahren Schnupperkurse oder jeden Mittwoch Einzelunterricht an."
    ],
    "en": [
      "The Ecurie du Serre offers some horse ballads every night during summer weeks and discovery sessions from 2 years old or some particular lessons every wednesday."
    ],
    "it": [
      "L'Ecurie du Serre vi propone delle apsseggiate tutte le sere della settimana in estate e delle sessioni scoperta da 2 anni o lezioni particolari ogni mercoledi."
    ],
    "fr": [
      "L'Ecurie du Serre vous propose des balades tous les soirs de semaine en été et des séances découvertes à partir de 2 ans ou des cours particuliers tous les mercredis."
    ],
    "es": [
      "Ecurie du Serre ofrece paseos todos los días laborables por la tarde en verano y sesiones de iniciación para niños a partir de 2 años, o clases particulares todos los miércoles."
    ],
    "nl": [
      "Ecurie du Serre biedt in de zomer elke doordeweekse avond ritten en introductiesessies voor kinderen vanaf 2 jaar, of elke woensdag privélessen."
    ]
  },
