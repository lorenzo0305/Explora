  "rdfs:comment": {
    "de": [
      "Lust, nach der Arbeit abzuschalten? Dann treffen Sie sich jeden Donnerstag in unserer immersiven Bar zu einer After-Work-Party der besonderen Art! Challenges und Aktivitäten mit Kollegen oder Freunden. Happy Hour von 18 Uhr bis 19.30 Uhr!"
    ],
    "en": [
      "Want to unwind after work? Join us every Thursday in our immersive bar for an after-work experience like no other! Challenges and activities for colleagues and friends. Happy Hour from 6pm to 7:30pm!"
    ],
    "it": [
      "Volete rilassarvi dopo il lavoro? Allora recatevi al nostro bar immersivo ogni giovedì per un dopo lavoro senza precedenti! Sfide e attività per colleghi e amici. Happy Hour dalle 18.00 alle 19.30!"
    ],
    "fr": [
      "Envie de décompresser après le boulot ? Rendez-vous tous les jeudis, dans notre bar immersif pour un after-work pas comme les autres ! Challenges et activités entre collègues ou entre amis. Happy Hour de 18h à 19h30 !"
    ],
    "es": [
      "¿Quiere relajarse después del trabajo? Acércate todos los jueves a nuestro bar inmersivo para vivir una experiencia afterwork sin igual Desafíos y actividades para colegas y amigos. Happy Hour de 18:00 a 19:30"
    ],
    "nl": [
      "Zin om te ontspannen na het werk? Ga dan elke donderdag naar onze meeslepende bar voor een ongeëvenaarde after-work ervaring! Uitdagingen en activiteiten voor collega's en vrienden. Happy Hour van 18.00 tot 19.30 uur!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Jeudis Happy Hour de Lumiia"
    ]
  },
