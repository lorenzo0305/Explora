  "rdfs:comment": {
    "de": [
      "Auf den Anhöhen von Riom mit ländlicher Panoramaterrasse freuen sich Sandra und Philippe mit ihrem neuen Team auf Ihren Besuch.\r\nMenu du Terroir, Vorschläge auf der Schiefertafel, Vegetarischer Teller, Froschschenkel.\r\nSchöne Weinkarte."
    ],
    "en": [
      "On the heights of Riom, with a panoramic, country-style terrace, Sandra and Philippe and their new team look forward to welcoming you.\r\nMenu du Terroir, suggestion à l'ardoise, Assiette végétarienne, Cuisses de Grenouilles.\r\nFine wine list."
    ],
    "it": [
      "Sandra e Philippe e il loro nuovo team sono lieti di accogliervi nel loro ristorante sulle alture di Riom, con una terrazza panoramica in stile country.\r\nMenù locale, suggerimenti sulla lavagna, piatto vegetariano, cosce di rana.\r\nCarta dei vini di qualità."
    ],
    "fr": [
      "Sur les hauteurs de Riom avec terrasse panoramique et champêtre, Sandra et Philippe seront heureux de vous accueillir avec leur nouvelle équipe.\r\nMenu du Terroir, suggestion à l'ardoise, Assiette végétarienne, Cuisses de Grenouilles.\r\nBelle Carte des Vins."
    ],
    "es": [
      "Sandra y Philippe y su nuevo equipo le dan la bienvenida a su restaurante en las alturas de Riom, con su terraza panorámica de estilo campestre.\r\nMenú local, sugerencias en la pizarra, plato vegetariano, ancas de rana.\r\nBuena carta de vinos."
    ],
    "nl": [
      "Sandra en Philippe en hun nieuwe team heten u van harte welkom in hun restaurant op de hoogten van Riom, met een panoramisch terras in landelijke stijl.\r\nStreekmenu, suggesties op de lei, vegetarische schotel, kikkerbilletjes.\r\nFijne wijnkaart."
    ]
  },
