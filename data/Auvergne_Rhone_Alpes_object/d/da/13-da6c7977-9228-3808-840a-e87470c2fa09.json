  "rdfs:comment": {
    "de": [
      "Seit September 2021 bietet die Gemeinde Montjoyer allen Sportlern einen Multisportplatz.\r\nAuf dieser Anlage können Fußball, Basketball und Volleyball auf einem 20X10m großen Kunstrasen mit Drahtgeflecht gespielt werden."
    ],
    "en": [
      "Since September 2021, the commune of Montjoyer has been offering all sports enthusiasts a multi-sports pitch.\r\nThis facility enables soccer, basketball and volleyball to be played on a 20X10m synthetic turf and screened area."
    ],
    "it": [
      "Da settembre 2021, il comune di Montjoyer offre a tutti gli sportivi un campo polisportivo.\r\nQuesta struttura permette di giocare a calcio, basket e pallavolo su un campo in erba sintetica di 20x10 metri."
    ],
    "fr": [
      "Depuis septembre 2021, la commune de Montjoyer propose à tous les sportifs, un terrain multisports.\r\nCette installation permet de pratiquer le foot, le basket et le volley sur une pelouse synthétique de 20X10m et grillagé."
    ],
    "nl": [
      "Sinds september 2021 biedt de gemeente Montjoyer alle sportliefhebbers een multisportterrein.\r\nOp dit veld kunnen voetbal, basketbal en volleybal gespeeld worden op een kunstgrasveld van 20x10 m."
    ],
    "es": [
      "Desde septiembre de 2021, el municipio de Montjoyer ofrece a todos los deportistas una pista polideportiva.\r\nEsta instalación permite la práctica del fútbol, el baloncesto y el voleibol en un césped sintético y apantallado de 20x10m."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terrain multisports"
    ]
  },
