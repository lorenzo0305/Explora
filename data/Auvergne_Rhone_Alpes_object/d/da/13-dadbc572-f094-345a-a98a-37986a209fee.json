  "rdfs:comment": {
    "de": [
      "Das auf dem Mont Salève in Hochsavoyen gelegene buddhistische Kloster Shedrub Choekhor Ling. von Genf wurde im September 2010 eröffnet und am 12. August 2011 vom XIV. Dalai Lama eingeweiht. Für die Öffentlichkeit von Dienstag bis Sonntag geöffnet."
    ],
    "en": [
      "Located on Mont Salève in Haute-Savoie, near Geneva, the Shedrub Choekhor Ling Buddhist monastery opened its doors in September 2010 and was inaugurated by the XIVth Dalai Lama on August 12, 2011. Open to the public from Tuesday to Sunday."
    ],
    "it": [
      "Situato sul Mont Salève in Alta Savoia, vicino a Ginevra, il monastero buddista Shedrub Choekhor Ling ha aperto le sue porte nel settembre 2010 ed è stato inaugurato dal XIV Dalai Lama il 12 agosto 2011. Aperto al pubblico dal martedì alla domenica."
    ],
    "fr": [
      "Situé sur le Mont Salève en Haute-Savoie. de Genève, le monastère​ bouddhiste Shedrub Choekhor Ling a ouvert ses portes en septembre 2010 et inauguré par le XIVème Dalaï Lama le 12 août 2011. Ouvert au public du mardi au dimanche."
    ],
    "es": [
      "Situado en el Monte Salève, en Alta Saboya, cerca de Ginebra, el monasterio budista Shedrub Choekhor Ling abrió sus puertas en septiembre de 2010 y fue inaugurado por el XIV Dalai Lama el 12 de agosto de 2011. Abierto al público de martes a domingo."
    ],
    "nl": [
      "Het boeddhistische klooster Shedrub Choekhor Ling, gelegen op de Mont Salève in de Haute-Savoie, vlakbij Genève, opende zijn deuren in september 2010 en werd op 12 augustus 2011 ingewijd door de XIVe Dalai Lama. Open voor publiek van dinsdag tot zondag."
    ]
  },
