  "rdfs:comment": {
    "de": [
      "Gute Nachrichten! Die Pokerabende in deinem My Beers Mours beginnen wieder!\r\nJeden Sonntagabend treffen wir uns zu einem geselligen Turnier mit dem Gambetta Poker Club.\r\n\r\nAlso, wer von Ihnen wird den besten Pokerschlag machen?"
    ],
    "en": [
      "Good news! POKER evenings are back in your My Beers Mours!\r\nEvery Sunday evening, join us for a friendly tournament with the Gambetta Poker Club.\r\n\r\nSo, who's going to make the best poker move?"
    ],
    "it": [
      "Buone notizie! Tornano le serate di POKER al vostro My Beers Mours!\r\nOgni domenica sera, unitevi a noi per un torneo amichevole con il Gambetta Poker Club.\r\n\r\nAllora, chi di voi si cimenterà nel poker?"
    ],
    "fr": [
      "Bonne nouvelle ! Les soirées POKER reprennent dans ton My Beers Mours!\r\nTous les dimanches soirs, rdv pour un tournoi convivial avec le Gambetta Poker Club.\r\n\r\nAlors, qui d'entre vous tentera le meilleur coup de poker ?"
    ],
    "es": [
      "¡Buenas noticias! ¡Vuelven las tardes de POKER a tu My Beers Mours!\r\nTodos los domingos por la noche, participe en un torneo amistoso con el Gambetta Poker Club.\r\n\r\n¿Quién se anima a jugar al póquer?"
    ],
    "nl": [
      "Goed nieuws! De POKER-avonden zijn terug bij My Beers Mours!\r\nDoe elke zondagavond mee aan een vriendschappelijk toernooi met de Gambetta Poker Club.\r\n\r\nDus, wie van jullie gaat pokeren?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée poker - My Beers Mours"
    ]
  },
