  "rdfs:comment": {
    "de": [
      "\"LA FACE NORD\", ein seit 25 Jahren bestehendes savoyisches Restaurant mit Bistroküche, empfängt Sie in Belle Plagne auf seinen sonnigen Terrassen direkt am Schnee.\r\nBei schlechtem Wetter sind die Terrassen überdacht. Warme und freundliche Atmosphäre, atypische Dekoration."
    ],
    "en": [
      "\"LA FACE NORD\" restaurant has been offering Savoyard speacialities and bistronomic cuisine for 25 years and is delighted to welcome you to its sunny terrace or its covered area for bad weather days, at the foot of the ski slopes. The restaurant has been fully renovated: it has a TV, a sound system, LED lighting and a new decor."
    ],
    "it": [
      "\"LA FACE NORD\" ristorante savoiardo e bistronomico da 25 anni, vi accoglie a Belle Plagne sulle sue terrazze soleggiate, coperte in caso di maltempo, sul fronte neve, completamente rinnovato, TV, impianto audio e LED, nuova decorazione."
    ],
    "fr": [
      "\"LA FACE NORD\" restaurant savoyard et Bistronomique depuis 25 Ans, vous accueille à Belle Plagne sur ses terrasses ensoleillées et couvertes en cas de mauvais temps,  en front de neige, entièrement rénovées, TV, sonorisation et LED, nouvelle décoration."
    ],
    "es": [
      "\"LA FACE NORD\" restaurante saboyano y bistronómico desde hace 25 años, le da la bienvenida a Belle Plagne en sus terrazas soleadas, cubiertas en caso de mal tiempo, en el frente de nieve, totalmente renovado, TV, sistema de sonido y LED, nueva decoración."
    ],
    "nl": [
      "\"LA FACE NORD\" Savoyaards en Bistronomisch restaurant voor 25 jaar, heet u welkom in Belle Plagne op zijn zonnige terrassen, overdekt in geval van slecht weer, op de sneeuw front, volledig gerenoveerd, TV, geluidsinstallatie en LED, nieuwe decoratie."
    ]
  },
