  "rdfs:comment": {
    "de": [
      "Bio-Schafskäse aus dem Avesnois - Verkauf auf dem Bauernhof\r\nEntdecken Sie unsere Bio-Schafskäse, die von Denis, einem Käserei-Hirten, mit Sorgfalt hergestellt werden."
    ],
    "en": [
      "Organic sheep's milk cheeses from the Avesnois region - Farm gate sales\r\nDiscover our organic ewe's milk cheeses, made with care by Denis, our shepherd-cheesemaker."
    ],
    "it": [
      "Formaggio di pecora biologico della regione dell'Avesnois - Vendita in azienda\r\nScoprite i nostri formaggi di pecora biologici, prodotti con cura da Denis, il nostro pastore di formaggi."
    ],
    "fr": [
      "Fromages de brebis bio de l'Avesnois  - Vente à la ferme\r\nDécouvrez nos fromages de brebis bio, réalisés avec soin par Denis, berger fromager."
    ],
    "es": [
      "Queso de oveja ecológico de la región de Avesnois - Venta en granja\r\nDescubra nuestros quesos ecológicos de oveja, elaborados con esmero por Denis, nuestro pastor quesero."
    ],
    "nl": [
      "Biologische schapenkaas uit de Avesnois - Verkoop op de boerderij\r\nOntdek onze biologische schapenkazen, met zorg gemaakt door Denis, onze kaasherder."
    ]
  },
  "rdfs:label": {
