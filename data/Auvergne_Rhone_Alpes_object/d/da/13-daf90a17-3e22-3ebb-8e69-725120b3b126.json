  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Félix mit ihrem romanischen Portal und den geschnitzten Kapitellen profitierte von einer Restaurierungskampagne im Inneren, die es ermöglichte, Gemälde aus dem 18."
    ],
    "en": [
      "The church of Saint-Félix, with its Romanesque portal and sculpted capitals, has benefited from an interior restoration campaign that has brought back 18th-century paintings."
    ],
    "it": [
      "La chiesa di Saint-Félix, con il suo portale romanico e i suoi capitelli scolpiti, ha beneficiato di una campagna di restauro degli interni che ha riportato alla luce dipinti del XVIII secolo."
    ],
    "fr": [
      "L'église Saint-Félix avec son portail roman et ses chapiteaux sculptés a bénéficié d'une campagne de restauration intérieur permettant de retrouver des peintures du XVIIIème siècle."
    ],
    "es": [
      "La iglesia de San Félix, con su portada románica y sus capiteles esculpidos, se ha beneficiado de una campaña de restauración interior que ha recuperado pinturas del siglo XVIII."
    ],
    "nl": [
      "De kerk Saint-Félix, met zijn Romaanse portaal en gebeeldhouwde kapitelen, heeft geprofiteerd van een restauratiecampagne waarbij schilderijen uit de 18e eeuw zijn teruggebracht."
    ]
  },
