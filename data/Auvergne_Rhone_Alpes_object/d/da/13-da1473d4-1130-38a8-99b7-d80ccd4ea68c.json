  "rdfs:comment": {
    "de": [
      "Nach einer Wanderung von etwa 1h45 Minuten haben Sie das Recht, sich zu stärken! Kalte oder warme Getränke, gefüllte Teller, Leckereien aus der Hütte."
    ],
    "en": [
      "After about 1h45 of walking, you're allowed to have something to eat!\nCold or hot drinks, platters and treats from the refuge."
    ],
    "it": [
      "Dopo una camminata di circa 1 ora e 45 minuti, è consentito mangiare qualcosa!\r\nBevande fredde o calde, piatti e prelibatezze del rifugio."
    ],
    "fr": [
      "Après 1h45 de marche environ, vous avez le droit de vous restaurer !\r\nBoissons fraîches ou boissons chaudes, des assiettes garnies, les gourmandises du refuge."
    ],
    "nl": [
      "Na ongeveer 1 uur en 45 minuten wandelen, mag je iets eten!\nKoude of warme dranken, schalen en lekkernijen van de refuge."
    ],
    "es": [
      "Después de caminar durante aproximadamente 1 hora y 45 minutos, podrá comer algo\r\nBebidas frías o calientes, platos y delicias del refugio."
    ]
  },
  "rdfs:label": {
