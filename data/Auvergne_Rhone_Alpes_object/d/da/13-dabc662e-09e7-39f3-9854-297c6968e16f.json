  "rdfs:comment": {
    "de": [
      "Odile Touillier, eine im Maison des Artistes eingetragene Malerin, bietet zahlreiche Aktivitäten an: wechselnde Ausstellungen, Malkurse und -praktika, Empfang von Künstlern und verschiedene Veranstaltungen, Lesungen..."
    ],
    "en": [
      "Odile Touillier, a painter registered with the Maison des Artistes, offers a wide range of activities: temporary exhibitions, painting courses and workshops, artist visits and events, readings..."
    ],
    "it": [
      "Odile Touillier, pittrice iscritta alla Maison des Artistes, propone un'ampia gamma di attività: mostre temporanee, corsi e laboratori di pittura, visite di artisti e vari eventi, letture, ecc."
    ],
    "fr": [
      "Odile Touillier, artiste peintre inscrite à la Maison des Artistes, propose de nombreuses activités : expositions temporaires, stages et cours de peinture, accueil d'artistes et animations diverses, lectures..."
    ],
    "es": [
      "Odile Touillier, pintora inscrita en la Maison des Artistes, ofrece un amplio abanico de actividades: exposiciones temporales, cursos y talleres de pintura, visitas de artistas y actos diversos, lecturas, etc."
    ],
    "nl": [
      "Odile Touillier, een schilderes die ingeschreven is bij het Maison des Artistes, biedt een brede waaier aan activiteiten: tijdelijke tentoonstellingen, schildercursussen en -workshops, kunstenaarsbezoeken en diverse evenementen, lezingen, enz."
    ]
  },
