  "rdfs:comment": {
    "de": [
      "Samstag, 14. März, 14.00-17.00 Uhr: Workshop über das Flechten von lebenden Weiden und die Herstellung von zwei Tontinen, die Sie in einem Topf aufbewahren oder in die Erde pflanzen können. 30?/Pers. Informationen und Anmeldungen unter 06 32 22 10 11."
    ],
    "en": [
      "Saturday March 14, 2pm to 5pm, a workshop devoted to weaving living willow into two tontines that can be kept in pots or planted in the ground. 30/person. Information and registration on 06 32 22 10 11."
    ],
    "it": [
      "Sabato 14 marzo, dalle 14.00 alle 17.00, un laboratorio dedicato all'intreccio del salice vivo in due tontine da tenere in vaso o da piantare in terra. 30/persona. Informazioni e prenotazioni al numero 06 32 22 10 11."
    ],
    "fr": [
      "Samedi 14 mars de 14h à 17h, atelier consacré au tressage du saule vivant à travers la réalisation de deux tontines que vous pourrez garder en pot ou planter en pleine terre. 30€/pers. Renseignements et inscriptions au 06 32 22 10 11."
    ],
    "nl": [
      "Zaterdag 14 maart van 14.00 tot 17.00 uur, een workshop over het weven van levende wilgentenen tot twee tontines die je in een pot kunt bewaren of in de grond kunt planten. 30/persoon. Informatie en reserveringen op 06 32 22 10 11."
    ],
    "es": [
      "Sábado 14 de marzo, de 14.00 a 17.00 horas, taller de tejido de sauce vivo en dos tontinas que podrás guardar en una maceta o plantar en el suelo. 30 ¤/persona. Información y reservas en el 06 32 22 10 11."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Architecture végétale : Atelier de vannerie en osier vivant"
    ]
  },
