  "rdfs:comment": {
    "de": [
      "Vincent Durant, der beste Handwerker Frankreichs, bietet Ihnen eine Reihe von hochwertigen Schokoladen und Süßwaren mit seinem Aindinoise-Touch an. Entdecken Sie mit diesen köstlichen Kreationen den Reichtum der Region Aindino."
    ],
    "en": [
      "Meilleur Ouvrier de France, Vincent Durant offers a range of quality chocolates with an Aindin touch. Discover the richness of the Aindin region through these gourmet creations."
    ],
    "it": [
      "Vincent Durant, Meilleur Ouvrier de France, vi propone una gamma di cioccolatini e dolciumi di qualità con un tocco Aindin. Scoprite la ricchezza della regione di Aindin attraverso queste creazioni gastronomiche."
    ],
    "fr": [
      "Meilleur Ouvrier de France, Vincent Durant vous propose une gamme de chocolats et confiseries de qualité avec sa touche Aindinoise. Découvrez la richesse du terroir aindinois à travers ces créations gourmandes."
    ],
    "es": [
      "Vincent Durant, Meilleur Ouvrier de France, le propone una gama de chocolates y confitería de calidad con un toque Aindin. Descubra la riqueza de la región de Aindin a través de estas creaciones gourmet."
    ],
    "nl": [
      "Vincent Durant, Meilleur Ouvrier de France, biedt je een assortiment kwaliteitsvolle pralines en confiserie met een Aindin-touch. Ontdek de rijkdom van de Aindin streek via deze gastronomische creaties."
    ]
  },
