  "rdfs:comment": {
    "de": [
      "Wellnessbereich: Abonnements für Privatpersonen und Unternehmen. Das ganze Jahr über Zugang zu entspannenden, energetischen, schlankmachenden und entwässernden Modellagen. Sofortige Reservierung dank eines Online-Planers."
    ],
    "en": [
      "Welness area. Offers for personal and for business use. Body and face treatments. Book on line."
    ],
    "it": [
      "Area benessere: abbonamenti per privati e aziende. Accesso a massaggi rilassanti, energizzanti, dimagranti e drenanti tutto l'anno. Prenotazione immediata grazie alla pianificazione online."
    ],
    "fr": [
      "Espace « bien-être » : abonnements pour particuliers et pour entreprises. Accès aux modelages relaxants, énergétiques, amincissants et drainants toute l’année. Réservation instantanée grâce à un planning en ligne."
    ],
    "nl": [
      "Wellnessruimte: abonnementen voor particulieren en bedrijven. Het hele jaar door toegang tot ontspannende, vitaliserende, afslankende en drainerende massages. Direct boeken dankzij online planning."
    ],
    "es": [
      "Espacio bienestar: abonos para particulares y empresas. Acceso a masajes relajantes, energizantes, adelgazantes y drenantes durante todo el año. Reserva instantánea gracias a la planificación en línea."
    ]
  },
  "rdfs:label": {
