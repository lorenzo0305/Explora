  "rdfs:comment": {
    "de": [
      "Diese Strecke befindet sich im Lignon von der Brücke Pont Terray (RD8) in Boën-sur-Lignon bis zur Schwelle von Mérizat einschließlich des Bief Giraud am linken Ufer. Obligatorische und sofortige Abgabe von Salmoniden (Forellen und Äschen). Die Angelkarte ist obligatorisch."
    ],
    "en": [
      "This course is located on the Lignon, from Terray bridge (RD8) in Boën-sur-Lignon to the Mérizat weir, including the Giraud reach on the left bank. Immediate release of salmonids (trout and grayling) is mandatory. Fishing licence required."
    ],
    "it": [
      "Questo corso si trova sul Lignon, dal ponte di Terray (RD8) a Boën-sur-Lignon fino allo sbarramento di Mérizat, compreso il tratto di Giraud sulla riva sinistra. I salmonidi (trote e temoli) devono essere rilasciati immediatamente. È richiesta la licenza di pesca."
    ],
    "fr": [
      "Ce parcours est situé sur le Lignon, du pont Terray (RD8) à Boën-sur-Lignon au seuil de Mérizat y compris le bief Giraud situé en rive gauche. Remise obligatoire et immédiate des salmonidés (truites et ombres communs). La carte de pêche est obligatoire."
    ],
    "es": [
      "Este curso se sitúa en el Lignon, desde el puente de Terray (RD8) en Boën-sur-Lignon hasta el azud de Mérizat, incluyendo el tramo de Giraud en la orilla izquierda. Los salmónidos (truchas y tímalos) deben liberarse inmediatamente. Se requiere licencia de pesca."
    ],
    "nl": [
      "Dit parcours bevindt zich op de Lignon, vanaf de brug van Terray (RD8) in Boën-sur-Lignon tot de stuw van Mérizat, inclusief de Giraud-brug op de linkeroever. Zalmvissen (forel en vlagzalm) moeten onmiddellijk worden teruggezet. Visvergunning verplicht."
    ]
  },
  "rdfs:label": {
    "de": [
      "Parcours de pêche No-Kill"
    ],
