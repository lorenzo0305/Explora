  "rdfs:comment": {
    "de": [
      "Wochenende der offenen Tür: Oliven, Dinkel, Kichererbsen, Trockenfrüchte und Feinschmeckermahlzeiten.\r\nFalafel-Suppe oder -Sandwich (6,50 ? bis 10,50 ?), süßer Crêpe (2,50 ? bis 3 ?)."
    ],
    "en": [
      "Open house weekend: olives, small spelt, chickpeas, dried fruit and gourmet meal.\r\nFalafel soup or sandwich (6.50? to 10.50?), sweet crepe (2.50? to 3?)."
    ],
    "it": [
      "Aperto nel fine settimana: olive, farro, ceci, frutta secca e pasti gourmet.\r\nZuppa di falafel o panino (da 6,50 a 10,50), crepe dolci (da 2,50 a 3)."
    ],
    "fr": [
      "Week-end portes-ouvertes : olives, petit épeautre, pois chiches, fruits secs et repas gourmand.\r\nSoupe ou sandwich falafels (6,50€ à 10,50€), crêpe sucrée (2,50€ à 3€)."
    ],
    "nl": [
      "Open weekend: olijven, spelt, kikkererwten, gedroogd fruit en gourmetmaaltijd.\r\nFalafelsoep of broodje (6,50 tot 10,50?), zoete crêpe (2,50 tot 3?)."
    ],
    "es": [
      "Fin de semana abierto: aceitunas, espelta, garbanzos, frutos secos y comida gourmet.\r\nSopa o bocadillo de falafel (de 6,50? a 10,50?), crepe dulce (de 2,50? a 3?)."
    ]
  },
