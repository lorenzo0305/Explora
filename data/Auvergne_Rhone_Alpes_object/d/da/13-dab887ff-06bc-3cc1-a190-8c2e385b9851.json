  "rdfs:comment": {
    "de": [
      "En Van Simone, das unumgängliche Vanlife- und Nomadenreise-Event der Region! Treffen Sie sich zu einem Wochenende voller Entdeckungen, Begegnungen, Austausch, Musik, Geschmack und vor allem Spaß!"
    ],
    "en": [
      "En Van Simone, the region's must-attend vanlife and nomadic travel event! Join us for a weekend of discovery, encounters, exchanges, music, taste and, above all, pleasure!"
    ],
    "it": [
      "En Van Simone, l'imperdibile evento di vanlife e viaggi nomadi della regione! Unitevi a noi per un weekend di scoperte, incontri, scambi, musica, gusto e, soprattutto, piacere!"
    ],
    "fr": [
      "En Van Simone, l'événement vanlife et voyage nomade incontournable de la région ! Rendez-vous pour un week-end de découverte, de rencontre, d'échanges, de musique, de goût et surtout de plaisir !"
    ],
    "es": [
      "En Van Simone, la cita ineludible de la región con la vida en furgoneta y los viajes nómadas Acompáñenos en un fin de semana de descubrimientos, encuentros, intercambios, música, sabores y, sobre todo, placer"
    ],
    "nl": [
      "En Van Simone, het niet te missen vanlife en nomadische reisevenement in de regio! Ga met ons mee voor een weekend vol ontdekkingen, ontmoetingen, uitwisselingen, muziek, smaak en vooral plezier!"
    ]
  },
