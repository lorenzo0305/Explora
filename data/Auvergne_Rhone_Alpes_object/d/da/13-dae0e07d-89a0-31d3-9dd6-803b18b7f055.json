  "rdfs:comment": {
    "de": [
      "Lernen Sie den Käser Fabien Picard in Montagnat kennen.\nKuh-, Ziegen- und Schafskäse, der Geschmack des Authentischen und des handwerklichen Könnens.\nErleben Sie ein einzigartiges Geschmackserlebnis!"
    ],
    "en": [
      "Come and meet Cheesemaker Fabien Picard in Montagnat.\r\nCow, goat and ewe cheeses, a taste for authenticity and traditional know-how.\r\nEnjoy a unique taste experience!"
    ],
    "it": [
      "Venite a conoscere il casaro Fabien Picard a Montagnat.\r\nFormaggi di mucca, capra e pecora, un assaggio di autenticità e di know-how tradizionale.\r\nGodetevi un'esperienza di gusto unica!"
    ],
    "fr": [
      "Venez à la rencontre du Fromager Fabien Picard à Montagnat.\r\nFromages de vache, chèvre et brebis, le goût de l'authentique et du savoir-faire artisanal.\r\nVivez une expérience gustative unique !"
    ],
    "es": [
      "Venga a conocer al quesero Fabien Picard en Montagnat.\r\nQuesos de vaca, cabra y oveja, el sabor de la autenticidad y del saber hacer tradicional.\r\nDisfrute de una experiencia gustativa única"
    ],
    "nl": [
      "Kom kennismaken met kaasmaker Fabien Picard in Montagnat.\r\nKaas van koeien-, geiten- en schapenmelk, een voorproefje van authenticiteit en traditionele knowhow.\r\nGeniet van een unieke smaakervaring!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Fromager Fabien Picard"
    ],
    "fr": [
      "Le Fromager Fabien Picard"
    ]
  },
