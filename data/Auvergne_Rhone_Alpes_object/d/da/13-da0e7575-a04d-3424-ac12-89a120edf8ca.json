  "rdfs:comment": {
    "de": [
      "Erleben Sie das Enduro 2, das internationale Mountainbike- und ATV-Rennen für Zweierteams. Die Teams werden über die Pisten des Bike Parks von Méribel fahren, bevor sie das Plateau de la Chaudanne erreichen."
    ],
    "en": [
      "Experience the thrill of Enduro 2, the international mountain bike and VTTAE race for teams of two. Teams will ride the trails of the Méribel Bike Park before reaching the Chaudanne plateau."
    ],
    "it": [
      "Venite a godervi l'Enduro 2, la gara internazionale di mountain bike e ATV a squadre di due persone. Le squadre correranno lungo i sentieri del Méribel Bike Park prima di raggiungere l'altopiano di Chaudanne."
    ],
    "fr": [
      "Venez vibrer durant l'Enduro 2, la course internationale de VTT et VTTAE par équipe de deux. Les équipes sillonneront les pistes du Bike Park de Méribel avant de rejoindre le plateau de la Chaudanne."
    ],
    "es": [
      "Venga a disfrutar del Enduro 2, la carrera internacional de BTT y ATV en equipos de dos. Los equipos correrán por los senderos del Bike Park de Méribel antes de llegar a la meseta de Chaudanne."
    ],
    "nl": [
      "Kom genieten van de Enduro 2, de internationale mountainbike- en ATV-race in teams van twee. De teams racen over de paden van het Méribel Bike Park voordat ze het plateau van Chaudanne bereiken."
    ]
  },
