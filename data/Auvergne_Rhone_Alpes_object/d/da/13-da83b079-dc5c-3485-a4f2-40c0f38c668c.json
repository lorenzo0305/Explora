  "rdfs:comment": {
    "de": [
      "Begrenzte Plätze, ca. 50 Personen: Eine Reservierung ist ratsam! Permanenz am Vormittag, von Montag bis Freitag.\r\nDie Vorstellungen am Sonntagnachmittag sind für kleine Kinder und Familien gedacht: Nutzen Sie die Gelegenheit!"
    ],
    "en": [
      "Places are limited, around 50 people: reservations are recommended! Open mornings, Monday to Friday.\r\nSunday afternoon shows are designed for young children and families: make the most of them!"
    ],
    "it": [
      "I posti sono limitati, circa 50 persone: si consiglia la prenotazione! Aperto dal lunedì al venerdì al mattino.\r\nGli spettacoli della domenica pomeriggio sono destinati ai bambini e alle famiglie: approfittatene!"
    ],
    "fr": [
      "Places limitées, environ 50 personnes : la réservation est conseillée ! Permanence de matin, du lundi au vendredi.\r\nLes spectacles du Dimanche après-midi sont destinés aux jeunes enfants et aux familles : profitez-en !"
    ],
    "es": [
      "Las plazas son limitadas, unas 50 personas: ¡se aconseja reservar! Abierto de lunes a viernes por la mañana.\r\nLos espectáculos de los domingos por la tarde están destinados a los niños pequeños y a las familias: ¡aprovéchalos!"
    ],
    "nl": [
      "De plaatsen zijn beperkt, ongeveer 50 personen: reserveren is aanbevolen! Geopend van maandag tot vrijdag.\r\nDe voorstellingen op zondagmiddag zijn gericht op jonge kinderen en gezinnen: doe er uw voordeel mee!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Culturel"
    ]
  },
