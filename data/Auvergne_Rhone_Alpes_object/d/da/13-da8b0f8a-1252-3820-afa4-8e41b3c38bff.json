  "rdfs:comment": {
    "de": [
      "Als Begleiter im Mittelgebirge würde ich mich freuen, Sie in die Tarentaise, Vanoise und Beaufortain zu begleiten, aber auch in alle anderen Bergmassive, die Sie begehren."
    ],
    "en": [
      "As a mountain guide, I am delighted to accompany you on hikes in the Tarentaise, Vanoise and Beaufortain regions, as well as any other mountain areas you would like to visit."
    ],
    "it": [
      "Come guida alpina, sarò lieta di accompagnarvi in Tarentaise, Vanoise e Beaufortain, ma anche in tutti gli altri massicci che vorrete visitare."
    ],
    "fr": [
      "Accompagnateur en moyenne montagne, je serais ravi de vous accompagner en Tarentaise, Vanoise et Beaufortain mais aussi dans tous le autres massifs qui vous font envie."
    ],
    "es": [
      "Como guía de montaña, estaré encantado de acompañarle en Tarentaise, Vanoise y Beaufortain, pero también en todos los demás macizos que desee visitar."
    ],
    "nl": [
      "Berggids in middelhoge bergen, het zou mij genoegen doen U te begeleiden in de Tarentaise, de Vanoise en de Beaufortain, maar ook in de andere massieven waar U zin in heeft."
    ]
  },
  "rdfs:label": {
