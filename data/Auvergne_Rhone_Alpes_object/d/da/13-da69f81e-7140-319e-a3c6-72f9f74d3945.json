  "rdfs:comment": {
    "de": [
      "Yannick Noah kehrt für eine intime akustische Tournee in die Oper von Vichy zurück, die von seinem Lächeln, seiner Sonnenenergie und seiner ansteckenden Freude getragen wird."
    ],
    "en": [
      "Yannick Noah returns to the Opéra de Vichy for an intimate acoustic tour, driven by his smile, his solar energy and his infectious joy."
    ],
    "it": [
      "Yannick Noah torna all'Opéra de Vichy per un tour acustico intimo, guidato dal suo sorriso, dalla sua energia solare e dalla sua gioia contagiosa."
    ],
    "fr": [
      "Yannick Noah revient à l’Opéra de Vichy pour une tournée acoustique intimiste, portée par son sourire, son énergie solaire et sa joie communicative."
    ],
    "es": [
      "Yannick Noah vuelve a la Ópera de Vichy para una gira acústica íntima, impulsado por su sonrisa, su energía solar y su alegría contagiosa."
    ],
    "nl": [
      "Yannick Noah keert terug naar de Opéra de Vichy voor een intieme akoestische tournee, gedreven door zijn glimlach, zijn zonne-energie en zijn aanstekelijke vreugde."
    ]
  },
