  "rdfs:comment": {
    "de": [
      "Ob auf Geschäftsreise, im Urlaub, für einen Moment der Entspannung oder zur Teilnahme an einer Veranstaltung, das Dahu, 5 Minuten von Roanne, 45 Minuten von St-Etienne, 1 Stunde von Lyon und Vichy, 1,5 Stunden von Clermont-Ferrand entfernt, empfängt Sie mit Einfachheit und Gastfreundschaft."
    ],
    "en": [
      "Five minutes from Roanne, in a rustic setting, discover \r\nour reception room with its 700 bygone objects and its \r\nfairground organ.  16 comfortable rooms.  Two stars.  Rooms \r\navailable for one person up to family rooms, located \r\ngarden-side.  Traditional homemade cuisine."
    ],
    "it": [
      "Che siate in viaggio d'affari, in vacanza, in relax o in occasione di un evento, Le Dahu, situato a 5 minuti da Roanne, a 45 minuti da St-Étienne, a 1 ora da Lione e Vichy e a 1h30 da Clermont-Ferrand, offre un'accoglienza semplice e cordiale."
    ],
    "fr": [
      "En voyage d'affaires, en vacances, pour un moment de détente ou participer à un évènement, le Dahu, situé à 5 min de Roanne, 45 min de St-Étienne, 1 h de Lyon et Vichy, 1h30 de Clermont-Ferrand vous accueille dans la simplicité et la convivialité."
    ],
    "es": [
      "Ya sea en viaje de negocios, de vacaciones, para relajarse o asistir a un evento, Le Dahu, situado a 5 minutos de Roanne, a 45 minutos de St-Étienne, a 1 hora de Lyon y Vichy y a 1h30 de Clermont-Ferrand, le ofrece una acogida sencilla y cordial."
    ],
    "nl": [
      "Of je nu op zakenreis bent, op vakantie, om te ontspannen of om een evenement bij te wonen, Le Dahu, gelegen op 5 minuten van Roanne, 45 minuten van St-Étienne, 1 uur van Lyon en Vichy en 1u30 van Clermont-Ferrand, biedt een eenvoudige, vriendelijke ontvangst."
    ]
  },
