  "rdfs:comment": {
    "de": [
      "Das Bistro du Champfeuillet bietet Ihnen eine ausgewogene und neu interpretierte Küche mit leichten Gourmetaromen, die in einem modernen Rahmen serviert werden. Entdecken Sie auch eine schöne Weinkarte, die zwischen Terroir und ?nologischen Überraschungen zusammengestellt ist."
    ],
    "en": [
      "The restaurant offers a balanced blend of light, gourmet flavors served in a modern setting. You'll also discover a fine wine list, composed of terroirs and oenological surprises."
    ],
    "it": [
      "Il Bistro du Champfeuillet offre un menu equilibrato di sapori leggeri e gourmet serviti in un ambiente moderno. Scoprirete anche una raffinata carta dei vini, con un mix di terroir e di sorprese tecnologiche."
    ],
    "fr": [
      "Le Bistro du Champfeuillet vous propose une cuisine équilibrée et revisitée entre saveurs gourmandes et légères servies dans un cadre moderne. Découvrez également une belle carte des vins, composée entre terroirs et surprises œnologiques."
    ],
    "es": [
      "El Bistro du Champfeuillet ofrece un menú equilibrado de sabores ligeros y gourmet servidos en un ambiente moderno. También descubrirá una excelente carta de vinos, con una mezcla de terruños y sorpresas enológicas."
    ],
    "nl": [
      "De Bistro du Champfeuillet biedt een uitgebalanceerd menu met lichte, gastronomische smaken geserveerd in een modern kader. Je ontdekt er ook een fijne wijnkaart, met een mix van terroirs en ?nologische verrassingen."
    ]
  },
