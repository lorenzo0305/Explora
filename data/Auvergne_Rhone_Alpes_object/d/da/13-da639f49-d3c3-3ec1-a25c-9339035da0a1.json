  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Gleitschirmtaufe an einem außergewöhnlichen Ort. De Cimes en Ciel mit Sitz in Passy Mont Blanc bietet Ihnen die Möglichkeit, unvergessliche Momente im Rahmen unserer unglaublichen Berge zu teilen."
    ],
    "en": [
      "Discover Baptism paragliding in an exceptional setting. Based in Passy Mont Blanc, De Cimes en Ciel offers you the chance to share unforgettable moments in the midst of our incredible mountains."
    ],
    "it": [
      "Scoprite il parapendio in un ambiente eccezionale. Con sede a Passy Mont Blanc, De Cimes en Ciel vi offre la possibilità di condividere momenti indimenticabili in mezzo alle nostre incredibili montagne."
    ],
    "fr": [
      "Découvrez le Baptême parapente dans un site d’exception. Basé à Passy Mont Blanc, De Cimes en Ciel vous propose de partager des moments inoubliables dans le cadre de nos incroyables montagnes."
    ],
    "nl": [
      "Ontdek paragliding in een uitzonderlijke omgeving. De Cimes en Ciel, gevestigd in Passy Mont Blanc, biedt je de kans om onvergetelijke momenten te delen te midden van onze ongelooflijke bergen."
    ],
    "es": [
      "Descubra el parapente en un marco excepcional. Con sede en Passy Mont Blanc, De Cimes en Ciel le ofrece la posibilidad de compartir momentos inolvidables en medio de nuestras increíbles montañas."
    ]
  },
