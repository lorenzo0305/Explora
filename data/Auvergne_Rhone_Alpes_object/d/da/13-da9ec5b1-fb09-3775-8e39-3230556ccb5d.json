  "rdfs:comment": {
    "de": [
      "50 ?uvres Street-Art durch Mornant, ein wahres Museum unter freiem Himmel.\r\nZahlreiche Street-Artists wie JACE, PEC oder Jerôme MESNAGER haben Fresken im Dorf gemalt."
    ],
    "en": [
      "50 Street-Art works across Mornant, a veritable open-air museum.\r\nMany street-artists, including JACE, PEC and Jerôme MESNAGER, have created frescoes in the village."
    ],
    "it": [
      "50 opere di Street-Art in tutta Mornant, un vero e proprio museo a cielo aperto.\r\nMolti artisti di strada, tra cui JACE, PEC e Jerôme MESNAGER, hanno realizzato affreschi nel villaggio."
    ],
    "fr": [
      "50 œuvres Street-Art à travers Mornant, un véritable musée à ciel ouvert. \r\nDe nombreux street-artistes comme JACE, PEC ou encore Jerôme MESNAGER ont réalisé des fresques dans le village."
    ],
    "es": [
      "50 obras de Street-Art en todo Mornant, un auténtico museo al aire libre.\r\nNumerosos artistas callejeros, entre ellos JACE, PEC y Jerôme MESNAGER, han creado frescos en el pueblo."
    ],
    "nl": [
      "50 Street-Art werken in Mornant, een echt openluchtmuseum.\r\nVeel straatkunstenaars, waaronder JACE, PEC en Jerôme MESNAGER, hebben fresco's gemaakt in het dorp."
    ]
  },
