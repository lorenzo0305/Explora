  "rdfs:comment": {
    "de": [
      "Irène Overney baut etwa 30 verschiedene Kräuter und Heilpflanzen an oder sammelt sie in der freien Natur."
    ],
    "en": [
      "Irène Overney grows or wild-cleans around thirty varieties of aromatic or medicinal plants, which she dries and blends to create herbal teas and culinary aromatics."
    ],
    "it": [
      "Irène Overney coltiva o raccoglie in natura una trentina di varietà di piante aromatiche o medicinali che fa essiccare per creare miscele erboristiche e culinarie."
    ],
    "fr": [
      "Irène Overney cultive ou cueille à l’état sauvage une trentaine de variétés de plantes aromatiques ou médicinales qu’elle sèche afin de les assembler pour créer des mélanges de tisanes et d’aromates culinaires."
    ],
    "nl": [
      "Irène Overney kweekt of verzamelt in het wild een dertigtal soorten aromatische of geneeskrachtige planten die zij droogt om er kruiden- en culinaire mengsels van te maken."
    ],
    "es": [
      "Irène Overney cultiva o recolecta en la naturaleza una treintena de variedades de plantas aromáticas o medicinales que seca para crear mezclas herbales y culinarias."
    ]
  },
  "rdfs:label": {
