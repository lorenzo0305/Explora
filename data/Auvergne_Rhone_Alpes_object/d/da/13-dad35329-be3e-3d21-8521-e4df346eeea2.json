  "rdfs:comment": {
    "de": [
      "L'Etage gibt es seit über 100 Jahren. Es ist das letzte Restaurant in Lyon, das sich ganz auf einer Etage befindet. Gehen Sie die zwei Etagen hinauf und entdecken Sie einen atypischen und gemütlichen Ort mit Blick auf den Place des Terreaux. Der Chefkoch Guillaume Mallet bietet eine raffinierte Gourmetküche an."
    ],
    "en": [
      "L'Etage has been around for over 100 years. It is the last restaurant in Lyon that is spread entirely over an upper floor. Climb the two floors to reach an atypical and cosy place overlooking the Place des Terreaux. The chef Guillaume Mallet provides gourmet and elegant cuisine."
    ],
    "it": [
      "L'Etage esiste da oltre 100 anni. È l'ultimo ristorante di Lione che si sviluppa su tutti i piani. Salite i 2 piani e scoprite un luogo atipico e accogliente con vista su Place des Terreaux. Lo chef Guillaume Mallet propone una cucina gourmet e raffinata."
    ],
    "fr": [
      "L’Etage existe depuis plus de 100 ans. C’est le dernier restaurant tout en étage de Lyon. Montez les 2 étages et découvrez un lieu atypique et feutré avec vue sur la place des Terreaux. Le Chef Guillaume Mallet propose une cuisine gourmande et raffinée."
    ],
    "es": [
      "L'Etage existe desde hace más de 100 años. Es el último restaurante de Lyon. Suba los 2 pisos y descubra un lugar atípico y acogedor con vistas a la Place des Terreaux. El chef Guillaume Mallet ofrece una cocina gourmet y refinada."
    ],
    "nl": [
      "L'Etage bestaat al meer dan 100 jaar. Het is het laatste restaurant in Lyon. Ga de 2 verdiepingen op en ontdek een atypische en gezellige plek met uitzicht op het Place des Terreaux. Chef Guillaume Mallet biedt een gastronomische en verfijnde keuken."
    ]
  },
