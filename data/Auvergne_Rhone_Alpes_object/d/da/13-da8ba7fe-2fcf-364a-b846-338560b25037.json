  "rdfs:comment": {
    "de": [
      "Begleitung Trekkingführer ? Unterricht in Yoga ? Globale Gesundheit durch Ayurveda, die Wissenschaft vom Leben.\r\nIndividuelle Erfahrungen in der Domaine de Courchevel und im Parc National de la Vanoise."
    ],
    "en": [
      "Trekking Guide • Yoga Lessons • Healthy and Happy through Ayurveda, the science of Life.\r\nIndividualised experiences on Courchevel and Vanoise National Park."
    ],
    "it": [
      "Guida al trekking? Corsi di yoga? Salute globale attraverso l'Ayurveda, la scienza della vita.\r\nEsperienze personalizzate nella tenuta di Courchevel e nel Parco Nazionale della Vanoise."
    ],
    "fr": [
      "Accompagnement Guide de Trekking • Cours de Yoga • Santé Globale par l'Ayurveda, la science de la Vie.\r\nExpériences individualisées sur le Domaine de Courchevel et au Parc National de la Vanoise."
    ],
    "es": [
      "Trekking, Ayurveda y Yoga en el corazón de los Alpes.\r\nSalidas en Raquetas de Nieve Guiadas. Terapias y Masajes Ayurvédicos. Clases de Yoga, Meditación y Programas Espirituales.\r\nExperiencias a medida en el dominio de Courchevel y en los alrededores del Parque Nacional de la Vanoise."
    ],
    "nl": [
      "Trekking gids ? Yoga lessen ? Wereldwijde gezondheid door Ayurveda, de wetenschap van het leven.\r\nIndividuele ervaringen op het Domein van Courchevel en in het Nationale Park Vanoise."
    ]
  },
