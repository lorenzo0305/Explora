  "rdfs:comment": {
    "de": [
      "LA ROCHE SAINT SECRET (atl 353m): Die südlichste Gemeinde des Landes, im Tal des Lez gelegen, an den Toren der Povence, besitzt La Roche St Secret-Béconne ein sehr reiches Erbe an alten Bauwerken."
    ],
    "en": [
      "LA ROCHE SAINT SECRET (atl 353m): La Roche St Secret-Béconne is the most southerly town in France, located in the Lez valley at the gateway to Povence, and boasts a rich heritage of ancient monuments."
    ],
    "it": [
      "LA ROCHE SAINT SECRET (atl 353m): Comune più meridionale del Paese, situato nella valle del fiume Lez, alle porte di Povence, La Roche St Secret-Béconne vanta un ricchissimo patrimonio di monumenti antichi."
    ],
    "fr": [
      "LA ROCHE SAINT SECRET (atl 353m) : Commune la plus au sud du pays, située dans la valllée du lez, aux Portes de la Povence, La Roche St Secret-Béconne posséde un patrimoine très riche en monuments anciens."
    ],
    "es": [
      "LA ROCHE SAINT SECRET (atl 353m): El municipio más meridional del país, situado en el valle del río Lez, a las puertas de Povence, La Roche St Secret-Béconne posee un patrimonio muy rico en monumentos antiguos."
    ],
    "nl": [
      "LA ROCHE SAINT SECRET (353 m hoogte): De meest zuidelijke gemeente van het land, gelegen in de Lez vallei aan de poort van Povence, La Roche St Secret-Béconne heeft een rijk erfgoed van oude monumenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de La Roche Saint Secret"
    ]
  },
