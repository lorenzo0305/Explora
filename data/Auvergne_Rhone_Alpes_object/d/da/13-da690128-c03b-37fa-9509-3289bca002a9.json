  "rdfs:comment": {
    "de": [
      "Monkey's wechselt den Besitzer und wird zu Bey Kebab . Es wird eine neue Speisekarte mit Kebab, Tacos, Pizzas, vor Ort oder zum Mitnehmen und 7 Tage die Woche angeboten!"
    ],
    "en": [
      "Monkey's is changing owners and becoming Bey Kebab. A new menu will be available featuring kebabs, tacos, and pizzas, available for dine-in or takeout, seven days a week !"
    ],
    "it": [
      "Monkey's cambia proprietario e diventa Bey Kebab. Il nuovo menu comprende kebab, tacos e pizze, disponibili per il consumo o l'asporto, 7 giorni su 7!"
    ],
    "fr": [
      "Monkey's change de propriétaire et devient Bey Kebab . Une nouvelle carte vous sera proposée avec kébab, tacos, pizzas, sur place ou à emporte et 7 jours sur 7 !"
    ],
    "nl": [
      "Monkey's verandert van eigenaar en wordt Bey Kebab. Het nieuwe menu bevat kebabs, taco's en pizza's, verkrijgbaar om te eten of mee te nemen, 7 dagen per week!"
    ],
    "es": [
      "Monkey's cambia de manos y se convierte en Bey Kebab . El nuevo menú incluye kebabs, tacos y pizzas, disponibles para comer o llevar, ¡los 7 días de la semana!"
    ]
  },
