  "rdfs:comment": {
    "de": [
      "La Montagne d'Ardèche empfängt Sie in einer idyllischen Umgebung inmitten der Natur. Man atmet durch, schöpft neue Kraft und teilt gemeinsam unvergessliche Momente."
    ],
    "en": [
      "La Montagne d'Ardèche welcomes you to an idyllic natural setting. Breathe, recharge and share unforgettable moments together."
    ],
    "it": [
      "La Montagne d'Ardèche vi accoglie in un ambiente naturale idilliaco. Qui potrete respirare, ricaricare le batterie e condividere momenti indimenticabili insieme."
    ],
    "fr": [
      "La Montagne d'Ardèche vous accueille dans un cadre idyllique de pleine nature. On respire, on se ressource, on partage des moments inoubliables ensemble."
    ],
    "nl": [
      "La Montagne d'Ardèche verwelkomt je in een idyllische natuurlijke omgeving. Hier kun je op adem komen, nieuwe energie opdoen en samen onvergetelijke momenten beleven."
    ],
    "es": [
      "La Montagne d'Ardèche le da la bienvenida a un entorno natural idílico. Aquí podréis respirar, recargar las pilas y compartir juntos momentos inolvidables."
    ]
  },
