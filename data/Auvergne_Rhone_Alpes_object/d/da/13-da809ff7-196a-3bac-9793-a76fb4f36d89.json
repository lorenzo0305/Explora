  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, mit zwei jungen Cowboys, die die Natur schützen, einen Ausflug in den \"Wilden Westen\" zu machen?\r\nBill und Jane warten im Buffalo Park auf Sie, um die Pisten wieder in Ordnung zu bringen."
    ],
    "en": [
      "Billy and Jane have just arrived from the Far West and are waiting for you at the Buffalo Park."
    ],
    "it": [
      "Vi piacerebbe fare un viaggio nel selvaggio West con due giovani cowboy che proteggono la natura?\r\nBill e Jane vi aspettano sul sentiero del Buffalo Park per rimettere un po' d'ordine sui binari."
    ],
    "fr": [
      "Ça vous dit de faire un tour dans le « Far West » avec deux jeunes cowboys protecteurs de la nature ?\r\nBill et Jane vous attendent sur la piste du Buffalo Park pour remettre un peu d'ordre sur les pistes."
    ],
    "es": [
      "¿Te gustaría hacer un viaje al Salvaje Oeste con dos jóvenes vaqueros protectores de la naturaleza?\r\nBill y Jane te esperan en el sendero de Buffalo Park para poner orden en las pistas."
    ],
    "nl": [
      "Wil je een reis maken naar het \"Wilde Westen\" met twee jonge cowboys die de natuur beschermen?\r\nBill en Jane wachten op je op het Buffalo Park parcours om orde op zaken te stellen."
    ]
  },
