  "rdfs:comment": {
    "de": [
      "Gerüche umgeben uns und überwältigen uns manchmal! Dieser Besuch wird diesen viel zu wenig genutzten Sinn wachrufen, der jedoch an unser intimes Gedächtnis und 1000 Emotionen appelliert."
    ],
    "en": [
      "Smells surround us and sometimes overwhelm us! This visit will awaken this under-used sense, which nevertheless appeals to our intimate memory and 1,000 emotions."
    ],
    "it": [
      "Gli odori ci circondano e a volte ci sopraffanno! La visita risveglierà questo senso sottoutilizzato, che tuttavia fa appello alla nostra memoria intima e a 1.000 emozioni."
    ],
    "fr": [
      "Les odeurs nous entourent et nous submergent parfois ! Cette visite mettra en éveil ce sens trop peu utilisé qui fait pourtant appel à notre mémoire intime et à 1000 émotions."
    ],
    "es": [
      "Los olores nos rodean y a veces nos abruman Esta visita despertará este sentido infrautilizado, que sin embargo apela a nuestra memoria íntima y a 1.000 emociones."
    ],
    "nl": [
      "Geuren omringen ons en overweldigen ons soms! Dit bezoek zal dit onderbenutte zintuig doen ontwaken, dat toch een beroep doet op ons intieme geheugen en onze 1000 emoties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite olfactive du Musée : À vue de nez"
    ]
  },
