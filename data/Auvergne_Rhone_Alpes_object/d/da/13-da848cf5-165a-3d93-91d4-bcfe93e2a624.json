  "rdfs:comment": {
    "de": [
      "Golf, 2 Parcours, 18 Löcher + 9 Löcher kompakt.Überdachter Übungsplatz für alle zugänglich. Golfy Netzwerk.Leadbetter Akademie Praktika. Unabhängiger Pro in der Vorsaison. Werkstatt für Schlägerreparaturen."
    ],
    "en": [
      "Golf, 2 courses, 18 holes + 9 compact holes, covered driving range accessible to all. Leadbetter academy training courses. Independent pro in pre-season. Club repair workshop."
    ],
    "it": [
      "Golf, 2 campi, 18 buche + 9 buche compatte, campo pratica coperto accessibile a tutti. Corsi di formazione dell'accademia Leadbetter. Professionista indipendente in pre-stagione. Officina per la riparazione dei club."
    ],
    "fr": [
      "Golf, 2 parcours, 18 trous + 9 trous compact.Practice couvert accessible à tous. Réseau Golfy.Stages académie Leadbetter. Pro indépendant en avant saison. Atelier réparation de clubs."
    ],
    "es": [
      "Golf, 2 recorridos, 18 hoyos + 9 hoyos compactos, campo de prácticas cubierto accesible a todos. Cursos de formación de la academia Leadbetter. Profesional independiente en pretemporada. Taller de reparación de palos."
    ],
    "nl": [
      "Golf, 2 banen, 18 holes + 9 compacte holes, overdekte driving range toegankelijk voor iedereen. Leadbetter academy trainingen. Onafhankelijke pro in voorseizoen. Clubreparatiewerkplaats."
    ]
  },
