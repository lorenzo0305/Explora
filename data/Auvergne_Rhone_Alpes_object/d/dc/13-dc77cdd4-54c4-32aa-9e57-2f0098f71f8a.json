  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant/unsere Bar mit IV-Lizenz. Die Küche ist komplett hausgemacht und wird von unserem Chefkoch Aurélien aus frischen Produkten zubereitet, wobei er Produkte aus kurzen Wegen bevorzugt."
    ],
    "en": [
      "Discover our restaurant/bar with licence IV. Our cuisine is entirely homemade, prepared with fresh produce by our chef Aurélien, who favors products from short distribution circuits."
    ],
    "it": [
      "Scoprite il nostro ristorante/bar con licenza IV. La cucina è interamente casalinga, preparata con prodotti freschi dal nostro chef Aurélien, che privilegia i prodotti provenienti da circuiti di distribuzione brevi."
    ],
    "fr": [
      "Découvrez notre restaurant/bar avec licence IV. La cuisine est entièrement faite maison, élaborée avec des produits frais par notre chef Aurélien, qui privilégie les produits issus de circuits courts."
    ],
    "nl": [
      "Ontdek ons restaurant/bar met vergunning IV. De keuken is volledig huisgemaakt, bereid met verse producten door onze chef Aurélien, die de voorkeur geeft aan producten uit korte distributiecircuits."
    ],
    "es": [
      "Descubra nuestro restaurante/bar con licencia IV. La cocina es totalmente casera, elaborada con productos frescos por nuestro chef Aurélien, que privilegia los productos de circuitos cortos de distribución."
    ]
  },
  "rdfs:label": {
