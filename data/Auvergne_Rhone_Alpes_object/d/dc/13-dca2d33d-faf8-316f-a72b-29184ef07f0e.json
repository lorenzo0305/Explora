  "rdfs:comment": {
    "de": [
      "Die Auberge du Pont de Costet empfängt Sie jeden Mittag von Montag bis Freitag und Sonntag sowie Freitag- und Samstagabend.\r\nVegetarische oder vegane Optionen werden angeboten! Alles wird mit lokalen, biologischen und saisonalen Produkten hausgemacht und mit Freude zubereitet!"
    ],
    "en": [
      "The Auberge du Pont de Costet welcomes you for lunch Monday to Friday and Sunday, as well as Friday and Saturday evenings.\r\nVegetarian and vegan options available! Everything is homemade with local, organic and seasonal products, and with pleasure!"
    ],
    "it": [
      "L'Auberge du Pont de Costet vi accoglie ogni giorno a pranzo dal lunedì al venerdì e la domenica, nonché il venerdì e il sabato sera.\r\nSono disponibili opzioni vegetariane o vegane! Tutto è fatto in casa con prodotti locali, biologici e di stagione, e noi lo adoriamo!"
    ],
    "fr": [
      "L'Auberge du Pont de Costet vous accueille tous les midis du lundi au vendredi et dimanche, ainsi que le vendredi et samedi soir.\r\nOptions végétariennes ou véganes proposées ! Tout est fait maison avec des produits locaux, bio et de saison et avec joie !"
    ],
    "es": [
      "El Auberge du Pont de Costet le da la bienvenida todos los mediodías de lunes a viernes y los domingos, así como los viernes y sábados por la noche.\r\nOpciones vegetarianas o veganas disponibles Todo se elabora en casa con productos locales, ecológicos y de temporada, ¡y con mucho gusto!"
    ],
    "nl": [
      "De Auberge du Pont de Costet verwelkomt je elke lunch van maandag tot vrijdag en zondag, evenals vrijdag- en zaterdagavond.\r\nVegetarische of veganistische opties beschikbaar! Alles is huisgemaakt met lokale, biologische en seizoensproducten, en daar houden we van!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge du Pont de Costet"
    ]
  },
