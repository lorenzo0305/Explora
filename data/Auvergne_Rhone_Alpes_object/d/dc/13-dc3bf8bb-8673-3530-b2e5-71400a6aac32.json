  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, mit Freunden oder der Familie etwas zu trinken? Möchten Sie tanzen oder einfach nur ein paar Stunden plaudern? Die Buvette ist der richtige Ort für Sie, denn sie bietet Themenabende und -vormittage für alle Altersgruppen."
    ],
    "en": [
      "Fancy a drink with friends or family? Dancing or just chatting for a few hours? La buvette is the place for you, with themed evenings and mornings for all ages."
    ],
    "it": [
      "Avete voglia di bere qualcosa con gli amici o la famiglia? Ballare o semplicemente chiacchierare per qualche ora? La buvette è il posto che fa per voi, con serate e mattinate a tema adatte a tutte le età."
    ],
    "fr": [
      "Envie de boire un coup entre ami ou en famille ? De danser ou simplement discuter quelques heures ? La buvette est est l’endroit qu’il vous faut avec nos soirées ou matinées à thèmes adaptées à tous les âges."
    ],
    "es": [
      "¿Le apetece tomar algo con los amigos o la familia? ¿Bailar o simplemente charlar durante unas horas? La buvette es tu lugar, con noches y mañanas temáticas para todas las edades."
    ],
    "nl": [
      "Zin in een drankje met vrienden of familie? Dansen of gewoon een paar uurtjes kletsen? La buvette is de plek voor jou, met thema-avonden en -ochtenden voor alle leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La buvette"
    ]
