  "rdfs:comment": {
    "de": [
      "Von der Lutins-Piste aus wandern Sie durch den Wald bis zu den Hochebenen von Crey du Quart.\r\nDas Ziel befindet sich im Snowpark."
    ],
    "en": [
      "From the Lutins piste, you'll make your way through the forest to the Crey du Quart plateau.\r\nThe finish is in the snowpark."
    ],
    "it": [
      "Dalla pista Lutins, si attraversa la foresta fino all'altopiano di Crey du Quart.\r\nL'arrivo è nello snowpark."
    ],
    "fr": [
      "Depuis la piste des Lutins, vous cheminerez avec passage en forêt jusque sur les plateaux du Crey du Quart.\r\nL'arrivée se situe dans le snowpark."
    ],
    "nl": [
      "Vanaf de piste Lutins baan je je een weg door het bos naar het plateau Crey du Quart.\r\nDe finish is in het snowpark."
    ],
    "es": [
      "Desde la pista de Lutins, atravesarás el bosque hasta la meseta de Crey du Quart.\r\nLa meta está en el snowpark."
    ]
  },
