  "rdfs:comment": {
    "de": [
      "In diesem Taschen-Theater mit 130 Plätzen, das über eine hervorragende Ausstattung (Projektoren, Ton, Bügel, Garderobe usw.) verfügt, finden Theater- und Gesangsaufführungen, Konzerte und Filmvorführungen statt."
    ],
    "en": [
      "This veritable 130-seat pocket theater, with its high-performance equipment (projectors, sound, hangers, dressing room, etc.), hosts theatrical and vocal performances, concerts and film screenings."
    ],
    "it": [
      "Questo teatro tascabile da 130 posti, dotato di attrezzature all'avanguardia (proiettori, impianto audio, appendiabiti, camerini, ecc.), ospita una vasta gamma di spettacoli teatrali e canori, concerti e proiezioni cinematografiche."
    ],
    "fr": [
      "Ce véritable théâtre de poche de 130 places, qui dispose d’un équipement performant (projecteurs, son, cintres, loge, etc…), voit défiler spectacles de théâtre et de chant, concerts et séance de cinéma."
    ],
    "es": [
      "Este teatro de bolsillo con capacidad para 130 espectadores, dotado de los equipos más modernos (proyectores, sistema de sonido, perchas, camerino, etc.), acoge una amplia gama de espectáculos de teatro y canto, conciertos y proyecciones de películas."
    ],
    "nl": [
      "Dit zaktheater met 130 zitplaatsen en ultramoderne uitrusting (projectoren, geluidsinstallatie, kleerhangers, kleedkamer, enz.) biedt onderdak aan een breed scala aan theater- en zangvoorstellingen, concerten en filmvertoningen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre des Masques"
    ]
  },
