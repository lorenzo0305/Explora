  "rdfs:comment": {
    "de": [
      "Raffinierte Küche, savoyardische Spezialitäten. Mittagstisch (Winterferien). Herzliche Atmosphäre. Am Parkplatz der Seilbahnen."
    ],
    "en": [
      "Elaborated cuisine, Savoyard specialities. Snack on lunchtime. Warm surroundings. Located on the cable car parking lot."
    ],
    "it": [
      "Cucina raffinata, specialità savoiarde. Snack bar a pranzo (vacanze scolastiche invernali). Impostazione calda. Sul parcheggio delle funivie."
    ],
    "fr": [
      "Restauration raffinée, spécialités savoyardes. Snack le midi (vacances scolaires hiver). Cadre chaleureux. Sur le parking des télécabines."
    ],
    "nl": [
      "Fine dining, Savoyaardse specialiteiten. Snackbar tijdens de lunch (winterse schoolvakanties). Warme instelling. Op de parkeerplaats van de kabelbanen."
    ],
    "es": [
      "Cena de lujo, especialidades saboyanas. Merienda a la hora de comer (vacaciones escolares de invierno). Ajuste cálido. En el aparcamiento de los teleféricos."
    ]
  },
