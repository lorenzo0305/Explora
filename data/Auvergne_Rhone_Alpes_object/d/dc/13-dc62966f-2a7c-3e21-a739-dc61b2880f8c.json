          "additionalInformation": {
            "de": [
              "Am Montagabend geschlossen.\r\nIn der Hochsaison 7/7 mittags und 6/7 abends geöffnet (außer montags).\r\nAnsonsten abends (außer montags) und am Wochenende geöffnet."
            ],
            "en": [
              "Closed Monday evening.\r\nIn high season open 7/7 for lunch and 6/7 for dinner (except Mondays).\r\nOtherwise open evenings (except Mondays) and weekends."
            ],
            "it": [
              "Chiuso il lunedì sera.\r\nIn alta stagione aperto 7/7 a pranzo e 6/7 a cena (tranne il lunedì).\r\nAltrimenti aperto la sera (tranne il lunedì) e nei fine settimana."
            ],
            "fr": [
              "Fermé le lundi soir.\r\nEn haute saison ouvert 7/7 midi et 6/7 soir (sauf lundi).\r\nSinon ouvert soir (sauf lundi) et week-end."
            ],
            "nl": [
              "Gesloten op maandagavond.\r\nIn het hoogseizoen 7/7 geopend voor lunch en 6/7 voor diner (behalve maandag).\r\nAnders 's avonds (behalve maandag) en in het weekend geopend."
            ],
            "es": [
              "Cerrado los lunes por la noche.\r\nEn temporada alta, abierto 7/7 para el almuerzo y 6/7 para la cena (excepto los lunes).\r\nPor lo demás, abierto por las noches (excepto los lunes) y los fines de semana."
            ]
          },
