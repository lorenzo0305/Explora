  "rdfs:comment": {
    "de": [
      "Der Mont Chauffé bildet einen langen Rücken, der sich geradlinig über fast 3 Kilometer erstreckt. In mehreren Sektoren und auf Kalksteinfelsen gibt es 168 Routen von 4?b bis 8?a?und von 20 bis 450 Metern. Die Südwand ist die am besten zugängliche Route."
    ],
    "en": [
      "The Mont Chauffé forms a long spine that extends in a straight line for almost 3 kilometres. In several sectors and on limestone rock, there are 168 routes ranging from 4b to 8a and from 20 to 450 metres.  The south face is the most accessible."
    ],
    "it": [
      "Il Mont Chauffé forma una lunga spina dorsale che si estende in linea retta per quasi 3 chilometri. In diversi settori e su roccia calcarea, ci sono 168 vie che vanno dal 4?b all'8?a e da 20 a 450 metri. La parete sud è la più accessibile."
    ],
    "fr": [
      "Le Mont Chauffé forme une longue échine qui s’étend de manière rectiligne sur près de 3 kilomètres. Sur plusieurs secteurs et sur un rocher calcaire, ce sont  168 voies allant de 4 b à 8 a et de 20 à 450 mètres. La face sud est la plus accessible."
    ],
    "es": [
      "El Mont Chauffé forma una larga espina dorsal que se extiende en línea recta durante casi 3 kilómetros. En varios sectores y sobre roca caliza, hay 168 rutas que van de 4?b a 8?a?y de 20 a 450 metros. La cara sur es la más accesible."
    ],
    "nl": [
      "De Mont Chauffé vormt een lange ruggengraat die zich in een rechte lijn over bijna 3 kilometer uitstrekt. Over verschillende sectoren en op kalksteenrotsen zijn er 168 routes variërend van 4 b tot 8 a en van 20 tot 450 meter. De zuidwand is het meest toegankelijk."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing site - Le Mont Chauffé"
    ],
    "fr": [
      "Site d'escalade - Le Mont Chauffé"
    ],
    "nl": [
      "Klimlocatie - Mont Chauffé"
    ]
  },
