  "rdfs:comment": {
    "de": [
      "3 ha großes Weingut, das 2016 gegründet wurde. Biodynamischer Weinberg, der seit 2019 mit dem Demeter-Label ausgezeichnet ist. Die Weine, Rosé- und Rotweine aus Gamay-Trauben, werden natürlich vinifiziert."
    ],
    "en": [
      "3 ha estate created in 2016. Biodynamic vineyard with Demeter label since 2019. The wines, rosés and reds made from Gamay grapes, are vinified naturally."
    ],
    "it": [
      "Tenuta di 3 ettari creata nel 2016. Vigneto biodinamico con etichetta Demeter dal 2019. I vini, rosati e rossi da uve Gamay, sono vinificati naturalmente."
    ],
    "fr": [
      "Domaine de 3 ha créé en 2016. Vignoble en biodynamie labellisé Demeter depuis 2019. Les vins, rosés et rouges issus de Gamay, sont vinifiés naturellement."
    ],
    "es": [
      "Finca de 3 ha creada en 2016. Viñedo biodinámico con etiqueta Demeter desde 2019. Los vinos, rosados y tintos de uva Gamay, se vinifican de forma natural."
    ],
    "nl": [
      "3 ha groot landgoed gecreëerd in 2016. Biodynamische wijngaard met Demeter-label sinds 2019. De wijnen, rosés en rode wijnen van Gamay-druiven, worden op natuurlijke wijze gevinifieerd."
    ]
  },
