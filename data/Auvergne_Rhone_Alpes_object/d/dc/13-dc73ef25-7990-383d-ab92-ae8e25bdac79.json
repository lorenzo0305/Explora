  "rdfs:comment": {
    "de": [
      "Regionale Küche mit sowohl auvergnatischen als auch mediterranen Aromen, die aus frischen, lokalen und saisonalen Produkten zubereitet wird. Bistrot de Pays in einem Dorfhaus, am Rande des Jakobswegs (GR65) und in der Nähe des GR7"
    ],
    "en": [
      "Local cuisine with Auvergne and Mediterranean flavors, made from fresh, local and seasonal products. Bistrot de Pays located in a village house, on the edge of the road to Santiago de Compostela (GR65) and near the GR7"
    ],
    "it": [
      "Cucina locale dai sapori sia alvernesi che mediterranei, a base di prodotti freschi, locali e di stagione. Bistrot de Pays situato in una casa di paese, ai margini del sentiero St-Jacques de Compostelle (GR65) e vicino al GR7"
    ],
    "fr": [
      "Cuisine de terroir aux saveurs aussi bien auvergnates que méditerranéennes, réalisée à partir de produits frais, locaux et de saisons. Bistrot de Pays situé dans une maison de village, au bord du chemin de St-Jacques de Compostelle (GR65) et proche du GR7"
    ],
    "nl": [
      "Lokale keuken met zowel Auvergne als mediterrane smaken, gemaakt van verse, lokale en seizoensgebonden producten. Bistrot de Pays gelegen in een dorpshuis, aan de rand van het St-Jacques de Compostelle pad (GR65) en dicht bij de GR7"
    ],
    "es": [
      "Cocina local con sabores tanto auverneses como mediterráneos, elaborada con productos frescos, locales y de temporada. Bistrot de Pays situado en una casa de pueblo, al borde del sendero St-Jacques de Compostelle (GR65) y cerca del GR7"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot la Riboule"
    ]
  },
