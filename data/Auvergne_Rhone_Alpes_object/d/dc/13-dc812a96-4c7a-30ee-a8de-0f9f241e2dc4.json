  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in der gemütlichen Atmosphäre unseres Clubhauses oder auf unserer schattigen Terrasse mit Blick auf unseren Golfplatz. Essensanimationen jeden Freitag- und Samstagabend. Private Treffen für Gruppen in der Woche mittags und am Abend."
    ],
    "en": [
      "\"Welcome to our warm and friendly club house, or the shady terrace overlooking our golf course.\r\nMeals with entertainment every Friday and Saturday evening.\r\nPrivate lunches and dinners for groups on weekdays.\""
    ],
    "it": [
      "Vi accogliamo nella calda atmosfera della nostra clubhouse o sulla nostra terrazza ombreggiata con vista sul campo.\r\nRiunioni private per gruppi all'ora di pranzo e la sera durante la settimana."
    ],
    "fr": [
      "Nous vous accueillons dans l'ambiance chaleureuse de notre club-house, ou sur notre terrasse ombragée avec vue sur notre parcours.\r\nRéunions privées pour des groupes en semaine midi et soir."
    ],
    "nl": [
      "We verwelkomen je in de warme sfeer van ons clubhuis of op ons schaduwrijke terras met uitzicht op onze golfbaan.\r\nPrivébijeenkomsten voor groepen 's middags en 's avonds tijdens de week."
    ],
    "es": [
      "Le damos la bienvenida en el cálido ambiente de nuestra casa club, o en nuestra sombreada terraza con vistas a nuestro campo.\r\nReuniones privadas para grupos al mediodía y por la tarde durante la semana."
    ]
  },
