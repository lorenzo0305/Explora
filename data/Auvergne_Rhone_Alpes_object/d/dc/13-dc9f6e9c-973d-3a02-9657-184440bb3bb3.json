  "rdfs:comment": {
    "de": [
      "Das Espace Aragon verfügt über ein Kino mit Dolby-Digital-Sound, Großbildschirmen und digitalem Projektionsmaterial, das insbesondere die Möglichkeit eröffnet, Filme in 3D zu zeigen. Das Kino bietet ein vielfältiges und qualitativ hochwertiges Programm."
    ],
    "en": [
      "The Espace Aragon has a cinema with digital Dolby sound, giant screens and digital projection equipment, including the possibility of showing films in 3D. The cinema offers a varied, high-quality programme."
    ],
    "it": [
      "L'Espace Aragon è dotato di una sala cinematografica con audio digitale Dolby, schermi giganti e attrezzature per la proiezione digitale, compresa la possibilità di proiettare film in 3D. Il cinema offre un programma vario e di alta qualità."
    ],
    "fr": [
      "L'espace Aragon est équipé d'un cinéma avec son dolby numérique, écrans géants et de matériel de projection numérique ouvrant notamment la possibilité de diffusion de films en 3D. Le cinéma propose une programmation diversifiée et de qualité."
    ],
    "es": [
      "El Espace Aragon dispone de una sala de cine con sonido Dolby digital, pantallas gigantes y equipo de proyección digital, incluida la posibilidad de proyectar películas en 3D. El cine ofrece una programación diversa y de gran calidad."
    ],
    "nl": [
      "De Espace Aragon heeft een bioscoop met digitaal Dolby-geluid, gigantische schermen en digitale projectieapparatuur, inclusief de mogelijkheid om films in 3D te vertonen. De bioscoop biedt een gevarieerd programma van hoge kwaliteit."
    ]
  },
