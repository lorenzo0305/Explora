  "rdfs:comment": {
    "de": [
      "Mittags und abends zum Mitnehmen, mittags kann man auch vor Ort essen. Spezialitäten: Pizzas (große und kleine), Lasagne, Tartiflette, Moussaka und Salate. Burger zu 100 % frisch.\r\nLieferung nach Hause"
    ],
    "en": [
      "To take away for lunch and dinner, possibility to eat on the spot for lunch. Specialities: pizzas (large and small), lasagnes, tartiflette, moussaka and salads. Burger 100% fresh.\r\nHome delivery"
    ],
    "it": [
      "Possibilità di mangiare al ristorante a pranzo e alla sera. Specialità: pizze (grandi e piccole), lasagne, tartiflette, moussaka e insalate. Hamburger 100% freschi.\r\nConsegna a domicilio"
    ],
    "fr": [
      "A emporter le midi et le soir ,possibilité de manger sur place le midi. Spécialités : pizzas (grandes et petites), lasagnes, tartiflette, moussaka et salades. Burger 100% frais.\r\nLivraison à domicile"
    ],
    "es": [
      "Comida para llevar a la hora de comer y por la noche, posibilidad de comer en el restaurante a la hora de comer. Especialidades: pizzas (grandes y pequeñas), lasaña, tartiflette, moussaka y ensaladas. Hamburguesa 100% fresca.\r\nEntrega a domicilio"
    ],
    "nl": [
      "Afhaalmaaltijden 's middags en 's avonds, mogelijkheid om 's middags in het restaurant te eten. Specialiteiten: pizza's (groot en klein), lasagne, tartiflette, moussaka en salades. Burger 100% vers.\r\nThuisbezorging"
    ]
  },
  "rdfs:label": {
