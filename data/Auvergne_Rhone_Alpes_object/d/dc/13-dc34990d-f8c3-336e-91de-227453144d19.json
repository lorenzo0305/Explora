  "rdfs:comment": {
    "de": [
      "Schattige Terrasse nicht weit vom Pool entfernt. In der Hochsaison können Sie in La Spatule den ganzen Tag lang essen. Vom Frühstück über das Mittagessen bis hin zum Abendessen und den Leckereien am Nachmittag wird La Spatule allen gerecht."
    ],
    "en": [
      "Shaded terrace not far from the swimming pool, you can eat at La Spatule, all day long during the high season. From breakfast to dinner, including lunch and afternoon delicacies, la Spatule is suitable for everyone."
    ],
    "it": [
      "Con una terrazza ombreggiata non lontana dalla piscina, in alta stagione è possibile mangiare a La Spatule tutto il giorno. Dalla colazione alla cena, dal pranzo alle delizie pomeridiane, La Spatule ha qualcosa per tutti i gusti."
    ],
    "fr": [
      "Terrasse ombragée non loin de la piscine, vous pourrez vous restaurer à la Spatule, toute la journée pendant la haute saison. Du petit-déjeuner au diner en passant par le déjeuner et les gourmandises de l’après-midi, la Spatule conviendra à tous."
    ],
    "es": [
      "Una terraza a la sombra, no muy lejos de la piscina, donde se puede comer en La Spatule durante todo el día en temporada alta. Desde el desayuno hasta la cena, pasando por el almuerzo y las meriendas, La Spatule es apta para todos los públicos."
    ],
    "nl": [
      "Op een schaduwrijk terras niet ver van het zwembad kunt u in het hoogseizoen de hele dag door bij La Spatule eten. Van ontbijt tot diner, tot lunch en middaglekkernijen, La Spatule is geschikt voor iedereen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant-snack La Spatule"
    ]
  },
