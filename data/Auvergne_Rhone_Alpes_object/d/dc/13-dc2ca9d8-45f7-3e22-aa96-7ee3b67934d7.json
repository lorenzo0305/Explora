  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren Pumptrack aus Erde. Ein Rundkurs mit Buckeln und Steilkurven. Der ideale Ort, um zu lernen und Fortschritte zu machen!"
    ],
    "en": [
      "Come and discover our dirt pumptrack. A looped course with bumps and banked turns. The perfect place to learn and improve!"
    ],
    "it": [
      "Venite a scoprire la nostra pista sterrata. Un percorso ad anello con dossi e curve strette. Il luogo perfetto per imparare e migliorare!"
    ],
    "fr": [
      "Venez découvrir notre pumptrack en terre. Un parcours en boucle avec des bosses et des virages relevés. L'endroit idéal pour apprendre et progresser !"
    ],
    "es": [
      "Venga a descubrir nuestra pista de tierra. Un circuito sinuoso con baches y curvas cerradas. El lugar perfecto para aprender y mejorar"
    ],
    "nl": [
      "Kom en ontdek onze pumptrack van aarde. Een parcours in een lus met hobbels en verhoogde bochten. De ideale plek om te leren en vooruit te gaan!"
    ]
  },
