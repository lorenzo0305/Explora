  "rdfs:comment": {
    "de": [
      "Dieser Familienpfad besteht aus zwei Teilen. Sie werden sich auf beiden Seiten des Lignon bewegen, hauptsächlich unter Bäumen, begleitet vom Rauschen des Flusses."
    ],
    "en": [
      "This family trail is in two parts. You'll hike on either side of the Lignon, mainly crossing under the trees, accompanied by the murmur of the river."
    ],
    "it": [
      "Questo percorso per famiglie è suddiviso in due parti. Si cammina su entrambi i lati del Lignon, attraversando principalmente sotto gli alberi, accompagnati dal mormorio del fiume."
    ],
    "fr": [
      "Ce parcours familial se compose de deux parties. Vous évoluerez de part et d’autre du Lignon, principalement en traversée sous les arbres, accompagné par le murmure de la rivière."
    ],
    "es": [
      "Este sendero familiar consta de dos partes. Caminará a ambos lados del Lignon, cruzando principalmente bajo los árboles, acompañado por el murmullo del río."
    ],
    "nl": [
      "Dit familiepad bestaat uit twee delen. Je wandelt aan weerszijden van de Lignon, voornamelijk onder de bomen, begeleid door het ruisen van de rivier."
    ]
  },
