  "rdfs:comment": {
    "de": [
      "Die heutige Kirche wurde 1878 im neugotischen Stil des späten 19. Jahrhunderts erbaut und ersetzte die alte, zu klein gewordene Kirche."
    ],
    "en": [
      "Built in 1878 in the neo-Gothic style of the late 19th century, the current church replaced the previous one, which had become too small."
    ],
    "it": [
      "Costruita nel 1878 nello stile neogotico della fine del XIX secolo, l'attuale chiesa fu costruita per sostituire quella vecchia, divenuta troppo piccola."
    ],
    "fr": [
      "Construite en 1878, de style néogothique de la fin du XIXe siècle, l'église actuelle a été construite en remplacement de l'ancienne devenue trop petite."
    ],
    "nl": [
      "De huidige kerk werd gebouwd in 1878 in de neogotische stijl van de late 19e eeuw om de oude kerk te vervangen, die te klein was geworden."
    ],
    "es": [
      "Construida en 1878 en estilo neogótico de finales del siglo XIX, la iglesia actual se levantó para sustituir a la antigua, que se había quedado pequeña."
    ]
  },
