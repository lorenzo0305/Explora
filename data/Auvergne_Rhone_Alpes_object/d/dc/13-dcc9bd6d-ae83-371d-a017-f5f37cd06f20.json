  "rdfs:comment": {
    "de": [
      "Kochkurs mit Chefkoch Gilles Roux: Kreieren Sie ein köstliches vegetarisches Menü! Lernen Sie von 15:00 bis 18:30 Uhr seine Tricks und genießen Sie einen geselligen Moment. 60? mit 2 Portionen zum Mitnehmen. Begrenzte Anzahl an Plätzen. Reservierung: 04 71 66 86 66."
    ],
    "en": [
      "Cooking classes with Chef Gilles Roux: create a delicious vegetarian menu! From 3 pm to 6:30 pm, learn his tricks and enjoy a convivial moment. 60? with 2 portions to take away. Places limited. Reservations: 04 71 66 86 66."
    ],
    "it": [
      "Corsi di cucina con lo chef Gilles Roux: create un delizioso menu vegetariano! Dalle 15.00 alle 18.30, imparate i suoi trucchi e gustate un pasto conviviale. 60? con 2 porzioni da portare via. Posti limitati. Prenotazioni: 04 71 66 86 66."
    ],
    "fr": [
      "Cours de cuisine avec le Chef Gilles Roux : créez un délicieux menu végétarien ! De 15h à 18h30, apprenez ses astuces et savourez un moment convivial. 60€ avec 2 portions à emporter. Places limitées. Réservation : 04 71 66 86 66."
    ],
    "nl": [
      "Kooklessen met chef-kok Gilles Roux: stel een heerlijk vegetarisch menu samen! Leer van 15.00 tot 18.30 uur zijn kneepjes en geniet van een gezellige maaltijd. 60? met 2 porties om mee te nemen. Beperkt aantal plaatsen. Reserveren: 04 71 66 86 66."
    ],
    "es": [
      "Clases de cocina con el Chef Gilles Roux: ¡crea un delicioso menú vegetariano! De 15:00 a 18:30, aprenda sus trucos y disfrute de una comida de convivencia. 60? con 2 raciones para llevar. Plazas limitadas. Reservas: 04 71 66 86 66."
    ]
  },
