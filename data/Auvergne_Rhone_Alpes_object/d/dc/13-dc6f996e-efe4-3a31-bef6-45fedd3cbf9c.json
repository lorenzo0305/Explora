  "rdfs:comment": {
    "de": [
      "Die Champier-Bibliothek bietet ein breites Spektrum an Lesestoff, das von Krimis und Comics bis hin zu eher literarischen, philosophischen oder praktischen Werken reicht."
    ],
    "en": [
      "Champier's library offers a wide range of reading material, from thrillers to comic books, as well as more literary, philosophical and practical works."
    ],
    "it": [
      "La biblioteca Champier offre un'ampia gamma di letture, dai thriller ai fumetti, oltre a opere più letterarie, filosofiche e pratiche."
    ],
    "fr": [
      "La bibliothèque de Champier offre un éventail de lecture allant tant du polar à la B.D. qu'à des oeuvres plus littéraires, philosophiques ou pratiques."
    ],
    "es": [
      "La biblioteca Champier ofrece una amplia gama de material de lectura, desde thrillers hasta cómics, así como obras más literarias, filosóficas y prácticas."
    ],
    "nl": [
      "De bibliotheek van Champier biedt een breed scala aan lectuur, van thrillers tot strips, maar ook meer literaire, filosofische en praktische werken."
    ]
