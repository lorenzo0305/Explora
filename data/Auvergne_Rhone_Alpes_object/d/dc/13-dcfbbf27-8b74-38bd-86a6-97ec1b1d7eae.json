  "rdfs:comment": {
    "de": [
      "OP Fishing - Angelführer für das Cantal sowie die angrenzenden Departements.\r\n\r\nOP Fishing bietet Angelausflüge an, die von einem diplomierten Lehrer begleitet werden und für alle zugänglich sind: Kinder, Erwachsene, Anfänger oder erfahrene Angler."
    ],
    "en": [
      "OP Fishing - Fishing guide in the Cantal and neighbouring departments.\r\n\r\nOP Fishing offers fishing trips supervised by a qualified instructor, accessible to all: children, adults, beginners or experienced anglers."
    ],
    "it": [
      "OP Fishing - Guida di pesca nel Cantal e nei dipartimenti limitrofi.\r\n\r\nOP Fishing offre battute di pesca sotto la supervisione di un istruttore qualificato, accessibili a tutti: bambini, adulti, principianti o pescatori esperti."
    ],
    "fr": [
      "OP Fishing - Guide de pêche dans le Cantal ainsi que ses départements limitrophes.\r\n\r\nOP Fishing propose des sorties de pêche encadrées par un moniteur diplômé, accessibles à tous : enfants, adultes, débutants ou pêcheurs confirmés."
    ],
    "nl": [
      "OP Fishing - Visgids in de Cantal en aangrenzende departementen.\r\n\r\nOP Fishing biedt vistrips onder begeleiding van een gediplomeerde instructeur, toegankelijk voor iedereen: kinderen, volwassenen, beginners of ervaren vissers."
    ],
    "es": [
      "OP Fishing - Guía de pesca en Cantal y departamentos limítrofes.\r\n\r\nOP Fishing ofrece salidas de pesca supervisadas por un instructor cualificado, accesibles a todos: niños, adultos, principiantes o pescadores experimentados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "OP Fishing - Guide de pêche"
    ]
  },
