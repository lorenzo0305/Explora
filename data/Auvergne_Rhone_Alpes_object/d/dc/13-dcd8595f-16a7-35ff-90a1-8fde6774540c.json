  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte des Turms, der seit dem Mittelalter das Wahrzeichen von Romans ist! Nacheinander war er Stadttor, Gefängnis und schließlich öffentliche Uhr mit seinem berühmten Automaten: dem Jacquemart-Männchen."
    ],
    "en": [
      "Come and discover the history of the Tower, the emblem of Romans since the Middle Ages! Successively city gate, prison and public clock with its famous automaton: the bonhomme Jacquemart."
    ],
    "it": [
      "Venite a scoprire la storia della Torre, emblema dei romani fin dal Medioevo! Fu prima porta della città, poi prigione e infine orologio pubblico con il suo famoso automa, il bonhomme Jacquemart."
    ],
    "fr": [
      "Venez découvrir l’histoire de la Tour, emblème de Romans depuis le Moyen Âge ! Successivement porte de la ville, prison puis horloge publique avec son célèbre automate : le bonhomme Jacquemart."
    ],
    "es": [
      "Venga a descubrir la historia de la Torre, emblema de los romanos desde la Edad Media Primero fue puerta de la ciudad, luego prisión y finalmente reloj público con su famoso autómata, el bonhomme Jacquemart."
    ],
    "nl": [
      "Kom en ontdek de geschiedenis van de Toren, het embleem van de Romeinen sinds de Middeleeuwen! Het was eerst een stadspoort, toen een gevangenis en uiteindelijk een openbare klok met zijn beroemde automaat, de bonhomme Jacquemart."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée de la Tour Jacquemart"
    ]
  },
