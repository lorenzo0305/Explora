  "rdfs:comment": {
    "de": [
      "Als italienischer Foodtruck bieten wir süße und herzhafte Pizzen an, die über Holzfeuer gebacken werden. Unser Teig ist handgeknetet und lang gereift und besteht aus lokalen und saisonalen Produkten. ."
    ],
    "en": [
      "An Italian foodtruck, we offer sweet and savory pizzas cooked over a wood-fired oven. Our dough is hand-kneaded and long-ripened, using local, seasonal produce ."
    ],
    "it": [
      "Un foodtruck italiano che offre pizze dolci e salate cotte a legna. La nostra pasta è impastata a mano e lasciata maturare a lungo, utilizzando prodotti locali e di stagione."
    ],
    "fr": [
      "Foodtruck italien, nous proposons des pizzas salées et sucrées, cuites au feu de bois. Notre pâte est pétrie à la main et à maturation longue avec des produits locaux et de saison. ."
    ],
    "es": [
      "Un foodtruck italiano que ofrece pizzas dulces y saladas cocinadas a la leña. Nuestra masa se amasa a mano y se deja madurar durante mucho tiempo, utilizando productos locales y de temporada ."
    ],
    "nl": [
      "Een Italiaanse foodtruck met zoete en hartige pizza's op houtvuur. Ons deeg wordt met de hand gekneed en laat het lang rijpen, met gebruik van lokale, seizoensgebonden producten."
    ]
  },
  "rdfs:label": {
    "it": [
      "Pepizzella - Camion delle pizze"
    ],
    "fr": [
      "Pepizzella - Pizzas Food truck"
    ]
  },
