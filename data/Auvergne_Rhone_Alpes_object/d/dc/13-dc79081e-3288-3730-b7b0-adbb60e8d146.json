  "rdfs:comment": {
    "de": [
      "Als Produzenten von roten Früchten, Erdbeeren, Himbeeren, Brombeeren, schwarzen Johannisbeeren und Imkern verarbeiten wir unsere Ernte zu Konfitüren, Sirupen, Coulis, Keksen und Nougat. Frisches Obst ist in der Saison erhältlich."
    ],
    "en": [
      "Producers of red fruits, strawberries, raspberries, blackberries, blackcurrants, redcurrants, and beekeepers, we transform our harvests into jams, syrups, coulis, cookies and nougat. Fresh fruit available in season."
    ],
    "it": [
      "Come produttori di frutti rossi, fragole, lamponi, more, ribes e ribes rosso, e apicoltori, trasformiamo i nostri raccolti in marmellate, sciroppi, coulis, biscotti e torroni. Frutta fresca disponibile in stagione."
    ],
    "fr": [
      "Producteurs de fruits rouges, fraises, framboises, mûres, cassis, groseilles, et apiculteurs, nous transformons nos récoltes en confitures, sirops, coulis, biscuits, nougat. Fruits frais disponibles en saison."
    ],
    "es": [
      "Como productores de frutos rojos, fresas, frambuesas, moras, grosellas negras y rojas, y apicultores, transformamos nuestras cosechas en mermeladas, siropes, coulis, galletas y turrones. Fruta fresca disponible en temporada."
    ],
    "nl": [
      "Als telers van rood fruit, aardbeien, frambozen, bramen, zwarte en rode bessen en imkers verwerken we onze oogst tot jam, siroop, coulis, koekjes en nougat. Vers fruit beschikbaar in het seizoen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les merles moqueurs"
    ]
  },
