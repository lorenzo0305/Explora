  "rdfs:comment": {
    "de": [
      "Weine, Käse, einige Pökelwaren, Getränke aller Art (Sirup, Mineralwasser), Kuchen, Marmeladen, Honig, Spirituosen, aus Feinkostläden. Biologische Weine in loser Schüttung, in Flaschen."
    ],
    "en": [
      "Wines, cheeses, some cured meats, drinks of all kinds (syrups, mineral waters), cakes, jams, honeys, spirits, from delicatessens. Organic wines in bulk and bottles."
    ],
    "it": [
      "Vini, formaggi, alcuni salumi, bevande di ogni tipo (sciroppi, acque minerali), dolci, marmellate, mieli, liquori, da gastronomie. Vini biologici sfusi e in bottiglia."
    ],
    "fr": [
      "Vins, fromages, quelques salaisons, boissons en tous genre (sirops, eaux minérales), gâteaux, confitures, miels, alcools, d'épiceries fines. Vins biologiques en vrac, en bouteilles."
    ],
    "nl": [
      "Wijnen, kazen, sommige soorten vleeswaren, allerlei soorten dranken (siropen, mineraalwater), gebak, jam, honing, sterke drank, van delicatessenwinkels. Biologische wijnen in bulk en in flessen."
    ],
    "es": [
      "Vinos, quesos, algunos embutidos, bebidas de todo tipo (siropes, aguas minerales), pasteles, mermeladas, mieles, licores, de charcutería. Vinos ecológicos a granel y en botella."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cave Lafayette"
    ]
  },
