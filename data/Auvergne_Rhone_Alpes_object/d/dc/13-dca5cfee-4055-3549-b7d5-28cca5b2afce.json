  "rdfs:comment": {
    "de": [
      "Dies ist ein Bauernmarkt in Matheysine. Hier erwarten Sie zahlreiche Lebensmittelprodukte, darunter Eier vom Bauernhof, Obst und Gemüse der Saison, Fleisch, Bier..."
    ],
    "en": [
      "Here's a farmers' market in the Matheysine. A wide range of food products await you, including farm eggs, seasonal fruit and vegetables, meat, beer..."
    ],
    "it": [
      "Ecco un mercato contadino nella Matheysine. Troverete una vasta gamma di prodotti alimentari, tra cui uova di fattoria, frutta e verdura di stagione, carne, birra, ecc."
    ],
    "fr": [
      "Voici un marché de producteurs en Matheysine. De nombreux produits alimentaires vous y attendent, notamment des œufs de ferme, des fruits et des légumes de saison, de la viande, de la bière..."
    ],
    "nl": [
      "Hier is een boerenmarkt in de Matheysine. Je vindt er een brede waaier aan voedingsproducten, waaronder hoeve-eieren, seizoensfruit en -groenten, vlees, bier, enz."
    ],
    "es": [
      "Aquí hay un mercado de agricultores en Matheysine. Encontrarás una amplia gama de productos alimenticios, como huevos de granja, frutas y verduras de temporada, carne, cerveza, etc."
    ]
  },
