  "rdfs:comment": {
    "de": [
      "Das Tout en T ist ein Grillrestaurant, das aber auch multikulturell ausgerichtet ist.\r\nHier finden Sie qualitativ hochwertiges Fleisch aus der Region, wie z. B. Charolais-Parfait mit Pommes frites, Sandwiches und Gerichte aus der mediterranen Küche"
    ],
    "en": [
      "The Tout en T is a grill restaurant but also multicultural.\r\nYou will find there, the local meat of quality, such as the perfect of charolais - fries, sandwiches and dishes resulting from the Mediterranean kitchen"
    ],
    "it": [
      "Il Tout en T è un ristorante alla griglia ma anche multiculturale.\r\nTroverete carne locale di qualità, come il parfait di charolais, patatine, panini e piatti della cucina mediterranea"
    ],
    "fr": [
      "Le Tout en T est un restaurant de grillades mais aussi multiculturel.\r\nVous y trouverez, la viande locale de qualité, tel que le parfait de charolais - frites, des sandwiches et des plats issus de la cuisine méditerranéen"
    ],
    "es": [
      "El Tout en T es un restaurante asador, pero también multicultural.\r\nEncontrará carne local de calidad, como el parfait charolais, patatas fritas, bocadillos y platos de la cocina mediterránea"
    ],
    "nl": [
      "De Tout en T is een grillrestaurant maar ook een multicultureel restaurant.\r\nU vindt er lokaal kwaliteitsvlees, zoals de charolais parfait - frietjes, broodjes en gerechten uit de mediterrane keuken"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Tout en T"
    ]
  },
