  "rdfs:comment": {
    "de": [
      "Der Dos Rond Burger Pub befindet sich in der Hauptstraße von Montchavin. Das Team freut sich, Sie in einer der ältesten Hütten des Ortes begrüßen zu dürfen."
    ],
    "en": [
      "The Dos Rond Burger Pub is in Montchavin's main street. The team is pleased to welcome you to one of the oldest chalets in the resort."
    ],
    "it": [
      "Il Dos Rond Burger Pub si trova nella via principale di Montchavin. Il team è lieto di accogliervi in uno degli chalet più antichi del resort."
    ],
    "fr": [
      "Le Dos Rond Burger Pub se situe dans la rue principale de Montchavin. L'équipe a le plaisir de vous accueillir dans l'un des plus anciens chalets de la station."
    ],
    "es": [
      "La hamburguesería Dos Rond está situada en la calle principal de Montchavin. El equipo se complace en recibirle en uno de los chalets más antiguos de la estación."
    ],
    "nl": [
      "De \"Dos Rond Burger Pub\"  bevindt zich in de hoofdstraat van Montchavin.\r\nHet team heeft het genoegen U te onthalen in een van de oudste chalets van het skioord."
    ]
