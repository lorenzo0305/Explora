  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/64d6583c-db99-33b9-8f89-245fad1275a8",
      "dc:description": {
        "de": [
          "6. April - Dunes du Mont Saint-Frieux - Amphibien\nIn dieser Zeit treffen sich die Amphibien am Rand des Teiches. Besuchen Sie diese Tiere\ndie selten geworden sind.\nTreffpunkt: 10 Uhr auf dem Parkplatz des Naturschutzgebiets, rue de la mer D940E2 in Dannes"
        ],
        "en": [
          "april 6 - Dunes du Mont Saint-Frieux - Amphibians\nAt this time of year, amphibians gather at the edge of the pond. Come and visit these rare creatures\nrare creatures.\nMeet at 10am at the site parking lot, rue de la mer D940E2, Dannes"
        ],
        "it": [
          "6 aprile - Dune del Monte Saint-Frieux - Anfibi\nQuesto è il periodo dell'anno in cui gli anfibi si radunano ai bordi dello stagno. Venite a visitare queste rare creature\nqueste rare creature.\nAppuntamento alle 10 al parcheggio del sito, rue de la mer D940E2 a Dannes"
        ],
        "fr": [
          "6 Avril - Dunes du Mont Saint-Frieux - Les amphibiens\nC’est à cette période que les amphibiens se donnent rendez vous au bord de la mare. Venez rendre visite à ces êtres \ndevenus rares.\nRDV à 10h sur le parking du site, rue de la mer D940E2 à Dannes"
        ],
        "es": [
          "6 de abril - Dunas del Monte Saint-Frieux - Anfibios\nEsta es la época del año en la que los anfibios se reúnen al borde del estanque. Venga a visitar a estas raras criaturas\nestas raras criaturas.\nCita a las 10 h en el aparcamiento del sitio, rue de la mer D940E2 en Dannes"
        ],
        "nl": [
          "6 april - Duinen van de Mont Saint-Frieux - Amfibieën\nDit is de tijd van het jaar waarin amfibieën zich verzamelen aan de rand van de vijver. Kom en bezoek deze zeldzame wezens\ndeze zeldzame dieren.\nVerzamelen om 10 uur op de parkeerplaats van de camping, rue de la mer D940E2 in Dannes"
        ]
      },
