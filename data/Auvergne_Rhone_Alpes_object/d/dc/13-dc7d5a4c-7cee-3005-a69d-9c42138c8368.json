  "rdfs:comment": {
    "de": [
      "Savoyer Küche auf der Basis von frischen Produkten aus einheimischem Anbau und üppige Pizzen. Restaurant Pizzeria"
    ],
    "en": [
      "Tasty and copious cuisine, created with good quality local produce in order to offer you \"good Savoyard cooking\".  Resaurant at the foot of the pistes with a south-facing panoramic view of the mountains."
    ],
    "it": [
      "Cucina generosa e gourmet, realizzata con prodotti prevalentemente locali, selezionati per la loro qualità, per condividere la \"buona cucina savoiarda\". Ristorante ai piedi delle piste con vista panoramica a sud sulle montagne."
    ],
    "fr": [
      "Une cuisine gourmande et généreuse, concoctée à base de produits en grande partie locaux et sélectionnés pour leur qualité afin de partager « la bonne cuisine savoyarde ». Restaurant au pied des pistes avec vue panoramique plein sud sur les massifs."
    ],
    "nl": [
      "Savoyaardse keuken op basis van versproducten van kleine plaatselijke producenten en goed gevulde pizza's. Restaurant Pizzeria bar"
    ],
    "es": [
      "Cocina generosa y gastronómica, elaborada en su mayoría con productos locales, seleccionados por su calidad, para compartir la \"buena cocina saboyana\". Restaurante a pie de pistas con vistas panorámicas de las montañas orientadas al sur."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant La Maison de Savoie"
