  "rdfs:comment": {
    "de": [
      "Vélo'box ist ein Service für Einzel- oder Gruppenschließfächer.\r\n\r\n2 Stationen: Fahrgemeinschaftsplatz La Balme / Collège\r\n\r\nAbonnement in der Citéa-Agentur in Valence, Reservierungsmöglichkeit unter 04 75 600 626."
    ],
    "en": [
      "Vélo'box is an individual or collective locker service.\r\n\r\nTwo stations: La Balme / Collège carpool area\r\n\r\nSubscription at the Valence Citéa agency, reservation possible on 04 75 600 626."
    ],
    "it": [
      "Vélo?box è un servizio di deposito individuale o collettivo.\r\n\r\nDue stazioni: La Balme / Area carpooling del College\r\n\r\nAbbonamento presso l'agenzia Valence Citéa, prenotazione possibile al numero 04 75 600 626."
    ],
    "fr": [
      "Vélo’box est un service de consigne individuelle ou collective.\r\n\r\nDeux stations : Aire de covoiturage La Balme / Collège\r\n\r\nSouscription en agence Citéa de Valence, possibilité de réservation au 04 75 600 626."
    ],
    "es": [
      "Vélo?box es un servicio de consigna individual o colectiva.\r\n\r\nDos estaciones: La Balme / zona de uso compartido del colegio\r\n\r\nInscripción en la agencia Valence Citéa, reserva posible en el 04 75 600 626."
    ],
    "nl": [
      "Vélo'box is een individuele of collectieve lockerservice.\r\n\r\nTwee stations: La Balme / Collège carpoolplaats\r\n\r\nInschrijving in het filiaal Valence Citéa, reservering mogelijk op 04 75 600 626."
