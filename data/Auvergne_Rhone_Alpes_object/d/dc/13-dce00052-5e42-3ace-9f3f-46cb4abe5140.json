  "rdfs:comment": {
    "de": [
      "Guillaume Chonion, Bergführer und Wanderbegleiter, bietet Ihnen zu jeder Jahreszeit Wanderungen in den schönsten Naturgebieten der Haute-Loire an.\r\nProgramm je nach Nachfrage"
    ],
    "en": [
      "As a mountain leader i guide you on the paths around Le Puy en Velay to discover the landscape, the wild life and the history of the monuments in all the Haute-Loire."
    ],
    "it": [
      "Guillaume Chonion, guida alpina, propone passeggiate in tutte le stagioni nel cuore delle più belle aree naturali dell'Alta Loira.\r\nProgramma in base alla richiesta"
    ],
    "fr": [
      "Guillaume Chonion, guide accompagnateur en montagne vous propose des randonnées en toute saison au cœur des plus beaux espaces naturels de la Haute- Loire.\r\nProgramme en fonction des demandes"
    ],
    "es": [
      "Guillaume Chonion, guía de montaña, propone paseos en todas las estaciones en el corazón de los más bellos espacios naturales del Alto Loira.\r\nPrograma según demanda"
    ],
    "nl": [
      "Guillaume Chonion, berggids, biedt wandelingen in alle seizoenen in het hart van de mooiste natuurgebieden van de Haute-Loire.\r\nProgramma op aanvraag"
    ]
  },
  "rdfs:label": {
    "fr": [
      "ECHO L'ALTERNATIVE RANDO : Guide accompagnateur en montagne"
    ]
  },
