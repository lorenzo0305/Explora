  "rdfs:comment": {
    "de": [
      "Diese Strecke ab Givarlais ? Haut-Bocage bietet eine technisch anspruchsvollere Wanderung, die zwischen Dörfern, Weilern, Feldwegen und Waldgebieten wechselt. Diese dynamische Route ist ideal für sportliche Wanderer."
    ],
    "en": [
      "Departing from Givarlais ? Haut-Bocage offers a more technical walk alternating between villages, hamlets, dirt tracks and woodland. A dynamic itinerary, it is ideal for sporty hikers."
    ],
    "it": [
      "Partendo da Givarlais ? L'Haut-Bocage offre una passeggiata più tecnica che alterna villaggi, frazioni, sentieri sterrati e boschi. Questo percorso dinamico è ideale per gli escursionisti sportivi."
    ],
    "fr": [
      "Ce parcours au départ de Givarlais – Haut-Bocage propose une balade plus technique qui alterne entre village, hameaux, chemins de terre et zone boisée. Itinéraire dynamique, il est idéal pour les randonneurs sportifs."
    ],
    "nl": [
      "Vertrekkend vanuit Givarlais ? Haut-Bocage biedt een meer technische wandeling die afwisselt tussen dorpjes, gehuchten, onverharde paden en bossen. Deze dynamische route is ideaal voor sportieve wandelaars."
    ],
    "es": [
      "Saliendo de Givarlais ? Haut-Bocage ofrece un paseo más técnico que alterna pueblos, aldeas, pistas de tierra y bosques. Este recorrido dinámico es ideal para los senderistas deportistas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PR7bis Circuit Sur le Chemin de Montavent - Givarlais"
    ]
  },
