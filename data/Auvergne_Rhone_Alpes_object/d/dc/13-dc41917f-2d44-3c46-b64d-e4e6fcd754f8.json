  "rdfs:comment": {
    "de": [
      "Am Fuße des alten mittelalterlichen Dorfes La Laupie bietet Ihnen die Chefin des Restaurants Argíl eine originelle bistronomische Küche aus frischen, lokalen und saisonalen Produkten, die durch eine schöne Weinkarte aus dem Rhône-Tal veredelt wird."
    ],
    "en": [
      "At the foot of the old medieval village of La Laupie, the chef at Argíl restaurant offers original bistronomic cuisine made with fresh, local and seasonal produce, complemented by an excellent wine list from the Rhône Valley."
    ],
    "it": [
      "Ai piedi dell'antico borgo medievale di La Laupie, lo chef del ristorante Argíl propone un'originale cucina bistronomica a base di prodotti freschi, locali e di stagione, impreziosita da una raffinata carta dei vini della Valle del Rodano."
    ],
    "fr": [
      "Au pied du vieux village médiéval de La Laupie, la cheffe du restaurant Argíl vous propose une cuisine bistronomique originale, faite de produits frais, locaux et de saison, sublimée par une belle carte des vins de la Vallée du Rhône."
    ],
    "nl": [
      "Aan de voet van het oude middeleeuwse dorpje La Laupie biedt de chef-kok van restaurant Argíl u een originele bistronomische keuken, bereid met verse, lokale en seizoensgebonden producten, aangevuld met een prachtige wijnkaart uit de Rhônevallei."
    ],
    "es": [
      "A los pies del antiguo pueblo medieval de La Laupie, el chef del restaurante Argíl propone una cocina bistronómica original basada en productos frescos, locales y de temporada, realzada por una excelente carta de vinos del valle del Ródano."
    ]
  },
