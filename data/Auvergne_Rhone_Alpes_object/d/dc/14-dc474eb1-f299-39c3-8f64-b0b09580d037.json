  "rdfs:comment": {
    "de": [
      "Brasserie, Bar, Snack, saisonale und hausgemachte Küche, gemütlicher Rahmen.\nIm Sommer Möglichkeit einer Terrasse (40 zusätzliche Gedecke)\nFrische Produkte der Saison stehen in einfachen Rezepten im Vordergrund."
    ],
    "en": [
      "Brasserie, bar, snack bar, homemade seasonal cuisine, warm setting.\nTerrace available in summer (40 additional covers)\nFresh seasonal produce in simple recipes."
    ],
    "it": [
      "Brasserie, bar, snack bar, cucina stagionale fatta in casa, ambiente accogliente.\nTerrazza disponibile in estate (40 coperti in più)\nProdotti freschi di stagione in ricette semplici."
    ],
    "fr": [
      "Brasserie, bar, snack, cuisine de saison et faite maison, cadre chaleureux. \nPossibilité de terrasse l'été (40 couverts supplémentaires)\nLes produits frais de saison sont à l'honneur dans des recettes simples."
    ],
    "nl": [
      "Brasserie, bar, snackbar, huisgemaakte seizoenskeuken, gezellige omgeving.\nTerras beschikbaar in de zomer (40 extra couverts)\nVerse seizoensproducten in eenvoudige recepten."
    ],
    "es": [
      "Brasserie, bar, snack bar, cocina casera de temporada, ambiente acogedor.\nTerraza disponible en verano (40 cubiertos suplementarios)\nProductos frescos de temporada en recetas sencillas."
    ]
  },
