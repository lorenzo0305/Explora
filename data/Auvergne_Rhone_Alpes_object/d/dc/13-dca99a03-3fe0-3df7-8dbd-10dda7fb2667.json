  "rdfs:comment": {
    "de": [
      "Produzentin im Herzen der Bocage Bourbonnais.\r\nDer Anbau von Wohlfühlhanf wird auf handwerkliche und manuelle Weise produziert und verarbeitet. Hanf hat anerkannte Tugenden, braucht wenig Wasser und entschlackt die Böden."
    ],
    "en": [
      "Producer in the heart of the Bocage Bourbonnais.\r\nWell-being hemp is grown and processed by hand. Hemp has recognized virtues, requires little water and depollutes the soil."
    ],
    "it": [
      "Produttore nel cuore del Bocage Bourbonnais.\r\nLa canapa del benessere è coltivata e lavorata a mano. La canapa ha virtù riconosciute, richiede poca acqua e pulisce il terreno."
    ],
    "fr": [
      "Productrice au coeur du Bocage Bourbonnais.\r\nLa culture de chanvre bien-être est produit et transformé de manière artisanale et manuelle. Le chanvre possède des vertus reconnues, demande peu d’eau et dépollue les sols."
    ],
    "es": [
      "Productor en el corazón del Bocage Bourbonnais.\r\nEl cáñamo del bienestar se cultiva y transforma a mano. El cáñamo tiene virtudes reconocidas, requiere poca agua y limpia el suelo."
    ],
    "nl": [
      "Producent in het hart van de Bocage Bourbonnais.\r\nWelzijnshennep wordt met de hand geteeld en verwerkt. Hennep heeft erkende deugden, heeft weinig water nodig en reinigt de grond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "MC CBD BIO"
    ]
  },
