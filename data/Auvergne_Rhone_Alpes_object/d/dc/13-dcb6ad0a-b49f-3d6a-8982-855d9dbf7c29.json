  "rdfs:comment": {
    "de": [
      "Die Entdeckung dieser Kirche führt Sie auf die Spuren der Templer, die sich im 13. Jahrhundert auf Wunsch der Herren von Saussac im Dorf niederließen."
    ],
    "en": [
      "The discovery of this church will take you on the traces of the Templars who settled in the 13th century in the village at the request of the Lords of Saussac."
    ],
    "it": [
      "La scoperta di questa chiesa vi porterà sulle tracce dei Templari che si stabilirono nel villaggio nel XIII secolo su richiesta dei signori di Saussac."
    ],
    "fr": [
      "La découverte de cette église vous emmènera sur les traces des Templiers installés au 13ème siècle dans le village à la demande des Seigneurs de Saussac."
    ],
    "es": [
      "El descubrimiento de esta iglesia le llevará sobre las huellas de los templarios que se instalaron en el pueblo en el siglo XIII a petición de los señores de Saussac."
    ],
    "nl": [
      "De ontdekking van deze kerk brengt u op de sporen van de Tempeliers die zich in de 13e eeuw in het dorp vestigden op verzoek van de Heren van Saussac."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise des Templiers"
    ]
  },
