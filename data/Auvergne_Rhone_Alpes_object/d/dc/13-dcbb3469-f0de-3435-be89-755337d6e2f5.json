  "rdfs:comment": {
    "de": [
      "20 Minuten von Aurillac entfernt, gegenüber dem Strand von Rénac, am Ufer des Sees von Saint-Étienne-Cantalès, im Herzen des Waldes der Halbinsel Rénac."
    ],
    "en": [
      "20 minutes from Aurillac, opposite the Rénac beach, on the shores of the Saint-Étienne-Cantalès lake, in the heart of the forest of the Rénac peninsula."
    ],
    "it": [
      "A 20 minuti da Aurillac, di fronte alla spiaggia di Rénac, sulle rive del lago Saint-Étienne-Cantalès, nel cuore della foresta della penisola di Rénac."
    ],
    "fr": [
      "À 20 minutes d’Aurillac, face à la plage aménagée de Rénac, au bord du lac de Saint-Étienne-Cantalès, en plein cœur de la forêt de la presqu’île de Rénac."
    ],
    "nl": [
      "Op 20 minuten van Aurillac, tegenover het strand van Rénac, aan de oevers van het meer Saint-Étienne-Cantalès, in het hart van het bos van het schiereiland Rénac."
    ],
    "es": [
      "A 20 minutos de Aurillac, frente a la playa de Rénac, a orillas del lago Saint-Étienne-Cantalès, en el corazón del bosque de la península de Rénac."
    ]
  },
