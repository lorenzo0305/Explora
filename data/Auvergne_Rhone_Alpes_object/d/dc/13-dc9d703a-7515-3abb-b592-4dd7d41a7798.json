  "rdfs:comment": {
    "de": [
      "Milchviehbetrieb mit 20 Kühen der Rasse Jersiaise (von den Inseln Jersey, Guernsey), deren Milch protein- und fettreicher ist als die von Holsteinkühen."
    ],
    "en": [
      "Dairy farm with 20 Jersey cows (from the islands of Jersey and Guernsey), whose milk is richer in protein and fat than that of Holsteins."
    ],
    "it": [
      "Un'azienda lattiero-casearia con 20 mucche Jersey (provenienti dalle isole di Jersey e Guernsey), il cui latte è più ricco di proteine e grassi rispetto a quello delle Holstein."
    ],
    "fr": [
      "Exploitation laitière de 20 vaches de race Jersiaise (originaire des îles de Jersey, Guernesey) dont le lait est plus riche en protéines et matières grasses que celui des vaches de race Holstein."
    ],
    "es": [
      "Una explotación lechera con 20 vacas Jersey (procedentes de las islas de Jersey y Guernsey), cuya leche es más rica en proteínas y grasas que la de las Holstein."
    ],
    "nl": [
      "Een melkveebedrijf met 20 Jersey-koeien (van de eilanden Jersey en Guernsey), waarvan de melk rijker is aan eiwitten en vet dan die van Holsteins."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Miel, produits laitiers de Mme Marie-Anne Colonval"
    ]
  },
