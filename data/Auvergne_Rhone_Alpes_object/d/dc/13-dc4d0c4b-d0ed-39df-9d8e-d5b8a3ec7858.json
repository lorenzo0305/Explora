  "rdfs:comment": {
    "de": [
      "Ausstellung und Verkauf.\r\nSeit 38 Jahren geöffnete Töpferei, Einzelstücke und Gebrauchsgegenstände aus Steingut und Porzellan, Farbforschung mit Hochtemperaturglasuren. Brennen bei 1300° im Flammenofen, unveränderliche Keramiken für Lebensmittelzwecke."
    ],
    "en": [
      "Exhibition and sale.\r\nPottery open for 38 years, unique and utilitarian pieces in stoneware and porcelain, research into the colours of high-temperature glazes. Fired at 1300° in a flame kiln, unalterable ceramics for food use.."
    ],
    "it": [
      "Esposizione e vendita.\r\nCeramiche aperte da 39 anni, pezzi unici e utilitari in gres e porcellana, ricerca sui colori degli smalti ad alta temperatura. Cotta a 1300° in forno a fiamma, ceramica inalterabile per uso alimentare."
    ],
    "fr": [
      "Exposition-Vente.\r\nPoterie ouverte depuis 39 ans, pièces uniques et utilitaires en grès et porcelaine, recherche sur les couleurs des émaux de hautes températures. Cuisson à 1300° en four à flammes, céramiques inaltérables à usage alimentaire."
    ],
    "nl": [
      "Tentoonstelling en verkoop.\r\nPottenbakkerij al 39 jaar open, unieke en gebruiksvoorwerpen in steengoed en porselein, onderzoek naar de kleuren van glazuren bij hoge temperatuur. Gebakken op 1300° in een vlamoven, onveranderlijk keramiek voor voedselgebruik."
    ],
    "es": [
      "Exposición y venta.\r\nAlfarería abierta desde hace 39 años, piezas únicas y utilitarias en gres y porcelana, investigación sobre los colores de los esmaltes a alta temperatura. Cocción a 1300° en horno de llama, cerámica inalterable para uso alimentario."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition-Vente à la  Poterie des Cochettes"
    ]
  },
