  "rdfs:comment": {
    "de": [
      "Tame Impala kündigt für das Frühjahr 2026 eine große Tournee durch Europa und Großbritannien an und wird am 10. April in der LDLC Arena in Lyon-Décines zu Gast sein."
    ],
    "en": [
      "Tame Impala has announced a major tour of Europe and the United Kingdom for spring 2026, and will be performing at the LDLC Arena in Lyon-Décines on April 10."
    ],
    "it": [
      "I Tame Impala hanno annunciato un grande tour in Europa e nel Regno Unito per la primavera del 2026 e saranno alla LDLC Arena di Lione-Décines il 10 aprile."
    ],
    "fr": [
      "Tame Impala annonce une grande tournée en Europe et au Royaume-Uni pour le printemps 2026, et sera de passage à la LDLC Arena de Lyon-Décines, le 10 avril."
    ],
    "nl": [
      "Tame Impala heeft een grote tournee door Europa en Groot-Brittannië aangekondigd voor het voorjaar van 2026 en staat op 10 april in de LDLC Arena in Lyon-Décines."
    ],
    "es": [
      "Tame Impala ha anunciado una gran gira por Europa y el Reino Unido para la primavera de 2026, y estará en el LDLC Arena de Lyon-Décines el 10 de abril."
    ]
