  "rdfs:comment": {
    "de": [
      "Die Boutique von JLN Bike bietet auf Reservierung vom Verleih von Mountainbikes mit elektrischer Unterstützung. bis zum Rennrad für alle. Als umweltbewusster Betrieb sind wir mit dem Label Accueil Vélo ausgezeichnet. Kostenlose Parkplätze stehen zur Verfügung. Kommen Sie und radeln Sie anders!"
    ],
    "en": [
      "The JLN Bike store offers rental of electrically assisted mountain bikes upon reservation. racing cycling for everyone. Eco-responsible, we are certified Accueil Vélo. Free parking available. Come cycle differently!"
    ],
    "it": [
      "Il negozio JLN Bike offre tutto, dal noleggio di mountain bike elettriche alle bici da corsa per tutti. Ecologico, abbiamo il marchio Accueil Vélo. Parcheggio gratuito a disposizione. Venite a pedalare in modo diverso!"
    ],
    "fr": [
      "La boutique de JLN Bike propose sur réservation,  de la location de VTT à assistance électrique. au vélo de course pour tous. Éco-responsable, nous sommes labellisés Accueil Vélo. Parking gratuit disponible. Venez pédaler autrement !"
    ],
    "es": [
      "La tienda JLN Bike ofrece desde alquiler de bicicletas de montaña con asistencia eléctrica hasta bicicletas de carreras para todos los públicos. Respetuosos con el medio ambiente, tenemos la etiqueta Accueil Vélo. Aparcamiento gratuito disponible. ¡Ven a pedalear de otra manera!"
    ],
    "nl": [
      "De JLN Bike shop biedt alles van het huren van elektrisch ondersteunde mountainbikes tot racefietsen voor iedereen. We zijn milieuvriendelijk en hebben het label Accueil Vélo. Gratis parkeren. Kom en trap anders!"
    ]
  },
