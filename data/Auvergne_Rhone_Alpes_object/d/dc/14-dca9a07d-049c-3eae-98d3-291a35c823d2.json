  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ee367401-69cf-34c1-a1f4-5448387dfa0f",
      "dc:description": {
        "de": [
          " Informationen :\n\nÖffnungstage:\n\nDienstag bis Samstag von 9:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr, Sonntag von 10:00 bis 12:00 Uhr.\n\nBestellungen:\n\nKontaktieren Sie das Geschäft telefonisch unter 03 21 48 81 50 oder 06 73 12 03 47.\n\nBedingungen:\n\n- Kostenlose Lieferung ab einem Bestellwert von 25?\n- Lieferung in einem Umkreis von 15 km\n\n "
        ],
        "en": [
          " Information :\n\nOpening days:\n\nTuesday to Saturday, 9am to 12pm and 2pm to 6pm, Sunday 10am to 12pm.\n\nOrders :\n\nContact the store by phone on 03 21 48 81 50 or 06 73 12 03 47.\n\nTerms and conditions:\n\n- Free delivery on orders over 25?\n- Delivery within a 15 km radius\n\n "
        ],
        "it": [
          " Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a sabato dalle 9.00 alle 12.00 e dalle 14.00 alle 18.00, domenica dalle 10.00 alle 12.00.\n\nOrdini :\n\nContattare il negozio telefonicamente al numero 03 21 48 81 50 o 06 73 12 03 47.\n\nTermini e condizioni:\n\n- Consegna gratuita a partire da 25 euro\n- Consegna nel raggio di 15 km\n\n "
        ],
        "fr": [
          " Informations : \n\nJours d'ouverture: \n\nDu mardi au samedi de 9h à 12h et de 14h à 18h, le dimanche de 10h à 12h.\n\nCommandes : \n\nContacter le magasin par téléphone au 03 21 48 81 50 ou au 06 73 12 03 47.\n\nConditions : \n\n- Livraison gratuite à partir de 25€ de commande\n- Livraison dans un rayon de 15 km\n\n "
        ],
        "nl": [
          " Meer informatie :\n\nOpeningsdagen:\n\nDinsdag t/m zaterdag van 9.00 tot 12.00 uur en van 14.00 tot 18.00 uur, zondag van 10.00 tot 12.00 uur.\n\nBestellingen :\n\nNeem telefonisch contact op met de winkel op 03 21 48 81 50 of 06 73 12 03 47.\n\nAlgemene voorwaarden:\n\n- Gratis bezorging bij bestellingen van €25 of meer\n- Levering binnen een straal van 15 km\n\n "
        ],
        "es": [
          " Más información :\n\nDías de apertura:\n\nDe martes a sábado de 9h a 12h y de 14h a 18h, domingos de 10h a 12h.\n\nPedidos :\n\nPóngase en contacto con la tienda por teléfono llamando al 03 21 48 81 50 o al 06 73 12 03 47.\n\nCondiciones generales de venta:\n\n- Entrega gratuita a partir de 25 euros\n- Entrega en un radio de 15 km\n\n "
        ]
      },
