      "dc:description": {
        "de": [
          "Musikalische Aufführung für Kinder mit Imbiss dort im Festsaal von Quesques.\n\nPreis: 5? Kostenlos für Kinder unter 3 Jahren.\n\nAuf Reservierung"
        ],
        "en": [
          "Musical show for children with snack at the Quesques village hall.\n\nPrice: 5? Free for children under 3.\n\nOn reservation"
        ],
        "it": [
          "Spettacolo musicale per bambini con merenda presso la sala del villaggio di Quesques.\n\nPrezzo: 5? Gratuito per i bambini sotto i 3 anni.\n\nSolo su prenotazione"
        ],
        "fr": [
          "Spectacle musical pour enfants avec goûter là la salle des fêtes de Quesques.\n\nTarif : 5€. Gratuit pour les moins de 3 ans.\n\nSur réservation"
        ],
        "nl": [
          "Muzikale show voor kinderen met snack in het dorpshuis van Quesques.\n\nPrijs: 5? Gratis voor kinderen onder de 3 jaar.\n\nAlleen op reservering"
        ],
        "es": [
          "Espectáculo musical para niños con merienda en el salón del pueblo de Quesques.\n\nPrecio: 5? Gratis para menores de 3 años.\n\nSólo con reserva"
        ]
