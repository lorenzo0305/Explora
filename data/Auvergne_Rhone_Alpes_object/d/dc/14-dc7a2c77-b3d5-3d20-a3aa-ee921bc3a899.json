  "rdfs:comment": {
    "de": [
      "Eine Gedenkwanderung, Landschaften voller Geschichte und ein Imbiss als Belohnung für die Reise durch Raum und Zeit - ist das ein Programm, das Sie reizt?"
    ],
    "en": [
      "A memorial hike, landscapes filled with history and a snack to reward this journey through space and time, is this a program that tempts you?"
    ],
    "it": [
      "Avete voglia di una passeggiata commemorativa, di paesaggi ricchi di storia e di uno spuntino che ricompensi il vostro viaggio nel tempo e nello spazio?"
    ],
    "fr": [
      "Une randonnée mémorielle, des paysages remplis d’histoire et un goûter pour récompenser cette remontée dans l’espace et le temps, est-ce un programme qui vous tente ?"
    ],
    "es": [
      "¿Le apetece un paseo conmemorativo, paisajes llenos de historia y un tentempié para recompensar su viaje en el tiempo y el espacio?"
    ],
    "nl": [
      "Kijk je uit naar een herdenkingswandeling, landschappen vol geschiedenis en een snack als beloning voor je reis terug in tijd en ruimte?"
    ]
  },
