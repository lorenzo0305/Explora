  "rdfs:comment": {
    "de": [
      "Restaurant mit familiärer Atmosphäre, das von einer Einheimischen aus den Bergen geführt wird. Geselliges Café mit Mittagessen. Hausgemachte Küche. Breakfast, Teestube, Snacks, Aperitifbretter"
    ],
    "en": [
      "New this winter: a lunch café \r\n\r\n \r\nThe Wood Bear Café will be open from 8am for coffee through to aperitifs after skiing."
    ],
    "it": [
      "Ristorante a conduzione familiare gestito da una montanara locale. Pranzo al bar conviviale. Cucina casalinga. Colazione, sala da tè, spuntini, aperitivi"
    ],
    "fr": [
      "Restaurant à ambiance familiale tenu par une locale des montagnes. Café lunch convivial. Cuisine maison. Breakfast, Salon de thé, goûter, planches apéritives"
    ],
    "es": [
      "Restaurante familiar regentado por una montañesa de la zona. Agradable comida de cafetería. Cocina casera. Desayunos, salón de té, meriendas, tablas de aperitivos"
    ],
    "nl": [
      "Familierestaurant gerund door een lokale bergvrouw. Vriendelijke café-lunch. Huisgemaakte gerechten. Ontbijt, tearoom, snacks, aperitiefplankjes"
    ]
