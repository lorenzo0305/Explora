  "rdfs:comment": {
    "de": [
      "Am Ufer des Lac de Grangent im Naturschutzgebiet Gorges de la Loire können Sie am Strand von Saint-Victor-sur-Loire eine Pause einlegen.\r\nEin Strand mit feinem Sand, über dem eine große Grünfläche liegt, die mit Kinderspielen ausgestattet ist und kostenlos genutzt werden kann."
    ],
    "en": [
      "On the banks of Lac de Grangent, in the Gorges de la Loire Nature Reserve, take a break on the beach at Saint-Victor-sur-Loire.\r\nIt's a fine sandy beach topped by a vast area of greenery with children's playground equipment, with free access."
    ],
    "it": [
      "Sulle rive del Lac de Grangent, nella Riserva Naturale delle Gole della Loira, fate una pausa sulla spiaggia di Saint-Victor-sur-Loire.\r\nSi tratta di una spiaggia di sabbia fine sormontata da una vasta area verde con attrezzature per bambini, ad accesso gratuito."
    ],
    "fr": [
      "Sur les bords du Lac de Grangent, dans la Réserve Naturelle des Gorges de la Loire, prenez une pause sur la plage de Saint-Victor-sur-Loire.\r\nUne plage de sable fin surmontée d'un vaste espace de verdure aménagé avec des jeux d'enfants, en accès gratuit."
    ],
    "nl": [
      "Aan de oevers van het meer van Grangent, in het natuurreservaat van de Gorges de la Loire, kunt u even uitrusten op het strand van Saint-Victor-sur-Loire.\r\nHet is een fijn zandstrand met daarbovenop een uitgestrekt groengebied met speeltoestellen voor kinderen, met gratis toegang."
    ],
    "es": [
      "A orillas del lago de Grangent, en el Parque Natural de las Gargantas del Loira, descansa en la playa de Saint-Victor-sur-Loire.\r\nEs una playa de arena fina coronada por una amplia zona verde con juegos infantiles de acceso gratuito."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Victor-sur-Loire beach"
    ],
    "fr": [
      "Plage de Saint-Victor-sur-Loire"
    ]
  },
