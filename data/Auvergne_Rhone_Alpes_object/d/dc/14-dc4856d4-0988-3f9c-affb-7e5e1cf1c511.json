  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0be7b133-9f02-33eb-af12-eab731a20534",
      "dc:description": {
        "de": [
          "Ambulanter, loser Lebensmittelladen: Nudeln, Reis, Grieß, Hülsenfrüchte, Müsli, Süßigkeiten... Salz von der Halbinsel Guérande, Fleur de Sel, Salicorne-Senf, Badesalze. Produktion in der Familie.\nSpezialität: Salicorne-Senf"
        ],
        "en": [
          "Mobile bulk grocery: pasta, rice, semolina, dried vegetables, muesli, sweets... Salt from the Guérande peninsula, fleur de sel, salicorne mustard, bath salts. Family production.\nSpeciality: salicorne mustard"
        ],
        "it": [
          "Drogheria sfusa itinerante: pasta, riso, semola, legumi, muesli, dolci, ecc. Sale della penisola di Guérande, fleur de sel, senape di Salicorne, sali da bagno. Produzione familiare.\nSpecialità: senape salicorne"
        ],
        "fr": [
          "Epicerie vrac ambulante : pâtes, riz, semoule, légumes secs, muesli, bonbons... Sel de la presqu'île guérandaise, fleur de sel, moutarde salicorne, sels de bain. Production familiale.\nSpécialité : la moutarde à la salicorne"
        ],
        "nl": [
          "Travelling bulk grocery: pasta, rijst, griesmeel, peulvruchten, muesli, snoep, enz. Zout van het schiereiland Guérande, fleur de sel, salicorne mosterd, badzout. Familiale productie.\nSpecialiteit: salicorne mosterd"
        ],
        "es": [
          "Compra ambulante a granel: pasta, arroz, sémola, legumbres, muesli, dulces, etc. Sal de la península de Guérande, flor de sal, mostaza salicorne, sales de baño. Producción familiar.\nEspecialidad: mostaza salicornia"
        ]
      },
      "@type": [
        "Description"
      ],
