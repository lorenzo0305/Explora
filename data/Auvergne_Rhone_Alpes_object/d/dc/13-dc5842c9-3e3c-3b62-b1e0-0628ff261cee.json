  "rdfs:comment": {
    "de": [
      "\"Comme dit si bien Verlaine?\", eine Vorleseshow mit Texten von Paul Verlaine und Arthur Rimbaud, aufgeführt von den Grenouilles Liseuses und, mit Gitarre und Gesang, von Catherine David und Jean Pierre Grimaldi."
    ],
    "en": [
      "\"Comme dit si bien Verlaine?\", a show of readings aloud of texts by Paul Verlaine and Arthur Rimbaud, performed by Les Grenouilles Liseuses, with Catherine David and Jean Pierre Grimaldi on guitar and vocals."
    ],
    "it": [
      "\"Comme dit si bien Verlaine\", spettacolo di letture ad alta voce su testi di Paul Verlaine e Arthur Rimbaud, eseguito dalle Grenouilles Liseuses, con Catherine David e Jean Pierre Grimaldi alla chitarra e alla voce."
    ],
    "fr": [
      "\"Comme dit si bien Verlaine…\", un spectacle de lectures à voix haute autour des textes de Paul Verlaine et Arthur Rimbaud par les Grenouilles Liseuses, et, à la guitare et au chant, Catherine David et Jean Pierre Grimaldi."
    ],
    "es": [
      "\"Comme dit si bien Verlaine\", espectáculo de lecturas en voz alta a partir de textos de Paul Verlaine y Arthur Rimbaud, interpretado por las Grenouilles Liseuses, con Catherine David y Jean Pierre Grimaldi a la guitarra y la voz."
    ],
    "nl": [
      "\"Comme dit si bien Verlaine\", een voorleesvoorstelling gebaseerd op teksten van Paul Verlaine en Arthur Rimbaud, uitgevoerd door de Grenouilles Liseuses, met Catherine David en Jean Pierre Grimaldi op gitaar en zang."
    ]
  },
  "rdfs:label": {
