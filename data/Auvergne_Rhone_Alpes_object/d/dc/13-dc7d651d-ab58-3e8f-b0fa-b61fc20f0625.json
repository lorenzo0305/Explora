  "rdfs:comment": {
    "de": [
      "Entdecken Sie allein oder in der Gruppe einen landwirtschaftlichen Betrieb und seine menschliche, tierische und natürliche Umgebung.\r\nSnacks, Aktivitäten und Geburtstage.\r\nNur mit Reservierung."
    ],
    "en": [
      "Come and discover, alone or in a group, a farm and its human, animal and natural environment.\r\nSnacks, activities and birthday parties.\r\nReservations required."
    ],
    "it": [
      "Venite a scoprire, da soli o in gruppo, una fattoria e il suo ambiente umano, animale e naturale.\r\nMerende, attività e compleanni.\r\nSolo su prenotazione."
    ],
    "fr": [
      "Venez découvrir seul ou en groupe, une exploitation agricole et son environnement humain, animal et naturel.\r\nGoûters, activités et anniversaires.\r\nSur réservation uniquement."
    ],
    "es": [
      "Ven a descubrir, solo o en grupo, una granja y su entorno humano, animal y natural.\r\nMeriendas, actividades y fiestas de cumpleaños.\r\nSólo con reserva previa."
    ],
    "nl": [
      "Kom en ontdek, alleen of in een groep, een boerderij en haar menselijke, dierlijke en natuurlijke omgeving.\r\nSnacks, activiteiten en verjaardagsfeestjes.\r\nAlleen op reservering."
    ]
  },
  "rdfs:label": {
