  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Schätze des Kulturerbes von Loire Forez: Ungewöhnliche Besichtigungen, lokales Know-how und symbolträchtige Orte öffnen Ihnen ihre Türen, um die Geschichte und Kultur der Region zu feiern. Das Programm ist in unseren Informationsbüros erhältlich."
    ],
    "en": [
      "Explore the treasures of Loire Forez heritage: unique tours, local know-how and emblematic sites open their doors to celebrate the region?s history and culture. Program available from our information offices."
    ],
    "it": [
      "Esplorate i tesori del patrimonio della Loira Forez: visite uniche, know-how locale e siti emblematici vi aprono le porte per celebrare la storia e la cultura della regione. Programma disponibile presso i nostri uffici informazioni."
    ],
    "fr": [
      "Explorez les trésors du patrimoine de Loire Forez : visites inédites, savoir-faire locaux et lieux emblématiques vous ouvrent leurs portes pour célébrer l’histoire et la culture du territoire. Programme disponible dans nos bureaux d'information."
    ],
    "nl": [
      "Ontdek de schatten van het erfgoed van de Loire Forez: unieke rondleidingen, lokale knowhow en emblematische plaatsen openen hun deuren voor u om de geschiedenis en cultuur van de regio te vieren. Programma verkrijgbaar bij onze informatiekantoren."
    ],
    "es": [
      "Explore los tesoros del patrimonio de Loire Forez: recorridos únicos, saber hacer local y lugares emblemáticos le abren sus puertas para celebrar la historia y la cultura de la región. Programa disponible en nuestras oficinas de información."
    ]
  },
