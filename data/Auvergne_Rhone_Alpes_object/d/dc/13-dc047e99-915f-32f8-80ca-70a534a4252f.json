  "rdfs:comment": {
    "de": [
      "Christian Carlier ist seit 2015 in Souvigny ansässig und bietet seine handwerklich gesponnenen und gewebten Kreationen sowie gebrauchsfertige Wollknäuel zum Verkauf an."
    ],
    "en": [
      "Established in Souvigny since 2015, Christian Carlier offers for sale his hand-spun and hand-woven creations, as well as balls of ready-to-use wool."
    ],
    "it": [
      "Con sede a Souvigny dal 2015, Christian Carlier vende le sue creazioni filate e tessute a mano, oltre a gomitoli di lana pronti all'uso."
    ],
    "fr": [
      "Installé à Souvigny depuis 2015, Christian Carlier propose à la vente ses créations filées et tissées de manière artisanale, ainsi que des pelotes de laines prêtes à l’emploi."
    ],
    "es": [
      "Instalado en Souvigny desde 2015, Christian Carlier vende sus creaciones hiladas y tejidas a mano, así como ovillos de lana listos para usar."
    ],
    "nl": [
      "Christian Carlier is sinds 2015 gevestigd in Souvigny en verkoopt zijn handgesponnen en handgeweven creaties, maar ook bollen kant-en-klare wol."
    ]
  },
