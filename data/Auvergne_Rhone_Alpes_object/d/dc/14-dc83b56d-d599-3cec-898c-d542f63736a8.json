  "rdfs:comment": {
    "de": [
      "Wie wäre es, wenn Sie sich einmal eine Aufführung ansehen würden, bei der NICHTS im Voraus festgelegt ist?"
    ],
    "en": [
      "What if, for once, you came to see a show? where NOTHING is written in advance?"
    ],
    "it": [
      "E se, per una volta, veniste a vedere uno spettacolo in cui NULLA è scritto in anticipo?"
    ],
    "fr": [
