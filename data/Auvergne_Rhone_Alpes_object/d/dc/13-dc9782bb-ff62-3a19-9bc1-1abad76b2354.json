  "rdfs:comment": {
    "de": [
      "Entdeckt die erste Eislaufbahn des Ortes! Diese Aktivität empfängt Groß und Klein auf dem Place Péclet (oberhalb des Ortes), um die Freuden einer neuen Form des Schlittschuhlaufens in Val Thorens zu entdecken."
    ],
    "en": [
      "Discover the resort's first ice rink! This activity welcomes young and old to the Place Péclet (at the top of the resort) to discover the joys of a new form of sliding in Val Thorens."
    ],
    "it": [
      "Scoprite la prima pista di ghiaccio della stazione! Questa attività accoglie grandi e piccini in Place Péclet (in cima alla stazione) per scoprire le gioie di una nuova forma di scivolamento a Val Thorens."
    ],
    "fr": [
      "Découvrez La première patinoire de la station ! Cette activité accueille petits et grands sur la place Péclet (en haut de la station) pour découvrir les joies d’une nouvelle forme de glisse à Val Thorens."
    ],
    "nl": [
      "Ontdek de eerste ijsbaan van het skioord! Deze activiteit verwelkomt jong en oud op de Place Péclet (bovenaan het skioord) om de geneugten van een nieuwe vorm van glijden in Val Thorens te ontdekken."
    ],
    "es": [
      "Descubra la primera pista de hielo de la estación. Esta actividad acoge a grandes y pequeños en la Place Péclet (en lo alto de la estación) para descubrir los placeres de una nueva forma de deslizamiento en Val Thorens."
    ]
  },
  "rdfs:label": {
