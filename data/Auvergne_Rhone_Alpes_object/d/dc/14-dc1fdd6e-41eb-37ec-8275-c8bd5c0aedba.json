  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ebfa5315-2339-362d-8a90-4b45bb57f200",
      "dc:description": {
        "de": [
          "Route rund um die Strandvillen aus \"In Memoriam\", dem letzten Buch von Le Charme.\n\nNur mit Anmeldung am Stand von Le Charme de Wimereux vor der Kirche.\n\nAbfahrt des Rundgangs: 16:30, 17:00, 17:30 und 18:00 Uhr."
        ],
        "en": [
          "Itinerary around the seaside villas in \"In Memoriam\", Le Charme's latest book.\n\nRegistration only, at the Charme de Wimereux stand in front of the church.\n\nDepartures: 4.30pm, 5pm, 5.30pm and 6pm."
        ],
        "it": [
          "Un itinerario tra le ville sul mare di \"In Memoriam\", l'ultimo libro di Le Charme.\n\nSolo su prenotazione, presso lo stand dello Charme de Wimereux di fronte alla chiesa.\n\nPartenze: ore 16.30, 17.00, 17.30 e 18.00."
        ],
        "fr": [
          "Itinéraire autour des villas balnéaires de \"In Memoriam\", le dernier livre du Charme.\n\nSur inscription uniquement, au stand du Charme de Wimereux, devant l'église.\n\nDéparts du circuit: 16h30, 17h00, 17h30 et 18h00."
        ],
        "es": [
          "Un itinerario por las villas costeras de \"In Memoriam\", el último libro de Le Charme.\n\nInscripción previa en la caseta de Le Charme de Wimereux, frente a la iglesia.\n\nSalidas: 16.30 h, 17.00 h, 17.30 h y 18.00 h."
        ],
        "nl": [
          "Een route langs de villa's aan zee in \"In Memoriam\", het nieuwste boek van Le Charme.\n\nAlleen op inschrijving, bij de stand van Charme de Wimereux voor de kerk.\n\nVertrek: 16.30, 17.00, 17.30 en 18.00 uur."
        ]
      },
      "@type": [
