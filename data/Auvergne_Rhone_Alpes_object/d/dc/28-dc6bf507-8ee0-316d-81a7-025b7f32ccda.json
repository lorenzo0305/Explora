      "dc:description": {
        "de": [
          "Awoingt British Cemetery' ist ein Militärfriedhof aus dem Ersten Weltkrieg auf dem Gebiet der Gemeinde Awoingt im Département Nord.\nwww.cwgc.org/"
        ],
        "en": [
          "Awoingt British Cemetery' is a First World War military cemetery located in the commune of Awoingt in the department of Nord.\nwww.cwgc.org/"
        ],
        "it": [
          "Il \"cimitero britannico di Awoingt\" è un cimitero militare della Prima Guerra Mondiale situato nel comune di Awoingt, nel dipartimento del Nord.\nwww.cwgc.org/"
        ],
        "fr": [
          "Awoingt British Cemetery' est un cimetière militaire de la Première Guerre mondiale situé sur le territoire de la commune d'Awoingt dans le département du Nord.\nwww.cwgc.org/"
        ],
        "es": [
          "El \"Cementerio Británico de Awoingt\" es un cementerio militar de la Primera Guerra Mundial situado en la comuna de Awoingt, en el departamento del Norte.\nwww.cwgc.org/"
        ],
        "nl": [
          "Awoingt British Cemetery' is een militaire begraafplaats uit de Eerste Wereldoorlog in de gemeente Awoingt in het departement Nord.\nwww.cwgc.org/"
        ]
      },
