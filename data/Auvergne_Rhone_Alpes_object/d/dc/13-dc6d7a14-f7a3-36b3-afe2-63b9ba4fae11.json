  "rdfs:comment": {
    "de": [
      "Auf einer Fläche von 4000 m2 beherbergt er einen schönen Fischbestand: Karpfen, Schleien, Plötzen und Raubfische. Er ist als No-Kill-Fischteich für Black-Bass eingestuft."
    ],
    "en": [
      "Covering a surface area of 4,000 m2, it is home to a fine range of fish: carp, tench, roach and carnivorous fish. It is classified No-Kill for Black Bass."
    ],
    "it": [
      "Con una superficie di 4.000 m2, ospita un gran numero di pesci: carpe, tinche, lasche e predatori. Ha una classificazione No-Kill per il black bass."
    ],
    "fr": [
      "D'une superficie de 4000 m2, il abrite un beau cheptel piscicole : carpes, tanches, gardons et carnassiers. Il est classé No-Kill pour le Black-Bass."
    ],
    "nl": [
      "Met een oppervlakte van 4.000 m2 herbergt het een groot aantal vissen: karper, zeelt, voorn en roofblei. Het heeft een No-Kill classificatie voor black bass."
    ],
    "es": [
      "Con una superficie de 4.000 m2, alberga un gran número de peces: carpas, tencas, cucarachas y depredadores. Cuenta con una clasificación No-Kill para el black bass."
    ]
  },
