  "rdfs:comment": {
    "de": [
      "Alpes Aventures, Ihr Radspaßmacher! Entdecken Sie unsere Fahrradtouren. Testen Sie den Fahrradverleih. Erleben Sie eine einzigartige Erfahrung. Kaufen Sie in unserem Laden."
    ],
    "en": [
      "Alpes Aventures, your creator of cycling fun! \r\nDiscover our bike tours. Try out our bike rentals. Enjoy a unique experience. Shop in our store."
    ],
    "it": [
      "Alpes Aventures, la tua fonte di piacere in bicicletta! Scopri i nostri tour in bicicletta. Prova il nostro servizio di noleggio bici e vivi un'esperienza unica. Acquista nel nostro negozio."
    ],
    "fr": [
      "Alpes Aventures, votre créateur de plaisir à vélo! Découvrez nos randonnées à vélo. Testez la location de vélo. Vibrez, grâce à une expérience unique. Achetez dans notre magasin."
    ],
    "nl": [
      "Alpes Aventures, uw bron van fietsplezier! Ontdek onze fietstochten. Probeer onze fietsverhuur. Geniet van een unieke ervaring. Koop in onze winkel."
    ],
    "es": [
      "Alpes Aventures, ¡su fuente de placer ciclista! Descubra nuestros circuitos en bicicleta. Pruebe nuestro alquiler de bicicletas. Disfrute de una experiencia única. Compre en nuestra tienda."
    ]
  },
