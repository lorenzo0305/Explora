  "rdfs:comment": {
    "de": [
      "Komplettes Menü mit All-you-can-eat-Buffet oder Brasserie-Karte und Holzofenpizza, mehrere Angebote, um Sie zufrieden zu stellen.\r\nAngenehme überdachte Terrasse und schneller Service.\r\nEtablissement in der Nähe der Via Ardèche."
    ],
    "en": [
      "Menu with all-you-can-eat buffet or brewery menu and pizza with firewood, several formulas to satisfy you.\r\nNice covered terrace and fast service. \r\nThe hotel's location offers direct access to the Via Ardèche."
    ],
    "it": [
      "Menu completo con buffet a volontà o menu brasserie e pizza cotta a legna, diverse opzioni per soddisfare le vostre esigenze.\r\nPiacevole terrazza coperta e servizio rapido.\r\nVicino alla Via Ardèche."
    ],
    "fr": [
      "Menu complet avec buffet à volonté ou carte brasserie et pizza feu de bois, plusieurs formules pour vous satisfaire.\r\nTerrasse couverte agréable et service rapide.\r\nEtablissement à proximité de la Via Ardèche."
    ],
    "nl": [
      "Volledige kaart met all-you-can-eat buffet of brasseriemenu en houtovenpizza, verschillende opties die bij je passen.\r\nAangenaam overdekt terras en snelle service.\r\nVlakbij de Via Ardèche."
    ],
    "es": [
      "Carta completa con buffet libre o menú brasserie y pizza al horno de leña, varias opciones a su gusto.\r\nAgradable terraza cubierta y servicio rápido.\r\nCerca de la Via Ardèche."
    ]
  },
