  "rdfs:comment": {
    "de": [
      "Unter den Bäumen in der Nähe der Rochecourbière-Höhle, wo Madame de Sévigné zum Schreiben kam, hat Ihnen das Rathaus drei Picknicktische zur Verfügung gestellt."
    ],
    "en": [
      "Under the trees near the Rochecourbière cave where Madame de Sévigné came to write, the Town Hall has made 3 picnic tables available to you."
    ],
    "it": [
      "Sotto gli alberi vicino alla grotta di Rochecourbière, dove Madame de Sévigné veniva a scrivere, il Municipio ha messo a disposizione 3 tavoli da picnic."
    ],
    "fr": [
      "Sous les arbres à proximité de la grotte de Rochecourbière où Madame de Sévigné venait écrire, la Mairie a mit à votre disposition 3 tables de pique nique."
    ],
    "nl": [
      "Onder de bomen bij de grot van Rochecourbière waar Madame de Sévigné kwam schrijven, heeft het stadhuis u 3 picknicktafels ter beschikking gesteld."
    ],
    "es": [
      "Bajo los árboles cercanos a la gruta de Rochecourbière, donde Madame de Sévigné solía venir a escribir, el Ayuntamiento ha dispuesto 3 mesas de picnic."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique nique de la Rochecourbière"
    ]
  },
