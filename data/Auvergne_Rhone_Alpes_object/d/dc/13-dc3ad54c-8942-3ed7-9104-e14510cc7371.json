  "rdfs:comment": {
    "de": [
      "Chez Lily vom Frühstück bis zum Abendessen! Frühstück, Aperitifbretter, Sommersalate, Frischeschüssel, Burger und frische hausgemachte Pommes frites mit Rinderfett, neapolitanische Pizzas, Tagesmenüs, hausgemachte Desserts, Crêpes, handgemachtes Eis."
    ],
    "en": [
      "At Lily’s from breakfast to dinner! Breakfasts, aperitif boards, summer salads, fresh bowl, homemade burgers and fries with beef fat, Neapolitan pizzas, menus of the day, homemade desserts, crepes, homemade ice cream."
    ],
    "it": [
      "Chez Lily dalla colazione alla cena! Colazioni, taglieri per aperitivi, insalate estive, ciotole di freschezza, hamburger e patatine fritte fresche con grasso di manzo, pizze napoletane, menu del giorno, dolci fatti in casa, crêpes, gelati artigianali."
    ],
    "fr": [
      "Chez Lily du petit déjeuner au dîner ! Petits déjeuners, planches apéro, salades estivales, bol fraîcheur, burgers et frites fraîches maison à la graisse de bœuf, pizzas napolitaines, menus du jour, desserts maison, crêpes, glaces artisanales."
    ],
    "es": [
      "Chez Lily, ¡desde el desayuno hasta la cena! Desayunos, tablas de aperitivos, ensaladas de verano, cuencos de frescura, hamburguesas y patatas fritas caseras frescas con grasa de ternera, pizzas napolitanas, menús diarios, postres caseros, crepes, helados caseros."
    ],
    "nl": [
      "Bij Lily's van ontbijt tot diner! Ontbijt, aperitiefplanken, zomersalades, verse kom, hamburgers en verse zelfgemaakte frietjes met rundvleesvet, Napolitaanse pizza's, dagmenu's, zelfgemaakte desserts, pannenkoeken, ambachtelijke ijsjes."
    ]
  },
  "rdfs:label": {
    "en": [
      "at Lily's"
    ],
