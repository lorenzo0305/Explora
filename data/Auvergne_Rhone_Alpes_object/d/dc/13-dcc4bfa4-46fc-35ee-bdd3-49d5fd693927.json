  "rdfs:comment": {
    "de": [
      "Buchillustrationen, Comics und Zeichnungen auf verschiedenen Medien, Fresken, Schulworkshops, Auftragsarbeiten nach Maß. Vor Ort: Geschäft, Atelier und Ausstellungen (samstags von Juni bis Oktober: 14.00 - 19.00 Uhr oder nach Vereinbarung). Video-Aquarell-Workshops nach vorheriger Absprache"
    ],
    "en": [
      "Illustrations for books, comics and drawings on various media, frescoes, school workshops, made-to-measure commissions. On-site: shop, studio and exhibitions (Saturdays from June to October: 2pm-7pm or by appointment). Video watercolour workshops by prior arrangement"
    ],
    "it": [
      "Illustrazioni per libri, fumetti e disegni su vari supporti, affreschi, laboratori scolastici, commissioni su misura. In loco: negozio, studio e mostre (sabato da giugno a ottobre: 14.00-19.00 o su appuntamento). Laboratori video di acquerello su prenotazione"
    ],
    "fr": [
      "Illustrations de livres, BD et dessins sur différents supports, fresques, ateliers scolaires, commandes sur mesure. Sur place : boutique, atelier et expositions (le samedi de juin à octobre : 14h-19h ou sur RDV.). Visio-stages d'aquarelles sur inscription"
    ],
    "es": [
      "Ilustraciones para libros, cómics y dibujos en diversos soportes, frescos, talleres escolares, encargos a medida. In situ: tienda, taller y exposiciones (sábados de junio a octubre: de 14:00 a 19:00 o con cita previa). Talleres de acuarela en vídeo con cita previa"
    ],
    "nl": [
      "Illustraties voor boeken, strips en tekeningen op verschillende media, fresco's, workshops voor scholen, opdrachten op maat. Ter plaatse: winkel, atelier en tentoonstellingen (zaterdagen van juni tot oktober: 14u-19u of op afspraak). Video aquarel workshops op afspraak"
    ]
  },
