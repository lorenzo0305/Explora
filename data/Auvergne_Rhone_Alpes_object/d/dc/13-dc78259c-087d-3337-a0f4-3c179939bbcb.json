  "rdfs:comment": {
    "de": [
      "Ihr Tourismusbüro empfängt Sie das ganze Jahr über, um Sie zu informieren, zu führen und Ihnen die Station Savoie Grand Revard und das Massif des Bauges näherzubringen."
    ],
    "en": [
      "Your tourist office welcomes you all year round to inform you, guide you and help you discover the resort of Savoie Grand Revard and the Massif des Bauges."
    ],
    "it": [
      "L'ufficio turistico vi accoglie tutto l'anno per informarvi, guidarvi e aiutarvi a scoprire la stazione di Savoia Grand Revard e il Massiccio dei Bauges."
    ],
    "fr": [
      "Votre office de tourisme vous accueille toute l'année pour vous renseigner, guider et faire découvrir la station de Savoie Grand Revard et le Massif des Bauges."
    ],
    "nl": [
      "Uw VVV-kantoor verwelkomt u het hele jaar door om u te informeren, te begeleiden en u te helpen het Savoie Grand Revard resort en het Massif des Bauges te ontdekken."
    ],
    "es": [
      "Su oficina de turismo le da la bienvenida todo el año para informarle, guiarle y ayudarle a descubrir la estación de Savoie Grand Revard y el Macizo de las Baugas."
    ]
  },
  "rdfs:label": {
