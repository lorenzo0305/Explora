  "rdfs:comment": {
    "de": [
      "Zwischen Valence und Chabeuil gelegen. Hausgemachte Küche, die aus frischen und saisonalen Produkten zubereitet wird. Herzliche Atmosphäre in einer ruhigen und grünen Umgebung. Schöne Terrasse mit Swimmingpool. Privatisierung des Lokals für jede Art von Veranstaltung. Privater Parkplatz"
    ],
    "en": [
      "Located between Valence and Chabeuil, home cooking using fresh seasonal produce. Warm atmosphere in a quiet, leafy setting. Beautiful terrace with swimming pool. Private use of the establishment for all types of events. Private parking lot"
    ],
    "it": [
      "Situato tra Valence e Chabeuil, cucina casalinga con prodotti freschi di stagione. Atmosfera calda in un ambiente tranquillo e verdeggiante. Bella terrazza con piscina. Il ristorante può essere affittato per qualsiasi tipo di evento. Parcheggio privato"
    ],
    "fr": [
      "Situé entre Valence et Chabeuil, cuisine maison élaborée à base de produits frais et de saison. Ambiance chaleureuse dans un cadre calme et verdoyant. Belle terrasse avec piscine. Privatisation de l'établissement pour tout type d’événement. Parking privé"
    ],
    "es": [
      "Situado entre Valence y Chabeuil, cocina casera con productos frescos de temporada. Ambiente cálido en un entorno tranquilo y frondoso. Bonita terraza con piscina. El restaurante puede alquilarse para cualquier tipo de evento. Aparcamiento privado"
    ],
    "nl": [
      "Gelegen tussen Valence en Chabeuil, huisgemaakte keuken met verse seizoensproducten. Warme sfeer in een rustige, groene omgeving. Mooi terras met zwembad. Het restaurant kan worden afgehuurd voor elk soort evenement. Privé parkeerplaats"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Expression"
    ]
  },
