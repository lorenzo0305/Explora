  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt gelegen, können Sie die architektonischen Sehenswürdigkeiten besichtigen, das Casino besuchen und im Park entspannen, der nur wenige Meter vom Hotel entfernt ist."
    ],
    "en": [
      "Located in the heart of the city, you can enjoy the architectural tours as well as the casino and you can relax at the Parc de Verdure, all located a few meters from the hotel."
    ],
    "it": [
      "Hotel ubicato in centro per approfittare delle visite architettoniche, del casinò e del relax al Parc de Verdure, a pochi metri dall'hotel."
    ],
    "fr": [
      "Situé en plein coeur de la ville, vous pourrez profiter des visites architecturales ainsi que du casino et de détente au parc de verdure, tout celà situé à quelques mètres de l'hôtel."
    ],
    "es": [
      "Situado en el corazón de la ciudad, podrá disfrutar de visitas arquitectónicas, así como del casino y relajarse en el parque verde, todo ello a pocos metros del hotel."
    ],
    "nl": [
      "Gelegen in het hart van de stad, kunt u genieten van architecturale rondleidingen en het casino en ontspannen in het groene park, allemaal binnen een paar meter van het hotel."
    ]
  },
  "rdfs:label": {
