  "rdfs:comment": {
    "de": [
      "Angeln Sie in diesem kleinen, von Tannen umgebenen See. Ein ruhiger Ort, wo Sie mitten im Gebirge Bachforellen fangen können !"
    ],
    "en": [
      "Come and fish in this little lake surrounded by pine trees and enjoy the peaceful mountain setting where you can fish for brown trout."
    ],
    "it": [
      "Venite a pescare in questo piccolo lago circondato da abeti, un luogo tranquillo dove pescare trote fario in mezzo alle montagne."
    ],
    "fr": [
      "Venez pêcher dans ce petit lac entouré de sapins, un endroit paisible où vous pourrez pêcher des truites fario, en pleine montagne."
    ],
    "es": [
      "Venga a pescar a este pequeño lago rodeado de abetos, un lugar tranquilo donde podrá pescar truchas fario en plena montaña."
    ],
    "nl": [
      "Kom vissen in dit kleine meer omgeven door dennenbomen, een rustige plek waar u midden in de bergen op fario-forel kunt vissen."
    ]
  },
