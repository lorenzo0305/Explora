  "rdfs:comment": {
    "de": [
      "Der Sessellift von Lindarets ermöglicht den Zugang zum Skigebiet Avoriaz vom Plateau des Lindarets aus.\r\nEr ist nur für Fußgänger zugänglich, sowohl für den Aufstieg als auch für die Abfahrt.\r\nAnschließend besteht die Möglichkeit, zu Fuß über die Piste bis zum Wasserfall von Brochaux abzusteigen."
    ],
    "en": [
      "The Lindarets chairlift provides access to Avoriaz from the Lindarets plateau. \r\nAccessible to pedestrians only, for the ascent or descent. \r\nYou can then walk down to the Brochaux waterfall via the piste."
    ],
    "it": [
      "La seggiovia del Lindarets consente di accedere ad Avoriaz dall'altopiano del Lindarets.\r\nÈ accessibile solo ai pedoni, sia per la salita che per la discesa.\r\nÈ possibile scendere alla cascata di Brochaux attraverso la pista."
    ],
    "fr": [
      "Le télésiège des Lindarets permet d'accéder à la station d'Avoriaz depuis le plateau des Lindarets . \r\nAccessible uniquement aux piétons, pour la montée ou la descente. \r\nPossibilité de descendre ensuite jusqu'à la cascade des Brochaux à pied par la piste."
    ],
    "es": [
      "El telesilla de Lindarets da acceso a Avoriaz desde la meseta de Lindarets.\r\nAccesible sólo a peatones, para el ascenso o el descenso.\r\nA continuación, puede bajar a pie a la cascada de Brochaux por la pista."
    ],
    "nl": [
      "De Lindarets stoeltjeslift biedt toegang tot Avoriaz vanaf het Lindarets plateau.\r\nAlleen toegankelijk voor voetgangers, voor de klim of de afdaling.\r\nJe kunt dan via de piste afdalen naar de waterval van Brochaux."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Lindarets chairlift"
    ],
    "fr": [
      "Télésiège des Lindarets"
    ]
  },
