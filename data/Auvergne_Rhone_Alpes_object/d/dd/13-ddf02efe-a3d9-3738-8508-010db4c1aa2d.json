  "rdfs:comment": {
    "de": [
      "Die deutsche Band Scorpions, eine weltweite Ikone des Hardrock, feiert weiterhin ihre 60-jährige Karriere mit der Coming Home Live Jubiläumstour und wird am 14. Juli 2026 in der LDLC Arena in Lyon-Décines für eine einzigartige Show auftreten."
    ],
    "en": [
      "A global icon of hard rock, German band Scorpions continues to celebrate its 60-year career with the Coming Home Live anniversary tour and will be at the LDLC Arena in Lyon-Décines on 14 July 2026 for a unique show."
    ],
    "it": [
      "Gli Scorpions, icone dell'hard rock tedesco, continuano a festeggiare i 60 anni di attività musicale con il loro Coming Home Live anniversary tour e saranno all'Arena LDLC di Lione-Décines il 14 luglio 2026 per uno spettacolo unico."
    ],
    "fr": [
      "Icône mondiale du hard rock, le groupe allemand Scorpions continue de célébrer ses 60 ans de carrière avec la tournée anniversaire Coming Home Live et sera à la LDLC Arena de Lyon-Décines le 14 juillet 2026 pour un show unique."
    ],
    "es": [
      "Los iconos alemanes del hard rock Scorpions siguen celebrando sus 60 años en el mundo de la música con su gira aniversario Coming Home Live, y estarán en el LDLC Arena de Lyon-Décines el 14 de julio de 2026 para ofrecer un espectáculo único."
    ],
    "nl": [
      "De Duitse hardrockiconen Scorpions blijven 60 jaar in de muziekbusiness vieren met hun Coming Home Live jubileumtournee en staan op 14 juli 2026 in de LDLC Arena in Lyon-Décines voor een unieke show."
    ]
  },
