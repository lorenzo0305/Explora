      "@id": "https://data.datatourisme.fr/2fa19910-0c4c-31e5-b55f-47a24b292678",
      "dc:description": {
        "de": [
          "Die Zimmer des Cottage vereinen Komfort und Eleganz. Das Hotel liegt in einer grünen Umgebung, in der Nähe von Geschäftszentren und Einkaufsmöglichkeiten."
        ],
        "en": [
          "Le Cottage's rooms combine comfort and elegance, and the hotel is nestled in a verdant setting close to business and shopping centers."
        ],
        "it": [
          "Le camere del Le Cottage combinano comfort ed eleganza e l'hotel è immerso in un ambiente verdeggiante, vicino a centri commerciali e negozi."
        ],
        "fr": [
          "Les chambres du Cottage allient confort et élégance, l'hôtel est niché dans un cadre verdoyant, à proximité des centres d'affaires et des commerces."
        ],
        "es": [
          "Las habitaciones de Le Cottage combinan confort y elegancia, y el hotel está enclavado en un entorno frondoso, cerca de centros de negocios y tiendas."
        ],
        "nl": [
          "De kamers van Le Cottage combineren comfort en elegantie, en het hotel ligt in een groene omgeving, dicht bij zakencentra en winkels."
        ]
      },
