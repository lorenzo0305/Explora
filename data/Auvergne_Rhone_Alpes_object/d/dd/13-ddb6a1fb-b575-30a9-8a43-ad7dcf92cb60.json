  "rdfs:comment": {
    "de": [
      "Diese Mountainbike-Route beginnt am Bahnhof der TMB in Saint-Gervais und führt hinauf zum Col de Voza. Die Strecke wechselt zwischen Waldwegen und schmaleren Pfaden und bietet eine schöne Vielfalt an Geländearten."
    ],
    "en": [
      "Departing from the TMB station in Saint-Gervais, this VTTAE itinerary climbs to the Col de Voza. The route alternates between forest tracks and narrower trails, offering a wide variety of terrain."
    ],
    "it": [
      "Con partenza dalla stazione TMB di Saint-Gervais, questo percorso VTTAE sale al Col de Voza. Il percorso alterna piste forestali e sentieri più stretti, offrendo una grande varietà di terreno."
    ],
    "fr": [
      "Au départ de la gare du TMB à Saint-Gervais, cet itinéraire en VTTAE monte jusqu'au Col de Voza. Le parcours alterne pistes forestières et sentiers plus étroits, offrant une belle variété de terrains."
    ],
    "nl": [
      "Deze VTTAE-route vertrekt vanaf het TMB-station in Saint-Gervais en klimt naar de Col de Voza. De route gaat afwisselend over bospaden en smallere paden en biedt een grote verscheidenheid aan terrein."
    ],
    "es": [
      "Con salida de la estación TMB de Saint-Gervais, esta ruta VTTAE asciende hasta el Col de Voza. El recorrido alterna pistas forestales y senderos más estrechos, ofreciendo una gran variedad de terrenos."
    ]
  },
