  "rdfs:comment": {
    "de": [
      "Die Gleitschirmschule Les Portes du Soleil lädt Sie sommers wie winters zur Entdeckung des Gleitschirmfliegens in aller Sicherheit und in dem einzigartigen Rahmen des Gebiets Les Portes du Soleil ein."
    ],
    "en": [
      "The Portes du Soleil paragliding school offers safe outings in summer and winter in the stunning surroundings of the Portes du Soleil."
    ],
    "it": [
      "La scuola professionale di parapendio e speed-riding di Portes du Soleil vi offre l'opportunità di scoprire, con istruttori qualificati, le caratteristiche di questo sport\r\ncorsi, sessioni di scoperta, parapendio e battesimi di velocità tutto l'anno!"
    ],
    "fr": [
      "L'Ecole professionnelle de parapente et de Speed-riding des Portes du Soleil vous propose de découvrir avec des moniteurs diplômés d’état\r\ndes stages, cours, séance découverte, baptême de parapentes et de speed-riding toute l’année !"
    ],
    "es": [
      "La escuela profesional de parapente y speed-riding de Portes du Soleil le ofrece la oportunidad de descubrir con instructores cualificados por el Estado\r\ncursos, sesiones de descubrimiento, bautismos de parapente y speed-riding durante todo el año"
    ],
    "nl": [
      "De professionele paragliding- en speedridingschool Portes du Soleil biedt u de mogelijkheid om met gediplomeerde instructeurs op ontdekking te gaan\r\nopleidingen, cursussen, ontdekkingstochten, paragliding en snelheidsdopen het hele jaar door!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Gleitschirmschule Les Portes du Soleil"
    ],
    "en": [
      "Portes du Soleil paragliding school"
