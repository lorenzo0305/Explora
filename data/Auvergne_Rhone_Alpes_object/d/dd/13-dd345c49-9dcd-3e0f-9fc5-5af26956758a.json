  "rdfs:comment": {
    "de": [
      "Les Flamboyantes, die mittelalterlichen und fantastischen Feste der Stadt Cusset, werden am 26., 27. und 28. Juni 2026 zum achten Mal veranstaltet. Drei Tage lang werden die Feierlichkeiten das Herz der Stadt wieder zum Schlagen bringen, wenn sie in ihre schönsten Dekorationen gekleidet ist."
    ],
    "en": [
      "Les Flamboyantes, Cusset's medieval and fantasy festivities, return for an eighth edition on June 26, 27 and 28, 2026. Three days of festivities that will once again make the heart of the town beat, dressed in its most beautiful decors."
    ],
    "it": [
      "Les Flamboyantes, le feste medievali e fantastiche di Cusset, tornano per l'ottava edizione il 26, 27 e 28 giugno 2026. Tre giorni di festeggiamenti che faranno ancora una volta battere il cuore della città, vestita delle sue decorazioni più belle."
    ],
    "fr": [
      "Les Flamboyantes, fêtes médiévales et fantastiques de la Ville de Cusset sootn de retour pour une huitième édition les 26, 27 et 28 juin 2026. Trois jours de festivités qui feront de nouveau battre le coeur de ville vêtu de ses plus beaux décors."
    ],
    "es": [
      "Les Flamboyantes, las fiestas medievales y fantásticas de Cusset, vuelven en su octava edición los días 26, 27 y 28 de junio de 2026. Tres días de fiesta que volverán a hacer latir el corazón de la ciudad, vestida con sus más bellas decoraciones."
    ],
    "nl": [
      "Les Flamboyantes, de middeleeuwse en fantastische feesten van Cusset, zijn terug voor een achtste editie op 26, 27 en 28 juni 2026. Drie dagen van festiviteiten die het hart van de stad weer op hol zullen brengen, gehuld in de mooiste versieringen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Flamboyantes #8"
    ]
  },
