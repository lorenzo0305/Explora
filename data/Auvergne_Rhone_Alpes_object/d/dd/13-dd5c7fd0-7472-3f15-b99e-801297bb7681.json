  "rdfs:comment": {
    "de": [
      "Wir sind seit mehreren Generationen Winzer, bewirtschaften 5 Hektar Weinberge in den Gemeinden Mérignat und Poncin und produzieren hauptsächlich Cerdon Méthode Ancestrale."
    ],
    "en": [
      "Winegrowers for several generations, we cultivate 5 hectares of vines in the communes of Mérignat and Poncin and produce mainly Cerdon Méthode Ancestrale."
    ],
    "it": [
      "Viticoltori da diverse generazioni, coltiviamo 5 ettari di vigne nei comuni di Mérignat e Poncin e produciamo principalmente Cerdon Méthode Ancestrale."
    ],
    "fr": [
      "Vignerons depuis plusieurs générations, nous cultivons 5 hectares de vignes sur les communes de Mérignat et de Poncin et produisons principalement du Cerdon Méthode Ancestrale."
    ],
    "nl": [
      "Wij zijn al generaties lang wijnbouwers en cultiveren 5 hectare wijngaarden in de gemeenten Mérignat en Poncin en produceren voornamelijk Cerdon Méthode Ancestrale."
    ],
    "es": [
      "Viticultores desde hace varias generaciones, cultivamos 5 hectáreas de viñas en los municipios de Mérignat y Poncin y producimos principalmente Cerdon Méthode Ancestrale."
    ]
  },
