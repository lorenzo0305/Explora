  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit kostenlosem Dokument, das im Office de Tourisme abgeholt oder unter www.montlucon-tourisme.fr heruntergeladen werden kann.\r\nMontluçon erlebte im 19. Jahrhundert mit der ersten industriellen Revolution ein zweites goldenes Zeitalter."
    ],
    "en": [
      "Self-guided tour with free brochure available from the Tourist Office or download from www.montlucon-tourisme.fr.\r\nMontluçon experienced a second golden age in the 19th century with the first industrial revolution."
    ],
    "it": [
      "Visita autoguidata con brochure gratuita disponibile presso l'Ufficio del Turismo o scaricabile dal sito www.montlucon-tourisme.fr.\r\nMontluçon ha vissuto una seconda età dell'oro nel XIX secolo, con la prima rivoluzione industriale."
    ],
    "fr": [
      "Visite libre avec document gratuit à retirer à l'Office de Tourisme ou à télécharger sur www.montlucon-tourisme.fr.\r\nMontluçon connaît un second âge d'or au XIXe siècle avec la première révolution industrielle."
    ],
    "es": [
      "Visita autoguiada con folleto gratuito disponible en la Oficina de Turismo o descargable en www.montlucon-tourisme.fr.\r\nMontluçon vivió una segunda edad de oro en el siglo XIX con la primera revolución industrial."
    ],
    "nl": [
      "Rondleiding met gratis brochure verkrijgbaar bij het VVV-kantoor of te downloaden op www.montlucon-tourisme.fr.\r\nMontluçon beleefde een tweede gouden eeuw in de 19e eeuw met de eerste industriële revolutie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours Montluçon au XIXe siècle"
    ]
  },
