  "rdfs:comment": {
    "de": [
      "Mountain Path organisiert Bergaufenthalte, die speziell auf Unternehmen zugeschnitten sind. Leadership, Entscheidungsfindung, Zusammenhalt und Managementtransformation nehmen durch maßgeschneiderte Alpenerlebnisse Gestalt an, die für Führungskräfte, Manager und Teams konzipiert sind."
    ],
    "en": [
      "Mountain Path organizes mountain breaks for companies. Leadership, decision-making, cohesion and managerial transformation take shape through tailor-made alpine experiences designed for executives, managers and teams."
    ],
    "it": [
      "Mountain Path organizza soggiorni in montagna per le aziende. La leadership, il processo decisionale, la coesione e la trasformazione manageriale prendono forma attraverso esperienze alpine su misura pensate per dirigenti, manager e team."
    ],
    "fr": [
      "Mountain Path organise des séjours en montagne dédiés aux entreprises. Leadership, décision, cohésion et transformation managériale prennent forme à travers des expériences alpines sur mesure, conçues pour dirigeants, managers et équipes."
    ],
    "es": [
      "Mountain Path organiza escapadas a la montaña para empresas. El liderazgo, la toma de decisiones, la cohesión y la transformación empresarial toman forma a través de experiencias alpinas a medida diseñadas para ejecutivos, directivos y equipos."
    ],
    "nl": [
      "Mountain Path organiseert bergtochten voor bedrijven. Leiderschap, besluitvorming, cohesie en bestuurlijke transformatie krijgen vorm door op maat gemaakte alpine ervaringen ontworpen voor leidinggevenden, managers en teams."
    ]
  },
