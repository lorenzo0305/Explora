  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6c56dd7f-528d-3e2d-b505-3d1730866fad",
      "dc:description": {
        "de": [
          "Ein mit Spielen, Videos und Fotos gespickter Parcours, um alle Reichtümer der Grand Site de France Les Deux-Caps zu entdecken. Entdecken Sie ab diesem Frühjahr die Ausstellung \"ORNITHOCAPS... Eine Initiationsreise ins Land der Vögel\""
        ],
        "en": [
          "A journey punctuated by games, videos and photos to discover all the treasures of the Grand Site de France Les Deux-Caps. This spring, discover the exhibition \"ORNITHOCAPS... An initiatory journey to the land of birds\""
        ],
        "it": [
          "Scoprite tutti i tesori del Grand Site de France Les Deux-Caps attraverso giochi, video e foto. A partire da questa primavera, scoprite la mostra \"ORNITHOCAPS... Un viaggio iniziatico nella terra degli uccelli\""
        ],
        "fr": [
          "Parcours ponctué de jeux, vidéos et photos pour découvrir toutes les richesses du Grand Site de France Les Deux-Caps. Dès ce printemps, découvrez l'exposition \"ORNITHOCAPS... Un voyage initiatique aux pays des oiseaux\""
        ],
        "nl": [
          "Ontdek alle schatten van de Grand Site de France Les Deux-Caps door middel van spelletjes, video's en foto's. Ontdek vanaf dit voorjaar de tentoonstelling \"ORNITHOCAPS... Een inwijdingsreis naar het land van de vogels\""
        ],
        "es": [
          "Descubra todos los tesoros de Les Deux-Caps Grand Site de France a través de juegos, vídeos y fotos. A partir de esta primavera, descubra la exposición \"ORNITHOCAPS... Un viaje iniciático al país de los pájaros\""
        ]
      },
