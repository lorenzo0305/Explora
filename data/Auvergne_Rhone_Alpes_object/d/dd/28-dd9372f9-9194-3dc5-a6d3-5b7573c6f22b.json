  "rdfs:comment": {
    "de": [
      "Picknickplatz am Flussufer (4 Tische), Bouleplatz + Mülleimer. Wanderweg in der Nähe (Eselsweg). Waschhaus in der Nähe (Zugang über einen Fußweg)."
    ],
    "en": [
      "Picnic area by the river (4 tables), petanque field + dustbin. Hiking trail nearby (donkey trail). Laundry nearby (access by a footpath)."
    ],
    "it": [
      "Area picnic in riva al fiume (4 tavoli), campo da bocce + pattumiera. Sentiero escursionistico nelle vicinanze (sentiero degli asini). Lavatoio nelle vicinanze (accesso tramite sentiero)."
    ],
    "fr": [
      "Aire de pique-nique en bordure de rivière (4 tables), terrain de pétanque + poubelle. Chemin de randonnée à proximité (chemin des ânes). Lavoir à proximité (accès par un chemin pédestre)."
    ],
    "es": [
      "Zona de picnic junto al río (4 mesas), campo de petanca + cubo de basura. Ruta de senderismo en las cercanías (camino de burros). Lavandería cercana (acceso por sendero)."
    ],
    "nl": [
      "Picknickplaats bij de rivier (4 tafels), petanqueveld + vuilnisbak. Wandelpad in de buurt (ezelspad). Wasserette in de buurt (toegang via voetpad)."
    ]
  },
  "rdfs:label": {
    "fr": [
