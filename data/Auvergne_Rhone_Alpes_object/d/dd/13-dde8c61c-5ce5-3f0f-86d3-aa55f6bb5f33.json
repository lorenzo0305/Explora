  "rdfs:comment": {
    "de": [
      "Im Herzen eines Weinbergs, unweit der A7, empfängt Sie das Hôtel Restaurant Garenne in einem intimen Ambiente zu einem gastronomischen Erlebnis, bei dem Saisonalität, Raffinesse und Wagemut aufeinandertreffen."
    ],
    "en": [
      "In the heart of a vineyard, near the A7, the Hôtel Restaurant Garenne welcomes you in an intimate setting for a gastronomic experience where seasonality, refinement and audacity meet."
    ],
    "it": [
      "Nel cuore di un vigneto, vicino all'autostrada A7, l'Hôtel Restaurant Garenne vi accoglie in un ambiente intimo per un pasto gastronomico dove si incontrano stagione, raffinatezza e audacia."
    ],
    "fr": [
      "Au cœur d’un vignoble, près de l‘A7, l’Hôtel Restaurant Garenne vous accueille dans un cadre intimiste pour une table gastronomique où saison, raffinement et audace se rencontrent."
    ],
    "nl": [
      "Midden in een wijngaard, vlakbij de A7, heet Hôtel Restaurant Garenne u welkom in een intieme setting voor een gastronomische ervaring waar seizoensgebondenheid, verfijning en durf samenkomen."
    ],
    "es": [
      "En el corazón de un viñedo, cerca de la autopista A7, el Hôtel Restaurant Garenne le acoge en un marco íntimo para una comida gastronómica donde se dan cita la temporada, el refinamiento y la audacia."
    ]
  },
