  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Bellevaux empfängt Sie das Team des Fremdenverkehrsamtes das ganze Jahr über und unterstützt Sie bei der Organisation Ihres Aufenthalts, Ihres Wochenendes oder Ihres Tages."
    ],
    "en": [
      "At the center of Bellevaux, on the Alpes du Léman area, the tourist office welcomes you all year around.\r\nFree wifi or mobile hotspot rental\r\nShop : goodies and postcards\r\nBooking services : furnished accomodation (houses, chalets, apartments and studio flats), packaged journeys, activities, entertainments.\r\nWe provide a puncture repairkit and airpump is at your disposal on request.\r\nFree car park and disabled parking place next to the office."
    ],
    "it": [
      "Nel cuore del villaggio di Bellevaux, il team dell'Ufficio del Turismo vi accoglie tutto l'anno per aiutarvi a organizzare il vostro soggiorno, il vostro weekend o la vostra giornata."
    ],
    "fr": [
      "Au cœur du village de Bellevaux,  l'équipe  de l'Office de Tourisme vous accueille toute l'année et vous accompagne pour l'organisation de votre séjour, de votre week-end, de votre journée."
    ],
    "nl": [
      "In het hart van het dorp Bellevaux verwelkomt het team van het Office du Tourisme je het hele jaar door om je te helpen bij het organiseren van je verblijf, je weekend of je dagje uit."
    ],
    "es": [
      "En el corazón del pueblo de Bellevaux, el equipo de la Oficina de Turismo le recibe todo el año para ayudarle a organizar su estancia, su fin de semana o su jornada."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Alpes du Léman Tourism Office - Bellevaux office"
    ],
    "fr": [
      "Office de Tourisme des Alpes du Léman - Bureau d'accueil de Bellevaux"
    ]
  },
