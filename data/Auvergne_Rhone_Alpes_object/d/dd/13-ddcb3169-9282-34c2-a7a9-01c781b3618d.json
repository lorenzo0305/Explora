  "rdfs:comment": {
    "de": [
      "Die Rodelbahnen von Le Lioran: garantierte Lachsalven für Groß und Klein!\r\nVier gesicherte Pisten erwarten Sie für unvergessliche Abfahrten, die sich auf die Sektoren Prairie des Sagnes, Font d'Alagnon, Font de Cère und Col de Prat de Bouc verteilen."
    ],
    "en": [
      "4 secure toboggan runs in different areas of the resort: Centre/Prairie des Sagnes, Font d'Alagnon, Font de Cère and Col de Prat de Bouc."
    ],
    "it": [
      "Le piste da slittino di Le Lioran: risate assicurate per grandi e piccini!\r\nQuattro piste sicure vi aspettano per discese indimenticabili, nelle zone di Prairie des Sagnes, Font d'Alagnon, Font de Cère e Col de Prat de Bouc."
    ],
    "fr": [
      "Les pistes de luge du Lioran : fous rires garantis pour petits et grands !\r\nQuatre pistes sécurisées vous attendent pour des descentes inoubliables, réparties sur les secteurs Prairie des Sagnes, Font d’Alagnon, Font de Cère et Col de Prat de Bouc."
    ],
    "es": [
      "Las pistas de trineo de Le Lioran: ¡risas garantizadas para grandes y pequeños!\r\nCuatro pistas seguras le esperan para descensos inolvidables, en las zonas de Prairie des Sagnes, Font d'Alagnon, Font de Cère y Col de Prat de Bouc."
    ],
    "nl": [
      "De rodelbanen van Le Lioran: plezier gegarandeerd voor jong en oud!\r\nVier beveiligde pistes wachten op je voor onvergetelijke afdalingen, in de gebieden Prairie des Sagnes, Font d'Alagnon, Font de Cère en Col de Prat de Bouc."
    ]
  },
  "rdfs:label": {
    "en": [
      "Toboggan runs"
    ],
    "fr": [
      "Pistes de luge"
    ]
  },
