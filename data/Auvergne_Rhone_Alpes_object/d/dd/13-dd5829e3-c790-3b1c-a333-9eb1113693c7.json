  "rdfs:comment": {
    "de": [
      "Riders jeden Alters, kommen Sie und genießen Sie den Pumptrack auf der Spielzone der Plaine de la Daille. Ob mit dem Fahrrad, Skateboard oder Inline-Skates, trainieren Sie und haben Sie dabei Spaß."
    ],
    "en": [
      "Riders of all ages, come and enjoy the pumptrack. By bike, skateboard or rollerblades, train while having fun."
    ],
    "it": [
      "Riders di tutte le età, venite a divertirvi sulla pumptrack nella zona ludica della piana della Daille. In bicicletta, skateboard o pattini, allenatevi divertendovi!"
    ],
    "fr": [
      "Riders de tout âge, venez profiter de la pumptrack sur la zone ludique de la plaine de la Daille. En vélo, skateboard ou rollers, entrainez-vous tout en vous amusant."
    ],
    "nl": [
      "Rijders van alle leeftijden, kom genieten van de pumptrack op het speelterrein van de Plaine de la Daille. Op de fiets, het skateboard of de skeelers kunt u trainen en tegelijkertijd plezier maken."
    ],
    "es": [
      "Ciclistas de todas las edades, venid a disfrutar del pumptrack en la zona de juegos de la Plaine de la Daille. Ya sea en bici, monopatín o patines, podrás entrenarte y divertirte al mismo tiempo."
    ]
  },
