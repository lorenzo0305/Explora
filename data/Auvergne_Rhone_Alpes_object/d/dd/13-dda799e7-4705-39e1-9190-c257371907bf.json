  "rdfs:comment": {
    "de": [
      "Lassen Sie sich im Museum Joseph Déchelette zurückversetzen in das Roanne der galloromanischen Zeit.\r\nund entdecken Sie außerdem eine der reichhaltigsten traditionellen Keramiksammlungen der Provinz."
    ],
    "en": [
      "The Joseph Déchelette Museum enables you to discover daily life in Roanne in Gallo-Roman times.\r\nDiscover also the collection of ancient ceramics which is one of the finest provincial collections."
    ],
    "it": [
      "Il museo offre un ricco percorso dalla preistoria al XX secolo, aperto all'arte non occidentale, all'arte egizia, alla fotografia o alle scienze naturali, alle arti applicate e ai diversi campi classici delle arti visive."
    ],
    "fr": [
      "Le musée offre un parcours riche de la Préhistoire au XXème siècle, ouvert aux arts extra-occidentaux, à l’art Égyptien comme à la photographie ou aux sciences naturelles, aux arts appliqués comme aux différents champs classiques des arts visuels."
    ],
    "nl": [
      "Het museum biedt een rijke reis van de prehistorie tot de 20e eeuw, open voor niet-westerse kunst, Egyptische kunst en fotografie en natuurwetenschappen, toegepaste kunst en de verschillende klassieke gebieden van de beeldende kunst."
    ],
    "es": [
      "El museo ofrece un rico recorrido desde la prehistoria hasta el siglo XX, abierto al arte no occidental, al arte egipcio, así como a la fotografía o las ciencias naturales, a las artes aplicadas y a los diferentes campos clásicos de las artes visuales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La visite gourmande"
    ]
  },
