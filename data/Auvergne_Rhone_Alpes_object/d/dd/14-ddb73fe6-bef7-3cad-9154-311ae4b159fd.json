  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b603211e-1dd7-33c8-9249-e4fdc017ab14",
      "dc:description": {
        "de": [
          "Fantomas ist ein maskierter und schwer fassbarer Verbrecher, der die Welt in Angst und Schrecken versetzt. Der Journalist Fandor, seine Verlobte Hélène und Kommissar Juve sind ihm unerbittlich auf den Fersen."
        ],
        "en": [
          "The elusive masked criminal Fantômas is terrorizing the world. Journalist Fandor, his fiancée Hélène and Inspector Juve track him down relentlessly."
        ],
        "it": [
          "L'inafferrabile criminale mascherato Fantômas sta terrorizzando il mondo. Il giornalista Fandor, la sua fidanzata Hélène e l'ispettore Juve gli danno una caccia senza tregua."
        ],
        "fr": [
          "Criminel masqué et insaisissable, Fantômas terrorise la planète. Le journaliste Fandor, sa fiancée Hélène et le commissaire Juve le traquent sans répit."
        ],
        "es": [
          "El escurridizo criminal enmascarado Fantômas aterroriza al mundo. El periodista Fandor, su prometida Hélène y el inspector Juve le dan caza sin tregua."
        ],
        "nl": [
          "De ongrijpbare gemaskerde crimineel Fantomas terroriseert de wereld. Journalist Fandor, zijn verloofde Hélène en inspecteur Juve maken meedogenloos jacht op hem."
        ]
      },
