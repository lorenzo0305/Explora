  "rdfs:comment": {
    "de": [
      "Luftspaziergänge in den Bergen an Bord eines Ultraleichtflugzeugs mit geschlossenem Cockpit, um auf originelle Weise das Naturerbe und die Bergmassive des Diois und der Baronnies zu entdecken.\r\nMagische Momente bei Sonnenaufgang oder -untergang!"
    ],
    "en": [
      "Aerial stolls through on a four-seater rally to discover the natural heritage and the mountains of the Diois and Baronnies."
    ],
    "it": [
      "Sorvolate le montagne in un ultraleggero a cabina chiusa per scoprire in modo originale il patrimonio naturale e le catene montuose delle regioni del Diois e delle Baronnies.\r\nUn'esperienza magica all'alba o al tramonto!"
    ],
    "fr": [
      "Promenades aériennes en montagne à bord d'un ULM à cockpit fermé pour découvrir de façon originale le patrimoine naturel et les massifs montagneux du Diois et des Baronnies.\r\nDes moments magiques au lever ou au coucher du soleil !"
    ],
    "nl": [
      "Uitstapjes in de lucht in het gebergte aan boord van een 'rallye vier-plaatsen' om op orginele wijze de natuur en het begmassief van het gebied rondom  Die  te ontdekken."
    ],
    "es": [
      "Sobrevuele las montañas en un ultraligero de cabina cerrada para descubrir de forma original el patrimonio natural y las cadenas montañosas de las regiones de Diois y Baronnies.\r\nUna experiencia mágica al amanecer o al atardecer"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Motte Chalancon Flying club - SOTACAM"
    ],
    "fr": [
      "Aéro-club de la Motte Chalancon - SOTACAM"
    ],
    "nl": [
      "Aéro-club de la Motte Chalancon - SOTACAM"
    ]
  },
