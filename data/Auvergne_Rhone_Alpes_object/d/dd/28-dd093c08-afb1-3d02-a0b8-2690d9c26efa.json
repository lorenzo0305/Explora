  "rdfs:comment": {
    "de": [
      "Dieser Rundweg, der an der Kirche von Saint-Aubin-sous-Erquery beginnt, ist ein schöner Spaziergang mit Aussichtspunkten auf die umliegenden Dörfer und den Hügel von Clermont."
    ],
    "en": [
      "This circuit starting from the church of Saint-Aubin-sous-Erquery is a nice walk offering views of the surrounding villages and the hill of Clermont."
    ],
    "it": [
      "Questo circuito, che parte dalla chiesa di Saint-Aubin-sous-Erquery, è una bella passeggiata che offre una vista sui villaggi circostanti e sulla collina di Clermont."
    ],
    "fr": [
      "Ce circuit au départ de l'église de Saint-Aubin-sous-Erquery est une jolie promenade offrant des points de vue sur les villages alentours et la butte de Clermont."
    ],
    "es": [
      "Este circuito, que parte de la iglesia de Saint-Aubin-sous-Erquery, es un bonito paseo que ofrece vistas de los pueblos de los alrededores y de la colina de Clermont."
    ],
    "nl": [
      "Dit circuit, dat begint bij de kerk van Saint-Aubin-sous-Erquery, is een mooie wandeling met uitzicht op de omliggende dorpen en de heuvel van Clermont."
    ]
  },
