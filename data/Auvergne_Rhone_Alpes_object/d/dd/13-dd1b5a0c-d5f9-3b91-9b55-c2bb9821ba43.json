  "rdfs:comment": {
    "de": [
      "Das 3* Hotel-Restaurant Campanile in Chambéry verfügt über 53 Zimmer, davon 31 mit großen Betten (160*200 cm), 13 mit 2 Einzelbetten (90*200 cm) sowie 9 Dreibettzimmer. 6 unserer Zimmer können miteinander verbunden werden, 3 Zimmer sind behindertengerecht."
    ],
    "en": [
      "The 3 * Campanile hotel restaurant in Chambéry has 53 renovated rooms, including 31 with large beds of 160 * 200CM, 13 with 2 single beds of 90 * 200CM, as well as 9 triple rooms, 6 of our rooms can be communicating ."
    ],
    "it": [
      "L'hotel ristorante Campanile 3* di Chambéry dispone di 53 camere, di cui 31 con letti grandi (160*200 cm), 13 con 2 letti singoli (90*200 cm) e 9 camere triple, di cui 6 comunicanti e 3 PMR."
    ],
    "fr": [
      "L’hôtel restaurant 3* Campanile de Chambéry dispose de 53 chambres dont 31 à grands lits de 160*200 cm,  13 à 2 lits d’une personne de 90*200 cm, ainsi que 9 chambres triples, 6 de nos chambres pouvant être communicantes, 3 chambres sont PMR."
    ],
    "nl": [
      "Het 3*-hotel Campanile in Chambéry beschikt over 53 kamers, waarvan 31 met grote bedden (160*200 cm), 13 met 2 eenpersoonsbedden (90*200 cm), en 9 driepersoonskamers, waarvan 6 met elkaar verbonden kunnen worden en 3 PMR-kamers."
    ],
    "es": [
      "El hotel restaurante Campanile 3* de Chambéry dispone de 53 habitaciones, 31 de ellas con camas grandes (160*200 cm), 13 con 2 camas individuales (90*200 cm), así como 9 habitaciones triples, 6 de ellas comunicables y 3 habitaciones PMR."
    ]
  },
