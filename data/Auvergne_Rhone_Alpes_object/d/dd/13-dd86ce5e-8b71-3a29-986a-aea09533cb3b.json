  "rdfs:comment": {
    "de": [
      "Thomas ist ein passionierter Weinhändler und ehemaliger Commis Sommelier des Gourmetrestaurants \"Les Cèdres\", der Ihnen hauptsächlich lokale und internationale Weine im Herzen des historischen Zentrums von Romans anbietet."
    ],
    "en": [
      "Thomas is a passionate wine merchant and former assistant sommelier at the gourmet restaurant \"Les Cèdres\", offering mainly local and world wines in the heart of the historic center of Romans."
    ],
    "it": [
      "Thomas è un appassionato commerciante di vini ed ex assistente sommelier del ristorante gourmet \"Les Cèdres\", che offre principalmente vini locali e mondiali nel cuore del centro storico di Roma."
    ],
    "fr": [
      "Thomas est un caviste passionné, ancien commis sommelier du restaurant gastronomique \"Les Cèdres \" vous proposant principalement des vins locaux et du monde au cœur du centre historique de Romans."
    ],
    "nl": [
      "Thomas is een gepassioneerde wijnhandelaar en voormalig assistent-sommelier in het gastronomische restaurant \"Les Cèdres\", dat voornamelijk lokale en wereldwijnen aanbiedt in het hart van het historische centrum van Rome."
    ],
    "es": [
      "Thomas es un apasionado del vino y antiguo sumiller adjunto del restaurante gastronómico \"Les Cèdres\", que ofrece principalmente vinos locales y del mundo en pleno centro histórico de Romans."
    ]
  },
  "rdfs:label": {
