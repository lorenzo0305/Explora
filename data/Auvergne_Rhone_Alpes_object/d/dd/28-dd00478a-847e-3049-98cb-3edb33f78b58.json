  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3d647a3f-6fa6-3bbd-9315-ea8323a1f550",
      "dc:description": {
        "de": [
          "\"Maki, Sushi, Gyoza, Tempura Garnelen, Gebratene Nudeln, Yakitori, ...\nWie auch immer Ihr Heißhunger aussieht. RENLIN wird Sie dank seiner umfangreichen Karte mit schmackhaften und qualitativ hochwertigen japanischen Spezialitäten bei Ihrer Mahlzeit begleiten.\""
        ],
        "en": [
          "\"Maki, sushi, gyoza, shrimp tempura, stir-fried noodles, yakitori, ...\nWhatever your craving. RENLIN will accompany you during your meal thanks to their extensive menu of tasty, quality Japanese specialties.\""
        ],
        "it": [
          "\"Maki, Sushi, Gyoza, Tempura di gamberi, Tagliatelle fritte, Yakitori, ...\nQualunque sia la vostra voglia. RENLIN vi accompagnerà durante il vostro pasto grazie al suo ampio menu di specialità giapponesi gustose e di alta qualità.\""
        ],
        "fr": [
          "« Maki, Sushi, Gyoza, tempura crevette, Nouilles sautées, yakitori, ...\nQuelle que soit la nature de votre fringale. RENLIN saura vous accompagner lors de votre repas grâce à leur vaste carte de spécialités japonaises savoureuses et de qualité. »"
        ],
        "es": [
          "\"Maki\", \"Sushi\", \"Gyoza\", \"Tempura de gambas\", \"Fideos fritos\", \"Yakitori\"...\nSea cual sea su antojo. RENLIN le acompañará durante su comida gracias a su amplia carta de sabrosas especialidades japonesas de alta calidad.\""
        ],
        "nl": [
          "\"Maki, Sushi, Gyoza, tempura van garnalen, gebakken noedels, Yakitori, ...\nWaar je ook naar verlangt. RENLIN begeleidt je tijdens je maaltijd dankzij hun uitgebreide menu met smakelijke Japanse specialiteiten van hoge kwaliteit.\""
        ]
      },
      "@type": [
        "Description"
      ],
