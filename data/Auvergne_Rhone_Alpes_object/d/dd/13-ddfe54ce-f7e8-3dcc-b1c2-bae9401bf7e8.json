  "rdfs:comment": {
    "de": [
      "Chez Gousse d'Ail ist ein gemütlicher Ort, an dem Gerichte aus frischen Zutaten angeboten werden.\r\nEin klimatisierter Saal und eine schattige, mit Nebeln ausgestattete Terrasse stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Chez Gousse d'Ail is a cosy restaurant serving dishes made with fresh produce.\r\nTwo air-conditioned dining rooms and a terrace."
    ],
    "it": [
      "Il Chez Gousse d'Ail è un accogliente ristorante che serve piatti a base di prodotti freschi.\r\nIl ristorante dispone di una sala da pranzo climatizzata e di una terrazza ombreggiata e dotata di nebbia."
    ],
    "fr": [
      "Chez Gousse d'Ail, lieu chaleureux où sont proposés des plats confectionnés à partir de produits frais.\r\nPour vous accueillir : salle climatisée et une terrasse ombragée équipée de brumisateurs."
    ],
    "nl": [
      "Chez Gousse d'Ail is een gezellig restaurant waar gerechten met verse producten worden geserveerd.\r\nHet restaurant heeft een eetzaal met airconditioning en een schaduwrijk terras met misters."
    ],
    "es": [
      "Chez Gousse d'Ail es un restaurante acogedor que sirve platos elaborados con productos frescos.\r\nEl restaurante dispone de un comedor con aire acondicionado y una terraza a la sombra equipada con nebulizadores."
    ]
  },
