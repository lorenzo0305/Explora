  "rdfs:comment": {
    "de": [
      "In Le Cernix stehen Ihnen zwei Tennisplätze zur Verfügung, die von dem Sportgeschäft Bérod Sports verwaltet werden. Schneller Kunstharzboden. Herrliche Kulisse mit Blick zur Araviskette."
    ],
    "en": [
      "2 tennis courts, managed by Bérod Sports shop, are available at Le Cernix. Quick resin surface coating. Beautiful setting with views over the Aravis range."
    ],
    "it": [
      "2 campi da tennis, gestiti dal negozio di articoli sportivi Bérod, sono disponibili presso il Cernix. Rivestimento superficiale rapido in resina. Magnifica cornice sulla catena montuosa degli Aravis."
    ],
    "fr": [
      "2 courts de tennis, gérés par le magasin Bérod Sports sont à votre disposition au Cernix. Revêtement surface rapide résine. Cadre magnifique sur la chaîne des Aravis."
    ],
    "es": [
      "en el Cernix hay 2 pistas de tenis, gestionadas por la tienda de deportes Bérod. Revestimiento superficial de resina rápido. Magnífico entorno en la cordillera de Aravis."
    ],
    "nl": [
      "2 tennisbanen, beheerd door de Bérod Sports shop, zijn beschikbaar op de Cernix. Snelle harslaag. Prachtige omgeving op het Aravis gebergte."
    ]
  },
