  "rdfs:comment": {
    "de": [
      "Diese bergtypische Wanderung führt Sie durch den Bois des Fraux, einen wunderschönen wilden Wald, der an einen borealen Wald erinnert und auf hohen Sommerweiden auf etwa 1300 m am Fuße des Plomb du Cantal liegt."
    ],
    "en": [
      "This mountain-style circuit takes you through the Bois des Fraux, a magnificent wild wood with the appearance of a boreal forest, situated on high mountain pastures at around 1300 m, at the foot of the Plomb du Cantal."
    ],
    "it": [
      "Questo sentiero \"di montagna\" attraversa il Bois des Fraux, un magnifico bosco selvaggio dall'aspetto di una foresta boreale, situato su pascoli di alta montagna a circa 1.300 m, ai piedi del Plomb du Cantal."
    ],
    "fr": [
      "Ce circuit typé « montagne » vous fera traverser le bois des Fraux, magnifique bois sauvage aux allures de forêt boréale et situé sur de hautes estives aux alentours de 1300 m, au pied du Plomb du Cantal."
    ],
    "es": [
      "Este sendero de \"montaña\" le llevará por el Bois des Fraux, un magnífico bosque salvaje con aspecto de bosque boreal, situado en los pastos de alta montaña a unos 1.300 m, al pie del Plomb du Cantal."
    ],
    "nl": [
      "Dit \"bergpad\" neemt je mee door het Bois des Fraux, een prachtig wild bos met de uitstraling van een boreaal bos, gelegen op hoge bergweiden op ongeveer 1.300 m, aan de voet van de Plomb du Cantal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit VAE n° 11 : Le Chemin des Estives"
    ]
  },
