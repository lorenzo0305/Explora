  "rdfs:comment": {
    "de": [
      "Die Elternvereinigung von Sainte-Eulalie-en-Royans hilft und unterstützt die Dorfschule bei ihren Bildungsprojekten, indem sie durch Verkäufe (Verkauf von Weihnachtsschokolade usw.) Gelder sammelt."
    ],
    "en": [
      "The Sainte-Eulalie-en-Royans Parents' Association helps and supports the village school in their educational projects by raising funds through sales (Christmas chocolate sales, etc.)."
    ],
    "it": [
      "L'Associazione dei genitori di Sainte-Eulalie-en-Royans aiuta e sostiene la scuola del villaggio nei suoi progetti educativi raccogliendo fondi attraverso le vendite (vendita di cioccolata natalizia, ecc.)."
    ],
    "fr": [
      "L'Association des Parents d'Elèves de Sainte-Eulalie-en-Royans aide et soutient l'école du village dans leurs projets éducatifs en récoltant des fonds par le biais de ventes (vente de chocolat de Noël etc.)."
    ],
    "es": [
      "La Asociación de Padres de Sainte-Eulalie-en-Royans ayuda y apoya a la escuela del pueblo en sus proyectos educativos recaudando fondos mediante ventas (venta de chocolate navideño, etc.)."
    ],
    "nl": [
      "De oudervereniging van Sainte-Eulalie-en-Royans helpt en ondersteunt de dorpsschool bij haar onderwijsprojecten door geld in te zamelen via verkoop (kerstchocoladeverkoop, enz.)."
    ]
  },
