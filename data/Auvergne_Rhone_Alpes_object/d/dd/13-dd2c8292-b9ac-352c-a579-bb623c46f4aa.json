  "rdfs:comment": {
    "de": [
      "Zwei Tage lang werden Amateur- und professionelle Tänzer aus den Bereichen Klassik, Modern Jazz, Contemporary, Hip-Hop und Inclusive Dance ihre Leidenschaft auf der Bühne vor einer Jury aus Expertinnen teilen!"
    ],
    "en": [
      "For two days, amateur to pre-professional dancers in classical, modern jazz, contemporary, hip-hop and inclusive dance will share their passion on stage in front of a panel of expert judges!"
    ],
    "it": [
      "Per due giorni, ballerini amatoriali e pre-professionisti di danza classica, modern jazz, contemporanea, hip-hop e danza inclusiva condivideranno la loro passione sul palco davanti a una giuria di esperti!"
    ],
    "fr": [
      "Pendant deux jours, des danseurs amateurs à pré-professionnels, en classique, modern’jazz, contemporain, hip-hop et danse inclusive, partageront leur passion sur scène devant un jury d’expertes !"
    ],
    "nl": [
      "Twee dagen lang delen amateur- en pre-professionele dansers in klassieke, moderne jazz, hedendaagse, hiphop- en inclusieve dans hun passie op het podium voor een panel van deskundige juryleden!"
    ],
    "es": [
      "Durante dos días, bailarines aficionados y preprofesionales de danza clásica, jazz moderno, contemporáneo, hip-hop y danza inclusiva compartirán su pasión sobre el escenario ante un jurado de expertos"
    ]
  },
  "rdfs:label": {
