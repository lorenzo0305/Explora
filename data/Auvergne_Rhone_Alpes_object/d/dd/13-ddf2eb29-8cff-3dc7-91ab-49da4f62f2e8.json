  "rdfs:comment": {
    "de": [
      "Auf dem Dorfplatz, in einer Bistro-Atmosphäre, wird eine einfache Küche gegrillt, wobei der Chefkoch vor Ihnen in Aktion tritt. Eine Auswahl an gereiftem Fleisch und Lieblingsweinen, alles auf der Schiefertafel angeboten."
    ],
    "en": [
      "Located on the village square, the Bistro Sérac serves simply cooked food, matured meats and hand selected wines in a bistro atmosphere."
    ],
    "it": [
      "Situato nella piazza del paese, il Bistro Sérac serve piatti semplici, carni stagionate e vini selezionati in un'atmosfera da bistrot."
    ],
    "fr": [
      "Sur la place du village, dans une ambiance bistrot, une cuisine simplement cuisinée à la braise avec un chef en action devant vous. Un choix de viandes maturées et de vins coups de cœur, le tout proposé à l’ardoise."
    ],
    "nl": [
      "Op het dorpsplein, in een bistrosfeer, een eenvoudige keuken bereid boven het open vuur met een kok in actie voor u. Een keuze van gerijpt vlees en favoriete wijnen, allemaal aangeboden op de lei."
    ],
    "es": [
      "En la plaza del pueblo, en un ambiente de bistró, podrá degustar una cocina sencilla cocinada al fuego, con un chef en acción delante de usted. Una selección de carnes maduradas y vinos populares, todo servido en la pizarra."
    ]
  },
