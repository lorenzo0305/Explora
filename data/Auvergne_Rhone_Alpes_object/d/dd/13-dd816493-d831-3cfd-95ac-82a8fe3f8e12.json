  "rdfs:comment": {
    "de": [
      "Unsere Berater begleiten Sie bei Ihrer Suche nach einem Haus, einer Villa, einem Landhaus, einem Bauernhaus, einem Grundstück, einer Wohnung, einem Anwesen oder einem Schloss in der Drôme Provençale Sud. Joëlle Marie, Perrine, Emilie werden Sie zur Verwirklichung Ihrer Träume vom Hauskauf führen."
    ],
    "en": [
      "Our advisors will guide you in your search for a house, villa, bastide, farmhouse, plot of land, apartment, property or château in Drôme Provençale Sud. Joëlle Marie, Perrine, Emilie will guide you towards the realization of your home-buying dreams."
    ],
    "it": [
      "I nostri consulenti vi aiuteranno nella ricerca di una casa, villa, casa di campagna, agriturismo, terreno, appartamento, proprietà, castello in Drôme Provençale Sud. Joëlle Marie, Perrine, Emilie vi guideranno verso la realizzazione dei vostri sogni di acquisto di una casa."
    ],
    "fr": [
      "Nos conseillers vous accompagneront dans votre recherche de maison, villa, bastide, mas, terrain, appartement, propriété, château en Drôme Provençale Sud. Joëlle Marie, Perrine, Emilie vous guideront vers la concrétisation de vos rêves d'achat de maison."
    ],
    "nl": [
      "Onze adviseurs helpen je bij je zoektocht naar een huis, villa, landhuis, boerderij, stuk grond, appartement, woning of kasteel in Drôme Provençale Sud. Joëlle Marie, Perrine, Emilie begeleiden je bij het verwezenlijken van je droom om een huis te kopen."
    ],
    "es": [
      "Nuestros asesores le ayudarán en la búsqueda de una casa, villa, casa de campo, granja, terreno, piso, propiedad, castillo en Drôme Provençale Sud. Joëlle Marie, Perrine, Emilie le guiarán hacia la realización de sus sueños de comprar una casa."
    ]
  },
