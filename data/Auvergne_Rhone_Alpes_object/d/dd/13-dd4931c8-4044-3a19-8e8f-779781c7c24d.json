  "rdfs:comment": {
    "de": [
      "Ludo & Audrey begrüßen Sie an ihrer neuen Adresse, wo Sie ihre Pizzen und köstlichen Nudeln probieren können. So können Sie sich mit Freunden oder der Familie ein italienisches Essen gönnen! Verkauf zum Mitnehmen oder vor Ort."
    ],
    "en": [
      "Ludo & Audrey welcome you to their new address, where you can enjoy their pizzas and delicious pastas. Perfect for an Italian meal with friends or family! Takeaway or on site."
    ],
    "it": [
      "Ludo & Audrey vi danno il benvenuto nel loro nuovo indirizzo dove potrete gustare le loro pizze e le loro deliziose paste. Perfetto per un pasto italiano con gli amici o la famiglia! Da asporto o sul posto."
    ],
    "fr": [
      "Ludo & Audrey vous accueillent à  leur nouvelle adresse où vous pourrez déguster leurs pizzas et délicieuses pâtes. De quoi se faire un repas italien entre amis ou en famille ! Vente à emporter ou sur place."
    ],
    "es": [
      "Ludo & Audrey te dan la bienvenida a su nueva dirección, donde podrás disfrutar de sus pizzas y deliciosas pastas. Perfecto para una comida italiana con amigos o familia Para llevar o in situ."
    ],
    "nl": [
      "Ludo & Audrey heten je welkom op hun nieuwe adres waar je kunt genieten van hun pizza's en heerlijke pasta's. Perfect voor een Italiaanse maaltijd met vrienden of familie! Afhalen of ter plaatse."
    ]
  },
