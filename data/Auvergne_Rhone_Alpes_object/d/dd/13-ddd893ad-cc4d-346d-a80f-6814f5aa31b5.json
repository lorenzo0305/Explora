  "rdfs:comment": {
    "de": [
      "Fliegen Sie mit einem Tandem-Gleitschirm ab und erleben Sie das einzigartige Gefühl, wie ein Vogel zu schweben. Sie können gehen und traben?\r\nDann können Sie fliegen!"
    ],
    "en": [
      "Take off in a tandem paraglider and discover the unique sensation of soaring like a bird. Can you walk and scoot?\r\nYou can fly!"
    ],
    "it": [
      "Decollate in parapendio in tandem e scoprite la sensazione unica di librarsi in volo come un uccello. Riesce a camminare e a spostarsi?\r\nPuoi volare!"
    ],
    "fr": [
      "Envolez-vous en parapente biplace et découvrez la sensation unique de planer tel un oiseau. Vous savez marcher et trottiner ?\r\nVous pouvez voler !"
    ],
    "nl": [
      "Stijg op in een tandemparaglider en ontdek de unieke sensatie van het zweven als een vogel. Kun je lopen en steppen?\r\nJe kunt vliegen!"
    ],
    "es": [
      "Despegue en un parapente biplaza y descubra la sensación única de volar como un pájaro. ¿Puede caminar y desplazarse?\r\n¡Puedes volar!"
    ]
  },
