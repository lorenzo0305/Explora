  "rdfs:comment": {
    "de": [
      "Das Schwimmbad wird von einem Team aus 7 Erziehern des Syndicat Intercommunal Murois (SIM) betreut und empfängt Sie das ganze Jahr über für Freizeitaktivitäten oder Einzelunterricht."
    ],
    "en": [
      "Animated by a team of 7 educators from the Syndicat Intercommunal Murois (SIM), the swimming pool welcomes you all year round for your leisure or individual lessons."
    ],
    "it": [
      "Gestita da un team di 7 educatori del Syndicat Intercommunal Murois (SIM), la piscina vi accoglie tutto l'anno per le vostre attività ricreative o per le lezioni individuali."
    ],
    "fr": [
      "Animée par une équipe de 7 éducateurs du Syndicat Intercommunal Murois (SIM), la piscine vous accueille toute l’année pour vos loisirs ou leçons individuelles."
    ],
    "nl": [
      "Het zwembad wordt geleid door een team van 7 instructeurs van het Syndicat Intercommunal Murois (SIM) en verwelkomt u het hele jaar door voor uw vrijetijdsactiviteiten of individuele lessen."
    ],
    "es": [
      "Dirigida por un equipo de 7 educadores del Syndicat Intercommunal Murois (SIM), la piscina le acoge durante todo el año para sus actividades de ocio o clases individuales."
    ]
  },
