  "rdfs:comment": {
    "de": [
      "Für Nachmittage mit Freunden oder der Familie bietet Ihnen Aqua Canoë die Möglichkeit, eine Runde mit dem Tretboot auf dem Wasserplan von Ébreuil zu drehen."
    ],
    "en": [
      "For afternoons with friends or family, Aqua Canoë offers pedal-boat rides on the Ébreuil lake."
    ],
    "it": [
      "Per i pomeriggi con gli amici o la famiglia, Aqua Canoë offre la possibilità di fare un giro in pedalò sul lago di Ébreuil."
    ],
    "fr": [
      "Pour des après-midi entre amis ou en famille, Aqua Canoë vous offre la possibilité de faire un tour de pédalo sur le plan d'eau d'Ébreuil."
    ],
