  "rdfs:comment": {
    "de": [
      "Die Loipe La Nicode im authentischen Dorf Mijoux ist ideal, um mit dem Langlaufen zu beginnen.  Sie führt in einer Schleife am Ufer des Flusses Valserine entlang."
    ],
    "en": [
      "The Nicode trail, located in the authentic village of Mijoux, is ideal for beginners to cross-country skiing.  It makes a loop, passing along the banks of the Valserine."
    ],
    "it": [
      "La pista Nicode, situata nell'autentico villaggio di Mijoux, è ideale per i principianti dello sci di fondo.  Compie un anello, passando lungo le rive della Valserina."
    ],
    "fr": [
      "La piste de la Nicode, située dans le village authentique de Mijoux est idéale pour débuter le ski de fond.  Elle fait une boucle en passant en bordure de la Valserine."
    ],
    "es": [
      "La pista Nicode, situada en el auténtico pueblo de Mijoux, es ideal para iniciarse en el esquí de fondo.  Hace un bucle, pasando por las orillas del Valserine."
    ],
    "nl": [
      "De Nicode-loipe, gelegen in het authentieke dorp Mijoux, is ideaal voor beginnende langlaufers.  Het is een lus die langs de oevers van de Valserine loopt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cross-country ski trail : La Nicode"
    ],
    "fr": [
      "Piste de ski de fond : La Nicode"
    ]
  },
