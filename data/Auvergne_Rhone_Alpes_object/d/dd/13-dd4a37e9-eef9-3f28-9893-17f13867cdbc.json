  "rdfs:comment": {
    "de": [
      "Mit Oxygène werden Sie Spaß haben und gleichzeitig lernen, um ein Maximum an Spaß auf den Pisten zu haben! Lassen Sie sich von unserem Team aus leidenschaftlichen Lehrern führen, um das Beste zu entdecken, was Tignes zu bieten hat."
    ],
    "en": [
      "With Oxygène, you'll have fun while you learn, for maximum pleasure on the slopes! Let our team of passionate instructors guide you through the best Tignes has to offer."
    ],
    "it": [
      "Con Oxygène, vi divertirete mentre imparate, per il massimo piacere sulle piste! Lasciate che il nostro team di istruttori appassionati vi guidi attraverso il meglio che Tignes ha da offrire."
    ],
    "fr": [
      "Avec Oxygène vous allez vous amuser tout en apprenant pour un maximum de plaisir sur les pistes ! Laissez-vous guider par notre équipe de moniteurs passionnés pour découvrir ce que Tignes a de meilleur à offrir."
    ],
    "nl": [
      "Met Oxygène heb je plezier terwijl je leert, voor maximaal plezier op de piste! Laat je leiden door ons team van gepassioneerde instructeurs en maak kennis met het beste dat Tignes te bieden heeft."
    ],
    "es": [
      "Con Oxygène, te divertirás mientras aprendes, ¡para disfrutar al máximo en las pistas! Déjese guiar por nuestro equipo de monitores apasionados y descubra lo mejor de Tignes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Oxygene ski & Snowboard Tignes"
    ]
  },
