  "rdfs:comment": {
    "de": [
      "Am nordwestlichen Rand des Landes, im grünen Artois und eingebettet im Herzen des Authie-Tals, erwartet Sie der Garten der 4 Winde, friedlich und tröstlich in Gennes-Ivergny (Pas-de-Calais)."
    ],
    "en": [
      "On the north-western edge of the Artois Vert region, nestling in the heart of the Authie valley, the peaceful and comforting Jardin des 4 vents awaits you in Gennes-Ivergny (Pas-de-Calais)."
    ],
    "it": [
      "Al margine nord-occidentale della regione dell'Artois Vert, nel cuore della valle dell'Authie, il tranquillo e confortevole Jardin des 4 vents vi attende a Gennes-Ivergny (Pas-de-Calais)."
    ],
    "fr": [
      "En bordure Nord-ouest du territoire, dans l'Artois vert et niché au coeur de la vallée de l'Authie, le jardin des 4 vents vous attend, paisible et réconfortant à Gennes-Ivergny (Pas-de-Calais)."
    ],
    "es": [
      "En el extremo noroeste de la región de Artois Vert, enclavado en el corazón del valle de Authie, el tranquilo y reconfortante Jardin des 4 vents le espera en Gennes-Ivergny (Pas-de-Calais)."
    ],
    "nl": [
      "Aan de noordwestelijke rand van de Artois Vert regio, genesteld in het hart van de Authie vallei, wacht de rustige en gezellige Jardin des 4 vents op je in Gennes-Ivergny (Pas-de-Calais)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin des 4 vents"
    ]
  },
