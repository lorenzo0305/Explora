      "@id": "https://data.datatourisme.fr/0097f433-b5c9-3336-bc76-ff1fa58e5ae6",
      "dc:description": {
        "de": [
          "Posturale Yogakurse in Minigruppen von 4 Personen (Erwachsene)\nIn Saint-Martin-Boulogne (Stadtteil Bad'huit)\n                                                                                                                                                                                                                                                                                            \nvon 17.15 bis 18.30 Uhr im Bad'Huit St Martin-Boulogne (vollständige Adresse wird bei der Anmeldung angegeben)\n \nPreis: 15?/Schnupperstunde"
        ],
        "en": [
          "Postural yoga classes in mini-groups of 4 (adults)\nIn Saint-Martin-Boulogne (Bad'huit district)\n                                                                                                                                                                                                                                                                                            \nfrom 5.15pm to 6.30pm at Bad'Huit St Martin-Boulogne (full address given on registration)\n \nPrice: 15?/discovery session"
        ],
        "it": [
          "Lezioni di yoga posturale in mini-gruppi di 4 persone (adulti)\nA Saint-Martin-Boulogne (zona Bad'huit)\n                                                                                                                                                                                                                                                                                            \ndalle 17.15 alle 18.30 a Bad'Huit St Martin-Boulogne (indirizzo completo fornito al momento dell'iscrizione)\n \nPrezzo: € 15 per sessione di scoperta"
        ],
        "fr": [
          "Cours de yoga postural en mini-groupe de 4 personnes (adultes) \nA Saint-Martin-Boulogne (quartier Bad'huit)  \n                                                                                                                                                                                                                                                                                            \nde 17h15  à 18h30 au Bad'Huit St Martin-Boulogne (adresse complète donnée à l'inscription)\n \nTarif  : 15€/séance découverte"
        ],
        "nl": [
          "Houdingsyogalessen in minigroepen van 4 (volwassenen)\nIn Saint-Martin-Boulogne (omgeving Bad'huit)\n                                                                                                                                                                                                                                                                                            \nvan 17.15 tot 18.30 uur in Bad'Huit St Martin-Boulogne (volledig adres bij inschrijving)\n \nPrijs: 15 euro per ontdekking"
        ],
        "es": [
          "Clases de yoga postural en minigrupos de 4 (adultos)\nEn Saint-Martin-Boulogne (zona Bad'huit)\n                                                                                                                                                                                                                                                                                            \nde 17.15 a 18.30 h en Bad'Huit St Martin-Boulogne (dirección completa al inscribirse)\n \nPrecio: 15 euros por sesión de descubrimiento"
        ]
      },
