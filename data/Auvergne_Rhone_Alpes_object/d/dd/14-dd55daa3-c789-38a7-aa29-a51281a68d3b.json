  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b9d8bfb3-b1de-385d-9df8-082f0615d3bf",
      "dc:description": {
        "de": [
          "Handwerklicher Bäcker aus der Region Nord Pas de Calais. Handwerkliche Herstellung von Keksen und süßen oder salzigen Keksen, Croutons und Toast. OHNE KONSERVIERUNGSSTOFFE\nNur natürliche Zutaten.\n\nDer Laden ist montags bis samstags von 10.00 bis 13.00 Uhr und von 14.30 bis 18.30 Uhr geöffnet\nSonntag und Feiertage: 10:00 bis 13:00 Uhr"
        ],
        "en": [
          "Artisan Biscuit maker from Nord Pas de Calais. Artisanal production of sweet and savoury cookies and cakes, croutons and toast. PRESERVATIVE-FREE\nAll natural.\n\nThe store is open Monday to Saturday, 10:00 a.m. to 1:00 p.m. and 2:30 p.m. to 6:30 p.m\nSundays and public holidays: 10:00 a.m. to 1:00 p.m"
        ],
        "it": [
          "Produttore di biscotti artigianali del Nord Pas de Calais. Produzione artigianale di biscotti e torte dolci e salate, crostini e toast. SENZA CONSERVANTI\nTutto naturale.\n\nIl negozio è aperto dal lunedì al sabato, dalle 10.00 alle 13.00 e dalle 14.30 alle 18.30\nDomenica e festivi: dalle 10.00 alle 13.00"
        ],
        "fr": [
          "Artisan Biscuitier du Nord Pas de Calais. Fabrication artisanale de biscuits et gâteaux secs sucrés ou salés, de croûtons et toasts. SANS CONSERVATEUR\nQue du naturel. \n\nLa boutique est ouverte du lundi au samedi de 10 h 00 à  13 h 00 et de 14 h 30 à 18 h 30 \nDimanche et jours fériés : 10 h 00 à 13 h 00"
        ],
        "es": [
          "Galletero artesano de Nord Pas de Calais. Producción artesanal de galletas y pasteles dulces y salados, picatostes y tostadas. SIN CONSERVANTES\nTodo natural.\n\nLa tienda está abierta de lunes a sábado, de 10.00 a 13.00 h. y de 14.30 a 18.30 h\nDomingos y festivos: de 10.00 a 13.00 h"
        ],
        "nl": [
          "Ambachtelijke koekjesfabrikant uit Nord Pas de Calais. Ambachtelijke productie van zoete en hartige koekjes en taarten, croutons en toast. GEEN BEWAARMIDDELEN\nHelemaal natuurlijk.\n\nDe winkel is open van maandag tot zaterdag van 10.00 tot 13.00 en van 14.30 tot 18.30\nZon- en feestdagen: 10.00 tot 13.00 uur"
        ]
      },
