  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/afda03cb-00be-385a-a797-1dc548b557d3",
      "dc:description": {
        "de": [
          "Gestalten Sie Ihr eigenes kleines Recycling-Buch, ein einzigartiges Kunstwerk! Das Falten von Papier wird kein Geheimnis mehr für Sie sein! In diesem kleinen Buch können Sie alles sammeln, was Sie wollen: Samen, Geschichten, Zitate... Eine schöne Art, sich die richtigen Fragen zu stellen."
        ],
        "en": [
          "Come and create your own unique recycled book! Paper folding will hold no secrets for you! This little book can contain anything you like: seeds, stories, quotations... A great way to ask yourself the right questions."
        ],
        "it": [
          "Venite a creare il vostro piccolo libro riciclato, un'opera d'arte unica! La carta piegata non avrà segreti per voi! Questo piccolo libro può contenere tutto ciò che volete: semi, storie, citazioni... Un ottimo modo per porsi le domande giuste."
        ],
        "fr": [
          "Venez créer votre petit livre recyclé, une œuvre unique ! Le pliage de papiers n'aura plus de secret pour vous ! Ce petit livre pourra recueillir ce que vous voulez : graines, histoires, citations... Une belle façon de se poser les bonnes questions."
        ],
        "es": [
          "Ven a crear tu propio librito reciclado, ¡una obra de arte única! El papel plegado no tendrá secretos para ti Este librito puede contener lo que quieras: semillas, historias, citas... Una buena manera de hacerse las preguntas adecuadas."
        ],
        "nl": [
          "Kom en maak je eigen kleine gerecyclede boek, een uniek kunstwerk! Het vouwen van papier heeft geen geheimen voor jou! Dit boekje kan alles bevatten wat je maar wilt: zaden, verhalen, citaten... Een geweldige manier om jezelf de juiste vragen te stellen."
        ]
      },
      "@type": [
        "Description"
