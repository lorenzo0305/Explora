  "rdfs:comment": {
    "de": [
      "Die Ferme Prévost in Cuts bietet Saisongemüse, Erdbeeren, Eier, Gemüsepläne und Blumen zum Verkauf an. Öffnungszeiten: dienstags, donnerstags und freitags von 16 bis 18 Uhr."
    ],
    "en": [
      "The Ferme Prévost in Cuts offers seasonal vegetables, strawberries, eggs, vegetable plans and flowers for sale. Open Tuesday, Thursday and Friday from 4 to 6 pm."
    ],
    "it": [
      "La fattoria Prévost a Cuts offre verdure di stagione, fragole, uova, piantine di verdure e fiori in vendita. Aperto martedì, giovedì e venerdì dalle 16.00 alle 18.00."
    ],
    "fr": [
      "La Ferme Prévost à Cuts propose à la vente légumes de saison, fraises, œufs, plans de légumes et fleurs. Ouverture le mardi,le jeudi et le vendredi de 16h à 18h."
    ],
    "es": [
      "La granja Prévost, en Cuts, ofrece a la venta verduras de temporada, fresas, huevos, planes de cultivo y flores. Abierto los martes, jueves y viernes de 16 a 18 horas."
    ],
    "nl": [
      "De boerderij Prévost in Cuts biedt seizoensgroenten, aardbeien, eieren, groenteplannen en bloemen te koop aan. Geopend op dinsdag, donderdag en vrijdag van 16.00 tot 18.00 uur."
    ]
  },
  "rdfs:label": {
