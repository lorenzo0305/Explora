  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e116a27b-7a5b-35e8-8bb1-2fd40c848a03",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMittwochs und samstags von 9:00 bis 13:00 Uhr\n\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten des Marktes\n\nHändler :\n\n- Obst und Gemüse; Metzger; Fischhändler - Austernhändler; Geflügelhändler - Rotisseur; Milchprodukte - Käse; Extras\n\nBestellungen:\n\nEinige Händler bieten ein Bestellsystem an (Abholung auf dem Markt)\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nWednesday and Saturday, 9am to 1pm\n\n\nPick-up :\nTakeaway during market opening hours\n\nShopkeepers:\n\n- Fruits and vegetables; Butcher; Fishmonger - Oyster seller; Poultry - Roaster; Dairy products - Cheeses; extras\n\nOrders:\n\nSome shopkeepers offer an ordering system (pick-up at the market)\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nMercoledì e sabato dalle 9.00 alle 13.00\n\n\nRitiro :\nDa asporto durante gli orari di apertura del mercato\n\nNegozianti :\n\n- Frutta e verdura; Macelleria; Pescheria - Ostriceria; Pollame - Arrosto; Prodotti lattiero-caseari - Formaggi; Extra\n\nOrdini:\n\nAlcuni commercianti offrono un sistema di ordinazione (ritiro al mercato)\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nLe mercredi et le samedi de 9h à 13h\n\n\nRetrait :\nÀ emporter aux horaires d'ouverture du marché\n\nCommerçants : \n\n- Fruits et légumes ; Boucher ; Poissonnier - Huitrier ; Volailler - Rotisseur ; Produits laitiers - fromagers ; extras\n\nCommandes :\n\nCertains commerçants proposent un système de commande (retrait sur le marché)\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nWoensdag en zaterdag van 9u tot 13u\n\n\nAfhalen :\nAfhalen tijdens openingstijden van de markt\n\nWinkeliers :\n\n- Groenten en fruit; Slager; Visboer - Oesterverkoper; Gevogelte - Braadster; Zuivelproducten - Kaas; Extra's\n\nBestellingen:\n\nSommige handelaars bieden een bestelsysteem aan (afhaling op de markt)\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nMiércoles y sábados de 9h a 13h\n\n\nRecogida :\nPara llevar durante el horario de apertura del mercado\n\nComerciantes :\n\n- Frutas y verduras; Carnicería; Pescadería - Ostrería; Aves - Asador; Lácteos - Quesos; Extras\n\nPedidos:\n\nAlgunos comerciantes ofrecen un sistema de pedidos (recogida en el mercado)\n\n\n "
        ]
      },
