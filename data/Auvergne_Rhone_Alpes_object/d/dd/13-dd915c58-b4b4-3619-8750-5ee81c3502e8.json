  "rdfs:comment": {
    "de": [
      "Das Spa Espace Bien-Être & Soins empfängt Sie das ganze Jahr über im Herzen des größten Sport- und Wellnesskomplexes der Alpen und bietet Ihnen eine breite Palette an Behandlungen sowie einen 2-stündigen Zugang zum Spa."
    ],
    "en": [
      "The Spa Espace Bien-être & Soins welcomes you all year round in the heart of the largest sports and well-being complex in the Alps, and offers a wide range of treatments as well as a 2-hr access to the Spa."
    ],
    "it": [
      "La Spa Espace Bien-Être & Soins accoglie tutto l'anno nel cuore del più grande complesso sportivo e benessere delle Alpi, proponendo una vasta gamma di trattamenti e l'accesso alla spa per 2 ore."
    ],
    "fr": [
      "Le Spa Espace Bien-Être & Soins vous accueille toute l’année au cœur du plus grand complexe sportif et de bien-être des Alpes et vous propose une large gamme de soins ainsi que l’accès au Spa 2h."
    ],
    "es": [
      "El Spa Espace Bien-Être & Soins le da la bienvenida todo el año al corazón del mayor complejo deportivo y de bienestar de los Alpes, ofreciéndole una amplia gama de tratamientos y acceso al Spa durante 2 horas."
    ],
    "nl": [
      "De Spa Espace Bien-Être & Soins verwelkomt je het hele jaar door in het hart van het grootste sport- en wellnesscomplex in de Alpen, met een ruim aanbod aan behandelingen en toegang tot de Spa gedurende 2 uur."
    ]
  },
