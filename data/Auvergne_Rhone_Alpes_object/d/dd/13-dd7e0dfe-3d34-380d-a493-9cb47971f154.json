  "rdfs:comment": {
    "de": [
      "NACHOS bietet mexikanisch inspirierte Gerichte, die auf Wunsch zusammengestellt und vor Ort mit frischen Produkten, französischem Fleisch und keinen Tiefkühlprodukten zubereitet werden. Das Ganze wird vor den Augen des Gastes zubereitet."
    ],
    "en": [
      "NACHOS offers Mexican-inspired dishes, made to order and cooked on the spot using fresh produce, French meats and no frozen products. All prepared before the customer's very eyes."
    ],
    "it": [
      "NACHOS offre piatti di ispirazione messicana, realizzati su ordinazione e cucinati sul posto utilizzando prodotti freschi, carni francesi e nessun prodotto surgelato. Il tutto preparato davanti al cliente."
    ],
    "fr": [
      "NACHOS propose des plats d’inspiration mexicaine, composés à la demande et cuisinés sur place avec des produits frais, des viandes françaises et aucun produit surgelé. Le tout préparé sous les yeux du client."
    ],
    "es": [
      "NACHOS ofrece platos de inspiración mexicana, hechos al momento y cocinados en el propio local con productos frescos, carnes francesas y sin productos congelados. Todo preparado delante del cliente."
    ],
    "nl": [
      "NACHOS biedt Mexicaans geïnspireerde gerechten, op bestelling gemaakt en ter plekke bereid met verse producten, Frans vlees en zonder diepvriesproducten. Alles bereid in het bijzijn van de klant."
    ]
  },
