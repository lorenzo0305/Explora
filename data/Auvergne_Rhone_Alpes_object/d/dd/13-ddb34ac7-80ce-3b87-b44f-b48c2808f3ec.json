  "rdfs:comment": {
    "de": [
      "Bei Fatih 2 haben Sie die Wahl zwischen klassischer Pizza und Pide, einer türkischen Pizza mit einer schönen ovalen Form.\r\nSie können auch die ausgezeichneten orientalischen Patîsserien und Trompe l'oeil-Pâtisserie probieren."
    ],
    "en": [
      "At Fatih 2 you'll be able to choose between classic pizzas and Pide, a pizza of Turkish origin with an attractive oval shape.\r\nYou can also try the excellent oriental patîsseries and trompe l'oeil pastries."
    ],
    "it": [
      "Da Fatih 2 si può scegliere tra le pizze classiche e la Pide, una pizza di origine turca dall'attraente forma ovale.\r\nSi possono anche provare gli ottimi dolci orientali e i pasticcini trompe l'oeil."
    ],
    "fr": [
      "Chez Fatih 2 vous aurez le choix entre pizza classique et Pide, pizza d’origine turque possédant une jolie forme ovale.\r\nVous pourrez également goûter les excellentes patîsseries orientales et pâtisseries en trompe l'oeil."
    ],
    "es": [
      "En Fatih 2 podrá elegir entre pizzas clásicas y Pide, una pizza de origen turco con una atractiva forma ovalada.\r\nTambién puede probar la excelente pastelería oriental y los trampantojos."
    ],
    "nl": [
      "Bij Fatih 2 kun je kiezen uit klassieke pizza's en Pide, een pizza van Turkse oorsprong met een aantrekkelijke ovale vorm.\r\nJe kunt ook de uitstekende oosterse gebakjes en trompe l'oeil gebakjes proberen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Fatih 2 - Pide et pizza"
    ]
  },
