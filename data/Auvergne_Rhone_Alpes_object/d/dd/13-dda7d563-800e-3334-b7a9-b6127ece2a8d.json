  "rdfs:comment": {
    "de": [
      "Eine Stunde und 15 Minuten lang geht es mit der One Violin Band auf eine Reise durch Cocazie mit Trommeln und Geigen, eine visuelle und musikalische Reise mit flammender Folklore, für alle Zuschauer ab 6 Jahren."
    ],
    "en": [
      "For 1 hour 15 minutes, join the One Violin Band on a visual and musical journey through Cocazie's flamboyant folklore, for all ages 6 and up."
    ],
    "it": [
      "Per 1 ora e 15 minuti, accompagnate la One Violin Band in un viaggio visivo e musicale attraverso il folklore fiammeggiante delle Cocazie con tamburi e violini, per tutte le età dai 6 anni in su."
    ],
    "fr": [
      "Durant 1h15, partez pour une traversée de Cocazie en tambours et violons avec le One violin band pour un voyage visuel et musical au folklore flamboyant, pour tout public dès 6ans."
    ],
    "nl": [
      "Neem de One Violin Band 1 uur en 15 minuten mee op een visuele en muzikale reis door de flamboyante folklore van Cocazie met trommels en violen, voor alle leeftijden vanaf 6 jaar."
    ],
    "es": [
      "Durante 1 hora y 15 minutos, acompañe a la One Violin Band en un viaje visual y musical a través del flamante folclore de Cocazie con tambores y violines, para todos los públicos a partir de 6 años."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert folklore \"Cavalcade en Cocazie\""
    ]
  },
