  "rdfs:comment": {
    "de": [
      "."
    ],
    "en": [
      "On the village square, JJérôme, Jérémy et Mathias have the pleasure of welcoming you"
    ],
    "it": [
      "Sulla piazza del villaggio, Jérôme, Jérémy e Mathias sono lieti di accogliervi e di offrirvi la cucina di montagna.\r\nPiacevole terrazza in legno."
    ],
    "fr": [
      "Sur la place du village, Jérôme, Jérémy et Mathias  ont le plaisir de vous accueillir et vous proposent une cuisine montagnarde. \r\nAgréable terrasse en bois."
    ],
    "nl": [
      "Op het dorpsplein heten Jérôme, Jérémy en Mathias je van harte welkom en bieden ze je een bergkeuken.\r\nAangenaam houten terras."
    ],
    "es": [
      "Jérôme, Jérémy y Mathias están encantados de recibirle en la plaza del pueblo, donde sirven cocina de montaña.\r\nAgradable terraza de madera."
    ]
  },
