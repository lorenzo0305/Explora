  "rdfs:comment": {
    "de": [
      "Die Mission Locale ist ein Verein mit dem Ziel, Jugendliche zwischen 16 und 25 Jahren und RSA-Empfänger in den Bereichen Zugang zu Beschäftigung, Beratung, Ausbildung und Alltagsleben (Gesundheit, Wohnung, Mobilität, ...) zu begleiten."
    ],
    "en": [
      "Mission Locale is an association dedicated to supporting young people aged 16 to 25 and RSA beneficiaries in their access to employment, guidance, training and daily life (health, housing, mobility, etc.)."
    ],
    "it": [
      "La Missione Locale è un'associazione il cui obiettivo è sostenere i giovani tra i 16 e i 25 anni e i beneficiari di RSA nell'accesso al lavoro, all'orientamento, alla formazione e alla vita quotidiana (salute, alloggio, mobilità, ecc.)."
    ],
    "fr": [
      "La Mission Locale est une association ayant pour but d’accompagner  les jeunes de 16 à 25 ans et les  bénéficiaires du RSA  dans les domaines de l’accès à l’emploi, à l’orientation, à la formation, et à la vie quotidienne (santé, logement, mobilité,…)."
    ],
    "es": [
      "La Misión Local es una asociación cuyo objetivo es apoyar a los jóvenes de 16 a 25 años y a los beneficiarios de la RSA en los ámbitos del acceso al empleo, la orientación, la formación y la vida cotidiana (salud, vivienda, movilidad, etc.)."
    ],
    "nl": [
      "De Mission Locale is een vereniging die als doel heeft jongeren tussen 16 en 25 jaar en jongeren met een RSA te ondersteunen in hun toegang tot werk, begeleiding, opleiding en het dagelijkse leven (gezondheid, huisvesting, mobiliteit, enz.)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mission Locale Drôme Provençale"
    ]
  },
