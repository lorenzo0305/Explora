  "rdfs:comment": {
    "de": [
      "Der pädagogische Bauernhof in Coise heißt Groß und Klein willkommen, um Hunde, Kaninchen, Hühner und Schafe zu entdecken. Spielerische und pädagogische Aktivitäten rund um die Tiere, Pflege, Motorik und Entdeckung der ländlichen Umgebung für alle."
    ],
    "en": [
      "The Coise educational farm welcomes young and old to discover dogs, rabbits, chickens and sheep. Fun and educational activities around animals, care, motor skills and discovery of the rural environment for all."
    ],
    "it": [
      "La fattoria didattica Coise accoglie grandi e piccini alla scoperta di cani, conigli, galline e pecore. Attività ludiche ed educative sugli animali, la cura, la motricità e la scoperta dell'ambiente rurale per tutti."
    ],
    "fr": [
      "La ferme pédagogique de Coise, accueille petits et grands pour découvrir chiens, lapins, poules et moutons. Activités ludiques et éducatives autour des animaux, soins, motricité et découverte du milieu rural pour tous."
    ],
    "es": [
      "La granja educativa Coise acoge a pequeños y mayores para descubrir perros, conejos, gallinas y ovejas. Actividades lúdicas y educativas en torno a los animales, los cuidados, la motricidad y el descubrimiento del medio rural para todos."
    ],
    "nl": [
      "De educatieve boerderij Coise verwelkomt jong en oud om honden, konijnen, kippen en schapen te ontdekken. Leuke en leerzame activiteiten rond dieren, verzorging, motoriek en ontdekking van de landelijke omgeving voor iedereen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ferme pédagogique de Coise"
    ]
  },
