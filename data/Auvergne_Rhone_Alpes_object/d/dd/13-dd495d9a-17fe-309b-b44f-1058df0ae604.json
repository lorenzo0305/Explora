  "rdfs:comment": {
    "de": [
      "Neben dem Minigolfplatz und auf der Spielwiese gibt es Trampoline für die Jüngsten ab 2 Jahren."
    ],
    "en": [
      "Trampolines in Avoriaz\r\nLocated on the Plaine des Jeux, right next to the mini-golf course, the trampolines offer children a fun and bouncy space to let off steam safely"
    ],
    "it": [
      "Trampolini ad Avoriaz\r\nSituati nel parco giochi accanto al minigolf, i trampolini offrono ai bambini un luogo divertente e rimbalzante per sfogarsi in tutta sicurezza!"
    ],
    "fr": [
      "Trampolines à Avoriaz\r\nSitués sur la plaine des jeux et à côté du mini-golf, les trampolines offrent aux enfants un espace ludique et rebondissant pour se défouler en toute sécurité !"
    ],
    "nl": [
      "Trampolines in Avoriaz\r\nGelegen op de Plaine des Jeux, vlak naast de minigolf, bieden de trampolines kinderen een leuke en veerkrachtige speelplek waar ze zich veilig kunnen uitleven!"
    ],
    "es": [
      "Camas elásticas en Avoriaz\r\nSituadas en el parque infantil, junto al minigolf, las camas elásticas ofrecen a los niños un lugar divertido y lleno de saltos para desahogarse con total seguridad"
    ]
  },
  "rdfs:label": {
    "de": [
      "Trampoline für die Jüngsten"
    ],
    "en": [
      "Trampoline for young"
    ],
    "fr": [
      "Trampolines pour les plus jeunes"
    ]
  },
