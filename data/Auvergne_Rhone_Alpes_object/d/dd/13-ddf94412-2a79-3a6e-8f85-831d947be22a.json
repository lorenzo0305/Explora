  "rdfs:comment": {
    "de": [
      "Gemütliches Chalet inmitten einer natürlichen Umgebung.\r\nZu Ihrer Verfügung stehen 15 gemütliche Zimmer mit savoyischem Charakter und ein 100m² großes Spa.\r\nEin angenehmer Ort für Ihren Urlaub in einer grünen Oase, mit auch einem im Sommer beheizten Schwimmbad."
    ],
    "en": [
      "Hotel located in a quiet area, only 300 meters from the village center and its amenities."
    ],
    "it": [
      "Chalet accogliente nel cuore di un ambiente naturale.\r\nA vostra disposizione 15 camere calde dal carattere savoiardo e una spa di 100 m².\r\nUno spazio piacevole per le vostre vacanze in un ambiente verde, con anche una piscina riscaldata in estate."
    ],
    "fr": [
      "Chalet douillet au cœur d'un environnement naturel.\r\nÀ votre disposition 15 chambres chaleureuses au caractère savoyard et un spa de 100m².\r\nUn espace agréable pour vos vacances dans un écrin de verdure, avec aussi une piscine chauffée en période estivale."
    ],
    "nl": [
      "Gezellig chalet midden in de natuur.\r\nTot uw beschikking staan 15 warme kamers met een Savoyaards karakter en een spa van 100m².\r\nEen aangename ruimte voor uw vakantie in een groene omgeving, met ook een verwarmd zwembad in de zomer."
    ],
    "es": [
      "Acogedor chalet en el corazón de un entorno natural.\r\nA su disposición 15 cálidas habitaciones de carácter saboyano y un spa de 100m².\r\nUn espacio agradable para sus vacaciones en un entorno verde, con también una piscina climatizada en verano."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel Beau Site"
    ],
    "fr": [
      "Hôtel Beau Site"
    ]
  },
