  "rdfs:comment": {
    "de": [
      "Diese Kirche wurde 1837 von dem Architekten François Amoudruz errichtet. Sie besitzt einen Glockenturm mit einer für Savoyen typischen Kupferzwiebel, die ursprünglich aus Weißblech bestand. Sie ist im Renaissancestil erbaut und wurde zuletzt 2008 renoviert."
    ],
    "en": [
      "This church was built in 1837 by the architect François Amoudruz. It features a typically Savoyard copper bulb steeple, which was originally made of tinplate. It is Renaissance in style and was recently renovated in 2008."
    ],
    "it": [
      "Questa chiesa fu costruita nel 1837 dall'architetto François Amoudruz. Ha un campanile a bulbo di rame tipicamente savoiardo, che in origine era di latta. È in stile rinascimentale ed è stata recentemente ristrutturata nel 2008."
    ],
    "fr": [
      "Cette église est érigée en 1837 par l'architecte François Amoudruz. Elle est dotée d'un clocher à bulbe en cuivre typiquement savoyard, qui était à l'origine en fer blanc. Elle est de style Renaissance et a été dernièrement rénovée en 2008."
    ],
    "es": [
      "Esta iglesia fue construida en 1837 por el arquitecto François Amoudruz. Tiene un campanario de bulbo de cobre típicamente saboyano, que originalmente era de hojalata. Es de estilo renacentista y fue renovada recientemente, en 2008."
    ],
    "nl": [
      "Deze kerk werd in 1837 gebouwd door de architect François Amoudruz. Het heeft een typisch Savoyaardse koperen klokkentoren, die oorspronkelijk van blik was gemaakt. Het is in renaissancestijl en werd onlangs gerenoveerd in 2008."
    ]
  },
  "rdfs:label": {
