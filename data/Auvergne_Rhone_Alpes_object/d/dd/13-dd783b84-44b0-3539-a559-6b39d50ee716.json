  "rdfs:comment": {
    "de": [
      "Produktion verschiedener für die Region Cevennen typischer Honigsorten, insbesondere Kastanienhonig. Ganzjährig erhältlich. Verkauf im Hofladen La Biasso in Jaujac. Im Sommer auf dem Markt in Burzet und manchmal auch auf dem Markt in Jaujac erhältlich."
    ],
    "en": [
      "Production of various honeys typical of the Cévennes region, particularly chestnut honey. Available all year round. Sold at the La Biasso farm shop in Jaujac. Available at the Burzet market in summer and sometimes at the Jaujac market in summer."
    ],
    "it": [
      "Produzione di vari mieli tipici della regione delle Cévennes, in particolare il miele di castagno. Disponibile tutto l'anno. Venduto nel negozio dei produttori di Biasso a Jaujac. Bancarelle a Burzet in estate e a Jaujac di tanto in tanto in estate."
    ],
    "fr": [
      "Production de divers miels typiques de terroirs cévenols, en particulier du miel de châtaignier. Disponible toute l'année. Vente en magasin de producteurs la Biasso à Jaujac. Présent sur le marché de Burzet l'été et de Jaujac parfois l'été."
    ],
    "nl": [
      "Productie van verschillende honingsoorten die typisch zijn voor de Cevennen, in het bijzonder kastanjehoning. Het hele jaar door verkrijgbaar. Wordt verkocht in de winkel van de producenten van Biasso in Jaujac. Marktkraampjes in Burzet in de zomer en in Jaujac van tijd tot tijd in de zomer."
    ],
    "es": [
      "Producción de distintas mieles típicas de la región de las Cevenas, en particular miel de castaño. Disponible todo el año. Venta en la tienda de los productores de Biasso en Jaujac. Puestos de mercado en Burzet en verano y en Jaujac de vez en cuando en verano."
    ]
  },
