  "rdfs:comment": {
    "de": [
      "Le Solstice - Terrasses du Yule und seine Bar sind das Herzstück der Schneefront und gehören zu den unumgänglichen Orten in Val d'Isère."
    ],
    "en": [
      "The beating heart of the snow front, Le Solstice - Le Yule terraces and its Bar are among the must-see places in Val d'Isère."
    ],
    "it": [
      "Cuore pulsante del fronte neve, Le Solstice e il suo Bar sono tra i luoghi imperdibili della Val d'Isère."
    ],
    "fr": [
      "Cœur battant du front de neige, Le Solstice - Terrasses du Yule et son Bar font partie des lieux incontournables de Val d’Isère."
    ],
    "nl": [
      "Het kloppende hart van het sneeuwfront, Le Solstice - Terrasses du Yule en de bar zijn een van Val d'Isère's must-sees."
    ],
    "es": [
      "Corazón palpitante del frente de nieve, Le Solstice - Terrasses du Yule y su Bar son una de las visitas obligadas de Val d'Isère."
    ]
  },
