  "rdfs:comment": {
    "de": [
      "- 13.00 - 14.00 Uhr: Aquasport-Aktivitäten, begrenzte Plätze und Reservierung erforderlich.\r\n- Tout Public 14.00 - 18.30 Uhr: 40 Erwachsenenplätze für das Schwimmen in der Wasserlinie und 20 Kinderplätze, die von einem Bademeister betreut werden."
    ],
    "en": [
      "-\t1 to 2 p.m.: aquasport activity, places are limited and must be booked in advance.\r\n-\tAll Public 2:00 pm ? 6:30pm: 40 adult places for inline swimming and 20 places for children supervised by a lifeguard"
    ],
    "it": [
      "-\tdalle 13.00 alle 14.00: attività di acquasport, i posti sono limitati e devono essere prenotati in anticipo.\r\n-\tTutto il pubblico 14.00 ? 18.30: 40 posti per adulti per il nuoto in linea e 20 posti per bambini con la supervisione di un bagnino"
    ],
    "fr": [
      "-\t13h à 14h00 :  activité aquasport, places limitées et sur réservation .\r\n-\tTout Public 14h00 – 18h30 : 40 places adultes pour la nage en ligne d’eau et 20 places enfants encadrés par un maitre-nageur"
    ],
    "es": [
      "-\tde 13.00 a 14.00 h: actividad de aquasport, las plazas son limitadas y deben reservarse con antelación.\r\n-\tTodos los públicos 14.00 h ? 18.30 h: 40 plazas para adultos en natación en línea y 20 plazas para niños supervisados por un socorrista"
    ],
    "nl": [
      "- 13.00 - 14.00 uur: aquasportactiviteit, plaatsen zijn beperkt en moeten van tevoren worden gereserveerd.\r\n- Open voor iedereen 14.00 - 18.30 uur: 40 plaatsen voor volwassenen voor inlinezwemmen en 20 plaatsen voor kinderen onder toezicht van een badmeester."
    ]
  },
