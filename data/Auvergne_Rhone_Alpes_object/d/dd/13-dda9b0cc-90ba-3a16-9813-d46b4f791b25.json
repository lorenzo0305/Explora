  "rdfs:comment": {
    "de": [
      "Isabelle und Max empfangen Sie in einer wunderschönen Umgebung mit einer Sonnenterrasse. Spezialitäten aus den Bergen, mittags Tagesgericht und am Wochenende à la carte. Einige Spezialitäten aus Nordfrankreich ebenfalls."
    ],
    "en": [
      "Isabelle and Max welcome you in a great place with a sunny terrasse. Mountain specialties, menu of the day at noon and \"à la carte\" on week-ends."
    ],
    "it": [
      "Isabelle e Max vi accolgono in un ambiente magnifico con una terrazza soleggiata. Specialità di montagna, piatto del giorno a pranzo e à la carte nel fine settimana. Anche alcune specialità del nord della Francia."
    ],
    "fr": [
      "Isabelle et Max vous accueillent dans un cadre magnifique avec une terrasse ensoleillée. Spécialités montagnardes, plat du jour le midi et à la carte le week-end. Quelques spécialités du Nord de la France également."
    ],
    "es": [
      "Isabelle y Max le dan la bienvenida en un magnífico marco con una soleada terraza. Especialidades de montaña, plato del día al mediodía y a la carta los fines de semana. También algunas especialidades del norte de Francia."
    ],
    "nl": [
      "Isabelle en Max heten je welkom in een prachtige omgeving met een zonnig terras. Bergspecialiteiten, dagschotel 's middags en à la carte in het weekend. Ook enkele Noord-Franse specialiteiten."
    ]
  },
