  "rdfs:comment": {
    "de": [
      "Das Rennen und Fest der jungen Skifahrer mit Jean-Baptiste Grange! Die ESF, der Jb Grange Fan Club und der Ski Club von Valloire organisieren gemeinsam mit der SEM, dem Rathaus, der AEP und Valloire Tourisme ein alpines Skirennen für Kinder mit und ohne Lizenz."
    ],
    "en": [
      "The ski race and festival for young skiers with Jean-Baptiste Grange! The ESF, the Jb Grange Fan Club and the Valloire Ski Club, co-organize with the SEM, the Town Hall, the AEP and Valloire Tourisme the alpine ski race-event dedicated to children, whether licensed or not."
    ],
    "it": [
      "La gara e la festa dei giovani sciatori con Jean-Baptiste Grange! L'ESF, il Jb Grange Fan Club e il Valloire Ski Club, co-organizzano con la SEM, il Municipio, l'AEP e Valloire Tourisme la gara-evento di sci alpino dedicato ai bambini, tesserati e non."
    ],
    "fr": [
      "La course et fête des jeunes skieurs avec Jean-Baptiste Grange! L'ESF, le Fan Club Jb Grange et le Ski Club de Valloire, co-organisent avec la SEM, la Mairie, l'AEP et Valloire Tourisme la course-événement de ski alpin dédiée aux enfants licenciés ou non."
    ],
    "es": [
      "La carrera y la fiesta de los jóvenes esquiadores con Jean-Baptiste Grange El FSE, el Club de Aficionados Jb Grange y el Club de Esquí de Valloire, junto con el SEM, el Ayuntamiento, la AEP y Valloire Tourisme, organizan conjuntamente la carrera-evento de esquí alpino dedicada a los niños, sean o no miembros del club de esquí."
    ],
    "nl": [
      "Een wedstrijd en het feest van de jonge skiërs, met Jean-Baptiste Grange! De ESF, de Jb Grange Fan Club en de Valloire Ski Club organiseren samen met de SEM, het stadhuis, de AEP en Valloire Tourisme het alpineski-race-evenement voor kinderen, ongeacht of ze een vergunning hebben of niet."
    ]
  },
