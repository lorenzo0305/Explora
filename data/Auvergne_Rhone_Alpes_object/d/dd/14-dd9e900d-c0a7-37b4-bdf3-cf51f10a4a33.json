  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/276a9842-38a3-3ad4-b844-410e1fefbc7a",
      "dc:description": {
        "de": [
          "Die Künstlerin Fanny Ducassé liest Ihnen aus ihren Alben vor, um Ihren Appetit anzuregen, und leitet anschließend einen kreativen Workshop, um Sie in ihr zartes künstlerisches Universum voller Details und Farben eintauchen zu lassen."
        ],
        "en": [
          "The artist Fanny Ducassé will read her albums to whet your appetite and then lead a creative workshop to immerse you in her delicate artistic universe, teeming with details and colors."
        ],
        "it": [
          "L'artista Fanny Ducassé leggerà i suoi album per stuzzicare l'appetito, poi condurrà un laboratorio creativo per immergervi nel suo delicato mondo artistico, ricco di dettagli e colori."
        ],
        "fr": [
          "L’artiste Fanny Ducassé vient vous lire ses albums pour vous mettre en appétit puis animera un atelier créatif pour vous imprégner de son univers artistique délicat, foisonnant de détails et de couleurs."
        ],
        "es": [
          "La artista Fanny Ducassé leerá sus álbumes para abrir el apetito, y después dirigirá un taller creativo para sumergirle en su delicado mundo artístico, rebosante de detalles y color."
        ],
        "nl": [
          "Kunstenares Fanny Ducassé zal haar albums voorlezen om je eetlust op te wekken, waarna ze een creatieve workshop zal leiden om je onder te dompelen in haar delicate artistieke wereld, die barst van de details en kleuren."
        ]
      },
