  "rdfs:comment": {
    "de": [
      "Das Hôtel de Lyon ist ein angenehmer Aufenthalts- oder Etappenort, nur wenige Schritte vom Thermalbad und den Parks entfernt. Es verbindet den Charme des Alten mit modernem Komfort in einer herzlichen und familiären Atmosphäre."
    ],
    "en": [
      "Grand Hôtel de Lyon is ideal for any length of stay near the spa centre and parks. It blends age-old charm and all mod cons in a warm and friendly setting."
    ],
    "it": [
      "Piacevole luogo di soggiorno o di sosta, a soli 10 metri dalle terme e a 25 metri dai parchi, l'Hôtel de Lyon unisce il fascino del passato ai comfort moderni in un'atmosfera calda e familiare."
    ],
    "fr": [
      "Agréable lieu de séjour ou d’étape, à 10 mètres de l’établissement thermal et à 25 mètres des parcs, l’Hôtel de Lyon allie le charme de l’ancien au confort moderne, dans une ambiance chaleureuse et familiale."
    ],
    "nl": [
      "Hôtel de Lyon is een aangename plek om te verblijven of een tussenstop te maken, op een steenworp afstand van de spa en de parken, en combineert de charme van het verleden met modern comfort in een warme, familiale sfeer."
    ],
    "es": [
      "Agradable lugar de estancia o de escala, a 10 metros del balneario y a 25 metros de los parques, el Hôtel de Lyon combina el encanto del pasado con las comodidades modernas en un ambiente cálido y familiar."
    ]
  },
