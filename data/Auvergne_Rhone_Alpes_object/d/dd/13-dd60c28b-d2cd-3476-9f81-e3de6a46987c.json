  "rdfs:comment": {
    "de": [
      "Wir hören Ihnen zu und begleiten Sie bei Ihren Projekten und Ihrem Versicherungsbedarf. Aréas Assurances bietet seinen Kunden dank einer vertrauensvollen und kundennahen Beziehung effiziente Leistungen."
    ],
    "en": [
      "We are here to help you with your projects and insurance needs. Aréas Assurances provides its customers with efficient services thanks to a relationship based on trust and proximity."
    ],
    "it": [
      "Siamo qui per aiutarvi con i vostri progetti e le vostre esigenze assicurative. Aréas Assurances fornisce ai propri clienti servizi efficienti grazie a un rapporto basato sulla fiducia e sulla vicinanza."
    ],
    "fr": [
      "Nous sommes à votre écoute pour vous accompagner dans vos projets et vos besoins d’assurance. Aréas Assurances apporte à ses clients des prestations efficaces grâce à une relation de confiance et de proximité."
    ],
    "nl": [
      "Wij zijn er om u te helpen bij uw projecten en uw verzekeringsbehoeften. Aréas Assurances biedt haar klanten efficiënte diensten dankzij een relatie gebaseerd op vertrouwen en nabijheid."
    ],
    "es": [
      "Estamos aquí para ayudarle con sus proyectos y sus necesidades en materia de seguros. Aréas Assurances ofrece a sus clientes servicios eficaces gracias a una relación basada en la confianza y la proximidad."
    ]
  },
  "rdfs:label": {
