  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Dahu liegt ideal im Herzen des Dorfes Argentière, nur 10 Minuten von Chamonix entfernt, und empfängt Sie in einer herzlichen Atmosphäre."
    ],
    "en": [
      "Ideally located in the heart of the village of Argentière, just 10 minutes from Chamonix, Le Dahu restaurant welcomes you in a warm atmosphere."
    ],
    "it": [
      "Situato in posizione ideale nel cuore del villaggio di Argentière, a soli 10 minuti da Chamonix, il ristorante Le Dahu vi accoglie in una calda atmosfera."
    ],
    "fr": [
      "Idéalement situé en plein cœur du village d’Argentière, à seulement 10 minutes de Chamonix, le restaurant Le Dahu vous accueille dans une atmosphère chaleureuse."
    ],
    "es": [
      "Idealmente situado en el corazón del pueblo de Argentière, a sólo 10 minutos de Chamonix, el restaurante Le Dahu le da la bienvenida en un ambiente cálido."
    ],
    "nl": [
      "Ideaal gelegen in het hart van het dorp Argentière, op slechts 10 minuten van Chamonix, verwelkomt het restaurant Le Dahu u in een warme sfeer."
    ]
