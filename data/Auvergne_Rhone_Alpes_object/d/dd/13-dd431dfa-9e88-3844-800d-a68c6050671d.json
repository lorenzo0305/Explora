  "rdfs:comment": {
    "de": [
      "Komm und entdecke die Welt des Lesens.\r\nTeppichklopfer, Märchen aller Art, digitale Bücher, Spielbereich mit der Ludothek Panique Ludique.\r\n\r\nAlles ist vorhanden, um die Freuden des Lesens und des Buches zu teilen."
    ],
    "en": [
      "Come and discover the world of reading.\r\nRaconte-tapis, tales of all kinds, digital books, games area with the Panique Ludique toy library.\r\n\r\nEverything you need to share the pleasures of reading and books."
    ],
    "it": [
      "Venite a scoprire il mondo della lettura.\r\nRaconte-tapis, racconti di ogni genere, libri digitali, area giochi con la ludoteca Panique Ludique.\r\n\r\nTroverete tutto il necessario per condividere il piacere della lettura e dei libri."
    ],
    "fr": [
      "Viens découvrir l'univers de la lecture. \r\nRaconte-tapis, contes en tout genre, livres numériques, espace jeux avec la ludothèque Panique Ludique.\r\n\r\nTout est au rendez-vous pour partager les plaisirs de la lecture et du livre."
    ],
    "es": [
      "Venga a descubrir el mundo de la lectura.\r\nRaconte-tapis, cuentos de todo tipo, libros digitales, zona de juegos con la ludoteca Panique Ludique.\r\n\r\nEncontrará todo lo necesario para compartir los placeres de la lectura y los libros."
    ],
    "nl": [
      "Kom de wereld van het lezen ontdekken.\r\nRaconte-tapis, allerlei soorten verhalen, digitale boeken, speelruimte met de speelgoedbibliotheek Panique Ludique.\r\n\r\nJe vindt er alles wat je nodig hebt om het plezier van lezen en boeken te delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Programme parentalité - Lire & jouer pour découvrir ensemble"
    ]
  },
