  "rdfs:comment": {
    "de": [
      "Eine der schönsten und weitläufigsten Kletterschulen in Hochsavoyen (170 m Höhe, alle Niveaus). Der Sektor Moulinette ist für Kinder reserviert.\r\nTopo-Führer im Bureau des Guides et Accompagnateurs und im Maison de la Presse erhältlich."
    ],
    "en": [
      "The fully equipped climbing rock \"La Duchère\", situated in the Pontet leisure park is a fantastic site for both learning and improving your climbing skills. Training wall and two equipped kis walls."
    ],
    "it": [
      "Una delle scuole di arrampicata più belle e grandi dell'Alta Savoia (170 m di altezza, tutti i livelli). Area di molaggio riservata ai bambini.\r\nGuida topografica in vendita presso l'Ufficio Guide e Accompagnatorie e in edicola."
    ],
    "fr": [
      "L'une des plus belles et vastes écoles d'escalade de Haute Savoie (170 m de hauteur, tous niveaux). Secteur moulinette réservé aux enfants.\r\nTopo guide en vente au Bureau des Guides et Accompagnateurs, et à la Maison de la Presse."
    ],
    "es": [
      "Una de las escuelas de escalada más bellas y extensas de la Alta Saboya (170 m de altura, todos los niveles). El sector de la cuerda superior está reservado a los niños.\r\nGuía topo a la venta en el Bureau des Guides et Accompagnateurs, y en la Maison de la Presse."
    ],
    "nl": [
      "Een van de mooiste en meest uitgestrekte klimscholen van de Haute Savoie (170 m hoog, alle niveaus). De bovenste touwsector is gereserveerd voor kinderen.\r\nTopogids te koop bij het Bureau des Guides et Accompagnateurs, en bij het Maison de la Presse."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing Rock : La Duchère"
    ],
    "it": [
      "Roccia per arrampicata della Duchère"
    ],
    "fr": [
      "Rocher d'escalade de la Duchere"
    ]
  },
