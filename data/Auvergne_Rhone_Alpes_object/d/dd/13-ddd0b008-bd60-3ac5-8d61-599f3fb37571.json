  "rdfs:comment": {
    "de": [
      "In La Paillote erwartet Sie nur wenige Minuten von Lyon entfernt ein Urlaubsklima. Zusätzlich zum Restaurant genießen Sie an unserem Privatstrand mit den Füßen im Sand ein Eis oder einen Cocktail."
    ],
    "en": [
      "A holiday atmosphere awaits you at La Paillote, just a few minutes from Lyon. In addition to its great food, you can enjoy ice cream or a cocktail on our private beach and feel the sand between your toes."
    ],
    "it": [
      "Un'aria di vacanze ti aspetta alla Paillote, a solo pochi minuti da Lione. Oltre alla ristorazione, gusta un gelato o un cocktail sulla nostra spiaggia privata, giocando con la sabbia."
    ],
    "fr": [
      "Un air de vacances vous attend à La Paillote, à seulement quelques minutes de Lyon. En plus de la restauration, dégustez une glace ou un cocktail sur notre plage privée, les pieds dans le sable."
    ],
    "es": [
      "En La Paillote se respiran las vacaciones, a tan solo unos minutos de Lyon. Además del servicio de restauración, ofrecemos helados y cócteles en nuestra playa privada, con los pies en la arena."
    ],
    "nl": [
      "Een vakantiegevoel wacht op u in La Paillote, op enkele minuten van Lyon. Naast het restaurant kunt u genieten van een ijsje of een cocktail op ons privéstrand, met uw voeten in het zand."
    ]
  },
