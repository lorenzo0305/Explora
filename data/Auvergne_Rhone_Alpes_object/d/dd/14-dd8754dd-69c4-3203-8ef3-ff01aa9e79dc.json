      "@id": "https://data.datatourisme.fr/a2898c0e-8fdc-3972-8422-5212b92d81d8",
      "dc:description": {
        "de": [
          "Immobilienmaklerin nur nach Terminvereinbarung. Um zahlreiche Anfragen zu befriedigen, suche ich Häuser und Wohnungen zum Verkauf in der Gegend von Camiers-Sainte-Cécile und Umgebung."
        ],
        "en": [
          "Real estate sales agent by appointment only. In order to satisfy numerous requests, I am looking to sell houses and apartments in the Camiers-Sainte-Cécile area and the surrounding region."
        ],
        "it": [
          "Agente immobiliare solo su appuntamento. Per soddisfare numerose richieste, sto cercando di vendere case e appartamenti nella zona di Camiers-Sainte-Cécile e nella regione circostante."
        ],
        "fr": [
          "Agent commercial en immobilier uniquement sur rendez-vous. Afin de satisfaire de nombreuses demandes, je recherche à la vente des maisons et appartements sur le secteur de Camiers-Sainte-Cécile et aux alentours."
        ],
        "nl": [
          "Makelaar alleen op afspraak. Om aan de vele aanvragen te voldoen, ben ik op zoek naar huizen en appartementen in de omgeving van Camiers-Sainte-Cécile en de omliggende regio."
        ],
        "es": [
          "Agente inmobiliario con cita previa. Para satisfacer numerosas solicitudes, busco vender casas y pisos en la zona de Camiers-Sainte-Cécile y alrededores."
        ]
      },
