  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt der Loire-Schluchten empfängt Sie das ganze Jahr über und gibt Ihnen Auskünfte über Wanderungen, Besichtigungen und Aktivitäten im Gebiet der Loire-Semène und der Loire-Schluchten."
    ],
    "en": [
      "The Gorges de la Loire tourist office welcomes you all year along to give you some informations about hiking, the visits and the activities on the Loire Semène and Gorges de la Loire region."
    ],
    "it": [
      "L'Ufficio del Turismo delle Gole della Loira è aperto tutto l'anno per fornire informazioni su passeggiate, visite e attività nelle zone della Loira-Semenza e delle Gole della Loira."
    ],
    "fr": [
      "L'office de Tourisme des Gorges de la Loire vous accueille toute l'année pour vous donner les renseignements sur les randonnées, les visites et les activités sur le territoire Loire-Semène et des Gorges de la Loire."
    ],
    "es": [
      "La Oficina de Turismo de las Gargantas del Loira está abierta todo el año para informarle sobre paseos, visitas y actividades en la región Loira-Semena y las Gargantas del Loira."
    ],
    "nl": [
      "Het VVV-kantoor van de Gorges de la Loire is het hele jaar geopend voor informatie over wandelingen, bezoeken en activiteiten in de Loire-Semène en de Gorges de la Loire."
    ]
  },
  "rdfs:label": {
    "en": [
