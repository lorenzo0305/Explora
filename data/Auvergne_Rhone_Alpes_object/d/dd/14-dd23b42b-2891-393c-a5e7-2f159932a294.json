  "rdfs:comment": {
    "de": [
      "Im Rahmen des Festivals La Beauté du Geste\nBébé ist eine intime und kollektive spirituelle Suche nach dem Tod und der Abneigung und Faszination, die er in uns auslöst."
    ],
    "en": [
      "As part of the La Beauté du Geste festival\nA choreographic object as much as a societal project, Bébé is an intimate and collective spiritual quest around death and the repulsion-fascination it provokes in us."
    ],
    "it": [
      "Nell'ambito del festival La Beauté du Geste\nOggetto coreografico e progetto sociale, Bébé è una ricerca spirituale intima e collettiva sulla morte e sulla repulsione-fascinazione che essa provoca in noi."
    ],
    "fr": [
      "Dans le cadre du festival La Beauté du Geste\nObjet chorégraphique autant que projet sociétal, Bébé est une quête spirituelle intime et collective autour de la mort et de la répulsion-fascination qu’elle provoque en nous."
    ],
    "nl": [
      "In het kader van het festival La Beauté du Geste\nBébé is zowel een choreografisch object als een maatschappelijk project. Het is een intieme en collectieve spirituele zoektocht rond de dood en de afkeer-fascinatie die deze in ons oproept."
    ],
    "es": [
      "En el marco del festival La Beauté du Geste\nObjeto coreográfico tanto como proyecto de sociedad, Bébé es una búsqueda espiritual íntima y colectiva en torno a la muerte y la repulsión-fascinación que nos provoca."
    ]
  },
  "rdfs:label": {
    "fr": [
