  "rdfs:comment": {
    "de": [
      "Das war vor 50 Jahren? Am 27. Dezember 1974 brach in Liévin eine Grube aus und riss Väter, Söhne und Ehemänner mit in den Tod."
    ],
    "en": [
      "It was 50 years ago? On December 27, 1974, a firedamp exploded in Liévin, taking with it fathers, sons, husbands? in all, 42 miners perished that day."
    ],
    "it": [
      "È successo 50 anni fa? Il 27 dicembre 1974, a Liévin, un grisou esplodeva portando con sé padri, figli e mariti. In tutto, quel giorno morirono 42 minatori."
    ],
    "fr": [
      "C’était il y a 50 ans… Le 27 décembre 1974, un coup de grisou a éclaté à Liévin, emportant avec lui des pères, des fils, des maris… au total, 42 mineurs ont péri ce jour-là."
    ],
    "es": [
      "¿Hace 50 años? El 27 de diciembre de 1974, un grisú explotó en Liévin, llevándose por delante a padres, hijos y maridos... en total, 42 mineros murieron aquel día."
    ],
    "nl": [
      "Het was 50 jaar geleden? Op 27 december 1974 ontplofte een mijngas in Liévin, waarbij vaders, zonen en echtgenoten werden meegesleurd. In totaal kwamen die dag 42 mijnwerkers om het leven."
    ]
  },
