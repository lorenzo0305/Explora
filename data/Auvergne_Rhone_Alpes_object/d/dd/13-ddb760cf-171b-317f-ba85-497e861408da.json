  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Terroir beaujolais in einem brandneuen Erlebnisbereich und beleben Sie Ihre 5 Sinne!"
    ],
    "en": [
      "In Beaujeu, the Maison du Terroir Beaujolais invites you to enjoy an immersive and entertaining experience through its museum displays, followed by a visit to the local producers' shop. Continue your day with a ride on one of our rental bikes."
    ],
    "it": [
      "A Beaujeu, la Maison du Terroir Beaujolais vi invita a vivere un'esperienza coinvolgente e divertente attraverso la sua museografia, per poi visitare il negozio dei produttori locali. Proseguite la giornata con un giro su una delle nostre biciclette a noleggio."
    ],
    "fr": [
      "À Beaujeu, la Maison du terroir beaujolais vous invite à vivre une expérience immersive et ludique à travers sa muséographie puis rendez-vous dans la boutique de producteurs locaux. Poursuivez la journée par une balade grâce à nos vélos en location."
    ],
    "nl": [
      "In Beaujeu nodigt het Maison du Terroir Beaujolais je uit om te genieten van een meeslepende en vermakelijke ervaring door zijn museografie, daarna bezoek je de winkel van de plaatselijke producenten. Sluit de dag af met een ritje op een van onze huurfietsen."
    ],
    "es": [
      "En Beaujeu, la Maison du Terroir Beaujolais le invita a disfrutar de una experiencia inmersiva y lúdica a través de su museografía y, a continuación, visite la tienda de los productores locales. Continúe el día con un paseo en una de nuestras bicicletas de alquiler."
    ]
  },
  "rdfs:label": {
    "de": [
