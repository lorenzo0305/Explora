  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Patio empfängt Sie zu einer geselligen Gourmetpause. Dieser einzigartige Ort im Hotel Oceania besticht durch seine warme Atmosphäre und seine herrliche, 150 m² große Gartenterrasse, ein grünes Schmuckstück in der Stadt."
    ],
    "en": [
      "Le Patio restaurant welcomes you for a gourmet and convivial break. Nestled within the Oceania Hotel, this unique venue charms guests with its warm atmosphere and superb 150 m² garden terrace, a veritable oasis of greenery in the city."
    ],
    "it": [
      "Il ristorante Le Patio vi accoglie per una pausa gastronomica e conviviale. Situato nel cuore dell'hotel Oceania, questo locale unico vanta un'atmosfera accogliente e un superbo giardino con terrazza di 150 m², un vero e proprio gioiello di verde in città."
    ],
    "fr": [
      "Le restaurant Le Patio vous accueille pour une parenthèse gourmande et conviviale. Niché au sein de l’hôtel Oceania, ce lieu unique séduit par son atmosphère chaleureuse et son superbe jardin-terrasse de 150 m², véritable écrin de verdure en ville."
    ],
    "nl": [
      "Restaurant Le Patio verwelkomt u voor een gastronomische en gezellige pauze. Deze unieke locatie ligt in het hart van het Oceania hotel en heeft een warme sfeer en een prachtige terrastuin van 150 m², een echt juweel van groen in de stad."
    ],
    "es": [
      "El restaurante Le Patio le da la bienvenida para una pausa gastronómica y distendida. Situado en el corazón del hotel Oceania, este lugar único ofrece un ambiente cálido y una magnífica terraza-jardín de 150 m², una auténtica joya verde en la ciudad."
    ]
  },
