  "rdfs:comment": {
    "de": [
      "Entdecken Sie allein oder in Begleitung eines Profis\r\ndes Bergsports die Freuden des Wanderns mit einem Esel. Nutzen Sie auch die Gelegenheit\r\num unsere lokale Produktion von handgemachten Seifen zu entdecken\r\naus Eselsmilch!"
    ],
    "en": [
      "Discover the joys of hiking with a donkey, alone or accompanied \r\nby a mountain professional. Plus, come and discover our local \r\nproduction of handmade donkey milk soaps!"
    ],
    "it": [
      "Scoprite da soli o accompagnati da un professionista della \r\nmontagna le gioie di un’escursione a dorso d’asino. L’asino \r\nè una soluzione di mobilità molto conviviale e l’ideale per \r\ngodersi tutto il fascino di Saint-Gervais. E approfittatene \r\nanche per scoprire la nostra produzione artigianale e locale \r\ndi saponi al latte d’asina !"
    ],
    "fr": [
      "Découvrez seul ou accompagné par un professionnel \r\nde la montagne les joies de la randonnée avec un âne. Profitez-en également \r\npour découvrir notre production locale de savons artisanaux \r\nau lait d’ânesse !"
    ],
    "nl": [
      "Ontdekken, alleen of onder begeleiding van een bergprofessional\r\nde geneugten van het wandelen met een ezel. Maak ook van de gelegenheid gebruik om\r\nom onze lokale productie van ambachtelijke zepen te ontdekken\r\nmet ezelinnenmelk!"
    ],
    "es": [
      "Descubrir, solo o acompañado por un profesional de la montaña\r\nlas alegrías de ir de excursión con un burro. Aproveche también la oportunidad para\r\npara descubrir nuestra producción local de jabones artesanales\r\n¡con leche de burra!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les ânes montagnards"
    ]
  },
