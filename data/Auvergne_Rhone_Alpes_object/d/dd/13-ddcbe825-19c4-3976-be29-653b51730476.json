  "rdfs:comment": {
    "de": [
      "Der Espace Saint-Germain, der in der entweihten ehemaligen Kirche gleichen Namens untergebracht ist, ist ein Ort der Begegnung und der Aufführungen im Herzen des Dorfes Roussas."
    ],
    "en": [
      "The Espace Saint-Germain, housed in the former church of the same name, is a venue for meetings and shows right in the heart of the village of Roussas."
    ],
    "it": [
      "L'Espace Saint-Germain, ospitato nell'antica chiesa omonima, che è stata desacralizzata, è una sede per incontri e spettacoli proprio nel cuore del villaggio di Roussas."
    ],
    "fr": [
      "L’Espace Saint-Germain, installé dans l'ancienne Église éponyme désacralisée, est un lieu de rencontres et de spectacles en plein cœur du village de Roussas."
    ],
    "es": [
      "El Espace Saint-Germain, ubicado en la antigua iglesia del mismo nombre, que ha sido desantificada, es un lugar de encuentro y espectáculos en pleno centro del pueblo de Roussas."
    ],
    "nl": [
      "De Espace Saint-Germain, gehuisvest in de voormalige kerk met dezelfde naam die is ontheiligd, is een locatie voor bijeenkomsten en shows in het hart van het dorp Roussas."
    ]
  },
