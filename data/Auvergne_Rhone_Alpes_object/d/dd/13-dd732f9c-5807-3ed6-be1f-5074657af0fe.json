  "rdfs:comment": {
    "de": [
      "Der Frühlingsball lädt Sie zu einem festlichen und leckeren Moment mit Orchester und Tanzstimmung ein. Raffiniertes Menü, regionale Spezialitäten und All-Inclusive-Angebote nach Wunsch: ein Tag im Zeichen der Geselligkeit und des Feierns!"
    ],
    "en": [
      "Le Bal du Printemps invites you to enjoy a festive, gourmet meal with live music and dancing. A refined menu, regional specialities and all-inclusive all-you-can-eat formulas: a day dedicated to conviviality and celebration!"
    ],
    "it": [
      "Il Bal du Printemps vi invita a gustare un pasto festivo e gourmet con musica dal vivo e balli. Con un menu raffinato, specialità regionali e menu all-inclusive, sarà sicuramente una giornata conviviale e festosa!"
    ],
    "fr": [
      "Le Bal du Printemps vous invite à un moment festif et gourmand avec orchestre et ambiance dansante. Menu raffiné, spécialités régionales et formules tout compris à volonté : une journée placée sous le signe de la convivialité et de la fête !"
    ],
    "nl": [
      "Het Bal du Printemps nodigt je uit om te genieten van een feestelijke, gastronomische maaltijd met livemuziek en dans. Met een verfijnde menukaart, regionale specialiteiten en all-inclusive all-you-can-eat menu's wordt het zeker een gezellige, feestelijke dag!"
    ],
    "es": [
      "El Bal du Printemps le invita a disfrutar de una comida festiva y gastronómica con música en directo y baile. Con una carta refinada, especialidades regionales y menús \"todo incluido\", ¡seguro que será un día festivo y agradable!"
    ]
  },
  "rdfs:label": {
