  "rdfs:comment": {
    "de": [
      "Villefontaine ist eine wahrhaft grüne Stadt, die von einer reichen natürlichen Umgebung profitiert und eine Vielzahl von Aktivitäten im Freien anbietet. Der Parc du Vellein ist mit Spielgeräten für Kinder ausgestattet und eignet sich ideal für Spaziergänge, Picknicks und zum Entspannen."
    ],
    "en": [
      "A truly green town, Villefontaine benefits from a rich natural environment and offers a wide range of outdoor activities. The Parc du Vellein is equipped with play equipment for children and is ideal for walks, picnics and relaxation."
    ],
    "it": [
      "Città veramente verde, Villefontaine beneficia di un ricco ambiente naturale e offre una vasta gamma di attività all'aperto. Il Parc du Vellein è dotato di attrezzature da gioco per bambini ed è ideale per passeggiate, picnic e relax."
    ],
    "fr": [
      "Véritable ville verte, Villefontaine bénéficie d'un environnement naturel riche et offre un grand nombre d'activités en plein air. Le parc du Vellein est équipé de jeux pour les enfants et est idéal pour les balades, les pique-niques et la détente."
    ],
    "nl": [
      "Villefontaine, een echt groene stad, profiteert van een rijke natuurlijke omgeving en biedt een breed scala aan buitenactiviteiten. Het Parc du Vellein heeft speeltoestellen voor kinderen en is ideaal voor wandelingen, picknicks en ontspanning."
    ],
    "es": [
      "Verdadera ciudad verde, Villefontaine se beneficia de un rico entorno natural y ofrece una amplia gama de actividades al aire libre. El Parc du Vellein dispone de juegos infantiles y es ideal para pasear, hacer picnics y relajarse."
    ]
  },
