  "rdfs:comment": {
    "de": [
      "Genießen Sie eine einfache Küche, die von den Bergen inspiriert ist. Der Geschmack von einfachen und guten Dingen mit frischen Produkten. Der Chefkoch stellt eine Speisekarte zusammen, die sich im Einklang mit den Jahreszeiten entwickelt, in einem lokalen und nachhaltigen Ansatz, alles mit einem Hauch von Modernität."
    ],
    "en": [
      "Come and taste simple cuisine inspired by the mountains. The taste of simple and good things with fresh products selected by the chef. The menu changes with the seasons, in a local and sustainable approach, all with a touch of modernity."
    ],
    "it": [
      "Venite a gustare una cucina semplice ispirata alla montagna. Il gusto per le cose semplici e buone fatte con prodotti freschi. Lo chef crea un menu che cambia con le stagioni in modo locale e sostenibile, con un tocco moderno."
    ],
    "fr": [
      "Venez déguster une cuisine simple inspirée par la montagne. Le goût des choses simples et bonnes avec des produits frais. Le chef compose une carte évoluant au gré des saisons dans une démarche locale et durable, le tout avec une touche de modernité."
    ],
    "es": [
      "Venga a disfrutar de una cocina sencilla inspirada en la montaña. El gusto por las cosas sencillas y buenas elaboradas con productos frescos. El chef crea un menú que cambia con las estaciones de forma local y sostenible, con un toque moderno."
    ],
    "nl": [
      "Kom genieten van een eenvoudige keuken geïnspireerd door de bergen. Een smaak voor eenvoudige, goede dingen gemaakt met verse producten. De chef creëert een menu dat met de seizoenen mee verandert op een lokale en duurzame manier, met een moderne twist."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bela Veya"
    ],
    "fr": [
      "Bela Veya"
    ]
  },
