  "rdfs:comment": {
    "de": [
      "Friseur und Visagist für Frauen, Männer und Kinder. Schnitte, Dauerwellen, Brushings, Färbungen, Balayage, Strähnchen, Hochsteckfrisuren... Ohne Terminvereinbarung. Zugang für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "Hairdresser-visagist for women, men and children. Cuts, perms, brushings, colorations, highlights, buns... No appointment necessary. Access for people with reduced mobility."
    ],
    "it": [
      "Parrucchiere-visagista per donne, uomini e bambini. Tagli, permanenti, spazzolature, colori, colpi di sole, chignon... Non è necessario fissare un appuntamento. Accesso per persone a mobilità ridotta."
    ],
    "fr": [
      "Coiffeur-visagiste pour femmes, hommes et enfants. Coupes, permanentes, brushings, colorations, balayages, mèches, chignons... Sans RDV. Accès pour les personnes à mobilité réduite."
    ],
    "es": [
      "Peluquería-visagista para mujeres, hombres y niños. Cortes, permanentes, cepillados, coloraciones, mechas, moños... Sin cita previa. Acceso para personas con movilidad reducida."
    ],
    "nl": [
      "Kapper-visagist voor vrouwen, mannen en kinderen. Knippen, permanenten, brushen, kleuren, highlights, knotten... Geen afspraak nodig. Toegankelijk voor mensen met beperkte mobiliteit."
    ]
  },
