  "rdfs:comment": {
    "de": [
      "Der Park erstreckt sich von der Ortschaft Royat aus, verläuft entlang des Flusses Tiretaine und dient als Kulisse für das architektonische Erbe der Thermalbäder (Thermen, Trinkhallen und Casino)."
    ],
    "en": [
      "The park stretches from the town of Royat, along the Tiretaine river, and serves as a backdrop to the spa's architectural heritage (thermal baths, bars and casino)."
    ],
    "it": [
      "Il parco si estende dalla città di Royat, lungo il fiume Tiretaine e fa da sfondo al patrimonio architettonico termale (bagni termali, sale di ristoro e casinò)."
    ],
    "fr": [
      "Le parc s'étend depuis le bourg de Royat, longe la rivière la Tiretaine et sert d'écrin au patrimoine architectural thermal (thermes, buvettes et Casino)."
    ],
    "nl": [
      "Het park strekt zich uit vanaf de stad Royat, langs de rivier de Tiretaine en dient als achtergrond voor het thermale architecturale erfgoed (thermen, verfrissingsruimten en Casino)."
    ],
    "es": [
      "El parque se extiende desde la ciudad de Royat, a lo largo del río Tiretaine, y sirve de telón de fondo al patrimonio arquitectónico termal (termas, salas de refresco y Casino)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Thermal Park"
    ],
    "fr": [
      "Parc Thermal"
    ]
  },
