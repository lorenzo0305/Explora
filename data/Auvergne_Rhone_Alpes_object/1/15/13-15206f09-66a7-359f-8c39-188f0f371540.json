  "rdfs:comment": {
    "de": [
      "Halten Sie Ihre Badeanzüge bereit!\r\n\r\nDer Wasserkomplex und die Außenpools von Morzine sind perfekt für alle, die der Hitze entfliehen oder eine Pause von den Pisten machen wollen!"
    ],
    "en": [
      "Prepare your bathing suits!\r\n\r\nMorzine's pool complex and outdoor pools are perfect for those looking to escape the heat or take a break from the slopes!"
    ],
    "it": [
      "Preparate i costumi da bagno!\r\n\r\nIl complesso acquatico e le piscine all'aperto di Morzine sono perfetti per chi vuole sfuggire al caldo o fare una pausa dalle piste!"
    ],
    "fr": [
      "Préparez vos maillots de bain !\r\n\r\nLe complexe aquatique et les piscines extérieures de Morzine sont parfaits pour ceux qui cherchent à échapper à la chaleur ou à faire un break avec les pistes !"
    ],
    "es": [
      "¡Preparen sus bañadores!\r\n\r\nEl complejo acuático y las piscinas al aire libre de Morzine son perfectos para aquellos que buscan escapar del calor o tomarse un descanso de las pistas"
    ],
    "nl": [
      "Maak je zwemkleding klaar!\r\n\r\nHet zwemparadijs en de buitenzwembaden van Morzine zijn perfect voor degenen die willen ontsnappen aan de hitte of een pauze willen nemen van de pistes!"
    ]
  },
