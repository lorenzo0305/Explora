  "rdfs:comment": {
    "de": [
      "Pflanzliche Lederwaren zu 100% vegan. Einzigartige Kreationen aus Pflanzenabfällen (Ananas, Kaktus, Apfel, Kork...).\r\nEinzigartige Lederwaren und Schmuck (Ohrringe, Armbänder, Broschen, Haarspangen...), die aus Lederabfällen hergestellt werden..."
    ],
    "en": [
      "100% vegan plant-based leather goods. Unique creations made from plant waste (pineapple, cactus, apple, cork...).\r\nUnique leather goods and jewelry (earrings, bracelets, brooches, barrettes...) made from scrap leather..."
    ],
    "it": [
      "Pelletteria 100% vegana a base vegetale. Creazioni uniche realizzate con scarti vegetali (ananas, cactus, mele, sughero...).\r\nPelletteria e gioielli unici (orecchini, braccialetti, spille, fermagli...) realizzati con scarti di pelle..."
    ],
    "fr": [
      "Maroquinerie végétale 100% vegan. Des réalisations uniques fabriquées à partir de déchets végétaux (ananas, cactus, pomme, liège..).\r\nMaroquinerie unique et bijoux ( boucles d'oreille, bracelets, broches, barettes...) réalisés à partir de chute de cuir..."
    ],
    "es": [
      "Marroquinería 100% vegetal vegana. Creaciones únicas a partir de residuos vegetales (piña, cactus, manzana, corcho...).\r\nMarroquinería y joyería únicas (pendientes, pulseras, broches, broches...) hechas con restos de cuero..."
    ],
    "nl": [
      "100% veganistische lederwaren op plantaardige basis. Unieke creaties gemaakt van plantenafval (ananas, cactus, appel, kurk...).\r\nUnieke lederwaren en sieraden (oorbellen, armbanden, broches, clips...) gemaakt van leerafval..."
    ]
  },
