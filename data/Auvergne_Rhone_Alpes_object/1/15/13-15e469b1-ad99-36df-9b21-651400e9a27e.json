  "rdfs:comment": {
    "de": [
      "Dieser Rundweg ist ein echtes Abenteuer abseits der klassischen Wege im Herzen der Berge, in einer einzigartigen und wilden Umgebung."
    ],
    "en": [
      "This loop is a real adventure off the beaten track, right in the heart of the mountains, in a unique and wild environment."
    ],
