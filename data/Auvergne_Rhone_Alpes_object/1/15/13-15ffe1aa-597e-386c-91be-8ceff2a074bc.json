  "rdfs:comment": {
    "de": [
      "Residenz-Hotel, subtile Kombination aus Holz und Stoffen in warmen Tönen, die Studios/Appartements Neige et Roc verbinden Charme und Raffinesse. Restaurant, Bar, Tennis, 2 Schwimmbäder, Sauna/Hammam/Jacuzzi, Fitness, Park 1 ha. So viele Vorteile für einen gelungenen Aufenthalt!"
    ],
    "en": [
      "Hotel residence, subtle match of wood and fabrics in warm tones, the Neige et Roc studios/apartments combine charm and refinement. Restaurant, bar, tennis court, 2 swimming pools, sauna/steam room/hot tub, fitness, 1-ha park. So many assets for a successfull stay!"
    ],
    "it": [
      "Residenza alberghiera, sottile connubio di legno e tessuti dai toni caldi, i monolocali/appartamenti Neige et Roc uniscono fascino e raffinatezza. Ristorante, bar, campo da tennis, 2 piscine, sauna/hammam/jacuzzi, centro fitness, parco di 1 ettaro. Tante risorse per un soggiorno di successo!"
    ],
    "fr": [
      "Résidence hôtel, subtil mariage de bois et tissus aux tons chauds, les studios/appartements Neige et Roc allient charme et raffinement. Restaurant, bar, tennis, 2 piscines, sauna/hammam/jacuzzi, fitness, parc 1 ha. Autant d'atouts pour un séjour réussi !"
    ],
    "nl": [
      "Residentiehotel, een subtiele combinatie van hout en stoffen in warme tinten, de studio's / appartementen Neige en Roc combineren charme en verfijning. Restaurant, bar, tennisbaan, 2 zwembaden, sauna / hammam / jacuzzi, fitness, park 1 ha. Zoveel troeven voor een geslaagd verblijf!"
    ],
    "es": [
      "Residencia hotelera, sutil combinación de madera y tejidos en tonos cálidos, los estudios/apartamentos Neige et Roc combinan encanto y refinamiento. Restaurante, bar, pista de tenis, 2 piscinas, sauna/hammam/jacuzzi, gimnasio, parque de 1 hectárea. Muchas ventajas para una estancia satisfactoria"
    ]
  },
