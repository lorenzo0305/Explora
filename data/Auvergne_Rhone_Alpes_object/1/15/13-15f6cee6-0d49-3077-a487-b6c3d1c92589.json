  "rdfs:comment": {
    "de": [
      "Geschirr und Dekoration aus Steingut - Dekoration mit farbigen Engoben unter einer transparenten Glasur.\r\nLangfristige Zusammenarbeit mit Pauline et ses Crayons, Illustratorin.\r\nHandgemachte handwerkliche Töpferei in meinem Atelier am Ufer des Lac d'Annecy in Sevrier."
    ],
    "en": [
      "Porcelain stoneware tableware and decoration - Decoration with colored engobes under a transparent glaze.\r\nLong-term collaboration with illustrator Pauline et ses Crayons.\r\nHandmade pottery in my workshop on the shores of Lake Annecy in Sevrier."
    ],
    "it": [
      "Stoviglie e decorazioni in gres porcellanato - Decorazione con ingobbi colorati sotto uno smalto trasparente.\nCeramiche fatte a mano nel mio laboratorio sulle rive del lago di Annecy a Sevrier.\nCollaborazione a lungo termine con Pauline et ses Crayons, illustratrice"
    ],
    "fr": [
      "Vaisselle et décoration en grès porcelainique - Décoration aux engobes colorés sous un émail transparent.\nPoterie artisanale faite main dans mon atelier du bord du lac d'Annecy à Sevrier.\nCollab au long cours avec Pauline et ses Crayons, illustratrice"
    ],
    "es": [
      "Vajilla y decoración en gres porcelánico - Decoración con engobes de colores bajo vidriado transparente.\nCerámica hecha a mano en mi taller a orillas del lago de Annecy, en Sevrier.\nColaboración a largo plazo con Pauline et ses Crayons, ilustradora"
    ],
    "nl": [
      "Servies en decoratie van porcellanato - Decoratie met gekleurde engobes onder een transparant glazuur.\nHandgemaakt aardewerk in mijn atelier aan de oevers van het meer van Annecy in Sevrier.\nLangdurige samenwerking met Pauline et ses Crayons, illustrator"
    ]
  },
