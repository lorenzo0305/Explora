  "rdfs:comment": {
    "de": [
      "Möchten Sie einen authentischen Zugang zu Tieren entdecken?\r\nLes Paturettes empfängt Sie, um Ihnen die Tiere auf dem Bauernhof näher zu bringen. Dabei vermischen sich Tierschutz, Sensibilisierung und Lernen."
    ],
    "en": [
      "Les Paturettes welcomes you to discover farm animals."
    ],
    "it": [
      "Les Paturettes vi accoglie per farvi scoprire gli animali della fattoria."
    ],
    "fr": [
      "Vous désirez découvrir une authentique approche des animaux ?\r\nLes Paturettes vous accueille pour vous faire découvrir les animaux de la ferme, mêlant bien-être animal, sensibilisation et apprentissage."
    ],
    "es": [
      "¿Le gustaría descubrir un auténtico acercamiento a los animales?\r\nLes Paturettes le invita a descubrir los animales de granja, combinando bienestar animal, sensibilización y aprendizaje."
    ],
    "nl": [
      "Wil je een authentieke benadering van dieren ontdekken?\r\nLes Paturettes heet je welkom om boerderijdieren te ontdekken, waarbij dierenwelzijn, bewustwording en leren hand in hand gaan."
    ]
  },
