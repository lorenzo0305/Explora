  "rdfs:comment": {
    "de": [
      "Als Imker in Nyons bieten wir Ihnen mit Leidenschaft unsere Produkte und Nebenprodukte an. Probieren Sie unseren Thymian-, Akazien-, Lavendel-, Linden-, Wald-, Kastanien-, Garrigue-, Rosmarin- und 3 verschiedenen Allblütenhonig."
    ],
    "en": [
      "Beekeepers in Nyons, we offer our products and by-products with passion. Come and taste our honeys from thyme, acacia, lavender, lime, forest, chestnut, garrigue, rosemary and 3 different flowers."
    ],
    "it": [
      "Apicoltori di Nyons, vi offriamo con passione i nostri prodotti e i nostri derivati. Venite a degustare i nostri mieli di timo, acacia, lavanda, tiglio, bosco, castagno, gariga, rosmarino e 3 fiori diversi."
    ],
    "fr": [
      "Apiculteur de Nyons, nous vous proposons nos produits et nos dérivés avec passion. Venez déguster nos miels de thym, acacia, lavande, tilleul, forêt, châtaigne, garrigue, romarin et 3 toutes fleurs différents."
    ],
    "es": [
      "Apicultor de Nyons, le ofrecemos nuestros productos y nuestros derivados con pasión. Venga a degustar nuestras mieles de tomillo, de acacia, de lavanda, de tilo, de bosque, de castaño, de garriga, de romero y de 3 flores diferentes."
    ],
    "nl": [
      "Als imkers in Nyons zijn we gepassioneerd om u onze producten en bijproducten aan te bieden. Kom proeven van onze honing op basis van tijm, acacia, lavendel, linde, bos, kastanje, garrigue, rozemarijn en 3 verschillende bloemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Miel du Serre Paulet"
    ]
  },
