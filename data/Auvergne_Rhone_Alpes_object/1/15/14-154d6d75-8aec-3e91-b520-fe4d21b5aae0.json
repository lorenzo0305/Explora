  "rdfs:comment": {
    "de": [
      "Dieses Stück von Joël Pommerat, das seit 2004 ein ungebrochener Erfolg ist, schafft es, die grundlegenden Themen, die in dem berühmten Märchen von Charles Perrault skizziert werden, zu sublimieren."
    ],
    "en": [
      "Joël Pommerat's play, which has enjoyed unbroken success since 2004, manages to sublimate the fundamental themes outlined in Charles Perrault's famous tale."
    ],
    "it": [
      "La pièce di Joël Pommerat, che ha riscosso un successo ininterrotto dal 2004, riesce a sublimare i temi fondamentali delineati nel celebre racconto di Charles Perrault."
    ],
    "fr": [
      "Cette pièce de Joël Pommerat, au succès toujours intact depuis 2004, parvient à sublimer les thèmes fondamentaux esquissés dans le célèbre conte de Charles Perrault."
    ],
    "es": [
      "La obra de Joël Pommerat, que ha cosechado un éxito ininterrumpido desde 2004, consigue sublimar los temas fundamentales esbozados en el famoso cuento de Charles Perrault."
    ],
    "nl": [
      "Het toneelstuk van Joël Pommerat, dat sinds 2004 een ononderbroken succes kent, slaagt erin de fundamentele thema's uit het beroemde sprookje van Charles Perrault te sublimeren."
    ]
  },
