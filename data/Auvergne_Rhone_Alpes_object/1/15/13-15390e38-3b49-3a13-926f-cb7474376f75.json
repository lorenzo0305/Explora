  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine traditionelle lokale und regionale Küche an. Die Küche wird von unserem Chef aus regionaltypischen Produkten hergestellt, deren Geschmack je nach Jahreszeit variiert."
    ],
    "en": [
      "We offer traditional local and regional cuisine. Cuisine elaborated by our Chef  from local products whose flavors vary according to the seasons."
    ],
    "it": [
      "Offriamo una cucina tradizionale locale e regionale. Il nostro chef prepara la cucina con prodotti locali i cui sapori variano a seconda della stagione."
    ],
    "fr": [
      "Nous vous proposons une cuisine traditionnelle tant locale que régionale. Cuisine élaborée par notre Chef  à partir de produits du terroir dont les saveurs varient selon les saisons."
    ],
    "nl": [
      "We bieden traditionele lokale en regionale gerechten. Gerechten die door onze chef-kok  worden bereid met lokale producten waarvan de smaken variëren afhankelijk van de seizoenen."
    ],
    "es": [
      "Ofrecemos cocina tradicional local y regional. Nuestro Chef elabora la cocina con productos locales cuyos sabores varían según la temporada."
    ]
  },
