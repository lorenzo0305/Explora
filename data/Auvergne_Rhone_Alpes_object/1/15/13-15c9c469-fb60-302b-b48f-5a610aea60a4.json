  "rdfs:comment": {
    "de": [
      "Fleisch, Wurstwaren und andere Produkte, die auf dem Hof verarbeitet werden.\r\nUnsere Tiere werden mit auf dem Hof angebauten Feldfrüchten wie Maissilage, Heu oder Mengkornsilage (Getreidemischung) gefüttert."
    ],
    "en": [
      "Beef (Charolaise), lamb, pork and charcuterie\r\nFarmers' shop \"La Ferme du Coin\" in Pizançon\r\nFarm-gate sales to order"
    ],
    "it": [
      "Carne, salumi e altri prodotti lavorati in azienda.\r\nI nostri animali sono alimentati con colture coltivate in azienda, come insilati di mais, fieno o insilati di meslin (una miscela di cereali)."
    ],
    "fr": [
      "Viandes, charcuteries et autres produits transformés à la ferme.\r\nNos animaux sont nourris par des cultures faites à l’exploitation comme l’ensilage de maïs, le foin ou encore l’ensilage de méteil (mélange de céréales)."
    ],
    "nl": [
      "Rundvlees (charolaise), lamsvlees, varkensvlees en charcuterie\r\nWinkel van \"La Ferme du Coin\" producenten in Pizançon.\r\nVerkoop bij de boerderij op bestelling"
    ],
    "es": [
      "Carne, charcutería y otros productos elaborados en la granja.\r\nNuestros animales se alimentan con cultivos propios de la explotación, como ensilado de maíz, heno o morcajo (mezcla de cereales)."
    ]
  },
  "rdfs:label": {
