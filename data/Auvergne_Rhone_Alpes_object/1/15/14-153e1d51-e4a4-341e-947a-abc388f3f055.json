      "dc:description": {
        "de": [
          "Aufführungen ab 18H00 mit Ethnophonics und l'amour à la carte.\nKonzert der Gruppe \"crème french\" um 20:30 Uhr\nPlace de la République beim Abstieg vom Strand\nKostenlos"
        ],
        "en": [
          "Shows from 6:00 pm with Ethnophonics and l'amour à la carte.\nConcert by the group \"crème french\" at 8:30 p.m\nPlace de la République downhill from the beach\nFree"
        ],
        "it": [
          "Spettacoli dalle 18.00 con Ethnophonics e l'amour à la carte.\nConcerto del gruppo \"crème french\" alle 20.30\nPlace de la République in discesa dalla spiaggia\nGratuito"
        ],
        "fr": [
          "Spectacles à partir de 18H00 avec Ethnophonics et l'amour à la carte.\nConcert du groupe \"crème french\" à 20h30 \nPlace de la République en descente de la plage \nGratuit"
        ],
        "nl": [
          "Shows vanaf 18.00 uur met Ethnophonics en l'amour à la carte.\nConcert door de groep \"crème french\" om 20.30 uur\nPlace de la République bergafwaarts van het strand\nGratis"
        ],
        "es": [
          "Espectáculos a partir de las 18.00 h con Ethnophonics y l'amour à la carte.\nConcierto del grupo \"crème french\" a las 20.30 h\nPlaza de la República, bajando la playa\nGratis"
        ]
      },
