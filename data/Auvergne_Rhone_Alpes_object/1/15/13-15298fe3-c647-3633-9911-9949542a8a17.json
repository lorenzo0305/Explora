  "rdfs:comment": {
    "de": [
      "Yoga ist eine großartige Methode, um den Körper zu pflegen und die Gesundheit zu fördern.\r\nDie Körperhaltungen und Übungen beruhigen den Geist und sorgen für ein tiefes Wohlbefinden.\r\nYoga wird Sie Ihr ganzes Leben lang begleiten!"
    ],
    "en": [
      "Yoga is amazing for maintaining the body and health.\r\nThe postures and exercises calm the mind and provide deep well-being.\r\nYoga will stay with you your whole life!"
    ],
    "it": [
      "Lo Yoga è fantastico per il mantenimento del corpo e della salute.\r\nLe posture e gli esercizi calmano la mente e garantiscono un profondo benessere.\r\nLo Yoga ti accompagnerà per tutta la vita!"
    ],
    "fr": [
      "Le Yoga est formidable pour l'Entretien du corps et la Santé.\r\nLes postures et les exercices calment le mental et assurent un profond Bien-Etre.\r\nLe Yoga vous suivra toute votre Vie !"
    ],
    "nl": [
      "Yoga is geweldig voor het onderhouden van je lichaam en je gezondheid.\r\nDe houdingen en oefeningen kalmeren de geest en zorgen voor een diep gevoel van welzijn.\r\nYoga zal je de rest van je leven bijblijven!"
    ],
    "es": [
      "El Yoga es maravilloso para el mantenimiento del cuerpo y la salud.\r\nLas posturas y los ejercicios calman la mente y aseguran un profundo bienestar.\r\n¡El Yoga te acompañará toda tu vida!"
    ]
  },
