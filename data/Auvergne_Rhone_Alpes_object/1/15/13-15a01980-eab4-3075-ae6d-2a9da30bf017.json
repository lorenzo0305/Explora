  "rdfs:comment": {
    "de": [
      "Das reizende kleine Dorf Montmiral nördlich von Romans ist schon von weitem durch seine imposante Kirche Saint-Christophe mit ihrem Glockenturm und ihren beiden Apsiden im rein romanischen Stil zu erkennen."
    ],
    "en": [
      "A quaint little village north of Romans, Montmiral is recognisable thanks to the  imposing Church of Saint Christophe with its belfry and two archetypical Romanesque apses."
    ],
    "it": [
      "Incantevole paesino a nord di Romans, il villaggio di Montmiral è visibile da lontano grazie all'imponente chiesa di Saint-Christophe, con il suo campanile e le due absidi in puro stile romanico."
    ],
    "fr": [
      "Charmant petit village au nord de Romans, le village de Montmiral est visible de loin par son imposante église Saint-Christophe, avec son clocher et ses deux absides de pur style roman."
    ],
    "es": [
      "Pequeño y encantador pueblo al norte de Romans, el pueblo de Montmiral es visible desde lejos por su imponente iglesia de Saint-Christophe, con su campanario y dos ábsides de puro estilo románico."
    ],
    "nl": [
      "Het dorp Montmiral, een charmant dorpje ten noorden van Romans, is van veraf zichtbaar door de imposante kerk van Saint-Christophe met zijn klokkentoren en zijn twee apsissen in zuiver romaanse stijl."
    ]
  },
  "rdfs:label": {
