  "rdfs:comment": {
    "de": [
      "Christian bietet kleinen Blondschöpfen einen Ausritt auf dem Rücken seiner charmanten Ponys in einer angenehmen und ländlichen Umgebung an: dem Canal de Berry."
    ],
    "en": [
      "Christian proposes to the little ones a ride on his charming ponies, in a pleasant and rural setting: the Berry canal."
    ],
    "it": [
      "Christian offre ai più piccoli un giro sui suoi affascinanti pony, in un ambiente piacevole e rurale: il canale di Berry."
    ],
    "fr": [
      "Christian propose aux petites têtes blondes une balade à dos de ses charmants poneys, dans un cadre agréable et champêtre : le canal de Berry."
    ],
    "es": [
      "Christian ofrece a los más pequeños un paseo en sus encantadores ponis, en un entorno agradable y rural: el canal de Berry."
    ],
    "nl": [
