  "rdfs:comment": {
    "de": [
      "Traditionelles französisches Restaurant neben der Kirche Saint Etienne.\nAuf der Speisekarte des Küchenchefs stehen die Zutaten in einfachen und leckeren Gerichten im Vordergrund, die in unserer Küche hergestellt und direkt auf Ihrem Teller serviert werden."
    ],
    "en": [
      "Traditional French restaurant next to Saint Étienne church.\nThe chef's menu showcases ingredients in simple, gourmet dishes, made in our kitchens and served directly to your plate."
    ],
    "it": [
      "Ristorante tradizionale francese situato accanto alla chiesa di Saint Étienne.\nIl menu dello chef propone piatti semplici e gourmet realizzati nelle nostre cucine e serviti direttamente nel piatto."
    ],
    "fr": [
      "Restaurant traditionnel français situé à côté de l'église Saint Étienne.\nLa carte du chef met à l'honneur des ingrédients dans des plats simples et gourmands, confectionnés dans nos cuisines et directement servis dans votre assiette."
    ],
    "nl": [
      "Traditioneel Frans restaurant naast de kerk Saint Étienne.\nOp het menu van de chef staan eenvoudige, gastronomische gerechten die in onze keukens worden bereid en rechtstreeks op je bord worden geserveerd."
    ],
    "es": [
      "Restaurante tradicional francés situado junto a la iglesia de Saint Étienne.\nEl menú del chef ofrece platos sencillos y gourmet elaborados en nuestras cocinas y servidos directamente en el plato."
    ]
  },
