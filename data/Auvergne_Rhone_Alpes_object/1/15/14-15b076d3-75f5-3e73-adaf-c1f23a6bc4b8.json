  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/293611b5-40d9-355f-86d9-f1f29d056e0e",
      "dc:description": {
        "de": [
          "Im Rahmen der Geschmackswoche bieten Ihnen unsere Lebensmittelgeschäfte leckere Menüs an!\n\n- Verkostung der Produkte des Hauses Pérard.\n- Menü des Restaurants Casserole et bouchons (Pfanne und Korken).\n- Menü des Restaurants La Table du Manoir."
        ],
        "en": [
          "As part of the Week of Taste, our food shops are serving up tasty menus!\n\n- Tasting of Maison Pérard products.\n- Menu from the restaurant Casserole et bouchons.\n- Menu from La Table du Manoir restaurant."
        ],
        "it": [
          "Nell'ambito della Settimana del Gusto, le nostre botteghe alimentari propongono dei menu gustosi!\n\n- Degustazione di prodotti della Maison Pérard.\n- Menu del ristorante Casserole et bouchons.\n- Menu del ristorante La Table du Manoir."
        ],
        "fr": [
          "Dans le cadre de la semaine du goût, nos commerces de bouche vous proposent de savoureux menus !\n\n- Dégustation des produits de la Maison Pérard.\n- Menu du restaurant Casserole et bouchons.\n- Menu du restaurant La Table du Manoir."
        ],
        "nl": [
          "In het kader van de Week van de Smaak serveren onze levensmiddelenwinkels een aantal smakelijke menu's!\n\n- Proeverij van producten van Maison Pérard.\n- Menu van het restaurant Casserole et bouchons.\n- Menu van het restaurant La Table du Manoir."
        ],
        "es": [
          "Con motivo de la Semana del Gusto, nuestras tiendas de alimentación ofrecen sabrosos menús\n\n- Degustación de productos de la Maison Pérard.\n- Menú del restaurante Casserole et bouchons.\n- Menú del restaurante La Table du Manoir."
        ]
      },
      "@type": [
        "Description"
