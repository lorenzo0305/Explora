  "rdfs:comment": {
    "de": [
      "Das ideal in der Nähe von Clermont-Ferrand und Lyon gelegene Hotel-Restaurant Campanile Vichy - Bellerive-sur-Allier ist eine perfekte Kombination aus Komfort und Modernität. Seine einladende und grüne Umgebung macht es zu einem angenehmen Zwischenstopp für Ihren Aufenthalt."
    ],
    "en": [
      "Ideally located near Clermont-Ferrand and Lyon, the hotel restaurant Campanile Vichy - Bellerive-sur-Allier is a perfect combination of comfort and modernity. Its welcoming and green setting makes it a pleasant stopover for your stay."
    ],
    "it": [
      "Situato in posizione ideale vicino a Clermont-Ferrand e Lione, l'hotel-ristorante Campanile Vichy - Bellerive-sur-Allier è una perfetta combinazione di comfort e modernità. Il suo ambiente accogliente e verdeggiante lo rende una tappa piacevole per il vostro soggiorno."
    ],
    "fr": [
      "Idéalement situé à proximité de Clermont-Ferrand et Lyon, l'hôtel-restaurant Campanile Vichy - Bellerive-sur-Allier est une parfaite alliance entre confort et modernité. Son cadre accueillant et verdoyant en fait une agréable étape pour vos séjours."
    ],
    "es": [
      "Idealmente situado cerca de Clermont-Ferrand y Lyon, el hotel-restaurante Campanile Vichy - Bellerive-sur-Allier es una combinación perfecta de confort y modernidad. Su entorno acogedor y verde lo convierte en una agradable parada para su estancia."
    ],
    "nl": [
      "Het hotel-restaurant Campanile Vichy - Bellerive-sur-Allier, ideaal gelegen in de buurt van Clermont-Ferrand en Lyon, is een perfecte combinatie van comfort en moderniteit. De gastvrije en groene omgeving maakt het een aangename tussenstop voor uw verblijf."
    ]
  },
