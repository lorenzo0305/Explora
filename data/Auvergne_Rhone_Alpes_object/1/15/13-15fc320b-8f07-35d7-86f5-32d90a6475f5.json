  "rdfs:comment": {
    "de": [
      "Die Roxy'bar ist ein einzigartiger Ort, der der 7. Kunst gewidmet ist und an dem man einen Drink (große Auswahl an Rum, Whisky, Gin, Wodka und Bier) zu cooler Musik schlürfen kann. Darts, Billard, Tischfußball und Arcade-Spiele.\r\nSchöne schattige Terrasse an sonnigen Tagen."
    ],
    "en": [
      "The setting is entirely dedicated to the 7th Art."
    ],
    "it": [
      "Il Roxy'bar, un luogo unico dedicato alla settima arte dove è possibile sorseggiare un drink (un'ampia scelta di Rum, Whisky, Gin, Vodka e birre) con un sottofondo di musica cool. Freccette, biliardo, calcio balilla, giochi arcade.\r\nBella terrazza ombreggiata nella bella stagione."
    ],
    "fr": [
      "Le Roxy'bar,un lieu singulier dédié au 7 ème art ou il fait bon siroter un drink (vaste choix de Rhum ,Whisky,Gin,Vodka et bières) sur fond de musique cool. Fléchettes, billard, baby foot, jeu d'arcade.\r\nBelle terrasse ombragée aux beaux jours."
    ],
    "nl": [
      "The Roxy'bar, een unieke plek gewijd aan de 7e kunst waar je kunt nippen van een drankje (een ruime keuze aan rum, whisky, gin, wodka en bier) op een achtergrond van coole muziek. Darts, biljart, tafelvoetbal, arcadespellen.\r\nMooi schaduwrijk terras bij mooi weer."
    ],
    "es": [
      "El Roxy'bar, un lugar único dedicado al séptimo arte donde podrá tomar una copa (una amplia selección de ron, whisky, ginebra, vodka y cervezas) con música de fondo. Dardos, billar, futbolín, juegos recreativos.\r\nAgradable terraza a la sombra cuando hace buen tiempo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roxy Bar"
    ]
  },
