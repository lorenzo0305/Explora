  "rdfs:comment": {
    "de": [
      "Lassen Sie dieses kleine Land in den Bergen an vier authentischen und visionären Orten auf sich wirken, an denen das traditionelle Know-how mit Ihrem Alltag in Resonanz tritt.  \r\nMachen Sie sich bereit für Abenteuer zwischen Vergangenheit, Gegenwart und Zukunft!"
    ],
    "en": [
      "Immerse yourself in this small mountain country through 4 authentic and visionary sites where traditional know-how resonates with your everyday life.  \r\nGet ready for adventures between past, present and future!"
    ],
    "it": [
      "Immergetevi in questo piccolo paese di montagna attraverso 4 siti autentici e visionari dove le abilità tradizionali risuonano con la vita quotidiana.  \r\nPreparatevi a un'avventura tra passato, presente e futuro!"
    ],
    "fr": [
      "Imprégnez-vous de ce petit pays de montagne à travers 4 sites authentiques et visionnaires où les savoir-faire traditionnels résonnent avec votre quotidien.  \r\nPréparez-vous à vivre des aventures entre passé, présent et futur !"
    ],
    "es": [
      "Sumérjase en este pequeño país de montaña a través de 4 lugares auténticos y visionarios donde las técnicas tradicionales resuenan en su vida cotidiana.  \r\n¡Prepárese para una aventura entre pasado, presente y futuro!"
    ],
    "nl": [
      "Dompel jezelf onder in dit kleine bergland via 4 authentieke en visionaire locaties waar traditionele vaardigheden resoneren met je dagelijks leven.  \r\nBereid je voor op een avontuur tussen verleden, heden en toekomst!"
    ]
  },
  "rdfs:label": {
