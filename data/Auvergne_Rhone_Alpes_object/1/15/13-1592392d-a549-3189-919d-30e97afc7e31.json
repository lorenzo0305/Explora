  "rdfs:comment": {
    "de": [
      "Begeben Sie sich an Bord des Allier, einem der letzten wilden Flüsse Europas. Erleben Sie von einer Stunde bis zu mehreren Tagen das Allier-Abenteuer, das zu Ihnen passt. Wir vermieten auch stundenweise Paddles im Maison de la Rivière Allier."
    ],
    "en": [
      "Come aboard the Allier, one of Europe's last wild rivers. From one hour to several days, experience the Allier adventure that's right for you. We also rent paddles by the hour at the Maison de la Rivière Allier."
    ],
    "it": [
      "Salpate sull'Allier, uno degli ultimi fiumi selvaggi d'Europa. Da un'ora a più giorni, vivete l'avventura sull'Allier che fa per voi. Presso la Maison de la Rivière Allier noleggiamo anche pagaie su base oraria."
    ],
    "fr": [
      "Embarquez sur l'Allier l'une des dernières rivières sauvages d'Europe. D'une heure à plusieurs jours, vivez l'aventure Allier qui vous correspond. Nous louons, aussi, à l'heure des paddles au niveau de la Maison de la Rivière Allier."
    ],
    "nl": [
      "Vaar mee op de Allier, een van de laatste wilde rivieren van Europa. Van een uur tot meerdere dagen, beleef het Allier avontuur dat bij je past. We verhuren ook peddels op uurbasis in het Maison de la Rivière Allier."
    ],
    "es": [
      "Navegue por el Allier, uno de los últimos ríos salvajes de Europa. De una hora a varios días, viva la aventura del Allier a su medida. También alquilamos remos por horas en la Maison de la Rivière Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "ASPTT Canoë-Kayak"
    ]
  },
