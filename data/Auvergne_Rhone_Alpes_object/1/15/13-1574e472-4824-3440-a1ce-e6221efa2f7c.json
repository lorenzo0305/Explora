  "rdfs:comment": {
    "de": [
      "Eine Kombination aus der Welt der Blumen und der Welt der Tapas-Bars.\r\nMittags werden Ihnen Vorschläge des Küchenchefs zum Essen angeboten.  \r\nAbends können Sie in der Loungebar Aperitifbretter genießen."
    ],
    "en": [
      "A blend of the floral and tapas bar worlds.\r\nAt lunchtime, the chef's suggestions are on offer.  \r\nIn the evening, you can enjoy an aperitif in the lounge bar."
    ],
    "it": [
      "Un mix tra il mondo floreale e quello dei tapas bar.\r\nAll'ora di pranzo vengono proposti i suggerimenti dello chef.  \r\nLa sera si può gustare un aperitivo nel lounge bar."
    ],
    "fr": [
      "Alliance entre l'univers floral et celui des bar à tapas.\r\nLe midi, des suggestions du chef vous sont proposés pour vous restaurer.  \r\nLe soir, possibilité de profiter du lounge bar pour des planches apéritives."
    ],
    "es": [
      "Una mezcla del mundo floral y del bar de tapas.\r\nAl mediodía, se ofrecen las sugerencias del chef.  \r\nPor la noche, podrá disfrutar de un aperitivo en el bar salón."
    ],
    "nl": [
      "Een mix van de bloemen- en tapasbarwereld.\r\nTijdens de lunch worden hier suggesties van de chef aangeboden.  \r\nS Avonds kun je genieten van een aperitief in de loungebar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Serres de Babylone"
    ]
  },
