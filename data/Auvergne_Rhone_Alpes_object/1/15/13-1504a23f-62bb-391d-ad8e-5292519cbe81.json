  "rdfs:comment": {
    "de": [
      "4-Sterne-Hotel am Fuße des Plateaus von Gergovie, inmitten von 9 ha Grünfläche. Bistronomisches Restaurant, Terrasse mit Aussicht, Engagement Clef Verte. In der Nähe der Grande Halle, des Zenith und mit guter Anbindung an die A75, A89, A71."
    ],
    "en": [
      "4-star hotel at the foot of the Plateau de Gergovie, in the heart of 9 hectares of greenery. Bistronomic restaurant, terrace with view, Clef Verte commitment. Near Grande Halle, Zenith and easy access to A75, A89, A71."
    ],
    "it": [
      "Hotel 4 stelle ai piedi del Plateau de Gergovie, nel cuore di 9 ettari di verde. Ristorante bistronomico, terrazza con vista, impegno Clef Verte. Vicino alla Grande Halle e allo Zenith, con facile accesso alle autostrade A75, A89 e A71."
    ],
    "fr": [
      "Hôtel 4 étoiles au pied du Plateau de Gergovie, au cœur de 9 ha de verdure. Restaurant bistronomique, terrasse avec vue, engagement Clef Verte. Proche Grande Halle, Zénith et accès facile A75, A89, A71."
    ],
    "nl": [
      "Viersterrenhotel aan de voet van het Plateau de Gergovie, in het hart van 9 hectare groen. Bistronomisch restaurant, terras met uitzicht, verbintenis Clef Verte. Vlakbij de Grande Halle en Zenith, met gemakkelijke toegang tot de snelwegen A75, A89 en A71."
    ],
    "es": [
      "Hotel de 4 estrellas al pie del Plateau de Gergovie, en el corazón de 9 hectáreas de verdor. Restaurante bistronómico, terraza con vistas, compromiso Clef Verte. Cerca de la Grande Halle y del Zenith, con fácil acceso a las autopistas A75, A89 y A71."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Best western plus hôtel Gergovie"
    ]
  },
