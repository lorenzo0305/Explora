  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Bauernhof in aller Freiheit! Erkunden Sie in Ihrem eigenen Tempo, beobachten Sie die Tiere in ihrer natürlichen Umgebung und genießen Sie einen Moment der Entspannung auf dem Land. Ein authentischer Ausflug für die ganze Familie ins Herz der Natur."
    ],
    "en": [
      "Discover the farm in complete freedom! Explore at your own pace, observe the animals in their natural environment and enjoy a moment of rural relaxation. An authentic getaway for the whole family in the heart of nature."
    ],
    "it": [
      "Scoprite la fattoria in piena libertà! Esplorate al vostro ritmo, osservate gli animali nel loro ambiente naturale e godetevi un momento di relax rurale. Un'autentica fuga per tutta la famiglia nel cuore della natura."
    ],
    "fr": [
      "Découvrez la ferme en toute liberté ! Explorez à votre rythme, observez les animaux dans leur environnement naturel et profitez d'un moment de détente champêtre. Une escapade authentique pour toute la famille au cœur de la nature."
    ],
    "es": [
      "¡Descubra la granja con total libertad! Explore a su ritmo, observe a los animales en su entorno natural y disfrute de un momento de relax rural. Una auténtica escapada para toda la familia en plena naturaleza."
    ],
    "nl": [
      "Ontdek de boerderij in alle vrijheid! Verken de boerderij op je eigen tempo, observeer de dieren in hun natuurlijke omgeving en geniet van een moment van landelijke ontspanning. Een authentiek uitje voor het hele gezin midden in de natuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les samedis à la ferme - Visites libres à la ferme"
    ]
  },
