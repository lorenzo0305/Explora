  "rdfs:comment": {
    "de": [
      "Die Elternvereinigung (Association des Parents d'Élèves, APE) von Saint-Nazaire-en-Royans unterstützt die Schulen des Dorfes durch die Organisation von Veranstaltungen, um Bildungsprojekte, Schulausflüge und außerschulische Aktivitäten zu finanzieren."
    ],
    "en": [
      "The Association des Parents d'Élèves (APE) de Saint-Nazaire-en-Royans supports the village schools by organizing events to finance educational projects, school outings and extracurricular activities."
    ],
    "it": [
      "L'Associazione dei genitori di Saint-Nazaire-en-Royans (APE) sostiene le scuole del villaggio organizzando eventi per finanziare progetti educativi, gite scolastiche e attività extrascolastiche."
    ],
    "fr": [
      "L'Association des Parents d'Élèves (APE) de Saint-Nazaire-en-Royans soutient les écoles du village en organisant des événements pour financer des projets éducatifs, sorties scolaires et activités extrascolaires."
    ],
    "es": [
      "La Asociación de Padres de Saint-Nazaire-en-Royans (APE) apoya a las escuelas del pueblo organizando actos para financiar proyectos educativos, salidas escolares y actividades extraescolares."
    ],
    "nl": [
      "De oudervereniging van Saint-Nazaire-en-Royans (APE) steunt de scholen in het dorp door evenementen te organiseren om onderwijsprojecten, schoolreisjes en buitenschoolse activiteiten te financieren."
    ]
  },
  "rdfs:label": {
