  "rdfs:comment": {
    "de": [
      "Das Hochgebirgserlebnis in Méribel - Le Mont Vallon.\r\nBeeindruckende Aussicht auf das größte Panorama der 3 Vallées und die mythischen Gipfel der Alpen, Abfahrten auf zwei schönen roten Pisten oder eine Abfahrt mit der Gondelbahn für Fußgänger? WAOUH!"
    ],
    "en": [
      "The \"high altitude\" experience in Méribel - Le Mont Vallon.\r\nAwe-inspiring views over the largest glacier of Les 3 Vallées and the most famous peaks from the Alps, ski run on the beautiful and engaged slopes or trip back with the comfy gondolas if you're pedestrian... WOW!"
    ],
    "it": [
      "L'esperienza in alta montagna a Méribel - Le Mont Vallon.\r\nViste impressionanti sul più grande panorama delle 3 Vallées e sulle leggendarie cime delle Alpi, discese su due impegnative piste rosse o una discesa in gondola per i pedoni? WAOUH!"
    ],
    "fr": [
      "L'expérience haute montagne à Méribel - Le Mont Vallon.\r\nVue impressionnante sur le + grand panorama des 3 Vallées et les sommets mythiques des Alpes, descentes sur deux belles pistes rouges engagées ou descente en télécabine pour les piétons… WAOUH !"
    ],
    "es": [
      "La experiencia de alta montaña en Méribel - Le Mont Vallon.\r\nImpresionantes vistas del mayor panorama de los 3 Vallées y de los legendarios picos de los Alpes, descensos en dos desafiantes pistas rojas o un descenso en góndola para peatones? ¡WAOUH!"
    ],
    "nl": [
      "De hooggebergte ervaring in Méribel - Le Mont Vallon\r\nIndrukwekkend uitzicht op het grootste panorama van de 3 Valleien en de mythische toppen van de Alpen, afdaling op twee prachtige rode pistes of afdaling per gondel voor voetgangers... WAUW !"
    ]
  },
  "rdfs:label": {
    "en": [
      "Viewpoint - Mont Vallon (Peak Experience)"
    ],
    "fr": [
      "Point de vue - Mont Vallon (Peak Experience)"
    ],
    "nl": [
      "Uitzichtpunt - Mont Vallon (Peak Experience)"
    ]
  },
