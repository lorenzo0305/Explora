  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Stadtzentrum Grenobles entfernt erhebt sich das Fantin Latour von Chefkoch Stéphane Froidevaux wie eine kulinarische Flucht aus dem Alltag."
    ],
    "en": [
      "Just a stone's throw from Grenoble city center, Chef Stéphane Froidevaux's Fantin Latour is a culinary escape."
    ],
    "it": [
      "A pochi passi dal centro di Grenoble, il Fantin Latour dello chef Stéphane Froidevaux è una fuga culinaria."
    ],
    "fr": [
      "A quelques pas du centre-ville de Grenoble, le Fantin Latour du Chef Stéphane Froidevaux se dresse comme une échappée culinaire."
    ],
    "nl": [
      "Op een steenworp afstand van het centrum van Grenoble ligt Fantin Latour van chef-kok Stéphane Froidevaux, een culinaire ontsnapping."
    ],
