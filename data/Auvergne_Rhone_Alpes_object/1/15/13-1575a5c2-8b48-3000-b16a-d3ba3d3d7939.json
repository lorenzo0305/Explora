  "rdfs:comment": {
    "de": [
      "Alle Zubereitungen von Lucie und Jonathan sind hausgemacht und bestehen aus frischen, lokalen Produkten. So bieten sie ihren Gästen eine hochwertige traditionelle Küche."
    ],
    "en": [
      "All Lucie and Jonathan's dishes are homemade from fresh, local produce, offering their customers traditional, high-quality cuisine."
    ],
    "it": [
      "Tutti i piatti di Lucie e Jonathan sono fatti in casa, con prodotti freschi e locali, per offrire ai clienti una cucina tradizionale e di qualità."
    ],
    "fr": [
      "Toutes les préparations de Lucie et Jonathan sont faites maison, à partir de produits frais et locaux, offrant ainsi à leurs clients une cuisine traditionnelle de qualité."
    ],
    "es": [
      "Todos los platos de Lucie y Jonathan son caseros, con productos frescos y locales, ofreciendo a sus clientes una cocina tradicional y de calidad."
    ],
    "nl": [
      "Alle gerechten van Lucie en Jonathan zijn huisgemaakt met verse, lokale producten en bieden hun klanten een traditionele keuken van hoge kwaliteit."
    ]
  },
