          "additionalInformation": {
            "de": [
              "Winter: (mit Skiern an den Füßen)\n- flug \"PRESTIGE\" 100 ? 1000 m Höhenunterschied\n- flug \"MUST\" 130 ? 1200 m Höhenunterschied\n\nSommer:\nSommerflug 110 ? 1000 m Höhenunterschied\n\nVideoreportage während des Fluges (Gopro-Kamera) 30 ?"
            ],
            "en": [
              "Winter: (with skis on)\n- flight \"PRESTIGE\" 100 ? 1000 m ascent\n- flight \"MUST\" 130 ? 1200 m ascent\n\nSummer:\nL'envol d'été 110 ? 1000 m ascent\n\nIn-flight video (Gopro camera) 30 ?"
            ],
            "it": [
              "Inverno : (con gli sci ai piedi)\n- volo \"PRESTIGE\" 100 ? 1000 m di dislivello\n- volo \"MUST\" 130 ? 1200 m di ascesa\n\nIn estate :\nL'envol d'été 110 ? 1000 m di ascesa\n\nReportage video in volo (videocamera Gopro) 30 ?"
            ],
            "fr": [
              "Hiver : (avec les skis aux pieds)\n- vol \"PRESTIGE\" 100 € 1000 m de dénivelé\n- vol \"MUST\" 130 € 1200 m de dénivelé\n\nEn été :\nL'envol d'été 110 € 1000 m de dénivelé\n\nReportage vidéo en vol (caméra Gopro) 30 €"
            ],
            "nl": [
              "Winter : (met ski's aan)\n- vlucht \"PRESTIGE\" 100 ? 1000 m stijging\n- vlucht \"MUST\" 130 ? 1200 m stijging\n\nIn de zomer :\nL'envol d'été 110 ? 1000 m stijging\n\nVideoverslag tijdens de vlucht (Gopro camera) 30 ?"
            ],
            "es": [
              "Invierno : (con los esquís puestos)\n- vuelo \"PRESTIGE\" 100 ? 1000 m de ascenso\n- vuelo \"MUST\" 130 ? 1200 m de ascenso\n\nEn verano :\nL'envol d'été 110 ? 1000 m ascenso\n\nReportaje de vídeo en vuelo (cámara Gopro) 30 ?"
            ]
