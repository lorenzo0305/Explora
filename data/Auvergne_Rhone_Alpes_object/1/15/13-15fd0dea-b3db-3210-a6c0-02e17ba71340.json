  "rdfs:comment": {
    "de": [
      "Laetitia Chablard vom Haus Ticha Couture, Schneiderin und Modellistin für maßgeschneiderte Kleidung, öffnet die Türen ihres Ateliers und empfängt Sie, um Ihre Fragen und Wünsche zu beantworten."
    ],
    "en": [
      "Laetitia Chablard, from Maison Ticha Couture, tailor-model maker of made-to-measure garments, opens the doors of her workshop and welcomes you to answer your questions and requests."
    ],
    "it": [
      "Laetitia Chablard, della Maison Ticha Couture, sarta e modellista su misura, aprirà le porte del suo atelier per rispondere alle vostre domande e richieste."
    ],
    "fr": [
      "Laetitia Chablard, de la Maison Ticha Couture, couturière-modéliste vêtements sur mesure, vous ouvre les portes de son atelier et vous reçoit pour répondre à vos questions et demandes."
    ],
    "es": [
      "Laetitia Chablard, de la Maison Ticha Couture, modista y modelista a medida, abrirá las puertas de su taller para responder a sus preguntas y peticiones."
    ],
    "nl": [
      "Laetitia Chablard van Maison Ticha Couture, kleermaker en modelmaakster op maat, opent de deuren van haar atelier om je vragen en verzoeken te beantwoorden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Portes ouvertes de l'atelier Maison Ticha couture #5 - Journée Européennes des Métiers d'Art"
    ]
  },
