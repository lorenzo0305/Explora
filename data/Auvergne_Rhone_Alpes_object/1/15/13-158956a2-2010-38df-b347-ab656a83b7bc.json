  "rdfs:comment": {
    "de": [
      "Am Fuße des Staudamms, 5 Minuten von Roanne entfernt, empfängt Sie die Auberge du Pont, um ihre Frösche, Pommes frites und Salate am Ufer der Loire auf ihrer schattigen und überdachten Terrasse zu entdecken."
    ],
    "en": [
      "At the foot of the dam, 5 minutes from Roanne, the Auberge du Pont welcomes you to discover its frogs, fried fish and salads, on the banks of the Loire, on its shady, covered terrace."
    ],
    "it": [
      "Ai piedi della diga, a 5 minuti da Roanne, l'Auberge du Pont vi accoglie per farvi scoprire le sue rane, patatine e insalate, sulle rive della Loira, sulla sua terrazza coperta e ombreggiata."
    ],
    "fr": [
      "Au pied du barrage, à 5 min de Roanne, l'auberge du Pont vous accueille pour découvrir ses grenouilles, fritures, salades, au bord de la Loire, sur sa terrasse ombragée et couverte."
    ],
    "es": [
      "Al pie del embalse, a 5 minutos de Roanne, el Auberge du Pont le da la bienvenida para que descubra sus ranas, patatas fritas y ensaladas, a orillas del Loira, en su terraza cubierta y sombreada."
    ],
    "nl": [
      "Aan de voet van de stuwdam, op 5 minuten van Roanne, verwelkomt de Auberge du Pont u om zijn kikkers, frieten en salades te ontdekken, aan de oever van de Loire, op zijn schaduwrijke, overdekte terras."
    ]
  },
  "rdfs:label": {
