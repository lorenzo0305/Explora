  "rdfs:comment": {
    "de": [
      "Unser Restaurant-Pizzeria freut sich auf Ihren Besuch und bietet Ihnen köstliche Pizzen, Burger, Salate, belegte Brote, italienische Spezialitäten...zum Verzehr vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Our restaurant-pizzeria will be delighted to welcome you and offer its delicious pizzas, burgers, salads, and mountain specialities...to taste on-site or to take away."
    ],
    "it": [
      "Il nostro ristorante-pizzeria sarà lieto di accogliervi e di offrirvi deliziose pizze, hamburger, insalate, panini, specialità italiane... da mangiare o da portare via."
    ],
    "fr": [
      "Notre restaurant-pizzeria sera ravi de vous accueillir pour vous proposer de délicieuses pizzas, burgers, salades, tartines, spécialités italiennes...à déguster sur place ou à emporter."
    ],
    "nl": [
      "Ons restaurant-pizzeria verwelkomt u graag en biedt u heerlijke pizza's, hamburgers, salades, sandwiches, Italiaanse specialiteiten...om te eten of mee te nemen."
    ],
    "es": [
      "Nuestro restaurante-pizzería estará encantado de recibirle y ofrecerle deliciosas pizzas, hamburguesas, ensaladas, sándwiches, especialidades italianas... para comer en casa o para llevar."
    ]
  },
