  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6d16bd4-1fe6-3893-b480-150220ffefa4",
      "dc:description": {
        "de": [
          "Herr Rihouey (Harly) Alain - professioneller Fotograf , bietet Ihnen verschiedene Leistungen an:\nKommerzielle Fotografie, Studio-Außenaufnahmen, künstlerische Fotografie, kulinarische Fotografie, Architektur, Computergrafik, Hochzeitsfotografie, Events, Mode, Porträt, Familie, Tiere...\nKontakt: eventyouphot@gmail.com"
        ],
        "en": [
          "Mr. Rihouey (Harly) Alain - Professional photographer, offers you several services:\nCommercial, studio/outdoor, artistic, culinary, architectural, computer graphics, wedding, event, fashion, portrait, family, animal photography...\nContact : eventyouphot@gmail.com"
        ],
        "it": [
          "Mr Rihouey (Harly) Alain - Fotografo professionista, vi offre diversi servizi:\nFotografia commerciale, fotografia in studio e in esterni, fotografia d'arte, fotografia di cibo, architettura, grafica computerizzata, fotografia di matrimonio, fotografia di eventi, fotografia di moda, fotografia di ritratto, fotografia di famiglia, fotografia di animali...\nContatto : eventyouphot@gmail.com"
        ],
        "fr": [
          "Monsieur Rihouey (Harly) Alain - Photographe professionnel , vous propose plusieurs prestations : \nPhotographies commerciales, studio-extérieur, artistiques, culinaires, architecture, infographie, photos de mariage, événement, mode, portrait, famille, animaux...\nContact : eventyouphot@gmail.com"
        ],
        "es": [
          "Sr. Rihouey (Harly) Alain - Fotógrafo profesional, le ofrece varios servicios:\nFotografía comercial, fotografía de estudio y exterior, fotografía artística, fotografía de alimentos, arquitectura, infografía, fotografía de bodas, fotografía de eventos, fotografía de moda, fotografía de retratos, fotografía familiar, fotografía de mascotas...\nContacto : eventyouphot@gmail.com"
        ],
        "nl": [
          "Mr Rihouey (Harly) Alain - Professionele fotograaf, biedt u verschillende diensten aan:\nCommerciële fotografie, studio- en buitenfotografie, kunstfotografie, voedselfotografie, architectuur, computergrafiek, huwelijksfotografie, evenementenfotografie, modefotografie, portretfotografie, familiefotografie, huisdierenfotografie...\nContact : eventyouphot@gmail.com"
        ]
      },
