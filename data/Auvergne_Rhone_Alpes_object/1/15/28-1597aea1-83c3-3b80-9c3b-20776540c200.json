  "rdfs:comment": {
    "de": [
      "Traditionelles Menü, Vorschlagstafel, Tagesgezeiten und exotische Gerichte. Im Le Petit Journal werden Miesmuscheln aus Dünkirchen angeboten. Seine Spezialitäten: Tartar à ma façon, Welsh fermier, Onglet vom Rind, thailändische Gerichte."
    ],
    "en": [
      "Traditional menu, suggestion board, daily tide and exotic dishes. Le Petit Journal offers mussels from Dunkerque. Its specialties: tartar my way, farmhouse welsh, beef onglet, Thai dishes."
    ],
    "it": [
      "Menu tradizionale, lavagna dei suggerimenti, marea giornaliera e piatti esotici. Le Petit Journal propone cozze di Dunkerque. Le sue specialità: tartare à ma façon, fermier gallese, onglet de b?uf, piatti thailandesi."
    ],
    "fr": [
      "Menu traditionnel, tableau de suggestions, marée du jour et plats exotiques. Le Petit Journal propose des moules de Dunkerque. Ses spécialités : tartare à ma façon, welsh fermier, onglet de bœuf, plats thaïlandais."
    ],
    "nl": [
      "Traditioneel menu, suggestiebord, dagelijkse tij en exotische gerechten. Le Petit Journal biedt mosselen uit Duinkerken. Zijn specialiteiten: tartaar à ma façon, welsh fermier, onglet de b?uf, Thaise gerechten."
    ],
    "es": [
      "Menú tradicional, tabla de sugerencias, marea diaria y platos exóticos. Le Petit Journal ofrece mejillones de Dunkerque. Sus especialidades: tartare à ma façon, fermier galés, onglet de bœuf, platos tailandeses."
    ]
  },
