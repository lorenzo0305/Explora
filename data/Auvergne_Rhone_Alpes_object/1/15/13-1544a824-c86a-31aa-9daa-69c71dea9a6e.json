  "rdfs:comment": {
    "de": [
      "Kleines überdachtes Becken, ideal, um das Wasser zu erkunden und das Schwimmen zu lernen.\r\nBabyschwimmen, Club-Pool für Kinder von 6 bis 11 Jahren\r\nUnterricht im Schwimmen\r\nWellnessbereich mit Sauna und Hammam.\r\nAquabike und Wassergymnastik, Massage und Osteo im Wasser."
    ],
    "en": [
      "Small indoor pool, ideal for learning to swim.\r\nBaby swim sessions, pool club for 6/11 year-olds\r\nSwimming lessons\r\nWellness area with sauna and hammam.\r\nAquabike and aquagym, massage and osteopathy in the water."
    ],
    "it": [
      "Piccola piscina coperta, ideale per familiarizzare con l'acqua e imparare a nuotare.\r\nSessioni di nuoto per bambini, pool club per bambini di 6/11 anni\r\nLezioni di nuoto\r\nArea benessere con sauna e hammam.\r\nAquabike e aquagym, massaggi e osteopatia in acqua."
    ],
    "fr": [
      "Petit bassin couvert, idéal pour l’appréhension de l'eau et l'apprentissage de la natation. \r\nCréneaux bébés nageurs, club piscine pour les 6/11ans\r\nLeçon de natation\r\nEspace bien-être avec sauna et hammam.\r\nAquabike et aquagym, massage et osthéo dans l'eau."
    ],
    "es": [
      "Pequeña piscina cubierta, ideal para familiarizarse con el agua y aprender a nadar.\r\nSesiones de natación para bebés, club de piscina para niños de 6/11 años\r\nClases de natación\r\nZona de bienestar con sauna y hammam.\r\nAquabike y aquagym, masajes y osteopatía en el agua."
    ],
    "nl": [
      "Klein overdekt zwembad, ideaal om kennis te maken met water en om te leren zwemmen.\r\nBabyzwemsessies, zwemclub voor 6/11-jarigen\r\nZwemlessen\r\nWellnessruimte met sauna en hammam.\r\nAquabike en aquagym, massage en osteopathie in het water."
    ]
  },
