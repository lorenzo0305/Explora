  "rdfs:comment": {
    "de": [
      "Das Hotel Casa Moho ? Saint-François-Longchamp 1450 lädt Sie zu einer unvergesslichen Auszeit im Herzen des Maurienne-Tals ein. In einer modernen, gemütlichen und kürzlich renovierten Umgebung."
    ],
    "en": [
      "The Hotel Casa Moho - Saint-François-Longchamp 1450 invites you to enjoy an unforgettable getaway in the heart of the Maurienne valley. In a modern, warm and recently renovated setting."
    ],
    "it": [
      "L'Hotel Casa Moho ? Saint-François-Longchamp 1450 vi invita a vivere una fuga indimenticabile nel cuore della valle della Maurienne. In un ambiente moderno, accogliente e recentemente rinnovato."
    ],
    "fr": [
      "L'Hôtel Casa Moho – Saint-François-Longchamp 1450 vous invite à vivre une escapade inoubliable au cœur de la vallée de la Maurienne. Dans un cadre moderne, chaleureux et récemment rénové."
    ],
    "nl": [
      "Hotel Casa Moho ? Saint-François-Longchamp 1450 nodigt u uit voor een onvergetelijk verblijf in het hart van de Maurienne-vallei. In een modern, warm en onlangs gerenoveerd kader."
    ],
    "es": [
      "El Hotel Casa Moho ? Saint-François-Longchamp 1450 le invita a vivir una escapada inolvidable en el corazón del valle de Maurienne. En un entorno moderno, cálido y recientemente renovado."
    ]
  },
