      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Sonntag von 9:30 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\n\n \nAbholung:\n Zu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Sunday, 9:30am to 12:30pm and 2pm to 7pm\n\n \nPick-up :\n During store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDa lunedì a domenica, dalle 9.30 alle 12.30 e dalle 14.00 alle 19.00\n\n \nRitiro:\n Durante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au dimanche de 9h30 à 12h30 et de 14h à 19h\n\n \nRetrait :\n Aux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot zondag van 9u30 tot 12u30 en van 14u tot 19u\n\n \nOphalen:\n Tijdens openingstijden van de winkel\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a domingo, de 9.30 a 12.30 h. y de 14.00 a 19.00 h\n\n \nRecogida:\n Durante el horario de apertura de la tienda\n\n "
        ]
      },
