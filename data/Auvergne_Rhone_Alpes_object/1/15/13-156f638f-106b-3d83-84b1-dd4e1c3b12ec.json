  "rdfs:comment": {
    "de": [
      "Die Kunst, Ihnen ein Terroir zu erzählen! Lassen Sie sich von Eric abseits der ausgetretenen Pfade auf Querwegen tragen, die Sie dazu bringen werden, diese so einzigartigen Landstriche zu entdecken und zu atmen."
    ],
    "en": [
      "The art of telling the story of a land! Listen as Eric takes you off the beaten track, and down the narrow paths, on a discovery to embrace this unique land."
    ],
    "it": [
      "L'arte di raccontare una regione! Lasciate che Eric vi porti fuori dai sentieri battuti in un viaggio alla scoperta di queste terre così speciali."
    ],
    "fr": [
      "L'art de vous conter un terroir ! Laissez vous porter par Eric, loin des sentiers battus, sur des chemins de traverse qui vous amèneront à découvrir et respirer ces terres si singulières."
    ],
    "es": [
      "El arte de hablarle de una región Deje que Eric le lleve fuera de los caminos trillados en un viaje de descubrimiento por estas tierras tan especiales."
    ],
    "nl": [
      "De kunst van het vertellen over een streek! Laat Eric je meenemen op een ontdekkingsreis door dit bijzondere land."
    ]
  },
