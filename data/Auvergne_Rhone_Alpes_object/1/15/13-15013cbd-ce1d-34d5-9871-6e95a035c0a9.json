  "rdfs:comment": {
    "de": [
      "Die Compagnie des bateaux nimmt Sie mit auf eine Kreuzfahrt mit Zwischenstopp in Annecy, damit Sie die Stadt im Urlaubsmodus entdecken können. Es gibt keinen Stress! Kaufen Sie Ihre Tickets in den Fremdenverkehrsbüros der Sources du lac d'Annecy, um sicher zu gehen, dass Sie zuerst an Bord gehen!"
    ],
    "en": [
      "The Compagnie des bateaux takes you on a cruise with a stop in Annecy to discover the town in holiday mode. No stress! Buy your tickets beforehands at the tourist offices of the Sources du lac d'Annecy to make sure you get on board!"
    ],
    "it": [
      "La Compagnie des bateaux vi porta in crociera con scalo ad Annecy per scoprire la città in modalità vacanza. Niente stress! Acquistate i biglietti presso gli uffici turistici delle Sources du lac d'Annecy per essere sicuri di salire a bordo per primi!"
    ],
    "fr": [
      "La Compagnie des bateaux vous emmène en croisière avec escale à Annecy pour découvrir la ville en mode vacances. Pas de stress ! Achetez vos billets aux offices de tourisme des Sources du lac d'Annecy pour être sûrs d'embarquer en priorité !"
    ],
    "es": [
      "La Compagnie des bateaux le lleva en crucero con escala en Annecy para descubrir la ciudad en modo vacaciones. ¡Sin estrés! Compre sus billetes en las oficinas de turismo de Sources du lac d'Annecy para subir a bordo el primero"
    ],
    "nl": [
      "De Compagnie des bateaux neemt je mee op een cruise met tussenstop in Annecy om de stad in vakantiemodus te ontdekken. Geen stress! Koop je tickets bij de VVV-kantoren van Sources du lac d'Annecy om er zeker van te zijn dat je als eerste aan boord kunt!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Compagnie des bateaux - Lake Annecy Omnibus boat tour"
    ],
    "fr": [
      "Compagnie des bateaux - Bateau Doussard-Annecy"
    ]
  },
