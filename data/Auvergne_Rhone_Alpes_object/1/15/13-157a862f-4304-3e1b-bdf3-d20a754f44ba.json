  "rdfs:comment": {
    "de": [
      "Die Ecole du Ski Français de Montriond /Les Lindarets bietet Ihnen Alpinski- und Snowboardkurse für Erwachsene und Kinder, einen Kids Club (mit Gruppenkursen und Kinderbetreuung, von 3 Jahren bis 10 Jahren) sowie Skitouren und Tiefschneefahren an."
    ],
    "en": [
      "Montriond-Les Lindarets ski school offers downhill ski and snowboard lessons for adults and children, Kids Club (from 3yrs1/2 to 10yrs), ski touring, and off-piste skiing."
    ],
    "it": [
      "La scuola di sci francese di Montriond/Les Lindarets offre lezioni di sci alpino e snowboard per adulti e bambini, un Kids Club (con lezioni di gruppo e assistenza ai bambini dai 3 anni e mezzo ai 10 anni), oltre a sci alpinismo e sci fuori pista."
    ],
    "fr": [
      "L'Ecole du Ski Français de Montriond /Les Lindarets vous propose des cours de ski alpin ou snowboard pour adultes et enfants, un Kids Club (avec cours collectifs + garderie, de 3ans1/2 à 10ans), et aussi encadrement en ski de randonnée et ski hors piste."
    ],
    "es": [
      "La Escuela Francesa de Esquí de Montriond/Les Lindarets ofrece clases de esquí alpino y snowboard para adultos y niños, un Club Infantil (con clases en grupo y guardería, de 3 años y medio a 10 años), así como esquí de travesía y esquí fuera de pista."
    ],
    "nl": [
      "De Franse skischool Montriond/Les Lindarets biedt ski- en snowboardlessen voor volwassenen en kinderen, een Kids Club (met groepslessen en kinderopvang, van 3 1/2 tot 10 jaar), maar ook toerskiën en skiën buiten de pistes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Montriond - les Lindarets French Ski School"
    ],
    "fr": [
      "ESF Montriond - les Lindarets"
    ]
  },
