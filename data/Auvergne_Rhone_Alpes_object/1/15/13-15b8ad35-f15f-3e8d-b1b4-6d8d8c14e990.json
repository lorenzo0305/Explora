  "rdfs:comment": {
    "de": [
      "Die Rodelbahn in Chef-lieu zwischen der Kirche und dem Freizeitbereich von Contamines wird im Winter präpariert, wenn die Schneeverhältnisse es zulassen."
    ],
    "en": [
      "The Chef-lieu toboggan run between the church and the Contamines leisure area is groomed during the winter season, snow conditions permitting."
    ],
    "it": [
      "La pista da slittino di Chef-lieu, tra la chiesa e l'area ricreativa di Contamines, viene battuta durante la stagione invernale, condizioni di neve permettendo."
    ],
    "fr": [
      "La piste de luge du Chef-lieu, située entre l'Église et l'aire de loisirs des Contamines est damée sur la saison hivernale quand les conditions d'enneigement le permettent."
    ],
    "es": [
      "La pista de trineo de Chef-lieu, entre la iglesia y la zona de ocio de Contamines, está acondicionada durante la temporada de invierno si las condiciones de la nieve lo permiten."
    ],
    "nl": [
      "De rodelbaan Chef-lieu tussen de kerk en het recreatiegebied Contamines wordt in de winter geprepareerd als de sneeuwcondities het toelaten."
    ]
  },
