  "rdfs:comment": {
    "de": [
      "Delphine Mammoliti bietet diese Dienstleistungen als \"Naturheilpraktikerin\" für Stressbewältigung, unruhigen Schlaf, Gewichtsmanagement, Müdigkeit, Frauenbeschwerden, Schmerzen, Verdauungsmanagement, Haut- und Haarpflege an."
    ],
    "en": [
      "Delphine Mammoliti offers these \"naturopathic\" services for stress management, restless sleep, weight management, fatigue, women's disorders, pain, digestion management, skin and hair care."
    ],
    "it": [
      "Delphine Mammoliti offre i suoi servizi \"naturopatici\" per la gestione dello stress, il sonno agitato, la gestione del peso, la fatica, i problemi delle donne, il dolore, la gestione della digestione, la cura della pelle e dei capelli."
    ],
    "fr": [
      "Delphine Mammoliti propose ces services de \"naturopathe\" pour la gestion du stress, du sommeil agité, la gestion du poids, la fatigue, les troubles féminins, la douleur, la gestion de la digestion, le soin de la peau et des cheveux."
    ],
    "es": [
      "Delphine Mammoliti ofrece sus servicios \"naturopáticos\" para la gestión del estrés, el sueño intranquilo, el control del peso, la fatiga, los problemas de la mujer, el dolor, la gestión digestiva y el cuidado de la piel y el cabello."
    ],
    "nl": [
      "Delphine Mammoliti biedt haar \"natuurgeneeskundige\" diensten aan voor stressmanagement, onrustig slapen, gewichtsbeheersing, vermoeidheid, vrouwenproblemen, pijn, spijsverteringsmanagement, huid- en haarverzorging."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Naturopathe - Delphine Mammoliti"
    ]
  },
