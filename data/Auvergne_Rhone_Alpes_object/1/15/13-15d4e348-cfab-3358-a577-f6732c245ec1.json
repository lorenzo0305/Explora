  "rdfs:comment": {
    "de": [
      "Eine Familienroute in der Planèze de Saint-Flour, einem vulkanischen Hochplateau mit einer sehr offenen Landschaft, die von einigen Hainen und Hecken, hochgelegenen Wiesen und Anbauflächen durchzogen ist. Schöne typische Dörfer bieten sich als Zwischenstopps auf der Route an."
    ],
    "en": [
      "A family trail in the Planèze de Saint-Flour, a volcanic plateau with a very open landscape, dotted with copses and hedges, high meadows and crops. Beautiful, typical villages are just some of the stops along the way."
    ],
    "it": [
      "Un percorso per famiglie nella Planèze de Saint-Flour, un altopiano vulcanico con un paesaggio molto aperto, punteggiato da alcuni boschetti e siepi, prati alti e coltivazioni. Lungo il percorso ci sono molti bei villaggi tipici in cui fermarsi."
    ],
    "fr": [
      "Un parcours familial en Planèze de Saint-Flour, haut plateau volcanique au paysage très ouvert, parsemé de quelques bosquets et de haies, de prairies d'altitude et de cultures. De beaux villages typiques sont autant de haltes sur l'itinéraire."
    ],
    "es": [
      "Un sendero familiar en la Planèze de Saint-Flour, una alta meseta volcánica con un paisaje muy abierto, salpicado de algunos bosquecillos y setos, prados altos y cultivos. A lo largo del recorrido se pueden visitar numerosos pueblos típicos."
    ],
    "nl": [
      "Een familiewandeling in de Planèze de Saint-Flour, een hoog vulkanisch plateau met een zeer open landschap, bezaaid met enkele bosjes en hagen, hoge weiden en gewassen. Er zijn veel mooie, typische dorpjes om onderweg te stoppen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit VAE n°19 : L'Usseloise"
    ]
  },
