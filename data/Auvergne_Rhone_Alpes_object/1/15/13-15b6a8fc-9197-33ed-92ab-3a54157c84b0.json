  "rdfs:comment": {
    "de": [
      "Zum 34. Mal findet hier das unumgängliche Rendezvous für Rassehunde der Centrale Canine statt... organisiert von der Association Canine Territoriale du Bourbonnais. Fast 2500 Hunde werden anwesend sein und von einer internationalen Jury beurteilt werden."
    ],
    "en": [
      "Now in its 34th year, this is the must-attend event for Centrale Canine pedigree dogs... organized by the Association Canine Territoriale du Bourbonnais. Nearly 2,500 dogs will be present, and judged by an international jury."
    ],
    "it": [
      "Giunto alla 34a edizione, è l'evento imperdibile per i cani di razza Centrale Canine... organizzato dall'Association Canine Territoriale du Bourbonnais. Saranno presenti quasi 2.500 cani, giudicati da una giuria internazionale."
    ],
    "fr": [
      "Pour sa 34ième édition, voici le rendez vous incontournable pour les chiens de race de la Centrale Canine... organisé par l'Association Canine Territoriale du Bourbonnais. Près de 2500 chiens seront présents, et jugés par un jury international."
    ],
    "es": [
      "En su 34ª edición, es la cita ineludible de los perros de raza Centrale Canine... organizada por la Association Canine Territoriale du Bourbonnais. Cerca de 2.500 perros estarán presentes y serán juzgados por un jurado internacional."
    ],
    "nl": [
      "Dit is nu al 34 jaar lang hét evenement voor rashonden van de Centrale Canine... georganiseerd door de Association Canine Territoriale du Bourbonnais. Bijna 2.500 honden zullen aanwezig zijn en gekeurd worden door een internationale jury."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Canine Internationale"
    ]
  },
