  "rdfs:comment": {
    "de": [
      "Dieser Park, der als Kulisse für die Villa Louvière im Stil des Petit Trianon in Versailles dient, ist ein schöner Kompromiss zwischen einem französischen Garten und einem englischen Park.\r\nAuf Reservierung, Abfahrt mit mindestens 2 Personen."
    ],
    "en": [
      "Set in the grounds of Villa Louvière, inspired by the Petit Trianon at Versailles, this park is a lovely compromise between a formal garden and an English park.\r\nReservations required, minimum 2 people."
    ],
    "it": [
      "Situato nel parco di Villa Louvière, ispirato al Petit Trianon di Versailles, questo parco è un bel compromesso tra un giardino formale e un parco all'inglese.\r\nPrenotazione obbligatoria, minimo 2 persone."
    ],
    "fr": [
      "Servant d'écrin à la Villa Louvière dans l'inspiration du Petit Trianon de Versailles, ce parc est un joli compromis entre jardin à la française et parc à l'anglaise.\r\nSur réservation, départ avec minimum 2 personnes."
    ],
    "es": [
      "Situado en los terrenos de Villa Louvière, inspirado en el Petit Trianon de Versalles, este parque es un encantador compromiso entre un jardín formal y un parque inglés.\r\nReserva obligatoria, mínimo 2 personas."
    ],
    "nl": [
      "Dit park ligt op het terrein van Villa Louvière en is geïnspireerd op het Petit Trianon in Versailles. Het is een mooi compromis tussen een formele tuin en een Engels park.\r\nReserveren verplicht, minimaal 2 personen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rendez-vous aux Jardins : Il était une fois le parc de la Louvière"
    ]
  },
