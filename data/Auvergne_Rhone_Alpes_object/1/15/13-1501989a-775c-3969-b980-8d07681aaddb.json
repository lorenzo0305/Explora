  "rdfs:comment": {
    "de": [
      "Mit dem Gütesiegel \"Zentrum für Reittourismus, Pferdestation und Tierschutz\" ausgezeichnet, in einem familiären und sympathischen Rahmen, bietet Kurse für alle Altersgruppen und Niveaus, Ausritte zu Pferd oder Pony, verschiedene Disziplinen"
    ],
    "en": [
      "Certified equestrian tourism, horse and animal welfare center, in a friendly family setting, offering lessons for all ages and levels, horse and pony rides, various disciplines."
    ],
    "it": [
      "Un centro certificato per il turismo equestre, l'equitazione e il benessere degli animali, in un ambiente familiare e accogliente, che offre lezioni per tutte le età e tutti i livelli, passeggiate a cavallo o con i pony e varie discipline"
    ],
    "fr": [
      "Labellisé centre de tourisme équestre, cheval étape et bien-être animal, dans un cadre familial et sympathique, proposant des cours pour tous âges et tous niveaux, des promenades à cheval ou à poney, différentes disciplines"
    ],
    "es": [
      "Un centro certificado de turismo ecuestre, equitación y bienestar animal, en un entorno familiar y acogedor, que ofrece clases para todas las edades y todos los niveles, paseos a caballo o en poni y diversas disciplinas"
    ],
    "nl": [
      "Een gecertificeerd centrum voor paardentoerisme, paardrijden en dierenwelzijn, in een gezellige familieomgeving, met lessen voor alle leeftijden en alle niveaus, paard- of ponyritten en verschillende disciplines"
    ]
  },
