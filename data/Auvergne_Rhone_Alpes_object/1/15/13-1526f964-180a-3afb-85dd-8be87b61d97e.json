  "rdfs:comment": {
    "de": [
      "Das Atelier Filhouette bietet kreative und künstlerische Workshops an,\r\ndie an das Berufs- und Privatleben angepasst werden können.\r\nes ist auch ein Geschäft für Kunsthandwerk aus Papier und emaillierter Lava."
    ],
    "en": [
      "Atelier Filhouette offers creative and artistic workshops,\r\nadaptable to both professional and personal life.\r\nit's also a boutique for paper arts and crafts and enamelled lava."
    ],
    "it": [
      "Il laboratorio Filhouette offre laboratori creativi e artistici,\r\nadattabili sia alla vita professionale che a quella personale.\r\nè anche una boutique di arti e mestieri di carta e di lava smaltata."
    ],
    "fr": [
      "L’atelier Filhouette propose des ateliers créatifs et artistiques,\r\nadaptables à la vie professionnelle et personnelle.\r\n﻿C'est également une boutique d'artisanat d'art du papier et de lave émaillée."
    ],
    "es": [
      "El taller Filhouette ofrece talleres creativos y artísticos\r\nadaptables tanto a la vida profesional como personal.\r\ntambién es una boutique de artesanía en papel y lava esmaltada."
    ],
    "nl": [
      "De Filhouette workshop biedt creatieve en artistieke workshops,\r\naan te passen aan zowel het professionele als het persoonlijke leven.\r\nhet is ook een boetiek voor papierkunst en geëmailleerde lava."
    ]
  },
