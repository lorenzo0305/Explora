  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen Moment der Entspannung in unserem Spa, das sich im 1. Stock des Hotels Alpen Valley befindet. Bitte beachten Sie, dass das SPA nur für Gäste des Hotels Alpen Valley zugänglich ist."
    ],
    "en": [
      "Treat yourself to a moment of relaxation in our spa on the 1st floor in Alpen Valley's hotel. Please note that the SPA is only accessible to guests of the Alpen Valley Hotel."
    ],
    "it": [
      "Concedetevi un momento di relax nella nostra spa al 1° piano dell'hotel Alpen Valley. Si prega di notare che la SPA è accessibile solo agli ospiti dell'hotel Alpen Valley."
    ],
    "fr": [
      "Accordez-vous un moment de relaxation dans notre spa situé au 1er étage de l'hôtel Alpen Valley. Attention le SPA est accessible uniquement aux clients de l'hôtel Alpen Valley."
    ],
    "es": [
      "Regálese un momento de relajación en nuestro spa de la 1ª planta del hotel Alpen Valley. Tenga en cuenta que al SPA solo pueden acceder los huéspedes del hotel Alpen Valley."
    ],
    "nl": [
      "Gun jezelf een moment van ontspanning in onze spa op de 1e verdieping van het Alpen Valley hotel. Let op: de SPA is alleen toegankelijk voor gasten van het Alpen Valley hotel."
    ]
  },
  "rdfs:label": {
