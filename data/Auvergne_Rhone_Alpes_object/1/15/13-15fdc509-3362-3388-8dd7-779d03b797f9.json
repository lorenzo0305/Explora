  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Herzen des Vulkanwaldes von Aydat ein neues, verantwortungsbewusstes und innovatives Konzept für einen Freizeitpark!\r\nLaserwood, Experience Game, ein nächtlicher Rundgang mit Geschichten, Ton- und Lichtspiele... erleben Sie mit der Familie oder mit Freunden."
    ],
    "en": [
      "In the heart of the Aydat volcanic forest, discover a new concept in responsible, innovative leisure parks!\r\nLaser-wood, experience game, night-time storytelling, sound and light show... to enjoy with family and friends."
    ],
    "it": [
      "Nel cuore della foresta vulcanica di Aydat, scoprite un nuovo concetto di parco divertimenti responsabile e innovativo!\r\nLegno laser, gioco esperienziale, narrazione notturna, spettacolo di suoni e luci... da vivere in famiglia o con gli amici."
    ],
    "fr": [
      "Au cœur de la forêt volcanique d'Aydat, découvrez un nouveau concept de parc de loisir, responsable et innovant !\r\nLaser-wood, expérience game, parcours nocturne conté, son et lumières... à vivre en famille ou entre amis."
    ],
    "nl": [
      "Ontdek in het hart van het vulkaanbos Aydat een nieuw concept in verantwoorde, innovatieve vrijetijdsparken!\r\nLaserhout, belevingsspel, nachtelijke vertellingen, geluids- en lichtshow... om samen met je familie of vrienden van te genieten."
    ],
    "es": [
      "En el corazón del bosque volcánico de Aydat, ¡descubra un nuevo concepto de parque de ocio responsable e innovador!\r\nLáser-madera, juego de experiencias, cuentacuentos nocturno, espectáculo de luz y sonido... para disfrutar en familia o con amigos."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Forêt des Arboris"
    ],
    "fr": [
      "La Forêt des Arboris"
    ]
  },
