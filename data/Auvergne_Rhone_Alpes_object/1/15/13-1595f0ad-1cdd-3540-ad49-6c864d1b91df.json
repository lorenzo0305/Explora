  "rdfs:comment": {
    "de": [
      "Ich bin Jean-Marie, ein leidenschaftlicher Autodidakt. Ich entwerfe Keramikstücke, die von der Natur inspiriert sind. Jedes Objekt vereint Einfachheit, Authentizität und Nachhaltigkeit. Entdecken Sie meine handwerkliche Welt in Saint-Didier-la-Forêt."
    ],
    "en": [
      "I am Jean-Marie, passionate about crafts, and a self-taught potter. This art allows me to transform clay into everyday objects. Each piece I create reflects my love for natural materials."
    ],
    "it": [
      "Sono Jean-Marie, un appassionato artista autodidatta che crea pezzi di ceramica ispirati alla natura. Ogni oggetto combina semplicità, autenticità e durata. Scoprite il mio mondo artigianale a Saint-Didier-la-Forêt."
    ],
    "fr": [
      "Moi c'est Jean-Marie, autodidacte passionné, je crée des pièces en céramique inspirées par la nature. Chaque objet allie simplicité, authenticité et durabilité. Découvrez mon univers artisanal à Saint-Didier-la-Forêt."
    ],
    "es": [
      "Soy Jean-Marie, un apasionado artista autodidacta que crea piezas de cerámica inspiradas en la naturaleza. Cada objeto combina sencillez, autenticidad y durabilidad. Descubra mi mundo de artesanía en Saint-Didier-la-Forêt."
    ],
    "nl": [
      "Ik ben Jean-Marie, een gepassioneerde autodidactische kunstenaar die keramische stukken maakt die geïnspireerd zijn door de natuur. Elk object combineert eenvoud, authenticiteit en duurzaamheid. Ontdek mijn wereld van vakmanschap in Saint-Didier-la-Forêt."
    ]
  },
