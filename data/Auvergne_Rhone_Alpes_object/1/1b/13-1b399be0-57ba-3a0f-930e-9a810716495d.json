  "rdfs:comment": {
    "de": [
      "Man trifft sich an der Bar für einen geselligen und spielerischen Moment: Holzspiele oder Arcade-Spiele, manche ziehen es vor, sich ein Buch aus der großen Bibliothek auszuleihen, während sie einen Cocktail oder ein heißes Getränk genießen."
    ],
    "en": [
      "We meet up at the bar for a friendly, playful moment: wooden games or arcade games, some prefer to borrow a book from the large library while enjoying a cocktail or a hot drink."
    ],
    "it": [
      "Ci incontriamo al bar per divertirci in modo amichevole: giochi di legno o giochi arcade, alcuni preferiscono prendere in prestito un libro dalla grande biblioteca mentre si gustano un cocktail o una bevanda calda."
    ],
    "fr": [
      "On se retrouve au bar pour un moment convivial et ludique : jeux en bois ou jeu d’arcade, certains préféreront emprunter un livre de la grande bibliothèque en dégustant un cocktail ou une boisson chaude."
    ],
    "nl": [
      "We ontmoeten elkaar aan de bar voor een gezellige, leuke tijd: houten spelletjes of arcadespelletjes, sommigen lenen liever een boek uit de grote bibliotheek onder het genot van een cocktail of een warm drankje."
    ],
    "es": [
      "Nos reunimos en el bar para pasar un rato agradable y divertido: juegos de madera o recreativos, algunos prefieren tomar prestado un libro de la gran biblioteca mientras disfrutan de un cóctel o una bebida caliente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar St-Alban Hôtel & Spa"
    ]
  },
