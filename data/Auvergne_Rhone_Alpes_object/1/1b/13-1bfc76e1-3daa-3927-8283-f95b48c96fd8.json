  "rdfs:comment": {
    "de": [
      "In Bourg-de-Péage im Departement Drôme empfängt Sie das Wassersportzentrum DIABOLO des Gemeindeverbands Valence Romans Agglo das ganze Jahr über, 7 Tage die Woche, um Ihnen das Beste an Sport, Entspannung und Freizeit zu bieten."
    ],
    "en": [
      "In Bourg-de-Péage, Drôme, the DIABOLO aquatic center of the Valence Romans Agglo community welcomes you all year round, 7 days a week, to offer you the best in sports, relaxation and leisure."
    ],
    "it": [
      "A Bourg-de-Péage, nella Drôme, il centro acquatico DIABOLO della comunità Valence Romans Agglo vi accoglie tutto l'anno, 7 giorni su 7, per offrirvi il meglio dello sport, del relax e del tempo libero."
    ],
    "fr": [
      "À Bourg-de-Péage, dans la Drôme, le centre aquatique DIABOLO de la communauté d’agglomération Valence Romans Agglo vous accueille toute l’année, 7 jours sur 7, pour vous offrir le meilleur du sport, de la détente et des loisirs."
    ],
    "nl": [
      "In Bourg-de-Péage, in de Drôme, verwelkomt het DIABOLO aquacentrum van de Valence Romans Agglo stedelijke gemeenschap u het hele jaar door, 7 dagen per week, om u het allerbeste te bieden op het gebied van sport, ontspanning en vrije tijd."
    ],
    "es": [
      "En Bourg-de-Péage, en la Drôme, el centro acuático DIABOLO de la comunidad Valence Romans Agglo le da la bienvenida todo el año, 7 días a la semana, para ofrecerle lo mejor del deporte, la relajación y el ocio."
    ]
  },
