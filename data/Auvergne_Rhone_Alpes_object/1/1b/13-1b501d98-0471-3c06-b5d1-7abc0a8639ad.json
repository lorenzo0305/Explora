  "rdfs:comment": {
    "de": [
      "Seit 2019 ist die Mediathek von Collonges Mitglied des ReBOND-Netzwerks. Es ermöglicht Ihnen den Zugang zu 160.000 Dokumenten (Bücher, Zeitungen, Zeitschriften, CDs, DVDs, Lesegeräte, Spiele) mit einer einzigen Karte."
    ],
    "en": [
      "In 2019, the Collonges multimedia library joined the ReBOND network. It gives you access to 160,000 documents (books, newspapers, magazines, CDs, DVDs, e-readers, games) with a single card."
    ],
    "it": [
      "Nel 2019, la biblioteca multimediale di Collonges è entrata a far parte della rete ReBOND. Consente di accedere a 160.000 documenti (libri, giornali, riviste, CD, DVD, e-reader, giochi) con un'unica tessera."
    ],
    "fr": [
      "Depuis 2019, la médiathèque de Collonges a rejoint le réseau ReBOND. Il vous permet d’accéder à 160 000 documents (livres, journaux, magazines, CD, DVD, liseuses, jeux) avec une carte unique."
    ],
    "nl": [
      "In 2019 is de mediatheek van Collonges lid geworden van het ReBOND-netwerk. Hiermee heb je met één kaart toegang tot 160.000 documenten (boeken, kranten, tijdschriften, cd's, dvd's, e-readers, games)."
    ],
    "es": [
      "En 2019, la biblioteca multimedia Collonges se unió a la red ReBOND. Le da acceso a 160.000 documentos (libros, periódicos, revistas, CD, DVD, lectores electrónicos, juegos) con una sola tarjeta."
    ]
  },
