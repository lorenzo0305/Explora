  "rdfs:comment": {
    "de": [
      "In einem gemütlichen Rahmen unter einem Dachstuhl aus Pays empfangen Sie Odile und Chris den ganzen Tag über in einer freundlichen Atmosphäre."
    ],
    "en": [
      "Odile and Chris welcome you in a friendly atmosphere. We shall welcome you all day long."
    ],
    "it": [
      "Odile e Chris vi accolgono in un'atmosfera calda e amichevole, per tutto il giorno."
    ],
    "fr": [
      "Dans un cadre chaleureux, sous une charpente de Pays, Odile et Chris vous accueillent dans une ambiance conviviale, toute la journée."
    ],
    "nl": [
      "In een warm kader, onder een houten dakconstructie verwelkomen Odile en Chris U in een gezellige ambiance, gedurende de ganse dag."
    ],
    "es": [
      "En un entorno cálido, bajo un techo campestre, Odile y Chris le dan la bienvenida en un ambiente agradable, durante todo el día."
    ]
