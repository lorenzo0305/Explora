  "rdfs:comment": {
    "de": [
      "Das von der Communauté de Communes des Sablons und der Gemeinde restaurierte Schloss, dessen Fassade in das Inventaire Supplémentaire des Monuments Historiques (ISMH) eingetragen ist, stammt aus dem 16. Während des Zweiten Weltkriegs wurde es von den Deutschen und später von den Amerikanern besetzt, bevor es von den Franzosen übernommen wurde"
    ],
    "en": [
      "Restored by the Communauté de Communes des Sablons and the commune, the castle, whose facade is listed in the Supplementary Inventory of Historic Monuments (ISMH), dates from the 16th century. During the Second World War, it was occupied by the Germans, then by the Americans before it was taken over by the French"
    ],
    "it": [
      "Restaurato dalla Communauté de Communes des Sablons e dal comune, il castello, la cui facciata è elencata nell'Inventaire Supplémentaire des Monuments Historiques (ISMH), risale al XVI secolo. Durante la seconda guerra mondiale fu occupata dai tedeschi, poi dagli americani, prima di ricevere"
    ],
    "fr": [
      "Restauré par la Communauté de Communes des Sablons et la commune, le château, dont la façade est inscrite à l'Inventaire Supplémentaire des Monuments Historiques (ISMH), date du 16ème siècle. Pendant la Seconde Guerre mondiale, il est occupé par les Allemands, puis par les Américains avant d'accueil"
    ],
    "es": [
      "Restaurado por la Communauté de Communes des Sablons y el municipio, el castillo, cuya fachada está inscrita en el Inventaire Supplémentaire des Monuments Historiques (ISMH), data del siglo XVI. Durante la Segunda Guerra Mundial, fue ocupada por los alemanes, luego por los estadounidenses, antes de recibir"
    ],
    "nl": [
      "Het kasteel, waarvan de gevel is opgenomen in de Inventaire Supplémentaire des Monuments Historiques (ISMH), is gerestaureerd door de Communauté de Communes des Sablons en de gemeente en dateert uit de 16e eeuw. Tijdens de Tweede Wereldoorlog werd het bezet door de Duitsers, daarna door de Amerikanen, voordat het"
    ]
  },
