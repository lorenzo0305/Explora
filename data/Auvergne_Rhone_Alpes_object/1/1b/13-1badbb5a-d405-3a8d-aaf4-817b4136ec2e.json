  "rdfs:comment": {
    "de": [
      "Begleitung, Führung, Einführung und Verleih von Mountainbikes / E-FatBikes, Elektrische Geländeroller, Verleih/Verkauf von Schneeschuhen und Schlitten.\r\nEinführung in das Elektro-Motorrad für Kinder\r\nVerkauf von warmen/kalten Getränken, Verkauf von lokalen Produkten."
    ],
    "en": [
      "Accompaniment, Guiding, Initiation and Rental of VTTAE / E-FatBike, Electric All Terrain Scooters, rental/sale of snowshoes and sleds.\r\nElectric Motorbike initiation for children\r\nSale of hot/cold drinks, sale of local produce."
    ],
    "it": [
      "Accompagnamento, guida, iniziazione e noleggio di VTTAE / E-FatBike, scooter elettrici fuoristrada, noleggio/vendita di racchette da neve e slitte.\r\nIniziazione alla moto elettrica per bambini\r\nVendita di bevande calde/fredde, vendita di prodotti locali."
    ],
    "fr": [
      "Accompagnement, Guidage, Initiation et Location de VTTAE / E-FatBike, Trottinettes Tout-Terrain Electriques, location/vente de raquettes à neige et de luges.\r\nInitiation Moto Electrique Enfant\r\nVente de boissons chaudes/froides, vente de produits locaux."
    ],
    "nl": [
      "Begeleiding, begeleiding, initiatie en verhuur van VTTAE / E-FatBike, elektrische terreinfietsen, verhuur/verkoop van sneeuwschoenen en sleeën.\r\nInitiatie elektrische motorfiets voor kinderen\r\nVerkoop van warme/koude dranken, verkoop van lokale producten."
    ],
    "es": [
      "Acompañamiento, Guiado, Iniciación y Alquiler de VTTAE / E-FatBike, Scooters Eléctricos Todo Terreno, alquiler/venta de raquetas de nieve y trineos.\r\nIniciación a la moto eléctrica para niños\r\nVenta de bebidas calientes/frías, venta de productos locales."
    ]
  },
