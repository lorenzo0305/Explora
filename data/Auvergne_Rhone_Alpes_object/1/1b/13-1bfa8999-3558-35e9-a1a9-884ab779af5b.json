  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Restaurant im Herzen des Dorfes, in dem Authentizität und regionale Köstlichkeiten in einer herzlichen Atmosphäre aufeinandertreffen."
    ],
    "en": [
      "Discover this restaurant in the heart of the village, where authenticity and local flavors meet in a warm atmosphere."
    ],
    "it": [
      "Scoprite questo ristorante nel cuore del villaggio, dove autenticità e sapori locali si fondono in un'atmosfera accogliente."
    ],
    "fr": [
      "Découvrez ce restaurant au cœur du village où authenticité et saveurs du terroir se rencontrent dans une ambiance chaleureuse."
    ],
    "nl": [
      "Ontdek dit restaurant in het hart van het dorp, waar authenticiteit en lokale smaken samenkomen in een warme sfeer."
    ],
    "es": [
      "Descubra este restaurante en el corazón del pueblo, donde la autenticidad y los sabores locales se unen en un ambiente cálido."
    ]
  },
