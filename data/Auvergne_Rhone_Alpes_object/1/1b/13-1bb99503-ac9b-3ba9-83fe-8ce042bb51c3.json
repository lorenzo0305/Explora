  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Freuden des Gleitens! Lernen oder sich amüsieren ... Die Eislaufbahn der Agglomeration bietet zahlreiche Aktivitäten und Animationen, die Sie mit der Familie oder mit Freunden erleben können."
    ],
    "en": [
      "Discover all the joys of skating! Learn how to skate or just have fun. The district skating rink has a wide range of activities for you to experience with your family or friends."
    ],
    "it": [
      "Scoprite le gioie dello scivolamento! Imparare o divertirsi... La pista di pattinaggio urbano offre un'ampia gamma di attività e divertimenti da praticare in famiglia o con gli amici."
    ],
    "fr": [
      "Découvrez les joies de la glisse ! Apprendre ou s'amuser... La patinoire d'agglomération  propose de multiples activités et animations à vivre en famille ou entre amis."
    ],
    "es": [
      "¡Descubra las alegrías del deslizamiento! Aprender o divertirse... La pista de patinaje urbano ofrece un amplio abanico de actividades y entretenimientos para disfrutar en familia o con amigos."
    ],
    "nl": [
      "Ontdek het plezier van glijden! Leren of plezier maken... De stedelijke schaatsbaan biedt een breed scala aan activiteiten en entertainment om van te genieten met uw familie of vrienden."
    ]
  },
  "rdfs:label": {
