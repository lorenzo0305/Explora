  "rdfs:comment": {
    "de": [
      "Sahune liegt am westlichen Eingang der Eygues-Schlucht, die auch \"Gorges de Saint-May\" genannt wird."
    ],
    "en": [
      "Sahune is located at the western entrance of the Gorges of the Eygues, as known as \"Gorges of St May\"."
    ],
    "it": [
      "Sahune si trova all'ingresso occidentale delle gole di Eygues, note anche come \"gole di Saint-May\"."
    ],
    "fr": [
      "Sahune est situé à l'entrée occidentale des gorges de l'Eygues dites aussi « gorges de Saint-May »."
    ],
    "es": [
      "Sahune se encuentra en la entrada occidental de las gargantas de Eygues, también conocidas como las \"gargantas de Saint-May\"."
    ],
    "nl": [
      "Sahune bevindt zich aan het begin van de kloven van de rivier l'Eygues, ook genoemd \"gorges de Saint-May\".\r\nHet oude dorp, op de heuvel gelegen en verlaten in de XIXe eeuw, is in weder opbouw : oude steegjes, de oude kerk van de XVIIe eeuw en de ruines van het feodaal kasteel en een kapel van de XIIIe eeuw (privé eigendom)"
    ]
  },
