  "rdfs:comment": {
    "de": [
      "Eine Tour, die seit der Vorgeschichte die Art und Weise erforscht, wie Lebensmittel produziert und konsumiert werden, und dabei auch die Darstellung von Lebensmitteln in der Kunst behandelt."
    ],
    "en": [
      "A visit that explores the ways in which food has been produced and consumed since prehistoric times, and looks at the representation of food in art."
    ],
    "it": [
      "Una visita che esplora i modi in cui il cibo è stato prodotto e consumato fin dalla preistoria, esaminando anche la rappresentazione del cibo nell'arte."
    ],
    "fr": [
      "Une visite qui explore, depuis la Préhistoire, les façons de produire et de consommer de la nourriture, tout en abordant la représentation des aliments dans l’art."
    ],
    "es": [
      "Una visita que explora las formas de producción y consumo de alimentos desde la prehistoria, al tiempo que examina la representación de la comida en el arte."
    ],
    "nl": [
      "Een bezoek dat de manieren onderzoekt waarop voedsel sinds de prehistorie wordt geproduceerd en geconsumeerd, terwijl ook wordt gekeken naar de weergave van voedsel in de kunst."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite commentée : \"A table !\""
    ]
  },
