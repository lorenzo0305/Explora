  "rdfs:comment": {
    "de": [
      "Das 1863 gegründete Stadtmuseum wurde Anfang der 2000er Jahre nach der ersten Schenkung von Werken durch Paul und Muguette Dini an die Stadt Villefranche-sur-Saône wiederbelebt."
    ],
    "en": [
      "Founded in 1863, the municipal museum revived at the beginning of the 2000s thanks to the first work donation of Paul and Muguette Dini to the town of Villefranche-sur-Saône."
    ],
    "it": [
      "Fondato nel 1863, il museo è rinato all'inizio degli anni 2000 in seguito alla prima donazione di opere di Paul e Muguette Dini alla città di Villefranche-sur-Saône."
    ],
    "fr": [
      "Musée municipal fondé en 1863, le musée renait au début des années 2000 suite à la première donation d'œuvres faite par Paul et Muguette Dini à la Ville de Villefranche-sur-Saône."
    ],
    "nl": [
      "Opgericht in 1863, werd het museum in het begin van de jaren 2000 nieuw leven ingeblazen na de eerste schenking van werken van Paul en Muguette Dini aan de stad Villefranche-sur-Saône."
    ],
    "es": [
      "Fundado en 1863, el museo renació a principios de la década de 2000 tras la primera donación de obras de Paul y Muguette Dini a la ciudad de Villefranche-sur-Saône."
    ]
  },
