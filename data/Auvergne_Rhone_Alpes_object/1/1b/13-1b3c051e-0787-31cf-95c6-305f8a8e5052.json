  "rdfs:comment": {
    "de": [
      "Wenn Sie durch die gepflasterten Straßen des alten Städtchens Saint-Galmier laufen, werden Sie zu einer Shoppingpause eingeladen. Aber nicht irgendein Einkaufsbummel, sondern eine Version mit einzigartigen und lokalen Stücken."
    ],
    "en": [
      "As you stroll along the cobbled streets of Saint-Galmier?s old town, we invite you to stop off for a spot of shopping. But not just any shopping, but unique, local pieces."
    ],
    "it": [
      "Mentre passeggiate lungo le strade acciottolate del centro storico di Saint-Galmier, vi invitiamo a fare una sosta per lo shopping. Ma non uno shopping qualsiasi, bensì pezzi unici e locali."
    ],
    "fr": [
      "En arpentant les rues pavées du vieux bourg de Saint-Galmier, on vous invite à une halte shopping. Mais pas n’importe quel shopping, une version pièces uniques et locales."
    ],
    "nl": [
      "Terwijl je door de geplaveide straten van de oude stad Saint-Galmier slentert, nodigen we je uit om even te stoppen om te winkelen. Maar niet zomaar winkelen, maar unieke, lokale stukken."
    ],
    "es": [
      "Mientras pasea por las calles empedradas del casco antiguo de Saint-Galmier, le invitamos a hacer una parada para ir de compras. Pero no cualquier compra, sino piezas únicas y locales."
    ]
  },
  "rdfs:label": {
