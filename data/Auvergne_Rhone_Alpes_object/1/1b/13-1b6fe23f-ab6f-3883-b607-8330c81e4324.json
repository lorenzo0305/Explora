  "rdfs:comment": {
    "de": [
      "Ein Spaziergang von der Altstadt in die Ville-Gozet, um die kleinen Wassergeschichten zu entdecken, die die Stadt säumen.\r\nAb 10 Jahren."
    ],
    "en": [
      "A walk from the old town to the Ville-Gozet to discover the little water stories that dot the city.\r\nAges 10 and up."
    ],
    "it": [
      "Una passeggiata dalla città vecchia alla Ville-Gozet per scoprire le piccole storie d'acqua che punteggiano la città.\r\nPer bambini dai 10 anni in su."
    ],
    "fr": [
      "Une balade en partance de la vieille ville, à destination de la Ville-Gozet pour découvrir les petites histoires d'eau qui jalonnent la ville. \r\nÀ partir de 10 ans."
    ],
    "es": [
      "Un paseo desde el casco antiguo hasta la Ville-Gozet para descubrir las pequeñas historias de agua que salpican la ciudad.\r\nPara niños a partir de 10 años."
    ],
    "nl": [
      "Een wandeling van de oude stad naar de Ville-Gozet om de kleine waterverhalen te ontdekken die de stad rijk is.\r\nVoor kinderen vanaf 10 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Montluçon au fil de l'eau"
    ]
  },
