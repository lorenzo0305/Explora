  "rdfs:comment": {
    "de": [
      "Organisiert Workshops zur handwerklichen Erforschung von Keramik und Pflanzenfarben.\r\nDie meisten Materialien für die Kreation sind Gegenstand ständiger Forschung und werden überwiegend in der Natur gesammelt."
    ],
    "en": [
      "Organizes research workshops in ceramics and vegetable dyes.\r\nMost of the materials used in our creations are the result of constant research, with the majority harvested from nature."
    ],
    "it": [
      "Organizza laboratori di ricerca sulla ceramica e sulle tinture vegetali\r\nLa maggior parte dei materiali utilizzati nella creazione sono oggetto di una costante ricerca, per lo più raccolti in natura."
    ],
    "fr": [
      "Organise des ateliers de recherche artisanal de céramique et teintures végétales. \r\nLa plupart des matériaux de création sont l’objet d’une recherche constante majoritairement récoltés dans la nature."
    ],
    "es": [
      "Organiza talleres de investigación sobre cerámica y tintes vegetales\r\nLa mayoría de los materiales utilizados en la creación son objeto de constantes investigaciones, en su mayoría recogidos en la naturaleza."
    ],
    "nl": [
      "Organiseert onderzoeksworkshops in keramiek en plantaardige kleurstoffen.\r\nDe meeste materialen die in onze creaties worden gebruikt zijn het resultaat van voortdurend onderzoek, de meeste verzameld in de natuur."
    ]
  },
  "rdfs:label": {
