  "rdfs:comment": {
    "de": [
      "Ideal gelegen im Skigebiet Crêt-Béni, auf 1300m Höhe, bietet Le Crêt-Béni eine herzliche, lokale und maximal hausgemachte Küche in einem idyllischen Rahmen. Familiärer Empfang und Einfachheit für ein authentisches Bergerlebnis."
    ],
    "en": [
      "Ideally located on the Crêt-Béni ski area, at 1300m altitude, Le Crêt-Béni offers warm, local, homemade cuisine in an idyllic setting. Family welcome and simplicity for an authentic mountain experience."
    ],
    "it": [
      "Situato in posizione ideale nel comprensorio sciistico di Crêt-Béni, a 1300 m di altitudine, Le Crêt-Béni offre una cucina calda, locale e casalinga in un ambiente idilliaco. Accoglienza familiare e semplicità per un'autentica esperienza di montagna."
    ],
    "fr": [
      "Idéalement situé sur le domaine skiable du Crêt-Béni, à 1300m d’altitude, Le Crêt-Béni propose une cuisine chaleureuse, locale et au maximum faite maison dans un cadre idyllique. Accueil familial et simplicité pour une expérience montagnarde authentique."
    ],
    "nl": [
      "Le Crêt-Béni is ideaal gelegen in het skigebied Crêt-Béni, op 1300 m hoogte, en biedt een warme, lokale, huisgemaakte keuken in een idyllische omgeving. Een familiaal onthaal en eenvoud voor een authentieke bergervaring."
    ],
    "es": [
      "Idealmente situado en la estación de esquí de Crêt-Béni, a 1300 m de altitud, Le Crêt-Béni ofrece una cocina casera, cálida y local en un entorno idílico. Acogida familiar y sencillez para vivir una auténtica experiencia de montaña."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Crêt-Béni mountain restaurant"
    ],
    "fr": [
      "Restaurant d'altitude Le Crêt-Béni"
    ],
    "nl": [
      "Bergrestaurant Crêt-Béni"
    ]
  },
