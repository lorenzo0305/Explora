  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant. Lassen Sie sich von den Gerichten auf der Schiefertafel überraschen, die täglich aus saisonalen Produkten und nach den Inspirationen des Küchenchefs zubereitet werden."
    ],
    "en": [
      "Traditional restaurant, let yourself be surprised by the dishes on the slate, prepared daily according to seasonal produce and the chef?s inspiration."
    ],
    "it": [
      "Un ristorante tradizionale, lasciatevi sorprendere dai piatti proposti, preparati ogni giorno in base ai prodotti di stagione e all'ispirazione dello chef."
    ],
    "fr": [
      "Restaurant traditionnel, laissez vous surprendre par les plats à l’ardoise, élaborés chaque jour en fonction des produits de saison et de l’inspiration du chef."
    ],
    "es": [
      "Restaurante tradicional, déjese sorprender por los platos de la pizarra, preparados cada día según los productos de temporada y la inspiración del chef."
    ],
    "nl": [
      "Een traditioneel restaurant, laat je verrassen door de gerechten op de lei, elke dag bereid volgens seizoensproducten en de inspiratie van de chef."
    ]
  },
