  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/179fcb23-41fc-3d88-949d-0f990bb20ee3",
      "dc:description": {
        "de": [
          "Samstag, 15. Juni 2024\n\n- Automobil - Ausflug in das Land der Opalküste\nund Caddy-Freisetzungen, Start im Parc des\nPins, Kiosk Serge Gainsbourg, Ankunft in den\njardins du Phare, organisiert von der Association\nLe Touquet Automibiles de Collection."
        ],
        "en": [
          "Saturday, June 15, 2024\n\n- Automobile - Escapade en terres d'Opale\nand Caddy releases, departure from Parc des\nPins, Serge Gainsbourg kiosk, arrival at the\ngardens, organized by the Association\nLe Touquet Automibiles de Collection."
        ],
        "it": [
          "Sabato 15 giugno 2024\n\n- Automobile - Escapade en terres d'Opale\ne rilascio del Caddy, partenza dal Parc des\nPins, chiosco Serge Gainsbourg, arrivo ai giardini\ngiardini, organizzata dall'Associazione\nLe Touquet Automibiles de Collection."
        ],
        "fr": [
          "Samedi 15 juin 2024\n\n- Automobile - Escapade en terres d'Opale \net lâchés de Caddy, départ du Parc des \nPins, kiosque Serge Gainsbourg, arrivée aux \njardins du Phare, organisé par l'Association \nLe Touquet Automibiles de Collection."
        ],
        "nl": [
          "Zaterdag 15 juni 2024\n\n- Auto - Escapade en terres d'Opale\nen vrijlating van Caddy, vertrek uit Parc des\nPins, Serge Gainsbourg kiosk, aankomst bij de\ntuinen, georganiseerd door de Association\nLe Touquet Automibiles de Collection."
        ],
        "es": [
          "Sábado 15 de junio de 2024\n\n- Automóvil - Escapada en tierras de Ópalo\ny liberación de Caddy, salida del Parc des\nPins, quiosco Serge Gainsbourg, llegada a los\njardines, organizado por la Asociación\nLe Touquet Automibiles de Collection."
        ]
      },
