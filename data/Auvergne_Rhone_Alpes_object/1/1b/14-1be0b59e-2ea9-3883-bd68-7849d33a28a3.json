  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9f6c7627-5483-345e-a79b-8f2be30f303b",
      "dc:description": {
        "de": [
          "Verleih von Elektro- oder Muskelfahrrädern und Mountainbikes für die Stadt oder das Land, für Kinder und die Familie. Verleih von Rosalies und Gokarts für Kinder.\nVerkauf von Fahrradzubehör und Kleidung für die Familie."
        ],
        "en": [
          "Rental of electric or muscle bikes and mountain bikes for town or country, for children and families. Rosalia and go-kart rentals for children.\nSale of bike accessories and family clothing."
        ],
        "it": [
          "Noleggio di biciclette elettriche o muscolari e mountain bike per la città o la campagna, per bambini e famiglie. Noleggio di Rosalia e go-kart per bambini.\nVendita di accessori per biciclette e abbigliamento per famiglie."
        ],
        "fr": [
          "Location de vélos et VTT électriques ou musculaires pour la ville ou la campagne, pour les  enfants et la famille. Location de rosalies et de karts pour enfants.\nVente d'accessoires vélos et de vêtements pour la famille."
        ],
        "nl": [
          "Verhuur van elektrische fietsen, musclebikes en mountainbikes voor in de stad of op het platteland, voor kinderen en gezinnen. Verhuur van Rosalia en skelters voor kinderen.\nVerkoop van fietsaccessoires en gezinskleding."
        ],
        "es": [
          "Alquiler de bicicletas eléctricas o musculosas y bicicletas de montaña para ciudad o campo, para niños y familias. Alquiler de Rosalia y karts para niños.\nVenta de accesorios para bicicletas y ropa familiar."
        ]
      },
