  "rdfs:comment": {
    "de": [
      "Nadège und Frédéric heißen Sie in einfacher und freundlicher Atmosphäre willkommen, um Ihnen einen herzlichen Gourmetmoment zu bieten, den Sie mit anderen teilen können."
    ],
    "en": [
      "It is in simplicity and conviviality that Nadège and Frédéric welcome you in order to propose you a greedy and warm moment to share."
    ],
    "it": [
      "Nadège e Frédéric vi accolgono in modo semplice e amichevole per offrirvi un momento caldo e gastronomico da condividere."
    ],
    "fr": [
      "C’est dans la simplicité et la convivialité que Nadège et Frédéric vous accueillent afin de vous proposer un moment gourmand et chaleureux à partager."
    ],
    "es": [
      "Nadège y Frédéric le dan la bienvenida de forma sencilla y amistosa para ofrecerle un momento cálido y gourmet para compartir."
    ],
    "nl": [
      "Nadège en Frédéric ontvangen u op een eenvoudige en vriendelijke manier om u een warm en gastronomisch moment te bezorgen."
    ]
  },
