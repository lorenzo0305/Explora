  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Pflanzenfarben mit einer Vorführung, die von der Färberin, die den Garten angelegt hat, durchgeführt wird. Hunderte verschiedener Färbepflanzen, eine Sammlung alter Rosen und ein Gemüsegarten in Permakultur."
    ],
    "en": [
      "Come and discover plant colors with a demonstration by the dyer who created the garden. Hundreds of different dye plants, a collection of old roses and a permaculture vegetable garden."
    ],
    "it": [
      "Venite a scoprire i colori delle piante con una dimostrazione del tintore che ha creato il giardino. Centinaia di piante tintorie diverse, una collezione di rose antiche e un orto in permacultura."
    ],
    "fr": [
      "Venez découvrir les couleurs végétales avec une démonstration réalisée par la  teinturière qui a créé le jardin. Une centaines de plantes différentes tinctoriales, une collection de roses anciennes et un potager en permaculture."
    ],
    "es": [
      "Venga a descubrir los colores de las plantas con una demostración del tintorero que creó el jardín. Cientos de plantas tintóreas diferentes, una colección de rosas antiguas y un huerto de permacultura."
    ],
    "nl": [
      "Kom plantenkleuren ontdekken met een demonstratie van de verver die de tuin heeft aangelegd. Honderden verschillende verfplanten, een verzameling oude rozen en een permacultuur moestuin."
    ]
  },
