  "rdfs:comment": {
    "de": [
      "La Roulotte Enchantée (Der verzauberte Wagen) und sein Geschichtenkolporteur.\r\nErzählen, berichten, erzählen, lesen, vorstellen, träumen.\r\nFür Kleinkinder, ältere Kinder, Eltern und Großeltern.\r\n\r\nHier und anderswo sein."
    ],
    "en": [
      "La Roulotte Enchantée and its story peddler.\r\nStorytelling, telling, reading, imagining, dreaming.\r\nFor toddlers, older children, parents and grandparents.\r\n\r\nBeing Here and Elsewhere."
    ],
    "it": [
      "La Roulotte Enchantée e il suo venditore di storie.\r\nRaccontare, narrare, leggere, immaginare, sognare.\r\nPer bambini piccoli e grandi, genitori e nonni.\r\n\r\nEssere qui e altrove."
    ],
    "fr": [
      "La Roulotte Enchantée et son colporteur d'histoires.\r\nConter, raconter, dire, lire, imaginer, rêver.\r\nPour les tout-petits, les plus grands, les parents, les grands-parents.\r\n\r\nÊtre Ici et Ailleurs."
    ],
    "es": [
      "La Roulotte Enchantée y su vendedor ambulante de cuentos.\r\nContar, contar, leer, imaginar, soñar.\r\nPara niños pequeños, niños mayores, padres y abuelos.\r\n\r\nEstar aquí y en otra parte."
    ],
    "nl": [
      "La Roulotte Enchantée en haar verhalenverteller.\r\nVerhalen vertellen, voorlezen, fantaseren, dromen.\r\nVoor peuters, oudere kinderen, ouders en grootouders.\r\n\r\nHier en elders zijn."
    ]
  },
