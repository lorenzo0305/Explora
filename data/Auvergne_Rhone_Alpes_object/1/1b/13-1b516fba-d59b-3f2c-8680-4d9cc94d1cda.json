  "rdfs:comment": {
    "de": [
      "Die Université du vin in Suze-la-Rousse ist ein Berufsbildungszentrum, das den Berufen der Weinherstellung von der Rebe bis ins Glas gewidmet ist. Es bietet Weinkennern und Liebhabern das ganze Jahr über Weinproben, Workshops zu Speisen und Weinen, etc. an"
    ],
    "en": [
      "The Université du Vin (Wine University) was created in 1978 and is a professional training school devoted to professions connected to the world of wine and the grapevine, in the Château de Suze la Rousse."
    ],
    "it": [
      "Creata nel 1978, l'Université du Vin è un centro di formazione professionale dedicato alle professioni del vino e della vite, con sede presso lo Château de Suze-la-Rousse. Dalla sua creazione, ha accolto più di 60.000 studenti"
    ],
    "fr": [
      "Créée en 1978, l'Université du Vin est le centre de formation professionnelle dédié aux métiers du vin et de la vigne, basé au Château de Suze-la-Rousse. Depuis sa création elle a accueilli plus de 60 000 étudiants"
    ],
    "nl": [
      "De Wijnuniversiteit van SUZE-LA-ROUSSE is een vakopleiding voor alle wijnberoepen van de wijngaard tot het glas, waar het hele jaar liefhebbers en gepassioneerden welkom zijn voor een cursus wijnproeven, “wijn bij het \r\neten” enz"
    ],
    "es": [
      "Creada en 1978, la Université du Vin es un centro de formación profesional dedicado a los oficios del vino y la vid, con sede en el Château de Suze-la-Rousse. Desde su creación, ha acogido a más de 60.000 estudiantes"
    ]
  },
