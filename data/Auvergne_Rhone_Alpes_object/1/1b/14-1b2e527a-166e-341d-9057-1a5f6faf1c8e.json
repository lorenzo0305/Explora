      "dc:description": {
        "de": [
          "Anlässlich des Tages der Heiligen Barbara organisiert die städtische Mediathek Gérard Delsaux ein Autorentreffen rund um das Buch \"Le jour d'avant\" (Der Tag davor)."
        ],
        "en": [
          "To celebrate Saint Barbara's Day, the Médiathèque municipale Gérard Delsaux is organizing an authors' meeting around the book \"Le jour d'avant\"."
        ],
        "it": [
          "In occasione della festa di Santa Barbara, la Médiathèque municipale Gérard Delsaux organizza una conferenza d'autore basata sul libro \"Le jour d'avant\"."
        ],
        "fr": [
          "À l'occasion de la Sainte-Barbe, la Médiathèque municipale Gérard Delsaux organise une rencontre d'auteurs autour de l'ouvrage \" Le jour d'avant \"."
        ],
        "nl": [
          "Ter gelegenheid van de Dag van de Heilige Barbara organiseert de Gemeentelijke Mediatheek Gérard Delsaux een auteurslezing op basis van het boek \"Le jour d'avant\"."
        ],
        "es": [
          "Con motivo del Día de Santa Bárbara, la Mediateca municipal Gérard Delsaux organiza una conferencia de autor basada en el libro \"Le jour d'avant\"."
        ]
