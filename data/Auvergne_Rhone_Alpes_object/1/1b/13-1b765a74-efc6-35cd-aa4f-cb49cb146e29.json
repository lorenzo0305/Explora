  "rdfs:comment": {
    "de": [
      "Charlène und Agnès heißen Sie mit einer großzügigen Küche herzlich willkommen.\r\nEin schöner Weinkeller wird Sie auf eine Reise durch die Weinberge Frankreichs mitnehmen."
    ],
    "en": [
      "Charlène and Agnès offer a warm welcome and generous cuisine.\r\nA beautiful wine cellar will take you on a journey through the vineyards of France."
    ],
    "it": [
      "Charlène e Agnès offrono un'accoglienza calorosa e una cucina generosa.\r\nUna splendida cantina vi accompagnerà in un viaggio tra i vigneti della Francia."
    ],
    "fr": [
      "Charlène et Agnès vous accueillent en toute simplicité avec une cuisine généreuse.\r\nUne belle cave à vin, vous fera voyager dans les vignobles de France."
    ],
    "es": [
      "Charlène y Agnès le ofrecen una cálida bienvenida y una cocina generosa.\r\nUna hermosa bodega le hará viajar por los viñedos de Francia."
    ],
    "nl": [
      "Charlène en Agnès bieden een warm welkom en een royale keuken.\r\nEen prachtige wijnkelder neemt je mee op een reis door de wijngaarden van Frankrijk."
    ]
  },
