  "rdfs:comment": {
    "de": [
      "Weiß, grün, Spaß und Emotionen. Courchevel Aventure entführt Sie im Laufe der Jahreszeiten in außergewöhnliche Abenteuer für unvergessliche Erinnerungen."
    ],
    "en": [
      "White, green, fun and excitement. Courchevel Aventure takes you on unique adventures through the seasons for lasting memories."
    ],
    "it": [
      "Bianco, verde, divertimento ed eccitazione. Courchevel Aventure vi accompagna in avventure eccezionali attraverso le stagioni per creare ricordi indimenticabili."
    ],
    "fr": [
      "Du blanc, du vert, du fun et de l’émotion. Courchevel Aventure vous transporte au gré des saisons dans des aventures exceptionnelles pour des souvenirs inoubliables."
    ],
    "nl": [
      "Wit, groen, plezier en spanning. Courchevel Aventure neemt je mee op uitzonderlijke avonturen door de seizoenen heen om onvergetelijke herinneringen te creëren."
    ],
    "es": [
      "Blanco, verde, diversión y emoción. Courchevel Aventure te lleva en aventuras excepcionales a través de las estaciones para crear recuerdos inolvidables."
    ]
  },
