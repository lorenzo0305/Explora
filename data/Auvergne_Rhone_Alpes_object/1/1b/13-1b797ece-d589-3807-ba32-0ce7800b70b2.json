  "rdfs:comment": {
    "de": [
      "Eine musikalische Reise rund um ein Märchen. Dieses Kunstprojekt vereint Stimme, Musik, Märchen und Skulpturen.\r\nInspiriert vom Album \"Petite Femme\" von Sophie Caironi, bietet dieses Märchen der Gruppe die Gelegenheit, ein Repertoire an Liedern aus aller Welt zu singen.\r\nVon Vents du Vercors"
    ],
    "en": [
      "Musical journey around a tale. This artistic project brings together voice, music, storytelling and sculpture.\r\nInspired by Sophie Caironi's album \"Petite Femme\", this tale offers the group an opportunity to sing a repertoire of world songs.\r\nBy Vents du Vercors"
    ],
    "it": [
      "Un viaggio musicale intorno a un racconto. Questo progetto artistico unisce voce, musica, narrazione e scultura.\r\nIspirato all'album \"Petite Femme\" di Sophie Caironi, questo racconto offre al gruppo l'opportunità di cantare un repertorio di canzoni del mondo.\r\nDa Vents du Vercors"
    ],
    "fr": [
      "Voyage musical autour d'un conte. Ce projet artistique réunit voix, musique, conte et sculptures.\r\nInspiré de l'album \"Petite Femme\" de Sophie Caironi, ce conte offre au groupe, l'occasion de chanter un répertoire de chants du monde.\r\nPar Vents du Vercors"
    ],
    "es": [
      "Un viaje musical en torno a un cuento. Este proyecto artístico aúna voz, música, narración y escultura.\r\nInspirado en el álbum \"Petite Femme\" de Sophie Caironi, este cuento brinda al grupo la oportunidad de cantar un repertorio de canciones del mundo.\r\nPor Vents du Vercors"
    ],
    "nl": [
      "Een muzikale reis rond een verhaal. Dit artistieke project brengt zang, muziek, verhalen en beeldhouwkunst samen.\r\nGeïnspireerd door het album \"Petite Femme\" van Sophie Caironi, geeft dit verhaal de groep de kans om een repertoire van wereldliederen te zingen.\r\nDoor Vents du Vercors"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle \"Petite femme\""
    ]
  },
