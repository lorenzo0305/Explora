  "rdfs:comment": {
    "de": [
      "Die am Fuße der Pisten unterhalb der ESF gelegene Pizzeria-Snackbar bietet Ihnen warme und kalte Getränke, Waffeln, Desserts, Sandwiches, Hotdogs und Pizzen zum Mitnehmen oder vor Ort auf der Terrasse oder im Inneren (20 Plätze)."
    ],
    "en": [
      "Located at the foot of the slopes, under the ESF, the pizzeria-snack offers hot or cold drinks, waffles, desserts, sandwiches, hot-dogs and pizzas to take away or on site, on the terrace or inside (20 seats)."
    ],
    "it": [
      "Situata ai piedi delle piste, sotto la FSE, la pizzeria-snack bar offre bevande calde o fredde, cialde, dolci, panini, hot-dog e pizze da asporto o da gustare sul posto, in terrazza o all'interno (20 posti)."
    ],
    "fr": [
      "Située au pied des pistes, sous l'ESF, la pizzeria-snack vous propose boissons chaudes ou froides, gaufres, desserts, sandwichs, hot-dogs et pizzas à emporter ou sur place, sur la terrasse ou à l'intérieur (20 places)."
    ],
    "es": [
      "Situado a pie de pistas, bajo el ESF, la pizzería-snack-bar ofrece bebidas calientes o frías, gofres, postres, sándwiches, perritos calientes y pizzas para llevar o para comer in situ, en la terraza o en el interior (20 plazas)."
    ],
    "nl": [
      "Gelegen aan de voet van de hellingen, onder het ESF, biedt de pizzeria-snack warme of koude dranken, wafels, desserts, sandwiches, hotdogs en pizza's om mee te nemen of ter plaatse, op het terras of binnen (20 plaatsen)."
    ]
  },
