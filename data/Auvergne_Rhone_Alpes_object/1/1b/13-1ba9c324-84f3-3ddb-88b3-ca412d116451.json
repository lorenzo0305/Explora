  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Herzen der Stadt ein traditionelles Restaurant, in dem Sie eine großzügige Küche genießen können. Familienfeiern, jeden Sonntag ein Gourmet-Brunch und ein maßgeschneiderter Catering-Service für alle Ihre Veranstaltungen. Authentizität garantiert."
    ],
    "en": [
      "In the heart of the city, discover a traditional restaurant where you can enjoy generous cuisine. Family tea parties, gourmet brunches every Sunday and customized catering for all your events. Authenticity guaranteed."
    ],
    "it": [
      "Nel cuore della città, scoprite un ristorante tradizionale dove assaporare una cucina generosa. Tè in famiglia, brunch gourmet ogni domenica e un servizio di catering su misura per tutti i vostri eventi. Autenticità garantita."
    ],
    "fr": [
      "Au cœur de la ville, découvrez un restaurant traditionnel où savourer une cuisine généreuse. Goûters en famille, brunch gourmand chaque dimanche et service traiteur sur mesure pour tous vos événements. Authenticité garantie."
    ],
    "nl": [
      "Ontdek in het hart van de stad een traditioneel restaurant waar u kunt genieten van een royale keuken. Familietheekfeestjes, gastronomische brunches elke zondag en een catering op maat voor al uw evenementen. Authenticiteit gegarandeerd."
    ],
    "es": [
      "En pleno centro de la ciudad, descubra un restaurante tradicional donde saborear una cocina generosa. Meriendas familiares, almuerzos gastronómicos todos los domingos y un servicio de catering a medida para todos sus eventos. Autenticidad garantizada."
    ]
  },
