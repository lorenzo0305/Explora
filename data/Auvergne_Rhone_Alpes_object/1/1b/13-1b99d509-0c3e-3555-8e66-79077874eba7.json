    "de": [
      "Ein Bauernhof mit biologischem Gemüseanbau, der 20 km von Roanne entfernt liegt, bietet Ihnen biologisches Gemüse der Saison. Finden Sie die Produkte per Click & Collect auf www.nosproduitslocaux-copler.fr"
    ],
    "en": [
      "An organic market-gardening farm located 20 km from Roanne offers seasonal organic vegetables. Click & collect products at www.nosproduitslocaux-copler.fr"
    ],
    "it": [
      "Un'azienda agricola biologica situata a 20 km da Roanne offre verdure biologiche di stagione. Prodotti da ritirare su www.nosproduitslocaux-copler.fr"
    ],
    "fr": [
      "Une ferme en maraîchage biologique située à 20 km de Roanne vous propose des légumes bio de saison. Retrouvez les produits en click & collect sur www.nosproduitslocaux-copler.fr"
    ],
    "es": [
      "Una granja de horticultura ecológica situada a 20 km de Roanne le ofrece verduras ecológicas de temporada. Productos Click & collect en www.nosproduitslocaux-copler.fr"
    ],
    "nl": [
      "Een biologische tuinderij op 20 km van Roanne biedt seizoensgebonden biologische groenten. Klik & verzamel producten op www.nosproduitslocaux-copler.fr"
    ]
