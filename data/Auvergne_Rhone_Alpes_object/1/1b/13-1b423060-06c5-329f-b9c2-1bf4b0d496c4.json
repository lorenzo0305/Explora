  "rdfs:comment": {
    "de": [
      "Ein musikalischer Augenblick im Auditorium: Unsere jungen Musiker gehen auf die Bühne, um ihre Leidenschaft zu teilen! Ein 40-minütiger, bewegender Moment, in dem die Schüler der Musikschule ihre Talente offenbaren. Eintritt frei und kostenlos."
    ],
    "en": [
      "Un Instant Musical at the auditorium: our young musicians take to the stage to share their passion! A moving 40-minute performance in which music school students reveal their talents. Free admission."
    ],
    "it": [
      "Un momento musicale in auditorium: i nostri giovani musicisti salgono sul palco per condividere la loro passione! Un'emozionante performance di 40 minuti in cui gli studenti della scuola di musica rivelano il loro talento. Ingresso libero."
    ],
    "fr": [
      "Un Instant Musical à l'auditorium  : nos jeunes musiciens montent sur scène pour partager leur passion ! Un moment émouvant de 40 minutes où les élèves de l'école de musique révèlent leurs talents. Entrée libre et gratuite."
    ],
    "es": [
      "Un momento musical en el auditorio: ¡nuestros jóvenes músicos suben al escenario para compartir su pasión! Una emocionante actuación de 40 minutos en la que los alumnos de la escuela de música revelan su talento. Entrada gratuita."
    ],
    "nl": [
      "Een muzikaal moment in de aula: onze jonge muzikanten betreden het podium om hun passie te delen! Een ontroerende voorstelling van 40 minuten waarin leerlingen van de muziekschool hun talenten laten zien. Gratis toegang."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Instant musical"
    ]
  },
