  "rdfs:comment": {
    "de": [
      "Das Trio \"Generationen\", bestehend aus dem Funk-Urgestein Fred Wesley, dem großen Leonardo Corradi und dem französischen Schlagzeuger Tony Match, wird Sie am Samstag, den 14. März in der Grange à Musique in Stimmung bringen!"
    ],
    "en": [
      "Join us on Saturday, March 14 at the Grange à Musique to enjoy the \"generations\" trio formed by Funk stalwart Fred Wesley, accompanied by the great Leonardo Corradi and French drummer Tony Match!"
    ],
    "it": [
      "Sabato 14 marzo, alla Grange à Musique, ascoltate il trio \"generations\" formato dall'esponente del Funk Fred Wesley, accompagnato dal grande Leonardo Corradi e dal batterista francese Tony Match!"
    ],
    "fr": [
      "Rendez-vous samedi 14 mars à la Grange à Musique pour vous ambiancer avec le trio \"générations\" formé par le pilier du Funk : Fred Wesley accompagné du grand Leonardo Corradi et le batteur français Tony Match!"
    ],
    "es": [
      "Únase a nosotros el sábado 14 de marzo en el Grange à Musique para escuchar al trío \"generations\" formado por el incondicional del Funk Fred Wesley, acompañado por el gran Leonardo Corradi y el batería francés Tony Match"
    ],
    "nl": [
      "Kom op zaterdag 14 maart naar de Grange à Musique om het trio \"generations\" te horen, gevormd door Funk stalwart Fred Wesley, begeleid door de geweldige Leonardo Corradi en de Franse drummer Tony Match!"
    ]
  },
