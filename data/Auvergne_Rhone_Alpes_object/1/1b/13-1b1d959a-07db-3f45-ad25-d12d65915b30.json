  "rdfs:comment": {
    "de": [
      "Handgemachter Senf, der in Toulaud (Ardèche) mit dem Mühlstein hergestellt wird. Cornichons 100% aus der Ardèche und Cracker mit Senf.\r\nAuf dem Markt von Saint-Péray vertreten."
    ],
    "en": [
      "Handcrafted mustard, stoneground in Toulaud (Ardèche). 100% Ardèche pickles and mustard crackers.\r\nPresent at the Saint-Péray market."
    ],
    "it": [
      "Senape artigianale di pietra di Toulaud (Ardèche). Cetriolini 100% Ardèche e cracker alla senape.\r\nDisponibile al mercato di Saint-Péray."
    ],
    "fr": [
      "Moutarde artisanale fabriquée à la meule de pierre à Toulaud (Ardèche). Cornichons  100% ardéchois et crackers à la moutarde.\r\nPrésente au marché de Saint-Péray."
    ],
    "es": [
      "Mostaza artesanal elaborada a la piedra en Toulaud (Ardèche). Pepinillos y galletas de mostaza 100% Ardèche.\r\nDisponible en el mercado de Saint-Péray."
    ],
    "nl": [
      "Handgemaakte mosterd van steen in Toulaud (Ardèche). 100% augurken en mosterdcrackers uit de Ardèche.\r\nVerkrijgbaar op de markt van Saint-Péray."
    ]
  },
