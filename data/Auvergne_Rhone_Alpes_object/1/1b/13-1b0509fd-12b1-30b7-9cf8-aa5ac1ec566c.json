  "rdfs:comment": {
    "de": [
      "Der Standort der Chapellerie, Eigentum der Communauté de communes de Forez-Est, der sich in den Mauern der ehemaligen Fabrik \"Fléchet\" befindet, wurde saniert und 2013 eröffnet."
    ],
    "en": [
      "The Chapellerie site, owned by the Communauté de communes de Forez-Est, located within the walls of the former \"Fléchet\" factory, was renovated and opened in 2013."
    ],
    "it": [
      "Il sito della Chapellerie, di proprietà della Communauté de communes de Forez-Est e situato tra le mura dell'ex fabbrica Fléchet, è stato ristrutturato e inaugurato nel 2013."
    ],
    "fr": [
      "Le site de la Chapellerie, propriété de la Communauté de communes de Forez-Est, située dans les murs de l’ancienne usine « Fléchet » a fait l’objet d’une réhabilitation et a ouvert en 2013."
    ],
    "es": [
      "El recinto de la Chapellerie, propiedad de la Communauté de communes de Forez-Est y situado dentro de los muros de la antigua fábrica \"Fléchet\", fue renovado e inaugurado en 2013."
    ],
    "nl": [
      "De Chapellerie site, eigendom van de Communauté de communes de Forez-Est en gelegen binnen de muren van de voormalige Fléchet fabriek, werd gerenoveerd en geopend in 2013."
    ]
  },
