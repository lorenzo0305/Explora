  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/60e3f6e4-6924-3da2-a179-1fb8656138d7",
      "dc:description": {
        "de": [
          "Entdecken Sie in einem neuen szenografischen Rahmen die komplett erneuerte Sammlung von Kunstwerken. Tauchen Sie ein in 5000 Jahre Geschichte und Kunstgeschichte, begleitet von einem Museumsführer."
        ],
        "en": [
          "In a new scenographic setting, discover a completely renewed collection of works. A plunge into the heart of 5,000 years of history and art history, accompanied by a museum guide."
        ],
        "it": [
          "In un nuovo allestimento scenografico, scoprite una collezione di opere completamente rinnovata. Fate un tuffo nel cuore di 5.000 anni di storia e di storia dell'arte, accompagnati da una guida museale."
        ],
        "fr": [
          "Au sein d’un nouvel écrin scénographique, découvrez l’ensemble des oeuvres totalement renouvelé. Une plongée au cœur de 5000 ans d’Histoire et d’Histoire de l’art, accompagnée d’un guide-conférencier du musée."
        ],
        "nl": [
          "Ontdek in een nieuwe scenografische setting een volledig vernieuwde collectie werken. Duik onder begeleiding van een museumgids in het hart van 5000 jaar geschiedenis en kunstgeschiedenis."
        ],
        "es": [
          "En un nuevo marco escenográfico, descubra una colección de obras totalmente renovada. Sumérjase en el corazón de 5.000 años de historia y de historia del arte, acompañado por un guía del museo."
        ]
      },
