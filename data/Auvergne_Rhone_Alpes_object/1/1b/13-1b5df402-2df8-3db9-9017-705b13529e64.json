  "rdfs:comment": {
    "de": [
      "Sylvain BEAL stellt Ihnen seine verschiedenen Produkte vor, um das Angeln in Süßwasser zu entdecken oder wiederzuentdecken: vom Angeln auf Forellen bis zum Angeln auf den legendären Blackbass, ohne die berühmten Raubfische zu vergessen, an geschützten Standorten!!!"
    ],
    "en": [
      "Sylvain BEAL presents you his different products to discover or rediscover freshwater fishing : from trout fishing to the legendary black-bass fishing without forgetting the famous carnivores, on preserved sites !"
    ],
    "it": [
      "Sylvain BEAL vi presenta i suoi diversi prodotti per scoprire o riscoprire la pesca in acqua dolce: dalla pesca alla trota alla leggendaria pesca al black-bass, senza dimenticare le famose carnivore, su siti preservati!"
    ],
    "fr": [
      "Sylvain BEAL vous présente ses différents produits pour découvrir ou redécouvrir la pêche en eau douce : de la pêche à la truite à celle du légendaire black-bass sans oublier les fameux carnassiers, sur des sites préservés !!"
    ],
    "nl": [
      "Sylvain BEAL stelt u zijn verschillende producten voor om het zoetwatervissen te ontdekken of te herontdekken: van het vissen op forel tot het legendarische vissen op black-bass zonder de beroemde carnivoren te vergeten, op bewaard gebleven sites!"
    ],
    "es": [
      "Sylvain BEAL le presenta sus diferentes productos para descubrir o redescubrir la pesca en agua dulce: desde la pesca de la trucha hasta la legendaria pesca del black-bass sin olvidar los famosos carnívoros, ¡en sitios preservados!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Moniteur Guide de Pêche"
    ]
  },
