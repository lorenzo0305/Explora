      "@id": "https://data.datatourisme.fr/ce18b92f-1b01-38ab-ac6b-412bd43dcb0c",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 8:30 - 20:00 Uhr\nSonntag: 9:00 - 12:30 Uhr\n\nAbholung:\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 8:30am - 8pm\nSunday: 9am - 12:30pm\n\nPick-up :\nDuring store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al sabato: dalle 8.30 alle 20.00\nDomenica: dalle 9.00 alle 12.30\n\nRitiro :\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi : 8h30 - 20h\nLe dimanche : 9h - 12h30\n\nRetrait :\nAux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 8.30 - 20u\nZondag: 9u - 12u30\n\nAfhalen :\nTijdens openingstijden van de winkel\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado: de 8h30 a 20h00\nDomingo: 9.00 h - 12.30 h\n\nRecogida :\nDurante el horario de apertura de la tienda\n\n "
        ]
      },
