  "rdfs:comment": {
    "de": [
      "La Châtelleraie öffnet Ihnen die Türen seines Anwesens weit: seine Hotellerie, sein Restaurant, seine Ferienwohnungen sowie seinen schattigen Park und sein Freibad."
    ],
    "en": [
      "La Châtelleraie is a charming 16th-century château in Saint-Étienne-de-Maurs, in the Cantal region, on the borders of departments Aveyron and Lot."
    ],
    "it": [
      "La Châtelleraie vi apre le porte della sua tenuta: l'hotel, il ristorante e gli alloggi, oltre al parco ombreggiato e alla piscina all'aperto."
    ],
    "fr": [
      "La Châtelleraie vous ouvre grand les portes de son domaine : son hôtellerie, son restaurant, ses gîtes, ainsi que son parc ombragé et sa piscine extérieure."
    ],
    "es": [
      "La Châtelleraie le abre las puertas de su finca: su hotel, su restaurante y sus casas rurales, así como su parque sombreado y su piscina exterior."
    ],
    "nl": [
      "La Châtelleraie is een charmant 16e-eeuws kasteel in Saint-Étienne-de-Maurs, in de Cantal, op de grens van de departementen Aveyron en Lot."
    ]
  },
