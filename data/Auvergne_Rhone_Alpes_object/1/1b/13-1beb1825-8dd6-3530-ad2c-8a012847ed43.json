  "rdfs:comment": {
    "de": [
      "15 Minuten vom Stadtzentrum Lyons entfernt, bietet das Ermitage Hôtel Cuisine-à-manger in einem außergewöhnlichen Rahmen mit Panoramablick über die Stadt personalisierte Dienstleistungen während Ihrem Tourismus- oder Geschäftsaufenthalt an: Ein Ort, an dem man sein muss, um sich wohlzufühlen."
    ],
    "en": [
      "At 15 minutes away from the centre of Lyon, the Ermitage Hôtel Cuisine-à-manger offers a personalised service for tourist and business trips, with a panoramic view over the city: a place which makes you feel good just being there."
    ],
    "it": [
      "A 15 minuti dal centro di Lione, in una posizione d'eccezione sovrastante la città, l'Ermitage Hôtel Cuisine-à-manger offre prestazioni personalizzate per soggiorni di turismo o di lavoro: un luogo dove ritrovarsi per stare meglio."
    ],
    "fr": [
      "À 15 minutes du centre de Lyon, L'Ermitage Hôtel Cuisine-à-manger offre, dans un cadre d'exception en surplomb panoramique de la ville, des prestations personnalisées aux séjours de tourisme et d'affaires : un lieu \"où se retrouver pour mieux être\"."
    ],
    "nl": [
      "Op 15 minuten van het centrum van Lyon biedt L'Ermitage Hôtel Cuisine-à-manger, in een uitzonderlijke omgeving met uitzicht op de stad, gepersonaliseerde diensten voor toeristische en zakelijke verblijven: een plek \"waar u uzelf kunt vinden om beter te worden\"."
    ],
    "es": [
      "A 15 minutos del centro de Lyon, L'Ermitage Hôtel Cuisine-à-manger ofrece, en un marco excepcional con vistas panorámicas de la ciudad, servicios personalizados en estancias turísticas y de negocios, un lugar \"donde encontrarse para estar mejor\"."
    ]
  },
