  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Nicolas war einst der Sitz einer Prioratskur unter der Herrschaft der Benediktiner von Saint-Chaffre du Monastier sur Gazeille."
    ],
    "en": [
      "The church of Saint Nicolas was once the seat of a priory-cure under the Benedictines of Saint-Chaffre du Monastier sur Gazeille."
    ],
    "it": [
      "La chiesa di Saint Nicolas era un tempo sede di un priorato-cura sotto il dominio dei benedettini di Saint-Chaffre du Monastier sur Gazeille."
    ],
    "fr": [
      "L'église Saint Nicolas fut autrefois le siège d'un prieuré-cure sous la mouvance des bénédictins de Saint-Chaffre du Monastier sur Gazeille."
    ],
    "es": [
      "La iglesia de San Nicolás fue en su día la sede de un priorato-cura bajo la regla de los benedictinos de Saint-Chaffre du Monastier sur Gazeille."
