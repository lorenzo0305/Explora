  "rdfs:comment": {
    "de": [
      "Ana Langeheldt ist eine multidisziplinäre Künstlerin, die in Sevilla lebt und arbeitet. Ursprünglich bekannt unter dem Namen Lahe178, ist sie eine Pionierin der Wandmalerei im städtischen Raum in Spanien."
    ],
    "en": [
      "Ana Langeheldt is a multidisciplinary artist living and working in Seville. Originally known as Lahe178, she is one of Spain?s pioneers of urban mural painting."
    ],
    "it": [
      "Ana Langeheldt è un'artista multidisciplinare che vive e lavora a Siviglia. Originariamente conosciuta come Lahe178, è una delle pioniere spagnole della pittura murale urbana."
    ],
    "fr": [
      "Ana Langeheldt est une artiste multidisciplinaire vivant et travaillant à Séville. Connue initialement sous le nom de Lahe178, elle fait figure de pionnière en matière de peinture murale dans l’espace urbain en Espagne."
    ],
    "nl": [
      "Ana Langeheldt is een multidisciplinaire kunstenares die woont en werkt in Sevilla. Ze staat oorspronkelijk bekend als Lahe178 en is een van de Spaanse pioniers op het gebied van muurschilderingen in de stad."
    ],
    "es": [
      "Ana Langeheldt es una artista multidisciplinar que vive y trabaja en Sevilla. Originalmente conocida como Lahe178, es una de las pioneras españolas de la pintura mural urbana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Street art de Ana Langeheldt - Wall & Love"
    ]
  },
