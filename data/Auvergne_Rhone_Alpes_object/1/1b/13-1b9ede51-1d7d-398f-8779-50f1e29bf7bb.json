  "rdfs:comment": {
    "de": [
      "Wandern Sie frei, um unsere Weinberge und Olivenhaine zu entdecken: ein außergewöhnliches Terroir mit bemerkenswerten Landschaften. Auf dem Rückweg gibt es einen Aperitif mit den Produkten des Weinguts. Sportschuhe, Mütze und Wasser mitbringen."
    ],
    "en": [
      "Walk freely to discover our vineyard and our olive groves: exceptional land with remarkable landscapes. On the way back, a gourmet aperitif with the products of the domain. Bring sports shoes, cap and water."
    ],
    "it": [
      "Passeggiata libera alla scoperta dei nostri vigneti e oliveti: una terra eccezionale con paesaggi notevoli. Al ritorno, aperitivo gourmet con prodotti della tenuta. Portare scarpe sportive, cappellino e acqua."
    ],
    "fr": [
      "Randonnez librement à la découverte de notre vignoble et de nos oliveraies : terroir d’exception aux paysages remarquables. Au retour, apéritif gourmand avec les produits du domaine. Prévoir chaussures de sport, casquette et eau."
    ],
    "nl": [
      "Vrije wandeling om onze wijn- en olijfgaarden te ontdekken: een uitzonderlijk terrein met opmerkelijke landschappen. Op de terugweg een gastronomisch aperitief met producten van het landgoed. Breng sportschoenen, een pet en water mee."
    ],
    "es": [
      "Camine libremente para descubrir nuestros viñedos y olivares: una tierra excepcional con paisajes notables. A la vuelta, aperitivo gastronómico con productos de la finca. Llevar calzado deportivo, gorra y agua."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rando apéro chez l'unique vigneron indépendant  de nyons"
    ]
  },
