  "rdfs:comment": {
    "de": [
      "Handwerkliche Brauerei aus dem Beaujolais Pierres Dorées.\r\nBiere aus 100% reinem BIO-Malz, nicht gefiltert und mit feinstem Hopfen hergestellt.\r\nBesichtigungen, Verkostungen, Seminare/Abendveranstaltungen"
    ],
    "en": [
      "Craft Brewery from Beaujolais Pierres Dorées.\r\n100% pure malt Organic beers made from the finest hops. Barrel aged beers\r\nVisit us and taste our beers !"
    ],
    "it": [
      "Birrificio artigianale del Beaujolais Pierres Dorées.\r\nBirre al 100% di puro malto biologico, non filtrate e prodotte con i migliori luppoli.\r\nVisite, degustazioni, seminari/serate"
    ],
    "fr": [
      "Brasserie artisanale du Beaujolais Pierres Dorées.\r\nBières 100% purs malts BIO, non filtrées et élaborées avec les houblons les plus fins.\r\nVisites, Dégustations, Séminaire/Soirée"
    ],
    "es": [
      "Cervecería artesanal de Beaujolais Pierres Dorées.\r\n100% pura malta ecológica, sin filtrar y elaborada con el mejor lúpulo.\r\nVisitas, degustaciones, seminarios/noches"
    ],
    "nl": [
      "Ambachtelijke brouwerij uit Beaujolais Pierres Dorées.\r\n100% zuivere biologische mouten, ongefilterd en gebrouwen met de fijnste hop.\r\nRondleidingen, proeverijen, seminars/avonden"
    ]
  },
