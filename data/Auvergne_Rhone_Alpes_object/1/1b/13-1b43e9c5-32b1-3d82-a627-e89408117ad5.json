  "rdfs:comment": {
    "de": [
      "Die Internationale Skischule Morzin wurde 1999 gegründet. Unsere Schule hat sich ständig weiterentwickelt, um Ihnen einen hervorragenden Unterricht und einen immer persönlicheren Service zu bieten."
    ],
    "en": [
      "Established in Morzine since 1999, and now with more than 30 instructors, ESI Internationale ski school are proud to offer our clients excellent service, professionalism and high quality tuition."
    ],
    "it": [
      "La Scuola Internazionale di Sci di Morzin è stata fondata nel 1999. La nostra scuola si è costantemente evoluta per offrirvi un insegnamento eccellente e servizi sempre più personalizzati."
    ],
    "fr": [
      "Née en 1999, l’Ecole de Ski Internationale de Morzin. Notre École n’a cessé d’évoluer pour vous offrir un enseignement d’excellence et des services toujours plus personnalisés."
    ],
    "nl": [
      "Opgericht in 1999, is de internationale skischool van Morzine-Avoriaz. Onze school is voortdurend in ontwikkeling om u uitstekend onderwijs en steeds persoonlijkere diensten aan te bieden."
    ],
    "es": [
      "La Escuela Internacional de Esquí de Morzin se fundó en 1999. Nuestra escuela ha evolucionado constantemente para ofrecerte una enseñanza excelente y unos servicios cada vez más personalizados."
    ]
  },
  "rdfs:label": {
    "en": [
      "ESI Morzine « Ecole de ski international»"
    ],
