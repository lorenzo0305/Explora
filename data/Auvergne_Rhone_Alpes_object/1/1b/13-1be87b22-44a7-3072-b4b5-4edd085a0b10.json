  "rdfs:comment": {
    "de": [
      "Unser Gasthaus befindet sich in der Nähe des Dorfes Chabrillan, neben dem Fluss Drôme und dem Naturschutzgebiet Les Ramières. Entdecken Sie den einzigartigen und unvergesslichen Charakter dieses Landhauses, das mitten in der Natur liegt."
    ],
    "en": [
      "Our auberge is located near the village of Chabrillan, next to the Drôme River and the nature reserve „les  Ramières“.\r\nDiscover the unique and unforgettable character of this rural house located in the heart of nature."
    ],
    "it": [
      "Il nostro ostello si trova vicino al villaggio di Chabrillan, vicino al fiume Drôme e alla riserva naturale di Ramières. Scoprite il carattere unico e indimenticabile di questa casa di campagna situata nel cuore della natura."
    ],
    "fr": [
      "Notre auberge se trouve à proximité du village de Chabrillan, à côté de la rivière Drôme et de la réserve naturelle des Ramières. Découvrez le caractère unique et inoubliable de cette maison de campagne située au cœur de la nature."
    ],
    "nl": [
      "Onze herberg ligt vlakbij het dorp Chabrillan, naast de rivier de Drôme en het natuurreservaat Ramières. Ontdek het unieke en onvergetelijke karakter van dit landhuis midden in de natuur."
    ],
    "es": [
      "Nuestro albergue se encuentra cerca del pueblo de Chabrillan, junto al río Drôme y la reserva natural de Ramières. Descubra el carácter único e inolvidable de esta casa de campo situada en plena naturaleza."
    ]
  },
