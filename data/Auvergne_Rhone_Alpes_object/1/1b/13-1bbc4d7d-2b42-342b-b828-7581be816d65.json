  "rdfs:comment": {
    "de": [
      "Nachdem er mit ?FOCUS? in den schönsten Sälen Frankreichs ausverkauft war, präsentiert der Komiker mit 150 Millionen Views auf Youtube nun seine neue Show, ?RODÉO?"
    ],
    "en": [
      "Having sold out France's finest venues with FOCUS? the comedian with 150 million views on Youtube presents his new show, RODÉO?"
