  "rdfs:comment": {
    "de": [
      "Die Essigfabrik von Carvin, seit fast 200 Jahren eine Fabrik im Herzen der Stadt. 20 Millionen Flaschen werden hier jedes Jahr hergestellt. Exklusive Besichtigung!"
    ],
    "en": [
      "La vinaigrerie de Carvin, a factory in the heart of the town for almost 200 years. 20 million bottles are produced here every year. Take an exclusive tour!"
    ],
    "it": [
      "L'acetaia Carvin si trova nel cuore della città da quasi 200 anni. Ogni anno vengono prodotte 20 milioni di bottiglie. Fate un tour esclusivo!"
    ],
    "fr": [
      "La vinaigrerie de Carvin, une usine en cœur de ville depuis près de 200 ans. 20 millions de bouteilles sont produites ici tous les ans. Visite exclusive !"
    ],
    "es": [
      "La fábrica de vinagre Carvin lleva casi 200 años en el corazón de la ciudad. Aquí se producen 20 millones de botellas al año. Visítala en exclusiva"
    ],
    "nl": [
      "De azijnfabriek Carvin ligt al bijna 200 jaar in het hart van de stad. Hier worden jaarlijks 20 miljoen flessen geproduceerd. Neem een exclusieve rondleiding!"
