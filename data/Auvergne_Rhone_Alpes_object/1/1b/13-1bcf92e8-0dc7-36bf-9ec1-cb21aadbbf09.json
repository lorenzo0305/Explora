  "rdfs:comment": {
    "de": [
      "Crêpes und Galettes nach bretonischer Tradition, Salate, Eis, Tee, Kaffee, Schokolade... Essen zu jeder Tageszeit im Haus oder auf der Terrasse! Teesalon mit gemütlichem Interieur, ideal für eine Pause unter Freunden."
    ],
    "en": [
      "Sweet wheat flour crêpes, savoury buckweat crêpes, salads, ice cream, teas, coffees, chocolate - 7/7 days. all day long"
    ],
    "it": [
      "Pancake e galette tradizionali bretoni, insalate, gelati, tè, caffè, cioccolatini... ristorazione a qualsiasi ora del giorno all'interno o sulla terrazza! Una sala da tè dagli interni accoglienti, ideale per una pausa con le amiche."
    ],
    "fr": [
      "Crêpes et galettes de tradition bretonne, salades, glaces, thés, cafés, chocolats... restauration à toute heure de la journée à l'intérieur ou en terrasse ! Salon de thé à l'intérieur cosy, idéal pour faire une pause entre ami(e)s."
    ],
    "nl": [
      "Traditionele Bretonse pannenkoeken en galetten, salades, ijsjes, thee, koffie, chocolade... catering op elk moment van de dag binnen of op het terras! Een theesalon met een gezellig interieur, ideaal voor een pauze met vrienden."
    ],
    "es": [
      "Crêpes y galettes tradicionales bretonas, ensaladas, helados, tés, cafés, chocolates... ¡todo el día en el interior o en la terraza! Un salón de té con un interior acogedor, ideal para una pausa entre amigos."
    ]
  },
