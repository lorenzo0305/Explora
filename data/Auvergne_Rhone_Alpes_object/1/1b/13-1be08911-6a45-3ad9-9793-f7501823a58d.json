  "rdfs:comment": {
    "de": [
      "Bei Les Légumes de Laurent sind wir stolz darauf, Ihnen eine große Auswahl an frischem und qualitativ hochwertigem Obst und Gemüse von lokalen Erzeugern anbieten zu können!"
    ],
    "en": [
      "At Les Légumes de Laurent, we're proud to offer you a wide selection of fresh, quality fruits and vegetables from local growers!"
    ],
    "it": [
      "Da Les Légumes de Laurent siamo orgogliosi di offrirvi un'ampia selezione di frutta e verdura fresca e di qualità proveniente da produttori locali!"
    ],
    "fr": [
      "Chez Les Légumes de Laurent, nous sommes fiers de vous proposer une large sélection de fruits et légumes frais et de qualité, issus de producteurs locaux !"
    ],
    "es": [
      "En Les Légumes de Laurent, estamos orgullosos de ofrecerle una amplia selección de frutas y verduras frescas y de calidad procedentes de productores locales"
    ],
    "nl": [
      "Bij Les Légumes de Laurent zijn we er trots op dat we je een brede selectie verse, kwaliteitsvolle groenten en fruit van lokale producenten kunnen aanbieden!"
    ]
  },
