  "rdfs:comment": {
    "de": [
      "Abschlussabend der 17. Ausgabe des Festivals EIN Land EIN Film. Bekanntgabe der Preise und Vorführung einer Auswahl der preisgekrönten Filme. Verlosung von Geschenken, die dem Publikum angeboten werden. Ehrenwein, der von der Stadt Issoire und der Biscuiterie Landon angeboten wird."
    ],
    "en": [
      "Closing evening of the 17th edition of the UN Pays UN Film festival. Announcement of awards and screening of a selection of winning films. Public prize draw. Wine reception hosted by the town of Issoire and Biscuiterie Landon."
    ],
    "it": [
      "Serata di chiusura della 17ª edizione del festival cinematografico UN Pays UN. Annuncio dei premi e proiezione di una selezione dei film premiati. Estrazione pubblica dei premi. Ricevimento di vini da parte della città di Issoire e della Biscuiterie Landon."
    ],
    "fr": [
      "Soirée de clôture de la 17e édition du festival UN Pays UN Film. Annonce des prix et projection d'une sélection de films primés. Tirage au sort de cadeaux offerts au public. Vin d'honneur offert par la ville d'Issoire et la Biscuiterie Landon."
    ],
    "nl": [
      "Slotavond van de 17e editie van het UN Pays UN filmfestival. Bekendmaking van de prijzen en vertoning van een selectie bekroonde films. Publiekstrekking van de prijzen. Wijnreceptie georganiseerd door de stad Issoire en Biscuiterie Landon."
    ],
    "es": [
      "Noche de clausura de la 17ª edición del festival de cine UN Pays UN. Anuncio de los premios y proyección de una selección de películas premiadas. Sorteo de premios entre el público. Recepción con vino ofrecida por la ciudad de Issoire y Biscuiterie Landon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée de clôture - Festival UN Pays UN Film 2026"
    ]
  },
