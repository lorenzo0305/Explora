  "rdfs:comment": {
    "de": [
      "Coyotes Productions bietet Ihnen während der gesamten Saison 2025/2026 Zirkuskurse für Kinder an, die in eine Gruppe für 6/14-Jährige und eine für 3/5-Jährige aufgeteilt sind! Kommen Sie zahlreich!"
    ],
    "en": [
      "Coyotes Productions is offering circus workshops for children throughout the 2025/2026 season, divided into one group for 6/14 year-olds and one for 3/5 year-olds! Come one, come all!"
    ],
    "it": [
      "Coyotes Productions propone per tutta la stagione 2025/2026 corsi di circo per bambini, suddivisi in un gruppo per bambini di 6/14 anni e uno per bambini di 3/5 anni! Venite uno, venite tutti!"
    ],
    "fr": [
      "Coyotes Productions vous propose des stages de cirque pour enfants sur toute la saison 2025/2026 décomposés en un groupe pour les 6/14 ans et un pour les 3/5 ans ! Venez nombreux !"
    ],
    "es": [
      "Coyotes Productions ofrece cursos de circo para niños durante toda la temporada 2025/2026, ¡divididos en un grupo para niños de 6/14 años y otro para niños de 3/5 años! ¡Venid todos!"
    ],
    "nl": [
      "Coyotes Productions biedt het hele seizoen 2025/2026 circuslessen voor kinderen, verdeeld in een groep voor 6/14-jarigen en een voor 3/5-jarigen! Kom allemaal!"
    ]
  },
  "rdfs:label": {
