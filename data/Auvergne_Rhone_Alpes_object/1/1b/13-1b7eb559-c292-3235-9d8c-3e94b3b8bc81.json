  "rdfs:comment": {
    "de": [
      "Entdecken Sie diesen 3,5 Hektar großen Ort, an dem eine Vielzahl von Baum-, Blumen- und Pflanzenarten wächst und lebt.\r\nKommen Sie gut beschuht, der Besuch wird von Françoise Gouby geleitet."
    ],
    "en": [
      "Come and discover this 3.5-hectare site, home to a multitude of species of trees, flowers and plants.\r\nThe tour will be guided by Françoise Gouby."
    ],
    "it": [
      "Venite a scoprire questo sito di 3,5 ettari che ospita una moltitudine di specie di alberi, fiori e piante.\r\nLa visita sarà guidata da Françoise Gouby."
    ],
    "fr": [
      "Venez découvrir ce lieu de 3,5 hectares où poussent et vivent une multitude d'espèces d'arbres, de fleurs et de plantes.\r\nVenez bien chausser, la visite sera guidée par Françoise Gouby."
    ],
    "nl": [
      "Kom en ontdek deze site van 3,5 hectare, de thuisbasis van een veelheid aan soorten bomen, bloemen en planten.\r\nDe rondleiding wordt gegeven door Françoise Gouby."
    ],
    "es": [
      "Arboreto de 3,5 hectáreas con más de 400 esencias de árboles y arbustos floridos. Visita guiada previa solicitud."
    ]
  },
