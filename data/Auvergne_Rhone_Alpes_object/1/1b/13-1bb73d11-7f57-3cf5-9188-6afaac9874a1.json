  "rdfs:comment": {
    "de": [
      "James Burlion, ein leidenschaftlicher Holzdrechsler, hat vor kurzem sein Atelier in Béard-Geovressiat eröffnet, wo er einzigartige Stücke schnitzt, die traditionelles Know-how mit zeitgenössischer Kreativität verbinden."
    ],
    "en": [
      "James Burlion, a passionate woodturner, recently opened his workshop in Béard-Geovressiat, where he sculpts unique pieces combining traditional know-how and contemporary creativity."
    ],
    "it": [
      "James Burlion, appassionato tornitore, ha recentemente aperto il suo laboratorio a Béard-Geovressiat, dove scolpisce pezzi unici combinando abilità tradizionali e creatività contemporanea."
    ],
    "fr": [
      "James Burlion, tourneur sur bois passionné, a récemment ouvert son atelier à Béard-Geovressiat, où il sculpte des pièces uniques alliant savoir-faire traditionnel et créativité contemporaine."
    ],
    "nl": [
      "James Burlion, een gepassioneerd houtdraaier, opende onlangs zijn werkplaats in Béard-Geovressiat, waar hij unieke stukken beeldhouwt waarbij hij traditionele vaardigheden combineert met hedendaagse creativiteit."
    ],
    "es": [
      "James Burlion, apasionado tornero de la madera, ha abierto recientemente su taller en Béard-Geovressiat, donde esculpe piezas únicas que combinan las técnicas tradicionales con la creatividad contemporánea."
    ]
  },
