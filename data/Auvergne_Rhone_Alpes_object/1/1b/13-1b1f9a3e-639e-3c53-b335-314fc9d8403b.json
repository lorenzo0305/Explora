  "rdfs:comment": {
    "de": [
      "Dieser Zwischenstopp in der Nähe der Autobahnausfahrt \"Chimilin / Les Abrets - Walibi - Parc de Chartreuse\" wird Sie mit seiner großzügigen und familiären Küche begeistern."
    ],
    "en": [
      "A seducing step located a few steps from the higway gate \"Chimilin / Les Abrets - Walibi - Parc de Chartreuse\", ofering a generous and family cooking."
    ],
    "it": [
      "Questo scalo, vicino all'uscita autostradale \"Chimilin / Les Abrets - Walibi - Parc de Chartreuse\", vi sedurrà con la sua cucina generosa e familiare."
    ],
    "fr": [
      "Cette étape, à proximité de la sortie d'autoroute \"Chimilin / Les Abrets - Walibi - Parc de Chartreuse\", vous séduira par sa cuisine généreuse et familiale."
    ],
    "es": [
      "Esta parada, cerca de la salida de la autopista \"Chimilin / Les Abrets - Walibi - Parc de Chartreuse\", le seducirá con su cocina generosa y familiar."
    ],
    "nl": [
      "Deze stopplaats, dicht bij de snelwegafrit \"Chimilin / Les Abrets - Walibi - Parc de Chartreuse\", zal u verleiden met zijn royale en familiale keuken."
    ]
  },
