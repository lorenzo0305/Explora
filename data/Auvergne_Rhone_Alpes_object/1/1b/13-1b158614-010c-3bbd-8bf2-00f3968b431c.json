  "rdfs:comment": {
    "de": [
      "Der Kartenvorverkauf ist eröffnet! 20 Jahre - ist das nicht wunderbar? Kommen Sie und teilen Sie diesen intensiven Moment voller Emotionen mit uns. Wir haben für diesen Anlass 10 Werke ausgewählt, die unsere Geschichte geprägt haben."
    ],
    "en": [
      "Ticketing is now open! 20 years, isn't that wonderful? Come and share this emotional moment with us. For the occasion, we've chosen 10 works that have marked our history."
    ],
    "it": [
      "I biglietti sono ora disponibili! 20 anni, non è meraviglioso? Venite a condividere con noi questo momento di intensa emozione. Per l'occasione, abbiamo scelto 10 opere che hanno segnato la nostra storia."
    ],
    "fr": [
      "La billetterie est ouverte ! 20 ans, n'est-ce pas merveilleux ? Venez partager ce moment intense en émotions avec nous. Nous avons choisi pour l'occasion 10 œuvres qui ont marqué notre histoire."
    ],
    "es": [
      "¡Ya están disponibles las entradas! 20 años, ¿no es maravilloso? Venga a compartir con nosotros este momento de intensa emoción. Para la ocasión, hemos elegido 10 obras que han marcado nuestra historia."
    ],
    "nl": [
      "Tickets zijn nu verkrijgbaar! 20 jaar, is dat niet geweldig? Kom en deel dit moment van intense emotie met ons. Voor de gelegenheid hebben we 10 werken gekozen die onze geschiedenis hebben gemarkeerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival de comédies musicales 4ème Edition"
    ]
  },
