  "rdfs:comment": {
    "de": [
      "Ferngesteuerter Flug mit motorisierten Flugzeugen (Flugzeug, Hubschrauber)\r\nFunkgesteuerter Flug mit Segelflugzeugen\r\nDer Club verfügt über eine 120 m lange und 10 m breite befestigte Start- und Landebahn mit Rollbahn, Windsack, Schutzdach und Sicherheitsbarrieren."
    ],
    "en": [
      "Radio-controlled flight of motorized aircraft (airplanes, helicopters)\r\nRadio-controlled gliders\r\nThe club has a 120-meter-long, 10-meter-wide hard-surface runway with taxiway, windsock, shelter and safety barriers."
    ],
    "it": [
      "Volo radiocomandato di aeromobili a motore (aerei, elicotteri)\r\nAlianti radiocomandati\r\nIl club è dotato di una pista di decollo e atterraggio lunga 120 metri e larga 10 metri, con via di rullaggio, pontile, tettoia e barriere di sicurezza."
    ],
    "fr": [
      "Vol radiocommandé aéronefs motorisés (avion, hélicoptères)\r\nVol radiocommandé planeurs\r\nLe club est doté d’une piste en dur de 120 mètres de long sur 10 mètres de large avec taxiway, manche à air, abri et barrières de sécurité."
    ],
    "es": [
      "Vuelo radiocontrolado de aeronaves motorizadas (aviones, helicópteros)\r\nPlaneadores radiocontrolados\r\nEl club está equipado con una pista dura de 120 metros de largo y 10 metros de ancho con pista de rodaje, manga de viento, refugio y barreras de seguridad."
    ],
    "nl": [
      "Radiobestuurd vliegen met gemotoriseerde luchtvaartuigen (vliegtuigen, helikopters)\r\nRadiobestuurde zweefvliegtuigen\r\nDe club beschikt over een verharde start- en landingsbaan van 120 meter lang en 10 meter breed, met taxibaan, windzak, afdak en veiligheidshekken."
    ]
  },
