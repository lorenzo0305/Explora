  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/87cfe522-2660-3954-9bc3-81d0d2ddaac3",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Fächern werden Ihnen verschiedene Brotsorten angeboten.\n\n\nTage der Öffnung:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nSeveral types of bread are available in racks.\n\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nSono disponibili diversi tipi di pane in cassetta.\n\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposés plusieurs types de pains.\n\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nEr zijn verschillende soorten brood verkrijgbaar in rekken.\n\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nVarios tipos de pan disponibles en rejillas.\n\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
