  "rdfs:comment": {
    "de": [
      "Le Dégel Club, Le snack de L'Antigel, richtet sich an alle, die sich mit frischen, qualitativ hochwertigen Produkten für eine schnelle, leckere und großzügige Pause stärken möchten"
    ],
    "en": [
      "The Dégel Club, L'Antigel's snack bar, is for anyone who wants to enjoy a quick, tasty and generous break with fresh, high-quality products."
    ],
    "it": [
      "Il Dégel Club, lo snack bar dell'Antigel, è dedicato a tutti coloro che desiderano mangiare prodotti freschi e di qualità, per una pausa veloce, gustosa e abbondante."
    ],
    "fr": [
      "Le Dégel Club, Le snack de L'Antigel, s'adresse à tous ceux qui veulent se restaurer avec des produits frais, de qualité, pour une pause rapide, gourmande et généreuse"
    ],
    "es": [
      "Le Dégel Club, el snack bar de L'Antigel, es para todos aquellos que buscan una pausa rápida, sabrosa y generosa con productos frescos y de calidad"
    ],
    "nl": [
      "Le Dégel Club, de snackbar van L'Antigel, is voor iedereen die op zoek is naar een snelle, smakelijke en royale pauze met verse kwaliteitsproducten"
    ]
  },
