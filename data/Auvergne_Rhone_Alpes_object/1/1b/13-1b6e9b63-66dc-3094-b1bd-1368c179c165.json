  "rdfs:comment": {
    "de": [
      "Um Sie zufrieden zu stellen und Ihnen einen angenehmen Urlaub zu ermöglichen, empfangen Sie unsere Aufenthaltsberater(innen) mit Freundlichkeit und Wohlwollen, um Ihnen ein Maximum an persönlichen Informationen zu geben"
    ],
    "en": [
      "In order to satisfy you and make you spend pleasant vacations, our consultants welcome you with friendliness and kindness in order to give you a maximum of personalized information"
    ],
    "it": [
      "Per soddisfarvi e farvi trascorrere vacanze piacevoli, i nostri consulenti turistici vi accolgono con cordialità e gentilezza per darvi il massimo delle informazioni personalizzate"
    ],
    "fr": [
      "Pour vous satisfaire et vous faire passer d'agréables vacances, nos conseillers (ères) en séjour vous accueillent avec convivialité et bienveillance afin de vous donner un maximum d'informations personnalisées"
    ],
    "es": [
      "Para satisfacerle y hacerle pasar unas vacaciones agradables, nuestros asesores de vacaciones le reciben con simpatía y amabilidad para ofrecerle un máximo de información personalizada"
    ],
    "nl": [
      "Om u tevreden te stellen en u een aangename vakantie te bezorgen, verwelkomen onze vakantieadviseurs u met vriendelijkheid en vriendelijkheid om u een maximum aan gepersonaliseerde informatie te geven"
    ]
  },
