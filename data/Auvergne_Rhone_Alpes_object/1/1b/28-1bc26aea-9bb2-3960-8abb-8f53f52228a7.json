      "rdfs:comment": {
        "de": [
          "Auf der Ferme du Sequenteau können Sie Ihre Pflaumen, Quitten, Nüsse und Marmeladen kaufen!\nVerkauf auf dem Bauernhof montags bis freitags von 16 bis 19 Uhr, samstags von 9 bis 12 Uhr."
        ],
        "en": [
          "Buy your plums, quinces, walnuts and jams at the Ferme du Sequenteau!\nSales at the farm Monday to Friday, 4pm to 7pm, Saturday 9am to 12pm."
        ],
        "it": [
          "Acquistate le vostre prugne, mele cotogne, noci e marmellate alla Ferme du Sequenteau!\nVendita in fattoria dal lunedì al venerdì, dalle 16.00 alle 19.00, sabato dalle 9.00 alle 12.00."
        ],
        "fr": [
          "A la Ferme du Sequenteau, achetez vos prunes, coings, noix et confitures ! \nVente à la ferme du lundi au vendredi de 16h à 19h, le samedi de 9h à 12h."
        ],
        "nl": [
          "Koop uw pruimen, kweeperen, walnoten en jam bij de Ferme du Sequenteau!\nVerkoop op de boerderij van maandag tot vrijdag van 16 tot 19 uur, zaterdag van 9 tot 12 uur."
        ],
        "es": [
          "Compre ciruelas, membrillos, nueces y mermelada en la Ferme du Sequenteau\nVenta en la granja de lunes a viernes de 16:00 a 19:00 y los sábados de 9:00 a 12:00."
        ]
      },
