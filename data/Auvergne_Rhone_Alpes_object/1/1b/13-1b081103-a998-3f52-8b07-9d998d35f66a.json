  "rdfs:comment": {
    "de": [
      "Brasserie mit schattiger Terrasse und Seeblick. Traditionelle Küche mit abwechslungsreicher Speisekarte mit Fleisch, Fisch sowie Spezialitäten aus Savoyen und vom See."
    ],
    "en": [
      "Brasserie with shaded terrace and lake views. Traditional cuisine with meat, fish, Savoy specialities and lake dishes."
    ],
    "it": [
      "Brasserie con terrazza all'ombra e vista lago. Cucina tradizionale con un variegato menù a base di carne, pesce e specialità savoiarde e di lago."
    ],
    "fr": [
      "Brasserie avec terrasse ombragée et vue lac. Cuisine traditionnelle avec carte variée composée de viandes, poissons ainsi que des spécialités savoyardes et du lac."
    ],
    "zh": [
      "有树荫下的露台和可看到湖的法式餐厅。菜式丰富: 牛排、湖鱼、萨瓦特色奶酪餐应有尽有。"
    ],
    "nl": [
      "Brasserie met schaduwrijk terras en uitzicht op het meer. Traditionele keuken met een gevarieerd menu met vlees, vis en specialiteiten uit de Savoie en het meer."
    ],
    "es": [
      "Brasserie con terraza sombreada y vista al lago. Cocina tradicional con un menú variado que incluye carnes, pescados y especialidades saboyanas y lacustres."
    ]
  },
