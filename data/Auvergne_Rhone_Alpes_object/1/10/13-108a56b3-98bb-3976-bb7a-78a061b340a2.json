  "rdfs:comment": {
    "de": [
      "Er befindet sich unterhalb des Sessellifts von Le Fort in einem Bereich mit roten Pisten. Dieser Bereich wurde für die Einführung in den Boarder Cross mit Steilkurven konzipiert."
    ],
    "en": [
      "The boarder-cross is located under Fort chairlift in a red-runs area."
    ],
    "it": [
      "Si trova sotto la seggiovia Fort, in un'area di piste rosse. Quest'area è stata progettata come introduzione al Boarder Cross con curve a gomito."
    ],
    "fr": [
      "Il est situé sous le télésiège du Fort dans un secteur de pistes rouges. Cette zone a été étudiée pour l'initiation au Boarder Cross avec virages relevés."
    ],
    "es": [
      "Se encuentra bajo el telesilla Fort, en una zona de pistas rojas. Esta zona se ha diseñado como introducción al Boarder Cross con curvas peraltadas."
    ],
