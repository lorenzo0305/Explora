  "rdfs:comment": {
    "de": [
      "Le Comptoir 532 liegt an der Schnellstraße Valence Romans, Ausfahrt 5, in der Nähe von Rovaltain und dem Bahnhof Valence TGV. Es besteht aus einem Restaurant, Seminarräumen, einem Weinkeller mit Feinkostladen und einem Imbiss."
    ],
    "en": [
      "Located along the Valence Romans expressway, exit 5, close to Rovaltain and the Valence TGV train station, Le Comptoir 532 comprises a Restaurant, seminar rooms, a Wine Cellar with delicatessen and a Snack Bar."
    ],
    "it": [
      "Situato lungo la superstrada Valence Romans, uscita 5, vicino a Rovaltain e alla stazione TGV di Valence, Le Comptoir 532 comprende un ristorante, sale per seminari, una cantina con gastronomia e uno snack bar."
    ],
    "fr": [
      "Situé le long de la voie rapide Valence Romans, sortie 5, à proximité de Rovaltain et la gare Valence TGV, Le Comptoir 532 est composé d'un Restaurant, de salles de séminaire, d'une Cave à vin avec Epicerie fine et d'un Snack."
    ],
    "es": [
      "Situado en la autovía Valence Romans, salida 5, cerca de Rovaltain y de la estación de TGV de Valence, Le Comptoir 532 cuenta con un restaurante, salas para seminarios, una bodega con delicatessen y un snack bar."
    ],
    "nl": [
      "Le Comptoir 532 ligt langs de snelweg Valence Romans, afrit 5, dicht bij Rovaltain en het TGV-station van Valence en beschikt over een restaurant, vergaderzalen, een wijnkelder met delicatessen en een snackbar."
    ]
  },
