  "rdfs:comment": {
    "de": [
      "Entdecken Sie in zwei Spiel- und Kulturräumen die traditionellen Aktivitäten in den Bergen. Der Wintertourismus und die Landwirtschaft sind in einem wunderschönen traditionellen Haus vereint, das den Ski und den Reblochon in den Vordergrund stellt!"
    ],
    "en": [
      "Discover traditional mountain activities in two playful and cultural spaces. Winter tourism and agriculture come together in a beautiful traditional house showcasing skiing and reblochon cheese!"
    ],
    "it": [
      "Scoprite le attività tradizionali di montagna in due aree divertenti e culturali. Il turismo invernale e l'agricoltura sono riuniti in una magnifica casa tradizionale con sci e formaggio Reblochon!"
    ],
    "fr": [
      "Partez à la découverte des activités traditionnelles de la montagne dans deux espaces ludiques et culturels. Le tourisme d'hiver et l'agriculture sont réunis dans une magnifique maison traditionnelle mettant à l'honneur le ski et le reblochon !"
    ],
    "nl": [
      "Ontdek traditionele bergactiviteiten in twee leuke en culturele gebieden. Wintertoerisme en landbouw worden samengebracht in een prachtig traditioneel huis met skiën en Reblochon kaas!"
    ],
    "es": [
      "Descubra las actividades tradicionales de montaña en dos espacios lúdicos y culturales. El turismo de invierno y la agricultura se unen en una magnífica casa tradicional con esquí y queso Reblochon"
    ]
  },
  "rdfs:label": {
    "en": [
      "The \"Hameau\" of the Alps"
    ],
    "fr": [
      "Le Hameau des Alpes"
    ],
    "nl": [
      "Het gehucht van de Alpen"
    ]
  },
