  "rdfs:comment": {
    "de": [
      "Unsere Gastronomie: lokal, bio und großzügig!\nJeden Tag: Mittagsangebot und Zugang zum Pool, Abende bei Kerzenlicht, Live-Konzerte. Genießen Sie auf unseren Panoramaterrassen einen Cocktail bei Sonnenuntergang."
    ],
    "en": [
      "Our cuisine: local, organic, and generous!\nEvery day, lunch specials and pool access, candlelit evenings, and live concerts are available. Enjoy a sunset cocktail on our panoramic terraces."
    ],
    "it": [
      "La nostra cucina: locale, biologica e generosa!\nOgni giorno, pranzi speciali e accesso alla piscina, serate a lume di candela e concerti dal vivo. Godetevi un cocktail al tramonto sulle nostre terrazze panoramiche."
    ],
    "fr": [
      "Notre gastronomie : locale, bio, et généreuse ! \nTous les jours, formule déjeuner et accès piscine, soirées à la bougie, concerts live. Profitez de nos terrasses panoramiques pour un cocktail au coucher du soleil."
    ],
    "nl": [
      "Onze keuken: lokaal, biologisch en royaal!\nElke dag, lunchtijd specials en toegang tot het zwembad, avonden bij kaarslicht en live concerten. Profiteer van onze panoramische terrassen voor een cocktail bij zonsondergang."
    ],
    "es": [
      "Nuestra cocina: ¡local, ecológica y generosa!\nTodos los días, especiales a la hora del almuerzo y acceso a la piscina, veladas a la luz de las velas y conciertos en directo. Aproveche nuestras terrazas panorámicas para tomar un cóctel al atardecer."
    ]
  },
