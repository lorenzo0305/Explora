  "rdfs:comment": {
    "de": [
      "Teilen Sie die Leidenschaft der Züchter für ihren Beruf und entdecken Sie die Welt der Angora-und Kaschmirziegen, die Verarbeitung von Mohair- und Kaschmirfasern zu verschiedenen Endprodukten (Pullover, Schals...)"
    ],
    "en": [
      "The Amalthée farm is an angora and cashmere goat farm in the Beaujolais. From the hair of our goats, we produce mohair and cashmere fibres that we transform into different products (pullover, scarf…) and that we offer for direct sales."
    ],
    "it": [
      "La ferme d'Amalthée è un allevamento di capre d'angora e cashmere nella regione del Beaujolais. Dal pelo delle nostre capre produciamo fibre di mohair e cashmere che trasformiamo in vari prodotti (maglioni, sciarpe, ecc.) e vendiamo direttamente"
    ],
    "fr": [
      "La ferme d’Amalthée est un élevage de chèvres angora et cachemire en Beaujolais. A partir du poil de nos chèvres,nous produisons la fibre mohair et cachemire que nous transformons en différents produits(pull, écharpe..)et que nous vendons en vente directe"
    ],
    "nl": [
      "La ferme d'Amalthée is een Angora- en kasjmiergeitenboerderij in de Beaujolais. Uit het haar van onze geiten produceren we mohair en kasjmiervezel, die we verwerken tot verschillende producten (truien, sjaals, enz.) en rechtstreeks verkopen"
    ],
    "es": [
      "La ferme d'Amalthée es una granja de cabras de Angora y cachemira situada en la región de Beaujolais. A partir del pelo de nuestras cabras, producimos fibra de mohair y cachemira, que transformamos en diversos productos (jerseys, bufandas, etc.) y vendemos directamente"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme d'Amalthée"
    ]
  },
