  "rdfs:comment": {
    "de": [
      "Shen Yun: Eine einzigartige Reise in das alte China Lassen Sie sich in eine wunderbare und beruhigende Welt entführen. Eine Welt, in der man alle Sorgen des Alltags vergisst."
    ],
    "en": [
      "The Beauty of Divine Beings Dancing"
    ],
    "it": [
      "Shen Yun: un viaggio unico nel cuore dell'antica Cina Lasciatevi trasportare in un mondo meraviglioso e rilassante. Un mondo in cui dimenticare tutte le preoccupazioni quotidiane."
    ],
    "fr": [
      "Shen Yun : un voyage unique au cœur de la Chine antique Laissez-vous transporter dans un monde merveilleux et apaisant. Un monde où l’on oublie tous les tracas du quotidien."
    ],
    "es": [
      "Shen Yun: un viaje único al corazón de la antigua China Déjese transportar a un mundo maravilloso y relajante. Un mundo en el que podrá olvidar todas sus preocupaciones cotidianas."
    ],
    "nl": [
      "Shen Yun: een unieke reis naar het hart van het oude China Laat je meevoeren naar een wonderlijke, rustgevende wereld. Een wereld waarin je al je dagelijkse zorgen kunt vergeten."
    ]
  },
