  "rdfs:comment": {
    "de": [
      "Das gesamte Team erwartet Sie, um Ihnen seine traditionelle Küche, seine Pizzas und seine Spezialitäten vorzustellen. Tagesformel am Mittag in einer gepflegten modernen Dekoration."
    ],
    "en": [
      "The whole team is waiting for you to try the traditional cuisine, pizzas and specialities. Fixed price menu available at lunchtime.\r\nContemporary decor.\r\nLocated in the centre of Montalieu-Vercieu (2 min from the Vallée Bleue)"
    ],
    "it": [
      "L'intero team vi aspetta per farvi conoscere la sua cucina tradizionale, le sue pizze e le sue specialità. Menu giornalieri a pranzo in un ambiente elegante e contemporaneo."
    ],
    "fr": [
      "Toute l’équipe vous attend pour vous faire découvrir sa cuisine traditionnelle, ses pizzas et ses spécialités. Formule du jour à midi dans une déco contemporaine soignée."
    ],
    "es": [
      "Todo el equipo le espera para presentarle su cocina tradicional, sus pizzas y sus especialidades. Menús diarios al mediodía en un ambiente elegante y contemporáneo."
    ],
    "nl": [
      "Het hele team staat klaar om u kennis te laten maken met de traditionele keuken, pizza's en specialiteiten. Dagelijkse lunchmenu's in een stijlvolle, eigentijdse omgeving."
    ]
  },
  "rdfs:label": {
    "en": [
