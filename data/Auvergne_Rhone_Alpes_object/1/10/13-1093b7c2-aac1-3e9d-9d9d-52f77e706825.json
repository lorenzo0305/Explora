  "rdfs:comment": {
    "de": [
      "Cédric, ein Naturführer, bietet Ihnen die Möglichkeit, die schönsten Landschaften des Tals und die Geheimnisse der dort lebenden Tiere mit verschiedenen Themen zu entdecken: Trapperausflüge, Märchenwanderungen, ..."
    ],
    "en": [
      "Cédric, a naturalist guide, invites you to discover the valley's most beautiful landscapes and the secrets of its fauna through a variety of themes: trapper outings, storytelling walks, ..."
    ],
    "it": [
      "Cédric, guida naturalistica, vi invita a scoprire i paesaggi più belli della valle e i segreti della sua fauna selvatica attraverso una varietà di temi: uscite con i trapper, passeggiate guidate, ecc."
    ],
    "fr": [
      "Cédric, guide naturaliste, vous propose de découvrir les plus beaux paysages de la vallée et les secrets de la faune qui l'habite avec diverses thématiques : sorties trappeurs, balades contées, ..."
    ],
    "es": [
      "Cédric, guía naturalista, le invita a descubrir los paisajes más bellos del valle y los secretos de su fauna a través de temas variados: salidas con trampero, paseos guiados, etc."
    ],
    "nl": [
      "Cédric, een natuurgids, nodigt je uit om de mooiste landschappen van de vallei en de geheimen van haar fauna te ontdekken aan de hand van verschillende thema's: trapperuitstapjes, begeleide wandelingen, enz."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cédric Cordonnier - Mountain Leader"
    ],
    "fr": [
      "Cédric Cordonnier  - Accompagnateur en Moyenne Montagne"
    ],
    "nl": [
      "Cédric Cordonnier - Berggids"
    ]
  },
