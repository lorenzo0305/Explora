  "rdfs:comment": {
    "de": [
      "Das 3-Sterne-Hotel liegt 15 Minuten von Grenoble und 20 Minuten von Chambéry entfernt und bietet Ihnen 80 geräumige und komfortable Zimmer in einem zeitgenössischen und klimatisierten Rahmen.\r\nIdeal für Geschäfts- und Freizeitaufenthalte"
    ],
    "en": [
      "Domaine des Fontaines, a natural comfort...For a peaceful stay and enhanced well-being, our hotel invites you to enjoy its lovely setting, for a short weekend, business trip or family holiday."
    ],
    "it": [
      "Situato a 15 minuti da Grenoble e a 20 minuti da Chambéry, questo hotel a 3 stelle offre 80 camere spaziose e confortevoli in un ambiente contemporaneo e climatizzato.\r\nIdeale per soggiorni d'affari e di piacere"
    ],
    "fr": [
      "Situé à 15mn de Grenoble et 20mn de Chambéry l'établissement 3* vous propose 80 chambres spacieuses et confortables, le tout dans un cadre contemporain et climatisé.\r\nIdéal pour séjour d'affaire et loisirs"
    ],
    "es": [
      "Situado a 15 minutos de Grenoble y a 20 minutos de Chambéry, este hotel de 3 estrellas ofrece 80 habitaciones espaciosas y confortables en un ambiente contemporáneo y climatizado.\r\nIdeal para estancias de negocios y de ocio"
    ],
    "nl": [
      "Dit 3-sterrenhotel ligt op 15 minuten van Grenoble en 20 minuten van Chambéry en biedt 80 ruime, comfortabele kamers in een eigentijdse omgeving met airconditioning.\r\nIdeaal voor zaken- en vakantieverblijven"
    ]
  },
  "rdfs:label": {
