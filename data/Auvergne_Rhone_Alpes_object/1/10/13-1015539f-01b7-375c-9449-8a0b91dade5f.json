  "rdfs:comment": {
    "de": [
      "Das Team der Bergerie empfängt Sie jeden Tag herzlich in der Bar-Restaurant.\r\nFür Skifahrer über den Sessellift \"Plan du Moulin Express\" und die Piste \"Les Boulevards\" erreichbar. Zugang zu Fuß oder mit Schneeschuhen möglich (außerhalb des Skigebiets)."
    ],
    "en": [
      "The team at La Bergerie warmly welcomes you every day to the bar-restaurant.\r\nAccessible to skiers via the \"Plan du Moulin Express\" chairlift and the Boulevards piste. Access possible on foot or with snowshoes (outside the ski area)."
    ],
    "it": [
      "Il team de La Bergerie vi dà un caloroso benvenuto ogni giorno al bar-ristorante.\r\nAccessibile agli sciatori tramite la seggiovia \"Plan du Moulin Express\" e la pista Boulevards. Accesso possibile a piedi o con le racchette da neve (fuori dal comprensorio sciistico)."
    ],
    "fr": [
      "L’équipe de la Bergerie vous accueille chaleureusement tous les jours au bar-restaurant.\r\nAccessible aux skieurs par le télésiège \"Plan du Moulin Express\" et la piste des Boulevards. Accès possible à pied ou en raquettes (hors domaine skiable)."
    ],
    "nl": [
      "Het team van La Bergerie heet je elke dag hartelijk welkom in het bar-restaurant.\r\nToegankelijk voor skiërs via de stoeltjeslift \"Plan du Moulin Express\" en de Boulevards piste. Toegang mogelijk te voet of met sneeuwschoenen (buiten het skigebied)."
    ],
    "es": [
      "El equipo de La Bergerie le da la bienvenida todos los días en el bar-restaurante.\r\nAccesible a los esquiadores por el telesilla \"Plan du Moulin Express\" y la pista Boulevards. Acceso posible a pie o con raquetas (fuera del dominio esquiable)."
    ]
  },
