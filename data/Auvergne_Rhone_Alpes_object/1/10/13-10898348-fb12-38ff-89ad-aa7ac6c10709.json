  "rdfs:comment": {
    "de": [
      "Neu im Winter 2025-2026: Entdecken Sie den Boardercross von La Respose! Ein Parcours mit Whoops, dann eine Abfolge von Steilkurven und Sprüngen. Eine Fun-Zone, die Sie auf Skiern oder mit dem Snowboard testen können!"
    ],
    "en": [
      "New for winter 2025-2026: discover the La Respose boardercross! A course with whoops, followed by a series of banked turns and jumps. A fun zone to try out on skis or snowboard!"
    ],
    "it": [
      "Novità dell'inverno 2025-2026: scoprite il boardercross di La Respose! Un percorso con whoops seguito da una serie di curve e salti. Una zona divertente per provare gli sci o lo snowboard!"
    ],
    "fr": [
      "Nouveauté hiver 2025-2026 : découvrez le le boardercross de La Respose ! Un parcours avec des whoops puis un enchainement de virages relevés et de sauts. Une fun zone à tester en skis ou en snowboard.!"
    ],
    "es": [
      "Novedad para el invierno 2025-2026: ¡descubra el boardercross de La Respose! Un recorrido con baches seguido de una serie de curvas peraltadas y saltos. Una zona divertida para probar los esquís o el snowboard"
    ],
    "nl": [
      "Nieuw voor winter 2025-2026: ontdek de La Respose boardercross! Een parcours met whoops gevolgd door een reeks schuine bochten en sprongen. Een leuke zone om uit te proberen op ski's of snowboard!"
    ]
  },
