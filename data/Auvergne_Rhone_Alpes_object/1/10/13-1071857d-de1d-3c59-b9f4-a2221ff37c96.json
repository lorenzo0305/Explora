  "rdfs:comment": {
    "de": [
      "Das Touristeninformationsbüro von Crémieu befindet sich im Herzen der mittelalterlichen Stadt. Das Team zu Ihren Diensten berät Sie bei Ihrem Aufenthalt und gibt Ihnen alle praktischen Informationen, um die schöne Gegend der Balcons du Dauphiné zu entdecken."
    ],
    "en": [
      "The Crémieu Tourist Information Office is located in the heart of the medieval town. The team at your service will advise you on your stay and give you all the practical information you need to discover the beautiful Balcons du Dauphiné region."
    ],
    "it": [
      "L'Ufficio del Turismo di Crémieu si trova nel cuore della città medievale. Il team al vostro servizio vi consiglierà sul vostro soggiorno e vi darà tutte le informazioni pratiche necessarie per scoprire la splendida regione dei Balcons du Dauphiné."
    ],
    "fr": [
      "Le Bureau d'Information Touristique de Crémieu est situé au cœur de la cité médiévale. L'équipe à votre service vous conseille dans votre séjour et vous donne toutes les informations pratiques pour découvrir le beau territoire des Balcons du Dauphiné."
    ],
    "es": [
      "La Oficina de Turismo de Crémieu está situada en el corazón de la ciudad medieval. El equipo a su servicio le aconsejará sobre su estancia y le dará toda la información práctica necesaria para descubrir la hermosa región de los Balcons du Dauphiné."
    ],
    "nl": [
      "Het VVV-kantoor van Crémieu bevindt zich in het hart van de middeleeuwse stad. Het team dat tot uw dienst staat, adviseert u over uw verblijf en geeft u alle praktische informatie die u nodig hebt om de prachtige streek Balcons du Dauphiné te ontdekken."
    ]
  },
  "rdfs:label": {
