  "rdfs:comment": {
    "de": [
      "Lafeuillade-en-Vézie überrascht heute mit einer guten Ausstattung an Geschäften und einem weniger alten Erscheinungsbild als in den anderen Dörfern der Châtaigneraie."
    ],
    "en": [
      "Lafeuillade-en-Vézie is surprisingly well-equipped in terms of shops, and its appearance is less traditional than that of other villages in the Châtaigneraie."
    ],
    "it": [
      "Oggi Lafeuillade-en-Vézie è sorprendentemente ben fornita di negozi e non è antica come altri villaggi della Châtaigneraie."
    ],
    "fr": [
      "Lafeuillade-en-Vézie surprend aujourd'hui par son niveau d'équipement en commerces autant que par son aspect moins ancien que celui qu'on rencontre dans le cœur des autres villages de la Châtaigneraie."
    ],
    "nl": [
      "Lafeuillade-en-Vézie is verrassend goed uitgerust op het gebied van winkels en het uiterlijk is minder ouderwets dan dat van andere dorpen in de Châtaigneraie."
    ],
    "es": [
      "Hoy en día, Lafeuillade-en-Vézie está sorprendentemente bien dotado de comercios, y no es tan antiguo como otros pueblos de la región de Châtaigneraie."
    ]
  },
