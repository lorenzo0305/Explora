  "rdfs:comment": {
    "de": [
      "Begleiterin in den Bergen. Wanderungen zu Fuß und mit Schneeschuhen, Workshops und Entdeckungsspaziergänge: Heil- und Küchenpflanzen, Insekten, große Fauna, Wald, Fluss, Land Art, sensorische und spielerische Spaziergänge, mit Esel, Einführung in die Goldwäscherei?"
    ],
    "en": [
      "Mountain guide. Hiking and snowshoe trails, workshops and introductory walks, walks with donkeys, initiation to panning for gold, etc."
    ],
    "it": [
      "Guida alpina. Escursioni a piedi e con le racchette da neve, laboratori e passeggiate alla scoperta di piante medicinali e culinarie, insetti, grande fauna, foresta, fiume, land art, passeggiate sensoriali e ludiche, con un asino, introduzione alla ricerca dell'oro?"
    ],
    "fr": [
      "Accompagnatrice en montagne. Randonnées pédestres et raquettes, ateliers et balades de découverte : plantes médicinales et culinaires, insectes, grande faune, forêt, rivière, land art, balade sensorielle et ludique, avec âne, initiation à l’orpaillage …"
    ],
    "es": [
      "Guía de montaña. Senderismo y raquetas de nieve, talleres y paseos de descubrimiento: plantas medicinales y culinarias, insectos, gran fauna, bosque, río, land art, paseos sensoriales y lúdicos, con burro, iniciación al lavado de oro.."
    ],
    "nl": [
      "Berggids. Wandelingen met sneeuwschoenen om de natuur te ontdekken (sporen van dieren...).\r\nWandelingen te voet om de natuur te ontdekken (fauna, bos, ezels, medicinale en aromatische planten...).\r\nMilieu-onderwijs."
    ]
  },
