  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a53dc1ae-52c2-35ec-895b-f9b6b7a53148",
      "dc:description": {
        "de": [
          "BÜROZEITEN:\nVON 8 BIS 12 UHR UND VON 13.30 BIS 18 UHR\nMalerei innen und außen\nTapeten, Dekoration\nThermische Isolierung von außen\nVerlegen aller elastischen Boden- und Wandbeläge"
        ],
        "en": [
          "OFFICE HOURS :\n8AM TO 12PM AND 1:30PM TO 6PM\nInterior and exterior painting\nWallpaper, decoration\nExternal thermal insulation\nInstallation of all types of flexible floor and wall coverings"
        ],
        "it": [
          "ORARIO D'UFFICIO :\nDALLE 8.00 ALLE 12.00 E DALLE 13.30 ALLE 18.00\nPittura di interni ed esterni\nCarta da parati, decorazione\nIsolamento termico esterno\nInstallazione di tutti i tipi di pavimenti e rivestimenti flessibili"
        ],
        "fr": [
          "HORAIRES  BUREAU :\nDE 8H À 12H ET DE 13H30 À 18H\nPeinture intérieure et extérieure\nPapier peint, décoration\nIsolation Thermique par l’Extérieur\nPose tous revêtements de sols souples et muraux"
        ],
        "nl": [
          "KANTOORUREN :\n8U TOT 12U EN 13U30 TOT 18U\nSchilderen binnen en buiten\nBehang, decoratie\nExterne thermische isolatie\nInstallatie van alle soorten flexibele vloer- en wandbekleding"
        ],
        "es": [
          "HORARIO DE OFICINA :\nDE 8H A 12H Y DE 13H30 A 18H\nPintura interior y exterior\nPapel pintado, decoración\nAislamiento térmico exterior\nInstalación de todo tipo de revestimientos flexibles para suelos y paredes"
        ]
      },
      "@type": [
        "Description"
