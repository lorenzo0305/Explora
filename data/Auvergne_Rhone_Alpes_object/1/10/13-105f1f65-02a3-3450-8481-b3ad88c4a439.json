  "rdfs:comment": {
    "de": [
      "Sommer wie Winter, für einen beruflichen Zwischenstopp, einen Ausflug oder einen längeren Aufenthalt, steigen Sie im Bel Horizon ab.  Seine komfortablen Zimmer öffnen sich zum Tal der Cère und zu den Gipfeln des Cantaliens."
    ],
    "en": [
      "Summer or winter, for a business stopover, a getaway or a long stay, come and stay at Le Bel Horizon.  Its comfortable rooms overlook the Cère valley and the Cantalien peaks."
    ],
    "it": [
      "In estate o in inverno, per una sosta professionale, una fuga o un lungo soggiorno, venite al Bel Horizon.  Le sue confortevoli camere si aprono sulla valle del Cère e sulle cime del Cantalien."
    ],
    "fr": [
      "Eté comme hiver, pour une étape professionnelle, une escapade ou un long séjour, descendez au Bel Horizon.  Ses chambres confortables s’ouvrent sur la vallée de la Cère et sur les sommets cantaliens."
    ],
    "nl": [
      "Zomer of winter, voor een professionele tussenstop, een escapade of een lang verblijf, kom naar de Bel Horizon.  De comfortabele kamers kijken uit op de vallei van de Cère en de bergtoppen van de Cantal."
    ],
    "es": [
      "Verano o invierno, para una escala de negocios, una escapada o una larga estancia, venga al Bel Horizon.  Sus cómodas habitaciones tienen vistas al valle del Cère y a las cumbres cantábricas."
    ]
  },
