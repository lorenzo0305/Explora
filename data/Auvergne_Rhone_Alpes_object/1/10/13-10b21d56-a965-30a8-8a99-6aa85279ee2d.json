  "rdfs:comment": {
    "de": [
      "L'ALTIPLANO: \r\n-Restaurant, Eisdiele\r\n-Rezepte und Aromen Südamerikas\r\n-Eis und italienisches Sorbet im Sommer sowie Desserts, alles hausgemacht\r\nVor Ort  (und auf Vorbestellung zum Mitnehmen)"
    ],
    "en": [
      "L'ALTIPLANO: \r\n-Restaurant, Ice Cream Parlor\r\n-Recipes and flavors of South America\r\n-Ice cream and Italian sorbet in summer, and desserts, all homemade\r\nOn site (and takeaway with advance order)"
    ],
    "it": [
      "L'ALTIPLANO :\r\n-Ristorante, Gelateria\r\n-Ricette e sapori sudamericani\r\n-Gelati e sorbetti all'italiana in estate e dessert fatti in casa\r\nIn loco (e da asporto su ordinazione)"
    ],
    "fr": [
      "L'ALTIPLANO : \r\n-Restaurant, Glacier\r\n-Recettes et saveurs d'Amerique du Sud\r\n-Glaces et Sorbet à l'italienne en été , et dessert, le tout fait maison\r\nSur place  ( et à emporter sur commande préalable)"
    ],
    "nl": [
      "L'ALTIPLANO: \r\n-Restaurant, ijssalon\r\n-Recepten en smaken uit Zuid-Amerika\r\n-IJs en Italiaanse sorbet in de zomer , en desserts, allemaal huisgemaakt\r\nTer plaatse  ( en afhalen op voorafgaande bestelling)"
    ],
    "es": [
      "L'ALTIPLANO :\r\n-Restaurante, Heladería\r\n-Recetas y sabores sudamericanos\r\n-Helados y sorbetes a la italiana en verano, y postres caseros\r\nEn el establecimiento (y para llevar por encargo)"
    ]
  },
