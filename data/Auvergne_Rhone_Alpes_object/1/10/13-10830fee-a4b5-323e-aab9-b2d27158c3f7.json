  "rdfs:comment": {
    "de": [
      "Bistronomisches Restaurant am Fuße des Plateaus von Gergovie, nur wenige Schritte von der Grande Halle und dem Zénith d'Auvergne entfernt. Schmackhafte saisonale Küche in einem freundlichen und modernen Rahmen."
    ],
    "en": [
      "Bistronomic restaurant at the foot of the Plateau de Gergovie, a stone's throw from the Grande Halle and the Zénith d'Auvergne. Tasty seasonal cuisine in a friendly, modern setting."
    ],
    "it": [
      "Ristorante bistronomico ai piedi del Plateau de Gergovie, a due passi dalla Grande Halle e dallo Zénith d'Auvergne. Gustosa cucina di stagione in un ambiente accogliente e moderno."
    ],
    "fr": [
      "Restaurant bistronomique au pied du Plateau de Gergovie, à deux pas de la Grande Halle et du Zénith d’Auvergne. Cuisine de saison savoureuse dans un cadre convivial et moderne."
    ],
    "es": [
      "Restaurante bistronómico al pie del Plateau de Gergovie, a dos pasos de la Grande Halle y del Zénith d'Auvergne. Sabrosa cocina de temporada en un ambiente acogedor y moderno."
    ],
    "nl": [
      "Bistronomisch restaurant aan de voet van het Plateau de Gergovie, op een steenworp afstand van de Grande Halle en de Zénith d'Auvergne. Smakelijke seizoensgerechten in een vriendelijke, moderne omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Gergovie"
    ]
  },
