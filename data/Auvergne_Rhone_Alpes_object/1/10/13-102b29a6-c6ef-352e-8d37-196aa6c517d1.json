  "rdfs:comment": {
    "de": [
      "Die Kirche von Crest-Voland, die Mariä Geburt geweiht ist, wurde zwischen 1863 und 1866 anstelle des Vorgängerbaus aus dem 16. Jahrhundert errichtet."
    ],
    "en": [
      "The church of Crest-Voland, which is dedicated to the Nativity of Our Lady, was built between 1863 and 1866 on the site of the old 16th century church."
    ],
    "it": [
      "La chiesa di Crest-Voland, dedicata alla Natività di Nostra Signora, fu costruita tra il 1863 e il 1866 sul sito dell'antico edificio del XVI secolo."
    ],
    "fr": [
      "L'église de Crest-Voland, dédiée à la Nativité de Notre-Dame, a été construite entre 1863 et 1866 à l'emplacement de l'ancien édifice du 16ème siècle."
    ],
    "es": [
      "La iglesia de Crest-Voland, dedicada a la Natividad de Nuestra Señora, se construyó entre 1863 y 1866 en el emplazamiento del antiguo edificio del siglo XVI."
    ],
    "nl": [
      "De kerk van Crest-Voland, gewijd aan de Geboorte van Onze Lieve Vrouw, werd gebouwd tussen 1863 en 1866 op de plaats van het oude gebouw uit de 16e eeuw."
    ]
  },
