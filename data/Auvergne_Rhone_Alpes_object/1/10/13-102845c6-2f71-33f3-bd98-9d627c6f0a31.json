  "rdfs:comment": {
    "de": [
      "Élodie Lepoutre, die sich für Pflanzen und Pflanzengeschichten begeistert, ist diplomierte Naturanimateurin und hat sich auf Wildpflanzen spezialisiert. Sie vermittelt und teilt ihr Wissen im Rahmen von botanischen Ausflügen, Workshops oder Praktika."
    ],
    "en": [
      "Passionate about plants and plant history, Élodie Lepoutre is a qualified nature guide specialising in wild plants. She shares her knowledge during botanical excursions, workshops and courses."
    ],
    "it": [
      "Appassionata di piante e storie di piante, Élodie Lepoutre è un'istruttrice naturalistica qualificata, specializzata in piante selvatiche. Condivide le sue conoscenze attraverso uscite botaniche, workshop e corsi."
    ],
    "fr": [
      "Passionnée de plantes et d'histoires de plantes, Élodie Lepoutre est une animatrice nature diplômée, spécialisée dans le domaine des plantes sauvages. Elle transmet et partage ses connaissances à l'occasion de sorties botaniques, d'ateliers ou de stages."
    ],
    "nl": [
      "Élodie Lepoutre, gepassioneerd door planten en plantenverhalen, is een gediplomeerd natuurinstructeur gespecialiseerd in wilde planten. Ze deelt haar kennis via botanische uitstapjes, workshops en cursussen."
    ],
    "es": [
      "Apasionada de las plantas y sus historias, Élodie Lepoutre es monitora de naturaleza especializada en plantas silvestres. Comparte sus conocimientos a través de salidas botánicas, talleres y cursos."
    ]
  },
