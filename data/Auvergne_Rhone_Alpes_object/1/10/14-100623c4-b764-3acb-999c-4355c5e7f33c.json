  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6eb19cdb-56f1-3ea3-9f3d-72eccac390d3",
      "dc:description": {
        "de": [
          "Entdeckung des regionalen Erbes (Route du patois) von Houdain und Umgebung durch Kutschfahrten, die mit Zugpferden bespannt sind: trait du nord, boulonnais, ardennais<br>Pädagogische Animation über den Umgang mit Pferden und Eseln"
        ],
        "en": [
          "Discover the regional heritage (patois route) of Houdain and the surrounding area on horse-drawn carriage rides with draught horses: northern draught, Boulonnais, Ardennes<br>Educational activities on the approach to horses and donkeys"
        ],
        "it": [
          "Scoprite il patrimonio regionale (percorso patois) di Houdain e dintorni con passeggiate in carrozza con cavalli da tiro: tiro del Nord, tiro del Boulonnais e tiro delle Ardenne<br>Attività didattiche su cavalli e asini"
        ],
        "fr": [
          "Découverte du patrimoine régional (route du patois) d'Houdain et ses environs par le biais de balades en calèche attelée à des chevaux de trait : trait du nord, boulonnais, ardennais<br>Animation pédagogique sur l'approche du cheval et de l'âne"
        ],
        "nl": [
          "Ontdek het regionale erfgoed (patoisroute) van Houdain en omgeving tijdens koetstochten met trekpaarden: noordelijke trekpaarden, Boulonnais en Ardense trekpaarden<br>Educatieve activiteiten met paarden en ezels"
        ],
        "es": [
          "Descubra el patrimonio regional (ruta del patois) de Houdain y sus alrededores en paseos en coche de caballos de tiro: tiro del Norte, tiro de Boulonnais y tiro de las Ardenas<br>Actividades pedagógicas con caballos y burros"
        ]
      },
      "@type": [
        "Description"
      ],
