  "rdfs:comment": {
    "de": [
      "Café Leffe schlägt vor, ihre Biere vom Fass in der größten belgischen Tradition serviert. Finden Sie auch eine Liste mit Cocktails im Sommer auf der großen Terrasse genießen."
    ],
    "en": [
      "The Café Leffe proposes a range of draught beers served keeping with Belgian tradition. You can also choose from a selection of cocktails, which are a pure delight in summer out on the large terrace."
    ],
    "it": [
      "Café Leffe propone le sue birre alla spina servita nella grande tradizione belga. Anche trovare una lista di cocktail per godersi l'estate sulla grande terrazza."
    ],
    "fr": [
      "Le Café Leffe vous propose ses bières pressions servies dans la plus grande tradition belge. Retrouvez également une carte de cocktails à savourer l’été sur la grande terrasse."
    ],
    "es": [
      "Café Leffe propone sus cervezas de barril servido en la mayor tradición belga. También encontrará una lista de cócteles para disfrutar del verano en la terraza."
    ],
