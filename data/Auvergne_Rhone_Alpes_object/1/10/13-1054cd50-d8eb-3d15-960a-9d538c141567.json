  "rdfs:comment": {
    "de": [
      "Nutzen Sie das Wellnessangebot von Les Roches Fleuries!\r\nSie werden den Wellnessbereich (Sauna), den Poolbereich (nur in der Sommersaison) und den Pflegebereich nutzen."
    ],
    "en": [
      "Take advantage of the wellness offer at Les Roches Fleuries!\nTake advantage of the wellness area (sauna), the pool area (summer season only) and the treatment area."
    ],
    "it": [
      "Approfittate delle strutture benessere di Les Roches Fleuries!\nApprofittate dell'area benessere (sauna), dell'area piscina (solo nella stagione estiva) e dell'area trattamenti."
    ],
    "fr": [
      "Profitez de l'offre bien-être des Roches Fleuries !\r\nVous profiterez de l'espace bien être (sauna), l'espace piscine (saison d'été uniquement)  et l'espace soin."
    ],
    "nl": [
      "Profiteer van de wellnessfaciliteiten in Les Roches Fleuries!\r\nProfiteer van de wellnessruimte (sauna), het zwembad (alleen in het zomerseizoen) en de behandelruimte."
    ],
    "es": [
      "Aproveche las instalaciones de bienestar de Les Roches Fleuries\r\nDisfrute de la zona de bienestar (sauna), la zona de piscina (solo en verano) y la zona de tratamientos."
    ]
  },
