  "rdfs:comment": {
    "de": [
      "Das im Wald von Ripaille errichtete Denkmal würdigt die Männer und Frauen, die Juden während des letzten Weltkrieges versteckt, unterstützt und gerettet haben (1997 eingeweihtes Denkmal)."
    ],
    "en": [
      "The memorial in Ripaille Forest pays homage to the men and women who hid, helped and saved the Jews during World War II. The monument was inaugurated in 1997."
    ],
    "it": [
      "Il memoriale, eretto nella foresta di Ripaille, rende omaggio a quegli uomini e quelle donne che hanno nascosto, aiutato e salvato gli ebrei durante la seconda guerra mondiale (monumento inaugurato nel 1997)."
    ],
    "fr": [
      "Le mémorial, érigé dans la forêt de Ripaille, rend hommage à ces hommes et femmes qui ont caché, aidé et sauvé les juifs durant la dernière guerre mondiale (monument inauguré en 1997)."
    ],
    "nl": [
      "Het monument, opgericht in het bos van Ripaille, brengt hulde aan de mannen en vrouwen die tijdens de laatste wereldoorlog Joden hebben verborgen, geholpen en gered (monument ingehuldigd in 1997)."
    ],
    "es": [
      "El monumento, erigido en el bosque de Ripaille, rinde homenaje a los hombres y mujeres que escondieron, ayudaron y salvaron a los judíos durante la última guerra mundial (monumento inaugurado en 1997)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Nationale Gedenkstätte der Gerechten - „La Clairière des Justes“"
    ],
    "en": [
      "National Memorial to the Righteous"
    ],
    "it": [
      "Memoriale nazionale dei Giusti"
    ],
    "fr": [
      "Mémorial National des Justes - \"La Clairière des Justes\""
    ]
  },
