  "rdfs:comment": {
    "de": [
      "Amandine und Marc laden Sie ein, ihre Gerichte zum Mittag- oder Abendessen in einem modernen und angenehmen Ambiente zu entdecken. Es wird Ihnen eine Gourmetküche angeboten, die mit frischen und saisonalen Produkten zubereitet wird. Marktmenü, mittags unter der Woche."
    ],
    "en": [
      "Amandine and Marc invite you to discover their dishes, for lunch or dinner, in a modern and pleasant atmosphere. Our gourmet cuisine is prepared with fresh, seasonal produce. Market menu, weekday lunchtimes."
    ],
    "it": [
      "Amandine e Marc vi invitano a scoprire i loro piatti, a pranzo e a cena, in un'atmosfera moderna e piacevole. Viene offerta una cucina gastronomica, preparata con prodotti freschi e di stagione. Menu del mercato a pranzo nei giorni feriali."
    ],
    "fr": [
      "Amandine et Marc vous invitent à découvrir leurs mets, au déjeuner comme au dîner, dans une ambiance moderne et agéable. Une cuisine gastronomique vous est proposée, élaborée avec des produits frais et de saison. Menu du marché, le midi en semaine."
    ],
    "es": [
      "Amandine y Marc le invitan a descubrir sus platos, para el almuerzo y la cena, en un ambiente moderno y agradable. Se ofrece una cocina gastronómica elaborada con productos frescos y de temporada. Menú del mercado a la hora de comer los días laborables."
    ],
    "nl": [
      "Amandine en Marc nodigen u uit om hun gerechten te ontdekken, voor lunch en diner, in een moderne en aangename sfeer. Er wordt een gastronomische keuken aangeboden, bereid met verse en seizoensgebonden producten. Marktmenu tijdens de lunch op weekdagen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant Le Petit Mézériat"
    ],
    "fr": [
      "Restaurant Le Petit Mézériat"
    ]
  },
