  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist ein ganz neuer Ort, der zu jeder Jahreszeit oder anlässlich von Veranstaltungen der Gemeinde von unseren ehrenamtlichen Künstlern dekoriert wird. Sie bietet Ihnen zahlreiche und vielfältige Lektüren, Bücher in Großdruck, Lesetexte, CDs und DVDs."
    ],
    "en": [
      "The library is a brand-new facility, decorated each season or for local events by our volunteer artists, offering a wide range of reading material, large-print books, reading texts, CDs and DVDs."
    ],
    "it": [
      "La biblioteca è una struttura nuovissima, decorata ogni stagione o in occasione di eventi locali dai nostri artisti volontari, e offre un'ampia gamma di materiale di lettura, libri a caratteri grandi, testi di lettura, CD e DVD."
    ],
    "fr": [
      "La bibliothèque est un lieu tout neuf décorée à chaque saison ou à l’occasion des manifestations de la commune par nos bénévoles artistes, elle vous offre des lectures nombreuses et variées, des livres en gros caractères, des textes lus, des CD et DVD."
    ],
    "es": [
      "La biblioteca es una instalación totalmente nueva, decorada cada temporada o para eventos locales por nuestros artistas voluntarios. Ofrece una amplia gama de material de lectura, libros en letra grande, textos de lectura, CD y DVD."
    ],
    "nl": [
      "De bibliotheek is een gloednieuw gebouw dat elk seizoen of voor plaatselijke evenementen wordt versierd door onze vrijwillige kunstenaars. Het biedt een breed scala aan leesmateriaal, boeken met grote letters, leesteksten, cd's en dvd's."
    ]
  },
