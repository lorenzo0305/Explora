  "rdfs:comment": {
    "de": [
      "Ehemaliger Basketballspieler, ehemaliger Club Med-Animateur, ehemaliger Cours Florent! Édouard hat tausend Leben gelebt!\r\nUnd er hat Ihnen viel zu erzählen, von seinen jungen Jahren in der Normandie bis hin zur Bühne des Jamel Comedy Club!"
    ],
    "en": [
      "Former basketball player, former Club Med host, former student of the Cours Florent! Édouard has had a thousand lives!\r\nAnd he's got plenty to tell you, from his early years in Normandy to the Jamel Comedy Club!"
    ],
    "it": [
      "Ex giocatore di basket, ex conduttore di Club Med ed ex studente del Cours Florent! Édouard ha avuto mille vite!\r\nE ha molto da raccontare, dai suoi primi anni in Normandia al Jamel Comedy Club!"
    ],
    "fr": [
      "Ancien basketteur, ancien animateur Club Med, ancien du Cours Florent ! Édouard a eu mille vies !\r\nEt il a plein de choses à vous raconter de ses jeunes années en Normandie aux planches du Jamel Comedy Club !"
    ],
    "nl": [
      "Voormalig basketbalspeler, voormalig Club Med-gastheer en oud-student van het Cours Florent! Édouard heeft duizend levens gehad!\r\nEn hij heeft je genoeg te vertellen, van zijn vroege jaren in Normandië tot de Jamel Comedy Club!"
    ],
    "es": [
      "Ex jugador de baloncesto, ex presentador del Club Med y ex alumno del Cours Florent Édouard ha tenido mil vidas\r\nY tiene mucho que contarte, desde sus primeros años en Normandía hasta el Club de la Comedia Jamel"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Humour: Edouard Deloignon"
    ]
  },
