  "rdfs:comment": {
    "de": [
      "Bistro der guten Menschen. Ein Ort, an dem das Teilen und die Geselligkeit groß geschrieben werden.\r\nNEU: Essen vor Ort und zum Mitnehmen mittags (während der Schulferien) und abends. Gekochte Gerichte aus unserer Heimat und aus anderen Ländern."
    ],
    "en": [
      "Bistrot des bons vivants. A place where sharing and conviviality are the watchwords.\r\nNEW: takeaway and on-site catering at lunchtime (during school vacations) and in the evening. Local and international dishes."
    ],
    "it": [
      "Bistrot des bons vivants. Un luogo dove condivisione e convivialità sono le parole d'ordine.\r\nNOVITÀ: ristorazione da asporto e in loco a pranzo (durante le vacanze scolastiche) e la sera. Piatti locali e internazionali."
    ],
    "fr": [
      "Bistrot des bons vivants. Lieu de vie où le partage et la convivialité sont maîtres mots.\r\nNOUVEAU : restauration sur place et à emporter le midi (pendant les vacances scolaires) et le soir. Des plats cuisinés de chez nous et d'ailleurs."
    ],
    "es": [
      "Bistrot des bons vivants. Un lugar donde compartir y convivir son las palabras clave.\r\nNOVEDAD: comida para llevar y catering a mediodía (durante las vacaciones escolares) y por la noche. Platos locales e internacionales."
    ],
    "nl": [
      "Bistrot des bons vivants. Een plek waar delen en gezelligheid de sleutelwoorden zijn.\r\nNIEUW: afhaalmaaltijden en catering ter plaatse 's middags (tijdens schoolvakanties) en 's avonds. Lokale en internationale gerechten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lous Fadas"
    ]
  },
