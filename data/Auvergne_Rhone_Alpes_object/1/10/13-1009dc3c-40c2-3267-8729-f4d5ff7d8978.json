  "rdfs:comment": {
    "de": [
      "Elémentaire von der Cie Tancarville\r\nAusgehend von wiederverwerteten Materialien, zweckentfremdeten Objekten, Körper und Stimme lädt ?Élémentaire? Sie ein, eine poetische und farbenfrohe musikalische Reise zu erleben, inmitten seiner erstaunlichen instrumentalen Strukturen."
    ],
    "en": [
      "Elémentaire by Cie Tancarville\r\nUsing salvaged materials, misappropriated objects, the body and the voice, ?Élémentaire? takes you on a colorful, poetic musical journey through its astonishing instrumental structures."
    ],
    "it": [
      "Elémentaire di Cie Tancarville\r\nUtilizzando materiali di recupero, oggetti di cui ci si è appropriati, il corpo e la voce, \"Élémentaire\" vi conduce in un viaggio musicale colorato e poetico attraverso le sue sorprendenti strutture strumentali."
    ],
    "fr": [
      "Elémentaire par la Cie Tancarville\r\nÀ partir de matériaux de récupération, d’objets détournés, du corps et de la voix, “Élémentaire” vous propose de vivre un voyage musical poétique et coloré, au cœur de ses structures instrumentales étonnantes."
    ],
    "es": [
      "Élémentaire de Cie Tancarville\r\nUtilizando materiales recuperados, objetos malversados, el cuerpo y la voz, \"Élémentaire\" le lleva a un viaje musical colorista y poético a través de sus sorprendentes estructuras instrumentales."
    ],
    "nl": [
      "Elémentaire van Cie Tancarville\r\nMet behulp van afgedankte materialen, ontvreemde voorwerpen, het lichaam en de stem neemt Élémentaire je mee op een kleurrijke, poëtische muzikale reis door zijn verbazingwekkende instrumentale structuren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle musical : Elémentaire"
    ]
  },
