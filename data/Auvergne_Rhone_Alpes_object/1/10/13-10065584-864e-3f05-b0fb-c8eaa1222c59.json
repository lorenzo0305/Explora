  "rdfs:comment": {
    "de": [
      "Die Domaine de Rosier baut auf 9 ha Weinbergen die Rebsorten Viognier und Syrah an, um die namhaften Appellationen Côte-Rôtie (in Ampuis) und Condrieu (in Saint-Michel-sur-Rhône) zu erzeugen. In Tupin-et-Semons wird außerdem eine g.g.A. erzeugt."
    ],
    "en": [
      "The Domaine de Rosiers has 9 hectares of vineyards with Viognier and Syrah grapes producing the prestigious Côte-Rôtie wine in Ampuis and Condrieu in Saint-Michel-sur Rhône. The winery also makes a PGI Syrah in Tupin-et-Semons."
    ],
    "it": [
      "Il Domaine de Rosiers possiede 9 ettari di vigneti biologici piantati con uve Viognier e Syrah per produrre la prestigiosa denominazione Côte-Rôtie ad Ampuis e la denominazione Condrieu a Saint-Michel-sur-Rhône. Produce anche un Syrah IGP a Tupin-et-Semons."
    ],
    "fr": [
      "Le domaine de Rosiers exploite 9 ha de vignes en AB travaillant les cépages Viognier et Syrah afin de produire les prestigieuses appellations Côte-Rôtie sur Ampuis et Condrieu à Saint-Michel-sur Rhône. Il produit aussi un IGP Syrah sur Tupin-et-Semons."
    ],
    "es": [
      "El Domaine de Rosiers posee 9 hectáreas de viñedos ecológicos plantados con uvas Viognier y Syrah para producir la prestigiosa denominación Côte-Rôtie en Ampuis y la denominación Condrieu en Saint-Michel-sur-Rhône. También produce una IGP Syrah en Tupin-et-Semons."
    ],
    "nl": [
      "Domaine de Rosiers heeft 9 hectare biologische wijngaarden beplant met Viognier en Syrah druiven om de prestigieuze Côte-Rôtie appellatie in Ampuis en de Condrieu appellatie in Saint-Michel-sur-Rhône te produceren. Het produceert ook een IGP Syrah in Tupin-et-Semons."
    ]
  },
