      "@id": "https://data.datatourisme.fr/fdad4842-3f20-308f-89e0-49b0b7e659cb",
      "dc:description": {
        "de": [
          "Au poulet du Ménôme, Verkauf von regionalen Produkten, Brathähnchen, Fertiggerichten, kleiner Lebensmittelladen.\nLiegt 700 m vom Strand entfernt."
        ],
        "en": [
          "Au poulet du Ménôme, sale of regional products, roast chicken, ready-made meals, small grocery store.\nLocated 700m from the beach."
        ],
        "it": [
          "Au poulet du Ménôme, vendita di prodotti regionali, pollo arrosto, piatti pronti, piccolo negozio di alimentari.\nSituato a 700 m dalla spiaggia."
        ],
        "fr": [
          "Au poulet du Ménôme, vente de produits régionaux, poulet rôti, plats préparés, petite épicerie.\nSitué à 700m de la plage."
        ],
        "nl": [
          "Au poulet du Ménôme, verkoop van streekproducten, gebraden kip, kant-en-klaarmaaltijden, kleine kruidenierswinkel.\nGelegen op 700m van het strand."
        ],
        "es": [
          "Au poulet du Ménôme, venta de productos regionales, pollo asado, platos preparados, pequeña tienda de comestibles.\nSituado a 700 m de la playa."
        ]
      },
