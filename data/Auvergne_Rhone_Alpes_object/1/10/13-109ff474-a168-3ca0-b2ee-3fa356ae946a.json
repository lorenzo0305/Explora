  "rdfs:comment": {
    "de": [
      "Mein Beruf Meine Leidenschaft\r\nMeine Leidenschaft für meinen Beruf ist es, alle Ereignisse Ihres Lebens mit Blumen zu schmücken.\r\nGenießen Sie einen herzlichen Empfang und ein offenes Ohr für die Umsetzung Ihrer Wünsche.\r\nLieferservice.\r\nBlumenvermittlung."
    ],
    "en": [
      "My Job My Passion\r\nI'm passionate about my work, and I'm here to help you make the most of every event in your life.\r\nEnjoy a warm welcome and attentive listening for the realization of your desires.\r\nDelivery service.\r\nFloral transmission."
    ],
    "it": [
      "Il mio lavoro, la mia passione\r\nSono appassionata del mio lavoro e sono qui per aiutarvi a trarre il meglio da ogni evento della vostra vita.\r\nGodetevi un'accoglienza calorosa e un ascolto attento per la realizzazione dei vostri desideri.\r\nServizio di consegna.\r\nTrasmissione floreale."
    ],
    "fr": [
      "Mon Métier Ma Passion\r\nPassionnée par mon métier pour fleurir tous les évènements de vos vies.\r\nProfitez d'un accueil chaleureux et d'une écoute attentive pour les réalisations de vos envies.\r\nService de livraison.\r\nTransmission florale."
    ],
    "nl": [
      "Mijn baan, mijn passie\r\nIk heb passie voor mijn werk en ik ben er om je te helpen het beste te halen uit elke gebeurtenis in je leven.\r\nGeniet van een warm welkom en een luisterend oor voor de verwezenlijking van je wensen.\r\nBezorgservice.\r\nBloementransmissie."
    ],
    "es": [
      "Mi trabajo, mi pasión\r\nMe apasiona mi trabajo y estoy aquí para ayudarle a sacar el máximo partido de cada acontecimiento de su vida.\r\nDisfrute de una cálida acogida y una escucha atenta para la realización de sus deseos.\r\nServicio de entrega.\r\nTransmisión floral."
    ]
  },
  "rdfs:label": {
    "fr": [
      "1 Brin 2 Folie"
    ]
  },
