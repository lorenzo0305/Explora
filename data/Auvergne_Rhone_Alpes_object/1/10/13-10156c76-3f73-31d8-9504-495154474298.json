  "rdfs:comment": {
    "de": [
      "Bei Sylvie erwartet Sie ein einzigartiges kulinarisches Erlebnis! Weit entfernt von einem traditionellen Restaurant, entdecken Sie einen neu gestalteten Gästetisch mit einem frischen und kreativen Tagesmenü, das nach Ihren Wünschen zusammengestellt wird (vegetarisch, Allergien...) Nur 20 Plätze, denken Sie daran zu reservieren!"
    ],
    "en": [
      "A unique culinary experience awaits you at Sylvie's! Far from the traditional restaurant, discover a table d'hôtes revisited with a menu of the day, fresh and creative, elaborated according to your desires (vegan, allergy...) Only 20 seats, remember to reserve!"
    ],
    "it": [
      "Un'esperienza culinaria unica vi aspetta da Sylvie! Lontano dal ristorante tradizionale, scoprite una table d'hôtes rivisitata con un menu del giorno, fresco e creativo, preparato secondo i vostri desideri (veg, allergie...) Solo 20 coperti, ricordatevi di prenotare!"
    ],
    "fr": [
      "Une expérience culinaire unique vous attend chez Sylvie ! Loin du restaurant traditionnel, découvrez une table d'hôtes revisitée avec un menu du jour, frais et créatif, élaboré selon vos envies (végé, allergie...) Seulement 20 couverts, pensez à réserver!"
    ],
    "es": [
      "En Sylvie's le espera una experiencia culinaria única Lejos del restaurante tradicional, descubra una table d'hôtes revisitada con un menú del día, fresco y creativo, preparado según sus deseos (verduras, alergias...) Sólo 20 cubiertos, ¡recuerde reservar!"
    ],
    "nl": [
      "Bij Sylvie wacht je een unieke culinaire ervaring! Ver van het traditionele restaurant, ontdek een table d'hôtes in een nieuw jasje met een dagmenu, vers en creatief, bereid volgens jouw wensen (groenten, allergieën...) Slechts 20 couverts, vergeet niet te reserveren!"
    ]
  },
