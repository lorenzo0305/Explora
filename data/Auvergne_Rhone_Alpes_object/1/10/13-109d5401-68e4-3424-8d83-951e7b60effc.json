  "rdfs:comment": {
    "de": [
      "Les Ruchers De Saint Pancrace lädt Sie ein, die Welt der Bienenzucht mit einem starken Engagement für die Umwelt und den Tierschutz zu entdecken."
    ],
    "en": [
      "Les Ruchers De Saint Pancrace invites you to discover the world of beekeeping with a strong commitment to the environment and animal welfare."
    ],
    "it": [
      "Les Ruchers De Saint Pancrace vi invita a scoprire il mondo dell'apicoltura, con il suo forte impegno per l'ambiente e il benessere degli animali."
    ],
    "fr": [
      "Les Ruchers De Saint Pancrace vous invitent à découvrir l'univers de l'apiculture avec un engagement fort pour l'environnement et le bien-être animal."
    ],
    "nl": [
      "Les Ruchers De Saint Pancrace nodigt je uit om de wereld van de bijenteelt te ontdekken, met zijn sterke betrokkenheid bij het milieu en dierenwelzijn."
    ],
    "es": [
      "Les Ruchers De Saint Pancrace le invita a descubrir el mundo de la apicultura, con su firme compromiso con el medio ambiente y el bienestar animal."
    ]
  },
