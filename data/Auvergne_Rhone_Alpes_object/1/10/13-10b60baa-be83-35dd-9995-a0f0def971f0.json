  "rdfs:comment": {
    "de": [
      "Pokévaïana ist ein polynesisches Restaurantkonzept, das ultrafrische, großzügige Poké anbietet."
    ],
    "en": [
      "Pokévaïana is a Polynesian catering concept offering ultra-fresh, generous poké, with guaranteed top quality, to order in, take away or deliver."
    ],
    "it": [
      "Pokévaïana è un concetto di ristorante polinesiano che offre poké freschissimo e generoso, di qualità superiore garantita, da ordinare a domicilio, da portare via o da consegnare."
    ],
    "fr": [
      "Pokévaïana, c’est un concept de restauration polynésiens de poké ultra frais, généreux ou l’on vous garantit une qualité supérieure  à commander sur place, à emporter ou en livraison."
    ],
    "nl": [
      "Pokévaïana is een Polynesisch restaurantconcept met ultraverse, royale poké van gegarandeerde topkwaliteit, om te bestellen, mee te nemen of te laten bezorgen."
    ],
    "es": [
      "Pokévaïana es un concepto de restaurante polinesio que ofrece poké ultrafresco y generoso, con la máxima calidad garantizada, para pedir en casa, para llevar o a domicilio."
    ]
  },
