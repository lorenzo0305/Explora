  "rdfs:comment": {
    "de": [
      "Mit Blick auf den gesamten Lac du Bourget genießen Sie hier eine Küche, die je nach Jahreszeit aus frischen und regionalen Produkten zubereitet wird."
    ],
    "en": [
      "Overlooks the whole of Lake Bourget and serves a seasonal cuisine featuring fresh regional products."
    ],
    "it": [
      "Con il bel panorama del lago del Bourget sullo sfondo, venite a gustare una cucina di stagione con prodotti freschi e regionali."
    ],
    "fr": [
      "Dominant la totalité du Lac du Bourget, venez déguster une cuisine réalisée au gré des saisons à partir de produits frais et régionaux."
    ],
    "nl": [
      "Met uitzicht op het hele Lac du Bourget kunt u komen proeven van een keuken die volgens de seizoenen is samengesteld uit verse en regionale producten."
    ],
    "es": [
      "Con vistas al conjunto del lago del Bourget, venga a degustar una cocina elaborada según las estaciones a partir de productos frescos y regionales."
    ]
  },
