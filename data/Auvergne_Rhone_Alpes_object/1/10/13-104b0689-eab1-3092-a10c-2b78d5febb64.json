  "rdfs:comment": {
    "de": [
      "Aquarellistin, Illustratorin und Lehrerin im Atelier Bulle d'Art.\r\nVerfügbar, um alle Ihre Projekte zu realisieren, Poster, Illustrationen, Karten...\r\nDas ganze Jahr über: Kurse und Praktika in Zeichnen, Malen und Modellbau."
    ],
    "en": [
      "Painting workshop."
    ],
    "it": [
      "Acquarellista, illustratore e insegnante presso l'Atelier Bulle d'Art.\r\nA disposizione per realizzare tutti i vostri progetti, poster, illustrazioni, cartery...\r\nTutto l'anno: corsi e laboratori di disegno, pittura e modelli dal vivo."
    ],
    "fr": [
      "Aquarelliste, illustratrice et enseignante au sein de l'Atelier Bulle d'Art.\r\nDisponible pour réaliser tous vos projets, affiches, illustrations, carterie...\r\nToute l'année: cours et stages de dessin, peinture et modèle vivant."
    ],
    "nl": [
      "Aquarellist, illustrator en docent aan het Atelier Bulle d'Art.\r\nBeschikbaar om al uw projecten te realiseren, posters, illustraties...\r\nHet hele jaar door: cursussen en workshops tekenen, schilderen en levend model."
    ],
    "es": [
      "Acuarelista, ilustrador y profesor del Atelier Bulle d'Art.\r\nDisponible para realizar todos sus proyectos, carteles, ilustraciones, cartería...\r\nTodo el año: cursos y talleres de dibujo, pintura y modelado en vivo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bulle d'art workshop"
    ],
