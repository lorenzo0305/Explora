      "dc:description": {
        "de": [
          "Angeln im Fluss 1. Kategorie<br>12 Forellenbesatz. Eine 7 km lange Strecke<br><br> Angeln in 11 Hektar großen und 5 Hektar großen Wasserflächen<br>"
        ],
        "en": [
          "1st category river fishing<br>12 trout repopulations. A 7 km fishing trail<br><br>11-hectare lake and 5-hectare lake<br>"
        ],
        "it": [
          "Pesca fluviale di 1a categoria<br>12 programmi di ripopolamento delle trote. Un percorso di pesca di 7 km<br><br>Pesca su 11 ettari e 5 ettari di acqua<br>"
        ],
        "fr": [
          "Pêche en rivière 1ère catégorie<br>12 repeuplements de truites. Un parcours de 7 km<br><br>Pêche en plan d'eau de 11 hectares et 5 hectares<br>"
        ],
        "nl": [
          "Riviervissen in de 1e categorie<br>12 uitzetprogramma's voor forel. Een visroute van 7 km<br><br>Vissen op 11 hectare en 5 hectare water<br>"
        ],
        "es": [
          "Pesca fluvial de 1ª categoría<br>12 repoblaciones de truchas. Un sendero de pesca de 7 km<br><br>Pesca en 11 hectáreas y 5 hectáreas de agua<br>"
        ]
      },
