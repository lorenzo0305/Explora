  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Geschmack der Auvergne bei Christophe und Sylviane.\r\nBankette, Essen zum Mitnehmen, Geschäftsessen und Cateringservice.\r\nTerrasse im Sommer."
    ],
    "en": [
      "Come and discover the taste of Auvergne at Christophe and Sylviane's.\r\nBanquets, takeaways, business meals and catering.\r\nTerrace in summer."
    ],
    "it": [
      "Venite a gustare un assaggio dell'Alvernia nel ristorante di Christophe e Sylviane.\r\nBanchetti, take away, pranzi di lavoro e servizi di catering.\r\nTerrazza in estate."
    ],
    "fr": [
      "Venez retrouver le goût de l'Auvergne chez Christophe et Sylviane.\r\nBanquet, repas à emporter, repas d'affaires et service traiteur.\r\nTerrasse en été."
    ],
    "nl": [
      "Kom proeven van de Auvergne in het restaurant van Christophe en Sylviane.\r\nBanketten, afhaalmaaltijden, zakendiners en catering.\r\nTerras in de zomer."
    ],
    "es": [
      "Disfrute del sabor de Auvernia en el restaurante de Christophe y Sylviane.\r\nBanquetes, comida para llevar, comidas de negocios y catering.\r\nTerraza en verano."
    ]
  },
  "rdfs:label": {
