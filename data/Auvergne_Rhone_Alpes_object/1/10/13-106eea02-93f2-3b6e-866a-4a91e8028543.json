  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Dorf Saint-Gervais-sur-Roubion während einer 1,5-stündigen kommentierten Besichtigung, der eine Weinprobe bei unserem Weinpartner folgt."
    ],
    "en": [
      "Come and discover the village of Saint-Gervais-sur-Roubion on a 1h30 guided tour, followed by a wine tasting at our partner winery."
    ],
    "it": [
      "Venite a scoprire il villaggio di Saint-Gervais-sur-Roubion con una visita guidata di 1 ora, seguita da una degustazione di vini presso la nostra cantina partner."
    ],
    "fr": [
      "Venez découvrir le village de Saint-Gervais-sur-Roubion le temps d'une visite commentée d'une durée de 1h30 qui sera suivie d'une dégustation de vin chez notre partenaire viticole."
    ],
    "es": [
      "Venga a descubrir el pueblo de Saint-Gervais-sur-Roubion en una visita guiada de hora y media, seguida de una degustación de vinos en nuestra bodega asociada."
    ],
    "nl": [
      "Kom en ontdek het dorp Saint-Gervais-sur-Roubion tijdens een rondleiding van 1 uur, gevolgd door een wijnproeverij bij onze partner wijnmakerij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite commentée du village de Saint Gervais s/Roubion suivie d'une dégustation"
    ]
  },
