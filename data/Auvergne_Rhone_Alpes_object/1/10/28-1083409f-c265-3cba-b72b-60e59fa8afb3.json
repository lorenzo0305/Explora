  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/36b3d16d-6121-368f-bd2f-f2e74c2ae645",
      "dc:description": {
        "de": [
          "In der Nähe der Salamander-Turnhalle und in der Nähe des Ufers des Flusses Oise und des Wohnmobilstellplatzes gelegen.\n\nEntdecken Sie verschiedene Einrichtungen vor Ort: 2 Picknicktische, 2 Bänke, Spielplatz und PKW-Parkplatz."
        ],
        "en": [
          "Located close to the Salamandre gymnasium, the banks of the River Oise and the motorhome park.\n\nDiscover the various facilities on site: 2 picnic tables, 2 benches, playground and parking lot."
        ],
        "it": [
          "Situato vicino alla palestra di Salamandre, alle rive del fiume Oise e al parco camper.\n\nScoprite le varie strutture presenti in loco: 2 tavoli da picnic, 2 panchine, area giochi e parcheggio."
        ],
        "fr": [
          "Située à proximité du gymnase de la salamandre et proche des les rives  de la rivière Oise et  de l'aire de camping-car. \n\nDécouvrez divers équipements sur place : 2 tables de pique-nique, 2 bancs, aire de jeux et parking voitures."
        ],
        "es": [
          "Situado cerca del gimnasio Salamandre, de las orillas del río Oise y del parque de autocaravanas.\n\nDescubra las distintas instalaciones in situ: 2 mesas de picnic, 2 bancos, zona de juegos y aparcamiento."
        ],
        "nl": [
          "Dicht bij het gymnasium van Salamandre, de oevers van de Oise en het camperpark.\n\nOntdek de verschillende faciliteiten ter plaatse: 2 picknicktafels, 2 bankjes, speeltuin en parkeerplaats."
        ]
      },
