  "rdfs:comment": {
    "de": [
      "Bar - genießen Sie jeden Tag einen Aperitif im Freien mit Blick auf das\r\nMassif du Grand Bec rund um ein Feuer oder drinnen in der Lounge ab\r\nab 16.00 Uhr. Es werden Cocktails für jeden Geschmack angeboten sowie\r\nsowie heiße Getränke"
    ],
    "en": [
      "Our Lounge Bar opens every day at 4 pm, everybody can enjoy hot\r\ndrinks or cocktails inside the bar or on our terrace, south facing and\r\noverlooking magnificent view - the mountain of “Grand Bec”."
    ],
    "it": [
      "Bar - ogni giorno aperitivo all'aperto con vista sul Massiccio del Grand Bec intorno al fuoco\r\nMassiccio del Grand Bec attorno a un fuoco o all'interno della lounge a partire dalle ore\r\ndalle 16:00. Cocktail per tutti i gusti e bevande calde\r\ncosì come le bevande calde"
    ],
    "fr": [
      "Bar - profitez tous les jours d'un apéritif à l'extérieur avec vue sur le\r\nMassif du Grand Bec autour d'un feu ou à l'intérieur dans le salon à\r\npartir de 16h00. Des cocktails sont proposés pour tous les goûts ainsi\r\nque des boissons chaudes"
    ],
    "nl": [
      "Bar - geniet elke dag van een aperitief buiten met uitzicht op het\r\nMassif du Grand Bec rond een vuurtje of binnen in de lounge vanaf\r\nvanaf 16u. Cocktails naar ieders smaak en warme dranken\r\nen warme dranken"
    ],
    "es": [
      "Bar - disfrute de un aperitivo todos los días al aire libre con vistas al\r\nMacizo del Grand Bec alrededor de una chimenea o en el salón a partir de las\r\na partir de las 16 h. Cócteles para todos los gustos y bebidas calientes\r\nasí como bebidas calientes"
    ]
  },
