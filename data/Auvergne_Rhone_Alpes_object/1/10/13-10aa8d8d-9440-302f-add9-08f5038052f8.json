  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine authentische und kreative Küche, die sowohl traditionell als auch modern ist und auf frischen, lokalen Produkten basiert. Sie wird von den Küchenchefs Philippe und Sébastien orchestriert, die seit vier Generationen als Hoteliers & Restaurantbesitzer in der Familie sind."
    ],
    "en": [
      "Discover authentic and creative cuisine, both traditional and modern, based on fresh, local produce, orchestrated by chefs Philippe and Sébastien, a family of hoteliers and restaurateurs for 4 generations."
    ],
    "it": [
      "Scoprite una cucina autentica e creativa, sia tradizionale che moderna, basata su prodotti freschi e locali, orchestrata dagli chef Philippe e Sébastien, una famiglia di albergatori e ristoratori da 4 generazioni."
    ],
    "fr": [
      "Découvrez une cuisine authentique et créative, à la fois traditionnelle et moderne, basée sur des produits frais et locaux, orchestrée par les chefs Philippe et Sébastien, famille hôteliers & restaurateurs depuis 4 générations."
    ],
    "nl": [
      "Ontdek de authentieke en creatieve keuken, zowel traditioneel als modern, op basis van verse, lokale producten, samengesteld door chef-koks Philippe en Sébastien, al 4 generaties lang een familie van hoteliers en restauranthouders."
    ],
    "es": [
      "Descubra una cocina auténtica y creativa, tanto tradicional como moderna, basada en productos frescos y locales, orquestada por los chefs Philippe y Sébastien, una familia de hosteleros y restauradores desde hace 4 generaciones."
    ]
  },
