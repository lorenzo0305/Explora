  "rdfs:comment": {
    "de": [
      "V.O. Coaching bietet Ihnen individuelle Privatskikurse für Kinder und Erwachsene, vom Anfänger bis zum Fortgeschrittenen in den Skigebieten Alpe d'Huez, Oz und Vaujany, in einer freundlichen und spielerischen Atmosphäre...Spaß für alle!"
    ],
    "en": [
      "V.O. Coaching offers you ski and snowboard individual lessons for children and adults, from beginners to experts. \r\nAll this in a friendly and playful atmosphere!"
    ],
    "it": [
      "V.O. Coaching offre lezioni private di sci individuali per bambini e adulti, da principianti ad avanzati, nelle aree di Alpe d'Huez, Oz e Vaujany, in un'atmosfera amichevole e divertente... divertimento per tutti!"
    ],
    "fr": [
      "V.O. Coaching vous propose des cours de ski  privés individuels pour enfants et adultes, de l'initiation au perfectionnement sur les domaines de l'Alpe d'Huez, Oz et Vaujany, dans une ambiance conviviale et ludique...le plaisir pour tous !"
    ],
    "es": [
      "V.O. Coaching ofrece clases particulares de esquí para niños y adultos, desde principiantes hasta avanzados, en las zonas de Alpe d'Huez, Oz y Vaujany, en un ambiente agradable y divertido... ¡diversión para todos!"
    ],
    "nl": [
      "V.O. Coaching biedt privé één-op-één ski- en snowboardlessen voor kinderen en volwassenen, van beginners tot gevorderden, in de gebieden Alpe d'Huez, Oz en Vaujany, in een vriendelijke, leuke sfeer... plezier voor iedereen!"
    ]
  },
