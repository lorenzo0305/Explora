  "rdfs:comment": {
    "de": [
      "Diese Kirche liegt auf den Anhöhen des Dorfes Manthes neben dem Priorat. Die zentrale Apsis im romanischen Stil wird von einem Glasfenster aus dem 14. Jahrhundert beleuchtet, das die Apostel Petrus und Paulus, die Schutzpatrone der Kirche, darstellt. Zu entdecken..."
    ],
    "en": [
      "Situated on the heights of the village of Manthes, next to the Priory. Romanesque in style, the central apse is illuminated by a 14th-century stained-glass window depicting the apostles Peter and Paul, the church's patrons. To discover..."
    ],
    "it": [
      "Situato sulle alture del villaggio di Manthes, accanto al Priorato. In stile romanico, l'abside centrale è illuminata da una vetrata del XIV secolo che rappresenta gli apostoli Pietro e Paolo, patroni della chiesa. Da scoprire..."
    ],
    "fr": [
      "Situé sur les hauteurs du village de Manthes à côté du Prieuré. De style roman, l’abside centrale est éclairée par un vitrail du 14ème siècle représentant les apotres Pierre et Paul, patrons de l’église. A découvrir..."
    ],
    "es": [
      "Situado en las alturas del pueblo de Manthes junto al Priorato. De estilo románico, el ábside central está iluminado por una vidriera del siglo XIV que representa a los apóstoles Pedro y Pablo, patronos de la iglesia. Por descubrir..."
    ],
    "nl": [
      "Gelegen op de hoogten van het dorp Manthes, naast de Priorij. De centrale apsis heeft een romaanse stijl en wordt verlicht door een 14e-eeuws gebrandschilderd raam met de apostelen Petrus en Paulus, de beschermheiligen van de kerk. Een bezoek waard..."
    ]
  },
