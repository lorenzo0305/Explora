  "rdfs:comment": {
    "de": [
      "Dominique Blanchard bietet ihre handgefertigten Kreationen aus Keramik an. Gebrauchsgegenstände für den Alltag, Schmuck und Dekoration bilden ein originelles und farbenfrohes Universum. Auf Anfrage Einführung in die Töpferei oder in die Malerei auf Steingut."
    ],
    "en": [
      "Dominique Blanchard offers her handcrafted ceramic creations. Everyday objects, jewelry and decorative items make up an original and colorful universe. Introduction to pottery or earthenware painting on request."
    ],
    "it": [
      "Dominique Blanchard presenta le sue creazioni in ceramica fatte a mano. Oggetti di uso quotidiano, gioielli e oggetti decorativi compongono un mondo originale e colorato. Iniziazione alla ceramica o alla pittura su terracotta su richiesta."
    ],
    "fr": [
      "Dominique Blanchard propose ses créations artisanales en céramique. Objets utilitaires du quotidien, bijoux et décoration composent un univers original et coloré. Initiation à la poterie ou à la peinture sur faïence sur demande."
    ],
    "nl": [
      "Dominique Blanchard toont haar handgemaakte keramische creaties. Alledaagse voorwerpen, sieraden en decoratieve objecten vormen een originele en kleurrijke wereld. Inwijding in pottenbakken of schilderen op aardewerk op aanvraag."
    ],
    "es": [
      "Dominique Blanchard expone sus creaciones de cerámica hechas a mano. Objetos cotidianos, joyas y objetos de decoración componen un universo original y colorista. Iniciación a la alfarería o pintura sobre loza a petición."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Que Cera Ceram"
    ]
  },
