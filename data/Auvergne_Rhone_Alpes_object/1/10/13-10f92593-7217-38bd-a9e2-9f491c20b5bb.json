  "rdfs:comment": {
    "de": [
      "Das in Saint-Genix-sur-Guiers, dem Land des Gâteau de St Genix, und am Tor zur ViaRhôna gelegene Tourismusbüro ist eine unumgängliche Adresse, um das Land des Lac d'Aiguebelette zu entdecken."
    ],
    "en": [
      "Located at Saint-Genix-sur-Guiers, in the Pays du Gâteau de St Genix, on the edge of the Viarhôna, the Saint Genix sur Guiers Tourist Information Bureau is a must for anyone wanting to discover more about the Pays du Lac d’Aiguebelette."
    ],
    "it": [
      "Situato a Saint-Genix-sur-Guiers, terra del Gâteau de St Genix, e alle porte della ViaRhôna, l'ufficio turistico è un indirizzo essenziale per scoprire il Pays du Lac d'Aiguebelette."
    ],
    "fr": [
      "Situé à Saint-Genix-sur-Guiers, pays du Gâteau de St Genix, et aux portes de la ViaRhôna, l'office de tourisme est une adresse incontournable pour découvrir le Pays du lac d'Aiguebelette."
    ],
    "es": [
      "Situada en Saint-Genix-sur-Guiers, la tierra del Gâteau de St Genix, y a las puertas de la ViaRhôna, la oficina de turismo es una dirección imprescindible para descubrir el Pays du Lac d'Aiguebelette."
    ],
    "nl": [
      "Gelegen in Saint-Genix-sur-Guiers, het land van het Gâteau de St Genix, en aan de poort van de ViaRhôna, is het VVV-kantoor een onmisbaar adres om het Pays du Lac d'Aiguebelette te ontdekken."
    ]
  },
