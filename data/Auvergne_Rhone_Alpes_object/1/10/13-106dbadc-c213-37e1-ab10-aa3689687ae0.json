  "rdfs:comment": {
    "de": [
      "Der Verein Yoga Culture de Charroux lädt Sie ein, seine Yogakurse für die Saison 2025/2026 zu entdecken. Die Kurse sind für alle Niveaus offen und werden von zwei Lehrerinnen unterrichtet. Eine erste Probestunde ist kostenlos!"
    ],
    "en": [
      "The association Yoga Culture de Charroux invites you to discover its yoga classes for the 2025/2026 season. Classes are open to all levels and taught by two teachers. A first trial class is free!"
    ],
    "it": [
      "L'Associazione Cultura Yoga Charroux vi invita a scoprire i suoi corsi di yoga per la stagione 2025/2026. Le lezioni sono aperte a tutti i livelli e sono tenute da due insegnanti. La prima lezione di prova è gratuita!"
    ],
    "fr": [
      "L'association Yoga Culture de Charroux vous invite à découvrir ses cours de yoga pour la saison 2025/2026. Les cours sont ouverts à tous les niveaux et sont dispensés par deux professeurs. Un premier cours d'essai est gratuit !"
    ],
    "es": [
      "La Asociación Cultura del Yoga de Charroux le invita a descubrir sus clases de yoga para la temporada 2025/2026. Las clases están abiertas a todos los niveles y son impartidas por dos profesores. ¡La primera clase de prueba es gratuita!"
    ],
    "nl": [
      "De vereniging Yoga Cultuur Charroux nodigt je uit om haar yogalessen voor het seizoen 2025/2026 te ontdekken. De lessen zijn toegankelijk voor alle niveaus en worden gegeven door twee docenten. Een eerste proefles is gratis!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de Yoga"
    ]
  },
