  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise durch das Dorf Dompierre-sur-Besbre und seine Geheimnisse!\r\nKommentierte Besichtigung durch Isabelle Lardot, Bewohnerin der Gemeinde. In Zusammenarbeit mit dem Conseil des Sages und der Gemeinde Dompierre-sur-Besbre. Start am Fremdenverkehrsamt."
    ],
    "en": [
      "Discover the village of Dompierre-sur-Besbre and all its secrets!\r\nGuided tour by local resident Isabelle Lardot. In collaboration with the Conseil des Sages and the commune of Dompierre-sur-Besbre. Departure from the tourist office."
    ],
    "it": [
      "Scoprite il villaggio di Dompierre-sur-Besbre e tutti i suoi segreti!\r\nVisita guidata da Isabelle Lardot, abitante del luogo. In collaborazione con il Conseil des Sages e il comune di Dompierre-sur-Besbre. Partenza dall'ufficio turistico."
    ],
    "fr": [
      "Partez à la découverte du village de Dompierre-sur-Besbre et de ses secrets ! \r\nVisite commentée par Isabelle Lardot, habitante de la commune. En collaboration avec le Conseil des Sages et la commune de Dompierre-sur-Besbre. Départ de l'office de tourisme."
    ],
    "nl": [
      "Ontdek het dorp Dompierre-sur-Besbre en al zijn geheimen!\r\nRondleiding door buurtbewoner Isabelle Lardot. In samenwerking met de Raad van Wijzen en de gemeente Dompierre-sur-Besbre. Vertrek vanaf het toeristenbureau."
    ],
    "es": [
      "Descubra el pueblo de Dompierre-sur-Besbre y todos sus secretos\r\nVisita guiada por Isabelle Lardot, residente local. En colaboración con el Consejo de Sabios y el municipio de Dompierre-sur-Besbre. Salida desde la oficina de turismo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée de Dompierre-sur-Besbre"
    ]
  },
