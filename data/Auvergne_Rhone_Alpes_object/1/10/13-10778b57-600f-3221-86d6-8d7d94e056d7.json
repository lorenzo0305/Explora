  "rdfs:comment": {
    "de": [
      "Dieser Pfad führt zu einem monumentalen Steinbruch (3,5 m).\r\nJenseits der Passage erstreckt sich ein großes Geröllfeld, auf dem die Überreste eines am 19. Dezember 1969 abgestürzten Flugzeugs zu sehen sind."
    ],
    "en": [
      "This path leads to a monumental cairn (3.5m).\r\nBeyond the passageway, a vast scree slope reveals the remains of a plane that crashed on December 19, 1969."
    ],
    "it": [
      "Questo sentiero conduce a un monumentale cairn (3,5 m).\r\nOltre il passaggio, un vasto ghiaione rivela i resti di un aereo precipitato il 19 dicembre 1969."
    ],
    "fr": [
      "Ce sentier débouche sur un cairn monumental (3,5m).\r\nAu-delà du passage, se déploie un vaste pierrier où l’on discerne les vestiges d’un avion accidenté le 19 décembre 1969."
    ],
    "es": [
      "Este camino conduce a un mojón monumental (3,5 m).\r\nMás allá del pasadizo, una vasta ladera de pedregal revela los restos de un avión que se estrelló el 19 de diciembre de 1969."
    ],
    "nl": [
      "Dit pad leidt naar een monumentale cairn (3,5 m).\r\nVoorbij de doorgang onthult een enorme steile helling de overblijfselen van een vliegtuig dat op 19 december 1969 neerstortte."
    ]
  },
