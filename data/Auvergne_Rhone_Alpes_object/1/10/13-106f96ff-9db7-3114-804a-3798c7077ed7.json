  "rdfs:comment": {
    "de": [
      "Juliette und Bérénice, begleitet von ihrem Team aus Freiwilligen im Bürgerdienst, Loïc, Manon, Benjamine, Garance und Lucie, heißen Sie in den Petites Cantines de Vaise herzlich willkommen."
    ],
    "en": [
      "Juliette and Bérénice, accompanied by their team of civic service volunteers, Loïc, Manon, Benjamine, Garance and Lucie, welcome you to the Petites Cantines de Vaise."
    ],
    "it": [
      "Juliette e Bérénice, accompagnate dal loro team di volontari del servizio civile, Loïc, Manon, Benjamine, Garance e Lucie, vi danno il benvenuto alle Petites Cantines de Vaise."
    ],
    "fr": [
      "Juliette et Bérénice, accompagnées de leur équipe de volontaires en service civique, Loïc, Manon, Benjamine, Garance et Lucie, vous accueillent aux Petites Cantines de Vaise."
    ],
    "es": [
      "Juliette y Bérénice, acompañadas por su equipo de voluntarios del servicio cívico, Loïc, Manon, Benjamine, Garance y Lucie, le dan la bienvenida a las Petites Cantines de Vaise."
    ],
    "nl": [
      "Juliette en Bérénice, vergezeld van hun team van vrijwilligers van de burgerdienst, Loïc, Manon, Benjamine, Garance en Lucie, heten u welkom in de Petites Cantines de Vaise."
    ]
