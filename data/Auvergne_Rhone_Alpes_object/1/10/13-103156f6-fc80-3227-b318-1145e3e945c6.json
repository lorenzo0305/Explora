  "rdfs:comment": {
    "de": [
      "Spezialist für Erstflüge mit Gleitschirmen seit 1990. Ein Traum, der für alle von 6 bis 66 Jahren zugänglich ist, ohne jegliche Kenntnisse oder Höhenangst. Fliegen Sie los und entdecken Sie die Magie des freien Fluges im Herzen des Mont-Blanc-Gebiets, auf dem Gelände von Rochebrune in Megève."
    ],
    "en": [
      "Specialist in paragliding tandem flights since 1990. An accessible dream for ages 6 to 66, no experience or fear of heights required. Take to the skies and discover the magic of free flight in the heart of the Mont Blanc region, at the Rochebrune site in Megève."
    ],
    "it": [
      "Specialista in battesimi dell'aria in parapendio dal 1990. Un sogno accessibile dai 6 ai 66 anni, senza alcuna conoscenza preliminare né vertigini: spiccate il volo e scoprite la magia del volo libero nel cuore del Monte Bianco, sul sito di Rochebrune a Megève."
    ],
    "fr": [
      "Spécialiste des baptêmes de l'air en parapente depuis 1990. Un rêve accessible de 6 à 66 ans, sans aucune connaissance ni vertige, envolez-vous et découvrez la magie du vol libre au cœur du pays du Mont-Blanc, sur le site de Rochebrune à Megève."
    ],
    "nl": [
      "Specialist in luchtdoop sinds 1990. Een droom toegankelijk vanaf 7 jaar, zonder enige kennis of vertigo, vliegen weg en ontdek de magie van de vrije vlucht in het hart van het land van de Mont-Blanc op de site van Rochebrune in Megève."
    ],
    "es": [
      "Especialista en bautismos desde 1990. Un sueño accesible a partir de los 7 años, sin ningún conocimiento ni vértigo, vuela y descubre la magia del vuelo libre en el corazón del país del Mont-Blanc en el sitio de Rochebrune en Megève."
    ]
  },
