  "rdfs:comment": {
    "de": [
      "Die Junior Fishing Tour? Pêche au coup lädt begeisterte Jugendliche ein, die Herausforderung anzunehmen und zu versuchen, den Titel des Departementsmeisters zu erringen. Es gibt zwei Alterskategorien, tolle Preise zu gewinnen und ein tolles sportliches Abenteuer am Wasser!"
    ],
    "en": [
      "The Junior Fishing Tour ? Pêche au coup invites young enthusiasts to take up the challenge and try to win the title of departmental champion. Two age categories, great prizes to be won and a great sporting adventure on the water!"
    ],
    "it": [
      "Il Junior Fishing Tour ? Pêche au coup invita i giovani appassionati a raccogliere la sfida e a cercare di vincere il titolo di campione dipartimentale. Due categorie di età, grandi premi in palio e una grande avventura sportiva sull'acqua!"
    ],
    "fr": [
      "Le Junior Fishing Tour – Pêche au coup invite les jeunes passionnés à relever le défi et tenter de décrocher le titre de champion départemental. Deux catégories d’âge, de beaux lots à gagner et une belle aventure sportive au bord de l’eau !"
    ],
    "es": [
      "El Junior Fishing Tour ? Pêche au coup invita a los jóvenes aficionados a aceptar el reto e intentar ganar el título de campeón departamental. Dos categorías de edad, grandes premios y una gran aventura deportiva en el agua"
    ],
    "nl": [
      "De Junior Fishing Tour ? Pêche au coup nodigt jonge enthousiastelingen uit om de uitdaging aan te gaan en te proberen de titel van departementaal kampioen in de wacht te slepen. Twee leeftijdscategorieën, mooie prijzen te winnen en een geweldig sportief avontuur op het water!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Junior fishing tour"
    ]
  },
