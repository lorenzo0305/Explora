  "rdfs:comment": {
    "de": [
      "Die GAEC des Frênes verkauft direkt 100%Bio-Produkte aus der eigenen Landwirtschaft, Bauernhof und der eigenen Verarbeitung. Hier finden Sie Eier, Fleisch, handgemachtes Eis und auch Kartoffeln und Buchweizenmehl."
    ],
    "en": [
      "The GAEC des Frênes farm shop sells all-organic fresh produce and processed foods. Come and try the eggs, meat, craft ice cream, potatoes and buckwheat flour."
    ],
    "it": [
      "Il GAEC des Frênes vende direttamente prodotti 100% biologici provenienti dalla fattoria e dalla trasformazione. Venite a scoprire le uova, la carne, i gelati artigianali e anche le patate e la farina di grano saraceno."
    ],
    "fr": [
      "La GAEC des Frênes vend en direct les produits 100% bio issus de la ferme et de la transformation. Venez découvrir les œufs, la viande, les glaces artisanales et aussi les pommes de terres et la farine de sarrasin."
    ],
    "es": [
      "El GAEC des Frênes vende directamente productos 100% ecológicos procedentes de la explotación y de la transformación. Venga a descubrir los huevos, la carne, los helados artesanales y también las patatas y la harina de trigo sarraceno."
    ],
    "nl": [
      "De GAEC des Frênes verkoopt rechtstreeks 100% biologische producten van de boerderij en van de transformatie. Kom en ontdek de eieren, het vlees, de ambachtelijke ijsjes en ook de aardappelen en het boekweitmeel."
    ]
  },
