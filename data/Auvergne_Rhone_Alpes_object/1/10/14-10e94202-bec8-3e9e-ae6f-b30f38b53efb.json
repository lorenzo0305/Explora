  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/31f017b9-99b8-3d86-98a6-f9777bdd522b",
      "dc:description": {
        "de": [
          "Feinkostladen - Cremmerie, Weine und Spirituosen, Lebensmittel, Obst und Gemüse, regionale Produkte. Im Keller von Crem'hier finden Sie eine große Auswahl an Produkten aus der Region."
        ],
        "en": [
          "Delicatessen - Creamery, wines & spirits, groceries, fruit and vegetables, local produce. La Crem'hier cellar offers a wide selection of local produce."
        ],
        "it": [
          "Delicatessen - Cremeria, vini e liquori, alimentari, frutta e verdura, prodotti locali. La cantina La Crem'hier offre un'ampia gamma di prodotti locali."
        ],
        "fr": [
          "Épicerie fine - Crèmerie, vins & spiritueux, épicerie, fruits et légumes, produits du terroir. Retrouvez à la cave de la Crem'hier un large choix du produits du terroir."
        ],
        "es": [
          "Delicatessen - Cremería, vinos y licores, ultramarinos, frutas y verduras, productos locales. La bodega de La Crem'hier ofrece una amplia gama de productos locales."
        ],
        "nl": [
          "Delicatessen - Creamery, wijnen & sterke dranken, kruidenierswaren, fruit en groenten, streekproducten. De kelder van La Crem biedt een breed scala aan lokale producten."
        ]
      },
