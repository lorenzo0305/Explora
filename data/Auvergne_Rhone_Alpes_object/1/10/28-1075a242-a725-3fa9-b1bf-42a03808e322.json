      "rdfs:comment": {
        "de": [
          "Caroline stellt auf handwerkliche und völlig natürliche Weise Liköre aus Eisenkraut, Thymian, Himbeeren, Ingwer, Erdbeeren, Salbei und Gewürzen... durch Mazeration her: alles in Bailleul! Erhältlich in den Touristeninformationsbüros von Coeur de Flandre!"
        ],
        "en": [
          "Caroline makes, in a traditional way, and entirely natural, liqueurs of verbena, thyme, raspberry, ginger, strawberry, sage and spices... by maceration: all this, in Bailleul! On sale in the tourist information offices of the Heart of Flanders!"
        ],
        "it": [
          "Caroline produce, in modo tradizionale e del tutto naturale, liquori alla verbena, al timo, al lampone, allo zenzero, alla fragola, alla salvia e alle spezie... per macerazione: tutto questo, a Bailleul! In vendita negli uffici di informazione turistica del Coeur de Flandre!"
        ],
        "fr": [
          "Caroline  fabrique, de manière artisanale, et entièrement naturelle, des liqueurs de verveine, thym, framboise, gingembre, fraise, sauge et épices... par macération : le tout, à Bailleul ! en vente dans les bureaux d'information touristique du Coeur de Flandre !"
        ],
        "nl": [
          "Caroline maakt op traditionele en geheel natuurlijke wijze verbena-, tijm-, frambozen-, gember-, aardbei-, salie- en kruidenlikeuren... door maceratie: dit alles in Bailleul! Te koop in de VVV-kantoren van de Coeur de Flandre!"
        ],
        "es": [
          "Caroline elabora, de forma tradicional y totalmente natural, licores de verbena, tomillo, frambuesa, jengibre, fresa, salvia y especias... por maceración: ¡todo ello, en Bailleul! A la venta en las oficinas de turismo del Coeur de Flandre!"
        ]
      },
