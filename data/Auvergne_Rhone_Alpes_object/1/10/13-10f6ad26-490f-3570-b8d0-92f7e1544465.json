  "rdfs:comment": {
    "de": [
      "Hausgemachtes italienisches Eis, Milchshakes, Smoothies, Sorbets ohne Zusatzstoffe, Soda aus der Auvergne, Bio-Fruchtsäfte, Valrhona- oder Weiss-Schokolade und Gebäck am Wochenende."
    ],
    "en": [
      "Homemade Italian-style ice creams, milkshakes, smoothies, additive-free sorbets, soda from Auvergne, organic fruit juices, Valrhona or Weiss chocolates, and pastries at weekends."
    ],
    "it": [
      "Gelati artigianali all'italiana, frullati, smoothies, sorbetti senza additivi, soda d'Alvernia, succhi di frutta biologici, cioccolatini Valrhona o Weiss e pasticcini nel fine settimana."
    ],
    "fr": [
      "Glaces à l'italienne maison, des milkshakes, des smoothies, des sorbets sans additifs, soda auvergnat, jus de fruits bio, des chocolats Valrhona ou Weiss, et des viennoiseries le week-end."
    ],
    "nl": [
      "Huisgemaakt ijs op Italiaanse wijze, milkshakes, smoothies, sorbets zonder toevoegingen, frisdrank uit de Auvergne, biologische vruchtensappen, bonbons van Valrhona of Weiss en gebak in het weekend."
    ],
    "es": [
      "Helados artesanales a la italiana, batidos, smoothies, sorbetes sin aditivos, soda de Auvernia, zumos de frutas ecológicas, chocolates Valrhona o Weiss y bollería los fines de semana."
    ]
  },
  "rdfs:label": {
