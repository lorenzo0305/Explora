  "rdfs:comment": {
    "de": [
      "Willkommen im Wilden Westen im Herzen der Drôme.\r\nHier wird getanzt, gelacht und es werden einzigartige Erlebnisse geboten.\r\nVom 1. Moped-Festival bis zum Barrel-Racing-Rennen garantieren wir Ihnen die ungewöhnlichsten Momente."
    ],
    "en": [
      "Welcome to the Wild West in the heart of the Drôme.\r\nA bar and a festive restaurant, here we dance, laugh and enjoy unique experiences.\r\nFrom the 1st Mobylette Festival to Barrel Racing, we guarantee you the most unusual moments."
    ],
    "it": [
      "Benvenuti nel Far West nel cuore della Drôme.\r\nBar, ristorante festivo, qui si balla, si ride e si vivono esperienze uniche.\r\nVi garantiamo i momenti più insoliti."
    ],
    "fr": [
      "Bienvenue au Far West en plein coeur de la Drôme. \r\nBar, restaurant festif, ici on danse, on rit, et on vit des expériences uniques. \r\nOn vous assure des moments les plus insolites."
    ],
    "nl": [
      "Welkom in het Wilde Westen in het hart van de Drôme.\r\nBar, feestelijk restaurant, hier kun je dansen, lachen en genieten van unieke ervaringen.\r\nVan het eerste brommerfestival tot de Barrel Racing race, wij garanderen u de meest ongewone momenten."
    ],
    "es": [
      "Bienvenido al Salvaje Oeste en el corazón de la Drôme.\r\nBar, restaurante festivo, aquí bailamos, reímos y vivimos experiencias únicas.\r\nLe garantizamos los momentos más insólitos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant le Saloon de Jean Louis"
    ]
  },
