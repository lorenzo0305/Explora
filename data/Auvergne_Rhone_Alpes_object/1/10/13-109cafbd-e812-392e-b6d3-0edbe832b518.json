  "rdfs:comment": {
    "de": [
      "Als Songwriter, Klassiker und Punk auf seine Weise bietet Pascal Mary eine Show an der Grenze zwischen Chanson und Stand-up-Comedy."
    ],
    "en": [
      "A songwriter, classicist and punk in his own way, Pascal Mary's show straddles the border between chanson and stand-up."
    ],
    "it": [
      "Cantautore, classicista e punk a modo suo, lo spettacolo di Pascal Mary si colloca a cavallo tra chanson e stand-up."
    ],
    "fr": [
      "Auteur-compositeur, classique et punk à sa manière, Pascal Mary propose un spectacle à la frontière de la chanson et du stand-up."
    ],
