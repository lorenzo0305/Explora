  "rdfs:comment": {
    "de": [
      "Das Restaurant \"l'Auberge de la Devinière\", das Chens-sur-Léman gelegt ist, schlägt Ihnen vor, authentische Gerichte und Jahreszeit im Saal zu kosten oder der terrassenförmig ist.\r\nDieses Restaurant ist ein Glied der Akademie der Künsten des Tisches"
    ],
    "en": [
      "The Restaurant \"l'Auberge de la Devinière\", situated to Chens-sur-Léman suggests you tasting authentic dishes and season.\r\nThis restaurant is a member of the Academy of tableware"
    ],
    "it": [
      "L'Auberge de la Devinière, situato a Chens-sur-Léman, offre piatti autentici e di stagione nella sala da pranzo o sulla terrazza."
    ],
    "fr": [
      "L'auberge de la Devinière, située à Chens-sur-Léman vous propose de déguster des plats authentiques et de saison en salle ou en terrasse."
    ],
    "es": [
      "El Auberge de la Devinière, situado en Chens-sur-Léman, ofrece platos auténticos y de temporada en el comedor o en la terraza."
    ],
    "nl": [
      "De Auberge de la Devinière, gelegen in Chens-sur-Léman, biedt authentieke en seizoensgebonden gerechten in de eetzaal of op het terras."
    ]
  },
