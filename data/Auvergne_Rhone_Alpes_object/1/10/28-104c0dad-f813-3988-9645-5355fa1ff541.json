  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0876b2c5-a8d1-3465-9262-6ea25dc8bd2c",
      "dc:description": {
        "de": [
          "In Mers-les-Bains. Le Cristal bietet Take-away, Sandwiches, Gebäck, Bar, Tabak, Presse, Wifi\n20 Gedecke\nGanzjährig geöffnet, von 6:30 bis 20:00 Uhr, samstags von 8:00 bis 18:00 Uhr. Sonntags geschlossen."
        ],
        "en": [
          "In Mers-les-Bains. Le Cristal offers takeaways, sandwiches, pastries, bar, tobacco, newspapers, WiFi\n20 covers\nOpen all year round, 6.30am to 8pm, Saturday 8am to 6pm. Closed on Sundays."
        ],
        "it": [
          "A Mers-les-Bains. Le Cristal offre piatti da asporto, panini, pasticceria, bar, tabaccheria, giornali, connessione internet Wi-Fi\n20 coperti\nAperto tutto l'anno, dalle 6.30 alle 20.00, sabato dalle 8.00 alle 18.00. Chiuso la domenica."
        ],
        "fr": [
          "A Mers-les-Bains. Le Cristal propose vente à emporter, sandwichs, viennoiseries, Bar, tabac, presse, Wifi\n20 couverts\nOuvert toute l'année, de 6h30 à 20h, le samedi de 8h à 18h. Fermé le dimanche."
        ],
        "nl": [
          "In Mers-les-Bains. Le Cristal biedt afhaalgerechten, broodjes, gebak, bar, tabakswinkel, krant, Wi-Fi-internettoegang\n20 couverts\nHet hele jaar geopend van 6.30 tot 20.00 uur, zaterdag van 8.00 tot 18.00 uur. Gesloten op zondag."
        ],
        "es": [
          "En Mers-les-Bains. Le Cristal ofrece comida para llevar, bocadillos, bollería, bar, estanco, prensa, acceso Wi-Fi a Internet\n20 cubiertos\nAbierto todo el año, de 6h30 a 20h00, sábados de 8h00 a 18h00. Domingos cerrado."
        ]
      },
