  "rdfs:comment": {
    "de": [
      "Philippe Girardon, ein „bester Arbeiter Frankreichs“, wählt für seine naturnahe und dabei raffinierte Küche die besten lokalen Produkte, Kräuter und Früchte aus dem Garten aus. Der 3 Hektar große Park der Domaine ist ein wunderschöner Rahmen für das Herrenhaus aus dem 18. Jahrhundert."
    ],
    "en": [
      "The gastronomic restaurant serves cuisine with subtle flavors. Philippe Girardon, with the prestigious \"Meilleur Ouvrier de France\" title, carefully chooses the best local produce, plus fresh herbs and fruit from the garden to make great meals in harmony with nature."
    ],
    "it": [
      "Philippe Girardon, Meilleur Ouvrier de France, seleziona i migliori prodotti locali, le erbe e i frutti dei giardini per una cucina vicina alla natura e raffinata. Il parco di 3 ettari del Domaine è uno scrigno di gioielli per questo maniero del XVIII secolo."
    ],
    "fr": [
      "Philippe Girardon, Meilleur Ouvrier de France, sélectionne les meilleurs produits locaux, les herbes et fruits des jardins pour une cuisine proche de la nature, tout en raffinement. Le parc de 3 hectares du Domaine est un écrin pour ce manoir du 18ème."
    ],
    "nl": [
      "Philippe Girardon, Meilleur Ouvrier de France, selecteert de beste lokale producten, kruiden en vruchten uit de tuinen voor een keuken die dicht bij de natuur staat en verfijnd is. Het 3 hectare grote park van het Domaine is een juweeltje voor dit 18e eeuwse landhuis."
    ],
    "es": [
      "Philippe Girardon, Meilleur Ouvrier de France, selecciona los mejores productos locales, hierbas y frutas de los jardines para una cocina cercana a la naturaleza y refinada. El parque de 3 hectáreas del Domaine es una joya para esta mansión del siglo XVIII."
    ]
  },
