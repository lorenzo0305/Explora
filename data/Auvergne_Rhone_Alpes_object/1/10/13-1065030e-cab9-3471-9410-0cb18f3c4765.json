  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise auf dem Pfad durch den Erica-Wald!\r\nDieser spielerische und erholsame Weg führt Sie zur Entdeckung dieses Waldes mit hohem Umweltwert, der an das Dorf La Norma grenzt."
    ],
    "en": [
      "Discover the Erica forest trail!\r\nThis fun and rejuvenating itinerary takes you on a journey of discovery through this forest of high environmental value bordering the village of La Norma."
    ],
    "it": [
      "Scoprite il sentiero della foresta di Erica!\r\nQuesto percorso divertente e rigenerante vi porterà alla scoperta di questa foresta di alto valore ambientale, che confina con il villaggio di La Norma."
    ],
    "fr": [
      "Partez à la découverte du sentier de la forêt d'Erica ! \r\nCet itinéraire ludique et de ressourcement vous emmène à la découverte de cette forêt à haute valeur environnementale qui borde le village de la Norma."
    ],
    "nl": [
      "Ontdek het Erica bospad!\r\nDit leuke en verjongende pad neemt je mee op een ontdekkingsreis door dit bos met hoge ecologische waarde, dat grenst aan het dorp La Norma."
    ],
    "es": [
      "Descubra el sendero del bosque de Erica\r\nEste divertido y rejuvenecedor sendero te lleva a descubrir este bosque de alto valor medioambiental, que bordea el pueblo de La Norma."
    ]
  },
  "rdfs:label": {
    "en": [
      "Erica forest path"
    ],
    "fr": [
      "Sentier de la forêt d'Erica"
    ],
    "nl": [
      "Erica bospad"
    ]
  },
