  "rdfs:comment": {
    "de": [
      "Restaurant, Bar und Feinkostgeschäft. Cuisine \"Grand-Mère\", Rotisserie, Buffet à volonté mittags und abends. Eine komplett \"hausgemachte\" Küche vom Brot bis zum Käse.\r\nVon den Lesern der Zeitung Le Progrès zum Lieblingsrestaurant der Einwohner von Roannais gewählt."
    ],
    "en": [
      "Restaurant, bar and caterer. Grand-Mère\" cuisine, rotisserie, all-you-can-eat buffet for lunch and dinner. Entirely home-cooked, from bread to cheese.\r\nVoted Roannais' favorite restaurant by readers of Le Progrès newspaper."
    ],
    "it": [
      "Ristorante, bar e catering. Cucina della nonna, rosticceria, buffet a volontà per pranzo e cena. Cucina interamente casalinga, dal pane al formaggio.\r\nEletto ristorante preferito di Roannais dai lettori del quotidiano Le Progrès."
    ],
    "fr": [
      "Restaurant, bar et traiteur. Cuisine \"Grand-Mère\", rôtisserie, buffet à volonté midi et soir. Une cuisine entièrement \"fait maison\" du pain jusqu'au fromages.\r\nÉlu restaurant préféré des Roannais par les lecteurs du journal Le Progrès."
    ],
    "es": [
      "Restaurante, bar y servicio de catering. Cocina al estilo de la abuela, asador, buffet libre para almuerzos y cenas. Todo casero, desde el pan hasta el queso.\r\nElegido restaurante favorito de Roannais por los lectores del periódico Le Progrès."
    ],
    "nl": [
      "Restaurant, bar en traiteur. Koken op grootmoeders wijze, rotisserie, all-you-can-eat buffet voor lunch en diner. Huisgemaakt, van brood tot kaas.\r\nUitgeroepen tot het favoriete restaurant van Roannais door de lezers van de krant Le Progrès."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Demain Charette"
    ]
  },
