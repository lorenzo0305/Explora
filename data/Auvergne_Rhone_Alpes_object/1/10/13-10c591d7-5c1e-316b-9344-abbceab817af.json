  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom historischen Zentrum von Chambéry, dem Carré Curial und der Nationalbühne André Malraux entfernt, bieten Ihnen Michel Naas und sein Team eine regionale und saisonale Küche. Maitre Restaurateur seit 2013."
    ],
    "en": [
      "Located only a step or two away from Chambéry's historical centre, the Savoyard combines tradition and creativity in modern and friendly surroundings."
    ],
    "it": [
      "A due passi dal centro storico di Chambéry, dal Carré Curial e dal Palcoscenico Nazionale André Malraux, Michel Naas e il suo team vi propongono una cucina locale e di stagione. Maestro ristoratore dal 2013."
    ],
    "fr": [
      "À deux pas du centre historique de Chambéry, du Carré Curial et de la Scène nationale André Malraux, Michel Naas et son équipe vous propose une cuisine du terroir et de saison. Maitre restaurateur depuis 2013."
    ],
    "nl": [
      "Op een steenworp afstand van het historische centrum van Chambéry, het Carré Curial en het André Malraux National Stage bieden Michel Naas en zijn team u een lokale en seizoensgebonden keuken. Meester restaurateur sinds 2013."
    ],
    "es": [
      "A dos pasos del centro histórico de Chambéry, del Carré Curial y del Escenario Nacional André Malraux, Michel Naas y su equipo le ofrecen una cocina local y de temporada. Maestro restaurador desde 2013."
    ]
  },
