  "rdfs:comment": {
    "de": [
      "Ein Restaurant mit moderner und gemütlicher Einrichtung gegenüber dem Yachthafen. Der Küchenchef kocht mit frischen Produkten. In der Saison werden Sie hier Muscheln aus Dünkirchen probieren! Spezialitäten: Rippe am Knochen, Rindersteak, Kabeljau. Kindermenü."
    ],
    "en": [
      "A restaurant with a modern and warm decor located in front of the marina. The chef cooks with fresh products. You will taste the mussels of Dunkerque in season! Specialities : Ribs on the bone, beef steak, cod. Children's menu."
    ],
    "it": [
      "Ristorante dall'arredamento moderno e accogliente situato di fronte al porto turistico. Lo chef cucina con prodotti freschi. Potrete gustare le cozze di Dunkerque in stagione! Specialità: braciola con l'osso, bistecca di manzo, merluzzo. Menu per bambini."
    ],
    "fr": [
      "Un restaurant au décor moderne et chaleureux situé face au port de plaisance. Le chef cuisine à base de produits frais. Vous y dégusterez les moules de Dunkerque en saison ! Les spécialités : Côte à l'os, pavé de bœuf, cabillaud. Menu enfant."
    ],
    "es": [
      "Restaurante con una decoración moderna y cálida situado frente al puerto deportivo. El chef cocina con productos frescos. Podrá degustar los mejillones de Dunkerque en temporada Especialidades: chuleta con hueso, filete de ternera, bacalao. Menú infantil."
    ],
    "nl": [
      "Een restaurant met een moderne en warme inrichting gelegen tegenover de jachthaven. De chef-kok kookt met verse producten. U kunt genieten van Duinkse mosselen in het seizoen! Specialiteiten: kotelet, biefstuk, kabeljauw. Kindermenu."
    ]
  },
  "rdfs:label": {
