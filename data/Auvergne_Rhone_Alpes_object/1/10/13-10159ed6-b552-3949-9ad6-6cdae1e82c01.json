  "rdfs:comment": {
    "de": [
      "Jahrhundert, Parkettboden, Kamin und hohe Decken, die mit Gemälden dekoriert sind, die die Vorfahren der Familie darstellen. Terrasse und Garten für sonnige Tage."
    ],
    "en": [
      "Set in an 18th century salon with hardwoon floors, fireplace, and high decorated ceilings and portraits of the family's ancestors. On sunny days, there is a terrace in the garden."
    ],
    "it": [
      "Soggiorno del XVIII secolo, pavimento in parquet, camino e soffitti alti decorati con dipinti che rappresentano gli antenati della famiglia. Terrazza e giardino per il bel tempo."
    ],
    "fr": [
      "Salon XVIIIe siècle, parquet, cheminée et hauts plafonds décorés des tableaux représentant les ancêtres de la famille. Terrasse et jardin pour les beaux jours."
    ],
    "nl": [
      "Woonkamer uit de 18e eeuw, parketvloer, open haard en hoge plafonds versierd met schilderijen die de voorouders van de familie voorstellen. Terras en tuin voor mooi weer."
    ],
    "es": [
      "Salón del siglo XVIII con parquet, chimenea y techos altos decorados con cuadros que representan a los antepasados de la familia. Terraza y jardín para el buen tiempo."
    ]
  },
  "rdfs:label": {
    "en": [
