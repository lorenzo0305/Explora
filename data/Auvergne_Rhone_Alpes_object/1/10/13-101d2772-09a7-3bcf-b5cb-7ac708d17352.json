  "rdfs:comment": {
    "de": [
      "Entdecken Sie viele traditionelle und ganz neue Gesellschaftsspiele! Kommen Sie allein oder in Begleitung, mit der Familie oder mit Freunden. Für alle Altersgruppen!\r\nGemeinsames Buffet."
    ],
    "en": [
      "Come and discover a wide range of board games, traditional or very recent! Come alone or with friends, family or friends. For all ages!\r\nShared buffet."
    ],
    "it": [
      "Venite a scoprire tutta una serie di giochi da tavolo, sia tradizionali che nuovissimi! Venite da soli o in compagnia, in famiglia o con gli amici. Per tutte le età!\r\nBuffet condiviso."
    ],
    "fr": [
      "Venez découvrir plein de jeux de société, traditionnels ou très récents ! venez seul(e) ou accompagné(e), en famille, entre copains. Pour tous les âges !\r\nBuffet partagé."
    ],
    "es": [
      "Venga a descubrir toda una serie de juegos de mesa, tanto tradicionales como inéditos! Venga solo o con amigos, en familia o entre amigos. ¡Para todas las edades!\r\nBuffet compartido."
    ],
    "nl": [
      "Kom en ontdek een heleboel bordspellen, zowel traditionele als gloednieuwe! Kom alleen of met vrienden, familie of vriendinnen. Voor alle leeftijden!\r\nGezamenlijk buffet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jouons ensemble !"
    ]
  },
