  "rdfs:comment": {
    "de": [
      "Im Rahmen des Bibliotheksfrühlings 2026 laden die Bibliothèque départementale de l'Allier und die Bibliothek von Ebreuil Sie ein, \"Et Pourtant elle tourne!\" der Kompanie Euphorik Mouvance zu entdecken."
    ],
    "en": [
      "As part of Printemps des Bibliothèques 2026, the Bibliothèque Départementale de l'Allier and the Ebreuil library invite you to discover \"Et Pourtant elle tourne!\" by the Euphorik Mouvance company."
    ],
    "it": [
      "Nell'ambito del Printemps des Bibliothèques 2026, la biblioteca dipartimentale di Allier e la biblioteca di Ebreuil vi invitano a scoprire \"Et Pourtant elle tourne!\" della compagnia Euphorik Mouvance."
    ],
    "fr": [
      "Dans le cadre du Printemps des Bibliothèques 2026, la bibliothèque départementale de l'Allier et la bibliothèque d'Ebreuil vous invite à découvrir \"Et Pourtant elle tourne !\" de la compagnie Euphorik Mouvance."
    ],
    "nl": [
      "In het kader van Printemps des Bibliothèques 2026 nodigen de departementale bibliotheek van Allier en de bibliotheek van Ebreuil je uit om \"Et Pourtant elle tourne! van het gezelschap Euphorik Mouvance te ontdekken."
    ],
    "es": [
      "En el marco de Printemps des Bibliothèques 2026, la biblioteca departamental de Allier y la biblioteca de Ebreuil le invitan a descubrir \"Et Pourtant elle tourne! de la compañía Euphorik Mouvance."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Et pourtant elle tourne !"
    ]
  },
