  "rdfs:comment": {
    "de": [
      "Möchten Sie besser mit Stress, Ängsten, unangenehmen Gefühlen oder auch mit Schlafproblemen und chronischen Schmerzen umgehen können?\r\nDie Sophrologie begleitet Sie und hilft Ihnen, die beste Version Ihrer selbst zu werden."
    ],
    "en": [
      "Would you like to better manage stress, anxiety, unpleasant emotions, sleep problems or chronic pain?\r\nSophrology can help you become the best version of yourself."
    ],
    "it": [
      "Volete affrontare meglio lo stress, l'ansia, le emozioni spiacevoli, i problemi di sonno e il dolore cronico?\r\nLa sofrologia può aiutarvi a diventare la versione migliore di voi stessi."
    ],
    "fr": [
      "Vous souhaitez mieux gérer le stress, les angoisses, les émotions désagréables ou encore les problèmes de sommeil et les douleurs chroniques ?\r\nLa sophrologie vous accompagne pour vous aider à devenir la meilleure version de vous-même."
    ],
    "es": [
      "¿Le gustaría afrontar mejor el estrés, la ansiedad, las emociones desagradables, los problemas de sueño y el dolor crónico?\r\nLa Sofrología puede ayudarte a convertirte en la mejor versión de ti mismo."
    ],
    "nl": [
      "Wil je beter omgaan met stress, angst, nare emoties, slaapproblemen en chronische pijn?\r\nSophrologie kan je helpen om de beste versie van jezelf te worden."
    ]
  },
  "rdfs:label": {
