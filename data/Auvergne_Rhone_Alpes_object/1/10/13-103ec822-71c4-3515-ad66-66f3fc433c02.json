  "rdfs:comment": {
    "de": [
      "L'ilot, les halles gourmandes, soll ein neuer Lebensraum in der Gemeinde sein, in dem alle Generationen zusammenkommen können und in dem Geselligkeit, Abschalten und \"gutes Essen\" vereint werden."
    ],
    "en": [
      "L'ilot, les halles gourmandes, is intended to be a new living space in the commune, where all generations can come together and where conviviality, disconnection and \"good eating\" come together."
    ],
    "it": [
      "L'ilot, les halles gourmandes, vuole essere un nuovo spazio di vita nel comune, dove tutte le generazioni possono incontrarsi e dove convivialità, relax e \"mangiare bene\" si fondono."
    ],
    "fr": [
      "L'ilot, les halles gourmandes, a pour vocation d'être un nouvel espace de vie sur la commune où toutes les générations peuvent se retrouver et où la convivialité, la déconnection et le \"bien manger\" sont réunis."
    ],
    "es": [
      "L'ilot, les halles gourmandes, pretende ser un nuevo espacio de vida en la comuna donde puedan reunirse todas las generaciones y donde confluyan la convivencia, la relajación y el \"comer bien\"."
    ],
    "nl": [
      "L'ilot, les halles gourmandes, is bedoeld als een nieuwe leefruimte in de gemeente waar alle generaties elkaar kunnen ontmoeten en waar gezelligheid, ontspanning en 'lekker eten' samenkomen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ilot halles gourmandes"
    ]
  },
