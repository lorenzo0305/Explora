  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet einen Ausblick auf den weiten Horizont über das Massiv la Masse. Der Blick auf die Speisekarte ist Appetitregend. Am Mittag gibt es verschiedene Salate, Grillgerichte, frische Nudeln, hausgemachte Pizza oder ein Imbiss."
    ],
    "en": [
      "Come and relax on our panoramic terrace where you can choose from mixed salads, grilled meat and fresh pasta dishes, and freshly made desserts."
    ],
    "it": [
      "La terrazza panoramica e il nostro bar-ristorante offrono un ambiente piacevole e rilassante. A pranzo, il menu di insalate e antipasti vari, carni alla griglia, pasta fresca e dolci fatti in casa invita a tornare per il pranzo."
    ],
    "fr": [
      "La terrasse panoramique et notre bar / restaurant offrent un cadre agréable et reposant. A midi, la carte composée de salades et entrées diverses, grillades, pâtes fraîches et desserts maisons, incitent le retour pour le déjeuner."
    ],
    "es": [
      "La terraza panorámica y nuestro bar/restaurante ofrecen un entorno agradable y relajante. A la hora del almuerzo, la carta de ensaladas y entrantes variados, carnes a la parrilla, pasta fresca y postres caseros invita a volver para comer."
    ],
    "nl": [
      "Dit restaurant doet u watertanden en biedt een prachtig uitzicht op het massief van La Masse. Geniet tijdens de lunch van diverse salades, gegrild vlees, verse pasta, huisbereide pizza's en snacks."
    ]
  },
