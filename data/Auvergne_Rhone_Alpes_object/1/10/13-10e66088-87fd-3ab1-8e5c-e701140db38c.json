  "rdfs:comment": {
    "de": [
      "Jeff de Bruges, Chocolatier Cacaoculteur, empfängt Sie in einem Schmuckkästchen voller Gaumenfreuden und bietet Ihnen immer wieder neue Geschenkideen: knusprige Pralinen, intensive Ganaches, Biskuitschokolade, Marshmallowbären, Schokoladentafeln..."
    ],
    "en": [
      "Jeff de Bruges, chocolatier cacaoculteur, welcomes you to a bosky bower of gourmet delights, with a constantly changing range of gift ideas: crunchy pralines, intense ganaches, cookie chocolates, gummy bears, chocolate bars..."
    ],
    "it": [
      "Jeff de Bruges, il cioccolatiere produttore di cacao, vi accoglie in un tesoro di golosità e vi offre una gamma di idee regalo in continua evoluzione: praline croccanti, ganache intense, cioccolatini biscottosi, orsetti gommosi, tavolette di cioccolato..."
    ],
    "fr": [
      "Jeff de Bruges, chocolatier cacaoculteur vous accueille dans un écrin de gourmandise et vous propose des idées cadeaux sans cesse renouvelées : pralinés croustillants, ganaches intenses, chocolats biscuités, ours en guimauve, tablettes de chocolat..."
    ],
    "es": [
      "Jeff de Bruges, el chocolatero que cultiva el cacao, le da la bienvenida a un tesoro de golosinas gourmet y le ofrece una gama de ideas de regalo en constante evolución: pralinés crujientes, ganaches intensos, bombones de biscuit, ositos de gominola, tabletas de chocolate..."
    ],
    "nl": [
      "Jeff de Bruges, de chocolatier uit de cacaoteelt, verwelkomt je in een schatkamer van lekkernijen en biedt je een steeds wisselend assortiment geschenkideeën: knapperige pralines, intense ganaches, koekjespralines, gummibeertjes, chocoladerepen..."
    ]
  },
  "rdfs:label": {
