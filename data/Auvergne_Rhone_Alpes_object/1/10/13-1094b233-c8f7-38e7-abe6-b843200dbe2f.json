  "rdfs:comment": {
    "de": [
      "Unser Hotel liegt auf halbem Weg zwischen Romans und Valence, 3 Minuten zu Fuß vom Bahnhof Valence TGV entfernt. Es verfügt über 80 klimatisierte, moderne Zimmer mit schillernden Farben, die von Bernard Cathelin (Maler aus der Drôme) inspiriert sind, und bietet gesellige Räume."
    ],
    "en": [
      "Located halfway between Romans and Valence, just a 3-minute walk from the Valence TGV train station, our hotel features 80 air-conditioned, modern rooms in shimmering colors inspired by Bernard Cathelin (a painter from the Drôme region), and convivial spaces."
    ],
    "it": [
      "Situato a metà strada tra Romans e Valence, a 3 minuti a piedi dalla stazione TGV di Valence, il nostro hotel dispone di 80 camere climatizzate e moderne con colori scintillanti ispirati a Bernard Cathelin (pittore della Drôme) e offre spazi accoglienti."
    ],
    "fr": [
      "Situé à mi-chemin entre Romans et Valence, à 3 minutes à pied de la Gare Valence TGV, notre hôtel dispose de 80 chambres climatisées, modernes, aux couleurs chatoyantes inspirées par Bernard Cathelin (peintre Drômois) et propose des espaces conviviaux."
    ],
    "es": [
      "Situado a medio camino entre Romans y Valence, a 3 minutos a pie de la estación de tren TGV de Valence, nuestro hotel dispone de 80 habitaciones climatizadas y modernas con colores brillantes inspirados en Bernard Cathelin (pintor de la Drôme) y ofrece espacios acogedores."
    ],
    "nl": [
      "Ons hotel ligt halverwege Rome en Valence, op slechts 3 minuten lopen van het TGV-station van Valence. Het heeft 80 moderne kamers met airconditioning in glinsterende kleuren, geïnspireerd op Bernard Cathelin (een schilder uit de Drôme) en biedt vriendelijke ruimtes."
    ]
  },
