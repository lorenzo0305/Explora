  "rdfs:comment": {
    "de": [
      "Theaterstück von Les Films du Vivarais, von und mit Augustin Dorne. Dauer: 1,5 Stunden - Für alle Zuschauer ab 6 Jahren. Eine lustig-romantische Reise, bei der die Selbstironie für diesen Romeo der Sandkästen ausschlaggebend ist."
    ],
    "en": [
      "Play by Les Films du Vivarais, by Augustin Dorne. Running time: 1:30 hrs. - For all ages 6 and up. An amusingly romantic journey in which self-deprecation is the watchword for this sandbox Romeo."
    ],
    "it": [
      "Spettacolo di Les Films du Vivarais, di Augustin Dorne. Durata: 1 ora - Per tutti a partire dai 6 anni. Un viaggio romantico ed esilarante in cui l'autoironia è all'ordine del giorno per questo Romeo di sabbia."
    ],
    "fr": [
      "Pièce par Les Films du Vivarais, de et par Augustin Dorne. Durée : 1h30 - Tout public à partir de 6 ans. Un voyage drôlement romantique où l’autodérision fera foi pour ce Roméo des bacs à sable."
    ],
    "nl": [
      "Toneelstuk van Les Films du Vivarais, door Augustin Dorne. Speelduur: 1 uur - Voor alle leeftijden vanaf 6 jaar. Een hilarische romantische reis waarin zelfspot aan de orde van de dag is voor deze zandbak Romeo."
    ],
    "es": [
      "Obra de Les Films du Vivarais, de Augustin Dorne. Duración: 1 hora y media - Para todos los públicos a partir de 6 años. Un viaje hilarantemente romántico en el que la burla de sí mismo está a la orden del día para este Romeo de cajón de arena."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre du Mayapo - Pour le meilleur et pour le pire"
    ]
  },
