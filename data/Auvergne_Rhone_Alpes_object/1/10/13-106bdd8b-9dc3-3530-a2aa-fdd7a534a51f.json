  "rdfs:comment": {
    "de": [
      "Seit 1899 in Familienbesitz. Wir heißen Sie in einem großen Speisesaal willkommen und bieten Ihnen eine traditionelle Küche, die mit lokalen Produkten zubereitet wird. Tagesmenü oder à la carte. Pauschale für Kurgäste. Schattige Terrasse auf der Kanalseite."
    ],
    "en": [
      "A family property since 1899. We welcome you to our large restaurant to enjoy traditional cuisine using local produce. Menu of the day or à la carte. Package for spa visitors. Shaded terrace on the canal side."
    ],
    "it": [
      "Struttura a conduzione familiare dal 1899. Vi accogliamo in un'ampia sala ristorante per gustare la cucina locale. Menu del giorno o à la carte. Menù dietetici. Ampia sala da pranzo climatizzata o terrazza ombreggiata sul canale."
    ],
    "fr": [
      "Propriété familiale depuis 1899. Nous vous accueillons dans une grande salle de restaurant pour déguster une cuisine locale. Menu du jour ou à la carte. Menus diététiques. Grande salle climatisée ou terrasse ombragée côté canal."
    ],
    "es": [
      "Propiedad familiar desde 1899. Le damos la bienvenida en una amplia sala de restaurante para disfrutar de la cocina local. Menú del día o a la carta. Menús dietéticos. Amplio comedor climatizado o terraza sombreada junto al canal."
    ],
    "nl": [
      "Een familiebedrijf sinds 1899. We verwelkomen je in ons grote restaurant om te genieten van een traditionele keuken met lokale producten. Dagmenu of à la carte. Arrangement voor kuurgasten. Schaduwrijk terras aan het kanaal."
    ]
  },
