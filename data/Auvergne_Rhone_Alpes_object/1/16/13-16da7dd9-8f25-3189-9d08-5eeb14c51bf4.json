  "rdfs:comment": {
    "de": [
      "Harut Yekmalyan, ein vielseitiger Künstler, hat das hübsche Dorf Châtel-Montagne als Wohn- und Arbeitsort gewählt. Seine monumentalen Skulpturen ziehen das Auge an und verblüffen in diesem kleinen Dorf in den Montagne Bourbonnaise.\r\n\r\nBesichtigung des Ateliers nach Vereinbarung."
    ],
    "en": [
      "Harut Yekmalyan, multiple artist, has chosen the pretty village of Châtel-Montagne to live and work. His monumental sculptures catch the eye and astonish in this small village of the Bourbonnaise Mountain.\r\n\r\nVisit of the workshop by appointment."
    ],
    "it": [
      "Harut Yekmalyan, artista poliedrico, ha scelto il grazioso villaggio di Châtel-Montagne per vivere e lavorare. Le sue sculture monumentali attirano lo sguardo e stupiscono in questo piccolo villaggio della Montagne Bourbonnaise.\r\n\r\nVisita del laboratorio su appuntamento."
    ],
    "fr": [
      "Harut Yekmalyan, artiste multiple, a choisi le joli village de Châtel-Montagne pour vivre et travailler. Ses sculptures monumentales attire l'oeil et étonne dans ce petit village de la Montagne Bourbonnaise.\r\n\r\nVisite de l'atelier sur rendez-vous."
    ],
    "nl": [
      "Harut Yekmalyan, een veelzijdig kunstenaar, heeft het mooie dorp Châtel-Montagne gekozen om te wonen en te werken. Zijn monumentale sculpturen trekken de aandacht en verbazen in dit kleine dorp van de Montagne Bourbonnaise.\r\n\r\nBezoek de studio op afspraak."
    ],
    "es": [
      "Harut Yekmalyan, artista polifacético, ha elegido el bonito pueblo de Châtel-Montagne para vivir y trabajar. Sus esculturas monumentales atraen la mirada y sorprenden en este pequeño pueblo de la Montaña Bourbonnaise.\r\n\r\nVisita del taller con cita previa."
    ]
  },
