  "rdfs:comment": {
    "de": [
      "Dieses charmante Chalet liegt auf den Höhen von Saint Sorlin d'Arves am Fuße der Pisten und bietet Ihnen allen Komfort für eine gemütliche, heimelige und familiäre Auszeit."
    ],
    "en": [
      "This charming chalet, nestled in the heights of Saint Sorlin d'Arves, at the foot of the slopes, offers you all the comforts for a warm and cosy family break."
    ],
    "it": [
      "Questo affascinante chalet, situato sulle alture di Saint Sorlin d'Arves, ai piedi delle piste, vi offre tutto il comfort necessario per una vacanza calda, accogliente e familiare."
    ],
    "fr": [
      "Ce Chalet de charme, niché sur les hauteurs de Saint Sorlin d’Arves, au pied des pistes, vous offre tout le confort pour une parenthèse chaleureuse, cosy et familiale."
    ],
    "es": [
      "Este encantador chalet, enclavado en las alturas de Saint Sorlin d'Arves, a pie de pistas, le ofrece todo el confort necesario para una escapada cálida, acogedora y familiar."
    ],
    "nl": [
      "Deze aangename chalet, in de heuvels van Saint Sorlin d'Arves, aan de voet van de pistes, biedt je alle comfort voor een knusse en gezellige gezinsvakantie."
    ]
  },
