  "rdfs:comment": {
    "de": [
      "Das Patchouli-Café ist ein handwerklich geführter Sandwichladen, eine Konditorei und ein Coffeeshop. Alle unsere Brot- und Belagsprodukte werden von Hand hergestellt. Wir befinden uns im Herzen von Vichy in der 2 rue Burnol in der Nähe des Parc des Sources und freuen uns auf Ihren Besuch."
    ],
    "en": [
      "Le Patchouli café is an artisanal sandwich, pastry and coffe shop. All our breads and fillings are made by hand. Located in the heart of Vichy at 2 rue Burnol, near the Parc des Sources, we look forward to welcoming you."
    ],
    "it": [
      "Il caffè Le Patchouli è una paninoteca, pasticceria e caffetteria tradizionale. Tutti i nostri pani e le nostre farciture sono fatti a mano. Situato nel cuore di Vichy, al 2 di rue Burnol, vicino al Parc des Sources, saremo lieti di accogliervi."
    ],
    "fr": [
      "Le Patchouli café est une sandwicherie, pâtisserie et coffe shop artisanale. Tous nos produits pains et garnitures sont élaborés manuellement. Situé en plein cœur de Vichy au 2 rue Burnol à proximité du parc des sources, nous vous attendons avec plaisir."
    ],
    "nl": [
      "Le Patchouli café is een traditionele broodjes-, banket- en koffiezaak. Al ons brood en beleg wordt met de hand gemaakt. Gelegen in het hart van Vichy op 2 rue Burnol vlakbij het Parc des Sources, verwelkomen we je graag."
    ],
    "es": [
      "Le Patchouli café es una tienda tradicional de bocadillos, pasteles y café. Todos nuestros panes y rellenos están hechos a mano. Le esperamos en el corazón de Vichy, en el número 2 de la calle Burnol, cerca del Parque de las Fuentes."
    ]
  },
  "rdfs:label": {
