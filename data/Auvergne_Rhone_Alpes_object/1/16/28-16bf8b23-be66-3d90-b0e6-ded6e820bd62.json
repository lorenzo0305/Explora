  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fb5d0d40-2b47-3732-b49c-ebfb878f6cd7",
      "dc:description": {
        "de": [
          "Angebotene Aktivitäten: Praktika - Reiten in der Reithalle oder im Freien - Spaziergänge - begleitete Wanderungen. Art des Reittiers: Pferde und Ponys. Unterkunft: Etappenunterkunft (22 Betten)."
        ],
        "en": [
          "Proposed activities: training courses - horse riding in a riding school or outside - walks - accompanied hikes. Type of mounting : horses and ponies. Accommodation : gîte d'étape (22 beds)."
        ],
        "it": [
          "Attività proposte: corsi di formazione - passeggiate a cavallo in maneggio o all'aperto - passeggiate - passeggiate accompagnate. Tipo di cavallo: cavalli e pony. Alloggio : gîte d'étape (22 letti)."
        ],
        "fr": [
          "Activités proposées : stages - équitation en manège ou en extérieur - promenades - randonnées accompagnées. Type de monture : chevaux et poneys. Hébergement : gîte d'étape (22 lits)."
        ],
        "nl": [
          "Voorgestelde activiteiten: cursussen - paardrijden in de manege of buiten - wandelingen - begeleide ritten. Type paard: paarden en pony's. Accommodatie : gîte d'étape (22 bedden)."
        ],
        "es": [
          "Actividades propuestas: cursos de formación - paseos a caballo en el picadero o al aire libre - paseos a pie - paseos acompañados. Tipo de caballo: caballos y ponis. Alojamiento: gîte d'étape (22 camas)."
        ]
      },
