  "rdfs:comment": {
    "de": [
      "Henri Betemps und sein Team aus diplomierten Lehrern empfangen Sie in einer professionellen, aber dennoch familiären und freundlichen Atmosphäre: Cardiobereich, Kraftraum, Kursraum, Bar- und Diätecke."
    ],
    "en": [
      "Henri Betemps and his team of qualified instructors welcome you in a professional, yet friendly and family atmosphere: cardio area, body-building area, class room, bar and dietary area."
    ],
    "it": [
      "Henri Betemps e il suo team di istruttori qualificati vi accolgono in un'atmosfera professionale, ma amichevole e familiare: area cardio, area pesi, sala corsi, bar e area dietetica."
    ],
    "fr": [
      "Henri Betemps et son équipe de professeurs diplômés vous accueillent dans une ambiance professionnelle tout en restant familiale et amicale : espace cardio, espace musculation, salle de cours, coin bar et diététique."
    ],
    "es": [
      "Henri Betemps y su equipo de monitores cualificados le dan la bienvenida en un ambiente profesional y a la vez familiar: zona de cardio, zona de musculación, sala de clases, bar y zona de dietas."
    ],
    "nl": [
      "Henri Betemps en zijn team van gediplomeerde instructeurs ontvangen u in een professionele, maar gezellige en familiale sfeer: cardioruimte, ruimte voor krachttraining, lesruimte, bar en dieetruimte."
    ]
  },
