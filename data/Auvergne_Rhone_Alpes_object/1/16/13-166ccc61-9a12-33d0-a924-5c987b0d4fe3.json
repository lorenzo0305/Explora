  "rdfs:comment": {
    "de": [
      "Bonlieu-sur-Roubion entstand um sein Kloster herum, dessen Basilika sich in die Strömung der provenzalischen Romanik einreiht."
    ],
    "en": [
      "Bonlieu-sur-Roubion grew up around its monastery, whose basilica is part of the Provencal Romanesque movement."
    ],
    "it": [
      "Bonlieu-sur-Roubion è nata intorno al suo monastero, la cui basilica rientra nello stile romanico provenzale."
    ],
    "fr": [
      "Bonlieu-sur-Roubion est né autour de son monastère dont la basilique s'inscrit dans le courant de l'art roman provençal."
    ],
    "es": [
      "Bonlieu-sur-Roubion nació en torno a su monasterio, cuya basílica se inscribe en el estilo románico provenzal."
    ],
