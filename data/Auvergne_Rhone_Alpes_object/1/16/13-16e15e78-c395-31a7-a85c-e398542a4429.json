  "rdfs:comment": {
    "de": [
      "Ein anderer Blick auf den Wald: Bei dieser Outdoor-Aktivität können Sie die Entdeckung der Natur und das Klettern miteinander verbinden und dabei einen angenehmen Moment mit Freunden oder der Familie verbringen."
    ],
    "en": [
      "Another look on the forest: adventure, balance, sensation and shiver on 7 tree-top tracks and 1 giant zipline of 650 ft. All ages, family fun! New violet circuit: very difficult."
    ],
    "it": [
      "Un altro modo di vedere la foresta: questa attività all'aperto permette di scoprire la natura e l'arrampicata condividendo un momento piacevole con gli amici o la famiglia."
    ],
    "fr": [
      "Un autre regard sur la forêt : cette activité de plein air permet de conjuguer découverte de la nature et grimpe tout en partageant un moment agréable entre amis où en famille."
    ],
    "es": [
      "Otra forma de ver el bosque: esta actividad al aire libre permite descubrir la naturaleza y la escalada mientras se comparte un momento agradable con los amigos o la familia."
    ],
    "nl": [
      "Een andere kijk op het bos: avontuur, evenwicht, gevoel en trillingen op 7 routes naar keus en 1 zipline van 230m. Voor de hele familie van 4 tot 77 jaar. Nieuwe route: extreem moeilijk."
    ]
  },
