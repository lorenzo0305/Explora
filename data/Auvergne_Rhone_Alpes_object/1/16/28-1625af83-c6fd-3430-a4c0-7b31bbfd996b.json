  "rdfs:comment": {
    "de": [
      "Anlässlich der Osterfeiertage wird in Crèvec?ur-le-Grand ein kreativer Workshop angeboten. Ein geselliger Moment, um Dekorationen zu basteln und eine kreative Zeit rund um dieses Frühlingsthema zu verbringen."
    ],
    "en": [
      "Crèvec?ur-le-Grand is offering a creative workshop to celebrate Easter. A convivial moment to make decorations and share a creative moment around this spring theme."
    ],
    "it": [
      "Crèvec?ur-le-Grand propone un laboratorio creativo per celebrare la Pasqua. Un'occasione conviviale per realizzare decorazioni e condividere un momento creativo sul tema della primavera."
    ],
    "fr": [
      "Un atelier créatif est proposé à l’occasion des fêtes de Pâques à Crèvecœur-le-Grand. Un moment convivial pour réaliser des décorations et partager un temps créatif autour de cette thématique printanière."
    ],
    "es": [
      "Crèvecœur-le-Grand propone un taller creativo para celebrar la Pascua. Una agradable oportunidad para realizar decoraciones y compartir un momento creativo en torno a este tema primaveral."
    ],
    "nl": [
      "Crèvec?ur-le-Grand biedt een creatieve workshop om Pasen te vieren. Een gezellige gelegenheid om versieringen te maken en een creatief moment te delen rond dit lentethema."
    ]
  },
