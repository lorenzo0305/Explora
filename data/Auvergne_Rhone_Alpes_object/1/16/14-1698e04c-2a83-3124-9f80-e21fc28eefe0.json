  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f726f1f5-5a90-3c0f-8025-35d8e1fa0dbf",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Caterer, der auch Fertiggerichte und Sandwiches anbietet\n\nÖffnungszeiten:\n\nMontag: 8.30-14.30 Uhr\nDienstag bis Freitag: 8.30-19.00 Uhr\nSamstag: 8.30-14.30 Uhr\n \n Abholung :\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Caterer also offering ready-made meals and sandwiches\n\nOpening days:\n\nMonday: 8:30am-2:30pm\nTuesday to Friday: 8.30am-7pm\nSaturday: 8h30-14h30\n \n Pick-up :\nTakeaway during store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Catering che offre anche piatti pronti e panini\n\nGiorni di apertura:\n\nLunedì: 8.30-14.30\nDa martedì a venerdì: 8.30-19.00\nSabato: 8.30-14.30\n \n Ritiro :\nDa asporto durante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: Traiteur proposant également des plats préparés et des sandwichs\n\nJours d'ouverture:\n\nLe lundi: 8h30-14h30\nDu mardi au vendredi: 8h30-19h\nLe samedi: 8h30-14h30\n \n Retrait :\nÀ emporter aux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Traiteur die ook kant-en-klaarmaaltijden en sandwiches aanbiedt\n\nOpeningsdagen:\n\nMaandag: 8.30u-2.30u\nDinsdag t/m vrijdag: 8.30-19.00\nZaterdag: 8.30u-2.30u\n \n Afhalen :\nAfhalen tijdens openingstijden winkel\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Servicio de catering que también ofrece platos preparados y bocadillos\n\nDías de apertura:\n\nLunes: 8.30-14.30\nDe martes a viernes: de 8.30 a 19.00 horas\nSábados: de 8.30 a 14.30 horas\n \n Recogida :\nPara llevar durante el horario de apertura de la tienda\n\n\n "
        ]
      },
