  "rdfs:comment": {
    "de": [
      "Stell dich der Herausforderung! Zeichne einen Geburtstagskuchen, der von deinem Helden aus der Literatur oder einem Film inspiriert ist, um den 1. Geburtstag der Mediathek zu feiern! Von 3 bis 16 Jahren."
    ],
    "en": [
      "Challenge yourself! Design a birthday cake inspired by your literary or film hero to celebrate the mediatheque's 1st birthday! Ages 3 to 16."
    ],
    "it": [
      "Raccogliete la sfida! Progettate una torta di compleanno ispirata al vostro eroe letterario o cinematografico per festeggiare il 1° compleanno della mediateca! Per i bambini dai 3 ai 16 anni."
    ],
    "fr": [
      "Lance-toi le défi ! Dessine un gâteau d'anniversaire inspiré de ton héros de littérature ou de film pour fêter le 1er anniversaire de la médiathèque ! De 3 à 16 ans."
    ],
    "es": [
      "¡Acepta el reto! Diseña una tarta de cumpleaños inspirada en tu héroe literario o cinematográfico para celebrar el primer cumpleaños de la mediateca Para niños de 3 a 16 años."
    ],
    "nl": [
      "Ga de uitdaging aan! Ontwerp een verjaardagstaart geïnspireerd op jouw literaire of filmheld om de 1e verjaardag van de mediatheek te vieren! Voor 3 tot 16 jaar."
    ]
  },
  "rdfs:label": {
