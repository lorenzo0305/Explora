  "rdfs:comment": {
    "de": [
      "SOUSPIERRE (Alt 271m): Unterhalb der Felsen-Festung von Eyzahut liegt das Dorf mit seinen verstreuten Häusern auf einem Plateau mit Blick auf die Ebene von Valdaine."
    ],
    "en": [
      "SOUSPIERRE (Alt 271m): Beneath the fortress cliffs of Eyzahut, the scattered village lies on a plateau overlooking the Valdaine plain."
    ],
    "it": [
      "SOUSPIERRE (Alt 271 m): sotto le falesie-fortezza di Eyzahut, il villaggio, con le sue abitazioni sparse, è situato su un altopiano che domina la piana di Valdaine."
    ],
    "fr": [
      "SOUSPIERRE (Alt 271m) : Sous les falaises-forteresse d'Eyzahut, le village, aux habitations dispersées, est situé sur un plateau avec vue sur la plaine de la Valdaine."
    ],
    "nl": [
      "SOUSPIERRE (Alt 271m): onder de vestingrotsen van Eyzahut ligt het dorp met zijn verspreide woningen op een plateau dat uitkijkt over de Valdaine vlakte."
    ],
    "es": [
      "SOUSPIERRE (Alt 271m): Bajo los acantilados-fortaleza de Eyzahut, el pueblo, con sus viviendas dispersas, está situado en una meseta que domina la llanura de Valdaine."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Souspierre"
    ]
  },
