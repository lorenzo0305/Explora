  "rdfs:comment": {
    "de": [
      "Der Golfplatz Vézac Aurillac (18 Löcher) liegt im alten Tal des Flusses Cère, 7 km von Aurillac entfernt."
    ],
    "en": [
      "Golf de Vézac Aurillac (18 holes) is located in the old Cère valley, 7 km from Aurillac."
    ],
    "it": [
      "Il Golf de Vézac Aurillac (18 buche) si trova nell'antica valle della Cère, a 7 km da Aurillac."
    ],
