  "rdfs:comment": {
    "de": [
      "Haben Sie Ihre Bücher bei der Abreise in den Urlaub vergessen? Keine Panik! Die Bibliothek von Villard-Reculas, empfängt Sie, um Ihnen ihr Angebot an Multimedia-Medien vorzustellen: Romane, Comics, historische Bücher, DVDs..."
    ],
    "en": [
      "Forgotten your books when you went on vacation? Don't panic! The Villard-Reculas library welcomes you to discover its range of multimedia supports: novels, comics, historical books, DVDs..."
    ],
    "it": [
      "Avete dimenticato i vostri libri quando siete andati in vacanza? Niente panico! La biblioteca Villard-Reculas vi invita a scoprire la sua gamma di risorse multimediali: romanzi, fumetti, libri storici, DVD, ecc."
    ],
    "fr": [
      "Vous avez oublié vos livres lors de votre départ en vacances ? Pas de panique ! La bibliothèque de Villard-Reculas, vous accueille pour vous faire découvrir son offre de supports mutlimédias : romans, BD, livres historiques, DVD..."
    ],
    "es": [
      "¿Olvidó sus libros cuando se fue de vacaciones? ¡Que no cunda el pánico! La biblioteca Villard-Reculas le invita a descubrir sus recursos multimedia: novelas, cómics, libros históricos, DVD, etc."
    ],
    "nl": [
      "Ben je je boeken vergeten toen je op vakantie ging? Geen paniek! De bibliotheek van Villard-Reculas nodigt u uit om haar multimediabibliotheek te ontdekken: romans, stripverhalen, historische boeken, dvd's, enz."
    ]
  },
