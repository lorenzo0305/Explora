  "rdfs:comment": {
    "de": [
      "Kanufahrten durch die Schluchten der Ardèche in 1/2 Tag (6/12/14 km), 1 Tag (24/30 km), 2/3 oder sogar 4 Tage (30/36/55 km).\r\nEmpfang von Gruppen, mehrsprachiger Service.\r\nVon BECK-Lehrern betreute Abfahrten.\r\nPrivatparkplatz, Sanitäranlagen, Shop"
    ],
    "en": [
      "Canoeing and kayaking down the Ardèche Gorges, 1/2 day (6/12/14 km), day (24/30 km), 2/3 or even 4 days (30/36/55 km).\r\nGroups welcome, multilingual service.\r\nDescents supervised by BECK instructors.\r\nPrivate parking lot, sanitary facilities, store."
    ],
    "it": [
      "Discesa delle gole dell'Ardèche in Canoa-Kayak. Aperto da aprile a settembre dalle ore 8:30 alle 19:00."
    ],
    "fr": [
      "Descente des Gorges de l'Ardèche en canoë-kayak en 1/2 journée (6/12/14 km) , journée (24/30 km), sur 2/3 voire 4 jours (30/36/55 km). \r\nAccueil groupes, service multilingue.\r\nDescentes encadrées par moniteurs BECK.\r\nParking privé, sanitaires,  boutique"
    ],
    "nl": [
      "Kanoën en kajakken in de Gorges de l'Ardèche voor 1/2 dag (6/12/14 km), hele dag (24/30 km), 2/3 of zelfs 4 dagen (30/36/55 km).\r\nGroepen zijn welkom, meertalige service.\r\nBegeleide afdalingen door BECK instructeurs.\r\nEigen parkeerplaats, toiletten, winkel."
    ],
    "es": [
      "Descenso de las gargantas del Ardèche en kayak. Abierto de abril a septiembre de 8h30 a 19h."
    ]
  },
