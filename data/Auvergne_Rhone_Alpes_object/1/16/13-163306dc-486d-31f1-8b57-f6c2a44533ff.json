  "rdfs:comment": {
    "de": [
      "Bewundern Sie den Fluss Ay und genießen Sie die weiten Horizonte auf dem Plateau und den Panoramablick auf die Hänge des Saint Joseph. Zu finden auf der App MHIKES inspirées\"."
    ],
    "en": [
      "Admire the Ay River and enjoy the vast horizons on the plateau and the panoramic views of the Saint Joseph hillsides. To be found on the application MHIKES."
    ],
    "it": [
      "Ammirate la Rivière d'Ay e godetevi i vasti orizzonti sull'altopiano e le viste panoramiche sulle colline di Saint Joseph. Da scoprire sull'applicazione ispirata a MHIKES\"."
    ],
    "fr": [
      "Admirez la Rivière d'Ay et profitez de vastes horizons sur le plateau et des vues panoramiques sur les coteaux du Saint Joseph. A retrouver sur l'application MHIKES inspirées\"."
    ],
    "nl": [
      "Bewonder de Rivière d'Ay en geniet van uitgestrekte horizonten over het plateau en panoramische uitzichten op de hellingen van Saint Joseph. Te vinden op de MHIKES geïnspireerde applicatie\"."
    ],
    "es": [
      "Admire la Rivière d'Ay y disfrute de amplios horizontes sobre la meseta y vistas panorámicas de las laderas de Saint Joseph. Se encuentra en la aplicación inspirada en MHIKES\"."
    ]
  },
  "rdfs:label": {
    "en": [
      "From the Ay river to the Rhône"
    ],
    "fr": [
      "De la rivière d'Ay au Rhône"
    ]
  },
