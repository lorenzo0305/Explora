  "rdfs:comment": {
    "de": [
      "Norki Haute Décoration\r\nFranzösisches Unternehmen, das sich auf die Herstellung von Teppichen, Plaids, Kissen und Möbeln aus edlen Materialien, Wollhäuten und Pelzen spezialisiert hat. Norki bietet außerdem eine anspruchsvolle Kollektion von Vintage-Möbeln im skandinavischen Design."
    ],
    "en": [
      "Norki - Excellence in Decoration\r\nFrench company specialised in the creation of rugs, throws, cushions and furniture using noble materials, hides and furs. Norki also has a range of high-end vintage, Scandinavian-style furniture."
    ],
    "it": [
      "Norki Haute Décoration \r\nAzienda francese specializzata nella creazione di tappeti, plaid, cuscini e mobili in materiali nobili, scamosciato e pellicce. Norki offre anche una collezione all'avanguardia di arredo vintage di design scandinavo."
    ],
    "fr": [
      "Norki Haute Décoration \r\nMaison Française spécialisée dans la création de tapis, plaids, coussins et mobilier en matériaux nobles, peaux lainées et fourrures. Norki décline également une collection pointue de mobilier vintage du design scandinave."
    ],
    "nl": [
      "Norki Haute Décoration\r\nFrans bedrijf gespecialiseerd in de creatie van tapijten, plaids, kussens en meubels van edele materialen, wolhuiden en bont. Norki biedt ook een geavanceerde collectie vintage Scandinavisch designmeubilair."
    ],
    "es": [
      "Norki Alta Decoración\r\nEmpresa francesa especializada en la creación de alfombras, plaids, cojines y muebles en materiales nobles, pieles de lana y peletería. Norki también ofrece una colección vanguardista de muebles vintage de diseño escandinavo."
    ]
  },
