  "rdfs:comment": {
    "de": [
      "Der WorClub:\r\n- Gemeinsam genutzte Räume, in denen Sie mit Ihrem Computer arbeiten und Wi-Fi nutzen können.\r\n- Vermietung von 2 Konferenzräumen für Ihre beruflichen Treffen.\r\n- Räume für lokale Kunsthandwerker und Designer, in denen sie ihre Werke ausstellen können."
    ],
    "en": [
      "WorClub:\r\n- Shared spaces to work with your computer and enjoy Wi-Fi.\r\n- 2 meeting rooms for professional meetings.\r\n- Spaces dedicated to local artisans and creators to exhibit their work."
    ],
    "it": [
      "Il WorClub :\r\n- Spazi condivisi per lavorare al computer e usufruire della connessione Wi-Fi.\r\n- Noleggio di 2 sale riunioni per i vostri incontri di lavoro.\r\n- Spazi per l'esposizione dei lavori di artigiani e designer locali."
    ],
    "fr": [
      "Le WorClub  : \r\n- Des espaces partagés pour travailler avec votre ordinateur et profiter du Wi-Fi.\r\n- La location de 2 salles de réunion pour vos rencontres professionnelles.\r\n- Des espaces dédiés aux artisans et créateurs locaux pour exposer leurs œuvres."
    ],
    "es": [
      "El WorClub :\r\n- Espacios compartidos para trabajar con su ordenador y aprovechar el Wi-Fi.\r\n- Alquiler de 2 salas de reuniones para sus encuentros de negocios.\r\n- Espacios para que los artesanos y diseñadores locales expongan sus obras."
    ],
    "nl": [
      "De WorClub :\r\n- Gedeelde ruimtes om met je computer te werken en gebruik te maken van Wi-Fi.\r\n- Verhuur van 2 vergaderzalen voor uw zakelijke bijeenkomsten.\r\n- Ruimtes waar lokale ambachtslieden en ontwerpers hun werk kunnen tentoonstellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "WorkClub"
    ]
  },
