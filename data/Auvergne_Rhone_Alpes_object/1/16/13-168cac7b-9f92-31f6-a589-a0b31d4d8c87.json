  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Laser Game Evolution in Saint-Martin-d'Hères, einen immersiven Spielbereich mit unserer Lasertechnologie der neuesten Generation, verteilt auf 3 Labyrinthe mit mehreren Ebenen für immer strategischere und dynamischere Spiele."
    ],
    "en": [
      "Come and discover the Laser Game Evolution in Saint-Martin-d'Hères, an immersive play area featuring our latest-generation laser technology, spread over 3 multi-level mazes for ever more strategic and dynamic games."
    ],
    "it": [
      "Venite a scoprire il Laser Game Evolution a Saint-Martin-d'Hères, un'area di gioco coinvolgente dotata della nostra tecnologia laser di ultima generazione, distribuita su 3 labirinti multilivello per giochi sempre più strategici e dinamici."
    ],
    "fr": [
      "Venez découvrir le Laser Game Evolution de Saint-Martin-d’Hères, un espace de jeu immersif doté de notre technologie laser de dernière génération, réparti sur 3 labyrinthes multi-niveaux pour des parties toujours plus stratégiques et dynamiques."
    ],
    "es": [
      "Venga a descubrir el Laser Game Evolution de Saint-Martin-d'Hères, un espacio de juego inmersivo equipado con nuestra tecnología láser de última generación, repartido en 3 laberintos multinivel para juegos cada vez más estratégicos y dinámicos."
    ],
    "nl": [
      "Kom en ontdek de Laser Game Evolution in Saint-Martin-d?Hères, een meeslepende speelruimte uitgerust met onze lasertechnologie van de nieuwste generatie, verspreid over 3 doolhoven met meerdere niveaus voor steeds strategischer en dynamischer spelen."
    ]
  },
