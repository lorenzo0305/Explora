  "rdfs:comment": {
    "de": [
      "Besichtigung und Verkauf von Salat Tradition.\r\nWir begrüßen Sie, um Ihnen eine der 5 letzten Produktionen von Bauernkäse aus 100% Salers-Milch vorzustellen.\r\nBesichtigung des Melkens nach Voranmeldung."
    ],
    "en": [
      "Visit and sale of Salat Tradition.\r\nWe welcome you to discover one of the last 5 farmhouse cheeses made from 100% Salers milk.\r\nMilking tour by appointment."
    ],
    "it": [
      "Visita e vendita del Salat Tradition.\r\nVi invitiamo a scoprire uno degli ultimi 5 formaggi di fattoria prodotti con latte 100% Salers.\r\nVisite alla mungitura su prenotazione."
    ],
    "fr": [
      "Visite et vente de Salat Tradition.\r\nNous vous accueillons pour vous faire découvrir une des 5 dernières productions de fromage fermier au lait 100% Salers.\r\nVisite de la traite sur réservation."
    ],
    "es": [
      "Visita y venta de Salat Tradición.\r\nLe invitamos a descubrir uno de los 5 últimos quesos de granja elaborados con leche 100% de Salers.\r\nVisitas al ordeño previa concertación."
    ],
    "nl": [
      "Bezoek en verkoop van Salat Tradition.\r\nWe verwelkomen je om een van de laatste 5 boerenkazen gemaakt van 100% Salers melk te ontdekken.\r\nBezoeken om te melken op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Salat - Producteur de fromage au lait de vache Salers"
    ]
  },
