  "rdfs:comment": {
    "de": [
      "Die Domaine de Pierre Blanche empfängt Sie zwischen den Regionen Vercors und Ardèche. Unsere Ausrichtung ist es, den Zugang zum Reiten für alle in einer Freizeit- und Wettkampfpraxis zu entwickeln."
    ],
    "en": [
      "The Domaine de Pierre Blanche welcomes you between the Vercors and the Ardèche. Our aim is to develop access to horse riding for all, for both leisure and competition."
    ],
    "it": [
      "Il Domaine de Pierre Blanche vi accoglie tra il Vercors e l'Ardèche. Il nostro obiettivo è sviluppare l'accesso all'equitazione per tutti, sia nel tempo libero che nelle competizioni."
    ],
    "fr": [
      "Le Domaine de Pierre Blanche vous accueille entre le Vercors et l'Ardèche. Notre orientation est de développer l'accès à l'équitation pour tous dans une pratique de loisir et de compétition."
    ],
    "nl": [
      "Het Domaine de Pierre Blanche verwelkomt u tussen de Vercors en de Ardèche. Ons doel is om paardrijden toegankelijk te maken voor iedereen, zowel voor vrijetijdsbesteding als voor wedstrijden."
    ],
    "es": [
      "El Domaine de Pierre Blanche le da la bienvenida entre el Vercors y el Ardèche. Nuestro objetivo es desarrollar el acceso a la equitación para todos en un contexto de ocio y competición."
    ]
  },
