  "rdfs:comment": {
    "de": [
      "Diese beiden Seen umfassen einen Weg durch ein Feuchtgebiet mit großem ökologischem Reichtum und einen Raum, der sich zum Spazierengehen, Angeln sowie zum Beobachten und Identifizieren von Fauna und Flora eignet. Wasserfläche 2. Kategorie für Fische."
    ],
    "en": [
      "Two category 2 lakes for the fishing of carp, roach and pike."
    ],
    "it": [
      "Scoprite gli stagni di Bellevue a Peyrins: pesca, picnic e natura. Un luogo ideale per rilassarsi!"
    ],
    "fr": [
      "Découvrez les étangs de Bellevue à Peyrins : pêche, pique-nique et nature. Un lieu idéal pour se détendre !"
    ],
    "nl": [
      "Deze 2 meertjes maken deel uit van een parcours in een waterrijk gebied met een grote ecologische rijkdom, zeer geschikt voor wandelingen, vissen en observeren en identificeren van flora en fauna."
    ],
    "es": [
      "Descubra los estanques de Bellevue en Peyrins: pesca, picnic y naturaleza. ¡Un lugar ideal para relajarse!"
    ]
  },
