  "rdfs:comment": {
    "de": [
      "Gemütliche Atmosphäre im Stil der Berge! Regionale Spezialitäten, Gerichte und Kindermenü werden angeboten. Speisesaal mit Platz für ca. 100 Gäste, einzeln oder in Gruppen. Große Terrasse von Mai bis September. Bar tagsüber geöffnet."
    ],
    "en": [
      "This warm and welcoming inn is located in the heart of the village of Vassieux-en-Vercors. It is the perfect location for enjoying a break both in summer and winter as you can enjoy skiing, dog-sledding, hiking and mountain biking."
    ],
    "it": [
      "Atmosfera calda in stile montano! Sono disponibili specialità regionali, piatti e menu per bambini. Il ristorante può ospitare fino a 100 persone, singolarmente o in gruppo. Ampia terrazza da maggio a settembre. Bar aperto tutto il giorno."
    ],
    "fr": [
      "Ambiance chaleureuse dans un style montagnard ! Spécialités régionales, plats et menu enfant proposés. Salle de restaurant pouvant accueillir une centaine de clients, en individuel ou en groupe. Grande terrasse de mai à septembre. Bar ouvert en journée."
    ],
    "nl": [
      "De gezellige en familiale Auberge ligt in het dorpscentrum van Vassieux-en-Vercors. Ideaal gelegen voor zomer- en winterverblijven, u kunt hier skiën, met sledehonden rijden, wandelen, mountainbiken"
    ],
    "es": [
      "Ambiente cálido al estilo montañés Especialidades regionales, platos y menú infantil disponibles. El restaurante puede acoger hasta 100 comensales, individualmente o en grupo. Amplia terraza de mayo a septiembre. Bar abierto todo el día."
    ]
  },
