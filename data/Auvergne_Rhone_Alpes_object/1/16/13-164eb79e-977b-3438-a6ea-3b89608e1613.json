  "rdfs:comment": {
    "de": [
      "Bar-Restaurant im Herzen des Dorfes.\r\nHausgemachte Pizzas und Burger, vor Ort oder zum Mitnehmen am Freitag-, Samstag- und Sonntagabend vom 1. November bis 30. April und jeden Abend vom 1. Mai bis 31. Oktober jeden Abend auf Reservierung."
    ],
    "en": [
      "Bar-restaurant in the heart of the village.\r\nHomemade pizzas and burgers, on the spot or to take away on Friday, Saturday and Sunday evenings from November 1st to April 30th and every evening from May 1st to October 31st, every evening on reservation."
    ],
    "it": [
      "Bar-ristorante nel cuore del villaggio.\r\nPizze e hamburger fatti in casa, sul posto o da asporto, il venerdì, sabato e domenica sera dal 1° novembre al 30 aprile e tutte le sere dal 1° maggio al 31 ottobre, su prenotazione."
    ],
    "fr": [
      "Bar-restaurant au cœur du village. \r\nPizzas et burgers faits maison, sur place ou à emporter le vendredi, samedi et dimanche soir du 1er novembre au 30 avril et tous les soirs du 1er mai au 31 octobre tous les soirs sur réservation."
    ],
    "es": [
      "Bar-restaurante en el corazón del pueblo.\r\nPizzas y hamburguesas caseras, in situ o para llevar los viernes, sábados y domingos por la noche del 1 de noviembre al 30 de abril y todas las noches del 1 de mayo al 31 de octubre, previa reserva."
    ],
    "nl": [
      "Bar-restaurant in het hart van het dorp.\r\nZelfgemaakte pizza's en hamburgers, ter plaatse of om mee te nemen, op vrijdag-, zaterdag- en zondagavond van 1 november tot 30 april en elke avond van 1 mei tot 31 oktober, na reservering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Auberge du Soleil"
    ]
  },
