  "rdfs:comment": {
    "de": [
      "Der Wald der Dent du Villard ist von zahlreichen Wanderwegen durchzogen und sein Gipfel bietet einen herrlichen Ausblick auf die Vanoise. Hier findet man einen Kiefernwald mit Hakenkiefern auf Gips, der in Europa sehr selten ist."
    ],
    "en": [
      "The forest of the Dent du Villard is crossed by many paths and its summit offers a magnificent view on the Vanoise. There is a pine forest of hooked pines on gypsum very rare in Europe."
    ],
    "it": [
      "La foresta del Dent du Villard è attraversata da numerosi sentieri e la sua cima offre una magnifica vista sulla Vanoise, con una pineta di pino uncinato su gesso rara in Europa."
    ],
    "fr": [
      "La forêt de la Dent du Villard est parcourue par de nombreux sentiers et son sommet offre un magnifique point de vue sur la Vanoise.On y trouve une pineraie de pins à crochets sur gypse très rare à l’échelle de l’Europe."
    ],
    "nl": [
      "Het bos Dent du Villard wordt doorkruist door talloze wandelpaden en de top biedt een prachtig uitzicht op de Vanoise, met een dennenbos van gehaakte dennen op gips dat zeldzaam is in Europa."
    ],
    "es": [
      "El bosque de Dent du Villard está surcado por numerosos senderos y su cima ofrece una magnífica vista de la Vanoise, con un pinar de pino ganchudo sobre yeso poco común en Europa."
    ]
  },
  "rdfs:label": {
    "en": [
      "Dent du Villard forest"
    ],
    "fr": [
      "Forêt de la Dent du Villard"
    ]
  },
