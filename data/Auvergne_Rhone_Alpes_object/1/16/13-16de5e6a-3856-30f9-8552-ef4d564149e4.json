  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in unsere geschmackvolle Speisekarte, die mit viel Sorgfalt zusammengestellt wurde.\r\nEinfache Gerichte, die mit frischen Zutaten zubereitet werden, versprechen Ihnen die Authentizität einer Alltagsküche"
    ],
    "en": [
      "Dive into our carefully concocted menu, full of flavors.\r\nSimple dishes, prepared with fresh produce, offer you the promise of authentic, everyday cooking"
    ],
    "it": [
      "Tuffatevi nel nostro menu accuratamente elaborato e ricco di sapori.\r\nPiatti semplici, preparati con prodotti freschi, vi offrono la promessa di una cucina autentica e quotidiana"
    ],
    "fr": [
      "Plongez dans notre carte pleine de saveurs, concoctée avec soin.\r\nDes plats simples, préparés avec des produits frais, vous offrent la promesse de l'authenticité d’une cuisine de tous les jours"
    ],
    "es": [
      "Sumérjase en nuestra cuidada carta, llena de sabor.\r\nPlatos sencillos, elaborados con productos frescos, le ofrecen la promesa de una cocina auténtica y cotidiana"
    ],
    "nl": [
      "Duik in ons zorgvuldig samengestelde menu, vol smaak.\r\nEenvoudige gerechten, bereid met verse producten, bieden je de belofte van een authentieke, alledaagse keuken"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie du village"
    ]
  },
