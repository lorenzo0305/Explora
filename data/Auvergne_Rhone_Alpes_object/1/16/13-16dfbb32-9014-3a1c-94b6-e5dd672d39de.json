  "rdfs:comment": {
    "de": [
      "Das gesamte Team freut sich, Sie begrüßen zu dürfen und bietet Ihnen eine traditionelle Küche, die mit geschmorten Rezepten und saisonalen Produkten aus der Region in einer familiären, freundlichen und herzlichen Atmosphäre zubereitet wird."
    ],
    "en": [
      "The whole team has the pleasure to welcome you by offering you a traditional cuisine elaborated with stewed recipes and seasonal local products, in a friendly and warm atmosphere."
    ],
    "it": [
      "L'intero team è pronto ad accogliervi e a servirvi una cucina tradizionale basata su ricette tipiche e prodotti locali di stagione, in un'atmosfera familiare e accogliente."
    ],
    "fr": [
      "Toute l'équipe a le plaisir de vous accueillir en vous proposant une cuisine traditionnelle élaborée avec des recettes mijotées et des produits du terroir de saison, dans une ambiance familiale, conviviale et chaleureuse."
    ],
    "es": [
      "Todo el equipo está deseando darle la bienvenida y servirle cocina tradicional basada en recetas tradicionales y productos locales de temporada, en un ambiente familiar y acogedor."
    ],
    "nl": [
      "Het hele team kijkt ernaar uit om je te verwelkomen en je traditionele gerechten te serveren op basis van traditionele recepten en seizoensgebonden lokale producten, in een warme en vriendelijke familiesfeer."
    ]
  },
  "rdfs:label": {
