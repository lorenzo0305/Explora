  "rdfs:comment": {
    "de": [
      "Ein kleines Stück Italien im Herzen des Dorfes Saint Martin d'Uriage zum Mitnehmen nach Hause!  Genießen Sie im Einklang mit der reinsten italienischen Tradition Pizza, Foccacia & Tagesgerichte zum Mitnehmen"
    ],
    "en": [
      "A little corner of Italy in the heart of the village of Saint Martin d'Uriage to take home with you!  In the purest Italian tradition, savour the pizza, foccacia & daily specials to take away"
    ],
    "it": [
      "Un piccolo angolo d'Italia nel cuore del villaggio di Saint Martin d'Uriage da portare a casa!  Nella più pura tradizione italiana, gustate la pizza, la foccacia e le specialità del giorno da portare via"
    ],
    "fr": [
      "Un petit coin d'Italie en plein cœur du village de Saint Martin d'Uriage à emporter chez vous  !  Dans le respect de la plus pure tradition italienne, savourez les pizza, foccacia & plats du jour à emporter"
    ],
    "es": [
      "Un pequeño rincón de Italia en el corazón del pueblo de Saint Martin d'Uriage para llevar a casa  En la más pura tradición italiana, disfrute de la pizza, la foccacia y los platos del día para llevar"
    ],
    "nl": [
      "Een klein hoekje Italië in het hart van het dorp Saint Martin d'Uriage om mee naar huis te nemen!  In de zuiverste Italiaanse traditie kunt u genieten van pizza, foccacia en dagschotels om mee te nemen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria I Matti di Roma"
    ]
  },
