  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von unseren Oxygène-Lehrern führen, um das Schönste zu entdecken, was La Rosière zu bieten hat. Ob mit der Familie oder mit Freunden, erreichen Sie die Gipfel für einen unvergesslichen Aufenthalt in Gruppen- oder Privatkursen."
    ],
    "en": [
      "Let Oxygène’s instructors guide you to discover the very best of La Rosière. With family or friends, head up to the peaks for an unforgettable holiday with group or private lessons."
    ],
    "it": [
      "Lasciati guidare dai maestri Oxygène per scoprire il meglio che La Rosière ha da offrire. In famiglia o con gli amici, raggiungi le vette per una vacanza indimenticabile con lezioni collettive o private."
    ],
    "fr": [
      "Laissez-vous guider par nos moniteurs Oxygène pour découvrir ce que La Rosière a de plus beau à offrir. En famille ou entre amis, rejoignez les sommets pour un séjour inoubliable en cours collectifs ou privés."
    ],
    "nl": [
      "Laat je begeleiden door onze Oxygène instructeurs om het beste te ontdekken dat La Rosière te bieden heeft. Kom met familie of vrienden naar de toppen voor een onvergetelijk verblijf in groeps- of privélessen."
    ],
    "es": [
      "Déjese guiar por nuestros monitores Oxygène para descubrir lo mejor de La Rosière. En familia o con amigos, únete a las cumbres para una estancia inolvidable en clases colectivas o privadas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Oxygène Ski & Snowboard School La Rosière"
    ],
    "fr": [
      "Oxygène École de Ski et Snowboard La Rosière"
    ]
  },
