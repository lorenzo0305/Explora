  "rdfs:comment": {
    "de": [
      "Willkommen in unserem Restaurant, das auf das Kochen auf heißen Steinen spezialisiert ist und in dem jedes Gericht zu einem einzigartigen Erlebnis wird! Genießen Sie Fleischgerichte direkt an Ihrem Tisch, für einen geselligen und leckeren Moment. Hier sind Sie der Chefkoch!"
    ],
    "en": [
      "Welcome to our restaurant specializing in hot stone cooking, where every dish becomes a unique experience ! Come and enjoy meat cooked right at your table for a convivial and gourmet moment. Here, you are the chef !"
    ],
    "it": [
      "Benvenuti nel nostro ristorante specializzato nella cottura su pietre calde, dove ogni piatto diventa un'esperienza unica! Venite ad assaporare le nostre carni, servite direttamente al vostro tavolo, per un momento conviviale e goloso. Qui siete voi lo chef!"
    ],
    "fr": [
      "Bienvenue dans notre restaurant spécialisé dans la cuisson sur pierres chaudes, où chaque plat devient une expérience unique ! Venez savourer des viandes, directement à votre table, pour un moment convivial et gourmand. Ici, c'est vous le Chef !"
    ],
    "nl": [
      "Welkom in ons restaurant dat gespecialiseerd is in koken op hete stenen, waar elk gerecht een unieke ervaring wordt! Kom proeven van onze vleeswaren, direct aan tafel, voor een gezellig en gastronomisch moment. Hier ben jij de chef!"
    ],
    "es": [
      "Bienvenido a nuestro restaurante especializado en cocina a la piedra caliente, ¡donde cada plato se convierte en una experiencia única! Venga a saborear nuestras carnes, directamente en su mesa, para un momento de convivencia y gourmet. Aquí, ¡usted es el Chef!"
    ]
  },
