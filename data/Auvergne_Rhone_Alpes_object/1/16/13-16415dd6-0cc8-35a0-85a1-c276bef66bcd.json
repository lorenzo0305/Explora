  "rdfs:comment": {
    "de": [
      "Kirche aus Backstein und Stein vom Architekten Mitton (1884-1887)\r\nDie Gründung der Pfarrei, die zunächst dem Heiligen Sebastian geweiht war, geht auf die erste Hälfte des 9. Von der alten Kirche sind nur noch einige Fundamente erhalten."
    ],
    "en": [
      "Brick and stone church by architect Mitton (1884-1887)\r\nThe foundation of the parish, first dedicated to St. Sebastian, dates back to the first half of the 9th century. Of the old church only a few foundations remain."
    ],
    "it": [
      "Chiesa in mattoni e pietra dell'architetto Mitton (1884-1887)\r\nLa fondazione della parrocchia, inizialmente dedicata a San Sebastiano, risale alla prima metà del IX secolo. Dell'antica chiesa rimangono solo alcune fondamenta."
    ],
    "fr": [
      "Eglise de brique et pierre par l'architecte Mitton (1884-1887)\r\nLa fondation de la paroisse, dédiée d'abord à saint Sébastien, remonte à la première moitié du IX siècle. De l'ancienne église, il en reste que quelques fondations."
    ],
    "es": [
      "Iglesia de ladrillo y piedra del arquitecto Mitton (1884-1887)\r\nLa fundación de la parroquia, dedicada por primera vez a San Sebastián, se remonta a la primera mitad del siglo IX. Sólo quedan algunos cimientos de la antigua iglesia."
    ],
    "nl": [
      "Bakstenen en stenen kerk van de architect Mitton (1884-1887)\r\nDe stichting van de parochie, eerst gewijd aan Sint Sebastiaan, dateert uit de eerste helft van de 9e eeuw. Van de oude kerk zijn slechts enkele fundamenten overgebleven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Roch"
    ]
  },
