  "rdfs:comment": {
    "de": [
      "Dieser kleine Zug fährt  euch um dem Park Jouvet.\r\nSpass für Kinder."
    ],
    "en": [
      "Discover the Rail Train and Carousel at Parc Jouvet in Valence, perfect attractions for the whole family. Located in the city center, this green park offers play areas, entertainment, and nearby parking for a fun and enjoyable outing."
    ],
    "it": [
      "Scoprite il Train sur Rail e il Manège del Parc Jouvet di Valence, attrazioni ideali per tutta la famiglia. Situato nel centro della città, questo parco verde offre aree gioco, animazione e un parcheggio nelle vicinanze per una gita divertente e amichevole."
    ],
    "fr": [
      "Découvrez le Train sur rail et le Manège du Parc Jouvet à Valence, des attractions idéales pour toute la famille. Situé en centre-ville, ce parc verdoyant offre aires de jeux, animations et parking à proximité pour une sortie conviviale et divertissante."
    ],
    "nl": [
      "Treintje rond het Parc Jouvet.\r\nDraaimolen voor kinderen."
    ],
    "es": [
      "Descubra el Train sur Rail y el Manège del Parc Jouvet de Valence, atracciones ideales para toda la familia. Situado en el centro de la ciudad, este parque verde ofrece zonas de juegos, entretenimiento y aparcamiento cercano para una salida divertida y agradable."
    ]
  },
  "rdfs:label": {
    "de": [
