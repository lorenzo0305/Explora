  "rdfs:comment": {
    "de": [
      "Verkauf nach Hause: reichhaltige Pizza mit hochwertigen Produkten, Caterer, lokale Produkte und italienische Produkte (Teigwaren, Risotto, süsse und salzige Produkte), Wein und bald Pökeln und Käse in Scheiben... Der Empfang ist dem Service gewachsen!"
    ],
    "en": [
      "Catering on site or to take away: generous pizzas with quality products, caterer, local products and Italian products (pasta, risotto, sweet and savory products), wine, cured meat, sliced ​​cheese, bar. Welcome to the height of the service!"
    ],
    "it": [
      "Ristorazione sul posto o da asporto: pizze abbondanti con prodotti di qualità, catering, prodotti locali e italiani (pasta, risotti, prodotti dolci e salati), vino, salumi, formaggi a fette, bar. L'accoglienza è buona come il servizio!"
    ],
    "fr": [
      "Restauration sur place ou à emporter : pizzas généreuses avec des produits de qualité, traiteur, produits locaux et produits italiens (pâtes, risotto, produits sucrés et salés), vin, salaison, fromage à la coupe, bar. Accueil à la hauteur du service !"
    ],
    "es": [
      "Restauración in situ o para llevar: pizzas generosas con productos de calidad, catering, productos locales e italianos (pasta, risotto, productos dulces y salados), vino, embutidos, quesos al corte, bar. ¡Bienvenida tan buena como el servicio!"
    ],
    "nl": [
      "Catering ter plaatse of om mee te nemen: royale pizza's met kwaliteitsproducten, catering, lokale en Italiaanse producten (pasta, risotto, zoete en hartige producten), wijn, gezouten vlees, kaas per plak, bar. Ontvangst net zo goed als de service!"
    ]
  },
