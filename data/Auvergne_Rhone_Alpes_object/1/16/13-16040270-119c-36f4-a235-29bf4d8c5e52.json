  "rdfs:comment": {
    "de": [
      "hysteriko, französische, öko-verantwortliche Modemarke für Frauen in Chambéry. Gegründet von Priscille Portigliatti, bietet hysteriko Kleidung, die Sinn macht. Farbpalette, schöne Materialien, durchdachte Schnitte. Kleidung zum Leben, für eine lange Zeit!"
    ],
    "en": [
      "hysteriko, a French, eco-responsible women's fashion brand based in Chambéry. Created by Priscille Portigliatti, hysteriko offers clothes that make sense. A palette of colors, beautiful materials and studied cuts. Clothes to live in, for a long time to come!"
    ],
    "it": [
      "hysteriko è un marchio francese di moda femminile eco-responsabile con sede a Chambéry. Creato da Priscille Portigliatti, hysteriko propone abiti che hanno un senso. Una tavolozza di colori, bei materiali e tagli attentamente studiati. Abiti da vivere, per molto tempo ancora!"
    ],
    "fr": [
      "hysteriko, marque de mode féminine française, eco-responsable à Chambéry. Crée par Priscille Portigliatti, hysteriko propose des vêtements qui ont du sens. Palette de couleurs, belles matières, coupes étudiées. Des vêtements à vivre, pour longtemps !"
    ],
    "es": [
      "hysteriko, una marca francesa de moda femenina eco-responsable con sede en Chambéry. Creada por Priscille Portigliatti, hysteriko ofrece prendas que tienen sentido. Una paleta de colores, materiales preciosos y cortes cuidados. Ropa para vivir durante mucho tiempo"
    ],
    "nl": [
      "hysteriko, een Frans, ecologisch verantwoord damesmodemerk uit Chambéry. Hysteriko is opgericht door Priscille Portigliatti en biedt kleding die zinvol is. Een kleurenpalet, mooie materialen en doordachte pasvormen. Kleding om lang in te leven!"
    ]
  },
