  "rdfs:comment": {
    "de": [
      "Die Kirche von Douvaine, die ihre Gründung im Laufe des 12. Jahrhunderts der Pfarrei verdankt, deren Schutzpatron Saint Loup ist, hat eine reiche Geschichte und architektonische Entwicklung durchlaufen."
    ],
    "en": [
      "Founded in the 12th century by the parish of Saint Loup, Douvaine's church has undergone a rich architectural history and evolution."
    ],
    "it": [
      "Fondata nel XII secolo dalla parrocchia di Saint Loup, la chiesa di Douvaine ha subito una ricca storia ed evoluzione architettonica."
    ],
    "fr": [
      "L’église de Douvaine qui doit sa fondation au court du XIIème siècle grâce à la paroisse dont le patron est Saint Loup, a connu une histoire et une évolution architecturale riches."
    ],
    "es": [
      "La iglesia de Douvaine, que debe su fundación en el siglo XII a la parroquia cuyo patrón es San Loup, ha tenido una rica historia y evolución arquitectónica."
    ],
    "nl": [
      "De kerk van Douvaine werd in de 12e eeuw gesticht door de parochie van Saint Loup en heeft een rijke architectonische geschiedenis en evolutie doorgemaakt."
    ]
  },
