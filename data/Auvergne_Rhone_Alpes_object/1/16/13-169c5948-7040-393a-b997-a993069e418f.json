  "rdfs:comment": {
    "de": [
      "Ich bin ein ausgebildeter Fahrradmechaniker und biete meine Dienste an, um alle Arten von Fahrrädern zu warten und zu reparieren, indem ich mich mit meinem Werkstattwagen fortbewege."
    ],
    "en": [
      "I am a qualified bicycle mechanic and I offer my services for the maintenance and repair of all types of bicycles, using my workshop truck."
    ],
    "it": [
      "Sono un meccanico di biciclette qualificato e offro i miei servizi per la manutenzione e la riparazione di tutti i tipi di biciclette utilizzando il mio camion officina."
    ],
    "fr": [
      "Mécanicien cycles diplômé, je propose mes services pour assurer l’entretien et la réparation de tout type de vélos en me déplaçant à l’aide de mon camion-atelier."
    ],
    "es": [
      "Soy mecánico de bicicletas titulado y ofrezco mis servicios para mantener y reparar todo tipo de bicicletas utilizando mi camión taller."
    ],
    "nl": [
      "Ik ben gediplomeerd fietsenmaker en bied mijn diensten aan om alle soorten fietsen te onderhouden en te repareren met behulp van mijn werkplaatswagen."
    ]
  },
