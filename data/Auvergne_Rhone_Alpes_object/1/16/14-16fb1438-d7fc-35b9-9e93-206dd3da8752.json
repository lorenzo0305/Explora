  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/21c31443-bb08-38b6-8cbb-0ccb499bb5b0",
      "dc:description": {
        "de": [
          "Tanzverein für Anfänger oder erfahrene Tänzer, der allen ohne Altersgrenze offen steht.\nTanzen Sie zum Rhythmus der verschiedensten Musikrichtungen: Modern, Pop, Rock, Latin, Irish, Chacha, Kuduro, Country..."
        ],
        "en": [
          "Dance association for beginners or experienced dancers, open to all with no age limit.\nDance to the rhythm of a wide variety of music: modern, pop, rock, Latino, Irish, Chacha, Kuduro, country..."
        ],
        "it": [
          "Associazione di danza per principianti o ballerini esperti, aperta a tutti, senza limiti di età.\nSi balla al ritmo di una grande varietà di musica: moderna, pop, rock, latina, irlandese, chacha, kuduro, country..."
        ],
        "fr": [
          "Association de danse pour débutant ou danseur expérimenté ouverte à tous sans limite d'âge.\nDansez au rythme des musiques les plus variées : moderne, pop, rock, latino, Irlandais, Chacha, Kuduro, country..."
        ],
        "nl": [
          "Dansvereniging voor beginners of ervaren dansers, open voor iedereen, geen leeftijdsgrens.\nDans op het ritme van de meest uiteenlopende muziek: modern, pop, rock, Latino, Iers, Chacha, Kuduro, country..."
        ],
        "es": [
          "Asociación de baile para principiantes o bailarines experimentados, abierta a todos, sin límite de edad.\nBaila al ritmo de una gran variedad de música: moderna, pop, rock, latina, irlandesa, chacha, kuduro, country..."
        ]
      },
