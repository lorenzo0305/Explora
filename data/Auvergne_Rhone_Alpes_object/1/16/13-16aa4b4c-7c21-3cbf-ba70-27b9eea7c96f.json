  "rdfs:comment": {
    "de": [
      "Im April musst du dich nicht verstecken? Aber heute Abend könnte es kompliziert werden!\r\nHERMIT wird den Abend eröffnen und uns in seine von der Underground-Kultur inspirierte Welt einladen.\r\nDanach folgt RAKOON mit seinem einzigartigen Stil."
    ],
    "en": [
      "Don't let April fool you? But tonight it's going to be complicated!\nHERMIT will open the evening, inviting us into his universe inspired by underground culture.\nRAKOON will follow, with his unique style."
    ],
    "it": [
      "Ad aprile, non perdetevi di vista? Ma stasera sarà complicato!\r\nHERMIT aprirà la serata, invitandoci nel suo mondo ispirato alla cultura underground.\r\nSeguirà RAKOON con il suo stile unico."
    ],
    "fr": [
      "En avril ne te découvre pas d’un fil ? Mais ce soir ça risque d’être compliqué !\r\nHERMIT ouvrira la soirée en nous invitant dans son univers inspiré de la culture underground. \r\nRAKOON prendra la suite, avec son style unique."
    ],
    "nl": [
      "Laat april je niet voor de gek houden? Maar vanavond wordt het ingewikkeld!\r\nHERMIT opent de avond en neemt ons mee in zijn wereld geïnspireerd door de underground cultuur.\r\nRAKOON volgt met zijn unieke stijl."
    ],
    "es": [
      "En abril, no te pierdas de vista.. ¡Pero esta noche va a ser complicado!\r\nHERMIT abrirá la velada, invitándonos a su mundo inspirado en la cultura underground.\r\nRAKOON le seguirá con su estilo único."
    ]
  },
  "rdfs:label": {
