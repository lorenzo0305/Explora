  "rdfs:comment": {
    "de": [
      "Seit über 30 Jahren widmet sich das Atelier du Chat Botté der hochwertigen historischen Rekonstruktion von Zivil- und Militärkostümen sowie dem Entwurf und der Herstellung von Bühnenkostümen."
    ],
    "en": [
      "For more than 30 years, Le Chat Botté's workshops have been dedicated to the high-end historical re-enactment of civil and military costumes, and to the creation and production of stage costumes."
    ],
    "it": [
      "Da oltre 30 anni, i laboratori di Chat Botté si dedicano alla ricostruzione storica di alto livello di costumi civili e militari e alla creazione e produzione di costumi di scena."
    ],
    "fr": [
      "Depuis plus de 30 ans, les ateliers du Chat Botté se vouent à la reconstitution historique haut de gamme de costumes civils et  militaires, et à la création et la réalisation de costumes de scéne."
    ],
    "es": [
      "Desde hace más de 30 años, los talleres de Chat Botté se dedican a la reconstrucción histórica de alta gama de trajes civiles y militares, y a la creación y producción de trajes de escena."
    ],
    "nl": [
      "Al meer dan 30 jaar houden de ateliers van Chat Botté zich bezig met de hoogwaardige historische reconstructie van burgerlijke en militaire kostuums en met de creatie en productie van toneelkostuums."
    ]
  },
  "rdfs:label": {
