      "dc:description": {
        "de": [
          "Eine lebensgroße Säuberung!\n\nWir treffen uns am 16. März um 9.00 Uhr an der Salle les Charmes für die 8. Ausgabe von \"nettoyons la nature\".\nDauer: 3 Stunden"
        ],
        "en": [
          "A full-scale clean-up!\n\nRendezvous at 9:00 a.m. at the Salle les Charmes on March 16 for the 8th edition of Clean Up Nature.\nDuration: 3 hours"
        ],
        "it": [
          "Una pulizia a tutto campo!\n\nAppuntamento alle 9.00 alla Salle les Charmes il 16 marzo per l'ottava edizione di Clean Up Nature.\nDurata: 3 ore"
        ],
        "fr": [
          "Un nettoyage grandeur nature !\n\nRendez-vous à 9 h 00 à la salle les charmes le 16 mars pour la 8 éditions de nettoyons la nature.\nDurée : 3 heures"
        ],
        "es": [
          "¡Una limpieza a gran escala!\n\nCita a las 9.00 h en la Salle les Charmes el 16 de marzo para la 8ª edición de A Limpiar la Naturaleza.\nDuración: 3 horas"
        ],
        "nl": [
          "Een grote schoonmaak!\n\nKom op 16 maart om 9.00 uur naar de Salle les Charmes voor de 8e editie van Clean Up Nature.\nDuur: 3 uur"
        ]
      },
