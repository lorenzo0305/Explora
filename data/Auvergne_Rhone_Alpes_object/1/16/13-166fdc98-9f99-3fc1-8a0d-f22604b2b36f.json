  "rdfs:comment": {
    "de": [
      "Lust auf eine leckere Pause zwischen den Läufen? \r\nDann genießen Sie Crêpes, bretonische Galettes, regionale Spezialitäten, hausgemachte Omeletts, Burger und täglich wechselnde Suppen – dazu ein belgisches Bier und den Blick auf den Mont Blanc. Gemütliche Brasserie und Schnellimbiss."
    ],
    "en": [
      "Need a tasty break between runs?\r\nEnjoy crêpes, Breton galettes, local specialties, homemade omelets, burgers, and daily soups, all with a Belgian beer and a view of Mont Blanc.\r\nFriendly brasserie and fast food."
    ],
    "it": [
      "Avete bisogno di una pausa gourmet tra due discese?\r\nGustate crêpes, galettes bretonnes, specialità, omelette fatte in casa, hamburger e zuppe del giorno, il tutto servito con una birra belga con vista sul Monte Bianco.\r\nBrasserie accogliente e fast food."
    ],
    "fr": [
      "Besoin d’une pause gourmande entre deux descentes ? \r\nSavourez des crêpes, galettes bretonnes, spécialités, omelettes maison, burgers et soupes du jour, le tout avec une bière belge face au Mont-Blanc. \r\nBrasserie conviviale et restauration rapide."
    ],
    "es": [
      "¿Necesita un descanso gastronómico entre dos descensos?\r\nDisfrute de crepes, galettes bretonnes, especialidades, tortillas caseras, hamburguesas y sopas del día, todo ello servido con una cerveza belga con vistas al Mont Blanc.\r\nBrasserie acogedora y comida rápida."
    ],
    "nl": [
      "Behoefte aan een gastronomische pauze tussen twee afdalingen?\r\nGeniet van crêpes, galettes bretonnes, specialiteiten, huisgemaakte omeletten, hamburgers en soepen van de dag, allemaal geserveerd met een Belgisch biertje met uitzicht op de Mont Blanc.\r\nVriendelijke brasserie en fastfood."
    ]
  },
