  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aa657f8f-0b12-3f46-bdca-837241a442f1",
      "dc:description": {
        "de": [
          "CIDRERIE DES ANGES\nApfelwein, Himbeerwein, Birnenwein, Apfelsaft,Apfelsaft, Birnensaft, Apfelessig, Marmeladen,\nfrüchte der Saison, gefüllte Körbe und Kisten."
        ],
        "en": [
          "CIDRERIE DES ANGES\nCiders, raspberry ciders, perry, apple juice, apple-pear juice, pear juice, cider vinegar, jams,\nseasonal fruits, baskets and gift boxes."
        ],
        "it": [
          "CIDRERIE DES ANGES\nSidro, sidro di lamponi, sidro di pere, succo di mela, succo di mela e pera, aceto di sidro, marmellate,\nfrutta di stagione, cesti e confezioni regalo."
        ],
        "fr": [
          "CIDRERIE DES ANGES\nCidres, cidres à la framboise, poiré,  jus de  pomme,jus pomme poire, jus de poire, vinaigre de cidre, confitures, \nfruits de saison, paniers et coffrets garnis."
        ],
        "es": [
          "CIDRERIE DES ANGES\nSidras, sidras de frambuesa, perada, zumo de manzana, zumo de manzana-pera, zumo de pera, vinagre de sidra, mermeladas,\nfruta de temporada, cestas y cajas de regalo."
        ],
        "nl": [
          "CIDRERIE DES ANGES\nCider, frambozencider, perencider, appelsap, appel-perensap, perensap, appelazijn, confituur,\nseizoensfruit, manden en geschenkdozen."
        ]
      },
      "@type": [
        "Description"
      ],
