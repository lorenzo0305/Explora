  "rdfs:comment": {
    "de": [
      "Am Steg neben dem Strand können Sie Ihr Elektroboot für 7 Personen (ohne Führerschein), Ihr Paddle, Tretboot, Kanu oder Kajak mieten."
    ],
    "en": [
      "On the dock next to the beach, rent your 7-seater electric boat (no license required), paddleboard, pedal boat, canoe, or kayak."
    ],
    "it": [
      "Noleggiate una barca elettrica a 7 posti (non è richiesta la patente nautica), un pedalò, una canoa o un kayak dal pontile vicino alla spiaggia."
    ],
    "fr": [
      "Sur le ponton situé à côté de la plage, louez votre bateau électrique 7 places (sans permis), votre paddle, pédalo, canoë ou kayak."
    ],
    "nl": [
      "Huur een 7-persoons elektrische boot (geen vaarbewijs nodig), peddel, waterfiets, kano of kajak vanaf het ponton naast het strand."
    ],
    "es": [
      "Alquile una embarcación eléctrica de 7 plazas (no se necesita licencia), un remo, un pedaló, una canoa o un kayak en el pantalán situado junto a la playa."
    ]
  },
