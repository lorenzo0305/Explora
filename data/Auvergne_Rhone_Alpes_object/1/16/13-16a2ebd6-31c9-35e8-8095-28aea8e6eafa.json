          "additionalInformation": {
            "de": [
              "An Feiertagen geschlossen\r\n\r\nGeöffnet von Dienstag bis Freitag von 17:00 bis 19:00 Uhr und am Samstag von 10:00 bis 12:00 Uhr und von 17:00 bis 19:00 Uhr.\r\n\r\nPräsenz auf dem Markt in Nivolas Vermelle am Samstagmorgen"
            ],
            "en": [
              "Closed on public holidays\r\n\r\nOpen Tuesday to Friday from 5pm to 7pm and Saturday from 10am to 12pm and from 5pm to 7pm.\r\n\r\nPresent at the Nivolas Vermelle market on Saturday mornings"
            ],
            "it": [
              "Chiuso nei giorni festivi\r\n\r\nAperto da martedì a venerdì dalle 17.00 alle 19.00 e sabato dalle 10.00 alle 12.00 e dalle 17.00 alle 19.00.\r\n\r\nPresente al mercato di Nivolas Vermelle il sabato mattina"
            ],
            "fr": [
              "Fermeture les jours fériés\r\n\r\nOuvert du Mardi au vendredi de 17h à 19h et le samedi de 10h à 12h et de 17h à 19h. \r\n\r\nPrésence sur le marché de Nivolas Vermelle le samedi matin"
            ],
            "nl": [
              "Gesloten op feestdagen\r\n\r\nGeopend van dinsdag t/m vrijdag van 17.00 tot 19.00 uur en zaterdag van 10.00 tot 12.00 uur en van 17.00 tot 19.00 uur.\r\n\r\nAanwezig op de markt van Nivolas Vermelle op zaterdagochtend"
            ],
            "es": [
              "Cerrado los días festivos\r\n\r\nAbierto de martes a viernes de 17.00 a 19.00 h. y los sábados de 10.00 a 12.00 h. y de 17.00 a 19.00 h.\r\n\r\nPresente en el mercado de Nivolas Vermelle los sábados por la mañana"
            ]
          },
