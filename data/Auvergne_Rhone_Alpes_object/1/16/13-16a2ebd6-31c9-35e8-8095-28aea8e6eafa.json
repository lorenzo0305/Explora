  "rdfs:comment": {
    "de": [
      "Züchter und Produzent von Bauernhofkäse aus reiner Ziegenmilch.\r\nWir bieten frischen, gewürzten, cremigen, aschfahlen, trockenen und gereiften Käse sowie Käse vom Typ Camembert, gepressten Tomme, Ziegenblaukäse und Ziegenraclette an"
    ],
    "en": [
      "Breeder and producer of pure farmhouse goat cheeses.\r\nWe offer fresh, seasoned, creamy, ashed, dry and ripened cheeses, as well as Camembert, pressed tomme, blue goat and raclette goat cheeses"
    ],
    "it": [
      "Allevatore e produttore di formaggi di pura capra di fattoria.\r\nOffriamo formaggi freschi, stagionati, cremosi, inceneriti, secchi e stagionati, oltre a Camembert, tomme pressato, capra blu e raclette"
    ],
    "fr": [
      "Éleveur et producteur de fromages fermiers  pur chèvre.\r\nNous proposons des fromages frais, assaisonnés, crémeux, cendrés, secs et affinés ainsi que des fromages type camembert, de la tomme pressée, bleu de chèvre et raclette de chèvre"
    ],
    "nl": [
      "Fokker en producent van zuivere boerengeitenkazen.\r\nWe bieden verse, gekruide, romige, geschroeide, droge en gerijpte kazen, maar ook Camembert, geperste tomme, blauwe geit en raclette geitenkazen"
    ],
    "es": [
      "Criador y productor de quesos de pura leche de cabra de granja.\r\nOfrecemos quesos frescos, curados, cremosos, con ceniza, secos y madurados, así como quesos de cabra Camembert, tomme prensado, cabra azul y raclette"
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC La chèvrerie du Rafour"
    ]
  },
