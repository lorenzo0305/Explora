  "rdfs:comment": {
    "de": [
      "Das Bar Restaurant du Tourisme liegt ideal im Herzen des Dorfes und nur wenige Schritte von den Skiliften entfernt. Es ist der Ort für alle Ihre Gourmetpausen."
    ],
    "en": [
      "Ideally located in the heart of the village and a stone's throw from the ski lifts, the Bar Restaurant du Tourisme is the place for all your gourmet breaks."
    ],
    "it": [
      "Situato in posizione ideale nel cuore del villaggio e a due passi dagli impianti di risalita, il Bar Restaurant du Tourisme è il luogo ideale per tutte le vostre pause gastronomiche."
    ],
    "fr": [
      "Idéalement situé au cœur du village et à deux pas des remontées mécaniques, le Bar Restaurant du Tourisme est l'endroit pour toutes vos pauses gourmandes."
    ],
    "es": [
      "Idealmente situado en el corazón del pueblo y a dos pasos de los remontes, el Bar Restaurante du Tourisme es el lugar ideal para todas sus estancias gastronómicas."
    ],
    "nl": [
      "Bar Restaurant du Tourisme, ideaal gelegen in het hart van het dorp en op een steenworp afstand van de skiliften, is de plek bij uitstek voor al uw gastronomische breaks."
    ]
  },
