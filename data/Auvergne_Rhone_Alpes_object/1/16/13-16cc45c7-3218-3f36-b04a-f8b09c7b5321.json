  "rdfs:comment": {
    "de": [
      "Züchter von Bresse-Geflügel. Verkauf und Bestellung von Poulet de Bresse auf Reservierung je nach Verfügbarkeit. Priorität im Restaurant unserer Ferme-auberge \"Bienvenue à la Ferme\"."
    ],
    "en": [
      "Breeder of Bresse poultry. Sale and order of Bresse chicken by reservation, subject to availability. Priority given to our \"Bienvenue à la Ferme\" farmhouse restaurant."
    ],
    "it": [
      "Allevatore di pollame della Bresse. Vendita e ordinazione di pollo di Bresse su prenotazione, in base alla disponibilità. Priorità al nostro ristorante agrituristico \"Bienvenue à la Ferme\"."
    ],
    "fr": [
      "Eleveur de volaille de Bresse. Vente et commande de Poulet de Bresse sur réservation en fonction de la disponibilité. priorité au restaurant de notre Ferme-auberge \"Bienvenue à la Ferme\"."
    ],
    "nl": [
      "Bressepluimveehouder. Verkoop en bestelling van Bressekippen op afspraak, afhankelijk van beschikbaarheid. Voorrang voor ons boerderijrestaurant \"Bienvenue à la Ferme\"."
    ],
    "es": [
      "Avicultor de Bresse. Venta y pedido de pollo de Bresse previo acuerdo, según disponibilidad. Prioridad a nuestro restaurante granja \"Bienvenue à la Ferme\"."
    ]
  },
