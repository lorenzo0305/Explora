  "rdfs:comment": {
    "de": [
      "10 Minuten von Montluçon entfernt können Sie für eine Mahlzeit ins Land des Lächelns reisen. Der erste Bissen versetzt Sie sofort nach Thailand!"
    ],
    "en": [
      "Just 10 minutes from Montluçon, come and travel to the land of smiles for a meal. The first bite transports you immediately to Thailand!"
    ],
    "it": [
      "A soli 10 minuti da Montluçon, venite a mangiare nella terra del sorriso. Il primo boccone vi trasporterà immediatamente in Thailandia!"
    ],
    "fr": [
      "À 10 minutes de Montluçon, venez voyager au pays du sourire le temps d'un repas. La première bouchée vous transporte immédiatement en Thaïlande !"
    ],
    "nl": [
      "Kom op slechts 10 minuten van Montluçon eten in het land van de glimlach. De eerste hap brengt je meteen naar Thailand!"
    ],
    "es": [
      "A sólo 10 minutos de Montluçon, venga a comer al país de las sonrisas. ¡El primer bocado le transportará inmediatamente a Tailandia!"
    ]
  },
