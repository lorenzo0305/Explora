  "rdfs:comment": {
    "de": [
      "Zu den Überresten der Stätte gehört ein 67 m² großes polychromes Mosaik, das den Gott des Ozeans darstellt. Das Pflaster stammt aus dem 2. Jahrhundert und schmückte den Boden des Empfangsraums einer großen römischen Villa."
    ],
    "en": [
      "The site allows to appreciate, among other remains, a polychrome mosaic of more than 67 m² representing the Ocean God. Dating from the 2nd century, the pavement adorned the floor of the reception room of a large Roman villa."
    ],
    "it": [
      "Il sito permette di apprezzare, tra gli altri resti, un mosaico policromo di oltre 67 m² che rappresenta il Dio Oceano. Risalente al II secolo, la pavimentazione ornava il pavimento della sala di rappresentanza di una grande villa romana."
    ],
    "fr": [
      "Le site permet d’apprécier, entre autres vestiges, une mosaïque polychrome de plus de 67 m² représentant le Dieu Océan. Datant du IIe siècle, le pavement ornait le sol de la salle de réception d’une grande villa romaine."
    ],
    "nl": [
      "Op de site kunnen we onder andere een polychroom mozaïek van meer dan 67 m² bewonderen dat de God van de Oceaan voorstelt. Het plaveisel dateert uit de 2e eeuw en sierde de vloer van de ontvangstruimte van een grote Romeinse villa."
    ],
    "es": [
      "El yacimiento permite apreciar, entre otros restos, un mosaico policromado de más de 67 m² que representa al Dios Océano. El pavimento, que data del siglo II, adornaba el suelo de la sala de recepción de una gran villa romana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Villa de Licinius"
    ]
  },
