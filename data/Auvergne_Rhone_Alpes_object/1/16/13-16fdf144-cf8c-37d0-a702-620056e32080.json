  "rdfs:comment": {
    "de": [
      "Gourmet-Restaurant in einem schlichten, hellen Rahmen mit Blick auf das Ardèche-Tal. Marktküche mit lokalen und saisonalen Produkten. Im Sommer schattige Terrasse unter jahrhundertealten Platanen."
    ],
    "en": [
      "Gourmet restaurant in a refined, bright setting overlooking the Ardèche valley. Market cuisine using local, seasonal produce. In summer, there's a shady terrace under the hundred-year-old plane trees."
    ],
    "it": [
      "Ristorante gourmet in un ambiente raffinato e luminoso con vista sulla valle dell'Ardèche. Cucina di mercato con prodotti locali e di stagione. In estate c'è una terrazza ombreggiata sotto i platani centenari."
    ],
    "fr": [
      "Restaurant gastronomique dans un cadre épuré, lumineux, avec vue sur la vallée de l'Ardèche. Cuisine du marché avec des produits locaux et de saison. En été, terrasse ombragée sous les platanes centenaires."
    ],
    "es": [
      "Restaurante gastronómico en un marco refinado y luminoso con vistas al valle del Ardèche. Cocina de mercado con productos locales de temporada. En verano, terraza a la sombra de plátanos centenarios."
    ],
    "nl": [
      "Gastronomisch restaurant in een verfijnde, lichte omgeving met uitzicht op de vallei van de Ardèche. Marktkeuken met lokale, seizoensgebonden producten. In de zomer is er een schaduwrijk terras onder de honderd jaar oude platanen."
    ]
  },
