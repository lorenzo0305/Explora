  "rdfs:comment": {
    "de": [
      "Atelier für freien Ausdruck mit allen Zeichen- und Maltechniken für Kinder ab 6 Jahren, Jugendliche und Erwachsene.\r\nPastell, Kohle, Rötel, Ölmalerei, Acrylmalerei, Aquarell, Tinte."
    ],
    "en": [
      "Free expression workshop in all drawing and painting techniques for children aged 6 and over, teens and adults.\r\nDry pastel, charcoal, sanguine, oil paint, acrylic paint, watercolor, ink."
    ],
    "it": [
      "Laboratorio di espressione gratuito in tutte le tecniche di disegno e pittura per bambini dai 6 anni, adolescenti e adulti.\r\nPastello secco, carboncino, sanguigna, pittura a olio, pittura acrilica, acquerello, inchiostro."
    ],
    "fr": [
      "Atelier d' expression libre toutes techniques de dessin et peinture pour enfants à partir de 6 ans, ados et adultes.\r\nPastel sec, fusain, sanguine, peinture à l'huile, peinture acrylique, aquarelle, encre."
    ],
    "es": [
