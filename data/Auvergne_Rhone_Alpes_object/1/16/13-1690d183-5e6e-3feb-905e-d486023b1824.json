  "rdfs:comment": {
    "de": [
      "Die Domaine Goudard & Filles produziert seit 2023 den IGP Collines Rhodaniennes und den Saint Joseph. Wir bearbeiten 7 Hektar Weinberge in Hanglage, die auf biologischen Landbau umgestellt werden."
    ],
    "en": [
      "Since 2023, this 7h. estate works with the designation Saint Joseph and Collines Rhodaniennes. All organic, this wineyard will pleased you !"
    ],
    "it": [
      "Il Domaine Goudard & Filles produce vini IGP Collines Rhodaniennes e Saint Joseph dal 2023. Coltiviamo 7 ettari di vigne in collina con metodi di agricoltura biologica."
    ],
    "fr": [
      "Le Domaine Goudard & Filles produit depuis 2023 de l'IGP Collines Rhodaniennes et du Saint Joseph. Nous travaillons 7 hectares de vignes en coteaux en Agriculture Biologique."
    ],
    "es": [
      "El Domaine Goudard & Filles elabora vinos IGP Collines Rhodaniennes y Saint Joseph desde 2023. Cultivamos 7 hectáreas de viñedos en ladera con métodos de agricultura ecológica."
    ],
    "nl": [
      "Domaine Goudard & Filles produceert sinds 2023 IGP Collines Rhodaniennes en Saint Joseph wijnen. We bewerken 7 hectare wijngaarden in de heuvels, in omschakeling naar biologische landbouw."
    ]
  },
