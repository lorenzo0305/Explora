  "rdfs:comment": {
    "de": [
      "l'Estaminet, ein traditionelles Restaurant und Bar in Saint-Julien Chapteuil, einem kleinen, dynamischen Dorf im Département Haute Loire, bietet eine saisonale Speisekarte.\r\n\r\nDer Chefkoch kocht nur mit frischen und saisonalen Produkten."
    ],
    "en": [
      "l'Estaminet, a traditional restaurant and bar, located in Saint-Julien Chapteuil, a small, dynamic village in the Haute Loire, offers a seasonal menu.\r\n\r\nThe chef cooks only fresh and seasonal products."
    ],
    "it": [
      "l'Estaminet, un ristorante e bar tradizionale, situato a Saint-Julien Chapteuil, un piccolo e dinamico villaggio dell'Alta Loira, offre un menu stagionale.\r\n\r\nLo chef cucina solo prodotti freschi e di stagione."
    ],
    "fr": [
      "l’Estaminet, restaurant bar traditionnel , situé à Saint-Julien Chapteuil, petit village dynamique de haute loire, propose une carte de saison.\r\n\r\nLe chef cuisine uniquement des produits frais et de saison."
    ],
    "es": [
      "l'Estaminet, restaurante y bar tradicional, situado en Saint-Julien Chapteuil, un pequeño y dinámico pueblo del Alto Loira, ofrece un menú de temporada.\r\n\r\nEl chef sólo cocina productos frescos y de temporada."
    ],
    "nl": [
      "l'Estaminet, een traditioneel restaurant en bar, gelegen in Saint-Julien Chapteuil, een klein dynamisch dorp in de Haute Loire, biedt een seizoensgebonden menu.\r\n\r\nDe chef-kok kookt uitsluitend verse en seizoensgebonden producten."
    ]
  },
