  "rdfs:comment": {
    "de": [
      "Das Naturbeobachtungszentrum auf der Île du Beurre ist ein Verein, der sich die Verwaltung, Erhaltung und Aufwertung eines bemerkenswerten Naturraums zur Aufgabe gemacht hat."
    ],
    "en": [
      "The Centre d'observation de la nature de l'Île du Beurre is an association whose mission is to manage, preserve and promote a remarkable natural area."
    ],
    "it": [
      "Il Centre d'observation de la nature de l'Île du Beurre è un'associazione che ha come missione la gestione, la conservazione e la promozione di uno straordinario spazio naturale sulle rive del Rodano."
    ],
    "fr": [
      "Le Centre d’observation de la nature de l’Île du Beurre est une association qui a pour mission la gestion, la préservation et la valorisation d’un espace naturel remarquable au bord du Rhône."
    ],
    "nl": [
      "Het Centre d'observation de la nature de l'Île du Beurre is een vereniging met als missie het beheren, behouden en promoten van een opmerkelijk natuurgebied aan de oevers van de Rhône."
    ],
    "es": [
      "El Centre d'observation de la nature de l'Île du Beurre es una asociación cuya misión es gestionar, preservar y promover un espacio natural excepcional a orillas del Ródano."
    ]
  },
