  "rdfs:comment": {
    "de": [
      "Der Garten des ethnobotanischen Wissens: Ein botanischer Garten, der frei zugänglich ist und Führungen und Workshops rund um Pflanzen und Botanik, aber auch historische und thematische Führungen zu alten Fertigkeiten anbietet."
    ],
    "en": [
      "‘Le Jardin’ is a dedicated to ethno-botanical science : it is a botanical garden open to all free of charge. Its gardeners offer guided tours and workshops around plants, botanical science but also historical and ancient know-how."
    ],
    "it": [
      "Il Giardino delle Conoscenze Etnobotaniche: un giardino botanico aperto al pubblico, che offre visite guidate e laboratori sulle piante e sulla botanica, oltre a visite storiche e tematiche sulle antiche abilità."
    ],
    "fr": [
      "Le Jardin des savoirs ethnobotaniques : jardin botanique accessible en visite libre, proposant des visites guidées et des ateliers autours des plantes, de la botanique, mais aussi des visites historiques et thématiques sur des savoir-faire anciens."
    ],
    "es": [
      "El Jardín del Conocimiento Etnobotánico: un jardín botánico abierto al público que ofrece visitas guiadas y talleres sobre plantas y botánica, así como visitas históricas y temáticas sobre oficios antiguos."
    ],
    "nl": [
      "De Tuin van Etnobotanische Kennis: een botanische tuin die open is voor het publiek en waar rondleidingen en workshops over planten en plantkunde worden aangeboden, evenals historische en thematische rondleidingen over oude vaardigheden."
    ]
  },
  "rdfs:label": {
