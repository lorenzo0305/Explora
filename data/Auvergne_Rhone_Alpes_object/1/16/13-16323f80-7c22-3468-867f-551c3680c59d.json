  "rdfs:comment": {
    "de": [
      "Dominique Dubray hat vor zehn Jahren das Hotel und Restaurant La Bougnate übernommen. Es ist ein Ort der Geselligkeit und des Genusses, der Charme und Gaumenfreuden verbindet, um angenehme Momente zu verbringen."
    ],
    "en": [
      "Dominique Dubray took over La Bougnate hotel-restaurant 10 years ago, a place of conviviality and pleasure, combining charm and gourmet delights."
    ],
    "it": [
      "Dominique Dubray ha rilevato l'hotel e il ristorante La Bougnate 10 anni fa, creando un ambiente accogliente e piacevole che unisce fascino e delizie gastronomiche."
    ],
    "fr": [
      "Dominique Dubray a repris l'hôtel restaurant La Bougnate il y a 10 ans, un lieu de convivialité et de plaisir alliant charme et gourmandise pour passer d'agréables moments."
    ],
    "es": [
      "Dominique Dubray se hizo cargo del hotel y restaurante La Bougnate hace 10 años, creando un entorno agradable y acogedor que combina encanto y delicias gastronómicas."
    ],
    "nl": [
      "Dominique Dubray nam 10 jaar geleden hotel en restaurant La Bougnate over en creëerde een vriendelijke, aangename omgeving die charme en gastronomische hoogstandjes combineert."
    ]
  },
