  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen :\r\n- sportliche, kulturelle und Freizeitaktivitäten\r\n- Ausflüge für einen halben Tag, einen ganzen Tag, Wochenenden\r\n- Reisen in Frankreich\r\n- Konferenzen\r\n- monatliche Mahlzeiten\r\n- Nachbarschaftsclubs (Instants Loisirs)\r\n- Dienstleistungen"
    ],
    "en": [
      "We offer :\r\n- sports, cultural and leisure activities\r\n- 1/2-day, full-day and weekend outings\r\n- trips to France\r\n- conferences\r\n- monthly meals\r\n- neighborhood clubs (instants loisirs)\r\n- services"
    ],
    "it": [
      "Vi offriamo :\r\n- attività sportive, culturali e ricreative\r\n- gite di mezza giornata, giornata intera e weekend\r\n- viaggi in Francia\r\n- conferenze\r\n- pasti mensili\r\n- club di quartiere (tempo libero)\r\n- servizi"
    ],
    "fr": [
      "Nous vous proposons :\r\n- des activités sportives, culturelles, de loisirs\r\n- des sorties à la 1/2 journée , à la journée, des week-end\r\n- des voyages en France \r\n- des conférences\r\n- des repas mensuels\r\n- des clubs de quartiers (instants loisirs)\r\n- des services"
    ],
    "nl": [
      "Wij bieden :\r\n- sportieve, culturele en vrijetijdsactiviteiten\r\n- uitstapjes van een halve dag, een hele dag of een weekend\r\n- uitstapjes naar Frankrijk\r\n- conferenties\r\n- maandelijkse maaltijden\r\n- buurtclubs (instants loisirs)\r\n- diensten"
    ],
    "es": [
      "Le ofrecemos :\r\n- actividades deportivas, culturales y de ocio\r\n- salidas de medio día, día completo y fin de semana\r\n- viajes por Francia\r\n- conferencias\r\n- comidas mensuales\r\n- clubes de barrio (tiempo libre)\r\n- servicios"
    ]
  },
