  "rdfs:comment": {
    "de": [
      "Auf 1850 m Höhe ist diese Einrichtung mit einem atypischen Konzept zwischen Hotel und Berghütte mit der Seilbahn erreichbar. Es verfügt über 20 Zimmer, eine Penthouse-Suite, Schwimmbad, Spa, Bowlingbahn und ein Restaurant mit Panoramablick auf den Mont-Blanc."
    ],
    "en": [
      "At an altitude of 1850 m, this atypical mountain refuge-hotel concept is accessible by gondola. Featuring 20 rooms, a penthouse suite, swimming pool, spa, bowling alley and restaurant with panoramic views of Mont Blanc."
    ],
    "it": [
      "A 1850 m di altitudine, questo hotel atipico e rifugio di montagna è raggiungibile con la cabinovia. Dispone di 20 camere, una suite attico, piscina, spa, pista da bowling e un ristorante con vista panoramica sul Monte Bianco."
    ],
    "fr": [
      "À 1850 m d'altitude, cet établissement au concept atypique entre hôtellerie et refuge de montagne est accessible en télécabine. Doté de 20 chambres, d'une suite penthouse, piscine, spa, bowling et un restaurant avec vue panoramique sur le Mont-Blanc."
    ],
    "nl": [
      "Dit atypische hotel en berghut ligt op 1850 m hoogte en is bereikbaar met de gondel. Het heeft 20 kamers, een penthouse suite, zwembad, spa, bowlingbaan en een restaurant met panoramisch uitzicht op de Mont Blanc."
    ],
    "es": [
      "A 1850 m de altitud, este atípico hotel y refugio de montaña es accesible en telecabina. Dispone de 20 habitaciones, una suite en el ático, piscina, spa, bolera y un restaurante con vistas panorámicas al Mont Blanc."
    ]
  },
