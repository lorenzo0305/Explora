  "rdfs:comment": {
    "de": [
      "Sein Industriegebäude sieht aus wie eine Skaterrampe; es beherbergt eine Bowl (kursiv) und einen Streetbereich (kursiv) aus Holz, die von der Betreibervereinigung Session Libre entworfen wurden."
    ],
    "en": [
      "In an industrial building, whose roof reminds the design of a skate ramp, the riders practise in a bowl and wood “street” area."
    ],
    "it": [
      "L'edificio industriale ha l'aspetto di una rampa da skateboard; ospita una vasca (in corsivo) e una parte di strada in legno (in corsivo) progettata dall'associazione di gestione Session Libre."
    ],
    "fr": [
      "Son bâtiment industriel a des allures de rampe de skate ; il abrite un bowl (italique) et une partie street (italique) en bois conçues par l’association gestionnaire Session Libre."
    ],
    "nl": [
      "Het industriële gebouw ziet eruit als een skateboardhelling; het herbergt een houten kom (cursief) en een straatgedeelte (cursief), ontworpen door de beheersvereniging Session Libre."
    ],
    "es": [
      "En una nave industrial cuyo techo recuerda el diseño de una rampa de skate, los practicantes se entrenan en un “bowl” y en un espacio “street” en madera."
    ]
  },
