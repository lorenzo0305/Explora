  "rdfs:comment": {
    "de": [
      "Als eine Oase der Ruhe, die direkt auf die Natur reicht, zwischen See und Bergen gelegen, bietet Ihnen der Pavillon des Wohlbefindens im Hotel Les Trésoms maßgeschneiderte Erholungsreisen und Pflegeanwendungen für höchste Ansprüche an."
    ],
    "en": [
      "Discover Mont Spa Les Trésoms, a haven of peace nestled between lake and mountains, in the heart of the LesTrésoms hotel. We offer tailor-made journeys and demanding treatment protocols for a unique experience of well-being."
    ],
    "it": [
      "Scoprite la Mont Spa Les Trésoms, un'oasi di pace incastonata tra lago e montagne, nel cuore dell'hotel LesTrésoms. Offriamo percorsi su misura e protocolli di trattamento esigenti per un'esperienza di benessere unica."
    ],
    "fr": [
      "Découvrez MontSpa Les Trésoms, un véritable havre de paix niché entre lac et montagnes, au cœur de l'hôtel Les Trésoms. Nous vous offrons des voyages sur mesure et des protocoles de soins exigeants pour une expérience unique de bien-être."
    ],
    "nl": [
      "Ontdek Mont Spa Les Trésoms, een oase van rust tussen het meer en de bergen, in het hart van het hotel Les Trésoms. Wij bieden op maat gemaakte reizen en veeleisende behandelingsprotocollen voor een unieke ervaring van welzijn."
    ],
    "es": [
      "Descubra MontSpa Les Trésoms, un verdadero remanso de paz entre lago y montaña, en el corazón del hotel Les Trésoms. Ofrecemos viajes a medida y exigentes protocolos de tratamiento para una experiencia única de bienestar."
    ]
  },
