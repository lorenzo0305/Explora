    {
      "@id": "https://data.datatourisme.fr/b66a1ff6-b3df-34d4-bd2b-9fdd44bc127e",
      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nDienstag bis Freitag: 8.30-12.30 Uhr / 15.00-19.00 Uhr\nSamstag: 8.30-13.00 Uhr / 15.00-18.00 Uhr\n \n Bestellungen:\nKontaktieren Sie den Laden per Telefon unter 03 21 71 01 22\n\nAbholung:\nZu den Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nTuesday to Friday: 8:30am-12:30pm / 3pm-7pm\nSaturday: 8h30-13h / 15h-18h\n \n Orders :\nContact the store by telephone on 03 21 71 01 22\n\nCollection :\nDuring store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDa martedì a venerdì: 8.30-12.30 / 15.00-19.00\nSabato: 8h30-13h / 15h-18h\n \n Ordini :\nContattare il negozio per telefono al numero 03 21 71 01 22\n\nRitiro :\nDurante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nDu mardi au vendredi: 8h30-12h30 / 15h-19h\nLe samedi: 8h30-13h / 15h-18h\n \n Commandes :\nContacter le magasin par téléphone au 03 21 71 01 22\n\nRetrait :\nAu horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nDinsdag tot vrijdag: 8u30-12u30 / 15u-19u\nZaterdag: 8u30-13u / 15u-18u\n \n Bestellingen :\nNeem telefonisch contact op met de winkel op 03 21 71 01 22\n\nAfhalen :\nTijdens de openingsuren van de winkel\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe martes a viernes: 8h30-12h30 / 15h-19h\nSábado: 8h30-13h / 15h-18h\n \n Pedidos :\nPóngase en contacto con la tienda por teléfono llamando al 03 21 71 01 22\n\nRecogida :\nDurante el horario de apertura de la tienda\n\n\n "
        ]
      },
