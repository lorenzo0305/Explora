  "rdfs:comment": {
    "de": [
      "Der Creux de l'Enfer befindet sich im symbolträchtigen Tal der Fabriken von Thiers und erstreckt sich über zwei außergewöhnliche Industriegebäude oberhalb des Flusses Durolle."
    ],
    "en": [
      "The Contemporary Arts Centre in the Creux de l’enfer is located in the Valley of the Factories. This place promotes contemporary artistic creativity and promotes the meeting between arts and audiences."
    ],
    "it": [
      "Situato nell'emblematico sito della Vallée des Usines a Thiers, Le Creux de l'Enfer si sviluppa su due eccezionali edifici industriali sopra il fiume Durolle."
    ],
    "fr": [
      "Situé dans le site emblématique de la Vallée des Usines de Thiers, le Creux de l’Enfer se déploie sur deux bâtiments industriels exceptionnels au-dessus de la Durolle."
    ],
    "es": [
      "Situado en el emblemático emplazamiento de Vallée des Usines, en Thiers, Le Creux de l'Enfer se distribuye en dos excepcionales edificios industriales sobre el río Durolle."
    ],
    "nl": [
      "Le Creux de l'Enfer ligt op de emblematische site Vallée des Usines in Thiers en is verdeeld over twee uitzonderlijke industriële gebouwen boven de rivier de Durolle."
    ]
  },
  "rdfs:label": {
    "en": [
