  "rdfs:comment": {
    "de": [
      "Dieser gemeinsam genutzte Weg, der sowohl für Fußgänger als auch für Radfahrer zugänglich ist, verbindet heute die Dörfer Farges und Péron und bietet eine angenehme Route inmitten der Natur."
    ],
    "en": [
      "This shared path, accessible to both pedestrians and cyclists, now links the villages of Farges and Péron, offering a pleasant route in the heart of nature."
    ],
    "it": [
      "Questo sentiero condiviso, accessibile sia ai pedoni che ai ciclisti, collega ora i villaggi di Farges e Péron, offrendo un piacevole percorso nel cuore della natura."
    ],
    "fr": [
      "Cette piste partagée, accessible aux piétons comme aux cyclistes, relie aujourd’hui les villages de Farges et de Péron en offrant un itinéraire agréable au cœur de la nature."
    ],
    "es": [
      "Este camino compartido, accesible tanto para peatones como para ciclistas, une ahora los pueblos de Farges y Péron, ofreciendo un agradable recorrido en plena naturaleza."
    ],
    "nl": [
      "Dit gedeelde pad, toegankelijk voor zowel voetgangers als fietsers, verbindt nu de dorpen Farges en Péron en biedt een aangename route door het hart van de natuur."
    ]
  },
  "rdfs:label": {
    "de": [
      "Voie verte: Farges - Péron"
    ],
    "en": [
      "Voie verte: Farges - Péron"
    ],
    "fr": [
      "Voie verte : Farges - Péron"
    ]
  },
