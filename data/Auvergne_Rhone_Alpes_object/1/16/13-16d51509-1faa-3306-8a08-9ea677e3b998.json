  "rdfs:comment": {
    "de": [
      "Das Le 1013 befindet sich im Zentrum von Chabreloche gegenüber einem großen Platz, auf dem Sie problemlos parken können. Wir bieten Ihnen eine hausgemachte Küche mit frischen Produkten. Denken Sie daran, 48 Stunden im Voraus für unsere Spezialitäten zu reservieren: Frosch und Kalbsbries!"
    ],
    "en": [
      "The 1013 is located in the centre of Chabreloche in front of a large square where you can easily park. We offer you a home cooking with fresh products. Remember to book 48 hours in advance for our specialities: frog and sweetbreads!"
    ],
    "it": [
      "Le 1013 si trova nel centro di Chabreloche di fronte a una grande piazza dove è possibile parcheggiare facilmente. Offriamo una cucina casalinga a base di prodotti freschi. Non dimenticate di prenotare con 48 ore di anticipo le nostre specialità: le animelle di rana e di vitello!"
    ],
    "fr": [
      "Le 1013 se situe dans le centre de Chabreloche face à une grande place où il vous sera aisé de stationner. Nous vous proposons une cuisine maison à base de produits frais. Pensez à réserver 48h à l’avance pour nos spécialités : grenouille et ris de veau !"
    ],
    "nl": [
      "Le 1013 ligt in het centrum van Chabreloche tegenover een groot plein waar u gemakkelijk kunt parkeren. Wij bieden een thuiskeuken op basis van verse producten. Vergeet niet 48 uur van tevoren te reserveren voor onze specialiteiten: kikker- en kalfszwezerik!"
    ],
    "es": [
      "Le 1013 está situado en el centro de Chabreloche, frente a una gran plaza donde se puede aparcar fácilmente. Ofrecemos cocina casera a base de productos frescos. No olvide reservar con 48 horas de antelación para nuestras especialidades: ¡las mollejas de rana y de ternera!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge le 1013 - Chez Virginie"
    ]
  },
