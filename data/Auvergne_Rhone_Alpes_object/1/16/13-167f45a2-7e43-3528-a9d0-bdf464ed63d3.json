  "rdfs:comment": {
    "de": [
      "Der Jiva Hill Golf Club in Crozet ist ein 9-Loch-Platz mit 18 Abschlägen, der das ganze Jahr über geöffnet und bespielbar ist. Er ist der erste 9-Loch-Platz in Frankreich und Europa, der Abschläge und Grüns aus Kunstrasen hat."
    ],
    "en": [
      "The Jiva Hill Golf Club in Crozet is a 9-hole course with 18 tee-offs, open and playable all year round. It is the first 9-hole course in France and Europe to feature tee-offs and synthetic turf greens."
    ],
    "it": [
      "Il Jiva Hill Golf Club è un campo a 9 buche con 18 tee ed è il primo campo a 9 buche in Francia e in Europa ad avere tee e green in erba sintetica."
    ],
    "fr": [
      "Le Jiva Hill Golf Club est un parcours de 9 trous comprenant 18 départs est le premier terrain de 9 trous en France et en Europe à présenter des départs et des greens en gazon synthétique."
    ],
    "nl": [
      "Jiva Hill Golf Club is een 9-holesbaan met 18 tees en is de eerste 9-holesbaan in Frankrijk en Europa met tees en greens van kunstgras."
    ],
    "es": [
      "El Jiva Hill Golf Club es un campo de 9 hoyos con 18 tees y es el primer campo de 9 hoyos de Francia y Europa que cuenta con tees y greens de césped sintético."
    ]
  },
