  "rdfs:comment": {
    "de": [
      "Ein spielerischer Spaziergang durch die Kunstwerke der Artothek, bei dem deine Beobachtungsgabe auf die Probe gestellt wird. In jedem Bild gibt es ein oder mehrere Details, die Sie finden müssen. Können Sie diese entdecken?"
    ],
    "en": [
      "A playful walk through the works of art in the artothèque, where your sense of observation will be put to the test. In each painting, one or more details are to be found. Can you spot them?"
    ],
    "it": [
      "Una divertente passeggiata tra le opere d'arte della biblioteca d'arte, dove il vostro senso di osservazione sarà messo alla prova. Ogni dipinto ha uno o più dettagli da trovare. Riuscirete a individuarli?"
    ],
    "fr": [
      "Une promenade ludique au travers des œuvres d'art de l'artothèque où votre sens de l'observation sera mis à rude épreuve. Dans chaque tableau, un ou plusieurs détails sont à retrouver. Saurez-vous les repérer ?"
    ],
    "es": [
      "Un divertido paseo por las obras de arte de la biblioteca de arte, donde se pondrá a prueba tu sentido de la observación. Cada cuadro tiene uno o varios detalles que encontrar. ¿Serás capaz de encontrarlos?"
    ],
    "nl": [
      "Een leuke wandeling door de kunstwerken in de kunstbibliotheek, waarbij je observatievermogen op de proef wordt gesteld. Op elk schilderij zijn een of meer details te vinden. Kun jij ze vinden?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Cherche et trouve dans les tableaux de l'artothèque"
    ]
  },
