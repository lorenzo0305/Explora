  "rdfs:comment": {
    "de": [
      "Flash-Tour ? in Ihrer Eintrittskarte enthalten\r\nLassen Sie sich von einem Fremdenführer in 20 Minuten die wichtigsten Punkte und Schlüssel zum Verständnis der neuen Dauerausstellung Schätze der Sammlungen\" erklären."
    ],
    "en": [
      "Flash Visit ? included in your admission ticket\r\nLet a guide take you on a 20-minute tour of the essentials and key points to understanding the new permanent galleries, Trésors des collections."
    ],
    "it": [
      "Visita Flash? inclusa nel biglietto d'ingresso\r\nLasciate che una guida vi accompagni in un tour di 20 minuti per scoprire gli elementi essenziali e le chiavi di lettura delle nuove gallerie permanenti, Tesori dalle collezioni."
    ],
    "fr": [
      "Visite Flash – inclus dans votre billet d’entrée\r\nLaissez-vous entrainer par un guide pour découvrir en 20 minutes les essentiels et les grandes clés de compréhension des nouvelles salles permanentes, Trésors des collections."
    ],
    "es": [
      "Visita Flash - incluida en la entrada\r\nDeje que un guía le lleve en un recorrido de 20 minutos por lo esencial y las claves para entender las nuevas galerías permanentes, Tesoros de las colecciones."
    ],
    "nl": [
      "Flash Visit ? inbegrepen in je toegangsticket\r\nLaat een gids je meenemen op een 20 minuten durende rondleiding langs de belangrijkste elementen en sleutels tot het begrijpen van de nieuwe permanente galerijen, Schatten uit de collecties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite flash : « Trésors des collections »"
    ]
  },
