  "rdfs:comment": {
    "de": [
      "In Le Bettex auf 1400 m gelegen (Start des Skigebiets)\r\nder Jardin des Neiges und alle Kursstarts sind vor der ..\r\nder ESF zur Bequemlichkeit aller. ."
    ],
    "en": [
      "The ESF French Ski School is located in Le Bettex at 1,400 metres altitude (at\r\nthe foot of the slopes). The nursery slope (jardin des neiges) and the meeting\r\npoints for all ski and snowboard classes are situated directly in front of the\r\nbuilding here."
    ],
    "it": [
      "A 1.400 metri d’altitudine (presso l’ingresso del comprensorio sciistico),\r\nil giardino della neve di Le Bettex e tutti i punti di partenza dei corsi\r\nsono concentrati per comodità davanti alla scuola di sci dell’ESF."
    ],
    "fr": [
      "Situé au Bettex à 1 400 mètres (départ du domaine skiable)\r\nle Jardin des Neiges et tous les départs de cours sont concentrés devant\r\nl’ESF pour la commodité de toutes et tous. ."
    ],
    "es": [
      "Situado en Le Bettex a 1 400 metros (inicio de la zona de esquí)\r\nel Jardin des Neiges y todas las clases se concentran frente al FSE\r\nel FSE para la comodidad de todos."
    ],
    "nl": [
      "Gelegen in Le Bettex op 1 400 meter (begin van het skigebied)\r\nde Jardin des Neiges en alle vertrekpunten van de koersen zijn voor het gemak van iedereen geconcentreerd voor de ESF\r\nhet ESF voor ieders gemak."
    ]
  },
