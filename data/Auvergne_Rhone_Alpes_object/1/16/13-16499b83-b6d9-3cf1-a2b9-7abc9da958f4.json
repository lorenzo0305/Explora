      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/36d0f9cf-03fd-35ee-9e76-1ee78146ad20",
          "schema:validFrom": "2026-12-10T00:00:00",
          "schema:validThrough": "2026-04-10T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "BETTEX-BÜRO: Täglich bis zur Schließung der Station von 8:50 bis 16:30 Uhr (17:30 Uhr während der Schulferien im Februar/März)\r\n\r\nBÜRO VON SAINT-GERVAIS: Täglich bis zur Schließung der Station von 9:00 bis 12:00 Uhr und von 15:00 bis 19:00 Uhr\r\n\r\nAbhängig von den Schneeverhältnissen und den Öffnungszeiten der Skilifte."
            ],
            "en": [
              "BETTEX OFFICE: Every day until the station closes, from 8:50 a.m. to 4:30 p.m. (5:30 p.m. during the February/March school vacations)\r\n\r\nSAINT-GERVAIS OFFICE: Daily until resort closes, from 9:00 am to 12:00 pm and from 3:00 pm to 7:00 pm\r\n\r\nDepending on snow conditions and lift opening dates."
            ],
            "it": [
              "UFFICIO BETTEX: tutti i giorni fino alla chiusura della stazione dalle 8.50 alle 16.30 (17.30 durante le vacanze scolastiche di febbraio/marzo)\r\n\r\nUFFICIO SAINT-GERVAIS: tutti i giorni fino alla chiusura della stazione dalle 9.00 alle 12.00 e dalle 15.00 alle 19.00\r\n\r\nA seconda delle condizioni della neve e delle date di apertura degli impianti."
            ],
            "fr": [
              "BUREAU DU BETTEX : Tous les jours jusqu’à la fermeture de la station de 8h50 à 16h30 (17h30 pendant les vacances scolaires de Février/Mars)\r\n\r\nBUREAU DE SAINT-GERVAIS : Tous les jours jusqu’à la fermeture de la station de 9h00 à 12h00 et de 15h00 19h00\r\n\r\nEn fonction des conditions d'enneigement et des dates d'ouverture des remontées mécaniques."
            ],
            "es": [
              "OFICINA DE BETTEX: todos los días hasta el cierre de la estación, de 8.50 a 16.30 h (17.30 h durante las vacaciones escolares de febrero/marzo)\r\n\r\nOFICINA DE SAINT-GERVAIS: todos los días hasta el cierre de la estación, de 9.00 a 12.00 y de 15.00 a 19.00\r\n\r\nEn función del estado de la nieve y de las fechas de apertura de los remontes."
            ],
            "nl": [
              "BETTEX KANTOOR: Elke dag tot sluitingstijd van het station van 8.50 tot 16.30 uur (17.30 uur tijdens de schoolvakanties in februari/maart)\r\n\r\nKANTOOR SAINT-GERVAIS: elke dag tot sluiting van het station van 9u00 tot 12u00 en van 15u00 tot 19u00\r\n\r\nAfhankelijk van de sneeuwcondities en de openingsdata van de liften."
            ]
          },
