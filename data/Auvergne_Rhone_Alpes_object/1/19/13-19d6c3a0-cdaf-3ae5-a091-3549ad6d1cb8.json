  "rdfs:comment": {
    "de": [
      "Das Festival \"Présence de l'orgue Clicquot\" ehrt dieses Juwel des musikalischen Erbes durch eine Reihe von Konzerten. Ein außergewöhnliches Treffen, um den Klangreichtum einer historischen Orgel in einem bemerkenswerten Rahmen zu entdecken."
    ],
    "en": [
      "The \"Présence de l?orgue Clicquot\" festival honors this jewel of musical heritage through a series of concerts. An exceptional opportunity to discover the rich sound of a historic organ in a remarkable setting."
    ],
    "it": [
      "Il festival \"Présence de l'orgue Clicquot\" celebra questo gioiello del nostro patrimonio musicale con una serie di concerti. Un'occasione eccezionale per scoprire il suono ricco di un organo storico in un ambiente straordinario."
    ],
    "fr": [
      "Le festival « Présence de l’orgue Clicquot » met à l’honneur ce joyau du patrimoine musical à travers une série de concerts. Un rendez-vous d’exception pour découvrir la richesse sonore d’un orgue historique dans un cadre remarquable."
    ],
    "nl": [
      "Het festival \"Présence de l'orgue Clicquot\" viert dit juweel van ons muzikaal erfgoed met een reeks concerten. Een uitzonderlijke gelegenheid om het rijke geluid van een historisch orgel in een opmerkelijke omgeving te ontdekken."
    ],
    "es": [
      "El festival \"Présence de l'orgue Clicquot\" celebra esta joya de nuestro patrimonio musical con una serie de conciertos. Una ocasión excepcional para descubrir la riqueza sonora de un órgano histórico en un marco excepcional."
    ]
  },
  "rdfs:label": {
