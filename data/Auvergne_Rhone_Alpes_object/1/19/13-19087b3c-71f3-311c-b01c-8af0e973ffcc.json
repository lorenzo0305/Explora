  "rdfs:comment": {
    "de": [
      "Von der Cie des Étourneaux. Theater mit musikalischen Objekten. Progressives Eintauchen in eine zarte und schräge Welt, die Welt des Kopfes eines alten Leuchtturmwärters, der sein Leben und seine Träume verwechselt, der seine Erinnerungen sublimiert..."
    ],
    "en": [
      "By Cie des Étourneaux. Musical object theater. A gradual plunge into the tender, offbeat world of an old lighthouse keeper, who confuses his life with his dreams, and sublimates his memories..."
    ],
    "it": [
      "A cura della Cie des Étourneaux. Teatro musicale d'oggetti. Un tuffo graduale in un mondo tenero e stravagante, quello della testa di un vecchio guardiano del faro, che confonde la sua vita e i suoi sogni, che sublima i suoi ricordi..."
    ],
    "fr": [
      "Par la Cie des Étourneaux. Théâtre d'objet musical. Plongée progressive dans un univers tendre et décalé, celui de la tête d'un vieux gardien de phare, qui confond sa vie et ses rêves, qui sublime ses souvenirs..."
    ],
    "es": [
      "Por la Cie des Étourneaux. Teatro musical de objetos. Una inmersión progresiva en un mundo tierno y estrafalario, el de la cabeza de un viejo farero, que confunde su vida y sus sueños, que sublima sus recuerdos..."
    ],
    "nl": [
      "Door de Cie des Étourneaux. Muzikaal objecttheater. Een geleidelijke onderdompeling in een tedere, eigenzinnige wereld, die van het hoofd van een oude vuurtorenwachter, die zijn leven en zijn dromen door elkaar haalt, die zijn herinneringen sublimeert..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saison culturelle : Le mystère de Léon Plouhinec"
    ]
  },
