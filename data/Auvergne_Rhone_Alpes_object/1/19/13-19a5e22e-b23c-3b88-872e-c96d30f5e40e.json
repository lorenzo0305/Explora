  "rdfs:comment": {
    "de": [
      "Cécile Lignereux, Dozentin für französische Sprache und Literatur des Ancien Régime, wird über die Modelle und Werte der Brieffreundschaft zur Zeit von Mme de Sévigné sprechen."
    ],
    "en": [
      "Cécile Lignereux, Senior Lecturer in French Language and Literature of the Ancien Régime, will talk about the models and values of epistolary friendship in Mme de Sévigné's time."
    ],
    "it": [
      "Cécile Lignereux, docente senior di Lingua e letteratura francese dell'Ancien Régime, parlerà dei modelli e dei valori dell'amicizia epistolare all'epoca di Mme de Sévigné."
    ],
    "fr": [
      "Cécile Lignereux, maître de conférences en Langue et littérature françaises d’Ancien Régime, interviendra sur les modèles et les valeurs de l'amitié épistolaire à l'époque de Mme de Sévigné."
    ],
    "nl": [
      "Cécile Lignereux, universitair hoofddocent Franse taal- en letterkunde van het Ancien Régime, zal spreken over de modellen en waarden van epistolaire vriendschap in de tijd van Mme de Sévigné."
    ],
    "es": [
      "Cécile Lignereux, profesora titular de Lengua y Literatura francesas del Antiguo Régimen, hablará de los modelos y valores de la amistad epistolar en la época de Mme de Sévigné."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Des pratiques épistolaires pour empêcher la ruine des amitiés : les lettres de Mme de Sévigné à Mme de Grignan"
    ]
  },
