  "rdfs:comment": {
    "de": [
      "Entdeckungsspaziergang rund um Chavroches (2km /1h).\r\nEntdecken Sie mit Ihrer Familie das Kulturerbe des Allier auf spielerische und pädagogische Weise mit PÉPIT!\r\nLaden Sie die PÉPIT-App herunter und machen Sie sich auf die Suche nach dem Schatz!"
    ],
    "en": [
      "Discovery walk around Chavroches (2km /1h).\r\nDiscover the Allier region's heritage in a fun and educational way with PÉPIT!\r\nDownload the PÉPIT application and set off in search of treasure!"
    ],
    "it": [
      "Passeggiata alla scoperta di Chavroches (2 km/1h).\r\nScoprite il patrimonio dell'Allier in famiglia in modo divertente ed educativo con PÉPIT!\r\nScaricate l'applicazione PÉPIT e partite alla ricerca del tesoro!"
    ],
    "fr": [
      "Balade découverte autour de Chavroches (2km /1h). \r\nDécouvrez le patrimoine de l'Allier en famille de façon ludique et pédagogique avec PÉPIT !\r\nTéléchargez l'application PÉPIT et partez à la recherche du trésor !"
    ],
    "es": [
      "Paseo de descubrimiento por Chavroches (2km/1h).\r\n¡Descubra el patrimonio del Allier en familia de forma lúdica y pedagógica con PÉPIT!\r\nDescárguese la aplicación PÉPIT y salga en busca del tesoro"
    ],
    "nl": [
      "Ontdekkingswandeling rond Chavroches (2km/1u).\r\nOntdek met het gezin het erfgoed van de Allier op een leuke en leerzame manier met PÉPIT!\r\nDownload de applicatie PÉPIT en ga op zoek naar de schat!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "PÉPIT : Percez les secrets de la phrygane"
    ]
  },
