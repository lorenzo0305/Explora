  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von unseren French Tacos verführen, die mit hausgemachter Greyerzer Sauce garniert und mit knusprigen Pommes frites serviert werden, oder von unseren Burgern, die mit einem Steak vom Metzger hergestellt und sorgfältig für eine Geschmacksexplosion zubereitet werden."
    ],
    "en": [
      "Let yourself be tempted by our French Tacos, topped with homemade Gruyère sauce and served with crispy fries, or our butcher's steak burgers, carefully prepared for an explosion of flavours."
    ],
    "it": [
      "Lasciatevi tentare dai nostri tacos francesi, conditi con salsa groviera fatta in casa e serviti con patatine fritte croccanti, o dai nostri hamburger di bistecca di macelleria, preparati con cura per un'esplosione di sapore."
    ],
    "fr": [
      "Laissez-vous tenter par nos French Tacos, garnis de sauce au gruyère maison, accompagnés de frites croustillantes, nos burgers élaborés avec un steak de boucher, préparés avec soin pour une explosion de saveurs."
    ],
    "nl": [
      "Laat je verleiden door onze Franse Taco's, overgoten met huisgemaakte Gruyèresaus en geserveerd met knapperige frietjes, of onze hamburgers gemaakt met biefstuk van de slager, zorgvuldig bereid voor een smaakexplosie."
    ],
    "es": [
      "Déjese tentar por nuestros Tacos Franceses, cubiertos con salsa casera de Gruyère y servidos con crujientes patatas fritas, o nuestras hamburguesas elaboradas con filete de carnicero, cuidadosamente preparadas para una explosión de sabor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Frenchy"
    ]
  },
