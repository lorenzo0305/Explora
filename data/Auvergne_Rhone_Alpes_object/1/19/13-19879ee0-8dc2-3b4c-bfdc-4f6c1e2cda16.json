  "rdfs:comment": {
    "de": [
      "Wir haben einen pädagogischen Bauernhof und eine Ferme Auberge, verarbeiten unsere Erzeugnisse für den Bauernladen, in dem wir mit etwa 20 anderen Erzeugern aus der Gegend zusammenarbeiten. Wir heißen Wohnmobilisten willkommen."
    ],
    "en": [
      "We have an educational farm and a farm inn, and process our produce for the producers' store in which we work with around twenty other local producers. We also welcome camper vans."
    ],
    "it": [
      "Abbiamo una fattoria didattica e una locanda, e trasformiamo i nostri prodotti per il negozio della fattoria, dove collaboriamo con una ventina di altri produttori locali. Accogliamo i camper."
    ],
    "fr": [
      "Nous avons une ferme pédagogique et une ferme auberge, transformons nos productions pour le magasin de producteurs dans lequel nous travaillons avec une vingtaine d'autres producteurs du coin. Nous accueillons les camping caristes."
    ],
    "nl": [
      "We hebben een educatieve boerderij en een boerderijherberg, en verwerken onze producten voor de boerderijwinkel waar we samenwerken met zo'n twintig andere lokale producenten. Campers zijn welkom."
    ],
    "es": [
      "Tenemos una granja educativa y una posada, y procesamos nuestros productos para la tienda de la granja, donde trabajamos con una veintena de otros productores locales. Admitimos autocaravanas."
    ]
  },
  "rdfs:label": {
