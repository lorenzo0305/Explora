  "rdfs:comment": {
    "de": [
      "Rinderzüchter auf dem Hof der Familie. Der Betrieb erstreckt sich über 330 ha, die zwischen Wiesen und Getreideanbau aufgeteilt sind. Das alles dient der optimalen Ernährung der Herde."
    ],
    "en": [
      "Cattle breeders on the family farm. The farm covers 330 ha divided between meadow and cereal crops. All to feed the herd as best as possible."
    ],
    "it": [
      "Allevatori di bovini nell'azienda agricola di famiglia. L'azienda si estende su 330 ettari, suddivisi tra pascoli e coltivazioni di cereali. Tutto viene fatto per nutrire al meglio la mandria."
    ],
    "fr": [
      "Éleveurs de bovins au sein de la ferme familiale. L'exploitation s'étend sur 330 ha réparties entre prairie et cultures de céréales. Le tout pour nourrir au mieux le troupeau."
    ],
    "nl": [
      "Veehouders op het familiebedrijf. De boerderij strekt zich uit over 330 ha, verdeeld over grasland en graangewassen. Alles wordt in het werk gesteld om de kudde zo goed mogelijk te voeden."
    ],
    "es": [
      "Ganaderos en la explotación familiar. La explotación se extiende sobre 330 ha, divididas entre praderas y cultivos de cereales. Todo se hace para alimentar al rebaño lo mejor posible."
    ]
  },
