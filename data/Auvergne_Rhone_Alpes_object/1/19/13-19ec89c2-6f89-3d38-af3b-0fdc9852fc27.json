  "rdfs:comment": {
    "de": [
      "Kommen Sie und üben Sie das Reiten ab 3 Jahren aus.\r\nReitunterricht vom Baby-Pony bis zum Erwachsenenkurs.\r\nAusritte zu Pferd oder auf dem Pony.\r\nFerien- und Freizeitzentrum für Kinder von 3 bis 15 Jahren.\r\nKindergeburtstag mit Reitaktivitäten."
    ],
    "en": [
      "Come and enjoy horse riding from the age of 3.\r\nRiding lessons from baby pony to adult.\r\nHorse or pony rides.\r\nVacation and leisure center for children aged 3 to 15.\r\nChildren's birthday parties with equestrian activities."
    ],
    "it": [
      "Venite a godervi l'equitazione a partire dai 3 anni di età.\r\nLezioni di equitazione da baby pony ad adulti.\r\nPasseggiate a cavallo o su pony.\r\nCentro vacanze e tempo libero per bambini dai 3 ai 15 anni.\r\nFesta di compleanno per bambini con attività equestre."
    ],
    "fr": [
      "Venez pratiquer l’équitation dès 3 ans.\r\nCours d'équitation, du baby-poney au cours adulte. \r\nBalade à cheval ou à poney.\r\nCentre de vacances et de loisirs pour les enfants de 3 à 15 ans.\r\nAnniversaire Enfant avec activité équestre."
    ],
    "es": [
      "Ven a disfrutar de la equitación a partir de los 3 años.\r\nClases de equitación desde bebé poni hasta adulto.\r\nPaseos a caballo o en poni.\r\nCentro de vacaciones y ocio para niños de 3 a 15 años.\r\nFiesta de cumpleaños infantil con actividad ecuestre."
    ],
    "nl": [
      "Kom genieten van paardrijden vanaf 3 jaar.\r\nPaardrijlessen van baby pony tot volwassene.\r\nRitten met paard of pony.\r\nVakantie- en vrijetijdscentrum voor kinderen van 3 tot 15 jaar.\r\nKinderfeestje met ruiteractiviteit."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cheval Bugey Equestrian Center"
    ],
    "fr": [
      "Centre équestre Cheval Bugey"
    ],
    "nl": [
      "Manege Cheval Bugey"
