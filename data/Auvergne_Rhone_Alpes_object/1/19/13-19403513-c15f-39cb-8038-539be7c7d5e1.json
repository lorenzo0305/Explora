  "rdfs:comment": {
    "de": [
      "Maison Bancel ist seit 1964 ein handwerklich arbeitender Metzgereibetrieb. Sein Erlebnisbereich ermöglicht die Begegnung mit einem Beruf, einem Know-how und einer zutiefst menschlichen Familiengeschichte. Die Pökelwaren werden nach traditionellen Rezepten aus der Drôme hergestellt."
    ],
    "en": [
      "Saucissons, faggots, meat pies, Romans meat salting is carried out according to the Drôme's traditional recipes. A visit to the discovery area is the ideal way to see a time-honoured trade in action and understand the expertise of this close-knit family-run business."
    ],
    "it": [
      "Maison Bancel charcuterie artisanale dal 1964. Il suo spazio di scoperta permette di incontrare una professione, un know-how e una storia familiare profondamente umana. Le carni salate sono preparate secondo le ricette tradizionali della Drôme."
    ],
    "fr": [
      "Maison Bancel charcuterie artisanale depuis 1964. Son espace découverte permet la rencontre avec un métier, un savoir-faire et une histoire familiale profondément Humaine. Les Salaisons sont réalisées selon des recettes traditionnelles de la Drôme."
    ],
    "nl": [
      "Worstjes, lebmaag, paté met broodkorst, ingezouten voedingswaren van Romans, gemaakt volgens de traditionele recepten van de Drôme. In de ontdekkingsruimte leert u meer over het vak, de expertise en de hartverwarmende familiegeschiedenis."
    ],
    "es": [
      "Maison Bancel charcutería artesanal desde 1964. Su espacio de descubrimiento permite conocer una profesión, un saber hacer y una historia familiar profundamente humana. Los salazones se elaboran según las recetas tradicionales de la Drôme."
    ]
  },
