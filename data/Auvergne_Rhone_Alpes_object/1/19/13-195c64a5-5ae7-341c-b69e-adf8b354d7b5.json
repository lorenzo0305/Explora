  "rdfs:comment": {
    "de": [
      "Les Clévos, cité des savoirs schloss am 31. Dezember seine Pforten, um Platz für die Domaine des Clévos zu machen. Die Stadtverwaltung möchte dort die Vermietung von Räumen anbieten sowie den Sternfahrern die Möglichkeit geben, über einen Park mit Bäumen zu verfügen, in dem sie sich entspannen können."
    ],
    "en": [
      "Les Clévos, cité des savoirs closed its doors on December 31 to make way for the Domaine des Clévos. The town council wishes to offer space for rental, as well as the opportunity for star-studded residents to relax in a park planted with trees."
    ],
    "it": [
      "Les Clévos, cité des savoirs ha chiuso i battenti il 31 dicembre per far posto al Domaine des Clévos. Il Comune vuole offrire spazi da affittare e dare ai residenti della zona la possibilità di rilassarsi in un parco alberato."
    ],
    "fr": [
      "Les Clévos, cité des savoirs a fermé ses portes le 31 décembre dernier pour laisser place au Domaine des Clévos. La mairie souhaite y proposer des locations d'espaces ainsi que l'occasion aux étoiliens de disposer d'un parc arboré pour s'y détendre."
    ],
    "nl": [
      "Les Clévos, cité des savoirs sloot zijn deuren op 31 december om plaats te maken voor het Domaine des Clévos. De gemeente wil ruimte verhuren en de buurtbewoners de kans geven om te ontspannen in een park met bomen."
    ],
    "es": [
      "Les Clévos, cité des savoirs cerró sus puertas el 31 de diciembre para dar paso al Domaine des Clévos. El ayuntamiento quiere ofrecer espacios de alquiler y dar a los vecinos la posibilidad de relajarse en un parque arbolado."
    ]
  },
