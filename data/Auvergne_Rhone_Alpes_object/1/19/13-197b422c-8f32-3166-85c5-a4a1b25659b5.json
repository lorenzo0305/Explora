  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant in einer wunderschönen Bastide, Terrasse mit Panoramablick, traditionelle Saisonküche. La Bastide de Sanilhac empfängt Sie in einer herzlichen und familiären Atmosphäre, für Tagungen, Seminare, Ferien oder Wochenenden."
    ],
    "en": [
      "Located in a medieval house, panoramic terrace, traditional local home-cooked food. The Bastide de Sanilhac welcomes you in a charming and welcoming atmosphere to enjoy during  weddings, seminars, holidays or week-ends."
    ],
    "it": [
      "Albergo-ristorante in una magnifica bastide, terrazza con vista panoramica, cucina tradizionale di stagione. La Bastide de Sanilhac vi accoglie in un'atmosfera calda e familiare, per riunioni, seminari, vacanze o weekend."
    ],
    "fr": [
      "Hôtel-restaurant dans une magnifique bastide, terrasse avec vue panoramique, cuisine traditionnelle de saison. La Bastide de Sanilhac vous accueille dans une ambiance chaleureuse et familiale, à l'occasion de réunions, séminaires, vacances ou week-end."
    ],
    "es": [
      "Hotel-restaurante en una magnífica bastida, terraza con vista panorámica, cocina tradicional de temporada. La Bastide de Sanilhac le da la bienvenida en un ambiente cálido y familiar, para reuniones, seminarios, vacaciones o fines de semana."
    ],
    "nl": [
      "Hotel-restaurant in een prachtige bastide, terras met panoramisch uitzicht, traditionele seizoensgebonden keuken. La Bastide de Sanilhac ontvangt u in een warme en familiale sfeer, voor vergaderingen, seminaries, vakanties of weekends."
    ]
  },
