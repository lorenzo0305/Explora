  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8bb5d8e1-fb51-3ac8-8572-67c0a43c745d",
      "dc:description": {
        "de": [
          "Entdecken Sie anhand der in der Ausstellung gezeigten Werke und der Halde 110 neben dem Haus 9-9 bis, wie sich das Bassin Minier nach 270 Jahren Bergbau von einem schwarzen Land in ein grünes verwandelt hat."
        ],
        "en": [
          "Explore the works in the exhibition and visit the 110 slag heap next to 9-9 bis to discover how the mining basin went from black to green after 270 years of mining."
        ],
        "it": [
          "Esplorate le opere in mostra e visitate il cumulo di 110 scorie accanto al 9-9 bis per scoprire come il bacino minerario sia passato dal nero al verde dopo 270 anni di estrazione."
        ],
        "fr": [
          "A travers une découverte des œuvres présentées dans l'exposition et une association du terril 110 à côté du 9-9 bis, découvrez comment le Bassin minier est passé d'un pays noir à un payx vert après 270 ans d'exploitation minière."
        ],
        "nl": [
          "Verken de werken in de tentoonstelling en bezoek de 110 slakkenberg naast 9-9 bis om te ontdekken hoe het mijnbekken na 270 jaar mijnbouw van zwart naar groen ging."
        ],
        "es": [
          "Explore las obras de la exposición y visite la escombrera 110 junto al 9-9 bis para descubrir cómo la cuenca minera pasó del negro al verde tras 270 años de explotación."
        ]
      },
