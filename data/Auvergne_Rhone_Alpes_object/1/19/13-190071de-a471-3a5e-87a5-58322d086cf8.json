  "rdfs:comment": {
    "de": [
      "Das Weingut arbeitet mit Respekt vor dem bugistischen Weinbau-Know-how. Die Authentizität der feinen und ausdrucksstarken Weine ist das Spiegelbild eines delikaten Terroirs, das auf ton- und kalkhaltigen Böden zwischen Erde und Fluss angebaut wird."
    ],
    "en": [
      "The estate works in the respect of the bugist wine know-how. The authenticity of fine and expressive wines is the image of a delicate terroir cultivated on clayey-limestone soil between earth and river."
    ],
    "it": [
      "L'azienda lavora nel rispetto del know-how viticolo dei Buges. L'autenticità dei vini, fini ed espressivi, riflette l'immagine di un terroir delicato coltivato su terreni argillo-calcarei tra la terra e il fiume."
    ],
    "fr": [
      "Le domaine travaille dans le respect du savoir-faire viticole bugiste. L'authenticité de vins fins et expressifs est à l'image d'un terroir délicat cultivé sur des terres argilo-calcaires entre terre et fleuve."
    ],
    "es": [
      "La finca trabaja respetando el saber hacer vitícola de los Buges. La autenticidad de los vinos finos y expresivos refleja la imagen de un terruño delicado cultivado en un suelo arcilloso-calcáreo entre la tierra y el río."
    ],
    "nl": [
      "Het domein werkt met respect voor de wijnbouwkennis van de Buges. De authenticiteit van de fijne en expressieve wijnen weerspiegelt het beeld van een delicaat terroir geteeld op klei-kalksteen bodem tussen het land en de rivier."
    ]
  },
  "rdfs:label": {
    "en": [
      "House Yves Duport"
    ],
    "fr": [
      "Maison Yves Duport"
    ]
  },
