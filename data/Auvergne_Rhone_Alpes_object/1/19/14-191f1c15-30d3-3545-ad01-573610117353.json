  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/79297d33-5391-3db7-8008-0cfce079937e",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Selbstgemachtes Gebäck und Schokolade\n\nTage der Öffnung:\n\nDienstag bis Samstag von 7:30 bis 13 Uhr und von 14 bis 19 Uhr\nSonntags von 7.30 bis 13 Uhr\n \nAbholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nTelefonische Bestellungen unter 03 21 07 00 84 möglich"
        ],
        "en": [
          "Information :\n\nProducts: homemade pastries and chocolate\n\nOpening days:\n\nTuesday to Saturday, 7:30am to 1pm and 2pm to 7pm\nSunday from 7:30am to 1pm\n \nPick-up :\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by telephone on 03 21 07 00 84"
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pasticceria e cioccolato fatti in casa\n\nGiorni di apertura:\n\nDa martedì a sabato dalle 7.30 alle 13.00 e dalle 14.00 alle 19.00\nDomenica dalle 7.30 alle 13.00\n \nRaccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate telefonicamente al numero 03 21 07 00 84"
        ],
        "fr": [
          "Informations :\n\nProduits : pâtisseries et chocolat fait maison\n\nJours d'ouverture:\n\nDu mardi au samedi de 7h30 à 13h et de 14h à 19h\nLe dimanche de 7h30 à 13h\n \nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au  03 21 07 00 84"
        ],
        "nl": [
          "Meer informatie :\n\nProducten: huisgemaakt gebak en chocolade\n\nOpeningsdagen:\n\nDinsdag t/m zaterdag van 7.30 tot 13.00 uur en van 14.00 tot 19.00 uur\nZondag van 7.30 tot 13.00 uur\n \nAfhalen :\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nU kunt telefonisch bestellen op 03 21 07 00 84"
        ],
        "es": [
          "Más información :\n\nProductos: repostería casera y chocolate\n\nDías de apertura:\n\nDe martes a sábado, de 7.30 a 13.00 y de 14.00 a 19.00 horas\nDomingo de 7h30 a 13h00\n \nRecogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nPuede hacer su pedido por teléfono llamando al 03 21 07 00 84"
        ]
      },
