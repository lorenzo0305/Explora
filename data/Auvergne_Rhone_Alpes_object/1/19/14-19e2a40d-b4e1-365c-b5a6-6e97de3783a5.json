      "dc:description": {
        "de": [
          "Am Strand von Berck, Meerblick. Atemübungen, Körperhaltungen, Entspannung, Mantra.\nSamstag, 22. März, von 10 bis 12.30 Uhr.\nAnmeldung und Infos: 06 33 24 22 72 oder juyogalie@gmail.com"
        ],
        "en": [
          "At Berck plage, sea view. Breathing, postures, relaxation, mantra.\nSaturday March 22 from 10am to 12:30pm.\nRegistration and info: 06 33 24 22 72 or juyogalie@gmail.com"
        ],
        "it": [
          "Spiaggia di Berck, vista mare. Respirazione, posture, rilassamento, mantra.\nSabato 22 marzo dalle 10.00 alle 12.30.\nIscrizioni e informazioni: 06 33 24 22 72 o juyogalie@gmail.com"
        ],
        "fr": [
          "À Berck plage, vue mer. Respirations, postures, relaxation, mantra.\nSamedi 22 mars de 10h à 12h30.\nInscription et infos : 06 33 24 22 72 ou juyogalie@gmail.com"
        ],
        "es": [
          "Playa de Berck, vista al mar. Respiración, posturas, relajación, mantra.\nSábado 22 de marzo de 10.00 a 12.30 h.\nInscripciones e información: 06 33 24 22 72 o juyogalie@gmail.com"
        ],
        "nl": [
          "Berck strand, uitzicht op zee. Ademhaling, houdingen, ontspanning, mantra.\nZaterdag 22 maart van 10.00 tot 12.30 uur.\nInschrijving en info: 06 33 24 22 72 of juyogalie@gmail.com"
        ]
      },
