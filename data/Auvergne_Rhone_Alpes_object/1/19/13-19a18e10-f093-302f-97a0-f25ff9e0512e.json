  "rdfs:comment": {
    "de": [
      "Unser Restaurant Bo é Bon ist von Montag bis Donnerstag mittags und abends sowie freitags mittags geöffnet. Entdecken Sie eine einfache, aber leckere Küche, die von lokalen Spezialitäten inspiriert ist. Im Sommer genießen Sie ein Mittagessen oder einen Aperitif auf der Terrasse mit der Familie oder mit Freunden."
    ],
    "en": [
      "Our restaurant Bo é Bon is open every evening and lunchtime for your business meals.  Discover cooking from the market inspired by local specialities.  In summer, enjoy a meal or an aperitif on the terrace with friends or family."
    ],
    "it": [
      "Il nostro ristorante Bo é Bon è aperto a pranzo e a cena dal lunedì al giovedì e a pranzo il venerdì. Scoprite una cucina semplice ma deliziosa, ispirata alle specialità locali. In estate, godetevi un pranzo o un aperitivo in terrazza con la famiglia o gli amici."
    ],
    "fr": [
      "Notre restaurant Bo é Bon est ouvert du lundi au jeudi midi et soir et vendredi midi. Découvrez une cuisine simple mais gourmande inspirée des spécialités locales. En été, profitez d'un déjeuner ou d'un apéritif en terrasse en famille ou entre amis."
    ],
    "nl": [
      "Ons Bo é Bon restaurant is geopend voor lunch en diner van maandag tot en met donderdag en voor lunch op vrijdag. Ontdek een eenvoudige maar heerlijke keuken geïnspireerd door lokale specialiteiten. Geniet in de zomer van een lunch of een aperitief op het terras met familie of vrienden."
    ],
    "es": [
      "Nuestro restaurante Bo é Bon está abierto para almorzar y cenar de lunes a jueves y para comer los viernes. Descubra una cocina sencilla pero deliciosa inspirada en las especialidades locales. En verano, disfrute de un almuerzo o un aperitivo en la terraza con la familia o los amigos."
    ]
  },
