  "rdfs:comment": {
    "de": [
      "A Fleur de Soi, Espace Bien-être in Montbrun-les-Bains, bietet Ihnen Behandlungen mit ätherischen Ölen in Olfactotherapie und olfaktorischer Rehabilitation, Sitzungen mit manuellen Praktiken in Shiatsu, Reiki, Access Bars, Kinesiologie (MKB) und Stimmgabeln."
    ],
    "en": [
      "The \"A Fleur de Soi\" wellness Center supports you during your spa treatment by offering essential oil treatments in Olfactotherapy and Shiatsu (manual practice) as well as olfactory-Shiatsu, olfactory-coaching and olfactory rehabilitation sessions."
    ],
    "it": [
      "A Fleur de Soi, un'area benessere a Montbrun-les-Bains, offre trattamenti agli oli essenziali in Olfattoterapia e riabilitazione olfattiva, sessioni di pratica manuale in Shiatsu, Reiki, Access Bar, Kinesiologia (MKB) e diapason."
    ],
    "fr": [
      "A Fleur de Soi, Espace Bien-être à Montbrun-les-Bains, vous propose des soins aux huiles essentielles en Olfactothérapie et rééducation olfactive,  des séances de pratiques manuelles en Shiatsu, Reiki, Access Bars, Kinésiologie (MKB) et diapasons."
    ],
    "nl": [
      "A Fleur de Soi, welzijn in Montbrun-les-Bains, biedt essentiële oliebehandelingen in Olfactotherapie en olfactorische rehabilitatie, manuele oefensessies in Shiatsu, Reiki, Access Bars, Kinesiologie (MKB)."
    ],
    "es": [
      "A Fleur de Soi, un centro de bienestar en Montbrun-les-Bains, ofrece tratamientos con aceites esenciales en olfatoterapia y reeducación olfativa, sesiones de práctica manual de shiatsu, reiki, barras de acceso, kinesiología (MKB) y diapasones."
    ]
  },
