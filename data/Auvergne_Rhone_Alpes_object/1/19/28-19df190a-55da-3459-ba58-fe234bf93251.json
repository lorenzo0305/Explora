  "rdfs:comment": {
    "de": [
      "Die Dichter des Kollektivs Calliope werden in der Bibliothek Robert Mallet anwesend sein.\nFreunde der Worte, ihrer Schönheit, ihrer Rauheit, ihrer Sanftheit, ihres Geschreis, sind herzlich willkommen! Wortneugierige sind herzlich willkommen!"
    ],
    "en": [
      "Poets from the Collectif Calliope will be at the Robert Mallet library.\nLovers of words, of their beauty, their roughness, their softness, their clamor, you are expected! Curious about words, you're welcome!"
    ],
    "it": [
      "I poeti del Collectif Calliope saranno presenti alla biblioteca Robert Mallet.\nAmanti delle parole, della loro bellezza, della loro ruvidità, della loro morbidezza, del loro clamore, siete attesi! Se siete curiosi di conoscere le parole, siete i benvenuti!"
    ],
    "fr": [
      "Les poétes.ses du Collectif Calliope seront présent.es à la bibliothèque Robert Mallet.\nAmi.es des mots, de leur beauté, de leur rugosité, de leur douceur, de leur clameur, vous êtes attendu.es! Curieux des mots, vous êtes les bienvenu.es!"
    ],
    "es": [
      "Los poetas del Colectivo Calíope estarán en la biblioteca Robert Mallet.\nAmantes de las palabras, de su belleza, de su aspereza, de su suavidad, de su clamor, ¡os esperamos! Si sientes curiosidad por las palabras, ¡eres bienvenido!"
    ],
    "nl": [
      "Dichters van het Collectif Calliope zullen in de Robert Mallet bibliotheek zijn.\nLiefhebbers van woorden, van hun schoonheid, hun ruwheid, hun zachtheid, hun rumoer, jullie worden verwacht! Als je nieuwsgierig bent naar woorden, ben je welkom!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jeudi sera poésie"
    ]
  },
