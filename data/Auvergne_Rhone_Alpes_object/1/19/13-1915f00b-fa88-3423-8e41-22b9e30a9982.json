  "rdfs:comment": {
    "de": [
      "Zwei Tage außerhalb der Zeit und des Rahmens, um im Kontakt mit inspirierten und inspirierenden CEOs, Unternehmern, Denkern, Experten, Athleten, Forschern und Künstlern das Unternehmen von morgen zu hinterfragen und zu erfinden."
    ],
    "en": [
      "two exceptional days in which together we'll invent the company of tomorrow, with the help of CEOs, entrepreneurs, thinkers, experts, athletes, explorers, artists and other inspiring people."
    ],
    "it": [
      "Due giorni fuori dal tempo e dal luogo per interrogarsi e inventare l'azienda di domani a contatto con amministratori delegati, imprenditori, pensatori, esperti, atleti, esploratori e artisti che sapranno ispirare e suggestionare."
    ],
    "fr": [
      "Deux jours hors temps et hors cadre pour questionner et inventer l'entreprise de demain au contact de CEOs, entrepreneurs, penseurs, experts, athlètes, explorateurs et artistes et inspirés et inspirants."
    ],
    "nl": [
      "Twee dagen weg van tijd en plaats om het bedrijf van morgen in vraag te stellen en uit te vinden in contact met inspirerende CEO's, ondernemers, denkers, experts, atleten, ontdekkingsreizigers en kunstenaars."
    ],
    "es": [
      "Dos días fuera del tiempo y del lugar para cuestionar e inventar la empresa del mañana en contacto con inspiradores directores generales, empresarios, pensadores, expertos, deportistas, exploradores y artistas."
    ]
  },
