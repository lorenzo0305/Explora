  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1d4bf30a-9bd2-39db-9194-43bde125a4f0",
      "dc:description": {
        "de": [
          "Workshop Einführung in den Stummfilm, Herstellung eines schwarz-weißen Stummfilms - Ab 6 Jahren - Um 14 Uhr im CINOS (Place du 18 juin) - Die Kinder müssen von mindestens einem Erwachsenen begleitet werden. - Kostenloser Workshop, betreut von der Kompanie Cirq?O Vent\nInfos und Reservierungen per Telefon unter +33(0) 3 61 85 05 00 oder per E-Mail reservation@cinos.fr"
        ],
        "en": [
          "Introduction to silent film workshop, making a short black and white silent film - From age 6 - At 2pm at CINOS (Place du 18 juin) - Children must be accompanied by at least 1 adult. - Free workshop, led by Cirq?O Vent\nInformation and reservations by phone +33(0) 3 61 85 05 00 or by e-mail reservation@cinos.fr"
        ],
        "it": [
          "Laboratorio di introduzione al cinema muto, realizzazione di un breve film muto in bianco e nero - A partire dai 6 anni - Alle 14.00 presso CINOS (Place du 18 juin) - I bambini devono essere accompagnati da almeno un adulto. - Laboratorio gratuito, condotto dalla compagnia Cirq?O Vent\nInformazioni e prenotazioni al numero di telefono +33(0) 3 61 85 05 00 o all'indirizzo e-mail reservation@cinos.fr"
        ],
        "fr": [
          "Atelier initiation au film muet, réalisation d’un court-métrage muet noir et blanc - Dès 6 ans - A 14h au CINOS (Place du 18 juin) - Les enfants doivent être accompagnés d'au moins 1 adulte. - Atelier gratuit, encadré par la compagnie Cirq’O Vent\nInfos et réservations par téléphone au +33(0) 3 61 85 05 00 ou par mail reservation@cinos.fr"
        ],
        "es": [
          "Taller de iniciación al cine mudo, realización de un cortometraje mudo en blanco y negro - A partir de 6 años - A las 14 h en CINOS (Place du 18 juin) - Los niños deben ir acompañados de al menos 1 adulto. - Taller gratuito, animado por la compañía Cirq'O Vent\nInformación y reservas por teléfono en el +33(0) 3 61 85 05 00 o por correo electrónico reservation@cinos.fr"
        ],
        "nl": [
          "Kennismaking met stomme film workshop, het maken van een korte zwart-wit stomme film - Vanaf 6 jaar - Om 14.00 uur bij CINOS (Place du 18 juin) - Kinderen moeten worden begeleid door ten minste 1 volwassene. - Gratis workshop onder leiding van Cirq?O Vent\nInformatie en reserveringen per telefoon +33(0) 3 61 85 05 00 of per e-mail reservation@cinos.fr"
        ]
      },
