  "rdfs:comment": {
    "de": [
      "Das Restaurant du Téléphérique auf dem Gipfel der Bastille bietet Ihnen eine hausgemachte Speisekarte mit frischen Produkten aus der Region. Kommen Sie vorbei und genießen Sie einen einzigartigen Moment mit Panoramablick auf die Stadt Grenoble und die umliegenden Bergmassive!"
    ],
    "en": [
      "The Restaurant du Téléphérique, located at the top of the Bastille, offers a home-made menu featuring fresh, local produce. Come and share a unique moment and enjoy a panoramic view of Grenoble and the surrounding mountains!"
    ],
    "it": [
      "Il Restaurant du Téléphérique, situato in cima alla Bastille, offre un menu casalingo a base di prodotti freschi e locali. Venite a condividere un momento unico e a godere di una vista panoramica su Grenoble e sulle montagne circostanti!"
    ],
    "fr": [
      "Le Restaurant du Téléphérique, situé au sommet de la Bastille vous propose une carte maison avec des produits frais et locaux. Venez partager un moment unique et profiter d'une vue panoramique sur la ville de Grenoble et les massifs environnants !"
    ],
    "nl": [
      "Het Restaurant du Téléphérique, gelegen op de top van de Bastille, biedt een huisgemaakt menu op basis van verse, lokale producten. Kom en deel een uniek moment en geniet van een panoramisch uitzicht op Grenoble en de omliggende bergen!"
    ],
    "es": [
      "El restaurante del teleférico, situado en la cima de la Bastilla, le ofrece una carta casera con productos frescos y locales. ¡Venga a compartir un momento único y disfrute de una vista panorámica de la ciudad de Grenoble y las montañas circundantes!"
    ]
  },
