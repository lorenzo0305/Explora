  "rdfs:comment": {
    "de": [
      "Angenehmer Rahmen. Restaurant mit Mezzanin. Spezialitäten: französisches Charolais-Fleisch, Ravioli-Gratinée, Vorschlag des Chefs, der je nach Ankunft auf einer Schiefertafel im Saal vorgeschlagen wird."
    ],
    "en": [
      "Pleasant restaurant with mezzanine. French specialties, raviole gratin, suggestion of the Chef."
    ],
    "it": [
      "Ambiente piacevole. Ristorante con mezzanino. Specialità: carne francese Charolais, ravioli gratinati, suggerimenti dello chef in base all'arrivo su una lavagna di ardesia nella sala da pranzo."
    ],
    "fr": [
      "Cadre agréable. Restaurant avec mezzanine. Spécialités viande charolaise française, gratinée de ravioles, suggestion du Chef proposée selon arrivage sur tableau en ardoise disposé dans la salle."
    ],
    "es": [
      "Un entorno agradable. Restaurante con entresuelo. Especialidades: carne de Charolais francés, raviolis gratinados, sugerencia del chef según la llegada en una pizarra en el comedor."
    ],
    "nl": [
      "Aangename omgeving. Restaurant met mezzanine. Specialiteiten: Frans Charolais vlees, gegratineerde ravioli, suggestie van de chef volgens aankomst op een leistenen bord in de eetzaal."
    ]
  },
