  "rdfs:comment": {
    "de": [
      "Von seinen vier Wehrtürmen aus beherrscht und überwacht das Château de la Chèze seit dem 13. Jahrhundert die Stadt Le Cheylard. Entdecken Sie in 16 Räumen das Leben im Schloss.  Freie oder thematische Besichtigungen, spielerische Workshops/Animationen, Sommeraktivitäten und Spieleabende."
    ],
    "en": [
      "From the top of its 4 defensive towers, the Château de la Chèze has dominated and watched over the town of Le Cheylard since the 13th century. Discover 15 rooms of castle life.  Self-guided or guided tours, fun and interactive workshops, games evenings."
    ],
    "it": [
      "Dall'alto delle sue 4 torri difensive, il Castello della Chèze domina e sorveglia la città di Le Cheylard dal XIII secolo. Scoprite le 16 stanze della vita del castello.  Visite autoguidate o a tema, laboratori/attività ludiche, attività estive e serate di gioco."
    ],
    "fr": [
      "Du haut de ses 4 tours défensives, le château de la Chèze domine et surveille la ville du Cheylard depuis le XIII°. Découvrez 16 salles de la vie au château.  Visites libres ou thématiques, ateliers/animations ludiques, activités de l'été et soirées jeux."
    ],
    "nl": [
      "Vanaf de top van zijn 4 verdedigingstorens domineert en waakt het Château de la Chèze al sinds de 13e eeuw over de stad Le Cheylard. Ontdek 16 kamers van het kasteelleven.  Rondleidingen met gids of thema's, leuke workshops/activiteiten, zomeractiviteiten en spelletjesavonden."
    ],
    "es": [
      "Desde lo alto de sus 4 torres defensivas, el castillo de la Chèze domina y vigila la ciudad de Le Cheylard desde el siglo XIII. Descubra 16 salas de la vida del castillo.  Visitas autoguiadas o temáticas, talleres/actividades lúdicas, actividades de verano y tardes de juegos."
    ]
  },
