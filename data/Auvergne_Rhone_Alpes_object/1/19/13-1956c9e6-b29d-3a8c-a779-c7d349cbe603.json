  "rdfs:comment": {
    "de": [
      "Eine große Auswahl an Romanen, Dokumentarfilmen, Comics, Kinderbüchern, Zeitschriften... Eine Auswahl an CDs: Jazz, Weltmusik, französische Lieder... Mitglied eines Netzwerks, das von den Gemeinden und der Communauté de communes du Pays Beaume-Drobie organisiert wird."
    ],
    "en": [
      "A large choice of novels, documentaries, comics, children's books, magazines... A selection of CDs: jazz, world music, French songs... Member of a network organized by the communes and the community of communes of the Pays Beaume-Drobie."
    ],
    "it": [
      "Un'ampia scelta di romanzi, documentari, fumetti, libri per bambini, riviste... Una selezione di CD: jazz, world music, canzoni francesi... Membro di una rete organizzata dai comuni e dalla comunità dei comuni del Pays Beaume-Drobie."
    ],
    "fr": [
      "Un grand choix de romans, documentaires, bandes déssinées, albums jeunesse, revues...Une sélection de CD : jazz, musique du monde, chansons françaises... Membre d'un réseau organisé par les communes et la communauté de communes du Pays Beaume-Drobie."
    ],
    "es": [
      "Una amplia selección de novelas, documentales, cómics, libros infantiles, revistas... Una selección de CDs: jazz, músicas del mundo, canciones francesas... Miembro de una red organizada por los municipios y la comunidad de municipios del Pays Beaume-Drobie."
    ],
    "nl": [
      "Een ruim aanbod van romans, documentaires, stripboeken, jongerenboeken, tijdschriften... Een selectie cd's: jazz, wereldmuziek, Franse muziek..."
    ]
  },
