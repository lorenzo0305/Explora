  "rdfs:comment": {
    "de": [
      "Das Café du Commerce empfängt Sie von Montagmorgen bis Sonntagmittag. Geselligkeit und gute Laune sind hier an der Tagesordnung.\nDas Café hat eine Kapazität von 80 Innen- und 80 Außenplätzen."
    ],
    "en": [
      "The Café du Commerce welcomes you from Monday morning to Sunday noon. Conviviality and good mood are there for you.\nThe Café has a capacity of 80 indoor and 80 outdoor seats."
    ],
    "it": [
      "Il Café du Commerce vi accoglie dal lunedì mattina alla domenica a pranzo. Convivialità e buon umore sono all'ordine del giorno.\nIl Café ha una capacità di 80 posti a sedere all'interno e di 80 posti all'esterno."
    ],
    "fr": [
      "Le Café du Commerce vous accueil du lundi matin au dimanche midi. Convivialité et bonne humeur sont au rendez-vous.\nLe Café à une capacité de 80 places interieures et 80 places exterieures."
    ],
    "nl": [
      "Het Café du Commerce verwelkomt u van maandagochtend tot zondagmiddag. Gezelligheid en goed humeur zijn aan de orde van de dag.\nHet Café heeft een capaciteit van 80 zitplaatsen binnen en 80 zitplaatsen buiten."
    ],
    "es": [
      "El Café du Commerce le acoge desde el lunes por la mañana hasta el domingo al mediodía. La convivencia y el buen humor están a la orden del día.\nEl Café tiene una capacidad de 80 asientos en el interior y 80 en el exterior."
    ]
  },
