  "rdfs:comment": {
    "de": [
      "Möbeltischlerei, Auftragsarbeiten für personalisierte Projekte unter Wahrung der Tradition und des handwerklichen Know-hows. Herstellung von Möbeln, Inneneinrichtung, Kreation, Kopieren alter Möbel, Einlegearbeiten, Schnitzereien und Restaurierung."
    ],
    "en": [
      "Cabinetmaking, working to order on personalised projects in keeping with tradition and craftsmanship. Furniture making, fittings, design, antique copying, marquetry, sculpture and restoration."
    ],
    "it": [
      "Ebanisteria, lavori su ordinazione per progetti personalizzati nel rispetto della tradizione e dell'artigianato. Costruzione di mobili, progettazione, creazione, copia di pezzi antichi, intarsio, scultura e restauro."
    ],
    "fr": [
      "Ebénisterie, travail à la commande sur des projets personnalisés dans le respect de la tradition et du savoir-faire artisanal. Fabrication de meubles, agencement, création, copie d'ancien, marqueterie, sculpture et restauration."
    ],
    "es": [
      "Ebanistería, trabajo por encargo en proyectos personalizados en el respeto de la tradición y la artesanía. Fabricación de muebles, maquetación, creación, copia de piezas antiguas, marquetería, escultura y restauración."
    ],
    "nl": [
      "Cabinetmaking, werken op bestelling aan gepersonaliseerde projecten met respect voor traditie en vakmanschap. Meubelmaken, lay-out, creatie, kopiëren van oude stukken, inlegwerk, beeldhouwen en restauratie."
    ]
  },
