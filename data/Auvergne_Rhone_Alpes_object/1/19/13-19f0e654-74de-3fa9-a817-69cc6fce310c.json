  "rdfs:comment": {
    "de": [
      "Laden für die Renovierung antiker Möbel, Bücher, Postkarten von 1900, Schmuck, Gemälde, Fotos, Kleinmöbel, religiöse Artikel. Hausbesuche für Projekte durch die Dekorateurin."
    ],
    "en": [
      "Vintage Furniture Renovation Boutique – specializing in antique furniture, books, postcards from the 1900s, jewelry, paintings, photographs, small furnishings, and religious items. Home visits available for interior design projects by our decorator"
    ],
    "it": [
      "Bien sûr ! Voici une traduction commerciale en italien de ton texte :\r\n\r\n\"Boutique specializzata nel restauro di mobili antichi, libri, cartoline d’epoca (1900), gioielli, quadri, fotografie, piccoli arredi e articoli religiosi. Servizio a domicilio per progetti personalizzati a cura della decoratrice"
    ],
    "fr": [
      "ART & QUINTESSENCE\r\n​Écrin de Haute Culture & Salon de thé précieux\r\n​« Un lieu de silence et d'exception au cœur de Tournon, où tableaux et œuvres singulières habitent l'espace. Entre deux découvertes, la patience infuse ou  le velours murmure."
    ],
    "nl": [
      "Boetiek gespecialiseerd in de renovatie van antieke meubels, boeken, ansichtkaarten uit 1900, juwelen, schilderijen, foto’s, klein meubilair en religieuze artikelen. Huisbezoeken voor maatwerkprojecten door de decoratrice."
    ],
    "es": [
      "ARTE Y QUINTAESENCIA\r\nun joyero de alta cultura y un precioso salón de té\r\n?\" Un lugar de silencio y excepción en el corazón de Tournon, donde pinturas y obras de arte singulares pueblan el espacio. Entre dos descubrimientos, la paciencia infunde o el terciopelo susurra."
    ]
  },
