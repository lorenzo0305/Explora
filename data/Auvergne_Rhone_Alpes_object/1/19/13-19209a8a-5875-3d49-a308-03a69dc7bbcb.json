  "rdfs:comment": {
    "de": [
      "Der Jouvet-Park gehört zu den Sehenswürdigkeiten der Stadt Valence, die man unbedingt gesehen haben muss. Ihre Schritte werden Sie ganz natürlich zu dieser 7 Hektar großen grünen Oase führen, die sich im Herzen der Stadt unterhalb der Esplanade des Champ de Mars und ihres Kiosk Peynet befindet."
    ],
    "en": [
      "Jouvet Park is one of Valence's must-see attractions. Your steps will naturally lead you to this 7-hectare green oasis, located in the heart of the city, below the Champ de Mars esplanade and its Peynet Kiosk."
    ],
    "it": [
      "Il Parco Jouvet è una delle attrazioni imperdibili di Valence. I vostri passi vi condurranno naturalmente in questo spazio verde di 7 ettari, proprio nel cuore della città, sotto la spianata del Champ de Mars e il suo chiosco Peynet."
    ],
    "fr": [
      "Le parc Jouvet fait partie des incontournables de la ville de Valence. Vos pas vous guideront naturellement vers cet écrin de verdure de 7ha, situé en plein cœur de ville, en contrebas de l'esplanade du Champ de Mars et son Kiosque Peynet."
    ],
    "nl": [
      "Het Jouvetpark is een van de must-sees van de stad Valence. Uw stappen leiden u vanzelf naar dit groene paradijs van 7 hectare, gelegen in het hart van de stad, onderaan de esplanade van het Champ de Mars en zijn Kiosque Peynet."
    ],
    "es": [
      "El parque Jouvet es una de las visitas obligadas de la ciudad de Valence. Sus pasos le llevarán naturalmente a este oasis verde de 7 hectáreas, situado en pleno centro de la ciudad, debajo de la explanada del Campo de Marte y su quiosco Peynet."
    ]
  },
