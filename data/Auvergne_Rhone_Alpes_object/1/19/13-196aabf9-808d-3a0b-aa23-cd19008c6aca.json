  "rdfs:comment": {
    "de": [
      "Bar, Restaurant.\r\nHausgemachtes Kochen\r\nSavoyer Spezialitäten. Fondues\r\nBankette (auf Anfrage).\r\nThemenabende.\r\nKaraoke Abend donnerstags im Sommer.\r\nSport Liveübertragung\r\nMöglichkeit, den Raum für einen Geburtstag, Hochzeit, etc. zu privatisieren."
    ],
    "en": [
      "Bar - restaurant\r\nHome made cooking. \r\nSavoyard specialties. Fondues.\r\nBanquets (on request).\r\nTheme evenings.\r\nSports broadcast on giant screen.\r\nPossibility to privatize the room for a birthday, wedding, etc."
    ],
    "it": [
      "Bar e ristorante.\r\nCucina casalinga.\r\nSpecialità savoiarde. Fondute.\r\nBanchetti (su ordinazione)\r\nSerate a tema.\r\nTrasmissioni sportive su schermo gigante.\r\nLa sala può essere affittata privatamente per compleanni, matrimoni, ecc."
    ],
    "fr": [
      "Bar Restaurant.\r\nCuisine familiale. \r\nSpécialités savoyardes. Fondues. \r\nBanquets (Sur commande)\r\nSoirées à thème.\r\nRetransmission sportive sur écran géant.\r\nPossibilité de privatiser la salle pour un anniversaire, mariage, etc."
    ],
    "es": [
      "Bar y restaurante.\r\nCocina casera.\r\nEspecialidades saboyanas. Fondues.\r\nBanquetes (por encargo)\r\nVeladas temáticas.\r\nRetransmisiones deportivas en pantalla gigante.\r\nLa sala puede alquilarse en privado para cumpleaños, bodas, etc."
    ],
    "nl": [
      "Bar en restaurant.\r\nThuis koken.\r\nSavoyaardse specialiteiten. Fondues.\r\nBanketten (op bestelling)\r\nThema-avonden.\r\nSportuitzendingen op groot scherm.\r\nDe zaal kan privé gehuurd worden voor verjaardagen, bruiloften, enz."
    ]
  },
