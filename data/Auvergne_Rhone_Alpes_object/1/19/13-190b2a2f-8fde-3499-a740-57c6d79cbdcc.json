  "rdfs:comment": {
    "de": [
      "Der lokale, ethische und Feinschmeckerladen in Buis les Baronnies in der Drôme Provençale. Verkauf von lokalen Produkten, Olivenöl, Honig, Käse, Obst und Gemüse, Wein und Bier, Feinkost und Aperitifplatten."
    ],
    "en": [
      "The local, ethical and gourmet grocery shop in Buis les Baronnies in the Drôme provençale."
    ],
    "it": [
      "Negozio di alimentari locali, etici e gourmet a Buis les Baronnies, nella Drôme provenzale. Vendita di prodotti locali, olio d'oliva, miele, formaggi, frutta e verdura, vini e birre, catering e vassoi per aperitivi."
    ],
    "fr": [
      "L'épicerie locale, éthique et gourmande à Buis les Baronnies dans la Drôme provençale. Vente de produits locaux, huile d’olive, miel, fromages, fruits et légumes, vins et bières, traiteur et plateaux apéro."
    ],
    "es": [
      "Tienda de alimentación local, ética y gourmet en Buis les Baronnies, en la Drôme provenzal. Venta de productos locales, aceite de oliva, miel, quesos, frutas y verduras, vinos y cervezas, catering y bandejas de aperitivo."
    ],
    "nl": [
      "De lokale, ethische en gastronomische kruidenierswinkel in Buis les Baronnies in de Drôme provençale. Verkoop van lokale producten, fruit en groenten, kaas, wijn en bier, olijfolie, honing, huisgemaakte producten..."
    ]
  },
