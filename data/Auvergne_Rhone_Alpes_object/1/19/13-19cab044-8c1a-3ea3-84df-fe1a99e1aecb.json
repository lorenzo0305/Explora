  "rdfs:comment": {
    "de": [
      "In seiner 22-jährigen Karriere hat DANAKIL es vom Underground auf die größten internationalen Bühnen geschafft und ist dabei seiner rootsigen, engagierten und unabhängigen Identität über sein eigenes Label, Baco Music, treu geblieben."
    ],
    "en": [
      "In a career spanning 22 years, DANAKIL has moved from the underground to the biggest international stages, remaining true to its roots-based, committed and independent identity via its own label, Baco Music."
    ],
    "it": [
      "In 22 anni di carriera, i DANAKIL sono passati dall'underground ai più grandi palcoscenici internazionali, rimanendo fedeli alla loro identità rootsy, impegnata e indipendente attraverso la propria etichetta, Baco Music."
    ],
    "fr": [
      "En 22 ans de carrière, DANAKIL est passé de l’underground aux plus grandes scènes internationales en restant fidèle à son identité roots, engagée et indépendante via son propre label, Baco Music."
    ],
    "nl": [
      "In een carrière die 22 jaar omspant, heeft DANAKIL zich verplaatst van de underground naar de grootste internationale podia, trouw blijvend aan hun rootsy, geëngageerde en onafhankelijke identiteit via hun eigen label, Baco Music."
    ],
    "es": [
      "En 22 años de carrera, DANAKIL ha pasado del underground a los grandes escenarios internacionales, manteniéndose fiel a su identidad arraigada, comprometida e independiente a través de su propio sello, Baco Music."
    ]
  },
