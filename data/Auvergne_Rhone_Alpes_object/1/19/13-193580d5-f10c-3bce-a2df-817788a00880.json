  "rdfs:comment": {
    "de": [
      "DER UNUMGÄNGLICHE TERMIN IN LA CLUSAZ!\r\nEin Ort der Begegnung, des Austauschs und der Geselligkeit, der Familien und Gruppen von Freunden begeistern wird!"
    ],
    "en": [
      "THE UNMISSABLE MEETING PLACE IN LA CLUSAZ!\r\nA place for gathering, sharing, and conviviality that will delight families and groups of friends!"
    ],
    "it": [
      "L'EVENTO DA NON PERDERE A LA CLUSAZ!\r\nUn luogo dove le famiglie e i gruppi di amici possono incontrarsi, condividere e godere della reciproca compagnia!"
    ],
    "fr": [
      "LE RENDEZ-VOUS INCONTOURNABLE À LA CLUSAZ !\r\nUn lieu de rencontres, de partage et de convivialité qui ravira les familles et les groupes d'amis !"
    ],
    "es": [
      "¡LA CITA INELUDIBLE DE LA CLUSAZ!\r\nUn lugar donde las familias y los grupos de amigos pueden reunirse, compartir y disfrutar de la compañía de los demás"
    ],
    "nl": [
      "DE ONMISBARE ONTMOETINGSPLAATS IN LA CLUSAZ!\r\nEen plek voor samenkomst, delen en gezelligheid die gezinnen en vriendengroepen zal verrukken!"
    ]
  },
