      "@id": "https://data.datatourisme.fr/9094ea6e-5f93-3405-be9a-88e14893ab2c",
      "dc:description": {
        "de": [
          "Philippe Laurent und Delphine James werden am Freitag, dem 15. August, eine stimmungsvolle Musical-Show bieten!\nAbend in der Bar\nFriterie Chez les Frangines auf dem Dorfplatz."
        ],
        "en": [
          "Join Philippe Laurent and Delphine James on Friday August 15 for a lively Musical Show!\nBar evening\nFriterie Chez les Frangines on the village square."
        ],
        "it": [
          "Unitevi a Philippe Laurent e Delphine James venerdì 15 agosto per un vivace spettacolo musicale!\nSerata al bar\nFriterie Chez les Frangines sulla piazza del villaggio."
        ],
        "fr": [
          "Retrouvez Philippe Laurent et Delphine James le vendredi 15 Août pour un Show Musical ambiancé !\nSoirée Bar\nFriterie Chez les Frangines sur la Place du village."
        ],
        "es": [
          "Únase a Philippe Laurent y Delphine James el viernes 15 de agosto para disfrutar de un animado espectáculo musical\nNoche de bar\nFriterie Chez les Frangines en la plaza del pueblo."
        ],
        "nl": [
          "Kom op vrijdag 15 augustus naar Philippe Laurent en Delphine James voor een levendige muzikale show!\nBar avond\nFriterie Chez les Frangines op het dorpsplein."
        ]
      },
