  "rdfs:comment": {
    "de": [
      "Der Gardon forézien verwaltet 12 lokale Teiche, darunter den Etang de la Gerle, Flüsse der 1. Fischkategorie (Bonson, Ecolèze...) sowie einen Abschnitt des Flusses Loire (von Grangent bis Veauchette)."
    ],
    "en": [
      "The Gardon forézien manages 12 local ponds, including the Etang de la Gerle, 1st category rivers (Bonson, Ecolèze, etc.) and a section of the Loire River (from Grangent to Veauchette)."
    ],
    "it": [
      "Il Gardon forézien gestisce 12 stagni locali, tra cui l'Etang de la Gerle, fiumi di prima categoria (il Bonson, l'Ecolèze, ecc.) e un tratto del fiume Loira (da Grangent a Veauchette)."
    ],
    "fr": [
      "Le Gardon forézien a pour gestion 12 étangs locaux dont l'étang de la Gerle, des rivières de 1ère catégorie piscicole (le Bonson, l'Ecolèze...) ainsi qu'une portion du fleuve Loire (de Grangent à Veauchette). "
    ],
    "es": [
      "El Gardon forézien gestiona 12 estanques locales, entre ellos el Etang de la Gerle, ríos de 1ª categoría (el Bonson, el Ecolèze, etc.) y un tramo del río Loira (de Grangent a Veauchette)."
    ],
    "nl": [
      "De Gardon forézien beheert 12 lokale vijvers, waaronder het Etang de la Gerle, rivieren van de 1e categorie (de Bonson, de Ecolèze, enz.) en een deel van de rivier de Loire (van Grangent tot Veauchette)."
    ]
  },
