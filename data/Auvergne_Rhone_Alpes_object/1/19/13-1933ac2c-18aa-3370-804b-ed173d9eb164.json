  "rdfs:comment": {
    "de": [
      "Machen Sie einen unvergesslichen Spaziergang durch die Landschaft mit einem ruhigen und saften Esel, um das Erbe zu entdecken, und außergewöhnliche Ausblicke zu geniessen. Ihr langohriger Begleiter ist ein idealer Wanderführer."
    ],
    "en": [
      "At the Ferme des Genti’anes, go on an unforgettable walk in the countryside to discover the heritage, and exceptional views with calm, gentle donkey. Your long-eared companion will be an ideal guide on the hiking trails!"
    ],
    "it": [
      "Alla Ferme des Genti'anes, fate una passeggiata indimenticabile in campagna per scoprire il patrimonio e i panorami eccezionali con un asino calmo e gentile. Il vostro compagno dalle lunghe orecchie sarà la guida ideale per le escursioni!"
    ],
    "fr": [
      "A la Ferme des Genti'anes, partez pour une promenade inoubliable dans la campagne pour découvrir le patrimoine, et des vues exceptionnelles avec un âne calme et doux. Votre compagnon aux longues oreilles sera un guide idéal sur les chemins de randonnées !"
    ],
    "nl": [
      "Maak in de Ferme des Genti'anes een onvergetelijke wandeling op het platteland om het erfgoed en de uitzonderlijke uitzichten te ontdekken met een rustige, zachte ezel. Je metgezel met lange oren zal een ideale gids zijn op de wandelpaden!"
    ],
    "es": [
      "En la Ferme des Genti'anes, dé un inolvidable paseo por el campo para descubrir el patrimonio y unas vistas excepcionales con un burro tranquilo y manso. Su compañero de largas orejas será un guía ideal en las rutas de senderismo"
    ]
  },
