  "rdfs:comment": {
    "de": [
      "Bretonische Crêperie\r\nSnacks zu jeder Tageszeit\r\nTeestube\r\nKomplette Frühstücke\r\n\r\nSommer und Winter geöffnet\r\n\r\nGeöffnet von 7:30 bis 19:00 Uhr\r\nAuf Reservierung nach 19.00 Uhr\r\nRuhetag montags."
    ],
    "en": [
      "Crêperie\r\nSnack during the whole day\r\nTearoom \r\nBreakfasts\r\n\r\nOpen in summer and winter\r\nClosed on Mondays."
    ],
    "it": [
      "Creperia bretone\r\nSnack bar in qualsiasi momento della giornata\r\nSala da tè\r\nColazione completa\r\n\r\nAperto in estate e in inverno\r\n\r\nAperto dalle 7.30 alle 19.00\r\nSu prenotazione dopo le 19.00\r\nChiuso il lunedì."
    ],
    "fr": [
      "Crêperie bretonne\r\nSnack à toute heure de la journée\r\nSalon de thé\r\nPetits déjeuners complets\r\n\r\nOuvert été comme hiver\r\n\r\nOuvert de 7h30 à 19h00\r\nSur réservation après 19h00\r\nJour de fermeture les lundis."
    ],
    "es": [
      "Crepería bretona\r\nCafetería a cualquier hora del día\r\nSalón de té\r\nDesayunos completos\r\n\r\nAbierto verano e invierno\r\n\r\nAbierto de 7.30 a 19.00 horas\r\nCon reserva previa a partir de las 19.00 horas\r\nCerrado los lunes."
    ],
    "nl": [
      "Bretoense pannenkoeken\r\nSnacks op elk uur van de dag\r\nTheesalon\r\nEen volledig ontbijt\r\nOpen zomer en winter\r\n\r\nGesloten op maandag."
    ]
  },
