  "rdfs:comment": {
    "de": [
      "Yoga- und Pilateslehrerin, Krankenschwester und Waldtherapeutin. Ich biete Pilates-, Swiss-Ball-, Stretching-, Yoga- und Yoga-Nidra-Kurse in Gruppen oder einzeln an. Kräftigung, Mobilität, Flexibilität, Atmung. Entspannung, Verbindung zu sich selbst."
    ],
    "en": [
      "Yoga and Pilates teacher, nurse and sylvotherapist, I offer Pilates, Swiss-Ball, Stretching, Yoga and Yoga-Nidra classes in group or individual. Reinforcement, mobility, flexibility, breathing. Relaxation and connection to oneself."
    ],
    "it": [
      "Insegnante di yoga e pilates, infermiera e terapista del bosco, offro lezioni di gruppo e individuali di pilates, Swiss-Ball, stretching, yoga e yoga-nidra. Rafforzamento, mobilità, flessibilità, respirazione. Rilassamento e connessione con se stessi."
    ],
    "fr": [
      "Professeur de yoga et Pilates, infirmière et sylvothérapeute, je propose des cours de Pilates, Swiss-Ball, Stretching, Yoga et Yoga-Nidra en groupe ou individuel. Renforcement, mobilité, flexibilité, respiration. Détente et relaxation, connexion à soi."
    ],
    "nl": [
      "Professeur de yoga et Pilates, infirmière et sylvothérapeute, je propose des cours de Pilates, Swiss-Ball, Stretching, Yoga et Yoga-Nidra en groupe ou individuel. Renforcement, mobilité, flexibilité, respiration. Détente et relaxation, connexion à soi."
    ],
    "es": [
      "Profesora de yoga y Pilates, enfermera y terapeuta del bosque, ofrezco clases grupales e individuales de Pilates, Swiss-Ball, Estiramientos, Yoga y Yoga-Nidra. Fortalecimiento, movilidad, flexibilidad, respiración. Relajación y autoconexión."
    ]
  },
