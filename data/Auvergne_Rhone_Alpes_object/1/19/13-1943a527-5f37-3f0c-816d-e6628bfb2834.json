  "rdfs:comment": {
    "de": [
      "Yzeure Tango Festival: Workshops, Milongas, Orchester Quarteto El Compas, internationale DJs, Tango-Aperitif & Abendessen, Vorführungen von Maestros, Verkaufsausstellung, argentinische Produkte und eine herzliche Atmosphäre. Ein Wochenende zu 100 % Tango!"
    ],
    "en": [
      "Yzeure Tango Festival: workshops, milongas, Quarteto El Compas orchestra, international DJs, tango aperitif & dinner, maestro demonstrations, exhibition and sale of Argentine products and a warm atmosphere. A 100% tango weekend!"
    ],
    "it": [
      "Yzeure Tango Festival: workshop, milonghe, orchestra Quarteto El Compas, DJ internazionali, aperitivo e cena di tango, dimostrazioni di maestri, esposizione e vendita di prodotti argentini e una calda atmosfera. Un weekend 100% tango!"
    ],
    "fr": [
      "Yzeure Tango Festival : stages, milongas, orchestre Quarteto El Compas, DJs internationaux, apéro & dîner tango, démonstrations de maestros, expo-vente, produits argentins et ambiance chaleureuse. Un week-end 100 % tango !"
    ],
    "nl": [
      "Yzeure Tango Festival: workshops, milongas, orkest Quarteto El Compas, internationale DJ's, tango aperitief & diner, maestro demonstraties, tentoonstelling en verkoop van Argentijnse producten en een warme sfeer. Een 100% tango weekend!"
    ],
    "es": [
      "Yzeure Tango Festival: talleres, milongas, orquesta Quarteto El Compas, DJs internacionales, aperitivo y cena de tango, demostraciones de maestros, exposición y venta de productos argentinos y un ambiente cálido. ¡Un fin de semana 100% tango!"
