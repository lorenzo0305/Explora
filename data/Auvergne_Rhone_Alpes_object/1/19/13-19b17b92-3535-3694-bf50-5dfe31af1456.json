  "rdfs:comment": {
    "de": [
      "Das Restaurant FLUNCH Le Puy mit seinen ebenso abwechslungsreichen wie leckeren Gerichten ist der ideale Ort, um einen gemütlichen Moment mit der Familie oder Kollegen zu genießen."
    ],
    "en": [
      "The FLUNCH Le Puy restaurant, with its varied and gourmet dishes, is the ideal place to enjoy a warm moment with family or colleagues."
    ],
    "it": [
      "Il ristorante FLUNCH Le Puy, con i suoi piatti variegati e deliziosi, è il luogo ideale per gustare un pasto caldo in famiglia o con i colleghi."
    ],
    "fr": [
      "Le restaurant FLUNCH Le Puy avec ses plats aussi variés que gourmands est l'endroit idéal pour savourer un moment chaleureux en famille ou entre collègues."
    ],
    "nl": [
      "Het restaurant FLUNCH Le Puy, met zijn gevarieerde en heerlijke gerechten, is de ideale plek om te genieten van een warme maaltijd met familie of collega's."
    ],
    "es": [
      "El restaurante FLUNCH Le Puy, con sus variados y deliciosos platos, es el lugar ideal para disfrutar de una cálida comida en familia o con los colegas."
    ]
  },
