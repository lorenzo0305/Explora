  "rdfs:comment": {
    "de": [
      "Genießen Sie die Auswahl des Geschäftsführers, dessen Weinkeller voll von außergewöhnlichen Weinen ist, die die Errungenschaften regionaler und anderer Produzenten ehren."
    ],
    "en": [
      "Take advantage of the manager's selections, whose wine cellar abounds in exceptional vintages, honouring the achievements of regional producers and others."
    ],
    "it": [
      "Approfittate della selezione del gestore, la cui cantina è ricca di vini eccezionali, con i successi di produttori regionali e non."
    ],
    "fr": [
      "Profitez des sélection du gérant dont la cave à vins regorge de crus d'exception, mettant à l'honneur les réalisations des producteurs régionaux et d'autres."
    ],
    "nl": [
      "Profiteer van de selectie van de manager, wiens wijnkelder vol staat met uitzonderlijke wijnen, met de prestaties van regionale en andere producenten."
    ],
    "es": [
      "Aproveche la selección del gerente, cuya bodega está llena de vinos excepcionales, con los logros de los productores regionales y de otros países."
    ]
  },
