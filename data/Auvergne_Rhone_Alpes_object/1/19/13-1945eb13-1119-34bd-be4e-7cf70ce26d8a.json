  "rdfs:comment": {
    "de": [
      "Zahlreiche Vorschläge für Wanderwege zwischen Isère und Savoyen, für Erwachsene und Kinder. Im Allgemeinen bilden wir im Interesse der Qualität kleine Gruppen. Dies ermöglicht einen menschlichen und pädagogischen Ansatz bei unseren Aktivitäten"
    ],
    "en": [
      "Many route suggestions between Isère and Savoie, for adults and children. Generally speaking, in the interest of quality, we form small groups. This allows a human and educational approach to our activities."
    ],
    "it": [
      "Una vasta gamma di itinerari tra Isère e Savoia, per adulti e bambini. In linea di massima, nell'interesse della qualità, manteniamo i nostri gruppi piccoli. Questo ci permette di avere un approccio più umano ed educativo alle nostre attività"
    ],
    "fr": [
      "De nombreuses propositions de parcours entre Isère et Savoie, pour adultes et enfants. D'une manière générale, dans un soucis de qualité, nous formons des groupes réduits. Cela permet une approche humaine et pédagogique de nos activités"
    ],
    "es": [
      "Una amplia gama de rutas entre Isère y Saboya, para adultos y niños. Por regla general, en aras de la calidad, nuestros grupos son reducidos. Esto nos permite dar un enfoque más humano y educativo a nuestras actividades"
    ],
    "nl": [
      "Een breed scala aan routes tussen Isère en Savoie, voor volwassenen en kinderen. Omwille van de kwaliteit houden we onze groepen over het algemeen klein. Zo kunnen we onze activiteiten menselijker en educatiever maken"
    ]
  },
