  "rdfs:comment": {
    "de": [
      "Mit unserer 20-jährigen Erfahrung in der Natur bieten wir Ihnen ein breites Spektrum an sportlichen Aktivitäten für Groß und Klein im Vercors und in der Nähe von Grenoble."
    ],
    "en": [
      "With 20 years' experience in outdoor activities, we offer a range of sporting activities for young and old in the Vercors and near Grenoble."
    ],
    "it": [
      "Con 20 anni di esperienza nelle attività all'aria aperta, offriamo una gamma di attività sportive per giovani e meno giovani nel Vercors e vicino a Grenoble."
    ],
    "fr": [
      "Fort de nos 20 années d’expérience dans les activités de pleine nature, nous vous proposons un panel d’activités sportives pour petits et grands dans le Vercors et proche de Grenoble."
    ],
    "nl": [
      "Met 20 jaar ervaring in outdooractiviteiten bieden we een scala aan sportieve activiteiten voor jong en oud in de Vercors en in de buurt van Grenoble."
    ],
    "es": [
      "Con 20 años de experiencia en actividades al aire libre, ofrecemos una gama de actividades deportivas para jóvenes y mayores en el Vercors y cerca de Grenoble."
    ]
  },
