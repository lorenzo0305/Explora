  "rdfs:comment": {
    "de": [
      "Mit Blick auf den Mont-Blanc empfängt Sie die Auberge du Bois Prin auf der Sonnenseite des Chamonix-Tals."
    ],
    "en": [
      "Facing the Mont-Blanc, the Auberge du Bois Prin welcomes you on the sunny side of the Chamonix valley."
    ],
    "it": [
      "Di fronte al Monte Bianco, l'Auberge du Bois Prin vi accoglie sul lato soleggiato della Valle di Chamonix."
    ],
    "fr": [
      "Face au Mont-Blanc, l'Auberge du Bois Prin vous accueille sur le versant ensoleillé de la vallée de Chamonix."
    ],
    "es": [
      "Frente al Mont Blanc, el Auberge du Bois Prin le da la bienvenida en el lado soleado del valle de Chamonix."
    ],
    "nl": [
      "De Auberge du Bois Prin kijkt uit op de Mont Blanc en verwelkomt u aan de zonnige kant van de vallei van Chamonix."
    ]
  },
