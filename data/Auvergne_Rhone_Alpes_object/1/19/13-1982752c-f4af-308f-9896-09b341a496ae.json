  "rdfs:comment": {
    "de": [
      "Auf dem Wasser, unter der Erde oder in der Luft - mit Ceven?Aventure entdecken Sie neue Sensationen in einer außergewöhnlichen natürlichen Umgebung."
    ],
    "en": [
      "Ceven'Aventure introduces you to new thrills on the water, underground and in the air in a fabulous natural setting."
    ],
    "it": [
      "In acqua, sottoterra o in aria, con Ceven?Aventure scoprite nuove sensazioni in un ambiente naturale eccezionale."
    ],
    "fr": [
      "Sur l’eau, sous terre ou dans les airs, avec Ceven’Aventure découvrez de nouvelles sensations dans milieu naturel exceptionnel."
    ],
    "nl": [
      "Op het water, onder de grond of in de lucht, met Ceven?Aventure ontdek je nieuwe sensaties in een uitzonderlijke natuurlijke omgeving."
    ],
    "es": [
      "En el agua, bajo tierra o en el aire, con Ceven?Aventure descubra nuevas sensaciones en un entorno natural excepcional."
    ]
  },
