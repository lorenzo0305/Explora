  "rdfs:comment": {
    "de": [
      "Anstelle des denkmalgeschützten Maison des Chanoines in Saint-Chamond bietet Casa Gina handwerklich hergestellte italienische Küche mit Leidenschaft und Festlichkeit."
    ],
    "en": [
      "In place of the Maison des Chanoines, a listed building in Saint-Chamond, Le Blindcat recreates the jazzy chic atmosphere of the New York speakeasies of the 1920s."
    ],
    "it": [
      "Situata nella Maison des Chanoines, un edificio tutelato a Saint-Chamond, Casa Gina offre una cucina italiana artigianale con una passione per la cucina di festa."
    ],
    "fr": [
      "En lieu et place de la Maison des Chanoines, une demeure classée Monument Historique à Saint-Chamond, Casa Gina propose une cuisine artisanale italienne, de passion et festive."
    ],
    "es": [
      "Situada en la Maison des Chanoines, un edificio protegido de Saint-Chamond, Casa Gina ofrece cocina italiana artesanal con pasión por la cocina festiva."
    ],
    "nl": [
      "Casa Gina is gevestigd in het Maison des Chanoines, een monumentaal pand in Saint-Chamond, en biedt een ambachtelijke Italiaanse keuken met een passie voor feestelijke gerechten."
    ]
  },
  "rdfs:label": {
