  "rdfs:comment": {
    "de": [
      "Im Herzen des Kurortes Mont-Dore empfängt Sie das Hôtel du Parc im Sancy-Massiv, mitten im Regionalen Naturpark Volcans d'Auvergne."
    ],
    "en": [
      "In the heart of the Mont-Dore thaml baths town, the Hotel du Parc welcomes you in the Massif du Sancy, in the heart of the Auvergne Volcanoes Regional Natural Park."
    ],
    "it": [
      "Nel cuore della città termale di Le Mont-Dore, l'Hôtel du Parc vi accoglie nel Massiccio del Sancy, al centro del Parc Naturel Régional des Volcans d'Auvergne."
    ],
    "fr": [
      "Au coeur de la station thermale du Mont-Dore, l’Hôtel du Parc vous accueille dans le Massif du Sancy, en plein Parc Naturel Régional des Volcans d’Auvergne."
    ],
    "nl": [
      "In het hart van het kuuroord Le Mont-Dore verwelkomt Hôtel du Parc u in het Massif du Sancy, midden in het Parc Naturel Régional des Volcans d'Auvergne."
    ],
    "es": [
      "En el corazón de la ciudad balneario de Le Mont-Dore, el Hôtel du Parc le da la bienvenida en el Macizo del Sancy, en medio del Parque Natural Regional de los Volcanes de Auvernia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel du Parc"
    ]
  },
