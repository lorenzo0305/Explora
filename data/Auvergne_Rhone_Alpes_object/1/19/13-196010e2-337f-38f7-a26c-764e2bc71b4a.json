  "rdfs:comment": {
    "de": [
      "Etwa 40 Sängerinnen und Sänger unter der Leitung von Valérie Charlot nehmen Sie mit auf eine Reise mit Liedern zum Thema Eurovision.\r\nWeitere Informationen unter CHORALE-BEAUZAC.43590@orange.fr oder 06.35.91.92.69"
    ],
    "en": [
      "Some forty choristers, led by Valérie Charlot, will take you on a musical journey on the theme of Eurovision.\r\nFurther information at CHORALE-BEAUZAC.43590@orange.fr or 06.35.91.92.69"
    ],
    "it": [
      "Una quarantina di coristi, guidati da Valérie Charlot, vi accompagneranno in un viaggio musicale sul tema dell'Eurovisione.\r\nUlteriori informazioni su CHORALE-BEAUZAC.43590@orange.fr o allo 06.35.91.92.69"
    ],
    "fr": [
      "Une quarantaine de choristes dirigés par Valérie Charlot vous font voyager en chanson sur le thème de l’Eurovision.\r\nPlus de renseignement à CHORALE-BEAUZAC.43590@orange.fr ou au 06.35.91.92.69"
    ],
    "nl": [
      "Zo'n veertig koorleden, onder leiding van Valérie Charlot, nemen je mee op een muzikale reis rond het thema Eurovisie.\r\nMeer informatie op CHORALE-BEAUZAC.43590@orange.fr of op 06.35.91.92.69"
    ],
