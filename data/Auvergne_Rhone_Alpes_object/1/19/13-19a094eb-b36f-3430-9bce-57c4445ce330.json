  "rdfs:comment": {
    "de": [
      "Erkunden Sie in meinem Atelier die bezaubernde Welt der Wolle! Tauchen Sie ein in eine fesselnde Reise durch die Geheimnisse ihrer Verarbeitung. Faszinierende Vorführungen, spielerische Einführungen: vom Spinnen bis zum Filzen. Ein Erlebnis für alle Altersgruppen."
    ],
    "en": [
      "Explore the enchanting world of wool in my workshop! Dive into a captivating journey through the secrets of wool's transformation. Fascinating demonstrations, playful initiations: from spinning to felting. An experience for all ages."
    ],
    "it": [
      "Esplorate l'affascinante mondo della lana nel mio laboratorio! Immergetevi in un viaggio affascinante attraverso i segreti della trasformazione della lana. Dimostrazioni affascinanti e introduzioni divertenti: dalla filatura all'infeltrimento. Un'esperienza per tutte le età."
    ],
    "fr": [
      "Explorez l'univers envoûtant de la laine dans mon atelier ! Plongez dans un voyage captivant à travers les secrets de sa transformation. Des démonstrations fascinantes, des initiations ludiques : du filage au feutrage. Une expérience pour tous les âges."
    ],
    "es": [
      "¡Explore el cautivador mundo de la lana en mi taller! Sumérjase en un cautivador viaje a través de los secretos de la transformación de la lana. Demostraciones fascinantes y divertidas introducciones: del hilado al fieltrado. Una experiencia para todas las edades."
    ],
    "nl": [
      "Ontdek de fascinerende wereld van wol in mijn workshop! Duik in een fascinerende reis door de geheimen van de transformatie van wol. Boeiende demonstraties en leuke inleidingen: van spinnen tot vilten. Een ervaring voor alle leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sur les Chemins de la Laine"
    ]
  },
