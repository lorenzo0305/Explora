  "rdfs:comment": {
    "de": [
      "In unserem Gîte-Hotel finden Sie alle Annehmlichkeiten für Ihren Aufenthalt in den Bergen. Unsere ehemalige Molkerei beherbergt 15 Zimmer (2 bis 4 Plätze) mit eigenem WC und Badezimmer. Aurélie, Sébastien und ihr Team heißen Sie das ganze Jahr über willkommen."
    ],
    "en": [
      "In our gite-hotel, you'll find all the comforts you need for your stay in the mountains. Our former dairy has 15 rooms (2 to 4 people) with private toilets and bathrooms. Aurélie, Sébastien and their team welcome you all year round"
    ],
    "it": [
      "Nel nostro gîte-hotel troverete tutti i comfort per i vostri soggiorni in montagna. Il nostro ex caseificio ospita 15 camere (da 2 a 4 persone) con servizi igienici e bagni privati. Aurélie, Sébastien e il loro team vi accolgono tutto l'anno"
    ],
    "fr": [
      "Vous trouverez dans notre gîte-hôtel, tout le confort pour vos séjours à la montagne. Notre ancienne laiterie abrite 15 chambres (2 à 4 places) avec WC et salles d'eau privatifs. Aurélie, Sébastien et leur équipe vous y accueillent tout au long de l'année"
    ],
    "nl": [
      "In ons gîte-hotel vindt u alle comfort voor uw verblijf in de bergen. Onze voormalige melkfabriek herbergt 15 kamers (2 tot 4 personen) met eigen sanitair. Aurélie, Sébastien en hun team heten u het hele jaar door welkom"
    ],
    "es": [
      "Encontrará en nuestro gîte-hotel, todo el confort para sus estancias en la montaña. Nuestra antigua lechería alberga 15 habitaciones (de 2 a 4 personas) con aseos y baños privados. Aurélie, Sébastien y su equipo le dan la bienvenida todo el año"
    ]
  },
