  "rdfs:comment": {
    "de": [
      "Andromée ist eine zirkuläre Kosmetikmarke, die von einer Unternehmerin gegründet wurde, die für ihr Engagement für nachhaltige und ökologisch verantwortliche Schönheit bekannt ist (Sourcing von Co-Produkten aus der Bio-Lebensmittelindustrie)."
    ],
    "en": [
      "Andromée is a circular cosmetics brand founded by an entrepreneur renowned for her commitment to sustainable, eco-responsible beauty (sourcing co-products from the organic food industry)."
    ],
    "it": [
      "Andromée è un marchio di cosmetici circolari fondato da un'imprenditrice nota per il suo impegno a favore di una bellezza sostenibile ed eco-responsabile (che si rifornisce di co-prodotti dall'industria alimentare biologica)"
    ],
    "fr": [
      "Andromée est une marque de cosmétique circulaire fondée par une entrepreneure reconnue pour son engagement en faveur de la beauté durable et écoresponsable (sourcing de co-produits de l'industrie agroalimentaire bio)"
    ],
    "nl": [
      "Andromée is een circulair cosmeticamerk dat is opgericht door een ondernemer die bekend staat om haar inzet voor duurzame, ecologisch verantwoorde schoonheid (met bijproducten uit de biologische voedingsindustrie)."
    ],
    "es": [
      "Andromée es una marca de cosmética circular fundada por una empresaria reconocida por su compromiso con la belleza sostenible y ecorresponsable (se abastece de coproductos de la industria alimentaria ecológica)"
    ]
  },
