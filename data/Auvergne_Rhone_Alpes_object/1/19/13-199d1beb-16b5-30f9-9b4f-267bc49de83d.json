  "rdfs:comment": {
    "de": [
      "Empfang der Gäste im Haus der Eigentümerin an einem großen, warmen und geselligen Tisch.\r\nVorschlag eines einzigartigen, wöchentlich wechselnden Menüs im Rhythmus der Jahreszeiten und nach Lust und Laune."
    ],
    "en": [
      "Reception of guests at the owner's home, around a large, warm and convivial table.\r\nUnique menu proposal, changing weekly, according to season and mood."
    ],
    "it": [
      "Gli ospiti vengono accolti a casa del proprietario, attorno a un grande tavolo caldo e accogliente.\r\nUn menu unico, che cambia ogni settimana, in base alle stagioni e ai vostri desideri."
    ],
    "fr": [
      "Réception des convives au domicile de la propriétaire, autour d'une grande table chaleureuse et conviviale.\r\nProposition de menu unique, changeant chaque semaine, au rythme des saisons et des envies."
    ],
    "es": [
      "Los huéspedes son recibidos en casa del propietario, en torno a una mesa grande, cálida y acogedora.\r\nUn menú único, que cambia cada semana, según las estaciones y sus deseos."
    ],
    "nl": [
      "Gasten worden ontvangen bij de eigenaar thuis, rond een grote, warme en vriendelijke tafel.\r\nEen uniek menu, elke week wisselend, afhankelijk van de seizoenen en uw wensen."
    ]
  },
  "rdfs:label": {
