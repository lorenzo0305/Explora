  "rdfs:comment": {
    "de": [
      "In Fay-sur-Lignon züchtet diese Farm Schafe und produziert Honig. Sie bietet Fertiggerichte aus Schafsfleisch, Produkte aus dem Bienenstock sowie handwerklich hergestelltes Honigbier, Seifen, Bonbons und Met zum Direktverkauf ab Hof an."
    ],
    "en": [
      "In Fay-sur-Lignon, this farm raises sheep and produces honey. It offers ready-made meals based on ewe meat and beehive products, as well as artisanal honey beers, soaps, candies and mead sold directly from the farm."
    ],
    "it": [
      "Questa fattoria di Fay-sur-Lignon alleva pecore e produce miele. Offre piatti cucinati con carne di pecora e prodotti dell'alveare, oltre a birre al miele tradizionali, saponi, dolci e idromele venduti direttamente dalla fattoria."
    ],
    "fr": [
      "À Fay-sur-Lignon, cette ferme élève des brebis et produit du miel. Elle propose des plats cuisinés à base de viande de brebis, des produits de la ruche, ainsi que des bières artisanales au miel, savons, bonbons et hydromel en vente directe à la ferme."
    ],
    "es": [
      "Esta granja de Fay-sur-Lignon cría ovejas y produce miel. Ofrece platos preparados con carne de oveja y productos de la colmena, así como cervezas artesanales con miel, jabones, dulces e hidromiel vendidos directamente en la granja."
    ],
    "nl": [
      "Deze boerderij in Fay-sur-Lignon fokt ooien en produceert honing. Je kunt er gerechten bereiden op basis van schapenvlees en producten van de bijenkorf, maar ook traditioneel honingbier, zeep, snoep en honingdrank die rechtstreeks van de boerderij worden verkocht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme du Mont"
    ]
  },
