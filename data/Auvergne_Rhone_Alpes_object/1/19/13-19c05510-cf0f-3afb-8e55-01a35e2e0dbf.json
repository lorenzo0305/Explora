  "rdfs:comment": {
    "de": [
      "Workshops zu Natur- und Biokosmetik. Kreation und Herstellung von hausgemachten Kosmetika und Haushaltsprodukten für Erwachsene, Kinder und Berufstätige. Mögliche Workshops zu Hause (Geburtstag, EVJF, Event, oder zum Vergnügen."
    ],
    "en": [
      "Natural and organic cosmetics workshops. Creation and production of homemade cosmetics and household products, for adults, children and professionals. Workshops available at home (birthdays, EVJF, events, or for pleasure."
    ],
    "it": [
      "Laboratori di cosmesi naturale e biologica. Creazione e produzione di cosmetici e prodotti per la casa fatti in casa, per adulti, bambini e professionisti. Laboratori disponibili a domicilio (compleanni, occasioni speciali, eventi o semplicemente per divertimento)."
    ],
    "fr": [
      "Ateliers cosmétiques naturels et bio. Création et réalisation de cosmétiques et produits ménagers maison, pour adultes, enfants et professionnels. Ateliers possibles à domicile (anniversaire, EVJF, évènement, ou pour le plaisir."
    ],
    "es": [
      "Talleres de cosmética natural y ecológica. Creación y elaboración de cosméticos caseros y productos para el hogar, para adultos, niños y profesionales. Talleres disponibles a domicilio (cumpleaños, ocasiones especiales, eventos o simplemente por diversión)."
    ],
    "nl": [
      "Natuurlijke en biologische cosmetica workshops. Creatie en productie van zelfgemaakte cosmetica en huishoudelijke producten, voor volwassenen, kinderen en professionals. Workshops aan huis (verjaardagen, speciale gelegenheden, evenementen of gewoon voor de lol)."
    ]
  },
