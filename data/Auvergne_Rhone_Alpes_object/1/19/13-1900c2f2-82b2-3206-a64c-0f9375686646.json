  "rdfs:comment": {
    "de": [
      "Beim Pumptrack werden mit einem Mountainbike, Roller oder Inline-Skates und auf einer geschlossenen Strecke Steilkurven, Senken und Buckel aneinandergereiht."
    ],
    "en": [
      "The Pump Track combines a series of banked bends, cavities and bumps on a fun MTB track to practise the use of the bike."
    ],
    "it": [
      "Il pump track permette di collegare curve alte, basse e sconnesse con una mountain bike, uno scooter o un rollerblade su una pista chiusa."
    ],
    "fr": [
      "Le Pump track permet d'enchaîner des virages relevés, creux et bosses en VTT, trottinette ou roller et sur une piste fermée."
    ],
    "nl": [
      "Pump track is een reeks schuine bochten, dips en hobbels op een gesloten baan op een mountainbike, step of skeeler."
    ],
    "es": [
      "La pista de bombeo permite enlazar giros altos, bajos y accidentados en una bicicleta de montaña, un scooter o un patín en una pista cerrada."
    ]
