  "rdfs:comment": {
    "de": [
      "Zwischen Rocamadour und den Bergen des Cantal empfängt Sie in Siran das Museum für Akkordeon und Volksmusikinstrumente. Die Brüder Cazes haben im Laufe ihres Lebens eine außergewöhnliche Sammlung von Akkordeons, Drehleiern und Cabrettes zusammengetragen."
    ],
    "en": [
      "Between Rocamadour and the Mounts of Cantal, the Accordion and Popular Music Instruments Museum welcome you to Siran. Over the course of their lives, the Cazes brothers built up an exceptional collection of accordions, hurdy-gurdies and cabrettes."
    ],
    "it": [
      "Tra Rocamadour e le montagne del Cantal, il Museo della Fisarmonica e degli Strumenti di Musica Popolare vi dà il benvenuto a Siran. Nel corso della loro vita, i fratelli Cazes hanno costruito una collezione eccezionale di fisarmoniche, ghironde e cabrettes."
    ],
    "fr": [
      "Entre Rocamadour et les monts du Cantal, le musée de l'Accordéon et des instruments de musique populaire vous accueille à Siran. Les frères Cazes ont constitué au fil de leur vie une collection exceptionnelle d'accordéons, vielles et cabrettes."
    ],
    "nl": [
      "Tussen Rocamadour en de Monts du Cantal heet het Accordeon en Instrumentenmuseum voor Volksmuziek je welkom in Siran. In de loop van hun leven hebben de broers Cazes een uitzonderlijke collectie accordeons, draailieren en cabrettes opgebouwd."
    ],
    "es": [
      "Entre Rocamadour y el Cantal, el Museo del Acordeón y de los Instrumentos de Música Popular le da la bienvenida a Siran. A lo largo de su vida, los hermanos Cazes reunieron una excepcional colección de acordeones, zanfonas y cabretes."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Maison des Frères Cazes - Accordion Museum"
    ],
    "fr": [
      "La Maison des Frères Cazes - Musée de l'Accordéon"
    ],
    "nl": [
      "La Maison des Frères Cazes - Accordeon Museum"
    ]
  },
