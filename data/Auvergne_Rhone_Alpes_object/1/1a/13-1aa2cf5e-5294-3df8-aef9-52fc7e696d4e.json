  "rdfs:comment": {
    "de": [
      "Das Atelier SuperSansPlomb ist eine kleine handwerkliche Druckerei, die die traditionelle Drucktechnik mit beweglichen Lettern anwendet. Sie ist hauptsächlich auf die Verwendung von Holzschriften ausgerichtet und bietet gebundene Poster, Karten und Notizbücher an."
    ],
    "en": [
      "L'Atelier SuperSansPlomb is a small artisanal print shop that uses the traditional movable type printing technique. It focuses mainly on the use of wooden type, and produces posters, cards and bound notebooks."
    ],
    "it": [
      "L'Atelier SuperSansPlomb è una piccola tipografia artigianale che utilizza la tradizionale tecnica di stampa a caratteri mobili. Si concentra principalmente sull'uso di caratteri in legno e produce poster, biglietti e quaderni rilegati."
    ],
    "fr": [
      "L’Atelier SuperSansPlomb est une petite imprimerie artisanale qui utilise la technique d'impression traditionnelle à caractères mobiles. Il est principalement tourné vers l'utilisation de caractères en bois, propose des affiches, cartes et carnets reliés."
    ],
    "nl": [
      "L'Atelier SuperSansPlomb is een kleine ambachtelijke drukkerij die gebruik maakt van de traditionele druktechniek met losse letters. Het richt zich voornamelijk op het gebruik van houten letters en produceert posters, kaarten en gebonden notitieboekjes."
    ],
    "es": [
      "L'Atelier SuperSansPlomb es una pequeña imprenta artesanal que utiliza la técnica tradicional de impresión con tipos móviles. Se centra principalmente en el uso de tipos de madera, y produce carteles, tarjetas y cuadernos encuadernados."
    ]
  },
