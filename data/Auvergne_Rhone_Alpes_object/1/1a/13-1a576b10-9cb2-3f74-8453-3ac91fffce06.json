  "rdfs:comment": {
    "de": [
      "Der Golfclub Machilly liegt vor den Toren von Annemasse und Genf in einer idyllischen Umgebung gegenüber dem See von Machilly. Er ist der ideale Ort, um diesen Sport zu entdecken und ihn unter optimalen Bedingungen auszuüben."
    ],
    "en": [
      "Located on the outskirts of Annemasse and Geneva, in an idyllic setting overlooking Lake Machilly, the Machilly Golf Club is the ideal place to discover this sport and practice it in optimal conditions."
    ],
    "it": [
      "Situato alle porte di Annemasse e Ginevra, in un ambiente idilliaco di fronte al lago di Machilly, il Machilly Golf Club è il luogo ideale per scoprire questo sport e praticarlo in condizioni ottimali."
    ],
    "fr": [
      "Situé aux portes d'Annemasse et de Genève,dans un cadre idyllique face au lac de Machilly, Le golf club de Machilly est le lieu idéal pour découvrir ce sport et le pratiquer dans des conditions optimales."
    ],
    "es": [
      "Situado en las afueras de Annemasse y Ginebra, en un entorno idílico frente al lago de Machilly, el Club de Golf de Machilly es el lugar ideal para descubrir este deporte y practicarlo en condiciones óptimas."
    ],
    "nl": [
      "Gelegen aan de rand van Annemasse en Genève, in een idyllische omgeving tegenover het meer van Machilly, is de Machilly Golf Club de ideale plek om deze sport te ontdekken en te beoefenen in optimale omstandigheden."
    ]
  },
  "rdfs:label": {
