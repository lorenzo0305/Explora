          "additionalInformation": {
            "de": [
              "Die Höhle ist dienstags im September, montags und dienstags Anfang Oktober geschlossen, während der Allerheiligenferien täglich geöffnet"
            ],
            "en": [
              "The cave is closed on Tuesdays in September, Mondays and Tuesdays at the beginning of October, and is open every day during the All Saints' vacation"
            ],
            "it": [
              "La grotta è chiusa il martedì a settembre e il lunedì e martedì all'inizio di ottobre, mentre è aperta tutti i giorni durante le festività di Ognissanti"
            ],
            "fr": [
              "La grotte est fermée le mardi en septembre, lundi et mardi début octobre, ouvert tous les jours pendant les vacances de la Toussaint"
            ],
            "es": [
              "La cueva permanece cerrada los martes de septiembre y los lunes y martes de principios de octubre, pero está abierta todos los días durante la festividad de Todos los Santos"
            ],
            "nl": [
              "De grot is gesloten op dinsdag in september en op maandag en dinsdag begin oktober. Tijdens de feestdagen van Allerheiligen is de grot elke dag geopend"
            ]
          },
