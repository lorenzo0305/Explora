  "rdfs:comment": {
    "de": [
      "Die Ecole du Ski Français bietet Ihnen die Möglichkeit, den Gleitsport für Groß und Klein zu erlernen. Ob Gruppen- oder Einzelunterricht: Es gibt für jeden das passende Angebot."
    ],
    "en": [
      "The French Ski School offers you the opportunity to learn snow sports for young and old. Whether in group or individual lessons: there are formulas adapted for everyone."
    ],
    "it": [
      "La Scuola di sci francese vi offre l'opportunità di imparare gli sport sulla neve per grandi e piccini. Che si tratti di lezioni di gruppo o individuali, esistono formule adatte a tutti."
    ],
    "fr": [
      "L'Ecole du Ski Français vous propose l'apprentissage des sports de glisse pour petits et grands. Que ce soit en cours collectifs ou individuels: des formules adaptées pour tous."
    ],
    "es": [
      "La Escuela de Esquí Francesa le ofrece la oportunidad de aprender deportes de nieve para jóvenes y mayores. Tanto en las clases en grupo como en las individuales, hay fórmulas adaptadas para todos."
    ],
    "nl": [
      "De Franse skischool biedt u de mogelijkheid om sneeuwsporten te leren voor jong en oud. Of het nu gaat om groepslessen of individuele lessen, er zijn voor iedereen aangepaste formules."
    ]
  },
