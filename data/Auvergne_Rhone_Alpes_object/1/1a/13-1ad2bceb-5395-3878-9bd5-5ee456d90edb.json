  "rdfs:comment": {
    "de": [
      "Megan Oldhues hat uns die Ehre erwiesen, die ganze Palette ihres Talents im Viertel Châteauvert auf zwei Wänden des Mjc Chateauvert in Valence zu enthüllen."
    ],
    "en": [
      "Megan Oldhues did us the honor of showing us the full range of her talent in the Châteauvert district, on two walls of the Mjc Chateauvert in Valence."
    ],
    "it": [
      "Megan Oldhues ci ha fatto l'onore di mostrarci tutta la gamma del suo talento nel distretto di Châteauvert, su due pareti del Mjc Chateauvert a Valence."
    ],
    "fr": [
      "Megan Oldhues nous a fait l'honneur de dévoiler toute la palette de son talent dans le quartier de Châteauvert, sur deux murs de la Mjc Chateauvert à Valence."
    ],
    "es": [
      "Megan Oldhues nos hizo el honor de mostrarnos toda la gama de su talento en el barrio de Châteauvert, en dos paredes del Mjc Chateauvert de Valence."
    ],
    "nl": [
      "Megan Oldhues gaf ons de eer om het volledige bereik van haar talent te laten zien in de wijk Châteauvert, op twee muren van het Mjc Chateauvert in Valence."
    ]
  },
  "rdfs:label": {
    "fr": [
