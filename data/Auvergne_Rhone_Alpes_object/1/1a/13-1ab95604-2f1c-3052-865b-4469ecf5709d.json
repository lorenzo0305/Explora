  "rdfs:comment": {
    "de": [
      "Das Restaurant 1451 befindet sich im Zentrum des Dorfes Renaison. Das Restaurant empfängt Sie in einem neuen Ambiente und bietet Ihnen eine Gourmetküche."
    ],
    "en": [
      "The restaurant 1451 is located in the center of the village of Renaison. The restaurant welcomes you in a new atmosphere and proposes you a gastronomic cooking."
    ],
    "it": [
      "Il ristorante 1451 si trova nel centro del villaggio di Renaison. Il ristorante vi accoglie in un'atmosfera nuova e vi offre una cucina gastronomica."
    ],
    "fr": [
      "Le restaurant 1451 est situé au centre du village de Renaison. Le restaurant vous accueille dans une nouvelle ambiance et vous propose une cuisine gastronomique."
    ],
    "nl": [
      "Restaurant 1451 ligt in het centrum van het dorp Renaison. Het restaurant verwelkomt u in een nieuwe sfeer en biedt u een gastronomische keuken."
    ],
    "es": [
      "El restaurante 1451 está situado en el centro del pueblo de Renaison. El restaurante le da la bienvenida en un ambiente nuevo y le ofrece una cocina gastronómica."
