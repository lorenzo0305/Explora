  "rdfs:comment": {
    "de": [
      "8 Computer, Drucker und 1 Scanner. 2 Personen/Mikrofon, öffentlich zugänglicher Touchscreen.  Möglichkeit, das Zentrum für einen halben oder ganzen Tag zu mieten (mit oder ohne die Dienste des Animators); Reservierung beim Animator."
    ],
    "en": [
      "8 computers, printers and 1 scanner. 2 people/microphone, touch screen accessible to the public.  Possibility of renting the center by the half-day or the full day (with or without the services of the activity leader); reservation with the activity leader."
    ],
    "it": [
      "8 computer, stampanti e 1 scanner. 2 persone/microfoni, touch screen accessibile al pubblico.  Possibilità di affittare il centro per mezza giornata o per una giornata (con o senza i servizi dell'animatore); prenotazione presso l'animatore."
    ],
    "fr": [
      "8 ordinateurs,  imprimantes et 1 scanner. 2 pers/ micro, écran tactile accessible au public.  Possibilité de louer le centre à la demie journée ou à la journée (avec ou sans les services de l'animateur) ; réservation auprès de l'animateur."
    ],
    "es": [
      "8 ordenadores, impresoras y 1 escáner. 2 personas/micrófonos, pantalla táctil accesible al público.  Posibilidad de alquilar el centro por medio día o un día (con o sin los servicios del facilitador); reserva con el facilitador."
    ],
    "nl": [
      "8 computers, printers en 1 scanner. 2 personen/microfoon, aanraakscherm toegankelijk voor het publiek.  Het centrum kan worden gehuurd voor een halve of een hele dag (met of zonder de diensten van de activiteitenbegeleider); reserveringen kunnen worden gemaakt bij de activiteitenbegeleider."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre multimédia"
    ]
  },
