  "rdfs:comment": {
    "de": [
      "Im Herzen des Gebiets Combrailles Auvergne, gegenüber der Puys-Kette, befindet sich das buddhistische Zentrum Dhagpo Kundreul Ling und sein großer Tempel mit bemerkenswerter Architektur. Kostenlose Tempelführungen oder kostenpflichtige Führungen."
    ],
    "en": [
      "In the heart of the Combrailles Auvergne territory, in front of the volcanoes, you can discover the Dhagpo Kundreul Ling Buddhist center and its Main Temple with remarkable architecture. Free temple tours or paid guided tours."
    ],
    "it": [
      "Nel cuore della regione Combrailles Auvergne, di fronte alla Chaîne des Puys, si trova il centro buddista Dhagpo Kundreul Ling e il suo Grande Tempio, dall'architettura straordinaria. Visite gratuite al tempio o visite guidate a pagamento."
    ],
    "fr": [
      "Au cœur du territoire Combrailles Auvergne, face à la chaîne des Puys, se trouve le centre bouddhiste Dhagpo Kundreul Ling et son Grand Temple à l’architecture remarquable. Visites du temple gratuites libres ou visites guidées payantes."
    ],
    "nl": [
      "In het hart van de regio Combrailles Auvergne, tegenover de Chaîne des Puys, ligt het boeddhistische centrum Dhagpo Kundreul Ling en zijn Grote Tempel, met zijn opmerkelijke architectuur. Gratis rondleidingen door de tempel of rondleidingen tegen betaling."
    ],
    "es": [
      "En el corazón de la región de Combrailles Auvergne, frente a la Chaîne des Puys, se encuentra el centro budista Dhagpo Kundreul Ling y su Gran Templo, de notable arquitectura. Visitas gratuitas del templo o visitas guiadas de pago."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Temple Bouddhiste"
    ]
  },
