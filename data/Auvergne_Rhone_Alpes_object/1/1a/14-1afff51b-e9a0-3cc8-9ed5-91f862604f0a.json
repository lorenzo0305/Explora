  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4a1d2b70-2239-3d79-a30e-dda52e61b717",
      "dc:description": {
        "de": [
          "Auf dem Programm stehen:\nIntuitive Massage, craniale Modellierung, Kinesiologie, Fußentspannung,\nmagnetismus, Energiebilanz, Sonotherapie, energetische Reinigung,\nhandpflege, tibetische Klangschalen, Feldenkrais, Kunsttherapie, Entspannungsbereich, Snacks\nStände mit Produkten zum Verkauf :\n\" fairy stone \" Schmuck und Armbänder\n\" les trouvailles de Justine \" Duftkerzen"
        ],
        "en": [
          "Program:\nIntuitive massage, cranial modelling, kinesiology, podal relaxation,\nmagnetism, energy assessment, sonotherapy, energy cleansing,\nhand care, Tibetan bowls, Feldenkrais, art therapy, relaxation area, snacks\nProduct stalls for sale:\n\"fairy stone\" jewelry and bracelets\n\"les trouvailles de Justine\" scented candles"
        ],
        "it": [
          "In programma:\nMassaggio intuitivo, modellazione craniale, kinesiologia, rilassamento dei piedi,\nmagnetismo, valutazione energetica, sonoterapia, pulizia energetica,\ntrattamenti manuali, ciotole tibetane, Feldenkrais, arteterapia, area relax, rinfresco\nBancarelle di prodotti in vendita:\n\"gioielli e braccialetti \"pietra fatata\n\"candele profumate \"les trouvailles de Justine"
        ],
        "fr": [
          "Au programme :\nMassage intuitif, modelage crânien, kinésiologie, relaxation podale,\nmagnetisme, bilan énergétique, sonothérapie, nettoyage énergétique,\nsoins des mains, bols tibétains, feldenkrais, arthérapie, espace détente, collation\nStands de produits en vente :\n« fairy stone » bijoux et bracelets\n« les trouvailles de Justine » bougies parfumées"
        ],
        "nl": [
          "Op het programma:\nIntuïtieve massage, craniale modellering, kinesiologie, voetontspanning,\nmagnetisme, energiebeoordeling, sonotherapie, energiereiniging,\nhandbehandelingen, Tibetaanse schalen, Feldenkrais, kunstzinnige therapie, ontspanningsruimte, versnaperingen\nVerkoopkraampjes met producten:\n\"feeënsteen\" sieraden en armbanden\n\"geurkaarsen \"les trouvailles de Justine"
        ],
        "es": [
          "En el programa:\nMasaje intuitivo, modelado craneal, kinesiología, relajación podal,\nmagnetismo, evaluación energética, sonoterapia, limpieza energética,\ntratamientos manuales, cuencos tibetanos, Feldenkrais, arteterapia, zona de relajación, refrescos\nPuestos de venta de productos:\n\"joyas y pulseras \"piedra de hadas\n\"velas perfumadas \"les trouvailles de Justine"
        ]
      },
