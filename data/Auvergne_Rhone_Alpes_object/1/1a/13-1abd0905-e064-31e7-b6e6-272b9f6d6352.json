  "rdfs:comment": {
    "de": [
      "Der Standort des Staudamms von Thurins ist ein von Anglern viel besuchter Ort. Nun können Familien, Angler und Wanderer diese Einrichtungen, die sich in einer außergewöhnlichen Umgebung befinden, nutzen!"
    ],
    "en": [
      "The Thurins dam site is a popular spot for anglers. Now families, anglers and hikers can enjoy these facilities in an exceptional environment!"
    ],
    "it": [
      "Il sito della diga di Thurins è un luogo molto amato dai pescatori. Ora le famiglie, i pescatori e gli escursionisti possono godere di queste strutture in un ambiente eccezionale!"
    ],
    "fr": [
      "Le site du barrage de Thurins est un lieu très fréquenté par les pêcheurs. Désormais les familles, les pécheurs et les randonneurs peuvent profiter de ces aménagements situés dans un environnement exceptionnel !"
    ],
    "es": [
      "El embalse de Thurins es un lugar muy popular entre los pescadores. Ahora, familias, pescadores y senderistas pueden disfrutar de estas instalaciones en un entorno excepcional"
    ],
    "nl": [
      "De Thurins dam is een populaire plek voor vissers. Nu kunnen gezinnen, vissers en wandelaars genieten van deze faciliteiten in een uitzonderlijke omgeving!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plan d'eau du barrage de Thurins"
    ]
  },
