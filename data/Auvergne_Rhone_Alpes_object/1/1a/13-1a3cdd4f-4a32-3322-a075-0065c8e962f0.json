  "rdfs:comment": {
    "de": [
      "Nehmen Sie den kuppelbaren Sessellift von Bisanne und erreichen Sie den 1941 m hohen Gipfel des Mont Bisanne! Ein idealer Zugangspunkt für Fußgänger, Mountainbiker und Gleitschirmflieger (einziger Startplatz ab Les Saisies)."
    ],
    "en": [
      "Take the Bisanne detachable chairlift up to the 1941 m summit of Mont Bisanne! A prime access point for walkers, mountain bikers, and paragliders (exclusive launch site from Les Saisies)."
    ],
    "it": [
      "Prendi la seggiovia ad agganciamento automatico di Bisanne e raggiungi la vetta del Mont Bisanne a 1941 m di altitudine! Un accesso privilegiato per pedoni, appassionati di MTB e parapendisti (punto di decollo esclusivo da Les Saisies)."
    ],
    "fr": [
      "Empruntez le télésiège débrayable de Bisanne et atteignez les 1943 m d’altitude du Mont Bisanne ! Un accès privilégié pour les piétons, les amateurs de VTT et les parapentistes (départ unique depuis Les Saisies)."
    ],
    "es": [
      "Tome el telesilla desembragable Bisanne y alcance los 1943 m de altitud del Monte Bisanne Es ideal para peatones, ciclistas de montaña y parapentistas (una salida desde Les Saisies)."
    ],
    "nl": [
      "Neem de afkoppelbare stoeltjeslift van Bisanne en bereik de top van de Mont Bisanne op 1941 meter hoogte! Een bevoorrechte toegang voor wandelaars, mountainbikers en paragliders (exclusief vertrekpunt vanaf Les Saisies)."
    ]
  },
