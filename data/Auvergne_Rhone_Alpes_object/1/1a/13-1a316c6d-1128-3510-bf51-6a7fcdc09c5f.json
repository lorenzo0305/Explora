  "rdfs:comment": {
    "de": [
      "Das °Fahrenheit Seven Val Thorens setzt auf die Vintage-Karte der 70er Jahre und bietet Lebensräume, die der Geselligkeit und dem Skifahren gewidmet sind, immer am Fuße der Pisten!"
    ],
    "en": [
      "4-star relaxation and unconventional excellence – at Fahrenheit Seven Val Thorens, we play the card of 70’s vintage to offer living spaces dedicated to conviviality and skiing, always at the foot of the slopes!"
    ],
    "it": [
      "Relax a 4 stelle ed eccellenza non convenzionale: al Fahrenheit Seven Val Thorens, giochiamo la carta degli anni '70 per offrire spazi abitativi dedicati alla convivialità e allo sci, sempre ai piedi delle piste!"
    ],
    "fr": [
      "Décontraction 4 étoiles et excellence anticonformiste, au °Fahrenheit Seven Val Thorens on joue la carte du vintage 70’s pour offrir des espaces de vie dédiés à la convivialité et au ski, toujours au pied des pistes !"
    ],
    "nl": [
      "Viersterrenontspanning en onconventionele uitmuntendheid: bij Fahrenheit Seven Val Thorens spelen we de kaart van de jaren 70 om woonruimtes te bieden die in het teken staan van gezelligheid en skiën, altijd aan de voet van de pistes!"
    ],
    "es": [
      "Relajación 4 estrellas y excelencia no convencional: en Fahrenheit Seven Val Thorens, jugamos la carta de los 70 para ofrecer espacios de vida dedicados a la convivencia y al esquí, ¡siempre a pie de pistas!"
    ]
  },
