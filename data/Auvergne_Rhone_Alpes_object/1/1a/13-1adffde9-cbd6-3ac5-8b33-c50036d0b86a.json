  "rdfs:comment": {
    "de": [
      "Feinschmeckerküche mit französischer Tradition. Das in Seynod gelegene beliebte Restaurant La Cantine Bouillon bietet eine Gourmetkarte und eine gemütliche Atmosphäre. Seine schöne Terrasse ist ideal, um das schöne Wetter zu genießen und dabei eine einfache Küche zu probieren."
    ],
    "en": [
      "Traditional French gourmet cuisine. Located in Seynod, the popular restaurant La Cantine Bouillon offers a gourmet menu and a friendly atmosphere. Its beautiful terrace is ideal for enjoying the fine weather and simple cuisine."
    ],
    "it": [
      "Cucina gourmet tradizionale francese. Situato a Seynod, il famoso ristorante La Cantine Bouillon offre un menu gourmet e un'atmosfera accogliente. La sua bella terrazza è ideale per godersi il bel tempo assaporando una cucina semplice."
    ],
    "fr": [
      "Cuisine gourmande de tradition française. Situé à Seynod, le restaurant populaire La Cantine Bouillon propose une carte gourmande et une ambiance conviviale. Sa belle terrasse est idéale pour profiter du beau temps tout en dégustant une cuisine simple."
    ],
    "nl": [
      "Traditionele Franse gastronomische keuken. Het populaire restaurant La Cantine Bouillon ligt in Seynod en biedt een gastronomisch menu en een gezellige sfeer. Het mooie terras is ideaal om van het mooie weer te genieten terwijl je geniet van eenvoudige gerechten."
    ],
    "es": [
      "Cocina gastronómica tradicional francesa. Situado en Seynod, el popular restaurante La Cantine Bouillon ofrece un menú gourmet y un ambiente agradable. Su bonita terraza es ideal para disfrutar del buen tiempo mientras se saborea una cocina sencilla."
    ]
  },
