  "rdfs:comment": {
    "de": [
      "Als Pionier seiner Art ist das MMI ein Zentrum für Wissensvermittlung, das sich über einen lebendigen, spielerischen und fächerübergreifenden Ansatz den mathematischen und informatischen Wissenschaften widmet."
    ],
    "en": [
      "A pioneer of its kind, the MMI is a knowledge mediation centre dedicated to mathematical and computer sciences through a lively, playful and multidisciplinary approach."
    ],
    "it": [
      "Pioniere nel suo genere, l'MMI è un centro di mediazione della conoscenza dedicato alle scienze matematiche e informatiche attraverso un approccio vivace, divertente e multidisciplinare."
    ],
    "fr": [
      "Pionnière du genre, la MMI est un centre de médiation des savoirs dédié aux sciences mathématiques et informatiques via une approche vivante, ludique et pluridisciplinaire."
    ],
    "es": [
      "Pionero en su género, el MMI es un centro de mediación del conocimiento dedicado a las ciencias matemáticas e informáticas mediante un enfoque vivo, divertido y multidisciplinar."
    ],
    "nl": [
      "Het MMI, een pionier in zijn soort, is een kennisbemiddelingscentrum voor wis- en computerwetenschappen met een levendige, ludieke en multidisciplinaire aanpak."
    ]
  },
  "rdfs:label": {
    "fr": [
