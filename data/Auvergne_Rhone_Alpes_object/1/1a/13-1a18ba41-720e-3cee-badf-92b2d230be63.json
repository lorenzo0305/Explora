  "rdfs:comment": {
    "de": [
      "Gemütliches Hotel Gasthaus mit Halbpension-Touren zu Fuss, Mountainbiken oder Schneeschuhen. Ideale Lage am Dorfeingang, zwei Schritte entfernt vom Freizeitbereich (Schwimmbad, Eisbahn, Bowling, Casino) und vom Busbahnhof."
    ],
    "en": [
      "Hotel Auberge is friendly and offers bed and breakfast or half-board stays. Ideal location at the entrance of the village, close to the Leisure Centre (swimming pool, ice rink, bowling alley, casino), and the bus station."
    ],
    "it": [
      "Hotel accogliente che offre pernottamenti con prima colazione o mezza pensione. Posizione ideale all'ingresso del villaggio, a due passi dall'Espace Loisirs (piscina, pista di pattinaggio, bowling, casinò) e dalla stazione degli autobus."
    ],
    "fr": [
      "Hôtel convivial proposant des séjours en nuitée et petit-déjeuner ou en demi-pension. Situation idéale à l'entrée du village, à deux pas de l'Espace Loisirs (piscine, patinoire, bowling, casino), et de la gare routière."
    ],
    "nl": [
      "Vriendelijk hotel met overnachtingen met ontbijt of halfpension. Ideale locatie bij de ingang van het dorp, op een steenworp afstand van de Espace Loisirs (zwembad, ijsbaan, bowlingbaan, casino) en het busstation."
    ],
    "es": [
      "Hotel acogedor que ofrece alojamiento con desayuno o media pensión. Situación ideal a la entrada del pueblo, a dos pasos del Espace Loisirs (piscina, pista de hielo, bolera, casino) y de la estación de autobuses."
    ]
  },
