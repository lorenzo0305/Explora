  "rdfs:comment": {
    "de": [
      "Rotkehlchen ist sehr einsam und braucht Hilfe, um Gesellschaft zu finden!\r\nDiese Märchenführung wurde für das jüngste Publikum konzipiert und regt Kinder dazu an, nach Vögeln zu suchen, die in vielen Werken des Museums zu sehen sind."
    ],
    "en": [
      "Rouge-gorge is feeling very lonely, and needs help to find some company!\r\nDesigned for younger visitors, this storytelling tour encourages children to look for the birds in many of the museum's works."
    ],
    "it": [
      "Rouge-gorge si sente molto solo, quindi dobbiamo aiutarlo a trovare compagnia!\r\nPensato per i visitatori più giovani, questo tour narrativo incoraggia i bambini a cercare gli uccelli in molte opere del museo."
    ],
    "fr": [
      "Rouge-gorge se sent très seul, il faut l’aider à trouver de la compagnie !\r\nConçue pour le plus jeune public, cette visite contée incite les enfants à chercher les oiseaux présents dans de nombreuses œuvres du musée."
    ],
    "nl": [
      "Rouge-gorge voelt zich erg eenzaam, dus we moeten hem helpen gezelschap te vinden!\r\nDeze verhalentocht is bedoeld voor jongere bezoekers en moedigt kinderen aan om op zoek te gaan naar de vogels in veel werken van het museum."
    ],
    "es": [
      "Rouge-gorge se siente muy solo, ¡así que tenemos que ayudarle a encontrar compañía!\r\nDiseñado para los visitantes más jóvenes, este recorrido narrativo anima a los niños a buscar los pájaros en muchas de las obras del museo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite contée « mais où sont les oiseaux »  - Les mercredis en famille"
    ]
  },
