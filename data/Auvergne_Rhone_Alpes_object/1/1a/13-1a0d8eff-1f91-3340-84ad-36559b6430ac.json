  "rdfs:comment": {
    "de": [
      "Weingut im südlichen Teil des Weinanbaugebiets. Herstellung von Weiß-, Rot- und Roséweinen sowie weißem und roséfarbenem Schaumwein. Geführte Besichtigung des Weinkellers und Weinprobe."
    ],
    "en": [
      "Estate located in the southern part of the vineyard. Production of white, red and rosé wines and sparkling white and rosé wines. Guided tour of the winery and wine tasting."
    ],
    "it": [
      "Tenuta situata nella parte meridionale del vigneto. Produzione di vini bianchi, rossi e rosati e di spumanti bianchi e rosati. Visita guidata della cantina e degustazione di vini."
    ],
    "fr": [
      "Domaine situé dans la partie méridionale du vignoble. Production de vins blancs, rouges et rosés et vins mousseux blancs et rosés. Visite guidée du chai et dégustation."
    ],
    "nl": [
      "Landgoed gelegen in het zuidelijke deel van de wijngaard. Productie van witte, rode en rosé wijnen en mousserende witte en rosé wijnen. Rondleiding door de wijnmakerij en wijnproeverij."
    ],
    "es": [
      "Finca situada en la parte sur del viñedo. Producción de vinos blancos, tintos y rosados y de vinos espumosos blancos y rosados. Visita guiada a la bodega y degustación de vinos."
    ]
  },
