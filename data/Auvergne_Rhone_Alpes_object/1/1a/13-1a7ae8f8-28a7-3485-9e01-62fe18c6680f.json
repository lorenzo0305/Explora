  "rdfs:comment": {
    "de": [
      "Der Parc du Miroir am Ufer des Genfer Sees ist ein schöner Ort, um spazieren zu gehen und den See zu genießen. Im Sommer wird der nahe gelegene Stadtstrand Groß und Klein begeistern."
    ],
    "en": [
      "The Parc du Miroir on the shores of Lake Geneva is a pleasant place to walk and enjoy the lake. During the summer, the municipal beach will delight young and old."
    ],
    "it": [
      "Il Parc du Miroir, sulle rive del Lago di Ginevra, è un luogo piacevole per passeggiare e godersi il lago. In estate, la vicina spiaggia comunale farà la gioia di grandi e piccini."
    ],
    "fr": [
      "Le parc du Miroir situé au bord du lac Léman, est un lieu agréable pour se promener et profiter du lac. En été, la plage municipale située à proximité comblera petits et grands."
    ],
    "nl": [
      "Het Parc du Miroir aan de oevers van het Meer van Genève is een aangename plek om te wandelen en te genieten van het meer. In de zomer is het nabijgelegen gemeentestrand een genot voor jong en oud."
    ],
    "es": [
      "El Parc du Miroir, a orillas del lago Lemán, es un lugar agradable para pasear y disfrutar del lago. En verano, la cercana playa municipal hará las delicias de grandes y pequeños."
    ]
  },
  "rdfs:label": {
    "en": [
      "Miroir Park"
    ],
    "fr": [
      "Le parc du Miroir"
    ],
    "nl": [
      "Bloemenpark"
    ]
  },
