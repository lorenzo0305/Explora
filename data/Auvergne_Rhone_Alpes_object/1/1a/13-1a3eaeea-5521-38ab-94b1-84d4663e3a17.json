  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant (hausgemachte, biologische, lokale, pflanzliche und saisonale Küche), unseren Bierkeller (handwerklich hergestellte, lokale und im weiteren Sinne franko-belgische Biere) und nehmen Sie an unseren punktuellen Veranstaltungen teil (40 m² großer Raum neben dem Restaurant)."
    ],
    "en": [
      "Enjoy our restaurant (home-cooked, organic, local, plant-based and seasonal cuisine), our beer cellar (craft beers, local beers and more broadly Franco-Belgian beers), and take part in our occasional events (40 m² room adjoining the restaurant)."
    ],
    "it": [
      "Scoprite il nostro ristorante (cucina casalinga, biologica, locale, vegetale e stagionale), la nostra birreria (birre artigianali, locali e, più in generale, franco-belghe) e partecipate ai nostri eventi speciali (sala di 40 m² adiacente al ristorante)."
    ],
    "fr": [
      "Découvrez notre restaurant (cuisine maison, bio, locale, végétale et de saison), notre cave à bières (bières artisanales, locales et plus largement franco-belges), et participez à nos événements ponctuels (salle de 40 m² annexe au restaurant)."
    ],
    "nl": [
      "Ontdek ons restaurant (huisgemaakte, biologische, lokale, plantaardige en seizoensgebonden keuken), onze bierkelder (ambachtelijke, lokale en meer algemeen Frans-Belgische bieren) en neem deel aan onze speciale evenementen (ruimte van 40 m² naast het restaurant)."
    ],
    "es": [
      "Descubra nuestro restaurante (cocina casera, ecológica, local, vegetal y de temporada), nuestra cervecería (cervezas artesanales, locales y, más ampliamente, francobelgas) y participe en nuestros eventos especiales (sala de 40 m² contigua al restaurante)."
    ]
  },
