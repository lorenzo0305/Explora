  "rdfs:comment": {
    "de": [
      "Das Paris Vichy bietet Ihnen eine traditionelle französische Bistroküche, die auf kurzen Wegen und nach den Jahreszeiten zubereitet wird.\r\nKleine Lebensmittelecke, in der einige lokale Produkte hervorgehoben werden."
    ],
    "en": [
      "Le Paris Vichy offers traditional French bistronomic cuisine, with a short circuit and following the seasons.\r\nA small grocery corner featuring local products."
    ],
    "it": [
      "Le Paris Vichy offre una cucina tradizionale da bistrot francese, utilizzando percorsi brevi e seguendo le stagioni.\r\nUn piccolo angolo di alimentari offre una selezione di prodotti locali."
    ],
    "fr": [
      "Le Paris Vichy vous propose une cuisine bistronomique française traditionnelle, avec un circuit court et en suivant les saisons. \r\nPetit coin épicerie mettant en avant certains produits locaux."
    ],
    "es": [
      "Le Paris Vichy ofrece cocina tradicional francesa de bistró, con rutas cortas y siguiendo las estaciones.\r\nUna pequeña tienda de comestibles ofrece una selección de productos locales."
    ],
    "nl": [
      "Le Paris Vichy biedt een traditionele Franse bistrokeuken, gebruikmakend van korte routes en de seizoenen volgend.\r\nEen kleine kruideniershoek biedt een selectie lokale producten."
    ]
  },
