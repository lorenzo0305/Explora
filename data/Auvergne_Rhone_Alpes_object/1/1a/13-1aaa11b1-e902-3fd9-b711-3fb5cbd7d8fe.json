  "rdfs:comment": {
    "de": [
      "Étienne, ein Bergführer, bietet Ihnen ungewöhnliche Schneeschuhwanderungen an: Nachtwanderung im Schein der Stirnlampen mit Fondue-Essen im Iglu!"
    ],
    "en": [
      "Étienne, a mountain guide, offers unusual snowshoe excursions: night walks by headlamp, with fondue meals in igloos!"
    ],
    "it": [
      "Étienne, una guida alpina, vi propone delle uscite insolite con le racchette da neve: un'escursione notturna alla lampada frontale, con un pasto a base di fonduta in un igloo!"
    ],
    "fr": [
      "Étienne, accompagnateur en montagne, vous propose des sorties en raquettes insolites : marche de nuit à la lueur des frontales, avec repas fondue en igloo !"
    ],
    "es": [
      "Étienne, guía de montaña, le propone salidas insólitas con raquetas de nieve: una caminata nocturna con linternas frontales, ¡con comida a base de fondue en un iglú!"
    ],
    "nl": [
      "Étienne, een berggids, biedt je ongewone sneeuwschoenuitstapjes: een nachtwandeling met hoofdlamp, met een fonduemaaltijd in een iglo!"
    ]
  },
  "rdfs:label": {
