  "rdfs:comment": {
    "de": [
      "Von der Alpe d'Arrondaz aus wird der Weg sehr schnell schmal und technisch. Die Aussicht auf die Almen von Thabor ist einfach herrlich."
    ],
    "en": [
      "From the Arrondaz mountain pasture, the path quickly becomes narrow and technical. The view of the Thabor mountain pastures is simply magnificent."
    ],
    "it": [
      "Dalla malga Arrondaz, il sentiero diventa rapidamente stretto e tecnico. La vista sugli alpeggi del Thabor è semplicemente magnifica."
    ],
    "fr": [
      "Au départ de l’alpage d’Arrondaz le sentier devient très vite étroit et technique. La vue sur les alpages du Thabor est tout simplement magnifique."
    ],
    "nl": [
      "Vanaf de alm van Arrondaz wordt het pad al snel smal en technisch. Het uitzicht op de Thabor alpenweiden is gewoonweg prachtig."
    ],
    "es": [
      "A partir de los pastos de montaña de Arrondaz, el camino se vuelve rápidamente estrecho y técnico. La vista de los pastos de montaña de Thabor es sencillamente magnífica."
    ]
  },
  "rdfs:label": {
