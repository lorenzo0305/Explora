  "rdfs:comment": {
    "de": [
      "Im Herzen des charmanten Dorfes Montanges haben Romain und Chloé beschlossen, ihre Liebe zu einer einfachen, marktfrischen Küche mit frischen, lokalen und saisonalen Produkten mit ihren Gästen zu teilen."
    ],
    "en": [
      "In the heart of the charming village of Montanges, Romain and Chloé have decided to share with their customers their love of simple, market-driven cuisine, always based on fresh, local, seasonal produce."
    ],
    "it": [
      "È nel cuore dell'incantevole villaggio di Montanges che Romain e Chloé hanno deciso di condividere con i loro clienti il loro amore per una cucina semplice e di mercato, sempre basata su prodotti freschi, locali e di stagione."
    ],
    "fr": [
      "C’est au cœur du charmant village de Montanges que Romain et Chloé ont décidé de faire partager à leur clientèle leur amour pour la cuisine simple, de marché et toujours autour de produits frais, locaux et de saison."
    ],
    "nl": [
      "Het is in het hart van het charmante dorpje Montanges dat Romain en Chloé besloten hebben hun liefde voor een eenvoudige, marktgerichte keuken, altijd gebaseerd op verse, lokale en seizoensgebonden producten, met hun klanten te delen."
    ],
    "es": [
      "Es en el corazón del encantador pueblo de Montanges donde Romain y Chloé han decidido compartir con sus clientes su amor por la cocina sencilla y de mercado, siempre basada en productos frescos, locales y de temporada."
    ]
  },
  "rdfs:label": {
