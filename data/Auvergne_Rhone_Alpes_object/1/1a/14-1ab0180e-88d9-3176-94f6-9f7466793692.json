  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7e656096-e10c-3a82-a3c0-eaecc3e260b9",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck und Sandwiches - siehe auf der Facebook-Seite\n\nTage der Öffnung:\n\nMontag bis Freitag: 6.30 - 19.30 Uhr\nSamstag: 6:30 - 18:00 Uhr.\n\nSonntag geschlossen\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nTelefonische Bestellung möglich unter 03 21 71 50 80\n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries and sandwiches - see on facebook page\n\nOpening days:\n\nMonday to Friday: 6.30am - 7.30pm\nSaturday: 6.30am - 6pm.\n\nClosed on Sunday\n \n Pick-up:\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by telephone on 03 21 71 50 80\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria e panini - vedi la pagina facebook\n\nGiorni di apertura:\n\nDa lunedì a venerdì: dalle 6.30 alle 19.30\nSabato: dalle 6.30 alle 18.00.\n\nChiuso la domenica\n \n Ritiro:\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate telefonicamente al numero 03 21 71 50 80\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, viennoisseries et sandwichs - voir sur la page facebook\n\nJours d'ouverture:\n\nDu lundi au vendredi : 6h30 - 19h30\nLe samedi :  6h30 - 18h.\n\nFermeture le dimanche\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au 03 21 71 50 80\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak en broodjes - zie de facebookpagina\n\nOpeningsdagen:\n\nMaandag t/m vrijdag: 6.30 - 19.30 uur\nZaterdag: 6.30 - 18.00 uur.\n\nZondag gesloten\n \n Ophalen:\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nBestellingen kunnen telefonisch worden doorgegeven op 03 21 71 50 80\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y bocadillos - ver en la página de facebook\n\nDías de apertura:\n\nDe lunes a viernes: de 6.30 a 19.30 h\nSábado: de 6.30 a 18.00 h.\n\nDomingos cerrado\n \n Recogida:\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nSe pueden hacer pedidos por teléfono llamando al 03 21 71 50 80\n\n "
        ]
      },
