  "rdfs:comment": {
    "de": [
      "Der Geschichtsverein empfängt Sie das ganze Jahr über jeden Samstagvormittag von 10:00 bis 12:00 Uhr zur Besichtigung seiner Ausstellungen: Craponne-Spitze, Tradition des Velay, Archäologie, antike Wege."
    ],
    "en": [
      "The Historical Society welcomes you every Saturday morning, all year round, from 10am to 12pm, to visit its exhibitions on Craponne lace, Velay traditions, archaeology and ancient roads."
    ],
    "it": [
      "La Società Storica vi accoglie ogni sabato mattina, tutto l'anno, dalle 10 alle 12, per visitare le sue mostre sul merletto di Craponne, sulle tradizioni del Velay, sull'archeologia e sulle antiche strade."
    ],
    "fr": [
      "La Société d'Histoire vous accueille tous les samedis matins, toute l'année, de 10h à 12h, pour la visite de ses expositions : dentelle de Craponne, tradition du Velay, archéologie, voies antiques."
    ],
    "es": [
      "La Sociedad Histórica le da la bienvenida todos los sábados por la mañana, durante todo el año, de 10:00 a 12:00, para visitar sus exposiciones sobre el encaje de Craponne, las tradiciones de Velay, la arqueología y los caminos antiguos."
    ],
    "nl": [
      "De Historische Vereniging verwelkomt u elke zaterdagochtend, het hele jaar door van 10.00 tot 12.00 uur, voor een bezoek aan de tentoonstellingen over het kantwerk van Craponne, de tradities van Velay, archeologie en oude wegen."
    ]
  },
  "rdfs:label": {
