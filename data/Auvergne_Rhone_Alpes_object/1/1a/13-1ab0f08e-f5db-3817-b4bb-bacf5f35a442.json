  "rdfs:comment": {
    "de": [
      "Der Wertstoffhof ist für die selektive Entsorgung von Abfällen von Privatpersonen aus dem Val d'Eygues in begrenztem Umfang für Abfälle von Gewerbetreibenden (Handwerker, Händler, KMU, KMI) und öffentlichen Einrichtungen konzipiert."
    ],
    "en": [
      "The waste collection center is designed for the selective disposal of waste from private individuals in the Val d'Eygues, with a limited amount of waste from professionals (craftsmen, shopkeepers, SMEs, SMIs) and public establishments."
    ],
    "it": [
      "Il centro di raccolta dei rifiuti è progettato per il deposito selettivo dei rifiuti dei privati della Val d'Eygues in proporzioni limitate, nonché dei rifiuti dei professionisti (artigiani, commercianti, PMI, SMI) e delle istituzioni pubbliche."
    ],
    "fr": [
      "La déchèterie est conçue pour le dépôt sélectifs des déchets des particuliers du Val d'Eygues dans des proportions limitées les déchets des professionnels (artisans, commerçants PME, PMI) et des établissements publics."
    ],
    "nl": [
      "Het afvalverzamelcentrum is ontworpen voor de selectieve verwijdering van afval van particulieren in de Val d'Eygues, met een beperkte hoeveelheid afval van professionals (ambachtslieden, winkeliers, KMO's, KMI's) en openbare instellingen."
    ],
    "es": [
      "El centro de recogida de residuos está destinado al depósito selectivo de los residuos de los particulares del Val d'Eygues, con proporciones limitadas para los residuos de los profesionales (artesanos, comerciantes, PYME, SMI) y de las instituciones públicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Déchèterie intercommunale"
    ]
  },
