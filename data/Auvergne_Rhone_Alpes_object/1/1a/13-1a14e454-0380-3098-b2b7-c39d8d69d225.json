  "rdfs:comment": {
    "de": [
      "Das Café Voltaire befindet sich in einer halbwegs fußgängerfreundlichen Straße im Herzen von Ferney-Voltaire. Bei schönem Wetter können Sie Ihr Getränk auf der Terrasse schlürfen."
    ],
    "en": [
      "The Café Voltaire is located in the semi-pedestrian street in the heart of Ferney-Voltaire. In good weather you can sip your drink on the terrace."
    ],
    "it": [
      "Il Café Voltaire si trova nella via semipedonale nel cuore di Ferney-Voltaire. Con il bel tempo, potrete gustare il vostro drink sulla terrazza."
    ],
    "fr": [
      "Le café Voltaire est situé dans la rue semi-piétonne au cœur de Ferney-Voltaire. Par beau temps, vous pouvez siroter votre boisson sur la terrasse."
    ],
    "es": [
      "El café Voltaire está situado en la calle semi-peatonal en el corazón de Ferney-Voltaire. Con buen tiempo, podrá saborear su bebida en la terraza."
    ],
    "nl": [
      "Café Voltaire ligt in de semi-voetgangersstraat in het hart van Ferney-Voltaire. Bij mooi weer kunt u van uw drankje nippen op het terras."
    ]
  },
