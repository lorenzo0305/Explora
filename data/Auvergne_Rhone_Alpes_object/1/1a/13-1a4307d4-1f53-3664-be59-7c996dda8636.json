  "rdfs:comment": {
    "de": [
      "Für Anfänger und erfahrene Bergsteiger, Bonneval Alpin Center, Yannik Anselmet, führt Sie in Bonneval sur Arc, Haute Maurienne Vanoise, in das Hochgebirge ein und leitet Sie auf den gesamten Alpenbogen und alle fernen Gipfel."
    ],
    "en": [
      "For beginners and experienced mountaineers alike, Bonneval Alpin Center, Yannik Anselmet, introduces and guides you to the high mountains of Bonneval sur Arc, Haute Maurienne Vanoise, the entire Alpine arc and all the distant peaks."
    ],
    "it": [
      "Per i principianti e gli alpinisti esperti, il Centro Alpino di Bonneval, Yannik Anselmet, vi introduce e vi guida sulle alte montagne di Bonneval sur Arc, dell'Alta Maurienne Vanoise, dell'intero arco alpino e di tutte le cime più lontane."
    ],
    "fr": [
      "Pour les débutants et les alpinistes confirmés, Bonneval Alpin Center,  Yannik Anselmet, vous initie et vous guide à la haute montagne à Bonneval sur Arc, en Haute Maurienne Vanoise, sur tout l'arc alpin et tous les sommets lointains."
    ],
    "nl": [
      "Yannik Anselmet, Alpin Center Bonneval, introduceert en begeleidt zowel beginners als ervaren bergbeklimmers in het hooggebergte van Bonneval sur Arc, Haute Maurienne Vanoise, de hele Alpenboog en alle verre toppen."
    ],
    "es": [
      "Tanto para principiantes como para montañeros experimentados, el Centro Alpino de Bonneval, Yannik Anselmet, le introduce y le guía en las altas montañas de Bonneval sur Arc, Haute Maurienne Vanoise, todo el arco alpino y todas las cumbres lejanas."
    ]
  },
