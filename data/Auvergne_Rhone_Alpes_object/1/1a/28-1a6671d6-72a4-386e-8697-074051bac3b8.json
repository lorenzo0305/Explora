  "rdfs:comment": {
    "de": [
      "Ein neues, freundliches und professionelles Team erwartet Sie. Auf Ihrem Teller finden Sie eine Schiefertafel mit lokalen Produkten, die das ganze Jahr über Frische, Saison und Vielfalt garantieren."
    ],
    "en": [
      "A new welcoming and professional team is waiting for you. You will find in your plate a work to the slate with local products guaranteeing freshness, season and variety throughout the year."
    ],
    "it": [
      "Un nuovo team accogliente e professionale vi aspetta. Troverete nel vostro piatto un lavoro all'ardesia con prodotti locali che garantiscono freschezza, stagionalità e varietà durante tutto l'anno."
    ],
    "fr": [
      "C’est une nouvelle équipe accueillante et professionnelle qui vous attend. Vous trouverez dans votre assiette un travail à l’ardoise avec des produits locaux garantissant fraîcheur, saison et variété tout au long de l’année."
    ],
    "es": [
      "Un nuevo equipo acogedor y profesional le espera. Encontrará en su plato un trabajo a la pizarra con productos locales que garantizan frescura, temporada y variedad durante todo el año."
    ],
    "nl": [
      "Een nieuw gastvrij en professioneel team staat voor u klaar. U vindt in uw bord een werk aan de lei met lokale producten die het hele jaar door versheid, seizoen en variatie garanderen."
    ]
  },
  "rdfs:label": {
    "fr": [
