  "rdfs:comment": {
    "de": [
      "Die Auberge d'Ayze - Chez l'Anaïs ist ein hübsches Gasthaus, das sich in die Berge inmitten der Weinberge von Ayze schmiegt. Probieren Sie die je nach Jahreszeit wechselnden Bistrogerichte, aber auch die emblematischen savoyischen Gerichte."
    ],
    "en": [
      "L'Auberge d'Ayze - Chez l'Anaïs is a pretty inn nestled in the hollow of the mountain in the middle of the Ayze vineyard. Come and taste the bistronomic dishes which vary according to the seasons, but also the emblematic Savoyard dishes."
    ],
    "it": [
      "L'Auberge d'Ayze - Chez l'Anaïs è una graziosa locanda immersa nella conca della montagna, nel mezzo del vigneto di Ayze. Venite a gustare i piatti bistronomici che variano a seconda della stagione, ma anche i piatti emblematici della Savoia."
    ],
    "fr": [
      "L'Auberge d'Ayze - Chez l'Anaïs est une jolie auberge nichée au creux de la montagne au milieu du vignoble d'Ayze. Venez déguster les plats bistronomiques qui varient au fil des saisons mais aussi les emblématiques plats savoyards."
    ],
    "nl": [
      "L'Auberge d'Ayze - Chez l'Anaïs is een mooie herberg genesteld in de holte van de berg midden in de wijngaard van Ayze. Kom en proef de bistronomische gerechten die variëren naargelang het seizoen, maar ook de emblematische Savoyaardse gerechten."
    ],
    "es": [
      "L'Auberge d'Ayze - Chez l'Anaïs es una bonita posada enclavada en la hondonada de la montaña en medio del viñedo de Ayze. Venga a degustar los platos bistronómicos que varían según la temporada, pero también los platos emblemáticos de Saboya."
    ]
  },
