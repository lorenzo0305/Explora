  "rdfs:comment": {
    "de": [
      "Das Panorama bietet einen Blick von Les Ecrins bis zum Matterhorn, mit dem Mont Blanc und den Dômes de la Vanoise im Vordergrund. Genießen Sie die Typizität der Mont Jovet-Hütte, eine der ersten Hütten, die 1890 eingeweiht wurde: eine fast unberührte Holzkonstruktion."
    ],
    "en": [
      "The panorama offers a view of the  Ecrins as well as the Cervin, with the Mont Blanc and the Vanoise domes in the foreground. Enjoy the autentic characteristic of the Mont Jovet hut, one of the first refuge inaugurated in 1890: a wooden construction almost untouched."
    ],
    "it": [
      "Il panorama offre una vista dagli Ecrins al Cervino, con il Monte Bianco e i Dômes de la Vanoise in primo piano. Godetevi il tipico rifugio Mont Jovet, uno dei primi rifugi inaugurati nel 1890: una struttura in legno praticamente intatta."
    ],
    "fr": [
      "Le panorama offre une vue des Ecrins au Cervin, avec au premier plan le Mont Blanc et les Dômes de la Vanoise. Appréciez la typicité du refuge du Mont Jovet, un des premiers refuges inauguré en 1890 : une construction en bois pratiquement intouchée."
    ],
    "nl": [
      "Het panorama biedt uitzichten van de Ecrins tot de Matterhorn, met op de voorgrond de Mont Blanc en de Dômes de la Vanoise. Geniet van de typische berghut Mont Jovet, een van de eerste berghutten die in 1890 werd geopend: een vrijwel onaangetaste houten structuur."
    ],
    "es": [
      "El panorama ofrece vistas desde los Ecrins hasta el Cervino, con el Mont Blanc y los Dômes de la Vanoise en primer plano. Disfrute del típico refugio del Mont Jovet, uno de los primeros refugios inaugurados en 1890: una estructura de madera prácticamente intacta."
    ]
  },
  "rdfs:label": {
