  "rdfs:comment": {
    "de": [
      "Alexandre ist Bergführer und bietet Ihnen Entdeckungsspaziergänge und Sportwanderungen für alle Leistungsniveaus im Winter und Sommer an. Alexandre ist auch professioneller Pianist und bietet Ihnen Ausflüge zwischen Musik und Bergen an: die Rando'Piano"
    ],
    "en": [
      "As a mountain guide, Alexandre offers discovery walks and challenging hikes for all levels of ability, in both winter and summer. Also a professional pianist, Alexandre offers outings combining music and mountains: the Rando'Piano."
    ],
    "it": [
      "Guida alpina, Alexandre propone passeggiate di scoperta ed escursioni sportive per tutti i livelli di abilità, in inverno e in estate. Alexandre è anche un pianista professionista e propone una serie di escursioni che combinano musica e montagna: il Rando'Piano"
    ],
    "fr": [
      "Accompagnateur en montagne, Alexandre vous propose des balades découvertes et randonnées sportives pour tous niveaux de pratique, hiver & été. Également pianiste professionnel, Alexandre vous propose des sorties entre musique et montagne : les Rando'Piano"
    ],
    "es": [
      "Guía de montaña, Alexandre propone paseos de descubrimiento y excursiones deportivas para todos los niveles, en invierno y en verano. Alexandre es también pianista profesional y propone una serie de salidas que combinan música y montaña: el Rando'Piano"
    ],
    "nl": [
      "Als berggids biedt Alexandre ontdekkingstochten en sportieve wandelingen voor alle niveaus, winter en zomer. Alexandre is ook een professionele pianist en biedt een reeks uitstapjes aan waarbij muziek en de bergen worden gecombineerd: de Rando'Piano"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Oreille du Lynx, accompagnateur en montagne"
    ]
  },
