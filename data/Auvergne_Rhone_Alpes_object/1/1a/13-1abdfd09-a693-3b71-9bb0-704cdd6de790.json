  "rdfs:comment": {
    "de": [
      "Täglich um 15 Uhr in der Saison (außer montags und während des Festivals Ende August): Auf Anfrage geführte Besichtigung der Abteikirche durch die Gemeinschaft der Johanniterbrüder mit Reservierung unter 09 81 40 41 21."
    ],
    "en": [
      "Every day at 3pm during the season (except Mondays and during the festival at the end of August): guided tour of the abbey church on request by the Brothers of St. John community, by calling 09 81 40 41 21."
    ],
    "it": [
      "Tutti i giorni alle 15:00 durante l'alta stagione (tranne il lunedì e durante la festa di fine agosto): visita guidata della chiesa abbaziale su richiesta della comunità dei frati di San Giovanni, telefonando al numero 09 81 40 41 21."
    ],
    "fr": [
      "Tous les jours à 15h en saison (sauf lundi et pendant le festival fin août) : visite guidée sur demande de l'église abbatiale par la communauté des frères de St Jean sur réservation au 09 81 40 41 21."
    ],
    "es": [
      "Todos los días a las 15:00 h en temporada (excepto los lunes y durante las fiestas de finales de agosto): visita guiada de la iglesia abacial a petición de la comunidad de los hermanos de San Juan, previa reserva llamando al 09 81 40 41 21."
    ],
    "nl": [
      "Elke dag om 15.00 uur in het seizoen (behalve op maandag en tijdens het festival eind augustus): rondleiding door de abdijkerk op verzoek door de communiteit van de broeders van Sint Jan, te reserveren via 09 81 40 41 21."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée spirituelle de l'abbatiale"
    ]
  },
