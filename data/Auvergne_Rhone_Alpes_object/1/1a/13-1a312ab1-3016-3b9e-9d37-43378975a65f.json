  "rdfs:comment": {
    "de": [
      "Weinkeller, Weinverkauf, kostenlose Weinprobe. Das ganze Jahr über geöffnet. \r\nAOC Côtes du Vivarais, Landwein der Coteaux de l'Ardèche.\r\nBoutique mit Produkten aus der Region. \r\nEmpfang von Wohnmobilen (Entleerung, Trinkwasser) und Möglichkeit, über Nacht zu parken."
    ],
    "en": [
      "Open all year,  wine celar. Free tasting. AOC Côtes du Vivarais red, pink, white, Vin de pays des Ardèche , red, rosé, white (syrah, merlot, viognier). Sale of local spirits and  local products.\r\nPlace for  camping Car."
    ],
    "it": [
      "Cantina, vendita di vini, degustazione gratuita. Aperto tutto l'anno\r\nAOC Côtes du Vivarais, Vin de pays des coteaux de l'Ardèche.\r\nFate la spesa con prodotti locali\r\nAccoglienza camper (svuotamento, acqua potabile) possibilità di sosta notturna."
    ],
    "fr": [
      "Caveau, vente de vin, dégustation gratuite. Ouvert à l'année \r\nAOC Côtes du Vivarais, Vin de pays des coteaux de l'Ardèche.\r\nBoutique produits du terroir. \r\nAccueil Camping-Car ( vidange, eau potable ) possibilité de stationner la nuit."
    ],
    "nl": [
      "Hele jaar geopend. Wijnkelder. verkoop van wijn. gratis proeven. Geen verzendkosten. Rode, witte en rosé wijn AOC Côtes du Vivarais. Ook verkoop van sterke drank. We ontvangen ook camping- cars."
    ],
    "es": [
      "Bodega, venta de vinos, degustación gratuita. Abierto todo el año\r\nAOC Côtes du Vivarais, Vin de pays des coteaux de l'Ardèche.\r\nCompre con productos locales\r\nRecepción de autocaravanas (vaciado, agua potable) posibilidad de aparcar durante la noche."
    ]
  },
