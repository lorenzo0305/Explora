  "rdfs:comment": {
    "de": [
      "GEEK & POP CULTURE Convention, der POP CINEVERSE kehrt ins Kino GRAND ECRAN VICHY zurück!\r\nDas Kino wird für ein Wochenende zum Videospieltempel rund um den französischen Kinostart von Super Mario 2."
    ],
    "en": [
      "GEEK & POP CULTURE convention, the POP CINEVERSE returns to the GRAND ECRAN VICHY cinema!\r\nFor a weekend, the cinema becomes the temple of video games, to coincide with the French release of Super Mario 2."
    ],
    "it": [
      "Convegno GEEK & POP CULTURE, il POP CINEVERSE torna al cinema GRAND ECRAN VICHY!\r\nPer un fine settimana, il cinema si trasformerà nel tempio dei videogiochi, in concomitanza con l'uscita francese di Super Mario 2."
    ],
    "fr": [
      "Convention GEEK & POP CULTURE, le POP CINEVERSE revient au cinéma GRAND ECRAN VICHY !\r\nLe cinéma devient le temps d'un week-end le temple du jeu vidéo autour de la sortie en France de Super Mario 2."
    ],
    "nl": [
      "GEEK & POP CULTUUR conventie, de POP CINEVERSE keert terug naar de GRAND ECRAN VICHY bioscoop!\r\nEen weekend lang wordt de bioscoop de tempel van de videogames, naar aanleiding van de Franse release van Super Mario 2."
    ],
    "es": [
      "GEEK & POP CULTURE, el POP CINEVERSE vuelve al cine GRAND ECRAN VICHY\r\nDurante un fin de semana, el cine se convertirá en el templo de los videojuegos, coincidiendo con el estreno en Francia de Super Mario 2."
    ]
  },
  "rdfs:label": {
