  "rdfs:comment": {
    "de": [
      "Coquerie ist ein gemütliches Restaurant, das eine Brasserie-Küche mit Inspirationen aus anderen Ländern anbietet. Ein Ort der Abwechslung, 100% hausgemachte Küche, lokale Produkte."
    ],
    "en": [
      "Coquerie is a friendly restaurant serving brasserie-style cuisine inspired by other parts of the world. A place with a change of scenery, 100% home cooking and local produce."
    ],
    "it": [
      "La Coquerie è un ristorante accogliente che serve una cucina in stile brasserie ispirata ad altre parti del mondo. Un luogo che offre un cambiamento di scenario, una cucina casalinga al 100% e prodotti locali."
    ],
    "fr": [
      "Coquerie est un restaurant convivial qui produit une cuisine brasserie aux inspirations d'ailleurs. Lieu dépaysant , cuisine 100% maison, produits locaux."
    ],
    "nl": [
      "Coquerie is een gezellig restaurant waar gerechten in brasseriestijl worden geserveerd, geïnspireerd door andere delen van de wereld. Een plek met een andere omgeving, 100% huisgemaakte keuken en lokale producten."
    ],
    "es": [
      "Coquerie es un restaurante acogedor que sirve cocina de brasserie inspirada en otras partes del mundo. Un lugar con cambio de aires, cocina 100% casera y productos locales."
    ]
  },
