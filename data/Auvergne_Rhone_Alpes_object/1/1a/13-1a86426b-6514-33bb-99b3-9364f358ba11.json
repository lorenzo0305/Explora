  "rdfs:comment": {
    "de": [
      "Unser Weinkeller befindet sich an einem außergewöhnlichen Ort im Herzen der Beaujolais-Crus und bereitet Ihnen den besten Empfang, damit ein Aufenthalt in Fleurie zu einem authentischen Vergnügen wird."
    ],
    "en": [
      "Located in an exceptional location at the heart of the Beaujolais wine growing area, our wine cellar personnel will give you their warmest welcome to make sure your stay in Fleurie is a real pleasure."
    ],
    "it": [
      "Situata in un sito eccezionale nel cuore dei crus del Beaujolais, la nostra cantina vi offre la migliore accoglienza affinché una sosta a Fleurie diventi un autentico piacere."
    ],
    "fr": [
      "Située dans un site exceptionnel au coeur des crus du Beaujolais, notre cave vous réserve le meilleur accueil afin qu'une étape à Fleurie devienne un plaisir authentique."
    ],
    "es": [
      "Situada en un lugar excepcional en el corazón de los crus del Beaujolais, nuestra bodega le ofrece la mejor acogida para que una escala en Fleurie se convierta en un auténtico placer."
    ],
    "nl": [
      "Gelegen op een uitzonderlijke locatie in het hart van de Beaujolais crus, biedt onze kelder u de beste ontvangst zodat een stop in Fleurie een authentiek plezier wordt."
    ]
  },
  "rdfs:label": {
    "en": [
      "The wine cellar in Fleurie"
    ],
    "fr": [
      "Cave de Fleurie"
    ]
  },
