    "de": [
      "Gehen Sie auf Entdeckungsreise durch den Wald von Marcenat und wandern Sie auf den langen Wegen unter den uralten Eichen."
    ],
    "en": [
      "Discover the Marcenat forest, walking its long trails under centuries-old oaks."
    ],
