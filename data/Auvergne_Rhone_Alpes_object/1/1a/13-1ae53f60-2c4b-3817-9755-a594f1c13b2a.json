  "rdfs:comment": {
    "de": [
      "Parkplätze für Reisebusse stehen gegenüber dem Wasserpark im Zentrum von Nyons zur Verfügung.\nÖffentliche Toiletten befinden sich in der Nähe."
    ],
    "en": [
      "Coach parking is available opposite the Parc Aquatique in the center of Nyons.\nPublic WC nearby."
    ],
    "it": [
      "I parcheggi per i pullman sono disponibili di fronte al Parc Aquatique, nel centro di Nyons\nNelle vicinanze sono disponibili servizi igienici pubblici."
    ],
    "fr": [
      "Des places de parking pour autocars sont disponibles en face du Parc Aquatique en plein centre de Nyons. \nPrésence de WC publics à proximité."
    ],
