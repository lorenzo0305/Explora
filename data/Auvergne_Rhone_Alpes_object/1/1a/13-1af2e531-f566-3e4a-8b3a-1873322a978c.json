  "rdfs:comment": {
    "de": [
      "Pierre lädt die Kinder in seine Tischlerwerkstatt ein: Sie lernen zu bohren, mit einer Säge einer Linie zu folgen und eine Holzfigur herzustellen."
    ],
    "en": [
      "Pierre invites the children to his carpentry workshop: they will learn to drill, to follow a line with a saw, to make a wooden figurine."
    ],
    "it": [
      "Pierre invita i bambini nel suo laboratorio di falegnameria: impareranno a forare, a seguire una linea con la sega, a realizzare una statuetta di legno."
    ],
    "fr": [
      "Pierre invite les enfants dans son atelier de menuiserie : ils apprendront à percer, à suivre un trait avec une scie, à fabriquer une figurine en bois."
    ],
    "nl": [
      "Pierre nodigt kinderen uit in zijn houtwerkplaats om te leren gaten boren, een lijn te volgen met een zaag en een houten beeldje te maken."
    ],
    "es": [
      "Pierre invita a los niños a su taller de carpintería: aprenderán a taladrar, a seguir una línea con una sierra, a hacer una figurita de madera."
    ]
  },
