        "de": [
          "Getränke, Darts, Poker, Spiele, Quiz, Fußballübertragungen, Basketball, Karaoke, Tanzabende.\n\nÖffnungszeiten:\ndienstag: 18:00 - 01:00\nmittwoch: 18:00 - 01:00\ndonnerstag: 18:00 - 01:00\nfreitag: 18:00 - 02:00\nsamstag: 18:00 - 02:00\nsonntag:18:00 - 01:00"
        ],
        "en": [
          "Drinks, darts, poker, games, quizzes, soccer broadcasts, basketball, karaoke, dance parties.\n\nOpening hours:\ntuesday: 18:00 - 01:00\nwednesday: 18:00 - 01:00\nthursday: 18:00 - 01:00\nfriday: 18:00 - 02:00\nsaturday: 18:00 - 02:00\nsunday:18:00 - 01:00"
        ],
        "it": [
          "Bevande, freccette, poker, giochi, quiz, trasmissioni di calcio, basket, karaoke, serate danzanti.\n\nOrari di apertura :\nmartedì: 18:00 - 01:00\nmercoledì: 18:00 - 01:00\ngiovedì: 18:00 - 01:00\nvenerdì: 18:00 - 02:00\nsabato: 18:00 - 02:00\ndomenica :18:00 - 01:00"
        ],
        "fr": [
          "Boissons, fléchettes, poker, jeux, quizz, diffusion du foot, basket, karaoké, soirées dansantes.\n\nHoraires d'ouvertures : \nmardi : 18:00 - 01:00\nmercredi : 18:00 - 01:00\njeudi : 18:00 - 01:00\nvendredi : 18:00 - 02:00\nsamedi : 18:00 - 02:00\ndimanche :18:00 - 01:00"
        ],
        "nl": [
          "Drankjes, darts, poker, spelletjes, quizzen, voetbaluitzendingen, basketbal, karaoke, dansavonden.\n\nOpeningstijden :\ndinsdag: 18:00 - 01:00\nwoensdag: 18:00 - 01:00\ndonderdag: 18:00 - 01:00\nvrijdag: 18:00 - 02:00\nzaterdag: 18:00 - 02:00\nzondag: 18:00 - 01:00"
        ],
        "es": [
          "Bebidas, dardos, póquer, juegos, concursos, retransmisiones de fútbol, baloncesto, karaoke, veladas de baile.\n\nHorario de apertura :\nmartes: 18:00 - 01:00\nmiércoles: 18:00 - 01:00\njueves: 18:00 - 01:00\nviernes: 18:00 - 02:00\nsábado: 18:00 - 02:00\ndomingo: 18:00 - 01:00"
