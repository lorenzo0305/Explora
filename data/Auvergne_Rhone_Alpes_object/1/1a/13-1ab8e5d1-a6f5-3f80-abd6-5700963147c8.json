  "rdfs:comment": {
    "de": [
      "Das Restaurant ist für alle geöffnet und bietet eine saisonale Speisekarte und Formeln aus frischen Produkten. An schönen Tagen können Sie auf der schattigen Terrasse mit Blick auf die Bergkette von Belledonne essen."
    ],
    "en": [
      "Our restaurant is opened to all guests. It proposes a menu “à la carte” as well as different set menus with fresh and seasonal products. Private garden facing the Belledonne moutain."
    ],
    "it": [
      "Il ristorante è aperto a tutti e offre un menu e formule stagionali a base di prodotti freschi. Quando il tempo è bello, potete gustare un pasto sulla terrazza ombreggiata che si affaccia sulla catena montuosa di Belledonne."
    ],
    "fr": [
      "Le restaurant est ouvert à tous et propose une carte et des formules de saison à base de produits frais. Dès les beaux jours, c’est sur la terrasse ombragée que vous pouvez profiter d’un repas face à la chaîne de Belledonne."
    ],
    "nl": [
      "Het restaurant is voor iedereen toegankelijk en biedt een menu en seizoensgebonden formules op basis van verse producten. Bij mooi weer kunt u genieten van een maaltijd op het schaduwrijke terras met uitzicht op het Belledonne-gebergte."
    ],
    "es": [
      "El restaurante está abierto a todos y ofrece un menú de temporada a base de productos frescos. Cuando hace buen tiempo, se puede comer en la terraza a la sombra con vistas a la cadena montañosa de Belledonne."
    ]
  },
