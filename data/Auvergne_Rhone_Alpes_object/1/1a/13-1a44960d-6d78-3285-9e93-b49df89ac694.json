  "rdfs:comment": {
    "de": [
      "Fremdenverkehrsbüro von Val d'Arly, Büro von Crest Voland Cohennoz.\r\nEmpfang der Öffentlichkeit, Informationen, Reservierungen, Verkauf, Ticketing, verschiedene Dienstleistungen ...\r\nBesuchen Sie uns doch einfach!"
    ],
    "en": [
      "Val d'Arly Tourist Office, Crest Voland Cohennoz office.\r\nReception of the public, information, reservations, sales, ticketing, various services ...\r\nFeel free to visit us !"
    ],
    "it": [
      "Ufficio del turismo della Val d'Arly, ufficio Crest Voland Cohennoz.\r\nAccoglienza del pubblico, informazioni, prenotazioni, vendita, biglietteria, servizi vari...\r\nNon esitate a venirci a trovare!"
    ],
    "fr": [
      "Office de Tourisme du Val d'Arly, bureau de Crest Voland Cohennoz.\r\nAccueil du public, renseignements, réservations, ventes, billetterie, services divers...\r\nN'hésitez pas à venir nous rendre visite !"
    ],
    "nl": [
      "Toeristische dienst van Val d'Arly, kantoor van Crest Voland Cohennoz.\r\nOntvangst van het publiek, informatie, reserveringen, verkoop, kaartverkoop, diverse diensten...\r\nAarzel niet om ons te komen bezoeken!"
    ],
    "es": [
      "Oficina de Turismo de Val d'Arly, oficina de Crest Voland Cohennoz.\r\nRecepción del público, información, reservas, venta, venta de entradas, servicios varios...\r\n¡No dude en venir a visitarnos!"
    ]
  },
