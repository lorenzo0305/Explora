      "@id": "https://data.datatourisme.fr/4c658bda-9fd0-37d1-b636-9f8dbdc53345",
      "dc:description": {
        "de": [
          "Picknickbereich, der sich um den Teich der Gemeinde unweit des Rathauses und des Töpfereimuseums befindet. Verschiedene Ausstattungen: 2 Picknicktische, Parkplatz und Mülleimer."
        ],
        "en": [
          "Picnic area located around the town pond not far from the town hall and the pottery museum. Various equipment: 2 picnic tables, car park and bins."
        ],
        "it": [
          "Area picnic situata intorno allo stagno locale, non lontano dal municipio e dal museo della ceramica. Varie strutture: 2 tavoli da picnic, parcheggio e cestini per i rifiuti."
        ],
        "fr": [
          "Aire de pique-nique se situant autour de l'étang de la commune non loin de la mairie et du musée de la poterie. Divers équipement : 2 tables de pique-nique, parking et poubelles."
        ],
        "es": [
          "Área de picnic situada alrededor del estanque local, no lejos del ayuntamiento y del museo de cerámica. Instalaciones varias: 2 mesas de picnic, aparcamiento y papeleras."
        ],
        "nl": [
          "Picknickplaats gelegen rond de plaatselijke vijver niet ver van het gemeentehuis en het aardewerkmuseum. Diverse voorzieningen: 2 picknicktafels, parkeerplaats en afvalbakken."
        ]
      },
