  "rdfs:comment": {
    "de": [
      "Das Rathaus von Saugues ist montags bis freitags von 8:30 bis 12:00 Uhr und von 13:30 bis 17:00 Uhr für die Öffentlichkeit geöffnet.\r\nAm Dienstag ist nur vormittags von 8:30 bis 12:00 Uhr geöffnet"
    ],
    "en": [
      "Saugues Town Hall is open to the public Monday to Friday, 8:30am to 12pm and 1:30pm to 5pm.\r\nOn Tuesdays, opening hours are mornings only, from 8:30am to 12:00pm"
    ],
    "it": [
      "Il Municipio di Saugues è aperto al pubblico dal lunedì al venerdì, dalle 8.30 alle 12.00 e dalle 13.30 alle 17.00.\r\nIl martedì è aperto solo al mattino, dalle 8.30 alle 12.00"
    ],
    "fr": [
      "La mairie de Saugues est ouverte au public du lundi au vendredi de 8h30 à 12h et de 13h30 à 17h.\r\nLe mardi ouverture uniquement le matin de 8h30 à 12h00"
    ],
    "nl": [
      "Het gemeentehuis van Saugues is voor het publiek geopend van maandag tot en met vrijdag van 8.30 tot 12.00 uur en van 13.30 tot 17.00 uur.\r\nOp dinsdag is het alleen 's ochtends geopend van 8.30 tot 12.00 uur"
    ],
    "es": [
      "El Ayuntamiento de Saugues está abierto al público de lunes a viernes, de 8.30 a 12.00 y de 13.30 a 17.00 horas.\r\nLos martes solo abre por la mañana, de 8.30 a 12.00"
    ]
  },
