  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich im alten, vollständig renovierten Bahnhof von Gex aus dem Jahr 1899. Der Chefkoch und Geschäftsführer, Frédéric Jambon, wird Ihnen hier traditionelle französische Küche in einem warmen und authentischen Rahmen anbieten."
    ],
    "en": [
      "The restaurant is located in the old train station of Gex, completely renovated.\r\nThe Chef and Owner of the restaurant, Frédéric JAMBON will propose a traditional French Cuisine Menu."
    ],
    "it": [
      "Il ristorante si trova nell'antica stazione ferroviaria di Gex, interamente ristrutturata nel 1899. Lo chef e direttore, Frédéric Jambon, vi offrirà una cucina tradizionale francese in un ambiente caldo e autentico."
    ],
    "fr": [
      "Le Restaurant est situé dans l’ancienne gare de Gex, entièrement rénovée de 1899. Le Chef et Gérant, Frédéric Jambon, vous y proposera une cuisine traditionnelle française dans un cadre chaleureux et authentique."
    ],
    "nl": [
      "Het restaurant is gevestigd in het oude treinstation van Gex, dat in 1899 volledig werd gerenoveerd. De chef en manager, Frédéric Jambon, biedt u traditionele Franse gerechten in een warm en authentiek kader."
    ],
    "es": [
      "El restaurante se encuentra en la antigua estación de tren de Gex, totalmente renovada en 1899. El chef y director, Frédéric Jambon, le ofrecerá una cocina tradicional francesa en un ambiente cálido y auténtico."
    ]
  },
