  "rdfs:comment": {
    "de": [
      "Das Weingut, das vom Vater auf den Sohn übertragen wurde, befindet sich in der Combe de Savoie, Fréterive (Savoyen, Frankreich). Das Weingut ist nach Südwesten ausgerichtet und durch den regionalen Naturpark Massif des Bauges vor den Nordwinden geschützt, wodurch es von einem außergewöhnlichen Klima profitiert"
    ],
    "en": [
      "Owned and run by winegrowers from father to son, the estate is located in the Combe de Savoie, Fréterive (Savoie, France). Facing south-west and protected from northerly winds by the Massif des Bauges Regional Nature Park, the estate enjoys an exceptional climate"
    ],
    "it": [
      "Di proprietà e gestita da viticoltori di padre in figlio, la tenuta si trova nella Combe de Savoie, a Fréterive (Savoia, Francia). Esposta a sud-ovest e protetta dai venti settentrionali dal Parco Naturale Regionale del Massiccio dei Bauges, la tenuta gode di un clima eccezionale"
    ],
    "fr": [
      "Propriétaires vignerons de père en fils, le domaine se situe dans la Combe de Savoie, Fréterive (Savoie, France). Exposé sud-ouest et protégé des vents du nord par le Parc naturel régional du Massif des Bauges, le domaine bénéficie d'un climat d'exception"
    ],
    "es": [
      "Propiedad de viticultores de padre a hijo, la finca está situada en la Combe de Savoie, Fréterive (Saboya, Francia). Orientada hacia el suroeste y protegida de los vientos del norte por el Parque Natural Regional del Macizo de Bauges, la finca goza de un clima excepcional"
    ],
    "nl": [
      "Het domein is eigendom van en wordt gerund door wijnboeren van vader op zoon, en ligt in de Combe de Savoie, Fréterive (Savoie, Frankrijk). Het domein ligt op het zuidwesten en wordt beschermd tegen de noordenwind door het regionale natuurpark Massif des Bauges, waardoor het geniet van een uitzonderlijk klimaat"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Caveau Domaine de Lorbert"
    ]
  },
