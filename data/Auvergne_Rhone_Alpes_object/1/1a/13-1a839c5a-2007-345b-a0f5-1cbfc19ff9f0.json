  "rdfs:comment": {
    "de": [
      "Erzeuger, der verarbeitet. Verkauf über das Internet.\r\nProduzent von Beeren und Kernobst aus biologischem Anbau, Herstellung und Verkauf von gefülltem Sandgebäck, Heidelbeeren, Himbeeren, Erdbeeren, Aprikosen und Kirschen aus der Ardèche.\r\nMit dem Label \"Goutez l'Ardèche\" ausgezeichnet."
    ],
    "en": [
      "Ecommerce. Sale by internet.\r\nProducer of shortcakes stuffed with raspberries and blueberries from Ardèche, chocolate Valrhôna ...\r\nOrganic products.\r\nSale of local products: shortbreads, biscuits, honey, sweets, chocolates ...\r\nOrganic products: honeys, chocolates, coffees, teas .."
    ],
    "it": [
      "Produttore-trasformatore. Vendite via Internet.\r\nProduttore di piccoli frutti e drupacee biologiche, produzione e vendita di frollini ripieni, mirtilli, lamponi, fragole, albicocche e ciliegie dell'Ardèche.\r\nEtichetta \"Goutez l'Ardèche\""
    ],
    "fr": [
      "Producteur transformateur. Vente par internet.\r\nProducteur de petits fruits et fruits à noyaux en agriculture Biologique, fabrication et vente de sablés fourrés , myrtilles, framboises, fraise, abricots et cerises d’Ardèche .\r\nLabellisé \"Goutez l'Ardèche\""
    ],
    "es": [
      "Productor-transformador. Venta por Internet.\r\nProductor de frutas pequeñas y frutas de hueso ecológicas, producción y venta de galletas rellenas, arándanos, frambuesas, fresas, albaricoques y cerezas de Ardèche.\r\nEtiquetado \"Goutez l'Ardèche\""
    ],
    "nl": [
      "Producent-verwerker. Verkoop via internet.\r\nProducent van klein biologisch fruit en steenvruchten, productie en verkoop van gevuld zandkoek, bosbessen, frambozen, aardbeien, abrikozen en kersen uit de Ardèche.\r\nLabel \"Goutez l'Ardèche\"."
    ]
  },
