  "rdfs:comment": {
    "de": [
      "Der Rand des vulkanischen Plateaus von Devès wird durch das tiefe Tal des Allier unterbrochen. Der Blick öffnet sich auf das Hochplateau der Margeride ohne vulkanische Bauten."
    ],
    "en": [
      "The edge of the Devès volcanic plateau is interrupted by the deep Allier valley. The panorama opens out onto the high Margeride plateau, devoid of volcanic edifices."
    ],
    "it": [
      "Il bordo dell'altopiano vulcanico di Devès è interrotto dalla profonda valle dell'Allier. Il panorama si apre sull'altopiano della Margeride, privo di strutture vulcaniche."
    ],
    "fr": [
      "Le bord du plateau volcanique du Devès est interrompu par la profonde vallée de l'Allier. Le panorama s'ouvre vers le haut plateau de la Margeride dépourvu d'édifices volcaniques."
    ],
    "es": [
      "El borde de la meseta volcánica de Devès se ve interrumpido por el profundo valle del Allier. El panorama se abre a la meseta de Margeride, desprovista de estructuras volcánicas."
    ],
    "nl": [
      "De rand van het vulkanisch plateau van Devès wordt onderbroken door de diepe vallei van de Allier. Het panorama komt uit op het plateau van Margeride, dat geen vulkanische structuren vertoont."
    ]
  },
