  "rdfs:comment": {
    "de": [
      "Restaurant zum Mitnehmen, Traiteur, Feinkostladen. Wir bieten eine originelle und leckere Auswahl an internationalen und lokalen Geschmacksrichtungen. Um unsere Karte anzusehen, besuchen Sie uns auf instagram. Wir freuen uns darauf, Sie zu verwöhnen."
    ],
    "en": [
      "Takeaway restaurant, caterer, delicatessen. We offer an original, gourmet selection of international and local flavors. To see our menu, go to instagram. We look forward to serving you."
    ],
    "it": [
      "Ristorante da asporto, catering, gastronomia. Offriamo una selezione originale e gourmet di sapori internazionali e locali. Per vedere il nostro menu, andate su instagram. Non vediamo l'ora di servirvi."
    ],
    "fr": [
      "Restaurant à emporter, traiteur, épicerie fine. Nous proposons une sélection originale et gourmande de saveurs internationales et locales. Pour consulter notre carte rendez-vous sur instagram. Au plaisir de vous régaler."
    ],
    "es": [
      "Restaurante de comida para llevar, catering, delicatessen. Ofrecemos una selección original y gourmet de sabores internacionales y locales. Para ver nuestro menú, vaya a instagram. Estaremos encantados de atenderle."
    ],
    "nl": [
      "Afhaalrestaurant, traiteur, delicatessenzaak. Wij bieden een originele en gastronomische selectie van internationale en lokale smaken. Ga naar instagram om ons menu te bekijken. We kijken ernaar uit om u van dienst te zijn."
    ]
  },
