  "rdfs:comment": {
    "de": [
      "Marcel GRESSE, Kunsthandwerker für Laubsägearbeiten in Bourg d'Oisans, stellt einzigartige Stücke her, die alle aus Massivholz geschnitten und geschnitzt sind. Er wendet die althergebrachte Methode \"Antarsia\" an, deren Kunst es ist, einem Motiv Leben einzuhauchen."
    ],
    "en": [
      "Marcel Gresse is a fretwork craftsman based in Bourg d'Oisans who creates unique items cut and sculpted from solid wood. He uses an ancestral method called \"intarsia\", the art of which is to give life to a subject."
    ],
    "it": [
      "Marcel GRESSE è un artigiano di Bourg d'Oisans che crea pezzi unici, tutti tagliati e scolpiti in legno massiccio. Utilizza un metodo ancestrale chiamato \"Antarsia\", la cui arte consiste nel dare vita a un soggetto."
    ],
    "fr": [
      "Marcel GRESSE artisan en chantournage à Bourg d’Oisans, crée des pièces uniques toutes découpées et sculptées dans du bois massif. Il utilise une méthode ancestrale « Antarsia » dont l’art est de donner vie à un sujet."
    ],
    "nl": [
      "Marcel GRESSE is een ambachtsman in Bourg d'Oisans die unieke stukken maakt, allemaal gesneden en gebeeldhouwd uit massief hout. Hij gebruikt een voorouderlijke \"Antarsia\"-methode, waarbij het de kunst is om een onderwerp tot leven te brengen."
    ],
    "es": [
      "Marcel GRESSE es un artesano de Bourg d'Oisans que crea piezas únicas, todas cortadas y esculpidas en madera maciza. Utiliza un método ancestral llamado \"Antarsia\" cuyo arte es dar vida a un tema."
    ]
  },
  "rdfs:label": {
    "en": [
      "Formes et Passions -  Fretwork craftsman and sculptor"
    ],
    "fr": [
      "Formes et Passions - Chantourneur et sculpteur"
    ],
    "nl": [
      "Formes et Passions - Ambachtsman en beeldhouwer"
    ]
  },
