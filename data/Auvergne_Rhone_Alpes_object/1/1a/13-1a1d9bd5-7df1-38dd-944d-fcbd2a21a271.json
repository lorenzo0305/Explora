  "rdfs:comment": {
    "de": [
      "Die bald tausendjährige Petite Cité de Caractère® Montsalvy hat sich die strenge Atmosphäre dieser alten, befestigten Dörfer bewahrt, die sich aneinander schmiegen und noch von ihrem mittelalterlichen Glanz durchdrungen sind."
    ],
    "en": [
      "A medieval town founded in the 11th century by the monk Gausbert, who established a sauveté surrounded by 4 crosses, which guaranteed ecclesiastical immunity to those who took refuge there."
    ],
    "it": [
      "Montsalvy, Petite Cité de Caractère® di quasi mille anni, ha conservato l'atmosfera austera di questi antichi villaggi fortificati, rannicchiati su se stessi e ancora impregnati del loro splendore medievale."
    ],
    "fr": [
      "La Petite Cité de Caractère® bientôt millénaire de Montsalvy a conservé l'atmosphère austère de ces anciennes bourgades fortifiées, blotties sur elles-mêmes et encore imprégnées de leur éclat médiéval."
    ],
    "es": [
      "Montsalvy, Petite Cité de Caractère® casi milenaria, ha conservado el ambiente austero de estos antiguos pueblos fortificados, apiñados sobre sí mismos e impregnados aún de su esplendor medieval."
    ],
    "nl": [
      "Een middeleeuwse stad die in de 11e eeuw werd gesticht door de monnik Gausbert, die een door 4 kruisen begrensde bescherming instelde die kerkelijke immuniteit garandeerde aan degenen die er hun toevlucht zochten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Medieval village of Montsalvy, Petite Cité de Caractère®"
    ],
    "fr": [
      "Montsalvy - Petite Cité de Caractère®"
    ],
    "nl": [
      "Middeleeuwse dorp Montsalvy, Petite Cité de Caractère®"
    ]
  },
