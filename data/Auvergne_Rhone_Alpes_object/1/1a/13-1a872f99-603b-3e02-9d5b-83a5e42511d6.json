  "rdfs:comment": {
    "de": [
      "Wandgemälde in Trompe l'oeil-Technik.\r\nDieses Wandgemälde ist eine Anspielung auf die Vergangenheit und insbesondere auf die berühmte Hutmacherei Mossant, die den Ruf von Bourg de Péage begründete."
    ],
    "en": [
      "A trompe l'oeil mural.\r\nThis fresco is a nod to the past, and in particular to the famous Mossant hat factory that made Bourg de Péage's reputation."
    ],
    "it": [
      "Pittura murale in trompe l'oeil.\r\nQuesto affresco strizza l'occhio al passato e più in particolare al famoso cappellificio Mossant che ha fatto la fama di Bourg de Péage."
    ],
    "fr": [
      "Peinture murale en trompe l'oeil. \r\nCette fresque est un clin d’œil au passé et plus particulièrement à la fameuse chapellerie Mossant qui fit la réputation de Bourg de Péage."
    ],
    "es": [
      "Pintura mural en trampantojo.\r\nEste fresco es un guiño al pasado y más concretamente a la famosa fábrica de sombreros Mossant que hizo la reputación de Bourg de Péage."
    ],
    "nl": [
      "Een trompe l'oeil muurschildering.\r\nDit fresco is een knipoog naar het verleden, en meer in het bijzonder naar de beroemde hoedenfabriek Mossant die Bourg de Péage bekendheid gaf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La peinture murale Mossant"
    ]
  },
