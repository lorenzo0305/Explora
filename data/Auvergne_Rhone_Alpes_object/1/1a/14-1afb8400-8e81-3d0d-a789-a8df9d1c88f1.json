  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f89420c9-2fc8-3d77-bd58-50d525c03b9b",
      "dc:description": {
        "de": [
          "53. Wahl der Miss Côte d'Opale und Wahl des Mister France Nord-Pas-de-Calais.\n\nAb 20.30 Uhr im Palais des Congrès - Auditorium Victor Boucher\nDie Türen werden um 19.45 Uhr geöffnet.\nAb dem 1. August 2025 wird im Juweliergeschäft Éric Dupont ein Kartenverkauf eingerichtet.\n\nEinheitlicher Eintrittspreis: 25?\nGetränke vor Ort."
        ],
        "en": [
          "53rd Miss Côte d'Opale election and Mister France Nord-Pas-de-Calais election.\n\nFrom 8.30pm at the Palais des Congrès - Auditorium Victor Boucher\nDoors open at 7:45pm.\nA ticket office will be open at Bijouterie Éric Dupont from August 1, 2025.\n\nSingle ticket price: 25?\nRefreshments on site."
        ],
        "it": [
          "53a elezione di Miss Côte d'Opale e Mister France Nord-Pas-de-Calais.\n\nDalle 20.30 al Palazzo dei Congressi - Auditorium Victor Boucher\nApertura delle porte alle 19.45.\nLa biglietteria sarà aperta presso la Bijouterie Éric Dupont dal 1° agosto 2025.\n\nPrezzo del biglietto singolo: 25 euro?\nRinfresco in loco."
        ],
        "fr": [
          "53ème Election Miss Côte d'Opale et élection de Mister France Nord-Pas-de-Calais.\n\nDès 20h30 au Palais des Congrès - Auditorium Victor Boucher\nOuverture des portes à 19h45.\nUne billetterie sera ouverte à la Bijouterie Éric Dupont dès le 1er août 2025.\n\nTarif unique : 25€\nBuvette sur place."
        ],
        "nl": [
          "53e Miss Côte d'Opale en Mister France Nord-Pas-de-Calais verkiezingen.\n\nVanaf 20.30 uur in het Palais des Congrès - Auditorium Victor Boucher\nDe deuren gaan open om 19.45 uur.\nVanaf 1 augustus 2025 is er een kassa geopend in de Bijouterie Éric Dupont.\n\nPrijs enkeltje: €25?\nVersnaperingen ter plaatse."
        ],
        "es": [
          "53ª elección de Miss Côte d'Opale y Mister France Nord-Pas-de-Calais.\n\nA partir de las 20.30 h en el Palacio de Congresos - Auditorio Victor Boucher\nApertura de puertas a las 19.45 h.\nA partir del 1 de agosto de 2025 se abrirá una taquilla en la Bijouterie Éric Dupont.\n\nPrecio de la entrada única: 25?\nRefrescos in situ."
        ]
      },
