  "rdfs:comment": {
    "de": [
      "In der Bullothek kann man auf dem Teppich, in einem Pouf, einem Sessel oder auf dem Sofa bullern. Hier kann man vor einer Zeitschrift, einem Tablet oder einem Comic blasen."
    ],
    "en": [
      "At the Bullothèque, you can bubble away on a carpet, pouffe, armchair or sofa. We bubble in front of a magazine, a tablet or a comic book."
    ],
    "it": [
      "Alla Bullothèque, si può fare baldoria sul tappeto, su un poggiapiedi, una poltrona o un divano. Si può fare baldoria davanti a una rivista, a un tablet o a un fumetto."
    ],
    "fr": [
      "A la Bullothèque, on vient buller sur le tapis, dans un pouf, un fauteuil, ou le canapé. On y bulle devant un magazine, une tablette ou une bd."
    ],
    "nl": [
      "In de Bullothèque kun je wegdommelen op het tapijt, in een poef, fauteuil of bank. Je kunt wegbubbelen voor een tijdschrift, een tablet of een stripboek."
    ],
    "es": [
      "En la Bullothèque, puedes burbujear sobre la alfombra, en un escabel, un sillón o un sofá. Puedes burbujear frente a una revista, una tableta o un cómic."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque \"La Bullothèque\""
