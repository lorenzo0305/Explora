  "rdfs:comment": {
    "de": [
      "Sportliches Gebiet für gute Kletterer, das nach Osten ausgerichtet ist.\r\n44 Routen von 4 bis 7b, die bis zu 25 m Höhe erreichen.\r\nAbwechslungsreiches Klettern mit mittlerem Schwierigkeitsgrad, oft eher technisch als körperlich.\r\nDer Standort bietet ein schönes Panorama über den Trièves."
    ],
    "en": [
      "East-facing site for good climbers.\r\n44 routes from 4 to 7b, reaching heights of up to 25 metres.\r\nVaried climbing of medium difficulty, often more technical than physical.\r\nSite offers a beautiful panorama of the Trièves."
    ],
    "it": [
      "Sito sportivo per buoni arrampicatori esposto a est.\r\n44 percorsi dal 4 al 7b che raggiungono i 25 metri di altezza.\r\nArrampicata varia di media difficoltà, spesso più tecnica che fisica.\r\nSito che offre un bellissimo panorama del Trièves."
    ],
    "fr": [
      "Site sportif pour bons grimpeurs orienté Est.\r\n44 voies du 4 au 7b atteignant jusqu'à 25 mètres de hauteur.\r\nEscalade variée de difficulté moyenne souvent plus technique que physique.\r\nSite offrant un beau panorama sur le Trièves."
    ],
    "nl": [
      "Sportieve plaats voor goede klimmers op het oosten.\r\n44 routes van 4 tot 7b die tot 25 meter hoogte reiken.\r\nGevarieerd klimmen van gemiddelde moeilijkheidsgraad, vaak meer technisch dan fysiek.\r\nSite met een prachtig panorama van de Trièves."
    ],
    "es": [
      "Sitio deportivo para buenos escaladores orientado al Este.\r\n44 rutas de 4 a 7b que alcanzan hasta 25 metros de altura.\r\nEscalada variada de dificultad media a menudo más técnica que física.\r\nSitio que ofrece un hermoso panorama de las Trièves."
    ]
  },
  "rdfs:label": {
    "en": [
      "Serpaton climbing site"
    ],
    "fr": [
      "Site d’escalade du Serpaton"
    ]
  },
