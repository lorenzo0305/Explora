  "rdfs:comment": {
    "de": [
      "Als Fortsetzung der Anfang 2025 durchgeführten Großen Konzertierung organisiert Mountain Wilderness am Wochenende des 4. und 5. April 2026 eine lokale Veranstaltung im Département Haute-Savoie in Servoz (74310)."
    ],
    "en": [
      "In continuation of the Grande Concertation carried out at the beginning of 2025, Mountain Wilderness is organizing a local event in the department of Haute-Savoie at Servoz (74310) on the weekend of April 4 and 5, 2026."
    ],
    "it": [
      "Come seguito alla Grande Concertation tenutasi all'inizio del 2025, Mountain Wilderness sta organizzando un evento locale nel dipartimento dell'Alta Savoia, a Servoz (74310), il fine settimana del 4 e 5 aprile 2026."
    ],
    "fr": [
      "En continuité de la Grande Concertation réalisée début 2025, Mountain Wilderness organise un événement local dans le département de la Haute-Savoie à Servoz (74310) le week-end du 4 et 5 avril 2026."
    ],
    "es": [
      "Como continuación de la Grande Concertation celebrada a principios de 2025, Mountain Wilderness organiza un evento local en el departamento de Alta Saboya, en Servoz (74310), el fin de semana del 4 y 5 de abril de 2026."
    ],
    "nl": [
      "Als vervolg op het Grande Concertation van begin 2025 organiseert Mountain Wilderness een lokaal evenement in het departement Haute-Savoie in Servoz (74310) in het weekend van 4 en 5 april 2026."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Co-habiter en Haute-Savoie : mythe ou réalité ?"
    ]
  },
