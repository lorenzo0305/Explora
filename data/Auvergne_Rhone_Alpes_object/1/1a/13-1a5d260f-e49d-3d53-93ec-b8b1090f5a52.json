  "rdfs:comment": {
    "de": [
      "Das Chamäleon ist ein Veranstaltungssaal und ein Ort für künstlerisches Schaffen. Es ist das Werk von Rudy Ricciotti und wurde in enger Verbindung mit dem Ort und der Landschaft entworfen."
    ],
    "en": [
      "Le Caméléon is a performance venue and centre for artistic creation. Designed by Rudy Ricciotti, it was conceived to blend harmoniously with its surroundings and the landscape."
    ],
    "it": [
      "Le caméléon è un luogo di spettacolo e di creazione artistica. È opera di Rudy Ricciotti ed è stato progettato in stretta relazione con il sito e il paesaggio."
    ],
    "fr": [
      "Le caméléon est une salle de spectacle et un lieu de création artistique. Il est l’œuvre de Rudy Ricciotti et a été conçu en lien étroit avec le site et le paysage."
    ],
    "nl": [
      "Le caméléon is een plek voor optredens en artistieke creatie. Het is het werk van Rudy Ricciotti en is ontworpen in nauwe samenhang met de locatie en het landschap."
    ],
    "es": [
      "Le caméléon es un lugar de espectáculos y de creación artística. Es obra de Rudy Ricciotti y se diseñó en estrecha relación con el lugar y el paisaje."
    ]
  },
