  "rdfs:comment": {
    "de": [
      "Handwerkliche Ölmühle in der Drôme. Verkostung in der Ölbar. Direktverkauf an Privatpersonen von Olivenöl Nyons AOP und anderen AOP-Regionen, Pflanzenölen, Feinkost und Pflegeprodukten auf Olivenbasis..."
    ],
    "en": [
      "Artisanal oil mill in the Drôme. Tasting at the oil bar. Direct sales to individuals of Nyons PDO olive oils and other PDO regions, vegetable oils, delicatessen products and olive-based skincare products..."
    ],
    "it": [
      "Frantoio artigianale nella Drôme. Degustazione al bar dell'olio. Vendita diretta ai privati di oli d'oliva DOP di Nyons e di altre regioni DOP, oli vegetali, prodotti di gastronomia e prodotti per la cura della pelle a base di olive..."
    ],
    "fr": [
      "Huilerie artisanale de la Drôme. Dégustation au bar à huiles. Vente directe aux particuliers d'huiles d'olive Nyons AOP et autres régions AOP, d'huiles végétales, de produits d'épicerie fine et de produits de soin à base d'olives..."
    ],
    "nl": [
      "Ambachtelijke oliemolen in de Drôme. Proeverij in de oliebar. Directe verkoop aan particulieren van Nyons BOB olijfolie en andere BOB regio's, plantaardige oliën, delicatessen en huidverzorgingsproducten op basis van olijven..."
    ],
    "es": [
      "Almazara artesanal en la Drôme. Degustación en el bar de aceites. Venta directa a particulares de aceites de oliva DOP Nyons y de otras regiones DOP, aceites vegetales, productos delicatessen y productos para el cuidado de la piel a base de aceitunas..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique de l'Huilerie Richard"
    ]
  },
