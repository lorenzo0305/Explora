  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7bbca6b8-02aa-3302-9fc2-1f80dfdd2887",
      "dc:description": {
        "de": [
          "Die Kirche St. Fiacre et St Martin stammt aus dem 16. Jahrhundert - ganz im römischen Stil des 11. Jahrhunderts mit einem Renaissanceportal und einer Sakristei aus dem 18. Jahrhundert - Das Taufbecken ist ein historisches Monument"
        ],
        "en": [
          "The Church of St Fiacre and St Martin dates from the 16th century - all in 11th-century Roman style with a Renaissance portal and an 18th-century sacristy - The baptismal font is listed as a historic monument"
        ],
        "it": [
          "La chiesa di San Fiacre e San Martino risale al XVI secolo - tutta in stile romano dell'XI secolo con un portale rinascimentale e una sacrestia del XVIII secolo - Il fonte battesimale è classificato come monumento storico"
        ],
        "fr": [
          "L'Eglise St Fiacre et St Martin date du 16ème siècle - tout style romain XIème siècle avec un portail de la renaissance et une sacristie qui date du XVIIIème siècle - Les fonds baptismaux inscrit Monument historique"
        ],
        "es": [
          "La iglesia de San Fiacre y San Martín data del siglo XVI - todo en estilo romano del siglo XI con un portal renacentista y una sacristía del siglo XVIII - La pila bautismal está catalogada como Monumento Histórico"
        ],
        "nl": [
          "De kerk van St Fiacre en St Martin dateert uit de 16e eeuw - alles in Romeinse stijl uit de 11e eeuw met een renaissanceportaal en een sacristie uit de 18e eeuw - De doopvont staat op de monumentenlijst"
        ]
      },
      "@type": [
        "Description"
