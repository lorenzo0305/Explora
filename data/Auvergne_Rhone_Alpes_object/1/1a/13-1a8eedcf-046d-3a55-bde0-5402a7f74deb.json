  "rdfs:comment": {
    "de": [
      "Le Salagnard bietet Ihnen eine traditionelle, saisonale Küche aus lokalen Produkten sowie Pizzas (vor Ort oder zum Mitnehmen am Freitag- und Samstagabend).\r\nPunktuell werden auch Themenabende veranstaltet."
    ],
    "en": [
      "The restaurant serves traditional French cuisine and pizzas (eat in or take away). Theme evenings are organised from time to time."
    ],
    "it": [
      "Le Salagnard propone una cucina tradizionale stagionale a base di prodotti locali e pizze (sul posto o da asporto il venerdì e il sabato sera).\r\nDi tanto in tanto vengono organizzate serate a tema."
    ],
    "fr": [
      "Le Salagnard vous propose une cuisine traditionnelle de saison, à base de produits locaux, ainsi que des pizzas (sur place ou à emporter le vendredi et samedi soir). \r\nDes soirées à thèmes sont ponctuellement organisées."
    ],
    "es": [
      "Le Salagnard sirve cocina tradicional de temporada basada en productos locales, así como pizzas (en el local o para llevar los viernes y sábados por la noche).\r\nDe vez en cuando se organizan veladas temáticas."
    ],
    "nl": [
      "Le Salagnard serveert traditionele seizoensgerechten op basis van lokale producten, evenals pizza's (ter plekke of om mee te nemen op vrijdag- en zaterdagavond).\r\nVan tijd tot tijd worden er thema-avonden georganiseerd."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Salagnard"
    ],
    "fr": [
      "Restaurant Le Salagnard"
    ]
  },
