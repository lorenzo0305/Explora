  "rdfs:comment": {
    "de": [
      "MILLA TERRA. Werkstatt für Töpferei und Keramik. Camille Dessailly, handwerkliche Töpferin und Forscherin für Hochtemperaturglasuren. Entdecken Sie die Magie des Materials und des Feuers und lassen Sie sich von der Welt der handgefertigten Keramik inspirieren."
    ],
    "en": [
      "MILLA TERRA. Pottery workshop. Camille Dessailly, artisan potter and researcher of high-temperature glazes. Come and discover the magic of materials and fire, and be inspired by the world of handmade ceramics."
    ],
    "it": [
      "MILLA TERRA. Laboratorio di ceramica. Camille Dessailly, artigiana ceramista e ricercatrice di smalti ad alta temperatura. Venite a scoprire la magia dei materiali e del fuoco e lasciatevi ispirare dal mondo della ceramica artigianale."
    ],
    "fr": [
      "MILLA TERRA. Atelier de poterie. Camille Dessailly, artisane potière et chercheuse d’émaux haute température. Venez découvrir la magie de la matière et du feu, et laissez-vous inspirer par l’univers de la céramique artisanale."
    ],
    "nl": [
      "MILLA TERRA. Workshop pottenbakken. Camille Dessailly, ambachtelijk pottenbakker en onderzoeker van hoge temperatuur glazuren. Kom de magie van materialen en vuur ontdekken en laat je inspireren door de wereld van handgemaakte keramiek."
    ],
    "es": [
      "MILLA TERRA. Taller de alfarería. Camille Dessailly, alfarero artesano e investigador de esmaltes de alta temperatura. Venga a descubrir la magia de los materiales y el fuego, y déjese inspirar por el mundo de la cerámica artesanal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "MILLA TERRA Camille Dessailly"
    ]
  },
