  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Ziegen und Pferde von Chanteloube\r\n Die Chantelbe stellt klassischen Käse und farbigen Käse mit Aromaten her.\r\nEs besteht die Möglichkeit, online zu bestellen\r\nZucht von amerikanischen Paint Horse- und Quarter Horse-Pferden"
    ],
    "en": [
      "Discover the goats and horses of Chanteloube\r\n The goat farm produces classic cheeses and colored cheeses with herbs.\r\nOnline ordering available\r\nBreeding of American Paint Horse and Quarter Horse"
    ],
    "it": [
      "Venite a scoprire le capre e i cavalli di Chanteloube\r\n L'allevamento di capre produce formaggi classici e formaggi colorati con erbe.\r\nPossibilità di ordinare online\r\nAllevamento di American Paint Horse e Quarter Horse"
    ],
    "fr": [
      "Venez découvrir  les chèvres et les chevaux de Chanteloube\r\n La chévrerie produit des fromages classiques et des fromages colorés aux aromates.\r\nPossibilité de commande en ligne\r\nElevage de chevaux américains Paint Horse et Quarter Horse"
    ],
    "es": [
      "Venga a descubrir las cabras y los caballos de Chanteloube\r\n La granja de cabras produce quesos clásicos y quesos coloreados con hierbas.\r\nPedidos en línea disponibles\r\nCría de American Paint Horse y Quarter Horse"
    ],
    "nl": [
      "Kom en ontdek de geiten en paarden van Chanteloube\r\n De geitenboerderij produceert klassieke kazen en kazen gekleurd met kruiden.\r\nOnline bestellen mogelijk\r\nFokken van Paint Horse en Quarter Horse"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Chèvrerie de Chanteloube \" Les Crouzet's \""
    ]
  },
