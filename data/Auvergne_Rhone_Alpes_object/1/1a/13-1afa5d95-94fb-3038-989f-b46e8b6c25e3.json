  "rdfs:comment": {
    "de": [
      "Geist eines familiären, vertraulichen und experimentellen Weinkellers, oder jeder, der sich für die Kunst des Weins interessiert, kann einen Moment der Entspannung und Geselligkeit rund um die Weinprobe teilen."
    ],
    "en": [
      "Family-feel winery with a personal touch to its experimental approach where anyone interested by the art of wine will be able to enjoy a moment of relaxation and conviviality while tasting a range of exciting wines."
    ],
    "it": [
      "Lo spirito di una cantina familiare, riservata e sperimentale, dove chiunque sia interessato all'arte del vino può condividere un momento di relax e convivialità intorno alla degustazione."
    ],
    "fr": [
      "Esprit de cave familiale, confidentielle et expérimentale, ou toute personne intéressée par l'art du vin pourra partager un moment de détente et de convivialité autour de la dégustation."
    ],
    "nl": [
      "Familiebedrijf in wijn, vertrouwelijk en experimenteel, waar elke wijnliefhebber een moment van ontspanning en gezelligheid kan doorbrengen begeleid door een goed glas wijn."
    ],
    "es": [
      "El espíritu de una bodega familiar, confidencial y experimental, donde cualquier persona interesada en el arte del vino puede compartir un momento de relajación y convivencia en torno a la cata."
    ]
  },
  "rdfs:label": {
