  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2dfc00cb-aefc-30f8-a1b6-5dd74ae34010",
      "dc:description": {
        "de": [
          "Wäscherei geöffnet von Montag bis Freitag 9.00 - 18.00 Uhr und samstags von 9.30 - 19.00 Uhr\nEin neuer Service, der neben Wäscherei und Bügeln auch den Verleih von Laken, Steppdecken und Tischdecken für Privat- und Geschäftskunden anbietet."
        ],
        "en": [
          "Laundry open Monday to Friday 9:00 am - 6:00 pm and Saturday 9:30 am - 7:00 pm\nA new service which, in addition to laundry and ironing, also offers sheet, comforter and tablecloth rental to private and professional customers."
        ],
        "it": [
          "Lavanderia aperta dal lunedì al venerdì dalle 9.00 alle 18.00 e il sabato dalle 9.30 alle 19.00\nOltre alla lavanderia e alla stiratura, questo nuovo servizio noleggia anche lenzuola, piumoni e tovaglie a privati e aziende."
        ],
        "fr": [
          "Laverie ouverte du lundi au vendredi 9h00 - 18h00 et la samedi de 9h30 à 19h00\nUn nouveau service qui en plus de la blanchisserie et du repassage propose aussi la location de draps, de couettes, de nappes aux particuliers et professionnels."
        ],
        "es": [
          "Lavandería abierta de lunes a viernes de 9.00 a 18.00 horas y los sábados de 9.30 a 19.00 horas\nAdemás de lavandería y planchado, este nuevo servicio también alquila sábanas, edredones y manteles a particulares y empresas."
        ],
        "nl": [
          "De wasserette is geopend van maandag tot en met vrijdag van 9.00 tot 18.00 uur en op zaterdag van 9.30 tot 19.00 uur\nNaast wassen en strijken verhuurt deze nieuwe service ook lakens, dekbedden en tafelkleden aan particulieren en bedrijven."
        ]
      },
      "@type": [
        "Description"
      ],
