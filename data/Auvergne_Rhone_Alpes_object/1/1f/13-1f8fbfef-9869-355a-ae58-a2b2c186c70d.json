  "rdfs:comment": {
    "de": [
      "Kinderspielplatz im gemütlichen Park Marie-Louise Jaubert. Eine sanfte Pause dank der Bänke und des Froschteichs.\r\nEine Rutsche und ein Federspiel sind vorhanden."
    ],
    "en": [
      "Children's play area in the pleasant Marie-Louise Jaubert park. A gentle break with benches and a frog pond.\r\nThere's also a slide and a spring-loaded game."
    ],
    "it": [
      "Area giochi per bambini nel piacevole parco Marie-Louise Jaubert. Una pausa dolce con panchine e uno stagno per le rane.\r\nC'è anche uno scivolo e un gioco a molla."
    ],
    "fr": [
      "Aire de jeux pour enfants dans l'agréable parc Marie-Louise Jaubert. Une pause douceur grâce  à la présence de bancs et de la marre aux grenouilles.\r\nPrésence d'un toboggan et jeu à ressort."
    ],
    "es": [
      "Zona de juegos infantiles en el agradable parque Marie-Louise Jaubert. Un suave descanso con bancos y un estanque con ranas.\r\nTambién hay un tobogán y un juego de muelles."
    ],
    "nl": [
      "Kinderspeelplaats in het aangename Marie-Louise Jaubertpark. Een rustige pauze met bankjes en een kikkerpoel.\r\nEr is ook een glijbaan en een verend spel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux parc Marie-Louise Jaubert"
    ]
  },
