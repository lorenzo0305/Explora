  "rdfs:comment": {
    "de": [
      "Die Rotisserie Mornant bietet Ihnen regionale Köstlichkeiten mit ganzen Hähnchen aus Freilandhaltung, Burger mit lokalen Aromen und hausgemachten Pommes frites sowie hausgemachte Desserts.\r\n Genießen Sie sie vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "The Mornant rotisserie offers local flavors with whole farm chickens, burgers with home fries and homemade desserts.\r\n To eat in or take away."
    ],
    "it": [
      "La rosticceria Mornant offre sapori locali con polli interi ruspanti, hamburger locali con patatine fritte e dolci fatti in casa.\r\n Da mangiare o da portare via."
    ],
    "fr": [
      "La rôtisserie Mornant vous propose des saveurs du terroir avec des poulets fermiers entiers, des burgers aux saveurs locales avec frites maison et des desserts maison.\r\n A déguster sur place ou à emporter."
    ],
    "es": [
      "El asador Mornant le ofrece sabores locales con pollos enteros de corral, hamburguesas locales con patatas fritas caseras y postres caseros.\r\n Para comer en casa o para llevar."
    ],
    "nl": [
      "De Mornant rotisserie biedt je lokale smaken met hele scharrelkippen, lokale hamburgers met huisgemaakte frietjes en huisgemaakte desserts.\r\n Om te eten of om mee te nemen."
    ]
  },
  "rdfs:label": {
