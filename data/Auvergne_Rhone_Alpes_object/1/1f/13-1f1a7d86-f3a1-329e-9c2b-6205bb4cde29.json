  "rdfs:comment": {
    "de": [
      "Verrückter Fahrer oder Rennfahrer? Tritt in einem riesigen Mario Kart-Turnier gegen die anderen an! Erreiche die Spitze der Rangliste, um in das Team deiner Einrichtung aufgenommen zu werden und am großen Finale teilzunehmen."
    ],
    "en": [
      "Are you a crazy driver or a race car driver? Come and compete in a giant Mario Kart tournament! Climb to the top of the leaderboard to join your team and take part in the grand final."
    ],
    "it": [
      "Sei un folle guidatore o un pilota da corsa? Vieni a misurarti con gli altri in un gigantesco torneo di Mario Kart! Raggiungi la vetta della classifica per unirti alla tua squadra e partecipare alla grande finale."
    ],
    "fr": [
      "Fou du volant ou pilote de course ? Viens te mesurer aux autres dans un tournoi Mario Kart géant ! Hisse toi au sommet du classement pour intégrer l’équipe de ta structure et participer à la grande finale."
    ],
    "es": [
      "¿Eres un loco de la conducción o un piloto de carreras? ¡Ven y mídete con los demás en un torneo gigante de Mario Kart! Sube a lo más alto de la clasificación para unirte a tu equipo y participar en la gran final."
    ],
    "nl": [
      "Ben jij een rijgek of een autocoureur? Kom en meet jezelf met de anderen in een gigantisch Mario Kart-toernooi! Klim naar de top van het klassement om je aan te sluiten bij je team en deel te nemen aan de grote finale."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Quinzaine des jeux vidéo - Qualification tournoi Mario Kart à la médiathèque"
    ]
  },
