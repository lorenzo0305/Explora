  "rdfs:comment": {
    "de": [
      "Spielen, lesen, reisen, hören, sehen: Die Mediathek bietet 190.000 Dokumente (Bücher, Zeitschriften, DVD-Spiele, CDs, Vinyl, Musikinstrumente...) für alle Zielgruppen."
    ],
    "en": [
      "Play, read, travel, listen, watch: the Media Library offers 190,000 documents (Books, magazines, games, DVDs, CDs, vinyl records, musical instruments...) for all audiences."
    ],
    "it": [
