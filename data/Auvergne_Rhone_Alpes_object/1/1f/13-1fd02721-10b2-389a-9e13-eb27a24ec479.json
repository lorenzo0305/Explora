  "rdfs:comment": {
    "de": [
      "Hier gönnen Sie sich eine Pause auf 2200 m Höhe, während Sie unsere Panoramaterrasse in Südlage genießen, am Tisch oder im Entspannungsmodus auf unseren Liegestühlen oder auf unseren Veranden. Wir bieten Ihnen eine traditionelle und regionale Küche."
    ],
    "en": [
      "Here, we take a break at an altitude of 2,200 metres, enjoying our south-facing panoramic terrace, either at the table or relaxing on our sun loungers or verandas. We offer traditional and regional cuisine."
    ],
    "it": [
      "Qui potrete fare una pausa a 2200 m di altitudine, godendovi la nostra terrazza panoramica esposta a sud, al tavolo o rilassandovi sulle nostre sdraio o verande. Offriamo una cucina tradizionale e regionale."
    ],
    "fr": [
      "Ici on s’octroie une pause à 2200m d'altitude, tout en profitant de notre terrasse panoramique « plein sud », à table ou en mode détente sur nos transats, ou de nos vérandas. Nous vous proposons une cuisine traditionnel et régionale."
    ],
    "nl": [
      "Hier nemen we een pauze op een hoogte van 2200 meter en genieten we van ons panoramische terras op het zuiden, aan tafel of ontspannen op onze ligstoelen of veranda's. We bieden traditionele en regionale gerechten."
    ],
    "es": [
      "Aquí podrá tomarse un descanso a 2200 m de altitud, mientras disfruta de nuestra terraza panorámica orientada al sur, en la mesa o relajándose en nuestras tumbonas o verandas. Ofrecemos cocina tradicional y regional."
    ]
  },
