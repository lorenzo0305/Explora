  "rdfs:comment": {
    "de": [
      "Via Ardèche, der sanfte Weg der Ardèche.\r\nAls echtes Rückgrat zur Entdeckung der südlichen Ardèche bietet die Via Ardèche bemerkenswerte Panoramen auf die Ebenen, den Fluss Ardèche und die Berge der Cevennen."
    ],
    "en": [
      "Via Ardèche, the gentle way of the Ardèche.\r\nThe backbone of the southern Ardèche region, Via Ardèche offers remarkable panoramic views over the plains, the Ardèche river and the Cevennes mountains."
    ],
    "it": [
      "Via Ardèche, la via dolce dell'Ardèche.\r\nVera e propria spina dorsale per la scoperta dell'Ardèche meridionale, la Via Ardèche offre notevoli viste panoramiche sulle pianure, sul fiume Ardèche e sulle montagne delle Cévennes."
    ],
    "fr": [
      "Via Ardèche, voie douce d'Ardèche.\r\nVéritable colonne vertébrale de découverte du sud Ardèche, Via Ardèche offre des panoramas remarquables sur les plaines, la rivière Ardèche et les montagnes cévenoles."
    ],
    "es": [
      "Via Ardèche, el camino suave de Ardèche.\r\nVerdadera espina dorsal para descubrir el sur de Ardèche, la Via Ardèche ofrece notables vistas panorámicas sobre las llanuras, el río Ardèche y las montañas de Cévennes."
    ],
    "nl": [
      "Via Ardèche, de zachte weg van de Ardèche.\r\nDe Via Ardèche is een echte ruggengraat om de zuidelijke Ardèche te ontdekken en biedt opmerkelijke panoramische uitzichten over de vlaktes, de rivier de Ardèche en de bergen van de Cevennen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A vélo sur la Via Ardèche de Saint-Sernin à Largentière"
    ]
  },
