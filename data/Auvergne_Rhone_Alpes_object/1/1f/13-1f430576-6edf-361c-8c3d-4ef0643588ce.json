  "rdfs:comment": {
    "de": [
      "Ein ganz neuer Ort, der dem Padel und der Geselligkeit in Susville gewidmet ist. Der Komplex bietet 2 Indoor-Plätze, die für alle zugänglich sind, ob mit oder ohne FFT-Lizenz, mit einfacher Reservierung über eine Handy-App."
    ],
    "en": [
      "A brand new place dedicated to Padel and friendship in Susville. The sport complex offers 2 indoor camps for everyone (with or without license) with a simple booking using a mobile app."
    ],
    "it": [
      "Un nuovo posto  dedicato al Padel e alla convivialità in Susville. Il Complex propone 2 campi indoor accessibili a tutti (con o senza licenza) con una prenotazione semplice via un app."
    ],
    "fr": [
      "Un tout nouveau lieu dédié au padel et à la convivialité à Susville. Le complexe propose 2 terrains indoor accessibles à tous, licenciés FFT ou non, avec réservation simple via une application mobile."
    ],
    "es": [
      "Un nuevo espacio dedicado al pádel y a un ambiente agradable en Susville. El complejo ofrece 2 pistas cubiertas accesibles para todos, titulares o no de una licencia FFT, con reservas sencillas a través de una aplicación móvil."
    ],
    "nl": [
      "Een gloednieuwe locatie gewijd aan padel en een gezellige sfeer in Susville. Het complex biedt 2 indoorbanen die toegankelijk zijn voor iedereen, FFT-licentiehouders of niet, met eenvoudige reservering via een mobiele applicatie."
    ]
  },
