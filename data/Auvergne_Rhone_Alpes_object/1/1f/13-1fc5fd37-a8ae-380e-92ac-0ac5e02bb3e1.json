  "rdfs:comment": {
    "de": [
      "Es waren die Mönche der Abtei Saint Chaffre du Monastier, die ein Priorat gründeten und so das Dorf Montusclat schufen."
    ],
    "en": [
      "The monks of the abbey Saint Chaffre du Monastier founded a priory and thus created the village of Montusclat."
    ],
    "it": [
      "Furono i monaci dell'abbazia di Saint Chaffre du Monastier a fondare un priorato e a creare così il villaggio di Montusclat."
    ],
    "fr": [
      "Ce sont les moines de l'abbaye Saint Chaffre du Monastier qui fondèrent un prieuré et créèrent ainsi le village de Montusclat."
    ],
    "nl": [
