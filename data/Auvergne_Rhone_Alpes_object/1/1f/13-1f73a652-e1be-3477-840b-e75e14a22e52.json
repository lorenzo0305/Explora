  "rdfs:comment": {
    "de": [
      "Die zeitgenössische Kunst zeichnet sich durch eine Vielzahl von Ästhetiken und Techniken aus, aber auch durch ihr tiefes Engagement für politische Botschaften und soziale Kämpfe."
    ],
    "en": [
      "Contemporary art is characterized by a multitude of aesthetics and techniques, but also by its deep commitment to political messages and social struggles."
    ],
    "it": [
      "L'arte contemporanea è caratterizzata da una moltitudine di estetiche e tecniche, ma anche da un profondo impegno nei confronti di messaggi politici e lotte sociali."
    ],
    "fr": [
      "L'art contemporain se distingue par une multitude d'esthétiques et de techniques, mais aussi par son profond engagement dans des messages politiques et des luttes sociales."
    ],
    "nl": [
      "Hedendaagse kunst wordt gekenmerkt door een veelheid aan esthetieken en technieken, maar ook door haar diepe betrokkenheid bij politieke boodschappen en sociale strijd."
    ],
    "es": [
      "El arte contemporáneo se caracteriza por una multitud de estéticas y técnicas, pero también por su profundo compromiso con los mensajes políticos y las luchas sociales."
    ]
  },
  "rdfs:label": {
