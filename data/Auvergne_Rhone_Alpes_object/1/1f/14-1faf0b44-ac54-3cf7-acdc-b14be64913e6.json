      "@id": "https://data.datatourisme.fr/5e1d7658-0c9a-3a06-b5f8-39fbe87d95fb",
      "dc:description": {
        "de": [
          "Dienstag, 17. Februar\n--------------------------------------\nAktivität: Manuelle Aktivität \"Mein Goûter Gourmand\", angeboten von der Abteilung Animation des Rathauses von Merlimont\nTreffpunkt: Fremdenverkehrsamt Merlimont, von 9:30 bis 11:00 Uhr\nPREIS: 3? pro Person\n\nSie können sich beim Service Animation im Office de Tourisme von Merlimont anmelden: 70 Avenue du Centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Tuesday, February 17\n--------------------------------------\nActivity: Manual activity \"Mon Goûter Gourmand\" proposed by the Service Animation of the Mairie de Merlimont\nMeeting point at Merlimont Tourist Office, from 9.30am to 11am\nRATE: 3? per person\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Martedì 17 febbraio\n--------------------------------------\nAttività: attività manuale \"Mon Goûter Gourmand\", organizzata dall'Ufficio Eventi del Comune di Merlimont\nPunto d'incontro: Ufficio del Turismo di Merlimont, dalle 9.30 alle 11.00\nTARIFFA: 3? a persona\n\nÈ possibile iscriversi presso il servizio di animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Mardi 17 février\n--------------------------------------\nActivité : Activité manuelle \"Mon Goûter Gourmand\" proposée par le Service Animation de la Mairie de Merlimont\nRendez-vous à l'Office de Tourisme de Merlimont, de 9h30 à 11h\nTARIF : 3€ par personne\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "es": [
          "Martes 17 de febrero\n--------------------------------------\nActividad: \"Mon Goûter Gourmand\" actividad manual organizada por el Departamento de Eventos del Ayuntamiento de Merlimont\nPunto de encuentro: Oficina de Turismo de Merlimont, de 9h30 a 11h00\nTARIFA: 3? por persona\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9.00 a 12.00 h\nCONTACTO: 03 21 94 72 18\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ],
        "nl": [
          "Dinsdag 17 februari\n--------------------------------------\nActiviteit: \"Mon Goûter Gourmand\" manuele activiteit georganiseerd door de dienst Evenementen van de Stad Merlimont\nTrefpunt: Toeristische dienst van Merlimont, van 9u30 tot 11u\nTarief: 3? per persoon\n\nU kunt zich inschrijven bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, van maandag tot vrijdag van 9 tot 12 uur\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ]
      },
