  "rdfs:comment": {
    "de": [
      "Das Zentrum bietet folgende Dienstleistungen an: Besitzerstall / Turnierstall, Pensionen, Pferdezucht und -verkauf, Clubhaus - Sattelkammern.\r\nBereitstellung von Pferden für Turniere."
    ],
    "en": [
      "The center offers the following services: Owners' stable / Show stable, boarding, horse breeding and sales, club house - tack rooms.\r\nHorses available for competitions."
    ],
    "it": [
      "Il centro offre i seguenti servizi: Scuderia di proprietà / scuderia da competizione, pensioni, allevamento e vendita di cavalli, club house - tack room.\r\nFornitura di cavalli per le competizioni."
    ],
    "fr": [
      "Le centre propose les services suivants : Ecurie de propriétaires / Ecurie de concours, pensions, élevage et ventes de chevaux, club house - selleries.\r\nMise à disposition de chevaux pour concours."
    ],
    "nl": [
      "Het centrum biedt de volgende diensten aan: Eigenarenstal / wedstrijdstal, pensions, fokkerij en verkoop van paarden, clubhuis - zadelkamers.\r\nTerbeschikkingstelling van paarden voor wedstrijden."
    ],
    "es": [
      "El centro ofrece los siguientes servicios: Establo de propietarios / establo de competición, pensiones, cría y venta de caballos, casa club - guadarnés.\r\nSuministro de caballos para concursos."
    ]
  },
