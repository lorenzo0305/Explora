  "rdfs:comment": {
    "de": [
      "Dieser Likör wird nach einem traditionellen Rezept hergestellt. Sein einzigartiger, köstlich duftender Geschmack wird den ganzen Charakter unserer Region enthüllen."
    ],
    "en": [
      "Liqueur made according to a traditional recipe. Its unique, deliciously fragrant taste reveals all the character of our terroir."
    ],
    "it": [
      "Un liquore realizzato secondo una ricetta tradizionale. Il suo gusto unico e deliziosamente profumato rivela tutto il carattere del nostro territorio."
    ],
    "fr": [
      "Liqueur fabriquée suivant une recette traditionnelle. Son goût unique, délicieusement parfumé, révélera tout le caractère de notre terroir."
    ],
    "es": [
      "Un licor elaborado según una receta tradicional. Su sabor único y deliciosamente perfumado revela todo el carácter de nuestro terruño."
    ],
