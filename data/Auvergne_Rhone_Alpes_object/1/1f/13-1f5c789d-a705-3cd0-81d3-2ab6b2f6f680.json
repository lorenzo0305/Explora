  "rdfs:comment": {
    "de": [
      "Seifenschöpfer seit 1989 ...\r\nDurch die Geheimnisse der Verseifung edler Öle erfinde ich in meinen Seifenkesseln Seifen, die für ihre wohltuende Wirkung bekannt sind..."
    ],
    "en": [
      "Creator of soap since 1989...\r\nThrough the mysteries of the saponification of noble oils, in my soap pots I invent soaps renowned for their virtues..."
    ],
    "it": [
      "Creatore di saponi dal 1989...\r\nAttraverso i misteri della saponificazione degli oli nobili, nei miei calderoni di saponificazione invento saponi rinomati per le loro virtù..."
    ],
    "fr": [
      "Créateur de savon depuis 1989...\r\nPar les mystères de la saponification des huiles nobles, dans mes chaudrons de savonnier j'invente des savons réputés pour leurs vertus..."
    ],
    "nl": [
      "Zeepmaker sinds 1989...\r\nDoor de mysteries van de verzeping van edele oliën, in mijn zeepketels, vind ik zepen uit die bekend staan om hun deugden..."
    ],
    "es": [
      "Creador de jabones desde 1989...\r\nA través de los misterios de la saponificación de los aceites nobles, en mis calderas jaboneras invento jabones famosos por sus virtudes..."
    ]
  },
