  "rdfs:comment": {
    "de": [
      "Das Castel du Mont Boisé ist ein charmantes kleines Schloss, das im Mittelalter der Familie Adhemar gehörte. Es liegt inmitten eines großen Parks mit jahrhundertealten Bäumen und bietet einen Panoramablick auf das Tal der Valdaine.\r\nEs kann nicht besichtigt werden."
    ],
    "en": [
      "Castel du Mont Boisé is a charming little château that belonged to the Adhemar family in the Middle Ages, set in a large park with centuries-old trees and a panoramic view over the Valdaine valley.\r\nNot open to visitors."
    ],
    "it": [
      "Il Castel du Mont Boisé è un affascinante castelletto appartenuto nel Medioevo alla famiglia Adhemar, situato al centro di un grande parco con alberi secolari e una vista panoramica sulla Valdaine.\r\nNon può essere visitato."
    ],
    "fr": [
      "Le Castel du Mont Boisé est un charmant petit château ayant appartenu à la famille Adhemar au Moyen âge, situé au milieu d'un grand parc arboré d'arbres séculaires avec une vue panoramique sur la vallée de la Valdaine.\r\nIl ne se visite pas."
    ],
    "es": [
      "El Castel du Mont Boisé es un pequeño y encantador castillo que perteneció a la familia Adhemar en la Edad Media. Está situado en medio de un gran parque con árboles centenarios y una vista panorámica sobre el valle de Valdaine.\r\nNo se puede visitar."
    ],
    "nl": [
      "Castel du Mont Boisé is een charmant kasteeltje dat in de middeleeuwen toebehoorde aan de familie Adhemar, midden in een groot park met eeuwenoude bomen en een panoramisch uitzicht over de Valdaine vallei.\r\nHet is niet toegankelijk voor bezoekers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Castel"
    ]
  },
