  "rdfs:comment": {
    "de": [
      "10 Hektar großes Reitgebiet. Ausgestattet mit einer 80 x 30 großen Sandgrube, die Ihnen zur Verfügung gestellt wird. Direkter Zugang zu zahlreichen angenehmen Spazierwegen für Ausritte am Ufer der Saône. Qualitativ hochwertige Betreuung."
    ],
    "en": [
      "Equestrian field on a target area of 10,000 hectares. With 38m x 30 arena sand is available. Direct access to countless attractive horse hiking along the River Saône. Good qality coaching."
    ],
    "it": [
      "Tenuta equestre di 10 ettari. Dotato di una carriera di sabbia 80 x 30 a vostra disposizione. Accesso diretto a numerosi e piacevoli sentieri per passeggiate a cavallo lungo la Saona. Supervisione della qualità."
    ],
    "fr": [
      "Domaine équestre de 10 hectares. Equipé d'une carrière en sable de 80 x 30 mise à votre disposition. Accès direct à de nombreux et agréables chemins de promenade pour des balades à cheval en bord de Saône. Encadrement de qualité."
    ],
    "nl": [
      "Hippisch landgoed van 10 hectare. Voorzien van een zandbaan van 80 x 30 tot uw beschikking. Directe toegang tot talrijke aangename wandelpaden voor paardrijden langs de Saône. Kwaliteitstoezicht."
    ],
    "es": [
      "Finca ecuestre de 10 hectáreas. Equipado con una carrera de arena de 80 x 30 a su disposición. Acceso directo a numerosos y agradables senderos para montar a caballo a lo largo del Saona. Supervisión de la calidad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Stables for horses of \"Haras de Challes\""
    ],
    "fr": [
      "Haras de Challes"
    ]
  },
