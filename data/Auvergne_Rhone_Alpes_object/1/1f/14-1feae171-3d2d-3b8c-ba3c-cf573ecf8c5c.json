  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/51a65556-efb0-38f1-9c4a-23ce05c5d868",
      "dc:description": {
        "de": [
          "DerfCoCustome, Customization auf allen Medien!\n\nInformationen :\n\nKostenloser Kostenvoranschlag, Bestellung nach Maß.\n\nAbholung Ihrer Bestellung in Mont-Saint-Eloi\n\nPostversand möglich\n "
        ],
        "en": [
          "DerfCoCustome, customization on any surface!\n\nInformations :\n\nFree quotation, custom order.\n\nPicking up your order in Mont-Saint-Eloi\n\nPostal delivery possible\n "
        ],
        "it": [
          "DerfCoCustome, personalizzazione su qualsiasi superficie!\n\nPer ulteriori informazioni:\n\nPreventivo gratuito, ordine su misura.\n\nRitiro dell'ordine a Mont-Saint-Eloi\n\nPossibilità di consegna postale\n "
        ],
        "fr": [
          "DerfCoCustome, customisation sur tout support !\n\nInformations :\n\nDevis gratuit, commande sur mesure.\n\nRécupération de votre commande à Mont-Saint-Eloi\n\nEnvoi postal possible\n "
        ],
        "nl": [
          "DerfCoCustome, maatwerk op elk oppervlak!\n\nVoor meer informatie:\n\nGratis offerte, bestelling op maat.\n\nUw bestelling afhalen in Mont-Saint-Eloi\n\nLevering per post mogelijk\n "
        ],
        "es": [
          "DerfCoCustome, ¡personalización en cualquier superficie!\n\nPara más información:\n\nPresupuesto gratuito, pedido a medida.\n\nRecoger su pedido en Mont-Saint-Eloi\n\nPosibilidad de entrega por correo\n "
        ]
      },
