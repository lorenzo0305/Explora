  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Orientierungslauf Wandern an der Côte d'Aime!\r\nEntdecken Sie diese alten Dörfer, die Weinberge und Obstgärten dieses hochgelegenen Dorfes.\r\nEine leichte Strecke von 6 km mit 275 mD+ und ihren 10 Markierungen."
    ],
    "en": [
      "Welcome to the orienteering course at La Côte d'Aime!\r\nDiscover the old villages, the vineyards and orchards around this village nestled on the mountainside\r\nAn easy 6km trail with 275m elevation gain and 10 markers."
    ],
    "it": [
      "Benvenuti sul percorso di orientamento della Côte d'Aime!\r\nScoprite gli antichi villaggi, i vigneti e i frutteti di questo borgo arroccato\r\nUn percorso facile di 6 km con oltre 275 metri e 10 marcatori."
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation randonnée sur la Côte d'Aime !\r\nDécouvrez ces villages anciens, les vignes et vergers de ce village perché\r\nUn parcours facile de 6km avec 275mD+ et ses 10 balises."
    ],
    "nl": [
      "Welkom bij de oriëntatieloop van de Côte d'Aime!\r\nOntdek de oude dorpjes, wijngaarden en boomgaarden van dit dorp op een heuveltop.\r\nEen gemakkelijke route van 6 km met meer dan 275 m en 10 markeringen."
    ],
    "es": [
      "Bienvenido a la ruta de orientación de la Côte d'Aime\r\nDescubra las antiguas aldeas, los viñedos y los huertos de este pueblo encaramado\r\nUn recorrido fácil de 6 km con más de 275 metros y 10 balizas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Wandern an der Côte d'Aime"
    ],
    "en": [
      "Orienteering course, hiking around La Côte d'Aime"
    ],
    "fr": [
      "Parcours d'orientation Randonnée sur la Côte d'Aime"
    ],
    "nl": [
      "Oriëntatieloop Wandelen aan de Côte d'Aime"
    ]
  },
