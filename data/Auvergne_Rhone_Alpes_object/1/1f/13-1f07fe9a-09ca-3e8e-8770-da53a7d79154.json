  "rdfs:comment": {
    "de": [
      "Entdecken Sie uns in der Sattlerei von Rochemaure.\r\nArtis'Ane Cuir bietet Leistungen für Gemeinden (Lederschnitzerei) Drückerei auf zu gerbendem Leder. Reparaturen von Ledergegenständen"
    ],
    "en": [
      "Come and discover us at the Rochemaure saddlery.\r\nArtis'Ane Cuir offers services for local authorities (leather sculpting), embossing on tanned leather. Repairs to leather objects"
    ],
    "it": [
      "Venite a scoprirci nella selleria di Rochemaure.\r\nArtis'Ane Cuir offre servizi per gli enti locali (scultura in pelle), goffratura su pelle conciata. Riparazioni di oggetti in pelle"
    ],
    "fr": [
      "Venez  nous découvrir à la sellerie de Rochemaure.\r\nArtis'Ane Cuir propose des prestations pour les communes (sculpture sur cuir) repoussage sur cuir à tannage. Réparations d'objets en cuir"
    ],
    "es": [
      "Venga a descubrirnos a la guarnicionería de Rochemaure.\r\nArtis'Ane Cuir ofrece servicios para colectividades (escultura en cuero), repujado sobre cuero curtido. Reparación de objetos de cuero"
    ],
    "nl": [
      "Kom ons ontdekken in de zadelmakerij van Rochemaure.\r\nArtis'Ane Cuir biedt diensten aan voor gemeenten (ledersculpturen), reliëf op gelooid leder. Reparaties aan leren voorwerpen"
    ]
  },
