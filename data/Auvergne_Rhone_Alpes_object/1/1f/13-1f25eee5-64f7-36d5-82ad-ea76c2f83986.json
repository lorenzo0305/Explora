  "rdfs:comment": {
    "de": [
      "In ihrem Atelier erweckt Christine Georges Ihre alten oder zeitgenössischen Möbel und Gegenstände zu neuem Leben. Als Möbelmalerin und Kunsthandwerkerin restauriert sie Ihre Möbel und stellt ihr Know-how in den Dienst Ihres dekorativen Projekts."
    ],
    "en": [
      "In her workshop, Christine Georges brings your antique or contemporary furniture and objects back to life. A furniture painter and craftswoman, she restores your furniture and puts her expertise at the service of your decorative project."
    ],
    "it": [
      "Nel suo laboratorio, Christine Georges riporta in vita i vostri mobili e oggetti antichi o contemporanei. Pittrice di mobili e artigiana, restaura i vostri mobili e mette la sua esperienza al servizio del vostro progetto decorativo."
    ],
    "fr": [
      "Dans son atelier, Christine Georges redonne vie à vos meubles et objets anciens ou contemporains. Peintre en mobilier, artisane d'Art, elle restaure vos meubles et met son savoir-faire au service de votre projet décoratif."
    ],
    "nl": [
      "In haar atelier brengt Christine Georges uw antieke of hedendaagse meubelen en voorwerpen weer tot leven. Als meubelschilder en ambachtsvrouw restaureert ze uw meubels en stelt ze haar expertise ten dienste van uw decoratieproject."
    ],
    "es": [
      "En su taller, Christine Georges devuelve la vida a sus muebles y objetos antiguos o contemporáneos. Pintora de muebles y artesana, restaura sus muebles y pone su experiencia al servicio de su proyecto decorativo."
    ]
  },
  "rdfs:label": {
