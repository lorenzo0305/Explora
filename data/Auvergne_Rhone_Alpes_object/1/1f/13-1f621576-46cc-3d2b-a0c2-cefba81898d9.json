  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Herz des majestätischen Mont-Blanc-Massivs, flirten Sie mit den Gipfeln, erleben Sie für einen Moment die Berge in ihrer reinsten Form. \r\nCMBH nimmt Sie mit auf einen Rundflug."
    ],
    "en": [
      "Plunge into the heart of the majestic Mont-Blanc Massif, flirt with the peaks and experience the mountains in their purest form. \r\nCMBH takes you on a panoramic flight."
    ],
    "it": [
      "Immergetevi nel cuore del maestoso massiccio del Monte Bianco, flirtate con le cime e vivete la montagna nella sua forma più pura. \r\nCMBH vi porta in volo panoramico."
    ],
    "fr": [
      "Plongez au cœur du majestueux Massif du Mont-Blanc, flirtez avec les sommets, vivez un instant la montagne à l’état pur. \r\nCMBH vous emmène en vol panoramique."
    ],
    "es": [
      "Sumérjase en el corazón del majestuoso macizo del Mont Blanc, coquetee con las cumbres y viva la montaña en estado puro. \r\nCMBH te lleva en un vuelo panorámico."
    ],
    "nl": [
      "Duik in het hart van het majestueuze Mont Blanc-massief, flirt met de bergtoppen en ervaar de bergen in hun puurste vorm.\r\nCMBH neemt je mee op een panoramische vlucht."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chamonix Mont Blanc Hélicoptères : Panoramic flights"
    ],
    "fr": [
      "Chamonix Mont Blanc Hélicoptères : Vols panoramiques"
    ]
  },
