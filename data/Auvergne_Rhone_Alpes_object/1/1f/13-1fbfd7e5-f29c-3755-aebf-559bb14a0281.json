  "rdfs:comment": {
    "de": [
      "Erleben Sie eine unvergessliche Gleitschirmtaufe mit Aeroslide in Annecy. Ausgebildete Piloten, Start am Col de la Forclaz, schwindelerregende Aussicht auf den See und die Alpen. Geeignet ab 4 Jahren für Sensationen oder Kontemplation."
    ],
    "en": [
      "Experience an unforgettable tandem paragliding flight with Aeroslide in Annecy. Certified pilots, take-off from Col de la Forclaz, breathtaking views of Lake Annecy and the Alps. From age 4."
    ],
    "it": [
      "Godetevi un'indimenticabile prima esperienza di parapendio con Aeroslide ad Annecy. Piloti qualificati, decollo dal Col de la Forclaz, vista mozzafiato sul lago e sulle Alpi. Adatto ai bambini dai 4 anni in su, per un'emozione o un brivido di vita."
    ],
    "fr": [
      "Vivez un baptême en parapente inoubliable avec Aeroslide à Annecy. Pilotes diplômés, décollage au Col de la Forclaz, vues vertigineuses sur le lac et les Alpes. Adapté dès 4 ans pour sensations ou contemplation."
    ],
    "nl": [
      "Geniet van een onvergetelijke eerste paragliding-ervaring met Aeroslide in Annecy. Gekwalificeerde piloten, opstijgen vanaf de Col de la Forclaz, adembenemend uitzicht op het meer en de Alpen. Geschikt voor kinderen vanaf 4 jaar, voor een sensatie of een sensatie van je leven."
    ],
    "es": [
      "Disfrute de una primera experiencia inolvidable en parapente con Aeroslide en Annecy. Pilotos cualificados, despegue desde el Col de la Forclaz, vistas impresionantes del lago y los Alpes. Apto para niños a partir de 4 años, para vivir una emoción única."
    ]
  },
