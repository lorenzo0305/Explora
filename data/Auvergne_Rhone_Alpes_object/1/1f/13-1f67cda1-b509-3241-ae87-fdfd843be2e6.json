  "rdfs:comment": {
    "de": [
      "Die Auberge du Grand Ronjon ist der ideale Ort, um neue Energie zu tanken und die Freuden vergangener Zeiten wiederzuentdecken."
    ],
    "en": [
      "The Auberge du Grand Ronjon is the ideal place to recharge your batteries and rediscover the pleasures of yesteryear."
    ],
    "it": [
      "L'Auberge du Grand Ronjon è il luogo ideale per ricaricare le batterie e riscoprire i piaceri di un tempo."
    ],
    "fr": [
      "L'Auberge du Grand Ronjon est le lieu idéal pour se ressourcer et redécouvrir les plaisirs d'autrefois."
    ],
    "nl": [
      "In het hart van het Bressense platteland, Auberge de la Ferme du Grand Ronjon verwelkomt u in traditionele klederdracht. U kunt hier vele recepten en lokale smaken ontdekken en genieten van de regionale gerechten."
    ],
    "es": [
      "El Auberge du Grand Ronjon es el lugar ideal para recargar las pilas y redescubrir los placeres de antaño."
    ]
  },
