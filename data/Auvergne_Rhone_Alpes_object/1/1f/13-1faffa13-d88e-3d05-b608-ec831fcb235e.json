  "rdfs:comment": {
    "de": [
      "Nehmen Sie sich Zeit für eine Schlemmerpause (Crêpes, Sandwiches, Salat, Eis...) an einem atypischen Ort, an dem sich kleine Küche und kleiner Flohmarkt vermischen."
    ],
    "en": [
      "Take time out for a gourmet break (crêpes, sandwiches, salads, ice creams...) in an atypical place where small-scale cooking and small-scale antiques mingle."
    ],
    "it": [
      "Concedetevi una pausa golosa (crêpes, panini, insalate, gelati...) in un luogo insolito dove si incontrano piccola cucina e piccolo usato."
    ],
    "fr": [
      "Prenez le temps d'une pause gourmande (crêpes, sandwichs, salade, glaces...) dans un lieu atypique où se mêlent la petite cuisine et la petite brocante."
    ],
    "es": [
      "Tómese su tiempo para una pausa gastronómica (crêpes, sándwiches, ensaladas, helados...) en un lugar insólito donde se dan cita la pequeña cocina y el pequeño comercio de ocasión."
    ],
    "nl": [
      "Neem de tijd voor een gastronomische pauze (crêpes, broodjes, salades, ijsjes...) op een ongewone plek waar kleinschalig koken en kleinschalige tweedehands goederen samenkomen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La brocante gourmande"
    ]
  },
