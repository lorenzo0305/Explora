  "rdfs:comment": {
    "de": [
      "In Tignieu-Jameyzieu hat das Buch sein Haus! Genießen Sie diesen neuen Ort des Lebens, des Austauschs und der Geselligkeit in der Siedlung Létrat."
    ],
    "en": [
      "Books have found a home in Tignieu-Jameyzieu!\r\nYou'll find this new facility in Létrat housing estate. Come along to meet and discuss with other people in a warm and friendly atmosphere."
    ],
    "it": [
      "A Tignieu-Jameyzieu, i libri hanno una casa! Venite a scoprire questo nuovo luogo di vita, socializzazione e aggregazione nel complesso residenziale di Létrat."
    ],
    "fr": [
      "À Tignieu-Jameyzieu, le livre à sa Maison ! Venez profiter de ce nouveau lieu de vie, d'échanges et de convivialité au lotissement Létrat."
    ],
    "nl": [
      "In Tignieu-Jameyzieu hebben boeken een thuis! Kom genieten van deze nieuwe plek om te wonen, te socialiseren en samen te zijn in de woonwijk Létrat."
    ],
    "es": [
      "En Tignieu-Jameyzieu, ¡los libros tienen un hogar! Venga a disfrutar de este nuevo lugar para vivir, relacionarse y socializar en la urbanización Létrat."
    ]
  },
  "rdfs:label": {
