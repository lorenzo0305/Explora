  "rdfs:comment": {
    "de": [
      "Minigolf mit 15 Löchern. Minigolf ist die Miniaturversion des Golfsports. Die Aktivität wird im Freien gespielt und erfordert Präzision, um einen Ball mithilfe eines Schafts, den man \"Putter\" nennt, in ein Loch zu rollen.  Jetzt sind Sie dran!"
    ],
    "en": [
      "Mini-golf 15 holes. Mini-golf is the miniature version of golf. Played in the open air, it requires precision to roll a ball into a hole using a handle called a \"putter\".  It's your turn to play!"
    ],
    "it": [
      "Campo da minigolf a 15 buche. Il minigolf è la versione in miniatura del golf. Si gioca all'aperto e richiede precisione nel far rotolare una pallina in una buca usando un'impugnatura chiamata putter.  È il vostro turno di giocare!"
    ],
    "fr": [
      "Mini-golf 15 trous. Le mini-golf est la version miniature du golf. L’activité se joue en plein air et demande de la précision pour faire rouler une balle dans un trou à l’aide d’un manche appelé « putter ».  À vous de jouer !"
    ],
    "es": [
      "Campo de minigolf de 15 hoyos. El minigolf es la versión en miniatura del golf. Se juega al aire libre y requiere precisión para introducir una bola en un agujero utilizando un mango llamado putter.  ¡Te toca jugar!"
    ],
    "nl": [
      "15-holes midgetgolfbaan. Minigolf is de miniatuurversie van golf. Het wordt buiten gespeeld en vereist precisie bij het rollen van een bal in een gat met behulp van een handvat dat putter wordt genoemd.  Het is jouw beurt om te spelen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mini-golf"
    ]
  },
