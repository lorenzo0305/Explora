  "rdfs:comment": {
    "de": [
      "Virginie und Bruno und ihre beiden Töchter heißen Sie in ihrem traditionellen Restaurant mit einem Hauch von mediterraner Küche willkommen. Hier können Sie gute hausgemachte Gerichte aus frischen und lokalen Produkten genießen."
    ],
    "en": [
      "Virginie and Bruno and their 2 daughters welcome you to their traditional restaurant with a touch of Mediterranean cuisine. You can enjoy home-cooked dishes based on fresh, local produce."
    ],
    "it": [
      "Virginie e Bruno e le loro 2 figlie vi danno il benvenuto nel loro ristorante tradizionale con un tocco di cucina mediterranea. Potrete gustare deliziosi piatti fatti in casa con prodotti freschi locali."
    ],
    "fr": [
      "Virginie et Bruno et leurs 2 filles vous accueillent dans leur restaurant traditionnel avec une touche de cuisine méditerranéenne. Vous pouvez y déguster des bons plats faits maison à la base des produits frais et locaux."
    ],
    "es": [
      "Virginie y Bruno y sus 2 hijas le dan la bienvenida a su restaurante tradicional con un toque de cocina mediterránea. Podrá degustar deliciosos platos caseros elaborados con productos frescos de la zona."
    ],
    "nl": [
      "Virginie en Bruno en hun 2 dochters heten je welkom in hun traditionele restaurant met een vleugje mediterrane keuken. Je kunt er genieten van heerlijke huisgemaakte gerechten met verse streekproducten."
    ]
  },
