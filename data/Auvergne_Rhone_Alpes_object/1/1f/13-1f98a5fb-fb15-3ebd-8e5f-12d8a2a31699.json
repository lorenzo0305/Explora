  "rdfs:comment": {
    "de": [
      "Bergbegleiter, der das ganze Jahr über Wanderungen anbietet. Besonderheit: Ausflug zum Sammeln und Kochkurs über Wildpflanzen, Beobachtung der alpinen Fauna. Trapper-Lehrgang, Gourmet-Balade (Schneeschuhwanderung + Essen)."
    ],
    "en": [
      "Mountain guide offering hikes all year round. Special features: wild plant gathering and cooking courses, Alpine wildlife observation. Trapper course, gourmet walk (snowshoe outing + meal)."
    ],
    "it": [
      "Guida alpina che offre escursioni tutto l'anno. Particolarità: uscite di raccolta di piante selvatiche e corsi di cucina, osservazione della fauna alpina. Corso di trapper, passeggiata gastronomica (uscita con le racchette da neve + pasto)."
    ],
    "fr": [
      "Accompagnateur en montagne proposant des randonnées  toute l'année. Particularité : sortie cueillette et cours de cuisine sur les plantes sauvages, observation faune Alpine. Stage Trappeur, Balade gourmande (sortie raquettes + repas)."
    ],
    "es": [
      "Guía de montaña que ofrece excursiones durante todo el año. Especialidades: salidas de recolección de plantas silvestres y cursos de cocina, observación de la fauna alpina. Curso de trampero, paseo gastronómico (salida con raquetas + comida)."
    ],
    "nl": [
      "Berggids die het hele jaar door wandelingen aanbiedt. Bijzonderheden: wilde planten plukken en kookcursussen, observatie van de alpiene fauna. Trapperscursus, gastronomische wandeling (sneeuwschoenwandeling + maaltijd)."
    ]
  },
