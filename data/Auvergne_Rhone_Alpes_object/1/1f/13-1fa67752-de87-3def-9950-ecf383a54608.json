  "rdfs:comment": {
    "de": [
      "Le Café des Vignerons: Weinbar und französische Küche.\r\nIm Zentrum von Grignan entdecken Sie die offizielle Vertretung der Appellation Grignan-les-Adhémar: über 20 vertretene Weingüter und 100 angebotene Weinreferenzen."
    ],
    "en": [
      "The Café des Vignerons, cuisine bar ‘à la Française’.\r\n At the centre of Grignan, discover the official representation of the Grignan-les-Adhémar appellation: over 20 domaines (estates) represented and 100 wines offered."
    ],
    "it": [
      "Le Café des Vignerons: enoteca e cucina alla francese.\r\nNel centro di Grignan, scoprite la rappresentanza ufficiale della denominazione Grignan-les-Adhémar: oltre 20 aziende rappresentate e 100 referenze di vini in offerta."
    ],
    "fr": [
      "Le Café des Vignerons : bar à vins et cuisine à la française. \r\nAu centre de Grignan, découvrez la représentation officielle de l'Appellation Grignan-les-Adhémar : plus de 20 domaines représentés et 100 références de vin proposées."
    ],
    "nl": [
      "Le Café des Vignerons: wijnbar en Franse keuken.\r\nOntdek in het centrum van Grignan de officiële vertegenwoordiging van de appellation Grignan-les-Adhémar: meer dan 20 landgoederen vertegenwoordigd en 100 wijnreferenties in de aanbieding."
    ],
    "es": [
      "Le Café des Vignerons: bar de vinos y cocina a la francesa.\r\nEn el centro de Grignan, descubra la representación oficial de la denominación Grignan-les-Adhémar: más de 20 fincas representadas y 100 referencias de vino en oferta."
    ]
  },
