  "rdfs:comment": {
    "de": [
      "Der Schmetterling von Rochefort ist eine Erweiterung des kleinen Rundwegs Nr. 7, der im Dorf Rochefort-en-Valdaine beginnt. Diese windgeschützte Schleife führt durch das Massiv rund um die ikonische mittelalterliche Burg."
    ],
    "en": [
      "Le papillon de Rochefort is an extension of the small loop n°7 starting from the village of Rochefort-en-Valdaine. Sheltered from the wind, this loop winds its way through the massif around the iconic medieval castle."
    ],
    "it": [
      "La farfalla di Rochefort è un'estensione dell'anello n. 7, che parte dal villaggio di Rochefort-en-Valdaine. Riparato dal vento, questo anello si snoda sul massiccio attorno all'iconico castello medievale."
    ],
    "fr": [
      "Le papillon de Rochefort est une extension de la petite boucle n°7 au départ du village de Rochefort-en-Valdaine. Abritée du vent, cette boucle parcoure de massif autour du château médiéval iconique."
    ],
    "es": [
      "La mariposa de Rochefort es una prolongación del bucle nº 7, que parte del pueblo de Rochefort-en-Valdaine. Al abrigo del viento, este bucle recorre el macizo que rodea el emblemático castillo medieval."
    ],
    "nl": [
      "De vlinder van Rochefort is een uitbreiding van lus nr. 7 die vertrekt vanuit het dorp Rochefort-en-Valdaine. Beschut tegen de wind neemt deze lus het massief rond het iconische middeleeuwse kasteel in zich op."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le papillon de Rochefort-en-Valdaine"
    ]
  },
