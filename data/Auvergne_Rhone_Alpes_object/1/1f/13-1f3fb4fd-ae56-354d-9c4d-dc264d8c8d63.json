  "rdfs:comment": {
    "de": [
      "Bistro-Resto, Café-Theater, Treffpunkt im Dorf, wo man sich gerne unterhält, klassische Musik hört und Freundschaften knüpft. Authentizität, Einfachheit und Geselligkeit sind die drei Kriterien dieses atypischen Lokals. Spezialitäten aus der Region"
    ],
    "en": [
      "Bistrot-restaurant, café-theatre, a place where to meet in the village to discuss, listen to classical music and socialising. Authenticity, simplicity and friendliness are the 3 criteria of this unexpected address. Local products specialities."
    ],
    "it": [
      "Bistro-Resto, caffè-teatro, luogo di incontro del villaggio dove è bello parlare, ascoltare musica classica e fare amicizia. Autenticità, semplicità e convivialità sono i 3 criteri di questo locale atipico. Specialità di prodotti locali"
    ],
    "fr": [
      "Bistrot-Resto, café-théâtre, lieu de rencontre du village où il fait bon parler, écouter du classique et nouer des liens d'amitié. Authenticité, simplicité et convivialité sont les 3 critères de cet établissement atypique. Spécialités produits du terroir"
    ],
    "nl": [
      "Bistro-restaurant, café-theater, dorpsontmoetingsplaats waar je kunt praten, naar klassieke muziek luisteren en vrienden maken. Authenticiteit, eenvoud en gezelligheid zijn de 3 kenmerken van dit ongewone etablissement. Lokale specialiteiten"
    ],
    "es": [
      "Bistro-Resto, café-teatro, lugar de encuentro del pueblo donde es bueno hablar, escuchar música clásica y hacer amigos. Autenticidad, sencillez y convivencia son los 3 criterios de este establecimiento atípico. Especialidades de productos locales"
    ]
  },
