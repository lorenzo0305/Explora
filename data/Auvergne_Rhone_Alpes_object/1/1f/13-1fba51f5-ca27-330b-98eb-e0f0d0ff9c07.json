  "rdfs:comment": {
    "de": [
      "25m langes Hallenbad mit 29°C warmem Wasser, öffentlich zugänglich mit 1 oder 2 Schwimmerbahnen, einem Spielbereich mit Material zur freien Verfügung und einem Gesundheits-/Wellnessbereich. Mehrere Aktivitäten für Kinder ab 5 Jahren."
    ],
    "en": [
      "A covered 25 m pool heated to 29°C, open to the public with 1 or 2 lines for swimming lengths, a play area with equipment available and a health/well-being area. A range of activities organised for children for five years upwards."
    ],
    "it": [
      "Piscina coperta di 25 m con acqua riscaldata a 29°C, aperta al pubblico con 1 o 2 corsie di nuoto, un'area giochi con attrezzature a disposizione e un'area salute/benessere. Un'ampia gamma di attività è disponibile a partire dai 5 anni."
    ],
    "fr": [
      "Piscine couverte de 25m avec une eau chauffée à 29°C, ouverte au public avec 1 ou 2 lignes d’eau nageurs, un espace ludique avec matériel à disposition et un espace santé/bien être. Multiples activités proposées à partir de 5 ans."
    ],
    "es": [
      "Piscina cubierta de 25 metros con agua calentada a 29°C, abierta al público con 1 o 2 calles de natación, una zona de juegos con equipamiento disponible y una zona de salud/bienestar. A partir de los 5 años se ofrece una amplia gama de actividades."
    ],
    "nl": [
      "Overdekt zwembad van 25 m met tot 29°C verwarmd water, open voor het publiek met 1 of 2 zwembanen, een speelruimte met beschikbare toestellen en een ruimte voor gezondheid/welzijn. Een breed scala aan activiteiten is beschikbaar vanaf 5 jaar."
    ]
  },
