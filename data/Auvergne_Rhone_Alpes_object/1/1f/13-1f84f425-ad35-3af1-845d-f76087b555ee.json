  "rdfs:comment": {
    "de": [
      "2 Geschäfte haben sich zusammengeschlossen (Madame M und Ca use les souliers), um eine Auswahl an Kinder-, Herren- und Damenschuhen anzubieten.\r\nHier finden Sie auch Lederwaren und Accessoires."
    ],
    "en": [
      "2 boutiques have merged (Madame M and Ca use les souliers) to offer a choice of children's, men's and women's shoes.\r\nYou'll also find leather goods and accessories."
    ],
    "it": [
      "Benvenuti da Madame M. Situata nel cuore del centro storico, la boutique offre un'ampia gamma di scarpe per bambini, uomini e donne.\r\nTroverete anche articoli in pelle e accessori come calze e ombrelli."
    ],
    "fr": [
      "Bienvenue chez Madame M. Située au cœur du centre historique, la boutique vous propose un large choix de chaussures pour enfants, homme et femme.\r\nRetrouvez également de la maroquinerie et des accessoires tel que des chaussettes ou des parapluies."
    ],
    "es": [
      "Bienvenido a Madame M. Situada en pleno centro histórico, la boutique ofrece una amplia gama de zapatos para niños, hombres y mujeres.\r\nTambién encontrará artículos de cuero y accesorios como calcetines y paraguas."
    ],
    "nl": [
      "2 winkels zijn samengevoegd (Madame M en Ca use les souliers) en bieden nu een keuze aan kinder-, heren- en damesschoenen.\r\nJe vindt er ook lederwaren en accessoires."
    ]
  },
