  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser einzigartiges \"Villefranche-sur-Saône\", das im Herzen der Hauptstadt Beaujolais liegt und mit vier glitzernden Sternen geschmückt ist."
    ],
    "en": [
      "Discover our unique “Villefranche-sur-Saône” establishment, nestled in the heart of the Beaujolais Capital and adorned with four sparkling stars."
    ],
    "it": [
      "Scoprite la nostra struttura unica \"Villefranche-sur-Saône\", immersa nel cuore della capitale del Beaujolais e impreziosita da quattro stelle scintillanti."
    ],
    "fr": [
      "Découvrez notre établissement \"Villefranche-sur-Saône\" unique en son genre, niché au cœur de la Capitale Beaujolaise et orné de quatre étoiles scintillantes."
    ],
    "nl": [
      "Ontdek ons unieke etablissement \"Villefranche-sur-Saône\", genesteld in het hart van de hoofdstad van de Beaujolais en versierd met vier schitterende sterren."
    ],
    "es": [
      "Descubra nuestro establecimiento único \"Villefranche-sur-Saône\", enclavado en el corazón de la capital del Beaujolais y adornado con cuatro estrellas resplandecientes."
    ]
  },
