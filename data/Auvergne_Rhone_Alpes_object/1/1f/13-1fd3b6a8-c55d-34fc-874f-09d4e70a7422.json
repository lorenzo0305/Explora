  "rdfs:comment": {
    "de": [
      "Direktverkauf von Trockenkäse von Montag bis Samstag auf dem Bauernhof, denken Sie daran, Ihren Besuch telefonisch anzukündigen."
    ],
    "en": [
      "Direct sale of dry cheeses from Monday to Saturday at the farm. Don't forget to phone to let us know you're coming."
    ],
    "it": [
      "Vendita diretta di formaggi secchi dal lunedì al sabato presso la fattoria. Non dimenticate di telefonare per avvisare del vostro arrivo."
    ],
    "fr": [
      "Vente directe de fromages secs du lundi au samedi à la ferme, pensez à téléphoner pour annoncer votre venue."
    ],
    "es": [
      "Venta directa de quesos secos de lunes a sábado en la granja. No olvide avisarnos por teléfono."
    ],
    "nl": [
      "Directe verkoop van droge kazen van maandag tot zaterdag op de boerderij. Vergeet niet te bellen om te laten weten dat je komt."
    ]
