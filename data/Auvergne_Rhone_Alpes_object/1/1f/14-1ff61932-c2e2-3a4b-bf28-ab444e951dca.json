  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6714c4a6-3236-3352-a0dd-fb2169019270",
      "dc:description": {
        "de": [
          "Fahrradparade in den Farben Belgiens mit Start am Rathaus um 10:30 Uhr. Wettbewerb um das schönste Fahrrad und Überraschung bei der Ankunft. Anmeldung beim Fremdenverkehrsamt erforderlich."
        ],
        "en": [
          "Bike parade in the colors of Belgium, departing from the town hall at 10:30 am. Contest for the most beautiful bike and surprise on arrival. Registration essential at the Tourist Office."
        ],
        "it": [
          "Sfilata di biciclette con i colori del Belgio, con partenza dal municipio alle 10.30. Concorso per la bici più bella e sorpresa all'arrivo. Iscrizione obbligatoria presso l'Ufficio del Turismo."
        ],
        "fr": [
          "Véloparade aux couleurs de la Belgique au départ de la mairie à 10h30. Concours du plus beau vélo et surprise à l'arrivée. Inscription indispensable à l'Office de Tourisme."
        ],
        "nl": [
          "Fietsparade in de kleuren van België vanaf het gemeentehuis om 10.30 uur. Wedstrijd voor de mooiste fiets en verrassing bij aankomst. Inschrijving verplicht bij de Dienst voor Toerisme."
        ],
        "es": [
          "Desfile de bicicletas con los colores de Bélgica, con salida del ayuntamiento a las 10.30 horas. Concurso a la bicicleta más bonita y sorpresa a la llegada. Imprescindible inscribirse en la Oficina de Turismo."
        ]
      },
      "@type": [
        "Description"
