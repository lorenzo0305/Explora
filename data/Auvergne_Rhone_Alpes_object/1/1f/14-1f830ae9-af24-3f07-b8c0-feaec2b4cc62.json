  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8292a53d-b085-3371-8560-0a8d389d2507",
      "dc:description": {
        "de": [
          "Partner von Le Touquet-Paris-Plage In einer gemütlichen Atmosphäre mit Freunden oder der Familie.Käse- oder Wurstplatte zum Probieren, im Winter jeden Tag eine Gemüsesuppe vor Ort oder zum Mitnehmen bei einem guten Glas Wein."
        ],
        "en": [
          "Partner of Le Touquet-Paris-Plage In a cosy atmosphere for friends and family, enjoy a cheese or charcuterie board, and in winter a vegetable soup every day on the premises or to take away with a glass of wine."
        ],
        "it": [
          "Partner di Le Touquet-Paris-Plage In un'atmosfera accogliente con gli amici o la famiglia, gustate un tagliere di formaggi o salumi e, in inverno, una zuppa di verdure ogni giorno sul posto o da asporto con un bicchiere di vino."
        ],
        "fr": [
          "Partenaire du Touquet-Paris-Plage Dans une ambiance cosy entre amis ou en famille.Planche de fromage ou charcuterie à déguster, en hiver une soupe de légumes chaque jour sur place ou à emporter autour d'un bon verre de vin."
        ],
        "es": [
          "Socio de Le Touquet-Paris-Plage En un ambiente acogedor, con amigos o en familia, disfrute de una tabla de quesos o embutidos, y en invierno de una sopa de verduras todos los días en el local o para llevar con una copa de vino."
        ],
        "nl": [
          "Partner van Le Touquet-Paris-Plage Geniet in een gezellige sfeer met vrienden of familie van een kaasplankje of charcuterie, en in de winter elke dag van een groentesoep ter plaatse of om mee te nemen met een glas wijn."
        ]
      },
      "@type": [
        "Description"
