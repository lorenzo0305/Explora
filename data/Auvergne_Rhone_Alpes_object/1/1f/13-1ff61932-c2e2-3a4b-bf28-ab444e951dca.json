  "rdfs:comment": {
    "de": [
      "Das Restaurant am Col de l'Arc ist ganz nach dem Geschmack der Familie Mayousse.... herzlich!\r\nDas Restaurant bietet eine traditionelle Küche mit frischen Produkten aus der Region, wofür es Ende 2014 den Titel Maître Restaurateur erhalten hat."
    ],
    "en": [
      "The Col de l'Arc restaurant is the image of the Mayousse family.... warm!\r\nThe restaurant offers traditional cuisine, made with fresh local produce, which earned it the title of Master Restaurateur at the end of 2014."
    ],
    "it": [
      "Il ristorante Col de l'Arc è proprio come la famiglia Mayousse.... caldo e accogliente!\r\nIl ristorante offre una cucina tradizionale, a base di prodotti freschi locali, che gli è valsa il titolo di Maître Restaurateur alla fine del 2014."
    ],
    "fr": [
      "Le restaurant du Col de l'Arc est à l'image de la famille  Mayousse.... chaleureuse !\r\nLe Restaurant propose une cuisine traditionnelle, composée de produits frais et de terroir, ce qui lui a valu d'obtenir fin 2014, le titre de Maître Restaurateur."
    ],
    "nl": [
      "Het restaurant Col de l'Arc is net als de familie Mayousse .... warm!\r\nHet restaurant biedt een traditionele keuken, bereid met verse en lokale producten, wat het eind 2014 de titel Maître Restaurateur opleverde."
    ],
    "es": [
      "El restaurante Col de l'Arc es como la familia Mayousse: ¡.... cálido y acogedor!\r\nEl restaurante ofrece una cocina tradicional, elaborada con productos locales frescos, que le valió el título de Maître Restaurateur a finales de 2014."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Col de l'Arc"
    ]
  },
