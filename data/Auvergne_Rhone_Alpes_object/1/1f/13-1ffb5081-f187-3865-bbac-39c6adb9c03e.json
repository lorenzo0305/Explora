  "rdfs:comment": {
    "de": [
      "Der Verein Regenbogen bietet verschiedene Freizeitaktivitäten wie Klettern, Gesellschaftstanz, Rock & Country Dance, aber auch kreative Freizeitaktivitäten wie Patchwork sowie Zählstich."
    ],
    "en": [
      "L'Association Arc-en-ciel offers a range of leisure activities including climbing, ballroom dancing, rock & country dancing, as well as creative activities such as patchwork and counted stitch."
    ],
    "it": [
      "L'associazione Arc-en-ciel offre una serie di attività per il tempo libero, tra cui l'arrampicata, il ballo liscio, il rock e il country, oltre ad attività creative come il patchwork e il punto contato."
    ],
    "fr": [
      "L'Association Arc-en-ciel propose plusieurs activités de loisirs telles que l'escalade, la dans de salon, le Rock & la danse Country, mais aussi des activités de loisirs créatifs comme le Patchwork ainsi que le point compté."
    ],
    "es": [
      "La asociación Arc-en-ciel ofrece diversas actividades de ocio, como escalada, bailes de salón, rock y country, así como actividades creativas como patchwork y punto contado."
    ],
    "nl": [
      "De vereniging Arc-en-ciel biedt een scala aan vrijetijdsactiviteiten zoals klimmen, stijldansen, rock- en countrydansen, maar ook creatieve activiteiten zoals patchwork en telborduren."
    ]
  },
  "rdfs:label": {
