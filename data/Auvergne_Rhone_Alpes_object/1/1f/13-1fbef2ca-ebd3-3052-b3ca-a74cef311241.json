  "rdfs:comment": {
    "de": [
      "Der dritte Ort Bar Restaurant L'Aimant, bietet eine hausgemachte, leckere und saisonale Küche. Animationen, Ausstellungen das ganze Jahr über, Brunch jeden Sonntag außer in den Sommermonaten und eine Auswahl an lokalen Qualitätsprodukten."
    ],
    "en": [
      "The third-party bar-restaurant l'Aimant offers home-cooked, gourmet, seasonal cuisine. Events and exhibitions throughout the year, brunch every Sunday except in summer, and a selection of quality local produce."
    ],
    "it": [
      "Il terzo bar-ristorante l'Aimant propone una cucina casalinga, gourmet e stagionale. Eventi e mostre durante tutto l'anno, brunch tutte le domeniche tranne in estate e una selezione di prodotti locali di qualità."
    ],
    "fr": [
      "Le tiers lieu bar restaurant l'Aimant, propose une cuisine maison, gourmande et de saison. Des animations, des expositions tout au long de l'année, le brunch chaque dimanche sauf en période estivale et une sélection de produits locaux de qualité."
    ],
    "nl": [
      "Het bar-restaurant l'Aimant van derden serveert huisgemaakte, gastronomische seizoensgerechten. Evenementen en tentoonstellingen gedurende het hele jaar, brunch elke zondag behalve in de zomer, en een selectie van lokale kwaliteitsproducten."
    ],
    "es": [
      "El bar-restaurante l'Aimant, abierto a terceros, sirve cocina casera, gastronómica y de temporada. Eventos y exposiciones durante todo el año, brunch todos los domingos excepto en verano y una selección de productos locales de calidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Aimant"
    ]
  },
