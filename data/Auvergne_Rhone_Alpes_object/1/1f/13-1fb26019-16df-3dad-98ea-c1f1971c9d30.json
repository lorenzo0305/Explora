  "rdfs:comment": {
    "de": [
      "Sport, Geselligkeit... und Solidarität sind die Schlüsselbegriffe der Ronde des Pâquerettes. Nehmen Sie an den verschiedenen Wanderungen (zu Fuß, mit dem Fahrrad oder Mountainbike) teil, die am Wochenende angeboten werden."
    ],
    "en": [
      "Sport, conviviality... and solidarity are the watchwords of the Ronde des Pâquerettes. Come and take part in the various hikes, bike rides and mountain bike tours on offer over the weekend."
    ],
    "it": [
      "Sport, convivialità... e solidarietà sono le parole d'ordine della Ronde des Pâquerettes. Venite a partecipare alle varie passeggiate a piedi, in bicicletta e in mountain bike proposte durante il fine settimana."
    ],
    "fr": [
      "Sport, convivialité... et solidarité sont les maîtres mots de la Ronde des Pâquerettes. Venez participer aux différentes randos (à pied, cyclo ou VTT) proposées dans le week-end."
    ],
    "nl": [
      "Sport, gezelligheid... en solidariteit zijn de sleutelwoorden van de Ronde des Pâquerettes. Kom en neem deel aan de verschillende wandelingen, fietstochten en mountainbiketochten die tijdens het weekend worden aangeboden."
    ],
    "es": [
      "Deporte, convivencia... y solidaridad son las consignas de la Ronde des Pâquerettes. Participe en las diferentes marchas a pie, en bicicleta o en BTT que se propondrán durante el fin de semana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La « Ronde des Pâquerettes » - 9ème édition"
    ]
  },
