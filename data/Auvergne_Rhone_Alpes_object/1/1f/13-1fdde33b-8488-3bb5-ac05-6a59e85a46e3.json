  "rdfs:comment": {
    "de": [
      "Die irische Bar Le Dixie bietet eine große Auswahl an Bieren vom Fass, Guinness, Weinen, Spirituosen, Cidre und Tapas..\r\nLive-Übertragung von Fußball-, Rugby- und Boxspielen.\r\nRegelmäßig Live-Musik (Dixie Micks).\r\nStimmung garantiert!"
    ],
    "en": [
      "The Dixie, Irish bar offers a large selection of draft beers, Guinness, wines, spirits, ciders and tapas…\r\nLive broadcast of football, rugby and boxing matches.\r\nRegular live music (Dixie Micks).\r\nAmbiance guaranteed!"
    ],
    "it": [
      "Il Dixie, bar irlandese, offre un'ampia selezione di birre alla spina, Guinness, vini, liquori, sidri e tapas?\r\nPartite di calcio, rugby e boxe in diretta.\r\nMusica dal vivo regolarmente (Dixie Micks).\r\nAtmosfera garantita!"
    ],
    "fr": [
      "Le Dixie, bar irlandais propose une grande sélection de bières pression, Guinness, vins, spiritueux, cidres et tapas…\r\nDiffusion des rencontres de football, rugby et boxe en direct.\r\nMusique live régulièrement (Dixie Micks).\r\nAmbiance assurée !"
    ],
    "es": [
      "El Dixie, un bar irlandés, ofrece una amplia selección de cervezas de barril, Guinness, vinos, licores, sidras y tapas..\r\nPartidos de fútbol, rugby y boxeo en directo.\r\nMúsica en vivo regularmente (Dixie Micks).\r\n¡Atmósfera garantizada!"
    ],
    "nl": [
      "De Dixie Irish bar biedt een ruime keuze aan tapbieren, Guinness, wijnen, sterke dranken, ciders en tapas...\r\nLive-uitzendingen van voetbal-, rugby- en bokswedstrijden.\r\nRegelmatig live muziek (Dixie Micks).\r\nSfeer gegarandeerd!"
    ]
  },
