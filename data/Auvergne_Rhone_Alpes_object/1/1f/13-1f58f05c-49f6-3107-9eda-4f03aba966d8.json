  "rdfs:comment": {
    "de": [
      "Haus eines Notars, das an der Fassade Spuren der gotischen und Renaissance-Architektur zeigt. Es besitzt zwei wunderschöne Sprossenfenster im ersten Stock, ein drittes fehlt und muss restauriert werden."
    ],
    "en": [
      "A nobleman's house with traces of Gothic and Renaissance architecture on the facade. It features two magnificent mullioned windows on the second floor, with a third missing and in need of restoration."
    ],
    "it": [
      "Una casa notevole con tracce di architettura gotica e rinascimentale sulla facciata. Ha due magnifiche bifore al primo piano, con una terza mancante e da restaurare."
    ],
    "fr": [
      "Maison de notable qui montre en façade des traces d'architecture Gothique et Renaissance. Elle possède deux magnifiques fenêtres à meneaux au premier étage, une troisième manque devant être restaurée."
    ],
    "es": [
      "Una casa notable con restos de arquitectura gótica y renacentista en la fachada. Tiene dos magníficas ventanas ajimezadas en el primer piso, con una tercera desaparecida y que necesita ser restaurada."
    ],
    "nl": [
      "Een huis van een edelman met sporen van gotische en renaissance architectuur op de gevel. Het heeft twee prachtige glas-in-loodramen op de eerste verdieping, waarvan een derde ontbreekt en gerestaureerd moet worden."
    ]
  },
