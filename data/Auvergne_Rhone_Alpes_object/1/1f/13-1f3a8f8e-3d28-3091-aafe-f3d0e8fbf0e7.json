  "rdfs:comment": {
    "de": [
      "Eine jubelnde Komödie mit verblüffenden Schauspielern, in der ein Tête-à-Tête hinter verschlossenen Türen zwischen einem zänkischen Philosophen und einem vernünftigen Fensterladenmaler alle Gewissheiten über den Haufen werfen wird."
    ],
    "en": [
      "A jubilant comedy with amazing actors, in which a tête-à-tête behind closed doors between a cantankerous philosopher and a common-sense shutter painter overturns all certainties."
    ],
    "it": [
      "Una commedia esilarante con un cast sorprendente, in cui un tête-à-tête a porte chiuse tra un filosofo scorbutico e un pittore di persiane di buon senso ribalta tutte le certezze."
    ],
    "fr": [
      "Une comédie jubilatoire et des acteurs stupéfiants où un tête à tête à huis clos entre un philosophe acariâtre et un peintre de volets plein de bon sens vont bousculer toutes les certitudes."
    ],
    "es": [
      "Una jubilosa comedia protagonizada por un reparto asombroso, en la que un tête-à-tête a puerta cerrada entre un filósofo cascarrabias y un pintor de persianas con sentido común trastoca todas las certezas."
    ],
    "nl": [
      "Een jubelende komedie met een verbazingwekkende cast, waarin een tête-à-tête achter gesloten deuren tussen een chagrijnige filosoof en een nuchtere sluiter-schilder alle zekerheden doet kantelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pièce théâtre : \"L'opposé du contraire\""
    ]
  },
