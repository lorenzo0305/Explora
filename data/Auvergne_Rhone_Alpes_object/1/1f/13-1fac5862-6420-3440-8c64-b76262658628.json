  "rdfs:comment": {
    "de": [
      "Mariam (Mali): Auf der Bühne eine talentierte Frau, im Leben eine Clanführerin, inspirierend und charismatisch - Mariam schickt sich einmal mehr an, der Welt zu zeigen, dass unvermeidliche Traurigkeit sich in Schönheit verwandeln kann."
    ],
    "en": [
      "Mariam (Mali): A talented woman on stage, a clan leader in life, inspiring and charismatic, Mariam is once again preparing to show the world that inevitable sadness can be transformed into beauty."
    ],
    "it": [
      "Mariam (Mali): donna di talento sul palcoscenico, leader di un clan nella vita, ispiratrice e carismatica, Mariam si prepara ancora una volta a dimostrare al mondo che l'inevitabile tristezza può essere trasformata in bellezza."
    ],
    "fr": [
      "Mariam (Mali) : Femme de talent à la scène, cheffe de clan à la vie, inspirante et charismatique, Mariam s'apprête une fois de plus à montrer au monde que les tristesses inévitables peuvent se transformer en beauté."
    ],
    "nl": [
      "Mariam (Mali): Een getalenteerde vrouw op het podium, een clanleider in het leven, inspirerend en charismatisch. Mariam maakt zich opnieuw op om de wereld te laten zien dat onvermijdelijk verdriet kan worden getransformeerd in schoonheid."
    ],
    "es": [
      "Mariam (Malí): Mujer de talento sobre el escenario, líder de un clan en la vida, inspiradora y carismática, Mariam se dispone una vez más a mostrar al mundo que la tristeza inevitable puede transformarse en belleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musique du Monde - Mariam"
    ]
  },
