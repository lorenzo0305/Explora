  "rdfs:comment": {
    "de": [
      "Fünf charmante Zimmer im Herzen eines alten, hochgelegenen Dorfes in der Drôme Provençale. Restauration mit traditioneller Küche der Saison oder à la carte. Kostenloses WLAN an der Bar und mediterran und provenzalisch orientierte Küche."
    ],
    "en": [
      "Discover our 5 bedrooms in the heart of an old perched village in Drôme provençale. Traditional and seasonal cooking or on the menu."
    ],
    "it": [
      "Cinque camere di charme nel cuore di un antico villaggio arroccato della Drôme provenzale. Cucina tradizionale stagionale o à la carte, wifi gratuito al bar e cucina mediterranea e provenzale."
    ],
    "fr": [
      "Cinq chambres de charme au cœur d'un vieux village perché de Drôme provençale. Restauration de cuisine traditionnelle de saison ou à la carte. wifi disponible gratuitement au bar et cuisine à orientation méditerranéenne et Provençale."
    ],
    "nl": [
      "Vijf charmante kamers in het hart van een oud dorp op een heuvel in de Drôme provençale. Traditionele seizoenskeuken of à la carte. Gratis wifi aan de bar en mediterrane en Provençaalse keuken."
    ],
    "es": [
      "Cinco habitaciones con encanto en el corazón de un antiguo pueblo encaramado en la Drôme provenzal. Cocina tradicional de temporada o a la carta. Wifi gratuito en el bar y cocina mediterránea y provenzal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant le Globe"
    ]
  },
