  "rdfs:comment": {
    "de": [
      "Ein auvergnatisches Haus im Herzen des Betriebs wurde zu einem gemütlichen Gasthaus umgebaut. Sabine und Christophe bieten Ihnen dort \"cantalous\" Gerichte an. Reservierung erforderlich."
    ],
    "en": [
      "An Auvergne house in the heart of the farm has been renovated into a cosy inn. Sabine and Christophe serve \"cantalous\" dishes. Reservations required."
    ],
    "it": [
      "Una casa dell'Alvernia nel cuore della fattoria è stata ristrutturata e trasformata in un'accogliente locanda. Sabine e Christophe saranno lieti di servirvi piatti cantali. Prenotazione obbligatoria."
    ],
    "fr": [
      "Une maison auvergnate située au cœur de l'exploitation a été rénovée en une chaleureuse auberge. Sabine et Christophe vous y proposent des plats \"cantalous\". Réservation obligatoire."
    ],
    "es": [
      "Una casa de Auvernia en el corazón de la granja ha sido renovada en una acogedora posada. Sabine y Christophe estarán encantados de servirle platos cantalineses. Imprescindible reservar."
    ],
    "nl": [
      "Een huis uit de Auvergne in het hart van de boerderij is gerenoveerd tot een gezellige herberg. Sabine en Christophe serveren je met plezier Cantaliense gerechten. Reserveren is noodzakelijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Auberge les Arbres"
    ]
  },
