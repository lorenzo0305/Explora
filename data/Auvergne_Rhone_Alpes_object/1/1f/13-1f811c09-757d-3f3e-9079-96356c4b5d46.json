          "additionalInformation": {
            "de": [
              "-Vom 21. April bis 07. Juli: Samstagabend und Sonntagmittag geöffnet.\r\n-Vom 08. Juli bis 31. August: Dienstagabend bis Sonntagmittag geöffnet.\r\n-Vom 01. bis 15. September: Mittwoch bis Sonntag nur mittags geöffnet.\r\n- Vom 23. September bis zum 1. November: Samstagabend und Sonntagmittag geöffnet."
            ],
            "en": [
              "-April 21 to July 07: open Saturday evening and Sunday lunchtime.\r\n-July 08 to August 31: open Tuesday evening to Sunday lunchtime.\r\n-September 1 to 15: open for lunch only from Wednesday to Sunday.\r\n- September 23 to November 1: open Saturday evening and Sunday lunchtime."
            ],
            "it": [
              "-Dal 21 aprile al 07 luglio: aperto il sabato sera e la domenica a pranzo.\r\n-Dall'08 luglio al 31 agosto: aperto dal martedì sera alla domenica a pranzo.\r\n-Dal 1° al 15 settembre: aperto solo a pranzo dal mercoledì alla domenica.\r\n- Dal 23 settembre al 1° novembre: aperto il sabato sera e la domenica a pranzo."
            ],
            "fr": [
              "-Du 21 avril au 07 juillet : ouvert samedi soir et dimanche midi.\r\n-Du 08 juillet au 31 août : ouvert du mardi soir au dimanche midi.\r\n-Du 1er au 15 septembre : ouvert les midi uniquement du mercredi au dimanche.\r\n- Du 23 septembre au 1er novembre : ouvert samedi soir et dimanche midi."
            ],
            "nl": [
              "-Van 21 april tot 07 juli: open op zaterdagavond en zondagmiddag.\r\n-Van 08 juli tot 31 augustus: geopend van dinsdagavond tot zondagmiddag.\r\n-Van 1 tot 15 september: alleen open voor lunch van woensdag tot zondag.\r\n- Van 23 september tot 1 november: open op zaterdagavond en zondagmiddag."
            ],
            "es": [
              "-Del 21 de abril al 7 de julio: abierto los sábados por la noche y los domingos al mediodía.\r\n-Del 8 de julio al 31 de agosto: abierto de martes por la noche a domingo al mediodía.\r\n-Del 1 al 15 de septiembre: abierto sólo para almuerzos de miércoles a domingo.\r\n- Del 23 de septiembre al 1 de noviembre: abierto los sábados por la noche y los domingos al mediodía."
            ]
          },
