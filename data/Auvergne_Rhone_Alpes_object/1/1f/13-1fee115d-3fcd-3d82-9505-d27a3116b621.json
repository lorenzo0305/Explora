  "rdfs:comment": {
    "de": [
      "Zwei Hektar große, teilweise schattige Wasserfläche in der Nähe der Ortschaft Bellenaves. Der Platz trägt das Gütesiegel \"Parcours famille\" (Familienstrecke). Bundesfischereischeine oder interdepartementale Fischereischeine sind erforderlich, Zugang im Internet unter carte de peche.fr."
    ],
    "en": [
      "A pond of 2ha near to Bellenaves , partly shaded and laveled \" family walk\""
    ],
    "it": [
      "Un lago di due ettari parzialmente ombreggiato vicino al villaggio di Bellenaves. Il sito ha ottenuto il marchio \"Sentiero delle famiglie\". È necessaria una carta di pesca federale o interdipartimentale, disponibile online su carte de peche.fr."
    ],
    "fr": [
      "Plan d'eau de deux hectares partiellement ombragé à proximité du bourg de Bellenaves. Le site est labellisé \"Parcours famille\". Cartes de pêches fédérales ou interdépartementale obligatoire, accessible par internet sur carte de peche.fr."
    ],
    "es": [
      "Un lago de dos hectáreas parcialmente sombreado cerca del pueblo de Bellenaves. El lugar ha obtenido la etiqueta \"Sendero Familiar\". Se requiere tarjeta de pesca federal o interdepartamental, disponible en línea en carte de peche.fr."
    ],
    "nl": [
      "Een meer van twee hectare dat gedeeltelijk in de schaduw ligt in de buurt van het dorp Bellenaves. De site heeft het label \"Familiepad\" gekregen. Federale of interdepartementale viskaarten vereist, online verkrijgbaar op carte de peche.fr."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pond"
    ],
    "fr": [
      "Plan d'eau"
    ]
  },
