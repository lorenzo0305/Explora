  "rdfs:comment": {
    "de": [
      "Exklusive Osteopathin, die seit 2005 über ein Diplom der European School of Osteopathy verfügt.\r\nIch praktiziere strukturelle und/oder funktionelle Osteopathie, die auf die Patienten je nach Alter zugeschnitten ist und für jedes Alter geeignet ist.\r\nFluent in spoken English."
    ],
    "en": [
      "Osteopath. European School of Osteopathy degree holder since 2005.\r\nStructural and/or functional osteopathy adapted to patients of all ages."
    ],
    "it": [
      "Osteopata esclusivo, si è diplomato alla Scuola Europea di Osteopatia nel 2005.\r\nPratico un'osteopatia strutturale e/o funzionale adattata ai pazienti in base alla loro età e per tutte le età.\r\nInglese fluente e parlato."
    ],
    "fr": [
      "Ostéopathe exclusive diplômée de l'European School of Osteopathy depuis 2005.\r\nJe pratique une ostéopathie structurelle et/ou fonctionnelle adaptée aux patients selon leur âge et pour tout âge.\r\nFluent in spoken English."
    ],
    "es": [
      "Osteópata exclusivo graduado en la Escuela Europea de Osteopatía en 2005.\r\nPractico la osteopatía estructural y/o funcional adaptada a los pacientes según su edad y para todas las edades.\r\nDominio del inglés hablado."
    ],
    "nl": [
      "Gediplomeerde osteopate van de Europese School van Osteopatie sinds 2005. Ik beoefen structurele osteopatie en/of aangepaste functies voor patienten."
    ]
  },
