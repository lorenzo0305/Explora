  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch das Dorfzentrum von Allevard, um die Markierungen zu entdecken, die in der Nähe historischer Orte angebracht wurden."
    ],
    "en": [
      "Using your map, navigate your way through the heart of the village of Allevard to find the markers that have been placed near historic sites."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, muovetevi nel cuore del villaggio di Allevard per scoprire i segnalatori che sono stati installati vicino ai siti storici."
    ],
    "fr": [
      "A l’aide de votre carte, déplacez-vous au cœur du village d’Allevard pour découvrir les balises qui ont été installées à proximité des lieux historiques."
    ],
    "es": [
      "Con la ayuda de su mapa, muévase por el corazón del pueblo de Allevard para descubrir los marcadores que se han instalado cerca de los lugares históricos."
    ],
    "nl": [
      "Baan je met behulp van je kaart een weg door het hart van het dorp Allevard om de markeringen te ontdekken die bij historische plekken zijn aangebracht."
    ]
  },
  "rdfs:label": {
