  "rdfs:comment": {
    "de": [
      "Traditionelle Küche. Die Brasserie bietet Ihnen ein Tagesgericht, Menüs im Rhythmus der Jahreszeiten, Salate, Gegrilltes, garnierte Entrecôtes. Schöne Eiskarte\r\nBehindertengerechte Toiletten."
    ],
    "en": [
      "Brasserie food, traditional cooking, daily specials. \r\nMenus vary with the seasons.\r\nSalads, grilled meats, rib steaks with all the trimmings.\r\nGood selection of ice-cream.\r\nWheelchair access.\r\nKaraoke. \r\nEnglish spoken."
    ],
    "it": [
      "Cucina tradizionale. La Brasserie offre un piatto del giorno, menù stagionali, insalate, carni alla griglia, costine guarnite. Bel menu di gelati\r\nServizi igienici accessibili alle persone con mobilità ridotta."
    ],
    "fr": [
      "Cuisine traditionnelle. La Brasserie vous propose un plat du jour, des menus au rythme des saisons, des salades, grillades, entrecôtes garnies. Belle carte de glaces. \r\nToilettes accessibles aux personnes à mobilité réduite."
    ],
    "nl": [
      "Traditionele keuken. De Brasserie biedt u een dagschotel, seizoensmenu's, salades, gegrild vlees, gegarneerde ribbetjes. Leuk ijsmenu\r\nToiletten toegankelijk voor personen met beperkte mobiliteit."
    ],
    "es": [
      "Cocina tradicional. La Brasserie ofrece un plato del día, menús de temporada, ensaladas, carnes a la parrilla, costillas con guarnición. Buen menú de helados\r\nAseos accesibles para personas con movilidad reducida."
    ]
  },
