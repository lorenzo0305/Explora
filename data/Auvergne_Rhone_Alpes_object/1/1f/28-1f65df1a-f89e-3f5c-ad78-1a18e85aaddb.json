  "rdfs:comment": {
    "de": [
      "V and B Weinkeller und Bar\n\nWir sind von Montag 15 Uhr bis Samstag geöffnet\n\nVermietung von Zapfanlagen\nVerkostungen\nThemenabende\n\nWir freuen uns, Sie begrüßen zu dürfen"
    ],
    "en": [
      "V and B Cave and Bar\n\nWe are open from Monday 3pm to Saturday\n\nRental of taffy\nTastings\nTheme evenings\n\nWe look forward to welcoming you"
    ],
    "it": [
      "Grotta e Bar V e B\n\nSiamo aperti dal lunedì alle 15.00 al sabato\n\nNoleggio Taffy\nDegustazioni\nSerate a tema\n\nSaremo lieti di darvi il benvenuto"
    ],
    "fr": [
      "V and B Cave et Bar\n\nNous sommes ouverts du lundi 15h au samedi\n\nLocation de tireuse\nDégustations\nSoirée à thèmes\n\nAu plaisir de vous accueillir"
    ],
    "nl": [
      "V en B Grot en Bar\n\nWij zijn geopend van maandag 15.00 uur tot zaterdag\n\nTaffy huren\nProeverijen\nThema-avonden\n\nWe kijken ernaar uit u te verwelkomen"
    ],
    "es": [
      "Cueva y Bar V y B\n\nEstamos abiertos desde el lunes a las 15:00 hasta el sábado\n\nAlquiler de Taffy\nDegustaciones\nVeladas temáticas\n\nEstamos deseando darle la bienvenida"
    ]
  },
