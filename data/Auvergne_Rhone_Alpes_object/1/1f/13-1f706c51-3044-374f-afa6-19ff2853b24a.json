  "rdfs:comment": {
    "de": [
      "Verleih und Reparatur von Fahrrädern.\r\nEntdecken Sie die Ardèche mit Cyclo'bogue!\r\nErkunden Sie die Region Les Boutières ganz einfach und umweltfreundlich mit unseren Fahrrädern mit elektrischer Unterstützung."
    ],
    "en": [
      "Bike rental and repair.\r\nDiscover the Ardèche with Cyclo'bogue!\r\nExplore the Boutières region easily and ecologically with our electrically-assisted bikes."
    ],
    "it": [
      "Noleggio e riparazione di biciclette.\r\nScoprite l'Ardèche con Cyclo'bogue!\r\nEsplorate la regione delle Boutières in modo semplice ed ecologico con le nostre biciclette a pedalata assistita."
    ],
    "fr": [
      "Location et réparation de vélos.\r\nDécouvrez l'Ardèche avec Cyclo'bogue !\r\nExplorez la région des Boutières facilement et de manière écologique avec nos vélos à assistance électrique."
    ],
    "nl": [
      "Verhuur en reparatie van fietsen.\r\nOntdek de Ardèche met Cyclo'bogue!\r\nVerken de Boutières op een gemakkelijke en ecologische manier met onze elektrisch ondersteunde fietsen."
    ],
    "es": [
      "Alquiler y reparación de bicicletas.\r\n¡Descubra la Ardèche con Cyclo'bogue!\r\nExplore la región de Boutières de forma fácil y ecológica con nuestras bicicletas con asistencia eléctrica."
    ]
  },
