  "rdfs:comment": {
    "de": [
      "Die Einrichtung \"Le P'tit Bo Bar\" und ihr Team empfangen Sie in einer freundlichen und herzlichen Umgebung an der Schneefront von Plagne Centre."
    ],
    "en": [
      "The \"P'tit Bo Bar\" and its team are delighted to welcome you to their convivial and cosy establishment at the bottom of the slopes in Plagne Centre."
    ],
    "it": [
      "Il \"Le P'tit Bo Bar\" e il suo team vi accolgono in un ambiente caldo e accogliente sul fronte neve di Plagne Centre."
    ],
    "fr": [
      "L'établissement \"Le P'tit Bo Bar\" et son équipe vous accueillent dans un cadre convivial et chaleureux sur le front de neige de Plagne Centre."
    ],
    "nl": [
      "Het etablissement \"Le P'tit Bo Bar\" en zijn team verwelkomen je in een warme en gezellige omgeving op het sneeuwfront van Plagne Centre."
    ],
    "es": [
      "El establecimiento \"Le P'tit Bo Bar\" y su equipo le dan la bienvenida a un entorno cálido y acogedor en el frente de nieve de Plagne Centre."
    ]
  },
