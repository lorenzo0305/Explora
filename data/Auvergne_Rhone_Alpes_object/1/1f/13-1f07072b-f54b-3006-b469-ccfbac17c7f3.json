  "rdfs:comment": {
    "de": [
      "Das Auditorium ist ein Veranstaltungssaal, in dem verschiedene Veranstaltungen stattfinden können, z. B. Konzerte, Kinovorstellungen, Theater (leichte Kulissen), Generalversammlungen, Konferenzen, Kongresse, verschiedene kleine Aufführungen..."
    ],
    "en": [
      "The Auditorium is an auditorium that can host various events such as concerts, film screenings, theatre (light sets), general meetings, conferences, congresses, various small shows ..."
    ],
    "it": [
      "L'Auditorium è una sala che può ospitare vari eventi come concerti, proiezioni di film, teatro (scenografie leggere), assemblee generali, conferenze, congressi, piccoli spettacoli, ecc."
    ],
    "fr": [
      "L' Auditorium est une salle de spectacles pouvant accueillir diverses manifestations telles que concerts, séances de cinéma, théâtre (décors légers), assemblées générales, conférences, congrès, petits spectacles divers..."
    ],
    "nl": [
      "Het Auditorium is een zaal waar diverse evenementen kunnen plaatsvinden, zoals concerten, filmvoorstellingen, theater (licht decor), algemene vergaderingen, conferenties, congressen, diverse kleine voorstellingen, enz."
    ],
    "es": [
      "El Auditorio es un auditorio que puede acoger diversos actos como conciertos, proyecciones de películas, teatro (escenografía ligera), asambleas generales, conferencias, congresos, pequeños espectáculos diversos, etc."
    ]
