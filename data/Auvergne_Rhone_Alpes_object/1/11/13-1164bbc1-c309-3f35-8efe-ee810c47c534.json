  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von der Süße unserer Produkte aus Schafsmilch (Joghurt, Brebichous, aromatisierte Brebichous, Tomme und Wurst) verführen. Sehen Sie sich einen Film an, der einen typischen Tag auf dem Bauernhof wiedergibt."
    ],
    "en": [
      "Let yourself be tempted by the sweetness of our ewe's milk products (yoghurts, brebichous, flavoured brebichous, tommettes, tommes and sausages). Watch a film about a typical day on the farm."
    ],
    "it": [
      "Lasciatevi tentare dalla dolcezza dei nostri prodotti a base di latte di pecora (yogurt, brebichous, brebichous aromatizzati, tommettes, tommes e salsicce). Guardate un filmato che mostra una tipica giornata in fattoria."
    ],
    "fr": [
      "Laissez-vous tenter par la douceur de nos produits au lait de brebis (yaourts, brebichous, brebichous aromatisés, tommettes, tommes et saucissons). Découvrez un film reprenant une journée type à la ferme."
    ],
    "nl": [
      "Laat je verleiden door de zoetheid van onze producten van schapenmelk (yoghurt, brebichous, gearomatiseerde brebichous, tommettes, tommes en worstjes). Bekijk een film over een typische dag op de boerderij."
    ],
    "es": [
      "Déjese tentar por la dulzura de nuestros productos lácteos de oveja (yogures, brebichous, brebichous aromatizados, tommettes, tommes y salchichas). Vea una película que muestra un día típico en la granja."
    ]
  },
  "rdfs:label": {
    "de": [
      "GAEC Schafstall von 2 savoies"
    ],
    "en": [
      "GAEC Sheepfold of the 2 Savoies"
    ],
    "fr": [
      "Bergerie des 2 Savoie"
    ],
    "nl": [
      "Schaapskooi van de 2 Savoys"
    ]
  },
