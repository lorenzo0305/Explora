  "rdfs:comment": {
    "de": [
      "Le Chenaillon bietet Ihnen jeden Tag seine Spezialitäten aus Beaujolais und der Saison an. Unter der Woche: Tagesmenü. Teestube (Eis, hausgemachtes Gebäck). Frühstück."
    ],
    "en": [
      "Le Chenaillon offers you every day its Beaujolais and seasonal specialities. During the week: menu of the day. Tea room (ice creams, home-made pastries). Breakfast is served."
    ],
    "it": [
      "Le Chenaillon vi offre ogni giorno il suo Beaujolais e le sue specialità stagionali. Durante la settimana: menù del giorno. Sala da tè (gelati, dolci fatti in casa). La colazione è disponibile."
    ],
    "fr": [
      "Le Chenaillon vous propose tous les jours ses spécialités beaujolaises et de saison. En semaine : menu du jour. Salon de thé (glaces, pâtisseries maison). Petit-déjeuner."
    ],
    "es": [
      "Le Chenaillon le ofrece cada día su Beaujolais y sus especialidades de temporada. Durante la semana: menú diario. Salón de té (helados, bollería casera). El desayuno está disponible."
    ],
    "nl": [
      "Le Chenaillon biedt dagelijks specialiteiten uit de Beaujolais en van het seizoen. Tijdens de week: dagmenu. Theesalon (ijs, zelfgemaakt gebak). Ontbijt is beschikbaar."
    ]
  },
