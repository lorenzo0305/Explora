  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6c432a33-0113-3abc-a879-9ecab3150f4f",
      "dc:description": {
        "de": [
          "Karnevalsparty\nOrganisiert von der Jugendabteilung\nVerkleidet von 14:30 bis 17:00 Uhr im Funhouse\nBuntes Buffet Animationen Musik Wahlen der schönsten Kostüme und Überraschungen\nSamstag, 17. Februar, Espace Malraux, von 14:00 bis 16:30 Uhr\nVerkleidungen/Spiele/Tanz/Imbiss\n\nKostenlos, Kinder von der ersten bis zur vierten Klasse"
        ],
        "en": [
          "Carnival Party\nOrganized by Youth Services\nDisguised from 2:30 pm to 5:00 pm at the Funhouse\nColorful buffet, entertainment, music, elections for best costumes and surprises\nSaturday, February 17, Espace Malraux, 2pm to 4:30pm\nDisguises/Games/Dance/Snacks\n\nFree for children from CP to CM2"
        ],
        "it": [
          "Festa di Carnevale\nOrganizzata dal Dipartimento della Gioventù\nIn maschera dalle 14.30 alle 17.00 presso la Casa del divertimento\nBuffet colorato, musica, elezioni in maschera e sorprese\nSabato 17 febbraio, Espace Malraux, dalle 14.00 alle 16.30\nGiochi in maschera/Danza/Spuntini\n\nGratuito per i bambini da CP a CM2"
        ],
        "fr": [
          "Carnaval Party\nOrganisé par le service jeunesse\nDéguisé de 14h30 à 17h00 à la Funhouse\nBuffet coloré animations musique élections des plus beaux costumes et surprises\nSamedi 17 février, Espace Malraux, de 14h à 16h30\nDéguisements/Jeux/Danse/Goûter\n\nGratuit, enfants du CP au CM2"
        ],
        "es": [
          "Fiesta de Carnaval\nOrganizada por el Departamento de Juventud\nCon disfraces de 14.30 a 17.00 h en el Funhouse\nBuffet colorido, música, elecciones de disfraces y sorpresas\nSábado 17 de febrero, Espace Malraux, de 14.00 a 16.30 h\nDisfraces/juegos/baile/merienda\n\nGratis para los niños de CP a CM2"
        ],
        "nl": [
          "Carnavalsfeest\nGeorganiseerd door de jeugdafdeling\nVerkleed van 14.30 tot 17.00 uur in het Funhouse\nKleurrijk buffet, muziek, verkleedverkiezingen en verrassingen\nZaterdag 17 februari, Espace Malraux, 14u tot 16u30\nVerkleedkleding/Spelletjes/Dans/Hapjes\n\nGratis voor kinderen van CP tot CM2"
        ]
      },
