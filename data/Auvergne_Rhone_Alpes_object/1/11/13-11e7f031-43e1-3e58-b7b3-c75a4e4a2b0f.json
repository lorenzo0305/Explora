  "rdfs:comment": {
    "de": [
      "Als Zwillingsbruder des Stadtparks Bangr Wéegoo in der Hauptstadt Burkina Fasos ist der Park Ouagadougou ein Ort der Entspannung und Entdeckung, an dem sich jeder auf einzigartige Weise dem Wasser und der Natur in der Stadt nähern kann."
    ],
    "en": [
      "The twin brother of the Bangr Wéegoo urban park in Burkina Faso's capital, Parc Ouagadougou is a place for relaxation and discovery, where everyone can get closer to water and nature in the city."
    ],
    "it": [
      "Gemello del parco urbano di Bangr We?egoo, nella capitale del Burkina Faso, il parco di Ouagadougou è un luogo di relax e di scoperta dove tutti possono vivere l'acqua e la natura in città in modo unico."
    ],
    "fr": [
      "Frère jumeau du parc urbain Bangr Wéegoo de la capitale burkinabé, le parc Ouagadougou est un lieu de détente et de découverte où chacun peut approcher singulièrement l’eau et la nature en ville."
    ],
    "nl": [
      "Ouagadougou Park, een zusterpark van het Bangr We?egoo stadspark in de hoofdstad van Burkina Faso, is een plek van ontspanning en ontdekking waar iedereen het water en de natuur in de stad op een unieke manier kan beleven."
    ],
    "es": [
      "Hermano gemelo del parque urbano Bangr Wéegoo de la capital de Burkina Faso, el parque de Uagadugú es un lugar de relajación y descubrimiento donde todos pueden acercarse al agua y a la naturaleza de la ciudad."
    ]
  },
