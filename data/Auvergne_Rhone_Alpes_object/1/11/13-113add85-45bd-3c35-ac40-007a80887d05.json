  "rdfs:comment": {
    "de": [
      "Im Restaurant des Hotels La Benoite in Salles Arbuissonnas bietet Ihnen unser Chefkoch eine hausgemachte regionale Küche mit einigen Spezialitäten und Produkten, die möglichst kurze Wege nutzen."
    ],
    "en": [
      "At the restaurant of the hotel la Benoite in Salles Arbuissonnas, our chef offers you a homemade local cuisine with some specialities and products using local distribution networks as much as possible."
    ],
    "it": [
      "Nel ristorante dell'hotel la Benoite a Salles Arbuissonnas, il nostro chef vi propone una cucina locale fatta in casa con alcune specialità e prodotti che utilizzano il più possibile circuiti brevi."
    ],
    "fr": [
      "Au restaurant de l'hôtel la Benoite à Salles Arbuissonnas, notre chef vous propose une cuisine maison de terroir avec quelques spécialités et des produits utilisant le plus possible des circuits court."
    ],
    "nl": [
      "In het restaurant van het hotel la Benoite in Salles Arbuissonnas biedt onze chef u een huisgemaakte lokale keuken met enkele specialiteiten en producten waarbij zoveel mogelijk gebruik wordt gemaakt van korte circuits."
    ],
    "es": [
      "En el restaurante del hotel la Benoite en Salles Arbuissonnas, nuestro chef le ofrece una cocina local casera con algunas especialidades y productos utilizando en lo posible circuitos cortos."
    ]
  },
