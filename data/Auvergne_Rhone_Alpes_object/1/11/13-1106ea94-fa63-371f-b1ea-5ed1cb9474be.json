  "rdfs:comment": {
    "de": [
      "Aufruf an alle Geisterjäger! Seit einiger Zeit treten während der Führungen durch Valencia paranormale Phänomene auf: Gegenstände, die auftauchen,\r\nseltsame Geräusche, Botschaften... Ein Medium hat uns auf die Anwesenheit zahlreicher Geister hingewiesen."
    ],
    "en": [
      "Calling all ghost hunters! For some time now, paranormal phenomena have been occurring during guided tours of Valencia: objects appearing,\r\nstrange sounds, messages... A medium has indicated the presence of many ghosts."
    ],
    "it": [
      "Appello a tutti i cacciatori di fantasmi! Da qualche tempo, durante le visite guidate a Valencia si verificano fenomeni paranormali: apparizione di oggetti,\r\nstrani suoni, messaggi... Una medium ha segnalato la presenza di molti fantasmi."
    ],
    "fr": [
      "Appel aux chasseurs de fantômes ! Depuis quelque temps des phénomènes paranormaux se produisent lors des visites guidées de Valence : objets qui apparaissent, \r\nsons étranges, messages... Une médium nous a indiqués la présence de nombreux fantômes."
    ],
    "es": [
      "¡Llamamiento a todos los cazadores de fantasmas! Desde hace algún tiempo se vienen produciendo fenómenos paranormales durante las visitas guiadas a Valencia: aparición de objetos,\r\nsonidos extraños, mensajes... Una médium ha indicado la presencia de muchos fantasmas."
    ],
    "nl": [
      "Oproep aan alle spokenjagers! Sinds enige tijd doen zich paranormale verschijnselen voor tijdens rondleidingen in Valencia: objecten die verschijnen,\r\nvreemde geluiden, boodschappen... Een medium heeft gewezen op de aanwezigheid van vele geesten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Enquête : les fantômes de Valence"
    ]
  },
