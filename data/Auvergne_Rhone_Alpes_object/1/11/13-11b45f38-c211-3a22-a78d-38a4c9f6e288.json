  "rdfs:comment": {
    "de": [
      "La Cantine ist mehr als nur eine Bar oder ein Restaurant: ein Ort, an dem sich Kaffee, Mittagessen, Tapas, Aperitifs und Essen rund um die Uhr mit Gesellschaftsspielen, Arbeitsplätzen und schönen gemeinsamen Momenten allein, mit der Familie oder mit Freunden reimen."
    ],
    "en": [
      "La Cantine is much more than a bar and restaurant: it's a place where coffee, lunch, tapas, aperitifs and food at any time go hand in hand with board games, a workspace and good times shared solo, with family or friends."
    ],
    "it": [
      "La Cantine è molto più di un bar e di un ristorante: è un luogo in cui caffè, pranzi, tapas, aperitivi e cibo a tutte le ore si accompagnano a giochi da tavolo, a uno spazio di lavoro e a momenti piacevoli da trascorrere da soli, in famiglia o con gli amici."
    ],
    "fr": [
      "La Cantine, c’est bien plus qu’un bar, restaurant : un lieu de vie où café, déjeuner, planches tapas, apéros, nourriture à toute heure riment avec jeux de société, espace de travail et bons moments partagés, en solo, en famille ou entre amis."
    ],
    "nl": [
      "La Cantine is veel meer dan een bar en restaurant: het is een plek waar koffie, lunch, tapas, aperitieven en eten op elk moment hand in hand gaan met bordspellen, een werkruimte en leuke momenten om alleen, met familie of vrienden te hebben."
    ],
    "es": [
      "La Cantine es mucho más que un bar y un restaurante: es un lugar donde el café, el almuerzo, las tapas, el aperitivo y la comida a cualquier hora se dan la mano con juegos de mesa, un espacio de trabajo y buenos momentos para pasar solos, en familia o con amigos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cantine"
    ]
  },
