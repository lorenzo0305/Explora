  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c92d1fe6-9fb5-3247-912a-e213e5c35ac1",
      "dc:description": {
        "de": [
          "Hausgemachte italienische Spezialitäten in einer familiären Atmosphäre wie in La Casa!\nAn sonnigen Tagen schöne schattige Terrasse. Große Auswahl an Pizzas, Salaten, Nudel- und Fleischgerichten. Die Spezialitäten des Küchenchefs: Tortellini, Schnitzel nach Mailänder Art und Pizza nach italienischer Art..."
        ],
        "en": [
          "Home-made Italian specialties in a family atmosphere like at home!\nOn sunny days, nice shaded terrace. Large choice of pizzas, salads, pasta dishes and meats. The chef's specialties: tortellini, escalope Milanese style and Italian pizza..."
        ],
        "it": [
          "Specialità italiane cucinate in casa in un'atmosfera familiare, proprio come a casa!\nNelle giornate di sole, c'è una bella terrazza ombreggiata. Ampia scelta di pizze, insalate, primi piatti e carni. Le specialità dello chef: tortellini, scaloppine alla milanese e pizza italiana..."
        ],
        "fr": [
          "Des spécialités italiennes cuisinées maison dans une ambiance familiale comme à la casa !\nAux beaux jours, jolie terrasse ombragée. Grand choix de pizzas, salades, plat de pâtes et viandes. Les spécialités du chef : tortellini, escalope à la Milanese et pizza à l'italienne..."
        ],
        "nl": [
          "Huisgemaakte Italiaanse specialiteiten in een familiale sfeer, net als thuis!\nOp zonnige dagen is er een mooi schaduwrijk terras. Grote keuze aan pizza's, salades, pastagerechten en vlees. De specialiteiten van de chef: tortellini, escalope op Milanese wijze en Italiaanse pizza..."
        ],
        "es": [
          "Especialidades italianas caseras en un ambiente familiar, como en casa\nEn los días soleados, hay una bonita terraza con sombra. Gran variedad de pizzas, ensaladas, platos de pasta y carnes. Las especialidades del chef: tortellini, escalope a la milanesa y pizza italiana..."
        ]
      },
      "@type": [
        "Description"
