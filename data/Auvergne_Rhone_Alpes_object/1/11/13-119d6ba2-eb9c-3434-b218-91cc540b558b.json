  "rdfs:comment": {
    "de": [
      "Die beiden gemeindeübergreifenden Ludotheken der Region sind Orte der Begegnung zwischen den Generationen rund um Spiele und Spielzeug."
    ],
    "en": [
      "A place for intergenerational encounters around games and toys, the territory's two intercommunal toy libraries welcome you to play on site or borrow games to take home."
    ],
    "it": [
      "Le due ludoteche intercomunali della zona sono luoghi ideali per incontrarsi con altre generazioni e imparare a conoscere giochi e giocattoli. È possibile giocare sul posto o prendere in prestito giochi da portare a casa."
    ],
    "fr": [
      "Lieux de rencontres intergénérationnelles autour du jeu et du jouet, les deux ludothèques intercommunales du territoire vous accueille pour jouer sur place ou emprunter des jeux à emporter à la maison."
    ],
    "es": [
      "Las dos ludotecas intercomunitarias de la zona son lugares estupendos para reunirse con otras generaciones y aprender sobre juegos y juguetes. Se puede jugar allí mismo o tomar prestados juegos para llevárselos a casa."
    ],
    "nl": [
      "De twee intercommunale speelgoedbibliotheken in de buurt zijn geweldige plekken om andere generaties te ontmoeten en meer te leren over spellen en speelgoed. Je kunt ter plekke spellen spelen of lenen om mee naar huis te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ludothèque intercommunale La Ludibul"
    ]
  },
