  "rdfs:comment": {
    "de": [
      "Eine authentische, farbenfrohe und kreative Küche mit frischen und gesunden Zutaten: Das ist Da's Rezept für ein unglaubliches Eintauchen in Thailand während einer Mahlzeit.\r\nEine authentische Einladung zu einer Reise in das Herz Nordthailands."
    ],
    "en": [
      "Authentic, colourful and creative cuisine, made with fresh and healthy products: this is Da's recipe for an incredible Thai immersion during a meal.\r\nAn authentic invitation to travel to the heart of Northern Thailand."
    ],
    "it": [
      "Cucina autentica, colorata e creativa, a base di ingredienti freschi e sani: questa è la ricetta di Da's per un'incredibile immersione thailandese durante un pasto.\r\nUn invito autentico a viaggiare nel cuore della Thailandia del Nord."
    ],
    "fr": [
      "Une cuisine authentique, colorée et créative, composé de produits frais et sains : telle est la recette de Da pour une incroyable immersion thaïlandaise le temps d’un repas.\r\nUne authentique invitation au voyage au coeur de la Thailande du Nord ."
    ],
    "es": [
      "Cocina auténtica, colorista y creativa, elaborada con ingredientes frescos y saludables: ésta es la receta de Da para una increíble inmersión tailandesa durante una comida.\r\nUna auténtica invitación a viajar al corazón del norte de Tailandia."
    ],
    "nl": [
      "Authentieke, kleurrijke en creatieve gerechten, gemaakt met verse, gezonde ingrediënten: dit is Da's recept voor een ongelooflijke Thaise onderdompeling tijdens een maaltijd.\r\nEen authentieke uitnodiging om naar het hart van Noord-Thailand te reizen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Thaï Food By Da"
    ]
  },
