  "rdfs:comment": {
    "de": [
      "das \"Village d'Aurel fête la clairette\" findet am Freitag, den 15. Mai 2026 zum zweiten Mal statt!\r\nGesellige Atmosphäre, Blasen und Leckereien stehen auf dem Programm. Feiern Sie die Clairette im Herzen unseres schönen Dorfes!"
    ],
    "en": [
      "\"Le Village d'Aurel fête la clairette\" returns for its ith edition on Friday, May 15, 2026!\r\nA friendly atmosphere, bubbles and gourmet treats await you. Come and celebrate Clairette in the heart of our beautiful village!"
    ],
    "it": [
      "la \"Village d'Aurel fête la clairette\" torna per la sua terza edizione venerdì 15 maggio 2026!\r\nUn'atmosfera amichevole, bollicine e prelibatezze vi aspettano. Venite a festeggiare la Clairette nel cuore del nostro bellissimo villaggio!"
    ],
    "fr": [
      "\"Le Village d'Aurel fête la clairette\" revient pour sa ème édition le Vendredi 15 mai 2026 !\r\nAmbiance conviviale, bulles, et gourmandises au rendez-vous. Venez célébrer la Clairette au cœur de notre beau village !"
    ],
    "es": [
      "la \"Village d'Aurel fête la clairette\" vuelve en su 3ª edición el viernes 15 de mayo de 2026\r\nUn ambiente agradable, burbujas y delicias le esperan. Venga a celebrar la Clairette en el corazón de nuestro hermoso pueblo"
    ],
    "nl": [
      "het \"Village d'Aurel fête la clairette\" is terug voor zijn derde editie op vrijdag 15 mei 2026!\r\nEen gezellige sfeer, bubbels en lekkernijen wachten op je. Kom Clairette vieren in het hart van ons mooie dorp!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Village d'Aurel fête la Clairette"
    ]
  },
