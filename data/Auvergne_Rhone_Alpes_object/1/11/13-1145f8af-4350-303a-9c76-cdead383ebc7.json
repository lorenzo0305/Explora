  "rdfs:comment": {
    "de": [
      "Der 1912 fertiggestellte Peux-Viadukt trug die Schmalspurbahnlinie, die zwischen 1912 und 1939 von Vichy nach Roanne führte."
    ],
    "en": [
      "Completed in 1912, the Peux viaduct carried the narrow-gauge railroad line from Vichy to Roanne between 1912 and 1939."
    ],
    "it": [
      "Completato nel 1912, il viadotto di Peux ha trasportato la linea ferroviaria a scartamento ridotto che collegava Vichy a Roanne tra il 1912 e il 1939."
    ],
    "fr": [
      "Ouvrage achevé en 1912, le viaduc des Peux portait la ligne du chemin de fer à voie étroite,   reliant Vichy à Roanne entre 1912 et 1939."
    ],
    "es": [
      "Terminado en 1912, el viaducto de Peux transportó la línea de ferrocarril de vía estrecha que unía Vichy con Roanne entre 1912 y 1939."
    ],
    "nl": [
      "Het viaduct van Peux, voltooid in 1912, overspande tussen 1912 en 1939 de smalspoorlijn tussen Vichy en Roanne."
    ]
  },
