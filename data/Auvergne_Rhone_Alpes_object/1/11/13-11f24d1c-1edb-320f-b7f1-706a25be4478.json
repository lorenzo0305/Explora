  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere originellen und einzigartigen Duftkreationen. Volcano Diffuser, unsere kleinen Anti-Insekten-Körner und viele andere Kreationen erwarten Sie in unseren Verkaufsstellen und in unserer Boutique, die nach Vereinbarung geöffnet ist."
    ],
    "en": [
      "Come and discover our original and unique fragrance creations. Volcano diffusers, insect repellent seeds and many other creations await you at our points of sale and in our boutique, open by appointment."
    ],
    "it": [
      "Venite a scoprire le nostre creazioni di profumi originali e unici. Diffusori a vulcano, semi repellenti per insetti e molte altre creazioni vi aspettano nei nostri punti vendita e nella nostra boutique, aperta su appuntamento."
    ],
    "fr": [
      "Venez découvrir nos créations parfumées originales et uniques. Volcans diffuseurs, nos petits grains anti-insecte et bien d’autres créations vous attendent dans nos points de vente et notre boutique ouverte sur rendez-vous."
    ],
    "es": [
      "Venga a descubrir nuestras creaciones de fragancias originales y únicas. Difusores volcán, semillas repelentes de insectos y muchas otras creaciones le esperan en nuestros puntos de venta y en nuestra boutique, abierta con cita previa."
    ],
    "nl": [
      "Kom en ontdek onze originele en unieke geurcreaties. Vulkaanverspreiders, insectenwerende zaadjes en vele andere creaties wachten op je bij onze verkooppunten en in onze boetiek, die op afspraak geopend is."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cascade de senteurs Calinckx - Atelier boutique"
    ]
  },
