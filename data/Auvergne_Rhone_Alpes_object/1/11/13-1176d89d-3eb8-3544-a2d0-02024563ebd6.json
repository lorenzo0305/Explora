  "rdfs:comment": {
    "de": [
      "Vom Geigenbau bis zum Drechseln von Holz hoffe ich, dass es mir gelingt, Ihnen die Leidenschaft, die mich antreibt, zu vermitteln...."
    ],
    "en": [
      "From guittarmaking to woodturning, I hope you will taste how passionate I am..."
    ],
    "it": [
      "Dalla liuteria alla tornitura del legno, spero di trasmettervi la passione che mi anima...."
    ],
    "fr": [
      "De la lutherie au tournage sur bois, j'espère réussir à vous transmettre la passion qui m'anime...."
    ],
    "nl": [
      "Van vioolbouw tot houtdraaien, ik hoop de passie die mij drijft aan u door te geven...."
    ],
    "es": [
      "Desde la fabricación de violines hasta el torneado de madera, espero poder transmitirles la pasión que me mueve...."
    ]
