  "rdfs:comment": {
    "de": [
      "Wir brauen biologische Biere und eine Limonade mit Wasser aus den Quellen des Cézallier. Besuchen Sie unsere Brauerei und erfahren Sie mehr über unsere Rohstoffe, den Herstellungsprozess, die Tanks und das Energiemanagement bis hin zur Abfüllung."
    ],
    "en": [
      "We brew organic beers and lemonade using water from the Cézallier springs. Visit our brewery to discover our raw materials, production processes, tanks and energy management, right through to bottling."
    ],
    "it": [
      "Produciamo birre e limonate biologiche utilizzando l'acqua delle sorgenti di Cézallier. Visitate il nostro birrificio per scoprire le materie prime, il processo di produzione, i tini e la gestione energetica fino all'imbottigliamento."
    ],
    "fr": [
      "Nous brassons des bières et une limonade biologiques avec l'eau des sources du Cézallier. Visitez notre brasserie pour découvrir nos matières premières, processus de fabrication, cuves et gestion énergétique jusqu'à l'embouteillage."
    ],
    "nl": [
      "We brouwen biologische bieren en limonade met water uit de bronnen van Cézallier. Bezoek onze brouwerij om meer te weten te komen over onze grondstoffen, het productieproces, de kuipen en het energiebeheer tot en met het bottelen."
    ],
    "es": [
      "Elaboramos cervezas y limonadas ecológicas con agua de los manantiales de Cézallier. Visite nuestra fábrica de cerveza y descubra nuestras materias primas, el proceso de producción, las cubas y la gestión de la energía hasta el embotellado."
    ]
  },
  "rdfs:label": {
