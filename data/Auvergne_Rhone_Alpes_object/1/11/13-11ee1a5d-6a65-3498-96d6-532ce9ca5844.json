  "rdfs:comment": {
    "de": [
      "Verkauf von Kunsthandwerk und Einführungskurse in die Messerschnitzerei des Typs Queyras.\r\nHundeschlittenfahrten und Cani-Rando im Valromey."
    ],
    "en": [
      "Sale of handicrafts and introductory courses in Queyras-style knife carving.\r\nDog sled rides and cani-rando in the Valromey."
    ],
    "it": [
      "Vendita di prodotti artigianali e corsi di introduzione all'intaglio di coltelli in stile Queyras.\r\nGite in slitta trainata da cani e cani-rando nella Valromey."
    ],
    "fr": [
      "Vente d'objets artisanaux et cours de d'initiation à la sculpture au couteau de type Queyras.\r\nBalades en traîneaux à chiens et cani-rando dans le Valromey."
    ],
    "nl": [
      "Verkoop van ambachtelijk handwerk en initiatiecursussen messen snijden in Queyras-stijl.\r\nTochten met de hondenslee en cani-rando in de Valromey."
    ],
    "es": [
      "Venta de artesanía y cursos de iniciación a la talla con cuchillo al estilo de Queyras.\r\nPaseos en trineo tirado por perros y cani-rando en el Valromey."
    ]
  },
  "rdfs:label": {
    "en": [
      "Scintiller au fil des saisons - Sparkling through the seasons - wood carving with a knife and activities with dogs"
    ],
    "fr": [
      "Scintiller au fil des saisons - sculpture sur bois au couteau et activités avec des chiens"
    ]
  },
