  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Dieses in den Boden gegrabene Waschhaus ist U-förmig, wird von einem Bach gespeist und hat einen leicht erhöhten Rand."
    ],
    "en": [
      "Free access. This wash house dug into the ground is U-shaped, fed by a stream, has a slightly raised coping."
    ],
    "it": [
      "Accesso libero. Questo lavatoio a forma di U, scavato nel terreno e alimentato da un ruscello, presenta un cordolo leggermente rialzato."
    ],
    "fr": [
      "Accès libre. Ce lavoir creusé dans le sol est en forme de U, alimenté par un ruisseau, est doté d'une margelle légèrement surélevée."
    ],
    "nl": [
      "Vrije toegang. Dit U-vormige washuis, uitgegraven in de grond en gevoed door een beekje, heeft een licht verhoogde stoeprand."
    ],
    "es": [
      "Acceso gratuito. Este lavadero en forma de U, excavado en el suelo y alimentado por un arroyo, tiene un bordillo ligeramente elevado."
    ]
  },
