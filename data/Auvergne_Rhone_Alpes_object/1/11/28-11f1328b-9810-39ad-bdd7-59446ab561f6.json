  "rdfs:comment": {
    "de": [
      "Sie suchen einen Laden, um Ihren Lieben ein Geschenk zu machen oder ein Souvenir aus dem Pays Noyonnais mit nach Hause zu nehmen? Coq et Pomme bietet verschiedene Accessoires, Schmuck, Geschirr und Spielzeug von hoher Qualität an."
    ],
    "en": [
      "Are you looking for a shop to give a gift to your loved ones or to take home a souvenir from the Pays Noyonnais? Don't look any further, Coq et Pomme offers various accessories, jewellery, crockery or toys of very good quality."
    ],
    "it": [
      "Siete alla ricerca di un negozio per fare un regalo ai vostri cari o per portare a casa un souvenir della regione del Noyonnais? Non cercate oltre, Coq et Pomme offre vari accessori, gioielli, stoviglie e persino giocattoli di ottima qualità."
    ],
    "fr": [
      "Vous cherchez une boutique pour faire un cadeau à vos proches ou repartir avec un souvenir du Pays Noyonnais? Ne cherchez plus, Coq et Pomme propose différents accessoires, des bijoux, de la vaisselle ou encore des jouets de très bonne qualité."
    ],
    "es": [
      "¿Busca una tienda para hacer un regalo a sus seres queridos o para llevarse un recuerdo de la región de Noyonnais? No busques más, Coq et Pomme ofrece diversos accesorios, joyas, vajillas e incluso juguetes de muy buena calidad."
    ],
    "nl": [
      "Bent u op zoek naar een winkel om een cadeau te geven aan uw geliefden of om een souvenir van de Noyonnais mee naar huis te nemen? Zoek niet verder, Coq et Pomme biedt diverse accessoires, sieraden, serviesgoed en zelfs speelgoed van zeer goede kwaliteit."
    ]
  },
  "rdfs:label": {
    "fr": [
