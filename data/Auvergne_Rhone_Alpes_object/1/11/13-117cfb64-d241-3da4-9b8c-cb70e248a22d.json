  "rdfs:comment": {
    "de": [
      "RDV am 12. April für eine neue Ausgabe des TrailDrome, die neue Strecke Montbrun Buis und Kinderstrecke kommen zu den Strecken von 10, 21 und 42 Kilometern hinzu! Ein unumgänglicher Termin für alle Trailbegeisterten."
    ],
    "en": [
      "See you on April 12 for a new edition of the TrailDrome, with the new Montbrun Buis and children's course added to the 10, 21 and 42 kilometer courses! An unmissable event for trail enthusiasts."
    ],
    "it": [
      "Appuntamento il 12 aprile per un'altra edizione del TrailDrome, con il nuovo percorso del Montbrun Buis e il percorso per bambini che si aggiungono ai percorsi di 10, 21 e 42 chilometri! Un evento imperdibile per gli appassionati di trail."
    ],
    "fr": [
      "RDV le 12 avril pour une nouvelle édition du TrailDrome, le nouveau parcours Montbrun Buis et parcours enfant s'ajoutent aux parcours de 10, 21 et 42 kilomètres ! Un rendez-vous immanquable pour les passionnés de trail."
    ],
    "nl": [
      "Tot ziens op 12 april voor een nieuwe editie van de TrailDrome, met de nieuwe Montbrun Buis trail en kinder trail toegevoegd aan de 10, 21 en 42 kilometer trails! Een niet te missen evenement voor trail liefhebbers."
    ],
    "es": [
      "Nos vemos el 12 de abril en una nueva edición del TrailDrome, con el nuevo sendero de Montbrun Buis y el sendero infantil que se añaden a los senderos de 10, 21 y 42 kilómetros Una cita ineludible para los amantes del trail."
    ]
  },
  "rdfs:label": {
