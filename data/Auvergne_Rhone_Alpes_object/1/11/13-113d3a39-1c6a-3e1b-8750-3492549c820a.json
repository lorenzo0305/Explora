  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais Vert durch ein spielerisches und kostenloses Geocaching-Erlebnis: eine Schatzsuche für die ganze Familie!\r\nBegeben Sie sich in Tarare auf die Jagd nach Öpinell, der in der Geschichte der Stadt nicht zu schlagen ist."
    ],
    "en": [
      "Discover the Beaujolais Vert region through a free geocaching experience: a treasure hunt for the whole family!\r\nIn Tarare, go on a hunt for Öpinell, who knows everything there is to know about the town's history."
    ],
    "it": [
      "Scoprite la regione del Beaujolais Vert attraverso un'esperienza di geocaching divertente e gratuita: una caccia al tesoro per tutta la famiglia!\r\nA Tarare, andate a caccia di Öpinell, che sa tutto sulla storia della città."
    ],
    "fr": [
      "Découvrez le Beaujolais Vert à travers une expérience ludique et gratuite de géocaching : une chasse aux trésors à vivre en famille !\r\nÀ Tarare, partez à la chasse de Öpinell, incollable sur l'histoire de la ville."
    ],
    "nl": [
      "Ontdek de Beaujolais Vert via een leuke, gratis geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nGa in Tarare op jacht naar Öpinell, die alles weet over de geschiedenis van de stad."
    ],
    "es": [
      "Descubra la región del Beaujolais Vert a través de una divertida experiencia gratuita de geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn Tarare, busque a Öpinell, que lo sabe todo sobre la historia de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - La mousseline, c'est coton !"
    ]
  },
