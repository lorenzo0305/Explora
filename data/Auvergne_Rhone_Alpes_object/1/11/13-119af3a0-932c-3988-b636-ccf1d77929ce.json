  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen der Molkereigenossenschaft von Moûtiers und tauchen Sie ein in die Welt des Beauforts."
    ],
    "en": [
      "Discover how Beaufort cheese is made and the work of the farmers, with explanatory panels and a film for the general public. Visit the maturing cellars and treat yourself in the shop selling local produce."
    ],
    "it": [
      "Aprite le porte della cooperativa lattiero-casearia di Moûtiers per immergervi nel mondo di Beaufort."
    ],
    "fr": [
      "Poussez les portes de la coopérative laitière de Moûtiers pour plonger au cœur de l'univers du Beaufort."
    ],
    "nl": [
      "Ontdek hoe Beaufort kaas wordt gemaakt en het werk van de boeren, met verklarende panelen en een film voor het grote publiek. Bezoek de rijpingskelders en trakteer jezelf in de winkel met streekproducten."
    ],
    "es": [
      "Abra de par en par las puertas de la cooperativa lechera de Moûtiers para sumergirse en el mundo de Beaufort."
    ]
  },
