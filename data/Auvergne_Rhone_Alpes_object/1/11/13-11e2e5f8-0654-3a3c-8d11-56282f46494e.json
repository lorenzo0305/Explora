  "rdfs:comment": {
    "de": [
      "Der Verein \"Conteurs d'Art\" hat sich an Textilkunsthandwerker und bildende Künstler gewandt, die über ein besonderes Universum verfügen und ihre Fertigkeiten meisterhaft beherrschen."
    ],
    "en": [
      "The \"Conteurs d?Art\" association called on textile artisans and visual artists with their own particular universes and mastery of their skills."
    ],
    "it": [
      "L'associazione \"Conteurs d'Art\" si è avvalsa dell'aiuto di artigiani tessili e artisti visivi con un proprio mondo e una propria padronanza delle competenze."
    ],
    "fr": [
      "L’association « Conteurs d’Art » a sollicité des artisans d’art textile et des artistes plasticiens ayant un univers particulier ainsi qu’une grande maîtrise de leurs savoir-faire."
    ],
    "es": [
      "La asociación \"Conteurs d'Art\" ha recurrido a la ayuda de artesanos textiles y artistas plásticos con mundos propios y dominio de sus oficios."
    ],
    "nl": [
      "De vereniging \"Conteurs d'Art\" heeft de hulp ingeroepen van textielambachtslieden en beeldende kunstenaars met hun eigen wereld en beheersing van hun vaardigheden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Résonnance"
    ]
