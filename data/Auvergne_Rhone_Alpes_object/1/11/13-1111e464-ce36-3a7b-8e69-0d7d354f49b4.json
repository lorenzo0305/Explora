  "rdfs:comment": {
    "de": [
      "Das mit 3D-Technologie ausgestattete Kino du Grand Air bietet 220 bequeme Sitzplätze und zeigt aktuelle Mainstream-Filme zu sehr attraktiven Preisen. An der Kasse befindet sich ein Süßwaren- und Getränkebereich."
    ],
    "en": [
      "Equipped with 3D technology, the Grand Air cinema has a capacity of 220 comfortable seats and offers recent mainstream films at very attractive prices. Confectionery and drinks are available at the cash desk."
    ],
    "it": [
      "Dotato di tecnologia 3D, il cinema Grand Air ha una capacità di 220 comodi posti a sedere e offre film mainstream recenti a prezzi molto interessanti. Alla biglietteria sono disponibili dolciumi e bevande."
    ],
    "fr": [
      "Doté de la technologie 3D, le cinéma du Grand Air offre une capacité de 220 places confortables et propose des films récents grand public à des prix très attractifs. Un espace confiseries et boissons est présent à la caisse."
    ],
    "es": [
      "Equipado con tecnología 3D, el cine Grand Air tiene capacidad para 220 cómodas butacas y ofrece películas recientes de gran audiencia a precios muy atractivos. En la taquilla se ofrecen productos de confitería y bebidas."
    ],
    "nl": [
      "De Grand Air-bioscoop is uitgerust met 3D-technologie, heeft een capaciteit van 220 comfortabele stoelen en biedt recente mainstreamfilms tegen zeer aantrekkelijke prijzen. Snuisterijen en drankjes zijn verkrijgbaar bij de kassa."
    ]
  },
