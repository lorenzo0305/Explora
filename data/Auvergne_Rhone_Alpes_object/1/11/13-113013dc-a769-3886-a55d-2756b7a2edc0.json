  "rdfs:comment": {
    "de": [
      "Restaurant d'altitude ouvert midi et soir On vous accueilli de dans un endroit chaleureux à la décoration soigné. Zu Fuß oder mit dem Auto über einen Parkplatz erreichbar. (102 rue des Sapins)."
    ],
    "en": [
      "High-altitude restaurant open for lunch and dinner. We welcome you in a warm and tastefully decorated setting. Accessible on foot or by car with parking. (102 rue des Sapins)."
    ],
    "it": [
      "Ristorante d'alta quota aperto a pranzo e a cena. Accoglienza calorosa in un ambiente arredato con gusto. Raggiungibile a piedi o in auto (102 rue des Sapins)."
    ],
    "fr": [
      "Restaurant d'altitude ouvert midi et soir  On vous accueil de  dans un endroit chaleureux à la décoration soignée. Accessible à pied ou en voiture avec parking. (102 rue des Sapins)."
    ],
    "es": [
      "Restaurante de altura abierto para el almuerzo y la cena. Una cálida acogida en un marco decorado con gusto. Accesible a pie o en coche (102 rue des Sapins)."
    ],
    "nl": [
      "Restaurant op grote hoogte, open voor lunch en diner. Een warm welkom in een smaakvol ingerichte omgeving. Bereikbaar te voet of met de auto (102 rue des Sapins)."
    ]
  },
