  "rdfs:comment": {
    "de": [
      "Wenn Sie durch die Tür der Bibliothek von Voiron gehen, treten Sie in das Netz der 19 Bibliotheken im Pays Voironnais ein. Eine einzige Karte, ein einziger Tarif, um Zugang zu allen Dienstleistungen der Bibliotheken zu erhalten."
    ],
    "en": [
      "When you walk through the door of the Voiron library, you enter the network of 19 libraries in the Voiron region. A single card, a single rate to access all the services offered by the libraries."
    ],
    "it": [
      "Varcare la porta della biblioteca di Voiron significa entrare nella rete delle 19 biblioteche del Pays Voironnais. Un'unica tessera, un unico prezzo per accedere a tutti i servizi offerti dalle biblioteche."
    ],
    "fr": [
      "Passer la porte de la bibliothèque de Voiron, c’est entrer dans le réseau des 19 bibliothèques en Pays Voironnais. Une carte unique, un tarif unique pour accéder à l’ensemble des services proposés par les bibliothèques."
    ],
    "es": [
      "Atravesar la puerta de la biblioteca de Voiron significa entrar en la red de 19 bibliotecas del Pays Voironnais. Un solo carné, un solo precio para acceder a todos los servicios que ofrecen las bibliotecas."
    ],
    "nl": [
      "Als u door de deur van de bibliotheek van Voiron gaat, betreedt u het netwerk van 19 bibliotheken in het Pays Voironnais. Eén kaart, één prijs voor toegang tot alle diensten van de bibliotheken."
    ]
  },
