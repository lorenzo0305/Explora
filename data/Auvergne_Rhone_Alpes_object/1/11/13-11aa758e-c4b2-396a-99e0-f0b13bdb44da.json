  "rdfs:comment": {
    "de": [
      "Evolution 2 ist viel mehr als eine Skischule, es ist eine echte Referenz für Outdoor-Aktivitäten, wo jede Erfahrung zu einem einzigartigen Moment wird, den man im Herzen der Alpen erleben kann."
    ],
    "en": [
      "Evolution 2 has become one of the most respected ski and adventure schools in the French Alps. We believe in learning in small groups, with specialist instructors, and an emphasis on progression and fun!"
    ],
    "it": [
      "Molto più di una semplice scuola di sci, Evolution 2 è un punto di riferimento per le attività all'aperto, dove ogni esperienza diventa un momento unico nel cuore delle Alpi."
    ],
    "fr": [
      "Bien plus qu’une école de ski, Evolution 2 est une véritable référence des activités outdoor, où chaque expérience devient un moment unique à vivre au cœur des Alpes."
    ],
    "es": [
      "Mucho más que una escuela de esquí, Evolution 2 es una referencia en actividades al aire libre, donde cada experiencia se convierte en un momento único en el corazón de los Alpes."
    ],
    "nl": [
      "Evolution 2 is veel meer dan alleen een skischool en is een referentie in outdooractiviteiten, waar elke ervaring een uniek moment wordt in het hart van de Alpen."
    ]
  },
  "rdfs:label": {
