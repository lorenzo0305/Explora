  "rdfs:comment": {
    "de": [
      "Tine Panzuti ist mit ihrem Van die Wege abgefahren, die Jean Giono in Voyage à pied dans la Haute-Drôme erzählt hat. Dieses Abenteuer hat sie zu neuen Werken inspiriert, die sie im Rahmen eines zweiwöchigen Aufenthalts in Magma fertigstellen wird."
    ],
    "en": [
      "Tine Panzuti took her van along the paths described by Jean Giono in Voyage à pied dans la Haute-Drôme. This adventure inspired her to create new works, which she will complete at Magma during a two-week residency."
    ],
    "it": [
      "Tine Panzuti ha viaggiato in furgone lungo i sentieri descritti da Jean Giono in Voyage à pied dans la Haute-Drôme. È stata un'avventura che l'ha ispirata a creare nuove opere, che completerà al Magma durante una residenza di due settimane."
    ],
    "fr": [
      "Tine Panzuti a parcouru en van les chemins racontés par Jean Giono dans Voyage à pied dans la Haute-Drôme. Une aventure qui lui a inspiré de nouvelles œuvres, qu'elle vient achever à Magma lors d'une résidence de deux semaines."
    ],
    "nl": [
      "Tine Panzuti reisde met een busje langs de paden die Jean Giono beschreef in Voyage à pied dans la Haute-Drôme. Het was een avontuur dat haar inspireerde tot het creëren van nieuwe werken, die ze zal voltooien bij Magma tijdens een residentie van twee weken."
    ],
    "es": [
      "Tine Panzuti recorrió en furgoneta los caminos descritos por Jean Giono en Voyage à pied dans la Haute-Drôme. Fue una aventura que la inspiró para crear nuevas obras, que completará en Magma durante una residencia de dos semanas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition de peintures - Dans les pas de Giono, récit d'une balade en van"
    ]
  },
