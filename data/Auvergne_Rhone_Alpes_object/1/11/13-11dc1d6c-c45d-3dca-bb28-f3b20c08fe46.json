  "rdfs:comment": {
    "de": [
      "Evolution 2 Chamonix - Das ganze Jahr über die Berge erleben!\r\n\r\nBei Evolution 2 Chamonix bieten wir Ihnen nicht einfach nur Aktivitäten an: Wir bieten Ihnen unvergessliche Erlebnisse, die durch die Leidenschaft unserer Fachleute und die Liebe zu den Bergen geformt werden."
    ],
    "en": [
      "Evolution 2 Chamonix - Experience the mountains all year round\r\n\r\nAt Evolution 2 Chamonix, we don't just offer you activities: we offer you unforgettable experiences, shaped by the passion of our professionals and their love of the mountains."
    ],
    "it": [
      "Evolution 2 Chamonix - Vivere la montagna tutto l'anno\r\n\r\nA Evolution 2 Chamonix non vi offriamo solo attività: vi offriamo esperienze indimenticabili, plasmate dalla passione dei nostri professionisti e dal loro amore per la montagna."
    ],
    "fr": [
      "Evolution 2 Chamonix – Vivre la montagne toute l’année\n\nNous ne vous proposons pas simplement des activités : nous vous offrons des expériences inoubliables, façonnées par la passion de nos professionnels et l’amour de la montagne."
    ],
    "nl": [
      "Evolution 2 Chamonix ? Ervaar de bergen het hele jaar door\n\nWe bieden je niet alleen activiteiten: we bieden je onvergetelijke ervaringen, gevormd door de passie van onze professionals en hun liefde voor de bergen."
    ],
    "es": [
      "Evolution 2 Chamonix - Vive la montaña todo el año\r\n\r\nEn Evolution 2 Chamonix, no sólo te ofrecemos actividades: te ofrecemos experiencias inolvidables, moldeadas por la pasión de nuestros profesionales y su amor por la montaña."
    ]
  },
  "rdfs:label": {
    "de": [
      "Evolution 2 – Ski- und Abenteuerschule"
    ],
    "en": [
      "Evolution 2 - Adventures and ski school"
    ],
    "it": [
      "Evolution 2 - Scuola di sci e avventure"
    ],
    "fr": [
