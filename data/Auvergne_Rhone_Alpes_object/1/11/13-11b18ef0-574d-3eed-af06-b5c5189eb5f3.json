  "rdfs:comment": {
    "de": [
      "Auswahl an hochwertigen Fleisch- und Wurstwaren: Geflügel, hausgemachte Wurstwaren, Kalbfleisch aus dem Limousin, Rindfleisch aus dem Limousin, Lammfleisch aus dem Limousin. Dienstleistungen von Triperie und Rotisserie. Traiteur-Service."
    ],
    "en": [
      "Selection of quality meats and charcuterie: poultry, artisanal charcuterie, Limousin veal, Limousin beef, Limousin lamb. Tripe and roasting services. Catering service."
    ],
    "it": [
      "Selezione di carni e salumi di qualità: pollame, salumi tradizionali, vitello di Limousin, manzo di Limousin, agnello di Limousin. Servizi di trippa e arrosto. Servizio di catering."
    ],
    "fr": [
      "Sélection de viandes et charcuteries de qualité : volailles, charcuterie artisanale, viande de veau du Limousin, viande de bœuf du Limousin, viande d'agneau du Limousin. Services de triperie et de rôtisserie. Service traiteur."
    ],
    "nl": [
      "Selectie van kwaliteitsvlees en vleeswaren: gevogelte, traditionele vleeswaren, Limousin kalfsvlees, Limousin rundvlees, Limousin lamsvlees. Pens- en braaddiensten. Catering service."
    ],
    "es": [
      "Selección de carnes y charcutería de calidad: aves, charcutería tradicional, ternera de Limousin, buey de Limousin, cordero de Limousin. Servicios de callos y asados. Servicio de catering."
    ]
