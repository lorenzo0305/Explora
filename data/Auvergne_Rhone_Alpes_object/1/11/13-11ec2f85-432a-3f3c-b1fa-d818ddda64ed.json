  "rdfs:comment": {
    "de": [
      "Die Galeries Saint Martin präsentieren seit 1970 die großen Namen der zeitgenössischen Kunst sowie eine Auswahl an jungen, aufstrebenden Talenten."
    ],
    "en": [
      "Since 1970, the Saint Martin galleries have been presenting the great names in contemporary art, as well as a selection of young emerging talents."
    ],
    "it": [
      "Dal 1970, le gallerie Saint Martin presentano i grandi nomi dell'arte contemporanea e una selezione di giovani talenti emergenti."
    ],
    "fr": [
      "Les galeries Saint Martin présentent depuis 1970 les grandes signatures de l’art contemporain, en plus d’une sélection de jeunes talents émergents."
    ],
    "nl": [
      "Sinds 1970 tonen de Sint-Maartensgaleries de grote namen in de hedendaagse kunst, maar ook een selectie van jonge opkomende talenten."
    ],
