  "rdfs:comment": {
    "de": [
      "Aktivität Schlittenhunde und Cani-Rando. Ob Sommer oder Winter, genießen Sie atemberaubende Landschaften in Begleitung des Nordicateam-Rudels!"
    ],
    "en": [
      "Dog sledding and cani-rando activities. In summer and winter alike, come and enjoy breathtaking scenery in the company of the Nordicateam pack!"
    ],
    "it": [
      "Sleddog e cani-rando. Sia in estate che in inverno, venite a godervi un paesaggio mozzafiato in compagnia del branco Nordicateam!"
    ],
    "fr": [
      "Activité chiens de traîneau et cani-rando. Été comme hiver, venez profiter de paysages à couper le souffle en compagnie de la meute de Nordicateam !"
    ],
    "es": [
      "Trineo tirado por perros y cani-rando. Tanto en verano como en invierno, venga a disfrutar de impresionantes paisajes en compañía de la jauría Nordicateam"
    ],
    "nl": [
      "Hondensleeën en cani-rando. Kom zowel in de zomer als in de winter genieten van het adembenemende landschap in gezelschap van de Nordicateam roedel!"
    ]
  },
  "rdfs:label": {
