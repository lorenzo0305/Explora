  "rdfs:comment": {
    "de": [
      "In einer grünen Umgebung: Minigolf.\r\nAußerdem: beaufsichtigtes Schwimmen, Wandern, Wassersport, Angeln. Verleih von Segeln, Rudern, Kajak, Tretbooten und Mountainbikes, Tennis.Camping, Chalets, Mobilheime, Imbiss.\r\nDas Anzünden von Grills oder Feuer ist verboten."
    ],
    "en": [
      "In a verdant setting: mini golf.\r\nAlso: supervised swimming, hiking, water sports, fishing. Camping, chalets, mobile homes, snack bar.\r\nBarbecues and fires prohibited."
    ],
    "it": [
      "In un ambiente verde: mini golf.\r\nInoltre: nuoto sorvegliato, escursioni, sport acquatici, pesca. Campeggio, chalet, case mobili, snack bar.\r\nÈ vietato accendere barbecue o fuochi."
    ],
    "fr": [
      "Dans un cadre  verdoyant : mini golf.\r\nAussi : baignade surveillée, randonnée, sports nautiques, pêche. Location de voile, aviron, Kayak, pédal'eau et VTT, tennis.Camping, chalets, mobile-homes, snack.\r\nInterdiction d'allumer des barbecues ou feu."
    ],
    "nl": [
      "In een groene omgeving: minigolf.\r\nOok: zwemmen onder toezicht, wandelen, watersporten, vissen. Camping, chalets, stacaravans, snackbar.\r\nHet is verboden om barbecues of vuur aan te steken."
    ],
    "es": [
      "En un entorno verde: minigolf.\r\nTambién: natación vigilada, senderismo, deportes náuticos, pesca. Camping, chalés, mobil homes, snack bar.\r\nEstá prohibido encender barbacoas o fuegos."
    ]
  },
  "rdfs:label": {
    "fr": [
