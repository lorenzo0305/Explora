  "rdfs:comment": {
    "de": [
      "Sportgeschäft am Fuße der Pisten. Sport- und Sportswear-Boutique, Geschenk- und Souvenirbereich. Verleih von Material für vier Jahreszeiten: Winter (Skier, Schlitten,.), Sommer (Fahrräder). Fahrradwerkstatt, Verkauf und Reparatur von Fahrrädern, von unseren MCF-Lehrern betreute Fahrradtouren."
    ],
    "en": [
      "Sports store at the foot of the slopes. Sports & sportswear store, gifts & souvenirs area. 4-season equipment rental: winter (skis, sledges,.), summer (bikes, tandem,.). Bike sales and repair workshop, bike outings supervised by our MCF instructor."
    ],
    "it": [
      "Negozio di articoli sportivi ai piedi delle piste. Negozio di abbigliamento sportivo, area regali e souvenir. Noleggio di attrezzature per 4 stagioni: inverno (sci, slitte, ecc.), estate (biciclette). Vendita e riparazione di biciclette, uscite in bicicletta con la supervisione dei nostri istruttori MCF."
    ],
    "fr": [
      "Magasin de sport au pied des pistes. Boutique sport & sportswear, espace cadeaux & souvenirs. Location de matériel 4 saisons : hiver (skis, luges,.), été (vélos). Atelier vente et réparation vélos, sorties vélos encadrées par nos moniteurs MCF."
    ],
    "es": [
      "Tienda de deportes a pie de pistas. Tienda de deportes y ropa deportiva, zona de regalos y recuerdos. Alquiler de material 4 estaciones: invierno (esquís, trineos, etc.), verano (bicicletas). Venta de bicicletas y taller de reparación, salidas en bicicleta supervisadas por nuestros monitores MCF."
    ],
    "nl": [
      "Sportwinkel aan de voet van de pistes. Sport- en sportkledingwinkel, ruimte voor geschenken en souvenirs. Verhuur van materiaal voor 4 seizoenen: winter (ski's, sleeën, enz.), zomer (fietsen). Fietsverkoop en reparatiewerkplaats, fietsuitstapjes onder begeleiding van onze MCF instructeurs."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Magasin Grillet Sports"
    ]
  },
