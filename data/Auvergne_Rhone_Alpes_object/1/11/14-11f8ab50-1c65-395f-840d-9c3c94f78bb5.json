  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a124587f-d2c0-3f7c-87a2-89c13c3ebd4d",
      "dc:description": {
        "de": [
          "3,3 KM LANGER WANDERWEG - 45 MIN.\nSTART AM RATHAUSPLATZ VON BELLE ET HOULLEFORT\nGELBE MARKIERUNG\n\nFinden Sie den Verlauf des Rundwegs in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "3.3 KM WALKING TRAIL - 45 MIN.\nDEPARTURE FROM BELLE ET HOULLEFORT TOWN HALL SQUARE\nYELLOW MARKINGS\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO A PIEDI DI 3,3 KM - 45 MIN.\nPARTE DALLA PIAZZA DEL MUNICIPIO DI BELLE ET HOULLEFORT\nSEGNALETICA GIALLA\n\nTrovate il percorso del sentiero sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 3.3 KM - 45 MIN.\nDEPART DE LA PLACE DE LA MAIRIE DE  BELLE ET HOULLEFORT\nBALISAGE EN JAUNE\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA A PIE DE 3,3 KM - 45 MIN.\nSALIDA DE LA PLAZA DEL AYUNTAMIENTO DE BELLE ET HOULLEFORT\nSEÑALIZACIÓN AMARILLA\n\nEncuentre el recorrido del sendero en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "3,3 KM WANDELROUTE - 45 MIN.\nSTART VANAF HET STADHUISPLEIN IN BELLE ET HOULLEFORT\nGELE MARKERINGEN\n\nVind de route van het pad op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
      "@type": [
        "Description"
      ],
