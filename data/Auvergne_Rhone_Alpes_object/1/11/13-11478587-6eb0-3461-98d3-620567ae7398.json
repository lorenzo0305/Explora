  "rdfs:comment": {
    "de": [
      "Der Plan d'eau du Châtelard ist auf der einen Seite von einem Wald und auf der anderen Seite vom Fluss Chéran umgeben. In dieser natürlichen und friedlichen Umgebung können Sie sich außerhalb der Zeit erholen."
    ],
    "en": [
      "Lake Châtelard is located in the heart of Bauges. Surrounded on one side by the forest and on the other by Chéran, you can revitalize in this timeless, peaceful, natural setting."
    ],
    "it": [
      "Il lago Châtelard è circondato da un lato dalla foresta e dall'altro dal fiume Chéran. Potrete fare il pieno di energia in questo ambiente naturale e tranquillo, fuori dal tempo."
    ],
    "fr": [
      "Le plan d'eau du Châtelard est entouré d'une part par la forêt et de l'autre par le Chéran. Vous pourrez vous ressourcer dans ce cadre naturel et paisible, hors du temps."
    ],
    "nl": [
      "Het meer van Châtelard ligt midden in Les Bauges. Aan de ene kant wordt het meer omgeven door bos, aan de andere kant door de Chéran. Een prachtige, rustige en natuurlijke plek om te ontspannen."
    ],
    "es": [
      "El lago de Châtelard está rodeado, por un lado, de bosque y, por el otro, del río Chéran. Podrá recargar las pilas en este entorno natural y tranquilo, fuera del tiempo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at Châtelard lake"
    ],
    "fr": [
      "Pêche au plan d'eau du Châtelard"
    ],
    "nl": [
      "Het meer van Châtelard"
    ]
  },
