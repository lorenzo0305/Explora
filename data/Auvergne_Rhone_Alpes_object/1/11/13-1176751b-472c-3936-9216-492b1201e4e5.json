  "rdfs:comment": {
    "de": [
      "Die Team bietet eine Vielzahl von gegrilltem Fleisch über einem Holzfeuer und ihre Spezialität des Hauses \"Die picanha\""
    ],
    "en": [
      "The team offers a wide variety of grilled meats on a wood fire and their home specialty \"La Picanha\""
    ],
    "it": [
      "Il team offre un'ampia varietà di carni grigliate a legna e la specialità della casa \"La Picanha\", aiguillettes di manzo servite direttamente al tavolo sui loro spiedini."
    ],
    "fr": [
      "L'équipe vous propose une grande variété de viandes grillées au feu de bois et leur spécialité maison « La Picanha », aiguillettes de bœuf servies directement sur leur brochette à table."
    ],
    "nl": [
      "Het team biedt een grote verscheidenheid aan op hout gegrild vlees en hun huisspecialiteit \"La Picanha\", rundvlees aiguillettes die direct op hun spiesjes aan tafel worden geserveerd."
    ],
    "es": [
      "El equipo ofrece una amplia variedad de carnes a la brasa y su especialidad de la casa \"La Picanha\", aiguillettes de ternera servidas directamente en sus pinchos en la mesa."
    ]
  },
