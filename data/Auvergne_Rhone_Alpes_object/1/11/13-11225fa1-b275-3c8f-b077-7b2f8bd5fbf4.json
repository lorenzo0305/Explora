  "rdfs:comment": {
    "de": [
      "4 ha großer, biologisch bewirtschafteter Weinberg an der Südseite des regionalen Naturparks Massif des bauges.\r\nTraditionelle Weinbereitung im Respekt vor dem Lebendigen."
    ],
    "en": [
      "vineyard operated in organic agriculture, located on the South side of the Massif des bauges natural regional park.\r\nTraditional vinification in the respect for life."
    ],
    "it": [
      "Vigneto di 4 ettari, a coltivazione biologica, situato sul versante meridionale del Parco Naturale Regionale del Massiccio dei Bauges.\r\nVinificazione tradizionale nel rispetto della vita."
    ],
    "fr": [
      "Vignoble de 4 ha exploité en agriculture biologique, situé sur la face sud du Parc naturel régional du Massif des bauges.\r\nVinification traditionnelle dans le respect du vivant."
    ],
    "nl": [
      "Wijngaard van 4 ha, biologisch bewerkt, gelegen aan de zuidkant van het Regionaal Natuurpark Massif des Bauges.\r\nTraditionele wijnbouw met respect voor de levenden."
    ],
    "es": [
      "Viñedo de 4 ha, de cultivo ecológico, situado en el lado sur del Parque Natural Regional del Macizo de las Baugas.\r\nElaboración tradicional de vinos con respeto a lo vivo."
    ]
