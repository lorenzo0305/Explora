  "rdfs:comment": {
    "de": [
      "Die im romanischen Stil erbaute Kapelle wurde während der Revolution vernachlässigt und 1835 vollständig wieder aufgebaut. Sie entdecken diese Kapelle zwischen Tulette und Suze la Rousse."
    ],
    "en": [
      "Romanesque in style, it was abandoned during the French Revolution and completely rebuilt in 1835. You can visit this chapel between Tulette and Suze la Rousse."
    ],
    "it": [
      "Di stile romanico, fu abbandonato durante la Rivoluzione e fu completamente ricostruito nel 1835. Scoprirete questa cappella tra Tulette e Suze la Rousse."
    ],
    "fr": [
      "De style roman, elle fut délaissée à la Révolution et fut entièrement reconstruite en 1835. Vous découvrirez cette chapelle entre Tulette et Suze la Rousse."
    ],
    "nl": [
      "Deze kapel in Romaanse stijl werd verlaten tijdens de Franse Revolutie en volledig herbouwd in 1835. Je kunt deze kapel bezoeken tussen Tulette en Suze la Rousse."
    ],
    "es": [
      "De estilo románico, fue abandonada durante la Revolución y reconstruida completamente en 1835. Descubrirás esta capilla entre Tulette y Suze la Rousse."
    ]
  },
