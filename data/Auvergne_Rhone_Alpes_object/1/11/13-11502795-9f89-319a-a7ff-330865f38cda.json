  "rdfs:comment": {
    "de": [
      "Ein Team von leidenschaftlichen und erfahrenen Fluglehrern lässt Sie an der Freude des Gleitschirmfliegens über dem See von Annecy teilhaben."
    ],
    "en": [
      "A team of passionate and experienced instructors will share with you the pleasure of paragliding over Lake Annecy."
    ],
    "it": [
