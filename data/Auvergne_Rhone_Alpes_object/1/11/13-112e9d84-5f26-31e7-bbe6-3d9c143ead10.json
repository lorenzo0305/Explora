  "rdfs:comment": {
    "de": [
      "Gedenkgottesdienst um 10:30 Uhr. Zeremonie zum 60. Jahrestag der Feuereinstellung des Krieges in Algerien am 19. März 1962 um 11:30 Uhr am Kriegsdenkmal. Unter Beachtung der geltenden Gesundheitsvorschriften und der sozialen Distanzierung."
    ],
    "en": [
      "Remembrance mass at 10:30 a.m. Ceremony to mark the 60th anniversary of the ceasefire in Algeria on March 19, 1962 at 11:30 am, at the Monument aux Morts. In compliance with current health and social regulations."
    ],
    "it": [
      "Messa di commemorazione alle 10.30. Cerimonia in occasione del 60° anniversario della cessazione delle ostilità in Algeria il 19 marzo 1962 alle 11.30 al Monument aux Morts. Nel rispetto delle norme sanitarie e sociali vigenti."
    ],
    "fr": [
      "Messe souvenir à 10h30. Cérémonie pour le 60e anniversaire du cessez le feu de la Guerre en Algérie du 19 Mars 1962 à 11h30, au Monument aux Morts. Dans le respect des règles sanitaires et de distanciations sociales en vigueur."
    ],
    "es": [
      "Misa de conmemoración a las 10.30 h. Ceremonia de conmemoración del 60º aniversario del cese de las hostilidades en Argelia el 19 de marzo de 1962 a las 11h30 en el Monument aux Morts. En cumplimiento de la normativa sanitaria y social vigente."
    ],
    "nl": [
      "Herdenkingsmis om 10.30 uur. Plechtigheid ter gelegenheid van de 60e verjaardag van het staken van de vijandelijkheden in Algerije op 19 maart 1962 om 11.30 uur bij het Monument aux Morts. In overeenstemming met de huidige gezondheids- en sociale voorschriften."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Commémoration du 19 mars 1962 | Cérémonie du souvenir 60e anniversaire"
    ]
  },
