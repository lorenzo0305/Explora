  "rdfs:comment": {
    "de": [
      "Das Hotel liegt in einem ruhigen Wohnviertel, 10 Minuten vom Stadtzentrum entfernt. Das Team heißt Sie in einem komplett renovierten und gut ausgestatteten Hotel herzlich willkommen."
    ],
    "en": [
      "Located in a quiet residential area, 10 minutes from the city centre, the team warmly welcomes you in a fully renovated and well-equipped hotel."
    ],
    "it": [
      "Situato in una tranquilla zona residenziale, a 10 minuti dal centro città, il team vi accoglie calorosamente in un hotel completamente rinnovato e ben attrezzato."
    ],
    "fr": [
      "Situé dans un quartier résidentiel au calme, à 10 minutes du centre ville, l'équipe vous accueille chaleureusement dans un hôtel entièrement rénové et bien équipé."
    ],
    "es": [
      "Situado en una tranquila zona residencial, a 10 minutos del centro de la ciudad, el equipo le da una cálida bienvenida en un hotel totalmente renovado y bien equipado."
    ],
    "nl": [
      "Gelegen in een rustige woonwijk, op 10 minuten van het stadscentrum, heet het team u van harte welkom in een volledig gerenoveerd en goed uitgerust hotel."
    ]
  },
