  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné de Thodure. Wir können Sie für die Dauer eines Picknicks oder für eine Etappe in einem Biwak empfangen.\r\nEin Picknicktisch, eine Anbindestange für Pferde, ein Unterstand und Toilettenwasser stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Thodure. We can welcome you for a picnic or a bivouac.\r\nPicnic table, horse tie-up bar, shelter and toilet water are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné de Thodure. Possiamo ospitarvi per un picnic o un bivacco.\r\nUn tavolo da picnic, una barra per legare i cavalli, un riparo e l'acqua per i servizi igienici sono a vostra disposizione."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Thodure. Nous pouvons vous accueillir le temps d'un pique nique ou pour une étape en bivouac.\r\nTable de pique-nique, barre d'attache pour chevaux, abri, eau toilette sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné de Thodure. Je kunt bij ons terecht voor een picknick of een bivak.\r\nEen picknicktafel, een tui voor paarden, een schuilhut en toiletwater staan tot je beschikking."
    ],
    "es": [
      "Bienvenido al Relais Cyné de Thodure. Podemos acogerle para un picnic o un vivac.\r\nUna mesa de picnic, una barra de amarre para caballos, un refugio y agua sanitaria están a su disposición."
    ]
  },
