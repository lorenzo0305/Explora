  "rdfs:comment": {
    "de": [
      "Entdecken Sie das charmante Dorf Saint-Menoux auf spielerische Weise. Dieses Spiel basiert hauptsächlich auf Beobachtung.\r\nDie Gemeinde wird zu Ihrem Spielfeld und liefert Ihnen die Antworten. Halten Sie die Augen offen und spielen Sie mit!"
    ],
    "en": [
      "Have fun discovering the charming village of Saint-Menoux. This game is essentially based on observation.\r\nThe village becomes your playground, and the answers are yours to discover. Open your eyes wide and play!"
    ],
    "it": [
      "Divertitevi a esplorare l'affascinante villaggio di Saint-Menoux. Questo gioco si basa essenzialmente sull'osservazione.\r\nIl villaggio diventa il vostro parco giochi e le risposte sono tutte da scoprire. Tenete gli occhi ben aperti: tocca a voi giocare!"
    ],
    "fr": [
      "Découvrez le charmant village de Saint-Menoux en vous amusant. Ce jeu est essentiellement basé sur de l’observation. \r\nLa commune devient votre terrain de jeu et vous livre les réponses. Ouvrez grand les yeux et à vous de jouer !"
    ],
    "nl": [
      "Veel plezier met het verkennen van het charmante dorpje Saint-Menoux. Dit spel is voornamelijk gebaseerd op observatie.\r\nHet dorp wordt jouw speeltuin en de antwoorden zijn aan jou om te ontdekken. Houd je ogen wijd open en het is jouw beurt om te spelen!"
    ],
    "es": [
      "Diviértete explorando el encantador pueblo de Saint-Menoux. Este juego se basa esencialmente en la observación.\r\nEl pueblo se convierte en tu patio de recreo, y las respuestas son tuyas para que las descubras. Mantén los ojos bien abiertos y ¡te toca jugar!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste Saint-Menoux"
    ]
  },
