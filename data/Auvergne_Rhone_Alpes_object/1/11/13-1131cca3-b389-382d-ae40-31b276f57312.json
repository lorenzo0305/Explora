  "rdfs:comment": {
    "de": [
      "Die Gemeinde Matafelon-Granges ist mit vier Picknickplätzen ausgestattet. Dieser befindet sich in der Nähe des Rathauses und des Parkplatzes des City-Stadions."
    ],
    "en": [
      "The commune of Matafelon-Granges is equipped with 4 picnic areas, this one near the town hall and the city stadium parking lot."
    ],
    "it": [
      "Matafelon-Granges dispone di 4 aree picnic, questa vicino al municipio e al parcheggio dello stadio cittadino."
    ],
    "fr": [
      "La commune de Matafelon-Granges est équipée de 4 aires de pique-nique, celle-ci se trouve proche de la mairie et du parking du city stade."
    ],
    "nl": [
      "Matafelon-Granges heeft 4 picknickplaatsen, deze in de buurt van het gemeentehuis en de parkeerplaats van het stadsstadion."
    ],
    "es": [
      "Matafelon-Granges cuenta con 4 merenderos, éste cerca del ayuntamiento y el aparcamiento del estadio municipal."
    ]
  },
  "rdfs:label": {
