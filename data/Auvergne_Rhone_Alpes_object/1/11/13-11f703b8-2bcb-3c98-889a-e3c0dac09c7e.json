  "rdfs:comment": {
    "de": [
      "Das Team von La Cantina de Païs empfängt Sie jeden Tag auf der Terrasse gegenüber dem Schloss von Aubenas! Hier gibt es Tapas, Salate und ein bisschen Streetfood für den kleinen Hunger zwischendurch ! Und dazu ein kleines lokales Bier !"
    ],
    "en": [
      "The team at La Cantina de Païs welcomes you every day to their terrace facing the Château d'Aubenas! We'll be stopping by for Tapas, Salads and a bit of Streetfood if you're feeling peckish ! And don't forget to drink a little local craft beer !"
    ],
    "it": [
      "Il team de La Cantina de Païs vi accoglie ogni giorno sulla terrazza di fronte al Castello d'Aubenas! Fermatevi per gustare Tapas, insalate e un po' di Streetfood per uno spuntino! E non dimenticate di bere un po' di birra artigianale locale!"
    ],
    "fr": [
      "L'équipe de La Cantina de Païs vous reçoit tous les jours en terrasse face au Château d'Aubenas ! On s'y arrête pour des Tapas, des Salades et un chouill' de Streetfood pour les petites faims ! Et puis boire une p'tite Bière Artisanale locale quand même !"
    ],
    "nl": [
      "Het team van La Cantina de Païs verwelkomt je elke dag op hun terras met uitzicht op het Château d'Aubenas! We komen langs voor Tapas, Salades en wat Streetfood als je trek hebt ! En vergeet niet een beetje lokaal ambachtelijk bier te drinken !"
    ],
    "es": [
      "El equipo de La Cantina de Païs le da la bienvenida todos los días en la terraza frente al Castillo de Aubenas Pásese a degustar tapas, ensaladas y un poco de Streetfood para picar ¡Y no se olvide de beber un poco de cerveza artesanal local!"
    ]
  },
