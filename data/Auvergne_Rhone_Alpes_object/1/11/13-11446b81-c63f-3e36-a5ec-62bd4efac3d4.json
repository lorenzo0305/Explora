  "rdfs:comment": {
    "de": [
      "Legehennen, eine Herde Aubrac-Kühe, Getreide und eine Brotwerkstatt sind die vier Werkstätten, aus denen sich dieser Bauernhof zusammensetzt."
    ],
    "en": [
      "Laying hens, a herd of Aubrac cows, cereals and a bread workshop are the 4 workshops that make up this farm."
    ],
    "it": [
      "Galline ovaiole, una mandria di mucche di razza Aubrac, cereali e un laboratorio del pane sono i 4 laboratori che compongono questa fattoria."
    ],
    "fr": [
      "Poules pondeuses, troupeau de vaches Aubrac, céréales et atelier pain sont les 4 ateliers qui composent cette ferme."
    ],
    "nl": [
      "Legkippen, een kudde Aubrac koeien, granen en een broodatelier zijn de 4 werkplaatsen waaruit deze boerderij bestaat."
    ],
