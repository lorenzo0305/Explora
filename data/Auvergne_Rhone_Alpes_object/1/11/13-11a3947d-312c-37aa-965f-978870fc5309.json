  "rdfs:comment": {
    "de": [
      "Das Studium des menschlichen Körpers ist eine spannende Reise.\r\nIch schlage Ihnen vor, auf Entdeckungsreise zu gehen und die Heilpflanzen zu studieren, mit denen wir unser Leben teilen."
    ],
    "en": [
      "The study of the human body is a fascinating journey.\r\nI invite you to set off on a voyage of discovery and study the medicinal plants with which we share our lives."
    ],
    "it": [
      "Studiare il corpo umano è un viaggio affascinante.\r\nVi invito a partire per un viaggio di scoperta e a studiare le piante medicinali con cui condividiamo la nostra vita."
    ],
    "fr": [
      "L'étude du corps humain est un voyage passionnant.\r\nJe vous propose de partir à sa découverte et d'étudier les plantes médicinales avec qui nous partageons notre vie."
    ],
    "nl": [
      "Het bestuderen van het menselijk lichaam is een fascinerende reis.\r\nIk nodig je uit om op ontdekkingsreis te gaan en de geneeskrachtige planten te bestuderen waarmee we ons leven delen."
    ],
    "es": [
      "Estudiar el cuerpo humano es un viaje fascinante.\r\nLe invito a emprender un viaje de descubrimiento y a estudiar las plantas medicinales con las que compartimos nuestras vidas."
    ]
  },
