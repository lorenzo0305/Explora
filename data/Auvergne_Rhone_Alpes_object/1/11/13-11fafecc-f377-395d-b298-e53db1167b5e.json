  "rdfs:comment": {
    "de": [
      "Tun Sie sich etwas Gutes, verwöhnen Sie Ihre Energien und sublimieren Sie Ihre Schönheit in einem erfrischenden Moment mit 100% natürlichen und biologischen Kosmetika."
    ],
    "en": [
      "Let go, give free rein to your wonderful energies and enhance your beauty with a relaxing session of care and natural, organic cosmetics."
    ],
    "it": [
      "Non appena si apre la porta del giardino Serenity, un'atmosfera di calma vi invade\r\nDal 2007, Lisa vi accoglie in un luogo rigenerante che si concentra sul benessere dei suoi clienti."
    ],
    "fr": [
      "Dès que vous poussez la porte du jardin de Serenity, une atmosphère d'apaisement vous envahit. \r\nDepuis 2007, Lisa vous accueille dans un lieu ressourçant qui privilégie le bien-être de ses clients."
    ],
    "nl": [
      "Ontspan uzelf, laat uw mooie energieën doorschijnen en verrijk uw schoonheid \r\nmet 100% natuurlijke, biologische verzorgingsproducten en cosmetica."
    ],
    "es": [
      "Nada más abrir la puerta del jardín Serenity, una atmósfera de calma te invade\r\nDesde 2007, Lisa le da la bienvenida a un lugar rejuvenecedor que se centra en el bienestar de sus clientes."
    ]
  },
