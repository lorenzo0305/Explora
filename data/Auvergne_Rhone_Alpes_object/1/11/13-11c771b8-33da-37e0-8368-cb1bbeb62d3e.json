  "rdfs:comment": {
    "de": [
      "Von der Heugabel bis zur Gabel! Entdecken Sie unseren St Nectaire vom Bauernhof, der in natürlichen Höhlen gereift ist. Kostenlose Besichtigung der Herstellung jeden Tag um 9 Uhr (sonntags: nach Voranmeldung)."
    ],
    "en": [
      "Come and discover our farmhouse St Nectaire, matured in natural cellars. Free visit of the production from 9 to 10.30 am."
    ],
    "it": [
      "Dalla forchetta alla forchetta! Venite a scoprire i formaggi della nostra fattoria St Nectaire, stagionati in grotte naturali. Visita gratuita dell'impianto di produzione tutti i giorni alle 9.00 (domenica su prenotazione)."
    ],
    "fr": [
      "De la fourche à la fourchette ! Venez découvrir nos St Nectaire fermiers, affinés en caves naturelles. Visite gratuite de la fabrication tous les jours à 9h (le dimanche : sur réservation)."
    ],
    "nl": [
      "Van vork tot vork! Kom en ontdek onze boerenkazen St Nectaire, gerijpt in natuurlijke grotten. Gratis rondleiding door de productiefaciliteit elke dag om 9 uur (zondag op afspraak)."
    ],
    "es": [
      "Del tenedor al tenedor Venga a descubrir nuestros quesos de granja St Nectaire, madurados en cuevas naturales. Visita gratuita de las instalaciones de producción todos los días a las 9 h (domingos con cita previa)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Route des Caves, Ferme Roux Stéphane & Caroline"
    ]
  },
