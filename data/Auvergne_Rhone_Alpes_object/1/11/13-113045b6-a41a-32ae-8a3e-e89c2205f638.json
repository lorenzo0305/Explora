  "rdfs:comment": {
    "de": [
      "Das Konzert der Zauberer - Ensemble Instrumental des Volcans.\r\n\r\nTauchen Sie musikalisch in die Welt der Magie ein, rund um zwei Violinen, eine Viola, ein Cello, einen Pianisten und einen geheimnisvollen Geschichtenerzähler."
    ],
    "en": [
      "Le concert des sorciers - Ensemble Instrumental des Volcans.\r\n\r\nDive into the world of magic with two violins, a viola, a cello, a pianist and a mysterious storyteller."
    ],
    "it": [
      "Le concert des sorciers - Ensemble Instrumental des Volcans.\r\n\r\nFate un tuffo musicale nel mondo della magia con due violini, una viola, un violoncello, un pianista e un misterioso narratore."
    ],
    "fr": [
      "Le concert des sorciers - Ensemble Instrumental des Volcans. \r\n\r\nPlongez en musique dans l'univers de la magie autour de deux violons, un alto, un violoncelle, un pianiste, et un mystérieux raconteur d'histoires."
    ],
    "es": [
      "Le concert des sorciers - Ensemble Instrumental des Volcans.\r\n\r\nSumérjase en el mundo de la magia con dos violines, una viola, un violonchelo, un pianista y un misterioso cuentacuentos."
    ],
    "nl": [
      "Le concert des sorciers - Ensemble Instrumental des Volcans.\r\n\r\nNeem een muzikale duik in de wereld van magie met twee violen, een altviool, een cello, een pianist en een mysterieuze verteller."
    ]
  },
