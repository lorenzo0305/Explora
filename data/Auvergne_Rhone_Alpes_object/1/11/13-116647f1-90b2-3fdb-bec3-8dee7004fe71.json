  "rdfs:comment": {
    "de": [
      "Gesicherter Rodelbereich am oberen Ende der Seilbahn von Montalbert auf dem Plateau von Prajourdan.\r\nFreier Zugang für Kinder unter der Verantwortung der Eltern.\r\nBenötigt einen Fahrschein für den Zugang."
    ],
    "en": [
      "Safe tobogganing area at the top of the Montalbert gondola, on the Prajourdan plateau.\r\nFree access for children under parental responsibility.\r\nPass required for access."
    ],
    "it": [
      "Area sicura per slittini in cima alla funivia di Montalbert, sull'altopiano di Prajourdan.\r\nAccesso gratuito per i bambini sotto la responsabilità dei genitori.\r\nPer l'accesso è necessario un biglietto."
    ],
    "fr": [
      "Espace luge sécurisé situé au sommet de la télécabine de Montalbert, sur le plateau de Prajourdan.\r\nAccès libre aux enfants sous la responsabilité des parents.\r\nNécessite un titre de transport pour l'accès."
    ],
    "es": [
      "Zona segura para trineos en la parte superior del teleférico de Montalbert, en la meseta de Prajourdan.\r\nAcceso gratuito para los niños bajo responsabilidad parental.\r\nSe requiere un billete para acceder."
    ],
    "nl": [
      "Beveiligd rodelgebied bovenaan de Montalbert kabelbaan, op het Prajourdan plateau.\r\nGratis toegang voor kinderen onder ouderlijke verantwoordelijkheid.\r\nOm toegang te krijgen is een ticket nodig."
    ]
  },
  "rdfs:label": {
    "de": [
      "Rodelbereich - Fornelet-Gipfel"
    ],
    "en": [
      "Tobogganing area - Fornelet summit"
    ],
    "fr": [
      "Espace luge - Sommet de Fornelet"
    ],
    "nl": [
      "Rodelgebied - Top van Fornelet"
    ]
  },
