  "rdfs:comment": {
    "de": [
      "Issoire liegt in der Nähe der Autobahn 75 und am Eingang zu den Regionalen Naturparks Volcans d'Auvergne und Livradois-Forez und ist der ideale Zwischenstopp, um sich mit der Auvergne vertraut zu machen und die Umgebung zu erkunden."
    ],
    "en": [
      "Close to the A75 motorway and at the entrance to the Regional Natural Parks of the Volcanoes of Auvergne and Livradois-Forez, Issoire is the ideal stopover to discover Auvergne and discover the surrounding area."
    ],
    "it": [
      "Vicino all'autostrada 75 e all'ingresso dei parchi naturali regionali Volcans d'Auvergne e Livradois-Forez, Issoire è la base ideale per esplorare l'Alvernia e i dintorni."
    ],
    "fr": [
      "A proximité de l'autoroute 75 et à l'entrée des Parcs Naturels Régionaux des Volcans d'Auvergne et du Livradois-Forez, Issoire est l'escale idéale pour s'initier à l'Auvergne et rayonner dans les environs."
    ],
    "nl": [
      "Dicht bij snelweg 75 en bij de ingang van de regionale natuurparken Volcans d'Auvergne en Livradois-Forez, is Issoire de ideale uitvalsbasis om de Auvergne en de omgeving te verkennen."
    ],
    "es": [
      "Cerca de la autopista 75 y a la entrada de los Parques Naturales Regionales de los Volcanes de Auvernia y Livradois-Forez, Issoire es la base ideal para explorar Auvernia y sus alrededores."
    ]
  },
  "rdfs:label": {
    "en": [
      "Issoire City - Most Beautiful City Of France®"
    ],
    "fr": [
      "Ville d'Issoire - Plus Beau Détour de France®"
    ]
  },
