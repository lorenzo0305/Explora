  "rdfs:comment": {
    "de": [
      "Als professionelle Kunstmalerin bietet Ihnen Véronica eine große Auswahl für Ihre verschiedenen Projekte zur Realisierung von Kunstwerken. Von Stein- und Erdskulpturen über Öl-, Acryl- und Kohlemalerei bis hin zu Pastellkreiden etc."
    ],
    "en": [
      "Véronica is a professional painter who offers a wide range of choices for your various art projects. From sculpture on stone and clay, to oil, acrylic, charcoal and pastel painting..."
    ],
    "it": [
      "Véronica è una pittrice professionista che offre un'ampia gamma di opzioni per i vostri progetti artistici. Dalla scultura su pietra e argilla alla pittura a olio, acrilico, carboncino e pastello."
    ],
    "fr": [
      "Artiste-peintre professionnelle, Véronica vous propose un large choix pour vos divers projets de réalisation d'art. De la sculpture sur pierre et terre, en passant par la peinture à huile, acrylique, fusain, pastels etc..."
    ],
    "nl": [
      "Véronica is een professionele schilderes die een breed scala aan mogelijkheden biedt voor uw verschillende kunstprojecten. Van beeldhouwen op steen en klei tot schilderen met olieverf, acryl, houtskool en pastel."
    ],
    "es": [
      "Véronica es una pintora profesional que ofrece una amplia gama de opciones para sus diversos proyectos artísticos. Desde escultura en piedra y arcilla hasta pintura al óleo, acrílico, carboncillo y pastel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Artiste-Peintre Véronica Gaglio"
    ]
  },
