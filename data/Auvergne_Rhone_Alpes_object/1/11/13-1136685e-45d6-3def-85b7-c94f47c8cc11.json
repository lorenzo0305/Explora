  "rdfs:comment": {
    "de": [
      "Drip Social Coffee Club ist vor allem ein Ort, an dem sich alles um Spezialitätenkaffee dreht, damit jeder sich treffen, austauschen und einen angenehmen Moment teilen kann."
    ],
    "en": [
      "Drip Social Coffee Club is first and foremost a place where people can meet, exchange ideas and share a pleasant moment around a specialty coffee."
    ],
    "it": [
      "Drip Social Coffee Club è prima di tutto un luogo dove le persone possono incontrarsi, chiacchierare e condividere un buon momento davanti a un caffè speciale."
    ],
    "fr": [
      "Drip Social Coffee Club c’est avant tout un lieu de vie tourné autour du café de spécialité pour chacun puisse se rencontrer, échanger et partager un moment agréable."
    ],
    "nl": [
      "Drip Social Coffee Club is in de eerste plaats een plek waar mensen elkaar kunnen ontmoeten, een praatje kunnen maken en een leuke tijd kunnen delen onder het genot van een koffiespecialiteit."
    ],
    "es": [
      "Drip Social Coffee Club es, ante todo, un lugar donde la gente puede reunirse, charlar y compartir un buen rato tomando una especialidad de café."
    ]
  },
