  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0cf60eb5-f817-3906-bf02-a6679d10de78",
      "dc:description": {
        "de": [
          "Handwerkliche Herstellung von Kerzen, Fondants, Paletten für Schränke, parfümiert, natürlich mit pflanzlichem Rapswachs ohne Palmen oder Zusatzstoffe mit Parfüms, die in Grasses ohne CMR oder Phthalate entwickelt wurden.\nNicht an Tieren getestet - in Frankreich hergestellt"
        ],
        "en": [
          "Artisanal creation of natural, scented candles, fondants and wardrobe pebbles made from palm-free vegetable rapeseed wax, with no additives and no CMR or phthalate-free fragrances.\nNot tested on animals - made in France"
        ],
        "it": [
          "Creazione artigianale di candele, fondenti, palets d'armoires, profumati, naturali con cera di colza vegetale senza palma né additivi ai profumi elaborati in Erba senza CMR né ftalati.\nNon testato su animali - prodotto in Francia"
        ],
        "fr": [
          "Création artisanal de bougies, fondants, palets d'armoires, parfumés, naturels à la cire de colza végétale sans palme ni additif aux parfums élaborés à Grasses sans CMR ni phtalate.\nNon testées sur les animaux - fabriquées en France"
        ],
        "es": [
          "Creación artesanal de velas, fondants, palets d'armoires, perfumados, naturales con cera de colza vegetal sin palma ni aditivo a los perfumes elaborados en Pastos sin CMR ni phtalate.\nNo testado en animales - made in France"
        ],
        "nl": [
          "Ambachtelijke creatie van kaarsen, fondants, palets d'armoires, geparfumeerd, natuurlijk met plantaardige colza wax zonder palm noch additief aan de parfums uitgewerkt in Grasses zonder CMR noch ftalaat.\nNiet getest op dieren - gemaakt in Frankrijk"
        ]
      },
      "@type": [
        "Description"
      ],
