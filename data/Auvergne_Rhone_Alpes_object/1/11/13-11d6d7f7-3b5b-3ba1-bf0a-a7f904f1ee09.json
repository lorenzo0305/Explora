  "rdfs:comment": {
    "de": [
      "In Les Halles trifft man sich mit Freunden, der Familie oder zwischen zwei Abfahrten!\r\nIn unserer Brasserie im Herzen von Morzine erwartet Sie eine freundliche und herzliche Atmosphäre, in der Sie eine großzügige und hausgemachte Küche genießen können."
    ],
    "en": [
      "At Les Halles, you can meet up with friends, family or between two runs!\r\nIn a warm and friendly atmosphere, our brasserie welcomes you to the heart of Morzine to enjoy generous, home-cooked cuisine."
    ],
    "it": [
      "Les Halles è un luogo ideale per incontrarsi con gli amici, la famiglia o tra due discese!\r\nIn un'atmosfera calda e accogliente, la nostra brasserie vi accoglie nel cuore di Morzine per gustare una cucina generosa e casalinga."
    ],
    "fr": [
      "Aux Halles, on s’y retrouve entre amis, en famille ou entre deux descentes !\r\nDans une ambiance conviviale et chaleureuse, notre brasserie vous accueille au cœur de Morzine pour savourer une cuisine généreuse et faite maison."
    ],
    "es": [
      "Les Halles es un lugar ideal para reunirse con los amigos, la familia o entre dos descensos\r\nEn un ambiente cálido y acogedor, nuestra brasserie le da la bienvenida al corazón de Morzine para disfrutar de una cocina casera y generosa."
    ],
    "nl": [
      "Bij Les Halles kunt u afspreken met vrienden, familie of tussen twee runs in!\r\nIn een warme en gezellige sfeer, verwelkomt onze brasserie u in het hart van Morzine om te genieten van royale, huisgemaakte gerechten."
    ]
  },
