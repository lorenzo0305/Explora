  "rdfs:comment": {
    "de": [
      "Verkauf von Käse und regionalen gastronomischen Produkten. Produktion von Tome des Bauges und Abondance. Entdeckung des Produktionsprozesses durch einen verglasten Bereich am Vormittag, Museumsbereich und Film auf Anfrage."
    ],
    "en": [
      "Sale of cheeses and local produce. Production of Tome des Bauges, vacherin and Abondance. Watch the production process from a glazed area every morning from 9-10.00 a.m."
    ],
    "it": [
      "Vendita di formaggi e prodotti gastronomici regionali. Produzione di Tome des Bauges e Abondance. Scoperta del processo produttivo attraverso un'area vetrata al mattino, area museale e film su richiesta."
    ],
    "fr": [
      "Vente de fromages et produits gastronomiques régionaux. Fabrication de la Tome des Bauges et de l'Abondance. Découverte de la fabrication à travers un espace vitré le matin, espace muséographique et film sur demande."
    ],
    "nl": [
      "Verkoop van kazen en regionale gastronomische producten. Productie van Tome des Bauges en Abondance. Ontdekking van het productieproces via een glazen ruimte in de ochtend, museumruimte en film op aanvraag."
    ],
    "es": [
      "Venta de quesos y productos gastronómicos regionales. Producción de Tome des Bauges y Abondance. Descubrimiento del proceso de producción a través de una zona acristalada por la mañana, zona de museo y película a petición."
    ]
  },
