  "rdfs:comment": {
    "de": [
      "Kommentierte Besichtigung des Ateliers mit dem Schwerpunktthema Upcycling Art . Das Atelier Marie Thivrier bietet ihre Möbel, Objekte und Skulpturen aus Karton und ihre künstlerischen Arbeiten in lateinischer Kalligraphie und Gravur an."
    ],
    "en": [
      "Guided tour of the workshop on the central theme of upcycling art. The Marie Thivrier workshop offers cardboard furniture, objects and sculptures, as well as Latin calligraphy and engraving."
    ],
    "it": [
      "Visita guidata del laboratorio sul tema centrale dell'arte dell'upcycling. Il laboratorio Marie Thivrier propone mobili, oggetti e sculture in cartone, oltre a calligrafia e incisione latina."
    ],
    "fr": [
      "Visite commentée de l'atelier sur le thème central de l'upcycling art . L'atelier Marie Thivrier propose ses meubles, objets et sculptures en carton et ses travaux artistiques en calligraphie latine et gravure."
    ],
    "es": [
      "Visita guiada al taller sobre el tema central del arte del upcycling. El taller Marie Thivrier ofrece muebles, objetos y esculturas de cartón, así como caligrafía latina y grabado."
    ],
    "nl": [
      "Rondleiding door de werkplaats met als centraal thema upcyclingkunst. De werkplaats van Marie Thivrier biedt kartonnen meubels, objecten en sculpturen, maar ook Latijnse kalligrafie en gravure."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Marie Thivrier : Calligraphie, gravure, sculpture et meubles en carton"
    ]
  },
