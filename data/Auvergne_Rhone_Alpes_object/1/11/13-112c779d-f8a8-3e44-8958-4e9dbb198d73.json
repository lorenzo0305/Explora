  "rdfs:comment": {
    "de": [
      "Wir bieten Quad-Touren mit Führer (halbtags oder ganztags) und ein Angebot an Quad-Aufenthalten für Gruppen bis zu 20 Personen (Aufenthalte, die Unterkunft und Quad-Touren mit Führer beinhalten)."
    ],
    "en": [
      "We offer guided quad rides (half-day or full-day), and quad holidays for groups of up to 20 people (including accommodation and guided quad rides)."
    ],
    "it": [
      "Offriamo tour guidati in quad (mezza giornata o giornata intera) e vacanze in quad per gruppi fino a 20 persone (compresi alloggio e tour guidati in quad)."
    ],
    "fr": [
      "Nous proposons des randonnées quad avec guide (à la demi-journée ou à la journée), et une offre de séjours quad pour les groupes jusqu'à 20 personnes (séjours comprenant l'hébergement et les randonnées quad avec guide)."
    ],
    "nl": [
      "We bieden begeleide quadtochten (halve of hele dag) en quadvakanties voor groepen tot 20 personen (inclusief accommodatie en begeleide quadtochten)."
    ],
    "es": [
      "Ofrecemos excursiones guiadas en quad (de medio día o de día completo) y vacaciones en quad para grupos de hasta 20 personas (incluido el alojamiento y las excursiones guiadas en quad)."
    ]
  },
