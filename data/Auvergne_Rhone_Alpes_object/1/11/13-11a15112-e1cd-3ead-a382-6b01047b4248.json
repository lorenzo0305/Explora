  "rdfs:comment": {
    "de": [
      "Wir halten etwa 100 Milchschafe in Biohaltung. Wir stellen Käse (Tommes, aromatisierte Tommes Typ Feta, Typ Pérails, Blauschimmelkäse...) und Frischprodukte (Joghurt, Eierpudding und Dessertcreme) her."
    ],
    "en": [
      "We raise around a hundred organic dairy sheep. We produce cheeses (tommes, flavored tommes such as feta, pérails, blue...) and fresh products (yogurts, egg flans and dessert cream)."
    ],
    "it": [
      "Alleviamo un centinaio di pecore da latte biologiche. Produciamo formaggi (tomini, tomi aromatizzati come feta, pérails, blu, ecc.) e prodotti freschi (yogurt, creme all'uovo e creme da dessert)."
    ],
    "fr": [
      "Nous élevons une centaine de brebis laitière en bio. Nous fabriquons des fromages (tommes, tommes aromatisées type feta, type pérails, bleu...) et des produits frais (yaourts, flans aux oeufs et crème dessert)."
    ],
    "nl": [
      "We houden ongeveer honderd biologische melkschapen. We maken kazen (tommes, gearomatiseerde tommes zoals feta, pérails, blauw, enz.) en verse producten (yoghurt, eierpudding en dessertroom)."
    ],
    "es": [
      "Criamos un centenar de ovejas lecheras ecológicas. Elaboramos quesos (tommes, tommes aromatizados como el feta, el pérails, el azul, etc.) y productos frescos (yogures, flanes de huevo y crema de postre)."
    ]
  },
