  "rdfs:comment": {
    "de": [
      "Seit 1926, vom Vater auf den Sohn, empfängt Sie das Restaurant Bonnier in seinem gemütlichen Lokal mit familiärer Atmosphäre, um Ihnen seine köstliche regionale Küche zu präsentieren."
    ],
    "en": [
      "Since 1926, from father to son, the Restaurant Bonnier welcomes you in its warm establishment, with a family atmosphere, to make you discover its delicious local cuisine."
    ],
    "it": [
      "Dal 1926, di padre in figlio, il Ristorante Bonnier vi accoglie nel suo accogliente locale, dall'atmosfera familiare, per farvi scoprire la sua deliziosa cucina locale."
    ],
    "fr": [
      "Depuis 1926, de père en fils, le Restaurant Bonnier vous accueille dans son établissement chaleureux, à l’ambiance familiale, pour vous faire découvrir sa délicieuse cuisine du terroir."
    ],
    "nl": [
      "Sinds 1926, van vader op zoon, ontvangt het Restaurant Bonnier u in zijn warme zaak, met een familiale sfeer, om u zijn heerlijke streekgerechten te laten ontdekken."
    ],
    "es": [
      "Desde 1926, de padre a hijo, el Restaurante Bonnier le acoge en su cálido establecimiento, de ambiente familiar, para hacerle descubrir su deliciosa cocina local."
    ]
  },
  "rdfs:label": {
