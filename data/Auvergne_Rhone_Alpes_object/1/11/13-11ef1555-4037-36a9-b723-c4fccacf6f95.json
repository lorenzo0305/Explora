  "rdfs:comment": {
    "de": [
      "Genießen Sie den Karneval in Chamonix unter dem Motto \"Märchen\"!\r\nAuf dem Programm stehen: Spiele, Schminken, Erfrischungsstände, Mini-Boom und kostümierte Umzüge."
    ],
    "en": [
      "Enjoy the fairytale-themed Chamonix Carnival!\r\nOn the program: games, face-painting, refreshments, mini-boom and costume parade."
    ],
    "it": [
      "Godetevi il Carnevale di Chamonix a tema fiabesco!\r\nIn programma: giochi, face painting, rinfreschi, mini-boom e sfilata in costume."
    ],
    "fr": [
      "Profitez du Carnaval de Chamonix sur le thème des contes ! \r\nAu programme : Jeux, maquillage, buvette, mini boom et déambulation costumée."
    ],
    "nl": [
      "Geniet van het sprookjesachtige carnaval in Chamonix!\r\nOp het programma: spelletjes, schminken, versnaperingen, miniboom en gekostumeerde optocht."
    ],
    "es": [
      "Disfrute del Carnaval de Chamonix, un carnaval de cuento de hadas\r\nEn el programa: juegos, pintacaras, refrescos, mini-boom y desfile de disfraces."
    ]
  },
