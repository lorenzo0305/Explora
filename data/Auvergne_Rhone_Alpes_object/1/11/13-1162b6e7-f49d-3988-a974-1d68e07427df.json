  "rdfs:comment": {
    "de": [
      "Das Bistro von Guillaume bietet eine raffinierte Bistroküche aus frischen lokalen Produkten. Schöne Terrasse, privater Salon, Feinkostladen und gesellige Atmosphäre."
    ],
    "en": [
      "Guillaume's bistro offers a refined bistronomic cuisine based on fresh local products. Beautiful terrace, private lounge, delicatessen and friendly atmosphere."
    ],
    "it": [
      "Il bistrot di Guillaume offre una raffinata cucina bistronomica a base di prodotti freschi locali. Splendida terrazza, sala privata, gastronomia e atmosfera amichevole."
    ],
    "fr": [
      "Le bistrot de Guillaume offre une cuisine bistronomique raffinée à base de produits locaux frais. Belle terrasse, salon privatif, épicerie fine et ambiance conviviale."
    ],
    "nl": [
      "Guillaume's bistro biedt een verfijnde bistronomische keuken op basis van verse streekproducten. Mooi terras, privé salon, delicatessen en vriendelijke sfeer."
    ],
    "es": [
      "El bistró de Guillaume ofrece una refinada cocina bistronómica basada en productos locales frescos. Bonita terraza, salón privado, delicatessen y ambiente agradable."
    ]
  },
  "rdfs:label": {
