  "rdfs:comment": {
    "de": [
      "Die CAPI-Mediathek in Meyrié empfängt Sie dienstags, mittwochs und samstags. Hier finden Sie eine große Auswahl an Sammlungen (Bücher, Abonnements, CDs, DVDs)."
    ],
    "en": [
      "The CAPI media library in Meyrié welcomes you on Tuesdays, Wednesdays and Saturdays. You will find a wide choice of collections (books, subscriptions, CDs, DVDs)."
    ],
    "it": [
      "La mediateca CAPI di Meyrié vi accoglie il martedì, il mercoledì e il sabato. Troverete un'ampia scelta di collezioni (libri, abbonamenti, CD, DVD)."
    ],
    "fr": [
      "La médiathèque CAPI de Meyrié vous accueille le mardi, le mercredi et le samedi. Vous trouverez un large choix de collections (livres, abonnements, CD, DVD)."
    ],
    "es": [
      "La mediateca del CAPI de Meyrié le acoge los martes, miércoles y sábados. Encontrará una gran variedad de colecciones (libros, suscripciones, CDs, DVDs)."
    ],
    "nl": [
      "De mediatheek van CAPI in Meyrié ontvangt u op dinsdag, woensdag en zaterdag. U vindt er een ruime keuze aan collecties (boeken, abonnementen, cd's, dvd's)."
    ]
  },
