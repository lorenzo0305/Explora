  "rdfs:comment": {
    "de": [
      "Bei Loc Skis Oz? Ekosport Rent, profitieren Sie von einer großen Auswahl an Skiern, Snowboards und der neuesten Ausrüstung. Professionelle Beratung, Bootfitting und Textilbereich: alles für ein angenehmes Bergerlebnis mit der Familie oder mit Freunden."
    ],
    "en": [
      "Hire and sales of ski equipment, clothing and accessories are available at the foot of the slopes."
    ],
    "it": [
      "Da Loc Skis Oz? Ekosport Rent, approfittate di un'ampia scelta di sci, snowboard e attrezzature di ultima generazione. Consulenza professionale, adattamento degli scarponi e abbigliamento: tutto ciò che serve per vivere al meglio la montagna, con la famiglia o con gli amici."
    ],
    "fr": [
      "Chez Loc Skis Oz – Ekosport Rent, profitez d’un large choix de skis, snowboards et équipements récents. Conseils pros, bootfitting et espace textile : tout pour vivre une expérience montagne agréable, en famille ou entre amis."
    ],
    "nl": [
      "Verhuur en verkoop van skimateriaal, kleding en accessoires zijn beschikbaar aan de voet van de pistes."
    ],
    "es": [
      "En Loc Skis Oz? Ekosport Rent, aprovéchate de una amplia selección de lo último en esquís, tablas de snowboard y equipamiento. Asesoramiento profesional, adaptación de botas y ropa: todo lo que necesitas para una gran experiencia en la montaña, con la familia o los amigos."
    ]
  },
