  "rdfs:comment": {
    "de": [
      "Die MéMO stellt fast 80.000 Dokumente zur Verfügung, die Sie ausleihen oder vor Ort konsultieren können: Bücher, Zeitschriften und Zeitungen, DVDs, Lesegeräte, mp3-Player. Sie verfügt über Arbeitsräume und Internetzugangsstationen und hat einen sehr reichen Bestand an Kulturgütern."
    ],
    "en": [
      "The MEMO makes available nearly 80,000 documents to be borrowed or consulted on site: books, magazines and newspapers, DVDs, readers, mp3 players. It has workspaces and internet access stations and has a very rich heritage collection."
    ],
    "it": [
      "Il MÉMO offre quasi 80.000 documenti da prendere in prestito o consultare in loco: libri, riviste e giornali, DVD, dispositivi di lettura, lettori mp3. Dispone di spazi di lavoro e di postazioni per l'accesso a Internet e ha una collezione di beni culturali molto ricca."
    ],
    "fr": [
      "La MéMO met à disposition près de 80000 documents à emprunter ou consulter sur place : livres, revues et journaux, DVD, liseuses, lecteurs mp3. Elle dispose d'espaces de travail et de postes d'accès à internet et dispose d'un fonds patrimonial très riche."
    ],
    "nl": [
      "Het MÉMO biedt bijna 80.000 documenten om ter plaatse te lenen of te raadplegen: boeken, tijdschriften en kranten, dvd's, leesapparatuur, mp3-spelers. Het beschikt over werkplekken en internetstations en heeft een zeer rijke erfgoedcollectie."
    ],
    "es": [
      "El MÉMO ofrece cerca de 80.000 documentos para prestar o consultar in situ: libros, revistas y periódicos, DVD, dispositivos de lectura, reproductores de mp3. Dispone de espacios de trabajo y puestos de acceso a Internet y cuenta con una colección patrimonial muy rica."
    ]
  },
  "rdfs:label": {
    "fr": [
