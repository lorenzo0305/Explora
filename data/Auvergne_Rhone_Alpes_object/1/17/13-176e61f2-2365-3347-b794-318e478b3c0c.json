  "rdfs:comment": {
    "de": [
      "Stele, die Jean CHASTEL gewidmet ist, der die Bestie am 19. Juni 1767 tötete.\r\nRuinen des Château du Besset aus dem 14. und 16. Jahrhundert.\r\n Überreste eines befestigten Hauses in Pompeyrin.\r\n Schloss Chamblard."
    ],
    "en": [
      "Stele dedicated to Jean CHASTEL, who killed the Beast on June 19, 1767.\r\nRuins of the 14th- and 16th-century Château du Besset.\r\n Remains of a fortified house at Pompeyrin.\r\n Château de Chamblard."
    ],
    "it": [
      "Stele dedicata a Jean CHASTEL che uccise la Bestia il 19 giugno 1767.\r\nRovine del Château du Besset del XIV e XVI secolo.\r\n Resti di una casa fortificata a Pompeyrin.\r\n Castello di Chamblard."
    ],
    "fr": [
      "Stèle dédiée à Jean CHASTEL qui tua la Bête le 19 juin 1767.\r\nRuines du château du Besset des XIVe et XVIe siècles.\r\n Vestiges d’une maison forte à Pompeyrin.\r\n Château de Chamblard."
    ],
    "nl": [
      "Stele gewijd aan Jean CHASTEL die op 19 juni 1767 het Beest doodde.\r\nRuïnes van het kasteel van Besset uit de 14e en 16e eeuw.\r\n Overblijfselen van een versterkte woning in Pompeyrin.\r\n Kasteel van Chamblard."
    ],
    "es": [
      "Estela dedicada a Jean CHASTEL que mató a la Bestia el 19 de junio de 1767.\r\nRuinas del Château du Besset de los siglos XIV y XVI.\r\n Restos de una casa fortificada en Pompeyrin.\r\n Castillo de Chamblard."
    ]
  },
