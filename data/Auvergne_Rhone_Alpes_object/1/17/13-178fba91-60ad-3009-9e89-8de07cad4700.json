  "rdfs:comment": {
    "de": [
      "Raffinierte Küche aus lokalen und saisonalen Produkten, die als warmes und kaltes All-you-can-eat-Buffet serviert wird. Frühstück für Feinschmecker. Terrasse mit atemberaubendem Blick auf die Schluchten der Ardèche. Gesellige und herzliche Atmosphäre. Restaurant für alle offen"
    ],
    "en": [
      "Refined cuisine based on local, seasonal produce, served as an all-you-can-eat hot and cold buffet. Gourmet breakfast. Terrace with breathtaking views of the Ardèche Gorges. Warm, friendly atmosphere. Restaurant open to all"
    ],
    "it": [
      "Cucina raffinata a base di prodotti locali e stagionali, servita a buffet caldo e freddo. Colazione gourmet. Terrazza con vista mozzafiato sulle Gole dell'Ardèche. Atmosfera calda e accogliente. Ristorante aperto a tutti"
    ],
    "fr": [
      "Cuisine raffinée à base de produits locaux et de saison, servie en buffet à volonté chaud et froid. Petit-déjeuner gourmand. Terrasse avec vue imprenable sur les Gorges de l’Ardèche. Ambiance conviviale et chaleureuse. Restaurant ouvert à tous"
    ],
    "nl": [
      "Verfijnde keuken op basis van lokale en seizoensproducten, geserveerd als een all-you-can-eat warm en koud buffet. Uitgebreid ontbijt. Terras met adembenemend uitzicht op de Gorges de l'Ardèche. Warme en vriendelijke sfeer. Restaurant open voor iedereen"
    ],
    "es": [
      "Cocina refinada basada en productos locales y de temporada, servida en forma de bufé caliente y frío. Desayuno gastronómico. Terraza con impresionantes vistas a las gargantas del Ardèche. Ambiente cálido y acogedor. Restaurante abierto a todos"
    ]
  },
