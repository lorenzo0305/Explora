  "rdfs:comment": {
    "de": [
      "45 Minuten lang zeigt Ihnen der Fächerkünstler Frédérick Yvan Manuel Gay in einer Vorführung \"Geschichte, Plissieren, Schneiden und Montieren eines Fächers\"!"
    ],
    "en": [
      "For 45 minutes, fan-maker Frédérick Yvan Manuel Gay will demonstrate the history, pleating, cutting and assembly of a fan!"
    ],
    "it": [
      "Per 45 minuti, Frédérick Yvan Manuel Gay, costruttore di ventagli, vi darà una dimostrazione sulla storia, la plissettatura, il taglio e l'assemblaggio di un ventaglio!"
    ],
    "fr": [
      "Pendant 45 minutes, Frédérick Yvan Manuel Gay, plasticien éventailliste, vous propose une démonstration \"Histoire, plissage, coupe et montage d'un éventail\" !"
    ],
    "nl": [
      "Gedurende 45 minuten geeft Frédérick Yvan Manuel Gay, waaiermaker, je een demonstratie over de geschiedenis, het plooien, snijden en in elkaar zetten van een waaier!"
    ],
    "es": [
      "Durante 45 minutos, Frédérick Yvan Manuel Gay, fabricante de abanicos, le hará una demostración sobre la historia, el plisado, el corte y el montaje de un abanico"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Démonstration \"Histoire, plissage, coupe et montage d'un éventail\" #6 - Journées Européennes des Métiers d'Art"
    ]
  },
