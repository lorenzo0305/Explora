        "de": [
          "Crédit Mutuel: Die Bank, mit der man über Auto-, Immobilien-, Verbraucher- und Leasingkredite, Versicherungen, Geldanlagen, Online-Kostenvoranschläge... sprechen kann."
        ],
        "en": [
          "Crédit Mutuel: The bank to talk to about car loans, real estate, consumer credit, leasing, insurance, investments, online quotes..."
        ],
        "it": [
          "Crédit Mutuel: la banca con cui parlare di prestiti auto, mutui, credito al consumo, leasing, assicurazioni, investimenti, preventivi online..."
        ],
        "fr": [
          "Crédit Mutuel : La banque à qui parler crédit auto, immobilier, consommation, crédit bail, assurances, placements, devis en ligne..."
        ],
        "es": [
          "Crédit Mutuel: el banco con el que hablar de préstamos para automóviles, hipotecas, créditos al consumo, leasing, seguros, inversiones, presupuestos en línea..."
        ],
        "nl": [
          "Crédit Mutuel: De bank om mee te praten over autoleningen, hypotheken, consumentenkrediet, leasing, verzekeringen, beleggingen, online offertes..."
