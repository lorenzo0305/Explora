  "rdfs:comment": {
    "de": [
      "Sébastien Perrier, Bergführer und Ethnobotaniker, bietet Ihnen das ganze Jahr über die Möglichkeit, die Chartreuse mit Ihren 5 Sinnen zu entdecken, sei es bei einem spielerischen Spaziergang oder einem Workshop."
    ],
    "en": [
      "Sébastien Perrier, mountain guide and ethnobotanist, invites you to discover the Chartreuse with your 5 senses all year round, for a fun walk or workshop."
    ],
    "it": [
      "Sébastien Perrier, guida alpina ed etnobotanico, vi invita a scoprire la Chartreuse con i vostri 5 sensi tutto l'anno, durante una passeggiata divertente o un laboratorio."
    ],
    "fr": [
      "Sébastien Perrier, accompagnateur en montagne et ethnobotaniste, vous propose de découvrir la Chartreuse avec vos 5 sens tout au long de l’année, le temps d’une balade ludique ou d‘un atelier."
    ],
    "es": [
      "Sébastien Perrier, guía de montaña y etnobotánico, le invita a descubrir la Chartreuse con los 5 sentidos todo el año, durante un divertido paseo o taller."
    ],
    "nl": [
      "Sébastien Perrier, berggids en etnobotanicus, nodigt je uit om de Chartreuse het hele jaar door met je 5 zintuigen te ontdekken tijdens een leuke wandeling of workshop."
    ]
  },
  "rdfs:label": {
