  "rdfs:comment": {
    "de": [
      "Freier Besuch mit Dokument. Schlüssel im Rathaus anfordern.\r\nDie Kirche wurde 1888 im neoromanischen Stil wieder aufgebaut.\r\nDie im 12. Jahrhundert erbaute Vorgängerkirche wurde während der Revolution abgerissen."
    ],
    "en": [
      "Free visit with document. Ask for the keys at the Town Hall.\r\nChurch rebuilt in 1888 in neo-Romanesque style.\r\nThe previous church, built in the 12th century, was razed to the ground during the Revolution."
    ],
    "it": [
      "Visita gratuita con documento. Chiedete le chiavi al Municipio.\r\nChiesa ricostruita nel 1888 in stile neoromanico.\r\nLa chiesa precedente, costruita nel XII secolo, fu rasa al suolo durante la Rivoluzione."
    ],
    "fr": [
      "Visite libre avec document. Demander les clés à la Mairie.\r\nÉglise reconstruite en 1888 de style néo-roman.\r\nLa précédente église édifiée au XIIe siècle a été rasée à la Révolution."
    ],
    "es": [
      "Visita gratuita con documento. Pida las llaves en el Ayuntamiento.\r\nIglesia reconstruida en 1888 en estilo neorrománico.\r\nLa anterior iglesia, construida en el siglo XII, fue arrasada durante la Revolución."
    ],
    "nl": [
      "Gratis bezoek met document. Vraag naar de sleutels op het stadhuis.\r\nKerk herbouwd in 1888 in neoromaanse stijl.\r\nDe vorige kerk uit de 12e eeuw werd tijdens de Revolutie met de grond gelijk gemaakt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Jacques"
    ]
  },
