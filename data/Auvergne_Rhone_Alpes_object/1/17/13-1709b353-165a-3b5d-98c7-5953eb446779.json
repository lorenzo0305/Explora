  "rdfs:comment": {
    "de": [
      "Die Seilbahn von Vallorcine bringt Sie auf 2270 m Höhe, wo Sie die Aussicht sowohl auf die Schweizer Seite als auch auf das Chamonix-Tal genießen können."
    ],
    "en": [
      "The Vallorcine cable car takes you to 2270m between the French and Swiss side of the mountain."
    ],
    "it": [
      "La funivia di Vallorcine permette di raggiungere un'altitudine di 2270 metri per godere della vista sul versante svizzero e sulla valle di Chamonix."
    ],
    "fr": [
      "La télécabine de Vallorcine vous permet d'accéder à 2270 mètres d'altitude pour profiter de la vue aussi bien côté Suisse que sur la Vallée de Chamonix."
    ],
    "nl": [
      "Met de Vallorcine kabelbaan kunt u een hoogte van 2270 meter bereiken om te genieten van het uitzicht op zowel de Zwitserse kant als de vallei van Chamonix."
    ],
    "es": [
      "El teleférico de Vallorcine permite alcanzar una altura de 2.270 metros para disfrutar de las vistas tanto del lado suizo como del valle de Chamonix."
    ]
  },
