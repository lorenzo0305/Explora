  "rdfs:comment": {
    "de": [
      "Das Restaurant des Hotels Courcheneige, 'La Brasserie De Laroche', und seine große, sagenhafte Terrasse bieten Ihnen den ganzen Tag über einen entspannten Service mit leckeren Speisen."
    ],
    "ru": [
      "В ресторане La Brasserie De Laroche отеля Courcheneige с его знаменитой большой террасой можно поесть в непринужденной обстановке в любое время дня."
    ],
    "en": [
      "The Hotel Courcheneige’s restaurant, the ‘De Laroche Brasserie', and its reknowned, spacious terrace, champion relaxed all-day dining in a magnificent setting with spectacular views of the surrounding snow-capped peaks."
    ],
    "it": [
      "Il ristorante dell'Hotel Courcheneige, La Brasserie De Laroche, con la sua nota terrazza extra-large, è aperto tutto il giorno."
    ],
    "fr": [
      "Le restaurant de l’hôtel Courcheneige, ‘La Brasserie De Laroche’, et sa grande terrasse mythique, vous proposent une restauration décontractée tout au long de la journée."
    ],
    "nl": [
      "In het restaurant van de Courcheneige, \"La Brasserie De Laroche\", met zijn grote, legendarische terras, kunt u de hele dag door ongedwongen dineren."
    ],
    "es": [
      "El restaurante del hotel Courcheneige, La Brasserie De Laroche, y su gran terraza legendaria, sirven cenas informales durante todo el día."
    ],
    "zh": [
      "Courcheneige酒店的餐厅La Brasserie De Laroche拥有开阔的迷人露台，全天为您提供舒适放松的餐饮。"
    ]
  },
