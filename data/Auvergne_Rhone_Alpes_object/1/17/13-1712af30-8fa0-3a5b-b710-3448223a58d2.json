  "rdfs:comment": {
    "de": [
      "Facettenreiche Bar und Küche aus der Region. Hier können Sie einen Kaffee, ein Glas Wein, ein Bier oder einen Fruchtsaft trinken, mittags ein Gericht essen oder abends einen gemischten Teller essen."
    ],
    "en": [
      "Faceted bar and local cuisine. We welcome you for a coffee, a glass of wine, a beer, or a fruit juice, and for lunch with a dish, or in the evening to share mixed dishes."
    ],
    "it": [
      "Bar sfaccettato e cucina locale. Vi diamo il benvenuto per un caffè, un bicchiere di vino, una birra o un succo di frutta, e per il pranzo davanti a un piatto o la sera per condividere i nostri piatti misti."
    ],
    "fr": [
      "Bar à facettes et cuisine du coin. On vous accueille pour boire un café, un verre de vin, une bière, ou un jus de fruits, et pour le déjeuner autour d’un plat ou le soir pour partager des assiettes composées."
    ],
    "nl": [
      "Gefacetteerde bar en lokale keuken. We verwelkomen je graag voor een kopje koffie, een glas wijn, een biertje of een vruchtensapje, en voor de lunch onder het genot van een gerecht of 's avonds om onze gemengde gerechten te delen."
    ],
    "es": [
      "Bar de copas y cocina local. Le damos la bienvenida para tomar un café, una copa de vino, una cerveza o un zumo de frutas, y para almorzar en torno a un plato o por la noche para compartir nuestros platos combinados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Central Vapeur"
    ]
  },
