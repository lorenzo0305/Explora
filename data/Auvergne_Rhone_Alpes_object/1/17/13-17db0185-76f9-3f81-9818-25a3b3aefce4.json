  "rdfs:comment": {
    "de": [
      "Der Port de l'Epervière ist der zweitgrößte Binnenmarinhafen Frankreichs und bietet einen außergewöhnlichen Rahmen für Entspannung, nur wenige Schritte vom Stadtzentrum von Valence entfernt. Er ist insbesondere über die ViaRhôna zu erreichen."
    ],
    "en": [
      "France's second-largest river marina, Port de l'Epervière boasts an exceptionally relaxing setting, just a stone's throw from downtown Valence. Access is via the ViaRhôna."
    ],
    "it": [
      "Secondo porto fluviale più grande della Francia, il Port de l'Epervière vanta un ambiente eccezionalmente rilassante, a pochi passi dal centro di Valence. È raggiungibile tramite la ViaRhôna."
    ],
    "fr": [
      "Deuxième port de plaisance fluvial de France, le Port de l’Epervière bénéficie d’un cadre exceptionnel de détente, à deux pas du centre-ville de Valence. On y accède notamment par la ViaRhôna."
    ],
    "es": [
      "El parque y el puerto de l'Épervière\r\nEl primer puerto fluvial de Europa, el puerto de l'Épervière ofrece un marco excepcional para el descanso, a un paso del centro de la ciudad."
    ],
    "nl": [
      "Als belangrijkste jachthaven van Europa biedt de haven van Épervière een uitzonderlijke omgeving voor ontspanning dicht bij het stadscentrum. Tussen zonnige landschappen en wandelwegen is de haven het beste bereikbaar via de ViaRhôna. Wandelaars kunnen ook pauzeren in het park van Épervière, bestaand uit 7 hectare groen (met boomgaard, arboretum, bloemenweide en picknickplaatsen)."
    ]
  },
  "rdfs:label": {
