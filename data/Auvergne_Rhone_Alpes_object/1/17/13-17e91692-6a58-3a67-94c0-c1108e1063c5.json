  "rdfs:comment": {
    "de": [
      "Agnes Rawoe liebt es, ihre Leidenschaft und ihre Kunst für die Töpferei mit anderen zu teilen. In ihrem Atelier können Sie ihre Werke bewundern, die zum Verkauf angeboten werden."
    ],
    "en": [
      "Agnès Rawoe loves to share her passion for pottery. You can see her intricate work in the items for sale in her workshop."
    ],
    "it": [
      "Agnès Rawoe ama condividere la sua passione e la sua arte per la ceramica. Potrete apprezzare le sue opere in vendita nel suo laboratorio."
    ],
    "fr": [
      "Agnès Rawoe adore faire partager sa passion et son art pour la poterie. Travail d'orfèvre, vous pourrez apprécier ses œuvres disponibles à la vente dans son atelier."
    ],
    "nl": [
      "Agnès Rawoe deelt graag haar passie en kunst voor aardewerk. Ze is meester-goudsmid en haar werk is te koop in haar atelier."
    ],
    "es": [
      "A Agnès Rawoe le encanta compartir su pasión y su arte por la cerámica. Podrá apreciar su trabajo disponible para la venta en su taller."
    ]
  },
