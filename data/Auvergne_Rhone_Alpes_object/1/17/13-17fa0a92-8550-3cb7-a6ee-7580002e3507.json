  "rdfs:comment": {
    "de": [
      "Sophie lädt Sie ein, das Champ de Foire zwischen dem Marktplatz und dem Stadtzentrum zu entdecken. Der Service ist schnell und angenehm. Die Küche ist hausgemacht und besteht ausschließlich aus frischen Zutaten."
    ],
    "en": [
      "Sophie welcomes you to discover her restaurant. Fast and nice service. Home cooking with local products."
    ],
    "it": [
      "Sophie vi invita a scoprire lo Champ de Foire, tra la piazza del mercato e il centro città. Il servizio è veloce e piacevole. La cucina è fatta in casa solo con prodotti freschi."
    ],
    "fr": [
      "Sophie vous invite à découvrir le Champ de Foire, entre la place du marché et le centre ville. Le service est rapide et agréable. La cuisine est faite maison avec des produits frais exclusivement."
    ],
    "nl": [
      "Sophie nodigt u uit om de Champ de Foire te ontdekken, tussen het marktplein en het stadscentrum. De service is snel en aangenaam. De keuken is huisgemaakt met uitsluitend verse producten."
    ],
    "es": [
      "Sophie le invita a descubrir el Champ de Foire, entre la plaza del mercado y el centro de la ciudad. El servicio es rápido y agradable. La cocina es casera con productos frescos únicamente."
    ]
  },
