  "rdfs:comment": {
    "de": [
      "Die Schule Vins en Nord bietet Ihnen die Möglichkeit, in Gruppenkursen oder bei privaten Weinproben die besten lokalen Weine zu lernen und zu testen."
    ],
    "en": [
      "The Vins en Nord school offers you the chance to learn about and test the best local wines, through group lessons or private tastings."
    ],
    "it": [
      "La scuola Vins en Nord vi offre la possibilità di conoscere e testare i migliori vini locali, attraverso lezioni di gruppo o degustazioni private."
    ],
    "fr": [
      "L'école Vins en Nord vous propose d'apprendre et de tester, à travers des cours collectifs ou des dégustations privées, les meilleurs crus locaux."
    ],
    "es": [
      "La escuela Vins en Nord le ofrece la posibilidad de conocer y probar los mejores vinos locales, mediante clases en grupo o catas privadas."
    ],
    "nl": [
      "De Vins en Nord school biedt je de kans om de beste lokale wijnen te leren kennen en te testen, door middel van groepslessen of privéproeverijen."
    ]
  },
