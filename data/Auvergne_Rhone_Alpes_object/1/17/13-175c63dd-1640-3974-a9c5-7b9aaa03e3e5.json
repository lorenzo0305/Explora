  "rdfs:comment": {
    "de": [
      "Nathalie Lacroix wurde am Lycée Jean Monnet in Yzeure in der Glasverarbeitung ausgebildet. Mit ihrem CAP \"Art de verre tailleur sur cristaux\" in der Tasche gründete sie 1987 ihr eigenes Unternehmen."
    ],
    "en": [
      "Nathalie Lacroix trained in glassmaking at the Lycée Jean Monnet in Yzeure. With a CAP in crystal-cutting glass art in her pocket, she set up her own business in 1987."
    ],
    "it": [
      "Nathalie Lacroix si è formata in vetreria al Lycée Jean Monnet di Yzeure. Con in tasca il CAP (certificato di formazione professionale) in arte vetraria per il taglio del cristallo, ha avviato la propria attività nel 1987."
    ],
    "fr": [
      "Nathalie Lacroix a été formée au travail du verre au lycée Jean Monnet à Yzeure. Son CAP « art de verre tailleur sur cristaux » en poche, elle crée son entreprise en 1987."
    ],
    "nl": [
      "Nathalie Lacroix volgde een opleiding glasblazen aan het Lycée Jean Monnet in Yzeure. Met haar CAP (beroepsopleidingscertificaat) in kristalslijpkunst op zak, richtte ze in 1987 haar eigen bedrijf op."
    ],
    "es": [
      "Nathalie Lacroix se formó en cristalería en el Liceo Jean Monnet de Yzeure. Con su CAP (certificado de formación profesional) de arte en vidrio tallado en el bolsillo, creó su propia empresa en 1987."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Verre i Table"
    ]
  },
