  "COVID19SpecialMeasures": {
    "de": [
      "TOSTAIN & LAFFINEUR Real Estate führt Transaktionen zum Verkauf an Nutzer und Investoren und zur Vermietung von Bürogebäuden, Mietshäusern, Geschäftsräumen, Lagerhäusern, Logistikplattformen, Gewerbeflächen, Fabriken, Grundstücken, Industriebrachen und Mietshäusern in der Region Nord-Pas-de-Calais durch."
    ],
    "en": [
      "TOSTAIN & LAFFINEUR Real Estate carries out sales to end-users and investors, as well as leasing transactions for office buildings, investment properties, commercial premises, warehouses, logistics platforms, business premises, factories, land, industrial wasteland and investment properties in the Nord-Pas-de-Calais region."
    ],
    "it": [
      "TOSTAIN & LAFFINEUR Real Estate effettua vendite a utenti e investitori e affitta edifici per uffici, immobili d'investimento, locali commerciali, magazzini, piattaforme logistiche, locali commerciali, fabbriche, terreni, aree dismesse e immobili d'investimento nella regione Nord-Pas-de-Calais."
    ],
    "fr": [
      "TOSTAIN & LAFFINEUR Real Estate réalise des transactions de vente à utilisateurs et à investisseurs et de location d'immeubles de bureaux, immeuble de rapports, locaux commerciaux, entrepôts, plates-formes logistiques, locaux d'activités, usines, terrains, friches industrielles, immeubles de rapport dans le Nord-Pas-de-Calais."
    ],
    "nl": [
      "TOSTAIN & LAFFINEUR Real Estate verkoopt aan gebruikers en investeerders en verhuurt kantoorgebouwen, vastgoedbeleggingen, bedrijfsruimten, magazijnen, logistieke platforms, bedrijfsruimten, fabrieken, terreinen, brownfields en vastgoedbeleggingen in de regio Nord-Pas-de-Calais."
    ],
    "es": [
      "TOSTAIN & LAFFINEUR Real Estate realiza ventas a usuarios e inversores y alquila edificios de oficinas, inmuebles de inversión, locales comerciales, almacenes, plataformas logísticas, locales comerciales, fábricas, terrenos, solares industriales abandonados e inmuebles de inversión en la región Nord-Pas-de-Calais."
    ]
  },
