  "rdfs:comment": {
    "de": [
      "Hotel mit 20 Zimmern in familiärer Atmosphäre und Design-Bergkulisse; am Anfang der Skipisten und in ländlicher Umgebung gelegen; Sonnenterrasse, Blick auf den Mont-Blanc, kleiner Außenpool; moderne Küche."
    ],
    "en": [
      "20-room hotel in a family atmosphere and designer mountain setting; located at the start of the ski slopes, in a rural setting; sunny terrace, Mont-Blanc view, small outdoor pool; modern cuisine."
    ],
    "it": [
      "Hotel di 20 camere con un'atmosfera familiare e un ambiente montano di design; situato all'inizio delle piste da sci, in un contesto rurale; terrazza soleggiata, vista sul Monte Bianco, piccola piscina all'aperto; cucina moderna."
    ],
    "fr": [
      "Hôtel de 20 chambres dans une ambiance familiale et un cadre montagnard design ; situé au départ des pistes de ski, et dans un cadre champêtre ; terrasse ensoleillée, vue sur le Mont-Blanc, petite piscine extérieure ; cuisine moderne."
    ],
    "nl": [
      "Hotel met 20 kamers in een familiale sfeer en een design bergomgeving; gelegen aan het begin van de skipistes en in een landelijke omgeving; zonnig terras, uitzicht op de Mont Blanc, klein buitenzwembad; moderne keuken."
    ],
    "es": [
      "Hotel de 20 habitaciones en un ambiente familiar y un entorno de montaña de diseño; situado al inicio de las pistas de esquí y en un entorno campestre; terraza soleada, vista del Mont Blanc, pequeña piscina exterior; cocina moderna."
    ]
  },
