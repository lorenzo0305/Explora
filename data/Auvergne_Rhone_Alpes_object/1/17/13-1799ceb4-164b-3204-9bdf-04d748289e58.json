  "rdfs:comment": {
    "de": [
      "Lassen Sie sich die Legenden von Buis, seine Annekdoten, sein Kulturerbe und seine Gassen vom Mittelalter bis ins letzte Jahrhundert erzählen. Von der Ansiedlung der ersten gallischen Stämme bis zur Baronie von Mévouillon ..."
    ],
    "en": [
      "Let us tell you about the legends of Buis, its annecdotes, its heritage and its narrow streets, from the Middle Ages to the last century. From the settlement of the first Gallic tribes to the Barony of Mévouillon ..."
    ],
    "it": [
      "Vi raccontiamo le leggende di Buis, i suoi aneddoti, il suo patrimonio e le sue stradine, dal Medioevo al secolo scorso. Dall'insediamento delle prime tribù galliche alla Baronia di Mévouillon ..."
    ],
    "fr": [
      "Laissez-vous conter les légendes de Buis, ses annecdotes, son patrimoine et ses ruelles, du Moyen-Age au siècle dernier. Depuis l'installation des premières tribus gauloises jusqu'à la Baronnie de Mévouillon ..."
    ],
    "es": [
      "Permítanos contarle las leyendas de Buis, sus anécdotas, su patrimonio y sus callejuelas, desde la Edad Media hasta el siglo pasado. Desde el asentamiento de las primeras tribus galas hasta la Baronía de Mévouillon..."
    ],
    "nl": [
      "Laat ons je vertellen over de legendes van Buis, de anekdotes, het erfgoed en de smalle straatjes, van de middeleeuwen tot de vorige eeuw. Van de nederzetting van de eerste Gallische stammen tot de Baronie van Mévouillon ..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sur les traces du passé"
    ]
  },
