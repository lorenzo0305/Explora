  "rdfs:comment": {
    "de": [
      "Bar mit Kaminecke.\r\nGenießen Sie einen Moment der Entspannung am Kamin und probieren Sie Glühwein und Cocktails in einer geselligen und festlichen Atmosphäre mit der Tanzfläche."
    ],
    "en": [
      "Bar with a fireplace.\r\nEnjoy a relaxing moment by the fireplace with a mulled wine or a cocktail in a convivial and festive atmosphere with a dance floor."
    ],
    "it": [
      "Bar con camino.\r\nGodetevi un momento di relax accanto al fuoco per degustare vini e cocktail caldi in un'atmosfera amichevole e festosa con la pista da ballo."
    ],
    "fr": [
      "Bar avec coin cheminée.\r\nProfitez d'un moment de détente au coin du feu pour déguster vins chauds et cocktails dans une atmosphère conviviale et festive avec la piste de danse."
    ],
    "nl": [
      "Bar met open haard.\r\nOntspan bij het vuur en geniet van glühwein en cocktails in een vriendelijke, feestelijke sfeer met een dansvloer."
    ],
    "es": [
      "Bar con chimenea.\r\nDisfrute de un momento de relajación junto al fuego para degustar vinos y cócteles calientes en un ambiente amistoso y festivo con la pista de baile."
    ]
  },
