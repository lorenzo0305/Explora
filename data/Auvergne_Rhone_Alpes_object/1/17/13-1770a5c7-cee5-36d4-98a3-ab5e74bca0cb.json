  "rdfs:comment": {
    "de": [
      "Das Museum und seine Produktionsstätten erzählen die Geschichte von 6 Jahrhunderten Messerherstellung. Wunderschöne Sammlung von Messern vom 16. Jahrhundert bis heute. Während des Besuchs: Werkstätten, Vorführungen, Ton und Licht, Shop."
    ],
    "en": [
      "The museum retraces the 600-year history of knife-making heritage. Workshops, knife-making demonstration, sound and  light, shop."
    ],
    "it": [
      "Il museo e i suoi laboratori ripercorrono la storia di 6 secoli di tradizione coltellinaia. Magnifica collezione di coltelli dal XVI secolo a oggi. Durante la visita: laboratori, dimostrazione, spettacolo di suoni e luci, negozio."
    ],
    "fr": [
      "Le musée et ses ateliers de fabrication retracent la mémoire de 6 siècles de patrimoine coutelier. Magnifique collection de couteaux du XVIème siècle à nos jours. Durant la visite : ateliers, démonstration, son et lumière, boutique."
    ],
    "nl": [
      "Het museum en de werkplaatsen vertellen de geschiedenis van 6 eeuwen messenmakerij. Prachtige collectie messen van de 16e eeuw tot nu. Tijdens het bezoek: workshops, demonstratie, geluids- en lichtshow, winkel."
    ],
    "es": [
      "El museo y sus talleres recorren la historia de 6 siglos de patrimonio cuchillero. Una magnífica colección de cuchillos desde el siglo XVI hasta nuestros días. Durante la visita: talleres, demostración, espectáculo de luz y sonido, tienda."
    ]
  },
