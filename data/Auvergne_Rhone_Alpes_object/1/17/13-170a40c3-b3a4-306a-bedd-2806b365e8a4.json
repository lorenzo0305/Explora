  "rdfs:comment": {
    "de": [
      "Der am Ufer der Rhône, am Fuße des Schlosses und inmitten von Weinbergen gelegene Hafen von Tournon sur Rhône war 2018 Gegenstand von Umbauarbeiten."
    ],
    "en": [
      "Access for smal pleasure boats (6 mooring places at the maximum or cruise ships (3 mooring paces at the maximum). 0 to 15 meters long boats. Water kookups and electricity suplly."
    ],
    "it": [
      "Situato sulle rive del Rodano, ai piedi del castello e in mezzo ai vigneti, il porto di Tournon sur Rhône è stato sottoposto a lavori di sviluppo nel 2018."
    ],
    "fr": [
      "Situé en bord du Rhône, au pied du château et au milieu des vignobles, le port de Tournon sur Rhône a fait l'objet en 2018 de travaux d'aménagement."
    ],
    "es": [
      "Situado a orillas del Ródano, a los pies del castillo y en medio de los viñedos, el puerto de Tournon sur Rhône fue objeto de obras de acondicionamiento en 2018."
    ],
    "nl": [
      "De haven van Tournon sur Rhône, gelegen aan de oevers van de Rhône, aan de voet van het kasteel en omgeven door wijngaarden, onderging in 2018 enkele ontwikkelingswerkzaamheden."
    ]
  },
  "rdfs:label": {
