  "rdfs:comment": {
    "de": [
      "Haben Sie sich für den Rundgang durch den Olympiapark entschieden? Testen Sie diesen Parcours und durchqueren Sie den Olympiapark auf der Suche nach allen 12 Hinweisen. Von der olympischen Feuerschale bis zur Eislaufbahn: Machen Sie sich auf den Weg, um mehr über Olympia zu erfahren, indem Sie den Park auf der Suche nach allen Hinweisen durchqueren."
    ],
    "en": [
      "Have you chosen the Olympic Park circuit? Try out this course and explore the Olympic Park in search of the 12 clues. From the Olympic cauldron to the skating rink, set off to discover Olympism by exploring the park in search of all the clues."
    ],
    "it": [
      "Avete scelto il circuito del Parco Olimpico? Provate questo percorso ed esplorate il Parco Olimpico alla ricerca dei 12 indizi. Dal calderone olimpico alla pista di pattinaggio, partite alla scoperta dell'olimpismo, vagando per il parco alla ricerca di tutti gli indizi."
    ],
    "fr": [
      "Vous avez choisi le circuit du Parc Olympique ? Testez ce parcours et parcourez la parc olympique à la recherche des 12 indices. De la vasque olympique à la patinoire, en route pour découvrir l'olympisme en parcourant le parc en quête de tous les indices."
    ],
    "es": [
      "¿Has elegido el circuito del Parque Olímpico? Prueba este circuito y explora el Parque Olímpico en busca de las 12 pistas. Desde el pebetero olímpico hasta la pista de patinaje sobre hielo, lánzate a descubrir el olimpismo recorriendo el parque en busca de todas las pistas."
    ],
    "nl": [
      "Heb jij het Olympisch Park circuit gekozen? Probeer deze route en verken het Olympisch Park op zoek naar de 12 aanwijzingen. Van de Olympische ketel tot de ijsbaan, ontdek het Olympisme door door het park te dwalen op zoek naar alle aanwijzingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours permanent d'orientation - Parc olympique"
    ]
  },
