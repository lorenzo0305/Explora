  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Anterrieux (7 km von Chaudes-Aigues) entdecken Sie einen historischen Ort, der die Ereignisse in diesem Ort und den angrenzenden Dörfern im Sommer 1944 nachzeichnet."
    ],
    "en": [
      "In the heart of the village of Anterrieux (7km from Chaudes-Aigues), you will discover a historic site retracing the events that occurred in this village and in the adjoining villages during the summer of 1944."
    ],
    "it": [
      "Nel cuore del villaggio di Anterrieux (a 7 km da Chaudes-Aigues), scoprirete un sito storico che rievoca gli eventi accaduti in questo villaggio e nei villaggi vicini durante l'estate del 1944."
    ],
    "fr": [
      "Au cœur du village d’Anterrieux (7km de Chaudes-Aigues), vous découvrirez un lieu historique retraçant les événements survenus dans ce bourg et dans les villages attenants pendant l’été 1944."
    ],
    "nl": [
      "In het hart van het dorp Anterrieux (7 km van Chaudes-Aigues) ontdekt u een historische site die herinnert aan de gebeurtenissen die in de zomer van 1944 in dit dorp en de naburige dorpen plaatsvonden."
    ],
    "es": [
      "En el corazón del pueblo de Anterrieux (a 7 km de Chaudes-Aigues), descubrirá un sitio histórico que recuerda los acontecimientos que tuvieron lugar en este pueblo y en los pueblos vecinos durante el verano de 1944."
    ]
  },
