  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Wasserpark von La Clusaz. Neben den verschiedenen Becken können Sie auch den Fitness- und Wellnessbereich nutzen. Nehmen Sie sich Zeit, um sich zu erholen!"
    ],
    "en": [
      "Come and discover the Espace Aquatique de La Clusaz. In addition to the various pools, you can also take advantage of the fitness and wellness areas. Take the time to recharge your batteries!"
    ],
    "it": [
      "Venite a scoprire il centro acquatico di La Clusaz. Oltre alle varie piscine, potrete approfittare anche delle aree fitness e benessere. Prendetevi il tempo per fare il pieno di energia!"
    ],
    "fr": [
      "Venez découvrir l’Espace aquatique de La Clusaz. En plus des diffèrents bassins, vous pourrait également profiter des espaces fitness et wellness. Prenez le temps de vous ressourcer !"
    ],
    "es": [
      "Venga a descubrir el centro acuático de La Clusaz. Además de las distintas piscinas, también podrá disfrutar de las zonas de fitness y bienestar. Tómese su tiempo para recargar las pilas"
    ],
    "nl": [
      "Kom en ontdek de Espace Aquatique in La Clusaz. Naast de verschillende zwembaden kun je ook gebruikmaken van de fitness- en wellnessruimtes. Neem de tijd om nieuwe energie op te doen!"
    ]
  },
