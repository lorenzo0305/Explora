  "rdfs:comment": {
    "de": [
      "Besser als die Jahreszeiten ist unsere Speisekarte, die dem Klima folgt und sich auf lokale Produzenten stützt, um Ihren Gaumen und all Ihre Wünsche zu befriedigen."
    ],
    "en": [
      "Come and enjoy traditional, homemade, artisanal and seasonal cuisine with fresh products. We offer Savoyard specialties all year round."
    ],
    "it": [
      "Assaporate una cucina tradizionale, fatta in casa, artigianale e di stagione, a base di prodotti freschi. In inverno e in estate proponiamo anche specialità della Savoia."
    ],
    "fr": [
      "Mieux que les saisons, notre carte suit le climat et s’appuie sur des producteurs locaux pour satisfaire vos papilles et toutes vos envies."
    ],
    "es": [
      "Mejor que las estaciones, nuestro menú sigue el clima y confía en los productores locales para satisfacer sus papilas gustativas y todos sus deseos."
    ],
    "nl": [
      "Beter dan de seizoenen volgt ons menu het klimaat en vertrouwt het op lokale producenten om je smaakpapillen en al je verlangens te bevredigen."
    ]
  },
