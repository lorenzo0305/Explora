  "rdfs:comment": {
    "de": [
      "Eröffnung am 4. November 2016!\r\nIm Herzen von Chamonix gelegen, engagiert sich ein Team von ausgebildeten, leidenschaftlichen und zweisprachigen Spezialisten in einem einladenden und professionellen Rahmen, um Sie bei der Suche nach einer auf Ihre Bedürfnisse zugeschnittenen Ausrüstung zu begleiten."
    ],
    "en": [
      "Opening on November 4th, 2016 !\r\nLocated in the heart of Chamonix, it is in a welcoming and professional setting that a team of trained specialists, passionate and bilingual, is committed to guiding you in your quest for equipment adapted to your needs."
    ],
    "it": [
      "Apertura il 4 novembre 2016!\r\nSituato nel cuore di Chamonix, in un ambiente accogliente e professionale, un team di specialisti formati, appassionati e bilingue vi guiderà nella ricerca di un'attrezzatura adatta alle vostre esigenze."
    ],
    "fr": [
      "Ouverture le 4 Novembre 2016 !\nSitué en plein cœur de Chamonix, c’est dans un cadre accueillant et professionnel qu’une équipe de spécialistes formés, passionnés et bilingues, s’engage à vous guider dans votre quête d’un équipement adapté à vos besoins."
    ],
    "es": [
      "¡Inauguración el 4 de noviembre de 2016!\r\nSituado en el corazón de Chamonix, en un entorno acogedor y profesional, un equipo de especialistas formados, apasionados y bilingües le guiarán en su búsqueda de equipos adaptados a sus necesidades."
    ],
    "nl": [
      "Opening op 4 november 2016!\nIn een gastvrije en professionele omgeving in het hart van Chamonix staat een team van opgeleide, gepassioneerde en tweetalige specialisten klaar om u te begeleiden bij uw zoektocht naar materiaal dat is aangepast aan uw behoeften."
    ]
  },
