  "rdfs:comment": {
    "de": [
      "Dieses im Herzen von Allevard gelegene Restaurant hat den Charme des Alten und seiner Vergangenheit bewahrt. Seine Lage direkt am Ufer des Flusses Bréda verleiht dem Restaurant ein besonderes Flair. Das Team des VieuxMoulin bietet Ihnen eine traditionelle Küche und Spezialitäten vom Holzfeuer."
    ],
    "en": [
      "Located in the heart of Allevard, this restaurant has succeeded in keeping the charm of its past. Its location right next to the River Le Bréda adds to its cachet. The Vieux-Moulin team offers a traditional cuisine and wood-fired specialties."
    ],
    "it": [
      "Situato nel cuore di Allevard, questo ristorante ha conservato il fascino del suo passato. La sua posizione sulle rive del fiume Bréda ne accresce il prestigio. Il team del VieuxMoulin propone una cucina tradizionale e specialità cotte al forno a legna."
    ],
    "fr": [
      "Situé au cœur d'Allevard, ce restaurant a su garder le charme de l'ancien et de son passé. Sa situation, tout au bord du Bréda, rajoute à son cachet. L'équipe du VieuxMoulin, vous propose une cuisine traditionnelle et des spécialités aux feux de bois."
    ],
    "es": [
      "Situado en el corazón de Allevard, este restaurante conserva el encanto de antaño. Su ubicación a orillas del río Bréda aumenta su caché. El equipo del VieuxMoulin sirve cocina tradicional y especialidades a la leña."
    ],
    "nl": [
      "De houtgestookte grill \"le Vieux Moulin\" is nieuw leven ingeblazen in het hart van Allevard. Het is een restaurant met ouderwetse charme, en de locatie aan de oevers van de rivier de Bréda draagt bij aan de charme."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Vieux Moulin wood-fired restaurant"
    ],
    "fr": [
      "Le Vieux Moulin"
    ],
    "nl": [
      "Houtgestookte grill, Le Vieux Moulin"
    ]
  },
