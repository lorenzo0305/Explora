  "rdfs:comment": {
    "de": [
      "Der zweitgrößte künstliche See der Auvergne ist 13 km lang und bedeckt das alte Tal der Cère auf einer Fläche von 563 ha. Zahlreiche Wassersportmöglichkeiten an den Stränden von Rénac und Espinet."
    ],
    "en": [
      "The second largest artificial lake in Auvergne is 13 km long and covers 563 ha of the former Cère valley. The beaches of Rénac and Espinet offer a wide range of water sports activities."
    ],
    "it": [
      "Il secondo lago artificiale più grande dell'Alvernia è lungo 13 km e copre 563 ettari dell'ex valle del Cère. Le spiagge di Rénac ed Espinet offrono una serie di attività sportive acquatiche."
    ],
    "fr": [
      "Long de 13 km, le deuxième plus grand lac artificiel d’Auvergne recouvre l’ancienne vallée de la Cère sur une superficie de 563 ha. Nombreuses activités nautiques sur les plages de Rénac et d’Espinet."
    ],
    "nl": [
      "Het op één na grootste kunstmatige meer van de Auvergne is 13 km lang en beslaat de voormalige Cère Vallei over een oppervlakte van 563 ha.\r\nTalrijke watersportactiviteiten op de stranden van Rénac en Espinet."
    ],
    "es": [
      "El segundo lago artificial más grande de Auvernia tiene 13 km de largo y cubre 563 ha del antiguo valle de la Cère. Las playas de Rénac y Espinet ofrecen numerosas actividades náuticas."
    ]
  },
  "rdfs:label": {
