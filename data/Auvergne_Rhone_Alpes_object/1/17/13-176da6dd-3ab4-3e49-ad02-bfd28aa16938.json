  "rdfs:comment": {
    "de": [
      "Keramiken und Gemälde und Einzelstücke, die in meiner Ferienwohnung ausgestellt sind. Besichtigung des Ateliers nur nach vorheriger Anmeldung. Einführungskurse in Ton und Raku-Brennen für die Mieter meines Ferienhauses."
    ],
    "en": [
      "Ceramic and Paintings exposed in my holiday cottage. Visit of the workshop only by appointment."
    ],
    "it": [
      "Ceramiche e dipinti e pezzi unici esposti nella mia casa di vacanza. Visita del laboratorio solo su appuntamento. Corsi di introduzione all'argilla e alla cottura Raku per gli inquilini della mia casa."
    ],
    "fr": [
      "Céramiques et Peintures et Pièces uniques exposées dans mon gîte de vacances. Visite de l'atelier uniquement sur RDV. Stages d'initiation à la terre et cuissons Raku pour les locataires de mon gîte."
    ],
    "nl": [
      "Keramiek en schilderijen en unieke stukken tentoongesteld in mijn vakantiehuisje. Bezoek aan het atelier alleen op afspraak. Inleidende cursussen in klei en Raku bakken voor de gasten van mijn gîte."
    ],
    "es": [
      "Cerámica y pinturas y piezas únicas expuestas en mi casa de vacaciones. Visitas al taller sólo con cita previa. Cursos de iniciación a la arcilla y a la cocción de Raku para los inquilinos de mi casa rural."
    ]
  },
