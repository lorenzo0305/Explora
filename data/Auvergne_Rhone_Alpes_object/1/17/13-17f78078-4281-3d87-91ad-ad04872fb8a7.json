  "rdfs:comment": {
    "de": [
      "Bemerkenswerte Kirche im romanischen Stil der Auvergne, mit sehenswerten Einrichtungsgegenständen, darunter ein holzgeschnitzter Christus. Die Kirche überrascht durch ihre Größe, ihre robuste Architektur und ihren künstlerischen Charakter."
    ],
    "en": [
      "Remarkable church in Auvergne Romanesque style, with furnishings that are well worth a visit, including a wood-carved Christ. Its size, robust architecture and artistic character are astonishing."
    ],
    "it": [
      "Notevole chiesa in stile romanico dell'Alvernia, con arredi che meritano una visita, tra cui un Cristo scolpito su legno. È sorprendentemente grande, con un'architettura robusta e un carattere artistico."
    ],
    "fr": [
      "Eglise remarquable de style roman auvergnat, possédant des pièces d'ameublement qui méritent le détour dont un Christ sculpté sur bois. Elle surprend par ses dimensions , son architecture robuste et son caractère artistique."
    ],
    "nl": [
      "Opmerkelijke kerk in romaanse stijl uit de Auvergne, met meubilair dat een bezoek waard is, waaronder een op hout gesneden Christus. Het is verrassend groot, met een robuuste architectuur en een artistiek karakter."
    ],
    "es": [
      "Notable iglesia de estilo románico de Auvernia, con un mobiliario que merece la pena visitar, incluido un Cristo tallado en madera. Es sorprendentemente grande, con una arquitectura robusta y un carácter artístico."
    ]
  },
  "rdfs:label": {
