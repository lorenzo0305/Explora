  "rdfs:comment": {
    "de": [
      "Die seit 1978 im Herzen von Grenoble ansässige Fromagerie Les Alpages verdankt ihren Ruf Bernard Mure-Ravaud: Meilleur Ouvrier de France und Gewinner des International Caseus Award - was ihn zum Weltmeister der Käser machte - im Jahr 2007."
    ],
    "en": [
      "Established in the heart of Grenoble since 1978, Fromagerie Les Alpages owes its renown to Bernard Mure-Ravaud: Meilleur Ouvrier de France and winner of the International Caseus Award - making him the World Champion Cheesemaker - in 2007."
    ],
    "it": [
      "Situata nel cuore di Grenoble dal 1978, la Fromagerie Les Alpages deve la sua reputazione a Bernard Mure-Ravaud: Meilleur Ouvrier de France e vincitore del Premio Internazionale Caseus che lo ha reso Campione del Mondo dei Formaggi nel 2007."
    ],
    "fr": [
      "Établie en plein cœur de Grenoble depuis 1978, la Fromagerie Les Alpages doit sa renommée à Bernard Mure-Ravaud : Meilleur Ouvrier de France et Vainqueur de l’International Caseus Award –ce qui a fait de lui le Champion du Monde des fromagers– en 2007."
    ],
    "es": [
      "Establecida en el corazón de Grenoble en 1978, la Fromagerie Les Alpages debe su reputación a Bernard Mure-Ravaud: Meilleur Ouvrier de France y ganador del Premio Internacional Caseus -que le convirtió en Campeón del Mundo de Quesería- en 2007."
    ],
    "nl": [
      "De Fromagerie Les Alpages is sinds 1978 gevestigd in het hart van Grenoble en dankt haar reputatie aan Bernard Mure-Ravaud: Meilleur Ouvrier de France en winnaar van de Internationale Caseus Award -die hem in 2007 tot Wereldkampioen van de kaasmakers maakte-."
    ]
  },
  "rdfs:label": {
