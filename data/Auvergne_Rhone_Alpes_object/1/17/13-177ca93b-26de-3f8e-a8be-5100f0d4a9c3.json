  "rdfs:comment": {
    "de": [
      "5 Minuten von Romans entfernt bietet Ihnen diese Trüffelfarm den Verkauf von Trüffelpflanzen, Trüffeln und verwandten Produkten sowie Cavage-Vorführungen.\r\nBesichtigung der Trüffelfarm und Trüffelessen auf Vorbestellung im Rahmen der \"Journées découvertes\" (Entdeckungstage) auf Vorbestellung!"
    ],
    "en": [
      "5 minutes from Romans, this truffle farm offers sales of truffle plants, truffles and by-products, and truffle-digging demonstrations.\r\nVisit the truffle farm and enjoy a truffle meal as part of the Journées découvertes (reservation required)!"
    ],
    "it": [
      "Scoprite la Truffière La Baume Saint Antoine a Romans-sur-Isère per un'esperienza unica basata su tartufi e funghi. Giornata di scoperta con pasto su prenotazione."
    ],
    "fr": [
      "Découvrez la Truffière La Baume Saint Antoine à Romans-sur-Isère pour une expérience unique autour de la truffe et des champignons. Journée découverte avec repas sur réservation."
    ],
    "nl": [
      "Op 5 minuten van Rome verkoopt deze truffelboerderij truffelplanten, truffels en bijproducten, en demonstraties truffeljagen.\r\nBezoek de truffelboerderij en geniet van een truffelmaaltijd als onderdeel van de Ontdekkingsdagen (reserveren verplicht)!"
    ],
    "es": [
      "Descubra la Truffière La Baume Saint Antoine en Romans-sur-Isère para vivir una experiencia única en torno a las trufas y las setas. Día de descubrimiento con comida previa reserva."
    ]
  },
