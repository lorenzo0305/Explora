  "rdfs:comment": {
    "de": [
      "Verkauf von Bio-Lebensmitteln (Lebensmittel, Obst und Gemüse), ökologischen und biologisch abbaubaren Reinigungsmitteln, Recyclingpapier und pflanzlichem Geschirr. Verpackungen für Privatpersonen und Unternehmen. Verkauf über das Internet. Verkauf von Großpackungen vor Ort."
    ],
    "en": [
      "Sale of organic food (groceries, fruit and vegetables), ecological and biodegradable cleaning products, recycled paper, vegetable dishes. Private and professional packaging. On-line sales. Bulk sales on site."
    ],
    "it": [
      "Vendita di alimenti biologici (alimentari, frutta e verdura), prodotti per la pulizia ecologici e biodegradabili, carta riciclata, piatti vegetali. Confezioni private e professionali. Vendite on-line. Vendita di prodotti sfusi in loco."
    ],
    "fr": [
      "Vente d'alimentation biologique (épicerie , fruits et légumes), de produits d'entretien écologiques et biodégradables, de papiers recyclés, vaisselle végétale. Conditionnements particuliers et professionnels. Vente en ligne. Vente en vrac sur place."
    ],
    "nl": [
      "Verkoop van biologische levensmiddelen (kruidenierswaren, groenten en fruit), ecologische en biologisch afbreekbare schoonmaakproducten, gerecycleerd papier, groenteschotels. Privé en professionele verpakking. On-line verkoop. Bulkverkoop ter plaatse."
    ],
    "es": [
      "Venta de alimentos ecológicos (comestibles, frutas y verduras), productos de limpieza ecológicos y biodegradables, papel reciclado, vajilla vegetal. Embalaje privado y profesional. Venta en línea. Venta a granel in situ."
    ]
  },
