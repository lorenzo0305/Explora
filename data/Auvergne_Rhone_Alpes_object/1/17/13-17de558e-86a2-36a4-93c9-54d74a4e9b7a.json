  "rdfs:comment": {
    "de": [
      "Das Halal-Restaurant \"Cuisine en Ville\" unter der Leitung von Küchenchef Karim Boukhari ist der Ort, an dem Halal-Küche auf gastronomische Eleganz trifft. Es liegt nur wenige Schritte von Brotteaux und dem Parc de la Tête d'Or entfernt."
    ],
    "en": [
      "The halal restaurant \"Cuisine en Ville\", run by chef Karim Boukhari, is where halal cuisine meets gastronomic elegance, located a stone's throw from Les Brotteaux and the Parc de la Tête d'Or."
    ],
    "it": [
      "Il ristorante halal \"Cuisine en Ville\", gestito dallo chef Karim Boukhari, è il luogo dove la cucina halal incontra l'eleganza gastronomica, a due passi da Les Brotteaux e dal Parc de la Tête d'Or."
    ],
    "fr": [
      "Le restaurant halal \"Cuisine en Ville\", dirigé par le chef Karim Boukhari, est l'endroit où la cuisine halal rencontre l'élégance gastronomique, situé à deux pas des Brotteaux et du Parc de la Tête d’Or."
    ],
    "nl": [
      "Het halalrestaurant \"Cuisine en Ville\" van chef-kok Karim Boukhari is de plek waar halal cuisine en gastronomische elegantie elkaar ontmoeten, op een steenworp afstand van Les Brotteaux en het Parc de la Tête d'Or."
    ],
    "es": [
      "El restaurante halal \"Cuisine en Ville\", dirigido por el chef Karim Boukhari, es el lugar donde la cocina halal se une a la elegancia gastronómica, a dos pasos de Les Brotteaux y del Parque de la Tête d'Or."
    ]
  },
