  "rdfs:comment": {
    "de": [
      "Der international bekannte Niederländer Albert Van Gulik hat sich bereits vor einigen Jahren in dem Dorf Charols niedergelassen. Er schätzte die Aufnahme seiner meist abstrakten Werke, in denen sich Traumhaftes und Surreales mischt, sehr."
    ],
    "en": [
      "The internationally-renowned Dutch artist Albert Van Gulik settled in the village of Charols several years ago. He has enjoyed a warm welcome for his works, most of which are abstract, combining dreamlike and surrealistic elements."
    ],
    "it": [
      "L'artista olandese di fama internazionale Albert Van Gulik si è stabilito nel villaggio di Charols qualche anno fa. Ha apprezzato molto l'accoglienza riservata alle sue opere, il più delle volte astratte, che mescolano onirismo e surrealismo."
    ],
    "fr": [
      "Ce hollandais de renommée internationale, Albert Van Gulik, s'est fixé il y a déjà quelques années dans le village de Charols. Il a beaucoup apprécié l'accueil fait à ses oeuvres, le plus souvent abstraites, mêlant onirisme et surréalisme."
    ],
    "es": [
      "El artista holandés de fama internacional Albert Van Gulik se instaló en el pueblo de Charols hace unos años. Ha apreciado mucho la acogida que han tenido sus obras, casi siempre abstractas, que mezclan lo onírico y lo surrealista."
    ],
    "nl": [
      "Albert Van Gulik, een Nederlandse kunstenaar met internationale faam, vestigde zich enkele jaren geleden in het dorp Charols. Hij heeft veel waardering voor de ontvangst van zijn werken, waarvan de meeste abstract zijn en droomachtige en surrealistische thema's combineren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Galerie \"Au point d'art\""
    ]
  },
