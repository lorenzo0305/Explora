  "rdfs:comment": {
    "de": [
      "Wirtshaus beruhigt Hotel in der freien Natur mit seinem privaten Park, der traditionelle Küche und Haus, örtliche und regionale Spezialitäten nahe dem Kamin restauriert."
    ],
    "en": [
      "Inn hotel calms down in the middle of nowhere with its private park, restoring traditional kitchen and house, local and regional specialities near the fireplace."
    ],
    "it": [
      "L'Auberge-hôtel des Montauds vi accoglie, d'estate come d'inverno, nel cuore del Vercors per un soggiorno rilassante o più sportivo, vicino al Bois Barbu, zona preferita da fondisti, escursionisti e famiglie!"
    ],
    "fr": [
      "L'Auberge-hôtel des Montauds vous accueille, été comme hiver, au cœur du Vercors pour un séjour détente ou plus sportif, proche du Bois Barbu, domaine privilégié des amateurs de ski de fond, de randonnées ou de balades en famille !"
    ],
    "es": [
      "El Auberge-hôtel des Montauds le da la bienvenida, tanto en verano como en invierno, en el corazón del Vercors para una estancia relajante o más deportiva, cerca del Bois Barbu, zona favorita de los esquiadores de fondo, los excursionistas y los paseos en familia"
    ],
    "nl": [
      "De Auberge-hôtel des Montauds ontvangt u zomer en winter in het hart van de Vercors voor een ontspannen of sportiever verblijf, vlakbij het Bois Barbu, een geliefd gebied voor langlaufers, wandelaars en gezinsuitstapjes!"
    ]
  },
  "rdfs:label": {
