  "rdfs:comment": {
    "de": [
      "Wenn Sie in einem hellen, von Grün umgebenen Rahmen mit einer ruhigen Atmosphäre zu Mittag essen möchten ... entscheiden Sie sich für das Restaurant de l'Hermitage.\r\nReservierung erforderlich."
    ],
    "en": [
      "If you'd like to enjoy lunch in a light-filled setting, surrounded by greenery, with a calm and serene atmosphere... choose the Hermitage restaurant.\r\nReservations required."
    ],
    "it": [
      "Se desiderate pranzare in un ambiente luminoso, immerso nel verde, con un'atmosfera tranquilla e serena... optate per il ristorante Hermitage.\r\nPrenotazione obbligatoria."
    ],
    "fr": [
      "Si vous souhaitez déjeuner dans un cadre lumineux, entouré de verdure, à l'atmosphère calme et sereine... optez pour le restaurant de l'Hermitage.\r\nRéservation obligatoire."
    ],
    "es": [
      "Si desea comer en un entorno luminoso, rodeado de vegetación, con un ambiente tranquilo y sereno... opte por el restaurante Hermitage.\r\nEs necesario reservar."
    ],
    "nl": [
      "Als u wilt lunchen in een heldere omgeving, omgeven door groen, met een rustige en serene sfeer... kies dan voor restaurant Hermitage.\r\nReservering verplicht."
    ]
  },
  "rdfs:label": {
