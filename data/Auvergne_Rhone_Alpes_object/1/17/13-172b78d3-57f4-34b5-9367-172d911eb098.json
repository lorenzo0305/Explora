  "rdfs:comment": {
    "de": [
      "Mit über 400 Referenzen an Bieren in Flaschen, Fässern, Kästen und Bierzapfanlagen können Sie hier einen geselligen Moment verbringen und mit Freunden oder Kollegen Bier verkosten!\r\nMusik- und Spieleabende..."
    ],
    "en": [
      "With over 400 references of bottled beers, kegs, boxes and beer taps, come and spend a convivial moment tasting beers with friends or colleagues!\r\nMusic evenings, games..."
    ],
    "it": [
      "Con oltre 400 referenze di birre in bottiglia, fusti, cassette e spillatori, venite a trascorrere un momento conviviale e a degustare birre con amici o colleghi!\r\nSerate musicali, giochi..."
    ],
    "fr": [
      "Avec plus de 400 références de bières bouteilles, fûts, coffrets et tireuses à bière, venez passer un moment convivial et déguster des bières entre amis ou collègues !\r\nSoirées musique, jeux..."
    ],
    "nl": [
      "Met meer dan 400 bierreferenties in flessen, vaten, dozen en biertaps, kom genieten van een gezellig moment en proef bieren met vrienden of collega's!\r\nMuziekavonden, spelletjes..."
    ],
    "es": [
      "Con más de 400 referencias de cervezas en botellas, barriles, cajas y grifos de cerveza, ¡venga a pasar un momento de convivencia y a degustar cervezas con amigos o colegas!\r\nVeladas musicales, juegos..."
    ]
  },
