  "rdfs:comment": {
    "de": [
      "Canyoning, Via Ferrata, Klettern... Tanken Sie neue Eindrücke! Und entdecken Sie neue Horizonte, allein, in der Gruppe, mit der Familie oder mit Freunden an den schönsten Orten der Region, in aller Sicherheit."
    ],
    "en": [
      "Canyoning, via ferrata, climbing... Get your fill of sensations! And discover new horizons, alone, in a group, with family or friends, on the region's most beautiful sites, in complete safety."
    ],
    "it": [
      "Canyoning, via ferrata, arrampicata... Godetevi tutte le emozioni! E scoprite nuovi orizzonti, da soli, in gruppo, con la famiglia o con gli amici, nei siti più belli della regione, in tutta sicurezza."
    ],
    "fr": [
      "Canyoning, via ferrata, escalade... Faites le plein de sensations ! Et découvrez de nouveaux horizons, seul, en groupe, en famille ou entre amis sur les plus beaux sites de la région, en toute sécurité."
    ],
    "nl": [
      "Canyoning, via ferrata, klimmen... Geniet van alle sensaties! En ontdek nieuwe horizonten, alleen, in een groep, met familie of vrienden, op de mooiste plekjes van de regio, in alle veiligheid."
    ],
    "es": [
      "Barranquismo, vía ferrata, escalada... Disfrute de todas las emociones Y descubra nuevos horizontes, solo, en grupo, en familia o con amigos, en los lugares más bellos de la región, con total seguridad."
    ]
  },
  "rdfs:label": {
    "de": [
      "Terra Nova  : Kletterei, Canyoning..."
    ],
    "en": [
      "Terra Nova  : climbing, canyoning..."
    ],
    "fr": [
      "Terra Nova  Canyoning"
    ]
  },
