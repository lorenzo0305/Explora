  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über ist die Lesestelle für alle geöffnet. Mit der kostenlosen Anmeldung können Sie Bücher und Dokumente aus einer großen Auswahl ausleihen."
    ],
    "en": [
      "The reading center is open to all all year round. With free registration, you can borrow books and documents from the wide selection on offer."
    ],
    "it": [
      "Il centro di lettura è aperto a tutti durante tutto l'anno. Con l'iscrizione gratuita, è possibile prendere in prestito libri e documenti dall'ampia offerta."
    ],
    "fr": [
      "Tout au long de l'année le point lecture est ouvert à tous. Avec l'inscription gratuite vous pourrez emprunter des livres et documents parmi un large choix proposé."
    ],
    "nl": [
      "Het leescentrum is het hele jaar door voor iedereen toegankelijk. Met een gratis inschrijving kun je boeken en documenten lenen uit het ruime aanbod."
    ],
    "es": [
      "El centro de lectura está abierto a todos durante todo el año. Previa inscripción gratuita, podrá tomar prestados libros y documentos de la amplia selección que se ofrece."
    ]
  },
