      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/d5c0dbfd-bee7-30c7-a394-a99cfe649ba4",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Unter der Woche jeden Abend geöffnet, am Wochenende mittags und abends. Montags mittags geöffnet.\r\nMittags auf Anfrage für Gruppen ab 10 Personen geöffnet.\r\nJährliche Schließung 2 Wochen im April + 3 Wochen an Allerheiligen."
            ],
            "en": [
              "Open every evening on weekdays and for lunch and dinner at weekends. Open for lunch on Mondays.\r\nLunchtime opening on request for groups of 10 or more.\r\nClosed for 2 weeks in April + 3 weeks at All Saints' Day."
            ],
            "it": [
              "Aperto tutte le sere durante la settimana e per pranzo e cena nel fine settimana. Aperto a pranzo il lunedì.\r\nAperto a pranzo su richiesta per gruppi di almeno 10 persone.\r\nChiuso per 2 settimane in aprile e per 3 settimane a Ognissanti."
            ],
            "fr": [
              "Ouvert tous les soirs en semaine et midi et soir le week-end. Ouvert le lundi midi.\r\nOuverture le midi sur demande pour les groupes à partir de 10 personnes.\r\nFermeture annuelle 2 semaines en avril + 3 semaines à la Toussaint."
            ],
            "nl": [
              "Doordeweeks elke avond geopend en in het weekend voor lunch en diner. Op maandag open voor lunch.\r\nOpen voor lunch op verzoek voor groepen van 10 of meer.\r\nIn april 2 weken gesloten en op Allerheiligen 3 weken."
            ],
            "es": [
              "Abierto todas las noches entre semana y para comer y cenar los fines de semana. Abierto para almorzar los lunes.\r\nAbierto para almuerzos a petición de grupos de 10 personas o más.\r\nCerrado 2 semanas en abril y 3 semanas el día de Todos los Santos."
            ]
          },
