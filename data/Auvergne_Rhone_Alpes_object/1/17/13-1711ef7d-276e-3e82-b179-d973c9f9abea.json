  "rdfs:comment": {
    "de": [
      "Workshop:\r\n- Austausch von Know-how: Workshops und Einführungen, die jeden Monat angeboten werden.\r\n- Bereitstellung von Räumen und Werkzeugen: Nutzen Sie Räume, die dem Heimwerken gewidmet sind."
    ],
    "en": [
      "A workshop :\r\n- sharing know-how: workshops and initiations offered every month\r\n- Spaces and tools at your disposal: take advantage of spaces dedicated to do-it-yourself activities"
    ],
    "it": [
      "Un workshop :\r\n- condividere il know-how: laboratori e corsi introduttivi proposti ogni mese\r\n- spazi e strumenti a disposizione: approfittate degli spazi dedicati al fai-da-te"
    ],
    "fr": [
      "Un atelier : \r\n- partage de savoir-faire : ateliers et initiations proposée chaque mois\r\n- mise à disposition d'espaces et d'outils : profiter d'espaces dédiés au bricolage"
    ],
    "es": [
      "Un taller :\r\n- compartir conocimientos: talleres y cursos de iniciación propuestos cada mes\r\n- espacios y herramientas disponibles: aproveche los espacios dedicados al bricolaje"
    ],
    "nl": [
      "Een workshop :\r\n- knowhow delen: elke maand worden workshops en inleidende cursussen aangeboden\r\n- Beschikbare ruimtes en hulpmiddelen: maak gebruik van de ruimtes voor doe-het-zelf activiteiten"
    ]
  },
