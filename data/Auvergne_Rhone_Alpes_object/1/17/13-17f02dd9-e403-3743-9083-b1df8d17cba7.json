  "rdfs:comment": {
    "de": [
      "Eine poetische Schnitzeljagd, um das Dorf Mirabel und Blacons zu entdecken.\r\n\r\nNehmen Sie einen Rucksack mit, den wir Ihnen leihen, um den auf dem Rucksack eingenähten Weg zu gehen und das Rätsel zu lösen: Wer wacht über das Dorf Mirabel?"
    ],
    "en": [
      "A poetic treasure hunt to discover the village of Mirabel and Blacons.\r\nDo you have the backpack that you are given to travel the path sewn on the bag and solve the riddle: Who watches over the village of Mirabel?"
    ],
    "it": [
      "Una poetica caccia al tesoro alla scoperta del villaggio di Mirabel e Blacons.\r\n\r\nPrendete uno zaino e seguite le tracce cucite nella borsa per risolvere l'enigma: chi veglia sul villaggio di Mirabel?"
    ],
    "fr": [
      "Un jeu de piste poétique pour découvrir le village de Mirabel et Blacons.\r\n\r\nMunissez-vous d’un sac à dos que l’on vous prête pour parcourir le chemin cousu sur le sac et résoudre l’énigme: qui veille sur le village de Mirabel?"
    ],
    "es": [
      "Una poética búsqueda del tesoro para descubrir el pueblo de Mirabel y Blacons.\r\n\r\nCoge una mochila y sigue el rastro cosido en ella para resolver el enigma: ¿quién vigila el pueblo de Mirabel?"
    ],
    "nl": [
      "Een poëtische speurtocht om het dorp Mirabel en Blacons te ontdekken.\r\n\r\nPak een rugzak en volg het spoor dat in de tas is genaaid om het raadsel op te lossen: wie waakt er over het dorp Mirabel?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste - Terremère"
    ]
  },
