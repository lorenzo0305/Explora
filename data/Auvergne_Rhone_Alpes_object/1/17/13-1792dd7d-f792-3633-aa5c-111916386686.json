  "rdfs:comment": {
    "de": [
      "Das Restaurant Vivant bietet vegetarische und vegane Küche, die eher asiatisch geprägt ist, aber nicht nur! Kimchi, Tempeh und andere fermentierte Lebensmittel, die vor Ort aus lokalen Zutaten hergestellt werden."
    ],
    "en": [
      "Restaurant Vivant offers vegetarian and vegan cuisine, mostly Asian but not exclusively! Kimchi, tempeh and other fermented foods made on site with local ingredients."
    ],
    "it": [
      "Il ristorante Vivant offre una cucina vegetariana e vegana, prevalentemente asiatica ma non solo! Kimchi, tempeh e altri cibi fermentati prodotti in loco con ingredienti locali."
    ],
    "fr": [
      "Le restaurant Vivant propose une cuisine végétarienne et vegane, plutôt asiatique mais pas que ! Kimchi, tempeh et d'autres aliments fermentés fabriqués sur place avec des ingrédients locaux."
    ],
    "nl": [
      "Het restaurant Vivant biedt vegetarische en veganistische gerechten, voornamelijk Aziatisch maar niet alleen! Kimchi, tempeh en ander gefermenteerd voedsel ter plaatse gemaakt met lokale ingrediënten."
    ],
    "es": [
      "El restaurante Vivant ofrece cocina vegetariana y vegana, principalmente asiática, pero no exclusivamente. Kimchi, tempeh y otros alimentos fermentados elaborados in situ con ingredientes locales."
    ]
  },
