  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Landschaft des Bourbonnaise mit dem Moped: Das ist jetzt möglich, dank dieses Mopedliebhabers, der diese Maschinen aus einer anderen Zeit wieder aufgemöbelt hat und Ihnen Touren auf den Landstraßen vorschlägt."
    ],
    "en": [
      "Visit the Bourbonnais countryside on a moped: it is now possible, thanks to this moped enthusiast who has restored these machines from another time and who offers you tours on the country roads."
    ],
    "it": [
      "Visitare la campagna di Bourbonnais in sella a un ciclomotore: ora è possibile, grazie a questo appassionato di ciclomotori che ha restaurato queste macchine d'altri tempi e che vi propone tour sulle strade di campagna."
    ],
    "fr": [
      "Visiter la campagne bourbonnaise en mobylette : c’est désormais possible, grâce à ce passionné de mobylette qui a retapé ces machines d'un autre temps et qui vous propose des circuits de balade sur les chemins de campagnes."
    ],
    "es": [
      "Visitar la campiña de Bourbonnais en ciclomotor: ahora es posible, gracias a este apasionado de los ciclomotores que ha restaurado estas máquinas de otro tiempo y que le propone recorridos por las carreteras rurales."
    ],
    "nl": [
      "Het platteland van Bourbonnais bezoeken op een brommer: het is nu mogelijk, dankzij deze brommerliefhebber die deze machines uit een andere tijd heeft gerestaureerd en die u tochten over de landwegen aanbiedt."
    ]
  },
  "rdfs:label": {
