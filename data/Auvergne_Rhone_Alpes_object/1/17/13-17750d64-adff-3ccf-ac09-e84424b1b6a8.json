  "rdfs:comment": {
    "de": [
      "Unser Restaurant befindet sich im Herzen des Dorfes Mirabel und Blacons. Traditionelle Küche mit frischen und saisonalen Produkten. Eine schöne schattige Terrasse für die schöne Jahreszeit. Empfang von Gruppen möglich (Menü auf Anfrage)."
    ],
    "en": [
      "Our restaurant is located on the heart of the village of Mirabel et Blacons. Taste our traditional cuisine with fresh and seasonal produce. Enjoy the nice shaded terrace during the summer. (Menu on demand)"
    ],
    "it": [
      "Il nostro ristorante si trova nel cuore del villaggio di Mirabel et Blacons. Cucina tradizionale con prodotti freschi e di stagione. Una bella terrazza ombreggiata per la bella stagione. Accogliamo gruppi (menu su richiesta)."
    ],
    "fr": [
      "Notre restaurant se situe au cœur du village Mirabel et Blacons. Cuisine traditionnelle avec des produits frais et de saisons. Une jolie terrasse ombragée pour la belle saison. Accueil de groupe possible (menu sur demande)."
    ],
    "nl": [
      "Ons restaurant is gelegen in het hart van het dorp Mirabel et Blacons. Traditionele keuken met verse seizoensproducten. Een aangenaam schaduwrijk terras voor dagen met mooi weer. Ontvangst van groepen is mogelijk. (menu op aanvraag)"
    ],
    "es": [
      "Nuestro restaurante está situado en el corazón del pueblo de Mirabel et Blacons. Cocina tradicional con productos frescos y de temporada. Una bonita terraza sombreada para la temporada agradable. Acogemos a grupos (menú a petición)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Ami Rabel"
    ]
  },
