  "rdfs:comment": {
    "de": [
      "Auf dieser Strecke mit 12 Markierungen, die am Col de Porte beginnt, können Sie sich mit dem Orientierungslauf vertraut machen, während Sie auf den Wegen bleiben. An jeder Markierung ist das Faltblatt mit einem Text und einer Frage versehen."
    ],
    "en": [
      "Starting from the Col de Porte, this course of 12 markers will allow you to learn orienteering while staying on the trails. At each marker, the leaflet is decorated with a text and a question."
    ],
    "it": [
      "Partendo dal Col de Porte, questo percorso di 12 marcatori vi permetterà di imparare l'orienteering rimanendo sui sentieri. Ad ogni punto, il pieghevole è accompagnato da un testo e da una domanda."
    ],
    "fr": [
      "Au départ du Col de Porte, ce parcours de 12 balises vous permettra de vous initier à la course d’orientation en restant sur les sentiers. A chaque balise le dépliant est agrémenté d’un texte et d’une question."
    ],
    "nl": [
      "Vanaf de Col de Porte kunt u met dit parcours met 12 markeringen oriëntatielopen leren terwijl u op de paden blijft. Bij elke markering staat een tekst en een vraag."
    ],
    "es": [
      "Partiendo del Col de Porte, este recorrido de 12 balizas le permitirá aprender orientación manteniéndose en los senderos. En cada baliza, el folleto va acompañado de un texto y una pregunta."
    ]
  },
  "rdfs:label": {
    "de": [
      "Entdecken Sie den Staatswald der Grande Chartreuse - Erwachsene Orientierungslauf Col de Porte"
    ],
    "en": [
      "Discovering the Grande Chartreuse state forest - Col de Porte adult orienteering course"
    ],
    "fr": [
      "A la découverte de la forêt domaniale de la Grande Chartreuse - Parcours d'orientation adulte Col de Porte"
    ],
    "es": [
      "Descubra el bosque nacional de la Grande Chartreuse - Recorrido de orientación para adultos Col de Porte"
    ]
  },
