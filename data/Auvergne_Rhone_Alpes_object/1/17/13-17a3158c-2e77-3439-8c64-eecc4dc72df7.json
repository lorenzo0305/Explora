  "rdfs:comment": {
    "de": [
      "Die Schlossgärten sind mit geometrisch angeordneten Eiben und BuchsbaumBeeten verziert. Es gibt auch einen marmornen Brunnen mit einer Rotunde."
    ],
    "en": [
      "The castle's gardens are decorated with geometric beds of yew and boxwood as well as a marble fountain covered with a rotunda."
    ],
    "it": [
      "I giardini del castello, di ispirazione italiana, presentano parterre geometrici delimitati da tassi e bossi e una fontana di marmo coperta da una rotonda."
    ],
    "fr": [
      "Les jardins du château, d'inspiration italienne, sont agrémentés de parterres géométriques bordés d'ifs et de buis et d'une fontaine de marbre recouverte d'une rotonde."
    ],
    "es": [
      "Los jardines del castillo, de inspiración italiana, presentan parterres geométricos bordeados de tejo y boj, y una fuente de mármol cubierta por una rotonda."
    ],
    "nl": [
      "De Italiaans geïnspireerde tuinen van het kasteel hebben geometrische parterres omzoomd door taxus en buxus, en een marmeren fontein overdekt door een rotonde."
    ]
  },
