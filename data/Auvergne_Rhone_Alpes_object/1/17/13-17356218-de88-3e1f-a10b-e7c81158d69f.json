  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Kunst des Porzellangießens in Workshops, in denen Sie Blumentöpfe, Tassen oder Schmuck herstellen können."
    ],
    "en": [
      "Discover the art of porcelain casting and learn about ceramics in workshops where you can make your own flowerpot, pair of mugs or jewelry."
    ],
    "it": [
      "Pezzi di porcellana artigianale, in un universo morbido e puro, realizzati con amore nel mio laboratorio nella Drôme.\r\nWorkshop introduttivi."
    ],
    "fr": [
      "Pièces artisanales en porcelaine, dans un univers doux et épuré, faites avec amour dans mon atelier en Drôme.\r\nAteliers d'initiations."
    ],
    "es": [
      "Piezas de porcelana artesanal, en un universo suave y puro, hechas con amor en mi taller de la Drôme.\r\nTalleres de iniciación."
    ],
    "nl": [
      "Ontdek de kunst van het porselein gieten en leer meer over keramiek in workshops waar je je eigen bloempot, mok of sieraad kunt maken."
    ]
