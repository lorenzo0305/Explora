  "rdfs:comment": {
    "de": [
      "Die Domaine Chavrier bewirtschaftet 7,5 Hektar Weinberge, hauptsächlich in der Appellation Brouilly, aber auch in Beaujolais-villages (rot, weiß und rosé) und Fleurie."
    ],
    "en": [
      "Domaine Chavrier cultivates 7.5 hectares of vines, mainly in the Brouilly appellation, but also in Beaujolais-villages (red, white and rosé) and Fleurie."
    ],
    "it": [
      "Il Domaine Chavrier coltiva 7,5 ettari di vigneto principalmente nella denominazione Brouilly, ma anche in Beaujolais-villages (rosso, bianco e rosé) e Fleurie."
    ],
    "fr": [
      "Le Domaine Chavrier exploite 7,5 hectares de vignes principalement en appellation Brouilly, mais aussi en Beaujolais-villages (rouge, blanc et rosé) et Fleurie."
    ],
    "es": [
      "El Domaine Chavrier cultiva 7,5 hectáreas de viñedos principalmente en la denominación de Brouilly, pero también en Beaujolais-villages (rojo, blanco y rosado) y Fleurie."
    ],
    "nl": [
      "Domaine Chavrier cultiveert 7,5 hectare wijngaarden, voornamelijk in de appellation Brouilly, maar ook in Beaujolais-dorpen (rood, wit en rosé) en Fleurie."
    ]
  },
