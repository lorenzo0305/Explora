  "rdfs:comment": {
    "de": [
      "Entdecken Sie diesen neuen Ort der Entspannung und körperlichen Ertüchtigung in der Gemeinde Saint-Savin.\r\nEin Sportparcours zum Bewegen und Teilen.\r\n10 Sportgeräte an 2 Standorten bereichern das Freizeitangebot im Freien für die Einwohner."
    ],
    "en": [
      "Come and discover this new place for relaxation and physical exercise in the commune of Saint-Savin.\r\nA sports trail to move and share.\r\n10 apparatus spread over 2 sites, adding to the range of outdoor leisure activities available to local residents."
    ],
    "it": [
      "Venite a scoprire questo nuovo luogo di relax e di esercizio fisico a Saint-Savin.\r\nUn percorso sportivo per muoversi e condividere.\r\n10 apparecchi distribuiti su 2 siti, che vanno ad arricchire l'offerta di attività ricreative all'aperto a disposizione degli abitanti della zona."
    ],
    "fr": [
      "Venez découvrir ce nouveau lieu de détente et d'exercices physiques sur la commune de Saint-Savin.\r\nUn parcours sportif pour bouger et partager.\r\n10 agrès répartis sur 2 sites  qui viennent enrichir l'offre de loisirs en plein air pour les habitants."
    ],
    "es": [
      "Venga a descubrir este nuevo lugar de relajación y ejercicio físico en Saint-Savin.\r\nUn recorrido deportivo para moverse y compartir.\r\n10 aparatos repartidos en 2 emplazamientos que se suman a la oferta de ocio al aire libre para los vecinos."
    ],
    "nl": [
      "Kom en ontdek deze nieuwe plek voor ontspanning en lichaamsbeweging in Saint-Savin.\r\nEen sportparcours om te bewegen en te delen.\r\n10 toestellen verspreid over 2 sites, die het aanbod aan vrijetijdsactiviteiten in de buitenlucht voor de buurtbewoners uitbreiden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours sportif de Saint-Savin"
    ]
  },
