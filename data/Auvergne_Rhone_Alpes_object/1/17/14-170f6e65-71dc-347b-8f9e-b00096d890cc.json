  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/83953402-5d1b-3116-906b-9d76a20a946d",
      "dc:description": {
        "de": [
          "Handwerker in der Gemeinde Wimereux seit 2007.\nKlempnerarbeiten, Sanitäranlagen, Heizung, Elektrizität, Wasseraufbereitung, Alarmanlage, Badezimmereinrichtung\n\n7 Tage die Woche, 24 Stunden am Tag geöffnet"
        ],
        "en": [
          "Craftsman in Wimereux since 2007.\nIntervention in plumbing, sanitary, heating, electricity, water treatment, alarm, bathroom fittings, etc\n\nOpen 7 days a week, 24 hours a day"
        ],
        "it": [
          "Artigiano a Wimereux dal 2007.\nLavori di idraulica, sanitari, riscaldamento, elettricità, trattamento delle acque, allarmi, sanitari, ecc\n\nAperto 7 giorni su 7, 24 ore su 24"
        ],
        "fr": [
          "Artisan sur la commune de Wimereux depuis  2007. \nIntervention en plomberie, sanitaire, chauffage, électricité, traitement de l'eau , alarme, agencement de salle de bains \n\nOuvert 7 jours sur 7, 24h sur 24h"
        ],
        "nl": [
          "Vakman in Wimereux sinds 2007.\nWerkzaamheden in loodgieterij, sanitair, verwarming, elektriciteit, waterbehandeling, alarmen, sanitair, enz\n\nOpen 7 dagen per week, 24 uur per dag"
        ],
        "es": [
          "Artesano en Wimereux desde 2007.\nTrabajos de fontanería, sanitarios, calefacción, electricidad, tratamiento de aguas, alarmas, sanitarios, etc\n\nAbierto 7 días a la semana, 24 horas al día"
        ]
      },
      "@type": [
        "Description"
      ],
