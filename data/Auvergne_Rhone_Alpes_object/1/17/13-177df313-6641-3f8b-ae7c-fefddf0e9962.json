  "rdfs:comment": {
    "de": [
      "Dieser Stall liegt im Weiler Bens in Le Sappey en Chartreuse und ist mit dem Gütesiegel \"Ecole Française d'Equitation\" und \"Sport étude\" ausgezeichnet. Er bietet Ihnen eine ruhige, warme und freundliche Umgebung inmitten von Bergen, Land und Wald."
    ],
    "en": [
      "Located in the Hameau de Bens at Le Sappey en Chartreuse, this stable, recently awarded the Ecole Française d'Equitation and Sport Etude label, offers you a calm, warm and friendly environment in the mountains, countryside and forest."
    ],
    "it": [
      "Situata nell'Hameau de Bens a Le Sappey en Chartreuse, questa scuderia, che ha recentemente ottenuto il marchio della Scuola di equitazione e dello Studio sportivo francese, vi offre un ambiente calmo, caldo e amichevole tra le montagne, la campagna e la foresta."
    ],
    "fr": [
      "Située dans le Hameau de Bens au Sappey en Chartreuse, cette écurie nouvellement labelisée Ecole Française d'Equitation et Sport étude, vous propose d'évoluer dans un environnement calme, chaleureux et convivial en côtoyant montagne, campagne et forêt."
    ],
    "es": [
      "Situado en el Hameau de Bens, en Le Sappey en Chartreuse, este establo, que acaba de recibir el sello de la Ecole Française d'Equitation y Sport Etude, le ofrece un entorno tranquilo, cálido y acogedor en la montaña, el campo y el bosque."
    ],
    "nl": [
      "Gelegen in de Hameau de Bens in Le Sappey en Chartreuse, biedt deze stal, die onlangs het label Franse Rijschool en Sportopleiding heeft gekregen, u een rustige, warme en gezellige omgeving in de bergen, op het platteland en in het bos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poney Club - Écurie du Sappey - Domaine de Bens"
    ]
  },
