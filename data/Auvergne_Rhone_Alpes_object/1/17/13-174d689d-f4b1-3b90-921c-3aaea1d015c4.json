  "rdfs:comment": {
    "de": [
      "Der Blaue und der Grüne See sind zwei Seen der zweiten Kategorie, in denen das Angeln sehr einfach ist."
    ],
    "en": [
      "Lac Bleu and Lac Vert are two second-category lakes where fishing is very easy."
    ],
    "it": [
      "I laghi Blu e Verde sono due laghi di seconda categoria dove la pesca è molto facile."
    ],
    "fr": [
      "Les lacs Bleu et Vert sont deux lacs de deuxième catégorie où la pêche se pratique très facilement."
    ],
    "es": [
      "Los lagos Azul y Verde son dos lagos de segunda categoría donde la pesca es muy fácil."
    ],
    "nl": [
