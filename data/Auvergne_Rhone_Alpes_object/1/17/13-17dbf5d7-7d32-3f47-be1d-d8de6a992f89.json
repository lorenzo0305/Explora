  "rdfs:comment": {
    "de": [
      "Schöne grüne Umgebung mit Picknicktischen und einem behindertengerechten Steg.\r\nDer AAPPMA du Chambon-Feugerolles ist Eigentümer des Teichs, der vom Fluss Valchérie gespeist wird."
    ],
    "en": [
      "Attractive green setting with picnic tables and pontoon accessible to people with reduced mobility.\r\nThe Chambon-Feugerolles AAPPMA owns the pond, which is fed by the Valchérie river."
    ],
    "it": [
      "Grazioso ambiente verde con tavoli da picnic e pontile accessibile alle persone a mobilità ridotta.\r\nL'AAPPMA di Chambon-Feugerolles è proprietaria dello stagno, alimentato dalla Valchérie."
    ],
    "fr": [
      "Joli cadre de verdure avec tables de pique-nique et ponton accessible aux personnes à mobilité réduite.\r\nL’AAPPMA du Chambon-Feugerolles est propriétaire de l'étang, alimenté par le Valchérie."
    ],
    "nl": [
      "Mooie groene omgeving met picknicktafels en ponton toegankelijk voor personen met beperkte mobiliteit.\r\nDe AAPPMA Chambon-Feugerolles is eigenaar van de vijver, die wordt gevoed door de Valchérie."
    ],
    "es": [
      "Bonito entorno verde con mesas de picnic y pontón accesible para personas con movilidad reducida.\r\nLa AAPPMA de Chambon-Feugerolles es propietaria del estanque, alimentado por la Valchérie."
    ]
  },
  "rdfs:label": {
