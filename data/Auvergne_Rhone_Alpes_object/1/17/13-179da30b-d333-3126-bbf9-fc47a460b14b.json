  "rdfs:comment": {
    "de": [
      "Genießen Sie eine traditionelle Küche auf einer schattigen Terrasse mit Blick auf den See von Monteynard in einer angenehmen Atmosphäre."
    ],
    "en": [
      "Shady terrace with panorama over Monteynard's lake, cosy atmosphere. Traditional cooking"
    ],
    "it": [
      "Approfitate di una cucina tradizionale su una terrazza ombreggiata con una vista sul lago di Monteynard in un ambiente piacevole."
    ],
    "fr": [
      "Profitez d'une cuisine traditionnelle sur une terrasse ombragée avec vue sur le lac de Monteynard, dans une ambiance agréable."
    ],
    "nl": [
      "Le pergola bevindt zich op de oever van het meer en heeft een groot terras met platanen beplant,  je kan er lekker genieten kan van een uitstekende traditionele keuken."
    ],
    "es": [
      "Disfrute de la cocina tradicional en una terraza a la sombra con vistas al lago Monteynard, en un ambiente agradable."
