  "rdfs:comment": {
    "de": [
      "Entdeckungswanderungen, Naturanimation und Schulausflüge. Tierbeobachtung und -fotografie, Ornithologie, essbare Wildpflanzen. Maßgeschneiderte Treks und Aufenthalte, Wanderungen auf Anfrage, private Ausflüge mit Familie und Freunden."
    ],
    "en": [
      "Discovery hikes, nature activities and school outings. Wildlife observation and photography, ornithology, wild edible plants. Tailor-made treks and stays, hikes on request, private outings with family or friends."
    ],
    "it": [
      "Escursioni di scoperta, attività naturalistiche e gite scolastiche. Osservazione e fotografia della fauna selvatica, ornitologia, piante selvatiche commestibili. Escursioni e soggiorni su misura, escursioni su richiesta, uscite private con la famiglia o gli amici."
    ],
    "fr": [
      "Randonnées de découverte, animation nature et sorties scolaires. Observation et photo animalière, ornithologie, plantes sauvages comestibles. Treks et séjours sur-mesure, randonnées à la demande, sorties privatisées en famille, entre amis."
    ],
    "nl": [
      "Ontdekkingswandelingen, natuuractiviteiten en schoolreisjes. Wildobservatie en -fotografie, ornithologie, wilde eetbare planten. Tochten en pauzes op maat, wandelingen op aanvraag, privé-uitstapjes met familie of vrienden."
    ],
    "es": [
      "Caminatas de descubrimiento, actividades en la naturaleza y excursiones escolares. Observación y fotografía de la fauna, ornitología, plantas silvestres comestibles. Paseos y escapadas a medida, excursiones a petición, salidas privadas en familia o con amigos."
    ]
  },
