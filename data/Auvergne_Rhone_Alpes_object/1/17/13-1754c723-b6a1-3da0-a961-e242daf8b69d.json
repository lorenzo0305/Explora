  "rdfs:comment": {
    "de": [
      "Trauen Sie sich herein, setzen Sie sich, nehmen Sie einen Drink und bleiben Sie sitzen. Sie sind nicht Bewohner des Hotels? Eben, das ist toll!"
    ],
    "en": [
      "Come in, sit down, have a drink and stay as long as you like. You’re not a guest at the hotel? That’s fine!"
    ],
    "it": [
      "Osate entrare, sedetevi, bevete qualcosa e non muovetevi. Non siete residenti nell'hotel? È semplicemente fantastico!"
    ],
    "fr": [
      "Osez entrer, asseyez-vous, prenez un verre et ne bougez plus. Vous n'êtes pas résidents de l'hôtel ? Justement, c'est super !"
    ],
    "nl": [
      "Durf binnen te komen, ga zitten, neem een drankje en beweeg je niet. Bent u geen bewoner van het hotel? Dat is gewoon geweldig!"
    ],
    "es": [
      "Atrévase a entrar, sentarse, tomar una copa y no moverse. ¿No es usted residente del hotel? ¡Esto es genial!"
    ]
  },
