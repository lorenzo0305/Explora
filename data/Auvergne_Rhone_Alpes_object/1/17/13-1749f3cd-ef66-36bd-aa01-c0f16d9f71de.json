  "rdfs:comment": {
    "de": [
      "Der Tierfotograf, Filmemacher und Dozent Guillaume Collombet nimmt sich Zeit, um die Berge zu durchstreifen und uns künstlerische Aufnahmen des wilden und zerbrechlichen Lebens, das sich mehr oder weniger in unserer Nähe abspielt, mitzubringen."
    ],
    "en": [
      "Wildlife photographer, filmmaker and lecturer Guillaume Collombet takes his time to roam the mountains, bringing us artistic snapshots of the fragile wildlife that lives more or less close to home."
    ],
    "it": [
      "Guillaume Collombet è un fotografo naturalista, cineasta e docente che si prende il tempo per esplorare le montagne e regalarci istantanee artistiche della fragile fauna selvatica che vive più o meno vicino a casa."
    ],
    "fr": [
      "Photographe animalier, réalisateur et conférencier, Guillaume Collombet, prend son temps pour parcourir la montagne et nous en rapporter des clichés artistiques de la vie sauvage et fragile, qui se déroule plus ou moins près de chez nous."
    ],
    "nl": [
      "Guillaume Collombet is een natuurfotograaf, filmmaker en docent die de tijd neemt om de bergen te verkennen en ons artistieke kiekjes te brengen van de kwetsbare wilde dieren die min of meer dicht bij huis leven."
    ],
    "es": [
      "Guillaume Collombet es un fotógrafo, cineasta y conferenciante que se toma su tiempo para explorar las montañas y ofrecernos instantáneas artísticas de la frágil fauna que vive más o menos cerca de casa."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guillaume Collombet - Photographer Filmmaker"
    ],
    "fr": [
      "Guillaume Collombet - Photographe Cinéaste"
    ]
  },
