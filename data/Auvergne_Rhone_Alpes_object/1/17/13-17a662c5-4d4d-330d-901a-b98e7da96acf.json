  "rdfs:comment": {
    "de": [
      "Tanzen Sie beim traditionellen Feuerwehrball am 13. Juli!\r\nGegen 22 Uhr wird das Feuerwerk zum Nationalfeiertag abgeschossen.\r\nSchnellrestaurants und Getränke vor Ort."
    ],
    "en": [
      "Come and dance to the traditional firemen's ball on July 13!\r\nAt around 10pm, fireworks will be set off to celebrate Bastille Day.\r\nFast food and refreshments on site."
    ],
    "it": [
      "Venite a ballare al tradizionale ballo dei pompieri il 13 luglio!\r\nAlle 22.00 circa, i fuochi d'artificio celebreranno la Fête Nationale.\r\nFast food e rinfreschi in loco."
    ],
    "fr": [
      "Venez danser au traditionnel bal des pompiers du 13 juillet !\r\nVers 22h, les feux d'artifices de la fête nationale seront tirés.\r\nRestauration rapide et buvette sur place."
    ],
    "es": [
      "Venga a bailar al tradicional baile de los bomberos el 13 de julio\r\nHacia las 22:00 horas, se lanzarán fuegos artificiales para celebrar la Fiesta Nacional.\r\nComida rápida y refrescos in situ."
    ],
    "nl": [
      "Kom dansen op het traditionele brandweerbal op 13 juli!\r\nRond 22.00 uur wordt vuurwerk afgestoken om het Fête Nationale te vieren.\r\nSnelle hap en versnaperingen ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Feux d'artifices et bal des pompiers"
    ]
  },
