  "rdfs:comment": {
    "de": [
      "Sport Adapté Sensations bietet angepasste Geländeabfahrts- und Gleitaktivitäten, die von zwei Fach- und Sportpädagogen aus dem medizinisch-sozialen Bereich gesteuert werden."
    ],
    "en": [
      "Sport Adapté Sensations offers all-terrain downhill and snowboarding activities, led by two specialized educators from the medical-social sector."
    ],
    "it": [
      "Sport Adapté Sensations offre attività di discesa e snowboard su tutti i terreni, guidate da due educatori sportivi specializzati del settore medico-sociale."
    ],
    "fr": [
      "Sport Adapté Sensations propose des activités de descente tout terrain et de glisse adaptées, pilotées par deux éducateurs spécialisés et sportifs issus du médico-social."
    ],
