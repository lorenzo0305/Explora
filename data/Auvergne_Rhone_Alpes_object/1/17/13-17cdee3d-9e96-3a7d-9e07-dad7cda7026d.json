  "rdfs:comment": {
    "de": [
      "Das Restaurant l'entracte eröffnet seine Pizzeria, die Pizzas, Lasagne und Salate anbieten wird.  \r\nBella Ciao, das ist die moderne Pizza, Haute Couture, die Sie vor Ort genießen oder mitnehmen können"
    ],
    "en": [
      "The restaurant l'entracte opens its pizzeria which will offer Pizzas, lasagnes and salads.  \r\nBella Ciao is the contemporary, haute couture pizza to eat on the spot or to take away"
    ],
    "it": [
      "Il ristorante l'entracte apre la sua pizzeria che offrirà pizze, lasagne e insalate.  \r\nBella Ciao è una pizza contemporanea e di alta moda da gustare sul posto o da portare via"
    ],
    "fr": [
      "Le restaurant l'entracte ouvre sa pizzeria qui proposera des Pizzas, lasagnes et salades.  \r\nBella Ciao, c'est la pizza contemporaine, haute couture à déguster sur place ou à emporter"
    ],
    "nl": [
      "Het restaurant l'entracte opent zijn pizzeria met pizza's, lasagne en salades.  \r\nBella Ciao is een eigentijdse, high fashion pizza om ter plekke van te genieten of om mee te nemen"
    ],
    "es": [
      "El restaurante l'entracte abre su pizzería que ofrecerá pizzas, lasañas y ensaladas.  \r\nBella Ciao es una pizza contemporánea y de moda para disfrutarla en el momento o para llevar"
    ]
  },
