  "rdfs:comment": {
    "de": [
      "Der Staudamm, der heute den Thiou zwischen dem linken Ufer und der Schleuseninsel überquert, zeugt von der handwerklichen und industriellen Vergangenheit dieses Ortes."
    ],
    "en": [
      "The dam which today crosses the Thiou between the left bank and the Ile aux Vannes bears witness to the craft and industrial past of this place."
    ],
    "it": [
      "La diga che oggi attraversa il Thiou tra la riva sinistra e l'île aux vannes testimonia il passato artigianale e industriale della zona."
    ],
    "fr": [
      "Le barrage qui traverse aujourd’hui le Thiou entre la rive gauche et l’île aux vannes témoigne du passé artisanal et industriel de ce lieu."
    ],
    "es": [
      "La presa que ahora cruza el Thiou entre la orilla izquierda y la île aux vannes es testigo del pasado artesanal e industrial de la zona."
    ],
    "nl": [
      "De dam die nu de Thiou oversteekt tussen de linkeroever en het île aux vannes getuigt van het ambachtelijke en industriële verleden van het gebied."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cartonnerie Aussedat sur l'Île aux Vannes"
    ]
  },
