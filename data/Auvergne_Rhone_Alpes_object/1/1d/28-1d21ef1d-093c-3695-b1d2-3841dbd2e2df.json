  "rdfs:comment": {
    "de": [
      "Machen Sie eine Pause in einem Dorf in der Picardie, das nur 11 km von der Autobahn A1 entfernt ist. Ruhe und Erholung erwarten Sie. Diese 16 m² große Unterkunft ist gut ausgestattet und grenzt an den Garten."
    ],
    "en": [
      "Take a break in a Picardy village 11 km from the A1 freeway. Peace and quiet await you. This well-equipped 16 m² apartment adjoins the garden."
    ],
    "it": [
      "Prendetevi una pausa in un villaggio della Piccardia a soli 11 km dall'autostrada A1. Pace e tranquillità vi aspettano. Questo appartamento di 16 m² ben attrezzato confina con il giardino."
    ],
    "fr": [
      "Faites une pause dans un village picard à 11 km de l'autoroute A1. Le calme et la tranquillité vous attendent. Ce logement de 16 m² est bien équipé, attenant au jardin."
    ],
    "es": [
      "Tómese un descanso en un pueblo de Picardía a sólo 11 km de la autopista A1. La paz y la tranquilidad le esperan. Este piso bien equipado de 16 m² linda con el jardín."
    ],
    "nl": [
      "Kom tot rust in een Picardisch dorp op slechts 11 km van de A1. Rust en stilte wachten op je. Dit goed uitgeruste appartement van 16 m² grenst aan de tuin."
    ]
  },
