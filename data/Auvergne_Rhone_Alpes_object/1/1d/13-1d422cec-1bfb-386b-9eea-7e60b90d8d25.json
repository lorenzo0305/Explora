  "rdfs:comment": {
    "de": [
      "Entdecken Sie die handwerklichen Produkte der Z'apis de l'Arzon in Chomelix und auf den Märkten: Berg- und Tannenhonig, Propolis, Lebkuchen und Caramielix, Nougat, Bonbons, Brotaufstrich... Hier kommt alles aus der Region!"
    ],
    "en": [
      "Discover the artisanal products of the z'apis de l'Arzon, in Chomelix and at the markets: mountain and fir honeys, propolis, gingerbread and caramielix, nougat, sweets, spreads... Everything here is local!"
    ],
    "it": [
      "Scoprite i prodotti artigianali della z'apis de l'Arzon, a Chomelix e nei mercati: mieli di montagna e di abete, propoli, panpepato e caramielix, torrone, dolci, creme spalmabili... Qui tutto è locale!"
    ],
    "fr": [
      "Découvrez les produits artisanaux des z'apis de l'Arzon, à Chomelix et sur les marchés: miels de montagne et de sapins, propolis, pains d'épices et caramielix, nougat, bonbons, pâte à tartiner... Ici, tout est local !"
    ],
    "nl": [
      "Ontdek de ambachtelijke producten van de z'apis de l'Arzon, in Chomelix en op de markten: berg- en dennenhoning, propolis, peperkoek en caramielix, noga, snoep, smeersels... Alles is hier lokaal!"
    ],
    "es": [
      "Descubra los productos artesanales de los z'apis de l'Arzon, en Chomelix y en los mercados: mieles de montaña y de abeto, propóleos, pan de especias y caramielix, turrones, dulces, cremas para untar... Aquí todo es local"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Z'apis de l'Arzon"
    ]
  },
