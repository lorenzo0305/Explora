  "rdfs:comment": {
    "de": [
      "NASTYJOE zeichnet sich durch Melodien aus, die zweifellos an die 90er Jahre erinnern. Als Außenseiter der sechseckigen Rockszene bietet die Band elektrisierende Auftritte mit einer seltenen Aufrichtigkeit."
    ],
    "en": [
      "NASTYJOE's melodies are unmistakably reminiscent of the 90s, and as outsiders on the French rock scene, they deliver electrifying performances with a rare sincerity."
    ],
    "it": [
      "Le melodie dei NASTYJOE ricordano inconfondibilmente gli anni '90 e, come outsider della scena rock francese, la band offre performance elettrizzanti con una rara sincerità."
    ],
    "fr": [
      "NASTYJOE se distingue par des mélodies qui rappellent sans conteste les années 90, outsider de la scène rock hexagonale, le groupe offre des performances électrisantes avec une sincérité rare."
    ],
    "es": [
      "Las melodías de NASTYJOE recuerdan inconfundiblemente a los años 90, y como outsiders en la escena del rock francés, la banda ofrece actuaciones electrizantes con una sinceridad poco común."
    ],
    "nl": [
      "De melodieën van NASTYJOE doen onmiskenbaar denken aan de jaren 90, en als buitenbeentjes in de Franse rockscene levert de band elektriserende optredens af met een zeldzame oprechtheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nastyjoe"
    ]
  },
