  "rdfs:comment": {
    "de": [
      "Lernen Sie Valerie kennen, eine Bäuerin und Kräuterkundlerin mit einem Diplom der Schule\r\nsie bietet eine breite Palette an Produkten an, die aus geernteten oder wilden Pflanzen hergestellt und zu Kräutertees, Balsam, Pflegeölen usw. verarbeitet werden"
    ],
    "en": [
      "Come and meet Valérie, a farmer-herbalist with a diploma from the\r\nAssociation pour le Renouveau de l'Herboristerie school, and her range of products made from cultivated or wild plants, harvested and transformed into herbal teas, balms, care oils..."
    ],
    "it": [
      "Venite a conoscere Valérie, agricoltrice-erborista diplomata presso l'Università di Parigi\r\nassociation pour le Renouveau de l'Herboristerie, e la sua gamma di prodotti a base di piante coltivate o selvatiche raccolte e trasformate in tisane, balsami, olii curativi?"
    ],
    "fr": [
      "Venez à la rencontre de Valérie, paysanne-herbaliste diplômée de\r\nl’école Association pour le Renouveau de l’Herboristerie, et sa gamme de produits issus des plantes cultivées ou sauvages cueillies et transformées en tisanes, baumes, huiles de soin…"
    ],
    "es": [
      "Venga a conocer a Valérie, agricultora-herbolaria diplomada por la\r\nasociación para la Renovación de la Herboristería, y su gama de productos a partir de plantas cultivadas o silvestres recogidas y transformadas en infusiones, bálsamos, aceites para el cuidado.."
    ],
    "nl": [
      "Kom kennismaken met Valérie, een boerin-kruidenier met een diploma van de\r\nassociation pour le Renouveau de l'Herboristerie, en haar gamma van producten gemaakt van gecultiveerde of wilde planten verzameld en omgezet in kruidenthee, balsems, verzorgende oliën?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Plume de l'Oiseau"
    ]
  },
