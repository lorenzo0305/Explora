  "rdfs:comment": {
    "de": [
      "Der Obstgarten von Charreyron ist eine große Fläche mit mehreren Arten von Obstbäumen, Feigen-, Kirsch- und Birnbäumen. Er verfügt auch über einige Picknicktische, an denen Sie im Schatten oder in der Sonne sitzen und die Aussicht auf Mirmande genießen können."
    ],
    "en": [
      "The Charreyron orchard is a vast space with several species of fruit trees, including fig, cherry and pear. It also features a number of picnic tables, in the shade or in the sun, to enjoy the view over Mirmande."
    ],
    "it": [
      "Il frutteto di Charreyron è un vasto spazio con diverse specie di alberi da frutto, tra cui fichi, ciliegi e peri. Ci sono anche diversi tavoli da picnic, all'ombra o al sole, da cui si può godere della vista su Mirmande."
    ],
    "fr": [
      "Le verger du Charreyron est un vaste espace avec plusieurs espèces d'arbres fruities, figuier, cerisier, poirier. Il est également doté de quelques tables de pique-nique, à l'ombre ou ensoleillé, pour profiter de la vue sur Mirmande."
    ],
    "es": [
      "El huerto de Charreyron es un vasto espacio con varias especies de árboles frutales, como higueras, cerezos y perales. También hay varias mesas de picnic, a la sombra o al sol, donde podrá disfrutar de las vistas sobre Mirmande."
    ],
    "nl": [
      "De boomgaard van Charreyron is een uitgestrekte ruimte met verschillende soorten fruitbomen, waaronder vijgen, kersen en peren. Er zijn ook een aantal picknicktafels, in de schaduw of in de zon, waar je kunt genieten van het uitzicht over Mirmande."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Verger du Charreyron"
    ]
  },
