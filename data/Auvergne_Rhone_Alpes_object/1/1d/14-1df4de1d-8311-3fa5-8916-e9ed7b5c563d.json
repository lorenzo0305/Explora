  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/69fe4164-56c8-35dd-983d-e6eabb234d3d",
      "dc:description": {
        "de": [
          "4 Stunden Fitness im Freien, bei Sonnenuntergang, am Meer\n4 Stunden Kardio, um sich zu bewegen, sich auszutoben und sportliche Momente zu verbringen!\nSummer Fit 2 ist KOSTENLOS und für alle offen, also reservieren Sie sich Samstag, den 17. August, für 4 Stunden Sport unter freiem Himmel von 19 bis 23 Uhr"
        ],
        "en": [
          "4h of outdoor fitness, at sunset, by the sea\n4h of cardio to get moving, let off steam and have a great time!\nSummer Fit 2 is FREE and open to all, so book your place on Saturday August 17 for 4 hours of open-air fitness from 7pm to 11pm"
        ],
        "it": [
          "4 ore di fitness all'aperto, al tramonto, in riva al mare\n4 ore di cardio per muoversi, sfogarsi e divertirsi!\nSummer Fit 2 è GRATUITO e aperto a tutti, quindi prenotate il vostro posto sabato 17 agosto per 4 ore di fitness all'aperto dalle 19.00 alle 23.00"
        ],
        "fr": [
          "4h de fitness en plein air, au coucher du soleil, en bord de mer \n4h de cardio pour bouger, se défouler, passer de bons moments sportifs!\nLe Summer Fit 2 c'est GRATUIT et ouvert à tous alors réservez votre samedi 17 Août pour 4h de sport en plein air de 19h à 23h"
        ],
        "nl": [
          "4 uur fitness in de buitenlucht, bij zonsondergang, aan zee\n4 uur cardio om in beweging te komen, stoom af te blazen en een geweldige tijd te hebben!\nSummer Fit 2 is GRATIS en voor iedereen toegankelijk, dus reserveer je plek op zaterdag 17 augustus voor 4 uur fitness in de buitenlucht van 19.00 tot 23.00 uur"
        ],
        "es": [
          "4 horas de fitness al aire libre, al atardecer, junto al mar\n4 horas de cardio para moverse, desahogarse y pasarlo en grande\nSummer Fit 2 es GRATUITO y abierto a todos, así que reserva tu plaza el sábado 17 de agosto para 4 horas de fitness al aire libre de 19:00 a 23:00"
        ]
      },
