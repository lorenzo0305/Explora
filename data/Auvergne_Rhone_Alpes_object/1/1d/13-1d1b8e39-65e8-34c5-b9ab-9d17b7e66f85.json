  "rdfs:comment": {
    "de": [
      "Es ist ein begehrter Ort für Angelfreunde und Spaziergänger auf der Suche nach einem ruhigen Platz."
    ],
    "en": [
      "This dam belongs to Chazelles-sur-Lyon and was built to supply the town with drinking water and for the purposes of the water-guzzling hat-making industry in the early 20th century. It is now a firm favourite among fishermen and people out for a stroll."
    ],
    "it": [
      "È un luogo molto ricercato dagli appassionati di pesca e dagli escursionisti in cerca di un posto tranquillo."
    ],
    "fr": [
      "C’est un lieu très convoité par les amoureux de la pêche et les promeneurs à la recherche d’un espace calme."
    ],
    "nl": [
      "Het is een zeer gewilde plek voor visliefhebbers en wandelaars op zoek naar een rustig plekje."
    ],
    "es": [
      "Es un lugar muy solicitado por los aficionados a la pesca y los senderistas en busca de un lugar tranquilo."
    ]
  },
  "rdfs:label": {
    "en": [
