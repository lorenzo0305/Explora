  "rdfs:comment": {
    "de": [
      "Um Gourmets und Feinschmecker, die auf der Suche nach Geschmack sind, willkommen zu heißen, wählt unser Chefkoch Renaud seine Produkte mit größter Sorgfalt und Leidenschaft aus. Damit Sie mit Einfachheit und Feingefühl einen köstlichen Moment auf der Terrasse oder im Innenbereich verbringen können."
    ],
    "en": [
      "To welcome gourmets and gourmands in search of flavor, our Chef Renaud selects his products with the greatest care and passion. So you can spend a delicious moment with simplicity and delicacy on the terrace or indoors."
    ],
    "it": [
      "Per accogliere i gourmet e i buongustai alla ricerca di sapori, il nostro Chef Renaud seleziona i suoi prodotti con la massima cura e passione. Per permettervi di trascorrere un momento delizioso con semplicità e delicatezza sulla terrazza o all'interno."
    ],
    "fr": [
      "Pour accueillir gourmets et gourmands qui recherchent la saveur, notre Chef Renaud sélectionne ses produits avec le plus grand soin et passion. Pour vous permettre de passer un savoureux moment avec simplicité et délicatesse en terrasse ou en intérieur."
    ],
    "nl": [
      "Voor fijnproevers die op zoek zijn naar een culinaire ervaring werkt de chefkok en Maître Restaurateur vol enthousiasme samen met lokale producenten. Hier kunt u in alle eenvoud genieten van een heerlijk moment en een verfijnde keuken."
    ],
    "es": [
      "Para acoger a los gourmets y sibaritas que buscan el sabor, nuestro Chef Renaud selecciona sus productos con el mayor cuidado y pasión. Para que pueda pasar un momento delicioso con sencillez y delicadeza en la terraza o en el interior."
    ]
  },
  "rdfs:label": {
