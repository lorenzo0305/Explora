  "rdfs:comment": {
    "de": [
      "Im Saal in einem ganz neuen Dekor oder auf der großen Terrasse bietet Ihnen das Le Royal mittags und abends savoyische Spezialitäten, ein Tagesmenü oder mauritische Gerichte, die nach Sonne riechen."
    ],
    "en": [
      "Le Royal proposes lunch and dinner, Savoyard specialties, a menu of the day or sunny Mauritian dishes, in the newly refurbished dining room or on the large terrace."
    ],
    "it": [
      "Le Royal propone pranzi e cene a base di specialità savoiarde, menù del giorno o piatti solari mauriziani, nella sala da pranzo recentemente rinnovata o sulla grande terrazza."
    ],
    "fr": [
      "En salle dans un tout nouveau décor ou sur sa grande terrasse, Le Royal vous propose midi et soir, des spécialités savoyardes, un menu du jour ou des plats mauriciens qui sentent bon le soleil."
    ],
    "es": [
      "Tanto en el interior, en su flamante decoración, como en el exterior, en su gran terraza, Le Royal propone especialidades saboyanas, un menú del día o platos mauricianos que huelen a sol."
    ],
    "nl": [
      "Binnen in het gloednieuwe decor of buiten op het grote terras, Le Royal biedt Savoyaardse specialiteiten, een dagmenu of Mauritiaanse gerechten die naar zonneschijn ruiken."
    ]
  },
