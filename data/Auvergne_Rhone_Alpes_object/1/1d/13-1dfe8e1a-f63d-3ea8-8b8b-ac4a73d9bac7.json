  "rdfs:comment": {
    "de": [
      "Karin bietet Ihnen Gruppen-Yogakurse im Dorf La Ferrière in der Halle oder im Freien sowie im Skiort Les 7 Laux-Le Pleynet während der Saison an. Yogatherapie zu Hause sowie Praktika, Wochenenden, Junggesellinnenabschiede"
    ],
    "en": [
      "Karin offers group yoga classes in the village of La Ferrière, indoors or outdoors, as well as at the resort of Les 7 Laux-Le Pleynet in season. Yoga therapy at home, as well as workshops, weekends and hen parties"
    ],
    "it": [
      "Karin offre corsi di yoga di gruppo nel villaggio di La Ferrière, all'interno o all'aperto, e nella località di Les 7 Laux-Le Pleynet durante la stagione. Yoga terapia a domicilio, oltre a corsi, weekend e addii al nubilato"
    ],
    "fr": [
      "Karin vous propose des cours de Yoga collectifs sur le village de la Ferrière en salle ou plein air ainsi qu'à la station des 7 Laux-Le Pleynet en saison. Yoga thérapie à domicile ainsi que des stages, week-ends, enterrement de vie de jeune fille"
    ],
    "es": [
      "Karin ofrece clases de yoga en grupo en el pueblo de La Ferrière en interior o al aire libre, así como en la estación de Les 7 Laux-Le Pleynet en temporada. Yoga terapéutico a domicilio, así como cursos, fines de semana y despedidas de soltera"
    ],
    "nl": [
      "Karin geeft groepslessen yoga in het dorp La Ferrière, binnen of buiten, en in het seizoen in het resort Les 7 Laux-Le Pleynet. Yogatherapie aan huis, maar ook cursussen, weekends en vrijgezellenfeesten"
    ]
  },
  "rdfs:label": {
