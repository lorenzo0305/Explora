  "rdfs:comment": {
    "de": [
      "La Pèlerine ist eine Reiseagentur, die sich auf Wanderaufenthalte spezialisiert hat. Sie hat ihren Sitz in Saugues, im Département Haute-Loire, auf dem Jakobsweg, der zweiten Etappenstadt des berühmten Weges nach Le Puy en Velay."
    ],
    "en": [
      "La Pèlerine is a travel agency specializing in hiking holidays. It is based in Saugues, in the Haute-Loire region of France, on the Camino de Santiago de Compostela, second stop on the famous Le Puy en Velay route."
    ],
    "it": [
      "La Pèlerine è un'agenzia di viaggi specializzata in vacanze a piedi. Ha sede a Saugues, nell'Alta Loira, sul cammino di Santiago de Compostela, seconda tappa del famoso itinerario di Le Puy en Velay."
    ],
    "fr": [
      "La Pèlerine est une agence de voyages spécialisée dans les séjours de randonnée pédestre. Elle est implantée à Saugues, en Haute-Loire, sur le chemin de St Jacques de Compostelle, deuxième ville étape de la célèbre voie du Puy en Velay."
    ],
    "nl": [
      "La Pèlerine is een reisbureau gespecialiseerd in wandelvakanties. Het is gevestigd in Saugues, in de Haute-Loire, op de route naar Santiago de Compostela, de tweede halte op de beroemde route Le Puy en Velay."
    ],
    "es": [
      "La Pèlerine es una agencia de viajes especializada en vacaciones a pie. Tiene su sede en Saugues, en el Alto Loira, en el camino de Santiago de Compostela, segunda etapa de la famosa ruta de Le Puy en Velay."
    ]
  },
  "rdfs:label": {
