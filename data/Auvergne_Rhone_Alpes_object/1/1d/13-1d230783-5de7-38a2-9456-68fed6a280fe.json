  "rdfs:comment": {
    "de": [
      "Als Weinkeller und Weinbar bietet Ihnen \"Qui l'eut cru\" auch Tee, Kaffee, Schokolade, Fruchtsäfte, Bier... und Wurst-/Käsebretter für Ihr leibliches Wohl."
    ],
    "en": [
      "Wines cellar and bar, \"Qui l'eut cru\" also offers you tea, coffee, chocolate, fruit juice, beer … and cold meats and cheeses to have something to eat."
    ],
    "it": [
      "Cantina e wine bar, \"Chi l'avrebbe mai detto\" offre anche tè, caffè, cioccolata, succhi di frutta, birre... e taglieri di salumi/formaggi da mangiare."
    ],
    "fr": [
      "Cave et bar à vins, \"Qui l'eut cru\" vous propose également thé, café, chocolat, jus de fruits, bières... et planches de charcuterie/fromage pour vous restaurer."
    ],
    "nl": [
      "Kelder en wijnbar, \"Qui l'eut cru\" biedt ook thee, koffie, chocolade, vruchtensap, bier ... als ook planken met charcuterie/kaas"
    ],
    "es": [
      "Bodega y bar de vinos, \"Quién lo diría\" también ofrece té, café, chocolate, zumos de frutas, cervezas... y tablas de embutidos/quesos para comer."
    ]
  },
  "rdfs:label": {
