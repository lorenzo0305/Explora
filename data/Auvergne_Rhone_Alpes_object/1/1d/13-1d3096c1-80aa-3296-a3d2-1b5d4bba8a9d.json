  "rdfs:comment": {
    "de": [
      "Schlendern Sie durch die Gassen eines Dorfes, das einen Umweg wert ist! Auf dem Gipfel öffnet sich ein prächtiges Panorama über die Ebene und die majestätische Silhouette des Mont Ventoux."
    ],
    "en": [
      "Wander through the narrow streets of a village that is well worth a visit! At the top, a magnificent panorama unfolds over the plain and the majestic silhouette of Mont Ventoux."
    ],
    "it": [
      "Passeggiate per le stradine di un villaggio che vale la pena di essere visitato! In cima alla collina, si gode di un sontuoso panorama sulla pianura e sulla maestosa sagoma del Mont Ventoux."
    ],
    "fr": [
      "Déambulez dans les ruelles d’un village qui mérite le détour ! Au sommet, s’ouvre un panorama somptueux sur la plaine et la silhouette majestueuse du Mont Ventoux."
    ],
    "nl": [
      "Slenter door de smalle straatjes van een dorp dat zeker de moeite waard is! Op de top van de heuvel heb je een weids uitzicht over de vlakte en het majestueuze silhouet van de Mont Ventoux."
    ],
    "es": [
      "Pasee por las callejuelas de un pueblo que merece la pena En lo alto de la colina, un suntuoso panorama sobre la llanura y la majestuosa silueta del Mont Ventoux."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visite commentée \"Voyage à travers les âges\""
    ],
    "fr": [
      "Visite commentée \"Voyage à travers les âges\""
    ]
  },
