  "rdfs:comment": {
    "de": [
      "Anbieter von mehreren Naturaktivitäten in der südlichen Ardèche seit über 20 Jahren. Explo bietet Ihnen: Canyoning, Höhlenforschung, Klettern, Via Ferrata/Corda, Kanufahrten auf dem Chassezac..."
    ],
    "en": [
      "Outdoor sports in the Southern Ardèche for over 20 years. Explo brings you canyoning, climbing, via ferrata/corda, canoe on the Chassezac river and more."
    ],
    "it": [
      "Da più di 20 anni, l'azienda di multiattività nel sud dell'Ardèche. Explo offre canyoning, speleologia, arrampicata, via ferrata/corda, canoa sul Chassezac..."
    ],
    "fr": [
      "Prestataire Multi activité nature en Ardèche méridionale depuis plus de 20 ans. Explo vous propose : canyon, spéléo, escalade, via ferrata/corda, promenade en canoë sur le Chassezac..."
    ],
    "es": [
      "Proveedor de actividades múltiples en el sur de Ardèche desde hace más de 20 años. Explo ofrece barranquismo, espeleología, escalada, vía ferrata/corda, piragüismo en el Chassezac..."
    ],
    "nl": [
      "Al meer dan 20 jaar aanbieder van multi-activiteiten in het zuiden van de Ardèche. Explo biedt canyoning, speleologie, klimmen, via ferrata/corda, kanoën op de Chassezac..."
    ]
  },
