  "rdfs:comment": {
    "de": [
      "Meisterrestaurator.\r\nTagesmenü, Speisekarte, Kindermenü, Spezialitäten aus Savoyen, traditionelle Küche. Mittags von Dienstag bis Sonntag und abends von Mittwoch bis Samstag je nach Saison auf der Terrasse oder im Inneren geöffnet."
    ],
    "en": [
      "Master restaurateur.\r\nDaily menu, à la carte, children's menu, Savoyard specialties, traditional cuisine. Open for lunch from Tuesday to Sunday and for dinner from Wednesday to Saturday, depending on the season, on the terrace or indoors."
    ],
    "it": [
      "Maestro ristoratore.\r\nMenu del giorno, à la carte, menu per bambini, specialità savoiarde, cucina tradizionale. Aperto a pranzo dal martedì alla domenica e a cena dal mercoledì al sabato, a seconda della stagione, sulla terrazza o all'interno."
    ],
    "fr": [
      "Maitre restaurateur.\r\nMenu du jour, carte, menu enfant, spécialités Savoyardes, cuisine Traditionnelle. Ouvert les midis du mardi au dimanche et les soirs du mercredi au samedi selon les saisons en terrasse ou à l'intérieur."
    ],
    "nl": [
      "Meester-restaurateur.\r\nDagmenu, à la carte, kindermenu, Savoyaardse specialiteiten, traditionele keuken. Geopend voor lunch van dinsdag tot zondag en voor diner van woensdag tot zaterdag, afhankelijk van het seizoen, op het terras of binnen."
    ],
    "es": [
      "Maestro restaurador.\r\nMenú del día, a la carta, menú infantil, especialidades saboyanas, cocina tradicional. Abierto para el almuerzo de martes a domingo y para la cena de miércoles a sábado, según la temporada, en la terraza o en el interior."
    ]
  },
