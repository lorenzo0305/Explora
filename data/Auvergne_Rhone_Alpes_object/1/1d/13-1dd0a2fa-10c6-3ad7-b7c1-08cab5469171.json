  "rdfs:comment": {
    "de": [
      "In der Nähe des Stadtzentrums von Thonon und nur wenige Schritte vom Hafen von Rives entfernt, holzige und gemütliche Atmosphäre mit einer einfachen und hochwertigen Dekoration."
    ],
    "en": [
      "A stone's throw from the town centre of Thonon and a stone's throw from the port of Rives, wooded and warm atmosphere with a simple and quality decoration."
    ],
    "it": [
      "A due passi dal centro di Thonon e dal porto di Rives, un ambiente caldo e boscoso con un arredamento semplice e di qualità."
    ],
    "fr": [
      "A deux pas du centre ville de Thonon et à deux pas du port de Rives, ambiance boisée et chaleureuse avec une déco simple et de qualité."
    ],
    "nl": [
      "Op een steenworp afstand van het centrum van Thonon en op een steenworp afstand van de haven van Rives, een warme, bosrijke sfeer met een eenvoudige, kwalitatieve inrichting."
    ],
    "es": [
      "A un paso del centro de Thonon y a un paso del puerto de Rives, un ambiente cálido y arbolado con una decoración sencilla y de calidad."
    ]
  },
