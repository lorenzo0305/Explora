  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3333f4b9-5390-38df-9509-35ecbeeb7e42",
      "dc:description": {
        "de": [
          "Verkauf und Reparatur von Fahrrädern, darunter auch VAE\nÖffnungszeiten: Montag 14:30 - 19 Uhr und Dienstag bis Samstag 9:30 / 12:30 - 14 / 19 Uhr.\nAbholung der Fahrräder in der Werkstatt gewährleistet, Verkauf von Ersatzteilen, Zubehör und Ausrüstung."
        ],
        "en": [
          "Sales and repairs of bicycles including VAE\nOpening hours: Monday 2.30pm - 7pm and Tuesday to Saturday 9.30am / 12.30pm - 2pm / 7pm.\nBikes picked up at the workshop, spare parts, accessories and equipment sold."
        ],
        "it": [
          "Vendita e riparazione di biciclette, comprese le VAE\nOrari di apertura: lunedì 14.30-19.00 e martedì-sabato 9.30-12.30-14.00-19.00.\nRitiro delle biciclette in officina, vendita di ricambi, accessori e attrezzature."
        ],
        "fr": [
          "Ventes et réparations de vélos dont VAE\nHoraires : du lundi 14h30 - 19h et du mardi au samedi 9h30 / 12h30 - 14h / 19h.\nPrise en charge des vélos à l’atelier assurée, vente pièces détachées, accessoires et équipements."
        ],
        "nl": [
          "Verkoop en reparatie van fietsen inclusief VAE\nOpeningstijden: maandag 14.30-19.00 uur en dinsdag t/m zaterdag 9.30-12.30-19.00 uur.\nFietsen worden opgehaald in de werkplaats, reserveonderdelen, accessoires en apparatuur worden verkocht."
        ],
        "es": [
          "Venta y reparación de bicicletas, incluida VAE\nHorario de apertura: lunes, de 14.30 a 19.00 horas, y de martes a sábado, de 9.30 a 12.30 horas, de 14.00 a 19.00 horas.\nRecogida de bicicletas en el taller, venta de recambios, accesorios y equipamiento."
        ]
      },
      "@type": [
        "Description"
      ],
