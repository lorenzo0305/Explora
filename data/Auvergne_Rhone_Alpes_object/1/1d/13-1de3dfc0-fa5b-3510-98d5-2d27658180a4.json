  "rdfs:comment": {
    "de": [
      "L'Hillary, ein sanftes Universum mit Panoramablick auf Les Ménuires.\r\n\r\nZugang mit dem Doron-Sessellift oder dem Sessellift von Les Menuires, Piste des montagnettes auf dem oberen Teil des Ortes, auf der linken Seite gleich nach dem Förderband für die Kinder."
    ],
    "en": [
      "L'Hillary, a gentle universe with panoramic views of Les Ménuires.\r\n\r\nAccess via the Doron or Les Menuires chairlifts, Piste des montagnettes at the top of the resort, on the left just after the children's conveyor belt."
    ],
    "it": [
      "L'Hillary, un mondo dolce con vista panoramica su Les Ménuires.\r\n\r\nAccesso tramite la seggiovia Doron o la seggiovia Les Menuires, Piste des montagnettes in cima alla stazione, sulla sinistra subito dopo il nastro trasportatore per bambini."
    ],
    "fr": [
      "L'Hillary, un univers de douceur avec vue panoramique sur les Ménuires.\r\n\r\nAccès par le télésiège du Doron ou le télésiège des Menuires, Piste des montagnettes sur le haut de la station, sur la gauche juste après le tapis roulant pour les enfants."
    ],
    "es": [
      "L'Hillary, un mundo apacible con vistas panorámicas sobre Les Ménuires.\r\n\r\nAcceso por los telesillas Doron o Les Ménuires, Piste des montagnettes en la parte superior de la estación, a la izquierda justo después de la cinta transportadora para niños."
    ],
    "nl": [
      "L'Hillary, een zachte wereld met panoramisch uitzicht over Les Ménuires.\r\n\r\nToegang via de stoeltjesliften Doron of Les Menuires, Piste des montagnettes bovenaan het resort, aan de linkerkant net na de transportband voor kinderen."
    ]
  },
