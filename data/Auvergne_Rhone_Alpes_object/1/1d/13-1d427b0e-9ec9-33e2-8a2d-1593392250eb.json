  "rdfs:comment": {
    "de": [
      "Diese alte Kirche, die 1966 abgerissen wurde, war nach 1935 aufgegeben und durch die untere Kirche ersetzt worden, die noch immer in Betrieb ist."
    ],
    "en": [
      "This former church, demolished in 1966, was abandoned after 1935 and replaced by the lower church, still in use today."
    ],
    "it": [
      "Questa ex chiesa, demolita nel 1966, fu abbandonata dopo il 1935 e sostituita dalla chiesa inferiore, tuttora in uso."
    ],
    "fr": [
      "Cette ancienne église, démolie en 1966, avait été abandonnée après 1935 pour être remplacée par l’église du bas, toujours en fonction."
    ],
    "es": [
      "Esta antigua iglesia, demolida en 1966, fue abandonada después de 1935 y sustituida por la iglesia inferior, que sigue en uso."
    ],
    "nl": [
      "Deze voormalige kerk, gesloopt in 1966, werd na 1935 verlaten en vervangen door de lagere kerk, die nog steeds in gebruik is."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vestiges de l'ancienne église"
