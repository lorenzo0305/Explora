  "rdfs:comment": {
    "de": [
      "Ob für eine Mittagspause mit Kollegen, ein Abendessen mit Freunden, ein Geschäftsessen oder ein Familienessen - das Team des Buffalo Grill empfängt Sie mit einem Lächeln in einer entspannten, modernen und herzlichen Atmosphäre."
    ],
    "en": [
      "For a lunch break with colleagues, a dinner with friends, a business meal or with family, the Buffalo Grill team welcomes you with a smile in a relaxed, modern and warm atmosphere."
    ],
    "it": [
      "Per una pausa pranzo con i colleghi, una cena con gli amici, un pasto di lavoro o in famiglia, il team del Buffalo Grill vi accoglie con un sorriso in un'atmosfera rilassata, moderna e calda."
    ],
    "fr": [
      "Pour une pause de midi entre collègues, un dîner avec vos amis, un repas d’affaires ou en famille, l’équipe du Buffalo Grill vous accueille avec le sourire dans une atmosphère décontractée, moderne et chaleureuse."
    ],
    "nl": [
      "Voor een lunchpauze met collega's, een diner met vrienden, een zakendiner of met het gezin, het team van Buffalo Grill verwelkomt u met een glimlach in een ontspannen, moderne en warme sfeer."
    ],
    "es": [
      "Para un almuerzo con colegas, una cena con amigos, una comida de negocios o con la familia, el equipo del Buffalo Grill le recibe con una sonrisa en un ambiente relajado, moderno y cálido."
    ]
  },
  "rdfs:label": {
