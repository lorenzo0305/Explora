  "rdfs:comment": {
    "de": [
      "Klimatisierter Saal im Stil eines Chalets. Gerichte aus frischen Produkten, die vor Ihren Augen zubereitet werden, hausgemachte Kuchen. Terrasse. Geburtstagsfeiern für Kinder. Gerichte zum Mitnehmen."
    ],
    "en": [
      "Air-conditioned chalet type room. Dishes based on fresh products worked in front of you, homemade pastries. Terrace. Children's birthday party. Dishes to take away."
    ],
    "it": [
      "Camera climatizzata in stile chalet. Piatti a base di prodotti freschi preparati davanti a voi, dolci fatti in casa. Terrazza. Festa di compleanno per bambini. Pasti da asporto."
    ],
    "fr": [
      "Salle type chalet climatisée. Plats à base de produits frais travaillés devant vous, pâtisseries maison. Terrasse. Anniversaire enfants. Plats à emporter."
    ],
    "nl": [
      "Kamer in chaletstijl met airconditioning. Gerechten op basis van verse producten die voor u worden bereid, huisgemaakt gebak. Terras. Kinderverjaardagsfeestje. Afhaalmaaltijden."
    ],
    "es": [
      "Habitación tipo chalet con aire acondicionado. Platos a base de productos frescos preparados delante de ti, repostería casera. Terraza. Fiesta de cumpleaños infantil. Comidas para llevar."
    ]
  },
