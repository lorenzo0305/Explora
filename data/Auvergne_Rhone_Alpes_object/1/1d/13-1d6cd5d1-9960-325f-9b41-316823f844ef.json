  "rdfs:comment": {
    "de": [
      "Designerin von Silber- und Messingschmuck.\r\nReparaturen nach Kostenvoranschlag\r\n\r\nEmpfängt in ihrem gemeinsam genutzten Atelier regelmäßig für Workshops Bianca, Illustratorin mit Aquarellfarben (in den Farben des Wassers)."
    ],
    "en": [
      "Silver and brass jewelry designer\r\nRepairs on request\r\n\r\nBianca, watercolor illustrator (water colors), regularly hosts workshops in her shared studio."
    ],
    "it": [
      "Designer di gioielli in argento e ottone\r\nRiparazioni su richiesta\r\n\r\nBianca, illustratrice ad acquerello (con i colori dell'acqua) viene regolarmente invitata al suo laboratorio condiviso"
    ],
    "fr": [
      "Créatrice de bijoux en argent et en laiton\r\nRéparation sur devis\r\n\r\nAccueille régulièrement dans son atelier partagé pour des ateliers, Bianca, illustratrice à l'aquarelle (aux couleurs de l'eau)"
    ],
    "nl": [
      "Ontwerper van zilveren en messing sieraden\r\nReparaties op aanvraag\r\n\r\nBianca, aquarel illustrator (in de kleuren van water), is regelmatig te gast in haar gedeelde atelier voor workshops."
    ],
    "es": [
      "Diseñador de joyas de plata y latón\r\nReparaciones por encargo\r\n\r\nBianca, ilustradora en acuarela (con los colores del agua) es invitada regularmente a su taller compartido"
    ]
  },
