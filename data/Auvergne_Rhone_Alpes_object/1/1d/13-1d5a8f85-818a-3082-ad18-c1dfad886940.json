  "rdfs:comment": {
    "de": [
      "Acro'Aventures Reignier bietet Parcours in den Bäumen, 10 km von Annemasse und 20 km von Genf entfernt.\r\nIdeal für einen Ausflug mit Freunden oder der Familie, mit Ihren Kindern ab 1m.\r\nDer ACRO'FILET und seine Netze in 4 und 8 m Höhe über dem Boden."
    ],
    "en": [
      "Acro’Aventures Reignier offers tree climbing courses 10 km from Annemasse and 20 km from Geneva.\r\nIdeal for an outing with friends or family, with children from 1 m tall.\r\nThe ACRO’FILET: nets 4 and 8 m above the ground & 2 slides!"
    ],
    "it": [
      "Acro'Aventures Reignier offre percorsi sugli alberi a 10 km da Annemasse e a 20 km da Ginevra.\r\nIdeale per una gita con gli amici o la famiglia, con bambini da 1m in su.\r\nL'ACRO'FILET e le sue reti a 4 e 8 metri da terra."
    ],
    "fr": [
      "Acro’Aventures Reignier propose des parcours d'accrobranche dans les arbres à 10km d’Annemasse et à 20km de Genève.\r\nIdéal pour une sortie entre amis ou en famille, avec vos enfants dès 1m.\r\nL'ACRO’FILET : ses filets à 4 et 8m du sol  & 2 toboggans !"
    ],
    "nl": [
      "Acro?Aventures Reignier biedt boomklimparcours op 10 km van Annemasse en 20 km van Genève.\r\nIdeaal voor een uitje met vrienden of familie, met kinderen vanaf 1m.\r\nDe ACRO?FILET: netten 4 en 8 meter boven de grond & 2 glijbanen!"
    ],
    "es": [
      "Acro'Aventures Reignier ofrece recorridos en árboles a 10 km de Annemasse y a 20 km de Ginebra.\r\nIdeal para una excursión con amigos o en familia, con niños a partir de 1m.\r\nEl ACRO'FILET y sus redes a 4 y 8m del suelo."
    ]
  },
