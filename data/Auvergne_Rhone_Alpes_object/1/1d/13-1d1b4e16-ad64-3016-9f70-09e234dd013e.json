  "rdfs:comment": {
    "de": [
      "Ausgehend von einfachen und für alle zugänglichen Schreibübungen ist jeder eingeladen, eine freie Ausdrucksform zu erkunden, die manchmal poetisch, manchmal chaotisch und immer spielerisch ist!"
    ],
    "en": [
      "Using simple, accessible writing exercises, everyone is invited to explore a form of free expression that's sometimes poetic, sometimes chaotic, and always fun!"
    ],
    "it": [
      "Utilizzando esercizi di scrittura semplici e accessibili, tutti sono invitati a esplorare una forma di espressione libera, a volte poetica, a volte caotica e sempre divertente!"
    ],
    "fr": [
      "À partir d'exercices d'écriture simples et accessibles à tous, chacun est invité à explorer une forme d'expression libre, parfois poétique, parfois chaotique, et toujours ludique !"
    ],
    "nl": [
      "Met behulp van eenvoudige, toegankelijke schrijfoefeningen wordt iedereen uitgenodigd om een vorm van vrije expressie te verkennen die soms poëtisch, soms chaotisch en altijd leuk is!"
    ],
    "es": [
      "Mediante ejercicios de escritura sencillos y accesibles, se invita a todo el mundo a explorar una forma de expresión libre, a veces poética, a veces caótica, ¡y siempre divertida!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jouons avec les mots, slam et autres formes d'expression - ACCES"
    ]
  },
