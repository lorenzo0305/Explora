  "rdfs:comment": {
    "de": [
      "Erntende Imker mit Sitz in der Gemeinde Chabeuil. Roland und Annie bieten Ihnen ihren Honig aus der Drôme zum Verkauf an.\n(Lavendelhonig, Akazienhonig, Kastanienhonig, Alle Blumen)"
    ],
    "en": [
      "Beekeepers based in the commune of Chabeuil. Roland and Annie offer their Drôme honey for sale.\n(Lavender, Acacia, Chestnut, All flowers honey)"
    ],
    "it": [
      "Apicoltori con sede nel comune di Chabeuil. Roland e Annie mettono in vendita il loro miele della Drôme.\n(Miele di lavanda, acacia, castagno, tutti i fiori)"
    ],
    "fr": [
      "Apiculteurs récoltants, basée sur la commune de Chabeuil. Roland et Annie vous proposent leur miel drômois à la vente. \n(Miel de Lavande, Acacia, Châtaigniers, Toutes fleurs)"
    ],
    "nl": [
      "Imkers, gevestigd in de gemeente Chabeuil. Roland en Annie bieden hun Drômehoning te koop aan.\n(Honing van lavendel, acacia, kastanje, alle bloemen)"
    ],
    "es": [
      "Apicultores del municipio de Chabeuil. Roland y Annie ponen a la venta su miel de Drôme.\n(Miel de lavanda, acacia, castaño, todas las flores)"
    ]
