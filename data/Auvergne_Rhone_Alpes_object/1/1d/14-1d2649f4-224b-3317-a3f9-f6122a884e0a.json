      "dc:description": {
        "de": [
          "um 9:30 Uhr ab dem Repère de Torcy\nFrühstück, 10 km lange Wanderung zum Kulturerbe in Fressin und Feinkost-Mittagessen im Repère de Torcy"
        ],
        "en": [
          "9:30 am departure from Repère de Torcy\nBreakfast, 10km heritage walk in Fressin and catered lunch at Le Repère de Torcy"
        ],
        "it": [
          "9.30, partenza da Le Repère de Torcy\nPrima colazione, passeggiata nel patrimonio di 10 km a Fressin e pranzo con catering a Le Repère de Torcy"
        ],
        "fr": [
          "à 9h30 au départ du Repère de Torcy\nPetit déjeuner, rando patrimoine à Fressin de 10km et déjeuner traiteur au Repère de Torcy"
        ],
        "es": [
          "9h30, salida de Le Repère de Torcy\nDesayuno, paseo de 10 km por el patrimonio de Fressin y almuerzo en Le Repère de Torcy"
        ],
        "nl": [
          "9.30 uur, vertrek vanuit Le Repère de Torcy\nOntbijt, erfgoedwandeling van 10 km in Fressin en lunch met catering in Le Repère de Torcy"
        ]
      },
