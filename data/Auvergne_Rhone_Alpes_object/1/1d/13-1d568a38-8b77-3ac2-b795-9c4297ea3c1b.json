  "rdfs:comment": {
    "de": [
      "10,5 Hektar großer Teich unter privater Verwaltung. Je nach Genehmigungszeitraum ist jegliches kostenlose Angeln gestattet. Nachtangeln, Bootsangeln."
    ],
    "en": [
      "10.5 hectare pond under private management. All free fishing is authorized depending on the authorization periods. \r\nNight fishing, boat fishing."
    ],
    "it": [
      "Stagno a gestione privata di 10,5 ettari. Sono consentite tutte le forme di pesca libera, soggette a periodi di autorizzazione. Pesca notturna, pesca in barca."
    ],
    "fr": [
      "Étang de 10,5 hectares en gestion privée. Toutes les pêches libres sont autorisées en fonction des périodes d'autorisation. Pêche de nuit, pêche en barque."
    ],
    "nl": [
      "Particulier beheerde vijver van 10,5 hectare. Alle vormen van vrij vissen zijn toegestaan, afhankelijk van de vergunningsperioden. Nachtvissen, bootvissen."
    ],
    "es": [
      "Estanque de gestión privada de 10,5 hectáreas. Se permiten todas las formas de pesca libre, sujetas a periodos de autorización. Pesca nocturna, pesca desde embarcación."
    ]
  },
