  "rdfs:comment": {
    "de": [
      "Romain und Adeline laden Sie ein, die Authentizität einer hausgemachten Küche zu entdecken, die aus frischen Produkten zubereitet wird, die den Jahreszeiten folgen."
    ],
    "en": [
      "Romain and Adeline welcome you in their traditional restaurant with a traditional cooking."
    ],
