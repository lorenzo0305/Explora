  "rdfs:comment": {
    "de": [
      "Dieser Ort, der 1977 entdeckt wurde, ist für Geologen außergewöhnlich. Die Klippe hat die Geschichte unseres Planeten über einen Zeitraum von 5 Millionen Jahren kontinuierlich aufgezeichnet und stellt somit ein außergewöhnliches Zeugnis dar."
    ],
    "en": [
      "Discovered in 1977, this is an exceptional site for geologists. The cliff has continuously recorded the history of our planet for 5 million years, representing an extraordinary testimony."
    ],
    "it": [
      "Questo sito, scoperto nel 1977, è eccezionale per i geologi. La scogliera ha registrato ininterrottamente la storia del nostro pianeta per 5 milioni di anni, il che rappresenta una testimonianza straordinaria."
    ],
    "fr": [
      "Ce site découvert en 1977, est exceptionnel pour les géologues. La falaise a enregistré en continu l'histoire de notre planète durant 5 millions d'années, ce qui représente un témoignage extraordinaire."
    ],
    "es": [
      "Este yacimiento, descubierto en 1977, es excepcional para los geólogos. El acantilado ha registrado continuamente la historia de nuestro planeta durante 5 millones de años, lo que representa un testimonio extraordinario."
    ],
    "nl": [
      "Deze site, ontdekt in 1977, is uitzonderlijk voor geologen. De klif heeft de geschiedenis van onze planeet 5 miljoen jaar lang onophoudelijk vastgelegd, wat buitengewoon bewijsmateriaal oplevert."
    ]
  },
