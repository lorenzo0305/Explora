  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b665454c-d55b-3880-8afb-0d25f7d250b2",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck und Konditoreiwaren, siehe Facebook-Seite\n\nTage der Öffnung:\n\nMontag bis Samstag von 7:00 bis 19:30 Uhr\n \n Sonntag geschlossen\n\nBestellungen:\nMöglichkeit, telefonisch unter 03.21.71.17.19 bis zum Vortag (vor 12 Uhr) Ihres Besuchs zu bestellen\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\n\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, viennoiseries and pastries, see Facebook page\n\nOpening days:\n\nMonday to Saturday, 7am to 7:30pm\n \n Closed on Sunday\n\nOrdering :\nPossibility of ordering by telephone on 03.21.71.17.19 until the day before (before 12pm) your visit\n\nPick-up:\nTakeaway during bakery opening hours\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria viennese e torte, vedi la pagina Facebook\n\nGiorni di apertura:\n\nDa lunedì a sabato dalle 7.00 alle 19.30\n \n Chiuso la domenica\n\nOrdini :\nLe ordinazioni possono essere effettuate telefonicamente al numero 03.21.71.17.19 fino alle ore 12.00 del giorno precedente la visita\n\nRitiro:\nDa asporto durante gli orari di apertura della pasticceria\n\n\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, viennoiseries et pâtisserie, voir la page Facebook \n\nJours d'ouverture:\n\nDu lundi au samedi de 7h à 19h30\n \n Fermeture le dimanche\n\nCommandes :\nPossibilité de commander par téléphone au 03.21.71.17.19 jusque la veille (avant 12h) de votre passage\n\nRetrait :\nÀ emporter aux horaires d'ouverture de la boulangerie\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, Weens gebak en taarten, zie de Facebook-pagina\n\nOpeningsdagen:\n\nMaandag tot zaterdag van 7.00 tot 19.30 uur\n \n Zondag gesloten\n\nBestellen :\nBestellingen kunnen telefonisch worden doorgegeven op 03.21.71.17.19 tot 12 uur op de dag voor je bezoek\n\nAfhalen:\nAfhalen tijdens de openingsuren van de bakkerij\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y pastelería, consulte la página de Facebook\n\nDías de apertura:\n\nDe lunes a sábado, de 7.00 a 19.30 h\n \n Domingos cerrado\n\nPedidos :\nLos pedidos pueden realizarse por teléfono llamando al 03.21.71.17.19 hasta las 12.00 horas del día anterior a su visita\n\nRecogida:\nPara llevar durante el horario de apertura de la panadería\n\n\n\n "
        ]
      },
