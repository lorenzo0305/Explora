  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Vercors auf dem Rücken eines Pferdes (neu)! Von einer Stunde bis zu mehreren Tagen, Wanderungen oder Spaziergänge à la carte. Von Anfängern bis zu Fortgeschrittenen."
    ],
    "en": [
      "Come and discover or re-discover the Vercors on horseback! From 1 hour to several days, customisable hikes or walks. From beginner to advanced."
    ],
    "it": [
      "Venite a scoprire o riscoprire il Vercors a cavallo! Da mezza giornata a più giorni, escursioni à la carte. Tutti i livelli: da principiante ad avanzato."
    ],
    "fr": [
      "Venez découvrir ou re-découvrir le Vercors à dos de cheval ! A partir d'une demi-journée juqu'à quelques jours, randonnées à la carte. Tous niveaux : du débutant au confirmé."
    ],
    "es": [
      "¡Venga a descubrir o redescubrir el Vercors a caballo! De media jornada a varios días, excursiones a la carta. Todos los niveles: de principiante a avanzado."
    ],
    "nl": [
      "Kom de Vercors te paard ontdekken of herontdekken! Van een halve dag tot meerdere dagen, excursies à la carte. Alle niveaus: van beginner tot gevorderde."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wanderungen und Ausritte - Cap Cavale"
    ],
    "en": [
      "Horse hikes and walks - Cap Cavale"
    ],
    "fr": [
      "Randonnées à cheval - Cap Cavale"
    ]
  },
