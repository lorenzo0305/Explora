  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/999c6660-35a5-3f8f-8a6b-0a8e3e6d767e",
      "dc:description": {
        "de": [
          " Informationen :\n\nTage der Öffnung:\nDienstag bis Samstag von 9:00 bis 13:00 Uhr und von 15:00 Uhr (14:30 Uhr am Dienstag) bis 19:00 Uhr.\n\nSonntag und Montag geschlossen.\n \n Bestellungen:\nKontaktieren Sie das Geschäft telefonisch unter 03 21 15 62 66, damit Ihre Bestellung bei Ihrem Besuch im Geschäft bereit liegt\n\n\n \n \n\n "
        ],
        "en": [
          " Information :\n\nOpening days:\nTuesday to Saturday, 9am to 1pm and 3pm (2.30pm on Tuesdays) to 7pm.\n\nClosed on Sunday and Monday.\n \n Orders :\nContact the store by telephone on 03 21 15 62 66 so that your order is ready when you visit\n\n\n \n \n\n "
        ],
        "it": [
          " Ulteriori informazioni :\n\nGiorni di apertura:\nDa martedì a sabato, dalle 9.00 alle 13.00 e dalle 15.00 (14.30 il martedì) alle 19.00.\n\nChiuso la domenica e il lunedì.\n \n Ordini :\nContattare il negozio telefonicamente al numero 03 21 15 62 66 in modo che l'ordine sia pronto quando si viene in negozio\n\n\n \n \n\n "
        ],
        "fr": [
          " Informations :\n\nJours d'ouverture:\nDu mardi au samedi de 9h à 13h et de 15h (14h30 le mardi) à 19h. \n\nFermeture le dimanche et le lundi.\n \n Commandes :\nContacter le magasin par téléphone au 03 21 15 62 66 afin que votre commande soit prête lors de votre passage en magasin\n\n\n \n \n\n "
        ],
        "nl": [
          " Meer informatie :\n\nOpeningsdagen:\nDinsdag tot en met zaterdag van 9.00 tot 13.00 uur en van 15.00 tot 19.00 uur (14.30 op dinsdag).\n\nGesloten op zondag en maandag.\n \n Bestellingen :\nNeem telefonisch contact op met de winkel op 03 21 15 62 66 zodat je bestelling klaarligt wanneer je in de winkel komt\n\n\n \n \n\n "
        ],
        "es": [
          " Más información :\n\nDías de apertura:\nDe martes a sábado, de 9.00 a 13.00 h. y de 15.00 h. (14.30 h. los martes) a 19.00 h.\n\nDomingos y lunes cerrado.\n \n Pedidos :\nPóngase en contacto con la tienda por teléfono llamando al 03 21 15 62 66 para que su pedido esté listo cuando venga a la tienda\n\n\n \n \n\n "
        ]
      },
