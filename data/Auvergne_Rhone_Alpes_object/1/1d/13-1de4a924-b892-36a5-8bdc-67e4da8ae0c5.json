  "rdfs:comment": {
    "de": [
      "Restaurant, das Gerichte mit Tagesprodukten anbietet, die je nach Saison und in Partnerschaft mit unseren lokalen Lieferanten hergestellt werden.\r\nGruppen werden akzeptiert, festliche Abende, Möglichkeit, das Restaurant zu privatisieren.\r\nBabybereich und große Terrasse mit Blick auf den Mont-Blanc."
    ],
    "en": [
      "Restaurant offering dishes based on seasonal produce and in partnership with local suppliers.\r\nGroups welcome, festive evenings, possibility of privatizing the restaurant.\r\nBaby area and large terrace facing Mont-Blanc."
    ],
    "it": [
      "Ristorante che serve piatti preparati con prodotti freschi di stagione e in collaborazione con i nostri fornitori locali.\r\nAccoglienza gruppi, serate di festa, possibilità di uso privato del ristorante.\r\nArea baby e ampia terrazza con vista sul Monte Bianco."
    ],
    "fr": [
      "Restaurant proposant des plats avec des produits du jour en fonction des saisons et en partenariat avec nos fournisseurs locaux.\r\nGroupe accepté, soirée festive, possibilité de privatiser le restaurant.\r\nEspace bébé et grande terrasse face au Mont-Blanc."
    ],
    "es": [
      "Restaurante que sirve platos elaborados con productos frescos de temporada y en colaboración con nuestros proveedores locales.\r\nAcogida de grupos, veladas festivas, posibilidad de uso privado del restaurante.\r\nZona para bebés y gran terraza con vistas al Mont Blanc."
    ],
    "nl": [
      "Restaurant waar gerechten worden geserveerd die zijn bereid met verse seizoensproducten en in samenwerking met lokale leveranciers.\r\nGeschikt voor groepen, feestelijke avonden, mogelijkheid tot privégebruik van het restaurant.\r\nBabyruimte en groot terras met uitzicht op de Mont Blanc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant l'Essentiel"
    ]
  },
