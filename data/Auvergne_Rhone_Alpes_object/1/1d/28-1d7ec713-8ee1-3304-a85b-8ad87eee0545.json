  "rdfs:comment": {
    "de": [
      "Befestigte Kirche . Donjon; Glockenturm - 16. Jahrhundert; 17. Jahrhundert - Glockenturm: Eintragung durch Erlass vom 1. Juni 1927 © Monuments historiques, 1992. Kirche aus Backstein, der Ch?ur ist höher als das Schiff und das Kopfende wird von zwei zylindrischen Türmen flankiert, die von Schießscharten durchbrochen sind.  Jean Paul Meuret, 1976."
    ],
    "en": [
      "Fortified church . Donjon; steeple - 16th century; 17th century - Steeple: listed by order of June 1, 1927 © Monuments historiques, 1992. Brick church, the choir is higher than the nave and the chevet is flanked by two cylindrical towers with loopholes.  Jean Paul Meuret, 1976."
    ],
    "it": [
      "Chiesa fortificata . Campanile - XVI secolo; XVII secolo - Campanile: classificato con decreto del 1° giugno 1927 © Monuments historiques, 1992. Chiesa in mattoni, il coro è più alto della navata e il chevet è fiancheggiato da due torri cilindriche con feritoie.  Jean Paul Meuret, 1976."
    ],
    "fr": [
      "Eglise fortifiée . Donjon ; clocher - 16e siècle ; 17e siècle - Clocher : inscription par arrêté du 1er juin 1927. © Monuments historiques, 1992. Eglise en briques, le chœur est plus haut que la nef et le chevet est flanqué de deux tours cylindriques percées de meurtrières.  Jean Paul Meuret, 1976."
    ],
    "nl": [
      "Versterkte kerk . Donjon; klokkentoren - 16e eeuw; 17e eeuw - Klokkentoren: geklasseerd bij besluit van 1 juni 1927 © Monuments historiques, 1992. Bakstenen kerk, het koor is hoger dan het schip en het koor wordt geflankeerd door twee cilindrische torens met schietgaten.  Jean Paul Meuret, 1976."
    ],
    "es": [
      "Iglesia fortificada . Donjon; campanario - siglo XVI; siglo XVII - Campanario: clasificado por decreto el 1 de junio de 1927 © Monuments historiques, 1992. Iglesia de ladrillo, el coro es más alto que la nave y la cabecera está flanqueada por dos torres cilíndricas con aspilleras.  Jean Paul Meuret, 1976."
    ]
  },
