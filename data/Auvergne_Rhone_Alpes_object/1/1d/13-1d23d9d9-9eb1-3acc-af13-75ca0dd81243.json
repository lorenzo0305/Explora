  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Bauernhof und seine Tiere und lernen Sie das Leben und das Know-how der Bergbauern kennen. Der Bauernhof befindet sich auf der Route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "en": [
      "Visit the farm and its animals and discover the life and know-how of mountain farmers. The farm is located on the Terroir et Savoir-Faire du Haut-Chablais route."
    ],
    "it": [
      "Visitate la fattoria e i suoi animali e scoprite la vita e il know-how dei contadini di montagna. L'azienda si trova sul percorso Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "fr": [
      "Visitez la ferme et ses animaux et découvrez la vie et le savoir-faire des agriculteurs de montagne . La ferme est située sur la route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "es": [
      "Visite la granja y sus animales y descubra la vida y el saber hacer de los agricultores de montaña. La granja está situada en la ruta Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "nl": [
      "Bezoek de boerderij en haar dieren en ontdek het leven en de knowhow van de bergboeren. De boerderij ligt op de route Terroir et Savoir-Faire du Haut-Chablais."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visit to the Seraussaix Farm"
    ],
    "fr": [
      "Visite de la Ferme de Seraussaix"
    ],
    "nl": [
      "Bezoek aan de Seraussaix-boerderij"
    ]
  },
