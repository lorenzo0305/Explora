  "rdfs:comment": {
    "de": [
      "Produktion von aromatischen und medizinischen Pflanzen, die in biologischer Landwirtschaft und mit tierischer Zugkraft angebaut werden. Verarbeitung und Herstellung von Produkten auf Heilpflanzenbasis vor Ort: Kräutertees, Aromaten, Sirup, Getränke, Kosmetika..."
    ],
    "en": [
      "Farm growing and harvesting medicinal plants and aromatic herbs.\r\nHerbal teas, beauty oils and balms available to buy.\r\nPack-donkey breeding.\r\n\"Marque Parc\" products (local products from the area of the Natural Regional Park)."
    ],
    "it": [
      "Produzione di piante aromatiche e medicinali coltivate con metodi biologici e a trazione animale. Lavorazione e produzione in loco di prodotti a base di piante medicinali: tisane, aromi, sciroppi, bevande, cosmetici, ecc."
    ],
    "fr": [
      "Productions de plantes aromatiques et médicinales cultivées en agriculture biologique  et en traction animale. Transformation et fabrication sur place de produits à base de plantes médicinales : tisanes, aromates, sirops, boissons, cosmétiques..."
    ],
    "nl": [
      "Productie van kruidenthee, siroop, kruidendrankjes, olie en crème op basis van biologische gekweekte medicinale planten."
    ],
    "es": [
      "Producción de plantas aromáticas y medicinales cultivadas con métodos ecológicos y tracción animal. Transformación y fabricación in situ de productos a base de plantas medicinales: tisanas, aromáticas, jarabes, bebidas, cosméticos, etc."
    ]
  },
