  "rdfs:comment": {
    "de": [
      "Unterricht in verschiedenen Maltechniken, darunter alte Techniken, Kaninchenhautleim, Buchmalerei, Marmorino... arbeitet mit Acryl und Öl."
    ],
    "en": [
      "Teaching of different pictorial techniques, including ancient techniques, rabbit skin glue, illumination, marmorino... works in acrylic, oil."
    ],
    "it": [
      "Insegnamento di diverse tecniche pittoriche, tra cui le tecniche antiche, la colla di pelle di coniglio, l'illuminazione, il marmorino... lavorando con acrilico, olio."
    ],
    "fr": [
      "Enseignement des différentes techniques picturales, dont les techniques anciennes, colle de peau de lapin, enluminure, marmorino... travaille à l'acrylique, à l'huile."
    ],
    "es": [
      "Enseñanza de diferentes técnicas de pintura, incluyendo técnicas antiguas, cola de piel de conejo, iluminación, marmorino... trabajo con acrílico, óleo."
    ],
    "nl": [
      "Aanleren van verschillende schildertechnieken, waaronder oude technieken, konijnenhuidlijm, illuminatie, marmorino... acryl- en olieverfwerk."
    ]
  },
