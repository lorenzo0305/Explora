  "rdfs:comment": {
    "de": [
      "Geschäft und Verleih von E-Mountainbikes, ganzjährig geöffnet. Sorgfältige Wartung, persönliche Beratung, Reparatur und Verkauf von neuen und gebrauchten AE-Mountainbikes. Neuheiten 2024: Elektro-Laufrad zum Mieten."
    ],
    "en": [
      "Electric mountain bike shop and hire open all year round. Careful maintenance, personalised advice, repairs and sales of new and used electric mountain bikes. Bike repair. News 2024: electric balance bike for rent."
    ],
    "it": [
      "Scuola di mountain bike, noleggio di mountain bike e biciclette elettriche aperto tutto l'anno. Officina per la riparazione di mountain bike e ATV. Manutenzione accurata, consulenza personalizzata, consigli e vendita di mountain bike nuove e usate. Novità 2024: noleggio di Draisienne elettriche."
    ],
    "fr": [
      "École de VTT, magasin de location de VTT et VTT électrique ouvert toute l'année. Atelier réparation de VTT et VTTae. Entretien soigneux, conseils personnalisés, conseils et vente de VTT neufs et d'occasion. Nouveauté 2024 : location Draisienne électrique."
    ],
    "nl": [
      "Mountainbikeschool, verhuur van mountainbikes en elektrische fietsen, het hele jaar geopend. Reparatiewerkplaats voor mountainbikes en ATV's. Zorgvuldig onderhoud, persoonlijk advies, advies en verkoop van nieuwe en tweedehands mountainbikes. Nieuw in 2024: verhuur van elektrische Draisienne."
    ],
    "es": [
      "Escuela de bicicleta de montaña, tienda de alquiler de bicicletas de montaña y eléctricas abierta todo el año. Taller de reparación de bicicletas de montaña y todoterrenos. Mantenimiento esmerado, asesoramiento personalizado, consejo y venta de bicicletas de montaña nuevas y de ocasión. Novedad 2024: alquiler de Draisienne eléctricas."
    ]
  },
