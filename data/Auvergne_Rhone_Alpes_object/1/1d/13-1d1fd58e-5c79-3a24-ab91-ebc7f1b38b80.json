  "rdfs:comment": {
    "de": [
      "Jahrhundert im neogotischen Stil erbaut. Die Kirche bewahrt zwei Querkapellen an der niedrigen Seite, von denen eine aus dem 15. Jahrhundert stammt und die den Glockenturm von 1667 tragen."
    ],
    "en": [
      "In neo-gothic style from the 19th century, the church preserves two transverse chapels on the lower side, one of which dates from the 15th century, which carry the bell tower of 1667."
    ],
    "it": [
      "La chiesa è in stile neogotico del XIX secolo e presenta due cappelle trasversali sul lato inferiore, una delle quali risale al XV secolo e reca il campanile del 1667."
    ],
    "fr": [
      "De style néo-gothique du XIXème siècle, l'église conserve deux chapelles transversales sur le bas coté dont une datant du XVème siècle, qui portent le clocher de 1667."
    ],
    "es": [
      "La iglesia es de estilo neogótico del siglo XIX y tiene dos capillas transversales en la parte inferior, una de las cuales data del siglo XV y lleva el campanario de 1667."
    ],
    "nl": [
      "De kerk is in neogotische stijl uit de 19e eeuw en heeft aan de onderkant nog twee dwarse kapellen, waarvan er een uit de 15e eeuw stamt en de klokkentoren uit 1667 draagt."
    ]
  },
