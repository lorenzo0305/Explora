  "rdfs:comment": {
    "de": [
      "Im Herzen von Aurec-sur-Loire, zwischen der wilden Loire und hundertjährigen Zedern, ist Les Cèdres Bleus ein Zwischenstopp für Liebhaber authentischer Geschmäcker und geteilter Momente."
    ],
    "en": [
      "In the heart of Aurec-sur-Loire, between the savage Loire river and centenary cedars, Les Cèdres bleus is a stop for authentic flavours and shared moments lovers."
    ],
    "it": [
      "Nel cuore di Aurec-sur-Loire, tra la Loira selvaggia e i cedri centenari, Les Cèdres Bleus è il luogo di sosta per gli amanti dei sapori autentici e dei momenti di condivisione."
    ],
    "fr": [
      "Au coeur d'Aurec-sur-Loire, entre Loire sauvage et cèdres centenaires, Les Cèdres Bleus est la halte des amoureux de saveurs authentiques et de moments partagés."
    ],
    "nl": [
      "In het hart van Aurec-sur-Loire, tussen de wilde Loire en honderd jaar oude ceders, is Les Cèdres Bleus de plek om te stoppen voor liefhebbers van authentieke smaken en gedeelde momenten."
    ],
    "es": [
      "En el corazón de Aurec-sur-Loire, entre el Loira salvaje y cedros centenarios, Les Cèdres Bleus es el lugar de parada para los amantes de los sabores auténticos y los momentos compartidos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant les Cèdres Bleus"
    ],
    "fr": [
      "Restaurant les Cèdres Bleus"
    ]
  },
