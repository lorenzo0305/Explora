  "rdfs:comment": {
    "de": [
      "Von 4 bis 77 Jahren! Nervenkitzel für alle bis zu 40 km/h!\r\nLugik Parc ist ein 4-Jahreszeiten-Rodelkonzept, das in einem der schönsten Gebiete der Haute-Loire, am Fuße des Mézenc, angesiedelt ist."
    ],
    "en": [
      "From 4 to 77 years old! Thrills for all, up to 40 km/h!\r\nLugik Parc is a 4-season tobogganing concept located in one of the most beautiful areas of the Haute-Loire, at the foot of the Mezenc."
    ],
    "it": [
      "Dai 4 ai 77 anni! Emozioni per tutti, fino a 40 km/h!\r\nIl Lugik Parc è un concetto di slittino per 4 stagioni situato in una delle zone più belle dell'Alta Loira, ai piedi delle montagne del Mézenc."
    ],
    "fr": [
      "De 4 à 77 ans ! Des sensations pour tous jusqu'à 40 km/h !\r\nLugik Parc est un concept de luge 4 saisons implanté dans une des plus belles zones de la Haute-Loire, au pied du Mézenc."
    ],
    "es": [
      "¡De 4 a 77 años! Emociones para todos, ¡hasta 40 km/h!\r\nLugik Parc es un concepto de trineo para las 4 estaciones situado en una de las zonas más bellas del Alto Loira, a los pies de los montes Mézenc."
    ],
    "nl": [
      "Van 4 tot 77 jaar oud! Sensatie voor iedereen, tot 40 km/u!\r\nLugik Parc is een rodelconcept voor 4 seizoenen in een van de mooiste gebieden van de Haute-Loire, aan de voet van het Mézenc-gebergte."
    ]
  },
