  "rdfs:comment": {
    "de": [
      "Charlotte arbeitet mit Steingut, das sie bei hohen Temperaturen brennt. Je nach Werkstück verwendet sie Modellieren, Prägen oder Drehen. Sie gibt auch das ganze Jahr über Kurse für Erwachsene und Kinder."
    ],
    "en": [
      "Charlotte works in stoneware, which she fires at high temperatures. Depending on the piece, she uses modeling, stamping or throwing. She also gives courses for adults and children throughout the year."
    ],
    "it": [
      "Charlotte lavora in gres, che cuoce ad alte temperature. A seconda del pezzo, utilizza la modellazione, lo stampaggio o il lancio. Tiene anche corsi per adulti e bambini durante tutto l'anno."
    ],
    "fr": [
      "Charlotte travaille le grès qu’elle cuit à haute température. Selon les pièces, elle utilise le modelage, l’estampage ou le tournage. Elle donne également des cours pour les adultes comme pour les enfants tout au long de l’année."
    ],
    "nl": [
      "Charlotte werkt met steengoed, dat ze op hoge temperaturen bakt. Afhankelijk van het stuk gebruikt ze boetseren, stempelen of gooien. Ze geeft ook het hele jaar door cursussen voor volwassenen en kinderen."
    ],
    "es": [
      "Charlotte trabaja el gres, que cuece a altas temperaturas. Dependiendo de la pieza, utiliza el modelado, el estampado o el vaciado. También imparte cursos para adultos y niños durante todo el año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Charlotte Pila, atelier de céramique"
    ]
  },
