  "rdfs:comment": {
    "de": [
      "BIKE LEMAN ist eine Mountainbike-Schule im Chablais: Genfersee/ Portes du Soleil, Plateau de Gavot.\r\nEntdeckungstouren, Sporttouren, Fahrkurse/Guiding Enduro -DH-Elektro-Mountainbike, Raids.\r\nVerleih von Mountainbikes im Rahmen der Ausflüge."
    ],
    "en": [
      "BIKE LEMAN is a mountain bike school in the Chablais region: Lac Léman/ Portes du Soleil, Plateau de Gavot.\r\nDiscovery tours, sport tours, enduro -DH-Electric MTB piloting/guiding courses, raids.\r\nVTTAE rental for outings."
    ],
    "it": [
      "BIKE LEMAN è una scuola di mountain bike nella regione dello Chablais: Lac Léman/ Portes du Soleil, Plateau de Gavot.\r\nTour di scoperta, tour sportivi, corsi di pilotaggio/guida di MTB enduro -DH-Electric, raid.\r\nNoleggio di VTTAE per le uscite."
    ],
    "fr": [
      "BIKE LEMAN est une école de VTT dans le Chablais: Lac Léman/ Portes du Soleil, plateau de Gavot . \r\nRandonnées \"découverte\", Randonnées sportives, Cours de pilotage/guiding enduro -DH-VTT électrique, raids.\r\nLocation de VTTAE dans le cadre des sorties."
    ],
    "nl": [
      "BIKE LEMAN is een mountainbikeschool in de regio Chablais: Lac Léman/ Portes du Soleil, Plateau de Gavot.\r\nOntdekkingsreizen, sportreizen, enduro -DH-Elektrische MTB piloten/begeleiderscursussen, raids.\r\nVerhuur van VTTAE voor uitstapjes."
    ],
    "es": [
      "BIKE LEMAN es una escuela de bicicleta de montaña en la región de Chablais: Lac Léman/ Portes du Soleil, Plateau de Gavot.\r\nRecorridos de descubrimiento, recorridos deportivos, enduro -DH-Electric MTB cursos de pilotaje/guiado, raids.\r\nAlquiler de VTTAE para salidas."
    ]
  },
