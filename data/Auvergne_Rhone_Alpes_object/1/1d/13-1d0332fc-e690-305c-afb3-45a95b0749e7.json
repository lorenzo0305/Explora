  "rdfs:comment": {
    "de": [
      "Dieser Familiengasthof bietet eine saisonale Küche in einem gemütlichen Rahmen. Familiäre Atmosphäre, regionale und Entdeckungsmenüs, einmal im Monat Themenessen. Überdachte Terrasse im Garten."
    ],
    "en": [
      "This family-run inn offers seasonal cuisine in a warm setting. Family atmosphere, regional and discovery menus, theme meals once a month. Covered terrace in the garden."
    ],
    "it": [
      "Questa locanda a conduzione familiare offre una cucina stagionale in un ambiente accogliente. Atmosfera familiare, menù regionali e di scoperta, pasti a tema una volta al mese. Terrazza coperta in giardino."
    ],
    "fr": [
      "Cette Auberge familiale propose une cuisine de saison dans un cadre chaleureux. Ambiance familiale, menus régionaux et de découverte, repas à thème une fois par mois. Terrasse couverte dans le jardin."
    ],
    "es": [
      "Esta posada familiar ofrece cocina de temporada en un entorno cálido. Ambiente familiar, menús regionales y de descubrimiento, comidas temáticas una vez al mes. Terraza cubierta en el jardín."
    ],
    "nl": [
      "Deze door een familie gerunde herberg biedt seizoensgebonden gerechten in een warme omgeving. Familiale sfeer, regionale en ontdekkingsmenu's, één keer per maand themamaaltijden. Overdekt terras in de tuin."
    ]
  },
  "rdfs:label": {
    "de": [
