  "rdfs:comment": {
    "de": [
      "Wir bieten Gästen außerhalb des Hotels die Möglichkeit, einen angenehmen Moment der Entspannung zu erleben, indem sie unser Outdoor-Wellness-Spa mit nordischem Bad und Panoramasauna nutzen. Neues Massageangebot mit Noémie Massages."
    ],
    "en": [
      "For guests from outside the hotel, we offer a pleasant moment of relaxation in our outdoor wellness spa with Nordic bath and panoramic sauna. New massage offer."
    ],
    "it": [
      "Gli ospiti che soggiornano fuori dall'hotel possono godersi un piacevole momento di relax nella nostra spa wellness all'aperto, completa di bagno nordico e sauna panoramica. Nuova offerta di massaggi con Noémie Massages."
    ],
    "fr": [
      "Nous proposons aux clients extérieurs à l'hôtel de vivre un agréable moment de détente en profitant de notre spa bien-être extérieur, avec bain nordique et sauna panoramique. Nouvelle offre de massage avec Noémie Massages."
    ],
    "nl": [
      "Wij bieden gasten buiten het hotel een aangenaam moment van ontspanning door gebruik te maken van onze wellness-spa in de buitenlucht, met Scandinavisch bad en panoramische sauna. Nieuwe massage aanbieding."
    ],
    "es": [
      "Los huéspedes que se alojen fuera del hotel podrán disfrutar de un agradable momento de relajación en nuestro spa wellness al aire libre, con baño nórdico y sauna panorámica. Nueva oferta de masajes con Noémie Massages."
    ]
  },
  "rdfs:label": {
    "en": [
      "Relaxation area & Spa Alpina Lodge"
    ],
    "fr": [
      "Espace détente spa Alpina Lodge"
    ],
    "nl": [
      "Ontspanningsruimte & spa van Alpina Lodge"
    ]
  },
