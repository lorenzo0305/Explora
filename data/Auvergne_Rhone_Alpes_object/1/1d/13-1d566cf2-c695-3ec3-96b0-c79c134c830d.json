  "rdfs:comment": {
    "de": [
      "Moto Quad Concept liegt zwischen Lyon und Saint Etienne und bietet Motorrad- und Quadfahrerkurse für Kinder ab 5 Jahren an. Die von Sportpädagogen betreuten Kurse dauern 2 Stunden, 2 Tage oder 3 Tage und werden auf verschiedenen Geländen durchgeführt."
    ],
    "en": [
      "Located between Lyon and Saint Etienne, Moto Quad Concept offers motorcycle and quad riding courses from 5 years old. Supervised by sports instructors, the courses last 2 hours, 2 days or 3 days and take place on different terrains."
    ],
    "it": [
      "Situato tra Lione e Saint Etienne, Moto Quad Concept offre corsi di guida di moto e quad a partire dai 5 anni. Seguiti da istruttori sportivi, i corsi durano 2 ore, 2 giorni o 3 giorni e si svolgono su terreni diversi."
    ],
    "fr": [
      "Situé entre Lyon et Saint Etienne, Moto Quad Concept propose des stages de pilotage moto et quad à partir de 5 ans. Encadrés par des éducateurs sportifs, les stages d’une durée de 2h, 2 jours ou 3 jours se pratiquent sur différents terrains."
    ],
    "es": [
      "Situado entre Lyon y Saint Etienne, Moto Quad Concept ofrece cursos de conducción de motos y quads a partir de 5 años. Supervisados por instructores deportivos, los cursos duran 2 horas, 2 días o 3 días y se desarrollan en diferentes terrenos."
    ],
    "nl": [
      "Moto Quad Concept, gelegen tussen Lyon en Saint Etienne, biedt motor- en quadrijlessen vanaf 5 jaar. De cursussen onder begeleiding van sportinstructeurs duren 2 uur, 2 dagen of 3 dagen en vinden plaats op verschillende terreinen."
    ]
  },
  "rdfs:label": {
