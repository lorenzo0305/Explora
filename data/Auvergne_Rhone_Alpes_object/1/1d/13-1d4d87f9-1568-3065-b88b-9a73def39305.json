  "rdfs:comment": {
    "de": [
      "Mit Les Abattoirs können Sie in die Welt der darstellenden Kunst eintauchen und die Erfahrung der aktuellen Musik verlängern."
    ],
    "en": [
      "In the spring of 1999, the town of Bourgoin-Jallieu decided to set up a project to create a contemporary music scene for all the young people in the area in the disused buildings of the town's slaughterhouses."
    ],
    "it": [
      "Con Les Abattoirs, immergetevi nel mondo delle performance dal vivo e ampliate la vostra esperienza della musica contemporanea."
    ],
    "fr": [
      "Avec Les Abattoirs, plongez dans l'univers du spectacle vivant et prolongez l'expérience des musiques actuelles."
    ],
    "nl": [
      "Met Les Abattoirs dompel je jezelf onder in de wereld van live optredens en breid je je ervaring met hedendaagse muziek uit."
    ],
    "es": [
      "Con Les Abattoirs, sumérjase en el mundo del espectáculo en directo y amplíe su experiencia de la música contemporánea."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Abattoirs - Scène de Musiques Actuelles"
    ]
  },
