  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3dd0b309-3149-3cee-8425-e4895b65bb70",
      "dc:description": {
        "de": [
          "\"Gewagte Geschmacksrichtungen\"\n?\nWir bevorzugen die französische und lokale Herkunft unserer Produkte!\nWir arbeiten mit mehreren lokalen Produzenten und Lieferanten zusammen ."
        ],
        "en": [
          "\"Bold flavors\n?\nWe favour French and local origins for our products!\nWe work with several local producers and suppliers."
        ],
        "it": [
          "\"Sapori audaci\n?\nPrivilegiamo le origini francesi e locali per i nostri prodotti!\nCollaboriamo con diversi produttori e fornitori locali."
        ],
        "fr": [
          "\"Des saveurs audacieuses\"\n​\nNous privilégions les origines françaises et locales de nos produits ! \nNous travaillons avec plusieurs producteurs et fournisseurs locaux ."
        ],
        "es": [
          "\"Sabores atrevidos\n?\nFavorecemos los orígenes franceses y locales de nuestros productos\nTrabajamos con varios productores y proveedores locales."
        ],
        "nl": [
          "\"Gedurfde smaken\n?\nWij geven de voorkeur aan Franse en lokale oorsprong voor onze producten!\nWe werken met verschillende lokale producenten en leveranciers."
        ]
      },
