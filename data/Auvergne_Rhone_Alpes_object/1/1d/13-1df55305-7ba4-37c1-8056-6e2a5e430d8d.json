  "rdfs:comment": {
    "de": [
      "Interaktives Museum, das Jules Romains und seinem Werk gewidmet ist. Videos, Touchscreen, Konservatorium mit französischer/englischer Tonspur, Klangkammer, Selbstbedienungscomputer, Escape Game für Kinder und Ausstellungsbereich."
    ],
    "en": [
      "Interactive museum dedicated to Jules Romains and his work. Videos, touch screen, conservatory with French/English soundtrack, sound room, self-service computers, escape game for children, and exhibition space."
    ],
    "it": [
      "Un museo interattivo dedicato a Jules Romains e alla sua opera. Video, touch screen, conservatorio con colonna sonora francese/inglese, sala audio, computer self-service, gioco di fuga per bambini e spazio espositivo."
    ],
    "fr": [
      "Musée inter actif dédié à Jules Romains et à son œuvre. Vidéos, dalle tactile, conservatoire avec bande son français/anglais, chambre sonore , ordinateurs en libre service, escape game destiné aux enfants, et espace d'expositions."
    ],
    "es": [
      "Museo interactivo dedicado a Jules Romains y su obra. Vídeos, pantalla táctil, conservatorio con banda sonora en francés/inglés, sala de sonido, ordenadores de autoservicio, juego de escape para niños y espacio de exposición."
    ],
    "nl": [
      "Een interactief museum gewijd aan Jules Romains en zijn werk. Video's, aanraakscherm, serre met Frans/Engelse soundtrack, geluidskamer, zelfbedieningscomputers, ontsnappingsspel voor kinderen en tentoonstellingsruimte."
    ]
