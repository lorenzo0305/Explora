  "rdfs:comment": {
    "de": [
      "Dieses Museum zeigt verschiedene Gegenstände aus der Römerzeit, die auf dem Gemeindegebiet gefunden wurden (vollständig rekonstruierte römische Grabstätte, Münzen, Statuette des Silenus, Töpferwaren, Friese). Der Geschichte des Dorfes gewidmeter Raum."
    ],
    "en": [
      "Collecting of varied things founded on the village's territory (roman burial restorated, coins, Silène statuette, poteries, frises borders). Special space about the history of the village."
    ],
    "it": [
      "Questo museo contiene vari oggetti di epoca romana rinvenuti nel villaggio (sepoltura romana completamente ricostruita, monete, statuetta di Sileno, ceramica, fregi). Uno spazio dedicato alla storia del villaggio."
    ],
    "fr": [
      "Ce musée recense divers objets de l'époque romaine trouvés sur le territoire communal (sépulture romaine entièrement reconstituée, pièces de monnaie, statuette de Silène, poteries, frises). Espace dédié à l'histoire du village."
    ],
    "es": [
      "Este museo contiene diversos objetos de la época romana encontrados en el pueblo (enterramiento romano totalmente reconstruido, monedas, estatuilla de Sileno, cerámica, frisos). Un espacio dedicado a la historia del pueblo."
    ],
    "nl": [
      "Dit museum exposeert diverse objecten uit de romeinse tijd gevonden op gemeentelijke grond (Romeinse grafplaats geheel gereconstrueerd, muntstukken, beeldje van Silène, aardewerk, kroezen). Ruimte gewijd aan de geschiedenis van het dorp."
    ]
  },
