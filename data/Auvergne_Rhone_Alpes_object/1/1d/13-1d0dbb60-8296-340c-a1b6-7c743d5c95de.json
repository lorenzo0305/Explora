  "rdfs:comment": {
    "de": [
      "Familiengeführtes Restaurant, das jede Woche ein anderes Mittagessen anbietet. Ideal für Mahlzeiten mit der Familie, mit Freunden oder für Geschäftsleute.\r\nBei schönem Wetter besteht die Möglichkeit, auf der Terrasse zu essen"
    ],
    "en": [
      "Family restaurant, offering a different lunch every week. Ideal for family meals, friends or professionals.\r\nOn sunny days it is possible to eat on the terrace"
    ],
    "it": [
      "Ristorante a conduzione familiare, che offre un pranzo diverso ogni settimana. Ideale per la famiglia, gli amici o gli affari.\r\nNelle giornate di sole è possibile mangiare in terrazza"
    ],
    "fr": [
      "Restaurant familial, proposant un repas de midi différent chaque semaine. Idéal que ce soit pour des repas en famille, entre amis ou pour des professionnels.\r\nAu beau jour possibilité de manger en terrasse"
    ],
    "es": [
      "Restaurante familiar, que ofrece un almuerzo diferente cada semana. Ideal para la familia, los amigos o los negocios.\r\nEn los días soleados se puede comer en la terraza"
    ],
    "nl": [
      "Familie restaurant, met elke week een andere lunch. Ideaal voor familie, vrienden of zaken.\r\nOp zonnige dagen is het mogelijk om op het terras te eten"
    ]
  },
  "rdfs:label": {
