  "rdfs:comment": {
    "de": [
      "Dieses Chalet-Restaurant liegt am Ende des Ärmelkanaltals, nur wenige Gehminuten vom Lac des Mines d'Or entfernt. Es ist ideal für eine kleine Pause nach einem schönen Spaziergang.\r\nDas Restaurant empfängt Sie im Sommer wie im Winter und bietet Ihnen abwechslungsreiche Gerichte.\r\nHausgemachte Küche."
    ],
    "en": [
      "Chalet restaurant located at the end of La Vallée de la Manche, just a few minutes' walk from Lac des Mines d'Or, ideal for a short break after a good walk.\r\nThe restaurant welcomes you summer and winter alike, and offers a variety of dishes.\r\nHome cooking."
    ],
    "it": [
      "Chalet ristorante situato in fondo alla Vallée de la Manche, a pochi minuti a piedi dal Lac des Mines d'Or, ideale per una breve pausa dopo una bella passeggiata.\r\nIl ristorante vi accoglie in estate e in inverno e offre una varietà di piatti.\r\nCucina casalinga."
    ],
    "fr": [
      "Chalet restaurant situé au fond de La Vallée de la Manche, à quelques minutes à pied du Lac des Mines d'Or, idéal pour une petite pause après une bonne balade.\r\nLe restaurant vous accueille été comme hiver et vous propose des plats variés.\r\nCuisine Maison."
    ],
    "es": [
      "Chalet-restaurante situado en el fondo del Valle de la Mancha, a pocos minutos a pie del Lago de las Minas de Oro, ideal para un breve descanso después de una buena caminata.\r\nEl restaurante le da la bienvenida tanto en verano como en invierno y ofrece una gran variedad de platos.\r\nCocina casera."
    ],
    "nl": [
      "Chalet-restaurant gelegen aan het einde van La Vallée de la Manche, op slechts een paar minuten lopen van het Lac des Mines d'Or, ideaal voor een korte pauze na een stevige wandeling.\r\nHet restaurant verwelkomt je in de zomer en winter en biedt een verscheidenheid aan gerechten.\r\nThuis koken."
    ]
  },
  "rdfs:label": {
