  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/64d8430d-bac1-3565-a93b-a47f19aa3ff7",
      "dc:description": {
        "de": [
          "Die Ausstellung \"CORONS\" von Patrick Devresse erkundet das Arbeitergedächtnis der Bergarbeitersiedlungen. Mit seinen sensiblen und nüchternen Fotografien fängt der Künstler die Seele der Orte und das Alltagsleben der Bewohner ein."
        ],
        "en": [
          "Patrick Devresse's \"CORONS\" exhibition explores the working-class memory of mining towns. Through sensitive, sober photographs, the artist captures the soul of the place and the daily lives of its inhabitants."
        ],
        "it": [
          "La mostra \"CORONS\" di Patrick Devresse esplora la memoria operaia delle città minerarie. Attraverso fotografie sensibili e sobrie, l'artista cattura l'anima del luogo e la vita quotidiana dei suoi abitanti."
        ],
        "fr": [
          "L'exposition \"CORONS\" de Patrick Devresse explore la mémoire ouvrière des cités minières. À travers des photographies sensibles et sobres, l'artiste capture l’âme des lieux et la vie quotidienne des habitants."
        ],
        "es": [
          "La exposición \"CORONS\" de Patrick Devresse explora la memoria obrera de las ciudades mineras. A través de fotografías sensibles y sobrias, el artista capta el alma del lugar y la vida cotidiana de sus habitantes."
        ],
        "nl": [
          "De tentoonstelling \"CORONS\" van Patrick Devresse onderzoekt het arbeidersgeheugen van mijnsteden. Door middel van gevoelige, sobere foto's legt de kunstenaar de ziel van de plek en het dagelijks leven van de inwoners vast."
        ]
      },
      "@type": [
        "Description"
      ],
