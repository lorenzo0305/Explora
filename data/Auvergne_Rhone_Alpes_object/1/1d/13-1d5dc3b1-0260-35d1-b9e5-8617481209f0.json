  "rdfs:comment": {
    "de": [
      "Das Zentrum von Bourg-en-Bresse hat viel zu erzählen. Ein Rundgang (Plan oder Besuchsheft) lädt Sie zu einem neugierigen Bummel ein. So können Sie in Ihren Erinnerungen ein dokumentiertes Porträt der Stadt hinterlassen."
    ],
    "en": [
      "The center of Bourg-en-Bresse has a lot to offer. An itinerary (map or visit booklet) invites you to take a curious stroll, leaving a documented portrait of the town in your memories."
    ],
    "it": [
      "Il centro di Bourg-en-Bresse ha molto da offrire. Un percorso (mappa o libretto di visita) vi invita a fare una passeggiata curiosa, lasciando nei vostri ricordi un ritratto documentato della città."
    ],
    "fr": [
      "Le centre de Bourg-en-Bresse a de quoi raconter. Un parcours (plan ou livret de visite) vous invite à une flânerie curieuse, de quoi laisser dans vos souvenirs un portrait documenté de la ville."
    ],
    "nl": [
      "Het centrum van Bourg-en-Bresse heeft veel te bieden. Een parcours (kaart of bezoekersboekje) nodigt je uit om een nieuwsgierige wandeling te maken en een gedocumenteerd portret van de stad achter te laten in je herinneringen."
    ],
    "es": [
      "El centro de Bourg-en-Bresse tiene mucho que ofrecer. Un sendero (mapa o folleto para visitantes) le invita a dar un curioso paseo, dejando en su memoria un documentado retrato de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours Patrimoine à Bourg-en-Bresse"
    ]
  },
