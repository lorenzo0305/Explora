  "rdfs:comment": {
    "de": [
      "Organisation von Wandertagen und -aufenthalten in Frankreich, Europa, Marokko, etc.\r\n\r\n Rundreisen ab Frangy und St Julien mit Transport im Minibus. Entdeckungen und/oder körperliche Anstrengung, Komfort und Gastronomie sind unsere Markenzeichen."
    ],
    "en": [
      "Organization of hiking days and stays in France, Europe, Morocco, etc.\r\n\r\n Tours depart from Frangy and St Julien, with transport by mini-bus. Discovery and/or physical effort, comfort and gastronomy are our trademarks."
    ],
    "it": [
      "Organizzazione di escursioni giornaliere e di vacanze a piedi in Francia, Europa, Marocco, ecc.\r\n\r\n Tour in partenza da Frangy e St Julien con trasporto in minibus. Scoperta e/o sforzo fisico, comfort e gastronomia sono i nostri marchi."
    ],
    "fr": [
      "Organisation de journée et séjours de randonnées en France, Europe, Maroc, etc\r\n\r\n Circuits au départ de Frangy et St Julien avec transport en mini bus. Découverte et/ou effort physique, confort et gastronomie sont nos marques de fabrique."
    ],
    "es": [
      "Organización de viajes de un día y vacaciones a pie en Francia, Europa, Marruecos, etc.\r\n\r\n Salidas desde Frangy y St Julien con transporte en minibús. Descubrimiento y/o esfuerzo físico, comodidad y gastronomía son nuestras señas de identidad."
    ],
    "nl": [
      "Organisatie van dagtochten en wandelvakanties in Frankrijk, Europa, Marokko, enz\r\n\r\n Tochten met vertrek vanuit Frangy en St Julien met vervoer per minibus. Ontdekking en/of fysieke inspanning, comfort en gastronomie zijn onze handelsmerken."
    ]
  },
