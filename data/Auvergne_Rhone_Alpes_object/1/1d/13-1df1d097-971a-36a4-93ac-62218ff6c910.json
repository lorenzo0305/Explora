  "rdfs:comment": {
    "de": [
      "Elegantes Hotel mit dem europäischen Umweltzeichen & Gourmet-Restaurant Logis.  Zwischen Gerichten à la carte und Menüs wird unser Restaurant Genießer begeistern, die auf der Suche nach einer hausgemachten und saisonalen Küche sind. Nomadenkörbe, Picknicks, Boutique mit Produkten."
    ],
    "en": [
      "Elegant European Ecolabel hotel & gourmet Logis restaurant.  With its à la carte dishes and menus, our restaurant will delight epicureans looking for homemade, seasonal cuisine. Nomad baskets, picnics, produce shop."
    ],
    "it": [
      "Hôtel Élégance Écolabel Européen & Restaurant Gourmand Logis.\r\nCon i suoi piatti e menu à la carte, il nostro ristorante delizierà i buongustai alla ricerca di una cucina casalinga e stagionale. Cestini da picnic, negozio di prodotti."
    ],
    "fr": [
      "Hôtel Élégance Écolabel Européen & Restaurant Gourmand Logis.\r\nEntre les plats à la carte et les menus, notre restaurant ravira les épicuriens à la recherche d’une cuisine faite maison et de saison. Paniers pique-nique, boutique de produits."
    ],
    "es": [
      "Hôtel Élégance Écolabel Européen & Restaurant Gourmand Logis.\r\nCon sus platos a la carta y sus menús, nuestro restaurante hará las delicias de los epicúreos que buscan una cocina casera y de temporada. Cestas de picnic, tienda de productos."
    ],
    "nl": [
      "Elegant Europees Ecolabel hotel & gastronomisch Logis restaurant.  Met zijn à la carte gerechten en menu's zal ons restaurant fijnproevers die op zoek zijn naar huisgemaakte, seizoensgebonden gerechten verrukken. Nomadenmanden, picknicks, kruidenierswinkel."
    ]
  },
