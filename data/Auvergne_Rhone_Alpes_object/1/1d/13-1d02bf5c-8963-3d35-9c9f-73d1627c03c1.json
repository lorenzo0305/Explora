  "rdfs:comment": {
    "de": [
      "Der größte Escape-Game-Komplex in der Region. 5 Escape Rooms, 16 VR-Spiele und ein Seminarraum.\nWein-/Bier-/Spiele-/Catering-Bar. Team Building, kollektive Intelligenz, Seminare & Raumvermietung.\nEin 600m² großer Komplex."
    ],
    "en": [
      "The largest Escape Game complex in the region. 5 Escape Rooms, 16 VR games and a seminar room.\nWine / Beer / Games / Catering bar. Team Building, Collective intelligence, Seminars & room hire.\nA 600m² complex."
    ],
    "it": [
      "Il più grande complesso di Escape Game della regione. 5 Escape Room, 16 giochi VR e una sala per seminari.\nBar con vino / birra / giochi / catering. Team Building, intelligenza collettiva, seminari e noleggio di sale.\nUn complesso di 600 m²."
    ],
    "fr": [
      "Le plus grand complexe d’Escape Game de la région. 5 Escape Rooms, 16 jeux de VR et une salle de séminaire.\nBar à Vins / Bières /Jeux / Restauration. Team Building, Intelligence collective, Séminaires & location de salle.\nUn complexe de 600m²."
    ],
    "nl": [
      "Het grootste Escape Game complex in de regio. 5 Escape Rooms, 16 VR-spellen en een seminarruimte.\nWijn / Bier / Spelletjes / Catering bar. Teambuilding, collectieve intelligentie, seminars & zaalverhuur.\nEen complex van 600m²."
    ],
    "es": [
      "El mayor complejo de juegos de escape de la región. 5 Escape Rooms, 16 juegos VR y una sala de seminarios.\nBar de vinos / cervezas / juegos / catering. Team Building, inteligencia colectiva, seminarios y alquiler de salas.\nUn complejo de 600m²."
    ]
  },
