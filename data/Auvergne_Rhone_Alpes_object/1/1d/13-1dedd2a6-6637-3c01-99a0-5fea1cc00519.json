  "rdfs:comment": {
    "de": [
      "Vermietung (touristisch und langfristig), Verkauf und Reparatur von Fahrrädern (Elektro- und Muskelfahrräder).\r\nFür den Verleih werden ausschließlich Elektrofahrräder verwendet (VTC, VTX, Mountainbikes, Kinderfahrräder, Anhänger, Babysitze)."
    ],
    "en": [
      "Rental (tourist and long-term), sale and repair of bicycles (electric and muscle).\r\nRental bikes are exclusively electric (VTC, VTX, mountain bikes, children's bikes, trailers, baby seats)."
    ],
    "it": [
      "Noleggio (turistico e a lungo termine), vendita e riparazione di biciclette (elettriche e muscolari).\r\nLe biciclette a noleggio sono esclusivamente elettriche (VTC, VTX, mountain bike, bici per bambini, rimorchi, seggiolini)."
    ],
    "fr": [
      "Location (touristique et longue durée), vente et réparation de vélos (électriques et musculaires).\r\nPour la location, les vélos sont exclusivement électriques (VTC, VTX, VTT, vélos enfants, remorques, sièges bébés)."
    ],
    "nl": [
      "Verhuur (toeristisch en langdurig), verkoop en reparatie van fietsen (elektrisch en muscle bikes).\r\nDe huurfietsen zijn uitsluitend elektrisch (VTC, VTX, mountainbikes, kinderfietsen, aanhangers, babyzitjes)."
    ],
    "es": [
      "Alquiler (turístico y de larga duración), venta y reparación de bicicletas (eléctricas y musculares).\r\nLas bicicletas de alquiler son exclusivamente eléctricas (VTC, VTX, bicicletas de montaña, bicicletas para niños, remolques, sillas para bebés)."
    ]
  },
