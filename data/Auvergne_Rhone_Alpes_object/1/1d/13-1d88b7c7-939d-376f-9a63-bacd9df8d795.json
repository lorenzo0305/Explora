  "rdfs:comment": {
    "de": [
      "Das Bistrot du Rocher ist ein Restaurant, eine Bar und ein Feinkostladen in einem netten Rahmen mit Blick auf den Felsen! Hausgemachte Küche aus guten lokalen Produkten. Spielplatz für Kinder, Boulespiel, Schach... Alles, um eine gute Zeit mit der Familie oder mit Freunden zu verbringen."
    ],
    "en": [
      "Le Bistrot du Rocher is a restaurant, bar and delicatessen in an attractive setting overlooking the Rock! Home-cooked cuisine using local produce. Children's play area, pétanque, chess... Everything you need for a good time with family and friends."
    ],
    "it": [
      "Le Bistrot du Rocher è un ristorante, bar e gastronomia in un ambiente delizioso con vista sulla Rocca! Cucina casalinga con prodotti locali. Area giochi per bambini, pétanque, scacchi? Tutto ciò di cui avete bisogno per divertirvi con la famiglia e gli amici."
    ],
    "fr": [
      "Le Bistrot du Rocher, c’est resto, bar et épicerie fine dans un cadre sympa avec vue sur le rocher ! Cuisine maison à base de bons produits locaux. Aire de jeux pour les enfants, pétanque, échecs… Tout pour passer un bon moment en famille ou entre amis."
    ],
    "nl": [
      "Le Bistrot du Rocher is een restaurant, bar en delicatessenwinkel in een prachtige omgeving met uitzicht op de Rots! Huisgemaakte gerechten met lokale producten. Speeltuin, petanque, schaken... Alles wat je nodig hebt voor een gezellige tijd met familie en vrienden."
    ],
    "es": [
      "Le Bistrot du Rocher es un restaurante, bar y tienda de delicatessen en un entorno encantador con vistas al Peñón Cocina casera elaborada con productos locales. Zona de juegos para niños, petanca, ajedrez.. Todo lo necesario para disfrutar en familia o entre amigos."
    ]
  },
