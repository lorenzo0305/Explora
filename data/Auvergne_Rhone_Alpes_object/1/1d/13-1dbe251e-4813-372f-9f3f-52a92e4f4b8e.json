  "rdfs:comment": {
    "de": [
      "CAVISTE & Bar, mit einem breiten Angebot an Bieren, Weinen, Spirituosen und selbstgemachten Getränken. Terrasse mit angenehmer Aussicht am Ufer der Rhône.\r\nEis und gekühlte Getränke"
    ],
    "en": [
      "With their list regularly renewed, come and enjoy  the taste of over 130 references in beer, wine, fruit sirop and soft drinks coming from France and all over the world, in an exceptional setting overlooking the Rhône river."
    ],
    "it": [
      "CAVISTE & bar, con una vasta gamma di birre, vini, liquori e bevande artigianali. Terrazza con una piacevole vista sul Rodano.\r\nGelati e bevande fredde"
    ],
    "fr": [
      "CAVISTE & bar, avec une large offre de bières, vins, spiritueux, boissons artisanales. Terrasse avec vue agréable au bord du Rhône.\r\nGlace et boissons fraiches"
    ],
    "nl": [
      "CAVISTE & bar, met een breed assortiment bieren, wijnen, sterke dranken en ambachtelijke dranken. Terras met een aangenaam uitzicht op de Rhône.\r\nIjs en koude dranken"
    ],
    "es": [
      "CAVISTE & bar, con una amplia gama de cervezas, vinos, licores y bebidas artesanales. Terraza con una agradable vista del Ródano.\r\nHelados y bebidas frías"
    ]
  },
  "rdfs:label": {
