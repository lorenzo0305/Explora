  "rdfs:comment": {
    "de": [
      "Sauna, Hammam, Entspannungsbereich und Balneotherapie. Ein außergewöhnlicher Ort in einer gemütlichen und stilvollen Umgebung für Ihr Wohlbefinden. Massagen und Gesichtspflege nach Terminvereinbarung."
    ],
    "en": [
      "Sauna, hammam, relaxing space and balneotherapy. A place of exception in the heart of a design and cosy atmosphere for a well-being break. Body modelling and facials by appointment."
    ],
    "it": [
      "Sauna, hammam, spazio di rilassamento e balneoterapia. Un luogo speciale nel cuore di un ambiente design e cosy per una pausa benessere. \r\nScopra l'universo d'ENATAE, lo spirito natura della nostra antica terra."
    ],
    "fr": [
      "Sauna, hammam, espace détente et balnéothérapie. Un lieu d'exception au coeur d'une ambiance design et cosy pour une parenthèse bien-être. Modelage du corps, soins du visage sur rendez-vous."
    ],
    "nl": [
      "Sauna, hammam, ontspanningsruimte en balneotherapie. Een uitzonderlijke plek in het hart van een design en gezellige sfeer voor een welzijnsvakantie. Lichaamsmodellen, gezichtsbehandelingen op afspraak."
    ],
    "es": [
      "Sauna, baño de vapor, espacio bienestar y balneoterapia."
    ]
  },
