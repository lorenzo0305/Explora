  "rdfs:comment": {
    "de": [
      "Das Ziel von Fleurs des Shan ist es, das Wissen über Pflanzen zu erhalten, aufzuwerten und weiterzugeben.\r\n? sh?n ist das Sinogramm für Berg, ein Ort, an dem eine außergewöhnliche Flora wächst."
    ],
    "en": [
      "Fleurs des Shan aims to preserve, promote and pass on plant-related knowledge.\r\n山 shān is the sinogram meaning mountain, a place where extraordinary flora grows."
    ],
    "it": [
      "Fleurs des Shan si propone di preservare, promuovere e trasmettere la conoscenza delle piante.\r\nshan è il sinogramma che significa montagna, un luogo dove cresce una flora straordinaria."
    ],
    "fr": [
      "Fleurs des Shan a pour objet la préservation, la valorisation et la transmission des savoirs relatifs aux plantes.\r\n山 shān est le sinogramme qui signifie la montagne, lieu où pousse une flore extraordinaire."
    ],
    "nl": [
      "Fleurs des Shan wil kennis over planten behouden, bevorderen en doorgeven.\r\n山 shān is het sinogram dat berg betekent, een plek waar bijzondere flora groeit."
    ],
    "es": [
      "El objetivo de Fleurs des Shan es preservar, promover y transmitir conocimientos sobre las plantas.\r\nshan es el sinograma que significa montaña, un lugar donde crece una flora extraordinaria."
    ]
  },
