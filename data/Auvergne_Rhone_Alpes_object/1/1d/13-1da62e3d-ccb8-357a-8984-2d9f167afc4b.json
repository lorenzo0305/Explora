  "rdfs:comment": {
    "de": [
      "Ein Ort, der der Kunst der Fotografie gewidmet ist. Showroom, Konferenzen, Ausstellungen, Kurse.\nWir bieten auch Dienstleistungen rund um die Fotografie an: Passfotos, Fotoreportagen (Hochzeit, Immobilien, Events, Sport) Studiofotos, Packshot."
    ],
    "en": [
      "Boris Molinier Photo Workshop."
    ],
    "it": [
      "Workshop fotografico di Boris Molinier."
    ],
    "fr": [
      "Un endroit dédié à l'art de la photographie. Showroom, conférences, expositions, cours.\nNous proposons également des services à la photographie : Photos d'identité, reportages photo (mariage, immobilier, événementiel, sport) photos en studio, packshot."
    ],
    "es": [
      "Un lugar dedicado al arte de la fotografía. Sala de exposiciones, conferencias, exposiciones, cursos.\nTambién ofrecemos servicios de fotografía: fotos de pasaporte, reportajes fotográficos (bodas, inmobiliaria, eventos, deporte), fotos de estudio, packshots."
    ],
    "nl": [
      "Een plek gewijd aan de kunst van fotografie. Showroom, conferenties, tentoonstellingen, cursussen.\nWe bieden ook fotografiediensten aan: pasfoto's, fotoreportages (bruiloften, onroerend goed, evenementen, sport), studiofoto's, packshots."
    ]
  },
