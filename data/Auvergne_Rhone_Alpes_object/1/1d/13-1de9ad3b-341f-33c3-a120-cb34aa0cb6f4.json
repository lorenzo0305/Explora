  "rdfs:comment": {
    "de": [
      "Von der Rebe bis zum Glas, die Sorge um die Natürlichkeit: biodynamische Landwirtschaft für gesunde Böden, Reben und Trauben. Die Domaine bietet Saint-Joseph und Rebsortenweine als Rot- oder Weißwein an."
    ],
    "en": [
      "From the vine to  glass, mindfulness of the natural environment : organic agriculture for the soils, vines and healthy grapes. Saint Joseph, wines from red or white grape varieties and others wines to drink."
    ],
    "it": [
      "Dalla vigna al bicchiere, l'attenzione per la naturalità: agricoltura biodinamica per terreni, viti e uve sane. Il Domaine offre vini Saint-Joseph e varietali in rosso o in bianco."
    ],
    "fr": [
      "De la vigne au verre, le souci du naturel : agriculture biodynamique pour des sols, des vignes et des raisins sains. Le Domaine propose des Saint-Joseph et des vins de cépages en rouge ou en blanc."
    ],
    "nl": [
      "Van de wijnstok tot het glas, de zorg voor natuurlijkheid: biodynamische landbouw voor een gezonde bodem, wijnstokken en druiven. Het Domaine biedt Saint-Joseph en cépagewijnen in rood of wit."
    ],
    "es": [
      "De la viña a la copa, la preocupación por la naturalidad: la agricultura biodinámica para la salud de los suelos, las viñas y las uvas. El Domaine ofrece vinos Saint-Joseph y varietales en tinto o blanco."
    ]
  },
