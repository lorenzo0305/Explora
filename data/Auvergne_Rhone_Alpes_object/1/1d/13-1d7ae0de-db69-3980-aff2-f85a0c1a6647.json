  "rdfs:comment": {
    "de": [
      "Restaurant im Zentrum des Dorfes, ruhige und sonnige Terrasse mit Blick auf die Aravis-Kette. Moderne Küche und Feinschmeckerküche. Schöne Weinkarte."
    ],
    "en": [
      "Restaurant in the center of the village, quiet and sunny terrace facing the Aravis mountain range. Modern and gourmet cuisine. Nice wine list."
    ],
    "it": [
      "A pochi passi dal villaggio, il ristorante Auberge du Pré Vieux si trova al 1° piano di un autentico chalet di oltre 40 anni."
    ],
    "fr": [
      "À deux pas du village, le restaurant l’Auberge du Pré Vieux se trouve au 1er étage d’un chalet authentique vieux de plus de 40 ans."
    ],
    "nl": [
      "Op een steenworp afstand van het dorp ligt restaurant Auberge du Pré Vieux op de 1e verdieping van een authentiek chalet van meer dan 40 jaar oud."
    ],
    "es": [
      "A dos pasos del pueblo, el restaurante Auberge du Pré Vieux se encuentra en la 1ª planta de un auténtico chalet de más de 40 años."
    ]
  },
