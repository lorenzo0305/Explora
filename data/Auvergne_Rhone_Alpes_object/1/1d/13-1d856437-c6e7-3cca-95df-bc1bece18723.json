  "rdfs:comment": {
    "de": [
      "Neues Schönheitsinstitut und Spa \"Léman Bien-être\" in Evian zu entdecken. Es befindet sich im Hotel \"Les Cygnes\" und steht allen offen. Egal, ob Sie Hotelgast sind oder nicht, buchen Sie Ihre Behandlung und lassen Sie sich verwöhnen."
    ],
    "en": [
      "New beauty salon and SPA \"Léman Bien-être\" is to discover in Evian.\r\nLocated in the hotel \"Les Cygnes\" et open to all, wether your are a resident of the hotal or not, book your wellness treatment and get yourself pampered."
    ],
    "it": [
      "Nuovo istituto di bellezza e SPA \"Léman Bien-être\" da scoprire a Evian. Situato all'interno dell'Hotel \"Les Cygnes\" e aperto a tutti, residenti o meno, prenotate il vostro trattamento e lasciatevi coccolare."
    ],
    "fr": [
      "Nouvel institut de beauté et SPA « Léman Bien-être\" à découvrir sur Evian. Situé à l’Hôtel « Les Cygnes » et ouvert à tous, que vous soyez résident de l’hôtel ou non, réservez votre soin et faites-vous chouchouter."
    ],
    "es": [
      "Nuevo instituto de belleza y SPA \"Léman Bien-être\" para descubrir en Evian. Situado en el Hotel \"Les Cygnes\" y abierto a todos, sea o no residente del hotel, reserve su tratamiento y déjese mimar."
    ],
    "nl": [
      "Nieuwe schoonheidssalon en SPA \"Léman Bien-être\" te ontdekken in Evian. Gelegen in Hôtel \"Les Cygnes\" en open voor iedereen, of je nu in het hotel verblijft of niet, boek je behandeling en laat je verwennen."
    ]
  },
  "rdfs:label": {
