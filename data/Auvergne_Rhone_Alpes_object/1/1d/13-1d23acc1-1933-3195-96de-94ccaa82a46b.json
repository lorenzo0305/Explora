  "rdfs:comment": {
    "de": [
      "Ornelle ist eine freiberufliche Fotografin aus dem Allier, die aus Montluçon stammt und dort lebt. Sie ist auch Botschafterin des Departements und liebt es, auf ihren Spaziergängen einen Moment, eine Landschaft oder eine Emotion einzufangen und sie mit anderen zu teilen."
    ],
    "en": [
      "Ornelle is a freelance photographer from the Allier region, originally from and living in Montluçon. Also an ambassador for the department, she likes to capture a moment, a landscape, an emotion on her walks, and share it with others."
    ],
    "it": [
      "Ornelle è una fotografa freelance della regione dell'Allier, nativa e residente a Montluçon. È anche ambasciatrice del dipartimento e si diverte a catturare momenti, paesaggi ed emozioni durante le sue passeggiate e a condividerli con gli altri."
    ],
    "fr": [
      "Ornelle est photographe indépendante de l’Allier, originaire et habitante de Montluçon. Également ambassadrice du département, elle aime lors de ses balades, capter un instant, un paysage, une émotion et la partager."
    ],
    "nl": [
      "Ornelle is een freelance fotograaf uit de Allier, oorspronkelijk uit en woonachtig in Montluçon. Ze is ook ambassadrice van het departement en houdt ervan om tijdens haar wandelingen een moment, een landschap of een emotie vast te leggen en met anderen te delen."
    ],
    "es": [
      "Ornelle es una fotógrafa independiente de la región de Allier, nativa y residente en Montluçon. También es embajadora del departamento y le gusta capturar momentos, paisajes y emociones en sus paseos y compartirlos con los demás."
    ]
  },
  "rdfs:label": {
    "fr": [
