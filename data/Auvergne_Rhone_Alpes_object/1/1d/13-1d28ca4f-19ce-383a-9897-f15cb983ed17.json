  "rdfs:comment": {
    "de": [
      "Salles bewahrt zahlreiche Spuren seines antiken Glanzes: gallo-römische Überreste, Cluniazenserpriorat, Kirche aus dem 11. Jahrhundert, Kapitel aus dem 18. Jahrhundert mit Garten und Kanonissenhäusern"
    ],
    "en": [
      "Halls preserve many traces of its ancient splendour: Gallo-Roman remains, Cluniac priory, 11th century church, 18th century chapter with garden and canonesses' houses"
    ],
    "it": [
      "Salles ha conservato molte tracce del suo antico splendore: resti gallo-romani, un priorato cluniacense, una chiesa dell'XI secolo, un capitolo del XVIII secolo con giardino e case dei canonici"
    ],
    "fr": [
      "Salles conserve de nombreuses traces de son antique splendeur : vestiges gallo-romain, prieuré clunisien, église XIème siècle, chapitre du XVIIIème siècle avec jardin et maisons de chanoinesses"
    ],
    "nl": [
      "Salles heeft veel sporen van zijn oude pracht en praal behouden: Gallo-Romeinse overblijfselen, een Cluniac priory, een 11e eeuwse kerk, een 18e eeuwse kapittel met een tuin en kanunnikenhuizen"
    ],
    "es": [
      "Salles ha conservado numerosos vestigios de su antiguo esplendor: restos galo-romanos, un priorato cluniacense, una iglesia del siglo XI, un cabildo del siglo XVIII con un jardín y casas de canónigos"
    ]
  },
