  "rdfs:comment": {
    "de": [
      "Am Fuße des Mont Aiguille.\r\nIn diesem Restaurant, in dem die lokalen Produkte im Vordergrund stehen, können Sie Ihren Gaumen verwöhnen.\r\nZwei Speisesäle und eine Bar stehen Ihnen zur Verfügung, außerdem eine große Terrasse."
    ],
    "en": [
      "At the foot of Mont Aiguille.\r\nCome and treat your taste buds to family-style local cuisine in this restaurant, where local products are given pride of place.\r\nTwo dining rooms and a bar are at your disposal, as well as a large terrace."
    ],
    "it": [
      "Ai piedi del Mont Aiguille.\r\nVenite a deliziare il vostro palato con una cucina locale e familiare in questo ristorante, dove i prodotti locali sono al primo posto.\r\nCi sono due sale da pranzo e un bar, oltre a un'ampia terrazza."
    ],
    "fr": [
      "Au pied du Mont Aiguille.\r\nCuisine familiale du terroir, venez régaler vos papilles dans ce restaurant où les produits locaux sont à l'honneur.\r\nDeux salles de restaurant ainsi qu'un bar sont à votre disposition également une grande terrasse."
    ],
    "nl": [
      "Aan de voet van de Mont Aiguille.\r\nKom je smaakpapillen verwennen met de lokale, familiale keuken in dit restaurant waar lokale producten de hoofdrol spelen.\r\nEr zijn twee eetzalen en een bar, evenals een groot terras."
    ],
    "es": [
      "A los pies del Monte Aiguille.\r\nDisfrute de la cocina local y familiar en este restaurante, donde los productos locales son los protagonistas.\r\nDispone de dos comedores, un bar y una gran terraza."
    ]
  },
