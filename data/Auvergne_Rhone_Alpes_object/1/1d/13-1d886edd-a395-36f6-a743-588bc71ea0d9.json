  "rdfs:comment": {
    "de": [
      "Heimat der nordischen Disziplinen: Langlauf, Skating, Schneeschuhwandern.\r\nOrganisation von Sportveranstaltungen und Entdeckungstagen für die ganze Familie.\r\n\r\nAusflüge für Schulen, Vereine und Einführung in den Biathlon.\r\nVerleih von Material und Verkauf von Lizenzgebühren."
    ],
    "en": [
      "Home for Nordic disciplines: cross-country skiing, skating, snowshoeing.\r\nOrganization of sporting events and discovery days for the whole family.\r\n\r\nSchool, club and biathlon outings.\r\nEquipment rental and royalty sales."
    ],
    "it": [
      "Centro di sport nordici: sci di fondo, pattinaggio, racchette da neve.\r\nOrganizzazione di eventi sportivi e giornate di scoperta per tutta la famiglia.\r\n\r\nGite scolastiche, gite di club e corsi di introduzione al biathlon.\r\nNoleggio di attrezzature e vendita di diritti d'autore."
    ],
    "fr": [
      "Foyer des disciplines nordiques : ski de fond, skating, raquettes.\r\nOrganisation de manifestations sportives et de journées découvertes pour toute la famille.\r\n\r\nSorties scolaires, club et initiation au biathlon.\r\nLocation de matériel et vente de redevances."
    ],
    "nl": [
      "Noords sportcentrum: langlaufen, schaatsen, sneeuwschoenwandelen.\r\nOrganisatie van sportevenementen en ontdekkingsdagen voor het hele gezin.\r\n\r\nSchoolreisjes, clubreisjes en kennismakingscursussen biatlon.\r\nVerhuur van materiaal en verkoop van royalty's."
    ],
    "es": [
      "Centro de deportes nórdicos: esquí de fondo, patinaje, raquetas de nieve.\r\nOrganización de eventos deportivos y jornadas de descubrimiento para toda la familia.\r\n\r\nSalidas escolares, salidas de clubes y cursos de iniciación al biatlón.\r\nAlquiler de material y venta de derechos."
    ]
  },
