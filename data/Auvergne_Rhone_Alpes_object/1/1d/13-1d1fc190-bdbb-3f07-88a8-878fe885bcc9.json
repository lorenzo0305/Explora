  "rdfs:comment": {
    "de": [
      "Die Gemeinde Saint-Martin-du-Fresne ist mit zwei Picknickplätzen ausgestattet. Diese befinden sich auf der Höhe der Rue du Stade und des Place du Vivier."
    ],
    "en": [
      "Saint-Martin-du-Fresne has two picnic areas. The first is at rue du Stade and Place du Vivier."
    ],
    "it": [
      "Saint-Martin-du-Fresne dispone di due aree picnic. Questa si trova in rue du Stade e in place du Vivier."
    ],
    "fr": [
      "La commune de Saint-Martin-du-Fresne est équipée de deux aires de pique-nique. Celle-ci se trouve au niveau de la rue du Stade et de la place du Vivier."
    ],
    "nl": [
      "Saint-Martin-du-Fresne heeft twee picknickplaatsen. De eerste ligt in de Rue du Stade en de tweede op de Place du Vivier."
    ],
    "es": [
      "Saint-Martin-du-Fresne cuenta con dos merenderos. El primero está en la Rue du Stade y el segundo en la Place du Vivier."
