  "rdfs:comment": {
    "de": [
      "Dorf Saint-Austremoine: Alte Kirche mit zeitgenössischen Ikonen, die von Véronique Raulin (Freskenmalerin) gestaltet wurden. Blick über das Cronce-Tal vom Dorf Le Mirial aus."
    ],
    "en": [
      "Village of Saint-Austremoine: ancient church with contemporary icons by Véronique Raulin (fresco artist). View over the Cronce valley from the village of Le Mirial."
    ],
    "it": [
      "Villaggio di Saint-Austremoine: antica chiesa con icone contemporanee create da Véronique Raulin (artista dell'affresco). Vista sulla valle di Cronce dal villaggio di Le Mirial."
    ],
    "fr": [
      "Village de Saint-Austremoine : Église ancienne avec icônes contemporaines réalisées par Véronique Raulin (fresquiste). Vue surplombant la vallée de la Cronce, depuis le village du Mirial."
    ],
    "es": [
      "Pueblo de Saint-Austremoine: antigua iglesia con iconos contemporáneos creados por Véronique Raulin (artista de frescos). Vista del valle de Cronce desde el pueblo de Le Mirial."
    ],
    "nl": [
      "Dorp Saint-Austremoine: oude kerk met hedendaagse iconen gemaakt door Véronique Raulin (fresco kunstenaar). Uitzicht over de vallei van de Cronce vanuit het dorp Le Mirial."
    ]
  },
  "rdfs:label": {
