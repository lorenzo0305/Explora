  "rdfs:comment": {
    "de": [
      "La Palette \" des 2 Boules \" ist eine Wein- und Bierbar, die Verkostungen von regionalen Produkten anbietet. Die Bar verfügt außerdem über eine Sitzecke in typisch savoyischem Ambiente."
    ],
    "en": [
      "La Palette \"des 2 Boules\" is a wine bar that offers tastings of regional products. The bar also has a lounge area, in a typical Savoyard atmosphere."
    ],
    "it": [
      "La Palette \"des 2 Boules\" è un wine e beer bar che offre degustazioni di prodotti regionali. Il bar dispone anche di un'area lounge, in un'atmosfera tipicamente savoiarda."
    ],
    "fr": [
      "La Palette « des 2 Boules » est un bar à vins  et bar à bières qui propose des dégustations de produits régionaux. Le bar dispose également d’un coin salon, dans une ambiance typiquement savoyarde."
    ],
    "nl": [
      "La Palette \"des 2 Boules\" is een wijn- en bierbar met proeverijen van regionale producten. De bar heeft ook een loungegedeelte, in een typisch Savoyaardse sfeer."
    ],
    "es": [
      "La Palette \"des 2 Boules\" es un bar de vinos y cervezas que ofrece degustaciones de productos regionales. El bar también cuenta con una zona de salón, en un ambiente típicamente saboyano."
    ]
  },
