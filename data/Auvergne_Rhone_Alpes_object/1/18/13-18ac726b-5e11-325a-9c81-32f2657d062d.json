  "rdfs:comment": {
    "de": [
      "Betreuung von privaten Sitzungen auf Stunden-, Halbtags- oder Ganztagsbasis.  Ein innovativer pädagogischer Ansatz, Videokorrekturen, Seriosität und hohe Professionalität machen unseren Unterschied aus."
    ],
    "en": [
      "Synergie Ski Academy is specialised in private ski lessons which are offered by the hour, half-day or full day.\r\nOur innovative approach to teaching, video corrections, reliability and great professionalism set us apart."
    ],
    "it": [
      "Supervisione di sessioni private a ore, mezza giornata o giornata intera.  Un approccio didattico innovativo, correzioni video, serietà e grande professionalità fanno la nostra differenza."
    ],
    "fr": [
      "Encadrement de séances privées à l'heure, à la demi-journée ou journée complète.  Une approche pédagogique novatrice, les corrections vidéo, le sérieux et le grand professionnalisme font notre différence."
    ],
    "es": [
      "Supervisión de sesiones privadas por horas, media jornada o jornada completa.  Un enfoque pedagógico innovador, correcciones en vídeo, seriedad y gran profesionalidad marcan nuestra diferencia."
    ],
    "nl": [
      "Begeleiding van privésessies per uur, halve dag of hele dag.  Onze innovatieve lesaanpak, videocorrecties, ernst en professionaliteit onderscheiden ons."
    ]
  },
