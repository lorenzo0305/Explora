  "rdfs:comment": {
    "de": [
      "Chalet mit Charme im Herzen des Dorfes mit Spa und Kaminecke. Zimmer mit Balkon oder Terrasse mit beeindruckender Sicht auf der Kette der Aravis. Empfang durch Bergführer. Abwechslungsreiche Küche."
    ],
    "en": [
      "Charming comfortable chalet in the heart of the village with spa and fireplace. Our cosy rooms with balcony or terrace offering a wonderful views of the Aravis mountains. Home by moutain professionals. Varied cuisine."
    ],
    "it": [
      "Chalet di charme nel cuore del villaggio con spa e camino. Camere accoglienti con balcone o terrazza con vista mozzafiato sulla catena montuosa degli Aravis. Accoglienza da parte di professionisti della montagna. Cucina varia."
    ],
    "fr": [
      "Chalet de charme au coeur du village avec spa et coin cheminée. Chambres douillettes avec balcon ou terrasse avec vue admirable et imprenable sur la chaîne des Aravis. Accueil par des professionnels de la montagne. Cuisine variée."
    ],
    "nl": [
      "Charmant chalet in het hart van het dorp met spa en open haard. Gezellige kamers met balkon of terras met een adembenemend uitzicht op het Aravis-gebergte. Welkom door professionals uit de bergen. Gevarieerde keuken."
    ],
    "es": [
      "Chalet con encanto al corazón del pueblo con spa y chimenea. Habitaciones mullidas con balcón o terraza con vista admirable y inexpugnable en la cadena de Aravis. Acogida para profesionales de la montaña. Cocina variada (etiqueta 2 ollas)"
    ]
  },
  "rdfs:label": {
