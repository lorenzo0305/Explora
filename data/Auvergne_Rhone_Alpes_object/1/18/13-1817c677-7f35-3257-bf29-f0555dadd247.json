  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt befindet sich im Herzen des Ortes in LaTania und steht Ihnen für alle Informationen über den Ort, Unterkünfte, Shopping, Restaurants, Skigebiet, Schneeverhältnisse, Wetter, Aktivitäten, Veranstaltungen, Animationen ... zur Verfügung."
    ],
    "en": [
      "Located in the heart of the resort at laTania, the Tourist Office is at your disposal for all information on the resort, accommodation, shopping, restaurants, the ski area, snow conditions, weather, activities, events, entertainment..."
    ],
    "it": [
      "Situato nel cuore della località, a LaTania, l'Ufficio del Turismo è a vostra disposizione per tutte le informazioni sulla località, gli alloggi, lo shopping, i ristoranti, il comprensorio sciistico, le condizioni della neve, il meteo, le attività, gli eventi, l'intrattenimento, ecc."
    ],
    "fr": [
      "Situé au cœur de la station à laTania, l'Office de Tourisme est à votre disposition pour toute information sur la station, hébergement, shopping, restauration, domaine skiable, enneigement, météo, activités, évènements, animations ..."
    ],
    "es": [
      "Situada en el corazón de la estación, en laTania, la Oficina de Turismo está a su disposición para cualquier información sobre la estación, alojamiento, compras, restaurantes, dominio esquiable, estado de la nieve, meteorología, actividades, eventos, animaciones, etc."
    ],
    "nl": [
      "Het VVV-kantoor ligt in het hart van het resort in laTania en staat tot je beschikking voor alle informatie over het resort, accommodatie, winkelen, restaurants, het skigebied, sneeuwcondities, weer, activiteiten, evenementen, entertainment, enz."
    ]
  },
