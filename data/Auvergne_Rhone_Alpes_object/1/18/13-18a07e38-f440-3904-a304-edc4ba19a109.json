  "rdfs:comment": {
    "de": [
      "Das Schloss empfängt Sie zu Besichtigungen, die Sie durch seine Geschichte vom 11. Jahrhundert bis heute führen. Neue Räume zu entdecken. Fotoausstellung der Arbeiten."
    ],
    "en": [
      "Montmorin Castle welcomes you for tours that will take you from its 11 th century origins to the present day. The collections of the Henri Delaire Museum will allow you to explore the life in a me- dieval castle."
    ],
    "it": [
      "Lo Château vi accoglie per visite guidate che vi condurranno in un viaggio attraverso la sua storia dall'XI secolo ai giorni nostri. Nuove sale da scoprire. Mostra fotografica delle opere."
    ],
    "fr": [
      "Le château vous accueille pour des visites qui vous feront voyager à travers son histoire du XI e siècle à nos jours. Nouvelles salles à découvrir. Expo photos des travaux."
    ],
    "nl": [
      "Het kasteel verwelkomt je voor rondleidingen die je meenemen op een reis door de geschiedenis van de 11e eeuw tot nu. Nieuwe zalen om te ontdekken. Fototentoonstelling van de werken."
    ],
    "es": [
      "El Château le da la bienvenida en visitas guiadas que le llevarán a recorrer su historia desde el siglo XI hasta nuestros días. Nuevas salas por descubrir. Exposición fotográfica de las obras."
    ]
  },
