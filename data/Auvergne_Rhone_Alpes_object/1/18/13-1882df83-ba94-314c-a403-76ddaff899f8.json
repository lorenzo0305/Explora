  "rdfs:comment": {
    "de": [
      "Erleben Sie einen unvergesslichen Abend mit Locura, Barockmusik und Hip-Hop. Das Konzert des Hostel Dieu und Mourad Merzouki in Zusammenarbeit mit dem Centre Musical International. Im Rahmen des internationalen Johann-Sebastian-Bach-Festivals."
    ],
    "en": [
      "Enjoy an unforgettable evening with Locura, baroque music and hip-hop. The concert by Hostel Dieu and Mourad Merzouki in partnership with the Centre Musical International. As part of the International Johann Sebastian Bach Festival."
    ],
    "it": [
      "Venite a godervi una serata indimenticabile con Locura, musica barocca e hip-hop. Concerto dell'Hostel Dieu e di Mourad Merzouki in collaborazione con il Centre Musical International. Nell'ambito del Festival Internazionale Johann Sebastian Bach."
    ],
    "fr": [
      "Venez passer une soirée inoubliable avec Locura, musique baroque et hip-hop. Le concert de l'Hostel Dieu et Mourad Merzouki en partenariat avec le Centre Musical International. Dans le cadre du festival international de Jean-Sébastien Bach."
    ],
    "es": [
      "Venga a disfrutar de una velada inolvidable con Locura, música barroca y hip-hop. Concierto del Hostel Dieu y Mourad Merzouki en colaboración con el Centre Musical International. En el marco del Festival Internacional Johann Sebastian Bach."
    ],
    "nl": [
      "Kom genieten van een onvergetelijke avond met Locura, barokmuziek en hiphop. Concert van Hostel Dieu en Mourad Merzouki in samenwerking met Centre Musical International. In het kader van het Internationale Johann Sebastian Bach Festival."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival  J-S Bach concert : Locura"
    ]
  },
