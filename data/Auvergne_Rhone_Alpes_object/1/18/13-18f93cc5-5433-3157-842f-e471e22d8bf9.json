  "rdfs:comment": {
    "de": [
      "Produzent von schwarzen Johannisbeeren und Johannisbeeren. Entdecken Sie die verfügbaren natürlichen und handwerklichen Produkte: Konfitüren, Sirupe, Nektar aus schwarzen und roten Johannisbeeren, Pfeffer aus schwarzen Johannisbeerknospen, getrocknete schwarze Johannisbeerknospen, getrocknete schwarze Johannisbeerblätter für Kräutertee."
    ],
    "en": [
      "Blackcurrant and redcurrant producer. Discover the natural and artisanal products available: jams, syrups, blackcurrant and redcurrant nectars, blackcurrant bud pepper, dried blackcurrant buds, dried blackcurrant leaves for infusion."
    ],
    "it": [
      "Produttore di ribes nero e ribes rosso. Scoprite i prodotti naturali e artigianali disponibili: marmellate di ribes nero e ribes rosso, sciroppi, nettari, pepe di gemma di ribes nero, gemme di ribes nero essiccate, foglie di ribes nero essiccate per infusione."
    ],
    "fr": [
      "Producteur de cassis, de groseilles. Découvrez les produits naturels et artisanaux disponibles : confitures, sirops, nectars de cassis et de groseille, poivre de bourgeons de cassis, bourgeons de cassis séchés, feuilles de cassis séchées pour infusion."
    ],
    "es": [
      "Productor de grosellas negras y rojas. Descubra los productos naturales y artesanales disponibles: mermeladas de grosella negra y grosella roja, jarabes, néctares, pimienta de brotes de grosella negra, brotes secos de grosella negra, hojas secas de grosella negra para infusión."
    ],
    "nl": [
      "Producent van zwarte en rode bessen. Ontdek de natuurlijke en ambachtelijke producten die verkrijgbaar zijn: jam van zwarte en rode bessen, siroop, nectar, peper van zwarte bessenknoppen, gedroogde zwarte bessenknoppen, gedroogde zwarte bessenbladeren voor infusie."
    ]
  },
