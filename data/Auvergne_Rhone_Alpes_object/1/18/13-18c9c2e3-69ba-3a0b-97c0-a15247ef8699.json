  "rdfs:comment": {
    "de": [
      "Caroline Snyers befasst sich mit der Konservierung und Restaurierung von Staffeleigemälden, Wandgemälden und marouflagierten Leinwänden; Studien zu Wandgemälden und Sammlungen von Staffeleigemälden und Unterstützung bei der Bauherrenschaft für öffentliche Auftraggeber."
    ],
    "en": [
      "Caroline Snyers conserves and restores easel paintings, wall paintings and mounted canvasses. Wall painting analysis, painting collections and support to public procurers."
    ],
    "it": [
      "Caroline Snyers è responsabile della conservazione e del restauro di dipinti da cavalletto e murali, di tele marocchinate, di studi su dipinti murali e collezioni di dipinti da cavalletto e dell'assistenza agli acquirenti pubblici."
    ],
    "fr": [
      "Caroline Snyers exerce la conservation restauration des peintures de chevalet et murales, des toiles marouflées ; études en peintures murales et collection de peintures de chevalet et assistance à la maîtrise d’ouvrage auprès d’acheteurs publics."
    ],
    "es": [
      "Caroline Snyers se encarga de la conservación y restauración de pinturas de caballete y murales, de los lienzos marouflageados, de los estudios de pinturas murales y de las colecciones de pinturas de caballete, así como de la asistencia a los compradores públicos."
    ],
    "nl": [
      "Caroline Snyers is verantwoordelijk voor de conservatie en restauratie van schildersezels en muurschilderingen, gemaroufleerde doeken, studies van muurschilderingen en collecties van schildersezels, en projectmanagement bijstand aan openbare kopers."
    ]
  },
  "rdfs:label": {
    "en": [
      "Caroline Snyers' painting conservation & restoration workshop"
    ],
    "fr": [
      "Atelier de conservation-restauration de peintures Caroline Snyers"
    ]
  },
