  "rdfs:comment": {
    "de": [
      "Gisèle und Christophe Grangeon sind Ihre Gastgeber für die Dauer eines Gourmetaufenthalts.\r\nDie Küchenchefin bietet Ihnen eine fantasievolle und raffinierte Küche. Ein Fest für die Augen und den Gaumen."
    ],
    "en": [
      "Gisèle and Christophe Grangeon are your hosts for a gourmet stopover.\r\nThe chef offers an imaginative and refined cuisine. A feast for the eyes and the taste buds."
    ],
    "it": [
      "Gisèle e Christophe Grangeon vi ospitano per una pausa gourmet.\r\nLo chef propone una cucina fantasiosa e raffinata. Una delizia per gli occhi e per le papille gustative."
    ],
    "fr": [
      "Gisèle et Christophe Grangeon sont vos hôtes le temps d’une escale gourmande.\r\nLa chef vous propose une cuisine imaginative et raffinée. Un régal pour les yeux et les papilles."
    ],
    "es": [
      "Gisèle y Christophe Grangeon son sus anfitriones para una escapada gastronómica.\r\nEl chef ofrece una cocina imaginativa y refinada. Un placer para la vista y el paladar."
    ],
    "nl": [
      "Gisèle en Christophe Grangeon zijn uw gastheren voor een gastronomisch verblijf.\r\nDe chef biedt een fantasierijke en verfijnde keuken. Een traktatie voor de ogen en de smaakpapillen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Air du Temps"
    ]
  },
