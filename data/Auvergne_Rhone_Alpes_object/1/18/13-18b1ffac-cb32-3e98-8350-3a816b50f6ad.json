  "rdfs:comment": {
    "de": [
      "Davez? Pizza bietet Ihnen eine große Auswahl an Pizzen, die Sie auf der Terrasse genießen oder mitnehmen können. Unsere handwerklich hergestellten Pizzen und Paninis werden mit frischem Gemüse auf einer hausgemachten Tomatensoße zubereitet."
    ],
    "en": [
      "Davez' Pizza offers a wide range of pizzas to eat in or take away. Our home-made pizzas and paninis are prepared with fresh vegetables and a homemade tomato sauce."
    ],
    "it": [
      "Davez? Pizza vi offre una vasta gamma di pizze da gustare in terrazza o da asporto. Le pizze e i panini fatti in casa sono preparati con verdure fresche e salsa di pomodoro fatta in casa."
    ],
    "fr": [
      "Davez’ Pizza vous propose une large gamme de pizzas à déguster en terrasse ou à emporter. Fabriqués artisanalement, nos pizzas et nos paninis sont préparés avec des légumes frais sur une sauce tomate maison."
    ],
    "es": [
      "Davez? Pizza le ofrece una amplia gama de pizzas para disfrutar en la terraza o para llevar. Nuestras pizzas y paninis caseros se preparan con verduras frescas y una salsa de tomate casera."
    ],
    "nl": [
      "Davez? Pizza biedt een breed scala aan pizza's om van te genieten op het terras of om mee te nemen. Onze huisgemaakte pizza's en panini's worden bereid met verse groenten en een huisgemaakte tomatensaus."
    ]
  },
