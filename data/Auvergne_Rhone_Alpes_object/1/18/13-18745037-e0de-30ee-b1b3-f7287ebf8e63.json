  "rdfs:comment": {
    "de": [
      "Familienbetrieb mit Selbstversorgung, der eine nachhaltige Landwirtschaft betreibt.\r\nEntdecken Sie das Melken unserer Ziegen von Hand und die Herstellung unseres Käses."
    ],
    "en": [
      "Family farm practicing a reasoned agriculture.\r\nCome to discover our goats, our chickens, our rabbits, our horses, our ponies, and our donkey as well as our cheese production. Open all year."
    ],
    "it": [
      "Azienda agricola familiare autosufficiente che pratica un'agricoltura sostenibile.\r\nVenite a vedere come vengono munte a mano le nostre capre e come vengono prodotti i nostri formaggi."
    ],
    "fr": [
      "Exploitation familiale en autonomie pratiquant une agriculture raisonnée.\r\nVenez  découvrir la traite à la main de nos chèvres, la fabrication de nos fromages."
    ],
    "es": [
      "Granja familiar autosuficiente que practica una agricultura sostenible.\r\nVenga a ver cómo se ordeñan a mano nuestras cabras y cómo se elaboran nuestros quesos."
    ],
    "nl": [
      "Familiebedrijf in autonomie dat een beredeneerde landbouw beoefent.\r\nKom en ontdek het met de hand melken van onze geiten, kippen, konijnen, pony's en andere dieren op de boerderij, evenals onze kaasproductie."
    ]
  },
