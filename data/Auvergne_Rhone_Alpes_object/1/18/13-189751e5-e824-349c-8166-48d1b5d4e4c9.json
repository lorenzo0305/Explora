  "rdfs:comment": {
    "de": [
      "Willkommen im L'Hôtel-Bar-Restaurant Les Dômes de Miage, einem symbolträchtigen Ort in Saint-Gervais, der seit 1966 eine außergewöhnliche Gastfreundschaft bietet."
    ],
    "en": [
      "A beautifully simple, authentic wooden chalet. Easy acces to a corner of paradise opposite the famous \"Domes de Miage\"...."
    ],
    "it": [
      "Fronte ai maestosi Dômes de Miage, sulla strada che va alle Contamines, Sylvie e Michel vi accogliono tutto l'anno per un soggiorno di rilasso, une scappatella sportiva o una tappa professionale."
    ],
    "fr": [
      "Bienvenue à L'Hôtel-Bar-Restaurant Les Dômes de Miage, lieu emblématique de Saint-Gervais, offrant une hospitalité exceptionnelle depuis 1966."
    ],
    "nl": [
      "Welkom bij Hôtel-Bar-Restaurant Les Dômes de Miage, een bezienswaardigheid in Saint-Gervais die al sinds 1966 een uitzonderlijke gastvrijheid biedt."
    ],
    "es": [
      "Bienvenido al Hôtel-Bar-Restaurant Les Dômes de Miage, un lugar emblemático de Saint-Gervais que ofrece una hospitalidad excepcional desde 1966."
    ]
