  "rdfs:comment": {
    "de": [
      "15:00 bis 18:30 Uhr: Teilen Sie einen Moment der Feinschmeckerei mit einem Eltern-Kind-Duo! Entdecken Sie unter Anleitung des Küchenchefs die Geheimnisse der Schokolade während eines geselligen und kreativen Nachmittags. 70? für das Duo (1 Kind und 1 Erwachsener). Reservierung unter 04 71 66 86 66."
    ],
    "en": [
      "from 3 pm to 6:30 pm, share a gourmet moment with a parent-child duo! Under the chef?s guidance, discover the secrets of chocolate during a convivial and creative afternoon. 70? for the duo (1 child and 1 adult). Book on 04 71 66 86 66."
    ],
    "it": [
      "dalle 15.00 alle 18.30, condividete un momento goloso con un genitore e un bambino! Sotto la guida dello chef, scoprite i segreti del cioccolato durante un pomeriggio conviviale e creativo. 70? per il duo (1 bambino e 1 adulto). Prenotare al numero 04 71 66 86 66."
    ],
    "fr": [
      "15h à 18h30,  partagez un moment gourmand et complice en duo parent-enfant ! Sous les conseils du chef, découvrez les secrets du chocolat lors d’un après-midi convivial et créatif. 70€ pour le duo (1 enfant et 1 adulte). Réservation au 04 71 66 86 66."
    ],
    "nl": [
      "deel van 15u tot 18u30 een heerlijk moment met ouder en kind! Ontdek onder begeleiding van de chef-kok de geheimen van chocolade tijdens een gezellige en creatieve namiddag. 70? voor het duo (1 kind en 1 volwassene). Reserveer op 04 71 66 86 66."
    ],
    "es": [
      "de 15:00 a 18:30, ¡comparta un momento delicioso con un padre y su hijo! Con los consejos del chef, descubra los secretos del chocolate durante una tarde de convivencia y creatividad. 70? para el dúo (1 niño y 1 adulto). Reserve en el 04 71 66 86 66."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de cuisine en duo: fou de chocolat"
    ]
  },
