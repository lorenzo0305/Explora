  "rdfs:comment": {
    "de": [
      "Das Kino der Portes du Soleil zeigt Ihnen mehrere Filme pro Tag, einige davon als Vorpremiere. pro Tag werden 2 bis 3 Vorstellungen angeboten. Das Kino öffnet auch an Samstagen in den Schulferien. Sie haben die Möglichkeit, Filme in 3D zu sehen."
    ],
    "en": [
      "The Portes du Soleil cinema offers several films a day, some of which are previews. There are 2 to 3 screenings per day. The cinema also opens on Saturdays during school holidays. You have the possibility to see films in 3D."
    ],
    "it": [
      "Il cinema Portes du Soleil propone diversi film al giorno, alcuni dei quali in anteprima. sono previste da 2 a 3 proiezioni al giorno. Il cinema apre anche il sabato durante le vacanze scolastiche. Avete la possibilità di vedere film in 3D."
    ],
    "fr": [
      "Le cinéma des Portes du Soleil vous propose plusieurs films par jour dont certains en avant première. 2 à  3 séances sont proposées par jour. Le cinéma ouvre également les samedis des vacances scolaires. Vous avez la possibilité de voir des films en 3D."
    ],
    "es": [
      "El cine Portes du Soleil ofrece varias películas al día, algunas de ellas en preestreno. hay de 2 a 3 proyecciones por día. El cine también abre los sábados durante las vacaciones escolares. Tiene la posibilidad de ver películas en 3D."
    ],
    "nl": [
      "De bioscoop van Portes du Soleil biedt meerdere films per dag, waarvan sommige voorpremières zijn. Er zijn 2 tot 3 vertoningen per dag. Tijdens de schoolvakanties is de bioscoop ook op zaterdag open. U hebt de mogelijkheid om films in 3D te zien."
    ]
  },
  "rdfs:label": {
