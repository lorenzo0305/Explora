  "rdfs:comment": {
    "de": [
      "Teestube: Frühstück, Nachmittagssnacks.\nRestaurant : Hausgemachte Küche aus frischen, hauptsächlich biologischen und lokalen Produkten: Buchweizenpfannkuchen, herzhafte Kuchen, Crêpes, Eis...\nVor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Tearoom: breakfast, snacks.\nRestaurant: Home cooking using fresh, mainly organic and local produce: buckwheat pancakes, savoury tarts, crêpes, ice creams...\nOn site or to take away."
    ],
    "it": [
      "Sala da tè: colazione, spuntini.\r\nRistorante: Cucina casalinga con prodotti freschi, prevalentemente biologici e locali: frittelle di grano saraceno, torte salate, crêpes, gelati, ecc.\r\nIn loco o da asporto."
    ],
    "fr": [
      "Salon de thé : petit déjeuner, goûter. \r\nRestaurant : Cuisine maison à partir de produits frais, essentiellement bio et locaux : galettes sarrasin, tartes salées, crêpes, glaces...\r\nSur place ou à emporter."
    ],
    "nl": [
      "Tearoom: ontbijt, snacks.\nRestaurant: Thuisbereiding met verse, voornamelijk biologische en lokale producten: boekweitpannenkoeken, hartige taarten, crêpes, ijsjes, enz.\nTer plaatse of om mee te nemen."
    ],
    "es": [
      "Salón de té: desayuno, aperitivos.\r\nRestaurante: Cocina casera elaborada con productos frescos, principalmente ecológicos y locales: tortitas de trigo sarraceno, tartas saladas, crepes, helados, etc.\r\nEn el establecimiento o para llevar."
    ]
  },
