  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einem kulturellen After-Work-Event teil und lernen Sie die großen Persönlichkeiten kennen, die Creil geprägt haben: Tauchen Sie im April in die Welt von Émile Gallé ein, einem Industriellen, Glaskünstler, Möbeltischler und Keramiker, Vertreter des Jugendstils und Cousin der Bewohner des Gallé-Juillet-Hauses!"
    ],
    "en": [
      "Join us for a cultural after-work to meet the great figures who left their mark on Creil: in April, immerse yourself in the world of Émile Gallé, industrialist, glassmaker, cabinetmaker and ceramist, representative of Art Nouveau and cousin of the inhabitants of the Maison Gallé-Juillet!"
    ],
    "it": [
      "Partecipate a un dopolavoro culturale per incontrare i grandi personaggi che hanno segnato Creil: ad aprile, immergetevi nel mondo di Émile Gallé, industriale, vetraio, ebanista e ceramista, rappresentante dell'Art Nouveau e cugino degli abitanti della Maison Gallé-Juillet!"
    ],
    "fr": [
      "Participez à un after-work culturel pour rencontrer les grandes figures qui ont marqué Creil : en avril, plongez dans l'univers d'Émile Gallé, industriel, verrier, ébéniste et céramiste, représentant de l'Art Nouveau et cousin des habitants de la maison Gallé-Juillet !"
    ],
    "es": [
      "Participe en un afterwork cultural para conocer a las grandes figuras que dejaron su huella en Creil: en abril, ¡sumérjase en el universo de Émile Gallé, industrial, vidriero, ebanista y ceramista, representante del Art Nouveau y primo de los habitantes de la Maison Gallé-Juillet!"
    ],
    "nl": [
      "Neem deel aan een cultureel na-werk om de grote figuren te ontmoeten die hun stempel hebben gedrukt op Creil: dompel je in april onder in de wereld van Émile Gallé, industrieel, glasblazer, meubelmaker en keramist, vertegenwoordiger van de Art Nouveau en neef van de bewoners van het Maison Gallé-Juillet!"
    ]
  },
