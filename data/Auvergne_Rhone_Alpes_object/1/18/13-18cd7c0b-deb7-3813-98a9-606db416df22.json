  "rdfs:comment": {
    "de": [
      "Das Monchu ist ein einzigartiges Restaurant, das die Geschmacksknospen seiner Gäste mit hochwertiger Küche und einer gemütlichen Atmosphäre verwöhnt."
    ],
    "en": [
      "Le Monchu is a unique restaurant that delights its customers' taste buds with quality cuisine and a friendly atmosphere."
    ],
    "it": [
      "Le Monchu è un ristorante unico che delizia il palato dei suoi clienti con una cucina di qualità e un'atmosfera accogliente."
    ],
    "fr": [
      "Le Monchu est un restaurant unique qui ravit les papilles de ses clients grâce à une cuisine de qualité et une ambiance conviviale."
    ],
    "nl": [
      "Le Monchu is een uniek restaurant dat de smaakpapillen van zijn klanten verwent met een kwaliteitskeuken en een vriendelijke sfeer."
    ],
    "es": [
      "Le Monchu es un restaurante único que deleita el paladar de sus clientes con una cocina de calidad y un ambiente acogedor."
    ]
  },
