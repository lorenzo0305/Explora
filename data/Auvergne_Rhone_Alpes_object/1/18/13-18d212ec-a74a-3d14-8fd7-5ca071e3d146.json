  "rdfs:comment": {
    "de": [
      "Vichy ist die Heimat von Sportlern.\r\nDank ihrer Erfahrung bietet sie ein echtes Know-how bei der Aufnahme von Vorbereitungslehrgängen, Wettkämpfen und Sportveranstaltungen."
    ],
    "en": [
      "Vichy, a land of welcome for athletes.\r\nWith its wealth of experience, it offers real expertise in hosting training courses, competitions and sporting events."
    ],
    "it": [
      "Vichy, la casa dello sport.\r\nCon la sua grande esperienza, offre una reale competenza nell'ospitare corsi di formazione, gare ed eventi sportivi."
    ],
    "fr": [
      "Vichy, terre d'accueil des sportifs. \r\nForte de son expérience, elle offre un vrai savoir-faire dans l'accueil de stages de préparation, de compétitions et d'événements sportifs."
    ],
    "es": [
      "Vichy, la cuna del deporte.\r\nGracias a su dilatada experiencia, ofrece una auténtica pericia en la organización de cursos de formación, competiciones y eventos deportivos."
    ],
    "nl": [
      "Vichy, de thuisbasis van sport.\r\nMet zijn rijke ervaring biedt het echte expertise in het organiseren van trainingen, wedstrijden en sportevenementen."
    ]
  },
