  "rdfs:comment": {
    "de": [
      "Die Kirche steht unter dem Patronat des Heiligen Mauritius von Agaune, Hauptmann der Thebäischen Legion, der in Octodure im Wallis den Märtyrertod erlitt."
    ],
    "en": [
      "The church is under the patronage of Saint Maurice d'Agaune, captain of the Theban Legion, martyred at Octodure in Valais."
    ],
    "it": [
      "La chiesa è sotto il patronato di San Maurizio d'Agaune, capitano della Legione Tebea, martirizzato a Octodure nel Vallese."
    ],
    "fr": [
      "L'église est placée sous le patronage du Saint Maurice d'Agaune, capitaine de la Légion Thébéenne, martyrisé à Octodure en Valais."
    ],
    "es": [
      "La iglesia se encuentra bajo la advocación de San Mauricio de Agaune, capitán de la Legión Tebana, martirizado en Octodure, en el Valais."
    ],
    "nl": [
      "De kerk staat onder beschermheerschap van Saint Maurice d'Agaune, kapitein van het Thebaanse Legioen, gemarteld in Octodure in Wallis."
    ]
  },
