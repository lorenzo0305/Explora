  "rdfs:comment": {
    "de": [
      "Ste-Colombe-sur-Gand liegt am Rand des Gand- und des Bernand-Tals, zwei Bäche, die in der Nähe entspringen. Das steile Dorf überragt seine Kirche und ein Schloss aus dem 13. Jahrhundert. Name der Einwohner: Les Colombois."
    ],
    "en": [
      "Ste-Colombe-sur-Gand clings to the edge of the Gand and Bernand valleys, two streams that rise nearby. The steep village overlooks the church below and a 13th-century château. Inhabitants: Colombois."
    ],
    "it": [
      "Ste-Colombe-sur-Gand si aggrappa al bordo delle valli di Gand e Bernand, due torrenti che nascono nelle vicinanze. Il ripido villaggio domina la chiesa sottostante e un castello del XIII secolo. I suoi abitanti si chiamano Colombois."
    ],
    "fr": [
      "Ste-Colombe-sur-Gand est accroché au bord de la vallée du Gand et celle du Bernand, deux ruisseaux qui prennent leur source non loin. Le bourg escarpé domine son église en contrebas ainsi qu'un château du XIIIème siècle. Nom des habitants : les Colombois."
    ],
    "es": [
      "Ste-Colombe-sur-Gand se aferra al borde de los valles de Gand y Bernand, dos arroyos que nacen en las proximidades. El empinado pueblo domina la iglesia y un castillo del siglo XIII. Sus habitantes se llaman colombois."
    ],
    "nl": [
      "Ste-Colombe-sur-Gand klampt zich vast aan de rand van de Gand- en Bernandvallei, twee beken die vlakbij ontspringen. Het steile dorp kijkt uit over de kerk en een 13e-eeuws kasteel. De inwoners worden Colombois genoemd."
    ]
  },
