  "rdfs:comment": {
    "de": [
      "Das Restaurant esf ist bis zum 1. Januar 2026 geschlossen.\r\nWiedereröffnung am 2. Januar.\r\n\r\nLa Chèvre Privadoise bietet Ihnen seine bretonischen Spezialitäten, Galettes, Crêpes, Far und sein Tagesgericht, das täglich mit frischen Produkten zubereitet wird."
    ],
    "en": [
      "La Chèvre Privadoise serves up Breton speciality dishes, such as savoury and sweet pancakes, Breton far (custard-based dessert) and a dish of the day made with fresh produce every day."
    ],
    "it": [
      "Il ristorante è chiuso fino al 1° gennaio 2026.\r\nRiapertura il 2 gennaio.\r\n\r\nLa Chèvre Privadoise propone specialità bretoni, galettes, crêpes, far e una specialità del giorno a base di prodotti freschi."
    ],
    "fr": [
      "Le restaurant esf fermé jusqu'au 1er janvier 2026.\r\nRéouverture le 2 janvier.\r\n\r\nLa Chèvre Privadoise vous propose ses spécialités bretonnes, galettes, crêpes, far et son plat du jour réalisé avec des produits frais chaque jour."
    ],
    "nl": [
      "Het restaurant is gesloten tot 1 januari 2026.\r\nHeropening op 2 januari.\r\n\r\nLa Chèvre Privadoise biedt u zijn Bretonse specialiteiten, galettes, crêpes, far en zijn dagschotel die elke dag met verse producten wordt bereid."
    ],
    "es": [
      "El restaurante permanecerá cerrado hasta el 1 de enero de 2026.\r\nReapertura el 2 de enero.\r\n\r\nLa Chèvre Privadoise le ofrece sus especialidades bretonas, galettes, crêpes, far y su plato del día elaborado con productos frescos todos los días."
    ]
  },
