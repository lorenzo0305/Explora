  "rdfs:comment": {
    "de": [
      "Das Restaurant La Grange de Belle Eglise besitzt einen Michelin-Stern. Es liegt weniger als eine Autostunde von den Champs-Elysées und Amiens und weniger als 30 Minuten von den Flughäfen Roissy-Charles-de-Gaulle und Beauvais entfernt. La Grange de Belle Eglise empfängt Sie in einer gemütlichen Umgebung. Eine Veranda liegt einem echten Garten gegenüber."
    ],
    "en": [
      "The restaurant La Grange de Belle Eglise has been awarded a Michelin star. It is less than an hour's drive from the Champs-Elysées and Amiens, and less than 30 minutes from Roissy-Charles-de-Gaulle and Beauvais airports. La Grange de Belle Eglise offers a warm welcome. A veranda faces a real garden."
    ],
    "it": [
      "Il ristorante La Grange de Belle Eglise ha una stella Michelin. Si trova a meno di un'ora di auto dagli Champs-Elysées e da Amiens, e a meno di 30 minuti dagli aeroporti di Roissy-Charles-de-Gaulle e Beauvais. La Grange de Belle Eglise offre un'accoglienza calorosa. Una veranda si affaccia su un vero e proprio giardino."
    ],
    "fr": [
      "Le restaurant La Grange de Belle Eglise possède une étoile au guide Michelin. Il est situé à moins d'une heure de route des Champs-Elysées et d'Amiens, et moins de 30 minutes de l'aéroport Roissy-Charles-de-Gaulle et Beauvais. La Grange de Belle Eglise vous accueille dans un cadre chaleureux. Une véranda fait face à un véritable jardin."
    ],
    "nl": [
      "Het restaurant La Grange de Belle Eglise heeft een Michelinster. Het ligt op minder dan een uur rijden van de Champs-Elysées en Amiens, en op minder dan 30 minuten van de luchthavens Roissy-Charles-de-Gaulle en Beauvais. La Grange de Belle Eglise biedt een warm welkom. Een veranda kijkt uit op een echte tuin."
    ],
    "es": [
      "El restaurante La Grange de Belle Eglise tiene una estrella Michelin. Está a menos de una hora en coche de los Campos Elíseos y Amiens, y a menos de 30 minutos de los aeropuertos de Roissy-Charles-de-Gaulle y Beauvais. La Grange de Belle Eglise ofrece una cálida bienvenida. Una veranda da a un auténtico jardín."
    ]
  },
