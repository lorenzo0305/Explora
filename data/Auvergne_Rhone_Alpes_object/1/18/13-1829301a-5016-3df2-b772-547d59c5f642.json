  "rdfs:comment": {
    "de": [
      "Einfache und frische Küche, die französische und japanische Aromen miteinander verbindet und auch vegetarische Gerichte anbietet. An schönen Tagen können Sie die Terrasse am Ufer der Isère genießen."
    ],
    "en": [
      "Simple, fresh cuisine combining French and Japanese flavors, including vegetarian dishes. In fine weather, enjoy the terrace on the banks of the Isère."
    ],
    "it": [
      "Cucina semplice e fresca che combina sapori francesi e giapponesi, oltre a piatti vegetariani. Nella bella stagione, godetevi la terrazza sulle rive dell'Isère."
    ],
    "fr": [
      "Cuisine simple et fraîche mariant les saveurs françaises et japonaises et également des plats végétariens.. Aux beaux jours, profitez de la terrasse au bord de l'Isère."
    ],
    "nl": [
      "Eenvoudige, verse keuken met Franse en Japanse smaken, evenals vegetarische gerechten. Geniet bij mooi weer op het terras aan de oever van de Isère."
    ],
    "es": [
      "Cocina sencilla y fresca que combina sabores franceses y japoneses, así como platos vegetarianos. Cuando hace buen tiempo, disfrute de la terraza a orillas del Isère."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cantine du Pont"
    ]
  },
