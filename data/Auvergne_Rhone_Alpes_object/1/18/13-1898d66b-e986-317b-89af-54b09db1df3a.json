  "rdfs:comment": {
    "de": [
      "Shiatsu und Do-In sind gesundheitsbegleitende Praktiken. Sie aktivieren die Selbstheilungskräfte und stellen das Gleichgewicht zwischen Körper und Geist wieder her."
    ],
    "en": [
      "Shiatsu and Do-In are practices that support health. They activate the forces of self-healing and restore the balance between body and mind."
    ],
    "it": [
      "Lo Shiatsu e il Do-In sono pratiche che sostengono la salute. Attivano le forze di autoguarigione e ripristinano l'equilibrio tra corpo e mente."
    ],
    "fr": [
      "Le Shiatsu et le Do-In sont les pratiques d'accompagnement à la santé. Elles activent les forces de l'autoguérison et restaurent l'équilibre entre le corps et l’esprit."
    ],
    "nl": [
      "Shiatsu en Do-In zijn praktijken die de gezondheid ondersteunen. Ze activeren de krachten van zelfgenezing en herstellen het evenwicht tussen lichaam en geest."
    ],
    "es": [
      "El Shiatsu y el Do-In son prácticas que favorecen la salud. Activan las fuerzas de autocuración y restablecen el equilibrio entre cuerpo y mente."
    ]
  },
  "rdfs:label": {
