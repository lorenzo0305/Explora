  "rdfs:comment": {
    "de": [
      "Eine festliche und farbenfrohe Veranstaltung, bei der Händler, Handwerker, Designer und lokale Produzenten zusammenkommen, um einen Tag im Zeichen des Frühlings und der Geselligkeit zu verbringen."
    ],
    "en": [
      "A festive and colorful event that brings together local merchants, craftspeople, designers and producers for a day of springtime fun and conviviality."
    ],
    "it": [
      "Un evento festoso e colorato che riunisce commercianti, artigiani, designer e produttori locali per una giornata di divertimento e convivialità primaverile."
    ],
    "fr": [
      "Un événement festif et coloré qui réunit commerçants, artisans, créateurs et producteurs locaux pour une journée placée sous le signe du printemps et de la convivialité."
    ],
    "es": [
      "Un acontecimiento festivo y colorista que reúne a comerciantes, artesanos, diseñadores y productores locales en una jornada de diversión y convivencia primaverales."
    ],
    "nl": [
      "Een feestelijk en kleurrijk evenement dat lokale handelaars, ambachtslieden, ontwerpers en producenten samenbrengt voor een dag vol lentepret en gezelligheid."
    ]
  },
  "rdfs:label": {
