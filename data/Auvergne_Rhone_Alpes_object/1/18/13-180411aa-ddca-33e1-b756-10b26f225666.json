  "rdfs:comment": {
    "de": [
      "Der Verein le Colombier- la Blégnière hat sich die professionelle Begleitung von Menschen mit Behinderung im ländlichen Raum zum Ziel gesetzt. Etwa 40 Arbeiter arbeiten in den verschiedenen Aktivitäten der ESAT."
    ],
    "en": [
      "The Colombier - La Blégnière Association helps disabled people in rural environments to integrate the world of work. Approximately 40 workers are involved in the different activities of this assisted-employment organisation."
    ],
    "it": [
      "L'obiettivo dell'associazione La plume verte è quello di creare un ambiente sociale e professionale che favorisca l'inclusione delle persone con disabilità nelle aree rurali."
    ],
    "fr": [
      "L'Association La plume verte a pour but de mettre en œuvre un environnement social et professionnel favorisant l'inclusion des personnes en situation de handicap en milieu rural."
    ],
    "nl": [
      "Het doel van de vereniging La plume verte is het creëren van een sociale en professionele omgeving die de inclusie van mensen met een handicap op het platteland stimuleert."
    ],
    "es": [
      "El objetivo de la asociación La plume verte es crear un entorno social y profesional que favorezca la inclusión de las personas con discapacidad en las zonas rurales."
    ]
  },
