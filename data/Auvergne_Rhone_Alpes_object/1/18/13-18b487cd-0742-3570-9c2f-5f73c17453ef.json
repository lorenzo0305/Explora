  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise und erkunden Sie das Natur- und Wassererbe des Dorfes, die umliegende Natur mit besonderem Augenmerk auf die Fauna und Flora der Wasserwelten der Rhône."
    ],
    "en": [
      "Discover the village's natural and aquatic heritage and the surrounding countryside, with a special focus on the flora and fauna of the Rhône's aquatic environments."
    ],
    "it": [
      "Scoprite il patrimonio naturale e acquatico del villaggio e della campagna circostante, con particolare attenzione alla fauna e alla flora degli ambienti acquatici del Rodano."
    ],
    "fr": [
      "Partez à la découverte des espaces patrimoniaux naturels et aquatiques du village, de la nature environnante avec une sensibilisation particulière à la faune et la flore des milieux aquatiques du Rhône."
    ],
    "nl": [
      "Ontdek het natuurlijke en aquatische erfgoed van het dorp en het omliggende platteland, met speciale aandacht voor de flora en fauna van de aquatische milieus van de Rhône."
    ],
    "es": [
      "Descubra el patrimonio natural y acuático del pueblo y sus alrededores, con especial atención a la fauna y la flora de los medios acuáticos del Ródano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La rivière de la Lône"
    ]
  },
