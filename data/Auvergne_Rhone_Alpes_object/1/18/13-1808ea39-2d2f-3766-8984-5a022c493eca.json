  "rdfs:comment": {
    "de": [
      "Diese Bar-Restaurant-Imbissbude liegt in der Nähe des Schlosses und bietet Salate, Hamburger, Teller zum Mitnehmen, Pizza, Fleisch, lokale Produkte."
    ],
    "en": [
      "Situated near the acstle, this bar restaurant snack proposes takeaway salads, hamburgers, platefuls, pizzas, meat, local products."
    ],
    "it": [
      "Situato vicino al castello, questo bar-ristorante-snack bar offre insalate, hamburger, piatti da asporto, pizze, carni e prodotti locali."
    ],
    "fr": [
      "Situé à proximité du château, ce bar-restaurant-snack propose des salades, hamburgers, assiettes à emporter, pizzas, viandes, produits locaux."
    ],
    "es": [
      "Situado cerca del castillo, este bar-restaurante-snack bar ofrece ensaladas, hamburguesas, platos para llevar, pizzas, carnes y productos locales."
    ],
    "nl": [
      "Deze bar-restaurant-snackbar ligt vlakbij het kasteel en biedt salades, hamburgers, meeneemschotels, pizza's, vlees en streekproducten."
