  "rdfs:comment": {
    "de": [
      "Diese Route führt Sie über die bewaldeten Pfade am Südhang des Massivs La Bosse. Blick auf die Puys-Kette und das Tal der Sioule."
    ],
    "en": [
      "This route takes you along the wooded paths on the southern slopes of the La Bosse massif. Views of the Chaîne des Puys and the Sioule valley."
    ],
    "it": [
      "Questo itinerario vi conduce lungo i sentieri boscosi del versante meridionale del massiccio di La Bosse. Vista sulla catena del Puys e sulla valle della Sioule."
    ],
    "fr": [
      "Cet itinéraire  vous mène sur les sentiers boisés du versant sud du massif de La Bosse. Vue  sur la chaîne des Puys et la vallée de la Sioule."
    ],
    "es": [
      "Este itinerario le lleva por los senderos boscosos de la vertiente sur del macizo de La Bosse. Vista de la cadena de Puys y del valle de Sioule."
    ],
    "nl": [
      "Deze route leidt u langs de beboste paden van de zuidelijke helling van het massief van La Bosse. Uitzicht op de Puys-keten en de vallei van Sioule."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spot Trail de La Bosse - Les sources de la Gourdonne"
    ]
  },
