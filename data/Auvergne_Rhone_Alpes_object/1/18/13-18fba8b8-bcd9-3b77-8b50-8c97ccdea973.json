  "rdfs:comment": {
    "de": [
      "L'épicerie sauvage bietet Ihnen das Know-how von Erzeugern, Sammlern und Verarbeitern aus geschützten und naturbelassenen Gebieten."
    ],
    "en": [
      "L'épicerie sauvage offers you the know-how of producers, pickers and processors from preserved, natural terroirs."
    ],
    "it": [
      "Appassionata raccoglitrice, L'Épicerie Sauvage trasforma piante, frutti e fiori selvatici e locali in prodotti naturali e gourmet. Un approccio artigianale e impegnato che segue il ritmo delle stagioni, rivelando i sapori autentici della natura."
    ],
    "fr": [
      "Cueilleuse passionnée, L’Épicerie Sauvage transforme plantes, fruits et fleurs sauvages et locaux en produits gourmands et naturels. Une démarche artisanale et engagée, au rythme des saisons, qui révèle les saveurs authentiques de la nature."
    ],
    "es": [
      "Recolectores apasionados, L'Épicerie Sauvage transforma plantas, frutas y flores silvestres y locales en productos gourmet y naturales. Un enfoque artesanal y comprometido que sigue el ritmo de las estaciones, revelando los auténticos sabores de la naturaleza."
    ],
    "nl": [
      "L'épicerie sauvage brengt je de expertise van producenten, plukkers en verwerkers uit ongerepte, natuurlijke gebieden."
    ]
  },
  "rdfs:label": {
