  "rdfs:comment": {
    "de": [
      "Der Verein organisiert von Oktober bis Ende Mai Konzerte im Festsaal Henri Girard in La Garde Adhémar im Herzen des Dorfes. Ein Moment der Geselligkeit, eine Gelegenheit, Ihre Freunde zu treffen und sich mit den Musikern zu unterhalten."
    ],
    "en": [
      "The association organizes concerts from  october to end of may in the Salle Henri Girard. A moment of conviviality, an opportunity to meet your friends and converse with the musicians."
    ],
    "it": [
      "Da ottobre a fine maggio, l'associazione organizza concerti nella Salle des Fêtes Henri Girard, a La Garde Adhémar, nel cuore del villaggio. Dopo il concerto, c'è la possibilità di incontrare gli amici e di chiacchierare con i musicisti."
    ],
    "fr": [
      "L'association organise d'octobre à fin mai des concerts dans la salle des fêtes Henri Girard, à La Garde Adhémar au coeur du village .Après le concert nn moment de convivialité est l'occasionde retrouver vos amis et de converser avec les musiciens."
    ],
    "nl": [
      "Van oktober tot eind mei organiseert de vereniging concerten in de dorpshal Henri Girard in La Garde Adhémar, in het hart van het dorp. Het is een geweldige gelegenheid om vrienden te ontmoeten en een praatje te maken met de muzikanten."
    ],
    "es": [
      "De octubre a finales de mayo, la asociación organiza conciertos en la Salle des Fêtes Henri Girard, en La Garde Adhémar, en el corazón del pueblo. Después del concierto, hay ocasión de reunirse con los amigos y charlar con los músicos."
    ]
  },
