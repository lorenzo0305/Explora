  "rdfs:comment": {
    "de": [
      "Eine bretonische Crêperie, die authentische Gerichte aus hochwertigen Produkten anbietet. Bevorzugt werden Erzeuger aus der Bretagne und der Auvergne, wobei der Schwerpunkt auf biologischer Produktion oder nachhaltiger Landwirtschaft liegt."
    ],
    "en": [
      "A Brittany creperie offering an authentic cuisine from quality products. Favouring Breton and Auvergne producers, the emphasis is on organic or sustainable agriculture."
    ],
    "it": [
      "Una crêperie bretone che propone una cucina autentica a base di prodotti di qualità. L'accento è posto sull'agricoltura biologica e sostenibile, con preferenza per i produttori della Bretagna e dell'Alvernia."
    ],
    "fr": [
      "Une crêperie bretonne proposant une cuisine authentique à partir de produits de qualité. Privilégiant les producteurs bretons et auvergnats, l'accent est mis sur les productions biologiques ou en agriculture raisonnée."
    ],
    "es": [
      "Una crepería bretona que ofrece una cocina auténtica elaborada con productos de calidad. Se hace hincapié en los productores bretones y de Auvernia, y en la agricultura ecológica o sostenible."
    ],
    "nl": [
      "Een Bretonse crêperie met een authentieke keuken op basis van kwaliteitsproducten. De nadruk ligt op biologische of duurzame landbouw, met een voorkeur voor Bretonse en Auvergne producenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crêperie Traezh Café"
    ]
  },
