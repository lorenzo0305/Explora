  "rdfs:comment": {
    "de": [
      "Für einen tollen Nachmittag mit den Kindern ist Paradis Konyka genau das Richtige! Hier können Sie garantiert frische Luft schnappen und die Tiere auf dem Bauernhof entdecken!"
    ],
    "en": [
      "For a great afternoon with the kids, Paradis Konyka is great! A guaranteed breath of fresh air and discovery of farm animals!"
    ],
    "it": [
      "Per un bel pomeriggio con i bambini, il Paradis Konyka è il migliore! Aria fresca garantita e scoperta degli animali della fattoria!"
    ],
    "fr": [
      "Pour un super après-midi avec les enfants, Paradis Konyka c'est top ! Bol d'air garanti et découverte des animaux de la ferme !"
    ],
    "nl": [
      "Voor een leuke middag met de kinderen is Paradis Konyka de beste! Gegarandeerd frisse lucht en ontdekking van boerderijdieren!"
    ],
    "es": [
      "Para pasar una buena tarde con los niños, Paradis Konyka es lo mejor Aire fresco garantizado y descubrimiento de los animales de la granja"
