  "rdfs:comment": {
    "de": [
      "Das Chalet Péclet stellt eine zusätzliche Anlaufstelle des Fremdenverkehrsamtes dar. Das vollständig renovierte Gebäude beherbergt außerdem den Club Val Thorens, den Lokalsender R?Saint Martin, Les Menuires, Val Thorens sowie eine öffentliche Toilette."
    ],
    "en": [
      "The Chalet Péclet is an additional reception point for the Tourist Office. Completely refurbished, the building also houses Le Club Val Thorens, local radio station R'Saint Martin, Les Menuires, Val Thorens and public toilets."
    ],
    "it": [
      "Lo Chalet Péclet è un ulteriore punto di accoglienza per l'Ufficio del Turismo. Completamente ristrutturato, l'edificio ospita anche Le Club Val Thorens, la stazione radio locale R'Saint Martin, Les Menuires, Val Thorens e i servizi igienici pubblici."
    ],
    "fr": [
      "Le Chalet Péclet constitue un point d'accueil supplémentaire de l'Office de Tourisme. Entièrement réhabilité, le bâtiment accueille également Le Club Val Thorens, la radio locale R’Saint Martin, Les Menuires, Val Thorens ainsi que des toilettes publiques."
    ],
    "es": [
      "El Chalet Péclet es un punto de recepción adicional de la Oficina de Turismo. Completamente renovado, el edificio también alberga Le Club Val Thorens, la emisora de radio local R'Saint Martin, Les Menuires, Val Thorens y aseos públicos."
    ],
    "nl": [
      "Chalet Péclet is een extra ontvangstpunt voor het toeristenbureau. Het gebouw is volledig gerenoveerd en biedt ook onderdak aan Le Club Val Thorens, het lokale radiostation R'Saint Martin, Les Menuires, Val Thorens en openbare toiletten."
    ]
  },
