  "rdfs:comment": {
    "de": [
      "La Mi Do Ré: Pizzeria, Sandwich-Shop, Bäckerei und Konditorei, aber auch Bagels, Paninis, Cakes, Crêpes, verschiedene Frühstücksangebote, handwerklich hergestellter Kaffee und Heißgetränke.\r\n\r\nKlicken Sie auf die Fotos und scrollen Sie, um die Speisekarte zu entdecken."
    ],
    "en": [
      "Pizzeria, sandwich shop, bread and pastries depot, pastry shop, panini cakes, pancakes and breakfast. A wide menu to take away"
    ],
    "it": [
      "La Mi Do Ré: pizzeria, paninoteca, panetteria e pasticceria, ma anche bagel, panini, torte, crepes, varie formule di colazione, caffè artigianale e bevande calde.\r\n\r\nFare clic sulle immagini e scorrere verso il basso per scoprire il menu."
    ],
    "fr": [
      "La Mi Do Ré : pizzeria, sandwicherie, boulangerie et pâtisserie, mais aussi des bagels, paninis, cakes, crêpes, diverses formules petit déjeuner, café artisanal et boissons chaudes.\r\n\r\nCliquez sur les photos et faites les défiler pour découvrir le menu."
    ],
    "nl": [
      "Pizzeria, broodjeszaak, brood- en gebakdepot, banketbakkerij, panini-gebak, pannenkoeken en ontbijt. Een breed menu om mee te nemen"
    ],
    "es": [
      "La Mi Do Ré: pizzería, sandwichería, panadería y pastelería, pero también bagels, paninis, pasteles, crepes, diversas fórmulas de desayuno, café artesanal y bebidas calientes.\r\n\r\nHaga clic en las imágenes y desplácese hacia abajo para descubrir el menú."
    ]
  },
