  "rdfs:comment": {
    "de": [
      "Ambiance&Styles ist der Spezialist für Küchenutensilien, Tischkultur und Dekoration. Wir alle haben ein Recht auf Freude am Kochen und darauf, unsere Lieben gut zu bewirten."
    ],
    "en": [
      "Ambiance&Styles is the specialist in kitchen utensils, tableware and decoration. We all deserve the pleasure of cooking and entertaining those we love."
    ],
    "it": [
      "Ambiance&Styles è lo specialista in utensili da cucina, stoviglie e decorazioni. Tutti noi meritiamo il piacere di cucinare e di intrattenere i nostri cari."
    ],
    "fr": [
      "Ambiance&Styles est le spécialiste des ustensiles de cuisine, des arts de la table et de la décoration. On a tous droit au plaisir de cuisiner et de bien recevoir ceux qu’on aime."
    ],
    "nl": [
      "Ambiance&Styles is de specialist in keukengerei, servies en decoratie. We verdienen het allemaal om lekker te koken en onze geliefden te vermaken."
    ],
    "es": [
      "Ambiance&Styles es especialista en utensilios de cocina, vajilla y decoración. Todos nos merecemos el placer de cocinar y agasajar a nuestros seres queridos."
    ]
  },
