  "rdfs:comment": {
    "de": [
      "Mein Atelier befindet sich an der Straße zwischen Issoire und Besse, im Herzen des Dorfes Chidrac. Verkaufsausstellung von künstlerischen Keramikobjekten, die von mir hergestellt werden: Skulpturen, Vasen, Einzelstücke."
    ],
    "en": [
      "My workshop is located on the road between Issoire and Besse, in the heart of the village of Chidrac. Exhibition and sale of artistic ceramic objects made by me: sculptures, vases, unique pieces."
    ],
    "it": [
      "Il mio laboratorio si trova sulla strada tra Issoire e Besse, nel cuore del villaggio di Chidrac. Esposizione e vendita di oggetti artistici in ceramica realizzati da me: sculture, vasi, pezzi unici."
    ],
    "fr": [
      "Mon atelier se trouve sur la route reliant Issoire à Besse, au cœur du village de Chidrac. Exposition-vente d'objets artistiques en céramique réalisés par mes soins : sculptures, vases, pièces uniques."
    ],
    "nl": [
      "Mijn atelier bevindt zich op de weg tussen Issoire en Besse, in het hart van het dorp Chidrac. Tentoonstelling en verkoop van artistieke keramische objecten door mij gemaakt: beelden, vazen, unieke stukken."
    ],
    "es": [
      "Mi taller está situado en la carretera entre Issoire y Besse, en el corazón del pueblo de Chidrac. Exposición y venta de objetos de cerámica artística realizados por mí: esculturas, jarrones, piezas únicas."
    ]
  },
