  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek wird von einem ehrenamtlichen Team geleitet und ist Teil des öffentlichen Lesenetzes der Communauté des Communes du Pays des Vans en Cévennes."
    ],
    "en": [
      "The municipal library is run by a team of volunteers and is an integral part of the Communauté des Communes du Pays des Vans en Cévennes public reading network."
    ],
    "it": [
      "La biblioteca comunale è gestita da un team di volontari ed è parte integrante della rete di lettura pubblica della Communauté des Communes du Pays des Vans en Cévennes."
    ],
    "fr": [
      "La bibliothèque municipale est gérée par une équipe de bénévoles et fait partie intégrante du réseau de lecture publique de la Communauté des Communes  du Pays des Vans en Cévennes."
    ],
    "es": [
      "La biblioteca municipal está gestionada por un equipo de voluntarios y forma parte integrante de la red de lectura pública de la Communauté des Communes du Pays des Vans en Cévennes."
    ],
    "nl": [
      "De gemeentelijke bibliotheek wordt gerund door een team vrijwilligers en maakt integraal deel uit van het openbare leesnetwerk van de Communauté des Communes du Pays des Vans en Cévennes."
    ]
  },
