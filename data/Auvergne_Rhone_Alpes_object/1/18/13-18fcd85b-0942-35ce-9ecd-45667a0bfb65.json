  "rdfs:comment": {
    "de": [
      "Das Rathaus von Pont-du-Château befindet sich in einem Schloss aus dem 17. Jahrhundert, in dem noch einige Fassadenelemente und Innendekorationen original erhalten sind."
    ],
    "en": [
      "The Pont-du-Château town hall is housed in a 17th-century château that retains elements of the original façade and interior décor."
    ],
    "it": [
      "Il municipio di Pont-du-Château è ospitato in un castello del XVII secolo che conserva parte della facciata e degli arredi interni originali."
    ],
    "fr": [
      "La Mairie de Pont-du-Château prend place au sein d’un château datant du 17e siècle qui conserve certains éléments de façade et décors intérieurs d’origine."
    ],
    "nl": [
      "Het stadhuis van Pont-du-Château is gevestigd in een 17e-eeuws kasteel dat een deel van de originele gevel en het interieur heeft behouden."
    ],
    "es": [
      "El Ayuntamiento de Pont-du-Château está ubicado en un castillo del siglo XVII que conserva parte de su fachada y decoración interior originales."
    ]
