  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Pancrace d'Yvoire ist eine katholische Kirche, die dem Heiligen Pancrace gewidmet ist, der im 3. Jahrhundert in Rom den Märtyrertod erlitt.\r\nSie ist als historisches Monument klassifiziert und ein Muss für Ihren Besuch im Dorf."
    ],
    "en": [
      "Saint-Pancrace d'Yvoire is a Catholic church dedicated to Saint Pancras, who was martyred in Rome in the 3rd century.\r\nListed as a Historic Monument, it's a must-see on any visit to the village."
    ],
    "it": [
      "Saint-Pancrace d'Yvoire è una chiesa cattolica dedicata a San Pancrazio, martirizzato a Roma nel III secolo.\r\nClassificata come monumento storico, è una tappa obbligata quando si visita il villaggio."
    ],
    "fr": [
      "L'église Saint-Pancrace d'Yvoire est une église catholique dédiée à saint Pancrace, qui subit le martyre à Rome au IIIème siècle.\r\nClassée Monument Historique, c’est un incontournable de votre visite dans le village."
    ],
    "nl": [
      "Saint-Pancrace d'Yvoire is een katholieke kerk gewijd aan de heilige Pancras, die in de 3e eeuw in Rome werd gemarteld.\r\nDe kerk staat op de lijst van historische monumenten en is een must als je het dorp bezoekt."
    ],
    "es": [
      "La iglesia de Saint-Pancrace de Yvoire es una iglesia católica dedicada a San Pancracio, martirizado en Roma en el siglo III.\r\nClasificado como monumento histórico, es una visita obligada durante su estancia en el pueblo."
    ]
  },
  "rdfs:label": {
