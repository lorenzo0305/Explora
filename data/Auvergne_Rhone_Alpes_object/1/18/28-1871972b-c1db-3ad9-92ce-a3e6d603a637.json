  "rdfs:comment": {
    "de": [
      "Direkt auf dem Bauernhof hergestellte Milchprodukte aus Ziegen- und Schafsmilch. Wir stellen Joghurt und verschiedene Käsesorten her. Vorherige telefonische Überprüfung empfohlen."
    ],
    "en": [
      "Dairy products made directly on the farm from goat and sheep milk. We make yoghurts and various cheeses. Prior telephone check recommended."
    ],
    "it": [
      "Prodotti caseari realizzati direttamente in azienda con latte di capra e di pecora. Produciamo yogurt e formaggi vari. Si consiglia un controllo telefonico preventivo."
    ],
    "fr": [
      "Produits Laitiers directement fabriqués à la ferme à base de lait de chèvre et de brebis. Nous réalisons  des yaourts et des fromages  divers. Vérification téléphonique préalable conseillée."
    ],
    "nl": [
      "Zuivelproducten die rechtstreeks op de boerderij worden gemaakt van geiten- en schapenmelk. We maken yoghurt en verschillende kazen. Voorafgaande telefonische controle aanbevolen."
    ],
    "es": [
      "Productos lácteos elaborados directamente en la granja con leche de cabra y oveja. Hacemos yogures y varios quesos. Se recomienda consultar previamente por teléfono."
    ]
  },
