  "rdfs:comment": {
    "de": [
      "Das Museum wurde 2001 gegründet und zeigt eine private Sammlung von Vespas ab 1947 bis heute. Diese Sammlung von etwa 50 Vespas wird so liebevoll zusammengetragen und präsentiert."
    ],
    "en": [
      "The museum was created in 2001 and presents a private collection of Vespas from 1947 to the present day. This collection of some fifty Vespas is lovingly assembled and presented."
    ],
    "it": [
      "Il museo è stato creato nel 2001 e presenta una collezione privata di Vespa dal 1947 a oggi. Questa collezione di circa cinquanta Vespe è stata assemblata e presentata con amore."
    ],
    "fr": [
      "Le musée a été créé en 2001 et présente une collection privée de Vespas à partir de 1947 jusqu'à nos jours. Cette collection d'une cinquantaine de Vespas est ainsi amoureusement rassemblée et présentée."
    ],
    "nl": [
      "Het museum werd opgericht in 2001 en presenteert een privécollectie Vespa's van 1947 tot nu. Deze collectie van ongeveer vijftig Vespa's is met liefde samengesteld en gepresenteerd."
    ],
    "es": [
      "El museo se creó en 2001 y presenta una colección privada de Vespas desde 1947 hasta nuestros días. Esta colección de unas cincuenta Vespas está reunida y presentada con mucho cariño."
    ]
  },
