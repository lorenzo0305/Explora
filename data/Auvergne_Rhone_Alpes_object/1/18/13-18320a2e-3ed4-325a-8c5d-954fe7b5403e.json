  "rdfs:comment": {
    "de": [
      "Les Aires - Théâtre de Die et du Diois, scène conventionnée d'intérêt national \"Art en territoire\", ist eine der Institutionen, die die kulturelle Dynamik der Stadt, des Departements und der Region garantieren."
    ],
    "en": [
      "Les Aires - Théâtre de Die et du Diois, a nationally-recognized \"Art en territoire\" stage, is one of the institutions guaranteeing the cultural dynamism of the town, department and region."
    ],
    "it": [
      "Les Aires? Il Théâtre de Die et du Diois, palcoscenico di interesse nazionale \"Art en territoire\", è una delle istituzioni che garantiscono il dinamismo culturale della città, del dipartimento e della regione."
    ],
    "fr": [
      "Les Aires – Théâtre de Die et du Diois, scène conventionnée d’intérêt national « Art en territoire », est l’une des institutions garantes du dynamisme culturel de la ville, du département et de la région."
    ],
    "es": [
      "¿Los Aires? El Théâtre de Die et du Diois, escenario de interés nacional \"Art en territoire\", es una de las instituciones que garantizan el dinamismo cultural de la ciudad, el departamento y la región."
    ],
    "nl": [
      "Les Aires - Théâtre de Die et du Diois, een nationaal erkend 'Art en territoire'-podium, is een van de instellingen die garant staan voor de culturele dynamiek van de stad, het departement en de regio."
    ]
  },
