  "rdfs:comment": {
    "de": [
      "In der Tradition der Bouchons Lyonnais. Qualitätsküche seit 1992. Kulinarische Spezialitäten: hausgemachte Terrine, Geflügelleberkuchen Huhn aus der Bresse mit Sahne und Morcheln, frische Frösche mit Petersilie, Baba au rhum."
    ],
    "en": [
      "In the tradition of Lyon's bouchons. Quality cuisine since 1992. Culinary specialties: homemade terrine, chicken liver cake, Bresse chicken with cream and morels, fresh frogs with parsley, rum baba."
    ],
    "it": [
      "Nella tradizione dei bouchon di Lione. Cucina di qualità dal 1992. Specialità culinarie: terrina fatta in casa, torta di fegato di pollo, pollo di Bresse con crema e spugnole, rane fresche con prezzemolo, babà al rum."
    ],
    "fr": [
      "Dans la tradition des bouchons lyonnais. Cuisine de qualité depuis 1992. Spécialités culinaires : terrine maison, gâteau de foie de volaille  Poulet de Bresse à la crème et aux morilles, grenouilles fraîches à la persillade, baba au rhum."
    ],
    "nl": [
      "In de traditie van \"Bouchons Lyonnais\". kwalitative keuken sinds 1992. Specialiteiten: terrine met kippenlevertjes, Bressense kip met room, verse kikkerbilletjes met peterselie."
    ],
    "es": [
      "En la tradición de los bouchons de Lyon. Cocina de calidad desde 1992. Especialidades culinarias: terrina casera, pastel de hígado de pollo, pollo de Bresse con crema y colmenillas, ranas frescas con perejil, baba de ron."
    ]
  },
