  "rdfs:comment": {
    "de": [
      "Die Fahrradroute 75 durchquert das Département Allier von Ost nach West auf einer Länge von 137 Kilometern mit einem kumulierten Höhenunterschied von über 1400 Metern."
    ],
    "en": [
      "Cycle Route 75 crosses the Allier department from east to west, covering 137 kilometers and over 1,400 meters of vertical drop."
    ],
    "it": [
      "L'itinerario ciclabile 75 attraversa il dipartimento dell'Allier da est a ovest per 137 chilometri, con una pendenza totale di oltre 1.400 metri."
    ],
    "fr": [
      "La véloroute 75 traverse le département de l’Allier d’est en ouest sur 137 kilomètres pour plus de 1 400 mètres de dénivelé cumulé."
    ],
    "es": [
      "La ruta ciclista 75 atraviesa el departamento de Allier de este a oeste a lo largo de 137 kilómetros, con un desnivel total de más de 1.400 metros."
    ],
    "nl": [
      "Fietsroute 75 doorkruist het departement Allier van oost naar west over 137 kilometer, met een totale stijging van meer dan 1400 meter."
    ]
  },
  "rdfs:label": {
