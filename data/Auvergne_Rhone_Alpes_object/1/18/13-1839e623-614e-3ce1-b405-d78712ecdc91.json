  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Atmosphäre des Frühlings, in Blumen, Sträuße und farbenfrohe Hintergründe, um sich zu sanften Aquarellen inspirieren zu lassen."
    ],
    "en": [
      "Immerse yourself in springtime atmosphere, flowers, bouquets and colorful backgrounds to inspire gentle watercolors."
    ],
    "it": [
      "Immergetevi nell'atmosfera della primavera, tra fiori, bouquet e sfondi colorati per ispirare delicati acquerelli."
    ],
    "fr": [
      "Plongez dans l’atmosphère printanière, les fleurs, les bouquets et les fonds colorés pour inspirer des aquarelles tout en douceur."
    ],
    "es": [
      "Sumérjase en la atmósfera de la primavera, flores, ramos y fondos coloridos para inspirar suaves acuarelas."
    ],
    "nl": [
      "Dompel jezelf onder in de sfeer van de lente, bloemen, boeketten en kleurrijke achtergronden om zachte aquarellen te inspireren."
    ]
  },
  "rdfs:label": {
