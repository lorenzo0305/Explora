  "rdfs:comment": {
    "de": [
      "Entdecken Sie in Landry in der Haute-Tarentaise ein neues Geschäft mit Waffenabteilung: Schießsimulator für alle ohne Waffenschein, sicheres und Freizeitschießen, Funktionsbekleidung, Canicross-Ausrüstung und Optik. Angeln ist ab März 2026 möglich. Genießen Sie die natürliche Atmosphäre und herzliche Gastfreundschaft."
    ],
    "en": [
      "Located in Landry, in the Haute-Tarentaise region, discover a new store and gun shop: shooting simulator open to all without a license, safe or recreational shooting, technical clothing, canicross equipment, optics. Fishing available from March 2026. Enjoy a natural atmosphere and a warm welcome."
    ],
    "it": [
      "Situato nella Haute-Tarentaise a Landry, scoprite un nuovo negozio e un armaiolo: simulatore di tiro aperto a tutti senza licenza, tiro di sicurezza o per il tempo libero, abbigliamento tecnico, canicross, ottica. Pesca da marzo 2026. Un'atmosfera naturale e un'accoglienza calorosa."
    ],
    "fr": [
      "Situé en Haute-Tarentaise à Landry, découvrez un nouveau magasin et armurerie : simulateur de tir ouvert à tous sans licence, tir en sécurité ou loisir, vêtements techniques, canicross, optiques. Pêche dès mars 2026. Ambiance nature et accueil chaleureux."
    ],
    "es": [
      "Situado en la Haute-Tarentaise en Landry, descubra una nueva tienda y armería: simulador de tiro abierto a todos sin licencia, tiro de seguridad o de ocio, ropa técnica, canicross, óptica. Pesca a partir de marzo de 2026. Un ambiente natural y una cálida acogida."
    ],
    "nl": [
      "Ontdek in de Haute-Tarentaise bij Landry een nieuwe winkel en wapensmederij: schietsimulator open voor iedereen zonder vergunning, veiligheids- of vrijetijdschieten, technische kleding, canicross, optiek. Vissen vanaf maart 2026. Een natuurlijke sfeer en een warm welkom."
    ]
  },
