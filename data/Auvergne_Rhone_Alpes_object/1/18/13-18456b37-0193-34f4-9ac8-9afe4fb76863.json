  "rdfs:comment": {
    "de": [
      "Die in einem Talkessel gelegene Auberge befindet sich im Herzen des Plateau de Retord und in der Nähe der Langlaufloipen des Centre Montagnard de Lachat."
    ],
    "en": [
      "The Auberge, nestled in a valley, is located in the heart of the Retord Plateau, close to the cross-country ski trails of the Centre Montagnard de Lachat and 10 km from the Les Plans d'Hotonnes ski resort."
    ],
    "it": [
      "Immerso nella cavità di una combe, l'Auberge è situato nel cuore del Plateau de Retord, vicino alle piste di sci di fondo del Centre Montagnard de Lachat e a 10 km dalla stazione sciistica di Les Plans d'Hotonnes."
    ],
    "fr": [
      "L'Auberge, nichée au creux d'une combe, est située au cœur du Plateau de Retord et à proximité des pistes de ski de fond du Centre Montagnard de Lachat et à 10 km de la station de ski Les Plans d'Hotonnes."
    ],
    "es": [
      "Enclavado en el hueco de una combe, el Auberge está situado en el corazón del Plateau de Retord, cerca de las pistas de esquí de fondo del Centre Montagnard de Lachat y a 10 km de la estación de esquí Les Plans d'Hotonnes."
    ],
    "nl": [
      "De Auberge, genesteld in de holte van een combe, ligt in het hart van het Plateau de Retord, dicht bij de langlaufloipes van het Centre Montagnard de Lachat en op 10 km van het skigebied Les Plans d'Hotonnes."
    ]
  },
