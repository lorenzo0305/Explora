  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein Restaurant, in dem Ihnen eine traditionelle Küche aus lokalen Produkten angeboten wird. Abends zusätzlich um einen Grill, um gute Stücke Fleisch und viele andere hausgemachte Gerichte zu genießen."
    ],
    "en": [
      "Discover a restaurant with traditional cuisine, cooked with local products. In the evening, you can also enjoy some barbecued meat and many other home made meals."
    ],
    "it": [
      "Venite a scoprire un ristorante che serve una cucina tradizionale a base di prodotti locali. La sera potrete anche godervi un barbecue per assaggiare tagli di carne pregiati e molti altri piatti fatti in casa."
    ],
    "fr": [
      "Venez découvrir un restaurant où vous est proposé une cuisine traditionnelle à base de produits locaux. Le soir, en plus, autour d'un barbecue pour déguster de bonnes pièces de viande et bien d'autres plats préparés maison."
    ],
    "nl": [
      "Kom en ontdek een restaurant dat traditionele gerechten serveert op basis van lokale producten. S Avonds kun je ook genieten van een barbecue om fijne stukken vlees en vele andere huisgemaakte gerechten te proeven."
    ],
    "es": [
      "Descubra un restaurante de cocina tradicional basada en productos locales. Por la noche, también podrá disfrutar de una barbacoa para degustar finos cortes de carne y muchos otros platos caseros."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant le Rossli"
    ],
    "fr": [
      "Le Rossli"
    ]
  },
