  "rdfs:comment": {
    "de": [
      "Ein einwöchiges Praktikum, das speziell für Kinder zwischen 8 und 11 Jahren konzipiert wurde.\r\nAuf dem Programm stehen Improvisation, Erkundung der Werkzeuge des Schauspielers, Arbeit auf der Bühne, gemeinsame Kreationen?"
    ],
    "en": [
      "A one-week immersive workshop specially designed for children aged 8 to 11.\r\nOn the program: improvisation, exploration of the actor?s tools, stage work, collective creations?"
    ],
    "it": [
      "Un corso immersivo di una settimana pensato appositamente per i bambini dagli 8 agli 11 anni.\r\nIn programma: improvvisazione, esplorazione degli strumenti dell'attore, lavoro scenico, creazioni collettive?"
    ],
    "fr": [
      "Un stage  immersif d’une semaine, spécialement conçu pour les enfants de 8 à 11 ans .\r\nAu programme : improvisation, exploration des outils de l’acteur, travail sur scène, créations collectives…"
    ],
    "es": [
      "Un curso de inmersión de una semana especialmente diseñado para niños de 8 a 11 años.\r\nEn el programa: improvisación, exploración de las herramientas del actor, trabajo escénico, creaciones colectivas.."
    ],
    "nl": [
      "Een meeslepende cursus van een week, speciaal ontworpen voor kinderen van 8 tot 11 jaar.\r\nOp het programma: improvisatie, verkenning van het gereedschap van de acteur, toneelwerk, collectieve creaties?"
    ]
  },
  "rdfs:label": {
