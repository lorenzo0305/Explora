  "rdfs:comment": {
    "de": [
      "Von der Cie L'Hôtel du Nord\n\nEine sinnliche und poetische Reise zwischen Lachen und Schaudern, um die Nacht zu zähmen und sie in ein Gebiet der Erkundung und des Abenteuers zu verwandeln."
    ],
    "en": [
      "By Cie L'Hôtel du Nord\n\nA sensory and poetic journey, between laughter and thrills, to tame the night and transform it into a land of exploration and adventure."
    ],
    "it": [
      "Da Cie L'Hôtel du Nord\n\nUn viaggio sensoriale e poetico, tra risate e brividi, per domare la notte e trasformarla in un terreno di esplorazione e avventura."
    ],
    "fr": [
      "Par la Cie L'Hôtel du Nord\n\nUn voyage sensoriel et poétique, entre rire et frissons, pour apprivoiser la nuit et la transformer en terrain d’exploration et d’aventure."
    ],
    "es": [
      "Por Cie L'Hôtel du Nord\n\nUn viaje sensorial y poético, entre la risa y la emoción, para domar la noche y transformarla en un terreno de exploración y aventura."
    ],
    "nl": [
      "Door Cie L'Hôtel du Nord\n\nEen zintuiglijke en poëtische reis, tussen lachen en sensatie, om de nacht te temmen en te veranderen in een land van ontdekking en avontuur."
    ]
  },
