  "rdfs:comment": {
    "de": [
      "Im historischen Viertel von Le Puy-en-Velay bietet Ihnen das Restaurant-Brasserie de la Distillerie das ganze Jahr über eine abwechslungsreiche und raffinierte Speisekarte mit lokalen Spezialitäten."
    ],
    "en": [
      "In the historic district of Le Puy-en-Velay, the restaurant-brasserie de la Distillerie offers a varied and refined menu of local specialities all year round."
    ],
    "it": [
      "Nel quartiere storico di Le Puy-en-Velay, il ristorante-brasserie Distillerie offre tutto l'anno un menù vario e raffinato di specialità locali."
    ],
    "fr": [
      "Dans le quartier historique du Puy-en-Velay, le restaurant-brasserie de la Distillerie vous propose  toute l'année une carte variée et raffinée avec des spécialités locales."
    ],
    "nl": [
      "In de historische wijk van Le Puy-en-Velay biedt de Distillerie restaurant-brasserie het hele jaar door een gevarieerd en verfijnd menu met lokale specialiteiten."
    ],
    "es": [
      "En el casco histórico de Le Puy-en-Velay, el restaurante-brasserie Distillerie ofrece durante todo el año una carta variada y refinada de especialidades locales."
    ]
  },
