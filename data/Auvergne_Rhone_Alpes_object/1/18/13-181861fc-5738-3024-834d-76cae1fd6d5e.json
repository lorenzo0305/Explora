  "rdfs:comment": {
    "de": [
      "Chamonix Vertical - eine Gruppe von internationalen Bergführern, die zusammenarbeiten! Wir sprechen Englisch, Deutsch, Spanisch, Französisch,... Wenn du ein unvergessliches Erlebnis in den Bergen haben möchtest, bist du hier genau richtig!"
    ],
    "en": [
      "Chamonix Vertical - a group of international mountain guides working together! We speak English, German, Spanish, French,...If you want an unforgettable mountain experience, you've found the right team!"
    ],
    "it": [
      "Chamonix Vertical - un gruppo di guide alpine internazionali che lavorano insieme! Parliamo inglese, tedesco, spagnolo, francese... Se volete vivere un'esperienza di montagna indimenticabile, avete trovato il team giusto!"
    ],
    "fr": [
      "Chamonix Vertical - groupe des guides de montagne internationaux qui travaillent ensemble! Nous parlons l’anglais, l’allemand, l'espagnol, le français,...Si vous voulez une expérience inoubliable en montagne, vous avez trouvez la bonne équipe!"
    ],
    "nl": [
      "Chamonix Vertical - een groep internationale berggidsen die samenwerken! We spreken Engels, Duits, Spaans, Frans,... Als je een onvergetelijke bergervaring wilt, dan heb je het juiste team gevonden!"
    ],
    "es": [
      "Chamonix Vertical - ¡un grupo de guías de montaña internacionales trabajando juntos! Hablamos inglés, alemán, español, francés,... Si quieres vivir una experiencia inolvidable en la montaña, ¡has encontrado el equipo adecuado!"
    ]
  },
