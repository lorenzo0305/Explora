  "rdfs:comment": {
    "de": [
      "La Ligatore fertigt auf Anfrage alle personalisierten Buchbindungen, Gästebücher, personalisierte Alben. Boutique für Schmuck, Kunstpapier, Kartonage, Postkarten. Buchbinderei-Service, Boutique und Organisation von Halbtageskursen."
    ],
    "en": [
      "La Ligatore produces personalized bindings, guest books and albums on request. Jewelry store, art stationery, cardboard, postcards. Bookbinding service, boutique and organization of half-day workshops."
    ],
    "it": [
      "La Ligatore realizza rilegature personalizzate, guest book e album personalizzati su richiesta. Gioielleria, cartoleria d'arte, cartone, cartoline. Servizio di legatoria, negozio e organizzazione di corsi di mezza giornata."
    ],
    "fr": [
      "La Ligatore réalise sur demande toute reliure personnalisée, livres d'or, albums personnalisés. Boutique de bijoux, articles de papeterie d'art, cartonnage, cartes postales. Service reliure, boutique et organisation de stage à la demi-journée."
    ],
    "es": [
      "La Ligatore realiza encuadernaciones a medida, libros de visitas y álbumes personalizados por encargo. Joyería, papelería artística, cartonaje, postales. Servicio de encuadernación, tienda y organización de cursos de media jornada."
    ],
    "nl": [
      "La Ligatore produceert op verzoek bindwerk op maat, gastenboeken en gepersonaliseerde albums. Juwelierswinkel, papierwaren, karton, ansichtkaarten. Boekbindservice, winkel en organisatie van cursussen van een halve dag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ligatore - Reliure d'art et cartonnage"
    ]
  },
