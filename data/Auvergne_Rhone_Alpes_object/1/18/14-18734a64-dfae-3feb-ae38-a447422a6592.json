      "@id": "https://data.datatourisme.fr/ada247d9-6343-32f4-841d-2cc4954d5854",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 8:30 bis 19:30 Uhr\nSamstags von 8.30 bis 19.00 Uhr\n\nSonntag geschlossen\n\nAbholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 8:30am to 7:30pm\nSaturday from 8:30 am to 7:00 pm\n\nClosed on Sunday\n\nPick-up :\n\nDuring store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a venerdì dalle 8.30 alle 19.30\nSabato dalle 8.30 alle 19.00\n\nChiuso la domenica\n\nRitiro:\n\nDurante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 8h30 à 19h30\nLe samedi de 8h30 à 19h00\n\nFermeture le dimanche\n\nRetrait :\n\nAux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag t/m vrijdag van 8.30 tot 19.30 uur\nZaterdag van 8.30 tot 19.00 uur\n\nZondag gesloten\n\nOphalen:\n\nTijdens winkelopeningstijden\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes de 8h30 a 19h30\nSábado de 8h30 a 19h00\n\nDomingos cerrado\n\nRecogida:\n\nDurante el horario de apertura de la tienda\n\n\n "
        ]
      },
