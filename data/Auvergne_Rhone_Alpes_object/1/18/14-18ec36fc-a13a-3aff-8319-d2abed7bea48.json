  "rdfs:comment": {
    "de": [
      "Heute gedenkt das Radio Amicale du Soleil, \"das Radio aller aus Algerien Zurückgekehrten\", Carmen Sintès, einer emblematischen Figur des Viertels."
    ],
    "en": [
      "Today, Radio Amicale du Soleil, \"the radio of all Algerian repatriates\", pays tribute to Carmen Sintès, an emblematic figure of the neighbourhood."
    ],
    "it": [
      "Oggi Radio Amicale du Soleil, \"la radio di tutti i rimpatriati dall'Algeria\", rende omaggio a Carmen Sintès, figura emblematica del quartiere."
    ],
    "fr": [
      "Aujourd’hui, la Radio Amicale du Soleil, “la radio de tous les rapatriés d’Algérie”, rend hommage à Carmen Sintès, figure emblématique du quartier."
    ],
    "nl": [
      "Vandaag brengt Radio Amicale du Soleil, \"het radiostation voor alle gerepatrieerden uit Algerije\" een eerbetoon aan Carmen Sintès, een emblematische figuur in de wijk."
    ],
    "es": [
      "Hoy, Radio Amicale du Soleil, ?la emisora de todos los repatriados de Argelia? rinde homenaje a Carmen Sintès, figura emblemática del barrio."
    ]
