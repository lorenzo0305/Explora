  "rdfs:comment": {
    "de": [
      "Kunstgalerie mit hochwertigen Ausstellungen, entweder als Einzelausstellung von Fotografen, Malern, bildenden Künstlern, Keramikern und Künstlern oder als Sammelausstellung (französische und ausländische Künstler)."
    ],
    "en": [
      "Art galery offering high quality exhibitions of solo photographers, painters, plastic artists, ceramists, creators… And also collective ones of French or foreign artists. 100 m² gallery with 4 rooms and a garden in the centre of Dieulefit. Guided tours. Three of the four rooms are accessible to disabled people."
    ],
    "it": [
      "Mostre d'arte - sculture, dipinti, fotografie - o mercati di designer: illustrazioni e arti grafiche, cartoleria, design tessile, gioielli nelle 3 sale della galleria."
    ],
    "fr": [
      "Exposition d’art  - sculptures, peintures, photo - ou marché de créateurs: illustrations et  arts graphiques, papeterie, design textile, bijouterie dans les 3 salles de la galerie."
    ],
    "nl": [
      "Kunstgalerie die kwaliteitstentoonstellingen aanbiedt, hetzij als een solotentoonstelling van fotografen, schilders, beeldende kunstenaars, keramisten en makers, of als een collectieve tentoonstelling (Franse en buitenlandse kunstenaars)."
    ],
    "es": [
      "Exposiciones de arte -esculturas, pinturas, fotografía- o mercados de diseño: ilustraciones y artes gráficas, papelería, diseño textil, joyería en las 3 salas de la galería."
    ]
  },
