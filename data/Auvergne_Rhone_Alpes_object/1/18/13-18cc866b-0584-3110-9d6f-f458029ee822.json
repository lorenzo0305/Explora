  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais durch ein spielerisches und kostenloses Geocaching-Erlebnis! In Saint-Symphorien-sur-Coise können Sie sich auf die Jagd nach Öpinell, einem multifunktionalen Gnolus, begeben! Er und die anderen Gnolus werden Ihnen die Geschichte der pelauischen Stadt näher bringen."
    ],
    "en": [
      "Discover the Monts du Lyonnais through a fun and free geocaching experience! In Saint-Symphorien-sur-Coise, go hunting for Öpinell, the multifunctional Gnolu! He and the other Gnolus will make you discover the history of the Pelaude city."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais attraverso un'esperienza di geocaching divertente e gratuita! A Saint-Symphorien-sur-Coise, andate a caccia di Öpinell, uno Gnolu multifunzionale! Lui e gli altri Gnolus vi aiuteranno a scoprire la storia della città."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais à travers une expérience ludique et gratuite de géocaching ! A Saint-Symphorien-sur-Coise, partez à la chasse d' Öpinell, Gnolu multifonctions ! Lui et les autres Gnolus vous feront découvrir l'histoire de la cité pelaude."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais via een leuke en gratis geocaching-ervaring! Ga in Saint-Symphorien-sur-Coise op jacht naar Öpinell, een multifunctionele Gnolu! Hij en de andere Gnolus zullen je helpen de geschiedenis van de stad te ontdekken."
    ],
    "es": [
      "Descubra los Montes del Lyonnais a través de una experiencia de geocaching divertida y gratuita En Saint-Symphorien-sur-Coise, vaya a la caza de Öpinell, un Gnolu multifuncional Él y los otros Gnolus te ayudarán a descubrir la historia de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Chapeau de paille et bottes de cuir"
    ]
  },
