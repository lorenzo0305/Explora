  "rdfs:comment": {
    "de": [
      "Ein immersives Spiel in Naturgröße im Herzen des Gevaudan. Finden Sie die Antworten auf die 6 Rätsel der legendären Orte der Margeride. Dieses virtuelle Spiel ist auf 6 Orte und 3 Departements verteilt."
    ],
    "en": [
      "A life-size immersive game in the heart of the Gevaudan. Find the answers to 6 riddles in the legendary places of the Margeride. This virtual game is spread over 6 locations and 3 departments."
    ],
    "it": [
      "Un gioco immersivo a grandezza naturale nel cuore del Gevaudan. Trovate le risposte a 6 enigmi nei luoghi leggendari della Margeride. Questo gioco virtuale si sviluppa in 6 luoghi e 3 dipartimenti."
    ],
    "fr": [
      "Un jeu immersif grandeur nature en plein cœur du Gevaudan. Trouvez les réponses aux 6 énigmes des lieux de légendes de la Margeride. Ce jeu virtuel est réparti dans 6 lieux et 3 départements."
    ],
    "es": [
      "Un juego inmersivo a tamaño real en el corazón del Gévaudan. Encuentre las respuestas a 6 enigmas en los lugares legendarios de la Margeride. Este juego virtual se reparte en 6 lugares y 3 departamentos."
    ],
    "nl": [
      "Een meeslepend, levensgroot spel in het hart van de Gevaudan. Vind de antwoorden op 6 raadsels in de legendarische plaatsen van de Margeride. Dit virtuele spel is verdeeld over 6 locaties en 3 afdelingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game Secrète Margeride"
    ]
  },
