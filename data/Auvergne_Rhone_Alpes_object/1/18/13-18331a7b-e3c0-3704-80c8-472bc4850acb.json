  "rdfs:comment": {
    "de": [
      "Primeurladen mit kurzem Vertriebsweg, der frisches Obst und Gemüse anbietet, das direkt bei Erzeugern im Rhône-Tal ausgewählt wird. Einige Produkte aus dem Gebiet Mézenc Loire Meygal ergänzen das lokale Angebot."
    ],
    "en": [
      "Short-run greengrocer offering fresh fruit and vegetables selected directly from growers in the Rhône Valley. Some products from the Mézenc Loire Meygal region complete the local offer."
    ],
    "it": [
      "Frutta e verdura fresche selezionate direttamente dai produttori della Valle del Rodano. Alcuni prodotti della regione Mézenc Loire Meygal completano l'offerta locale."
    ],
    "fr": [
      "Primeur en circuit court, proposant des fruits et légumes frais sélectionnés directement auprès de producteurs de la vallée du Rhône. Quelques produits du territoire Mézenc Loire Meygal complètent l’offre locale."
    ],
    "es": [
      "Frutería de proximidad que ofrece frutas y verduras frescas seleccionadas directamente de los productores del valle del Ródano. Algunos productos de la región de Mézenc Loire Meygal completan la oferta local."
    ],
    "nl": [
      "Een groenteboer met een klein assortiment vers fruit en groenten, rechtstreeks van telers uit de Rhône-vallei. Enkele producten uit de streek Mézenc Loire Meygal vervolledigen het lokale aanbod."
    ]
  },
  "rdfs:label": {
