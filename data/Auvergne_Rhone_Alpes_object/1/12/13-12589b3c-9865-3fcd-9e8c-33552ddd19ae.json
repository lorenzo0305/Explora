  "rdfs:comment": {
    "de": [
      "Dank des Sessellifts in Chamrousse 1750 - Roche Béranger können Sie im Sommer die Mountainbike-Strecken nutzen oder bequem zu Fuß zum Lac Achard gehen. Und im Winter profitieren Sie von einem kuppelbaren 6er-Sessellift, der Sie schnell zu den Skipisten bringt."
    ],
    "en": [
      "Thanks to the chairlift, located in Chamrousse 1750 - Roche Béranger, you can enjoy the mountain bike trails or easily reach the Achard lake on foot in summer. And in winter, take advantage of a detachable 6-seater chairlift for quick access to the ski slopes."
    ],
    "it": [
      "Grazie alla seggiovia, situata a Chamrousse 1750 - Roche Béranger, si possono percorrere i sentieri per mountain bike o raggiungere facilmente il lago Achard a piedi in estate. E in inverno, approfittate di una seggiovia a 6 posti staccabile per accedere rapidamente alle piste da sci."
    ],
    "fr": [
      "Grâce au télésiège, située à Chamrousse 1750 - Roche Béranger, profitez des pistes de VTT ou rejoignez facilement à pied le lac Achard en été. Et en hiver profitez d'un télésiège débrayable 6 places pour accéder rapidement aux pistes de ski."
    ],
    "es": [
      "Gracias al telesilla, situado en Chamrousse 1750 - Roche Béranger, podrá disfrutar de los senderos para bicicletas de montaña o llegar fácilmente al lago de Achard a pie en verano. Y en invierno, aproveche un telesilla desmontable de 6 plazas para acceder rápidamente a las pistas de esquí."
    ],
    "nl": [
      "Dankzij de stoeltjeslift, gelegen in Chamrousse 1750 - Roche Béranger, kunt u genieten van de mountainbikeroutes of in de zomer gemakkelijk te voet het meer van Achard bereiken. En in de winter kunt u gebruik maken van een afneembare 6-persoons stoeltjeslift voor een snelle toegang tot de skipistes."
    ]
  },
  "rdfs:label": {
    "de": [
      "Sessellift von La Bérangère"
    ],
    "en": [
      "Bérangère chairlift"
    ],
    "fr": [
      "Télésiège de Bérangère"
    ]
  },
