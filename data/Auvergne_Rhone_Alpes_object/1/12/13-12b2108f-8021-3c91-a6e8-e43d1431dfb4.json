  "rdfs:comment": {
    "de": [
      "Das Premio ist ein Imbiss in der Rue Caron. Er bietet Burger, Pizza, Pommes frites, Paninis und Tacos sowie Waffeln, Crêpes und Paninis als Nachtisch oder für zwischendurch an."
    ],
    "en": [
      "Premio is a snack bar in Rue Caron. It offers burgers, pizzas, chips, paninis and tacos, as well as waffles, crêpes and paninis for dessert and snacks."
    ],
    "it": [
      "Premio è uno snack bar in Rue Caron. Offre hamburger, pizze, patatine fritte, panini e tacos, oltre a waffle, crêpe e panini per dessert e spuntini."
    ],
    "fr": [
      "Le Premio est un snack situé dans la rue Caron. Il propose des burgers, pizzas, frites, paninis et tacos ainsi que des gaufres, crêpes et paninis en dessert ou pour le goûter."
    ],
    "nl": [
      "Premio is een snackbar in de Rue Caron. Je kunt er terecht voor hamburgers, pizza's, friet, panini's en taco's, maar ook voor wafels, crêpes en panini's als dessert en tussendoortje."
    ],
    "es": [
      "Premio es un snack bar situado en la Rue Caron. Ofrece hamburguesas, pizzas, patatas fritas, paninis y tacos, así como gofres, crepes y paninis de postre y merienda."
    ]
