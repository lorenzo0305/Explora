    "de": [
      "L'Escapade empfängt Sie montags bis samstags von 9:00 bis 22:00 Uhr auf seiner Sonnenterrasse oder in seinem gemütlichen Inneren."
    ],
    "en": [
      "L'Escapade welcomes you Monday to Saturday, 9am to 10pm, on its sunny terrace or in its warm interior."
    ],
