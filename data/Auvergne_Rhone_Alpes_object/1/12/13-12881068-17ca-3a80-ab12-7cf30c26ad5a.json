  "rdfs:comment": {
    "de": [
      "HANGOVER bietet Ihnen eine Spezialität aus Québec! Probieren Sie eine leckere Poutine: hausgemachte Pommes frites, Käse aus Québec und eine vegane und glutenfreie Gravy-Sauce. Gestalten Sie sie anschließend mit Dutzenden von verschiedenen Zutaten!"
    ],
    "en": [
      "HANGOVER brings you a Quebec specialty! Come and enjoy a delicious Poutine: homemade fries, cheese curds made in Quebec and a gravy sauce that's both vegan and gluten-free. Then customize it with dozens of different ingredients!"
    ],
    "it": [
      "HANGOVER vi offre una specialità del Quebec! Venite a gustare un'ottima Poutine: patatine fritte fatte in casa, cagliata di formaggio prodotta in Quebec e una salsa di sugo che è sia vegana che senza glutine. Personalizzatela poi con decine di ingredienti diversi!"
    ],
    "fr": [
      "HANGOVER vous propose une spécialité Québécoise ! Venez dégustez une bonne Poutine : Des frites maison, du fromage en grain made in Québec et une gravy sauce Végan et Gluten Free. Personnalisez la ensuite avec des dizaines d’ingrédients différents !"
    ],
    "es": [
      "¡HANGOVER te ofrece una especialidad de Quebec! Ven a disfrutar de una deliciosa Poutine: patatas fritas caseras, cuajada de queso hecha en Quebec y una salsa gravy vegana y sin gluten. Personalízala con decenas de ingredientes diferentes."
    ],
    "nl": [
      "HANGOVER biedt u een specialiteit van Quebec! Kom genieten van een goede Poutine: huisgemaakte frietjes, in Quebec gemaakte cheese curds en een jus die zowel Veganistisch als Glutenvrij is. Pas het daarna aan met tientallen verschillende ingrediënten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hangover Fresh Poutine"
    ]
  },
