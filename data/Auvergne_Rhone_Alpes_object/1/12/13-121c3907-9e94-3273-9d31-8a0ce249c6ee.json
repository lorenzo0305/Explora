  "rdfs:comment": {
    "de": [
      "Willkommen bei ET!C & CROQ Valence, einer einzigartigen Adresse, an der Gastronomie und Solidarität Hand in Hand gehen. Unser Restaurant liegt im Herzen der Drôme und ist mehr als nur ein Ort zum Essen:"
    ],
    "en": [
      "Welcome to ET!C & CROQ Valence, a unique address where gastronomy rhymes with solidarity. Located in the heart of the Drôme region, our restaurant is much more than just a place to eat:"
    ],
    "it": [
      "Benvenuti all'ET!C & CROQ Valence, un indirizzo unico dove gastronomia fa rima con solidarietà. Situato nel cuore della Drôme, il nostro ristorante è molto più di un semplice posto dove mangiare:"
    ],
    "fr": [
      "Bienvenue chez ET!C & CROQ Valence, une adresse unique où la gastronomie rime avec solidarité. Situé au cœur de la Drôme, notre restaurant est bien plus qu’un lieu de restauration :"
    ],
    "nl": [
      "Welkom bij ET!C & CROQ Valence, een uniek adres waar gastronomie rijmt met solidariteit. Gelegen in het hart van de Drôme, is ons restaurant veel meer dan alleen een plek om te eten:"
    ],
    "es": [
      "Bienvenido a ET!C & CROQ Valence, una dirección única donde gastronomía rima con solidaridad. Situado en el corazón de la Drôme, nuestro restaurante es mucho más que un lugar donde comer:"
    ]
  },
