  "rdfs:comment": {
    "de": [
      "Der Kinderclub Les Marmottes ist eine unverzichtbare Einrichtung für Kinder und Eltern, die sich in Auris aufhalten.\r\nEr ist ein Freizeitzentrum für Kinder von 4 bis 17 Jahren im Sommer, im Winter von 4 bis 12 Jahren sowie eine Kindertagesstätte von 18 Monaten bis 3 Jahren."
    ],
    "en": [
      "Club-enfants Les Marmottes is a must for children and parents staying in Auris.\r\nIt's a leisure center for children aged 4 to 17 in summer, and 4 to 12 in winter, as well as a day-care center for children aged 18 months to 3 years."
    ],
    "it": [
      "Il Club-enfants Les Marmottes è il luogo ideale per i bambini e i genitori che soggiornano ad Auris.\r\nÈ un centro ricreativo per bambini dai 4 ai 17 anni in estate e dai 4 ai 12 anni in inverno, nonché un asilo nido per bambini dai 18 mesi ai 3 anni."
    ],
    "fr": [
      "Le Club-enfants Les Marmottes est la structure incontournable pour les enfants et les parents qui séjournent à Auris.\r\nC'est un accueil de loisirs pour les enfants de 4 à 17 ans en été, en hiver de 4 à 12 ans ainsi qu'une halte-garderie de 18 mois à 3 ans."
    ],
    "es": [
      "El Club-enfants Les Marmottes es el lugar ideal para niños y padres alojados en Auris.\r\nEs un centro de ocio para niños de 4 a 17 años en verano y de 4 a 12 años en invierno, así como una guardería para niños de 18 meses a 3 años."
    ],
    "nl": [
      "Club-enfants Les Marmottes is de place to be voor kinderen en ouders die in Auris verblijven.\r\nHet is een vrijetijdscentrum voor kinderen van 4 tot 17 jaar in de zomer en van 4 tot 12 jaar in de winter, evenals een kinderdagverblijf voor kinderen van 18 maanden tot 3 jaar."
    ]
  },
