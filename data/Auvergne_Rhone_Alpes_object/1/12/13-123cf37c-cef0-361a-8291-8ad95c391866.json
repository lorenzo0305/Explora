  "rdfs:comment": {
    "de": [
      "Der Verein Dunières Danse freut sich, Sie zu seiner jährlichen Gala einzuladen. Ein unvergesslicher Moment, in dem die Leidenschaft für den Tanz auf der Bühne zum Ausdruck kommt."
    ],
    "en": [
      "The Dunières Danse association is delighted to invite you to its annual gala, an unforgettable moment when the passion for dance is revealed on stage."
    ],
    "it": [
      "L'associazione Dunières Danse è lieta di invitarvi al suo gala annuale, un momento indimenticabile in cui la passione per la danza si rivela sul palco."
    ],
    "fr": [
      "L’association Dunières Danse a le plaisir de vous convier à son gala annuel, un moment inoubliable où la passion de la danse se dévoile sur scène."
    ],
    "es": [
      "La asociación Dunières Danse tiene el placer de invitarle a su gala anual, un momento inolvidable en el que la pasión por la danza se revela sobre el escenario."
    ],
    "nl": [
      "De vereniging Dunières Danse nodigt je graag uit voor haar jaarlijkse gala, een onvergetelijk moment waarop de passie voor dans op het podium wordt onthuld."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gala de Danse"
    ]
  },
