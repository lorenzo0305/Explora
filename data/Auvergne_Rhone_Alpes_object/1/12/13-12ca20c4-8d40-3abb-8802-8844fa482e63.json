  "rdfs:comment": {
    "de": [
      "Ein Multi-Sliding-Bereich für junge Sportler. Der Pumptrack ist eine Strecke mit Buckeln und Steilkurven für Skateboards, Fahrräder, Inlineskates und Roller."
    ],
    "en": [
      "A multi-slide area for young enthusiasts. The pump track is a track with bumps and banked turns for skateboards, bikes, rollerblades and scooters."
    ],
    "it": [
      "Un'area multi-scivolo per i giovani appassionati. La pump track è una pista di dossi e curve a gomito per skateboard, biciclette, rollerblade e monopattini."
    ],
    "fr": [
      "Une aire multiglisse pour les jeunes adeptes. Le pump track est une piste de bosses et de virages relevés destiné aux skateboards, vélo, rollers et trottinettes."
    ],
    "es": [
      "Una zona de varios toboganes para los jóvenes aficionados. El pump track es una pista de baches y curvas peraltadas para monopatines, bicicletas, patines y patinetes."
    ],
    "nl": [
      "Een terrein met meerdere glijbanen voor jonge enthousiastelingen. De pompbaan is een baan met hobbels en schuine bochten voor skateboards, fietsen, skeelers en scooters."
    ]
  },
