  "rdfs:comment": {
    "de": [
      "Cosmos[e] ist eine Begegnung an einem Scheideweg, wenn Körper und Geist über Grenzen hinweg wirbeln. Eine intime Aufführung, in der die Gefühle zwischen Valentins Phrasierung und Sybils wirbelnden Röcken schwirren."
    ],
    "en": [
      "Cosmos[e] is an encounter at a crossroads, when body and mind swirl across borders. An intimate show in which feelings swirl between Valentin's phrasing and Sybil's twirling skirts."
    ],
    "it": [
      "Cosmos[e] è un incontro al crocevia, quando corpo e mente vorticano oltre i confini. Uno spettacolo intimo in cui i sentimenti turbinano tra i fraseggi di Valentin e le gonne vorticose di Sybil."
    ],
    "fr": [
      "Cosmos[e]  est une rencontre à la croisée des chemins, quand le corps et l'esprit tourbillonnent au-delà des frontières. Un spectacle intimiste dans lequel les sentiments virevoltent entre le phrasé de Valentin et les jupes tournoyantes de Sybil."
    ],
    "nl": [
      "Cosmos[e] is een ontmoeting op een kruispunt, waar lichaam en geest over grenzen heen wervelen. Een intieme voorstelling waarin gevoelens wervelen tussen de frasen van Valentin en de wervelende rokken van Sybil."
    ],
    "es": [
      "Cosmos[e] es un encuentro en la encrucijada, cuando el cuerpo y la mente se arremolinan más allá de las fronteras. Un espectáculo íntimo en el que los sentimientos se arremolinan entre las frases de Valentin y las faldas arremolinadas de Sybil."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle - Poésie en musique et danse giratoire"
    ]
  },
