  "rdfs:comment": {
    "de": [
      "Coppélia, ein Meisterwerk des klassischen Repertoires, vereint Komik, Mysterium und Virtuosität in einer prächtigen Produktion, die vom Ballett der Opéra national du Capitole de Toulouse getragen wird."
    ],
    "en": [
      "A masterpiece of the classical repertoire, Coppélia blends comedy, mystery and virtuosity in a splendid production by the Opéra national du Capitole de Toulouse Ballet."
    ],
    "it": [
      "Capolavoro del repertorio classico, Coppélia unisce commedia, mistero e virtuosismo in una splendida produzione dell'Opéra national du Capitole de Toulouse Ballet."
    ],
    "fr": [
      "Chef-d'œuvre du répertoire classique, Coppélia mêle comédie, mystère et virtuosité dans une splendide production portée par le Ballet de l’Opéra national du Capitole de Toulouse."
    ],
    "es": [
      "Obra maestra del repertorio clásico, Coppélia combina comedia, misterio y virtuosismo en una espléndida producción del Ballet de la Opéra national du Capitole de Toulouse."
    ],
    "nl": [
      "Coppélia, een meesterwerk uit het klassieke repertoire, combineert komedie, mysterie en virtuositeit in een prachtige productie van het Ballet Opéra national du Capitole de Toulouse."
    ]
  },
