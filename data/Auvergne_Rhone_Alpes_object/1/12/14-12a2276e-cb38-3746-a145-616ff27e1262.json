  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3f3c3f04-4455-3db6-90ea-443a82c240dd",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Freitag von 8.30 bis 12.30 Uhr und von 13.30 bis 19.30 Uhr\nSamstags von 8.30 bis 12.30 Uhr und von 13.30 bis 19.00 Uhr\n\nSonntag geschlossen\n\nAbholung:\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Friday, 8:30am to 12:30pm and 1:30pm to 7:30pm\nSaturday 8:30am to 12:30pm and 1:30pm to 7:00pm\n\nClosed on Sunday\n\nPick-up :\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDal lunedì al venerdì, dalle 8.30 alle 12.30 e dalle 13.30 alle 19.30\nSabato dalle 8.30 alle 12.30 e dalle 13.30 alle 19.00\n\nChiuso la domenica\n\nRitiro:\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au vendredi de 8h30 à 12h30 et de 13h30 à 19h30\nLe samedi de 8h30 à 12h30 et de 13h30 à 19h00\n\nFermeture le dimanche\n\nRetrait :\nAux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot vrijdag van 8u30 tot 12u30 en van 13u30 tot 19u30\nZaterdag van 8.30 tot 12.30 uur en van 13.30 tot 19.00 uur\n\nGesloten op zondag\n\nAfhalen:\nTijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a viernes, de 8h30 a 12h30 y de 13h30 a 19h30\nSábado de 8h30 a 12h30 y de 13h30 a 19h00\n\nDomingos cerrado\n\nRecogida:\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
