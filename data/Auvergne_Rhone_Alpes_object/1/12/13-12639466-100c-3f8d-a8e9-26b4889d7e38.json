  "rdfs:comment": {
    "de": [
      "La Ferme de Fanny heißt Sie das ganze Jahr über willkommen!"
    ],
    "en": [
      "La Ferme de Fanny welcomes you all year round!"
    ],
    "it": [
      "La Fattoria di Fanny vi accoglie tutto l'anno! In famiglia o in gruppo, venite a scoprire i nostri animali e i nostri prodotti attraverso visite e laboratori. Potete anche acquistare i nostri prodotti direttamente nel nostro negozio!"
    ],
    "fr": [
      "La Ferme de Fanny vous accueille toute l'année! En famille ou en groupe venez découvrir nos animaux et nos productions à travers des visites et des ateliers. Vous pourrez également accéder à nos produits en vente directe dans notre boutique!"
    ],
    "es": [
      "La granja de Fanny le da la bienvenida todo el año En familia o en grupo, venga a descubrir nuestros animales y nuestros productos a través de visitas y talleres. También puede comprar nuestros productos directamente en nuestra tienda"
    ],
    "nl": [
      "La Ferme de Fanny verwelkomt u het hele jaar door!"
    ]
  },
