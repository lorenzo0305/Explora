  "rdfs:comment": {
    "de": [
      "Das Parkhaus Pensio befindet sich 2 Minuten vom Stadtzentrum entfernt und ist über die rue Jean Barthélémy erreichbar. Es verfügt über 46 Parkplätze in der orangefarbenen Zone (Höchstparkdauer 2 Stunden), darunter 2 Parkplätze für Behinderte und 2 für das Aufladen von Elektrofahrzeugen"
    ],
    "en": [
      "The Pensio parking lot is 2 minutes from the town center, accessible via rue Jean Barthélémy. It has 46 orange zone spaces (maximum parking time 2 hours), including 2 PMR parking spaces and 2 reserved for recharging electric vehicles"
    ],
    "it": [
      "Il parcheggio Pensio si trova a 2 minuti dal centro città, accessibile da rue Jean Barthélémy. Dispone di 46 posti in zona arancione (tempo massimo di sosta 2 ore), tra cui 2 posti per disabili e 2 riservati alla ricarica dei veicoli elettrici"
    ],
    "fr": [
      "Le parking du Pensio se situe à 2 min du centre-ville, accessible par la rue Jean Barthélémy. Il dispose de 46 places en zone orange (durée maxi de stationnement 2h), dont 2 stationnements PMR et 2 réservés au rechargement des véhicules électriques"
    ],
    "es": [
      "El aparcamiento Pensio se encuentra a 2 minutos del centro de la ciudad, accesible por la calle Jean Barthélémy. Dispone de 46 plazas de zona naranja (tiempo máximo de estacionamiento 2 horas), incluidas 2 plazas para discapacitados y 2 reservadas para la recarga de vehículos eléctricos"
    ],
    "nl": [
      "De Pensio-parkeergarage ligt op 2 minuten van het stadscentrum en is bereikbaar via de rue Jean Barthélémy. Het heeft 46 plaatsen in de oranje zone (maximale parkeertijd 2 uur), waaronder 2 parkeerplaatsen voor gehandicapten en 2 plaatsen die gereserveerd zijn voor het opladen van elektrische voertuigen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parking du Pensio"
    ]
  },
