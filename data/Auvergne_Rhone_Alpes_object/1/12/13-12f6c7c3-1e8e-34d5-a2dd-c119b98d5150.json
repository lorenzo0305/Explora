  "rdfs:comment": {
    "de": [
      "Die Bar von Valmeinier Sport 1800 empfängt Sie im Winter für einen Kaffee, ein Getränk oder einen Snack."
    ],
    "en": [
      "The bar of Valmeinier Sport 1800 welcomes you in winter for a coffee, a drink or a snack. Discover new artists during regular concerts. Take advantage of the opportunity to rent your ski equipment or browse in the clothing and accessories store."
    ],
    "it": [
      "Il bar Valmeinier Sport 1800 vi accoglie in inverno per un caffè, una bevanda o uno spuntino."
    ],
    "fr": [
      "Le bar de Valmeinier Sport 1800 vous accueille en hiver pour un café, un verre ou un snack."
    ],
    "es": [
      "El bar Valmeinier Sport 1800 le da la bienvenida en invierno para tomar un café, una copa o un tentempié."
    ],
    "nl": [
      "De bar Valmeinier Sport 1800 verwelkomt u in de winter voor een kopje koffie, een drankje of een hapje. Ontdek nieuwe artiesten tijdens regelmatige concerten. Maak van de gelegenheid gebruik om uw skiuitrusting te huren of snuffel in de kleding- en accessoireshop."
    ]
