  "rdfs:comment": {
    "de": [
      "Die Tour des Bauges à vélo führt durch die Vorgebirge des PNR des Massif des Bauges. Eine schöne Auszeit inmitten vielfältiger Stimmungen und Landschaften, die durch das reiche Kulturerbe der Städte und Dörfer unterbrochen werden, die Sie bei einem Halt oder einer Etappe entdecken können."
    ],
    "en": [
      "The Tour des Bauges by bike winds its way through the foothills of the PNR of the Bauges massif. A beautiful escape into the heart of varied landscapes, punctuated by the rich heritage of towns and villages to discover during a stopover or a stage."
    ],
    "it": [
      "Il Tour des Bauges in bicicletta segue le pendici del PNR del massiccio dei Bauges. Una bella fuga nel cuore di paesaggi e atmosfere variegate, punteggiata dal ricco patrimonio di città e villaggi da scoprire durante una sosta o una tappa."
    ],
    "fr": [
      "Le Tour des Bauges à vélo chemine sur les piémonts du PNR du massif des Bauges. Une échappée belle au cœur d’ambiances et paysages variés, ponctués par la richesse du patrimoine des villes et villages à découvrir lors d’une halte ou d’une étape."
    ],
    "es": [
      "El Tour des Bauges en bicicleta sigue las estribaciones del PNR del macizo de Bauges. Una bella escapada en el corazón de paisajes y ambientes variados, jalonada por el rico patrimonio de las ciudades y pueblos a descubrir durante una escala o una etapa."
    ],
    "nl": [
      "De Tour des Bauges per fiets slingert zich door de uitlopers van het Regionale Natuurpark Massif des Bauges. Het is een prachtige ontsnapping naar het hart van een gevarieerd landschap, onderbroken door het rijke erfgoed van de steden en dorpen die je kunt ontdekken tijdens een tussenstop of een etappe."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tour des Bauges à vélo - Aix-les-Bains Riviera des Alpes stage - From Aix-les-Bains to Bourget du Lac"
    ],
    "fr": [
      "Tour des Bauges à vélo - Etape Aix-les-Bains Riviera des Alpes - D'Aix-les-Bains au Bourget du Lac"
    ],
    "nl": [
      "Tour des Bauges à vélo - Etappe Aix-les-Bains Riviera des Alpes - Van Aix-les-Bains naar Bourget du Lac"
    ]
  },
