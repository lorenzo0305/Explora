  "rdfs:comment": {
    "de": [
      "Ehemalige Arbeitsbörse am Ufer des Thiou. In diesem Versammlungs- und Veranstaltungsort mit 274 Plätzen finden Theaterstücke, Konferenzen, Filmvorführungen, Konzerte, Aufführungen usw. statt."
    ],
    "en": [
      "A former labor exchange on the banks of the Thiou, this 274-seat meeting and event venue hosts plays, conferences, screenings, concerts, shows and more."
    ],
    "it": [
      "Un'ex borsa del lavoro sulle rive del Thiou, questo spazio per riunioni ed eventi da 274 posti ospita opere teatrali, conferenze, proiezioni, concerti, spettacoli e altro ancora."
    ],
    "fr": [
      "Ancienne bourse du travail, au bord du Thiou, ce lieu de réunion et de diffusion de 274 places accueille des pièces de théâtre, des conférences, des projections, des concerts, des spectacles, ect."
    ],
    "nl": [
      "Deze vergader- en evenementenlocatie met 274 zitplaatsen is een voormalige arbeidsbeurs aan de oevers van de Thiou en biedt plaats aan toneelstukken, conferenties, filmvertoningen, concerten, voorstellingen en nog veel meer."
    ],
    "es": [
      "Antigua bolsa de trabajo a orillas del Thiou, este lugar de reunión y eventos con 274 plazas acoge obras de teatro, conferencias, proyecciones, conciertos, espectáculos y mucho más."
    ]
  },
