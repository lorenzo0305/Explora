  "rdfs:comment": {
    "de": [
      "In 1630 m Höhe befindet sich das Langlaufheim des nordischen Skigebiets Col d'Ornon, das sich in der Unterkunft Le Chantelouve befindet.\r\nDort können Sie die Ausrüstung ausleihen und die Vignetten für den nordischen Skisport erhalten."
    ],
    "en": [
      "At an altitude of 1630 m, the cross-country ski center of the Col d'Ornon Nordic ski area is located at the Chantelouve gîte.\r\nHere you can rent equipment and obtain cross-country ski passes."
    ],
    "it": [
      "A 1630 m di altitudine, il centro di sci di fondo del comprensorio nordico del Col d'Ornon si trova presso il gîte Le Chantelouve.\r\nQui è possibile noleggiare l'attrezzatura e ottenere i pass per lo sci di fondo."
    ],
    "fr": [
      "À 1630 m d’altitude, le foyer de ski de fond du domaine nordique du Col d'Ornon se situe au gîte Le Chantelouve.\r\nVous aurez la possibilité d'y louer le matériel et d'obtenir les vignettes pour le ski nordique."
    ],
    "nl": [
      "Op 1630 m hoogte ligt het langlaufcentrum van het noordse skigebied Col d'Ornon bij de gîte Le Chantelouve.\r\nHier kun je materiaal huren en langlaufpassen verkrijgen."
    ],
    "es": [
      "A 1630 m de altitud, el centro de esquí de fondo de la zona de esquí nórdico de Col d'Ornon se encuentra en la casa rural Le Chantelouve.\r\nAquí podrá alquilar material y obtener forfaits de esquí de fondo."
    ]
  },
  "rdfs:label": {
    "de": [
