  "rdfs:comment": {
    "de": [
      "Séverin stammt aus dem Jura und ist seit 20 Jahren im Tal ansässig, um seinen Beruf als Bergführer auszuüben. Er begleitet Sie beim Bergsteigen, Skifahren abseits der Pisten, Skitouren, Klettern und Canyoning."
    ],
    "en": [
      "Originally from the Jura region, Séverin has been based in the valley for 20 years, working as a mountain guide. He can guide you in mountaineering, off-piste skiing, ski touring, climbing and canyoning."
    ],
    "it": [
      "Originario della regione francese del Giura, Séverin vive nella valle da 20 anni e lavora come guida alpina. Può guidarvi nell'alpinismo, nello sci fuori pista, nello sci alpinismo, nell'arrampicata e nel canyoning."
    ],
    "fr": [
      "Originaire du Jura, Séverin est installé dans la vallée depuis 20 ans, pour y exercer son métier de Guide de Haute Montagne. Il vous accompagnera en alpinisme, ski hors-piste, ski de randonnée, escalade et canyoning."
    ],
    "nl": [
      "Séverin komt oorspronkelijk uit de Franse Jura en werkt al 20 jaar als berggids in de vallei. Hij kan je begeleiden bij bergbeklimmen, off-piste skiën, toerskiën, klimmen en canyoning."
    ],
    "es": [
      "Originario de la región francesa del Jura, Séverin lleva 20 años afincado en el valle como guía de montaña. Puede guiarle en alpinismo, esquí fuera de pista, esquí de travesía, escalada y barranquismo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Séverin Marchand - Guide de Haute Montagne"
    ]
  },
