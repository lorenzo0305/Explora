  "rdfs:comment": {
    "de": [
      "Sie befindet sich im Einkaufsviertel Cyrano, am Fuße der gleichnamigen Wohnanlage, direkt links neben der Apotheke.\r\nDer Bereich ermöglicht einfaches und kostenloses Parken.\r\nDieser spezielle Bereich ist für Personen mit eingeschränkter Mobilität zugänglich."
    ],
    "en": [
      "Located in the Cyrano shopping zone, at the foot of the residence of the same name, just to the left of the pharmacy.\r\nThe area offers easy, free parking.\r\nThis dedicated space is accessible to people with reduced mobility."
    ],
    "it": [
      "Situato nell'area commerciale Cyrano, ai piedi dell'omonimo residence, proprio a sinistra della farmacia.\r\nL'area offre un parcheggio facile e gratuito.\r\nQuesto spazio dedicato è accessibile alle persone con mobilità ridotta."
    ],
    "fr": [
      "Située sur la zone commerciale Cyrano, au pied de la résidence du même nom, juste à gauche de la pharmacie.\r\nLe secteur permet un stationnement facile et gratuit.\r\nCet espace dédié est accessible aux personnes à mobilité réduite."
    ],
    "es": [
      "Situado en la zona comercial de Cyrano, al pie de la residencia del mismo nombre, justo a la izquierda de la farmacia.\r\nLa zona ofrece aparcamiento fácil y gratuito.\r\nEste espacio dedicado es accesible para personas con movilidad reducida."
    ],
    "nl": [
      "Gelegen in het winkelgebied Cyrano, aan de voet van de gelijknamige residentie, net links van de apotheek.\r\nIn deze zone kunt u gemakkelijk en gratis parkeren.\r\nDeze speciale ruimte is toegankelijk voor mensen met beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
