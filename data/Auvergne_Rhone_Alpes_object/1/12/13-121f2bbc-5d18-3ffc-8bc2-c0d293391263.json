    ],
    "it": [
      "Cappella di San Bernardo di Mentone (Bersend)"
    ],
    "fr": [
      "Chapelle Saint Bernard de Menthon (Bersend)"
    ],
    "nl": [
      "Kapel van Sint Bernardus van Menthon (Bersend)"
    ]
