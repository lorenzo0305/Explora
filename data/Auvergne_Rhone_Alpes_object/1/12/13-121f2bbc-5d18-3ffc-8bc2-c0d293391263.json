  "rdfs:comment": {
    "de": [
      "Die Kapelle wurde 1624, am Ende der Zeit der großen Pestepidemien, errichtet... und überstand im 20. Jahrhundert zwei aufeinanderfolgende Brände, die das Dorf heimsuchten!"
    ],
    "en": [
      "The chapel was built in 1624, at the end of the period of the great plague epidemics... and in the 20th century it withstood two successive fires that affected the village!"
    ],
    "it": [
      "La cappella fu costruita nel 1624, alla fine della grande epidemia di peste... e nel XX secolo è sopravvissuta a due incendi successivi che hanno colpito il villaggio!"
    ],
    "fr": [
      "La chapelle fut érigée en 1624, à la fin de la période des grandes épidémies de peste… et résista, au XXe siècle, à deux incendies successifs qui touchèrent le village !"
    ],
    "es": [
      "La capilla se construyó en 1624, al final del periodo de las grandes epidemias de peste... ¡y en el siglo XX sobrevivió a dos incendios sucesivos que afectaron al pueblo!"
    ],
    "nl": [
      "De kapel werd gebouwd in 1624, aan het einde van de grote pestepidemieën... en overleefde in de 20e eeuw twee opeenvolgende branden die het dorp troffen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Kapelle Saint Bernard de Menthon (Bersend)"
    ],
