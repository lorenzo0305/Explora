  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine authentische Küche und eine saisonale Speisekarte. Entdecken Sie unser Restaurant in einem in Valence einzigartigen Dekor mit seinem Josper-Ofen.\r\nDonnerstags und freitags ist das Petit Clos DER Ort für Afterwork, den Sie in Lautagne so schnell wie möglich entdecken sollten!"
    ],
    "en": [
      "We offer authentic cuisine and a seasonal menu. Come and discover our restaurant in a unique setting in Valence, with its Josper oven.\r\nOn Thursdays and Fridays, Le Petit Clos is THE afterwork venue to discover in Lautagne!"
    ],
    "it": [
      "Offriamo una cucina autentica e un menu stagionale. Venite a scoprire il nostro ristorante in un ambiente unico a Valence, con il suo forno Josper.\r\nIl giovedì e il venerdì, Le Petit Clos è il locale da scoprire dopo il lavoro a Lautagne!"
    ],
    "fr": [
      "Nous vous proposons une cuisine authentique et une carte de saison. Venez découvrir notre restaurant dans un décor unique à Valence avec son four Josper. \r\nLe jeudi et le vendredi, le Petit Clos est LE lieu d’afterwork à découvrir au plus vite à Lautagne !"
    ],
    "nl": [
      "Wij bieden een authentieke keuken en een seizoensgebonden menu. Kom en ontdek ons restaurant in een uniek kader in Valence, met zijn Josper-oven.\r\nOp donderdag en vrijdag is Le Petit Clos DE plek om na het werk te ontdekken in Lautagne!"
    ],
    "es": [
      "Ofrecemos una cocina auténtica y un menú de temporada. Venga a descubrir nuestro restaurante en un marco único en Valence, con su horno Josper.\r\nLos jueves y viernes, Le Petit Clos es EL lugar afterwork que hay que descubrir en Lautagne"
    ]
  },
