  "rdfs:comment": {
    "de": [
      "Dorf Rauret: Kirche aus dem 13. Jahrhundert mit Kammglockenturm. Jahrhundert, Château de Jagonas aus dem 13. Jahrhundert (privat), Maison forte de Joncherette aus dem 14. Jahrhundert (privat). Viadukt von Arquejols."
    ],
    "en": [
      "Village of Rauret: 13th-century church with combed steeple. Remains of 13th-century Château de Jonchères, 13th-century Château de Jagonas (private), 14th-century Maison forte de Joncherette (private). Arquejols viaduct."
    ],
    "it": [
      "Villaggio di Rauret: chiesa del XIII secolo con campanile a pettine. Resti del castello di Jonchères del XIII secolo, del castello di Jagonas del XIII secolo (privato), della casa fortificata di Joncherette del XIV secolo (privato). Viadotto di Arquejols."
    ],
    "fr": [
      "Village de Rauret : Église du XIIIe siècle à clocher peigne. Vestiges du château de Jonchères du XIIIe siècle, château de Jagonas du XIIIe siècle (privé), maison forte de Joncherette du XIVe siècle (privé). Viaduc d’Arquejols."
    ],
    "es": [
      "Pueblo de Rauret: iglesia del siglo XIII con campanario peinado. Restos del castillo de Jonchères del siglo XIII, castillo de Jagonas del siglo XIII (privado), casa fortificada de Joncherette del siglo XIV (privada). Viaducto de Arquejols."
    ],
    "nl": [
      "Dorp Rauret: 13e-eeuwse kerk met gekamde klokkentoren. Overblijfselen van het kasteel van Jonchères uit de 13e eeuw, kasteel van Jagonas uit de 13e eeuw (privé), versterkte woning van Joncherette uit de 14e eeuw (privé). Viaduct van Arquejols."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Rauret"
    ]
  },
