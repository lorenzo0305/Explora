  "rdfs:comment": {
    "de": [
      "Schnellrestaurants am Mittag.\r\nBar-Tabak, kleiner Lebensmittelladen.\r\nEtappenunterkunft in der Nähe, Abendessen mit Halbpension für die Bewohner der Unterkunft vom 01/04 bis 30/09."
    ],
    "en": [
      "Fast food at lunchtime.\r\nBar-tobacco shop, small grocery store.\r\nStopover gite nearby, half-board evening meal for gite guests from 01/04 to 30/09."
    ],
    "it": [
      "Fast food all'ora di pranzo.\r\nBar-tabacchi, piccolo negozio di alimentari.\r\nGite di sosta nelle vicinanze, mezza pensione serale per gli ospiti della gite dal 01/04 al 30/09."
    ],
    "fr": [
      "Restauration rapide à midi.\r\nBar-tabac, Petite épicerie.\r\nGite d'étape à proximité, repas du soir en demi-pension pour les pensionnaires du gîte du 01/04 au 30/09."
    ],
    "nl": [
      "Fast food tijdens de lunch.\r\nBar-tabakswinkel, kleine kruidenierswinkel.\r\nGite met tussenstop in de buurt, avondmaal met halfpension voor gasten van de gite van 01/04 tot 30/09."
    ],
    "es": [
      "Comida rápida a la hora de comer.\r\nBar-tabaco, pequeña tienda de comestibles.\r\nCasa rural cercana, media pensión para los huéspedes de la casa rural del 01/04 al 30/09."
    ]
  },
