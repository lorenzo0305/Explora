  "rdfs:comment": {
    "de": [
      "Dinoplagne trägt das Label \"Espace Naturel Sensible\" und beherbergt die längste Spur von Titanosaurierspuren der Welt!\r\nFür den Besuch der Stätte wird eine Reservierung im Voraus empfohlen."
    ],
    "en": [
      "Labeled Sensitive Natural Area, Dinoplagne is home to the longest track of dinosaur footprints in the world!\r\nAdvance reservation is recommended to visit the site."
    ],
    "it": [
      "Etichettata come Area Naturale Sensibile, Dinoplagne ospita la più lunga traccia di impronte di titanosauro al mondo!\r\nPer visitare il sito si consiglia la prenotazione anticipata."
    ],
    "fr": [
      "Labellisé Espace Naturel Sensible, Dinoplagne abrite la plus longue piste d'empreintes de titanosaure au monde !\r\nLa réservation en amont est recommandée pour visiter le site."
    ],
    "nl": [
      "Dinoplagne is een kwetsbaar natuurgebied en herbergt het langste spoor van voetafdrukken van titanosaurussen ter wereld!\r\nVooraf reserveren is aanbevolen om de site te bezoeken."
    ],
    "es": [
      "Catalogado como Espacio Natural Sensible, Dinoplagne alberga el rastro de huellas de titanosaurio más largo del mundo\r\nSe recomienda reservar con antelación para visitar el yacimiento."
    ]
  },
