  "rdfs:comment": {
    "de": [
      "Grafische Kreationen auf Kieselsteinen. Einzigartige Modelle. Dekorationsobjekte für Innen und Außen, Gesellschafts- und Lernspiele. Werbeobjekte für Fachleute.\r\nLeitung von Workshops für bildende Kunst, Kinder, Familien."
    ],
    "en": [
      "Graphic creations on pebbles. Unique models. Indoor and outdoor decorative objects, board games, educational games. Promotional items for professionals.\r\nArt workshops for children and families."
    ],
    "it": [
