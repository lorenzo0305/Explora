  "rdfs:comment": {
    "de": [
      "Die Epicerie Pop mit ihrer idealen Lage ist ein originelles Konzept aus Teestube, Geschenkboutique und Feinkostladen mit Verkostung vor Ort. Frühstück, Sonntagsbrunch, Imbiss, Aperitif! Profitieren Sie von der ruhigen und schattigen Terrasse."
    ],
    "en": [
      "L’Epicerie Pop is an original concept combining a tea room with gift shop and delicatessen, with the possibility to sample products while you're there. Breakfast, brunches on Sunday, snacks and aperitifs! Don't miss the peaceful, shaded terrace."
    ],
    "it": [
      "Collocata in posizione ideale, l'Epicerie Pop è un locale innovativo: sala da tè, boutique di regali e specialità gastronomiche con degustazione sul posto.  Colazione, brunch la domenica, spuntino, aperitivo! Approfitta dei tavoli all'aperto sulla terrazza calma e ombreggiata."
    ],
    "fr": [
      "Idéalement située, l’Epicerie Pop est un concept original, salon de thé, boutique de cadeaux et épicerie fine avec dégustation sur place. Petit-déjeuner, brunch le dimanche, collation, apéritif ! Profitez de la terrasse calme et ombragée."
    ],
    "es": [
      "La Épicerie Pop, muy bien situada, es un concepto original que combina salón de té, tienda de regalos y tienda gourmet con degustación. Ofrecemos desayunos, brunchs los domingos, tentempiés y aperitivos. Además, disponemos de una tranquila terraza con sombra."
    ],
    "nl": [
      "Ideaal gelegen, de Epicerie Pop is een origineel concept, theesalon, cadeauwinkel en delicatessenwinkel met proeverij ter plaatse. Ontbijt, brunch op zondag, snacks, aperitief! Profiteer van het rustige en schaduwrijke terras."
    ]
  },
