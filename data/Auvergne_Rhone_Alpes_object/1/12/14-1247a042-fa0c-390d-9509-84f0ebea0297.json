      "dc:description": {
        "de": [
          "Ausstellung \"La Publicité s'invite à l'Hôpital\" vom 12. bis 17. April täglich von 10 bis 18 Uhr\nRDV im Saal des Hotels La Terrasse (rue Gabriel Péri)\nFreier Eintritt - organisiert von der Société d'Histoire des Hôpitaux de Berck (Geschichtsverein der Krankenhäuser von Berck)"
        ],
        "en": [
          "Exhibition \"La Publicité s'invite à l'Hôpital\" from April 12 to 17, daily from 10am to 6pm\nRDV at the Salle de l'Hôtel La Terrasse (rue Gabriel Péri)\nFree admission - organized by the Société d'Histoire des Hôpitaux de Berck"
        ],
        "it": [
          "Mostra \"La Publicité s'invite à l'Hôpital\" dal 12 al 17 aprile, tutti i giorni dalle 10.00 alle 18.00\nPunto d'incontro presso la Salle de l'Hôtel La Terrasse (rue Gabriel Péri)\nIngresso libero - organizzato dalla Société d'Histoire des Hôpitaux de Berck"
        ],
        "fr": [
          "Exposition \" La Publicité s'invite à l'Hôpital\" du 12 au 17 avril tous les jours de 10h à 18h \nRDV à la Salle de l'Hôtel La Terrasse (rue Gabriel Péri) \nEntrée Libre - organisée par la Société d'Histoire des Hôpitaux de Berck"
        ],
        "nl": [
          "Tentoonstelling \"La Publicité s'invite à l'Hôpital\" van 12 tot 17 april elke dag van 10u tot 18u\nTrefpunt in de Salle de l'Hôtel La Terrasse (rue Gabriel Péri)\nGratis toegang - georganiseerd door de Société d'Histoire des Hôpitaux de Berck"
        ],
        "es": [
          "Exposición \"La Publicité s'invite à l'Hôpital\" del 12 al 17 de abril todos los días de 10.00 a 18.00 horas\nPunto de encuentro en la Salle de l'Hôtel La Terrasse (rue Gabriel Péri)\nEntrada gratuita - organizado por la Société d'Histoire des Hôpitaux de Berck"
        ]
      },
