  "rdfs:comment": {
    "de": [
      "Entdecken Sie einige Kilometer von Aubenas entfernt die Basis Canyon de la Besorgues: Aktivitäten in Flüssen oder in der freien Natur (Canyoning, Höhlenforschung, Klettersteig, Klettern usw.), die für alle Altersgruppen geeignet sind und von professionellen Führern betreut werden."
    ],
    "en": [
      "A few miles from Aubenas, come and discover \"la base Canyon de la Besorgues\" : guided activities in rivers or in wilderness (canyoning, speleology, via ferrata, climbing, ...) for all ages and with professionals."
    ],
    "it": [
      "A pochi chilometri da Aubenas, scoprite la base del canyon di Besorgues: fiume e attività all'aperto (canyoning, speleologia, via ferrata, arrampicata, ecc.) adatte a tutte le età e seguite da guide professioniste."
    ],
    "fr": [
      "A quelques kilomètres d’Aubenas, découvrez  la base Canyon de la Besorgues : activités en rivières ou en pleine nature (canyoning, spéléologie, via-ferrata, escalade, etc) adaptées à tous publics et encadrées par des guides professionnels."
    ],
    "nl": [
      "Op enkele kilometers van Aubenas kunt u de basis van Canyon de la Besorgues ontdekken: activiteiten in de rivier of midden in de natuur (canyoning, speleologie, via ferrata, klimmen, enz.), aangepast aan elke bezoeker en onder toezicht van professionele gidsen."
    ],
    "es": [
      "A pocos kilómetros de Aubenas, descubra la base del cañón de Besorgues: río y actividades al aire libre (barranquismo, espeleología, vía ferrata, escalada, etc.) aptas para todas las edades y supervisadas por guías profesionales."
    ]
  },
