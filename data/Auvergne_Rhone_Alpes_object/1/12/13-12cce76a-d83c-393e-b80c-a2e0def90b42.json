  "rdfs:comment": {
    "de": [
      "Vulkanorgeln sind sechseckige Prismen, die durch die Abkühlung des Lavastroms senkrecht zu seiner Oberfläche entstanden sind."
    ],
    "en": [
      "Volcanic organs are hexagonal prisms formed by the cooling of a lava flow perpendicular to its surface."
    ],
    "it": [
      "Gli organi vulcanici sono prismi esagonali che si formano quando le colate laviche si raffreddano perpendicolarmente alla loro superficie."
    ],
    "fr": [
      "Les orgues volcaniques sont des prismes hexagonaux issus du refroidissement de la coulée de lave perpendiculairement à sa surface."
    ],
    "nl": [
      "Vulkaanorganen zijn zeshoekige prisma's die gevormd worden wanneer lavastromen loodrecht op hun oppervlak afkoelen."
    ],
    "es": [
      "Los órganos volcánicos son prismas hexagonales que se forman cuando las coladas de lava se enfrían perpendicularmente a su superficie."
    ]
  },
  "rdfs:label": {
