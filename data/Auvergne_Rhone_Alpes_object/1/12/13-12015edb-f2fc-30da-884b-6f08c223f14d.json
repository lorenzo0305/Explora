  "rdfs:comment": {
    "de": [
      "Die Tour du Bois de Lion ist ein Rundkurs zur Einführung in den Trail in der Nähe des Zentrums von Montélimar. Die kleine Schleife verläuft ganz im Unterholz und wechselt zwischen den verschiedenen Geländearten, die man beim Trailrunning vorfinden kann."
    ],
    "en": [
      "The Tour du Bois de Lion is an introductory trail loop just a stone's throw from the center of Montélimar. Set in undergrowth, the short loop alternates between the different types of terrain you'd expect to find on a trail."
    ],
    "it": [
      "Il Tour du Bois de Lion è un percorso introduttivo a due passi dal centro di Montélimar. Immerso nel sottobosco, il breve percorso alterna i diversi tipi di terreno che si possono trovare su un sentiero."
    ],
    "fr": [
      "Le Tour du Bois de Lion est une boucle d'initiation au trail à deux pas du centre de Montélimar. Tout en sous-bois, la petite boucle alterne les variétés de terrains que l'on peut retrouver en trail."
    ],
    "es": [
      "El Tour du Bois de Lion es un circuito de iniciación al senderismo situado a dos pasos del centro de Montélimar. En medio de la maleza, este corto circuito alterna los diferentes tipos de terreno que se pueden encontrar en un sendero."
    ],
    "nl": [
      "De Tour du Bois de Lion is een inleidende wandelroute op een steenworp afstand van het centrum van Montélimar. Deze korte lus in het kreupelhout is een afwisseling van de verschillende soorten terrein die je op een pad kunt vinden."
    ]
  },
  "rdfs:label": {
