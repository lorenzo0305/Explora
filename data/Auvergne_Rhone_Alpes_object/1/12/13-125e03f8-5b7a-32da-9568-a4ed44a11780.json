  "rdfs:comment": {
    "de": [
      "Die GAEC des Rocs ist ein Betrieb mit Milchkühen der Rasse Montbéliarde.\r\nHerstellung von Käse wie dem \"Roc\" oder dem \"Brique\".\r\nVerkauf auf dem Bauernhof (nach Vereinbarung).\r\nVerkauf auf dem Markt in Saugues am Freitagmorgen und auf dem Markt in Langeac am Donnerstagmorgen."
    ],
    "en": [
      "The GAEC des Rocs is a dairy farm with Montbéliarde cows.\r\nProduces cheeses such as \"Roc\" and \"Brique\".\r\nSales at the farm (by appointment).\r\nSales at the Saugues market on Friday mornings and at the Langeac market on Thursday mornings."
    ],
    "it": [
      "Il GAEC des Rocs è un'azienda lattiero-casearia con vacche Montbéliarde.\r\nProduce formaggi come il \"Roc\" e la \"Brique\".\r\nVendita presso la fattoria (su appuntamento).\r\nVendita al mercato di Saugues il venerdì mattina e al mercato di Langeac il giovedì mattina."
    ],
    "fr": [
      "Le GAEC des Rocs est une exploitation de vaches laitières de race montbéliarde.\r\nFabrication de fromages tels le \"Roc\" ou la \"Brique\".\r\nVente à la ferme (sur rendez-vous).\r\nVente au Marché de Saugues le vendredi matin et à celui de Langeac le jeudi matin."
    ],
    "es": [
      "El GAEC des Rocs es una explotación lechera con vacas Montbéliarde.\r\nElabora quesos como el \"Roc\" y el \"Brique\".\r\nVenta en la granja (con cita previa).\r\nVenta en el mercado de Saugues los viernes por la mañana y en el mercado de Langeac los jueves por la mañana."
    ],
    "nl": [
      "De GAEC des Rocs is een melkveebedrijf met Montbéliarde koeien.\r\nMaakt kazen zoals \"Roc\" en \"Brique\".\r\nVerkoop op de boerderij (op afspraak).\r\nVerkoop op de markt van Saugues op vrijdagochtend en op de markt van Langeac op donderdagochtend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rocs (GAEC des)"
    ]
  },
