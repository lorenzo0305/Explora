  "rdfs:comment": {
    "de": [
      "Wir sind Produzenten von roten und schwarzen Beerenfrüchten \"perles Rouges et Noires du Velay\". Erdbeeren, Brombeeren, Himbeeren, schwarze Johannisbeeren... werden mit Leidenschaft in 1060 m Höhe angebaut."
    ],
    "en": [
      "We grow red and black berries known as \"perles Rouges et Noires du Velay\". Strawberries, blackberries, raspberries, blackcurrants, redcurrants... are grown with passion, at an altitude of 1060 meters."
    ],
    "it": [
      "Coltiviamo bacche rosse e nere conosciute come \"perles Rouges et Noires du Velay\". Fragole, more, lamponi, ribes nero, ribes rosso... sono coltivati con passione a 1060 metri di altitudine."
    ],
    "fr": [
      "Nous sommes producteurs de petits fruits rouges et noirs \"perles Rouges et Noires du Velay\". Fraise, mûre, framboise, cassis, groseille... sont cultivés avec passion, à 1060 mètres d'altitude."
    ],
    "nl": [
      "We telen rode en zwarte bessen die bekend staan als \"perles Rouges et Noires du Velay\". Aardbeien, bramen, frambozen, zwarte bessen, rode bessen... worden met passie geteeld op een hoogte van 1060 meter."
    ],
    "es": [
      "Cultivamos bayas rojas y negras conocidas como \"perles Rouges et Noires du Velay\". Fresas, moras, frambuesas, grosellas negras, grosellas rojas... se cultivan con pasión a 1060 metros de altitud."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Douceurs de Fruits Rouges"
    ]
  },
