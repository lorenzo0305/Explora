  "rdfs:comment": {
    "de": [
      "Das Bistrot Savoyard, eine Bergbrauerei an der Schneefront von Vallandry, empfängt Sie täglich von 8:30 bis 19:00 Uhr. \r\nDie Sonnenterrasse und der beheizte Innenraum sind den ganzen Tag über für Ihre stärkenden Pausen geöffnet."
    ],
    "en": [
      "The Bistrot Savoyard is a mountain brasserie on the Vallandry snow front, open every day from 8.30am to 7pm. \r\nIts sunny terrace and heated indoor dining room are open all day for your comforting breaks."
    ],
    "it": [
      "Il Bistrot Savoyard è una brasserie di montagna sul fronte della neve di Vallandry, aperta tutti i giorni dalle 8.30 alle 19.00.\r\nLa terrazza soleggiata e la sala interna riscaldata sono aperte tutto il giorno per le vostre pause di benessere"
    ],
    "fr": [
      "Brasserie de montagne située sur le front de neige de Vallandry, le Bistrot Savoyard vous accueille tous les jours de 8h30 à 19h. \r\nSa terrasse ensoleillée ainsi que sa salle intérieure chauffée sont ouvertes toute la journée pour vos pauses réconfortantes"
    ],
    "es": [
      "El Bistrot Savoyard es una brasserie de montaña situada en el frente nevado de Vallandry, abierta todos los días de 8h30 a 19h00.\r\nSu terraza soleada y su comedor interior climatizado están abiertos todo el día para sus reconfortantes pausas"
    ],
    "nl": [
      "De Bistrot Savoyard is een bergbrasserie op het sneeuwfront van Vallandry, elke dag geopend van 8.30 tot 19.00 uur.\r\nHet zonnige terras en de verwarmde eetzaal binnen zijn de hele dag geopend voor een verkwikkende pauze"
    ]
  },
  "rdfs:label": {
