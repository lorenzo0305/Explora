  "rdfs:comment": {
    "de": [
      "Ausgewogene Mahlzeiten mit qualitativ hochwertigen Gerichten. Ein super Service und dazu noch sehr erschwingliche Preise. Eine unumgängliche Etappe 1 km von Aurillac entfernt..."
    ],
    "en": [
      "We offer a wide choice of healthy dishes using high quality ingredients. We are just 1 km out of Aurillac town centre, and you will enjoy our exceptional service and good value offers."
    ],
    "it": [
      "Pasti ben equilibrati con piatti di qualità. Ottimo servizio e prezzi molto convenienti. Una tappa imperdibile a 1 km da Aurillac..."
    ],
    "fr": [
      "Repas équilibrés avec des plats de qualité. Un super service et en plus des tarifs très abordables. Une étape incontournable à 1km d'Aurillac..."
    ],
    "nl": [
      "Evenwichtige maaltijden met kwaliteitsgerechten. Geweldige service en zeer betaalbare prijzen. Een niet te missen tussenstop op 1km van Aurillac..."
    ],
    "es": [
      "Comidas sanas con platos de calidad. Un gran servicio y también con precios muy asequibles. Una parada esencial en Aurillac ..."
    ]
