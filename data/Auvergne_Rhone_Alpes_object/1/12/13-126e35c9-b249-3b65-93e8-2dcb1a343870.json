  "rdfs:comment": {
    "de": [
      "Lust auf eine schnelle und leckere Mahlzeit? Kebab Antalya empfängt Sie in Saint-Marcellin mit einem Angebot an Speisen vor Ort oder zum Mitnehmen: Kebab, Sandwiches, Teller, Pommes frites und Getränke, in einer einfachen und freundlichen Atmosphäre."
    ],
    "en": [
      "Looking for a quick, gourmet meal? Kebab Antalya welcomes you to Saint-Marcellin with a range of on-site and takeaway food: kebabs, sandwiches, plates, French fries and drinks, in a simple, friendly atmosphere."
    ],
    "it": [
      "Cercate un pasto veloce e gustoso? Kebab Antalya vi dà il benvenuto a Saint-Marcellin con un'offerta di cibo da asporto e in loco: kebab, panini, piatti, patatine e bevande, in un'atmosfera semplice e amichevole."
    ],
    "fr": [
      "Envie d’un repas rapide et gourmand ? Kebab Antalya vous accueille à Saint-Marcellin avec une offre de restauration sur place ou à emporter : kebabs, sandwichs, assiettes, frites et boissons, dans une ambiance simple et conviviale."
    ],
    "es": [
      "¿Busca una comida rápida y sabrosa? Kebab Antalya le da la bienvenida en Saint-Marcellin con una oferta de comida para llevar y para comer in situ: kebabs, bocadillos, platos, patatas fritas y bebidas, en un ambiente sencillo y acogedor."
    ],
    "nl": [
      "Op zoek naar een snelle, smakelijke maaltijd? Kebab Antalya verwelkomt je in Saint-Marcellin met een assortiment afhaalmaaltijden en eten ter plekke: kebab, broodjes, schotels, friet en drankjes, in een eenvoudige, vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Antalya"
    ]
  },
