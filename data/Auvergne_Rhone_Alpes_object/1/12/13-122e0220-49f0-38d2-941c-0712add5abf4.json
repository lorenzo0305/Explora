  "rdfs:comment": {
    "de": [
      "Lassen Sie sich auf einer der schönsten und größten Terrassen in Lyon nieder! Mit Blick auf die Ufer der Rhône bietet dieses Lokal einzigartige Sonnenuntergänge über Fourvière und im Winter ein musikalisches Unterhaltungsprogramm"
    ],
    "en": [
      "Take a seat on one of the most beautiful and largest terraces in Lyon! Overlooking the banks of the Rhône, this establishment offers unique sunsets over Fourvière, or a program of musical entertainment in winter…"
    ],
    "it": [
      "Accomodatevi su una delle più grandi e belle terrazze di Lione! Affacciata sulle rive del Rodano, questa struttura offre tramonti unici su Fourvière o un programma di intrattenimento musicale in inverno?"
    ],
    "fr": [
      "Installez-vous sur l’une des plus belles et grandes terrasses de Lyon ! Surplombant les berges du Rhône, cet établissement offre des couchers de soleil uniques sur Fourvière, ou un programme d’animations musicales en hiver…"
    ],
    "es": [
      "Siéntese en una de las terrazas más grandes y bellas de Lyon Con vistas a las orillas del Ródano, este establecimiento ofrece unas puestas de sol únicas sobre Fourvière, o un programa de animación musical en invierno?"
    ],
    "nl": [
      "Neem plaats op een van de grootste en mooiste terrassen van Lyon! Dit etablissement kijkt uit over de oevers van de Rhône en biedt unieke zonsondergangen over Fourvière, of een programma met muzikale animatie in de winter?"
    ]
  },
