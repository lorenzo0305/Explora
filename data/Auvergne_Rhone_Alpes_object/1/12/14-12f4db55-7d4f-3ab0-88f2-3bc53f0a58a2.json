  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6dc44e1-5e4b-369b-be68-e5320bb815ee",
      "dc:description": {
        "de": [
          "Start: Montreuil (Esplanade de la Citadelle)\n6 km - 1,5 Std. - Kompliziert bei Regen\nDieser reizvolle Weg erinnert an die Vergangenheit von Montreuil, einer alten Hafenstadt am Ende der Mündung der Canche, zur Zeit der kapetingischen Dynastie. Er führt durch die Unterstadt und die Sumpfgebiete."
        ],
        "en": [
          "Start : Montreuil (Esplanade de la Citadelle)\n6km - 1h30 - Difficult in wet weather\nThis charming trail evokes the past of Montreuil, an ancient port city at the head of the Canche estuary, during the Capetian dynasty. It crosses the lower town and the marshes."
        ],
        "it": [
          "Partenza : Montreuil (Esplanade de la Citadelle)\n6 km - 1h30 - Difficile in caso di pioggia\nQuesto affascinante percorso rievoca il passato di Montreuil, antica città portuale all'estremità dell'estuario della Canche, durante la dinastia capetingia. Attraversa la città bassa e le paludi."
        ],
        "fr": [
          "Départ : Montreuil (Esplanade de la Citadelle)\n6km - 1h30 - Compliqué par temps de pluie\nCe charmant parcours évoque le passé de Montreuil, ancienne cité portuaire située au fond de l'estuaire de la Canche, du temps de la dynastie capétienne. Il traverse la ville basse et les marais."
        ],
        "nl": [
          "Start : Montreuil (Esplanade de la Citadelle)\n6 km - 1u30 - Moeilijk bij nat weer\nDit charmante pad roept het verleden op van Montreuil, een oude havenstad aan het einde van de Canche-monding, ten tijde van de Capetiaanse dynastie. De route doorkruist de benedenstad en de moerassen."
        ],
        "es": [
          "Salida : Montreuil (Esplanade de la Citadelle)\n6km - 1h30 - Difícil con tiempo húmedo\nEste encantador sendero evoca el pasado de Montreuil, antigua ciudad portuaria al final del estuario del Canche, durante la dinastía de los Capetos. Atraviesa la parte baja de la ciudad y las marismas."
        ]
      },
