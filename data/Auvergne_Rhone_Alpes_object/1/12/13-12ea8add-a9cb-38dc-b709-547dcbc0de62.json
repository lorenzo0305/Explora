  "rdfs:comment": {
    "de": [
      "Willkommen bei Guillaume, Pierre und Cécile Durdilly, einem familiengeführten Weingut im Beaujolais des Pierres Dorées\r\nEmpfang im Weinkeller, Vorstellung des Weinguts und Verkostung (auf Französisch und Englisch). Auf Reservierung."
    ],
    "en": [
      "Welcome to Guillaume, Pierre and Cécile Durdilly's family wine estate in the Beaujolais des Pierres Dorées. \r\nWelcome to the cellar, presentation of the estate and tasting (in French and English). On reservation."
    ],
    "it": [
      "Benvenuti nell'azienda vinicola di famiglia di Guillaume, Pierre e Cécile Durdilly, nel Beaujolais des Pierres Dorées\r\nAccoglienza in cantina, presentazione della tenuta e degustazione (in francese e inglese). Solo su prenotazione."
    ],
    "fr": [
      "Bienvenue chez Guillaume, Pierre et Cécile Durdilly, domaine viticole familial du Beaujolais des Pierres Dorées. \r\nAccueil au caveau, présentation du domaine et dégustation (en français et en anglais). Sur réservation."
    ],
    "nl": [
      "Welkom op het familiewijngoed van Guillaume, Pierre en Cécile Durdilly in de Beaujolais des Pierres Dorées\r\nOntvangst in de kelder, presentatie van het landgoed en proeverij (in het Frans en Engels). Alleen op reservering."
    ],
    "es": [
      "Bienvenido a la finca familiar de Guillaume, Pierre y Cécile Durdilly en el Beaujolais des Pierres Dorées\r\nRecepción en la bodega, presentación de la finca y degustación (en francés e inglés). Sólo con reserva."
    ]
  },
