  "rdfs:comment": {
    "de": [
      "Direkt am Seeufer, empfangen Sie mit eine raffinierte und reichliche Küche. Fischspezialitäten aus dem See. Familienessen und Gruppenessen am Genfer See . Mögliche Zugang mit dem Schiff."
    ],
    "en": [
      "Feet in the water, discover a sophisticated and generous cuisine. Specialities of fishes of the lake. Meal of family and groups in a Leman frame. Possible access by boat."
    ],
    "it": [
      "Con i piedi nell'acqua, scoprite una cucina raffinata e generosa. Specialità di pesce di lago. Pasti in famiglia e di gruppo in un ambiente del lago di Ginevra. Accesso possibile in barca."
    ],
    "fr": [
      "Les pieds dans l'eau, découvrez une cuisine raffinée et généreuse. Spécialités de poissons du lac. Repas de famille et de groupes dans un cadre lémanique. Accès possible par bateau."
    ],
    "nl": [
      "Met je voeten in het water ontdek je een verfijnde en gulle keuken. Meer visspecialiteiten. Gezins- en groepsmaaltijden aan het meer van Genève. Toegang per boot."
    ],
    "es": [
      "Con los pies en el agua, descubra una cocina refinada y generosa. Especialidades de pescado del lago. Comidas familiares y de grupo en el entorno del lago de Ginebra. Acceso posible en barco."
    ]
  },
