  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen in einem intimen Rahmen Gerichte, die mit Leidenschaft zubereitet werden. Eine Speisekarte, die sich den Jahreszeiten anpasst und regelmäßig erneuert wird."
    ],
    "en": [
      "The restaurant offers you dishes cooked with passion in an intimate setting. A menu that adapts to the seasons and is renewed regularly."
    ],
    "it": [
      "Il ristorante offre piatti cucinati con passione in un ambiente intimo. Un menu che si adatta alle stagioni e viene rinnovato regolarmente."
    ],
    "fr": [
      "Le restaurant vous propose dans un cadre intimiste  des plats mijotés avec passion. Une carte qui s’adapte au fil des saisons renouvelée régulièrement."
    ],
    "nl": [
      "Het restaurant biedt u met passie gekookte gerechten in een intiem kader. Een menu dat zich aanpast aan de seizoenen en regelmatig wordt vernieuwd."
    ],
    "es": [
      "El restaurante le ofrece platos cocinados con pasión en un ambiente íntimo. Un menú que se adapta a las estaciones y se renueva regularmente."
    ]
  },
