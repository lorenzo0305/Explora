  "rdfs:comment": {
    "de": [
      "Erleben Sie die Berge anders mit Snocool? Ski- & Snowboardschule in Tignes le Lac, Val Claret, Lavachet, Tignes 1800 und Tignes les Brévières. Fun-Kurse, flexibel und für alle geeignet, vom Anfänger bis zum Freerider."
    ],
    "en": [
      "Experience the mountains differently with Snocool? ski & snowboard school in Tignes le Lac, Val Claret, Lavachet, Tignes 1800 and Tignes les Brévières. Fun, flexible lessons for everyone, from beginners to freeriders."
    ],
    "it": [
      "Vivete la montagna in modo diverso con la scuola di sci e snowboard Snocool? a Tignes le Lac, Val Claret, Lavachet, Tignes 1800 e Tignes les Brévières. Lezioni divertenti e flessibili per tutti, dai principianti ai freerider."
    ],
    "fr": [
      "Vivez la montagne autrement avec Snocool — école de ski & snowboard à Tignes le Lac, Val Claret, Lavachet, Tignes 1800 et Tignes les Brévières. Cours fun, flexibles et adaptés à tous, du débutant au freerider."
    ],
    "es": [
      "Vive la montaña de forma diferente con la escuela de esquí y snowboard Snocool? en Tignes le Lac, Val Claret, Lavachet, Tignes 1800 y Tignes les Brévières. Clases divertidas y flexibles para todos, desde principiantes hasta freeriders."
    ],
    "nl": [
      "Ervaar de bergen op een andere manier met de Snocool? ski & snowboardschool in Tignes le Lac, Val Claret, Lavachet, Tignes 1800 en Tignes les Brévières. Leuke, flexibele lessen voor iedereen, van beginners tot freeriders."
    ]
