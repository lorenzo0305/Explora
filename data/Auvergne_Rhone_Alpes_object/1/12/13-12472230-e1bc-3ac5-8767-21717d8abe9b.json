  "rdfs:comment": {
    "de": [
      "Betrieb mit 70 Ziegen der Rasse Alpine Chamoisée mit Direktverkauf von Rohmilchkäse (Frischkäse, gereifter Käse, gepresster Teig, Weichkäse). \r\nMit dem AB BIO-Siegel ausgezeichnet.\r\nFreier Zugang zum Melken ab 17:30 Uhr an den Öffnungstagen."
    ],
    "en": [
      "Farm with 70 Alpine chamois goats and direct sales of raw milk cheeses (fromage frais, ripened, hard and soft cheeses). \r\nCertified AB BIO (Organic).\r\nEveryone can watch the milking from 5.30pm on opening days."
    ],
    "it": [
      "Azienda agricola con 75 capre camosciate di montagna e vendita diretta di formaggi a latte crudo intero (freschi, stagionati, pressati e a pasta molle) e prodotti caseari.\r\nCertificato AB BIO\r\nAccesso libero alla mungitura intorno alle 17.30 nei giorni di apertura del negozio"
    ],
    "fr": [
      "Exploitation de 75 chèvres de race alpine chamoisée avec vente directe de fromages au lait cru entier (fromages frais, affinés, pâte pressée, pâtes molles) et laitages. \r\nLabellisé AB BIO\r\nAccès libre à la traite vers 17h30 les jours d'ouverture du magasin"
    ],
    "es": [
      "Granja con 75 cabras gamuzas alpinas y venta directa de quesos enteros de leche cruda (frescos, madurados, prensados y blandos) y productos lácteos.\r\nCertificado AB BIO\r\nAcceso gratuito al ordeño hacia las 17.30 h los días de apertura de la tienda"
    ],
    "nl": [
      "Boerderij met 75 alpengeiten en directe verkoop van volle rauwmelkse kazen (verse, gerijpte, geperste en zachte kazen) en zuivelproducten.\r\nGecertificeerd AB BIO\r\nGratis toegang tot het melken rond 17.30 uur op openingsdagen van de winkel"
    ]
  },
  "rdfs:label": {
