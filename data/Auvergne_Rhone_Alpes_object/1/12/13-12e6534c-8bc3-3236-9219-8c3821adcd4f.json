  "rdfs:comment": {
    "de": [
      "Das Grand Hôtel de Paris im Herzen von Villard-de-Lans lädt seine Gäste ein, seine herrliche Lage umgeben von einem 3 Ha. großen eigenen Park zu genießen: Whirlpool & Wellness-Center („Sothys“), Restaurant mit Gütesiegel „Maître Restaurateur\" (Meister der Gastronomie)."
    ],
    "en": [
      "The Grand Hôtel de Paris in the heart of Villard de Lans, invites you to enjoy its breath-takingsetting: 3-hectare private park, spa, \"Sothys\" wellness space,and “Maître Restaurateur\" restaurant"
    ],
    "it": [
      "Il Grand Hôtel de Paris, nel cuore di Villard de Lans, vi invita ad approfittare del suo ambiente mozzafiato: un parco privato di tre ettari, la spa, l'area benessere \"Sothys\" e un ristorante con il marchio \"Maître Restaurateur\"."
    ],
    "fr": [
      "Le Grand Hôtel de Paris, au coeur de Villard de Lans, vous invite à profiter de son environnement époustouflant : parc privatif de trois hectares, spa, espace bien être \" Sothys\", restaurant labellisé \" Maître Restaurateur\"."
    ],
    "nl": [
      "Het Grand Hôtel de Paris, in het hart van Villard de Lans, nodigt u uit om te profiteren van zijn adembenemende omgeving: een privépark van drie hectare, spa, wellnessruimte \"Sothys\" en een restaurant met het label \"Maître Restaurateur\"."
    ],
    "es": [
      "El Grand Hôtel de Paris, en el corazón de Villard de Lans, le invita a disfrutar de su impresionante entorno: un parque privado de tres hectáreas, spa, zona de bienestar \"Sothys\" y un restaurante con la etiqueta \"Maître Restaurateur\"."
    ]
  },
  "rdfs:label": {
