  "rdfs:comment": {
    "de": [
      "Mit seinem atemberaubenden Blick auf den Mont-Blanc und seiner Terrasse am Ufer des Biotopsees bietet Alexperience eine warme und einladende Atmosphäre in einer zauberhaften Umgebung."
    ],
    "en": [
      "With its breathtaking view of Mont-Blanc, its terrace on the lake biotope, Alexperience offers a warm and welcoming atmosphere in an enchanting setting."
    ],
    "it": [
      "Con la sua vista mozzafiato sul Monte Bianco e la terrazza sul lago biotopo, l'Alexperience offre un'atmosfera calda e accogliente in un ambiente incantevole."
    ],
    "fr": [
      "Avec sa vue imprenable sur le Mont-Blanc, sa terrasse au bord du lac biotope, Alexperience offre une atmosphère chaleureuse et accueillante dans un cadre enchanteur."
    ],
    "nl": [
      "Met een adembenemend uitzicht op de Mont Blanc en een terras aan het biotoopmeer biedt Alexperience een warme en gastvrije sfeer in een betoverende omgeving."
    ],
    "es": [
      "Con sus impresionantes vistas del Mont-Blanc, su terraza junto al lago biotopo, Alexperience ofrece un ambiente cálido y acogedor en un entorno encantador."
    ]
  },
