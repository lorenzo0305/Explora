  "rdfs:comment": {
    "de": [
      "L'Armoire à Cuillers bietet in Crémieu eine hausgemachte, kreative und saisonale mediterrane Küche aus lokalen und Bio-Produkten. Die regelmäßig wechselnde Speisekarte bietet auch vegetarische Gerichte. Gemütliches Ambiente und schattige Terrasse."
    ],
    "en": [
      "L’Armoire à Cuillers in Crémieu offers creative, seasonal Mediterranean cuisine made from local, organic produce. The menu, which is updated regularly, also includes vegetarian dishes. Enjoy the cosy atmosphere and shaded terrace."
    ],
    "it": [
      "L'Armoire à Cuillers di Crémieu propone una cucina mediterranea creativa, stagionale e casalinga, con prodotti locali e biologici. Il menu, che cambia regolarmente, comprende anche piatti vegetariani, un'atmosfera accogliente e una terrazza ombreggiata."
    ],
    "fr": [
      "L’Armoire à Cuillers propose à Crémieu une cuisine méditerranéenne maison, créative et de saison, à base de produits locaux et bio. La carte, renouvelée régulièrement, propose également des plats végétariens, ambiance cosy et terrasse ombragée."
    ],
    "es": [
      "L'Armoire à Cuillers, en Crémieu, sirve cocina mediterránea creativa, de temporada y casera, elaborada con productos locales y ecológicos. El menú, que cambia regularmente, también incluye platos vegetarianos, un ambiente acogedor y una terraza a la sombra."
    ],
    "nl": [
      "L'Armoire à Cuillers in Crémieu serveert creatieve, seizoensgebonden, huisgemaakte mediterrane gerechten met lokale en biologische producten. Het regelmatig wisselende menu bevat ook vegetarische gerechten, een gezellige sfeer en een schaduwrijk terras."
    ]
  },
