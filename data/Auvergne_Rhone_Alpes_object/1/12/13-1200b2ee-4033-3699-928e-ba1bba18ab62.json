  "rdfs:comment": {
    "de": [
      "Seit 2006 von der Familie Gorini geführt, entdecken Sie hier ein Restaurant mit einer schmackhaften, überraschenden und eleganten Küche auf 2500m Höhe für eine einzigartige Auszeit in Naturgröße."
    ],
    "en": [
      "Run by the Gorini family since 2006, this is a restaurant offering tasty, surprising and elegant cuisine at an altitude of 2500m, for a unique, nature-sized break."
    ],
    "it": [
      "Gestito dalla famiglia Gorini dal 2006, è un ristorante che offre una cucina gustosa, sorprendente ed elegante a 2.500 metri di altitudine, per una pausa unica e a misura di vita."
    ],
    "fr": [
      "Tenu par la famille Gorini depuis 2006, découvrez ici un restaurant avec une cuisine savoureuse, surprenante et élégante à 2500m d’altitude pour une parenthèse unique, grandeur nature."
    ],
    "nl": [
      "Dit restaurant wordt sinds 2006 gerund door de familie Gorini en biedt smakelijke, verrassende en elegante gerechten op een hoogte van 2.500 m, voor een unieke, levensgrote pauze."
    ],
    "es": [
      "Dirigido por la familia Gorini desde 2006, se trata de un restaurante que ofrece una cocina sabrosa, sorprendente y elegante a 2.500 m de altitud, para una escapada única y a la altura de la vida."
    ]
  },
