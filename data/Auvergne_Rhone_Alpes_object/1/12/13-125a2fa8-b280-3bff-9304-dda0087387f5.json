  "rdfs:comment": {
    "de": [
      "Als Bergbegleiter, Führer des Kulturerbes Savoie Mont Blanc und Vermittler des UNESCO Global Geoparks Chablais bietet Maxime sowohl Spaziergänge zum Kulturerbe als auch Wanderungen abseits der ausgetretenen Pfade im Chablais-Massiv an."
    ],
    "en": [
      "A mountain guide, Savoie Mont Blanc Heritage Guide and UNESCO Chablais Geopark mediator, Maxime offers both heritage walks and off-the-beaten-track hikes in the Chablais massif."
    ],
    "it": [
      "Guida alpina, Guida del Patrimonio della Savoia Mont Blanc e mediatore del Geoparco dello Chablais dell'UNESCO, Maxime propone sia passeggiate nel patrimonio che escursioni fuori dai sentieri battuti nel massiccio dello Chablais."
    ],
    "fr": [
      "Accompagnateur en montagne, Guide du Patrimoine Savoie Mont Blanc et médiateur du Géoparc mondial UNESCO du Chablais, Maxime propose aussi bien des des balades patrimoniales que des randonnées hors des sentiers battus dans le massif du Chablais."
    ],
    "nl": [
      "Maxime is berggids, gids voor het erfgoed van de Savoie Mont Blanc en bemiddelaar in het UNESCO Chablais Geopark. Hij biedt zowel wandelingen over het erfgoed als wandelingen buiten de gebaande paden in het Chablais massief."
    ],
    "es": [
      "Guía de montaña, guía del patrimonio de Saboya Mont-Blanc y mediador del Geoparque del Chablais de la UNESCO, Maxime propone tanto paseos por el patrimonio como excursiones fuera de los caminos trillados del macizo del Chablais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maxime Gay"
    ]
  },
