  "rdfs:comment": {
    "de": [
      "Dieses Estaminet befindet sich in einem alten, typisch flämischen Bauernhaus. Betreten Sie den großen Saal, in dem Cochonnaille-Gerichte, Schwein am Spieß, Geflügel... serviert werden."
    ],
    "en": [
      "This estaminet is located in a typical Flemish farmhouse. Enter in the big room where are served dishes of pork, pig on the spit, poultries..."
    ],
    "it": [
      "Questo ristorante si trova in una tipica casa colonica fiamminga. Entrate nell'ampia sala da pranzo dove potrete gustare piatti a base di maiale, maiale allo spiedo, pollame..."
    ],
    "fr": [
      "Cet estaminet est situé dans un ancien corps de ferme typiquement flamand. Entrez dans la grande salle où sont servis plats de cochonnailles, cochon à la broche, volailles..."
    ],
    "es": [
      "Este estaminet se encuentra en una típica granja flamenca. Entre en el gran comedor donde podrá degustar platos de cerdo, cerdo al asador, aves..."
    ],
    "nl": [
      "Dit estaminet is gevestigd in een typisch Vlaamse boerderij. Kom binnen in de grote eetzaal waar u kunt genieten van gerechten met varkensvlees, varkens aan het spit, gevogelte..."
    ]
  },
