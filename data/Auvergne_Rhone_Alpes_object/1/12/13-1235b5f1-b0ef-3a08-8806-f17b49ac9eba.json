  "rdfs:comment": {
    "de": [
      "Sie wurden in den 1880er Jahren in einer Kurve mit einem Radius von hundert Metern und einer Rampe von fünfundzwanzig Promille gebaut und stellen zwei Glanzstücke des Tiefbaus auf der Eisenbahnstrecke des Petit Train de La Mure dar."
    ],
    "en": [
      "Built during the 1880's in a curve of one hundred meters in radius and on a slope of twenty-five per thousand, they constitute two jewels of civil engineering on the railway line of le Petit Train de la Mure"
    ],
    "it": [
      "Costruiti negli anni 1880 in curva di 100m di raggio e in penta di 25 per mille, costituiscono due gioielli dell'ingegneria civile sulla linea ferroviaria del Petit Train de La Mure."
    ],
    "fr": [
      "Construits dans les années 1880 en courbe de cent mètres de rayon et en rampe de vingt-cinq pour mille, ils constituent deux fleurons du Génie civil sur la ligne de chemin de fer du Petit Train de La Mure."
    ],
    "nl": [
      "Ze werden gebouwd in 1880 met een boog van honderd meter en een helling van vijfentwintig per duizend en zijn twee van de juwelen in de kroon van de civiele bouwkunde van de Petit Train de La Mure-spoorlijn."
    ],
    "es": [
      "Construidas en la década de 1880 con una curva de cien metros de radio y una pendiente del veinticinco por mil, son dos de las joyas de la ingeniería civil de la línea ferroviaria del Petit Train de La Mure."
    ]
  },
  "rdfs:label": {
