  "rdfs:comment": {
    "de": [
      "Der Küchenchef Jérémie Delhomme und sein mobiles Restaurant begleiten Sie bei Ihren privaten und geschäftlichen Veranstaltungen mit einer traditionellen, aber auch modernen Küche. Seine Originalität ermöglicht es ihm, sowohl Streetfood als auch Tellergerichte zu berühren."
    ],
    "en": [
      "Chef Jérémie Delhomme and his mobile restaurant will accompany you on your private and professional events with traditional yet modern cuisine. His originality enables him to offer street-food as well as plated dishes."
    ],
    "it": [
      "Lo chef Jérémie Delhomme e il suo ristorante mobile saranno a disposizione per soddisfare i vostri eventi privati e aziendali, offrendo una cucina tradizionale e moderna. Grazie alla sua originalità, lo chef si trova a suo agio anche con lo street food e i taglieri."
    ],
    "fr": [
      "Le chef Jérémie Delhomme et son restaurant mobile vous accompagnent pour vos évènements privés et professionnels avec une cuisine traditionnelle mais aussi moderne. Son originalité lui permet de toucher aussi bien au street-food qu'à l'assiette."
    ],
    "es": [
      "El Chef Jérémie Delhomme y su restaurante móvil estarán a su disposición para sus eventos privados y de negocios, ofreciendo cocina tradicional y moderna. Gracias a su originalidad, se siente igual de cómodo con la comida callejera que con los platos combinados."
    ],
    "nl": [
      "Chef-kok Jérémie Delhomme en zijn mobiele restaurant staan klaar voor uw privé- en bedrijfsevenementen en bieden zowel traditionele als moderne gerechten. Dankzij zijn originaliteit is hij even goed thuis in streetfood als in schotels."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au P'tit Ampuisais"
    ]
  },
