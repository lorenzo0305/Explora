  "rdfs:comment": {
    "de": [
      "Sich Zeit nehmen, um gut zu leben...\r\nGourmet-Benchmark auf dem Versant du Soleil, wo Authentizität und Geselligkeit um einen Tisch herum geteilt werden."
    ],
    "en": [
      "Taking the time to enjoy life...\r\nA gourmet address on the Versant du Soleil, where authenticity and conviviality reign at the table."
    ],
    "it": [
      "Prendersi il tempo per vivere bene?\r\nUn punto di riferimento gastronomico sul Versant du Soleil, dove autenticità e convivialità sono condivise intorno a un tavolo."
    ],
    "fr": [
      "Prendre le temps de bien vivre…\r\nRepère gourmand sur le Versant du Soleil, où authenticité et convivialité se partagent autour d’une table."
    ],
    "es": [
      "¿Tomarse tiempo para vivir bien?\r\nUn punto de referencia gastronómico en el Versant du Soleil, donde la autenticidad y la convivencia se comparten en torno a una mesa."
    ],
    "nl": [
      "De tijd nemen om van het leven te genieten...\r\nEen gastronomisch herkenningspunt aan de Versant du Soleil, waar authenticiteit en gezelligheid rond de tafel worden gedeeld."
    ]
  },
