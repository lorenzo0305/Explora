  "rdfs:comment": {
    "de": [
      "Im MY Restaurant erwartet Sie ein herzlicher Empfang. Im Herzen des Dorfes Villard de Lans in einem familiären Rahmen! Entdecken Sie unsere traditionelle Bergküche in einer geselligen Atmosphäre."
    ],
    "en": [
      "A warm welcome awaits you at MY Restaurant. In the heart of the village of Villard de Lans in a family atmosphere! Come and discover our traditional mountain cuisine in a friendly atmosphere."
    ],
    "it": [
      "Un caloroso benvenuto vi attende al MY Restaurant. Nel cuore del villaggio di Villard de Lans, in un ambiente familiare! Venite a scoprire la nostra cucina tradizionale di montagna in un'atmosfera amichevole."
    ],
    "fr": [
      "Un accueil chaleureux vous attend au MY Restaurant. Au cœur du village de Villard de Lans dans un cadre familial ! Venez découvrir notre cuisine traditionnelle montagnarde dans une ambiance conviviale."
    ],
    "es": [
      "Una cálida bienvenida le espera en MY Restaurant. En el corazón del pueblo de Villard de Lans, en un ambiente familiar Venga a descubrir nuestra cocina tradicional de montaña en un ambiente acogedor."
    ],
    "nl": [
      "Een warm welkom wacht op u bij MY Restaurant. In het hart van het dorp Villard de Lans in een familiale sfeer! Kom en ontdek onze traditionele bergkeuken in een vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
