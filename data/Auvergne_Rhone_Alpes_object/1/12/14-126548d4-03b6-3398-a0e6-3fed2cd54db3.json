  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a5ca99db-8b5c-3eb9-bcbb-1fff5a9382a7",
      "dc:description": {
        "de": [
          "Gemischte und kostenlose Kurse für alle Altersgruppen.\nFörderung der körperlichen Bewegung: Gymnastik, Wandern. Montag: 14.30-15.30-18.30 Uhr. Fr. 15.30-18.00 Uhr.\nGleichgewicht und Wohlbefinden: 11-12 Uhr Montag und Freitag. Mitgliedsbeitrag: 18?/Jahr. Wanderungen Mittwoch RDV 13.15 Uhr Abfahrt 13.30 Uhr Parkplatz Salle P. Monthuy."
        ],
        "en": [
          "Free mixed classes for all ages.\nPromotion of physical exercise: gymnastics, walking. Monday: 2:30-3:30-6:30 pm. Fri. 3.30pm and 6pm.\nBalance and well-being: 11 a.m.-12 p.m. Mondays and Fridays. Membership: 18?/year. Wednesday hikes RDV 13h15 dep. 13h30 parking salle P. Monthuy."
        ],
        "it": [
          "Corsi misti gratuiti per tutte le età.\nPromozione dell'esercizio fisico: ginnastica, passeggiate. Lunedì: 14.30-15.30-18.30. Ven. 15.30 e 18.00.\nEquilibrio e benessere: lunedì e venerdì, ore 11-12. Iscrizione: 18€/anno. Passeggiate del mercoledì RDV 13h15 dép. 13h30 parking salle P. Monthuy."
        ],
        "fr": [
          "Cours mixtes et gratuits tout âge. \nPromotion de la pratique de l’exercice physique : gymnastique, marche. Lundi : 14h30-15h30-18h30. Vend. 15h30 et 18h.\nÉquilibre et bien-être : 11h à 12h lundi et vend. Cotisation : 18€/an. Randonnées mercredi RDV 13h15 dép. 13h30 parking salle P. Monthuy."
        ],
        "nl": [
          "Gratis gemengde lessen voor alle leeftijden.\nBevordering van lichaamsbeweging: gymnastiek, wandelen. Maandag: 14.30 - 15.30 - 18.30 uur. Vrij. 15.30 en 18.00 uur.\nBalans en welzijn: 11.00-12.00 uur op maandag en vrijdag. Lidmaatschap: 18 euro/jaar. Woensdag wandelingen RDV 13u15 dép. 13u30 parking zaal P. Monthuy."
        ],
        "es": [
          "Clases mixtas gratuitas para todas las edades.\nPromoción del ejercicio físico: gimnasia, marcha. Lunes: 14.30-15.30-18.30 h. Vie. 15.30 y 18.00 h.\nEquilibrio y bienestar: lunes y viernes de 11.00 a 12.00 h. Abono: 18 euros/año. Miércoles paseos RDV 13h15 dép. 13h30 parking salle P. Monthuy."
        ]
      },
