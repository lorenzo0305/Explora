  "rdfs:comment": {
    "de": [
      "Die 2025 in Samoëns installierte Clévieux-Brücke ist ein Fußgängerbauwerk, das den Clévieux, einen Nebenfluss des Giffre, überquert. Die Brücke wurde von Pegorier Charpente gebaut und bietet einen schönen Ausblick auf den Criou, einen symbolträchtigen Berg mit einer dreieckigen Silhouette."
    ],
    "en": [
      "Installed in 2025 in Samoëns, the Clévieux footbridge is a pedestrian structure crossing the Clévieux, a tributary of the Giffre. Built by Pegorier Charpente, it offers a fine view of Le Criou, an emblematic mountain with a triangular silhouette."
    ],
    "it": [
      "Installata nel 2025 a Samoëns, la passerella di Clévieux è una struttura pedonale che attraversa il Clévieux, un affluente del Giffre. Costruita da Pegorier Charpente, offre una splendida vista su Le Criou, una montagna emblematica dalla silhouette triangolare."
    ],
    "fr": [
      "Installée en 2025 à Samoëns, la passerelle du Clévieux est un ouvrage piéton franchissant le Clévieux, affluent du Giffre. Réalisée par Pegorier Charpente, elle offre un beau point de vue sur Le Criou, montagne emblématique à la silhouette triangulaire."
    ],
    "es": [
      "Instalada en 2025 en Samoëns, la pasarela Clévieux es una estructura peatonal que cruza el Clévieux, afluente del Giffre. Construida por Pegorier Charpente, ofrece una hermosa vista de Le Criou, montaña emblemática de silueta triangular."
    ],
    "nl": [
      "De voetgangersbrug Clévieux, geïnstalleerd in 2025 in Samoëns, is een voetgangersstructuur over de Clévieux, een zijrivier van de Giffre. De brug is gebouwd door Pegorier Charpente en biedt een prachtig uitzicht op Le Criou, een emblematische berg met een driehoekig silhouet."
    ]
  },
