  "rdfs:comment": {
    "de": [
      "Au Piano des couleurs ist ein einzigartiger Raum in der Haute Loire, der dem freien Ausdruck gewidmet ist. Hier malen Kinder und Erwachsene ohne vorgeschriebenes Thema oder Modell in einem wohlwollenden und respektvollen Rahmen."
    ],
    "en": [
      "Au Piano des couleurs is a unique space in the Haute Loire dedicated to free expression, where children and adults alike can paint without a set theme or model, in a caring and respectful environment."
    ],
    "it": [
      "Au Piano des couleurs è uno spazio unico nell'Alta Loira dedicato alla libera espressione, dove bambini e adulti dipingono senza un tema o un modello prestabilito, in un ambiente attento e rispettoso."
    ],
    "fr": [
      "Au Piano des couleurs est un espace unique en Haute Loire dédié à l’expression libre, où enfants et adultes peignent sans thème imposé ni modèle, dans un cadre bienveillant et respectueux."
    ],
    "nl": [
      "Au Piano des couleurs is een unieke ruimte in de Haute Loire gewijd aan vrije expressie, waar kinderen en volwassenen schilderen zonder vast thema of model, in een zorgzame en respectvolle omgeving."
    ],
    "es": [
      "Au Piano des couleurs es un espacio único en el Alto Loira dedicado a la libre expresión, donde niños y adultos pintan sin tema ni modelo fijo, en un ambiente afectuoso y respetuoso."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L' Atelier d'art: \"Au piano des couleurs\""
    ]
  },
