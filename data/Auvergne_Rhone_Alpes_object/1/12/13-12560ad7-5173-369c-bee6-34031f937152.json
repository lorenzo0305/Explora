  "rdfs:comment": {
    "de": [
      "Die Mediathek stellt folgende Bücher zur Verfügung: Romane, Sachbücher, Bücher in Großdruck? Kinder- und Jugendliteratur: Romane, Alben und Comics; Spiele; CDs und DVDs; lokale Zeitungen und Jugendzeitschriften sowie Computerarbeitsplätze."
    ],
    "en": [
      "The media library offers: novels, non-fiction books, large-print books... Children's literature: novels, albums and comics; games; CDs and DVDs; local and specialist children's press; and computer workstations."
    ],
    "it": [
      "La biblioteca multimediale offre: romanzi, libri di saggistica, libri a caratteri grandi, ecc Letteratura per l'infanzia: romanzi, album e fumetti; giochi; CD e DVD; stampa locale e specializzata per bambini, oltre a postazioni informatiche."
    ],
    "fr": [
      "La médiathèque met à disposition : romans, ouvrages documentaires, livres en gros caractère… Littérature jeunesse : romans, albums et bandes dessinées; jeux ;CD et DVD; presse locale et presse spécialisée jeunesse ainsi que des postes informatiques."
    ],
    "es": [
      "La biblioteca multimedia ofrece: novelas, libros de no ficción, libros en letra grande, etc Literatura infantil: novelas, álbumes y cómics; juegos; CD y DVD; prensa infantil local y especializada, así como puestos informáticos."
    ],
    "nl": [
      "De mediatheek biedt: romans, non-fictieboeken, boeken met grote opdruk, enz Kinderliteratuur: romans, albums en stripverhalen; spelletjes; cd's en dvd's; lokale en gespecialiseerde kinderpers, evenals computerwerkplekken."
    ]
  },
  "rdfs:label": {
