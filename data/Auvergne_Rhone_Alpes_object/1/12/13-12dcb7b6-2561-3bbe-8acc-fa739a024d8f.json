  "rdfs:comment": {
    "de": [
      "Das Hotel der Hotelschule begrüßt Sie während der Schulzeit von montags bis freitags. Es wurde 2007 vollständig renoviert und ist nun elegant und hochmodern eingerichtet."
    ],
    "en": [
      "Discover our educational hotel, offering 30 rooms designed for your comfort, from classic rooms with lake and mountain views to spacious suites."
    ],
    "it": [
      "L'Hotel didattico del liceo alberghiero vi accoglie nel periodo scolastico dal lunedì al venerdì. Interamente rinnovato nel 2007, è ben arredato con decorazioni high-tech."
    ],
    "fr": [
      "Découvrez notre hôtel pédagogique, offrant 30 chambres conçues pour votre confort, qu'il s'agisse de chambres classiques, avec vue sur le lac et les montagnes, ou de suites spacieuses."
    ],
    "nl": [
      "Ontdek ons educatieve hotel, met 30 kamers ontworpen voor jouw comfort, van klassieke kamers met uitzicht op het meer en de bergen tot ruime suites."
    ],
    "es": [
      "Descubra nuestro hotel educativo, que ofrece 30 habitaciones diseñadas pensando en su comodidad, desde habitaciones clásicas con vistas al lago y las montañas hasta amplias suites."
    ]
  },
