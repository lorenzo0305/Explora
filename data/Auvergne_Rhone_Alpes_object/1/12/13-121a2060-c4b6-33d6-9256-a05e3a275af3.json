  "rdfs:comment": {
    "de": [
      "Treten Sie ein in die Welt von Christophe, Schmied und Messermacher, und entdecken Sie sein Angebot an Messern, die vor Ort in seiner Werkstatt aus Materialien wie Holz, Stein und Knochen hergestellt werden. Er organisiert auch Kurse in seiner Werkstatt."
    ],
    "en": [
      "Enter the world of Christophe, blacksmith and knifemaker, and discover his range of knives made on site in his workshop from materials such as wood, stone and bone. He also organises courses in his workshop."
    ],
    "it": [
      "Entrate nel mondo di Christophe, fabbro e coltellinaio, e scoprite la sua gamma di coltelli realizzati in loco nel suo laboratorio con materiali come legno, pietra e osso. Organizza anche corsi nel suo laboratorio."
    ],
    "fr": [
      "Entrez dans l'univers de Christophe, forgeron coutelier et découvrez sa gamme de couteaux fabriqués sur place dans son atelier à partir de matières comme le bois, la pierre, ou encore l'os. Il organise des stages dans son atelier."
    ],
    "nl": [
      "Treed binnen in de wereld van Christophe, smid en messenmaker, en ontdek zijn assortiment messen die ter plekke in zijn werkplaats worden gemaakt van materialen als hout, steen en bot. Hij organiseert ook cursussen in zijn werkplaats."
    ],
    "es": [
      "Entre en el mundo de Christophe, herrero y cuchillero, y descubra su gama de cuchillos fabricados in situ en su taller a partir de materiales como la madera, la piedra y el hueso. También organiza cursos en su taller."
    ]
  },
