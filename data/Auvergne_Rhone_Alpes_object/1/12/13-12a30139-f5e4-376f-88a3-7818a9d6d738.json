  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf den Weg in die Stadt der Erfinder, um der Natur zu entfliehen. Von Saint-Marcel-lès-Annonay aus fahren Sie in Richtung Annonay."
    ],
    "en": [
      "Head to the city of inventors for an escape into the heart of nature. From Saint-Marcel-lès-Annonay, climb up towards Annonay."
    ],
    "it": [
      "Dirigetevi verso la città degli inventori per una fuga nel cuore della natura. Da Saint-Marcel-lès-Annonay, si sale verso Annonay."
    ],
    "fr": [
      "Direction la cité des inventeurs pour une échappée en pleine nature. Depuis Saint-Marcel-lès-Annonay, prenez de la hauteur en direction d’Annonay."
    ],
    "nl": [
      "Ga naar de stad van de uitvinders voor een ontsnapping naar het hart van de natuur. Klim vanuit Saint-Marcel-lès-Annonay omhoog richting Annonay."
    ],
    "es": [
      "Diríjase a la ciudad de los inventores para una escapada al corazón de la naturaleza. Desde Saint-Marcel-lès-Annonay, suba en dirección a Annonay."
    ]
  },
  "rdfs:label": {
