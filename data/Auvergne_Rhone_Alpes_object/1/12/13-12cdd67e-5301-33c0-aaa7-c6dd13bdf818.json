  "rdfs:comment": {
    "de": [
      "Kreation, Herstellung, Restaurierung, Einrichtung aus Holz. Einführungspraktika in das Drechseln von Holz. Herstellung von Gegenständen, Möbeln, Utensilien, Spielen auf Bestellung. Ungewöhnliche Konstruktionen: Kuppeln, Kuppeln, Hütten, Unterstände."
    ],
    "en": [
      "Wood design, manufacture, restoration and fittings. Introductory woodturning courses. Custom-made objects, furniture, utensils and games. Unusual constructions: zomes, domes, huts, shelters."
    ],
    "it": [
      "Progettazione, produzione, restauro e allestimento del legno. Corsi introduttivi di tornitura del legno. Oggetti, mobili, utensili e giochi su misura. Costruzioni insolite: zomi, cupole, capanne, rifugi."
    ],
    "fr": [
      "Création, fabrication, restauration, aménagement en bois. Stages initiation tournage sur bois. Réalisation d'objets, de meubles, d'ustensiles, de jeux sur commande. Constructions insolites : zômes, dômes, cabanes, abris."
    ],
    "nl": [
      "Houtontwerp, vervaardiging, restauratie en toebehoren. Inleidende cursussen houtdraaien. Op maat gemaakte voorwerpen, meubels, gebruiksvoorwerpen en spellen. Ongebruikelijke constructies: zomes, koepels, hutten, schuilplaatsen."
    ],
    "es": [
      "Diseño, fabricación, restauración y equipamiento de madera. Cursos de iniciación al torneado de madera. Objetos, muebles, utensilios y juegos a medida. Construcciones insólitas: zomes, cúpulas, cabañas, refugios."
    ]
  },
  "rdfs:label": {
