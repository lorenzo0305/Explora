  "rdfs:comment": {
    "de": [
      "L'Orée Fest, am Fuße des neuen Jandri, ist die festliche After-Ski-Party von 16 bis 19 Uhr!\r\nBier, Wein, Champagner, DJ-Sets und gute Laune stehen auf dem Programm!"
    ],
    "en": [
      "L'Orée Fest, at the foot of the new Jandri, is the festive après-ski from 4 p.m. to 7 p.m.!\r\nBeers, wine, champagne, DJ sets & good vibes on the program!"
    ],
    "it": [
      "L'Orée Fest, ai piedi del nuovo Jandri, è l’après-ski festoso dalle 16 alle 19!\r\nBirre, vini, champagne, DJ set e tanta allegria in programma!"
    ],
    "fr": [
      "L'Orée Fest, au pied du nouveau Jandri, c’est l’after ski festif de 16h à 19h !\r\nBières, vins, champagne, DJ sets & bonne humeur au programme !"
    ],
    "es": [
      "L'Orée Fest, al pie del nuevo Jandri, es el after-ski festivo de 16:00 a 19:00 horas\r\nCervezas, vino, champán, sesiones de DJ y mucha diversión"
    ],
    "nl": [
      "L'Orée Fest, aan de voet van de nieuwe Jandri, is de feestelijke après-ski van 16u tot 19u!\r\nBier, wijn, champagne, dj-sets en veel plezier!"
    ]
  },
