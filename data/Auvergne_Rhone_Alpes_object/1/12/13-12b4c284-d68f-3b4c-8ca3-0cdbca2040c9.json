  "rdfs:comment": {
    "de": [
      "Yllar montagne organisiert deine Aktivitäten, lustig, kooperativ in der Gruppe. Unsere Herausforderung? Sie zum Lachen zu bringen, mit 16 oder 200 Personen, bei einer erstaunlichen Murder Party, einer neu erfundenen Olympiade, einem lustigen Koh-Lanta oder einer Entdeckungsrallye."
    ],
    "en": [
      "Yllar montagne organises your fun, cooperative group activities. Our challenge? To make you laugh, whether you're 16 or 200, at an amazing Murder Party, a reinvented Olympiad, a funnier version of Koh-Lanta or a discovery rally."
    ],
    "it": [
      "Yllar montagne organizza le vostre attività di gruppo divertenti e cooperative. La nostra sfida? Farvi ridere, che abbiate 16 o 200 anni, con un sorprendente Murder Party al Castello di Avully, alcune delle Olimpiadi più fantasiose..."
    ],
    "fr": [
      "Yllar montagne organise vos activités, drôles, coopératives en groupe. Notre challenge ? Vous faire rire, à 16 comme à 200, sur une Murder Party étonnante au Château d'Avully, des olympiades des plus réinventées..."
    ],
    "es": [
      "Yllar montagne organiza tus actividades de grupo, divertidas y cooperativas. ¿Nuestro reto? Hacerte reír, tengas 16 o 200 años, con una sorprendente Murder Party en el Château d'Avully, unas Olimpiadas de lo más imaginativas..."
    ],
    "nl": [
      "Yllar montagne organiseert jouw leuke, coöperatieve groepsactiviteiten. Onze uitdaging? Om je aan het lachen te maken, of je nu 16 of 200 bent, met een verbazingwekkende Murder Party in het Château d'Avully, enkele van de meest fantasierijke Olympiades..."
    ]
  },
