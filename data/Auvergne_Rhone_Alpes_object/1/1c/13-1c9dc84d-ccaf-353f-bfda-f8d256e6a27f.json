  "rdfs:comment": {
    "de": [
      "Primeur, Feinkostladen, Tageszeitung und regionale Produkte im Stadtzentrum, aufgespürt von Léa und Alexis. Hier finden Sie eine große Auswahl an ausgewähltem Obst und Gemüse von den besten Erzeugern der Region."
    ],
    "en": [
      "Primeur, delicatessen, daily produce and regional products in the heart of town, unearthed by Léa and Alexis. You'll find a wide selection of fruit and vegetables from the region's best growers."
    ],
    "it": [
      "Primeur, salumeria, prodotti di giornata e regionali in pieno centro città, trovata da Léa e Alexis. Troverete un'ampia scelta di frutta e verdura selezionata dai migliori produttori della regione."
    ],
    "fr": [
      "Primeur, épicerie fine, quotidienne et produits régionaux en plein centre ville, dénichés par Léa et Alexis. Vous trouverez un large choix de fruits et légumes sélectionnés en provenance des meilleurs producteurs de la région."
    ],
    "nl": [
      "Primeur, delicatessenzaak, dagelijkse producten en regionale producten in het centrum van de stad, gevonden door Léa en Alexis. Je vindt er een ruime keuze aan groenten en fruit van de beste producenten uit de regio."
    ],
    "es": [
      "Primeur, delicatessen, productos del día y regionales en pleno centro de la ciudad, encontrado por Léa y Alexis. Encontrará un amplio surtido de frutas y verduras seleccionadas entre los mejores productores de la región."
    ]
  },
  "rdfs:label": {
