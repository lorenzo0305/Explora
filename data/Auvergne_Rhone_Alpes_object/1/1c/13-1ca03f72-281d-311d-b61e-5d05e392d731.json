  "rdfs:comment": {
    "de": [
      "La Cour Carrée de Perrier: Ihre Oase der Ruhe in der Auvergne. Am Fuße der Höhlen von Perrier gelegen, öffnet Ihnen La Cour Carrée seine Türen für eine unvergessliche Auszeit. Genießen Sie in unserem Restaurant eine authentische lokale Küche."
    ],
    "en": [
      "La Cour Carrée de Perrier: your haven of peace in the Auvergne. Nestled at the foot of the Perrier caves, La Cour Carrée opens its doors to you for an unforgettable getaway. Enjoy authentic local cuisine in our restaurant."
    ],
    "it": [
      "La Cour Carrée de Perrier: il vostro rifugio di pace in Alvernia. Situata ai piedi delle grotte di Perrier, La Cour Carrée vi apre le porte per una fuga indimenticabile. Gustate l'autentica cucina locale nel nostro ristorante."
    ],
    "fr": [
      "La Cour Carrée de Perrier : votre havre de paix en Auvergne. Nichée au pied des grottes de Perrier, La Cour Carrée vous ouvre ses portes pour une escapade inoubliable. Venez savourer dans notre restaurant une cuisine locale authentique."
    ],
    "nl": [
      "La Cour Carrée de Perrier: uw oase van rust in de Auvergne. Genesteld aan de voet van de grotten van Perrier, opent La Cour Carrée haar deuren voor u voor een onvergetelijk uitje. Geniet van authentieke lokale gerechten in ons restaurant."
    ],
    "es": [
      "La Cour Carrée de Perrier: su remanso de paz en Auvernia. Al pie de las grutas de Perrier, La Cour Carrée le abre sus puertas para una escapada inolvidable. Disfrute de la auténtica cocina local en nuestro restaurante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cour Carrée"
    ]
  },
