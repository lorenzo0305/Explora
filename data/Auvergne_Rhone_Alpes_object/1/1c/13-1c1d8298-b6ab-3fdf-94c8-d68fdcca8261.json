  "rdfs:comment": {
    "de": [
      "Auf 42 ha finden Sie eine Reithalle, 2 Reitplätze, 1 Round Pen, 1 Trail Ranch und 1 Clubhaus.\r\nEntdecken Sie die amerikanische Reitkunst und ihre Disziplinen auf Quarter Horse, Paint Horse und Appalosa, amerikanischen Pferderassen mit außergewöhnlicher Mentalität."
    ],
    "en": [
      "On 42 ha, you'll find 1 riding arena, 2 quarries, 1 round pen, 1 trail ranch and 1 club house.\r\nCome and discover American riding and its disciplines on Quarter Horse, Paint Horse and Appalosa, American horses with extraordinary mental qualities."
    ],
    "it": [
      "Su 42 ettari, troverete 1 scuola di equitazione, 2 arene, 1 recinto per le corse, 1 trail ranch e 1 club house.\r\nVenite a scoprire l'equitazione americana e le sue discipline su Quarter Horse, Paint Horse e Appalosa, cavalli americani dalla mente straordinaria."
    ],
    "fr": [
      "Sur 42 ha, vous trouverez 1 manège, 2 carrières, 1 round pen, 1 trail ranch et 1 club house.\r\nVenez découvrir la monte américaine et ses disciplines sur des Quarter Horse, Paint Horse et Appalosa, chevaux de races Américaine au mental extraordinaire."
    ],
    "nl": [
      "Op 42 ha vind je 1 manege, 2 arena's, 1 round pen, 1 trail ranch en 1 clubhuis.\r\nKom en ontdek het Amerikaanse paardrijden en zijn disciplines op Quarter Horse, Paint Horse en Appalosa, Amerikaanse paarden met buitengewone mentale kwaliteiten."
    ],
    "es": [
      "En 42 ha, encontrará 1 picadero, 2 arenas, 1 corral redondo, 1 rancho de rastreo y 1 casa club.\r\nVenga a descubrir la equitación americana y sus disciplinas en Quarter Horse, Paint Horse y Appalosa, caballos americanos con una mente extraordinaria."
    ]
  },
