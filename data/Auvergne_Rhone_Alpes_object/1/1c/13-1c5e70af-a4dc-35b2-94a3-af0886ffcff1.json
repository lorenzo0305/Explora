  "rdfs:comment": {
    "de": [
      "Die Bäckerei \"L'atelier de Théodine\" bietet gängige Brotsorten, Spezialbrote, Viennoiserie, herzhafte Vorspeisen, Gebäck und Getränke sowie eine schöne Auswahl an regionalen Produkten auf Steinpilzbasis."
    ],
    "en": [
      "The bakery \"L'atelier de Théodine\" offers standard breads, special breads, viennoiseries, savoury starters, pastries and drinks, as well as a wide range of local products based on porcini mushrooms."
    ],
    "it": [
      "Il panificio \"L'atelier de Théodine\" offre pane standard, specialità di pane, pasticceria viennese, antipasti salati, dolci e bevande, oltre a una raffinata gamma di prodotti locali a base di funghi porcini."
    ],
    "fr": [
      "La boulangerie \"L'atelier de Théodine\" propose des pains courants, pains spéciaux, viennoiseries, entrées salées, pâtisseries et boissons ainsi qu'une belle gamme de produits du terroir à base de cèpes."
    ],
    "es": [
      "La panadería \"L'atelier de Théodine\" ofrece panes estándar, especialidades de panadería, bollería, entrantes salados, pasteles y bebidas, así como una exquisita gama de productos locales a base de setas porcini."
    ],
    "nl": [
      "De bakkerij \"L'atelier de Théodine\" biedt standaardbroden, speciale broden, Weens gebak, hartige voorgerechten, gebak en dranken, evenals een mooi assortiment lokale producten op basis van eekhoorntjesbrood."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulangerie \"L'Atelier de Théodine\""
    ]
  },
