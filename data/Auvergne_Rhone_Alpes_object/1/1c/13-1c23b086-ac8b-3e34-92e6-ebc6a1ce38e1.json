  "rdfs:comment": {
    "de": [
      "Erleben Sie eine magische Stunde auf dem See von Annecy! Segeln Sie durch die Alpenlandschaft und beobachten Sie das Ballett der Zugvögel. Ein einzigartiger Moment zwischen unberührter Natur und kristallklarem Wasser, perfekt, um dem Alltag zu entfliehen."
    ],
    "en": [
      "Come aboard for a magical hour on Lake Annecy! Sail through Alpine landscapes and watch the ballet of migratory birds. A unique moment between unspoilt nature and crystal-clear waters, perfect for a peaceful getaway."
    ],
    "it": [
      "Salite a bordo per un'ora magica sul lago di Annecy! Navigate nel cuore delle Alpi e ammirate il balletto degli uccelli migratori. Un momento unico tra natura incontaminata e acque cristalline, perfetto per una fuga tranquilla."
    ],
    "fr": [
      "Embarquez pour une heure magique sur le lac d’Annecy ! Naviguez au cœur des paysages alpins et admirez le ballet des oiseaux migrateurs. Un moment unique entre nature préservée et eaux cristallines, parfait pour s’évader en toute sérénité."
    ],
    "es": [
      "Suba a bordo para disfrutar de una hora mágica en el lago de Annecy Navegue por el corazón de los Alpes y admire el ballet de las aves migratorias. Un momento único entre naturaleza virgen y aguas cristalinas, perfecto para una escapada tranquila."
    ],
    "nl": [
      "Kom aan boord voor een magisch uur op het meer van Annecy! Vaar door het hart van de Alpen en bewonder het ballet van trekvogels. Een uniek moment tussen ongerepte natuur en kristalhelder water, perfect voor een vredig uitje."
    ]
  },
