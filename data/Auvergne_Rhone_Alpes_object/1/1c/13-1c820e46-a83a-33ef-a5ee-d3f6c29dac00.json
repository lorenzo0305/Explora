  "rdfs:comment": {
    "de": [
      "Ausgang Hors les murs: Abfahrt um 18.15 Uhr von Cluses Richtung Malraux scène nationale in Chambéry, um das Schockstück des deutschen Dramatikers Bertolt Brecht zu sehen\r\nAb 14 Jahren."
    ],
    "en": [
      "Hors les murs outing: depart Cluses at 5 p.m. for Malraux scène nationale in Chambéry to see the shock play by German playwright Bertolt Brecht."
    ],
    "it": [
      "Fuori porta: partenza da Cluses alle 18.15 per Malraux scène nationale a Chambéry per assistere alla pièce shock del drammaturgo tedesco Bertolt Brecht\r\nDai 14 anni in su."
    ],
    "fr": [
      "Sortie Hors les murs : départ à 18h15 de Cluses direction Malraux scène nationale de Chambéry pour voir la pièce-choc du dramaturge allemand Bertolt Brecht\r\nÀ partir de 14 ans."
    ],
    "nl": [
      "Buiten de deur: vertrek uit Cluses om 18.15 uur naar Malraux scène nationale in Chambéry om het schokstuk van de Duitse toneelschrijver Bertolt Brecht te zien\r\nVanaf 14 jaar."
    ],
    "es": [
      "Al aire libre: salida de Cluses a las 18.15 h hacia Malraux scène nationale, en Chambéry, para ver la obra de choque del dramaturgo alemán Bertolt Brecht\r\nA partir de 14 años."
    ]
  },
  "rdfs:label": {
