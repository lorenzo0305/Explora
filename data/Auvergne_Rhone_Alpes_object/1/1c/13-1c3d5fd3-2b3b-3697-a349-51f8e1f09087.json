  "rdfs:comment": {
    "de": [
      "Chamonix ist eine internationale und weltweit einzigartige Sehenswürdigkeit und das am leichtesten mit dem Auto erreichbare Reiseziel in großer Höhe."
    ],
    "en": [
      "A unique international site, Chamonix is the most easily accessible high-altitude destination in the world by road."
    ],
    "it": [
      "Sito internazionale unico nel suo genere, Chamonix è la destinazione d'alta quota più facilmente accessibile al mondo."
    ],
    "fr": [
      "Site international et unique au monde, Chamonix est la destination d’altitude la plus facilement accessible par la route."
    ],
    "es": [
      "Sitio internacional único, Chamonix es el destino de gran altitud más fácilmente accesible del mundo."
    ],
