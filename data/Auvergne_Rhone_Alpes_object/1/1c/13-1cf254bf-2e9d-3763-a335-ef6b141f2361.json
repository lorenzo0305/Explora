  "rdfs:comment": {
    "de": [
      "Eine Boutique, die sich auf Damenbekleidung in allen Größen und für alle Körperformen spezialisiert hat. Elise, die über ein Diplom in Modellbau für Mode und Kleidung verfügt, bietet Ihnen maßgeschneiderte Produkte und Stoffverkauf."
    ],
    "en": [
      "Shop specializing in women's clothing of all sizes and for all morphologies. Custom-made products and sale of fabric are offered by Elise, a graduate in fashion design and clothing."
    ],
    "it": [
      "Negozio specializzato in abbigliamento femminile di tutte le taglie e per tutte le morfologie. I prodotti su misura e la vendita di tessuti sono offerti da Elise, che ha un diploma in design di moda e abbigliamento."
    ],
    "fr": [
      "Boutique spécialisée dans les vêtements féminins de toutes tailles et pour toutes morphologies. Des produits crées sur-mesure et vente de tissu vous sont proposés par Elise, diplômée en modélisme des métiers de la mode et vêtements."
    ],
    "nl": [
      "Winkel gespecialiseerd in dameskleding in alle maten en voor alle morfologieën. Maatwerk en verkoop van stoffen worden aangeboden door Elise, die een diploma heeft in modeontwerp en kleding."
    ],
    "es": [
      "Tienda especializada en ropa de mujer de todas las tallas y para todas las morfologías. Elise, diplomada en diseño de moda y confección, ofrece productos a medida y venta de telas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Elise Munnia Couture"
    ]
  },
