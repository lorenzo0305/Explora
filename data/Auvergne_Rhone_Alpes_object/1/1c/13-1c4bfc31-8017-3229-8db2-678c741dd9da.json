  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant\r\nGroße Auswahl an savoyischen Spezialitäten und Fleischgerichten\r\ntäglich außer montags mittags und abends geöffnet\r\nBetriebsferien im Mai und November"
    ],
    "en": [
      "Traditional food"
    ],
    "it": [
      "Ristorante tradizionale\nAmpia scelta di specialità savoiarde e di carne\nAperto tutti i giorni a pranzo e a cena, tranne il lunedì.\nChiuso in maggio e novembre"
    ],
    "fr": [
      "Restaurant traditionnel\r\nLarge choix de spécialités savoyarde et viandes \r\nouvert tous les jours midi et soir sauf le lundi. \r\nFermeture annuelle mai et novembre"
    ],
    "nl": [
      "Traditioneel restaurant\nRuime keuze aan Savoyaardse en vleesspecialiteiten\nDagelijks geopend voor lunch en diner, behalve op maandag.\nGesloten in mei en november"
    ],
    "es": [
      "Restaurante tradicional\r\nAmplia selección de especialidades de carne y de Saboya\r\nabierto todos los días para el almuerzo y la cena, excepto el lunes\r\nCierre anual en mayo y noviembre"
    ]
  },
