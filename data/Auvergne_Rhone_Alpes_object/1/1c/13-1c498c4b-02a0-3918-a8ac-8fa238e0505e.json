  "rdfs:comment": {
    "de": [
      "Die Auberge du Tilleul, 10 Minuten von Issoire und der A75 entfernt, bietet Ihnen eine traditionelle und raffinierte Küche. Catering für alle Ihre Veranstaltungen (Geschäftsessen, etc.)."
    ],
    "en": [
      "The Auberge du Tilleul, located 10 minutes from Issoire and the A75 motorway, offers you a traditional and refined cuisine. Catering activity for all your events (business meals, etc...)."
    ],
    "it": [
      "L'Auberge du Tilleul, situato a 10 minuti da Issoire e dall'autostrada A75, offre una cucina tradizionale e raffinata. Attività di catering per tutti i vostri eventi (pranzi di lavoro, ecc.)."
    ],
    "fr": [
      "L'Auberge du Tilleul, située à 10 minutes d'Issoire et de l'A75, vous propose une cuisine traditionnelle et raffinée. Activité traiteur pour tous vos événements (repas d'affaires, etc...)."
    ],
    "es": [
      "El Auberge du Tilleul, situado a 10 minutos de Issoire y de la autopista A75, ofrece una cocina tradicional y refinada. Actividad de catering para todos sus eventos (comidas de empresa, etc...)."
    ],
    "nl": [
      "De Auberge du Tilleul, gelegen op 10 minuten van Issoire en de A75, biedt een traditionele en verfijnde keuken. Cateringactiviteit voor al uw evenementen (zakendiners, enz...)."
    ]
  },
