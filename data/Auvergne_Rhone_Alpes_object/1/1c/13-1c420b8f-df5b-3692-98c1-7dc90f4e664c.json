          "additionalInformation": {
            "de": [
              "7 Tage die Woche von 11:30 bis 14:30 Uhr und von 18:30 bis 22:30 Uhr (23 Uhr Donnerstag und Freitag, 23:30 Uhr Samstag) geöffnet.\r\nAm 24. Dezember mittags, am 31. Dezember mittags und abends (Reservierung am Abend erforderlich) und am 1. Januar mittags und abends geöffnet."
            ],
            "en": [
              "Open 7 days a week from 11.30am to 2.30pm and from 6.30pm to 10.30pm (11pm Thursday and Friday, 11.30pm Saturday).\r\nOpen on December 24th for lunch, December 31st for lunch and dinner (reservation required in the evening) and January 1st for lunch and dinner."
            ],
            "it": [
              "Aperto 7 giorni su 7 dalle 11.30 alle 14.30 e dalle 18.30 alle 22.30 (23.00 giovedì e venerdì, 23.30 sabato).\r\nAperto a pranzo il 24 dicembre, a pranzo e a cena il 31 dicembre (su prenotazione la sera) e a pranzo e a cena il 1° gennaio."
            ],
            "fr": [
              "Ouvert 7j/7 de 11h30 à 14h30 et de 18h30 à 22h30 (23h jeudi et vendredi, 23h30 samedi).\r\nOuvert le 24 décembre midi, le 31 décembre midi et soir (réservation obligatoire le soir) et le 1er janvier midi et soir."
            ],
            "es": [
              "Abierto los 7 días de la semana de 11.30 a 14.30 y de 18.30 a 22.30 (jueves y viernes a las 23.00 y sábados a las 23.30).\r\nAbierto para el almuerzo el 24 de diciembre, para el almuerzo y la cena el 31 de diciembre (es necesario reservar por la noche) y para el almuerzo y la cena el 1 de enero."
            ],
            "nl": [
              "7 dagen per week geopend van 11.30 tot 14.30 en van 18.30 tot 22.30 (23.00 op donderdag en vrijdag, 23.30 op zaterdag).\r\nGeopend voor lunch op 24 december, voor lunch en diner op 31 december (reserveren 's avonds verplicht) en voor lunch en diner op 1 januari."
            ]
          },
