  "rdfs:comment": {
    "de": [
      "Les Enfants du Rhône ist ein gemütlicher Ort in Condrieu, an dem man in einer herzlichen Atmosphäre eine großzügige Küche, saisonale Produkte und schöne Flaschen genießen kann."
    ],
    "en": [
      "Les Enfants du Rhône is a friendly place in Condrieu where people come to share generous cuisine, seasonal produce and fine wines in a warm atmosphere."
    ],
    "it": [
      "Les Enfants du Rhône è un locale accogliente a Condrieu dove potrete gustare una cucina generosa, prodotti di stagione e vini pregiati in un'atmosfera accogliente."
    ],
    "fr": [
      "Les Enfants du Rhône est un lieu convivial à Condrieu où l’on vient partager une cuisine généreuse, des produits de saison et de belles bouteilles dans une ambiance chaleureuse."
    ],
    "nl": [
      "Les Enfants du Rhône is een gezellige plek in Condrieu waar je in een warme sfeer kunt genieten van een royale keuken, seizoensproducten en heerlijke wijnen."
    ],
    "es": [
      "Les Enfants du Rhône es un lugar acogedor en Condrieu donde podrá disfrutar de una cocina generosa, productos de temporada y buenos vinos en un ambiente cálido."
    ]
  },
  "rdfs:label": {
