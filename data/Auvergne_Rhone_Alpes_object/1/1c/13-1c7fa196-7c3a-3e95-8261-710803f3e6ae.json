  "rdfs:comment": {
    "de": [
      "Im Herzen der Puys-Kette, 8 km vom Puy de Dôme entfernt, kehren Kenner in der Auberge de la Fontaine in Olby ein. Regionale Küche aus der Auvergne: Trüffel, gefüllter Kohl, Schweinsfuß usw."
    ],
    "en": [
      "In the heart of the Chaîne des Puys, 8 km from Puy de Dôme, connoisseurs stop off at the Auberge de la Fontaine in Olby. Local Auvergne cuisine: truffade, stuffed cabbage, pig's trotter, etc."
    ],
    "it": [
      "Nel cuore della Chaîne des Puys, a 8 km dal Puy de Dôme, gli intenditori si fermano all'Auberge de la Fontaine di Olby. Cucina locale dell'Alvernia: truffade, cavoli ripieni, zampone, ecc."
    ],
    "fr": [
      "Au cœur de la chaîne des Puys, à 8 km du puy de Dôme, les connaisseurs s'arrêtent à l'Auberge de la Fontaine à Olby. Cuisine du terroir auvergnate : truffade, chou farci, pied de cochon, etc."
    ],
    "nl": [
      "In het hart van de Chaîne des Puys, op 8 km van de Puy de Dôme, houden fijnproevers halt in de Auberge de la Fontaine in Olby. Plaatselijke keuken uit de Auvergne: truffade, gevulde kool, varkenspoot, enz."
    ],
    "es": [
      "En el corazón de la Chaîne des Puys, a 8 km del Puy de Dôme, los entendidos se detienen en el Auberge de la Fontaine, en Olby. Cocina local de Auvernia: truffade, col rellena, manitas de cerdo, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de la Fontaine"
    ]
  },
