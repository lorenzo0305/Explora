  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet eine große Auswahl an Biografien, Dokumentarfilmen, Comics, Bücher zu Savoyen, Romane, Zeitschriften, Bilderbücher, Märchen, CDs  ... Im Sommer montags Märchenlesungen."
    ],
    "en": [
      "Reservation possible by email : ndb.biblio@gmail.com\r\nThe library offers a wide choice of publications : biographies, documentaries, comic strips, books about Savoie, novels, reviews, albums, stories, audio-CDs…story telling on Mondays during the summer months."
    ],
    "it": [
      "Le prenotazioni possono essere effettuate via e-mail: ndb.biblio@gmail.com\r\nLa biblioteca offre un'ampia scelta di: romanzi, biografie, documentari, fumetti, libri sulla Savoia, riviste, album, racconti, CD, DVD documentari... Racconto il lunedì d'estate."
    ],
    "fr": [
      "Réservation possible par mail : ndb.biblio@gmail.com\r\nLa bibliothèque propose un large choix de: romans, biographies, documentaires, BD, livres sur la Savoie, revues, albums, contes, CD, DVD documentaires... Lecture de contes les lundis en été."
    ],
    "nl": [
      "Reserveren kan per e-mail: ndb.biblio@gmail.com\r\nDe bibliotheek biedt een ruime keuze aan: romans, biografieën, documentaires, strips, boeken over Savoie, tijdschriften, albums, verhalen, cd's, documentaire dvd's... Verhalen vertellen op maandag in de zomer."
    ],
    "es": [
      "Las reservas pueden hacerse por correo electrónico: ndb.biblio@gmail.com\r\nLa biblioteca ofrece una amplia selección de: novelas, biografías, documentales, cómics, libros sobre Saboya, revistas, álbumes, cuentos, CDs, DVDs de documentales... Cuentacuentos los lunes en verano."
    ]
  },
