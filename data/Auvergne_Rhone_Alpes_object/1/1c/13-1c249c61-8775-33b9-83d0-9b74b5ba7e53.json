  "rdfs:comment": {
    "de": [
      "Die Brennerei im Priorat Notre Dame in Reugny kann samstags und sonntags morgens (ab 15 Personen) nur nach Vereinbarung besichtigt werden (Führung).\r\nFreie Besichtigung ohne Rücksicht auf die Anzahl der Besucher von Montag bis Donnerstag."
    ],
    "en": [
      "The distillery at Prieuré Notre Dame in Reugny can be visited (guided tour) by appointment only on Saturday and Sunday mornings (minimum 15 people).\r\nSelf-guided tours from Monday to Thursday."
    ],
    "it": [
      "La distilleria del Prieuré Notre Dame a Reugny può essere visitata (visita guidata) solo su appuntamento il sabato e la domenica mattina (minimo 15 persone).\r\nLe visite non accompagnate sono disponibili dal lunedì al giovedì."
    ],
    "fr": [
      "La distillerie au Prieuré Notre Dame à Reugny se visite (visite guidée) uniquement sur rendez vous les samedis et dimanche matin (à partir de 15 personnes).\r\nVisite libre sans distinction de nombre du lundi au jeudi."
    ],
    "es": [
      "La destilería del Prieuré Notre Dame de Reugny puede visitarse (visita guiada) únicamente con cita previa los sábados y domingos por la mañana (mínimo 15 personas).\r\nLas visitas sin acompañante están disponibles de lunes a jueves."
    ],
    "nl": [
      "De distilleerderij van Prieuré Notre Dame in Reugny kan worden bezocht (rondleiding) op afspraak op zaterdag- en zondagochtend (minimaal 15 personen).\r\nRondleidingen zonder gids zijn beschikbaar van maandag tot en met donderdag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Distillerie de Monsieur Balthazar"
    ]
  },
