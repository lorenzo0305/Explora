  "rdfs:comment": {
    "de": [
      "Relax Léman lädt Sie an den feinen Sandstrand ein, um einen einzigartigen Moment der Entspannung zu erleben. Tretboot, Stand-up-Paddle, Kajak, Liegestuhl und Sonnenschirm können zur Freude aller gemietet werden! Pilates-Paddle und Yogakurse."
    ],
    "en": [
      "Relax Léman invites you to its sandy beach for a unique moment of relaxation. Pedal boats, stand-up paddles, kayaks, deckchairs and parasols are available for hire for everyone's enjoyment! Pilates-paddle and yoga classes."
    ],
    "it": [
      "Il Relax Léman vi invita sulla sua spiaggia di sabbia fine per un momento di relax unico. Pedalò, stand-up paddle, kayak, sedie a sdraio e ombrelloni sono disponibili a noleggio per il divertimento di tutti! Corsi di pilates-paddle e yoga."
    ],
    "fr": [
      "Relax Léman vous invite sur la plage de sable fin pour un moment de détente unique. Pédalo, stand up paddle, kayak, transat et parasol en location pour le plaisir de tous ! Cours de pilates-paddle et de yoga."
    ],
    "nl": [
      "Relax Léman nodigt je uit op zijn fijne zandstrand voor een uniek moment van ontspanning. Waterfietsen, stand-up paddles, kajaks, ligstoelen en parasols zijn te huur voor iedereen! Pilates-peddel en yogalessen."
    ],
    "es": [
      "Relax Léman le invita a su playa de arena fina para disfrutar de un momento de relax único. Pedales, stand-up paddle, kayaks, tumbonas y sombrillas a disposición de todos Clases de pilates-pádel y yoga."
    ]
  },
