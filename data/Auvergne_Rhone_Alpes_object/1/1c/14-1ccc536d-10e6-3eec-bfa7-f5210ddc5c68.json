  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/98bf9e90-f709-3f47-b807-e2b42a799fbb",
      "dc:description": {
        "de": [
          "Begleiten Sie uns auf der dritten Buchmesse, einem außergewöhnlichen literarischen Ereignis, bei dem Autoren, Verleger und Leser zusammenkommen, um die Literatur in all ihren Formen zu feiern."
        ],
        "en": [
          "Join us for the third Salon du Livre, an exceptional literary event bringing together authors, publishers and readers in a celebration of literature in all its forms."
        ],
        "it": [
          "Unitevi a noi per la terza edizione del Salon du Livre, un evento letterario eccezionale che riunisce autori, editori e lettori in una celebrazione della letteratura in tutte le sue forme."
        ],
        "fr": [
          "Rejoignez-nous pour le troisième Salon du Livre, un événement littéraire exceptionnel qui réunira auteurs, éditeurs et lecteurs dans une célébration de la littérature sous toutes ses formes."
        ],
        "es": [
          "Únase a nosotros en la tercera edición del Salon du Livre, un acontecimiento literario excepcional que reúne a autores, editores y lectores en una celebración de la literatura en todas sus formas."
        ],
        "nl": [
          "Kom naar de derde Salon du Livre, een uitzonderlijk literair evenement dat auteurs, uitgevers en lezers samenbrengt in een viering van literatuur in al haar vormen."
        ]
      },
