  "rdfs:comment": {
    "de": [
      "Eine über 3,6 km lange \"No Kill\"-Fliegenfischerroute, die die Wiedervernässung der Fische fördert. Eine funktionale und natürliche Route, die einen patrimonialen Managementansatz in den Vordergrund stellt, mit einem mediterranen Zebra-Stamm."
    ],
    "en": [
      "A \"No Kill\" fly fishing route of over 3.6 kilometers, promoting the release of fish back into the water. A functional and natural course, emphasizing a heritage approach to management, hosting a Mediterranean striped stock."
    ],
    "it": [
      "Un percorso \"No Kill\" per la pesca a mosca di oltre 3,6 km, che incoraggia il ritorno dei pesci in acqua. Un percorso funzionale e naturale, che evidenzia un approccio patrimoniale alla gestione, con un ceppo di zebra mediterranea."
    ],
    "fr": [
      "Un itinéraire de pêche à la mouche \"No Kill\" de plus de 3,6 km, favorisant la remise en eau des poissons. Un parcours fonctionnel et naturel, mettant en avant une approche patrimoniale de la gestion, avec une souche méditerranéenne zébrée."
    ],
    "es": [
      "Una ruta de pesca con mosca \"No Kill\" de más de 3,6 km, que anima a los peces a volver al agua. Una ruta funcional y natural, que pone de relieve un enfoque patrimonial de la gestión, con un tocón de cebra mediterráneo."
    ],
    "nl": [
      "Natuurlijke 'No Kill' vliegvisroute van 3,6 km met mediterrane gestreepte vissen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing course of 'The Five Briges\""
    ],
    "fr": [
      "Parcours de pêche des cinq ponts"
    ],
    "nl": [
      "Visparcours van '5 ponts'"
    ]
  },
