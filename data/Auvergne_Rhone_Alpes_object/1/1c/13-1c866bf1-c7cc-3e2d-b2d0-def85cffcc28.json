  "rdfs:comment": {
    "de": [
      "Boutique mit lokalem Kunsthandwerk. Hier steht die Keramik im Mittelpunkt: Tischkultur (Schalen, Tassen, Vasen, Schüsseln...) und Schmuck. Bei Arts d'Ici können Sie das Know-how lokaler Künstler entdecken, Geschenkideen finden und auch sich selbst eine Freude machen!"
    ],
    "en": [
      "Store for local arts and crafts. Ceramics take pride of place here: tableware (bowls, mugs, vases, dishes...) and jewelry. Arts d'Ici showcases the skills of local artists, gift ideas and is also a great place to treat yourself!"
    ],
    "it": [
      "Negozio di artigianato locale. Le ceramiche sono in primo piano: vasellame (ciotole, tazze, vasi, piatti, ecc.) e gioielli. Arts d'Ici vi permette di scoprire il savoir-faire degli artisti locali, le idee regalo e anche di regalarvi qualcosa!"
    ],
    "fr": [
      "Boutique d’artisanat d'art local. La céramique y est à l'honneur : arts de la table (bols, tasses, vases, coupelles…) et bijoux. Arts d'Ici vous fait découvrir le savoir-faire d'artistes locaux, des idées cadeaux et aussi pour se faire plaisir !"
    ],
    "es": [
      "Tienda de artesanía local. La cerámica está en el punto de mira: vajilla (cuencos, tazas, jarrones, platos, etc.) y joyería. Arts d'Ici le permite descubrir el saber hacer de los artistas locales, ideas para regalar y también para darse un capricho"
    ],
    "nl": [
      "Plaatselijke kunstnijverheidswinkel. De nadruk ligt op keramiek: serviesgoed (kommen, mokken, vazen, schalen, enz.) en sieraden. Bij Arts d'Ici kun je de vaardigheden van lokale kunstenaars ontdekken, cadeau-ideeën opdoen en ook jezelf verwennen!"
    ]
  },
