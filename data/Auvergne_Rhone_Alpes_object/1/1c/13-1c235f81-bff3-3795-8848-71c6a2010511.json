  "rdfs:comment": {
    "de": [
      "Führungen durch die Innenräume nach vorheriger Anmeldung per SMS und während der genannten Öffnungszeiten.\r\nDie Führung wird die Besucher in die Räume im Erdgeschoss führen und dauert etwa eine Stunde, 1 Stunde und 10 Minuten."
    ],
    "en": [
      "Guided tour of the interiors, by appointment by SMS and during the opening periods mentioned.\r\nThe tour will take visitors into the ground-floor rooms and lasts approximately one hour, 1 h 10."
    ],
    "it": [
      "Visita guidata agli interni, su prenotazione via SMS e negli orari di apertura indicati.\r\nLa visita si snoda attraverso le sale del piano terra e ha una durata di circa un'ora, 1 ora e 10 minuti."
    ],
    "fr": [
      "Visite guidée des intérieurs, sur rendez-vous par SMS et pendant les périodes d'ouverture mentionnées. \r\nLa visite fera entrer les visiteurs dans les pièces du rez-de-chaussée et dure environ une heure, 1 h 10."
    ],
    "es": [
      "Visita guiada a los interiores, previa cita por SMS y durante los horarios de apertura mencionados.\r\nEl recorrido llevará a los visitantes por las salas de la planta baja y dura aproximadamente una hora, 1 hora y 10 minutos."
    ],
    "nl": [
      "Rondleiding door het interieur, op afspraak per sms en tijdens de vermelde openingstijden.\r\nDe rondleiding neemt bezoekers mee door de kamers op de begane grond en duurt ongeveer een uur, 1 uur 10 minuten."
    ]
  },
  "rdfs:label": {
