  "rdfs:comment": {
    "de": [
      "Seit 1979 bietet der Jazz Club de Savoie ein vielfältiges Programm von hoher Qualität, das alle Facetten des Jazz abdeckt.\r\nKonzerte finden jeden Freitagabend statt."
    ],
    "en": [
      "Since 1979, the Jazz Club of Savoie offers a varied program of high quality, covering all facets of jazz.\r\nConcerts every Friday evening."
    ],
    "it": [
      "Dal 1979, il Jazz Club de Savoie offre un programma vario e di alta qualità, che copre tutte le sfaccettature del jazz.\r\nConcerti ogni venerdì sera."
    ],
    "fr": [
      "Depuis 1979, le Jazz Club de Savoie propose une programmation variée de grande qualité, recouvrant toutes les facettes du jazz.\r\nConcerts tous les vendredis soirs."
    ],
    "nl": [
      "Sinds 1979 biedt de Jazz Club de Savoie een gevarieerd programma van hoge kwaliteit, waarin alle facetten van de jazz aan bod komen.\r\nConcerten elke vrijdagavond."
    ],
    "es": [
      "Desde 1979, el Jazz Club de Savoie ofrece una programación variada y de calidad que abarca todas las facetas del jazz.\r\nConciertos todos los viernes por la noche."
    ]
  },
