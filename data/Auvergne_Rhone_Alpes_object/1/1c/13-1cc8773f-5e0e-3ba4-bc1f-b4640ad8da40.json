  "rdfs:comment": {
    "de": [
      "Ein Rundweg (nicht markiert - GPX), um die Dörfer Treffort und Cuisiat zu entdecken, indem man den Montcel umrundet, der sie durch die Combe des Vaux und den Wald von la Motte trennt"
    ],
    "en": [
      "A circuit (unmarked - GPX) to discover the villages of Treffort and Cuisiat around the Montcel, which separates them by the Combe des Vaux and the Motte forest."
    ],
    "it": [
      "Un circuito (non segnalato - GPX) per scoprire i villaggi di Treffort e Cuisiat intorno al Montcel, che li separa dalla Combe des Vaux e dalla foresta della Motte"
    ],
    "fr": [
      "Un circuit (non balisé - GPX) pour découvrir les villages de Treffort et de Cuisiat en faisant le tour du Montcel qui les sépare par la Combe des Vaux et la forêt de la Motte"
    ],
    "es": [
      "Un circuito (no señalizado - GPX) para descubrir los pueblos de Treffort y Cuisiat alrededor del Montcel, que los separa por la Combe des Vaux y el bosque de la Motte"
    ],
    "nl": [
      "Een circuit (ongemarkeerd - GPX) om de dorpen Treffort en Cuisiat te ontdekken rond de Montcel, die hen scheidt door de Combe des Vaux en het bos van Motte"
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE circuit (blue) - Tour du Montcel"
    ],
    "fr": [
      "Circuit VTTAE (bleu) - Tour du Montcel"
    ]
  },
