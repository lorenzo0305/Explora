  "rdfs:comment": {
    "de": [
      "Ein Rundweg, um das Mountainbiken mit elektrischer Unterstützung zu erlernen\r\nfür diejenigen, die bereits Erfahrung mit dem Mountainbike haben. Diese Route führt Sie durch die Entremonts und eröffnet Ihnen atemberaubende Panoramen."
    ],
    "en": [
      "An introductory loop for electrically-assisted mountain biking, recommended\r\nfor those who have already experienced mountain biking. This itinerary guides you through the Entremonts and opens onto breathtaking panoramas."
    ],
    "it": [
      "Un anello di introduzione alla mountain bike a pedalata assistita, consigliato a chi ha già provato la mountain bike\r\na chi ha già provato la mountain bike. Questo percorso vi guida attraverso gli Entremonts e si apre su panorami mozzafiato."
    ],
    "fr": [
      "Une boucle pour s’initier au VTT à assistance électrique, recommandée \r\naux pratiquants ayant déjà expérimenté le VTT. Cet itinéraire vous guide à travers les Entremonts et ouvre sur des panoramas à couper le souffle."
    ],
    "es": [
      "Un bucle de iniciación a la bicicleta de montaña con asistencia eléctrica, recomendado\r\npara los que ya han probado la bicicleta de montaña. Esta ruta le guía a través de Entremonts y se abre a panoramas impresionantes."
    ],
    "nl": [
      "Een loop voor een kennismaking met elektrisch ondersteund mountainbiken, aanbevolen\r\nvoor diegenen die al eens hebben geprobeerd te mountainbiken. Deze route leidt u door de Entremonts en biedt adembenemende panorama's."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE - Etrip under the Dent de l'Ours"
    ],
    "fr": [
      "VTTAE - Etrip sous la Dent de l’Ours"
    ]
  },
