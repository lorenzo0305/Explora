  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1c538540-ab1a-3a12-a3ca-fb31bc43228a",
      "dc:description": {
        "de": [
          "Bereiten Sie sich auf ein magisches Wochenende voller Überraschungen vor, das den Kindern gewidmet ist. Auf dem Programm stehen riesige Hüpfburgen, kreative Workshops und viele andere Aktivitäten... -Von 15:00 bis 19:00 Uhr"
        ],
        "en": [
          "Get ready for a magical weekend full of surprises dedicated to children. On the program: giant inflatables, creative workshops, and much more... -3pm to 7pm"
        ],
        "it": [
          "Preparatevi a un weekend magico e pieno di sorprese per i bambini. In programma: gonfiabili giganti, laboratori creativi e tanto altro... -Dalle 15.00 alle 19.00"
        ],
        "fr": [
          "Préparez-vous à vivre un week-end magique et plein de surprise dédiées aux enfants. Au programme : structures gonflables géantes, ateliers créatifs, et bien d'autres activités... -De 15h à 19h"
        ],
        "es": [
          "Prepárese para un fin de semana mágico lleno de sorpresas para los niños. En el programa: hinchables gigantes, talleres creativos y mucho más... -De 15:00 a 19:00 h"
        ],
        "nl": [
          "Bereid je voor op een magisch weekend vol verrassingen voor kinderen. Op het programma: reuze springkussens, creatieve workshops en nog veel meer... -Van 15.00 tot 19.00 uur"
        ]
      },
