  "rdfs:comment": {
    "de": [
      "In einer entspannten und gemütlichen Atmosphäre, kommen eine Pause nach der Arbeit nehmen."
    ],
    "en": [
      "This board games cafe is located within the Ibis Styles Lyon Villeurbanne Parc de la Tête d'Or hotel, which was completely renovated in 2025. Enjoy a drink and reasonably priced appetiser platters while you cooperate or compete."
    ],
    "it": [
      "Un bar di giochi situato nell'hotel Ibis Styles Lyon Villeurbanne Parc de la Tête d'Or, completamente rinnovato nel 2025. Collaborate o giocate tra di voi davanti a un drink e a un aperitivo a prezzi convenienti."
    ],
    "fr": [
      "Un bar à jeux situé au sein de l'hôtel Ibis Styles Lyon Villeurbanne Parc de la Tête d'Or, entièrement rénové en 2025. Coopérez ou affrontez-vous autour d'un verre, et de planches apéritives à prix doux."
    ],
    "es": [
      "Un bar de juegos situado en el hotel Ibis Styles Lyon Villeurbanne Parc de la Tête d'Or, completamente renovado en 2025. Coopere o juegue entre sí tomando una copa, y platos de aperitivo a precios económicos."
    ],
    "nl": [
      "Een spelletjesbar in het Ibis Styles Lyon Villeurbanne Parc de la Tête d'Or hotel, volledig gerenoveerd in 2025. Werk samen of speel tegen elkaar onder het genot van een drankje en aperitiefschotels tegen lage prijzen."
    ]
  },
