  "rdfs:comment": {
    "de": [
      "Traditionelle Qualitätsküche und savoyische Spezialitäten. Diese an die Aravis-Kette angelehnte Hütte bietet ein einzigartiges Panorama auf die Mont-Blanc-Kette mit einer der letzten Höhenlagen in Hochsavoyen."
    ],
    "en": [
      "Traditionnal and quality cooking and also savoyard specialties. Nearby the Aravis chain this refuge has a unique sight on the Mont-Blanc, with one of the last landing strips of Haute-Savoie."
    ],
    "it": [
      "Cucina tradizionale di qualità e specialità savoiarde. Questo rifugio, che si trova nei pressi della catena degli Aravis, gode di un panorama straordinario sul Monte Bianco con una delle ultime piste di atterraggio in montagna dell'Alta Savoia."
    ],
    "fr": [
      "Cuisine traditionnelle de qualité et spécialités savoyardes. Adossé à la chaine des Aravis, ce refuge bénéficie d'un panorama unique sur la chaîne du Mont-Blanc avec une des dernières altisurface de Haute-Savoie."
    ],
    "nl": [
      "Traditionele kwaliteitskeuken en Savoyaardse specialiteiten. Grenzend aan het Aravis-gebergte, heeft deze refuge een uniek panorama op de Mont Blanc-keten met een van de laatste hooggelegen gebieden in de Haute-Savoie."
    ],
    "es": [
      "Cocina tradicional de calidad y especialidades saboyanas. Adyacente a la cordillera de Aravis, este refugio ofrece un panorama único de la cadena del Mont Blanc con una de las últimas zonas de altitud de la Alta Saboya."
    ]
  },
