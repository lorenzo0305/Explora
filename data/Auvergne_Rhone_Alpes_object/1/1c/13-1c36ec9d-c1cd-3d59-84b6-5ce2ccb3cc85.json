  "rdfs:comment": {
    "de": [
      "D'Âme des Champs ist ein kleiner Schnittblumenhof, der Mitglied der Bio-Blumenfarmen und des Collectif de la Fleur Française ist. Die Blumen wachsen im Freiland und unter ungeheizten Schutzdächern und respektieren ihre Jahreszeiten. AB-zertifizierte Produktion"
    ],
    "en": [
      "D'Âme des Champs is a small cut flower farm and a member of the Collectif de la Fleur Française. The flowers grow naturally, in the open ground, outdoors and under unheated shelter, respecting the seasons. AB-certified production"
    ],
    "it": [
      "D'Âme des Champs è una piccola azienda di fiori recisi, membro delle Fermes florales bio e del Collectif de la Fleur Française. I fiori sono coltivati in campi aperti e sotto coperture non riscaldate, nel rispetto delle stagioni. La produzione è certificata AB"
    ],
    "fr": [
      "D'Âme des Champs est une petite ferme de fleurs coupées, membre des Fermes florales bio et du Collectif de la Fleur Française. Les fleurs poussent en plein champ et sous abri non chauffé en respectant leurs saisons. La production est certifiée AB"
    ],
    "nl": [
      "D'Âme des Champs is een klein snijbloemenbedrijf en lid van het Collectif de la Fleur Française. De bloemen groeien op natuurlijke wijze, in de volle grond, buiten en onder een onverwarmd afdak, met respect voor de seizoenen. AB-gecertificeerde productie."
    ],
    "es": [
      "D'Âme des Champs es una pequeña explotación de flor cortada, miembro de las Fermes florales bio y del Collectif de la Fleur Française. Las flores se cultivan en campo abierto y a cubierto sin calefacción, respetando las estaciones. La producción está certificada AB"
    ]
  },
