  "rdfs:comment": {
    "de": [
      "Boutique am Eingang der Töpferwerkstatt, in der ihre Produkte angeboten werden: Töpferwaren, Kosmetika auf Rosenbasis und handgemachte Seifen (Produkte aus einer landwirtschaftlichen Tätigkeit).\r\nEs besteht die Möglichkeit, sich für Töpferei-Workshops für jedermann anzumelden."
    ],
    "en": [
      "Store at the entrance to the pottery workshop, featuring pottery, rose-based cosmetics and handmade soaps (farm products).\r\nPottery workshops open to the general public."
    ],
    "it": [
      "Il negozio all'ingresso del laboratorio di ceramica vende i suoi prodotti: ceramiche, cosmetici alla rosa e saponi fatti a mano (prodotti di un'attività agricola).\r\nÈ anche possibile iscriversi ai laboratori di ceramica per il pubblico."
    ],
    "fr": [
      "Boutique à l'entrée de l'atelier de poterie où l'on trouve ses productions : poteries, cosmétiques à base de rose, et savons artisanaux (produits issus d'une activité agricole).\r\nPossibilité de s'inscrire à des ateliers de poterie tout public."
    ],
    "es": [
      "La tienda situada a la entrada del taller de alfarería vende sus productos: alfarería, cosméticos a base de rosas y jabones artesanales (productos de una actividad agrícola).\r\nTambién puedes apuntarte a talleres de alfarería para el público en general."
    ],
    "nl": [
      "De winkel bij de ingang van het pottenbakkersatelier verkoopt haar producten: aardewerk, cosmetica op basis van rozen en handgemaakte zeep (producten van een agrarische activiteit).\r\nJe kunt je ook inschrijven voor workshops pottenbakken voor het grote publiek."
    ]
  },
  "rdfs:label": {
