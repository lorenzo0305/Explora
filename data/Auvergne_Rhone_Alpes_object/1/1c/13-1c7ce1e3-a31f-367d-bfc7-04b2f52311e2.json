  "rdfs:comment": {
    "de": [
      "Au Bureau ist eine authentische und einzigartige Pub Brasserie mit einem exotischen angelsächsischen Dekor. In jedem Au Bureau werden Sie eine entspannte und freundliche Atmosphäre vorfinden."
    ],
    "en": [
      "Au Bureau is an authentic and unique pub-brasserie with an Anglo-Saxon decor. You'll find a relaxed, friendly atmosphere in every Au Bureau."
    ],
    "it": [
      "Au Bureau è un pub-brasserie autentico e unico con un arredamento anglosassone. In ogni Au Bureau troverete un'atmosfera rilassata e amichevole."
    ],
    "fr": [
      "Véritable lieu de vie, Au Bureau est un pub brasserie authentique et unique, au décor anglo-saxon dépaysant. Vous retrouverez dans tous les Au Bureau une ambiance détendue et conviviale."
    ],
    "nl": [
      "Au Bureau is een authentieke en unieke pub-brasserie met een Angelsaksisch decor. In elk Au Bureau heerst een ontspannen en vriendelijke sfeer."
    ],
    "es": [
      "Au Bureau es un pub-brasserie auténtico y único con una decoración anglosajona. En todas las oficinas de Au Bureau encontrará un ambiente relajado y acogedor."
    ]
