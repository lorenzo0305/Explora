  "rdfs:comment": {
    "de": [
      "Die heutige Kirche wurde Mitte des 16. Jahrhunderts erbaut, als der erste Herzog von Guise die mittelalterlichen Befestigungsanlagen mit einer bastionierten Backsteinmauer modernisierte."
    ],
    "en": [
      "The present-day church was built in the mid-16th century, when the first Duke of Guise modernized the medieval fortifications with a bastioned brick rampart."
    ],
    "it": [
      "L'attuale chiesa fu costruita a metà del XVI secolo, quando il primo Duca di Guisa modernizzò le fortificazioni medievali con un muro di mattoni bastionato."
    ],
    "fr": [
      "L'Eglise actuelle fut construite au milieu du XVIème siècle, quand le premier Duc de Guise modernisa les fortifications médiévales d'un rempart bastionné en briques."
    ],
    "es": [
      "La iglesia actual se construyó a mediados del siglo XVI, cuando el primer duque de Guisa modernizó las fortificaciones medievales con un muro abaluartado de ladrillo."
    ],
    "nl": [
      "De huidige kerk werd halverwege de 16e eeuw gebouwd, toen de eerste hertog van Guise de middeleeuwse vestingwerken moderniseerde met een gebastioneerde bakstenen muur."
    ]
  },
