  "rdfs:comment": {
    "de": [
      "Neben ihren allgemeinen Sammlungen für Erwachsene und Kinder (Belletristik, Dokumentarfilme) bietet Ihnen die Bibliothek auch spezielle Bestände zu Michel Butor, der Gemeinde Lucinges und Savoie-Léman."
    ],
    "en": [
      "In addition to its general collections for adults and children (fiction and non-fiction), the library has special collections on Michel Butor, the municipality of Lucinges and Savoie-Léman."
    ],
    "it": [
      "Oltre alle collezioni generali per adulti e bambini (narrativa, documentari), la biblioteca offre collezioni specifiche su Michel Butor, il comune di Lucinges e la Savoia-Léman."
    ],
    "fr": [
      "Outre ses collections généralistes pour adultes et enfants (fictions, documentaires), la bibliothèque vous propose des fonds spécifiques sur Michel Butor, la commune de Lucinges et Savoie-Léman."
    ],
    "nl": [
      "Naast de algemene collecties voor volwassenen en kinderen (fictie, documentaires) biedt de bibliotheek specifieke collecties over Michel Butor, de gemeente Lucinges en Savoie-Léman."
    ],
    "es": [
      "Además de sus colecciones de carácter general para niños y adultos (libros de ficción, documentales...) la biblioteca ofrece fondos específicos sobre Michel Butor, el municipio de Lucinges y Saboya y el Lemán."
    ]
  },
