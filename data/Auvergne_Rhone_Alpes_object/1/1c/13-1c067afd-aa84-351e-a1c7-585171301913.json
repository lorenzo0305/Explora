  "rdfs:comment": {
    "de": [
      "Assoziatives Café-Restaurant, das hausgemachte Gerichte aus frischen und lokalen Produkten zu erschwinglichen Preisen vor Ort oder zum Mitnehmen anbietet.\r\nDie Speisekarte wechselt jeden Monat mit einem täglich wechselnden Gericht und Dessert, je nach Laune des Küchenchefs!"
    ],
    "en": [
      "A café-restaurant serving homemade dishes made with fresh local produce at affordable prices, to eat in or take away.\r\nThe menu changes every month, with a different dish and dessert every day, depending on the chef's mood!"
    ],
    "it": [
      "Un caffè-ristorante che serve piatti fatti in casa con prodotti freschi locali a prezzi accessibili, da mangiare o da portare via.\r\nIl menu cambia ogni mese, con un piatto e un dessert diversi ogni giorno, a seconda dell'umore dello chef!"
    ],
    "fr": [
      "Café restaurant associatif proposant des plats faits-maison, préparés à base de produits frais et locaux à prix abordable, sur place ou à emporter. \r\nLa carte change chaque mois avec un plat et un dessert différent chaque jour selon l'humeur du chef !"
    ],
    "es": [
      "Un café-restaurante que sirve platos caseros elaborados con productos locales frescos a precios asequibles, para comer en casa o para llevar.\r\nEl menú cambia cada mes, con un plato y un postre diferente cada día, ¡según el estado de ánimo del chef!"
    ],
    "nl": [
      "Een café-restaurant dat huisgemaakte gerechten serveert, gemaakt van verse lokale producten tegen betaalbare prijzen, om te eten of om mee te nemen.\r\nHet menu verandert elke maand, met elke dag een ander gerecht en dessert, afhankelijk van de stemming van de chef!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant associatif \"L'Art des Choix de Chony\""
    ]
  },
