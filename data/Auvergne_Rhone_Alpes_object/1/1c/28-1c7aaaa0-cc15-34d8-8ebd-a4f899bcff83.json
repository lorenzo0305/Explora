      "shortDescription": {
        "de": [
          "Wurde 2018 zur besten Bäckerei in der Region Hauts-de-France und zur zweitbesten in Frankreich gekürt. Kreative Kuchen, Sauerteigbrote, 100% hausgemacht."
        ],
        "en": [
          "Ranked best bakery in the Hauts-de-France region and 2nd in France in 2018. Creative cakes, sourdough breads, 100% home-made."
        ],
        "it": [
          "Classificato come miglior panificio della regione Hauts-de-France e 2° in Francia nel 2018. Torte creative, pani a lievitazione naturale, 100% fatti in casa."
        ],
        "fr": [
          "Classée meilleure boulangerie dans la région Hauts-de-France et 2ème de France en 2018. Gâteaux créatifs, pains au levain, 100% fait maison."
        ],
        "nl": [
          "Gerangschikt als beste bakkerij in de regio Hauts-de-France en 2e in Frankrijk in 2018. Creatieve taarten, zuurdesembroden, 100% huisgemaakt."
        ],
        "es": [
          "Clasificada como mejor panadería de la región de Hauts-de-France y 2ª de Francia en 2018. Pasteles creativos, panes de masa madre, 100% caseros."
        ]
      }
