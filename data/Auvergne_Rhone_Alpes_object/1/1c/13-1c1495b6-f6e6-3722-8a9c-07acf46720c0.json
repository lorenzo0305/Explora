  "rdfs:comment": {
    "de": [
      "Eine atypische Gärtnerei! Mehr als 450 Sorten Kräuter sind erhältlich, aber auch alte Gemüsesorten und Färbepflanzen."
    ],
    "en": [
      "Visit the plant nursery and its aromatic and medieval plants. Duration of visit: 1 our. Aromatic plants in pots and grow-bags: mint, thyme, basil, and many more (largest collection of aromatic plants in France). Organically grown."
    ],
    "it": [
      "Un vivaio insolito! Sono disponibili oltre 450 varietà di piante aromatiche, ortaggi antichi e piante tintorie."
    ],
    "fr": [
      "Une pépinière atypique ! Plus de 450 variétés de plantes aromatiques disponibles, mais également des légumes anciens et des plantes tinctoriales."
    ],
    "es": [
      "Un vivero fuera de lo común Dispone de más de 450 variedades de plantas aromáticas, hortalizas antiguas y plantas tintóreas."
    ],
    "nl": [
      "Bezoek aan het bedrijf, aromatische en middeleeuwse planten. Duur van het bezoek: 1 u.\r\nAromatische planten in potten en vaasjes: munt, tijm, basilicum, etc. (de grootste verzameling aromatische planten in Frankrijk) biologische landbouw"
    ]
  },
