  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c12f834a-0556-3776-91ab-46e9c0764bd8",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Samstag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\n\nMontags und sonntags geschlossen\n\nAbholung:\nZu den Öffnungszeiten der Apotheke\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Saturday, 9:00 am to 12:00 pm and 2:00 pm to 7:00 pm\n\nClosed on Mondays and Sundays\n\nPick-up :\nDuring pharmacy opening hours\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDal lunedì al sabato, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\n\nChiuso il lunedì e la domenica\n\nRitiro:\nDurante gli orari di apertura della farmacia\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au samedi de 9h00 à 12h00 et de 14h00 à 19h00\n\nFermeture le lundi et le dimanche\n\nRetrait :\nAux horaires d'ouverture de l'officine\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot zaterdag, 9u tot 12u en 14u tot 19u\n\nGesloten op maandag en zondag\n\nAfhalen:\nTijdens openingstijden van de apotheek\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a sábado, de 9.00 a 12.00 h. y de 14.00 a 19.00 h\n\nCerrado los lunes y domingos\n\nRecogida:\nDurante el horario de apertura de la farmacia\n "
        ]
      },
