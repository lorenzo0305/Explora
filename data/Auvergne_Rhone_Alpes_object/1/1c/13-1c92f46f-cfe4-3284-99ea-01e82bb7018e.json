  "rdfs:comment": {
    "de": [
      "Charakteristisches Hotel Bar Restaurant im hübschen Bergdorf Albepierre-Bredons, 6 km von der familienfreundlichen Skistation Prat de Bouc entfernt, am Fuße des Plomb du Cantal und auf der Strecke des GR400."
    ],
    "en": [
      "Characterful hotel-bar-restaurant located in the pretty mountain village of Albepierre-Bredons, 6km from the family ski resort of Prat de Bouc, at the foot of the Plomb du Cantal, on the GR400 trail."
    ],
    "it": [
      "Hotel-bar-ristorante di carattere situato nel grazioso villaggio di montagna di Albepierre-Bredons, a 6 km dalla stazione sciistica di Prat de Bouc, adatta alle famiglie, ai piedi della Plomb du Cantal, sul sentiero GR400."
    ],
    "fr": [
      "Hôtel Bar Restaurant de caractère situé dans le joli village de montagne d'Albepierre-Bredons, à 6km de la station de ski familiale de Prat de Bouc, au pied du Plomb du Cantal, sur le parcours du GR400."
    ],
    "nl": [
      "Karakteristiek hotel-bar-restaurant gelegen in het mooie bergdorp Albepierre-Bredons, op 6 km van het gezinsvriendelijke skigebied Prat de Bouc, aan de voet van de Plomb du Cantal, aan de GR400."
    ],
    "es": [
      "Hotel-bar-restaurante de carácter situado en el bonito pueblo de montaña de Albepierre-Bredons, a 6 km de la estación de esquí familiar de Prat de Bouc, al pie del Plomb du Cantal, en el sendero GR400."
    ]
  },
  "rdfs:label": {
