  "rdfs:comment": {
    "de": [
      "Kino mit 250 Plätzen im Zentrum von Chaudes-Aigues. Filme mit nationalem Start und Vorpremieren. 3D-Technologie bei einigen Filmen. Programm für junges Publikum, Fête du Cinéma, je nach Saison (Halloween, Weihnachten, Ostern...)."
    ],
    "en": [
      "250-seat cinema in the centre of Chaudes-Aigues. Films in national release and previews. 3D technology on some films. Young audience programming, Fête du Cinéma, depending on the season (Halloween, Christmas, Easter...)."
    ],
    "it": [
      "Cinema da 250 posti nel centro di Chaudes-Aigues. Film in uscita nazionale e anteprime. Tecnologia 3D su alcuni film. Programmazione per il pubblico giovane, rassegna cinematografica, a seconda della stagione (Halloween, Natale, Pasqua...)."
    ],
    "fr": [
      "Cinéma 250 places au centre de Chaudes-Aigues. Films en sortie nationale et avant-premières. Technologie 3D sur certains films. Programmation jeune public, Fête du Cinéma, selon saison (Halloween, Noël, Pâques...)."
    ],
    "es": [
      "Cine de 250 plazas en el centro de Chaudes-Aigues. Películas de estreno nacional y preestrenos. La tecnología 3D en algunas películas. Programación para el público joven, festival de cine, según la temporada (Halloween, Navidad, Semana Santa...)."
    ],
    "nl": [
      "Bioscoop met 250 plaatsen in het centrum van Chaudes-Aigues. Nationale films en previews. 3D technologie op sommige films. Programmering voor een jong publiek, filmfestival, afhankelijk van het seizoen (Halloween, Kerstmis, Pasen...)."
    ]
  },
