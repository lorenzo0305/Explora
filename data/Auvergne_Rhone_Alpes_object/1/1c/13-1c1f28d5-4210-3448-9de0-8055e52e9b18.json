  "rdfs:comment": {
    "de": [
      "Sonnenterrasse mit Blick auf den Mont Blanc!\r\nAm Anfang des Skilifts PRARIOND am Ende der Seilrutsche gelegen, Blick auf den Mont-Blanc. Panoramasaal mit Kamin. Küche des Hauses. Abendveranstaltungen auf Reservierung."
    ],
    "en": [
      "Terrace in the sun with a view of Mont Blanc!\r\nLocated at the start of the PRARIOND ski lift at the end of the zip line, with views of Mont Blanc. Panoramic room with fireplace. Home cooking. Evenings by prior arrangement."
    ],
    "it": [
      "Terrazza al sole con vista sul Monte Bianco!\r\nSituata alla partenza dell'impianto di risalita PRARIOND, alla fine della teleferica, con vista sul Monte Bianco. Sala panoramica con camino. Cucina casalinga. Serate su prenotazione."
    ],
    "fr": [
      "Terrasse au soleil avec vue sur le Mont Blanc !\r\nSitué au départ du téléski du PRARIOND à l’arrivée de la tyrolienne, vue sur le Mont-Blanc. Salle panoramique avec cheminée. Cuisine Maison. Soirées sur réservation."
    ],
    "es": [
      "¡Terraza al sol con vistas al Mont Blanc!\r\nSituada al inicio del remonte PRARIOND, al final de la tirolina, con vistas al Mont Blanc. Salón panorámico con chimenea. Cocina casera. Noches con cita previa."
    ],
    "nl": [
      "Terras in de zon met uitzicht op de Mont Blanc!\r\nGelegen aan het begin van de PRARIOND skilift aan het einde van de tokkelbaan, met uitzicht op de Mont Blanc. Panoramische kamer met open haard. Thuis koken. s Avonds op afspraak."
    ]
  },
