  "rdfs:comment": {
    "de": [
      "Ein neuer Bereich, der hauptsächlich der italienischen Küche gewidmet ist, mit einem Feinkostladen, einer Weinstube und einem Restaurant. Wir bieten Ihnen einen Catering-Service à la carte für Ihre Familien- und/oder Festessen..."
    ],
    "en": [
      "A new space essentially dedicated to Italian cuisine with a delicatessen, a wine bar and a restaurant. We offer you an à la carte catering service for your family meals and/or parties..."
    ],
    "it": [
      "Un nuovo spazio dedicato essenzialmente alla cucina italiana con una gastronomia, un'enoteca e un ristorante. Offriamo un servizio di catering à la carte per i vostri pasti in famiglia e/o feste..."
    ],
    "fr": [
      "Un nouvel espace essentiellement dédié à la cuisine italienne avec une épicerie fine, un bar à vin et un restaurant. Nous vous proposons un service traiteur à la carte pour vos repas de famille et/ou de fêtes..."
    ],
    "es": [
      "Un nuevo espacio dedicado esencialmente a la cocina italiana con una charcutería, un bar de vinos y un restaurante. Ofrecemos un servicio de catering a la carta para sus comidas familiares y/o fiestas..."
    ],
    "nl": [
      "Een nieuwe ruimte die hoofdzakelijk gewijd is aan de Italiaanse keuken met een delicatessenzaak, een wijnbar en een restaurant. Wij bieden een à la carte catering service voor uw familie maaltijden en/of feesten..."
    ]
  },
  "rdfs:label": {
