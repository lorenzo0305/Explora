  "rdfs:comment": {
    "de": [
      "2 ornithologische Observatorien, die auf dem Étang Chapelier, einem vogelreichen Nistgebiet, eingerichtet wurden.\r\nObservatorien auf Pfählen, die es Spaziergängern und Besuchern ermöglichen, den Reichtum der Vogelwelt der Dombiste zu genießen. Teich wird 2022 trockengelegt."
    ],
    "en": [
      "The Observatoires de l’Etang Chapelier are bird watching observatories located near the village of Versailleux in the heart of the Dombiste Lakes."
    ],
    "it": [
      "2 osservatori ornitologici allestiti sullo stagno di Chapelier, una riserva di nidificazione ricca di uccelli.\r\nOsservatori su palafitte che permettono a escursionisti e visitatori di ammirare la ricchezza dell'avifauna del Dombois."
    ],
    "fr": [
      "2 observatoires ornithologiques aménagés sur l'étang Chapelier, réserve de nidification riche en oiseaux. \r\nObservatoires sur pilotis permettant aux promeneurs et visiteurs de profiter de la richesse de l'avifaune dombiste."
    ],
    "nl": [
      "2 ornithologische observatieposten aan de vijver van de Chapelier, een vogelrijk broedreservaat.\r\nObservatieposten op palen om wandelaars en bezoekers te laten genieten van de rijkdom van de Domboisvogels."
    ],
    "es": [
      "2 observatorios ornitológicos instalados en el estanque del Chapelier, una reserva rica en aves nidificantes.\r\nObservatorios sobre pilotes que permiten a senderistas y visitantes disfrutar de la riqueza ornitológica de Dombois."
    ]
  },
  "rdfs:label": {
