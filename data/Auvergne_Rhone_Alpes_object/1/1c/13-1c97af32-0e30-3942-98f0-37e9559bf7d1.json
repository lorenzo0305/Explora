  "rdfs:comment": {
    "de": [
      "Étang de la Sagne: Angelplatz in idyllischer Umgebung im Herzen der Combrailles.\r\nIn der Nähe des Fades-Viadukts und des Stausees FADES-BESSERVE.\r\nAngeln in geschlossenen Gewässern und private Bewirtschaftung."
    ],
    "en": [
      "Étang de la Sagne: fishing site set up in a picturesque setting in the heart of the Combrailles.\r\nClose to the Fades Viaduct and the FADES-BESSERVE lake reservoir.\r\nFishing in closed water and private management."
    ],
    "it": [
      "Étang de la Sagne: sito di pesca in un ambiente bucolico nel cuore delle Combrailles.\r\nVicino al Viaduc des Fades e al lago FADES-BESSERVE.\r\nPesca in acque chiuse e gestione privata."
    ],
    "fr": [
      "Étang de la Sagne : site de pêche aménagé dans un cadre bucolique au coeur des Combrailles.\r\nProche du Viaduc des Fades et de la retenue du lac des FADES-BESSERVE.\r\nPêche en eau close et gestion privée."
    ],
    "nl": [
      "Étang de la Sagne: vissersplaats in een bucolische omgeving in het hart van de Combrailles.\r\nDicht bij het Viaduct van Fades en het meer van FADES-BESSERVE.\r\nGesloten wateren en particulier beheer."
    ],
    "es": [
      "Étang de la Sagne: sitio de pesca en un entorno bucólico en el corazón de las Combrailles.\r\nCerca del Viaduc des Fades y del lago FADES-BESSERVE.\r\nPesca en aguas cerradas y gestión privada."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelplatz - Étang de la Sagne"
    ],
    "en": [
      "Fishing site - Étang de la Sagne"
    ],
    "fr": [
      "Site de Pêche - Étang de la Sagne"
    ]
  },
