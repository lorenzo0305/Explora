  "rdfs:comment": {
    "de": [
      "Vitamine 7 ist ein städtebauliches Übergangsprojekt, das für vier Jahre in der 3 bis rue Félix Brun (Lyon 7e) angesiedelt ist, bis die zukünftige Sporthalle des Collège Gisèle Halimi gebaut wird."
    ],
    "en": [
      "A transitional urban planning project, Vitamine 7 is taking up residence at 3 bis rue Félix Brun (Lyon 7th district) for four years, pending construction of the future gymnasium for the Gisèle Halimi secondary school."
    ],
    "it": [
      "Progetto urbanistico di transizione, Vitamine 7 si insedia per quattro anni al 3 bis di rue Félix Brun (Lione 7e), in attesa della costruzione della futura palestra della scuola secondaria Gisèle Halimi."
    ],
    "fr": [
      "Projet d’urbanisme transitoire, Vitamine 7 prend place au 3 bis rue Félix Brun (Lyon 7e) pour quatre ans, en attendant la construction du futur gymnase du collège Gisèle Halimi."
    ],
    "nl": [
      "Vitamine 7 is een stedenbouwkundig overgangsproject dat voor vier jaar zijn intrek neemt in 3 bis rue Félix Brun (Lyon 7e), in afwachting van de bouw van het toekomstige gymnasium van de middelbare school Gisèle Halimi."
    ],
    "es": [
      "Proyecto urbanístico de transición, Vitamine 7 se instala durante cuatro años en el número 3 bis de la calle Félix Brun (Lyon 7e), a la espera de la construcción del futuro gimnasio del instituto Gisèle Halimi."
    ]
  },
