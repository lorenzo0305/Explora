  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen Gartenwald durch eine Führung, eine kostenlose Ernte, Zeit zum Austausch und eine Verkostung der Produkte des Bauernhofs. Von der Brache zum Gartenwald, ein landwirtschaftliches Projekt, das sich seit 2019 in der Entwicklung befindet."
    ],
    "en": [
      "Come and discover a forest garden through a guided tour, a free harvest, a time for discussion and a tasting of farm produce. From wasteland to forest garden, a farming project in development since 2019."
    ],
    "it": [
      "Scoprite un giardino forestale attraverso una visita guidata, un raccolto gratuito, un momento di discussione e una degustazione di prodotti agricoli.\r\nDa terreno incolto a giardino forestale, un progetto di agricoltori in sviluppo dal 2019."
    ],
    "fr": [
      "Découvrir un jardin-forêt à travers une visite guidée, une récolte libre, un temps d'échange et une dégustation des produits de la ferme.\r\nDe la friche au jardin-forêt, projet paysan en développement depuis 2019."
    ],
    "nl": [
      "Ontdek een bostuin door middel van een rondleiding, een gratis oogst, een moment voor discussie en een proeverij van boerderijproducten.\r\nVan braakland tot bostuin, een boerenproject in ontwikkeling sinds 2019."
    ],
    "es": [
      "Descubra un jardín forestal a través de una visita guiada, una cosecha gratuita, un momento de debate y una degustación de productos agrícolas.\r\nDe erial a huerto forestal, un proyecto de agricultores en desarrollo desde 2019."
    ]
  },
