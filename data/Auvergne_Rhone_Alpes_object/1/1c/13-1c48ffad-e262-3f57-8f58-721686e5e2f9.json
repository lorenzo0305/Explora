  "rdfs:comment": {
    "de": [
      "Der Parc Sainte-Anne in Crest im Département Drôme in der Region Auvergne-Rhône-Alpes ist ein idealer Ort, um Ihr nächstes Picknick zu veranstalten. Dieser Park bietet einen angenehmen Rahmen, um einen Moment der Entspannung im Freien zu genießen."
    ],
    "en": [
      "Parc Sainte-Anne, located in Crest in the Drôme department of the Auvergne-Rhône-Alpes region, is an ideal place to organize your next picnic. This park offers a pleasant setting to enjoy a relaxing moment outdoors."
    ],
    "it": [
      "Il Parc Sainte-Anne, situato a Crest nel dipartimento della Drôme in Alvernia-Rodano-Alpi, è il luogo ideale per organizzare il vostro prossimo picnic. Il parco offre un ambiente piacevole per rilassarsi all'aria aperta."
    ],
    "fr": [
      "Parc Sainte-Anne, situé à Crest dans le département Drôme en Auvergne-Rhône-Alpes, est un lieu idéal pour organiser votre prochain pique-nique. Ce parc offre un cadre agréable pour profiter d'un moment de détente en plein air."
    ],
    "nl": [
      "Parc Sainte-Anne, gelegen in Crest in het departement Drôme in Auvergne-Rhône-Alpes, is een ideale plek voor je volgende picknick. Het park biedt een aangename omgeving om te ontspannen in de buitenlucht."
    ],
    "es": [
      "El parque Sainte-Anne, situado en Crest, en el departamento de Drôme, en Auvernia-Ródano-Alpes, es un lugar ideal para celebrar su próximo picnic. El parque ofrece un entorno agradable para relajarse al aire libre."
    ]
  },
