  "rdfs:comment": {
    "de": [
      "Sind Sie bereit, sich zu amüsieren? Wer hat nicht schon einmal den Wunsch gehabt, an einer Quizshow teilzunehmen?\r\nOb mit Freunden, Familie oder Kollegen, erleben Sie eine Erfahrung, die den besten Fernsehshows würdig ist!"
    ],
    "en": [
      "Are you ready to have some fun? Who hasn't wanted to take part in a game show?\r\nWith friends, family or colleagues, come and enjoy an experience worthy of the best TV shows!"
    ],
    "it": [
      "Siete pronti a divertirvi? Chi non ha mai desiderato partecipare a un game show?\r\nCon gli amici, la famiglia o i colleghi, venite a vivere un'esperienza degna dei migliori show televisivi!"
    ],
    "fr": [
      "Êtes vous prêts à vous amuser ? Qui n'a jamais eu envie de participer à un jeu télé ?\r\nEntre amis, en famille ou entre collègues, venez vivre une expérience digne des meilleures émissions de télévision !"
    ],
    "es": [
      "¿Estás listo para divertirte? ¿Quién no ha querido participar alguna vez en un concurso?\r\nCon amigos, familia o compañeros, ¡venga a disfrutar de una experiencia digna de los mejores programas de televisión!"
    ],
    "nl": [
      "Ben je klaar om plezier te maken? Wie heeft er nooit willen deelnemen aan een spelshow?\r\nKom met vrienden, familie of collega's genieten van een ervaring die de beste tv-shows waardig is!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de plateaux TV avec Cube TV"
    ]
  },
