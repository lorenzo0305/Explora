  "rdfs:comment": {
    "de": [
      "Dieser in St-Chef gelegene Pub verbindet Modernität und Gemütlichkeit mit einer Karte, die nach dem Prinzip der kurzen Wege zusammengestellt wurde. Ob vor Ort oder zum Mitnehmen, lassen Sie sich von den schmackhaften und großzügigen Rezepten verführen, die von einem unserer 5 handwerklich gebrauten Biere begleitet werden."
    ],
    "en": [
      "Located in St-Chef, this pub combines modernity and friendliness with a menu created using local produce. On the premises or to take away, let yourself be seduced by tasty and generous recipes accompanied by one of our 5 craft beers."
    ],
    "it": [
      "Situato a St-Chef, questo pub combina modernità e cordialità con un menu creato con prodotti locali. Sul posto o da asporto, lasciatevi sedurre da ricette gustose e generose accompagnate da una delle nostre 5 birre artigianali."
    ],
    "fr": [
      "Situé à St-Chef, ce pub allie modernité et convivialité avec une carte élaborée en circuit court. Sur place ou à emporter, laissez-vous séduire par des recettes savoureuses et généreuses accompagnées de l'une de nos 5 bières artisanales."
    ],
    "es": [
      "Situado en St-Chef, este pub combina modernidad y amabilidad con una carta elaborada con productos locales. En el local o para llevar, déjese seducir por sabrosas y generosas recetas acompañadas de una de nuestras 5 cervezas artesanales."
    ],
    "nl": [
      "Dit café in St-Chef combineert moderniteit en gezelligheid met een menu dat is samengesteld op basis van lokale producten. Laat je ter plaatse of om mee te nemen verleiden door smakelijke en gulle recepten, vergezeld van een van onze 5 ambachtelijke bieren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cask House : Irish pub & food"
    ],
    "fr": [
      "Cask House : Irish pub & food"
    ]
  },
