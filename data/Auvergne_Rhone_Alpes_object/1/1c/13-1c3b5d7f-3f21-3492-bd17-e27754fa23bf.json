  "rdfs:comment": {
    "de": [
      "Erleben Sie einen einzigartigen Moment! Restaurant, Empfangsraum, Seminare, Hochzeiten, alles in einem 800 m2 großen Park mit Bäumen in der Nähe von Valence. In Situ, das ist die Garantie, eine Küche mit frischen und lokalen Produkten aus Valence und Umgebung zu genießen."
    ],
    "en": [
      "Experience a unique moment! Restaurant, function room, seminar, wedding, all set in 800 m2 of wooded parkland near Valence. At In Situ, you're guaranteed to enjoy cuisine based on fresh, local produce from Valence and the surrounding area."
    ],
    "it": [
      "All'In Situ, alle porte di Valence, ristorante e luogo di ricevimento si uniscono per i vostri eventi privati e aziendali. Nel nostro parco di 800 m², potrete gustare un'abbondante cucina locale preparata con cura."
    ],
    "fr": [
      "À In Situ, tout près de Valence, restaurant et lieu de réception se conjuguent pour vos événements privés et professionnels. Dans notre parc de 800 m², savourez une cuisine généreuse, locale et préparée avec soin."
    ],
    "es": [
      "En In Situ, a las afueras de Valence, restaurante y lugar de recepción se unen para sus eventos privados y de negocios. En nuestro parque de 800 m², disfrute de una generosa cocina local preparada con esmero."
    ],
    "nl": [
      "Beleef een uniek moment! Restaurant, vergaderzaal, seminar, bruiloft, alles in een bebost park van 800 m2 in de buurt van Valence. Bij In Situ geniet je gegarandeerd van een keuken op basis van verse streekproducten uit Valence en omgeving."
    ]
  },
