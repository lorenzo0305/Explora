  "rdfs:comment": {
    "de": [
      "Baptiste Gauthier und sein Fachwissen bieten Ihnen den Verkauf von Weinen, Beratung für Privatpersonen und Fachleute sowie Schulungen und Workshops zum Thema Wein an."
    ],
    "en": [
      "Baptiste Gauthier and his expertise offer wine sales, advice for individuals and professionals, as well as wine training and workshops."
    ],
    "it": [
      "Baptiste Gauthier e la sua esperienza vi offrono vendita di vino, consulenza per privati e professionisti, nonché corsi di formazione e workshop sul vino."
    ],
    "fr": [
      "Baptiste Gauthier et son expertise vous propose de la vente de vins, des conseils auprès des particuliers et professionnels, ainsi que des formations et ateliers sur le vin."
    ],
    "es": [
      "Baptiste Gauthier y su experiencia le ofrecen venta de vinos, asesoramiento a particulares y profesionales, así como cursos y talleres de formación vinícola."
    ],
