  "rdfs:comment": {
    "de": [
      "Ein Paar, ein Atelier, drei Produktionen. Mit glasiertem Steinzeug, Raku und Porzellan können wir eine breite Palette an Farben, Funktionen und Materialeffekten anbieten."
    ],
    "en": [
      "A couple, a workshop, two creative productions: enamelled stoneware and Raku pottery offer many different colours, features and material effects. Porcelain tableware on sale."
    ],
    "it": [
      "Una coppia, un laboratorio, tre produzioni. Il gres smaltato, il raku e la porcellana ci permettono di offrire un'ampia gamma di colori, funzioni ed effetti materici."
    ],
    "fr": [
      "Un couple, un atelier, trois productions. Le grés émaillé, le raku et la porcelaine nous permettent de proposer un large éventail de couleurs, de fonctionnalités et d'effets de matières."
    ],
    "es": [
      "Una pareja, un taller, tres producciones. El gres esmaltado, el raku y la porcelana nos permiten ofrecer una amplia gama de colores, funciones y efectos materiales."
    ],
    "nl": [
      "Een stel, een werkplaats, twee producties. Steengoed en raku biedt ons de kans om een uitgebreid assortiment kleuren, functies en materialen te bieden."
    ]
  },
