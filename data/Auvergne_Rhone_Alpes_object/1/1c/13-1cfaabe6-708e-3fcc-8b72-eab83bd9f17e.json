  "rdfs:comment": {
    "de": [
      "Das Schloss von Aurec-sur-Loire bietet einen außergewöhnlichen Rahmen, der sowohl historisch als auch natürlich ist, und eignet sich für geschäftliche und private Veranstaltungen."
    ],
    "en": [
      "The Château d'Aurec-sur-Loire offers an exceptional setting, both historic and natural, for professional and private events."
    ],
    "it": [
      "Lo Château d'Aurec-sur-Loire offre una cornice eccezionale, sia storica che naturale, per l'organizzazione di eventi professionali e privati."
    ],
    "fr": [
      "Le Château d’Aurec-sur-Loire offre un cadre exceptionnel, à la fois historique et naturel, pour l’organisation d’événements professionnels et privés."
    ],
    "nl": [
      "Het Château d'Aurec-sur-Loire biedt een uitzonderlijke omgeving, zowel historisch als natuurlijk, voor het organiseren van professionele en privé evenementen."
    ],
    "es": [
      "El castillo de Aurec-sur-Loire ofrece un marco excepcional, tanto histórico como natural, para la organización de eventos profesionales y privados."
    ]
  },
