  "rdfs:comment": {
    "de": [
      "Vermietung von kleinen Tretpferden aus den 1950er Jahren.\r\nEchte Sammlerstücke aus dem Musée de la Musique Mécanique.\r\nDie kleinen Tretpferde dürfen nur auf dem Platz vor der Reithalle und in Begleitung eines Erwachsenen benutzt werden.\r\nNeben der Reithalle."
    ],
    "en": [
      "Rent a small pedal horse from the 1950s.\r\nReal collector's items from the Museum of Mechanical Music.\r\nThe pedalos are only to be used in the riding arena and accompanied by an adult.\r\nNext to the merry-go-round."
    ],
    "it": [
      "Noleggio di cavallini a pedali degli anni '50.\r\nAutentici oggetti da collezione del Museo della Musica Meccanica.\r\nI cavallini a pedali possono essere utilizzati solo nel maneggio e devono essere accompagnati da un adulto.\r\nAccanto alla giostra."
    ],
    "fr": [
      "Location de petits chevaux à pédales des années 50.\r\nVéritables pièces de collection du Musée de la Musique Mécanique.\r\nLes petits chevaux à pédales sont à utiliser uniquement sur la place du manège et accompagnés d'un adulte.\r\nA côté du manège."
    ],
    "nl": [
      "Verhuur van kleine trapfietsjes uit de jaren '50.\r\nEchte collectors' items uit het Museum van Mechanische Muziek.\r\nDe trapfietsjes mogen alleen op het plein en onder begeleiding van een volwassene worden gebruikt.\r\nNaast de carrousel."
    ],
    "es": [
      "Alquiler de caballitos de pedales de los años 50.\r\nAuténticas piezas de colección del Museo de la Música Mecánica.\r\nLos caballitos de pedales sólo pueden utilizarse en el picadero y deben ir acompañados de un adulto.\r\nJunto al carrusel."
    ]
  },
