  "rdfs:comment": {
    "de": [
      "Gehen Sie an Bord eines Elektroboots. Diese friedliche Fahrt ist leicht zu steuern und ohne Führerschein möglich. Sie können sich entschleunigen und lautlos über das Wasser gleiten lassen."
    ],
    "en": [
      "Come aboard an electric boat. Easy to pilot and license-free, this peaceful ride invites you to slow down and glide silently along the water."
    ],
    "it": [
      "Salite a bordo di una barca elettrica. Facile da pilotare e senza bisogno di patente, questa tranquilla imbarcazione vi invita a rallentare e a scivolare silenziosamente sull'acqua."
    ],
    "fr": [
      "Embarquez à bord d’un bateau électrique. Facile à piloter et sans permis, cette balade paisible vous invite à ralentir, glisser en silence au fil de l’eau."
    ],
    "es": [
      "Suba a bordo de una lancha eléctrica. Fácil de pilotar y sin necesidad de licencia, este tranquilo paseo te invita a reducir la velocidad y a deslizarte silenciosamente por el agua."
    ],
    "nl": [
      "Kom aan boord van een elektrische boot. Deze vredige rit, die gemakkelijk te besturen is en waarvoor geen vaarbewijs nodig is, nodigt je uit om het rustiger aan te doen en geruisloos over het water te glijden."
    ]
  },
