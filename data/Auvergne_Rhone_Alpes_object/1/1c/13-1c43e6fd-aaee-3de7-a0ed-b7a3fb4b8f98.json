  "rdfs:comment": {
    "de": [
      "25 m langes städtisches Schwimmbad mit Planschbecken, am Fuße des alten Dorfes, das als \"Petite Cité de Caractère\" klassifiziert ist. Terrasse und Solarium, Liegestühle stehen zur Verfügung. Verkauf von Eis und Getränken vor Ort."
    ],
    "en": [
      "25 m municipal swimming pool with paddling pool, at the foot of the old village classified as a \"Petite Cité de Caractère\". Terrace and solarium, deckchairs available. Ice creams and drinks on sale."
    ],
    "it": [
      "Piscina comunale di 25 m con vasca per bambini, ai piedi del vecchio villaggio classificato come \"Petite Cité de Caractère\". Terrazza e solarium, lettini a disposizione. Vendita di gelati e bevande."
    ],
    "fr": [
      "Piscine municipale de 25 m de long avec pataugeoire, au pied du village ancien classé \"Petite Cité de Caractère\". Terrasse et solarium, chaises longues à disposition. Vente de glaces et de boissons sur place."
    ],
    "es": [
      "Piscina municipal de 25 m con piscina infantil, al pie del antiguo pueblo clasificado como \"Petite Cité de Caractère\". Terraza y solarium, tumbonas disponibles. Venta de helados y bebidas."
    ],
    "nl": [
      "Gemeentelijk zwembad van 25 m met kikkerbad, aan de voet van het oude dorp geclassificeerd als \"Petite Cité de Caractère\". Terras en solarium, ligstoelen beschikbaar. Verkoop van ijs en drankjes."
    ]
  },
  "rdfs:label": {
