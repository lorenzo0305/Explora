  "rdfs:comment": {
    "de": [
      "Dieser assoziative Laden bietet Klosterprodukte sowie Spezialitäten aus dem Vercors und dem Piemont an. Eine religiöse Buchhandlung und regionale Dokumentation sind ebenfalls erhältlich. Er befindet sich in der Nähe der Zisterzienserabtei von Léoncel."
    ],
    "en": [
      "This community store sells monastic products, as well as specialities from the Vercors and Piedmont regions. A religious bookshop and regional documentation are also available. Located near the Cistercian abbey of Léoncel."
    ],
    "it": [
      "Questo negozio di beneficenza vende prodotti monastici e specialità delle regioni del Vercors e del Piemonte. Sono disponibili anche una libreria religiosa e una documentazione regionale. Situato vicino all'abbazia cistercense di Léoncel."
    ],
    "fr": [
      "Ce magasin associatif propose des produits monastiques, ainsi que des spécialités du Vercors et des Piémonts. Une librairie religieuse et une documentation régionale y sont également disponibles. Situé près de l'abbaye cistercienne de Léoncel."
    ],
    "es": [
      "Esta tienda benéfica vende productos monásticos, así como especialidades de las regiones de Vercors y Piamonte. También dispone de una librería religiosa y documentación regional. Situada cerca de la abadía cisterciense de Léoncel."
    ],
    "nl": [
      "Deze liefdadigheidswinkel verkoopt kloosterproducten en specialiteiten uit de Vercors en Piemonte. Er is ook een religieuze boekwinkel en regionale documentatie beschikbaar. Gelegen bij de cisterciënzer abdij van Léoncel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique St Hugues"
    ]
  },
