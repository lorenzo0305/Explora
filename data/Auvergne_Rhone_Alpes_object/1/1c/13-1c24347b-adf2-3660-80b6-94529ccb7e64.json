  "rdfs:comment": {
    "de": [
      "Das Gourmet-Restaurant Le Jardin Gourmand bietet Liebhabern von gutem Essen eine kreative Küche. Es wurde mehrfach von der Presse gelobt und befindet sich westlich von Lyon, in der Nähe von Anse und Villefranche."
    ],
    "en": [
      "The gastronomic restaurant Le Jardin Gourmand offers creative cuisine for lovers of good food. The restaurant is located west of Lyon, close to Anse and Villefranche."
    ],
    "it": [
      "Il ristorante gastronomico Le Jardin Gourmand offre una cucina creativa agli amanti della buona tavola. Si trova a ovest di Lione, vicino ad Anse e Villefranche, ed è stato più volte elogiato dalla stampa."
    ],
    "fr": [
      "Le restaurant gastronomique Le Jardin Gourmand propose une cuisine créative aux amateurs de bonne chère. Salué à plusieurs reprises par la presse, il est situé à l'Ouest de Lyon, à proximité d'Anse et Villefranche."
    ],
    "nl": [
      "Het gastronomische restaurant Le Jardin Gourmand biedt liefhebbers van lekker eten een creatieve keuken. Het ligt ten westen van Lyon, in de buurt van Anse en Villefranche, en is meermaals door de pers geprezen."
    ],
    "es": [
      "El restaurante gastronómico Le Jardin Gourmand ofrece una cocina creativa a los amantes de la buena mesa. Está situado al oeste de Lyon, cerca de Anse y Villefranche, y ha sido elogiado en varias ocasiones por la prensa."
    ]
  },
