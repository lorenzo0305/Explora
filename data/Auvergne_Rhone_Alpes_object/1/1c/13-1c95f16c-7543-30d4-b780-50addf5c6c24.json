  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, das für alle offen ist. Entdecken Sie unsere saisonale Speisekarte und genießen Sie unsere angenehme Terrasse! Geschäftsessen, Familientreffen, Geburtstage... Kostenloses WLAN, kostenloser Parkplatz."
    ],
    "en": [
      "Traditional restaurant that caters for all tastes. Special summer menu can be enjoyed outdoors on our attractive terrace. Free wi-fi and parking.\r\nGroup bookings for birthdays, business and family events."
    ],
    "it": [
      "Ristorante tradizionale aperto a tutti. Scoprite il nostro menu stagionale e godetevi la nostra piacevole terrazza! Cene di lavoro, riunioni di famiglia, compleanni... Wi-Fi gratuito, parcheggio gratuito."
    ],
    "fr": [
      "Restaurant traditionnel ouvert à tous. Découvrez notre carte de saison et venez profiter de notre agréable terrasse ! Repas d'affaires, réunion de famille, anniversaire... Wifi gratuit, parking gratuit."
    ],
    "nl": [
      "Traditioneel restaurant open voor iedereen. Ontdek ons seizoensmenu en geniet van ons gezellige terras! Zakelijke maaltijden, familiereünies, verjaardagen... Gratis Wi-Fi, gratis parkeren."
    ],
    "es": [
      "Restaurante tradicional abierto a todos. Descubra nuestra carta de temporada y disfrute de nuestra agradable terraza Comidas de negocios, reuniones familiares, cumpleaños... Wi-Fi gratuito, aparcamiento gratuito."
    ]
  },
