  "rdfs:comment": {
    "de": [
      "Der Imker Nicolas Mahoudeau lädt Kinder von 4 bis 12 Jahren zu einem spielerischen Workshop ein, bei dem sie lernen, ihren eigenen Lebkuchen herzustellen. Eine Gourmet-Aktivität mit Honigduft"
    ],
    "en": [
      "Beekeeper Nicolas Mahoudeau invites children aged 4 to 12 to take part in a fun workshop to learn how to make their own gingerbread. A gourmet activity scented with honey"
    ],
    "it": [
      "L'apicoltore Nicolas Mahoudeau invita i bambini dai 4 ai 12 anni a partecipare a un divertente laboratorio per imparare a realizzare il proprio pan di zenzero. Un'attività gastronomica aromatizzata al miele"
    ],
    "fr": [
      "Nicolas Mahoudeau, apiculteur, invite les enfants de 4 à 12 ans à participer à un atelier ludique pour apprendre à confectionner leur propre pain d’épices. Une activité gourmande aux parfums de miel"
    ],
    "nl": [
      "Imker Nicolas Mahoudeau nodigt kinderen van 4 tot 12 jaar uit voor een leuke workshop om te leren hoe ze hun eigen peperkoek kunnen maken. Een activiteit voor fijnproevers op smaak gebracht met honing"
    ],
    "es": [
      "El apicultor Nicolas Mahoudeau invita a los niños de 4 a 12 años a participar en un divertido taller para aprender a elaborar su propio pan de jengibre. Una actividad gourmet aromatizada con miel"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Automnal Gourmand: atelier enfant confection de pains d'épices"
    ]
  },
