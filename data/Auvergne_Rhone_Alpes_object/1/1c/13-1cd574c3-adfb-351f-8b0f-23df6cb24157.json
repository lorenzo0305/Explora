  "rdfs:comment": {
    "de": [
      "Diversifizierter Gemüseanbau in biologischer Landwirtschaft: Produzent/innen von Gemüse, Gemüsepflanzen, Kräutern und Blumen. Lieferung von Körben. Markt am Montag in Amplepuis, am Dienstag in Amplepuis und am Freitag in Roanne. Direktverkauf am Donnerstag von 16 bis 19 Uhr."
    ],
    "en": [
      "Diversified organic market gardening: producers of vegetables, market garden plants, herbs and flowers. Basket delivery. Market Mondays in Amplepuis, Tuesdays in Amplepuis and Fridays in Roanne. Direct sales on Thursdays from 4pm to 7pm."
    ],
    "it": [
      "Orticoltura biologica diversificata: produttori di ortaggi, piante da orto, erbe e fiori. Cesti consegnati. Mercati il lunedì ad Amplepuis, il martedì ad Amplepuis e il venerdì a Roanne. Vendita diretta il giovedì dalle 16.00 alle 19.00."
    ],
    "fr": [
      "Maraîchage diversifié en Agriculture Biologique : producteurs de légumes, plants maraîchers, aromatiques et fleurs. Livraison de paniers. Marché le lundi à Amplepuis, le mardi à Amplepuis et le vendredi à Roanne. Vente directe le jeudi de 16h à 19h."
    ],
    "es": [
      "Horticultura ecológica diversificada: productores de hortalizas, plantas hortícolas, hierbas aromáticas y flores. Entrega de cestas. Mercados los lunes en Amplepuis, los martes en Amplepuis y los viernes en Roanne. Venta directa los jueves de 16.00 a 19.00 horas."
    ],
    "nl": [
      "Gediversifieerde biologische tuinbouw: producenten van groenten, tuinplanten, kruiden en bloemen. Manden geleverd. Markten op maandag in Amplepuis, dinsdag in Amplepuis en vrijdag in Roanne. Directe verkoop op donderdag van 16.00 tot 19.00 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les jardins du bois joli"
    ]
  },
