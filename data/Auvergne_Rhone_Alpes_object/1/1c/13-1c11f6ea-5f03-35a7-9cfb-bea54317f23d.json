  "rdfs:comment": {
    "de": [
      "Unser Ziel :\r\n\"Die Welt des Zirkus für alle zugänglich machen, indem wir möglichst viele Menschen in die Welt des Zirkus einführen\".\r\nWöchentliche Workshops: Zirkus ab 3 Jahren, Parkour ab 7 Jahren / Praktika in den Schulferien"
    ],
    "en": [
      "Our aim:\r\n\"To bring the world of circus within everyone's reach by initiating as many people as possible\".\r\nWeekly workshops: circus from 18 months, parkour from 7 years and clown from\r\nclown from 8 years / School vacation workshops"
    ],
    "it": [
      "Il nostro obiettivo:\r\n\"Rendere il mondo del circo accessibile a tutti, introducendovi il maggior numero di persone possibile\".\r\nLaboratori settimanali: circo dai 3 anni, parkour dai 7 anni / Corsi per le vacanze scolastiche"
    ],
    "fr": [
      "Notre objectif :\r\n« Mettre le monde du cirque à la portée de tous par l’initiation du plus grand nombre ».\r\nAteliers hebdomadaires : cirque à partir de 3 ans, parkour à partir de 7 ans  / Stages vacances scolaires"
    ],
    "nl": [
      "Ons doel:\r\n\"De wereld van het circus voor iedereen toegankelijk maken door zoveel mogelijk mensen ermee kennis te laten maken.\r\nWekelijkse workshops: circus vanaf 3 jaar, parkour vanaf 7 jaar / Schoolvakanties"
    ],
    "es": [
      "Nuestro objetivo:\r\n\"Hacer accesible el mundo del circo al mayor número de personas posible\".\r\nTalleres semanales: circo a partir de 3 años, parkour a partir de 7 años / Cursos en vacaciones escolares"
    ]
  },
