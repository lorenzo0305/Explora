  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich im Erdgeschoss der Schule von Sainte-Agnès und öffnet ihre Türen für Sie. Hier können Sie einen gemütlichen Raum zur Entspannung nutzen. Aus einer großen Auswahl an Dokumenten können Sie sich ein Buch oder eine DVD ausleihen."
    ],
    "en": [
      "Located on the first floor of the Sainte-Agnès school, the library opens its doors to you. Here you can enjoy a friendly, relaxing space. You'll be able to borrow a book or DVD from the wide selection of documents on offer."
    ],
    "it": [
      "La biblioteca si trova al piano terra della scuola Sainte-Agnès. È un luogo accogliente dove rilassarsi e distendersi. È possibile prendere in prestito un libro o un DVD dall'ampia selezione di documenti offerti."
    ],
    "fr": [
      "Située au rez-de-chaussée de l'école de Sainte-Agnès, la bibliothèque vous ouvre ses portes. Vous pourrez profiter d'un espace de détente convivial. Parmi un large choix proposé de documents, vous pourrez repartir en empruntant un livre, ou un DVD."
    ],
    "es": [
      "La biblioteca se encuentra en la planta baja de la escuela Sainte-Agnès. Es un lugar acogedor donde podrá relajarse y descansar. Puede tomar prestado un libro o un DVD de la amplia selección de documentos que se ofrecen."
    ],
    "nl": [
      "De bibliotheek bevindt zich op de begane grond van de Sainte-Agnès school. Het is een gezellige plek waar je kunt ontspannen en tot rust kunt komen. Je kunt een boek of dvd lenen uit het ruime aanbod."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque Françoise Rosset-Boulon"
    ]
  },
