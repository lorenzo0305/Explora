  "rdfs:comment": {
    "de": [
      "Der geniale Pianist, Komponist und Improvisator Jean-François Zygel lädt uns zu einer Reise in das Herz der durch Musik hervorgerufenen Emotionen ein."
    ],
    "en": [
      "Pianist, composer and improviser of genius, Jean-François Zygel takes us on a journey to the heart of the emotions aroused by music."
    ],
    "it": [
      "Pianista, compositore e improvvisatore di genio, Jean-François Zygel ci accompagna in un viaggio al cuore delle emozioni suscitate dalla musica."
    ],
    "fr": [
      "Pianiste, compositeur et improvisateur de génie, Jean-François Zygel nous propose un voyage au coeur des émotions suscitées par la musique."
    ],
    "es": [
      "Pianista, compositor e improvisador genial, Jean-François Zygel nos lleva al corazón de las emociones que despierta la música."
    ],
    "nl": [
      "Pianist, componist en geniaal improvisator Jean-François Zygel neemt ons mee op een reis naar het hart van de emoties die muziek oproept."
    ]
