  "rdfs:comment": {
    "de": [
      "Das Team von La Perelle empfängt Sie in einem charmanten Ski-in-den-Füßen-Haus mit Schwimmbad und Sauna am Gipfel des Skiortes St François Longchamp."
    ],
    "en": [
      "Family Resort welcomes you in its charming establishment, with a swimming pool and a sauna. It's located at the top of Saint-François Longchamp resort, and it proposes holidays adapted for families."
    ],
    "it": [
      "Il team de La Perelle vi dà il benvenuto in un'incantevole struttura ski in/ski out con piscina e sauna, nella parte alta della località di St François Longchamp."
    ],
    "fr": [
      "L’équipe de La Perelle vous accueille au sein d'un établissement de charme skis aux pieds avec piscine et sauna, au sommet de la station de St François Longchamp."
    ],
    "es": [
      "El equipo de La Perelle le da la bienvenida a un encantador establecimiento de ski in/ski out con piscina y sauna, en lo alto de la estación de St François Longchamp."
    ],
    "nl": [
      "Een Familieresort dat u verwelkomt in een gelegenheid vol charme, met zwembad en sauna. Bovenaan het station van St François Longchamp, stellen we u een vakantie voor op maat van de familie."
    ]
  },
