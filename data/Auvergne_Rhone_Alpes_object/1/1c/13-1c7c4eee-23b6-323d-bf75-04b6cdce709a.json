  "rdfs:comment": {
    "de": [
      "Véronique und Patrice halten anglo-nubische Milchziegen und produzieren Käse, Pyrenäen-Esel für die Zucht und sind erntende Erzeuger von Crème de Cassis und Crème de Framboise."
    ],
    "en": [
      "Véronique and Patrice raise Anglo-Nubian dairy goats and produce cheeses, Pyrenean donkeys for breeding, and are producers and harvesters of crèmes de cassis and crèmes de framboise."
    ],
    "it": [
      "Véronique e Patrice allevano capre da latte anglo-nubiane e producono formaggio, asini pirenaici per l'allevamento e sono produttori di crèmes de cassis e crèmes de framboise."
    ],
    "fr": [
      "Véronique et Patrice élèvent des chèvres laitières anglo-nubiennes et produisent des fromages, des ânes des Pyrénées pour la reproduction et sont producteurs récoltants de crèmes de cassis et crèmes de framboise."
    ],
    "es": [
      "Véronique y Patrice crían cabras lecheras anglo-nubias y producen queso, burros pirenaicos de cría y son productores de crèmes de cassis y crèmes de framboise."
    ],
    "nl": [
      "Véronique en Patrice fokken Anglo-Nubische melkgeiten en produceren kaas, fokken Pyreneese ezels en zijn producenten van crèmes de cassis en crèmes de framboise."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Capr'ânes"
    ]
  },
