  "rdfs:comment": {
    "de": [
      "Sandrine und Dominique, staatlich geprüfte Bergführer, bieten Ihnen Ausflüge von La Norma aus in die Haute Maurienne Vanoise an. Erleben Sie die Berge in aller Einfachheit, weit weg von den täglichen Sorgen."
    ],
    "en": [
      "State-qualified mountain guides Sandrine and Dominique offer outings from La Norma to the Haute Maurienne Vanoise. Come and experience the mountains in all simplicity, far from the hassles of everyday life."
    ],
    "it": [
      "Sandrine e Dominique, guide alpine qualificate, propongono escursioni da La Norma alla Haute Maurienne Vanoise. Venite a vivere la montagna in tutta semplicità, lontano dagli affanni della vita quotidiana."
    ],
    "fr": [
      "Sandrine et Dominique, accompagnateurs en montagne diplômés d’état, vous proposent des sorties au départ de La Norma, vers la Haute Maurienne Vanoise. Venez vivre la montagne en toute simplicité, loin des tracas quotidiens."
    ],
    "es": [
      "Sandrine y Dominique, guías de montaña titulados, proponen salidas desde La Norma hasta la Haute Maurienne Vanoise. Venga a vivir la montaña con toda sencillez, lejos de las molestias de la vida cotidiana."
    ],
    "nl": [
      "Sandrine en Dominique, gediplomeerde berggidsen, bieden tochten aan van La Norma tot de Haute Maurienne Vanoise. Kom en ervaar de bergen in alle eenvoud, ver weg van de beslommeringen van alledag."
    ]
  },
  "rdfs:label": {
    "en": [
