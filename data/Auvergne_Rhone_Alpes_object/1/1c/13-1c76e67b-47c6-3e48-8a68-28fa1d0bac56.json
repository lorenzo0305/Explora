  "rdfs:comment": {
    "de": [
      "Die Konsultationen finden in der Praxis und je nach Bedarf in Form von Hausbesuchen statt. Täglich stehen Notfallsprechstunden zur Verfügung, um die medizinische Nachfrage bestmöglich zu befriedigen."
    ],
    "en": [
      "Consultations take place in the office and in home visits as required. Emergency slots are available every day to best meet medical demand."
    ],
    "it": [
      "Le consultazioni vengono effettuate presso lo studio e, se necessario, anche a domicilio. I posti di emergenza sono disponibili tutti i giorni per soddisfare la domanda medica nel modo più efficace possibile."
    ],
    "fr": [
      "Les consultations se font au cabinet et en visites à domiciles selon les besoins. Des plages d'urgence sont disponibles tous les jours afin de répondre au mieux à la demande médicale."
    ],
    "es": [
      "Las consultas se llevan a cabo en la consulta y en visitas a domicilio, según sea necesario. Todos los días hay turnos de urgencia para atender la demanda médica con la mayor eficacia posible."
    ],
    "nl": [
      "Consulten worden uitgevoerd in de praktijk en indien nodig aan huis. Er zijn elke dag spoedgevallen beschikbaar om zo goed mogelijk aan de medische vraag te kunnen voldoen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison de santé pluridisciplinaire les Ollagnes"
    ]
  },
