  "rdfs:comment": {
    "de": [
      "Das Hôtel l'Hermine Blanche ist ein 3*-Hotel mit 25 Zimmern und Spa-Bereich.  \r\nSehr schöne Aussicht von den Zimmern auf Morzine, seine Pisten und sein Dorf."
    ],
    "en": [
      "Typical Hotel from Haute Savoie\r\nBeautiful view on Morzine’s slopes and town"
    ],
    "it": [
      "L'Hotel l'Hermine Blanche è un hotel 3* con 25 camere e area benessere.  \r\nUna vista molto bella dalle camere su Morzine, le sue piste e il suo villaggio."
    ],
    "fr": [
      "L'Hôtel l’Hermine Blanche est un hôtel 3* de 25 chambres et espace spa.  \r\nTrès belle vue des chambres sur Morzine ses pistes et son village."
    ],
    "nl": [
      "Hôtel l'Hermine Blanche is een 3-sterrenhotel met 25 kamers en een spagedeelte.  \r\nPrachtig uitzicht vanuit de kamers over Morzine, de pistes en het dorp."
    ],
    "es": [
      "El Hotel l'Hermine Blanche es un hotel de 3* con 25 habitaciones y zona de spa.  \r\nMuy buena vista desde las habitaciones sobre Morzine, sus laderas y su pueblo."
    ]
  },
