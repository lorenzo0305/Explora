  "rdfs:comment": {
    "de": [
      "Lomi-Lomi Nui (Kahuna) Massage & Massage mit heißen vulkanischen Steinen: Bewusste und belebende Massagen und Berührungen, die eine Transformation auf allen Ebenen des Seins bewirken."
    ],
    "en": [
      "Lomi-Lomi Nui massage (Kahuna) & Volcanic hot stone massage: Conscious, revitalizing massage and touch, bringing transformation on all levels of being. letting go, relaxation, harmonization, and a better balance in life."
    ],
    "it": [
      "Massaggio Lomi-Lomi Nui (Kahuna) e Massaggio con pietre calde vulcaniche: massaggio e tocco consapevoli e rivitalizzanti che portano una trasformazione a tutti i livelli dell'essere. Lasciarsi andare, rilassarsi, armonizzarsi e trovare un migliore equilibrio nella vita."
    ],
    "fr": [
      "Massage Lomi-Lomi Nui (Kahuna) & Massage aux pierres chaudes volcaniques: Massages et toucher conscients et revitalisants apportant une transformation sur tous les plans de l'être. lâcher prise, détente,harmonisation, et un meilleur équilibre dans la vie."
    ],
    "es": [
      "Masaje Lomi-Lomi Nui (Kahuna) y Masaje con Piedras Calientes Volcánicas: Masaje y tacto consciente y revitalizante que aporta una transformación en todos los niveles del ser. Soltar, relajar, armonizar y un mejor equilibrio en la vida."
    ],
    "nl": [
      "Lomi-Lomi Nui-massage (Kahuna) & massage met hete vulkanische stenen: bewuste, revitaliserende massage en aanraking om transformatie teweeg te brengen op alle niveaus van het wezen. loslaten, ontspanning, harmonisatie en een betere balans in het leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Julie Rowbotham - Massages Holistiques"
    ]
  },
