      "@id": "https://data.datatourisme.fr/cb2b7278-ce91-316f-bffe-8be6bb6cd3e2",
      "dc:description": {
        "de": [
          "Treffpunkt um 18:30 Uhr im Phénix-Zentrum in Outreau für eine Filmvorführung :\nDer Graf von Monte Christo mit Pierre Niney\nvoller Preis 4.80?, ermäßigter Preis 3.80? (-18 Jahre, Studenten, Arbeitssuchende, RAS-Empfänger)."
        ],
        "en": [
          "Meet at 6:30 p.m. at the Centre Phénix in Outreau for a film screening:\nThe Count of Monte Cristo with Pierre Niney\nfull price: 4.80? reduced price: 3.80? (under 18s, students, jobseekers, RAS beneficiaries)."
        ],
        "it": [
          "Appuntamento alle 18.30 al centro Phénix di Outreau per la proiezione del film:\nIl conte di Montecristo con Pierre Niney\nprezzo intero: 4,80 euro, prezzo ridotto: 3,80 euro (minori di 18 anni, studenti, persone in cerca di lavoro, beneficiari della RAS)."
        ],
        "fr": [
          "RDV à 18h30 au centre Phénix à Outreau pour une séance de cinéma :\nLe comte de Monte Cristo avec Pierre Niney \ntarif plein 4.80€, tarif réduit:3.80€ (-18 ans, étudiant, demandeur emploi, bénéficiaire RAS)."
        ],
        "nl": [
          "Tot 18.30 uur in het Phénix-centrum in Outreau voor een filmvertoning:\nDe graaf van Monte Cristo met Pierre Niney\nvolle prijs: €4,80, gereduceerde prijs: €3,80 (onder 18 jaar, studenten, werkzoekenden, RAS-begunstigden)."
        ],
        "es": [
          "Nos vemos a las 18.30 h en el centro Phénix de Outreau para la proyección de una película:\nEl Conde de Montecristo con Pierre Niney\ntarifa completa: 4,80 euros, tarifa reducida: 3,80 euros (menores de 18 años, estudiantes, solicitantes de empleo, beneficiarios del RAS)."
        ]
      },
