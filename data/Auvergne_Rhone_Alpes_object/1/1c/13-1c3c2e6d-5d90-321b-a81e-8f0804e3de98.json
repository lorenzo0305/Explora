  "rdfs:comment": {
    "de": [
      "Als Liebhaberin guter Produkte bietet Ihnen La Crèmerie des Champs Qualitätsprodukte, die mit Leidenschaft ausgewählt wurden: gereifte Käse vom Bauernhof, Bio- und lokale Käsesorten, Wurstwaren aus Savoyen und Italien, einen Bier- und Weinkeller sowie Feinkost."
    ],
    "en": [
      "A lover of fine products, La Crèmerie des Champs offers you high-quality items carefully selected with passion: aged, farmhouse, organic, and local cheeses, Savoyard and Italian charcuterie, a selection of beers and wines, and fine groceries."
    ],
    "it": [
      "Amante della buona tavola, La Crèmerie des Champs vi offre prodotti di qualità, selezionati con passione: formaggi stagionati, di fattoria, biologici e locali, salumi savoiardi e italiani, una cantina di birre e vini e una gastronomia."
    ],
    "fr": [
      "Amatrice de bons produits, La Crèmerie des Champs vous propose des produits de qualité, sélectionnés avec passion : fromages affinés, fermiers, bio et locaux, charcuteries savoyardes et italiennes, cave à bières et vins, épicerie fine."
    ],
    "es": [
      "Amante de la buena mesa, La Crèmerie des Champs le ofrece productos de calidad, seleccionados con pasión: quesos curados, de granja, ecológicos y locales, charcutería saboyana e italiana, una bodega de cervezas y vinos y una charcutería."
    ],
    "nl": [
      "Als liefhebber van lekker eten biedt La Crèmerie des Champs je met passie geselecteerde kwaliteitsproducten: belegen, boeren, biologische en lokale kazen, Savoyaardse en Italiaanse vleeswaren, een bier- en wijnkelder en een delicatessenwinkel."
    ]
  },
