  "rdfs:comment": {
    "de": [
      "Nachdem Sie den kleinen Weg von Martinette, der am Kanal entlangführt, hinaufgestiegen sind und dabei auf den Grund des Wassers geschaut haben, um Molche und Blutegel zu bewundern, kommen Sie vor der bachaule an:"
    ],
    "en": [
      "After walking up the little chemin de la Martinette, which runs alongside the canal, and looking down at the bottom of the water to admire the newts and leeches, you'll come to the bachaule:"
    ],
    "it": [
      "Dopo aver risalito il sentiero delle Martinette che costeggia il canale, guardando il fondo dell'acqua per ammirare tritoni e sanguisughe, si arriva davanti alla bachaule:"
    ],
    "fr": [
      "Après avoir remonté le petit chemin de la Martinette qui longe le canal, tout en regardant le fond de l'eau pour admirer les tritons et sangsues, vous arriverez devant la bachaule :"
    ],
    "es": [
      "Tras subir por el caminito de Martinette que bordea el canal, mirando al fondo del agua para admirar los tritones y las sanguijuelas, se llega frente a la bachaule :"
    ],
    "nl": [
      "Na een wandeling over het Martinette-paadje langs het kanaal, waarbij je naar de bodem van het water kijkt om de salamanders en bloedzuigers te bewonderen, kom je aan voor de bachaule :"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Bachaule"
    ]
  },
