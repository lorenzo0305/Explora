  "rdfs:comment": {
    "de": [
      "Maison B ist das Ergebnis eines Projekts, das von zwei leidenschaftlichen Köchen getragen wird ? zwei Schwägern, die von dem Wunsch beseelt sind, einen einzigartigen Ort zu schaffen, der ihnen ähnelt und der Menschen zusammenbringt."
    ],
    "en": [
      "Maison B is the brainchild of two cooking enthusiasts? two brothers-in-law driven by the desire to create a unique place that reflects their personalities and brings people together."
    ],
    "it": [
      "Maison B nasce dall'idea di due persone appassionate di cibo, due cognati animati dal desiderio di creare un luogo unico che rifletta la loro personalità e che unisca le persone."
    ],
    "fr": [
      "Maison B est le fruit d’un projet porté par deux passionnés de cuisine — deux beaux-frères animés par l’envie de créer un lieu unique qui leur ressemble et qui rassemble."
    ],
    "nl": [
      "Maison B is het geesteskind van twee mensen met een passie voor eten? Twee zwagers gedreven door de wens om een unieke plek te creëren die hun eigen persoonlijkheid weerspiegelt en mensen samenbrengt."
    ],
    "es": [
      "Maison B es la creación de dos apasionados de la gastronomía, dos cuñados movidos por el deseo de crear un lugar único que refleje su propia personalidad y reúna a la gente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison B"
    ]
  },
