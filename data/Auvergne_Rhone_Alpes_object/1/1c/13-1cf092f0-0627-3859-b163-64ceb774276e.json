  "rdfs:comment": {
    "de": [
      "Genießen Sie die Terrasse des Base Kamp by Aïnata. Mit Blick auf die Pisten von Courchevel enthüllt die Speisekarte unseres libanesischen Restaurants, die von Alan Geaam mitgestaltet wurde, eine Küche des Teilens, die von den gastronomischen Traditionen des Mittelmeerraums beeinflusst ist."
    ],
    "ru": [
      "Наслаждайтесь террасой Base Kamp by Aïnata. С видом на склоны Куршевеля, меню нашего ливанского ресторана, созданное совместно с Аланом Жеамом, предлагает блюда для совместного наслаждения, вдохновленные кулинарными традициями средиземноморского региона."
    ],
    "en": [
      "Enjoy the terrace at Base Kamp by Aïnata. Overlooking the Courchevel slopes, the menu at our Lebanese restaurant, co-created by Alan Geaam, offers a shared dining experience inspired by the culinary traditions of the Mediterranean region."
    ],
    "it": [
      "Godetevi la terrazza del Base Kamp by Aïnata. Di fronte alle piste di Courchevel, il menu del nostro ristorante libanese, co-creato da Alan Geaam, rivela una cucina da condividere influenzata dalle tradizioni gastronomiche del Mediterraneo."
    ],
    "fr": [
      "Profitez de la terrasse du Base Kamp by Aïnata. Face aux pistes de Courchevel, la carte de notre restaurant libanais, cosignée par Alan Geaam, dévoile une cuisine de partage influencée par les traditions gastronomiques du pourtour méditerranéen."
    ],
    "nl": [
      "Geniet van het terras bij Base Kamp by Aïnata. Met uitzicht op de pistes van Courchevel onthult het menu van ons Libanese restaurant, mede gecreëerd door Alan Geaam, een keuken om te delen, beïnvloed door de gastronomische tradities van het Middellandse Zeegebied."
    ],
    "es": [
      "Disfrute de la terraza del Base Kamp by Aïnata. Frente a las pistas de Courchevel, el menú de nuestro restaurante libanés, co-creado por Alan Geaam, revela una cocina para compartir influenciada por las tradiciones gastronómicas del Mediterráneo."
    ]
  },
