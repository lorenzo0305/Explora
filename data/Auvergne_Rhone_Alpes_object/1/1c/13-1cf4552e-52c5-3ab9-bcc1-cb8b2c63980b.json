  "rdfs:comment": {
    "de": [
      "Ihr Restaurant ist seit 2019 in der Gegend ansässig und bietet eine traditionelle Schiefertafelküche an. Das Ganze mit frischen Produkten und wöchentlichem Wechsel und dies in einem gemütlichen Rahmen mit einem dynamischen Team."
    ],
    "en": [
      "Established in the area since 2019, your restaurant offers traditional slate-style cuisine. All with fresh produce and weekly changes, in a warm setting with a dynamic team."
    ],
    "it": [
      "Presente in zona dal 2019, il vostro ristorante offre una cucina tradizionale in stile ardesia. Il tutto con prodotti freschi e cambiamenti ogni settimana, in un ambiente accogliente con un team dinamico."
    ],
    "fr": [
      "Implanté dans la zone depuis 2019, votre restaurant propose une cuisine traditionnelle à l'ardoise. Le tout avec des produits frais et du changement chaque semaine et ceci dans un cadre chaleureux avec une équipe dynamique."
    ],
    "nl": [
      "Je restaurant is sinds 2019 gevestigd in de streek en biedt een traditionele keuken in leisteenstijl. Alles met verse producten en elke week wisselend, in een vriendelijke omgeving met een dynamisch team."
    ],
    "es": [
      "Establecido en la zona desde 2019, su restaurante ofrece cocina tradicional de pizarra. Todo con productos frescos y cambios cada semana, en un ambiente cálido con un equipo dinámico."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Brasserie"
    ]
  },
