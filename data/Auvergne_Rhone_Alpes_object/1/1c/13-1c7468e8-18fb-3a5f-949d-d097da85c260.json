  "rdfs:comment": {
    "de": [
      "\"Mit einem Esel zu verreisen bedeutet, wieder Zeit zu finden, um im Rhythmus eines sanften und liebenswerten Tieres zu leben und zu beobachten\"."
    ],
    "en": [
      "\"To go with a donkey is to find the time to live and observe to the rhythm of a gentle and endearing animal\"."
    ],
    "it": [
      "\"Andare con un asino significa trovare il tempo per vivere e osservare al ritmo di un animale gentile e affettuoso\"."
    ],
    "fr": [
      "\"Partir avec un âne, c'est retrouver le temps de vivre et d'observer au rythme d'un animal doux et attachant\"."
    ],
    "nl": [
      "\"Meegaan met een ezel betekent de tijd vinden om te leven en te observeren op het ritme van een zacht en vertederend dier\"."
    ],
    "es": [
      "\"Acompañar a un burro significa encontrar el tiempo para vivir y observar al ritmo de un animal suave y entrañable\"."
    ]
  },
