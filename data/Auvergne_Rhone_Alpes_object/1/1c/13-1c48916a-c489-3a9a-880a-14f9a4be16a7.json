  "rdfs:comment": {
    "de": [
      "Weinkellerei, die 1932 gegründet wurde. Traditionelle Weinbereitung, die Trauben werden nach alter Tradition mit der mechanischen Presse DE 1868 gepresst. Bearbeitung der Weinberge mit Pferden."
    ],
    "en": [
      "This wine cellar was created in 1960. According to traditional winemaking methods, the grapes are pressed using an old mechanical press. Work is carried out on the vines using horses."
    ],
    "it": [
      "Cantina creata nel 1932. Vinificazione tradizionale, le uve vengono pigiate alla vecchia maniera con la pressa meccanica DE 1868. Le viti vengono lavorate con un cavallo."
    ],
    "fr": [
      "Cave  créee en 1932. Vinification traditionnelle, les raisins sont pressés à l'ancienne avec le pressoir mécanique DE 1868. Travail des vignes au cheval."
    ],
    "nl": [
      "Wijnhuis opgericht in 1932. Traditionele vinificatie, de druiven worden geperst op de ouderwetse manier met de DE 1868 mechanische pers. De wijnstokken worden bewerkt met paarden."
    ],
    "es": [
      "Bodega creada en 1932. Vinificación tradicional, las uvas se prensan a la antigua usanza con la prensa mecánica DE 1868. Las viñas se trabajan con un caballo."
    ]
  },
