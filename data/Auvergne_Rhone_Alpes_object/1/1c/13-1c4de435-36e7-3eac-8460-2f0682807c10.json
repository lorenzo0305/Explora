  "rdfs:comment": {
    "de": [
      "Sobald Sie das Spa Ô des Cimes Le Centaure betreten, stellt sich sofort ein Gefühl des Wohlbefindens ein und die Zen-Attitüde durchdringt den Raum. Entspannen Sie sich vollkommen."
    ],
    "en": [
      "As soon as you step into the Ô des Cimes Le Centaure spa, a feeling of well-being is immediate and a sense of zen fills the space. Fully relax."
    ],
    "it": [
      "Non appena si entra nella spa Ô des Cimes Le Centaure, la sensazione di benessere è immediata e l'atteggiamento zen pervade lo spazio. Rilassatevi appieno."
    ],
    "fr": [
      "Dès l’entrée dans le spa  Ô des Cimes Le Centaure, la sensation de bien-être est immédiate et la zen attitude envahie l’espace. Détendez-vous pleinement."
    ],
    "nl": [
      "Zodra je het Ô des Cimes Le Centaure-spa binnenstapt, voel je meteen een gevoel van welzijn en vult een zen-sfeer de ruimte. Ontspan je volledig."
    ],
    "es": [
      "Nada más entrar en el spa Ô des Cimes Le Centaure, la sensación de bienestar es inmediata y la actitud zen impregna el espacio. Relájese al máximo."
    ]
  },
  "rdfs:label": {
