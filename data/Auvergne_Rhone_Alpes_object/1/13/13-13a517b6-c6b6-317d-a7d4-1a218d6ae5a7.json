  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie die Aromen unserer Region. Gepflegte Küche. Unser Restaurant bietet auch ein \"Drive\"-Menü an. Die Speisekarte finden Sie auf unserer Facebook-Seite und unserer Website."
    ],
    "en": [
      "Good food inviting you to taste the various flavours of Ardèche. We offer a takeaway service (menu available on our Facebook page and website)."
    ],
    "it": [
      "Venite a scoprire i sapori della nostra regione. Una cucina meticolosa. Il nostro ristorante offre anche un menu \"drive\", disponibile sulla nostra pagina Facebook e sul nostro sito web."
    ],
    "fr": [
      "Venez découvrir les saveurs de notre terroir. Cuisine soignée. Notre restaurant propose également un menu \"drive\", carte disponible sur notre page Facebook et notre site web."
    ],
    "es": [
      "Venga a descubrir los sabores de nuestra región. Cocina esmerada. Nuestro restaurante también ofrece un menú \"drive\", disponible en nuestra página de Facebook y en nuestro sitio web."
    ],
    "nl": [
      "Kom en ontdek de smaken van onze regio. Een verfijnde keuken. Ons restaurant biedt ook een \"drive\" menu, beschikbaar op onze Facebook pagina en onze website."
    ]
  },
