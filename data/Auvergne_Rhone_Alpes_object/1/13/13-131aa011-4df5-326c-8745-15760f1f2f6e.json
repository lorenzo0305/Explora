  "rdfs:comment": {
    "de": [
      "Direktverkauf von Noix de Grenoble AOP Kaliber +30 mm, nativem Nussöl 1. Pressung Silbermedaille beim Concours Général Agricole 2019 und 2020, Goldmedaille 2022 und Prix d'Excellence 2023. Karamellisierte Walnüsse und Gourmet-Sets."
    ],
    "en": [
      "Direct sales of Noix de Grenoble AOP calibre +30 mm, virgin walnut oil 1st pressing silver medal at the Concours Général Agricole 2019 and 2020, gold medal in 2022 and prix d'excellence in 2023. Caramelized walnuts and gourmet boxes."
    ],
    "it": [
      "Vendita diretta di Noix de Grenoble DOP, calibro +30 mm, olio di noce vergine di prima spremitura, medaglia d'argento al Concours Général Agricole nel 2019 e 2020, medaglia d'oro nel 2022 e Prix d'Excellence nel 2023. Noci caramellate e scatole gourmet."
    ],
    "fr": [
      "Vente directe de Noix de Grenoble AOP calibre +30 mm, huile de noix vierge 1ère pression médaille d'argent au Concours Général Agricole 2019 et 2020, médaille d'or en 2022 et prix d'excellence en 2023. Noix caramélisées et coffrets gourmands."
    ],
    "es": [
      "Venta directa de Noix de Grenoble DOP, calibre +30 mm, aceite de nuez virgen de 1ª prensada, medalla de plata en el Concours Général Agricole en 2019 y 2020, medalla de oro en 2022 y Prix d'Excellence en 2023. Nueces caramelizadas y cajas gourmet."
    ],
    "nl": [
      "Directe verkoop van Noix de Grenoble BOB, grootte +30 mm, virgin 1st press walnootolie, zilveren medaille op het Concours Général Agricole in 2019 en 2020, gouden medaille in 2022 en Prix d'Excellence in 2023. Gekarameliseerde walnoten en gastronomische doosjes."
    ]
  },
  "rdfs:label": {
