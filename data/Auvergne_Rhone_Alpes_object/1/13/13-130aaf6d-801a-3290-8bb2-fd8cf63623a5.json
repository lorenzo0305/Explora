  "rdfs:comment": {
    "de": [
      "Schon bei Ihrer Ankunft im Alpagio, dem Restaurant des Hotels Alparena**** und Spa, sind die holzgeschnitzte Bar, der Weinkeller und der Panoramablick auf die Berge und den Ort der Auftakt zu einer gastronomischen Einladung."
    ],
    "en": [
      "Upon your arrival at the Alpagio, restaurant of the Hotel Alparena **** et Spa, the carved wooden bar, the stylish wine cellar, the panoramic view of the mountains and the resort, are all preambles to a gastronomic invitation."
    ],
    "it": [
      "Appena arrivati all'Alpagio, il ristorante dell'Hotel Alparena**** e Spa, il bar in legno intagliato, la cantina e la vista panoramica sulle montagne e sul resort sono il preludio a un invito gastronomico."
    ],
    "fr": [
      "Dès votre arrivée à l’Alpagio, restaurant de l’Hôtel Alparena**** et Spa, le bar en bois sculpté, la cave à vins, la vue panoramique sur les montagnes et la station, sont autant de préambules à une invitation gastronomique."
    ],
    "nl": [
      "Zodra je aankomt in l'Alpagio, het restaurant van Hotel Alparena**** and Spa, zijn de uit hout gesneden bar, de wijnkelder en het panoramische uitzicht op de bergen en het resort allemaal voorbode van een gastronomische uitnodiging."
    ],
    "es": [
      "Nada más llegar a l'Alpagio, el restaurante del Hotel Alparena**** and Spa, el bar de madera tallada, la bodega y la vista panorámica de las montañas y la estación son preludios de una invitación gastronómica."
    ]
  },
