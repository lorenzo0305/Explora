  "rdfs:comment": {
    "de": [
      "Diese Route ist eine Variante der Balcons de Valloire und führt Sie auf der Seite von Valmeinier auf dem Weg des Postboten. Ein schöner Abstecher, der Ihnen einige sehr schöne Passagen durch den Staatswald bietet."
    ],
    "en": [
      "This route is a variant of the Balcons de Valloire and takes you to Valmeinier, on the postman's path. A nice hook that will give you very beautiful passages in the national forest."
    ],
    "it": [
      "Questo percorso è una variante dei Balcons de Valloire e porta a Valmeinier, sul Chemin du facteur. È una bella deviazione attraverso la foresta demaniale."
    ],
    "fr": [
      "Cet itinéraire est une variante des Balcons de Valloire et vous emmène  du côté de Valmeinier, sur le chemin du facteur. Un joli crochet qui vous offrira de très beaux passages dans la forêt domaniale."
    ],
    "es": [
      "Esta ruta es una variante de los Balcons de Valloire y le lleva a Valmeinier, en el Chemin du facteur. Es un bonito desvío a través del bosque estatal."
    ],
    "nl": [
      "Deze route is een variant van de Balcons de Valloire en brengt je naar Valmeinier, op de Chemin du facteur. Het is een mooie omweg door het staatsbos."
    ]
  },
  "rdfs:label": {
