  "rdfs:comment": {
    "de": [
      "Kollektive und lokale Verkaufsstelle, alle Produkte stammen von den Bauernhöfen der Erzeuger, ohne Zwischenhändler. Es handelt sich um frische Qualitätsprodukte, deren Rückverfolgbarkeit gewährleistet ist."
    ],
    "en": [
      "A collective and local point of sale, all the products come from the producers' farms, without intermediaries. They are fresh quality products whose traceability is assured."
    ],
    "it": [
      "Punto vendita collettivo e locale, tutti i prodotti provengono dalle aziende agricole dei produttori, senza intermediari. Si tratta di prodotti freschi e di qualità con tracciabilità garantita."
    ],
    "fr": [
      "Point de vente collectif et de proximité, tous les produits sont issus des fermes des producteurs, sans intermédiaire. Ce sont des produits frais de qualité dont la traçabilité est assurée."
    ],
    "es": [
      "Punto de venta colectivo y local, todos los productos proceden de las explotaciones de los productores, sin intermediarios. Se trata de productos frescos de calidad con trazabilidad garantizada."
    ],
    "nl": [
      "Collectief en lokaal verkooppunt, alle producten komen van de boerderijen van de producenten, zonder tussenpersonen. Dit zijn verse kwaliteitsproducten met een gegarandeerde traceerbaarheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le panier paysan"
    ]
  },
