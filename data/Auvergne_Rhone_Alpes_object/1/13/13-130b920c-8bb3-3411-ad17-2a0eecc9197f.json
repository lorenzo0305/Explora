  "rdfs:comment": {
    "de": [
      "Mediathek mit über 900 DVDs, Audio-CDs und Spielen. Kostenpflichtige Computerverbindungen stehen zur Verfügung, kostenpflichtige Ausdrucke. Kostenloses WLAN und Scannen. Über 4000 Bücher (Romane, Literaturpreise, Comics, Alben, Zeitschriften...). Temporäre Ausstellungen."
    ],
    "en": [
      "Media library with over 900 DVDs, audio CDs and games. Pay-per-use computer connections available, paid printing. Free WiFi and scanning. Over 4,000 books (novels, literary prizes, comics, albums, magazines, etc.). Temporary exhibitions."
    ],
    "it": [
      "Mediateca con oltre 900 DVD, CD audio e giochi. Connessioni informatiche a pagamento e stampa a pagamento. Wi-Fi e scansione gratuiti. Oltre 4.000 libri (romanzi, premi letterari, fumetti, album, riviste, ecc.). Mostre temporanee."
    ],
    "fr": [
      "Médiathèque avec plus de 900 DVD, CD-audio et jeux. Connexions payantes sur ordinateur à disposition,  impressions payantes. Wifi et scan gratuits. Plus de 4000 livres (romans, prix littéraires, BD, albums, magazines...). Expositions temporaires."
    ],
    "nl": [
      "Mediatheek met meer dan 900 dvd's, audio-cd's en spelletjes. Computeraansluitingen beschikbaar tegen betaling, printen beschikbaar tegen betaling. Gratis Wi-Fi en scannen. Meer dan 4.000 boeken (romans, literaire prijzen, strips, albums, tijdschriften, enz.) Tijdelijke tentoonstellingen."
    ],
    "es": [
      "Mediateca con más de 900 DVD, CD de audio y juegos. Conexiones informáticas de pago, impresión de pago. Wi-Fi y escáner gratuitos. Más de 4.000 libros (novelas, premios literarios, cómics, álbumes, revistas, etc.). Exposiciones temporales."
    ]
  },
