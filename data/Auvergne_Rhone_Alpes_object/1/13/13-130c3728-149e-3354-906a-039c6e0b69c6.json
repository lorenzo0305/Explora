  "rdfs:comment": {
    "de": [
      "In einem modernen, industriellen Dekor bietet Ihnen die Brasserie des Ceutrons eine einfache und großzügige Küche in einer sehr warmen und geselligen Atmosphäre!"
    ],
    "en": [
      "In a modern and industrial setting, the Brasserie des Ceutrons offers simple and generous cuisine in a very warm and friendly atmosphere!"
    ],
    "it": [
      "In un ambiente moderno e industriale, la Brasserie des Ceutrons offre una cucina semplice e generosa in un'atmosfera calda e accogliente!"
    ],
    "fr": [
      "Dans un décor moderne et industriel, la brasserie des Ceutrons vous propose une cuisine simple et généreuse dans une ambiance très chaleureuse et conviviale !"
    ],
    "nl": [
      "In een moderne, industriële omgeving biedt de Brasserie des Ceutrons eenvoudige, gulle gerechten in een warme, vriendelijke sfeer!"
    ],
