  "rdfs:comment": {
    "de": [
      "Der Verein Accueil Interculturel en Royans fördert die Integration und den kulturellen Austausch durch Workshops und Veranstaltungen und schafft solidarische Verbindungen zwischen Einwohnern und Neuankömmlingen."
    ],
    "en": [
      "The Association Accueil Interculturel en Royans promotes integration and cultural exchange through workshops and events, creating bonds of solidarity between residents and new arrivals."
    ],
    "it": [
      "L'Associazione Accueil Interculturel en Royans promuove l'integrazione e lo scambio culturale attraverso workshop ed eventi, creando legami di solidarietà tra residenti e nuovi arrivati."
    ],
    "fr": [
      "L'Association Accueil Interculturel en Royans favorise l'intégration et l'échange culturel par des ateliers et événements, créant des liens solidaires entre habitants et nouveaux arrivants."
    ],
    "es": [
      "La Asociación Accueil Interculturel en Royans fomenta la integración y el intercambio cultural mediante talleres y actos, creando lazos de solidaridad entre residentes y recién llegados."
    ],
    "nl": [
      "De Association Accueil Interculturel en Royans bevordert integratie en culturele uitwisseling door middel van workshops en evenementen en creëert solidariteitsbanden tussen bewoners en nieuwkomers."
    ]
  },
