  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine wunderschöne Granitklippe, die sich in der Verlängerung der Klippe von Pontamafrey befindet. Nach einem 5-minütigen Anmarsch entdecken Sie eine Klippe, die sich ideal für Anfänger eignet."
    ],
    "en": [
      "Discover a superb granite cliff located in the continuation of the Pontamafrey cliff. After a 5-minute approach walk, you'll discover a cliff ideal for beginners."
    ],
    "it": [
      "Scoprite una superba falesia di granito situata nella continuazione della falesia di Pontamafrey. Dopo una passeggiata di avvicinamento di 5 minuti, scoprirete una falesia ideale per i principianti."
    ],
    "fr": [
      "Découvrez une superbe falaise de granit située dans le prolongement de la falaise de Pontamafrey. Après 5 minutes de marche d'approche, vous découvrirez une falaise idéale pour de l'initiation."
    ],
    "nl": [
      "Ontdek een prachtige granieten klif in het verlengde van de Pontamafrey-klif. Na een aanloop van 5 minuten ontdek je een klif die ideaal is voor beginners."
    ],
    "es": [
      "Descubra un magnífico acantilado de granito situado en la continuación del acantilado de Pontamafrey. Tras un paseo de aproximación de 5 minutos, descubrirá un acantilado ideal para principiantes."
    ]
  },
