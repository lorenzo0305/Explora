  "rdfs:comment": {
    "de": [
      "Landweine von Coteaux de l'Ardèche, IGP : rot, rosé, weiß. Rebweinarten\r\n: Gamay, Merlot, Syrah, Cabernet, Chatus, Pinot, Viognier, Chardonnay,\r\nSauvignon. Ganzjährig geöffnet."
    ],
    "en": [
      "Lablachère’s vineyards offer a wide variety of fruity, elegant\r\nand original red, white and rosé wines that proudly proclaim\r\ntheir local origins Trias Cévenol. The vineyard is spread out\r\nover 400 hectares (nearly 1000 acres) of terraces at an altitude\r\nof 200 to 500 meters. Currently, the cooperative, whose\r\nproduction is sold directly (on site, Internet CHR, GD) by the\r\nbottle or bag-in-box, has nearly 100 members-growers."
    ],
    "it": [
      "Degustazioni, vendita, sentiero del vino (8 km, gratuito e segnalato). Venite a scoprire lo Chatus e altre annate pregiate di questa terra dai mille sapori."
    ],
    "fr": [
      "Dégustation, vente, sentier vignerons (8 km, libre et fléché). Sur ce terroir aux multiples saveurs, venez découvrir le Chatus et d’autres belles cuvées."
    ],
    "nl": [
      "Streekwijnen van Coteaux de l’Ardèche, IGP: rood, rosé, wit. Wijnsoorten:\r\nGamay, Merlot, Syrah, Cabernet, Chatus, Pinot, Viognier, Chardonnay,\r\nSauvignon.\r\nHele jaar geopend."
    ],
    "es": [
      "Degustaciones, ventas, ruta del vino (8 km, gratuita y señalizada). Venga a descubrir el Chatus y otras buenas cosechas de esta tierra de sabores."
    ]
  },
