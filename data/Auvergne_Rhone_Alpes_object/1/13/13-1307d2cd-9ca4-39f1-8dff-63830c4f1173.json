  "rdfs:comment": {
    "de": [
      "Im Winter wird der vom Eis erstarrte See zu einer natürlichen Eisbahn und einem Paradies für Schneegleitaktivitäten: Schlittschuhlaufen und Rodeln"
    ],
    "en": [
      "In winter, frozen by the ice, the lake becomes a natural skating rink and a paradise for snow activities: ice skating and sledging"
    ],
    "it": [
      "In inverno, ghiacciato dal ghiaccio, il lago diventa una pista di pattinaggio naturale e un paradiso per le attività sulla neve: pattinaggio e slittino"
    ],
    "fr": [
      "En hiver, figé par la glace, le plan d’eau devient une patinoire naturelle et un paradis pour les activités de glisse avec la neige : patin à glace et luge"
    ],
    "nl": [
      "In de winter, bevroren door het ijs, wordt het meer een natuurlijke schaatsbaan en een paradijs voor sneeuwactiviteiten: schaatsen en sleeën"
    ],
    "es": [
      "En invierno, congelado por el hielo, el lago se convierte en una pista de patinaje natural y en un paraíso para las actividades de nieve: patinaje sobre hielo y trineos"
    ]
  },
