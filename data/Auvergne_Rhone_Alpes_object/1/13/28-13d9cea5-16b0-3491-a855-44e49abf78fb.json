      "rdfs:comment": {
        "de": [
          "Landwirtschaftsbetrieb im Herzen von Flandern. Entdecken Sie die Bio-Kartoffel Sorte CAROLUS, unbehandelt mit dem Gütesiegel AB und Je suis de Flandre."
        ],
        "en": [
          "Farm in the heart of Flanders. Discover the CAROLUS organic potato variety, untreated, with the AB and Je suis de Flandre label."
        ],
        "it": [
          "Azienda agricola nel cuore delle Fiandre. Scoprite la varietà di patate biologiche CAROLUS, non trattate, con il marchio AB e Je suis de Flandre."
        ],
        "fr": [
          "Exploitation agricole au Coeur de Flandre. Découvrez la pomme de terre Bio variété CAROLUS, sans traitement labellisée AB et Je suis de Flandre."
        ],
        "es": [
          "Granja en el corazón de Flandes. Descubra la variedad de patata ecológica CAROLUS, sin tratar, con la etiqueta AB y Je suis de Flandre."
        ],
        "nl": [
          "Boerderij in het hart van Vlaanderen. Ontdek de biologische aardappelvariëteit CAROLUS, onbehandeld, met het AB en Je suis de Flandre label."
        ]
      },
