      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nMontag von 14:00 bis 19:00 Uhr\nDienstag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 12:30 Uhr\n\nSonntag geschlossen\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday, 2pm to 7pm\nTuesday to Friday, 9am to 12pm and 2pm to 7pm\nSaturday from 9h to 12h30\n\nClosed on Sunday\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nLunedì dalle 14:00 alle 19:00\nDa martedì a venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 12.30\n\nChiuso la domenica\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nLe lundi de 14h à 19h\nDu mardi au vendredi de 9h à 12h et de 14h à 19h\nLe samedi de 9h à 12h30 \n\nFermeture le dimanche\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nMaandag van 14u tot 19u\nDinsdag tot vrijdag van 9u tot 12u en van 14u tot 19u\nZaterdag van 9u tot 12u30\n\nZondag gesloten\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nLunes de 14h a 19h\nDe martes a viernes de 9h a 12h y de 14h a 19h\nSábado de 9h a 12h30\n\nDomingos cerrado\n\n "
        ]
