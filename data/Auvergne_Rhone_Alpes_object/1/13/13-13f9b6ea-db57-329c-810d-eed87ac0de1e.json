  "rdfs:comment": {
    "de": [
      "Raphael bietet Ihnen seine Gemüsekörbe an, die im Bio-Gemüseanbau mit tierischer Zugkraft produziert werden. Gaocho, ein wunderschönes, sechsjähriges Auvergne-Pferd, sorgt für die Zugkraft."
    ],
    "en": [
      "Raphael offers you baskets of vegetables produced using organic farming methods and animal traction. Gaocho, a magnificent 6-year-old Auvergne horse, provides the traction."
    ],
    "it": [
      "Raphael vi offre cesti di verdure coltivate con metodi biologici e a trazione animale. Gaocho, un magnifico cavallo d'Alvernia di 6 anni, fornisce la trazione."
    ],
    "fr": [
      "Raphael vous propose ses paniers de légumes produits en maraichage bio et traction animale. C'est Gaocho, magnifique cheval d'Auvergne de 6 ans qui assure la traction."
    ],
    "es": [
      "Raphael le ofrece cestas de verduras cultivadas con métodos ecológicos y tracción animal. Gaocho, un magnífico caballo auvernés de 6 años, se encarga de la tracción."
    ],
    "nl": [
      "Raphael biedt je manden met groenten die zijn verbouwd met biologische methoden en tractie door dieren. Gaocho, een prachtig 6-jarig Auvergne paard, zorgt voor de tractie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "DESARCE Raphaël"
    ]
  },
