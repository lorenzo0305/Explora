  "rdfs:comment": {
    "de": [
      "Das Hotel Restaurant Lesdiguières ist eine Ausbildungsstätte des Lycée des Métiers de l'Hôtellerie & Tourisme in Grenoble. Die Schüler in Ausbildung stellen Ihnen unter dem wohlwollenden Blick ihrer Lehrer ihr ganzes Können zur Verfügung."
    ],
    "en": [
      "Lesdiguières is a hands-on training center belonging to the Hotel and Tourism Industry vocational high school of Grenoble. Students in training serve you, putting to use what they've learned in class under the watchful eye of their professors."
    ],
    "it": [
      "L'hotel ristorante Lesdiguières è uno stabilimento di applicazione del Lycée des Métiers del'Hôtellerie & Tourisme di Grenoble. Gli studenti in formazione mettono a Sua disposizione tutto il loro know-how sotto lo sguardo benevolo dei loro insegnanti."
    ],
    "fr": [
      "L'hôtel restaurant Lesdiguières est un établissement d'application du Lycée des Métiers de l'Hôtellerie & Tourisme de Grenoble. Les élèves en formation mettent tout leur savoir faire à votre disposition sous le regard bienveillant de leurs professeurs."
    ],
    "nl": [
      "Het hotelrestaurant Lesdiguières is een opleidingsinstelling van het Lycée des Métiers de l'Hôtellerie & Tourisme in Grenoble. De studenten in opleiding stellen al hun kennis ter beschikking onder het welwillend oog van hun leraren."
    ],
    "es": [
      "El hotel y restaurante Lesdiguières es una institución de práctica del instituto de profesiones de la hostelería y del turismo de Grenoble. Los alumnos en curso de formación ponen su pericia a su servicio, supervisados por sus profesores."
    ]
  },
