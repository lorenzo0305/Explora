  "rdfs:comment": {
    "de": [
      "Eine abwechslungsreiche Speisekarte mit frischen, lokalen und saisonalen Produkten, die von uns selbst zubereitet werden. Tagesmenü (Vorspeise, Hauptgericht, Käse oder Dessert) unter der Woche außer dienstags und an Feiertagen."
    ],
    "en": [
      "A varied menu featuring fresh, local, seasonal produce cooked by us. Menu of the day (starter, main course, cheese or dessert) weekdays except Tuesdays and public holidays."
    ],
    "it": [
      "Un menu vario, con prodotti freschi, locali e di stagione cucinati da noi. Menu del giorno (antipasto, piatto principale, formaggio o dessert) nei giorni feriali, tranne il martedì e i giorni festivi."
    ],
    "fr": [
      "Une carte variée, des produits frais et locaux, de saison cuisinés par nos soins. Menu du jour (entrée, plat, fromage ou dessert) en semaine sauf mardi et jours fériés."
    ],
    "es": [
      "Una carta variada, con productos frescos, locales y de temporada cocinados por nosotros. Menú del día (entrante, plato principal, queso o postre) entre semana, excepto martes y festivos."
    ],
    "nl": [
      "Een gevarieerd menu, met verse, lokale, seizoensgebonden producten door ons bereid. Dagmenu (voorgerecht, hoofdgerecht, kaas of dessert) op weekdagen behalve dinsdag en feestdagen."
    ]
  },
