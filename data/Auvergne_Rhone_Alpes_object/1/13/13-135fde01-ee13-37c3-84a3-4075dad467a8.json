  "rdfs:comment": {
    "de": [
      "Das Haus Clusel-Roch in Ampuis wurde über vier Generationen von leidenschaftlichen Landbesitzern aufgebaut, die jeweils ihren eigenen Beitrag zum Bau des Hauses geleistet haben."
    ],
    "en": [
      "The House of Clusel-Roch, located in Ampuis, has been built up over 4 generations of people with a passion for the land, each of whom has made their own contribution."
    ],
    "it": [
      "Il Domaine Clusel-Roch, situato ad Ampuis, è stato costruito da 4 generazioni di persone con la passione per la terra, ognuna delle quali ha dato il proprio contributo."
    ],
    "fr": [
      "Le Domaine Clusel-Roch, situé à Ampuis s'est construit sur 4 générations de passionnés de la terre, qui chacune ont apporté leur pierre à l'édifice."
    ],
    "es": [
      "El Domaine Clusel-Roch, situado en Ampuis, ha sido construido a lo largo de 4 generaciones de personas apasionadas por la tierra, cada una de las cuales ha aportado su propia contribución."
    ],
    "nl": [
      "Domaine Clusel-Roch, gelegen in Ampuis, is opgebouwd over 4 generaties van mensen met een passie voor het land, die elk hun eigen bijdrage hebben geleverd."
    ]
