  "rdfs:comment": {
    "de": [
      "Rote Früchte, Walnuss- und Kastanienbäume werden an den Ausläufern des Waldes von Saou in einem verantwortungsbewussten Verfahren angebaut. Die Früchte werden direkt auf dem Hof zu Marmeladen verarbeitet."
    ],
    "en": [
      "From century-old walnut trees and fruit trees, in the deepest depths of the Saoû forest, we make oil, shelled nuts and jams (raspberry, redcurrant, blackcurrant, strawberry, plum, fig, quince…and walnut)."
    ],
    "it": [
      "Bacche rosse, noci, castagne e altri alberi da frutto sono coltivati ai piedi della foresta di Saou nell'ambito di un approccio responsabile. La frutta viene trasformata in marmellata direttamente in azienda."
    ],
    "fr": [
      "Fruits rouge, noyers, châtaigniers, arbres fruitiers sont cultivés sur les contreforts de la forêt de Saou dans une démarche responsable. Les fruits sont transformés en confitures directement à la ferme."
    ],
    "nl": [
      "Honderd jaar oude notenbomen en fruitbomen op de uitlopers van het bos van Saoû worden getransformeerd in olie, gepelde noten, en jam (frambozen, aalbessen, aardbei, pruimen, vijgen, kweeperen...en noten)."
    ],
    "es": [
      "En las estribaciones del bosque de Saou se cultivan bayas rojas, nueces, castañas y otros frutales de forma responsable. La fruta se transforma en mermelada directamente en la granja."
    ]
  },
