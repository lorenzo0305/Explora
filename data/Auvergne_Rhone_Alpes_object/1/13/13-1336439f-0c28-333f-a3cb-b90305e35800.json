  "rdfs:comment": {
    "de": [
      "Die Ferme de Santigny bietet Ihnen Gemüse der Saison mit dem Ziel, dass Sie die Frische, die Einfachheit und den guten Geschmack der Produkte wiederentdecken."
    ],
    "en": [
      "Strawberries, melons, vegetables, fir trees"
    ],
    "it": [
      "La Ferme de Santigny vi offre verdure di stagione con l'obiettivo di farvi riscoprire la freschezza, la semplicità e il buon gusto dei prodotti."
    ],
    "fr": [
      "La Ferme de Santigny vous propose des légumes de saison avec pour objectif de vous faire redécouvrir la fraîcheur, la simplicité et le bon goût des produits."
    ],
    "es": [
      "La Ferme de Santigny le ofrece verduras de temporada con el objetivo de hacerle redescubrir la frescura, la sencillez y el buen gusto de los productos."
    ],
    "nl": [
      "La Ferme de Santigny biedt u seizoensgroenten aan met als doel u de versheid, eenvoud en goede smaak van de producten te laten herontdekken."
    ]
  },
