  "rdfs:comment": {
    "de": [
      "Kommen Sie nach Saoû und genießen Sie zwei Tage lang ein Fest, das nach Ziegenbock riecht! Seit über 40 Jahren ist der dritte Sonntag im Juli für die Einwohner von Saoû ein Muss!  Markt mit lokalen Produkten, Imbiss mit Verkauf zum Mitnehmen."
    ],
    "en": [
      "Come to Saoû for two days of goat-scented festivities! For over 40 years, the 3rd Sunday in July has been a must for the people of Saoû!  Local produce fair, refreshment stand with take-away."
    ],
    "it": [
      "Venite a Saoû per due giorni di festa al profumo di capra! Da oltre 40 anni, la terza domenica di luglio è un appuntamento imperdibile per gli abitanti di Saoû!  Fiera dei prodotti locali, punto di ristoro con asporto."
    ],
    "fr": [
      "Venez à Saoû pour deux jours de fête qui sentent le bouc! Depuis plus de 40 ans, pour les habitants de Saoû, ce 3e dimanche de juillet est incontournable!  Foire de produits locaux, buvette avec vente à emporter."
    ],
    "es": [
      "Venga a Saoû para disfrutar de dos días de fiesta con olor a cabra Desde hace más de 40 años, el 3er domingo de julio es una cita ineludible para los habitantes de Saoû  Feria de productos locales, bar con comida para llevar."
    ],
    "nl": [
      "Kom naar Saoû voor twee dagen geitengeurfeest! Al meer dan 40 jaar is de 3e zondag in juli een must voor de inwoners van Saoû!  Markt met streekproducten, bar met afhaalmaaltijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête du Picodon et autres fromages de chèvre"
    ]
  },
