  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Ziegelei aus dem späten 19. und frühen 20. Jahrhundert, die mit allen funktionstüchtigen Maschinen ausgestattet und kürzlich restauriert wurde!"
    ],
    "en": [
      "Discover a late 19th - early 20th century tile factory, equipped with all its machinery in working order and recently restored!"
    ],
    "it": [
      "Scoprite una fabbrica di piastrelle di fine Ottocento-inizio Novecento, con tutti i suoi macchinari funzionanti e recentemente restaurati!"
    ],
    "fr": [
      "Découvrez une tuilerie de fin XIXème - début XXème siècle, équipée de toutes ses machines en état de fonctionnement et restaurée récemment !"
    ],
    "nl": [
      "Ontdek een laat 19e - vroeg 20e eeuwse tegelfabriek, met alle machines in werkende staat en onlangs gerestaureerd!"
    ],
    "es": [
      "Descubra una fábrica de azulejos de finales del siglo XIX y principios del XX, con toda su maquinaria en funcionamiento y recientemente restaurada"
    ]
  },
