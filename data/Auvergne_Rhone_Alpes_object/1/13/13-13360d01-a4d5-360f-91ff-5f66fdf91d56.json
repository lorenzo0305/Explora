  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Reiterhof Le Foussac Laurence und ihr Team begrüßen Sie im Herzen der Ardèche, 5 Minuten von Les Vans entfernt, in einer außergewöhnlichen natürlichen Umgebung."
    ],
    "en": [
      "Welcome to the equestrian farm le Foussac Laurence and her team welcome you in the heart of the Ardèche, 5 minutes from Les Vans, in an exceptional natural setting."
    ],
    "it": [
      "Benvenuti all'allevamento di cavalli Foussac Laurence e il suo team vi danno il benvenuto nel cuore dell'Ardèche, a 5 minuti da Les Vans, in un contesto naturale eccezionale."
    ],
    "fr": [
      "Bienvenue à la ferme équestre le Foussac Laurence et son équipe vous accueille au cœur de l’Ardèche, à 5 minutes des Vans, dans un cadre naturel exceptionnel."
    ],
    "nl": [
      "Welkom op de paardenboerderij van Foussac Laurence en haar team heten u welkom in het hart van de Ardèche, op 5 minuten van Les Vans, in een uitzonderlijke natuurlijke omgeving."
    ],
    "es": [
      "Bienvenido a la granja ecuestre de Foussac Laurence y su equipo le dan la bienvenida al corazón del Ardèche, a 5 minutos de Les Vans, en un marco natural excepcional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme équestre \"Le Foussac\""
    ]
  },
