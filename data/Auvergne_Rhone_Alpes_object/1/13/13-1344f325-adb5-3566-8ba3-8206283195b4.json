  "rdfs:comment": {
    "de": [
      "Über den Bärenpfad gelangen Sie in das Naturschutzgebiet von Tueda und halten Ihre Augen offen: Der Wald aus Cembros-Kiefern ist mystisch und mit etwas Glück können Sie einen Hasen oder Hirsche sehen!"
    ],
    "en": [
      "Taking the run named 'OURS' (Bear), you will enjoy the mystical Cembros Pines forest and with a little luck, see some hare or some deers!"
    ],
    "it": [
      "Seguendo il Sentiero dell'Orso, entrate nella riserva naturale di Tueda e tenete gli occhi ben aperti: la pineta di Cembros è mistica e con un po' di fortuna potreste avvistare una lepre o qualche cervo!"
    ],
    "fr": [
      "En empruntant la piste de l'Ours, entrez dans la réserve naturelle de Tueda et ouvrez grand vos yeux : la foret de Pins Cembros est mystique et avec un peu de chance, vous pourrez apercevoir un lièvre ou des cervidés !"
    ],
    "es": [
      "Siguiendo la Senda del Oso, entre en la reserva natural de Tueda y mantenga los ojos bien abiertos: el pinar de Cembros es místico y, con un poco de suerte, ¡podría avistar una liebre o algún ciervo!"
    ],
    "nl": [
      "Neem het Berenpad naar het natuurgebied Tueda en houd uw ogen open: het dennenbos van Cembros is mystiek en met een beetje geluk ziet u misschien een haas of een hert!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Slope Ours"
    ],
    "fr": [
      "Piste de l'Ours"
    ],
    "nl": [
      "Bear Trail"
    ]
  },
