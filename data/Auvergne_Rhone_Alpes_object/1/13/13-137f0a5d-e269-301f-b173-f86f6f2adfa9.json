  "rdfs:comment": {
    "de": [
      "Einziger Verleih von Ausrüstung, die speziell für die sichere Ausübung der Via Ferrata entwickelt wurde. Eine Reservierung wird dringend empfohlen.\r\nBar und Verpflegung vor Ort möglich."
    ],
    "en": [
      "The only point of rental of specific equipment for the practice of Via Ferrata in complete safety. Reservation strongly advised.\r\nBar and catering available on site."
    ],
    "it": [
      "L'unico punto in cui è possibile noleggiare l'attrezzatura specifica per arrampicare in sicurezza sulla Via Ferrata. Si consiglia vivamente la prenotazione.\r\nBar e ristorante disponibili in loco."
    ],
    "fr": [
      "Unique point de location de matériel spécifique à la pratique de la Via Ferrata en toute sécurité. Réservation fortement conseillée.\r\nBar et restauration possible sur place."
    ],
    "nl": [
      "Het enige punt waar u specifiek materiaal kunt huren voor veilig Via Ferrata klimmen. Reserveren wordt sterk aangeraden.\r\nBar en restaurant ter plaatse."
    ],
    "es": [
      "El único punto donde se puede alquilar material específico para escalar vías ferratas con seguridad. Se recomienda encarecidamente reservar.\r\nBar y restaurante en las instalaciones."
    ]
  },
