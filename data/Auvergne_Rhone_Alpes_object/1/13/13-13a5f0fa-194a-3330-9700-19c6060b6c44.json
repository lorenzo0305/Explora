  "rdfs:comment": {
    "de": [
      "Restaurant mit bretonischen Spezialitäten. Hier finden Sie Galettes, die mit Buchweizenmehl gebacken werden, sowie süße Crêpes, die mit Weizenmehl zubereitet werden.\r\nSie werden auch andere Spezialitäten direkt aus der Bretagne probieren."
    ],
    "en": [
      "Restaurant of Breton specialities. You will discover the galettes cooked with buckwheat flour, as well as pancakes sweetened with wheat flour.\r\nWe will also taste other specialities directly from Brittany."
    ],
    "it": [
      "Ristorante con specialità bretoni. Scoprirete galette cucinate con farina di grano saraceno e frittelle dolci preparate con farina di grano.\r\nÈ inoltre possibile degustare altre specialità direttamente dalla Bretagna."
    ],
    "fr": [
      "Restaurant de spécialités bretonnes. Vous y découvrirez les galettes cuisinées à la farine de sarrasin, ainsi que des crêpes sucrées à la farine de froment.\r\nVous dégusterez également d'autres spécialités directement en provenance de Bretagne."
    ],
    "es": [
      "Restaurante que sirve especialidades bretonas. Descubrirá galletas cocinadas con harina de alforfón, así como tortitas dulces hechas con harina de trigo.\r\nTambién podrá degustar otras especialidades directamente desde Bretaña."
    ],
    "nl": [
      "Restaurant met Bretonse specialiteiten. U zult er galetten met boekweitmeel en zoete pannenkoeken met tarwemeel ontdekken.\r\nU kunt ook andere specialiteiten rechtstreeks uit Bretagne proeven."
    ]
  },
