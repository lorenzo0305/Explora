  "rdfs:comment": {
    "de": [
      "Montrond-les-Bains ist aufgrund seiner hydromineralischen Ressourcen und seiner Lage am Fluss Loire eine Stadt des Wohlbefindens und der Entspannung dank seiner Pflege- und Fitnesseinrichtungen (Etablissement Thermal, Iléades...) sowie seiner Freizeitangebote."
    ],
    "en": [
      "Montrond-les-Bains is a town of water because of its hydromineral resources and its location on the Loire River. It is also a town of well-being and relaxation thanks to its health and fitness establishments (Etablissement Thermal, Iléades, etc.) and leisure facilities."
    ],
    "it": [
      "Montrond-les-Bains è una città d'acqua grazie alle sue risorse idrominerali e alla sua posizione sul fiume Loira. È una città di benessere e relax grazie ai suoi stabilimenti di cura e fitness (Etablissement Thermal, Iléades, ecc.) e alle strutture per il tempo libero."
    ],
    "fr": [
      "Ville d’eau par sa ressource hydrominérale et sa situation sur le fleuve Loire, Montrond-les-Bains est une ville de bien-être et de détente grâce à ses établissements de soins et de remise en forme (Etablissement Thermal, Iléades...), et de loisirs."
    ],
    "nl": [
      "Montrond-les-Bains is een stad van het water, dankzij zijn waterbronnen en zijn ligging aan de Loire. Het is ook een stad van welzijn en ontspanning dankzij zijn gezondheids- en fitnessinstellingen (Etablissement Thermal, Iléades, enz.) en vrijetijdsvoorzieningen."
    ],
    "es": [
      "Montrond-les-Bains es una ciudad de agua gracias a sus recursos hidrominerales y a su ubicación en el río Loira. Es una ciudad de bienestar y relajación gracias a sus establecimientos de salud y fitness (Etablissement Thermal, Iléades, etc.) y de ocio."
    ]
  },
  "rdfs:label": {
