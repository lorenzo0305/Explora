  "rdfs:comment": {
    "de": [
      "La Ferme Intégrale, ein Startup-Unternehmen aus Drôme, das sich auf die Entwicklung von Aquaponik-Farmen in großem Maßstab spezialisiert hat, veranstaltet seinen zweiten Tag der offenen Tür, um der Öffentlichkeit seine erste Aquaponik-Farm vorzustellen."
    ],
    "en": [
      "Ferme Intégrale, a Drôme-based startup specializing in the development of large-scale aquaponic farms, is organizing its second Open House to introduce the general public to its first aquaponic farm."
    ],
    "it": [
      "Ferme Intégrale, una start-up con sede a Drôme specializzata nello sviluppo di fattorie acquaponiche su larga scala, organizza il suo secondo Open Day per presentare al pubblico la sua prima fattoria acquaponica."
    ],
    "fr": [
      "La Ferme Intégrale, startup drômoise spécialisée dans le développement de fermes aquaponiques à grande échelle, organise sa deuxième Journée portes ouvertes pour faire découvrir sa première ferme aquaponique au grand public."
    ],
    "es": [
      "Ferme Intégrale, empresa emergente de Drôme especializada en el desarrollo de granjas acuapónicas a gran escala, celebra su segunda jornada de puertas abiertas para mostrar al público su primera granja acuapónica."
    ],
    "nl": [
      "Ferme Intégrale, een in Drôme gevestigde start-up gespecialiseerd in de ontwikkeling van grootschalige aquaponic farms, houdt haar tweede Open Dag om haar eerste aquaponic farm aan het grote publiek te laten zien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journée portes ouvertes à la ferme intégrale"
    ]
  },
