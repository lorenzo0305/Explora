  "rdfs:comment": {
    "de": [
      "Jahrhundert (1858) und besitzt den höchsten Glockenturm im ehemaligen Gebiet der Montagnes du Matin. Ihr Inneres wurde renoviert, wobei insbesondere die Kanzel erhalten und die Steine sandgestrahlt wurden."
    ],
    "en": [
      "It dates back to the 19th century (1858) and boasts the highest bell tower in the former Montagnes du Matin territory. The interior has been renovated, with the pulpit preserved and the stones sandblasted."
    ],
    "it": [
      "Risale al XIX secolo (1858) e possiede il campanile più alto dell'ex regione delle Montagnes du Matin. L'interno è stato ristrutturato, conservando il pulpito e sabbiando la pietra."
    ],
    "fr": [
      "Elle date du 19ème siècle (1858) et possède le clocher le plus haut de l'ancien territoire des Montagnes du Matin. Son intérieur a été rénové avec notamment la conservation de la chaire et le sablage des pierres."
    ],
    "nl": [
      "Het dateert uit de 19e eeuw (1858) en heeft de hoogste klokkentoren in de voormalige regio Montagnes du Matin. Het interieur is gerenoveerd, waarbij de preekstoel bewaard is gebleven en het steenwerk is gezandstraald."
    ],
    "es": [
      "Data del siglo XIX (1858) y posee el campanario más alto de la antigua región de Montagnes du Matin. El interior ha sido renovado, conservándose el púlpito y arenándose la cantería."
    ]
  },
