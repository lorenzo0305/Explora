  "rdfs:comment": {
    "de": [
      "2 000 Jahre Geschichte von Bourbon-l'Archambault, der kleinen Stadt mit dem großen Namen, werden Ihnen in einer intimen und gedämpften Atmosphäre zugänglich gemacht ... alles illustriert mit Modellen, Inszenierungen und Zeugenaussagen."
    ],
    "en": [
      "2,000 years of the history of Bourbon-l'Archambault, the little town with the big name, are brought to you in an intimate and hushed atmosphere... all illustrated with models, scenes and testimonials."
    ],
    "it": [
      "2.000 anni di storia di Bourbon-l'Archambault, la piccola città dal grande nome, vi vengono svelati in un'atmosfera intima e silenziosa... il tutto illustrato da modelli, scene e testimonianze."
    ],
    "fr": [
      "2 000 ans de l'histoire de Bourbon-l'Archambault, la petite ville au grand nom, se livrent à vous, dans une atmosphère intime et feutrée ... le tout illustré de maquettes, mises en scène et témoignages."
    ],
    "nl": [
      "2000 jaar geschiedenis van Bourbon-l'Archambault, het stadje met de grote naam, wordt u onthuld in een intieme en verstilde sfeer... geïllustreerd met maquettes, scènes en getuigenissen."
    ],
    "es": [
      "2.000 años de historia de Bourbon-l'Archambault, la pequeña ciudad con gran nombre, se le revelan en un ambiente íntimo y silencioso... todo ello ilustrado con maquetas, escenas y testimonios."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée Augustin Bernard"
    ]
  },
