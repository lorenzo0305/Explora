  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf ein Abenteuer mit dem blauen Orientierungslauf in Chanoux, 2,8 km im Herzen des Mont Vallier. Eine Naturaktivität für alle Niveaus, zwischen Kulturerbe, Sport und Entdeckung. Ideal für eine andere Art der Erkundung!"
    ],
    "en": [
      "Set off on an adventure with the blue orienteering course at Chanoux, 2.8 km from the heart of Mont Vallier. A nature activity for all levels, combining heritage, sport and discovery. Ideal for exploring in a different way!"
    ],
    "it": [
      "Partite all'avventura con il percorso blu di orienteering a Chanoux, a 2,8 km dal cuore del Mont Vallier. Un'attività naturalistica per tutti i livelli, che unisce patrimonio, sport e scoperta. Ideale per esplorare in modo diverso!"
    ],
    "fr": [
      "Partez à l'aventure avec le parcours d’orientation bleu à Chanoux, 2,8 km au cœur du mont Vallier. Une activité nature pour tous niveaux, entre patrimoine, sport et découverte. Idéal pour explorer autrement !"
    ],
    "es": [
      "Láncese a la aventura con el recorrido de orientación azul de Chanoux, a 2,8 km del corazón del Mont Vallier. Una actividad en la naturaleza para todos los niveles, que combina patrimonio, deporte y descubrimiento. Ideal para explorar de otra manera"
    ],
    "nl": [
      "Ga op avontuur met het blauwe oriëntatieparcours in Chanoux, op 2,8 km van het hart van Mont Vallier. Een natuuractiviteit voor alle niveaus, die erfgoed, sport en ontdekking combineert. Ideaal om op een andere manier op ontdekking te gaan!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours bleu d'orientation de Chanoux Vallier"
    ]
  },
