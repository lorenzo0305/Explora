            "de": [
              "Nach vorheriger Vereinbarung.\r\nAufgrund der Arbeit in den Weinbergen ist es ratsam, vor Ihrem Besuch auf dem Weingut anzurufen."
            ],
            "en": [
              "By appointment only.\r\nDue to the work in the vineyards, it is preferable to call before your visit to the estate."
            ],
            "it": [
