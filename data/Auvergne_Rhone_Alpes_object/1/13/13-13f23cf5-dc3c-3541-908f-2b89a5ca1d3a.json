  "rdfs:comment": {
    "de": [
      "Die Chèvrerie du Signal liegt in Attignat-Oncin, im regionalen Naturpark Chartreuse. Die Produkte aus der Milch des Hofes werden vor Ort verkauft. Entdecken Sie auch die Zucht, das Melken und die Käserei (nur für Kunden)."
    ],
    "en": [
      "At Attignat-Oncin, in the Chartreuse Natural Park, there is a peaceful alpine goat farm.  You can visit and buy some delicious farm-produced cheeses at the same time.  Worth seeing… milking time at 5.30 pm!"
    ],
    "it": [
      "L'allevamento di capre Signal si trova ad Attignat-Oncin, nel Parco Naturale Regionale della Chartreuse. I prodotti lattiero-caseari della fattoria sono venduti in loco. Per saperne di più sull'allevamento, la mungitura e la produzione di formaggio (solo per i clienti)."
    ],
    "fr": [
      "La chèvrerie du Signal est située à Attignat-Oncin, dans le Parc naturel régional de Chartreuse. Les produits issus du lait de la ferme sont vendus sur place. Découvrez également l'élevage, la traite et la fromagerie (réservé à la clientèle)."
    ],
    "es": [
      "La granja de cabras Signal está situada en Attignat-Oncin, en el Parque Natural Regional de la Chartreuse. Los productos lácteos de la granja se venden in situ. Más información sobre las instalaciones de cría, ordeño y quesería (sólo para clientes)."
    ],
    "nl": [
      "De geitenboerderij Signal ligt in Attignat-Oncin, in het regionale natuurpark Chartreuse. De melkproducten van de boerderij worden ter plekke verkocht. Kom meer te weten over de fokkerij, het melken en de kaasmakerij (alleen voor klanten)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Goat cheeses of the GAEC du Signal"
    ],
    "fr": [
      "Fromages de chèvre du GAEC du Signal"
    ]
  },
