  "rdfs:comment": {
    "de": [
      "Die Produktionsstätte des Hauses Cardot verarbeitet seit drei Generationen Kuhmilch aus der Region Drôme des Collines.\r\nDas Know-how der Familie kommt in unserer traditionellen Käseproduktion aus Rohmilch und unserem Sortiment an Milchdesserts zum Ausdruck."
    ],
    "en": [
      "The production workshops of the House of Cardot has been transforming milk from cows grazing in Drôme des Collines for 3 generations."
    ],
    "it": [
      "Il laboratorio di produzione della Maison Cardot lavora il latte vaccino della Drôme des Collines da tre generazioni.\r\nIl know-how di famiglia si esprime attraverso la produzione tradizionale di formaggi a latte crudo e la nostra gamma di dessert a base di latte."
    ],
    "fr": [
      "L'atelier de fabrication de la Maison Cardot transforme le lait de vache de la Drôme des Collines depuis 3 générations.\r\nLe savoir faire familial s'exprime à travers notre production fromagère traditionnelle au lait cru et notre gamme de dessert lacté."
    ],
    "nl": [
      "Het atelier van Maison Cardon produceert al 3 generaties lang koemelkproducten uit de Drôme des Collines."
    ],
    "es": [
      "El taller de producción de la Maison Cardot lleva tres generaciones transformando la leche de vaca de la región de la Drôme des Collines.\r\nEl saber hacer familiar se expresa a través de nuestra producción tradicional de queso de leche cruda y nuestra gama de postres lácteos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Cardot - Ferme du Rivoiron"
    ]
  },
