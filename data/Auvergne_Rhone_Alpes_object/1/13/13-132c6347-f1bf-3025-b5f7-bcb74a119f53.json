  "rdfs:comment": {
    "de": [
      "Die Hütte am Lac du Lou empfängt Sie im Vallon du Lou zwischen Val Thorens und Les Menuires.\r\n\r\nVerpflegung ohne Reservierung am Mittag möglich.\r\nFür den Abend ist eine Reservierung erforderlich."
    ],
    "en": [
      "The Lac du Lou mountain refuge welcomes you to the Lou valley between Val Thorens and Les Menuires.\r\n\r\nLunch available without reservation.\r\nReservations required for the evening."
    ],
    "it": [
      "Il rifugio Lac du Lou vi accoglie nella valle del Lou, tra Val Thorens e Les Menuires.\r\n\r\nPranzo disponibile senza prenotazione.\r\nPrenotazione obbligatoria per la sera."
    ],
    "fr": [
      "Le refuge du Lac du Lou vous accueille dans le vallon du Lou entre Val Thorens et Les Menuires.\r\n\r\nRestauration possible sans réservation le midi.\r\nRéservation obligatoire pour le soir."
    ],
    "es": [
      "El refugio Lac du Lou le da la bienvenida al valle del Lou, entre Val Thorens y Les Menuires.\r\n\r\nAlmuerzo disponible sin reserva.\r\nReserva obligatoria para la noche."
    ],
    "nl": [
      "De toevluchtsoord Lac du Lou heet je welkom in de Lou-vallei tussen Val Thorens en Les Menuires.\r\n\r\nLunch mogelijk zonder reservering.\r\nReserveren voor de avond is verplicht."
    ]
  },
