  "rdfs:comment": {
    "de": [
      "Seit 1998 ist Air La Plagne ein Team von professionellen Gleitschirmtaufen mit Titel, viel Erfahrung und vor allem Leidenschaft.\r\n\r\nAIR La Plagne bietet mehr als nur Taufen, es ist ein Abenteuer! Wir bieten auch Kunstflug auf hohem Niveau an."
    ],
    "en": [
      "Established in 1998, AIR La Plagne is a team of highly experienced and qualified pilots who are passionate about paragliding .\r\nMuch more than just paragliding flights, AIR La Plagne offers a real adventure and even top-level aerobatics!"
    ],
    "it": [
      "Dal 1998, Air La Plagne è un team di professionisti del parapendio qualificati, di grande esperienza e soprattutto appassionati.\r\n\r\nAIR La Plagne offre molto di più dei primi voli: è un'avventura! Offriamo anche acrobazie di alto livello."
    ],
    "fr": [
      "Depuis 1998, Air La Plagne est une équipe de professionnels de baptêmes parapente titrés, très expérimentés et surtout passionnés.\r\n\r\nAIR La Plagne propose bien plus que des baptêmes, une aventure ! Nous proposons aussi de la voltige de haut niveau."
    ],
    "nl": [
      "Sinds 1998 is Air La Plagne een team van gekwalificeerde, zeer ervaren en vooral gepassioneerde paragliding professionals.\r\nAIR La Plagne biedt veel meer dan eerste vluchten - het is een avontuur! Wij bieden ook aerobatics op hoog niveau."
    ],
    "es": [
      "Desde 1998, Air La Plagne es un equipo de profesionales del parapente cualificados, muy experimentados y, sobre todo, apasionados.\r\n\r\nAIR La Plagne ofrece mucho más que primeros vuelos: ¡es una aventura! También ofrecemos acrobacias aéreas de alto nivel."
    ]
  },
