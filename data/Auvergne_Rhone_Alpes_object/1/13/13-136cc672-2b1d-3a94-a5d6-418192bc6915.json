  "rdfs:comment": {
    "de": [
      "In einer angenehmen Umgebung in der Nähe vieler bemerkenswerter Sehenswürdigkeiten und nur wenige Minuten von Le Puy-en-Velay entfernt, empfängt Sie das Hotel L?Abri für einen ruhigen und erholsamen Aufenthalt."
    ],
    "en": [
      "Set in pleasant surroundings close to many remarkable tourist sites and just a few minutes from Le Puy-en-Velay, the L'Abri hotel welcomes you for a calm and relaxing stay."
    ],
    "it": [
      "Situato in un ambiente piacevole, vicino a numerosi siti turistici di rilievo e a pochi minuti da Le Puy-en-Velay, l'Hôtel L'Abri vi accoglie per un soggiorno tranquillo e rilassante."
    ],
    "fr": [
      "Installé dans un agréable environnement proche de nombreux sites touristiques remarquables et à quelques minutes du Puy-en-Velay, l'hôtel L’Abri vous accueille pour un séjour calme et reposant."
    ],
    "es": [
      "Situado en un entorno agradable, cerca de numerosos lugares de interés turístico y a pocos minutos de Le Puy-en-Velay, el Hôtel L'Abri le da la bienvenida para una estancia tranquila y relajante."
    ],
    "nl": [
      "Hôtel L'Abri ligt in een aangename omgeving dicht bij een aantal opmerkelijke toeristische bezienswaardigheden en op slechts een paar minuten van Le Puy-en-Velay, en heet u welkom voor een rustig en ontspannen verblijf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Restaurant L'Abri"
    ]
  },
