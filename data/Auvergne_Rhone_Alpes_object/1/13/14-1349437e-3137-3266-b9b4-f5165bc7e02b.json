  "rdfs:comment": {
    "de": [
      "Du dachtest, nachts zu wandern sei etwas für Gespenster? Die Nocturne de Liévin wird dir das Gegenteil beweisen! Diese ungewöhnliche Wanderung führt dich von Liévin über Vimy bis zum Mont Saint-Eloi und lässt dich die Region aus einem ganz neuen Blickwinkel betrachten."
    ],
    "en": [
      "You thought walking at night was for ghosts? La Nocturne de Liévin will prove you wrong! This unique hike will take you through the region from a whole new angle, from Liévin to Mont Saint-Eloi, via Vimy."
    ],
    "it": [
      "Pensavate che le passeggiate notturne fossero riservate ai fantasmi? La Nocturne de Liévin vi smentirà! Questa passeggiata unica vi farà scoprire la regione da una prospettiva completamente nuova, da Liévin a Mont Saint-Eloi passando per Vimy."
    ],
    "fr": [
      "Tu pensais que marcher la nuit, c’était pour les fantômes ? La Nocturne de Liévin va te prouver le contraire ! Cette randonnée pas comme les autres te fera arpenter la région sous un angle inédit, de Liévin au Mont Saint-Eloi en passant par Vimy."
    ],
    "es": [
      "¿Creía que pasear de noche era cosa de fantasmas? La Nocturna de Liévin le demostrará lo contrario Este paseo único le llevará por la región desde un ángulo totalmente nuevo, desde Liévin hasta Mont Saint-Eloi, pasando por Vimy."
    ],
    "nl": [
      "Dacht je dat 's nachts wandelen iets voor geesten was? De Nocturne de Liévin zal je het tegendeel bewijzen! Deze unieke wandeling neemt je mee door de streek vanuit een heel ander perspectief, van Liévin naar Mont Saint-Eloi via Vimy."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les 50 km nocturne de Liévin"
    ]
  },
