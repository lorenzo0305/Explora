  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/389a6353-f41e-34c6-b3f7-fe3e5818e5d5",
      "dc:description": {
        "de": [
          "Carte Blanche ist ein Restaurant und auch ein Catering-Unternehmen in Amiens. Wir bieten Ihnen eine Gourmetküche in einem angenehmen Rahmen. Alle unsere Zubereitungen werden in unserer Küche mit frischen Produkten zubereitet. Wir bieten Ihnen eine traditionelle Küche in einer warmen und familiären Atmosphäre. Wenden Sie sich an uns."
        ],
        "en": [
          "Carte Blanche is a restaurant and also a caterer in Amiens. We offer a gastronomic cuisine in a pleasant setting. All our preparations are elaborated in our kitchens with fresh products. We offer you a traditional cuisine in a warm and family atmosphere. Call on us."
        ],
        "it": [
          "Carte Blanche è un ristorante e catering di Amiens. Offriamo una cucina gastronomica in un ambiente piacevole. Tutti i nostri piatti sono preparati nelle nostre cucine con prodotti freschi. Offriamo una cucina tradizionale in un'atmosfera calda e familiare. Contate su di noi."
        ],
        "fr": [
          "Carte Blanche est un restaurant et aussi traiteur à Amiens. Nous vous proposons une cuisine gastronomique dans un cadre agréable. Toutes nos préparations sont élaborées dans nos cuisines avec des produits frais. Nous vous proposons une cuisine traditionnelle dans une ambiance chaleureuse et familiale. Faites appel à nous."
        ],
        "nl": [
          "Carte Blanche is een restaurant en traiteur in Amiens. Wij bieden een gastronomische keuken in een aangenaam kader. Al onze gerechten worden in onze keukens bereid met verse producten. Wij bieden een traditionele keuken in een warme en familiale sfeer. Doe een beroep op ons."
        ],
        "es": [
          "Carte Blanche es un restaurante y servicio de catering en Amiens. Ofrecemos cocina gastronómica en un entorno agradable. Todos nuestros platos se preparan en nuestras cocinas con productos frescos. Ofrecemos cocina tradicional en un ambiente cálido y familiar. Llámenos."
        ]
      },
      "@type": [
        "Description"
