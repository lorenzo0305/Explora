  "rdfs:comment": {
    "de": [
      "Die drei Weiler von Montvernier liegen auf einem Plateau 300 m über dem Maurienne-Tal und bieten einen atemberaubenden Blick auf das Tal, die Aiguilles d'Arves und das Massiv des Grand Coin."
    ],
    "en": [
      "Situated on a plateau 300 meters above the Maurienne valley, Montvernier's three hamlets enjoy breathtaking views of the valley, the Aiguilles d'Arves and the Grand Coin massif."
    ],
    "it": [
      "Situate su un altopiano a 300 metri sopra la valle della Maurienne, le tre frazioni di Montvernier godono di una vista ininterrotta sulla valle, sulle Aiguilles d'Arves e sul massiccio del Grand Coin."
    ],
    "fr": [
      "Répartis sur un plateau situé à 300 mètres au-dessus de la vallée de la Maurienne, les trois hameaux de Montvernier bénéficient d’une vue imprenable sur la vallée, les Aiguilles d’Arves et le massif du Grand Coin."
    ],
    "es": [
      "Situadas en una meseta a 300 metros de altura sobre el valle de la Maurienne, las tres aldeas de Montvernier disfrutan de una vista impresionante del valle, las Aiguilles d'Arves y el macizo de Grand Coin."
    ],
    "nl": [
      "De drie gehuchten van Montvernier liggen op een plateau op 300 meter boven de Maurienne-vallei en genieten van een ononderbroken uitzicht op de vallei, de Aiguilles d'Arves en het Grand Coin-massief."
    ]
  },
