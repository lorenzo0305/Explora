  "rdfs:comment": {
    "de": [
      "Das Team empfängt und informiert Sie im Herzen der alten Abteistadt Saint-Chef. Es gibt einen Laden, in dem Sie Wanderkarten, Bücher über das Kulturerbe und Souvenirs mit dem Dorf und Frédéric Dard erwerben können."
    ],
    "en": [
      "The team welcomes and informs you in the heart of the ancient abbey town of Saint-Chef. There's also a store selling hiking maps, heritage books and souvenirs featuring the village and Frédéric Dard."
    ],
    "it": [
      "Il team vi accoglie e vi informa nel cuore dell'antica città abbaziale di Saint-Chef. C'è anche un negozio che vende opuscoli informativi, libri sul patrimonio e souvenir sul villaggio e su Frédéric Dard."
    ],
    "fr": [
      "L'équipe vous accueille et vous informe au cœur de l'ancienne cité abbatiale de Saint-Chef. Un espace boutique est à votre disposition, proposant des rando-fiches, des ouvrages patrimoniaux et produits souvenirs à l'effigie du village et de Frédéric Dard."
    ],
    "nl": [
      "Het team verwelkomt en informeert je in het hart van de oude abdijstad Saint-Chef. Er is ook een winkel met informatiefolders, erfgoedboeken en souvenirs over het dorp en Frédéric Dard."
    ],
    "es": [
      "El equipo le da la bienvenida y le informa en el corazón de la antigua ciudad abacial de Saint-Chef. También hay una tienda que vende folletos informativos, libros sobre el patrimonio y recuerdos del pueblo y de Frédéric Dard."
    ]
  },
