  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt im Skigebiet Courchevel Moriond am Ankunftspunkt der Gondelbahn und kann zu Fuß oder auf Skiern erreicht werden."
    ],
    "ru": [
      "Когда будете отдыхать в Куршевель Морион, загляните к нам в ресторан, расположенный рядом с остановкой гондольной канатной дороги. Сюда также можно добраться пешком или на лыжах."
    ],
    "en": [
      "The whole team will be happy to welcome you on a south-facing terrace or indoors in the restaurant with large picture window admiring the light and the view. Here, the service is pleasant and the cooking traditional."
    ],
    "it": [
      "Situato nel comprensorio sciistico di Courchevel Moriond, all'arrivo della funivia, questo ristorante è raggiungibile a piedi o in sci."
    ],
    "fr": [
      "Situé sur le domaine skiable de Courchevel Moriond, à l'arrivée de la télécabine, on peut rejoindre le restaurant à pied ou à ski."
    ],
    "zh": [
      "餐厅位于Courchevel Moriond度假区的滑雪场，在缆车终点，可步行或滑雪抵达。"
    ],
    "nl": [
      "Het restaurant ligt in het skigebied Courchevel Moriond, bij de aankomst van de kabelbaan, en kan te voet of op ski's worden bereikt."
    ],
    "es": [
      "Es posible acceder al restaurante a pie o esquiando, ya que se encuentra en la estación de esquí de Courchevel Moriond, a la llegada de la telecabina."
    ]
  },
