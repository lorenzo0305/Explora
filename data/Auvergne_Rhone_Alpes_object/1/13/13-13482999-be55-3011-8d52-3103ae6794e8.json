  "rdfs:comment": {
    "de": [
      "Engagierte, öko-verantwortliche und vegetarische Küche. Teestube und handgemachtes Eis. Hausgemachte\" Gerichte mit gluten- und laktosefreien Optionen.\r\n\r\nMahlzeiten vor Ort und Verkauf zum Mitnehmen."
    ],
    "en": [
      "Committed, eco-responsible and vegetarian cuisine. Tearoom and artisanal ice cream. Home-made dishes with gluten-free and lactose-free options.\r\n\r\nMeals on site and takeaway."
    ],
    "it": [
      "Cucina impegnata, eco-responsabile e vegetariana. Sala da tè e gelato artigianale. Piatti fatti in casa con opzioni senza glutine e senza lattosio.\r\n\r\nPasti in loco e da asporto."
    ],
    "fr": [
      "Cuisine engagée, éco responsable et végétarienne. Salon de thé et glaces artisanales. Plats \"fait maison\" avec options sans gluten et sans lactose.\r\n\r\nRepas sur place et vente à emporter."
    ],
    "es": [
      "Cocina comprometida, eco-responsable y vegetariana. Salón de té y helados artesanales. Platos caseros con opciones sin gluten y sin lactosa.\r\n\r\nComidas in situ y para llevar."
    ],
    "nl": [
      "Bewuste, milieuvriendelijke en vegetarische keuken. Tearoom en ambachtelijk ijs. Huisgemaakte gerechten met glutenvrije en lactosevrije opties.\r\n\r\nMaaltijden ter plaatse en afhaalmaaltijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Verveine Bistro Nature"
    ],
    "nl": [
      "Verveine Bistro Nature"
    ]
  },
