  "rdfs:comment": {
    "de": [
      "Seit vier Generationen bewirtschaftet unsere Familie das Land von Bramard in Sahune. Auf unserem Betrieb Haute Valeur Environnementale produzieren wir Aprikosen (IGP des Baronnies), Oliven , Bio-Öl und -Wein sowie Kirschbäume."
    ],
    "en": [
      "Since four generations, our family cultivate the land Bramard in Sahune. On our farm, we cultivate apricots, olives, grapevines and cherries."
    ],
    "it": [
      "Da quattro generazioni, la nostra famiglia coltiva i terreni di Bramard a Sahune. Nella nostra azienda agricola ad alto valore ambientale, produciamo albicocche (IGP des Baronnies), olive, olio biologico e vino, oltre a ciliegi."
    ],
    "fr": [
      "Depuis quatre générations, notre famille cultive la terre de Bramard à Sahune. Sur notre exploitation Haute Valeur Environnementale, nous produisons des abricots (IGP des Baronnies), des olives , de l'huile et du vin bios, ainsi que des cerisiers."
    ],
    "nl": [
      "Sinds vier generaties, bewerkt onze familie de grond van de Bramard in Sahune.  Op ons bedrijf, telen wij abikozen, olijven, kersen en wijnstokken."
    ],
    "es": [
      "Desde hace cuatro generaciones, nuestra familia cultiva las tierras de Bramard en Sahune. En nuestra explotación de alto valor medioambiental, producimos albaricoques (IGP des Baronnies), aceitunas, aceite y vino ecológicos, así como cerezos."
    ]
  },
