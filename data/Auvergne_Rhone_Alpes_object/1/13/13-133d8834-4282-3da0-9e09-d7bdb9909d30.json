  "rdfs:comment": {
    "de": [
      "Eine Bar im Industriedesign, in der man in einer musikalischen, festlichen und gemütlichen Atmosphäre Getränke und Snacks zu sich nehmen kann, sowie ein Arcade-Raum (Billard, elektronische Darts, Flipper, Tischfußball, Arcade-Terminal)."
    ],
    "en": [
      "A bar with an industrial decor, where you can drink and snack in a warm, festive and musical atmosphere, as well as an arcade (pool tables, electronic darts, pinball machines, table football, arcade terminals)."
    ],
    "it": [
      "Un bar dall'arredamento industriale, dove è possibile bere e fare uno spuntino in un'atmosfera calda, festosa e musicale, nonché una sala giochi (biliardo, freccette elettroniche, flipper, calcio balilla, macchina arcade)."
    ],
    "fr": [
      "Un bar à la décoration industrielle, où l'on peut boire et grignoter dans une ambiance musicale, festive et chaleureuse, ainsi qu'une salle d'arcades (billards, fléchettes électroniques, flippers, baby-foot, borne d'arcade)."
    ],
    "es": [
      "Un bar con decoración industrial, donde podrá beber y picar algo en un ambiente cálido, festivo y musical, así como un salón recreativo (billares, dardos electrónicos, máquinas de pinball, futbolín, máquina recreativa)."
    ],
    "nl": [
      "Een nieuwe plek met industriële decoratie, waar je kunt drinken en snacken in een warme sfeer voor après-ski en avonden. Evenals een arcadekamer ( darts, biljart ... )."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hangar Games"
    ]
  },
