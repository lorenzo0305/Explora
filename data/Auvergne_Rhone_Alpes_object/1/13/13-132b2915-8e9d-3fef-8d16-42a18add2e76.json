  "rdfs:comment": {
    "de": [
      "Zeichenworkshop mit lebenden Modellen.\r\nSchärfen Sie Ihre Beobachtungsgabe,\r\nDie Geste befreien, die Linie und die Volumen des Körpers finden\r\n Die eigene Zeichenpraxis weiterentwickeln"
    ],
    "en": [
      "Drawing workshop with live model.\r\nSharpen your sense of observation,\r\nFree your gestures, find lines and body volumes\r\n Develop your drawing skills"
    ],
    "it": [
      "Laboratorio di disegno con modelli dal vivo.\r\nAffinare il senso di osservazione,\r\nLiberare il gesto, trovare la linea e i volumi del corpo\r\n Sviluppare le proprie capacità di disegno"
    ],
    "fr": [
      "Atelier dessin avec modèle vivant.\r\nAiguiser son sens de l’observation, \r\nLibérer le geste, trouver la ligne et les volumes du corps\r\n Développer sa pratique du dessin"
    ],
    "nl": [
      "Tekenworkshop met levende modellen.\r\nScherp je gevoel voor observatie aan,\r\nHet gebaar bevrijden, de lijn en volumes van het lichaam vinden\r\n Ontwikkel je tekenvaardigheden"
    ],
    "es": [
      "Taller de dibujo con modelos vivos.\r\nAgudizar el sentido de la observación,\r\nLiberar el gesto, encontrar la línea y los volúmenes del cuerpo\r\n Desarrolle sus habilidades de dibujo"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Dessin avec Modèle Vivant (mensuel)"
    ]
  },
