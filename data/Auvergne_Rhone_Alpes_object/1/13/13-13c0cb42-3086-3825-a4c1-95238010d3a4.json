  "rdfs:comment": {
    "de": [
      "In einer herzlichen Atmosphäre lädt Sie die Familie EMOUNERIE an ihren Tisch ein: eine gepflegte regionale Küche mit bodenständigen Aromen, bereichert durch einen Panoramablick auf die umliegende Landschaft."
    ],
    "en": [
      "Restaurant with a panoramic view of the Auvergne mountains. The Emounerie family warmly welcomes you to their hotel which offers traditional cooking. Recommended by the “Guide du Routard”, “Petit Futé”, “Botin Gourmand” and “Guide Champérard”."
    ],
    "it": [
      "La famiglia EMOUNERIE sarà lieta di accogliervi alla sua tavola, dove potrete gustare una raffinata cucina regionale dai sapori locali, impreziosita da viste panoramiche sulla campagna circostante."
    ],
    "fr": [
      "C'est dans une ambiance chaleureuse que la famille EMOUNERIE vous conviera à sa table :  une cuisine régionale soignée aux saveurs du terroir, enrichie d'une vue panoramique sur la campagne environnante."
    ],
    "es": [
      "La familia EMOUNERIE estará encantada de recibirle en su mesa, donde podrá degustar una excelente cocina regional con sabores locales, realzada por las vistas panorámicas sobre la campiña circundante."
    ],
    "nl": [
      "De familie EMOUNERIE verwelkomt je graag aan tafel, waar je kunt genieten van verfijnde streekgerechten met lokale smaken, verrijkt met panoramische uitzichten over het omliggende platteland."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Remparts"
    ],
    "fr": [
      "Les Remparts"
    ]
  },
