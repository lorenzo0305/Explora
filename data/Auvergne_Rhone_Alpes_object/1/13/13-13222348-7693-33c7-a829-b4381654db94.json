  "rdfs:comment": {
    "de": [
      "Jean-Michel, der dem Moniteur Cycliste Français angeschlossen ist, wird Sie bei Ausflügen mit dem Mountainbike, dem Fahrrad mit elektrischer Unterstützung und bei Coaching-Sitzungen begleiten."
    ],
    "en": [
      "Jean-Michel, affiliated with the Moniteur Cycliste Français, will accompany you on mountain bike, electric bike and coaching sessions."
    ],
    "it": [
      "Jean-Michel, affiliato al Moniteur Cycliste Français, vi accompagnerà nelle uscite in mountain bike e bici elettriche e nelle sessioni di coaching."
    ],
    "fr": [
      "Jean-Michel, affilié au Moniteur Cycliste Français, vous accompagnera pour des sorties en VTT, vélo à assistance électrique et des séances de coaching."
    ],
    "es": [
      "Jean-Michel, afiliado al Moniteur Cycliste Français, le acompañará en paseos en bicicleta de montaña y eléctrica y en sesiones de entrenamiento."
    ],
    "nl": [
      "Jean-Michel, aangesloten bij het Moniteur Cycliste Français, begeleidt u tijdens mountainbike- en elektrische fietstochten en coachingsessies."
    ]
  },
