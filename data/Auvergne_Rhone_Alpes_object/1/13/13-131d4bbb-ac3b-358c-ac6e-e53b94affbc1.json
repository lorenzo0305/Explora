  "rdfs:comment": {
    "de": [
      "Working Zone: Arbeiten Sie anders!\r\nDie Working Zone by Le Cinq**** ist ein einzigartiges Angebot jenseits aller Standards, das auf die Erwartungen und Anforderungen seiner Nutzer zugeschnitten ist - von Coworking bis zu Seminaren - und eine Leistungsqualität bietet, die einem 4*-Hotel entspricht."
    ],
    "en": [
      "Working Zone: work differently!\r\nThe Working Zone by Le Cinq is unique and surpasses standard services.\r\nIt was designed for a demanding clientele for coworking and seminars with 4* hotel services."
    ],
    "it": [
      "Working Zone: lavorare in modo diverso!\r\nLa Working Zone di Le Cinq**** è un'offerta unica e fuori dagli standard, pensata per soddisfare le aspettative e le esigenze dei suoi utenti, dal coworking ai seminari, e offre una qualità di servizio degna di un 4*."
    ],
    "fr": [
      "Working Zone : travaillez autrement !\r\nLa Working Zone by Le Cinq**** est une offre unique et hors des standards, conçue pour répondre aux attentes et exigences de ses usagers, du coworking au séminaire, et offre une qualité de prestations digne d'un 4*."
    ],
    "es": [
      "Zona de trabajo: ¡trabaja de forma diferente!\r\nLa Zona de Trabajo de Le Cinq**** es una oferta única y atípica, diseñada para satisfacer las expectativas y exigencias de sus usuarios, desde el coworking hasta los seminarios, y ofrece una calidad de servicio digna de un 4*."
    ],
    "nl": [
      "Werkzone: anders werken!\r\nDe Working Zone by Le Cinq**** is een uniek en niet-standaard aanbod, ontworpen om te voldoen aan de verwachtingen en eisen van de gebruikers, van coworking tot seminars, en biedt een kwaliteit van dienstverlening die een 4* waardig is."
    ]
  },
