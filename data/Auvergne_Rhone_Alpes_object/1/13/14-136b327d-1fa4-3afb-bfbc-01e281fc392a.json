  "rdfs:comment": {
    "de": [
      "In diesem Stück wird ein Gespräch zwischen dem Sänger Rémy Vandeville, dem Urenkel von Louis, und seinem Vorfahren, einem Bergarbeiter, inszeniert."
    ],
    "en": [
      "This show features a conversation between singer Rémy Vandeville, great-grandson of Louis, and his grandfather, a coal miner."
    ],
    "it": [
      "Questo spettacolo presenta una conversazione tra il cantante Rémy Vandeville, pronipote di Louis, e suo nonno, minatore."
    ],
    "fr": [
      "Ce spectacle met en scène une conversation entre le chanteur Rémy Vandeville, arrière-petit-fils de Louis, et son aïeul, mineur de fond."
    ],
    "es": [
      "Este espectáculo presenta una conversación entre el cantante Rémy Vandeville, bisnieto de Louis, y su abuelo, minero del carbón."
    ],
    "nl": [
      "Deze show laat een gesprek zien tussen zanger Rémy Vandeville, de achterkleinzoon van Louis, en zijn grootvader, een mijnwerker."
    ]
  },
