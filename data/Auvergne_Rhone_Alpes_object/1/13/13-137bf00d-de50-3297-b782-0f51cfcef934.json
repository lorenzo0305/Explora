  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant, das allen für Geschäftsessen, Mittagspausen und Abendmahlzeiten offen steht. Es wird Ihnen ein All-you-can-eat-Buffet angeboten."
    ],
    "en": [
      "Come to discover our restaurant open to all for your business, lunch and  dinner. An all-you-can-eat buffet is available."
    ],
    "it": [
      "Venite a scoprire il nostro ristorante aperto a tutti per i vostri pasti di lavoro, le pause pranzo e le cene. È disponibile una formula buffet all-you-can-eat."
    ],
    "fr": [
      "Venez découvrir notre restaurant ouvert à tous pour vos repas d’affaires, vos pauses déjeuners et vos repas du soir. Une formule de buffets à volonté vous est proposée."
    ],
    "es": [
      "Venga a descubrir nuestro restaurante abierto a todo el mundo para sus comidas de negocios, sus pausas para comer y sus cenas. Se ofrece una fórmula de buffet libre."
    ],
    "nl": [
      "Kom en ontdek ons restaurant dat voor iedereen toegankelijk is voor uw zakelijke maaltijden, lunchpauzes en avondmaaltijden. Een all-you-can-eat buffet formule is beschikbaar."
    ]
  },
