  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/71cc906b-e8ac-3792-b9e5-17183f016785",
      "dc:description": {
        "de": [
          "Veranstaltung von Tournée d'été région Hauts de France, Wéo, la télé Hauts-de-France und SNCF TER Hauts-de-France\n\nAb 15 Uhr\n\n> 15h/18h: Animationen, Spiele auf dem Podium,\n\n> 20.30/22.30 Uhr: Karaoke auf Leinwand"
        ],
        "en": [
          "Hauts-de-France Region Summer Tour event, Wéo, Hauts-de-France TV and SNCF TER Hauts-de-France\n\nStarting at 3pm\n\n> 3pm/6pm: entertainment, games on podium,\n\n> 8:30 pm / 10:30 pm: karaoke on screen"
        ],
        "it": [
          "Tour estivo della Regione Hauts-de-France, Wéo, Hauts-de-France TV e SNCF TER Hauts-de-France\n\nA partire dalle 15:00\n\n> 15.00/18.00: animazione e giochi sul podio,\n\n> 20.30/22.30: karaoke su schermo"
        ],
        "fr": [
          "Évènement de Tournée d'été région Hauts de France, Wéo, la télé Hauts-de-France et SNCF TER Hauts-de-France\n\nÀ partir de 15h \n\n> 15h/18h : animations, jeux sur podium,\n\n> 20h 30/22h30 : karaoké sur écran"
        ],
        "nl": [
          "Zomertoer van de regio Hauts-de-France, Wéo, TV Hauts-de-France en SNCF TER Hauts-de-France\n\nVanaf 15.00 uur\n\n> 15.00-18.00 uur: animatie en spelletjes op het podium,\n\n> 20u30/22u30: karaoke op scherm"
        ],
        "es": [
          "Evento del Tour de verano de la región de Hauts-de-France, Wéo, Hauts-de-France TV y SNCF TER Hauts-de-France\n\nA partir de las 15.00 horas\n\n> 15.00-18.00 h: animación y juegos en el podio,\n\n> 20.30/22.30: karaoke en pantalla"
        ]
      },
