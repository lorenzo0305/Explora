  "rdfs:comment": {
    "de": [
      "Der Saintger?Trail kehrt zu seiner 28. Ausgabe mit überarbeiteten Strecken zurück und findet am Sonntag, den 5. April in Saint-Germain-Laprade statt.\r\nOb Läufer, Wanderer, Mountainbiker oder junger Sportler, es ist für jeden etwas dabei!"
    ],
    "en": [
      "The Saint-Germain Trail returns for its 28th edition, with a revamped route, on Sunday April 5 in Saint-Germain-Laprade.\r\nWhether you're a runner, hiker, mountain biker or young athlete, there's something for everyone!"
    ],
    "it": [
      "Il Saint-Germain Trail torna per la sua 28a edizione, con un percorso rinnovato, domenica 5 aprile a Saint-Germain-Laprade.\r\nChe siate corridori, escursionisti, mountain biker o giovani atleti, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "Le Saintger’Trail revient pour sa 28ᵉ édition avec des parcours revisités et te donne rendez-vous le dimanche 5 avril à Saint-Germain-Laprade.\r\nQue tu sois coureur, randonneur, vététiste ou jeune sportif, il y en a pour tous les goûts !"
    ],
    "nl": [
      "Het Saint-Germain Parcours is terug voor zijn 28e editie, met een vernieuwd parcours, op zondag 5 april in Saint-Germain-Laprade.\r\nOf je nu een hardloper, wandelaar, mountainbiker of jonge atleet bent, er is voor elk wat wils!"
    ],
    "es": [
      "El Trail Saint-Germain vuelve en su 28ª edición, con un recorrido renovado, el domingo 5 de abril en Saint-Germain-Laprade.\r\nYa seas corredor, senderista, ciclista de montaña o joven atleta, ¡hay para todos los gustos!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "SaintGer'Trail - 28ème édition"
    ]
  },
