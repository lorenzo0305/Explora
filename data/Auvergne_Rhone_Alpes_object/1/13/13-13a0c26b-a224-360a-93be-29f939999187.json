  "rdfs:comment": {
    "de": [
      "Die Gaec Bémol besteht aus 80 Milchkühen, deren Milch an die Milchgenossenschaft Fermiers Savoyards verkauft wird, und 60 Ziegen, deren Milch auf dem Hof zu Käse und Joghurt verarbeitet wird."
    ],
    "en": [
      "The GAEC Bémol farm has 80 dairy cows, whose milk is sold to the Fermiers Savoyards dairy cooperative, and 60 goats, whose milk is transformed into cheese and yoghurt on the farm."
    ],
    "it": [
      "Gaec Bémol possiede 80 mucche da latte il cui latte viene venduto alla cooperativa lattiero-casearia Fermiers Savoyards e 60 capre il cui latte viene trasformato in azienda in formaggio e yogurt."
    ],
    "fr": [
      "Le Gaec Bémol, c'est 80 vaches laitières dont le lait est vendu à la coopérative laitière des Fermiers Savoyards et 60 chèvres dont le lait est transformé à la ferme en fromages et en yaourts."
    ],
    "es": [
      "Gaec Bémol tiene 80 vacas lecheras cuya leche se vende a la cooperativa lechera Fermiers Savoyards y 60 cabras cuya leche se transforma en la granja en queso y yogur."
    ],
    "nl": [
      "Gaec Bémol heeft 80 melkkoeien waarvan de melk wordt verkocht aan de zuivelcoöperatie Fermiers Savoyards en 60 geiten waarvan de melk op de boerderij wordt verwerkt tot kaas en yoghurt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chèvrerie des Daines"
    ],
    "fr": [
      "Chèvrerie des Daines"
    ]
  },
