  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1f273f74-959d-3f2b-9f0e-12e9f2fc003b",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Fächern werden Ihnen saisonale Bauernhofprodukte angeboten: Butter, Joghurt, Käse, Quark, Obst und Gemüse von lokalen Erzeugern.\n\nÖffnungstage:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nYou'll find seasonal farm produce in racks: butter, yoghurt, cheese, cottage cheese, fruit and vegetables from local producers.\n\nOpening days:\n\nOpen 24/7.\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nTroverete prodotti agricoli di stagione in scaffali: burro, yogurt, formaggio, ricotta, frutta e verdura di produttori locali.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposés des produits fermiers de saison : beurres, yaourts, fromages, fromage blanc, fruits et légumes des producteurs locaux.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nJe vindt seizoensproducten van de boerderij in rekken: boter, yoghurt, kaas, kwark, fruit en groenten van lokale producenten.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nEncontrará productos agrícolas de temporada en estanterías: mantequilla, yogur, queso, requesón, fruta y verdura de productores locales.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n\n "
        ]
      },
