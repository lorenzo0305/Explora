  "rdfs:comment": {
    "de": [
      "Entdecken Sie in einer typisch savoyischen Umgebung am Col de Leschaux: La Baratte. Terrasse mit Blick auf die Bauges. Bergküche, lokale Spezialitäten."
    ],
    "en": [
      "La Baratte is a tipical savoyard atmosphere restaurant at the pass of Leschaux. Beautiful view over of the Bauges. Mountains and local cuisine."
    ],
    "it": [
      "Venite a scoprire in un ambiente tipicamente savoiardo, al Col de Leschaux: La Baratte. Terrazza con vista sulle Bauges. Cucina di montagna, specialità locali."
    ],
    "fr": [
      "Venez découvrir dans un cadre typiquement savoyard, au col de Leschaux : La Baratte. Terrasse avec vue sur les Bauges. Cuisine de montagne, spécialités locales."
    ],
    "es": [
      "Venga a descubrir en un entorno típicamente saboyano, en el Col de Leschaux: La Baratte. Terraza con vista a los Bauges. Cocina de montaña, especialidades locales."
    ],
    "nl": [
      "Kom en ontdek in een typisch Savoyaardse omgeving, op de Col de Leschaux: La Baratte. Terras met uitzicht op de Bauges. Bergkeuken, lokale specialiteiten."
    ]
  },
