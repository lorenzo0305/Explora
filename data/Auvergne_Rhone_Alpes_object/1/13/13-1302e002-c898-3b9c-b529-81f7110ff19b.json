  "rdfs:comment": {
    "de": [
      "NeoXperiences ist die Umwandlung einer Squashhalle in einen immersiven und interaktiven Spielplatz. Ein sportliches, spielerisches und geselliges Erlebnis, das für alle zugänglich ist und dank neuer Technologien die Lust auf sportliche Aktivitäten wieder weckt."
    ],
    "en": [
      "NeoXperiences is the transformation of a squash room into an immersive and interactive play area. A sporting, fun, friendly experience, accessible to all, which restores the taste for sporting activities thanks to new technologies."
    ],
    "it": [
      "NeoXperiences è la trasformazione di una sala da squash in un'area giochi coinvolgente e interattiva. Un'esperienza sportiva, divertente, conviviale, accessibile a tutti, che restituisce il gusto per l'attività sportiva grazie alle nuove tecnologie."
    ],
    "fr": [
      "NeoXperiences c’est la transformation d’une salle de squash en une aire de jeux immersive et interactive. Une expérience sportive, ludique, conviviale, accessible à tous, qui redonne le goût des activités sportives grâce aux nouvelles technologies."
    ],
    "nl": [
      "NeoXperiences is de transformatie van een squashbaan in een meeslepende, interactieve speeltuin. Het is een sportieve, leuke en vriendelijke ervaring, toegankelijk voor iedereen, die gebruik maakt van nieuwe technologieën om mensen weer zin te laten krijgen in sportactiviteiten."
    ],
    "es": [
      "NeoXperiences es la transformación de una pista de squash en una zona de juegos inmersiva e interactiva. Es una experiencia deportiva, divertida y agradable, accesible a todos, que utiliza las nuevas tecnologías para que la gente sienta un gusto renovado por las actividades deportivas."
    ]
  },
  "rdfs:label": {
    "en": [
      "NeoXperiences interactives games"
    ],
    "it": [
      "Giochi interattivi NeoXperiences"
    ],
    "fr": [
      "Jeux interactifs NeoXperiences"
    ]
  },
