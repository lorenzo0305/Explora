  "rdfs:comment": {
    "de": [
      "Hm... dieser fruchtige Geschmack, der im Mund prickelt! Die Clairette de Die hat ihre Qualitätsmarke, die des Hauses Jaillance. 7 Grad Glück und Natürlichkeit reichen aus, um den Gaumen zu verzaubern!"
    ],
    "en": [
      "Enjoy the fruity sparkling taste of Clairette de Die wine from Jaillance, the quality producer. Let its 7 refreshing degrees of happiness awaken your palate !"
    ],
    "it": [
      "Quel gusto fruttato che frizza in bocca! La Clairette de Die ha il suo marchio di qualità, quello della Jaillance. 8 gradi di felicità e naturalezza sono sufficienti per deliziare il palato!"
    ],
    "fr": [
      "Hum… ce goût fruité qui pétille dans la bouche ! La Clairette de Die a sa marque de qualité, celle de la maison Jaillance. 8 degrés de bonheur et de naturalité suffisent à enchanter le palais !"
    ],
    "es": [
      "¡Ese sabor afrutado que chispea en la boca! Clairette de Die tiene su propia marca de calidad, la de Jaillance. ¡8 grados de felicidad y naturalidad bastan para deleitar el paladar!"
    ],
    "nl": [
      "Heerlijk, dat fruitige getintel in de mond! De Clairette de Die van Jaillance is de beste. 7° geluk en genot, voor jubelende smaakpapillen!"
    ]
  },
