  "rdfs:comment": {
    "de": [
      "Hier ist die Tagesküche die Königin.\r\nEine Auswahl an Vorspeisen und Desserts, zwei Gerichte, die jeden Tag wechseln, je nach Jahreszeit, Markt und unserer Inspiration."
    ],
    "en": [
      "Here, the cuisine of the day is king.\r\nA choice of starters and desserts, two dishes that change every day according to the season, the market and our inspiration."
    ],
    "it": [
      "Qui la cucina del giorno la fa da padrona.\r\nUna scelta di antipasti e dessert, due piatti che cambiano ogni giorno in base alla stagione, al mercato e alla nostra ispirazione."
    ],
    "fr": [
      "Ici c'est la cuisine du jour qui est reine.\r\nUn choix d'entrées et de desserts, deux plat qui change tous les jours au gré des saisons, du marché et de notre inspiration."
    ],
    "nl": [
      "Hier is de keuken van de dag koning.\r\nEen keuze uit voorgerechten en desserts, twee gerechten die elke dag veranderen op basis van het seizoen, de markt en onze inspiratie."
    ],
    "es": [
      "Aquí, la cocina del día es la reina.\r\nUna selección de entrantes y postres, dos platos que cambian cada día según la temporada, el mercado y nuestra inspiración."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lard dans l'Assiette"
    ]
  },
