  "rdfs:comment": {
    "de": [
      "Ein Affe: Fetischtier des Künstlers. Er verwendet ihn, um soziale Satiren zu illustrieren.\r\nHier frisst der Affe seine Maske und ist damit ein Echo auf aktuelle Ereignisse."
    ],
    "en": [
      "A monkey: the artist's favorite animal. He uses it to illustrate social satire.\r\nHere, the monkey eats his mask, echoing current events."
    ],
    "it": [
      "Una scimmia: l'animale preferito dell'artista. La usa per illustrare la satira sociale.\r\nIn questo caso, la scimmia mangia la sua maschera, riecheggiando l'attualità."
    ],
    "fr": [
      "Un singe : animal fétiche de l'artiste. Il l'utilise pour illustrer des satires sociales.\r\nIci, le singe mange son masque et fait écho à l'actualité."
    ],
    "es": [
      "Un mono: el animal favorito del artista. Lo utiliza para ilustrar la sátira social.\r\nAquí, el mono se come su máscara, haciéndose eco de la actualidad."
    ],
    "nl": [
      "Een aap: het lievelingsdier van de kunstenaar. Hij gebruikt het om sociale satire te illustreren.\r\nHier eet de aap zijn masker op, een echo van de actualiteit."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fresko: Affe mit Maske"
    ],
    "en": [
      "Fresco: Monkey with mask"
    ],
    "it": [
      "Affresco: Scimmia con maschera"
    ],
    "fr": [
      "Fresque : Singe au masque"
    ],
    "nl": [
      "Fresco: Aap met masker"
    ]
  },
