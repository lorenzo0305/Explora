  "rdfs:comment": {
    "de": [
      "In La Cueille, in der Gemeinde Poncin gelegen, bewirtschaften wir 6 ha Weinberge mit Gamay und Poulsard für die Herstellung von Cerdon nach althergebrachter Methode."
    ],
    "en": [
      "Located at La Cueille, in the commune of Poncin, we farm 5 hectares of Gamay and Poulsard vines for the production of Cerdon méthode ancestrale."
    ],
    "it": [
      "A La Cueille, nel comune di Poncin, coltiviamo 6 ettari di vigneti di Gamay e Poulsard per la produzione del Cerdon méthode ancestrale."
    ],
    "fr": [
      "Situés à La Cueille, sur la commune de Poncin., nous exploitons 6 ha de vignes, en Gamay et Poulsard pour la production de Cerdon méthode ancestrale."
    ],
