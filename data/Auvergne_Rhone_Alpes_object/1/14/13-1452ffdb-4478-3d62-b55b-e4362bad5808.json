  "rdfs:comment": {
    "de": [
      "Der Park von Parilly ist Eigentum des Departements Rhône. Mit seinen 159ha bietet er Waldgebiet und Sportmöglichkeiten: Leichtathletik-Stadion, Fußball, Basketball, Volleyball, Rugby, Handball, Soft-Ball, Cricket, 400m Laufbahnen mit freiem Zugang."
    ],
    "en": [
      "The 159 hectares Parilly park is owned by Lyon Métropole and has a wooded area and a sports area (athletics stadium, football, basketball, volleyball, rugby, handball, softball, cricket, public 400m running track)."
    ],
    "it": [
      "Il parco di Parilly è una proprietà del Dipartimento del Rodano di 159 ettari, con una zona boscosa e una zona dedicata allo sport (stadio di atletica, football, basket, pallavolo, rugby, pallamano, softball, cricket, pista di 400 metri in libero accesso)."
    ],
    "fr": [
      "Géré par la Métropole de Lyon, le Parc s'étend sur 159 hectares avec une zone boisée et une zone de sports (stade d'athlétisme, football, basket, volley, rugby, handball, soft-ball, cricket, piste de 400 mètres en libre accès)."
    ],
    "nl": [
      "Het park wordt beheerd door de Metropool van Lyon en beslaat 159 hectare met een bosrijk gebied en een sportterrein (atletiekstadion, voetbal, basketbal, volleybal, rugby, handbal, softbal, cricket, 400-meter baan met vrije toegang)."
    ],
    "es": [
      "El parque de Parilly es una propiedad del departamento del Ródano de 159 hectáreas con una zona arbolada y una zona deportiva (estadio de atletismo, fútbol, baloncesto, voleibol, rugby, balonmano, sófbol, cricket y pista de 400 metros de libre acceso)."
    ]
  },
