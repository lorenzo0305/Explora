  "rdfs:comment": {
    "de": [
      "Hier finden Sie an Wochenenden oder Themenabenden und Einführungen die Musik und die Tänze, die eine gelungene Atmosphäre ausmachen! 70er/80er/90er Jahre, Tango, Rock, Swing, Lindy Hop, West Coast, SBK Latino, Kompa, Line Dance, Gesellschaftstanz, Thés Dansants."
    ],
    "en": [
      "For weekends, theme evenings and introductions, you'll find the music and dances that make for a great atmosphere! 70s/80s/90s, Tango, Rock, Swing, Lindy Hop, West Coast, SBK Latino, Kompa, Line Dancing, Ballroom Dancing, Thés Dansants."
    ],
    "it": [
      "Troverete musica e balli che creano un'atmosfera di successo durante i fine settimana o le serate a tema e le iniziazioni! Anni 70/80/90, Tango, Rock, Swing, Lindy Hop, West Coast, SBK Latino, Kompa, Line Dancing, Ballo da sala, Tea Dancing."
    ],
    "fr": [
      "Vous y trouverez en weekend ou en soirées à thèmes et initiations, des musiques et des danses qui font les ambiances réussies ! Années 70/80/90, Tango, Rock, Swing, Lindy Hop, West Coast, SBK Latino, Kompa, Danse en Ligne, Danse de Salon, Thés Dansants."
    ],
    "nl": [
      "Voor weekends of thema-avonden en introducties vind je hier de muziek en dansen die zorgen voor een geweldige sfeer! 70s/80s/90s, Tango, Rock, Swing, Lindy Hop, West Coast, SBK Latino, Kompa, Line Dancing, Ballroomdansen, Thés Dansants."
    ],
    "es": [
      "En los fines de semana o en las veladas temáticas y de iniciación, encontrará música y bailes que le permitirán disfrutar de un buen ambiente 70's/80's/90's, Tango, Rock, Swing, Lindy Hop, West Coast, SBK Latino, Kompa, Line Dancing, Ballroom Dancing, Tea Dancing."
    ]
  },
  "rdfs:label": {
    "fr": [
