  "rdfs:comment": {
    "de": [
      "Ein pädagogischer Flug im Tandem, um die Region aus der Vogelperspektive zu entdecken. Vom Entdeckungsflug bis zum Prestigeflug, vom ruhigen Flug bis zum Nervenkitzel ist alles möglich!"
    ],
    "en": [
      "Tandem flight to discover the region from the air. From discovery flight to prestige, peaceful flight or strong sensations, everything is possible!"
    ],
    "it": [
      "Un volo didattico in biposto per scoprire la regione dall'alto. Dal volo di scoperta a quello di prestigio, dal volo tranquillo alle sensazioni forti, tutto è possibile!"
    ],
    "fr": [
      "Vol pédagogique en biplace afin de découvrir la région vue du ciel. Du vol découverte au prestige, vol paisible ou sensations fortes tout est possible!"
    ],
    "es": [
      "Un vuelo biplaza educativo para descubrir la región desde el aire. Del vuelo de descubrimiento al de prestigio, vuelo tranquilo o sensaciones fuertes, ¡todo es posible!"
    ],
    "nl": [
      "Een educatieve tweezitsvlucht om de regio vanuit de lucht te ontdekken. Van ontdekkingsvlucht tot prestige, rustige vlucht of sterke sensaties, alles is mogelijk!"
    ]
  },
