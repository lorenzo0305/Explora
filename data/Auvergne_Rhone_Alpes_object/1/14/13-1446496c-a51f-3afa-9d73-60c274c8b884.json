  "rdfs:comment": {
    "de": [
      "Frische und abwechslungsreiche Verpflegung für jeden Geschmack und jeden Geldbeutel (Kuchen, Fertiggerichte, Sandwiches, Desserts...). Unsere Küche ist hausgemacht und mit Liebe zubereitet!  Verpflegung vor Ort oder zum Mitnehmen. Bedienung an der Theke. Terrasse."
    ],
    "en": [
      "Fresh, varied food to suit all tastes and budgets (pies, ready-made meals, sandwiches, desserts...). Our cuisine is homemade with love!  On-site or takeaway catering. Counter service. Terrace."
    ],
    "it": [
      "Cibo fresco e vario per tutti i gusti e le tasche (torte, piatti pronti, panini, dolci...). Il nostro cibo è fatto in casa con amore!  Ristorazione in loco o da asporto. Ampia terrazza ombreggiata."
    ],
    "fr": [
      "Restauration fraîche et variée, pour tous les goûts et pour toutes les bourses (tartes, plats cuisinés, sandwichs, desserts...). Notre cuisine est faite maison et avec amour !  Restauration sur place ou à emporter. Grande terrasse ombragée."
    ],
    "nl": [
      "Vers en gevarieerd eten voor alle smaken en budgetten (taarten, kant-en-klaarmaaltijden, sandwiches, desserts...). Ons eten is huisgemaakt met liefde!  Catering ter plaatse of om mee te nemen. Bediening aan de balie. Terras."
    ],
    "es": [
      "Comida fresca y variada para todos los gustos y bolsillos (tartas, platos preparados, bocadillos, postres...). Nuestra comida es casera y hecha con amor  Restauración in situ o para llevar. Amplia terraza sombreada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les 3 Colombes"
    ]
  },
