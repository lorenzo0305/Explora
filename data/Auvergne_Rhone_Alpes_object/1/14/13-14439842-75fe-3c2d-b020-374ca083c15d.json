  "rdfs:comment": {
    "de": [
      "Unsere Rohkaffeebohnen stammen von Plantagen aus aller Welt, die aus den besten Anbaugebieten stammen und Ihnen in der Tasse ein außergewöhnliches Aromenspektrum bieten."
    ],
    "en": [
      "Our green coffee beans come from plantations in the four corners of the world from the best terroirs, which will give you an exceptional range of flavours in a cup."
    ],
    "it": [
      "I nostri chicchi di caffè verde provengono da piantagioni ai 4 angoli del mondo e dai migliori terroir, per offrirvi un'eccezionale gamma di aromi in tazza."
    ],
    "fr": [
      "Nos grains de café vert proviennent de plantations des 4 coins du monde issus des meilleurs terroirs, qui vous donneront en tasse une exceptionnelle gamme aromatique."
    ],
    "nl": [
      "Onze groene koffiebonen komen van plantages in de 4 hoeken van de wereld van de beste terroirs, waardoor je een uitzonderlijke reeks aroma's in een kopje krijgt."
    ],
    "es": [
      "Nuestros granos de café verde proceden de plantaciones de los 4 rincones del mundo de los mejores terruños, lo que le ofrece una gama excepcional de aromas en una taza."
    ]
  },
  "rdfs:label": {
