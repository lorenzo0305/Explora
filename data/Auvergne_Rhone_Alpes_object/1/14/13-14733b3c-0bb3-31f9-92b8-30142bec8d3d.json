  "rdfs:comment": {
    "de": [
      "Eine Rundfahrt, die mit dem Brionnais und dem Allier flirtet. Ausgehend vom Charakterdorf Crozet durchqueren Sie auf einer abwechslungsreichen Strecke Teiche und Wiesen mit Charolais-Zucht."
    ],
    "en": [
      "A circuit that flirts with the Brionnais and the Allier. Starting from the village of Le Crozet, you'll cross ponds and Charolais meadows on a varied circuit."
    ],
    "it": [
      "Un percorso che flirta con il Brionnais e l'Allier. Partendo dal villaggio di Crozet, attraverserete stagni e prati per l'allevamento del bestiame Charolais in un circuito vario."
    ],
    "fr": [
      "Un circuit qui flirte avec le Brionnais et l'Allier. Au départ du Village de Caractère du Crozet, vous traverserez étangs, prairies d'élevage charolais dans un circuit varié."
    ],
    "es": [
      "Una ruta que coquetea con el Brionnais y el Allier. Partiendo del pueblo de Crozet, atravesará estanques y prados de cría de ganado Charolais en un circuito variado."
    ],
    "nl": [
      "Een route die flirt met de Brionnais en de Allier. Vanuit het dorp Crozet doorkruist u vijvers en weiden met Charolais runderen op een gevarieerd parcours."
    ]
  },
  "rdfs:label": {
    "fr": [
      "N°G2 - Circuit Gravel le Bocage Roannais"
    ]
  },
