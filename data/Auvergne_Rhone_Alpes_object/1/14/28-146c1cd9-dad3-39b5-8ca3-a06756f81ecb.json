  "rdfs:comment": {
    "de": [
      "Die Charcuterie Carloux in Noyon bietet eine große Auswahl an Wurstwaren, aber auch hausgemachte Fertiggerichte zum Mitnehmen. Außerdem werden Obst und Gemüse sowie lokaler Honig verkauft."
    ],
    "en": [
      "The Charcuterie Carloux in Noyon offers a wide choice of charcuterie but also home-cooked meals to take away. Fruits and vegetables and local honey are also sold."
    ],
    "it": [
      "La Charcuterie Carloux di Noyon offre un'ampia gamma di salumi e piatti fatti in casa da portare via. Si vendono anche frutta e verdura e miele locale."
    ],
    "fr": [
      "La Charcuterie Carloux à Noyon propose un large choix de charcuteries mais également des plats cuisinés maison à emporter. Vente également de fruits et légumes mais aussi de miel local."
    ],
    "es": [
      "La Charcutería Carloux de Noyon ofrece una amplia gama de embutidos y también platos caseros para llevar. También se venden frutas y verduras, así como miel local."
    ],
    "nl": [
      "De Charcuterie Carloux in Noyon biedt een ruim assortiment charcuterie en ook huisgemaakte gerechten om mee te nemen. Er worden ook groenten en fruit verkocht, evenals lokale honing."
    ]
  },
