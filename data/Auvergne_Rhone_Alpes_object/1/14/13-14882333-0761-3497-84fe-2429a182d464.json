  "rdfs:comment": {
    "de": [
      "Die Auberge de La Louviere ist ein charmantes Restaurant im Dorf Saint Victor Montvianeix. Es verfügt über eine warme und einladende Atmosphäre und bietet eine raffinierte traditionelle französische Küche aus frischen lokalen Produkten."
    ],
    "en": [
      "The Auberge de La Louviere is a charming restaurant located in the village of Saint Victor Montvianeix. With its warm and welcoming atmosphere, it offers refined traditional French cuisine based on fresh local produce."
    ],
    "it": [
      "L'Auberge de La Louviere è un affascinante ristorante nel villaggio di Saint Victor Montvianeix. Con la sua atmosfera calda e accogliente, serve una raffinata cucina tradizionale francese a base di prodotti freschi locali."
    ],
    "fr": [
      "L'Auberge de La Louviere est un charmant restaurant situé dans le village de Saint Victor Montvianeix. Doté d'une ambiance chaleureuse et accueillante, il propose une cuisine traditionnelle française raffinée à base de produits locaux frais."
    ],
    "es": [
      "El Auberge de La Louviere es un restaurante con encanto situado en el pueblo de Saint Victor Montvianeix. De ambiente cálido y acogedor, sirve una refinada cocina tradicional francesa elaborada con productos frescos de la zona."
    ],
    "nl": [
      "De Auberge de La Louviere is een charmant restaurant in het dorp Saint Victor Montvianeix. Het heeft een warme en gastvrije sfeer en serveert verfijnde traditionele Franse gerechten met verse streekproducten."
    ]
  },
