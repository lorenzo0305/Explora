  "rdfs:comment": {
    "de": [
      "Tauschen Sie Ihre Eindrücke aus und entdecken Sie unsere Sammlungen. Wir bieten Ihnen oft neue Bücher aus allen Genres an (Krimis, Literaturpreise, Sagas, Jugendbücher, Comics...)"
    ],
    "en": [
      "Come and share your impressions and discover our collections. We often offer recent books in all genres (thrillers, literary prizes, sagas, children's books, comics, etc.)"
    ],
    "it": [
      "Venite a condividere le vostre impressioni e a scoprire le nostre collezioni. Proponiamo spesso libri recenti di tutti i generi (thriller, premi letterari, saghe, libri per bambini, fumetti...)"
    ],
    "fr": [
      "Venez échanger vos impressions et découvrir nos collections. Nous vous proposons souvent des livres récents dans tous les genres (policier, prix littéraires, sagas, jeunesse, BD...)"
    ],
    "es": [
      "Venga a compartir sus impresiones y a descubrir nuestras colecciones. A menudo ofrecemos libros recientes de todos los géneros (thrillers, premios literarios, sagas, libros infantiles, cómics, etc.)"
    ],
    "nl": [
      "Kom en deel je indrukken en ontdek onze collecties. We bieden vaak recente boeken aan in alle genres (thrillers, literaire prijzen, saga's, kinderboeken, strips, enz.)"
    ]
  },
