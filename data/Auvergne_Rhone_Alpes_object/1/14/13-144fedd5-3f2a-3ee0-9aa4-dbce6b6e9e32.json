  "rdfs:comment": {
    "de": [
      "Idealer See für die Ausübung des Angelsports. Verkauf von Angelscheinen und im Office de tourisme hautes Vallées, Antenne von Saint-Agrève, im Bureau de Tabac in Saint-Agrève."
    ],
    "en": [
      "Ideal lake for fishing. Fishing licenses on sale at the Hautes Vallées Tourist Office, Saint-Agrève branch, and at the tobacconist's in Saint-Agrève."
    ],
    "it": [
      "Lago ideale per la pesca. Permessi di pesca in vendita presso l'Ufficio del Turismo delle Hautes Vallées, filiale di Saint-Agrève, e presso la tabaccheria di Saint-Agrève."
    ],
    "fr": [
      "Lac idéal pour la pratique de la pêche. Vente de permis pêche et à l'Office de tourisme hautes Vallées, antenne de Saint-Agrève,  au bureau de Tabac  à Saint-Agrève."
    ],
    "es": [
      "Lago ideal para la pesca. Permisos de pesca a la venta en la Oficina de Turismo de Hautes Vallées, sucursal de Saint-Agrève, y en el estanco de Saint-Agrève."
    ],
    "nl": [
      "Ideaal meer om te vissen. Visvergunningen te koop bij het Office du Tourisme des Hautes Vallées, filiaal Saint-Agrève, en bij de tabakswinkel in Saint-Agrève."
    ]
  },
