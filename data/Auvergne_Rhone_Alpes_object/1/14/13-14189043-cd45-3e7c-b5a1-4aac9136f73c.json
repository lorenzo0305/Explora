  "rdfs:comment": {
    "de": [
      "Ein einzigartiges Erlebnis in Val Thorens sind die zweistündigen Fahrten mit der Pistenraupe, die mit einem savoyischen Aperitif abgerundet werden! Begleiten Sie uns dienstags und donnerstags auf einem faszinierenden Ausflug zum Vallon du Lou oder zum Plan d'Eau des Bruyères."
    ],
    "en": [
      "Enjoy a unique experience in Val Thorens with our 2-hour snow groomer rides, complete with a Savoyard aperitif! Join us on Tuesdays and Thursdays for a fascinating excursion to the Vallon du Lou or the Plan d'Eau des Bruyères."
    ],
    "it": [
      "Godetevi un'esperienza unica in Val Thorens con le nostre escursioni in groomer di 2 ore, complete di aperitivo savoiardo! Unitevi a noi il martedì e il giovedì per un'affascinante escursione al Vallon du Lou o al Plan d'Eau des Bruyères."
    ],
    "fr": [
      "Vivez une expérience unique à Val Thorens avec les balades en dameuse de 2 heures, agrémentées d’un apéritif savoyard ! Rejoignez-nous les mardis et jeudis pour une excursion fascinante vers le Vallon du Lou ou le Plan d’Eau des Bruyères."
    ],
    "nl": [
      "Geniet van een unieke ervaring in Val Thorens met onze 2 uur durende groomer ritten, compleet met een Savoyaards aperitief! Ga met ons mee op dinsdag en donderdag voor een fascinerende excursie naar de Vallon du Lou of het Plan d'Eau des Bruyères."
    ],
    "es": [
      "Disfrute de una experiencia única en Val Thorens con nuestros paseos en groomer de 2 horas, ¡completados con un aperitivo saboyano! Acompáñenos los martes y jueves en una fascinante excursión al Vallon du Lou o al Plan d'Eau des Bruyères."
    ]
  },
  "rdfs:label": {
    "en": [
      "Snow groomer ride with Savoyard aperitif"
    ],
    "it": [
      "Giro in battipista con aperitivo savoiardo"
    ],
    "fr": [
      "Balade en dameuse avec apéritif savoyard"
    ],
    "nl": [
      "Sneeuwscooterrit met Savoyaards aperitief"
    ],
    "es": [
      "Paseo en máquina pisanieves con aperitivo saboyano"
    ]
  },
