  "rdfs:comment": {
    "de": [
      "Der 2021 gegründete Verein Vents du Vercors versucht, Aufführungen in all ihren Formen zu fördern: Konzerte, Tanz-, Theater- und Zirkusvorstellungen, verschiedene Ausstellungen wie Malerei oder Fotografie."
    ],
    "en": [
      "The Vents du Vercors association, created in 2021, aims to promote all forms of entertainment, including concerts, dance, theater, circus and various exhibitions, such as painting and photography."
    ],
    "it": [
      "L'associazione Vents du Vercors, istituita nel 2021, mira a promuovere tutte le forme di intrattenimento, tra cui concerti, danza, teatro, circo e mostre varie, come pittura e fotografia."
    ],
    "fr": [
      "L'association Vents du Vercors, créée en 2021, cherche à promouvoir les spectacles sous toutes ses formes, concerts, spectacles de danse, théâtre, cirque, expositions diverses, comme la peinture ou la photographie."
    ],
    "es": [
      "La asociación Vents du Vercors, creada en 2021, tiene como objetivo promover todas las formas de entretenimiento, incluidos conciertos, danza, teatro, circo y diversas exposiciones, como pintura y fotografía."
    ],
    "nl": [
      "De vereniging Vents du Vercors, opgericht in 2021, wil alle vormen van vermaak promoten, waaronder concerten, dans, theater, circus en verschillende tentoonstellingen, zoals schilderkunst en fotografie."
    ]
  },
