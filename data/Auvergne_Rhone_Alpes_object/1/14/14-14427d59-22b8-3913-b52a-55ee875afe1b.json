  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3760d414-c3a3-3052-84ad-12d7422d6cc0",
      "dc:description": {
        "de": [
          "Daten und Uhrzeiten der Boule-Turniere in Porteloises :\n- Samstag, 3. August 2024 , Samstag, 17. August 2024 & Samstag, 31. August 2024: von 15:30 bis 17:30 Uhr , Treffpunkt am Strandabgang\n- Samstag, 10. August 2024 & Samstag, 24. August 2024: von 9.30 bis 11.30 Uhr , Treffpunkt am Strandabgang\nDie Teilnahme ist kostenlos.\nAnmeldung vor Ort.\nBitte kommen Sie 15 Minuten vor Beginn des Turniers an."
        ],
        "en": [
          "Dates and times of the boules porteloises tournaments:\n- Saturday, August 3, 2024 , Saturday, August 17, 2024 and Saturday, August 31, 2024 : from 3:30 pm to 5:30 pm , meet at the beach downhill\n- Saturday, August 10, 2024 & Saturday, August 24, 2024: 9:30 am to 11:30 am, meet at the beach downhill\nFree admission.\nRegistration on site.\nPlease arrive 15 minutes before the start of the tournament."
        ],
        "it": [
          "Date e orari dei tornei di bocce di Porteloises:\n- Sabato 3 agosto 2024, sabato 17 agosto 2024 e sabato 31 agosto 2024: dalle 15.30 alle 17.30, ritrovo sulla pista della spiaggia\n- Sabato 10 agosto 2024 e sabato 24 agosto 2024: dalle 9.30 alle 11.30, ritrovo alla discesa della spiaggia\nGratuito.\nRegistrazione in loco.\nSi prega di arrivare 15 minuti prima dell'inizio del torneo."
        ],
        "fr": [
          "Dates et heures des tournois de boules porteloises : \n- Samedi 3 août 2024 , samedi 17 août 2024 et samedi 31 août 2024 : de 15h30 à 17h30 , rdv en descente de plage\n- Samedi 10 août 2024 & samedi 24 août 2024 : de 9h30 à 11h30 , rdv en descente de plage\nGratuit. \nInscriptions sur place.\nMerci d'arriver 15 minutes avant le début du tournoi."
        ],
        "es": [
          "Fechas y horarios de los torneos de Boules Porteloises:\n- Sábado 3 de agosto de 2024 , sábado 17 de agosto de 2024 y sábado 31 de agosto de 2024 : de 15h30 a 17h30, punto de encuentro en la bajada de la playa\n- Sábado 10 de agosto de 2024 y sábado 24 de agosto de 2024: de 9.30 a 11.30 h, punto de encuentro en la bajada de la playa\nGratuito.\nInscripción in situ.\nSe ruega llegar 15 minutos antes del comienzo del torneo."
        ],
        "nl": [
          "Data en tijden van de Jeu de Boules Porteloises toernooien:\n- Zaterdag 3 augustus 2024 , zaterdag 17 augustus 2024 en zaterdag 31 augustus 2024: van 15.30 tot 17.30 uur, verzamelen bij de strandafdaling\n- Zaterdag 10 augustus 2024 & zaterdag 24 augustus 2024: van 9.30 tot 11.30 uur, verzamelen bij de strandafdaling\nGratis.\nRegistratie ter plaatse.\nGelieve 15 minuten voor de start van het toernooi aanwezig te zijn."
        ]
      },
