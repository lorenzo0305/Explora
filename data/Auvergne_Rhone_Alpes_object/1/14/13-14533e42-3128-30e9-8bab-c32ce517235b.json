  "rdfs:comment": {
    "de": [
      "Es erwartet Sie eine regionale und kreative Küche. Der Küchenchef bietet ein saisonales Menü an, das je nach Marktlage und Inspirationen regelmäßig erneuert wird. Eine frische und authentische Küche mit subtilen orientalischen Einflüssen"
    ],
    "en": [
      "Creative regional cuisine awaits you. The chef proposes a seasonal menu, regularly renewed according to the market and his inspirations. Fresh, authentic cuisine, with subtle touches of oriental influences"
    ],
    "it": [
      "Vi aspetta una cucina regionale e creativa. Lo chef propone un menu stagionale, regolarmente rinnovato in base al mercato e alle sue ispirazioni. Una cucina fresca e autentica con sottili tocchi di influenze orientali"
    ],
    "fr": [
      "Une cuisine régionale et créative vous attend. Le chef propose un menu de saison, régulièrement renouvelé en fonction du marché et de ses inspirations. Une cuisine fraîche et authentique, tout en y apportant des touches subtiles d’influences orientales"
    ],
    "nl": [
      "Regionale en creatieve gerechten wachten op je. De chef stelt een seizoensmenu voor dat regelmatig wordt vernieuwd op basis van de markt en zijn inspiraties. Een verse, authentieke keuken met subtiele oosterse invloeden"
    ],
    "es": [
      "Le espera una cocina regional y creativa. El chef propone un menú de temporada, renovado regularmente según el mercado y sus inspiraciones. Cocina fresca y auténtica con sutiles toques de influencias orientales"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table des 2L"
    ]
  },
