  "rdfs:comment": {
    "de": [
      "Entdecken Sie in diesem Museum die Gemälde zweier außergewöhnlicher Künstlerinnen. Elise Rieuf (1897 – 1990) lässt ihre Heimatregion Auvergne, ihre Reisen durch Europa und ihren langjährigen China-Aufenthalt lebendig werden. Charlotte Musson (1905-1975) ist eine eindrucksvolle Pariser Porträtmalerin; berühmte Schriftsteller wie Marguerite Yourcenar, Blaise Cendrars und Marcel Aymé standen für sie Modell. Schillernde Farben, authentische Portraits, vielfältige Inspirationen – ein hochwertiger Kunstgenuss."
    ],
    "en": [
      "A warm-hearted museum: 7 women painters from the same Parisian studio. Figurative paintings from the 1930s to the end of the 20th century. Here we travel (China, Europe, Paris), see celebrities (Yourcenar, Cendrars, Marcel Aymé) and blue Auvergne landscapes."
    ],
    "it": [
      "Un museo conviviale: 7 pittrici dello stesso studio parigino. Dipinti figurativi dagli anni '30 alla fine del XX secolo. Qui si può viaggiare (Cina, Europa, Parigi), vedere celebrità (Yourcenar, Cendrars, Marcel Aymé) e paesaggi blu dell'Alvernia."
    ],
    "fr": [
      "Musée chaleureux: 7 peintres femmes issues du même atelier parisien. Tableaux figuratifs des années 30 à la fin du XXe siècle. Ici on voyage (Chine, Europe, Paris), on voit des célébrités (Yourcenar, Cendrars, Marcel Aymé, des paysages bleutés d'Auvergne."
    ],
    "es": [
      "Un museo amigo: 7 pintoras de un mismo taller parisino. Pinturas figurativas de los años 30 a finales del siglo XX. Aquí se puede viajar (China, Europa, París), ver celebridades (Yourcenar, Cendrars, Marcel Aymé) y paisajes azules de Auvernia."
    ],
    "nl": [
      "Een vriendelijk museum: 7 vrouwelijke schilders uit hetzelfde Parijse atelier. Figuratieve schilderijen van de jaren 1930 tot het einde van de 20e eeuw. Hier kun je reizen (China, Europa, Parijs), beroemdheden zien (Yourcenar, Cendrars, Marcel Aymé) en blauwe Auvergne landschappen."
    ]
  },
