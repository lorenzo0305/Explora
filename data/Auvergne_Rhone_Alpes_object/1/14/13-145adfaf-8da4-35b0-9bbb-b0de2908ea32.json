  "rdfs:comment": {
    "de": [
      "In der Brasserie Le Skiff können Sie einen kulinarischen Zwischenstopp mit Blick auf den Lac du Bourget einlegen. Von sonnigen Cocktails über Meeresfrüchte bis hin zu schmackhaften Gerichten und exquisiten Desserts: Das ganze Jahr über gibt es eine große Auswahl an Geschmacksrichtungen."
    ],
    "en": [
      "At Le Skiff brasserie, enjoy a gourmet break overlooking Lake Bourget. From our sunny cocktails to our generous seafood dishes, not to mention our tasty meals and exquisite desserts: a range of flavors available all year round."
    ],
    "it": [
      "Alla brasserie Le Skiff, concediti una pausa golosa affacciata sul lago di Bourget. Dai nostri cocktail solari ai nostri generosi piatti di pesce, passando per le nostre gustose pietanze e i nostri squisiti dessert: una gamma di sapori disponibile tutto l'anno."
    ],
    "fr": [
      "A la brasserie Le Skiff, vivez une escale gourmande face au lac du Bourget. De nos cocktails ensoleillés à nos généreux fruits de mer, en passant par nos plats savoureux et nos desserts exquis: une palette de saveurs disponible toute l'année."
    ],
    "nl": [
      "Geniet van een gastronomische pauze met uitzicht op het Lac du Bourget in Brasserie Le Skiff. Van onze zonnige cocktails tot onze royale zeevruchten, en niet te vergeten onze smakelijke gerechten en exquise desserts: een smakenpalet dat het hele jaar door beschikbaar is."
    ],
    "es": [
      "Disfrute de una pausa gastronómica con vistas al lago Bourget en la Brasserie Le Skiff. Desde nuestros soleados cócteles hasta nuestro generoso marisco, sin olvidar nuestros sabrosos platos y exquisitos postres: una paleta de sabores disponible todo el año."
    ]
  },
