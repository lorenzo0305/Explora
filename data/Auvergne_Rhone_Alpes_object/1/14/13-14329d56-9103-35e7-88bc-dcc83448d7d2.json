  "rdfs:comment": {
    "de": [
      "Dieses Feriendorf ist mit einer Fahrradwaschanlage, Reparaturwerkstatt und Fahrradgaragen ausgestattet... 13 Mountainbike-Routen können auf der Website www.veloenfrance.fr oder über die Cirkwi-App heruntergeladen werden."
    ],
    "en": [
      "This vacation village is equipped with a bike washing station, repair workshop, bike garages... 13 mountain bike circuits are available for download at www.veloenfrance.fr or on the Cirkwi app."
    ],
    "it": [
      "Questo villaggio vacanze è dotato di lavaggio biciclette, officina di riparazione, garage per biciclette, ecc. 13 circuiti per mountain bike sono scaricabili dal sito www.veloenfrance.fr o dall'app Cirkwi."
    ],
    "fr": [
      "Ce village vacances est équipé d'une station de lavage vélo, atelier réparation, garages à vélos... 13 circuits VTT sont à télécharger sur le site de www.veloenfrance.fr ou sur l'application Cirkwi."
    ],
    "nl": [
      "Mountainbikes"
    ],
    "es": [
      "Esta ciudad de vacaciones está equipada con lavadero de bicicletas, taller de reparación, garajes para bicicletas, etc. en el sitio web www.veloenfrance.fr o en la app Cirkwi se pueden descargar 13 circuitos de bicicleta de montaña."
    ]
  },
