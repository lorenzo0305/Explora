  "rdfs:comment": {
    "de": [
      "H2o Sports &amp; Evolution2 in der Nähe von La Plagne, seit 30 Jahren an 4 Standorten, um Ihnen sichere Erlebnisse beim Rafting, Deval Bike, Hydrospeed, Canyoning, Paddle, Canoraft, Kajak, Paintball, E-Scoot, E-Bike zu ermöglichen."
    ],
    "en": [
      "H2o Sports & Evolution2 close to La Plagne, for 30 years, on 4 sites to make you live in safety experiences in Rafting, Deval bike, Hydrospeed, Canyoning, Paddle, Canoraft, kayak, paintball, E-scoot, E-Bike."
    ],
    "it": [
      "H2o Sports & Evolution2, vicino a La Plagne, opera da 30 anni su 4 siti, offrendo la possibilità di sperimentare Rafting, Deval bike, Hydrospeed, Canyoning, Paddle, Canoraft, Kayak, Paintball, E-scoot, E-Bike in tutta sicurezza."
    ],
    "fr": [
      "H2o Sports & Evolution2 proche de La Plagne, depuis 30 ans, sur 4 sites pour vous faire vivre en sécurité des expériences en Rafting, Deval bike, Hydrospeed, Canyoning, Paddle, Canoraft, kayak, paintball, E-scoot, E-Bike."
    ],
    "nl": [
      "H2o Sports & Evolution2, in de buurt van La Plagne, is al 30 jaar actief op 4 locaties en biedt je de kans om Rafting, Deval bike, Hydrospeed, Canyoning, Paddle, Canoraft, Kayak, Paintball, E-scoot, E-Bike in alle veiligheid te ervaren."
    ],
    "es": [
      "H2o Sports & Evolution2, cerca de La Plagne, opera desde hace 30 años en 4 emplazamientos, ofreciéndole la posibilidad de practicar Rafting, Deval bike, Hydrospeed, Canyoning, Paddle, Canoraft, Kayak, Paintball, E-scoot, E-Bike con total seguridad."
    ]
  },
