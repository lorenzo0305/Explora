      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/5ec19f30-2086-359f-8fb4-e79c8ec9a865",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Vom 01. April bis zum 30. Juni\r\nÖffnungszeiten: Montag, Dienstag, Mittwoch, Donnerstag und Freitag von 9:30 bis 12:00 Uhr und von 14:00 bis 17:30 Uhr. Samstags von 9:00 bis 18:00 Uhr.\r\n\r\nVom 01. JULI bis zum 31. AUGUST\r\nTäglich von 9:00 bis 19:00 Uhr geöffnet.\r\n\r\nSEPTEMBER\r\nTägliche Aktivitäten bis zum 30. September nach vorheriger Anmeldung.\r\nTeilen Sie uns Ihre Pläne und Anfragen per E-Mail an info@h2osports.fr mit."
            ],
            "en": [
              "From APRIL 01 to JUNE 30\r\nOpen Monday, Tuesday, Wednesday, Thursday and Friday, 9.30am to 12pm and 2pm to 5.30pm. Saturday from 9am to 6pm.\r\n\r\nFrom JULY 01 to AUGUST 31\r\nOpen every day from 9am to 7pm.\r\n\r\nSEPTEMBER\r\nActivities every day until September 30 on reservation.\r\nSend us your projects and requests by e-mail to info@h2osports.fr."
            ],
            "it": [
              "Dal 01 APRILE al 30 GIUGNO\r\nAperto lunedì, martedì, mercoledì, giovedì e venerdì dalle 9.30 alle 12.00 e dalle 14.00 alle 17.30. Sabato dalle 9.00 alle 18.00.\r\n\r\nDal 01 LUGLIO al 31 AGOSTO\r\nAperto tutti i giorni dalle 9.00 alle 19.00.\r\n\r\nSETTEMBRE\r\nAttività tutti i giorni fino al 30 settembre su prenotazione.\r\nInviateci i vostri progetti e le vostre richieste via e-mail a info@h2osports.fr."
            ],
            "fr": [
              "Du 01 AVRIL au 30 JUIN \r\nOuverture le lundi, mardi, mercredi, jeudi et vendredi de 9h30 à 12h et de 14h à 17h30. Le samedi de 9h à 18h.\r\n\r\nDu 01 JUILLET au 31 AOUT \r\nOuverture tous les jours de 9h à 19h.\r\n\r\nSEPTEMBRE\r\nActivités tous les jours jusqu’au 30 septembre sur réservation.\r\nFaites nous part de vos projets et demandes par e-mail à info@h2osports.fr."
            ],
            "nl": [
              "Van 01 APRIL tot 30 JUNI\r\nGeopend op maandag, dinsdag, woensdag, donderdag en vrijdag van 9.30 tot 12.00 uur en van 14.00 tot 17.30 uur. Op zaterdag van 9 tot 18 uur.\r\n\r\nVan 01 JULI tot 31 AUGUST\r\nDagelijks geopend van 9.00 tot 19.00 uur.\r\n\r\nSEPTEMBER\r\nElke dag activiteiten tot 30 september op reservering.\r\nStuur ons je projecten en verzoeken per e-mail naar info@h2osports.fr."
            ],
            "es": [
              "Del 01 DE ABRIL al 30 DE JUNIO\r\nAbierto lunes, martes, miércoles, jueves y viernes de 9.30 h a 12 h y de 14 h a 17.30 h. Sábados de 9.00 a 18.00 h.\r\n\r\nDel 01 DE JULIO al 31 DE AGOSTO\r\nAbierto todos los días de 9.00 a 19.00 h.\r\n\r\nSEPTIEMBRE\r\nActividades todos los días hasta el 30 de septiembre previa reserva.\r\nEnvíenos sus proyectos y solicitudes por correo electrónico a info@h2osports.fr."
            ]
          },
