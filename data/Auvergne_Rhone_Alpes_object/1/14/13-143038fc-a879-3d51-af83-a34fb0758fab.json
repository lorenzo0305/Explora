  "rdfs:comment": {
    "de": [
      "Fahren Sie die spezielle Skipiste für Anfänger hinunter und steigen Sie mühelos auf einem geschützten, untertunnelten Teppich wieder auf. Der ideale Ort, um sicher mit dem Skifahren zu beginnen."
    ],
    "en": [
      "Slide down the special ski slope for beginners, and effortlessly get back up on an equipped mat sheltered under a tunnel. The ideal place to start skiing safely."
    ],
    "it": [
      "Scendete lungo la speciale pista per principianti e risalite senza fatica sul tappeto protetto sotto la galleria. Il luogo ideale per iniziare a sciare in tutta sicurezza."
    ],
    "fr": [
      "Dévalez la piste de ski spéciale débutant, et remontez sans effort sur tapis aménagé et abrité sous tunnel. L'endroit idéal pour démarrer le ski en toute sécurité."
    ],
    "nl": [
      "ski op een speciale skipiste voor beginners en klim moeiteloos weer omhoog op een uitgeruste, beschutte onder een tunnel. De ideale plek om veilig te skiën."
    ],
    "es": [
      "Baje por la pendiente especial para principiantes y suba sin esfuerzo por la alfombra protegida bajo el túnel. El lugar ideal para iniciarse en el esquí con total seguridad."
    ]
  },
  "rdfs:label": {
