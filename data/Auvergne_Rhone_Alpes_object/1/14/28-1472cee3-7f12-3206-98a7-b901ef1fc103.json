  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6d477dbf-ed1b-3073-a717-4f0f8cc8ef6c",
      "dc:description": {
        "de": [
          "La Civette ist eine Brasserie im Stadtzentrum, in der Sie typisch französische Gerichte wie Kabeljau-Rücken, gebratenen Kapaun mit Pilzen oder den traditionellen Vol-au-vent in einer gemütlichen Atmosphäre genießen können."
        ],
        "en": [
          "La Civette is a brasserie located in the center of town, where you can enjoy typical French dishes such as cod back, pan-fried capon with mushrooms or the traditional vol-au-vent, all in a warm atmosphere."
        ],
        "it": [
          "La Civette è una brasserie situata nel centro della città, dove si possono gustare piatti tipici francesi come il dorso di merluzzo, il cappone in padella con funghi o il tradizionale vol-au-vent, il tutto in un'atmosfera accogliente."
        ],
        "fr": [
          "La Civette est une brasserie située en centre ville, ou vous pourrez déguster des plats typiques français comme le dos de cabillaud ou encore le chapon poêlé aux champignons ou encore le traditionnel vol-au-vent, le tout dans une ambiance chaleureuse."
        ],
        "nl": [
          "La Civette is een brasserie in het centrum van de stad, waar je in een gezellige sfeer kunt genieten van typisch Franse gerechten zoals kabeljauwrug, gebakken kapoen met champignons of de traditionele vol-au-vent."
        ],
        "es": [
          "La Civette es una brasserie situada en el centro de la ciudad, donde podrá degustar platos típicos franceses como lomo de bacalao, capón a la sartén con setas o el tradicional vol-au-vent, todo ello en un ambiente acogedor."
        ]
      },
