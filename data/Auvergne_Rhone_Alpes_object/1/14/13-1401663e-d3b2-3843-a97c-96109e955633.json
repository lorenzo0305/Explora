  "rdfs:comment": {
    "de": [
      "Für Ihre täglichen Fahrten oder einfach nur für einen Spaziergang bietet der Grüne Weg die Möglichkeit, sanfte Verkehrsmittel zu bevorzugen, und das in aller Sicherheit!"
    ],
    "en": [
      "Whether you're commuting or just out for a stroll, the voieVerte is a safe way to use alternative modes of transport!"
    ],
    "it": [
      "Che si tratti di pendolarismo o di una semplice passeggiata, la voieVerte è un modo sicuro per utilizzare mezzi di trasporto alternativi!"
    ],
    "fr": [
      "Pour vos trajets quotidiens ou simplement lors d'une balade, la voieVerte permet de privilégier les modes de transports doux, en toute sécurité !"
    ],
    "es": [
      "Ya sea para ir al trabajo o para pasear, la voieVerte es una forma segura de utilizar medios de transporte alternativos."
    ],
    "nl": [
      "Of je nu woon-werkverkeer doet of gewoon een wandelingetje maakt, de voieVerte is een veilige manier om alternatieve vervoersmiddelen te gebruiken!"
    ]
  },
  "rdfs:label": {
