  "rdfs:comment": {
    "de": [
      "Erleben Sie ein umfassendes Wellness-Erlebnis, indem Sie die Vorteile der traditionellen Sauna mit Tauchgängen in kaltem Wasser kombinieren.\r\nSie möchten nicht untertauchen? Keine Sorge, genießen Sie einfach nur die Wohltaten der Sauna!"
    ],
    "en": [
      "Enjoy a complete wellness experience, combining the benefits of a traditional sauna with cold-water immersion.\r\nIf you don't want to immerse yourself, don't worry - just enjoy the benefits of the sauna!"
    ],
    "it": [
      "Godetevi un'esperienza di benessere completa combinando i benefici di una sauna tradizionale con l'immersione in acqua fredda.\r\nSe non volete immergervi nell'acqua fredda, non preoccupatevi, godetevi i benefici della sauna!"
    ],
    "fr": [
      "Vivez une expérience bien-être complète en combinant les bienfaits du sauna traditionnel et des immersions en eau froide. \r\nVous ne souhaitez pas vous immerger ? pas de soucis profitez uniquement des bienfaits du sauna !"
    ],
    "nl": [
      "Geniet van een complete wellnesservaring door de voordelen van een traditionele sauna te combineren met een onderdompeling in koud water.\nAls u zich niet wilt onderdompelen in koud water, geen zorgen, geniet gewoon van de voordelen van de sauna!"
    ],
    "es": [
      "Disfrute de una experiencia de bienestar completa combinando los beneficios de una sauna tradicional con la inmersión en agua fría.\r\nSi no quiere sumergirse en agua fría, no se preocupe, ¡disfrute de los beneficios de la sauna!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Nordic wellness - Mobile Sauna"
    ],
    "fr": [
      "Bien être nordique - Sauna Mobile"
    ],
    "nl": [
      "Nordic wellness - Mobiele sauna"
    ]
  },
