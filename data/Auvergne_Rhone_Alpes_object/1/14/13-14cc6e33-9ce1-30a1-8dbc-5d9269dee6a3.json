  "rdfs:comment": {
    "de": [
      "Das Pays Voironnais gehört zum nationalen Netzwerk der \"Städte und Landschaften der Kunst und Geschichte\" (Villes et Pays d'art et d'histoire). Das Kulturministerium vergibt diese Bezeichnung an Gebietskörperschaften, die Maßnahmen zur Vermittlung und zum Schutz des Kulturerbes und der Architektur initiieren."
    ],
    "en": [
      "Pays Voironnais is a member of the national network of \"Villes et Pays d'art et d'histoire\". The French Ministry of Culture awards this designation to local authorities that initiate actions to promote and safeguard heritage and architecture."
    ],
    "it": [
      "La regione del Voironnais fa parte della rete nazionale dei \"Villes et Pays d'art et d'histoire\". Il Ministero della Cultura assegna questa designazione alle autorità locali che avviano iniziative di promozione e salvaguardia del patrimonio e dell'architettura."
    ],
    "fr": [
      "Le Pays Voironnais appartient au réseau national des \"Villes et Pays d'art et d'histoire\". Le Ministère de la Culture attribue cette appellation aux collectivités qui initient des actions de médiation et de sauvegarde du patrimoine et de l'architecture."
    ],
    "es": [
      "La región de Voironnais forma parte de la red nacional de \"Villes et Pays d'art et d'histoire\". El Ministerio de Cultura concede esta designación a las autoridades locales que emprenden iniciativas para promover y salvaguardar el patrimonio y la arquitectura."
    ],
    "nl": [
      "De Voironnais maakt deel uit van het nationale netwerk van \"Villes et Pays d'art et d'histoire\". Het Ministerie van Cultuur kent dit predikaat toe aan lokale overheden die initiatieven nemen om erfgoed en architectuur te promoten en te beschermen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pays d'art et d'histoire du Pays Voironnais"
    ]
  },
