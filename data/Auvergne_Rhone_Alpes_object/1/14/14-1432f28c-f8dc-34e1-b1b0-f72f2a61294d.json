      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\nMontag bis Samstag von 7:00 bis 19:30 Uhr\n\nSonntag geschlossen\n \n Abholung:\nZu den Öffnungszeiten der Bäckerei\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Saturday, 7am to 7:30pm\n\nClosed on Sunday\n \n Pick-up:\nDuring bakery opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrari di apertura :\nDa lunedì a sabato, dalle 7.00 alle 19.30\n\nChiuso la domenica\n \n Raccolta:\nDurante gli orari di apertura della panetteria\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu lundi au samedi de 7h à 19h30\n\nFermeture le dimanche\n \n Retrait :\nAux horaires d'ouverture de la boulangerie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningstijden :\nMaandag tot zaterdag, 7u tot 19u30\n\nGesloten op zondag\n \n Afhalen:\nTijdens openingstijden bakkerij\n\n "
        ],
        "es": [
          "Más información :\n\nHorarios de apertura :\nDe lunes a sábado, de 7h a 19h30\n\nDomingo cerrado\n \n Recogida:\nDurante el horario de apertura de la panadería\n\n "
        ]
