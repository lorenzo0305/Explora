  "rdfs:comment": {
    "de": [
      "Der Klettersteig ist leicht und 120 Meter lang. Es ist ideal für Familien und Anfänger (Kinder ab 1m30), die ihre ersten Klettergefühle entdecken möchten."
    ],
    "en": [
      "Classified easy (F) and 120 meters long, it is ideal for families and beginners (children from 1m30) who want to discover their first sensations of climbing."
    ],
    "it": [
      "Classificata facile (F) e lunga 120 metri, è ideale per le famiglie e i principianti (bambini a partire da 1,30 m) che vogliono scoprire le prime sensazioni di arrampicata.\r\nI bambini di peso inferiore a 40 kg devono essere legati in cordata."
    ],
    "fr": [
      "Classée facile (F) et d'une longueur de 120 mètres, elle est idéale pour les familles et les débutants (enfants à partir de 1m30) qui veulent découvrir leurs premières sensations de grimpe. \r\nLes enfants en dessous de 40 kg doivent être encordés."
    ],
    "nl": [
      "Deze klim is gemakkelijk (F) en 120 meter lang en is ideaal voor gezinnen en beginners (kinderen vanaf 1,30 m) die hun eerste klimsensaties willen ontdekken.\r\nKinderen onder de 40 kg moeten in touw."
    ],
    "es": [
      "Clasificada fácil (F) y de 120 metros de longitud, es ideal para familias y principiantes (niños a partir de 1,30 m) que quieran descubrir sus primeras sensaciones de escalada.\r\nLos niños de menos de 40 kg deben ir encordados."
    ]
  },
  "rdfs:label": {
