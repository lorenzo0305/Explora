  "rdfs:comment": {
    "de": [
      "Am Ufer des \"Lac des Sapins\". Traditionelle Küche, die mit Produkten aus der Region zubereitet wird. Gutes Preis-Leistungs-Verhältnis... Einzigartiges Menü, das mittags und abends als Tellergericht serviert wird."
    ],
    "en": [
      "At the edge of the \"Lac des Sapins\". Traditional cuisine prepared from local products. Good value for money... Single menu served at lunch and dinner."
    ],
    "it": [
      "Ai margini del \"Lac des Sapins\". Cucina tradizionale preparata con prodotti locali. Buon rapporto qualità/prezzo... Menu unico servito a pranzo e a cena."
    ],
    "fr": [
      "Au bord du \"Lac des Sapins\". Cuisine traditionnelle préparée à partir des produits du terroir. Bon rapport qualité-prix... Menu unique servi au plat midi et soir."
    ],
    "es": [
      "Al borde del \"Lac des Sapins\". Cocina tradicional elaborada con productos locales. Buena relación calidad-precio... Menú único servido en el almuerzo y la cena."
    ],
    "nl": [
      "Aan de rand van het \"Lac des Sapins\". Traditionele keuken bereid met lokale producten. Waar voor je geld... Eén menu voor lunch en diner."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge Paysanne \"La Voisinée\""
    ]
  },
