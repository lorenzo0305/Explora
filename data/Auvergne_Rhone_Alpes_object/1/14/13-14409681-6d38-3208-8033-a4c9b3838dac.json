  "rdfs:comment": {
    "de": [
      "Bistronomisches Restaurant mit einer marktfrischen, kreativen Küche, die lokale und saisonale Produkte hervorhebt. Schöne Terrasse im Grünen, gemütlicher, klimatisierter Saal mit Kamin, großer Privatparkplatz, in der Nähe von Bourg-en-Bresse."
    ],
    "en": [
      "Bistronomic restaurant offering creative, market-driven cuisine featuring local, seasonal produce. Beautiful terrace surrounded by greenery, cosy, air-conditioned dining room with fireplace, large private parking lot, near Bourg-en-Bresse."
    ],
    "it": [
      "Ristorante bistrot che propone una cucina creativa e fresca di mercato con prodotti locali e di stagione. Splendida terrazza immersa nel verde, accogliente sala da pranzo climatizzata con camino, ampio parcheggio privato, vicino a Bourg-en-Bresse."
    ],
    "fr": [
      "Restaurant bistronomique proposant une cuisine du marché, créative qui met en valeur les produits locaux et de saison. Belle terrasse entourée de verdure, salle cosy, climatisée avec cheminée, grand parking privé, proche Bourg-en-Bresse."
    ],
    "es": [
      "Restaurante bistró de cocina creativa y de mercado con productos locales de temporada. Hermosa terraza rodeada de vegetación, acogedor comedor climatizado con chimenea, amplio aparcamiento privado, cerca de Bourg-en-Bresse."
    ],
    "nl": [
      "Bistro-restaurant met een creatieve, verse keuken op basis van lokale seizoensproducten. Mooi terras omgeven door groen, gezellige eetzaal met airconditioning en open haard, grote privéparkeerplaats, vlakbij Bourg-en-Bresse."
    ]
  },
