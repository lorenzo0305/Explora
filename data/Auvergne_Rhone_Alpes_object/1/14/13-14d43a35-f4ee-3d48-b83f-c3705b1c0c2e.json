  "rdfs:comment": {
    "de": [
      "Ein Must-have-Ort in Drôme für die gemütliche und schmackhafte Küche in einem einzigartigen ländlichen Umfeld und für festliche Anlässe und kulturelle Programmierung."
    ],
    "en": [
      "A place of sharing in Drôme. Convivial and tasty cuisine in a unique country setting. Perfect for festive gatherings or to enjoy a nice cultural program."
    ],
    "it": [
      "Un luogo da condividere nella Drôme, per la sua cucina amichevole e gustosa in un ambiente rurale unico e per i suoi eventi festivi e il suo programma culturale."
    ],
    "fr": [
      "Un lieu de partage incontournable en Drôme, pour sa cuisine conviviale et savoureuse dans un cadre champêtre unique et pour ses rendez-vous festifs et sa programmation culturelle."
    ],
    "es": [
      "Un lugar para compartir en la Drôme, por su cocina acogedora y sabrosa en un entorno rural único y por sus eventos festivos y su programa cultural."
    ],
    "nl": [
      "Een plaats van essentieel delen in de Drôme, voor zijn vriendelijke en smakelijke keuken in een unieke landelijke omgeving en voor zijn feestelijke afspraken en culturele programmering"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Fontaine Minérale"
    ]
  },
