  "rdfs:comment": {
    "de": [
      "Steigen Sie zu den Ruinen des Schlosses Le Broc hinauf und genießen Sie die Aussicht, bevor Sie durch die Türen des Hotelrestaurants Origines von Adrien Descouls schreiten. Der Chefkoch und sein Team bieten Ihnen eine Gourmetküche, in der die Produkte der Auvergne im Mittelpunkt stehen."
    ],
    "en": [
      "Go up to the ruins of the Broc castle, enjoy the view before entering the hotel restaurant Origines by Adrien Descouls. The chef and his team offer you a gastronomic cuisine with a focus on Auvergne products."
    ],
    "it": [
      "Salite sulle rovine dello Château du Broc e godetevi il panorama prima di entrare nel ristorante dell'hotel Origines di Adrien Descouls. Lo chef e il suo team propongono una cucina gastronomica incentrata sui prodotti dell'Alvernia."
    ],
    "fr": [
      "Montez jusqu'aux ruines du château du Broc, profitez de la vue avant de franchir les portes de l'hôtel restaurant Origines par Adrien Descouls. Le chef et son équipe vous proposent une cuisine gastronomique faisant la part belle aux produits auvergnats."
    ],
    "es": [
      "Suba a las ruinas del Château du Broc y disfrute de las vistas antes de entrar en el restaurante del hotel Origines de Adrien Descouls. El chef y su equipo ofrecen una cocina gastronómica centrada en los productos de Auvernia."
    ],
    "nl": [
      "Klim naar de ruïnes van het Château du Broc en geniet van het uitzicht voordat u het hotelrestaurant Origines van Adrien Descouls betreedt. De chef en zijn team bieden een gastronomische keuken met de nadruk op producten uit de Auvergne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Origines par Adrien Descouls"
    ]
  },
