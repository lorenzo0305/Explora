  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Les Volcans\" bietet eine regionale \"hausgemachte\" Küche aus frischen Produkten, die bei lokalen Produzenten und Lieferanten ausgewählt und von der Küchenchefin sorgfältig zubereitet werden."
    ],
    "en": [
      "The \"Les Volcans\" restaurant offers \"home-made\" local cuisine based on fresh produce selected from local producers and suppliers and carefully prepared by the chef."
    ],
    "it": [
      "Il ristorante \"Les Volcans\" offre una cucina casalinga a base di prodotti freschi selezionati da produttori e fornitori locali e preparati con cura dallo chef."
    ],
    "fr": [
      "Le restaurant \"Les Volcans\" propose une cuisine de terroir \"faite maison\" à base de produits frais sélectionnés auprès de producteurs et fournisseurs locaux soigneusement préparés par la cheffe."
    ],
    "nl": [
      "Het restaurant \"Les Volcans\" biedt een huisgemaakte keuken op basis van verse producten geselecteerd bij lokale producenten en leveranciers en zorgvuldig bereid door de chef."
    ],
    "es": [
      "El restaurante \"Les Volcans\" ofrece una cocina casera basada en productos frescos seleccionados de los productores y proveedores locales y preparados cuidadosamente por el chef."
    ]
  },
  "rdfs:label": {
    "en": [
