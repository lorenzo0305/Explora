  "rdfs:comment": {
    "de": [
      "Die authentisch eingerichtete Kneipe lädt Sie ein, eine hausgemachte Karbonnade oder Maroillette (wie Tartiflette, aber mit heimischem Käse!) zu probieren."
    ],
    "en": [
      "The estaminet with its authentic decoration invites you to taste a good homemade carbonnade or the Maroillette (like the tartiflette but with the cheese of our country!)."
    ],
    "it": [
      "L'estaminet, arredato in modo autentico, vi invita a gustare una buona carbonnade fatta in casa o la Maroillette (come la tartiflette, ma con formaggio della nostra regione!)."
    ],
    "fr": [
      "L’estaminet à la décoration authentique vous invite à déguster une bonne carbonnade faite maison ou la Maroillette (comme la tartiflette mais avec le fromage de chez nous!)."
    ],
    "nl": [
      "Het authentiek ingerichte estaminet nodigt u uit om te genieten van een goede zelfgemaakte carbonnade of de Maroillette (zoals de tartiflette maar dan met kaas uit onze streek!)."
    ],
    "es": [
      "El estaminet, auténticamente decorado, le invita a degustar una buena carbonnade casera o la Maroillette (¡como la tartiflette pero con queso de nuestra región!)."
    ]
  },
