  "rdfs:comment": {
    "de": [
      "Eine originelle Entdeckung der Welt der Brauerei und der Region Cantalan. Eine Initiationsreise in das Herz einer Vulkanbrauerei! Begegnungen, Verkostung von Bieren und Aperitifbrettern."
    ],
    "en": [
      "Initiatory trip in this volcanic brewery. Natural and refreshing beers.\r\nShop and beer tasting: open to everyone."
    ],
    "it": [
      "Un modo originale per scoprire il mondo della birra e la regione di Cantalien. Un viaggio iniziatico nel cuore di un birrificio vulcanico! Incontri, degustazioni di birra e aperitivi."
    ],
    "fr": [
      "Une découverte originale du monde brassicole et du terroir cantalien. Voyage initiatique au cœur d'une brasserie volcanique ! Rencontres, dégustations de bières et de planches apéritives."
    ],
    "es": [
      "Una forma original de descubrir el mundo cervecero y la región cantábrica. Un viaje iniciático al corazón de una cervecería volcánica Encuentros, degustaciones de cerveza y platos de aperitivo."
    ],
    "nl": [
      "Een originele manier om de wereld van het brouwen en de Cantalien te ontdekken. Een inwijdingsreis naar het hart van een vulkanische brouwerij! Ontmoetingen, bierproeverijen en aperitiefschotels."
    ]
  },
  "rdfs:label": {
