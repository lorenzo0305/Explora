  "rdfs:comment": {
    "de": [
      "Frische Produkte, hausgemacht. Ob vor Ort, zum Mitnehmen oder als Lieferservice, bei Kajira Sushi werden die traditionellen japanischen Gerichte neu interpretiert.\r\nEntdecken Sie natürlich Sushi, aber auch andere Spezialitäten."
    ],
    "en": [
      "Fresh products, homemade. On the spot to take away or delivery, the traditional dishes of Japan are revisited at Kajira Sushi. To discover sushi of course, but also other specialties.\r\nTake advantage of online orders to gain speed:\r\nhttps://vienne.kajirosushi-commandes.com/menu"
    ],
    "it": [
      "Prodotti freschi e fatti in casa. Kajira Sushi rivisita i piatti della tradizione giapponese, da consumare in casa, da asporto o da consegnare.\r\nScoprite il sushi, naturalmente, ma anche altre specialità."
    ],
    "fr": [
      "Produits frais, fait maison. Sur place, à emporter ou en livraison, les mets traditionnels du japon sont revisités chez Kajira Sushi. \r\nÀ découvrir les sushis bien sûr, mais aussi d'autres spécialités."
    ],
    "nl": [
      "Verse, huisgemaakte producten. Kajira Sushi herleeft traditionele Japanse gerechten, om te eten, mee te nemen of te bezorgen.\r\nOntdek natuurlijk sushi, maar ook andere specialiteiten."
    ],
    "es": [
      "Productos frescos y caseros. Kajira Sushi revisita los platos tradicionales japoneses, ya sea para comer en casa, para llevar o a domicilio.\r\nDescubra el sushi, por supuesto, pero también otras especialidades."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Kajiro Sushi Vienne"
    ]
  },
