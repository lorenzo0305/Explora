  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen Moment der Entspannung in unserem Spa-Bereich und nutzen Sie unser Dampfbad, die Sauna und das Gegenstrom-Schwimmbecken mit einer Sprudelbank. Für ein umfassendes Wellness-Erlebnis können Sie auch eine Solo- oder Duo-Behandlung buchen."
    ],
    "en": [
      "Treat yourself to a moment of relaxation in our spa area and enjoy our hammam, sauna and countercurrent swimming pool equipped with a bubble bench. For a complete wellness experience, do not hesitate to book your treatment solo or duo."
    ],
    "it": [
      "Concedetevi un momento di relax nella nostra area spa e approfittate dell'hammam, della sauna e della piscina controcorrente dotata di panca per le bolle. Per un'esperienza di benessere completa, non esitate a prenotare il vostro trattamento individuale o di coppia."
    ],
    "fr": [
      "Offrez-vous un moment de relaxation dans notre espace spa et profitez de notre hammam, sauna, et bassin de nage à contrecourant équipé d'un banc à bulles. Pour une expérience de bien-être complète, n'hésitez pas à réserver votre soin en solo ou duo."
    ],
    "nl": [
      "Trakteer uzelf op een moment van ontspanning in onze spa en geniet van onze hamam, sauna en tegenstroomzwembad met bubbelbank."
    ],
    "es": [
      "Regálese un momento de relajación en nuestra zona de spa y aproveche nuestro hammam, sauna y piscina contracorriente equipada con un banco de burbujas. Para una experiencia de bienestar completa, no dude en reservar su tratamiento en solitario o en dúo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Spa - pools - sauna - hammam de l'Hôtel la Roche"
    ],
    "fr": [
      "Spa - piscine - sauna - hammam de l'Hôtel la Roche"
    ],
    "nl": [
      "Spa - zwembad - sauna - hamam in het Hôtel la Roche"
    ]
  },
