  "rdfs:comment": {
    "de": [
      "Charmantes Gasthaus in der Nähe von Issoire und Clermont-Ferrand (40 min Ausfahrt Nr. 13), am Fuße des Pic de Vodable, in einer ländlichen Umgebung mit Blick auf die Berge der Auvergne."
    ],
    "en": [
      "Charming inn near Issoire and Clermont-Ferrand (40 min exit n°13), at the foot of the Pic de Vodable, in a country setting with a view of the Auvergne mountains."
    ],
    "it": [
      "Locanda di charme vicino a Issoire e Clermont-Ferrand (40 minuti dall'uscita n°13), ai piedi della vetta del Vodable, in un ambiente rurale con vista sulle montagne dell'Alvernia."
    ],
    "fr": [
      "Charmante auberge à proximité d'Issoire et de Clermont-Ferrand (40 min sortie n°13), au pied du pic de Vodable, dans un décor champêtre avec vue sur les monts d'Auvergne."
    ],
    "es": [
      "Encantadora posada cerca de Issoire y Clermont-Ferrand (a 40 minutos de la salida n°13), al pie del pico Vodable, en un entorno rural con vistas a las montañas de Auvernia."
    ],
    "nl": [
      "Charmante herberg in de buurt van Issoire en Clermont-Ferrand (40 min van afrit n°13), aan de voet van de top van de Vodable, in een landelijke omgeving met uitzicht op de bergen van de Auvergne."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Loue Inn"
    ],
    "fr": [
      "Auberge de la Loue"
    ]
  },
