  "rdfs:comment": {
    "de": [
      "Einst eine Burg der Grafen von Genf, entdecken Sie die Überreste der Burg. Besichtigungen des Marktfleckens und der Burgruinen sind mit den Guides du Patrimoine Savoie Mont Blanc möglich."
    ],
    "en": [
      "Once the residence of the Counts of Geneva, come and discover the ruins of the castle. Tours of the village and castle ruins are available with Savoie Mont Blanc Heritage Guides."
    ],
    "it": [
      "Un tempo castello dei conti di Ginevra, venite a scoprirne i resti. Le visite alla città e alle rovine del castello sono possibili con le Guide del Patrimonio della Savoia Monte Bianco."
    ],
    "fr": [
      "Jadis châtellenie des comtes de Genève, venez découvrir les vestiges du château. Visites possibles du bourg et des ruines du château avec des Guides du Patrimoine Savoie Mont Blanc."
    ],
    "nl": [
      "Ooit het kasteel van de graven van Genève, kom en ontdek de overblijfselen van het kasteel. Rondleidingen door de stad en de kasteelruïnes zijn mogelijk met de gidsen van het Savoie Mont Blanc Heritage."
    ],
    "es": [
      "Antiguo castillo de los Condes de Ginebra, venga a descubrir los restos del castillo. Las visitas a la ciudad y a las ruinas del castillo son posibles con los Guías del Patrimonio de Saboya Mont-Blanc."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chaumont village and castle ruins"
    ],
    "fr": [
      "Bourg et ruines du château de Chaumont"
    ]
  },
