  "rdfs:comment": {
    "de": [
      "In Vallandry ist das El 56 ein traditionelles Restaurant, eine Tapas-Bar, eine Cocktailbar und eine Snackbar.\r\nGenießen Sie ein süßes Après-Ski-Erlebnis mit unseren Waffeln, süßen Croqs und French Toast oder mit einem Cocktail, Milchshake oder Smoothie, begleitet von Tapas!"
    ],
    "en": [
      "In Vallandry, El 56 is a traditional restaurant, tapas bar, cocktail bar, and snack bar.\r\nCome enjoy a sweet après-ski experience with our waffles, sweet croqs, and French toast, or with a cocktail, milkshake, or smoothie, accompanied by tapas!"
    ],
    "it": [
      "El 56 è un ristorante tradizionale, tapas bar, cocktail bar e snack bar a Vallandry.\r\nVenite a godervi un dolce doposci con i nostri waffle, croq?sucrés, brioches perdues o davanti a un cocktail, frullato o smoothie ..... accompagnato da una tapas!"
    ],
    "fr": [
      "Sur Vallandry le El 56 est restaurant traditionnel, bar à tapas, bar à cocktail & snack.\r\nVenez profiter d’un après ski sucré avec nos gaufres , croq’sucrés , brioches perdues ou autour d’un cocktail, milkshake, smoothie ..... accompagné d’une tapas !"
    ],
    "nl": [
      "El 56 is een traditioneel restaurant, tapasbar, cocktailbar en snackbar in Vallandry.\r\nKom en geniet van een zoete après-ski met onze wafels, croq?sucrés, brioches perdues of onder het genot van een cocktail, milkshake of smoothie ..... vergezeld van een tapas!"
    ],
    "es": [
      "El 56 es un restaurante tradicional, bar de tapas, coctelería y snack bar en Vallandry.\r\nVen a disfrutar de un dulce après-ski con nuestros gofres, croqœs sucrés, brioches perdues o tomando un cóctel, batido o smoothie ..... ¡acompañado de una tapa!"
    ]
  },
