  "rdfs:comment": {
    "de": [
      "Veymont Travel bietet Radtouren in den schönsten Regionen Europas an.\r\nNehmen Sie an privatisierten Radreisen mit Begleitfahrzeug teil und erleben Sie dieses Reiseerlebnis mit Ihrer Gruppe an den von Ihnen gewählten Terminen."
    ],
    "en": [
      "Veymont Travel was launched with the mission to offer the finest premium cycling tours in the most beautiful regions of Europe.\r\nBecome part of fully supported and private cycling holidays and live this travel experience with your Group at your Dates."
    ],
    "it": [
      "Veymont Travel propone viaggi in bicicletta nelle più belle regioni della Francia e dell'Europa.\r\nPartecipate a vacanze private in bicicletta con un veicolo di assistenza e godetevi questa esperienza di viaggio con il vostro gruppo nelle date che preferite."
    ],
    "fr": [
      "Veymont Travel propose des voyages à vélo dans les plus belles régions de France et d’Europe.\r\nParticipez à des séjours à vélo privatisés avec véhicule d’assistance et vivez cette expérience de voyage avec votre groupe aux dates de votre choix."
    ],
    "es": [
      "Veymont Travel ofrece viajes en bicicleta por las regiones más bellas de Francia y Europa.\r\nParticipe en vacaciones ciclistas privadas con vehículo de asistencia y disfrute de esta experiencia de viaje con su grupo en las fechas que elija."
    ],
    "nl": [
      "Veymont Travel biedt fietsreizen aan in de mooiste regio's van Europa.\r\nNeem deel aan geprivatiseerde fietsvakanties met een assistentievoertuig en geniet van deze reiservaring met uw groep op de data van uw keuze."
    ]
  },
