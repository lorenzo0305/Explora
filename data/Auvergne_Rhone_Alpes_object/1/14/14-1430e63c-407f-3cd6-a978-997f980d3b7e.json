  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3d6acaa8-8ef4-3c36-a6d5-fce6b6bc9d94",
      "dc:description": {
        "de": [
          "Alle auf dem Schlitten! Die Orgelklasse, die Chöre und Instrumentalensembles des Konservatoriums laden Sie zu einem fröhlichen Ausflug zu traditionellen Weihnachtsliedern, Bach-Chorälen und anderen saisonalen Leckereien ein. Kommen Sie zahlreich!"
        ],
        "en": [
          "Everyone in a sleigh! The organ class, the choirs and instrumental ensembles of the conservatory invite you to a joyful escapade between traditional carols, Bach chorales and other seasonal delicacies. Come one and all!"
        ],
        "it": [
          "Tutti in slitta! La classe di organo, i cori e gli ensemble strumentali del conservatorio vi invitano a una gioiosa evasione tra canti tradizionali, corali di Bach e altre prelibatezze stagionali. Venite uno, venite tutti!"
        ],
        "fr": [
          "Tous en traineau ! La classe d’orgue, les chorales et ensembles instrumentaux du conservatoire vous convient à une joyeuse escapade entre noëls traditionnels, chorals de Bach et autres gourmandises de saison. Venez nombreux !"
        ],
        "es": [
          "¡Todos en un trineo! La clase de órgano, los coros y los conjuntos instrumentales del conservatorio le invitan a una alegre escapada entre villancicos tradicionales, corales de Bach y otras delicias estacionales. ¡Vengan uno, vengan todos!"
        ],
        "nl": [
          "Iedereen in een slee! De orgelklas, de koren en instrumentale ensembles van het conservatorium nodigen u uit voor een vrolijke escapade tussen traditionele kerstliederen, koralen van Bach en andere seizoensgebonden lekkernijen. Kom een, kom allen!"
        ]
      },
