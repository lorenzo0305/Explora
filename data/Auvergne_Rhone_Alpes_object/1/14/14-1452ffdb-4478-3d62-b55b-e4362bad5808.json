  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aa895808-115f-3bb7-af9b-6285f60d8e82",
      "dc:description": {
        "de": [
          "Agentur für die Vermietung von Pkw und Nutzfahrzeugen.\nGeöffnet montags bis freitags von 8 bis 12 Uhr und von 14 bis 18.30 Uhr, samstags von 9 bis 12 Uhr und von 16 bis 18 Uhr\nPick-up-Service am Bahnhof an den Tagen und zu den Zeiten, an denen die Agentur geöffnet ist, außer samstags"
        ],
        "en": [
          "Rental agency for passenger and commercial vehicles.\nOpen Monday to Friday 8am to 12pm and 2pm to 6:30pm, Saturday 9am to 12pm and 4pm to 6pm\nPick-up service at the station on branch opening days and times, except Saturday"
        ],
        "it": [
          "Agenzia di noleggio di autovetture e veicoli commerciali leggeri.\nAperta dal lunedì al venerdì, dalle 8.00 alle 12.00 e dalle 14.00 alle 18.30, il sabato dalle 9.00 alle 12.00 e dalle 16.00 alle 18.00\nServizio di ritiro alla stazione durante gli orari di apertura, tranne il sabato"
        ],
        "fr": [
          "Agence de location de véhicules tourisme et utilitaires.\nOuvert du lundi au vendredi de 8h à 12h et de 14h à 18h30, le samedi de 9h à 12h et de 16h à 18h\nService pick up en gare aux jours et horaires d'ouverture de l'agence sauf le samedi"
        ],
        "nl": [
          "Verhuurbedrijf van personenauto's en lichte bedrijfswagens.\nGeopend van maandag tot vrijdag van 8.00 tot 12.00 uur en van 14.00 tot 18.30 uur, op zaterdag van 9.00 tot 12.00 uur en van 16.00 tot 18.00 uur\nPick-up service bij het station tijdens openingstijden, behalve op zaterdag"
        ],
        "es": [
          "Agencia de alquiler de turismos y vehículos comerciales ligeros.\nAbierto de lunes a viernes, de 8.00 a 12.00 h. y de 14.00 a 18.30 h., sábados de 9.00 a 12.00 h. y de 16.00 a 18.00 h\nServicio de recogida en la estación durante las horas de apertura, excepto los sábados"
        ]
      },
