  "rdfs:comment": {
    "de": [
      "Der Geschmack von Raffinesse, eine großzügige und fantasievolle Küche. Der Chefkoch lädt Feinschmecker ein, delikates Fleisch, raffinierten Fisch und vegetarische Gerichte zu genießen, ohne dabei die Savoyer Spezialitäten auf der Grundlage von Beaufort, dem Juwel der lokalen Gastronomie, zu vergessen."
    ],
    "en": [
      "The taste of refinement, a generous and imaginative cuisine. The chef invites gourmets to savor delicate meats, refined fish and vegetarian dishes without forgetting the Savoyard specialties based on Beaufort cheese, a jewel of local gastronomy."
    ],
    "it": [
      "Un gusto per la raffinatezza, una cucina generosa e fantasiosa. Lo chef invita i buongustai a gustare carni delicate, pesce raffinato e piatti vegetariani, senza dimenticare le specialità savoiarde a base di formaggio Beaufort, fiore all'occhiello della gastronomia locale."
    ],
    "fr": [
      "Le goût du raffinement, une cuisine généreuse et imaginative. Le chef invite les gourmets à savourer viandes délicates, poissons raffinés et plats végétariens sans oublier les spécialités savoyardes à base de Beaufort, joyau de la gastronomie locale."
    ],
    "es": [
      "Gusto por el refinamiento, cocina generosa e imaginativa. El chef invita a los gourmets a saborear carnes delicadas, pescados refinados y platos vegetarianos, sin olvidar las especialidades saboyanas a base de queso de Beaufort, la joya de la corona de la gastronomía local."
    ],
    "nl": [
      "De smaak van verfijning, een genereuze en fantasierijke keuken. De chef-kok nodigt fijnproevers uit om te genieten van delicaat vlees, verfijnde vis en vegetarische gerechten zonder de Savoyaardse specialiteiten op basis van Beaufort, een juweel van lokale gastronomie, te vergeten."
    ]
  },
  "rdfs:label": {
    "en": [
      "1947 Restaurant"
    ],
    "fr": [
      "Restaurant Le 1947"
    ],
    "nl": [
      "Restaurant The 1947"
    ]
  },
