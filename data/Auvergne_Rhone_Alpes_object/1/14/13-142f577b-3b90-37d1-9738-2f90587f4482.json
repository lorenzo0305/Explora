  "rdfs:comment": {
    "de": [
      "Ziel des Vereins ist es, die Altstadt von Nyons für bessere Lebensbedingungen und zur Förderung von Handel und Tourismus aufzuwerten."
    ],
    "en": [
      "The Association's goal is to promote the \"vieux Nyons\" (the ancient part of the city), in a commercial and tourist way."
    ],
    "it": [
      "L'obiettivo dell'Associazione è quello di valorizzare l'antica Nyons per migliorare le condizioni di vita e per la promozione commerciale e turistica."
    ],
    "fr": [
      "L'Association a pour but de valoriser du vieux Nyons pour de meilleures conditions de vie et pour une promotion commerciale et touristique."
    ],
    "nl": [
      "Het doel van de vereniging is om de oude stad Nyons op te waarderen om de leefomstandigheden te verbeteren en handel en toerisme te bevorderen."
    ],
    "es": [
      "El objetivo de la Asociación es revalorizar la antigua Nyons para mejorar las condiciones de vida y para la promoción comercial y turística."
    ]
  },
  "rdfs:label": {
    "en": [
