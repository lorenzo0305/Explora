  "rdfs:comment": {
    "de": [
      "Unterricht in allen Gleitsportarten :\r\nIm Winter: Alpiner Skilauf, Nordischer Skilauf (klassisch und Skating), Nordischer Tourenskilauf, Snowboard, Biathlon, Telemark.\r\nIm Sommer: Rollski und Biathlon."
    ],
    "en": [
      "All skiing disciplines taught : alpine ski, crosscountry ski, snowboard, biathlon,  telemark,"
    ],
    "it": [
      "Insegnamento di tutte le discipline sportive invernali:\r\nInverno: sci alpino, sci nordico (classico e skating), sci alpinismo nordico, snowboard, biathlon, telemark.\r\nEstate: sci a rotelle e biathlon."
    ],
    "fr": [
      "Enseignement de toutes les disciplines de glisse :\r\nL'hiver : ski alpin, ski nordique (classique et skating), ski de randonnée nordique, snowboard, biathlon, télémark.\r\nL'été : ski à roulettes et biathlon."
    ],
    "nl": [
      "Les in alle sneeuwsporten: skiën, tourskiën, snowboaren, biathlon, telemarken, wandelingen"
    ],
    "es": [
      "Enseñanza de todas las disciplinas de deportes de invierno:\r\nInvierno: esquí alpino, esquí nórdico (clásico y patinaje), esquí nórdico de travesía, snowboard, biatlón, esquí de telemark.\r\nVerano: esquí sobre patines y biatlón."
    ]
  },
