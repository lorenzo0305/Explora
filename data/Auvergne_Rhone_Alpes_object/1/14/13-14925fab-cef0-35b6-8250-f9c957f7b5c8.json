  "rdfs:comment": {
    "de": [
      "Das Vivarais ist ein als \"Art et Essai\" eingestuftes Kino mit drei digital ausgestatteten Sälen.\r\nVorführungen im Saal das ganze Jahr über. 3D aktiv. Zugang für Menschen mit Behinderungen.\r\nDas Programm des Kinos ist im Fremdenverkehrsamt und in vielen Geschäften in Privas erhältlich."
    ],
    "en": [
      "Le Vivarais is an \"Art et Essai\" cinema with 3 digital screens.\r\nYear-round screenings. active 3D. Disabled access.\r\nThe cinema's program is available at the Tourist Office and in many shops in Privas."
    ],
    "it": [
      "Le Vivarais è un cinema \"Art et Essai\", con 3 sale dotate di tecnologia digitale.\r\nProiezioni tutto l'anno. 3D attivo. Accesso per i disabili.\r\nIl programma del cinema è disponibile presso l'Ufficio del Turismo e in molti negozi di Privas."
    ],
    "fr": [
      "Le Vivarais est un cinéma classé \"Art et Essai\", disposant de 3 salles équipées en numérique. \r\nSéances en salle toute l'année. 3D active. Accès handicapés.\r\nProgrammation du cinéma disponible à l'Office de Tourisme et dans de nombreux commerces de Privas."
    ],
    "nl": [
      "Le Vivarais is een \"Art et Essai\" bioscoop, met 3 zalen uitgerust met digitale technologie.\r\nVertoningen het hele jaar door. actieve 3D. Toegankelijk voor gehandicapten.\r\nHet programma van de bioscoop is verkrijgbaar bij het VVV-kantoor en in veel winkels in Privas."
    ],
    "es": [
      "Le Vivarais es un cine \"Art et Essai\", con 3 salas equipadas con tecnología digital.\r\nProyecciones todo el año. 3D activo. Acceso para minusválidos.\r\nLa programación del cine está disponible en la Oficina de Turismo y en numerosos comercios de Privas."
    ]
  },
