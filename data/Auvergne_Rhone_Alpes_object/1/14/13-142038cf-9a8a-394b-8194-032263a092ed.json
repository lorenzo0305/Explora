  "rdfs:comment": {
    "de": [
      "Das Ökoquartier Daudet ist eine Antwort auf eine Vielzahl von städtebaulichen, ökologischen und sozialen Herausforderungen. Es steht daher voll und ganz im Zeichen einer nachhaltigen Entwicklung"
    ],
    "en": [
      "The Daudet eco-neighborhood meets a number of urban, environmental and social challenges. It is therefore fully in line with the principles of sustainable development."
    ],
    "it": [
      "L'ecodistretto Daudet risponde a molteplici sfide urbane, ambientali e sociali. È quindi pienamente in linea con un approccio di sviluppo sostenibile"
    ],
    "fr": [
      "L'écoquartier  Daudet  répond à de multiples enjeux à la fois urbains, environnementaux et sociaux. Il s'inscrit donc pleinement dans une logique de développement durable"
    ],
    "es": [
      "El ecobarrio de Daudet responde a una serie de retos urbanos, medioambientales y sociales. Por tanto, se ajusta plenamente a los principios del desarrollo sostenible."
    ],
    "nl": [
      "De ecowijk Daudet beantwoordt aan meerdere stedelijke, ecologische en sociale uitdagingen. Het is daarom volledig in overeenstemming met een benadering van duurzame ontwikkeling"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'écoquartier Daudet"
    ]
  },
