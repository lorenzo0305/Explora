  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2aa9c64e-2352-342f-9386-f74a861c976b",
      "dc:description": {
        "de": [
          "Erleben Sie die Aufführung Tout in haut de ch?terril, eine einzigartige Reise durch die Geschichte der Region Nord-Pas-de-Calais mit Hilfe von Patois-Liedern.\n\nEin Jongleur und Feuerspucker wird den Ball eröffnen."
        ],
        "en": [
          "Come and see Tout in haut de ch?terril, a unique journey through the history of Nord-Pas-de-Calais through patois songs.\n\nA fire-eating juggler will open the show."
        ],
        "it": [
          "Venite a vedere lo spettacolo Tout in haut de ch?terril, un viaggio unico nella storia della regione Nord-Pas-de-Calais con canzoni patois.\n\nUn giocoliere mangiafuoco aprirà lo spettacolo."
        ],
        "fr": [
          "Venez assister au spectacle Tout in haut de ch’terril, un voyage unique dans l’histoire du Nord-Pas-de-Calais à travers des chansons patoisantes.\n\nUn jongleur-cracheur de feu ouvrira le bal."
        ],
        "es": [
          "Venga a ver el espectáculo Tout in haut de ch?terril, un recorrido único por la historia de la región Nord-Pas-de-Calais a través de canciones en patois.\n\nUn malabarista tragafuegos abrirá el espectáculo."
        ],
        "nl": [
          "Kom kijken naar de voorstelling Tout in haut de ch?terril, een unieke reis door de geschiedenis van de regio Nord-Pas-de-Calais aan de hand van patoisliederen.\n\nDe show wordt geopend door een vuurspuwende jongleur."
        ]
      },
