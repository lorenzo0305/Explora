  "rdfs:comment": {
    "de": [
      "Willkommen in der snackbar des Campingplatzes Étang Philippe, die im Sommer geöffnet ist!"
    ],
    "en": [
      "Welcome to the snack bar at the Étang Philippe campsite, open in summer!"
    ],
    "it": [
      "Benvenuti allo snack bar del campeggio Étang Philippe, aperto in estate! Venite a gustare e ad assaggiare. Sul posto o da asporto. Lo snack bar è disponibile SU PRENOTAZIONE."
    ],
    "fr": [
      "Bienvenue au bar snack du camping de l'Étang Philippe, ouvert en été! Venez profiter et déguster. Sur place ou à emporter. Le snack est proposé SUR RÉSERVATION."
    ],
    "nl": [
      "Welkom bij de snackbar van camping Étang Philippe, geopend in de zomer! Kom genieten en proeven. Ter plaatse of om mee te nemen. De snackbar is op reservering beschikbaar."
    ],
    "es": [
      "Bienvenido al snack bar del camping Étang Philippe, ¡abierto en verano! Venga a disfrutar y degustar. In situ o para llevar. El snack bar está disponible BAJO RESERVA."
    ]
  },
