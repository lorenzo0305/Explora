  "rdfs:comment": {
    "de": [
      "Eine monumentale Kirche, sowohl aufgrund ihrer Größe als auch aufgrund ihrer Geschichte! Ihre reiche Innendekoration in Trompe l'oeil, die typisch für den neoklassischen Stil ist, ist bemerkenswert."
    ],
    "en": [
      "A monumental church by its size but also by its history !"
    ],
    "it": [
      "Una chiesa monumentale sia per le sue dimensioni che per la sua storia! Notevole è la sua ricca decorazione interna a trompe l'oeil, tipica dello stile neoclassico."
    ],
    "fr": [
      "Une église monumentale tant par ses dimensions que par son histoire ! Son riche décor intérieur en trompe l'oeil, typique du style néo-classique est remarquable."
    ],
    "es": [
      "Una iglesia monumental tanto por su tamaño como por su historia Destaca su rica decoración interior en trampantojo, típica del estilo neoclásico."
    ],
    "nl": [
      "Een monumentale kerk, zowel qua grootte als qua geschiedenis! De rijke trompe l'oeil interieurdecoratie, typisch voor de neoklassieke stijl, is opmerkelijk."
    ]
  },
