  "rdfs:comment": {
    "de": [
      "Anne-Sophie Segelle hat im Juni 2019 eine Gemüsefarm im Dorf gegründet, um Ihnen saisonales Gemüse und Obst aus biologischem Anbau anzubieten."
    ],
    "en": [
      "Since June 2019, Anne-Sophie Segelle has created a market garden in the village to offer you seasonal vegetables and fruits from organic farming."
    ],
    "it": [
      "Da giugno 2019, Anne-Sophie Segelle ha allestito un orto nel villaggio per offrirvi verdure e frutta di stagione provenienti da agricoltura biologica."
    ],
    "fr": [
      "Installée depuis le mois de Juin 2019 Anne-Sophie Segelle a créée une ferme maraichère sur le village pour vousproposer des légumes et fruits de saison issus de l 'agriculture biologique."
    ],
    "nl": [
      "Sinds juni 2019 heeft Anne-Sophie Segelle in het dorp een tuinderij ingericht om u seizoensgroenten en -fruit uit de biologische landbouw aan te bieden."
    ],
    "es": [
      "Desde junio de 2019, Anne-Sophie Segelle ha instalado un huerto en el pueblo para ofrecerle verduras y frutas de temporada procedentes de la agricultura ecológica."
    ]
  },
