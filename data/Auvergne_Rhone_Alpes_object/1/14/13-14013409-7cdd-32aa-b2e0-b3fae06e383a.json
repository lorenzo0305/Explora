  "rdfs:comment": {
    "de": [
      "Das Schloss ist nur für private Veranstaltungen geöffnet.\r\nIhre Gäste im Château de Beaulon zu empfangen, ist die beste Kombination aus Charme, Tradition, Qualität, Erfahrung und Sicherheit. Seien Sie herzlich willkommen!"
    ],
    "en": [
      "Château only open for private events.\r\nHosting your guests at Château de Beaulon is a winning combination of charm, tradition, quality, experience and security. We look forward to welcoming you!"
    ],
    "it": [
      "Castello aperto solo per eventi privati.\r\nAccogliere i vostri ospiti allo Château de Beaulon è una combinazione vincente di fascino, tradizione, qualità, esperienza e sicurezza. Non vediamo l'ora di accogliervi!"
    ],
    "fr": [
      "Château uniquement ouvert lors d'évènements privés.\r\nAccueillir vos invités au Château de Beaulon c'est la combinaison gagnante de charme, de tradition, de qualité, d'expériences, et de sécurité. Soyez les bienvenus !"
    ],
    "es": [
      "El castillo sólo está abierto para eventos privados.\r\nRecibir a sus invitados en el Château de Beaulon es una combinación ganadora de encanto, tradición, calidad, experiencia y seguridad. Estaremos encantados de recibirle"
    ],
    "nl": [
      "Château alleen open voor privé-evenementen.\r\nUw gasten ontvangen op Château de Beaulon is een winnende combinatie van charme, traditie, kwaliteit, ervaring en veiligheid. We kijken ernaar uit u te verwelkomen!"
    ]
  },
