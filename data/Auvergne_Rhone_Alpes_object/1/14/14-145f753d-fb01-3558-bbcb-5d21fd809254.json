      "dc:description": {
        "de": [
          "Festival Ticket Africa in der Salle de la Faïencerie in Boulogne-sur-Mer! am Samstag, den 22. Februar\n? Konzerte mit afrikanischer Musik: Reggae, Blues, Rock, Afrobeat\nAb 19 Uhr - Reservieren Sie Ihre Plätze?"
        ],
        "en": [
          "Ticket Africa Festival at the Salle de la Faïencerie in Boulogne-sur-Mer! Saturday, February 22\n? African music concerts: Reggae, Blues, Rock, Afrobeat\nStarting at 7pm - Reserve your seats ?"
        ],
        "it": [
          "Ticket Africa Festival alla Salle de la Faïencerie di Boulogne-sur-Mer! Sabato 22 febbraio\n? Concerti di musica africana: Reggae, Blues, Rock, Afrobeat\nDalle 19:00 - Prenotate i vostri biglietti?"
        ],
        "fr": [
          "Festival Ticket Africa à la salle de la Faïencerie à Boulogne-sur-Mer ! le samedi 22 février\n➡ Concerts musiques africaines : Reggae, Blues, rock, afrobeat\nDès 19h - Réservez vos places 😉"
        ],
        "nl": [
          "Ticket Africa Festival in de Salle de la Faïencerie in Boulogne-sur-Mer! Zaterdag 22 februari\n? Afrikaanse muziekconcerten: Reggae, Blues, Rock, Afrobeat\nVanaf 19u - Reserveer uw tickets ?"
        ],
        "es": [
          "Ticket Africa Festival en la Sala de la Faïencerie de Boulogne-sur-Mer, sábado 22 de febrero\n? Conciertos de música africana: Reggae, Blues, Rock, Afrobeat\nA partir de las 19.00 h - Reserve sus entradas ?"
        ]
      },
