  "rdfs:comment": {
    "de": [
      "Ausgestattet mit Ihrem im Maison d'Aussois abgeholten Reisetagebuch und Ihrem Smartphone machen Sie sich auf die Suche nach versteckten Hinweisen im Dorf, um Jean-Lou Damevin zu helfen, sein Gedächtnis wiederzuerlangen."
    ],
    "en": [
      "Armed with your logbook from the Maison d'Aussois and your smartphone, set off to find clues hidden around the village to help Jean-Lou Damevin recover his memory."
    ],
    "it": [
      "Armati della vostra guida, ritirata dalla Maison d'Aussois, e del vostro smartphone, partite alla ricerca di indizi nascosti nel villaggio per aiutare Jean-Lou Damevin a recuperare la memoria."
    ],
    "fr": [
      "Munis de votre carnet de route retiré à la Maison d'Aussois et de votre smartphone, partez à la recherche d'indices cachés dans le village pour aider Jean-Lou Damevin à retrouver la mémoire."
    ],
    "nl": [
      "Gewapend met je gids, opgehaald in het Maison d'Aussois, en je smartphone ga je op zoek naar aanwijzingen die in het dorp verstopt zijn om Jean-Lou Damevin te helpen zijn geheugen terug te krijgen."
    ],
    "es": [
      "Armado con su guía, recogida en la Maison d'Aussois, y su smartphone, salga en busca de pistas escondidas por el pueblo para ayudar a Jean-Lou Damevin a recuperar la memoria."
    ]
  },
  "rdfs:label": {
    "en": [
      "Interactive treasure hunt: ma belle aussoyenne"
    ],
    "fr": [
      "Jeu de piste interactif : ma belle aussoyenne"
    ],
    "nl": [
      "Interactieve schattenjacht: ma belle aussoyenne"
    ]
  },
