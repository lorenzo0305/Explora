  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einem neuartigen Spiel zwischen Escape Game und interaktiver Ermittlung in den Straßen von Le Puy-en-Velay teil und erleben Sie ein ungewöhnliches Team-Abenteuer im Herzen der Haute-Loire!"
    ],
    "en": [
      "Take part in a unique escape game and interactive investigation in the streets of Le Puy-en-Velay, and experience an unusual team adventure in the heart of the Haute-Loire region!"
    ],
    "it": [
      "Partecipate a un gioco originale che combina un gioco di fuga e un'indagine interattiva nelle strade di Le Puy-en-Velay e vivete un'insolita avventura di squadra proprio nel cuore della regione dell'Alta Loira!"
    ],
    "fr": [
      "Prenez part à un jeu inédit entre escape game et enquête interactive dans les rues du Puy-en-Velay, et vivez une aventure insolite en équipe en plein cœur de la Haute-Loire !"
    ],
    "es": [
      "Participe en un juego original que combina un juego de escape y una investigación interactiva en las calles de Le Puy-en-Velay, ¡y viva una insólita aventura en equipo en pleno corazón de la región del Alto Loira!"
    ],
    "nl": [
      "Doe mee aan een origineel spel dat een ontsnappingsspel combineert met een interactief onderzoek in de straten van Le Puy-en-Velay, en beleef een ongewoon teamavontuur in het hart van de Haute-Loire!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape en Velay - ''Les clés volées des murailles''"
    ]
  },
