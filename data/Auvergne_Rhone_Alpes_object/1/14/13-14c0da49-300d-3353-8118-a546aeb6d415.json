  "rdfs:comment": {
    "de": [
      "Durchqueren Sie den Wald von Les Colettes dank einer originellen Formel,\r\nder \"Rando-Train\": Hin mit dem Zug, zurück zu Fuß (oder umgekehrt)! Entdecken Sie das malerische Tal zwischen Louroux-de-Bouble und Coutansouze und die Viadukte von Belon und La Perrière."
    ],
    "en": [
      "An original way to cross the Colettes forest,\r\nthe \"rando-train\": go by train, return on foot (or vice versa)! Discover the picturesque valley between Louroux-de-Bouble and Coutansouze, and the Belon and Perrière viaducts."
    ],
    "it": [
      "Un modo originale per attraversare la foresta di Colettes,\r\nil \"rando-train\": andata in treno, ritorno a piedi (o viceversa)! Scoprite la pittoresca valle tra Louroux-de-Bouble e Coutansouze e i viadotti di Belon e Perrière."
    ],
    "fr": [
      "Traverser la forêt des Colettes grâce à une formule originale,\r\nla « rando-train » : aller en train, retour à pied (ou l'inverse) ! Découvrez la vallée pittoresque entre Louroux-de-Bouble et Coutansouze et les viaducs du Belon et de la Perrière."
    ],
    "es": [
      "Una forma original de atravesar el bosque de Colettes,\r\nel \"rando-tren\": ¡ir en tren, volver a pie (o viceversa)! Descubra el pintoresco valle entre Louroux-de-Bouble y Coutansouze y los viaductos de Belon y Perrière."
    ],
    "nl": [
      "Een originele manier om het bos van Colettes te doorkruisen,\r\nde \"rando-trein\": ga met de trein, keer te voet terug (of omgekeerd)! Ontdek de schilderachtige vallei tussen Louroux-de-Bouble en Coutansouze en de viaducten van Belon en Perrière."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rando-Train Les Viaducs des Colettes"
    ]
  },
