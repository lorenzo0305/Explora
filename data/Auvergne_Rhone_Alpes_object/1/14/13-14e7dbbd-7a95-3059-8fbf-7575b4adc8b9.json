  "rdfs:comment": {
    "de": [
      "Im Rahmen des Festivals für elektronische Musik Romanesque.\r\nDie Locaux Rock ?uvrieren seit Jahren für die Entwicklung der aktuellen Musik in der Region und bauen auf dem Unterricht am Konservatorium auf:"
    ],
    "en": [
      "As part of the Romanesque electronic music festival.\r\nLes Locaux Rock has been working for years to develop contemporary music in the region, as an extension of the teaching offered at the Conservatory:"
    ],
    "it": [
      "Nell'ambito del festival di musica elettronica Romanesque.\r\nLes Locaux Rock lavora da anni per sviluppare la musica contemporanea nella regione come estensione dell'insegnamento offerto dal Conservatorio:"
    ],
    "fr": [
      "Dans le cadre du Festival de musiques électroniques Romanesque.\r\nLes Locaux Rock œuvrent depuis des années au développement des musiques actuelles sur le territoire dans le prolongement de l’enseignement proposé au Conservatoire :"
    ],
    "nl": [
      "In het kader van het festival voor elektronische muziek Romanesque.\r\nLes Locaux Rock werkt al jaren aan de ontwikkeling van hedendaagse muziek in de regio als verlengstuk van het onderwijs aan het Conservatorium:"
    ],
    "es": [
      "En el marco del festival de música electrónica Romanesque.\r\nLes Locaux Rock trabaja desde hace años en el desarrollo de la música contemporánea en la región como prolongación de la enseñanza impartida en el Conservatorio:"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Open Air Dj"
    ]
  },
