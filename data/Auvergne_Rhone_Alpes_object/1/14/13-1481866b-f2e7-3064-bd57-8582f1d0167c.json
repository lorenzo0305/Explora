  "rdfs:comment": {
    "de": [
      "3 Kunstrasenplatz von denen 2 abends beleuchtet.\r\nTennisschläger können beim Vereinsservice oder im Sommer beim Minigolf-Chalet ausgeliehen werden."
    ],
    "en": [
      "3 courts in synthetic turf, 2 of which are lit at night.\r\nTennis rackets can be hired from the Vie associative service or from the mini golf chalet in summer."
    ],
    "it": [
      "3 campi in erba artificiale, di cui 2 illuminati di notte.\r\nLe racchette possono essere noleggiate presso il Dipartimento della vita comunitaria o presso lo chalet del minigolf in estate."
    ],
    "fr": [
      "3 courts en gazon synthétique dont 2 éclairés le soir.\r\nPossibilité de location de raquettes au service Vie Associative ou au chalet du mini-golf l'été."
    ],
    "es": [
      "3 pistas de césped artificial, 2 de ellas iluminadas por la noche.\r\nSe pueden alquilar raquetas en el Departamento de Vida Comunitaria o en el chalet de minigolf en verano."
    ],
    "nl": [
      "3 kunstgrasbanen, waarvan er 2 's avonds verlicht zijn.\r\nRackets kunnen worden gehuurd bij de afdeling Community Life of bij de minigolfchalet in de zomer."
    ]
  },
