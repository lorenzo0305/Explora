  "rdfs:comment": {
    "de": [
      "Eine recht einfache Gravel-Strecke durch die Landschaft bis zum Kanal von Roanne nach Digoin. Machen Sie einen Halt an der Gravière aux OIseaux, einem sensiblen Naturraum in Roannais."
    ],
    "en": [
      "A fairly easy gravel route through the countryside to the Roanne-Digoin canal. Stop off at the Gravière aux OIseaux, a sensitive natural area in Roanne."
    ],
    "it": [
      "Un percorso sterrato abbastanza facile attraverso la campagna fino al canale Roanne-Digoin. Sosta alla Gravière aux OIseaux, un'area naturale sensibile a Roanne."
    ],
    "fr": [
      "Un parcours gravel assez facile à travers la campagne jusqu'au canal de Roanne à Digoin. Faîtes une halte à la Gravière aux OIseaux, Espace Naturel sensible roannais."
    ],
    "es": [
      "Ruta de grava bastante fácil por el campo hasta el canal Roanne-Digoin. Parada en la Gravière aux OIseaux, zona natural sensible de Roanne."
    ],
    "nl": [
      "Een vrij gemakkelijke grindroute door het platteland naar het kanaal Roanne-Digoin. Stop bij de Gravière aux OIseaux, een kwetsbaar natuurgebied in Roanne."
    ]
  },
  "rdfs:label": {
