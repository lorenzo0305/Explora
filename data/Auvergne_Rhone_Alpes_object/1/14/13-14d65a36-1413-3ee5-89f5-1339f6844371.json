  "rdfs:comment": {
    "de": [
      "Herstellung von Joghurt, Cremedesserts, Quark"
    ],
    "en": [
      "Production of yoghurts, cream desserts and fromage blanc."
    ],
    "it": [
      "La fabbrica di yogurt si trova a poche centinaia di metri dal nostro allevamento. Il latte viene trasportato in una paletta, dove viene trasformato in yogurt, creme da dessert, formaggio cagliato e budino di riso."
    ],
    "fr": [
      "La yaourterie se situe à quelques centaines de mètres de notre bâtiment d'élevage. Le lait y est acheminé dans une boule à lait, afin d'y être transformé en yaourts, crèmes dessert, fromage blanc battu et riz au lait."
    ],
    "es": [
      "La fábrica de yogures se encuentra a unos cientos de metros de nuestro edificio ganadero. La leche se transporta hasta allí en un cacito lechero, donde se transforma en yogures, cremas para postres, requesón y arroz con leche."
    ],
    "nl": [
      "De yoghurtfabriek ligt een paar honderd meter van ons veestal. De melk wordt erheen vervoerd in een melkschep, waar het wordt verwerkt tot yoghurt, dessertroom, kwark en rijstepap."
    ]
  },
