  "rdfs:comment": {
    "de": [
      "Ambonil, ein kleines Dorf in der Ebene auf halbem Weg zwischen den Flüssen Drôme und Rhône, bezaubert sofort durch seine Authentizität und seine friedliche Atmosphäre und ist ideal gelegen, um von den Vorteilen der Region zu profitieren."
    ],
    "en": [
      "Ambonil, a small village on the plains halfway between the Drôme and Rhône rivers, immediately charms with its authenticity and peaceful atmosphere, ideally located to take advantage of the region's assets."
    ],
    "it": [
      "Ambonil, un piccolo villaggio di pianura a metà strada tra il fiume Drôme e il Rodano, affascina subito con la sua autenticità e la sua atmosfera tranquilla, in una posizione ideale per approfittare di tutto ciò che la regione ha da offrire."
    ],
    "fr": [
      "Petit village de plaine à mi-chemin entre la rivière Drôme et le Rhône, Ambonil, charme immédiatement par son authenticité et son atmosphère paisible, idéalement situé pour profiter des atouts du territoire."
    ],
    "es": [
      "Ambonil, pequeño pueblo de llanura a medio camino entre el río Drôme y el Ródano, seduce inmediatamente por su autenticidad y su ambiente tranquilo, idealmente situado para aprovechar todo lo que ofrece la región."
    ],
    "nl": [
      "Ambonil, een klein dorpje op de vlakte halverwege de rivier de Drôme en de Rhône, charmeert onmiddellijk met zijn authenticiteit en rustige sfeer, ideaal gelegen om te profiteren van alles wat de regio te bieden heeft."
    ]
  },
