  "rdfs:comment": {
    "de": [
      "Ausstellung von Aurélien Flavier. Anlässlich der Gedenkfeiern zum 8. Mai 1945 entdecken Sie eine Ausstellung mit Fotos und Modellen aus kleinen Bausteinen, die ebenso einzigartig wie originell ist!"
    ],
    "en": [
      "Exhibition by Aurélien Flavier. To mark the commemoration of May 8, 1945, come and discover a unique and original exhibition of photos and models made of small building bricks!"
    ],
    "it": [
      "Mostra di Aurélien Flavier. In occasione della commemorazione dell'8 maggio 1945, venite a scoprire una mostra di foto e modelli realizzati con piccoli mattoni da costruzione, tanto unici quanto originali!"
    ],
    "fr": [
      "Exposition d'Aurélien Flavier. À l’occasion des commémorations du 8 mai 1945, venez découvrir une exposition de photos et de maquettes en petites briques de construction aussi unique qu’originale !"
    ],
    "nl": [
      "Tentoonstelling door Aurélien Flavier. Kom ter gelegenheid van de herdenking van 8 mei 1945 een tentoonstelling ontdekken van foto's en maquettes gemaakt van kleine bouwsteentjes, even uniek als origineel!"
    ],
    "es": [
      "Exposición de Aurélien Flavier. Con motivo de la conmemoración del 8 de mayo de 1945, venga a descubrir una exposición de fotos y maquetas realizadas con pequeños ladrillos de construcción, ¡tan únicas como originales!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Guerre & Paix, regards en petites briques sur l'histoire"
    ]
  },
