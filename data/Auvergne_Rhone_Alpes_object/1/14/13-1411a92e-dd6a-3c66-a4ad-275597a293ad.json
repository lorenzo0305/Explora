  "rdfs:comment": {
    "de": [
      "Genießen Sie unsere hausgemachten Burger, die mit frischen Zutaten aus der Region zubereitet werden. Die Aromen wecken Ihren Gaumen mit jedem Bissen.\r\nZum Mitnehmen oder vor Ort: Lassen Sie es sich schmecken!"
    ],
    "en": [
      "Enjoy our homemade burgers, prepared with fresh, local ingredients. Flavors that awaken your taste buds with every bite.\r\nTo go or on site: treat yourself!"
    ],
    "it": [
      "Godetevi i nostri hamburger fatti in casa, preparati con ingredienti freschi e locali. Sapori che stuzzicheranno le vostre papille gustative a ogni morso.\r\nDa asporto o da consumare in casa: concedetevi un momento di relax!"
    ],
    "fr": [
      "Savourez nos burgers maison, préparés avec des ingrédients frais et locaux. Des saveurs qui réveillent vos papilles, à chaque bouchée. \r\nÀ emporter ou sur place: faites-vous plaisir !"
    ],
    "nl": [
      "Geniet van onze huisgemaakte hamburgers, bereid met verse, lokale ingrediënten. Smaken die je smaakpapillen bij elke hap zullen prikkelen.\r\nAfhalen of thuis eten: trakteer jezelf!"
    ],
    "es": [
      "Disfrute de nuestras hamburguesas caseras, preparadas con ingredientes frescos y locales. Sabores que deleitarán su paladar a cada bocado.\r\nPara llevar o para comer en casa: ¡dese un capricho!"
    ]
  },
