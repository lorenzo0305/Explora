  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Das Gebäude im romanischen Stil befindet sich 100 m unterhalb der Gemeindewaage, dem Standort der ursprünglichen romanischen Kirche, die 1768 von Abbé Monet als zu klein und zu baufällig eingestuft wurde."
    ],
    "en": [
      "Free visit with document. The Romanesque style building is 100 m below the communal scale, the site of the primitive Romanesque church considered too small and dilapidated by Abbot Monet in 1768."
    ],
    "it": [
      "Visita autoguidata con documentazione. L'edificio romanico si trova 100 m sotto la pesa comunale, nel luogo in cui sorgeva la chiesa romanica originaria, giudicata troppo piccola e fatiscente dall'abate Monet nel 1768."
    ],
    "fr": [
      "Visite libre avec document. L'édifice de style roman est à 100 m en contrebas de la bascule communale, emplacement de l'église romane primitive jugée trop petite et trop vétuste par l'abbé Monet en 1768."
    ],
    "nl": [
      "Zelf rondleiding met documentatie. Het Romaanse gebouw ligt 100 m onder de gemeenschappelijke weegplaats, op de plaats van de oorspronkelijke Romaanse kerk, die in 1768 door abt Monet te klein en vervallen werd bevonden."
    ],
    "es": [
      "Visita autoguiada con documentación. El edificio románico se encuentra 100 m por debajo de la estación de pesaje comunal, en el lugar de la iglesia románica original, que el abad Monet juzgó demasiado pequeña y ruinosa en 1768."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Marcel"
    ]
  },
