  "rdfs:comment": {
    "de": [
      "Bertrand Souzy bietet Ihnen eine traditionelle Küche, die aus frischen Produkten zubereitet wird und je nach Jahreszeit variiert.\r\nIm Speisesaal kümmert sich Blandine um die Gäste."
    ],
    "en": [
      "Bertrand Souzy offers traditional cuisine based on fresh produce, which changes with the seasons.\r\nIn the dining room, Blandine takes great care of her customers."
    ],
    "it": [
      "Bertrand Souzy propone una cucina tradizionale basata su prodotti freschi che cambiano con le stagioni.\r\nIn sala, Blandine si prende cura dei suoi clienti."
    ],
    "fr": [
      "Bertrand Souzy vous propose une cuisine traditionnelle élaborée à partir de produits frais et qui varie au fil des saisons. \r\nEn salle, Blandine est aux petits soins pour la clientèle."
    ],
    "es": [
      "Bertrand Souzy ofrece una cocina tradicional basada en productos frescos que cambia con las estaciones.\r\nEn el comedor, Blandine atiende con esmero a sus clientes."
    ],
    "nl": [
      "Bertrand Souzy biedt een traditionele keuken op basis van verse producten die met de seizoenen mee veranderen.\r\nIn de eetzaal zorgt Blandine goed voor haar klanten."
    ]
  },
