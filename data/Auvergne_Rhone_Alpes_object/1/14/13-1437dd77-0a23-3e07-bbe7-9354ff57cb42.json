  "rdfs:comment": {
    "de": [
      "Der Cheval Noir in der Gemeinde Saint-Jean-de-Belleville ist ein Gipfel des Vanoise-Massivs. Er erreicht eine Höhe von 2832 m und dominiert die Ostseite des Col de la Madeleine gegenüber dem Lauzière-Massiv."
    ],
    "en": [
      "The Cheval Noir in the Belleville Valley is a summit of the Vanoise massif, it culminates at 2832m and dominates the east side of the Col de la Madeleine facing the Lauzière massif."
    ],
    "it": [
      "Le Cheval Noir, nel comune di Saint-Jean-de-Belleville, è una cima del massiccio della Vanoise, che si eleva a 2832 m e domina il versante orientale del Col de la Madeleine di fronte al massiccio della Lauzière."
    ],
    "fr": [
      "Le Cheval Noir sur la commune de Saint-Jean-de-Belleville, est un sommet du massif de la Vanoise, il culmine à 2832m et domine le côté Est du col de la Madeleine face au massif de la Lauzière."
    ],
    "nl": [
      "Le Cheval Noir, in de gemeente Saint-Jean-de-Belleville, is een piek in het Vanoise-massief die 2832 m hoog is en de oostelijke kant van de Col de la Madeleine domineert tegenover het Lauzière-massief."
    ],
    "es": [
      "Le Cheval Noir, en la comuna de Saint-Jean-de-Belleville, es un pico del macizo de la Vanoise que se eleva a 2.832 m y domina la vertiente oriental del Col de la Madeleine, frente al macizo de Lauzière."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sommet Le Cheval Noir"
    ]
  },
