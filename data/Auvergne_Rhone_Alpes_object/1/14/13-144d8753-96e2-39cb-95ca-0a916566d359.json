  "rdfs:comment": {
    "de": [
      "Im Rahmen des Bibliotheksfrühlings 2026 laden die Bibliothèque départementale de l'Allier und die Mediathek des Pays de Lapalisse Sie ein, \"La Fabrykason\" der Kompanie Ophonius zu entdecken."
    ],
    "en": [
      "As part of Printemps des Bibliothèques 2026, the Bibliothèque Départementale de l'Allier and the Médiathèque du Pays de Lapalisse invite you to discover \"La Fabrykason\" by the Ophonius company."
    ],
    "it": [
      "Nell'ambito del Printemps des Bibliothèques 2026, la biblioteca dipartimentale di Allier e la mediateca del Pays de Lapalisse vi invitano a scoprire \"La Fabrykason\" della società Ophonius."
    ],
    "fr": [
      "Dans le cadre du Printemps des Bibliothèques 2026, la bibliothèque départementale de l'Allier et la médiathèque du Pays de Lapalisse vous invite à découvrir \"La Fabrykason\" de la compagnie Ophonius."
    ],
    "nl": [
      "In het kader van Printemps des Bibliothèques 2026 nodigen de departementale bibliotheek van Allier en de mediatheek van het Pays de Lapalisse je uit om \"La Fabrykason\" van het bedrijf Ophonius te ontdekken."
    ],
    "es": [
      "En el marco de Printemps des Bibliothèques 2026, la biblioteca departamental de Allier y la mediateca del Pays de Lapalisse le invitan a descubrir \"La Fabrykason\" de la empresa Ophonius."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fabrykasons d'Ophonius"
    ]
  },
