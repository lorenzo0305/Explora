  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Herzen des Gebiets Mézenc-Gerbier de jonc-Lac d'Issarlès. Vom Balkon Ihres Zimmers aus werden Sie herrliche Naturlandschaften entdecken, deren Unendlichkeit Sie mit Ruhe, Gelassenheit und Entspannung berauschen wird."
    ],
    "en": [
      "Deep in the region encompassing Mont Mézenc, Mont Gerbier de Joncs and Lake Issarlès. The view from your balcony is one of stunning scenery as far as the eye can see giving you an overwhelming sense of peace, serenity and relaxation."
    ],
    "it": [
      "Situato nel cuore della zona di Mézenc-Gerbier de jonc-Lac d'Issarlès. Dal balcone della vostra camera scoprirete splendidi paesaggi naturali la cui immensità vi inebrierà di calma, serenità e relax."
    ],
    "fr": [
      "Situé au cœur de l'espace Mézenc-Gerbier de jonc-Lac d'Issarlès. Du balcon de votre chambre vous découvrirez des paysages naturels splendides dont l'immensité vous enivrera de calme, de sérénité et de relaxation."
    ],
    "es": [
      "Situado en el corazón de la zona de Mézenc-Gerbier de jonc-Lac d'Issarlès. Desde el balcón de su habitación descubrirá espléndidos paisajes naturales cuya inmensidad le embriagará de calma, serenidad y relajación."
    ],
    "nl": [
      "Gelegen in het hart van het gebied Mézenc-Gerbier de jonc-Lac d'Issarlès. Vanaf het balkon van uw kamer ontdekt u prachtige natuurlandschappen waarvan de onmetelijkheid u zal bedwelmen met rust, sereniteit en ontspanning."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel Beauséjour"
    ],
    "fr": [
      "Hôtel Beauséjour - Maison Vernet"
    ]
  },
