  "rdfs:comment": {
    "de": [
      "Angeln erlaubt auf dem Malève ab der Brücke Rue d'Offaz bis Charmy l'Envers (Fischereischutzgebiet ab der Brücke Offaz bis zum Zusammenfluss mit der Dranse). Erlaubnisscheine sind in den Touristenbüros erhältlich."
    ],
    "en": [
      "Fishing allowed on the Malève from the bridge in the rue d'Offaz to Charmy l'Envers (fishing reserve from the bridge in Offaz to its confluence with the Dranse). Permits are available at the tourist offices."
    ],
    "it": [
      "La pesca è consentita sulla Malève dal ponte di rue d'Offaz a Charmy l'Envers (riserva di pesca dal ponte di Offaz alla confluenza con la Dranse). I permessi sono disponibili presso gli uffici turistici."
    ],
    "fr": [
      "Pêche autorisé sur le Malève à partir du pont de la rue d'Offaz jusqu'à Charmy l'Envers (réserve de pêche depuis le pont d'Offaz  jusqu'à sa confluence avec la Dranse). Permis en vente dans les offices de tourisme."
    ],
    "nl": [
      "Vissen is toegestaan op de Malève vanaf de brug rue d'Offaz tot Charmy l'Envers (visreservaat vanaf de brug Offaz tot de samenvloeiing met de Dranse). Vergunningen verkrijgbaar bij de VVV-kantoren."
    ],
    "es": [
      "Pesca autorizada en el Malève desde el puente de la rue d'Offaz hasta Charmy l'Envers (coto de pesca desde el puente de Offaz hasta su confluencia con el Dranse). Los permisos están disponibles en las oficinas de turismo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in the Malève"
    ],
    "fr": [
      "Pêche dans le Malève"
    ],
    "nl": [
      "Vissen in de Malève"
    ]
  },
