  "rdfs:comment": {
    "de": [
      "Als olympische Disziplin und Freizeitaktivität können Sie das Bogenschießen allein oder mit Freunden entdecken.\r\nSie werden eine Erfahrung teilen, die von unseren diplomierten Lehrern begleitet wird, um Sie auf spielerische Weise bei Ihren Fortschritten zu begleiten."
    ],
    "en": [
      "Olympic discipline and leisure activity, come and discover archery alone or with friends.\r\nYour experience will be supervised by our qualified instructors so you can have fun while you progress."
    ],
    "it": [
      "Disciplina olimpica e attività ricreativa, venite a scoprire il tiro con l'arco da soli o in compagnia.\r\nCondividerete un'esperienza supervisionata dai nostri istruttori qualificati per accompagnarvi in modo giocoso nella vostra progressione."
    ],
    "fr": [
      "Discipline olympique et activité de loisir, venez découvrir le tir à l'Arc seul ou entre amis.\r\nVous partagerez une expérience encadrée par nos moniteurs diplômés afin de vous accompagner de façon ludique dans votre progression."
    ],
    "nl": [
      "Olympische discipline en vrijetijdsbesteding, kom en ontdek het boogschieten alleen of met vrienden.\r\nU deelt een ervaring onder begeleiding van onze gekwalificeerde instructeurs om u op een speelse manier te begeleiden in uw vooruitgang."
    ],
    "es": [
      "Disciplina olímpica y actividad de ocio, ven a descubrir el tiro con arco solo o con amigos.\r\nCompartirás una experiencia supervisada por nuestros instructores cualificados para acompañarte de forma lúdica en tu progresión."
    ]
  },
  "rdfs:label": {
    "de": [
      "Bogenschießen Autrans-Méaudre"
    ],
    "en": [
      "Autrans-Méaudre Archery"
    ],
    "fr": [
      "Tir à l'Arc Autrans-Méaudre"
    ]
  },
