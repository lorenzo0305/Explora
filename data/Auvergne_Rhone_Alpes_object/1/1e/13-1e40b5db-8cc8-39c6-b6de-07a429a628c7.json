  "rdfs:comment": {
    "de": [
      "Die Pizzeria de l'Eau d'Olle befindet sich in der Nähe des Parc des Tilleuls. Das Restaurant bietet Pizzen, Burger und Spezialitäten aus den Bergen sowie traditionelle Küche. Die Pizzen sind vor Ort oder zum Mitnehmen erhältlich."
    ],
    "en": [
      "The Pizzeria de l'Eau d'Olle is located near the Parc des Tilleuls. The restaurant serves pizzas, burgers and mountain specialities, as well as traditional cuisine. Pizzas are available to eat in or take away."
    ],
    "it": [
      "La Pizzeria de l'Eau d'Olle si trova vicino al Parc des Tilleuls. Il ristorante serve pizze, hamburger e specialità di montagna, oltre alla cucina tradizionale. Le pizze sono disponibili per il consumo o per l'asporto."
    ],
    "fr": [
      "La Pizzeria de l’Eau d’Olle se situe à proximité du Parc des Tilleuls. Le restaurant propose des pizzas, des burgers et des spécialités de montagne, ainsi qu’une cuisine traditionnelle. Les pizzas sont disponibles sur place ou à emporter."
    ],
    "nl": [
      "Pizzeria de l'Eau d'Olle ligt vlak bij het Parc des Tilleuls. Het restaurant serveert pizza's, hamburgers en bergspecialiteiten, maar ook traditionele gerechten. Pizza's zijn beschikbaar om te eten of om mee te nemen."
    ],
    "es": [
      "La Pizzeria de l'Eau d'Olle se encuentra cerca del Parc des Tilleuls. El restaurante sirve pizzas, hamburguesas y especialidades de montaña, además de cocina tradicional. Las pizzas están disponibles para comer en el restaurante o para llevar."
    ]
  },
