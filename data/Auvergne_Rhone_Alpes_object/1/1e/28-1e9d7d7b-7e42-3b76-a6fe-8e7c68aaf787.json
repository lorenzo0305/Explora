  "rdfs:comment": {
    "de": [
      "Entdecken Sie Signature in Saultain: neo-gastronomische Küche, gemütlicher Rahmen, lokale Produkte und die Kreativität des Küchenchefs Damien Franco. Eine wahre Reise der Sinne.\n2 Hauben Gault & Millau \"Table de chef\" 2026"
    ],
    "en": [
      "Discover Signature in Saultain: neo-gastronomic cuisine, cosy surroundings, local produce and the creativity of chef Damien Franco. A true voyage of the senses.\n2 toques Gault & Millau \"Table de chef\" 2026"
    ],
    "it": [
      "Scoprite Signature a Saultain: cucina neo-gastronomica, ambiente accogliente, prodotti locali e la creatività dello chef Damien Franco. Un vero e proprio viaggio per i sensi.\n2 premi Gault & Millau \"Table de chef\" 2026"
    ],
    "fr": [
      "Découvrez Signature à Saultain : cuisine néo-gastronomique, cadre cosy, produits locaux et créativité du chef Damien Franco. Un vrai voyage des sens. \n2 toques Gault & Millau \"Table de chef\" 2026"
    ],
    "nl": [
      "Ontdek Signature in Saultain: neo-gastronomische keuken, gezellige omgeving, lokale producten en de creativiteit van chef-kok Damien Franco. Een ware reis voor de zintuigen.\n2 toques Gault & Millau \"Table de chef\" 2026"
    ],
    "es": [
      "Descubra Signature en Saultain: cocina neogastronómica, un entorno acogedor, productos locales y la creatividad del chef Damien Franco. Un auténtico viaje para los sentidos.\n2 toques Gault & Millau \"Table de chef\" 2026"
    ]
