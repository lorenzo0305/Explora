  "rdfs:comment": {
    "de": [
      "Leichte Wanderung auf einer kleinen Schleife, die zuerst abwärts und dann aufwärts führt.2 Sie starten vom Gipfel des Klettersteigs über den Zugangsweg 1b und kehren über den Weg 13 zurück."
    ],
    "en": [
      "Easy progress on a small loop first descending, then ascending 2. Start from the top of the itinerary via 1b, return via 13."
    ],
    "it": [
      "Facile progressione su un breve anello prima in discesa e poi in salita.2 Partenza dalla cima della Via Ferrata tramite il sentiero di accesso 1b, ritorno tramite il sentiero 13."
    ],
    "fr": [
      "Progression facile sur une petite boucle d’abord descendante puis ascendante.2 Le départ s’effectue depuis le sommet de la Via Ferrata en empruntant le chemin d’accès 1b, retour par le sentier 13."
    ],
    "es": [
      "Progresión fácil en un bucle corto primero descendente y luego ascendente.2 Salida desde la cima de la Vía Ferrata por el sendero de acceso 1b, regreso por el sendero 13."
    ],
    "nl": [
      "Gemakkelijke voortgang via een korte lus, eerst dalend en dan stijgend.2 Start vanaf de top van de Via Ferrata via toegangspad 1b, terug via pad 13."
    ]
  },
  "rdfs:label": {
    "en": [
      "Via Ferrata du Mont : Les Petits montagnards course"
    ],
    "fr": [
      "Via Ferrata du Mont : Parcours Les Petits montagnards"
    ]
  },
