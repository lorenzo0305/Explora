  "rdfs:comment": {
    "de": [
      "Ob Sie Anfänger oder erfahrener Angler sind, auf der Suche nach einem Nervenkitzel oder einer Angelpartie mit der Familie, der Plan d'eau du Noyer verspricht Ihnen ein unvergessliches Erlebnis!"
    ],
    "en": [
      "Whether you're a beginner or an experienced angler, looking for a thrill or a family fishing trip, the Noyer lake promises an unforgettable experience!"
    ],
    "it": [
      "Che siate principianti o esperti, in cerca di emozioni o di una gita di pesca in famiglia, il lago di Noyer promette un'esperienza indimenticabile!"
    ],
    "fr": [
      "Que vous soyez pêcheur débutant ou expérimenté, à la recherche de sensations fortes ou d'une partie de pêche en famille, le plan d'eau du Noyer vous promet une expérience inoubliable !"
    ],
    "es": [
      "Tanto si es un principiante como un pescador experimentado, si busca emociones fuertes o una excursión de pesca en familia, el lago Noyer le promete una experiencia inolvidable"
    ],
    "nl": [
      "Of je nu een beginner bent of een ervaren visser, op zoek naar een sensatie of een vistochtje met het hele gezin, het meer van Noyer belooft een onvergetelijke ervaring!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plan d'eau Le Noyer"
    ]
  },
