  "rdfs:comment": {
    "de": [
      "Café, Brasserie, Pizzéria de la poste im Herzen des schönen Dorfes Saignes, in der Nähe der Kirche. Arbeitermahlzeiten unter der Woche mittags. Salate, Pizzas und Burger (Dienstag bis Freitag) am Abend, aus frischen Produkten hergestellt. Freundlicher Empfang."
    ],
    "en": [
      "Café, Brasserie, Pizzéria de la Poste located in the heart of the beautiful village of Saignes, near the church on route du Monteil. Workman's lunch every weekday, à la carte menu and pizzas in the evening, made with fresh produce. Friendly welcome."
    ],
    "it": [
      "Caffè, brasserie e pizzeria dell'ufficio postale nel cuore del bellissimo villaggio di Saignes, vicino alla chiesa. Pranzo dei lavoratori nei giorni feriali. La sera insalate, pizze e hamburger (da martedì a venerdì) preparati con prodotti freschi. Accoglienza cordiale."
    ],
    "fr": [
      "Café, brasserie, pizzéria de la poste situé au cœur du beau village de Saignes, à proximité de l'église. Repas ouvrier, les midis en semaine. Salades, pizzas et burgers (mardi au vendredi) le soir, réalisés à partir de produits frais. Accueil convivial."
    ],
    "nl": [
      "Postkantoorcafé, brasserie en pizzeria in het hart van het mooie dorp Saignes, vlakbij de kerk. Werknemerslunch op weekdagen. Salades, pizza's en hamburgers (dinsdag tot vrijdag) 's avonds, bereid met verse producten. Vriendelijk onthaal."
    ],
    "es": [
      "Cafetería de correos, brasserie y pizzería en el corazón del bonito pueblo de Saignes, cerca de la iglesia. Almuerzo de trabajo entre semana. Ensaladas, pizzas y hamburguesas (de martes a viernes) por la noche, elaboradas con productos frescos. Acogida cordial."
    ]
  },
  "rdfs:label": {
    "en": [
      "Café Brasserie Pizzeria de la Poste"
    ],
    "fr": [
      "Café Brasserie Pizzeria de la Poste"
    ]
  },
