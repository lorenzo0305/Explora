  "rdfs:comment": {
    "de": [
      "Crest liegt im Herzen des Departements Drôme und wird vom höchsten Bergfried Frankreichs überragt. Crest präsentiert eine ganze Palette an Freizeitaktivitäten. Kulturstadt, die mit ihrem Festival de Jazz Vocal auch eine besondere Atmosphäre bietet."
    ],
    "en": [
      "In the heart of the Drôme, Crest is dominated by the highest keep in France. Crest offers a wide range of leisure activities. A cultural town with a special atmosphere, with its Vocal Jazz Festival."
    ],
    "it": [
      "Nel cuore della Drôme, il Crest è dominato dal torrione più alto di Francia. Crest offre un'ampia gamma di attività per il tempo libero. Una città culturale che offre anche un'atmosfera speciale con il suo Vocal Jazz Festival."
    ],
    "fr": [
      "Au coeur de la Drôme, Crest est dominée par le plus haut donjon de France. Crest présente toute une palette d'activités de loisirs. Ville culturelle qui offre aussi une ambiance particulière avec son Festival de Jazz Vocal."
    ],
    "nl": [
      "In het hart van de Drôme wordt Crest gedomineerd door de hoogste donjon van Frankrijk. Crest biedt een breed scala aan vrijetijdsactiviteiten. Een culturele stad die ook een speciale sfeer biedt met zijn Vocal Jazz Festival."
    ],
    "es": [
      "En el corazón de la Drôme, Crest está dominado por el torreón más alto de Francia. Crest ofrece una amplia gama de actividades de ocio. Una ciudad cultural que también ofrece un ambiente especial con su Festival de Jazz Vocal."
    ]
  },
  "rdfs:label": {
