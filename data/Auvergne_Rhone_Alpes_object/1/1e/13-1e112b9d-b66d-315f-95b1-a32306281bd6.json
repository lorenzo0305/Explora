  "rdfs:comment": {
    "de": [
      "Die Passerelle de Bionnassay ist ein spektakuläres Bauwerk, das die Überquerung des Wildbachs von Bionnassay ermöglicht. Sie ist ein unumgänglicher Punkt auf einigen Wanderungen, insbesondere in Richtung Bellevue, Mont Lachat oder Nid d'Aigle."
    ],
    "en": [
      "The Passerelle de Bionnassay is a spectacular structure that crosses the Bionnassay torrent. It is a must for certain hikes, notably to Bellevue, Mont Lachat or the Nid d'Aigle."
    ],
    "it": [
      "La Passerella di Bionnassay è una struttura spettacolare che attraversa il torrente Bionnassay. È una tappa obbligata per alcune escursioni, in particolare verso Bellevue, Mont Lachat o il Nid d'Aigle."
    ],
    "fr": [
      "La Passerelle de Bionnassay est un ouvrage spectaculaire permettant de traverser le torrent de Bionnassay. Il est le point incontournable de certaines randonnées, notamment en direction de Bellevue, du Mont Lachat ou du Nid d'Aigle."
    ],
    "es": [
      "La Passerelle de Bionnassay es una espectacular estructura que atraviesa el torrente de Bionnassay. Es imprescindible para ciertas excursiones, sobre todo hacia Bellevue, el Monte Lachat o el Nid d'Aigle."
    ],
    "nl": [
      "De Passerelle de Bionnassay is een spectaculair bouwwerk dat de rivier de Bionnassay oversteekt. Het is een must voor bepaalde wandelingen, vooral richting Bellevue, Mont Lachat of de Nid d'Aigle."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Passerelle himalayenne de Bionnassay"
    ]
  },
