  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit \"Die Reise des galaktischen Magiers\", einer interaktiven Show für Jugendliche, die moderne Magie, Illusionen, Mentalismus und Comedy vereint, in ein wunderbares und faszinierendes Universum ein."
    ],
    "en": [
      "Immerse yourself in a marvelous and fascinating universe with \"The Journey of the Galactic Magician\", an interactive show for young people that combines modern magic, illusions, mentalism and comedy."
    ],
    "it": [
      "Immergetevi in un universo meraviglioso e affascinante con \"Le voyage du magicien galactique\", uno spettacolo interattivo per ragazzi che combina magia moderna, illusioni, mentalismo e comicità."
    ],
    "fr": [
      "Plongez dans un univers merveilleux et fascinant avec « Le voyage du magicien galactique », un spectacle interactif pour les jeunes qui allie magie moderne, illusions, mentalisme et comédie."
    ],
    "es": [
      "Sumérjase en un universo maravilloso y fascinante con \"Le voyage du magicien galactique\", un espectáculo interactivo para jóvenes que combina magia moderna, ilusionismo, mentalismo y comedia."
    ],
    "nl": [
      "Dompel jezelf onder in een wonderbaarlijk en fascinerend universum met \"Le voyage du magicien galactique\", een interactieve show voor jongeren die moderne magie, illusies, mentalisme en komedie combineert."
    ]
  },
