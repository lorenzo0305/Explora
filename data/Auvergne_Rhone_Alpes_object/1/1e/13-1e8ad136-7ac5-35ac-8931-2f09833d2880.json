  "rdfs:comment": {
    "de": [
      "Unser komplett renoviertes Hotel begrüßt Sie in einem modernen und freundlichen Ambiente, nur 5 Autominuten vom Stadtzentrum von Valence und dem Kongress- und Ausstellungszentrum Jacques Chirac entfernt."
    ],
    "en": [
      "Completely renovated, our hotel welcomes you in a modern and friendly setting, just a 5-minute drive from Valence city center and the Palais des Congrès et des Exposition Jacques Chirac."
    ],
    "it": [
      "Completamente rinnovato, il nostro hotel vi accoglie in un ambiente moderno e accogliente, a soli 5 minuti di auto dal centro di Valence e dal Centro Congressi ed Esposizioni Jacques Chirac."
    ],
    "fr": [
      "Entièrement rénové, notre hôtel vous accueille dans un cadre moderne et convivial, à seulement 5 minutes en voiture du centre-ville de Valence et du Palais des Congrès et des Exposition Jacques Chirac."
    ],
    "nl": [
      "Ons volledig gerenoveerde hotel verwelkomt u in een moderne en vriendelijke omgeving, op slechts 5 minuten rijden van het stadscentrum van Valence en het congres- en expositiecentrum Jacques Chirac."
    ],
    "es": [
      "Completamente renovado, nuestro hotel le da la bienvenida en un entorno moderno y acogedor, a sólo 5 minutos en coche del centro de Valence y del Palacio de Congresos y Exposiciones Jacques Chirac."
    ]
  },
