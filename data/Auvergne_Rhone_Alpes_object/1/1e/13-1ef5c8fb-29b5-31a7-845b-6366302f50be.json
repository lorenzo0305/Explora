  "rdfs:comment": {
    "de": [
      "Gedämpfte Atmosphäre im Inneren oder entspannte Atmosphäre auf der Terrasse im Sommer... Das gleiche Vergnügen! Einen schmackhaften und geselligen Moment zwischen Himmel und Gipfeln zu genießen."
    ],
    "en": [
      "Cosy indoors or relaxed on the terrace in summer... The same pleasure! Enjoy a tasty, convivial moment between sky and mountain."
    ],
    "it": [
      "Un'atmosfera accogliente all'interno o una terrazza rilassante in estate... Il piacere è sempre lo stesso! Godetevi un momento gustoso e conviviale tra il cielo e le cime."
    ],
    "fr": [
      "Ambiance feutrée à l'intérieur ou décontractée en terrasse l'été... Le même plaisir ! Déguster un moment savoureux et convivial entre ciel et sommets."
    ],
    "es": [
      "Un ambiente acogedor en el interior o una relajada terraza en verano... ¡El mismo placer! Disfrute de un momento sabroso y de convivencia entre el cielo y las cumbres."
    ],
    "nl": [
      "Een gezellige sfeer binnen of een ontspannen terras in de zomer... Allemaal hetzelfde plezier! Geniet van een smakelijk en gezellig moment tussen de hemel en de bergtoppen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le O'Yéti"
    ]
  },
