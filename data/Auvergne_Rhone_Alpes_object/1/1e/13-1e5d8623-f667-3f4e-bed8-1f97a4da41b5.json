  "rdfs:comment": {
    "de": [
      "Das Solar ist ein Konzertsaal, der dem Jazz und der improvisierten Musik gewidmet ist. Kommen Sie und hören Sie Jazz, jeden Montagabend bei den Jam Sessions oder am Wochenende bei einem Konzert!"
    ],
    "en": [
      "Le Solar is a concert hall dedicated to jazz and improvised music. Come and listen to Jazz, every Monday evening during Jam sessions or at the end of the week for a concert!"
    ],
    "it": [
      "Le Solar è una sala concerti dedicata al jazz e alla musica improvvisata. Venite ad ascoltare il jazz, ogni lunedì sera durante le Jam session o alla fine della settimana per un concerto!"
    ],
    "fr": [
      "Le Solar est une salle de concerts dédiée au jazz et aux musiques improvisées. Venez écoutez du Jazz, tous les lundi soirs lors des Jam sessions ou en fin semaine le temps d'un concert !"
    ],
    "nl": [
      "Le Solar is een concertzaal gewijd aan jazz en geïmproviseerde muziek. Kom luisteren naar jazz, elke maandagavond tijdens jamsessies of aan het eind van de week voor een concert!"
    ],
    "es": [
      "Le Solar es una sala de conciertos dedicada al jazz y a la música improvisada. Venga a escuchar jazz, todos los lunes por la noche durante las Jam sessions o al final de la semana para asistir a un concierto"
    ]
  },
