  "rdfs:comment": {
    "de": [
      "Probieren Sie sehr gute hausgemachte marokkanische Spezialitäten, süß und salzig, vor Ort oder zum Mitnehmen. Machen Sie eine Pause bei einem Minztee und entfliehen Sie dem Alltag in einer exotischen Umgebung!"
    ],
    "en": [
      "You can enjoy homemade Morrocan specialities, sweet or savoury, on site or to take away. Have a break while enjoying a mint tea that will transport you to an exotic place!"
    ],
    "it": [
      "Assaggiate le ottime specialità marocchine fatte in casa, dolci e salate, sul posto o da asporto. Prendetevi una pausa con un tè alla menta e fuggite in un mondo diverso!"
    ],
    "fr": [
      "Dégustez de très bonnes spécialités marocaines faites maisons, sucrées et salées, sur place ou à emporter. Faites une pause autour du thé à la menthe et évadez vous dans un décor dépaysant !"
    ],
    "nl": [
      "Proef zeer goede zelfgemaakte Marokkaanse specialiteiten, zoet en zout, ter plaatse of om mee te nemen. Neem een pauze onder het genot van muntthee en ontsnap naar een andere wereld!"
    ],
    "es": [
      "Deguste muy buenas especialidades marroquíes caseras, dulces y saladas, en el momento o para llevar. Tómese un descanso con un té a la menta y escape a un mundo diferente"
    ]
  },
