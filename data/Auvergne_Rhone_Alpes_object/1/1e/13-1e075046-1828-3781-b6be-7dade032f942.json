  "rdfs:comment": {
    "de": [
      "Adventure Center ist ein Indoor-Freizeitkomplex in La Pardieu in Clermont-Fd.\r\nAuf dem Programm stehen: Escape Game, sensorisches Abenteuer, Blind Test, Quiz Boxing, privates Karaoke und Action Game, das von TV-Abenteuersendungen inspiriert ist! von 5 bis 77 Jahren und mehr?"
    ],
    "en": [
      "Adventure Center is an indoor leisure complex located in Pardieu, Clermont-Fd.\r\nOn the program: Escape Game, Sensory Adventure, Blind Test, Quiz Boxing, Private Karaoke and Action Game inspired by Fort Boyard! from 5 to 77 years and more..."
    ],
    "it": [
      "L'Adventure Center è un complesso ricreativo al coperto situato a Pardieu, a Clermont-Fd.\r\nIn programma: Escape Game, Sensory Adventure, Blind Test, Boxing Quiz, Private Karaoke e Action Game ispirati ai telefilm d'avventura! Dai 5 ai 77 anni e oltre?"
    ],
    "fr": [
      "Adventure Center est un complexe de loisirs indoor situé à la Pardieu à Clermont-Fd.\r\nAu programme : Escape Game, Aventure Sensorielle, Blind Test, Quiz Boxing, Karaoké privatif et Action Game inspiré des émissions TV d'aventure ! de 5 à 77ans et plus…"
    ],
    "nl": [
      "Adventure Center is een overdekt recreatiecomplex gelegen in Pardieu in Clermont-Fd.\r\nOp het programma: Escape Game, Zintuiglijk Avontuur, Blindentest, Boksquiz, Private Karaoke en Actiespel geïnspireerd op TV-avonturenshows! 5 tot 77 jaar en ouder?"
    ],
    "es": [
      "Adventure Center es un complejo de ocio cubierto situado en La Pardieu, en Clermont-Fd.\r\nEn el programa: Juego de Escape, Aventura Sensorial, Test de Ciegos, Quiz de Boxeo, Karaoke Privado y Juego de Acción inspirado en los programas de aventuras de la TV! 5 a 77 años y más?"
    ]
  },
