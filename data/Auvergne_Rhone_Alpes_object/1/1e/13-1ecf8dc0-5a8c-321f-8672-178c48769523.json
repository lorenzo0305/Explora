  "rdfs:comment": {
    "de": [
      "Hinter L'Âne Rouge steht Alban, ein Metallhandwerker, der sich leidenschaftlich für Design und Eisenverarbeitung interessiert. Möbel, Leuchten, Skulpturen, Pergolen, Glasdächer? jede Kreation ist ein Einzelstück, das von Hand nach Maß gefertigt wird."
    ],
    "en": [
      "Behind l'Âne Rouge is Alban, a metalworker with a passion for design and ironwork. Furniture, lighting, sculpture, pergolas, canopies? each creation is a unique, hand-crafted, made-to-measure piece."
    ],
    "it": [
      "L'Âne Rouge nasce da un'idea di Alban, un metalmeccanico con la passione per il design e la lavorazione del ferro. Mobili, illuminazione, sculture, pergole, tetti in vetro... ogni creazione è un pezzo unico, artigianale e su misura."
    ],
    "fr": [
      "À l'initiative de l'Âne Rouge, se cache Alban, artisan métallier passionné par le design et le travail du fer. Mobilier, luminaire, sculpture, pergola, verrière… chaque création est une pièce unique, façonnée à la main en sur-mesure."
    ],
    "nl": [
      "L'Âne Rouge is het geesteskind van Alban, een metaalbewerker met een passie voor design en ijzerwerk. Meubels, verlichting, sculpturen, pergola's, glazen daken: elke creatie is uniek, handgemaakt en op maat gemaakt."
    ],
    "es": [
      "L'Âne Rouge es la creación de Alban, un metalúrgico apasionado por el diseño y la forja. Muebles, iluminación, esculturas, pérgolas, techos de cristal... cada creación es una pieza única, hecha a mano y a medida."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Âne Rouge Métallerie"
    ]
  },
