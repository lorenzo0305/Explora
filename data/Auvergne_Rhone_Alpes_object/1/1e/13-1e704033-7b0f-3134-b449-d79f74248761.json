  "rdfs:comment": {
    "de": [
      "Das Rathaus von Buis-les-Baronnies ist stolz darauf, das traditionelle Lindenfest zu unterstützen: Als Hauptstadt der Linde stellt unsere Gemeinde die Branche der Linden sowie der aromatischen und medizinischen Pflanzen und aller daraus hergestellten Produkte in den Vordergrund."
    ],
    "en": [
      "The Mairie de Buis-les-Baronnies is proud to support the traditional Fête du Tilleul: as the capital of the linden tree, our commune promotes the linden tree industry, as well as aromatic and medicinal plants, and all the products derived from them."
    ],
    "it": [
      "La Mairie de Buis-les-Baronnies è orgogliosa di sostenere la tradizionale Fête du Tilleul: in quanto capitale del tiglio, il nostro comune promuove l'industria del tiglio, nonché le piante aromatiche e medicinali e tutti i prodotti da esse derivati."
    ],
    "fr": [
      "La Mairie de Buis-les-Baronnies est fière de soutenir la traditionnelle Fête du Tilleul : capitale du tilleul, notre commune met en avant la filière du tilleul ainsi que des plantes aromatiques et médicinales, et tous les produits qui en découlent."
    ],
    "es": [
      "La Mairie de Buis-les-Baronnies se enorgullece de apoyar la tradicional Fête du Tilleul: como capital del tilo, nuestro municipio promueve la industria del tilo, así como las plantas aromáticas y medicinales, y todos los productos derivados de ellas."
    ],
    "nl": [
      "Het gemeentebestuur van Buis-les-Baronnies is er trots op het traditionele Fête du Tilleul te ondersteunen: als hoofdstad van de linde promoot onze gemeente de lindeindustrie, evenals aromatische en geneeskrachtige planten en alle producten die daaruit voortkomen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tilleul en fête"
    ]
  },
