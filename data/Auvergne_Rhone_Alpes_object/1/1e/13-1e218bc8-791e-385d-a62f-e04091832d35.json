  "rdfs:comment": {
    "de": [
      "Unter den Platanen des schattigen Hofes sind Ateliers von Künstlern und kreativen Handwerkern sowie wechselnde Ausstellungen versammelt.\r\nDieser einladende und gesellige Ort schmiegt sich in Nyons nur wenige Schritte vom historischen Kern der Altstadt entfernt an den Hang."
    ],
    "en": [
      "Under the plane trees in the shady courtyard, artists' and craftsmen's workshops are grouped together, as well as temporary exhibitions.\r\nThis welcoming and friendly place is located in Nyons, a stone's throw from the historic heart of the old town."
    ],
    "it": [
      "Sotto i platani del cortile ombreggiato sono raggruppati laboratori di artisti e artigiani, oltre a mostre temporanee.\r\nQuesto luogo accogliente e conviviale si trova a Nyons, a due passi dal cuore storico della città vecchia."
    ],
    "fr": [
      "Sous les platanes de la cour ombragée, sont regroupés des ateliers d’artistes et artisans créateurs, ainsi que des expositions temporaires.\r\nCe lieu accueillant et convivial se niche à Nyons à deux pas du cœur historique de la vieille ville."
    ],
    "nl": [
      "Onder de platanen van de schaduwrijke binnenplaats zijn de ateliers van kunstenaars en ambachtslieden gegroepeerd, evenals tijdelijke tentoonstellingen.\r\nDeze gastvrije en vriendelijke plek is genesteld in Nyons, op tien minuten te voet van het historische hart van de oude stad."
    ],
    "es": [
      "Bajo los plátanos del sombreado patio, se agrupan los talleres de artistas y artesanos, así como las exposiciones temporales.\r\nEste lugar acogedor y convivencial está enclavado en Nyons, a un paso del corazón histórico del casco antiguo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Trois Platanes"
    ],
    "nl": [
      "Les Trois Platanes"
    ]
  },
