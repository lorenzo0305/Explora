  "rdfs:comment": {
    "de": [
      "Portugiesische Tapas-Bar, in der du einfach nur auf ein Getränk und/oder ein paar Tapas vorbeikommen kannst. Das alles in einer gemütlichen Umgebung mit guter Musik. Ab 22:30 Uhr wird getanzt und gefeiert."
    ],
    "en": [
      "Portuguese tapas bar where you can come just for a drink and/or some tapas. All this in a warm and friendly environment with great music. From 22:30 onwards, it's time to dance and party."
    ],
    "it": [
      "Bar portoghese di tapas dove si può venire solo per bere un drink e/o mangiare qualche tapas. Il tutto in un ambiente accogliente e con buona musica. Dalle 22.30 in poi si balla e si fa festa."
    ],
    "fr": [
      "Bar à Tapas Portugais oú vous pouvez venir juste pour boire un verre et/ou grignoter quelques tapas. Tout cela dans un environnement  chaleureux avec de la bonne musique. À partir de 22h30, place à la danse et à la fête."
    ],
    "nl": [
      "Portugese Tapas Bar waar je terecht kunt voor een drankje en/of wat tapas. Dit alles in een warme omgeving met goede muziek. Vanaf 22.30 uur is het tijd om te dansen en te feesten."
    ],
    "es": [
      "Bar de tapas portugués donde se puede venir a tomar una copa y/o picar unas tapas. Todo en un ambiente cálido y con buena música. A partir de las 22:30, es hora de bailar y de fiesta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Porto's"
    ]
  },
