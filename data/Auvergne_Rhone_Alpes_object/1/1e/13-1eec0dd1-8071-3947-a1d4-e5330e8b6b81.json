  "rdfs:comment": {
    "de": [
      "Die Bar, das Restaurant und die Pizzeria \"Le Village\" befinden sich im Herzen des Dorfes Le Périer, in der Nähe der Kirche. Hier kann man sowohl drinnen als auch draußen zu Mittag und zu Abend essen. Außerdem organisiert es kulturelle und musikalische Veranstaltungen."
    ],
    "en": [
      "Snack bar at the heart of the village Le Périer, next to the Church.\r\nInside or outside, the restaurant offers traditional home-made cooking, daily menu from 9€ (for lunch on week), an à la carte menu on evening and week-end"
    ],
    "it": [
      "Il bar-ristorante-pizzeria \"Le Village\" si trova nel cuore del villaggio di Le Périer, vicino alla chiesa. È aperto a pranzo e a cena, sia all'interno che all'esterno. Organizza anche eventi culturali e musicali."
    ],
    "fr": [
      "Le bar restaurant pizzéria \"Le Village\" est situé au coeur du village du Périer, près de l'église. On peut y déjeuner et y diner à l'intérieur comme à l'extérieur. Il organise également des événements culturels et musicaux."
    ],
    "es": [
      "El bar-restaurante-pizzería \"Le Village\" está situado en el corazón del pueblo de Le Périer, cerca de la iglesia. Está abierto para el almuerzo y la cena, tanto en el interior como en el exterior. También organiza eventos culturales y musicales."
    ],
    "nl": [
      "De snack bar le village gelegen in het centum naast de kerk heeft een mooi terras."
    ]
  },
