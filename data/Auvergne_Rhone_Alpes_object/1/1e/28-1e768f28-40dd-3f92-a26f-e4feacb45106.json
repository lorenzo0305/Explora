  "rdfs:comment": {
    "de": [
      "Mit dem Tex'N tauchen Sie in die Atmosphäre des großen amerikanischen Westens ein & willkommen im Saloon!\n80 Gedecke, davon 30 auf der Terrasse / Haustiere erlaubt)"
    ],
    "en": [
      "With Tex'N, plunge into the atmosphere of the Great American West & welcome to the saloon!\n80 covers including 30 on terrace / pets welcome)"
    ],
    "it": [
      "Con Tex'N, immergetevi nell'atmosfera del Grande West americano e benvenuti nel saloon!\n80 coperti di cui 30 in terrazza / si accettano animali)"
    ],
    "fr": [
      "Avec le Tex'N, plongez dans l'ambiance du Grand Ouest américain  & bienvenue au saloon !\n80 couverts dont 30 en terrasse / animaux acceptés)"
    ],
    "nl": [
      "Duik met Tex'N in de sfeer van het Grote Amerikaanse Westen & welkom in de saloon!\n80 couverts inclusief 30 op het terras / dieren geaccepteerd)"
    ],
