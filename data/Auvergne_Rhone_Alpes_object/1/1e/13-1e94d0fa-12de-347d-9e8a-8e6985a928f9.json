  "rdfs:comment": {
    "de": [
      "Thema: Berg\r\n\r\nDarstellung eines \"Bergmenschen\", des Yeti. Er fragt uns auch nach der Winterwirtschaft in den Bergen und dem Einfluss, den der Mensch auf die Natur hat."
    ],
    "en": [
      "Theme: mountains\r\n\r\nrepresentation of a \"mountain man\", the Yeti. It also raises questions about the mountain winter economy and man's impact on nature."
    ],
    "it": [
      "Tema: montagne\r\n\r\nUna rappresentazione di un \"uomo di montagna\", lo Yeti. Si interroga anche sull'economia invernale delle montagne e sull'impatto dell'uomo sulla natura."
    ],
    "fr": [
      "Thème : montagne\r\n\r\nreprésentation d'un \"homme montagne\", le Yéti. Il nous interroge aussi sur l'économie hivernale de la montagne et l'impact qu'a l'homme sur la nature"
    ],
    "nl": [
      "Thema: bergen\r\n\r\nEen voorstelling van een \"bergmens\", de Yeti. Het stelt ook vragen over de wintereconomie van de bergen en de invloed van de mens op de natuur."
    ],
    "es": [
      "Tema: montañas\r\n\r\nrepresentación de un \"hombre de la montaña\", el Yeti. También plantea preguntas sobre la economía invernal de las montañas y el impacto del hombre en la naturaleza"
    ]
  },
  "rdfs:label": {
    "de": [
      "Fresko: Der wandernde Berg"
    ],
    "en": [
      "Fresco: The Walking Mountain"
    ],
    "it": [
      "Affresco: La montagna che cammina"
    ],
    "fr": [
      "Fresque : La montagne promeneuse"
    ],
    "nl": [
      "Fresco: De wandelende berg"
    ]
  },
