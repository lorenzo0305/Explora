  "rdfs:comment": {
    "de": [
      "Versuchen Sie Ihr Glück beim Super Lotto und verbringen Sie einen angenehmen Moment mit der Familie oder mit Freunden! Eine Reservierung ist nicht erforderlich. Getränke und Speisen vor Ort. Türöffnung um 12:30 Uhr."
    ],
    "en": [
      "Come and try your luck at the Super Loto and have a great time with family and friends! No reservations required. Refreshments and snacks on site. Doors open at 12.30pm."
    ],
    "it": [
      "Venite a tentare la fortuna al Super Loto e divertitevi con la famiglia e gli amici! Non è necessaria la prenotazione. Rinfreschi e cibo in loco. Apertura porte alle 12.30."
    ],
    "fr": [
      "Venez tenter votre chance au Super Loto et passer un agréable moment en famille ou entre amis ! Pas de réservation. Buvette et restauration sur place. Ouverture des portes à 12h30."
    ],
    "es": [
      "Ven a probar suerte en la Super Loto y pásatelo en grande con tu familia y amigos No es necesario reservar. Refrescos y comida in situ. Apertura de puertas a las 12.30 h."
    ],
    "nl": [
      "Kom je geluk beproeven in de Super Loto en beleef een geweldige tijd met familie en vrienden! Reserveren is niet nodig. Versnaperingen en eten ter plaatse. Deuren open om 12.30 uur."
    ]
  },
