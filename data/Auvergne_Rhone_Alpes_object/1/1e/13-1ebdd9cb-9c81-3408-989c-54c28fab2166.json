  "rdfs:comment": {
    "de": [
      "Der Plan d'eau des Dérouts de Châteauneuf, eine ehemalige Kiesgrube, die neu gestaltet wurde, ermöglicht es Ihnen, das ganze Jahr über die Freuden des Angelns zu genießen. Die Karten sind auf unserer Website erhältlich"
    ],
    "en": [
      "The lake of Dérouts of Châteauneuf will give you the opportunity to enjoy fishing during summer. You can buy fishing cards at the bakery of Châteauneuf (8 € per day)."
    ],
    "it": [
      "Il lago Dérouts de Châteauneuf, un'ex cava di ghiaia riabilitata, offre la possibilità di pescare tutto l'anno. Le tessere sono in vendita sul nostro sito web"
    ],
    "fr": [
      "Le plan d'eau des Dérouts de Châteauneuf, anciennes gravières réaménagées, vous permettront de goûter aux plaisirs de la pêche toute l'année. Les cartes sont en vente sur notre site internet"
    ],
    "nl": [
      "In het meer van Dérouts de Châteauneuf, een voormalige grindgroeve die is hersteld, kun je het hele jaar door vissen. Kaarten zijn te koop op onze website"
    ],
    "es": [
      "El lago de Dérouts de Châteauneuf, antigua gravera rehabilitada, le ofrece la posibilidad de disfrutar de la pesca durante todo el año. Las tarjetas están a la venta en nuestro sitio web"
    ]
  },
