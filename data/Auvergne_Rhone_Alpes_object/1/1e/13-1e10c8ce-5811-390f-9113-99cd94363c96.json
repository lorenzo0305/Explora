  "rdfs:comment": {
    "de": [
      "Enjoy Fitness ist das Fitnesscenter in Saint-Gervais\r\nDie Trainer stehen Ihnen für eine optimale Betreuung ohne Risiko zur Verfügung. Gruppenkurse oder Privatcoaching sie werden da sein, um Sie zu betreuen und anzuleiten, egal ob Sie Anfänger oder Fortgeschrittener sind."
    ],
    "en": [
      "Enjoy Fitness is the fitness centre in Saint-Gervais \r\nOur trainers are there to listen to your needs and provide you with optimal, risk-free supervision. Whether you're a beginner or an experienced exerciser, they'll be there to monitor and guide you."
    ],
    "it": [
      "Enjoy Fitness è il centro fitness a Saint-Gervais \r\nI nostri istruttori sono pronti ad ascoltare le vostre esigenze e a fornirvi una supervisione ottimale e priva di rischi. Che siate principianti o esperti, i nostri istruttori vi seguiranno e vi guideranno."
    ],
    "fr": [
      "Enjoy Fitness est le centre de remise en forme de Saint-Gervais \r\nDes coachs à votre écoute pour un suivi optimal et sans risque. Cours collectifs ou coaching privés ils seront là pour vous suivre et vous guider que vous soyez débutant ou confirmé."
    ],
    "nl": [
      "Enjoy Fitness is het fitnesscentrum in Saint-Gervais\r\nOnze trainers zijn er om naar je te luisteren en je optimaal en zonder risico's te begeleiden. Of je nu een beginner bent of een ervaren sporter, ze zullen er zijn om je te controleren en te begeleiden."
    ],
    "es": [
      "Enjoy Fitness es el centro de fitness de Saint-Gervais\r\nNuestros entrenadores están a su disposición para escuchar sus necesidades y ofrecerle una supervisión óptima y sin riesgos. Tanto si es principiante como si ya tiene experiencia, ellos le acompañarán y guiarán."
    ]
  },
