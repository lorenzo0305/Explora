  "rdfs:comment": {
    "de": [
      "Diese etwa 15 km lange Strecke liegt in einer angenehmen landschaftlichen Umgebung und bietet einen Bestand an wilden Bachforellen in respektablen Größen. Fänge von 35 bis 40 cm und darüber hinaus sind keine Seltenheit."
    ],
    "en": [
      "This 15-kilometre stretch, set in pleasantly landscaped grounds, boasts a respectable population of wild fario trout. Catches of 35 to 40 cm and over are frequent."
    ],
    "it": [
      "Questo tratto di fiume di 15 chilometri, immerso in un piacevole paesaggio, vanta una popolazione di trote fario selvatiche di dimensioni rispettabili. Sono frequenti le catture di taglia compresa tra i 35 e i 40 cm e oltre."
    ],
    "fr": [
      "Ce parcours d'environ 15 kilomètres, situé dans un cadre paysagé agréable, offre une population de truites fario sauvages de tailles respectables. Des prises de 35 à 40 cm et au-delà sont fréquentes."
    ],
    "es": [
      "Este tramo de río de 15 kilómetros, situado en un agradable paisaje, cuenta con una población de truchas fario salvajes de tamaño respetable. Son frecuentes las capturas de 35 a 40 cm o más."
    ],
    "nl": [
      "Dit 15 kilometer lange stuk rivier, omgeven door een mooi landschap, heeft een populatie wilde fario-forellen van respectabele grootte. Vangsten van 35 tot 40 cm en groter zijn gebruikelijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche sans tuer : L'Ardèche amont"
    ]
  },
