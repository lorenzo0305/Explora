  "rdfs:comment": {
    "de": [
      "Der Arvan ist nur oberhalb von Saint-Sorlin-d'Arves und in einigen Nebenflüssen interessant. Als Forellenfluss ist sein Wasser aufgrund der Geologie der Hänge (Schiefer) von Natur aus sehr stark belastet."
    ],
    "en": [
      "The Arvan is only interesting upstream of Saint-Sorlin-d'Arves and in some tributaries. River with trout, its waters are naturally very loaded because of the geology of the slopes (schists)."
    ],
    "it": [
      "L'Arvan è interessante solo a monte di Saint-Sorlin-d'Arves e in alcuni affluenti. Fiume da trota, le sue acque sono naturalmente molto ricche grazie alla geologia dei pendii (scisti)."
    ],
    "fr": [
      "L'Arvan n'est intéressant qu'en amont de Saint-Sorlin-d'Arves et dans certains affluents. Rivière à truite, ses eaux sont naturellement très chargées à cause de la géologie des versants (schistes)."
    ],
    "es": [
      "El Arvan sólo es interesante aguas arriba de Saint-Sorlin-d'Arves y en algunos afluentes. Río truchero, sus aguas son naturalmente muy ricas debido a la geología de las laderas (esquisto)."
    ],
    "nl": [
      "De Arvan is alleen interessant stroomopwaarts van Saint-Sorlin-d'Arves en in bepaalde zijrivieren. Het water van deze forelrivier is van nature zeer rijk door de geologie van de hellingen (schist)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L’Arvan et ses affluents"
    ]
  },
