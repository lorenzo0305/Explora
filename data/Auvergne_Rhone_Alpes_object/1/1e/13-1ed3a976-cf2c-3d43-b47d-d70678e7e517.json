  "rdfs:comment": {
    "de": [
      "Willkommen im Maison Benoît Vidal, einem Gourmetrestaurant mit 2 Sternen im Guide Michelin 2024. \r\nHier steht der Mensch im Mittelpunkt des Projekts, um Sie zu begleiten.\r\nLeidenschaft und Sensibilität sind das Medium unseres Ausdrucks."
    ],
    "en": [
      "Welcome to Maison Benoît Vidal, a 2-star gourmet restaurant in the 2024 Michelin Guide. \r\nHere, people are at the heart of the project to accompany you.\r\nPassion and sensitivity are the basis of our expression."
    ],
    "it": [
      "Benvenuti alla Maison Benoît Vidal, ristorante gourmet 2 stelle della Guida Michelin 2024.\r\nQui le persone sono al centro del progetto per accompagnarvi.\r\nPassione e sensibilità sono alla base della nostra espressione."
    ],
    "fr": [
      "Bienvenue à la Maison Benoît Vidal, restaurant gastronomique 2 étoiles au Guide Michelin 2024. \r\nIci, l’humain est au cœur du projet pour vous accompagner.\r\nPassion et sensibilité sont le support de notre expression."
    ],
    "nl": [
      "Welkom bij Maison Benoît Vidal, een 2-sterren gastronomisch restaurant in de Michelingids 2024.\r\nHier staan mensen centraal om u te begeleiden.\r\nPassie en gevoeligheid vormen de basis van onze expressie."
    ],
    "es": [
      "Bienvenido a la Maison Benoît Vidal, restaurante gastronómico de 2 estrellas en la Guía Michelin 2024.\r\nAquí, las personas están en el corazón del proyecto para acompañarle.\r\nLa pasión y la sensibilidad son la base de nuestra expresión."
    ]
  },
