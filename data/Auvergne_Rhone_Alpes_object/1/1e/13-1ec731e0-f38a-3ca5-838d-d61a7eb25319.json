  "rdfs:comment": {
    "de": [
      "Restaurant auf dem denkmalgeschützten Kalvarienberg, 10 Gehminuten von der Freiluft-Eisbahn entfernt. Panoramaterrasse im Sommer und Winter.\r\nRaffinierte, traditionelle und savoyische Küche: Fondues, heiße Boxen, Raclette, Fleischauswahl. Hausgemachte Desserts."
    ],
    "en": [
      "Restaurant located on the Calvary conservation site, only 10 minutes by foot from the outside ice ring. Panoramic terrace in summer and in winter. Traditionnal and Savoyard cuisine : Fondues, Boîte chaude, Raclette, large choice of meats. Home-made desserts."
    ],
    "it": [
      "Ristorante ubicato nel noto sito del Calvario, a 10 minuti di cammino dal centro del villaggio. Terrazza panoramica d'estate e in inverno.\r\nCucina raffinata, tradizionale e savoiarda: fonduta, bevande calde, raclette, selezione di carni. Dolci della casa."
    ],
    "fr": [
      "Restaurant situé sur le site classé du Calvaire à 10 min à pied de la patinoire de plein air. Terrasse panoramique été comme hiver.\r\nCuisine raffinée, traditionnelle et savoyarde : fondues, boîtes chaudes, raclettes, sélection de viandes. Desserts maison."
    ],
    "es": [
      "Restaurante situado en el recinto protegido del Calvaire, a 10 minutos a pie de la pista de patinaje al aire libre. Terraza panorámica en verano e invierno.\r\nCocina refinada, tradicional y saboyana: fondues, cajas calientes, raclettes, selección de carnes. Postres caseros."
    ],
    "nl": [
      "Restaurant gelegen op de geklasseerde site van de Calvaire, op 10 minuten wandelen van de openluchtschaatsbaan. Panoramisch terras in zomer en winter.\r\nVerfijnde, traditionele en Savoyaardse keuken: fondues, warmhoudbakken, raclettes, selectie van vleeswaren. Zelfgemaakte desserts."
    ]
  },
