  "rdfs:comment": {
    "de": [
      "Das Restaurant Chez Marie in Plagne Centre empfängt Sie in einem gemütlichen Rahmen. Sowohl mittags als auch abends bietet das Restaurant neben Crêpes und Galettes eine schöne Vielfalt an Savoyer Spezialitäten."
    ],
    "en": [
      "The Chez Marie restaurant, la Plagne Centre bids you a warm welcome. For lunch and dinner, the restaurant offers a wide range of Savoyard specialities in addition to its crêpes and galettes."
    ],
    "it": [
      "Il ristorante Chez Marie di Plagne Centre offre un'accoglienza calorosa. A pranzo e a cena, il ristorante propone un'ampia gamma di specialità savoiarde oltre alle sue crêpes e galettes."
    ],
    "fr": [
      "Le restaurant Chez Marie, à Plagne Centre, vous accueille dans un cadre chaleureux. Le midi comme le soir, le restaurant propose en plus des crêpes et galettes une belle diversité de spécialités savoyardes."
    ],
    "nl": [
      "Het restaurant Chez Marie in Plagne Centre biedt een warm welkom. Voor lunch en diner biedt het restaurant een breed scala aan Savoyaardse specialiteiten, naast de crêpes en galettes."
    ],
    "es": [
      "El restaurante Chez Marie de Plagne Centre le ofrece una cálida bienvenida. Para el almuerzo y la cena, el restaurante ofrece una amplia gama de especialidades de Saboya, además de sus crepes y galettes."
    ]
  },
