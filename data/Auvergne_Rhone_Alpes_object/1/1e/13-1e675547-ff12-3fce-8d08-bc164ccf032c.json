  "rdfs:comment": {
    "de": [
      "Der Bois des Lutins ist ein Naturfreizeitpark für die ganze Familie. auf 10 Hektar werden Spiele und ungewöhnliche Entdeckungen für alle Wichtel von 2 bis 102 Jahren angeboten. Folgen Sie den Elfenforschern auf der Suche nach den Spuren des kleinen Volkes (Troll, Fee?)!"
    ],
    "en": [
      "Le Bois des Lutins is a nature park for the whole family. 10 hectares of games and unusual discoveries are on offer for all elves aged 2 to 102. Follow the elficologists in search of traces of the Little People (trolls, fairies, etc.)!"
    ],
    "it": [
      "Le Bois des Lutins è un parco naturale per il tempo libero per tutta la famiglia. 10 ettari di giochi e scoperte insolite per tutti gli elfi dai 2 ai 102 anni. Seguite gli elfologi alla ricerca delle tracce del Piccolo Popolo (troll, fate, ecc.)!"
    ],
    "fr": [
      "Le Bois des Lutins est un parc de loisirs nature pour toute la famille. 10 hectares de jeux et de découvertes insolites sont proposées pour tous les lutins de 2 à 102 ans. Suivez les elficologues à la recherche des traces du Petit peuple (troll, fée…) !"
    ],
    "nl": [
      "Le Bois des Lutins is een natuur- en recreatiepark voor het hele gezin. 10 hectare spelen en ongewone ontdekkingen voor alle elfen van 2 tot 102 jaar. Volg de elfenologen op zoek naar sporen van het Kleine Volk (trollen, feeën...)!"
    ],
    "es": [
      "Le Bois des Lutins es un parque de ocio natural para toda la familia. 10 hectáreas de juegos y descubrimientos insólitos para todos los elfos de 2 a 102 años. Siga a los elficólogos en busca de rastros de la Gente Pequeña (trolls, hadas, etc.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bois des Lutins"
    ]
  },
