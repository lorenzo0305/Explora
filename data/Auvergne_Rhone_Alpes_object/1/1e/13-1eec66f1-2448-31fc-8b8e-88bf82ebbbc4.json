  "rdfs:comment": {
    "de": [
      "Patafan - Höhenrestaurant (1954m)\r\n\r\nMit Blick auf den Mont Blanc bietet das Le Patafan eine einfache Küche, die um frische Produkte aus kurzen Transportwegen herum konzipiert ist.\r\nEine kurze Speisekarte, ausgewogene und schmackhafte Rezepte, ein grandioses Panorama."
    ],
    "en": [
      "Le Patafan - High altitude restaurant (1954m)\r\n\r\nFacing Mont Blanc, Le Patafan offers simple cuisine based on fresh, local produce.\r\nA short menu, well-balanced, tasty recipes and a breathtaking panorama."
    ],
    "it": [
      "Le Patafan - Ristorante d'alta quota (1954 m)\r\n\r\nDi fronte al Monte Bianco, Le Patafan offre una cucina semplice basata su prodotti freschi di provenienza locale.\r\nUn menu breve, ricette equilibrate e gustose e un panorama mozzafiato."
    ],
    "fr": [
      "Le Patafan - Restaurant d'altitude (1954m)\r\n\r\nFace au Mont Blanc, le Patafan propose une cuisine simple, pensée autour de produits frais en circuit court.\r\nUne carte courte, des recettes équilibrées et savoureuses, un panorama grandiose."
    ],
    "es": [
      "Le Patafan - Restaurante de altura (1954 m)\r\n\r\nFrente al Mont Blanc, Le Patafan ofrece una cocina sencilla basada en productos frescos de proximidad.\r\nUn menú corto, recetas equilibradas y sabrosas y un panorama impresionante."
    ],
    "nl": [
      "Le Patafan - Restaurant op grote hoogte (1954m)\r\n\r\nLe Patafan kijkt uit op de Mont Blanc en biedt een eenvoudige keuken op basis van verse producten uit de streek.\r\nEen kort menu, evenwichtige, smakelijke recepten en een adembenemend panorama."
    ]
  },
