  "rdfs:comment": {
    "de": [
      "Bik'Assist bietet Ihnen seine Dienste für die Reparatur, Wartung und Montage Ihrer Fahrräder (Stadt-, Straßen-, Mountainbikes, VAE), aller Marken und aller Praktiken an. Eine feste Werkstatt in St Etienne de Crossey und eine mobile Werkstatt stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Bik'Assist offers you its services for the repair, maintenance and assembly of your bicycles (urban, road, mountain bikes, VAE), of all makes and in all styles. A fixed workshop in St Etienne de Crossey and a mobile workshop are at your disposal."
    ],
    "it": [
      "Bik'Assist vi offre i suoi servizi per la riparazione, la manutenzione e il montaggio delle vostre biciclette (urbane, da strada, mountain bike, VAE), di tutte le marche e di tutti gli stili. Un'officina fissa a St Etienne de Crossey e un'officina mobile sono a vostra disposizione."
    ],
    "fr": [
      "Bik'Assist vous propose ses services pour la réparation, l'entretien et le montage de vos vélos (urbains, route, VTT, VAE), toutes marques et toutes pratiques. Un atelier fixe situé à St Etienne de Crossey et un atelier mobile sont à votre disposition."
    ],
    "es": [
      "Bik'Assist le ofrece sus servicios para la reparación, el mantenimiento y el montaje de sus bicicletas (urbanas, de carretera, de montaña, VAE), de todas las marcas y de todos los estilos. Un taller fijo en St Etienne de Crossey y un taller móvil están a su disposición."
    ],
    "nl": [
      "Bik'Assist biedt u zijn diensten aan voor de reparatie, het onderhoud en de montage van uw fietsen (stadsfietsen, racefietsen, mountainbikes, VAE), van alle merken en in alle stijlen. Een vaste werkplaats in St Etienne de Crossey en een mobiele werkplaats staan tot je beschikking."
    ]
  },
