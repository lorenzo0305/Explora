  "rdfs:comment": {
    "de": [
      "Ich entwerfe Originalstücke: Taschen, Gürtel, Kinderschuhe und verschiedene Accessoires (Geldbeutel, Gitarrengurt, Plektrumhalter...) Ich organisiere Workshops für Clubs, Gruppen, Vereine, Privatpersonen auf Anfrage..."
    ],
    "en": [
      "I create original pieces: bags, belts, children's slippers and various accessories (wallets, guitar straps, plectrum holders...) I organise courses for clubs, groups, associations, individuals on request..."
    ],
    "it": [
      "Creo pezzi originali: borse, cinture, pantofole per bambini e accessori vari (borsetta, tracolla per chitarra, porta plettro...) Organizzo laboratori per club, gruppi, associazioni, singoli su richiesta..."
    ],
    "fr": [
      "Je crée des pièces originales : sacs, ceintures, chaussons enfants et divers accessoires (porte monnaie, sangle guitare, porte médiators...)  J'organise  des stages pour des clubs, groupes, associations, particuliers à la demande..."
    ],
    "nl": [
      "Ik maak originele stukken: tassen, riemen, kinderpantoffels en diverse accessoires (handtas, gitaarriem, plectrumhouder...) Ik organiseer workshops voor clubs, groepen, verenigingen, individuen op aanvraag..."
    ],
    "es": [
      "Creo piezas originales: bolsos, cinturones, zapatillas para niños y accesorios varios (bolso, correa de guitarra, portapúas...) Organizo talleres para clubes, grupos, asociaciones, particulares a petición..."
    ]
  },
