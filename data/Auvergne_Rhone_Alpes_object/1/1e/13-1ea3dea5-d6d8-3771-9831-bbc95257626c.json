  "rdfs:comment": {
    "de": [
      "Unsere autonome Residenz bietet hochwertige Wohnungen T1 BIS und T2 von 33 m² bis 45m² ab 1434€ inklusive aller Nebenkosten (Heizung, Wasser, Strom, Telefon und Internet, Teleassistenz)."
    ],
    "en": [
      "Our new facility offers accommodation of great qualities bis T1 and T2 from 33 m² to 45 m² from € 1434 all charges included (heating, water, electricity, telephone and internet hotline)"
    ],
    "it": [
      "Il nostro residence indipendente offre appartamenti T1 BIS e T2 di alta qualità da 33m² a 45m² a partire da 1.434 euro, comprensivi di tutte le spese (riscaldamento, acqua, elettricità, telefono e internet, teleassistenza)"
    ],
    "fr": [
      "Notre Résidence autonomie propose des logements de grande qualité T1 BIS et T2 de 33 m² à 45m² à partir de 1434€ toutes charges comprises (chauffage, eau, électricité, téléphone et internet, téléassistance)"
    ],
    "nl": [
      "Onze onafhankelijke residentie biedt hoogwaardige T1 BIS en T2 appartementen van 33m² tot 45m² vanaf €1434 inclusief alle nutsvoorzieningen (verwarming, water, elektriciteit, telefoon en internet, hulp op afstand)."
    ],
    "es": [
      "Nuestra residencia independiente ofrece pisos de alta calidad T1 BIS y T2 de 33m² a 45m² a partir de 1.434 euros con todos los gastos incluidos (calefacción, agua, electricidad, teléfono e internet, teleasistencia)"
    ]
