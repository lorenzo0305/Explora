  "rdfs:comment": {
    "de": [
      "Die Chevelu-Seen sind zwei kleine Oasen der Ruhe unterhalb der Dent du Chat, wo Sie auf den eigens für das Angeln eingerichteten Pontons neue Kraft tanken können."
    ],
    "en": [
      "The Chevelu lakes are now each equipped with 2 fishing pontoons, one of which is accessible to people with reduced mobility. The equipment benefit from the \"Family\" label.h"
    ],
    "it": [
      "I laghi di Chevelu sono due piccoli paradisi di pace incastonati sotto la Dent du Chat, dove potete venire a fare il pieno di energia sui pontili da pesca appositamente progettati."
    ],
    "fr": [
      "Les lacs de Chevelu sont deux petits havres de paix nichés sous la Dent du Chat où vous pourrez venir vous ressourcer sur les pontons aménagés spécialement pour la pêche."
    ],
    "es": [
      "Los lagos de Chevelu son dos pequeños remansos de paz situados bajo el Dent du Chat, donde podrá venir a reponer fuerzas en los pontones de pesca especialmente diseñados."
    ],
    "nl": [
      "De meren van Chevelu hebben nu het label \"Family\" visroute gekregen en zijn elk uitgerust met 2 vispontons, waarvan er 1 toegankelijk is voor mensen met een beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Family\" fishing route at the Saint-Jean de chevelu lakes."
    ],
    "fr": [
      "Parcours de pêche \"Famille\" des lacs de St-Jean-de-Chevelu"
    ],
    "nl": [
      "Met het gezin vissen op de meren van St-Jean-de-Chevelu"
    ]
  },
