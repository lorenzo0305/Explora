  "rdfs:comment": {
    "de": [
      "Nachdem Sie um die Werke von Fanny Ducassé herumgeschlendert sind, lassen Sie sich von der Welt der Illustratorin und ihren Blumenmotiven leiten."
    ],
    "en": [
      "After having strolled around the works of Fanny Ducassé, let yourself be guided by the universe of the illustrator and her floral motifs."
    ],
    "it": [
      "Dopo aver girovagato tra le opere di Fanny Ducassé, lasciatevi guidare dal mondo dell'illustratrice e dai suoi motivi floreali."
    ],
    "fr": [
      "Après avoir déambulé autour des œuvres de Fanny Ducassé, laissez-vous guider par l’univers de l’illustratrice et ses motifs floraux."
    ],
    "nl": [
      "Laat je na een wandeling langs de werken van Fanny Ducassé leiden door de wereld van de illustratrice en haar bloemmotieven."
    ],
    "es": [
      "Después de pasear por las obras de Fanny Ducassé, déjese llevar por el universo de la ilustradora y sus motivos florales."
    ]
  },
