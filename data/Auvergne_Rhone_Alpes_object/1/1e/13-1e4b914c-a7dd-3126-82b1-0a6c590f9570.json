  "rdfs:comment": {
    "de": [
      "1,3 ha großer, kommunaler Teich, der zum Angeln reserviert ist, in der Nähe des Dorfes Fontbonne in Saint-Pardoux. \r\nEine Oase der Ruhe für Angel- und Naturliebhaber...\r\nDas Angeln wird hier in privater Regie vom Verein „L'étang des Cayers“ verwaltet."
    ],
    "en": [
      "1,3 ha communal fishing pond, close to the village of Fontbonne in Saint-Pardoux. \r\nA haven of peace for fishing and nature lovers...\r\nFishing is managed privately by the ‘L'étang des Cayers’ association."
    ],
    "it": [
      "Stagno di pesca comunale di 1,3 ettari vicino al villaggio di Fontbonne a Saint-Pardoux.\r\nUn'oasi di pace per gli amanti della pesca e della natura?\r\nLa pesca è gestita privatamente dall'associazione \"L'étang des Cayers\"."
    ],
    "fr": [
      "Étang communal d'1,3 ha réservé à la pêche, proche du village de Fontbonne à Saint-Pardoux. \r\nUn havre de paix pour les amoureux de la pêche et de la nature…\r\nLa pêche y est gérée en gestion privée par l'association \"L'étang des Cayers\"."
    ],
    "es": [
      "Un estanque de pesca comunal de 1,3 ha cerca del pueblo de Fontbonne en Saint-Pardoux.\r\nUn remanso de paz para los amantes de la pesca y la naturaleza?\r\nLa pesca está gestionada de forma privada por la asociación \"L'étang des Cayers\"."
    ],
    "nl": [
      "Een gemeenschappelijke visvijver van 1,3 ha vlakbij het dorpje Fontbonne in Saint-Pardoux.\r\nEen oase van rust voor vissers en natuurliefhebbers?\r\nDe visvangst wordt privé beheerd door de vereniging \"L'étang des Cayers\"."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelplatz - Étang des Cayers"
    ],
    "en": [
      "Fishing site - Étang des Cayers"
    ],
    "fr": [
      "Site de Pêche - Étang des Cayers"
    ]
  },
