  "rdfs:comment": {
    "de": [
      "Kapelle, die 1632 auf einem Massengrab für Pestkranke errichtet wurde. Sie wurde in den 1970er Jahren renoviert und enthält ein 8 m x 2 m großes Fresko, das die Pestepidemien darstellt, die Lyon und das Beaujolais im 17."
    ],
    "en": [
      "Chapel built in 1632 over a mass grave of plague victims. Renovated in the 1970s, it features an 8 m x 2 m fresco depicting the plague epidemics that devastated the Lyonnais and Beaujolais regions in the 17th century."
    ],
    "it": [
      "Questa cappella fu costruita nel 1632 su una fossa comune di vittime della peste. Ristrutturata negli anni '70, presenta un affresco di 8 m x 2 m che raffigura le epidemie di peste che devastarono le regioni del Lyonnais e del Beaujolais nel XVII secolo."
    ],
    "fr": [
      "Chapelle construite en 1632 sur une fosse commune de pestiférés. Rénovée dans les années 1970, elle comporte une fresque de 8 m x 2 m retraçant les épidémies de peste ayant dévastées le Lyonnais et le Beaujolais au XVIIème siècle."
    ],
    "es": [
      "Esta capilla fue construida en 1632 sobre una fosa común de víctimas de la peste. Renovada en la década de 1970, presenta un fresco de 8 m x 2 m que representa las epidemias de peste que asolaron las regiones de Lyonnais y Beaujolais en el siglo XVII."
    ],
    "nl": [
      "Deze kapel werd in 1632 gebouwd op een massagraf van pestslachtoffers. Het werd gerenoveerd in de jaren 1970 en heeft een fresco van 8 m x 2 m dat de pestepidemieën uitbeeldt die de Lyonnais en de Beaujolais in de 17e eeuw verwoestten."
    ]
  },
