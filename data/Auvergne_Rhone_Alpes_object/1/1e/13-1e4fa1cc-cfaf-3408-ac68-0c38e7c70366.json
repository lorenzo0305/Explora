  "rdfs:comment": {
    "de": [
      "Malfroy : seit 1939 ein Synonym für Seidenware der Extraklasse. Die Seidentücher von Malfroy erzählen eine farbenfrohe Geschichte. Lebhaft, extravagant und strahlend beleben sie die Stoffe mit figurativen, poetischen und originellen Motiven."
    ],
    "en": [
      "Malfroy: a silk house of excellence since 1939. Malfroy silk scarves tell a colourful story. Vivid, flamboyant and dazzling, these colours bring the materials to life through figurative, poetic and original motifs."
    ],
    "it": [
      "Malfroy: emporio della seta d'eccellenza dal 1939 I foulard di seta Malfroy raccontano una storia colorata. Luminosi, sgargianti e abbaglianti, questi colori danno vita ai materiali attraverso motivi figurativi, poetici e originali."
    ],
    "fr": [
      "Malfroy : maison de soierie d'excellence depuis 1939. Les foulards en soie Malfroy racontent une histoire haute en couleurs. Vives, flamboyantes, éclatantes, celles-ci animent les matières à travers des motifs figuratifs, poétiques et originaux."
    ],
    "nl": [
      "Malfroy: een zijdehuis van topkwaliteit sinds 1939. De zijden sjaals van Malfroy vertellen een kleurrijk verhaal. Levendig, flamboyant en oogverblindend brengen deze kleuren de materialen tot leven door middel van figuratieve, poëtische en originele motieven."
    ],
    "es": [
      "Malfroy : casa de seda de excelencia desde 1939. Los pañuelos de seda Malfroy cuentan una historia llena de color. Vivos, llamativos y brillantes, dan vida a los tejidos a través de motivos figurativos, poéticos y originales."
    ]
  },
