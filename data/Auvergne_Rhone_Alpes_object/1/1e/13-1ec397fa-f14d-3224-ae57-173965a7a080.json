  "rdfs:comment": {
    "de": [
      "Kleines Kino im Herzen des Dorfes, in Verbindung mit dem Maison de l'Image in Aubenas.\r\nVorführungen von September bis Juni: \"Junges Publikum\", \"Ciné-goûter\", \"Ciné-apéro\" / \"Ciné-brunch\", \"Überraschung in der Vorpremiere\", Festivals, ...\r\nWir erwarten Sie zahlreich!"
    ],
    "en": [
      "A small cinema in the heart of the village, in partnership with the  Maison de l’Image d’Aubenas.\r\nScreenings from September to June: \"Young Audiences,\" \"Snack Film,\" \"Aperitif Film\" / \"Brunch Film,\" \"Surprise Previews,\" Festivals, and more... \r\nWe look forward to seeing you there!"
    ],
    "it": [
      "Piccolo cinema nel cuore del villaggio, in associazione con la Maison de l'Image d'Aubenas.\r\nProiezioni da settembre a giugno: \"Young Audiences\", \"Ciné-goûter\", \"Ciné-apéro\" / \"Ciné-brunch\", \"anteprime a sorpresa\", Festival,...\r\nNon vediamo l'ora di incontrarvi!"
    ],
    "fr": [
      "Petit cinéma au cœur du village, en lien avec la Maison de l’Image d’Aubenas.\r\nDes séances de septembre à juin \"Jeune public », « ciné-goûter »,  « ciné-apéro » / « ciné-brunch »,  « surprise en avant-première », Festivals,...\r\nOn vous attend  nombreux !"
    ],
    "es": [
      "Pequeño cine en el corazón del pueblo, en asociación con la Maison de l'Image d'Aubenas.\r\nProyecciones de septiembre a junio: \"Público joven\", \"Ciné-goûter\", \"Ciné-apéro\" / \"Ciné-brunch\", \"preestrenos sorpresa\", Festivales,...\r\n¡Le esperamos!"
    ],
    "nl": [
      "Kleine bioscoop in het hart van het dorp, in samenwerking met het Maison de l'Image d'Aubenas.\r\nVertoningen van september tot juni: \"Young Audiences\", \"Ciné-goûter\", \"Ciné-apéro\" / \"Ciné-brunch\", \"surprise previews\", Festivals,...\r\nWe kijken ernaar uit je daar te zien!"
    ]
  },
