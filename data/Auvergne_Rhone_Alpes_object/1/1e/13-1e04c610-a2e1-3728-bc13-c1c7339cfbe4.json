  "rdfs:comment": {
    "de": [
      "Als gelernte Krankenschwester und zertifizierte Reflexologin biete ich verschiedene Behandlungen (Fuß-, Hand- und Rückenreflexzonenmassage und Sitzmassage) im ganzen Land des Mont Blanc an. Ein echter Moment des Wohlbefindens bei Ihnen zu Hause."
    ],
    "en": [
      "Nurse by profession and certified reflexologist, I offer a range of treatments (foot, palm and back reflexology and seated massage) throughout the Mont Blanc region. A real moment of well-being in your own home."
    ],
    "it": [
      "Infermiera di professione e riflessologa diplomata, offro una gamma di trattamenti di riflessologia e massaggio in tutta la regione del Monte Bianco. Un vero momento di benessere a casa vostra."
    ],
    "fr": [
      "Infirmière de métier et Réflexologue certifiée, je propose différents soins de réflexologie et de massages dans tout le pays du mont blanc. Un véritable moment de bien-être à votre domicile."
    ],
    "nl": [
      "Ik ben verpleegster van beroep en gediplomeerd reflexoloog. Ik bied een scala aan reflexologie- en massagebehandelingen in het hele Mont Blanc-gebied. Een echt moment van welzijn bij je thuis."
    ],
    "es": [
      "Enfermera de profesión y reflexóloga diplomada, ofrezco una gama de tratamientos de reflexología y masaje en toda la región del Mont-Blanc. Un verdadero momento de bienestar en su propia casa."
    ]
  },
