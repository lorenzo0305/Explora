  "rdfs:comment": {
    "de": [
      "Das Kulturzentrum von Fontlozier bietet Ihnen Treffen an, die für alle offen sind, ob neugierig oder leidenschaftlich, groß oder klein, um mit der Natur zum Thema Gewürze in Verbindung zu treten... in aller Einfachheit."
    ],
    "en": [
      "The Fontlozier cultural center offers a series of gatherings open to all, whether curious or passionate, young or old, to reconnect with nature on the theme of spices... in all simplicity."
    ],
    "it": [
      "Il centro culturale Fontlozier propone una serie di eventi aperti a tutti, curiosi o appassionati, giovani o anziani, per riconnettersi con la natura sul tema delle spezie... in tutta semplicità."
    ],
    "fr": [
      "Le centre culturel de Fontlozier vous propose des rendez-vous ouverts à toutes et à tous, curieux ou passionnés, petits ou grands, pour renouer avec la nature sur le thème des épices.… en toute simplicité."
    ],
    "nl": [
      "Het cultureel centrum Fontlozier biedt een reeks evenementen die voor iedereen toegankelijk zijn, of je nu nieuwsgierig of gepassioneerd bent, jong of oud, om opnieuw in contact te komen met de natuur rond het thema kruiden... in alle eenvoud."
    ],
    "es": [
      "El centro cultural Fontlozier propone una serie de actos abiertos a todos, curiosos o apasionados, jóvenes o mayores, para reencontrarse con la naturaleza en torno al tema de las especias... con toda sencillez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier sur les épices à Fontlozier"
    ]
  },
