  "rdfs:comment": {
    "de": [
      "Im Rathaus (Hôtel de Ville), das sich am Place Jules Nadi befindet, sind die meisten Dienststellen der Stadtverwaltung untergebracht.\r\nMairie [+], rue Bozambo: zentrale Anlaufstelle für alle Einwohner von Romanais."
    ],
    "en": [
      "The Town Hall, located in Place Jules Nadi, houses most of the local authority's departments.\r\nMairie [+], rue Bozambo: a single point of contact for all Roman citizens."
    ],
    "it": [
      "Il municipio, situato in Place Jules Nadi, ospita la maggior parte dei dipartimenti del comune.\r\nMairie [+], rue Bozambo: uno sportello unico per gli abitanti di Roma."
    ],
    "fr": [
      "L’Hôtel de Ville, situé place Jules Nadi, regroupe la majorité des services de la collectivité. \r\nMairie [+], rue Bozambo : point d’accueil unique pour tous les Romanais."
    ],
    "nl": [
      "In het stadhuis op de Place Jules Nadi zijn de meeste afdelingen van de gemeente gehuisvest.\r\nMairie [+], rue Bozambo: één loket voor de inwoners van Rome."
    ],
    "es": [
      "El Ayuntamiento, situado en la plaza Jules Nadi, alberga la mayoría de los servicios municipales.\r\nMairie [+], rue Bozambo: una ventanilla única para los residentes romanos."
    ]
  },
