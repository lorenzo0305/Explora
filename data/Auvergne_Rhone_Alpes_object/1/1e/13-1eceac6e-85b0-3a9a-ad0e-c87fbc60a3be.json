  "rdfs:comment": {
    "de": [
      "Pizzas aus eigener Herstellung. Verkauf zum Mitnehmen.\r\nSpezialität: \"La Combraille\" mit Tomatensoße, Oliven, Kartoffeln, Zwiebeln, Saint-Nectaire, Schinken aus der Region."
    ],
    "en": [
      "Homemade pizzas. Takeaway. Open 7d / 7 noon and evening. All information on the website and facebook page (c)."
    ],
    "it": [
      "Pizze fatte in casa. Vendita da asporto.\r\nSpecialità: \"La Combraille\" con salsa di pomodoro, olive, patate, cipolle, formaggio Saint-Nectaire e prosciutto locale."
    ],
    "fr": [
      "Pizzas artisanales. Vente à emporter. \r\nSpécialité : \"La Combraille\" avec sauce tomate, olives, pommes de terre, oignon, saint-nectaire, jambon de Pays."
    ],
    "nl": [
      "Zelfgemaakte pizza's. Verkoop van afhaalmaaltijden.\r\nSpecialiteit: \"La Combraille\" met tomatensaus, olijven, aardappelen, uien, Saint-Nectaire kaas en lokale ham."
    ],
    "es": [
      "Pizzas caseras. Venta para llevar.\r\nEspecialidad: \"La Combraille\" con salsa de tomate, aceitunas, patatas, cebollas, queso Saint-Nectaire y jamón local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Kiosque à Pizzas Gannat"
    ]
  },
