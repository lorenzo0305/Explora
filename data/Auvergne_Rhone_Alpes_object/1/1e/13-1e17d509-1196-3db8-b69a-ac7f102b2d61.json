  "rdfs:comment": {
    "de": [
      "RESTAURANT/Bier-PUB (11 Biere vom Fass und mehr als 50 Flaschenbiere), Cocktailbar, große Auswahl an Whisky, Rum & Wodka, Gin, Tapas, Aperitif-Bretter, ARTISANALE PIZZAS, gemütliches und warmes Ambiente."
    ],
    "en": [
      "RESTAURANT/PUB with beers (11 draught beers and over 50 bottled beers), cocktail bar, wide choice of whisky, rum & vodka, tapas, aperitif platters, ARTISANAL PIZZAS, \r\nCosy, warm atmosphere."
    ],
    "it": [
      "RISTORANTE/PUB con birre (11 birre alla spina e oltre 50 birre in bottiglia), cocktail bar, ampia scelta di whisky, rum e vodka, gin, tapas, aperitivi, CRAFT PIZZAS, atmosfera accogliente e calda."
    ],
    "fr": [
      "RESTAURANT/PUB à bières (11 bières à la pression et plus de 50 bières en bouteilles), bar à cocktails, grand choix de whisky, rhum & vodka, gin, tapas, planches apéro, PIZZAS ARTISANALES, Ambiance cosy et chaleureuse."
    ],
    "es": [
      "RESTAURANTE/PUB con cervezas (11 cervezas de barril y más de 50 cervezas embotelladas), bar de cócteles, amplia selección de whisky, ron y vodka, ginebra, tapas, platos de aperitivo, PIZZAS ARTESANALES, ambiente acogedor y cálido."
    ],
    "nl": [
      "RESTAURANT/PUB met bieren (11 tapbieren en meer dan 50 flessenbieren), cocktailbar, ruime keuze aan whisky, rum & wodka, tapas, aperitiefschotels, ARTISANAL PIZZAS, BURGERS.\r\nGezellige, warme sfeer."
    ]
  },
