  "rdfs:comment": {
    "de": [
      "Intersport Auris\r\nNr. 1 des Online-Skiverleihs\r\n\r\nEine große Auswahl an Skimaterial zum Verkauf und Verleih + professionelle Beratung = pures Vergnügen auf den Pisten in aller Sicherheit!"
    ],
    "en": [
      "True lovers of mountaineering and snow sports, the Intersport team is at your service during the winter season and also in summer. \r\nYou are sure to find the ski or mountain equipment you need."
    ],
    "it": [
      "Intersport Auris\r\nN°1 del noleggio sci online\r\n\r\nUn'ampia gamma di attrezzature per gli sport invernali in vendita o a noleggio + consulenza professionale = puro piacere sulle piste in tutta sicurezza!"
    ],
    "fr": [
      "Intersport Auris\r\nN°1 de la location de ski en ligne \r\n\r\nUne large gamme de matériel de glisse à la vente comme à la location + des conseils de professionnels = du pur plaisir sur les pistes en toute sécurité !"
    ],
    "es": [
      "Intersport Auris\r\nN°1 en alquiler de esquís en línea\r\n\r\nUna amplia gama de material de deportes de invierno en venta o alquiler + asesoramiento profesional = ¡puro placer en las pistas con total seguridad!"
    ],
    "nl": [
      "Echte liefhebbers van bergbeklimmen en sneeuwsporten, het Intersport team staat tot uw dienst tijdens het winterseizoen en ook in de zomer. \r\nU vindt er zeker de ski- of berguitrusting die u nodig hebt."
    ]
  },
