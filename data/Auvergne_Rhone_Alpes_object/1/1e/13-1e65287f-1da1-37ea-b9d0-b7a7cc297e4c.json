  "rdfs:comment": {
    "de": [
      "Die Gastgeber des Restaurants La Zaccota empfangen ihre Gäste mit einer solchen Einfachheit und Freundlichkeit, dass man sich schon bei der Ankunft wie zu Hause fühlt."
    ],
    "en": [
      "The welcome you get from the owners of La Zaccota restaurant is so simple and kind that you will feel at home as soon as you step through the door."
    ],
    "it": [
      "L'accoglienza dei padroni di casa del ristorante La Zaccota è così semplice e cordiale che ci si sente a casa appena arrivati."
    ],
    "fr": [
      "L’accueil des hôtes du restaurant La Zaccota est d’une telle simplicité et d’une telle gentillesse que, dès l’arrivée, on se sent chez soi."
    ],
    "es": [
      "La acogida de los anfitriones del restaurante La Zaccota es tan sencilla y amable que te sientes como en casa nada más llegar."
    ],
    "nl": [
      "Bij restaurant La Zaccota wordt u zo vriendelijk ontvangen dat u zich direct thuis voelt."
    ]
  },
