  "rdfs:comment": {
    "de": [
      "Ein musikalisches Märchen für Kinder von Cécile und Lise Borel, während dessen Sie die Geschichte von Émile, einem kleinen Jungen, entdecken werden, dessen Schularbeit sein Leben verändern wird. kommen Sie zahlreich!"
    ],
    "en": [
      "A musical tale for children by Cécile and Lise Borel, featuring the story of Émile, a little boy whose life is about to be changed by a job at school. Come one, come all!"
    ],
    "it": [
      "Un racconto musicale per bambini di Cécile e Lise Borel, in cui scoprirete la storia di Émile, un ragazzino il cui impegno scolastico cambierà la sua vita. Venite tutti!"
    ],
    "fr": [
      "Un conte musical pour enfants de Cécile et Lise Borel durant lequel vous découvrirez l'histoire d'Émile, un petit garçon dont un travail d'école va changer sa vie. venez nombreux !"
    ],
    "es": [
      "Un cuento musical para niños de Cécile y Lise Borel, en el que descubrirás la historia de Émile, un niño al que sus deberes escolares le cambiarán la vida ¡Vengan todos, vengan todos!"
    ],
    "nl": [
      "Een muzikale vertelling voor kinderen door Cécile en Lise Borel, waarin je het verhaal ontdekt van Emile, een jongetje wiens schoolwerk zijn leven zal veranderen. Komt allen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conte musical : Émile au cinéma"
    ]
  },
