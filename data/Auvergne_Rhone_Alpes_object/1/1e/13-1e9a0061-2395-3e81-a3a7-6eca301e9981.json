  "rdfs:comment": {
    "de": [
      "Das Restaurant le N3, das sich im Erdgeschoss des Célestins Spa Thermal & Hotel***** befindet, wird Ihre Geschmacksknospen während Ihres\r\naufenthalt in Vichy begeistern. Entdecken Sie die subtile Verbindung von traditioneller Küche und modernen kulinarischen Trends."
    ],
    "en": [
      "Restaurant le N3, located on the first floor of the Célestins Spa Thermal & Hôtel*****, will delight your taste buds during your\r\nyour stay in Vichy. Discover the subtle marriage of traditional cuisine and modern culinary trends."
    ],
    "it": [
      "Il ristorante le N3, situato al piano terra del Célestins Spa Thermal & Hotel*****, delizierà il vostro palato durante il vostro soggiorno a Vichy\r\nvostro soggiorno a Vichy. Scoprite il sottile connubio tra cucina tradizionale e tendenze culinarie moderne."
    ],
    "fr": [
      "Le Restaurant le N3, situé au rez-de-chaussée du Célestins Spa Thermal & Hôtel*****, va ravir vos papilles pendant votre\r\nséjour à Vichy. Découvrez le mariage subtil de la cuisine traditionnelle et des tendances culinaires modernes."
    ],
    "nl": [
      "Restaurant le N3, gelegen op de begane grond van het Célestins Spa Thermal & Hotel*****, zal uw smaakpapillen verwennen tijdens uw\r\nuw verblijf in Vichy. Ontdek de subtiele combinatie van traditionele gerechten en moderne culinaire trends."
    ],
    "es": [
      "El Restaurante le N3, situado en la planta baja del Célestins Spa Thermal & Hotel*****, deleitará su paladar durante su\r\nsu estancia en Vichy. Descubra el sutil maridaje entre la cocina tradicional y las tendencias culinarias modernas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot des Célestins"
    ]
  },
