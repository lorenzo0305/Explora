  "rdfs:comment": {
    "de": [
      "Eine attraktive Karte mit Maxi-Teller und Minipreisen. Unsere Spezialitäten? Pizzen, Burger, mexikanische Gerichte, Spieße, Salate, knusprige Pommes frites, Pasta. . . . . Formeln mit Bowling-Spiel. Vor Ort, Spielplatz für Kinder (4 bis 12 Jahre)"
    ],
    "en": [
      "An attractive card with maxi plates and mini prices. Our specialities? Pizzas, burgers, Mexican dishes, skewers, salads, crispy fries, pasta. . . Formulas with bowling game. On site, playground for children (4 to 12 years old)"
    ],
    "it": [
      "Platos Maxi y mini precios. Nuestras especialidades? Pizzas, hamburguesas, platos mexicanos, pinchos, ensaladas, patatas fritas crujientes, pasta. . . . Fórmulas con juego de bolos. En el lugar, parque infantil para niños (de 4 a 12 años)"
    ],
    "fr": [
      "Une carte attractive avec des maxi assiettes et des mini prix. Nos spécialités? Pizzas, burgers, plats mexicains, brochettes, salades, frites croustillantes, pâtes... Formules avec partie de bowling. Sur place, plaine de jeux pour les enfants (4 à 12 ans)"
    ],
    "es": [
      "Un atractivo menú con maxiplatos y miniprecios. ¿Nuestra especialidad? Pizzas, hamburguesas, platos mexicanos, pinchos, ensaladas, patatas fritas crujientes, pasta... Fórmulas con bolos. En el lugar, parque infantil para niños (de 4 a 12 años)"
    ],
    "nl": [
      "Een aantrekkelijke kaart met maxiborden en miniprijzen. Onze specialiteiten? Pizza's, hamburgers, Mexicaanse gerechten, kebab, salades, knapperige frietjes, pasta... Formules met bowling. Ter plaatse, speeltuin voor kinderen (4 tot 12 jaar)"
    ]
  },
