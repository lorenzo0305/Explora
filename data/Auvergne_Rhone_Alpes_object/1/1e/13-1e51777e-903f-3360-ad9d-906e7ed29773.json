  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Parasols verwöhnt Sie vom Frühstück bis zum Abendessen. Mahlzeiten, Snacks, Getränkepausen, Aperitifbretter ... immer mit Aussicht: Fragen Sie nach der Speisekarte!"
    ],
    "en": [
      "The Les Parasols restaurant will delight you from breakfast to dinner. Meals, snacks, drinks, aperitifs... always with a view: ask for the menu!"
    ],
    "it": [
      "Il ristorante Les Parasols vi delizierà dalla colazione alla cena. Pasti, snack, bevande, aperitivi... sempre con vista: chiedete il menu!"
    ],
    "fr": [
      "Le restaurant Les Parasols vous régale du petit-déjeuner au diner. Repas, snacking, pause boissons, planches apéritives … toujours avec vue : demandez le menu !"
    ],
    "nl": [
      "In het restaurant Les Parasols kun je van het ontbijt tot het diner terecht. Maaltijden, snacks, drankjes, aperitieven... altijd met uitzicht: vraag naar het menu!"
    ],
    "es": [
      "El restaurante Les Parasols le deleitará desde el desayuno hasta la cena. Comidas, tentempiés, bebidas, aperitivos... siempre con vistas: ¡pregunte por el menú!"
    ]
  },
