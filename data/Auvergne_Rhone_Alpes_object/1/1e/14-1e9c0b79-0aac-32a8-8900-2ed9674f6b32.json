  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/55e92317-124d-3fcf-82fe-f4dbc8a08d60",
      "dc:description": {
        "de": [
          "Künstlerische Fotografin, die sich auf Hochzeiten, Haustiere und Lifestyle spezialisiert hat. Verliebt in Emotionen, ehrliche Blicke, Lachen und alles, was das Leben schön macht."
        ],
        "en": [
          "Artistic photographer specializing in weddings, pets and lifestyle. In love with emotions, sincere glances, bursts of laughter and everything that makes life beautiful."
        ],
        "it": [
          "Fotografa artistica specializzata in matrimoni, animali domestici e lifestyle. Ama le emozioni, gli sguardi sinceri, le risate e tutto ciò che rende bella la vita."
        ],
        "fr": [
          "Photographe artistique spécialisée dans les mariages, les animaux de compagnie et lifestyle. Amoureuse des émotions, des regards sincères, des éclats de rire et de tout ce qui rend la vie belle."
        ],
        "es": [
          "Fotógrafa artística especializada en bodas, mascotas y estilo de vida. Le encantan las emociones, las miradas sinceras, las carcajadas y todo lo que hace bella la vida."
        ],
        "nl": [
          "Artistiek fotograaf gespecialiseerd in bruiloften, huisdieren en lifestyle. Ze houdt van emoties, oprechte blikken, uitbarstingen van lachen en alles wat het leven mooi maakt."
        ]
      },
