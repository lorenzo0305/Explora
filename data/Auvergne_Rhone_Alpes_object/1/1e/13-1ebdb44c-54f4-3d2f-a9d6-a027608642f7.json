  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Magie der Pflanzen! Anbau von Beerenfrüchten, Destillation von aromatischen Pflanzen und handwerkliche Herstellung von überfettenden Seifen. Hydrolate und ätherische Öle, alles wird vor Ort mit Leidenschaft verarbeitet. Eine Reise ins Herz der Natürlichkeit."
    ],
    "en": [
      "Discover the magic of plants! We grow red berries, distill aromatic plants and make handcrafted superfatted soaps. Hydrolats and essential oils, everything is transformed on site with passion. A journey to the heart of nature."
    ],
    "it": [
      "Scoprite la magia delle piante! Coltivazione di bacche rosse, distillazione di piante aromatiche e produzione di saponi supergrassi fatti a mano. Idrolati e oli essenziali, tutto viene trasformato in loco con passione. Un viaggio nel cuore della natura."
    ],
    "fr": [
      "Découvrez la magie des plantes ! Cultures de fruits rouges, distillation de plantes aromatiques et fabrication artisanale de savons surgras. Hydrolats et huiles essentielles, tout est transformé sur place avec passion. Un voyage au cœur du naturel."
    ],
    "nl": [
      "Ontdek de magie van planten! Rode bessen kweken, aromatische planten destilleren en handgemaakte supervette zepen maken. Hydrolaten en essentiële oliën, alles wordt ter plekke met passie verwerkt. Een reis naar het hart van de natuur."
    ],
    "es": [
      "Descubra la magia de las plantas Cultivo de bayas rojas, destilación de plantas aromáticas y fabricación artesanal de jabones supergrasos. Hidrolatos y aceites esenciales, todo se transforma in situ con pasión. Un viaje al corazón de la naturaleza."
    ]
  },
