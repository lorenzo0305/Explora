  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e57bca51-89d7-376c-8a09-ac913d956e60",
      "dc:description": {
        "de": [
          "Sitzungen: 2. und 4. Donnerstag im Monat\n\nKaritative Aktionen zugunsten von Heimhilfeorganisationen von Heimhilfen, Kampf gegen Blindheit, Armut, Krebs, Behinderungen, humanistische Ansätze...."
        ],
        "en": [
          "Meetings: 2nd and 4th Thursday of the month\n\nCharitable actions in favor of home help associations, fight against blindness, poverty, cancer, handicaps, humanism approaches...."
        ],
        "it": [
          "Riunioni: 2° e 4° giovedì del mese\n\nAzioni di beneficenza a favore di associazioni di assistenza domiciliare, lotta alla cecità, alla povertà, al cancro, agli handicap, approcci umanistici...."
        ],
        "fr": [
          "Réunions : 2ème et 4ème jeudi du mois\n\nActions caritatives en faveur d'associations d'aides à domicile d'aides à domicile, lutte contre la cécité, la pauvreté, le cancer, les handicaps, démarches humanismes...."
        ],
        "es": [
          "Reuniones: 2º y 4º jueves del mes\n\nAcciones benéficas en favor de asociaciones de ayuda a domicilio, lucha contra la ceguera, la pobreza, el cáncer, las minusvalías, enfoques humanistas...."
        ],
        "nl": [
          "Bijeenkomsten: 2e en 4e donderdag van de maand\n\nLiefdadigheidsacties ten behoeve van thuiszorgverenigingen, bestrijding van blindheid, armoede, kanker, handicaps, humanisme benaderingen ...."
        ]
      },
