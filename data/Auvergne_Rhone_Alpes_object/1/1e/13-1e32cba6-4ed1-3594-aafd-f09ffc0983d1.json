  "rdfs:comment": {
    "de": [
      "Fabrice Bonnot, ein leidenschaftlicher und engagierter Küchenchef, lädt Sie in sein gemütliches Restaurant ein, um eine raffinierte und zugängliche Küche zu genießen."
    ],
    "en": [
      "Fabrice Bonnot, a passionate and committed chef, invites you to his friendly restaurant to taste refined and accessible food."
    ],
    "it": [
      "Fabrice Bonnot, chef appassionato e impegnato, vi invita nel suo accogliente ristorante per gustare una cucina raffinata e accessibile."
    ],
    "fr": [
      "Fabrice Bonnot, chef passionné et engagé, vous invite dans son restaurant convivial pour déguster une cuisine raffinée et accessible."
    ],
    "nl": [
      "Fabrice Bonnot, een gepassioneerde en toegewijde chef-kok, nodigt je uit in zijn gezellige restaurant om te genieten van verfijnde, toegankelijke gerechten."
    ],
    "es": [
      "Fabrice Bonnot, chef apasionado y comprometido, le invita a su acogedor restaurante para disfrutar de una cocina refinada y accesible."
    ]
  },
