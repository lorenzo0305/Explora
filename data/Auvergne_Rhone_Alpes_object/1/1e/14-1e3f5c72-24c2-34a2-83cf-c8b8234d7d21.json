  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cb3c0340-dd59-3bc9-a7aa-cfa53539aa0f",
      "dc:description": {
        "de": [
          "Zeitgenössische Tanzaufführung \"Gueules noires\" (Schwarze Gesichter)\n\n20:30 Uhr - Palais des Congrès.\nDieses Jahr ehren wir die \"Gueules Noires\", die Bergarbeiter, die diese Aufführung inspiriert haben.\nEinzeltarif: 10?"
        ],
        "en": [
          "Gueules noires\" contemporary dance performance\n\n8:30pm - Palais des Congrès.\nThis year, we pay tribute to the \"Gueules Noires\", the coal miners who inspired this performance.\nPrice: 10?"
        ],
        "it": [
          "Spettacolo di danza contemporanea \"Gueules noires\n\n20.30 - Palazzo dei Congressi.\nQuest'anno rendiamo omaggio ai \"Gueules Noires\", i minatori di carbone che hanno ispirato questo spettacolo.\nPrezzo del biglietto singolo: 10?"
        ],
        "fr": [
          "Représentation de danse contemporaine \"Gueules noires\"\n\n20h30 - Palais des Congrès.\nCette année, rendons hommage aux \"Gueules Noires\", ces mineurs de fonds qui ont inspiré cette représentation.\nTarif unique : 10€"
        ],
        "nl": [
          "Hedendaagse dansvoorstelling \"Gueules noires\n\n20.30 uur - Congrespaleis.\nDit jaar brengen we hulde aan de \"Gueules Noires\", de mijnwerkers die de inspiratie vormden voor deze voorstelling.\nPrijs enkeltje: 10?"
        ],
        "es": [
          "Espectáculo de danza contemporánea \"Gueules noires\n\n20.30 h - Palacio de Congresos.\nEste año rendimos homenaje a las \"Gueules Noires\", las mineras del carbón que inspiraron este espectáculo.\nEntrada única: 10?"
        ]
      },
      "@type": [
        "Description"
      ],
