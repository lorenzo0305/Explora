  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Erde aus der Vogelperspektive bei einem Flug mit einem motorisierten Segelflugzeug.\r\nEin unvergessliches Erlebnis, das Sie auf eine Höhe von fast 4000 m bringt. Die Grenobler Alpen, wie man sie nie sieht, eine Erinnerung, die Sie mit einem Video des Fluges teilen können."
    ],
    "en": [
      "Discover the Earth from the air on a motorized glider flight.\r\nAn unforgettable experience that takes you to an altitude of almost 4000m. The Grenoble Alps as you've never seen them before, a memory to share thanks to a video of the flight."
    ],
    "it": [
      "Scoprite la Terra dall'alto con un volo in aliante motorizzato.\r\nUn'esperienza indimenticabile che vi porterà a quasi 4000 m di altitudine. Le Alpi di Grenoble come non le avete mai viste prima, un ricordo che vorrete condividere grazie a un video del volo."
    ],
    "fr": [
      "Découvrez la Terre vu du ciel lors d'un vol en planeur motorisé.\r\nUne expérience inoubliable qui vous emmène à prés de 4000m d'altitude. Les Alpes grenobloises comme on ne les voit jamais, un souvenir à faire partager grâce à une vidéo du vol."
    ],
    "nl": [
      "Ontdek de aarde vanuit de lucht tijdens een gemotoriseerde zweefvlucht.\r\nEen onvergetelijke ervaring die je meeneemt naar een hoogte van bijna 4000 meter. De Grenoble Alpen zoals je ze nog nooit hebt gezien, een herinnering die je zult willen delen dankzij een video van de vlucht."
    ],
    "es": [
      "Descubra la Tierra desde el aire en un vuelo en planeador motorizado.\r\nUna experiencia inolvidable que le llevará a casi 4000 m de altitud. Los Alpes de Grenoble como nunca los habías visto, un recuerdo que querrás compartir gracias a un vídeo del vuelo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Airtech La maison du planeur"
    ]
  },
