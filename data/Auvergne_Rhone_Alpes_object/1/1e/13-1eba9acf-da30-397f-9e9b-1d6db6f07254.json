  "rdfs:comment": {
    "de": [
      "Testen Sie Ihre Fähigkeiten als Seiltänzer auf unserer Slackline-Strecke! Sie bieten eine Erfahrung des Gleichgewichts und der Konzentration inmitten der Natur für Groß und Klein."
    ],
    "en": [
      "Come and test your tightrope walking skills on our slackline circuit! They offer an experience of balance and concentration in the heart of nature for young and old alike."
    ],
    "it": [
      "Venite a mettere alla prova le vostre abilità di funamboli sul nostro circuito di slackline! Offrono un'esperienza di equilibrio e concentrazione nel cuore della natura per grandi e piccini."
    ],
    "fr": [
      "Venez tester vos aptitudes de funambule sur notre circuit de slacklines ! Elles offrent une expérience d'équilibre et de concentration au cœur de la nature pour petits et grands."
    ],
    "es": [
      "Venga a poner a prueba sus habilidades en la cuerda floja en nuestro circuito de slackline Ofrecen una experiencia de equilibrio y concentración en plena naturaleza para grandes y pequeños."
    ],
    "nl": [
      "Kom je koorddanskunsten testen op ons slacklinecircuit! Ze bieden een ervaring van evenwicht en concentratie midden in de natuur voor jong en oud."
    ]
  },
