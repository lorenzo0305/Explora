  "rdfs:comment": {
    "de": [
      "Die Artothek der Gruppe Zeitgenössische Kunst ermöglicht es, Werke der zeitgenössischen Kunst auszuleihen, um sie zu Hause und in der täglichen Umgebung auszustellen und aufzuhängen: Wohnzimmer, Büro, Schule, Wartezimmer, Empfang...Das ist ihre Originalität!"
    ],
    "en": [
      "The Artothèque of the Contemporary Art Group allows you to borrow contemporary artworks to display them at home and in your daily environment: living room, office, school, waiting room, reception... This is its originality!"
    ],
    "it": [
      "L'Artothèque du Groupe Art contemporain vi permette di prendere in prestito opere d'arte contemporanea per esporle nella vostra casa e nel vostro ambiente quotidiano: soggiorno, ufficio, scuola, sala d'attesa, reception... Questa è la sua originalità!"
    ],
    "fr": [
      "L' Artothèque du Groupe Art contemporain permet d’emprunter des œuvres d’art contemporain pour les exposer, les accrocher chez soi et dans son environnement quotidien : salon, bureau, école, salle d’attente, accueil...C'est son originalité !"
    ],
    "nl": [
      "Met de Artothèque du Groupe Art contemporain kunt u hedendaagse kunstwerken lenen om ze bij u thuis en in uw dagelijkse omgeving tentoon te stellen: woonkamer, kantoor, school, wachtkamer, receptie... Dat is haar originaliteit!"
    ],
    "es": [
      "La Artothèque du Groupe Art contemporain le permite tomar prestadas obras de arte contemporáneo para exponerlas en su casa y en su entorno cotidiano: salón, despacho, escuela, sala de espera, recepción... ¡Esa es su originalidad!"
    ]
  },
  "rdfs:label": {
