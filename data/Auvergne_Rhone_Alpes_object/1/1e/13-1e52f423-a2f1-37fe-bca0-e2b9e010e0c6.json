  "rdfs:comment": {
    "de": [
      "Entdecken Sie den gefilmten Alltag der Bauern von früher. Unter der Führung von Le Félicien sehen Sie Kurzfilme, Szenen aus dem Leben im Rhythmus der Jahreszeiten und betreten dann die Küche seiner Tochter, La Foncine, für einen gemütlichen Moment in Ton und Licht."
    ],
    "en": [
      "Discover the filmed daily life of the farmers of yesteryear. Guided by Le Félicien, discover short films and scenes of life through the seasons, then enter his daughter's kitchen, La Foncine, for a warm moment of sound and light."
    ],
    "it": [
      "Scoprite la vita quotidiana filmata dei contadini di un tempo. Guidati da Le Félicien, scoprite brevi filmati e scene di vita attraverso le stagioni, poi entrate nella cucina di sua figlia, La Foncine, per un caldo momento di suoni e luci."
    ],
    "fr": [
      "Découvrez le quotidien filmé des paysans d’autrefois. Guidé par Le Félicien, découvrez des courts-métrages, des scènes de vie rythmées par les saisons, puis entrez dans la cuisine de sa fille, La Foncine, pour un moment chaleureux en son et lumière."
    ],
    "nl": [
      "Ontdek het gefilmde dagelijkse leven van de boeren van vroeger. Ontdek onder leiding van Le Félicien korte films, scènes uit het leven onderbroken door de seizoenen, en kom daarna binnen in de keuken van zijn dochter, La Foncine, voor een warm moment van geluid en licht."
    ],
    "es": [
      "Descubra la vida cotidiana filmada de los campesinos de antaño. Guiado por Le Félicien, descubra cortometrajes y escenas de la vida a través de las estaciones y, a continuación, entre en la cocina de su hija, La Foncine, para disfrutar de un cálido momento de luz y sonido."
    ]
  },
