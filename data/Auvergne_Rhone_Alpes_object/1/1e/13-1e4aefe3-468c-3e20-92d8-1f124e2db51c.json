  "rdfs:comment": {
    "de": [
      "Das Bar-Restaurant Le Forez bietet Ihnen eine traditionelle Küche in einem angenehmen und geselligen Rahmen. Das Lokal bietet auch Speisen zum Mitnehmen an.\r\nCatering für Empfänge, Geburtstage, Hochzeiten, Firmenveranstaltungen ..."
    ],
    "en": [
      "Le Forez bar-restaurant offers traditional cuisine in a pleasant, friendly setting. The establishment also offers take-away sales.\r\nCatering for receptions, birthdays, weddings, business events..."
    ],
    "it": [
      "Il bar-ristorante Le Forez offre una cucina tradizionale in un ambiente piacevole e accogliente. Il locale offre anche la vendita da asporto.\r\nCatering per ricevimenti, compleanni, matrimoni, eventi aziendali, ecc."
    ],
    "fr": [
      "Le bar-restaurant Le Forez vous propose une cuisine traditionnelle dans un cadre agréable et convivial. L'établissement propose également de la vente à emporter.\r\nTraiteur pour réception, anniversaires, mariage, événements professionnels ..."
    ],
    "es": [
      "El bar-restaurante Le Forez ofrece cocina tradicional en un ambiente agradable y acogedor. El establecimiento también ofrece venta de comida para llevar.\r\nCatering para recepciones, cumpleaños, bodas, eventos de empresa, etc."
    ],
    "nl": [
      "Bar-restaurant Le Forez biedt een traditionele keuken in een aangename, vriendelijke omgeving. Het restaurant biedt ook afhaalmaaltijden.\r\nCatering voor recepties, verjaardagen, bruiloften, zakelijke evenementen, enz."
    ]
  },
