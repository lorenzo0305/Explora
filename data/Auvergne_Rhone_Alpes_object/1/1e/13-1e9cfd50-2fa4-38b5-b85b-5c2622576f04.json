  "rdfs:comment": {
    "de": [
      "NOMAD lib' (Névéol Original Music, Arts and Design) vereint virtuose Solisten und Kammermusiker, die alle Mitglieder renommierter Formationen sind.\r\nAuf dem Programm steht klassische Musik aus Osteuropa."
    ],
    "en": [
      "NOMAD lib' (Névéol Original Music, Arts and Design) brings together virtuoso soloists and chamber musicians, all members of prestigious ensembles.\r\nOn the program: classical music from Eastern Europe."
    ],
    "it": [
      "NOMAD lib' (Névéol Original Music, Arts and Design) riunisce solisti virtuosi e musicisti da camera, tutti membri di prestigiosi ensemble.\r\nIn programma: musica classica dell'Europa orientale."
    ],
    "fr": [
      "NOMAD lib' (Névéol Original Music, Arts and Design) réunit des solistes et chambristes virtuoses, tous membres de prestigieuses formations.\r\nAu programme : musique classique d’Europe de l’est."
    ],
    "es": [
      "NOMAD lib' (Névéol Original Music, Arts and Design) reúne a virtuosos solistas y músicos de cámara, todos ellos miembros de prestigiosos conjuntos.\r\nEn el programa: música clásica de Europa del Este."
    ],
    "nl": [
      "NOMAD lib' (Névéol Original Music, Arts and Design) brengt virtuoze solisten en kamermusici samen, allemaal leden van prestigieuze ensembles.\r\nOp het programma: klassieke muziek uit Oost-Europa."
    ]
  },
  "rdfs:label": {
    "fr": [
