  "rdfs:comment": {
    "de": [
      "Alpines Bistro im Herzen von La Norma mit großer Südterrasse.\r\nWas ist das Besondere? Unsere 2 privatisierbaren Gondeln, um ein Fondue zu genießen..."
    ],
    "en": [
      "Alpine bistro in the heart of La Norma with large south-facing terrace.\r\nMost ? Our 2 gondolas can be privatized to enjoy a fondue!"
    ],
    "it": [
      "Bistrot alpino nel cuore di La Norma con ampia terrazza esposta a sud.\r\nLa parte migliore? Le nostre 2 gondole private per una fonduta..."
    ],
    "fr": [
      "Bistro alpin au cœur de La Norma avec grande terrasse plein Sud.\r\nLe plus ? Nos 2 télécabines privatisables pour déguster une fondue..."
    ],
    "es": [
      "Bistro alpino en el corazón de La Norma con una gran terraza orientada al sur.\r\n¿Lo mejor? Nuestras 2 góndolas privadas para una fondue..."
    ],
    "nl": [
      "Alpenbistro in het hart van La Norma met groot terras op het zuiden.\r\nMeest ? Onze 2 gondels kunnen worden geprivatiseerd om van een fondue te genieten!\r\n​"
    ]
  },
