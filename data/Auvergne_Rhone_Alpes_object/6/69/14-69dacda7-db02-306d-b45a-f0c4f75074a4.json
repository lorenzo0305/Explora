  "rdfs:comment": {
    "de": [
      "Chloé Lacan erzählt von ihrer Nina Simone und ruft durch sie ihre eigenen Erinnerungen an ihre Kindheit und an eine werdende Frau hervor."
    ],
    "en": [
      "Chloé Lacan tells the story of her Nina Simone and, through her, evokes her own memories of childhood and womanhood."
    ],
    "it": [
      "Chloé Lacan racconta la storia della sua Nina Simone e, attraverso di lei, evoca i propri ricordi d'infanzia e del diventare donna."
    ],
    "fr": [
      "Chloé Lacan raconte sa Nina Simone et, à travers elle, évoque ses propres souvenirs d’enfance et de femme en devenir."
    ],
    "nl": [
      "Chloé Lacan vertelt het verhaal van haar Nina Simone en roept via haar haar eigen herinneringen op aan haar kindertijd en aan het vrouw worden."
    ],
    "es": [
      "Chloé Lacan cuenta la historia de su Nina Simone y, a través de ella, evoca sus propios recuerdos de infancia y de convertirse en mujer."
    ]
  },
