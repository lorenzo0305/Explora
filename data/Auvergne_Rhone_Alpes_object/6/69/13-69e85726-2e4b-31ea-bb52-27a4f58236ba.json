  "rdfs:comment": {
    "de": [
      "Atelier für künstlerische Druckgrafik, das Workshops für Kupferstich, alte und zeitgenössische Druckgrafik organisiert. Entdeckung und Perfektionierung zahlreicher Techniken der Druckgrafik. Auf Anfrage geöffnet."
    ],
    "en": [
      "Artistic printmaking workshop offering courses in intaglio, antique and contemporary printmaking. Discover and perfect a wide range of printmaking techniques. Open on request."
    ],
    "it": [
      "Laboratorio di stampa artistica che organizza corsi di calcografia antica e contemporanea. Scoprite e perfezionate un'ampia gamma di tecniche di stampa. Aperto su richiesta."
    ],
    "fr": [
      "Atelier de gravure artistique qui organise des stages de gravure en taille douce, ancienne et contemporaine. Découverte et perfectionnement de nombreuses techniques de l'estampe. Ouvert à la demande."
    ],
    "es": [
      "Taller de grabado artístico que organiza cursos de grabado calcográfico antiguo y contemporáneo. Descubra y perfeccione una amplia gama de técnicas de grabado. Abierto previa petición."
    ],
    "nl": [
      "Artistieke drukkerij die cursussen organiseert in oude en hedendaagse diepdruk. Ontdek en perfectioneer een breed scala aan druktechnieken. Geopend op aanvraag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier - Les heures bleues - Gravure en taille douce"
    ]
  },
