  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Sgambato Ski Shop Skimium 1750 in Chamrousse! Am Fuße der Pisten können Sie alle benötigten Skiausrüstungen und Fahrräder mieten und profitieren von einem Parkplatz in der Nähe. Ideal für Gruppen und Familien!"
    ],
    "en": [
      "Discover Sgambato Ski Shop Skimium 1750 in Chamrousse! At the foot of the slopes, you can rent all the ski and bike equipment you need, and benefit from nearby parking. Ideal for groups and families!"
    ],
    "it": [
      "Scoprite lo Sgambato Ski Shop Skimium 1750 a Chamrousse! Ai piedi delle piste, noleggiate tutta l'attrezzatura da sci e da bici di cui avete bisogno e approfittate di un parcheggio nelle vicinanze. Ideale per gruppi e famiglie!"
    ],
    "fr": [
      "Découvrez Sgambato Ski Shop Skimium 1750 à Chamrousse ! Au pied des pistes, louez tout le matériel de glisse et vélo dont vous avez besoin, et profitez d'un parking proximité. Idéal pour groupes et familles!"
    ],
    "es": [
      "¡Descubre Sgambato Ski Shop Skimium 1750 en Chamrousse! A pie de pistas, alquile todo el material de esquí y bicicleta que necesite y aproveche un aparcamiento cercano. Ideal para grupos y familias"
    ],
    "nl": [
      "Ontdek Sgambato Ski Shop Skimium 1750 in Chamrousse! Huur aan de voet van de pistes al het ski- en fietsmateriaal dat je nodig hebt en profiteer van een nabijgelegen parkeerplaats. Ideaal voor groepen en gezinnen!"
    ]
  },
