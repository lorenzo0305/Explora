  "rdfs:comment": {
    "de": [
      "In Saint Pal de Chalencon, einer kleinen Stadt mit Charakter, empfängt Sie Beatrice Naacke inmitten der Natur, um Ihnen ihre im Atelier hergestellten handwerklichen Kreationen vorzustellen sowie Kurse für Kinder und Erwachsene anzubieten."
    ],
    "en": [
      "Located in Saint Pal de Chalencon, a small town full of character and surrounded by nature, Béatrice Naacke welcomes you to present her handcrafted creations made in her workshop, as well as to offer workshops for children and adults."
    ],
    "it": [
      "Béatrice Naacke si trova a Saint Pal de Chalencon, una piccola città piena di carattere, immersa nella natura, e sarà lieta di mostrarvi le sue creazioni fatte a mano nel suo laboratorio, oltre a proporre corsi per bambini e adulti."
    ],
    "fr": [
      "Installée à Saint Pal de Chalencon, petite cité de caractère, dans un écrin de nature, Béatrice Naacke vous accueille pour vous présenter ses créations artisanales fabriquées à l’atelier ainsi que pour des stages enfants et adultes."
    ],
    "es": [
      "Béatrice Naacke tiene su sede en Saint Pal de Chalencon, una pequeña ciudad llena de carácter, en un entorno natural. Estará encantada de mostrarle sus creaciones artesanales desde su taller, además de ofrecer cursos para niños y adultos."
    ],
    "nl": [
      "Béatrice Naacke is gevestigd in Saint Pal de Chalencon, een klein karaktervol stadje in een natuurlijke omgeving. Ze laat je graag haar handgemaakte creaties uit haar atelier zien en geeft cursussen voor kinderen en volwassenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bleu nuage céramique Béatrice Naacke"
    ]
  },
