  "rdfs:comment": {
    "de": [
      "Die Auberge Alsacienne hat sich in einem alten Bauernhaus aus der Vorkriegszeit niedergelassen. Es liegt in der Gemeinde Saint-Christophe-sur-Dolaizon inmitten der Natur, 5 km von Puy-en-Velay entfernt."
    ],
    "en": [
      "The Auberge alsacienne is housed in an old pre-war farmhouse, located in the commune of Saint-Christophe-sur-Dolaizon in the middle of nature, 5 km from Le Puy-en-Velay."
    ],
    "it": [
      "L'Auberge alsacienne si trova in un'antica casa colonica dell'anteguerra nel comune di Saint-Christophe-sur-Dolaizon, in mezzo alla natura, a 5 km da Le Puy-en-Velay."
    ],
    "fr": [
      "L'Auberge alsacienne s'est installée dans un vieux corps de ferme d'avant guerre, située sur la commune de Saint-Christophe-sur-Dolaizon en pleine nature, à 5 km du Puy-en-Velay."
    ],
    "es": [
      "El Auberge alsacienne está ubicado en una antigua granja de preguerra en la comuna de Saint-Christophe-sur-Dolaizon en plena naturaleza, a 5 km de Le Puy-en-Velay."
    ],
    "nl": [
      "De Auberge alsacienne is gevestigd in een oude vooroorlogse boerderij in de gemeente Saint-Christophe-sur-Dolaizon, midden in de natuur, op 5 km van Le Puy-en-Velay."
    ]
  },
