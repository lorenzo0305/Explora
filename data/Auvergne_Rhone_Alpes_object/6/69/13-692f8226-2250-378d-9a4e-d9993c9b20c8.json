  "rdfs:comment": {
    "de": [
      "Honig aus unseren Bienenstöcken, Bienenprodukte (Lebkuchen, Honigkaramell usw.), Konfitüren in vielen Geschmacksrichtungen, aber immer aus 100 % Frucht, Walnussöl, Apfelessig aus eigener Herstellung, Bierdepot und Bio-Limonade."
    ],
    "en": [
      "Honey from our own beehives, products derived from the hive (gingerbread, honey caramel, etc.) jams in a variety of flavors but always 100% fruit, walnut oil, cider vinegar from our own production, organic beer and lemonade."
    ],
    "it": [
      "Miele dei nostri alveari, prodotti derivati dall'alveare (pan di zenzero, caramello al miele, ecc.) marmellate in un'ampia gamma di gusti, ma sempre al 100% di frutta, olio di noci, aceto di sidro di nostra produzione, birra biologica e limonata."
    ],
    "fr": [
      "Miel provenant de nos ruches, produits dérivés de la ruche (pain d'épice, caramel de miel…) confitures avec de nombreux parfums mais toujours 100% fruit, huile de noix, vinaigre de cidre de notre production, dépôt de bière et limonade bio."
    ],
    "es": [
      "Miel de nuestras propias colmenas, productos derivados de la colmena (pan de especias, caramelo de miel, etc.) mermeladas de sabores muy variados, pero siempre 100% fruta, aceite de nuez, vinagre de sidra de producción propia, cerveza ecológica y limonada."
    ],
    "nl": [
      "Honing uit onze eigen bijenkorven, producten uit de bijenkorf (peperkoek, honingkaramel, etc.) jam in allerlei smaken, maar altijd 100% fruit, walnootolie, appelazijn uit eigen productie, biologisch bier en limonade."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Rucher de Biozat"
    ]
  },
