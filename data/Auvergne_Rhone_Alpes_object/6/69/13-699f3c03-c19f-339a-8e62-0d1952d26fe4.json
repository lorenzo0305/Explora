  "rdfs:comment": {
    "de": [
      "20 m tiefe Tauchgrube, die auf 33° C beheizt ist. Ideal für die Ausbildung/Praxis im Flaschentauchen und Apnoetauchen. Für alle Tauchschulen und Einzelpersonen zugänglich. Buvette mit außergewöhnlicher Dekoration."
    ],
    "en": [
      "20 m deep diving pit heated to 33°. Ideal for training/practice in scuba diving and freediving. Accessible to all diving schools and individuals. Extraordinarily decorated refreshment bar."
    ],
    "it": [
      "Fossa subacquea profonda 20 m e riscaldata a 33°. Ideale per l'allenamento/pratica di immersioni subacquee e apnea. Aperta a tutte le scuole di immersione e ai privati. Bar di ristoro straordinariamente decorato."
    ],
    "fr": [
      "Fosse de plongée de 20 m de profondeur chauffée à 33°. Idéale pour la formation/pratique en plongée bouteille et en apnée. Accessible à toutes les écoles de plongée et aux individuels. Buvette à la décoration extraordinaire."
    ],
    "es": [
      "Foso de buceo de 20 m de profundidad calentado a 33°. Ideal para entrenamientos y prácticas de submarinismo y apnea. Abierto a todas las escuelas de buceo y particulares. Bar de refrescos extraordinariamente decorado."
    ],
    "nl": [
      "20 m diepe duikput verwarmd tot 33°. Ideaal voor training/oefening in duiken en freediving. Open voor alle duikscholen en particulieren. Buitengewoon gedecoreerde verfrissingsbar."
    ]
  },
