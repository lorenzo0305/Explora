  "rdfs:comment": {
    "de": [
      "Familienkeller, der den Verkauf und die Verkostung von Weinen anbietet. Die Einrichtung ist mit den Labels Vignobles & Découvertes und Haute Valeur Environnementale ausgezeichnet und gehört zu den Vignerons Indépendants (Unabhängigen Winzern)."
    ],
    "en": [
      "Family-run cellar offering wine sales and tastings. The winery has been awarded the Vignobles & Découvertes and Haute Valeur Environnementale labels, and is a member of the Vignerons Indépendants association."
    ],
    "it": [
      "Cantina a conduzione familiare che offre vendita e degustazioni di vini. L'azienda ha ottenuto i marchi Vignobles & Découvertes e Alto Valore Ambientale ed è membro dei Vignerons Indépendants."
    ],
    "fr": [
      "Caveau familial proposant la vente et la dégustation de vins. La structure est labellisée Vignobles & Découvertes, Haute Valeur Environnementale et fait partie des Vignerons Indépendants."
    ],
    "nl": [
      "Familiewijnkelder met wijnverkoop en proeverijen. Het wijnhuis is bekroond met de labels Vignobles & Découvertes en Hoge Milieuwaarde en is lid van de Vignerons Indépendants."
    ],
    "es": [
      "Bodega familiar que ofrece venta y degustación de vinos. La bodega ha sido galardonada con las etiquetas Vignobles & Découvertes y Alto Valor Medioambiental, y es miembro de Vignerons Indépendants."
    ]
  },
