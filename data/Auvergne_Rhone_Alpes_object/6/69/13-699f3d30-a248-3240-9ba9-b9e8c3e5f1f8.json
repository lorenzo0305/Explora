  "rdfs:comment": {
    "de": [
      "Es handelt sich um eine kleine Guinguette, die sich in Presles befindet und während der Schönwetterperiode von Mai bis Ende September Konzertabende, Spieleabende oder Workshops anbietet."
    ],
    "en": [
      "This little Guinguette in Presles offers concerts, games evenings and workshops during the summer season, from May to the end of September."
    ],
    "it": [
      "Questa piccola Guinguette di Presles offre concerti, serate di gioco e laboratori durante i mesi estivi, da maggio a fine settembre."
    ],
    "fr": [
      "C'est une petite Guinguette qui se situe à Presles et propose des soirées concerts, soirées jeux ou ateliers sur la saison des beaux jours de mai à fin septembre."
    ],
    "es": [
      "Esta pequeña Guinguette de Presles ofrece conciertos, tardes de juegos y talleres durante los meses de verano, de mayo a finales de septiembre."
    ],
    "nl": [
      "Deze kleine Guinguette in Presles biedt concerten, spelletjesavonden en workshops tijdens de zomermaanden, van mei tot eind september."
    ]
  },
