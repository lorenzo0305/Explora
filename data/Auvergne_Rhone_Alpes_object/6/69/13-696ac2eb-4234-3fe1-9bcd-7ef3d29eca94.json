  "rdfs:comment": {
    "de": [
      "Ein Escape Game lässt die Teilnehmer in die Geschichte des Zweiten Weltkriegs eintauchen. Sie müssen aus einem Gefängnis fliehen, indem sie die Flucht von drei Widerstandskämpfern aufklären, die 1942 in Gannat inhaftiert waren. Die Spieler haben 30 Minuten Zeit, um Rätsel zu lösen."
    ],
    "en": [
      "An escape game immerses participants in the history of the Second World War. They must escape from a prison by elucidating the escape of 3 Resistance fighters imprisoned in Gannat in 1942. Players have 30 minutes to solve the riddles."
    ],
    "it": [
      "Un gioco di fuga che immerge i partecipanti nella storia della Seconda Guerra Mondiale. Devono fuggire da una prigione risolvendo l'evasione di 3 combattenti della Resistenza imprigionati a Gannat nel 1942. I giocatori hanno 30 minuti per risolvere gli enigmi."
    ],
    "fr": [
      "Un escape game plonge les participants dans l'histoire de la Seconde Guerre mondiale. Ils doivent s'échapper d'une prison en élucidant l'évasion de 3 résistants emprisonnés à Gannat en 1942. Les joueurs ont 30 minutes pour résoudre des énigmes."
    ],
    "es": [
      "Un juego de escape sumerge a los participantes en la historia de la Segunda Guerra Mundial. Deben escapar de una prisión resolviendo la fuga de 3 combatientes de la Resistencia encarcelados en Gannat en 1942. Los jugadores disponen de 30 minutos para resolver los enigmas."
    ],
    "nl": [
      "Een ontsnappingsspel dompelt de deelnemers onder in de geschiedenis van de Tweede Wereldoorlog. Ze moeten uit een gevangenis ontsnappen door de ontsnapping op te lossen van 3 verzetsstrijders die in 1942 in Gannat gevangen zaten. Spelers hebben 30 minuten om de raadsels op te lossen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game (+ de 12 ans)"
    ]
  },
