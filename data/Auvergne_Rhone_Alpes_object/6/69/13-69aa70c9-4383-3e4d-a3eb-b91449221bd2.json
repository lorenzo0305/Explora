  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf einen kleinen Spieleabend mit Freunden oder der Familie? \r\nDas Tourismusbüro besitzt mehr als zwanzig verschiedene Spiele, die Sie ausleihen können."
    ],
    "en": [
      "Would you like to enjoy a game night with friends or family? \r\nThe tourist office has more than twenty different games available for loan."
    ],
    "it": [
      "Volete godervi una serata di gioco con gli amici o la famiglia?\r\nL'ufficio turistico ha più di venti giochi diversi disponibili per il prestito."
    ],
    "fr": [
      "Une petite soirée jeux de société entre amis ou en famille, ça vous tente ? \r\nL'office de tourisme possède plus d'une vingtaine de jeux différents, disponibles en prêt."
    ],
    "es": [
      "¿Le gustaría disfrutar de una noche de juegos con sus amigos o su familia?\r\nLa oficina de turismo dispone de más de veinte juegos diferentes para su préstamo."
    ],
    "nl": [
      "Wilt u genieten van een spelletjesavond met vrienden of familie? \r\nHet VVV-kantoor heeft meer dan twintig verschillende spelletjes te leen."
    ]
  },
  "rdfs:label": {
    "de": [
