  "rdfs:comment": {
    "de": [
      "5 Minuten vom Stadtzentrum von Roanne entfernt, in einem schlichten, eleganten und raffinierten Dekor, bereiten wir Ihnen einen herzlichen Empfang und einen aufmerksamen und diskreten Service.  \r\nGroßzügige und traditionelle Küche. Spezialitäten: hausgemachte Frösche und Gänseleberpastete."
    ],
    "en": [
      "5 mns from the town centre, in an understated, elegant, refined decor, we reserve a warm welcome and a discreet and attentive service for you. Generous and traditional cuisine. Specialities : frogs, home-made foie gras and brochettes."
    ],
    "it": [
      "A 5 minuti dal centro di Roanne, in un ambiente sobrio, elegante e raffinato, vi offriamo un'accoglienza calorosa e un servizio attento e discreto.  \r\nCucina generosa e tradizionale. Specialità: rane e foie gras fatti in casa."
    ],
    "fr": [
      "À 5 min du centre-ville de Roanne, dans un décor sobre, élégant et raffiné, nous vous réservons un accueil chaleureux et un service attentif et discret.  \r\nCuisine généreuse et traditionnelle. Spécialités : grenouilles et foie gras maison."
    ],
    "nl": [
      "Op 5 minuten van het centrum van Roanne, in een sober, elegant en verfijnd kader, bieden wij u een warm onthaal en een attente en discrete service.  \r\nRoyale en traditionele keuken. Specialiteiten: huisgemaakte kikkers en foie gras."
    ],
    "es": [
      "A 5 minutos del centro de Roanne, en un entorno sobrio, elegante y refinado, le ofrecemos una cálida acogida y un servicio atento y discreto.  \r\nCocina generosa y tradicional. Especialidades: ranas caseras y foie gras."
    ]
  },
