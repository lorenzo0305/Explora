  "rdfs:comment": {
    "de": [
      "Diese Messe für bildende Kunst empfängt zahlreiche Aussteller aus ganz Frankreich, die sowohl Malerei als auch Skulpturen anbieten."
    ],
    "en": [
      "This art fair attracts numerous exhibitors from all over France, in both painting and sculpture, and welcomes visitors from all over the region."
    ],
    "it": [
      "Questa fiera d'arte attira un gran numero di espositori da tutta la Francia, sia pittori che scultori, e accoglie visitatori da tutta la regione."
    ],
    "fr": [
      "Ce salon d'art plastique reçoit de nombreux exposants venant de toute la France, tant en peinture qu'en sculpture, et accueille des visiteurs de toute la région."
    ],
    "es": [
      "Esta feria de bellas artes atrae a un gran número de expositores de toda Francia, tanto pintores como escultores, y acoge a visitantes de toda la región."
    ],
    "nl": [
      "Deze kunstbeurs trekt een groot aantal exposanten uit heel Frankrijk, zowel schilders als beeldhouwers, en verwelkomt bezoekers uit de hele regio."
    ]
