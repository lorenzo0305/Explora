  "rdfs:comment": {
    "de": [
      "La Mano 1.9, ein Pariser Rapper aus dem 19. Jahrhundert mit unaufhaltsamer Energie auf der Bühne, hat sich einen festen Platz in der französischen Rap-Szene erobert!"
    ],
    "en": [
      "La Mano 1.9, a Parisian rapper from the 19th arrondissement, with unstoppable energy on stage, has made a name for himself on the French rap scene!"
    ],
    "it": [
      "La Mano 1.9, rapper parigino del 19° arrondissement, con un'energia inarrestabile sul palco, si è fatto un nome sulla scena rap francese!"
    ],
    "fr": [
      "La Mano 1.9, rappeur parisien du 19ème, à l’énergie imparable sur scène, s’est fait une place de choix sur la scène du rap français !"
