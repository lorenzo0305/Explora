  "rdfs:comment": {
    "de": [
      "Dieser leichte bis mittelschwere Rundweg befindet sich inmitten der wunderschönen Landschaft von Prajourdan und bietet einen atemberaubenden Blick auf den Mont Blanc!"
    ],
    "en": [
      "This easy loop is found in the heart of the magnificent \r\nPrajourdan countryside, with an amazing view of Mont Blanc!"
    ],
    "it": [
      "Questo anello di livello medio-facile si trova nel cuore del magnifico paesaggio del Prajourdan, con una vista mozzafiato sul Monte Bianco!"
    ],
    "fr": [
      "Cette boucle de niveau facile à moyen se trouve au coeur du paysage magnifique de Prajourdan, avec vue imprenable sur le Mont Blanc !"
    ],
    "es": [
      "Este bucle de nivel fácil y medio se encuentra en el corazón del magnífico paisaje de Prajourdan, con una impresionante vista del Mont Blanc"
    ],
    "nl": [
      "Deze gemakkelijke lustocht ligt midden in het schitterende landschap van Prajourdan, met een adembenemend uitzicht op de Mont Blanc!"
    ]
  },
