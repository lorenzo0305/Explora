  "rdfs:comment": {
    "de": [
      "Erreichbar mit der Seilbahn von Val Cenis le Haut.\r\n900 m lange Rodelbahn. Schlittenverleih und Fahrt mit der Gondelbahn inbegriffen. Das Tragen von Helm und Handschuhen ist Pflicht."
    ],
    "en": [
      "Accessible via the Val Cenis le Haut gondola.\r\n900 m toboggan run. Toboggan loan and gondola ride included. Helmet and gloves mandatory."
    ],
    "it": [
      "Accessibile tramite la funivia di Val Cenis le Haut.\r\nPista da slittino di 900 m. Prestito di slitta e cabinovia incluso. Casco e guanti obbligatori."
    ],
    "fr": [
      "Accessible par la télécabine de Val Cenis le Haut.\r\nPiste de luge de 900 m de long. Prêt de la luge et montée en télécabine inclus. Port du casque et des gants obligatoire."
    ],
    "nl": [
      "Bereikbaar via de kabelbaan Val Cenis le Haut.\r\nRodelbaan van 900 m. Bruikleen van slee en gondellift inbegrepen. Helmen en handschoenen verplicht."
    ],
    "es": [
      "Acceso por el teleférico de Val Cenis le Haut.\r\nPista de trineo de 900 m. Préstamo de trineo y telecabina incluido. Cascos y guantes obligatorios."
    ]
  },
  "rdfs:label": {
