  "rdfs:comment": {
    "de": [
      "Kreuzfahrt auf der Rhône an Bord des Schiffes CANOTIER mit Durchfahrt einer großen Schleuse. Abfahrt in Tournon-sur-Rhône oder St-Vallier. Ihr Fahrrad wird kostenlos mitgenommen und Sie können die Schifffahrt mit einer gemütlichen Rückfahrt auf der Fahrradroute ViaRhôna kombinieren."
    ],
    "en": [
      "Enjoy a lovely ride in a catamaran boat along the Rhône river and experience going through a lock. Get on board with your bike taken free and discover the Viarhôna cycling track on the return journey. Departures from Tournon or Saint-Vallier."
    ],
    "it": [
      "Crociera sul Rodano a bordo del battello Canotiers. Partenza da Tournon-sur-Rhône o St-Vallier. La bicicletta viene imbarcata gratuitamente e si può combinare la crociera con un piacevole viaggio di ritorno sulla pista ciclabile ViaRhôna."
    ],
    "fr": [
      "Croisière sur le Rhône à bord du bateau des Canotiers. Départ Tournon-sur-Rhône ou St-Vallier. Votre vélo est embarqué gratuitement et vous pouvez combiner la navigation avec un retour tranquille sur la vélo-route ViaRhôna."
    ],
    "nl": [
      "Vaar over de Rhône aan boord van de CANOTIER boot, door een grote sluis. Vertrek vanuit Tournon-sur-Rhône of St-Vallier. Je fiets wordt gratis meegenomen aan boord en je kunt de tocht combineren met een ontspannen terugreis over de ViaRhôna-fietsroute."
    ],
    "es": [
      "Crucero por el Ródano a bordo del barco Canotiers. Salida de Tournon-sur-Rhône o St-Vallier. Le llevaremos gratuitamente su bicicleta a bordo y podrá combinar el crucero con un tranquilo viaje de vuelta por la ruta ciclista ViaRhôna."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mini-cruise and bike ride"
    ],
    "fr": [
      "Croisière fluviale sur le Rhône à la journée bateau/vélo avec les canotiers"
    ]
  },
