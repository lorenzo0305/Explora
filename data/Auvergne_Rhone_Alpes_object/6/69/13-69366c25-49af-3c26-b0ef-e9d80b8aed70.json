  "rdfs:comment": {
    "de": [
      "Flüge von Montrond-les-Bains aus, je nach Klimabedingungen. Ganzjährig stehen Flüge bei Sonnenaufgang auf dem Programm."
    ],
    "en": [
      "Trips from Montrond-Les-Bains subject to weather conditions. Trips scheduled from sunrise all year round."
    ],
    "it": [
      "Se siete alla ricerca dell'inaspettato, questa è l'attività che fa per voi! Condividete la passione del pilota e tornate a terra con tanti ricordi dopo il vostro primo volo! Inoltre, un team caloroso e accogliente."
    ],
    "fr": [
      "À la recherche d’émotions et d’inattendu, cette activité est faite pour vous ! Partagez la passion du pilote et redescendez sur terre avec des souvenirs plein la tête après votre baptême de l’air ! En bonus, une équipe accueillante et chaleureuse."
    ],
    "es": [
      "Si buscas lo inesperado, ¡ésta es tu actividad! Comparta la pasión del piloto y vuelva a la tierra con un montón de recuerdos tras su primer vuelo Además, un equipo cálido y acogedor."
    ],
    "nl": [
      "Als u op zoek bent naar het onverwachte, dan is dit de activiteit voor u! Deel de passie van de piloot en kom met veel herinneringen terug op aarde na je eerste vlucht! Als bonus, een warm en gastvrij team."
    ]
  },
