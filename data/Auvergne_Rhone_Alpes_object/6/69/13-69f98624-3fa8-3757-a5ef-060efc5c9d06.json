  "rdfs:comment": {
    "de": [
      "Erkunden Sie die Altstadt mit ihren Ausblicken auf die Saône, während Sie in über 10 Rätseln den schrecklichen Öpinell aufspüren."
    ],
    "en": [
      "Explore the old town and its panoramic views over the Saône while tracking down the dreaded Öpinell through more than 10 riddles."
    ],
    "it": [
      "Esplorate la città vecchia e le sue viste panoramiche sulla Saona mentre rintracciate il terribile Öpinell attraverso più di 10 indovinelli."
    ],
    "fr": [
      "Explorez la vieille ville et ses panoramas sur la Saône tout en traquant le terrible Öpinell à travers plus de 10 énigmes."
    ],
    "nl": [
      "Verken de oude stad en het panoramische uitzicht over de Saône terwijl je via meer dan 10 raadsels de verschrikkelijke Öpinell opspoort."
    ],
    "es": [
      "Explore el casco antiguo y sus vistas panorámicas sobre el Saona mientras sigue la pista del terrible Öpinell a través de más de 10 enigmas."
    ]
  },
