  "rdfs:comment": {
    "de": [
      "Willkommen im La Clé de Sol, Ihrem traditionellen französischen Restaurant im Herzen von Chalmazel. Wir bieten Ihnen eine authentische und großzügige Küche, die mit regionalen und saisonalen Produkten zubereitet wird.\r\nEntdecken Sie unsere verschiedenen Menüs sowie unsere Pizzen"
    ],
    "en": [
      "Welcome to La Clé de Sol, your traditional French restaurant in the heart of Chalmazel. We offer authentic and generous cuisine, prepared with local and seasonal produce.\r\nCome and discover our different menus and pizzas"
    ],
    "it": [
      "Benvenuti a La Clé de Sol, il vostro ristorante tradizionale francese nel cuore di Chalmazel. Offriamo una cucina autentica e generosa, preparata con prodotti locali e di stagione.\r\nVenite a scoprire i nostri diversi menu e le nostre pizze"
    ],
    "fr": [
      "Bienvenue à La Clé de Sol, votre restaurant traditionnel français au cœur de Chalmazel. Nous vous proposons une cuisine authentique et généreuse, élaborée avec des produits du terroir et de saison.\r\nVenez découvrir nos différents menus ainsi que nos pizzas"
    ],
    "nl": [
      "Welkom bij La Clé de Sol, uw traditionele Franse restaurant in het hart van Chalmazel. Wij bieden een authentieke en royale keuken, bereid met lokale en seizoensgebonden producten.\r\nKom en ontdek onze verschillende menu's en pizza's"
    ],
    "es": [
      "Bienvenido a La Clé de Sol, su restaurante tradicional francés en el corazón de Chalmazel. Le ofrecemos una cocina auténtica y generosa, elaborada con productos locales y de temporada.\r\nVenga a descubrir nuestros diferentes menús y pizzas"
    ]
  },
