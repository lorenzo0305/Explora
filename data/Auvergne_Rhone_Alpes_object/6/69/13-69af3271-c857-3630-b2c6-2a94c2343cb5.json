  "rdfs:comment": {
    "de": [
      "Künstleratelier, Ausstellung der Gemälde. Motive:  Berge, Meer, Blumen.\r\nBesichtigung nach Verabredung.."
    ],
    "en": [
      "Artist studio, exhibition of watercolors: landscape of Mountain, sea, flowers.\r\nIsabelle Desse's works in her workshop at Le Villaret."
    ],
    "it": [
      "Studio dell'artista situato a Villaret, mostra di acquerelli: paesaggi di montagna, mare, fiori, ritratti. Corsi di disegno e pittura per bambini, adolescenti e adulti, a tutti i livelli. Visite allo studio tutti i giorni tranne il sabato."
    ],
    "fr": [
      "Atelier d'artiste situé au Villaret, exposition d'aquarelles : paysage de Montagne, mer, fleurs, portraits. Cours et stages de dessin et de peinture toutes techniques enfants, ados, adultes, tous niveaux. Visites d'atelier tous les jours sauf le samedi."
    ],
    "nl": [
      "Kunstenaarsatelier in Villaret, tentoonstelling van aquarellen: berglandschappen, zee, bloemen, portretten. Teken- en schildercursussen voor kinderen, tieners, volwassenen, alle niveaus. Bezoek aan de studio elke dag behalve zaterdag."
    ],
    "es": [
      "Estudio de artista situado en Villaret, exposición de acuarelas: paisajes de montaña, mar, flores, retratos. Cursos de dibujo y pintura para niños, adolescentes y adultos, todos los niveles. Visitas al estudio todos los días excepto el sábado."
    ]
  },
