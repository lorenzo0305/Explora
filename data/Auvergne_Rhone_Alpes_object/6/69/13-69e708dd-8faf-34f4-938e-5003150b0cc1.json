  "rdfs:comment": {
    "de": [
      "Die Mühle von Cézille, auch \"Moulin Gaud\" genannt, erzählt uns anhand ihrer Maschinerie und eines kleinen Museums, das von einem Team von Enthusiasten eingerichtet wurde, einen wichtigen Teil der Geschichte der Bresse."
    ],
    "en": [
      "The Moulin de Cézille, also known as the \"Moulin Gaud\", recounts an important part of Bresse's history, through its machinery and a small museum created by a team of enthusiasts."
    ],
    "it": [
      "Il mulino di Cézille, noto come \"mulino Gaud\", ci racconta una parte importante della storia di Bresse, attraverso i suoi macchinari e un piccolo museo creato da un team di appassionati."
    ],
    "fr": [
      "Le moulin de Cézille, dit \"moulin Gaud\", nous conte un pan important de l'histoire bressane, à travers sa machinerie et un petit musée créé par une équipe de passionnés."
    ],
    "es": [
      "El molino de Cézille, conocido como el \"molino de Gaud\", nos cuenta una parte importante de la historia de Bresse, a través de su maquinaria y de un pequeño museo creado por un equipo de aficionados."
    ],
    "nl": [
      "De molen van Cézille, bekend als de \"Gaud-molen\", vertelt ons een belangrijk deel van de geschiedenis van Bresse, via zijn machines en een klein museum dat door een team enthousiastelingen is opgezet."
    ]
  },
