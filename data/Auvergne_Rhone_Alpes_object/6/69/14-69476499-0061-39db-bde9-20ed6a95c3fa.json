      "dc:description": {
        "de": [
          "Präsentation des Stücks \"Faux Départ\" durch den Verein Act'In Scène. Freier Tarif\nEin Stück von Jean-Marie Chevret. Inszenierung von JF Bils\nTreffpunkt im Salle de la Cachaine um 20.00 Uhr AM 13.06"
        ],
        "en": [
          "Presentation by the Act'In Scène association of the play \"Faux Départ\". Free admission\nA play by Jean-Marie Chevret. Directed by JF Bils\nRendezvous at Salle de la Cachaine at 8:00 pm 06/13"
        ],
        "it": [
          "Presentazione dell'associazione Act'In Scène dello spettacolo \"Faux Départ\". Ingresso libero\nOpera di Jean-Marie Chevret. Regia di JF Bils\nAppuntamento alla Salle de la Cachaine alle 20.00 del 13/06"
        ],
        "fr": [
          "Présentation par l'association Act'In Scène de la pièce \" Faux Départ\". Tarif libre\nUne pièce de Jean-Marie Chevret. Mise en scène de JF Bils\nRendez-vous à la salle de la Cachaine à 20h00 LE 13/06"
        ],
        "nl": [
          "Voorstelling door de vereniging Act'In Scène van het toneelstuk \"Faux Départ\". Gratis toegang\nEen toneelstuk van Jean-Marie Chevret. Regie: JF Bils\nAfspraak in de Salle de la Cachaine om 20u op 13/06"
        ],
        "es": [
          "Presentación por la asociación Act'In Scène de la obra \"Faux Départ\". Entrada gratuita\nUna obra de Jean-Marie Chevret. Dirigida por JF Bils\nCita en la Salle de la Cachaine a las 20.00 h el 13/06"
        ]
      },
