  "rdfs:comment": {
    "de": [
      "Unser Hotel mit seiner atemberaubenden Aussicht liegt eine Minute zu Fuß vom Stadtzentrum entfernt in einer ruhigen Gegend und heißt Sie im Sommer wie im Winter mit Halbpension oder Zimmer und Frühstück willkommen. Das Restaurant ist nur im Winter in Betrieb."
    ],
    "en": [
      "Located a minute awayfrom the town center, in a quiet area of Morzine, our hotel with its unique view welcomes you summer and winter on half board or breakfast basis.\r\nThe hotel provides its customers with a private car park, tv lounge, ski room, free wifi, cocktail bar and restaurant facilities."
    ],
    "it": [
      "Situato a un minuto a piedi dal centro della città, in una zona tranquilla e silenziosa, il nostro hotel con una vista mozzafiato vi accoglie in estate e in inverno, con trattamento di mezza pensione o di pernottamento e prima colazione. Il ristorante è aperto solo in inverno."
    ],
    "fr": [
      "Situé à une minute à pied du centre ville dans un quartier calme et tranquille, notre hôtel et sa vue imprenable vous accueille été comme hiver, en demi-pension ou chambre et petit déjeuner. Le restaurant ne fonctionne que l'hiver."
    ],
    "es": [
      "Situado a un minuto a pie del centro de la ciudad, en una zona tranquila y apacible, nuestro hotel con impresionantes vistas le da la bienvenida en verano e invierno, en régimen de media pensión o alojamiento y desayuno. El restaurante sólo abre en invierno."
    ],
    "nl": [
      "Ons hotel met adembenemend uitzicht ligt op slechts een minuut lopen van het stadscentrum in een rustige, vredige omgeving en verwelkomt je 's zomers en 's winters op basis van halfpension of logies met ontbijt. Het restaurant is alleen in de winter geopend."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel Le Grand Tetras"
    ],
    "fr": [
      "Hôtel Le Grand Tetras"
    ],
