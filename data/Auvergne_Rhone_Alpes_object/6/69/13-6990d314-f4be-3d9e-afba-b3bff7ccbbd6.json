  "rdfs:comment": {
    "de": [
      "Thierry Marchand-Maillet. Holzrahmenbau, Dacharbeiten, Treppenbau; Neubau, Sanierung, Instandhaltung.\r\nDas Kerngeschäft von Everest Charpente ist nach wie vor der traditionelle Holzrahmenbau, darüber hinaus bietet das Unternehmen auch Dacharbeiten, Zinkarbeiten, Fassadenverkleidungen und Dämmung an."
    ],
    "en": [
      "Thierry Marchand-Maillet. Timber framing, roofing, staircases; new construction, renovation, maintenance.\r\nWhile its core business remains traditional timber framing, Everest Charpente also handles roofing, zinc work, cladding, and insulation."
    ],
    "it": [
      "Thierry Marchand-Maillet. Carpenteria, coperture, scale; nuove costruzioni, ristrutturazioni, manutenzione.\r\nSebbene il suo core business rimanga la carpenteria tradizionale, Everest Charpente si occupa anche di coperture, lavori in zinco, rivestimenti e isolamenti."
    ],
    "fr": [
      "Thierry Marchand-Maillet. Réalisation charpente, couverture, escalier ; neuf, rénovation, entretien.\r\nBien que son cœur de métier reste la charpente traditionnelle, Everest Charpente traite également la couverture, la zinguerie, le bardage, l'isolation."
    ],
    "nl": [
      "Thierry Marchand-Maillet. Timmerwerk, dakbedekking, trappen; nieuwbouw, renovatie, onderhoud.\r\nHoewel de kernactiviteit traditioneel timmerwerk blijft, houdt Everest Charpente zich ook bezig met dakbedekking, zinkwerk, gevelbekleding en isolatie."
    ],
    "es": [
      "Thierry Marchand-Maillet. Carpintería, tejados, escaleras; obra nueva, renovación, mantenimiento.\r\nAunque su actividad principal sigue siendo la carpintería tradicional, Everest Charpente también se ocupa de tejados, cincados, revestimientos y aislamientos."
    ]
  },
