  "rdfs:comment": {
    "de": [
      "Hamburger aus hochwertigen Produkten: Fleisch aus Frankreich, Rohmilchkäse, Brot, das täglich von unserem Bäcker zubereitet wird.\r\nKariertes Hemd, Schürze, Baskenmütze und Schnurrbart, klare Worte, Humor und Geselligkeit."
    ],
    "en": [
      "Hamburgers made from quality products: meat of French origin, raw milk cheeses, breads prepared daily by our artisan baker.\r\nCheckered shirt, apron, beret and moustache, frankness, humour and conviviality."
    ],
    "it": [
      "Hamburger preparati con prodotti di qualità: carni francesi, formaggi a latte crudo, pane preparato quotidianamente dal nostro fornaio artigianale.\r\nCamicia a quadri, grembiule, berretto e baffi, schiettezza, umorismo e convivialità."
    ],
    "fr": [
      "Hamburgés élaborés à partir de produits de qualité : viandes d'origine française, fromages au lait cru, pains préparés quotidiennement par notre artisan boulanger.\r\nChemise à carreaux, tablier, béret et moustache, franc-parler, humour et convivialité."
    ],
    "es": [
      "Hamburguesas elaboradas con productos de calidad: carnes francesas, quesos de leche cruda, panes preparados diariamente por nuestro panadero artesano.\r\nCamisa de cuadros, delantal, boina y bigote, franqueza, humor y cordialidad."
    ],
    "nl": [
      "Hamburgers van kwaliteitsproducten: Frans vlees, kazen van rauwe melk, brood dat dagelijks door onze ambachtelijke bakker wordt bereid.\r\nGeruit overhemd, schort, baret en snor, rechtlijnigheid, humor en gezelligheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Big Fernand"
    ]
  },
