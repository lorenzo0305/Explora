  "rdfs:comment": {
    "de": [
      "Haupttätigkeit: Sammeln von Heil- und Gewürzpflanzen, Pilzen und Birkensaft.\r\nDirektverkauf auf dem Bauernhof oder Bestellung per E-Mail\r\nNaturpraktikum von 2 bis 3 Tagen\r\nUnterkunft Woofing\r\nUnterkünfte und Biwak auf dem GR 65"
    ],
    "en": [
      "Main activity: gathering of medicinal and aromatic plants, mushrooms and birch sap.\r\nDirect sale at the farm or order by e-mail\r\n2 to 3-day nature course\r\nWoofing welcome\r\nGîtes and bivouacs on the GR 65"
    ],
    "it": [
      "Attività principale: raccolta di piante medicinali e aromatiche, funghi e linfa di betulla.\r\nVendita diretta in fattoria o ordine via e-mail\r\nCorso naturalistico di 2 o 3 giorni\r\nAccoglienza con i gufi\r\nGîtes e bivacchi sul GR 65"
    ],
    "fr": [
      "Activité principale : cueillette de plantes médicinales et aromatiques, de champignons et de sève de bouleau.\r\nVente directe à la ferme ou commande par mail \r\nStage nature de 2 à 3 jours\r\nAccueil Woofing \r\nGîtes et bivouac sur le GR 65"
    ],
    "nl": [
      "Hoofdactiviteit: plukken van geneeskrachtige en aromatische planten, paddenstoelen en berkensap.\r\nDirecte verkoop op de boerderij of bestelling per e-mail\r\n2 tot 3-daagse natuurcursus\r\nWoef welkom\r\nGîtes en bivaks op de GR 65"
    ],
    "es": [
      "Actividad principal: recolección de plantas medicinales y aromáticas, setas y savia de abedul.\r\nVenta directa en la granja o pedido por correo electrónico\r\nCurso de naturaleza de 2 a 3 días\r\nAcogida en la granja\r\nCasas rurales y vivacs en el GR 65"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Arche de Gabriel"
    ]
  },
