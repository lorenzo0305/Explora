  "rdfs:comment": {
    "de": [
      "Das Château de Rapetour, ein Juwel des Mittelalters und der Renaissance, befindet sich im südlichen Beaujolais, im Herzen der Pierres Dorées, 25 km von Lyon entfernt und profitiert von einer außergewöhnlichen natürlichen Umgebung."
    ],
    "en": [
      "Château de Rapetour, a jewel of the Middle Ages and the Renaissance, is located in the southern Beaujolais, in the heart of the Pierres Dorées region, 25 km from Lyon city centre, in an exceptional natural setting."
    ],
    "it": [
      "Lo Château de Rapetour, gioiello del Medioevo e del Rinascimento, si trova nel Beaujolais meridionale, nel cuore della regione delle Pierres Dorées, a 25 km dal centro di Lione, in un contesto naturale eccezionale."
    ],
    "fr": [
      "Le Château de Rapetour, joyau du Moyen-Âge et de la Renaissance, est situé dans le Beaujolais du Sud, au cœur des Pierres Dorées, à 25 km de Lyon-centre et bénéficie d'un environnement naturel exceptionnel."
    ],
    "es": [
      "El castillo de Rapetour, joya de la Edad Media y del Renacimiento, está situado en el sur del Beaujolais, en el corazón de la región de Pierres Dorées, a 25 km del centro de Lyon, en un marco natural excepcional."
    ],
    "nl": [
      "Château de Rapetour, een juweel uit de Middeleeuwen en de Renaissance, ligt in het zuiden van de Beaujolais, in het hart van de regio Pierres Dorées, op 25 km van het centrum van Lyon, in een uitzonderlijke natuurlijke omgeving."
    ]
  },
