  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere internationale Küche, frisch vor Ort zubereitet: Wok-Spezialitäten, authentische Tajines, Pasta & Nudeln, hausgemachte Räuchergerichte, handgemachte Crêpes, Sommersalate und internationale Tapas."
    ],
    "en": [
      "Discover our world cuisine prepared on site: Wok specialties, authentic tajines, pasta & noodles, homemade smoked dishes, artisan crepes, summer salads, and international tapas."
    ],
    "it": [
      "Scoprite la nostra cucina dal mondo preparata sul posto: specialità al wok, tajine autentici, pasta e noodles, affumicati artigianali, crêpes fatte a mano, insalate estive e tapas internazionali."
    ],
    "fr": [
      "Découvrez notre cuisine du monde préparée sur place : Spécialités au wok, Tajines authentiques, pâtes & Nouilles, Fumages Maison, crêpes artisanales, Salades d’été et Tapas internationaux."
    ],
    "nl": [
      "Ontdek onze wereldkeuken, ter plaatse bereid: wokspecialiteiten, authentieke tajines, pasta & noedels, huisgerookte gerechten, ambachtelijke crêpes, zomersalades en internationale tapas."
    ],
    "es": [
      "Descubra nuestra cocina del mundo preparada in situ: especialidades al wok, auténticos tajines, pasta y fideos, ahumados caseros, crepes caseros, ensaladas de verano y tapas internacionales."
    ]
  },
