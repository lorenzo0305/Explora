  "rdfs:comment": {
    "de": [
      "Der landwirtschaftliche Betrieb \"La ferme du Rival\" produziert seit 1965 biologisch, dank des \"Écrevisse\", wie mein Großvater von den umliegenden Landwirten genannt wurde."
    ],
    "en": [
      "The farm \"La ferme du Rival\" has been producing organically since 1965, thanks to Crayfish, the name given to my grandfather by the farmers in the area."
    ],
    "it": [
      "La fattoria \"La ferme du Rival\" produce con metodo biologico dal 1965, grazie a l'Écrevisse, il nome dato a mio nonno dai contadini della zona."
    ],
    "fr": [
      "L'exploitation agricole « La ferme du Rival » produit en agriculture biologique depuis 1965, grâce à l'Écrevisse, nom donné à mon grand-père par les agriculteurs des alentours."
    ],
    "es": [
      "La granja \"La ferme du Rival\" produce de forma ecológica desde 1965, gracias a l'Écrevisse, el nombre que los agricultores de la zona dieron a mi abuelo."
    ],
    "nl": [
      "De boerderij \"La ferme du Rival\" produceert sinds 1965 biologisch, dankzij l'Écrevisse, de naam die mijn grootvader kreeg van de boeren in de omgeving."
    ]
  },
