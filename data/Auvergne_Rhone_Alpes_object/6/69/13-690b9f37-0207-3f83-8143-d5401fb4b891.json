  "rdfs:comment": {
    "de": [
      "Im historischen Zentrum ist ein originelles und vielfältiges Erbe aus dem Mittelalter und der Renaissance erhalten. Hier kann man die soziale Organisation der Stadt zu dieser Zeit ablesen."
    ],
    "en": [
      "The historic town center boasts an original and diverse medieval and Renaissance heritage. The social organization of the town at that time is clearly visible."
    ],
    "it": [
      "Il centro storico ha conservato il suo patrimonio medievale e rinascimentale originale e di alta qualità. È possibile osservare l'organizzazione sociale della città all'epoca."
    ],
    "fr": [
      "Le centre historique conserve un patrimoine médiéval et Renaissance original et de grande qualité. On peut y lire l’organisation sociale de la ville à cette époque."
    ],
    "nl": [
      "Het historische centrum heeft een origineel en divers middeleeuws en renaissancistisch erfgoed. De sociale organisatie van de stad in die tijd is hier te zien."
    ],
    "es": [
      "El centro histórico ha conservado su patrimonio medieval y renacentista original, de gran calidad. Se puede observar la organización social de la ciudad en aquella época."
    ]
  },
