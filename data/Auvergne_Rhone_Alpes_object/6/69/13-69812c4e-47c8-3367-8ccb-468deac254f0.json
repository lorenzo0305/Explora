  "rdfs:comment": {
    "de": [
      "Jahrhunderts von Jean-Charles Marie de Brun, Berater des Königs und Meister der Wasser- und Forstwirtschaft der Provinz Beaujolais, erbaut."
    ],
    "en": [
      "Although Longsard dates back to the beginning of the 17th century, the property was built during the second half of the 18th century by Jean-Charles Marie de Brun, advisor to the king and \"Master of Water and Forests\" for the Beaujolais province."
    ],
    "it": [
      "Sebbene la tenuta di Longsard sia apparsa all'inizio del XVII secolo, la proprietà fu costruita nella seconda metà del XVIII secolo da Jean-Charles Marie de Brun, Consigliere del Re e Maestro delle Acque e delle Foreste della provincia del Beaujolais."
    ],
    "fr": [
      "Si le domaine de Longsard apparaît dès le début du XVIIème siècle, la propriété a été construite durant la deuxième moitié du XVIIIème par Jean-Charles Marie de Brun, conseiller du Roi et maître des Eaux et Forêts de la province de Beaujolais."
    ],
    "nl": [
      "Hoewel het landgoed Longsard aan het begin van de 17e eeuw ontstond, werd het in de tweede helft van de 18e eeuw gebouwd door Jean-Charles Marie de Brun, raadsheer van de koning en meester van het water en de bossen van de provincie Beaujolais."
    ],
    "es": [
      "Aunque la finca de Longsard apareció a principios del siglo XVII, la propiedad fue construida durante la segunda mitad del siglo XVIII por Jean-Charles Marie de Brun, Consejero del Rey y Maestro de Aguas y Bosques de la provincia de Beaujolais."
    ]
  },
