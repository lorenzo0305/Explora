  "rdfs:comment": {
    "de": [
      "Régny ist eine französische Gemeinde im Département Loire in der Region Auvergne-Rhône-Alpes. Sie liegt 325 m über dem Meeresspiegel und hat eine Fläche von 1.380 ha. Sie hat laut den INSEE-Zahlen vom 1. Januar 2021 1469 Einwohner."
    ],
    "en": [
      "Régny is a French commune in the Loire department in the Auvergne-Rhône-Alpes region. It lies at an altitude of 325 m and covers an area of 1,380 ha. According to INSEE figures for January 1, 2021, it has a population of 1,469."
    ],
    "it": [
      "Régny è un comune francese del dipartimento della Loira, nella regione dell'Alvernia-Rodano-Alpi. Si trova a un'altitudine di 325 m e si estende su una superficie di 1.380 ettari. Secondo i dati INSEE al 1° gennaio 2021, ha una popolazione di 1469 abitanti."
    ],
    "fr": [
      "Régny est une commune française située dans le département de la Loire en région Auvergne-Rhône-Alpes. Elle est située à 325 m d'altitude et sa superficie est de 1 380 ha. Elle compte, selon les chiffres INSEE au 1er janvier 2021, 1469 habitants."
    ],
    "nl": [
      "Régny is een Franse gemeente in het departement Loire in de regio Auvergne-Rhône-Alpes. Het ligt op een hoogte van 325 m en heeft een oppervlakte van 1.380 ha. Volgens de cijfers van INSEE per 1 januari 2021 telt de gemeente 1469 inwoners."
    ],
    "es": [
      "Régny es una comuna francesa situada en el departamento del Loira, en la región de Auvernia-Ródano-Alpes. Se encuentra a 325 m de altitud y tiene una superficie de 1.380 ha. Según los datos del INSEE a 1 de enero de 2021, tiene una población de 1.469 habitantes."
    ]
  },
  "rdfs:label": {
