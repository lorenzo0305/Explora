  "rdfs:comment": {
    "de": [
      "La Casadaline ist ein Restaurant in einem Haus im Herzen des Chateauvert-Viertels.\r\nAline bietet Ihnen 100 % hausgemachte Küche mit einer sehr kleinen Karte, die jeden Tag und jedes Wochenende wechselt.\r\nAline betreibt auch 2 Gästezimmer."
    ],
    "en": [
      "La Casadaline is a restaurant in a house, in the heart of the Chateauvert district.\r\nAline offers you 100% homemade cuisine, with a very small menu that changes every day and every weekend.\r\nAline also runs 2 guest rooms."
    ],
    "it": [
      "La Casadaline è un ristorante in una casa, nel cuore del quartiere Chateauvert.\r\nAline vi propone una cucina casalinga al 100%, con un menù molto ridotto che cambia ogni giorno e ogni fine settimana.\r\nAline gestisce anche 2 camere per gli ospiti."
    ],
    "fr": [
      "La Casadaline,  c'est un restaurant dans une maison, au coeur du quartier Chateauvert.\nAline vous propose une cuisine 100% maison, avec une toute petite carte qui change chaque semaine et chaque week-end.\nAline tient également 2 chambres d'hôtes."
    ],
    "nl": [
      "La Casadaline is een restaurant in een huis, in het hart van de wijk Chateauvert.\nAline biedt 100% thuiskeuken, met een kleine kaart die elke dag en elk weekend verandert.\nAline runt ook 2 gastenkamers."
    ],
    "es": [
      "La Casadaline es un restaurante en una casa, en el corazón del barrio de Chateauvert.\nAline ofrece una cocina 100% casera, con un pequeño menú que cambia cada semana y cada fin de semana.\nAline también regenta 2 habitaciones de huéspedes."
    ]
  },
  "rdfs:label": {
