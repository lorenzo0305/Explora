  "rdfs:comment": {
    "de": [
      "HORIZONS: Wenn Kunst und Natur sich verflechten! 20. Ausgabe.\r\nDas Massif du Sancy stellt seinen immensen natürlichen Reichtum in den Dienst von 10 zeitgenössischen Kunstwerken, die inmitten seiner vielfältigen und bemerkenswerten Landschaften zu entdecken sind."
    ],
    "en": [
      "HORIZONS: when Art and Nature get mixed up! 20th edition.\r\nThe Massif du Sancy honours its immense natural wealth with 10 works of contemporary art to be discovered in the heart of its varied and remarkable landscapes."
    ],
    "it": [
      "ORIZZONTI: quando Arte e Natura si incontrano! 20a edizione.\r\nIl Massiccio del Sancy celebra la sua immensa ricchezza naturale con 10 opere d'arte contemporanea, da scoprire nel cuore dei suoi paesaggi variegati e notevoli."
    ],
    "fr": [
      "HORIZONS : quand l'Art et la Nature s'emmêlent ! 20 ème édition.\r\nLe Massif du Sancy met à l'honneur son immense richesse naturelle au service de 10 œuvres d'art contemporain, à découvrir au cœur de ses paysages variés et remarquables."
    ],
    "es": [
      "HORIZONTES: ¡cuando el arte y la naturaleza se encuentran! 20ª edición.\r\nEl Macizo del Sancy celebra su inmensa riqueza natural con 10 obras de arte contemporáneo, para descubrir en el corazón de sus variados y notables paisajes."
    ],
    "nl": [
      "HORIZONS: wanneer kunst en natuur elkaar ontmoeten! 20e editie.\r\nHet Massif du Sancy viert zijn immense natuurlijke rijkdom met 10 hedendaagse kunstwerken, te ontdekken in het hart van zijn gevarieerde en opmerkelijke landschappen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Horizons - \"Arts-Nature\" en Sancy #20"
    ]
  },
