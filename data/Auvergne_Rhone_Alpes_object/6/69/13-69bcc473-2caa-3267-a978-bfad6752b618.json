  "rdfs:comment": {
    "de": [
      "Die Stadt Le Bouchet Saint Nicolas hat ein Spielzimmer aus Holz eingerichtet. Groß und Klein können hier alte oder moderne Spiele spielen. Geöffnet von März bis November. 2?/Person.\r\nUnd von April bis Oktober ist der Eintritt frei, um Ausstellungen zu entdecken."
    ],
    "en": [
      "The town of Le Bouchet Saint Nicolas has set up a wooden games room. Young and old alike can come and play old-fashioned or more modern games. Open from March to November. 2/person.\r\nAnd from April to October, admission is free to discover exhibitions."
    ],
    "it": [
      "Il comune di Le Bouchet Saint Nicolas ha allestito una sala giochi in legno. Grandi e piccini possono venire a giocare a giochi antichi o più moderni. Aperta da marzo a novembre. 2 a persona.\r\nDa aprile a ottobre, l'ingresso è gratuito per scoprire le mostre."
    ],
    "fr": [
      "La vile du Bouchet Saint Nicolas a mis en place une salle de jeux en bois. Petits et grands peuvent venir jouer aux jeux d'antan ou plus moderne. Ouvert de mars à novembre. 2€/personne.\r\nEt d'avril à octobre, l'entrée est libre pour découvrir des expos."
    ],
    "es": [
      "La ciudad de Le Bouchet Saint Nicolas ha instalado una sala de juegos de madera. Jóvenes y mayores pueden jugar a juegos antiguos o más modernos. Abierto de marzo a noviembre. 2 por persona.\r\nY de abril a octubre, la entrada es gratuita para descubrir las exposiciones."
    ],
    "nl": [
      "De stad Le Bouchet Saint Nicolas heeft een houten spelletjeskamer ingericht. Jong en oud kunnen er ouderwetse of modernere spelletjes komen spelen. Geopend van maart tot november. 2 per persoon.\r\nEn van april tot oktober is de toegang gratis om tentoonstellingen te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeux en bois et Salle d'Expositions"
    ]
  },
