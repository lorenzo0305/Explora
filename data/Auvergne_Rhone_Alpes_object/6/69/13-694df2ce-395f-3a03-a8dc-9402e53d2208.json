  "rdfs:comment": {
    "de": [
      "5000 Bücher im eigenen Bestand,\r\n   600 Bücher werden 2 Mal pro Jahr mit der Mediathek in Nyons ausgetauscht."
    ],
    "en": [
      "5000 books in-house,\r\n   600 books exchanged with the Nyons media library, twice a year."
    ],
    "it": [
      "La biblioteca offre una vasta gamma di eventi a cui i membri possono partecipare - mostre, narrazioni, conferenze, ecc. - tutti aperti a tutte le età, con l'obiettivo di scoprire nuove cose e incontrare nuove persone!"
    ],
    "fr": [
      "La bibliothèque propose aux adhérents, sur inscription des animations diverses : expositions, contes, conférences… une programmation diversifiée, pour tous les âges, avec pour objectifs découvertes et belles rencontres !"
    ],
    "es": [
      "La biblioteca ofrece a sus socios un amplio abanico de actividades -exposiciones, cuentacuentos, conferencias, etc.- abiertas a todas las edades, con el objetivo de descubrir cosas nuevas y conocer gente nueva"
    ],
    "nl": [
      "5.000 eigen boeken,\r\n   600 boeken uitgewisseld met de mediatheek van Nyons, twee keer per jaar."
    ]
  },
  "rdfs:label": {
