  "rdfs:comment": {
    "de": [
      "Machen Sie Platz für Begegnungen und Austausch und entspannen Sie sich in einem gemütlichen und angenehmen Ort auf der Seite des Teesalons am Nachmittag oder auf der Seite der Weinbar am frühen Abend. Konzertabende."
    ],
    "en": [
      "A unique place, 2 ways to enjoy it. L'accord has 4 rooms, 4 atmospheres. Tearoom - takeaway. Come to relax in a cosy place in a pleasant  tearoom in the middle of the afternoon or in a wine and cheese bar at the beginning of the evening. Evening concerts."
    ],
    "it": [
      "Fate spazio per incontri e scambi e venite a rilassarvi in un luogo accogliente e piacevole con una sala da tè a metà pomeriggio o un wine bar in prima serata. Serate di concerti."
    ],
    "fr": [
      "Faites place à la rencontre et à l’échange et venez vous détendre dans un lieu cosy et agréable côté salon de thé en milieu d’après-midi ou côté bar à vins en début de soirée. Soirées concerts."
    ],
    "nl": [
      "Maak ruimte voor ontmoeting en uitwisseling en kom tot rust op een gezellige en aangename plek aan de zijkant van de theesalon halverwege de middag of aan de zijkant van de wijnbar aan het begin van de avond. Concertavonden."
    ],
    "es": [
      "Haga un hueco para reuniones e intercambios y venga a relajarse en un lugar acogedor y agradable con un salón de té a media tarde o un bar de vinos a primera hora de la noche. Tardes de concierto."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Accord, ambient Bar"
    ],
    "fr": [
      "L'Accord - Bar à ambiance"
    ],
    "nl": [
      "Bar het akkoord"
    ]
  },
