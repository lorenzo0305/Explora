  "rdfs:comment": {
    "de": [
      "Angesiedelt im 2 Hektar großen Park F.Mitterand.\r\nDieser Aussichtspunkt bietet dank der Orientierungstafel einen herrlichen Blick auf die Isère und den Vercors als Belohnung für all diejenigen, die die Stufen zu ihm hinaufgestiegen sind."
    ],
    "en": [
      "Set in the 2-hectare Parc F.Mitterand\r\nThis viewpoint offers a splendid view of the Isère and Vercors rivers, thanks to the orientation table, as a reward for all those who have climbed the steps to reach it."
    ],
    "it": [
      "Situato nel parco F.Mitterand, di 2 ettari\r\nQuesto punto panoramico offre una splendida vista sull'Isère e sul Vercors come ricompensa per tutti coloro che hanno salito i gradini per raggiungerlo."
    ],
    "fr": [
      "Installée dans le parc F.Mitterand de 2 hectares\r\nCe belvédère offre une vue splendide grâce à la table d'orientation sur l'Isère et le Vercors en récompense à tous ceux qui ont grimpé les marches pour l'atteindre."
    ],
    "es": [
      "Situado en el Parque F.Mitterand de 2 hectáreas\r\nEste mirador ofrece una espléndida vista del Isère y del Vercors como recompensa a todos aquellos que han subido los escalones para llegar hasta él."
    ],
    "nl": [
      "Gelegen in het 2 hectare grote Parc F.Mitterand\r\nDit uitkijkpunt biedt een prachtig uitzicht over de Isère en de Vercors als beloning voor iedereen die de trappen heeft beklommen om het te bereiken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'orientation du Belvédère St Romain"
    ]
  },
