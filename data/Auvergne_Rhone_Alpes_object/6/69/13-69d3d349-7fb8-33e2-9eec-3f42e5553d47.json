  "rdfs:comment": {
    "de": [
      "Diese Kirche im neogotischen Stil wurde 1879-1880 erbaut. Die Glasfenster, die bunte Flammen darstellen, beleben den Raum je nach Tageslicht."
    ],
    "en": [
      "This neo-Gothic church was built in 1879-1880. Stained glass windows depicting multicolored flames enliven the space as the daylight falls."
    ],
    "it": [
      "Questa chiesa neogotica fu costruita nel 1879-1880. Le vetrate raffiguranti fiamme multicolori danno vita allo spazio alla luce del giorno."
    ],
    "fr": [
      "Cette église de style néo-gothique fut construite en 1879-1880. Des vitraux représentant des flammes multicolores animent espace au gré de la lumière du jour."
    ],
    "es": [
      "Esta iglesia neogótica fue construida en 1879-1880. Las vidrieras que representan llamas multicolores dan vida al espacio a la luz del día."
    ],
    "nl": [
      "Deze neogotische kerk werd gebouwd in 1879-1880. Gebrandschilderde ramen met veelkleurige vlammen verlevendigen de ruimte bij daglicht."
    ]
  },
