  "rdfs:comment": {
    "de": [
      "Snackbar vor Ort oder zum Mitnehmen, die Wagon Bar bietet abwechslungsreiche Schnellgerichte und eine große Auswahl an Getränken. Terrasse mit Blick auf den Pool des Corbier, ideal für ein schnelles Mittagessen oder einen Snack nach den Aktivitäten."
    ],
    "en": [
      "On-site or takeaway snack bar, the Wagon Bar offers a variety of fast food and a wide choice of drinks. Terrace overlooking the Le Corbier swimming pool, ideal for a quick lunch or after-work snack."
    ],
    "it": [
      "Snack bar in loco o da asporto, il Wagon Bar offre una varietà di cibi veloci e un'ampia scelta di bevande. Terrazza con vista sulla piscina Corbier, ideale per un pranzo veloce o uno spuntino dopo le attività."
    ],
    "fr": [
      "Bar snack sur place ou à emporter, le Wagon Bar propose une restauration rapide variée et un large choix de boissons. Terrasse avec vue sur la piscine du Corbier, idéale pour un déjeuner rapide ou un goûter après les activités."
    ],
    "nl": [
      "Snackbar ter plaatse of om mee te nemen, de Wagon Bar biedt een verscheidenheid aan fastfood en een ruime keuze aan drankjes. Terras met uitzicht op het zwembad van Corbier, ideaal voor een snelle lunch of snack na de activiteiten."
    ],
    "es": [
      "Snack bar in situ o para llevar, el Wagon Bar ofrece una variedad de comida rápida y una amplia selección de bebidas. Terraza con vistas a la piscina Corbier, ideal para un almuerzo rápido o un tentempié después de las actividades."
    ]
  },
