  "rdfs:comment": {
    "de": [
      "Zwanzig Minuten von Clermont-Ferrand entfernt, im Herzen des Dorfes Orléat am Kirchplatz gelegen, ist unser Restaurant stolz darauf, Sie in einer entspannten, einfachen und gutbürgerlichen Atmosphäre begrüßen zu dürfen."
    ],
    "en": [
      "Twenty minutes from Clermont-Ferrand, located in the heart of the village of Orléat, on the church square, our restaurant is proud to welcome you, in a relaxed, simple and good-natured atmosphere."
    ],
    "it": [
      "A venti minuti da Clermont-Ferrand, nel cuore del villaggio di Orléat, sulla piazza della chiesa, il nostro ristorante è orgoglioso di accogliervi in un'atmosfera rilassata, semplice e amichevole."
    ],
    "fr": [
      "A vingt minutes de Clermont-Ferrand, situé au cœur du village d'Orléat, sur la place de l'église, notre restaurant est fier de vous accueillir, dans une ambiance décontractée, simple, et bon enfant."
    ],
    "nl": [
      "Op twintig minuten van Clermont-Ferrand, gelegen in het hart van het dorp Orléat, op het kerkplein, verwelkomt ons restaurant u met trots in een ontspannen, eenvoudige en vriendelijke sfeer."
    ],
    "es": [
      "A veinte minutos de Clermont-Ferrand, situado en el corazón del pueblo de Orléat, en la plaza de la iglesia, nuestro restaurante se enorgullece de acogerle en un ambiente relajado, sencillo y acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Essentiel Bistrot Gourmand"
    ]
  },
