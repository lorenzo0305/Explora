  "rdfs:comment": {
    "de": [
      "Gotischer Weinkeller aus dem 13. Jahrhundert, an diesem ungewöhnlichen Ort, an dem Ihre Vorfahren früher gegessen haben.\nMusikalische Abende jeden Samstagabend."
    ],
    "en": [
      "13th-century Gothic cellar, where your ancestors once ate.\nMusical evenings every Saturday."
    ],
    "it": [
      "Una cantina gotica del XIII secolo, dove un tempo mangiavano i vostri antenati.\nSerate musicali ogni sabato sera."
    ],
    "fr": [
      "Cave gothique du XIIIe siècle, dans ce lieu insolite où vos ancêtres mangeaient jadis. \nSoirées musicales tous les samedis soirs."
    ],
    "es": [
      "Una bodega gótica del siglo XIII, donde una vez comieron sus antepasados.\nVeladas musicales todos los sábados por la noche."
    ],
    "nl": [
      "Een 13e-eeuwse gotische kelder, waar je voorouders ooit aten.\nElke zaterdagavond muzikale avonden."
    ]
  },
