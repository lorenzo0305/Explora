  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Technologiepark Techlid, im Herzen der Monts-d?Or und 10 km vom Stadtzentrum Lyons entfernt und wurde im Jahr 2021 eröffnet. In einem Gebäude mit einer ebenso traumhaften wie futuristischen Architektur können Sie eines der 89 Zimmer bewohnen."
    ],
    "en": [
      "Located in the Techlid technology park, in the heart of the Monts-d'Or and 10 km from Lyon city centre, the hotel opened its doors in 2021. In a building whose architecture is as dreamlike as it is futuristic, come and enjoy one of the 89 rooms."
    ],
    "it": [
      "Situato nel parco tecnologico Techlid, nel cuore del Monts-d'Or e a 10 km dal centro di Lione, l'hotel ha aperto le sue porte nel 2021. In un edificio dall'architettura tanto sognante quanto futuristica, venite a godervi una delle 89 camere."
    ],
    "fr": [
      "Situé dans le parc technologique de Techlid, au cœur des Monts-d’Or et à 10 km  du centre-ville de Lyon, l'hôtel a ouvert ses portes en 2021. Dans un immeuble à l’architecture aussi onirique que futuriste, venez profitez de l’une des 89 chambres."
    ],
    "es": [
      "Situado en el parque tecnológico Techlid, en el corazón de los Monts-d'Or y a 10 km del centro de Lyon, el hotel abrió sus puertas en 2021. En un edificio con una arquitectura tan soñadora como futurista, venga a disfrutar de una de las 89 habitaciones."
    ],
    "nl": [
      "Gelegen in het technologiepark Techlid, in het hart van de Monts-d?Or en op 10 km van het centrum van Lyon, opende het hotel in 2021 zijn deuren. Kom in een gebouw met een even dromerige als futuristische architectuur genieten van een van de 89 kamers."
    ]
  },
