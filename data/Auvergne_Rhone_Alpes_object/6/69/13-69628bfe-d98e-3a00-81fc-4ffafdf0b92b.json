  "rdfs:comment": {
    "de": [
      "Ideal gelegen am Fuße des Grand Massif und vor den Toren des Mont-Blanc, zwischen Sallanches und Cluses, im Herzen des Arve-Tals.\r\nEignet sich hervorragend für eine Etappe, ein Wochenende mit Familie oder Freunden oder ein Seminar."
    ],
    "en": [
      "Ideally located at the foot of the Grand Massif and on the doorstep of Mont-Blanc between Sallanches and Cluses, in the heart of the Arve Valley. \r\nPerfect for a stop-over, a weekend with family or friends or a seminar."
    ],
    "it": [
      "In una posizione ideale ai piedi del Grand Massif e alle porte del Monte Bianco, tra Sallanches e Cluses, nel cuore della Vallée de l'Arve.\r\nPerfetto per un breve soggiorno, un fine settimana in famiglia o con gli amici oppure un seminario."
    ],
    "fr": [
      "Idéalement situé au pied du Grand Massif et aux portes du Mont-Blanc, entre Sallanches et Cluses, au coeur de la Vallée de l'Arve.\r\nConvient parfaitement pour une étape, un week end en famille ou entre amis ou un séminaire."
    ],
    "es": [
      "Idealmente situado a los pies del Gran Macizo y a las puertas del Mont Blanc, entre Sallanches y Cluses, en el corazón del Valle del Arve.\r\nPerfecto para una escala, un fin de semana con la familia o los amigos o un seminario."
    ],
    "nl": [
      "Ideaal gelegen aan de voet van het Grand Massif en aan de poort van de Mont Blanc, tussen Sallanches en Cluses, in het hart van het Arve-dal.\r\nPerfect voor een tussenstop, een weekend met familie of vrienden of een seminar."
    ]
  },
