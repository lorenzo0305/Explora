  "rdfs:comment": {
    "de": [
      "Das 1925 erbaute und 2016 renovierte Refuge du Mont-Joly liegt auf 2 002 m Höhe und ist das höchstgelegene Bergrestaurant im Skigebiet Evasion Mont-Blanc. Hier genießen Sie eine traditionelle und familiäre Küche, die von Josiane zusammengestellt wurde."
    ],
    "en": [
      "Built in 1925 and entirely renovated in 2016, the Refuge du Mont-Joly is located at an altitude of 2,002 m and is the highest restaurant on the Evasion Mont-Blanc ski area. Here, visitors can enjoy traditional home cuisine concocted by Josiane."
    ],
    "it": [
      "Costruito nel 1925, rinnovato nel 2016, il Refuge du Mont-Joly si trova a 2 002 m di altitudine ed è il più alto ristorante di altitudine del comprensorio sciistico Evasion Mont-Blanc. Qui potrete gustare una cucina tradizionale e familiare, preparata da Josiane."
    ],
    "fr": [
      "Construit en 1925, rénové en 2016, le Refuge du Mont-Joly se situe à 2 002 m d'altitude et est le plus haut restaurant d'altitude du domaine skiable Evasion Mont-Blanc. Vous dégusterez ici une cuisine traditionnelle et familiale, concoctée par Josiane."
    ],
    "nl": [
      "De Refuge du Mont-Joly, gebouwd in 1925 en gerenoveerd in 2016, ligt op een hoogte van 2.002 m en is het hoogst gelegen restaurant in het skigebied Evasion Mont-Blanc. Hier kunt u genieten van de traditionele, door Josiane samengestelde familiekeuken."
    ],
    "es": [
      "Construido en 1925 y renovado en 2016, el Refuge du Mont-Joly está situado a 2.002 m de altitud y es el restaurante de mayor altitud del dominio esquiable de Evasion Mont-Blanc. Aquí podrá disfrutar de una cocina tradicional y familiar elaborada por Josiane."
    ]
  },
