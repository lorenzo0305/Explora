  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit Ihrer Familie das Kulturerbe des Allier auf spielerische und pädagogische Weise mit PÉPIT!\r\nLaden Sie die App herunter, wählen Sie den Spaziergang in Diou aus, beantworten Sie die Rätsel und finden Sie den Schatz!"
    ],
    "en": [
      "Discover the Allier region's heritage in a fun and educational way with PÉPIT!\r\nDownload the app, select the Diou walk, answer the riddles and find the treasure!"
    ],
    "it": [
      "Scoprite il patrimonio dell'Allier in famiglia in modo divertente ed educativo con PÉPIT!\r\nScaricate l'app, selezionate la passeggiata di Diou, rispondete agli indovinelli e trovate il tesoro!"
    ],
    "fr": [
      "Découvrez le patrimoine de l'Allier en famille de façon ludique et pédagogique avec PÉPIT !\r\nTéléchargez l'application, sélectionnez la balade de Diou, répondez aux énigmes et trouvez le trésor !"
    ],
    "es": [
      "¡Descubre el patrimonio del Allier en familia de forma lúdica y pedagógica con PÉPIT!\r\nDescárgate la aplicación, selecciona el paseo Diou, responde a las adivinanzas y ¡encuentra el tesoro!"
    ],
    "nl": [
      "Ontdek als gezin het erfgoed van de Allier op een leuke en leerzame manier met PÉPIT!\r\nDownload de app, kies de Diou-wandeling, beantwoord de raadsels en vind de schat!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "PÉPIT : Carburez entre fleuve et canal"
    ]
  },
