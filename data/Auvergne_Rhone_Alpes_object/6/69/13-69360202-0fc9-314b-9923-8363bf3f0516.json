  "rdfs:comment": {
    "de": [
      "Geben Sie Ihre Bestellung 72 Stunden im Voraus per Telefon oder auf unserer Website auf. Holen Sie Ihr Gebäck in unserem Atelier oder auf den Märkten ab.\r\nLieferung auf Anfrage (siehe Bedingungen auf der Website)\r\nMarkt am Donnerstagmorgen in Saint Jean en Royans."
    ],
    "en": [
      "Place your order 72 hours in advance by phone or on our website. Pick up your pastries in our workshop or at the market.\r\nDelivery on request (see conditions on website)\r\nThursday morning market in Saint Jean en Royans."
    ],
    "it": [
      "Effettuate l'ordine con 72 ore di anticipo per telefono o sul nostro sito web. Ritirate i vostri dolci nel nostro laboratorio o al mercato.\r\nConsegna su richiesta (vedere le condizioni sul sito web)\r\nMercato del giovedì mattina a Saint Jean en Royans."
    ],
    "fr": [
      "Passez commande 72h à l'avance par téléphone ou sur notre site internet. Récupérez vos pâtisseries à notre atelier ou sur les marchés.\r\nLivraison sur demande (voir conditions sur le site internet)\r\nMarché jeudi matin à Saint Jean en Royans."
    ],
    "nl": [
      "Plaats je bestelling 72 uur van tevoren per telefoon of op onze website. Haal je gebak op in ons atelier of op de markt.\r\nLevering op aanvraag (zie voorwaarden op de website)\r\nDonderdagochtend markt in Saint Jean en Royans."
    ],
    "es": [
      "Haga su pedido con 72 horas de antelación por teléfono o en nuestra página web. Recoja sus pasteles en nuestro obrador o en el mercado.\r\nEntrega por encargo (consulte las condiciones en el sitio web)\r\nMercado del jueves por la mañana en Saint Jean en Royans."
    ]
  },
