  "rdfs:comment": {
    "de": [
      "Das städtische Schwimmbad Les bannettes, ein Hallenbad mit abnehmbarem Dach, einem 25-Meter-Becken, Wasserlinien für Schwimmer, Spielen im Sommer, einer Terrasse und einem Rasen zum Entspannen. Aufblasbarer Parcours an jedem Nachmittag im Sommer."
    ],
    "en": [
      "A covered swimming pool with a removable roof, a 25-metre pool, water lines for swimmers, summer games, a terrace and a lawn for relaxing. Inflatable course every afternoon in summer."
    ],
    "it": [
      "Piscina comunale di Les bannettes, una piscina coperta con tetto rimovibile, una vasca di 25 metri, linee d'acqua per i nuotatori, giochi estivi, una terrazza e un prato per rilassarsi. Corso di gonfiabili tutti i pomeriggi d'estate."
    ],
    "fr": [
      "La piscine municipale Les bannettes, une piscine couverte avec toit amovible, un bassin de 25 mètres, des lignes d’eau pour les nageurs, des jeux l'été, une terrasse et une pelouse pour se détendre. Parcours gonflable tous les après-midi de l'été."
    ],
    "es": [
      "Piscina municipal Les bannettes, piscina cubierta con techo desmontable, piscina de 25 metros, líneas de agua para nadadores, juegos de verano, terraza y césped para relajarse. Recorrido hinchable todas las tardes en verano."
    ],
    "nl": [
      "Gemeentelijk zwembad Les bannettes, een overdekt zwembad met een afneembaar dak, een 25-meterbad, waterlijnen voor zwemmers, zomerspelen, een terras en een grasveld om te ontspannen. Opblaasparcours elke middag in de zomer."
    ]
  },
