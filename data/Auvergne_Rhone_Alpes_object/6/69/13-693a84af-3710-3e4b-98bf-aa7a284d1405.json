  "rdfs:comment": {
    "de": [
      "Dieses Bergdorf ist voller Charme und bietet viel zu entdecken. Es ist vor allem für sein Fête des Fromages de Traditions berühmt, das jedes Jahr zahlreiche Besucher anzieht."
    ],
    "en": [
      "This mountain village is full of charm and discovery. It is famous for its traditional cheese festival, which attracts many visitors every year."
    ],
    "it": [
      "Questo villaggio di montagna è pieno di fascino e ricco di scoperte. È famosa per il suo tradizionale festival del formaggio, che attira ogni anno molti visitatori."
    ],
    "fr": [
      "Ce village de montagne est plein de charme et riche en découverte. Il est notamment célèbre pour sa Fête des Fromages de Traditions qui attire chaque année de nombreux visiteurs."
    ],
    "es": [
      "Este pueblo de montaña está lleno de encanto y descubrimientos. Es famoso por su tradicional fiesta del queso, que atrae cada año a un gran número de visitantes."
    ],
    "nl": [
      "Dit bergdorp is vol charme en rijk aan ontdekkingen. Het is beroemd om zijn traditionele kaasfestival, dat elk jaar veel bezoekers trekt."
    ]
  },
