  "rdfs:comment": {
    "de": [
      "Eichenwald, in der Nähe des Bauernhofs Roubion (früher Taubenschlag genannt), der im 17. Jahrhundert ein Ort der Wüstenverehrung war."
    ],
    "en": [
      "Oak woods, near the Roubion farm (formerly known as the Pigeonnier), a place of desert worship in the 17th century."
    ],
    "it": [
      "Bosco di querce, vicino alla fattoria Roubion (anticamente chiamata Pigeonnier), luogo di culto nel deserto nel XVII secolo."
    ],
    "fr": [
      "Bois de chênes, à proximité de la ferme Roubion (appelée autrefois le Pigeonnier), lieu de culte au désert au 17ème siècle."
    ],
    "nl": [
      "Eikenbos, vlakbij de boerderij Roubion (vroeger bekend als de Duiventil), een bedehuis in de woestijn in de 17e eeuw."
    ],
    "es": [
      "Bosque de robles, cerca de la granja Roubion (antiguamente llamada Pigeonnier), lugar de culto en el desierto en el siglo XVII."
    ]
  },
