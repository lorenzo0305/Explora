  "rdfs:comment": {
    "de": [
      "Pub l'Étable in Chamrousse 1700 - Bachat, lokale und gesellige Atmosphäre!\r\nSommer 2024: Mittags- und Abendverpflegung, täglich geöffnet, Reservierung empfohlen unter 06 84 74 87 17 (nicht per Mail oder soziale Netzwerke).\r\nPub ab 21 Uhr."
    ],
    "en": [
      "Pub l'Étable in Chamrousse 1700 - Bachat, local and friendly atmosphere!\r\nSummer 2024: lunch and dinner, open every day, reservations recommended on 06 84 74 87 17 (not by e-mail or social networks).\r\nPub from 9pm."
    ],
    "it": [
      "Pub l'Étable a Chamrousse 1700 - Bachat, locale e atmosfera amichevole!\r\nEstate 2024: pranzo e cena, aperto tutti i giorni, prenotazione consigliata allo 06 84 74 87 17 (non via e-mail o social network).\r\nPub dalle 21:00."
    ],
    "fr": [
      "Pub l'Étable à Chamrousse 1700 - Bachat, ambiance locale et conviviale !\r\nÉté 2024 : restauration midi et soir, ouvert tous les jours, réservation conseillé au 06 84 74 87 17 (pas par mail, ni réseaux sociaux).\r\nPub à partir de 21h."
    ],
    "es": [
      "¡Pub l'Étable en Chamrousse 1700 - Bachat, ambiente local y acogedor!\r\nVerano 2024: almuerzo y cena, abierto todos los días, se recomienda reservar en el 06 84 74 87 17 (no por correo electrónico ni redes sociales).\r\nPub a partir de las 21h."
    ],
    "nl": [
