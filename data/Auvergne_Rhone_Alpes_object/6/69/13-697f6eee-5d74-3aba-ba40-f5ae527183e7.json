  "rdfs:comment": {
    "de": [
      "Restaurant zum Entdecken.\r\nGenießen Sie eine ehrliche Küche in einer warmen und authentischen Umgebung.\r\nEntspannte Atmosphäre und raffinierte Küche.\r\nAlles ist hausgemacht!"
    ],
    "en": [
      "Discovery restaurant.\r\nCome and enjoy sincere cuisine in a warm, authentic setting.\r\nRelaxed atmosphere and refined cuisine.\r\nAll homemade!"
    ],
    "it": [
      "Ristorante Discovery.\r\nVenite a gustare una cucina genuina in un ambiente caldo e autentico.\r\nAtmosfera rilassata e cucina raffinata.\r\nTutto fatto in casa!"
    ],
    "fr": [
      "Restaurant de découverte. \r\nVenez déguster une cuisine sincère dans un cadre chaleureux et authentique. \r\nAmbiance décontractée et cuisine raffinée.\r\nTout est fait maison !"
    ],
    "es": [
      "Restaurante Discovery.\r\nVenga a disfrutar de una cocina genuina en un ambiente cálido y auténtico.\r\nAmbiente relajado y cocina refinada.\r\n¡Todo casero!"
    ],
    "nl": [
      "Ontdekkingsrestaurant.\r\nKom genieten van de authentieke keuken in een warme, authentieke omgeving.\r\nOntspannen sfeer en verfijnde keuken.\r\nAlles huisgemaakt!"
    ]
  },
  "rdfs:label": {
