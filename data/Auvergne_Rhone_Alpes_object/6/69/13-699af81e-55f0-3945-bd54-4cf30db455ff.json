  "rdfs:comment": {
    "de": [
      "Dorf Collat: Kirche aus dem 15. Jahrhundert, Zwischenstation der Mönche auf dem Weg von La Chaise-Dieu nach Chanteuges. Verschiedenes kleines Kulturerbe."
    ],
    "en": [
      "Village of Collat: 15th-century church. 13th-century stopover for monks on their way from La Chaise-Dieu to Chanteuges. Various small heritage sites."
    ],
    "it": [
      "Villaggio di Collat: chiesa del XV secolo. Nel XIII secolo, tappa dei monaci in viaggio da La Chaise-Dieu a Chanteuges. Diversi piccoli siti del patrimonio."
    ],
    "fr": [
      "Village de Collat : Église du XVe siècle. Au XIIIe siècle, étape des moines sur le chemin de la Chaise-Dieu à Chanteuges. Petit patrimoine divers."
    ],
    "es": [
      "Pueblo de Collat: iglesia del siglo XV. En el siglo XIII, parada de los monjes en su camino de La Chaise-Dieu a Chanteuges. Varios pequeños lugares patrimoniales."
    ],
    "nl": [
      "Dorp Collat: kerk uit de 15e eeuw. In de 13e eeuw een stopplaats voor monniken op weg van La Chaise-Dieu naar Chanteuges. Verschillende kleine erfgoedsites."
    ]
  },
  "rdfs:label": {
