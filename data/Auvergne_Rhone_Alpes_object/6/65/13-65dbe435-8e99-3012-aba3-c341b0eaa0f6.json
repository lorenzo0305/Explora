  "rdfs:comment": {
    "de": [
      "La popote de l'équipage ist ein partizipatives und solidarisches Restaurant, das von Freiwilligen und einer Betreuerin des Sozialzentrums geführt wird. Sein Ziel: Gäste mit guter Laune und in aller Einfachheit zu bewirten."
    ],
    "en": [
      "La popote de l'équipage is a participatory restaurant run by volunteers and a social center coordinator. The aim is to welcome guests in a friendly and simple atmosphere."
    ],
    "it": [
      "La popote de l'équipage è un ristorante comunitario gestito da volontari e da un operatore del centro sociale. L'obiettivo è accogliere gli ospiti in un'atmosfera amichevole e informale."
    ],
    "fr": [
      "La popote de l'équipage est un restaurant participatif et solidaire tenu par des bénévoles et une animatrice du centre social. Son objectif : accueillir des convives dans la bonne humeur et en toute simplicité."
    ],
    "nl": [
      "La popote de l'équipage is een gemeenschapsrestaurant dat wordt gerund door vrijwilligers en een medewerker van het sociaal centrum. Het doel is om gasten te ontvangen in een vriendelijke en informele sfeer."
    ],
    "es": [
      "La popote de l'équipage es un restaurante comunitario dirigido por voluntarios y un trabajador del centro social. El objetivo es acoger a los clientes en un ambiente cordial e informal."
    ]
  },
