  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese wunderschöne, familienfreundliche Route auf den Balkonen der Wilden Loire. Sie haben das Glück, eine überraschende Streckenführung zu entdecken, die insbesondere durch 5 Tunnel führt!"
    ],
    "en": [
      "This is a wonderful, family-friendly “green way” on the hills above the untamed River Loire. A chance to experience a surprising trail including 5 tunnels!"
    ],
    "it": [
      "Scoprite questo superbo itinerario sui balconi della Loira Sauvage adattato alla famiglia. Avrete la possibilità di scoprire un percorso sorprendente con 5 gallerie!"
    ],
    "fr": [
      "Découvrez ce superbe itinéraire sur les balcons de la Loire Sauvage adapté à la famille. Vous aurez la chance de découvrir un tracé surprenant empruntant notamment 5 tunnels !"
    ],
    "nl": [
      "Ontdek deze prachtige route op de balkons van de Loire Sauvage aangepast aan het gezin. U krijgt de kans om een verrassende route met 5 tunnels te ontdekken!"
    ],
    "es": [
      "Descubra este magnífico itinerario en los balcones del Loira Sauvage adaptado a la familia. ¡Tendrá la oportunidad de descubrir una ruta sorprendente con 5 túneles!"
    ]
  },
