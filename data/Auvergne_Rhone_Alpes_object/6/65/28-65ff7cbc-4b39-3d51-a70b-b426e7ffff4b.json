  "rdfs:comment": {
    "de": [
      "Kostenlos - Reservierung erforderlich - Erwachsene (ab 16 Jahren).\nPatricia Soufflet, zertifizierte Referentin, wird eine neue Sitzung zum Thema Frühling anbieten.\nFür alle, ab 16 Jahren | Anmeldung bei der Bibliothek erforderlich\nBitte bringen Sie eine kleine Matte, ein Kissen und ein Handtuch mit."
    ],
    "en": [
      "Free - Reservations required - Adults (aged 16 and over).\nPatricia Soufflet, certified instructor, will offer a new session on the theme of Spring.\nAll ages, 16 and over | Registration required at the Library\nPlease bring a small floor mat, a cushion and a towel."
    ],
    "it": [
      "Gratuito - Prenotazione obbligatoria - Adulti (a partire dai 16 anni).\nPatricia Soufflet, istruttrice certificata, proporrà una nuova sessione sul tema della primavera.\nAperta a tutti, a partire dai 16 anni | Iscrizione obbligatoria presso la Biblioteca\nSi prega di portare un tappetino, un cuscino e un asciugamano."
    ],
    "fr": [
      "Gratuit - Réservation obligatoire - Adultes (à partir de 16 ans).\nPatricia Soufflet, intervenante certifiée, proposera une nouvelle séance sur le thème du Printemps.\nTout public, à partir de 16 ans | Inscription impérative auprès de la Bibliothèque\nMerci aux participants-es de se munir d’un petit tapis de sol, d’un coussin et d’une serviette."
    ],
    "es": [
      "Gratuito - Imprescindible reservar - Adultos (a partir de 16 años).\nPatricia Soufflet, monitora titulada, ofrecerá una nueva sesión sobre el tema de la primavera.\nAbierto a todos, a partir de 16 años | Inscripción previa en la Biblioteca\nSe ruega traer una esterilla, un cojín y una toalla."
    ],
    "nl": [
      "Gratis - Reserveren noodzakelijk - Volwassenen (vanaf 16 jaar).\nPatricia Soufflet, gediplomeerd instructeur, biedt een nieuwe sessie over het thema lente.\nOpen voor iedereen vanaf 16 jaar | Aanmelding vereist in de bibliotheek\nNeem een kleine vloermat, een kussen en een handdoek mee."
    ]
  },
