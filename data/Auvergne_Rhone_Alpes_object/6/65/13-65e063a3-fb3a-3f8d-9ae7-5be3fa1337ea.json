  "rdfs:comment": {
    "de": [
      "Es handelt sich um eine kurze, aber technische Steigung, die auf den Anhöhen von Ste Uze beginnt. Wir empfehlen Ihnen, im Dorf Ste Uze zu parken und zu Fuß zum eigentlichen Startpunkt zu gehen, um sich aufzuwärmen."
    ],
    "en": [
      "This is a short but technical uphill workshop starting from the heights of Ste Uze. We advise you to park in the village of Ste Uze and walk up to the actual start to warm up."
    ],
    "it": [
      "Si tratta di un workshop breve ma tecnico in salita che parte dalle alture di Ste Uze. Si consiglia di parcheggiare nel villaggio di Ste Uze e di salire a piedi fino alla partenza vera e propria per riscaldarsi."
    ],
    "fr": [
      "Il s'agit d'un atelier côte courte mais technique au départ des hauteurs de Ste Uze. Nous vous conseillons de vous garer au village de Ste Uze et monter tranquillement à pied jusqu'au départ réel pour vous echauffer tranquillement."
    ],
    "es": [
      "Se trata de un taller corto pero técnico que comienza en las alturas de Ste Uze. Te recomendamos que aparques en el pueblo de Ste Uze y camines hasta la salida para calentar."
    ],
    "nl": [
      "Dit is een korte maar technische bergopwaartse workshop die begint op de hoogten van Ste Uze. We raden je aan te parkeren in het dorp Ste Uze en naar de eigenlijke start te lopen om op te warmen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Côte St Uze"
    ]
  },
