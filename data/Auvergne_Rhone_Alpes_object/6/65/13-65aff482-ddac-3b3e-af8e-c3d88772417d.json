  "rdfs:comment": {
    "de": [
      "Traditionelles Feinschmeckerrestaurant, hausgemachte Küche mit frischen, saisonalen Produkten.\r\nLe Pontvys empfängt Sie in einem gemütlichen Ambiente mit einer ruhigen Terrasse mit Blick auf den Garten und die Berge."
    ],
    "en": [
      "With a new design, the restaurant le Pontvys is ready to welcome you.The chef will create for you delicious and handmade dishes with fresh products.  You can make up your own menu with our various dishes"
    ],
    "it": [
      "Ristorante tradizionale e gourmet, cucina casalinga con prodotti freschi e di stagione.\r\nIl Pontvys vi accoglie in un'atmosfera accogliente con una tranquilla terrazza che si affaccia sul giardino e sulle montagne."
    ],
    "fr": [
      "Restaurant traditionnel et gourmand, cuisine maison à base de produits frais et de saison.\r\nLe Pontvys vous accueille dans une ambiance cosy avec une terrasse au calme avec vue sur le jardin et les montagnes."
    ],
    "nl": [
      "Traditioneel en gastronomisch restaurant, huiselijke keuken met verse en seizoensgebonden producten.\r\nDe Pontvys ontvangt u in een gezellige sfeer met een rustig terras met uitzicht op de tuin en de bergen."
    ],
    "es": [
      "Restaurante tradicional y gastronómico, cocina casera con productos frescos y de temporada.\r\nEl Pontvys le da la bienvenida en un ambiente acogedor con una tranquila terraza con vistas al jardín y a las montañas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Le Pontvys"
    ],
    "fr": [
      "Restaurant Le Pontvys"
    ]
  },
