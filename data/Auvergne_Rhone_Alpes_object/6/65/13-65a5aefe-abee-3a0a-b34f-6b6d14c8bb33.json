  "rdfs:comment": {
    "de": [
      "Anlässlich des Frühlings der Poesie präsentiert L'Embellie eine neue Ausstellung mit dem Titel Encres, Écrits et Marbres (Tinten, Schriften und Marmor), in deren Verlauf Sie Tinten, Künstlerbücher und gravierte Marmorskulpturen sehen können."
    ],
    "en": [
      "To mark the springtime of poetry, l'Embellie presents a new exhibition entitled Encres, Écrits et Marbres, featuring inks, artist's books and engraved marbles."
    ],
    "it": [
      "In occasione della stagione poetica primaverile, l'Embellie allestisce una nuova mostra intitolata Encres, Écrits et Marbres, con inchiostri, libri d'artista e marmi incisi."
    ],
    "fr": [
      "À l'occasion du printemps de la poésie, l'Embellie vous propose une nouvelle exposition intitulée Encres, Écrits et Marbres, au cours de laquelle vous pourrez voir encres, livres d'artiste et marbres gravés."
    ],
    "nl": [
      "Ter gelegenheid van het poëzieseizoen in de lente organiseert l'Embellie een nieuwe tentoonstelling met de titel Encres, Écrits et Marbres, met inkt, kunstenaarsboeken en gegraveerde knikkers."
    ],
    "es": [
      "Con motivo de la temporada poética de primavera, l'Embellie organiza una nueva exposición titulada Encres, Écrits et Marbres, con tintas, libros de artista y mármoles grabados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Expo Encres, Écrits et marbres"
    ]
  },
