  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a267e1d8-83a1-3455-ab04-e1f02e9d7f8a",
      "dc:description": {
        "de": [
          "Verkauf von Lederwaren und Accessoires an Privatpersonen.\nRenommierte Leder- und Textilmarken exklusiv in der Gegend\n\nAnsatz \"Null Plastik\", \"Ökologischer Haushalt/100% Natur\""
        ],
        "en": [
          "Sales of leather goods and personal accessories.\nFamous leather and textile brands exclusively in the area\n\nZero plastic\", \"Ecological household/100% natural\" approach"
        ],
        "it": [
          "Vendita di articoli di pelletteria e accessori personali.\nFamosi marchi di pelletteria e tessili in esclusiva per il settore\n\nApproccio \"Zero plastica\", \"Casa ecologica/100% naturale\""
        ],
        "fr": [
          "Ventes d'articles de maroquinerie et d'accessoires à la personne.\nMarques renommées de cuir et textile en exclusivité sur le secteur\n\nDémarche \"Zéro plastique\", \"Ménage écologique/100% naturel\""
        ],
        "nl": [
          "Verkoop van lederwaren en persoonlijke accessoires.\nBekende leer- en textielmerken exclusief in de sector\n\nZero plastic\", \"Ecologisch huishouden/100% natuurlijk\" benadering"
        ],
        "es": [
          "Venta de artículos de cuero y accesorios personales.\nFamosas marcas de cuero y textil exclusivas del sector\n\nPlástico cero\", enfoque \"Hogar ecológico/100% natural"
        ]
      },
      "@type": [
        "Description"
      ],
