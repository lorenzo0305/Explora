  "rdfs:comment": {
    "de": [
      "Ausgehend vom Dorf Portes-en-Valdaine verlässt die Route schnell die kleinen Straßen und führt auf Pfade und einen langen Anstieg bis zu den Kämmen des Dorfes Aleyrac im Herzen des Waldes."
    ],
    "en": [
      "Departing from the village of Portes-en-Valdaine, the route quickly leaves the back roads for trails and a long ascent to the crests of the village of Aleyrac in the heart of the forest."
    ],
    "it": [
      "Partendo dal villaggio di Portes-en-Valdaine, il percorso lascia rapidamente le strade secondarie per i sentieri e una lunga salita fino alle creste del villaggio di Aleyrac, nel cuore della foresta."
    ],
    "fr": [
      "Au départ du village de Portes-en-Valdaine, l'itinéraire quitte rapidement les petites routes pour rejoindre les sentiers et une longue ascension jusqu'aux crêtes du village d'Aleyrac au coeur de la forêt."
    ],
    "nl": [
      "Vanuit het dorp Portes-en-Valdaine verlaat de route snel de binnenwegen voor de wandelpaden en een lange klim naar de kammen van het dorp Aleyrac in het hart van het bos."
    ],
    "es": [
      "Partiendo del pueblo de Portes-en-Valdaine, la ruta abandona rápidamente las carreteras secundarias para adentrarse en los senderos y en un largo ascenso hasta las crestas del pueblo de Aleyrac, en el corazón del bosque."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les crêtes d'Aleyrac"
    ]
  },
