  "rdfs:comment": {
    "de": [
      "Auf dieser sehr angenehmen Wanderung tauchen Sie in das Herz des Naturschutzgebiets des Marais de Lavours ein. Sie können seine Schönheit und seinen Reichtum genießen. Seien Sie aufmerksam und unauffällig, denn zu jeder Stunde und zu jeder Jahreszeit ist im Sumpf etwas los."
    ],
    "en": [
      "This very pleasant walk will plunge you into the heart of the Lavours Marsh Nature Reserve. You'll be able to appreciate its beauty and richness. Be attentive and discreet... at every hour and in every season, something is happening in the marsh."
    ],
    "it": [
      "Questa piacevolissima passeggiata vi immergerà nel cuore della Riserva Naturale di Lavours Marsh. Potrete apprezzarne la bellezza e la ricchezza. Siate attenti e discreti... a ogni ora e in ogni stagione, nella palude succede qualcosa."
    ],
    "fr": [
      "Cette promenade très agréable vous plongera au cœur de la Réserve Naturelle du marais de Lavours. Vous pourrez apprécier sa beauté et sa richesse. Soyez attentifs et discrets… à chaque heure et à chaque saison, il se passe des choses dans le marais."
    ],
    "es": [
      "Este agradable paseo le sumergirá en el corazón de la Reserva Natural de Lavours Marsh. Podrá apreciar su belleza y su riqueza. Esté atento y sea discreto... a cada hora y en cada estación, algo ocurre en la marisma."
    ],
    "nl": [
      "Deze zeer aangename wandeling dompelt je onder in het hart van het natuurreservaat Lavours Marsh. U zult de schoonheid en rijkdom ervan kunnen waarderen. Wees aandachtig en discreet... op elk uur en in elk seizoen gebeurt er iets in het moeras."
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum of the Lavours natural reserve"
    ],
    "fr": [
      "Maison du Marais de Lavours"
    ]
  },
