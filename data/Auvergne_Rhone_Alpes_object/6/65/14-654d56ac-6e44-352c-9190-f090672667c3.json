  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f045dd27-ee66-38e3-9907-2a0a0a853638",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 9:00 bis 12:15 Uhr und von 14:00 bis 19:15 Uhr\nSamstags von 9:00 bis 13:00 Uhr\n\nSonntag geschlossen\n \n Abholung :\n\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 9am to 12:15pm and 2pm to 7:15pm\nSaturday 9am to 1pm\n\nClosed on Sunday\n \n Collection:\n\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 9.00 alle 12.15 e dalle 14.00 alle 19.15\nSabato dalle 9.00 alle 13.00\n\nChiuso la domenica\n \n Ritiro:\n\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 9h à 12h15 et de 14h à 19h15\nLe samedi de 9h à 13h\n\nFermeture le dimanche\n \n Retrait :\n\nAux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag van 9u tot 12u15 en van 14u tot 19u15\nZaterdag van 9 tot 13 uur\n\nZondag gesloten\n \n Ophalen:\n\nTijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 9.00 a 12.15 h. y de 14.00 a 19.15 h\nSábado de 9h a 13h\n\nDomingos cerrado\n \n Recogida:\n\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
