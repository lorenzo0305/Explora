  "rdfs:comment": {
    "de": [
      "Wir sind ein Restaurant im Stadtzentrum von Clermont-Ferrand und möchten die Kombination von Käse und Wein demokratisieren, indem wir sie auf spielerische Weise für alle zugänglich machen.\r\nWir bieten Team Buildings, Buffets und Raumvermietung für Versammlungen an."
    ],
    "en": [
      "A restaurant in downtown Clermont-Ferrand, we aim to democratize cheese and wine pairings by making them accessible to everyone, in a fun way.\r\nWe offer team-building events, buffets and meeting room rentals."
    ],
    "it": [
      "Come ristorante nel centro di Clermont-Ferrand, il nostro obiettivo è democratizzare gli abbinamenti di formaggi e vini rendendoli accessibili a tutti in modo divertente.\r\nOffriamo eventi di team building, buffet e affitto di sale per riunioni."
    ],
    "fr": [
      "Restaurant du centre-ville de Clermont-Ferrand, nous souhaitons démocratiser les mariages entre fromages et vins en les rendant accessibles à tous, de façon ludique.\r\nNous proposons des team buildings, des buffets et location de salle pour réunion."
    ],
    "es": [
      "Como restaurante en el centro de Clermont-Ferrand, nuestro objetivo es democratizar los maridajes de queso y vino haciéndolos accesibles a todo el mundo de forma divertida.\r\nOfrecemos eventos de team building, buffets y alquiler de salas para reuniones."
    ],
    "nl": [
      "Als restaurant in het centrum van Clermont-Ferrand willen we kaas- en wijnarrangementen democratiseren door ze op een leuke manier voor iedereen toegankelijk te maken.\r\nWe bieden teambuildingevenementen, buffetten en zaalverhuur voor vergaderingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Petits Crus"
    ]
  },
