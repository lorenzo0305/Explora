  "rdfs:comment": {
    "de": [
      "An der Kreuzung von Burgund, Auvergne und Berry finden Sie in dieser ehemaligen Poststation, die komplett renoviert wurde, einen herzlichen Empfang, Ruhe und ein gutes Essen."
    ],
    "en": [
      "At the crossroads of Burgundy, Auvergne and Berry, you will find a warm welcome, peace and quiet and a quality table in this former post house completely renovated."
    ],
    "it": [
      "Al crocevia tra Borgogna, Alvernia e Berry, troverete un'accoglienza calorosa, pace e tranquillità e una tavola di qualità in questa ex casa postale completamente ristrutturata."
    ],
    "fr": [
      "Au carrefour de la Bourgogne, de l'Auvergne et du Berry, vous trouverez un accueil chaleureux, le calme et une table de qualité dans cet ancien relais de poste complètement rénové."
    ],
    "nl": [
      "Op het kruispunt van Bourgogne, Auvergne en Berry vindt u een warm welkom, rust en een kwaliteitstafel in dit voormalige posthuis dat volledig is gerenoveerd."
    ],
    "es": [
      "En la encrucijada de Borgoña, Auvernia y Berry, encontrará una cálida acogida, tranquilidad y una mesa de calidad en esta antigua casa de postas completamente renovada."
    ]
  },
