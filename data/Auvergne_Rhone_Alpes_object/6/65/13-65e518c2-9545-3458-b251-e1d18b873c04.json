  "rdfs:comment": {
    "de": [
      "Das Maison des Jeunes et de la Culture und Sozialzentrum im Stadtteil Fontbouillant bietet zwei Veranstaltungssäle mit 350 und 750 Plätzen, aber auch über 30 kulturelle Aktivitäten pro Woche.\r\nNeuheit 2025: K-Pop-Tanzkurs für 8- bis 13-Jährige."
    ],
    "en": [
      "The Maison des Jeunes et de la Culture and social center in the Fontbouillant district offers 2 performance halls with 350 and 750 seats, as well as over 30 cultural activities a week.\r\nNew for 2025: K-Pop dance classes for 8-13 year-olds."
    ],
    "it": [
      "La Maison des Jeunes et de la Culture e il centro sociale nel quartiere di Fontbouillant offrono 2 sale per spettacoli da 350 e 750 posti, oltre a più di 30 attività culturali a settimana.\r\nNovità del 2025: corsi di danza K-Pop per ragazzi dagli 8 ai 13 anni."
    ],
    "fr": [
      "La Maison des Jeunes et de la Culture et centre social dans le quartier de Fontbouillant propose 2 salles de spectacle de 350 et 750 places, mais aussi plus de 30 activités culturelles par semaine.\r\nNouveauté 2025 : cours de danse K-Pop pour les 8-13 ans."
    ],
    "es": [
      "La Maison des Jeunes et de la Culture y centro social del barrio de Fontbouillant ofrece 2 salas de espectáculos con 350 y 750 localidades, así como más de 30 actividades culturales a la semana.\r\nNovedad para 2025: clases de baile K-Pop para niños de 8 a 13 años."
    ],
    "nl": [
      "Het Maison des Jeunes et de la Culture en sociaal centrum in de wijk Fontbouillant biedt 2 zalen met 350 en 750 zitplaatsen en meer dan 30 culturele activiteiten per week.\r\nNieuw in 2025: K-Pop danslessen voor kinderen van 8-13 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison des jeunes et de la culture / Centre social"
    ]
  },
