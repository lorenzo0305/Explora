  "rdfs:comment": {
    "de": [
      "Votivdenkmal für die Dichterin Anna de Noailles. Der Votivgarten führt hinunter zum Ufer und ist unter einem kleinen Denkmal in Form einer Rotunde mit einer Gedenkstele geschmückt. Öffentlicher Park, der das ganze Jahr über geöffnet ist."
    ],
    "en": [
      "Votive monument to the poetess Anna de Noailles. The votive garden slopes down to the shore, adorned with a commemorative stele beneath a small rotunda-shaped monument. Public park open all year round."
    ],
    "it": [
      "Monumento votivo alla poetessa Anna de Noailles. Il giardino votivo degrada verso la riva, ornato da un piccolo monumento a forma di rotonda e da una stele commemorativa. Parco pubblico aperto tutto l'anno."
    ],
    "fr": [
      "Monument votif à la Poétesse Anna de Noailles. Le jardin votif descend vers le rivage, orné, sous un petit monument en forme de rotonde, d'une stèle commémorative. Parc public ouvert toute l'année."
    ],
    "nl": [
      "Votiefmonument voor de dichteres Anna de Noailles. De votieftuin loopt af naar de kust en is versierd met een gedenksteen onder een klein rotondevormig monument. Openbaar park het hele jaar geopend."
    ],
    "es": [
      "Monumento votivo a la poetisa Anna de Noailles. El jardín votivo desciende hasta la orilla, adornado con un pequeño monumento en forma de rotonda y una estela conmemorativa. Parque público abierto todo el año."
    ]
  },
  "rdfs:label": {
    "en": [
      "Votive monument Anna De Noailles"
    ],
    "fr": [
      "Monument votif Anna De Noailles"
    ],
    "nl": [
      "Anna De Noailles Votief Monument"
    ]
  },
