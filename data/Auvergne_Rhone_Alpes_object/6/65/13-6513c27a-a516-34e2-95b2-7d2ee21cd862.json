  "rdfs:comment": {
    "de": [
      "Am Ufer des Sees von Annecy in einer idyllischen Umgebung, in der die Blautöne ineinander übergehen, empfängt Sie das gesamte Team von Bleu 1801 für einen Moment außerhalb der Zeit."
    ],
    "en": [
      "Situated on the shores of Lake Annecy in an idyllic setting where shades of blue blend together, the entire Bleu 1801 team welcomes you for a moment out of time."
    ],
    "it": [
      "Situato sulle rive del lago di Annecy, in un ambiente idilliaco dove le sfumature di blu si fondono, l'intero team del Bleu 1801 vi accoglie per un momento senza tempo."
    ],
    "fr": [
      "Situé au bord du lac d’Annecy dans un cadre idyllique où les camaïeux de bleu se confondent, toute l’équipe de Bleu 1801 vous accueille pour un moment hors du temps."
    ],
    "es": [
      "Situado a orillas del lago de Annecy, en un entorno idílico donde se mezclan los tonos azules, todo el equipo de Bleu 1801 le da la bienvenida para vivir un momento intemporal."
    ],
    "nl": [
      "Gelegen aan de oevers van het meer van Annecy in een idyllische omgeving waar blauwe tinten in elkaar overvloeien, heet het hele Bleu 1801 team je welkom voor een tijdloos moment."
    ]
  },
