  "rdfs:comment": {
    "de": [
      "VITTO'VÉLO ist ein Fachgeschäft, das sich auf den Verkauf, die Reparatur und die individuelle Gestaltung von Fahrrädern spezialisiert hat.\r\nElektro- oder Muskelfahrräder, Straßenräder, All-Track-Räder, Geländeräder, Junior kommen und entdecken Sie das Modell, das Sie brauchen."
    ],
    "en": [
      "Specialised shop : sale, repair and customized bikes. All types of bikes. Also equipments, clothes, helmets & shoes."
    ],
    "it": [
      "VITTO'VÉLO è un negozio specializzato nella vendita, riparazione e personalizzazione di biciclette.\r\nBici elettriche o muscolari, bici da strada, mountain bike, junior bike, venite a scoprire il modello che fa per voi."
    ],
    "fr": [
      "VITTO'VÉLO est un magasin spécialisé dans la vente, la réparation et la personnalisation de vélos.\r\nÉlectrique ou musculaire, Vélos de route, Tout-chemin, Tout-terrain, junior venez découvrir le modèle qu'il vous faut."
    ],
    "nl": [
      "VITTO'VÉLO is een winkel gespecialiseerd in de verkoop, reparatie en aanpassing van fietsen.\r\nElektrische fietsen of musclebikes, racefietsen, mountainbikes, juniorfietsen, kom en ontdek het model dat bij je past."
    ],
    "es": [
      "VITTO'VÉLO es una tienda especializada en la venta, reparación y personalización de bicicletas.\r\nBicicletas eléctricas o musculosas, de carretera, de montaña, junior, ven a descubrir el modelo que más te conviene."
    ]
  },
