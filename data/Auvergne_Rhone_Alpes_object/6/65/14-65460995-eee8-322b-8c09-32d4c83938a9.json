  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a9269199-46b2-3752-a3e6-7e9ee5c72b9b",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Hallal-Fleisch\n\nTage der Öffnung:\n\nMontag bis Sonntag von 9:00 bis 20:00 Uhr.\n \n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nTelefonische Bestellungen unter 03 61 47 55 36 möglich\n\n "
        ],
        "en": [
          "Information :\n\nProducts : Hallal meat\n\nOpening days:\n\nMonday to Sunday, 9am to 8pm.\n \n \n Collection :\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by phone 03 61 47 55 36\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti : Carne Hallal\n\nGiorni di apertura:\n\nDal lunedì alla domenica dalle 9.00 alle 20.00.\n \n \n Raccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nSi può ordinare telefonicamente al numero 03 61 47 55 36\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : viandes Hallal\n\nJours d'ouverture:\n\nDu lundi au dimanche de 9h à 20h.\n \n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au 03 61 47 55 36\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten : Hallal vlees\n\nOpeningsdagen:\n\nMaandag tot zondag van 9u tot 20u.\n \n \n Ophalen :\n\nAfhalen tijdens openingstijden van de winkel\n\nBestellen :\n\nU kunt telefonisch bestellen op 03 61 47 55 36\n\n "
        ],
        "es": [
          "Más información :\n\nProductos : Carne de hallal\n\nDías de apertura:\n\nDe lunes a domingo de 9h a 20h.\n \n \n Recogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nPuede hacer su pedido por teléfono llamando al 03 61 47 55 36\n\n "
        ]
      },
