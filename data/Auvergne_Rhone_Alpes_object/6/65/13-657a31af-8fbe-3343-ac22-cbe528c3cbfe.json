  "rdfs:comment": {
    "de": [
      "Audrey und Jean-Christophe bieten Ihnen eine den Jahreszeiten entsprechende  Feinschmeckerküche mit frischen Zutaten, Pflanzen und Gewürzkräutern an."
    ],
    "en": [
      "Audrey and Jean-Christophe offer you tasty cooking using fresh seasonal foods, plants and aromatic herbs."
    ],
    "it": [
      "La nostra cucina è moderna, originale e preparata con cura, utilizzando prodotti freschi, fiori ed erbe raccolte in loco.\r\nI prodotti locali sono messi in risalto in combinazioni sottili e sorprendenti."
    ],
    "fr": [
      "Nous vous proposons une cuisine moderne, originale et soignée à base de produits frais, de fleurs et plantes aromatiques issues de cueillette locale.\r\nLes produits du terroir sont mis en avant dans des accords subtils et surprenants."
    ],
    "es": [
      "Audrey y Jean-Christophe le proponen una deliciosa cocina de temporada elaborada con productos frescos, plantas y hierbas aromáticas."
    ],
    "nl": [
      "Audrey en Christophe serveren een heerlijke keuken, zij werken met verse seizoensproducten, aromatische planten en kruiden."
    ]
  },
