  "rdfs:comment": {
    "de": [
      "Verkauf, Töpferei-Schnupperkurse, regelmäßige Kurse, Wochenend- oder Wochenpraktika.\r\nMöglichkeit, vor Ort zu wohnen!\r\nMaßgeschneiderte Angebote für Sie, Ihre Freunde oder Ihre Familie: Ich stelle Ihnen ein Programm zusammen und passe mich an Ihr Programm an!"
    ],
    "en": [
      "Sales, introductory pottery courses, regular classes, weekend and weekly workshops.\r\nOn-site accommodation available!\r\nTailor-made for you, friends or family: I'll create a program for you, and adapt to yours!"
    ],
    "it": [
      "Vendita, corsi di introduzione alla ceramica, lezioni regolari, corsi di fine settimana e settimanali.\r\nPossibilità di alloggio in loco!\r\nSu misura per voi, amici o famiglia, creerò un programma per voi e lo adatterò al vostro!"
    ],
    "fr": [
      "De la vente, des cours découverte de la poterie, des cours réguliers, des stages le week-end ou la semaine.\r\nPossibilité de logement sur place !\r\nDu sur-mesure pour vous, ami(e)s ou famille, je vous créer un programme, je m'adapte au votre !"
    ],
    "nl": [
      "Verkoop, introductiecursussen pottenbakken, regelmatige lessen, weekend- en weekcursussen.\r\nAccommodatie beschikbaar op locatie!\r\nOp maat gemaakt voor jou, vrienden of familie, ik maak een programma voor jou en pas het aan aan dat van jou!"
    ],
    "es": [
      "Ventas, cursos de iniciación a la alfarería, clases regulares, cursos de fin de semana y semanales.\r\n¡Alojamiento disponible in situ!\r\nA medida para usted, amigos o familia, ¡crearé un programa para usted y me adaptaré al suyo!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poterie - de Suzon à Zélie"
    ]
  },
