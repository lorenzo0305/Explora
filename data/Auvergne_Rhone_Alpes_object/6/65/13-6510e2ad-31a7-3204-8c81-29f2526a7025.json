  "rdfs:comment": {
    "de": [
      "Lassen Sie sich vom Septitrain führen und entdecken Sie Samoëns in Ihrem eigenen Rhythmus, auf originelle und gesellige Weise, bei einer kommentierten Besichtigung."
    ],
    "en": [
      "Let the little train of Samoëns, the Septitrain, take you on an original exploration of the village at a gentle pace with this pleasant guided tour."
    ],
    "it": [
      "Lasciatevi guidare dal Septitrain e scoprite Samoëns al vostro ritmo, in modo originale e amichevole, con una visita guidata."
    ],
    "fr": [
      "Laissez-vous guider par le Septitrain en découvrant Samoëns à votre rythme, de manière originale et conviviale, en visite commentée."
    ],
    "nl": [
      "Laat de Septitrain uw gids zijn en ontdek Samoëns op uw eigen tempo, op een originele en vriendelijke manier, met een rondleiding."
    ],
    "es": [
      "Déjese guiar por el Septitrain y descubra Samoëns a su ritmo, de forma original y amigable, con una visita guiada."
    ]
  },
