  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fa5f2009-4663-353b-bf6d-40cbd680fd5f",
      "dc:description": {
        "de": [
          "Unternehmen, das Baumaschinen, Grünflächen und Fahrzeuge für Profis und Privatpersonen verleiht.\n\nMontags bis freitags von 07:30 bis 12:30 Uhr und von 13:30 bis 18:00 Uhr geöffnet. Samstags von 08:00 bis 12:00 Uhr."
        ],
        "en": [
          "Rental company for building and civil engineering equipment, green spaces and vehicles for professionals and private customers.\n\nOpen Monday to Friday, 07:30 to 12:30 and 13:30 to 18:00. Saturday from 08h00 to 12h00."
        ],
        "it": [
          "Società di noleggio di attrezzature per l'edilizia e l'ingegneria civile, spazi verdi e veicoli per professionisti e privati.\n\nAperto da lunedì a venerdì dalle 07:30 alle 12:30 e dalle 13:30 alle 18:00. Il sabato dalle 08:00 alle 12:00."
        ],
        "fr": [
          "Entreprise de location de matériels BTP, espaces verts et véhicules pour professionnels et particuliers.\n\nOuvert du lundi au vendredi de 07h30 à 12h30 et de 13h30 à 18h00. Le samedi de 08h00 à 12h00."
        ],
        "nl": [
          "Verhuurbedrijf voor bouw- en civieltechnisch materieel, groenvoorzieningen en voertuigen voor professionals en particulieren.\n\nOpen van maandag tot vrijdag van 07:30 tot 12:30 en van 13:30 tot 18:00. Op zaterdag van 08:00 tot 12:00 uur."
        ],
        "es": [
          "Empresa de alquiler de material de construcción e ingeniería civil, espacios verdes y vehículos para profesionales y particulares.\n\nAbierto de lunes a viernes de 07:30 a 12:30 y de 13:30 a 18:00. Sábados de 08:00 a 12:00."
        ]
      },
      "@type": [
        "Description"
      ],
