  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen Ziegenhof im Mittelgebirge.\r\nAuf 900 m Höhe im Weiler La Bertinière erwartet Sie eine Ziegenfarm mit ihrem Sortiment an Ziegenkäse aus Freilandhaltung."
    ],
    "en": [
      "Discover a mid-mountain goat farm.\r\nAt 900 m altitude in the hamlet of La Bertinière, a goat farm and its range of farmhouse goat cheeses await you."
    ],
    "it": [
      "Scoprite un allevamento di capre di media montagna.\r\nA 900 m di altitudine, nella frazione di La Bertinière, vi aspetta un allevamento di capre e la sua gamma di formaggi di capra di fattoria."
    ],
    "fr": [
      "A la découverte d'une chèvrerie de moyenne montagne. \r\nA 900 m d'altitude au hameau de la Bertinière, une exploitation caprine et sa gamme de fromages de chèvre fermiers vous attendent."
    ],
    "nl": [
      "Ontdek een geitenboerderij in het midden van het gebergte.\r\nOp 900 m hoogte, in het gehucht La Bertinière, wachten een geitenboerderij en een assortiment boerengeitenkazen op je."
    ],
    "es": [
      "Descubra una granja caprina de media montaña.\r\nA 900 m de altitud, en la aldea de La Bertinière, le espera una granja de cabras y su gama de quesos de cabra de granja."
    ]
  },
