  "rdfs:comment": {
    "de": [
      "Kurz vor Ostern bietet die Mediathek von Espaly-Saint-Marcel eine fröhliche Eiersuche für Kinder von 4 bis 6 Jahren an. Geschichten, Herausforderungen und eine Schnitzeljagd bestimmen den Rhythmus dieses spielerischen und leckeren Moments, den Sie in der Mediathek verbringen können. Anmeldung empfohlen."
    ],
    "en": [
      "In the run-up to Easter, the Espaly-Saint-Marcel media library is offering a joyful egg hunt for children aged 4 to 6. Stories, challenges and a treasure hunt will punctuate this fun and tasty moment to be shared at the mediatheque. Registration recommended."
    ],
    "it": [
      "Con la Pasqua alle porte, la biblioteca multimediale di Espaly-Saint-Marcel propone una divertente caccia alle uova per i bambini dai 4 ai 6 anni. Storie, sfide e una caccia al tesoro scandiranno questa divertente e gustosa esperienza presso la mediateca. È consigliata l'iscrizione."
    ],
    "fr": [
      "À l’approche de Pâques, la médiathèque d’Espaly-Saint-Marcel propose une joyeuse chasse aux œufs pour les enfants de 4 à 6 ans. Histoires, défis et jeu de piste rythmeront ce moment ludique et gourmand à partager à la médiathèque. Inscription conseillée."
    ],
    "nl": [
      "Met Pasen in aantocht organiseert de mediatheek van Espaly-Saint-Marcel een leuke eierspeurtocht voor kinderen van 4 tot 6 jaar. Verhalen, uitdagingen en een schattenjacht maken deze leuke en smakelijke ervaring in de mediatheek compleet. Aanmelding aanbevolen."
    ],
    "es": [
      "Con la Pascua a la vuelta de la esquina, la mediateca de Espaly-Saint-Marcel propone una divertida búsqueda del huevo para niños de 4 a 6 años. Cuentos, desafíos y una búsqueda del tesoro puntuarán esta experiencia lúdica y sabrosa en la mediateca. Se recomienda inscribirse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse aux œufs à Espaly"
    ]
  },
