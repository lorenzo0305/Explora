  "rdfs:comment": {
    "de": [
      "Edith, Produzentin von wildwachsenden und kultivierten Pflanzen mit Bio-Siegel, bietet lokale und handwerklich hergestellte Produkte an: Kräutertees, Seifen, feste Shampoos, Balsame ... Außerdem organisiert sie Naturaktivitäten, um ihre Umgebung zu entdecken."
    ],
    "en": [
      "Edith, a producer of wild and cultivated plants with organic certification, offers locally sourced, artisanal products: herbal teas, soaps, solid shampoos, balms, and more. She also organises nature activities to help people discover her environment."
    ],
    "it": [
      "Edith è produttrice di piante selvatiche e coltivate con marchio biologico e offre una gamma di prodotti locali e artigianali: tisane, saponi, shampoo solidi, balsami, ecc. Organizza anche eventi naturalistici per farvi scoprire il suo ambiente."
    ],
    "fr": [
      "Edith, productrice de plantes sauvages et cultivées, labellisées bio, propose une production locale et artisanale : tisanes, savons, shampoings solides, baumes... Elle organise également des animations nature pour découvrir son environnement."
    ],
    "nl": [
      "Edith is een producent van wilde en gekweekte planten met een biologisch label en biedt een reeks lokale, ambachtelijke producten: kruidenthee, zeep, vaste shampoos, balsems, enz. Ze organiseert ook natuurevenementen om je haar omgeving te laten ontdekken."
    ],
    "es": [
      "Edith es productora de plantas silvestres y cultivadas con etiqueta ecológica, y ofrece una gama de productos locales y artesanales: tisanas, jabones, champús sólidos, bálsamos, etc. También organiza actividades en la naturaleza para descubrir su entorno."
    ]
  },
