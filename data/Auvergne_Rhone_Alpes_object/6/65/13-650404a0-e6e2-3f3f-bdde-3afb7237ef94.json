  "rdfs:comment": {
    "de": [
      "Hier finden Sie im Innenbereich: ein Spielbecken, eine Wasserrutsche, 2 Schwimmbahnen für Erwachsene und ein Planschbecken für die Kleinsten."
    ],
    "en": [
      "Take your pick between the family pool, water slide, 2 lanes for laps, and the wading pool for kids."
    ],
