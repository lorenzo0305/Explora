  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d8308c4c-8411-3a10-b58a-94d1a4fac43a",
      "dc:description": {
        "de": [
          "Besichtigungen \"Schlüssel zum Schloss\"\nMuseum von Boulogne-sur-Mer\nEin Besuch, um das gräfliche Schloss und seine Geschichte zu entdecken.\nVom 5. Juli bis 31. August 2025, jeden Tag um 15.30 Uhr\nDauer 45 min\nBesuche in englischer Sprache auf Anfrage.\nIn der Eintrittskarte enthalten - ohne Voranmeldung"
        ],
        "en": [
          "Keys to the castle\" tours\nBoulogne-sur-mer Museum\nA visit to discover the Château Comtal and its history.\nFrom July 5 to August 31, 2025, daily at 3:30 p.m\nDuration 45 min\nVisits in english on request.\nIncluded in admission ticket - no appointment necessary"
        ],
        "it": [
          "Visite guidate \"Le chiavi del castello\nMuseo di Boulogne-sur-mer\nUna visita per scoprire lo Château Comtal e la sua storia.\nDal 5 luglio al 31 agosto 2025, tutti i giorni alle 15.30\nDurata: 45 minuti\nVisite in inglese su richiesta.\nIncluso nel biglietto d'ingresso - non è necessario un appuntamento"
        ],
        "fr": [
          "Visites « Clefs du château »\nMusée de Boulogne-sur-mer\nUne visite pour découvrir le Château comtal et son histoire.\nDu 5 juillet au 31 août 2025, chaque jour à 15h30\nDurée 45 min\nVisits in english on request.\nInclus dans le billet d’entrée - sans rendez-vous"
        ],
        "es": [
          "Visitas \"Las llaves del castillo\nMuseo de Boulogne-sur-mer\nUna visita para descubrir el castillo Comtal y su historia.\nDel 5 de julio al 31 de agosto de 2025, todos los días a las 15.30 h\nDuración: 45 minutos\nVisitas en inglés a petición.\nIncluido en el precio de la entrada, sin cita previa"
        ],
        "nl": [
          "Rondleidingen \"De sleutels van het kasteel\nMuseum van Boulogne-sur-mer\nEen bezoek om het Château Comtal en zijn geschiedenis te ontdekken.\nVan 5 juli tot 31 augustus 2025, dagelijks om 15.30 uur\nDuur: 45 minuten\nBezoek in het Engels op aanvraag.\nInbegrepen in het entreebewijs - geen afspraak nodig"
        ]
      },
      "@type": [
        "Description"
